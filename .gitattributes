# AILang Binaries & Entry Points
ailang.x linguist-language=AILang
analyzer.x linguist-language=AILang
Main.ailang linguist-language=AILang
Main_test.ailang linguist-language=AILang
ailang_cli.ailang linguist-language=AILang
ailang_console.ailang linguist-language=AILang
ailang_lsp.ailang linguist-language=AILang
