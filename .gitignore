# =============================================================================
# AILang Self-Hosting — gitignore
# See WORKSPACE.md for layout philosophy.
# =============================================================================

# --- Compiled executables (keep only the shipped compiler at root) ---
*.x
*_exec
a.out
ailang.x.*
!ailang.x
# analyzer.x is built often; track only if you intentionally force-add
# (default: ignore like other binaries)
analyzer.x

# Python reference compiler (no longer needed)
ailang_compiler/
ailang_parser/

# Build artifacts
*.o
*.obj
*.elf
*.bin
*.bak
*.bak_*
*.ailang.bak_*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.gemini_session/
claude-memory/

# OS junk
.DS_Store
Thumbs.db

# Debug / temp
*.log
*.tmp
/core
/core.*
__pycache__/
*.pyc

# Build output logs
build_*.txt
compile_*.txt
output_*.txt

# Generic JSON dumps at root / results (tools may use committed JSON under tools/)
/*.json
results/
!tools/**/*.json
!dev/amdgpu/**/*.json

# Disk images — too large for git
*.img
*.img.xz
*.img.gz
*.iso

# PDFs (reference — keep local)
*.pdf

# -----------------------------------------------------------------------------
# Root diet: screenshots, mesh dumps, raw framebuffers (use app folders)
# -----------------------------------------------------------------------------
/*.png
/*.jpg
/*.jpeg
/*.rgba
/*.bgra
/*.stl
/*.stp
/*.dxf
/*.tvg
# Allow docs / design assets that are intentional
!docs/**/*.png
!Design-Language- Refrence/**

# CAD build products (sources under CAD/ are fine; binaries are not)
CAD/**/*.x
CAD/build/
CAD/host/cad_host_x11
CAD/host/cad_panel_x11

# -----------------------------------------------------------------------------
# Large / external trees
# -----------------------------------------------------------------------------
test262/
tests/wpt/
Telegram/
Applications/HalCode9000/
CS-Book/
Demo Programs/backup/
tests/svg/spec/*.tar.gz

# Zig SDK if dropped in-tree
zig-linux-x86_64-*/

# -----------------------------------------------------------------------------
# Local-only / patent / commercial (never push)
# -----------------------------------------------------------------------------
cobol_frontend/
mumps_frontend/
phonics.md
skills/
attn_snapshot*.tar.gz
attn_snapshot*.tar
attn*.x
diff_output.txt
EXPERIMENTS.md
ENCODER_DECODER.md
CLAUDE.md
**/CLAUDE.md
Attn/
Librarys/TF/
ATTN.ailang

# -----------------------------------------------------------------------------
# AI prompt scratch (also under docs/archive if moved)
# -----------------------------------------------------------------------------
opus_prompt_*.md
deepseek_*.md
gemini_search_prompt.md
claude.md

# -----------------------------------------------------------------------------
# GPU / driver: traces and dumps — keep tooling in dev/amdgpu/tools tracked
# -----------------------------------------------------------------------------
dev/amdgpu/traces/
mmiotrace_*/
mmiotrace_*.txt
mmiotrace_*.log
our_mmiotrace.txt
our_mmiotrace.txt.
bus2_*.txt
amdgpu_init_sequence.txt
dmesg_*.txt
probe_*.txt
*.rom
vbios_*.rom

# Legacy root trace names (if anything reappears)
sclk_*.txt
crtc_*.txt
*_log.txt
*_log2.txt
*_crash.txt
loop_log_*.txt*
matmul_log.txt
attn_log.txt
attn_crash.txt
attn_test_log.txt
attn_test_log2.txt
attn_test_crash.txt
combined_source.ailang
*.x.bak

# Temp CSS dumps
ddg_css_*.css
--out

# Compiled one-off test binaries (name patterns)
test_accel_gcn
test_accel_gcn_*
test_replay_init
test_vram_readback

# Benchmark scratch
Benchmarks/scratch/

# Handoff / debug documentation backups
*.md.bak_*
*.md.pre_condense_bak

# Duplicate license file name noise (keep LICENSE)
# License.md may still be tracked; do not auto-ignore if intentional

# Local FLTK install (see CAD/host/BUILD_FLTK.md)
third_party/fltk/

# Generated dogfood packages
dist/AILang-CAD-dogfood-*/
dist/*.zip
