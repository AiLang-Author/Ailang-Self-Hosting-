        t5 = String.Concat(t4, "g")
        t6 = String.Concat(t5, "h")
        result = t6
        ReturnValue(result)
    }
}

Function.concat_with_str_conversion {
    Body: {
        x = 123
        y = 456
        t0 = AIMacro.Str(x)
        t1 = String.Concat("x=", t0)
        t2 = String.Concat(t1, ", y=")
        t3 = AIMacro.Str(y)
        t4 = String.Concat(t2, t3)
        t5 = String.Concat(t4, ", sum=")
        t6 = Add(x, y)
        t7 = AIMacro.Str(t6)
        t8 = String.Concat(t5, t7)
        result = t8
        ReturnValue(result)
    }
}

Function.concat_in_loop {
    Body: {
        result = ""
        lc0 = 0
        ls0 = 5
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            t1 = AIMacro.Str(i)
            t2 = String.Concat(result, t1)
            t3 = String.Concat(t2, "-")
            result = t3
        }
        ReturnValue(result)
    }
}

Function.mixed_string_ops {
    Body: {
        base = "test"
        repeated = String.Repeat(base, 3)
        t0 = String.Concat(repeated, "!")
        extended = t0
        t1 = String.Concat(">>>", extended)
        t2 = String.Concat(t1, "<<<")
        final = t2
        ReturnValue(final)
    }
}

Function.complex_return {
    Body: {
        t0 = Add(1, 2)
        t1 = Add(3, 4)
        t2 = Multiply(t0, t1)
        t3 = Subtract(5, 6)
        t4 = Subtract(7, 8)
        t5 = Multiply(t3, t4)
        t6 = Subtract(t2, t5)
        ReturnValue(t6)
    }
}

Function.complex_assignment {
    Body: {
        x = Divide(Multiply(Add(10, 20), Subtract(30, 10)), Multiply(Add(5, 5), 2))
        ReturnValue(x)
    }
}

Function.complex_condition_test {
    Body: {
        a = 5
        b = 10
        c = 15
        IfCondition Or(And(GreaterThan(Add(a, b), c), LessThan(Subtract(b, a), c)), EqualTo(Multiply(a, b), Add(Multiply(c, 2), 20))) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.nested_function_calls {
