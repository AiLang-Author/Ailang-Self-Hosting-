Function.empty_loops {
    Body: {
        count = 0
        lc0 = 0
        ls0 = 0
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            count = Add(count, 1)
        }
        j = 0
        WhileLoop GreaterThan(j, 100) {
            count = Add(count, 1)
            j = Add(j, 1)
        }
        ReturnValue(count)
    }
}

Function.single_iteration {
    Body: {
        count = 0
        lc0 = 0
        ls0 = 1
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            count = Add(count, 1)
        }
        j = 0
        WhileLoop LessThan(j, 1) {
            count = Add(count, 1)
            j = Add(j, 1)
        }
        ReturnValue(count)
    }
}

Function.range_variations {
    Body: {
        results = Array.Create(0)
        c1 = 0
        lc0 = 0
        ls0 = 3
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            c1 = Add(c1, 1)
        }
        AIMacro.SmartPush(results, c1)
        c2 = 0
        lc1 = 2
        ls1 = 5
        lt1 = 1
        WhileLoop LessThan(lc1, ls1) {
            i = lc1
            lc1 = Add(lc1, lt1)
            c2 = Add(c2, 1)
        }
        AIMacro.SmartPush(results, c2)
        c3 = 0
        lc2 = 0
        ls2 = 10
        lt2 = 2
        WhileLoop LessThan(lc2, ls2) {
            i = lc2
            lc2 = Add(lc2, lt2)
            c3 = Add(c3, 1)
        }
        AIMacro.SmartPush(results, c3)
        ReturnValue(results)
    }
}

Function.deeply_nested_if {
    Input: p_x: Integer
    Body: {
        IfCondition GreaterThan(p_x, 0) ThenBlock: {
            IfCondition GreaterThan(p_x, 10) ThenBlock: {
                IfCondition GreaterThan(p_x, 100) ThenBlock: {
                    IfCondition GreaterThan(p_x, 1000) ThenBlock: {
                        ReturnValue(4)
                    } ElseBlock: {
                        ReturnValue(3)
                    }
                } ElseBlock: {
                    ReturnValue(2)
                }
            } ElseBlock: {
                ReturnValue(1)
            }
        } ElseBlock: {
            ReturnValue(0)
        }
    }
}

Function.deeply_nested_loops {
    Body: {
        count = 0
        lc0 = 0
        ls0 = 2
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            a = lc0
            lc0 = Add(lc0, lt0)
            lc1 = 0
            ls1 = 2
            lt1 = 1
            WhileLoop LessThan(lc1, ls1) {
                b = lc1
                lc1 = Add(lc1, lt1)
                lc2 = 0
                ls2 = 2
                lt2 = 1
                WhileLoop LessThan(lc2, ls2) {
                    c = lc2
                    lc2 = Add(lc2, lt2)
                    lc3 = 0
                    ls3 = 2
                    lt3 = 1
                    WhileLoop LessThan(lc3, ls3) {
                        d = lc3
                        lc3 = Add(lc3, lt3)
                        count = Add(count, 1)
                    }
                }
            }
        }
        ReturnValue(count)
    }
}

Function.mixed_nesting {
    Body: {
        total = 0
        lc0 = 0
        ls0 = 3
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            IfCondition EqualTo(Modulo(i, 2), 0) ThenBlock: {
                lc1 = 0
                ls1 = 2
                lt1 = 1
                WhileLoop LessThan(lc1, ls1) {
                    j = lc1
                    lc1 = Add(lc1, lt1)
                    IfCondition EqualTo(j, 0) ThenBlock: {
                        total = Add(total, 1)
                    } ElseBlock: {
                        total = Add(total, 2)
                    }
                }
            } ElseBlock: {
                total = Add(total, 10)
            }
        }
        ReturnValue(total)
    }
}

Function.long_elif_chain {
    Input: p_x: Integer
    Body: {
        IfCondition EqualTo(p_x, 1) ThenBlock: {
            ReturnValue("one")
        } ElseBlock: {
            IfCondition EqualTo(p_x, 2) ThenBlock: {
                ReturnValue("two")
            } ElseBlock: {
                IfCondition EqualTo(p_x, 3) ThenBlock: {
                    ReturnValue("three")
                } ElseBlock: {
                    IfCondition EqualTo(p_x, 4) ThenBlock: {
                        ReturnValue("four")
                    } ElseBlock: {
                        IfCondition EqualTo(p_x, 5) ThenBlock: {
                            ReturnValue("five")
                        } ElseBlock: {
                            IfCondition EqualTo(p_x, 6) ThenBlock: {
                                ReturnValue("six")
                            } ElseBlock: {
                                IfCondition EqualTo(p_x, 7) ThenBlock: {
                                    ReturnValue("seven")
                                } ElseBlock: {
                                    IfCondition EqualTo(p_x, 8) ThenBlock: {
                                        ReturnValue("eight")
                                    } ElseBlock: {
                                        IfCondition EqualTo(p_x, 9) ThenBlock: {
                                            ReturnValue("nine")
                                        } ElseBlock: {
                                            IfCondition EqualTo(p_x, 10) ThenBlock: {
                                                ReturnValue("ten")
                                            } ElseBlock: {
                                                ReturnValue("other")
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

Function.elif_with_complex_conditions {
    Input: p_a: Integer
    Input: p_b: Integer
    Input: p_c: Integer
    Body: {
        IfCondition And(GreaterThan(p_a, p_b), GreaterThan(p_b, p_c)) ThenBlock: {
            ReturnValue(1)
        } ElseBlock: {
            IfCondition And(GreaterThan(p_a, p_c), GreaterThan(p_c, p_b)) ThenBlock: {
                ReturnValue(2)
            } ElseBlock: {
                IfCondition And(GreaterThan(p_b, p_a), GreaterThan(p_a, p_c)) ThenBlock: {
                    ReturnValue(3)
                } ElseBlock: {
                    IfCondition And(GreaterThan(p_b, p_c), GreaterThan(p_c, p_a)) ThenBlock: {
                        ReturnValue(4)
                    } ElseBlock: {
                        IfCondition And(GreaterThan(p_c, p_a), GreaterThan(p_a, p_b)) ThenBlock: {
                            ReturnValue(5)
                        } ElseBlock: {
                            IfCondition And(GreaterThan(p_c, p_b), GreaterThan(p_b, p_a)) ThenBlock: {
                                ReturnValue(6)
                            } ElseBlock: {
                                ReturnValue(0)
                            }
                        }
                    }
                }
            }
        }
    }
}

Function.return_in_loop {
    Body: {
        lc0 = 0
        ls0 = 100
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            IfCondition EqualTo(i, 5) ThenBlock: {
                ReturnValue(i)
            }
        }
        ReturnValue(Subtract(0, 1))
    }
}

Function.return_in_nested_loop {
    Body: {
        lc0 = 0
        ls0 = 10
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            lc1 = 0
            ls1 = 10
            lt1 = 1
            WhileLoop LessThan(lc1, ls1) {
                j = lc1
                lc1 = Add(lc1, lt1)
                IfCondition EqualTo(Multiply(i, j), 25) ThenBlock: {
                    t2 = Multiply(i, 100)
                    t3 = Add(t2, j)
                    ReturnValue(t3)
                }
            }
        }
        ReturnValue(Subtract(0, 1))
    }
}

Function.multiple_return_paths {
    Input: p_x: Integer
    Input: p_y: Integer
    Body: {
        IfCondition LessThan(p_x, 0) ThenBlock: {
            IfCondition LessThan(p_y, 0) ThenBlock: {
                ReturnValue(Subtract(0, 1))
            }
            ReturnValue(Subtract(0, 2))
        }
        IfCondition LessThan(p_y, 0) ThenBlock: {
            ReturnValue(Subtract(0, 3))
        }
        t0 = Add(p_x, p_y)
        ReturnValue(t0)
    }
}

Function.augmented_in_loops {
    Body: {
        total = 0
        lc0 = 0
        ls0 = 10
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            total = Add(total, i)
        }
        product = 1
        lc1 = 1
        ls1 = 5
        lt1 = 1
        WhileLoop LessThan(lc1, ls1) {
            i = lc1
            lc1 = Add(lc1, lt1)
            product = Multiply(product, i)
        }
        t2 = Multiply(total, 1000)
        t3 = Add(t2, product)
        ReturnValue(t3)
    }
}

Function.augmented_in_conditions {
    Body: {
        x = 10
        IfCondition GreaterThan(x, 5) ThenBlock: {
            x = Add(x, 5)
        }
        IfCondition GreaterThan(x, 10) ThenBlock: {
            x = Multiply(x, 2)
        }
        ReturnValue(x)
    }
}

Function.list_boundary_test {
    Body: {
        arr = Array.Create(0)
        lc0 = 0
        ls0 = 5
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            AIMacro.SmartPush(arr, i)
        }
        t1 = DictGen_SmartGet(arr, 0)
        first = t1
        t2 = DictGen_SmartGet(arr, 4)
        last = t2
        DictGen_SmartSet(arr, 0, 100)
        DictGen_SmartSet(arr, 4, 400)
        t3 = DictGen_SmartGet(arr, 0)
        t4 = DictGen_SmartGet(arr, 4)
        t5 = Add(t3, t4)
        ReturnValue(t5)
    }
}

Function.list_in_list_context {
    Body: {
        arr = Array.Create(5)
        Array.Push(arr, 3)
        Array.Push(arr, 1)
        Array.Push(arr, 4)
        Array.Push(arr, 1)
        Array.Push(arr, 5)
        t0 = sum_list(arr)
        total = t0
        ReturnValue(total)
    }
}

Function.sum_list {
    Input: p_arr: Integer
    Body: {
        total = 0
        lc0 = 0
        ls0 = DictGen_SmartLen(p_arr)
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            t1 = DictGen_SmartGet(p_arr, i)
            total = Add(total, t1)
        }
        ReturnValue(total)
    }
}

Function.modify_list_in_function {
    Input: p_arr: Integer
    Body: {
        DictGen_SmartSet(p_arr, 0, 999)
        __oop_args_0 = Array.Create(1)
        Array.Push(__oop_args_0, 888)
        OOP.MethodCall(p_arr, "append", __oop_args_0)
        t0 = DictGen_SmartLen(p_arr)
        ReturnValue(t0)
    }
}

Function.long_concat_chain {
    Body: {
        t0 = String.Concat("a", "b")
        t1 = String.Concat(t0, "c")
        t2 = String.Concat(t1, "d")
        t3 = String.Concat(t2, "e")
