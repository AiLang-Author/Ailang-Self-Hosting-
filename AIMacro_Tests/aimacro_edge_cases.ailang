}

Function.while_immediate_exit {
    Body: {
        count = 0
        x = 0
        WhileLoop GreaterThan(x, 0) {
            count = Add(count, 1)
            x = Subtract(x, 1)
        }
        ReturnValue(count)
    }
}

Function.while_with_break_at_start {
    Body: {
        count = 0
        WhileLoop EqualTo(1, 1) {
            IfCondition Not(EqualTo(1, 1)) ThenBlock: {
                BreakLoop
            }
            BreakLoop
        }
        ReturnValue(count)
    }
}

Function.while_decrement {
    Body: {
        n = 10
        count = 0
        WhileLoop GreaterThan(n, 0) {
            count = Add(count, 1)
            n = Subtract(n, 1)
        }
        ReturnValue(count)
    }
}

Function.while_complex_update {
    Body: {
        n = 100
        steps = 0
        WhileLoop GreaterThan(n, 1) {
            IfCondition EqualTo(Modulo(n, 2), 0) ThenBlock: {
                n = Divide(n, 2)
            } ElseBlock: {
                n = Add(Multiply(n, 3), 1)
            }
            steps = Add(steps, 1)
            IfCondition GreaterThan(steps, 1000) ThenBlock: {
                BreakLoop
            }
        }
        ReturnValue(steps)
    }
}

