        t91 = test_list_as_param()
        t92 = AIMacro.Str(t91)
        t93 = String.Concat("list_as_param: ", t92)
        AIMacro.SmartPrint(t93)
        PrintMessage("\n")
        PrintMessage("Expected: 15002")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- ARITHMETIC TESTS ---")
        PrintMessage("\n")
        t94 = test_arithmetic_precision()
        arith_results = t94
        t95 = DictGen_SmartGet(arith_results, 0)
        t96 = AIMacro.Str(t95)
        t97 = String.Concat("big + big: ", t96)
        AIMacro.SmartPrint(t97)
        PrintMessage("\n")
        t98 = DictGen_SmartGet(arith_results, 1)
