        PrintMessage("\n")
        t31 = DictGen_SmartGet(not_results, 2)
        t32 = AIMacro.Str(t31)
        t33 = String.Concat("Double not: ", t32)
        AIMacro.SmartPrint(t33)
        PrintMessage("\n")
        t34 = DictGen_SmartGet(not_results, 3)
        t35 = AIMacro.Str(t34)
        t36 = String.Concat("not with and: ", t35)
        AIMacro.SmartPrint(t36)
        PrintMessage("\n")
        t37 = DictGen_SmartGet(not_results, 4)
        t38 = AIMacro.Str(t37)
        t39 = String.Concat("not with or: ", t38)
        AIMacro.SmartPrint(t39)
        PrintMessage("\n")
        PrintMessage("All should be 1")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- BREAK TESTS ---")
        PrintMessage("\n")
        t40 = test_break_all_contexts()
        break_results = t40
        t41 = DictGen_SmartGet(break_results, 0)
        t42 = AIMacro.Str(t41)
        t43 = String.Concat("break in for (expect 3): ", t42)
        AIMacro.SmartPrint(t43)
        PrintMessage("\n")
        t44 = DictGen_SmartGet(break_results, 1)
        t45 = AIMacro.Str(t44)
        t46 = String.Concat("break in while (expect 5): ", t45)
        AIMacro.SmartPrint(t46)
        PrintMessage("\n")
        t47 = DictGen_SmartGet(break_results, 2)
        t48 = AIMacro.Str(t47)
        t49 = String.Concat("break in nested (expect 5): ", t48)
        AIMacro.SmartPrint(t49)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- CONTINUE TESTS ---")
        PrintMessage("\n")
        t50 = test_continue_all_contexts()
        cont_results = t50
        t51 = DictGen_SmartGet(cont_results, 0)
        t52 = AIMacro.Str(t51)
        t53 = String.Concat("continue in for (expect 25): ", t52)
        AIMacro.SmartPrint(t53)
        PrintMessage("\n")
        t54 = DictGen_SmartGet(cont_results, 1)
        t55 = AIMacro.Str(t54)
        t56 = String.Concat("continue in while (expect 25): ", t55)
        AIMacro.SmartPrint(t56)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- FUNCTION TESTS ---")
        PrintMessage("\n")
        t57 = test_recursion_depth()
        t58 = AIMacro.Str(t57)
        t59 = String.Concat("recursion_depth(50): ", t58)
        AIMacro.SmartPrint(t59)
        PrintMessage("\n")
        t60 = test_function_as_expression()
        t61 = AIMacro.Str(t60)
        t62 = String.Concat("function_as_expression: ", t61)
        AIMacro.SmartPrint(t62)
        PrintMessage("\n")
        t63 = test_nested_calls_deep()
        t64 = AIMacro.Str(t63)
        t65 = String.Concat("nested_calls_deep: ", t64)
        AIMacro.SmartPrint(t65)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- LIST TESTS ---")
        PrintMessage("\n")
        t66 = test_list_comprehensive()
        list_results = t66
        t67 = DictGen_SmartGet(list_results, 0)
        t68 = AIMacro.Str(t67)
        t69 = String.Concat("len after create: ", t68)
