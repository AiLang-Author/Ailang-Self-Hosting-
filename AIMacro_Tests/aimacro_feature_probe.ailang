        t112 = String.Concat("17%5 (expect 2): ", t111)
        AIMacro.SmartPrint(t112)
        PrintMessage("\n")
        t113 = DictGen_SmartGet(arith_results, 6)
        t114 = AIMacro.Str(t113)
        t115 = String.Concat("17/5 (expect 3): ", t114)
        AIMacro.SmartPrint(t115)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        t116 = test_negative_number_ops()
