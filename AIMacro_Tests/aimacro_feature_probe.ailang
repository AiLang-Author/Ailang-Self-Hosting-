        t8 = String.Concat("len: ", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        t9 = test_str_conversion()
        t10 = String.Concat("str(): ", t9)
        AIMacro.SmartPrint(t10)
        PrintMessage("\n")
        t11 = test_string_equality_detailed()
        eq_results = t11
        PrintMessage("String equality tests:")
        PrintMessage("\n")
        t12 = DictGen_SmartGet(eq_results, 0)
        t13 = AIMacro.Str(t12)
        t14 = String.Concat("  same literal: ", t13)
        AIMacro.SmartPrint(t14)
        PrintMessage("\n")
        t15 = DictGen_SmartGet(eq_results, 1)
        t16 = AIMacro.Str(t15)
        t17 = String.Concat("  diff case: ", t16)
        AIMacro.SmartPrint(t17)
        PrintMessage("\n")
        t18 = DictGen_SmartGet(eq_results, 2)
        t19 = AIMacro.Str(t18)
        t20 = String.Concat("  dynamic: ", t19)
        AIMacro.SmartPrint(t20)
        PrintMessage("\n")
        t21 = DictGen_SmartGet(eq_results, 3)
        t22 = AIMacro.Str(t21)
        t23 = String.Concat("  inequality: ", t22)
        AIMacro.SmartPrint(t23)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- STRING METHODS ---")
        PrintMessage("\n")
        test_string_methods()
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- NOT PRECEDENCE ---")
        PrintMessage("\n")
        t24 = test_not_precedence_cases()
        not_results = t24
        t25 = DictGen_SmartGet(not_results, 0)
