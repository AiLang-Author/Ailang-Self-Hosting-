        t117 = DictGen_SmartGet(neg_results, 0)
        t118 = AIMacro.Str(t117)
        t119 = String.Concat("-10 + 3: ", t118)
        AIMacro.SmartPrint(t119)
        PrintMessage("\n")
        t120 = DictGen_SmartGet(neg_results, 1)
        t121 = AIMacro.Str(t120)
        t122 = String.Concat("-10 - 3: ", t121)
        AIMacro.SmartPrint(t122)
        PrintMessage("\n")
        t123 = DictGen_SmartGet(neg_results, 2)
        t124 = AIMacro.Str(t123)
        t125 = String.Concat("-10 * 3: ", t124)
        AIMacro.SmartPrint(t125)
        PrintMessage("\n")
        t126 = DictGen_SmartGet(neg_results, 3)
        t127 = AIMacro.Str(t126)
        t128 = String.Concat("-10 / 3: ", t127)
        AIMacro.SmartPrint(t128)
        PrintMessage("\n")
        t129 = DictGen_SmartGet(neg_results, 4)
        t130 = AIMacro.Str(t129)
        t131 = String.Concat("-(-10): ", t130)
        AIMacro.SmartPrint(t131)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
                t132 = String.Repeat("=", 60)
AIMacro.SmartPrint(t132)
        PrintMessage("\n")
        PrintMessage("FEATURE PROBE COMPLETE!")
        PrintMessage("\n")
                t133 = String.Repeat("=", 60)
AIMacro.SmartPrint(t133)
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
