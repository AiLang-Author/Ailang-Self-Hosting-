Function.test_string_concat {
    Body: {
        s1 = "Hello"
        s2 = "World"
        t0 = String.Concat(s1, " ")
        t1 = String.Concat(t0, s2)
        s3 = t1
        ReturnValue(s3)
    }
}

Function.test_string_repeat {
    Body: {
        s = String.Repeat("*", 20)
        ReturnValue(s)
    }
}

Function.test_string_len {
    Body: {
        s = "AIMacro"
        t0 = DictGen_SmartLen(s)
        ReturnValue(t0)
    }
}

Function.test_string_equality_detailed {
    Body: {
        a = "test"
        b = "test"
        c = "TEST"
        t0 = String.Concat("te", "st")
        d = t0
        results = Array.Create(0)
        IfCondition EqualTo(StringCompare(a, b), 0) ThenBlock: {
            AIMacro.SmartPush(results, 1)
        } ElseBlock: {
            AIMacro.SmartPush(results, 0)
        }
        IfCondition EqualTo(StringCompare(a, c), 0) ThenBlock: {
            AIMacro.SmartPush(results, 1)
        } ElseBlock: {
            AIMacro.SmartPush(results, 0)
        }
        IfCondition EqualTo(StringCompare(a, d), 0) ThenBlock: {
            AIMacro.SmartPush(results, 1)
        } ElseBlock: {
            AIMacro.SmartPush(results, 0)
        }
        IfCondition NotEqual(StringCompare(a, c), 0) ThenBlock: {
            AIMacro.SmartPush(results, 1)
        } ElseBlock: {
            AIMacro.SmartPush(results, 0)
        }
        ReturnValue(results)
    }
}

Function.test_str_conversion {
    Body: {
        num = 42
        s = AIMacro.Str(num)
        t0 = String.Concat("Value is ", s)
        result = t0
        ReturnValue(result)
    }
}

Function.test_string_methods {
    Body: {
        s = "  Hello World  "
        stripped = String.Strip(s)
                t0 = String.Concat("Original: '", s)
        t1 = String.Concat(t0, "'")
AIMacro.SmartPrint(t1)
        PrintMessage("\n")
                t2 = String.Concat("Stripped: '", stripped)
        t3 = String.Concat(t2, "'")
AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        word = "MixedCase"
        t4 = String.Upper(word)
        t5 = String.Concat("Upper: ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = String.Lower(word)
        t7 = String.Concat("Lower: ", t6)
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        text = "hello world"
        pos = String.Find(text, "world")
        t8 = AIMacro.Str(pos)
        t9 = String.Concat("find world: ", t8)
        AIMacro.SmartPrint(t9)
        PrintMessage("\n")
        IfCondition String.StartsWith(text, "hello") ThenBlock: {
            PrintMessage("startswith hello: True")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("startswith hello: False")
            PrintMessage("\n")
        }
        IfCondition String.EndsWith(text, "world") ThenBlock: {
            PrintMessage("endswith world: True")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("endswith world: False")
            PrintMessage("\n")
        }
        ReturnValue(1)
    }
}

Function.test_not_precedence_cases {
    Body: {
        x = 50
        results = Array.Create(0)
        IfCondition Not(GreaterThan(x, 100)) ThenBlock: {
            AIMacro.SmartPush(results, 1)
        } ElseBlock: {
            AIMacro.SmartPush(results, 0)
        }
        IfCondition Not(GreaterThan(x, 100)) ThenBlock: {
            AIMacro.SmartPush(results, 1)
        } ElseBlock: {
            AIMacro.SmartPush(results, 0)
        }
        IfCondition Not(Not(GreaterThan(x, 0))) ThenBlock: {
            AIMacro.SmartPush(results, 1)
        } ElseBlock: {
            AIMacro.SmartPush(results, 0)
        }
        IfCondition And(Not(GreaterThan(x, 100)), GreaterThan(x, 0)) ThenBlock: {
            AIMacro.SmartPush(results, 1)
        } ElseBlock: {
            AIMacro.SmartPush(results, 0)
        }
        IfCondition Or(Not(GreaterThan(x, 100)), GreaterThan(x, 100)) ThenBlock: {
            AIMacro.SmartPush(results, 1)
        } ElseBlock: {
            AIMacro.SmartPush(results, 0)
        }
        ReturnValue(results)
    }
}

Function.test_break_all_contexts {
    Body: {
        results = Array.Create(0)
        count = 0
        lc0 = 0
        ls0 = 10
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            IfCondition EqualTo(i, 3) ThenBlock: {
                BreakLoop
            }
            count = Add(count, 1)
        }
        AIMacro.SmartPush(results, count)
        count = 0
        WhileLoop EqualTo(1, 1) {
            IfCondition Not(EqualTo(1, 1)) ThenBlock: {
                BreakLoop
            }
            count = Add(count, 1)
            IfCondition EqualTo(count, 5) ThenBlock: {
                BreakLoop
            }
        }
        AIMacro.SmartPush(results, count)
        outer_count = 0
        lc1 = 0
        ls1 = 5
        lt1 = 1
        WhileLoop LessThan(lc1, ls1) {
            i = lc1
            lc1 = Add(lc1, lt1)
            lc2 = 0
            ls2 = 5
            lt2 = 1
            WhileLoop LessThan(lc2, ls2) {
                j = lc2
                lc2 = Add(lc2, lt2)
                IfCondition EqualTo(j, 2) ThenBlock: {
                    BreakLoop
                }
            }
            outer_count = Add(outer_count, 1)
        }
        AIMacro.SmartPush(results, outer_count)
        ReturnValue(results)
    }
}

Function.test_continue_all_contexts {
    Body: {
        results = Array.Create(0)
        total = 0
        lc0 = 0
        ls0 = 10
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            IfCondition EqualTo(Modulo(i, 2), 0) ThenBlock: {
                ContinueLoop
            }
            total = Add(total, i)
        }
        AIMacro.SmartPush(results, total)
        total = 0
        i = 0
        WhileLoop LessThan(i, 10) {
            i = Add(i, 1)
            IfCondition EqualTo(Modulo(i, 2), 0) ThenBlock: {
                ContinueLoop
            }
            total = Add(total, i)
        }
        AIMacro.SmartPush(results, total)
        ReturnValue(results)
    }
}

Function.test_recursion_depth {
    Body: {
        t0 = count_down_recursive(50)
        result = t0
        ReturnValue(result)
    }
}

Function.count_down_recursive {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 0) ThenBlock: {
            ReturnValue(0)
        }
        t0 = Subtract(p_n, 1)
        t1 = count_down_recursive(t0)
        t2 = Add(1, t1)
        ReturnValue(t2)
    }
}

Function.test_function_as_expression {
    Body: {
        t0 = get_ten()
        t1 = get_ten()
        t2 = Add(t0, t1)
        a = t2
        t3 = get_ten()
        t4 = get_ten()
        t5 = Multiply(t3, t4)
        b = t5
        t6 = get_ten()
        t7 = get_ten()
        t8 = Subtract(t6, t7)
        c = t8
        t9 = Multiply(a, 10000)
        t10 = Multiply(b, 100)
        t11 = Add(t9, t10)
        t12 = Add(t11, c)
        ReturnValue(t12)
    }
}

Function.get_ten {
    Body: {
        ReturnValue(10)
    }
}

Function.test_nested_calls_deep {
    Body: {
        t0 = add_two(1, 2)
        t1 = add_two(3, 4)
        t2 = add_two(t0, t1)
        t3 = add_two(5, 6)
        t4 = add_two(7, 8)
        t5 = add_two(t3, t4)
        t6 = add_two(t2, t5)
        result = t6
        ReturnValue(result)
    }
}

Function.add_two {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        t0 = Add(p_a, p_b)
        ReturnValue(t0)
    }
}

Function.test_list_comprehensive {
    Body: {
        results = Array.Create(0)
        arr = Array.Create(3)
        Array.Push(arr, 10)
        Array.Push(arr, 20)
        Array.Push(arr, 30)
        t0 = AIMacro.SmartLen(arr)
        AIMacro.SmartPush(results, t0)
        t1 = DictGen_SmartGet(arr, 0)
        AIMacro.SmartPush(results, t1)
        t2 = DictGen_SmartGet(arr, 2)
        AIMacro.SmartPush(results, t2)
        DictGen_SmartSet(arr, 1, 200)
        t3 = DictGen_SmartGet(arr, 1)
        AIMacro.SmartPush(results, t3)
        AIMacro.SmartPush(arr, 40)
        t4 = AIMacro.SmartLen(arr)
        AIMacro.SmartPush(results, t4)
        t5 = DictGen_SmartGet(arr, 3)
        AIMacro.SmartPush(results, t5)
        empty = Array.Create(0)
        t6 = AIMacro.SmartLen(empty)
        AIMacro.SmartPush(results, t6)
        AIMacro.SmartPush(empty, 1)
        t7 = AIMacro.SmartLen(empty)
        AIMacro.SmartPush(results, t7)
        ReturnValue(results)
    }
}

Function.test_list_as_param {
    Body: {
        arr = Array.Create(5)
        Array.Push(arr, 1)
        Array.Push(arr, 2)
        Array.Push(arr, 3)
        Array.Push(arr, 4)
        Array.Push(arr, 5)
        t0 = list_sum(arr)
        s = t0
        list_double_first(arr)
        t1 = Multiply(s, 1000)
        t2 = DictGen_SmartGet(arr, 0)
        t3 = Add(t1, t2)
        ReturnValue(t3)
    }
}

Function.list_sum {
    Input: p_arr: Integer
    Body: {
        total = 0
        lc0 = 0
        ls0 = DictGen_SmartLen(p_arr)
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            t1 = DictGen_SmartGet(p_arr, i)
            total = Add(total, t1)
        }
        ReturnValue(total)
    }
}

Function.list_double_first {
    Input: p_arr: Integer
    Body: {
        t0 = DictGen_SmartGet(p_arr, 0)
        t1 = Multiply(t0, 2)
        DictGen_SmartSet(p_arr, 0, t1)
    }
}

Function.test_arithmetic_precision {
    Body: {
        results = Array.Create(0)
        big = 1000000
        AIMacro.SmartPush(results, Add(big, big))
        AIMacro.SmartPush(results, Multiply(big, 2))
        r = Subtract(Add(2, Multiply(3, 4)), 5)
        AIMacro.SmartPush(results, r)
        r = Multiply(Add(2, 3), Subtract(4, 1))
        AIMacro.SmartPush(results, r)
        r = Math.Power(2, 10)
        AIMacro.SmartPush(results, r)
        r = Modulo(17, 5)
        AIMacro.SmartPush(results, r)
        r = Divide(17, 5)
        AIMacro.SmartPush(results, r)
        ReturnValue(results)
    }
}

Function.test_negative_number_ops {
    Body: {
        results = Array.Create(0)
        a = Subtract(0, 10)
        b = 3
        AIMacro.SmartPush(results, Add(a, b))
        AIMacro.SmartPush(results, Subtract(a, b))
        AIMacro.SmartPush(results, Multiply(a, b))
        AIMacro.SmartPush(results, Divide(a, b))
        neg_a = Subtract(0, a)
        AIMacro.SmartPush(results, neg_a)
        ReturnValue(results)
    }
}

SubRoutine.Main {
                t0 = String.Repeat("=", 60)
AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("AIMACRO FEATURE PROBE TEST")
        PrintMessage("\n")
                t1 = String.Repeat("=", 60)
AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- STRING OPERATIONS ---")
        PrintMessage("\n")
        t2 = test_string_concat()
        t3 = String.Concat("concat: ", t2)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = test_string_repeat()
        t5 = String.Concat("repeat: ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
