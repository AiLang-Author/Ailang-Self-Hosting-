                product = Multiply(i, j)
                t82 = AIMacro.Str(product)
                t83 = String.Concat(line, t82)
                t84 = String.Concat(t83, " ")
                line = t84
            }
            AIMacro.SmartPrint(line)
            PrintMessage("\n")
        }
        a = 5
        b = 10
        c = 15
        IfCondition LessThan(a, b) ThenBlock: {
            IfCondition LessThan(b, c) ThenBlock: {
                PrintMessage("PASS: Nested if (a < b < c)")
                PrintMessage("\n")
            }
        }
        t85 = multiply(2, 3)
