LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.add {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        t0 = AIMacro.NumAdd(p_a, p_b)
        ReturnValue(t0)
    }
}

Function.multiply {
    Input: p_x: Integer
    Input: p_y: Integer
    Body: {
        result = AIMacro.NumMul(p_x, p_y)
        ReturnValue(result)
    }
}

Function.factorial {
    Input: p_n: Integer
    Body: {
        IfCondition AIMacro.SmartBool(AIMacro.NumLe(p_n, 1)) ThenBlock: {
            ReturnValue(1)
        }
        t0 = AIMacro.NumSub(p_n, 1)
        t1 = factorial(t0)
        t2 = AIMacro.NumMul(p_n, t1)
        ReturnValue(t2)
    }
}

Function.is_even {
    Input: p_num: Integer
    Body: {
        remainder = AIMacro.NumMod(p_num, 2)
        t0 = AIMacro.NumEq(remainder, 0)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.greet {
    Input: p_name: Integer
    Body: {
        t0 = String.Concat("Hello, ", p_name)
        t1 = String.Concat(t0, "!")
        msg = t1
        ReturnValue(msg)
    }
}

Function.count_down {
    Input: p_start: Integer
    Body: {
        i = p_start
        WhileLoop AIMacro.SmartBool(AIMacro.NumGt(i, 0)) {
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
            i = AIMacro.NumSub(i, 1)
        }
        PrintMessage("Blast off!")
        PrintMessage("\n")
    }
}

Function.sum_range {
    Input: p_n: Integer
    Body: {
        total = 0
        lc0 = 0
        ls0 = p_n
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            total = AIMacro.NumAdd(total, i)
        }
        ReturnValue(total)
    }
}

Function.find_max {
    Input: p_a: Integer
    Input: p_b: Integer
    Input: p_c: Integer
    Body: {
        max_val = p_a
        IfCondition AIMacro.SmartBool(AIMacro.NumGt(p_b, max_val)) ThenBlock: {
            max_val = p_b
        }
        IfCondition AIMacro.SmartBool(AIMacro.NumGt(p_c, max_val)) ThenBlock: {
            max_val = p_c
        }
        ReturnValue(max_val)
    }
}

Function.test_break_continue {
    Body: {
        count = 0
        lc0 = 0
        ls0 = 10
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            t1 = AIMacro.NumEq(i, 5)
            IfCondition AIMacro.SmartBool(t1) ThenBlock: {
                BreakLoop
            }
            count = AIMacro.NumAdd(count, 1)
        }
        t2 = AIMacro.Str(count)
        t3 = String.Concat("Break test (should be 5): ", t2)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        evens = 0
        lc4 = 0
        ls4 = 10
        lt4 = 1
        WhileLoop LessThan(lc4, ls4) {
            i = lc4
            lc4 = Add(lc4, lt4)
            t5 = AIMacro.NumMod(i, 2)
            t6 = AIMacro.NumNe(t5, 0)
            IfCondition AIMacro.SmartBool(t6) ThenBlock: {
                ContinueLoop
            }
            evens = AIMacro.NumAdd(evens, 1)
        }
        t7 = AIMacro.Str(evens)
        t8 = String.Concat("Continue test (should be 5): ", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
    }
}

Function.main {
    Body: {
                t0 = String.Repeat("=", AIMacro.Int(50))
AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("AIMACRO COMPREHENSIVE TEST SUITE")
        PrintMessage("\n")
                t1 = String.Repeat("=", AIMacro.Int(50))
AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- SECTION 1: ARITHMETIC ---")
        PrintMessage("\n")
        a = 10
        b = 3
        PrintMessage("a=10, b=3")
        PrintMessage("\n")
        t2 = AIMacro.NumAdd(a, b)
        t3 = AIMacro.Str(t2)
        t4 = String.Concat("a + b = ", t3)
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        t5 = AIMacro.NumSub(a, b)
        t6 = AIMacro.Str(t5)
        t7 = String.Concat("a - b = ", t6)
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        t8 = AIMacro.NumMul(a, b)
        t9 = AIMacro.Str(t8)
        t10 = String.Concat("a * b = ", t9)
        AIMacro.SmartPrint(t10)
        PrintMessage("\n")
        t11 = AIMacro.TrueDiv(a, b)
        t12 = AIMacro.Str(t11)
        t13 = String.Concat("a / b = ", t12)
        AIMacro.SmartPrint(t13)
        PrintMessage("\n")
        t14 = AIMacro.NumMod(a, b)
        t15 = AIMacro.Str(t14)
        t16 = String.Concat("a % b = ", t15)
        AIMacro.SmartPrint(t16)
        PrintMessage("\n")
        t17 = AIMacro.NumPow(a, 2)
        t18 = AIMacro.Str(t17)
        t19 = String.Concat("a ** 2 = ", t18)
        AIMacro.SmartPrint(t19)
        PrintMessage("\n")
        neg = AIMacro.NumNeg(5)
        t20 = AIMacro.Str(neg)
        t21 = String.Concat("neg = ", t20)
        AIMacro.SmartPrint(t21)
        PrintMessage("\n")
        t22 = AIMacro.NumAdd(neg, 10)
        t23 = AIMacro.Str(t22)
        t24 = String.Concat("neg + 10 = ", t23)
        AIMacro.SmartPrint(t24)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- SECTION 2: COMPARISONS ---")
        PrintMessage("\n")
        x = 5
        y = 10
        IfCondition AIMacro.SmartBool(AIMacro.NumLt(x, y)) ThenBlock: {
            PrintMessage("PASS: 5 < 10")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool(AIMacro.NumLe(x, 5)) ThenBlock: {
            PrintMessage("PASS: 5 <= 5")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool(AIMacro.NumGt(y, x)) ThenBlock: {
            PrintMessage("PASS: 10 > 5")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool(AIMacro.NumGe(y, 10)) ThenBlock: {
            PrintMessage("PASS: 10 >= 10")
            PrintMessage("\n")
        }
        t25 = AIMacro.NumEq(x, 5)
        IfCondition AIMacro.SmartBool(t25) ThenBlock: {
            PrintMessage("PASS: 5 == 5")
            PrintMessage("\n")
        }
        t26 = AIMacro.NumNe(x, y)
        IfCondition AIMacro.SmartBool(t26) ThenBlock: {
            PrintMessage("PASS: 5 != 10")
            PrintMessage("\n")
        }
        t27 = AIMacro.NumLt(x, y)
        t28 = t27
        IfCondition AIMacro.SmartBool(t28) ThenBlock: {
            t29 = AIMacro.NumGt(y, 0)
            t28 = t29
        }
        IfCondition AIMacro.SmartBool(t28) ThenBlock: {
            PrintMessage("PASS: AND works")
            PrintMessage("\n")
        }
        t30 = AIMacro.NumGt(x, 100)
        t31 = t30
        IfCondition Not(AIMacro.SmartBool(t31)) ThenBlock: {
            t32 = AIMacro.NumEq(y, 10)
            t31 = t32
        }
        IfCondition AIMacro.SmartBool(t31) ThenBlock: {
            PrintMessage("PASS: OR works")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool(AIMacro.NotVal(AIMacro.NumGt(x, 100))) ThenBlock: {
            PrintMessage("PASS: NOT works")
            PrintMessage("\n")
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- SECTION 3: FUNCTIONS ---")
        PrintMessage("\n")
        t33 = add(15, 27)
        sum_result = t33
        t34 = AIMacro.Str(sum_result)
        t35 = String.Concat("add(15, 27) = ", t34)
        AIMacro.SmartPrint(t35)
        PrintMessage("\n")
        t36 = multiply(6, 7)
        prod = t36
        t37 = AIMacro.Str(prod)
        t38 = String.Concat("multiply(6, 7) = ", t37)
        AIMacro.SmartPrint(t38)
        PrintMessage("\n")
        t39 = factorial(5)
        fact5 = t39
        t40 = AIMacro.Str(fact5)
        t41 = String.Concat("factorial(5) = ", t40)
        AIMacro.SmartPrint(t41)
        PrintMessage("\n")
        t42 = is_even(42)
        even_check = t42
        t43 = AIMacro.NumEq(even_check, 1)
        IfCondition AIMacro.SmartBool(t43) ThenBlock: {
            PrintMessage("PASS: 42 is even")
            PrintMessage("\n")
        }
        t44 = find_max(42, 17, 99)
        max_val = t44
        t45 = AIMacro.Str(max_val)
        t46 = String.Concat("find_max(42, 17, 99) = ", t45)
        AIMacro.SmartPrint(t46)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- SECTION 4: STRINGS ---")
        PrintMessage("\n")
        s1 = "Hello"
        s2 = "World"
        t47 = String.Concat(s1, " ")
        t48 = String.Concat(t47, s2)
        s3 = t48
                t49 = String.Concat("Concat: ", s3)
AIMacro.SmartPrint(t49)
        PrintMessage("\n")
        stars = String.Repeat("*", AIMacro.Int(10))
                t50 = String.Concat("Repeat: ", stars)
AIMacro.SmartPrint(t50)
        PrintMessage("\n")
        t51 = DictGen_SmartLen(s1)
        t52 = AIMacro.Str(t51)
        t53 = String.Concat("len(Hello) = ", t52)
        AIMacro.SmartPrint(t53)
        PrintMessage("\n")
        test1 = "abc"
        t54 = String.Concat("ab", "c")
        test2 = t54
        t55 = AIMacro.Bool(EqualTo(StringCompare(test1, test2), 0))
        IfCondition AIMacro.SmartBool(t55) ThenBlock: {
            PrintMessage("PASS: Dynamic string equality")
            PrintMessage("\n")
        }
        t56 = greet("AIMacro")
        greeting = t56
        AIMacro.SmartPrint(greeting)
        PrintMessage("\n")
        num = 12345
        num_as_str = AIMacro.Str(num)
                t57 = String.Concat("Number as string: ", num_as_str)
AIMacro.SmartPrint(t57)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- SECTION 5: CONTROL FLOW ---")
        PrintMessage("\n")
        score = 85
        IfCondition AIMacro.SmartBool(AIMacro.NumGe(score, 90)) ThenBlock: {
            PrintMessage("Grade: A")
            PrintMessage("\n")
        } ElseBlock: {
            IfCondition AIMacro.SmartBool(AIMacro.NumGe(score, 80)) ThenBlock: {
                PrintMessage("Grade: B")
                PrintMessage("\n")
            } ElseBlock: {
                IfCondition AIMacro.SmartBool(AIMacro.NumGe(score, 70)) ThenBlock: {
                    PrintMessage("Grade: C")
                    PrintMessage("\n")
                } ElseBlock: {
                    PrintMessage("Grade: F")
                    PrintMessage("\n")
                }
            }
        }
        PrintMessage("While countdown:")
        PrintMessage("\n")
        count = 3
        WhileLoop AIMacro.SmartBool(AIMacro.NumGt(count, 0)) {
            AIMacro.SmartPrint(count)
            PrintMessage("\n")
            count = AIMacro.NumSub(count, 1)
        }
        PrintMessage("For loop 0-4:")
        PrintMessage("\n")
        lc58 = 0
        ls58 = 5
        lt58 = 1
        WhileLoop LessThan(lc58, ls58) {
            i = lc58
            lc58 = Add(lc58, lt58)
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
        test_break_continue()
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- SECTION 6: LISTS ---")
        PrintMessage("\n")
        nums = Array.Create(5)
        Array.Push(nums, 10)
        Array.Push(nums, 20)
        Array.Push(nums, 30)
        Array.Push(nums, 40)
        Array.Push(nums, 50)
        PrintMessage("List created with 5 elements")
        PrintMessage("\n")
        t59 = DictGen_SmartGet(nums, 0)
        t60 = AIMacro.Str(t59)
        t61 = String.Concat("First element: ", t60)
        AIMacro.SmartPrint(t61)
        PrintMessage("\n")
        t62 = DictGen_SmartGet(nums, 4)
        t63 = AIMacro.Str(t62)
        t64 = String.Concat("Last element: ", t63)
        AIMacro.SmartPrint(t64)
        PrintMessage("\n")
        t65 = AIMacro.SmartLen(nums)
        t66 = AIMacro.Str(t65)
        t67 = String.Concat("Length: ", t66)
        AIMacro.SmartPrint(t67)
        PrintMessage("\n")
        DictGen_SmartSet(nums, 2, 999)
        t68 = DictGen_SmartGet(nums, 2)
        t69 = AIMacro.Str(t68)
        t70 = String.Concat("After nums[2]=999: ", t69)
        AIMacro.SmartPrint(t70)
        PrintMessage("\n")
        AIMacro.SmartPush(nums, 60)
        t71 = AIMacro.SmartLen(nums)
        t72 = AIMacro.Str(t71)
        t73 = String.Concat("After append(60), length: ", t72)
        AIMacro.SmartPrint(t73)
        PrintMessage("\n")
        total = 0
        lc74 = 0
        ls74 = 5
        lt74 = 1
        WhileLoop LessThan(lc74, ls74) {
            i = lc74
            lc74 = Add(lc74, lt74)
            t75 = DictGen_SmartGet(nums, i)
            total = AIMacro.NumAdd(total, t75)
        }
        t76 = AIMacro.Str(total)
        t77 = String.Concat("Sum of first 5: ", t76)
        AIMacro.SmartPrint(t77)
        PrintMessage("\n")
        built = Array.Create(0)
        lc78 = 0
        ls78 = 3
        lt78 = 1
        WhileLoop LessThan(lc78, ls78) {
            i = lc78
            lc78 = Add(lc78, lt78)
            AIMacro.SmartPush(built, AIMacro.NumMul(i, 10))
        }
        t79 = AIMacro.SmartLen(built)
        t80 = AIMacro.Str(t79)
        t81 = String.Concat("Built list length: ", t80)
        AIMacro.SmartPrint(t81)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- SECTION 7: AUGMENTED ASSIGNMENT ---")
        PrintMessage("\n")
        v = 10
        v = AIMacro.NumAdd(v, 5)
        t82 = AIMacro.Str(v)
        t83 = String.Concat("10 += 5 = ", t82)
        AIMacro.SmartPrint(t83)
        PrintMessage("\n")
        v = AIMacro.NumSub(v, 3)
        t84 = AIMacro.Str(v)
        t85 = String.Concat("15 -= 3 = ", t84)
        AIMacro.SmartPrint(t85)
        PrintMessage("\n")
        v = AIMacro.NumMul(v, 2)
        t86 = AIMacro.Str(v)
        t87 = String.Concat("12 *= 2 = ", t86)
        AIMacro.SmartPrint(t87)
        PrintMessage("\n")
        v = AIMacro.TrueDiv(v, 4)
        t88 = AIMacro.Str(v)
        t89 = String.Concat("24 /= 4 = ", t88)
        AIMacro.SmartPrint(t89)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- SECTION 8: NESTED STRUCTURES ---")
        PrintMessage("\n")
        PrintMessage("Multiplication table 3x3:")
        PrintMessage("\n")
        lc90 = 1
        ls90 = 4
        lt90 = 1
        WhileLoop LessThan(lc90, ls90) {
            i = lc90
            lc90 = Add(lc90, lt90)
            line = ""
            lc91 = 1
            ls91 = 4
            lt91 = 1
            WhileLoop LessThan(lc91, ls91) {
                j = lc91
                lc91 = Add(lc91, lt91)
                product = AIMacro.NumMul(i, j)
                t92 = AIMacro.Str(product)
                t93 = String.Concat(line, t92)
                t94 = String.Concat(t93, " ")
                line = t94
            }
            AIMacro.SmartPrint(line)
            PrintMessage("\n")
        }
        a = 5
        b = 10
        c = 15
        IfCondition AIMacro.SmartBool(AIMacro.NumLt(a, b)) ThenBlock: {
            IfCondition AIMacro.SmartBool(AIMacro.NumLt(b, c)) ThenBlock: {
                PrintMessage("PASS: Nested if (a < b < c)")
                PrintMessage("\n")
            }
        }
        t95 = multiply(2, 3)
        t96 = multiply(4, 5)
        t97 = add(t95, t96)
        result = t97
        t98 = AIMacro.Str(result)
        t99 = String.Concat("add(multiply(2,3), multiply(4,5)) = ", t98)
        AIMacro.SmartPrint(t99)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- SECTION 9: EDGE CASES ---")
        PrintMessage("\n")
        t100 = AIMacro.NumMul(0, 100)
        t101 = AIMacro.Str(t100)
        t102 = String.Concat("0 * 100 = ", t101)
        AIMacro.SmartPrint(t102)
        PrintMessage("\n")
        t103 = AIMacro.TrueDiv(100, 1)
        t104 = AIMacro.Str(t103)
        t105 = String.Concat("100 / 1 = ", t104)
        AIMacro.SmartPrint(t105)
        PrintMessage("\n")
        empty = ""
        t106 = DictGen_SmartLen(empty)
        t107 = AIMacro.Str(t106)
        t108 = String.Concat("Empty string length: ", t107)
        AIMacro.SmartPrint(t108)
        PrintMessage("\n")
        single_count = 0
        lc109 = 0
        ls109 = 1
        lt109 = 1
        WhileLoop LessThan(lc109, ls109) {
            i = lc109
            lc109 = Add(lc109, lt109)
            single_count = AIMacro.NumAdd(single_count, 1)
        }
        t110 = AIMacro.Str(single_count)
        t111 = String.Concat("range(1) iterations: ", t110)
        AIMacro.SmartPrint(t111)
        PrintMessage("\n")
        zero_count = 0
        lc112 = 0
        ls112 = 0
        lt112 = 1
        WhileLoop LessThan(lc112, ls112) {
            i = lc112
            lc112 = Add(lc112, lt112)
            zero_count = AIMacro.NumAdd(zero_count, 1)
        }
        t113 = AIMacro.Str(zero_count)
        t114 = String.Concat("range(0) iterations: ", t113)
        AIMacro.SmartPrint(t114)
        PrintMessage("\n")
        big = 1000000
        t115 = AIMacro.Str(big)
        t116 = String.Concat("Million: ", t115)
        AIMacro.SmartPrint(t116)
        PrintMessage("\n")
        t117 = AIMacro.NumMul(big, 2)
        t118 = AIMacro.Str(t117)
        t119 = String.Concat("Million * 2: ", t118)
        AIMacro.SmartPrint(t119)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
                t120 = String.Repeat("=", AIMacro.Int(50))
AIMacro.SmartPrint(t120)
        PrintMessage("\n")
        PrintMessage("ALL TESTS COMPLETE!")
        PrintMessage("\n")
                t121 = String.Repeat("=", AIMacro.Int(50))
AIMacro.SmartPrint(t121)
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
