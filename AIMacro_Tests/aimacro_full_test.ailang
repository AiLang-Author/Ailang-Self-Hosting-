LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.add {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        t0 = Add(p_a, p_b)
        ReturnValue(t0)
    }
}

Function.multiply {
    Input: p_x: Integer
    Input: p_y: Integer
    Body: {
        result = Multiply(p_x, p_y)
        ReturnValue(result)
    }
}

Function.factorial {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 1) ThenBlock: {
            ReturnValue(1)
        }
        t0 = Subtract(p_n, 1)
        t1 = factorial(t0)
        t2 = Multiply(p_n, t1)
        ReturnValue(t2)
    }
}

Function.is_even {
    Input: p_num: Integer
    Body: {
        remainder = Modulo(p_num, 2)
        IfCondition EqualTo(remainder, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.greet {
    Input: p_name: Integer
    Body: {
        t0 = String.Concat("Hello, ", p_name)
        t1 = String.Concat(t0, "!")
        msg = t1
        ReturnValue(msg)
    }
}

Function.count_down {
    Input: p_start: Integer
    Body: {
        i = p_start
        WhileLoop GreaterThan(i, 0) {
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
            i = Subtract(i, 1)
        }
        PrintMessage("Blast off!")
        PrintMessage("\n")
    }
}

Function.sum_range {
    Input: p_n: Integer
    Body: {
        total = 0
        lc0 = 0
        ls0 = p_n
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            total = Add(total, i)
        }
        ReturnValue(total)
    }
}

Function.find_max {
    Input: p_a: Integer
    Input: p_b: Integer
    Input: p_c: Integer
    Body: {
        max_val = p_a
        IfCondition GreaterThan(p_b, max_val) ThenBlock: {
            max_val = p_b
        }
        IfCondition GreaterThan(p_c, max_val) ThenBlock: {
            max_val = p_c
        }
        ReturnValue(max_val)
    }
}

Function.test_break_continue {
    Body: {
        count = 0
        lc0 = 0
        ls0 = 10
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            IfCondition EqualTo(i, 5) ThenBlock: {
                BreakLoop
            }
            count = Add(count, 1)
        }
        t1 = AIMacro.Str(count)
        t2 = String.Concat("Break test (should be 5): ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        evens = 0
        lc3 = 0
        ls3 = 10
        lt3 = 1
        WhileLoop LessThan(lc3, ls3) {
            i = lc3
            lc3 = Add(lc3, lt3)
            IfCondition NotEqual(Modulo(i, 2), 0) ThenBlock: {
                ContinueLoop
            }
            evens = Add(evens, 1)
        }
        t4 = AIMacro.Str(evens)
        t5 = String.Concat("Continue test (should be 5): ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
    }
}

SubRoutine.Main {
                t0 = String.Repeat("=", 50)
