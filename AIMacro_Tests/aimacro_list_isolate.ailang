LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.build_list_simple {
    Body: {
        PrintMessage("=== build_list_simple ===")
        PrintMessage("\n")
        result = Array.Create(0)
        AIMacro.SmartPush(result, 1)
        AIMacro.SmartPush(result, 2)
        AIMacro.SmartPush(result, 3)
        t0 = AIMacro.SmartLen(result)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("Built: len=", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = DictGen_SmartGet(result, 0)
        t4 = AIMacro.Str(t3)
        t5 = String.Concat("result[0]=", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = DictGen_SmartGet(result, 1)
        t7 = AIMacro.Str(t6)
        t8 = String.Concat("result[1]=", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        t9 = DictGen_SmartGet(result, 2)
        t10 = AIMacro.Str(t9)
        t11 = String.Concat("result[2]=", t10)
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        ReturnValue(result)
    }
}

Function.build_list_loop {
    Body: {
        PrintMessage("=== build_list_loop ===")
        PrintMessage("\n")
        result = Array.Create(0)
        i = 0
        WhileLoop LessThan(i, 5) {
            AIMacro.SmartPush(result, Multiply(i, 10))
            i = Add(i, 1)
        }
        t0 = AIMacro.SmartLen(result)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("Built: len=", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        j = 0
        WhileLoop EqualTo(1, 1) {
            t3 = AIMacro.SmartLen(result)
            IfCondition Not(LessThan(j, t3)) ThenBlock: {
                BreakLoop
            }
            t4 = AIMacro.Str(j)
            t5 = String.Concat("result[", t4)
            t6 = String.Concat(t5, "]=")
            t7 = DictGen_SmartGet(result, j)
            t8 = AIMacro.Str(t7)
            t9 = String.Concat(t6, t8)
            AIMacro.SmartPrint(t9)
            PrintMessage("\n")
            j = Add(j, 1)
        }
        ReturnValue(result)
    }
}

Function.map_test {
    Input: p_arr: Integer
    Body: {
        PrintMessage("=== map_test ===")
        PrintMessage("\n")
        t0 = DictGen_SmartLen(p_arr)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("Input len=", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        result = Array.Create(0)
        i = 0
        WhileLoop EqualTo(1, 1) {
            t3 = DictGen_SmartLen(p_arr)
            IfCondition Not(LessThan(i, t3)) ThenBlock: {
                BreakLoop
            }
            t4 = DictGen_SmartGet(p_arr, i)
            val = t4
            t5 = AIMacro.Str(i)
            t6 = String.Concat("  arr[", t5)
            t7 = String.Concat(t6, "]=")
            t8 = AIMacro.Str(val)
            t9 = String.Concat(t7, t8)
            AIMacro.SmartPrint(t9)
            PrintMessage("\n")
            doubled = Multiply(val, 2)
            t10 = AIMacro.Str(doubled)
            t11 = String.Concat("  doubled=", t10)
            AIMacro.SmartPrint(t11)
            PrintMessage("\n")
            AIMacro.SmartPush(result, doubled)
            t12 = AIMacro.SmartLen(result)
            t13 = AIMacro.Str(t12)
            t14 = String.Concat("  appended, result len=", t13)
            AIMacro.SmartPrint(t14)
            PrintMessage("\n")
            i = Add(i, 1)
        }
        t15 = AIMacro.SmartLen(result)
        t16 = AIMacro.Str(t15)
        t17 = String.Concat("Final result len=", t16)
        AIMacro.SmartPrint(t17)
        PrintMessage("\n")
        ReturnValue(result)
    }
}

Function.product_test {
    Input: p_arr: Integer
    Body: {
        PrintMessage("=== product_test ===")
        PrintMessage("\n")
        t0 = DictGen_SmartLen(p_arr)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("Input: len=", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        prod = 1
        i = 0
        WhileLoop EqualTo(1, 1) {
            t3 = DictGen_SmartLen(p_arr)
            IfCondition Not(LessThan(i, t3)) ThenBlock: {
                BreakLoop
            }
            t4 = DictGen_SmartGet(p_arr, i)
            val = t4
            t5 = AIMacro.Str(i)
            t6 = String.Concat("  arr[", t5)
            t7 = String.Concat(t6, "]=")
            t8 = AIMacro.Str(val)
            t9 = String.Concat(t7, t8)
            t10 = String.Concat(t9, ", prod before=")
            t11 = AIMacro.Str(prod)
            t12 = String.Concat(t10, t11)
            AIMacro.SmartPrint(t12)
            PrintMessage("\n")
            prod = Multiply(prod, val)
            t13 = AIMacro.Str(prod)
            t14 = String.Concat("  prod after=", t13)
            AIMacro.SmartPrint(t14)
            PrintMessage("\n")
            i = Add(i, 1)
        }
        ReturnValue(prod)
    }
}

SubRoutine.Main {
        PrintMessage("LIST BUILD DEBUG TEST")
        PrintMessage("\n")
                t0 = String.Repeat("=", 40)
AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        t1 = build_list_simple()
        r1 = t1
        PrintMessage("")
        PrintMessage("\n")
        t2 = build_list_loop()
        r2 = t2
        PrintMessage("")
        PrintMessage("\n")
        input_arr = Array.Create(5)
        Array.Push(input_arr, 1)
        Array.Push(input_arr, 2)
        Array.Push(input_arr, 3)
        Array.Push(input_arr, 4)
        Array.Push(input_arr, 5)
        PrintMessage("Creating input array...")
        PrintMessage("\n")
        t3 = AIMacro.SmartLen(input_arr)
        t4 = AIMacro.Str(t3)
        t5 = String.Concat("input_arr len=", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        j = 0
        WhileLoop EqualTo(1, 1) {
            t6 = AIMacro.SmartLen(input_arr)
            IfCondition Not(LessThan(j, t6)) ThenBlock: {
                BreakLoop
            }
            t7 = AIMacro.Str(j)
            t8 = String.Concat("input_arr[", t7)
            t9 = String.Concat(t8, "]=")
            t10 = DictGen_SmartGet(input_arr, j)
            t11 = AIMacro.Str(t10)
            t12 = String.Concat(t9, t11)
            AIMacro.SmartPrint(t12)
            PrintMessage("\n")
            j = Add(j, 1)
        }
        PrintMessage("")
        PrintMessage("\n")
        t13 = map_test(input_arr)
        mapped = t13
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("Mapped result:")
        PrintMessage("\n")
        k = 0
        WhileLoop EqualTo(1, 1) {
            t14 = DictGen_SmartLen(mapped)
            IfCondition Not(LessThan(k, t14)) ThenBlock: {
                BreakLoop
            }
            t15 = AIMacro.Str(k)
            t16 = String.Concat("mapped[", t15)
            t17 = String.Concat(t16, "]=")
            t18 = DictGen_SmartGet(mapped, k)
            t19 = AIMacro.Str(t18)
            t20 = String.Concat(t17, t19)
            AIMacro.SmartPrint(t20)
            PrintMessage("\n")
            k = Add(k, 1)
        }
        PrintMessage("")
        PrintMessage("\n")
        small = Array.Create(5)
        Array.Push(small, 1)
        Array.Push(small, 2)
        Array.Push(small, 3)
        Array.Push(small, 4)
        Array.Push(small, 5)
        PrintMessage("Product of [1,2,3,4,5]:")
        PrintMessage("\n")
        t21 = product_test(small)
        p = t21
        t22 = AIMacro.Str(p)
        t23 = String.Concat("Final product=", t22)
        AIMacro.SmartPrint(t23)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
                t24 = String.Repeat("=", 40)
AIMacro.SmartPrint(t24)
        PrintMessage("\n")
        PrintMessage("DEBUG COMPLETE")
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
