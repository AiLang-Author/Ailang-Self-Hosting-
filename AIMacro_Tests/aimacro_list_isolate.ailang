LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.build_list_simple {
    Body: {
        PrintMessage("=== build_list_simple ===")
        PrintMessage("\n")
        result = Array.Create(0)
        AIMacro.SmartPush(result, 1)
        AIMacro.SmartPush(result, 2)
        AIMacro.SmartPush(result, 3)
        t0 = AIMacro.SmartLen(result)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("Built: len=", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = DictGen_SmartGet(result, 0)
        t4 = AIMacro.Str(t3)
        t5 = String.Concat("result[0]=", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = DictGen_SmartGet(result, 1)
        t7 = AIMacro.Str(t6)
        t8 = String.Concat("result[1]=", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        t9 = DictGen_SmartGet(result, 2)
        t10 = AIMacro.Str(t9)
        t11 = String.Concat("result[2]=", t10)
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        ReturnValue(result)
    }
}

Function.build_list_loop {
    Body: {
        PrintMessage("=== build_list_loop ===")
        PrintMessage("\n")
        result = Array.Create(0)
        i = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(i, 5)) {
            AIMacro.SmartPush(result, AIMacro.NumMul(i, 10))
            i = AIMacro.NumAdd(i, 1)
        }
        t0 = AIMacro.SmartLen(result)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("Built: len=", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        j = 0
        WhileLoop EqualTo(1, 1) {
            t3 = AIMacro.SmartLen(result)
            t4 = AIMacro.NumLt(j, t3)
            IfCondition Not(AIMacro.SmartBool(t4)) ThenBlock: {
                BreakLoop
            }
            t5 = AIMacro.Str(j)
            t6 = String.Concat("result[", t5)
            t7 = String.Concat(t6, "]=")
            t8 = DictGen_SmartGet(result, j)
            t9 = AIMacro.Str(t8)
            t10 = String.Concat(t7, t9)
            AIMacro.SmartPrint(t10)
            PrintMessage("\n")
            j = AIMacro.NumAdd(j, 1)
        }
        ReturnValue(result)
    }
}

Function.map_test {
    Input: p_arr: Integer
    Body: {
        PrintMessage("=== map_test ===")
        PrintMessage("\n")
        t0 = DictGen_SmartLen(p_arr)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("Input len=", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        result = Array.Create(0)
        i = 0
        WhileLoop EqualTo(1, 1) {
            t3 = DictGen_SmartLen(p_arr)
            t4 = AIMacro.NumLt(i, t3)
            IfCondition Not(AIMacro.SmartBool(t4)) ThenBlock: {
                BreakLoop
            }
            t5 = DictGen_SmartGet(p_arr, i)
            val = t5
            t6 = AIMacro.Str(i)
            t7 = String.Concat("  arr[", t6)
            t8 = String.Concat(t7, "]=")
            t9 = AIMacro.Str(val)
            t10 = String.Concat(t8, t9)
            AIMacro.SmartPrint(t10)
            PrintMessage("\n")
            doubled = AIMacro.NumMul(val, 2)
            t11 = AIMacro.Str(doubled)
            t12 = String.Concat("  doubled=", t11)
            AIMacro.SmartPrint(t12)
            PrintMessage("\n")
            AIMacro.SmartPush(result, doubled)
            t13 = AIMacro.SmartLen(result)
            t14 = AIMacro.Str(t13)
            t15 = String.Concat("  appended, result len=", t14)
            AIMacro.SmartPrint(t15)
            PrintMessage("\n")
            i = AIMacro.NumAdd(i, 1)
        }
        t16 = AIMacro.SmartLen(result)
        t17 = AIMacro.Str(t16)
        t18 = String.Concat("Final result len=", t17)
        AIMacro.SmartPrint(t18)
        PrintMessage("\n")
        ReturnValue(result)
    }
}

Function.product_test {
    Input: p_arr: Integer
    Body: {
        PrintMessage("=== product_test ===")
        PrintMessage("\n")
        t0 = DictGen_SmartLen(p_arr)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("Input: len=", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        prod = 1
        i = 0
        WhileLoop EqualTo(1, 1) {
            t3 = DictGen_SmartLen(p_arr)
            t4 = AIMacro.NumLt(i, t3)
            IfCondition Not(AIMacro.SmartBool(t4)) ThenBlock: {
                BreakLoop
            }
            t5 = DictGen_SmartGet(p_arr, i)
            val = t5
            t6 = AIMacro.Str(i)
            t7 = String.Concat("  arr[", t6)
            t8 = String.Concat(t7, "]=")
            t9 = AIMacro.Str(val)
            t10 = String.Concat(t8, t9)
            t11 = String.Concat(t10, ", prod before=")
            t12 = AIMacro.Str(prod)
            t13 = String.Concat(t11, t12)
            AIMacro.SmartPrint(t13)
            PrintMessage("\n")
            prod = AIMacro.NumMul(prod, val)
            t14 = AIMacro.Str(prod)
            t15 = String.Concat("  prod after=", t14)
            AIMacro.SmartPrint(t15)
            PrintMessage("\n")
            i = AIMacro.NumAdd(i, 1)
        }
        ReturnValue(prod)
    }
}

Function.main {
    Body: {
        PrintMessage("LIST BUILD DEBUG TEST")
        PrintMessage("\n")
                t0 = String.Repeat("=", AIMacro.Int(40))
AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        t1 = build_list_simple()
        r1 = t1
        PrintMessage("")
        PrintMessage("\n")
        t2 = build_list_loop()
        r2 = t2
        PrintMessage("")
        PrintMessage("\n")
        input_arr = Array.Create(5)
        Array.Push(input_arr, 1)
        Array.Push(input_arr, 2)
        Array.Push(input_arr, 3)
        Array.Push(input_arr, 4)
        Array.Push(input_arr, 5)
        PrintMessage("Creating input array...")
        PrintMessage("\n")
        t3 = AIMacro.SmartLen(input_arr)
        t4 = AIMacro.Str(t3)
        t5 = String.Concat("input_arr len=", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        j = 0
        WhileLoop EqualTo(1, 1) {
            t6 = AIMacro.SmartLen(input_arr)
            t7 = AIMacro.NumLt(j, t6)
            IfCondition Not(AIMacro.SmartBool(t7)) ThenBlock: {
                BreakLoop
            }
            t8 = AIMacro.Str(j)
            t9 = String.Concat("input_arr[", t8)
            t10 = String.Concat(t9, "]=")
            t11 = DictGen_SmartGet(input_arr, j)
            t12 = AIMacro.Str(t11)
            t13 = String.Concat(t10, t12)
            AIMacro.SmartPrint(t13)
            PrintMessage("\n")
            j = AIMacro.NumAdd(j, 1)
        }
        PrintMessage("")
        PrintMessage("\n")
        t14 = map_test(input_arr)
        mapped = t14
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("Mapped result:")
        PrintMessage("\n")
        k = 0
        WhileLoop EqualTo(1, 1) {
            t15 = DictGen_SmartLen(mapped)
            t16 = AIMacro.NumLt(k, t15)
            IfCondition Not(AIMacro.SmartBool(t16)) ThenBlock: {
                BreakLoop
            }
            t17 = AIMacro.Str(k)
            t18 = String.Concat("mapped[", t17)
            t19 = String.Concat(t18, "]=")
            t20 = DictGen_SmartGet(mapped, k)
            t21 = AIMacro.Str(t20)
            t22 = String.Concat(t19, t21)
            AIMacro.SmartPrint(t22)
            PrintMessage("\n")
            k = AIMacro.NumAdd(k, 1)
        }
        PrintMessage("")
        PrintMessage("\n")
        small = Array.Create(5)
        Array.Push(small, 1)
        Array.Push(small, 2)
        Array.Push(small, 3)
        Array.Push(small, 4)
        Array.Push(small, 5)
        PrintMessage("Product of [1,2,3,4,5]:")
        PrintMessage("\n")
        t23 = product_test(small)
        p = t23
        t24 = AIMacro.Str(p)
        t25 = String.Concat("Final product=", t24)
        AIMacro.SmartPrint(t25)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
                t26 = String.Repeat("=", AIMacro.Int(40))
AIMacro.SmartPrint(t26)
        PrintMessage("\n")
        PrintMessage("DEBUG COMPLETE")
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
