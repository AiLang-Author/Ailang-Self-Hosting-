LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.test_six {
    Input: p_a: Integer
    Input: p_b: Integer
    Input: p_c: Integer
    Input: p_d: Integer
    Input: p_e: Integer
    Input: p_f: Integer
    Body: {
        PrintMessage("In test_six:")
        PrintMessage("\n")
        t0 = AIMacro.Str(p_a)
        t1 = String.Concat("a=", t0)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = AIMacro.Str(p_b)
        t3 = String.Concat("b=", t2)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = AIMacro.Str(p_c)
        t5 = String.Concat("c=", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = AIMacro.Str(p_d)
        t7 = String.Concat("d=", t6)
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        t8 = AIMacro.Str(p_e)
        t9 = String.Concat("e=", t8)
        AIMacro.SmartPrint(t9)
        PrintMessage("\n")
        t10 = AIMacro.Str(p_f)
        t11 = String.Concat("f=", t10)
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        t12 = Add(p_a, p_b)
        t13 = Add(t12, p_c)
        t14 = Add(t13, p_d)
        t15 = Add(t14, p_e)
        t16 = Add(t15, p_f)
        ReturnValue(t16)
    }
}

Function.test_seven {
    Input: p__args: Address
    Body: {
        p_a = DictGen_SmartGet(p__args, 0)
        p_b = DictGen_SmartGet(p__args, 1)
        p_c = DictGen_SmartGet(p__args, 2)
        p_d = DictGen_SmartGet(p__args, 3)
        p_e = DictGen_SmartGet(p__args, 4)
        p_f = DictGen_SmartGet(p__args, 5)
        p_g = DictGen_SmartGet(p__args, 6)
        PrintMessage("In test_seven:")
        PrintMessage("\n")
        t0 = AIMacro.Str(p_a)
        t1 = String.Concat("a=", t0)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = AIMacro.Str(p_b)
        t3 = String.Concat("b=", t2)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = AIMacro.Str(p_c)
        t5 = String.Concat("c=", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = AIMacro.Str(p_d)
        t7 = String.Concat("d=", t6)
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        t8 = AIMacro.Str(p_e)
        t9 = String.Concat("e=", t8)
        AIMacro.SmartPrint(t9)
        PrintMessage("\n")
        t10 = AIMacro.Str(p_f)
        t11 = String.Concat("f=", t10)
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        t12 = AIMacro.Str(p_g)
        t13 = String.Concat("g=", t12)
        AIMacro.SmartPrint(t13)
        PrintMessage("\n")
        t14 = Add(p_a, p_b)
        t15 = Add(t14, p_c)
        t16 = Add(t15, p_d)
        t17 = Add(t16, p_e)
        t18 = Add(t17, p_f)
        t19 = Add(t18, p_g)
        ReturnValue(t19)
    }
}

Function.test_list_sum_simple {
    Body: {
        arr = Array.Create(3)
        Array.Push(arr, 10)
        Array.Push(arr, 20)
        Array.Push(arr, 30)
        t0 = DictGen_SmartGet(arr, 0)
        a = t0
        t1 = DictGen_SmartGet(arr, 1)
        b = t1
        t2 = DictGen_SmartGet(arr, 2)
        c = t2
        t3 = AIMacro.Str(a)
        t4 = String.Concat("a=", t3)
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        t5 = AIMacro.Str(b)
        t6 = String.Concat("b=", t5)
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        t7 = AIMacro.Str(c)
        t8 = String.Concat("c=", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        total = Add(Add(a, b), c)
        t9 = AIMacro.Str(total)
        t10 = String.Concat("total=", t9)
        AIMacro.SmartPrint(t10)
        PrintMessage("\n")
        ReturnValue(total)
    }
}

Function.test_list_sum_direct {
    Body: {
        arr = Array.Create(3)
        Array.Push(arr, 10)
        Array.Push(arr, 20)
        Array.Push(arr, 30)
        t0 = DictGen_SmartGet(arr, 0)
        x = t0
        t1 = AIMacro.Str(x)
        t2 = String.Concat("x=arr[0]=", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = DictGen_SmartGet(arr, 1)
        y = t3
        t4 = AIMacro.Str(y)
        t5 = String.Concat("y=arr[1]=", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = DictGen_SmartGet(arr, 2)
        z = t6
        t7 = AIMacro.Str(z)
        t8 = String.Concat("z=arr[2]=", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        step1 = Add(x, y)
        t9 = AIMacro.Str(step1)
        t10 = String.Concat("x+y=", t9)
        AIMacro.SmartPrint(t10)
        PrintMessage("\n")
        step2 = Add(step1, z)
        t11 = AIMacro.Str(step2)
        t12 = String.Concat("x+y+z=", t11)
        AIMacro.SmartPrint(t12)
        PrintMessage("\n")
        ReturnValue(step2)
    }
}

Function.test_list_inline_sum {
    Body: {
        arr = Array.Create(3)
        Array.Push(arr, 100)
        Array.Push(arr, 200)
        Array.Push(arr, 300)
        t0 = DictGen_SmartGet(arr, 0)
        t1 = DictGen_SmartGet(arr, 1)
        t2 = Add(t0, t1)
        t3 = DictGen_SmartGet(arr, 2)
        t4 = Add(t2, t3)
        result = t4
        t5 = AIMacro.Str(result)
        t6 = String.Concat("Inline sum result: ", t5)
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        ReturnValue(result)
    }
}

SubRoutine.Main {
        PrintMessage("=== SIX PARAMS ===")
        PrintMessage("\n")
        t0 = test_six(1, 2, 3, 4, 5, 6)
        r6 = t0
        t1 = AIMacro.Str(r6)
        t2 = String.Concat("Result: ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        PrintMessage("Expected: 21")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SEVEN PARAMS ===")
        PrintMessage("\n")
        t3 = Array.Create(7)
        Array.Push(t3, 1)
        Array.Push(t3, 2)
        Array.Push(t3, 3)
        Array.Push(t3, 4)
        Array.Push(t3, 5)
        Array.Push(t3, 6)
        Array.Push(t3, 7)
        r7 = test_seven(t3)
        t4 = AIMacro.Str(r7)
        t5 = String.Concat("Result: ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        PrintMessage("Expected: 28")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== LIST SUM SIMPLE ===")
        PrintMessage("\n")
        t6 = test_list_sum_simple()
        s1 = t6
        t7 = AIMacro.Str(s1)
        t8 = String.Concat("Result: ", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        PrintMessage("Expected: 60")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== LIST SUM DIRECT ===")
        PrintMessage("\n")
        t9 = test_list_sum_direct()
        s2 = t9
        t10 = AIMacro.Str(s2)
        t11 = String.Concat("Result: ", t10)
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        PrintMessage("Expected: 60")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== LIST INLINE SUM ===")
        PrintMessage("\n")
        t12 = test_list_inline_sum()
        s3 = t12
        PrintMessage("Expected: 600")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("DONE")
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
