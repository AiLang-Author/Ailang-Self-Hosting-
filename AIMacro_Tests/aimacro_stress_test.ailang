Function.test_integer_literals {
    Body: {
        PrintMessage("=== INTEGER LITERALS ===")
        PrintMessage("\n")
        a = 0
        b = 42
        c = Subtract(0, 100)
        d = 999999999
        t0 = AIMacro.Str(a)
        t1 = String.Concat("Zero: ", t0)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = AIMacro.Str(b)
        t3 = String.Concat("Positive: ", t2)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = AIMacro.Str(c)
        t5 = String.Concat("Negative: ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = AIMacro.Str(d)
        t7 = String.Concat("Large: ", t6)
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
    }
}

Function.test_string_literals {
    Body: {
        PrintMessage("=== STRING LITERALS ===")
        PrintMessage("\n")
        empty = ""
        simple = "hello"
        with_spaces = "hello world"
        with_escapes = "line1\nline2\ttabbed"
        single_char = "x"
        t0 = DictGen_SmartLen(empty)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("Empty len: ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
                t3 = String.Concat("Simple: ", simple)
AIMacro.SmartPrint(t3)
        PrintMessage("\n")
                t4 = String.Concat("Spaces: ", with_spaces)
AIMacro.SmartPrint(t4)
        PrintMessage("\n")
                t5 = String.Concat("Escapes: ", with_escapes)
AIMacro.SmartPrint(t5)
        PrintMessage("\n")
                t6 = String.Concat("Single: ", single_char)
AIMacro.SmartPrint(t6)
        PrintMessage("\n")
    }
}

Function.test_boolean_literals {
    Body: {
        PrintMessage("=== BOOLEAN LITERALS ===")
