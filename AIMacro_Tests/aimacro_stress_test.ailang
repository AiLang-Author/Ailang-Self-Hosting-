}

Function.test_arithmetic {
    Body: {
        PrintMessage("=== ARITHMETIC ===")
        PrintMessage("\n")
        a = 10
        b = 3
        t0 = Add(a, b)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("10 + 3 = ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = Subtract(a, b)
        t4 = AIMacro.Str(t3)
        t5 = String.Concat("10 - 3 = ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = Multiply(a, b)
        t7 = AIMacro.Str(t6)
        t8 = String.Concat("10 * 3 = ", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        t9 = Divide(a, b)
        t10 = AIMacro.Str(t9)
        t11 = String.Concat("10 / 3 = ", t10)
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        t12 = Modulo(a, b)
        t13 = AIMacro.Str(t12)
        t14 = String.Concat("10 % 3 = ", t13)
        AIMacro.SmartPrint(t14)
        PrintMessage("\n")
        c = Subtract(0, 5)
        t15 = Add(c, b)
        t16 = AIMacro.Str(t15)
        t17 = String.Concat("-5 + 3 = ", t16)
        AIMacro.SmartPrint(t17)
        PrintMessage("\n")
        t18 = Multiply(c, b)
        t19 = AIMacro.Str(t18)
        t20 = String.Concat("-5 * 3 = ", t19)
        AIMacro.SmartPrint(t20)
        PrintMessage("\n")
        t21 = Multiply(3, 4)
        t22 = Add(2, t21)
        t23 = AIMacro.Str(t22)
        t24 = String.Concat("2 + 3 * 4 = ", t23)
        AIMacro.SmartPrint(t24)
        PrintMessage("\n")
        t25 = Add(2, 3)
        t26 = Multiply(t25, 4)
        t27 = AIMacro.Str(t26)
        t28 = String.Concat("(2 + 3) * 4 = ", t27)
        AIMacro.SmartPrint(t28)
        PrintMessage("\n")
    }
}

Function.test_augmented_assignment {
    Body: {
        PrintMessage("=== AUGMENTED ASSIGNMENT ===")
        PrintMessage("\n")
        x = 10
        x = Add(x, 5)
        t0 = AIMacro.Str(x)
        t1 = String.Concat("10 += 5 = ", t0)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        x = 10
        x = Subtract(x, 3)
        t2 = AIMacro.Str(x)
        t3 = String.Concat("10 -= 3 = ", t2)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        x = 10
        x = Multiply(x, 2)
        t4 = AIMacro.Str(x)
        t5 = String.Concat("10 *= 2 = ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        x = 10
        x = Divide(x, 2)
        t6 = AIMacro.Str(x)
        t7 = String.Concat("10 /= 2 = ", t6)
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
    }
}

Function.test_comparisons {
    Body: {
        PrintMessage("=== COMPARISONS ===")
        PrintMessage("\n")
        a = 5
        b = 10
        c = 5
        t0 = EqualTo(a, c)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("5 == 5: ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = EqualTo(a, b)
        t4 = AIMacro.Str(t3)
        t5 = String.Concat("5 == 10: ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = NotEqual(a, b)
        t7 = AIMacro.Str(t6)
        t8 = String.Concat("5 != 10: ", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        t9 = LessThan(a, b)
        t10 = AIMacro.Str(t9)
        t11 = String.Concat("5 < 10: ", t10)
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        t12 = LessEqual(a, c)
        t13 = AIMacro.Str(t12)
        t14 = String.Concat("5 <= 5: ", t13)
        AIMacro.SmartPrint(t14)
        PrintMessage("\n")
        t15 = GreaterThan(b, a)
        t16 = AIMacro.Str(t15)
        t17 = String.Concat("10 > 5: ", t16)
        AIMacro.SmartPrint(t17)
        PrintMessage("\n")
        t18 = GreaterEqual(b, b)
        t19 = AIMacro.Str(t18)
        t20 = String.Concat("10 >= 10: ", t19)
        AIMacro.SmartPrint(t20)
        PrintMessage("\n")
    }
}

Function.test_string_comparisons {
    Body: {
        PrintMessage("=== STRING COMPARISONS ===")
        PrintMessage("\n")
        s1 = "hello"
        s2 = "hello"
        s3 = "world"
        t0 = EqualTo(StringCompare(s1, s2), 0)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("hello == hello: ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = EqualTo(StringCompare(s1, s3), 0)
        t4 = AIMacro.Str(t3)
        t5 = String.Concat("hello == world: ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = NotEqual(StringCompare(s1, s3), 0)
        t7 = AIMacro.Str(t6)
        t8 = String.Concat("hello != world: ", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
    }
}

Function.test_logical_ops {
    Body: {
        PrintMessage("=== LOGICAL OPERATIONS ===")
        PrintMessage("\n")
        t = 1
        f = 0
        t0 = And(t, t)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("True and True: ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = And(t, f)
        t4 = AIMacro.Str(t3)
        t5 = String.Concat("True and False: ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = Or(t, f)
        t7 = AIMacro.Str(t6)
        t8 = String.Concat("True or False: ", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        t9 = Or(f, f)
        t10 = AIMacro.Str(t9)
        t11 = String.Concat("False or False: ", t10)
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        t12 = Not(t)
        t13 = AIMacro.Str(t12)
        t14 = String.Concat("not True: ", t13)
        AIMacro.SmartPrint(t14)
        PrintMessage("\n")
        t15 = Not(f)
        t16 = AIMacro.Str(t15)
        t17 = String.Concat("not False: ", t16)
        AIMacro.SmartPrint(t17)
        PrintMessage("\n")
        t18 = Not(f)
        t19 = And(t, t18)
        t20 = AIMacro.Str(t19)
        t21 = String.Concat("True and not False: ", t20)
        AIMacro.SmartPrint(t21)
        PrintMessage("\n")
        t22 = Or(t, f)
        t23 = And(t22, t)
        t24 = AIMacro.Str(t23)
        t25 = String.Concat("(True or False) and True: ", t24)
        AIMacro.SmartPrint(t25)
        PrintMessage("\n")
    }
}

Function.test_if_elif_else {
    Body: {
        PrintMessage("=== IF/ELIF/ELSE ===")
        PrintMessage("\n")
        x = 5
        IfCondition LessThan(x, 0) ThenBlock: {
            PrintMessage("negative")
            PrintMessage("\n")
        } ElseBlock: {
            IfCondition EqualTo(x, 0) ThenBlock: {
                PrintMessage("zero")
                PrintMessage("\n")
            } ElseBlock: {
                IfCondition LessThan(x, 10) ThenBlock: {
                    PrintMessage("small positive")
                    PrintMessage("\n")
                } ElseBlock: {
                    PrintMessage("large positive")
                    PrintMessage("\n")
                }
            }
        }
        IfCondition GreaterThan(x, 0) ThenBlock: {
            IfCondition LessThan(x, 10) ThenBlock: {
                PrintMessage("between 0 and 10")
                PrintMessage("\n")
            }
        }
    }
}

Function.test_while_loop {
    Body: {
        PrintMessage("=== WHILE LOOP ===")
        PrintMessage("\n")
        i = 0
        WhileLoop LessThan(i, 5) {
            t0 = AIMacro.Str(i)
            t1 = String.Concat("i = ", t0)
            AIMacro.SmartPrint(t1)
            PrintMessage("\n")
            i = Add(i, 1)
        }
        PrintMessage("While with break:")
        PrintMessage("\n")
        i = 0
        WhileLoop 1 {
            IfCondition GreaterEqual(i, 3) ThenBlock: {
                BreakLoop
            }
            t2 = AIMacro.Str(i)
            t3 = String.Concat("  i = ", t2)
            AIMacro.SmartPrint(t3)
            PrintMessage("\n")
            i = Add(i, 1)
        }
        PrintMessage("While with continue (skip 2):")
        PrintMessage("\n")
        i = 0
        WhileLoop LessThan(i, 5) {
            i = Add(i, 1)
            IfCondition EqualTo(i, 2) ThenBlock: {
                ContinueLoop
            }
            t4 = AIMacro.Str(i)
            t5 = String.Concat("  i = ", t4)
            AIMacro.SmartPrint(t5)
            PrintMessage("\n")
        }
    }
}

Function.test_for_loop {
    Body: {
        PrintMessage("=== FOR LOOP ===")
        PrintMessage("\n")
        PrintMessage("for i in range(5):")
        PrintMessage("\n")
        lc0 = 0
        ls0 = 5
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            t1 = AIMacro.Str(i)
            t2 = String.Concat("  i = ", t1)
            AIMacro.SmartPrint(t2)
            PrintMessage("\n")
        }
        PrintMessage("for i in range(2, 6):")
        PrintMessage("\n")
        lc3 = 2
        ls3 = 6
        lt3 = 1
        WhileLoop LessThan(lc3, ls3) {
            i = lc3
            lc3 = Add(lc3, lt3)
            t4 = AIMacro.Str(i)
            t5 = String.Concat("  i = ", t4)
            AIMacro.SmartPrint(t5)
            PrintMessage("\n")
        }
        PrintMessage("for i in range(0, 10, 2):")
        PrintMessage("\n")
        lc6 = 0
        ls6 = 10
        lt6 = 2
        WhileLoop LessThan(lc6, ls6) {
            i = lc6
            lc6 = Add(lc6, lt6)
            t7 = AIMacro.Str(i)
            t8 = String.Concat("  i = ", t7)
            AIMacro.SmartPrint(t8)
            PrintMessage("\n")
        }
        PrintMessage("For with break at 3:")
        PrintMessage("\n")
        lc9 = 0
        ls9 = 10
        lt9 = 1
        WhileLoop LessThan(lc9, ls9) {
            i = lc9
            lc9 = Add(lc9, lt9)
            IfCondition EqualTo(i, 3) ThenBlock: {
                BreakLoop
            }
            t10 = AIMacro.Str(i)
            t11 = String.Concat("  i = ", t10)
            AIMacro.SmartPrint(t11)
            PrintMessage("\n")
        }
        PrintMessage("For with continue (skip 2):")
        PrintMessage("\n")
        lc12 = 0
        ls12 = 5
        lt12 = 1
        WhileLoop LessThan(lc12, ls12) {
            i = lc12
            lc12 = Add(lc12, lt12)
            IfCondition EqualTo(i, 2) ThenBlock: {
                ContinueLoop
            }
            t13 = AIMacro.Str(i)
            t14 = String.Concat("  i = ", t13)
            AIMacro.SmartPrint(t14)
            PrintMessage("\n")
        }
    }
}

Function.simple_func {
    Body: {
        PrintMessage("Simple function called")
        PrintMessage("\n")
    }
}

Function.func_with_args {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        t0 = AIMacro.Str(p_a)
        t1 = String.Concat("Args: ", t0)
        t2 = String.Concat(t1, ", ")
        t3 = AIMacro.Str(p_b)
        t4 = String.Concat(t2, t3)
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
    }
}

Function.func_with_return {
    Input: p_x: Integer
    Body: {
        t0 = Multiply(p_x, 2)
        ReturnValue(t0)
    }
}

Function.func_with_early_return {
    Input: p_x: Integer
    Body: {
        IfCondition LessThan(p_x, 0) ThenBlock: {
            ReturnValue(Subtract(0, 1))
        }
        IfCondition EqualTo(p_x, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.recursive_factorial {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 1) ThenBlock: {
            ReturnValue(1)
        }
        t0 = Subtract(p_n, 1)
        t1 = recursive_factorial(t0)
        t2 = Multiply(p_n, t1)
        ReturnValue(t2)
    }
}

Function.recursive_fib {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 1) ThenBlock: {
            ReturnValue(p_n)
        }
        t0 = Subtract(p_n, 1)
        t1 = recursive_fib(t0)
        t2 = Subtract(p_n, 2)
        t3 = recursive_fib(t2)
        t4 = Add(t1, t3)
        ReturnValue(t4)
    }
}

Function.test_functions {
    Body: {
        PrintMessage("=== FUNCTIONS ===")
        PrintMessage("\n")
        simple_func()
        func_with_args(10, 20)
        t0 = func_with_return(5)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("func_with_return(5) = ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = Subtract(0, 1)
        t4 = func_with_early_return(t3)
        t5 = AIMacro.Str(t4)
        t6 = String.Concat("early_return(-1) = ", t5)
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        t7 = func_with_early_return(0)
        t8 = AIMacro.Str(t7)
        t9 = String.Concat("early_return(0) = ", t8)
        AIMacro.SmartPrint(t9)
        PrintMessage("\n")
        t10 = func_with_early_return(1)
        t11 = AIMacro.Str(t10)
        t12 = String.Concat("early_return(1) = ", t11)
        AIMacro.SmartPrint(t12)
        PrintMessage("\n")
        t13 = recursive_factorial(5)
        t14 = AIMacro.Str(t13)
        t15 = String.Concat("factorial(5) = ", t14)
        AIMacro.SmartPrint(t15)
        PrintMessage("\n")
        t16 = recursive_fib(10)
        t17 = AIMacro.Str(t16)
        t18 = String.Concat("fib(10) = ", t17)
        AIMacro.SmartPrint(t18)
        PrintMessage("\n")
    }
}

Function.test_list_basics {
    Body: {
        PrintMessage("=== LIST BASICS ===")
        PrintMessage("\n")
        empty = Array.Create(0)
        t0 = AIMacro.SmartLen(empty)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("Empty list len: ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        nums = Array.Create(5)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        Array.Push(nums, 3)
        Array.Push(nums, 4)
        Array.Push(nums, 5)
        t3 = AIMacro.SmartLen(nums)
        t4 = AIMacro.Str(t3)
        t5 = String.Concat("List len: ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = DictGen_SmartGet(nums, 0)
        t7 = AIMacro.Str(t6)
        t8 = String.Concat("First: ", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        t9 = DictGen_SmartGet(nums, 4)
        t10 = AIMacro.Str(t9)
        t11 = String.Concat("Last: ", t10)
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        DictGen_SmartSet(nums, 0, 100)
        t12 = DictGen_SmartGet(nums, 0)
        t13 = AIMacro.Str(t12)
        t14 = String.Concat("After nums[0]=100: ", t13)
        AIMacro.SmartPrint(t14)
        PrintMessage("\n")
    }
}

Function.test_list_append {
    Body: {
        PrintMessage("=== LIST APPEND ===")
        PrintMessage("\n")
        arr = Array.Create(0)
        AIMacro.SmartPush(arr, 10)
        AIMacro.SmartPush(arr, 20)
        AIMacro.SmartPush(arr, 30)
        t0 = AIMacro.SmartLen(arr)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("After 3 appends, len: ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = DictGen_SmartGet(arr, 0)
        t4 = AIMacro.Str(t3)
        t5 = String.Concat("Values: ", t4)
        t6 = String.Concat(t5, ", ")
        t7 = DictGen_SmartGet(arr, 1)
        t8 = AIMacro.Str(t7)
        t9 = String.Concat(t6, t8)
        t10 = String.Concat(t9, ", ")
        t11 = DictGen_SmartGet(arr, 2)
        t12 = AIMacro.Str(t11)
        t13 = String.Concat(t10, t12)
        AIMacro.SmartPrint(t13)
        PrintMessage("\n")
    }
}

Function.test_list_iteration {
    Body: {
        PrintMessage("=== LIST ITERATION ===")
        PrintMessage("\n")
        nums = Array.Create(5)
        Array.Push(nums, 10)
        Array.Push(nums, 20)
        Array.Push(nums, 30)
        Array.Push(nums, 40)
        Array.Push(nums, 50)
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = AIMacro.SmartLen(nums)
            IfCondition Not(LessThan(i, t0)) ThenBlock: {
                BreakLoop
            }
            t1 = AIMacro.Str(i)
            t2 = String.Concat("nums[", t1)
            t3 = String.Concat(t2, "] = ")
            t4 = DictGen_SmartGet(nums, i)
            t5 = AIMacro.Str(t4)
            t6 = String.Concat(t3, t5)
            AIMacro.SmartPrint(t6)
            PrintMessage("\n")
            i = Add(i, 1)
        }
    }
}

Function.test_list_nested_access {
    Body: {
        PrintMessage("=== NESTED LIST ACCESS ===")
        PrintMessage("\n")
        arr = Array.Create(5)
        Array.Push(arr, 1)
        Array.Push(arr, 2)
        Array.Push(arr, 3)
        Array.Push(arr, 4)
        Array.Push(arr, 5)
        i = 2
        t0 = DictGen_SmartGet(arr, i)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("arr[i] where i=2: ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = Add(i, 1)
        t4 = DictGen_SmartGet(arr, t3)
        t5 = AIMacro.Str(t4)
        t6 = String.Concat("arr[i+1]: ", t5)
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        t7 = AIMacro.SmartLen(arr)
        t8 = Subtract(t7, 1)
        t9 = DictGen_SmartGet(arr, t8)
        t10 = AIMacro.Str(t9)
        t11 = String.Concat("arr[len(arr)-1]: ", t10)
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
    }
}

Function.test_string_concat {
    Body: {
        PrintMessage("=== STRING CONCATENATION ===")
        PrintMessage("\n")
        a = "Hello"
        b = "World"
        t0 = String.Concat(a, " ")
        t1 = String.Concat(t0, b)
        t2 = String.Concat(t1, "!")
        c = t2
        AIMacro.SmartPrint(c)
        PrintMessage("\n")
        t3 = String.Concat("Part1", "-")
        t4 = String.Concat(t3, "Part2")
        t5 = String.Concat(t4, "-")
        t6 = String.Concat(t5, "Part3")
        result = t6
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
    }
}

Function.test_string_repeat {
    Body: {
        PrintMessage("=== STRING REPEAT ===")
        PrintMessage("\n")
        s = "ab"
                t0 = String.Repeat(s, 5)
        t1 = String.Concat("'ab' * 5 = ", t0)
AIMacro.SmartPrint(t1)
        PrintMessage("\n")
                t2 = String.Repeat("=", 20)
        t3 = String.Concat("'=' * 20 = ", t2)
AIMacro.SmartPrint(t3)
        PrintMessage("\n")
    }
}

Function.test_string_len {
    Body: {
        PrintMessage("=== STRING LENGTH ===")
        PrintMessage("\n")
        s = "hello"
        t0 = DictGen_SmartLen(s)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("len('hello') = ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = DictGen_SmartLen("")
        t4 = AIMacro.Str(t3)
        t5 = String.Concat("len('') = ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = DictGen_SmartLen("a b c")
        t7 = AIMacro.Str(t6)
        t8 = String.Concat("len('a b c') = ", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
    }
}

Function.test_str_conversion {
    Body: {
        PrintMessage("=== STR() CONVERSION ===")
        PrintMessage("\n")
        n = 42
        t0 = AIMacro.Str(n)
        t1 = String.Concat("str(42) = '", t0)
        t2 = String.Concat(t1, "'")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = Subtract(0, 100)
        t4 = AIMacro.Str(t3)
        t5 = String.Concat("str(-100) = '", t4)
        t6 = String.Concat(t5, "'")
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        t7 = AIMacro.Str(0)
        t8 = String.Concat("str(0) = '", t7)
        t9 = String.Concat(t8, "'")
        AIMacro.SmartPrint(t9)
        PrintMessage("\n")
    }
}

Function.test_deeply_nested_calls {
    Body: {
        PrintMessage("=== DEEPLY NESTED CALLS ===")
        PrintMessage("\n")
        t0 = mul2(1, 2)
        t1 = mul2(3, 4)
        t2 = mul2(5, 6)
        t3 = add3(t0, t1, t2)
        result = t3
        t4 = AIMacro.Str(result)
        t5 = String.Concat("add3(mul2(1,2), mul2(3,4), mul2(5,6)) = ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
    }
}

Function.add3 {
    Input: p_a: Integer
    Input: p_b: Integer
    Input: p_c: Integer
    Body: {
        t0 = Add(p_a, p_b)
        t1 = Add(t0, p_c)
        ReturnValue(t1)
    }
}

Function.mul2 {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        t0 = Multiply(p_a, p_b)
        ReturnValue(t0)
    }
}

Function.test_complex_conditions {
    Body: {
        PrintMessage("=== COMPLEX CONDITIONS ===")
        PrintMessage("\n")
        arr = Array.Create(5)
        Array.Push(arr, 10)
        Array.Push(arr, 20)
        Array.Push(arr, 30)
        Array.Push(arr, 40)
        Array.Push(arr, 50)
        t0 = AIMacro.SmartLen(arr)
        IfCondition GreaterThan(t0, 3) ThenBlock: {
            PrintMessage("Array has more than 3 elements")
            PrintMessage("\n")
        }
        t1 = DictGen_SmartGet(arr, 0)
        t2 = AIMacro.SmartLen(arr)
        t3 = Subtract(t2, 1)
        t4 = DictGen_SmartGet(arr, t3)
        IfCondition LessThan(t1, t4) ThenBlock: {
            PrintMessage("First element less than last")
            PrintMessage("\n")
        }
        t5 = AIMacro.SmartLen(arr)
        t6 = DictGen_SmartGet(arr, 0)
        IfCondition And(GreaterThan(t5, 0), EqualTo(t6, 10)) ThenBlock: {
            PrintMessage("Non-empty and first is 10")
            PrintMessage("\n")
        }
    }
}

Function.test_return_complex_expr {
    Body: {
        PrintMessage("=== RETURN COMPLEX EXPRESSIONS ===")
        PrintMessage("\n")
        arr = Array.Create(3)
        Array.Push(arr, 5)
        Array.Push(arr, 10)
        Array.Push(arr, 15)
        t0 = get_sum_of_first_and_last(arr)
        result = t0
        t1 = AIMacro.Str(result)
        t2 = String.Concat("sum of first and last: ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
    }
}

Function.get_sum_of_first_and_last {
    Input: p_arr: Integer
    Body: {
        t0 = DictGen_SmartGet(p_arr, 0)
        t1 = DictGen_SmartLen(p_arr)
        t2 = Subtract(t1, 1)
        t3 = DictGen_SmartGet(p_arr, t2)
        t4 = Add(t0, t3)
        ReturnValue(t4)
    }
}

Function.test_nested_loops {
    Body: {
        PrintMessage("=== NESTED LOOPS ===")
        PrintMessage("\n")
        lc0 = 0
        ls0 = 3
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            lc1 = 0
            ls1 = 3
            lt1 = 1
            WhileLoop LessThan(lc1, ls1) {
                j = lc1
                lc1 = Add(lc1, lt1)
                t2 = AIMacro.Str(i)
                t3 = String.Concat("(", t2)
                t4 = String.Concat(t3, ",")
                t5 = AIMacro.Str(j)
                t6 = String.Concat(t4, t5)
                t7 = String.Concat(t6, ")")
                AIMacro.SmartPrint(t7)
                PrintMessage("\n")
            }
        }
    }
}

Function.test_loop_with_function_calls {
    Body: {
        PrintMessage("=== LOOP WITH FUNCTION CALLS ===")
        PrintMessage("\n")
        arr = Array.Create(5)
        Array.Push(arr, 1)
        Array.Push(arr, 2)
        Array.Push(arr, 3)
        Array.Push(arr, 4)
        Array.Push(arr, 5)
        total = 0
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = AIMacro.SmartLen(arr)
            IfCondition Not(LessThan(i, t0)) ThenBlock: {
                BreakLoop
            }
            t1 = DictGen_SmartGet(arr, i)
            total = Add(total, t1)
            i = Add(i, 1)
        }
        t2 = AIMacro.Str(total)
        t3 = String.Concat("Sum: ", t2)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
    }
}

