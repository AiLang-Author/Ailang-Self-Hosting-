Function.test_param_individual_values {
    Body: {
        PrintMessage("=== Parameter Individual Values ===")
        PrintMessage("\n")
        PrintMessage("Testing 8 params individually:")
        PrintMessage("\n")
                t0 = Array.Create(8)
        Array.Push(t0, 1)
        Array.Push(t0, 2)
        Array.Push(t0, 3)
        Array.Push(t0, 4)
        Array.Push(t0, 5)
        Array.Push(t0, 6)
        Array.Push(t0, 7)
        Array.Push(t0, 8)
check_eight(t0)
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.check_eight {
    Input: p__args: Address
    Body: {
        p_a = DictGen_SmartGet(p__args, 0)
        p_b = DictGen_SmartGet(p__args, 1)
        p_c = DictGen_SmartGet(p__args, 2)
        p_d = DictGen_SmartGet(p__args, 3)
        p_e = DictGen_SmartGet(p__args, 4)
        p_f = DictGen_SmartGet(p__args, 5)
        p_g = DictGen_SmartGet(p__args, 6)
        p_h = DictGen_SmartGet(p__args, 7)
        t0 = AIMacro.Str(p_a)
        t1 = String.Concat("a = ", t0)
        t2 = String.Concat(t1, " (expect 1)")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = AIMacro.Str(p_b)
        t4 = String.Concat("b = ", t3)
        t5 = String.Concat(t4, " (expect 2)")
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = AIMacro.Str(p_c)
        t7 = String.Concat("c = ", t6)
        t8 = String.Concat(t7, " (expect 3)")
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        t9 = AIMacro.Str(p_d)
        t10 = String.Concat("d = ", t9)
        t11 = String.Concat(t10, " (expect 4)")
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        t12 = AIMacro.Str(p_e)
        t13 = String.Concat("e = ", t12)
        t14 = String.Concat(t13, " (expect 5)")
        AIMacro.SmartPrint(t14)
        PrintMessage("\n")
        t15 = AIMacro.Str(p_f)
        t16 = String.Concat("f = ", t15)
        t17 = String.Concat(t16, " (expect 6)")
        AIMacro.SmartPrint(t17)
        PrintMessage("\n")
        t18 = AIMacro.Str(p_g)
        t19 = String.Concat("g = ", t18)
        t20 = String.Concat(t19, " (expect 7)")
        AIMacro.SmartPrint(t20)
        PrintMessage("\n")
        t21 = AIMacro.Str(p_h)
        t22 = String.Concat("h = ", t21)
        t23 = String.Concat(t22, " (expect 8)")
        AIMacro.SmartPrint(t23)
        PrintMessage("\n")
        sum_val = Add(Add(Add(Add(Add(Add(Add(p_a, p_b), p_c), p_d), p_e), p_f), p_g), p_h)
        t24 = AIMacro.Str(sum_val)
        t25 = String.Concat("Sum = ", t24)
        t26 = String.Concat(t25, " (expect 36)")
        AIMacro.SmartPrint(t26)
        PrintMessage("\n")
    }
}

Function.test_list_mutation {
    Body: {
        PrintMessage("=== BUG 3: List Mutation in Function ===")
        PrintMessage("\n")
        arr = Array.Create(3)
        Array.Push(arr, 10)
        Array.Push(arr, 20)
        Array.Push(arr, 30)
        PrintMessage("Created arr = [10, 20, 30]")
        PrintMessage("\n")
        t0 = DictGen_SmartGet(arr, 0)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("arr[0] before: ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        double_element(arr, 0)
        PrintMessage("Called double_element(arr, 0)")
        PrintMessage("\n")
        t3 = DictGen_SmartGet(arr, 0)
        t4 = AIMacro.Str(t3)
        t5 = String.Concat("arr[0] after: ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        PrintMessage("Expected: 20")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        arr2 = Array.Create(3)
        Array.Push(arr2, 5)
        Array.Push(arr2, 10)
        Array.Push(arr2, 15)
        PrintMessage("Created arr2 = [5, 10, 15]")
        PrintMessage("\n")
        t6 = DictGen_SmartGet(arr2, 0)
        t7 = DictGen_SmartGet(arr2, 1)
        t8 = Add(t6, t7)
        t9 = DictGen_SmartGet(arr2, 2)
        t10 = Add(t8, t9)
        sum_before = t10
        t11 = AIMacro.Str(sum_before)
        t12 = String.Concat("Sum before: ", t11)
        AIMacro.SmartPrint(t12)
        PrintMessage("\n")
        triple_first(arr2)
        PrintMessage("Called triple_first(arr2)")
        PrintMessage("\n")
        t13 = DictGen_SmartGet(arr2, 0)
        t14 = DictGen_SmartGet(arr2, 1)
        t15 = Add(t13, t14)
        t16 = DictGen_SmartGet(arr2, 2)
        t17 = Add(t15, t16)
        sum_after = t17
        t18 = AIMacro.Str(sum_after)
        t19 = String.Concat("Sum after: ", t18)
        AIMacro.SmartPrint(t19)
        PrintMessage("\n")
        t20 = DictGen_SmartGet(arr2, 0)
        t21 = AIMacro.Str(t20)
        t22 = String.Concat("arr2[0]: ", t21)
        AIMacro.SmartPrint(t22)
        PrintMessage("\n")
        PrintMessage("Expected arr2[0]: 15")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.double_element {
    Input: p_arr: Integer
    Input: p_idx: Integer
    Body: {
        t0 = DictGen_SmartGet(p_arr, p_idx)
        val = t0
        DictGen_SmartSet(p_arr, p_idx, Multiply(val, 2))
    }
}

Function.triple_first {
    Input: p_arr: Integer
    Body: {
        t0 = DictGen_SmartGet(p_arr, 0)
        t1 = Multiply(t0, 3)
        DictGen_SmartSet(p_arr, 0, t1)
    }
}

Function.test_string_quotes {
    Body: {
        PrintMessage("=== BUG 4: String Quote Display ===")
        PrintMessage("\n")
        s1 = "hello"
                t0 = String.Concat("String: [", s1)
        t1 = String.Concat(t0, "]")
AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        s2 = "  hello  "
                t2 = String.Concat("With spaces: [", s2)
        t3 = String.Concat(t2, "]")
AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        s3 = String.Strip(s2)
                t4 = String.Concat("After strip: [", s3)
        t5 = String.Concat(t4, "]")
AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        PrintMessage("Testing quote char in string:")
        PrintMessage("\n")
        s4 = "test"
        t6 = String.Concat("Value is: '", s4)
        t7 = String.Concat(t6, "'")
        msg = t7
        AIMacro.SmartPrint(msg)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_list_operations_verbose {
    Body: {
        PrintMessage("=== Verbose List Operations ===")
        PrintMessage("\n")
        arr = Array.Create(0)
        t0 = AIMacro.SmartLen(arr)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("Empty list created, len=", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        i = 0
        WhileLoop LessThan(i, 5) {
            AIMacro.SmartPush(arr, Multiply(i, 10))
            t3 = Multiply(i, 10)
            t4 = AIMacro.Str(t3)
            t5 = String.Concat("Appended ", t4)
            t6 = String.Concat(t5, ", len now=")
            t7 = AIMacro.SmartLen(arr)
            t8 = AIMacro.Str(t7)
            t9 = String.Concat(t6, t8)
            AIMacro.SmartPrint(t9)
            PrintMessage("\n")
            i = Add(i, 1)
        }
        PrintMessage("Reading all elements:")
        PrintMessage("\n")
        j = 0
        WhileLoop LessThan(j, 5) {
            t10 = DictGen_SmartGet(arr, j)
            val = t10
            t11 = AIMacro.Str(j)
            t12 = String.Concat("arr[", t11)
            t13 = String.Concat(t12, "] = ")
            t14 = AIMacro.Str(val)
            t15 = String.Concat(t13, t14)
            AIMacro.SmartPrint(t15)
            PrintMessage("\n")
            j = Add(j, 1)
        }
        PrintMessage("Modifying elements:")
        PrintMessage("\n")
        DictGen_SmartSet(arr, 0, 999)
        DictGen_SmartSet(arr, 2, 888)
        DictGen_SmartSet(arr, 4, 777)
        PrintMessage("After modifications:")
        PrintMessage("\n")
        k = 0
        WhileLoop LessThan(k, 5) {
            t16 = DictGen_SmartGet(arr, k)
            val = t16
            t17 = AIMacro.Str(k)
            t18 = String.Concat("arr[", t17)
            t19 = String.Concat(t18, "] = ")
            t20 = AIMacro.Str(val)
            t21 = String.Concat(t19, t20)
            AIMacro.SmartPrint(t21)
            PrintMessage("\n")
            k = Add(k, 1)
        }
        PrintMessage("")
        PrintMessage("\n")
    }
}

SubRoutine.Main {
                t0 = String.Repeat("=", 60)
AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("AIMACRO BUG ISOLATION TEST")
        PrintMessage("\n")
                t1 = String.Repeat("=", 60)
AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        test_list_assign_simple()
        test_list_append_then_assign()
        test_list_literal_then_assign()
        test_param_count()
        test_param_individual_values()
        test_list_mutation()
        test_string_quotes()
        test_list_operations_verbose()
                t2 = String.Repeat("=", 60)
AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        PrintMessage("BUG ISOLATION COMPLETE")
        PrintMessage("\n")
                t3 = String.Repeat("=", 60)
AIMacro.SmartPrint(t3)
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
