LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.test_list_assign_simple {
    Body: {
        PrintMessage("=== BUG 1: List Index Assignment ===")
        PrintMessage("\n")
        arr = Array.Create(3)
        Array.Push(arr, 0)
        Array.Push(arr, 0)
        Array.Push(arr, 0)
        PrintMessage("Created arr = [0, 0, 0]")
        PrintMessage("\n")
        t0 = DictGen_SmartGet(arr, 0)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("Initial arr[0]: ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = DictGen_SmartGet(arr, 1)
        t4 = AIMacro.Str(t3)
        t5 = String.Concat("Initial arr[1]: ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = DictGen_SmartGet(arr, 2)
        t7 = AIMacro.Str(t6)
        t8 = String.Concat("Initial arr[2]: ", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        DictGen_SmartSet(arr, 0, 100)
        PrintMessage("After arr[0] = 100")
        PrintMessage("\n")
        t9 = DictGen_SmartGet(arr, 0)
        t10 = AIMacro.Str(t9)
        t11 = String.Concat("arr[0]: ", t10)
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        DictGen_SmartSet(arr, 1, 200)
        PrintMessage("After arr[1] = 200")
        PrintMessage("\n")
        t12 = DictGen_SmartGet(arr, 1)
        t13 = AIMacro.Str(t12)
        t14 = String.Concat("arr[1]: ", t13)
        AIMacro.SmartPrint(t14)
        PrintMessage("\n")
        DictGen_SmartSet(arr, 2, 300)
        PrintMessage("After arr[2] = 300")
        PrintMessage("\n")
        t15 = DictGen_SmartGet(arr, 2)
        t16 = AIMacro.Str(t15)
        t17 = String.Concat("arr[2]: ", t16)
        AIMacro.SmartPrint(t17)
        PrintMessage("\n")
        t18 = DictGen_SmartGet(arr, 0)
        t19 = DictGen_SmartGet(arr, 1)
        t20 = Add(t18, t19)
        t21 = DictGen_SmartGet(arr, 2)
        t22 = Add(t20, t21)
        total = t22
        t23 = AIMacro.Str(total)
        t24 = String.Concat("Sum (expect 600): ", t23)
        AIMacro.SmartPrint(t24)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_list_append_then_assign {
    Body: {
        PrintMessage("=== List: Append then Assign ===")
        PrintMessage("\n")
        arr = Array.Create(0)
        PrintMessage("Created empty arr")
        PrintMessage("\n")
        AIMacro.SmartPush(arr, 10)
        AIMacro.SmartPush(arr, 20)
        AIMacro.SmartPush(arr, 30)
        AIMacro.SmartPush(arr, 40)
        AIMacro.SmartPush(arr, 50)
        PrintMessage("Appended 10,20,30,40,50")
        PrintMessage("\n")
        t0 = AIMacro.SmartLen(arr)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("Length: ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        PrintMessage("Before modification:")
        PrintMessage("\n")
        t3 = DictGen_SmartGet(arr, 0)
        t4 = AIMacro.Str(t3)
        t5 = String.Concat("arr[0]: ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = DictGen_SmartGet(arr, 4)
        t7 = AIMacro.Str(t6)
        t8 = String.Concat("arr[4]: ", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        DictGen_SmartSet(arr, 0, 100)
        DictGen_SmartSet(arr, 4, 400)
        PrintMessage("After arr[0]=100, arr[4]=400:")
        PrintMessage("\n")
        t9 = DictGen_SmartGet(arr, 0)
        t10 = AIMacro.Str(t9)
        t11 = String.Concat("arr[0]: ", t10)
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        t12 = DictGen_SmartGet(arr, 4)
        t13 = AIMacro.Str(t12)
        t14 = String.Concat("arr[4]: ", t13)
        AIMacro.SmartPrint(t14)
        PrintMessage("\n")
        t15 = DictGen_SmartGet(arr, 0)
        t16 = DictGen_SmartGet(arr, 4)
        t17 = Add(t15, t16)
        total = t17
        t18 = AIMacro.Str(total)
        t19 = String.Concat("Sum (expect 500): ", t18)
        AIMacro.SmartPrint(t19)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_list_literal_then_assign {
    Body: {
        PrintMessage("=== List: Literal then Assign ===")
        PrintMessage("\n")
        arr = Array.Create(5)
        Array.Push(arr, 1)
        Array.Push(arr, 2)
        Array.Push(arr, 3)
        Array.Push(arr, 4)
        Array.Push(arr, 5)
        PrintMessage("Created arr = [1,2,3,4,5]")
        PrintMessage("\n")
        PrintMessage("Before modification:")
        PrintMessage("\n")
        t0 = DictGen_SmartGet(arr, 0)
        t1 = AIMacro.Str(t0)
        t2 = String.Concat("arr[0]: ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = DictGen_SmartGet(arr, 4)
        t4 = AIMacro.Str(t3)
        t5 = String.Concat("arr[4]: ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        DictGen_SmartSet(arr, 0, 100)
        DictGen_SmartSet(arr, 4, 400)
        PrintMessage("After arr[0]=100, arr[4]=400:")
        PrintMessage("\n")
        t6 = DictGen_SmartGet(arr, 0)
        t7 = AIMacro.Str(t6)
        t8 = String.Concat("arr[0]: ", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        t9 = DictGen_SmartGet(arr, 4)
        t10 = AIMacro.Str(t9)
        t11 = String.Concat("arr[4]: ", t10)
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        t12 = DictGen_SmartGet(arr, 0)
        t13 = DictGen_SmartGet(arr, 4)
        t14 = Add(t12, t13)
        total = t14
        t15 = AIMacro.Str(total)
        t16 = String.Concat("Sum (expect 500): ", t15)
        AIMacro.SmartPrint(t16)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_param_count {
    Body: {
        PrintMessage("=== BUG 2: Parameter Count ===")
        PrintMessage("\n")
        t0 = one_param(10)
        r1 = t0
        t1 = AIMacro.Str(r1)
        t2 = String.Concat("one_param(10): ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = two_params(10, 20)
        r2 = t3
        t4 = AIMacro.Str(r2)
        t5 = String.Concat("two_params(10,20): ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = three_params(10, 20, 30)
        r3 = t6
        t7 = AIMacro.Str(r3)
        t8 = String.Concat("three_params(10,20,30): ", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        t9 = four_params(10, 20, 30, 40)
        r4 = t9
        t10 = AIMacro.Str(r4)
        t11 = String.Concat("four_params(10,20,30,40): ", t10)
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        t12 = five_params(10, 20, 30, 40, 50)
        r5 = t12
        t13 = AIMacro.Str(r5)
        t14 = String.Concat("five_params(10,20,30,40,50): ", t13)
        AIMacro.SmartPrint(t14)
        PrintMessage("\n")
        t15 = six_params(10, 20, 30, 40, 50, 60)
        r6 = t15
        t16 = AIMacro.Str(r6)
        t17 = String.Concat("six_params(10,20,30,40,50,60): ", t16)
        AIMacro.SmartPrint(t17)
        PrintMessage("\n")
        t18 = Array.Create(7)
        Array.Push(t18, 10)
        Array.Push(t18, 20)
        Array.Push(t18, 30)
        Array.Push(t18, 40)
        Array.Push(t18, 50)
        Array.Push(t18, 60)
        Array.Push(t18, 70)
        r7 = seven_params(t18)
        t19 = AIMacro.Str(r7)
        t20 = String.Concat("seven_params(10-70): ", t19)
        AIMacro.SmartPrint(t20)
        PrintMessage("\n")
        t21 = Array.Create(8)
        Array.Push(t21, 10)
        Array.Push(t21, 20)
        Array.Push(t21, 30)
        Array.Push(t21, 40)
        Array.Push(t21, 50)
        Array.Push(t21, 60)
        Array.Push(t21, 70)
        Array.Push(t21, 80)
        r8 = eight_params(t21)
        t22 = AIMacro.Str(r8)
        t23 = String.Concat("eight_params(10-80): ", t22)
        AIMacro.SmartPrint(t23)
        PrintMessage("\n")
        PrintMessage("Expected: 360")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.one_param {
    Input: p_a: Integer
    Body: {
        ReturnValue(p_a)
    }
}

Function.two_params {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        t0 = Add(p_a, p_b)
        ReturnValue(t0)
    }
}

Function.three_params {
    Input: p_a: Integer
    Input: p_b: Integer
    Input: p_c: Integer
    Body: {
        t0 = Add(p_a, p_b)
        t1 = Add(t0, p_c)
        ReturnValue(t1)
    }
}

Function.four_params {
    Input: p_a: Integer
    Input: p_b: Integer
