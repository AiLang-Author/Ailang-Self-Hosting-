LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


SubRoutine.Main {
        arr = Array.Create(10)
        Array.Push(arr, 64)
        Array.Push(arr, 34)
        Array.Push(arr, 25)
        Array.Push(arr, 12)
        Array.Push(arr, 22)
        Array.Push(arr, 11)
        Array.Push(arr, 90)
        Array.Push(arr, 42)
        Array.Push(arr, 15)
        Array.Push(arr, 77)
        PrintMessage("Array dump:")
        PrintMessage("\n")
        lc0 = 0
        ls0 = 10
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            t1 = DictGen_SmartGet(arr, i)
            PrintMessage("arr[")
            PrintMessage(" ")
            AIMacro.SmartPrint(i)
            PrintMessage(" ")
            PrintMessage("] =")
            PrintMessage(" ")
            AIMacro.SmartPrint(t1)
            PrintMessage("\n")
        }
        PrintMessage("Finding max:")
        PrintMessage("\n")
        t2 = DictGen_SmartGet(arr, 0)
        max_val = t2
        PrintMessage("Initial max:")
        PrintMessage(" ")
        AIMacro.SmartPrint(max_val)
        PrintMessage("\n")
        lc3 = 1
        ls3 = 10
        lt3 = 1
        WhileLoop LessThan(lc3, ls3) {
            i = lc3
            lc3 = Add(lc3, lt3)
            t4 = DictGen_SmartGet(arr, i)
            PrintMessage("Checking index")
            PrintMessage(" ")
            AIMacro.SmartPrint(i)
            PrintMessage(" ")
            PrintMessage("value")
            PrintMessage(" ")
            AIMacro.SmartPrint(t4)
            PrintMessage("\n")
            t5 = DictGen_SmartGet(arr, i)
            IfCondition GreaterThan(t5, max_val) ThenBlock: {
                t6 = DictGen_SmartGet(arr, i)
                max_val = t6
                PrintMessage("New max:")
                PrintMessage(" ")
                AIMacro.SmartPrint(max_val)
                PrintMessage("\n")
            }
        }
        PrintMessage("Final max:")
        PrintMessage(" ")
        AIMacro.SmartPrint(max_val)
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
