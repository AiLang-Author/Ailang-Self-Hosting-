LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.factorial {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 1) ThenBlock: {
            ReturnValue(1)
        }
        t0 = Subtract(p_n, 1)
        t1 = factorial(t0)
        t2 = Multiply(p_n, t1)
        ReturnValue(t2)
    }
}

Function.fibonacci {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(p_n, 1) ThenBlock: {
            ReturnValue(1)
        }
        a = 0
        b = 1
        i = 2
        WhileLoop LessEqual(i, p_n) {
            temp = Add(a, b)
            a = b
            b = temp
            i = Add(i, 1)
        }
        ReturnValue(b)
    }
}

Function.is_prime {
    Input: p_n: Integer
    Body: {
        IfCondition LessThan(p_n, 2) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(p_n, 2) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Modulo(p_n, 2), 0) ThenBlock: {
            ReturnValue(0)
        }
        i = 3
        WhileLoop LessEqual(Multiply(i, i), p_n) {
            IfCondition EqualTo(Modulo(p_n, i), 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 2)
        }
        ReturnValue(1)
    }
}

Function.bubble_sort {
    Input: p_arr: Integer
    Input: p_size: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, Subtract(p_size, 1)) {
            j = 0
            WhileLoop LessThan(j, Subtract(Subtract(p_size, i), 1)) {
                t0 = DictGen_SmartGet(p_arr, j)
                t1 = DictGen_SmartGet(p_arr, Add(j, 1))
                IfCondition GreaterThan(t0, t1) ThenBlock: {
                    t2 = DictGen_SmartGet(p_arr, j)
                    temp = t2
                    t3 = Add(j, 1)
                    t4 = DictGen_SmartGet(p_arr, t3)
                    DictGen_SmartSet(p_arr, j, t4)
                    DictGen_SmartSet(p_arr, Add(j, 1), temp)
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
    }
}

Function.binary_search {
    Input: p_arr: Integer
    Input: p_size: Integer
    Input: p_target: Integer
    Body: {
        low = 0
        high = Subtract(p_size, 1)
        WhileLoop LessEqual(low, high) {
            mid = Divide(Add(low, high), 2)
            t0 = DictGen_SmartGet(p_arr, mid)
            IfCondition EqualTo(t0, p_target) ThenBlock: {
                ReturnValue(mid)
            }
            t1 = DictGen_SmartGet(p_arr, mid)
            IfCondition LessThan(t1, p_target) ThenBlock: {
                low = Add(mid, 1)
            } ElseBlock: {
                high = Subtract(mid, 1)
            }
        }
        ReturnValue(Subtract(0, 1))
    }
}

Function.gcd {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        WhileLoop EqualTo(1, 1) {
            IfCondition Not(NotEqual(p_b, 0)) ThenBlock: {
                BreakLoop
            }
            temp = p_b
            p_b = Modulo(p_a, p_b)
            p_a = temp
        }
        ReturnValue(p_a)
    }
}

Function.power {
    Input: p_base: Integer
    Input: p_exp: Integer
    Body: {
        IfCondition EqualTo(p_exp, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Modulo(p_exp, 2), 0) ThenBlock: {
            t0 = Divide(p_exp, 2)
            t1 = power(p_base, t0)
            half = t1
            t2 = Multiply(half, half)
            ReturnValue(t2)
        }
        t3 = Subtract(p_exp, 1)
        t4 = power(p_base, t3)
        t5 = Multiply(p_base, t4)
        ReturnValue(t5)
    }
}

Function.sum_array {
    Input: p_arr: Integer
    Input: p_size: Integer
    Body: {
        total = 0
        i = 0
        WhileLoop LessThan(i, p_size) {
            t0 = DictGen_SmartGet(p_arr, i)
            total = Add(total, t0)
            i = Add(i, 1)
        }
        ReturnValue(total)
    }
}

Function.find_max {
    Input: p_arr: Integer
    Input: p_size: Integer
    Body: {
        IfCondition EqualTo(p_size, 0) ThenBlock: {
            ReturnValue(0)
        }
        t0 = DictGen_SmartGet(p_arr, 0)
        max_val = t0
        i = 1
        WhileLoop LessThan(i, p_size) {
            t1 = DictGen_SmartGet(p_arr, i)
            IfCondition GreaterThan(t1, max_val) ThenBlock: {
                t2 = DictGen_SmartGet(p_arr, i)
                max_val = t2
            }
            i = Add(i, 1)
        }
        ReturnValue(max_val)
    }
}

Function.count_divisors {
    Input: p_n: Integer
    Body: {
        count = 0
        i = 1
        WhileLoop LessEqual(Multiply(i, i), p_n) {
            IfCondition EqualTo(Modulo(p_n, i), 0) ThenBlock: {
                count = Add(count, 1)
                IfCondition NotEqual(i, Divide(p_n, i)) ThenBlock: {
                    count = Add(count, 1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(count)
    }
}

SubRoutine.Main {
        PrintMessage("=== AIMacro Complex Test ===")
        PrintMessage("\n")
        PrintMessage("Factorial 5:")
        PrintMessage("\n")
        t0 = factorial(5)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("Fibonacci 10:")
        PrintMessage("\n")
        t1 = fibonacci(10)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("Primes up to 20:")
        PrintMessage("\n")
        n = 2
        WhileLoop LessEqual(n, 20) {
            t2 = is_prime(n)
            IfCondition EqualTo(t2, 1) ThenBlock: {
                AIMacro.SmartPrint(n)
                PrintMessage("\n")
            }
            n = Add(n, 1)
        }
        PrintMessage("GCD of 48 and 18:")
        PrintMessage("\n")
        t3 = gcd(48, 18)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        PrintMessage("2^10:")
        PrintMessage("\n")
        t4 = power(2, 10)
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        PrintMessage("Divisors of 36:")
        PrintMessage("\n")
        t5 = count_divisors(36)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        PrintMessage("Array test:")
        PrintMessage("\n")
        arr = Array.Create(7)
        Array.Push(arr, 64)
        Array.Push(arr, 34)
        Array.Push(arr, 25)
        Array.Push(arr, 12)
        Array.Push(arr, 22)
        Array.Push(arr, 11)
        Array.Push(arr, 90)
        PrintMessage("Before sort - max:")
        PrintMessage("\n")
        t6 = find_max(arr, 7)
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        PrintMessage("Sum:")
        PrintMessage("\n")
        t7 = sum_array(arr, 7)
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        bubble_sort(arr, 7)
        PrintMessage("After sort - first element:")
        PrintMessage("\n")
        t8 = DictGen_SmartGet(arr, 0)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        PrintMessage("Last element:")
        PrintMessage("\n")
        t9 = DictGen_SmartGet(arr, 6)
        AIMacro.SmartPrint(t9)
        PrintMessage("\n")
        t10 = binary_search(arr, 7, 25)
        pos = t10
        PrintMessage("Position of 25:")
        PrintMessage("\n")
        AIMacro.SmartPrint(pos)
        PrintMessage("\n")
        PrintMessage("=== Tests Complete ===")
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
