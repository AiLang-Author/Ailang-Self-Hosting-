LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.factorial {
    Input: p_n: Integer
    Body: {
        IfCondition AIMacro.SmartBool(AIMacro.NumLe(p_n, 1)) ThenBlock: {
            ReturnValue(1)
        }
        t0 = AIMacro.NumSub(p_n, 1)
        t1 = factorial(t0)
        t2 = AIMacro.NumMul(p_n, t1)
        ReturnValue(t2)
    }
}

Function.fib_recursive {
    Input: p_n: Integer
    Body: {
        IfCondition AIMacro.SmartBool(AIMacro.NumLe(p_n, 0)) ThenBlock: {
            ReturnValue(0)
        }
        t0 = AIMacro.NumEq(p_n, 1)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            ReturnValue(1)
        }
        t1 = AIMacro.NumSub(p_n, 1)
        t2 = fib_recursive(t1)
        t3 = AIMacro.NumSub(p_n, 2)
        t4 = fib_recursive(t3)
        t5 = AIMacro.NumAdd(t2, t4)
        ReturnValue(t5)
    }
}

Function.ackermann {
    Input: p_m: Integer
    Input: p_n: Integer
    Body: {
        t0 = AIMacro.NumEq(p_m, 0)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            t1 = AIMacro.NumAdd(p_n, 1)
            ReturnValue(t1)
        }
        t2 = AIMacro.NumEq(p_n, 0)
        IfCondition AIMacro.SmartBool(t2) ThenBlock: {
            t3 = AIMacro.NumSub(p_m, 1)
            t4 = ackermann(t3, 1)
            ReturnValue(t4)
        }
        t5 = AIMacro.NumSub(p_m, 1)
        t6 = AIMacro.NumSub(p_n, 1)
        t7 = ackermann(p_m, t6)
        t8 = ackermann(t5, t7)
        ReturnValue(t8)
    }
}

Function.fib_iterative {
    Input: p_n: Integer
    Body: {
        IfCondition AIMacro.SmartBool(AIMacro.NumLe(p_n, 0)) ThenBlock: {
            ReturnValue(0)
        }
        t0 = AIMacro.NumEq(p_n, 1)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            ReturnValue(1)
        }
        a = 0
        b = 1
        i = 2
        WhileLoop AIMacro.SmartBool(AIMacro.NumLe(i, p_n)) {
            temp = AIMacro.NumAdd(a, b)
            a = b
            b = temp
            i = AIMacro.NumAdd(i, 1)
        }
        ReturnValue(b)
    }
}

Function.is_prime {
    Input: p_n: Integer
    Body: {
        IfCondition AIMacro.SmartBool(AIMacro.NumLt(p_n, 2)) ThenBlock: {
            ReturnValue(0)
        }
        t0 = AIMacro.NumEq(p_n, 2)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            ReturnValue(1)
        }
        t1 = AIMacro.NumMod(p_n, 2)
        t2 = AIMacro.NumEq(t1, 0)
        IfCondition AIMacro.SmartBool(t2) ThenBlock: {
            ReturnValue(0)
        }
        i = 3
        WhileLoop AIMacro.SmartBool(AIMacro.NumLe(AIMacro.NumMul(i, i), p_n)) {
            t3 = AIMacro.NumMod(p_n, i)
            t4 = AIMacro.NumEq(t3, 0)
            IfCondition AIMacro.SmartBool(t4) ThenBlock: {
                ReturnValue(0)
            }
            i = AIMacro.NumAdd(i, 2)
        }
        ReturnValue(1)
    }
}

Function.count_primes {
    Input: p_limit: Integer
    Body: {
        count = 0
        n = 2
        WhileLoop AIMacro.SmartBool(AIMacro.NumLe(n, p_limit)) {
            t0 = is_prime(n)
            t1 = AIMacro.NumEq(t0, 1)
            IfCondition AIMacro.SmartBool(t1) ThenBlock: {
                count = AIMacro.NumAdd(count, 1)
            }
            n = AIMacro.NumAdd(n, 1)
        }
        ReturnValue(count)
    }
}

Function.gcd {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        WhileLoop EqualTo(1, 1) {
            t0 = AIMacro.NumNe(p_b, 0)
            IfCondition Not(AIMacro.SmartBool(t0)) ThenBlock: {
                BreakLoop
            }
            temp = p_b
            p_b = AIMacro.NumMod(p_a, p_b)
            p_a = temp
        }
        ReturnValue(p_a)
    }
}

Function.lcm {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        t0 = AIMacro.NumMul(p_a, p_b)
        t1 = gcd(p_a, p_b)
        t2 = AIMacro.FloorDiv(t0, t1)
        ReturnValue(t2)
    }
}

Function.create_test_array {
    Body: {
        arr = Array.Create(10)
        Array.Push(arr, 64)
        Array.Push(arr, 34)
        Array.Push(arr, 25)
        Array.Push(arr, 12)
        Array.Push(arr, 22)
        Array.Push(arr, 11)
        Array.Push(arr, 90)
        Array.Push(arr, 42)
        Array.Push(arr, 15)
        Array.Push(arr, 77)
        ReturnValue(arr)
    }
}

Function.array_sum {
    Input: p_arr: Integer
    Input: p_size: Integer
    Body: {
        total = 0
        i = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(i, p_size)) {
            t0 = DictGen_SmartGet(p_arr, i)
            total = AIMacro.NumAdd(total, t0)
            i = AIMacro.NumAdd(i, 1)
        }
        ReturnValue(total)
    }
}

Function.array_max {
    Input: p_arr: Integer
    Input: p_size: Integer
    Body: {
        t0 = AIMacro.NumEq(p_size, 0)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            ReturnValue(0)
        }
        t1 = DictGen_SmartGet(p_arr, 0)
        max_val = t1
        i = 1
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(i, p_size)) {
            t2 = DictGen_SmartGet(p_arr, i)
            t3 = AIMacro.NumGt(t2, max_val)
            IfCondition AIMacro.SmartBool(t3) ThenBlock: {
                t4 = DictGen_SmartGet(p_arr, i)
                max_val = t4
            }
            i = AIMacro.NumAdd(i, 1)
        }
        ReturnValue(max_val)
    }
}

Function.array_min {
    Input: p_arr: Integer
    Input: p_size: Integer
    Body: {
        t0 = AIMacro.NumEq(p_size, 0)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            ReturnValue(0)
        }
        t1 = DictGen_SmartGet(p_arr, 0)
        min_val = t1
        i = 1
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(i, p_size)) {
            t2 = DictGen_SmartGet(p_arr, i)
            t3 = AIMacro.NumLt(t2, min_val)
            IfCondition AIMacro.SmartBool(t3) ThenBlock: {
                t4 = DictGen_SmartGet(p_arr, i)
                min_val = t4
            }
            i = AIMacro.NumAdd(i, 1)
        }
        ReturnValue(min_val)
    }
}

Function.linear_search {
    Input: p_arr: Integer
    Input: p_size: Integer
    Input: p_target: Integer
    Body: {
        i = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(i, p_size)) {
            t0 = DictGen_SmartGet(p_arr, i)
            t1 = AIMacro.NumEq(t0, p_target)
            IfCondition AIMacro.SmartBool(t1) ThenBlock: {
                ReturnValue(i)
            }
            i = AIMacro.NumAdd(i, 1)
        }
        ReturnValue(AIMacro.NumNeg(1))
    }
}

Function.bubble_sort {
    Input: p_arr: Integer
    Input: p_size: Integer
    Body: {
        i = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(i, AIMacro.NumSub(p_size, 1))) {
            j = 0
            WhileLoop AIMacro.SmartBool(AIMacro.NumLt(j, AIMacro.NumSub(AIMacro.NumSub(p_size, i), 1))) {
                t0 = DictGen_SmartGet(p_arr, j)
                t1 = AIMacro.NumAdd(j, 1)
                t2 = DictGen_SmartGet(p_arr, t1)
                t3 = AIMacro.NumGt(t0, t2)
                IfCondition AIMacro.SmartBool(t3) ThenBlock: {
                    t4 = DictGen_SmartGet(p_arr, j)
                    temp = t4
                    t5 = AIMacro.NumAdd(j, 1)
                    t6 = DictGen_SmartGet(p_arr, t5)
                    DictGen_SmartSet(p_arr, j, t6)
                    DictGen_SmartSet(p_arr, AIMacro.NumAdd(j, 1), temp)
                }
                j = AIMacro.NumAdd(j, 1)
            }
            i = AIMacro.NumAdd(i, 1)
        }
    }
}

Function.selection_sort {
    Input: p_arr: Integer
    Input: p_size: Integer
    Body: {
        i = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(i, AIMacro.NumSub(p_size, 1))) {
            min_idx = i
            j = AIMacro.NumAdd(i, 1)
            WhileLoop AIMacro.SmartBool(AIMacro.NumLt(j, p_size)) {
                t0 = DictGen_SmartGet(p_arr, j)
                t1 = DictGen_SmartGet(p_arr, min_idx)
                t2 = AIMacro.NumLt(t0, t1)
                IfCondition AIMacro.SmartBool(t2) ThenBlock: {
                    min_idx = j
                }
                j = AIMacro.NumAdd(j, 1)
            }
            t3 = AIMacro.NumNe(min_idx, i)
            IfCondition AIMacro.SmartBool(t3) ThenBlock: {
                t4 = DictGen_SmartGet(p_arr, i)
                temp = t4
                t5 = DictGen_SmartGet(p_arr, min_idx)
                DictGen_SmartSet(p_arr, i, t5)
                DictGen_SmartSet(p_arr, min_idx, temp)
            }
            i = AIMacro.NumAdd(i, 1)
        }
    }
}

Function.insertion_sort {
    Input: p_arr: Integer
    Input: p_size: Integer
    Body: {
        i = 1
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(i, p_size)) {
            t0 = DictGen_SmartGet(p_arr, i)
            key = t0
            j = AIMacro.NumSub(i, 1)
            WhileLoop EqualTo(1, 1) {
                t1 = AIMacro.NumGe(j, 0)
                t2 = t1
                IfCondition AIMacro.SmartBool(t2) ThenBlock: {
                    t3 = DictGen_SmartGet(p_arr, j)
                    t4 = AIMacro.NumGt(t3, key)
                    t2 = t4
                }
                IfCondition Not(AIMacro.SmartBool(t2)) ThenBlock: {
                    BreakLoop
                }
                t5 = DictGen_SmartGet(p_arr, j)
                DictGen_SmartSet(p_arr, AIMacro.NumAdd(j, 1), t5)
                j = AIMacro.NumSub(j, 1)
            }
            DictGen_SmartSet(p_arr, AIMacro.NumAdd(j, 1), key)
            i = AIMacro.NumAdd(i, 1)
        }
    }
}

Function.binary_search {
    Input: p_arr: Integer
    Input: p_size: Integer
    Input: p_target: Integer
    Body: {
        low = 0
        high = AIMacro.NumSub(p_size, 1)
        WhileLoop AIMacro.SmartBool(AIMacro.NumLe(low, high)) {
            mid = AIMacro.FloorDiv(AIMacro.NumAdd(low, high), 2)
            t0 = DictGen_SmartGet(p_arr, mid)
            t1 = AIMacro.NumEq(t0, p_target)
            IfCondition AIMacro.SmartBool(t1) ThenBlock: {
                ReturnValue(mid)
            }
            t2 = DictGen_SmartGet(p_arr, mid)
            t3 = AIMacro.NumLt(t2, p_target)
            IfCondition AIMacro.SmartBool(t3) ThenBlock: {
                low = AIMacro.NumAdd(mid, 1)
            } ElseBlock: {
                high = AIMacro.NumSub(mid, 1)
            }
        }
        ReturnValue(AIMacro.NumNeg(1))
    }
}

Function.reverse_array {
    Input: p_arr: Integer
    Input: p_size: Integer
    Body: {
        left = 0
        right = AIMacro.NumSub(p_size, 1)
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(left, right)) {
            t0 = DictGen_SmartGet(p_arr, left)
            temp = t0
            t1 = DictGen_SmartGet(p_arr, right)
            DictGen_SmartSet(p_arr, left, t1)
            DictGen_SmartSet(p_arr, right, temp)
            left = AIMacro.NumAdd(left, 1)
            right = AIMacro.NumSub(right, 1)
        }
    }
}

Function.power {
    Input: p_base: Integer
    Input: p_exp: Integer
    Body: {
        t0 = AIMacro.NumEq(p_exp, 0)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            ReturnValue(1)
        }
        t1 = AIMacro.NumMod(p_exp, 2)
        t2 = AIMacro.NumEq(t1, 0)
        IfCondition AIMacro.SmartBool(t2) ThenBlock: {
            t3 = AIMacro.FloorDiv(p_exp, 2)
            t4 = power(p_base, t3)
            half = t4
            t5 = AIMacro.NumMul(half, half)
            ReturnValue(t5)
        }
        t6 = AIMacro.NumSub(p_exp, 1)
        t7 = power(p_base, t6)
        t8 = AIMacro.NumMul(p_base, t7)
        ReturnValue(t8)
    }
}

Function.integer_sqrt {
    Input: p_n: Integer
    Body: {
        IfCondition AIMacro.SmartBool(AIMacro.NumLt(p_n, 2)) ThenBlock: {
            ReturnValue(p_n)
        }
        x = p_n
        y = AIMacro.FloorDiv(AIMacro.NumAdd(x, 1), 2)
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(y, x)) {
            x = y
            y = AIMacro.FloorDiv(AIMacro.NumAdd(x, AIMacro.FloorDiv(p_n, x)), 2)
        }
        ReturnValue(x)
    }
}

Function.is_perfect_square {
    Input: p_n: Integer
    Body: {
        t0 = integer_sqrt(p_n)
        root = t0
        t1 = AIMacro.NumMul(root, root)
        t2 = AIMacro.NumEq(t1, p_n)
        ReturnValue(t2)
    }
}

Function.sum_digits {
    Input: p_n: Integer
    Body: {
        total = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumGt(p_n, 0)) {
            total = AIMacro.NumAdd(total, AIMacro.NumMod(p_n, 10))
            p_n = AIMacro.FloorDiv(p_n, 10)
        }
        ReturnValue(total)
    }
}

Function.reverse_number {
    Input: p_n: Integer
    Body: {
        reversed = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumGt(p_n, 0)) {
            reversed = AIMacro.NumAdd(AIMacro.NumMul(reversed, 10), AIMacro.NumMod(p_n, 10))
            p_n = AIMacro.FloorDiv(p_n, 10)
        }
        ReturnValue(reversed)
    }
}

Function.is_palindrome_number {
    Input: p_n: Integer
    Body: {
        t0 = reverse_number(p_n)
        t1 = AIMacro.NumEq(p_n, t0)
        ReturnValue(t1)
    }
}

Function.count_digits {
    Input: p_n: Integer
    Body: {
        t0 = AIMacro.NumEq(p_n, 0)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            ReturnValue(1)
        }
        count = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumGt(p_n, 0)) {
            count = AIMacro.NumAdd(count, 1)
            p_n = AIMacro.FloorDiv(p_n, 10)
        }
        ReturnValue(count)
    }
}

Function.main {
    Body: {
                t0 = String.Repeat("=", AIMacro.Int(50))
AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("AIMacro Comprehensive Test Suite")
        PrintMessage("\n")
                t1 = String.Repeat("=", AIMacro.Int(50))
AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("Factorial Tests:")
        PrintMessage("\n")
        t2 = factorial(5)
        PrintMessage("5! =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = factorial(10)
        PrintMessage("10! =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        PrintMessage("Fibonacci Tests:")
        PrintMessage("\n")
        t4 = fib_recursive(10)
        PrintMessage("fib(10) recursive =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        t5 = fib_iterative(10)
        PrintMessage("fib(10) iterative =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = fib_iterative(20)
        PrintMessage("fib(20) iterative =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        PrintMessage("Ackermann Tests:")
        PrintMessage("\n")
        t7 = ackermann(2, 3)
        PrintMessage("ack(2,3) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        t8 = ackermann(3, 2)
        PrintMessage("ack(3,2) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        PrintMessage("Prime Tests:")
        PrintMessage("\n")
        PrintMessage("Primes up to 50:")
        PrintMessage("\n")
        n = 2
        WhileLoop AIMacro.SmartBool(AIMacro.NumLe(n, 50)) {
            t9 = is_prime(n)
            t10 = AIMacro.NumEq(t9, 1)
            IfCondition AIMacro.SmartBool(t10) ThenBlock: {
                AIMacro.SmartPrint(n)
                PrintMessage("\n")
            }
            n = AIMacro.NumAdd(n, 1)
        }
        t11 = count_primes(100)
        PrintMessage("Count of primes <= 100:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        PrintMessage("GCD/LCM Tests:")
        PrintMessage("\n")
        t12 = gcd(48, 18)
        PrintMessage("gcd(48, 18) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t12)
        PrintMessage("\n")
        t13 = gcd(100, 35)
        PrintMessage("gcd(100, 35) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t13)
        PrintMessage("\n")
        t14 = lcm(12, 18)
        PrintMessage("lcm(12, 18) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t14)
        PrintMessage("\n")
        PrintMessage("Array Tests:")
        PrintMessage("\n")
        t15 = create_test_array()
        arr = t15
        size = 10
        PrintMessage("Original array stats:")
        PrintMessage("\n")
        t16 = array_sum(arr, size)
        PrintMessage("Sum =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t16)
        PrintMessage("\n")
        t17 = array_max(arr, size)
        PrintMessage("Max =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t17)
        PrintMessage("\n")
        t18 = array_min(arr, size)
        PrintMessage("Min =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t18)
        PrintMessage("\n")
        t19 = linear_search(arr, size, 42)
        PrintMessage("Linear search for 42:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t19)
        PrintMessage("\n")
        t20 = linear_search(arr, size, 99)
        PrintMessage("Linear search for 99:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t20)
        PrintMessage("\n")
        bubble_sort(arr, size)
        PrintMessage("After bubble sort:")
        PrintMessage("\n")
        t21 = DictGen_SmartGet(arr, 0)
        PrintMessage("First element:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t21)
        PrintMessage("\n")
        t22 = DictGen_SmartGet(arr, 9)
        PrintMessage("Last element:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t22)
        PrintMessage("\n")
        t23 = binary_search(arr, size, 42)
        PrintMessage("Binary search for 42:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t23)
        PrintMessage("\n")
        t24 = binary_search(arr, size, 25)
        PrintMessage("Binary search for 25:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t24)
        PrintMessage("\n")
        reverse_array(arr, size)
        PrintMessage("After reverse:")
        PrintMessage("\n")
        t25 = DictGen_SmartGet(arr, 0)
        PrintMessage("First element:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t25)
        PrintMessage("\n")
        t26 = DictGen_SmartGet(arr, 9)
        PrintMessage("Last element:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t26)
        PrintMessage("\n")
        PrintMessage("Math Tests:")
        PrintMessage("\n")
        t27 = power(2, 10)
        PrintMessage("2^10 =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t27)
        PrintMessage("\n")
        t28 = power(3, 5)
        PrintMessage("3^5 =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t28)
        PrintMessage("\n")
        t29 = integer_sqrt(144)
        PrintMessage("sqrt(144) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t29)
        PrintMessage("\n")
        t30 = integer_sqrt(1000)
        PrintMessage("sqrt(1000) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t30)
        PrintMessage("\n")
        t31 = is_perfect_square(144)
        PrintMessage("is_perfect_square(144) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t31)
        PrintMessage("\n")
        t32 = is_perfect_square(145)
        PrintMessage("is_perfect_square(145) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t32)
        PrintMessage("\n")
        t33 = sum_digits(12345)
        PrintMessage("sum_digits(12345) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t33)
        PrintMessage("\n")
        t34 = reverse_number(12345)
        PrintMessage("reverse(12345) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t34)
        PrintMessage("\n")
        t35 = is_palindrome_number(12321)
        PrintMessage("is_palindrome(12321) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t35)
        PrintMessage("\n")
        t36 = is_palindrome_number(12345)
        PrintMessage("is_palindrome(12345) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t36)
        PrintMessage("\n")
        t37 = count_digits(123456789)
        PrintMessage("count_digits(123456789) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t37)
        PrintMessage("\n")
                t38 = String.Repeat("=", AIMacro.Int(50))
AIMacro.SmartPrint(t38)
        PrintMessage("\n")
        PrintMessage("All tests complete!")
        PrintMessage("\n")
                t39 = String.Repeat("=", AIMacro.Int(50))
AIMacro.SmartPrint(t39)
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
