        AIMacro.SmartPrint(t36)
        PrintMessage("\n")
                t37 = String.Repeat("=", 50)
AIMacro.SmartPrint(t37)
        PrintMessage("\n")
        PrintMessage("All tests complete!")
        PrintMessage("\n")
                t38 = String.Repeat("=", 50)
AIMacro.SmartPrint(t38)
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
