LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.factorial {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 1) ThenBlock: {
            ReturnValue(1)
        }
        t0 = Subtract(p_n, 1)
        t1 = factorial(t0)
        t2 = Multiply(p_n, t1)
        ReturnValue(t2)
    }
}

Function.fib_recursive {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(p_n, 1) ThenBlock: {
            ReturnValue(1)
        }
        t0 = Subtract(p_n, 1)
        t1 = fib_recursive(t0)
        t2 = Subtract(p_n, 2)
        t3 = fib_recursive(t2)
        t4 = Add(t1, t3)
        ReturnValue(t4)
    }
}

Function.ackermann {
    Input: p_m: Integer
    Input: p_n: Integer
    Body: {
        IfCondition EqualTo(p_m, 0) ThenBlock: {
            t0 = Add(p_n, 1)
            ReturnValue(t0)
        }
        IfCondition EqualTo(p_n, 0) ThenBlock: {
            t1 = Subtract(p_m, 1)
            t2 = ackermann(t1, 1)
            ReturnValue(t2)
        }
        t3 = Subtract(p_m, 1)
        t4 = Subtract(p_n, 1)
        t5 = ackermann(p_m, t4)
        t6 = ackermann(t3, t5)
        ReturnValue(t6)
    }
}

Function.fib_iterative {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(p_n, 1) ThenBlock: {
            ReturnValue(1)
        }
        a = 0
        b = 1
        i = 2
        WhileLoop LessEqual(i, p_n) {
            temp = Add(a, b)
            a = b
            b = temp
            i = Add(i, 1)
        }
        ReturnValue(b)
    }
}

Function.is_prime {
    Input: p_n: Integer
    Body: {
        IfCondition LessThan(p_n, 2) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(p_n, 2) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Modulo(p_n, 2), 0) ThenBlock: {
            ReturnValue(0)
        }
        i = 3
        WhileLoop LessEqual(Multiply(i, i), p_n) {
            IfCondition EqualTo(Modulo(p_n, i), 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 2)
        }
        ReturnValue(1)
    }
}

Function.count_primes {
    Input: p_limit: Integer
    Body: {
        count = 0
        n = 2
        WhileLoop LessEqual(n, p_limit) {
            t0 = is_prime(n)
            IfCondition EqualTo(t0, 1) ThenBlock: {
                count = Add(count, 1)
            }
            n = Add(n, 1)
        }
        ReturnValue(count)
    }
}

Function.gcd {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        WhileLoop EqualTo(1, 1) {
            IfCondition Not(NotEqual(p_b, 0)) ThenBlock: {
                BreakLoop
            }
            temp = p_b
            p_b = Modulo(p_a, p_b)
            p_a = temp
        }
        ReturnValue(p_a)
    }
}

Function.lcm {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        t0 = Multiply(p_a, p_b)
        t1 = gcd(p_a, p_b)
        t2 = Divide(t0, t1)
        ReturnValue(t2)
    }
}

Function.create_test_array {
    Body: {
        arr = Array.Create(10)
        Array.Push(arr, 64)
        Array.Push(arr, 34)
        Array.Push(arr, 25)
        Array.Push(arr, 12)
        Array.Push(arr, 22)
        Array.Push(arr, 11)
        Array.Push(arr, 90)
        Array.Push(arr, 42)
        Array.Push(arr, 15)
        Array.Push(arr, 77)
        ReturnValue(arr)
    }
}

Function.array_sum {
    Input: p_arr: Integer
    Input: p_size: Integer
    Body: {
        total = 0
        i = 0
        WhileLoop LessThan(i, p_size) {
            t0 = DictGen_SmartGet(p_arr, i)
            total = Add(total, t0)
            i = Add(i, 1)
        }
        ReturnValue(total)
    }
}

Function.array_max {
    Input: p_arr: Integer
    Input: p_size: Integer
    Body: {
        IfCondition EqualTo(p_size, 0) ThenBlock: {
            ReturnValue(0)
        }
        t0 = DictGen_SmartGet(p_arr, 0)
        max_val = t0
        i = 1
        WhileLoop LessThan(i, p_size) {
            t1 = DictGen_SmartGet(p_arr, i)
            IfCondition GreaterThan(t1, max_val) ThenBlock: {
                t2 = DictGen_SmartGet(p_arr, i)
                max_val = t2
            }
            i = Add(i, 1)
        }
        ReturnValue(max_val)
    }
}

Function.array_min {
    Input: p_arr: Integer
    Input: p_size: Integer
    Body: {
        IfCondition EqualTo(p_size, 0) ThenBlock: {
            ReturnValue(0)
        }
        t0 = DictGen_SmartGet(p_arr, 0)
        min_val = t0
        i = 1
        WhileLoop LessThan(i, p_size) {
            t1 = DictGen_SmartGet(p_arr, i)
            IfCondition LessThan(t1, min_val) ThenBlock: {
                t2 = DictGen_SmartGet(p_arr, i)
                min_val = t2
            }
            i = Add(i, 1)
        }
        ReturnValue(min_val)
    }
}

Function.linear_search {
    Input: p_arr: Integer
    Input: p_size: Integer
    Input: p_target: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, p_size) {
            t0 = DictGen_SmartGet(p_arr, i)
            IfCondition EqualTo(t0, p_target) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(Subtract(0, 1))
    }
}

Function.bubble_sort {
    Input: p_arr: Integer
    Input: p_size: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, Subtract(p_size, 1)) {
            j = 0
            WhileLoop LessThan(j, Subtract(Subtract(p_size, i), 1)) {
                t0 = DictGen_SmartGet(p_arr, j)
                t1 = DictGen_SmartGet(p_arr, Add(j, 1))
                IfCondition GreaterThan(t0, t1) ThenBlock: {
                    t2 = DictGen_SmartGet(p_arr, j)
                    temp = t2
                    t3 = Add(j, 1)
                    t4 = DictGen_SmartGet(p_arr, t3)
                    DictGen_SmartSet(p_arr, j, t4)
                    DictGen_SmartSet(p_arr, Add(j, 1), temp)
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
    }
}

Function.selection_sort {
    Input: p_arr: Integer
    Input: p_size: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, Subtract(p_size, 1)) {
            min_idx = i
            j = Add(i, 1)
            WhileLoop LessThan(j, p_size) {
                t0 = DictGen_SmartGet(p_arr, j)
                t1 = DictGen_SmartGet(p_arr, min_idx)
                IfCondition LessThan(t0, t1) ThenBlock: {
                    min_idx = j
                }
                j = Add(j, 1)
            }
            IfCondition NotEqual(min_idx, i) ThenBlock: {
                t2 = DictGen_SmartGet(p_arr, i)
                temp = t2
                t3 = DictGen_SmartGet(p_arr, min_idx)
                DictGen_SmartSet(p_arr, i, t3)
                DictGen_SmartSet(p_arr, min_idx, temp)
            }
            i = Add(i, 1)
        }
    }
}

Function.insertion_sort {
    Input: p_arr: Integer
    Input: p_size: Integer
    Body: {
        i = 1
        WhileLoop LessThan(i, p_size) {
            t0 = DictGen_SmartGet(p_arr, i)
            key = t0
            j = Subtract(i, 1)
            WhileLoop EqualTo(1, 1) {
                t1 = DictGen_SmartGet(p_arr, j)
                IfCondition Not(And(GreaterEqual(j, 0), GreaterThan(t1, key))) ThenBlock: {
                    BreakLoop
                }
                t2 = DictGen_SmartGet(p_arr, j)
                DictGen_SmartSet(p_arr, Add(j, 1), t2)
                j = Subtract(j, 1)
            }
            DictGen_SmartSet(p_arr, Add(j, 1), key)
            i = Add(i, 1)
        }
    }
}

Function.binary_search {
    Input: p_arr: Integer
    Input: p_size: Integer
    Input: p_target: Integer
    Body: {
        low = 0
        high = Subtract(p_size, 1)
        WhileLoop LessEqual(low, high) {
            mid = Divide(Add(low, high), 2)
            t0 = DictGen_SmartGet(p_arr, mid)
            IfCondition EqualTo(t0, p_target) ThenBlock: {
                ReturnValue(mid)
            }
            t1 = DictGen_SmartGet(p_arr, mid)
            IfCondition LessThan(t1, p_target) ThenBlock: {
                low = Add(mid, 1)
            } ElseBlock: {
                high = Subtract(mid, 1)
            }
        }
        ReturnValue(Subtract(0, 1))
    }
}

Function.reverse_array {
    Input: p_arr: Integer
    Input: p_size: Integer
    Body: {
        left = 0
        right = Subtract(p_size, 1)
        WhileLoop LessThan(left, right) {
            t0 = DictGen_SmartGet(p_arr, left)
            temp = t0
            t1 = DictGen_SmartGet(p_arr, right)
            DictGen_SmartSet(p_arr, left, t1)
            DictGen_SmartSet(p_arr, right, temp)
            left = Add(left, 1)
            right = Subtract(right, 1)
        }
    }
}

Function.power {
    Input: p_base: Integer
    Input: p_exp: Integer
    Body: {
        IfCondition EqualTo(p_exp, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Modulo(p_exp, 2), 0) ThenBlock: {
            t0 = Divide(p_exp, 2)
            t1 = power(p_base, t0)
            half = t1
            t2 = Multiply(half, half)
            ReturnValue(t2)
        }
        t3 = Subtract(p_exp, 1)
        t4 = power(p_base, t3)
        t5 = Multiply(p_base, t4)
        ReturnValue(t5)
    }
}

Function.integer_sqrt {
    Input: p_n: Integer
    Body: {
        IfCondition LessThan(p_n, 2) ThenBlock: {
            ReturnValue(p_n)
        }
        x = p_n
        y = Divide(Add(x, 1), 2)
        WhileLoop LessThan(y, x) {
            x = y
            y = Divide(Add(x, Divide(p_n, x)), 2)
        }
        ReturnValue(x)
    }
}

Function.is_perfect_square {
    Input: p_n: Integer
    Body: {
        t0 = integer_sqrt(p_n)
        root = t0
        t1 = Multiply(root, root)
        t2 = EqualTo(t1, p_n)
        ReturnValue(t2)
    }
}

Function.sum_digits {
    Input: p_n: Integer
    Body: {
        total = 0
        WhileLoop GreaterThan(p_n, 0) {
            total = Add(total, Modulo(p_n, 10))
            p_n = Divide(p_n, 10)
        }
        ReturnValue(total)
    }
}

Function.reverse_number {
    Input: p_n: Integer
    Body: {
        reversed = 0
        WhileLoop GreaterThan(p_n, 0) {
            reversed = Add(Multiply(reversed, 10), Modulo(p_n, 10))
            p_n = Divide(p_n, 10)
        }
        ReturnValue(reversed)
    }
}

Function.is_palindrome_number {
    Input: p_n: Integer
    Body: {
        t0 = reverse_number(p_n)
        t1 = EqualTo(p_n, t0)
        ReturnValue(t1)
    }
}

Function.count_digits {
    Input: p_n: Integer
    Body: {
        IfCondition EqualTo(p_n, 0) ThenBlock: {
            ReturnValue(1)
        }
        count = 0
        WhileLoop GreaterThan(p_n, 0) {
            count = Add(count, 1)
            p_n = Divide(p_n, 10)
        }
        ReturnValue(count)
    }
}

SubRoutine.Main {
                t0 = String.Repeat("=", 50)
AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("AIMacro Comprehensive Test Suite")
        PrintMessage("\n")
                t1 = String.Repeat("=", 50)
AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("Factorial Tests:")
        PrintMessage("\n")
        t2 = factorial(5)
        PrintMessage("5! =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = factorial(10)
        PrintMessage("10! =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        PrintMessage("Fibonacci Tests:")
        PrintMessage("\n")
        t4 = fib_recursive(10)
        PrintMessage("fib(10) recursive =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        t5 = fib_iterative(10)
        PrintMessage("fib(10) iterative =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = fib_iterative(20)
        PrintMessage("fib(20) iterative =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        PrintMessage("Ackermann Tests:")
        PrintMessage("\n")
        t7 = ackermann(2, 3)
        PrintMessage("ack(2,3) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        t8 = ackermann(3, 2)
        PrintMessage("ack(3,2) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        PrintMessage("Prime Tests:")
        PrintMessage("\n")
        PrintMessage("Primes up to 50:")
        PrintMessage("\n")
        n = 2
        WhileLoop LessEqual(n, 50) {
            t9 = is_prime(n)
            IfCondition EqualTo(t9, 1) ThenBlock: {
                AIMacro.SmartPrint(n)
                PrintMessage("\n")
            }
            n = Add(n, 1)
        }
        t10 = count_primes(100)
        PrintMessage("Count of primes <= 100:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t10)
        PrintMessage("\n")
        PrintMessage("GCD/LCM Tests:")
        PrintMessage("\n")
        t11 = gcd(48, 18)
        PrintMessage("gcd(48, 18) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        t12 = gcd(100, 35)
        PrintMessage("gcd(100, 35) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t12)
        PrintMessage("\n")
        t13 = lcm(12, 18)
        PrintMessage("lcm(12, 18) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t13)
        PrintMessage("\n")
        PrintMessage("Array Tests:")
        PrintMessage("\n")
        t14 = create_test_array()
        arr = t14
        size = 10
        PrintMessage("Original array stats:")
        PrintMessage("\n")
        t15 = array_sum(arr, size)
        PrintMessage("Sum =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t15)
        PrintMessage("\n")
        t16 = array_max(arr, size)
        PrintMessage("Max =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t16)
        PrintMessage("\n")
        t17 = array_min(arr, size)
        PrintMessage("Min =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t17)
        PrintMessage("\n")
        t18 = linear_search(arr, size, 42)
        PrintMessage("Linear search for 42:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t18)
        PrintMessage("\n")
        t19 = linear_search(arr, size, 99)
        PrintMessage("Linear search for 99:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t19)
        PrintMessage("\n")
        bubble_sort(arr, size)
        PrintMessage("After bubble sort:")
        PrintMessage("\n")
        t20 = DictGen_SmartGet(arr, 0)
        PrintMessage("First element:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t20)
        PrintMessage("\n")
        t21 = DictGen_SmartGet(arr, 9)
        PrintMessage("Last element:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t21)
        PrintMessage("\n")
        t22 = binary_search(arr, size, 42)
        PrintMessage("Binary search for 42:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t22)
        PrintMessage("\n")
        t23 = binary_search(arr, size, 25)
        PrintMessage("Binary search for 25:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t23)
        PrintMessage("\n")
        reverse_array(arr, size)
        PrintMessage("After reverse:")
        PrintMessage("\n")
        t24 = DictGen_SmartGet(arr, 0)
        PrintMessage("First element:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t24)
        PrintMessage("\n")
        t25 = DictGen_SmartGet(arr, 9)
        PrintMessage("Last element:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t25)
        PrintMessage("\n")
        PrintMessage("Math Tests:")
        PrintMessage("\n")
        t26 = power(2, 10)
        PrintMessage("2^10 =")
