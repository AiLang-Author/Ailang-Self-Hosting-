        PrintMessage("3^5 =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t27)
        PrintMessage("\n")
        t28 = integer_sqrt(144)
        PrintMessage("sqrt(144) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t28)
        PrintMessage("\n")
        t29 = integer_sqrt(1000)
        PrintMessage("sqrt(1000) =")
