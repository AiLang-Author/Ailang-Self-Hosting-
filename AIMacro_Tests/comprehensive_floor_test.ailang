LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.assert_eq {
    Input: p_actual: Integer
    Input: p_expected: Integer
    Input: p_name: Integer
    Body: {
        IfCondition EqualTo(p_actual, p_expected) ThenBlock: {
            PrintMessage("  PASS:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_name)
            PrintMessage("\n")
            ReturnValue(1)
        } ElseBlock: {
            PrintMessage("  FAIL:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_name)
            PrintMessage("\n")
            PrintMessage("    Expected:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_expected)
            PrintMessage(" ")
            PrintMessage("Got:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_actual)
            PrintMessage("\n")
            ReturnValue(0)
        }
    }
}

Function.assert_true {
    Input: p_cond: Integer
    Input: p_name: Integer
    Body: {
        t0 = assert_eq(p_cond, 1, p_name)
        ReturnValue(t0)
    }
}

Function.assert_false {
    Input: p_cond: Integer
    Input: p_name: Integer
    Body: {
        t0 = assert_eq(p_cond, 0, p_name)
        ReturnValue(t0)
    }
}

Function.test_arithmetic {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 1: Arithmetic ===")
        PrintMessage("\n")
        p = 0
        t0 = Add(1, 1)
        t1 = assert_eq(t0, 2, "addition")
        t2 = Add(p, t1)
        p = t2
        t3 = Subtract(10, 3)
        t4 = assert_eq(t3, 7, "subtraction")
        t5 = Add(p, t4)
        p = t5
        t6 = Multiply(4, 5)
        t7 = assert_eq(t6, 20, "multiplication")
        t8 = Add(p, t7)
        p = t8
        t9 = Divide(20, 4)
        t10 = assert_eq(t9, 5, "division")
        t11 = Add(p, t10)
        p = t11
        t12 = Modulo(17, 5)
        t13 = assert_eq(t12, 2, "modulo")
        t14 = Add(p, t13)
        p = t14
        t15 = Subtract(0, 5)
        t16 = Add(t15, 10)
        t17 = assert_eq(t16, 5, "negative operand")
        t18 = Add(p, t17)
        p = t18
        t19 = Subtract(5, 10)
        t20 = Subtract(0, 5)
        t21 = assert_eq(t19, t20, "negative result")
        t22 = Add(p, t21)
        p = t22
        t23 = Multiply(3, 4)
        t24 = Add(2, t23)
        t25 = assert_eq(t24, 14, "precedence mul before add")
        t26 = Add(p, t25)
        p = t26
        t27 = Add(2, 3)
        t28 = Multiply(t27, 4)
        t29 = assert_eq(t28, 20, "parentheses override")
        t30 = Add(p, t29)
        p = t30
        t31 = Subtract(10, 2)
        t32 = Subtract(t31, 3)
        t33 = assert_eq(t32, 5, "left associative sub")
        t34 = Add(p, t33)
        p = t34
        x = 10
        y = 3
        t35 = Add(x, y)
        t36 = assert_eq(t35, 13, "variables in expr")
        t37 = Add(p, t36)
        p = t37
        t38 = Multiply(x, y)
        t39 = Add(t38, 1)
        t40 = assert_eq(t39, 31, "mixed var expr")
        t41 = Add(p, t40)
        p = t41
        PrintMessage("Arithmetic:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 12")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_augmented_assign {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 2: Augmented Assignment ===")
        PrintMessage("\n")
        p = 0
        x = 10
        x = Add(x, 5)
        t0 = assert_eq(x, 15, "+= operator")
        t1 = Add(p, t0)
        p = t1
        x = Subtract(x, 3)
        t2 = assert_eq(x, 12, "-= operator")
        t3 = Add(p, t2)
        p = t3
        x = Multiply(x, 2)
        t4 = assert_eq(x, 24, "*= operator")
        t5 = Add(p, t4)
        p = t5
        x = Divide(x, 4)
        t6 = assert_eq(x, 6, "/= operator")
        t7 = Add(p, t6)
        p = t7
        x = Modulo(x, 4)
        t8 = assert_eq(x, 2, "%= operator")
        t9 = Add(p, t8)
        p = t9
        PrintMessage("Augmented:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 5")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_comparisons {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 3: Comparisons ===")
        PrintMessage("\n")
        p = 0
        t0 = GreaterThan(5, 3)
        t1 = assert_true(t0, "greater than true")
        t2 = Add(p, t1)
        p = t2
        t3 = GreaterThan(3, 5)
        t4 = assert_false(t3, "greater than false")
        t5 = Add(p, t4)
        p = t5
        t6 = LessThan(3, 5)
        t7 = assert_true(t6, "less than true")
        t8 = Add(p, t7)
        p = t8
        t9 = LessThan(5, 3)
        t10 = assert_false(t9, "less than false")
        t11 = Add(p, t10)
        p = t11
        t12 = GreaterEqual(5, 5)
        t13 = assert_true(t12, "greater equal (equal)")
        t14 = Add(p, t13)
        p = t14
        t15 = GreaterEqual(6, 5)
        t16 = assert_true(t15, "greater equal (greater)")
        t17 = Add(p, t16)
        p = t17
        t18 = LessEqual(5, 5)
        t19 = assert_true(t18, "less equal (equal)")
        t20 = Add(p, t19)
        p = t20
        t21 = LessEqual(4, 5)
        t22 = assert_true(t21, "less equal (less)")
        t23 = Add(p, t22)
        p = t23
        t24 = EqualTo(5, 5)
        t25 = assert_true(t24, "equal true")
        t26 = Add(p, t25)
        p = t26
        t27 = EqualTo(5, 6)
        t28 = assert_false(t27, "equal false")
        t29 = Add(p, t28)
        p = t29
        t30 = NotEqual(5, 6)
        t31 = assert_true(t30, "not equal true")
        t32 = Add(p, t31)
        p = t32
        t33 = NotEqual(5, 5)
        t34 = assert_false(t33, "not equal false")
        t35 = Add(p, t34)
        p = t35
        PrintMessage("Comparisons:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 12")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_logical {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 4: Logical Operators ===")
        PrintMessage("\n")
        p = 0
        t0 = And(1, 1)
        t1 = assert_true(t0, "and: T and T")
        t2 = Add(p, t1)
        p = t2
        t3 = And(1, 0)
        t4 = assert_false(t3, "and: T and F")
        t5 = Add(p, t4)
        p = t5
        t6 = And(0, 1)
        t7 = assert_false(t6, "and: F and T")
        t8 = Add(p, t7)
        p = t8
        t9 = And(0, 0)
        t10 = assert_false(t9, "and: F and F")
        t11 = Add(p, t10)
        p = t11
        t12 = Or(1, 1)
        t13 = assert_true(t12, "or: T or T")
        t14 = Add(p, t13)
        p = t14
        t15 = Or(1, 0)
        t16 = assert_true(t15, "or: T or F")
        t17 = Add(p, t16)
        p = t17
        t18 = Or(0, 1)
        t19 = assert_true(t18, "or: F or T")
        t20 = Add(p, t19)
        p = t20
        t21 = Or(0, 0)
        t22 = assert_false(t21, "or: F or F")
        t23 = Add(p, t22)
        p = t23
        t24 = Not(0)
        t25 = assert_true(t24, "not: not F")
        t26 = Add(p, t25)
        p = t26
        t27 = Not(1)
        t28 = assert_false(t27, "not: not T")
        t29 = Add(p, t28)
        p = t29
        t30 = And(1, 1)
        t31 = Or(t30, 0)
        t32 = assert_true(t31, "combined: (T and T) or F")
        t33 = Add(p, t32)
        p = t33
        t34 = And(0, 1)
        t35 = Not(t34)
        t36 = assert_true(t35, "combined: not (F and T)")
        t37 = Add(p, t36)
        p = t37
        PrintMessage("Logical:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 12")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_conditionals {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 5: Conditionals ===")
        PrintMessage("\n")
        p = 0
        result = 0
        IfCondition 1 ThenBlock: {
            result = 1
        }
        t0 = assert_eq(result, 1, "if true executes")
        t1 = Add(p, t0)
        p = t1
        result = 0
        IfCondition 0 ThenBlock: {
            result = 1
        }
        t2 = assert_eq(result, 0, "if false skips")
        t3 = Add(p, t2)
        p = t3
        result = 0
        IfCondition 0 ThenBlock: {
            result = 1
        } ElseBlock: {
            result = 2
        }
        t4 = assert_eq(result, 2, "else branch")
        t5 = Add(p, t4)
        p = t5
        x = 2
        result = 0
        IfCondition EqualTo(x, 1) ThenBlock: {
            result = 10
        } ElseBlock: {
            IfCondition EqualTo(x, 2) ThenBlock: {
                result = 20
            } ElseBlock: {
                IfCondition EqualTo(x, 3) ThenBlock: {
                    result = 30
                } ElseBlock: {
                    result = 40
                }
            }
        }
        t6 = assert_eq(result, 20, "elif branch")
        t7 = Add(p, t6)
        p = t7
        x = 1
        result = 0
        IfCondition EqualTo(x, 1) ThenBlock: {
            result = 10
        } ElseBlock: {
            IfCondition EqualTo(x, 1) ThenBlock: {
                result = 20
            }
        }
        t8 = assert_eq(result, 10, "first match wins")
        t9 = Add(p, t8)
        p = t9
        x = 99
        result = 0
        IfCondition EqualTo(x, 1) ThenBlock: {
            result = 10
        } ElseBlock: {
            IfCondition EqualTo(x, 2) ThenBlock: {
                result = 20
            } ElseBlock: {
                result = 99
            }
        }
        t10 = assert_eq(result, 99, "else default")
        t11 = Add(p, t10)
        p = t11
        a = 1
        b = 1
        result = 0
        IfCondition a ThenBlock: {
            IfCondition b ThenBlock: {
                result = 11
            } ElseBlock: {
                result = 10
            }
        } ElseBlock: {
            result = 0
        }
        t12 = assert_eq(result, 11, "nested if")
        t13 = Add(p, t12)
        p = t13
        PrintMessage("Conditionals:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 7")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_while_loops {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 6: While Loops ===")
        PrintMessage("\n")
        p = 0
        count = 0
        i = 0
        WhileLoop LessThan(i, 5) {
            count = Add(count, 1)
            i = Add(i, 1)
        }
        t0 = assert_eq(count, 5, "while count to 5")
        t1 = Add(p, t0)
        p = t1
        count = 0
        i = 10
        WhileLoop LessThan(i, 5) {
            count = Add(count, 1)
            i = Add(i, 1)
        }
        t2 = assert_eq(count, 0, "while zero iterations")
        t3 = Add(p, t2)
        p = t3
        total = 0
        i = 1
        WhileLoop LessEqual(i, 10) {
            total = Add(total, i)
            i = Add(i, 1)
        }
        t4 = assert_eq(total, 55, "while sum 1-10")
        t5 = Add(p, t4)
        p = t5
        total = 0
        i = 0
        WhileLoop LessThan(i, 3) {
            j = 0
            WhileLoop LessThan(j, 4) {
                total = Add(total, 1)
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        t6 = assert_eq(total, 12, "nested while 3x4")
        t7 = Add(p, t6)
        p = t7
        x = 0
        WhileLoop EqualTo(1, 1) {
            IfCondition Not(And(LessThan(x, 10), NotEqual(x, 5))) ThenBlock: {
                BreakLoop
            }
            x = Add(x, 1)
        }
        t8 = assert_eq(x, 5, "while with and")
        t9 = Add(p, t8)
        p = t9
        PrintMessage("While:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 5")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_for_loops {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 7: For Loops ===")
        PrintMessage("\n")
        p = 0
        total = 0
        lc0 = 0
        ls0 = 5
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            total = Add(total, 1)
        }
        t1 = assert_eq(total, 5, "for range(5)")
        t2 = Add(p, t1)
        p = t2
        total = 0
        lc3 = 2
        ls3 = 6
        lt3 = 1
        WhileLoop LessThan(lc3, ls3) {
            i = lc3
            lc3 = Add(lc3, lt3)
            total = Add(total, i)
        }
        t4 = assert_eq(total, 14, "for range(2,6) sum=14")
        t5 = Add(p, t4)
        p = t5
        total = 0
        lc6 = 0
        ls6 = 10
        lt6 = 2
        WhileLoop LessThan(lc6, ls6) {
            i = lc6
            lc6 = Add(lc6, lt6)
            total = Add(total, i)
        }
        t7 = assert_eq(total, 20, "for range step=2")
        t8 = Add(p, t7)
        p = t8
        nums = Array.Create(4)
        Array.Push(nums, 10)
        Array.Push(nums, 20)
        Array.Push(nums, 30)
        Array.Push(nums, 40)
        total = 0
        i = 0
        WhileLoop EqualTo(1, 1) {
            t9 = AIMacro.SmartLen(nums)
            IfCondition Not(LessThan(i, t9)) ThenBlock: {
                BreakLoop
            }
            t10 = DictGen_SmartGet(nums, i)
            t11 = Add(total, t10)
            total = t11
            i = Add(i, 1)
        }
        t12 = assert_eq(total, 100, "list iteration (while workaround)")
        t13 = Add(p, t12)
        p = t13
        total = 0
        lc14 = 0
        ls14 = 3
        lt14 = 1
        WhileLoop LessThan(lc14, ls14) {
            i = lc14
            lc14 = Add(lc14, lt14)
            lc15 = 0
            ls15 = 4
            lt15 = 1
            WhileLoop LessThan(lc15, ls15) {
                j = lc15
                lc15 = Add(lc15, lt15)
                total = Add(total, 1)
            }
        }
        t16 = assert_eq(total, 12, "nested for 3x4")
        t17 = Add(p, t16)
        p = t17
        last = 0
        lc18 = 0
        ls18 = 5
        lt18 = 1
        WhileLoop LessThan(lc18, ls18) {
            i = lc18
            lc18 = Add(lc18, lt18)
            last = i
        }
        t19 = assert_eq(last, 4, "for var capture")
        t20 = Add(p, t19)
        p = t20
        PrintMessage("For loops:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 6")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.helper_double {
    Input: p_x: Integer
    Body: {
        t0 = Multiply(p_x, 2)
        ReturnValue(t0)
    }
}

Function.helper_add3 {
    Input: p_a: Integer
    Input: p_b: Integer
    Input: p_c: Integer
    Body: {
        t0 = Add(p_a, p_b)
        t1 = Add(t0, p_c)
        ReturnValue(t1)
    }
}

Function.helper_factorial {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 1) ThenBlock: {
            ReturnValue(1)
        }
        t0 = Subtract(p_n, 1)
        t1 = helper_factorial(t0)
        t2 = Multiply(p_n, t1)
        ReturnValue(t2)
    }
}

Function.helper_fib {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 1) ThenBlock: {
            ReturnValue(p_n)
        }
        t0 = Subtract(p_n, 1)
        t1 = helper_fib(t0)
        t2 = Subtract(p_n, 2)
        t3 = helper_fib(t2)
        t4 = Add(t1, t3)
        ReturnValue(t4)
    }
}

Function.test_functions {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 8: Functions ===")
        PrintMessage("\n")
        p = 0
        t0 = helper_double(5)
        t1 = assert_eq(t0, 10, "basic function")
        t2 = Add(p, t1)
        p = t2
        t3 = helper_add3(1, 2, 3)
        t4 = assert_eq(t3, 6, "multi params")
        t5 = Add(p, t4)
        p = t5
        t6 = helper_factorial(5)
        t7 = assert_eq(t6, 120, "factorial(5)")
        t8 = Add(p, t7)
        p = t8
        t9 = helper_factorial(0)
        t10 = assert_eq(t9, 1, "factorial(0)")
        t11 = Add(p, t10)
        p = t11
        t12 = helper_fib(10)
        t13 = assert_eq(t12, 55, "fib(10)")
        t14 = Add(p, t13)
        p = t14
        t15 = helper_double(3)
        t16 = helper_double(t15)
        t17 = assert_eq(t16, 12, "nested calls")
        t18 = Add(p, t17)
        p = t18
        t19 = helper_double(2)
        t20 = helper_double(3)
        t21 = Add(t19, t20)
        t22 = assert_eq(t21, 10, "calls in expr")
        t23 = Add(p, t22)
        p = t23
        PrintMessage("Functions:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 7")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_lists {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 9: Lists ===")
        PrintMessage("\n")
        p = 0
        nums = Array.Create(5)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        Array.Push(nums, 3)
        Array.Push(nums, 4)
        Array.Push(nums, 5)
        t0 = AIMacro.SmartLen(nums)
        t1 = assert_eq(t0, 5, "list len")
        t2 = Add(p, t1)
        p = t2
        t3 = DictGen_SmartGet(nums, 0)
        t4 = assert_eq(t3, 1, "index [0]")
        t5 = Add(p, t4)
        p = t5
        t6 = DictGen_SmartGet(nums, 2)
        t7 = assert_eq(t6, 3, "index [2]")
        t8 = Add(p, t7)
        p = t8
        t9 = DictGen_SmartGet(nums, 4)
        t10 = assert_eq(t9, 5, "index [4]")
        t11 = Add(p, t10)
        p = t11
        t12 = AIMacro.SmartSize(nums)
        t13 = Subtract(t12, 1)
        t14 = DictGen_SmartGet(nums, t13)
        t15 = assert_eq(t14, 5, "index [-1]")
        t16 = Add(p, t15)
        p = t16
        DictGen_SmartSet(nums, 0, 100)
        t17 = DictGen_SmartGet(nums, 0)
        t18 = assert_eq(t17, 100, "index assign")
        t19 = Add(p, t18)
        p = t19
        items = Array.Create(2)
        Array.Push(items, 10)
        Array.Push(items, 20)
        AIMacro.SmartPush(items, 30)
        t20 = AIMacro.SmartLen(items)
        t21 = assert_eq(t20, 3, "append len")
        t22 = Add(p, t21)
        p = t22
        t23 = DictGen_SmartGet(items, 2)
        t24 = assert_eq(t23, 30, "append value")
        t25 = Add(p, t24)
        p = t25
        last = AIMacro.SmartPop(items)
        t26 = assert_eq(last, 30, "pop returns value")
        t27 = Add(p, t26)
        p = t27
        t28 = AIMacro.SmartLen(items)
        t29 = assert_eq(t28, 2, "pop reduces len")
        t30 = Add(p, t29)
        p = t30
        empty = Array.Create(0)
        t31 = AIMacro.SmartLen(empty)
        t32 = assert_eq(t31, 0, "empty list len")
        t33 = Add(p, t32)
        p = t33
        AIMacro.SmartPush(empty, 1)
        t34 = AIMacro.SmartLen(empty)
        t35 = assert_eq(t34, 1, "append to empty")
        t36 = Add(p, t35)
        p = t36
        PrintMessage("Lists:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 10")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_list_operations {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 10: List Operations ===")
        PrintMessage("\n")
        p = 0
        nums = Array.Create(6)
        Array.Push(nums, 5)
        Array.Push(nums, 2)
        Array.Push(nums, 8)
        Array.Push(nums, 1)
        Array.Push(nums, 9)
        Array.Push(nums, 3)
        t0 = AIMacro.TypedSorted(nums)
        s = t0
        t1 = DictGen_SmartGet(s, 0)
        t2 = assert_eq(t1, 1, "sorted[0]")
        t3 = Add(p, t2)
        p = t3
        t4 = DictGen_SmartGet(s, 1)
        t5 = assert_eq(t4, 2, "sorted[1]")
        t6 = Add(p, t5)
        p = t6
        t7 = DictGen_SmartGet(s, 5)
        t8 = assert_eq(t7, 9, "sorted[5]")
        t9 = Add(p, t8)
        p = t9
        nums = Array.Create(3)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        Array.Push(nums, 3)
        t10 = AIMacro.TypedReversed(nums)
        r = t10
        t11 = DictGen_SmartGet(r, 0)
        t12 = assert_eq(t11, 3, "reversed[0]")
        t13 = Add(p, t12)
        p = t13
        t14 = DictGen_SmartGet(r, 2)
        t15 = assert_eq(t14, 1, "reversed[2]")
        t16 = Add(p, t15)
        p = t16
        original = Array.Create(3)
        Array.Push(original, 7)
        Array.Push(original, 8)
        Array.Push(original, 9)
        copied = AIMacro.TypedListCopy(original)
        t17 = DictGen_SmartGet(copied, 0)
        t18 = assert_eq(t17, 7, "copy[0]")
        t19 = Add(p, t18)
        p = t19
        DictGen_SmartSet(copied, 0, 100)
        t20 = DictGen_SmartGet(original, 0)
        t21 = assert_eq(t20, 7, "copy independence")
        t22 = Add(p, t21)
        p = t22
        nums = Array.Create(5)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        Array.Push(nums, 3)
        Array.Push(nums, 4)
        Array.Push(nums, 5)
        t23 = AIMacro.SmartSum(nums)
        t24 = assert_eq(t23, 15, "sum")
        t25 = Add(p, t24)
        p = t25
        t26 = AIMacro.Min(3, 7)
        t27 = assert_eq(t26, 3, "min(3,7)")
        t28 = Add(p, t27)
        p = t28
        t29 = AIMacro.Max(3, 7)
        t30 = assert_eq(t29, 7, "max(3,7)")
        t31 = Add(p, t30)
        p = t31
        PrintMessage("List ops:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 10")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_types {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 11: Type System ===")
        PrintMessage("\n")
        p = 0
        t0 = Types.IsInstance(42, TypeID.INT)
        t1 = assert_true(t0, "isinstance int")
        t2 = Add(p, t1)
        p = t2
        t3 = Types.IsInstance("hello", TypeID.STR)
        t4 = assert_true(t3, "isinstance str")
        t5 = Add(p, t4)
        p = t5
        t6 = Array.Create(3)
        Array.Push(t6, 1)
        Array.Push(t6, 2)
        Array.Push(t6, 3)
        t7 = Types.IsInstance(t6, TypeID.LIST)
        t8 = assert_true(t7, "isinstance list")
        t9 = Add(p, t8)
        p = t9
        t10 = Types.IsInstance(42, TypeID.STR)
        t11 = assert_false(t10, "int not str")
        t12 = Add(p, t11)
        p = t12
        t13 = Types.IsInstance("hi", TypeID.INT)
        t14 = assert_false(t13, "str not int")
        t15 = Add(p, t14)
        p = t15
        t16 = Types.IsInstance(42, TypeID.LIST)
        t17 = assert_false(t16, "int not list")
        t18 = Add(p, t17)
        p = t18
        nums = Array.Create(3)
        Array.Push(nums, 3)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        t19 = AIMacro.TypedSorted(nums)
        s = t19
        t20 = Types.IsInstance(s, TypeID.LIST)
        t21 = assert_true(t20, "sorted is list")
        t22 = Add(p, t21)
        p = t22
        t23 = AIMacro.TypedReversed(nums)
        r = t23
        t24 = Types.IsInstance(r, TypeID.LIST)
        t25 = assert_true(t24, "reversed is list")
        t26 = Add(p, t25)
        p = t26
        c = AIMacro.TypedListCopy(nums)
        t27 = Types.IsInstance(c, TypeID.LIST)
        t28 = assert_true(t27, "copy is list")
        t29 = Add(p, t28)
        p = t29
        PrintMessage("Types:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 9")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_strings {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 12: Strings ===")
        PrintMessage("\n")
        p = 0
        s = "hello"
        t0 = DictGen_SmartLen(s)
        t1 = assert_eq(t0, 5, "string len")
        t2 = Add(p, t1)
        p = t2
        t3 = Types.IsInstance(s, TypeID.STR)
        t4 = assert_true(t3, "string isinstance")
        t5 = Add(p, t4)
        p = t5
        msg = "test message"
        PrintMessage("  (String print test):")
        PrintMessage(" ")
        AIMacro.SmartPrint(msg)
        PrintMessage("\n")
        p = Add(p, 1)
        PrintMessage("Strings:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 3")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_builtins {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 13: Builtins ===")
        PrintMessage("\n")
        p = 0
        t0 = Subtract(0, 5)
        t1 = AIMacro.Abs(t0)
        t2 = assert_eq(t1, 5, "abs(-5)")
        t3 = Add(p, t2)
        p = t3
        t4 = AIMacro.Abs(5)
        t5 = assert_eq(t4, 5, "abs(5)")
        t6 = Add(p, t5)
        p = t6
        t7 = AIMacro.Abs(0)
        t8 = assert_eq(t7, 0, "abs(0)")
        t9 = Add(p, t8)
        p = t9
        t10 = AIMacro.Min(10, 20)
        t11 = assert_eq(t10, 10, "min")
        t12 = Add(p, t11)
        p = t12
        t13 = AIMacro.Max(10, 20)
        t14 = assert_eq(t13, 20, "max")
        t15 = Add(p, t14)
        p = t15
        t16 = Array.Create(3)
        Array.Push(t16, 1)
        Array.Push(t16, 2)
        Array.Push(t16, 3)
        t17 = DictGen_SmartLen(t16)
        t18 = assert_eq(t17, 3, "len list")
        t19 = Add(p, t18)
        p = t19
        t20 = DictGen_SmartLen("abc")
        t21 = assert_eq(t20, 3, "len string")
        t22 = Add(p, t21)
        p = t22
        t23 = AIMacro.Bool(0)
        t24 = assert_eq(t23, 0, "bool(0)")
        t25 = Add(p, t24)
        p = t25
        t26 = AIMacro.Bool(1)
        t27 = assert_eq(t26, 1, "bool(1)")
        t28 = Add(p, t27)
        p = t28
        t29 = AIMacro.Bool(42)
        t30 = assert_eq(t29, 1, "bool(42)")
        t31 = Add(p, t30)
        p = t31
        t32 = AIMacro.Int(42)
        t33 = assert_eq(t32, 42, "int(42)")
        t34 = Add(p, t33)
        p = t34
        PrintMessage("Builtins:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 11")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_math {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 14: Math ===")
        PrintMessage("\n")
        p = 0
        t0 = Math.Power(2, 3)
        t1 = assert_eq(t0, 8, "2**3 = 8")
        t2 = Add(p, t1)
        p = t2
        t3 = Math.Power(2, 0)
        t4 = assert_eq(t3, 1, "2**0 = 1")
        t5 = Add(p, t4)
        p = t5
        t6 = Math.Power(3, 2)
        t7 = assert_eq(t6, 9, "3**2 = 9")
        t8 = Add(p, t7)
        p = t8
        t9 = Math.FloorDiv(7, 2)
        t10 = assert_eq(t9, 3, "7//2 = 3")
        t11 = Add(p, t10)
        p = t11
        t12 = Math.FloorDiv(10, 3)
        t13 = assert_eq(t12, 3, "10//3 = 3")
        t14 = Add(p, t13)
        p = t14
        PrintMessage("Math:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 5")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_complex_expressions {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 15: Complex Expressions ===")
        PrintMessage("\n")
        p = 0
        result = Subtract(Multiply(Add(1, 2), Add(3, 4)), 5)
        t0 = assert_eq(result, 16, "nested arith")
        t1 = Add(p, t0)
        p = t1
        t2 = helper_double(3)
        t3 = helper_double(4)
        t4 = Multiply(t3, 2)
        t5 = Add(t2, t4)
        result = t5
        t6 = assert_eq(result, 22, "funcs in expr")
        t7 = Add(p, t6)
        p = t7
        x = 5
        result = 0
        IfCondition And(And(GreaterThan(x, 0), LessThan(x, 10)), NotEqual(x, 3)) ThenBlock: {
            result = 1
        }
        t8 = assert_true(result, "chained and")
        t9 = Add(p, t8)
        p = t9
        nums = Array.Create(3)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        Array.Push(nums, 3)
        t10 = DictGen_SmartGet(nums, 0)
        t11 = DictGen_SmartGet(nums, 1)
        t12 = Add(t10, t11)
        t13 = DictGen_SmartGet(nums, 2)
        t14 = Add(t12, t13)
        result = t14
        t15 = assert_eq(result, 6, "list index in expr")
        t16 = Add(p, t15)
        p = t16
        x = 10
        result = 0
        IfCondition GreaterThan(x, 5) ThenBlock: {
            result = Multiply(x, 2)
        } ElseBlock: {
            result = x
        }
        t17 = assert_eq(result, 20, "conditional computation")
        t18 = Add(p, t17)
        p = t18
        PrintMessage("Complex:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 5")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

SubRoutine.Main {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("============================================================")
        PrintMessage("\n")
        PrintMessage("   AIMACRO TRANSPILER - COMPREHENSIVE FLOOR TEST")
        PrintMessage("\n")
        PrintMessage("============================================================")
        PrintMessage("\n")
        total = 0
        passed = 0
        t0 = test_arithmetic()
        p = t0
        passed = Add(passed, p)
        total = Add(total, 12)
        t1 = test_augmented_assign()
        p = t1
        passed = Add(passed, p)
        total = Add(total, 5)
        t2 = test_comparisons()
        p = t2
        passed = Add(passed, p)
        total = Add(total, 12)
        t3 = test_logical()
        p = t3
        passed = Add(passed, p)
        total = Add(total, 12)
        t4 = test_conditionals()
        p = t4
        passed = Add(passed, p)
        total = Add(total, 7)
        t5 = test_while_loops()
        p = t5
        passed = Add(passed, p)
        total = Add(total, 5)
        t6 = test_for_loops()
        p = t6
        passed = Add(passed, p)
        total = Add(total, 6)
        t7 = test_functions()
        p = t7
        passed = Add(passed, p)
        total = Add(total, 7)
        t8 = test_lists()
        p = t8
        passed = Add(passed, p)
        total = Add(total, 13)
        t9 = test_list_operations()
        p = t9
        passed = Add(passed, p)
        total = Add(total, 11)
        t10 = test_types()
        p = t10
        passed = Add(passed, p)
        total = Add(total, 9)
        t11 = test_strings()
        p = t11
        passed = Add(passed, p)
        total = Add(total, 3)
        t12 = test_builtins()
        p = t12
        passed = Add(passed, p)
        total = Add(total, 11)
        t13 = test_math()
        p = t13
        passed = Add(passed, p)
        total = Add(total, 5)
        t14 = test_complex_expressions()
        p = t14
        passed = Add(passed, p)
        total = Add(total, 5)
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("============================================================")
        PrintMessage("\n")
        PrintMessage("                    FINAL RESULTS")
        PrintMessage("\n")
        PrintMessage("============================================================")
        PrintMessage("\n")
        PrintMessage("Total Tests:")
        PrintMessage(" ")
        AIMacro.SmartPrint(total)
        PrintMessage("\n")
        PrintMessage("Passed:")
        PrintMessage(" ")
        AIMacro.SmartPrint(passed)
        PrintMessage("\n")
        failed = Subtract(total, passed)
        PrintMessage("Failed:")
        PrintMessage(" ")
        AIMacro.SmartPrint(failed)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        IfCondition EqualTo(passed, total) ThenBlock: {
            PrintMessage("*** ALL TESTS PASSED - FLOOR ESTABLISHED ***")
            PrintMessage("\n")
        } ElseBlock: {
            pct = Divide(Multiply(passed, 100), total)
            PrintMessage("Pass Rate:")
            PrintMessage(" ")
            AIMacro.SmartPrint(pct)
            PrintMessage(" ")
            PrintMessage("%")
            PrintMessage("\n")
            PrintMessage("*** SOME TESTS FAILED ***")
            PrintMessage("\n")
        }
        PrintMessage("============================================================")
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
