LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.assert_eq {
    Input: p_actual: Integer
    Input: p_expected: Integer
    Input: p_name: Integer
    Body: {
        t0 = AIMacro.NumEq(p_actual, p_expected)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            PrintMessage("  PASS:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_name)
            PrintMessage("\n")
            ReturnValue(1)
        } ElseBlock: {
            PrintMessage("  FAIL:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_name)
            PrintMessage("\n")
            ReturnValue(0)
        }
    }
}

Function.assert_true {
    Input: p_value: Integer
    Input: p_name: Integer
    Body: {
        t0 = assert_eq(p_value, 1, p_name)
        ReturnValue(t0)
    }
}

Function.test_for_in_list {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 1: For X In List ===")
        PrintMessage("\n")
        p = 0
        nums = Array.Create(3)
        Array.Push(nums, 10)
        Array.Push(nums, 20)
        Array.Push(nums, 30)
        total = 0
        iter0 = nums
        iterlen0 = AIMacro.IterLen(iter0)
        iteri0 = 0
        WhileLoop LessThan(iteri0, iterlen0) {
            x = AIMacro.IterGet(iter0, iteri0)
            total = AIMacro.NumAdd(total, x)
            iteri0 = Add(iteri0, 1)
        }
        t1 = assert_eq(total, 60, "for in list sum")
        t2 = AIMacro.NumAdd(p, t1)
        p = t2
        nums = Array.Create(5)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        Array.Push(nums, 3)
        Array.Push(nums, 4)
        Array.Push(nums, 5)
        doubled = Array.Create(0)
        iter3 = nums
        iterlen3 = AIMacro.IterLen(iter3)
        iteri3 = 0
        WhileLoop LessThan(iteri3, iterlen3) {
            x = AIMacro.IterGet(iter3, iteri3)
            AIMacro.SmartPush(doubled, AIMacro.NumMul(x, 2))
            iteri3 = Add(iteri3, 1)
        }
        t4 = AIMacro.SmartLen(doubled)
        t5 = assert_eq(t4, 5, "for in list append len")
        t6 = AIMacro.NumAdd(p, t5)
        p = t6
        t7 = DictGen_SmartGet(doubled, 0)
        t8 = assert_eq(t7, 2, "doubled[0]")
        t9 = AIMacro.NumAdd(p, t8)
        p = t9
        t10 = DictGen_SmartGet(doubled, 4)
        t11 = assert_eq(t10, 10, "doubled[4]")
        t12 = AIMacro.NumAdd(p, t11)
        p = t12
        result = 0
        outer = Array.Create(2)
        Array.Push(outer, 1)
        Array.Push(outer, 2)
        inner = Array.Create(2)
        Array.Push(inner, 10)
        Array.Push(inner, 20)
        iter13 = outer
        iterlen13 = AIMacro.IterLen(iter13)
        iteri13 = 0
        WhileLoop LessThan(iteri13, iterlen13) {
            a = AIMacro.IterGet(iter13, iteri13)
            iter14 = inner
            iterlen14 = AIMacro.IterLen(iter14)
            iteri14 = 0
            WhileLoop LessThan(iteri14, iterlen14) {
                b = AIMacro.IterGet(iter14, iteri14)
                result = AIMacro.NumAdd(result, AIMacro.NumMul(a, b))
                iteri14 = Add(iteri14, 1)
            }
            iteri13 = Add(iteri13, 1)
        }
        t15 = assert_eq(result, 90, "nested for in list")
        t16 = AIMacro.NumAdd(p, t15)
        p = t16
        PrintMessage("For in list:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 5")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_string_conversion {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 2: String Conversion ===")
        PrintMessage("\n")
        p = 0
        t0 = AIMacro.Int("123")
        x = t0
        t1 = assert_eq(x, 123, "int 123")
        t2 = AIMacro.NumAdd(p, t1)
        p = t2
        t3 = AIMacro.Int("0")
        x = t3
        t4 = assert_eq(x, 0, "int 0")
        t5 = AIMacro.NumAdd(p, t4)
        p = t5
        t6 = AIMacro.Int("999")
        x = t6
        t7 = assert_eq(x, 999, "int 999")
        t8 = AIMacro.NumAdd(p, t7)
        p = t8
        s = AIMacro.Str(42)
        t9 = DictGen_SmartLen(s)
        t10 = assert_eq(t9, 2, "str 42 len")
        t11 = AIMacro.NumAdd(p, t10)
        p = t11
        t12 = AIMacro.IsInstance(s, TypeID.STR)
        t13 = assert_true(t12, "str 42 is str")
        t14 = AIMacro.NumAdd(p, t13)
        p = t14
        s = AIMacro.Str(0)
        t15 = DictGen_SmartLen(s)
        t16 = assert_eq(t15, 1, "str 0 len")
        t17 = AIMacro.NumAdd(p, t16)
        p = t17
        s = AIMacro.Str(12345)
        t18 = DictGen_SmartLen(s)
        t19 = assert_eq(t18, 5, "str 12345 len")
        t20 = AIMacro.NumAdd(p, t19)
        p = t20
        PrintMessage("String conversion:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 7")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_string_concat {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 3: String Concatenation ===")
        PrintMessage("\n")
        p = 0
        a = "hello"
        b = "world"
        t0 = String.Concat(a, b)
        c = t0
        t1 = DictGen_SmartLen(c)
        t2 = assert_eq(t1, 10, "concat len")
        t3 = AIMacro.NumAdd(p, t2)
        p = t3
        t4 = AIMacro.IsInstance(c, TypeID.STR)
        t5 = assert_true(t4, "concat is str")
        t6 = AIMacro.NumAdd(p, t5)
        p = t6
        t7 = String.Concat(a, " ")
        t8 = String.Concat(t7, b)
        c = t8
        t9 = DictGen_SmartLen(c)
        t10 = assert_eq(t9, 11, "concat space len")
        t11 = AIMacro.NumAdd(p, t10)
        p = t11
        t12 = String.Concat("", "test")
        c = t12
        t13 = DictGen_SmartLen(c)
        t14 = assert_eq(t13, 4, "empty plus str")
        t15 = AIMacro.NumAdd(p, t14)
        p = t15
        t16 = String.Concat("test", "")
        c = t16
        t17 = DictGen_SmartLen(c)
        t18 = assert_eq(t17, 4, "str plus empty")
        t19 = AIMacro.NumAdd(p, t18)
        p = t19
        PrintMessage("String concat:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 5")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.main {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("============================================================")
        PrintMessage("\n")
        PrintMessage("   AIMACRO FLOOR TEST 2 - EXTENDED FEATURES")
        PrintMessage("\n")
        PrintMessage("============================================================")
        PrintMessage("\n")
        total = 0
        passed = 0
        t0 = test_for_in_list()
        p = t0
        passed = AIMacro.NumAdd(passed, p)
        total = AIMacro.NumAdd(total, 5)
        t1 = test_string_conversion()
        p = t1
        passed = AIMacro.NumAdd(passed, p)
        total = AIMacro.NumAdd(total, 7)
        t2 = test_string_concat()
        p = t2
        passed = AIMacro.NumAdd(passed, p)
        total = AIMacro.NumAdd(total, 5)
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("============================================================")
        PrintMessage("\n")
        PrintMessage("                    FINAL RESULTS")
        PrintMessage("\n")
        PrintMessage("============================================================")
        PrintMessage("\n")
        PrintMessage("Total Tests:")
        PrintMessage(" ")
        AIMacro.SmartPrint(total)
        PrintMessage("\n")
        PrintMessage("Passed:")
        PrintMessage(" ")
        AIMacro.SmartPrint(passed)
        PrintMessage("\n")
        failed = AIMacro.NumSub(total, passed)
        PrintMessage("Failed:")
        PrintMessage(" ")
        AIMacro.SmartPrint(failed)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        t3 = AIMacro.NumEq(passed, total)
        IfCondition AIMacro.SmartBool(t3) ThenBlock: {
            PrintMessage("*** ALL EXTENDED TESTS PASSED ***")
            PrintMessage("\n")
        } ElseBlock: {
            pct = AIMacro.TrueDiv(AIMacro.NumMul(passed, 100), total)
            PrintMessage("Pass Rate:")
            PrintMessage(" ")
            AIMacro.SmartPrint(pct)
            PrintMessage(" ")
            PrintMessage("%")
            PrintMessage("\n")
            PrintMessage("*** SOME TESTS FAILED ***")
            PrintMessage("\n")
        }
        PrintMessage("============================================================")
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
