LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.factorial {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 1) ThenBlock: {
            ReturnValue(1)
        }
        t0 = Subtract(p_n, 1)
        t1 = factorial(t0)
        t2 = Multiply(p_n, t1)
        ReturnValue(t2)
    }
}

Function.fib {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(p_n, 1) ThenBlock: {
            ReturnValue(1)
        }
        t0 = Subtract(p_n, 1)
        t1 = fib(t0)
        t2 = Subtract(p_n, 2)
        t3 = fib(t2)
        t4 = Add(t1, t3)
        ReturnValue(t4)
    }
}

Function.ackermann {
    Input: p_m: Integer
    Input: p_n: Integer
    Body: {
        IfCondition EqualTo(p_m, 0) ThenBlock: {
            t0 = Add(p_n, 1)
            ReturnValue(t0)
        }
        IfCondition EqualTo(p_n, 0) ThenBlock: {
            t1 = Subtract(p_m, 1)
            t2 = ackermann(t1, 1)
            ReturnValue(t2)
        }
        t3 = Subtract(p_m, 1)
        t4 = Subtract(p_n, 1)
        t5 = ackermann(p_m, t4)
        t6 = ackermann(t3, t5)
        ReturnValue(t6)
    }
}

Function.gcd {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        WhileLoop EqualTo(1, 1) {
            IfCondition Not(NotEqual(p_b, 0)) ThenBlock: {
                BreakLoop
            }
            temp = p_b
            p_b = Modulo(p_a, p_b)
            p_a = temp
        }
        ReturnValue(p_a)
    }
}

Function.power {
    Input: p_base: Integer
    Input: p_exp: Integer
    Body: {
        IfCondition EqualTo(p_exp, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Modulo(p_exp, 2), 0) ThenBlock: {
            t0 = Divide(p_exp, 2)
            t1 = power(p_base, t0)
            half = t1
            t2 = Multiply(half, half)
            ReturnValue(t2)
        }
        t3 = Subtract(p_exp, 1)
        t4 = power(p_base, t3)
        t5 = Multiply(p_base, t4)
        ReturnValue(t5)
    }
}

Function.test_arrays {
    Body: {
        PrintMessage("--- ARRAY TESTS ---")
        PrintMessage("\n")
        arr = Array.Create(10)
        Array.Push(arr, 64)
        Array.Push(arr, 34)
        Array.Push(arr, 25)
        Array.Push(arr, 12)
        Array.Push(arr, 22)
        Array.Push(arr, 11)
        Array.Push(arr, 90)
        Array.Push(arr, 42)
        Array.Push(arr, 15)
        Array.Push(arr, 77)
        total = 0
        lc0 = 0
        ls0 = 10
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            t1 = DictGen_SmartGet(arr, i)
            total = Add(total, t1)
        }
        PrintMessage("Sum:")
        PrintMessage(" ")
        AIMacro.SmartPrint(total)
        PrintMessage("\n")
        t2 = DictGen_SmartGet(arr, 0)
        max_val = t2
        lc3 = 1
        ls3 = 10
        lt3 = 1
        WhileLoop LessThan(lc3, ls3) {
            i = lc3
            lc3 = Add(lc3, lt3)
            t4 = DictGen_SmartGet(arr, i)
            IfCondition GreaterThan(t4, max_val) ThenBlock: {
                t5 = DictGen_SmartGet(arr, i)
                max_val = t5
            }
        }
        PrintMessage("Max:")
        PrintMessage(" ")
        AIMacro.SmartPrint(max_val)
        PrintMessage("\n")
        t6 = DictGen_SmartGet(arr, 0)
        min_val = t6
        lc7 = 1
        ls7 = 10
        lt7 = 1
        WhileLoop LessThan(lc7, ls7) {
            i = lc7
            lc7 = Add(lc7, lt7)
            t8 = DictGen_SmartGet(arr, i)
            IfCondition LessThan(t8, min_val) ThenBlock: {
                t9 = DictGen_SmartGet(arr, i)
                min_val = t9
            }
        }
        PrintMessage("Min:")
        PrintMessage(" ")
        AIMacro.SmartPrint(min_val)
        PrintMessage("\n")
        target = 42
        found = Subtract(0, 1)
        lc10 = 0
        ls10 = 10
        lt10 = 1
        WhileLoop LessThan(lc10, ls10) {
            i = lc10
            lc10 = Add(lc10, lt10)
            t11 = DictGen_SmartGet(arr, i)
            IfCondition EqualTo(t11, target) ThenBlock: {
                found = i
                BreakLoop
            }
        }
        PrintMessage("Index of 42:")
        PrintMessage(" ")
        AIMacro.SmartPrint(found)
        PrintMessage("\n")
        lc12 = 0
        ls12 = 9
        lt12 = 1
        WhileLoop LessThan(lc12, ls12) {
            i = lc12
            lc12 = Add(lc12, lt12)
            lc13 = 0
            ls13 = Subtract(9, i)
            lt13 = 1
            WhileLoop LessThan(lc13, ls13) {
                j = lc13
                lc13 = Add(lc13, lt13)
                t14 = DictGen_SmartGet(arr, j)
                t15 = DictGen_SmartGet(arr, Add(j, 1))
                IfCondition GreaterThan(t14, t15) ThenBlock: {
                    t16 = DictGen_SmartGet(arr, j)
                    temp = t16
                    t17 = Add(j, 1)
                    t18 = DictGen_SmartGet(arr, t17)
                    DictGen_SmartSet(arr, j, t18)
                    DictGen_SmartSet(arr, Add(j, 1), temp)
                }
            }
        }
        t19 = DictGen_SmartGet(arr, 0)
        PrintMessage("After sort, first:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t19)
        PrintMessage("\n")
        t20 = DictGen_SmartGet(arr, 9)
        PrintMessage("After sort, last:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t20)
        PrintMessage("\n")
    }
}

Function.test_strings {
    Body: {
        PrintMessage("--- STRING TESTS ---")
        PrintMessage("\n")
        line = String.Repeat("=", 30)
        AIMacro.SmartPrint(line)
        PrintMessage("\n")
        msg = "Hello World"
        PrintMessage("Original:")
        PrintMessage(" ")
        AIMacro.SmartPrint(msg)
        PrintMessage("\n")
        t0 = String.Upper(msg)
        PrintMessage("Upper:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = String.Lower(msg)
        PrintMessage("Lower:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        padded = "   trimmed   "
        t2 = String.Strip(padded)
        PrintMessage("Stripped:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        text = "the quick brown fox"
        pos = String.Find(text, "quick")
        PrintMessage("Find quick:")
        PrintMessage(" ")
        AIMacro.SmartPrint(pos)
        PrintMessage("\n")
        filename = "report.txt"
        IfCondition String.EndsWith(filename, ".txt") ThenBlock: {
            PrintMessage("Is text file: YES")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("Is text file: NO")
            PrintMessage("\n")
        }
        original = "hello world"
        replaced = String.Replace(original, "world", "AILang")
        PrintMessage("Replaced:")
        PrintMessage(" ")
        AIMacro.SmartPrint(replaced)
        PrintMessage("\n")
        banana = "banana"
        count = String.Count(banana, "a")
        PrintMessage("Count of 'a' in banana:")
        PrintMessage(" ")
        AIMacro.SmartPrint(count)
        PrintMessage("\n")
                t3 = String.Repeat("=", 30)
AIMacro.SmartPrint(t3)
        PrintMessage("\n")
    }
}

Function.test_control_flow {
    Body: {
        PrintMessage("--- CONTROL FLOW TESTS ---")
        PrintMessage("\n")
        lc0 = 0
        ls0 = 4
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            x = lc0
            lc0 = Add(lc0, lt0)
            IfCondition EqualTo(x, 0) ThenBlock: {
                PrintMessage("zero")
                PrintMessage("\n")
            } ElseBlock: {
                IfCondition EqualTo(x, 1) ThenBlock: {
                    PrintMessage("one")
                    PrintMessage("\n")
                } ElseBlock: {
                    IfCondition EqualTo(x, 2) ThenBlock: {
                        PrintMessage("two")
                        PrintMessage("\n")
                    } ElseBlock: {
                        PrintMessage("three")
                        PrintMessage("\n")
                    }
                }
            }
        }
        PrintMessage("Break test:")
        PrintMessage("\n")
        found_i = Subtract(0, 1)
        found_j = Subtract(0, 1)
        lc1 = 0
        ls1 = 5
        lt1 = 1
        WhileLoop LessThan(lc1, ls1) {
            i = lc1
            lc1 = Add(lc1, lt1)
            lc2 = 0
            ls2 = 5
            lt2 = 1
            WhileLoop LessThan(lc2, ls2) {
                j = lc2
                lc2 = Add(lc2, lt2)
                IfCondition EqualTo(Multiply(i, j), 6) ThenBlock: {
                    found_i = i
                    found_j = j
                    BreakLoop
                }
            }
            IfCondition GreaterEqual(found_i, 0) ThenBlock: {
                BreakLoop
            }
        }
        PrintMessage("Found i*j=6 at i=")
        PrintMessage(" ")
        AIMacro.SmartPrint(found_i)
        PrintMessage(" ")
        PrintMessage("j=")
        PrintMessage(" ")
        AIMacro.SmartPrint(found_j)
        PrintMessage("\n")
        PrintMessage("Odd numbers 1-10:")
        PrintMessage("\n")
        lc3 = 1
        ls3 = 11
        lt3 = 1
        WhileLoop LessThan(lc3, ls3) {
            i = lc3
            lc3 = Add(lc3, lt3)
            IfCondition EqualTo(Modulo(i, 2), 0) ThenBlock: {
                ContinueLoop
            }
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
        a = 5
        b = 10
        c = 15
        IfCondition Or(And(LessThan(a, b), LessThan(b, c)), LessThan(c, 0)) ThenBlock: {
            PrintMessage("Complex condition: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("Complex condition: FALSE")
            PrintMessage("\n")
        }
    }
}

Function.is_prime {
    Input: p_n: Integer
    Body: {
        IfCondition LessThan(p_n, 2) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(p_n, 2) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Modulo(p_n, 2), 0) ThenBlock: {
            ReturnValue(0)
        }
        i = 3
        WhileLoop LessEqual(Multiply(i, i), p_n) {
            IfCondition EqualTo(Modulo(p_n, i), 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 2)
        }
        ReturnValue(1)
    }
}

Function.integer_sqrt {
    Input: p_n: Integer
    Body: {
        IfCondition LessThan(p_n, 2) ThenBlock: {
            ReturnValue(p_n)
        }
        x = p_n
        y = Divide(Add(x, 1), 2)
        WhileLoop LessThan(y, x) {
            x = y
            y = Divide(Add(x, Divide(p_n, x)), 2)
        }
        ReturnValue(x)
    }
}

Function.sum_digits {
    Input: p_n: Integer
    Body: {
        total = 0
        WhileLoop GreaterThan(p_n, 0) {
            total = Add(total, Modulo(p_n, 10))
            p_n = Divide(p_n, 10)
        }
        ReturnValue(total)
    }
}

Function.reverse_number {
    Input: p_n: Integer
    Body: {
        rev = 0
        WhileLoop GreaterThan(p_n, 0) {
            rev = Add(Multiply(rev, 10), Modulo(p_n, 10))
            p_n = Divide(p_n, 10)
        }
        ReturnValue(rev)
    }
}

Function.test_math {
    Body: {
        PrintMessage("--- MATH TESTS ---")
        PrintMessage("\n")
        t0 = factorial(5)
        PrintMessage("5! =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = factorial(10)
        PrintMessage("10! =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = fib(10)
        PrintMessage("fib(10) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = ackermann(3, 2)
        PrintMessage("ack(3,2) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = gcd(48, 18)
        PrintMessage("gcd(48, 18) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        t5 = power(2, 10)
        PrintMessage("2^10 =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = integer_sqrt(144)
        PrintMessage("sqrt(144) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        t7 = sum_digits(12345)
        PrintMessage("sum_digits(12345) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        t8 = reverse_number(12345)
        PrintMessage("reverse(12345) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        PrintMessage("Primes under 30:")
        PrintMessage("\n")
        lc9 = 2
        ls9 = 30
        lt9 = 1
        WhileLoop LessThan(lc9, ls9) {
            n = lc9
            lc9 = Add(lc9, lt9)
            t10 = is_prime(n)
            IfCondition EqualTo(t10, 1) ThenBlock: {
                AIMacro.SmartPrint(n)
                PrintMessage("\n")
            }
        }
    }
}

Function.add {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        t0 = Add(p_a, p_b)
        ReturnValue(t0)
    }
}

Function.multiply {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        t0 = Multiply(p_a, p_b)
        ReturnValue(t0)
    }
}

Function.apply_twice {
    Input: p_x: Integer
    Input: p_op: Integer
    Body: {
        IfCondition EqualTo(p_op, 1) ThenBlock: {
            t0 = add(p_x, p_x)
            ReturnValue(t0)
        } ElseBlock: {
            t1 = multiply(p_x, p_x)
            ReturnValue(t1)
        }
    }
}

Function.nested_calls_test {
    Body: {
        PrintMessage("--- NESTED CALL TESTS ---")
        PrintMessage("\n")
        t0 = multiply(2, 3)
        t1 = multiply(4, 5)
        t2 = add(t0, t1)
        result = t2
        PrintMessage("2*3 + 4*5 =")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        t3 = add(1, 2)
        t4 = add(3, 4)
        t5 = add(t3, t4)
        t6 = add(5, 6)
        t7 = add(7, 8)
        t8 = add(t6, t7)
        t9 = add(t5, t8)
        result = t9
        PrintMessage("((1+2)+(3+4))+((5+6)+(7+8)) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        t10 = add(2, 3)
        t11 = multiply(1, 4)
        IfCondition GreaterThan(t10, t11) ThenBlock: {
            PrintMessage("2+3 > 1*4: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("2+3 > 1*4: FALSE")
            PrintMessage("\n")
        }
        t12 = factorial(3)
        t13 = factorial(4)
        t14 = Add(t12, t13)
        result = t14
        PrintMessage("3! + 4! =")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
    }
}

Function.test_edge_cases {
    Body: {
        PrintMessage("--- EDGE CASE TESTS ---")
        PrintMessage("\n")
        t0 = factorial(0)
        PrintMessage("factorial(0) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = fib(0)
        PrintMessage("fib(0) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = fib(1)
        PrintMessage("fib(1) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        count = 0
        lc3 = 0
        ls3 = 0
        lt3 = 1
        WhileLoop LessThan(lc3, ls3) {
            i = lc3
            lc3 = Add(lc3, lt3)
            count = Add(count, 1)
        }
        PrintMessage("Empty range loop count:")
        PrintMessage(" ")
        AIMacro.SmartPrint(count)
        PrintMessage("\n")
        count = 0
        lc4 = 0
        ls4 = 1
        lt4 = 1
        WhileLoop LessThan(lc4, ls4) {
            i = lc4
            lc4 = Add(lc4, lt4)
            count = Add(count, 1)
        }
        PrintMessage("Single iteration count:")
        PrintMessage(" ")
        AIMacro.SmartPrint(count)
        PrintMessage("\n")
        big = 1000000
        PrintMessage("Million:")
        PrintMessage(" ")
        AIMacro.SmartPrint(big)
        PrintMessage("\n")
        PrintMessage("Million * 2:")
        PrintMessage(" ")
        AIMacro.SmartPrint(Multiply(big, 2))
        PrintMessage("\n")
        x = 1
        x = Add(x, 2)
        x = Multiply(x, 3)
        x = Subtract(x, 1)
        PrintMessage("1+2=3, 3*3=9, 9-1 =")
        PrintMessage(" ")
        AIMacro.SmartPrint(x)
        PrintMessage("\n")
        a = 5
        b = 10
        c = 15
        IfCondition LessThan(a, b) ThenBlock: {
            IfCondition LessThan(b, c) ThenBlock: {
                PrintMessage("a < b < c: TRUE")
                PrintMessage("\n")
            }
        }
    }
}

Function.test_while_variations {
    Body: {
        PrintMessage("--- WHILE LOOP TESTS ---")
        PrintMessage("\n")
        i = 0
        WhileLoop LessThan(i, 5) {
            PrintMessage("Up:")
            PrintMessage(" ")
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
            i = Add(i, 1)
        }
        i = 5
        WhileLoop GreaterThan(i, 0) {
            i = Subtract(i, 1)
            PrintMessage("Down:")
            PrintMessage(" ")
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
        x = 0
        y = 10
        WhileLoop And(LessThan(x, 5), GreaterThan(y, 5)) {
            PrintMessage("x=")
            PrintMessage(" ")
            AIMacro.SmartPrint(x)
            PrintMessage(" ")
            PrintMessage("y=")
            PrintMessage(" ")
            AIMacro.SmartPrint(y)
            PrintMessage("\n")
            x = Add(x, 1)
            y = Subtract(y, 1)
        }
        i = 0
        WhileLoop LessThan(i, 100) {
            IfCondition GreaterThan(Multiply(i, i), 50) ThenBlock: {
                PrintMessage("First square > 50:")
                PrintMessage(" ")
                AIMacro.SmartPrint(Multiply(i, i))
                PrintMessage("\n")
                BreakLoop
            }
            i = Add(i, 1)
        }
    }
}

SubRoutine.Main {
                t0 = String.Repeat("=", 60)
AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("COMPREHENSIVE AIMACRO TEST SUITE")
        PrintMessage("\n")
                t1 = String.Repeat("=", 60)
AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        test_math()
        PrintMessage("")
        PrintMessage("\n")
        test_arrays()
        PrintMessage("")
        PrintMessage("\n")
        test_strings()
        PrintMessage("")
        PrintMessage("\n")
        test_control_flow()
        PrintMessage("")
        PrintMessage("\n")
        nested_calls_test()
        PrintMessage("")
        PrintMessage("\n")
        test_edge_cases()
        PrintMessage("")
        PrintMessage("\n")
        test_while_variations()
        PrintMessage("")
        PrintMessage("\n")
                t2 = String.Repeat("=", 60)
AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        PrintMessage("ALL TESTS COMPLETE!")
        PrintMessage("\n")
        PrintMessage("If you see this, the transpiler is ready for real code.")
        PrintMessage("\n")
                t3 = String.Repeat("=", 60)
AIMacro.SmartPrint(t3)
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
