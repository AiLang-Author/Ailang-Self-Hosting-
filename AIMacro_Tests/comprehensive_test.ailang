LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.factorial {
    Input: p_n: Integer
    Body: {
        IfCondition AIMacro.SmartBool(AIMacro.NumLe(p_n, 1)) ThenBlock: {
            ReturnValue(1)
        }
        t0 = AIMacro.NumSub(p_n, 1)
        t1 = factorial(t0)
        t2 = AIMacro.NumMul(p_n, t1)
        ReturnValue(t2)
    }
}

Function.fib {
    Input: p_n: Integer
    Body: {
        IfCondition AIMacro.SmartBool(AIMacro.NumLe(p_n, 0)) ThenBlock: {
            ReturnValue(0)
        }
        t0 = AIMacro.NumEq(p_n, 1)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            ReturnValue(1)
        }
        t1 = AIMacro.NumSub(p_n, 1)
        t2 = fib(t1)
        t3 = AIMacro.NumSub(p_n, 2)
        t4 = fib(t3)
        t5 = AIMacro.NumAdd(t2, t4)
        ReturnValue(t5)
    }
}

Function.ackermann {
    Input: p_m: Integer
    Input: p_n: Integer
    Body: {
        t0 = AIMacro.NumEq(p_m, 0)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            t1 = AIMacro.NumAdd(p_n, 1)
            ReturnValue(t1)
        }
        t2 = AIMacro.NumEq(p_n, 0)
        IfCondition AIMacro.SmartBool(t2) ThenBlock: {
            t3 = AIMacro.NumSub(p_m, 1)
            t4 = ackermann(t3, 1)
            ReturnValue(t4)
        }
        t5 = AIMacro.NumSub(p_m, 1)
        t6 = AIMacro.NumSub(p_n, 1)
        t7 = ackermann(p_m, t6)
        t8 = ackermann(t5, t7)
        ReturnValue(t8)
    }
}

Function.gcd {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        WhileLoop EqualTo(1, 1) {
            t0 = AIMacro.NumNe(p_b, 0)
            IfCondition Not(AIMacro.SmartBool(t0)) ThenBlock: {
                BreakLoop
            }
            temp = p_b
            p_b = AIMacro.NumMod(p_a, p_b)
            p_a = temp
        }
        ReturnValue(p_a)
    }
}

Function.power {
    Input: p_base: Integer
    Input: p_exp: Integer
    Body: {
        t0 = AIMacro.NumEq(p_exp, 0)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            ReturnValue(1)
        }
        t1 = AIMacro.NumMod(p_exp, 2)
        t2 = AIMacro.NumEq(t1, 0)
        IfCondition AIMacro.SmartBool(t2) ThenBlock: {
            t3 = AIMacro.FloorDiv(p_exp, 2)
            t4 = power(p_base, t3)
            half = t4
            t5 = AIMacro.NumMul(half, half)
            ReturnValue(t5)
        }
        t6 = AIMacro.NumSub(p_exp, 1)
        t7 = power(p_base, t6)
        t8 = AIMacro.NumMul(p_base, t7)
        ReturnValue(t8)
    }
}

Function.test_arrays {
    Body: {
        PrintMessage("--- ARRAY TESTS ---")
        PrintMessage("\n")
        arr = Array.Create(10)
        Array.Push(arr, 64)
        Array.Push(arr, 34)
        Array.Push(arr, 25)
        Array.Push(arr, 12)
        Array.Push(arr, 22)
        Array.Push(arr, 11)
        Array.Push(arr, 90)
        Array.Push(arr, 42)
        Array.Push(arr, 15)
        Array.Push(arr, 77)
        total = 0
        lc0 = 0
        ls0 = 10
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            t1 = DictGen_SmartGet(arr, i)
            total = AIMacro.NumAdd(total, t1)
        }
        PrintMessage("Sum:")
        PrintMessage(" ")
        AIMacro.SmartPrint(total)
        PrintMessage("\n")
        t2 = DictGen_SmartGet(arr, 0)
        max_val = t2
        lc3 = 1
        ls3 = 10
        lt3 = 1
        WhileLoop LessThan(lc3, ls3) {
            i = lc3
            lc3 = Add(lc3, lt3)
            t4 = DictGen_SmartGet(arr, i)
            t5 = AIMacro.NumGt(t4, max_val)
            IfCondition AIMacro.SmartBool(t5) ThenBlock: {
                t6 = DictGen_SmartGet(arr, i)
                max_val = t6
            }
        }
        PrintMessage("Max:")
        PrintMessage(" ")
        AIMacro.SmartPrint(max_val)
        PrintMessage("\n")
        t7 = DictGen_SmartGet(arr, 0)
        min_val = t7
        lc8 = 1
        ls8 = 10
        lt8 = 1
        WhileLoop LessThan(lc8, ls8) {
            i = lc8
            lc8 = Add(lc8, lt8)
            t9 = DictGen_SmartGet(arr, i)
            t10 = AIMacro.NumLt(t9, min_val)
            IfCondition AIMacro.SmartBool(t10) ThenBlock: {
                t11 = DictGen_SmartGet(arr, i)
                min_val = t11
            }
        }
        PrintMessage("Min:")
        PrintMessage(" ")
        AIMacro.SmartPrint(min_val)
        PrintMessage("\n")
        target = 42
        found = AIMacro.NumNeg(1)
        lc12 = 0
        ls12 = 10
        lt12 = 1
        WhileLoop LessThan(lc12, ls12) {
            i = lc12
            lc12 = Add(lc12, lt12)
            t13 = DictGen_SmartGet(arr, i)
            t14 = AIMacro.NumEq(t13, target)
            IfCondition AIMacro.SmartBool(t14) ThenBlock: {
                found = i
                BreakLoop
            }
        }
        PrintMessage("Index of 42:")
        PrintMessage(" ")
        AIMacro.SmartPrint(found)
        PrintMessage("\n")
        lc15 = 0
        ls15 = 9
        lt15 = 1
        WhileLoop LessThan(lc15, ls15) {
            i = lc15
            lc15 = Add(lc15, lt15)
            lc16 = 0
            ls16 = AIMacro.NumSub(9, i)
            lt16 = 1
            WhileLoop LessThan(lc16, ls16) {
                j = lc16
                lc16 = Add(lc16, lt16)
                t17 = DictGen_SmartGet(arr, j)
                t18 = AIMacro.NumAdd(j, 1)
                t19 = DictGen_SmartGet(arr, t18)
                t20 = AIMacro.NumGt(t17, t19)
                IfCondition AIMacro.SmartBool(t20) ThenBlock: {
                    t21 = DictGen_SmartGet(arr, j)
                    temp = t21
                    t22 = AIMacro.NumAdd(j, 1)
                    t23 = DictGen_SmartGet(arr, t22)
                    DictGen_SmartSet(arr, j, t23)
                    DictGen_SmartSet(arr, AIMacro.NumAdd(j, 1), temp)
                }
            }
        }
        t24 = DictGen_SmartGet(arr, 0)
        PrintMessage("After sort, first:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t24)
        PrintMessage("\n")
        t25 = DictGen_SmartGet(arr, 9)
        PrintMessage("After sort, last:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t25)
        PrintMessage("\n")
    }
}

Function.test_strings {
    Body: {
        PrintMessage("--- STRING TESTS ---")
        PrintMessage("\n")
        line = String.Repeat("=", AIMacro.Int(30))
        AIMacro.SmartPrint(line)
        PrintMessage("\n")
        msg = "Hello World"
        PrintMessage("Original:")
        PrintMessage(" ")
        AIMacro.SmartPrint(msg)
        PrintMessage("\n")
        t0 = String.Upper(msg)
        PrintMessage("Upper:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = String.Lower(msg)
        PrintMessage("Lower:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        padded = "   trimmed   "
        t2 = String.Strip(padded)
        PrintMessage("Stripped:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        text = "the quick brown fox"
        pos = String.Find(text, "quick")
        PrintMessage("Find quick:")
        PrintMessage(" ")
        AIMacro.SmartPrint(pos)
        PrintMessage("\n")
        filename = "report.txt"
        t3 = String.EndsWith(filename, ".txt")
        IfCondition AIMacro.SmartBool(t3) ThenBlock: {
            PrintMessage("Is text file: YES")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("Is text file: NO")
            PrintMessage("\n")
        }
        original = "hello world"
        replaced = String.Replace(original, "world", "AILang")
        PrintMessage("Replaced:")
        PrintMessage(" ")
        AIMacro.SmartPrint(replaced)
        PrintMessage("\n")
        banana = "banana"
        count = String.Count(banana, "a")
        PrintMessage("Count of 'a' in banana:")
        PrintMessage(" ")
        AIMacro.SmartPrint(count)
        PrintMessage("\n")
                t4 = String.Repeat("=", AIMacro.Int(30))
AIMacro.SmartPrint(t4)
        PrintMessage("\n")
    }
}

Function.test_control_flow {
    Body: {
        PrintMessage("--- CONTROL FLOW TESTS ---")
        PrintMessage("\n")
        lc0 = 0
        ls0 = 4
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            x = lc0
            lc0 = Add(lc0, lt0)
            t1 = AIMacro.NumEq(x, 0)
            IfCondition AIMacro.SmartBool(t1) ThenBlock: {
                PrintMessage("zero")
                PrintMessage("\n")
            } ElseBlock: {
                t2 = AIMacro.NumEq(x, 1)
                IfCondition AIMacro.SmartBool(t2) ThenBlock: {
                    PrintMessage("one")
                    PrintMessage("\n")
                } ElseBlock: {
                    t3 = AIMacro.NumEq(x, 2)
                    IfCondition AIMacro.SmartBool(t3) ThenBlock: {
                        PrintMessage("two")
                        PrintMessage("\n")
                    } ElseBlock: {
                        PrintMessage("three")
                        PrintMessage("\n")
                    }
                }
            }
        }
        PrintMessage("Break test:")
        PrintMessage("\n")
        found_i = AIMacro.NumNeg(1)
        found_j = AIMacro.NumNeg(1)
        lc4 = 0
        ls4 = 5
        lt4 = 1
        WhileLoop LessThan(lc4, ls4) {
            i = lc4
            lc4 = Add(lc4, lt4)
            lc5 = 0
            ls5 = 5
            lt5 = 1
            WhileLoop LessThan(lc5, ls5) {
                j = lc5
                lc5 = Add(lc5, lt5)
                t6 = AIMacro.NumMul(i, j)
                t7 = AIMacro.NumEq(t6, 6)
                IfCondition AIMacro.SmartBool(t7) ThenBlock: {
                    found_i = i
                    found_j = j
                    BreakLoop
                }
            }
            IfCondition AIMacro.SmartBool(AIMacro.NumGe(found_i, 0)) ThenBlock: {
                BreakLoop
            }
        }
        PrintMessage("Found i*j=6 at i=")
        PrintMessage(" ")
        AIMacro.SmartPrint(found_i)
        PrintMessage(" ")
        PrintMessage("j=")
        PrintMessage(" ")
        AIMacro.SmartPrint(found_j)
        PrintMessage("\n")
        PrintMessage("Odd numbers 1-10:")
        PrintMessage("\n")
        lc8 = 1
        ls8 = 11
        lt8 = 1
        WhileLoop LessThan(lc8, ls8) {
            i = lc8
            lc8 = Add(lc8, lt8)
            t9 = AIMacro.NumMod(i, 2)
            t10 = AIMacro.NumEq(t9, 0)
            IfCondition AIMacro.SmartBool(t10) ThenBlock: {
                ContinueLoop
            }
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
        a = 5
        b = 10
        c = 15
        t11 = AIMacro.NumLt(a, b)
        t12 = t11
        IfCondition AIMacro.SmartBool(t12) ThenBlock: {
            t13 = AIMacro.NumLt(b, c)
            t12 = t13
        }
        t14 = t12
        IfCondition Not(AIMacro.SmartBool(t14)) ThenBlock: {
            t15 = AIMacro.NumLt(c, 0)
            t14 = t15
        }
        IfCondition AIMacro.SmartBool(t14) ThenBlock: {
            PrintMessage("Complex condition: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("Complex condition: FALSE")
            PrintMessage("\n")
        }
    }
}

Function.is_prime {
    Input: p_n: Integer
    Body: {
        IfCondition AIMacro.SmartBool(AIMacro.NumLt(p_n, 2)) ThenBlock: {
            ReturnValue(0)
        }
        t0 = AIMacro.NumEq(p_n, 2)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            ReturnValue(1)
        }
        t1 = AIMacro.NumMod(p_n, 2)
        t2 = AIMacro.NumEq(t1, 0)
        IfCondition AIMacro.SmartBool(t2) ThenBlock: {
            ReturnValue(0)
        }
        i = 3
        WhileLoop AIMacro.SmartBool(AIMacro.NumLe(AIMacro.NumMul(i, i), p_n)) {
            t3 = AIMacro.NumMod(p_n, i)
            t4 = AIMacro.NumEq(t3, 0)
            IfCondition AIMacro.SmartBool(t4) ThenBlock: {
                ReturnValue(0)
            }
            i = AIMacro.NumAdd(i, 2)
        }
        ReturnValue(1)
    }
}

Function.integer_sqrt {
    Input: p_n: Integer
    Body: {
        IfCondition AIMacro.SmartBool(AIMacro.NumLt(p_n, 2)) ThenBlock: {
            ReturnValue(p_n)
        }
        x = p_n
        y = AIMacro.FloorDiv(AIMacro.NumAdd(x, 1), 2)
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(y, x)) {
            x = y
            y = AIMacro.FloorDiv(AIMacro.NumAdd(x, AIMacro.FloorDiv(p_n, x)), 2)
        }
        ReturnValue(x)
    }
}

Function.sum_digits {
    Input: p_n: Integer
    Body: {
        total = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumGt(p_n, 0)) {
            total = AIMacro.NumAdd(total, AIMacro.NumMod(p_n, 10))
            p_n = AIMacro.FloorDiv(p_n, 10)
        }
        ReturnValue(total)
    }
}

Function.reverse_number {
    Input: p_n: Integer
    Body: {
        rev = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumGt(p_n, 0)) {
            rev = AIMacro.NumAdd(AIMacro.NumMul(rev, 10), AIMacro.NumMod(p_n, 10))
            p_n = AIMacro.FloorDiv(p_n, 10)
        }
        ReturnValue(rev)
    }
}

Function.test_math {
    Body: {
        PrintMessage("--- MATH TESTS ---")
        PrintMessage("\n")
        t0 = factorial(5)
        PrintMessage("5! =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = factorial(10)
        PrintMessage("10! =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = fib(10)
        PrintMessage("fib(10) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = ackermann(3, 2)
        PrintMessage("ack(3,2) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = gcd(48, 18)
        PrintMessage("gcd(48, 18) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        t5 = power(2, 10)
        PrintMessage("2^10 =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = integer_sqrt(144)
        PrintMessage("sqrt(144) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        t7 = sum_digits(12345)
        PrintMessage("sum_digits(12345) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        t8 = reverse_number(12345)
        PrintMessage("reverse(12345) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        PrintMessage("Primes under 30:")
        PrintMessage("\n")
        lc9 = 2
        ls9 = 30
        lt9 = 1
        WhileLoop LessThan(lc9, ls9) {
            n = lc9
            lc9 = Add(lc9, lt9)
            t10 = is_prime(n)
            t11 = AIMacro.NumEq(t10, 1)
            IfCondition AIMacro.SmartBool(t11) ThenBlock: {
                AIMacro.SmartPrint(n)
                PrintMessage("\n")
            }
        }
    }
}

Function.add {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        t0 = AIMacro.NumAdd(p_a, p_b)
        ReturnValue(t0)
    }
}

Function.multiply {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        t0 = AIMacro.NumMul(p_a, p_b)
        ReturnValue(t0)
    }
}

Function.apply_twice {
    Input: p_x: Integer
    Input: p_op: Integer
    Body: {
        t0 = AIMacro.NumEq(p_op, 1)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            t1 = add(p_x, p_x)
            ReturnValue(t1)
        } ElseBlock: {
            t2 = multiply(p_x, p_x)
            ReturnValue(t2)
        }
    }
}

Function.nested_calls_test {
    Body: {
        PrintMessage("--- NESTED CALL TESTS ---")
        PrintMessage("\n")
        t0 = multiply(2, 3)
        t1 = multiply(4, 5)
        t2 = add(t0, t1)
        result = t2
        PrintMessage("2*3 + 4*5 =")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        t3 = add(1, 2)
        t4 = add(3, 4)
        t5 = add(t3, t4)
        t6 = add(5, 6)
        t7 = add(7, 8)
        t8 = add(t6, t7)
        t9 = add(t5, t8)
        result = t9
        PrintMessage("((1+2)+(3+4))+((5+6)+(7+8)) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        t10 = add(2, 3)
        t11 = multiply(1, 4)
        t12 = AIMacro.NumGt(t10, t11)
        IfCondition AIMacro.SmartBool(t12) ThenBlock: {
            PrintMessage("2+3 > 1*4: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("2+3 > 1*4: FALSE")
            PrintMessage("\n")
        }
        t13 = factorial(3)
        t14 = factorial(4)
        t15 = AIMacro.NumAdd(t13, t14)
        result = t15
        PrintMessage("3! + 4! =")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
    }
}

Function.test_edge_cases {
    Body: {
        PrintMessage("--- EDGE CASE TESTS ---")
        PrintMessage("\n")
        t0 = factorial(0)
        PrintMessage("factorial(0) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = fib(0)
        PrintMessage("fib(0) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = fib(1)
        PrintMessage("fib(1) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        count = 0
        lc3 = 0
        ls3 = 0
        lt3 = 1
        WhileLoop LessThan(lc3, ls3) {
            i = lc3
            lc3 = Add(lc3, lt3)
            count = AIMacro.NumAdd(count, 1)
        }
        PrintMessage("Empty range loop count:")
        PrintMessage(" ")
        AIMacro.SmartPrint(count)
        PrintMessage("\n")
        count = 0
        lc4 = 0
        ls4 = 1
        lt4 = 1
        WhileLoop LessThan(lc4, ls4) {
            i = lc4
            lc4 = Add(lc4, lt4)
            count = AIMacro.NumAdd(count, 1)
        }
        PrintMessage("Single iteration count:")
        PrintMessage(" ")
        AIMacro.SmartPrint(count)
        PrintMessage("\n")
        big = 1000000
        PrintMessage("Million:")
        PrintMessage(" ")
        AIMacro.SmartPrint(big)
        PrintMessage("\n")
        PrintMessage("Million * 2:")
        PrintMessage(" ")
        AIMacro.SmartPrint(AIMacro.NumMul(big, 2))
        PrintMessage("\n")
        x = 1
        x = AIMacro.NumAdd(x, 2)
        x = AIMacro.NumMul(x, 3)
        x = AIMacro.NumSub(x, 1)
        PrintMessage("1+2=3, 3*3=9, 9-1 =")
        PrintMessage(" ")
        AIMacro.SmartPrint(x)
        PrintMessage("\n")
        a = 5
        b = 10
        c = 15
        IfCondition AIMacro.SmartBool(AIMacro.NumLt(a, b)) ThenBlock: {
            IfCondition AIMacro.SmartBool(AIMacro.NumLt(b, c)) ThenBlock: {
                PrintMessage("a < b < c: TRUE")
                PrintMessage("\n")
            }
        }
    }
}

Function.test_while_variations {
    Body: {
        PrintMessage("--- WHILE LOOP TESTS ---")
        PrintMessage("\n")
        i = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(i, 5)) {
            PrintMessage("Up:")
            PrintMessage(" ")
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
            i = AIMacro.NumAdd(i, 1)
        }
        i = 5
        WhileLoop AIMacro.SmartBool(AIMacro.NumGt(i, 0)) {
            i = AIMacro.NumSub(i, 1)
            PrintMessage("Down:")
            PrintMessage(" ")
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
        x = 0
        y = 10
        WhileLoop EqualTo(1, 1) {
            t0 = AIMacro.NumLt(x, 5)
            t1 = t0
            IfCondition AIMacro.SmartBool(t1) ThenBlock: {
                t2 = AIMacro.NumGt(y, 5)
                t1 = t2
            }
            IfCondition Not(AIMacro.SmartBool(t1)) ThenBlock: {
                BreakLoop
            }
            PrintMessage("x=")
            PrintMessage(" ")
            AIMacro.SmartPrint(x)
            PrintMessage(" ")
            PrintMessage("y=")
            PrintMessage(" ")
            AIMacro.SmartPrint(y)
            PrintMessage("\n")
            x = AIMacro.NumAdd(x, 1)
            y = AIMacro.NumSub(y, 1)
        }
        i = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(i, 100)) {
            IfCondition AIMacro.SmartBool(AIMacro.NumGt(AIMacro.NumMul(i, i), 50)) ThenBlock: {
                PrintMessage("First square > 50:")
                PrintMessage(" ")
                AIMacro.SmartPrint(AIMacro.NumMul(i, i))
                PrintMessage("\n")
                BreakLoop
            }
            i = AIMacro.NumAdd(i, 1)
        }
    }
}

Function.main {
    Body: {
                t0 = String.Repeat("=", AIMacro.Int(60))
AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("COMPREHENSIVE AIMACRO TEST SUITE")
        PrintMessage("\n")
                t1 = String.Repeat("=", AIMacro.Int(60))
AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        test_math()
        PrintMessage("")
        PrintMessage("\n")
        test_arrays()
        PrintMessage("")
        PrintMessage("\n")
        test_strings()
        PrintMessage("")
        PrintMessage("\n")
        test_control_flow()
        PrintMessage("")
        PrintMessage("\n")
        nested_calls_test()
        PrintMessage("")
        PrintMessage("\n")
        test_edge_cases()
        PrintMessage("")
        PrintMessage("\n")
        test_while_variations()
        PrintMessage("")
        PrintMessage("\n")
                t2 = String.Repeat("=", AIMacro.Int(60))
AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        PrintMessage("ALL TESTS COMPLETE!")
        PrintMessage("\n")
        PrintMessage("If you see this, the transpiler is ready for real code.")
        PrintMessage("\n")
                t3 = String.Repeat("=", AIMacro.Int(60))
AIMacro.SmartPrint(t3)
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
