LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.test_for_range {
    Body: {
        PrintMessage("=== FOR LOOP WITH RANGE ===")
        PrintMessage("\n")
        PrintMessage("range(5):")
        PrintMessage("\n")
        lc0 = 0
        ls0 = 5
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
        PrintMessage("range(2, 7):")
        PrintMessage("\n")
        lc1 = 2
        ls1 = 7
        lt1 = 1
        WhileLoop LessThan(lc1, ls1) {
            i = lc1
            lc1 = Add(lc1, lt1)
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
        PrintMessage("range(0, 10, 2):")
        PrintMessage("\n")
        lc2 = 0
        ls2 = 10
        lt2 = 2
        WhileLoop LessThan(lc2, ls2) {
            i = lc2
            lc2 = Add(lc2, lt2)
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
    }
}

Function.test_elif_chain {
    Body: {
        PrintMessage("=== ELIF CHAINS ===")
        PrintMessage("\n")
        x = 1
        t0 = AIMacro.NumEq(x, 0)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            PrintMessage("x is zero")
            PrintMessage("\n")
        } ElseBlock: {
            t1 = AIMacro.NumEq(x, 1)
            IfCondition AIMacro.SmartBool(t1) ThenBlock: {
                PrintMessage("x is one")
                PrintMessage("\n")
            } ElseBlock: {
                t2 = AIMacro.NumEq(x, 2)
                IfCondition AIMacro.SmartBool(t2) ThenBlock: {
                    PrintMessage("x is two")
                    PrintMessage("\n")
                } ElseBlock: {
                    PrintMessage("x is something else")
                    PrintMessage("\n")
                }
            }
        }
        x = 2
        t3 = AIMacro.NumEq(x, 0)
        IfCondition AIMacro.SmartBool(t3) ThenBlock: {
            PrintMessage("x is zero")
            PrintMessage("\n")
        } ElseBlock: {
            t4 = AIMacro.NumEq(x, 1)
            IfCondition AIMacro.SmartBool(t4) ThenBlock: {
                PrintMessage("x is one")
                PrintMessage("\n")
            } ElseBlock: {
                t5 = AIMacro.NumEq(x, 2)
                IfCondition AIMacro.SmartBool(t5) ThenBlock: {
                    PrintMessage("x is two")
                    PrintMessage("\n")
                } ElseBlock: {
                    PrintMessage("x is something else")
                    PrintMessage("\n")
                }
            }
        }
        x = 99
        t6 = AIMacro.NumEq(x, 0)
        IfCondition AIMacro.SmartBool(t6) ThenBlock: {
            PrintMessage("x is zero")
            PrintMessage("\n")
        } ElseBlock: {
            t7 = AIMacro.NumEq(x, 1)
            IfCondition AIMacro.SmartBool(t7) ThenBlock: {
                PrintMessage("x is one")
                PrintMessage("\n")
            } ElseBlock: {
                t8 = AIMacro.NumEq(x, 2)
                IfCondition AIMacro.SmartBool(t8) ThenBlock: {
                    PrintMessage("x is two")
                    PrintMessage("\n")
                } ElseBlock: {
                    PrintMessage("x is something else")
                    PrintMessage("\n")
                }
            }
        }
    }
}

Function.test_nested_elif {
    Body: {
        PrintMessage("=== NESTED CONDITIONALS ===")
        PrintMessage("\n")
        a = 5
        b = 10
        IfCondition AIMacro.SmartBool(AIMacro.NumGt(a, 0)) ThenBlock: {
            IfCondition AIMacro.SmartBool(AIMacro.NumGt(b, 0)) ThenBlock: {
                PrintMessage("Both positive")
                PrintMessage("\n")
            } ElseBlock: {
                t0 = AIMacro.NumEq(b, 0)
                IfCondition AIMacro.SmartBool(t0) ThenBlock: {
                    PrintMessage("a positive, b zero")
                    PrintMessage("\n")
                } ElseBlock: {
                    PrintMessage("a positive, b negative")
                    PrintMessage("\n")
                }
            }
        } ElseBlock: {
            PrintMessage("a not positive")
            PrintMessage("\n")
        }
    }
}

Function.test_break {
    Body: {
        PrintMessage("=== BREAK ===")
        PrintMessage("\n")
        PrintMessage("While with break at 5:")
        PrintMessage("\n")
        i = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(i, 10)) {
            t0 = AIMacro.NumEq(i, 5)
            IfCondition AIMacro.SmartBool(t0) ThenBlock: {
                BreakLoop
            }
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
            i = AIMacro.NumAdd(i, 1)
        }
        PrintMessage("Loop exited")
        PrintMessage("\n")
        PrintMessage("For with break at 3:")
        PrintMessage("\n")
        lc1 = 0
        ls1 = 10
        lt1 = 1
        WhileLoop LessThan(lc1, ls1) {
            j = lc1
            lc1 = Add(lc1, lt1)
            t2 = AIMacro.NumEq(j, 3)
            IfCondition AIMacro.SmartBool(t2) ThenBlock: {
                BreakLoop
            }
            AIMacro.SmartPrint(j)
            PrintMessage("\n")
        }
        PrintMessage("For loop exited")
        PrintMessage("\n")
    }
}

Function.test_continue {
    Body: {
        PrintMessage("=== CONTINUE ===")
        PrintMessage("\n")
        PrintMessage("Skip evens (print odds 0-9):")
        PrintMessage("\n")
        lc0 = 0
        ls0 = 10
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            t1 = AIMacro.NumMod(i, 2)
            t2 = AIMacro.NumEq(t1, 0)
            IfCondition AIMacro.SmartBool(t2) ThenBlock: {
                ContinueLoop
            }
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
        PrintMessage("Skip multiples of 3:")
        PrintMessage("\n")
        i = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(i, 15)) {
            i = AIMacro.NumAdd(i, 1)
            t3 = AIMacro.NumMod(i, 3)
            t4 = AIMacro.NumEq(t3, 0)
            IfCondition AIMacro.SmartBool(t4) ThenBlock: {
                ContinueLoop
            }
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
    }
}

Function.test_boolean_and {
    Body: {
        PrintMessage("=== BOOLEAN AND ===")
        PrintMessage("\n")
        a = 5
        b = 10
        t0 = AIMacro.NumGt(a, 0)
        t1 = t0
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            t2 = AIMacro.NumGt(b, 0)
            t1 = t2
        }
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            PrintMessage("Both > 0: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("Both > 0: FALSE")
            PrintMessage("\n")
        }
        t3 = AIMacro.NumGt(a, 0)
        t4 = t3
        IfCondition AIMacro.SmartBool(t4) ThenBlock: {
            t5 = AIMacro.NumGt(b, 20)
            t4 = t5
        }
        IfCondition AIMacro.SmartBool(t4) ThenBlock: {
            PrintMessage("a>0 and b>20: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("a>0 and b>20: FALSE")
            PrintMessage("\n")
        }
        t6 = AIMacro.NumGt(a, 10)
        t7 = t6
        IfCondition AIMacro.SmartBool(t7) ThenBlock: {
            t8 = AIMacro.NumGt(b, 0)
            t7 = t8
        }
        IfCondition AIMacro.SmartBool(t7) ThenBlock: {
            PrintMessage("a>10 and b>0: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("a>10 and b>0: FALSE")
            PrintMessage("\n")
        }
    }
}

Function.test_boolean_or {
    Body: {
        PrintMessage("=== BOOLEAN OR ===")
        PrintMessage("\n")
        a = 5
        b = 10
        t0 = AIMacro.NumGt(a, 0)
        t1 = t0
        IfCondition Not(AIMacro.SmartBool(t1)) ThenBlock: {
            t2 = AIMacro.NumGt(b, 0)
            t1 = t2
        }
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            PrintMessage("a>0 or b>0: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("a>0 or b>0: FALSE")
            PrintMessage("\n")
        }
        t3 = AIMacro.NumGt(a, 100)
        t4 = t3
        IfCondition Not(AIMacro.SmartBool(t4)) ThenBlock: {
            t5 = AIMacro.NumGt(b, 100)
            t4 = t5
        }
        IfCondition AIMacro.SmartBool(t4) ThenBlock: {
            PrintMessage("a>100 or b>100: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("a>100 or b>100: FALSE")
            PrintMessage("\n")
        }
        t6 = AIMacro.NumGt(a, 100)
        t7 = t6
        IfCondition Not(AIMacro.SmartBool(t7)) ThenBlock: {
            t8 = AIMacro.NumGt(b, 0)
            t7 = t8
        }
        IfCondition AIMacro.SmartBool(t7) ThenBlock: {
            PrintMessage("a>100 or b>0: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("a>100 or b>0: FALSE")
            PrintMessage("\n")
        }
    }
}

Function.test_boolean_not {
    Body: {
        PrintMessage("=== BOOLEAN NOT ===")
        PrintMessage("\n")
        flag = 1
        t0 = AIMacro.NumEq(flag, 0)
        t1 = AIMacro.NotVal(t0)
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            PrintMessage("not (flag==0): TRUE (flag is not zero)")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("not (flag==0): FALSE")
            PrintMessage("\n")
        }
        flag = 0
        t2 = AIMacro.NumEq(flag, 0)
        t3 = AIMacro.NotVal(t2)
        IfCondition AIMacro.SmartBool(t3) ThenBlock: {
            PrintMessage("not (flag==0): TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("not (flag==0): FALSE (flag is zero)")
            PrintMessage("\n")
        }
    }
}

Function.test_complex_conditions {
    Body: {
        PrintMessage("=== COMPLEX CONDITIONS ===")
        PrintMessage("\n")
        x = 5
        y = 10
        z = 15
        t0 = AIMacro.NumGt(x, 0)
        t1 = t0
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            t2 = AIMacro.NumGt(y, 0)
            t1 = t2
        }
        t3 = t1
        IfCondition Not(AIMacro.SmartBool(t3)) ThenBlock: {
            t4 = AIMacro.NumLt(z, 0)
            t3 = t4
        }
        IfCondition AIMacro.SmartBool(t3) ThenBlock: {
            PrintMessage("(x>0 and y>0) or z<0: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("(x>0 and y>0) or z<0: FALSE")
            PrintMessage("\n")
        }
        t5 = AIMacro.NumGt(x, 0)
        t6 = t5
        IfCondition AIMacro.SmartBool(t6) ThenBlock: {
            t7 = AIMacro.NumGt(y, 20)
            t8 = t7
            IfCondition Not(AIMacro.SmartBool(t8)) ThenBlock: {
                t9 = AIMacro.NumGt(z, 10)
                t8 = t9
            }
            t6 = t8
        }
        IfCondition AIMacro.SmartBool(t6) ThenBlock: {
            PrintMessage("x>0 and (y>20 or z>10): TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("x>0 and (y>20 or z>10): FALSE")
            PrintMessage("\n")
        }
        t10 = AIMacro.NumLt(x, y)
        t11 = t10
        IfCondition AIMacro.SmartBool(t11) ThenBlock: {
            t12 = AIMacro.NumLt(y, z)
            t11 = t12
        }
        IfCondition AIMacro.SmartBool(t11) ThenBlock: {
            PrintMessage("x < y < z: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("x < y < z: FALSE")
            PrintMessage("\n")
        }
    }
}

Function.test_nested_loops {
    Body: {
        PrintMessage("=== NESTED LOOPS ===")
        PrintMessage("\n")
        PrintMessage("Multiplication table 3x3:")
        PrintMessage("\n")
        lc0 = 1
        ls0 = 4
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            lc1 = 1
            ls1 = 4
            lt1 = 1
            WhileLoop LessThan(lc1, ls1) {
                j = lc1
                lc1 = Add(lc1, lt1)
                result = AIMacro.NumMul(i, j)
                AIMacro.SmartPrint(i)
                PrintMessage(" ")
                PrintMessage("*")
                PrintMessage(" ")
                AIMacro.SmartPrint(j)
                PrintMessage(" ")
                PrintMessage("=")
                PrintMessage(" ")
                AIMacro.SmartPrint(result)
                PrintMessage("\n")
            }
        }
    }
}

Function.test_early_return {
    Body: {
        PrintMessage("=== EARLY RETURN ===")
        PrintMessage("\n")
        t0 = find_first_even(7)
        result = t0
        PrintMessage("First even >= 7:")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        t1 = find_first_even(10)
        result = t1
        PrintMessage("First even >= 10:")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
    }
}

Function.find_first_even {
    Input: p_start: Integer
    Body: {
        i = p_start
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(i, AIMacro.NumAdd(p_start, 10))) {
            t0 = AIMacro.NumMod(i, 2)
            t1 = AIMacro.NumEq(t0, 0)
            IfCondition AIMacro.SmartBool(t1) ThenBlock: {
                ReturnValue(i)
            }
            i = AIMacro.NumAdd(i, 1)
        }
        ReturnValue(AIMacro.NumNeg(1))
    }
}

Function.main {
    Body: {
                t0 = String.Repeat("=", AIMacro.Int(50))
AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("AIMacro Control Flow Test Suite")
        PrintMessage("\n")
                t1 = String.Repeat("=", AIMacro.Int(50))
AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        test_for_range()
        test_elif_chain()
        test_nested_elif()
        test_break()
        test_continue()
        test_boolean_and()
        test_boolean_or()
        test_boolean_not()
        test_complex_conditions()
        test_nested_loops()
        test_early_return()
                t2 = String.Repeat("=", AIMacro.Int(50))
AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        PrintMessage("All control flow tests complete!")
        PrintMessage("\n")
                t3 = String.Repeat("=", AIMacro.Int(50))
AIMacro.SmartPrint(t3)
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
