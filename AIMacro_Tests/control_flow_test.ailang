LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.test_for_range {
    Body: {
        PrintMessage("=== FOR LOOP WITH RANGE ===")
        PrintMessage("\n")
        PrintMessage("range(5):")
        PrintMessage("\n")
        lc0 = 0
        ls0 = 5
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
        PrintMessage("range(2, 7):")
        PrintMessage("\n")
        lc1 = 2
        ls1 = 7
        lt1 = 1
        WhileLoop LessThan(lc1, ls1) {
            i = lc1
            lc1 = Add(lc1, lt1)
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
        PrintMessage("range(0, 10, 2):")
        PrintMessage("\n")
        lc2 = 0
        ls2 = 10
        lt2 = 2
        WhileLoop LessThan(lc2, ls2) {
            i = lc2
            lc2 = Add(lc2, lt2)
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
    }
}

Function.test_elif_chain {
    Body: {
        PrintMessage("=== ELIF CHAINS ===")
        PrintMessage("\n")
        x = 1
        IfCondition EqualTo(x, 0) ThenBlock: {
            PrintMessage("x is zero")
            PrintMessage("\n")
        } ElseBlock: {
            IfCondition EqualTo(x, 1) ThenBlock: {
                PrintMessage("x is one")
                PrintMessage("\n")
            } ElseBlock: {
                IfCondition EqualTo(x, 2) ThenBlock: {
                    PrintMessage("x is two")
                    PrintMessage("\n")
                } ElseBlock: {
                    PrintMessage("x is something else")
                    PrintMessage("\n")
                }
            }
        }
        x = 2
        IfCondition EqualTo(x, 0) ThenBlock: {
            PrintMessage("x is zero")
            PrintMessage("\n")
        } ElseBlock: {
            IfCondition EqualTo(x, 1) ThenBlock: {
                PrintMessage("x is one")
                PrintMessage("\n")
            } ElseBlock: {
                IfCondition EqualTo(x, 2) ThenBlock: {
                    PrintMessage("x is two")
                    PrintMessage("\n")
                } ElseBlock: {
                    PrintMessage("x is something else")
                    PrintMessage("\n")
                }
            }
        }
        x = 99
        IfCondition EqualTo(x, 0) ThenBlock: {
            PrintMessage("x is zero")
            PrintMessage("\n")
        } ElseBlock: {
            IfCondition EqualTo(x, 1) ThenBlock: {
                PrintMessage("x is one")
                PrintMessage("\n")
            } ElseBlock: {
                IfCondition EqualTo(x, 2) ThenBlock: {
                    PrintMessage("x is two")
                    PrintMessage("\n")
                } ElseBlock: {
                    PrintMessage("x is something else")
                    PrintMessage("\n")
                }
            }
        }
    }
}

Function.test_nested_elif {
    Body: {
        PrintMessage("=== NESTED CONDITIONALS ===")
        PrintMessage("\n")
        a = 5
        b = 10
        IfCondition GreaterThan(a, 0) ThenBlock: {
            IfCondition GreaterThan(b, 0) ThenBlock: {
                PrintMessage("Both positive")
                PrintMessage("\n")
            } ElseBlock: {
                IfCondition EqualTo(b, 0) ThenBlock: {
                    PrintMessage("a positive, b zero")
                    PrintMessage("\n")
                } ElseBlock: {
                    PrintMessage("a positive, b negative")
                    PrintMessage("\n")
                }
            }
        } ElseBlock: {
            PrintMessage("a not positive")
            PrintMessage("\n")
        }
    }
}

Function.test_break {
    Body: {
        PrintMessage("=== BREAK ===")
        PrintMessage("\n")
        PrintMessage("While with break at 5:")
        PrintMessage("\n")
        i = 0
        WhileLoop LessThan(i, 10) {
            IfCondition EqualTo(i, 5) ThenBlock: {
                BreakLoop
            }
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
            i = Add(i, 1)
        }
        PrintMessage("Loop exited")
        PrintMessage("\n")
        PrintMessage("For with break at 3:")
        PrintMessage("\n")
        lc0 = 0
        ls0 = 10
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            j = lc0
            lc0 = Add(lc0, lt0)
            IfCondition EqualTo(j, 3) ThenBlock: {
                BreakLoop
            }
            AIMacro.SmartPrint(j)
            PrintMessage("\n")
        }
        PrintMessage("For loop exited")
        PrintMessage("\n")
    }
}

Function.test_continue {
    Body: {
        PrintMessage("=== CONTINUE ===")
        PrintMessage("\n")
        PrintMessage("Skip evens (print odds 0-9):")
        PrintMessage("\n")
        lc0 = 0
        ls0 = 10
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            IfCondition EqualTo(Modulo(i, 2), 0) ThenBlock: {
                ContinueLoop
            }
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
        PrintMessage("Skip multiples of 3:")
        PrintMessage("\n")
        i = 0
        WhileLoop LessThan(i, 15) {
            i = Add(i, 1)
            IfCondition EqualTo(Modulo(i, 3), 0) ThenBlock: {
                ContinueLoop
            }
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
    }
}

Function.test_boolean_and {
    Body: {
        PrintMessage("=== BOOLEAN AND ===")
        PrintMessage("\n")
        a = 5
        b = 10
        IfCondition And(GreaterThan(a, 0), GreaterThan(b, 0)) ThenBlock: {
            PrintMessage("Both > 0: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("Both > 0: FALSE")
            PrintMessage("\n")
        }
        IfCondition And(GreaterThan(a, 0), GreaterThan(b, 20)) ThenBlock: {
            PrintMessage("a>0 and b>20: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("a>0 and b>20: FALSE")
            PrintMessage("\n")
        }
        IfCondition And(GreaterThan(a, 10), GreaterThan(b, 0)) ThenBlock: {
            PrintMessage("a>10 and b>0: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("a>10 and b>0: FALSE")
            PrintMessage("\n")
        }
    }
}

Function.test_boolean_or {
    Body: {
        PrintMessage("=== BOOLEAN OR ===")
        PrintMessage("\n")
        a = 5
        b = 10
        IfCondition Or(GreaterThan(a, 0), GreaterThan(b, 0)) ThenBlock: {
            PrintMessage("a>0 or b>0: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("a>0 or b>0: FALSE")
            PrintMessage("\n")
        }
        IfCondition Or(GreaterThan(a, 100), GreaterThan(b, 100)) ThenBlock: {
            PrintMessage("a>100 or b>100: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("a>100 or b>100: FALSE")
            PrintMessage("\n")
        }
        IfCondition Or(GreaterThan(a, 100), GreaterThan(b, 0)) ThenBlock: {
            PrintMessage("a>100 or b>0: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("a>100 or b>0: FALSE")
            PrintMessage("\n")
        }
    }
}

Function.test_boolean_not {
    Body: {
        PrintMessage("=== BOOLEAN NOT ===")
        PrintMessage("\n")
        flag = 1
        IfCondition Not(EqualTo(flag, 0)) ThenBlock: {
            PrintMessage("not (flag==0): TRUE (flag is not zero)")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("not (flag==0): FALSE")
            PrintMessage("\n")
        }
        flag = 0
        IfCondition Not(EqualTo(flag, 0)) ThenBlock: {
            PrintMessage("not (flag==0): TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("not (flag==0): FALSE (flag is zero)")
            PrintMessage("\n")
        }
    }
}

Function.test_complex_conditions {
    Body: {
        PrintMessage("=== COMPLEX CONDITIONS ===")
        PrintMessage("\n")
        x = 5
        y = 10
        z = 15
        IfCondition Or(And(GreaterThan(x, 0), GreaterThan(y, 0)), LessThan(z, 0)) ThenBlock: {
            PrintMessage("(x>0 and y>0) or z<0: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("(x>0 and y>0) or z<0: FALSE")
            PrintMessage("\n")
        }
        IfCondition And(GreaterThan(x, 0), Or(GreaterThan(y, 20), GreaterThan(z, 10))) ThenBlock: {
            PrintMessage("x>0 and (y>20 or z>10): TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("x>0 and (y>20 or z>10): FALSE")
            PrintMessage("\n")
        }
        IfCondition And(LessThan(x, y), LessThan(y, z)) ThenBlock: {
            PrintMessage("x < y < z: TRUE")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("x < y < z: FALSE")
            PrintMessage("\n")
        }
    }
}

Function.test_nested_loops {
    Body: {
        PrintMessage("=== NESTED LOOPS ===")
        PrintMessage("\n")
        PrintMessage("Multiplication table 3x3:")
        PrintMessage("\n")
        lc0 = 1
        ls0 = 4
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            lc1 = 1
            ls1 = 4
            lt1 = 1
            WhileLoop LessThan(lc1, ls1) {
                j = lc1
                lc1 = Add(lc1, lt1)
                result = Multiply(i, j)
                AIMacro.SmartPrint(i)
                PrintMessage(" ")
                PrintMessage("*")
                PrintMessage(" ")
                AIMacro.SmartPrint(j)
                PrintMessage(" ")
                PrintMessage("=")
                PrintMessage(" ")
                AIMacro.SmartPrint(result)
                PrintMessage("\n")
            }
        }
    }
}

Function.test_early_return {
    Body: {
        PrintMessage("=== EARLY RETURN ===")
        PrintMessage("\n")
        t0 = find_first_even(7)
        result = t0
        PrintMessage("First even >= 7:")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        t1 = find_first_even(10)
        result = t1
        PrintMessage("First even >= 10:")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
    }
}

Function.find_first_even {
    Input: p_start: Integer
    Body: {
        i = p_start
        WhileLoop LessThan(i, Add(p_start, 10)) {
            IfCondition EqualTo(Modulo(i, 2), 0) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(Subtract(0, 1))
    }
}

SubRoutine.Main {
                t0 = String.Repeat("=", 50)
AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("AIMacro Control Flow Test Suite")
        PrintMessage("\n")
                t1 = String.Repeat("=", 50)
AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        test_for_range()
        test_elif_chain()
        test_nested_elif()
        test_break()
        test_continue()
        test_boolean_and()
        test_boolean_or()
        test_boolean_not()
        test_complex_conditions()
        test_nested_loops()
        test_early_return()
                t2 = String.Repeat("=", 50)
AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        PrintMessage("All control flow tests complete!")
        PrintMessage("\n")
                t3 = String.Repeat("=", 50)
AIMacro.SmartPrint(t3)
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
