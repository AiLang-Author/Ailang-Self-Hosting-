Function.test_expressions {
    Body: {
        PrintMessage("=== TEST 19: Expression Values ===")
        PrintMessage("\n")
        d = Hash.Create(16)
        base = 10
        Hash.Set(d, "computed", Add(Multiply(base, 5), 2))
        PrintMessage("Computed value:")
        PrintMessage("\n")
        t0 = Hash.Get(d, "computed")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        Hash.Set(d, "a", 1)
        t1 = Hash.Get(d, "a")
        t2 = Add(t1, 1)
        Hash.Set(d, "b", t2)
        t3 = Hash.Get(d, "b")
        t4 = Add(t3, 1)
        Hash.Set(d, "c", t4)
        PrintMessage("Chained c:")
        PrintMessage("\n")
        t5 = Hash.Get(d, "c")
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        PrintMessage("TEST 19 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_large {
    Body: {
        PrintMessage("=== TEST 20: Large Dict ===")
        PrintMessage("\n")
        d = Hash.Create(16)
        lc0 = 0
        ls0 = 20
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            key = AIMacro.Str(i)
            Hash.Set(d, key, Multiply(i, i))
        }
        PrintMessage("Size:")
        PrintMessage("\n")
        t1 = Hash.Size(d)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("d['0']:")
        PrintMessage("\n")
        t2 = Hash.Get(d, "0")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        PrintMessage("d['5']:")
        PrintMessage("\n")
        t3 = Hash.Get(d, "5")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        PrintMessage("d['10']:")
        PrintMessage("\n")
        t4 = Hash.Get(d, "10")
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        PrintMessage("d['19']:")
        PrintMessage("\n")
        t5 = Hash.Get(d, "19")
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        PrintMessage("TEST 20 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

SubRoutine.Main {
        PrintMessage("######################################")
        PrintMessage("\n")
        PrintMessage("# COMPREHENSIVE DICT TEST SUITE     #")
        PrintMessage("\n")
        PrintMessage("######################################")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        test_basic()
        test_empty()
        test_modify()
        test_in_operator()
        test_len()
        test_string_int_keys()
        test_int_values()
