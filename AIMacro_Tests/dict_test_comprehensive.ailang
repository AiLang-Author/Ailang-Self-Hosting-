LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.test_basic {
    Body: {
        PrintMessage("=== TEST 1: Basic Creation and Access ===")
        PrintMessage("\n")
        d = Hash.Create(16)
        Hash.Set(d, "name", "Alice")
        Hash.Set(d, "age", 30)
        Hash.Set(d, "score", 95)
        PrintMessage("name:")
        PrintMessage("\n")
        t0 = Hash.Get(d, "name")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("age:")
        PrintMessage("\n")
        t1 = Hash.Get(d, "age")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("score:")
        PrintMessage("\n")
        t2 = Hash.Get(d, "score")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        PrintMessage("TEST 1 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_empty {
    Body: {
        PrintMessage("=== TEST 2: Empty Dict ===")
        PrintMessage("\n")
        d = Hash.Create(16)
        PrintMessage("Empty dict size:")
        PrintMessage("\n")
        t0 = Hash.Size(d)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        Hash.Set(d, "first", 100)
        Hash.Set(d, "second", 200)
        PrintMessage("Size after adding 2:")
        PrintMessage("\n")
        t1 = Hash.Size(d)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("first:")
        PrintMessage("\n")
        t2 = Hash.Get(d, "first")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        PrintMessage("second:")
        PrintMessage("\n")
        t3 = Hash.Get(d, "second")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        PrintMessage("TEST 2 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_modify {
    Body: {
        PrintMessage("=== TEST 3: Modification ===")
        PrintMessage("\n")
        d = Hash.Create(16)
        Hash.Set(d, "x", 10)
        Hash.Set(d, "y", 20)
        PrintMessage("Original x:")
        PrintMessage("\n")
        t0 = Hash.Get(d, "x")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        Hash.Set(d, "x", 15)
        PrintMessage("Updated x:")
        PrintMessage("\n")
        t1 = Hash.Get(d, "x")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        Hash.Set(d, "z", 30)
        PrintMessage("New z:")
        PrintMessage("\n")
        t2 = Hash.Get(d, "z")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = Hash.Get(d, "x")
        t4 = Add(t3, 5)
        Hash.Set(d, "x", t4)
        PrintMessage("x after +5:")
        PrintMessage("\n")
        t5 = Hash.Get(d, "x")
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        PrintMessage("TEST 3 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_in_operator {
    Body: {
        PrintMessage("=== TEST 4: The 'in' Operator ===")
        PrintMessage("\n")
        scores = Hash.Create(16)
        Hash.Set(scores, "alice", 95)
        Hash.Set(scores, "bob", 87)
        Hash.Set(scores, "charlie", 92)
        IfCondition Hash.Contains(scores, "alice") ThenBlock: {
            PrintMessage("alice found: PASS")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("alice found: FAIL")
            PrintMessage("\n")
        }
        IfCondition Hash.Contains(scores, "dave") ThenBlock: {
            PrintMessage("dave not found: FAIL")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("dave not found: PASS")
            PrintMessage("\n")
        }
        IfCondition Not(Hash.Contains(scores, "eve")) ThenBlock: {
            PrintMessage("eve not in: PASS")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("eve not in: FAIL")
            PrintMessage("\n")
        }
        IfCondition Not(Hash.Contains(scores, "bob")) ThenBlock: {
            PrintMessage("bob not in: FAIL")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("bob is in: PASS")
            PrintMessage("\n")
        }
        PrintMessage("TEST 4 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_len {
    Body: {
        PrintMessage("=== TEST 5: Dict Size ===")
        PrintMessage("\n")
        d = Hash.Create(16)
        PrintMessage("Empty size:")
        PrintMessage("\n")
        t0 = Hash.Size(d)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        Hash.Set(d, "a", 1)
        PrintMessage("After 1 add:")
        PrintMessage("\n")
        t1 = Hash.Size(d)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        Hash.Set(d, "b", 2)
        Hash.Set(d, "c", 3)
        PrintMessage("After 3 total:")
        PrintMessage("\n")
        t2 = Hash.Size(d)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        Hash.Set(d, "a", 100)
        PrintMessage("After update (should still be 3):")
        PrintMessage("\n")
        t3 = Hash.Size(d)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        PrintMessage("TEST 5 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_string_int_keys {
    Body: {
        PrintMessage("=== TEST 6: String Number Keys ===")
        PrintMessage("\n")
        d = Hash.Create(16)
        Hash.Set(d, "1", "one")
        Hash.Set(d, "2", "two")
        Hash.Set(d, "3", "three")
        PrintMessage("d['1']:")
        PrintMessage("\n")
        t0 = Hash.Get(d, "1")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("d['2']:")
        PrintMessage("\n")
        t1 = Hash.Get(d, "2")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("d['3']:")
        PrintMessage("\n")
        t2 = Hash.Get(d, "3")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        PrintMessage("TEST 6 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_int_values {
    Body: {
        PrintMessage("=== TEST 7: Integer Values ===")
        PrintMessage("\n")
        counts = Hash.Create(16)
        Hash.Set(counts, "apples", 5)
        Hash.Set(counts, "bananas", 3)
        Hash.Set(counts, "oranges", 8)
        t0 = Hash.Get(counts, "apples")
        t1 = Hash.Get(counts, "bananas")
        t2 = Add(t0, t1)
        t3 = Hash.Get(counts, "oranges")
        t4 = Add(t2, t3)
        total = t4
        PrintMessage("Total fruits:")
        PrintMessage("\n")
        AIMacro.SmartPrint(total)
        PrintMessage("\n")
        t5 = Hash.Get(counts, "oranges")
        t6 = Hash.Get(counts, "bananas")
        t7 = Subtract(t5, t6)
        diff = t7
        PrintMessage("Oranges minus bananas:")
        PrintMessage("\n")
        AIMacro.SmartPrint(diff)
        PrintMessage("\n")
        PrintMessage("TEST 7 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_string_values {
    Body: {
        PrintMessage("=== TEST 8: String Values ===")
        PrintMessage("\n")
        person = Hash.Create(16)
        Hash.Set(person, "first", "John")
        Hash.Set(person, "last", "Doe")
        Hash.Set(person, "city", "Boston")
        PrintMessage("First name:")
        PrintMessage("\n")
        t0 = Hash.Get(person, "first")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("Last name:")
        PrintMessage("\n")
        t1 = Hash.Get(person, "last")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("City:")
        PrintMessage("\n")
        t2 = Hash.Get(person, "city")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        Hash.Set(person, "city", "NewYork")
        PrintMessage("New city:")
        PrintMessage("\n")
        t3 = Hash.Get(person, "city")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        PrintMessage("TEST 8 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_keys {
    Body: {
        PrintMessage("=== TEST 9: Dict .keys() ===")
        PrintMessage("\n")
        d = Hash.Create(16)
        Hash.Set(d, "a", 1)
        Hash.Set(d, "b", 2)
        Hash.Set(d, "c", 3)
        keys = Hash.Keys(d)
        PrintMessage("Number of keys:")
        PrintMessage("\n")
        t0 = DictGen_SmartLen(keys)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("Keys:")
        PrintMessage("\n")
        iter1 = keys
        iterlen1 = AIMacro.SmartLen(iter1)
        iteri1 = 0
        WhileLoop LessThan(iteri1, iterlen1) {
            k = DictGen_SmartGet(iter1, iteri1)
            AIMacro.SmartPrint(k)
            PrintMessage("\n")
            iteri1 = Add(iteri1, 1)
        }
        PrintMessage("TEST 9 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_values {
    Body: {
        PrintMessage("=== TEST 10: Dict .values() ===")
        PrintMessage("\n")
        d = Hash.Create(16)
        Hash.Set(d, "x", 10)
        Hash.Set(d, "y", 20)
        Hash.Set(d, "z", 30)
        vals = Hash.Values(d)
        PrintMessage("Number of values:")
        PrintMessage("\n")
        t0 = DictGen_SmartLen(vals)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("Values:")
        PrintMessage("\n")
        iter1 = vals
        iterlen1 = AIMacro.SmartLen(iter1)
        iteri1 = 0
        WhileLoop LessThan(iteri1, iterlen1) {
            v = DictGen_SmartGet(iter1, iteri1)
            AIMacro.SmartPrint(v)
            PrintMessage("\n")
            iteri1 = Add(iteri1, 1)
        }
        total = 0
        iter2 = vals
        iterlen2 = AIMacro.SmartLen(iter2)
        iteri2 = 0
        WhileLoop LessThan(iteri2, iterlen2) {
            v = DictGen_SmartGet(iter2, iteri2)
            total = Add(total, v)
            iteri2 = Add(iteri2, 1)
        }
        PrintMessage("Sum of values:")
        PrintMessage("\n")
        AIMacro.SmartPrint(total)
        PrintMessage("\n")
        PrintMessage("TEST 10 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_items {
    Body: {
        PrintMessage("=== TEST 11: Dict .items() ===")
        PrintMessage("\n")
        d = Hash.Create(16)
        Hash.Set(d, "name", "Alice")
        Hash.Set(d, "age", 25)
        items = Hash.Items(d)
        PrintMessage("Number of items:")
        PrintMessage("\n")
        t0 = DictGen_SmartLen(items)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("Key-Value pairs:")
        PrintMessage("\n")
        iter1 = items
        iterlen1 = AIMacro.SmartLen(iter1)
        iteri1 = 0
        WhileLoop LessThan(iteri1, iterlen1) {
            __pair1 = DictGen_SmartGet(iter1, iteri1)
            k = DictGen_SmartGet(__pair1, 0)
            v = DictGen_SmartGet(__pair1, 1)
            AIMacro.SmartPrint(k)
            PrintMessage("\n")
            AIMacro.SmartPrint(v)
            PrintMessage("\n")
            iteri1 = Add(iteri1, 1)
        }
        PrintMessage("TEST 11 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_clear {
    Body: {
        PrintMessage("=== TEST 12: Dict .clear() ===")
        PrintMessage("\n")
        d = Hash.Create(16)
        Hash.Set(d, "a", 1)
        Hash.Set(d, "b", 2)
        Hash.Set(d, "c", 3)
        PrintMessage("Size before clear:")
        PrintMessage("\n")
        t0 = Hash.Size(d)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        Hash.Clear(d)
        PrintMessage("Size after clear:")
        PrintMessage("\n")
        t1 = Hash.Size(d)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        Hash.Set(d, "new", 999)
        PrintMessage("After adding new:")
        PrintMessage("\n")
        t2 = Hash.Size(d)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = Hash.Get(d, "new")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        PrintMessage("TEST 12 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_conditionals {
    Body: {
        PrintMessage("=== TEST 13: Dict in Conditionals ===")
        PrintMessage("\n")
        config = Hash.Create(16)
        Hash.Set(config, "debug", 1)
        Hash.Set(config, "verbose", 0)
        Hash.Set(config, "max", 100)
        t0 = Hash.Get(config, "debug")
        IfCondition EqualTo(t0, 1) ThenBlock: {
            PrintMessage("Debug mode: ON")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("Debug mode: OFF")
            PrintMessage("\n")
        }
        t1 = Hash.Get(config, "verbose")
        IfCondition EqualTo(t1, 1) ThenBlock: {
            PrintMessage("Verbose: ON")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("Verbose: OFF")
            PrintMessage("\n")
        }
        t2 = Hash.Get(config, "max")
        IfCondition GreaterThan(t2, 50) ThenBlock: {
            PrintMessage("Max is large")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("Max is small")
            PrintMessage("\n")
        }
        PrintMessage("TEST 13 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_loops {
    Body: {
        PrintMessage("=== TEST 14: Dict in Loops ===")
        PrintMessage("\n")
        d = Hash.Create(16)
        lc0 = 0
        ls0 = 5
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            key = AIMacro.Str(i)
            Hash.Set(d, key, Multiply(i, 10))
        }
        PrintMessage("Built dict size:")
        PrintMessage("\n")
        t1 = Hash.Size(d)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("Values:")
        PrintMessage("\n")
        lc2 = 0
        ls2 = 5
        lt2 = 1
        WhileLoop LessThan(lc2, ls2) {
            i = lc2
            lc2 = Add(lc2, lt2)
            key = AIMacro.Str(i)
            t3 = Hash.Get(d, key)
            AIMacro.SmartPrint(t3)
            PrintMessage("\n")
        }
        PrintMessage("TEST 14 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.print_dict_info {
    Input: p_data: Integer
    Body: {
        PrintMessage("Dict size:")
        PrintMessage("\n")
        t0 = DictGen_SmartLen(p_data)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("Has 'name':")
        PrintMessage("\n")
        IfCondition DictGen_SmartContains(p_data, "name") ThenBlock: {
            PrintMessage("yes")
            PrintMessage("\n")
            t1 = DictGen_SmartGet(p_data, "name")
            AIMacro.SmartPrint(t1)
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("no")
            PrintMessage("\n")
        }
        t2 = DictGen_SmartLen(p_data)
        ReturnValue(t2)
    }
}

Function.test_function_arg {
    Body: {
        PrintMessage("=== TEST 15: Dict as Function Argument ===")
        PrintMessage("\n")
        person = Hash.Create(16)
        Hash.Set(person, "name", "Bob")
        Hash.Set(person, "age", 30)
        t0 = print_dict_info(person)
        result = t0
        PrintMessage("Returned:")
        PrintMessage("\n")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        PrintMessage("TEST 15 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_multiple_dicts {
    Body: {
        PrintMessage("=== TEST 16: Multiple Dicts ===")
        PrintMessage("\n")
        dict1 = Hash.Create(16)
        Hash.Set(dict1, "a", 1)
        Hash.Set(dict1, "b", 2)
        dict2 = Hash.Create(16)
        Hash.Set(dict2, "x", 10)
        Hash.Set(dict2, "y", 20)
        dict3 = Hash.Create(16)
        Hash.Set(dict3, "p", 100)
        PrintMessage("dict1 size:")
        PrintMessage("\n")
        t0 = Hash.Size(dict1)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("dict2 size:")
        PrintMessage("\n")
        t1 = Hash.Size(dict2)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("dict3 size:")
        PrintMessage("\n")
        t2 = Hash.Size(dict3)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = Hash.Get(dict1, "a")
        t4 = Hash.Get(dict2, "x")
        t5 = Add(t3, t4)
        t6 = Hash.Get(dict3, "p")
        t7 = Add(t5, t6)
        total = t7
        PrintMessage("Sum across dicts:")
        PrintMessage("\n")
        AIMacro.SmartPrint(total)
        PrintMessage("\n")
        PrintMessage("TEST 16 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_dict_and_list {
    Body: {
        PrintMessage("=== TEST 17: Dict and List Together ===")
        PrintMessage("\n")
        numbers = Array.Create(3)
        Array.Push(numbers, 10)
        Array.Push(numbers, 20)
        Array.Push(numbers, 30)
        names = Hash.Create(16)
        Hash.Set(names, "a", "Alice")
        Hash.Set(names, "b", "Bob")
        PrintMessage("List[0]:")
        PrintMessage("\n")
        t0 = DictGen_SmartGet(numbers, 0)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("Dict['a']:")
        PrintMessage("\n")
        t1 = Hash.Get(names, "a")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        DictGen_SmartSet(numbers, 1, 25)
        PrintMessage("Modified list[1]:")
        PrintMessage("\n")
        t2 = DictGen_SmartGet(numbers, 1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        Hash.Set(names, "a", "Alicia")
        PrintMessage("Modified dict['a']:")
        PrintMessage("\n")
        t3 = Hash.Get(names, "a")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        IfCondition AIMacro.ListContains(numbers, 10) ThenBlock: {
            PrintMessage("10 is in numbers: PASS")
            PrintMessage("\n")
        }
        IfCondition Hash.Contains(names, "a") ThenBlock: {
            PrintMessage("'a' is in names: PASS")
            PrintMessage("\n")
        }
        PrintMessage("TEST 17 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_counter {
    Body: {
        PrintMessage("=== TEST 18: Counter Pattern ===")
        PrintMessage("\n")
        counts = Hash.Create(16)
        Hash.Set(counts, "hello", 0)
        Hash.Set(counts, "world", 0)
        Hash.Set(counts, "test", 0)
        t0 = Hash.Get(counts, "hello")
        t1 = Add(t0, 1)
        Hash.Set(counts, "hello", t1)
        t2 = Hash.Get(counts, "hello")
        t3 = Add(t2, 1)
        Hash.Set(counts, "hello", t3)
        t4 = Hash.Get(counts, "hello")
        t5 = Add(t4, 1)
        Hash.Set(counts, "hello", t5)
        t6 = Hash.Get(counts, "world")
        t7 = Add(t6, 1)
        Hash.Set(counts, "world", t7)
        t8 = Hash.Get(counts, "test")
        t9 = Add(t8, 1)
        Hash.Set(counts, "test", t9)
        t10 = Hash.Get(counts, "test")
        t11 = Add(t10, 1)
        Hash.Set(counts, "test", t11)
        PrintMessage("hello count:")
        PrintMessage("\n")
        t12 = Hash.Get(counts, "hello")
        AIMacro.SmartPrint(t12)
        PrintMessage("\n")
        PrintMessage("world count:")
        PrintMessage("\n")
        t13 = Hash.Get(counts, "world")
        AIMacro.SmartPrint(t13)
        PrintMessage("\n")
        PrintMessage("test count:")
        PrintMessage("\n")
        t14 = Hash.Get(counts, "test")
        AIMacro.SmartPrint(t14)
        PrintMessage("\n")
        PrintMessage("TEST 18 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.get_key {
    Body: {
        ReturnValue("dynamic")
