LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.check_inventory {
    Input: p_p_torch: Integer
    Input: p_p_key: Integer
    Input: p_p_sword: Integer
    Input: p_p_coins: Integer
    Body: {
        PrintMessage("=== INVENTORY ===")
        PrintMessage("\n")
        PrintMessage("Torch: ")
        PrintMessage("\n")
        AIMacro.SmartPrint(p_p_torch)
        PrintMessage("\n")
        PrintMessage("Key: ")
        PrintMessage("\n")
        AIMacro.SmartPrint(p_p_key)
        PrintMessage("\n")
        PrintMessage("Sword: ")
        PrintMessage("\n")
        AIMacro.SmartPrint(p_p_sword)
        PrintMessage("\n")
        PrintMessage("Gold coins: ")
        PrintMessage("\n")
        AIMacro.SmartPrint(p_p_coins)
        PrintMessage("\n")
        PrintMessage("================")
        PrintMessage("\n")
    }
}

Function.fight_monster {
    Input: p_has_sword: Integer
    Input: p_player_health: Integer
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("A goblin appears!")
        PrintMessage("\n")
        IfCondition EqualTo(p_has_sword, 1) ThenBlock: {
            PrintMessage("You swing your sword!")
            PrintMessage("\n")
            PrintMessage("The goblin flees in terror!")
            PrintMessage("\n")
            PrintMessage("It drops 10 gold coins!")
            PrintMessage("\n")
            ReturnValue(10)
        } ElseBlock: {
            PrintMessage("Without a weapon, the goblin attacks!")
            PrintMessage("\n")
            PrintMessage("You lose 25 health and run away!")
            PrintMessage("\n")
            ReturnValue(Subtract(0, 25))
        }
    }
}

SubRoutine.Main {
        PrintMessage("=================================")
        PrintMessage("\n")
        PrintMessage("    DUNGEON ESCAPE")
        PrintMessage("\n")
        PrintMessage("=================================")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("You wake up in a dark dungeon cell.")
        PrintMessage("\n")
        PrintMessage("The door is locked. You must escape!")
        PrintMessage("\n")
        health = 100
        torch = 0
        key = 0
        sword = 0
        coins = 0
        escaped = 0
        turns = 0
        WhileLoop EqualTo(1, 1) {
            IfCondition Not(EqualTo(escaped, 0)) ThenBlock: {
                BreakLoop
            }
            turns = Add(turns, 1)
            IfCondition LessEqual(health, 0) ThenBlock: {
                PrintMessage("")
                PrintMessage("\n")
                PrintMessage("YOU DIED!")
                PrintMessage("\n")
                PrintMessage("Game Over after ")
                PrintMessage("\n")
                AIMacro.SmartPrint(turns)
                PrintMessage("\n")
                PrintMessage(" turns.")
                PrintMessage("\n")
                escaped = 2
            } ElseBlock: {
                IfCondition GreaterThan(turns, 15) ThenBlock: {
                    PrintMessage("")
                    PrintMessage("\n")
                    PrintMessage("You've been in the dungeon too long!")
                    PrintMessage("\n")
                    PrintMessage("You collapse from exhaustion...")
                    PrintMessage("\n")
                    escaped = 2
                } ElseBlock: {
                    PrintMessage("")
                    PrintMessage("\n")
                    PrintMessage("Turn ")
                    PrintMessage("\n")
                    AIMacro.SmartPrint(turns)
                    PrintMessage("\n")
                    PrintMessage(" - Health: ")
                    PrintMessage("\n")
                    AIMacro.SmartPrint(health)
                    PrintMessage("\n")
                    PrintMessage("What do you do?")
                    PrintMessage("\n")
                    PrintMessage("1. Search the cell")
                    PrintMessage("\n")
                    PrintMessage("2. Try the door")
                    PrintMessage("\n")
                    PrintMessage("3. Look out window")
                    PrintMessage("\n")
                    PrintMessage("4. Check inventory")
                    PrintMessage("\n")
                    PrintMessage("5. Rest (restore health)")
                    PrintMessage("\n")
                    PrintMessage("Enter choice (1-5): ")
                    PrintMessage("\n")
                    choice_str = AIMacro.Input("")
                    t0 = AIMacro.Int(choice_str)
                    choice = t0
                    IfCondition EqualTo(choice, 1) ThenBlock: {
                        IfCondition EqualTo(torch, 0) ThenBlock: {
                            PrintMessage("You find a torch under the bed!")
                            PrintMessage("\n")
                            torch = 1
                        } ElseBlock: {
                            IfCondition EqualTo(key, 0) ThenBlock: {
                                IfCondition EqualTo(torch, 1) ThenBlock: {
                                    PrintMessage("Using your torch, you spot a key in a crack!")
                                    PrintMessage("\n")
                                    key = 1
                                } ElseBlock: {
                                    PrintMessage("It's too dark to search properly.")
                                    PrintMessage("\n")
                                }
                            } ElseBlock: {
                                PrintMessage("You've already searched everything.")
                                PrintMessage("\n")
                            }
                        }
                    } ElseBlock: {
                        IfCondition EqualTo(choice, 2) ThenBlock: {
                            IfCondition EqualTo(key, 0) ThenBlock: {
                                PrintMessage("The door is locked tight.")
                                PrintMessage("\n")
                            } ElseBlock: {
                                PrintMessage("You unlock the door with the key!")
                                PrintMessage("\n")
                                PrintMessage("")
                                PrintMessage("\n")
                                PrintMessage("You enter a hallway with two paths:")
                                PrintMessage("\n")
                                PrintMessage("1. Left (you hear growling)")
                                PrintMessage("\n")
                                PrintMessage("2. Right (you see light)")
                                PrintMessage("\n")
                                PrintMessage("Which way? (1 or 2): ")
                                PrintMessage("\n")
                                path_str = AIMacro.Input("")
                                t1 = AIMacro.Int(path_str)
                                path = t1
                                IfCondition EqualTo(path, 1) ThenBlock: {
                                    t2 = fight_monster(sword, health)
                                    result = t2
                                    IfCondition GreaterThan(result, 0) ThenBlock: {
                                        coins = Add(coins, result)
                                    } ElseBlock: {
                                        health = Add(health, result)
                                    }
                                } ElseBlock: {
                                    IfCondition EqualTo(sword, 0) ThenBlock: {
                                        PrintMessage("You reach the exit but a guard blocks it!")
                                        PrintMessage("\n")
                                        PrintMessage("You need a weapon to get past!")
                                        PrintMessage("\n")
                                    } ElseBlock: {
                                        PrintMessage("You defeat the guard with your sword!")
                                        PrintMessage("\n")
                                        PrintMessage("YOU ESCAPED THE DUNGEON!")
                                        PrintMessage("\n")
                                        escaped = 1
                                    }
                                }
                            }
                        } ElseBlock: {
                            IfCondition EqualTo(choice, 3) ThenBlock: {
                                IfCondition EqualTo(sword, 0) ThenBlock: {
                                    PrintMessage("A friendly prisoner passes you a sword through the window!")
                                    PrintMessage("\n")
                                    sword = 1
                                } ElseBlock: {
                                    PrintMessage("You see the outside world. Freedom awaits!")
                                    PrintMessage("\n")
                                }
                            } ElseBlock: {
                                IfCondition EqualTo(choice, 4) ThenBlock: {
                                    check_inventory(torch, key, sword, coins)
                                } ElseBlock: {
                                    IfCondition EqualTo(choice, 5) ThenBlock: {
                                        PrintMessage("You rest and recover 15 health.")
                                        PrintMessage("\n")
                                        health = Add(health, 15)
                                        IfCondition GreaterThan(health, 100) ThenBlock: {
                                            health = 100
                                        }
                                    } ElseBlock: {
                                        PrintMessage("Invalid choice!")
                                        PrintMessage("\n")
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== GAME SUMMARY ===")
        PrintMessage("\n")
        IfCondition EqualTo(escaped, 1) ThenBlock: {
            PrintMessage("VICTORY!")
            PrintMessage("\n")
            score = Add(Add(health, Multiply(coins, 2)), Subtract(100, Multiply(turns, 5)))
            PrintMessage("Final Score: ")
            PrintMessage("\n")
            AIMacro.SmartPrint(score)
            PrintMessage("\n")
            IfCondition GreaterThan(score, 150) ThenBlock: {
                PrintMessage("Rank: MASTER ESCAPIST")
                PrintMessage("\n")
            } ElseBlock: {
                IfCondition GreaterThan(score, 100) ThenBlock: {
                    PrintMessage("Rank: Skilled Adventurer")
                    PrintMessage("\n")
                } ElseBlock: {
                    PrintMessage("Rank: Lucky Survivor")
                    PrintMessage("\n")
                }
            }
        } ElseBlock: {
            PrintMessage("DEFEAT!")
            PrintMessage("\n")
            PrintMessage("Better luck next time!")
            PrintMessage("\n")
        }
        PrintMessage("Total turns: ")
        PrintMessage("\n")
        AIMacro.SmartPrint(turns)
        PrintMessage("\n")
        PrintMessage("Final health: ")
        PrintMessage("\n")
        AIMacro.SmartPrint(health)
        PrintMessage("\n")
        PrintMessage("Gold collected: ")
        PrintMessage("\n")
        AIMacro.SmartPrint(coins)
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
