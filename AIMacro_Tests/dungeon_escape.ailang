LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.check_inventory {
    Input: p_p_torch: Integer
    Input: p_p_key: Integer
    Input: p_p_sword: Integer
    Input: p_p_coins: Integer
    Body: {
        PrintMessage("=== INVENTORY ===")
        PrintMessage("\n")
        PrintMessage("Torch: ")
        PrintMessage("\n")
        AIMacro.SmartPrint(p_p_torch)
        PrintMessage("\n")
        PrintMessage("Key: ")
        PrintMessage("\n")
        AIMacro.SmartPrint(p_p_key)
        PrintMessage("\n")
        PrintMessage("Sword: ")
        PrintMessage("\n")
        AIMacro.SmartPrint(p_p_sword)
        PrintMessage("\n")
        PrintMessage("Gold coins: ")
        PrintMessage("\n")
        AIMacro.SmartPrint(p_p_coins)
        PrintMessage("\n")
        PrintMessage("================")
        PrintMessage("\n")
    }
}

Function.fight_monster {
    Input: p_has_sword: Integer
    Input: p_player_health: Integer
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("A goblin appears!")
        PrintMessage("\n")
        t0 = AIMacro.NumEq(p_has_sword, 1)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            PrintMessage("You swing your sword!")
            PrintMessage("\n")
            PrintMessage("The goblin flees in terror!")
            PrintMessage("\n")
            PrintMessage("It drops 10 gold coins!")
            PrintMessage("\n")
            ReturnValue(10)
        } ElseBlock: {
            PrintMessage("Without a weapon, the goblin attacks!")
            PrintMessage("\n")
            PrintMessage("You lose 25 health and run away!")
            PrintMessage("\n")
            ReturnValue(AIMacro.NumNeg(25))
        }
    }
}

Function.main {
    Body: {
        PrintMessage("=================================")
        PrintMessage("\n")
        PrintMessage("    DUNGEON ESCAPE")
        PrintMessage("\n")
        PrintMessage("=================================")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("You wake up in a dark dungeon cell.")
        PrintMessage("\n")
        PrintMessage("The door is locked. You must escape!")
        PrintMessage("\n")
        health = 100
        torch = 0
        key = 0
        sword = 0
        coins = 0
        escaped = 0
        turns = 0
        WhileLoop EqualTo(1, 1) {
            t0 = AIMacro.NumEq(escaped, 0)
            IfCondition Not(AIMacro.SmartBool(t0)) ThenBlock: {
                BreakLoop
            }
            turns = AIMacro.NumAdd(turns, 1)
            IfCondition AIMacro.SmartBool(AIMacro.NumLe(health, 0)) ThenBlock: {
                PrintMessage("")
                PrintMessage("\n")
                PrintMessage("YOU DIED!")
                PrintMessage("\n")
                PrintMessage("Game Over after ")
                PrintMessage("\n")
                AIMacro.SmartPrint(turns)
                PrintMessage("\n")
                PrintMessage(" turns.")
                PrintMessage("\n")
                escaped = 2
            } ElseBlock: {
                IfCondition AIMacro.SmartBool(AIMacro.NumGt(turns, 15)) ThenBlock: {
                    PrintMessage("")
                    PrintMessage("\n")
                    PrintMessage("You've been in the dungeon too long!")
                    PrintMessage("\n")
                    PrintMessage("You collapse from exhaustion...")
                    PrintMessage("\n")
                    escaped = 2
                } ElseBlock: {
                    PrintMessage("")
                    PrintMessage("\n")
                    PrintMessage("Turn ")
                    PrintMessage("\n")
                    AIMacro.SmartPrint(turns)
                    PrintMessage("\n")
                    PrintMessage(" - Health: ")
                    PrintMessage("\n")
                    AIMacro.SmartPrint(health)
                    PrintMessage("\n")
                    PrintMessage("What do you do?")
                    PrintMessage("\n")
                    PrintMessage("1. Search the cell")
                    PrintMessage("\n")
                    PrintMessage("2. Try the door")
                    PrintMessage("\n")
                    PrintMessage("3. Look out window")
                    PrintMessage("\n")
                    PrintMessage("4. Check inventory")
                    PrintMessage("\n")
                    PrintMessage("5. Rest (restore health)")
                    PrintMessage("\n")
                    PrintMessage("Enter choice (1-5): ")
                    PrintMessage("\n")
                    choice_str = AIMacro.Input("")
                    t1 = AIMacro.Int(choice_str)
                    choice = t1
                    t2 = AIMacro.NumEq(choice, 1)
                    IfCondition AIMacro.SmartBool(t2) ThenBlock: {
                        t3 = AIMacro.NumEq(torch, 0)
                        IfCondition AIMacro.SmartBool(t3) ThenBlock: {
                            PrintMessage("You find a torch under the bed!")
                            PrintMessage("\n")
                            torch = 1
                        } ElseBlock: {
                            t4 = AIMacro.NumEq(key, 0)
                            IfCondition AIMacro.SmartBool(t4) ThenBlock: {
                                t5 = AIMacro.NumEq(torch, 1)
                                IfCondition AIMacro.SmartBool(t5) ThenBlock: {
                                    PrintMessage("Using your torch, you spot a key in a crack!")
                                    PrintMessage("\n")
                                    key = 1
                                } ElseBlock: {
                                    PrintMessage("It's too dark to search properly.")
                                    PrintMessage("\n")
                                }
                            } ElseBlock: {
                                PrintMessage("You've already searched everything.")
                                PrintMessage("\n")
                            }
                        }
                    } ElseBlock: {
                        t6 = AIMacro.NumEq(choice, 2)
                        IfCondition AIMacro.SmartBool(t6) ThenBlock: {
                            t7 = AIMacro.NumEq(key, 0)
                            IfCondition AIMacro.SmartBool(t7) ThenBlock: {
                                PrintMessage("The door is locked tight.")
                                PrintMessage("\n")
                            } ElseBlock: {
                                PrintMessage("You unlock the door with the key!")
                                PrintMessage("\n")
                                PrintMessage("")
                                PrintMessage("\n")
                                PrintMessage("You enter a hallway with two paths:")
                                PrintMessage("\n")
                                PrintMessage("1. Left (you hear growling)")
                                PrintMessage("\n")
                                PrintMessage("2. Right (you see light)")
                                PrintMessage("\n")
                                PrintMessage("Which way? (1 or 2): ")
                                PrintMessage("\n")
                                path_str = AIMacro.Input("")
                                t8 = AIMacro.Int(path_str)
                                path = t8
                                t9 = AIMacro.NumEq(path, 1)
                                IfCondition AIMacro.SmartBool(t9) ThenBlock: {
                                    t10 = fight_monster(sword, health)
                                    result = t10
                                    IfCondition AIMacro.SmartBool(AIMacro.NumGt(result, 0)) ThenBlock: {
                                        coins = AIMacro.NumAdd(coins, result)
                                    } ElseBlock: {
                                        health = AIMacro.NumAdd(health, result)
                                    }
                                } ElseBlock: {
                                    t11 = AIMacro.NumEq(sword, 0)
                                    IfCondition AIMacro.SmartBool(t11) ThenBlock: {
                                        PrintMessage("You reach the exit but a guard blocks it!")
                                        PrintMessage("\n")
                                        PrintMessage("You need a weapon to get past!")
                                        PrintMessage("\n")
                                    } ElseBlock: {
                                        PrintMessage("You defeat the guard with your sword!")
                                        PrintMessage("\n")
                                        PrintMessage("YOU ESCAPED THE DUNGEON!")
                                        PrintMessage("\n")
                                        escaped = 1
                                    }
                                }
                            }
                        } ElseBlock: {
                            t12 = AIMacro.NumEq(choice, 3)
                            IfCondition AIMacro.SmartBool(t12) ThenBlock: {
                                t13 = AIMacro.NumEq(sword, 0)
                                IfCondition AIMacro.SmartBool(t13) ThenBlock: {
                                    PrintMessage("A friendly prisoner passes you a sword through the window!")
                                    PrintMessage("\n")
                                    sword = 1
                                } ElseBlock: {
                                    PrintMessage("You see the outside world. Freedom awaits!")
                                    PrintMessage("\n")
                                }
                            } ElseBlock: {
                                t14 = AIMacro.NumEq(choice, 4)
                                IfCondition AIMacro.SmartBool(t14) ThenBlock: {
                                    check_inventory(torch, key, sword, coins)
                                } ElseBlock: {
                                    t15 = AIMacro.NumEq(choice, 5)
                                    IfCondition AIMacro.SmartBool(t15) ThenBlock: {
                                        PrintMessage("You rest and recover 15 health.")
                                        PrintMessage("\n")
                                        health = AIMacro.NumAdd(health, 15)
                                        IfCondition AIMacro.SmartBool(AIMacro.NumGt(health, 100)) ThenBlock: {
                                            health = 100
                                        }
                                    } ElseBlock: {
                                        PrintMessage("Invalid choice!")
                                        PrintMessage("\n")
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== GAME SUMMARY ===")
        PrintMessage("\n")
        t16 = AIMacro.NumEq(escaped, 1)
        IfCondition AIMacro.SmartBool(t16) ThenBlock: {
            PrintMessage("VICTORY!")
            PrintMessage("\n")
            score = AIMacro.NumAdd(AIMacro.NumAdd(health, AIMacro.NumMul(coins, 2)), AIMacro.NumSub(100, AIMacro.NumMul(turns, 5)))
            PrintMessage("Final Score: ")
            PrintMessage("\n")
            AIMacro.SmartPrint(score)
            PrintMessage("\n")
            IfCondition AIMacro.SmartBool(AIMacro.NumGt(score, 150)) ThenBlock: {
                PrintMessage("Rank: MASTER ESCAPIST")
                PrintMessage("\n")
            } ElseBlock: {
                IfCondition AIMacro.SmartBool(AIMacro.NumGt(score, 100)) ThenBlock: {
                    PrintMessage("Rank: Skilled Adventurer")
                    PrintMessage("\n")
                } ElseBlock: {
                    PrintMessage("Rank: Lucky Survivor")
                    PrintMessage("\n")
                }
            }
        } ElseBlock: {
            PrintMessage("DEFEAT!")
            PrintMessage("\n")
            PrintMessage("Better luck next time!")
            PrintMessage("\n")
        }
        PrintMessage("Total turns: ")
        PrintMessage("\n")
        AIMacro.SmartPrint(turns)
        PrintMessage("\n")
        PrintMessage("Final health: ")
        PrintMessage("\n")
        AIMacro.SmartPrint(health)
        PrintMessage("\n")
        PrintMessage("Gold collected: ")
        PrintMessage("\n")
        AIMacro.SmartPrint(coins)
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
