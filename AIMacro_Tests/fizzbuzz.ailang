LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.fizzbuzz {
    Input: p_n: Integer
    Body: {
        i = 1
        WhileLoop AIMacro.SmartBool(AIMacro.NumLe(i, p_n)) {
            t0 = AIMacro.NumMod(i, 15)
            t1 = AIMacro.NumEq(t0, 0)
            IfCondition AIMacro.SmartBool(t1) ThenBlock: {
                PrintMessage("FizzBuzz")
                PrintMessage("\n")
            } ElseBlock: {
                t2 = AIMacro.NumMod(i, 3)
                t3 = AIMacro.NumEq(t2, 0)
                IfCondition AIMacro.SmartBool(t3) ThenBlock: {
                    PrintMessage("Fizz")
                    PrintMessage("\n")
                } ElseBlock: {
                    t4 = AIMacro.NumMod(i, 5)
                    t5 = AIMacro.NumEq(t4, 0)
                    IfCondition AIMacro.SmartBool(t5) ThenBlock: {
                        PrintMessage("Buzz")
                        PrintMessage("\n")
                    } ElseBlock: {
                        AIMacro.SmartPrint(i)
                        PrintMessage("\n")
                    }
                }
            }
            i = AIMacro.NumAdd(i, 1)
        }
    }
}

Function.main {
    Body: {
        fizzbuzz(30)
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
