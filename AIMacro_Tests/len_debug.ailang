LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


SubRoutine.Main {
        PrintMessage("=== LEN DEBUG TEST ===")
        PrintMessage("\n")
        s = "Hello"
        PrintMessage("String len test:")
        PrintMessage("\n")
        t0 = DictGen_SmartLen(s)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("List len test:")
        PrintMessage("\n")
        nums = Array.Create(5)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        Array.Push(nums, 3)
        Array.Push(nums, 4)
        Array.Push(nums, 5)
        PrintMessage("Created list [1,2,3,4,5]")
        PrintMessage("\n")
        PrintMessage("Checking len...")
        PrintMessage("\n")
        t1 = AIMacro.SmartLen(nums)
        list_len = t1
        PrintMessage("List length:")
        PrintMessage("\n")
        AIMacro.SmartPrint(list_len)
        PrintMessage("\n")
        PrintMessage("Index test:")
        PrintMessage("\n")
        t2 = DictGen_SmartGet(nums, 0)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = DictGen_SmartGet(nums, 1)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = DictGen_SmartGet(nums, 2)
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        PrintMessage("Empty list test:")
        PrintMessage("\n")
        empty = Array.Create(0)
        t5 = AIMacro.SmartLen(empty)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        PrintMessage("=== DONE ===")
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
