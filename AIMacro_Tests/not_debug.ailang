LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


SubRoutine.Main {
        PrintMessage("=== NOT OPERATOR DEBUG ===")
        PrintMessage("\n")
        x = 5
        PrintMessage("Test 1: not True")
        PrintMessage("\n")
        IfCondition Not(1) ThenBlock: {
            PrintMessage("FAIL: not True should be False")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("PASS: not True is False")
            PrintMessage("\n")
        }
        PrintMessage("Test 2: not False")
        PrintMessage("\n")
        IfCondition Not(0) ThenBlock: {
            PrintMessage("PASS: not False is True")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: not False should be True")
            PrintMessage("\n")
        }
        PrintMessage("Test 3: not (x > 100) where x=5")
        PrintMessage("\n")
        IfCondition Not(GreaterThan(x, 100)) ThenBlock: {
            PrintMessage("PASS: not (5 > 100) is True")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: not (5 > 100) should be True")
            PrintMessage("\n")
        }
        PrintMessage("Test 4: not x > 100 where x=5")
        PrintMessage("\n")
        IfCondition Not(GreaterThan(x, 100)) ThenBlock: {
            PrintMessage("PASS: not 5 > 100 is True")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: not 5 > 100 should be True")
            PrintMessage("\n")
        }
        PrintMessage("Test 5: not (x == 5) where x=5")
        PrintMessage("\n")
        IfCondition Not(EqualTo(x, 5)) ThenBlock: {
            PrintMessage("FAIL: not (5 == 5) should be False")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("PASS: not (5 == 5) is False")
            PrintMessage("\n")
        }
        PrintMessage("Test 6: not not True")
        PrintMessage("\n")
        IfCondition Not(Not(1)) ThenBlock: {
            PrintMessage("PASS: not not True is True")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: not not True should be True")
            PrintMessage("\n")
        }
        PrintMessage("=== DONE ===")
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
