LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        PrintMessage("=== NOT OPERATOR DEBUG ===")
        PrintMessage("\n")
        x = 5
        PrintMessage("Test 1: not True")
        PrintMessage("\n")
        t0 = AIMacro.TrueVal()
        t1 = AIMacro.NotVal(t0)
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            PrintMessage("FAIL: not True should be False")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("PASS: not True is False")
            PrintMessage("\n")
        }
        PrintMessage("Test 2: not False")
        PrintMessage("\n")
        t2 = AIMacro.FalseVal()
        t3 = AIMacro.NotVal(t2)
        IfCondition AIMacro.SmartBool(t3) ThenBlock: {
            PrintMessage("PASS: not False is True")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: not False should be True")
            PrintMessage("\n")
        }
        PrintMessage("Test 3: not (x > 100) where x=5")
        PrintMessage("\n")
        IfCondition AIMacro.SmartBool(AIMacro.NotVal(AIMacro.NumGt(x, 100))) ThenBlock: {
            PrintMessage("PASS: not (5 > 100) is True")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: not (5 > 100) should be True")
            PrintMessage("\n")
        }
        PrintMessage("Test 4: not x > 100 where x=5")
        PrintMessage("\n")
        IfCondition AIMacro.SmartBool(AIMacro.NotVal(AIMacro.NumGt(x, 100))) ThenBlock: {
            PrintMessage("PASS: not 5 > 100 is True")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: not 5 > 100 should be True")
            PrintMessage("\n")
        }
        PrintMessage("Test 5: not (x == 5) where x=5")
        PrintMessage("\n")
        t4 = AIMacro.NumEq(x, 5)
        t5 = AIMacro.NotVal(t4)
        IfCondition AIMacro.SmartBool(t5) ThenBlock: {
            PrintMessage("FAIL: not (5 == 5) should be False")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("PASS: not (5 == 5) is False")
            PrintMessage("\n")
        }
        PrintMessage("Test 6: not not True")
        PrintMessage("\n")
        t6 = AIMacro.TrueVal()
        t7 = AIMacro.NotVal(t6)
        t8 = AIMacro.NotVal(t7)
        IfCondition AIMacro.SmartBool(t8) ThenBlock: {
            PrintMessage("PASS: not not True is True")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: not not True should be True")
            PrintMessage("\n")
        }
        PrintMessage("=== DONE ===")
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
