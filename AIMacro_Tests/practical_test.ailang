        Array.Push(expr2, Subtract(0, 4))
        Array.Push(expr2, 3)
        Array.Push(expr2, Subtract(0, 3))
        t42 = eval_rpn(expr2)
        t43 = AIMacro.Str(t42)
        t44 = String.Concat("10 5 / 3 * = ", t43)
        AIMacro.SmartPrint(t44)
        PrintMessage("\n")
        expr3 = Array.Create(7)
        Array.Push(expr3, 2)
        Array.Push(expr3, 3)
        Array.Push(expr3, Subtract(0, 3))
        Array.Push(expr3, 4)
        Array.Push(expr3, 5)
        Array.Push(expr3, Subtract(0, 3))
        Array.Push(expr3, Subtract(0, 1))
        t45 = eval_rpn(expr3)
        t46 = AIMacro.Str(t45)
        t47 = String.Concat("2 3 * 4 5 * + = ", t46)
        AIMacro.SmartPrint(t47)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- HISTOGRAM ---")
        PrintMessage("\n")
        scores = Array.Create(8)
