LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.mean {
    Input: p_arr: Integer
    Body: {
        t0 = DictGen_SmartLen(p_arr)
        t1 = AIMacro.NumEq(t0, 0)
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            ReturnValue(0)
        }
        total = 0
        i = 0
        WhileLoop EqualTo(1, 1) {
            t2 = DictGen_SmartLen(p_arr)
            t3 = AIMacro.NumLt(i, t2)
            IfCondition Not(AIMacro.SmartBool(t3)) ThenBlock: {
                BreakLoop
            }
            t4 = DictGen_SmartGet(p_arr, i)
            total = AIMacro.NumAdd(total, t4)
            i = AIMacro.NumAdd(i, 1)
        }
        t5 = DictGen_SmartLen(p_arr)
        t6 = AIMacro.TrueDiv(total, t5)
        ReturnValue(t6)
    }
}

Function.variance {
    Input: p_arr: Integer
    Body: {
        t0 = DictGen_SmartLen(p_arr)
        t1 = AIMacro.NumEq(t0, 0)
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            ReturnValue(0)
        }
        t2 = mean(p_arr)
        avg = t2
        sum_sq = 0
        i = 0
        WhileLoop EqualTo(1, 1) {
            t3 = DictGen_SmartLen(p_arr)
            t4 = AIMacro.NumLt(i, t3)
            IfCondition Not(AIMacro.SmartBool(t4)) ThenBlock: {
                BreakLoop
            }
            t5 = DictGen_SmartGet(p_arr, i)
            t6 = AIMacro.NumSub(t5, avg)
            diff = t6
            sum_sq = AIMacro.NumAdd(sum_sq, AIMacro.NumMul(diff, diff))
            i = AIMacro.NumAdd(i, 1)
        }
        t7 = DictGen_SmartLen(p_arr)
        t8 = AIMacro.TrueDiv(sum_sq, t7)
        ReturnValue(t8)
    }
}

Function.isqrt {
    Input: p_n: Integer
    Body: {
        IfCondition AIMacro.SmartBool(AIMacro.NumLt(p_n, 2)) ThenBlock: {
            ReturnValue(p_n)
        }
        x = p_n
        y = AIMacro.FloorDiv(AIMacro.NumAdd(x, 1), 2)
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(y, x)) {
            x = y
            y = AIMacro.FloorDiv(AIMacro.NumAdd(x, AIMacro.FloorDiv(p_n, x)), 2)
        }
        ReturnValue(x)
    }
}

Function.filter_greater_than {
    Input: p_arr: Integer
    Input: p_threshold: Integer
    Body: {
        result = Array.Create(0)
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_arr)
            t1 = AIMacro.NumLt(i, t0)
            IfCondition Not(AIMacro.SmartBool(t1)) ThenBlock: {
                BreakLoop
            }
            t2 = DictGen_SmartGet(p_arr, i)
            t3 = AIMacro.NumGt(t2, p_threshold)
            IfCondition AIMacro.SmartBool(t3) ThenBlock: {
                t4 = DictGen_SmartGet(p_arr, i)
                AIMacro.SmartPush(result, t4)
            }
            i = AIMacro.NumAdd(i, 1)
        }
        ReturnValue(result)
    }
}

Function.filter_even {
    Input: p_arr: Integer
    Body: {
        result = Array.Create(0)
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_arr)
            t1 = AIMacro.NumLt(i, t0)
            IfCondition Not(AIMacro.SmartBool(t1)) ThenBlock: {
                BreakLoop
            }
            t2 = DictGen_SmartGet(p_arr, i)
            t3 = AIMacro.NumMod(t2, 2)
            t4 = AIMacro.NumEq(t3, 0)
            IfCondition AIMacro.SmartBool(t4) ThenBlock: {
                t5 = DictGen_SmartGet(p_arr, i)
                AIMacro.SmartPush(result, t5)
            }
            i = AIMacro.NumAdd(i, 1)
        }
        ReturnValue(result)
    }
}

Function.map_double {
    Input: p_arr: Integer
    Body: {
        result = Array.Create(0)
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_arr)
            t1 = AIMacro.NumLt(i, t0)
            IfCondition Not(AIMacro.SmartBool(t1)) ThenBlock: {
                BreakLoop
            }
            t2 = DictGen_SmartGet(p_arr, i)
            t3 = AIMacro.NumMul(t2, 2)
            AIMacro.SmartPush(result, t3)
            i = AIMacro.NumAdd(i, 1)
        }
        ReturnValue(result)
    }
}

Function.map_square {
    Input: p_arr: Integer
    Body: {
        result = Array.Create(0)
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_arr)
            t1 = AIMacro.NumLt(i, t0)
            IfCondition Not(AIMacro.SmartBool(t1)) ThenBlock: {
                BreakLoop
            }
            t2 = DictGen_SmartGet(p_arr, i)
            t3 = DictGen_SmartGet(p_arr, i)
            t4 = AIMacro.NumMul(t2, t3)
            AIMacro.SmartPush(result, t4)
            i = AIMacro.NumAdd(i, 1)
        }
        ReturnValue(result)
    }
}

Function.reduce_sum {
    Input: p_arr: Integer
    Body: {
        total = 0
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_arr)
            t1 = AIMacro.NumLt(i, t0)
            IfCondition Not(AIMacro.SmartBool(t1)) ThenBlock: {
                BreakLoop
            }
            t2 = DictGen_SmartGet(p_arr, i)
            total = AIMacro.NumAdd(total, t2)
            i = AIMacro.NumAdd(i, 1)
        }
        ReturnValue(total)
    }
}

Function.reduce_product {
    Input: p_arr: Integer
    Body: {
        t0 = DictGen_SmartLen(p_arr)
        t1 = AIMacro.NumEq(t0, 0)
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            ReturnValue(0)
        }
        prod = 1
        i = 0
        WhileLoop EqualTo(1, 1) {
            t2 = DictGen_SmartLen(p_arr)
            t3 = AIMacro.NumLt(i, t2)
            IfCondition Not(AIMacro.SmartBool(t3)) ThenBlock: {
                BreakLoop
            }
            t4 = DictGen_SmartGet(p_arr, i)
            prod = AIMacro.NumMul(prod, t4)
            i = AIMacro.NumAdd(i, 1)
        }
        ReturnValue(prod)
    }
}

Function.matrix_create {
    Input: p_rows: Integer
    Input: p_cols: Integer
    Body: {
        size = AIMacro.NumMul(p_rows, p_cols)
        m = Array.Create(0)
        i = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(i, size)) {
            AIMacro.SmartPush(m, 0)
            i = AIMacro.NumAdd(i, 1)
        }
        ReturnValue(m)
    }
}

Function.matrix_get {
    Input: p_m: Integer
    Input: p_cols: Integer
    Input: p_row: Integer
    Input: p_col: Integer
    Body: {
        t0 = AIMacro.NumMul(p_row, p_cols)
        t1 = AIMacro.NumAdd(t0, p_col)
        t2 = DictGen_SmartGet(p_m, t1)
        ReturnValue(t2)
    }
}

Function.matrix_set {
    Input: p_m: Integer
    Input: p_cols: Integer
    Input: p_row: Integer
    Input: p_col: Integer
    Input: p_val: Integer
    Body: {
        DictGen_SmartSet(p_m, AIMacro.NumAdd(AIMacro.NumMul(p_row, p_cols), p_col), p_val)
    }
}

Function.matrix_print {
    Input: p_m: Integer
    Input: p_rows: Integer
    Input: p_cols: Integer
    Body: {
        r = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(r, p_rows)) {
            line = "["
            c = 0
            WhileLoop AIMacro.SmartBool(AIMacro.NumLt(c, p_cols)) {
                IfCondition AIMacro.SmartBool(AIMacro.NumGt(c, 0)) ThenBlock: {
                    t0 = String.Concat(line, ", ")
                    line = t0
                }
                t1 = matrix_get(p_m, p_cols, r, c)
                val = t1
                IfCondition AIMacro.SmartBool(AIMacro.NumLt(val, 10)) ThenBlock: {
                    t2 = String.Concat(line, " ")
                    line = t2
                }
                t3 = AIMacro.Str(val)
                t4 = String.Concat(line, t3)
                line = t4
                c = AIMacro.NumAdd(c, 1)
            }
            t5 = String.Concat(line, "]")
            line = t5
            AIMacro.SmartPrint(line)
            PrintMessage("\n")
            r = AIMacro.NumAdd(r, 1)
        }
    }
}

Function.matrix_add {
    Input: p_a: Integer
    Input: p_b: Integer
    Input: p_rows: Integer
    Input: p_cols: Integer
    Body: {
        t0 = matrix_create(p_rows, p_cols)
        result = t0
        r = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(r, p_rows)) {
            c = 0
            WhileLoop AIMacro.SmartBool(AIMacro.NumLt(c, p_cols)) {
                t1 = matrix_get(p_a, p_cols, r, c)
                t2 = matrix_get(p_b, p_cols, r, c)
                t3 = AIMacro.NumAdd(t1, t2)
                val = t3
                matrix_set(result, p_cols, r, c, val)
                c = AIMacro.NumAdd(c, 1)
            }
            r = AIMacro.NumAdd(r, 1)
        }
        ReturnValue(result)
    }
}

Function.matrix_multiply {
    Input: p_a: Integer
    Input: p_b: Integer
    Input: p_rows_a: Integer
    Input: p_cols_a: Integer
    Input: p_cols_b: Integer
    Body: {
        t0 = matrix_create(p_rows_a, p_cols_b)
        result = t0
        r = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(r, p_rows_a)) {
            c = 0
            WhileLoop AIMacro.SmartBool(AIMacro.NumLt(c, p_cols_b)) {
                sum = 0
                k = 0
                WhileLoop AIMacro.SmartBool(AIMacro.NumLt(k, p_cols_a)) {
                    t1 = matrix_get(p_a, p_cols_a, r, k)
                    t2 = matrix_get(p_b, p_cols_b, k, c)
                    t3 = AIMacro.NumMul(t1, t2)
                    sum = AIMacro.NumAdd(sum, t3)
                    k = AIMacro.NumAdd(k, 1)
                }
                matrix_set(result, p_cols_b, r, c, sum)
                c = AIMacro.NumAdd(c, 1)
            }
            r = AIMacro.NumAdd(r, 1)
        }
        ReturnValue(result)
    }
}

Function.stack_create {
    Body: {
        t0 = Array.Create(0)
        ReturnValue(t0)
    }
}

Function.stack_push {
    Input: p_stack: Integer
    Input: p_val: Integer
    Body: {
        __oop_args_0 = Array.Create(1)
        Array.Push(__oop_args_0, p_val)
        OOP.MethodCall(p_stack, "append", __oop_args_0)
    }
}

Function.stack_pop {
    Input: p_stack: Integer
    Body: {
        t0 = DictGen_SmartLen(p_stack)
        t1 = AIMacro.NumEq(t0, 0)
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            ReturnValue(AIMacro.NumNeg(1))
        }
        t2 = DictGen_SmartLen(p_stack)
        t3 = AIMacro.NumSub(t2, 1)
        t4 = DictGen_SmartGet(p_stack, t3)
        val = t4
        ReturnValue(val)
    }
}

Function.stack_peek {
    Input: p_stack: Integer
    Body: {
        t0 = DictGen_SmartLen(p_stack)
        t1 = AIMacro.NumEq(t0, 0)
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            ReturnValue(AIMacro.NumNeg(1))
        }
        t2 = DictGen_SmartLen(p_stack)
        t3 = AIMacro.NumSub(t2, 1)
        t4 = DictGen_SmartGet(p_stack, t3)
        ReturnValue(t4)
    }
}

Function.stack_is_empty {
    Input: p_stack: Integer
    Body: {
        t0 = DictGen_SmartLen(p_stack)
        t1 = AIMacro.NumEq(t0, 0)
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.eval_rpn {
    Input: p_tokens: Integer
    Body: {
        stack = Array.Create(0)
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_tokens)
            t1 = AIMacro.NumLt(i, t0)
            IfCondition Not(AIMacro.SmartBool(t1)) ThenBlock: {
                BreakLoop
            }
            t2 = DictGen_SmartGet(p_tokens, i)
            tok = t2
            IfCondition AIMacro.SmartBool(AIMacro.NumGe(tok, 0)) ThenBlock: {
                AIMacro.SmartPush(stack, tok)
            } ElseBlock: {
                t3 = AIMacro.SmartLen(stack)
                t4 = AIMacro.NumSub(t3, 1)
                t5 = DictGen_SmartGet(stack, t4)
                b = t5
                new_stack = Array.Create(0)
                j = 0
                WhileLoop EqualTo(1, 1) {
                    t6 = AIMacro.SmartLen(stack)
                    t7 = AIMacro.NumSub(t6, 1)
                    t8 = AIMacro.NumLt(j, t7)
                    IfCondition Not(AIMacro.SmartBool(t8)) ThenBlock: {
                        BreakLoop
                    }
                    t9 = DictGen_SmartGet(stack, j)
                    AIMacro.SmartPush(new_stack, t9)
                    j = AIMacro.NumAdd(j, 1)
                }
                stack = new_stack
                t10 = AIMacro.SmartLen(stack)
                t11 = AIMacro.NumSub(t10, 1)
                t12 = DictGen_SmartGet(stack, t11)
                a = t12
                new_stack = Array.Create(0)
                j = 0
                WhileLoop EqualTo(1, 1) {
                    t13 = AIMacro.SmartLen(stack)
                    t14 = AIMacro.NumSub(t13, 1)
                    t15 = AIMacro.NumLt(j, t14)
                    IfCondition Not(AIMacro.SmartBool(t15)) ThenBlock: {
                        BreakLoop
                    }
                    t16 = DictGen_SmartGet(stack, j)
                    AIMacro.SmartPush(new_stack, t16)
                    j = AIMacro.NumAdd(j, 1)
                }
                stack = new_stack
                result = 0
                t17 = AIMacro.NumNeg(1)
                t18 = AIMacro.NumEq(tok, t17)
                IfCondition AIMacro.SmartBool(t18) ThenBlock: {
                    result = AIMacro.NumAdd(a, b)
                } ElseBlock: {
                    t19 = AIMacro.NumNeg(2)
                    t20 = AIMacro.NumEq(tok, t19)
                    IfCondition AIMacro.SmartBool(t20) ThenBlock: {
                        result = AIMacro.NumSub(a, b)
                    } ElseBlock: {
                        t21 = AIMacro.NumNeg(3)
                        t22 = AIMacro.NumEq(tok, t21)
                        IfCondition AIMacro.SmartBool(t22) ThenBlock: {
                            result = AIMacro.NumMul(a, b)
                        } ElseBlock: {
                            t23 = AIMacro.NumNeg(4)
                            t24 = AIMacro.NumEq(tok, t23)
                            IfCondition AIMacro.SmartBool(t24) ThenBlock: {
                                result = AIMacro.TrueDiv(a, b)
                            }
                        }
                    }
                }
                AIMacro.SmartPush(stack, result)
            }
            i = AIMacro.NumAdd(i, 1)
        }
        t25 = DictGen_SmartGet(stack, 0)
        ReturnValue(t25)
    }
}

Function.print_histogram {
    Input: p_data: Integer
    Input: p_max_width: Integer
    Body: {
        max_val = 0
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_data)
            t1 = AIMacro.NumLt(i, t0)
            IfCondition Not(AIMacro.SmartBool(t1)) ThenBlock: {
                BreakLoop
            }
            t2 = DictGen_SmartGet(p_data, i)
            t3 = AIMacro.NumGt(t2, max_val)
            IfCondition AIMacro.SmartBool(t3) ThenBlock: {
                t4 = DictGen_SmartGet(p_data, i)
                max_val = t4
            }
            i = AIMacro.NumAdd(i, 1)
        }
        t5 = AIMacro.NumEq(max_val, 0)
        IfCondition AIMacro.SmartBool(t5) ThenBlock: {
            max_val = 1
        }
        i = 0
        WhileLoop EqualTo(1, 1) {
            t6 = DictGen_SmartLen(p_data)
            t7 = AIMacro.NumLt(i, t6)
            IfCondition Not(AIMacro.SmartBool(t7)) ThenBlock: {
                BreakLoop
            }
            t8 = DictGen_SmartGet(p_data, i)
            val = t8
            bar_len = AIMacro.TrueDiv(AIMacro.NumMul(val, p_max_width), max_val)
            t9 = AIMacro.Str(i)
            t10 = String.Concat(t9, ": ")
            label = t10
            IfCondition AIMacro.SmartBool(AIMacro.NumLt(i, 10)) ThenBlock: {
                t11 = String.Concat(" ", label)
                label = t11
            }
            bar = String.Repeat("#", AIMacro.Int(bar_len))
            t12 = AIMacro.Str(val)
            t13 = String.Concat(" (", t12)
            t14 = String.Concat(t13, ")")
            val_str = t14
                        t15 = String.Concat(label, bar)
            t16 = String.Concat(t15, val_str)
AIMacro.SmartPrint(t16)
            PrintMessage("\n")
            i = AIMacro.NumAdd(i, 1)
        }
    }
}

Function.hash_code {
    Input: p_key: Integer
    Input: p_size: Integer
    Body: {
        t0 = AIMacro.NumMod(p_key, p_size)
        ReturnValue(t0)
    }
}

Function.hashtable_create {
    Input: p_size: Integer
    Body: {
        table = Array.Create(0)
        i = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(i, p_size)) {
            AIMacro.SmartPush(table, 0)
            i = AIMacro.NumAdd(i, 1)
        }
        ReturnValue(table)
    }
}

Function.list_to_string {
    Input: p_arr: Integer
    Body: {
        result = "["
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_arr)
            t1 = AIMacro.NumLt(i, t0)
            IfCondition Not(AIMacro.SmartBool(t1)) ThenBlock: {
                BreakLoop
            }
            IfCondition AIMacro.SmartBool(AIMacro.NumGt(i, 0)) ThenBlock: {
                t2 = String.Concat(result, ", ")
                result = t2
            }
            t3 = DictGen_SmartGet(p_arr, i)
            t4 = AIMacro.Str(t3)
            t5 = String.Concat(result, t4)
            result = t5
            i = AIMacro.NumAdd(i, 1)
        }
        t6 = String.Concat(result, "]")
        ReturnValue(t6)
    }
}

Function.list_reverse {
    Input: p_arr: Integer
    Body: {
        result = Array.Create(0)
        t0 = DictGen_SmartLen(p_arr)
        t1 = AIMacro.NumSub(t0, 1)
        i = t1
        WhileLoop AIMacro.SmartBool(AIMacro.NumGe(i, 0)) {
            t2 = DictGen_SmartGet(p_arr, i)
            AIMacro.SmartPush(result, t2)
            i = AIMacro.NumSub(i, 1)
        }
        ReturnValue(result)
    }
}

Function.list_copy {
    Input: p_arr: Integer
    Body: {
        result = Array.Create(0)
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_arr)
            t1 = AIMacro.NumLt(i, t0)
            IfCondition Not(AIMacro.SmartBool(t1)) ThenBlock: {
                BreakLoop
            }
            t2 = DictGen_SmartGet(p_arr, i)
            AIMacro.SmartPush(result, t2)
            i = AIMacro.NumAdd(i, 1)
        }
        ReturnValue(result)
    }
}

Function.main {
    Body: {
                t0 = String.Repeat("=", AIMacro.Int(60))
AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("PRACTICAL PROGRAMMING TEST")
        PrintMessage("\n")
                t1 = String.Repeat("=", AIMacro.Int(60))
AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- STATISTICS ---")
        PrintMessage("\n")
        data = Array.Create(10)
        Array.Push(data, 10)
        Array.Push(data, 20)
        Array.Push(data, 30)
        Array.Push(data, 40)
        Array.Push(data, 50)
        Array.Push(data, 60)
        Array.Push(data, 70)
        Array.Push(data, 80)
        Array.Push(data, 90)
        Array.Push(data, 100)
        t2 = list_to_string(data)
        t3 = String.Concat("Data: ", t2)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = mean(data)
        t5 = AIMacro.Str(t4)
        t6 = String.Concat("Mean: ", t5)
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        t7 = variance(data)
        t8 = AIMacro.Str(t7)
        t9 = String.Concat("Variance: ", t8)
        AIMacro.SmartPrint(t9)
        PrintMessage("\n")
        t10 = variance(data)
        t11 = isqrt(t10)
        t12 = AIMacro.Str(t11)
        t13 = String.Concat("StdDev (approx): ", t12)
        AIMacro.SmartPrint(t13)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- DATA PROCESSING ---")
        PrintMessage("\n")
        nums = Array.Create(10)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        Array.Push(nums, 3)
        Array.Push(nums, 4)
        Array.Push(nums, 5)
        Array.Push(nums, 6)
        Array.Push(nums, 7)
        Array.Push(nums, 8)
        Array.Push(nums, 9)
        Array.Push(nums, 10)
        t14 = list_to_string(nums)
        t15 = String.Concat("Original: ", t14)
        AIMacro.SmartPrint(t15)
        PrintMessage("\n")
        t16 = filter_greater_than(nums, 5)
        t17 = list_to_string(t16)
        t18 = String.Concat("Filter > 5: ", t17)
        AIMacro.SmartPrint(t18)
        PrintMessage("\n")
        t19 = filter_even(nums)
        t20 = list_to_string(t19)
        t21 = String.Concat("Filter even: ", t20)
        AIMacro.SmartPrint(t21)
        PrintMessage("\n")
        t22 = map_double(nums)
        t23 = list_to_string(t22)
        t24 = String.Concat("Map double: ", t23)
        AIMacro.SmartPrint(t24)
        PrintMessage("\n")
        t25 = map_square(nums)
        t26 = list_to_string(t25)
        t27 = String.Concat("Map square: ", t26)
        AIMacro.SmartPrint(t27)
        PrintMessage("\n")
        t28 = reduce_sum(nums)
        t29 = AIMacro.Str(t28)
        t30 = String.Concat("Reduce sum: ", t29)
        AIMacro.SmartPrint(t30)
        PrintMessage("\n")
        t31 = Array.Create(5)
        Array.Push(t31, 1)
        Array.Push(t31, 2)
        Array.Push(t31, 3)
        Array.Push(t31, 4)
        Array.Push(t31, 5)
        t32 = reduce_product(t31)
        t33 = AIMacro.Str(t32)
        t34 = String.Concat("Reduce product (1-5): ", t33)
        AIMacro.SmartPrint(t34)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- MATRIX OPERATIONS ---")
        PrintMessage("\n")
        t35 = matrix_create(3, 3)
        m1 = t35
        t36 = matrix_create(3, 3)
        m2 = t36
        val = 1
        r = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(r, 3)) {
            c = 0
            WhileLoop AIMacro.SmartBool(AIMacro.NumLt(c, 3)) {
                matrix_set(m1, 3, r, c, val)
                val = AIMacro.NumAdd(val, 1)
                c = AIMacro.NumAdd(c, 1)
            }
            r = AIMacro.NumAdd(r, 1)
        }
        val = 9
        r = 0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(r, 3)) {
            c = 0
            WhileLoop AIMacro.SmartBool(AIMacro.NumLt(c, 3)) {
                matrix_set(m2, 3, r, c, val)
                val = AIMacro.NumSub(val, 1)
                c = AIMacro.NumAdd(c, 1)
            }
            r = AIMacro.NumAdd(r, 1)
        }
        PrintMessage("Matrix A:")
        PrintMessage("\n")
        matrix_print(m1, 3, 3)
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("Matrix B:")
        PrintMessage("\n")
        matrix_print(m2, 3, 3)
        PrintMessage("")
        PrintMessage("\n")
        t37 = matrix_add(m1, m2, 3, 3)
        m3 = t37
        PrintMessage("A + B:")
        PrintMessage("\n")
        matrix_print(m3, 3, 3)
        PrintMessage("")
        PrintMessage("\n")
        t38 = matrix_multiply(m1, m2, 3, 3, 3)
        m4 = t38
        PrintMessage("A * B:")
        PrintMessage("\n")
        matrix_print(m4, 3, 3)
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- RPN CALCULATOR ---")
        PrintMessage("\n")
        expr1 = Array.Create(5)
        Array.Push(expr1, 3)
        Array.Push(expr1, 4)
        Array.Push(expr1, AIMacro.NumNeg(1))
        Array.Push(expr1, 2)
        Array.Push(expr1, AIMacro.NumNeg(3))
        t39 = eval_rpn(expr1)
        t40 = AIMacro.Str(t39)
        t41 = String.Concat("3 4 + 2 * = ", t40)
        AIMacro.SmartPrint(t41)
        PrintMessage("\n")
        expr2 = Array.Create(5)
        Array.Push(expr2, 10)
        Array.Push(expr2, 5)
        Array.Push(expr2, AIMacro.NumNeg(4))
        Array.Push(expr2, 3)
        Array.Push(expr2, AIMacro.NumNeg(3))
        t42 = eval_rpn(expr2)
        t43 = AIMacro.Str(t42)
        t44 = String.Concat("10 5 / 3 * = ", t43)
        AIMacro.SmartPrint(t44)
        PrintMessage("\n")
        expr3 = Array.Create(7)
        Array.Push(expr3, 2)
        Array.Push(expr3, 3)
        Array.Push(expr3, AIMacro.NumNeg(3))
        Array.Push(expr3, 4)
        Array.Push(expr3, 5)
        Array.Push(expr3, AIMacro.NumNeg(3))
        Array.Push(expr3, AIMacro.NumNeg(1))
        t45 = eval_rpn(expr3)
        t46 = AIMacro.Str(t45)
        t47 = String.Concat("2 3 * 4 5 * + = ", t46)
        AIMacro.SmartPrint(t47)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- HISTOGRAM ---")
        PrintMessage("\n")
        scores = Array.Create(8)
        Array.Push(scores, 15)
        Array.Push(scores, 42)
        Array.Push(scores, 38)
        Array.Push(scores, 27)
        Array.Push(scores, 51)
        Array.Push(scores, 33)
        Array.Push(scores, 19)
        Array.Push(scores, 45)
        t48 = list_to_string(scores)
        t49 = String.Concat("Data: ", t48)
        AIMacro.SmartPrint(t49)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        print_histogram(scores, 40)
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("--- LIST UTILITIES ---")
        PrintMessage("\n")
        arr = Array.Create(5)
        Array.Push(arr, 1)
        Array.Push(arr, 2)
        Array.Push(arr, 3)
        Array.Push(arr, 4)
        Array.Push(arr, 5)
        t50 = list_to_string(arr)
        t51 = String.Concat("Original: ", t50)
        AIMacro.SmartPrint(t51)
        PrintMessage("\n")
        t52 = list_reverse(arr)
        t53 = list_to_string(t52)
        t54 = String.Concat("Reversed: ", t53)
        AIMacro.SmartPrint(t54)
        PrintMessage("\n")
        t55 = list_copy(arr)
        t56 = list_to_string(t55)
        t57 = String.Concat("Copy: ", t56)
        AIMacro.SmartPrint(t57)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
                t58 = String.Repeat("=", AIMacro.Int(60))
AIMacro.SmartPrint(t58)
        PrintMessage("\n")
        PrintMessage("ALL PRACTICAL TESTS COMPLETE!")
        PrintMessage("\n")
                t59 = String.Repeat("=", AIMacro.Int(60))
AIMacro.SmartPrint(t59)
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
