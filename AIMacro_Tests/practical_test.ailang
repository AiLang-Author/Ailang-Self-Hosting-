Function.mean {
    Input: p_arr: Integer
    Body: {
        t0 = DictGen_SmartLen(p_arr)
        IfCondition EqualTo(t0, 0) ThenBlock: {
            ReturnValue(0)
        }
        total = 0
        i = 0
        WhileLoop EqualTo(1, 1) {
            t1 = DictGen_SmartLen(p_arr)
            IfCondition Not(LessThan(i, t1)) ThenBlock: {
                BreakLoop
            }
            t2 = DictGen_SmartGet(p_arr, i)
            total = Add(total, t2)
            i = Add(i, 1)
        }
        t3 = DictGen_SmartLen(p_arr)
        t4 = Divide(total, t3)
        ReturnValue(t4)
    }
}

Function.variance {
    Input: p_arr: Integer
    Body: {
        t0 = DictGen_SmartLen(p_arr)
        IfCondition EqualTo(t0, 0) ThenBlock: {
            ReturnValue(0)
        }
        t1 = mean(p_arr)
        avg = t1
        sum_sq = 0
        i = 0
        WhileLoop EqualTo(1, 1) {
            t2 = DictGen_SmartLen(p_arr)
            IfCondition Not(LessThan(i, t2)) ThenBlock: {
                BreakLoop
            }
            t3 = DictGen_SmartGet(p_arr, i)
            t4 = Subtract(t3, avg)
            diff = t4
            sum_sq = Add(sum_sq, Multiply(diff, diff))
            i = Add(i, 1)
        }
        t5 = DictGen_SmartLen(p_arr)
        t6 = Divide(sum_sq, t5)
        ReturnValue(t6)
    }
}

Function.isqrt {
    Input: p_n: Integer
    Body: {
        IfCondition LessThan(p_n, 2) ThenBlock: {
            ReturnValue(p_n)
        }
        x = p_n
        y = Divide(Add(x, 1), 2)
        WhileLoop LessThan(y, x) {
            x = y
            y = Divide(Add(x, Divide(p_n, x)), 2)
        }
        ReturnValue(x)
    }
}

Function.filter_greater_than {
    Input: p_arr: Integer
    Input: p_threshold: Integer
    Body: {
        result = Array.Create(0)
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_arr)
            IfCondition Not(LessThan(i, t0)) ThenBlock: {
                BreakLoop
            }
            t1 = DictGen_SmartGet(p_arr, i)
            IfCondition GreaterThan(t1, p_threshold) ThenBlock: {
                t2 = DictGen_SmartGet(p_arr, i)
                AIMacro.SmartPush(result, t2)
            }
            i = Add(i, 1)
        }
        ReturnValue(result)
    }
}

Function.filter_even {
    Input: p_arr: Integer
    Body: {
        result = Array.Create(0)
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_arr)
            IfCondition Not(LessThan(i, t0)) ThenBlock: {
                BreakLoop
            }
            t1 = DictGen_SmartGet(p_arr, i)
            IfCondition EqualTo(Modulo(t1, 2), 0) ThenBlock: {
                t2 = DictGen_SmartGet(p_arr, i)
                AIMacro.SmartPush(result, t2)
            }
            i = Add(i, 1)
        }
        ReturnValue(result)
    }
}

Function.map_double {
    Input: p_arr: Integer
    Body: {
        result = Array.Create(0)
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_arr)
            IfCondition Not(LessThan(i, t0)) ThenBlock: {
                BreakLoop
            }
            t1 = DictGen_SmartGet(p_arr, i)
            t2 = Multiply(t1, 2)
            AIMacro.SmartPush(result, t2)
            i = Add(i, 1)
        }
        ReturnValue(result)
    }
}

Function.map_square {
    Input: p_arr: Integer
    Body: {
        result = Array.Create(0)
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_arr)
            IfCondition Not(LessThan(i, t0)) ThenBlock: {
                BreakLoop
            }
            t1 = DictGen_SmartGet(p_arr, i)
            t2 = DictGen_SmartGet(p_arr, i)
            t3 = Multiply(t1, t2)
            AIMacro.SmartPush(result, t3)
            i = Add(i, 1)
        }
        ReturnValue(result)
    }
}

Function.reduce_sum {
    Input: p_arr: Integer
    Body: {
        total = 0
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_arr)
            IfCondition Not(LessThan(i, t0)) ThenBlock: {
                BreakLoop
            }
            t1 = DictGen_SmartGet(p_arr, i)
            total = Add(total, t1)
            i = Add(i, 1)
        }
        ReturnValue(total)
    }
}

Function.reduce_product {
    Input: p_arr: Integer
    Body: {
        t0 = DictGen_SmartLen(p_arr)
        IfCondition EqualTo(t0, 0) ThenBlock: {
            ReturnValue(0)
        }
        prod = 1
        i = 0
        WhileLoop EqualTo(1, 1) {
            t1 = DictGen_SmartLen(p_arr)
            IfCondition Not(LessThan(i, t1)) ThenBlock: {
                BreakLoop
            }
            t2 = DictGen_SmartGet(p_arr, i)
            prod = Multiply(prod, t2)
            i = Add(i, 1)
        }
        ReturnValue(prod)
    }
}

Function.matrix_create {
    Input: p_rows: Integer
    Input: p_cols: Integer
    Body: {
        size = Multiply(p_rows, p_cols)
        m = Array.Create(0)
        i = 0
        WhileLoop LessThan(i, size) {
            AIMacro.SmartPush(m, 0)
            i = Add(i, 1)
        }
        ReturnValue(m)
    }
}

Function.matrix_get {
    Input: p_m: Integer
    Input: p_cols: Integer
    Input: p_row: Integer
    Input: p_col: Integer
    Body: {
        t0 = Multiply(p_row, p_cols)
        t1 = Add(t0, p_col)
        t2 = DictGen_SmartGet(p_m, t1)
        ReturnValue(t2)
    }
}

Function.matrix_set {
    Input: p_m: Integer
    Input: p_cols: Integer
    Input: p_row: Integer
    Input: p_col: Integer
    Input: p_val: Integer
    Body: {
        DictGen_SmartSet(p_m, Add(Multiply(p_row, p_cols), p_col), p_val)
    }
}

Function.matrix_print {
    Input: p_m: Integer
    Input: p_rows: Integer
    Input: p_cols: Integer
    Body: {
        r = 0
        WhileLoop LessThan(r, p_rows) {
            line = "["
            c = 0
            WhileLoop LessThan(c, p_cols) {
                IfCondition GreaterThan(c, 0) ThenBlock: {
                    t0 = String.Concat(line, ", ")
                    line = t0
                }
                t1 = matrix_get(p_m, p_cols, r, c)
                val = t1
                IfCondition LessThan(val, 10) ThenBlock: {
                    t2 = String.Concat(line, " ")
                    line = t2
                }
                t3 = AIMacro.Str(val)
                t4 = String.Concat(line, t3)
                line = t4
                c = Add(c, 1)
            }
            t5 = String.Concat(line, "]")
            line = t5
            AIMacro.SmartPrint(line)
            PrintMessage("\n")
            r = Add(r, 1)
        }
    }
}

Function.matrix_add {
    Input: p_a: Integer
    Input: p_b: Integer
    Input: p_rows: Integer
    Input: p_cols: Integer
    Body: {
        t0 = matrix_create(p_rows, p_cols)
        result = t0
        r = 0
        WhileLoop LessThan(r, p_rows) {
            c = 0
            WhileLoop LessThan(c, p_cols) {
                t1 = matrix_get(p_a, p_cols, r, c)
                t2 = matrix_get(p_b, p_cols, r, c)
                t3 = Add(t1, t2)
                val = t3
                matrix_set(result, p_cols, r, c, val)
                c = Add(c, 1)
            }
            r = Add(r, 1)
        }
        ReturnValue(result)
    }
}

Function.matrix_multiply {
    Input: p_a: Integer
    Input: p_b: Integer
    Input: p_rows_a: Integer
    Input: p_cols_a: Integer
    Input: p_cols_b: Integer
    Body: {
        t0 = matrix_create(p_rows_a, p_cols_b)
        result = t0
        r = 0
        WhileLoop LessThan(r, p_rows_a) {
            c = 0
            WhileLoop LessThan(c, p_cols_b) {
                sum = 0
                k = 0
                WhileLoop LessThan(k, p_cols_a) {
                    t1 = matrix_get(p_a, p_cols_a, r, k)
                    t2 = matrix_get(p_b, p_cols_b, k, c)
                    t3 = Multiply(t1, t2)
                    sum = Add(sum, t3)
                    k = Add(k, 1)
                }
                matrix_set(result, p_cols_b, r, c, sum)
                c = Add(c, 1)
            }
            r = Add(r, 1)
        }
        ReturnValue(result)
    }
}

Function.stack_create {
    Body: {
        ReturnValue(Array.Create(0))
    }
}

Function.stack_push {
    Input: p_stack: Integer
    Input: p_val: Integer
    Body: {
        __oop_args_0 = Array.Create(1)
        Array.Push(__oop_args_0, p_val)
        OOP.MethodCall(p_stack, "append", __oop_args_0)
    }
}

Function.stack_pop {
    Input: p_stack: Integer
    Body: {
        t0 = DictGen_SmartLen(p_stack)
        IfCondition EqualTo(t0, 0) ThenBlock: {
            ReturnValue(Subtract(0, 1))
        }
        t1 = DictGen_SmartLen(p_stack)
        t2 = Subtract(t1, 1)
        t3 = DictGen_SmartGet(p_stack, t2)
        val = t3
        ReturnValue(val)
    }
}

Function.stack_peek {
    Input: p_stack: Integer
    Body: {
        t0 = DictGen_SmartLen(p_stack)
        IfCondition EqualTo(t0, 0) ThenBlock: {
            ReturnValue(Subtract(0, 1))
        }
        t1 = DictGen_SmartLen(p_stack)
        t2 = Subtract(t1, 1)
        t3 = DictGen_SmartGet(p_stack, t2)
        ReturnValue(t3)
    }
}

Function.stack_is_empty {
    Input: p_stack: Integer
    Body: {
        t0 = DictGen_SmartLen(p_stack)
        IfCondition EqualTo(t0, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.eval_rpn {
    Input: p_tokens: Integer
    Body: {
        stack = Array.Create(0)
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_tokens)
            IfCondition Not(LessThan(i, t0)) ThenBlock: {
                BreakLoop
            }
            t1 = DictGen_SmartGet(p_tokens, i)
            tok = t1
            IfCondition GreaterEqual(tok, 0) ThenBlock: {
                AIMacro.SmartPush(stack, tok)
            } ElseBlock: {
                t2 = AIMacro.SmartLen(stack)
                t3 = Subtract(t2, 1)
                t4 = DictGen_SmartGet(stack, t3)
                b = t4
                new_stack = Array.Create(0)
                j = 0
                WhileLoop EqualTo(1, 1) {
                    t5 = AIMacro.SmartLen(stack)
                    IfCondition Not(LessThan(j, Subtract(t5, 1))) ThenBlock: {
                        BreakLoop
                    }
                    t6 = DictGen_SmartGet(stack, j)
                    AIMacro.SmartPush(new_stack, t6)
                    j = Add(j, 1)
                }
                stack = new_stack
                t7 = AIMacro.SmartLen(stack)
                t8 = Subtract(t7, 1)
                t9 = DictGen_SmartGet(stack, t8)
                a = t9
                new_stack = Array.Create(0)
                j = 0
                WhileLoop EqualTo(1, 1) {
                    t10 = AIMacro.SmartLen(stack)
                    IfCondition Not(LessThan(j, Subtract(t10, 1))) ThenBlock: {
                        BreakLoop
                    }
                    t11 = DictGen_SmartGet(stack, j)
                    AIMacro.SmartPush(new_stack, t11)
                    j = Add(j, 1)
                }
                stack = new_stack
                result = 0
                IfCondition EqualTo(tok, Subtract(0, 1)) ThenBlock: {
                    result = Add(a, b)
                } ElseBlock: {
                    IfCondition EqualTo(tok, Subtract(0, 2)) ThenBlock: {
                        result = Subtract(a, b)
                    } ElseBlock: {
                        IfCondition EqualTo(tok, Subtract(0, 3)) ThenBlock: {
                            result = Multiply(a, b)
                        } ElseBlock: {
                            IfCondition EqualTo(tok, Subtract(0, 4)) ThenBlock: {
                                result = Divide(a, b)
                            }
                        }
                    }
                }
                AIMacro.SmartPush(stack, result)
            }
            i = Add(i, 1)
        }
        t12 = DictGen_SmartGet(stack, 0)
        ReturnValue(t12)
    }
}

Function.print_histogram {
    Input: p_data: Integer
    Input: p_max_width: Integer
    Body: {
        max_val = 0
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_data)
            IfCondition Not(LessThan(i, t0)) ThenBlock: {
                BreakLoop
            }
            t1 = DictGen_SmartGet(p_data, i)
            IfCondition GreaterThan(t1, max_val) ThenBlock: {
                t2 = DictGen_SmartGet(p_data, i)
                max_val = t2
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(max_val, 0) ThenBlock: {
            max_val = 1
        }
        i = 0
        WhileLoop EqualTo(1, 1) {
            t3 = DictGen_SmartLen(p_data)
            IfCondition Not(LessThan(i, t3)) ThenBlock: {
                BreakLoop
            }
            t4 = DictGen_SmartGet(p_data, i)
            val = t4
            bar_len = Divide(Multiply(val, p_max_width), max_val)
            t5 = AIMacro.Str(i)
            t6 = String.Concat(t5, ": ")
            label = t6
            IfCondition LessThan(i, 10) ThenBlock: {
                t7 = String.Concat(" ", label)
                label = t7
            }
            bar = String.Repeat("#", bar_len)
            t8 = AIMacro.Str(val)
            t9 = String.Concat(" (", t8)
            t10 = String.Concat(t9, ")")
            val_str = t10
                        t11 = String.Concat(label, bar)
            t12 = String.Concat(t11, val_str)
AIMacro.SmartPrint(t12)
            PrintMessage("\n")
            i = Add(i, 1)
        }
    }
}

Function.hash_code {
    Input: p_key: Integer
    Input: p_size: Integer
    Body: {
        t0 = Modulo(p_key, p_size)
        ReturnValue(t0)
    }
}

Function.hashtable_create {
    Input: p_size: Integer
    Body: {
        table = Array.Create(0)
        i = 0
        WhileLoop LessThan(i, p_size) {
            AIMacro.SmartPush(table, 0)
            i = Add(i, 1)
        }
        ReturnValue(table)
    }
}

Function.list_to_string {
    Input: p_arr: Integer
    Body: {
        result = "["
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_arr)
            IfCondition Not(LessThan(i, t0)) ThenBlock: {
                BreakLoop
            }
            IfCondition GreaterThan(i, 0) ThenBlock: {
                t1 = String.Concat(result, ", ")
                result = t1
            }
            t2 = DictGen_SmartGet(p_arr, i)
            t3 = AIMacro.Str(t2)
            t4 = String.Concat(result, t3)
            result = t4
            i = Add(i, 1)
        }
        t5 = String.Concat(result, "]")
        ReturnValue(t5)
    }
}

Function.list_reverse {
    Input: p_arr: Integer
    Body: {
        result = Array.Create(0)
        t0 = DictGen_SmartLen(p_arr)
        t1 = Subtract(t0, 1)
        i = t1
        WhileLoop GreaterEqual(i, 0) {
            t2 = DictGen_SmartGet(p_arr, i)
            AIMacro.SmartPush(result, t2)
            i = Subtract(i, 1)
        }
        ReturnValue(result)
    }
}

Function.list_copy {
    Input: p_arr: Integer
    Body: {
        result = Array.Create(0)
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_arr)
            IfCondition Not(LessThan(i, t0)) ThenBlock: {
                BreakLoop
            }
            t1 = DictGen_SmartGet(p_arr, i)
            AIMacro.SmartPush(result, t1)
            i = Add(i, 1)
        }
        ReturnValue(result)
    }
}

