        m2 = t36
        val = 1
        r = 0
        WhileLoop LessThan(r, 3) {
            c = 0
            WhileLoop LessThan(c, 3) {
                matrix_set(m1, 3, r, c, val)
                val = Add(val, 1)
                c = Add(c, 1)
            }
            r = Add(r, 1)
