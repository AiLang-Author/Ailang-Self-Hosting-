        PrintMessage("\n")
        expr1 = Array.Create(5)
        Array.Push(expr1, 3)
        Array.Push(expr1, 4)
        Array.Push(expr1, Subtract(0, 1))
        Array.Push(expr1, 2)
        Array.Push(expr1, Subtract(0, 3))
