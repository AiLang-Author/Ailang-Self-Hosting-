LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


SubRoutine.Main {
        a = "Hello"
        b = "World"
        t0 = String.Concat(a, " ")
        t1 = String.Concat(t0, b)
        c = t1
        AIMacro.SmartPrint(c)
        PrintMessage("\n")
        t2 = String.Concat("foo", "bar")
        msg = t2
        AIMacro.SmartPrint(msg)
        PrintMessage("\n")
        name = "Claude"
        t3 = String.Concat("Hello, ", name)
        t4 = String.Concat(t3, "!")
        greeting = t4
        AIMacro.SmartPrint(greeting)
        PrintMessage("\n")
        prefix = "Value: "
        AIMacro.SmartPrint(prefix)
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
