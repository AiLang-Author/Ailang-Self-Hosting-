LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


SubRoutine.Main {
        PrintMessage("=== STRING EQUALITY HARDENING TEST ===")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 1: Literal comparison")
        PrintMessage("\n")
        name = "Claude"
        IfCondition EqualTo(StringCompare(name, "Claude"), 0) ThenBlock: {
            PrintMessage("PASS: Literal match works")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: Literal match broken")
            PrintMessage("\n")
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 2: Dynamic string comparison")
        PrintMessage("\n")
        a = "Hello"
        t0 = String.Concat("Hel", "lo")
        b = t0
        PrintMessage("a = Hello (direct)")
        PrintMessage("\n")
        PrintMessage("b = Hel + lo (concatenated)")
        PrintMessage("\n")
        IfCondition EqualTo(StringCompare(a, b), 0) ThenBlock: {
            PrintMessage("PASS: Dynamic strings match!")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: Dynamic strings don't match (pointer comparison)")
            PrintMessage("\n")
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 3: Dynamic string inequality")
        PrintMessage("\n")
        t1 = String.Concat("foo", "bar")
        x = t1
        t2 = String.Concat("baz", "qux")
        y = t2
        IfCondition NotEqual(StringCompare(x, y), 0) ThenBlock: {
            PrintMessage("PASS: foobar != bazqux")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: foobar should != bazqux")
            PrintMessage("\n")
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 4: Compare with str() result")
        PrintMessage("\n")
        num_str = AIMacro.Str(42)
        expected = "42"
        IfCondition EqualTo(StringCompare(num_str, expected), 0) ThenBlock: {
            PrintMessage("PASS: str(42) == 42")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: str(42) should == 42")
            PrintMessage("\n")
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 5: Empty string comparison")
        PrintMessage("\n")
        empty1 = ""
        empty2 = ""
        IfCondition EqualTo(StringCompare(empty1, empty2), 0) ThenBlock: {
            PrintMessage("PASS: Empty strings equal")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: Empty strings should be equal")
            PrintMessage("\n")
        }
        nonempty = "x"
        IfCondition NotEqual(StringCompare(empty1, nonempty), 0) ThenBlock: {
            PrintMessage("PASS: Empty != non-empty")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: Empty should != non-empty")
            PrintMessage("\n")
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 6: Case sensitivity")
        PrintMessage("\n")
        lower = "hello"
        upper = "HELLO"
        IfCondition NotEqual(StringCompare(lower, upper), 0) ThenBlock: {
            PrintMessage("PASS: hello != HELLO (case sensitive)")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: Should be case sensitive")
            PrintMessage("\n")
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== ALL TESTS COMPLETE ===")
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
