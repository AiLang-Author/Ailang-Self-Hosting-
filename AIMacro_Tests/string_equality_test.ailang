LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        PrintMessage("=== STRING EQUALITY HARDENING TEST ===")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 1: Literal comparison")
        PrintMessage("\n")
        name = "Claude"
        IfCondition AIMacro.SmartBool(EqualTo(StringCompare(name, "Claude"), 0)) ThenBlock: {
            PrintMessage("PASS: Literal match works")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: Literal match broken")
            PrintMessage("\n")
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 2: Dynamic string comparison")
        PrintMessage("\n")
        a = "Hello"
        t0 = String.Concat("Hel", "lo")
        b = t0
        PrintMessage("a = Hello (direct)")
        PrintMessage("\n")
        PrintMessage("b = Hel + lo (concatenated)")
        PrintMessage("\n")
        t1 = AIMacro.Bool(EqualTo(StringCompare(a, b), 0))
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            PrintMessage("PASS: Dynamic strings match!")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: Dynamic strings don't match (pointer comparison)")
            PrintMessage("\n")
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 3: Dynamic string inequality")
        PrintMessage("\n")
        t2 = String.Concat("foo", "bar")
        x = t2
        t3 = String.Concat("baz", "qux")
        y = t3
        t4 = AIMacro.Bool(NotEqual(StringCompare(x, y), 0))
        IfCondition AIMacro.SmartBool(t4) ThenBlock: {
            PrintMessage("PASS: foobar != bazqux")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: foobar should != bazqux")
            PrintMessage("\n")
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 4: Compare with str() result")
        PrintMessage("\n")
        num_str = AIMacro.Str(42)
        expected = "42"
        t5 = AIMacro.Bool(EqualTo(StringCompare(num_str, expected), 0))
        IfCondition AIMacro.SmartBool(t5) ThenBlock: {
            PrintMessage("PASS: str(42) == 42")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: str(42) should == 42")
            PrintMessage("\n")
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 5: Empty string comparison")
        PrintMessage("\n")
        empty1 = ""
        empty2 = ""
        t6 = AIMacro.Bool(EqualTo(StringCompare(empty1, empty2), 0))
        IfCondition AIMacro.SmartBool(t6) ThenBlock: {
            PrintMessage("PASS: Empty strings equal")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: Empty strings should be equal")
            PrintMessage("\n")
        }
        nonempty = "x"
        t7 = AIMacro.Bool(NotEqual(StringCompare(empty1, nonempty), 0))
        IfCondition AIMacro.SmartBool(t7) ThenBlock: {
            PrintMessage("PASS: Empty != non-empty")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: Empty should != non-empty")
            PrintMessage("\n")
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 6: Case sensitivity")
        PrintMessage("\n")
        lower = "hello"
        upper = "HELLO"
        t8 = AIMacro.Bool(NotEqual(StringCompare(lower, upper), 0))
        IfCondition AIMacro.SmartBool(t8) ThenBlock: {
            PrintMessage("PASS: hello != HELLO (case sensitive)")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: Should be case sensitive")
            PrintMessage("\n")
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== ALL TESTS COMPLETE ===")
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
