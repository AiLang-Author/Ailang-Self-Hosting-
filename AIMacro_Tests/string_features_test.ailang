LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


SubRoutine.Main {
        PrintMessage("=== STRING FEATURES TEST ===")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 1: String Equality (==)")
        PrintMessage("\n")
        name = "Claude"
        IfCondition EqualTo(StringCompare(name, "Claude"), 0) ThenBlock: {
            PrintMessage("PASS: name == Claude")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: name == Claude not detected")
            PrintMessage("\n")
        }
        other = "Bob"
        IfCondition EqualTo(StringCompare(other, "Claude"), 0) ThenBlock: {
            PrintMessage("FAIL: Bob should not equal Claude")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("PASS: Bob != Claude")
            PrintMessage("\n")
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 2: String Inequality (!=)")
        PrintMessage("\n")
        IfCondition NotEqual(StringCompare(name, "Bob"), 0) ThenBlock: {
            PrintMessage("PASS: Claude != Bob")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: Claude should != Bob")
            PrintMessage("\n")
        }
        IfCondition NotEqual(StringCompare(name, "Claude"), 0) ThenBlock: {
            PrintMessage("FAIL: Claude should == Claude")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("PASS: Claude == Claude (via !=)")
            PrintMessage("\n")
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 3: str() Conversion")
        PrintMessage("\n")
        count = 42
        count_str = AIMacro.Str(count)
        PrintMessage("Converted number to string")
        PrintMessage("\n")
        t0 = AIMacro.Str(count)
        t1 = String.Concat("The answer is: ", t0)
        msg = t1
        AIMacro.SmartPrint(msg)
        PrintMessage("\n")
        t2 = AIMacro.Str(100)
        t3 = String.Concat("Value: ", t2)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 4: len() on Strings")
        PrintMessage("\n")
        text = "Hello"
        t4 = DictGen_SmartLen(text)
        text_len = t4
        PrintMessage("Length of Hello:")
        PrintMessage("\n")
        AIMacro.SmartPrint(text_len)
        PrintMessage("\n")
        empty = ""
        PrintMessage("Length of empty string:")
        PrintMessage("\n")
        t5 = DictGen_SmartLen(empty)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        long_text = "This is a longer string"
        PrintMessage("Length of longer string:")
        PrintMessage("\n")
        t6 = DictGen_SmartLen(long_text)
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 5: Combined Example")
        PrintMessage("\n")
        username = "admin"
        IfCondition EqualTo(StringCompare(username, "admin"), 0) ThenBlock: {
            PrintMessage("Welcome, administrator!")
            PrintMessage("\n")
            t7 = String.Concat("User ", username)
            t8 = String.Concat(t7, " logged in")
            msg = t8
            AIMacro.SmartPrint(msg)
            PrintMessage("\n")
        }
        password = "secret123"
        t9 = DictGen_SmartLen(password)
        pass_len = t9
        IfCondition LessThan(pass_len, 8) ThenBlock: {
            PrintMessage("Password too short!")
            PrintMessage("\n")
        } ElseBlock: {
            t10 = AIMacro.Str(pass_len)
            t11 = String.Concat("Password length OK: ", t10)
            AIMacro.SmartPrint(t11)
            PrintMessage("\n")
        }
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== ALL TESTS COMPLETE ===")
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
