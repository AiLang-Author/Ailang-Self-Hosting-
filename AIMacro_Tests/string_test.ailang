LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.test_repeat {
    Body: {
        PrintMessage("=== STRING REPEAT ===")
        PrintMessage("\n")
                t0 = String.Repeat("-", 20)
AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("Stars:")
        PrintMessage(" ")
                t1 = String.Repeat("*", 10)
AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("Dots:")
        PrintMessage(" ")
                t2 = String.Repeat(".", 5)
AIMacro.SmartPrint(t2)
        PrintMessage("\n")
                t3 = String.Repeat("-", 20)
AIMacro.SmartPrint(t3)
        PrintMessage("\n")
    }
}

Function.test_basics {
    Body: {
        PrintMessage("=== STRING BASICS ===")
        PrintMessage("\n")
        msg = "Hello World"
        PrintMessage("Message:")
        PrintMessage(" ")
        AIMacro.SmartPrint(msg)
        PrintMessage("\n")
        empty = ""
        PrintMessage("Empty string test passed")
        PrintMessage("\n")
        mixed = "Value is 42"
        AIMacro.SmartPrint(mixed)
        PrintMessage("\n")
    }
}

Function.test_case {
    Body: {
        PrintMessage("=== CASE CONVERSION ===")
        PrintMessage("\n")
        lower_str = "hello"
        upper_str = "WORLD"
        mixed_str = "HeLLo WoRLd"
        PrintMessage("Original:")
        PrintMessage(" ")
        AIMacro.SmartPrint(lower_str)
        PrintMessage("\n")
        t0 = String.Upper(lower_str)
        PrintMessage("Upper:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("Original:")
        PrintMessage(" ")
        AIMacro.SmartPrint(upper_str)
        PrintMessage("\n")
        t1 = String.Lower(upper_str)
        PrintMessage("Lower:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("Original:")
        PrintMessage(" ")
        AIMacro.SmartPrint(mixed_str)
        PrintMessage("\n")
        t2 = String.Upper(mixed_str)
        PrintMessage("Upper:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = String.Lower(mixed_str)
        PrintMessage("Lower:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
    }
}

Function.test_strip {
    Body: {
        PrintMessage("=== STRIP/TRIM ===")
        PrintMessage("\n")
        padded = "   hello   "
        PrintMessage("Original: [")
        PrintMessage(" ")
        AIMacro.SmartPrint(padded)
        PrintMessage(" ")
        PrintMessage("]")
        PrintMessage("\n")
        t0 = String.Strip(padded)
        PrintMessage("Stripped: [")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage(" ")
        PrintMessage("]")
        PrintMessage("\n")
        t1 = String.LStrip(padded)
        PrintMessage("LStrip: [")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage(" ")
        PrintMessage("]")
        PrintMessage("\n")
        t2 = String.RStrip(padded)
        PrintMessage("RStrip: [")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage(" ")
        PrintMessage("]")
        PrintMessage("\n")
    }
}

Function.test_find {
    Body: {
        PrintMessage("=== FIND/CONTAINS ===")
        PrintMessage("\n")
        text = "the quick brown fox"
        PrintMessage("Text:")
        PrintMessage(" ")
        AIMacro.SmartPrint(text)
        PrintMessage("\n")
        t0 = String.Find(text, "quick")
        PrintMessage("Find 'quick':")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = String.Find(text, "slow")
        PrintMessage("Find 'slow':")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = String.Find(text, "the")
        PrintMessage("Find 'the':")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = String.Find(text, "fox")
        PrintMessage("Find 'fox':")
        PrintMessage(" ")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
    }
}

Function.test_startswith_endswith {
    Body: {
        PrintMessage("=== STARTSWITH / ENDSWITH ===")
        PrintMessage("\n")
        filename = "document.txt"
        url = "https://example.com"
        PrintMessage("Filename:")
        PrintMessage(" ")
        AIMacro.SmartPrint(filename)
        PrintMessage("\n")
        t0 = String.EndsWith(filename, ".txt")
        PrintMessage("Ends with .txt:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = String.EndsWith(filename, ".pdf")
        PrintMessage("Ends with .pdf:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = String.StartsWith(filename, "doc")
        PrintMessage("Starts with doc:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = String.StartsWith(filename, "img")
        PrintMessage("Starts with img:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        PrintMessage("URL:")
        PrintMessage(" ")
        AIMacro.SmartPrint(url)
        PrintMessage("\n")
        t4 = String.StartsWith(url, "https")
        PrintMessage("Starts with https:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        t5 = String.StartsWith(url, "http")
        PrintMessage("Starts with http:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
    }
}

Function.test_replace {
    Body: {
        PrintMessage("=== REPLACE ===")
        PrintMessage("\n")
        original = "hello world world"
        PrintMessage("Original:")
        PrintMessage(" ")
        AIMacro.SmartPrint(original)
        PrintMessage("\n")
        t0 = String.Replace(original, "world", "planet")
        PrintMessage("Replace world->planet:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = String.Replace(original, "o", "0")
        PrintMessage("Replace o->0:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = String.Replace(original, "x", "y")
        PrintMessage("Replace x->y:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
    }
}

Function.test_count {
    Body: {
        PrintMessage("=== COUNT ===")
        PrintMessage("\n")
        text = "banana"
        PrintMessage("Text:")
        PrintMessage(" ")
        AIMacro.SmartPrint(text)
        PrintMessage("\n")
        t0 = String.Count(text, "a")
        PrintMessage("Count 'a':")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = String.Count(text, "na")
        PrintMessage("Count 'na':")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = String.Count(text, "x")
        PrintMessage("Count 'x':")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
    }
}

Function.test_split {
    Body: {
        PrintMessage("=== SPLIT ===")
        PrintMessage("\n")
        csv = "apple,banana,cherry"
        PrintMessage("CSV:")
        PrintMessage(" ")
        AIMacro.SmartPrint(csv)
        PrintMessage("\n")
        parts = String.Split(csv, ",")
        PrintMessage("Split completed, parts created")
        PrintMessage("\n")
    }
}

SubRoutine.Main {
                t0 = String.Repeat("=", 50)
AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("AIMacro String Library Test Suite")
        PrintMessage("\n")
                t1 = String.Repeat("=", 50)
AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        test_repeat()
        test_basics()
        test_case()
        test_strip()
        test_find()
        test_startswith_endswith()
        test_replace()
        test_count()
        test_split()
                t2 = String.Repeat("=", 50)
AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        PrintMessage("All string tests complete!")
        PrintMessage("\n")
                t3 = String.Repeat("=", 50)
AIMacro.SmartPrint(t3)
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
