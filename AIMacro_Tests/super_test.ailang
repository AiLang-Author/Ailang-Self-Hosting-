LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.assert_eq {
    Input: p_actual: Integer
    Input: p_expected: Integer
    Input: p_name: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(p_actual, p_expected) ThenBlock: {
            PrintMessage("  PASS:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_name)
            PrintMessage("\n")
            ReturnValue(1)
        } ElseBlock: {
            PrintMessage("  FAIL:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_name)
            PrintMessage(" ")
            PrintMessage("| Expected:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_expected)
            PrintMessage(" ")
            PrintMessage("Got:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_actual)
            PrintMessage("\n")
            ReturnValue(0)
        }
    }
}

Function.assert_str_eq {
    Input: p_actual: Integer
    Input: p_expected: Integer
    Input: p_name: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(StringCompare(p_actual, p_expected), 0) ThenBlock: {
            PrintMessage("  PASS:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_name)
            PrintMessage("\n")
            ReturnValue(1)
        } ElseBlock: {
            PrintMessage("  FAIL:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_name)
            PrintMessage(" ")
            PrintMessage("| Expected:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_expected)
            PrintMessage(" ")
            PrintMessage("Got:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_actual)
            PrintMessage("\n")
            ReturnValue(0)
        }
    }
}

Function.assert_true {
    Input: p_cond: Integer
    Input: p_name: Integer
    Output: Integer
    Body: {
        t0 = assert_eq(p_cond, 1, p_name)
        ReturnValue(t0)
    }
}

Function.assert_false {
    Input: p_cond: Integer
    Input: p_name: Integer
    Output: Integer
    Body: {
        t0 = assert_eq(p_cond, 0, p_name)
        ReturnValue(t0)
    }
}

Function.test_integer_literals {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 1: Integer Literals ===")
        PrintMessage("\n")
        p = 0
        a = 0
        t0 = assert_eq(a, 0, "zero")
        t1 = Add(p, t0)
        p = t1
        b = 42
        t2 = assert_eq(b, 42, "positive")
        t3 = Add(p, t2)
        p = t3
        c = Subtract(0, 100)
        t4 = Subtract(0, 100)
        t5 = assert_eq(c, t4, "negative")
        t6 = Add(p, t5)
        p = t6
        d = 999999999
        t7 = assert_eq(d, 999999999, "large number")
        t8 = Add(p, t7)
        p = t8
        PrintMessage("Integer literals:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 4")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_boolean_literals {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 2: Boolean Literals ===")
        PrintMessage("\n")
        p = 0
        t = 1
        f = 0
        t0 = assert_true(t, "True literal")
        t1 = Add(p, t0)
        p = t1
        t2 = assert_false(f, "False literal")
        t3 = Add(p, t2)
        p = t3
        PrintMessage("Boolean literals:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 2")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_arithmetic {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 3: Arithmetic ===")
        PrintMessage("\n")
        p = 0
        t0 = Add(1, 1)
        t1 = assert_eq(t0, 2, "addition")
        t2 = Add(p, t1)
        p = t2
        t3 = Subtract(10, 3)
        t4 = assert_eq(t3, 7, "subtraction")
        t5 = Add(p, t4)
        p = t5
        t6 = Multiply(4, 5)
        t7 = assert_eq(t6, 20, "multiplication")
        t8 = Add(p, t7)
        p = t8
        t9 = Divide(20, 4)
        t10 = assert_eq(t9, 5, "division")
        t11 = Add(p, t10)
        p = t11
        t12 = Modulo(17, 5)
        t13 = assert_eq(t12, 2, "modulo")
        t14 = Add(p, t13)
        p = t14
        t15 = Math.Power(2, 3)
        t16 = assert_eq(t15, 8, "power")
        t17 = Add(p, t16)
        p = t17
        t18 = Math.FloorDiv(7, 2)
        t19 = assert_eq(t18, 3, "floor division")
        t20 = Add(p, t19)
        p = t20
        t21 = Subtract(0, 5)
        t22 = Add(t21, 10)
        t23 = assert_eq(t22, 5, "negative operand")
        t24 = Add(p, t23)
        p = t24
        t25 = Subtract(5, 10)
        t26 = Subtract(0, 5)
        t27 = assert_eq(t25, t26, "negative result")
        t28 = Add(p, t27)
        p = t28
        t29 = Subtract(0, 10)
        t30 = Multiply(t29, 3)
        t31 = Subtract(0, 30)
        t32 = assert_eq(t30, t31, "negative multiply")
        t33 = Add(p, t32)
        p = t33
        t34 = Multiply(3, 4)
        t35 = Add(2, t34)
        t36 = assert_eq(t35, 14, "precedence: mul before add")
        t37 = Add(p, t36)
        p = t37
        t38 = Add(2, 3)
        t39 = Multiply(t38, 4)
        t40 = assert_eq(t39, 20, "parentheses override")
        t41 = Add(p, t40)
        p = t41
        t42 = Subtract(10, 2)
        t43 = Subtract(t42, 3)
        t44 = assert_eq(t43, 5, "left associative")
        t45 = Add(p, t44)
        p = t45
        t46 = Add(1, 2)
        t47 = Add(3, 4)
        t48 = Multiply(t46, t47)
        t49 = Subtract(t48, 5)
        t50 = assert_eq(t49, 16, "complex expression")
        t51 = Add(p, t50)
        p = t51
        x = 10
        y = 3
        t52 = Add(x, y)
        t53 = assert_eq(t52, 13, "variables in expr")
        t54 = Add(p, t53)
        p = t54
        t55 = Multiply(x, y)
        t56 = Add(t55, 1)
        t57 = assert_eq(t56, 31, "mixed var expr")
        t58 = Add(p, t57)
        p = t58
        PrintMessage("Arithmetic:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 16")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_augmented_assignment {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 4: Augmented Assignment ===")
        PrintMessage("\n")
        p = 0
        x = 10
        x = Add(x, 5)
        t0 = assert_eq(x, 15, "+= operator")
        t1 = Add(p, t0)
        p = t1
        x = Subtract(x, 3)
        t2 = assert_eq(x, 12, "-= operator")
        t3 = Add(p, t2)
        p = t3
        x = Multiply(x, 2)
        t4 = assert_eq(x, 24, "*= operator")
        t5 = Add(p, t4)
        p = t5
        x = Divide(x, 4)
        t6 = assert_eq(x, 6, "/= operator")
        t7 = Add(p, t6)
        p = t7
        x = Modulo(x, 4)
        t8 = assert_eq(x, 2, "%= operator")
        t9 = Add(p, t8)
        p = t9
        y = 1
        y = Add(y, 2)
        y = Multiply(y, 3)
        y = Subtract(y, 1)
        t10 = assert_eq(y, 8, "augmented chain")
        t11 = Add(p, t10)
        p = t11
        PrintMessage("Augmented assignment:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 6")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_comparisons {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 5: Comparisons ===")
        PrintMessage("\n")
        p = 0
        t0 = GreaterThan(5, 3)
        t1 = assert_true(t0, "greater than true")
        t2 = Add(p, t1)
        p = t2
        t3 = GreaterThan(3, 5)
        t4 = assert_false(t3, "greater than false")
        t5 = Add(p, t4)
        p = t5
        t6 = LessThan(3, 5)
        t7 = assert_true(t6, "less than true")
        t8 = Add(p, t7)
        p = t8
        t9 = LessThan(5, 3)
        t10 = assert_false(t9, "less than false")
        t11 = Add(p, t10)
        p = t11
        t12 = GreaterEqual(5, 5)
        t13 = assert_true(t12, "greater equal (equal)")
        t14 = Add(p, t13)
        p = t14
        t15 = GreaterEqual(6, 5)
        t16 = assert_true(t15, "greater equal (greater)")
        t17 = Add(p, t16)
        p = t17
        t18 = LessEqual(5, 5)
        t19 = assert_true(t18, "less equal (equal)")
        t20 = Add(p, t19)
        p = t20
        t21 = LessEqual(4, 5)
        t22 = assert_true(t21, "less equal (less)")
        t23 = Add(p, t22)
        p = t23
        t24 = EqualTo(5, 5)
        t25 = assert_true(t24, "equal true")
        t26 = Add(p, t25)
        p = t26
        t27 = EqualTo(5, 6)
        t28 = assert_false(t27, "equal false")
        t29 = Add(p, t28)
        p = t29
        t30 = NotEqual(5, 6)
        t31 = assert_true(t30, "not equal true")
        t32 = Add(p, t31)
        p = t32
        t33 = NotEqual(5, 5)
        t34 = assert_false(t33, "not equal false")
        t35 = Add(p, t34)
        p = t35
        PrintMessage("Comparisons:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 12")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_string_comparisons {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 6: String Comparisons ===")
        PrintMessage("\n")
        p = 0
        s1 = "hello"
        s2 = "hello"
        s3 = "world"
        t0 = String.Concat("hel", "lo")
        s4 = t0
        t1 = EqualTo(StringCompare(s1, s2), 0)
        t2 = assert_true(t1, "string equal same")
        t3 = Add(p, t2)
        p = t3
        t4 = EqualTo(StringCompare(s1, s3), 0)
        t5 = assert_false(t4, "string equal diff")
        t6 = Add(p, t5)
        p = t6
        t7 = NotEqual(StringCompare(s1, s3), 0)
        t8 = assert_true(t7, "string not equal")
        t9 = Add(p, t8)
        p = t9
        t10 = EqualTo(StringCompare(s1, s4), 0)
        t11 = assert_true(t10, "dynamic string equal")
        t12 = Add(p, t11)
        p = t12
        PrintMessage("String comparisons:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 4")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_logical {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 7: Logical Operators ===")
        PrintMessage("\n")
        p = 0
        t0 = And(1, 1)
        t1 = assert_true(t0, "and: T and T")
        t2 = Add(p, t1)
        p = t2
        t3 = And(1, 0)
        t4 = assert_false(t3, "and: T and F")
        t5 = Add(p, t4)
        p = t5
        t6 = And(0, 1)
        t7 = assert_false(t6, "and: F and T")
        t8 = Add(p, t7)
        p = t8
        t9 = And(0, 0)
        t10 = assert_false(t9, "and: F and F")
        t11 = Add(p, t10)
        p = t11
        t12 = Or(1, 1)
        t13 = assert_true(t12, "or: T or T")
        t14 = Add(p, t13)
        p = t14
        t15 = Or(1, 0)
        t16 = assert_true(t15, "or: T or F")
        t17 = Add(p, t16)
        p = t17
        t18 = Or(0, 1)
        t19 = assert_true(t18, "or: F or T")
        t20 = Add(p, t19)
        p = t20
        t21 = Or(0, 0)
        t22 = assert_false(t21, "or: F or F")
        t23 = Add(p, t22)
        p = t23
        t24 = Not(0)
        t25 = assert_true(t24, "not: not F")
        t26 = Add(p, t25)
        p = t26
        t27 = Not(1)
        t28 = assert_false(t27, "not: not T")
        t29 = Add(p, t28)
        p = t29
        t30 = And(1, 1)
        t31 = Or(t30, 0)
        t32 = assert_true(t31, "combined: (T and T) or F")
        t33 = Add(p, t32)
        p = t33
        t34 = And(0, 1)
        t35 = Not(t34)
        t36 = assert_true(t35, "combined: not (F and T)")
        t37 = Add(p, t36)
        p = t37
        t38 = Not(0)
        t39 = And(1, t38)
        t40 = assert_true(t39, "T and not F")
        t41 = Add(p, t40)
        p = t41
        x = 50
        IfCondition Not(GreaterThan(x, 100)) ThenBlock: {
            p = Add(p, 1)
            PrintMessage("  PASS: not with parens")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("  FAIL: not with parens")
            PrintMessage("\n")
        }
        PrintMessage("Logical operators:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 14")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_conditionals {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 8: Conditionals ===")
        PrintMessage("\n")
        p = 0
        result = 0
        IfCondition 1 ThenBlock: {
            result = 1
        }
        t0 = assert_eq(result, 1, "if true executes")
        t1 = Add(p, t0)
        p = t1
        result = 0
        IfCondition 0 ThenBlock: {
            result = 1
        }
        t2 = assert_eq(result, 0, "if false skips")
        t3 = Add(p, t2)
        p = t3
        result = 0
        IfCondition 0 ThenBlock: {
            result = 1
        } ElseBlock: {
            result = 2
        }
        t4 = assert_eq(result, 2, "else branch")
        t5 = Add(p, t4)
        p = t5
        x = 2
        result = 0
        IfCondition EqualTo(x, 1) ThenBlock: {
            result = 10
        } ElseBlock: {
            IfCondition EqualTo(x, 2) ThenBlock: {
                result = 20
            } ElseBlock: {
                IfCondition EqualTo(x, 3) ThenBlock: {
                    result = 30
                } ElseBlock: {
                    result = 40
                }
            }
        }
        t6 = assert_eq(result, 20, "elif branch")
        t7 = Add(p, t6)
        p = t7
        x = 1
        result = 0
        IfCondition EqualTo(x, 1) ThenBlock: {
            result = 10
        } ElseBlock: {
            IfCondition EqualTo(x, 1) ThenBlock: {
                result = 20
            }
        }
        t8 = assert_eq(result, 10, "first match wins")
        t9 = Add(p, t8)
        p = t9
        a = 1
        b = 1
        result = 0
        IfCondition a ThenBlock: {
            IfCondition b ThenBlock: {
                result = 11
            } ElseBlock: {
                result = 10
            }
        } ElseBlock: {
            result = 0
        }
        t10 = assert_eq(result, 11, "nested if")
        t11 = Add(p, t10)
        p = t11
        x = 500
        result = 0
        IfCondition GreaterThan(x, 0) ThenBlock: {
            IfCondition GreaterThan(x, 10) ThenBlock: {
                IfCondition GreaterThan(x, 100) ThenBlock: {
                    IfCondition GreaterThan(x, 1000) ThenBlock: {
                        result = 4
                    } ElseBlock: {
                        result = 3
                    }
                } ElseBlock: {
                    result = 2
                }
            } ElseBlock: {
                result = 1
            }
        } ElseBlock: {
            result = 0
        }
        t12 = assert_eq(result, 3, "deeply nested if")
        t13 = Add(p, t12)
        p = t13
        PrintMessage("Conditionals:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 7")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_long_elif_chain {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 9: Long Elif Chain ===")
        PrintMessage("\n")
        p = 0
        lc0 = 1
        ls0 = 12
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            test_val = lc0
            lc0 = Add(lc0, lt0)
            x = test_val
            result = ""
            IfCondition EqualTo(x, 1) ThenBlock: {
                result = "one"
            } ElseBlock: {
                IfCondition EqualTo(x, 2) ThenBlock: {
                    result = "two"
                } ElseBlock: {
                    IfCondition EqualTo(x, 3) ThenBlock: {
                        result = "three"
                    } ElseBlock: {
                        IfCondition EqualTo(x, 4) ThenBlock: {
                            result = "four"
                        } ElseBlock: {
                            IfCondition EqualTo(x, 5) ThenBlock: {
                                result = "five"
                            } ElseBlock: {
                                IfCondition EqualTo(x, 6) ThenBlock: {
                                    result = "six"
                                } ElseBlock: {
                                    IfCondition EqualTo(x, 7) ThenBlock: {
                                        result = "seven"
                                    } ElseBlock: {
                                        IfCondition EqualTo(x, 8) ThenBlock: {
                                            result = "eight"
                                        } ElseBlock: {
                                            IfCondition EqualTo(x, 9) ThenBlock: {
                                                result = "nine"
                                            } ElseBlock: {
                                                IfCondition EqualTo(x, 10) ThenBlock: {
                                                    result = "ten"
                                                } ElseBlock: {
                                                    result = "other"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(test_val, 7) ThenBlock: {
                t1 = assert_eq(result, "seven", "elif chain x=7")
                t2 = Add(p, t1)
                p = t2
            }
            IfCondition EqualTo(test_val, 11) ThenBlock: {
                t3 = assert_eq(result, "other", "elif chain x=11 (else)")
                t4 = Add(p, t3)
                p = t4
            }
        }
        PrintMessage("Long elif chain:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 2")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_while_loops {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 10: While Loops ===")
        PrintMessage("\n")
        p = 0
        count = 0
        i = 0
        WhileLoop LessThan(i, 5) {
            count = Add(count, 1)
            i = Add(i, 1)
        }
        t0 = assert_eq(count, 5, "while count to 5")
        t1 = Add(p, t0)
        p = t1
        count = 0
        i = 10
        WhileLoop LessThan(i, 5) {
            count = Add(count, 1)
            i = Add(i, 1)
        }
        t2 = assert_eq(count, 0, "while zero iterations")
        t3 = Add(p, t2)
        p = t3
        total = 0
        i = 1
        WhileLoop LessEqual(i, 10) {
            total = Add(total, i)
            i = Add(i, 1)
        }
        t4 = assert_eq(total, 55, "while sum 1-10")
        t5 = Add(p, t4)
        p = t5
        total = 0
        i = 0
        WhileLoop LessThan(i, 3) {
            j = 0
            WhileLoop LessThan(j, 4) {
                total = Add(total, 1)
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        t6 = assert_eq(total, 12, "nested while 3x4")
        t7 = Add(p, t6)
        p = t7
        x = 0
        WhileLoop EqualTo(1, 1) {
            IfCondition Not(And(LessThan(x, 10), NotEqual(x, 5))) ThenBlock: {
                BreakLoop
            }
            x = Add(x, 1)
        }
        t8 = assert_eq(x, 5, "while with and")
        t9 = Add(p, t8)
        p = t9
        count = 0
        WhileLoop EqualTo(1, 1) {
            IfCondition Not(EqualTo(1, 1)) ThenBlock: {
                BreakLoop
            }
            count = Add(count, 1)
            IfCondition EqualTo(count, 5) ThenBlock: {
                BreakLoop
            }
        }
        t10 = assert_eq(count, 5, "while with break")
        t11 = Add(p, t10)
        p = t11
        n = 10
        count = 0
        WhileLoop GreaterThan(n, 0) {
            count = Add(count, 1)
            n = Subtract(n, 1)
        }
        t12 = assert_eq(count, 10, "while decrement")
        t13 = Add(p, t12)
        p = t13
        PrintMessage("While loops:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 7")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_for_loops {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 11: For Loops ===")
        PrintMessage("\n")
        p = 0
        total = 0
        lc0 = 0
        ls0 = 5
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            total = Add(total, 1)
        }
        t1 = assert_eq(total, 5, "for range(5)")
        t2 = Add(p, t1)
        p = t2
        total = 0
        lc3 = 2
        ls3 = 6
        lt3 = 1
        WhileLoop LessThan(lc3, ls3) {
            i = lc3
            lc3 = Add(lc3, lt3)
            total = Add(total, i)
        }
        t4 = assert_eq(total, 14, "for range(2,6)")
        t5 = Add(p, t4)
        p = t5
        total = 0
        lc6 = 0
        ls6 = 10
        lt6 = 2
        WhileLoop LessThan(lc6, ls6) {
            i = lc6
            lc6 = Add(lc6, lt6)
            total = Add(total, i)
        }
        t7 = assert_eq(total, 20, "for range step=2")
        t8 = Add(p, t7)
        p = t8
        count = 0
        lc9 = 0
        ls9 = 0
        lt9 = 1
        WhileLoop LessThan(lc9, ls9) {
            i = lc9
            lc9 = Add(lc9, lt9)
            count = Add(count, 1)
        }
        t10 = assert_eq(count, 0, "for range(0)")
        t11 = Add(p, t10)
        p = t11
        count = 0
        lc12 = 0
        ls12 = 1
        lt12 = 1
        WhileLoop LessThan(lc12, ls12) {
            i = lc12
            lc12 = Add(lc12, lt12)
            count = Add(count, 1)
        }
        t13 = assert_eq(count, 1, "for range(1)")
        t14 = Add(p, t13)
        p = t14
        total = 0
        lc15 = 0
        ls15 = 3
        lt15 = 1
        WhileLoop LessThan(lc15, ls15) {
            i = lc15
            lc15 = Add(lc15, lt15)
            lc16 = 0
            ls16 = 4
            lt16 = 1
            WhileLoop LessThan(lc16, ls16) {
                j = lc16
                lc16 = Add(lc16, lt16)
                total = Add(total, 1)
            }
        }
        t17 = assert_eq(total, 12, "nested for 3x4")
        t18 = Add(p, t17)
        p = t18
        count = 0
        lc19 = 0
        ls19 = 2
        lt19 = 1
        WhileLoop LessThan(lc19, ls19) {
            a = lc19
            lc19 = Add(lc19, lt19)
            lc20 = 0
            ls20 = 2
            lt20 = 1
            WhileLoop LessThan(lc20, ls20) {
                b = lc20
                lc20 = Add(lc20, lt20)
                lc21 = 0
                ls21 = 2
                lt21 = 1
                WhileLoop LessThan(lc21, ls21) {
                    c = lc21
                    lc21 = Add(lc21, lt21)
                    lc22 = 0
                    ls22 = 2
                    lt22 = 1
                    WhileLoop LessThan(lc22, ls22) {
                        d = lc22
                        lc22 = Add(lc22, lt22)
                        count = Add(count, 1)
                    }
                }
            }
        }
        t23 = assert_eq(count, 16, "deeply nested 2^4")
        t24 = Add(p, t23)
        p = t24
        last = 0
        lc25 = 0
        ls25 = 5
        lt25 = 1
        WhileLoop LessThan(lc25, ls25) {
            i = lc25
            lc25 = Add(lc25, lt25)
            last = i
        }
        t26 = assert_eq(last, 4, "for var capture")
        t27 = Add(p, t26)
        p = t27
        PrintMessage("For loops:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 8")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_for_in_list {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 12: For In List ===")
        PrintMessage("\n")
        p = 0
        nums = Array.Create(3)
        Array.Push(nums, 10)
        Array.Push(nums, 20)
        Array.Push(nums, 30)
        total = 0
        iter0 = nums
        iterlen0 = AIMacro.SmartLen(iter0)
        iteri0 = 0
        WhileLoop LessThan(iteri0, iterlen0) {
            x = DictGen_SmartGet(iter0, iteri0)
            total = Add(total, x)
            iteri0 = Add(iteri0, 1)
        }
        t1 = assert_eq(total, 60, "for in list sum")
        t2 = Add(p, t1)
        p = t2
        nums = Array.Create(5)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        Array.Push(nums, 3)
        Array.Push(nums, 4)
        Array.Push(nums, 5)
        doubled = Array.Create(0)
        iter3 = nums
        iterlen3 = AIMacro.SmartLen(iter3)
        iteri3 = 0
        WhileLoop LessThan(iteri3, iterlen3) {
            x = DictGen_SmartGet(iter3, iteri3)
            AIMacro.SmartPush(doubled, Multiply(x, 2))
            iteri3 = Add(iteri3, 1)
        }
        t4 = AIMacro.SmartLen(doubled)
        t5 = assert_eq(t4, 5, "for in list append")
        t6 = Add(p, t5)
        p = t6
        t7 = DictGen_SmartGet(doubled, 0)
        t8 = assert_eq(t7, 2, "doubled[0]")
        t9 = Add(p, t8)
        p = t9
        t10 = DictGen_SmartGet(doubled, 4)
        t11 = assert_eq(t10, 10, "doubled[4]")
        t12 = Add(p, t11)
        p = t12
        PrintMessage("For in list:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 4")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_break_continue {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 13: Break and Continue ===")
        PrintMessage("\n")
        p = 0
        count = 0
        lc0 = 0
        ls0 = 10
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            IfCondition EqualTo(i, 3) ThenBlock: {
                BreakLoop
            }
            count = Add(count, 1)
        }
        t1 = assert_eq(count, 3, "break in for")
        t2 = Add(p, t1)
        p = t2
        count = 0
        WhileLoop EqualTo(1, 1) {
            IfCondition Not(EqualTo(1, 1)) ThenBlock: {
                BreakLoop
            }
            count = Add(count, 1)
            IfCondition EqualTo(count, 5) ThenBlock: {
                BreakLoop
            }
        }
        t3 = assert_eq(count, 5, "break in while")
        t4 = Add(p, t3)
        p = t4
        outer_count = 0
        lc5 = 0
        ls5 = 5
        lt5 = 1
        WhileLoop LessThan(lc5, ls5) {
            i = lc5
            lc5 = Add(lc5, lt5)
            lc6 = 0
            ls6 = 5
            lt6 = 1
            WhileLoop LessThan(lc6, ls6) {
                j = lc6
                lc6 = Add(lc6, lt6)
                IfCondition EqualTo(j, 2) ThenBlock: {
                    BreakLoop
                }
            }
            outer_count = Add(outer_count, 1)
        }
        t7 = assert_eq(outer_count, 5, "break in nested")
        t8 = Add(p, t7)
        p = t8
        total = 0
        lc9 = 0
        ls9 = 10
        lt9 = 1
        WhileLoop LessThan(lc9, ls9) {
            i = lc9
            lc9 = Add(lc9, lt9)
            IfCondition EqualTo(Modulo(i, 2), 0) ThenBlock: {
                ContinueLoop
            }
            total = Add(total, i)
        }
        t10 = assert_eq(total, 25, "continue in for (odd sum)")
        t11 = Add(p, t10)
        p = t11
        total = 0
        i = 0
        WhileLoop LessThan(i, 10) {
            i = Add(i, 1)
            IfCondition EqualTo(Modulo(i, 2), 0) ThenBlock: {
                ContinueLoop
            }
            total = Add(total, i)
        }
        t12 = assert_eq(total, 25, "continue in while")
        t13 = Add(p, t12)
        p = t13
        t14 = return_from_loop()
        result = t14
        t15 = assert_eq(result, 5, "return in loop")
        t16 = Add(p, t15)
        p = t16
        t17 = return_from_nested_loop()
        result = t17
        t18 = assert_eq(result, 505, "return in nested loop")
        t19 = Add(p, t18)
        p = t19
        PrintMessage("Break and continue:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 7")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.return_from_loop {
    Body: {
        lc0 = 0
        ls0 = 100
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            IfCondition EqualTo(i, 5) ThenBlock: {
                ReturnValue(i)
            }
        }
        ReturnValue(Subtract(0, 1))
    }
}

Function.return_from_nested_loop {
    Body: {
        lc0 = 0
        ls0 = 10
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            lc1 = 0
            ls1 = 10
            lt1 = 1
            WhileLoop LessThan(lc1, ls1) {
                j = lc1
                lc1 = Add(lc1, lt1)
                IfCondition EqualTo(Multiply(i, j), 25) ThenBlock: {
                    t2 = Multiply(i, 100)
                    t3 = Add(t2, j)
                    ReturnValue(t3)
                }
            }
        }
        ReturnValue(Subtract(0, 1))
    }
}

Function.helper_double {
    Input: p_x: Integer
    Body: {
        t0 = Multiply(p_x, 2)
        ReturnValue(t0)
    }
}

Function.helper_add {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        t0 = Add(p_a, p_b)
        ReturnValue(t0)
    }
}

Function.helper_add3 {
    Input: p_a: Integer
    Input: p_b: Integer
    Input: p_c: Integer
    Body: {
        t0 = Add(p_a, p_b)
        t1 = Add(t0, p_c)
        ReturnValue(t1)
    }
}

Function.helper_factorial {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 1) ThenBlock: {
            ReturnValue(1)
        }
        t0 = Subtract(p_n, 1)
        t1 = helper_factorial(t0)
        t2 = Multiply(p_n, t1)
        ReturnValue(t2)
    }
}

Function.helper_fib {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 1) ThenBlock: {
            ReturnValue(p_n)
        }
        t0 = Subtract(p_n, 1)
        t1 = helper_fib(t0)
        t2 = Subtract(p_n, 2)
        t3 = helper_fib(t2)
        t4 = Add(t1, t3)
        ReturnValue(t4)
    }
}

Function.helper_many_params {
    Input: p__args: Address
    Body: {
        p_a = DictGen_SmartGet(p__args, 0)
        p_b = DictGen_SmartGet(p__args, 1)
        p_c = DictGen_SmartGet(p__args, 2)
        p_d = DictGen_SmartGet(p__args, 3)
        p_e = DictGen_SmartGet(p__args, 4)
        p_f = DictGen_SmartGet(p__args, 5)
        p_g = DictGen_SmartGet(p__args, 6)
        p_h = DictGen_SmartGet(p__args, 7)
        t0 = Add(p_a, p_b)
        t1 = Add(t0, p_c)
        t2 = Add(t1, p_d)
        t3 = Add(t2, p_e)
        t4 = Add(t3, p_f)
        t5 = Add(t4, p_g)
        t6 = Add(t5, p_h)
        ReturnValue(t6)
    }
}

Function.helper_no_params {
    Body: {
        ReturnValue(42)
    }
}

Function.helper_modify_param {
    Input: p_x: Integer
    Body: {
        p_x = Add(p_x, 1)
        p_x = Multiply(p_x, 2)
        ReturnValue(p_x)
    }
}

Function.test_functions {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 14: Functions ===")
        PrintMessage("\n")
        p = 0
        t0 = helper_double(5)
        t1 = assert_eq(t0, 10, "basic function")
        t2 = Add(p, t1)
        p = t2
        t3 = helper_add(15, 27)
        t4 = assert_eq(t3, 42, "two params")
        t5 = Add(p, t4)
        p = t5
        t6 = helper_add3(1, 2, 3)
        t7 = assert_eq(t6, 6, "three params")
        t8 = Add(p, t7)
        p = t8
        t9 = Array.Create(8)
        Array.Push(t9, 1)
        Array.Push(t9, 2)
        Array.Push(t9, 3)
        Array.Push(t9, 4)
        Array.Push(t9, 5)
        Array.Push(t9, 6)
        Array.Push(t9, 7)
        Array.Push(t9, 8)
        t10 = helper_many_params(t9)
        t11 = assert_eq(t10, 36, "eight params")
        t12 = Add(p, t11)
        p = t12
        t13 = helper_no_params()
        t14 = assert_eq(t13, 42, "no params")
        t15 = Add(p, t14)
        p = t15
        t16 = helper_modify_param(5)
        t17 = assert_eq(t16, 12, "param modification")
        t18 = Add(p, t17)
        p = t18
        t19 = helper_factorial(5)
        t20 = assert_eq(t19, 120, "factorial(5)")
        t21 = Add(p, t20)
        p = t21
        t22 = helper_factorial(0)
        t23 = assert_eq(t22, 1, "factorial(0)")
        t24 = Add(p, t23)
        p = t24
        t25 = helper_fib(10)
        t26 = assert_eq(t25, 55, "fib(10)")
        t27 = Add(p, t26)
        p = t27
        t28 = helper_double(3)
        t29 = helper_double(t28)
        t30 = assert_eq(t29, 12, "nested calls")
        t31 = Add(p, t30)
        p = t31
        t32 = helper_double(2)
        t33 = helper_double(3)
        t34 = Add(t32, t33)
        t35 = assert_eq(t34, 10, "calls in expr")
        t36 = Add(p, t35)
        p = t36
        t37 = helper_add(1, 2)
        t38 = helper_add(3, 4)
        t39 = helper_add(t37, t38)
        t40 = assert_eq(t39, 10, "triple nested")
        t41 = Add(p, t40)
        p = t41
        t42 = helper_add(1, 2)
        t43 = helper_add(3, 4)
        t44 = helper_add(t42, t43)
        t45 = helper_add(5, 6)
        t46 = helper_add(7, 8)
        t47 = helper_add(t45, t46)
        t48 = helper_add(t44, t47)
        result = t48
        t49 = assert_eq(result, 36, "deeply nested calls")
        t50 = Add(p, t49)
        p = t50
        PrintMessage("Functions:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 13")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_recursion {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 15: Recursion ===")
        PrintMessage("\n")
        p = 0
        t0 = helper_factorial(10)
        t1 = assert_eq(t0, 3628800, "factorial(10)")
        t2 = Add(p, t1)
        p = t2
        t3 = count_down_recursive(50)
        t4 = assert_eq(t3, 50, "recursion depth 50")
        t5 = Add(p, t4)
        p = t5
        t6 = gcd(48, 18)
        t7 = assert_eq(t6, 6, "gcd(48,18)")
        t8 = Add(p, t7)
        p = t8
        t9 = gcd(100, 25)
        t10 = assert_eq(t9, 25, "gcd(100,25)")
        t11 = Add(p, t10)
        p = t11
        PrintMessage("Recursion:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 4")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.count_down_recursive {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 0) ThenBlock: {
            ReturnValue(0)
        }
        t0 = Subtract(p_n, 1)
        t1 = count_down_recursive(t0)
        t2 = Add(1, t1)
        ReturnValue(t2)
    }
}

Function.gcd {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        WhileLoop EqualTo(1, 1) {
            IfCondition Not(NotEqual(p_b, 0)) ThenBlock: {
                BreakLoop
            }
            temp = p_b
            p_b = Modulo(p_a, p_b)
            p_a = temp
        }
        ReturnValue(p_a)
    }
}

Function.test_lists {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 16: Lists ===")
        PrintMessage("\n")
        p = 0
        nums = Array.Create(5)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        Array.Push(nums, 3)
        Array.Push(nums, 4)
        Array.Push(nums, 5)
        t0 = AIMacro.SmartLen(nums)
        t1 = assert_eq(t0, 5, "list len")
        t2 = Add(p, t1)
        p = t2
        t3 = DictGen_SmartGet(nums, 0)
        t4 = assert_eq(t3, 1, "index [0]")
        t5 = Add(p, t4)
        p = t5
        t6 = DictGen_SmartGet(nums, 2)
        t7 = assert_eq(t6, 3, "index [2]")
        t8 = Add(p, t7)
        p = t8
        t9 = DictGen_SmartGet(nums, 4)
        t10 = assert_eq(t9, 5, "index [4]")
        t11 = Add(p, t10)
        p = t11
        t12 = AIMacro.SmartSize(nums)
        t13 = Subtract(t12, 1)
        t14 = DictGen_SmartGet(nums, t13)
        t15 = assert_eq(t14, 5, "index [-1]")
        t16 = Add(p, t15)
        p = t16
        DictGen_SmartSet(nums, 0, 100)
        t17 = DictGen_SmartGet(nums, 0)
        t18 = assert_eq(t17, 100, "index assign")
        t19 = Add(p, t18)
        p = t19
        items = Array.Create(2)
        Array.Push(items, 10)
        Array.Push(items, 20)
        AIMacro.SmartPush(items, 30)
        t20 = AIMacro.SmartLen(items)
        t21 = assert_eq(t20, 3, "append len")
        t22 = Add(p, t21)
        p = t22
        t23 = DictGen_SmartGet(items, 2)
        t24 = assert_eq(t23, 30, "append value")
        t25 = Add(p, t24)
        p = t25
        last = AIMacro.SmartPop(items)
        t26 = assert_eq(last, 30, "pop returns value")
        t27 = Add(p, t26)
        p = t27
        t28 = AIMacro.SmartLen(items)
        t29 = assert_eq(t28, 2, "pop reduces len")
        t30 = Add(p, t29)
        p = t30
        empty = Array.Create(0)
        t31 = AIMacro.SmartLen(empty)
        t32 = assert_eq(t31, 0, "empty list len")
        t33 = Add(p, t32)
        p = t33
        AIMacro.SmartPush(empty, 1)
        t34 = AIMacro.SmartLen(empty)
        t35 = assert_eq(t34, 1, "append to empty")
        t36 = Add(p, t35)
        p = t36
        arr = Array.Create(0)
        lc37 = 0
        ls37 = 5
        lt37 = 1
        WhileLoop LessThan(lc37, ls37) {
            i = lc37
            lc37 = Add(lc37, lt37)
            AIMacro.SmartPush(arr, Multiply(i, 10))
        }
        t38 = AIMacro.SmartLen(arr)
        t39 = assert_eq(t38, 5, "built list len")
        t40 = Add(p, t39)
        p = t40
        t41 = DictGen_SmartGet(arr, 3)
        t42 = assert_eq(t41, 30, "built list value")
        t43 = Add(p, t42)
        p = t43
        PrintMessage("Lists:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 14")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_list_operations {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 17: List Operations ===")
        PrintMessage("\n")
        p = 0
        nums = Array.Create(6)
        Array.Push(nums, 5)
        Array.Push(nums, 2)
        Array.Push(nums, 8)
        Array.Push(nums, 1)
        Array.Push(nums, 9)
        Array.Push(nums, 3)
        t0 = AIMacro.TypedSorted(nums)
        s = t0
        t1 = DictGen_SmartGet(s, 0)
        t2 = assert_eq(t1, 1, "sorted[0]")
        t3 = Add(p, t2)
        p = t3
        t4 = DictGen_SmartGet(s, 5)
        t5 = assert_eq(t4, 9, "sorted[5]")
        t6 = Add(p, t5)
        p = t6
        nums = Array.Create(3)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        Array.Push(nums, 3)
        t7 = AIMacro.TypedReversed(nums)
        r = t7
        t8 = DictGen_SmartGet(r, 0)
        t9 = assert_eq(t8, 3, "reversed[0]")
        t10 = Add(p, t9)
        p = t10
        t11 = DictGen_SmartGet(r, 2)
        t12 = assert_eq(t11, 1, "reversed[2]")
        t13 = Add(p, t12)
        p = t13
        original = Array.Create(3)
        Array.Push(original, 7)
        Array.Push(original, 8)
        Array.Push(original, 9)
        copied = AIMacro.TypedListCopy(original)
        t14 = DictGen_SmartGet(copied, 0)
        t15 = assert_eq(t14, 7, "copy[0]")
        t16 = Add(p, t15)
        p = t16
        DictGen_SmartSet(copied, 0, 100)
        t17 = DictGen_SmartGet(original, 0)
        t18 = assert_eq(t17, 7, "copy independence")
        t19 = Add(p, t18)
        p = t19
        nums = Array.Create(5)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        Array.Push(nums, 3)
        Array.Push(nums, 4)
        Array.Push(nums, 5)
        t20 = AIMacro.SmartSum(nums)
        t21 = assert_eq(t20, 15, "sum")
        t22 = Add(p, t21)
        p = t22
        t23 = AIMacro.Min(3, 7)
        t24 = assert_eq(t23, 3, "min(3,7)")
        t25 = Add(p, t24)
        p = t25
        t26 = AIMacro.Max(3, 7)
        t27 = assert_eq(t26, 7, "max(3,7)")
        t28 = Add(p, t27)
        p = t28
        arr = Array.Create(5)
        Array.Push(arr, 1)
        Array.Push(arr, 2)
        Array.Push(arr, 3)
        Array.Push(arr, 4)
        Array.Push(arr, 5)
        t29 = list_sum(arr)
        s = t29
        t30 = assert_eq(s, 15, "list as param")
        t31 = Add(p, t30)
        p = t31
        list_double_first(arr)
        t32 = DictGen_SmartGet(arr, 0)
        t33 = assert_eq(t32, 2, "modify list in func")
        t34 = Add(p, t33)
        p = t34
        PrintMessage("List operations:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 11")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.list_sum {
    Input: p_arr: Integer
    Body: {
        total = 0
        lc0 = 0
        ls0 = DictGen_SmartLen(p_arr)
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            t1 = DictGen_SmartGet(p_arr, i)
            t2 = Add(total, t1)
            total = t2
        }
        ReturnValue(total)
    }
}

Function.list_double_first {
    Input: p_arr: Integer
    Body: {
        t0 = DictGen_SmartGet(p_arr, 0)
        t1 = Multiply(t0, 2)
        DictGen_SmartSet(p_arr, 0, t1)
    }
}

Function.test_strings {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 18: Strings ===")
        PrintMessage("\n")
        p = 0
        s = "hello"
        t0 = DictGen_SmartLen(s)
        t1 = assert_eq(t0, 5, "string len")
        t2 = Add(p, t1)
        p = t2
        t3 = DictGen_SmartLen("")
        t4 = assert_eq(t3, 0, "empty string len")
        t5 = Add(p, t4)
        p = t5
        a = "Hello"
        b = "World"
        t6 = String.Concat(a, " ")
        t7 = String.Concat(t6, b)
        c = t7
        t8 = DictGen_SmartLen(c)
        t9 = assert_eq(t8, 11, "concat len")
        t10 = Add(p, t9)
        p = t10
        stars = String.Repeat("*", 10)
        t11 = DictGen_SmartLen(stars)
        t12 = assert_eq(t11, 10, "repeat len")
        t13 = Add(p, t12)
        p = t13
        n = 42
        s = AIMacro.Str(n)
        t14 = DictGen_SmartLen(s)
        t15 = assert_eq(t14, 2, "str(42) len")
        t16 = Add(p, t15)
        p = t16
        s = AIMacro.Str(Subtract(0, 100))
        t17 = DictGen_SmartLen(s)
        t18 = assert_eq(t17, 4, "str(-100) len")
        t19 = Add(p, t18)
        p = t19
        t20 = AIMacro.Int("123")
        x = t20
        t21 = assert_eq(x, 123, "int from string")
        t22 = Add(p, t21)
        p = t22
        t23 = AIMacro.Int("0")
        x = t23
        t24 = assert_eq(x, 0, "int('0')")
        t25 = Add(p, t24)
        p = t25
        t26 = String.Concat("a", "b")
        t27 = String.Concat(t26, "c")
        t28 = String.Concat(t27, "d")
        t29 = String.Concat(t28, "e")
        t30 = String.Concat(t29, "f")
        t31 = String.Concat(t30, "g")
        t32 = String.Concat(t31, "h")
        result = t32
        t33 = DictGen_SmartLen(result)
        t34 = assert_eq(t33, 8, "long concat")
        t35 = Add(p, t34)
        p = t35
        result = ""
        lc36 = 0
        ls36 = 5
        lt36 = 1
        WhileLoop LessThan(lc36, ls36) {
            i = lc36
            lc36 = Add(lc36, lt36)
            t37 = AIMacro.Str(i)
            t38 = String.Concat(result, t37)
            t39 = String.Concat(t38, "-")
            result = t39
        }
        t40 = DictGen_SmartLen(result)
        t41 = assert_eq(t40, 10, "concat in loop")
        t42 = Add(p, t41)
        p = t42
        PrintMessage("Strings:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 10")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_string_methods {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 19: String Methods ===")
        PrintMessage("\n")
        p = 0
        s = "  Hello World  "
        stripped = String.Strip(s)
        t0 = DictGen_SmartLen(stripped)
        t1 = assert_eq(t0, 11, "strip")
        t2 = Add(p, t1)
        p = t2
        word = "MixedCase"
        t3 = String.Upper(word)
        t4 = assert_str_eq(t3, "MIXEDCASE", "upper")
        t5 = Add(p, t4)
        p = t5
        t6 = String.Lower(word)
        t7 = assert_str_eq(t6, "mixedcase", "lower")
        t8 = Add(p, t7)
        p = t8
        text = "hello world"
        pos = String.Find(text, "world")
        t9 = assert_eq(pos, 6, "find")
        t10 = Add(p, t9)
        p = t10
        IfCondition String.StartsWith(text, "hello") ThenBlock: {
            p = Add(p, 1)
            PrintMessage("  PASS: startswith")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("  FAIL: startswith")
            PrintMessage("\n")
        }
        IfCondition String.EndsWith(text, "world") ThenBlock: {
            p = Add(p, 1)
            PrintMessage("  PASS: endswith")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("  FAIL: endswith")
            PrintMessage("\n")
        }
        original = "hello world"
        replaced = String.Replace(original, "world", "AIMacro")
        t11 = DictGen_SmartLen(replaced)
        t12 = assert_eq(t11, 13, "replace")
        t13 = Add(p, t12)
        p = t13
        banana = "banana"
        count = String.Count(banana, "a")
        t14 = assert_eq(count, 3, "count")
        t15 = Add(p, t14)
        p = t15
        PrintMessage("String methods:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 8")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_dicts {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 20: Dictionaries ===")
        PrintMessage("\n")
        p = 0
        d = Hash.Create(16)
        Hash.Set(d, "name", "Alice")
        Hash.Set(d, "age", 30)
        t0 = Hash.Get(d, "name")
        t1 = assert_eq(t0, "Alice", "dict access string")
        t2 = Add(p, t1)
        p = t2
        t3 = Hash.Get(d, "age")
        t4 = assert_eq(t3, 30, "dict access int")
        t5 = Add(p, t4)
        p = t5
        Hash.Set(d, "score", 95)
        t6 = Hash.Get(d, "score")
        t7 = assert_eq(t6, 95, "dict add key")
        t8 = Add(p, t7)
        p = t8
        t9 = Hash.Size(d)
        t10 = assert_eq(t9, 3, "dict len after add")
        t11 = Add(p, t10)
        p = t11
        Hash.Set(d, "age", 31)
        t12 = Hash.Get(d, "age")
        t13 = assert_eq(t12, 31, "dict update")
        t14 = Add(p, t13)
        p = t14
        t15 = Hash.Size(d)
        t16 = assert_eq(t15, 3, "dict len after update")
        t17 = Add(p, t16)
        p = t17
        empty = Hash.Create(16)
        t18 = Hash.Size(empty)
        t19 = assert_eq(t18, 0, "empty dict len")
        t20 = Add(p, t19)
        p = t20
        Hash.Set(empty, "first", 100)
        t21 = Hash.Size(empty)
        t22 = assert_eq(t21, 1, "dict len after first add")
        t23 = Add(p, t22)
        p = t23
        scores = Hash.Create(16)
        Hash.Set(scores, "alice", 95)
        Hash.Set(scores, "bob", 87)
        IfCondition Hash.Contains(scores, "alice") ThenBlock: {
            p = Add(p, 1)
            PrintMessage("  PASS: key in dict")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("  FAIL: key in dict")
            PrintMessage("\n")
        }
        IfCondition Not(Hash.Contains(scores, "charlie")) ThenBlock: {
            p = Add(p, 1)
            PrintMessage("  PASS: key not in dict")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("  FAIL: key not in dict")
            PrintMessage("\n")
        }
        d = Hash.Create(16)
        Hash.Set(d, "a", 1)
        Hash.Set(d, "b", 2)
        Hash.Set(d, "c", 3)
        keys = Hash.Keys(d)
        t24 = DictGen_SmartLen(keys)
        t25 = assert_eq(t24, 3, "keys len")
        t26 = Add(p, t25)
        p = t26
        vals = Hash.Values(d)
        t27 = DictGen_SmartLen(vals)
        t28 = assert_eq(t27, 3, "values len")
        t29 = Add(p, t28)
        p = t29
        items = Hash.Items(d)
        t30 = DictGen_SmartLen(items)
        t31 = assert_eq(t30, 3, "items len")
        t32 = Add(p, t31)
        p = t32
        Hash.Clear(d)
        t33 = Hash.Size(d)
        t34 = assert_eq(t33, 0, "clear")
        t35 = Add(p, t34)
        p = t35
        PrintMessage("Dictionaries:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 14")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_types {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 21: Type System ===")
        PrintMessage("\n")
        p = 0
        t0 = Types.IsInstance(42, TypeID.INT)
        t1 = assert_true(t0, "isinstance int")
        t2 = Add(p, t1)
        p = t2
        t3 = Types.IsInstance("hello", TypeID.STR)
        t4 = assert_true(t3, "isinstance str")
        t5 = Add(p, t4)
        p = t5
        t6 = Array.Create(3)
        Array.Push(t6, 1)
        Array.Push(t6, 2)
        Array.Push(t6, 3)
        t7 = Types.IsInstance(t6, TypeID.LIST)
        t8 = assert_true(t7, "isinstance list")
        t9 = Add(p, t8)
        p = t9
        t10 = Types.IsInstance(42, TypeID.STR)
        t11 = assert_false(t10, "int not str")
        t12 = Add(p, t11)
        p = t12
        t13 = Types.IsInstance("hi", TypeID.INT)
        t14 = assert_false(t13, "str not int")
        t15 = Add(p, t14)
        p = t15
        t16 = Types.IsInstance(42, TypeID.LIST)
        t17 = assert_false(t16, "int not list")
        t18 = Add(p, t17)
        p = t18
        nums = Array.Create(3)
        Array.Push(nums, 3)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        t19 = AIMacro.TypedSorted(nums)
        s = t19
        t20 = Types.IsInstance(s, TypeID.LIST)
        t21 = assert_true(t20, "sorted is list")
        t22 = Add(p, t21)
        p = t22
        PrintMessage("Type system:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 7")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.test_builtins {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 22: Builtins ===")
        PrintMessage("\n")
        p = 0
        t0 = Subtract(0, 5)
        t1 = AIMacro.Abs(t0)
        t2 = assert_eq(t1, 5, "abs(-5)")
        t3 = Add(p, t2)
        p = t3
        t4 = AIMacro.Abs(5)
        t5 = assert_eq(t4, 5, "abs(5)")
        t6 = Add(p, t5)
        p = t6
        t7 = AIMacro.Abs(0)
        t8 = assert_eq(t7, 0, "abs(0)")
        t9 = Add(p, t8)
        p = t9
        t10 = AIMacro.Min(10, 20)
        t11 = assert_eq(t10, 10, "min")
        t12 = Add(p, t11)
        p = t12
        t13 = AIMacro.Max(10, 20)
        t14 = assert_eq(t13, 20, "max")
        t15 = Add(p, t14)
        p = t15
        t16 = Array.Create(3)
        Array.Push(t16, 1)
        Array.Push(t16, 2)
        Array.Push(t16, 3)
        t17 = DictGen_SmartLen(t16)
        t18 = assert_eq(t17, 3, "len list")
        t19 = Add(p, t18)
        p = t19
        t20 = DictGen_SmartLen("abc")
        t21 = assert_eq(t20, 3, "len string")
        t22 = Add(p, t21)
        p = t22
        t23 = AIMacro.Bool(0)
        t24 = assert_eq(t23, 0, "bool(0)")
        t25 = Add(p, t24)
        p = t25
        t26 = AIMacro.Bool(1)
        t27 = assert_eq(t26, 1, "bool(1)")
        t28 = Add(p, t27)
        p = t28
        t29 = AIMacro.Bool(42)
        t30 = assert_eq(t29, 1, "bool(42)")
        t31 = Add(p, t30)
        p = t31
        t32 = AIMacro.Int(42)
        t33 = assert_eq(t32, 42, "int(42)")
        t34 = Add(p, t33)
        p = t34
        PrintMessage("Builtins:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 11")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.is_prime {
    Input: p_n: Integer
    Body: {
        IfCondition LessThan(p_n, 2) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(p_n, 2) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Modulo(p_n, 2), 0) ThenBlock: {
            ReturnValue(0)
        }
        i = 3
        WhileLoop LessEqual(Multiply(i, i), p_n) {
            IfCondition EqualTo(Modulo(p_n, i), 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 2)
        }
        ReturnValue(1)
    }
}

Function.integer_sqrt {
    Input: p_n: Integer
    Body: {
        IfCondition LessThan(p_n, 2) ThenBlock: {
            ReturnValue(p_n)
        }
        x = p_n
        y = Divide(Add(x, 1), 2)
        WhileLoop LessThan(y, x) {
            x = y
            y = Divide(Add(x, Divide(p_n, x)), 2)
        }
        ReturnValue(x)
    }
}

Function.sum_digits {
    Input: p_n: Integer
    Body: {
        total = 0
        WhileLoop GreaterThan(p_n, 0) {
            total = Add(total, Modulo(p_n, 10))
            p_n = Divide(p_n, 10)
        }
        ReturnValue(total)
    }
}

Function.reverse_number {
    Input: p_n: Integer
    Body: {
        rev = 0
        WhileLoop GreaterThan(p_n, 0) {
            rev = Add(Multiply(rev, 10), Modulo(p_n, 10))
            p_n = Divide(p_n, 10)
        }
        ReturnValue(rev)
    }
}

Function.test_algorithms {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 23: Algorithms ===")
        PrintMessage("\n")
        p = 0
        t0 = is_prime(2)
        t1 = assert_true(t0, "is_prime(2)")
        t2 = Add(p, t1)
        p = t2
        t3 = is_prime(17)
        t4 = assert_true(t3, "is_prime(17)")
        t5 = Add(p, t4)
        p = t5
        t6 = is_prime(15)
        t7 = assert_false(t6, "is_prime(15)")
        t8 = Add(p, t7)
        p = t8
        t9 = is_prime(1)
        t10 = assert_false(t9, "is_prime(1)")
        t11 = Add(p, t10)
        p = t11
        t12 = integer_sqrt(144)
        t13 = assert_eq(t12, 12, "sqrt(144)")
        t14 = Add(p, t13)
        p = t14
        t15 = integer_sqrt(100)
        t16 = assert_eq(t15, 10, "sqrt(100)")
        t17 = Add(p, t16)
        p = t17
        t18 = sum_digits(12345)
        t19 = assert_eq(t18, 15, "sum_digits")
        t20 = Add(p, t19)
        p = t20
        t21 = reverse_number(12345)
        t22 = assert_eq(t21, 54321, "reverse_number")
        t23 = Add(p, t22)
        p = t23
        t24 = gcd(48, 18)
        t25 = assert_eq(t24, 6, "gcd")
        t26 = Add(p, t25)
        p = t26
        arr = Array.Create(7)
        Array.Push(arr, 64)
        Array.Push(arr, 34)
        Array.Push(arr, 25)
        Array.Push(arr, 12)
        Array.Push(arr, 22)
        Array.Push(arr, 11)
        Array.Push(arr, 90)
        t27 = AIMacro.SmartLen(arr)
        n = t27
        lc28 = 0
        ls28 = Subtract(n, 1)
        lt28 = 1
        WhileLoop LessThan(lc28, ls28) {
            i = lc28
            lc28 = Add(lc28, lt28)
            lc29 = 0
            ls29 = Subtract(Subtract(n, 1), i)
            lt29 = 1
            WhileLoop LessThan(lc29, ls29) {
                j = lc29
                lc29 = Add(lc29, lt29)
                t30 = DictGen_SmartGet(arr, j)
                t31 = DictGen_SmartGet(arr, Add(j, 1))
                IfCondition GreaterThan(t30, t31) ThenBlock: {
                    t32 = DictGen_SmartGet(arr, j)
                    temp = t32
                    t33 = Add(j, 1)
                    t34 = DictGen_SmartGet(arr, t33)
                    DictGen_SmartSet(arr, j, t34)
                    DictGen_SmartSet(arr, Add(j, 1), temp)
                }
            }
        }
        t35 = DictGen_SmartGet(arr, 0)
        t36 = assert_eq(t35, 11, "bubble sort first")
        t37 = Add(p, t36)
        p = t37
        t38 = DictGen_SmartGet(arr, 6)
        t39 = assert_eq(t38, 90, "bubble sort last")
        t40 = Add(p, t39)
        p = t40
        PrintMessage("Algorithms:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 11")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.empty_function {
    Body: {
        ReturnValue(0)
    }
}

Function.function_with_only_assignment {
    Body: {
        x = 5
        ReturnValue(x)
    }
}

Function.test_edge_cases {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 24: Edge Cases ===")
        PrintMessage("\n")
        p = 0
        t0 = empty_function()
        t1 = assert_eq(t0, 0, "empty function")
        t2 = Add(p, t1)
        p = t2
        t3 = function_with_only_assignment()
        t4 = assert_eq(t3, 5, "only assignment")
        t5 = Add(p, t4)
        p = t5
        t6 = Multiply(0, 100)
        t7 = assert_eq(t6, 0, "zero multiply")
        t8 = Add(p, t7)
        p = t8
        t9 = Divide(100, 1)
        t10 = assert_eq(t9, 100, "divide by 1")
        t11 = Add(p, t10)
        p = t11
        big = 1000000
        t12 = Add(big, big)
        t13 = assert_eq(t12, 2000000, "large add")
        t14 = Add(p, t13)
        p = t14
        t15 = Multiply(big, 2)
        t16 = assert_eq(t15, 2000000, "large multiply")
        t17 = Add(p, t16)
        p = t17
        empty = ""
        t18 = DictGen_SmartLen(empty)
        t19 = assert_eq(t18, 0, "empty string")
        t20 = Add(p, t19)
        p = t20
        t21 = Subtract(0, 1)
        t22 = multiple_return_paths(3, t21)
        t23 = Subtract(0, 3)
        t24 = assert_eq(t22, t23, "multiple returns")
        t25 = Add(p, t24)
        p = t25
        t26 = Subtract(0, 1)
        t27 = Subtract(0, 1)
        t28 = multiple_return_paths(t26, t27)
        t29 = Subtract(0, 1)
        t30 = assert_eq(t28, t29, "multiple returns 2")
        t31 = Add(p, t30)
        p = t31
        t32 = multiple_return_paths(3, 4)
        t33 = assert_eq(t32, 7, "multiple returns 3")
        t34 = Add(p, t33)
        p = t34
        PrintMessage("Edge cases:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 10")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.multiple_return_paths {
    Input: p_x: Integer
    Input: p_y: Integer
    Body: {
        IfCondition LessThan(p_x, 0) ThenBlock: {
            IfCondition LessThan(p_y, 0) ThenBlock: {
                ReturnValue(Subtract(0, 1))
            }
            ReturnValue(Subtract(0, 2))
        }
        IfCondition LessThan(p_y, 0) ThenBlock: {
            ReturnValue(Subtract(0, 3))
        }
        t0 = Add(p_x, p_y)
        ReturnValue(t0)
    }
}

Function.mean {
    Input: p_arr: Integer
    Body: {
        t0 = DictGen_SmartLen(p_arr)
        IfCondition EqualTo(t0, 0) ThenBlock: {
            ReturnValue(0)
        }
        total = 0
        i = 0
        WhileLoop EqualTo(1, 1) {
            t1 = DictGen_SmartLen(p_arr)
            IfCondition Not(LessThan(i, t1)) ThenBlock: {
                BreakLoop
            }
            t2 = DictGen_SmartGet(p_arr, i)
            t3 = Add(total, t2)
            total = t3
            i = Add(i, 1)
        }
        t4 = DictGen_SmartLen(p_arr)
        t5 = Divide(total, t4)
        ReturnValue(t5)
    }
}

Function.filter_greater_than {
    Input: p_arr: Integer
    Input: p_threshold: Integer
    Body: {
        result = Array.Create(0)
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_arr)
            IfCondition Not(LessThan(i, t0)) ThenBlock: {
                BreakLoop
            }
            t1 = DictGen_SmartGet(p_arr, i)
            IfCondition GreaterThan(t1, p_threshold) ThenBlock: {
                t2 = DictGen_SmartGet(p_arr, i)
                AIMacro.SmartPush(result, t2)
            }
            i = Add(i, 1)
        }
        ReturnValue(result)
    }
}

Function.map_double {
    Input: p_arr: Integer
    Body: {
        result = Array.Create(0)
        i = 0
        WhileLoop EqualTo(1, 1) {
            t0 = DictGen_SmartLen(p_arr)
            IfCondition Not(LessThan(i, t0)) ThenBlock: {
                BreakLoop
            }
            t1 = DictGen_SmartGet(p_arr, i)
            t2 = Multiply(t1, 2)
            AIMacro.SmartPush(result, t2)
            i = Add(i, 1)
        }
        ReturnValue(result)
    }
}

Function.list_reverse {
    Input: p_arr: Integer
    Body: {
        result = Array.Create(0)
        t0 = DictGen_SmartLen(p_arr)
        t1 = Subtract(t0, 1)
        i = t1
        WhileLoop GreaterEqual(i, 0) {
            t2 = DictGen_SmartGet(p_arr, i)
            AIMacro.SmartPush(result, t2)
            i = Subtract(i, 1)
        }
        ReturnValue(result)
    }
}

Function.test_practical {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 25: Practical Programs ===")
        PrintMessage("\n")
        p = 0
        data = Array.Create(5)
        Array.Push(data, 10)
        Array.Push(data, 20)
        Array.Push(data, 30)
        Array.Push(data, 40)
        Array.Push(data, 50)
        t0 = mean(data)
        t1 = assert_eq(t0, 30, "mean")
        t2 = Add(p, t1)
        p = t2
        nums = Array.Create(10)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        Array.Push(nums, 3)
        Array.Push(nums, 4)
        Array.Push(nums, 5)
        Array.Push(nums, 6)
        Array.Push(nums, 7)
        Array.Push(nums, 8)
        Array.Push(nums, 9)
        Array.Push(nums, 10)
        t3 = filter_greater_than(nums, 5)
        filtered = t3
        t4 = DictGen_SmartLen(filtered)
        t5 = assert_eq(t4, 5, "filter len")
        t6 = Add(p, t5)
        p = t6
        t7 = DictGen_SmartGet(filtered, 0)
        t8 = assert_eq(t7, 6, "filter first")
        t9 = Add(p, t8)
        p = t9
        t10 = Array.Create(3)
        Array.Push(t10, 1)
        Array.Push(t10, 2)
        Array.Push(t10, 3)
        t11 = map_double(t10)
        doubled = t11
        t12 = DictGen_SmartGet(doubled, 0)
        t13 = assert_eq(t12, 2, "map first")
        t14 = Add(p, t13)
        p = t14
        t15 = DictGen_SmartGet(doubled, 2)
        t16 = assert_eq(t15, 6, "map last")
        t17 = Add(p, t16)
        p = t17
        t18 = Array.Create(5)
        Array.Push(t18, 1)
        Array.Push(t18, 2)
        Array.Push(t18, 3)
        Array.Push(t18, 4)
        Array.Push(t18, 5)
        t19 = list_reverse(t18)
        rev = t19
        t20 = DictGen_SmartGet(rev, 0)
        t21 = assert_eq(t20, 5, "reverse first")
        t22 = Add(p, t21)
        p = t22
        t23 = DictGen_SmartGet(rev, 4)
        t24 = assert_eq(t23, 1, "reverse last")
        t25 = Add(p, t24)
        p = t25
        PrintMessage("Practical programs:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 7")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

