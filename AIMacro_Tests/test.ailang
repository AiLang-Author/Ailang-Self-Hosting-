LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


SubRoutine.Main {
        PrintMessage("Test 1: Basic string")
        PrintMessage("\n")
        msg = "Hello"
        PrintMessage("Test 2: Should print Hello")
        PrintMessage("\n")
        AIMacro.SmartPrint(msg)
        PrintMessage("\n")
        PrintMessage("Test 3:")
        PrintMessage(" ")
        PrintNumber(42)
        PrintMessage("\n")
        label = "Value is"
        x = 100
        AIMacro.SmartPrint(label)
        PrintMessage("\n")
        AIMacro.SmartPrint(x)
        PrintMessage("\n")
        PrintMessage("====================")
        PrintMessage("\n")
        PrintMessage("Test 5: Manual separator")
        PrintMessage("\n")
        PrintMessage("====================")
        PrintMessage("\n")
        PrintMessage("All tests done")
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
