LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.factorial {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 1) ThenBlock: {
            ReturnValue(1)
        }
        t0 = Subtract(p_n, 1)
        t1 = factorial(t0)
        t2 = Multiply(p_n, t1)
        ReturnValue(t2)
    }
}

Function.fibonacci {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(p_n, 1) ThenBlock: {
            ReturnValue(1)
        }
        a = 0
        b = 1
        i = 2
        WhileLoop LessEqual(i, p_n) {
            temp = Add(a, b)
            a = b
            b = temp
            i = Add(i, 1)
        }
        ReturnValue(b)
    }
}

Function.sum_list {
    Input: p_items: Integer
    Body: {
        total = 0
        iter0 = p_items
        iterlen0 = AIMacro.SmartLen(iter0)
        iteri0 = 0
        WhileLoop LessThan(iteri0, iterlen0) {
            x = DictGen_SmartGet(iter0, iteri0)
            total = Add(total, x)
            iteri0 = Add(iteri0, 1)
        }
        ReturnValue(total)
    }
}

Function.find_max {
    Input: p_items: Integer
    Body: {
        t0 = DictGen_SmartLen(p_items)
        IfCondition EqualTo(t0, 0) ThenBlock: {
            ReturnValue(0)
        }
        t1 = DictGen_SmartGet(p_items, 0)
        max_val = t1
        iter2 = p_items
        iterlen2 = AIMacro.SmartLen(iter2)
        iteri2 = 0
        WhileLoop LessThan(iteri2, iterlen2) {
            x = DictGen_SmartGet(iter2, iteri2)
            IfCondition GreaterThan(x, max_val) ThenBlock: {
                max_val = x
            }
            iteri2 = Add(iteri2, 1)
        }
        ReturnValue(max_val)
    }
}

Function.string_test {
    Body: {
        s = "Hello"
        s2 = " World"
        t0 = String.Concat(s, s2)
        combined = t0
        PrintMessage("Combined:")
        PrintMessage(" ")
        AIMacro.SmartPrint(combined)
        PrintMessage("\n")
        t1 = DictGen_SmartLen(combined)
        PrintMessage("Length:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = String.Upper(combined)
        PrintMessage("Upper:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = AIMacro.Chr(GetByte(s, 0))
        first = t3
        t4 = StringLength(s)
        t5 = Subtract(t4, 1)
        t6 = AIMacro.Chr(GetByte(s, t5))
        last = t6
        PrintMessage("First char:")
        PrintMessage(" ")
        AIMacro.SmartPrint(first)
        PrintMessage("\n")
        PrintMessage("Last char:")
        PrintMessage(" ")
        AIMacro.SmartPrint(last)
        PrintMessage("\n")
    }
}

Function.list_test {
    Body: {
        nums = Array.Create(5)
        Array.Push(nums, 10)
        Array.Push(nums, 20)
        Array.Push(nums, 30)
        Array.Push(nums, 40)
        Array.Push(nums, 50)
        PrintMessage("List:")
        PrintMessage(" ")
        AIMacro.SmartPrint(nums)
        PrintMessage("\n")
        t0 = AIMacro.SmartLen(nums)
        PrintMessage("Length:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = sum_list(nums)
        PrintMessage("Sum:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = find_max(nums)
        PrintMessage("Max:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        AIMacro.SmartPush(nums, 60)
        DictGen_SmartSet(nums, 0, 100)
        PrintMessage("After modify:")
        PrintMessage(" ")
        AIMacro.SmartPrint(nums)
        PrintMessage("\n")
        t3 = AIMacro.SmartSize(nums)
        t4 = Subtract(t3, 1)
        t5 = DictGen_SmartGet(nums, t4)
        last = t5
        PrintMessage("Last element:")
        PrintMessage(" ")
        AIMacro.SmartPrint(last)
        PrintMessage("\n")
    }
}

Function.control_flow_test {
    Body: {
        PrintMessage("Counting 0-4:")
        PrintMessage("\n")
        lc0 = 0
        ls0 = 5
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
        PrintMessage("Even numbers 0-8:")
        PrintMessage("\n")
        i = 0
        WhileLoop LessThan(i, 10) {
            IfCondition NotEqual(Modulo(i, 2), 0) ThenBlock: {
                i = Add(i, 1)
                ContinueLoop
            }
            IfCondition GreaterThan(i, 8) ThenBlock: {
                BreakLoop
            }
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
            i = Add(i, 1)
        }
    }
}

Function.nested_calls_test {
    Body: {
        t0 = fibonacci(5)
        t1 = factorial(t0)
        result = t1
        PrintMessage("factorial(fibonacci(5)) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        nums = Array.Create(8)
        Array.Push(nums, 3)
        Array.Push(nums, 1)
        Array.Push(nums, 4)
        Array.Push(nums, 1)
        Array.Push(nums, 5)
        Array.Push(nums, 9)
        Array.Push(nums, 2)
        Array.Push(nums, 6)
        t2 = find_max(nums)
        t3 = sum_list(nums)
        t4 = Add(t2, t3)
        result2 = t4
        PrintMessage("max + sum =")
        PrintMessage(" ")
        AIMacro.SmartPrint(result2)
        PrintMessage("\n")
    }
}

SubRoutine.Main {
        PrintMessage("=== AIMACRO LANGUAGE TEST ===")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("[1] Factorial Test")
        PrintMessage("\n")
        t0 = factorial(5)
        PrintMessage("5! =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("[2] Fibonacci Test")
        PrintMessage("\n")
        t1 = fibonacci(10)
        PrintMessage("fib(10) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("[3] String Test")
        PrintMessage("\n")
        string_test()
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("[4] List Test")
        PrintMessage("\n")
        list_test()
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("[5] Control Flow Test")
        PrintMessage("\n")
        control_flow_test()
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("[6] Nested Calls Test")
        PrintMessage("\n")
        nested_calls_test()
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== ALL TESTS COMPLETE ===")
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
