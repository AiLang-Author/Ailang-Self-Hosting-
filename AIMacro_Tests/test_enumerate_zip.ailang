LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


SubRoutine.Main {
                t0 = String.Repeat("=", 40)
AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("ENUMERATE AND ZIP TESTS")
        PrintMessage("\n")
                t1 = String.Repeat("=", 40)
AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("\n[1] ENUMERATE")
        PrintMessage("\n")
        fruits = Array.Create(3)
        Array.Push(fruits, "apple")
        Array.Push(fruits, "banana")
        Array.Push(fruits, "cherry")
        PrintMessage("fruits = ['apple', 'banana', 'cherry']")
        PrintMessage("\n")
        t2 = AIMacro.Enumerate(fruits)
        pairs = t2
        PrintMessage("enumerate(fruits):")
        PrintMessage("\n")
        iter3 = pairs
        iterlen3 = AIMacro.SmartLen(iter3)
        iteri3 = 0
        WhileLoop LessThan(iteri3, iterlen3) {
            pair = DictGen_SmartGet(iter3, iteri3)
            t4 = DictGen_SmartGet(pair, 0)
            idx = t4
            t5 = DictGen_SmartGet(pair, 1)
            val = t5
            AIMacro.SmartPrint(idx)
            PrintMessage(" ")
            PrintMessage("->")
            PrintMessage(" ")
            AIMacro.SmartPrint(val)
            PrintMessage("\n")
            iteri3 = Add(iteri3, 1)
        }
        PrintMessage("\n[2] ENUMERATE WITH NUMBERS")
        PrintMessage("\n")
        nums = Array.Create(4)
        Array.Push(nums, 10)
        Array.Push(nums, 20)
        Array.Push(nums, 30)
        Array.Push(nums, 40)
        PrintMessage("nums = [10, 20, 30, 40]")
        PrintMessage("\n")
        t7 = AIMacro.Enumerate(nums)
        iter6 = t7
        iterlen6 = AIMacro.SmartLen(iter6)
        iteri6 = 0
        WhileLoop LessThan(iteri6, iterlen6) {
            pair = DictGen_SmartGet(iter6, iteri6)
            t8 = DictGen_SmartGet(pair, 0)
            i = t8
            t9 = DictGen_SmartGet(pair, 1)
            n = t9
            PrintMessage("Index")
            PrintMessage(" ")
            AIMacro.SmartPrint(i)
            PrintMessage(" ")
            PrintMessage("has value")
            PrintMessage(" ")
            AIMacro.SmartPrint(n)
            PrintMessage("\n")
            iteri6 = Add(iteri6, 1)
        }
        PrintMessage("\n[3] ZIP")
        PrintMessage("\n")
        names = Array.Create(3)
        Array.Push(names, "Alice")
        Array.Push(names, "Bob")
        Array.Push(names, "Charlie")
        scores = Array.Create(3)
        Array.Push(scores, 85)
        Array.Push(scores, 92)
        Array.Push(scores, 78)
        PrintMessage("names = ['Alice', 'Bob', 'Charlie']")
        PrintMessage("\n")
        PrintMessage("scores = [85, 92, 78]")
        PrintMessage("\n")
        t10 = AIMacro.Zip(names, scores)
        zipped = t10
        PrintMessage("zip(names, scores):")
        PrintMessage("\n")
        iter11 = zipped
        iterlen11 = AIMacro.SmartLen(iter11)
        iteri11 = 0
        WhileLoop LessThan(iteri11, iterlen11) {
            pair = DictGen_SmartGet(iter11, iteri11)
            t12 = DictGen_SmartGet(pair, 0)
            name = t12
            t13 = DictGen_SmartGet(pair, 1)
            score = t13
            AIMacro.SmartPrint(name)
            PrintMessage(" ")
            PrintMessage("scored")
            PrintMessage(" ")
            AIMacro.SmartPrint(score)
            PrintMessage("\n")
            iteri11 = Add(iteri11, 1)
        }
        PrintMessage("\n[4] ZIP DIFFERENT LENGTHS")
        PrintMessage("\n")
        a = Array.Create(5)
        Array.Push(a, 1)
        Array.Push(a, 2)
        Array.Push(a, 3)
        Array.Push(a, 4)
        Array.Push(a, 5)
        b = Array.Create(3)
        Array.Push(b, 10)
        Array.Push(b, 20)
        Array.Push(b, 30)
        PrintMessage("a = [1,2,3,4,5], b = [10,20,30]")
        PrintMessage("\n")
        PrintMessage("zip stops at shorter list:")
        PrintMessage("\n")
        t15 = AIMacro.Zip(a, b)
        iter14 = t15
        iterlen14 = AIMacro.SmartLen(iter14)
        iteri14 = 0
        WhileLoop LessThan(iteri14, iterlen14) {
            pair = DictGen_SmartGet(iter14, iteri14)
            t16 = DictGen_SmartGet(pair, 0)
            t17 = DictGen_SmartGet(pair, 1)
            t18 = DictGen_SmartGet(pair, 0)
            t19 = DictGen_SmartGet(pair, 1)
            t20 = Add(t18, t19)
            AIMacro.SmartPrint(t16)
            PrintMessage(" ")
            PrintMessage("+")
            PrintMessage(" ")
            AIMacro.SmartPrint(t17)
            PrintMessage(" ")
            PrintMessage("=")
            PrintMessage(" ")
            AIMacro.SmartPrint(t20)
            PrintMessage("\n")
            iteri14 = Add(iteri14, 1)
        }
        PrintMessage("\n[5] COMBINED: enumerate + operations")
        PrintMessage("\n")
        values = Array.Create(3)
        Array.Push(values, 100)
        Array.Push(values, 200)
        Array.Push(values, 300)
        total = 0
        t22 = AIMacro.Enumerate(values)
        iter21 = t22
        iterlen21 = AIMacro.SmartLen(iter21)
        iteri21 = 0
        WhileLoop LessThan(iteri21, iterlen21) {
            pair = DictGen_SmartGet(iter21, iteri21)
            t23 = DictGen_SmartGet(pair, 0)
            idx = t23
            t24 = DictGen_SmartGet(pair, 1)
            val = t24
            total = Add(total, val)
            PrintMessage("After index")
            PrintMessage(" ")
            AIMacro.SmartPrint(idx)
            PrintMessage(" ")
            PrintMessage("total =")
            PrintMessage(" ")
            AIMacro.SmartPrint(total)
            PrintMessage("\n")
            iteri21 = Add(iteri21, 1)
        }
        PrintMessage("Final total:")
        PrintMessage(" ")
        AIMacro.SmartPrint(total)
        PrintMessage("\n")
                t25 = String.Repeat("=", 40)
        t26 = String.Concat("\n", t25)
AIMacro.SmartPrint(t26)
        PrintMessage("\n")
        PrintMessage("ALL TESTS COMPLETE!")
        PrintMessage("\n")
                t27 = String.Repeat("=", 40)
AIMacro.SmartPrint(t27)
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
