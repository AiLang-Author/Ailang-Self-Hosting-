LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.test_sorted {
    Body: {
        PrintMessage("=== SORTED TEST ===")
        PrintMessage("\n")
        arr = Array.Create(6)
        Array.Push(arr, 5)
        Array.Push(arr, 2)
        Array.Push(arr, 8)
        Array.Push(arr, 1)
        Array.Push(arr, 9)
        Array.Push(arr, 3)
        t0 = AIMacro.TypedSorted(arr)
        result = t0
        PrintMessage("Input: [5,2,8,1,9,3]")
        PrintMessage("\n")
        PrintMessage("Sorted:")
        PrintMessage("\n")
        iter1 = result
        iterlen1 = AIMacro.SmartLen(iter1)
        iteri1 = 0
        WhileLoop LessThan(iteri1, iterlen1) {
            x = DictGen_SmartGet(iter1, iteri1)
            AIMacro.SmartPrint(x)
            PrintMessage("\n")
            iteri1 = Add(iteri1, 1)
        }
        t2 = DictGen_SmartGet(result, 0)
        t3 = DictGen_SmartGet(result, Subtract(AIMacro.SmartSize(result), 1))
        IfCondition And(EqualTo(t2, 1), EqualTo(t3, 9)) ThenBlock: {
            PrintMessage("PASS: sorted() works!")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: sorted() broken")
            PrintMessage("\n")
        }
    }
}

Function.test_operators {
    Body: {
        PrintMessage("=== OPERATOR TEST ===")
        PrintMessage("\n")
        x = Math.Power(2, 10)
        PrintMessage("2**10 =")
        PrintMessage(" ")
        AIMacro.SmartPrint(x)
        PrintMessage("\n")
        y = Math.FloorDiv(17, 5)
        PrintMessage("17//5 =")
        PrintMessage(" ")
        AIMacro.SmartPrint(y)
        PrintMessage("\n")
        z = Math.FloorDiv(Subtract(0, 17), 5)
        PrintMessage("-17//5 =")
        PrintMessage(" ")
        AIMacro.SmartPrint(z)
        PrintMessage("\n")
        a = 2
        a = Math.Power(a, 3)
        PrintMessage("2 **= 3 ->")
        PrintMessage(" ")
        AIMacro.SmartPrint(a)
        PrintMessage("\n")
        b = 100
        b = Math.FloorDiv(b, 7)
        PrintMessage("100 //= 7 ->")
        PrintMessage(" ")
        AIMacro.SmartPrint(b)
        PrintMessage("\n")
        IfCondition And(And(EqualTo(x, 1024), EqualTo(y, 3)), EqualTo(a, 8)) ThenBlock: {
            PrintMessage("PASS: operators work!")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: operator issue")
            PrintMessage("\n")
        }
    }
}

Function.test_list_ops {
    Body: {
        PrintMessage("=== LIST OPS TEST ===")
        PrintMessage("\n")
        arr = Array.Create(5)
        Array.Push(arr, 10)
        Array.Push(arr, 20)
        Array.Push(arr, 30)
        Array.Push(arr, 40)
        Array.Push(arr, 50)
        t0 = DictGen_SmartGet(arr, 0)
        PrintMessage("arr[0] =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = AIMacro.SmartSize(arr)
        t2 = Subtract(t1, 1)
        t3 = DictGen_SmartGet(arr, t2)
        PrintMessage("arr[-1] =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        slice1 = AIMacro.ListSlice(arr, 1, 4)
        t4 = DictGen_SmartLen(slice1)
        PrintMessage("arr[1:4] length:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        val = AIMacro.SmartPopAt(arr, 2)
        PrintMessage("pop(2) returned:")
        PrintMessage(" ")
        AIMacro.SmartPrint(val)
        PrintMessage("\n")
        t5 = AIMacro.SmartLen(arr)
        PrintMessage("len after pop:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        AIMacro.SmartPush(arr, 99)
        t6 = AIMacro.SmartSize(arr)
        t7 = Subtract(t6, 1)
        t8 = DictGen_SmartGet(arr, t7)
        PrintMessage("After append(99), last:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        idx = AIMacro.ListIndex(arr, 20)
        PrintMessage("index(20) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(idx)
        PrintMessage("\n")
        AIMacro.SmartPush(arr, 20)
        cnt = AIMacro.ListCount(arr, 20)
        PrintMessage("count(20) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(cnt)
        PrintMessage("\n")
        IfCondition AIMacro.ListContains(arr, 40) ThenBlock: {
            PrintMessage("40 in arr: True")
            PrintMessage("\n")
        }
        IfCondition Not(AIMacro.ListContains(arr, 999)) ThenBlock: {
            PrintMessage("999 not in arr: True")
            PrintMessage("\n")
        }
        PrintMessage("PASS: list ops work!")
        PrintMessage("\n")
    }
}

Function.test_string_ops {
    Body: {
        PrintMessage("=== STRING OPS TEST ===")
        PrintMessage("\n")
        s = "Hello World"
        t0 = AIMacro.Chr(GetByte(s, 0))
        PrintMessage("s[0] =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = StringLength(s)
        t2 = Subtract(t1, 1)
        t3 = AIMacro.Chr(GetByte(s, t2))
        PrintMessage("s[-1] =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        PrintMessage("s[0:5] =")
        PrintMessage(" ")
        AIMacro.SmartPrint(AIMacro.StringSlice(s, 0, 5))
        PrintMessage("\n")
        PrintMessage("s[6:] =")
        PrintMessage(" ")
        AIMacro.SmartPrint(AIMacro.StringSlice(s, 6, StringLength(s)))
        PrintMessage("\n")
        t4 = String.Upper(s)
        PrintMessage("upper:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        t5 = String.Lower(s)
        PrintMessage("lower:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        a = "foo"
        b = "bar"
        t6 = String.Concat(a, b)
        c = t6
        PrintMessage("concat:")
        PrintMessage(" ")
        AIMacro.SmartPrint(c)
        PrintMessage("\n")
        d = String.Repeat("x", 5)
        PrintMessage("repeat:")
        PrintMessage(" ")
        AIMacro.SmartPrint(d)
        PrintMessage("\n")
        IfCondition EqualTo(StringCompare("abc", "abc"), 0) ThenBlock: {
            PrintMessage("string == works")
            PrintMessage("\n")
        }
        IfCondition NotEqual(StringCompare("abc", "def"), 0) ThenBlock: {
            PrintMessage("string != works")
            PrintMessage("\n")
        }
        pos = String.Find(s, "World")
        PrintMessage("find('World') =")
        PrintMessage(" ")
        AIMacro.SmartPrint(pos)
        PrintMessage("\n")
        __oop_args_0 = Array.Create(1)
        Array.Push(__oop_args_0, ",")
        parts = OOP.MethodCall("a,b,c", "split", __oop_args_0)
        Array.Destroy(__oop_args_0)
        t7 = DictGen_SmartLen(parts)
        PrintMessage("split count:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        __oop_args_1 = Array.Create(1)
        Array.Push(__oop_args_1, parts)
        joined = OOP.MethodCall("-", "join", __oop_args_1)
        Array.Destroy(__oop_args_1)
        PrintMessage("joined:")
        PrintMessage(" ")
        AIMacro.SmartPrint(joined)
        PrintMessage("\n")
        PrintMessage("PASS: string ops work!")
        PrintMessage("\n")
    }
}

Function.test_control_flow {
    Body: {
        PrintMessage("=== CONTROL FLOW TEST ===")
        PrintMessage("\n")
        PrintMessage("range(3):")
        PrintMessage("\n")
        lc0 = 0
        ls0 = 3
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
        PrintMessage("range(2,5):")
        PrintMessage("\n")
        lc1 = 2
        ls1 = 5
        lt1 = 1
        WhileLoop LessThan(lc1, ls1) {
            i = lc1
            lc1 = Add(lc1, lt1)
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
        PrintMessage("range(0,10,3):")
        PrintMessage("\n")
        lc2 = 0
        ls2 = 10
        lt2 = 3
        WhileLoop LessThan(lc2, ls2) {
            i = lc2
            lc2 = Add(lc2, lt2)
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
        }
        PrintMessage("evens 0-8 (continue/break):")
        PrintMessage("\n")
        i = 0
        WhileLoop LessThan(i, 20) {
            IfCondition EqualTo(Modulo(i, 2), 1) ThenBlock: {
                i = Add(i, 1)
                ContinueLoop
            }
            IfCondition GreaterThan(i, 8) ThenBlock: {
                BreakLoop
            }
            AIMacro.SmartPrint(i)
            PrintMessage("\n")
            i = Add(i, 1)
        }
        PrintMessage("PASS: control flow works!")
        PrintMessage("\n")
    }
}

Function.test_builtins {
    Body: {
        PrintMessage("=== BUILTINS TEST ===")
        PrintMessage("\n")
        arr = Array.Create(8)
        Array.Push(arr, 3)
        Array.Push(arr, 1)
        Array.Push(arr, 4)
        Array.Push(arr, 1)
        Array.Push(arr, 5)
        Array.Push(arr, 9)
        Array.Push(arr, 2)
        Array.Push(arr, 6)
        t0 = AIMacro.SmartLen(arr)
        PrintMessage("len:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = AIMacro.SmartSum(arr)
        PrintMessage("sum:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = AIMacro.Min(1, 5)
        PrintMessage("min:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = AIMacro.Max(1, 5)
        PrintMessage("max:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = Subtract(0, 42)
        t5 = AIMacro.Abs(t4)
        PrintMessage("abs(-42):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        n = 123
        s = AIMacro.Str(n)
        PrintMessage("str(123):")
        PrintMessage(" ")
        AIMacro.SmartPrint(s)
        PrintMessage("\n")
        t6 = AIMacro.Int("456")
        back = t6
        PrintMessage("int('456'):")
        PrintMessage(" ")
        AIMacro.SmartPrint(back)
        PrintMessage("\n")
        t7 = AIMacro.Ord("A")
        PrintMessage("ord('A'):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        t8 = AIMacro.Chr(66)
        PrintMessage("chr(66):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        t9 = AIMacro.Bool(0)
        PrintMessage("bool(0):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t9)
        PrintMessage("\n")
        t10 = AIMacro.Bool(1)
        PrintMessage("bool(1):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t10)
        PrintMessage("\n")
        t11 = Array.Create(3)
        Array.Push(t11, 0)
        Array.Push(t11, 0)
        Array.Push(t11, 1)
        t12 = AIMacro.Any(t11)
        PrintMessage("any([0,0,1]):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t12)
        PrintMessage("\n")
        t13 = Array.Create(3)
        Array.Push(t13, 1)
        Array.Push(t13, 1)
        Array.Push(t13, 1)
        t14 = AIMacro.All(t13)
        PrintMessage("all([1,1,1]):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t14)
        PrintMessage("\n")
        t15 = Array.Create(3)
        Array.Push(t15, 1)
        Array.Push(t15, 0)
        Array.Push(t15, 1)
        t16 = AIMacro.All(t15)
        PrintMessage("all([1,0,1]):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t16)
        PrintMessage("\n")
        t17 = Array.Create(3)
        Array.Push(t17, 1)
        Array.Push(t17, 2)
        Array.Push(t17, 3)
        t18 = AIMacro.TypedReversed(t17)
        rev = t18
        t19 = DictGen_SmartGet(rev, 0)
        t20 = DictGen_SmartGet(rev, 1)
        t21 = DictGen_SmartGet(rev, 2)
        PrintMessage("reversed [1,2,3]:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t19)
        PrintMessage(" ")
        AIMacro.SmartPrint(t20)
        PrintMessage(" ")
        AIMacro.SmartPrint(t21)
        PrintMessage("\n")
        PrintMessage("PASS: builtins work!")
        PrintMessage("\n")
    }
}

Function.test_nested_calls {
    Body: {
        PrintMessage("=== NESTED CALLS TEST ===")
        PrintMessage("\n")
        arr = Array.Create(4)
        Array.Push(arr, 5)
        Array.Push(arr, 3)
        Array.Push(arr, 8)
        Array.Push(arr, 1)
        t0 = DictGen_SmartGet(arr, 0)
        t1 = DictGen_SmartGet(arr, 1)
        t2 = AIMacro.Min(t0, t1)
        t3 = DictGen_SmartGet(arr, 2)
        t4 = AIMacro.Max(t2, t3)
        result = t4
        PrintMessage("max(min(5,3), 8) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        t5 = AIMacro.SmartLen(arr)
        t6 = DictGen_SmartGet(arr, 0)
        IfCondition And(GreaterThan(t5, 2), GreaterThan(t6, 0)) ThenBlock: {
            PrintMessage("nested condition works")
            PrintMessage("\n")
        }
        PrintMessage("PASS: nested calls work!")
        PrintMessage("\n")
    }
}

SubRoutine.Main {
        PrintMessage("##################################")
        PrintMessage("\n")
        PrintMessage("# AIMACRO FULL FEATURE TEST")
        PrintMessage("\n")
        PrintMessage("##################################")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        test_sorted()
        PrintMessage("")
        PrintMessage("\n")
        test_operators()
        PrintMessage("")
        PrintMessage("\n")
        test_list_ops()
        PrintMessage("")
        PrintMessage("\n")
        test_string_ops()
        PrintMessage("")
        PrintMessage("\n")
        test_control_flow()
        PrintMessage("")
        PrintMessage("\n")
        test_builtins()
        PrintMessage("")
        PrintMessage("\n")
        test_nested_calls()
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("##################################")
        PrintMessage("\n")
        PrintMessage("# ALL TESTS COMPLETE")
        PrintMessage("\n")
        PrintMessage("##################################")
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
