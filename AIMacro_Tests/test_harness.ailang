LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.assert_eq {
    Input: p_actual: Integer
    Input: p_expected: Integer
    Input: p_test_name: Integer
    Body: {
        IfCondition EqualTo(p_actual, p_expected) ThenBlock: {
            PrintMessage("  PASS:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_test_name)
            PrintMessage("\n")
            ReturnValue(1)
        } ElseBlock: {
            PrintMessage("  FAIL:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_test_name)
            PrintMessage("\n")
            PrintMessage("    Expected:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_expected)
            PrintMessage("\n")
            PrintMessage("    Actual:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_actual)
            PrintMessage("\n")
            ReturnValue(0)
        }
    }
}

Function.assert_true {
    Input: p_condition: Integer
    Input: p_test_name: Integer
    Body: {
        t0 = assert_eq(p_condition, 1, p_test_name)
        ReturnValue(t0)
    }
}

Function.assert_false {
    Input: p_condition: Integer
    Input: p_test_name: Integer
    Body: {
        t0 = assert_eq(p_condition, 0, p_test_name)
        ReturnValue(t0)
    }
}

Function.test_arithmetic {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== Arithmetic Tests ===")
        PrintMessage("\n")
        passed = 0
        t0 = Add(1, 1)
        t1 = assert_eq(t0, 2, "1 + 1 = 2")
        t2 = Add(passed, t1)
        passed = t2
        t3 = Subtract(10, 3)
        t4 = assert_eq(t3, 7, "10 - 3 = 7")
        t5 = Add(passed, t4)
        passed = t5
        t6 = Multiply(4, 5)
        t7 = assert_eq(t6, 20, "4 * 5 = 20")
        t8 = Add(passed, t7)
        passed = t8
        t9 = Divide(20, 4)
        t10 = assert_eq(t9, 5, "20 / 4 = 5")
        t11 = Add(passed, t10)
        passed = t11
        t12 = Modulo(17, 5)
        t13 = assert_eq(t12, 2, "17 % 5 = 2")
        t14 = Add(passed, t13)
        passed = t14
        x = 10
        y = 3
        t15 = Add(x, y)
        t16 = assert_eq(t15, 13, "x + y = 13")
        t17 = Add(passed, t16)
        passed = t17
        PrintMessage("Arithmetic passed:")
        PrintMessage(" ")
        AIMacro.SmartPrint(passed)
        PrintMessage(" ")
        PrintMessage("/ 6")
        PrintMessage("\n")
        ReturnValue(passed)
    }
}

Function.test_comparisons {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== Comparison Tests ===")
        PrintMessage("\n")
        passed = 0
        t0 = GreaterThan(5, 3)
        t1 = assert_true(t0, "5 > 3")
        t2 = Add(passed, t1)
        passed = t2
        t3 = LessThan(3, 5)
        t4 = assert_true(t3, "3 < 5")
        t5 = Add(passed, t4)
        passed = t5
        t6 = GreaterEqual(5, 5)
        t7 = assert_true(t6, "5 >= 5")
        t8 = Add(passed, t7)
        passed = t8
        t9 = LessEqual(5, 5)
        t10 = assert_true(t9, "5 <= 5")
        t11 = Add(passed, t10)
        passed = t11
        t12 = EqualTo(5, 5)
        t13 = assert_true(t12, "5 == 5")
        t14 = Add(passed, t13)
        passed = t14
        t15 = NotEqual(5, 3)
        t16 = assert_true(t15, "5 != 3")
        t17 = Add(passed, t16)
        passed = t17
        PrintMessage("Comparisons passed:")
        PrintMessage(" ")
        AIMacro.SmartPrint(passed)
        PrintMessage(" ")
        PrintMessage("/ 6")
        PrintMessage("\n")
        ReturnValue(passed)
    }
}

Function.test_control_flow {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== Control Flow Tests ===")
        PrintMessage("\n")
        passed = 0
        result = 0
        IfCondition 1 ThenBlock: {
            result = 1
        }
        t0 = assert_eq(result, 1, "if true branch")
        t1 = Add(passed, t0)
        passed = t1
        result = 0
        IfCondition 0 ThenBlock: {
            result = 1
        } ElseBlock: {
            result = 2
        }
        t2 = assert_eq(result, 2, "else branch")
        t3 = Add(passed, t2)
        passed = t3
        count = 0
        i = 0
        WhileLoop LessThan(i, 5) {
            count = Add(count, 1)
            i = Add(i, 1)
        }
        t4 = assert_eq(count, 5, "while loop 5x")
        t5 = Add(passed, t4)
        passed = t5
        PrintMessage("Control flow passed:")
        PrintMessage(" ")
        AIMacro.SmartPrint(passed)
        PrintMessage(" ")
        PrintMessage("/ 3")
        PrintMessage("\n")
        ReturnValue(passed)
    }
}

Function.test_for_range {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== For Loop Tests ===")
        PrintMessage("\n")
        passed = 0
        total = 0
        lc0 = 0
        ls0 = 5
        lt0 = 1
        WhileLoop LessThan(lc0, ls0) {
            i = lc0
            lc0 = Add(lc0, lt0)
            total = Add(total, 1)
        }
        t1 = assert_eq(total, 5, "range(5)")
        t2 = Add(passed, t1)
        passed = t2
        total = 0
        lc3 = 2
        ls3 = 6
        lt3 = 1
        WhileLoop LessThan(lc3, ls3) {
            i = lc3
            lc3 = Add(lc3, lt3)
            total = Add(total, i)
        }
        t4 = assert_eq(total, 14, "range(2,6) sum")
        t5 = Add(passed, t4)
        passed = t5
        PrintMessage("For loops passed:")
        PrintMessage(" ")
        AIMacro.SmartPrint(passed)
        PrintMessage(" ")
        PrintMessage("/ 2")
        PrintMessage("\n")
        ReturnValue(passed)
    }
}

Function.helper_add {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        t0 = Add(p_a, p_b)
        ReturnValue(t0)
    }
}

Function.helper_factorial {
    Input: p_n: Integer
    Body: {
        IfCondition LessEqual(p_n, 1) ThenBlock: {
            ReturnValue(1)
        }
        t0 = Subtract(p_n, 1)
        t1 = helper_factorial(t0)
        t2 = Multiply(p_n, t1)
        ReturnValue(t2)
    }
}

Function.test_functions {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== Function Tests ===")
        PrintMessage("\n")
        passed = 0
        t0 = helper_add(3, 4)
        t1 = assert_eq(t0, 7, "add(3,4)")
        t2 = Add(passed, t1)
        passed = t2
        t3 = helper_factorial(5)
        t4 = assert_eq(t3, 120, "factorial(5)")
        t5 = Add(passed, t4)
        passed = t5
        PrintMessage("Functions passed:")
        PrintMessage(" ")
        AIMacro.SmartPrint(passed)
        PrintMessage(" ")
        PrintMessage("/ 2")
        PrintMessage("\n")
        ReturnValue(passed)
    }
}

Function.test_lists {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== List Tests ===")
        PrintMessage("\n")
        passed = 0
        nums = Array.Create(5)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        Array.Push(nums, 3)
        Array.Push(nums, 4)
        Array.Push(nums, 5)
        t0 = AIMacro.SmartLen(nums)
        t1 = assert_eq(t0, 5, "len([1,2,3,4,5])")
        t2 = Add(passed, t1)
        passed = t2
        t3 = DictGen_SmartGet(nums, 0)
        t4 = assert_eq(t3, 1, "nums[0]")
        t5 = Add(passed, t4)
        passed = t5
        t6 = DictGen_SmartGet(nums, 2)
        t7 = assert_eq(t6, 3, "nums[2]")
        t8 = Add(passed, t7)
        passed = t8
        t9 = AIMacro.SmartSize(nums)
        t10 = Subtract(t9, 1)
        t11 = DictGen_SmartGet(nums, t10)
        t12 = assert_eq(t11, 5, "nums[-1]")
        t13 = Add(passed, t12)
        passed = t13
        DictGen_SmartSet(nums, 0, 100)
        t14 = DictGen_SmartGet(nums, 0)
        t15 = assert_eq(t14, 100, "nums[0] = 100")
        t16 = Add(passed, t15)
        passed = t16
        items = Array.Create(2)
        Array.Push(items, 10)
        Array.Push(items, 20)
        AIMacro.SmartPush(items, 30)
        t17 = AIMacro.SmartLen(items)
        t18 = assert_eq(t17, 3, "append len")
        t19 = Add(passed, t18)
        passed = t19
        t20 = DictGen_SmartGet(items, 2)
        t21 = assert_eq(t20, 30, "append value")
        t22 = Add(passed, t21)
        passed = t22
        last = AIMacro.SmartPop(items)
        t23 = assert_eq(last, 30, "pop value")
        t24 = Add(passed, t23)
        passed = t24
        t25 = AIMacro.SmartLen(items)
        t26 = assert_eq(t25, 2, "pop len")
        t27 = Add(passed, t26)
        passed = t27
        PrintMessage("Lists passed:")
        PrintMessage(" ")
        AIMacro.SmartPrint(passed)
        PrintMessage(" ")
        PrintMessage("/ 10")
        PrintMessage("\n")
        ReturnValue(passed)
    }
}

Function.test_types {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== Type Tests ===")
        PrintMessage("\n")
        passed = 0
        t0 = Types.IsInstance(42, TypeID.INT)
        t1 = assert_true(t0, "42 is int")
        t2 = Add(passed, t1)
        passed = t2
        t3 = Types.IsInstance("hi", TypeID.STR)
        t4 = assert_true(t3, "str is str")
        t5 = Add(passed, t4)
        passed = t5
        t6 = Array.Create(2)
        Array.Push(t6, 1)
        Array.Push(t6, 2)
        t7 = Types.IsInstance(t6, TypeID.LIST)
        t8 = assert_true(t7, "list is list")
        t9 = Add(passed, t8)
        passed = t9
        nums = Array.Create(3)
        Array.Push(nums, 5)
        Array.Push(nums, 2)
        Array.Push(nums, 8)
        t10 = AIMacro.TypedSorted(nums)
        s = t10
        t11 = Types.IsInstance(s, TypeID.LIST)
        t12 = assert_true(t11, "sorted is list")
        t13 = Add(passed, t12)
        passed = t13
        t14 = DictGen_SmartGet(s, 0)
        t15 = assert_eq(t14, 2, "sorted[0]")
        t16 = Add(passed, t15)
        passed = t16
        t17 = Array.Create(3)
        Array.Push(t17, 1)
        Array.Push(t17, 2)
        Array.Push(t17, 3)
        t18 = AIMacro.TypedReversed(t17)
        r = t18
        t19 = Types.IsInstance(r, TypeID.LIST)
        t20 = assert_true(t19, "reversed is list")
        t21 = Add(passed, t20)
        passed = t21
        t22 = DictGen_SmartGet(r, 0)
        t23 = assert_eq(t22, 3, "reversed[0]")
        t24 = Add(passed, t23)
        passed = t24
        PrintMessage("Types passed:")
        PrintMessage(" ")
        AIMacro.SmartPrint(passed)
        PrintMessage(" ")
        PrintMessage("/ 7")
        PrintMessage("\n")
        ReturnValue(passed)
    }
}

SubRoutine.Main {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("========================================")
        PrintMessage("\n")
        PrintMessage("    AIMACRO TEST HARNESS v2")
        PrintMessage("\n")
        PrintMessage("========================================")
        PrintMessage("\n")
        total_passed = 0
        total_tests = 0
        t0 = test_arithmetic()
        p = t0
        total_passed = Add(total_passed, p)
        total_tests = Add(total_tests, 6)
        t1 = test_comparisons()
        p = t1
        total_passed = Add(total_passed, p)
        total_tests = Add(total_tests, 6)
        t2 = test_control_flow()
        p = t2
        total_passed = Add(total_passed, p)
        total_tests = Add(total_tests, 3)
        t3 = test_for_range()
        p = t3
        total_passed = Add(total_passed, p)
        total_tests = Add(total_tests, 2)
        t4 = test_functions()
        p = t4
        total_passed = Add(total_passed, p)
        total_tests = Add(total_tests, 2)
        t5 = test_lists()
        p = t5
        total_passed = Add(total_passed, p)
        total_tests = Add(total_tests, 10)
        t6 = test_types()
        p = t6
        total_passed = Add(total_passed, p)
        total_tests = Add(total_tests, 7)
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("========================================")
        PrintMessage("\n")
        PrintMessage("TOTAL:")
        PrintMessage(" ")
        AIMacro.SmartPrint(total_passed)
        PrintMessage(" ")
        PrintMessage("/")
        PrintMessage(" ")
        AIMacro.SmartPrint(total_tests)
        PrintMessage("\n")
        PrintMessage("========================================")
        PrintMessage("\n")
        IfCondition EqualTo(total_passed, total_tests) ThenBlock: {
            PrintMessage("ALL TESTS PASSED!")
            PrintMessage("\n")
        } ElseBlock: {
            failed = Subtract(total_tests, total_passed)
            PrintMessage("FAILED:")
            PrintMessage(" ")
            AIMacro.SmartPrint(failed)
            PrintMessage("\n")
        }
                ProcessExit(0)
}


RunTask(Main)
