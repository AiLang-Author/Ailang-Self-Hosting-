LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.test_int_conversion {
    Body: {
        PrintMessage("=== INT CONVERSION ===")
        PrintMessage("\n")
        s = "42"
        t0 = AIMacro.Int(s)
        n = t0
        t1 = AIMacro.Str(n)
        t2 = String.Concat("int('42') = ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        doubled = Multiply(n, 2)
        t3 = AIMacro.Str(doubled)
        t4 = String.Concat("doubled = ", t3)
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        neg = "-123"
        t5 = AIMacro.Int(neg)
        neg_n = t5
        t6 = AIMacro.Str(neg_n)
        t7 = String.Concat("int('-123') = ", t6)
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
    }
}

Function.test_math_builtins {
    Body: {
        PrintMessage("=== MATH BUILTINS ===")
        PrintMessage("\n")
        a = Subtract(0, 5)
        t0 = AIMacro.Abs(a)
        b = t0
        t1 = AIMacro.Str(b)
        t2 = String.Concat("abs(-5) = ", t1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        x = 10
        y = 3
        t3 = AIMacro.Max(x, y)
        bigger = t3
        t4 = AIMacro.Str(bigger)
        t5 = String.Concat("max(10, 3) = ", t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = AIMacro.Min(x, y)
        smaller = t6
        t7 = AIMacro.Str(smaller)
        t8 = String.Concat("min(10, 3) = ", t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
    }
}

Function.test_input_basic {
    Body: {
        PrintMessage("=== INPUT TEST ===")
        PrintMessage("\n")
        PrintMessage("Enter your name:")
        PrintMessage("\n")
        name = AIMacro.Input("")
                t0 = String.Concat("Hello, ", name)
        t1 = String.Concat(t0, "!")
AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintMessage("Enter a number:")
        PrintMessage("\n")
        num_str = AIMacro.Input("")
        t2 = AIMacro.Int(num_str)
        num = t2
        doubled = Multiply(num, 2)
        t3 = AIMacro.Str(doubled)
        t4 = String.Concat("Doubled: ", t3)
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
    }
}

SubRoutine.Main {
        test_int_conversion()
        PrintMessage("")
        PrintMessage("\n")
        test_math_builtins()
        PrintMessage("")
        PrintMessage("\n")
        test_input_basic()
        PrintMessage("=== ALL QUICK WINS TESTED ===")
        PrintMessage("\n")
                ProcessExit(0)
}


RunTask(Main)
