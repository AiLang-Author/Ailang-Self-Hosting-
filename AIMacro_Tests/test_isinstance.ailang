LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        PrintMessage("=== ISINSTANCE TESTS ===")
        PrintMessage("\n")
        arr = Array.Create(3)
        Array.Push(arr, 1)
        Array.Push(arr, 2)
        Array.Push(arr, 3)
        PrintMessage("arr = [1, 2, 3]")
        PrintMessage("\n")
        t0 = AIMacro.IsInstance(arr, TypeID.LIST)
        PrintMessage("isinstance(arr, list):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = AIMacro.IsInstance(arr, TypeID.STR)
        PrintMessage("isinstance(arr, str):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = AIMacro.IsInstance(arr, TypeID.INT)
        PrintMessage("isinstance(arr, int):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        s = "hello"
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("s = 'hello'")
        PrintMessage("\n")
        t3 = AIMacro.IsInstance(s, TypeID.STR)
        PrintMessage("isinstance(s, str):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = AIMacro.IsInstance(s, TypeID.LIST)
        PrintMessage("isinstance(s, list):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        t5 = AIMacro.IsInstance(s, TypeID.INT)
        PrintMessage("isinstance(s, int):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        n = 42
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("n = 42")
        PrintMessage("\n")
        t6 = AIMacro.IsInstance(n, TypeID.INT)
        PrintMessage("isinstance(n, int):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        t7 = AIMacro.IsInstance(n, TypeID.STR)
        PrintMessage("isinstance(n, str):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        t8 = AIMacro.IsInstance(n, TypeID.LIST)
        PrintMessage("isinstance(n, list):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        nothing = Types.GetNone()
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("nothing = None")
        PrintMessage("\n")
        t9 = AIMacro.Bool(Types.IsInstance(nothing, TypeID.NONE))
        PrintMessage("isinstance(nothing, None):")
        PrintMessage(" ")
        AIMacro.SmartPrint(t9)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== TYPE() TESTS ===")
        PrintMessage("\n")
        t10 = Types.TypeOf(arr)
        PrintMessage("type(arr) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t10)
        PrintMessage("\n")
        t11 = Types.TypeOf(s)
        PrintMessage("type(s) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        t12 = Types.TypeOf(n)
        PrintMessage("type(n) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t12)
        PrintMessage("\n")
        t13 = Types.TypeOf(nothing)
        PrintMessage("type(nothing) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(t13)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== PRACTICAL USAGE ===")
        PrintMessage("\n")
        t14 = Array.Create(3)
        Array.Push(t14, 10)
        Array.Push(t14, 20)
        Array.Push(t14, 30)
        describe(t14)
        describe("world")
        describe(999)
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== ALL TESTS COMPLETE ===")
        PrintMessage("\n")
    }
}

Function.describe {
    Input: p_val: Integer
    Body: {
        t0 = AIMacro.IsInstance(p_val, TypeID.LIST)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            t1 = DictGen_SmartLen(p_val)
            PrintMessage("It's a list with")
            PrintMessage(" ")
            AIMacro.SmartPrint(t1)
            PrintMessage(" ")
            PrintMessage("items")
            PrintMessage("\n")
        } ElseBlock: {
            t2 = AIMacro.IsInstance(p_val, TypeID.STR)
            IfCondition AIMacro.SmartBool(t2) ThenBlock: {
                PrintMessage("It's a string:")
                PrintMessage(" ")
                AIMacro.SmartPrint(p_val)
                PrintMessage("\n")
            } ElseBlock: {
                t3 = AIMacro.IsInstance(p_val, TypeID.INT)
                IfCondition AIMacro.SmartBool(t3) ThenBlock: {
                    PrintMessage("It's a number:")
                    PrintMessage(" ")
                    AIMacro.SmartPrint(p_val)
                    PrintMessage("\n")
                } ElseBlock: {
                    PrintMessage("Unknown type")
                    PrintMessage("\n")
                }
            }
        }
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
