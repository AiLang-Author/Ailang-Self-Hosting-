LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.Counter___init__ {
    Input: self: Address
    Output: Integer
    Body: {
        OOP.ObjectSet(self, "count", 0)
        ReturnValue(1)
    }
}

Function.Counter_increment {
    Input: self: Address
    Output: Address
    Body: {
        t0 = OOP.ObjectGet(self, "count")
        t1 = AIMacro.NumAdd(t0, 1)
        OOP.ObjectSet(self, "count", t1)
        ReturnValue(0)
    }
}

Function.Counter_get {
    Input: self: Address
    Output: Address
    Body: {
        t2 = OOP.ObjectGet(self, "count")
        ReturnValue(t2)
    }
}

Function.main {
    Body: {
        __oop_init_args_0 = Array.Create(0)
        __oop_inst_1 = OOP.ObjectNewInit("Counter", __oop_init_args_0)
        Array.Destroy(__oop_init_args_0)
        c = __oop_inst_1
        __oop_args_2 = Array.Create(0)
        OOP.MethodCall(c, "increment", __oop_args_2)
        __oop_args_3 = Array.Create(0)
        OOP.MethodCall(c, "increment", __oop_args_3)
        __oop_args_4 = Array.Create(0)
        val = OOP.MethodCall(c, "get", __oop_args_4)
        Array.Destroy(__oop_args_4)
        AIMacro.SmartPrint(val)
        PrintMessage("\n")
    }
}

Function.__OOP_ClassInit {
    Output: Integer
    Body: {
        OOP.ClassDefine("Counter", 0)
        OOP.ClassField("Counter", "count", "Integer")
        OOP.ClassMethod("Counter", "__init__", AddressOf(Counter___init__))
        OOP.ClassMethod("Counter", "increment", AddressOf(Counter_increment))
        OOP.ClassMethod("Counter", "get", AddressOf(Counter_get))
    
        ReturnValue(1)
    }
}


SubRoutine.Main {
    __OOP_ClassInit()
    main()
    ProcessExit(0)
}

RunTask(Main)
