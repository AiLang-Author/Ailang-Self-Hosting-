LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.assert_eq {
    Input: p_actual: Integer
    Input: p_expected: Integer
    Input: p_name: Integer
    Output: Integer
    Body: {
        t0 = AIMacro.NumEq(p_actual, p_expected)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            PrintMessage("  PASS:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_name)
            PrintMessage("\n")
            ReturnValue(1)
        } ElseBlock: {
            PrintMessage("  FAIL:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_name)
            PrintMessage(" ")
            PrintMessage("| Expected:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_expected)
            PrintMessage(" ")
            PrintMessage("Got:")
            PrintMessage(" ")
            AIMacro.SmartPrint(p_actual)
            PrintMessage("\n")
            ReturnValue(0)
        }
    }
}

Function.test_basic_instantiation {
    Output: Integer
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 1: Basic Class & Instantiation ===")
        PrintMessage("\n")
        p = 0
        __oop_init_args_0 = Array.Create(0)
        __oop_inst_1 = OOP.ObjectNewInit("Simple", __oop_init_args_0)
        Array.Destroy(__oop_init_args_0)
        s = __oop_inst_1
        t0 = OOP.ObjectGet(s, "value")
        v = t0
        t1 = assert_eq(v, 42, "basic instantiation")
        t2 = AIMacro.NumAdd(p, t1)
        p = t2
        PrintMessage("Basic instantiation:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 1")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.Simple___init__ {
    Input: self: Address
    Output: Integer
    Body: {
        OOP.ObjectSet(self, "value", 42)
        ReturnValue(1)
    }
}

Function.test_constructor_params {
