Function.test_object_in_object {
    Output: Integer
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 9: Object in Object ===")
        PrintMessage("\n")
        p = 0
        __oop_init_args_37 = Array.Create(2)
        Array.Push(__oop_init_args_37, 1)
        Array.Push(__oop_init_args_37, 2)
        __oop_inst_38 = OOP.ObjectNewInit("Point", __oop_init_args_37)
        Array.Destroy(__oop_init_args_37)
        p_a = __oop_inst_38
        __oop_init_args_39 = Array.Create(2)
        Array.Push(__oop_init_args_39, 3)
        Array.Push(__oop_init_args_39, 4)
        __oop_inst_40 = OOP.ObjectNewInit("Point", __oop_init_args_39)
        Array.Destroy(__oop_init_args_39)
        p_b = __oop_inst_40
        __oop_init_args_41 = Array.Create(2)
        Array.Push(__oop_init_args_41, p_a)
        Array.Push(__oop_init_args_41, p_b)
        __oop_inst_42 = OOP.ObjectNewInit("Pair", __oop_init_args_41)
        Array.Destroy(__oop_init_args_41)
        pair = __oop_inst_42
        t0 = OOP.ObjectGet(pair, "first")
        t1 = OOP.ObjectGet(t0, "x")
        t2 = assert_eq(t1, 1, "nested object access 1")
        t3 = AIMacro.NumAdd(p, t2)
        p = t3
        t4 = OOP.ObjectGet(pair, "second")
        t5 = OOP.ObjectGet(t4, "y")
        t6 = assert_eq(t5, 4, "nested object access 2")
        t7 = AIMacro.NumAdd(p, t6)
        p = t7
        PrintMessage("Object in object:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 2")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

