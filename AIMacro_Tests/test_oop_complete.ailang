Function.test_post_construction {
    Output: Integer
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 10: Post-Construction Modification ===")
        PrintMessage("\n")
        p = 0
        __oop_init_args_43 = Array.Create(1)
        Array.Push(__oop_init_args_43, 100)
        __oop_inst_44 = OOP.ObjectNewInit("Mutable", __oop_init_args_43)
        Array.Destroy(__oop_init_args_43)
        m = __oop_inst_44
        __oop_args_45 = Array.Create(0)
        before = OOP.MethodCall(m, "get_data", __oop_args_45)
        Array.Destroy(__oop_args_45)
        t0 = assert_eq(before, 100, "initial value")
        t1 = AIMacro.NumAdd(p, t0)
        p = t1
        __oop_args_46 = Array.Create(1)
        Array.Push(__oop_args_46, 999)
        OOP.MethodCall(m, "set_data", __oop_args_46)
        __oop_args_47 = Array.Create(0)
        after = OOP.MethodCall(m, "get_data", __oop_args_47)
        Array.Destroy(__oop_args_47)
        t2 = assert_eq(after, 999, "modified value")
        t3 = AIMacro.NumAdd(p, t2)
        p = t3
        PrintMessage("Post-construction:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 2")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.main {
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("############################################")
        PrintMessage("\n")
        PrintMessage("#     AIMACRO OOP COMPREHENSIVE TEST      #")
        PrintMessage("\n")
        PrintMessage("############################################")
        PrintMessage("\n")
        total = 0
        passed = 0
        t0 = test_basic_instantiation()
        t1 = AIMacro.NumAdd(passed, t0)
        passed = t1
        total = AIMacro.NumAdd(total, 1)
        t2 = test_constructor_params()
        t3 = AIMacro.NumAdd(passed, t2)
        passed = t3
        total = AIMacro.NumAdd(total, 2)
        t4 = test_state_modification()
        t5 = AIMacro.NumAdd(passed, t4)
        passed = t5
        total = AIMacro.NumAdd(total, 5)
        t6 = test_multiple_instances()
        t7 = AIMacro.NumAdd(passed, t6)
        passed = t7
        total = AIMacro.NumAdd(total, 2)
        t8 = test_object_as_param()
        t9 = AIMacro.NumAdd(passed, t8)
        passed = t9
        total = AIMacro.NumAdd(total, 1)
        t10 = test_object_return()
        t11 = AIMacro.NumAdd(passed, t10)
        passed = t11
        total = AIMacro.NumAdd(total, 2)
        t12 = test_chained_attrs()
        t13 = AIMacro.NumAdd(passed, t12)
        passed = t13
        total = AIMacro.NumAdd(total, 2)
        t14 = test_computed_returns()
        t15 = AIMacro.NumAdd(passed, t14)
        passed = t15
        total = AIMacro.NumAdd(total, 2)
        t16 = test_object_in_object()
        t17 = AIMacro.NumAdd(passed, t16)
        passed = t17
        total = AIMacro.NumAdd(total, 2)
        t18 = test_post_construction()
        t19 = AIMacro.NumAdd(passed, t18)
        passed = t19
        total = AIMacro.NumAdd(total, 2)
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("############################################")
        PrintMessage("\n")
        PrintMessage("#            FINAL RESULTS                #")
        PrintMessage("\n")
        PrintMessage("############################################")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("Total Tests:")
        PrintMessage(" ")
        AIMacro.SmartPrint(total)
        PrintMessage("\n")
        PrintMessage("Passed:")
        PrintMessage(" ")
        AIMacro.SmartPrint(passed)
        PrintMessage("\n")
        failed = AIMacro.NumSub(total, passed)
        PrintMessage("Failed:")
        PrintMessage(" ")
        AIMacro.SmartPrint(failed)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        t20 = AIMacro.NumEq(passed, total)
        IfCondition AIMacro.SmartBool(t20) ThenBlock: {
            PrintMessage("*** ALL TESTS PASSED ***")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("*** SOME TESTS FAILED ***")
            PrintMessage("\n")
        }
    }
}

Function.__OOP_ClassInit {
    Output: Integer
    Body: {
        OOP.ClassDefine("Simple", 0)
        OOP.ClassField("Simple", "value", "Integer")
        OOP.ClassMethod("Simple", "__init__", AddressOf(Simple___init__))
    
        OOP.ClassDefine("Point", 0)
        OOP.ClassField("Point", "x", "Address")
        OOP.ClassField("Point", "y", "Address")
        OOP.ClassMethod("Point", "__init__", AddressOf(Point___init__))
    
        OOP.ClassDefine("Counter", 0)
        OOP.ClassField("Counter", "count", "Integer")
        OOP.ClassMethod("Counter", "__init__", AddressOf(Counter___init__))
        OOP.ClassMethod("Counter", "increment", AddressOf(Counter_increment))
        OOP.ClassMethod("Counter", "decrement", AddressOf(Counter_decrement))
        OOP.ClassMethod("Counter", "add", AddressOf(Counter_add))
        OOP.ClassMethod("Counter", "get", AddressOf(Counter_get))
    
        OOP.ClassDefine("Box", 0)
        OOP.ClassField("Box", "corner", "Address")
        OOP.ClassMethod("Box", "__init__", AddressOf(Box___init__))
        OOP.ClassMethod("Box", "get_corner_x", AddressOf(Box_get_corner_x))
    
        OOP.ClassDefine("Rectangle", 0)
        OOP.ClassField("Rectangle", "width", "Address")
        OOP.ClassField("Rectangle", "height", "Address")
