Function.test_chained_attrs {
    Output: Integer
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 7: Chained Attributes ===")
        PrintMessage("\n")
        p = 0
        __oop_init_args_28 = Array.Create(2)
        Array.Push(__oop_init_args_28, 50)
        Array.Push(__oop_init_args_28, 60)
        __oop_inst_29 = OOP.ObjectNewInit("Point", __oop_init_args_28)
        Array.Destroy(__oop_init_args_28)
        inner_pt = __oop_inst_29
        __oop_init_args_30 = Array.Create(1)
        Array.Push(__oop_init_args_30, inner_pt)
        __oop_inst_31 = OOP.ObjectNewInit("Box", __oop_init_args_30)
        Array.Destroy(__oop_init_args_30)
        box = __oop_inst_31
        __oop_args_32 = Array.Create(0)
        corner_x = OOP.MethodCall(box, "get_corner_x", __oop_args_32)
        Array.Destroy(__oop_args_32)
        t0 = assert_eq(corner_x, 50, "chained via method")
        t1 = AIMacro.NumAdd(p, t0)
        p = t1
        t2 = OOP.ObjectGet(box, "corner")
        t3 = OOP.ObjectGet(t2, "x")
        direct_x = t3
        t4 = assert_eq(direct_x, 50, "direct chained access")
        t5 = AIMacro.NumAdd(p, t4)
        p = t5
        PrintMessage("Chained attrs:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 2")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

