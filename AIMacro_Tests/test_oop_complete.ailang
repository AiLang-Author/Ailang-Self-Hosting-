Function.test_state_modification {
    Output: Integer
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 3: State Modification ===")
        PrintMessage("\n")
        p = 0
        __oop_init_args_4 = Array.Create(0)
        __oop_inst_5 = OOP.ObjectNewInit("Counter", __oop_init_args_4)
        Array.Destroy(__oop_init_args_4)
        c = __oop_inst_5
        __oop_args_6 = Array.Create(0)
        initial = OOP.MethodCall(c, "get", __oop_args_6)
        Array.Destroy(__oop_args_6)
        t0 = assert_eq(initial, 0, "initial count")
        t1 = AIMacro.NumAdd(p, t0)
        p = t1
        __oop_args_7 = Array.Create(0)
        OOP.MethodCall(c, "increment", __oop_args_7)
        __oop_args_8 = Array.Create(0)
        after_inc = OOP.MethodCall(c, "get", __oop_args_8)
        Array.Destroy(__oop_args_8)
        t2 = assert_eq(after_inc, 1, "after increment")
        t3 = AIMacro.NumAdd(p, t2)
        p = t3
        __oop_args_9 = Array.Create(0)
        OOP.MethodCall(c, "increment", __oop_args_9)
        __oop_args_10 = Array.Create(0)
        OOP.MethodCall(c, "increment", __oop_args_10)
        __oop_args_11 = Array.Create(0)
        after_three = OOP.MethodCall(c, "get", __oop_args_11)
        Array.Destroy(__oop_args_11)
        t4 = assert_eq(after_three, 3, "multiple increments")
        t5 = AIMacro.NumAdd(p, t4)
        p = t5
        __oop_args_12 = Array.Create(0)
        OOP.MethodCall(c, "decrement", __oop_args_12)
        __oop_args_13 = Array.Create(0)
        after_dec = OOP.MethodCall(c, "get", __oop_args_13)
        Array.Destroy(__oop_args_13)
        t6 = assert_eq(after_dec, 2, "decrement")
        t7 = AIMacro.NumAdd(p, t6)
        p = t7
        __oop_args_14 = Array.Create(1)
        Array.Push(__oop_args_14, 10)
        OOP.MethodCall(c, "add", __oop_args_14)
        __oop_args_15 = Array.Create(0)
        after_add = OOP.MethodCall(c, "get", __oop_args_15)
        Array.Destroy(__oop_args_15)
        t8 = assert_eq(after_add, 12, "add with param")
        t9 = AIMacro.NumAdd(p, t8)
        p = t9
        PrintMessage("State modification:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 5")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

Function.Counter___init__ {
    Input: self: Address
    Output: Integer
    Body: {
        OOP.ObjectSet(self, "count", 0)
        ReturnValue(1)
    }
}

Function.Counter_increment {
    Input: self: Address
    Output: Address
    Body: {
        t10 = OOP.ObjectGet(self, "count")
        t11 = AIMacro.NumAdd(t10, 1)
        OOP.ObjectSet(self, "count", t11)
        ReturnValue(0)
    }
}

Function.Counter_decrement {
    Input: self: Address
    Output: Address
    Body: {
        t12 = OOP.ObjectGet(self, "count")
        t13 = AIMacro.NumSub(t12, 1)
        OOP.ObjectSet(self, "count", t13)
        ReturnValue(0)
    }
}

Function.Counter_add {
    Input: self: Address
    Input: n: Integer
    Output: Address
    Body: {
        t14 = OOP.ObjectGet(self, "count")
        t15 = AIMacro.NumAdd(t14, n)
        OOP.ObjectSet(self, "count", t15)
        ReturnValue(0)
    }
}

Function.Counter_get {
    Input: self: Address
    Output: Integer
    Body: {
        t16 = OOP.ObjectGet(self, "count")
        ReturnValue(t16)
    }
}

Function.test_multiple_instances {
    Output: Integer
    Body: {
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== SECTION 4: Multiple Instances ===")
        PrintMessage("\n")
        p = 0
        __oop_init_args_16 = Array.Create(0)
        __oop_inst_17 = OOP.ObjectNewInit("Counter", __oop_init_args_16)
        Array.Destroy(__oop_init_args_16)
        c1 = __oop_inst_17
        __oop_init_args_18 = Array.Create(0)
        __oop_inst_19 = OOP.ObjectNewInit("Counter", __oop_init_args_18)
        Array.Destroy(__oop_init_args_18)
        c2 = __oop_inst_19
        __oop_args_20 = Array.Create(1)
        Array.Push(__oop_args_20, 5)
        OOP.MethodCall(c1, "add", __oop_args_20)
        __oop_args_21 = Array.Create(1)
        Array.Push(__oop_args_21, 10)
        OOP.MethodCall(c2, "add", __oop_args_21)
        __oop_args_22 = Array.Create(0)
        v1 = OOP.MethodCall(c1, "get", __oop_args_22)
        Array.Destroy(__oop_args_22)
        __oop_args_23 = Array.Create(0)
        v2 = OOP.MethodCall(c2, "get", __oop_args_23)
        Array.Destroy(__oop_args_23)
        t0 = assert_eq(v1, 5, "instance 1 independent")
        t1 = AIMacro.NumAdd(p, t0)
        p = t1
        t2 = assert_eq(v2, 10, "instance 2 independent")
        t3 = AIMacro.NumAdd(p, t2)
        p = t3
        PrintMessage("Multiple instances:")
        PrintMessage(" ")
        AIMacro.SmartPrint(p)
        PrintMessage(" ")
        PrintMessage("/ 2")
        PrintMessage("\n")
        ReturnValue(p)
    }
}

