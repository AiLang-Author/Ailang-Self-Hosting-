LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.Point___init__ {
    Input: self: Address
    Input: x: Address
    Input: y: Address
    Output: Integer
    Body: {
        OOP.ObjectSet(self, "x", x)
        OOP.ObjectSet(self, "y", y)
        ReturnValue(1)
    }
}

Function.get_x {
    Input: p_p: Integer
    Body: {
        ReturnValue(OOP.ObjectGet(p_p, "x"))
    }
}

Function.Counter___init__ {
    Input: self: Address
    Output: Integer
    Body: {
        OOP.ObjectSet(self, "count", 0)
        ReturnValue(1)
    }
}

Function.Counter_increment {
    Input: self: Address
    Output: Address
    Body: {
        t0 = OOP.ObjectGet(self, "count")
        t1 = AIMacro.NumAdd(t0, 1)
        OOP.ObjectSet(self, "count", t1)
        ReturnValue(0)
    }
}

Function.Counter_get {
    Input: self: Address
    Output: Address
    Body: {
        t2 = OOP.ObjectGet(self, "count")
        ReturnValue(t2)
    }
}

Function.Wrapper___init__ {
    Input: self: Address
    Input: inner: Address
    Output: Integer
    Body: {
        OOP.ObjectSet(self, "inner", inner)
        ReturnValue(1)
    }
}

Function.Wrapper_get_inner_x {
    Input: self: Address
    Output: Address
    Body: {
        t3 = OOP.ObjectGet(self, "inner")
        t4 = OOP.ObjectGet(t3, "x")
        ReturnValue(t4)
    }
}

Function.distance {
    Input: p_p1: Integer
    Input: p_p2: Integer
    Body: {
        dx = AIMacro.NumSub(OOP.ObjectGet(p_p2, "x"), OOP.ObjectGet(p_p1, "x"))
        dy = AIMacro.NumSub(OOP.ObjectGet(p_p2, "y"), OOP.ObjectGet(p_p1, "y"))
        t0 = AIMacro.NumMul(dx, dx)
        t1 = AIMacro.NumMul(dy, dy)
        t2 = AIMacro.NumAdd(t0, t1)
        ReturnValue(t2)
    }
}

Function.__OOP_ClassInit {
    Output: Integer
    Body: {
        OOP.ClassDefine("Point", 0)
        OOP.ClassField("Point", "x", "Address")
        OOP.ClassField("Point", "y", "Address")
        OOP.ClassMethod("Point", "__init__", AddressOf(Point___init__))
    
        OOP.ClassDefine("Counter", 0)
        OOP.ClassField("Counter", "count", "Integer")
        OOP.ClassMethod("Counter", "__init__", AddressOf(Counter___init__))
        OOP.ClassMethod("Counter", "increment", AddressOf(Counter_increment))
        OOP.ClassMethod("Counter", "get", AddressOf(Counter_get))
    
        OOP.ClassDefine("Wrapper", 0)
        OOP.ClassField("Wrapper", "inner", "Address")
        OOP.ClassMethod("Wrapper", "__init__", AddressOf(Wrapper___init__))
        OOP.ClassMethod("Wrapper", "get_inner_x", AddressOf(Wrapper_get_inner_x))
    
        ReturnValue(1)
    }
}


SubRoutine.Main {
    __OOP_ClassInit()
        __oop_init_args_0 = Array.Create(2)
        Array.Push(__oop_init_args_0, 0)
        Array.Push(__oop_init_args_0, 0)
        __oop_inst_1 = OOP.ObjectNewInit("Point", __oop_init_args_0)
        Array.Destroy(__oop_init_args_0)
        p1 = __oop_inst_1
        __oop_init_args_2 = Array.Create(2)
        Array.Push(__oop_init_args_2, 3)
        Array.Push(__oop_init_args_2, 4)
        __oop_inst_3 = OOP.ObjectNewInit("Point", __oop_init_args_2)
        Array.Destroy(__oop_init_args_2)
        p2 = __oop_inst_3
        t3 = OOP.ObjectGet(p1, "x")
        x1 = t3
        t4 = OOP.ObjectGet(p1, "y")
        y1 = t4
        __oop_init_args_4 = Array.Create(0)
        __oop_inst_5 = OOP.ObjectNewInit("Counter", __oop_init_args_4)
        Array.Destroy(__oop_init_args_4)
        c = __oop_inst_5
        __oop_args_6 = Array.Create(0)
        OOP.MethodCall(c, "increment", __oop_args_6)
        __oop_args_7 = Array.Create(0)
        OOP.MethodCall(c, "increment", __oop_args_7)
        __oop_args_8 = Array.Create(0)
        val = OOP.MethodCall(c, "get", __oop_args_8)
        Array.Destroy(__oop_args_8)
        t5 = distance(p1, p2)
        d = t5
        PrintMessage("Tests complete")
        PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
