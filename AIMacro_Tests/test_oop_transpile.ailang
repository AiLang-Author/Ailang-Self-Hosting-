Function.test_inheritance {
    Body: {
        PrintMessage("=== TEST 2: Inheritance ===")
        PrintMessage("\n")
        __oop_init_args_2 = Array.Create(3)
        Array.Push(__oop_init_args_2, "Buddy")
        Array.Push(__oop_init_args_2, 3)
        Array.Push(__oop_init_args_2, "Labrador")
        __oop_inst_3 = OOP.ObjectNewInit("Dog", __oop_init_args_2)
        Array.Destroy(__oop_init_args_2)
        dog = __oop_inst_3
        __oop_init_args_4 = Array.Create(2)
        Array.Push(__oop_init_args_4, "Whiskers")
        Array.Push(__oop_init_args_4, 5)
        __oop_inst_5 = OOP.ObjectNewInit("Cat", __oop_init_args_4)
        Array.Destroy(__oop_init_args_4)
        cat = __oop_inst_5
        PrintMessage("dog.name:")
        PrintMessage("\n")
        AIMacro.SmartPrint(OOP.ObjectGet(dog, "name"))
        PrintMessage("\n")
        PrintMessage("dog.speak():")
        PrintMessage("\n")
        t1 = Array.Create(0)
        t0 = OOP.MethodCall(dog, "speak", t1)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("dog.get_breed():")
        PrintMessage("\n")
        t3 = Array.Create(0)
        t2 = OOP.MethodCall(dog, "get_breed", t3)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        PrintMessage("dog.get_age():")
        PrintMessage("\n")
        t5 = Array.Create(0)
        t4 = OOP.MethodCall(dog, "get_age", t5)
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        PrintMessage("cat.name:")
        PrintMessage("\n")
        AIMacro.SmartPrint(OOP.ObjectGet(cat, "name"))
        PrintMessage("\n")
        PrintMessage("cat.speak():")
        PrintMessage("\n")
        t7 = Array.Create(0)
        t6 = OOP.MethodCall(cat, "speak", t7)
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        PrintMessage("cat.get_age():")
        PrintMessage("\n")
        t9 = Array.Create(0)
        t8 = OOP.MethodCall(cat, "get_age", t9)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        PrintMessage("dog.birthday():")
        PrintMessage("\n")
        t11 = Array.Create(0)
        t10 = OOP.MethodCall(dog, "birthday", t11)
        AIMacro.SmartPrint(t10)
        PrintMessage("\n")
        PrintMessage("dog.get_age() after birthday:")
        PrintMessage("\n")
        t13 = Array.Create(0)
        t12 = OOP.MethodCall(dog, "get_age", t13)
        AIMacro.SmartPrint(t12)
        PrintMessage("\n")
        PrintMessage("TEST 2 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_isinstance {
    Body: {
        PrintMessage("=== TEST 3: isinstance() ===")
        PrintMessage("\n")
        __oop_init_args_6 = Array.Create(3)
        Array.Push(__oop_init_args_6, "Rex")
        Array.Push(__oop_init_args_6, 2)
        Array.Push(__oop_init_args_6, "German Shepherd")
        __oop_inst_7 = OOP.ObjectNewInit("Dog", __oop_init_args_6)
        Array.Destroy(__oop_init_args_6)
        dog = __oop_inst_7
        __oop_init_args_8 = Array.Create(2)
        Array.Push(__oop_init_args_8, "Mittens")
        Array.Push(__oop_init_args_8, 4)
        __oop_inst_9 = OOP.ObjectNewInit("Cat", __oop_init_args_8)
        Array.Destroy(__oop_init_args_8)
        cat = __oop_inst_9
        t0 = AIMacro.Bool(OOP.ObjectIsInstance(dog, "Dog"))
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            PrintMessage("isinstance(dog, Dog): PASS")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("isinstance(dog, Dog): FAIL")
            PrintMessage("\n")
        }
        t1 = AIMacro.Bool(OOP.ObjectIsInstance(dog, "Animal"))
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            PrintMessage("isinstance(dog, Animal): PASS")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("isinstance(dog, Animal): FAIL")
            PrintMessage("\n")
        }
        t2 = AIMacro.Bool(OOP.ObjectIsInstance(dog, "Cat"))
        IfCondition AIMacro.SmartBool(t2) ThenBlock: {
            PrintMessage("isinstance(dog, Cat): FAIL (should not be Cat)")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("isinstance(dog, Cat): PASS (correctly not Cat)")
            PrintMessage("\n")
        }
        t3 = AIMacro.Bool(OOP.ObjectIsInstance(cat, "Cat"))
        IfCondition AIMacro.SmartBool(t3) ThenBlock: {
            PrintMessage("isinstance(cat, Cat): PASS")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("isinstance(cat, Cat): FAIL")
            PrintMessage("\n")
        }
        t4 = AIMacro.Bool(OOP.ObjectIsInstance(cat, "Animal"))
        IfCondition AIMacro.SmartBool(t4) ThenBlock: {
            PrintMessage("isinstance(cat, Animal): PASS")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("isinstance(cat, Animal): FAIL")
            PrintMessage("\n")
        }
        PrintMessage("TEST 3 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.Counter___init__ {
    Input: self: Address
    Input: start: Address
    Output: Integer
    Body: {
        OOP.ObjectSet(self, "count", start)
        ReturnValue(1)
    }
}

Function.Counter_increment {
    Input: self: Address
    Output: Address
    Body: {
        t5 = OOP.ObjectGet(self, "count")
        t6 = AIMacro.NumAdd(t5, 1)
        OOP.ObjectSet(self, "count", t6)
        t7 = OOP.ObjectGet(self, "count")
        ReturnValue(t7)
    }
}

Function.Counter_decrement {
    Input: self: Address
    Output: Address
    Body: {
        t8 = OOP.ObjectGet(self, "count")
        t9 = AIMacro.NumSub(t8, 1)
        OOP.ObjectSet(self, "count", t9)
        t10 = OOP.ObjectGet(self, "count")
        ReturnValue(t10)
    }
}

Function.Counter_get {
    Input: self: Address
    Output: Address
    Body: {
        t11 = OOP.ObjectGet(self, "count")
        ReturnValue(t11)
    }
}

Function.Counter_reset {
    Input: self: Address
    Output: Address
    Body: {
        OOP.ObjectSet(self, "count", 0)
        t12 = OOP.ObjectGet(self, "count")
        ReturnValue(t12)
    }
}

Function.test_counter {
    Body: {
        PrintMessage("=== TEST 4: Counter (Stateful) ===")
        PrintMessage("\n")
        __oop_init_args_10 = Array.Create(1)
        Array.Push(__oop_init_args_10, 10)
        __oop_inst_11 = OOP.ObjectNewInit("Counter", __oop_init_args_10)
        Array.Destroy(__oop_init_args_10)
        c = __oop_inst_11
        PrintMessage("Initial count:")
        PrintMessage("\n")
        t1 = Array.Create(0)
        t0 = OOP.MethodCall(c, "get", t1)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("After increment:")
        PrintMessage("\n")
        t3 = Array.Create(0)
        t2 = OOP.MethodCall(c, "increment", t3)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        PrintMessage("After increment:")
        PrintMessage("\n")
        t5 = Array.Create(0)
        t4 = OOP.MethodCall(c, "increment", t5)
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        PrintMessage("After increment:")
        PrintMessage("\n")
        t7 = Array.Create(0)
        t6 = OOP.MethodCall(c, "increment", t7)
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        PrintMessage("After decrement:")
        PrintMessage("\n")
        t9 = Array.Create(0)
        t8 = OOP.MethodCall(c, "decrement", t9)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        PrintMessage("Current count:")
        PrintMessage("\n")
        t11 = Array.Create(0)
        t10 = OOP.MethodCall(c, "get", t11)
        AIMacro.SmartPrint(t10)
        PrintMessage("\n")
        PrintMessage("After reset:")
        PrintMessage("\n")
        t13 = Array.Create(0)
        t12 = OOP.MethodCall(c, "reset", t13)
        AIMacro.SmartPrint(t12)
        PrintMessage("\n")
        PrintMessage("TEST 4 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.test_multiple_objects {
    Body: {
        PrintMessage("=== TEST 5: Multiple Objects ===")
        PrintMessage("\n")
        __oop_init_args_12 = Array.Create(2)
        Array.Push(__oop_init_args_12, 1)
        Array.Push(__oop_init_args_12, 2)
        __oop_inst_13 = OOP.ObjectNewInit("Point", __oop_init_args_12)
        Array.Destroy(__oop_init_args_12)
        p1 = __oop_inst_13
        __oop_init_args_14 = Array.Create(2)
        Array.Push(__oop_init_args_14, 3)
        Array.Push(__oop_init_args_14, 4)
        __oop_inst_15 = OOP.ObjectNewInit("Point", __oop_init_args_14)
        Array.Destroy(__oop_init_args_14)
        p2 = __oop_inst_15
        __oop_init_args_16 = Array.Create(2)
        Array.Push(__oop_init_args_16, 5)
        Array.Push(__oop_init_args_16, 6)
        __oop_inst_17 = OOP.ObjectNewInit("Point", __oop_init_args_16)
        Array.Destroy(__oop_init_args_16)
        p3 = __oop_inst_17
        PrintMessage("p1.x:")
        PrintMessage("\n")
        AIMacro.SmartPrint(OOP.ObjectGet(p1, "x"))
        PrintMessage("\n")
        PrintMessage("p2.x:")
        PrintMessage("\n")
        AIMacro.SmartPrint(OOP.ObjectGet(p2, "x"))
        PrintMessage("\n")
        PrintMessage("p3.x:")
        PrintMessage("\n")
        AIMacro.SmartPrint(OOP.ObjectGet(p3, "x"))
        PrintMessage("\n")
        OOP.ObjectSet(p2, "x", 100)
        PrintMessage("After p2.x = 100:")
        PrintMessage("\n")
        PrintMessage("p1.x (should be 1):")
        PrintMessage("\n")
        AIMacro.SmartPrint(OOP.ObjectGet(p1, "x"))
        PrintMessage("\n")
        PrintMessage("p2.x (should be 100):")
        PrintMessage("\n")
        AIMacro.SmartPrint(OOP.ObjectGet(p2, "x"))
        PrintMessage("\n")
        PrintMessage("p3.x (should be 5):")
        PrintMessage("\n")
        AIMacro.SmartPrint(OOP.ObjectGet(p3, "x"))
        PrintMessage("\n")
        PrintMessage("TEST 5 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

