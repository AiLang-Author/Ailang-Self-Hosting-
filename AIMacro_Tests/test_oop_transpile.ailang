LibraryImport.OOP


Function.Point___init__ {
    Input: self: Address
    Input: x: Address
    Input: y: Address
    Output: Integer
    Body: {
        OOP.ObjectSet(self, "x", x)
        OOP.ObjectSet(self, "y", y)
        ReturnValue(1)
    }
}

Function.Point_get_x {
    Input: self: Address
    Output: Address
    Body: {
        t0 = OOP.ObjectGet(self, "x")
        ReturnValue(t0)
    }
}

Function.Point_get_y {
    Input: self: Address
    Output: Address
    Body: {
        t1 = OOP.ObjectGet(self, "y")
        ReturnValue(t1)
    }
}

Function.Point_magnitude_squared {
    Input: self: Address
    Output: Address
    Body: {
        t2 = OOP.ObjectGet(self, "x")
        t3 = OOP.ObjectGet(self, "x")
        t4 = AIMacro.NumMul(t2, t3)
        t5 = OOP.ObjectGet(self, "y")
        t6 = OOP.ObjectGet(self, "y")
        t7 = AIMacro.NumMul(t5, t6)
        t8 = AIMacro.NumAdd(t4, t7)
        ReturnValue(t8)
    }
}

Function.test_point {
    Body: {
        PrintMessage("=== TEST 1: Simple Point Class ===")
        PrintMessage("\n")
        __oop_init_args_0 = Array.Create(2)
        Array.Push(__oop_init_args_0, 3)
        Array.Push(__oop_init_args_0, 4)
        __oop_inst_1 = OOP.ObjectNewInit("Point", __oop_init_args_0)
        Array.Destroy(__oop_init_args_0)
        p = __oop_inst_1
        PrintMessage("p.x:")
        PrintMessage("\n")
        AIMacro.SmartPrint(OOP.ObjectGet(p, "x"))
        PrintMessage("\n")
        PrintMessage("p.y:")
        PrintMessage("\n")
        AIMacro.SmartPrint(OOP.ObjectGet(p, "y"))
        PrintMessage("\n")
        PrintMessage("p.get_x():")
        PrintMessage("\n")
        t1 = Array.Create(0)
        t0 = OOP.MethodCall(p, "get_x", t1)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("p.magnitude_squared():")
        PrintMessage("\n")
        t3 = Array.Create(0)
        t2 = OOP.MethodCall(p, "magnitude_squared", t3)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        PrintMessage("TEST 1 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

