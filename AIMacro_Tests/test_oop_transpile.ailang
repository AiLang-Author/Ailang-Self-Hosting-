}

Function.test_flexible {
    Body: {
        PrintMessage("=== TEST 8: Dynamic Attributes ===")
        PrintMessage("\n")
        __oop_init_args_22 = Array.Create(0)
        __oop_inst_23 = OOP.ObjectNewInit("Flexible", __oop_init_args_22)
        Array.Destroy(__oop_init_args_22)
        f = __oop_inst_23
        PrintMessage("Initial x:")
        PrintMessage("\n")
        AIMacro.SmartPrint(OOP.ObjectGet(f, "x"))
        PrintMessage("\n")
        PrintMessage("After set_values(10, 20):")
        PrintMessage("\n")
        __oop_args_24 = Array.Create(2)
        Array.Push(__oop_args_24, 10)
        Array.Push(__oop_args_24, 20)
        result = OOP.MethodCall(f, "set_values", __oop_args_24)
        Array.Destroy(__oop_args_24)
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        PrintMessage("f.x:")
        PrintMessage("\n")
        AIMacro.SmartPrint(OOP.ObjectGet(f, "x"))
        PrintMessage("\n")
        PrintMessage("f.y:")
        PrintMessage("\n")
        AIMacro.SmartPrint(OOP.ObjectGet(f, "y"))
        PrintMessage("\n")
        PrintMessage("TEST 8 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

Function.main {
    Body: {
        PrintMessage("######################################")
        PrintMessage("\n")
        PrintMessage("# OOP TRANSPILATION TEST SUITE      #")
        PrintMessage("\n")
        PrintMessage("######################################")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        test_point()
        test_inheritance()
        test_isinstance()
        test_counter()
        test_multiple_objects()
        test_empty_class()
        test_calculator()
        test_flexible()
        PrintMessage("######################################")
        PrintMessage("\n")
        PrintMessage("# ALL OOP TESTS COMPLETE            #")
        PrintMessage("\n")
        PrintMessage("######################################")
        PrintMessage("\n")
    }
}

Function.__OOP_ClassInit {
    Output: Integer
    Body: {
        OOP.ClassDefine("Point", 0)
        OOP.ClassField("Point", "x", "Address")
        OOP.ClassField("Point", "y", "Address")
        OOP.ClassMethod("Point", "__init__", AddressOf(Point___init__))
        OOP.ClassMethod("Point", "get_x", AddressOf(Point_get_x))
        OOP.ClassMethod("Point", "get_y", AddressOf(Point_get_y))
        OOP.ClassMethod("Point", "magnitude_squared", AddressOf(Point_magnitude_squared))
    
        OOP.ClassDefine("Animal", 0)
        OOP.ClassField("Animal", "name", "Address")
        OOP.ClassField("Animal", "age", "Address")
        OOP.ClassMethod("Animal", "__init__", AddressOf(Animal___init__))
        OOP.ClassMethod("Animal", "speak", AddressOf(Animal_speak))
        OOP.ClassMethod("Animal", "get_age", AddressOf(Animal_get_age))
        OOP.ClassMethod("Animal", "birthday", AddressOf(Animal_birthday))
    
        OOP.ClassDefine("Dog", "Animal")
        OOP.ClassField("Dog", "name", "Address")
        OOP.ClassField("Dog", "age", "Address")
        OOP.ClassField("Dog", "breed", "Address")
        OOP.ClassMethod("Dog", "__init__", AddressOf(Dog___init__))
        OOP.ClassMethod("Dog", "speak", AddressOf(Dog_speak))
        OOP.ClassMethod("Dog", "get_breed", AddressOf(Dog_get_breed))
    
        OOP.ClassDefine("Cat", "Animal")
        OOP.ClassMethod("Cat", "speak", AddressOf(Cat_speak))
    
        OOP.ClassDefine("Counter", 0)
        OOP.ClassField("Counter", "count", "Address")
        OOP.ClassMethod("Counter", "__init__", AddressOf(Counter___init__))
        OOP.ClassMethod("Counter", "increment", AddressOf(Counter_increment))
        OOP.ClassMethod("Counter", "decrement", AddressOf(Counter_decrement))
        OOP.ClassMethod("Counter", "get", AddressOf(Counter_get))
        OOP.ClassMethod("Counter", "reset", AddressOf(Counter_reset))
    
        OOP.ClassDefine("Empty", 0)
    
        OOP.ClassDefine("Calculator", 0)
        OOP.ClassField("Calculator", "value", "Address")
        OOP.ClassMethod("Calculator", "__init__", AddressOf(Calculator___init__))
        OOP.ClassMethod("Calculator", "add", AddressOf(Calculator_add))
        OOP.ClassMethod("Calculator", "multiply", AddressOf(Calculator_multiply))
        OOP.ClassMethod("Calculator", "add_two", AddressOf(Calculator_add_two))
        OOP.ClassMethod("Calculator", "get", AddressOf(Calculator_get))
    
        OOP.ClassDefine("Flexible", 0)
        OOP.ClassField("Flexible", "x", "Integer")
        OOP.ClassMethod("Flexible", "__init__", AddressOf(Flexible___init__))
