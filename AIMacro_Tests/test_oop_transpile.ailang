Function.Calculator___init__ {
    Input: self: Address
    Input: initial: Address
    Output: Integer
    Body: {
        OOP.ObjectSet(self, "value", initial)
        ReturnValue(1)
    }
}

Function.Calculator_add {
    Input: self: Address
    Input: x: Address
    Output: Address
    Body: {
        t1 = OOP.ObjectGet(self, "value")
        t2 = AIMacro.NumAdd(t1, x)
        OOP.ObjectSet(self, "value", t2)
        t3 = OOP.ObjectGet(self, "value")
        ReturnValue(t3)
    }
}

Function.Calculator_multiply {
    Input: self: Address
    Input: x: Address
    Output: Address
    Body: {
        t4 = OOP.ObjectGet(self, "value")
        t5 = AIMacro.NumMul(t4, x)
        OOP.ObjectSet(self, "value", t5)
        t6 = OOP.ObjectGet(self, "value")
        ReturnValue(t6)
    }
}

Function.Calculator_add_two {
    Input: self: Address
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        t7 = OOP.ObjectGet(self, "value")
        t8 = AIMacro.NumAdd(t7, a)
        t9 = AIMacro.NumAdd(t8, b)
        OOP.ObjectSet(self, "value", t9)
        t10 = OOP.ObjectGet(self, "value")
        ReturnValue(t10)
    }
}

Function.Calculator_get {
    Input: self: Address
    Output: Address
    Body: {
        t11 = OOP.ObjectGet(self, "value")
        ReturnValue(t11)
    }
}

Function.test_calculator {
    Body: {
        PrintMessage("=== TEST 7: Calculator (Multi-param Methods) ===")
        PrintMessage("\n")
        __oop_init_args_20 = Array.Create(1)
        Array.Push(__oop_init_args_20, 10)
        __oop_inst_21 = OOP.ObjectNewInit("Calculator", __oop_init_args_20)
        Array.Destroy(__oop_init_args_20)
        calc = __oop_inst_21
        PrintMessage("Initial value:")
        PrintMessage("\n")
        t1 = Array.Create(0)
        t0 = OOP.MethodCall(calc, "get", t1)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("After add(5):")
        PrintMessage("\n")
        t3 = Array.Create(1)
        Array.Push(t3, 5)
        t2 = OOP.MethodCall(calc, "add", t3)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        PrintMessage("After multiply(2):")
        PrintMessage("\n")
        t5 = Array.Create(1)
        Array.Push(t5, 2)
        t4 = OOP.MethodCall(calc, "multiply", t5)
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        PrintMessage("After add_two(3, 7):")
        PrintMessage("\n")
        t7 = Array.Create(2)
        Array.Push(t7, 3)
        Array.Push(t7, 7)
        t6 = OOP.MethodCall(calc, "add_two", t7)
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        PrintMessage("TEST 7 PASSED")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
    }
}

