LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        PrintMessage("=== QUICK WINS TESTS ===")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 1: pass statement")
        PrintMessage("\n")
        x = 5
        IfCondition AIMacro.SmartBool(AIMacro.NumGt(x, 10)) ThenBlock: {
        } ElseBlock: {
            PrintMessage("  pass in if-else works!")
            PrintMessage("\n")
        }
        PrintMessage("TEST 2: None")
        PrintMessage("\n")
        y = Types.GetNone()
        t0 = AIMacro.NumEq(y, Types.GetNone())
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            PrintMessage("  y is None: True")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("  y is None: False")
            PrintMessage("\n")
        }
        PrintMessage("TEST 3: Floor division //")
        PrintMessage("\n")
        a = 17
        b = 5
        result = AIMacro.FloorDiv(a, b)
        PrintMessage("  17 // 5 =")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        PrintMessage("TEST 4: Power operator **")
        PrintMessage("\n")
        base = 2
        exp = 10
        result = AIMacro.NumPow(base, exp)
        PrintMessage("  2 ** 10 =")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        PrintMessage("TEST 5: ord()")
        PrintMessage("\n")
        c = "A"
        t1 = AIMacro.Ord(c)
        code = t1
        PrintMessage("  ord('A') =")
        PrintMessage(" ")
        AIMacro.SmartPrint(code)
        PrintMessage("\n")
        c2 = "a"
        t2 = AIMacro.Ord(c2)
        code2 = t2
        PrintMessage("  ord('a') =")
        PrintMessage(" ")
        AIMacro.SmartPrint(code2)
        PrintMessage("\n")
        PrintMessage("TEST 6: chr()")
        PrintMessage("\n")
        n = 65
        ch = AIMacro.Chr(n)
        PrintMessage("  chr(65) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(ch)
        PrintMessage("\n")
        n2 = 97
        ch2 = AIMacro.Chr(n2)
        PrintMessage("  chr(97) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(ch2)
        PrintMessage("\n")
        PrintMessage("TEST 7: sum()")
        PrintMessage("\n")
        nums = Array.Create(5)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        Array.Push(nums, 3)
        Array.Push(nums, 4)
        Array.Push(nums, 5)
        t3 = AIMacro.SmartSum(nums)
        total = t3
        PrintMessage("  sum([1,2,3,4,5]) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(total)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== ALL QUICK WINS TESTS COMPLETE ===")
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
