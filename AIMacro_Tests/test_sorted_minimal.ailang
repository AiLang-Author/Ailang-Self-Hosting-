LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        PrintMessage("Step 1: Create array")
        PrintMessage("\n")
        arr = Array.Create(6)
        Array.Push(arr, 5)
        Array.Push(arr, 2)
        Array.Push(arr, 8)
        Array.Push(arr, 1)
        Array.Push(arr, 9)
        Array.Push(arr, 3)
        PrintMessage("Step 2: Print array size")
        PrintMessage("\n")
        t0 = AIMacro.SmartLen(arr)
        PrintMessage("Size:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        PrintMessage("Step 3: Print array contents")
        PrintMessage("\n")
        iter1 = arr
        iterlen1 = AIMacro.IterLen(iter1)
        iteri1 = 0
        WhileLoop LessThan(iteri1, iterlen1) {
            x = AIMacro.IterGet(iter1, iteri1)
            AIMacro.SmartPrint(x)
            PrintMessage("\n")
            iteri1 = Add(iteri1, 1)
        }
        PrintMessage("Step 4: Call sorted()")
        PrintMessage("\n")
        t2 = AIMacro.TypedSorted(arr)
        result = t2
        PrintMessage("Step 5: Print result size")
        PrintMessage("\n")
        t3 = DictGen_SmartLen(result)
        PrintMessage("Result size:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        PrintMessage("Step 6: Print result contents")
        PrintMessage("\n")
        iter4 = result
        iterlen4 = AIMacro.IterLen(iter4)
        iteri4 = 0
        WhileLoop LessThan(iteri4, iterlen4) {
            x = AIMacro.IterGet(iter4, iteri4)
            AIMacro.SmartPrint(x)
            PrintMessage("\n")
            iteri4 = Add(iteri4, 1)
        }
        PrintMessage("Done!")
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
