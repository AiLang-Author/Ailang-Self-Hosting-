LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        PrintMessage("=== STRING METHOD TESTS ===")
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("TEST 1: upper()")
        PrintMessage("\n")
        s1 = "hello world"
        result = String.Upper(s1)
        PrintMessage("  'hello world'.upper() =")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        PrintMessage("TEST 2: lower()")
        PrintMessage("\n")
        s2 = "HELLO WORLD"
        result = String.Lower(s2)
        PrintMessage("  'HELLO WORLD'.lower() =")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        PrintMessage("TEST 3: strip()")
        PrintMessage("\n")
        s3 = "  padded  "
        result = String.Strip(s3)
        PrintMessage("  '  padded  '.strip() = [")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage(" ")
        PrintMessage("]")
        PrintMessage("\n")
        PrintMessage("TEST 4: lstrip()")
        PrintMessage("\n")
        s4 = "  left padded"
        result = String.LStrip(s4)
        PrintMessage("  '  left padded'.lstrip() = [")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage(" ")
        PrintMessage("]")
        PrintMessage("\n")
        PrintMessage("TEST 5: rstrip()")
        PrintMessage("\n")
        s5 = "right padded  "
        result = String.RStrip(s5)
        PrintMessage("  'right padded  '.rstrip() = [")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage(" ")
        PrintMessage("]")
        PrintMessage("\n")
        PrintMessage("TEST 6: split()")
        PrintMessage("\n")
        s6 = "one,two,three"
        parts = String.Split(s6, ",")
        PrintMessage("  'one,two,three'.split(',') =")
        PrintMessage("\n")
        i = 0
        t0 = DictGen_SmartLen(parts)
        count = t0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(i, count)) {
            t1 = DictGen_SmartGet(parts, i)
            PrintMessage("    [")
            PrintMessage(" ")
            AIMacro.SmartPrint(i)
            PrintMessage(" ")
            PrintMessage("]:")
            PrintMessage(" ")
            AIMacro.SmartPrint(t1)
            PrintMessage("\n")
            i = AIMacro.NumAdd(i, 1)
        }
        PrintMessage("TEST 7: join()")
        PrintMessage("\n")
        words = Array.Create(3)
        Array.Push(words, "a")
        Array.Push(words, "b")
        Array.Push(words, "c")
        sep = "-"
        result = String.Join(sep, words)
        PrintMessage("  '-'.join(['a','b','c']) =")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        PrintMessage("TEST 8: replace()")
        PrintMessage("\n")
        s8 = "hello world"
        result = String.Replace(s8, "world", "there")
        PrintMessage("  'hello world'.replace('world','there') =")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        PrintMessage("TEST 9: find()")
        PrintMessage("\n")
        s9 = "hello world"
        pos = String.Find(s9, "world")
        PrintMessage("  'hello world'.find('world') =")
        PrintMessage(" ")
        AIMacro.SmartPrint(pos)
        PrintMessage("\n")
        pos2 = String.Find(s9, "xyz")
        PrintMessage("  'hello world'.find('xyz') =")
        PrintMessage(" ")
        AIMacro.SmartPrint(pos2)
        PrintMessage("\n")
        PrintMessage("TEST 10: startswith()")
        PrintMessage("\n")
        s10 = "hello world"
        r1 = String.StartsWith(s10, "hello")
        r2 = String.StartsWith(s10, "world")
        PrintMessage("  'hello world'.startswith('hello') =")
        PrintMessage(" ")
        AIMacro.SmartPrint(r1)
        PrintMessage("\n")
        PrintMessage("  'hello world'.startswith('world') =")
        PrintMessage(" ")
        AIMacro.SmartPrint(r2)
        PrintMessage("\n")
        PrintMessage("TEST 11: endswith()")
        PrintMessage("\n")
        s11 = "hello world"
        r1 = String.EndsWith(s11, "world")
        r2 = String.EndsWith(s11, "hello")
        PrintMessage("  'hello world'.endswith('world') =")
        PrintMessage(" ")
        AIMacro.SmartPrint(r1)
        PrintMessage("\n")
        PrintMessage("  'hello world'.endswith('hello') =")
        PrintMessage(" ")
        AIMacro.SmartPrint(r2)
        PrintMessage("\n")
        PrintMessage("TEST 12: count()")
        PrintMessage("\n")
        s12 = "abracadabra"
        c = String.Count(s12, "a")
        PrintMessage("  'abracadabra'.count('a') =")
        PrintMessage(" ")
        AIMacro.SmartPrint(c)
        PrintMessage("\n")
        PrintMessage("TEST 13: isdigit()")
        PrintMessage("\n")
        d1 = "12345"
        d2 = "123a5"
        __oop_args_0 = Array.Create(0)
        r1 = OOP.MethodCall(d1, "isdigit", __oop_args_0)
        Array.Destroy(__oop_args_0)
        __oop_args_1 = Array.Create(0)
        r2 = OOP.MethodCall(d2, "isdigit", __oop_args_1)
        Array.Destroy(__oop_args_1)
        PrintMessage("  '12345'.isdigit() =")
        PrintMessage(" ")
        AIMacro.SmartPrint(r1)
        PrintMessage("\n")
        PrintMessage("  '123a5'.isdigit() =")
        PrintMessage(" ")
        AIMacro.SmartPrint(r2)
        PrintMessage("\n")
        PrintMessage("TEST 14: isalpha()")
        PrintMessage("\n")
        a1 = "hello"
        a2 = "hello1"
        __oop_args_2 = Array.Create(0)
        r1 = OOP.MethodCall(a1, "isalpha", __oop_args_2)
        Array.Destroy(__oop_args_2)
        __oop_args_3 = Array.Create(0)
        r2 = OOP.MethodCall(a2, "isalpha", __oop_args_3)
        Array.Destroy(__oop_args_3)
        PrintMessage("  'hello'.isalpha() =")
        PrintMessage(" ")
        AIMacro.SmartPrint(r1)
        PrintMessage("\n")
        PrintMessage("  'hello1'.isalpha() =")
        PrintMessage(" ")
        AIMacro.SmartPrint(r2)
        PrintMessage("\n")
        PrintMessage("TEST 15: isalnum()")
        PrintMessage("\n")
        an1 = "hello123"
        an2 = "hello 123"
        __oop_args_4 = Array.Create(0)
        r1 = OOP.MethodCall(an1, "isalnum", __oop_args_4)
        Array.Destroy(__oop_args_4)
        __oop_args_5 = Array.Create(0)
        r2 = OOP.MethodCall(an2, "isalnum", __oop_args_5)
        Array.Destroy(__oop_args_5)
        PrintMessage("  'hello123'.isalnum() =")
        PrintMessage(" ")
        AIMacro.SmartPrint(r1)
        PrintMessage("\n")
        PrintMessage("  'hello 123'.isalnum() =")
        PrintMessage(" ")
        AIMacro.SmartPrint(r2)
        PrintMessage("\n")
        PrintMessage("")
        PrintMessage("\n")
        PrintMessage("=== ALL STRING METHOD TESTS COMPLETE ===")
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
