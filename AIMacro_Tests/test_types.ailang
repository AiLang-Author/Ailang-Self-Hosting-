LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.test_isinstance_list {
    Body: {
        PrintMessage("=== isinstance(x, list) tests ===")
        PrintMessage("\n")
        nums = Array.Create(5)
        Array.Push(nums, 1)
        Array.Push(nums, 2)
        Array.Push(nums, 3)
        Array.Push(nums, 4)
        Array.Push(nums, 5)
        t0 = AIMacro.IsInstance(nums, TypeID.LIST)
        result = t0
        PrintMessage("isinstance([1,2,3,4,5], list):")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        t1 = AIMacro.NumEq(result, 1)
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            PrintMessage("PASS: List detected correctly")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: List not detected")
            PrintMessage("\n")
        }
        x = 42
        t2 = AIMacro.IsInstance(x, TypeID.INT)
        result2 = t2
        PrintMessage("isinstance(42, int):")
        PrintMessage(" ")
        AIMacro.SmartPrint(result2)
        PrintMessage("\n")
        s = "hello"
        t3 = AIMacro.IsInstance(s, TypeID.STR)
        result3 = t3
        PrintMessage("isinstance('hello', str):")
        PrintMessage(" ")
        AIMacro.SmartPrint(result3)
        PrintMessage("\n")
        ReturnValue(result)
    }
}

Function.test_sorted_returns_list {
    Body: {
        PrintMessage("\n=== sorted() type test ===")
        PrintMessage("\n")
        original = Array.Create(5)
        Array.Push(original, 5)
        Array.Push(original, 2)
        Array.Push(original, 8)
        Array.Push(original, 1)
        Array.Push(original, 9)
        t0 = AIMacro.TypedSorted(original)
        sorted_list = t0
        t1 = AIMacro.IsInstance(sorted_list, TypeID.LIST)
        result = t1
        PrintMessage("isinstance(sorted([...]), list):")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        t2 = AIMacro.NumEq(result, 1)
        IfCondition AIMacro.SmartBool(t2) ThenBlock: {
            PrintMessage("PASS: sorted() returns typed list")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: sorted() result not recognized as list")
            PrintMessage("\n")
        }
        t3 = DictGen_SmartGet(sorted_list, 0)
        t4 = DictGen_SmartGet(sorted_list, 1)
        t5 = DictGen_SmartGet(sorted_list, 2)
        PrintMessage("Sorted:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t3)
        PrintMessage(" ")
        AIMacro.SmartPrint(t4)
        PrintMessage(" ")
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        ReturnValue(result)
    }
}

Function.test_list_operations {
    Body: {
        PrintMessage("\n=== List operations on TArray ===")
        PrintMessage("\n")
        items = Array.Create(3)
        Array.Push(items, 10)
        Array.Push(items, 20)
        Array.Push(items, 30)
        t0 = AIMacro.SmartLen(items)
        l = t0
        PrintMessage("len([10,20,30]):")
        PrintMessage(" ")
        AIMacro.SmartPrint(l)
        PrintMessage("\n")
        AIMacro.SmartPush(items, 40)
        t1 = AIMacro.SmartLen(items)
        PrintMessage("After append(40), len:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = DictGen_SmartGet(items, 2)
        val = t2
        PrintMessage("items[2]:")
        PrintMessage(" ")
        AIMacro.SmartPrint(val)
        PrintMessage("\n")
        t3 = AIMacro.SmartSize(items)
        t4 = Subtract(t3, 1)
        t5 = DictGen_SmartGet(items, t4)
        last = t5
        PrintMessage("items[-1]:")
        PrintMessage(" ")
        AIMacro.SmartPrint(last)
        PrintMessage("\n")
        DictGen_SmartSet(items, 0, 100)
        t6 = DictGen_SmartGet(items, 0)
        PrintMessage("After items[0]=100:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        popped = AIMacro.SmartPop(items)
        t7 = AIMacro.SmartLen(items)
        PrintMessage("pop():")
        PrintMessage(" ")
        AIMacro.SmartPrint(popped)
        PrintMessage(" ")
        PrintMessage("new len:")
        PrintMessage(" ")
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.test_reversed_type {
    Body: {
        PrintMessage("\n=== reversed() type test ===")
        PrintMessage("\n")
        original = Array.Create(3)
        Array.Push(original, 1)
        Array.Push(original, 2)
        Array.Push(original, 3)
        t0 = AIMacro.TypedReversed(original)
        rev = t0
        t1 = AIMacro.IsInstance(rev, TypeID.LIST)
        result = t1
        PrintMessage("isinstance(reversed([...]), list):")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        t2 = AIMacro.NumEq(result, 1)
        IfCondition AIMacro.SmartBool(t2) ThenBlock: {
            PrintMessage("PASS: reversed() returns typed list")
            PrintMessage("\n")
            t3 = DictGen_SmartGet(rev, 0)
            t4 = DictGen_SmartGet(rev, 1)
            t5 = DictGen_SmartGet(rev, 2)
            PrintMessage("Reversed:")
            PrintMessage(" ")
            AIMacro.SmartPrint(t3)
            PrintMessage(" ")
            AIMacro.SmartPrint(t4)
            PrintMessage(" ")
            AIMacro.SmartPrint(t5)
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: reversed() result not recognized as list")
            PrintMessage("\n")
        }
        ReturnValue(result)
    }
}

Function.test_copy_type {
    Body: {
        PrintMessage("\n=== copy() type test ===")
        PrintMessage("\n")
        original = Array.Create(3)
        Array.Push(original, 7)
        Array.Push(original, 8)
        Array.Push(original, 9)
        copied = AIMacro.TypedListCopy(original)
        t0 = AIMacro.IsInstance(copied, TypeID.LIST)
        result = t0
        PrintMessage("isinstance(copy(), list):")
        PrintMessage(" ")
        AIMacro.SmartPrint(result)
        PrintMessage("\n")
        t1 = AIMacro.NumEq(result, 1)
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            PrintMessage("PASS: copy() returns typed list")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: copy() result not recognized as list")
            PrintMessage("\n")
        }
        ReturnValue(result)
    }
}

Function.test_mixed_types {
    Body: {
        PrintMessage("\n=== Mixed type tests ===")
        PrintMessage("\n")
        my_list = Array.Create(3)
        Array.Push(my_list, 1)
        Array.Push(my_list, 2)
        Array.Push(my_list, 3)
        my_str = "hello"
        my_int = 42
        t0 = AIMacro.IsInstance(my_list, TypeID.LIST)
        is_list = t0
        t1 = AIMacro.IsInstance(my_str, TypeID.STR)
        is_str = t1
        t2 = AIMacro.IsInstance(my_int, TypeID.INT)
        is_int = t2
        PrintMessage("List check:")
        PrintMessage(" ")
        AIMacro.SmartPrint(is_list)
        PrintMessage("\n")
        PrintMessage("String check:")
        PrintMessage(" ")
        AIMacro.SmartPrint(is_str)
        PrintMessage("\n")
        PrintMessage("Integer check:")
        PrintMessage(" ")
        AIMacro.SmartPrint(is_int)
        PrintMessage("\n")
        total = AIMacro.NumAdd(AIMacro.NumAdd(is_list, is_str), is_int)
        t3 = AIMacro.NumEq(total, 3)
        IfCondition AIMacro.SmartBool(t3) ThenBlock: {
            PrintMessage("PASS: All type checks correct")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("FAIL: Some type checks incorrect")
            PrintMessage("\n")
        }
        ReturnValue(total)
    }
}

Function.main {
    Body: {
        PrintMessage("TYPE SYSTEM INTEGRATION TESTS")
        PrintMessage("\n")
        PrintMessage("==============================\n")
        PrintMessage("\n")
        passed = 0
        total = 0
        total = AIMacro.NumAdd(total, 1)
        t0 = test_isinstance_list()
        t1 = AIMacro.NumEq(t0, 1)
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            passed = AIMacro.NumAdd(passed, 1)
        }
        total = AIMacro.NumAdd(total, 1)
        t2 = test_sorted_returns_list()
        t3 = AIMacro.NumEq(t2, 1)
        IfCondition AIMacro.SmartBool(t3) ThenBlock: {
            passed = AIMacro.NumAdd(passed, 1)
        }
        total = AIMacro.NumAdd(total, 1)
        t4 = test_list_operations()
        t5 = AIMacro.NumEq(t4, 1)
        IfCondition AIMacro.SmartBool(t5) ThenBlock: {
            passed = AIMacro.NumAdd(passed, 1)
        }
        total = AIMacro.NumAdd(total, 1)
        t6 = test_reversed_type()
        t7 = AIMacro.NumEq(t6, 1)
        IfCondition AIMacro.SmartBool(t7) ThenBlock: {
            passed = AIMacro.NumAdd(passed, 1)
        }
        total = AIMacro.NumAdd(total, 1)
        t8 = test_copy_type()
        t9 = AIMacro.NumEq(t8, 1)
        IfCondition AIMacro.SmartBool(t9) ThenBlock: {
            passed = AIMacro.NumAdd(passed, 1)
        }
        total = AIMacro.NumAdd(total, 1)
        t10 = test_mixed_types()
        t11 = AIMacro.NumEq(t10, 3)
        IfCondition AIMacro.SmartBool(t11) ThenBlock: {
            passed = AIMacro.NumAdd(passed, 1)
        }
        PrintMessage("\n==============================")
        PrintMessage("\n")
        PrintMessage("RESULTS:")
        PrintMessage(" ")
        AIMacro.SmartPrint(passed)
        PrintMessage(" ")
        PrintMessage("/")
        PrintMessage(" ")
        AIMacro.SmartPrint(total)
        PrintMessage(" ")
        PrintMessage("tests passed")
        PrintMessage("\n")
        t12 = AIMacro.NumEq(passed, total)
        IfCondition AIMacro.SmartBool(t12) ThenBlock: {
            PrintMessage("ALL TESTS PASSED!")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("SOME TESTS FAILED")
            PrintMessage("\n")
        }
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
