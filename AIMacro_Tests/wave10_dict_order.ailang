LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        d = Hash.Create(16)
        Hash.Set(d, "z", 1)
        Hash.Set(d, "a", 2)
        AIMacro.SmartPrint(d)
        PrintMessage("\n")
        Hash.Set(d, "m", 3)
        AIMacro.SmartPrint(d)
        PrintMessage("\n")
        ks = Hash.Keys(d)
        t0 = DictGen_SmartGet(ks, 0)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = DictGen_SmartGet(ks, 1)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = DictGen_SmartGet(ks, 2)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        e = Hash.Create(16)
        Hash.Set(e, "first", 10)
        Hash.Set(e, "second", 20)
        AIMacro.SmartPrint(e)
        PrintMessage("\n")
        t3 = Hash.Create(16)
        Hash.Set(t3, "z", 1)
        Hash.Set(t3, "a", 2)
        t4 = AIMacro.JsonDumps(t3)
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        del_d = Hash.Create(16)
        Hash.Set(del_d, "x", 1)
        Hash.Set(del_d, "y", 2)
        Hash.Set(del_d, "z", 3)
        DictGen_Pop(del_d, "y")
        AIMacro.SmartPrint(del_d)
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
