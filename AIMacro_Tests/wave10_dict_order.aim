# Wave 10: dict insertion order for print/keys/json.dumps

import json

def main() {
    d = {"z": 1, "a": 2}
    print(d)
    d["m"] = 3
    print(d)
    ks = d.keys()
    print(ks[0])
    print(ks[1])
    print(ks[2])
    e = {}
    e["first"] = 10
    e["second"] = 20
    print(e)
    print(json.dumps({"z": 1, "a": 2}))
    del_d = {"x": 1, "y": 2, "z": 3}
    del_d.pop("y")
    print(del_d)
}
