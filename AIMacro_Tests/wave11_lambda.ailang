LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        t0 = AddressOf(__lam_0)
        f = t0
        t1 = CallIndirect(f, 3)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = AddressOf(__lam_1)
        t3 = CallIndirect(t2, 3, 4)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = AddressOf(__lam_2)
        t5 = CallIndirect(t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = AddressOf(__lam_3)
        g = t6
        t7 = CallIndirect(g, 5)
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        t8 = CallIndirect(f, 2)
        t9 = AIMacro.NumEq(t8, 3)
        IfCondition AIMacro.SmartBool(t9) ThenBlock: {
            PrintMessage("f ok")
            PrintMessage("\n")
        }
    }
}

Function.__lam_0 {
    Input: p_x: Integer
    Output: Integer
    Body: {
        t0 = AIMacro.NumAdd(p_x, 1)
        ReturnValue(t0)
    }
}

Function.__lam_1 {
    Input: p_a: Integer
    Input: p_b: Integer
    Output: Integer
    Body: {
        t0 = AIMacro.NumMul(p_a, p_b)
        ReturnValue(t0)
    }
}

Function.__lam_2 {
    Output: Integer
    Body: {
        ReturnValue(7)
    }
}

Function.__lam_3 {
    Input: p_n: Integer
    Output: Integer
    Body: {
        t0 = AIMacro.NumMul(p_n, p_n)
        ReturnValue(t0)
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
