Function.boom {
    Body: {
        PrintMessage("BOOM")
        PrintMessage("\n")
        ReturnValue(9)
    }
}

Function.main {
    Body: {
        t0 = 0
        IfCondition AIMacro.SmartBool(1) ThenBlock: {
            t0 = 1
        } ElseBlock: {
            t0 = 0
        }
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = 0
        IfCondition AIMacro.SmartBool(0) ThenBlock: {
            t1 = 1
        } ElseBlock: {
            t1 = 2
        }
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = 0
        IfCondition AIMacro.SmartBool(1) ThenBlock: {
            t2 = "a"
        } ElseBlock: {
            t2 = "b"
        }
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = 0
        IfCondition AIMacro.SmartBool(0) ThenBlock: {
            t3 = "a"
        } ElseBlock: {
            t3 = "b"
        }
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        x = 10
        t4 = AIMacro.NumGt(x, 5)
        t5 = 0
        IfCondition AIMacro.SmartBool(t4) ThenBlock: {
            t5 = "big"
        } ElseBlock: {
            t5 = "small"
        }
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = 0
        IfCondition AIMacro.SmartBool(1) ThenBlock: {
            t6 = 1
        } ElseBlock: {
            t7 = boom()
            t6 = t7
        }
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        t8 = 0
        IfCondition AIMacro.SmartBool(0) ThenBlock: {
            t8 = 2
        } ElseBlock: {
            t8 = 3
        }
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        t9 = 0
        IfCondition AIMacro.SmartBool(1) ThenBlock: {
            t9 = 1
        } ElseBlock: {
            t10 = 0
            IfCondition AIMacro.SmartBool(1) ThenBlock: {
                t10 = 0
            } ElseBlock: {
                t10 = 2
            }
            t9 = t10
        }
        AIMacro.SmartPrint(t9)
        PrintMessage("\n")
        n = Types.GetNone()
        t11 = 0
        IfCondition AIMacro.SmartBool(n) ThenBlock: {
            t11 = n
        } ElseBlock: {
            t11 = "d"
        }
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        t12 = AddressOf(__lam_0)
        f = t12
        t13 = CallIndirect(f, 1)
        AIMacro.SmartPrint(t13)
        PrintMessage("\n")
        t14 = CallIndirect(f, 0)
        AIMacro.SmartPrint(t14)
        PrintMessage("\n")
    }
}

Function.__lam_0 {
    Input: p_v: Integer
    Output: Integer
    Body: {
        t0 = 0
        IfCondition AIMacro.SmartBool(p_v) ThenBlock: {
            t0 = 1
        } ElseBlock: {
            t0 = 0
        }
        ReturnValue(t0)
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
