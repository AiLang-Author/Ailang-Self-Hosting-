LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        xs = Array.Create(3)
        Array.Push(xs, 3)
        Array.Push(xs, 1)
        Array.Push(xs, 2)
        t0 = AIMacro.TypedSorted(xs)
        ys = t0
        t1 = DictGen_SmartGet(ys, 0)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = DictGen_SmartGet(ys, 1)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = DictGen_SmartGet(ys, 2)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = AIMacro.TrueVal()
        t5 = AIMacro.TypedSortedKey(xs, 0, t4)
        zs = t5
        t6 = DictGen_SmartGet(zs, 0)
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        t7 = DictGen_SmartGet(zs, 2)
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        t8 = AddressOf(__lam_0)
        t9 = AIMacro.TypedSortedKey(xs, t8, 0)
        ks = t9
        t10 = DictGen_SmartGet(ks, 0)
        AIMacro.SmartPrint(t10)
        PrintMessage("\n")
        t11 = DictGen_SmartGet(ks, 2)
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        path = "/tmp/aimacro_wave13.txt"
        t12 = AIMacro.Open(path, "w")
        f = t12
        AIMacro.FileWrite(f, "kw")
        AIMacro.FileClose(f)
        t13 = AIMacro.Open(path, "r")
        g = t13
        t14 = AIMacro.FileRead(g)
        AIMacro.SmartPrint(t14)
        PrintMessage("\n")
        AIMacro.FileClose(g)
    }
}

Function.__lam_0 {
    Input: p_n: Integer
    Output: Integer
    Body: {
        t0 = AIMacro.NumSub(0, p_n)
        ReturnValue(t0)
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
