# Wave 13: keyword args — sorted(key=, reverse=), open(mode=)

def main() {
    xs = [3, 1, 2]
    ys = sorted(xs)
    print(ys[0])
    print(ys[1])
    print(ys[2])
    zs = sorted(xs, reverse=True)
    print(zs[0])
    print(zs[2])
    ks = sorted(xs, key=lambda n: 0 - n)
    print(ks[0])
    print(ks[2])

    path = "/tmp/aimacro_wave13.txt"
    f = open(path, mode="w")
    f.write("kw")
    f.close()
    g = open(path, mode="r")
    print(g.read())
    g.close()
}
