LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.f {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        t0 = AIMacro.NumMul(p_a, 10)
        t1 = AIMacro.NumAdd(t0, p_b)
        ReturnValue(t1)
    }
}

Function.g {
    Input: p_x: Integer
    Input: p_y: Integer
    Body: {
        t0 = AIMacro.NumAdd(p_x, p_y)
        ReturnValue(t0)
    }
}

Function.main {
    Body: {
        t0 = f(1, 2)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = f(1, 2)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = f(1, 2)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = f(1, 2)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = g(3, 5)
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        t5 = g(3, 5)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = g(3, 7)
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        t7 = g(3, 7)
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
