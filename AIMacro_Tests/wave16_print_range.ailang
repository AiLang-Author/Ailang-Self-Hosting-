LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        PrintNumber(1)
        PrintMessage(" ")
        PrintNumber(2)
        PrintMessage(" ")
        PrintNumber(3)
        PrintMessage("\n")
        PrintNumber(1)
        PrintMessage(",")
        PrintNumber(2)
        PrintMessage("\n")
        PrintMessage("a")
        PrintMessage("")
        PrintMessage("b")
        PrintMessage("\n")
        PrintNumber(1)
        PrintMessage("-")
        PrintNumber(2)
        PrintMessage("!\n")
        t0 = AIMacro.Range(0, 3, 1)
        t1 = AIMacro.ListFrom(t0)
        xs = t1
        AIMacro.SmartPrint(xs)
        PrintMessage("\n")
        t2 = AIMacro.Range(2, 6, 1)
        t3 = AIMacro.ListFrom(t2)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = AIMacro.NumNeg(1)
        t5 = AIMacro.Range(5, 0, t4)
        t6 = AIMacro.ListFrom(t5)
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        t7 = AIMacro.ListFrom("ab")
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        t8 = Array.Create(0)
        t9 = DictGen_SmartLen(t8)
        AIMacro.SmartPrint(t9)
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
