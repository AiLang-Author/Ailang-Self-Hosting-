# Wave 16: print(sep=, end=), range() values, list()

def main() {
    print(1, 2, 3)
    print(1, 2, sep=",")
    print("a", end="")
    print("b")
    print(1, 2, sep="-", end="!\n")
    xs = list(range(3))
    print(xs)
    print(list(range(2, 6)))
    print(list(range(5, 0, -1)))
    print(list("ab"))
    print(len(list()))
}
