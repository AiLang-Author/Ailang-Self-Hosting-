LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        path = "/tmp/aimacro_wave1.txt"
        t0 = AIMacro.Open(path, "w")
        f = t0
        AIMacro.FileWrite(f, "hello wave1")
        AIMacro.FileClose(f)
        t1 = AIMacro.Open(path, "r")
        g = t1
        s = AIMacro.FileRead(g)
        AIMacro.FileClose(g)
        AIMacro.SmartPrint(s)
        PrintMessage("\n")
        IfCondition AIMacro.SmartBool(EqualTo(StringCompare(s, "hello wave1"), 0)) ThenBlock: {
            PrintMessage("file roundtrip")
            PrintMessage("\n")
        }
        t2 = AIMacro.Argv()
        args = t2
        t3 = DictGen_SmartLen(args)
        PrintMessage("argc")
        PrintMessage(" ")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = DictGen_SmartLen(args)
        t5 = AIMacro.NumGt(t4, 0)
        IfCondition AIMacro.SmartBool(t5) ThenBlock: {
            PrintMessage("argv0 ok")
            PrintMessage("\n")
        }
        t6 = AIMacro.Argv()
        args2 = t6
        t7 = DictGen_SmartLen(args2)
        t8 = DictGen_SmartLen(args)
        t9 = AIMacro.NumEq(t7, t8)
        IfCondition AIMacro.SmartBool(t9) ThenBlock: {
            PrintMessage("argv builtin matches")
            PrintMessage("\n")
        }
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
