# Wave 1: open/read/write/close and sys.argv

import sys

def main() {
    path = "/tmp/aimacro_wave1.txt"
    f = open(path, "w")
    f.write("hello wave1")
    f.close()
    g = open(path, "r")
    s = g.read()
    g.close()
    print(s)
    if s == "hello wave1" {
        print("file roundtrip")
    }

    args = sys.argv
    print("argc", len(args))
    if len(args) > 0 {
        print("argv0 ok")
    }
    args2 = argv()
    if len(args2) == len(args) {
        print("argv builtin matches")
    }
}
