LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        xs = Array.Create(3)
        Array.Push(xs, 10)
        Array.Push(xs, 20)
        Array.Push(xs, 30)
        IfCondition AIMacro.SmartBool(AIMacro.Bool(AIMacro.ListContains(xs, 20))) ThenBlock: {
            PrintMessage("20 in list")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool(AIMacro.Bool(AIMacro.ListContains(xs, 99))) ThenBlock: {
            PrintMessage("FAIL 99 in list")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool(AIMacro.Bool(AIMacro.StrContains("cat", "a"))) ThenBlock: {
            PrintMessage("a in cat")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool(AIMacro.Bool(AIMacro.StrContains("cat", "z"))) ThenBlock: {
            PrintMessage("FAIL z in cat")
            PrintMessage("\n")
        }
        d = Hash.Create(16)
        Hash.Set(d, "name", "Ada")
        Hash.Set(d, "age", 1)
        IfCondition AIMacro.SmartBool(AIMacro.Bool(Hash.Contains(d, "name"))) ThenBlock: {
            PrintMessage("name in dict")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool(AIMacro.Bool(Hash.Contains(d, "nope"))) ThenBlock: {
            PrintMessage("FAIL nope in dict")
            PrintMessage("\n")
        }
        PrintMessage("for list")
        PrintMessage("\n")
        iter0 = xs
        iterlen0 = AIMacro.IterLen(iter0)
        iteri0 = 0
        WhileLoop LessThan(iteri0, iterlen0) {
            x = AIMacro.IterGet(iter0, iteri0)
            AIMacro.SmartPrint(x)
            PrintMessage("\n")
            iteri0 = Add(iteri0, 1)
        }
        PrintMessage("for str")
        PrintMessage("\n")
        iter1 = "hi"
        iterlen1 = AIMacro.IterLen(iter1)
        iteri1 = 0
        WhileLoop LessThan(iteri1, iterlen1) {
            c = AIMacro.IterGet(iter1, iteri1)
            AIMacro.SmartPrint(c)
            PrintMessage("\n")
            iteri1 = Add(iteri1, 1)
        }
        PrintMessage("for dict keys")
        PrintMessage("\n")
        iter2 = d
        iterlen2 = AIMacro.IterLen(iter2)
        iteri2 = 0
        WhileLoop LessThan(iteri2, iterlen2) {
            k = AIMacro.IterGet(iter2, iteri2)
            AIMacro.SmartPrint(k)
            PrintMessage("\n")
            iteri2 = Add(iteri2, 1)
        }
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
