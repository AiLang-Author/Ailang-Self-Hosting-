# Wave 1: membership and for-in over list/str/dict

def main() {
    xs = [10, 20, 30]
    if 20 in xs {
        print("20 in list")
    }
    if 99 in xs {
        print("FAIL 99 in list")
    }
    if "a" in "cat" {
        print("a in cat")
    }
    if "z" in "cat" {
        print("FAIL z in cat")
    }
    d = {"name": "Ada", "age": 1}
    if "name" in d {
        print("name in dict")
    }
    if "nope" in d {
        print("FAIL nope in dict")
    }

    print("for list")
    for x in xs {
        print(x)
    }
    print("for str")
    for c in "hi" {
        print(c)
    }
    print("for dict keys")
    for k in d {
        print(k)
    }
}
