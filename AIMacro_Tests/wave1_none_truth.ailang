LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        n = Types.GetNone()
        IfCondition AIMacro.SmartBool(AIMacro.Is(n, Types.GetNone())) ThenBlock: {
            PrintMessage("none is None")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool(AIMacro.NotVal(AIMacro.Is(n, Types.GetNone()))) ThenBlock: {
            PrintMessage("FAIL none is not None")
            PrintMessage("\n")
        }
        t0 = AIMacro.NumEq(n, Types.GetNone())
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            PrintMessage("none == None")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool(AIMacro.Is(0, Types.GetNone())) ThenBlock: {
            PrintMessage("FAIL 0 is None")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool(AIMacro.NotVal(AIMacro.Is(0, Types.GetNone()))) ThenBlock: {
            PrintMessage("0 is not None")
            PrintMessage("\n")
        }
        t1 = AIMacro.Bool(Types.IsInstance(n, TypeID.NONE))
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            PrintMessage("isinstance None")
            PrintMessage("\n")
        }
        t2 = Types.TypeOf(n)
        PrintMessage("type none")
        PrintMessage(" ")
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = Array.Create(0)
        IfCondition AIMacro.SmartBool(t3) ThenBlock: {
            PrintMessage("FAIL empty list")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("empty list falsy")
            PrintMessage("\n")
        }
        xs = Array.Create(1)
        Array.Push(xs, 1)
        IfCondition AIMacro.SmartBool(xs) ThenBlock: {
            PrintMessage("nonempty list truthy")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool("") ThenBlock: {
            PrintMessage("FAIL empty str")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("empty str falsy")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool("x") ThenBlock: {
            PrintMessage("nonempty str truthy")
            PrintMessage("\n")
        }
        d = Hash.Create(16)
        IfCondition AIMacro.SmartBool(d) ThenBlock: {
            PrintMessage("FAIL empty dict")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("empty dict falsy")
            PrintMessage("\n")
        }
        Hash.Set(d, "a", 1)
        IfCondition AIMacro.SmartBool(d) ThenBlock: {
            PrintMessage("nonempty dict truthy")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool(0) ThenBlock: {
            PrintMessage("FAIL zero")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("zero falsy")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool(1) ThenBlock: {
            PrintMessage("one truthy")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool(AIMacro.NotVal(n)) ThenBlock: {
            PrintMessage("not None")
            PrintMessage("\n")
        }
        t4 = Array.Create(0)
        t5 = AIMacro.NotVal(t4)
        IfCondition AIMacro.SmartBool(t5) ThenBlock: {
            PrintMessage("not empty list")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool(Types.GetNone()) ThenBlock: {
            PrintMessage("FAIL if None")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("if None else")
            PrintMessage("\n")
        }
        PrintMessage("None printed:")
        PrintMessage(" ")
        AIMacro.SmartPrint(n)
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
