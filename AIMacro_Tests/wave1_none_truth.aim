# Wave 1: None sentinel, is/is not, truthiness

def main() {
    n = None
    if n is None {
        print("none is None")
    }
    if n is not None {
        print("FAIL none is not None")
    }
    if n == None {
        print("none == None")
    }
    if 0 is None {
        print("FAIL 0 is None")
    }
    if 0 is not None {
        print("0 is not None")
    }
    if isinstance(n, None) {
        print("isinstance None")
    }
    print("type none", type(n))

    if [] {
        print("FAIL empty list")
    } else {
        print("empty list falsy")
    }
    xs = [1]
    if xs {
        print("nonempty list truthy")
    }
    if "" {
        print("FAIL empty str")
    } else {
        print("empty str falsy")
    }
    if "x" {
        print("nonempty str truthy")
    }
    d = {}
    if d {
        print("FAIL empty dict")
    } else {
        print("empty dict falsy")
    }
    d["a"] = 1
    if d {
        print("nonempty dict truthy")
    }
    if 0 {
        print("FAIL zero")
    } else {
        print("zero falsy")
    }
    if 1 {
        print("one truthy")
    }
    if not n {
        print("not None")
    }
    if not [] {
        print("not empty list")
    }
    if None {
        print("FAIL if None")
    } else {
        print("if None else")
    }
    print("None printed:", n)
}
