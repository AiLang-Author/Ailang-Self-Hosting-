LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        xs = Array.Create(4)
        Array.Push(xs, 1)
        Array.Push(xs, 2)
        Array.Push(xs, 3)
        Array.Push(xs, 4)
        t0 = Array.Create(8)
        iter1 = xs
        iterlen1 = AIMacro.IterLen(iter1)
        iteri1 = 0
        WhileLoop LessThan(iteri1, iterlen1) {
            x = AIMacro.IterGet(iter1, iteri1)
            Array.Push(t0, x)
            iteri1 = Add(iteri1, 1)
        }
        ys = t0
        t2 = DictGen_SmartGet(ys, 0)
        t3 = DictGen_SmartGet(ys, 3)
        AIMacro.SmartPrint(t2)
        PrintMessage(" ")
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = Array.Create(8)
        iter5 = xs
        iterlen5 = AIMacro.IterLen(iter5)
        iteri5 = 0
        WhileLoop LessThan(iteri5, iterlen5) {
            x = AIMacro.IterGet(iter5, iteri5)
            IfCondition AIMacro.SmartBool(AIMacro.NumGt(x, 2)) ThenBlock: {
                Array.Push(t4, x)
            }
            iteri5 = Add(iteri5, 1)
        }
        zs = t4
        t6 = DictGen_SmartLen(zs)
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        t7 = DictGen_SmartGet(zs, 0)
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        a = 7
        b = 8
        AIMacro.SmartPrint(a)
        PrintMessage("\n")
        AIMacro.SmartPrint(b)
        PrintMessage("\n")
        pair = Array.Create(2)
        Array.Push(pair, 10)
        Array.Push(pair, 20)
        __tup8 = pair
        c = DictGen_SmartGet(__tup8, 0)
        d = DictGen_SmartGet(__tup8, 1)
        AIMacro.SmartPrint(c)
        PrintMessage("\n")
        AIMacro.SmartPrint(d)
        PrintMessage("\n")
        path = "/tmp/aimacro_wave2.txt"
        t9 = AIMacro.Open(path, "w")
        t10 = t9
        f = t10
        Fork EqualTo(AIMacro.ExcPending(), 0) TrueBlock: {
            AIMacro.FileWrite(f, "with-ok")
        } FalseBlock: {
        }
        AIMacro.FileClose(t10)
        t11 = AIMacro.Open(path, "r")
        g = t11
        s = AIMacro.FileRead(g)
        AIMacro.FileClose(g)
        AIMacro.SmartPrint(s)
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
