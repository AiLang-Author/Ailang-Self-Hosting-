# Wave 2: list comps, with, tuple unpack

def main() {
    xs = [1, 2, 3, 4]
    ys = [x for x in xs]
    print(ys[0], ys[3])
    zs = [x for x in xs if x > 2]
    print(len(zs))
    print(zs[0])

    a, b = 7, 8
    print(a)
    print(b)
    pair = [10, 20]
    c, d = pair
    print(c)
    print(d)

    path = "/tmp/aimacro_wave2.txt"
    with open(path, "w") as f {
        f.write("with-ok")
    }
    g = open(path, "r")
    s = g.read()
    g.close()
    print(s)
}
