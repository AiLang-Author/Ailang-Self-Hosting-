LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.greet {
    Input: p_name: Integer
    Input: p_punct: Integer
    Body: {
        t0 = AIMacro.Str(p_name)
        t1 = String.Concat("hello ", t0)
        t2 = AIMacro.Str(p_punct)
        t3 = String.Concat(t1, t2)
        msg = t3
        AIMacro.SmartPrint(msg)
        PrintMessage("\n")
    }
}

Function.add {
    Input: p_a: Integer
    Input: p_b: Integer
    Body: {
        t0 = AIMacro.NumAdd(p_a, p_b)
        ReturnValue(t0)
    }
}

Function.main {
    Body: {
        name = "Ada"
        t0 = name
        t1 = String.Concat("hi ", t0)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = add(3, 10)
        s1 = t2
        t3 = AIMacro.Str(s1)
        t4 = String.Concat("sum ", t3)
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        t5 = add(3, 4)
        s2 = t5
        t6 = AIMacro.Str(s2)
        t7 = String.Concat("sum2 ", t6)
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        greet("Bob", "!")
        greet("Cara", ".")
        x = 5
        t8 = AIMacro.NumLt(1, x)
        IfCondition AIMacro.SmartBool(t8) ThenBlock: {
            t8 = AIMacro.NumLt(x, 10)
        }
        IfCondition AIMacro.SmartBool(t8) ThenBlock: {
            PrintMessage("chained")
            PrintMessage("\n")
        }
        t9 = AIMacro.NumLt(1, x)
        IfCondition AIMacro.SmartBool(t9) ThenBlock: {
            t9 = AIMacro.NumLt(x, 4)
        }
        IfCondition AIMacro.SmartBool(t9) ThenBlock: {
            PrintMessage("FAIL chain")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("chain else")
            PrintMessage("\n")
        }
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
