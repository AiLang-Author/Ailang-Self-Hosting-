# Wave 2: f-strings and default arguments

def greet(name, punct="!") {
    msg = f"hello {name}{punct}"
    print(msg)
}

def add(a, b=10) {
    return a + b
}

def main() {
    name = "Ada"
    print(f"hi {name}")
    s1 = add(3)
    print(f"sum {s1}")
    s2 = add(3, 4)
    print(f"sum2 {s2}")
    greet("Bob")
    greet("Cara", ".")
    x = 5
    if 1 < x < 10 {
        print("chained")
    }
    if 1 < x < 4 {
        print("FAIL chain")
    } else {
        print("chain else")
    }
}
