LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.sum_all {
    Input: p_start: Integer
    Input: p_rest: Address
    Body: {
        t = p_start
        i = 0
        t0 = AIMacro.SmartLen(p_rest)
        n = t0
        WhileLoop AIMacro.SmartBool(AIMacro.NumLt(i, n)) {
            t1 = DictGen_SmartGet(p_rest, i)
            t2 = AIMacro.NumAdd(t, t1)
            t = t2
            i = AIMacro.NumAdd(i, 1)
        }
        ReturnValue(t)
    }
}

Function.collect {
    Input: p_items: Address
    Body: {
        t0 = AIMacro.SmartLen(p_items)
        ReturnValue(t0)
    }
}

Function.main {
    Body: {
        t0 = Array.Create(8)
        Array.Push(t0, 2)
        Array.Push(t0, 3)
        Array.Push(t0, 4)
        t1 = sum_all(1, t0)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = Array.Create(8)
        t3 = collect(t2)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = Array.Create(8)
        Array.Push(t4, 9)
        Array.Push(t4, 8)
        t5 = collect(t4)
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        t6 = Array.Create(8)
        t7 = sum_all(10, t6)
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
