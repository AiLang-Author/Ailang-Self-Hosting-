# Wave 3: *args packed into an array Input

def sum_all(start, *rest) {
    t = start
    i = 0
    n = len(rest)
    while i < n {
        t = t + rest[i]
        i = i + 1
    }
    return t
}

def collect(*items) {
    return len(items)
}

def main() {
    print(sum_all(1, 2, 3, 4))
    print(collect())
    print(collect(9, 8))
    print(sum_all(10))
}
