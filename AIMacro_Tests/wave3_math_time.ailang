LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        t0 = AIMacro.Math.Sqrt(16)
        t1 = AIMacro.NumEq(t0, 4)
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            PrintMessage("sqrt ok")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool(AIMacro.NumGt(AIMacro.Math.Pi(), 3)) ThenBlock: {
            PrintMessage("pi ok")
            PrintMessage("\n")
        }
        t = AIMacro.TimeTime()
        IfCondition AIMacro.SmartBool(AIMacro.NumGt(t, 1000000000)) ThenBlock: {
            PrintMessage("time ok")
            PrintMessage("\n")
        }
        AIMacro.TimeSleep(0)
        t2 = AIMacro.StdHandle(1, 1)
        AIMacro.FileWrite(t2, "stdout-ok\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
