# Wave 3: math / time / sys.stdout

import math
import time
import sys

def main() {
    if math.sqrt(16) == 4 {
        print("sqrt ok")
    }
    if math.pi > 3 {
        print("pi ok")
    }
    t = time.time()
    if t > 1000000000 {
        print("time ok")
    }
    time.sleep(0)
    sys.stdout.write("stdout-ok\n")
}
