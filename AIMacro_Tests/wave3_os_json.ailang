LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        p = AIMacro.OsJoin("/tmp", "aimacro_wave3.txt")
        t0 = AIMacro.OsBasename(p)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = AIMacro.OsDirname(p)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = AIMacro.Open(p, "w")
        f = t2
        AIMacro.FileWrite(f, "w3")
        AIMacro.FileClose(f)
        t3 = AIMacro.OsExists(p)
        IfCondition AIMacro.SmartBool(t3) ThenBlock: {
            PrintMessage("exists")
            PrintMessage("\n")
        }
        p3 = AIMacro.OsJoin(AIMacro.OsJoin("/tmp", "a"), "b")
        AIMacro.SmartPrint(p3)
        PrintMessage("\n")
        names = AIMacro.OsListdir("/tmp")
        t4 = AIMacro.SmartLen(names)
        t5 = AIMacro.NumGt(t4, 0)
        IfCondition AIMacro.SmartBool(t5) ThenBlock: {
            PrintMessage("listdir ok")
            PrintMessage("\n")
        }
        xs = AIMacro.JsonLoads("[1,2,3]")
        t6 = DictGen_SmartLen(xs)
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        t7 = DictGen_SmartGet(xs, 0)
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        s = AIMacro.JsonDumps(xs)
        AIMacro.SmartPrint(s)
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
