# Wave 3: os.path / os.listdir / json.loads / json.dumps

import os
import json

def main() {
    p = os.path.join("/tmp", "aimacro_wave3.txt")
    print(os.path.basename(p))
    print(os.path.dirname(p))
    f = open(p, "w")
    f.write("w3")
    f.close()
    if os.path.exists(p) {
        print("exists")
    }
    p3 = os.path.join("/tmp", "a", "b")
    print(p3)

    names = os.listdir("/tmp")
    if len(names) > 0 {
        print("listdir ok")
    }

    xs = json.loads("[1,2,3]")
    print(len(xs))
    print(xs[0])
    s = json.dumps(xs)
    print(s)
}
