LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        t0 = AIMacro.TrueDiv(10, 2)
        t1 = AIMacro.Int(t0)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = AIMacro.TrueDiv(10, 2)
        t3 = AIMacro.NumEq(t2, 5)
        IfCondition AIMacro.SmartBool(t3) ThenBlock: {
            PrintMessage("div eq")
            PrintMessage("\n")
        }
        t4 = AIMacro.TrueDiv(10, 4)
        t5 = AIMacro.FloatParse("2.5")
        t6 = AIMacro.NumEq(t4, t5)
        IfCondition AIMacro.SmartBool(t6) ThenBlock: {
            PrintMessage("true div")
            PrintMessage("\n")
        }
        t7 = AIMacro.FloatParse("1.5")
        x = t7
        t8 = AIMacro.NumAdd(x, 2)
        t9 = AIMacro.Int(t8)
        AIMacro.SmartPrint(t9)
        PrintMessage("\n")
        t10 = AIMacro.NumMul(x, 2)
        t11 = AIMacro.Int(t10)
        AIMacro.SmartPrint(t11)
        PrintMessage("\n")
        IfCondition AIMacro.SmartBool(AIMacro.NumGt(x, 1)) ThenBlock: {
            PrintMessage("gt")
            PrintMessage("\n")
        }
        t12 = AIMacro.FloatParse("0.0")
        IfCondition AIMacro.SmartBool(t12) ThenBlock: {
            PrintMessage("FAIL zero")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("zero false")
            PrintMessage("\n")
        }
        t13 = AIMacro.FloatParse("1.5")
        IfCondition AIMacro.SmartBool(t13) ThenBlock: {
            PrintMessage("truthy")
            PrintMessage("\n")
        }
        t14 = AIMacro.Math.Sqrt(16)
        t15 = AIMacro.Int(t14)
        AIMacro.SmartPrint(t15)
        PrintMessage("\n")
        IfCondition AIMacro.SmartBool(AIMacro.NumGt(AIMacro.Math.Pi(), 3)) ThenBlock: {
            PrintMessage("pi")
            PrintMessage("\n")
        }
        AIMacro.SmartPrint(AIMacro.FloorDiv(7, 2))
        PrintMessage("\n")
        t16 = AIMacro.Float(3)
        t17 = AIMacro.TrueDiv(t16, 2)
        t18 = AIMacro.Int(t17)
        AIMacro.SmartPrint(t18)
        PrintMessage("\n")
        t19 = AIMacro.FloatParse("1.5")
        t20 = AIMacro.IsInstance(t19, TypeID.FLOAT)
        IfCondition AIMacro.SmartBool(t20) ThenBlock: {
            PrintMessage("isinstance float")
            PrintMessage("\n")
        }
        t21 = AIMacro.FloatParse("2.5")
        t22 = AIMacro.NumNeg(t21)
        y = t22
        t23 = AIMacro.Int(y)
        AIMacro.SmartPrint(t23)
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
