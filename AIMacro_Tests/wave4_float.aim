# Wave 4: IEEE floats via Float_* primitives. / is true division. // stays integer.

import math

def main() {
    print(int(10 / 2))
    if 10 / 2 == 5 {
        print("div eq")
    }
    if 10 / 4 == 2.5 {
        print("true div")
    }
    x = 1.5
    print(int(x + 2))
    print(int(x * 2))
    if x > 1 {
        print("gt")
    }
    if 0.0 {
        print("FAIL zero")
    } else {
        print("zero false")
    }
    if 1.5 {
        print("truthy")
    }
    print(int(math.sqrt(16)))
    if math.pi > 3 {
        print("pi")
    }
    print(7 // 2)
    print(int(float(3) / 2))
    if isinstance(1.5, float) {
        print("isinstance float")
    }
    y = -2.5
    print(int(y))
}
