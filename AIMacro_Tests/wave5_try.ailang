LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.boom {
    Body: {
        AIMacro.RaiseKind(2, "nope")
    }
}

Function.main {
    Body: {
        caught = 0
        AIMacro.ExcEnter()
        Fork EqualTo(AIMacro.ExcPending(), 0) TrueBlock: {
            AIMacro.RaiseKind(2, "bad")
        } FalseBlock: {
        }
        Fork EqualTo(AIMacro.ExcPending(), 0) TrueBlock: {
            PrintMessage("FAIL after raise")
            PrintMessage("\n")
        } FalseBlock: {
        }
        Fork EqualTo(AIMacro.ExcPending(), 1) TrueBlock: {
            caught = 1
            PrintMessage("bare catch")
            PrintMessage("\n")
            AIMacro.ExcClear()
        } FalseBlock: {
        }
        AIMacro.ExcLeave()
        t0 = AIMacro.NumEq(caught, 1)
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            PrintMessage("caught ok")
            PrintMessage("\n")
        }
        AIMacro.ExcEnter()
        Fork EqualTo(AIMacro.ExcPending(), 0) TrueBlock: {
            boom()
        } FalseBlock: {
        }
        Fork EqualTo(AIMacro.ExcPending(), 0) TrueBlock: {
            PrintMessage("FAIL boom continued")
            PrintMessage("\n")
        } FalseBlock: {
        }
        Fork EqualTo(AIMacro.ExcPending(), 1) TrueBlock: {
            Branch AIMacro.ExcKind() {
                Case 2: {
                    e = AIMacro.ExcValue()
                    PrintMessage("valueerror")
                    PrintMessage("\n")
                    AIMacro.ExcClear()
                }
            }
        } FalseBlock: {
        }
        AIMacro.ExcLeave()
        fin = 0
        AIMacro.ExcEnter()
        Fork EqualTo(AIMacro.ExcPending(), 0) TrueBlock: {
            AIMacro.RaiseKind(6, "x")
        } FalseBlock: {
        }
        Fork EqualTo(AIMacro.ExcPending(), 1) TrueBlock: {
            PrintMessage("rt")
            PrintMessage("\n")
            AIMacro.ExcClear()
        } FalseBlock: {
        }
        fin = 1
        AIMacro.ExcLeave()
        t1 = AIMacro.NumEq(fin, 1)
        IfCondition AIMacro.SmartBool(t1) ThenBlock: {
            PrintMessage("finally ok")
            PrintMessage("\n")
        }
        AIMacro.ExcEnter()
        Fork EqualTo(AIMacro.ExcPending(), 0) TrueBlock: {
            t2 = AIMacro.Open("/no/such/aimacro_wave5_missing.txt", "r")
            f = t2
        } FalseBlock: {
        }
        Fork EqualTo(AIMacro.ExcPending(), 0) TrueBlock: {
            PrintMessage("FAIL opened missing")
            PrintMessage("\n")
        } FalseBlock: {
        }
        Fork EqualTo(AIMacro.ExcPending(), 1) TrueBlock: {
            Branch AIMacro.ExcKind() {
                Case 4: {
                    PrintMessage("open catch")
                    PrintMessage("\n")
                    AIMacro.ExcClear()
                }
                Case 3: {
                    PrintMessage("open oserror")
                    PrintMessage("\n")
                    AIMacro.ExcClear()
                }
                Default: {
                    PrintMessage("open bare")
                    PrintMessage("\n")
                    AIMacro.ExcClear()
                }
            }
        } FalseBlock: {
        }
        AIMacro.ExcLeave()
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
