LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        s = AIMacro.JsonDumps("hello")
        AIMacro.SmartPrint(s)
        PrintMessage("\n")
        IfCondition AIMacro.SmartBool(EqualTo(StringCompare(s, "\"hello\""), 0)) ThenBlock: {
            PrintMessage("dumps str")
            PrintMessage("\n")
        }
        t0 = Array.Create(2)
        Array.Push(t0, "a")
        Array.Push(t0, "b")
        d = AIMacro.JsonDumps(t0)
        AIMacro.SmartPrint(d)
        PrintMessage("\n")
        t1 = AIMacro.FloatParse("1e-3")
        x = t1
        IfCondition AIMacro.SmartBool(AIMacro.NumGt(x, 0)) ThenBlock: {
            IfCondition AIMacro.SmartBool(AIMacro.NumLt(x, 1)) ThenBlock: {
                PrintMessage("sci")
                PrintMessage("\n")
            }
        }
        t2 = AIMacro.FloatParse("2.0")
        t3 = AIMacro.NumPow(t2, 3)
        y = t3
        t4 = AIMacro.Int(y)
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        AIMacro.ExcEnter()
        Fork EqualTo(AIMacro.ExcPending(), 0) TrueBlock: {
            AIMacro.RaiseKind(2, "boom-msg")
        } FalseBlock: {
        }
        Fork EqualTo(AIMacro.ExcPending(), 1) TrueBlock: {
            Branch AIMacro.ExcKind() {
                Case 2: {
                    e = AIMacro.ExcValue()
                    AIMacro.SmartPrint(e)
                    PrintMessage("\n")
                    t5 = AIMacro.Str(e)
                    AIMacro.SmartPrint(t5)
                    PrintMessage("\n")
                    AIMacro.ExcClear()
                }
            }
        } FalseBlock: {
        }
        AIMacro.ExcLeave()
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
