# Wave 6: json string dumps, print(e), scientific literals, float **

import json

def main() {
    s = json.dumps("hello")
    print(s)
    if s == "\"hello\"" {
        print("dumps str")
    }

    d = json.dumps(["a", "b"])
    print(d)

    x = 1e-3
    if x > 0 {
        if x < 1 {
            print("sci")
        }
    }
    y = 2.0 ** 3
    print(int(y))

    try {
        raise ValueError("boom-msg")
    } except ValueError as e {
        print(e)
        print(str(e))
    }
}
