LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        t0 = AIMacro.TrueVal()
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = AIMacro.FalseVal()
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        PrintNumber(1)
        PrintMessage("\n")
        AIMacro.SmartPrint(Types.GetNone())
        PrintMessage("\n")
        t2 = Array.Create(2)
        Array.Push(t2, 1)
        Array.Push(t2, 2)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t3 = Hash.Create(16)
        Hash.Set(t3, "a", 1)
        AIMacro.SmartPrint(t3)
        PrintMessage("\n")
        t4 = AIMacro.Repr("hi")
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        t5 = Array.Create(2)
        Array.Push(t5, 1)
        Array.Push(t5, 2)
        t6 = AIMacro.Repr(t5)
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        t7 = AIMacro.TrueVal()
        t8 = AIMacro.Repr(t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        t9 = AIMacro.TrueVal()
        t10 = AIMacro.Str(t9)
        AIMacro.SmartPrint(t10)
        PrintMessage("\n")
        t11 = AIMacro.TrueVal()
        t = t11
        t12 = AIMacro.FalseVal()
        f = t12
        IfCondition AIMacro.SmartBool(t) ThenBlock: {
            PrintMessage("t truthy")
            PrintMessage("\n")
        }
        IfCondition AIMacro.SmartBool(f) ThenBlock: {
            PrintMessage("FAIL f truthy")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("f falsy")
            PrintMessage("\n")
        }
        t13 = AIMacro.NumEq(t, 1)
        IfCondition AIMacro.SmartBool(t13) ThenBlock: {
            PrintMessage("True==1")
            PrintMessage("\n")
        }
        t14 = AIMacro.TrueVal()
        t15 = AIMacro.NumAdd(t14, 1)
        AIMacro.SmartPrint(t15)
        PrintMessage("\n")
        t16 = Hash.Create(16)
        Hash.Set(t16, "k", "v")
        s = AIMacro.JsonDumps(t16)
        AIMacro.SmartPrint(s)
        PrintMessage("\n")
        d = AIMacro.JsonLoads(s)
        t17 = DictGen_SmartGet(d, "k")
        AIMacro.SmartPrint(t17)
        PrintMessage("\n")
        t18 = AIMacro.JsonDumps("hello")
        AIMacro.SmartPrint(t18)
        PrintMessage("\n")
        t19 = Array.Create(2)
        Array.Push(t19, 1)
        Array.Push(t19, 2)
        t20 = AIMacro.JsonDumps(t19)
        AIMacro.SmartPrint(t20)
        PrintMessage("\n")
        t21 = AIMacro.TrueVal()
        t22 = AIMacro.JsonDumps(t21)
        AIMacro.SmartPrint(t22)
        PrintMessage("\n")
        t23 = AIMacro.JsonDumps(Types.GetNone())
        AIMacro.SmartPrint(t23)
        PrintMessage("\n")
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
