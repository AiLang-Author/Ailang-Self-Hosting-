# Wave 7: print/repr of bool/list/dict; json.dumps dict strings

import json

def main() {
    print(True)
    print(False)
    print(1)
    print(None)
    print([1, 2])
    print({"a": 1})
    print(repr("hi"))
    print(repr([1, 2]))
    print(repr(True))
    print(str(True))
    t = True
    f = False
    if t {
        print("t truthy")
    }
    if f {
        print("FAIL f truthy")
    } else {
        print("f falsy")
    }
    if t == 1 {
        print("True==1")
    }
    print(True + 1)
    s = json.dumps({"k": "v"})
    print(s)
    d = json.loads(s)
    print(d["k"])
    print(json.dumps("hello"))
    print(json.dumps([1, 2]))
    print(json.dumps(True))
    print(json.dumps(None))
}
