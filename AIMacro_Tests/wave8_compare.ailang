LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.main {
    Body: {
        t0 = AIMacro.NumEq(1, 1)
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t1 = AIMacro.NumEq(1, 2)
        AIMacro.SmartPrint(t1)
        PrintMessage("\n")
        t2 = AIMacro.NumNe(1, 2)
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        AIMacro.SmartPrint(AIMacro.NumLt(3, 5))
        PrintMessage("\n")
        t3 = AIMacro.TrueVal()
        t4 = AIMacro.NumEq(t3, 1)
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        t5 = AIMacro.TrueVal()
        t6 = AIMacro.Is(t5, 1)
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        AIMacro.SmartPrint(AIMacro.Is(Types.GetNone(), Types.GetNone()))
        PrintMessage("\n")
        t7 = AIMacro.FalseVal()
        t8 = AIMacro.NotVal(t7)
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        t9 = 1
        IfCondition AIMacro.SmartBool(t9) ThenBlock: {
            t9 = 2
        }
        AIMacro.SmartPrint(t9)
        PrintMessage("\n")
        t10 = 0
        IfCondition Not(AIMacro.SmartBool(t10)) ThenBlock: {
            t10 = 5
        }
        AIMacro.SmartPrint(t10)
        PrintMessage("\n")
        t11 = AIMacro.TrueVal()
        t12 = t11
        IfCondition AIMacro.SmartBool(t12) ThenBlock: {
            t13 = AIMacro.FalseVal()
            t12 = t13
        }
        AIMacro.SmartPrint(t12)
        PrintMessage("\n")
        t14 = Array.Create(2)
        Array.Push(t14, 1)
        Array.Push(t14, 2)
        t15 = AIMacro.Bool(DictGen_SmartContains(t14, 1))
        AIMacro.SmartPrint(t15)
        PrintMessage("\n")
        t16 = Array.Create(2)
        Array.Push(t16, 1)
        Array.Push(t16, 2)
        t17 = AIMacro.Bool(DictGen_SmartContains(t16, 3))
        AIMacro.SmartPrint(t17)
        PrintMessage("\n")
                t18 = AIMacro.Bool(DictGen_SmartContains("cat", "a"))
AIMacro.SmartPrint(t18)
        PrintMessage("\n")
        t19 = AIMacro.NumLt(1, 5)
        IfCondition AIMacro.SmartBool(t19) ThenBlock: {
            t19 = AIMacro.NumLt(5, 9)
        }
        AIMacro.SmartPrint(t19)
        PrintMessage("\n")
        t20 = AIMacro.IsInstance(1, TypeID.INT)
        AIMacro.SmartPrint(t20)
        PrintMessage("\n")
        t21 = Array.Create(2)
        Array.Push(t21, 0)
        Array.Push(t21, 1)
        t22 = AIMacro.Any(t21)
        AIMacro.SmartPrint(t22)
        PrintMessage("\n")
        t23 = Array.Create(2)
        Array.Push(t23, 1)
        Array.Push(t23, 0)
        t24 = AIMacro.All(t23)
        AIMacro.SmartPrint(t24)
        PrintMessage("\n")
        t25 = Array.Create(0)
        t26 = AIMacro.All(t25)
        AIMacro.SmartPrint(t26)
        PrintMessage("\n")
        t27 = AIMacro.NumEq(1, 1)
        IfCondition AIMacro.SmartBool(t27) ThenBlock: {
            PrintMessage("if eq")
            PrintMessage("\n")
        }
        t28 = AIMacro.FalseVal()
        t29 = AIMacro.NotVal(t28)
        IfCondition AIMacro.SmartBool(t29) ThenBlock: {
            PrintMessage("if not")
            PrintMessage("\n")
        }
        t30 = 0
        IfCondition Not(AIMacro.SmartBool(t30)) ThenBlock: {
            t30 = 5
        }
        IfCondition AIMacro.SmartBool(t30) ThenBlock: {
            PrintMessage("if or")
            PrintMessage("\n")
        }
        t31 = AIMacro.TrueVal()
        t = t31
        t32 = AIMacro.TrueVal()
        t33 = AIMacro.Is(t, t32)
        IfCondition AIMacro.SmartBool(t33) ThenBlock: {
            PrintMessage("is True")
            PrintMessage("\n")
        }
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
