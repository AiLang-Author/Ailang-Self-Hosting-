# Wave 8: comparison/is/in/not print True/False; and/or return operands

def main() {
    print(1 == 1)
    print(1 == 2)
    print(1 != 2)
    print(3 < 5)
    print(True == 1)
    print(True is 1)
    print(None is None)
    print(not False)
    print(1 and 2)
    print(0 or 5)
    print(True and False)
    print(1 in [1, 2])
    print(3 in [1, 2])
    print("a" in "cat")
    print(1 < 5 < 9)
    print(isinstance(1, int))
    print(any([0, 1]))
    print(all([1, 0]))
    print(all([]))
    if 1 == 1 {
        print("if eq")
    }
    if not False {
        print("if not")
    }
    if 0 or 5 {
        print("if or")
    }
    t = True
    if t is True {
        print("is True")
    }
}
