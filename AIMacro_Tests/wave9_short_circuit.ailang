LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.Array
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP


Function.boom {
    Body: {
        PrintMessage("BOOM")
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.main {
    Body: {
        t0 = 0
        IfCondition AIMacro.SmartBool(t0) ThenBlock: {
            t1 = boom()
            t0 = t1
        }
        AIMacro.SmartPrint(t0)
        PrintMessage("\n")
        t2 = 1
        IfCondition Not(AIMacro.SmartBool(t2)) ThenBlock: {
            t3 = boom()
            t2 = t3
        }
        AIMacro.SmartPrint(t2)
        PrintMessage("\n")
        t4 = 1
        IfCondition AIMacro.SmartBool(t4) ThenBlock: {
            t4 = 2
        }
        AIMacro.SmartPrint(t4)
        PrintMessage("\n")
        t5 = 0
        IfCondition Not(AIMacro.SmartBool(t5)) ThenBlock: {
            t5 = 5
        }
        AIMacro.SmartPrint(t5)
        PrintMessage("\n")
        x = Types.GetNone()
        t6 = x
        IfCondition Not(AIMacro.SmartBool(t6)) ThenBlock: {
            t6 = "d"
        }
        AIMacro.SmartPrint(t6)
        PrintMessage("\n")
        t7 = AIMacro.NumLt(1, 5)
        IfCondition AIMacro.SmartBool(t7) ThenBlock: {
            t7 = AIMacro.NumLt(5, 9)
        }
        AIMacro.SmartPrint(t7)
        PrintMessage("\n")
        t8 = AIMacro.NumLt(5, 3)
        IfCondition AIMacro.SmartBool(t8) ThenBlock: {
            t9 = boom()
            t8 = AIMacro.NumLt(3, t9)
        }
        AIMacro.SmartPrint(t8)
        PrintMessage("\n")
        t10 = 0
        IfCondition AIMacro.SmartBool(t10) ThenBlock: {
            t11 = boom()
            t10 = t11
        }
        IfCondition AIMacro.SmartBool(t10) ThenBlock: {
            PrintMessage("FAIL and")
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("skip and")
            PrintMessage("\n")
        }
        t12 = 1
        IfCondition Not(AIMacro.SmartBool(t12)) ThenBlock: {
            t13 = boom()
            t12 = t13
        }
        IfCondition AIMacro.SmartBool(t12) ThenBlock: {
            PrintMessage("skip or")
            PrintMessage("\n")
        }
    }
}


SubRoutine.Main {
    main()
    ProcessExit(0)
}

RunTask(Main)
