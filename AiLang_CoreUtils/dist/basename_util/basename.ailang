// basename.ailang - Strip directory and optional suffix from a pathname

LibraryImport.Arena

FixedPool.BOpt {
    "multiple": Initialize=0
    "zero": Initialize=0
    "have_suf": Initialize=0
    "nread": Initialize=0
    "want_suf": Initialize=0
    "options_done": Initialize=0
}

FixedPool.BaseSuf {
    "ptr": Initialize=0
    "len": Initialize=0
}

FixedPool.ArgScan {
    "pos": Initialize=0
}

FixedPool.JoinBuf {
    "total": Initialize=0
    "pos": Initialize=0
}

Function.WriteStdout {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 1, buffer, len)
    }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.DieMissing {
    Body: {
        WriteStderr("basename: missing operand\n")
        WriteStderr("Try 'basename --help' for more information.\n")
        SystemCall(60, 1)
    }
}

Function.DieExtra {
    Input: name: Address
    Body: {
        WriteStderr("basename: extra operand '")
        WriteStderr(name)
        WriteStderr("'\n")
        WriteStderr("Try 'basename --help' for more information.\n")
        SystemCall(60, 1)
    }
}

Function.DieOption {
    Input: msg: Address
    Body: {
        WriteStderr("basename: ")
        WriteStderr(msg)
        WriteStderr("\n")
        WriteStderr("Try 'basename --help' for more information.\n")
        SystemCall(60, 1)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        BOpt.nread = bytes_read
        ReturnValue(buffer)
    }
}

Function.CopyArgAt {
    Input: base: Address
    Input: at: Integer
    Output: Address
    Body: {
        JoinBuf.total = 0
        WhileLoop NotEqual(RDMEM_8(base, Add(at, JoinBuf.total)), 0) {
            JoinBuf.total = Add(JoinBuf.total, 1)
            IfCondition GreaterThan(JoinBuf.total, 4096) ThenBlock: {
                BreakLoop
            }
        }
        buf = Allocate(Add(JoinBuf.total, 1))
        JoinBuf.pos = 0
        WhileLoop LessThan(JoinBuf.pos, JoinBuf.total) {
            WRMEM_8(buf, JoinBuf.pos, RDMEM_8(base, Add(at, JoinBuf.pos)))
            JoinBuf.pos = Add(JoinBuf.pos, 1)
        }
        WRMEM_8(buf, JoinBuf.total, 0)
        ReturnValue(buf)
    }
}

Function.EmitBase {
    Input: path: Address
    Body: {
        path_len = StringLength(path)
        term = 10
        IfCondition EqualTo(BOpt.zero, 1) ThenBlock: {
            term = 0
        }
        IfCondition EqualTo(path_len, 0) ThenBlock: {
            buf = Allocate(1)
            WRMEM_8(buf, 0, term)
            WriteStdout(buf, 1)
            Deallocate(buf, 1)
            ReturnValue(0)
        }

        end_pos = Subtract(path_len, 1)
        WhileLoop GreaterEqual(end_pos, 0) {
            ch = RDMEM_8(path, end_pos)
            IfCondition NotEqual(ch, 47) ThenBlock: {
                BreakLoop
            }
            end_pos = Subtract(end_pos, 1)
        }
        IfCondition LessThan(end_pos, 0) ThenBlock: {
            buf = Allocate(2)
            WRMEM_8(buf, 0, 47)
            WRMEM_8(buf, 1, term)
            WriteStdout(buf, 2)
            Deallocate(buf, 2)
            ReturnValue(0)
        }

        last_slash = -1
        i = 0
        WhileLoop LessEqual(i, end_pos) {
            ch = RDMEM_8(path, i)
            IfCondition EqualTo(ch, 47) ThenBlock: {
                last_slash = i
            }
            i = Add(i, 1)
        }

        IfCondition EqualTo(last_slash, -1) ThenBlock: {
            src = path
            len = Add(end_pos, 1)
        } ElseBlock: {
            src = Add(path, Add(last_slash, 1))
            len = Subtract(Add(end_pos, 1), Add(last_slash, 1))
        }

        IfCondition GreaterThan(BaseSuf.len, 0) ThenBlock: {
            IfCondition GreaterThan(len, BaseSuf.len) ThenBlock: {
                off = Subtract(len, BaseSuf.len)
                match = 1
                k = 0
                WhileLoop LessThan(k, BaseSuf.len) {
                    left = RDMEM_8(src, Add(off, k))
                    right = RDMEM_8(BaseSuf.ptr, k)
                    IfCondition NotEqual(left, right) ThenBlock: {
                        match = 0
                    }
                    k = Add(k, 1)
                }
                IfCondition EqualTo(match, 1) ThenBlock: {
                    len = Subtract(len, BaseSuf.len)
                }
            }
        }

        out_buf = Allocate(Add(len, 1))
        MemoryCopy(out_buf, src, len)
        WRMEM_8(out_buf, len, term)
        WriteStdout(out_buf, Add(len, 1))
        Deallocate(out_buf, Add(len, 1))
        ReturnValue(0)
    }
}

Function.TakeShort {
    Input: arg: Address
    Body: {
        i = 1
        WhileLoop NotEqual(RDMEM_8(arg, i), 0) {
            ch = RDMEM_8(arg, i)
            known = 0
            IfCondition EqualTo(ch, 97) ThenBlock: {
                BOpt.multiple = 1
                known = 1
            }
            IfCondition EqualTo(ch, 122) ThenBlock: {
                BOpt.zero = 1
                known = 1
            }
            IfCondition EqualTo(ch, 115) ThenBlock: {
                BOpt.multiple = 1
                nxt = RDMEM_8(arg, Add(i, 1))
                IfCondition EqualTo(nxt, 0) ThenBlock: {
                    BOpt.want_suf = 1
                } ElseBlock: {
                    BaseSuf.ptr = Add(arg, Add(i, 1))
                    BaseSuf.len = StringLength(BaseSuf.ptr)
                    BOpt.have_suf = 1
                }
                ReturnValue(0)
            }
            IfCondition EqualTo(known, 0) ThenBlock: {
                DieOption("invalid option -- 's'")
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    args_buffer = GetArgs()
    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        DieMissing()
    }

    ArgScan.pos = 0
    WhileLoop NotEqual(RDMEM_8(args_buffer, ArgScan.pos), 0) {
        ArgScan.pos = Add(ArgScan.pos, 1)
    }
    ArgScan.pos = Add(ArgScan.pos, 1)

    names = ArrayCreate(64)
    name_count = 0

    WhileLoop LessThan(ArgScan.pos, BOpt.nread) {
        ch = RDMEM_8(args_buffer, ArgScan.pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            arg = Allocate(1)
            WRMEM_8(arg, 0, 0)
            ArgScan.pos = Add(ArgScan.pos, 1)
        } ElseBlock: {
            arg = CopyArgAt(args_buffer, ArgScan.pos)
            WhileLoop NotEqual(RDMEM_8(args_buffer, ArgScan.pos), 0) {
                ArgScan.pos = Add(ArgScan.pos, 1)
            }
            ArgScan.pos = Add(ArgScan.pos, 1)
        }

        IfCondition EqualTo(BOpt.want_suf, 1) ThenBlock: {
            BaseSuf.ptr = arg
            BaseSuf.len = StringLength(arg)
            BOpt.have_suf = 1
            BOpt.want_suf = 0
            ContinueLoop
        }

        IfCondition EqualTo(BOpt.options_done, 0) ThenBlock: {
            IfCondition EqualTo(RDMEM_8(arg, 0), 45) ThenBlock: {
                IfCondition NotEqual(RDMEM_8(arg, 1), 0) ThenBlock: {
                    IfCondition EqualTo(RDMEM_8(arg, 1), 45) ThenBlock: {
                        IfCondition EqualTo(RDMEM_8(arg, 2), 0) ThenBlock: {
                            BOpt.options_done = 1
                            ContinueLoop
                        }
                    }
                    IfCondition StringEquals(arg, "--zero") ThenBlock: {
                        BOpt.zero = 1
                        ContinueLoop
                    }
                    IfCondition StringEquals(arg, "--multiple") ThenBlock: {
                        BOpt.multiple = 1
                        ContinueLoop
                    }
                    IfCondition StringEquals(arg, "--suffix") ThenBlock: {
                        BOpt.multiple = 1
                        BOpt.want_suf = 1
                        ContinueLoop
                    }
                    IfCondition EqualTo(RDMEM_8(arg, 1), 45) ThenBlock: {
                        DieOption("unrecognized option")
                    }
                    TakeShort(arg)
                    ContinueLoop
                }
            }
        }

        IfCondition LessThan(name_count, 64) ThenBlock: {
            ArraySet(names, name_count, arg)
            name_count = Add(name_count, 1)
        }
        BOpt.options_done = 1
    }

    IfCondition EqualTo(BOpt.want_suf, 1) ThenBlock: {
        DieOption("option requires an argument -- 's'")
    }

    IfCondition EqualTo(BOpt.multiple, 0) ThenBlock: {
        IfCondition EqualTo(name_count, 0) ThenBlock: {
            DieMissing()
        }
        IfCondition EqualTo(name_count, 1) ThenBlock: {
            EmitBase(ArrayGet(names, 0))
        }
        IfCondition EqualTo(name_count, 2) ThenBlock: {
            sufs = ArrayGet(names, 1)
            BaseSuf.ptr = sufs
            BaseSuf.len = StringLength(sufs)
            EmitBase(ArrayGet(names, 0))
        }
        IfCondition GreaterThan(name_count, 2) ThenBlock: {
            DieExtra(ArrayGet(names, 2))
        }
    } ElseBlock: {
        IfCondition EqualTo(name_count, 0) ThenBlock: {
            DieMissing()
        }
        i = 0
        WhileLoop LessThan(i, name_count) {
            EmitBase(ArrayGet(names, i))
            i = Add(i, 1)
        }
    }

    ArrayDestroy(names)
    Deallocate(args_buffer, 4096)
    SystemCall(60, 0)
}

RunTask(Main)
