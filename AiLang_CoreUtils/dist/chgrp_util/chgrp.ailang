// chgrp.ailang - Change group ownership
// Usage: chgrp [OPTIONS] GROUP FILE...

LibraryImport.Arena

FixedPool.ChgrpConstants {
    "AT_FDCWD": Initialize=-100
    "AT_SYMLINK_NOFOLLOW": Initialize=256
}

FixedPool.ChgrpConfig {
    "no_dereference": Initialize=0
    "verbose": Initialize=0
    "silent": Initialize=0
    "recurse": Initialize=0
    "explicit_deref": Initialize=0
    "use_reference": Initialize=0
    "traverse": Initialize=0
    "preserve_root": Initialize=0
    "root_dev0": Initialize=0
    "root_dev1": Initialize=0
    "root_ino0": Initialize=0
    "root_ino1": Initialize=0
}

Function.WriteStdout {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 1, buffer, len)
    }
}

Function.WriteStderr {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 2, buffer, len)
    }
}

Function.GetStringLength {
    Input: str: Address
    Output: Integer
    Body: {
        len = 0
        WhileLoop NotEqual(RDMEM_8(str, len), 0) {
            len = Add(len, 1)
        }
        ReturnValue(len)
    }
}

Function.WriteErrStr {
    Input: str: Address
    Body: {
        n = GetStringLength(str)
        WriteStderr(str, n)
    }
}

Function.ConvertNumberToString {
    Input: num: Integer
    Output: Address
    Body: {
        buffer = Allocate(32)
        
        IfCondition EqualTo(num, 0) ThenBlock: {
            WRMEM_8(buffer, 0, 48)
            WRMEM_8(buffer, 1, 0)
            ReturnValue(buffer)
        }
        
        is_neg = 0
        IfCondition LessThan(num, 0) ThenBlock: {
            is_neg = 1
            num = Subtract(0, num)
        }
        
        pos = 0
        temp = Allocate(32)
        
        WhileLoop GreaterThan(num, 0) {
            digit = Modulo(num, 10)
            WRMEM_8(temp, pos, Add(48, digit))
            pos = Add(pos, 1)
            num = Divide(num, 10)
        }
        
        write_pos = 0
        IfCondition NotEqual(is_neg, 0) ThenBlock: {
            WRMEM_8(buffer, 0, 45)
            write_pos = 1
        }
        
        i = Subtract(pos, 1)
        WhileLoop GreaterEqual(i, 0) {
            ch = RDMEM_8(temp, i)
            WRMEM_8(buffer, write_pos, ch)
            write_pos = Add(write_pos, 1)
            i = Subtract(i, 1)
        }
        
        WRMEM_8(buffer, write_pos, 0)
        Deallocate(temp, 32)
        
        ReturnValue(buffer)
    }
}

// Parse numeric GID
Function.ParseNumeric {
    Input: str: Address
    Output: Integer
    Body: {
        result = 0
        i = 0
        
        WhileLoop LessThan(i, 20) {
            ch = RDMEM_8(str, i)
            
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            
            // Check if digit
            IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                ReturnValue(-1)
            }
            
            digit = Subtract(ch, 48)
            result = Add(Multiply(result, 10), digit)
            i = Add(i, 1)
        }
        
        ReturnValue(result)
    }
}

// Compare strings up to n characters
Function.StringCompareN {
    Input: s1: Address
    Input: s2: Address
    Input: n: Integer
    Output: Integer
    Body: {
        i = 0
        
        WhileLoop LessThan(i, n) {
            c1 = RDMEM_8(s1, i)
            c2 = RDMEM_8(s2, i)
            
            IfCondition NotEqual(c1, c2) ThenBlock: {
                ReturnValue(1)
            }
            
            IfCondition EqualTo(c1, 0) ThenBlock: {
                ReturnValue(0)
            }
            
            i = Add(i, 1)
        }
        
        // Check if s2 ends here
        c2 = RDMEM_8(s2, n)
        IfCondition EqualTo(c2, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        ReturnValue(1)
    }
}

// Parse a single line from /etc/group
Function.ParseGroupLine {
    Input: line: Address
    Input: length: Integer
    Input: target_name: Address
    Output: Integer
    Body: {
        // Format: groupname:x:gid:users
        
        name_end = 0
        i = 0
        
        // Find first colon (end of group name)
        WhileLoop LessThan(i, length) {
            IfCondition EqualTo(RDMEM_8(line, i), 58) ThenBlock: {
                name_end = i
                BreakLoop
            }
            i = Add(i, 1)
        }
        
        IfCondition EqualTo(name_end, 0) ThenBlock: {
            ReturnValue(-1)
        }
        
        // Check if name matches
        matches = StringCompareN(line, target_name, name_end)
        IfCondition NotEqual(matches, 0) ThenBlock: {
            ReturnValue(-1)
        }
        
        // Skip to second colon (before GID)
        i = Add(name_end, 1)
        WhileLoop LessThan(i, length) {
            IfCondition EqualTo(RDMEM_8(line, i), 58) ThenBlock: {
                i = Add(i, 1)
                BreakLoop
            }
            i = Add(i, 1)
        }
        
        // Parse GID
        gid = 0
        WhileLoop LessThan(i, length) {
            ch = RDMEM_8(line, i)
            
            // Stop at colon or newline
            IfCondition Or(EqualTo(ch, 58), EqualTo(ch, 10)) ThenBlock: {
                BreakLoop
            }
            
            // Parse digit
            IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                digit = Subtract(ch, 48)
                gid = Add(Multiply(gid, 10), digit)
            }
            
            i = Add(i, 1)
        }
        
        ReturnValue(gid)
    }
}

// Parse /etc/group file
Function.ParseGroupFile {
    Input: buffer: Address
    Input: size: Integer
    Input: target_name: Address
    Output: Integer
    Body: {
        line_start = 0
        i = 0
        
        WhileLoop LessThan(i, size) {
            ch = RDMEM_8(buffer, i)
            
            // New line
            IfCondition EqualTo(ch, 10) ThenBlock: {
                // Parse this line
                line_len = Subtract(i, line_start)
                IfCondition GreaterThan(line_len, 0) ThenBlock: {
                    gid = ParseGroupLine(Add(buffer, line_start), line_len, target_name)
                    
                    IfCondition GreaterEqual(gid, 0) ThenBlock: {
                        ReturnValue(gid)
                    }
                }
                
                line_start = Add(i, 1)
            }
            
            i = Add(i, 1)
        }
        
        ReturnValue(-1)
    }
}

// Lookup group name in /etc/group
Function.LookupGroupName {
    Input: name: Address
    Output: Integer
    Body: {
        // Open /etc/group
        fd = SystemCall(2, "/etc/group", 0)
        
        IfCondition LessThan(fd, 0) ThenBlock: {
            WriteStderr("chgrp: cannot open /etc/group\n", 30)
            ReturnValue(-1)
        }
        
        // Read file
        buffer = Allocate(8192)
        bytes_read = SystemCall(0, fd, buffer, 8192)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 8192)
            ReturnValue(-1)
        }
        
        // Parse /etc/group format: groupname:x:gid:users
        gid = ParseGroupFile(buffer, bytes_read, name)
        
        Deallocate(buffer, 8192)
        ReturnValue(gid)
    }
}

// Parse group name or GID
Function.ParseGroup {
    Input: group_str: Address
    Output: Integer
    Body: {
        // Try to parse as numeric GID first
        gid = ParseNumeric(group_str)
        
        IfCondition GreaterEqual(gid, 0) ThenBlock: {
            ReturnValue(gid)
        }
        
        // Otherwise, look up group name in /etc/group
        gid = LookupGroupName(group_str)
        ReturnValue(gid)
    }
}

// Change group ownership of a file
Function.ChangeGroup {
    Input: path: Address
    Input: gid: Integer
    Input: nofollow: Integer
    Output: Integer
    Body: {
        flags = 0
        
        IfCondition NotEqual(nofollow, 0) ThenBlock: {
            flags = ChgrpConstants.AT_SYMLINK_NOFOLLOW
        }
        
        // fchownat syscall: 260 on x86_64
        // int fchownat(int dirfd, const char *pathname, uid_t owner, gid_t group, int flags);
        // Use -1 for owner to leave it unchanged
        result = SystemCall(260, ChgrpConstants.AT_FDCWD, path, -1, gid, flags)
        
        IfCondition LessThan(result, 0) ThenBlock: {
            IfCondition EqualTo(ChgrpConfig.silent, 0) ThenBlock: {
                errno = Subtract(0, result)
                IfCondition EqualTo(errno, 13) ThenBlock: {
                    WriteStderr("chgrp: cannot access '", 22)
                    WriteStderr(path, GetStringLength(path))
                    WriteStderr("': Permission denied\n", 21)
                } ElseBlock: {
                    WriteStderr("chgrp: cannot change group of '", 31)
                    WriteStderr(path, GetStringLength(path))
                    WriteStderr("': ", 3)
                    IfCondition EqualTo(errno, 2) ThenBlock: {
                        WriteStderr("No such file or directory\n", 26)
                    } ElseBlock: {
                        WriteStderr("Operation not permitted\n", 24)
                    }
                }
            }
            ReturnValue(1)
        }
        
        // Verbose output
        IfCondition NotEqual(ChgrpConfig.verbose, 0) ThenBlock: {
            WriteStdout("changed group of '", 18)
            WriteStdout(path, GetStringLength(path))
            WriteStdout("' to ", 5)
            gid_str = ConvertNumberToString(gid)
            WriteStdout(gid_str, GetStringLength(gid_str))
            WriteStdout("\n", 1)
            Deallocate(gid_str, 32)
        }
        
        ReturnValue(0)
    }
}

Function.GetUInt32 {
    Input: addr: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        b0 = RDMEM_8(addr, offset)
        b1 = RDMEM_8(addr, Add(offset, 1))
        b2 = RDMEM_8(addr, Add(offset, 2))
        b3 = RDMEM_8(addr, Add(offset, 3))
        value = Add(b0, Multiply(b1, 256))
        value = Add(value, Multiply(b2, 65536))
        value = Add(value, Multiply(b3, 16777216))
        ReturnValue(value)
    }
}

Function.CopyAt {
    Input: base: Address
    Input: at: Integer
    Output: Address
    Body: {
        n = 0
        WhileLoop NotEqual(RDMEM_8(base, Add(at, n)), 0) {
            n = Add(n, 1)
        }
        buf = Allocate(Add(n, 1))
        i = 0
        WhileLoop LessThan(i, n) {
            WRMEM_8(buf, i, RDMEM_8(base, Add(at, i)))
            i = Add(i, 1)
        }
        WRMEM_8(buf, n, 0)
        ReturnValue(buf)
    }
}

Function.RefGid {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(4, path, statbuf)
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            WriteStderr("chgrp: failed to get attributes of '", 36)
            WriteStderr(path, GetStringLength(path))
            WriteStderr("': No such file or directory\n", 29)
            ReturnValue(-2)
        }
        gid = GetUInt32(statbuf, 32)
        Deallocate(statbuf, 144)
        ReturnValue(gid)
    }
}

Function.IsRealDir {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(6, path, statbuf)
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        mode = GetUInt32(statbuf, 24)
        Deallocate(statbuf, 144)
        kind = BitwiseAnd(mode, 61440)
        ReturnValue(EqualTo(kind, 16384))
    }
}

Function.BuildChild {
    Input: dir: Address
    Input: name: Address
    Output: Address
    Body: {
        dir_len = GetStringLength(dir)
        name_len = GetStringLength(name)
        total = Add(Add(dir_len, name_len), 2)
        path = Allocate(total)
        i = 0
        WhileLoop LessThan(i, dir_len) {
            WRMEM_8(path, i, RDMEM_8(dir, i))
            i = Add(i, 1)
        }
        WRMEM_8(path, i, 47)
        i = Add(i, 1)
        j = 0
        WhileLoop LessThan(j, name_len) {
            WRMEM_8(path, i, RDMEM_8(name, j))
            i = Add(i, 1)
            j = Add(j, 1)
        }
        WRMEM_8(path, i, 0)
        ReturnValue(path)
    }
}

Function.PathKind {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(6, path, statbuf)
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        mode = GetUInt32(statbuf, 24)
        Deallocate(statbuf, 144)
        kind = BitwiseAnd(mode, 61440)
        IfCondition EqualTo(kind, 40960) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(kind, 16384) ThenBlock: {
            ReturnValue(2)
        }
        ReturnValue(3)
    }
}

Function.IsStatDir {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(4, path, statbuf)
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        mode = GetUInt32(statbuf, 24)
        Deallocate(statbuf, 144)
        kind = BitwiseAnd(mode, 61440)
        ReturnValue(EqualTo(kind, 16384))
    }
}

Function.LoadRoot {
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(6, "/", statbuf)
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            WriteErrStr("chgrp: failed to get attributes of '/'\n")
            SystemCall(60, 1)
        }
        ChgrpConfig.root_dev0 = GetUInt32(statbuf, 0)
        ChgrpConfig.root_dev1 = GetUInt32(statbuf, 4)
        ChgrpConfig.root_ino0 = GetUInt32(statbuf, 8)
        ChgrpConfig.root_ino1 = GetUInt32(statbuf, 12)
        Deallocate(statbuf, 144)
    }
}

Function.SameAsRoot {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(4, path, statbuf)
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        d0 = GetUInt32(statbuf, 0)
        d1 = GetUInt32(statbuf, 4)
        i0 = GetUInt32(statbuf, 8)
        i1 = GetUInt32(statbuf, 12)
        Deallocate(statbuf, 144)
        match = 0
        IfCondition EqualTo(d0, ChgrpConfig.root_dev0) ThenBlock: {
            IfCondition EqualTo(d1, ChgrpConfig.root_dev1) ThenBlock: {
                IfCondition EqualTo(i0, ChgrpConfig.root_ino0) ThenBlock: {
                    IfCondition EqualTo(i1, ChgrpConfig.root_ino1) ThenBlock: {
                        match = 1
                    }
                }
            }
        }
        ReturnValue(match)
    }
}

Function.WarnRoot {
    Input: path: Address
    Body: {
        slash = 0
        IfCondition EqualTo(RDMEM_8(path, 0), 47) ThenBlock: {
            IfCondition EqualTo(RDMEM_8(path, 1), 0) ThenBlock: {
                slash = 1
            }
        }
        IfCondition EqualTo(slash, 1) ThenBlock: {
            WriteErrStr("chgrp: it is dangerous to operate recursively on '/'\n")
        } ElseBlock: {
            WriteErrStr("chgrp: it is dangerous to operate recursively on '")
            plen = GetStringLength(path)
            WriteStderr(path, plen)
            WriteErrStr("' (same as '/')\n")
        }
        WriteErrStr("chgrp: use --no-preserve-root to override this failsafe\n")
    }
}

Function.ChgrpWalk {
    Input: path: Address
    Input: gid: Integer
    Input: follow: Integer
    Input: depth: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(depth, 32) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(ChgrpConfig.recurse, 0) ThenBlock: {
            ReturnValue(ChangeGroup(path, gid, ChgrpConfig.no_dereference))
        }

        kind = PathKind(path)
        nofollow = 1
        descend = 0
        IfCondition EqualTo(kind, 2) ThenBlock: {
            descend = 1
        }
        IfCondition EqualTo(kind, 1) ThenBlock: {
            IfCondition EqualTo(follow, 1) ThenBlock: {
                nofollow = 0
                is_target_dir = IsStatDir(path)
                IfCondition EqualTo(is_target_dir, 1) ThenBlock: {
                    descend = 1
                }
            }
            IfCondition EqualTo(follow, 2) ThenBlock: {
                nofollow = 0
            }
        }
        IfCondition EqualTo(kind, 0) ThenBlock: {
            nofollow = ChgrpConfig.no_dereference
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            nofollow = ChgrpConfig.no_dereference
        }

        IfCondition EqualTo(ChgrpConfig.preserve_root, 1) ThenBlock: {
            IfCondition EqualTo(RDMEM_8(path, 0), 47) ThenBlock: {
                IfCondition EqualTo(RDMEM_8(path, 1), 0) ThenBlock: {
                    WarnRoot(path)
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(descend, 1) ThenBlock: {
                is_root = SameAsRoot(path)
                IfCondition EqualTo(is_root, 1) ThenBlock: {
                    WarnRoot(path)
                    ReturnValue(1)
                }
            }
        }

        err = ChangeGroup(path, gid, nofollow)
        IfCondition EqualTo(descend, 0) ThenBlock: {
            ReturnValue(err)
        }

        fd = SystemCall(2, path, 65536)
        IfCondition LessThan(fd, 0) ThenBlock: {
            IfCondition EqualTo(ChgrpConfig.silent, 0) ThenBlock: {
                open_err = Subtract(0, fd)
                WriteStderr("chgrp: cannot read directory '", 30)
                WriteStderr(path, GetStringLength(path))
                WriteStderr("': ", 3)
                IfCondition EqualTo(open_err, 2) ThenBlock: {
                    WriteStderr("No such file or directory\n", 26)
                } ElseBlock: {
                    WriteStderr("Permission denied\n", 18)
                }
            }
            ReturnValue(1)
        }

        buffer = Allocate(4096)
        WhileLoop 1 {
            nread = SystemCall(217, fd, buffer, 4096)
            IfCondition LessEqual(nread, 0) ThenBlock: {
                BreakLoop
            }
            offset = 0
            WhileLoop LessThan(offset, nread) {
                reclen_lo = RDMEM_8(buffer, Add(offset, 16))
                reclen_hi = RDMEM_8(buffer, Add(offset, 17))
                reclen = Add(reclen_lo, Multiply(reclen_hi, 256))
                IfCondition EqualTo(reclen, 0) ThenBlock: {
                    BreakLoop
                }

                skip = 0
                c0 = RDMEM_8(buffer, Add(offset, 19))
                IfCondition EqualTo(c0, 46) ThenBlock: {
                    c1 = RDMEM_8(buffer, Add(offset, 20))
                    IfCondition EqualTo(c1, 0) ThenBlock: {
                        skip = 1
                    }
                    IfCondition EqualTo(c1, 46) ThenBlock: {
                        c2 = RDMEM_8(buffer, Add(offset, 21))
                        IfCondition EqualTo(c2, 0) ThenBlock: {
                            skip = 1
                        }
                    }
                }

                IfCondition EqualTo(skip, 0) ThenBlock: {
                    name_len = 0
                    WhileLoop LessThan(name_len, 256) {
                        nc = RDMEM_8(buffer, Add(Add(offset, 19), name_len))
                        IfCondition EqualTo(nc, 0) ThenBlock: {
                            BreakLoop
                        }
                        name_len = Add(name_len, 1)
                    }
                    name_buf = Allocate(Add(name_len, 1))
                    ni = 0
                    WhileLoop LessThan(ni, name_len) {
                        nc = RDMEM_8(buffer, Add(Add(offset, 19), ni))
                        WRMEM_8(name_buf, ni, nc)
                        ni = Add(ni, 1)
                    }
                    WRMEM_8(name_buf, name_len, 0)
                    child = BuildChild(path, name_buf)
                    Deallocate(name_buf, Add(name_len, 1))
                    child_follow = 0
                    IfCondition EqualTo(ChgrpConfig.traverse, 2) ThenBlock: {
                        child_follow = 1
                    }
                    IfCondition EqualTo(ChgrpConfig.traverse, 1) ThenBlock: {
                        child_follow = 2
                    }
                    child_err = ChgrpWalk(child, gid, child_follow, Add(depth, 1))
                    Deallocate(child, 0)
                    IfCondition NotEqual(child_err, 0) ThenBlock: {
                        err = 1
                    }
                }

                offset = Add(offset, reclen)
            }
        }

        SystemCall(3, fd)
        Deallocate(buffer, 4096)
        ReturnValue(err)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        ReturnValue(buffer)
    }
}

SubRoutine.Main {
    args_buffer = GetArgs()
    
    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        WriteStderr("chgrp: cannot read arguments\n", 29)
        SystemCall(60, 1)
    }
    
    // Skip program name
    pos = 0
    WhileLoop NotEqual(RDMEM_8(args_buffer, pos), 0) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)
    
    gid = -1
    saw_group = 0
    options_done = 0
    files = Allocate(512)
    file_count = 0
    
    WhileLoop LessThan(pos, 4096) {
        ch = RDMEM_8(args_buffer, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            nxt = RDMEM_8(args_buffer, Add(pos, 1))
            IfCondition EqualTo(nxt, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition EqualTo(options_done, 0) ThenBlock: {
                IfCondition EqualTo(saw_group, 0) ThenBlock: {
                    IfCondition EqualTo(ChgrpConfig.use_reference, 0) ThenBlock: {
                        saw_group = 1
                        gid = -1
                        pos = Add(pos, 1)
                        ContinueLoop
                    }
                }
            }
            pos = Add(pos, 1)
            ContinueLoop
        }
        
        arg_at = pos
        arg_len = 0
        WhileLoop NotEqual(RDMEM_8(args_buffer, pos), 0) {
            arg_len = Add(arg_len, 1)
            pos = Add(pos, 1)
        }
        arg = CopyAt(args_buffer, arg_at)
        pos = Add(pos, 1)
        
        is_opt = 0
        IfCondition EqualTo(options_done, 0) ThenBlock: {
            IfCondition EqualTo(RDMEM_8(arg, 0), 45) ThenBlock: {
                IfCondition GreaterThan(arg_len, 1) ThenBlock: {
                    is_opt = 1
                }
            }
        }
        
        IfCondition EqualTo(is_opt, 1) ThenBlock: {
            IfCondition EqualTo(RDMEM_8(arg, 1), 45) ThenBlock: {
                IfCondition EqualTo(arg_len, 2) ThenBlock: {
                    options_done = 1
                }
                IfCondition EqualTo(StringCompareN(arg, "--reference=", 12), 0) ThenBlock: {
                    ref_path = CopyAt(arg, 12)
                    gid = RefGid(ref_path)
                    Deallocate(ref_path, 0)
                    IfCondition EqualTo(gid, -2) ThenBlock: {
                        Deallocate(args_buffer, 4096)
                        SystemCall(60, 1)
                    }
                    ChgrpConfig.use_reference = 1
                    saw_group = 1
                }
                IfCondition EqualTo(arg_len, 11) ThenBlock: {
                    IfCondition EqualTo(StringCompareN(arg, "--recursive", 11), 0) ThenBlock: {
                        ChgrpConfig.recurse = 1
                    }
                }
                IfCondition EqualTo(arg_len, 13) ThenBlock: {
                    IfCondition EqualTo(StringCompareN(arg, "--dereference", 13), 0) ThenBlock: {
                        ChgrpConfig.no_dereference = 0
                        ChgrpConfig.explicit_deref = 1
                    }
                }
                IfCondition EqualTo(arg_len, 16) ThenBlock: {
                    IfCondition EqualTo(StringCompareN(arg, "--no-dereference", 16), 0) ThenBlock: {
                        ChgrpConfig.no_dereference = 1
                        ChgrpConfig.explicit_deref = 1
                    }
                }
                IfCondition EqualTo(arg_len, 8) ThenBlock: {
                    IfCondition EqualTo(StringCompareN(arg, "--silent", 8), 0) ThenBlock: {
                        ChgrpConfig.silent = 1
                    }
                }
                IfCondition EqualTo(arg_len, 7) ThenBlock: {
                    IfCondition EqualTo(StringCompareN(arg, "--quiet", 7), 0) ThenBlock: {
                        ChgrpConfig.silent = 1
                    }
                }
                IfCondition EqualTo(arg_len, 15) ThenBlock: {
                    IfCondition EqualTo(StringCompareN(arg, "--preserve-root", 15), 0) ThenBlock: {
                        ChgrpConfig.preserve_root = 1
                    }
                }
                IfCondition EqualTo(arg_len, 18) ThenBlock: {
                    IfCondition EqualTo(StringCompareN(arg, "--no-preserve-root", 18), 0) ThenBlock: {
                        ChgrpConfig.preserve_root = 0
                    }
                }
            } ElseBlock: {
                opt_i = 1
                WhileLoop LessThan(opt_i, arg_len) {
                    opt_ch = RDMEM_8(arg, opt_i)
                    IfCondition EqualTo(opt_ch, 104) ThenBlock: {
                        ChgrpConfig.no_dereference = 1
                        ChgrpConfig.explicit_deref = 1
                    }
                    IfCondition EqualTo(opt_ch, 118) ThenBlock: {
                        ChgrpConfig.verbose = 1
                    }
                    IfCondition EqualTo(opt_ch, 102) ThenBlock: {
                        ChgrpConfig.silent = 1
                    }
                    IfCondition EqualTo(opt_ch, 82) ThenBlock: {
                        ChgrpConfig.recurse = 1
                    }
                    IfCondition EqualTo(opt_ch, 72) ThenBlock: {
                        ChgrpConfig.traverse = 1
                    }
                    IfCondition EqualTo(opt_ch, 76) ThenBlock: {
                        ChgrpConfig.traverse = 2
                    }
                    IfCondition EqualTo(opt_ch, 80) ThenBlock: {
                        ChgrpConfig.traverse = 0
                    }
                    opt_i = Add(opt_i, 1)
                }
            }
            Deallocate(arg, 0)
        } ElseBlock: {
            take_group = 0
            IfCondition EqualTo(saw_group, 0) ThenBlock: {
                IfCondition EqualTo(ChgrpConfig.use_reference, 0) ThenBlock: {
                    take_group = 1
                }
            }
            IfCondition EqualTo(take_group, 1) ThenBlock: {
                gid = ParseGroup(arg)
                IfCondition LessThan(gid, 0) ThenBlock: {
                    WriteStderr("chgrp: invalid group: '", 23)
                    WriteStderr(arg, arg_len)
                    WriteStderr("'\n", 2)
                    Deallocate(args_buffer, 4096)
                    SystemCall(60, 1)
                }
                saw_group = 1
                options_done = 1
                Deallocate(arg, 0)
            } ElseBlock: {
                IfCondition LessThan(file_count, 64) ThenBlock: {
                    WRMEM_64(files, Multiply(file_count, 8), arg)
                    file_count = Add(file_count, 1)
                }
                options_done = 1
            }
        }
    }
    
    IfCondition EqualTo(ChgrpConfig.recurse, 1) ThenBlock: {
        IfCondition EqualTo(ChgrpConfig.explicit_deref, 0) ThenBlock: {
            ChgrpConfig.no_dereference = 1
        }
        IfCondition EqualTo(ChgrpConfig.preserve_root, 1) ThenBlock: {
            LoadRoot()
        }
    }
    
    IfCondition EqualTo(saw_group, 0) ThenBlock: {
        WriteStderr("chgrp: missing operand\n", 23)
        WriteStderr("Try 'chgrp --help' for more information.\n", 42)
        Deallocate(args_buffer, 4096)
        SystemCall(60, 1)
    }
    
    IfCondition EqualTo(file_count, 0) ThenBlock: {
        WriteStderr("chgrp: missing operand after group\n", 35)
        Deallocate(args_buffer, 4096)
        SystemCall(60, 1)
    }
    
    errors = 0
    fi = 0
    WhileLoop LessThan(fi, file_count) {
        file_path = RDMEM_64(files, Multiply(fi, 8))
        top_follow = 0
        IfCondition GreaterThan(ChgrpConfig.traverse, 0) ThenBlock: {
            top_follow = 1
        }
        result = ChgrpWalk(file_path, gid, top_follow, 0)
        IfCondition NotEqual(result, 0) ThenBlock: {
            errors = 1
        }
        Deallocate(file_path, 0)
        fi = Add(fi, 1)
    }
    
    Deallocate(files, 512)
    Deallocate(args_buffer, 4096)
    
    IfCondition GreaterThan(errors, 0) ThenBlock: {
        SystemCall(60, 1)
    }
    
    SystemCall(60, 0)
}

RunTask(Main)