// chmod.ailang - Change file mode bits
// Usage: chmod [OPTION]... MODE FILE...
// GNU coreutils compatible

LibraryImport.Arena

FixedPool.ChmodConfig {
    "recursive": Initialize=0
    "verbose": Initialize=0
    "changes": Initialize=0
    "silent": Initialize=0
    "preserve_root": Initialize=1
    "surprise": Initialize=0
}

FixedPool.OctalInfo {
    "value": Initialize=0
    "digits": Initialize=0
}

FixedPool.SymMode {
    "idx": Initialize=0
    "mode": Initialize=0
    "who": Initialize=0
    "op": Initialize=0
    "perms": Initialize=0
    "xflag": Initialize=0
    "copy": Initialize=0
    "umask": Initialize=0
    "isdir": Initialize=0
    "fail": Initialize=0
    "mentioned": Initialize=0
    "mark": Initialize=0
}

FixedPool.ChmodRun {
    "got": Initialize=0
}

FixedPool.JoinBuf {
    "total": Initialize=0
    "pos": Initialize=0
}

FixedPool.ArgScan {
    "pos": Initialize=0
}

FixedPool.ChmodStats {
    "changed": Initialize=0
    "failed": Initialize=0
    "skipped": Initialize=0
}

// ============================================================================
// UTILITY FUNCTIONS
// ============================================================================

Function.WriteStdout {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 1, str, len)
    }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.WriteVerbose {
    Input: str: Address
    Body: {
        IfCondition EqualTo(ChmodConfig.verbose, 1) ThenBlock: {
            WriteStdout(str)
        }
    }
}

Function.WriteChange {
    Input: str: Address
    Body: {
        IfCondition EqualTo(ChmodConfig.changes, 1) ThenBlock: {
            WriteStdout(str)
        }
    }
}

Function.WriteError {
    Input: str: Address
    Body: {
        IfCondition EqualTo(ChmodConfig.silent, 0) ThenBlock: {
            WriteStderr(str)
        }
    }
}

Function.IntToString {
    Input: num: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(num, 0) ThenBlock: {
            str = Allocate(2)
            WRMEM_8(str, 0, 48)
            WRMEM_8(str, 1, 0)
            ReturnValue(str)
        }
        
        temp = num
        digits = 0
        WhileLoop GreaterThan(temp, 0) {
            temp = Divide(temp, 10)
            digits = Add(digits, 1)
        }
        
        str = Allocate(Add(digits, 1))
        
        i = Subtract(digits, 1)
        temp = num
        WhileLoop GreaterThan(temp, 0) {
            digit = Modulo(temp, 10)
            WRMEM_8(str, i, Add(48, digit))
            temp = Divide(temp, 10)
            i = Subtract(i, 1)
        }
        
        WRMEM_8(str, digits, 0)
        ReturnValue(str)
    }
}

// ============================================================================
// MODE PARSING
// ============================================================================

Function.ParseOctalMode {
    Input: mode_str: Address
    Output: Integer
    Body: {
        OctalInfo.value = 0
        OctalInfo.digits = 0

        WhileLoop 1 {
            digit = RDMEM_8(mode_str, OctalInfo.digits)

            IfCondition EqualTo(digit, 0) ThenBlock: {
                BreakLoop
            }

            IfCondition Or(LessThan(digit, 48), GreaterThan(digit, 55)) ThenBlock: {
                ReturnValue(-1)
            }

            OctalInfo.value = Multiply(OctalInfo.value, 8)
            OctalInfo.value = Add(OctalInfo.value, Subtract(digit, 48))

            IfCondition GreaterThan(OctalInfo.value, 4095) ThenBlock: {
                ReturnValue(-1)
            }

            OctalInfo.digits = Add(OctalInfo.digits, 1)
        }

        IfCondition EqualTo(OctalInfo.digits, 0) ThenBlock: {
            ReturnValue(-1)
        }

        ReturnValue(OctalInfo.value)
    }
}

Function.LoadCurrent {
    Input: current_mode: Integer
    Body: {
        SymMode.mode = BitwiseAnd(current_mode, 4095)
        SymMode.isdir = 0
        kind = BitwiseAnd(current_mode, 61440)
        IfCondition EqualTo(kind, 16384) ThenBlock: {
            SymMode.isdir = 1
        }
    }
}

Function.NoteMentioned {
    Body: {
        IfCondition NotEqual(SymMode.who, 0) ThenBlock: {
            SymMode.mentioned = BitwiseAnd(SymMode.who, SymMode.perms)
        } ElseBlock: {
            SymMode.mentioned = SymMode.perms
        }
    }
}

Function.ReadWho {
    Input: mode_str: Address
    Body: {
        SymMode.who = 0
        WhileLoop 1 {
            SymMode.mark = RDMEM_8(mode_str, SymMode.idx)
            ate = 0
            IfCondition EqualTo(SymMode.mark, 117) ThenBlock: {
                SymMode.who = BitwiseOr(SymMode.who, 2496)
                ate = 1
            }
            IfCondition EqualTo(SymMode.mark, 103) ThenBlock: {
                SymMode.who = BitwiseOr(SymMode.who, 1080)
                ate = 1
            }
            IfCondition EqualTo(SymMode.mark, 111) ThenBlock: {
                SymMode.who = BitwiseOr(SymMode.who, 519)
                ate = 1
            }
            IfCondition EqualTo(SymMode.mark, 97) ThenBlock: {
                SymMode.who = 4095
                ate = 1
            }
            IfCondition EqualTo(ate, 0) ThenBlock: {
                BreakLoop
            }
            SymMode.idx = Add(SymMode.idx, 1)
        }
        SymMode.fail = 1
        IfCondition EqualTo(SymMode.mark, 43) ThenBlock: {
            SymMode.fail = 0
        }
        IfCondition EqualTo(SymMode.mark, 45) ThenBlock: {
            SymMode.fail = 0
        }
        IfCondition EqualTo(SymMode.mark, 61) ThenBlock: {
            SymMode.fail = 0
        }
    }
}

Function.ReadOp {
    Input: mode_str: Address
    Output: Integer
    Body: {
        SymMode.op = RDMEM_8(mode_str, SymMode.idx)
        SymMode.idx = Add(SymMode.idx, 1)
        SymMode.perms = 0
        SymMode.xflag = 0
        SymMode.copy = 0
        SymMode.mentioned = 0
        SymMode.mark = RDMEM_8(mode_str, SymMode.idx)

        digit_ok = 0
        IfCondition GreaterEqual(SymMode.mark, 48) ThenBlock: {
            IfCondition LessEqual(SymMode.mark, 55) ThenBlock: {
                digit_ok = 1
            }
        }

        IfCondition EqualTo(digit_ok, 1) ThenBlock: {
            IfCondition NotEqual(SymMode.who, 0) ThenBlock: {
                SymMode.fail = 1
                ReturnValue(0)
            }
            WhileLoop 1 {
                SymMode.mark = RDMEM_8(mode_str, SymMode.idx)
                digit_ok = 0
                IfCondition GreaterEqual(SymMode.mark, 48) ThenBlock: {
                    IfCondition LessEqual(SymMode.mark, 55) ThenBlock: {
                        digit_ok = 1
                    }
                }
                IfCondition EqualTo(digit_ok, 0) ThenBlock: {
                    BreakLoop
                }
                SymMode.perms = Multiply(SymMode.perms, 8)
                SymMode.perms = Add(SymMode.perms, Subtract(SymMode.mark, 48))
                IfCondition GreaterThan(SymMode.perms, 4095) ThenBlock: {
                    SymMode.fail = 1
                    ReturnValue(0)
                }
                SymMode.idx = Add(SymMode.idx, 1)
            }
            SymMode.mark = RDMEM_8(mode_str, SymMode.idx)
            bad = 1
            IfCondition EqualTo(SymMode.mark, 0) ThenBlock: { bad = 0 }
            IfCondition EqualTo(SymMode.mark, 44) ThenBlock: { bad = 0 }
            IfCondition EqualTo(SymMode.mark, 43) ThenBlock: { bad = 0 }
            IfCondition EqualTo(SymMode.mark, 45) ThenBlock: { bad = 0 }
            IfCondition EqualTo(SymMode.mark, 61) ThenBlock: { bad = 0 }
            IfCondition EqualTo(bad, 1) ThenBlock: {
                SymMode.fail = 1
                ReturnValue(0)
            }
            SymMode.who = 4095
            SymMode.mentioned = 4095
            ReturnValue(0)
        }

        IfCondition EqualTo(SymMode.mark, 117) ThenBlock: {
            SymMode.perms = 448
            SymMode.copy = 1
            SymMode.idx = Add(SymMode.idx, 1)
            NoteMentioned()
            ReturnValue(0)
        }
        IfCondition EqualTo(SymMode.mark, 103) ThenBlock: {
            SymMode.perms = 56
            SymMode.copy = 1
            SymMode.idx = Add(SymMode.idx, 1)
            NoteMentioned()
            ReturnValue(0)
        }
        IfCondition EqualTo(SymMode.mark, 111) ThenBlock: {
            SymMode.perms = 7
            SymMode.copy = 1
            SymMode.idx = Add(SymMode.idx, 1)
            NoteMentioned()
            ReturnValue(0)
        }

        WhileLoop 1 {
            SymMode.mark = RDMEM_8(mode_str, SymMode.idx)
            ate = 0
            IfCondition EqualTo(SymMode.mark, 114) ThenBlock: {
                SymMode.perms = BitwiseOr(SymMode.perms, 292)
                ate = 1
            }
            IfCondition EqualTo(SymMode.mark, 119) ThenBlock: {
                SymMode.perms = BitwiseOr(SymMode.perms, 146)
                ate = 1
            }
            IfCondition EqualTo(SymMode.mark, 120) ThenBlock: {
                SymMode.perms = BitwiseOr(SymMode.perms, 73)
                ate = 1
            }
            IfCondition EqualTo(SymMode.mark, 88) ThenBlock: {
                SymMode.xflag = 1
                ate = 1
            }
            IfCondition EqualTo(SymMode.mark, 115) ThenBlock: {
                SymMode.perms = BitwiseOr(SymMode.perms, 3072)
                ate = 1
            }
            IfCondition EqualTo(SymMode.mark, 116) ThenBlock: {
                SymMode.perms = BitwiseOr(SymMode.perms, 512)
                ate = 1
            }
            IfCondition EqualTo(ate, 0) ThenBlock: {
                BreakLoop
            }
            SymMode.idx = Add(SymMode.idx, 1)
        }
        NoteMentioned()
        ReturnValue(0)
    }
}

Function.ApplyOp {
    Body: {
        IfCondition EqualTo(SymMode.copy, 1) ThenBlock: {
            isolated = BitwiseAnd(SymMode.perms, SymMode.mode)
            spread = 0
            IfCondition NotEqual(BitwiseAnd(isolated, 292), 0) ThenBlock: {
                spread = BitwiseOr(spread, 292)
            }
            IfCondition NotEqual(BitwiseAnd(isolated, 146), 0) ThenBlock: {
                spread = BitwiseOr(spread, 146)
            }
            IfCondition NotEqual(BitwiseAnd(isolated, 73), 0) ThenBlock: {
                spread = BitwiseOr(spread, 73)
            }
            SymMode.perms = spread
        }

        IfCondition EqualTo(SymMode.xflag, 1) ThenBlock: {
            wantx = SymMode.isdir
            IfCondition NotEqual(BitwiseAnd(SymMode.mode, 73), 0) ThenBlock: {
                wantx = 1
            }
            IfCondition EqualTo(wantx, 1) ThenBlock: {
                SymMode.perms = BitwiseOr(SymMode.perms, 73)
            }
        }

        omit = 0
        IfCondition EqualTo(SymMode.isdir, 1) ThenBlock: {
            omit = BitwiseAnd(3072, BitwiseNot(SymMode.mentioned))
        }

        limit = BitwiseAnd(BitwiseNot(SymMode.umask), 4095)
        IfCondition NotEqual(SymMode.who, 0) ThenBlock: {
            limit = SymMode.who
        }
        limit = BitwiseAnd(limit, BitwiseNot(omit))
        limit = BitwiseAnd(limit, 4095)
        SymMode.perms = BitwiseAnd(SymMode.perms, limit)

        IfCondition EqualTo(SymMode.op, 43) ThenBlock: {
            SymMode.mode = BitwiseOr(SymMode.mode, SymMode.perms)
        }
        IfCondition EqualTo(SymMode.op, 45) ThenBlock: {
            cleared = BitwiseAnd(BitwiseNot(SymMode.perms), 4095)
            SymMode.mode = BitwiseAnd(SymMode.mode, cleared)
        }
        IfCondition EqualTo(SymMode.op, 61) ThenBlock: {
            preserved = omit
            IfCondition NotEqual(SymMode.who, 0) ThenBlock: {
                preserved = BitwiseAnd(BitwiseNot(SymMode.who), 4095)
                preserved = BitwiseOr(preserved, omit)
            }
            kept = BitwiseAnd(SymMode.mode, preserved)
            SymMode.mode = BitwiseOr(kept, SymMode.perms)
        }
    }
}

Function.ParseSymbolicMode {
    Input: mode_str: Address
    Input: current_mode: Integer
    Input: umask_value: Integer
    Output: Integer
    Body: {
        LoadCurrent(current_mode)
        SymMode.umask = umask_value
        SymMode.idx = 0
        SymMode.fail = 0

        WhileLoop 1 {
            ReadWho(mode_str)
            IfCondition EqualTo(SymMode.fail, 1) ThenBlock: {
                ReturnValue(-1)
            }
            WhileLoop 1 {
                ReadOp(mode_str)
                IfCondition EqualTo(SymMode.fail, 1) ThenBlock: {
                    ReturnValue(-1)
                }
                ApplyOp()
                SymMode.mark = RDMEM_8(mode_str, SymMode.idx)
                again = 0
                IfCondition EqualTo(SymMode.mark, 43) ThenBlock: { again = 1 }
                IfCondition EqualTo(SymMode.mark, 45) ThenBlock: { again = 1 }
                IfCondition EqualTo(SymMode.mark, 61) ThenBlock: { again = 1 }
                IfCondition EqualTo(again, 0) ThenBlock: {
                    BreakLoop
                }
            }
            SymMode.mark = RDMEM_8(mode_str, SymMode.idx)
            IfCondition EqualTo(SymMode.mark, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition NotEqual(SymMode.mark, 44) ThenBlock: {
                ReturnValue(-1)
            }
            SymMode.idx = Add(SymMode.idx, 1)
        }

        ReturnValue(SymMode.mode)
    }
}

Function.AdjustOctal {
    Input: current_mode: Integer
    Output: Integer
    Body: {
        LoadCurrent(current_mode)
        SymMode.who = 4095
        SymMode.op = 61
        SymMode.perms = OctalInfo.value
        SymMode.copy = 0
        SymMode.xflag = 0
        SymMode.umask = 0
        special = BitwiseAnd(OctalInfo.value, 3072)
        SymMode.mentioned = 4095
        IfCondition LessThan(OctalInfo.digits, 5) ThenBlock: {
            SymMode.mentioned = BitwiseOr(special, 1023)
        }
        ApplyOp()
        ReturnValue(SymMode.mode)
    }
}

Function.CheckSurprise {
    Input: mode_str: Address
    Input: current_mode: Integer
    Output: Integer
    Body: {
        naive = ParseSymbolicMode(mode_str, current_mode, 0)
        extra = BitwiseAnd(ChmodRun.got, BitwiseNot(naive))
        extra = BitwiseAnd(extra, 4095)
        ReturnValue(extra)
    }
}

// ============================================================================
// FILE OPERATIONS
// ============================================================================

Function.GetFileMode {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(4, path, statbuf)
        
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(result)
        }
        
        mode = RDMEM_64(statbuf, 24)
        Deallocate(statbuf, 144)
        ReturnValue(mode)
    }
}

Function.FormatMode {
    Input: mode: Integer
    Output: Address
    Body: {
        // Extract permission bits only (0777)
        perms = BitwiseAnd(mode, 511)
        
        buffer = Allocate(4)
        
        // User permissions (bits 6-8): 0700 = 448
        user = BitwiseAnd(perms, 448)
        user = Divide(user, 64)
        WRMEM_8(buffer, 0, Add(48, user))
        
        // Group permissions (bits 3-5): 0070 = 56
        group = BitwiseAnd(perms, 56)
        group = Divide(group, 8)
        WRMEM_8(buffer, 1, Add(48, group))
        
        // Other permissions (bits 0-2): 0007 = 7
        other = BitwiseAnd(perms, 7)
        WRMEM_8(buffer, 2, Add(48, other))
        
        WRMEM_8(buffer, 3, 0)
        ReturnValue(buffer)
    }
}

// lstat kind: 2 symlink, 1 directory, 0 anything else.
Function.PathKind {
    Input: path: Address
    Output: Integer
    Body: {
        st = Allocate(144)
        rc = SystemCall(6, path, st)
        IfCondition LessThan(rc, 0) ThenBlock: {
            Deallocate(st, 144)
            ReturnValue(0)
        }
        mode = RDMEM_64(st, 24)
        Deallocate(st, 144)
        kind = BitwiseAnd(mode, 61440)
        IfCondition EqualTo(kind, 40960) ThenBlock: {
            ReturnValue(2)
        }
        IfCondition EqualTo(kind, 16384) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.IsDirectory {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(4, path, statbuf)
        
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        
        mode = RDMEM_64(statbuf, 24)
        Deallocate(statbuf, 144)
        
        file_type = BitwiseAnd(mode, 61440)  // S_IFMT
        ReturnValue(EqualTo(file_type, 16384))  // S_IFDIR
    }
}

Function.ChmodFile {
    Input: path: Address
    Input: new_mode: Integer
    Output: Integer
    Body: {
        lbuf = Allocate(144)
        lres = SystemCall(6, path, lbuf)
        is_link = 0
        IfCondition GreaterEqual(lres, 0) ThenBlock: {
            lmode = RDMEM_64(lbuf, 24)
            kind = BitwiseAnd(lmode, 61440)
            IfCondition EqualTo(kind, 40960) ThenBlock: {
                is_link = 1
            }
        }
        Deallocate(lbuf, 144)

        IfCondition EqualTo(is_link, 1) ThenBlock: {
            sbuf = Allocate(144)
            sres = SystemCall(4, path, sbuf)
            Deallocate(sbuf, 144)
            IfCondition LessThan(sres, 0) ThenBlock: {
                WriteError("chmod: cannot operate on dangling symlink '")
                WriteError(path)
                WriteError("'\n")
                ChmodStats.failed = Add(ChmodStats.failed, 1)
                ReturnValue(1)
            }
        }

        old_mode = GetFileMode(path)
        
        IfCondition LessThan(old_mode, 0) ThenBlock: {
            err = Subtract(0, old_mode)
            WriteError("chmod: cannot access '")
            WriteError(path)
            WriteError("': ")
            IfCondition EqualTo(err, 13) ThenBlock: {
                WriteError("Permission denied\n")
            } ElseBlock: {
                IfCondition EqualTo(err, 2) ThenBlock: {
                    WriteError("No such file or directory\n")
                } ElseBlock: {
                    WriteError("Unknown error\n")
                }
            }
            ChmodStats.failed = Add(ChmodStats.failed, 1)
            ReturnValue(1)
        }
        
        // Permission bits include setuid, setgid, and sticky (07777).
        old_perms = BitwiseAnd(old_mode, 4095)
        new_perms = BitwiseAnd(new_mode, 4095)
        
        IfCondition EqualTo(old_perms, new_perms) ThenBlock: {
            WriteVerbose("mode of '")
            WriteVerbose(path)
            WriteVerbose("' retained as ")
            
            mode_str = FormatMode(old_mode)
            WriteVerbose(mode_str)
            WriteVerbose("\n")
            Deallocate(mode_str, 4)
            
            ChmodStats.skipped = Add(ChmodStats.skipped, 1)
            ReturnValue(0)
        }
        
        // IMPORTANT: Preserve file type bits, only change permissions
        // Keep upper bits from old_mode, use new permission bits
        file_type = BitwiseAnd(old_mode, 61440)  // S_IFMT mask  
        final_mode = BitwiseOr(file_type, new_perms)
        
        // Call chmod syscall with combined mode
        // chmod(path, mode) - syscall 90
        result = SystemCall(90, path, final_mode)
        
        IfCondition LessThan(result, 0) ThenBlock: {
            err = Subtract(0, result)
            WriteError("chmod: changing permissions of '")
            WriteError(path)
            WriteError("': ")
            IfCondition EqualTo(err, 13) ThenBlock: {
                WriteError("Permission denied\n")
            } ElseBlock: {
                WriteError("Operation not permitted\n")
            }
            ChmodStats.failed = Add(ChmodStats.failed, 1)
            ReturnValue(1)
        }
        
        // Report change
        WriteChange("mode of '")
        WriteChange(path)
        WriteChange("' changed from ")
        
        old_str = FormatMode(old_mode)
        WriteChange(old_str)
        Deallocate(old_str, 4)
        
        WriteChange(" to ")
        
        new_str = FormatMode(final_mode)
        WriteChange(new_str)
        WriteChange("\n")
        Deallocate(new_str, 4)
        
        ChmodStats.changed = Add(ChmodStats.changed, 1)
        ReturnValue(0)
    }
}

Function.BuildPath {
    Input: dir: Address
    Input: name: Address
    Output: Address
    Body: {
        dir_len = StringLength(dir)
        name_len = StringLength(name)
        
        needs_slash = 1
        IfCondition GreaterThan(dir_len, 0) ThenBlock: {
            last_char = RDMEM_8(dir, Subtract(dir_len, 1))
            IfCondition EqualTo(last_char, 47) ThenBlock: {
                needs_slash = 0
            }
        }
        
        total_len = Add(Add(dir_len, name_len), Add(needs_slash, 1))
        path = Allocate(total_len)
        
        // Copy directory
        i = 0
        WhileLoop LessThan(i, dir_len) {
            WRMEM_8(path, i, RDMEM_8(dir, i))
            i = Add(i, 1)
        }
        
        // Add slash if needed
        IfCondition EqualTo(needs_slash, 1) ThenBlock: {
            WRMEM_8(path, i, 47)
            i = Add(i, 1)
        }
        
        // Copy filename
        j = 0
        WhileLoop LessThan(j, name_len) {
            WRMEM_8(path, i, RDMEM_8(name, j))
            i = Add(i, 1)
            j = Add(j, 1)
        }
        
        WRMEM_8(path, i, 0)
        ReturnValue(path)
    }
}

// ============================================================================
// RECURSIVE CHMOD
// ============================================================================

Function.ChmodRecursive {
    Input: path: Address
    Input: mode: Integer
    Output: Integer
    Body: {
        // Check for preserve-root safety BEFORE opening
        IfCondition EqualTo(ChmodConfig.preserve_root, 1) ThenBlock: {
            first_char = RDMEM_8(path, 0)
            second_char = RDMEM_8(path, 1)
            
            // Check if path is exactly "/"
            IfCondition EqualTo(first_char, 47) ThenBlock: {  // '/'
                IfCondition EqualTo(second_char, 0) ThenBlock: {
                    WriteError("chmod: it is dangerous to operate recursively on '/'\n")
                    WriteError("chmod: use --no-preserve-root to override this failsafe\n")
                    ReturnValue(1)
                }
            }
        }
        
        // Open directory with O_RDONLY | O_DIRECTORY flags
        // O_RDONLY = 0, O_DIRECTORY = 0x10000 (65536)
        fd = SystemCall(2, path, 65536)
        walk_errors = 0
        did_fix = 0

        // Mode 0 blocks the read. chmod the directory, then reopen so
        // children are updated. A still-unreadable directory is not walked.
        IfCondition LessThan(fd, 0) ThenBlock: {
            open_err = Subtract(0, fd)
            IfCondition EqualTo(open_err, 13) ThenBlock: {
                fixed = ChmodFile(path, mode)
                did_fix = 1
                IfCondition EqualTo(fixed, 0) ThenBlock: {
                    fd = SystemCall(2, path, 65536)
                }
            }
        }

        IfCondition LessThan(fd, 0) ThenBlock: {
            open_err = Subtract(0, fd)
            WriteError("chmod: cannot read directory '")
            WriteError(path)
            WriteError("': ")
            IfCondition EqualTo(open_err, 13) ThenBlock: {
                WriteError("Permission denied\n")
            } ElseBlock: {
                IfCondition EqualTo(open_err, 2) ThenBlock: {
                    WriteError("No such file or directory\n")
                } ElseBlock: {
                    WriteError("Unknown error\n")
                }
            }
            IfCondition EqualTo(did_fix, 0) ThenBlock: {
                ChmodFile(path, mode)
            }
            ReturnValue(1)
        }
        
        // Allocate buffer for directory entries
        buffer = Allocate(4096)
        
        // CRITICAL: getdents64 may not return all entries in one call!
        // We must loop until it returns 0 (end of directory)
        WhileLoop 1 {
            // Read a batch of directory entries
            // syscall 217 = getdents64(fd, buffer, count)
            nread = SystemCall(217, fd, buffer, 4096)
            
            // If nread <= 0, we've read all entries (or error occurred)
            IfCondition LessEqual(nread, 0) ThenBlock: {
                BreakLoop
            }
            
            // Process all entries in this batch
            offset = 0
            
            WhileLoop LessThan(offset, nread) {
                entry = Add(buffer, offset)
                
                // Parse linux_dirent64 structure:
                // struct linux_dirent64 {
                //     u64 d_ino;           // offset 0  (8 bytes)
                //     i64 d_off;           // offset 8  (8 bytes)
                //     u16 d_reclen;        // offset 16 (2 bytes) <- THIS ONE
                //     u8  d_type;          // offset 18 (1 byte)
                //     char d_name[];       // offset 19 (variable)
                // }
                
                // Read d_reclen (2 bytes, little-endian)
                reclen_lo = RDMEM_8(entry, 16)
                reclen_hi = RDMEM_8(entry, 17)
                reclen = Add(reclen_lo, Multiply(reclen_hi, 256))
                
                // Read d_type
                d_type = RDMEM_8(entry, 18)
                
                // Get pointer to d_name (null-terminated string)
                name = Add(entry, 19)
                
                // Skip "." and ".." entries
                skip = 0
                first_char = RDMEM_8(name, 0)
                
                IfCondition EqualTo(first_char, 46) ThenBlock: {  // '.' character
                    second_char = RDMEM_8(name, 1)
                    
                    // Check for "." (single dot)
                    IfCondition EqualTo(second_char, 0) ThenBlock: {
                        skip = 1
                    } ElseBlock: {
                        // Check for ".." (double dot)
                        IfCondition EqualTo(second_char, 46) ThenBlock: {
                            third_char = RDMEM_8(name, 2)
                            IfCondition EqualTo(third_char, 0) ThenBlock: {
                                skip = 1
                            }
                        }
                    }
                }
                
                // Process non-dot entries
                IfCondition EqualTo(skip, 0) ThenBlock: {
                    // Build full path: parent/child
                    full_path = BuildPath(path, name)

                    // -R does not follow symlinks (GNU default -P).
                    // d_type 10 is a symlink, 4 is a directory, 0 is unknown.
                    ekind = 0
                    IfCondition EqualTo(d_type, 10) ThenBlock: {
                        ekind = 2
                    }
                    IfCondition EqualTo(d_type, 4) ThenBlock: {
                        ekind = 1
                    }
                    IfCondition EqualTo(d_type, 0) ThenBlock: {
                        ekind = PathKind(full_path)
                    }
                    
                    child_result = 0
                    IfCondition EqualTo(ekind, 2) ThenBlock: {
                        child_result = 0
                    } ElseBlock: {
                        IfCondition EqualTo(ekind, 1) ThenBlock: {
                            child_result = ChmodRecursive(full_path, mode)
                        } ElseBlock: {
                            child_result = ChmodFile(full_path, mode)
                        }
                    }
                    IfCondition NotEqual(child_result, 0) ThenBlock: {
                        walk_errors = 1
                    }
                    
                    // Clean up the allocated path
                    Deallocate(full_path, 0)
                }
                
                // Move to next entry
                offset = Add(offset, reclen)
            }
            
            // IMPORTANT: Loop continues here!
            // This will call getdents64 again to get the next batch
            // Only breaks when getdents64 returns 0 (no more entries)
        }
        
        // Clean up
        SystemCall(3, fd)  // close(fd)
        Deallocate(buffer, 4096)
        
        // CRITICAL: chmod the directory itself AFTER processing contents
        // This ensures we can still read the directory while recursing
        result = ChmodFile(path, mode)
        IfCondition NotEqual(result, 0) ThenBlock: {
            walk_errors = 1
        }
        
        ReturnValue(walk_errors)
    }
}

Function.ProcessPath {
    Input: path: Address
    Input: mode: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ChmodConfig.recursive, 1) ThenBlock: {
            top = PathKind(path)
            IfCondition EqualTo(top, 2) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(top, 1) ThenBlock: {
                ReturnValue(ChmodRecursive(path, mode))
            }
        }
        
        ReturnValue(ChmodFile(path, mode))
    }
}

// ============================================================================
// HELP
// ============================================================================

Function.ShowHelp {
    Body: {
        WriteStdout("Usage: chmod [OPTION]... MODE FILE...\n")
        WriteStdout("Change the mode of each FILE to MODE.\n\n")
        WriteStdout("Options:\n")
        WriteStdout("  -c, --changes          like verbose but report only when a change is made\n")
        WriteStdout("  -f, --silent, --quiet  suppress most error messages\n")
        WriteStdout("  -v, --verbose          output a diagnostic for every file processed\n")
        WriteStdout("  -R, --recursive        change files and directories recursively\n")
        WriteStdout("      --preserve-root    fail to operate recursively on '/'\n")
        WriteStdout("      --no-preserve-root do not treat '/' specially (the default)\n")
        WriteStdout("  -h, --help             display this help and exit\n\n")
        WriteStdout("MODE can be:\n")
        WriteStdout("  Octal: 0755, 644, etc.\n")
        WriteStdout("  Symbolic: u+x, go-w, a=r, etc.\n\n")
        WriteStdout("Examples:\n")
        WriteStdout("  chmod 755 file.txt      Set rwxr-xr-x permissions\n")
        WriteStdout("  chmod u+x script.sh     Add execute for user\n")
        WriteStdout("  chmod go-w file.txt     Remove write for group and others\n")
        WriteStdout("  chmod -R 755 directory  Recursively set permissions\n")
    }
}

// ============================================================================
// ARGUMENT PARSING
// ============================================================================

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        ReturnValue(buffer)
    }
}

Function.StringCompare {
    Input: str1: Address
    Input: str2: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop 1 {
            ch1 = RDMEM_8(str1, i)
            ch2 = RDMEM_8(str2, i)
            
            IfCondition NotEqual(ch1, ch2) ThenBlock: {
                ReturnValue(0)
            }
            
            IfCondition EqualTo(ch1, 0) ThenBlock: {
                ReturnValue(1)
            }
            
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.IsRealFlags {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(RDMEM_8(str, 0), 45) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(RDMEM_8(str, 1), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(RDMEM_8(str, 1), 45) ThenBlock: {
            ReturnValue(0)
        }
        SymMode.idx = 1
        WhileLoop 1 {
            SymMode.mark = RDMEM_8(str, SymMode.idx)
            IfCondition EqualTo(SymMode.mark, 0) ThenBlock: {
                ReturnValue(1)
            }
            ok = 0
            IfCondition EqualTo(SymMode.mark, 82) ThenBlock: { ok = 1 }
            IfCondition EqualTo(SymMode.mark, 99) ThenBlock: { ok = 1 }
            IfCondition EqualTo(SymMode.mark, 102) ThenBlock: { ok = 1 }
            IfCondition EqualTo(SymMode.mark, 118) ThenBlock: { ok = 1 }
            IfCondition EqualTo(SymMode.mark, 104) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ok, 0) ThenBlock: {
                ReturnValue(0)
            }
            SymMode.idx = Add(SymMode.idx, 1)
        }
        ReturnValue(0)
    }
}

Function.HandleLong {
    Input: arg: Address
    Output: Integer
    Body: {
        IfCondition StringEquals(arg, "--help") ThenBlock: {
            ShowHelp()
            SystemCall(60, 0)
        }
        IfCondition StringEquals(arg, "--verbose") ThenBlock: {
            ChmodConfig.verbose = 1
            ReturnValue(0)
        }
        IfCondition StringEquals(arg, "--changes") ThenBlock: {
            ChmodConfig.changes = 1
            ReturnValue(0)
        }
        IfCondition StringEquals(arg, "--silent") ThenBlock: {
            ChmodConfig.silent = 1
            ReturnValue(0)
        }
        IfCondition StringEquals(arg, "--quiet") ThenBlock: {
            ChmodConfig.silent = 1
            ReturnValue(0)
        }
        IfCondition StringEquals(arg, "--recursive") ThenBlock: {
            ChmodConfig.recursive = 1
            ReturnValue(0)
        }
        IfCondition StringEquals(arg, "--preserve-root") ThenBlock: {
            ChmodConfig.preserve_root = 1
            ReturnValue(0)
        }
        IfCondition StringEquals(arg, "--no-preserve-root") ThenBlock: {
            ChmodConfig.preserve_root = 0
            ReturnValue(0)
        }
        WriteStderr("chmod: unrecognized option '")
        WriteStderr(arg)
        WriteStderr("'\n")
        WriteStderr("Try 'chmod --help' for more information.\n")
        SystemCall(60, 1)
    }
}

Function.HandleShort {
    Input: arg: Address
    Body: {
        SymMode.idx = 1
        WhileLoop 1 {
            SymMode.mark = RDMEM_8(arg, SymMode.idx)
            IfCondition EqualTo(SymMode.mark, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition EqualTo(SymMode.mark, 104) ThenBlock: {
                ShowHelp()
                SystemCall(60, 0)
            }
            IfCondition EqualTo(SymMode.mark, 118) ThenBlock: { ChmodConfig.verbose = 1 }
            IfCondition EqualTo(SymMode.mark, 99) ThenBlock: { ChmodConfig.changes = 1 }
            IfCondition EqualTo(SymMode.mark, 102) ThenBlock: { ChmodConfig.silent = 1 }
            IfCondition EqualTo(SymMode.mark, 82) ThenBlock: { ChmodConfig.recursive = 1 }
            SymMode.idx = Add(SymMode.idx, 1)
        }
    }
}

Function.JoinModes {
    Input: parts: Address
    Input: count: Integer
    Output: Address
    Body: {
        IfCondition LessEqual(count, 1) ThenBlock: {
            ReturnValue(ArrayGet(parts, 0))
        }
        JoinBuf.total = 0
        k = 0
        WhileLoop LessThan(k, count) {
            JoinBuf.total = Add(JoinBuf.total, StringLength(ArrayGet(parts, k)))
            k = Add(k, 1)
        }
        JoinBuf.total = Add(JoinBuf.total, Subtract(count, 1))
        buf = Allocate(Add(JoinBuf.total, 1))
        JoinBuf.pos = 0
        k = 0
        WhileLoop LessThan(k, count) {
            IfCondition GreaterThan(k, 0) ThenBlock: {
                WRMEM_8(buf, JoinBuf.pos, 44)
                JoinBuf.pos = Add(JoinBuf.pos, 1)
            }
            src = ArrayGet(parts, k)
            slen = StringLength(src)
            n = 0
            WhileLoop LessThan(n, slen) {
                WRMEM_8(buf, JoinBuf.pos, RDMEM_8(src, n))
                JoinBuf.pos = Add(JoinBuf.pos, 1)
                n = Add(n, 1)
            }
            k = Add(k, 1)
        }
        WRMEM_8(buf, JoinBuf.pos, 0)
        ReturnValue(buf)
    }
}

Function.CopyArgAt {
    Input: base: Address
    Input: at: Integer
    Output: Address
    Body: {
        JoinBuf.total = 0
        WhileLoop NotEqual(RDMEM_8(base, Add(at, JoinBuf.total)), 0) {
            JoinBuf.total = Add(JoinBuf.total, 1)
            IfCondition GreaterThan(JoinBuf.total, 4096) ThenBlock: {
                BreakLoop
            }
        }
        buf = Allocate(Add(JoinBuf.total, 1))
        JoinBuf.pos = 0
        WhileLoop LessThan(JoinBuf.pos, JoinBuf.total) {
            WRMEM_8(buf, JoinBuf.pos, RDMEM_8(base, Add(at, JoinBuf.pos)))
            JoinBuf.pos = Add(JoinBuf.pos, 1)
        }
        WRMEM_8(buf, JoinBuf.total, 0)
        ReturnValue(buf)
    }
}

// ============================================================================
// MAIN
// ============================================================================

SubRoutine.Main {
    args_buffer = GetArgs()
    
    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        WriteStderr("chmod: failed to read arguments\n")
        SystemCall(60, 1)
    }
    
    ArgScan.pos = 0
    WhileLoop NotEqual(RDMEM_8(args_buffer, ArgScan.pos), 0) {
        ArgScan.pos = Add(ArgScan.pos, 1)
    }
    ArgScan.pos = Add(ArgScan.pos, 1)

    ChmodConfig.surprise = 0
    options_done = 0
    mode_str = 0
    mode = 0

    max_files = 256
    files = ArrayCreate(max_files)
    file_count = 0
    mode_parts = ArrayCreate(max_files)
    mode_count = 0
    operands = ArrayCreate(max_files)
    operand_count = 0

    WhileLoop LessThan(ArgScan.pos, 4096) {
        ch = RDMEM_8(args_buffer, ArgScan.pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            BreakLoop
        }

        arg = CopyArgAt(args_buffer, ArgScan.pos)

        IfCondition EqualTo(options_done, 0) ThenBlock: {
            IfCondition EqualTo(ch, 45) ThenBlock: {
                second = RDMEM_8(arg, 1)
                IfCondition EqualTo(second, 45) ThenBlock: {
                    third = RDMEM_8(arg, 2)
                    IfCondition EqualTo(third, 0) ThenBlock: {
                        options_done = 1
                    } ElseBlock: {
                        HandleLong(arg)
                    }
                } ElseBlock: {
                    IfCondition EqualTo(second, 0) ThenBlock: {
                        ArraySet(operands, operand_count, arg)
                        operand_count = Add(operand_count, 1)
                    } ElseBlock: {
                        realf = IsRealFlags(arg)
                        IfCondition EqualTo(realf, 1) ThenBlock: {
                            HandleShort(arg)
                        } ElseBlock: {
                            ArraySet(mode_parts, mode_count, arg)
                            mode_count = Add(mode_count, 1)
                            ChmodConfig.surprise = 1
                        }
                    }
                }
            } ElseBlock: {
                ArraySet(operands, operand_count, arg)
                operand_count = Add(operand_count, 1)
            }
        } ElseBlock: {
            ArraySet(operands, operand_count, arg)
            operand_count = Add(operand_count, 1)
        }

        WhileLoop NotEqual(RDMEM_8(args_buffer, ArgScan.pos), 0) {
            ArgScan.pos = Add(ArgScan.pos, 1)
        }
        ArgScan.pos = Add(ArgScan.pos, 1)
    }

    IfCondition GreaterThan(mode_count, 0) ThenBlock: {
        mode_str = JoinModes(mode_parts, mode_count)
        k = 0
        WhileLoop LessThan(k, operand_count) {
            ArraySet(files, file_count, ArrayGet(operands, k))
            file_count = Add(file_count, 1)
            k = Add(k, 1)
        }
    } ElseBlock: {
        IfCondition EqualTo(operand_count, 0) ThenBlock: {
            WriteStderr("chmod: missing operand\n")
            WriteStderr("Try 'chmod --help' for more information.\n")
            ArrayDestroy(files)
            ArrayDestroy(mode_parts)
            ArrayDestroy(operands)
            Deallocate(args_buffer, 4096)
            SystemCall(60, 1)
        }
        mode_str = ArrayGet(operands, 0)
        k = 1
        WhileLoop LessThan(k, operand_count) {
            ArraySet(files, file_count, ArrayGet(operands, k))
            file_count = Add(file_count, 1)
            k = Add(k, 1)
        }
    }

    mode = ParseOctalMode(mode_str)
    IfCondition LessThan(mode, 0) ThenBlock: {
        mode = -2
    }

    IfCondition EqualTo(file_count, 0) ThenBlock: {
        WriteStderr("chmod: missing operand after '")
        WriteStderr(mode_str)
        WriteStderr("'\n")
        WriteStderr("Try 'chmod --help' for more information.\n")
        ArrayDestroy(files)
        ArrayDestroy(mode_parts)
        ArrayDestroy(operands)
        Deallocate(args_buffer, 4096)
        SystemCall(60, 1)
    }

    saved_umask = SystemCall(95, 0)
    SystemCall(95, saved_umask)

    had_errors = 0
    i = 0
    WhileLoop LessThan(i, file_count) {
        path = ArrayGet(files, i)
        current = GetFileMode(path)

        IfCondition LessThan(current, 0) ThenBlock: {
            IfCondition EqualTo(mode, -2) ThenBlock: {
                had_errors = 1
                i = Add(i, 1)
                ContinueLoop
            }
            result = ProcessPath(path, mode)
            IfCondition NotEqual(result, 0) ThenBlock: {
                had_errors = 1
            }
            i = Add(i, 1)
            ContinueLoop
        }

        IfCondition EqualTo(mode, -2) ThenBlock: {
            ChmodRun.got = ParseSymbolicMode(mode_str, current, saved_umask)
            IfCondition LessThan(ChmodRun.got, 0) ThenBlock: {
                WriteStderr("chmod: invalid mode: '")
                WriteStderr(mode_str)
                WriteStderr("'\n")
                WriteStderr("Try 'chmod --help' for more information.\n")
                ArrayDestroy(files)
                ArrayDestroy(mode_parts)
                ArrayDestroy(operands)
                Deallocate(args_buffer, 4096)
                SystemCall(60, 1)
            }
            IfCondition EqualTo(ChmodConfig.surprise, 1) ThenBlock: {
                extra = CheckSurprise(mode_str, current)
                IfCondition NotEqual(extra, 0) ThenBlock: {
                    WriteError("chmod: new permissions are not the requested ones\n")
                    had_errors = 1
                }
            }
            result = ProcessPath(path, ChmodRun.got)
            IfCondition NotEqual(result, 0) ThenBlock: {
                had_errors = 1
            }
        } ElseBlock: {
            ChmodRun.got = AdjustOctal(current)
            result = ProcessPath(path, ChmodRun.got)
            IfCondition NotEqual(result, 0) ThenBlock: {
                had_errors = 1
            }
        }

        i = Add(i, 1)
    }

    ArrayDestroy(files)
    ArrayDestroy(mode_parts)
    ArrayDestroy(operands)
    Deallocate(args_buffer, 4096)
    
    SystemCall(60, had_errors)
}

RunTask(Main)