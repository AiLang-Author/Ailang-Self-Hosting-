// chown.ailang - Change file owner and group
// Usage: chown [OWNER][:[GROUP]] FILE...

LibraryImport.Arena

FixedPool.ChownConfig {
    "dereference": Initialize=1
    "silent": Initialize=0
    "have_from": Initialize=0
    "from_uid": Initialize=-1
    "from_gid": Initialize=-1
    "recurse": Initialize=0
    "traverse": Initialize=0
    "preserve_root": Initialize=0
    "deref_set": Initialize=0
    "root_dev0": Initialize=0
    "root_dev1": Initialize=0
    "root_ino0": Initialize=0
    "root_ino1": Initialize=0
    "login_gid": Initialize=-1
    "parsed_uid": Initialize=-1
    "parsed_gid": Initialize=-1
}

FixedPool.PasswdScan {
    "pos": Initialize=0
}

Function.WriteStdout {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 1, buffer, len)
    }
}

Function.WriteStderr {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 2, buffer, len)
    }
}

Function.GetStringLength {
    Input: str: Address
    Output: Integer
    Body: {
        len = 0
        WhileLoop NotEqual(GetByte(str, len), 0) {
            len = Add(len, 1)
        }
        ReturnValue(len)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        ReturnValue(buffer)
    }
}

Function.ParseNumeric {
    Input: str: Address
    Output: Integer
    Body: {
        result = 0
        i = 0
        saw = 0
        // GNU skips the name lookup when the id starts with '+', then
        // parses the digits. `chown +1001:+0` is uid 1001, gid 0.
        ch0 = GetByte(str, 0)
        IfCondition EqualTo(ch0, 43) ThenBlock: {
            i = 1
        }
        
        WhileLoop LessThan(i, 21) {
            ch = GetByte(str, i)
            
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            
            // Check if digit
            IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                ReturnValue(-1)
            }
            
            digit = Subtract(ch, 48)
            result = Add(Multiply(result, 10), digit)
            saw = 1
            i = Add(i, 1)
        }
        
        IfCondition EqualTo(saw, 0) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(result)
    }
}

Function.WriteErrStr {
    Input: str: Address
    Body: {
        n = GetStringLength(str)
        WriteStderr(str, n)
    }
}

Function.LookupUser {
    Input: name: Address
    Output: Integer
    Body: {
        ChownConfig.login_gid = -1
        fd = SystemCall(2, "/etc/passwd", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(-1)
        }

        buf = Allocate(65536)
        nread = SystemCall(0, fd, buf, 65536)
        SystemCall(3, fd)
        IfCondition LessEqual(nread, 0) ThenBlock: {
            Deallocate(buf, 65536)
            ReturnValue(-1)
        }

        name_len = GetStringLength(name)
        i = 0
        found = -1
        WhileLoop LessThan(i, nread) {
            match = 1
            j = 0
            WhileLoop LessThan(j, name_len) {
                idx = Add(i, j)
                ch = GetByte(buf, idx)
                exp = GetByte(name, j)
                IfCondition NotEqual(ch, exp) ThenBlock: {
                    match = 0
                }
                j = Add(j, 1)
            }

            sep_at = Add(i, name_len)
            sep = GetByte(buf, sep_at)
            IfCondition EqualTo(match, 1) ThenBlock: {
                IfCondition EqualTo(sep, 58) ThenBlock: {
                    PasswdScan.pos = Add(i, name_len)
                    PasswdScan.pos = Add(PasswdScan.pos, 1)
                    WhileLoop NotEqual(GetByte(buf, PasswdScan.pos), 58) {
                        PasswdScan.pos = Add(PasswdScan.pos, 1)
                    }
                    PasswdScan.pos = Add(PasswdScan.pos, 1)
                    uid = 0
                    WhileLoop 1 {
                        digit_ch = GetByte(buf, PasswdScan.pos)
                        is_digit = And(GreaterEqual(digit_ch, 48), LessEqual(digit_ch, 57))
                        IfCondition EqualTo(is_digit, 0) ThenBlock: {
                            BreakLoop
                        }
                        digit = Subtract(digit_ch, 48)
                        uid = Add(Multiply(uid, 10), digit)
                        PasswdScan.pos = Add(PasswdScan.pos, 1)
                    }
                    found = uid
                    gidch = GetByte(buf, PasswdScan.pos)
                    IfCondition EqualTo(gidch, 58) ThenBlock: {
                        PasswdScan.pos = Add(PasswdScan.pos, 1)
                        lg = 0
                        sawg = 0
                        WhileLoop 1 {
                            gd = GetByte(buf, PasswdScan.pos)
                            isd = And(GreaterEqual(gd, 48), LessEqual(gd, 57))
                            IfCondition EqualTo(isd, 0) ThenBlock: {
                                BreakLoop
                            }
                            lg = Add(Multiply(lg, 10), Subtract(gd, 48))
                            sawg = 1
                            PasswdScan.pos = Add(PasswdScan.pos, 1)
                        }
                        IfCondition EqualTo(sawg, 1) ThenBlock: {
                            ChownConfig.login_gid = lg
                        }
                    }
                    i = nread
                }
            }

            IfCondition LessThan(i, nread) ThenBlock: {
                WhileLoop And(LessThan(i, nread), NotEqual(GetByte(buf, i), 10)) {
                    i = Add(i, 1)
                }
                IfCondition LessThan(i, nread) ThenBlock: {
                    i = Add(i, 1)
                }
            }
        }

        Deallocate(buf, 65536)
        ReturnValue(found)
    }
}

Function.LookupGroup {
    Input: name: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, "/etc/group", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(-1)
        }

        buf = Allocate(65536)
        nread = SystemCall(0, fd, buf, 65536)
        SystemCall(3, fd)
        IfCondition LessEqual(nread, 0) ThenBlock: {
            Deallocate(buf, 65536)
            ReturnValue(-1)
        }

        name_len = GetStringLength(name)
        i = 0
        found = -1
        WhileLoop LessThan(i, nread) {
            match = 1
            j = 0
            WhileLoop LessThan(j, name_len) {
                ch = GetByte(buf, Add(i, j))
                exp = GetByte(name, j)
                IfCondition NotEqual(ch, exp) ThenBlock: {
                    match = 0
                }
                j = Add(j, 1)
            }

            sep = GetByte(buf, Add(i, name_len))
            IfCondition EqualTo(match, 1) ThenBlock: {
                IfCondition EqualTo(sep, 58) ThenBlock: {
                    PasswdScan.pos = Add(i, name_len)
                    PasswdScan.pos = Add(PasswdScan.pos, 1)
                    WhileLoop NotEqual(GetByte(buf, PasswdScan.pos), 58) {
                        PasswdScan.pos = Add(PasswdScan.pos, 1)
                    }
                    PasswdScan.pos = Add(PasswdScan.pos, 1)
                    gid = 0
                    WhileLoop 1 {
                        digit_ch = GetByte(buf, PasswdScan.pos)
                        is_digit = And(GreaterEqual(digit_ch, 48), LessEqual(digit_ch, 57))
                        IfCondition EqualTo(is_digit, 0) ThenBlock: {
                            BreakLoop
                        }
                        digit = Subtract(digit_ch, 48)
                        gid = Add(Multiply(gid, 10), digit)
                        PasswdScan.pos = Add(PasswdScan.pos, 1)
                    }
                    found = gid
                    i = nread
                }
            }

            IfCondition LessThan(i, nread) ThenBlock: {
                WhileLoop And(LessThan(i, nread), NotEqual(GetByte(buf, i), 10)) {
                    i = Add(i, 1)
                }
                IfCondition LessThan(i, nread) ThenBlock: {
                    i = Add(i, 1)
                }
            }
        }

        Deallocate(buf, 65536)
        ReturnValue(found)
    }
}

Function.GetUInt32 {
    Input: addr: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        b0 = GetByte(addr, offset)
        b1 = GetByte(addr, Add(offset, 1))
        b2 = GetByte(addr, Add(offset, 2))
        b3 = GetByte(addr, Add(offset, 3))
        value = Add(b0, Multiply(b1, 256))
        value = Add(value, Multiply(b2, 65536))
        value = Add(value, Multiply(b3, 16777216))
        ReturnValue(value)
    }
}

Function.CopyAt {
    Input: base: Address
    Input: at: Integer
    Output: Address
    Body: {
        n = 0
        WhileLoop NotEqual(GetByte(base, Add(at, n)), 0) {
            n = Add(n, 1)
        }
        buf = Allocate(Add(n, 1))
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(buf, i, GetByte(base, Add(at, i)))
            i = Add(i, 1)
        }
        SetByte(buf, n, 0)
        ReturnValue(buf)
    }
}

Function.ApplyFrom {
    Input: spec: Address
    Output: Integer
    Body: {
        n = GetStringLength(spec)
        colon = -1
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(GetByte(spec, i), 58) ThenBlock: {
                colon = i
                BreakLoop
            }
            i = Add(i, 1)
        }

        ChownConfig.from_uid = -1
        ChownConfig.from_gid = -1
        ChownConfig.have_from = 1

        IfCondition NotEqual(colon, 0) ThenBlock: {
            end = n
            IfCondition GreaterEqual(colon, 0) ThenBlock: {
                end = colon
            }
            IfCondition GreaterThan(end, 0) ThenBlock: {
                owner_buf = Allocate(Add(end, 1))
                j = 0
                WhileLoop LessThan(j, end) {
                    SetByte(owner_buf, j, GetByte(spec, j))
                    j = Add(j, 1)
                }
                SetByte(owner_buf, end, 0)
                uid = ParseNumeric(owner_buf)
                IfCondition LessThan(uid, 0) ThenBlock: {
                    uid = LookupUser(owner_buf)
                }
                Deallocate(owner_buf, Add(end, 1))
                IfCondition LessThan(uid, 0) ThenBlock: {
                    WriteStderr("chown: invalid user\n", 21)
                    ReturnValue(1)
                }
                ChownConfig.from_uid = uid
            }
        }

        IfCondition GreaterEqual(colon, 0) ThenBlock: {
            group_start = Add(colon, 1)
            group_len = Subtract(n, group_start)
            IfCondition GreaterThan(group_len, 0) ThenBlock: {
                group_buf = Allocate(Add(group_len, 1))
                j = 0
                WhileLoop LessThan(j, group_len) {
                    SetByte(group_buf, j, GetByte(spec, Add(group_start, j)))
                    j = Add(j, 1)
                }
                SetByte(group_buf, group_len, 0)
                gid = ParseNumeric(group_buf)
                IfCondition LessThan(gid, 0) ThenBlock: {
                    gid = LookupGroup(group_buf)
                }
                Deallocate(group_buf, Add(group_len, 1))
                IfCondition LessThan(gid, 0) ThenBlock: {
                    WriteStderr("chown: invalid group\n", 21)
                    ReturnValue(1)
                }
                ChownConfig.from_gid = gid
            }
        }

        ReturnValue(0)
    }
}

Function.ChangeOwnership {
    Input: path: Address
    Input: uid: Integer
    Input: gid: Integer
    Input: nofollow: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ChownConfig.have_from, 1) ThenBlock: {
            frombuf = Allocate(144)
            fres = SystemCall(4, path, frombuf)
            IfCondition GreaterEqual(fres, 0) ThenBlock: {
                cur_uid = GetUInt32(frombuf, 28)
                cur_gid = GetUInt32(frombuf, 32)
                mismatch = 0
                IfCondition GreaterEqual(ChownConfig.from_uid, 0) ThenBlock: {
                    IfCondition NotEqual(cur_uid, ChownConfig.from_uid) ThenBlock: {
                        mismatch = 1
                    }
                }
                IfCondition GreaterEqual(ChownConfig.from_gid, 0) ThenBlock: {
                    IfCondition NotEqual(cur_gid, ChownConfig.from_gid) ThenBlock: {
                        mismatch = 1
                    }
                }
                IfCondition EqualTo(mismatch, 1) ThenBlock: {
                    Deallocate(frombuf, 144)
                    ReturnValue(0)
                }
            }
            Deallocate(frombuf, 144)
        }
        IfCondition EqualTo(ChownConfig.dereference, 1) ThenBlock: {
            statbuf = Allocate(144)
            lres = SystemCall(6, path, statbuf)
            kind = 0
            IfCondition GreaterEqual(lres, 0) ThenBlock: {
                mode = Dereference(Add(statbuf, 24))
                kind = BitwiseAnd(mode, 61440)
            }
            IfCondition EqualTo(kind, 40960) ThenBlock: {
                sres = SystemCall(4, path, statbuf)
                IfCondition LessThan(sres, 0) ThenBlock: {
                    Deallocate(statbuf, 144)
                    IfCondition EqualTo(ChownConfig.silent, 0) ThenBlock: {
                        WriteErrStr("chown: cannot dereference '")
                        path_len = GetStringLength(path)
                        WriteStderr(path, path_len)
                        WriteErrStr("': No such file or directory\n")
                    }
                    ReturnValue(1)
                }
            }
            Deallocate(statbuf, 144)
        }

        flags = 0
        IfCondition NotEqual(nofollow, 0) ThenBlock: {
            flags = 256
        }
        result = SystemCall(260, -100, path, uid, gid, flags)
        
        IfCondition LessThan(result, 0) ThenBlock: {
            IfCondition EqualTo(ChownConfig.silent, 0) ThenBlock: {
                errno = Subtract(0, result)
                WriteStderr("chown: cannot change ownership of '", 35)
                WriteStderr(path, GetStringLength(path))
                WriteStderr("': ", 3)
                IfCondition EqualTo(errno, 1) ThenBlock: {
                    WriteStderr("Operation not permitted", 23)
                } ElseBlock: {
                    IfCondition EqualTo(errno, 2) ThenBlock: {
                        WriteStderr("No such file or directory", 25)
                    } ElseBlock: {
                        IfCondition EqualTo(errno, 13) ThenBlock: {
                            WriteStderr("Permission denied", 17)
                        }
                    }
                }
                WriteStderr("\n", 1)
            }
            ReturnValue(1)
        }
        
        ReturnValue(0)
    }
}

Function.LoadRoot {
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(6, "/", statbuf)
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            WriteErrStr("chown: failed to get attributes of '/'\n")
            SystemCall(60, 1)
        }
        ChownConfig.root_dev0 = GetUInt32(statbuf, 0)
        ChownConfig.root_dev1 = GetUInt32(statbuf, 4)
        ChownConfig.root_ino0 = GetUInt32(statbuf, 8)
        ChownConfig.root_ino1 = GetUInt32(statbuf, 12)
        Deallocate(statbuf, 144)
    }
}

Function.SameAsRoot {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(4, path, statbuf)
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        d0 = GetUInt32(statbuf, 0)
        d1 = GetUInt32(statbuf, 4)
        i0 = GetUInt32(statbuf, 8)
        i1 = GetUInt32(statbuf, 12)
        Deallocate(statbuf, 144)
        match = 0
        IfCondition EqualTo(d0, ChownConfig.root_dev0) ThenBlock: {
            IfCondition EqualTo(d1, ChownConfig.root_dev1) ThenBlock: {
                IfCondition EqualTo(i0, ChownConfig.root_ino0) ThenBlock: {
                    IfCondition EqualTo(i1, ChownConfig.root_ino1) ThenBlock: {
                        match = 1
                    }
                }
            }
        }
        ReturnValue(match)
    }
}

Function.WarnRoot {
    Input: path: Address
    Body: {
        slash = 0
        IfCondition EqualTo(GetByte(path, 0), 47) ThenBlock: {
            IfCondition EqualTo(GetByte(path, 1), 0) ThenBlock: {
                slash = 1
            }
        }
        IfCondition EqualTo(slash, 1) ThenBlock: {
            WriteErrStr("chown: it is dangerous to operate recursively on '/'\n")
        } ElseBlock: {
            WriteErrStr("chown: it is dangerous to operate recursively on '")
            plen = GetStringLength(path)
            WriteStderr(path, plen)
            WriteErrStr("' (same as '/')\n")
        }
        WriteErrStr("chown: use --no-preserve-root to override this failsafe\n")
    }
}

Function.PathKind {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(6, path, statbuf)
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        mode = GetUInt32(statbuf, 24)
        Deallocate(statbuf, 144)
        kind = BitwiseAnd(mode, 61440)
        IfCondition EqualTo(kind, 40960) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(kind, 16384) ThenBlock: {
            ReturnValue(2)
        }
        ReturnValue(3)
    }
}

Function.IsStatDir {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(4, path, statbuf)
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        mode = GetUInt32(statbuf, 24)
        Deallocate(statbuf, 144)
        kind = BitwiseAnd(mode, 61440)
        ReturnValue(EqualTo(kind, 16384))
    }
}

Function.BuildChild {
    Input: dir: Address
    Input: name: Address
    Output: Address
    Body: {
        dir_len = GetStringLength(dir)
        name_len = GetStringLength(name)
        total = Add(Add(dir_len, name_len), 2)
        path = Allocate(total)
        i = 0
        WhileLoop LessThan(i, dir_len) {
            SetByte(path, i, GetByte(dir, i))
            i = Add(i, 1)
        }
        SetByte(path, i, 47)
        i = Add(i, 1)
        j = 0
        WhileLoop LessThan(j, name_len) {
            SetByte(path, i, GetByte(name, j))
            i = Add(i, 1)
            j = Add(j, 1)
        }
        SetByte(path, i, 0)
        ReturnValue(path)
    }
}

Function.ChownWalk {
    Input: path: Address
    Input: uid: Integer
    Input: gid: Integer
    Input: follow: Integer
    Input: depth: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(depth, 32) ThenBlock: {
            ReturnValue(1)
        }
        nofollow = 0
        IfCondition EqualTo(ChownConfig.dereference, 0) ThenBlock: {
            nofollow = 1
        }
        IfCondition EqualTo(ChownConfig.recurse, 0) ThenBlock: {
            ReturnValue(ChangeOwnership(path, uid, gid, nofollow))
        }

        kind = PathKind(path)
        descend = 0
        IfCondition EqualTo(kind, 2) ThenBlock: {
            descend = 1
        }
        IfCondition EqualTo(kind, 1) ThenBlock: {
            IfCondition EqualTo(follow, 1) ThenBlock: {
                is_target_dir = IsStatDir(path)
                IfCondition EqualTo(is_target_dir, 1) ThenBlock: {
                    descend = 1
                }
            }
        }

        IfCondition EqualTo(ChownConfig.preserve_root, 1) ThenBlock: {
            IfCondition EqualTo(GetByte(path, 0), 47) ThenBlock: {
                IfCondition EqualTo(GetByte(path, 1), 0) ThenBlock: {
                    WarnRoot(path)
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(descend, 1) ThenBlock: {
                is_root = SameAsRoot(path)
                IfCondition EqualTo(is_root, 1) ThenBlock: {
                    WarnRoot(path)
                    ReturnValue(1)
                }
            }
        }

        err = ChangeOwnership(path, uid, gid, nofollow)
        IfCondition EqualTo(descend, 0) ThenBlock: {
            ReturnValue(err)
        }

        fd = SystemCall(2, path, 65536)
        IfCondition LessThan(fd, 0) ThenBlock: {
            IfCondition EqualTo(ChownConfig.silent, 0) ThenBlock: {
                open_err = Subtract(0, fd)
                WriteErrStr("chown: cannot read directory '")
                plen = GetStringLength(path)
                WriteStderr(path, plen)
                WriteErrStr("': ")
                IfCondition EqualTo(open_err, 2) ThenBlock: {
                    WriteErrStr("No such file or directory\n")
                } ElseBlock: {
                    WriteErrStr("Permission denied\n")
                }
            }
            ReturnValue(1)
        }

        buffer = Allocate(4096)
        WhileLoop 1 {
            nread = SystemCall(217, fd, buffer, 4096)
            IfCondition LessEqual(nread, 0) ThenBlock: {
                BreakLoop
            }
            offset = 0
            WhileLoop LessThan(offset, nread) {
                reclen_lo = GetByte(buffer, Add(offset, 16))
                reclen_hi = GetByte(buffer, Add(offset, 17))
                reclen = Add(reclen_lo, Multiply(reclen_hi, 256))
                IfCondition EqualTo(reclen, 0) ThenBlock: {
                    BreakLoop
                }

                skip = 0
                c0 = GetByte(buffer, Add(offset, 19))
                IfCondition EqualTo(c0, 46) ThenBlock: {
                    c1 = GetByte(buffer, Add(offset, 20))
                    IfCondition EqualTo(c1, 0) ThenBlock: {
                        skip = 1
                    }
                    IfCondition EqualTo(c1, 46) ThenBlock: {
                        c2 = GetByte(buffer, Add(offset, 21))
                        IfCondition EqualTo(c2, 0) ThenBlock: {
                            skip = 1
                        }
                    }
                }

                IfCondition EqualTo(skip, 0) ThenBlock: {
                    name_len = 0
                    WhileLoop LessThan(name_len, 256) {
                        nc = GetByte(buffer, Add(Add(offset, 19), name_len))
                        IfCondition EqualTo(nc, 0) ThenBlock: {
                            BreakLoop
                        }
                        name_len = Add(name_len, 1)
                    }
                    name_buf = Allocate(Add(name_len, 1))
                    ni = 0
                    WhileLoop LessThan(ni, name_len) {
                        nc = GetByte(buffer, Add(Add(offset, 19), ni))
                        SetByte(name_buf, ni, nc)
                        ni = Add(ni, 1)
                    }
                    SetByte(name_buf, name_len, 0)
                    child = BuildChild(path, name_buf)
                    Deallocate(name_buf, Add(name_len, 1))
                    child_follow = 0
                    IfCondition EqualTo(ChownConfig.traverse, 2) ThenBlock: {
                        child_follow = 1
                    }
                    child_err = ChownWalk(child, uid, gid, child_follow, Add(depth, 1))
                    Deallocate(child, 0)
                    IfCondition NotEqual(child_err, 0) ThenBlock: {
                        err = 1
                    }
                }

                offset = Add(offset, reclen)
            }
        }

        SystemCall(3, fd)
        Deallocate(buffer, 4096)
        ReturnValue(err)
    }
}

Function.FindByte {
    Input: buf: Address
    Input: n: Integer
    Input: want: Integer
    Output: Integer
    Body: {
        found = -1
        i = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(buf, i)
            IfCondition EqualTo(ch, want) ThenBlock: {
                found = i
                i = n
            } ElseBlock: {
                i = Add(i, 1)
            }
        }
        ReturnValue(found)
    }
}

Function.ReportSpec {
    Input: kind: Integer
    Input: spec: Address
    Body: {
        IfCondition EqualTo(kind, 1) ThenBlock: {
            WriteErrStr("chown: invalid spec: '")
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            WriteErrStr("chown: invalid user: '")
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            WriteErrStr("chown: invalid group: '")
        }
        WriteErrStr(spec)
        WriteErrStr("'\n")
    }
}

// sep < 0 means the whole spec is a user. Otherwise sep is the separator index.
// Returns 0, or 1 invalid spec, 2 invalid user, 3 invalid group.
Function.ApplySep {
    Input: spec: Address
    Input: spec_len: Integer
    Input: sep: Integer
    Output: Integer
    Body: {
        ChownConfig.parsed_uid = -1
        ChownConfig.parsed_gid = -1
        ulen = spec_len
        IfCondition GreaterEqual(sep, 0) ThenBlock: {
            ulen = sep
        }
        glen = 0
        gstart = 0
        IfCondition GreaterEqual(sep, 0) ThenBlock: {
            gstart = Add(sep, 1)
            glen = Subtract(spec_len, gstart)
        }
        rc = 0
        IfCondition GreaterThan(ulen, 0) ThenBlock: {
            ubuf = Allocate(Add(ulen, 1))
            j = 0
            WhileLoop LessThan(j, ulen) {
                SetByte(ubuf, j, GetByte(spec, j))
                j = Add(j, 1)
            }
            SetByte(ubuf, ulen, 0)
            plus = EqualTo(GetByte(ubuf, 0), 43)
            looked = -1
            IfCondition EqualTo(plus, 0) ThenBlock: {
                looked = LookupUser(ubuf)
            }
            IfCondition GreaterEqual(looked, 0) ThenBlock: {
                ChownConfig.parsed_uid = looked
                empty_g = 0
                IfCondition GreaterEqual(sep, 0) ThenBlock: {
                    IfCondition EqualTo(glen, 0) ThenBlock: {
                        empty_g = 1
                    }
                }
                IfCondition EqualTo(empty_g, 1) ThenBlock: {
                    ChownConfig.parsed_gid = ChownConfig.login_gid
                }
            } ElseBlock: {
                badspec = 0
                IfCondition GreaterEqual(sep, 0) ThenBlock: {
                    IfCondition EqualTo(glen, 0) ThenBlock: {
                        badspec = 1
                    }
                }
                IfCondition EqualTo(badspec, 1) ThenBlock: {
                    rc = 1
                } ElseBlock: {
                    num = ParseNumeric(ubuf)
                    IfCondition LessThan(num, 0) ThenBlock: {
                        rc = 2
                    } ElseBlock: {
                        ChownConfig.parsed_uid = num
                    }
                }
            }
            Deallocate(ubuf, Add(ulen, 1))
        }
        IfCondition EqualTo(rc, 0) ThenBlock: {
            IfCondition GreaterThan(glen, 0) ThenBlock: {
                gbuf = Allocate(Add(glen, 1))
                j = 0
                WhileLoop LessThan(j, glen) {
                    SetByte(gbuf, j, GetByte(spec, Add(gstart, j)))
                    j = Add(j, 1)
                }
                SetByte(gbuf, glen, 0)
                gplus = EqualTo(GetByte(gbuf, 0), 43)
                glook = -1
                IfCondition EqualTo(gplus, 0) ThenBlock: {
                    glook = LookupGroup(gbuf)
                }
                IfCondition LessThan(glook, 0) ThenBlock: {
                    glook = ParseNumeric(gbuf)
                }
                Deallocate(gbuf, Add(glen, 1))
                IfCondition LessThan(glook, 0) ThenBlock: {
                    rc = 3
                } ElseBlock: {
                    ChownConfig.parsed_gid = glook
                }
            }
        }
        ReturnValue(rc)
    }
}

SubRoutine.Main {
    args_buffer = GetArgs()
    
    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        WriteStderr("chown: missing operand\n", 23)
        SystemCall(60, 1)
    }
    
    // Skip program name
    pos = 0
    WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)
    
    parsing_opts = 1
    WhileLoop EqualTo(parsing_opts, 1) {
        ch = GetByte(args_buffer, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            parsing_opts = 0
        } ElseBlock: {
            IfCondition NotEqual(ch, 45) ThenBlock: {
                parsing_opts = 0
            } ElseBlock: {
                opt = Add(args_buffer, pos)
                IfCondition StringEquals(opt, "--") ThenBlock: {
                    WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
                        pos = Add(pos, 1)
                    }
                    pos = Add(pos, 1)
                    parsing_opts = 0
                } ElseBlock: {
                    IfCondition StringEquals(opt, "--dereference") ThenBlock: {
                        ChownConfig.dereference = 1
                        ChownConfig.deref_set = 1
                        WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
                            pos = Add(pos, 1)
                        }
                        pos = Add(pos, 1)
                    } ElseBlock: {
                        IfCondition StringEquals(opt, "--no-dereference") ThenBlock: {
                            ChownConfig.dereference = 0
                            ChownConfig.deref_set = 1
                            WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
                                pos = Add(pos, 1)
                            }
                            pos = Add(pos, 1)
                        } ElseBlock: {
                            IfCondition StringEquals(opt, "--silent") ThenBlock: {
                                ChownConfig.silent = 1
                                WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
                                    pos = Add(pos, 1)
                                }
                                pos = Add(pos, 1)
                            } ElseBlock: {
                                IfCondition StringEquals(opt, "--quiet") ThenBlock: {
                                    ChownConfig.silent = 1
                                    WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
                                        pos = Add(pos, 1)
                                    }
                                    pos = Add(pos, 1)
                                } ElseBlock: {
                                    from_hit = 0
                                    IfCondition EqualTo(GetByte(args_buffer, Add(pos, 2)), 102) ThenBlock: {
                                        IfCondition EqualTo(GetByte(args_buffer, Add(pos, 3)), 114) ThenBlock: {
                                            IfCondition EqualTo(GetByte(args_buffer, Add(pos, 4)), 111) ThenBlock: {
                                                IfCondition EqualTo(GetByte(args_buffer, Add(pos, 5)), 109) ThenBlock: {
                                                    IfCondition EqualTo(GetByte(args_buffer, Add(pos, 6)), 61) ThenBlock: {
                                                        from_hit = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    IfCondition EqualTo(from_hit, 1) ThenBlock: {
                                        spec = CopyAt(args_buffer, Add(pos, 7))
                                        bad = ApplyFrom(spec)
                                        Deallocate(spec, 0)
                                        IfCondition EqualTo(bad, 1) ThenBlock: {
                                            Deallocate(args_buffer, 4096)
                                            SystemCall(60, 1)
                                        }
                                        WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
                                            pos = Add(pos, 1)
                                        }
                                        pos = Add(pos, 1)
                                    } ElseBlock: {
                            long_extra = 0
                            IfCondition StringEquals(opt, "--preserve-root") ThenBlock: {
                                ChownConfig.preserve_root = 1
                                long_extra = 1
                            }
                            IfCondition StringEquals(opt, "--no-preserve-root") ThenBlock: {
                                ChownConfig.preserve_root = 0
                                long_extra = 1
                            }
                            IfCondition StringEquals(opt, "--recursive") ThenBlock: {
                                ChownConfig.recurse = 1
                                long_extra = 1
                            }
                            IfCondition EqualTo(long_extra, 1) ThenBlock: {
                                WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
                                    pos = Add(pos, 1)
                                }
                                pos = Add(pos, 1)
                            } ElseBlock: {
                            second = GetByte(args_buffer, Add(pos, 1))
                            IfCondition EqualTo(second, 45) ThenBlock: {
                                parsing_opts = 0
                            } ElseBlock: {
                                i = Add(pos, 1)
                                WhileLoop NotEqual(GetByte(args_buffer, i), 0) {
                                    IfCondition EqualTo(GetByte(args_buffer, i), 104) ThenBlock: {
                                        ChownConfig.dereference = 0
                                        ChownConfig.deref_set = 1
                                    }
                                    IfCondition EqualTo(GetByte(args_buffer, i), 102) ThenBlock: {
                                        ChownConfig.silent = 1
                                    }
                                    IfCondition EqualTo(GetByte(args_buffer, i), 82) ThenBlock: {
                                        ChownConfig.recurse = 1
                                    }
                                    IfCondition EqualTo(GetByte(args_buffer, i), 72) ThenBlock: {
                                        ChownConfig.traverse = 1
                                    }
                                    IfCondition EqualTo(GetByte(args_buffer, i), 76) ThenBlock: {
                                        ChownConfig.traverse = 2
                                    }
                                    IfCondition EqualTo(GetByte(args_buffer, i), 80) ThenBlock: {
                                        ChownConfig.traverse = 0
                                    }
                                    i = Add(i, 1)
                                }
                                WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
                                    pos = Add(pos, 1)
                                }
                                pos = Add(pos, 1)
                            }
                            }
                        }
                    }
                }
            }
        }
        }
        }
        }
    }

    // Get owner[:group] specification
    owner_start = pos
    owner_len = 0
    
    WhileLoop And(LessThan(pos, 4096), NotEqual(GetByte(args_buffer, pos), 0)) {
        owner_len = Add(owner_len, 1)
        pos = Add(pos, 1)
    }
    
    owner_spec = Add(args_buffer, owner_start)
    uid = -1
    gid = -1

    IfCondition EqualTo(owner_len, 0) ThenBlock: {
        nxt = Add(pos, 1)
        more = 0
        IfCondition LessThan(nxt, 4096) ThenBlock: {
            nb = GetByte(args_buffer, nxt)
            IfCondition NotEqual(nb, 0) ThenBlock: {
                more = 1
            }
        }
        IfCondition EqualTo(more, 0) ThenBlock: {
            WriteStderr("chown: missing operand\n", 23)
            Deallocate(args_buffer, 4096)
            SystemCall(60, 1)
        }
        pos = nxt
    } ElseBlock: {
        colon = FindByte(owner_spec, owner_len, 58)
        rc = 0
        IfCondition GreaterEqual(colon, 0) ThenBlock: {
            rc = ApplySep(owner_spec, owner_len, colon)
        } ElseBlock: {
            rc = ApplySep(owner_spec, owner_len, -1)
            IfCondition NotEqual(rc, 0) ThenBlock: {
                dot = FindByte(owner_spec, owner_len, 46)
                IfCondition GreaterEqual(dot, 0) ThenBlock: {
                    rc2 = ApplySep(owner_spec, owner_len, dot)
                    IfCondition EqualTo(rc2, 0) ThenBlock: {
                        WriteErrStr("chown: warning: '.' should be ':': '")
                        WriteErrStr(owner_spec)
                        WriteErrStr("'\n")
                        rc = 0
                    }
                }
            }
        }
        IfCondition NotEqual(rc, 0) ThenBlock: {
            ReportSpec(rc, owner_spec)
            Deallocate(args_buffer, 4096)
            SystemCall(60, 1)
        }
        uid = ChownConfig.parsed_uid
        gid = ChownConfig.parsed_gid
        pos = Add(pos, 1)
    }
    
    // Check if we have any files to process
    file_count = 0
    temp_pos = pos
    WhileLoop LessThan(temp_pos, 4096) {
        ch = GetByte(args_buffer, temp_pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            BreakLoop
        }
        file_count = Add(file_count, 1)
        temp_pos = Add(temp_pos, 1)
    }
    
    IfCondition EqualTo(file_count, 0) ThenBlock: {
        WriteStderr("chown: missing operand after '", 31)
        WriteStderr(owner_spec, owner_len)
        WriteStderr("'\n", 2)
        Deallocate(args_buffer, 4096)
        SystemCall(60, 1)
    }
    
    IfCondition EqualTo(ChownConfig.recurse, 1) ThenBlock: {
        IfCondition EqualTo(ChownConfig.traverse, 0) ThenBlock: {
            IfCondition EqualTo(ChownConfig.deref_set, 1) ThenBlock: {
                IfCondition EqualTo(ChownConfig.dereference, 1) ThenBlock: {
                    WriteErrStr("chown: -R --dereference requires either -H or -L\n")
                    Deallocate(args_buffer, 4096)
                    SystemCall(60, 1)
                }
            }
            ChownConfig.dereference = 0
        }
        IfCondition EqualTo(ChownConfig.preserve_root, 1) ThenBlock: {
            LoadRoot()
        }
    }

    // Now process files
    errors = 0
    
    WhileLoop LessThan(pos, 4096) {
        file_start = pos
        file_len = 0
        
        WhileLoop And(LessThan(pos, 4096), NotEqual(GetByte(args_buffer, pos), 0)) {
            file_len = Add(file_len, 1)
            pos = Add(pos, 1)
        }
        
        IfCondition EqualTo(file_len, 0) ThenBlock: {
            BreakLoop
        }
        
        file_path = Add(args_buffer, file_start)
        
        nf = 0
        IfCondition EqualTo(ChownConfig.dereference, 0) ThenBlock: {
            nf = 1
        }
        IfCondition EqualTo(ChownConfig.recurse, 1) ThenBlock: {
            top_follow = 0
            IfCondition GreaterThan(ChownConfig.traverse, 0) ThenBlock: {
                top_follow = 1
            }
            result = ChownWalk(file_path, uid, gid, top_follow, 0)
        } ElseBlock: {
            result = ChangeOwnership(file_path, uid, gid, nf)
        }
        IfCondition NotEqual(result, 0) ThenBlock: {
            errors = Add(errors, 1)
        }
        
        pos = Add(pos, 1)
        
        // Check for double null (end of args)
        IfCondition EqualTo(GetByte(args_buffer, pos), 0) ThenBlock: {
            BreakLoop
        }
    }
    
    Deallocate(args_buffer, 4096)
    
    IfCondition GreaterThan(errors, 0) ThenBlock: {
        SystemCall(60, 1)
    }
    
    SystemCall(60, 0)
}

RunTask(Main)