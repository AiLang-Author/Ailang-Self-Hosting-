// Split from cp.ailang. Pools stay on cp.ailang. No Main.

LibraryImport.Arena

Function.WriteStdout {
    Input: str: Address
    Body: {
        len = StringLength(str)
        n = SystemCall(1, 1, str, len)
        IfCondition LessThan(n, len) ThenBlock: {
            SystemCall(60, 1)
        }
    }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.WriteDebug {
    Input: str: Address
    Body: {
        ReturnValue(0)
    }
}

Function.WriteVerbose {
    Input: str: Address
    Body: {
        IfCondition EqualTo(CpConfig.verbose, 1) ThenBlock: {
            WriteStdout(str)
        }
    }
}

Function.WriteSuccess {
    Input: str: Address
    Body: {
        IfCondition EqualTo(CpConfig.verbose, 1) ThenBlock: {
            WriteStdout("✓ ")
            WriteStdout(str)
        }
    }
}

Function.WriteSyscallError {
    Input: error_code: Integer
    Body: {
        // Convert negative error code to positive errno
        errno = Subtract(0, error_code)
        
        // ETXTBSY = 26 (Text file busy)
        IfCondition EqualTo(errno, 26) ThenBlock: {
            WriteStderr("Text file busy")
            ReturnValue(0)
        }
        
        // EEXIST = 17 (File exists)
        IfCondition EqualTo(errno, 17) ThenBlock: {
            WriteStderr("File exists")
            ReturnValue(0)
        }

        // EPERM = 1
        IfCondition EqualTo(errno, 1) ThenBlock: {
            WriteStderr("Operation not permitted")
            ReturnValue(0)
        }
        // ENOENT = 2
        IfCondition EqualTo(errno, 2) ThenBlock: {
            WriteStderr("No such file or directory")
            ReturnValue(0)
        }
        // EACCES = 13
        IfCondition EqualTo(errno, 13) ThenBlock: {
            WriteStderr("Permission denied")
            ReturnValue(0)
        }
        // ENOTDIR = 20
        IfCondition EqualTo(errno, 20) ThenBlock: {
            WriteStderr("Not a directory")
            ReturnValue(0)
        }
        // EISDIR = 21
        IfCondition EqualTo(errno, 21) ThenBlock: {
            WriteStderr("Is a directory")
            ReturnValue(0)
        }
        // EINVAL = 22
        IfCondition EqualTo(errno, 22) ThenBlock: {
            WriteStderr("Invalid argument")
            ReturnValue(0)
        }
        // ENOSPC = 28
        IfCondition EqualTo(errno, 28) ThenBlock: {
            WriteStderr("No space left on device")
            ReturnValue(0)
        }
        // EROFS = 30
        IfCondition EqualTo(errno, 30) ThenBlock: {
            WriteStderr("Read-only file system")
            ReturnValue(0)
        }
        // ENAMETOOLONG = 36
        IfCondition EqualTo(errno, 36) ThenBlock: {
            WriteStderr("File name too long")
            ReturnValue(0)
        }
        // ELOOP = 40
        IfCondition EqualTo(errno, 40) ThenBlock: {
            WriteStderr("Too many levels of symbolic links")
            ReturnValue(0)
        }
        // ENOTSUP = 95
        IfCondition EqualTo(errno, 95) ThenBlock: {
            WriteStderr("Operation not supported")
            ReturnValue(0)
        }

        WriteStderr("Unknown error ")
        err_str = IntToString(errno)
        WriteStderr(err_str)
        Deallocate(err_str, 0)
    }
}

Function.IntToString {
    Input: num: Integer
    Output: Address
    Body: {
        // Handle zero
        IfCondition EqualTo(num, 0) ThenBlock: {
            str = Allocate(2)
            SetByte(str, 0, 48)  // '0'
            SetByte(str, 1, 0)
            ReturnValue(str)
        }
        
        // Handle negative numbers
        is_negative = LessThan(num, 0)
        abs_num = num
        IfCondition EqualTo(is_negative, 1) ThenBlock: {
            abs_num = Subtract(0, num)
        }
        
        // Count digits
        temp = abs_num
        digits = 0
        WhileLoop GreaterThan(temp, 0) {
            temp = Divide(temp, 10)
            digits = Add(digits, 1)
        }
        
        // Calculate total length
        total_len = digits
        IfCondition EqualTo(is_negative, 1) ThenBlock: {
            total_len = Add(total_len, 1)
        }
        
        str = Allocate(Add(total_len, 1))
        
        // Add minus sign if negative
        pos = 0
        IfCondition EqualTo(is_negative, 1) ThenBlock: {
            SetByte(str, 0, 45)  // '-'
            pos = 1
        }
        
        // Fill digits from right to left
        i = Subtract(total_len, 1)
        temp = abs_num
        WhileLoop GreaterThan(temp, 0) {
            digit = Modulo(temp, 10)
            SetByte(str, i, Add(48, digit))
            temp = Divide(temp, 10)
            i = Subtract(i, 1)
        }
        
        SetByte(str, total_len, 0)
        ReturnValue(str)
    }
}

// ============================================================================
// FILE SYSTEM OPERATIONS
// ============================================================================

Function.PathExists {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(4, path, statbuf)
        Deallocate(statbuf, 144)
        ReturnValue(GreaterEqual(result, 0))
    }
}

Function.IsDirectory {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(4, path, statbuf)
        
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        
        st_mode = Dereference(Add(statbuf, 24))
        Deallocate(statbuf, 144)
        
        kind = BitwiseAnd(st_mode, 61440)
        ReturnValue(EqualTo(kind, 16384))
    }
}

Function.IsSymlink {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        // Use lstat (syscall 6) to not follow symlinks
        result = SystemCall(6, path, statbuf)
        
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        
        st_mode = Dereference(Add(statbuf, 24))
        Deallocate(statbuf, 144)
        
        kind = BitwiseAnd(st_mode, 61440)
        ReturnValue(EqualTo(kind, 40960))
    }
}

Function.CopyString {
    Input: src: Address
    Output: Address
    Body: {
        len = StringLength(src)
        dst = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            SetByte(dst, i, GetByte(src, i))
            i = Add(i, 1)
        }
        SetByte(dst, len, 0)
        ReturnValue(dst)
    }
}

Function.RememberLink {
    Input: path: Address
    Body: {
        IfCondition LessThan(CpMade.count, 64) ThenBlock: {
            copy = CopyString(path)
            ArraySet(CpMade.links, CpMade.count, copy)
            CpMade.count = Add(CpMade.count, 1)
        }
    }
}

Function.IsJustCreatedLink {
    Input: path: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, CpMade.count) {
            saved = ArrayGet(CpMade.links, i)
            same = StringEquals(saved, path)
            IfCondition EqualTo(same, 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.CpSymlink {
    Input: source: Address
    Input: dest: Address
    Output: Integer
    Body: {
        buf = Allocate(4096)
        nread = SystemCall(89, source, buf, 4095)
        IfCondition LessThan(nread, 0) ThenBlock: {
            WriteStderr("cp: cannot read symbolic link '")
            WriteStderr(source)
            WriteStderr("'\n")
            Deallocate(buf, 4096)
            ReturnValue(1)
        }
        SetByte(buf, nread, 0)
        statbuf = Allocate(144)
        lres = SystemCall(6, dest, statbuf)
        IfCondition GreaterEqual(lres, 0) ThenBlock: {
            mode = Dereference(Add(statbuf, 24))
            kind = BitwiseAnd(mode, 61440)
            IfCondition NotEqual(kind, 16384) ThenBlock: {
                keep = 0
                IfCondition EqualTo(CpConfig.attributes_only, 1) ThenBlock: {
                    IfCondition EqualTo(CpConfig.remove_dest, 0) ThenBlock: {
                        keep = 1
                    }
                }
                IfCondition EqualTo(keep, 0) ThenBlock: {
                    SystemCall(87, dest)
                }
            }
        }
        Deallocate(statbuf, 144)
        result = SystemCall(88, buf, dest)
        Deallocate(buf, 4096)
        IfCondition LessThan(result, 0) ThenBlock: {
            WriteStderr("cp: cannot create symbolic link '")
            WriteStderr(dest)
            WriteStderr("'\n")
            ReturnValue(1)
        }
        RememberLink(dest)
        IfCondition EqualTo(CpConfig.preserve_time, 1) ThenBlock: {
            tbuf = Allocate(144)
            tres = SystemCall(6, source, tbuf)
            IfCondition GreaterEqual(tres, 0) ThenBlock: {
                SystemCall(280, -100, dest, Add(tbuf, 72), 256)
            }
            Deallocate(tbuf, 144)
        }
        ReturnValue(0)
    }
}

Function.GetUInt32 {
    Input: addr: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        b0 = GetByte(addr, offset)
        b1 = GetByte(addr, Add(offset, 1))
        b2 = GetByte(addr, Add(offset, 2))
        b3 = GetByte(addr, Add(offset, 3))
        value = Add(b0, Multiply(b1, 256))
        value = Add(value, Multiply(b2, 65536))
        value = Add(value, Multiply(b3, 16777216))
        ReturnValue(value)
    }
}

Function.GetFileMode {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(4, path, statbuf)
        
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(420)  // Default: 0644
        }
        
        st_mode = Dereference(Add(statbuf, 24))
        Deallocate(statbuf, 144)
        
        permissions = BitwiseAnd(st_mode, 4095)
        ReturnValue(permissions)
    }
}

Function.GetModTime {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(4, path, statbuf)
        
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        
        // st_mtime at offset 88
        mtime = Dereference(Add(statbuf, 88))
        Deallocate(statbuf, 144)
        ReturnValue(mtime)
    }
}

Function.BuildPath {
    Input: dir: Address
    Input: file: Address
    Output: Address
    Body: {
        dir_len = StringLength(dir)
        file_len = StringLength(file)
        
        // Check if dir ends with slash
        needs_slash = 1
        IfCondition GreaterThan(dir_len, 0) ThenBlock: {
            last_char = GetByte(dir, Subtract(dir_len, 1))
            IfCondition EqualTo(last_char, 47) ThenBlock: {
                needs_slash = 0
            }
        }
        
        total_len = Add(Add(dir_len, file_len), Add(needs_slash, 1))
        path = Allocate(total_len)
        
        // Copy directory
        i = 0
        WhileLoop LessThan(i, dir_len) {
            SetByte(path, i, GetByte(dir, i))
            i = Add(i, 1)
        }
        
        // Add slash if needed
        IfCondition EqualTo(needs_slash, 1) ThenBlock: {
            SetByte(path, i, 47)
            i = Add(i, 1)
        }
        
        // Copy filename
        j = 0
        WhileLoop LessThan(j, file_len) {
            SetByte(path, i, GetByte(file, j))
            i = Add(i, 1)
            j = Add(j, 1)
        }
        
        SetByte(path, i, 0)
        ReturnValue(path)
    }
}

Function.GetBasename {
    Input: path: Address
    Output: Address
    Body: {
        len = StringLength(path)
        
        // Remove trailing slashes
        real_len = len
        WhileLoop And(GreaterThan(real_len, 0), EqualTo(GetByte(path, Subtract(real_len, 1)), 47)) {
            real_len = Subtract(real_len, 1)
        }
        
        // Find last slash in trimmed path
        last_slash = -1
        i = 0
        WhileLoop LessThan(i, real_len) {
            ch = GetByte(path, i)
            IfCondition EqualTo(ch, 47) ThenBlock: {
                last_slash = i
            }
            i = Add(i, 1)
        }
        
        start = Add(last_slash, 1)
        basename_len = Subtract(real_len, start)
        
        // Handle edge case: path is "/"
        IfCondition EqualTo(basename_len, 0) ThenBlock: {
            basename = Allocate(2)
            SetByte(basename, 0, 47)
            SetByte(basename, 1, 0)
            ReturnValue(basename)
        }
        
        basename = Allocate(Add(basename_len, 1))
        i = 0
        WhileLoop LessThan(i, basename_len) {
            SetByte(basename, i, GetByte(path, Add(start, i)))
            i = Add(i, 1)
        }
        SetByte(basename, basename_len, 0)
        
        ReturnValue(basename)
    }
}

Function.WritePerm9 {
    Input: mode: Integer
    Body: {
        buf = Allocate(10)
        chars = "rwxrwxrwx"
        bit = 256
        i = 0
        WhileLoop LessThan(i, 9) {
            hit = BitwiseAnd(mode, bit)
            IfCondition NotEqual(hit, 0) ThenBlock: {
                SetByte(buf, i, GetByte(chars, i))
            } ElseBlock: {
                SetByte(buf, i, 45)
            }
            bit = Divide(bit, 2)
            i = Add(i, 1)
        }
        SetByte(buf, 9, 0)
        WriteStderr(buf)
        Deallocate(buf, 10)
    }
}

Function.WriteOct4 {
    Input: mode: Integer
    Body: {
        low = BitwiseAnd(mode, 4095)
        buf = Allocate(5)
        n = low
        i = 3
        WhileLoop GreaterEqual(i, 0) {
            dig = n
            q = Divide(n, 8)
            dig = Subtract(dig, Multiply(q, 8))
            SetByte(buf, i, Add(48, dig))
            n = q
            i = Subtract(i, 1)
        }
        SetByte(buf, 4, 0)
        WriteStderr(buf)
        Deallocate(buf, 5)
    }
}

Function.PromptOverwrite {
    Input: path: Address
    Output: Integer
    Body: {
        special = 0
        low = 0
        IfCondition EqualTo(CpConfig.force, 1) ThenBlock: {
            sb = Allocate(144)
            rc = SystemCall(6, path, sb)
            IfCondition GreaterEqual(rc, 0) ThenBlock: {
                mode = GetUInt32(sb, 24)
                bits = BitwiseAnd(mode, 146)
                IfCondition EqualTo(bits, 0) ThenBlock: {
                    kind = BitwiseAnd(mode, 61440)
                    IfCondition NotEqual(kind, 40960) ThenBlock: {
                        special = 1
                        low = BitwiseAnd(mode, 4095)
                    }
                }
            }
            Deallocate(sb, 144)
        }
        IfCondition EqualTo(special, 1) ThenBlock: {
            WriteStderr("cp: replace '")
            WriteStderr(path)
            WriteStderr("', overriding mode ")
            WriteOct4(low)
            WriteStderr(" (")
            WritePerm9(low)
            WriteStderr(")? ")
        } ElseBlock: {
            WriteStderr("cp: overwrite '")
            WriteStderr(path)
            WriteStderr("'? (y/n) ")
        }
        
        response = Allocate(8)
        bytes = SystemCall(0, 0, response, 8)
        
        IfCondition LessEqual(bytes, 0) ThenBlock: {
            Deallocate(response, 8)
            ReturnValue(0)
        }
        
        ch = GetByte(response, 0)
        Deallocate(response, 8)
        
        // Accept y or Y
        result = Or(EqualTo(ch, 121), EqualTo(ch, 89))
        ReturnValue(result)
    }
}

// ============================================================================
// CORE COPY FUNCTIONS
// ============================================================================

Function.CpFile {
    Input: source: Address
    Input: dest: Address
    Output: Integer
    Body: {
        WriteDebug("Entering CpFile: ")
        WriteDebug(source)
        WriteDebug(" -> ")
        WriteDebug(dest)
        WriteDebug("\n")
        
        // Check if destination exists
        dest_exists = PathExists(dest)
        
        IfCondition EqualTo(dest_exists, 1) ThenBlock: {
            // Handle no-clobber
            IfCondition EqualTo(CpConfig.no_clobber, 1) ThenBlock: {
                WriteStderr("cp: not replacing '")
                WriteStderr(dest)
                WriteStderr("'\n")
                CpStats.skipped = Add(CpStats.skipped, 1)
                ReturnValue(1)
            }
            IfCondition EqualTo(CpConfig.update, 2) ThenBlock: {
                IfCondition EqualTo(CpConfig.debug, 1) ThenBlock: {
                    WriteStdout("skipped '")
                    WriteStdout(dest)
                    WriteStdout("'\n")
                }
                CpStats.skipped = Add(CpStats.skipped, 1)
                ReturnValue(0)
            }
            
            // Handle update mode
            IfCondition EqualTo(CpConfig.update, 1) ThenBlock: {
                src_mtime = GetModTime(source)
                dst_mtime = GetModTime(dest)
                
                IfCondition LessEqual(src_mtime, dst_mtime) ThenBlock: {
                    WriteVerbose("skipped '")
                    WriteVerbose(dest)
                    WriteVerbose("' (up to date)\n")
                    CpStats.skipped = Add(CpStats.skipped, 1)
                    ReturnValue(0)
                }
            }
            
            // Handle interactive mode
            IfCondition EqualTo(CpConfig.interactive, 1) ThenBlock: {
                should_overwrite = PromptOverwrite(dest)
                IfCondition EqualTo(should_overwrite, 0) ThenBlock: {
                    CpStats.skipped = Add(CpStats.skipped, 1)
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(CpConfig.backup, 1) ThenBlock: {
                backed = TryBackup(source, dest)
                IfCondition NotEqual(backed, 0) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        
        // Open source
        src_fd = SystemCall(2, source, CpConstants.O_RDONLY, 0)
        IfCondition LessThan(src_fd, 0) ThenBlock: {
            WriteStderr("cp: cannot open '")
            WriteStderr(source)
            WriteStderr("': ")
            WriteSyscallError(src_fd)
            WriteStderr("\n")
            ReturnValue(1)
        }
        
        // Plain cp uses the source permission bits. --no-preserve=mode uses
        // 0666. The kernel applies umask either way. Preserving mode opens
        // owner-only, then fchmod after the write.
        mode = 438
        IfCondition EqualTo(CpConfig.explicit_no_mode, 0) ThenBlock: {
            src_mode_buf = Allocate(144)
            src_mode_rc = SystemCall(5, src_fd, src_mode_buf)
            IfCondition GreaterEqual(src_mode_rc, 0) ThenBlock: {
                mode = BitwiseAnd(GetUInt32(src_mode_buf, 24), 511)
            }
            Deallocate(src_mode_buf, 144)
        }
        IfCondition EqualTo(CpConfig.preserve_mode, 1) ThenBlock: {
            mode = 384
        }
        
        // Open/create destination. --attributes-only must not truncate.
        flags = BitwiseOr(CpConstants.O_WRONLY, CpConstants.O_CREAT)
        trunc_it = 1
        IfCondition EqualTo(CpConfig.attributes_only, 1) ThenBlock: {
            IfCondition EqualTo(dest_exists, 1) ThenBlock: {
                trunc_it = 0
            }
        }
        IfCondition EqualTo(trunc_it, 1) ThenBlock: {
            flags = BitwiseOr(flags, CpConstants.O_TRUNC)
        }
        
        dst_fd = SystemCall(2, dest, flags, mode)
        IfCondition LessThan(dst_fd, 0) ThenBlock: {
            IfCondition EqualTo(CpConfig.force, 1) ThenBlock: {
                IfCondition EqualTo(dst_fd, -13) ThenBlock: {
                    SystemCall(87, dest)
                    dst_fd = SystemCall(2, dest, flags, mode)
                }
            }
        }
        IfCondition LessThan(dst_fd, 0) ThenBlock: {
            slash_dest = EndsSlash(dest)
            IfCondition EqualTo(slash_dest, 1) ThenBlock: {
                IfCondition EqualTo(dst_fd, -21) ThenBlock: {
                    WriteStderr("cp: cannot create regular file '")
                    WriteStderr(dest)
                    WriteStderr("': Not a directory\n")
                    SystemCall(3, src_fd)
                    ReturnValue(1)
                }
            }
            WriteStderr("cp: cannot create regular file '")
            WriteStderr(dest)
            WriteStderr("': ")
            WriteSyscallError(dst_fd)
            WriteStderr("\n")
            SystemCall(3, src_fd)
            ReturnValue(1)
        }
        IfCondition EqualTo(CpConfig.preserve_mode, 1) ThenBlock: {
            SystemCall(91, dst_fd, 384)
        }
        
        // Copy data unless only attributes were requested.
        // A sparse source (fewer allocated blocks than its size) is copied
        // with SEEK_DATA/SEEK_HOLE. --sparse=always also punches zero buffers.
        buffer = Allocate(CpConstants.BUFFER_SIZE)
        total_bytes = 0
        logical = 0
        filepos = 0
        CpWalk.how = 0
        use_seek = 0
        ssize = 0
        IfCondition EqualTo(CpConfig.attributes_only, 0) ThenBlock: {
            IfCondition NotEqual(CpConfig.sparse, 2) ThenBlock: {
                sb = Allocate(144)
                fs = SystemCall(5, src_fd, sb)
                sblocks = 0
                IfCondition GreaterEqual(fs, 0) ThenBlock: {
                    sblocks = GetUInt32(sb, 64)
                }
                Deallocate(sb, 144)
                ssize = SystemCall(8, src_fd, 0, 2)
                SystemCall(8, src_fd, 0, 0)
                IfCondition GreaterThan(ssize, 0) ThenBlock: {
                    allocb = Multiply(sblocks, 512)
                    IfCondition LessThan(allocb, ssize) ThenBlock: {
                        use_seek = 1
                    }
                }
            }
            IfCondition EqualTo(use_seek, 1) ThenBlock: {
                dseek = SystemCall(8, dst_fd, 0, 1)
                IfCondition LessThan(dseek, 0) ThenBlock: {
                    use_seek = 0
                }
            }
        }
        IfCondition EqualTo(CpConfig.attributes_only, 0) ThenBlock: {
            IfCondition EqualTo(use_seek, 1) ThenBlock: {
                CpWalk.how = 2
                data_off = SystemCall(8, src_fd, 0, 3)
                IfCondition LessThan(data_off, 0) ThenBlock: {
                    IfCondition NotEqual(data_off, -6) ThenBlock: {
                        use_seek = 0
                        CpWalk.how = 0
                        SystemCall(8, src_fd, 0, 0)
                    } ElseBlock: {
                        logical = ssize
                    }
                }
            }
            IfCondition EqualTo(use_seek, 1) ThenBlock: {
                WhileLoop GreaterEqual(data_off, 0) {
                    IfCondition GreaterEqual(data_off, ssize) ThenBlock: {
                        BreakLoop
                    }
                    hole = SystemCall(8, src_fd, data_off, 4)
                    IfCondition LessThan(hole, 0) ThenBlock: { hole = ssize }
                    IfCondition GreaterThan(hole, ssize) ThenBlock: { hole = ssize }
                    IfCondition LessThan(hole, data_off) ThenBlock: { hole = data_off }
                    SystemCall(8, src_fd, data_off, 0)
                    remain = Subtract(hole, data_off)
                    write_at = data_off
                    WhileLoop GreaterThan(remain, 0) {
                        chunk = CpConstants.BUFFER_SIZE
                        IfCondition GreaterThan(chunk, remain) ThenBlock: { chunk = remain }
                        nread = SystemCall(0, src_fd, buffer, chunk)
                        IfCondition LessEqual(nread, 0) ThenBlock: {
                            remain = 0
                        } ElseBlock: {
                            skip_hole = 0
                            IfCondition EqualTo(CpConfig.sparse, 1) ThenBlock: {
                                z = AllZero(buffer, nread)
                                IfCondition EqualTo(z, 1) ThenBlock: {
                                    skip_hole = 1
                                    CpWalk.how = 3
                                }
                            }
                            IfCondition EqualTo(skip_hole, 1) ThenBlock: {
                                write_at = Add(write_at, nread)
                            } ElseBlock: {
                                IfCondition NotEqual(write_at, filepos) ThenBlock: {
                                    SystemCall(8, dst_fd, write_at, 0)
                                    filepos = write_at
                                }
                                bytes_written = SystemCall(1, dst_fd, buffer, nread)
                                IfCondition NotEqual(bytes_written, nread) ThenBlock: {
                                    WriteStderr("cp: write error to '")
                                    WriteStderr(dest)
                                    WriteStderr("'\n")
                                    Deallocate(buffer, CpConstants.BUFFER_SIZE)
                                    SystemCall(3, src_fd)
                                    SystemCall(3, dst_fd)
                                    ReturnValue(1)
                                }
                                write_at = Add(write_at, bytes_written)
                                filepos = Add(filepos, bytes_written)
                                total_bytes = Add(total_bytes, bytes_written)
                            }
                            remain = Subtract(remain, nread)
                        }
                    }
                    logical = hole
                    data_off = SystemCall(8, src_fd, hole, 3)
                }
                IfCondition LessThan(filepos, ssize) ThenBlock: {
                    SystemCall(77, dst_fd, ssize)
                    logical = ssize
                    filepos = ssize
                }
            }
            IfCondition EqualTo(use_seek, 0) ThenBlock: {
                WhileLoop 1 {
                    bytes_read = SystemCall(0, src_fd, buffer, CpConstants.BUFFER_SIZE)
                    IfCondition LessEqual(bytes_read, 0) ThenBlock: {
                        BreakLoop
                    }
                    skip_hole = 0
                    IfCondition EqualTo(CpConfig.sparse, 1) ThenBlock: {
                        z = AllZero(buffer, bytes_read)
                        IfCondition EqualTo(z, 1) ThenBlock: {
                            skip_hole = 1
                            CpWalk.how = 1
                        }
                    }
                    IfCondition EqualTo(skip_hole, 1) ThenBlock: {
                        logical = Add(logical, bytes_read)
                    } ElseBlock: {
                        IfCondition NotEqual(logical, filepos) ThenBlock: {
                            SystemCall(8, dst_fd, logical, 0)
                            filepos = logical
                        }
                        bytes_written = SystemCall(1, dst_fd, buffer, bytes_read)
                        IfCondition NotEqual(bytes_written, bytes_read) ThenBlock: {
                            WriteStderr("cp: write error to '")
                            WriteStderr(dest)
                            WriteStderr("'\n")
                            Deallocate(buffer, CpConstants.BUFFER_SIZE)
                            SystemCall(3, src_fd)
                            SystemCall(3, dst_fd)
                            ReturnValue(1)
                        }
                        logical = Add(logical, bytes_written)
                        filepos = Add(filepos, bytes_written)
                        total_bytes = Add(total_bytes, bytes_written)
                    }
                }
                IfCondition NotEqual(logical, filepos) ThenBlock: {
                    SystemCall(77, dst_fd, logical)
                }
            }
        }
        
        Deallocate(buffer, CpConstants.BUFFER_SIZE)
        statbuf = Allocate(144)
        sres = SystemCall(6, source, statbuf)
        // chown first. A failed chown clears setuid, setgid, and sticky
        // before fchmod, matching GNU: a non-root cp -p must not leave
        // those bits on a file whose owner it could not keep.
        own_bad = 0
        strip_special = 0
        IfCondition GreaterEqual(sres, 0) ThenBlock: {
            IfCondition EqualTo(CpConfig.preserve_owner, 1) ThenBlock: {
                puid = GetUInt32(statbuf, 28)
                pgid = GetUInt32(statbuf, 32)
                own = SystemCall(93, dst_fd, puid, pgid)
                IfCondition LessThan(own, 0) ThenBlock: {
                    own_err = Subtract(0, own)
                    retry_gid = 0
                    IfCondition EqualTo(own_err, 1) ThenBlock: { retry_gid = 1 }
                    IfCondition EqualTo(own_err, 22) ThenBlock: { retry_gid = 1 }
                    IfCondition EqualTo(retry_gid, 1) ThenBlock: {
                        SystemCall(93, dst_fd, -1, pgid)
                        euid = SystemCall(107)
                        IfCondition EqualTo(euid, 0) ThenBlock: {
                            own_bad = 1
                        } ElseBlock: {
                            strip_special = 1
                        }
                    } ElseBlock: {
                        own_bad = 1
                    }
                    IfCondition EqualTo(own_bad, 1) ThenBlock: {
                        WriteStderr("cp: failed to preserve ownership for '")
                        WriteStderr(dest)
                        WriteStderr("': ")
                        WriteSyscallError(own)
                        WriteStderr("\n")
                    }
                }
            }
            IfCondition EqualTo(own_bad, 0) ThenBlock: {
                IfCondition EqualTo(CpConfig.preserve_mode, 1) ThenBlock: {
                    pmode = GetUInt32(statbuf, 24)
                    pmode = BitwiseAnd(pmode, 4095)
                    IfCondition EqualTo(strip_special, 1) ThenBlock: {
                        pmode = BitwiseAnd(pmode, 511)
                    }
                    SystemCall(91, dst_fd, pmode)
                }
            }
        }
        SystemCall(3, src_fd)
        SystemCall(3, dst_fd)
        IfCondition EqualTo(own_bad, 1) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(1)
        }
        IfCondition EqualTo(CpConfig.preserve_time, 1) ThenBlock: {
            IfCondition GreaterEqual(sres, 0) ThenBlock: {
                SystemCall(280, -100, dest, Add(statbuf, 72), 0)
            }
        }
        Deallocate(statbuf, 144)
        CopyAcl(source, dest)
        
        // Update statistics
        CpStats.files_copied = Add(CpStats.files_copied, 1)
        CpStats.bytes_copied = Add(CpStats.bytes_copied, total_bytes)
        
        WriteVerbose("'")
        WriteVerbose(source)
        WriteVerbose("' -> '")
        WriteVerbose(dest)
        WriteVerbose("'\n")
        IfCondition EqualTo(CpConfig.debug, 1) ThenBlock: {
            IfCondition EqualTo(CpConfig.attributes_only, 0) ThenBlock: {
                IfCondition EqualTo(CpConfig.sparse, 2) ThenBlock: {
                    WriteStdout("copy offload: avoided, reflink: no, sparse detection: no\n")
                } ElseBlock: {
                    IfCondition EqualTo(CpWalk.how, 3) ThenBlock: {
                        WriteStdout("copy offload: yes, reflink: unsupported, sparse detection: SEEK_HOLE + zeros\n")
                    } ElseBlock: {
                        IfCondition EqualTo(CpWalk.how, 2) ThenBlock: {
                            WriteStdout("copy offload: yes, reflink: unsupported, sparse detection: SEEK_HOLE\n")
                        } ElseBlock: {
                            IfCondition EqualTo(CpWalk.how, 1) ThenBlock: {
                                WriteStdout("copy offload: yes, reflink: unsupported, sparse detection: zeros\n")
                            } ElseBlock: {
                                WriteStdout("copy offload: yes, reflink: unsupported, sparse detection: no\n")
                            }
                        }
                    }
                }
            }
        }
        
        ReturnValue(0)
    }
}

Function.AllZero {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition NotEqual(GetByte(buf, i), 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.CopyAcl {
    Input: source: Address
    Input: dest: Address
    Body: {
        IfCondition EqualTo(CpConfig.preserve_mode, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf = Allocate(512)
        n = SystemCall(191, source, "system.posix_acl_access", buf, 512)
        IfCondition GreaterThan(n, 0) ThenBlock: {
            SystemCall(188, dest, "system.posix_acl_access", buf, n, 0)
        }
        Deallocate(buf, 512)
    }
}

Function.CpDirectory {
    Input: source: Address
    Input: dest: Address
    Output: Integer
    Body: {
        WriteDebug("Entering CpDirectory: ")
        WriteDebug(source)
        WriteDebug(" -> ")
        WriteDebug(dest)
        WriteDebug("\n")
        
        // Preserve keeps the new directory owner-only until children are copied.
        dir_mode = 493
        IfCondition EqualTo(CpConfig.preserve_mode, 1) ThenBlock: {
            dir_mode = 448
        }
        IfCondition EqualTo(CpConfig.preserve_owner, 1) ThenBlock: {
            dir_mode = 448
        }
        mkdir_result = SystemCall(83, dest, dir_mode)
        created_dir = 0
        IfCondition GreaterEqual(mkdir_result, 0) ThenBlock: {
            created_dir = 1
        }
        
        IfCondition LessThan(mkdir_result, 0) ThenBlock: {
            // Check if EEXIST
            abs_error = Subtract(0, mkdir_result)
            IfCondition EqualTo(abs_error, CpConstants.EEXIST) ThenBlock: {
                // Directory exists - verify it's actually a directory
                is_dir = IsDirectory(dest)
                IfCondition EqualTo(is_dir, 0) ThenBlock: {
                    WriteStderr("cp: cannot overwrite non-directory '")
                    WriteStderr(dest)
                    WriteStderr("' with directory '")
                    WriteStderr(source)
                    WriteStderr("'\n")
                    ReturnValue(1)
                }
                WriteDebug("Directory already exists, continuing\n")
            } ElseBlock: {
                WriteStderr("cp: cannot create directory '")
                WriteStderr(dest)
                WriteStderr("': ")
                WriteSyscallError(mkdir_result)
                WriteStderr("\n")
                ReturnValue(1)
            }
        } ElseBlock: {
            CpStats.dirs_created = Add(CpStats.dirs_created, 1)
            WriteVerbose("'")
            WriteVerbose(source)
            WriteVerbose("' -> '")
            WriteVerbose(dest)
            WriteVerbose("'\n")
        }
        
        // Open source directory
        flags = BitwiseOr(CpConstants.O_RDONLY, CpConstants.O_DIRECTORY)
        dir_fd = SystemCall(257, CpConstants.AT_FDCWD, source, flags, 0)
        
        IfCondition LessThan(dir_fd, 0) ThenBlock: {
            WriteStderr("cp: cannot open directory '")
            WriteStderr(source)
            WriteStderr("': ")
            WriteSyscallError(dir_fd)
            WriteStderr("\n")
            ReturnValue(1)
        }
        
        // Read directory entries. 512 bytes stays in a slab the process
        // warms up front, so a huge tree does not mmap another 4MB chunk.
        buffer = Allocate(512)
        errors = 0
        
        WhileLoop 1 {
            bytes_read = SystemCall(217, dir_fd, buffer, 512)
            
            IfCondition LessEqual(bytes_read, 0) ThenBlock: {
                BreakLoop
            }
            
            // Parse entries
            pos = 0
            WhileLoop LessThan(pos, bytes_read) {
                // Read d_reclen (2 bytes at offset 16)
                d_reclen = Add(GetByte(buffer, Add(pos, 16)), 
                              Multiply(GetByte(buffer, Add(pos, 17)), 256))
                d_type = GetByte(buffer, Add(pos, 18))
                name_start = Add(pos, 19)
                
                // Extract name
                name_len = 0
                WhileLoop 1 {
                    ch = GetByte(buffer, Add(name_start, name_len))
                    IfCondition EqualTo(ch, 0) ThenBlock: {
                        BreakLoop
                    }
                    name_len = Add(name_len, 1)
                }
                
                name = Allocate(Add(name_len, 1))
                i = 0
                WhileLoop LessThan(i, name_len) {
                    SetByte(name, i, GetByte(buffer, Add(name_start, i)))
                    i = Add(i, 1)
                }
                SetByte(name, name_len, 0)
                
                // Skip "." and ".."
                is_dot = And(EqualTo(name_len, 1), EqualTo(GetByte(name, 0), 46))
                is_dotdot = And(EqualTo(name_len, 2), 
                               And(EqualTo(GetByte(name, 0), 46), 
                                   EqualTo(GetByte(name, 1), 46)))
                
                IfCondition Not(Or(is_dot, is_dotdot)) ThenBlock: {
                    src_path = BuildPath(source, name)
                    dst_path = BuildPath(dest, name)
                    
                    copy_result = CopyEntry(src_path, dst_path, 0)
                    
                    IfCondition NotEqual(copy_result, 0) ThenBlock: {
                        errors = Add(errors, 1)
                    }
                    
                    src_n = StringLength(src_path)
                    dst_n = StringLength(dst_path)
                    Deallocate(src_path, Add(src_n, 1))
                    Deallocate(dst_path, Add(dst_n, 1))
                }
                
                Deallocate(name, Add(name_len, 1))
                pos = Add(pos, d_reclen)
            }
        }
        
        Deallocate(buffer, 512)
        SystemCall(3, dir_fd)

        IfCondition EqualTo(created_dir, 1) ThenBlock: {
            src_stat = Allocate(144)
            sres = SystemCall(6, source, src_stat)
            IfCondition GreaterEqual(sres, 0) ThenBlock: {
                IfCondition EqualTo(CpConfig.preserve_mode, 1) ThenBlock: {
                    dmode = GetUInt32(src_stat, 24)
                    dmode = BitwiseAnd(dmode, 4095)
                    SystemCall(90, dest, dmode)
                }
                IfCondition EqualTo(CpConfig.preserve_owner, 1) ThenBlock: {
                    duid = GetUInt32(src_stat, 28)
                    dgid = GetUInt32(src_stat, 32)
                    SystemCall(92, dest, duid, dgid)
                }
            }
            Deallocate(src_stat, 144)
            IfCondition EqualTo(CpConfig.preserve_time, 1) ThenBlock: {
                tbuf = Allocate(144)
                tres = SystemCall(6, source, tbuf)
                IfCondition GreaterEqual(tres, 0) ThenBlock: {
                    SystemCall(280, -100, dest, Add(tbuf, 72), 0)
                }
                Deallocate(tbuf, 144)
            }
        }
        
        ReturnValue(errors)
    }
}

// Option name after "--" is a non-empty prefix of word, ended by NUL or '='.
