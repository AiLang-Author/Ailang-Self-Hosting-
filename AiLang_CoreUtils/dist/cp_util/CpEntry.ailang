// Split from cp.ailang. Pools stay on cp.ailang. No Main.

LibraryImport.Arena

Function.CpSpecial {
    Input: source: Address
    Input: dest: Address
    Output: Integer
    Body: {
        buf = Allocate(144)
        res = SystemCall(6, source, buf)
        IfCondition LessThan(res, 0) ThenBlock: {
            WriteStderr("cp: cannot stat '")
            WriteStderr(source)
            WriteStderr("': ")
            WriteSyscallError(res)
            WriteStderr("\n")
            Deallocate(buf, 144)
            ReturnValue(1)
        }
        mode = GetUInt32(buf, 24)
        kind = BitwiseAnd(mode, 61440)
        rlo = GetUInt32(buf, 40)
        rhi = GetUInt32(buf, 44)
        Deallocate(buf, 144)
        perm = 438
        IfCondition EqualTo(CpConfig.preserve_mode, 1) ThenBlock: {
            perm = BitwiseAnd(mode, 4095)
        }
        mmode = BitwiseOr(kind, perm)
        db = Allocate(144)
        dres = SystemCall(6, dest, db)
        IfCondition GreaterEqual(dres, 0) ThenBlock: {
            dkind = BitwiseAnd(GetUInt32(db, 24), 61440)
            unlink_it = 0
            IfCondition EqualTo(CpConfig.force, 1) ThenBlock: { unlink_it = 1 }
            IfCondition EqualTo(CpConfig.remove_dest, 1) ThenBlock: { unlink_it = 1 }
            IfCondition NotEqual(dkind, kind) ThenBlock: { unlink_it = 1 }
            IfCondition EqualTo(unlink_it, 1) ThenBlock: {
                SystemCall(87, dest)
            } ElseBlock: {
                WriteStderr("cp: cannot create special file '")
                WriteStderr(dest)
                WriteStderr("': File exists\n")
                Deallocate(db, 144)
                ReturnValue(1)
            }
        }
        Deallocate(db, 144)
        rdev = rlo
        IfCondition NotEqual(rhi, 0) ThenBlock: {
            rdev = Add(rlo, Multiply(rhi, 4294967296))
        }
        mk = SystemCall(133, dest, mmode, rdev)
        IfCondition LessThan(mk, 0) ThenBlock: {
            WriteStderr("cp: cannot create special file '")
            WriteStderr(dest)
            WriteStderr("': ")
            WriteSyscallError(mk)
            WriteStderr("\n")
            ReturnValue(1)
        }
        IfCondition EqualTo(CpConfig.preserve_owner, 1) ThenBlock: {
            sb = Allocate(144)
            sr = SystemCall(6, source, sb)
            IfCondition GreaterEqual(sr, 0) ThenBlock: {
                SystemCall(92, dest, GetUInt32(sb, 28), GetUInt32(sb, 32))
            }
            Deallocate(sb, 144)
        }
        IfCondition EqualTo(CpConfig.preserve_time, 1) ThenBlock: {
            tb = Allocate(144)
            tr = SystemCall(6, source, tb)
            IfCondition GreaterEqual(tr, 0) ThenBlock: {
                SystemCall(280, -100, dest, Add(tb, 72), 0)
            }
            Deallocate(tb, 144)
        }
        WriteVerbose("'")
        WriteVerbose(source)
        WriteVerbose("' -> '")
        WriteVerbose(dest)
        WriteVerbose("'\n")
        ReturnValue(0)
    }
}

Function.CpLinkOrSym {
    Input: source: Address
    Input: dest: Address
    Input: follow: Integer
    Output: Integer
    Body: {
        db = Allocate(144)
        dres = SystemCall(6, dest, db)
        Deallocate(db, 144)
        IfCondition GreaterEqual(dres, 0) ThenBlock: {
            moved = 0
            IfCondition EqualTo(CpConfig.backup, 1) ThenBlock: {
                moved = 1
                bak = BackupDest(dest)
                IfCondition NotEqual(bak, 0) ThenBlock: {
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(moved, 0) ThenBlock: {
                drop = Or(EqualTo(CpConfig.force, 1), EqualTo(CpConfig.remove_dest, 1))
                IfCondition EqualTo(drop, 1) ThenBlock: {
                    SystemCall(87, dest)
                } ElseBlock: {
                    IfCondition EqualTo(CpConfig.hardlink, 1) ThenBlock: {
                        WriteStderr("cp: cannot create hard link '")
                        WriteStderr(dest)
                        WriteStderr("' to '")
                        WriteStderr(source)
                        WriteStderr("'\n")
                    } ElseBlock: {
                        WriteStderr("cp: cannot create symbolic link '")
                        WriteStderr(dest)
                        WriteStderr("' to '")
                        WriteStderr(source)
                        WriteStderr("'\n")
                    }
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(CpConfig.hardlink, 1) ThenBlock: {
            flags = 0
            IfCondition EqualTo(follow, 1) ThenBlock: {
                flags = 1024
            }
            r = SystemCall(265, -100, source, -100, dest, flags)
            IfCondition LessThan(r, 0) ThenBlock: {
                WriteStderr("cp: cannot create hard link '")
                WriteStderr(dest)
                WriteStderr("' to '")
                WriteStderr(source)
                WriteStderr("'\n")
                ReturnValue(1)
            }
        } ElseBlock: {
            r = SystemCall(88, source, dest)
            IfCondition LessThan(r, 0) ThenBlock: {
                WriteStderr("cp: cannot create symbolic link '")
                WriteStderr(dest)
                WriteStderr("' to '")
                WriteStderr(source)
                WriteStderr("'\n")
                ReturnValue(1)
            }
            RememberLink(dest)
        }
        WriteVerbose("'")
        WriteVerbose(source)
        WriteVerbose("' -> '")
        WriteVerbose(dest)
        WriteVerbose("'\n")
        ReturnValue(0)
    }
}

Function.CreateParents {
    Input: full: Address
    Input: root_len: Integer
    Output: Integer
    Body: {
        len = StringLength(full)
        CpWalk.mark = -1
        i = root_len
        WhileLoop LessThan(i, len) {
            IfCondition EqualTo(RDMEM_8(full, i), 47) ThenBlock: {
                CpWalk.mark = i
            }
            i = Add(i, 1)
        }
        stop = CpWalk.mark
        IfCondition LessThan(stop, 0) ThenBlock: {
            ReturnValue(0)
        }
        i = root_len
        WhileLoop LessEqual(i, stop) {
            boundary = 0
            IfCondition EqualTo(i, stop) ThenBlock: { boundary = 1 }
            IfCondition EqualTo(RDMEM_8(full, i), 47) ThenBlock: {
                IfCondition GreaterThan(i, root_len) ThenBlock: { boundary = 1 }
            }
            IfCondition EqualTo(boundary, 1) ThenBlock: {
                WRMEM_8(full, i, 0)
                src_off = Add(root_len, 1)
                IfCondition GreaterThan(root_len, 0) ThenBlock: {
                    IfCondition EqualTo(RDMEM_8(full, Subtract(root_len, 1)), 47) ThenBlock: {
                        src_off = root_len
                    }
                }
                src_part = Add(full, src_off)
                inside = 0
                IfCondition GreaterThan(i, src_off) ThenBlock: { inside = 1 }
                sb = Allocate(144)
                sr = SystemCall(4, src_part, sb)
                is_dir = 0
                IfCondition GreaterEqual(sr, 0) ThenBlock: {
                    skind = BitwiseAnd(GetUInt32(sb, 24), 61440)
                    IfCondition EqualTo(skind, 16384) ThenBlock: { is_dir = 1 }
                }
                IfCondition EqualTo(inside, 1) ThenBlock: {
                    IfCondition EqualTo(is_dir, 0) ThenBlock: {
                        WriteStderr("cp: failed to get attributes of '")
                        WriteStderr(src_part)
                        WriteStderr("': ")
                        IfCondition LessThan(sr, 0) ThenBlock: {
                            WriteSyscallError(sr)
                        } ElseBlock: {
                            WriteStderr("Not a directory")
                        }
                        WriteStderr("\n")
                        Deallocate(sb, 144)
                        WRMEM_8(full, i, 47)
                        ReturnValue(1)
                    }
                }
                mkmode = 493
                IfCondition EqualTo(CpConfig.preserve_mode, 1) ThenBlock: { mkmode = 448 }
                IfCondition EqualTo(CpConfig.preserve_owner, 1) ThenBlock: { mkmode = 448 }
                mk = SystemCall(83, full, mkmode)
                IfCondition GreaterEqual(mk, 0) ThenBlock: {
                    CpStats.dirs_created = Add(CpStats.dirs_created, 1)
                }
                IfCondition EqualTo(CpConfig.preserve_mode, 1) ThenBlock: {
                    IfCondition EqualTo(is_dir, 1) ThenBlock: {
                        dmode = BitwiseAnd(GetUInt32(sb, 24), 4095)
                        SystemCall(90, full, dmode)
                    }
                }
                Deallocate(sb, 144)
                WRMEM_8(full, i, 47)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.CopyEntry {
    Input: source: Address
    Input: dest: Address
    Input: cmdline: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CpConfig.parents, 1) ThenBlock: {
            IfCondition EqualTo(cmdline, 1) ThenBlock: {
                IfCondition EqualTo(IsDirectory(dest), 1) ThenBlock: {
                    root_len = StringLength(dest)
                    full = BuildPath(dest, source)
                    pok = CreateParents(full, root_len)
                    IfCondition EqualTo(pok, 1) ThenBlock: {
                        Deallocate(full, 0)
                        ReturnValue(1)
                    }
                    CpConfig.parents = 0
                    pres = CopyEntry(source, full, 0)
                    CpConfig.parents = 1
                    Deallocate(full, 0)
                    ReturnValue(pres)
                }
                WriteStderr("cp: with --parents, the destination must be a directory\n")
                ReturnValue(1)
            }
        }

        slash = EndsSlash(source)
        is_link = 0
        IfCondition EqualTo(slash, 0) ThenBlock: {
            is_link = IsSymlink(source)
        }
        follow = 0
        IfCondition EqualTo(slash, 1) ThenBlock: {
            follow = 1
        }
        IfCondition EqualTo(is_link, 1) ThenBlock: {
            IfCondition EqualTo(CpConfig.deref_all, 1) ThenBlock: { follow = 1 }
            IfCondition EqualTo(CpConfig.no_dereference, 1) ThenBlock: { follow = 0 }
            IfCondition EqualTo(CpConfig.deref_all, 0) ThenBlock: {
                IfCondition EqualTo(CpConfig.no_dereference, 0) ThenBlock: {
                    IfCondition EqualTo(CpConfig.hardlink, 1) ThenBlock: {
                        follow = 1
                    } ElseBlock: {
                        IfCondition EqualTo(CpConfig.recursive, 0) ThenBlock: {
                            follow = 1
                        } ElseBlock: {
                            IfCondition EqualTo(cmdline, 1) ThenBlock: {
                                IfCondition EqualTo(CpConfig.deref_cmdline, 1) ThenBlock: {
                                    follow = 1
                                }
                            }
                        }
                    }
                }
            }
        }

        link_op = Or(EqualTo(CpConfig.hardlink, 1), EqualTo(CpConfig.make_symlink, 1))

        // Hard-linking a name that already reaches the same file is a no-op,
        // unless the destination itself is a symlink we were asked to replace.
        IfCondition EqualTo(CpConfig.hardlink, 1) ThenBlock: {
            same_name_hl = StringEquals(source, dest)
            IfCondition EqualTo(same_name_hl, 0) ThenBlock: {
                same_link = StatSame(source, dest, 0)
                IfCondition EqualTo(same_link, 1) ThenBlock: {
                    dkind_now = FileKind(dest, 0)
                    keep = 0
                    IfCondition EqualTo(CpConfig.no_dereference, 1) ThenBlock: { keep = 1 }
                    IfCondition NotEqual(dkind_now, 40960) ThenBlock: { keep = 1 }
                    IfCondition EqualTo(keep, 1) ThenBlock: {
                        ReturnValue(0)
                    }
                }
                already = StatSame(source, dest, 1)
                IfCondition EqualTo(already, 1) ThenBlock: {
                    dkind_now = FileKind(dest, 0)
                    IfCondition NotEqual(dkind_now, 40960) ThenBlock: {
                        ReturnValue(0)
                    }
                }
            }
        }

        same = StatSame(source, dest, 1)
        IfCondition EqualTo(same, 1) ThenBlock: {
            same_name = StringEquals(source, dest)
            IfCondition EqualTo(same_name, 1) ThenBlock: {
                aside = 0
                IfCondition EqualTo(CpConfig.force, 1) ThenBlock: {
                    IfCondition EqualTo(CpConfig.backup, 1) ThenBlock: {
                        skind = FileKind(source, 0)
                        IfCondition EqualTo(skind, 32768) ThenBlock: {
                            aside = 1
                        }
                    }
                }
                IfCondition EqualTo(aside, 1) ThenBlock: {
                    bname = 0
                    IfCondition EqualTo(CpConfig.numbered, 1) ThenBlock: {
                        bname = NumberedFreeName(dest)
                    } ElseBlock: {
                        bname = SimpleBackupName(dest)
                    }
                    IfCondition EqualTo(bname, 0) ThenBlock: {
                        ReturnValue(1)
                    }
                    saved_backup = CpConfig.backup
                    CpConfig.backup = 0
                    aside_result = CpFile(source, bname)
                    CpConfig.backup = saved_backup
                    Deallocate(bname, 0)
                    ReturnValue(aside_result)
                }
                IfCondition EqualTo(CpConfig.hardlink, 1) ThenBlock: {
                    ReturnValue(0)
                }
                SaySameFile(source, dest)
                ReturnValue(1)
            }

            src_kind = FileKind(source, 0)
            dst_kind = FileKind(dest, 0)
            src_link = EqualTo(src_kind, 40960)
            dst_link = EqualTo(dst_kind, 40960)
            block_backup = 0
            IfCondition EqualTo(src_link, 1) ThenBlock: {
                IfCondition EqualTo(dst_link, 0) ThenBlock: {
                    IfCondition EqualTo(CpConfig.no_dereference, 0) ThenBlock: {
                        block_backup = 1
                    }
                }
            }
            handled = 0
            IfCondition EqualTo(CpConfig.backup, 1) ThenBlock: {
                IfCondition EqualTo(block_backup, 1) ThenBlock: {
                    SaySameFile(source, dest)
                    ReturnValue(1)
                }
                bak = BackupDest(dest)
                IfCondition NotEqual(bak, 0) ThenBlock: {
                    ReturnValue(1)
                }
                handled = 1
            }
            IfCondition EqualTo(handled, 0) ThenBlock: {
                IfCondition EqualTo(CpConfig.remove_dest, 1) ThenBlock: {
                    IfCondition EqualTo(block_backup, 1) ThenBlock: {
                        SaySameFile(source, dest)
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(CpConfig.no_dereference, 1) ThenBlock: {
                        IfCondition EqualTo(src_link, 1) ThenBlock: {
                            IfCondition EqualTo(dst_link, 0) ThenBlock: {
                                SaySameFile(source, dest)
                                ReturnValue(1)
                            }
                        }
                    }
                    SystemCall(87, dest)
                    handled = 1
                }
            }
            IfCondition EqualTo(handled, 0) ThenBlock: {
                IfCondition EqualTo(CpConfig.make_symlink, 1) ThenBlock: {
                    dkind_sym = FileKind(dest, 0)
                    IfCondition NotEqual(dkind_sym, 40960) ThenBlock: {
                        SaySameFile(source, dest)
                        ReturnValue(1)
                    }
                    handled = 1
                }
            }
            IfCondition EqualTo(handled, 0) ThenBlock: {
                IfCondition EqualTo(link_op, 1) ThenBlock: {
                    handled = 1
                }
            }
            IfCondition EqualTo(handled, 0) ThenBlock: {
                allow_link = 0
                IfCondition EqualTo(src_link, 1) ThenBlock: {
                    IfCondition EqualTo(dst_link, 1) ThenBlock: {
                        IfCondition EqualTo(CpConfig.no_dereference, 1) ThenBlock: {
                            allow_link = 1
                        }
                    }
                }
                IfCondition EqualTo(allow_link, 0) ThenBlock: {
                    SaySameFile(source, dest)
                    ReturnValue(1)
                }
            }
        }

        IfCondition EqualTo(link_op, 1) ThenBlock: {
            IfCondition EqualTo(CpConfig.hardlink, 1) ThenBlock: {
                IfCondition EqualTo(follow, 1) ThenBlock: {
                    lsb = Allocate(144)
                    lsr = SystemCall(4, source, lsb)
                    Deallocate(lsb, 144)
                    IfCondition LessThan(lsr, 0) ThenBlock: {
                        WriteStderr("cp: cannot stat '")
                        WriteStderr(source)
                        WriteStderr("': ")
                        WriteSyscallError(lsr)
                        WriteStderr("\n")
                        ReturnValue(1)
                    }
                }
            }
            dir_link = 0
            IfCondition EqualTo(CpConfig.hardlink, 1) ThenBlock: {
                link_kind = FileKind(source, follow)
                IfCondition EqualTo(link_kind, 16384) ThenBlock: {
                    dir_link = 1
                }
            }
            IfCondition EqualTo(dir_link, 0) ThenBlock: {
                link_result = CpLinkOrSym(source, dest, follow)
                ReturnValue(link_result)
            }
        }

        IfCondition EqualTo(is_link, 1) ThenBlock: {
            IfCondition EqualTo(follow, 0) ThenBlock: {
                IfCondition EqualTo(CpConfig.warn_r, 1) ThenBlock: {
                    WriteStderr("cp: '")
                    WriteStderr(source)
                    WriteStderr("': WARNING: using -r to copy symbolic links is not portable\n")
                }
                linked_copy = CpSymlink(source, dest)
                ReturnValue(linked_copy)
            }
        }

        db = Allocate(144)
        dres = SystemCall(6, dest, db)
        dest_is_link = 0
        IfCondition GreaterEqual(dres, 0) ThenBlock: {
            dkind = BitwiseAnd(GetUInt32(db, 24), 61440)
            IfCondition EqualTo(dkind, 40960) ThenBlock: {
                dest_is_link = 1
            }
        }
        Deallocate(db, 144)
        IfCondition EqualTo(dest_is_link, 1) ThenBlock: {
            sb = Allocate(144)
            sres = SystemCall(4, dest, sb)
            Deallocate(sb, 144)
            IfCondition LessThan(sres, 0) ThenBlock: {
                errno = Subtract(0, sres)
                dangling = EqualTo(errno, 2)
                IfCondition EqualTo(dangling, 1) ThenBlock: {
                    IfCondition EqualTo(CpConfig.posix_correct, 1) ThenBlock: {
                        dangling = 0
                    } ElseBlock: {
                        WriteStderr("cp: not writing through dangling symlink '")
                        WriteStderr(dest)
                        WriteStderr("'\n")
                        ReturnValue(1)
                    }
                }
                looped = EqualTo(errno, 40)
                IfCondition EqualTo(looped, 1) ThenBlock: {
                    unlink_loop = 0
                    IfCondition EqualTo(CpConfig.force, 1) ThenBlock: { unlink_loop = 1 }
                    IfCondition EqualTo(CpConfig.remove_dest, 1) ThenBlock: { unlink_loop = 1 }
                    IfCondition EqualTo(unlink_loop, 1) ThenBlock: {
                        SystemCall(87, dest)
                    } ElseBlock: {
                        WriteStderr("cp: cannot stat '")
                        WriteStderr(dest)
                        WriteStderr("': ")
                        WriteSyscallError(sres)
                        WriteStderr("\n")
                        ReturnValue(1)
                    }
                }
                denied = EqualTo(errno, 13)
                IfCondition EqualTo(denied, 1) ThenBlock: {
                    WriteStderr("cp: cannot stat '")
                    WriteStderr(dest)
                    WriteStderr("': ")
                    WriteSyscallError(sres)
                    WriteStderr("\n")
                    ReturnValue(1)
                }
            }
        }

        IfCondition EqualTo(CpConfig.reflink, 1) ThenBlock: {
            IfCondition EqualTo(CpConfig.attributes_only, 0) ThenBlock: {
                WriteStderr("cp: failed to clone '")
                WriteStderr(dest)
                WriteStderr("' from '")
                WriteStderr(source)
                WriteStderr("': Operation not supported\n")
                ReturnValue(1)
            }
        }

        kind = FileKind(source, follow)
        IfCondition EqualTo(kind, 16384) ThenBlock: {
            IfCondition EqualTo(CpConfig.recursive, 0) ThenBlock: {
                WriteStderr("cp: -r not specified; omitting directory '")
                WriteStderr(source)
                WriteStderr("'\n")
                ReturnValue(1)
            }
            into = IsIntoSelf(source, dest)
            IfCondition EqualTo(into, 1) ThenBlock: {
                WriteStderr("cp: cannot copy a directory, '")
                WriteStderr(source)
                WriteStderr("', into itself, '")
                WriteStderr(dest)
                WriteStderr("'\n")
                ReturnValue(1)
            }
            IfCondition GreaterThan(CpWalk.depth, 40) ThenBlock: {
                WriteStderr("cp: recursion too deep\n")
                ReturnValue(1)
            }
            CpWalk.depth = Add(CpWalk.depth, 1)
            dir_result = CpDirectory(source, dest)
            CpWalk.depth = Subtract(CpWalk.depth, 1)
            ReturnValue(dir_result)
        }

        special = 0
        IfCondition EqualTo(kind, 4096) ThenBlock: { special = 1 }
        IfCondition EqualTo(kind, 8192) ThenBlock: { special = 1 }
        IfCondition EqualTo(kind, 24576) ThenBlock: { special = 1 }
        IfCondition EqualTo(kind, 49152) ThenBlock: { special = 1 }
        IfCondition EqualTo(special, 1) ThenBlock: {
            IfCondition EqualTo(CpConfig.copy_contents, 0) ThenBlock: {
                special_result = CpSpecial(source, dest)
                ReturnValue(special_result)
            }
        }

        IfCondition EqualTo(CpConfig.preserve_links, 1) ThenBlock: {
            prev = FindCopied(source, follow)
            IfCondition NotEqual(prev, 0) ThenBlock: {
                SystemCall(87, dest)
                linked = SystemCall(86, prev, dest)
                IfCondition GreaterEqual(linked, 0) ThenBlock: {
                    WriteVerbose("'")
                    WriteVerbose(source)
                    WriteVerbose("' -> '")
                    WriteVerbose(dest)
                    WriteVerbose("'\n")
                    ReturnValue(0)
                }
                ReturnValue(1)
            }
        }

        copied = CpFile(source, dest)
        IfCondition EqualTo(copied, 0) ThenBlock: {
            IfCondition EqualTo(CpConfig.preserve_links, 1) ThenBlock: {
                RememberInode(source, dest, follow)
            }
        }
        ReturnValue(copied)
    }
}


// ============================================================================
// ARGUMENT PARSING
// ============================================================================

Function.BareName {
    Input: path: Address
    Output: Address
    Body: {
        IfCondition EqualTo(RDMEM_8(path, 0), 46) ThenBlock: {
            IfCondition EqualTo(RDMEM_8(path, 1), 47) ThenBlock: {
                ReturnValue(Add(path, 2))
            }
        }
        ReturnValue(path)
    }
}

Function.SeenSrc {
    Input: path: Address
    Output: Integer
    Body: {
        body = BareName(path)
        i = 0
        one = 1
        WhileLoop LessThan(i, CpSrc.n) {
            saved = ArrayGet(CpSrc.paths, i)
            hit = StringEquals(saved, body)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.NoteSrc {
    Input: path: Address
    Body: {
        IfCondition GreaterEqual(CpSrc.n, 64) ThenBlock: {
            ReturnValue(0)
        }
        body = BareName(path)
        kept = CopyString(body)
        ArraySet(CpSrc.paths, CpSrc.n, kept)
        CpSrc.n = Add(CpSrc.n, 1)
    }
}

Function.SeenNew {
    Input: path: Address
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, CpNew.n) {
            saved = ArrayGet(CpNew.paths, i)
            hit = StringEquals(saved, path)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.NoteNew {
    Input: path: Address
    Body: {
        IfCondition GreaterEqual(CpNew.n, 64) ThenBlock: {
            ReturnValue(0)
        }
        kept = CopyString(path)
        ArraySet(CpNew.paths, CpNew.n, kept)
        CpNew.n = Add(CpNew.n, 1)
    }
}

Function.CopyOneSource {
    Input: source: Address
    Input: final_dest: Address
    Input: into_dir: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(into_dir, 1) ThenBlock: {
            fresh = SeenNew(final_dest)
            IfCondition EqualTo(fresh, 1) ThenBlock: {
                IfCondition EqualTo(CpConfig.numbered, 0) ThenBlock: {
                    WriteStderr("cp: will not overwrite just-created '")
                    WriteStderr(final_dest)
                    WriteStderr("' with '")
                    WriteStderr(source)
                    WriteStderr("'\n")
                    ReturnValue(1)
                }
            }
        }
        result = CopyEntry(source, final_dest, 1)
        IfCondition EqualTo(result, 0) ThenBlock: {
            IfCondition EqualTo(into_dir, 1) ThenBlock: {
                NoteNew(final_dest)
            }
        }
        ReturnValue(result)
    }
}

