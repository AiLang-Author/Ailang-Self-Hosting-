// Split from cp.ailang. Pools stay on cp.ailang. No Main.

LibraryImport.Arena

Function.LongPrefix {
    Input: opt: Address
    Input: word: Address
    Input: wlen: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, wlen) {
            at = Add(i, 2)
            c = RDMEM_8(opt, at)
            IfCondition EqualTo(c, 61) ThenBlock: {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    ReturnValue(1)
                }
                ReturnValue(0)
            }
            IfCondition EqualTo(c, 0) ThenBlock: {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    ReturnValue(1)
                }
                ReturnValue(0)
            }
            w = RDMEM_8(word, i)
            IfCondition NotEqual(c, w) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        endat = Add(wlen, 2)
        cend = RDMEM_8(opt, endat)
        IfCondition EqualTo(cend, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(cend, 61) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.HasPrefix {
    Input: text: Address
    Input: prefix: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop 1 {
            c = RDMEM_8(prefix, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(1)
            }
            b = RDMEM_8(text, i)
            IfCondition NotEqual(b, c) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.SpanEq {
    Input: buf: Address
    Input: start: Integer
    Input: n: Integer
    Input: lit: Address
    Output: Integer
    Body: {
        lit_len = StringLength(lit)
        IfCondition NotEqual(lit_len, n) ThenBlock: {
            ReturnValue(0)
        }
        j = 0
        WhileLoop LessThan(j, n) {
            b = RDMEM_8(buf, Add(start, j))
            c = RDMEM_8(lit, j)
            IfCondition NotEqual(b, c) ThenBlock: {
                ReturnValue(0)
            }
            j = Add(j, 1)
        }
        ReturnValue(1)
    }
}

Function.MatchAt {
    Input: buf: Address
    Input: pos: Integer
    Input: lit: Address
    Output: Integer
    Body: {
        j = 0
        WhileLoop 1 {
            c = RDMEM_8(lit, j)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(1)
            }
            b = RDMEM_8(buf, Add(pos, j))
            IfCondition NotEqual(b, c) ThenBlock: {
                ReturnValue(0)
            }
            j = Add(j, 1)
        }
        ReturnValue(0)
    }
}

Function.AfterEq {
    Input: text: Address
    Output: Address
    Body: {
        i = 0
        WhileLoop NotEqual(RDMEM_8(text, i), 0) {
            IfCondition EqualTo(RDMEM_8(text, i), 61) ThenBlock: {
                ReturnValue(Add(text, Add(i, 1)))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Concat2 {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        la = StringLength(a)
        lb = StringLength(b)
        out = Allocate(Add(Add(la, lb), 1))
        i = 0
        WhileLoop LessThan(i, la) {
            WRMEM_8(out, i, RDMEM_8(a, i))
            i = Add(i, 1)
        }
        j = 0
        WhileLoop LessThan(j, lb) {
            WRMEM_8(out, i, RDMEM_8(b, j))
            i = Add(i, 1)
            j = Add(j, 1)
        }
        WRMEM_8(out, i, 0)
        ReturnValue(out)
    }
}

Function.EndsSlash {
    Input: path: Address
    Output: Integer
    Body: {
        len = StringLength(path)
        IfCondition EqualTo(len, 0) ThenBlock: {
            ReturnValue(0)
        }
        last = RDMEM_8(path, Subtract(len, 1))
        ReturnValue(EqualTo(last, 47))
    }
}

Function.ScanEnviron {
    Body: {
        fd = SystemCall(2, "/proc/self/environ", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf = Allocate(262144)
        n = SystemCall(0, fd, buf, 262143)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 262144)
            ReturnValue(0)
        }
        WRMEM_8(buf, n, 0)
        i = 0
        WhileLoop LessThan(i, n) {
            at_var = 0
            IfCondition EqualTo(i, 0) ThenBlock: {
                at_var = 1
            }
            IfCondition GreaterThan(i, 0) ThenBlock: {
                prev = RDMEM_8(buf, Subtract(i, 1))
                IfCondition EqualTo(prev, 0) ThenBlock: {
                    at_var = 1
                }
            }
            IfCondition EqualTo(at_var, 1) ThenBlock: {
                is_posix = MatchAt(buf, i, "POSIXLY_CORRECT=")
                IfCondition EqualTo(is_posix, 1) ThenBlock: {
                    CpConfig.posix_correct = 1
                }
                is_vc = MatchAt(buf, i, "VERSION_CONTROL=")
                IfCondition EqualTo(is_vc, 1) ThenBlock: {
                    vc = RDMEM_8(buf, Add(i, 16))
                    numbered = EqualTo(vc, 110)
                    tnumbered = EqualTo(vc, 116)
                    IfCondition EqualTo(Or(numbered, tnumbered), 1) ThenBlock: {
                        CpConfig.numbered = 1
                    }
                }
            }
            i = Add(i, 1)
        }
        Deallocate(buf, 262144)
        ReturnValue(0)
    }
}

Function.IdsEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        same = 1
        IfCondition NotEqual(GetUInt32(a, 0), GetUInt32(b, 0)) ThenBlock: { same = 0 }
        IfCondition NotEqual(GetUInt32(a, 4), GetUInt32(b, 4)) ThenBlock: { same = 0 }
        IfCondition NotEqual(GetUInt32(a, 8), GetUInt32(b, 8)) ThenBlock: { same = 0 }
        IfCondition NotEqual(GetUInt32(a, 12), GetUInt32(b, 12)) ThenBlock: { same = 0 }
        ReturnValue(same)
    }
}

Function.StatSame {
    Input: a: Address
    Input: b: Address
    Input: follow: Integer
    Output: Integer
    Body: {
        ba = Allocate(144)
        bb = Allocate(144)
        ra = -1
        rb = -1
        IfCondition EqualTo(follow, 1) ThenBlock: {
            ra = SystemCall(4, a, ba)
            rb = SystemCall(4, b, bb)
        } ElseBlock: {
            ra = SystemCall(6, a, ba)
            rb = SystemCall(6, b, bb)
        }
        same = 0
        IfCondition GreaterEqual(ra, 0) ThenBlock: {
            IfCondition GreaterEqual(rb, 0) ThenBlock: {
                same = IdsEqual(ba, bb)
            }
        }
        Deallocate(ba, 144)
        Deallocate(bb, 144)
        ReturnValue(same)
    }
}

Function.FileKind {
    Input: path: Address
    Input: follow: Integer
    Output: Integer
    Body: {
        buf = Allocate(144)
        res = -1
        IfCondition EqualTo(follow, 1) ThenBlock: {
            res = SystemCall(4, path, buf)
        } ElseBlock: {
            res = SystemCall(6, path, buf)
        }
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(buf, 144)
            ReturnValue(-1)
        }
        mode = GetUInt32(buf, 24)
        kind = BitwiseAnd(mode, 61440)
        Deallocate(buf, 144)
        ReturnValue(kind)
    }
}

Function.IsIntoSelf {
    Input: source: Address
    Input: dest: Address
    Output: Integer
    Body: {
        buf = Allocate(144)
        slashed = EndsSlash(source)
        res = -1
        IfCondition EqualTo(slashed, 1) ThenBlock: {
            res = SystemCall(4, source, buf)
        } ElseBlock: {
            res = SystemCall(6, source, buf)
        }
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(buf, 144)
            ReturnValue(0)
        }
        kind = BitwiseAnd(GetUInt32(buf, 24), 61440)
        IfCondition NotEqual(kind, 16384) ThenBlock: {
            Deallocate(buf, 144)
            ReturnValue(0)
        }
        CpWalk.dev0 = GetUInt32(buf, 0)
        CpWalk.dev1 = GetUInt32(buf, 4)
        CpWalk.ino0 = GetUInt32(buf, 8)
        CpWalk.ino1 = GetUInt32(buf, 12)
        Deallocate(buf, 144)
        path = CopyString(dest)
        CpWalk.hit = 0
        CpWalk.guard = 0
        WhileLoop EqualTo(CpWalk.hit, 0) {
            CpWalk.guard = Add(CpWalk.guard, 1)
            IfCondition GreaterThan(CpWalk.guard, 48) ThenBlock: {
                BreakLoop
            }
            sb = Allocate(144)
            pr = SystemCall(6, path, sb)
            IfCondition GreaterEqual(pr, 0) ThenBlock: {
                dev_ok = EqualTo(GetUInt32(sb, 0), CpWalk.dev0)
                dev_ok2 = EqualTo(GetUInt32(sb, 4), CpWalk.dev1)
                ino_ok = EqualTo(GetUInt32(sb, 8), CpWalk.ino0)
                ino_ok2 = EqualTo(GetUInt32(sb, 12), CpWalk.ino1)
                IfCondition EqualTo(dev_ok, 1) ThenBlock: {
                    IfCondition EqualTo(dev_ok2, 1) ThenBlock: {
                        IfCondition EqualTo(ino_ok, 1) ThenBlock: {
                            IfCondition EqualTo(ino_ok2, 1) ThenBlock: {
                                CpWalk.hit = 1
                            }
                        }
                    }
                }
            }
            Deallocate(sb, 144)
            IfCondition EqualTo(CpWalk.hit, 1) ThenBlock: {
                BreakLoop
            }
            len = StringLength(path)
            CpWalk.mark = -1
            k = 0
            WhileLoop LessThan(k, len) {
                IfCondition EqualTo(RDMEM_8(path, k), 47) ThenBlock: {
                    CpWalk.mark = k
                }
                k = Add(k, 1)
            }
            IfCondition LessThan(CpWalk.mark, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition EqualTo(CpWalk.mark, 0) ThenBlock: {
                IfCondition LessEqual(len, 1) ThenBlock: {
                    BreakLoop
                }
                WRMEM_8(path, 1, 0)
            } ElseBlock: {
                WRMEM_8(path, CpWalk.mark, 0)
            }
        }
        Deallocate(path, 0)
        ReturnValue(CpWalk.hit)
    }
}

Function.RememberInode {
    Input: path: Address
    Input: saved_dest: Address
    Input: follow: Integer
    Body: {
        IfCondition GreaterEqual(CpSeen.n, 64) ThenBlock: {
            ReturnValue(0)
        }
        buf = Allocate(144)
        res = -1
        IfCondition EqualTo(follow, 1) ThenBlock: {
            res = SystemCall(4, path, buf)
        } ElseBlock: {
            res = SystemCall(6, path, buf)
        }
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(buf, 144)
            ReturnValue(0)
        }
        ArraySet(CpSeen.dlo, CpSeen.n, GetUInt32(buf, 0))
        ArraySet(CpSeen.dhi, CpSeen.n, GetUInt32(buf, 4))
        ArraySet(CpSeen.lo, CpSeen.n, GetUInt32(buf, 8))
        ArraySet(CpSeen.hi, CpSeen.n, GetUInt32(buf, 12))
        Deallocate(buf, 144)
        kept = CopyString(saved_dest)
        ArraySet(CpSeen.paths, CpSeen.n, kept)
        CpSeen.n = Add(CpSeen.n, 1)
        ReturnValue(0)
    }
}

Function.FindCopied {
    Input: path: Address
    Input: follow: Integer
    Output: Address
    Body: {
        CpWalk.found = 0
        buf = Allocate(144)
        res = -1
        IfCondition EqualTo(follow, 1) ThenBlock: {
            res = SystemCall(4, path, buf)
        } ElseBlock: {
            res = SystemCall(6, path, buf)
        }
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(buf, 144)
            ReturnValue(0)
        }
        want_d0 = GetUInt32(buf, 0)
        want_d1 = GetUInt32(buf, 4)
        want_i0 = GetUInt32(buf, 8)
        want_i1 = GetUInt32(buf, 12)
        Deallocate(buf, 144)
        i = 0
        WhileLoop LessThan(i, CpSeen.n) {
            d0 = ArrayGet(CpSeen.dlo, i)
            d1 = ArrayGet(CpSeen.dhi, i)
            i0 = ArrayGet(CpSeen.lo, i)
            i1 = ArrayGet(CpSeen.hi, i)
            IfCondition EqualTo(d0, want_d0) ThenBlock: {
                IfCondition EqualTo(d1, want_d1) ThenBlock: {
                    IfCondition EqualTo(i0, want_i0) ThenBlock: {
                        IfCondition EqualTo(i1, want_i1) ThenBlock: {
                            found = ArrayGet(CpSeen.paths, i)
                            ReturnValue(found)
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(CpWalk.found)
    }
}

Function.SimpleBackupName {
    Input: dest: Address
    Output: Address
    Body: {
        suf = CpConfig.suffix
        IfCondition EqualTo(suf, 0) ThenBlock: {
            made = Concat2(dest, "~")
            ReturnValue(made)
        }
        made = Concat2(dest, suf)
        ReturnValue(made)
    }
}

Function.NumberedFreeName {
    Input: dest: Address
    Output: Address
    Body: {
        n = 1
        WhileLoop LessThan(n, 100) {
            num = IntToString(n)
            p1 = Concat2(dest, ".~")
            p2 = Concat2(p1, num)
            name = Concat2(p2, "~")
            Deallocate(p1, 0)
            Deallocate(p2, 0)
            Deallocate(num, 0)
            sb = Allocate(144)
            exists = SystemCall(6, name, sb)
            Deallocate(sb, 144)
            IfCondition LessThan(exists, 0) ThenBlock: {
                ReturnValue(name)
            }
            Deallocate(name, 0)
            n = Add(n, 1)
        }
        ReturnValue(0)
    }
}

Function.SaySameFile {
    Input: source: Address
    Input: dest: Address
    Body: {
        WriteStderr("cp: '")
        WriteStderr(source)
        WriteStderr("' and '")
        WriteStderr(dest)
        WriteStderr("' are the same file\n")
    }
}

Function.BackupDest {
    Input: dest: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CpConfig.numbered, 1) ThenBlock: {
            n = 1
            CpWalk.hit = 0
            WhileLoop LessThan(n, 100) {
                num = IntToString(n)
                p1 = Concat2(dest, ".~")
                p2 = Concat2(p1, num)
                name = Concat2(p2, "~")
                Deallocate(p1, 0)
                Deallocate(p2, 0)
                Deallocate(num, 0)
                sb = Allocate(144)
                exists = SystemCall(6, name, sb)
                Deallocate(sb, 144)
                IfCondition LessThan(exists, 0) ThenBlock: {
                    renamed = SystemCall(82, dest, name)
                    IfCondition GreaterEqual(renamed, 0) ThenBlock: {
                        CpWalk.hit = 1
                    }
                }
                Deallocate(name, 0)
                IfCondition EqualTo(CpWalk.hit, 1) ThenBlock: {
                    BreakLoop
                }
                n = Add(n, 1)
            }
            IfCondition EqualTo(CpWalk.hit, 1) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        name = SimpleBackupName(dest)
        renamed = SystemCall(82, dest, name)
        Deallocate(name, 0)
        IfCondition LessThan(renamed, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.AnyNumbered {
    Input: dest: Address
    Output: Integer
    Body: {
        n = 1
        CpWalk.hit = 0
        WhileLoop LessThan(n, 30) {
            num = IntToString(n)
            p1 = Concat2(dest, ".~")
            p2 = Concat2(p1, num)
            name = Concat2(p2, "~")
            Deallocate(p1, 0)
            Deallocate(p2, 0)
            Deallocate(num, 0)
            sb = Allocate(144)
            exists = SystemCall(6, name, sb)
            Deallocate(sb, 144)
            Deallocate(name, 0)
            IfCondition GreaterEqual(exists, 0) ThenBlock: {
                CpWalk.hit = 1
            }
            n = Add(n, 1)
        }
        ReturnValue(CpWalk.hit)
    }
}

Function.TryBackup {
    Input: source: Address
    Input: dest: Address
    Output: Integer
    Body: {
        use_num = CpConfig.numbered
        IfCondition EqualTo(CpConfig.backup_mode, 2) ThenBlock: {
            use_num = AnyNumbered(dest)
        }
        name = 0
        IfCondition EqualTo(use_num, 1) ThenBlock: {
            name = NumberedFreeName(dest)
        } ElseBlock: {
            name = SimpleBackupName(dest)
        }
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(1)
        }
        same = StringEquals(name, source)
        IfCondition EqualTo(same, 1) ThenBlock: {
            WriteStderr("cp: backing up '")
            WriteStderr(dest)
            WriteStderr("' might destroy source;  '")
            WriteStderr(name)
            WriteStderr("' not copied\n")
            Deallocate(name, 0)
            ReturnValue(1)
        }
        renamed = SystemCall(82, dest, name)
        Deallocate(name, 0)
        IfCondition LessThan(renamed, 0) ThenBlock: {
            WriteStderr("cp: cannot backup '")
            WriteStderr(dest)
            WriteStderr("'\n")
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.ApplyPreserveList {
    Input: list: Address
    Input: enable: Integer
    Body: {
        start = 0
        i = 0
        WhileLoop 1 {
            c = RDMEM_8(list, i)
            at_end = EqualTo(c, 0)
            at_comma = EqualTo(c, 44)
            boundary = Or(at_end, at_comma)
            IfCondition EqualTo(boundary, 1) ThenBlock: {
                n = Subtract(i, start)
                is_mode = SpanEq(list, start, n, "mode")
                is_own = SpanEq(list, start, n, "ownership")
                is_time = SpanEq(list, start, n, "timestamps")
                is_links = SpanEq(list, start, n, "links")
                is_link = SpanEq(list, start, n, "link")
                is_all = SpanEq(list, start, n, "all")
                IfCondition EqualTo(is_all, 1) ThenBlock: {
                    CpConfig.preserve_mode = enable
                    CpConfig.preserve_owner = enable
                    CpConfig.preserve_time = enable
                    CpConfig.preserve_links = enable
                    IfCondition EqualTo(enable, 0) ThenBlock: {
                        CpConfig.explicit_no_mode = 1
                    } ElseBlock: {
                        CpConfig.explicit_no_mode = 0
                    }
                }
                IfCondition EqualTo(is_mode, 1) ThenBlock: {
                    CpConfig.preserve_mode = enable
                    IfCondition EqualTo(enable, 0) ThenBlock: {
                        CpConfig.explicit_no_mode = 1
                    } ElseBlock: {
                        CpConfig.explicit_no_mode = 0
                    }
                }
                IfCondition EqualTo(is_own, 1) ThenBlock: { CpConfig.preserve_owner = enable }
                IfCondition EqualTo(is_time, 1) ThenBlock: { CpConfig.preserve_time = enable }
                IfCondition EqualTo(is_links, 1) ThenBlock: { CpConfig.preserve_links = enable }
                IfCondition EqualTo(is_link, 1) ThenBlock: { CpConfig.preserve_links = enable }
                IfCondition EqualTo(at_end, 1) ThenBlock: {
                    BreakLoop
                }
                start = Add(i, 1)
            }
            i = Add(i, 1)
        }
    }
}

Function.SetArchive {
    Body: {
        CpConfig.recursive = 1
        CpConfig.no_dereference = 1
        CpConfig.dereference = 0
        CpConfig.deref_all = 0
        CpConfig.deref_cmdline = 0
        CpConfig.preserve_mode = 1
        CpConfig.preserve_owner = 1
        CpConfig.preserve_time = 1
        CpConfig.preserve_links = 1
    }
}

Function.ApplyLong {
    Input: flag: Address
    Body: {
        IfCondition StringEquals(flag, "--debug") ThenBlock: {
            CpConfig.debug = 1
            CpConfig.verbose = 1
        }
        IfCondition StringEquals(flag, "--recursive") ThenBlock: { CpConfig.recursive = 1 }
        IfCondition StringEquals(flag, "--archive") ThenBlock: { SetArchive() }
        IfCondition StringEquals(flag, "--force") ThenBlock: {
            CpConfig.force = 1
        }
        IfCondition StringEquals(flag, "--interactive") ThenBlock: {
            CpConfig.interactive = 1
            CpConfig.no_clobber = 0
        }
        IfCondition StringEquals(flag, "--verbose") ThenBlock: { CpConfig.verbose = 1 }
        IfCondition StringEquals(flag, "--copy-contents") ThenBlock: { CpConfig.copy_contents = 1 }
        IfCondition StringEquals(flag, "--no-clobber") ThenBlock: {
            CpConfig.no_clobber = 1
            CpConfig.interactive = 0
        }
        IfCondition HasPrefix(flag, "--update") ThenBlock: {
            list = AfterEq(flag)
            IfCondition EqualTo(list, 0) ThenBlock: {
                CpConfig.update = 1
            }
            IfCondition NotEqual(list, 0) ThenBlock: {
                is_none = HasPrefix(list, "none")
                is_all = HasPrefix(list, "all")
                is_older = HasPrefix(list, "older")
                IfCondition EqualTo(is_none, 1) ThenBlock: {
                    IfCondition EqualTo(CpConfig.no_clobber, 0) ThenBlock: {
                        CpConfig.update = 2
                    }
                }
                IfCondition EqualTo(is_all, 1) ThenBlock: {
                    CpConfig.update = 0
                }
                IfCondition EqualTo(is_older, 1) ThenBlock: {
                    CpConfig.update = 1
                }
                IfCondition EqualTo(RDMEM_8(list, 0), 0) ThenBlock: {
                    CpConfig.update = 1
                }
            }
        }
        IfCondition StringEquals(flag, "--link") ThenBlock: { CpConfig.hardlink = 1 }
        IfCondition StringEquals(flag, "--symbolic-link") ThenBlock: { CpConfig.make_symlink = 1 }
        IfCondition StringEquals(flag, "--parents") ThenBlock: { CpConfig.parents = 1 }
        IfCondition StringEquals(flag, "--parent") ThenBlock: { CpConfig.parents = 1 }
        IfCondition StringEquals(flag, "--attributes-only") ThenBlock: { CpConfig.attributes_only = 1 }
        IfCondition StringEquals(flag, "--no-target-directory") ThenBlock: { CpConfig.no_target_dir = 1 }
        IfCondition HasPrefix(flag, "--remove-destination") ThenBlock: { CpConfig.remove_dest = 1 }
        IfCondition HasPrefix(flag, "--rem") ThenBlock: {
            IfCondition EqualTo(HasPrefix(flag, "--remove-destination"), 0) ThenBlock: {
                rest_ok = HasPrefix("--remove-destination", flag)
                IfCondition EqualTo(rest_ok, 1) ThenBlock: {
                    CpConfig.remove_dest = 1
                }
            }
        }
        IfCondition StringEquals(flag, "--dereference") ThenBlock: {
            CpConfig.dereference = 1
            CpConfig.deref_all = 1
            CpConfig.no_dereference = 0
        }
        IfCondition StringEquals(flag, "--no-dereference") ThenBlock: {
            CpConfig.no_dereference = 1
            CpConfig.dereference = 0
            CpConfig.deref_all = 0
            CpConfig.deref_cmdline = 0
        }
        IfCondition StringEquals(flag, "--preserve") ThenBlock: {
            CpConfig.preserve_mode = 1
            CpConfig.preserve_owner = 1
            CpConfig.preserve_time = 1
        }
        IfCondition HasPrefix(flag, "--preserve=") ThenBlock: {
            list = AfterEq(flag)
            ApplyPreserveList(list, 1)
        }
        IfCondition HasPrefix(flag, "--no-preserve=") ThenBlock: {
            list = AfterEq(flag)
            ApplyPreserveList(list, 0)
        }
        IfCondition StringEquals(flag, "--no-preserve") ThenBlock: {
            CpConfig.preserve_mode = 0
            CpConfig.preserve_owner = 0
            CpConfig.preserve_time = 0
            CpConfig.preserve_links = 0
        }
        IfCondition EqualTo(LongPrefix(flag, "backup", 6), 1) ThenBlock: {
            CpConfig.backup = 1
            list = AfterEq(flag)
            IfCondition NotEqual(list, 0) ThenBlock: {
                is_num = HasPrefix(list, "numbered")
                is_t = 0
                IfCondition EqualTo(RDMEM_8(list, 0), 116) ThenBlock: {
                    IfCondition EqualTo(RDMEM_8(list, 1), 0) ThenBlock: {
                        is_t = 1
                    }
                }
                IfCondition EqualTo(is_num, 1) ThenBlock: {
                    CpConfig.numbered = 1
                    CpConfig.backup_mode = 1
                }
                IfCondition EqualTo(is_t, 1) ThenBlock: {
                    CpConfig.numbered = 1
                    CpConfig.backup_mode = 1
                }
                is_simple = HasPrefix(list, "simple")
                is_never = HasPrefix(list, "never")
                IfCondition EqualTo(is_simple, 1) ThenBlock: {
                    CpConfig.numbered = 0
                    CpConfig.backup_mode = 0
                }
                IfCondition EqualTo(is_never, 1) ThenBlock: {
                    CpConfig.numbered = 0
                    CpConfig.backup_mode = 0
                }
                is_exist = HasPrefix(list, "existing")
                is_nil = HasPrefix(list, "nil")
                IfCondition EqualTo(is_exist, 1) ThenBlock: {
                    CpConfig.numbered = 0
                    CpConfig.backup_mode = 2
                }
                IfCondition EqualTo(is_nil, 1) ThenBlock: {
                    CpConfig.numbered = 0
                    CpConfig.backup_mode = 2
                }
                is_none = HasPrefix(list, "none")
                is_off = HasPrefix(list, "off")
                IfCondition EqualTo(is_none, 1) ThenBlock: {
                    CpConfig.backup = 0
                }
                IfCondition EqualTo(is_off, 1) ThenBlock: {
                    CpConfig.backup = 0
                }
            }
        }
        IfCondition HasPrefix(flag, "--sparse=") ThenBlock: {
            list = AfterEq(flag)
            IfCondition HasPrefix(list, "always") ThenBlock: { CpConfig.sparse = 1 }
            IfCondition HasPrefix(list, "never") ThenBlock: { CpConfig.sparse = 2 }
            IfCondition HasPrefix(list, "auto") ThenBlock: { CpConfig.sparse = 0 }
        }
        IfCondition StringEquals(flag, "--reflink") ThenBlock: { CpConfig.reflink = 1 }
        IfCondition HasPrefix(flag, "--reflink=") ThenBlock: {
            list = AfterEq(flag)
            IfCondition HasPrefix(list, "always") ThenBlock: { CpConfig.reflink = 1 }
            IfCondition HasPrefix(list, "auto") ThenBlock: { CpConfig.reflink = 2 }
            IfCondition HasPrefix(list, "never") ThenBlock: { CpConfig.reflink = 0 }
        }
        IfCondition StringEquals(flag, "--target-directory") ThenBlock: {
            CpConfig.want_tdir = 1
        }
        IfCondition HasPrefix(flag, "--target-directory=") ThenBlock: {
            list = AfterEq(flag)
            CpConfig.target_dir = CopyString(list)
            CpConfig.target_dir_set = 1
        }
        IfCondition HasPrefix(flag, "--suffix=") ThenBlock: {
            list = AfterEq(flag)
            CpConfig.suffix = CopyString(list)
        }
        IfCondition StringEquals(flag, "--suffix") ThenBlock: {
            CpConfig.want_suffix = 1
        }
    }
}

