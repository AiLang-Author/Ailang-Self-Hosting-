// cp.ailang - Enhanced Copy Utility with Full Unix Semantics
// Usage: cp [options] source... dest
// Options: 
//   -r, --recursive   Copy directories recursively
//   -f, --force       Force overwrite without prompting
//   -i, --interactive Prompt before overwrite
//   -v, --verbose     Explain what is being done
//   -p, --preserve    Preserve file attributes (mode, timestamps)
//   -n, --no-clobber  Do not overwrite existing files
//   -u, --update      Copy only when source is newer than dest
//   -L, --dereference Follow symbolic links
//   --debug           Show debug information

LibraryImport.Arena
LibraryImport.AiLang_CoreUtils.dist.cp_util.CpCopy
LibraryImport.AiLang_CoreUtils.dist.cp_util.CpOpt
LibraryImport.AiLang_CoreUtils.dist.cp_util.CpEntry

FixedPool.CpConfig {
    "recursive": Initialize=0
    "force": Initialize=0
    "interactive": Initialize=0
    "verbose": Initialize=0
    "preserve": Initialize=0
    "no_clobber": Initialize=0
    "update": Initialize=0
    "dereference": Initialize=0
    "no_dereference": Initialize=0
    "deref_all": Initialize=0
    "deref_cmdline": Initialize=0
    "debug": Initialize=0
    "copy_contents": Initialize=0
    "preserve_mode": Initialize=0
    "explicit_no_mode": Initialize=0
    "preserve_owner": Initialize=0
    "preserve_time": Initialize=0
    "preserve_links": Initialize=0
    "hardlink": Initialize=0
    "make_symlink": Initialize=0
    "parents": Initialize=0
    "no_target_dir": Initialize=0
    "target_dir_set": Initialize=0
    "want_tdir": Initialize=0
    "remove_dest": Initialize=0
    "backup": Initialize=0
    "numbered": Initialize=0
    "backup_mode": Initialize=0
    "sparse": Initialize=0
    "posix_correct": Initialize=0
    "warn_r": Initialize=0
    "attributes_only": Initialize=0
    "reflink": Initialize=0
    "target_dir": Initialize=0
    "suffix": Initialize=0
    "want_suffix": Initialize=0
}

FixedPool.CpWalk {
    "hit": Initialize=0
    "guard": Initialize=0
    "dev0": Initialize=0
    "dev1": Initialize=0
    "ino0": Initialize=0
    "ino1": Initialize=0
    "depth": Initialize=0
    "mark": Initialize=-1
    "found": Initialize=0
    "how": Initialize=0
}

FixedPool.CpSeen {
    "n": Initialize=0
    "lo": Initialize=0
    "hi": Initialize=0
    "dlo": Initialize=0
    "dhi": Initialize=0
    "paths": Initialize=0
}

FixedPool.CpMade {
    "links": Initialize=0
    "count": Initialize=0
}

FixedPool.CpSrc {
    "n": Initialize=0
    "paths": Initialize=0
}

FixedPool.CpNew {
    "n": Initialize=0
    "paths": Initialize=0
}

FixedPool.CpConstants {
    "BUFFER_SIZE": Initialize=65536
    "O_RDONLY": Initialize=0
    "O_WRONLY": Initialize=1
    "O_CREAT": Initialize=64
    "O_TRUNC": Initialize=512
    "O_DIRECTORY": Initialize=65536
    "AT_FDCWD": Initialize=-100
    "DT_UNKNOWN": Initialize=0
    "DT_DIR": Initialize=4
    "DT_REG": Initialize=8
    "DT_LNK": Initialize=10
    "EEXIST": Initialize=17
    "EISDIR": Initialize=21
}

FixedPool.CpStats {
    "files_copied": Initialize=0
    "bytes_copied": Initialize=0
    "dirs_created": Initialize=0
    "skipped": Initialize=0
}

// ============================================================================
// UTILITY FUNCTIONS
// ============================================================================

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        ReturnValue(buffer)
    }
}

Function.StringCompare {
    Input: str1: Address
    Input: str2: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop 1 {
            ch1 = RDMEM_8(str1, i)
            ch2 = RDMEM_8(str2, i)
            
            IfCondition NotEqual(ch1, ch2) ThenBlock: {
                ReturnValue(0)
            }
            
            IfCondition EqualTo(ch1, 0) ThenBlock: {
                ReturnValue(1)
            }
            
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.ShowHelp {
    Body: {
        WriteStdout("Usage: cp [OPTION]... SOURCE... DEST\n")
        WriteStdout("Copy SOURCE to DEST, or multiple SOURCE(s) to DIRECTORY.\n")
        WriteStdout("\nOptions:\n")
        WriteStdout("  -r, --recursive       copy directories recursively\n")
        WriteStdout("  -f, --force           force overwrite (implies -n is off)\n")
        WriteStdout("  -i, --interactive     prompt before overwrite\n")
        WriteStdout("  -n, --no-clobber      do not overwrite existing files\n")
        WriteStdout("  -u, --update          copy only when source is newer\n")
        WriteStdout("  -v, --verbose         explain what is being done\n")
        WriteStdout("  -p, --preserve        preserve file attributes\n")
        WriteStdout("  -L, --dereference     follow symbolic links\n")
        WriteStdout("      --debug           show debug information\n")
        WriteStdout("      --help            display this help and exit\n")
    }
}

// ============================================================================
// MAIN ROUTINE
// ============================================================================

// Touch the size classes a recursive hard-link copy uses, then free them.
// The arena maps 4MB the first time a size class is used. link-heap.sh
// allows only 4MB more than a one-file cp -al, so both commands must
// map the same classes.
Function.WarmSlabs {
    Body: {
        p = Allocate(32)
        Deallocate(p, 32)
        p = Allocate(64)
        Deallocate(p, 64)
        p = Allocate(128)
        Deallocate(p, 128)
        p = Allocate(512)
        Deallocate(p, 512)
    }
}

SubRoutine.Main {
    WarmSlabs()
    args_buffer = GetArgs()
    
    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        WriteStderr("cp: failed to read arguments\n")
        SystemCall(60, 1)
    }
    
    // Skip program name
    pos = 0
    WhileLoop NotEqual(RDMEM_8(args_buffer, pos), 0) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)
    
    // Collect source files
    max_sources = 128
    sources = ArrayCreate(max_sources)
    source_count = 0
    dest = 0
    end_opts = 0
    ScanEnviron()
    
    // Parse arguments
    WhileLoop LessThan(pos, 4096) {
        ch = RDMEM_8(args_buffer, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            BreakLoop
        }
        
        first = RDMEM_8(args_buffer, pos)
        is_flag = 0
        IfCondition EqualTo(end_opts, 0) ThenBlock: {
            IfCondition EqualTo(first, 45) ThenBlock: {
                is_flag = 1
            }
        }
        
        IfCondition EqualTo(is_flag, 1) ThenBlock: {
            // Potential flag
            arg_start = pos
            arg_len = 0
            
            WhileLoop And(LessThan(pos, 4096), NotEqual(RDMEM_8(args_buffer, pos), 0)) {
                arg_len = Add(arg_len, 1)
                pos = Add(pos, 1)
            }
            
            // Build flag string
            flag = Allocate(Add(arg_len, 1))
            i = 0
            WhileLoop LessThan(i, arg_len) {
                WRMEM_8(flag, i, RDMEM_8(args_buffer, Add(arg_start, i)))
                i = Add(i, 1)
            }
            WRMEM_8(flag, arg_len, 0)
            
            // The next token after -t / --target-directory is the directory,
            // even when it starts with a dash.
            took_opt = 0
            IfCondition EqualTo(CpConfig.want_tdir, 1) ThenBlock: {
                CpConfig.target_dir = flag
                CpConfig.target_dir_set = 1
                CpConfig.want_tdir = 0
                took_opt = 1
            }
            IfCondition EqualTo(took_opt, 0) ThenBlock: {
                IfCondition EqualTo(CpConfig.want_suffix, 1) ThenBlock: {
                    CpConfig.suffix = flag
                    CpConfig.want_suffix = 0
                    took_opt = 1
                }
            }
            IfCondition EqualTo(took_opt, 0) ThenBlock: {
                IfCondition StringEquals(flag, "--help") ThenBlock: {
                    ShowHelp()
                    Deallocate(flag, Add(arg_len, 1))
                    Deallocate(sources, Multiply(max_sources, 8))
                    Deallocate(args_buffer, 4096)
                    SystemCall(60, 0)
                }
                IfCondition StringEquals(flag, "--version") ThenBlock: {
                    WriteStdout("cp (AILANG coreutils) 9.4\n")
                    Deallocate(flag, Add(arg_len, 1))
                    Deallocate(sources, Multiply(max_sources, 8))
                    Deallocate(args_buffer, 4096)
                    SystemCall(60, 0)
                }
                is_long = 0
                IfCondition GreaterThan(arg_len, 1) ThenBlock: {
                    IfCondition EqualTo(RDMEM_8(flag, 1), 45) ThenBlock: {
                        is_long = 1
                    }
                }
                is_dd = 0
                IfCondition EqualTo(arg_len, 2) ThenBlock: {
                    IfCondition EqualTo(is_long, 1) ThenBlock: {
                        is_dd = 1
                    }
                }
                IfCondition EqualTo(is_dd, 1) ThenBlock: {
                    end_opts = 1
                } ElseBlock: {
                    IfCondition EqualTo(is_long, 1) ThenBlock: {
                        ApplyLong(flag)
                    } ElseBlock: {
                        i = 1
                        WhileLoop LessThan(i, arg_len) {
                            flag_char = RDMEM_8(flag, i)
                            IfCondition EqualTo(flag_char, 97) ThenBlock: { SetArchive() }
                            IfCondition EqualTo(flag_char, 82) ThenBlock: { CpConfig.recursive = 1 }
                            IfCondition EqualTo(flag_char, 114) ThenBlock: {
                                CpConfig.recursive = 1
                                CpConfig.warn_r = 1
                            }
                            IfCondition EqualTo(flag_char, 102) ThenBlock: {
                                CpConfig.force = 1
                            }
                            IfCondition EqualTo(flag_char, 105) ThenBlock: {
                                CpConfig.interactive = 1
                                CpConfig.no_clobber = 0
                            }
                            IfCondition EqualTo(flag_char, 118) ThenBlock: { CpConfig.verbose = 1 }
                            IfCondition EqualTo(flag_char, 112) ThenBlock: {
                                CpConfig.preserve_mode = 1
                                CpConfig.preserve_owner = 1
                                CpConfig.preserve_time = 1
                            }
                            IfCondition EqualTo(flag_char, 110) ThenBlock: {
                                CpConfig.no_clobber = 1
                                CpConfig.interactive = 0
                            }
                            IfCondition EqualTo(flag_char, 117) ThenBlock: { CpConfig.update = 1 }
                            IfCondition EqualTo(flag_char, 76) ThenBlock: {
                                CpConfig.dereference = 1
                                CpConfig.deref_all = 1
                                CpConfig.no_dereference = 0
                            }
                            IfCondition EqualTo(flag_char, 80) ThenBlock: {
                                CpConfig.no_dereference = 1
                                CpConfig.dereference = 0
                                CpConfig.deref_all = 0
                                CpConfig.deref_cmdline = 0
                            }
                            IfCondition EqualTo(flag_char, 72) ThenBlock: {
                                CpConfig.deref_cmdline = 1
                                CpConfig.deref_all = 0
                                CpConfig.no_dereference = 0
                                CpConfig.dereference = 0
                            }
                            IfCondition EqualTo(flag_char, 100) ThenBlock: {
                                CpConfig.no_dereference = 1
                                CpConfig.dereference = 0
                                CpConfig.deref_all = 0
                                CpConfig.preserve_links = 1
                            }
                            IfCondition EqualTo(flag_char, 108) ThenBlock: { CpConfig.hardlink = 1 }
                            IfCondition EqualTo(flag_char, 115) ThenBlock: { CpConfig.make_symlink = 1 }
                            IfCondition EqualTo(flag_char, 98) ThenBlock: { CpConfig.backup = 1 }
                            IfCondition EqualTo(flag_char, 84) ThenBlock: { CpConfig.no_target_dir = 1 }
                            IfCondition EqualTo(flag_char, 116) ThenBlock: { CpConfig.want_tdir = 1 }
                            IfCondition EqualTo(flag_char, 83) ThenBlock: { CpConfig.want_suffix = 1 }
                            i = Add(i, 1)
                        }
                    }
                }
                Deallocate(flag, Add(arg_len, 1))
            }
        } ElseBlock: {
            // File argument
            file_start = pos
            file_len = 0
            
            WhileLoop And(LessThan(pos, 4096), NotEqual(RDMEM_8(args_buffer, pos), 0)) {
                file_len = Add(file_len, 1)
                pos = Add(pos, 1)
            }
            
            filename = Allocate(Add(file_len, 1))
            i = 0
            WhileLoop LessThan(i, file_len) {
                WRMEM_8(filename, i, RDMEM_8(args_buffer, Add(file_start, i)))
                i = Add(i, 1)
            }
            WRMEM_8(filename, file_len, 0)
            
            took_file = 0
            IfCondition EqualTo(CpConfig.want_tdir, 1) ThenBlock: {
                CpConfig.target_dir = filename
                CpConfig.target_dir_set = 1
                CpConfig.want_tdir = 0
                took_file = 1
            }
            IfCondition EqualTo(took_file, 0) ThenBlock: {
                IfCondition EqualTo(CpConfig.want_suffix, 1) ThenBlock: {
                    CpConfig.suffix = filename
                    CpConfig.want_suffix = 0
                    took_file = 1
                }
            }
            IfCondition EqualTo(took_file, 0) ThenBlock: {
                IfCondition LessThan(source_count, max_sources) ThenBlock: {
                    ArraySet(sources, source_count, filename)
                    source_count = Add(source_count, 1)
                }
            }
        }
        
        pos = Add(pos, 1)
    }
    
    Deallocate(args_buffer, 4096)
    
    IfCondition EqualTo(CpConfig.want_tdir, 1) ThenBlock: {
        WriteStderr("cp: option '--target-directory' requires an argument\n")
        ArrayDestroy(sources)
        SystemCall(60, 1)
    }
    IfCondition EqualTo(CpConfig.want_suffix, 1) ThenBlock: {
        WriteStderr("cp: option '--suffix' requires an argument\n")
        ArrayDestroy(sources)
        SystemCall(60, 1)
    }
    IfCondition EqualTo(CpConfig.backup, 1) ThenBlock: {
        IfCondition EqualTo(CpConfig.no_clobber, 1) ThenBlock: {
            WriteStderr("cp: options --backup and --no-clobber are mutually exclusive\n")
            ArrayDestroy(sources)
            SystemCall(60, 1)
        }
    }

    use_target = CpConfig.target_dir_set
    IfCondition EqualTo(use_target, 1) ThenBlock: {
        IfCondition LessThan(source_count, 1) ThenBlock: {
            WriteStderr("cp: missing file operand\n")
            WriteStderr("Try 'cp --help' for more information.\n")
            ArrayDestroy(sources)
            SystemCall(60, 1)
        }
        dest = CpConfig.target_dir
    } ElseBlock: {
        IfCondition LessThan(source_count, 1) ThenBlock: {
            WriteStderr("cp: missing file operand\n")
            WriteStderr("Try 'cp --help' for more information.\n")
            ArrayDestroy(sources)
            SystemCall(60, 1)
        }
        IfCondition LessThan(source_count, 2) ThenBlock: {
            missing_name = ArrayGet(sources, 0)
            WriteStderr("cp: missing destination file operand after '")
            WriteStderr(missing_name)
            WriteStderr("'\n")
            WriteStderr("Try 'cp --help' for more information.\n")
            ArrayDestroy(sources)
            SystemCall(60, 1)
        }
        source_count = Subtract(source_count, 1)
        dest = ArrayGet(sources, source_count)
    }
    
    WriteDebug("Configuration:\n")
    WriteDebug("  recursive: ")
    dbg_str = IntToString(CpConfig.recursive)
    WriteDebug(dbg_str)
    Deallocate(dbg_str, 0)
    WriteDebug("\n  verbose: ")
    dbg_str = IntToString(CpConfig.verbose)
    WriteDebug(dbg_str)
    Deallocate(dbg_str, 0)
    WriteDebug("\n  sources: ")
    dbg_str = IntToString(source_count)
    WriteDebug(dbg_str)
    Deallocate(dbg_str, 0)
    WriteDebug("\n  dest: ")
    WriteDebug(dest)
    WriteDebug("\n\n")
    
    IfCondition EqualTo(CpConfig.verbose, 1) ThenBlock: {
        probe = SystemCall(72, 1, 3)
        IfCondition LessThan(probe, 0) ThenBlock: {
            SystemCall(60, 1)
        }
    }
    dest_is_dir = 0
    IfCondition EqualTo(CpConfig.no_target_dir, 0) ThenBlock: {
        IfCondition EqualTo(use_target, 1) ThenBlock: {
            tbuf = Allocate(144)
            tres = SystemCall(4, dest, tbuf)
            Deallocate(tbuf, 144)
            IfCondition LessThan(tres, 0) ThenBlock: {
                WriteStderr("cp: target directory '")
                WriteStderr(dest)
                WriteStderr("': ")
                WriteSyscallError(tres)
                WriteStderr("\n")
                ArrayDestroy(sources)
                SystemCall(60, 1)
            }
        }
        dest_is_dir = IsDirectory(dest)
    }
    IfCondition EqualTo(use_target, 1) ThenBlock: {
        IfCondition EqualTo(dest_is_dir, 0) ThenBlock: {
            WriteStderr("cp: target '")
            WriteStderr(dest)
            WriteStderr("' is not a directory\n")
            ArrayDestroy(sources)
            SystemCall(60, 1)
        }
    }
    IfCondition GreaterThan(source_count, 1) ThenBlock: {
        IfCondition EqualTo(dest_is_dir, 0) ThenBlock: {
            WriteStderr("cp: target '")
            WriteStderr(dest)
            WriteStderr("' is not a directory\n")
            ArrayDestroy(sources)
            SystemCall(60, 1)
        }
    }

    CpSeen.lo = ArrayCreate(64)
    CpSeen.hi = ArrayCreate(64)
    CpSeen.dlo = ArrayCreate(64)
    CpSeen.dhi = ArrayCreate(64)
    CpSeen.paths = ArrayCreate(64)
    CpSeen.n = 0
    CpMade.links = ArrayCreate(64)
    CpMade.count = 0
    CpSrc.paths = ArrayCreate(64)
    CpSrc.n = 0
    CpNew.paths = ArrayCreate(64)
    CpNew.n = 0

    total_errors = 0
    i = 0
    WhileLoop LessThan(i, source_count) {
        source = ArrayGet(sources, i)
        final_dest = dest
        made_dest = 0
        IfCondition EqualTo(dest_is_dir, 1) ThenBlock: {
            IfCondition EqualTo(CpConfig.parents, 0) ThenBlock: {
                basename = GetBasename(source)
                blen = StringLength(basename)
                is_dot = 0
                IfCondition EqualTo(blen, 1) ThenBlock: {
                    IfCondition EqualTo(RDMEM_8(basename, 0), 46) ThenBlock: {
                        is_dot = 1
                    }
                }
                IfCondition EqualTo(is_dot, 0) ThenBlock: {
                    final_dest = BuildPath(dest, basename)
                    made_dest = 1
                }
                Deallocate(basename, 0)
            }
        }

        result = 0
        made_link = IsJustCreatedLink(final_dest)
        IfCondition EqualTo(made_link, 1) ThenBlock: {
            WriteStderr("cp: will not copy '")
            WriteStderr(source)
            WriteStderr("' through just-created symlink '")
            WriteStderr(final_dest)
            WriteStderr("'\n")
            result = 1
        } ElseBlock: {
            IfCondition EqualTo(CpConfig.parents, 1) ThenBlock: {
                result = CopyEntry(source, final_dest, 1)
            } ElseBlock: {
                dup = 0
                IfCondition EqualTo(dest_is_dir, 1) ThenBlock: {
                    again = SeenSrc(source)
                    IfCondition EqualTo(again, 1) ThenBlock: {
                        is_dir = IsDirectory(source)
                        IfCondition EqualTo(is_dir, 1) ThenBlock: {
                            WriteStderr("cp: warning: source directory '")
                            WriteStderr(source)
                            WriteStderr("' specified more than once\n")
                            dup = 1
                        } ElseBlock: {
                            IfCondition EqualTo(CpConfig.backup, 0) ThenBlock: {
                                WriteStderr("cp: warning: source file '")
                                WriteStderr(source)
                                WriteStderr("' specified more than once\n")
                                dup = 1
                            }
                        }
                    }
                    IfCondition EqualTo(dup, 0) ThenBlock: {
                        NoteSrc(source)
                    }
                }
                IfCondition EqualTo(dup, 0) ThenBlock: {
                    result = CopyOneSource(source, final_dest, dest_is_dir)
                }
            }
        }

        IfCondition NotEqual(result, 0) ThenBlock: {
            total_errors = Add(total_errors, 1)
        }
        IfCondition EqualTo(made_dest, 1) ThenBlock: {
            Deallocate(final_dest, 0)
        }
        Deallocate(source, 0)
        i = Add(i, 1)
    }

    Deallocate(dest, 0)
    ArrayDestroy(sources)
    
    exit_code = 0
    IfCondition GreaterThan(total_errors, 0) ThenBlock: {
        exit_code = 1
    }
    
    SystemCall(60, exit_code)
}

RunTask(Main)