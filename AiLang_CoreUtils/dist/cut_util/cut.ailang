LibraryImport.Arena

FixedPool.CutOpt {
    "mode": Initialize=0
    "suppress": Initialize=0
    "delim": Initialize=9
    "delim_set": Initialize=0
    "line_delim": Initialize=10
    "complement": Initialize=0
    "out_explicit": Initialize=0
    "out_ptr": Initialize=0
    "out_len": Initialize=0
    "nrange": Initialize=0
    "lo": Initialize=0
    "hi": Initialize=0
    "cmd_len": Initialize=0
    "cmd": Initialize=0
    "have_list": Initialize=0
    "list": Initialize=0
    "exit_code": Initialize=0
    "opts_done": Initialize=0
}
FixedPool.CutCap {
    "ranges": Initialize=256
    "readsz": Initialize=65536
    "linesz": Initialize=262144
    "samesz": Initialize=1048576
    "cmdsz": Initialize=65536
    "files": Initialize=1024
    "big": Initialize=9223372036854775807
}
FixedPool.OutputBuffer {
    "buffer": Initialize=0
    "position": Initialize=0
}
FixedPool.ArgPos { "pos": Initialize=0 }

Function.SysOpen {
    Input: filename: Address
    Output: Integer
    Body: {
        ReturnValue(SystemCall(2, filename, 0, 0))
    }
}
Function.SysRead {
    Input: fd: Integer
    Input: buffer: Address
    Input: count: Integer
    Output: Integer
    Body: {
        ReturnValue(SystemCall(0, fd, buffer, count))
    }
}
Function.SysWrite {
    Input: fd: Integer
    Input: buffer: Address
    Input: count: Integer
    Body: {
        rc = SystemCall(1, fd, buffer, count)
        IfCondition LessThan(rc, count) ThenBlock: {
            IfCondition EqualTo(fd, 1) ThenBlock: {
                em = "cut: write error: No space left on device\n"
                el = StringLength(em)
                SystemCall(1, 2, em, el)
            }
            SystemCall(60, 1)
        }
    }
}
Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SysWrite(2, str, len)
    }
}
Function.WriteStdoutStr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SysWrite(1, str, len)
    }
}
Function.DieTry {
    Input: msg: Address
    Body: {
        WriteStderr(msg)
        WriteStderr("Try 'cut --help' for more information.\n")
        SystemCall(60, 1)
    }
}
Function.InitOutputBuffer {
    Body: {
        OutputBuffer.buffer = Allocate(CutCap.readsz)
        OutputBuffer.position = 0
    }
}
Function.FlushOutputBuffer {
    Body: {
        IfCondition GreaterThan(OutputBuffer.position, 0) ThenBlock: {
            SysWrite(1, OutputBuffer.buffer, OutputBuffer.position)
            OutputBuffer.position = 0
        }
    }
}
Function.BufferBytes {
    Input: data: Address
    Input: len: Integer
    Body: {
        left = len
        src = data
        WhileLoop GreaterThan(left, 0) {
            space = Subtract(CutCap.readsz, OutputBuffer.position)
            IfCondition LessEqual(space, 0) ThenBlock: {
                FlushOutputBuffer()
                space = CutCap.readsz
            }
            chunk = left
            IfCondition GreaterThan(chunk, space) ThenBlock: {
                chunk = space
            }
            MemoryCopy(Add(OutputBuffer.buffer, OutputBuffer.position), src, chunk)
            OutputBuffer.position = Add(OutputBuffer.position, chunk)
            src = Add(src, chunk)
            left = Subtract(left, chunk)
        }
    }
}
Function.BufferByte {
    Input: byte: Integer
    Body: {
        IfCondition GreaterEqual(OutputBuffer.position, CutCap.readsz) ThenBlock: {
            FlushOutputBuffer()
        }
        WRMEM_8(OutputBuffer.buffer, OutputBuffer.position, byte)
        OutputBuffer.position = Add(OutputBuffer.position, 1)
    }
}
Function.StringLen {
    Input: str: Address
    Output: Integer
    Body: {
        n = 0
        one = 1
        WhileLoop NotEqual(RDMEM_8(str, n), 0) {
            n = Add(n, one)
        }
        ReturnValue(n)
    }
}
Function.WriteSpan {
    Input: text: Address
    Input: a: Integer
    Input: b: Integer
    Body: {
        n = Subtract(b, a)
        IfCondition GreaterThan(n, 0) ThenBlock: {
            SysWrite(2, Add(text, a), n)
        }
    }
}
Function.FindByte {
    Input: text: Address
    Input: pos: Integer
    Input: len: Integer
    Input: delim: Integer
    Output: Integer
    Body: {
        i = pos
        one = 1
        WhileLoop LessThan(i, len) {
            c = RDMEM_8(text, i)
            IfCondition EqualTo(c, delim) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, one)
        }
        ReturnValue(len)
    }
}
Function.DieNumbered {
    Body: {
        IfCondition EqualTo(CutOpt.mode, 1) ThenBlock: {
            DieTry("cut: byte/character positions are numbered from 1\n")
        }
        DieTry("cut: fields are numbered from 1\n")
    }
}
Function.DieBadRange {
    Body: {
        IfCondition EqualTo(CutOpt.mode, 1) ThenBlock: {
            DieTry("cut: invalid byte or character range\n")
        }
        DieTry("cut: invalid field range\n")
    }
}
Function.DieMissing {
    Body: {
        IfCondition EqualTo(CutOpt.mode, 1) ThenBlock: {
            DieTry("cut: missing list of byte/character positions\n")
        }
        DieTry("cut: missing list of fields\n")
    }
}
Function.DieTooBig {
    Input: text: Address
    Input: a: Integer
    Input: b: Integer
    Body: {
        IfCondition EqualTo(CutOpt.mode, 1) ThenBlock: {
            WriteStderr("cut: byte/character offset '")
        } ElseBlock: {
            WriteStderr("cut: field number '")
        }
        WriteSpan(text, a, b)
        WriteStderr("' is too large\n")
        WriteStderr("Try 'cut --help' for more information.\n")
        SystemCall(60, 1)
    }
}
Function.DieInvalid {
    Input: text: Address
    Input: p: Integer
    Body: {
        IfCondition EqualTo(CutOpt.mode, 1) ThenBlock: {
            WriteStderr("cut: invalid byte/character position '")
        } ElseBlock: {
            WriteStderr("cut: invalid field value '")
        }
        n = StringLen(text)
        WriteSpan(text, p, n)
        WriteStderr("'\n")
        WriteStderr("Try 'cut --help' for more information.\n")
        SystemCall(60, 1)
    }
}
Function.SigStart {
    Input: text: Address
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        s = a
        one = 1
        WhileLoop LessThan(s, b) {
            c = RDMEM_8(text, s)
            IfCondition NotEqual(c, 48) ThenBlock: {
                ReturnValue(s)
            }
            s = Add(s, one)
        }
        ReturnValue(b)
    }
}
Function.CmpGe {
    Input: text: Address
    Input: a: Integer
    Input: lit: Address
    Input: n: Integer
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            off = Add(a, i)
            ca = RDMEM_8(text, off)
            cb = RDMEM_8(lit, i)
            IfCondition GreaterThan(ca, cb) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition LessThan(ca, cb) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        ReturnValue(1)
    }
}
Function.Accum {
    Input: text: Address
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        v = 0
        i = a
        one = 1
        ten = 10
        WhileLoop LessThan(i, b) {
            c = RDMEM_8(text, i)
            d = Subtract(c, 48)
            v = Add(Multiply(v, ten), d)
            i = Add(i, one)
        }
        ReturnValue(v)
    }
}
Function.NumValue {
    Input: text: Address
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        s = SigStart(text, a, b)
        IfCondition GreaterEqual(s, b) ThenBlock: {
            ReturnValue(0)
        }
        sig = Subtract(b, s)
        IfCondition GreaterThan(sig, 20) ThenBlock: {
            DieTooBig(text, a, b)
            ReturnValue(0)
        }
        IfCondition EqualTo(sig, 20) ThenBlock: {
            ge = CmpGe(text, s, "18446744073709551615", 20)
            IfCondition EqualTo(ge, 1) ThenBlock: {
                DieTooBig(text, a, b)
                ReturnValue(0)
            }
            ReturnValue(CutCap.big)
        }
        IfCondition EqualTo(sig, 19) ThenBlock: {
            ge = CmpGe(text, s, "9223372036854775808", 19)
            IfCondition EqualTo(ge, 1) ThenBlock: {
                ReturnValue(CutCap.big)
            }
        }
        ReturnValue(Accum(text, s, b))
    }
}
Function.AddRange {
    Input: lo: Integer
    Input: hi: Integer
    Body: {
        n = CutOpt.nrange
        IfCondition GreaterEqual(n, CutCap.ranges) ThenBlock: {
            DieBadRange()
        }
        off = Multiply(n, 8)
        WRMEM_64(CutOpt.lo, off, lo)
        WRMEM_64(CutOpt.hi, off, hi)
        one = 1
        CutOpt.nrange = Add(n, one)
    }
}
Function.FinishSpec {
    Input: dash: Integer
    Input: lhs: Integer
    Input: rhs: Integer
    Input: initial: Integer
    Input: value: Integer
    Body: {
        IfCondition EqualTo(dash, 1) ThenBlock: {
            IfCondition And(EqualTo(lhs, 0), EqualTo(rhs, 0)) ThenBlock: {
                DieTry("cut: invalid range with no endpoint: -\n")
            }
            IfCondition EqualTo(rhs, 0) ThenBlock: {
                AddRange(initial, -1)
            } ElseBlock: {
                IfCondition LessThan(value, initial) ThenBlock: {
                    DieTry("cut: invalid decreasing range\n")
                }
                AddRange(initial, value)
            }
        } ElseBlock: {
            IfCondition EqualTo(value, 0) ThenBlock: {
                DieNumbered()
            }
            AddRange(value, value)
        }
    }
}
Function.DigitEnd {
    Input: text: Address
    Input: pos: Integer
    Input: len: Integer
    Output: Integer
    Body: {
        i = pos
        one = 1
        WhileLoop LessThan(i, len) {
            c = RDMEM_8(text, i)
            IfCondition Or(LessThan(c, 48), GreaterThan(c, 57)) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, one)
        }
        ReturnValue(len)
    }
}
Function.ParseList {
    Input: list: Address
    Body: {
        len = StringLen(list)
        p = 0
        one = 1
        value = 0
        initial = 1
        lhs = 0
        rhs = 0
        dash = 0
        WhileLoop LessEqual(p, len) {
            c = 0
            IfCondition LessThan(p, len) ThenBlock: {
                c = RDMEM_8(list, p)
            }
            IfCondition EqualTo(c, 45) ThenBlock: {
                IfCondition EqualTo(dash, 1) ThenBlock: {
                    DieBadRange()
                }
                dash = 1
                p = Add(p, one)
                IfCondition EqualTo(lhs, 1) ThenBlock: {
                    IfCondition EqualTo(value, 0) ThenBlock: {
                        DieNumbered()
                    }
                    initial = value
                } ElseBlock: {
                    initial = 1
                }
                value = 0
                ContinueLoop
            }
            IfCondition EqualTo(c, 44) ThenBlock: {
                FinishSpec(dash, lhs, rhs, initial, value)
                dash = 0
                lhs = 0
                rhs = 0
                value = 0
                initial = 1
                p = Add(p, one)
                ContinueLoop
            }
            IfCondition EqualTo(c, 32) ThenBlock: {
                FinishSpec(dash, lhs, rhs, initial, value)
                dash = 0
                lhs = 0
                rhs = 0
                value = 0
                initial = 1
                p = Add(p, one)
                ContinueLoop
            }
            IfCondition EqualTo(c, 9) ThenBlock: {
                FinishSpec(dash, lhs, rhs, initial, value)
                dash = 0
                lhs = 0
                rhs = 0
                value = 0
                initial = 1
                p = Add(p, one)
                ContinueLoop
            }
            IfCondition EqualTo(c, 0) ThenBlock: {
                FinishSpec(dash, lhs, rhs, initial, value)
                BreakLoop
            }
            IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                ns = p
                p = DigitEnd(list, p, len)
                value = NumValue(list, ns, p)
                IfCondition EqualTo(dash, 1) ThenBlock: {
                    rhs = 1
                } ElseBlock: {
                    lhs = 1
                }
                ContinueLoop
            }
            DieInvalid(list, p)
        }
    }
}
Function.SortRanges {
    Body: {
        n = CutOpt.nrange
        eight = 8
        one = 1
        a = 0
        WhileLoop LessThan(a, n) {
            b = Add(a, one)
            WhileLoop LessThan(b, n) {
                ao = Multiply(a, eight)
                bo = Multiply(b, eight)
                la = RDMEM_64(CutOpt.lo, ao)
                lb = RDMEM_64(CutOpt.lo, bo)
                IfCondition GreaterThan(la, lb) ThenBlock: {
                    ha = RDMEM_64(CutOpt.hi, ao)
                    hb = RDMEM_64(CutOpt.hi, bo)
                    WRMEM_64(CutOpt.lo, ao, lb)
                    WRMEM_64(CutOpt.hi, ao, hb)
                    WRMEM_64(CutOpt.lo, bo, la)
                    WRMEM_64(CutOpt.hi, bo, ha)
                }
                b = Add(b, one)
            }
            a = Add(a, one)
        }
    }
}
Function.MergeRanges {
    Body: {
        SortRanges()
        n = CutOpt.nrange
        IfCondition EqualTo(n, 0) ThenBlock: {
            DieMissing()
        }
        eight = 8
        one = 1
        i = 0
        WhileLoop LessThan(i, n) {
            ioff = Multiply(i, eight)
            hi_i = RDMEM_64(CutOpt.hi, ioff)
            j = Add(i, one)
            WhileLoop LessThan(j, n) {
                joff = Multiply(j, eight)
                lo_j = RDMEM_64(CutOpt.lo, joff)
                IfCondition Or(EqualTo(hi_i, -1), LessEqual(lo_j, hi_i)) ThenBlock: {
                    hi_j = RDMEM_64(CutOpt.hi, joff)
                    IfCondition Or(EqualTo(hi_i, -1), EqualTo(hi_j, -1)) ThenBlock: {
                        hi_i = -1
                    } ElseBlock: {
                        IfCondition GreaterThan(hi_j, hi_i) ThenBlock: {
                            hi_i = hi_j
                        }
                    }
                    WRMEM_64(CutOpt.hi, ioff, hi_i)
                    k = j
                    WhileLoop LessThan(k, Subtract(n, one)) {
                        k1 = Add(k, one)
                        so = Multiply(k1, eight)
                        doff = Multiply(k, eight)
                        sl = RDMEM_64(CutOpt.lo, so)
                        sh = RDMEM_64(CutOpt.hi, so)
                        WRMEM_64(CutOpt.lo, doff, sl)
                        WRMEM_64(CutOpt.hi, doff, sh)
                        k = k1
                    }
                    n = Subtract(n, one)
                } ElseBlock: {
                    BreakLoop
                }
            }
            i = Add(i, one)
        }
        CutOpt.nrange = n
    }
}
Function.ComplementRanges {
    Body: {
        n = CutOpt.nrange
        eight = 8
        one = 1
        bytes = Multiply(CutCap.ranges, eight)
        tlo = Allocate(bytes)
        thi = Allocate(bytes)
        cn = 0
        IfCondition GreaterThan(n, 0) ThenBlock: {
            lo0 = RDMEM_64(CutOpt.lo, 0)
            IfCondition GreaterThan(lo0, 1) ThenBlock: {
                WRMEM_64(tlo, 0, 1)
                WRMEM_64(thi, 0, Subtract(lo0, one))
                cn = 1
            }
            i = 1
            WhileLoop LessThan(i, n) {
                ip = Subtract(i, one)
                poff = Multiply(ip, eight)
                coff = Multiply(i, eight)
                hprev = RDMEM_64(CutOpt.hi, poff)
                lcur = RDMEM_64(CutOpt.lo, coff)
                IfCondition NotEqual(hprev, -1) ThenBlock: {
                    nxt = Add(hprev, one)
                    IfCondition NotEqual(nxt, lcur) ThenBlock: {
                        off = Multiply(cn, eight)
                        WRMEM_64(tlo, off, nxt)
                        gap_hi = Subtract(lcur, one)
                        WRMEM_64(thi, off, gap_hi)
                        cn = Add(cn, one)
                    }
                }
                i = Add(i, one)
            }
            last = Subtract(n, one)
            loff = Multiply(last, eight)
            hlast = RDMEM_64(CutOpt.hi, loff)
            IfCondition And(NotEqual(hlast, -1), NotEqual(hlast, CutCap.big)) ThenBlock: {
                off = Multiply(cn, eight)
                WRMEM_64(tlo, off, Add(hlast, one))
                WRMEM_64(thi, off, -1)
                cn = Add(cn, one)
            }
        }
        IfCondition EqualTo(cn, 0) ThenBlock: {
            DieMissing()
        }
        i = 0
        WhileLoop LessThan(i, cn) {
            off = Multiply(i, eight)
            lv = RDMEM_64(tlo, off)
            hv = RDMEM_64(thi, off)
            WRMEM_64(CutOpt.lo, off, lv)
            WRMEM_64(CutOpt.hi, off, hv)
            i = Add(i, one)
        }
        CutOpt.nrange = cn
        Deallocate(tlo, bytes)
        Deallocate(thi, bytes)
    }
}
Function.FieldOn {
    Input: k: Integer
    Output: Integer
    Body: {
        i = 0
        one = 1
        eight = 8
        n = CutOpt.nrange
        WhileLoop LessThan(i, n) {
            off = Multiply(i, eight)
            lv = RDMEM_64(CutOpt.lo, off)
            hv = RDMEM_64(CutOpt.hi, off)
            IfCondition LessThan(k, lv) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(hv, -1) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition LessEqual(k, hv) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}
Function.AnyBefore {
    Input: k: Integer
    Output: Integer
    Body: {
        n = CutOpt.nrange
        IfCondition LessEqual(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        lv = RDMEM_64(CutOpt.lo, 0)
        IfCondition LessThan(lv, k) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.LineHas {
    Input: line: Address
    Input: len: Integer
    Input: delim: Integer
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, len) {
            c = RDMEM_8(line, i)
            IfCondition EqualTo(c, delim) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}
Function.AdvanceRi {
    Input: ri: Integer
    Input: idx: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        cur = ri
        one = 1
        eight = 8
        WhileLoop LessThan(cur, n) {
            off = Multiply(cur, eight)
            hv = RDMEM_64(CutOpt.hi, off)
            IfCondition EqualTo(hv, -1) ThenBlock: {
                ReturnValue(cur)
            }
            IfCondition LessEqual(idx, hv) ThenBlock: {
                ReturnValue(cur)
            }
            cur = Add(cur, one)
        }
        ReturnValue(n)
    }
}
Function.ByteKind {
    Input: ri: Integer
    Input: idx: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(ri, n) ThenBlock: {
            ReturnValue(0)
        }
        off = Multiply(ri, 8)
        lv = RDMEM_64(CutOpt.lo, off)
        IfCondition LessThan(idx, lv) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(idx, lv) ThenBlock: {
            ReturnValue(2)
        }
        ReturnValue(1)
    }
}
Function.EmitBytes {
    Input: line: Address
    Input: line_len: Integer
    Body: {
        i = 1
        one = 1
        ri = 0
        n = CutOpt.nrange
        WhileLoop LessEqual(i, line_len) {
            ri = AdvanceRi(ri, i, n)
            kind = ByteKind(ri, i, n)
            IfCondition GreaterThan(kind, 0) ThenBlock: {
                IfCondition EqualTo(kind, 2) ThenBlock: {
                    IfCondition GreaterThan(ri, 0) ThenBlock: {
                        IfCondition EqualTo(CutOpt.out_explicit, 1) ThenBlock: {
                            flo = RDMEM_64(CutOpt.lo, 0)
                            IfCondition LessEqual(flo, line_len) ThenBlock: {
                                BufferBytes(CutOpt.out_ptr, CutOpt.out_len)
                            }
                        }
                    }
                }
                b = RDMEM_8(line, Subtract(i, one))
                BufferByte(b)
            }
            i = Add(i, one)
        }
        BufferByte(CutOpt.line_delim)
    }
}
Function.EmitFields {
    Input: line: Address
    Input: len: Integer
    Body: {
        has = LineHas(line, len, CutOpt.delim)
        IfCondition EqualTo(has, 0) ThenBlock: {
            IfCondition EqualTo(CutOpt.suppress, 0) ThenBlock: {
                IfCondition GreaterThan(len, 0) ThenBlock: {
                    BufferBytes(line, len)
                }
                BufferByte(CutOpt.line_delim)
            }
        } ElseBlock: {
            field = 1
            pos = 0
            one = 1
            WhileLoop LessEqual(pos, len) {
                end = FindByte(line, pos, len, CutOpt.delim)
                on = FieldOn(field)
                IfCondition EqualTo(on, 1) ThenBlock: {
                    ab = AnyBefore(field)
                    IfCondition EqualTo(ab, 1) ThenBlock: {
                        BufferBytes(CutOpt.out_ptr, CutOpt.out_len)
                    }
                    seglen = Subtract(end, pos)
                    IfCondition GreaterThan(seglen, 0) ThenBlock: {
                        BufferBytes(Add(line, pos), seglen)
                    }
                }
                IfCondition GreaterEqual(end, len) ThenBlock: {
                    BreakLoop
                }
                field = Add(field, one)
                pos = Add(end, one)
            }
            BufferByte(CutOpt.line_delim)
        }
    }
}
Function.EmitSame {
    Input: buf: Address
    Input: n: Integer
    Body: {
        IfCondition GreaterThan(n, 0) ThenBlock: {
            has = LineHas(buf, n, CutOpt.delim)
            IfCondition EqualTo(has, 0) ThenBlock: {
                IfCondition EqualTo(CutOpt.suppress, 0) ThenBlock: {
                    BufferBytes(buf, n)
                    BufferByte(CutOpt.line_delim)
                }
            } ElseBlock: {
                field = 1
                pos = 0
                one = 1
                WhileLoop LessEqual(pos, n) {
                    end = FindByte(buf, pos, n, CutOpt.delim)
                    on = FieldOn(field)
                    IfCondition EqualTo(on, 1) ThenBlock: {
                        ab = AnyBefore(field)
                        IfCondition EqualTo(ab, 1) ThenBlock: {
                            BufferBytes(CutOpt.out_ptr, CutOpt.out_len)
                        }
                        seglen = Subtract(end, pos)
                        IfCondition GreaterThan(seglen, 0) ThenBlock: {
                            BufferBytes(Add(buf, pos), seglen)
                        }
                    }
                    IfCondition GreaterEqual(end, n) ThenBlock: {
                        BreakLoop
                    }
                    nxt = Add(end, one)
                    IfCondition GreaterEqual(nxt, n) ThenBlock: {
                        BreakLoop
                    }
                    field = Add(field, one)
                    pos = nxt
                }
                BufferByte(CutOpt.line_delim)
            }
        }
    }
}
Function.AppendLine {
    Input: dst: Address
    Input: dst_len: Integer
    Input: src: Address
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        n = Subtract(b, a)
        space = Subtract(CutCap.linesz, dst_len)
        IfCondition GreaterThan(n, space) ThenBlock: {
            n = space
        }
        IfCondition GreaterThan(n, 0) ThenBlock: {
            MemoryCopy(Add(dst, dst_len), Add(src, a), n)
        }
        ReturnValue(Add(dst_len, n))
    }
}
Function.DispatchLine {
    Input: line: Address
    Input: line_len: Integer
    Body: {
        IfCondition EqualTo(CutOpt.mode, 1) ThenBlock: {
            EmitBytes(line, line_len)
        } ElseBlock: {
            EmitFields(line, line_len)
        }
    }
}
Function.ReadAll {
    Input: fd: Integer
    Input: buf: Address
    Input: cap: Integer
    Output: Integer
    Body: {
        total = 0
        WhileLoop LessThan(total, cap) {
            space = Subtract(cap, total)
            n = SysRead(fd, Add(buf, total), space)
            IfCondition LessEqual(n, 0) ThenBlock: {
                ReturnValue(total)
            }
            total = Add(total, n)
            IfCondition GreaterEqual(total, cap) ThenBlock: {
                ReturnValue(total)
            }
        }
        ReturnValue(0)
    }
}
Function.ProcessSame {
    Input: fd: Integer
    Body: {
        buf = Allocate(CutCap.samesz)
        n = ReadAll(fd, buf, CutCap.samesz)
        EmitSame(buf, n)
        Deallocate(buf, CutCap.samesz)
    }
}
Function.ProcessLines {
    Input: fd: Integer
    Body: {
        buffer = Allocate(CutCap.readsz)
        line_buf = Allocate(CutCap.linesz)
        line_len = 0
        one = 1
        WhileLoop 1 {
            n = SysRead(fd, buffer, CutCap.readsz)
            IfCondition LessEqual(n, 0) ThenBlock: {
                BreakLoop
            }
            i = 0
            WhileLoop LessThan(i, n) {
                end = FindByte(buffer, i, n, CutOpt.line_delim)
                IfCondition GreaterEqual(end, n) ThenBlock: {
                    line_len = AppendLine(line_buf, line_len, buffer, i, n)
                    BreakLoop
                }
                IfCondition EqualTo(line_len, 0) ThenBlock: {
                    DispatchLine(Add(buffer, i), Subtract(end, i))
                } ElseBlock: {
                    line_len = AppendLine(line_buf, line_len, buffer, i, end)
                    DispatchLine(line_buf, line_len)
                    line_len = 0
                }
                i = Add(end, one)
            }
        }
        IfCondition GreaterThan(line_len, 0) ThenBlock: {
            DispatchLine(line_buf, line_len)
        }
        Deallocate(line_buf, CutCap.linesz)
        Deallocate(buffer, CutCap.readsz)
    }
}
Function.ProcessFd {
    Input: fd: Integer
    Body: {
        IfCondition And(EqualTo(CutOpt.mode, 2), EqualTo(CutOpt.delim, CutOpt.line_delim)) ThenBlock: {
            ProcessSame(fd)
        } ElseBlock: {
            ProcessLines(fd)
        }
    }
}
Function.LoadCmdline {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf = Allocate(CutCap.cmdsz)
        n = SystemCall(0, fd, buf, CutCap.cmdsz)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        CutOpt.cmd = buf
        CutOpt.cmd_len = n
        ReturnValue(buf)
    }
}
Function.NextArg {
    Output: Address
    Body: {
        p = ArgPos.pos
        limit = CutOpt.cmd_len
        buf = CutOpt.cmd
        one = 1
        IfCondition GreaterEqual(p, limit) ThenBlock: {
            ReturnValue(0)
        }
        b0 = RDMEM_8(buf, p)
        IfCondition EqualTo(b0, 0) ThenBlock: {
            ArgPos.pos = Add(p, one)
            ReturnValue(Add(buf, p))
        }
        start = p
        WhileLoop LessThan(p, limit) {
            c = RDMEM_8(buf, p)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ArgPos.pos = Add(p, one)
                ReturnValue(Add(buf, start))
            }
            p = Add(p, one)
        }
        ArgPos.pos = limit
        ReturnValue(Add(buf, start))
    }
}
Function.IsPrefix {
    Input: s: Address
    Input: n: Integer
    Input: full: Address
    Output: Integer
    Body: {
        IfCondition LessEqual(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            a = RDMEM_8(s, i)
            b = RDMEM_8(full, i)
            IfCondition EqualTo(b, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition NotEqual(a, b) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        ReturnValue(1)
    }
}
Function.MatchLong {
    Input: name: Address
    Input: nlen: Integer
    Output: Integer
    Body: {
        id = 0
        hit = IsPrefix(name, nlen, "bytes")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            id = 1
        }
        hit = IsPrefix(name, nlen, "characters")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            IfCondition NotEqual(id, 0) ThenBlock: {
                id = -1
            } ElseBlock: {
                id = 2
            }
        }
        hit = IsPrefix(name, nlen, "fields")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            IfCondition NotEqual(id, 0) ThenBlock: {
                id = -1
            } ElseBlock: {
                id = 3
            }
        }
        hit = IsPrefix(name, nlen, "delimiter")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            IfCondition NotEqual(id, 0) ThenBlock: {
                id = -1
            } ElseBlock: {
                id = 4
            }
        }
        hit = IsPrefix(name, nlen, "only-delimited")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            IfCondition NotEqual(id, 0) ThenBlock: {
                id = -1
            } ElseBlock: {
                id = 5
            }
        }
        hit = IsPrefix(name, nlen, "output-delimiter")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            IfCondition NotEqual(id, 0) ThenBlock: {
                id = -1
            } ElseBlock: {
                id = 6
            }
        }
        hit = IsPrefix(name, nlen, "complement")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            IfCondition NotEqual(id, 0) ThenBlock: {
                id = -1
            } ElseBlock: {
                id = 7
            }
        }
        hit = IsPrefix(name, nlen, "zero-terminated")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            IfCondition NotEqual(id, 0) ThenBlock: {
                id = -1
            } ElseBlock: {
                id = 8
            }
        }
        hit = IsPrefix(name, nlen, "help")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            IfCondition NotEqual(id, 0) ThenBlock: {
                id = -1
            } ElseBlock: {
                id = 9
            }
        }
        hit = IsPrefix(name, nlen, "version")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            IfCondition NotEqual(id, 0) ThenBlock: {
                id = -1
            } ElseBlock: {
                id = 10
            }
        }
        ReturnValue(id)
    }
}
Function.ApplyList {
    Input: s: Address
    Input: mode: Integer
    Body: {
        IfCondition GreaterThan(CutOpt.have_list, 0) ThenBlock: {
            DieTry("cut: only one list may be specified\n")
        }
        CutOpt.have_list = 1
        CutOpt.mode = mode
        CutOpt.list = s
    }
}
Function.ApplyDelim {
    Input: s: Address
    Body: {
        n = StringLen(s)
        IfCondition GreaterThan(n, 1) ThenBlock: {
            DieTry("cut: the delimiter must be a single character\n")
        }
        IfCondition EqualTo(n, 0) ThenBlock: {
            CutOpt.delim = 0
        } ElseBlock: {
            CutOpt.delim = RDMEM_8(s, 0)
        }
        CutOpt.delim_set = 1
    }
}
Function.ApplyOut {
    Input: s: Address
    Body: {
        n = StringLen(s)
        CutOpt.out_explicit = 1
        CutOpt.out_ptr = s
        IfCondition EqualTo(n, 0) ThenBlock: {
            CutOpt.out_len = 1
        } ElseBlock: {
            CutOpt.out_len = n
        }
    }
}
Function.NeedNext {
    Input: letter: Integer
    Output: Address
    Body: {
        nxt = NextArg()
        IfCondition EqualTo(nxt, 0) ThenBlock: {
            WriteStderr("cut: option requires an argument -- '")
            ch = Allocate(2)
            WRMEM_8(ch, 0, letter)
            WRMEM_8(ch, 1, 0)
            WriteStderr(ch)
            WriteStderr("'\n")
            WriteStderr("Try 'cut --help' for more information.\n")
            SystemCall(60, 1)
            ReturnValue(0)
        }
        ReturnValue(nxt)
    }
}
Function.TakeList {
    Input: arg: Address
    Input: i: Integer
    Input: len: Integer
    Input: mode: Integer
    Input: letter: Integer
    Body: {
        one = 1
        nxti = Add(i, one)
        IfCondition LessThan(nxti, len) ThenBlock: {
            ApplyList(Add(arg, nxti), mode)
        } ElseBlock: {
            s = NeedNext(letter)
            ApplyList(s, mode)
        }
    }
}
Function.TakeDelim {
    Input: arg: Address
    Input: i: Integer
    Input: len: Integer
    Body: {
        one = 1
        nxti = Add(i, one)
        IfCondition LessThan(nxti, len) ThenBlock: {
            ApplyDelim(Add(arg, nxti))
        } ElseBlock: {
            s = NeedNext(100)
            ApplyDelim(s)
        }
    }
}
Function.ShortOpt {
    Input: arg: Address
    Output: Integer
    Body: {
        len = StringLen(arg)
        i = 1
        one = 1
        WhileLoop LessThan(i, len) {
            c = RDMEM_8(arg, i)
            IfCondition EqualTo(c, 98) ThenBlock: {
                TakeList(arg, i, len, 1, 98)
                ReturnValue(0)
            }
            IfCondition EqualTo(c, 99) ThenBlock: {
                TakeList(arg, i, len, 1, 99)
                ReturnValue(0)
            }
            IfCondition EqualTo(c, 102) ThenBlock: {
                TakeList(arg, i, len, 2, 102)
                ReturnValue(0)
            }
            IfCondition EqualTo(c, 100) ThenBlock: {
                TakeDelim(arg, i, len)
                ReturnValue(0)
            }
            IfCondition EqualTo(c, 115) ThenBlock: {
                CutOpt.suppress = 1
            } ElseBlock: {
                IfCondition EqualTo(c, 122) ThenBlock: {
                    CutOpt.line_delim = 0
                } ElseBlock: {
                    IfCondition EqualTo(c, 110) ThenBlock: {
                        kept = c
                    } ElseBlock: {
                        WriteStderr("cut: invalid option -- '")
                        ch = Allocate(2)
                        WRMEM_8(ch, 0, c)
                        WRMEM_8(ch, 1, 0)
                        WriteStderr(ch)
                        WriteStderr("'\n")
                        WriteStderr("Try 'cut --help' for more information.\n")
                        SystemCall(60, 1)
                    }
                }
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}
Function.LongArg {
    Input: arg: Address
    Input: eq: Integer
    Input: len: Integer
    Output: Address
    Body: {
        one = 1
        IfCondition LessThan(eq, len) ThenBlock: {
            ReturnValue(Add(arg, Add(eq, one)))
        }
        nxt = NextArg()
        IfCondition EqualTo(nxt, 0) ThenBlock: {
            WriteStderr("cut: option requires an argument\n")
            WriteStderr("Try 'cut --help' for more information.\n")
            SystemCall(60, 1)
            ReturnValue(0)
        }
        ReturnValue(nxt)
    }
}
Function.RejectEq {
    Input: arg: Address
    Input: eq: Integer
    Input: len: Integer
    Body: {
        IfCondition LessThan(eq, len) ThenBlock: {
            DieTry("cut: option does not allow an argument\n")
        }
    }
}
Function.LongOpt {
    Input: arg: Address
    Output: Integer
    Body: {
        len = StringLen(arg)
        eq = FindByte(arg, 2, len, 61)
        two = 2
        nlen = Subtract(eq, two)
        id = MatchLong(Add(arg, two), nlen)
        IfCondition EqualTo(id, 0) ThenBlock: {
            WriteStderr("cut: unrecognized option '")
            WriteSpan(arg, 0, eq)
            WriteStderr("'\n")
            WriteStderr("Try 'cut --help' for more information.\n")
            SystemCall(60, 1)
        }
        IfCondition EqualTo(id, -1) ThenBlock: {
            WriteStderr("cut: option '")
            WriteSpan(arg, 0, eq)
            WriteStderr("' is ambiguous\n")
            WriteStderr("Try 'cut --help' for more information.\n")
            SystemCall(60, 1)
        }
        IfCondition EqualTo(id, 1) ThenBlock: {
            s = LongArg(arg, eq, len)
            ApplyList(s, 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(id, 2) ThenBlock: {
            s = LongArg(arg, eq, len)
            ApplyList(s, 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(id, 3) ThenBlock: {
            s = LongArg(arg, eq, len)
            ApplyList(s, 2)
            ReturnValue(0)
        }
        IfCondition EqualTo(id, 4) ThenBlock: {
            s = LongArg(arg, eq, len)
            ApplyDelim(s)
            ReturnValue(0)
        }
        IfCondition EqualTo(id, 5) ThenBlock: {
            RejectEq(arg, eq, len)
            CutOpt.suppress = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(id, 6) ThenBlock: {
            s = LongArg(arg, eq, len)
            ApplyOut(s)
            ReturnValue(0)
        }
        IfCondition EqualTo(id, 7) ThenBlock: {
            RejectEq(arg, eq, len)
            CutOpt.complement = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(id, 8) ThenBlock: {
            RejectEq(arg, eq, len)
            CutOpt.line_delim = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(id, 9) ThenBlock: {
            WriteStdoutStr("Usage: cut\n")
            SystemCall(60, 0)
        }
        IfCondition EqualTo(id, 10) ThenBlock: {
            WriteStdoutStr("cut (AILANG coreutils) 9.4\n")
            SystemCall(60, 0)
        }
        ReturnValue(0)
    }
}
Function.AddFile {
    Input: files: Address
    Input: count: Integer
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition GreaterEqual(count, CutCap.files) ThenBlock: {
            DieTry("cut: too many files\n")
        }
        off = Multiply(count, 8)
        WRMEM_64(files, off, path)
        one = 1
        ReturnValue(Add(count, one))
    }
}
Function.OpenFail {
    Input: path: Address
    Input: err: Integer
    Body: {
        WriteStderr("cut: ")
        WriteStderr(path)
        IfCondition EqualTo(err, -2) ThenBlock: {
            WriteStderr(": No such file or directory\n")
        } ElseBlock: {
            WriteStderr(": Unknown error\n")
        }
        CutOpt.exit_code = 1
    }
}
SubRoutine.Main {
    InitOutputBuffer()
    eight = 8
    CutOpt.lo = Allocate(Multiply(CutCap.ranges, eight))
    CutOpt.hi = Allocate(Multiply(CutCap.ranges, eight))
    files = Allocate(Multiply(CutCap.files, eight))
    file_count = 0

    buf = LoadCmdline()
    IfCondition EqualTo(buf, 0) ThenBlock: {
        WriteStderr("cut: could not read command line\n")
        SystemCall(60, 1)
    }
    ArgPos.pos = 0
    prog = NextArg()
    WhileLoop 1 {
        arg = NextArg()
        IfCondition EqualTo(arg, 0) ThenBlock: {
            BreakLoop
        }
        IfCondition EqualTo(CutOpt.opts_done, 1) ThenBlock: {
            file_count = AddFile(files, file_count, arg)
            ContinueLoop
        }
        a0 = RDMEM_8(arg, 0)
        a1 = RDMEM_8(arg, 1)
        IfCondition EqualTo(a0, 45) ThenBlock: {
            IfCondition EqualTo(a1, 0) ThenBlock: {
                file_count = AddFile(files, file_count, arg)
                ContinueLoop
            }
            IfCondition EqualTo(a1, 45) ThenBlock: {
                a2 = RDMEM_8(arg, 2)
                IfCondition EqualTo(a2, 0) ThenBlock: {
                    CutOpt.opts_done = 1
                    ContinueLoop
                }
                ignored = LongOpt(arg)
                ContinueLoop
            }
            ignored = ShortOpt(arg)
            ContinueLoop
        }
        file_count = AddFile(files, file_count, arg)
    }

    IfCondition EqualTo(CutOpt.have_list, 0) ThenBlock: {
        DieTry("cut: you must specify a list of bytes, characters, or fields\n")
    }
    IfCondition And(EqualTo(CutOpt.mode, 1), EqualTo(CutOpt.delim_set, 1)) ThenBlock: {
        DieTry("cut: an input delimiter may be specified only when operating on fields\n")
    }
    IfCondition And(EqualTo(CutOpt.mode, 1), EqualTo(CutOpt.suppress, 1)) ThenBlock: {
        WriteStderr("cut: suppressing non-delimited lines makes sense\n")
        WriteStderr("	only when operating on fields\n")
        WriteStderr("Try 'cut --help' for more information.\n")
        SystemCall(60, 1)
    }
    ParseList(CutOpt.list)
    MergeRanges()
    IfCondition EqualTo(CutOpt.complement, 1) ThenBlock: {
        ComplementRanges()
    }
    IfCondition EqualTo(CutOpt.out_explicit, 0) ThenBlock: {
        ob = Allocate(1)
        WRMEM_8(ob, 0, CutOpt.delim)
        CutOpt.out_ptr = ob
        CutOpt.out_len = 1
    }

    IfCondition EqualTo(file_count, 0) ThenBlock: {
        ProcessFd(0)
    } ElseBlock: {
        i = 0
        one = 1
        WhileLoop LessThan(i, file_count) {
            fpath = RDMEM_64(files, Multiply(i, eight))
            IfCondition And(EqualTo(RDMEM_8(fpath, 0), 45), EqualTo(RDMEM_8(fpath, 1), 0)) ThenBlock: {
                ProcessFd(0)
            } ElseBlock: {
                fd = SysOpen(fpath)
                IfCondition LessThan(fd, 0) ThenBlock: {
                    OpenFail(fpath, fd)
                } ElseBlock: {
                    ProcessFd(fd)
                    SystemCall(3, fd)
                }
            }
            i = Add(i, one)
        }
    }
    FlushOutputBuffer()
    SystemCall(60, CutOpt.exit_code)
}
RunTask(Main)
