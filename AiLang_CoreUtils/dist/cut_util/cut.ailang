// cut.ailang — select fields or bytes from each line
// Flags: -d DELIM, -f LIST (e.g. 1, 1,3, 2-4, 1,3-5),
//        -c LIST (character/byte ranges, same LIST syntax),
//        -s (suppress lines without delimiter).
// Default delimiter is TAB. If no file is given, or file is "-", read stdin.
// Rewritten April 2026: old version was broken under the new compiler —
// MemCopy → MemoryCopy, Arena import required, and -d / multi-field support
// were missing entirely.

LibraryImport.Arena

FixedPool.CutConfig {
    "delimiter":     Initialize=9     // TAB by default
    "mode":          Initialize=0     // 0=fields, 1=chars/bytes
    "suppress":      Initialize=0     // -s
}

FixedPool.CutConstants {
    "BUFFER_SIZE":        Initialize=65536
    "LINE_CAP":           Initialize=1048576
    "OUTPUT_BUFFER_SIZE": Initialize=65536
    "MAX_FIELD":          Initialize=4096
    "MAX_FILES":          Initialize=1000
    "ARGBUF":             Initialize=8192
}

// Field-selection bitmap: one byte per slot, 1 = selected.
FixedPool.CutMask {
    "mask":       Initialize=0
    "highest":    Initialize=0   // highest selected slot (1-based)
    "to_end":     Initialize=0   // set when LIST ends with "N-" (open range)
    "to_end_from":Initialize=0   // N in "N-"
}

FixedPool.OutputBuffer {
    "buffer":   Initialize=0
    "position": Initialize=0
}

// === SYSCALL WRAPPERS ===

Function.SysOpen {
    Input: filename: Address
    Output: Integer
    Body: {
        ReturnValue(SystemCall(2, filename, 0, 0))
    }
}

Function.SysRead {
    Input: fd: Integer
    Input: buffer: Address
    Input: count: Integer
    Output: Integer
    Body: {
        ReturnValue(SystemCall(0, fd, buffer, count))
    }
}

Function.SysClose {
    Input: fd: Integer
    Body: { SystemCall(3, fd) }
}

Function.SysWrite {
    Input: fd: Integer
    Input: buffer: Address
    Input: count: Integer
    Body: { SystemCall(1, fd, buffer, count) }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SysWrite(2, str, len)
    }
}

Function.WriteStdoutStr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SysWrite(1, str, len)
    }
}

// === OUTPUT BUFFER ===

Function.InitOutputBuffer {
    Body: {
        OutputBuffer.buffer = Allocate(CutConstants.OUTPUT_BUFFER_SIZE)
        OutputBuffer.position = 0
    }
}

Function.FlushOutputBuffer {
    Body: {
        IfCondition GreaterThan(OutputBuffer.position, 0) ThenBlock: {
            SysWrite(1, OutputBuffer.buffer, OutputBuffer.position)
            OutputBuffer.position = 0
        }
    }
}

Function.BufferBytes {
    Input: data: Address
    Input: len: Integer
    Body: {
        left = len
        src = data
        WhileLoop GreaterThan(left, 0) {
            space = Subtract(CutConstants.OUTPUT_BUFFER_SIZE, OutputBuffer.position)
            IfCondition LessEqual(space, 0) ThenBlock: {
                FlushOutputBuffer()
                space = CutConstants.OUTPUT_BUFFER_SIZE
            }
            chunk = left
            IfCondition GreaterThan(chunk, space) ThenBlock: {
                chunk = space
            }
            MemoryCopy(Add(OutputBuffer.buffer, OutputBuffer.position), src, chunk)
            OutputBuffer.position = Add(OutputBuffer.position, chunk)
            src = Add(src, chunk)
            left = Subtract(left, chunk)
        }
    }
}

Function.BufferByte {
    Input: byte: Integer
    Body: {
        IfCondition GreaterEqual(OutputBuffer.position, CutConstants.OUTPUT_BUFFER_SIZE) ThenBlock: {
            FlushOutputBuffer()
        }
        SetByte(OutputBuffer.buffer, OutputBuffer.position, byte)
        OutputBuffer.position = Add(OutputBuffer.position, 1)
    }
}

// === HELPERS ===

Function.StringLen {
    Input: str: Address
    Output: Integer
    Body: {
        n = 0
        WhileLoop NotEqual(GetByte(str, n), 0) {
            n = Add(n, 1)
        }
        ReturnValue(n)
    }
}

Function.StrEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop 1 {
            ca = GetByte(a, i)
            cb = GetByte(b, i)
            IfCondition NotEqual(ca, cb) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(ca, 0) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Parse leading decimal digits from buffer[pos..] until a non-digit.
// Returns the value; sets OutputConsumed side-effect via out_pos pool slot.
FixedPool.ParseIntState { "last_pos": Initialize=0 }

Function.ParseUInt {
    Input: buffer: Address
    Input: pos: Integer
    Input: limit: Integer
    Output: Integer
    Body: {
        v = 0
        p = pos
        WhileLoop LessThan(p, limit) {
            ch = GetByte(buffer, p)
            IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                BreakLoop
            }
            v = Add(Multiply(v, 10), Subtract(ch, 48))
            p = Add(p, 1)
        }
        ParseIntState.last_pos = p
        ReturnValue(v)
    }
}

// Bitmap-style mask using the CutMask pool. We store 1-bit per field in a
// separate Allocate'd buffer so we can address up to MAX_FIELD fields.
FixedPool.FieldBits { "bits": Initialize=0 }

// Closed runs of selected character positions for -c/-b.
// ends[i] == -1 means "through the end of the line" (an N- range).
FixedPool.CharRuns {
    "starts": Initialize=0
    "ends":   Initialize=0
    "count":  Initialize=0
}

Function.InitFieldMask {
    Body: {
        FieldBits.bits = Allocate(CutConstants.MAX_FIELD)
        i = 0
        WhileLoop LessThan(i, CutConstants.MAX_FIELD) {
            SetByte(FieldBits.bits, i, 0)
            i = Add(i, 1)
        }
        CutMask.highest = 0
        CutMask.to_end = 0
        CutMask.to_end_from = 0
    }
}

Function.MarkField {
    Input: n: Integer
    Body: {
        IfCondition And(GreaterThan(n, 0), LessThan(n, CutConstants.MAX_FIELD)) ThenBlock: {
            SetByte(FieldBits.bits, n, 1)
            IfCondition GreaterThan(n, CutMask.highest) ThenBlock: {
                CutMask.highest = n
            }
        }
    }
}

Function.FieldSelected {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition And(GreaterThan(CutMask.to_end, 0), GreaterEqual(n, CutMask.to_end_from)) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition GreaterEqual(n, CutConstants.MAX_FIELD) ThenBlock: { ReturnValue(0) }
        ReturnValue(GetByte(FieldBits.bits, n))
    }
}

// Parse a LIST like "1,3,5-7,9-" into the field mask.
// Syntax:  N | N-M | N- | -M
Function.ParseFieldList {
    Input: list: Address
    Output: Integer
    Body: {
        len = StringLen(list)
        p = 0
        WhileLoop LessThan(p, len) {
            // Leading dash means "from 1 to M"
            IfCondition EqualTo(GetByte(list, p), 45) ThenBlock: {
                p = Add(p, 1)
                m = ParseUInt(list, p, len)
                p = ParseIntState.last_pos
                j = 1
                WhileLoop LessEqual(j, m) {
                    MarkField(j)
                    j = Add(j, 1)
                }
            } ElseBlock: {
                n = ParseUInt(list, p, len)
                p = ParseIntState.last_pos
                IfCondition And(LessThan(p, len), EqualTo(GetByte(list, p), 45)) ThenBlock: {
                    // Range
                    p = Add(p, 1)
                    IfCondition Or(GreaterEqual(p, len), EqualTo(GetByte(list, p), 44)) ThenBlock: {
                        // N- (open)
                        CutMask.to_end = 1
                        CutMask.to_end_from = n
                        IfCondition GreaterThan(n, CutMask.highest) ThenBlock: {
                            CutMask.highest = n
                        }
                    } ElseBlock: {
                        m2 = ParseUInt(list, p, len)
                        p = ParseIntState.last_pos
                        j = n
                        WhileLoop LessEqual(j, m2) {
                            MarkField(j)
                            j = Add(j, 1)
                        }
                    }
                } ElseBlock: {
                    MarkField(n)
                }
            }
            // Skip optional comma
            IfCondition And(LessThan(p, len), EqualTo(GetByte(list, p), 44)) ThenBlock: {
                p = Add(p, 1)
            }
        }
        ReturnValue(1)
    }
}

// === CORE LOGIC ===

// Turn the selection mask into inclusive 1-based runs so -c copies
// spans with MemoryCopy instead of testing every byte.
Function.BuildCharRuns {
    Body: {
        bytes = Multiply(CutConstants.MAX_FIELD, 8)
        CharRuns.starts = Allocate(bytes)
        CharRuns.ends = Allocate(bytes)
        CharRuns.count = 0

        cap = CutMask.highest
        IfCondition GreaterThan(CutMask.to_end, 0) ThenBlock: {
            before = Subtract(CutMask.to_end_from, 1)
            IfCondition LessThan(before, cap) ThenBlock: {
                cap = before
            }
            IfCondition LessThan(cap, 0) ThenBlock: {
                cap = 0
            }
        }

        i = 1
        WhileLoop LessEqual(i, cap) {
            sel = FieldSelected(i)
            IfCondition EqualTo(sel, 1) ThenBlock: {
                start = i
                i = Add(i, 1)
                extending = 1
                WhileLoop And(LessEqual(i, cap), EqualTo(extending, 1)) {
                    sel = FieldSelected(i)
                    IfCondition EqualTo(sel, 1) ThenBlock: {
                        i = Add(i, 1)
                    } ElseBlock: {
                        extending = 0
                    }
                }
                idx = CharRuns.count
                StoreValue(Add(CharRuns.starts, Multiply(idx, 8)), start)
                end = Subtract(i, 1)
                StoreValue(Add(CharRuns.ends, Multiply(idx, 8)), end)
                CharRuns.count = Add(idx, 1)
            } ElseBlock: {
                i = Add(i, 1)
            }
        }

        IfCondition GreaterThan(CutMask.to_end, 0) ThenBlock: {
            idx = CharRuns.count
            StoreValue(Add(CharRuns.starts, Multiply(idx, 8)), CutMask.to_end_from)
            StoreValue(Add(CharRuns.ends, Multiply(idx, 8)), -1)
            CharRuns.count = Add(idx, 1)
        }
    }
}

Function.DispatchLine {
    Input: line: Address
    Input: line_len: Integer
    Body: {
        IfCondition EqualTo(CutConfig.mode, 0) ThenBlock: {
            EmitFields(line, line_len, CutConfig.delimiter)
        } ElseBlock: {
            EmitChars(line, line_len)
        }
    }
}

// Emit a line of fields. MemChr jumps to the next delimiter; the bytes
// between delimiters are copied and not examined one by one.
Function.EmitFields {
    Input: line: Address
    Input: line_len: Integer
    Input: delim: Integer
    Body: {
        dpos = -1
        IfCondition GreaterThan(line_len, 0) ThenBlock: {
            dpos = MemChr(line, delim, line_len)
        }

        // A line with no delimiter is passed through unchanged, unless -s.
        IfCondition LessThan(dpos, 0) ThenBlock: {
            IfCondition EqualTo(CutConfig.suppress, 0) ThenBlock: {
                BufferBytes(line, line_len)
                BufferByte(10)
            }
        } ElseBlock: {
            field_idx = 1
            field_start = 0
            emitted = 0

            WhileLoop LessEqual(field_start, line_len) {
                // N- selects the rest of the line, delimiters included.
                open_here = 0
                IfCondition GreaterThan(CutMask.to_end, 0) ThenBlock: {
                    IfCondition GreaterEqual(field_idx, CutMask.to_end_from) ThenBlock: {
                        open_here = 1
                    }
                }
                IfCondition EqualTo(open_here, 1) ThenBlock: {
                    IfCondition GreaterThan(emitted, 0) ThenBlock: {
                        BufferByte(delim)
                    }
                    suf = Subtract(line_len, field_start)
                    IfCondition GreaterThan(suf, 0) ThenBlock: {
                        BufferBytes(Add(line, field_start), suf)
                    }
                    BreakLoop
                }

                past = 0
                IfCondition EqualTo(CutMask.to_end, 0) ThenBlock: {
                    IfCondition GreaterThan(field_idx, CutMask.highest) ThenBlock: {
                        past = 1
                    }
                }
                IfCondition EqualTo(past, 1) ThenBlock: {
                    BreakLoop
                }

                rel = -1
                remain = Subtract(line_len, field_start)
                IfCondition GreaterThan(remain, 0) ThenBlock: {
                    rel = MemChr(Add(line, field_start), delim, remain)
                }
                IfCondition LessThan(rel, 0) ThenBlock: {
                    end = line_len
                } ElseBlock: {
                    end = Add(field_start, rel)
                }

                IfCondition EqualTo(FieldSelected(field_idx), 1) ThenBlock: {
                    IfCondition GreaterThan(emitted, 0) ThenBlock: {
                        BufferByte(delim)
                    }
                    seg_len = Subtract(end, field_start)
                    IfCondition GreaterThan(seg_len, 0) ThenBlock: {
                        BufferBytes(Add(line, field_start), seg_len)
                    }
                    emitted = Add(emitted, 1)
                }

                IfCondition LessThan(rel, 0) ThenBlock: {
                    BreakLoop
                }
                field_idx = Add(field_idx, 1)
                field_start = Add(end, 1)
            }
            BufferByte(10)
        }
    }
}

// Emit characters/bytes from the prebuilt runs (-c / -b).
Function.EmitChars {
    Input: line: Address
    Input: line_len: Integer
    Body: {
        r = 0
        WhileLoop LessThan(r, CharRuns.count) {
            start = Dereference(Add(CharRuns.starts, Multiply(r, 8)))
            end = Dereference(Add(CharRuns.ends, Multiply(r, 8)))
            off = Subtract(start, 1)
            IfCondition GreaterEqual(off, line_len) ThenBlock: {
                BreakLoop
            }
            IfCondition LessThan(end, 0) ThenBlock: {
                suf = Subtract(line_len, off)
                BufferBytes(Add(line, off), suf)
                BreakLoop
            }
            IfCondition GreaterThan(end, line_len) ThenBlock: {
                end = line_len
            }
            seg = Subtract(end, off)
            IfCondition GreaterThan(seg, 0) ThenBlock: {
                BufferBytes(Add(line, off), seg)
            }
            r = Add(r, 1)
        }
        BufferByte(10)
    }
}

// Append up to `space` bytes of a partial line. Lines are capped at
// BUFFER_SIZE, matching the previous per-byte copy.
Function.TakePartial {
    Input: dst: Address
    Input: dst_len: Integer
    Input: src: Address
    Input: src_len: Integer
    Output: Integer
    Body: {
        space = Subtract(CutConstants.LINE_CAP, dst_len)
        take = src_len
        IfCondition GreaterThan(take, space) ThenBlock: {
            take = space
        }
        IfCondition GreaterThan(take, 0) ThenBlock: {
            MemoryCopy(Add(dst, dst_len), src, take)
            dst_len = Add(dst_len, take)
        }
        ReturnValue(dst_len)
    }
}

// Stream a file descriptor. Whole lines inside the read are dispatched
// in place. Only a line that crosses a read is copied into line_buf.
Function.ProcessFd {
    Input: fd: Integer
    Body: {
        IfCondition And(EqualTo(CutConfig.mode, 1), EqualTo(CharRuns.starts, 0)) ThenBlock: {
            BuildCharRuns()
        }

        buffer = Allocate(CutConstants.BUFFER_SIZE)
        line_buf = Allocate(CutConstants.LINE_CAP)
        line_len = 0

        WhileLoop 1 {
            n = SysRead(fd, buffer, CutConstants.BUFFER_SIZE)
            IfCondition LessEqual(n, 0) ThenBlock: { BreakLoop }

            i = 0
            WhileLoop LessThan(i, n) {
                remain = Subtract(n, i)
                search = Add(buffer, i)
                nl = MemChr(search, 10, remain)
                IfCondition LessThan(nl, 0) ThenBlock: {
                    line_len = TakePartial(line_buf, line_len, search, remain)
                    i = n
                } ElseBlock: {
                    IfCondition EqualTo(line_len, 0) ThenBlock: {
                        DispatchLine(search, nl)
                    } ElseBlock: {
                        line_len = TakePartial(line_buf, line_len, search, nl)
                        DispatchLine(line_buf, line_len)
                        line_len = 0
                    }
                    i = Add(i, Add(nl, 1))
                }
            }
        }

        IfCondition GreaterThan(line_len, 0) ThenBlock: {
            DispatchLine(line_buf, line_len)
        }

        Deallocate(line_buf, CutConstants.LINE_CAP)
        Deallocate(buffer, CutConstants.BUFFER_SIZE)
    }
}

// === ARG PARSING ===
// Reads /proc/self/cmdline (NUL-separated argv) into an Allocate'd buffer.

Function.LoadCmdline {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(CutConstants.ARGBUF)
        n = SystemCall(0, fd, buf, CutConstants.ARGBUF)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, CutConstants.ARGBUF)
            ReturnValue(0)
        }
        ReturnValue(buf)
    }
}

// Returns pointer to next argv slot, advancing *pos past the NUL.
// When the end is reached, returns 0.
FixedPool.ArgPos { "pos": Initialize=0 }

Function.NextArg {
    Input: buf: Address
    Input: limit: Integer
    Output: Address
    Body: {
        p = ArgPos.pos
        IfCondition GreaterEqual(p, limit) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(buf, p), 0) ThenBlock: { ReturnValue(0) }
        start = p
        WhileLoop And(LessThan(p, limit), NotEqual(GetByte(buf, p), 0)) {
            p = Add(p, 1)
        }
        // Advance past the NUL for next call
        ArgPos.pos = Add(p, 1)
        ReturnValue(Add(buf, start))
    }
}

Function.PrintUsage {
    Body: {
        WriteStdoutStr("Usage: cut -f LIST [-d DELIM] [-s] [FILE]...\n")
        WriteStdoutStr("       cut -c LIST [FILE]...\n")
        WriteStdoutStr("       cut -b LIST [FILE]...\n")
        WriteStdoutStr("Select portions of each line of FILE(s) and print on stdout.\n")
        WriteStdoutStr("With no FILE, or when FILE is -, read standard input.\n")
    }
}

SubRoutine.Main {
    InitOutputBuffer()
    InitFieldMask()

    buf = LoadCmdline()
    IfCondition EqualTo(buf, 0) ThenBlock: {
        WriteStderr("cut: could not read /proc/self/cmdline\n")
        SystemCall(60, 1)
    }

    // Gather file paths (pointers into cmdline buffer, not copied)
    files = Allocate(Multiply(CutConstants.MAX_FILES, 8))
    file_count = 0
    list_str = 0
    have_list = 0

    ArgPos.pos = 0
    // Skip argv[0]
    prog = NextArg(buf, CutConstants.ARGBUF)

    WhileLoop 1 {
        arg = NextArg(buf, CutConstants.ARGBUF)
        IfCondition EqualTo(arg, 0) ThenBlock: { BreakLoop }

        a0 = GetByte(arg, 0)
        a1 = GetByte(arg, 1)

        IfCondition And(EqualTo(a0, 45), NotEqual(a1, 0)) ThenBlock: {
            // -d: delimiter (either -dX or -d X)
            IfCondition EqualTo(a1, 100) ThenBlock: {
                IfCondition NotEqual(GetByte(arg, 2), 0) ThenBlock: {
                    CutConfig.delimiter = GetByte(arg, 2)
                } ElseBlock: {
                    nxt = NextArg(buf, CutConstants.ARGBUF)
                    IfCondition EqualTo(nxt, 0) ThenBlock: {
                        WriteStderr("cut: option -d requires an argument\n")
                        SystemCall(60, 1)
                    }
                    CutConfig.delimiter = GetByte(nxt, 0)
                }
                ContinueLoop
            }
            // -f / -c / -b: field or char list
            IfCondition Or(Or(EqualTo(a1, 102), EqualTo(a1, 99)), EqualTo(a1, 98)) ThenBlock: {
                CutConfig.mode = 0
                IfCondition Or(EqualTo(a1, 99), EqualTo(a1, 98)) ThenBlock: {
                    CutConfig.mode = 1
                }
                IfCondition NotEqual(GetByte(arg, 2), 0) ThenBlock: {
                    list_str = Add(arg, 2)
                } ElseBlock: {
                    list_str = NextArg(buf, CutConstants.ARGBUF)
                    IfCondition EqualTo(list_str, 0) ThenBlock: {
                        WriteStderr("cut: option requires an argument\n")
                        SystemCall(60, 1)
                    }
                }
                ParseFieldList(list_str)
                have_list = 1
                ContinueLoop
            }
            // -s
            IfCondition EqualTo(a1, 115) ThenBlock: {
                CutConfig.suppress = 1
                ContinueLoop
            }
            // -h / --help
            IfCondition EqualTo(a1, 104) ThenBlock: {
                PrintUsage()
                SystemCall(60, 0)
            }
            // lone "-" means stdin
            IfCondition EqualTo(a1, 0) ThenBlock: {
                StoreValue(Add(files, Multiply(file_count, 8)), arg)
                file_count = Add(file_count, 1)
                ContinueLoop
            }
            WriteStderr("cut: unknown option\n")
            SystemCall(60, 1)
        } ElseBlock: {
            // Positional = file
            StoreValue(Add(files, Multiply(file_count, 8)), arg)
            file_count = Add(file_count, 1)
        }
    }

    IfCondition EqualTo(have_list, 0) ThenBlock: {
        WriteStderr("cut: you must specify a list of fields (-f), chars (-c), or bytes (-b)\n")
        SystemCall(60, 1)
    }

    exit_code = 0
    IfCondition EqualTo(file_count, 0) ThenBlock: {
        ProcessFd(0)
    } ElseBlock: {
        i = 0
        WhileLoop LessThan(i, file_count) {
            fpath = Dereference(Add(files, Multiply(i, 8)))
            // "-" → stdin
            IfCondition And(EqualTo(GetByte(fpath, 0), 45), EqualTo(GetByte(fpath, 1), 0)) ThenBlock: {
                ProcessFd(0)
            } ElseBlock: {
                fd = SysOpen(fpath)
                IfCondition LessThan(fd, 0) ThenBlock: {
                    WriteStderr("cut: ")
                    WriteStderr(fpath)
                    WriteStderr(": cannot open\n")
                    exit_code = 1
                } ElseBlock: {
                    ProcessFd(fd)
                    SysClose(fd)
                }
            }
            i = Add(i, 1)
        }
    }

    FlushOutputBuffer()
    IfCondition NotEqual(CharRuns.starts, 0) ThenBlock: {
        run_bytes = Multiply(CutConstants.MAX_FIELD, 8)
        Deallocate(CharRuns.starts, run_bytes)
        Deallocate(CharRuns.ends, run_bytes)
    }
    Deallocate(OutputBuffer.buffer, CutConstants.OUTPUT_BUFFER_SIZE)
    Deallocate(FieldBits.bits, CutConstants.MAX_FIELD)
    Deallocate(files, Multiply(CutConstants.MAX_FILES, 8))
    Deallocate(buf, CutConstants.ARGBUF)

    SystemCall(60, exit_code)
}

RunTask(Main)
