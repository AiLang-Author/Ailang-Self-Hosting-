// DateParse.ailang - GNU date field parser.
// No pool and no RunTask. Every name starts with Dp.
// Slot words: 0 year, 1 month, 2 day, 3 hour, 4 minute, 5 second,
// 6 nsec, 7 posix offset (add to local to get UTC), 8 zone flag,
// 9 have_date, 10 have_time, 11 have_utc, 12 utc,
// 13-16 today year/month/day/wday, 18 wday, 19 yday.
// Scratch: 30 value, 31 sod, 32 frac nsec, 33 digits, 35 peek at, 36 peek len.
// A date-string zone is ISO-east. Env and TZ="..." are POSIX, opposite sign.
LibraryImport.Arena

Function.DpGet {
    Input: slots: Address
    Input: idx: Integer
    Output: Integer
    Body: {
        off = Multiply(idx, 8)
        p = Add(slots, off)
        v = RDMEM_64(p)
        ReturnValue(v)
    }
}

Function.DpSet {
    Input: slots: Address
    Input: idx: Integer
    Input: v: Integer
    Body: {
        off = Multiply(idx, 8)
        p = Add(slots, off)
        WRMEM_64(p, v)
        ReturnValue(0)
    }
}

Function.DpAt {
    Input: text: Address
    Input: i: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(i, n) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(i, 0) ThenBlock: {
            ReturnValue(0)
        }
        b = RDMEM_8(text, i)
        ReturnValue(b)
    }
}

Function.DpLetter {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(c, 65), LessEqual(c, 90)) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition And(GreaterEqual(c, 97), LessEqual(c, 122)) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.DpLeap {
    Input: year: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(Modulo(year, 4), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(Modulo(year, 100), 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Modulo(year, 400), 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.DpDiy {
    Input: year: Integer
    Output: Integer
    Body: {
        leap = DpLeap(year)
        IfCondition EqualTo(leap, 1) ThenBlock: {
            ReturnValue(366)
        }
        ReturnValue(365)
    }
}

Function.DpDim {
    Input: year: Integer
    Input: month: Integer
    Output: Integer
    Body: {
        days = 31
        IfCondition EqualTo(month, 2) ThenBlock: {
            days = 28
            leap = DpLeap(year)
            IfCondition EqualTo(leap, 1) ThenBlock: {
                days = 29
            }
        }
        IfCondition EqualTo(month, 4) ThenBlock: { days = 30 }
        IfCondition EqualTo(month, 6) ThenBlock: { days = 30 }
        IfCondition EqualTo(month, 9) ThenBlock: { days = 30 }
        IfCondition EqualTo(month, 11) ThenBlock: { days = 30 }
        ReturnValue(days)
    }
}

Function.DpSkip {
    Input: text: Address
    Input: i: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        one = 1
        WhileLoop LessThan(i, n) {
            c = RDMEM_8(text, i)
            IfCondition EqualTo(c, 32) ThenBlock: {
                i = Add(i, one)
                ContinueLoop
            }
            IfCondition EqualTo(c, 9) ThenBlock: {
                i = Add(i, one)
                ContinueLoop
            }
            ReturnValue(i)
        }
        ReturnValue(i)
    }
}

Function.DpSkipSep {
    Input: text: Address
    Input: i: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        one = 1
        WhileLoop LessThan(i, n) {
            c = RDMEM_8(text, i)
            IfCondition EqualTo(c, 32) ThenBlock: {
                i = Add(i, one)
                ContinueLoop
            }
            IfCondition EqualTo(c, 9) ThenBlock: {
                i = Add(i, one)
                ContinueLoop
            }
            IfCondition EqualTo(c, 45) ThenBlock: {
                i = Add(i, one)
                ContinueLoop
            }
            ReturnValue(i)
        }
        ReturnValue(i)
    }
}

Function.DpDigits {
    Input: text: Address
    Input: i: Integer
    Input: n: Integer
    Input: slots: Address
    Output: Integer
    Body: {
        val = 0
        cnt = 0
        one = 1
        WhileLoop LessThan(i, n) {
            c = RDMEM_8(text, i)
            IfCondition Or(LessThan(c, 48), GreaterThan(c, 57)) ThenBlock: {
                BreakLoop
            }
            d = Subtract(c, 48)
            val = Multiply(val, 10)
            val = Add(val, d)
            cnt = Add(cnt, one)
            i = Add(i, one)
        }
        DpSet(slots, 30, val)
        DpSet(slots, 33, cnt)
        ReturnValue(i)
    }
}

Function.DpFrac {
    Input: text: Address
    Input: i: Integer
    Input: n: Integer
    Input: slots: Address
    Output: Integer
    Body: {
        one = 1
        i = Add(i, one)
        place = 100000000
        nsec = 0
        cnt = 0
        WhileLoop And(LessThan(i, n), LessThan(cnt, 9)) {
            c = RDMEM_8(text, i)
            IfCondition Or(LessThan(c, 48), GreaterThan(c, 57)) ThenBlock: {
                BreakLoop
            }
            d = Subtract(c, 48)
            add = Multiply(d, place)
            nsec = Add(nsec, add)
            place = Divide(place, 10)
            cnt = Add(cnt, one)
            i = Add(i, one)
        }
        WhileLoop LessThan(i, n) {
            c = RDMEM_8(text, i)
            IfCondition Or(LessThan(c, 48), GreaterThan(c, 57)) ThenBlock: {
                BreakLoop
            }
            i = Add(i, one)
        }
        DpSet(slots, 32, nsec)
        ReturnValue(i)
    }
}


Function.DpPeek {
    Input: text: Address
    Input: i: Integer
    Input: n: Integer
    Input: slots: Address
    Output: Integer
    Body: {
        j = DpSkip(text, i, n)
        DpSet(slots, 35, j)
        len = DpWordLen(text, j, n)
        DpSet(slots, 36, len)
        IfCondition EqualTo(len, 0) ThenBlock: {
            ReturnValue(0)
        }
        kind = DpKind(text, j, len)
        ReturnValue(kind)
    }
}

Function.DpYear {
    Input: yy: Integer
    Input: nd: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(nd, 4) ThenBlock: {
            ReturnValue(yy)
        }
        IfCondition GreaterEqual(yy, 69) ThenBlock: {
            y = Add(1900, yy)
            ReturnValue(y)
        }
        y = Add(2000, yy)
        ReturnValue(y)
    }
}

Function.DpSplitDay {
    Input: slots: Address
    Input: sec: Integer
    Body: {
        IfCondition GreaterEqual(sec, 0) ThenBlock: {
            days = Divide(sec, 86400)
            sod = Modulo(sec, 86400)
            DpSet(slots, 30, days)
            DpSet(slots, 31, sod)
            ReturnValue(0)
        }
        abs = Subtract(0, sec)
        q = Divide(abs, 86400)
        r = Modulo(abs, 86400)
        IfCondition NotEqual(r, 0) ThenBlock: {
            q1 = Add(q, 1)
            days = Subtract(0, q1)
            sod = Subtract(86400, r)
            DpSet(slots, 30, days)
            DpSet(slots, 31, sod)
            ReturnValue(0)
        }
        days = Subtract(0, q)
        DpSet(slots, 30, days)
        DpSet(slots, 31, 0)
        ReturnValue(0)
    }
}

Function.DpWriteCivil {
    Input: slots: Address
    Input: local: Integer
    Body: {
        DpSplitDay(slots, local)
        days = DpGet(slots, 30)
        sod = DpGet(slots, 31)
        edays = days
        hour = Divide(sod, 3600)
        rem = Modulo(sod, 3600)
        minute = Divide(rem, 60)
        second = Modulo(sod, 60)
        one = 1
        IfCondition GreaterEqual(days, 0) ThenBlock: {
            year = 1970
            guard = 0
            WhileLoop LessThan(guard, 4000) {
                diy = DpDiy(year)
                IfCondition LessThan(days, diy) ThenBlock: {
                    BreakLoop
                }
                days = Subtract(days, diy)
                year = Add(year, one)
                guard = Add(guard, one)
            }
            DpSet(slots, 0, year)
        } ElseBlock: {
            year = 1969
            guard = 0
            WhileLoop And(LessThan(days, 0), LessThan(guard, 4000)) {
                diy = DpDiy(year)
                days = Add(days, diy)
                IfCondition LessThan(days, 0) ThenBlock: {
                    year = Subtract(year, one)
                }
                guard = Add(guard, one)
            }
            DpSet(slots, 0, year)
        }
        year = DpGet(slots, 0)
        yday = Add(days, 1)
        month = 1
        guard = 0
        WhileLoop And(LessEqual(month, 12), LessThan(guard, 24)) {
            dim = DpDim(year, month)
            IfCondition LessThan(days, dim) ThenBlock: {
                BreakLoop
            }
            days = Subtract(days, dim)
            month = Add(month, one)
            guard = Add(guard, one)
        }
        day = Add(days, 1)
        DpSet(slots, 1, month)
        DpSet(slots, 2, day)
        DpSet(slots, 3, hour)
        DpSet(slots, 4, minute)
        DpSet(slots, 5, second)
        DpSet(slots, 19, yday)
        wbase = Add(edays, 4)
        wday = Modulo(wbase, 7)
        IfCondition LessThan(wday, 0) ThenBlock: {
            wday = Add(wday, 7)
        }
        DpSet(slots, 18, wday)
        ReturnValue(0)
    }
}

Function.DpToUtc {
    Input: slots: Address
    Output: Integer
    Body: {
        y = DpGet(slots, 0)
        m = DpGet(slots, 1)
        d = DpGet(slots, 2)
        h = DpGet(slots, 3)
        mi = DpGet(slots, 4)
        s = DpGet(slots, 5)
        days = 0
        one = 1
        IfCondition GreaterEqual(y, 1970) ThenBlock: {
            yy = 1970
            guard = 0
            WhileLoop And(LessThan(yy, y), LessThan(guard, 4000)) {
                diy = DpDiy(yy)
                days = Add(days, diy)
                yy = Add(yy, one)
                guard = Add(guard, one)
            }
        } ElseBlock: {
            yy = y
            guard = 0
            WhileLoop And(LessThan(yy, 1970), LessThan(guard, 4000)) {
                diy = DpDiy(yy)
                days = Subtract(days, diy)
                yy = Add(yy, one)
                guard = Add(guard, one)
            }
        }
        mm = 1
        WhileLoop LessThan(mm, m) {
            dim = DpDim(y, mm)
            days = Add(days, dim)
            mm = Add(mm, one)
        }
        d0 = Subtract(d, 1)
        days = Add(days, d0)
        sec = Multiply(days, 86400)
        sec = Add(sec, Multiply(h, 3600))
        sec = Add(sec, Multiply(mi, 60))
        sec = Add(sec, s)
        ReturnValue(sec)
    }
}

Function.DpNorm {
    Input: slots: Address
    Body: {
        one = 1
        guard = 0
        WhileLoop LessThan(guard, 400) {
            y = DpGet(slots, 0)
            m = DpGet(slots, 1)
            moved = 0
            IfCondition GreaterThan(m, 12) ThenBlock: {
                m = Subtract(m, 12)
                y = Add(y, one)
                moved = 1
            }
            IfCondition LessThan(m, 1) ThenBlock: {
                twelve = 12
                m = Add(m, twelve)
                y = Subtract(y, one)
                moved = 1
            }
            DpSet(slots, 0, y)
            DpSet(slots, 1, m)
            IfCondition EqualTo(moved, 0) ThenBlock: {
                BreakLoop
            }
            guard = Add(guard, one)
        }
        guard = 0
        WhileLoop LessThan(guard, 4000) {
            y = DpGet(slots, 0)
            m = DpGet(slots, 1)
            d = DpGet(slots, 2)
            dim = DpDim(y, m)
            IfCondition GreaterThan(d, dim) ThenBlock: {
                d = Subtract(d, dim)
                m = Add(m, one)
                IfCondition GreaterThan(m, 12) ThenBlock: {
                    m = 1
                    y = Add(y, one)
                }
                DpSet(slots, 0, y)
                DpSet(slots, 1, m)
                DpSet(slots, 2, d)
            } ElseBlock: {
                IfCondition LessThan(d, 1) ThenBlock: {
                    m = Subtract(m, one)
                    IfCondition LessThan(m, 1) ThenBlock: {
                        m = 12
                        y = Subtract(y, one)
                    }
                    pdim = DpDim(y, m)
                    d = Add(d, pdim)
                    DpSet(slots, 0, y)
                    DpSet(slots, 1, m)
                    DpSet(slots, 2, d)
                } ElseBlock: {
                    ReturnValue(0)
                }
            }
            guard = Add(guard, one)
        }
        ReturnValue(0)
    }
}

Function.DpAddDays {
    Input: slots: Address
    Input: delta: Integer
    Body: {
        d = DpGet(slots, 2)
        d = Add(d, delta)
        DpSet(slots, 2, d)
        DpNorm(slots)
        DpSet(slots, 11, 0)
        ReturnValue(0)
    }
}

Function.DpAddMonths {
    Input: slots: Address
    Input: delta: Integer
    Body: {
        m = DpGet(slots, 1)
        m = Add(m, delta)
        DpSet(slots, 1, m)
        DpNorm(slots)
        DpSet(slots, 11, 0)
        ReturnValue(0)
    }
}

Function.DpAddSeconds {
    Input: slots: Address
    Input: sec: Integer
    Input: extra: Integer
    Body: {
        hu = DpGet(slots, 11)
        IfCondition EqualTo(hu, 0) ThenBlock: {
            civil = DpToUtc(slots)
            off = DpGet(slots, 7)
            utc0 = Add(civil, off)
            DpSet(slots, 12, utc0)
        }
        utc = DpGet(slots, 12)
        nsec = DpGet(slots, 6)
        nsec = Add(nsec, extra)
        one = 1
        guard = 0
        bill = 1000000000
        WhileLoop And(GreaterEqual(nsec, bill), LessThan(guard, 8)) {
            nsec = Subtract(nsec, bill)
            sec = Add(sec, one)
            guard = Add(guard, one)
        }
        guard = 0
        bill = 1000000000
        WhileLoop And(LessThan(nsec, 0), LessThan(guard, 8)) {
            nsec = Add(nsec, bill)
            sec = Subtract(sec, one)
            guard = Add(guard, one)
        }
        utc = Add(utc, sec)
        DpSet(slots, 12, utc)
        DpSet(slots, 6, nsec)
        DpSet(slots, 11, 1)
        off = DpGet(slots, 7)
        local = Subtract(utc, off)
        DpWriteCivil(slots, local)
        ReturnValue(0)
    }
}

Function.DpApplyRel {
    Input: slots: Address
    Input: unit: Integer
    Input: count: Integer
    Input: frac: Integer
    Body: {
        IfCondition EqualTo(unit, 30) ThenBlock: {
            m = Multiply(count, 12)
            DpAddMonths(slots, m)
            ReturnValue(0)
        }
        IfCondition EqualTo(unit, 31) ThenBlock: {
            DpAddMonths(slots, count)
            ReturnValue(0)
        }
        IfCondition EqualTo(unit, 32) ThenBlock: {
            d = Multiply(count, 7)
            DpAddDays(slots, d)
            ReturnValue(0)
        }
        IfCondition EqualTo(unit, 33) ThenBlock: {
            DpAddDays(slots, count)
            ReturnValue(0)
        }
        IfCondition EqualTo(unit, 34) ThenBlock: {
            s = Multiply(count, 3600)
            DpAddSeconds(slots, s, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(unit, 35) ThenBlock: {
            s = Multiply(count, 60)
            DpAddSeconds(slots, s, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(unit, 36) ThenBlock: {
            DpAddSeconds(slots, count, frac)
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.DpSetDate {
    Input: slots: Address
    Input: y: Integer
    Input: m: Integer
    Input: d: Integer
    Body: {
        DpSet(slots, 0, y)
        DpSet(slots, 1, m)
        DpSet(slots, 2, d)
        ht = DpGet(slots, 10)
        IfCondition EqualTo(ht, 0) ThenBlock: {
            DpSet(slots, 3, 0)
            DpSet(slots, 4, 0)
            DpSet(slots, 5, 0)
            DpSet(slots, 6, 0)
        }
        DpSet(slots, 9, 1)
        DpSet(slots, 11, 0)
        ReturnValue(0)
    }
}

Function.DpSetTime {
    Input: slots: Address
    Input: h: Integer
    Input: mi: Integer
    Input: s: Integer
    Input: nsec: Integer
    Input: has_sec: Integer
    Body: {
        hd = DpGet(slots, 9)
        IfCondition EqualTo(hd, 0) ThenBlock: {
            ty = DpGet(slots, 13)
            tm = DpGet(slots, 14)
            td = DpGet(slots, 15)
            DpSet(slots, 0, ty)
            DpSet(slots, 1, tm)
            DpSet(slots, 2, td)
            DpSet(slots, 9, 1)
        }
        DpSet(slots, 3, h)
        DpSet(slots, 4, mi)
        DpSet(slots, 5, s)
        DpSet(slots, 6, nsec)
        DpSet(slots, 10, 1)
        DpSet(slots, 17, has_sec)
        DpSet(slots, 11, 0)
        ReturnValue(0)
    }
}

Function.DpDoWday {
    Input: slots: Address
    Input: kind: Integer
    Input: mod: Integer
    Body: {
        target = Subtract(kind, 20)
        cur = DpGet(slots, 16)
        delta = Subtract(target, cur)
        IfCondition LessThan(delta, 0) ThenBlock: {
            delta = Add(delta, 7)
        }
        IfCondition And(EqualTo(mod, 1), EqualTo(delta, 0)) ThenBlock: {
            delta = 7
        }
        IfCondition EqualTo(mod, 2) ThenBlock: {
            IfCondition EqualTo(delta, 0) ThenBlock: {
                delta = -7
            } ElseBlock: {
                delta = Subtract(delta, 7)
            }
        }
        y = DpGet(slots, 13)
        m = DpGet(slots, 14)
        d = DpGet(slots, 15)
        DpSetDate(slots, y, m, d)
        DpAddDays(slots, delta)
        ReturnValue(0)
    }
}

Function.DpMil {
    Input: ch: Integer
    Output: Integer
    Body: {
        c = ch
        IfCondition And(GreaterEqual(c, 97), LessEqual(c, 122)) ThenBlock: {
            c = Subtract(c, 32)
        }
        IfCondition Or(LessThan(c, 65), GreaterThan(c, 90)) ThenBlock: {
            ReturnValue(-100)
        }
        IfCondition EqualTo(c, 74) ThenBlock: {
            ReturnValue(-100)
        }
        IfCondition EqualTo(c, 90) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(c, 74) ThenBlock: {
            v = Subtract(c, 64)
            ReturnValue(v)
        }
        IfCondition LessEqual(c, 77) ThenBlock: {
            v = Subtract(c, 65)
            ReturnValue(v)
        }
        IfCondition And(GreaterEqual(c, 78), LessEqual(c, 89)) ThenBlock: {
            v = Subtract(77, c)
            ReturnValue(v)
        }
        ReturnValue(-100)
    }
}

Function.DpApplyMil {
    Input: slots: Address
    Input: ch: Integer
    Output: Integer
    Body: {
        mil = DpMil(ch)
        IfCondition EqualTo(mil, -100) ThenBlock: {
            ReturnValue(0)
        }
        posix = Multiply(mil, 3600)
        posix = Subtract(0, posix)
        DpSet(slots, 7, posix)
        DpSet(slots, 8, 1)
        ReturnValue(1)
    }
}

Function.DpPosix {
    Input: text: Address
    Input: i: Integer
    Input: n: Integer
    Input: slots: Address
    Input: name: Address
    Input: cap: Integer
    Output: Integer
    Body: {
        k = 0
        one = 1
        WhileLoop LessThan(i, n) {
            c = RDMEM_8(text, i)
            letter = DpLetter(c)
            IfCondition EqualTo(letter, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition NotEqual(name, 0) ThenBlock: {
                lim = Subtract(cap, 1)
                IfCondition LessThan(k, lim) ThenBlock: {
                    WRMEM_8(name, k, c)
                    k = Add(k, one)
                }
            }
            i = Add(i, one)
        }
        IfCondition NotEqual(name, 0) ThenBlock: {
            WRMEM_8(name, k, 0)
        }
        sign = 1
        IfCondition LessThan(i, n) ThenBlock: {
            c = RDMEM_8(text, i)
            IfCondition EqualTo(c, 43) ThenBlock: {
                i = Add(i, one)
            }
            IfCondition EqualTo(c, 45) ThenBlock: {
                sign = -1
                i = Add(i, one)
            }
        }
        digit = 0
        IfCondition LessThan(i, n) ThenBlock: {
            c = RDMEM_8(text, i)
            IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                digit = 1
            }
        }
        IfCondition EqualTo(digit, 0) ThenBlock: {
            DpSet(slots, 7, 0)
            ReturnValue(0)
        }
        i = DpDigits(text, i, n, slots)
        hour = DpGet(slots, 30)
        min = 0
        sec = 0
        c = DpAt(text, i, n)
        IfCondition EqualTo(c, 58) ThenBlock: {
            i = Add(i, one)
            i = DpDigits(text, i, n, slots)
            min = DpGet(slots, 30)
            c = DpAt(text, i, n)
            IfCondition EqualTo(c, 58) ThenBlock: {
                i = Add(i, one)
                i = DpDigits(text, i, n, slots)
                sec = DpGet(slots, 30)
            }
        }
        off = Multiply(hour, 3600)
        off = Add(off, Multiply(min, 60))
        off = Add(off, sec)
        IfCondition LessThan(sign, 0) ThenBlock: {
            off = Subtract(0, off)
        }
        DpSet(slots, 7, off)
        ReturnValue(0)
    }
}

Function.DpNameUTC {
    Input: name: Address
    Body: {
        WRMEM_8(name, 0, 85)
        WRMEM_8(name, 1, 84)
        WRMEM_8(name, 2, 67)
        WRMEM_8(name, 3, 0)
        ReturnValue(0)
    }
}

Function.DpLoadTZ {
    Input: name: Address
    Input: cap: Integer
    Input: slots: Address
    Output: Integer
    Body: {
        DpNameUTC(name)
        path = "/proc/self/environ"
        fd = SystemCall(257, -100, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf = Allocate(65536)
        nr = SystemCall(0, fd, buf, 65535)
        SystemCall(3, fd)
        IfCondition LessEqual(nr, 0) ThenBlock: {
            Deallocate(buf, 65536)
            ReturnValue(0)
        }
        i = 0
        one = 1
        found = 0
        vs = 0
        WhileLoop LessThan(i, nr) {
            b0 = RDMEM_8(buf, i)
            b1 = 0
            b2 = 0
            i1 = Add(i, one)
            i2 = Add(i1, one)
            IfCondition LessThan(i1, nr) ThenBlock: {
                b1 = RDMEM_8(buf, i1)
            }
            IfCondition LessThan(i2, nr) ThenBlock: {
                b2 = RDMEM_8(buf, i2)
            }
            m1 = EqualTo(b0, 84)
            m2 = EqualTo(b1, 90)
            m3 = EqualTo(b2, 61)
            m = And(m1, m2)
            m = And(m, m3)
            IfCondition EqualTo(m, 1) ThenBlock: {
                found = 1
                vs = Add(i2, one)
                BreakLoop
            }
            WhileLoop LessThan(i, nr) {
                c = RDMEM_8(buf, i)
                IfCondition EqualTo(c, 0) ThenBlock: {
                    BreakLoop
                }
                i = Add(i, one)
            }
            IfCondition LessThan(i, nr) ThenBlock: {
                i = Add(i, one)
            }
        }
        off = 0
        IfCondition EqualTo(found, 1) ThenBlock: {
            ve = vs
            WhileLoop LessThan(ve, nr) {
                c = RDMEM_8(buf, ve)
                IfCondition EqualTo(c, 0) ThenBlock: {
                    BreakLoop
                }
                ve = Add(ve, one)
            }
            DpPosix(buf, vs, ve, slots, name, cap)
            off = DpGet(slots, 7)
            nb = RDMEM_8(name, 0)
            IfCondition EqualTo(nb, 0) ThenBlock: {
                DpNameUTC(name)
            }
        }
        Deallocate(buf, 65536)
        ReturnValue(off)
    }
}

Function.DpTryTZ {
    Input: text: Address
    Input: i: Integer
    Input: n: Integer
    Input: slots: Address
    Output: Integer
    Body: {
        one = 1
        i1 = Add(i, one)
        i2 = Add(i1, one)
        i3 = Add(i2, one)
        need = Add(i3, one)
        IfCondition GreaterThan(need, n) ThenBlock: {
            ReturnValue(-2)
        }
        c0 = RDMEM_8(text, i)
        c1 = RDMEM_8(text, i1)
        c2 = RDMEM_8(text, i2)
        c3 = RDMEM_8(text, i3)
        IfCondition NotEqual(c0, 84) ThenBlock: { ReturnValue(-2) }
        IfCondition NotEqual(c1, 90) ThenBlock: { ReturnValue(-2) }
        IfCondition NotEqual(c2, 61) ThenBlock: { ReturnValue(-2) }
        IfCondition NotEqual(c3, 34) ThenBlock: { ReturnValue(-2) }
        p = need
        end = p
        WhileLoop LessThan(end, n) {
            c = RDMEM_8(text, end)
            IfCondition EqualTo(c, 34) ThenBlock: {
                BreakLoop
            }
            end = Add(end, one)
        }
        IfCondition GreaterEqual(end, n) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition EqualTo(end, p) ThenBlock: {
            ReturnValue(-1)
        }
        DpPosix(text, p, end, slots, 0, 0)
        out = Add(end, one)
        ReturnValue(out)
    }
}

Function.DpTakeRel {
    Input: text: Address
    Input: k: Integer
    Input: n: Integer
    Input: slots: Address
    Input: mag: Integer
    Input: fr: Integer
    Output: Integer
    Body: {
        kind = DpPeek(text, k, n, slots)
        unit = 0
        IfCondition And(GreaterEqual(kind, 30), LessEqual(kind, 36)) ThenBlock: {
            unit = 1
        }
        IfCondition EqualTo(unit, 0) ThenBlock: {
            ReturnValue(-1)
        }
        use = 0
        IfCondition EqualTo(kind, 36) ThenBlock: {
            use = fr
        }
        ws = DpGet(slots, 35)
        wl = DpGet(slots, 36)
        nxt = Add(ws, wl)
        kind2 = DpPeek(text, nxt, n, slots)
        IfCondition EqualTo(kind2, 40) ThenBlock: {
            mag = Subtract(0, mag)
            use = Subtract(0, use)
            ws2 = DpGet(slots, 35)
            wl2 = DpGet(slots, 36)
            nxt = Add(ws2, wl2)
        }
        DpApplyRel(slots, kind, mag, use)
        ReturnValue(nxt)
    }
}

Function.DpZoneHere {
    Input: text: Address
    Input: k: Integer
    Input: n: Integer
    Input: slots: Address
    Input: sign: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        nd = DpGet(slots, 33)
        hour = val
        min = 0
        sec = 0
        c = DpAt(text, k, n)
        one = 1
        IfCondition EqualTo(c, 58) ThenBlock: {
            k = Add(k, one)
            k = DpDigits(text, k, n, slots)
            min = DpGet(slots, 30)
            c = DpAt(text, k, n)
            IfCondition EqualTo(c, 58) ThenBlock: {
                k = Add(k, one)
                k = DpDigits(text, k, n, slots)
                sec = DpGet(slots, 30)
            }
        } ElseBlock: {
            IfCondition EqualTo(nd, 4) ThenBlock: {
                hour = Divide(val, 100)
                min = Modulo(val, 100)
            }
            IfCondition EqualTo(nd, 6) ThenBlock: {
                hour = Divide(val, 10000)
                t = Modulo(val, 10000)
                min = Divide(t, 100)
                sec = Modulo(t, 100)
            }
            bad = 0
            IfCondition EqualTo(nd, 3) ThenBlock: { bad = 1 }
            IfCondition EqualTo(nd, 5) ThenBlock: { bad = 1 }
            IfCondition GreaterThan(nd, 6) ThenBlock: { bad = 1 }
            IfCondition EqualTo(bad, 1) ThenBlock: {
                ReturnValue(-1)
            }
        }
        iso = Multiply(hour, 3600)
        iso = Add(iso, Multiply(min, 60))
        iso = Add(iso, sec)
        IfCondition LessThan(sign, 0) ThenBlock: {
            iso = Subtract(0, iso)
        }
        posix = Subtract(0, iso)
        DpSet(slots, 7, posix)
        DpSet(slots, 8, 1)
        ReturnValue(k)
    }
}

Function.DpNumTok {
    Input: text: Address
    Input: i: Integer
    Input: n: Integer
    Input: slots: Address
    Input: sign: Integer
    Input: dated: Integer
    Output: Integer
    Body: {
        relsign = 1
        spaced = 0
        IfCondition LessThan(sign, 0) ThenBlock: {
            relsign = -1
        }
        IfCondition EqualTo(sign, 2) ThenBlock: {
            spaced = 1
            relsign = 1
        }
        IfCondition EqualTo(sign, -2) ThenBlock: {
            spaced = 1
            relsign = -1
        }
        k = DpDigits(text, i, n, slots)
        nd = DpGet(slots, 33)
        val = DpGet(slots, 30)
        IfCondition EqualTo(nd, 0) ThenBlock: {
            ReturnValue(-1)
        }
        frac = 0
        c = DpAt(text, k, n)
        IfCondition EqualTo(c, 46) ThenBlock: {
            k = DpFrac(text, k, n, slots)
            frac = DpGet(slots, 32)
            c = DpAt(text, k, n)
        } ElseBlock: {
            DpSet(slots, 32, 0)
        }
        one = 1
        IfCondition EqualTo(c, 45) ThenBlock: {
            IfCondition EqualTo(dated, 0) ThenBlock: {
                ReturnValue(-1)
            }
            year = val
            k = Add(k, one)
            k = DpDigits(text, k, n, slots)
            month = DpGet(slots, 30)
            mnd = DpGet(slots, 33)
            IfCondition EqualTo(mnd, 0) ThenBlock: {
                ReturnValue(-1)
            }
            c = DpAt(text, k, n)
            IfCondition NotEqual(c, 45) ThenBlock: {
                ReturnValue(-1)
            }
            k = Add(k, one)
            k = DpDigits(text, k, n, slots)
            day = DpGet(slots, 30)
            dnd = DpGet(slots, 33)
            IfCondition EqualTo(dnd, 0) ThenBlock: {
                ReturnValue(-1)
            }
            DpSetDate(slots, year, month, day)
            ReturnValue(k)
        }
        IfCondition EqualTo(c, 47) ThenBlock: {
            IfCondition EqualTo(dated, 0) ThenBlock: {
                ReturnValue(-1)
            }
            month = val
            k = Add(k, one)
            k = DpDigits(text, k, n, slots)
            day = DpGet(slots, 30)
            dnd = DpGet(slots, 33)
            IfCondition EqualTo(dnd, 0) ThenBlock: {
                ReturnValue(-1)
            }
            c = DpAt(text, k, n)
            IfCondition NotEqual(c, 47) ThenBlock: {
                ReturnValue(-1)
            }
            k = Add(k, one)
            k = DpDigits(text, k, n, slots)
            yy = DpGet(slots, 30)
            ynd = DpGet(slots, 33)
            year = DpYear(yy, ynd)
            DpSetDate(slots, year, month, day)
            ReturnValue(k)
        }
        timeok = And(EqualTo(c, 58), EqualTo(dated, 1))
        IfCondition EqualTo(timeok, 1) ThenBlock: {
            hour = val
            k = Add(k, one)
            k = DpDigits(text, k, n, slots)
            minute = DpGet(slots, 30)
            sec = 0
            has = 0
            nsec = 0
            c = DpAt(text, k, n)
            IfCondition EqualTo(c, 58) ThenBlock: {
                k = Add(k, one)
                k = DpDigits(text, k, n, slots)
                sec = DpGet(slots, 30)
                has = 1
                c = DpAt(text, k, n)
            }
            IfCondition EqualTo(c, 46) ThenBlock: {
                k = DpFrac(text, k, n, slots)
                nsec = DpGet(slots, 32)
                c = DpAt(text, k, n)
            }
            DpSetTime(slots, hour, minute, sec, nsec, has)
            letter = DpLetter(c)
            IfCondition EqualTo(letter, 1) ThenBlock: {
                took = DpApplyMil(slots, c)
                IfCondition EqualTo(took, 1) ThenBlock: {
                    k = Add(k, one)
                }
            }
            ReturnValue(k)
        }
        mag = val
        fr = frac
        IfCondition LessThan(relsign, 0) ThenBlock: {
            mag = Subtract(0, val)
            fr = Subtract(0, frac)
        }
        rel = DpTakeRel(text, k, n, slots, mag, fr)
        IfCondition GreaterEqual(rel, 0) ThenBlock: {
            ReturnValue(rel)
        }
        IfCondition EqualTo(dated, 1) ThenBlock: {
            IfCondition EqualTo(nd, 8) ThenBlock: {
                year = Divide(val, 10000)
                t = Modulo(val, 10000)
                month = Divide(t, 100)
                day = Modulo(t, 100)
                DpSetDate(slots, year, month, day)
                ReturnValue(k)
            }
            IfCondition EqualTo(nd, 6) ThenBlock: {
                yy = Divide(val, 10000)
                t = Modulo(val, 10000)
                month = Divide(t, 100)
                day = Modulo(t, 100)
                year = DpYear(yy, 2)
                DpSetDate(slots, year, month, day)
                ReturnValue(k)
            }
            IfCondition EqualTo(nd, 4) ThenBlock: {
                hour = Divide(val, 100)
                minute = Modulo(val, 100)
                IfCondition GreaterThan(hour, 23) ThenBlock: {
                    ReturnValue(-1)
                }
                IfCondition GreaterThan(minute, 59) ThenBlock: {
                    ReturnValue(-1)
                }
                DpSetTime(slots, hour, minute, 0, 0, 0)
                ReturnValue(k)
            }
            ReturnValue(-1)
        }
        IfCondition EqualTo(spaced, 1) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition NotEqual(frac, 0) ThenBlock: {
            ReturnValue(-1)
        }
        zk = DpZoneHere(text, k, n, slots, relsign, val)
        ReturnValue(zk)
    }
}

Function.DpSigned {
    Input: text: Address
    Input: i: Integer
    Input: n: Integer
    Input: slots: Address
    Output: Integer
    Body: {
        sch = RDMEM_8(text, i)
        sign = 1
        IfCondition EqualTo(sch, 45) ThenBlock: {
            sign = -1
        }
        one = 1
        i = Add(i, one)
        j = DpSkip(text, i, n)
        IfCondition GreaterEqual(j, n) ThenBlock: {
            ReturnValue(-1)
        }
        c = RDMEM_8(text, j)
        IfCondition Or(LessThan(c, 48), GreaterThan(c, 57)) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition NotEqual(j, i) ThenBlock: {
            IfCondition GreaterThan(sign, 0) ThenBlock: {
                sign = 2
            } ElseBlock: {
                sign = -2
            }
        }
        rc = DpNumTok(text, j, n, slots, sign, 0)
        ReturnValue(rc)
    }
}

Function.DpWordTok {
    Input: text: Address
    Input: i: Integer
    Input: n: Integer
    Input: slots: Address
    Output: Integer
    Body: {
        len = DpWordLen(text, i, n)
        IfCondition EqualTo(len, 0) ThenBlock: {
            ReturnValue(-1)
        }
        kind = DpKind(text, i, len)
        one = 1
        j = Add(i, len)
        IfCondition And(GreaterEqual(kind, 1), LessEqual(kind, 12)) ThenBlock: {
            j = DpSkipSep(text, j, n)
            j = DpDigits(text, j, n, slots)
            day = DpGet(slots, 30)
            dnd = DpGet(slots, 33)
            IfCondition EqualTo(dnd, 0) ThenBlock: {
                ReturnValue(-1)
            }
            j = DpSkipSep(text, j, n)
            j = DpDigits(text, j, n, slots)
            yy = DpGet(slots, 30)
            ynd = DpGet(slots, 33)
            IfCondition EqualTo(ynd, 0) ThenBlock: {
                ReturnValue(-1)
            }
            year = DpYear(yy, ynd)
            DpSetDate(slots, year, kind, day)
            ReturnValue(j)
        }
        IfCondition And(GreaterEqual(kind, 20), LessEqual(kind, 26)) ThenBlock: {
            DpDoWday(slots, kind, 0)
            ReturnValue(j)
        }
        IfCondition And(GreaterEqual(kind, 41), LessEqual(kind, 43)) ThenBlock: {
            j = DpSkip(text, j, n)
            len2 = DpWordLen(text, j, n)
            IfCondition EqualTo(len2, 0) ThenBlock: {
                ReturnValue(-1)
            }
            kind2 = DpKind(text, j, len2)
            j2 = Add(j, len2)
            IfCondition And(GreaterEqual(kind2, 20), LessEqual(kind2, 26)) ThenBlock: {
                mod = 1
                IfCondition EqualTo(kind, 42) ThenBlock: { mod = 2 }
                IfCondition EqualTo(kind, 43) ThenBlock: { mod = 3 }
                DpDoWday(slots, kind2, mod)
                ReturnValue(j2)
            }
            IfCondition And(GreaterEqual(kind2, 30), LessEqual(kind2, 36)) ThenBlock: {
                count = 1
                IfCondition EqualTo(kind, 42) ThenBlock: { count = -1 }
                IfCondition EqualTo(kind, 43) ThenBlock: { count = 0 }
                DpApplyRel(slots, kind2, count, 0)
                ReturnValue(j2)
            }
            ReturnValue(-1)
        }
        IfCondition EqualTo(kind, 44) ThenBlock: {
            DpAddDays(slots, -1)
            ReturnValue(j)
        }
        IfCondition EqualTo(kind, 45) ThenBlock: {
            DpAddDays(slots, 1)
            ReturnValue(j)
        }
        IfCondition EqualTo(kind, 46) ThenBlock: {
            y = DpGet(slots, 13)
            m = DpGet(slots, 14)
            d = DpGet(slots, 15)
            DpSetDate(slots, y, m, d)
            ReturnValue(j)
        }
        IfCondition EqualTo(kind, 47) ThenBlock: {
            ReturnValue(j)
        }
        IfCondition EqualTo(kind, 48) ThenBlock: {
            DpSet(slots, 7, 0)
            DpSet(slots, 8, 1)
            ReturnValue(j)
        }
        IfCondition EqualTo(len, 1) ThenBlock: {
            c = RDMEM_8(text, i)
            took = DpApplyMil(slots, c)
            IfCondition EqualTo(took, 1) ThenBlock: {
                ReturnValue(j)
            }
        }
        ReturnValue(-1)
    }
}

Function.DpShow {
    Input: slots: Address
    Input: disp: Integer
    Body: {
        utc = DpGet(slots, 12)
        local = Subtract(utc, disp)
        DpWriteCivil(slots, local)
        ReturnValue(0)
    }
}

Function.DpParse {
    Input: text: Address
    Input: len: Integer
    Input: slots: Address
    Input: now: Integer
    Input: init_posix: Integer
    Output: Integer
    Body: {
        DpSet(slots, 7, init_posix)
        DpSet(slots, 12, now)
        DpSet(slots, 11, 1)
        DpSet(slots, 6, 0)
        DpSet(slots, 8, 0)
        DpSet(slots, 9, 0)
        DpSet(slots, 10, 0)
        DpSet(slots, 17, 0)
        local = Subtract(now, init_posix)
        DpWriteCivil(slots, local)
        y = DpGet(slots, 0)
        m = DpGet(slots, 1)
        d = DpGet(slots, 2)
        w = DpGet(slots, 18)
        DpSet(slots, 13, y)
        DpSet(slots, 14, m)
        DpSet(slots, 15, d)
        DpSet(slots, 16, w)
        i = 0
        one = 1
        WhileLoop LessThan(i, len) {
            c = RDMEM_8(text, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                BreakLoop
            }
            acted = 0
            blank = 0
            IfCondition EqualTo(c, 32) ThenBlock: { blank = 1 }
            IfCondition EqualTo(c, 9) ThenBlock: { blank = 1 }
            IfCondition EqualTo(blank, 1) ThenBlock: {
                i = Add(i, one)
                acted = 1
            }
            IfCondition EqualTo(acted, 0) ThenBlock: {
                IfCondition EqualTo(c, 84) ThenBlock: {
                    rc = DpTryTZ(text, i, len, slots)
                    IfCondition EqualTo(rc, -1) ThenBlock: {
                        ReturnValue(-1)
                    }
                    IfCondition GreaterEqual(rc, 0) ThenBlock: {
                        i = rc
                        acted = 1
                    }
                }
            }
            IfCondition EqualTo(acted, 0) ThenBlock: {
                is_t = 0
                IfCondition EqualTo(c, 84) ThenBlock: { is_t = 1 }
                IfCondition EqualTo(c, 116) ThenBlock: { is_t = 1 }
                IfCondition EqualTo(is_t, 1) ThenBlock: {
                    ni = Add(i, one)
                    nxt = DpAt(text, ni, len)
                    IfCondition And(GreaterEqual(nxt, 48), LessEqual(nxt, 57)) ThenBlock: {
                        i = ni
                        acted = 1
                    }
                }
            }
            IfCondition EqualTo(acted, 0) ThenBlock: {
                signch = 0
                IfCondition EqualTo(c, 43) ThenBlock: { signch = 1 }
                IfCondition EqualTo(c, 45) ThenBlock: { signch = 1 }
                IfCondition EqualTo(signch, 1) ThenBlock: {
                    rc = DpSigned(text, i, len, slots)
                    IfCondition LessThan(rc, 0) ThenBlock: {
                        ReturnValue(-1)
                    }
                    i = rc
                    acted = 1
                }
            }
            IfCondition EqualTo(acted, 0) ThenBlock: {
                IfCondition EqualTo(c, 64) ThenBlock: {
                    ni = Add(i, one)
                    esign = 1
                    ec = DpAt(text, ni, len)
                    IfCondition EqualTo(ec, 45) ThenBlock: {
                        esign = -1
                        ni = Add(ni, one)
                    }
                    IfCondition EqualTo(ec, 43) ThenBlock: {
                        ni = Add(ni, one)
                    }
                    ni = DpDigits(text, ni, len, slots)
                    eval = DpGet(slots, 30)
                    end_ = DpGet(slots, 33)
                    IfCondition EqualTo(end_, 0) ThenBlock: {
                        ReturnValue(-1)
                    }
                    ensec = 0
                    ec = DpAt(text, ni, len)
                    IfCondition EqualTo(ec, 46) ThenBlock: {
                        ni = DpFrac(text, ni, len, slots)
                        ensec = DpGet(slots, 32)
                    }
                    IfCondition LessThan(esign, 0) ThenBlock: {
                        eval = Subtract(0, eval)
                        ensec = Subtract(0, ensec)
                    }
                    DpSet(slots, 12, 0)
                    DpSet(slots, 6, 0)
                    DpSet(slots, 11, 1)
                    DpAddSeconds(slots, eval, ensec)
                    DpSet(slots, 9, 1)
                    DpSet(slots, 10, 1)
                    i = ni
                    acted = 1
                }
            }
            IfCondition EqualTo(acted, 0) ThenBlock: {
                IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                    rc = DpNumTok(text, i, len, slots, 1, 1)
                    IfCondition LessThan(rc, 0) ThenBlock: {
                        ReturnValue(-1)
                    }
                    i = rc
                    acted = 1
                }
            }
            IfCondition EqualTo(acted, 0) ThenBlock: {
                letter = DpLetter(c)
                IfCondition EqualTo(letter, 1) ThenBlock: {
                    rc = DpWordTok(text, i, len, slots)
                    IfCondition LessThan(rc, 0) ThenBlock: {
                        ReturnValue(-1)
                    }
                    i = rc
                    acted = 1
                }
            }
            IfCondition EqualTo(acted, 0) ThenBlock: {
                ReturnValue(-1)
            }
        }
        hu = DpGet(slots, 11)
        IfCondition EqualTo(hu, 0) ThenBlock: {
            civil = DpToUtc(slots)
            off = DpGet(slots, 7)
            utc = Add(civil, off)
            DpSet(slots, 12, utc)
            DpSet(slots, 11, 1)
        }
        ReturnValue(0)
    }
}
