        hit = DpEq(text, i, len, "yesterday")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(44) }
        hit = DpEq(text, i, len, "tomorrow")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(45) }
        hit = DpEq(text, i, len, "today")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(46) }
        hit = DpEq(text, i, len, "now")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(47) }
        hit = DpEq(text, i, len, "utc")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(48) }
        ReturnValue(0)
    }
}
