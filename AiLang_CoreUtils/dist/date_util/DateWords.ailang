        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(10) }
        hit = DpEq(text, i, len, "november")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(11) }
        hit = DpEq(text, i, len, "nov")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(11) }
        hit = DpEq(text, i, len, "december")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(12) }
        hit = DpEq(text, i, len, "dec")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(12) }
        hit = DpEq(text, i, len, "sunday")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(20) }
        hit = DpEq(text, i, len, "sun")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(20) }
        hit = DpEq(text, i, len, "monday")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(21) }
        hit = DpEq(text, i, len, "mon")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(21) }
        hit = DpEq(text, i, len, "tuesday")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(22) }
        hit = DpEq(text, i, len, "tue")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(22) }
        hit = DpEq(text, i, len, "wednesday")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(23) }
        hit = DpEq(text, i, len, "wed")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(23) }
        hit = DpEq(text, i, len, "thursday")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(24) }
        hit = DpEq(text, i, len, "thu")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(24) }
        hit = DpEq(text, i, len, "friday")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(25) }
        hit = DpEq(text, i, len, "fri")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(25) }
        hit = DpEq(text, i, len, "saturday")
