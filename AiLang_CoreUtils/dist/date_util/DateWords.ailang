        hit = DpEq(text, i, len, "weeks")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(32) }
        hit = DpEq(text, i, len, "week")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(32) }
        hit = DpEq(text, i, len, "days")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(33) }
        hit = DpEq(text, i, len, "day")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(33) }
        hit = DpEq(text, i, len, "hours")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(34) }
        hit = DpEq(text, i, len, "hour")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(34) }
        hit = DpEq(text, i, len, "minutes")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(35) }
        hit = DpEq(text, i, len, "minute")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(35) }
        hit = DpEq(text, i, len, "min")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(35) }
        hit = DpEq(text, i, len, "seconds")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(36) }
        hit = DpEq(text, i, len, "second")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(36) }
        hit = DpEq(text, i, len, "sec")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(36) }
        hit = DpEq(text, i, len, "ago")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(40) }
        hit = DpEq(text, i, len, "next")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(41) }
        hit = DpEq(text, i, len, "last")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(42) }
