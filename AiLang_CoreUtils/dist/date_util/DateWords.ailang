// DateWords.ailang - month, weekday, and unit words for the date parser.
// No pool and no RunTask. The parent pastes this beside DateParse.
LibraryImport.Arena

Function.DpWordLen {
    Input: text: Address
    Input: i: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        k = 0
        one = 1
        WhileLoop LessThan(k, 64) {
            j = Add(i, k)
            IfCondition GreaterEqual(j, n) ThenBlock: {
                ReturnValue(k)
            }
            c = GetByte(text, j)
            letter = DpLetter(c)
            IfCondition EqualTo(letter, 0) ThenBlock: {
                ReturnValue(k)
            }
            k = Add(k, one)
        }
        ReturnValue(k)
    }
}

Function.DpEq {
    Input: text: Address
    Input: i: Integer
    Input: len: Integer
    Input: lit: Address
    Output: Integer
    Body: {
        nlit = StringLength(lit)
        IfCondition NotEqual(nlit, len) ThenBlock: {
            ReturnValue(0)
        }
        k = 0
        one = 1
        WhileLoop LessThan(k, len) {
            at = Add(i, k)
            a = GetByte(text, at)
            b = GetByte(lit, k)
            IfCondition And(GreaterEqual(a, 65), LessEqual(a, 90)) ThenBlock: {
                lower = 32
                a = Add(a, lower)
            }
            IfCondition NotEqual(a, b) ThenBlock: {
                ReturnValue(0)
            }
            k = Add(k, one)
        }
        ReturnValue(1)
    }
}

Function.DpKind {
    Input: text: Address
    Input: i: Integer
    Input: len: Integer
    Output: Integer
    Body: {
        hit = DpEq(text, i, len, "january")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = DpEq(text, i, len, "jan")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = DpEq(text, i, len, "february")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(2) }
        hit = DpEq(text, i, len, "feb")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(2) }
        hit = DpEq(text, i, len, "march")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(3) }
        hit = DpEq(text, i, len, "mar")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(3) }
        hit = DpEq(text, i, len, "april")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(4) }
        hit = DpEq(text, i, len, "apr")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(4) }
        hit = DpEq(text, i, len, "may")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(5) }
        hit = DpEq(text, i, len, "june")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(6) }
