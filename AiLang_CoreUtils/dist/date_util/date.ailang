// date.ailang - GNU date. Parser lives in DateParse / DateWords.
LibraryImport.Arena
LibraryImport.AiLang_CoreUtils.dist.date_util.DateWords
LibraryImport.AiLang_CoreUtils.dist.date_util.DateParse

FixedPool.DtOpt {
    "mode": Initialize=0
    "utc": Initialize=0
    "disp": Initialize=0
    "parseoff": Initialize=0
    "fmt": Initialize=0
    "fmtlen": Initialize=0
    "name": Initialize=0
    "now": Initialize=0
    "bout": Initialize=0
    "have_fmt": Initialize=0
    "have_d": Initialize=0
    "have_file": Initialize=0
    "datelen": Initialize=0
}

Function.DtChar {
    Input: ch: Integer
    Body: {
        p = DtOpt.bout
        SetByte(p, 0, ch)
        SystemCall(1, 1, p, 1)
        ReturnValue(0)
    }
}

Function.DtLit {
    Input: s: Address
    Body: {
        n = StringLength(s)
        SystemCall(1, 1, s, n)
        ReturnValue(0)
    }
}

Function.DtRepeat {
    Input: ch: Integer
    Input: count: Integer
    Body: {
        IfCondition LessEqual(count, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf = Allocate(64)
        i = 0
        one = 1
        WhileLoop LessThan(i, 64) {
            SetByte(buf, i, ch)
            i = Add(i, one)
        }
        left = count
        chunk = 64
        WhileLoop GreaterEqual(left, chunk) {
            SystemCall(1, 1, buf, chunk)
            left = Subtract(left, chunk)
        }
        IfCondition GreaterThan(left, 0) ThenBlock: {
            SystemCall(1, 1, buf, left)
        }
        Deallocate(buf, 64)
        ReturnValue(0)
    }
}

Function.DtStr {
    Input: s: Address
    Input: up: Integer
    Body: {
        i = 0
        one = 1
        lower = 32
        WhileLoop 1 {
            c = GetByte(s, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(up, 1) ThenBlock: {
                IfCondition And(GreaterEqual(c, 97), LessEqual(c, 122)) ThenBlock: {
                    c = Subtract(c, lower)
                }
            }
            DtChar(c)
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.DtNum {
    Input: n: Integer
    Input: width: Integer
    Input: pad: Integer
    Input: plus: Integer
    Body: {
        sign = 0
        v = n
        IfCondition LessThan(v, 0) ThenBlock: {
            sign = 45
            v = Subtract(0, v)
        } ElseBlock: {
            IfCondition EqualTo(plus, 1) ThenBlock: {
                sign = 43
            }
        }
        buf = Allocate(24)
        cnt = 0
        one = 1
        IfCondition EqualTo(v, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            cnt = 1
        } ElseBlock: {
            WhileLoop GreaterThan(v, 0) {
                dig = Modulo(v, 10)
                ch = Add(48, dig)
                SetByte(buf, cnt, ch)
                cnt = Add(cnt, one)
                v = Divide(v, 10)
            }
        }
        body = cnt
        IfCondition NotEqual(sign, 0) ThenBlock: {
            body = Add(body, one)
        }
        padn = Subtract(width, body)
        IfCondition LessThan(padn, 0) ThenBlock: {
            padn = 0
        }
        IfCondition EqualTo(pad, 0) ThenBlock: {
            padn = 0
        }
        zero_sign = 0
        IfCondition EqualTo(pad, 48) ThenBlock: {
            IfCondition NotEqual(sign, 0) ThenBlock: {
                zero_sign = 1
            }
        }
        IfCondition EqualTo(zero_sign, 1) ThenBlock: {
            DtChar(sign)
            DtRepeat(48, padn)
        } ElseBlock: {
            IfCondition GreaterThan(padn, 0) ThenBlock: {
                IfCondition NotEqual(pad, 0) ThenBlock: {
                    DtRepeat(pad, padn)
                }
            }
            IfCondition NotEqual(sign, 0) ThenBlock: {
                DtChar(sign)
            }
        }
        idx = Subtract(cnt, 1)
        WhileLoop GreaterEqual(idx, 0) {
            ch = GetByte(buf, idx)
            DtChar(ch)
            idx = Subtract(idx, one)
        }
        Deallocate(buf, 24)
        ReturnValue(0)
    }
}

Function.DtEmit {
    Input: n: Integer
    Input: width: Integer
    Input: pad: Integer
    Input: plus: Integer
    Input: defw: Integer
    Input: defpad: Integer
    Body: {
        w = width
        p = pad
        IfCondition LessThan(w, 0) ThenBlock: {
            w = defw
        }
        IfCondition LessThan(p, 0) ThenBlock: {
            p = defpad
        }
        DtNum(n, w, p, plus)
        ReturnValue(0)
    }
}

Function.Dt2 {
    Input: n: Integer
    Body: {
        IfCondition GreaterEqual(n, 100) ThenBlock: {
            DtEmit(n, -1, -1, 0, 1, 48)
            ReturnValue(0)
        }
        v = n
        IfCondition LessThan(v, 0) ThenBlock: {
            v = 0
        }
        d1 = Divide(v, 10)
        d0 = Modulo(v, 10)
        c1 = Add(48, d1)
        c0 = Add(48, d0)
        DtChar(c1)
        DtChar(c0)
        ReturnValue(0)
    }
}

Function.DtWday {
    Input: w: Integer
    Input: full: Integer
    Input: up: Integer
    Body: {
        s = "Sat"
        IfCondition EqualTo(full, 1) ThenBlock: {
            s = "Saturday"
        }
        IfCondition EqualTo(w, 0) ThenBlock: {
            s = "Sun"
            IfCondition EqualTo(full, 1) ThenBlock: { s = "Sunday" }
        }
        IfCondition EqualTo(w, 1) ThenBlock: {
            s = "Mon"
            IfCondition EqualTo(full, 1) ThenBlock: { s = "Monday" }
        }
        IfCondition EqualTo(w, 2) ThenBlock: {
            s = "Tue"
            IfCondition EqualTo(full, 1) ThenBlock: { s = "Tuesday" }
        }
        IfCondition EqualTo(w, 3) ThenBlock: {
            s = "Wed"
            IfCondition EqualTo(full, 1) ThenBlock: { s = "Wednesday" }
        }
        IfCondition EqualTo(w, 4) ThenBlock: {
            s = "Thu"
            IfCondition EqualTo(full, 1) ThenBlock: { s = "Thursday" }
        }
        IfCondition EqualTo(w, 5) ThenBlock: {
            s = "Fri"
            IfCondition EqualTo(full, 1) ThenBlock: { s = "Friday" }
        }
        DtStr(s, up)
        ReturnValue(0)
    }
}

Function.DtMon {
    Input: m: Integer
    Input: full: Integer
    Input: up: Integer
    Body: {
        s = "Dec"
        IfCondition EqualTo(full, 1) ThenBlock: { s = "December" }
        IfCondition EqualTo(m, 1) ThenBlock: {
            s = "Jan"
            IfCondition EqualTo(full, 1) ThenBlock: { s = "January" }
        }
        IfCondition EqualTo(m, 2) ThenBlock: {
            s = "Feb"
            IfCondition EqualTo(full, 1) ThenBlock: { s = "February" }
        }
        IfCondition EqualTo(m, 3) ThenBlock: {
            s = "Mar"
            IfCondition EqualTo(full, 1) ThenBlock: { s = "March" }
        }
        IfCondition EqualTo(m, 4) ThenBlock: {
            s = "Apr"
            IfCondition EqualTo(full, 1) ThenBlock: { s = "April" }
        }
        IfCondition EqualTo(m, 5) ThenBlock: {
            s = "May"
            IfCondition EqualTo(full, 1) ThenBlock: { s = "May" }
        }
        IfCondition EqualTo(m, 6) ThenBlock: {
            s = "Jun"
            IfCondition EqualTo(full, 1) ThenBlock: { s = "June" }
        }
        IfCondition EqualTo(m, 7) ThenBlock: {
            s = "Jul"
            IfCondition EqualTo(full, 1) ThenBlock: { s = "July" }
        }
        IfCondition EqualTo(m, 8) ThenBlock: {
            s = "Aug"
            IfCondition EqualTo(full, 1) ThenBlock: { s = "August" }
        }
        IfCondition EqualTo(m, 9) ThenBlock: {
            s = "Sep"
            IfCondition EqualTo(full, 1) ThenBlock: { s = "September" }
        }
        IfCondition EqualTo(m, 10) ThenBlock: {
            s = "Oct"
            IfCondition EqualTo(full, 1) ThenBlock: { s = "October" }
        }
        IfCondition EqualTo(m, 11) ThenBlock: {
            s = "Nov"
            IfCondition EqualTo(full, 1) ThenBlock: { s = "November" }
        }
        DtStr(s, up)
        ReturnValue(0)
    }
}

Function.DtNsec {
    Input: slots: Address
    Body: {
        n = DpGet(slots, 6)
        IfCondition LessThan(n, 0) ThenBlock: {
            n = 0
        }
        place = 100000000
        k = 0
        one = 1
        ten = 10
        WhileLoop LessThan(k, 9) {
            d = Divide(n, place)
            ch = Add(48, d)
            DtChar(ch)
            n = Modulo(n, place)
            place = Divide(place, ten)
            k = Add(k, one)
        }
        ReturnValue(0)
    }
}

Function.DtClock {
    Input: slots: Address
    Body: {
        h = DpGet(slots, 3)
        mi = DpGet(slots, 4)
        s = DpGet(slots, 5)
        Dt2(h)
        DtChar(58)
        Dt2(mi)
        DtChar(58)
        Dt2(s)
        ReturnValue(0)
    }
}

Function.DtH12 {
    Input: slots: Address
    Output: Integer
    Body: {
        h = DpGet(slots, 3)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(h, 12) ThenBlock: { ReturnValue(12) }
        IfCondition GreaterThan(h, 12) ThenBlock: {
            h = Subtract(h, 12)
            ReturnValue(h)
        }
        ReturnValue(h)
    }
}

Function.DtWeekU {
    Input: slots: Address
    Output: Integer
    Body: {
        yday = DpGet(slots, 19)
        w = DpGet(slots, 18)
        t = Add(yday, 6)
        t = Subtract(t, w)
        u = Divide(t, 7)
        ReturnValue(u)
    }
}

Function.DtWeekW {
    Input: slots: Address
    Output: Integer
    Body: {
        yday = DpGet(slots, 19)
        w = DpGet(slots, 18)
        wm = Add(w, 6)
        wm = Modulo(wm, 7)
        t = Add(yday, 6)
        t = Subtract(t, wm)
        u = Divide(t, 7)
        ReturnValue(u)
    }
}

Function.DtWeekV {
    Input: slots: Address
    Output: Integer
    Body: {
        yday = DpGet(slots, 19)
        w = DpGet(slots, 18)
        year = DpGet(slots, 0)
        iso = w
        IfCondition EqualTo(iso, 0) ThenBlock: {
            iso = 7
        }
        delta = Subtract(4, iso)
        thu = Add(yday, delta)
        diy = DpDiy(year)
        one = 1
        IfCondition LessThan(thu, 1) ThenBlock: {
            py = Subtract(year, one)
            pd = DpDiy(py)
            thu = Add(thu, pd)
        } ElseBlock: {
            IfCondition GreaterThan(thu, diy) ThenBlock: {
                ReturnValue(1)
            }
        }
        t = Subtract(thu, 1)
        week = Divide(t, 7)
        week = Add(week, one)
        ReturnValue(week)
    }
}

Function.DtZ {
    Input: width: Integer
    Input: colons: Integer
    Body: {
        posix = DtOpt.disp
        iso = Subtract(0, posix)
        sign = 43
        a = iso
        IfCondition LessThan(a, 0) ThenBlock: {
            sign = 45
            a = Subtract(0, a)
        }
        h = Divide(a, 3600)
        rem = Modulo(a, 3600)
        m = Divide(rem, 60)
        s = Modulo(rem, 60)
        showm = 1
        shows = 0
        colon = 0
        IfCondition EqualTo(colons, 1) ThenBlock: { colon = 1 }
        IfCondition EqualTo(colons, 2) ThenBlock: {
            colon = 1
            shows = 1
        }
        IfCondition GreaterEqual(colons, 3) ThenBlock: {
            colon = 1
            shows = 1
            IfCondition EqualTo(s, 0) ThenBlock: { shows = 0 }
            both = And(EqualTo(s, 0), EqualTo(m, 0))
            IfCondition EqualTo(both, 1) ThenBlock: {
                showm = 0
                shows = 0
                colon = 0
            }
        }
        two = 2
        blen = 2
        one = 1
        IfCondition EqualTo(showm, 1) ThenBlock: {
            blen = Add(blen, two)
            IfCondition EqualTo(colon, 1) ThenBlock: {
                blen = Add(blen, one)
            }
        }
        IfCondition EqualTo(shows, 1) ThenBlock: {
            blen = Add(blen, two)
            IfCondition EqualTo(colon, 1) ThenBlock: {
                blen = Add(blen, one)
            }
        }
        total = Add(blen, one)
        padn = 0
        IfCondition GreaterThan(width, total) ThenBlock: {
            padn = Subtract(width, total)
        }
        DtChar(sign)
        DtRepeat(48, padn)
        Dt2(h)
        IfCondition EqualTo(showm, 1) ThenBlock: {
            IfCondition EqualTo(colon, 1) ThenBlock: { DtChar(58) }
            Dt2(m)
        }
        IfCondition EqualTo(shows, 1) ThenBlock: {
            IfCondition EqualTo(colon, 1) ThenBlock: { DtChar(58) }
            Dt2(s)
        }
        ReturnValue(0)
    }
}

Function.DtOff {
    Body: {
        posix = DtOpt.disp
        iso = Subtract(0, posix)
        sign = 43
        a = iso
        IfCondition LessThan(a, 0) ThenBlock: {
            sign = 45
            a = Subtract(0, a)
        }
        h = Divide(a, 3600)
        rem = Modulo(a, 3600)
        m = Divide(rem, 60)
        s = Modulo(rem, 60)
        DtChar(sign)
        Dt2(h)
        DtChar(58)
        Dt2(m)
        IfCondition NotEqual(s, 0) ThenBlock: {
            DtChar(58)
            Dt2(s)
        }
        ReturnValue(0)
    }
}

Function.DtYmd {
    Input: slots: Address
    Body: {
        y = DpGet(slots, 0)
        m = DpGet(slots, 1)
        d = DpGet(slots, 2)
        DtEmit(y, -1, -1, 0, 4, 48)
        DtChar(45)
        DtEmit(m, -1, -1, 0, 2, 48)
        DtChar(45)
        DtEmit(d, -1, -1, 0, 2, 48)
        ReturnValue(0)
    }
}

Function.DtPreset {
    Input: slots: Address
    Input: mode: Integer
    Body: {
        IfCondition EqualTo(mode, 1) ThenBlock: {
            w = DpGet(slots, 18)
            DtWday(w, 0, 0)
            DtLit(", ")
            day = DpGet(slots, 2)
            DtEmit(day, -1, -1, 0, 2, 48)
            DtChar(32)
            m = DpGet(slots, 1)
            DtMon(m, 0, 0)
            DtChar(32)
            y = DpGet(slots, 0)
            DtEmit(y, -1, -1, 0, 4, 48)
            DtChar(32)
            DtClock(slots)
            DtChar(32)
            DtZ(-1, 0)
            ReturnValue(0)
        }
        DtYmd(slots)
        IfCondition EqualTo(mode, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mode, 5) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mode, 3) ThenBlock: { DtChar(84) }
        IfCondition EqualTo(mode, 4) ThenBlock: { DtChar(84) }
        IfCondition EqualTo(mode, 6) ThenBlock: { DtChar(32) }
        IfCondition EqualTo(mode, 7) ThenBlock: { DtChar(32) }
        DtClock(slots)
        IfCondition EqualTo(mode, 4) ThenBlock: {
            DtChar(44)
            DtNsec(slots)
        }
        IfCondition EqualTo(mode, 7) ThenBlock: {
            DtChar(46)
            DtNsec(slots)
        }
        DtOff()
        ReturnValue(0)
    }
}

Function.DtSpec {
    Input: slots: Address
    Input: spec: Integer
    Input: pad: Integer
    Input: up: Integer
    Input: plus: Integer
    Input: width: Integer
    Body: {
        IfCondition EqualTo(spec, 97) ThenBlock: {
            w = DpGet(slots, 18)
            DtWday(w, 0, up)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 65) ThenBlock: {
            w = DpGet(slots, 18)
            DtWday(w, 1, up)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 98) ThenBlock: {
            m = DpGet(slots, 1)
            DtMon(m, 0, up)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 104) ThenBlock: {
            m = DpGet(slots, 1)
            DtMon(m, 0, up)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 66) ThenBlock: {
            m = DpGet(slots, 1)
            DtMon(m, 1, up)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 100) ThenBlock: {
            v = DpGet(slots, 2)
            DtEmit(v, width, pad, plus, 2, 48)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 101) ThenBlock: {
            v = DpGet(slots, 2)
            DtEmit(v, width, pad, plus, 2, 32)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 72) ThenBlock: {
            v = DpGet(slots, 3)
            DtEmit(v, width, pad, plus, 2, 48)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 107) ThenBlock: {
            v = DpGet(slots, 3)
            DtEmit(v, width, pad, plus, 2, 32)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 77) ThenBlock: {
            v = DpGet(slots, 4)
            DtEmit(v, width, pad, plus, 2, 48)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 83) ThenBlock: {
            v = DpGet(slots, 5)
            DtEmit(v, width, pad, plus, 2, 48)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 89) ThenBlock: {
            v = DpGet(slots, 0)
            DtEmit(v, width, pad, plus, 4, 48)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 121) ThenBlock: {
            v = DpGet(slots, 0)
            v = Modulo(v, 100)
            DtEmit(v, width, pad, plus, 2, 48)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 67) ThenBlock: {
            v = DpGet(slots, 0)
            v = Divide(v, 100)
            DtEmit(v, width, pad, plus, 2, 48)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 106) ThenBlock: {
            v = DpGet(slots, 19)
            DtEmit(v, width, pad, plus, 3, 48)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 109) ThenBlock: {
            v = DpGet(slots, 1)
            DtEmit(v, width, pad, plus, 2, 48)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 85) ThenBlock: {
            v = DtWeekU(slots)
            DtEmit(v, width, pad, plus, 2, 48)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 87) ThenBlock: {
            v = DtWeekW(slots)
            DtEmit(v, width, pad, plus, 2, 48)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 86) ThenBlock: {
            v = DtWeekV(slots)
            DtEmit(v, width, pad, plus, 2, 48)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 119) ThenBlock: {
            v = DpGet(slots, 18)
            DtEmit(v, width, pad, plus, 0, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 115) ThenBlock: {
            v = DpGet(slots, 12)
            DtEmit(v, width, pad, plus, 0, 48)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 113) ThenBlock: {
            m = DpGet(slots, 1)
            q = 1
            IfCondition GreaterEqual(m, 4) ThenBlock: { q = 2 }
            IfCondition GreaterEqual(m, 7) ThenBlock: { q = 3 }
            IfCondition GreaterEqual(m, 10) ThenBlock: { q = 4 }
            DtEmit(q, width, pad, plus, 0, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 73) ThenBlock: {
            v = DtH12(slots)
            DtEmit(v, width, pad, plus, 2, 48)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 108) ThenBlock: {
            v = DtH12(slots)
            DtEmit(v, width, pad, plus, 2, 32)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 112) ThenBlock: {
            h = DpGet(slots, 3)
            s = "PM"
            IfCondition LessThan(h, 12) ThenBlock: { s = "AM" }
            DtStr(s, up)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 110) ThenBlock: {
            DtChar(10)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 116) ThenBlock: {
            DtChar(9)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 70) ThenBlock: {
            DtYmd(slots)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 68) ThenBlock: {
            m = DpGet(slots, 1)
            d = DpGet(slots, 2)
            y = DpGet(slots, 0)
            y = Modulo(y, 100)
            DtEmit(m, -1, -1, 0, 2, 48)
            DtChar(47)
            DtEmit(d, -1, -1, 0, 2, 48)
            DtChar(47)
            DtEmit(y, -1, -1, 0, 2, 48)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 120) ThenBlock: {
            m = DpGet(slots, 1)
            d = DpGet(slots, 2)
            y = DpGet(slots, 0)
            y = Modulo(y, 100)
            DtEmit(m, -1, -1, 0, 2, 48)
            DtChar(47)
            DtEmit(d, -1, -1, 0, 2, 48)
            DtChar(47)
            DtEmit(y, -1, -1, 0, 2, 48)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 84) ThenBlock: {
            DtClock(slots)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 88) ThenBlock: {
            DtClock(slots)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 114) ThenBlock: {
            v = DtH12(slots)
            DtEmit(v, -1, -1, 0, 2, 48)
            DtChar(58)
            mi = DpGet(slots, 4)
            DtEmit(mi, -1, -1, 0, 2, 48)
            DtChar(58)
            s = DpGet(slots, 5)
            DtEmit(s, -1, -1, 0, 2, 48)
            DtChar(32)
            h = DpGet(slots, 3)
            ap = "PM"
            IfCondition LessThan(h, 12) ThenBlock: { ap = "AM" }
            DtStr(ap, up)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 99) ThenBlock: {
            w = DpGet(slots, 18)
            DtWday(w, 0, up)
            DtChar(32)
            m = DpGet(slots, 1)
            DtMon(m, 0, up)
            DtChar(32)
            d = DpGet(slots, 2)
            DtEmit(d, -1, -1, 0, 2, 32)
            DtChar(32)
            DtClock(slots)
            DtChar(32)
            y = DpGet(slots, 0)
            DtEmit(y, -1, -1, 0, 4, 48)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 90) ThenBlock: {
            nm = DtOpt.name
            nb = GetByte(nm, 0)
            IfCondition EqualTo(nb, 0) ThenBlock: {
                DtStr("UTC", up)
            } ElseBlock: {
                DtStr(nm, up)
            }
            ReturnValue(0)
        }
        DtChar(spec)
        ReturnValue(0)
    }
}

Function.DtSpan {
    Input: buf: Address
    Input: a: Integer
    Input: b: Integer
    Body: {
        i = a
        one = 1
        WhileLoop LessThan(i, b) {
            c = GetByte(buf, i)
            DtChar(c)
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.DtConv {
    Input: slots: Address
    Input: fmt: Address
    Input: flen: Integer
    Input: i: Integer
    Output: Integer
    Body: {
        one = 1
        start = i
        i = Add(i, one)
        IfCondition GreaterEqual(i, flen) ThenBlock: {
            DtChar(37)
            ReturnValue(i)
        }
        c = GetByte(fmt, i)
        IfCondition EqualTo(c, 37) ThenBlock: {
            DtChar(37)
            nxt = Add(i, one)
            ReturnValue(nxt)
        }
        pad = -1
        up = 0
        plus = 0
        width = -1
        colons = 0
        ten = 10
        guard = 0
        WhileLoop LessThan(guard, 80) {
            IfCondition GreaterEqual(i, flen) ThenBlock: {
                DtSpan(fmt, start, flen)
                ReturnValue(flen)
            }
            c = GetByte(fmt, i)
            IfCondition EqualTo(c, 48) ThenBlock: {
                IfCondition LessThan(width, 0) ThenBlock: {
                    IfCondition EqualTo(colons, 0) ThenBlock: {
                        pad = 48
                        i = Add(i, one)
                        guard = Add(guard, one)
                        ContinueLoop
                    }
                }
            }
            IfCondition EqualTo(c, 95) ThenBlock: {
                IfCondition LessThan(width, 0) ThenBlock: {
                    IfCondition EqualTo(colons, 0) ThenBlock: {
                        pad = 32
                        i = Add(i, one)
                        guard = Add(guard, one)
                        ContinueLoop
                    }
                }
            }
            IfCondition EqualTo(c, 45) ThenBlock: {
                IfCondition LessThan(width, 0) ThenBlock: {
                    IfCondition EqualTo(colons, 0) ThenBlock: {
                        pad = 0
                        i = Add(i, one)
                        guard = Add(guard, one)
                        ContinueLoop
                    }
                }
            }
            IfCondition EqualTo(c, 94) ThenBlock: {
                IfCondition LessThan(width, 0) ThenBlock: {
                    IfCondition EqualTo(colons, 0) ThenBlock: {
                        up = 1
                        i = Add(i, one)
                        guard = Add(guard, one)
                        ContinueLoop
                    }
                }
            }
            IfCondition EqualTo(c, 43) ThenBlock: {
                IfCondition LessThan(width, 0) ThenBlock: {
                    IfCondition EqualTo(colons, 0) ThenBlock: {
                        plus = 1
                        i = Add(i, one)
                        guard = Add(guard, one)
                        ContinueLoop
                    }
                }
            }
            dig = And(GreaterEqual(c, 48), LessEqual(c, 57))
            IfCondition EqualTo(dig, 1) ThenBlock: {
                IfCondition EqualTo(colons, 0) ThenBlock: {
                    IfCondition LessThan(width, 0) ThenBlock: {
                        width = 0
                    }
                    d = Subtract(c, 48)
                    w2 = Multiply(width, ten)
                    width = Add(w2, d)
                    i = Add(i, one)
                    guard = Add(guard, one)
                    ContinueLoop
                }
            }
            IfCondition EqualTo(c, 58) ThenBlock: {
                c2 = Add(colons, one)
                colons = c2
                i = Add(i, one)
                guard = Add(guard, one)
                ContinueLoop
            }
            spec = c
            nxt = Add(i, one)
            IfCondition GreaterThan(colons, 0) ThenBlock: {
                IfCondition NotEqual(spec, 122) ThenBlock: {
                    DtSpan(fmt, start, nxt)
                    ReturnValue(nxt)
                }
            }
            IfCondition EqualTo(spec, 122) ThenBlock: {
                DtZ(width, colons)
                ReturnValue(nxt)
            }
            DtSpec(slots, spec, pad, up, plus, width)
            ReturnValue(nxt)
        }
        DtSpan(fmt, start, flen)
        ReturnValue(flen)
    }
}

Function.DtFormat {
    Input: slots: Address
    Input: fmt: Address
    Input: flen: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, flen) {
            c = GetByte(fmt, i)
            IfCondition EqualTo(c, 37) ThenBlock: {
                i = DtConv(slots, fmt, flen, i)
            } ElseBlock: {
                DtChar(c)
                i = Add(i, one)
            }
        }
        ReturnValue(0)
    }
}

Function.DtErr {
    Input: s: Address
    Body: {
        n = StringLength(s)
        SystemCall(1, 2, s, n)
        ReturnValue(0)
    }
}

Function.DtErrB {
    Input: ch: Integer
    Body: {
        b = Allocate(1)
        SetByte(b, 0, ch)
        SystemCall(1, 2, b, 1)
        Deallocate(b, 1)
        ReturnValue(0)
    }
}

Function.DtInvalid {
    Input: text: Address
    Input: len: Integer
    Body: {
        DtErr("date: invalid date '")
        i = 0
        one = 1
        WhileLoop LessThan(i, len) {
            c = GetByte(text, i)
            bad = 0
            IfCondition LessThan(c, 32) ThenBlock: { bad = 1 }
            IfCondition GreaterEqual(c, 127) ThenBlock: { bad = 1 }
            IfCondition EqualTo(c, 92) ThenBlock: { bad = 1 }
            IfCondition EqualTo(c, 39) ThenBlock: { bad = 1 }
            IfCondition EqualTo(bad, 1) ThenBlock: {
                DtErrB(92)
                o2 = Divide(c, 64)
                r = Modulo(c, 64)
                o1 = Divide(r, 8)
                o0 = Modulo(c, 8)
                c2 = Add(48, o2)
                c1 = Add(48, o1)
                c0 = Add(48, o0)
                DtErrB(c2)
                DtErrB(c1)
                DtErrB(c0)
            } ElseBlock: {
                DtErrB(c)
            }
            i = Add(i, one)
        }
        DtErr("'\n")
        SystemCall(60, 1)
        ReturnValue(0)
    }
}

Function.DtCopy {
    Input: src: Address
    Input: start: Integer
    Input: len: Integer
    Input: dst: Address
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, len) {
            at = Add(start, i)
            c = GetByte(src, at)
            SetByte(dst, i, c)
            i = Add(i, one)
        }
        SetByte(dst, len, 0)
        ReturnValue(0)
    }
}

Function.DtPre {
    Input: buf: Address
    Input: a: Integer
    Input: alen: Integer
    Input: lit: Address
    Output: Integer
    Body: {
        nlit = StringLength(lit)
        IfCondition GreaterThan(nlit, alen) ThenBlock: {
            ReturnValue(0)
        }
        k = 0
        one = 1
        WhileLoop LessThan(k, nlit) {
            at = Add(a, k)
            ca = GetByte(buf, at)
            cb = GetByte(lit, k)
            IfCondition NotEqual(ca, cb) ThenBlock: {
                ReturnValue(0)
            }
            k = Add(k, one)
        }
        ReturnValue(1)
    }
}

Function.DtEq {
    Input: buf: Address
    Input: a: Integer
    Input: alen: Integer
    Input: lit: Address
    Output: Integer
    Body: {
        nlit = StringLength(lit)
        IfCondition NotEqual(nlit, alen) ThenBlock: {
            ReturnValue(0)
        }
        hit = DtPre(buf, a, alen, lit)
        ReturnValue(hit)
    }
}

Function.DtWhich {
    Input: buf: Address
    Input: a: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        hit = DtEq(buf, a, n, "date")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(0) }
        hit = DtPre(buf, a, n, "sec")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = DtEq(buf, a, n, "ns")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(2) }
        hit = DtPre(buf, a, n, "nsec")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(2) }
        hit = DtPre(buf, a, n, "nano")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(2) }
        ReturnValue(-1)
    }
}

Function.DtSetSpec {
    Input: buf: Address
    Input: a: Integer
    Input: n: Integer
    Input: base: Integer
    Body: {
        wh = DtWhich(buf, a, n)
        IfCondition LessThan(wh, 0) ThenBlock: {
            DtErr("date: invalid argument\n")
            SystemCall(60, 1)
        }
        mode = Add(base, wh)
        DtOpt.mode = mode
        ReturnValue(0)
    }
}

Function.DtTakeOpt {
    Input: cmd: Address
    Input: a: Integer
    Input: alen: Integer
    Input: datebuf: Address
    Input: filebuf: Address
    Output: Integer
    Body: {
        one = 1
        b1 = 0
        IfCondition GreaterEqual(alen, 2) ThenBlock: {
            a1 = Add(a, one)
            b1 = GetByte(cmd, a1)
        }
        IfCondition EqualTo(b1, 45) ThenBlock: {
            hit = DtEq(cmd, a, alen, "--debug")
            IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(0) }
            hit = DtEq(cmd, a, alen, "--version")
            IfCondition EqualTo(hit, 1) ThenBlock: {
                DtLit("date (AILANG coreutils) 9.4\n")
                SystemCall(60, 0)
            }
            hit = DtEq(cmd, a, alen, "--utc")
            IfCondition EqualTo(hit, 1) ThenBlock: {
                DtOpt.utc = 1
                ReturnValue(0)
            }
            hit = DtEq(cmd, a, alen, "--universal")
            IfCondition EqualTo(hit, 1) ThenBlock: {
                DtOpt.utc = 1
                ReturnValue(0)
            }
            hit = DtEq(cmd, a, alen, "--date")
            IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
            hit = DtEq(cmd, a, alen, "--file")
            IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(2) }
            hit = DtEq(cmd, a, alen, "--rfc-email")
            IfCondition EqualTo(hit, 1) ThenBlock: {
                DtOpt.mode = 1
                ReturnValue(0)
            }
            hit = DtEq(cmd, a, alen, "--rfc-822")
            IfCondition EqualTo(hit, 1) ThenBlock: {
                DtOpt.mode = 1
                ReturnValue(0)
            }
            hit = DtEq(cmd, a, alen, "--iso")
            IfCondition EqualTo(hit, 1) ThenBlock: {
                DtOpt.mode = 2
                ReturnValue(0)
            }
            hit = DtEq(cmd, a, alen, "--iso-8601")
            IfCondition EqualTo(hit, 1) ThenBlock: {
                DtOpt.mode = 2
                ReturnValue(0)
            }
            hit = DtEq(cmd, a, alen, "--")
            IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(0) }
            lit = "--date="
            hit = DtPre(cmd, a, alen, lit)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                npre = StringLength(lit)
                start = Add(a, npre)
                n = Subtract(alen, npre)
                DtCopy(cmd, start, n, datebuf)
                DtOpt.datelen = n
                DtOpt.have_d = 1
                ReturnValue(0)
            }
            lit = "--file="
            hit = DtPre(cmd, a, alen, lit)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                npre = StringLength(lit)
                start = Add(a, npre)
                n = Subtract(alen, npre)
                DtCopy(cmd, start, n, filebuf)
                DtOpt.have_file = 1
                ReturnValue(0)
            }
            lit = "--iso-8601="
            hit = DtPre(cmd, a, alen, lit)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                npre = StringLength(lit)
                start = Add(a, npre)
                n = Subtract(alen, npre)
                DtSetSpec(cmd, start, n, 2)
                ReturnValue(0)
            }
            lit = "--iso="
            hit = DtPre(cmd, a, alen, lit)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                npre = StringLength(lit)
                start = Add(a, npre)
                n = Subtract(alen, npre)
                DtSetSpec(cmd, start, n, 2)
                ReturnValue(0)
            }
            lit = "--rfc-3339="
            hit = DtPre(cmd, a, alen, lit)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                npre = StringLength(lit)
                start = Add(a, npre)
                n = Subtract(alen, npre)
                DtSetSpec(cmd, start, n, 5)
                ReturnValue(0)
            }
            DtErr("date: unrecognized option\n")
            SystemCall(60, 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(alen, 2) ThenBlock: {
            IfCondition EqualTo(b1, 117) ThenBlock: {
                DtOpt.utc = 1
                ReturnValue(0)
            }
            IfCondition EqualTo(b1, 82) ThenBlock: {
                DtOpt.mode = 1
                ReturnValue(0)
            }
            IfCondition EqualTo(b1, 100) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(b1, 73) ThenBlock: {
                DtOpt.mode = 2
                ReturnValue(0)
            }
        }
        IfCondition And(GreaterThan(alen, 2), EqualTo(b1, 100)) ThenBlock: {
            two = 2
            start = Add(a, two)
            n = Subtract(alen, two)
            DtCopy(cmd, start, n, datebuf)
            DtOpt.datelen = n
            DtOpt.have_d = 1
            ReturnValue(0)
        }
        IfCondition And(GreaterThan(alen, 2), EqualTo(b1, 73)) ThenBlock: {
            two = 2
            start = Add(a, two)
            n = Subtract(alen, two)
            DtSetSpec(cmd, start, n, 2)
            ReturnValue(0)
        }
        DtErr("date: invalid option\n")
        SystemCall(60, 1)
        ReturnValue(0)
    }
}

Function.DtShow {
    Input: text: Address
    Input: len: Integer
    Input: slots: Address
    Body: {
        nowv = DtOpt.now
        poff = DtOpt.parseoff
        rc = DpParse(text, len, slots, nowv, poff)
        IfCondition LessThan(rc, 0) ThenBlock: {
            DtInvalid(text, len)
        }
        disp = DtOpt.disp
        DpShow(slots, disp)
        mode = DtOpt.mode
        hf = DtOpt.have_fmt
        IfCondition EqualTo(hf, 1) ThenBlock: {
            fmt = DtOpt.fmt
            flen = DtOpt.fmtlen
            DtFormat(slots, fmt, flen)
        } ElseBlock: {
            IfCondition NotEqual(mode, 0) ThenBlock: {
                DtPreset(slots, mode)
            } ElseBlock: {
                def = "%a %b %e %H:%M:%S %Z %Y"
                n = StringLength(def)
                DtFormat(slots, def, n)
            }
        }
        DtChar(10)
        ReturnValue(0)
    }
}

Function.DtFile {
    Input: path: Address
    Input: slots: Address
    Body: {
        fd = SystemCall(257, -100, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            DtErr("date: cannot read file\n")
            SystemCall(60, 1)
        }
        buf = Allocate(65536)
        nr = SystemCall(0, fd, buf, 65535)
        SystemCall(3, fd)
        IfCondition LessThan(nr, 0) ThenBlock: {
            DtErr("date: cannot read file\n")
            SystemCall(60, 1)
        }
        line = Allocate(65536)
        p = 0
        one = 1
        WhileLoop LessThan(p, nr) {
            q = p
            WhileLoop LessThan(q, nr) {
                c = GetByte(buf, q)
                IfCondition EqualTo(c, 10) ThenBlock: { BreakLoop }
                q = Add(q, one)
            }
            llen = Subtract(q, p)
            IfCondition GreaterThan(llen, 0) ThenBlock: {
                DtCopy(buf, p, llen, line)
                DtShow(line, llen, slots)
            }
            IfCondition LessThan(q, nr) ThenBlock: {
                cq = GetByte(buf, q)
                IfCondition EqualTo(cq, 10) ThenBlock: {
                    q = Add(q, one)
                }
            }
            IfCondition LessEqual(q, p) ThenBlock: { BreakLoop }
            p = q
        }
        Deallocate(buf, 65536)
        Deallocate(line, 65536)
        ReturnValue(0)
    }
}

SubRoutine.Main {
    now = SystemCall(201, 0)
    slots = Allocate(384)
    z = 0
    one = 1
    WhileLoop LessThan(z, 48) {
        DpSet(slots, z, 0)
        z = Add(z, one)
    }
    name = Allocate(32)
    envoff = DpLoadTZ(name, 32, slots)
    cmdpath = "/proc/self/cmdline"
    fd = SystemCall(257, -100, cmdpath, 0, 0)
    IfCondition LessThan(fd, 0) ThenBlock: {
        SystemCall(60, 1)
    }
    cmd = Allocate(65536)
    nr = SystemCall(0, fd, cmd, 65535)
    SystemCall(3, fd)
    IfCondition LessEqual(nr, 0) ThenBlock: {
        SystemCall(60, 1)
    }
    datebuf = Allocate(65536)
    fmtbuf = Allocate(4096)
    filebuf = Allocate(4096)
    bout = Allocate(1)
    DtOpt.bout = bout
    DtOpt.now = now
    DtOpt.mode = 0
    DtOpt.utc = 0
    DtOpt.have_d = 0
    DtOpt.have_file = 0
    DtOpt.have_fmt = 0
    DtOpt.name = name
    i = 0
    WhileLoop LessThan(i, nr) {
        c = GetByte(cmd, i)
        IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
        i = Add(i, one)
    }
    IfCondition LessThan(i, nr) ThenBlock: {
        i = Add(i, one)
    }
    need = 0
    WhileLoop LessThan(i, nr) {
        a = i
        WhileLoop LessThan(i, nr) {
            c = GetByte(cmd, i)
            IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
            i = Add(i, one)
        }
        alen = Subtract(i, a)
        IfCondition LessThan(i, nr) ThenBlock: {
            i = Add(i, one)
        }
        IfCondition GreaterThan(need, 0) ThenBlock: {
            IfCondition EqualTo(need, 1) ThenBlock: {
                DtCopy(cmd, a, alen, datebuf)
                DtOpt.datelen = alen
                DtOpt.have_d = 1
            }
            IfCondition EqualTo(need, 2) ThenBlock: {
                DtCopy(cmd, a, alen, filebuf)
                DtOpt.have_file = 1
            }
            need = 0
        } ElseBlock: {
            b0 = 0
            IfCondition GreaterThan(alen, 0) ThenBlock: {
                b0 = GetByte(cmd, a)
            }
            IfCondition EqualTo(b0, 43) ThenBlock: {
                fl = Subtract(alen, one)
                fs = Add(a, one)
                cap = 4095
                IfCondition GreaterThan(fl, cap) ThenBlock: { fl = cap }
                DtCopy(cmd, fs, fl, fmtbuf)
                DtOpt.fmt = fmtbuf
                DtOpt.fmtlen = fl
                DtOpt.have_fmt = 1
            } ElseBlock: {
                IfCondition EqualTo(b0, 45) ThenBlock: {
                    need = DtTakeOpt(cmd, a, alen, datebuf, filebuf)
                } ElseBlock: {
                    IfCondition GreaterThan(alen, 0) ThenBlock: {
                        DtErr("date: extra operand\n")
                        SystemCall(60, 1)
                    }
                }
            }
        }
    }
    IfCondition NotEqual(need, 0) ThenBlock: {
        DtErr("date: option requires an argument\n")
        SystemCall(60, 1)
    }
    utc = DtOpt.utc
    dispoff = envoff
    parseoff = envoff
    IfCondition EqualTo(utc, 1) ThenBlock: {
        dispoff = 0
        parseoff = 0
        DpNameUTC(name)
    }
    DtOpt.disp = dispoff
    DtOpt.parseoff = parseoff
    hf = DtOpt.have_file
    hd = DtOpt.have_d
    dlen = DtOpt.datelen
    IfCondition EqualTo(hf, 1) ThenBlock: {
        DtFile(filebuf, slots)
    } ElseBlock: {
        IfCondition EqualTo(hd, 1) ThenBlock: {
            DtShow(datebuf, dlen, slots)
        } ElseBlock: {
            DtShow(datebuf, 0, slots)
        }
    }
    SystemCall(60, 0)
}

RunTask(Main)
