// dd.ailang - GNU coreutils 9.4 subset for tests/dd
// status, partial records, suffixes, swab, fullblock, seek/skip.
// A failed huge ftruncate must exit non-zero so du/8gb.sh skips.

LibraryImport.Arena

FixedPool.DdConfig {
    "ibs": Initialize=0
    "obs": Initialize=0
    "bs": Initialize=0
    "bs_set": Initialize=0
    "count": Initialize=0
    "count_set": Initialize=0
    "count_bytes": Initialize=0
    "skip": Initialize=0
    "skip_bytes": Initialize=0
    "seek": Initialize=0
    "seek_bytes": Initialize=0
    "status": Initialize=0
    "conv_sync": Initialize=0
    "conv_swab": Initialize=0
    "fl_fullblock": Initialize=0
    "fl_nofollow": Initialize=0
    "fl_directory": Initialize=0
    "fl_noatime": Initialize=0
    "fl_nolinks_in": Initialize=0
    "fl_append": Initialize=0
    "fl_notrunc": Initialize=0
    "fl_nolinks_out": Initialize=0
    "in_full": Initialize=0
    "in_part": Initialize=0
    "out_full": Initialize=0
    "out_part": Initialize=0
    "bytes_copied": Initialize=0
    "bytes_left": Initialize=-1
    "out_fill": Initialize=0
    "in_fd": Initialize=0
    "out_fd": Initialize=1
    "opened_in": Initialize=0
    "opened_out": Initialize=0
    "io_error": Initialize=0
    "did_seek": Initialize=0
    "seek_pos": Initialize=0
    "parse_ok": Initialize=0
    "parse_val": Initialize=0
    "if_path": Initialize=0
    "of_path": Initialize=0
    "cbs": Initialize=0
    "conv_block": Initialize=0
    "conv_unblock": Initialize=0
    "conv_ascii": Initialize=0
    "conv_sparse": Initialize=0
    "conv_fdatasync": Initialize=0
    "col": Initialize=0
    "pending_sp": Initialize=0
    "trunc_recs": Initialize=0
    "last_seek": Initialize=0
    "xlate": Initialize=0
    "fl_nocache_in": Initialize=0
    "fl_nocache_out": Initialize=0
    "fl_osync": Initialize=0
    "hit_eof": Initialize=0
    "human_exp": Initialize=0
    "human_tenths": Initialize=0
    "records_left": Initialize=0
}

Function.WriteOut {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 1, buffer, len)
    }
}

Function.WriteErr {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        n = SystemCall(1, 2, buffer, len)
        IfCondition LessThan(n, len) ThenBlock: {
            DdConfig.io_error = 1
        }
    }
}

Function.GetStringLength {
    Input: str: Address
    Output: Integer
    Body: {
        len = 0
        one = 1
        WhileLoop NotEqual(GetByte(str, len), 0) {
            len = Add(len, one)
        }
        ReturnValue(len)
    }
}

Function.ConvertNumberToString {
    Input: num: Integer
    Output: Address
    Body: {
        buffer = Allocate(512)
        IfCondition EqualTo(num, 0) ThenBlock: {
            SetByte(buffer, 0, 48)
            SetByte(buffer, 1, 0)
            ReturnValue(buffer)
        }
        is_neg = 0
        IfCondition LessThan(num, 0) ThenBlock: {
            is_neg = 1
            num = Subtract(0, num)
        }
        pos = 0
        one = 1
        temp = Allocate(512)
        WhileLoop GreaterThan(num, 0) {
            digit = Modulo(num, 10)
            SetByte(temp, pos, Add(48, digit))
            pos = Add(pos, one)
            num = Divide(num, 10)
        }
        write_pos = 0
        IfCondition NotEqual(is_neg, 0) ThenBlock: {
            SetByte(buffer, 0, 45)
            write_pos = 1
        }
        i = Subtract(pos, 1)
        WhileLoop GreaterEqual(i, 0) {
            ch = GetByte(temp, i)
            SetByte(buffer, write_pos, ch)
            write_pos = Add(write_pos, one)
            i = Subtract(i, 1)
        }
        SetByte(buffer, write_pos, 0)
        Deallocate(temp, 512)
        ReturnValue(buffer)
    }
}

Function.WriteNum {
    Input: num: Integer
    Body: {
        text = ConvertNumberToString(num)
        nlen = GetStringLength(text)
        WriteErr(text, nlen)
        Deallocate(text, 512)
    }
}

Function.LoadU32 {
    Input: buf: Address
    Input: off: Integer
    Output: Integer
    Body: {
        b0 = GetByte(buf, off)
        o1 = Add(off, 1)
        b1 = GetByte(buf, o1)
        o2 = Add(off, 2)
        b2 = GetByte(buf, o2)
        o3 = Add(off, 3)
        b3 = GetByte(buf, o3)
        v = Add(b0, Multiply(b1, 256))
        v = Add(v, Multiply(b2, 65536))
        v = Add(v, Multiply(b3, 16777216))
        ReturnValue(v)
    }
}

Function.LoadU64 {
    Input: buf: Address
    Input: off: Integer
    Output: Integer
    Body: {
        b0 = GetByte(buf, off)
        o1 = Add(off, 1)
        b1 = GetByte(buf, o1)
        o2 = Add(off, 2)
        b2 = GetByte(buf, o2)
        o3 = Add(off, 3)
        b3 = GetByte(buf, o3)
        o4 = Add(off, 4)
        b4 = GetByte(buf, o4)
        o5 = Add(off, 5)
        b5 = GetByte(buf, o5)
        o6 = Add(off, 6)
        b6 = GetByte(buf, o6)
        o7 = Add(off, 7)
        b7 = GetByte(buf, o7)
        lo = Add(b0, Multiply(b1, 256))
        lo = Add(lo, Multiply(b2, 65536))
        lo = Add(lo, Multiply(b3, 16777216))
        hi = Add(b4, Multiply(b5, 256))
        hi = Add(hi, Multiply(b6, 65536))
        hi = Add(hi, Multiply(b7, 16777216))
        v = Add(lo, Multiply(hi, 4294967296))
        ReturnValue(v)
    }
}

Function.KeyEq {
    Input: arg: Address
    Input: eqpos: Integer
    Input: name: Address
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, eqpos) {
            a = GetByte(arg, i)
            b = GetByte(name, i)
            IfCondition NotEqual(a, b) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        b = GetByte(name, eqpos)
        IfCondition NotEqual(b, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.SliceEq {
    Input: s: Address
    Input: start: Integer
    Input: nlen: Integer
    Input: name: Address
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, nlen) {
            at = Add(start, i)
            a = GetByte(s, at)
            b = GetByte(name, i)
            IfCondition NotEqual(a, b) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        b = GetByte(name, nlen)
        IfCondition NotEqual(b, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.WordAllowed {
    Input: s: Address
    Input: start: Integer
    Input: nlen: Integer
    Input: kind: Integer
    Output: Integer
    Body: {
        hit = 0
        IfCondition EqualTo(kind, 1) ThenBlock: {
            IfCondition NotEqual(SliceEq(s, start, nlen, "sync"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "swab"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "notrunc"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "sparse"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "block"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "unblock"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "ascii"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "fdatasync"), 0) ThenBlock: {
                hit = 1
            }
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            IfCondition NotEqual(SliceEq(s, start, nlen, "fullblock"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "count_bytes"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "skip_bytes"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "nofollow"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "directory"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "noatime"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "nolinks"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "nocache"), 0) ThenBlock: {
                hit = 1
            }
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            IfCondition NotEqual(SliceEq(s, start, nlen, "append"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "seek_bytes"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "notrunc"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "nolinks"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "nocache"), 0) ThenBlock: {
                hit = 1
            }
            IfCondition NotEqual(SliceEq(s, start, nlen, "sync"), 0) ThenBlock: {
                hit = 1
            }
        }
        ReturnValue(hit)
    }
}

Function.WordsOk {
    Input: s: Address
    Input: kind: Integer
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, 200) {
            start = i
            c = GetByte(s, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(0)
            }
            WhileLoop LessThan(i, 200) {
                c = GetByte(s, i)
                IfCondition EqualTo(c, 0) ThenBlock: {
                    BreakLoop
                }
                IfCondition EqualTo(c, 44) ThenBlock: {
                    BreakLoop
                }
                i = Add(i, one)
            }
            nlen = Subtract(i, start)
            IfCondition EqualTo(nlen, 0) ThenBlock: {
                ReturnValue(0)
            }
            allowed = WordAllowed(s, start, nlen, kind)
            IfCondition EqualTo(allowed, 0) ThenBlock: {
                ReturnValue(0)
            }
            c = GetByte(s, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.HasWord {
    Input: s: Address
    Input: name: Address
    Output: Integer
    Body: {
        i = 0
        one = 1
        nlen = GetStringLength(name)
        WhileLoop LessThan(i, 200) {
            start = i
            WhileLoop LessThan(i, 200) {
                c = GetByte(s, i)
                IfCondition EqualTo(c, 0) ThenBlock: {
                    BreakLoop
                }
                IfCondition EqualTo(c, 44) ThenBlock: {
                    BreakLoop
                }
                i = Add(i, one)
            }
            wlen = Subtract(i, start)
            eq = SliceEq(s, start, wlen, name)
            IfCondition NotEqual(eq, 0) ThenBlock: {
                ReturnValue(1)
            }
            c = GetByte(s, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.ContainsByte {
    Input: s: Address
    Input: ch: Integer
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, 128) {
            c = GetByte(s, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(c, ch) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.ParseDDNumber {
    Input: str: Address
    Body: {
        i = 0
        one = 1
        product = 0
        have = 0
        prod_ov = 0
        zero_x = 0
        ok = 1
        need = 1
        factors = 0
        WhileLoop And(LessThan(factors, 8), NotEqual(ok, 0)) {
            c = GetByte(str, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                IfCondition NotEqual(need, 0) ThenBlock: {
                    ok = 0
                }
                BreakLoop
            }
            digit_ok = And(GreaterEqual(c, 48), LessEqual(c, 57))
            IfCondition EqualTo(digit_ok, 0) ThenBlock: {
                ok = 0
                BreakLoop
            }
            i1 = Add(i, one)
            s1 = GetByte(str, i1)
            IfCondition And(EqualTo(c, 48), EqualTo(s1, 120)) ThenBlock: {
                zero_x = 1
            }
            val = 0
            fov = 0
            WhileLoop LessThan(i, 128) {
                c = GetByte(str, i)
                digit_ok = And(GreaterEqual(c, 48), LessEqual(c, 57))
                IfCondition EqualTo(digit_ok, 0) ThenBlock: {
                    BreakLoop
                }
                IfCondition GreaterThan(val, 922337203685477580) ThenBlock: {
                    fov = 1
                } ElseBlock: {
                    dig = Subtract(c, 48)
                    edge = EqualTo(val, 922337203685477580)
                    overdig = And(NotEqual(edge, 0), GreaterThan(dig, 7))
                    IfCondition NotEqual(overdig, 0) ThenBlock: {
                        fov = 1
                    } ElseBlock: {
                        val = Add(Multiply(val, 10), dig)
                    }
                }
                i = Add(i, one)
            }
            c = GetByte(str, i)
            mult = 1
            is_suf = 0
            suf_b = 0
            IfCondition EqualTo(c, 99) ThenBlock: {
                mult = 1
                is_suf = 1
            }
            IfCondition EqualTo(c, 119) ThenBlock: {
                mult = 2
                is_suf = 1
            }
            IfCondition EqualTo(c, 98) ThenBlock: {
                mult = 512
                is_suf = 1
            }
            IfCondition EqualTo(c, 107) ThenBlock: {
                mult = 1024
                is_suf = 1
            }
            IfCondition EqualTo(c, 75) ThenBlock: {
                mult = 1024
                is_suf = 1
            }
            IfCondition EqualTo(c, 77) ThenBlock: {
                mult = 1048576
                is_suf = 1
            }
            IfCondition EqualTo(c, 71) ThenBlock: {
                mult = 1073741824
                is_suf = 1
            }
            IfCondition EqualTo(c, 84) ThenBlock: {
                mult = 1099511627776
                is_suf = 1
            }
            IfCondition EqualTo(c, 66) ThenBlock: {
                mult = 1
                is_suf = 1
                suf_b = 1
            }
            IfCondition NotEqual(is_suf, 0) ThenBlock: {
                i = Add(i, one)
                c = GetByte(str, i)
                IfCondition And(EqualTo(suf_b, 0), EqualTo(c, 66)) ThenBlock: {
                    i = Add(i, one)
                    c = GetByte(str, i)
                }
            }
            IfCondition EqualTo(fov, 0) ThenBlock: {
                IfCondition GreaterThan(mult, 1) ThenBlock: {
                    lim = Divide(9223372036854775807, mult)
                    IfCondition GreaterThan(val, lim) ThenBlock: {
                        fov = 1
                    } ElseBlock: {
                        val = Multiply(val, mult)
                    }
                }
            }
            IfCondition EqualTo(have, 0) ThenBlock: {
                product = val
                prod_ov = fov
                have = 1
            } ElseBlock: {
                zero_prod = And(EqualTo(product, 0), EqualTo(prod_ov, 0))
                zero_val = And(EqualTo(val, 0), EqualTo(fov, 0))
                IfCondition NotEqual(zero_prod, 0) ThenBlock: {
                    product = 0
                    prod_ov = 0
                }
                IfCondition NotEqual(zero_val, 0) ThenBlock: {
                    product = 0
                    prod_ov = 0
                }
                still = And(EqualTo(zero_prod, 0), EqualTo(zero_val, 0))
                IfCondition NotEqual(still, 0) ThenBlock: {
                    bad = Or(NotEqual(prod_ov, 0), NotEqual(fov, 0))
                    IfCondition NotEqual(bad, 0) ThenBlock: {
                        ok = 0
                    } ElseBlock: {
                        lim = Divide(9223372036854775807, val)
                        IfCondition GreaterThan(product, lim) ThenBlock: {
                            ok = 0
                        } ElseBlock: {
                            product = Multiply(product, val)
                        }
                    }
                }
            }
            need = 0
            factors = Add(factors, one)
            c = GetByte(str, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition EqualTo(c, 120) ThenBlock: {
                i = Add(i, one)
                need = 1
            } ElseBlock: {
                ok = 0
            }
        }
        IfCondition EqualTo(have, 0) ThenBlock: {
            ok = 0
        }
        IfCondition NotEqual(prod_ov, 0) ThenBlock: {
            ok = 0
        }
        DdConfig.parse_ok = ok
        DdConfig.parse_val = product
        IfCondition NotEqual(ok, 0) ThenBlock: {
            warn = And(EqualTo(product, 0), NotEqual(zero_x, 0))
            IfCondition NotEqual(warn, 0) ThenBlock: {
                WriteErr("dd: warning: '0x' is a zero multiplier; use '00x' if that is intended\n", 70)
            }
        }
    }
}

Function.BadNumber {
    Input: s: Address
    Body: {
        WriteErr("dd: invalid number: '", 21)
        nlen = GetStringLength(s)
        WriteErr(s, nlen)
        WriteErr("'\n", 2)
        DdConfig.io_error = 1
    }
}

Function.CopyValue {
    Input: s: Address
    Output: Address
    Body: {
        nlen = GetStringLength(s)
        buf = Allocate(Add(nlen, 1))
        i = 0
        one = 1
        WhileLoop LessThan(i, nlen) {
            ch = GetByte(s, i)
            SetByte(buf, i, ch)
            i = Add(i, one)
        }
        SetByte(buf, nlen, 0)
        ReturnValue(buf)
    }
}

Function.ParseOperand {
    Input: arg: Address
    Body: {
        eq = -1
        i = 0
        one = 1
        WhileLoop LessThan(i, 64) {
            c = GetByte(arg, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition EqualTo(c, 61) ThenBlock: {
                eq = i
                BreakLoop
            }
            i = Add(i, one)
        }
        IfCondition LessThan(eq, 0) ThenBlock: {
            WriteErr("dd: unrecognized operand '", 26)
            nlen = GetStringLength(arg)
            WriteErr(arg, nlen)
            WriteErr("'\n", 2)
            DdConfig.io_error = 1
            ReturnValue(0)
        }
        vpos = Add(eq, one)
        val = Add(arg, vpos)
        IfCondition NotEqual(KeyEq(arg, eq, "if"), 0) ThenBlock: {
            DdConfig.if_path = CopyValue(val)
            ReturnValue(0)
        }
        IfCondition NotEqual(KeyEq(arg, eq, "of"), 0) ThenBlock: {
            DdConfig.of_path = CopyValue(val)
            ReturnValue(0)
        }
        IfCondition NotEqual(KeyEq(arg, eq, "status"), 0) ThenBlock: {
            none = SliceEq(val, 0, 4, "none")
            nox = SliceEq(val, 0, 6, "noxfer")
            prog = SliceEq(val, 0, 8, "progress")
            IfCondition NotEqual(none, 0) ThenBlock: {
                DdConfig.status = 1
                ReturnValue(0)
            }
            IfCondition NotEqual(nox, 0) ThenBlock: {
                DdConfig.status = 2
                ReturnValue(0)
            }
            IfCondition NotEqual(prog, 0) ThenBlock: {
                DdConfig.status = 3
                ReturnValue(0)
            }
            WriteErr("dd: invalid status: '", 21)
            nlen = GetStringLength(val)
            WriteErr(val, nlen)
            WriteErr("'\n", 2)
            DdConfig.io_error = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(KeyEq(arg, eq, "conv"), 0) ThenBlock: {
            okw = WordsOk(val, 1)
            IfCondition EqualTo(okw, 0) ThenBlock: {
                WriteErr("dd: invalid conversion: '", 25)
                nlen = GetStringLength(val)
                WriteErr(val, nlen)
                WriteErr("'\n", 2)
                DdConfig.io_error = 1
                ReturnValue(0)
            }
            IfCondition NotEqual(HasWord(val, "sync"), 0) ThenBlock: {
                DdConfig.conv_sync = 1
            }
            IfCondition NotEqual(HasWord(val, "swab"), 0) ThenBlock: {
                DdConfig.conv_swab = 1
            }
            IfCondition NotEqual(HasWord(val, "notrunc"), 0) ThenBlock: {
                DdConfig.fl_notrunc = 1
            }
            IfCondition NotEqual(HasWord(val, "sparse"), 0) ThenBlock: {
                DdConfig.conv_sparse = 1
            }
            IfCondition NotEqual(HasWord(val, "block"), 0) ThenBlock: {
                DdConfig.conv_block = 1
            }
            IfCondition NotEqual(HasWord(val, "unblock"), 0) ThenBlock: {
                DdConfig.conv_unblock = 1
            }
            IfCondition NotEqual(HasWord(val, "ascii"), 0) ThenBlock: {
                DdConfig.conv_ascii = 1
                DdConfig.conv_unblock = 1
            }
            IfCondition NotEqual(HasWord(val, "fdatasync"), 0) ThenBlock: {
                DdConfig.conv_fdatasync = 1
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(KeyEq(arg, eq, "iflag"), 0) ThenBlock: {
            okw = WordsOk(val, 2)
            IfCondition EqualTo(okw, 0) ThenBlock: {
                WriteErr("dd: invalid input flag: '", 25)
                nlen = GetStringLength(val)
                WriteErr(val, nlen)
                WriteErr("'\n", 2)
                DdConfig.io_error = 1
                ReturnValue(0)
            }
            IfCondition NotEqual(HasWord(val, "fullblock"), 0) ThenBlock: {
                DdConfig.fl_fullblock = 1
            }
            IfCondition NotEqual(HasWord(val, "count_bytes"), 0) ThenBlock: {
                DdConfig.count_bytes = 1
            }
            IfCondition NotEqual(HasWord(val, "skip_bytes"), 0) ThenBlock: {
                DdConfig.skip_bytes = 1
            }
            IfCondition NotEqual(HasWord(val, "nofollow"), 0) ThenBlock: {
                DdConfig.fl_nofollow = 1
            }
            IfCondition NotEqual(HasWord(val, "directory"), 0) ThenBlock: {
                DdConfig.fl_directory = 1
            }
            IfCondition NotEqual(HasWord(val, "noatime"), 0) ThenBlock: {
                DdConfig.fl_noatime = 1
            }
            IfCondition NotEqual(HasWord(val, "nolinks"), 0) ThenBlock: {
                DdConfig.fl_nolinks_in = 1
            }
            IfCondition NotEqual(HasWord(val, "nocache"), 0) ThenBlock: {
                DdConfig.fl_nocache_in = 1
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(KeyEq(arg, eq, "oflag"), 0) ThenBlock: {
            okw = WordsOk(val, 3)
            IfCondition EqualTo(okw, 0) ThenBlock: {
                WriteErr("dd: invalid output flag: '", 26)
                nlen = GetStringLength(val)
                WriteErr(val, nlen)
                WriteErr("'\n", 2)
                DdConfig.io_error = 1
                ReturnValue(0)
            }
            IfCondition NotEqual(HasWord(val, "append"), 0) ThenBlock: {
                DdConfig.fl_append = 1
            }
            IfCondition NotEqual(HasWord(val, "seek_bytes"), 0) ThenBlock: {
                DdConfig.seek_bytes = 1
            }
            IfCondition NotEqual(HasWord(val, "notrunc"), 0) ThenBlock: {
                DdConfig.fl_notrunc = 1
            }
            IfCondition NotEqual(HasWord(val, "nolinks"), 0) ThenBlock: {
                DdConfig.fl_nolinks_out = 1
            }
            IfCondition NotEqual(HasWord(val, "nocache"), 0) ThenBlock: {
                DdConfig.fl_nocache_out = 1
            }
            IfCondition NotEqual(HasWord(val, "sync"), 0) ThenBlock: {
                DdConfig.fl_osync = 1
            }
            ReturnValue(0)
        }
        is_num = 0
        IfCondition NotEqual(KeyEq(arg, eq, "ibs"), 0) ThenBlock: {
            is_num = 1
        }
        IfCondition NotEqual(KeyEq(arg, eq, "obs"), 0) ThenBlock: {
            is_num = 2
        }
        IfCondition NotEqual(KeyEq(arg, eq, "bs"), 0) ThenBlock: {
            is_num = 3
        }
        IfCondition NotEqual(KeyEq(arg, eq, "count"), 0) ThenBlock: {
            is_num = 4
        }
        IfCondition NotEqual(KeyEq(arg, eq, "skip"), 0) ThenBlock: {
            is_num = 5
        }
        IfCondition NotEqual(KeyEq(arg, eq, "iseek"), 0) ThenBlock: {
            is_num = 5
        }
        IfCondition NotEqual(KeyEq(arg, eq, "seek"), 0) ThenBlock: {
            is_num = 6
        }
        IfCondition NotEqual(KeyEq(arg, eq, "oseek"), 0) ThenBlock: {
            is_num = 6
        }
        IfCondition NotEqual(KeyEq(arg, eq, "cbs"), 0) ThenBlock: {
            is_num = 7
        }
        IfCondition EqualTo(is_num, 0) ThenBlock: {
            WriteErr("dd: unrecognized operand '", 26)
            nlen = GetStringLength(arg)
            WriteErr(arg, nlen)
            WriteErr("'\n", 2)
            DdConfig.io_error = 1
            ReturnValue(0)
        }
        ParseDDNumber(val)
        IfCondition EqualTo(DdConfig.parse_ok, 0) ThenBlock: {
            BadNumber(val)
            ReturnValue(0)
        }
        n = DdConfig.parse_val
        has_b = ContainsByte(val, 66)
        IfCondition EqualTo(is_num, 1) ThenBlock: {
            IfCondition LessThan(n, 1) ThenBlock: {
                BadNumber(val)
                ReturnValue(0)
            }
            IfCondition GreaterThan(n, 33554432) ThenBlock: {
                BadNumber(val)
                ReturnValue(0)
            }
            DdConfig.ibs = n
        }
        IfCondition EqualTo(is_num, 2) ThenBlock: {
            IfCondition LessThan(n, 1) ThenBlock: {
                BadNumber(val)
                ReturnValue(0)
            }
            IfCondition GreaterThan(n, 33554432) ThenBlock: {
                BadNumber(val)
                ReturnValue(0)
            }
            DdConfig.obs = n
        }
        IfCondition EqualTo(is_num, 3) ThenBlock: {
            IfCondition LessThan(n, 1) ThenBlock: {
                BadNumber(val)
                ReturnValue(0)
            }
            IfCondition GreaterThan(n, 33554432) ThenBlock: {
                BadNumber(val)
                ReturnValue(0)
            }
            DdConfig.bs = n
            DdConfig.bs_set = 1
        }
        IfCondition EqualTo(is_num, 4) ThenBlock: {
            DdConfig.count = n
            DdConfig.count_set = 1
            IfCondition NotEqual(has_b, 0) ThenBlock: {
                DdConfig.count_bytes = 1
            }
        }
        IfCondition EqualTo(is_num, 5) ThenBlock: {
            DdConfig.skip = n
            IfCondition NotEqual(has_b, 0) ThenBlock: {
                DdConfig.skip_bytes = 1
            }
        }
        IfCondition EqualTo(is_num, 6) ThenBlock: {
            DdConfig.seek = n
            IfCondition NotEqual(has_b, 0) ThenBlock: {
                DdConfig.seek_bytes = 1
            }
        }
        IfCondition EqualTo(is_num, 7) ThenBlock: {
            DdConfig.cbs = n
        }
    }
}

Function.PrintHelp {
    Body: {
        WriteOut("Usage: dd [OPERAND]...\n", 23)
        WriteOut("Copy a file, converting and formatting according to the operands.\n\n", 67)
        WriteOut("  bs=BYTES        read and write up to BYTES bytes at a time\n", 61)
        WriteOut("  cbs=BYTES       convert BYTES bytes at a time\n", 48)
        WriteOut("  conv=CONVS      convert the file as per the comma separated symbol list\n", 74)
        WriteOut("  count=N         copy only N input blocks\n", 43)
        WriteOut("  ibs=BYTES       read up to BYTES bytes at a time\n", 51)
        WriteOut("  if=FILE         read from FILE instead of stdin\n", 50)
        WriteOut("  iflag=FLAGS     read as per the comma separated symbol list\n", 62)
        WriteOut("  obs=BYTES       write BYTES bytes at a time\n", 46)
        WriteOut("  of=FILE         write to FILE instead of stdout\n", 50)
        WriteOut("  oflag=FLAGS     write as per the comma separated symbol list\n", 63)
        WriteOut("  seek=N          skip N obs-sized blocks at start of output\n", 61)
        WriteOut("  skip=N          skip N ibs-sized blocks at start of input\n", 60)
        WriteOut("  status=LEVEL    none, noxfer, or progress\n", 44)
        WriteOut("      --help      display this help and exit\n", 45)
        WriteOut("      --version   output version information and exit\n", 54)
    }
}

Function.PrintVersion {
    Body: {
        WriteOut("dd (AILANG coreutils) 9.4\n", 26)
    }
}

Function.PrintStats {
    Body: {
        WriteNum(DdConfig.in_full)
        WriteErr("+", 1)
        WriteNum(DdConfig.in_part)
        WriteErr(" records in\n", 12)
        WriteNum(DdConfig.out_full)
        WriteErr("+", 1)
        WriteNum(DdConfig.out_part)
        WriteErr(" records out\n", 13)
        IfCondition EqualTo(DdConfig.trunc_recs, 1) ThenBlock: {
            WriteErr("1 truncated record\n", 19)
        }
        IfCondition GreaterThan(DdConfig.trunc_recs, 1) ThenBlock: {
            WriteNum(DdConfig.trunc_recs)
            WriteErr(" truncated records\n", 19)
        }
        IfCondition NotEqual(DdConfig.status, 2) ThenBlock: {
            WriteXfer()
        }
    }
}

Function.ScaleExp {
    Input: n: Integer
    Input: base: Integer
    Body: {
        exp = 0
        den = 1
        one = 1
        WhileLoop LessThan(exp, 6) {
            lim = Divide(9223372036854775807, base)
            IfCondition GreaterThan(den, lim) ThenBlock: {
                BreakLoop
            }
            nxt = Multiply(den, base)
            IfCondition LessThan(n, nxt) ThenBlock: {
                BreakLoop
            }
            den = nxt
            exp = Add(exp, one)
        }
        half = Divide(den, 2)
        num = Multiply(n, 10)
        num = Add(num, half)
        tenths = Divide(num, den)
        limit = Multiply(base, 10)
        IfCondition GreaterEqual(tenths, limit) ThenBlock: {
            exp = Add(exp, one)
            bump = Divide(base, 2)
            tenths = Divide(Add(tenths, bump), base)
        }
        DdConfig.human_exp = exp
        DdConfig.human_tenths = tenths
    }
}

Function.WriteTenths {
    Input: tenths: Integer
    Body: {
        IfCondition GreaterEqual(tenths, 100) ThenBlock: {
            show = Divide(Add(tenths, 5), 10)
            WriteNum(show)
            ReturnValue(0)
        }
        whole = Divide(tenths, 10)
        frac = Modulo(tenths, 10)
        WriteNum(whole)
        WriteErr(".", 1)
        WriteNum(frac)
    }
}

Function.WriteSuffix {
    Input: exp: Integer
    Input: iec: Integer
    Body: {
        IfCondition EqualTo(iec, 0) ThenBlock: {
            IfCondition EqualTo(exp, 1) ThenBlock: {
                WriteErr("kB", 2)
            }
            IfCondition EqualTo(exp, 2) ThenBlock: {
                WriteErr("MB", 2)
            }
            IfCondition EqualTo(exp, 3) ThenBlock: {
                WriteErr("GB", 2)
            }
            IfCondition EqualTo(exp, 4) ThenBlock: {
                WriteErr("TB", 2)
            }
            IfCondition EqualTo(exp, 5) ThenBlock: {
                WriteErr("PB", 2)
            }
            IfCondition EqualTo(exp, 6) ThenBlock: {
                WriteErr("EB", 2)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(exp, 1) ThenBlock: {
            WriteErr("KiB", 3)
        }
        IfCondition EqualTo(exp, 2) ThenBlock: {
            WriteErr("MiB", 3)
        }
        IfCondition EqualTo(exp, 3) ThenBlock: {
            WriteErr("GiB", 3)
        }
        IfCondition EqualTo(exp, 4) ThenBlock: {
            WriteErr("TiB", 3)
        }
        IfCondition EqualTo(exp, 5) ThenBlock: {
            WriteErr("PiB", 3)
        }
        IfCondition EqualTo(exp, 6) ThenBlock: {
            WriteErr("EiB", 3)
        }
    }
}

Function.WriteXfer {
    Body: {
        n = DdConfig.bytes_copied
        WriteNum(n)
        IfCondition EqualTo(n, 1) ThenBlock: {
            WriteErr(" byte", 5)
        } ElseBlock: {
            WriteErr(" bytes", 6)
        }
        ScaleExp(n, 1000)
        si_e = DdConfig.human_exp
        si_t = DdConfig.human_tenths
        ScaleExp(n, 1024)
        ie_e = DdConfig.human_exp
        ie_t = DdConfig.human_tenths
        IfCondition GreaterThan(si_e, 0) ThenBlock: {
            WriteErr(" (", 2)
            WriteTenths(si_t)
            WriteErr(" ", 1)
            WriteSuffix(si_e, 0)
            IfCondition GreaterThan(ie_e, 0) ThenBlock: {
                WriteErr(", ", 2)
                WriteTenths(ie_t)
                WriteErr(" ", 1)
                WriteSuffix(ie_e, 1)
            }
            WriteErr(")", 1)
        }
        WriteErr(" copied, 0 s, 0 B/s\n", 20)
    }
}

Function.DropCache {
    Input: fd: Integer
    Body: {
        whole = And(NotEqual(DdConfig.count_set, 0), EqualTo(DdConfig.count, 0))
        do_it = Or(NotEqual(whole, 0), NotEqual(DdConfig.hit_eof, 0))
        IfCondition EqualTo(do_it, 0) ThenBlock: {
            ReturnValue(0)
        }
        rc = SystemCall(221, fd, 0, 0, 4)
        IfCondition LessThan(rc, 0) ThenBlock: {
            DdConfig.io_error = 1
        }
    }
}

Function.CheckFd {
    Input: fd: Integer
    Input: want_dir: Integer
    Input: want_nolinks: Integer
    Body: {
        need = Or(NotEqual(want_dir, 0), NotEqual(want_nolinks, 0))
        IfCondition EqualTo(need, 0) ThenBlock: {
            ReturnValue(0)
        }
        st = Allocate(512)
        rc = SystemCall(5, fd, st)
        IfCondition LessThan(rc, 0) ThenBlock: {
            Deallocate(st, 512)
            DdConfig.io_error = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(want_dir, 0) ThenBlock: {
            mode = LoadU32(st, 24)
            typ = BitwiseAnd(mode, 61440)
            IfCondition NotEqual(typ, 16384) ThenBlock: {
                DdConfig.io_error = 1
            }
        }
        IfCondition NotEqual(want_nolinks, 0) ThenBlock: {
            nlink = LoadU32(st, 16)
            IfCondition GreaterThan(nlink, 1) ThenBlock: {
                DdConfig.io_error = 1
            }
        }
        Deallocate(st, 512)
    }
}

Function.ReadBlock {
    Input: buf: Address
    Output: Integer
    Body: {
        want = DdConfig.ibs
        left = DdConfig.bytes_left
        IfCondition EqualTo(left, 0) ThenBlock: {
            ReturnValue(0)
        }
        limited = And(GreaterThan(left, 0), LessThan(left, want))
        IfCondition NotEqual(limited, 0) ThenBlock: {
            want = left
        }
        got = 0
        one = 1
        WhileLoop LessThan(got, want) {
            need = Subtract(want, got)
            dest = Add(buf, got)
            n = SystemCall(0, DdConfig.in_fd, dest, need)
            IfCondition LessThan(n, 0) ThenBlock: {
                DdConfig.io_error = 1
                ReturnValue(-1)
            }
            IfCondition EqualTo(n, 0) ThenBlock: {
                DdConfig.hit_eof = 1
                BreakLoop
            }
            got = Add(got, n)
            IfCondition EqualTo(DdConfig.fl_fullblock, 0) ThenBlock: {
                BreakLoop
            }
        }
        IfCondition GreaterThan(got, 0) ThenBlock: {
            IfCondition GreaterThan(left, 0) ThenBlock: {
                DdConfig.bytes_left = Subtract(left, got)
            }
        }
        ReturnValue(got)
    }
}

Function.SwabBuf {
    Input: buf: Address
    Input: n: Integer
    Body: {
        i = 0
        two = 2
        one = 1
        WhileLoop LessThan(Add(i, one), n) {
            j = Add(i, one)
            a = GetByte(buf, i)
            b = GetByte(buf, j)
            SetByte(buf, i, b)
            SetByte(buf, j, a)
            i = Add(i, two)
        }
    }
}

Function.IsNul {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            b = GetByte(buf, i)
            IfCondition NotEqual(b, 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        ReturnValue(1)
    }
}

Function.WriteChunk {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(DdConfig.conv_sparse, 0) ThenBlock: {
            z = IsNul(buf, n)
            IfCondition NotEqual(z, 0) ThenBlock: {
                off = SystemCall(8, DdConfig.out_fd, n, 1)
                IfCondition GreaterEqual(off, 0) ThenBlock: {
                    DdConfig.bytes_copied = Add(DdConfig.bytes_copied, n)
                    DdConfig.last_seek = 1
                    ReturnValue(n)
                }
                DdConfig.conv_sparse = 0
            }
        }
        wr = SystemCall(1, DdConfig.out_fd, buf, n)
        DdConfig.last_seek = 0
        IfCondition LessThan(wr, 0) ThenBlock: {
            DdConfig.io_error = 1
            ReturnValue(-1)
        }
        IfCondition LessThan(wr, n) ThenBlock: {
            DdConfig.io_error = 1
        }
        IfCondition GreaterThan(wr, 0) ThenBlock: {
            DdConfig.bytes_copied = Add(DdConfig.bytes_copied, wr)
        }
        ReturnValue(wr)
    }
}

Function.PutOut {
    Input: outbuf: Address
    Input: b: Integer
    Body: {
        IfCondition NotEqual(DdConfig.io_error, 0) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        slot = DdConfig.out_fill
        SetByte(outbuf, slot, b)
        slot = Add(slot, one)
        DdConfig.out_fill = slot
        IfCondition EqualTo(slot, DdConfig.obs) ThenBlock: {
            wr = WriteChunk(outbuf, DdConfig.obs)
            IfCondition LessThan(wr, DdConfig.obs) ThenBlock: {
                DdConfig.io_error = 1
                ReturnValue(0)
            }
            DdConfig.out_full = Add(DdConfig.out_full, one)
            DdConfig.out_fill = 0
        }
    }
}

Function.AppendOut {
    Input: src: Address
    Input: n: Integer
    Input: outbuf: Address
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            IfCondition NotEqual(DdConfig.io_error, 0) ThenBlock: {
                ReturnValue(0)
            }
            b = GetByte(src, i)
            PutOut(outbuf, b)
            i = Add(i, one)
        }
    }
}

Function.WriteDirect {
    Input: buf: Address
    Input: n: Integer
    Body: {
        wr = WriteChunk(buf, n)
        one = 1
        IfCondition LessThan(wr, n) ThenBlock: {
            DdConfig.io_error = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(n, DdConfig.ibs) ThenBlock: {
            DdConfig.out_full = Add(DdConfig.out_full, one)
        } ElseBlock: {
            DdConfig.out_part = Add(DdConfig.out_part, one)
        }
    }
}

Function.ApplyBlock {
    Input: buf: Address
    Input: n: Integer
    Input: outbuf: Address
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            IfCondition NotEqual(DdConfig.io_error, 0) ThenBlock: {
                ReturnValue(0)
            }
            c = GetByte(buf, i)
            IfCondition EqualTo(c, 10) ThenBlock: {
                WhileLoop LessThan(DdConfig.col, DdConfig.cbs) {
                    PutOut(outbuf, 32)
                    DdConfig.col = Add(DdConfig.col, one)
                }
                DdConfig.col = 0
            } ElseBlock: {
                IfCondition EqualTo(DdConfig.col, DdConfig.cbs) ThenBlock: {
                    DdConfig.trunc_recs = Add(DdConfig.trunc_recs, one)
                }
                IfCondition LessThan(DdConfig.col, DdConfig.cbs) ThenBlock: {
                    PutOut(outbuf, c)
                }
                DdConfig.col = Add(DdConfig.col, one)
            }
            i = Add(i, one)
        }
    }
}

Function.ApplyUnblock {
    Input: buf: Address
    Input: n: Integer
    Input: outbuf: Address
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            IfCondition NotEqual(DdConfig.io_error, 0) ThenBlock: {
                ReturnValue(0)
            }
            c = GetByte(buf, i)
            col = DdConfig.col
            nxt = Add(col, one)
            DdConfig.col = nxt
            IfCondition GreaterEqual(col, DdConfig.cbs) ThenBlock: {
                DdConfig.col = 0
                DdConfig.pending_sp = 0
                PutOut(outbuf, 10)
            } ElseBlock: {
                IfCondition EqualTo(c, 32) ThenBlock: {
                    DdConfig.pending_sp = Add(DdConfig.pending_sp, one)
                } ElseBlock: {
                    WhileLoop GreaterThan(DdConfig.pending_sp, 0) {
                        PutOut(outbuf, 32)
                        DdConfig.pending_sp = Subtract(DdConfig.pending_sp, one)
                    }
                    PutOut(outbuf, c)
                }
                i = Add(i, one)
            }
        }
    }
}

Function.FinishConv {
    Input: outbuf: Address
    Body: {
        one = 1
        IfCondition NotEqual(DdConfig.conv_block, 0) ThenBlock: {
            IfCondition GreaterThan(DdConfig.col, 0) ThenBlock: {
                WhileLoop LessThan(DdConfig.col, DdConfig.cbs) {
                    PutOut(outbuf, 32)
                    DdConfig.col = Add(DdConfig.col, one)
                }
            }
        }
        IfCondition NotEqual(DdConfig.conv_unblock, 0) ThenBlock: {
            IfCondition GreaterThan(DdConfig.col, 0) ThenBlock: {
                PutOut(outbuf, 10)
            }
        }
    }
}

Function.HexNib {
    Input: c: Integer
    Output: Integer
    Body: {
        dig = 0
        is_d = And(GreaterEqual(c, 48), LessEqual(c, 57))
        IfCondition NotEqual(is_d, 0) ThenBlock: {
            dig = Subtract(c, 48)
        }
        is_a = And(GreaterEqual(c, 97), LessEqual(c, 102))
        IfCondition NotEqual(is_a, 0) ThenBlock: {
            dig = Subtract(c, 87)
        }
        ReturnValue(dig)
    }
}

Function.BuildAscii {
    Input: hex: Address
    Body: {
        tbl = Allocate(256)
        i = 0
        one = 1
        WhileLoop LessThan(i, 256) {
            hpos = Multiply(i, 2)
            lpos = Add(hpos, one)
            hc = GetByte(hex, hpos)
            lc = GetByte(hex, lpos)
            hi = HexNib(hc)
            lo = HexNib(lc)
            hi16 = Multiply(hi, 16)
            val = Add(hi16, lo)
            SetByte(tbl, i, val)
            i = Add(i, one)
        }
        DdConfig.xlate = tbl
    }
}

Function.ApplyAscii {
    Input: buf: Address
    Input: n: Integer
    Body: {
        IfCondition EqualTo(DdConfig.conv_ascii, 0) ThenBlock: {
            ReturnValue(0)
        }
        tbl = DdConfig.xlate
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            b = GetByte(buf, i)
            v = GetByte(tbl, b)
            SetByte(buf, i, v)
            i = Add(i, one)
        }
    }
}

Function.WriteInName {
    Body: {
        IfCondition NotEqual(DdConfig.if_path, 0) ThenBlock: {
            nlen = GetStringLength(DdConfig.if_path)
            WriteErr(DdConfig.if_path, nlen)
            ReturnValue(0)
        }
        WriteErr("standard input", 14)
    }
}

Function.WarnSkipShort {
    Body: {
        IfCondition EqualTo(DdConfig.status, 1) ThenBlock: {
            ReturnValue(0)
        }
        WriteErr("dd: '", 5)
        WriteInName()
        WriteErr("': cannot skip to specified offset\n", 35)
    }
}

Function.FailSkip {
    Body: {
        WriteErr("dd: '", 5)
        WriteInName()
        WriteErr("': cannot skip: Invalid argument\n", 33)
        DdConfig.io_error = 1
    }
}

Function.SkipInput {
    Body: {
        amt = DdConfig.skip
        IfCondition EqualTo(DdConfig.skip_bytes, 0) ThenBlock: {
            amt = Multiply(DdConfig.skip, DdConfig.ibs)
        }
        IfCondition EqualTo(amt, 0) ThenBlock: {
            ReturnValue(0)
        }
        off = SystemCall(8, DdConfig.in_fd, amt, 1)
        IfCondition GreaterEqual(off, 0) ThenBlock: {
            st = Allocate(512)
            rc = SystemCall(5, DdConfig.in_fd, st)
            IfCondition GreaterEqual(rc, 0) ThenBlock: {
                mode = LoadU32(st, 24)
                typ = BitwiseAnd(mode, 61440)
                sz = LoadU64(st, 48)
                past = And(EqualTo(typ, 32768), GreaterThan(off, sz))
                IfCondition NotEqual(past, 0) ThenBlock: {
                    WarnSkipShort()
                }
            }
            Deallocate(st, 512)
            ReturnValue(0)
        }
        endp = SystemCall(8, DdConfig.in_fd, 0, 2)
        IfCondition GreaterEqual(endp, 0) ThenBlock: {
            FailSkip()
            ReturnValue(0)
        }
        IfCondition GreaterThan(amt, 1048576) ThenBlock: {
            FailSkip()
            ReturnValue(0)
        }
        buf = Allocate(DdConfig.ibs)
        left = amt
        hit = 0
        WhileLoop GreaterThan(left, 0) {
            chunk = DdConfig.ibs
            IfCondition LessThan(left, chunk) ThenBlock: {
                chunk = left
            }
            n = SystemCall(0, DdConfig.in_fd, buf, chunk)
            IfCondition LessEqual(n, 0) ThenBlock: {
                hit = 1
                BreakLoop
            }
            left = Subtract(left, n)
        }
        Deallocate(buf, DdConfig.ibs)
        short = And(NotEqual(hit, 0), GreaterThan(left, 0))
        IfCondition NotEqual(short, 0) ThenBlock: {
            WarnSkipShort()
        }
    }
}

Function.SeekOutput {
    Body: {
        amt = DdConfig.seek
        IfCondition EqualTo(DdConfig.seek_bytes, 0) ThenBlock: {
            amt = Multiply(DdConfig.seek, DdConfig.obs)
        }
        IfCondition EqualTo(amt, 0) ThenBlock: {
            ReturnValue(0)
        }
        off = SystemCall(8, DdConfig.out_fd, amt, 1)
        IfCondition LessThan(off, 0) ThenBlock: {
            IfCondition GreaterThan(amt, 1048576) ThenBlock: {
                DdConfig.io_error = 1
                ReturnValue(0)
            }
            buf = Allocate(amt)
            left = amt
            WhileLoop GreaterThan(left, 0) {
                n = SystemCall(0, DdConfig.out_fd, buf, left)
                IfCondition LessEqual(n, 0) ThenBlock: {
                    BreakLoop
                }
                left = Subtract(left, n)
            }
            Deallocate(buf, amt)
            IfCondition GreaterThan(left, 0) ThenBlock: {
                DdConfig.io_error = 1
                ReturnValue(0)
            }
            DdConfig.did_seek = 1
            DdConfig.seek_pos = amt
            ReturnValue(0)
        }
        DdConfig.did_seek = 1
        DdConfig.seek_pos = off
    }
}

Function.ApplyAppend {
    Body: {
        IfCondition EqualTo(DdConfig.fl_append, 0) ThenBlock: {
            ReturnValue(0)
        }
        old = SystemCall(72, DdConfig.out_fd, 3)
        IfCondition LessThan(old, 0) ThenBlock: {
            ReturnValue(0)
        }
        bit = BitwiseAnd(old, 1024)
        IfCondition NotEqual(bit, 0) ThenBlock: {
            ReturnValue(0)
        }
        neu = Add(old, 1024)
        SystemCall(72, DdConfig.out_fd, 4, neu)
    }
}

Function.TruncateSeek {
    Body: {
        IfCondition EqualTo(DdConfig.opened_out, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(DdConfig.fl_notrunc, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(DdConfig.seek, 0) ThenBlock: {
            ReturnValue(0)
        }
        amt = DdConfig.seek
        IfCondition EqualTo(DdConfig.seek_bytes, 0) ThenBlock: {
            amt = Multiply(DdConfig.seek, DdConfig.obs)
        }
        tr = SystemCall(77, DdConfig.out_fd, amt)
        IfCondition GreaterEqual(tr, 0) ThenBlock: {
            ReturnValue(0)
        }
        st = Allocate(512)
        rc = SystemCall(5, DdConfig.out_fd, st)
        reg = 0
        IfCondition GreaterEqual(rc, 0) ThenBlock: {
            mode = LoadU32(st, 24)
            typ = BitwiseAnd(mode, 61440)
            IfCondition EqualTo(typ, 32768) ThenBlock: {
                reg = 1
            }
        }
        Deallocate(st, 512)
        IfCondition NotEqual(reg, 0) ThenBlock: {
            DdConfig.io_error = 1
        }
    }
}

Function.ExtendSeek {
    Body: {
        quiet = And(EqualTo(DdConfig.out_full, 0), EqualTo(DdConfig.out_part, 0))
        hole = And(NotEqual(DdConfig.did_seek, 0), quiet)
        need = Or(NotEqual(hole, 0), NotEqual(DdConfig.last_seek, 0))
        IfCondition EqualTo(need, 0) ThenBlock: {
            ReturnValue(0)
        }
        st = Allocate(512)
        rc = SystemCall(5, DdConfig.out_fd, st)
        IfCondition LessThan(rc, 0) ThenBlock: {
            Deallocate(st, 512)
            DdConfig.io_error = 1
            ReturnValue(0)
        }
        mode = LoadU32(st, 24)
        typ = BitwiseAnd(mode, 61440)
        sz = LoadU64(st, 48)
        Deallocate(st, 512)
        IfCondition NotEqual(typ, 32768) ThenBlock: {
            ReturnValue(0)
        }
        pos = SystemCall(8, DdConfig.out_fd, 0, 1)
        IfCondition LessThan(pos, 0) ThenBlock: {
            pos = DdConfig.seek_pos
        }
        IfCondition LessThan(sz, pos) ThenBlock: {
            tr = SystemCall(77, DdConfig.out_fd, pos)
            IfCondition LessThan(tr, 0) ThenBlock: {
                DdConfig.io_error = 1
            }
        }
    }
}

Function.ArgEq {
    Input: s: Address
    Input: name: Address
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, 32) {
            a = GetByte(s, i)
            b = GetByte(name, i)
            IfCondition NotEqual(a, b) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(a, 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
    IfCondition LessThan(fd, 0) ThenBlock: {
        WriteErr("dd: cannot read arguments\n", 26)
        SystemCall(60, 1)
    }
    args = Allocate(8192)
    nread = SystemCall(0, fd, args, 8191)
    SystemCall(3, fd)
    IfCondition LessEqual(nread, 0) ThenBlock: {
        WriteErr("dd: cannot read arguments\n", 26)
        SystemCall(60, 1)
    }
    SetByte(args, nread, 0)
    pos = 0
    one = 1
    WhileLoop NotEqual(GetByte(args, pos), 0) {
        pos = Add(pos, one)
    }
    pos = Add(pos, one)
    WhileLoop LessThan(pos, 8190) {
        ch = GetByte(args, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            BreakLoop
        }
        arg = Add(args, pos)
        IfCondition NotEqual(ArgEq(arg, "--help"), 0) ThenBlock: {
            PrintHelp()
            SystemCall(60, 0)
        }
        IfCondition NotEqual(ArgEq(arg, "--version"), 0) ThenBlock: {
            PrintVersion()
            SystemCall(60, 0)
        }
        IfCondition EqualTo(ArgEq(arg, "--"), 0) ThenBlock: {
            ParseOperand(arg)
        }
        WhileLoop NotEqual(GetByte(args, pos), 0) {
            pos = Add(pos, one)
        }
        pos = Add(pos, one)
        IfCondition NotEqual(DdConfig.io_error, 0) ThenBlock: {
            SystemCall(60, 1)
        }
    }
    IfCondition NotEqual(DdConfig.bs_set, 0) ThenBlock: {
        DdConfig.ibs = DdConfig.bs
        DdConfig.obs = DdConfig.bs
    }
    IfCondition EqualTo(DdConfig.ibs, 0) ThenBlock: {
        DdConfig.ibs = 512
    }
    IfCondition EqualTo(DdConfig.obs, 0) ThenBlock: {
        DdConfig.obs = 512
    }
    IfCondition NotEqual(DdConfig.count_set, 0) ThenBlock: {
        IfCondition NotEqual(DdConfig.count_bytes, 0) ThenBlock: {
            DdConfig.bytes_left = DdConfig.count
        } ElseBlock: {
            IfCondition EqualTo(DdConfig.count, 0) ThenBlock: {
                DdConfig.bytes_left = 0
            } ElseBlock: {
                DdConfig.records_left = DdConfig.count
            }
        }
    }
    IfCondition EqualTo(DdConfig.cbs, 0) ThenBlock: {
        DdConfig.conv_block = 0
        DdConfig.conv_unblock = 0
    }
    both = And(NotEqual(DdConfig.conv_block, 0), NotEqual(DdConfig.conv_unblock, 0))
    IfCondition NotEqual(both, 0) ThenBlock: {
        WriteErr("dd: cannot combine block and unblock\n", 37)
        SystemCall(60, 1)
    }
    IfCondition NotEqual(DdConfig.conv_ascii, 0) ThenBlock: {
        BuildAscii("")
    }
    IfCondition NotEqual(DdConfig.if_path, 0) ThenBlock: {
        inflag = 0
        IfCondition NotEqual(DdConfig.fl_nofollow, 0) ThenBlock: {
            inflag = Add(inflag, 131072)
        }
        IfCondition NotEqual(DdConfig.fl_directory, 0) ThenBlock: {
            inflag = Add(inflag, 65536)
        }
        IfCondition NotEqual(DdConfig.fl_noatime, 0) ThenBlock: {
            inflag = Add(inflag, 262144)
        }
        inf = SystemCall(2, DdConfig.if_path, inflag, 0)
        IfCondition LessThan(inf, 0) ThenBlock: {
            WriteErr("dd: failed to open '", 20)
            nlen = GetStringLength(DdConfig.if_path)
            WriteErr(DdConfig.if_path, nlen)
            WriteErr("'\n", 2)
            SystemCall(60, 1)
        }
        DdConfig.in_fd = inf
        DdConfig.opened_in = 1
    }
    IfCondition NotEqual(DdConfig.of_path, 0) ThenBlock: {
        outflag = 65
        IfCondition GreaterThan(DdConfig.seek, 0) ThenBlock: {
            outflag = 66
        }
        use_trunc = 1
        IfCondition NotEqual(DdConfig.fl_notrunc, 0) ThenBlock: {
            use_trunc = 0
        }
        IfCondition GreaterThan(DdConfig.seek, 0) ThenBlock: {
            use_trunc = 0
        }
        IfCondition NotEqual(use_trunc, 0) ThenBlock: {
            outflag = Add(outflag, 512)
        }
        IfCondition NotEqual(DdConfig.fl_append, 0) ThenBlock: {
            outflag = Add(outflag, 1024)
        }
        IfCondition NotEqual(DdConfig.fl_osync, 0) ThenBlock: {
            outflag = Add(outflag, 1052672)
        }
        outf = SystemCall(2, DdConfig.of_path, outflag, 438)
        IfCondition LessThan(outf, 0) ThenBlock: {
            WriteErr("dd: failed to open '", 20)
            nlen = GetStringLength(DdConfig.of_path)
            WriteErr(DdConfig.of_path, nlen)
            WriteErr("'\n", 2)
            SystemCall(60, 1)
        }
        DdConfig.out_fd = outf
        DdConfig.opened_out = 1
    }
    CheckFd(DdConfig.in_fd, DdConfig.fl_directory, DdConfig.fl_nolinks_in)
    CheckFd(DdConfig.out_fd, 0, DdConfig.fl_nolinks_out)
    IfCondition NotEqual(DdConfig.io_error, 0) ThenBlock: {
        SystemCall(60, 1)
    }
    ApplyAppend()
    TruncateSeek()
    IfCondition NotEqual(DdConfig.io_error, 0) ThenBlock: {
        SystemCall(60, 1)
    }
    SkipInput()
    IfCondition NotEqual(DdConfig.io_error, 0) ThenBlock: {
        SystemCall(60, 1)
    }
    SeekOutput()
    IfCondition NotEqual(DdConfig.io_error, 0) ThenBlock: {
        SystemCall(60, 1)
    }
    do_copy = 1
    zero_count = And(NotEqual(DdConfig.count_set, 0), EqualTo(DdConfig.bytes_left, 0))
    IfCondition NotEqual(zero_count, 0) ThenBlock: {
        do_copy = 0
    }
    IfCondition NotEqual(do_copy, 0) ThenBlock: {
    inbuf = Allocate(DdConfig.ibs)
    outbuf = Allocate(DdConfig.obs)
    one = 1
    use_two = 0
    IfCondition EqualTo(DdConfig.bs_set, 0) ThenBlock: {
        use_two = 1
    }
    IfCondition NotEqual(DdConfig.conv_swab, 0) ThenBlock: {
        use_two = 1
    }
    IfCondition NotEqual(DdConfig.conv_block, 0) ThenBlock: {
        use_two = 1
    }
    IfCondition NotEqual(DdConfig.conv_unblock, 0) ThenBlock: {
        use_two = 1
    }
    WhileLoop EqualTo(DdConfig.io_error, 0) {
        got = ReadBlock(inbuf)
        IfCondition LessThan(got, 0) ThenBlock: {
            BreakLoop
        }
        IfCondition EqualTo(got, 0) ThenBlock: {
            BreakLoop
        }
        IfCondition EqualTo(got, DdConfig.ibs) ThenBlock: {
            DdConfig.in_full = Add(DdConfig.in_full, one)
        } ElseBlock: {
            DdConfig.in_part = Add(DdConfig.in_part, one)
        }
        IfCondition GreaterThan(DdConfig.records_left, 0) ThenBlock: {
            DdConfig.records_left = Subtract(DdConfig.records_left, one)
            IfCondition EqualTo(DdConfig.records_left, 0) ThenBlock: {
                DdConfig.bytes_left = 0
            }
        }
        nout = got
        padch = 0
        IfCondition NotEqual(DdConfig.conv_block, 0) ThenBlock: {
            padch = 32
        }
        IfCondition NotEqual(DdConfig.conv_unblock, 0) ThenBlock: {
            padch = 32
        }
        IfCondition NotEqual(DdConfig.conv_sync, 0) ThenBlock: {
            IfCondition LessThan(got, DdConfig.ibs) ThenBlock: {
                pad = got
                WhileLoop LessThan(pad, DdConfig.ibs) {
                    SetByte(inbuf, pad, padch)
                    pad = Add(pad, one)
                }
                nout = DdConfig.ibs
            }
        }
        ApplyAscii(inbuf, nout)
        IfCondition NotEqual(DdConfig.conv_swab, 0) ThenBlock: {
            SwabBuf(inbuf, nout)
        }
        mode = 4
        IfCondition NotEqual(use_two, 0) ThenBlock: {
            mode = 3
        }
        IfCondition NotEqual(DdConfig.conv_unblock, 0) ThenBlock: {
            mode = 2
        }
        IfCondition NotEqual(DdConfig.conv_block, 0) ThenBlock: {
            mode = 1
        }
        IfCondition EqualTo(mode, 1) ThenBlock: {
            ApplyBlock(inbuf, nout, outbuf)
        }
        IfCondition EqualTo(mode, 2) ThenBlock: {
            ApplyUnblock(inbuf, nout, outbuf)
        }
        IfCondition EqualTo(mode, 3) ThenBlock: {
            AppendOut(inbuf, nout, outbuf)
        }
        IfCondition EqualTo(mode, 4) ThenBlock: {
            WriteDirect(inbuf, nout)
        }
        IfCondition EqualTo(DdConfig.status, 3) ThenBlock: {
            IfCondition EqualTo(DdConfig.io_error, 0) ThenBlock: {
                WriteXfer()
            }
        }
    }
    IfCondition EqualTo(DdConfig.io_error, 0) ThenBlock: {
        FinishConv(outbuf)
    }
    IfCondition GreaterThan(DdConfig.out_fill, 0) ThenBlock: {
        wr = WriteChunk(outbuf, DdConfig.out_fill)
        IfCondition LessThan(wr, DdConfig.out_fill) ThenBlock: {
            DdConfig.io_error = 1
        } ElseBlock: {
            DdConfig.out_part = Add(DdConfig.out_part, one)
        }
    }
    Deallocate(inbuf, DdConfig.ibs)
    Deallocate(outbuf, DdConfig.obs)
    }
    IfCondition NotEqual(DdConfig.xlate, 0) ThenBlock: {
        Deallocate(DdConfig.xlate, 256)
    }
    ExtendSeek()
    IfCondition NotEqual(DdConfig.conv_fdatasync, 0) ThenBlock: {
        sy = SystemCall(75, DdConfig.out_fd)
        IfCondition LessThan(sy, 0) ThenBlock: {
            DdConfig.io_error = 1
        }
    }
    IfCondition NotEqual(DdConfig.fl_nocache_in, 0) ThenBlock: {
        DropCache(DdConfig.in_fd)
    }
    IfCondition NotEqual(DdConfig.fl_nocache_out, 0) ThenBlock: {
        DropCache(DdConfig.out_fd)
    }
    IfCondition NotEqual(DdConfig.status, 1) ThenBlock: {
        PrintStats()
    }
    IfCondition NotEqual(DdConfig.opened_in, 0) ThenBlock: {
        SystemCall(3, DdConfig.in_fd)
    }
    IfCondition NotEqual(DdConfig.opened_out, 0) ThenBlock: {
        SystemCall(3, DdConfig.out_fd)
    }
    IfCondition NotEqual(DdConfig.io_error, 0) ThenBlock: {
        SystemCall(60, 1)
    }
    SystemCall(60, 0)
}

RunTask(Main)
