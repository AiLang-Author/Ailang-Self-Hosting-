// df.ailang — filesystem disk space, GNU coreutils 9.4 column rules.
// --output, --total, -P, -B, -t/-x, and mount lookup for the tests/df set.

LibraryImport.Arena

FixedPool.DfConfig {
    "human": Initialize=0
    "header_mode": Initialize=0
    "print_type": Initialize=0
    "posix": Initialize=0
    "show_all": Initialize=0
    "show_local": Initialize=0
    "print_total": Initialize=0
    "block_size": Initialize=1024
    "block_set": Initialize=0
    "ncolumns": Initialize=0
    "printed": Initialize=0
    "exit_status": Initialize=0
    "source_used": Initialize=0
    "nargs": Initialize=0
    "scan": Initialize=0
    "header_done": Initialize=0
    "mounts": Initialize=0
    "nmounts": Initialize=0
    "columns": Initialize=0
    "used": Initialize=0
    "args": Initialize=0
    "type_sel": Initialize=0
    "type_excl": Initialize=0
    "sum_size": Initialize=0
    "sum_used": Initialize=0
    "sum_avail": Initialize=0
    "sum_itotal": Initialize=0
    "sum_iused": Initialize=0
    "sum_iavail": Initialize=0
    "pending": Initialize=0
    "end_opts": Initialize=0
    "best": Initialize=0
    "best_len": Initialize=0
    "saw_match": Initialize=0
}

FixedPool.DfStat {
    "bsize": Initialize=0
    "blocks": Initialize=0
    "bfree": Initialize=0
    "bavail": Initialize=0
    "files": Initialize=0
    "ffree": Initialize=0
    "size_d": Initialize=0
    "used_d": Initialize=0
    "avail_d": Initialize=0
    "itotal_d": Initialize=0
    "iused_d": Initialize=0
    "iavail_d": Initialize=0
}

Function.WriteStdout {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 1, buffer, len)
    }
}

Function.WriteStderr {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 2, buffer, len)
    }
}

Function.GetStringLength {
    Input: str: Address
    Output: Integer
    Body: {
        len = 0
        one = 1
        WhileLoop NotEqual(RDMEM_8(str, len), 0) {
            len = Add(len, one)
        }
        ReturnValue(len)
    }
}

Function.WriteOutStr {
    Input: str: Address
    Body: {
        n = GetStringLength(str)
        WriteStdout(str, n)
    }
}

Function.WriteErrStr {
    Input: str: Address
    Body: {
        n = GetStringLength(str)
        WriteStderr(str, n)
    }
}

Function.ConvertNumberToString {
    Input: num: Integer
    Output: Address
    Body: {
        buffer = Allocate(32)
        one = 1

        IfCondition EqualTo(num, 0) ThenBlock: {
            WRMEM_8(buffer, 0, 48)
            WRMEM_8(buffer, 1, 0)
            ReturnValue(buffer)
        }

        is_neg = 0
        IfCondition LessThan(num, 0) ThenBlock: {
            is_neg = 1
            num = Subtract(0, num)
        }

        pos = 0
        temp = Allocate(32)
        ten = 10

        WhileLoop GreaterThan(num, 0) {
            digit = Modulo(num, ten)
            WRMEM_8(temp, pos, Add(48, digit))
            pos = Add(pos, one)
            num = Divide(num, ten)
        }

        write_pos = 0
        IfCondition NotEqual(is_neg, 0) ThenBlock: {
            WRMEM_8(buffer, 0, 45)
            write_pos = 1
        }

        i = Subtract(pos, 1)
        WhileLoop GreaterEqual(i, 0) {
            ch = RDMEM_8(temp, i)
            WRMEM_8(buffer, write_pos, ch)
            write_pos = Add(write_pos, one)
            i = Subtract(i, 1)
        }

        WRMEM_8(buffer, write_pos, 0)
        Deallocate(temp, 32)
        ReturnValue(buffer)
    }
}

Function.CopyString {
    Input: dest: Address
    Input: src: Address
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, 4095) {
            ch = RDMEM_8(src, i)
            WRMEM_8(dest, i, ch)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            i = Add(i, one)
        }
    }
}

Function.FormatHumanSize {
    Input: bytes: Integer
    Output: Address
    Body: {
        buffer = Allocate(32)

        IfCondition LessThan(bytes, 1024) ThenBlock: {
            num_str = ConvertNumberToString(bytes)
            CopyString(buffer, num_str)
            AppendLit(buffer, "B")
            Deallocate(num_str, 32)
            ReturnValue(buffer)
        }

        kb = Divide(bytes, 1024)
        IfCondition LessThan(kb, 1024) ThenBlock: {
            num_str = ConvertNumberToString(kb)
            CopyString(buffer, num_str)
            AppendLit(buffer, "K")
            Deallocate(num_str, 32)
            ReturnValue(buffer)
        }

        mb = Divide(kb, 1024)
        IfCondition LessThan(mb, 1024) ThenBlock: {
            whole = mb
            remainder = Modulo(kb, 1024)
            decimal = Divide(Multiply(remainder, 10), 1024)
            num_str = ConvertNumberToString(whole)
            CopyString(buffer, num_str)
            Deallocate(num_str, 32)
            IfCondition GreaterThan(decimal, 0) ThenBlock: {
                AppendLit(buffer, ".")
                dec_str = ConvertNumberToString(decimal)
                AppendLit(buffer, dec_str)
                Deallocate(dec_str, 32)
            }
            AppendLit(buffer, "M")
            ReturnValue(buffer)
        }

        gb = Divide(mb, 1024)
        IfCondition LessThan(gb, 1024) ThenBlock: {
            whole = gb
            remainder = Modulo(mb, 1024)
            decimal = Divide(Multiply(remainder, 10), 1024)
            num_str = ConvertNumberToString(whole)
            CopyString(buffer, num_str)
            Deallocate(num_str, 32)
            IfCondition GreaterThan(decimal, 0) ThenBlock: {
                AppendLit(buffer, ".")
                dec_str = ConvertNumberToString(decimal)
                AppendLit(buffer, dec_str)
                Deallocate(dec_str, 32)
            }
            AppendLit(buffer, "G")
            ReturnValue(buffer)
        }

        tb = Divide(gb, 1024)
        whole = tb
        remainder = Modulo(gb, 1024)
        decimal = Divide(Multiply(remainder, 10), 1024)
        num_str = ConvertNumberToString(whole)
        CopyString(buffer, num_str)
        Deallocate(num_str, 32)
        IfCondition GreaterThan(decimal, 0) ThenBlock: {
            AppendLit(buffer, ".")
            dec_str = ConvertNumberToString(decimal)
            AppendLit(buffer, dec_str)
            Deallocate(dec_str, 32)
        }
        AppendLit(buffer, "T")
        ReturnValue(buffer)
    }
}

Function.AppendLit {
    Input: dest: Address
    Input: src: Address
    Body: {
        one = 1
        i = 0
        WhileLoop LessThan(i, 4095) {
            IfCondition EqualTo(RDMEM_8(dest, i), 0) ThenBlock: {
                BreakLoop
            }
            i = Add(i, one)
        }
        j = 0
        WhileLoop LessThan(j, 4095) {
            ch = RDMEM_8(src, j)
            WRMEM_8(dest, i, ch)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            i = Add(i, one)
            j = Add(j, one)
        }
    }
}

Function.GetUInt64 {
    Input: addr: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        ptr = Add(addr, offset)
        b0 = RDMEM_8(ptr, 0)
        b1 = RDMEM_8(ptr, 1)
        b2 = RDMEM_8(ptr, 2)
        b3 = RDMEM_8(ptr, 3)
        b4 = RDMEM_8(ptr, 4)
        b5 = RDMEM_8(ptr, 5)
        b6 = RDMEM_8(ptr, 6)
        b7 = RDMEM_8(ptr, 7)
        lo = Add(b0, Multiply(b1, 256))
        lo = Add(lo, Multiply(b2, 65536))
        lo = Add(lo, Multiply(b3, 16777216))
        hi = Add(b4, Multiply(b5, 256))
        hi = Add(hi, Multiply(b6, 65536))
        hi = Add(hi, Multiply(b7, 16777216))
        value = Add(lo, Multiply(hi, 4294967296))
        ReturnValue(value)
    }
}

Function.GetUInt32 {
    Input: addr: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        b0 = RDMEM_8(addr, offset)
        o1 = Add(offset, 1)
        o2 = Add(offset, 2)
        o3 = Add(offset, 3)
        b1 = RDMEM_8(addr, o1)
        b2 = RDMEM_8(addr, o2)
        b3 = RDMEM_8(addr, o3)
        value = Add(b0, Multiply(b1, 256))
        value = Add(value, Multiply(b2, 65536))
        value = Add(value, Multiply(b3, 16777216))
        ReturnValue(value)
    }
}

Function.StrEq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        one = 1
        i = 0
        WhileLoop 1 {
            ca = RDMEM_8(a, i)
            cb = RDMEM_8(b, i)
            IfCondition NotEqual(ca, cb) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(ca, 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.IsPrefix {
    Input: given: Address
    Input: full: Address
    Output: Integer
    Body: {
        one = 1
        i = 0
        WhileLoop 1 {
            g = RDMEM_8(given, i)
            IfCondition EqualTo(g, 0) ThenBlock: {
                IfCondition EqualTo(i, 0) ThenBlock: {
                    ReturnValue(0)
                }
                ReturnValue(1)
            }
            f = RDMEM_8(full, i)
            IfCondition NotEqual(g, f) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.HasColon {
    Input: s: Address
    Output: Integer
    Body: {
        one = 1
        i = 0
        WhileLoop 1 {
            ch = RDMEM_8(s, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(ch, 58) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.IsRemote {
    Input: dev: Address
    Input: typ: Address
    Output: Integer
    Body: {
        hit = StrEq(typ, "nfs")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = StrEq(typ, "nfs4")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = StrEq(typ, "cifs")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = StrEq(typ, "smbfs")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = StrEq(typ, "ncpfs")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = StrEq(typ, "coda")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = StrEq(typ, "afs")
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = HasColon(dev)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.TypeOk {
    Input: dev: Address
    Input: typ: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(DfConfig.type_sel, 0) ThenBlock: {
            eq = StrEq(typ, DfConfig.type_sel)
            IfCondition EqualTo(eq, 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition NotEqual(DfConfig.type_excl, 0) ThenBlock: {
            eq = StrEq(typ, DfConfig.type_excl)
            IfCondition EqualTo(eq, 1) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(DfConfig.show_local, 1) ThenBlock: {
            rem = IsRemote(dev, typ)
            IfCondition EqualTo(rem, 1) ThenBlock: {
                ReturnValue(0)
            }
        }
        ReturnValue(1)
    }
}

Function.TryHelp {
    Body: {
        WriteErrStr("Try 'df --help' for more information.\n")
        SystemCall(60, 1)
    }
}

Function.DieMutex {
    Input: opt: Address
    Body: {
        WriteErrStr("df: options ")
        WriteErrStr(opt)
        WriteErrStr(" and --output are mutually exclusive\n")
        TryHelp()
    }
}

Function.MountPtr {
    Input: index: Integer
    Output: Address
    Body: {
        rec = Multiply(index, 832)
        ptr = Add(DfConfig.mounts, rec)
        ReturnValue(ptr)
    }
}

Function.FieldPtr {
    Input: index: Integer
    Input: disp: Integer
    Output: Address
    Body: {
        base = MountPtr(index)
        ptr = Add(base, disp)
        ReturnValue(ptr)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buffer = Allocate(16384)
        bytes_read = SystemCall(0, fd, buffer, 16383)
        SystemCall(3, fd)
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 16384)
            ReturnValue(0)
        }
        WRMEM_8(buffer, bytes_read, 0)
        ReturnValue(buffer)
    }
}

Function.WriteText {
    Input: src: Address
    Body: {
        one = 1
        IfCondition EqualTo(src, 0) ThenBlock: {
            WriteOutStr("-")
            ReturnValue(0)
        }
        buf = Allocate(4096)
        i = 0
        WhileLoop LessThan(i, 4095) {
            ch = RDMEM_8(src, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                WRMEM_8(buf, i, 0)
                BreakLoop
            }
            IfCondition LessThan(ch, 32) ThenBlock: {
                ch = 63
            }
            IfCondition EqualTo(ch, 127) ThenBlock: {
                ch = 63
            }
            WRMEM_8(buf, i, ch)
            i = Add(i, one)
        }
        WRMEM_8(buf, 4095, 0)
        WriteOutStr(buf)
        Deallocate(buf, 4096)
        ReturnValue(0)
    }
}

Function.WriteNum {
    Input: num: Integer
    Body: {
        s = ConvertNumberToString(num)
        WriteOutStr(s)
        Deallocate(s, 32)
    }
}

Function.WriteHumanOrNum {
    Input: num: Integer
    Body: {
        IfCondition EqualTo(DfConfig.human, 1) ThenBlock: {
            s = FormatHumanSize(num)
            WriteOutStr(s)
            Deallocate(s, 32)
        } ElseBlock: {
            WriteNum(num)
        }
    }
}

Function.PercentOf {
    Input: used: Integer
    Input: avail: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(used, 0) ThenBlock: {
            ReturnValue(-1)
        }
        denom = Add(used, avail)
        IfCondition LessEqual(denom, 0) ThenBlock: {
            ReturnValue(-1)
        }
        prod = Multiply(used, 100)
        adj = Subtract(denom, 1)
        prod = Add(prod, adj)
        pct = Divide(prod, denom)
        ReturnValue(pct)
    }
}

Function.WritePercent {
    Input: pct: Integer
    Body: {
        IfCondition LessThan(pct, 0) ThenBlock: {
            WriteOutStr("-")
        } ElseBlock: {
            WriteNum(pct)
            WriteStdout("%", 1)
        }
    }
}

Function.WriteSizeCaption {
    Body: {
        // POSIX prints the raw unit count. Other non-human modes print 1K-blocks.
        IfCondition EqualTo(DfConfig.header_mode, 3) ThenBlock: {
            WriteNum(DfConfig.block_size)
            WriteOutStr("-blocks")
        } ElseBlock: {
            human_cap = 0
            IfCondition EqualTo(DfConfig.header_mode, 2) ThenBlock: {
                human_cap = 1
            }
            IfCondition EqualTo(DfConfig.header_mode, 4) ThenBlock: {
                IfCondition EqualTo(DfConfig.human, 1) ThenBlock: {
                    human_cap = 1
                }
            }
            IfCondition EqualTo(human_cap, 1) ThenBlock: {
                WriteOutStr("Size")
            } ElseBlock: {
                IfCondition EqualTo(DfConfig.block_size, 1024) ThenBlock: {
                    WriteOutStr("1K-blocks")
                } ElseBlock: {
                    IfCondition EqualTo(DfConfig.block_size, 1048576) ThenBlock: {
                        WriteOutStr("1M-blocks")
                    } ElseBlock: {
                        IfCondition EqualTo(DfConfig.block_size, 1073741824) ThenBlock: {
                            WriteOutStr("1G-blocks")
                        } ElseBlock: {
                            WriteNum(DfConfig.block_size)
                            WriteOutStr("-blocks")
                        }
                    }
                }
            }
        }
    }
}

Function.WriteCaption {
    Input: fid: Integer
    Body: {
        IfCondition EqualTo(fid, 0) ThenBlock: { WriteOutStr("Filesystem") }
        IfCondition EqualTo(fid, 1) ThenBlock: { WriteOutStr("Type") }
        IfCondition EqualTo(fid, 2) ThenBlock: { WriteOutStr("Inodes") }
        IfCondition EqualTo(fid, 3) ThenBlock: { WriteOutStr("IUsed") }
        IfCondition EqualTo(fid, 4) ThenBlock: { WriteOutStr("IFree") }
        IfCondition EqualTo(fid, 5) ThenBlock: { WriteOutStr("IUse%") }
        IfCondition EqualTo(fid, 6) ThenBlock: { WriteSizeCaption() }
        IfCondition EqualTo(fid, 7) ThenBlock: { WriteOutStr("Used") }
        IfCondition EqualTo(fid, 8) ThenBlock: {
            IfCondition EqualTo(DfConfig.header_mode, 2) ThenBlock: {
                WriteOutStr("Avail")
            } ElseBlock: {
                IfCondition EqualTo(DfConfig.header_mode, 4) ThenBlock: {
                    WriteOutStr("Avail")
                } ElseBlock: {
                    WriteOutStr("Available")
                }
            }
        }
        IfCondition EqualTo(fid, 9) ThenBlock: {
            IfCondition EqualTo(DfConfig.header_mode, 3) ThenBlock: {
                WriteOutStr("Capacity")
            } ElseBlock: {
                WriteOutStr("Use%")
            }
        }
        IfCondition EqualTo(fid, 10) ThenBlock: { WriteOutStr("File") }
        IfCondition EqualTo(fid, 11) ThenBlock: { WriteOutStr("Mounted on") }
    }
}

Function.ColumnId {
    Input: index: Integer
    Output: Integer
    Body: {
        off = Multiply(index, 8)
        ptr = Add(DfConfig.columns, off)
        fid = RDMEM_64(ptr)
        ReturnValue(fid)
    }
}

Function.EmitHeader {
    Body: {
        one = 1
        c = 0
        WhileLoop LessThan(c, DfConfig.ncolumns) {
            IfCondition NotEqual(c, 0) ThenBlock: {
                WriteStdout(" ", 1)
            }
            fid = ColumnId(c)
            WriteCaption(fid)
            c = Add(c, one)
        }
        WriteStdout("\n", 1)
        DfConfig.header_done = 1
    }
}

Function.CellValue {
    Input: which: Integer
    Input: summing: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(summing, 1) ThenBlock: {
            IfCondition EqualTo(which, 0) ThenBlock: { ReturnValue(DfConfig.sum_size) }
            IfCondition EqualTo(which, 1) ThenBlock: { ReturnValue(DfConfig.sum_used) }
            IfCondition EqualTo(which, 2) ThenBlock: { ReturnValue(DfConfig.sum_avail) }
            IfCondition EqualTo(which, 3) ThenBlock: { ReturnValue(DfConfig.sum_itotal) }
            IfCondition EqualTo(which, 4) ThenBlock: { ReturnValue(DfConfig.sum_iused) }
            IfCondition EqualTo(which, 5) ThenBlock: { ReturnValue(DfConfig.sum_iavail) }
            ReturnValue(0)
        }
        IfCondition EqualTo(which, 0) ThenBlock: { ReturnValue(DfStat.size_d) }
        IfCondition EqualTo(which, 1) ThenBlock: { ReturnValue(DfStat.used_d) }
        IfCondition EqualTo(which, 2) ThenBlock: { ReturnValue(DfStat.avail_d) }
        IfCondition EqualTo(which, 3) ThenBlock: { ReturnValue(DfStat.itotal_d) }
        IfCondition EqualTo(which, 4) ThenBlock: { ReturnValue(DfStat.iused_d) }
        IfCondition EqualTo(which, 5) ThenBlock: { ReturnValue(DfStat.iavail_d) }
        ReturnValue(0)
    }
}

Function.EmitCell {
    Input: fid: Integer
    Input: source: Address
    Input: fstype: Address
    Input: file: Address
    Input: target: Address
    Input: summing: Integer
    Body: {
        IfCondition EqualTo(fid, 0) ThenBlock: { WriteText(source) }
        IfCondition EqualTo(fid, 1) ThenBlock: { WriteText(fstype) }
        IfCondition EqualTo(fid, 2) ThenBlock: {
            v = CellValue(3, summing)
            WriteNum(v)
        }
        IfCondition EqualTo(fid, 3) ThenBlock: {
            v = CellValue(4, summing)
            WriteNum(v)
        }
        IfCondition EqualTo(fid, 4) ThenBlock: {
            v = CellValue(5, summing)
            WriteNum(v)
        }
        IfCondition EqualTo(fid, 5) ThenBlock: {
            u = CellValue(4, summing)
            a = CellValue(5, summing)
            pct = PercentOf(u, a)
            WritePercent(pct)
        }
        IfCondition EqualTo(fid, 6) ThenBlock: {
            v = CellValue(0, summing)
            WriteHumanOrNum(v)
        }
        IfCondition EqualTo(fid, 7) ThenBlock: {
            v = CellValue(1, summing)
            WriteHumanOrNum(v)
        }
        IfCondition EqualTo(fid, 8) ThenBlock: {
            v = CellValue(2, summing)
            WriteHumanOrNum(v)
        }
        IfCondition EqualTo(fid, 9) ThenBlock: {
            u = CellValue(1, summing)
            a = CellValue(2, summing)
            pct = PercentOf(u, a)
            WritePercent(pct)
        }
        IfCondition EqualTo(fid, 10) ThenBlock: { WriteText(file) }
        IfCondition EqualTo(fid, 11) ThenBlock: { WriteText(target) }
    }
}

Function.EmitRow {
    Input: source: Address
    Input: fstype: Address
    Input: file: Address
    Input: target: Address
    Input: summing: Integer
    Body: {
        one = 1
        IfCondition EqualTo(DfConfig.header_done, 0) ThenBlock: {
            EmitHeader()
        }
        c = 0
        WhileLoop LessThan(c, DfConfig.ncolumns) {
            IfCondition NotEqual(c, 0) ThenBlock: {
                WriteStdout(" ", 1)
            }
            fid = ColumnId(c)
            EmitCell(fid, source, fstype, file, target, summing)
            c = Add(c, one)
        }
        WriteStdout("\n", 1)
        IfCondition EqualTo(summing, 0) ThenBlock: {
            DfConfig.sum_size = Add(DfConfig.sum_size, DfStat.size_d)
            DfConfig.sum_used = Add(DfConfig.sum_used, DfStat.used_d)
            DfConfig.sum_avail = Add(DfConfig.sum_avail, DfStat.avail_d)
            DfConfig.sum_itotal = Add(DfConfig.sum_itotal, DfStat.itotal_d)
            DfConfig.sum_iused = Add(DfConfig.sum_iused, DfStat.iused_d)
            DfConfig.sum_iavail = Add(DfConfig.sum_iavail, DfStat.iavail_d)
            DfConfig.printed = Add(DfConfig.printed, one)
        }
    }
}

Function.FillDisplays {
    Body: {
        bsize = DfStat.bsize
        blocks = DfStat.blocks
        bfree = DfStat.bfree
        bavail = DfStat.bavail
        units = DfConfig.block_size
        IfCondition LessThan(units, 1) ThenBlock: {
            units = 1024
        }
        IfCondition LessEqual(bsize, 0) ThenBlock: {
            DfStat.size_d = 0
            DfStat.used_d = 0
            DfStat.avail_d = 0
        } ElseBlock: {
            total_bytes = Multiply(blocks, bsize)
            used_blocks = Subtract(blocks, bfree)
            used_bytes = Multiply(used_blocks, bsize)
            avail_bytes = Multiply(bavail, bsize)
            DfStat.size_d = Divide(total_bytes, units)
            DfStat.used_d = Divide(used_bytes, units)
            DfStat.avail_d = Divide(avail_bytes, units)
        }
        DfStat.itotal_d = DfStat.files
        DfStat.iavail_d = DfStat.ffree
        DfStat.iused_d = Subtract(DfStat.files, DfStat.ffree)
    }
}

Function.ReadStatfs {
    Input: path: Address
    Output: Integer
    Body: {
        buf = Allocate(120)
        result = SystemCall(137, path, buf)
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(buf, 120)
            ReturnValue(0)
        }
        DfStat.bsize = GetUInt64(buf, 8)
        DfStat.blocks = GetUInt64(buf, 16)
        DfStat.bfree = GetUInt64(buf, 24)
        DfStat.bavail = GetUInt64(buf, 32)
        DfStat.files = GetUInt64(buf, 40)
        DfStat.ffree = GetUInt64(buf, 48)
        Deallocate(buf, 120)
        FillDisplays()
        ReturnValue(1)
    }
}

Function.LoadAllMounts {
    Body: {
        one = 1
        four = 4
        fd = SystemCall(2, "/proc/mounts", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf = Allocate(65536)
        n = SystemCall(0, fd, buf, 65535)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 65536)
            ReturnValue(0)
        }
        WRMEM_8(buf, n, 0)
        i = 0
        DfConfig.nmounts = 0
        WhileLoop LessThan(i, n) {
            IfCondition GreaterEqual(DfConfig.nmounts, 128) ThenBlock: {
                BreakLoop
            }
            ch0 = RDMEM_8(buf, i)
            IfCondition EqualTo(ch0, 10) ThenBlock: {
                i = Add(i, one)
            } ElseBlock: {
                dev = FieldPtr(DfConfig.nmounts, 0)
                mnt = FieldPtr(DfConfig.nmounts, 256)
                typ = FieldPtr(DfConfig.nmounts, 768)
                WRMEM_8(dev, 0, 0)
                WRMEM_8(mnt, 0, 0)
                WRMEM_8(typ, 0, 0)
                field = 0
                dlen = 0
                mlen = 0
                tlen = 0
                WhileLoop LessThan(i, n) {
                    ch = RDMEM_8(buf, i)
                    IfCondition EqualTo(ch, 10) ThenBlock: {
                        BreakLoop
                    }
                    IfCondition EqualTo(ch, 32) ThenBlock: {
                        field = Add(field, one)
                        i = Add(i, one)
                    } ElseBlock: {
                        outb = ch
                        step = one
                        IfCondition EqualTo(ch, 92) ThenBlock: {
                            i1 = Add(i, one)
                            i2 = Add(i, 2)
                            i3 = Add(i, 3)
                            IfCondition LessThan(i3, n) ThenBlock: {
                                c1 = RDMEM_8(buf, i1)
                                c2 = RDMEM_8(buf, i2)
                                c3 = RDMEM_8(buf, i3)
                                ok1 = 0
                                ok2 = 0
                                ok3 = 0
                                IfCondition GreaterEqual(c1, 48) ThenBlock: {
                                    IfCondition LessEqual(c1, 55) ThenBlock: { ok1 = 1 }
                                }
                                IfCondition GreaterEqual(c2, 48) ThenBlock: {
                                    IfCondition LessEqual(c2, 55) ThenBlock: { ok2 = 1 }
                                }
                                IfCondition GreaterEqual(c3, 48) ThenBlock: {
                                    IfCondition LessEqual(c3, 55) ThenBlock: { ok3 = 1 }
                                }
                                IfCondition EqualTo(ok1, 1) ThenBlock: {
                                    IfCondition EqualTo(ok2, 1) ThenBlock: {
                                        IfCondition EqualTo(ok3, 1) ThenBlock: {
                                            d1 = Subtract(c1, 48)
                                            d2 = Subtract(c2, 48)
                                            d3 = Subtract(c3, 48)
                                            outb = Multiply(d1, 64)
                                            t2 = Multiply(d2, 8)
                                            outb = Add(outb, t2)
                                            outb = Add(outb, d3)
                                            step = four
                                        }
                                    }
                                }
                            }
                        }
                        IfCondition EqualTo(field, 0) ThenBlock: {
                            IfCondition LessThan(dlen, 255) ThenBlock: {
                                WRMEM_8(dev, dlen, outb)
                                dlen = Add(dlen, one)
                                WRMEM_8(dev, dlen, 0)
                            }
                        }
                        IfCondition EqualTo(field, 1) ThenBlock: {
                            IfCondition LessThan(mlen, 511) ThenBlock: {
                                WRMEM_8(mnt, mlen, outb)
                                mlen = Add(mlen, one)
                                WRMEM_8(mnt, mlen, 0)
                            }
                        }
                        IfCondition EqualTo(field, 2) ThenBlock: {
                            IfCondition LessThan(tlen, 63) ThenBlock: {
                                WRMEM_8(typ, tlen, outb)
                                tlen = Add(tlen, one)
                                WRMEM_8(typ, tlen, 0)
                            }
                        }
                        i = Add(i, step)
                    }
                }
                IfCondition GreaterThan(mlen, 0) ThenBlock: {
                    DfConfig.nmounts = Add(DfConfig.nmounts, one)
                }
                IfCondition LessThan(i, n) ThenBlock: {
                    nl = RDMEM_8(buf, i)
                    IfCondition EqualTo(nl, 10) ThenBlock: {
                        i = Add(i, one)
                    }
                }
            }
        }
        Deallocate(buf, 65536)
        ReturnValue(DfConfig.nmounts)
    }
}

Function.StartsWithPath {
    Input: path: Address
    Input: prefix: Address
    Output: Integer
    Body: {
        one = 1
        plen = GetStringLength(prefix)
        IfCondition LessEqual(plen, 0) ThenBlock: {
            ReturnValue(0)
        }
        i = 0
        WhileLoop LessThan(i, plen) {
            pb = RDMEM_8(prefix, i)
            tb = RDMEM_8(path, i)
            IfCondition NotEqual(pb, tb) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        IfCondition EqualTo(plen, 1) ThenBlock: {
            slash = RDMEM_8(prefix, 0)
            IfCondition EqualTo(slash, 47) ThenBlock: {
                ReturnValue(1)
            }
        }
        tb = RDMEM_8(path, plen)
        IfCondition EqualTo(tb, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(tb, 47) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.SameDev {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        a0 = GetUInt32(a, 0)
        b0 = GetUInt32(b, 0)
        a1 = GetUInt32(a, 4)
        b1 = GetUInt32(b, 4)
        IfCondition EqualTo(a0, b0) ThenBlock: {
            IfCondition EqualTo(a1, b1) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.StatInto {
    Input: path: Address
    Input: sb: Address
    Output: Integer
    Body: {
        result = SystemCall(4, path, sb)
        ReturnValue(result)
    }
}

Function.IsSymlink {
    Input: path: Address
    Output: Integer
    Body: {
        sb = Allocate(144)
        result = SystemCall(6, path, sb)
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(sb, 144)
            ReturnValue(0)
        }
        mode = GetUInt32(sb, 24)
        kind = BitwiseAnd(mode, 61440)
        Deallocate(sb, 144)
        IfCondition EqualTo(kind, 40960) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.StripLast {
    Input: path: Address
    Body: {
        one = 1
        len = GetStringLength(path)
        IfCondition LessEqual(len, 1) ThenBlock: {
            WRMEM_8(path, 0, 47)
            WRMEM_8(path, 1, 0)
            ReturnValue(0)
        }
        i = Subtract(len, 1)
        WhileLoop GreaterThan(i, 0) {
            ch = RDMEM_8(path, i)
            IfCondition EqualTo(ch, 47) ThenBlock: {
                BreakLoop
            }
            i = Subtract(i, one)
        }
        IfCondition EqualTo(i, 0) ThenBlock: {
            WRMEM_8(path, 1, 0)
        } ElseBlock: {
            WRMEM_8(path, i, 0)
        }
        ReturnValue(0)
    }
}

Function.AppendSlash {
    Input: dest: Address
    Input: src: Address
    Body: {
        one = 1
        n = GetStringLength(dest)
        IfCondition EqualTo(n, 0) ThenBlock: {
            WRMEM_8(dest, 0, 47)
            WRMEM_8(dest, 1, 0)
            n = 1
        } ElseBlock: {
            last = Subtract(n, 1)
            ch = RDMEM_8(dest, last)
            IfCondition NotEqual(ch, 47) ThenBlock: {
                IfCondition LessThan(n, 4094) ThenBlock: {
                    WRMEM_8(dest, n, 47)
                    n = Add(n, one)
                    WRMEM_8(dest, n, 0)
                }
            }
        }
        j = 0
        WhileLoop LessThan(n, 4095) {
            ch = RDMEM_8(src, j)
            WRMEM_8(dest, n, ch)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            n = Add(n, one)
            j = Add(j, one)
        }
        WRMEM_8(dest, 4095, 0)
    }
}

Function.Normalize {
    Input: path: Address
    Body: {
        one = 1
        src = Allocate(4096)
        dst = Allocate(4096)
        comp = Allocate(256)
        CopyString(src, path)
        WRMEM_8(dst, 0, 0)
        i = 0
        WhileLoop LessThan(i, 4095) {
            ch = RDMEM_8(src, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition EqualTo(ch, 47) ThenBlock: {
                i = Add(i, one)
            } ElseBlock: {
                clen = 0
                WhileLoop LessThan(i, 4095) {
                    ch = RDMEM_8(src, i)
                    IfCondition EqualTo(ch, 0) ThenBlock: {
                        BreakLoop
                    }
                    IfCondition EqualTo(ch, 47) ThenBlock: {
                        BreakLoop
                    }
                    IfCondition LessThan(clen, 254) ThenBlock: {
                        WRMEM_8(comp, clen, ch)
                        clen = Add(clen, one)
                    }
                    i = Add(i, one)
                }
                WRMEM_8(comp, clen, 0)
                dot = 0
                IfCondition EqualTo(clen, 1) ThenBlock: {
                    IfCondition EqualTo(RDMEM_8(comp, 0), 46) ThenBlock: {
                        dot = 1
                    }
                }
                dotdot = 0
                IfCondition EqualTo(clen, 2) ThenBlock: {
                    IfCondition EqualTo(RDMEM_8(comp, 0), 46) ThenBlock: {
                        IfCondition EqualTo(RDMEM_8(comp, 1), 46) ThenBlock: {
                            dotdot = 1
                        }
                    }
                }
                IfCondition EqualTo(dot, 1) ThenBlock: {
                    dot = 0
                } ElseBlock: {
                    IfCondition EqualTo(dotdot, 1) ThenBlock: {
                        StripLast(dst)
                    } ElseBlock: {
                        AppendSlash(dst, comp)
                    }
                }
            }
        }
        IfCondition EqualTo(RDMEM_8(dst, 0), 0) ThenBlock: {
            WRMEM_8(dst, 0, 47)
            WRMEM_8(dst, 1, 0)
        }
        CopyString(path, dst)
        Deallocate(src, 4096)
        Deallocate(dst, 4096)
        Deallocate(comp, 256)
    }
}

Function.ResolvePath {
    Input: path: Address
    Output: Address
    Body: {
        one = 1
        out = Allocate(4096)
        link = Allocate(4096)
        WRMEM_8(out, 0, 0)
        IfCondition EqualTo(RDMEM_8(path, 0), 47) ThenBlock: {
            CopyString(out, path)
        } ElseBlock: {
            dot_only = 0
            IfCondition EqualTo(RDMEM_8(path, 0), 46) ThenBlock: {
                IfCondition EqualTo(RDMEM_8(path, 1), 0) ThenBlock: {
                    dot_only = 1
                }
            }
            n = SystemCall(79, out, 4095)
            IfCondition LessThan(n, 1) ThenBlock: {
                CopyString(out, path)
            } ElseBlock: {
                IfCondition EqualTo(dot_only, 0) ThenBlock: {
                    AppendSlash(out, path)
                }
            }
        }
        Normalize(out)
        depth = 0
        WhileLoop LessThan(depth, 16) {
            link_ok = IsSymlink(out)
            IfCondition EqualTo(link_ok, 0) ThenBlock: {
                BreakLoop
            }
            nb = SystemCall(89, out, link, 4095)
            IfCondition LessThan(nb, 0) ThenBlock: {
                BreakLoop
            }
            WRMEM_8(link, nb, 0)
            IfCondition EqualTo(RDMEM_8(link, 0), 47) ThenBlock: {
                CopyString(out, link)
            } ElseBlock: {
                StripLast(out)
                AppendSlash(out, link)
            }
            Normalize(out)
            depth = Add(depth, one)
        }
        Deallocate(link, 4096)
        ReturnValue(out)
    }
}

Function.IsEclipsed {
    Input: index: Integer
    Output: Integer
    Body: {
        one = 1
        this_dev = FieldPtr(index, 0)
        this_mnt = FieldPtr(index, 256)
        last = index
        j = Add(index, one)
        WhileLoop LessThan(j, DfConfig.nmounts) {
            other_mnt = FieldPtr(j, 256)
            eq = StrEq(other_mnt, this_mnt)
            IfCondition EqualTo(eq, 1) ThenBlock: {
                last = j
            }
            j = Add(j, one)
        }
        IfCondition EqualTo(last, index) ThenBlock: {
            ReturnValue(0)
        }
        last_dev = FieldPtr(last, 0)
        eq = StrEq(last_dev, this_dev)
        IfCondition EqualTo(eq, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.DeviceMatch {
    Input: dev: Address
    Input: path: Address
    Input: resolved: Address
    Output: Integer
    Body: {
        eq = StrEq(dev, path)
        IfCondition EqualTo(eq, 1) ThenBlock: { ReturnValue(1) }
        eq = StrEq(dev, resolved)
        IfCondition EqualTo(eq, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(RDMEM_8(dev, 0), 47) ThenBlock: {
            dev_res = ResolvePath(dev)
            eq = StrEq(dev_res, resolved)
            Deallocate(dev_res, 4096)
            IfCondition EqualTo(eq, 1) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

Function.LookupDevice {
    Input: path: Address
    Output: Integer
    Body: {
        one = 1
        resolved = ResolvePath(path)
        DfConfig.best = -1
        DfConfig.best_len = 999999
        DfConfig.saw_match = 0
        i = 0
        WhileLoop LessThan(i, DfConfig.nmounts) {
            dev = FieldPtr(i, 0)
            mnt = FieldPtr(i, 256)
            hit = DeviceMatch(dev, path, resolved)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                DfConfig.saw_match = 1
                ecl = IsEclipsed(i)
                IfCondition EqualTo(ecl, 0) ThenBlock: {
                    mlen = GetStringLength(mnt)
                    IfCondition LessThan(mlen, DfConfig.best_len) ThenBlock: {
                        DfConfig.best = i
                        DfConfig.best_len = mlen
                    }
                }
            }
            i = Add(i, one)
        }
        IfCondition GreaterEqual(DfConfig.best, 0) ThenBlock: {
            dev = FieldPtr(DfConfig.best, 0)
            mnt = FieldPtr(DfConfig.best, 256)
            typ = FieldPtr(DfConfig.best, 768)
            ok = TypeOk(dev, typ)
            IfCondition EqualTo(ok, 1) ThenBlock: {
                got = ReadStatfs(mnt)
                IfCondition EqualTo(got, 1) ThenBlock: {
                    EmitRow(dev, typ, path, mnt, 0)
                }
            }
            Deallocate(resolved, 4096)
            ReturnValue(1)
        }
        IfCondition EqualTo(DfConfig.saw_match, 1) ThenBlock: {
            WriteErrStr("df: cannot access '")
            WriteErrStr(path)
            WriteErrStr("': over-mounted by another device\n")
            DfConfig.exit_status = 1
            Deallocate(resolved, 4096)
            ReturnValue(1)
        }
        Deallocate(resolved, 4096)
        ReturnValue(0)
    }
}

Function.LookupPoint {
    Input: path: Address
    Input: sb: Address
    Body: {
        one = 1
        resolved = ResolvePath(path)
        DfConfig.best = -1
        DfConfig.best_len = -1
        i = 0
        WhileLoop LessThan(i, DfConfig.nmounts) {
            mnt = FieldPtr(i, 256)
            abs = RDMEM_8(mnt, 0)
            IfCondition EqualTo(abs, 47) ThenBlock: {
                pre = StartsWithPath(resolved, mnt)
                IfCondition EqualTo(pre, 1) ThenBlock: {
                    mlen = GetStringLength(mnt)
                    IfCondition GreaterThan(mlen, DfConfig.best_len) ThenBlock: {
                        DfConfig.best = i
                        DfConfig.best_len = mlen
                    }
                }
            }
            i = Add(i, one)
        }
        use_best = 0
        IfCondition GreaterEqual(DfConfig.best, 0) ThenBlock: {
            mnt = FieldPtr(DfConfig.best, 256)
            msb = Allocate(144)
            st = StatInto(mnt, msb)
            IfCondition GreaterEqual(st, 0) ThenBlock: {
                same = SameDev(sb, msb)
                IfCondition EqualTo(same, 1) ThenBlock: {
                    use_best = 1
                }
            }
            Deallocate(msb, 144)
        }
        IfCondition EqualTo(use_best, 0) ThenBlock: {
            DfConfig.best = -1
            DfConfig.best_len = -1
            i = 0
            WhileLoop LessThan(i, DfConfig.nmounts) {
                mnt = FieldPtr(i, 256)
                msb = Allocate(144)
                st = StatInto(mnt, msb)
                IfCondition GreaterEqual(st, 0) ThenBlock: {
                    same = SameDev(sb, msb)
                    IfCondition EqualTo(same, 1) ThenBlock: {
                        mlen = GetStringLength(mnt)
                        IfCondition GreaterThan(mlen, DfConfig.best_len) ThenBlock: {
                            DfConfig.best = i
                            DfConfig.best_len = mlen
                        }
                    }
                }
                Deallocate(msb, 144)
                i = Add(i, one)
            }
        }
        IfCondition GreaterEqual(DfConfig.best, 0) ThenBlock: {
            dev = FieldPtr(DfConfig.best, 0)
            mnt = FieldPtr(DfConfig.best, 256)
            typ = FieldPtr(DfConfig.best, 768)
            ok = TypeOk(dev, typ)
            IfCondition EqualTo(ok, 1) ThenBlock: {
                got = ReadStatfs(path)
                IfCondition EqualTo(got, 0) ThenBlock: {
                    got = ReadStatfs(mnt)
                }
                IfCondition EqualTo(got, 1) ThenBlock: {
                    EmitRow(dev, typ, path, mnt, 0)
                }
            }
        } ElseBlock: {
            got = ReadStatfs(path)
            IfCondition EqualTo(got, 1) ThenBlock: {
                dash = "-"
                ok = TypeOk(path, dash)
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    EmitRow(resolved, dash, path, resolved, 0)
                }
            }
        }
        Deallocate(resolved, 4096)
    }
}

Function.WriteStatError {
    Input: path: Address
    Input: result: Integer
    Body: {
        err = Subtract(0, result)
        WriteErrStr("df: ")
        WriteErrStr(path)
        WriteErrStr(": ")
        IfCondition EqualTo(err, 2) ThenBlock: {
            WriteErrStr("No such file or directory\n")
        } ElseBlock: {
            IfCondition EqualTo(err, 13) ThenBlock: {
                WriteErrStr("Permission denied\n")
            } ElseBlock: {
                IfCondition EqualTo(err, 20) ThenBlock: {
                    WriteErrStr("Not a directory\n")
                } ElseBlock: {
                    WriteErrStr("No such file or directory\n")
                }
            }
        }
    }
}

Function.HandleFile {
    Input: path: Address
    Body: {
        sb = Allocate(144)
        st = StatInto(path, sb)
        IfCondition LessThan(st, 0) ThenBlock: {
            WriteStatError(path, st)
            DfConfig.exit_status = 1
            Deallocate(sb, 144)
            ReturnValue(0)
        }
        mode = GetUInt32(sb, 24)
        kind = BitwiseAnd(mode, 61440)
        handled = 0
        IfCondition EqualTo(kind, 24576) ThenBlock: {
            handled = LookupDevice(path)
        }
        IfCondition EqualTo(kind, 8192) ThenBlock: {
            handled = LookupDevice(path)
        }
        IfCondition EqualTo(handled, 0) ThenBlock: {
            LookupPoint(path, sb)
        }
        Deallocate(sb, 144)
        ReturnValue(0)
    }
}

Function.ListAll {
    Body: {
        one = 1
        i = 0
        WhileLoop LessThan(i, DfConfig.nmounts) {
            dev = FieldPtr(i, 0)
            mnt = FieldPtr(i, 256)
            typ = FieldPtr(i, 768)
            show = 1
            IfCondition NotEqual(RDMEM_8(mnt, 0), 47) ThenBlock: {
                show = 0
            }
            IfCondition EqualTo(DfConfig.show_all, 0) ThenBlock: {
                rootfs = StrEq(typ, "rootfs")
                IfCondition EqualTo(rootfs, 1) ThenBlock: {
                    show = 0
                }
            }
            IfCondition EqualTo(show, 1) ThenBlock: {
                ok = TypeOk(dev, typ)
                IfCondition EqualTo(ok, 0) ThenBlock: {
                    show = 0
                }
            }
            IfCondition EqualTo(show, 1) ThenBlock: {
                got = ReadStatfs(mnt)
                IfCondition EqualTo(got, 1) ThenBlock: {
                    IfCondition EqualTo(DfConfig.show_all, 0) ThenBlock: {
                        IfCondition EqualTo(DfStat.blocks, 0) ThenBlock: {
                            show = 0
                        }
                    }
                    IfCondition EqualTo(show, 1) ThenBlock: {
                        dash = "-"
                        EmitRow(dev, typ, dash, mnt, 0)
                    }
                }
            }
            i = Add(i, one)
        }
    }
}

Function.FieldId {
    Input: name: Address
    Output: Integer
    Body: {
        eq = StrEq(name, "source")
        IfCondition EqualTo(eq, 1) ThenBlock: { ReturnValue(0) }
        eq = StrEq(name, "fstype")
        IfCondition EqualTo(eq, 1) ThenBlock: { ReturnValue(1) }
        eq = StrEq(name, "itotal")
        IfCondition EqualTo(eq, 1) ThenBlock: { ReturnValue(2) }
        eq = StrEq(name, "iused")
        IfCondition EqualTo(eq, 1) ThenBlock: { ReturnValue(3) }
        eq = StrEq(name, "iavail")
        IfCondition EqualTo(eq, 1) ThenBlock: { ReturnValue(4) }
        eq = StrEq(name, "ipcent")
        IfCondition EqualTo(eq, 1) ThenBlock: { ReturnValue(5) }
        eq = StrEq(name, "size")
        IfCondition EqualTo(eq, 1) ThenBlock: { ReturnValue(6) }
        eq = StrEq(name, "used")
        IfCondition EqualTo(eq, 1) ThenBlock: { ReturnValue(7) }
        eq = StrEq(name, "avail")
        IfCondition EqualTo(eq, 1) ThenBlock: { ReturnValue(8) }
        eq = StrEq(name, "pcent")
        IfCondition EqualTo(eq, 1) ThenBlock: { ReturnValue(9) }
        eq = StrEq(name, "file")
        IfCondition EqualTo(eq, 1) ThenBlock: { ReturnValue(10) }
        eq = StrEq(name, "target")
        IfCondition EqualTo(eq, 1) ThenBlock: { ReturnValue(11) }
        ReturnValue(-1)
    }
}

Function.AddColumn {
    Input: fid: Integer
    Body: {
        one = 1
        eight = 8
        IfCondition GreaterEqual(DfConfig.ncolumns, 16) ThenBlock: {
            ReturnValue(0)
        }
        off = Multiply(DfConfig.ncolumns, eight)
        ptr = Add(DfConfig.columns, off)
        WRMEM_64(ptr, fid)
        WRMEM_8(DfConfig.used, fid, 1)
        IfCondition EqualTo(fid, 0) ThenBlock: {
            DfConfig.source_used = 1
        }
        DfConfig.ncolumns = Add(DfConfig.ncolumns, one)
        ReturnValue(0)
    }
}

Function.DieDupField {
    Input: name: Address
    Body: {
        WriteErrStr("df: option --output: field '")
        WriteErrStr(name)
        WriteErrStr("' used more than once\n")
        TryHelp()
    }
}

Function.DieBadField {
    Input: name: Address
    Body: {
        WriteErrStr("df: option --output: field '")
        WriteErrStr(name)
        WriteErrStr("' unknown\n")
        TryHelp()
    }
}

Function.DecodeOutput {
    Input: spec: Address
    Body: {
        one = 1
        token = Allocate(64)
        i = 0
        WhileLoop 1 {
            tlen = 0
            WhileLoop 1 {
                ch = RDMEM_8(spec, i)
                IfCondition EqualTo(ch, 0) ThenBlock: {
                    BreakLoop
                }
                IfCondition EqualTo(ch, 44) ThenBlock: {
                    BreakLoop
                }
                IfCondition LessThan(tlen, 63) ThenBlock: {
                    WRMEM_8(token, tlen, ch)
                    tlen = Add(tlen, one)
                }
                i = Add(i, one)
            }
            WRMEM_8(token, tlen, 0)
            IfCondition GreaterThan(tlen, 0) ThenBlock: {
                fid = FieldId(token)
                IfCondition LessThan(fid, 0) ThenBlock: {
                    DieBadField(token)
                }
                used = RDMEM_8(DfConfig.used, fid)
                IfCondition EqualTo(used, 1) ThenBlock: {
                    DieDupField(token)
                }
                AddColumn(fid)
            }
            ch = RDMEM_8(spec, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            i = Add(i, one)
        }
        Deallocate(token, 64)
    }
}

Function.ParseSize {
    Input: spec: Address
    Output: Integer
    Body: {
        one = 1
        ten = 10
        i = 0
        n = 0
        saw = 0
        WhileLoop 1 {
            ch = RDMEM_8(spec, i)
            IfCondition LessThan(ch, 48) ThenBlock: { BreakLoop }
            IfCondition GreaterThan(ch, 57) ThenBlock: { BreakLoop }
            saw = 1
            dig = Subtract(ch, 48)
            n = Multiply(n, ten)
            n = Add(n, dig)
            i = Add(i, one)
        }
        suf = RDMEM_8(spec, i)
        IfCondition EqualTo(suf, 0) ThenBlock: {
            IfCondition EqualTo(saw, 0) ThenBlock: { ReturnValue(-1) }
            ReturnValue(n)
        }
        i2 = Add(i, one)
        suf2 = RDMEM_8(spec, i2)
        IfCondition EqualTo(saw, 0) ThenBlock: {
            n = 1
        }
        base1000 = 0
        IfCondition EqualTo(suf2, 66) ThenBlock: { base1000 = 1 }
        IfCondition EqualTo(suf2, 98) ThenBlock: { base1000 = 1 }
        mult = 0
        IfCondition EqualTo(suf, 75) ThenBlock: { mult = 1024 }
        IfCondition EqualTo(suf, 107) ThenBlock: { mult = 1024 }
        IfCondition EqualTo(suf, 77) ThenBlock: { mult = 1048576 }
        IfCondition EqualTo(suf, 109) ThenBlock: { mult = 1048576 }
        IfCondition EqualTo(suf, 71) ThenBlock: { mult = 1073741824 }
        IfCondition EqualTo(suf, 103) ThenBlock: { mult = 1073741824 }
        IfCondition EqualTo(base1000, 1) ThenBlock: {
            IfCondition EqualTo(mult, 1024) ThenBlock: { mult = 1000 }
            IfCondition EqualTo(mult, 1048576) ThenBlock: { mult = 1000000 }
            IfCondition EqualTo(mult, 1073741824) ThenBlock: { mult = 1000000000 }
        }
        IfCondition LessEqual(mult, 0) ThenBlock: {
            ReturnValue(-1)
        }
        value = Multiply(n, mult)
        ReturnValue(value)
    }
}

Function.StoreType {
    Input: spec: Address
    Input: which: Integer
    Body: {
        one = 1
        n = GetStringLength(spec)
        buf = Allocate(Add(n, one))
        CopyString(buf, spec)
        IfCondition EqualTo(which, 1) ThenBlock: {
            DfConfig.type_excl = buf
        } ElseBlock: {
            DfConfig.type_sel = buf
        }
    }
}

Function.ApplyWithArg {
    Input: code: Integer
    Input: spec: Address
    Body: {
        IfCondition EqualTo(code, 2) ThenBlock: {
            sz = ParseSize(spec)
            IfCondition LessThan(sz, 1) ThenBlock: {
                WriteErrStr("df: invalid block size '")
                WriteErrStr(spec)
                WriteErrStr("'\n")
                TryHelp()
            }
            DfConfig.block_size = sz
            DfConfig.block_set = 1
            DfConfig.human = 0
        }
        IfCondition EqualTo(code, 13) ThenBlock: {
            StoreType(spec, 0)
        }
        IfCondition EqualTo(code, 14) ThenBlock: {
            StoreType(spec, 1)
        }
    }
}

Function.ApplyOutput {
    Input: spec: Address
    Input: has_val: Integer
    Body: {
        IfCondition EqualTo(DfConfig.header_mode, 1) ThenBlock: {
            DieMutex("-i")
        }
        IfCondition EqualTo(DfConfig.posix, 1) ThenBlock: {
            IfCondition NotEqual(DfConfig.header_mode, 4) ThenBlock: {
                DieMutex("-P")
            }
        }
        IfCondition EqualTo(DfConfig.print_type, 1) ThenBlock: {
            DieMutex("-T")
        }
        DfConfig.header_mode = 4
        IfCondition EqualTo(has_val, 1) ThenBlock: {
            DecodeOutput(spec)
        }
    }
}

Function.ApplyInodes {
    Body: {
        IfCondition EqualTo(DfConfig.header_mode, 4) ThenBlock: {
            DieMutex("-i")
        }
        DfConfig.header_mode = 1
    }
}

Function.ApplyPortable {
    Body: {
        IfCondition EqualTo(DfConfig.header_mode, 4) ThenBlock: {
            DieMutex("-P")
        }
        DfConfig.posix = 1
    }
}

Function.ApplyPrintType {
    Body: {
        IfCondition EqualTo(DfConfig.header_mode, 4) ThenBlock: {
            DieMutex("-T")
        }
        DfConfig.print_type = 1
    }
}

Function.ApplyHuman {
    Body: {
        DfConfig.human = 1
        DfConfig.block_size = 1
        DfConfig.block_set = 1
    }
}

Function.ClassifyLong {
    Input: name: Address
    Output: Integer
    Body: {
        one = 1
        hits = 0
        code = 0
        hit = IsPrefix(name, "all")
        IfCondition EqualTo(hit, 1) ThenBlock: { hits = Add(hits, one) code = 1 }
        hit = IsPrefix(name, "block-size")
        IfCondition EqualTo(hit, 1) ThenBlock: { hits = Add(hits, one) code = 2 }
        hit = IsPrefix(name, "inodes")
        IfCondition EqualTo(hit, 1) ThenBlock: { hits = Add(hits, one) code = 3 }
        hit = IsPrefix(name, "human-readable")
        IfCondition EqualTo(hit, 1) ThenBlock: { hits = Add(hits, one) code = 4 }
        hit = IsPrefix(name, "si")
        IfCondition EqualTo(hit, 1) ThenBlock: { hits = Add(hits, one) code = 5 }
        hit = IsPrefix(name, "local")
        IfCondition EqualTo(hit, 1) ThenBlock: { hits = Add(hits, one) code = 6 }
        hit = IsPrefix(name, "output")
        IfCondition EqualTo(hit, 1) ThenBlock: { hits = Add(hits, one) code = 7 }
        hit = IsPrefix(name, "portability")
        IfCondition EqualTo(hit, 1) ThenBlock: { hits = Add(hits, one) code = 8 }
        hit = IsPrefix(name, "print-type")
        IfCondition EqualTo(hit, 1) ThenBlock: { hits = Add(hits, one) code = 9 }
        hit = IsPrefix(name, "sync")
        IfCondition EqualTo(hit, 1) ThenBlock: { hits = Add(hits, one) code = 10 }
        hit = IsPrefix(name, "no-sync")
        IfCondition EqualTo(hit, 1) ThenBlock: { hits = Add(hits, one) code = 11 }
        hit = IsPrefix(name, "total")
        IfCondition EqualTo(hit, 1) ThenBlock: { hits = Add(hits, one) code = 12 }
        hit = IsPrefix(name, "type")
        IfCondition EqualTo(hit, 1) ThenBlock: { hits = Add(hits, one) code = 13 }
        hit = IsPrefix(name, "exclude-type")
        IfCondition EqualTo(hit, 1) ThenBlock: { hits = Add(hits, one) code = 14 }
        hit = IsPrefix(name, "help")
        IfCondition EqualTo(hit, 1) ThenBlock: { hits = Add(hits, one) code = 15 }
        hit = IsPrefix(name, "version")
        IfCondition EqualTo(hit, 1) ThenBlock: { hits = Add(hits, one) code = 16 }
        IfCondition EqualTo(hits, 1) ThenBlock: { ReturnValue(code) }
        IfCondition EqualTo(hits, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(-1)
    }
}

Function.ShowHelp {
    Body: {
        WriteOutStr("Usage: df [OPTION]... [FILE]...\n")
        WriteOutStr("Show information about the file system on which each FILE resides,\n")
        WriteOutStr("or all file systems by default.\n")
        WriteOutStr("  -a, --all             include pseudo, duplicate, inaccessible file systems\n")
        WriteOutStr("  -B, --block-size=SIZE  scale sizes by SIZE before printing them\n")
        WriteOutStr("  -h, --human-readable  print sizes in powers of 1024 (e.g., 1023M)\n")
        WriteOutStr("  -H, --si              print sizes in powers of 1000 (e.g., 1.1G)\n")
        WriteOutStr("  -i, --inodes          list inode information instead of block usage\n")
        WriteOutStr("  -k                    like --block-size=1K\n")
        WriteOutStr("  -l, --local           limit listing to local file systems\n")
        WriteOutStr("      --output[=FIELD_LIST]  use the output format defined by FIELD_LIST,\n")
        WriteOutStr("                               or print all fields if FIELD_LIST is omitted.\n")
        WriteOutStr("  -P, --portability     use the POSIX output format\n")
        WriteOutStr("      --total           produce a grand total\n")
        WriteOutStr("  -t, --type=TYPE       limit listing to file systems of type TYPE\n")
        WriteOutStr("  -T, --print-type      print file system type\n")
        WriteOutStr("  -x, --exclude-type=TYPE   limit listing to file systems not of type TYPE\n")
        WriteOutStr("  -v                    (ignored)\n")
        WriteOutStr("      --help        display this help and exit\n")
        WriteOutStr("      --version     output version information and exit\n")
        WriteOutStr("\n")
        WriteOutStr("FIELD_LIST is a comma-separated list of columns to be included.  Valid\n")
        WriteOutStr("field names are: 'source', 'fstype', 'itotal', 'iused', 'iavail', 'ipcent',\n")
        WriteOutStr("'size', 'used', 'avail', 'pcent', 'file' and 'target'.\n")
        SystemCall(60, 0)
    }
}

Function.ShowVersion {
    Body: {
        WriteOutStr("df (AILANG coreutils) 9.4\n")
        SystemCall(60, 0)
    }
}

Function.ApplyCode {
    Input: code: Integer
    Body: {
        IfCondition EqualTo(code, 1) ThenBlock: { DfConfig.show_all = 1 }
        IfCondition EqualTo(code, 3) ThenBlock: { ApplyInodes() }
        IfCondition EqualTo(code, 4) ThenBlock: { ApplyHuman() }
        IfCondition EqualTo(code, 5) ThenBlock: { ApplyHuman() }
        IfCondition EqualTo(code, 6) ThenBlock: { DfConfig.show_local = 1 }
        IfCondition EqualTo(code, 8) ThenBlock: { ApplyPortable() }
        IfCondition EqualTo(code, 9) ThenBlock: { ApplyPrintType() }
        IfCondition EqualTo(code, 12) ThenBlock: { DfConfig.print_total = 1 }
        IfCondition EqualTo(code, 15) ThenBlock: { ShowHelp() }
        IfCondition EqualTo(code, 16) ThenBlock: { ShowVersion() }
    }
}

Function.ParseLong {
    Input: arg: Address
    Body: {
        one = 1
        name = Allocate(128)
        val = Allocate(1024)
        WRMEM_8(name, 0, 0)
        WRMEM_8(val, 0, 0)
        i = 2
        phase = 0
        nlen = 0
        vlen = 0
        WhileLoop 1 {
            ch = RDMEM_8(arg, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition EqualTo(phase, 0) ThenBlock: {
                IfCondition EqualTo(ch, 61) ThenBlock: {
                    phase = 1
                } ElseBlock: {
                    IfCondition LessThan(nlen, 127) ThenBlock: {
                        WRMEM_8(name, nlen, ch)
                        nlen = Add(nlen, one)
                    }
                }
            } ElseBlock: {
                IfCondition LessThan(vlen, 1023) ThenBlock: {
                    WRMEM_8(val, vlen, ch)
                    vlen = Add(vlen, one)
                }
            }
            i = Add(i, one)
        }
        WRMEM_8(name, nlen, 0)
        WRMEM_8(val, vlen, 0)
        code = ClassifyLong(name)
        IfCondition EqualTo(code, 0) ThenBlock: {
            WriteErrStr("df: unrecognized option '--")
            WriteErrStr(name)
            WriteErrStr("'\n")
            TryHelp()
        }
        IfCondition LessThan(code, 0) ThenBlock: {
            WriteErrStr("df: option '--")
            WriteErrStr(name)
            WriteErrStr("' is ambiguous\n")
            TryHelp()
        }
        IfCondition EqualTo(code, 7) ThenBlock: {
            ApplyOutput(val, phase)
        } ElseBlock: {
            needs = 0
            IfCondition EqualTo(code, 2) ThenBlock: { needs = 1 }
            IfCondition EqualTo(code, 13) ThenBlock: { needs = 1 }
            IfCondition EqualTo(code, 14) ThenBlock: { needs = 1 }
            IfCondition EqualTo(needs, 1) ThenBlock: {
                IfCondition EqualTo(phase, 1) ThenBlock: {
                    ApplyWithArg(code, val)
                } ElseBlock: {
                    DfConfig.pending = code
                }
            } ElseBlock: {
                ApplyCode(code)
            }
        }
        Deallocate(name, 128)
        Deallocate(val, 1024)
    }
}

Function.ParseShort {
    Input: arg: Address
    Input: alen: Integer
    Body: {
        one = 1
        i = 1
        WhileLoop LessThan(i, alen) {
            c = RDMEM_8(arg, i)
            i = Add(i, one)
            takes = 0
            code = 0
            IfCondition EqualTo(c, 66) ThenBlock: { takes = 1 code = 2 }
            IfCondition EqualTo(c, 70) ThenBlock: { takes = 1 code = 13 }
            IfCondition EqualTo(c, 116) ThenBlock: { takes = 1 code = 13 }
            IfCondition EqualTo(c, 120) ThenBlock: { takes = 1 code = 14 }
            IfCondition EqualTo(takes, 1) ThenBlock: {
                IfCondition LessThan(i, alen) ThenBlock: {
                    rest = Add(arg, i)
                    ApplyWithArg(code, rest)
                } ElseBlock: {
                    DfConfig.pending = code
                }
                BreakLoop
            }
            known = 0
            IfCondition EqualTo(c, 97) ThenBlock: { DfConfig.show_all = 1 known = 1 }
            IfCondition EqualTo(c, 105) ThenBlock: { ApplyInodes() known = 1 }
            IfCondition EqualTo(c, 104) ThenBlock: { ApplyHuman() known = 1 }
            IfCondition EqualTo(c, 72) ThenBlock: { ApplyHuman() known = 1 }
            IfCondition EqualTo(c, 107) ThenBlock: {
                DfConfig.human = 0
                DfConfig.block_size = 1024
                DfConfig.block_set = 1
                known = 1
            }
            IfCondition EqualTo(c, 108) ThenBlock: { DfConfig.show_local = 1 known = 1 }
            IfCondition EqualTo(c, 109) ThenBlock: {
                DfConfig.human = 0
                DfConfig.block_size = 1048576
                DfConfig.block_set = 1
                known = 1
            }
            IfCondition EqualTo(c, 80) ThenBlock: { ApplyPortable() known = 1 }
            IfCondition EqualTo(c, 84) ThenBlock: { ApplyPrintType() known = 1 }
            IfCondition EqualTo(c, 118) ThenBlock: { known = 1 }
            IfCondition EqualTo(known, 0) ThenBlock: {
                WriteErrStr("df: invalid option -- '")
                chbuf = Allocate(2)
                WRMEM_8(chbuf, 0, c)
                WRMEM_8(chbuf, 1, 0)
                WriteErrStr(chbuf)
                Deallocate(chbuf, 2)
                WriteErrStr("'\n")
                TryHelp()
            }
        }
    }
}

Function.SaveFile {
    Input: arg: Address
    Input: alen: Integer
    Body: {
        one = 1
        eight = 8
        IfCondition GreaterEqual(DfConfig.nargs, 64) ThenBlock: {
            ReturnValue(0)
        }
        nbuf = Add(alen, one)
        copy = Allocate(nbuf)
        k = 0
        WhileLoop LessThan(k, alen) {
            WRMEM_8(copy, k, RDMEM_8(arg, k))
            k = Add(k, one)
        }
        WRMEM_8(copy, alen, 0)
        off = Multiply(DfConfig.nargs, eight)
        slot = Add(DfConfig.args, off)
        WRMEM_64(slot, copy)
        DfConfig.nargs = Add(DfConfig.nargs, one)
        ReturnValue(0)
    }
}

Function.ParseCommandLine {
    Input: buf: Address
    Body: {
        one = 1
        DfConfig.scan = 0
        WhileLoop LessThan(DfConfig.scan, 16380) {
            ch = RDMEM_8(buf, DfConfig.scan)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            DfConfig.scan = Add(DfConfig.scan, one)
        }
        IfCondition LessThan(DfConfig.scan, 16380) ThenBlock: {
            DfConfig.scan = Add(DfConfig.scan, one)
        }
        guard = 0
        WhileLoop LessThan(guard, 200) {
            guard = Add(guard, one)
            IfCondition GreaterEqual(DfConfig.scan, 16380) ThenBlock: {
                BreakLoop
            }
            ch = RDMEM_8(buf, DfConfig.scan)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            arg = Allocate(4096)
            alen = 0
            WhileLoop LessThan(DfConfig.scan, 16380) {
                ch = RDMEM_8(buf, DfConfig.scan)
                IfCondition EqualTo(ch, 0) ThenBlock: {
                    BreakLoop
                }
                IfCondition LessThan(alen, 4095) ThenBlock: {
                    WRMEM_8(arg, alen, ch)
                    alen = Add(alen, one)
                }
                DfConfig.scan = Add(DfConfig.scan, one)
            }
            WRMEM_8(arg, alen, 0)
            IfCondition LessThan(DfConfig.scan, 16380) ThenBlock: {
                DfConfig.scan = Add(DfConfig.scan, one)
            }
            IfCondition NotEqual(DfConfig.pending, 0) ThenBlock: {
                ApplyWithArg(DfConfig.pending, arg)
                DfConfig.pending = 0
            } ElseBlock: {
                opt = 0
                IfCondition EqualTo(DfConfig.end_opts, 0) ThenBlock: {
                    IfCondition EqualTo(RDMEM_8(arg, 0), 45) ThenBlock: {
                        opt = 1
                    }
                }
                IfCondition EqualTo(opt, 1) ThenBlock: {
                    IfCondition EqualTo(RDMEM_8(arg, 1), 45) ThenBlock: {
                        IfCondition EqualTo(RDMEM_8(arg, 2), 0) ThenBlock: {
                            DfConfig.end_opts = 1
                        } ElseBlock: {
                            ParseLong(arg)
                        }
                    } ElseBlock: {
                        ParseShort(arg, alen)
                    }
                } ElseBlock: {
                    SaveFile(arg, alen)
                }
            }
            Deallocate(arg, 4096)
        }
        IfCondition NotEqual(DfConfig.pending, 0) ThenBlock: {
            WriteErrStr("df: option requires an argument\n")
            TryHelp()
        }
    }
}

Function.FinishModes {
    Body: {
        IfCondition EqualTo(DfConfig.block_set, 0) ThenBlock: {
            DfConfig.block_size = 1024
        }
        keep = 0
        IfCondition EqualTo(DfConfig.header_mode, 1) ThenBlock: { keep = 1 }
        IfCondition EqualTo(DfConfig.header_mode, 4) ThenBlock: { keep = 1 }
        IfCondition EqualTo(keep, 0) ThenBlock: {
            IfCondition EqualTo(DfConfig.human, 1) ThenBlock: {
                DfConfig.header_mode = 2
            } ElseBlock: {
                IfCondition EqualTo(DfConfig.posix, 1) ThenBlock: {
                    DfConfig.header_mode = 3
                } ElseBlock: {
                    DfConfig.header_mode = 0
                }
            }
        }
    }
}

Function.SetupColumns {
    Body: {
        IfCondition EqualTo(DfConfig.header_mode, 4) ThenBlock: {
            IfCondition EqualTo(DfConfig.ncolumns, 0) ThenBlock: {
                DecodeOutput("source,fstype,itotal,iused,iavail,ipcent,size,used,avail,pcent,file,target")
            }
            ReturnValue(0)
        }
        AddColumn(0)
        IfCondition EqualTo(DfConfig.print_type, 1) ThenBlock: {
            AddColumn(1)
        }
        IfCondition EqualTo(DfConfig.header_mode, 1) ThenBlock: {
            AddColumn(2)
            AddColumn(3)
            AddColumn(4)
            AddColumn(5)
            AddColumn(11)
        } ElseBlock: {
            AddColumn(6)
            AddColumn(7)
            AddColumn(8)
            AddColumn(9)
            AddColumn(11)
        }
        ReturnValue(0)
    }
}

Function.PrintTotal {
    Body: {
        src = "total"
        fst = "-"
        fil = "-"
        tgt = "-"
        IfCondition EqualTo(DfConfig.source_used, 0) ThenBlock: {
            tgt = "total"
        }
        EmitRow(src, fst, fil, tgt, 1)
    }
}

Function.InitBuffers {
    Body: {
        one = 1
        DfConfig.mounts = Allocate(106496)
        DfConfig.columns = Allocate(128)
        DfConfig.used = Allocate(16)
        DfConfig.args = Allocate(512)
        k = 0
        WhileLoop LessThan(k, 16) {
            WRMEM_8(DfConfig.used, k, 0)
            k = Add(k, one)
        }
        DfConfig.best = -1
        DfConfig.block_size = 1024
    }
}

Function.ArgAt {
    Input: index: Integer
    Output: Address
    Body: {
        eight = 8
        off = Multiply(index, eight)
        slot = Add(DfConfig.args, off)
        ptr = RDMEM_64(slot)
        ReturnValue(ptr)
    }
}

SubRoutine.Main {
    one = 1
    InitBuffers()
    args_buffer = GetArgs()
    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        WriteErrStr("df: cannot read arguments\n")
        SystemCall(60, 1)
    }
    ParseCommandLine(args_buffer)
    FinishModes()
    SetupColumns()
    LoadAllMounts()
    IfCondition EqualTo(DfConfig.nargs, 0) ThenBlock: {
        ListAll()
    } ElseBlock: {
        i = 0
        WhileLoop LessThan(i, DfConfig.nargs) {
            path = ArgAt(i)
            HandleFile(path)
            i = Add(i, one)
        }
    }
    IfCondition GreaterThan(DfConfig.printed, 0) ThenBlock: {
        IfCondition EqualTo(DfConfig.print_total, 1) ThenBlock: {
            PrintTotal()
        }
    } ElseBlock: {
        IfCondition EqualTo(DfConfig.exit_status, 0) ThenBlock: {
            WriteErrStr("df: no file systems processed\n")
            DfConfig.exit_status = 1
        }
    }
    Deallocate(args_buffer, 16384)
    SystemCall(60, DfConfig.exit_status)
}

RunTask(Main)
