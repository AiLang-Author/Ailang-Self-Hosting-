// dirname.ailang - Strip the last component from each path

LibraryImport.Arena

FixedPool.DirOpt {
    "nread": Initialize=0
    "pos": Initialize=0
}

Function.WriteStdout {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 1, buffer, len)
    }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.DieMissing {
    Body: {
        WriteStderr("dirname: missing operand\n")
        WriteStderr("Try 'dirname --help' for more information.\n")
        SystemCall(60, 1)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        DirOpt.nread = bytes_read
        ReturnValue(buffer)
    }
}

Function.EmitDot {
    Body: {
        WriteStdout(".\n", 2)
        ReturnValue(0)
    }
}

Function.EmitSlash {
    Body: {
        WriteStdout("/\n", 2)
        ReturnValue(0)
    }
}

Function.EmitDir {
    Input: path: Address
    Input: path_len: Integer
    Body: {
        IfCondition EqualTo(path_len, 0) ThenBlock: {
            EmitDot()
            ReturnValue(0)
        }
        end_pos = Subtract(path_len, 1)
        WhileLoop GreaterEqual(end_pos, 0) {
            ch = RDMEM_8(path, end_pos)
            IfCondition NotEqual(ch, 47) ThenBlock: {
                BreakLoop
            }
            end_pos = Subtract(end_pos, 1)
        }
        IfCondition LessThan(end_pos, 0) ThenBlock: {
            EmitSlash()
            ReturnValue(0)
        }
        last_slash = -1
        i = 0
        WhileLoop LessEqual(i, end_pos) {
            ch = RDMEM_8(path, i)
            IfCondition EqualTo(ch, 47) ThenBlock: {
                last_slash = i
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(last_slash, 0) ThenBlock: {
            EmitDot()
            ReturnValue(0)
        }
        IfCondition EqualTo(last_slash, 0) ThenBlock: {
            EmitSlash()
            ReturnValue(0)
        }
        pend = Subtract(last_slash, 1)
        WhileLoop GreaterEqual(pend, 0) {
            ch = RDMEM_8(path, pend)
            IfCondition NotEqual(ch, 47) ThenBlock: {
                BreakLoop
            }
            pend = Subtract(pend, 1)
        }
        IfCondition LessThan(pend, 0) ThenBlock: {
            EmitSlash()
            ReturnValue(0)
        }
        len = Add(pend, 1)
        out_buf = Allocate(Add(len, 1))
        MemoryCopy(out_buf, path, len)
        WRMEM_8(out_buf, len, 10)
        WriteStdout(out_buf, Add(len, 1))
        Deallocate(out_buf, Add(len, 1))
        ReturnValue(0)
    }
}

SubRoutine.Main {
    args_buffer = GetArgs()
    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        DieMissing()
    }
    DirOpt.pos = 0
    WhileLoop NotEqual(RDMEM_8(args_buffer, DirOpt.pos), 0) {
        DirOpt.pos = Add(DirOpt.pos, 1)
    }
    DirOpt.pos = Add(DirOpt.pos, 1)
    limit = DirOpt.nread
    IfCondition GreaterEqual(DirOpt.pos, limit) ThenBlock: {
        DieMissing()
    }
    WhileLoop LessThan(DirOpt.pos, limit) {
        ch = RDMEM_8(args_buffer, DirOpt.pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            EmitDir(args_buffer, 0)
            DirOpt.pos = Add(DirOpt.pos, 1)
        } ElseBlock: {
            path = Add(args_buffer, DirOpt.pos)
            path_len = 0
            WhileLoop NotEqual(RDMEM_8(args_buffer, DirOpt.pos), 0) {
                path_len = Add(path_len, 1)
                DirOpt.pos = Add(DirOpt.pos, 1)
            }
            EmitDir(path, path_len)
            DirOpt.pos = Add(DirOpt.pos, 1)
        }
    }
    Deallocate(args_buffer, 4096)
    SystemCall(60, 0)
}

RunTask(Main)
