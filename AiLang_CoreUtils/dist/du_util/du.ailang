// du.ailang - disk usage, GNU coreutils 9.4 tests/du subset
// Sizes are 64-bit. Directories are printed post-order. Apparent size
// counts st_size only for regular files and symlinks.

LibraryImport.Arena

FixedPool.DuConfig {
    "human": Initialize=0
    "summarize": Initialize=0
    "all_files": Initialize=0
    "max_depth": Initialize=1000000
    "depth_set": Initialize=0
    "apparent": Initialize=0
    "total": Initialize=0
    "separate": Initialize=0
    "inodes": Initialize=0
    "one_fs": Initialize=0
    "count_links": Initialize=0
    "deref": Initialize=0
    "block_size": Initialize=1024
    "hash_all": Initialize=0
    "exit_status": Initialize=0
    "nexclude": Initialize=0
    "exclude_base": Initialize=0
    "seen": Initialize=0
    "cycle": Initialize=0
    "grand": Initialize=0
    "root_dev": Initialize=0
    "threshold": Initialize=0
    "threshold_neg": Initialize=0
    "files_from": Initialize=0
    "from_stdin": Initialize=0
    "scan": Initialize=0
    "pos": Initialize=0
    "class_end": Initialize=0
    "nops": Initialize=0
    "ops": Initialize=0
    "pending": Initialize=0
    "pending_short": Initialize=0
    "show_help": Initialize=0
    "show_version": Initialize=0
    "fail": Initialize=0
}

Function.WriteStdout {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 1, buffer, len)
    }
}

Function.WriteStderr {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 2, buffer, len)
    }
}

Function.StrLen {
    Input: str: Address
    Output: Integer
    Body: {
        len = 0
        one = 1
        WhileLoop NotEqual(RDMEM_8(str, len), 0) {
            len = Add(len, one)
        }
        ReturnValue(len)
    }
}

Function.WriteStr {
    Input: str: Address
    Body: {
        n = StrLen(str)
        WriteStdout(str, n)
    }
}

Function.WriteErr {
    Input: str: Address
    Body: {
        n = StrLen(str)
        WriteStderr(str, n)
    }
}

Function.ConvertNumberToString {
    Input: num: Integer
    Output: Address
    Body: {
        buffer = Allocate(32)
        IfCondition EqualTo(num, 0) ThenBlock: {
            WRMEM_8(buffer, 0, 48)
            WRMEM_8(buffer, 1, 0)
            ReturnValue(buffer)
        }
        pos = 0
        temp = Allocate(32)
        one = 1
        WhileLoop GreaterThan(num, 0) {
            digit = Modulo(num, 10)
            WRMEM_8(temp, pos, Add(48, digit))
            pos = Add(pos, one)
            num = Divide(num, 10)
        }
        write_pos = 0
        i = Subtract(pos, one)
        WhileLoop GreaterEqual(i, 0) {
            ch = RDMEM_8(temp, i)
            WRMEM_8(buffer, write_pos, ch)
            write_pos = Add(write_pos, one)
            i = Subtract(i, one)
        }
        WRMEM_8(buffer, write_pos, 0)
        Deallocate(temp, 32)
        ReturnValue(buffer)
    }
}

Function.GetUInt64 {
    Input: addr: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        ptr = Add(addr, offset)
        b0 = RDMEM_8(ptr, 0)
        b1 = RDMEM_8(ptr, 1)
        b2 = RDMEM_8(ptr, 2)
        b3 = RDMEM_8(ptr, 3)
        b4 = RDMEM_8(ptr, 4)
        b5 = RDMEM_8(ptr, 5)
        b6 = RDMEM_8(ptr, 6)
        b7 = RDMEM_8(ptr, 7)
        lo = Add(b0, Multiply(b1, 256))
        lo = Add(lo, Multiply(b2, 65536))
        lo = Add(lo, Multiply(b3, 16777216))
        hi = Add(b4, Multiply(b5, 256))
        hi = Add(hi, Multiply(b6, 65536))
        hi = Add(hi, Multiply(b7, 16777216))
        value = Add(lo, Multiply(hi, 4294967296))
        ReturnValue(value)
    }
}

Function.CeilDiv {
    Input: n: Integer
    Input: d: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(d, 0) ThenBlock: {
            ReturnValue(n)
        }
        q = Divide(n, d)
        prod = Multiply(q, d)
        IfCondition NotEqual(prod, n) ThenBlock: {
            q = Add(q, 1)
        }
        ReturnValue(q)
    }
}

Function.StrEq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, 4096) {
            ca = RDMEM_8(a, i)
            cb = RDMEM_8(b, i)
            IfCondition NotEqual(ca, cb) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(ca, 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.CopyInto {
    Input: dest: Address
    Input: src: Address
    Input: cap: Integer
    Body: {
        i = 0
        one = 1
        last = Subtract(cap, one)
        WhileLoop LessThan(i, last) {
            c = RDMEM_8(src, i)
            WRMEM_8(dest, i, c)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        WRMEM_8(dest, last, 0)
    }
}

Function.CopyArg {
    Input: buf: Address
    Input: at: Integer
    Output: Address
    Body: {
        dest = Allocate(1024)
        i = 0
        one = 1
        WhileLoop LessThan(i, 1023) {
            c = RDMEM_8(buf, Add(at, i))
            WRMEM_8(dest, i, c)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(dest)
            }
            i = Add(i, one)
        }
        WRMEM_8(dest, 1023, 0)
        ReturnValue(dest)
    }
}

Function.EndsSlash {
    Input: path: Address
    Output: Integer
    Body: {
        n = StrLen(path)
        IfCondition EqualTo(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        prev = Subtract(n, one)
        c = RDMEM_8(path, prev)
        IfCondition EqualTo(c, 47) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.PrintHelp {
    Body: {
        WriteStdout("Usage: du [OPTION]... [FILE]...\n", 32)
        WriteStdout("  or:  du [OPTION]... --files0-from=F\n", 38)
        WriteStdout("Summarize device usage of the set of FILEs, recursively for directories.\n\n", 74)
        WriteStdout("  -a, --all             write counts for all files, not just directories\n", 73)
        WriteStdout("  -b, --bytes           equivalent to '--apparent-size --block-size=1'\n", 71)
        WriteStdout("  -c, --total           produce a grand total\n", 46)
        WriteStdout("  -d, --max-depth=N     print the total for a directory only if it is\n", 70)
        WriteStdout("                          N or fewer levels below the command line\n", 67)
        WriteStdout("  -h, --human-readable  print sizes in human readable format\n", 61)
        WriteStdout("  -l, --count-links     count sizes many times if hard linked\n", 62)
        WriteStdout("  -s, --summarize       display only a total for each argument\n", 63)
        WriteStdout("  -S, --separate-dirs   for directories do not include size of subdirectories\n", 78)
        WriteStdout("  -x, --one-file-system skip directories on different file systems\n", 67)
        WriteStdout("  -L, --dereference     dereference all symbolic links\n", 55)
        WriteStdout("  -D, --dereference-args  dereference only symlinks that are listed\n", 68)
        WriteStdout("      --apparent-size   print apparent sizes rather than device usage\n", 70)
        WriteStdout("      --inodes          list inode usage information instead of block usage\n", 76)
        WriteStdout("      --exclude=PATTERN exclude files that match PATTERN\n", 57)
        WriteStdout("  -X, --exclude-from=FILE  exclude files that match any pattern in FILE\n", 72)
        WriteStdout("      --files0-from=F   summarize device usage of the NUL-terminated file names\n", 80)
        WriteStdout("      --help            display this help and exit\n", 51)
        WriteStdout("      --version         output version information and exit\n", 60)
    }
}

Function.ShowVersion {
    Body: {
        WriteStdout("du (AILANG coreutils) 9.4\n", 26)
    }
}

Function.WriteErrno {
    Input: err: Integer
    Body: {
        IfCondition EqualTo(err, 2) ThenBlock: {
            WriteStderr("No such file or directory", 25)
            ReturnValue(0)
        }
        IfCondition EqualTo(err, 13) ThenBlock: {
            WriteStderr("Permission denied", 17)
            ReturnValue(0)
        }
        IfCondition EqualTo(err, 40) ThenBlock: {
            WriteStderr("Too many levels of symbolic links", 33)
            ReturnValue(0)
        }
        IfCondition EqualTo(err, 20) ThenBlock: {
            WriteStderr("Not a directory", 15)
            ReturnValue(0)
        }
        IfCondition EqualTo(err, 1) ThenBlock: {
            WriteStderr("Operation not permitted", 23)
            ReturnValue(0)
        }
        WriteStderr("Unknown error", 13)
    }
}

Function.WriteAccess {
    Input: path: Address
    Input: err: Integer
    Body: {
        WriteStderr("du: cannot access '", 19)
        n = StrLen(path)
        WriteStderr(path, n)
        WriteStderr("': ", 3)
        WriteErrno(err)
        WriteStderr("\n", 1)
    }
}

Function.WriteReadDir {
    Input: path: Address
    Input: err: Integer
    Body: {
        WriteStderr("du: cannot read directory '", 27)
        n = StrLen(path)
        WriteStderr(path, n)
        WriteStderr("': ", 3)
        WriteErrno(err)
        WriteStderr("\n", 1)
    }
}

Function.ParseInt {
    Input: str: Address
    Output: Integer
    Body: {
        n = 0
        i = 0
        one = 1
        WhileLoop LessThan(i, 24) {
            c = RDMEM_8(str, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(n)
            }
            IfCondition Or(LessThan(c, 48), GreaterThan(c, 57)) ThenBlock: {
                ReturnValue(n)
            }
            dig = Subtract(c, 48)
            n = Add(Multiply(n, 10), dig)
            i = Add(i, one)
        }
        ReturnValue(n)
    }
}

Function.ParseSize {
    Input: str: Address
    Output: Integer
    Body: {
        n = 0
        i = 0
        one = 1
        WhileLoop LessThan(i, 24) {
            c = RDMEM_8(str, i)
            IfCondition Or(LessThan(c, 48), GreaterThan(c, 57)) ThenBlock: {
                IfCondition EqualTo(c, 75) ThenBlock: {
                    n = Multiply(n, 1024)
                }
                IfCondition EqualTo(c, 107) ThenBlock: {
                    n = Multiply(n, 1000)
                }
                IfCondition EqualTo(c, 77) ThenBlock: {
                    n = Multiply(n, 1048576)
                }
                IfCondition EqualTo(c, 71) ThenBlock: {
                    n = Multiply(n, 1073741824)
                }
                IfCondition EqualTo(n, 0) ThenBlock: {
                    IfCondition EqualTo(c, 0) ThenBlock: {
                        ReturnValue(0)
                    }
                }
                ReturnValue(n)
            }
            dig = Subtract(c, 48)
            n = Add(Multiply(n, 10), dig)
            i = Add(i, one)
        }
        ReturnValue(n)
    }
}

Function.FormatHuman {
    Input: n: Integer
    Input: base: Integer
    Output: Address
    Body: {
        amt = n
        tenths = 0
        rounding = 0
        exponent = 0
        one = 1
        WhileLoop And(GreaterEqual(amt, base), LessThan(exponent, 6)) {
            modb = Modulo(amt, base)
            r10 = Multiply(modb, 10)
            r10 = Add(r10, tenths)
            r10mod = Modulo(r10, base)
            r2 = Multiply(r10mod, 2)
            IfCondition GreaterEqual(rounding, 2) ThenBlock: {
                r2 = Add(r2, one)
            }
            oldr = rounding
            amt = Divide(amt, base)
            tenths = Divide(r10, base)
            sumr = Add(r2, oldr)
            IfCondition LessThan(r2, base) ThenBlock: {
                rounding = 0
                IfCondition NotEqual(sumr, 0) ThenBlock: {
                    rounding = 1
                }
            } ElseBlock: {
                rounding = 2
                IfCondition LessThan(base, sumr) ThenBlock: {
                    rounding = 3
                }
            }
            exponent = Add(exponent, one)
        }
        show_tenths = 0
        IfCondition LessThan(amt, 10) ThenBlock: {
            IfCondition GreaterThan(rounding, 0) ThenBlock: {
                tenths = Add(tenths, one)
                rounding = 0
                IfCondition EqualTo(tenths, 10) ThenBlock: {
                    amt = Add(amt, one)
                    tenths = 0
                }
            }
            IfCondition And(LessThan(amt, 10), GreaterThan(exponent, 0)) ThenBlock: {
                show_tenths = 1
            }
        }
        IfCondition EqualTo(show_tenths, 0) ThenBlock: {
            extra = Add(tenths, rounding)
            IfCondition GreaterThan(extra, 0) ThenBlock: {
                amt = Add(amt, one)
                IfCondition And(EqualTo(amt, base), LessThan(exponent, 6)) ThenBlock: {
                    exponent = Add(exponent, one)
                    amt = 1
                    show_tenths = 1
                    tenths = 0
                }
            }
        }
        buf = Allocate(64)
        num = ConvertNumberToString(amt)
        CopyInto(buf, num, 64)
        Deallocate(num, 32)
        IfCondition NotEqual(show_tenths, 0) ThenBlock: {
            i = 0
            WhileLoop NotEqual(RDMEM_8(buf, i), 0) {
                i = Add(i, one)
            }
            WRMEM_8(buf, i, 46)
            i = Add(i, one)
            WRMEM_8(buf, i, Add(48, tenths))
            i = Add(i, one)
            WRMEM_8(buf, i, 0)
        }
        IfCondition GreaterThan(exponent, 0) ThenBlock: {
            i = 0
            WhileLoop NotEqual(RDMEM_8(buf, i), 0) {
                i = Add(i, one)
            }
            letter = 75
            IfCondition EqualTo(exponent, 2) ThenBlock: {
                letter = 77
            }
            IfCondition EqualTo(exponent, 3) ThenBlock: {
                letter = 71
            }
            IfCondition EqualTo(exponent, 4) ThenBlock: {
                letter = 84
            }
            IfCondition EqualTo(exponent, 5) ThenBlock: {
                letter = 80
            }
            IfCondition EqualTo(exponent, 6) ThenBlock: {
                letter = 69
            }
            IfCondition And(EqualTo(base, 1000), EqualTo(exponent, 1)) ThenBlock: {
                letter = 107
            }
            WRMEM_8(buf, i, letter)
            i = Add(i, one)
            WRMEM_8(buf, i, 0)
        }
        ReturnValue(buf)
    }
}

Function.PrintSize {
    Input: size: Integer
    Input: path: Address
    Body: {
        IfCondition NotEqual(DuConfig.inodes, 0) ThenBlock: {
            IfCondition EqualTo(DuConfig.human, 1) ThenBlock: {
                text = FormatHuman(size, 1024)
                WriteStr(text)
                Deallocate(text, 64)
            }
            IfCondition EqualTo(DuConfig.human, 2) ThenBlock: {
                text = FormatHuman(size, 1000)
                WriteStr(text)
                Deallocate(text, 64)
            }
            IfCondition EqualTo(DuConfig.human, 0) ThenBlock: {
                text = ConvertNumberToString(size)
                WriteStr(text)
                Deallocate(text, 32)
            }
        } ElseBlock: {
            IfCondition EqualTo(DuConfig.human, 1) ThenBlock: {
                text = FormatHuman(size, 1024)
                WriteStr(text)
                Deallocate(text, 64)
            }
            IfCondition EqualTo(DuConfig.human, 2) ThenBlock: {
                text = FormatHuman(size, 1000)
                WriteStr(text)
                Deallocate(text, 64)
            }
            IfCondition EqualTo(DuConfig.human, 0) ThenBlock: {
                q = CeilDiv(size, DuConfig.block_size)
                text = ConvertNumberToString(q)
                WriteStr(text)
                Deallocate(text, 32)
            }
        }
        WriteStdout("\t", 1)
        WriteStr(path)
        WriteStdout("\n", 1)
    }
}

Function.ClassOk {
    Input: pat: Address
    Input: ch: Integer
    Output: Integer
    Body: {
        one = 1
        DuConfig.scan = 1
        neg = 0
        c0 = RDMEM_8(pat, 1)
        IfCondition EqualTo(c0, 94) ThenBlock: {
            neg = 1
            DuConfig.scan = 2
        }
        matched = 0
        WhileLoop LessThan(DuConfig.scan, 200) {
            c = RDMEM_8(pat, DuConfig.scan)
            IfCondition EqualTo(c, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition EqualTo(c, 93) ThenBlock: {
                BreakLoop
            }
            i1 = Add(DuConfig.scan, one)
            c1 = RDMEM_8(pat, i1)
            i2 = Add(i1, one)
            c2 = RDMEM_8(pat, i2)
            range = 0
            IfCondition EqualTo(c1, 45) ThenBlock: {
                IfCondition And(NotEqual(c2, 0), NotEqual(c2, 93)) ThenBlock: {
                    range = 1
                }
            }
            IfCondition NotEqual(range, 0) ThenBlock: {
                IfCondition And(GreaterEqual(ch, c), LessEqual(ch, c2)) ThenBlock: {
                    matched = 1
                }
                DuConfig.scan = Add(i2, one)
            } ElseBlock: {
                IfCondition EqualTo(ch, c) ThenBlock: {
                    matched = 1
                }
                DuConfig.scan = Add(DuConfig.scan, one)
            }
        }
        DuConfig.class_end = Add(DuConfig.scan, one)
        IfCondition NotEqual(neg, 0) ThenBlock: {
            IfCondition EqualTo(matched, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        ReturnValue(matched)
    }
}

Function.WildMatch {
    Input: pat: Address
    Input: text: Address
    Output: Integer
    Body: {
        pc = RDMEM_8(pat, 0)
        tc = RDMEM_8(text, 0)
        one = 1
        IfCondition EqualTo(pc, 0) ThenBlock: {
            IfCondition EqualTo(tc, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(pc, 42) ThenBlock: {
            pnext = Add(pat, one)
            r = WildMatch(pnext, text)
            IfCondition NotEqual(r, 0) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(tc, 0) ThenBlock: {
                ReturnValue(0)
            }
            tnext = Add(text, one)
            r = WildMatch(pat, tnext)
            ReturnValue(r)
        }
        IfCondition EqualTo(pc, 63) ThenBlock: {
            IfCondition EqualTo(tc, 0) ThenBlock: {
                ReturnValue(0)
            }
            pnext = Add(pat, one)
            tnext = Add(text, one)
            r = WildMatch(pnext, tnext)
            ReturnValue(r)
        }
        IfCondition EqualTo(pc, 91) ThenBlock: {
            IfCondition EqualTo(tc, 0) ThenBlock: {
                ReturnValue(0)
            }
            ok = ClassOk(pat, tc)
            IfCondition EqualTo(ok, 0) ThenBlock: {
                ReturnValue(0)
            }
            pend = Add(pat, DuConfig.class_end)
            tnext = Add(text, one)
            r = WildMatch(pend, tnext)
            ReturnValue(r)
        }
        IfCondition NotEqual(pc, tc) ThenBlock: {
            ReturnValue(0)
        }
        pnext = Add(pat, one)
        tnext = Add(text, one)
        r = WildMatch(pnext, tnext)
        ReturnValue(r)
    }
}

Function.HasWild {
    Input: pat: Address
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, 256) {
            c = RDMEM_8(pat, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(c, 42) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(c, 63) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(c, 91) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.SuffixHit {
    Input: pat: Address
    Input: text: Address
    Input: wild: Integer
    Output: Integer
    Body: {
        one = 1
        r = 0
        IfCondition NotEqual(wild, 0) ThenBlock: {
            r = WildMatch(pat, text)
        } ElseBlock: {
            r = StrEq(pat, text)
        }
        IfCondition NotEqual(r, 0) ThenBlock: {
            ReturnValue(1)
        }
        DuConfig.pos = 0
        WhileLoop LessThan(DuConfig.pos, 4096) {
            c = RDMEM_8(text, DuConfig.pos)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(c, 47) ThenBlock: {
                nxt = Add(DuConfig.pos, one)
                c2 = RDMEM_8(text, nxt)
                IfCondition And(NotEqual(c2, 0), NotEqual(c2, 47)) ThenBlock: {
                    rest = Add(text, nxt)
                    IfCondition NotEqual(wild, 0) ThenBlock: {
                        r = WildMatch(pat, rest)
                    } ElseBlock: {
                        r = StrEq(pat, rest)
                    }
                    IfCondition NotEqual(r, 0) ThenBlock: {
                        ReturnValue(1)
                    }
                }
            }
            DuConfig.pos = Add(DuConfig.pos, one)
        }
        ReturnValue(0)
    }
}

Function.StorePattern {
    Input: src: Address
    Body: {
        IfCondition GreaterEqual(DuConfig.nexclude, 32) ThenBlock: {
            ReturnValue(0)
        }
        off = Multiply(DuConfig.nexclude, 256)
        dest = Add(DuConfig.exclude_base, off)
        CopyInto(dest, src, 256)
        one = 1
        DuConfig.nexclude = Add(DuConfig.nexclude, one)
    }
}

Function.Excluded {
    Input: path: Address
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, DuConfig.nexclude) {
            off = Multiply(i, 256)
            pat = Add(DuConfig.exclude_base, off)
            wild = HasWild(pat)
            hit = SuffixHit(pat, path, wild)
            IfCondition NotEqual(hit, 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.LoadExcludeFile {
    Input: path: Address
    Body: {
        fd = SystemCall(257, -100, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            WriteStderr("du: cannot open '", 17)
            n = StrLen(path)
            WriteStderr(path, n)
            WriteStderr("' for reading: ", 15)
            err = Subtract(0, fd)
            WriteErrno(err)
            WriteStderr("\n", 1)
            DuConfig.fail = 1
            ReturnValue(0)
        }
        buf = Allocate(8192)
        nread = SystemCall(0, fd, buf, 8191)
        SystemCall(3, fd)
        IfCondition LessThan(nread, 0) ThenBlock: {
            nread = 0
        }
        WRMEM_8(buf, nread, 0)
        line = Allocate(256)
        i = 0
        j = 0
        one = 1
        WhileLoop LessEqual(i, nread) {
            c = 0
            IfCondition LessThan(i, nread) ThenBlock: {
                c = RDMEM_8(buf, i)
            }
            IfCondition Or(EqualTo(c, 10), EqualTo(i, nread)) ThenBlock: {
                WRMEM_8(line, j, 0)
                IfCondition GreaterThan(j, 0) ThenBlock: {
                    StorePattern(line)
                }
                j = 0
            } ElseBlock: {
                IfCondition LessThan(j, 255) ThenBlock: {
                    WRMEM_8(line, j, c)
                    j = Add(j, one)
                }
            }
            IfCondition EqualTo(i, nread) ThenBlock: {
                BreakLoop
            }
            i = Add(i, one)
        }
        Deallocate(line, 256)
        Deallocate(buf, 8192)
    }
}

Function.NoteSeen {
    Input: dev: Integer
    Input: ino: Integer
    Output: Integer
    Body: {
        node = DuConfig.seen
        WhileLoop NotEqual(node, 0) {
            d = RDMEM_64(node)
            p8 = Add(node, 8)
            n = RDMEM_64(p8)
            IfCondition And(EqualTo(d, dev), EqualTo(n, ino)) ThenBlock: {
                ReturnValue(1)
            }
            p16 = Add(node, 16)
            node = RDMEM_64(p16)
        }
        fresh = Allocate(24)
        p8 = Add(fresh, 8)
        p16 = Add(fresh, 16)
        WRMEM_64(fresh, dev)
        WRMEM_64(p8, ino)
        WRMEM_64(p16, DuConfig.seen)
        DuConfig.seen = fresh
        ReturnValue(0)
    }
}

Function.OnStack {
    Input: dev: Integer
    Input: ino: Integer
    Output: Integer
    Body: {
        node = DuConfig.cycle
        WhileLoop NotEqual(node, 0) {
            d = RDMEM_64(node)
            p8 = Add(node, 8)
            n = RDMEM_64(p8)
            IfCondition And(EqualTo(d, dev), EqualTo(n, ino)) ThenBlock: {
                ReturnValue(1)
            }
            p16 = Add(node, 16)
            node = RDMEM_64(p16)
        }
        ReturnValue(0)
    }
}

Function.PushCycle {
    Input: dev: Integer
    Input: ino: Integer
    Body: {
        fresh = Allocate(24)
        p8 = Add(fresh, 8)
        p16 = Add(fresh, 16)
        WRMEM_64(fresh, dev)
        WRMEM_64(p8, ino)
        WRMEM_64(p16, DuConfig.cycle)
        DuConfig.cycle = fresh
    }
}

Function.PopCycle {
    Body: {
        node = DuConfig.cycle
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        p16 = Add(node, 16)
        nxt = RDMEM_64(p16)
        DuConfig.cycle = nxt
        Deallocate(node, 24)
    }
}

Function.ShouldPrint {
    Input: depth: Integer
    Input: is_dir: Integer
    Input: size: Integer
    Output: Integer
    Body: {
        show = 0
        IfCondition EqualTo(depth, 0) ThenBlock: {
            show = 1
        }
        IfCondition LessEqual(depth, DuConfig.max_depth) ThenBlock: {
            IfCondition NotEqual(is_dir, 0) ThenBlock: {
                show = 1
            }
            IfCondition NotEqual(DuConfig.all_files, 0) ThenBlock: {
                show = 1
            }
        }
        IfCondition EqualTo(show, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(DuConfig.threshold_neg, 0) ThenBlock: {
            IfCondition GreaterThan(size, DuConfig.threshold) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        IfCondition LessThan(size, DuConfig.threshold) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.IsDot {
    Input: name: Address
    Output: Integer
    Body: {
        c0 = RDMEM_8(name, 0)
        IfCondition NotEqual(c0, 46) ThenBlock: {
            ReturnValue(0)
        }
        c1 = RDMEM_8(name, 1)
        IfCondition EqualTo(c1, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(c1, 46) ThenBlock: {
            c2 = RDMEM_8(name, 2)
            IfCondition EqualTo(c2, 0) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.BuildPath {
    Input: parent: Address
    Input: name: Address
    Output: Address
    Body: {
        buf = Allocate(1024)
        i = 0
        one = 1
        WhileLoop LessThan(i, 900) {
            c = RDMEM_8(parent, i)
            WRMEM_8(buf, i, c)
            IfCondition EqualTo(c, 0) ThenBlock: {
                BreakLoop
            }
            i = Add(i, one)
        }
        IfCondition GreaterThan(i, 0) ThenBlock: {
            prev = Subtract(i, one)
            lc = RDMEM_8(buf, prev)
            IfCondition NotEqual(lc, 47) ThenBlock: {
                WRMEM_8(buf, i, 47)
                i = Add(i, one)
            }
        }
        j = 0
        WhileLoop LessThan(j, 120) {
            c = RDMEM_8(name, j)
            WRMEM_8(buf, i, c)
            IfCondition EqualTo(c, 0) ThenBlock: {
                BreakLoop
            }
            i = Add(i, one)
            j = Add(j, one)
        }
        WRMEM_8(buf, 1023, 0)
        ReturnValue(buf)
    }
}

Function.OwnSize {
    Input: statbuf: Address
    Input: typ: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(DuConfig.inodes, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition NotEqual(DuConfig.apparent, 0) ThenBlock: {
            reg = EqualTo(typ, 32768)
            lnk = EqualTo(typ, 40960)
            IfCondition Or(NotEqual(reg, 0), NotEqual(lnk, 0)) ThenBlock: {
                sz = GetUInt64(statbuf, 48)
                ReturnValue(sz)
            }
            ReturnValue(0)
        }
        blocks = GetUInt64(statbuf, 64)
        sz = Multiply(blocks, 512)
        ReturnValue(sz)
    }
}

Function.Walk {
    Input: path: Address
    Input: depth: Integer
    Output: Integer
    Body: {
        one = 1
        IfCondition GreaterThan(depth, 64) ThenBlock: {
            WriteAccess(path, 40)
            DuConfig.exit_status = 1
            ReturnValue(0)
        }
        skip_name = Excluded(path)
        IfCondition NotEqual(skip_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        statbuf = Allocate(144)
        follow = 0
        IfCondition EqualTo(DuConfig.deref, 2) ThenBlock: {
            follow = 1
        }
        IfCondition EqualTo(depth, 0) ThenBlock: {
            IfCondition EqualTo(DuConfig.deref, 1) ThenBlock: {
                follow = 1
            }
            sl = EndsSlash(path)
            IfCondition NotEqual(sl, 0) ThenBlock: {
                follow = 1
            }
        }
        IfCondition And(NotEqual(DuConfig.one_fs, 0), EqualTo(depth, 0)) ThenBlock: {
            lrc = SystemCall(6, path, statbuf)
            IfCondition GreaterEqual(lrc, 0) ThenBlock: {
                DuConfig.root_dev = GetUInt64(statbuf, 0)
            }
        }
        rc = 0
        IfCondition NotEqual(follow, 0) ThenBlock: {
            rc = SystemCall(4, path, statbuf)
        } ElseBlock: {
            rc = SystemCall(6, path, statbuf)
        }
        IfCondition LessThan(rc, 0) ThenBlock: {
            err = Subtract(0, rc)
            Deallocate(statbuf, 144)
            WriteAccess(path, err)
            DuConfig.exit_status = 1
            ReturnValue(0)
        }
        b0 = RDMEM_8(statbuf, 24)
        b1 = RDMEM_8(statbuf, 25)
        b2 = RDMEM_8(statbuf, 26)
        b3 = RDMEM_8(statbuf, 27)
        mode = Add(b0, Multiply(b1, 256))
        mode = Add(mode, Multiply(b2, 65536))
        mode = Add(mode, Multiply(b3, 16777216))
        typ = BitwiseAnd(mode, 61440)
        is_dir = EqualTo(typ, 16384)
        dev = GetUInt64(statbuf, 0)
        ino = GetUInt64(statbuf, 8)
        nlink = GetUInt64(statbuf, 16)
        IfCondition And(NotEqual(DuConfig.one_fs, 0), GreaterThan(depth, 0)) ThenBlock: {
            IfCondition NotEqual(dev, DuConfig.root_dev) ThenBlock: {
                Deallocate(statbuf, 144)
                ReturnValue(0)
            }
        }
        do_hash = 0
        IfCondition EqualTo(DuConfig.count_links, 0) ThenBlock: {
            IfCondition NotEqual(DuConfig.hash_all, 0) ThenBlock: {
                do_hash = 1
            }
            IfCondition EqualTo(is_dir, 0) ThenBlock: {
                IfCondition GreaterThan(nlink, 1) ThenBlock: {
                    do_hash = 1
                }
            }
        }
        IfCondition NotEqual(do_hash, 0) ThenBlock: {
            dup = NoteSeen(dev, ino)
            IfCondition NotEqual(dup, 0) ThenBlock: {
                Deallocate(statbuf, 144)
                ReturnValue(0)
            }
        }
        IfCondition NotEqual(is_dir, 0) ThenBlock: {
            cyc = OnStack(dev, ino)
            IfCondition NotEqual(cyc, 0) ThenBlock: {
                Deallocate(statbuf, 144)
                ReturnValue(0)
            }
        }
        own = OwnSize(statbuf, typ)
        Deallocate(statbuf, 144)
        IfCondition EqualTo(is_dir, 0) ThenBlock: {
            show = ShouldPrint(depth, 0, own)
            IfCondition NotEqual(show, 0) ThenBlock: {
                PrintSize(own, path)
            }
            DuConfig.grand = Add(DuConfig.grand, own)
            ReturnValue(own)
        }
        PushCycle(dev, ino)
        fd = SystemCall(257, -100, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            err = Subtract(0, fd)
            WriteReadDir(path, err)
            DuConfig.exit_status = 1
            PopCycle()
            show = ShouldPrint(depth, 1, own)
            IfCondition NotEqual(show, 0) ThenBlock: {
                PrintSize(own, path)
            }
            DuConfig.grand = Add(DuConfig.grand, own)
            IfCondition NotEqual(DuConfig.separate, 0) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(own)
        }
        direct = 0
        dent = Allocate(4096)
        WhileLoop LessThan(0, 1) {
            nread = SystemCall(217, fd, dent, 4096)
            IfCondition LessEqual(nread, 0) ThenBlock: {
                BreakLoop
            }
            at = 0
            WhileLoop LessThan(at, nread) {
                lo = RDMEM_8(dent, Add(at, 16))
                hi = RDMEM_8(dent, Add(at, 17))
                reclen = Add(lo, Multiply(hi, 256))
                IfCondition LessEqual(reclen, 0) ThenBlock: {
                    BreakLoop
                }
                name = Add(dent, Add(at, 19))
                dot = IsDot(name)
                IfCondition EqualTo(dot, 0) ThenBlock: {
                    child = BuildPath(path, name)
                    child_depth = Add(depth, one)
                    part = Walk(child, child_depth)
                    direct = Add(direct, part)
                    Deallocate(child, 1024)
                }
                at = Add(at, reclen)
            }
        }
        Deallocate(dent, 4096)
        SystemCall(3, fd)
        PopCycle()
        total = Add(own, direct)
        show = ShouldPrint(depth, 1, total)
        IfCondition NotEqual(show, 0) ThenBlock: {
            PrintSize(total, path)
        }
        DuConfig.grand = Add(DuConfig.grand, own)
        IfCondition NotEqual(DuConfig.separate, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(total)
    }
}

Function.OptExact {
    Input: arg: Address
    Input: name: Address
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, 64) {
            nc = RDMEM_8(name, i)
            at = Add(i, 2)
            ac = RDMEM_8(arg, at)
            IfCondition EqualTo(nc, 0) ThenBlock: {
                IfCondition EqualTo(ac, 0) ThenBlock: {
                    ReturnValue(1)
                }
                IfCondition EqualTo(ac, 61) ThenBlock: {
                    ReturnValue(1)
                }
                ReturnValue(0)
            }
            IfCondition NotEqual(ac, nc) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.IsProperPrefix {
    Input: arg: Address
    Input: name: Address
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, 40) {
            at = Add(i, 2)
            ac = RDMEM_8(arg, at)
            nc = RDMEM_8(name, i)
            ended = 0
            IfCondition EqualTo(ac, 0) ThenBlock: {
                ended = 1
            }
            IfCondition EqualTo(ac, 61) ThenBlock: {
                ended = 1
            }
            IfCondition NotEqual(ended, 0) ThenBlock: {
                IfCondition EqualTo(i, 0) ThenBlock: {
                    ReturnValue(0)
                }
                IfCondition EqualTo(nc, 0) ThenBlock: {
                    ReturnValue(0)
                }
                ReturnValue(1)
            }
            IfCondition EqualTo(nc, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition NotEqual(ac, nc) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.BumpPrefix {
    Input: arg: Address
    Input: name: Address
    Input: n: Integer
    Output: Integer
    Body: {
        hit = IsProperPrefix(arg, name)
        IfCondition NotEqual(hit, 0) ThenBlock: {
            n = Add(n, 1)
        }
        ReturnValue(n)
    }
}

Function.PrefixCount {
    Input: arg: Address
    Output: Integer
    Body: {
        n = 0
        n = BumpPrefix(arg, "help", n)
        n = BumpPrefix(arg, "version", n)
        n = BumpPrefix(arg, "all", n)
        n = BumpPrefix(arg, "apparent-size", n)
        n = BumpPrefix(arg, "bytes", n)
        n = BumpPrefix(arg, "total", n)
        n = BumpPrefix(arg, "human-readable", n)
        n = BumpPrefix(arg, "si", n)
        n = BumpPrefix(arg, "summarize", n)
        n = BumpPrefix(arg, "inodes", n)
        n = BumpPrefix(arg, "count-links", n)
        n = BumpPrefix(arg, "separate-dirs", n)
        n = BumpPrefix(arg, "one-file-system", n)
        n = BumpPrefix(arg, "dereference-args", n)
        n = BumpPrefix(arg, "dereference", n)
        n = BumpPrefix(arg, "no-dereference", n)
        n = BumpPrefix(arg, "max-depth", n)
        n = BumpPrefix(arg, "block-size", n)
        n = BumpPrefix(arg, "exclude-from", n)
        n = BumpPrefix(arg, "threshold", n)
        n = BumpPrefix(arg, "exclude", n)
        n = BumpPrefix(arg, "files0-from", n)
        ReturnValue(n)
    }
}

Function.OptIs {
    Input: arg: Address
    Input: name: Address
    Output: Integer
    Body: {
        exact = OptExact(arg, name)
        IfCondition NotEqual(exact, 0) ThenBlock: {
            ReturnValue(1)
        }
        pref = IsProperPrefix(arg, name)
        IfCondition EqualTo(pref, 0) ThenBlock: {
            ReturnValue(0)
        }
        cnt = PrefixCount(arg)
        IfCondition EqualTo(cnt, 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.EqValue {
    Input: arg: Address
    Output: Address
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, 200) {
            c = RDMEM_8(arg, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(c, 61) ThenBlock: {
                nxt = Add(i, one)
                ReturnValue(Add(arg, nxt))
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.ApplyDepth {
    Input: s: Address
    Body: {
        n = ParseInt(s)
        DuConfig.max_depth = n
        DuConfig.depth_set = 1
    }
}

Function.ApplyBlock {
    Input: s: Address
    Body: {
        n = ParseSize(s)
        IfCondition EqualTo(n, 0) ThenBlock: {
            n = 1
        }
        DuConfig.block_size = n
        DuConfig.human = 0
    }
}

Function.ThreshFail {
    Input: s: Address
    Input: shortopt: Integer
    Body: {
        IfCondition NotEqual(shortopt, 0) ThenBlock: {
            WriteStderr("du: invalid -t argument '", 25)
        } ElseBlock: {
            WriteStderr("du: invalid --threshold argument '", 34)
        }
        nlen = StrLen(s)
        WriteStderr(s, nlen)
        WriteStderr("'\n", 2)
        DuConfig.fail = 1
    }
}

Function.ApplyThreshold {
    Input: s: Address
    Input: shortopt: Integer
    Body: {
        neg = 0
        i = 0
        one = 1
        c0 = RDMEM_8(s, 0)
        IfCondition EqualTo(c0, 45) ThenBlock: {
            neg = 1
            i = 1
        }
        n = 0
        saw = 0
        bad = 0
        WhileLoop LessThan(i, 32) {
            c = RDMEM_8(s, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition Or(LessThan(c, 48), GreaterThan(c, 57)) ThenBlock: {
                bad = 1
                BreakLoop
            }
            dig = Subtract(c, 48)
            n = Add(Multiply(n, 10), dig)
            saw = 1
            i = Add(i, one)
        }
        IfCondition EqualTo(saw, 0) ThenBlock: {
            bad = 1
        }
        IfCondition NotEqual(bad, 0) ThenBlock: {
            ThreshFail(s, shortopt)
            ReturnValue(0)
        }
        IfCondition And(NotEqual(neg, 0), EqualTo(n, 0)) ThenBlock: {
            WriteStderr("du: invalid --threshold argument '-0'\n", 38)
            DuConfig.fail = 1
            ReturnValue(0)
        }
        DuConfig.threshold = n
        DuConfig.threshold_neg = neg
    }
}

Function.ApplyFilesFrom {
    Input: s: Address
    Body: {
        buf = Allocate(1024)
        CopyInto(buf, s, 1024)
        DuConfig.files_from = buf
        dash = StrEq(buf, "-")
        IfCondition NotEqual(dash, 0) ThenBlock: {
            DuConfig.from_stdin = 1
        }
    }
}

Function.TakePending {
    Input: s: Address
    Body: {
        IfCondition EqualTo(DuConfig.pending, 1) ThenBlock: {
            ApplyDepth(s)
        }
        IfCondition EqualTo(DuConfig.pending, 2) ThenBlock: {
            ApplyBlock(s)
        }
        IfCondition EqualTo(DuConfig.pending, 3) ThenBlock: {
            LoadExcludeFile(s)
        }
        IfCondition EqualTo(DuConfig.pending, 4) ThenBlock: {
            sh = DuConfig.pending_short
            ApplyThreshold(s, sh)
        }
        IfCondition EqualTo(DuConfig.pending, 5) ThenBlock: {
            StorePattern(s)
        }
        IfCondition EqualTo(DuConfig.pending, 6) ThenBlock: {
            ApplyFilesFrom(s)
        }
        DuConfig.pending = 0
    }
}

Function.ParseShort {
    Input: arg: Address
    Body: {
        i = 1
        one = 1
        WhileLoop LessThan(i, 64) {
            c = RDMEM_8(arg, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(c, 97) ThenBlock: {
                DuConfig.all_files = 1
            }
            IfCondition EqualTo(c, 98) ThenBlock: {
                DuConfig.apparent = 1
                DuConfig.block_size = 1
                DuConfig.human = 0
            }
            IfCondition EqualTo(c, 99) ThenBlock: {
                DuConfig.total = 1
            }
            IfCondition EqualTo(c, 104) ThenBlock: {
                DuConfig.human = 1
                DuConfig.block_size = 1
            }
            IfCondition EqualTo(c, 107) ThenBlock: {
                DuConfig.human = 0
                DuConfig.block_size = 1024
            }
            IfCondition EqualTo(c, 108) ThenBlock: {
                DuConfig.count_links = 1
            }
            IfCondition EqualTo(c, 109) ThenBlock: {
                DuConfig.human = 0
                DuConfig.block_size = 1048576
            }
            IfCondition EqualTo(c, 115) ThenBlock: {
                DuConfig.summarize = 1
            }
            IfCondition EqualTo(c, 120) ThenBlock: {
                DuConfig.one_fs = 1
            }
            IfCondition EqualTo(c, 83) ThenBlock: {
                DuConfig.separate = 1
            }
            IfCondition EqualTo(c, 76) ThenBlock: {
                DuConfig.deref = 2
            }
            IfCondition EqualTo(c, 68) ThenBlock: {
                DuConfig.deref = 1
            }
            IfCondition EqualTo(c, 72) ThenBlock: {
                DuConfig.deref = 1
            }
            IfCondition EqualTo(c, 80) ThenBlock: {
                DuConfig.deref = 0
            }
            need = 0
            IfCondition EqualTo(c, 100) ThenBlock: {
                need = 1
            }
            IfCondition EqualTo(c, 66) ThenBlock: {
                need = 2
            }
            IfCondition EqualTo(c, 88) ThenBlock: {
                need = 3
            }
            IfCondition EqualTo(c, 116) ThenBlock: {
                need = 4
            }
            IfCondition NotEqual(need, 0) ThenBlock: {
                nxt = Add(i, one)
                c2 = RDMEM_8(arg, nxt)
                IfCondition EqualTo(c2, 0) ThenBlock: {
                    DuConfig.pending = need
                    DuConfig.pending_short = 1
                    ReturnValue(0)
                }
                rest = Add(arg, nxt)
                IfCondition EqualTo(need, 1) ThenBlock: {
                    ApplyDepth(rest)
                }
                IfCondition EqualTo(need, 2) ThenBlock: {
                    ApplyBlock(rest)
                }
                IfCondition EqualTo(need, 3) ThenBlock: {
                    LoadExcludeFile(rest)
                }
                IfCondition EqualTo(need, 4) ThenBlock: {
                    ApplyThreshold(rest, 1)
                }
                ReturnValue(0)
            }
            known = 0
            IfCondition EqualTo(c, 97) ThenBlock: {
                known = 1
            }
            IfCondition EqualTo(c, 98) ThenBlock: {
                known = 1
            }
            IfCondition EqualTo(c, 99) ThenBlock: {
                known = 1
            }
            IfCondition EqualTo(c, 104) ThenBlock: {
                known = 1
            }
            IfCondition EqualTo(c, 107) ThenBlock: {
                known = 1
            }
            IfCondition EqualTo(c, 108) ThenBlock: {
                known = 1
            }
            IfCondition EqualTo(c, 109) ThenBlock: {
                known = 1
            }
            IfCondition EqualTo(c, 115) ThenBlock: {
                known = 1
            }
            IfCondition EqualTo(c, 120) ThenBlock: {
                known = 1
            }
            IfCondition EqualTo(c, 83) ThenBlock: {
                known = 1
            }
            IfCondition EqualTo(c, 76) ThenBlock: {
                known = 1
            }
            IfCondition EqualTo(c, 68) ThenBlock: {
                known = 1
            }
            IfCondition EqualTo(c, 72) ThenBlock: {
                known = 1
            }
            IfCondition EqualTo(c, 80) ThenBlock: {
                known = 1
            }
            IfCondition EqualTo(c, 48) ThenBlock: {
                known = 1
            }
            IfCondition EqualTo(known, 0) ThenBlock: {
                WriteStderr("du: invalid option -- '", 23)
                tmp = Allocate(2)
                WRMEM_8(tmp, 0, c)
                WRMEM_8(tmp, 1, 0)
                WriteStderr(tmp, 1)
                Deallocate(tmp, 2)
                WriteStderr("'\n", 2)
                WriteStderr("Try 'du --help' for more information.\n", 38)
                DuConfig.fail = 1
                ReturnValue(0)
            }
            i = Add(i, one)
        }
    }
}

Function.ParseLong {
    Input: arg: Address
    Body: {
        IfCondition NotEqual(OptIs(arg, "help"), 0) ThenBlock: {
            DuConfig.show_help = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(OptIs(arg, "version"), 0) ThenBlock: {
            DuConfig.show_version = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(OptIs(arg, "all"), 0) ThenBlock: {
            DuConfig.all_files = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(OptIs(arg, "apparent-size"), 0) ThenBlock: {
            DuConfig.apparent = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(OptIs(arg, "bytes"), 0) ThenBlock: {
            DuConfig.apparent = 1
            DuConfig.block_size = 1
            DuConfig.human = 0
            ReturnValue(0)
        }
        IfCondition NotEqual(OptIs(arg, "total"), 0) ThenBlock: {
            DuConfig.total = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(OptIs(arg, "human-readable"), 0) ThenBlock: {
            DuConfig.human = 1
            DuConfig.block_size = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(OptIs(arg, "si"), 0) ThenBlock: {
            DuConfig.human = 2
            DuConfig.block_size = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(OptIs(arg, "summarize"), 0) ThenBlock: {
            DuConfig.summarize = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(OptIs(arg, "inodes"), 0) ThenBlock: {
            DuConfig.inodes = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(OptIs(arg, "count-links"), 0) ThenBlock: {
            DuConfig.count_links = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(OptIs(arg, "separate-dirs"), 0) ThenBlock: {
            DuConfig.separate = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(OptIs(arg, "one-file-system"), 0) ThenBlock: {
            DuConfig.one_fs = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(OptIs(arg, "dereference-args"), 0) ThenBlock: {
            DuConfig.deref = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(OptIs(arg, "dereference"), 0) ThenBlock: {
            DuConfig.deref = 2
            ReturnValue(0)
        }
        IfCondition NotEqual(OptIs(arg, "no-dereference"), 0) ThenBlock: {
            DuConfig.deref = 0
            ReturnValue(0)
        }
        kind = 0
        IfCondition NotEqual(OptIs(arg, "max-depth"), 0) ThenBlock: {
            kind = 1
        }
        IfCondition NotEqual(OptIs(arg, "block-size"), 0) ThenBlock: {
            kind = 2
        }
        IfCondition NotEqual(OptIs(arg, "exclude-from"), 0) ThenBlock: {
            kind = 3
        }
        IfCondition NotEqual(OptIs(arg, "threshold"), 0) ThenBlock: {
            kind = 4
        }
        IfCondition NotEqual(OptIs(arg, "exclude"), 0) ThenBlock: {
            kind = 5
        }
        IfCondition NotEqual(OptIs(arg, "files0-from"), 0) ThenBlock: {
            kind = 6
        }
        IfCondition NotEqual(kind, 0) ThenBlock: {
            val = EqValue(arg)
            IfCondition EqualTo(val, 0) ThenBlock: {
                DuConfig.pending = kind
                DuConfig.pending_short = 0
                ReturnValue(0)
            }
            IfCondition EqualTo(kind, 1) ThenBlock: {
                ApplyDepth(val)
            }
            IfCondition EqualTo(kind, 2) ThenBlock: {
                ApplyBlock(val)
            }
            IfCondition EqualTo(kind, 3) ThenBlock: {
                LoadExcludeFile(val)
            }
            IfCondition EqualTo(kind, 4) ThenBlock: {
                ApplyThreshold(val, 0)
            }
            IfCondition EqualTo(kind, 5) ThenBlock: {
                StorePattern(val)
            }
            IfCondition EqualTo(kind, 6) ThenBlock: {
                ApplyFilesFrom(val)
            }
            ReturnValue(0)
        }
        WriteStderr("du: unrecognized option '", 25)
        n = StrLen(arg)
        WriteStderr(arg, n)
        WriteStderr("'\n", 2)
        WriteStderr("Try 'du --help' for more information.\n", 38)
        DuConfig.fail = 1
    }
}

Function.StoreOp {
    Input: arg: Address
    Body: {
        IfCondition GreaterEqual(DuConfig.nops, 512) ThenBlock: {
            Deallocate(arg, 1024)
            ReturnValue(0)
        }
        off = Multiply(DuConfig.nops, 8)
        slot = Add(DuConfig.ops, off)
        WRMEM_64(slot, arg)
        one = 1
        DuConfig.nops = Add(DuConfig.nops, one)
    }
}

Function.OpAt {
    Input: index: Integer
    Output: Address
    Body: {
        off = Multiply(index, 8)
        slot = Add(DuConfig.ops, off)
        p = RDMEM_64(slot)
        ReturnValue(p)
    }
}

Function.ZeroName {
    Input: src: Address
    Input: line: Integer
    Body: {
        WriteStderr("du: ", 4)
        n = StrLen(src)
        WriteStderr(src, n)
        WriteStderr(":", 1)
        num = ConvertNumberToString(line)
        WriteStrErr(num)
        Deallocate(num, 32)
        WriteStderr(": invalid zero-length file name\n", 32)
        DuConfig.exit_status = 1
    }
}

Function.WriteStrErr {
    Input: str: Address
    Body: {
        n = StrLen(str)
        WriteStderr(str, n)
    }
}

Function.SliceWalk {
    Input: buf: Address
    Input: start: Integer
    Input: endat: Integer
    Body: {
        name = Allocate(1024)
        i = 0
        one = 1
        at = start
        WhileLoop And(LessThan(at, endat), LessThan(i, 1023)) {
            c = RDMEM_8(buf, at)
            WRMEM_8(name, i, c)
            i = Add(i, one)
            at = Add(at, one)
        }
        WRMEM_8(name, i, 0)
        IfCondition NotEqual(DuConfig.from_stdin, 0) ThenBlock: {
            dash = StrEq(name, "-")
            IfCondition NotEqual(dash, 0) ThenBlock: {
                WriteStderr("du: when reading file names from stdin, no file name of '-' allowed\n", 68)
                DuConfig.exit_status = 1
                Deallocate(name, 1024)
                ReturnValue(0)
            }
        }
        Walk(name, 0)
        Deallocate(name, 1024)
    }
}

Function.ReadNames {
    Input: fd: Integer
    Input: label: Address
    Body: {
        buf = Allocate(65536)
        total = 0
        one = 1
        WhileLoop LessThan(total, 65535) {
            room = Subtract(65535, total)
            dest = Add(buf, total)
            nread = SystemCall(0, fd, dest, room)
            IfCondition LessEqual(nread, 0) ThenBlock: {
                BreakLoop
            }
            total = Add(total, nread)
        }
        line = 1
        start = 0
        i = 0
        WhileLoop LessThan(i, total) {
            c = RDMEM_8(buf, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                IfCondition EqualTo(i, start) ThenBlock: {
                    ZeroName(label, line)
                } ElseBlock: {
                    SliceWalk(buf, start, i)
                }
                line = Add(line, one)
                start = Add(i, one)
            }
            i = Add(i, one)
        }
        IfCondition LessThan(start, total) ThenBlock: {
            SliceWalk(buf, start, total)
        }
        Deallocate(buf, 65536)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buffer = Allocate(16384)
        nread = SystemCall(0, fd, buffer, 16383)
        SystemCall(3, fd)
        IfCondition LessEqual(nread, 0) ThenBlock: {
            Deallocate(buffer, 16384)
            ReturnValue(0)
        }
        WRMEM_8(buffer, nread, 0)
        ReturnValue(buffer)
    }
}

SubRoutine.Main {
    DuConfig.exclude_base = Allocate(8192)
    DuConfig.ops = Allocate(4096)
    args = GetArgs()
    IfCondition EqualTo(args, 0) ThenBlock: {
        WriteStderr("du: cannot read arguments\n", 26)
        SystemCall(60, 1)
    }
    one = 1
    DuConfig.scan = 0
    WhileLoop NotEqual(RDMEM_8(args, DuConfig.scan), 0) {
        DuConfig.scan = Add(DuConfig.scan, one)
    }
    DuConfig.scan = Add(DuConfig.scan, one)
    end_opts = 0
    WhileLoop LessThan(DuConfig.scan, 16380) {
        ch = RDMEM_8(args, DuConfig.scan)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            BreakLoop
        }
        arg = CopyArg(args, DuConfig.scan)
        WhileLoop NotEqual(RDMEM_8(args, DuConfig.scan), 0) {
            DuConfig.scan = Add(DuConfig.scan, one)
        }
        DuConfig.scan = Add(DuConfig.scan, one)
        IfCondition NotEqual(DuConfig.pending, 0) ThenBlock: {
            TakePending(arg)
            Deallocate(arg, 1024)
        } ElseBlock: {
            b0 = RDMEM_8(arg, 0)
            b1 = RDMEM_8(arg, 1)
            b2 = RDMEM_8(arg, 2)
            opt = 0
            IfCondition And(EqualTo(end_opts, 0), EqualTo(b0, 45)) ThenBlock: {
                IfCondition NotEqual(b1, 0) ThenBlock: {
                    opt = 1
                }
            }
            IfCondition NotEqual(opt, 0) ThenBlock: {
                IfCondition EqualTo(b1, 45) ThenBlock: {
                    IfCondition EqualTo(b2, 0) ThenBlock: {
                        end_opts = 1
                    } ElseBlock: {
                        ParseLong(arg)
                    }
                } ElseBlock: {
                    ParseShort(arg)
                }
                Deallocate(arg, 1024)
            } ElseBlock: {
                StoreOp(arg)
            }
        }
    }
    IfCondition NotEqual(DuConfig.pending, 0) ThenBlock: {
        WriteStderr("du: option requires an argument\n", 32)
        WriteStderr("Try 'du --help' for more information.\n", 38)
        DuConfig.fail = 1
    }
    IfCondition NotEqual(DuConfig.fail, 0) ThenBlock: {
        SystemCall(60, 1)
    }
    IfCondition NotEqual(DuConfig.show_help, 0) ThenBlock: {
        PrintHelp()
        SystemCall(60, 0)
    }
    IfCondition NotEqual(DuConfig.show_version, 0) ThenBlock: {
        ShowVersion()
        SystemCall(60, 0)
    }
    IfCondition And(NotEqual(DuConfig.all_files, 0), NotEqual(DuConfig.summarize, 0)) ThenBlock: {
        WriteStderr("du: cannot both summarize and show all entries\n", 47)
        WriteStderr("Try 'du --help' for more information.\n", 38)
        SystemCall(60, 1)
    }
    IfCondition And(NotEqual(DuConfig.summarize, 0), NotEqual(DuConfig.depth_set, 0)) ThenBlock: {
        IfCondition NotEqual(DuConfig.max_depth, 0) ThenBlock: {
            WriteStderr("du: warning: summarizing conflicts with --max-depth\n", 52)
            WriteStderr("Try 'du --help' for more information.\n", 38)
            SystemCall(60, 1)
        }
    }
    IfCondition NotEqual(DuConfig.summarize, 0) ThenBlock: {
        DuConfig.max_depth = 0
    }
    IfCondition And(NotEqual(DuConfig.inodes, 0), NotEqual(DuConfig.apparent, 0)) ThenBlock: {
        WriteStderr("du: warning: options --apparent-size and -b are ineffective with --inodes\n", 74)
    }
    IfCondition And(NotEqual(DuConfig.files_from, 0), GreaterThan(DuConfig.nops, 0)) ThenBlock: {
        extra = OpAt(0)
        WriteStderr("du: extra operand '", 19)
        n = StrLen(extra)
        WriteStderr(extra, n)
        WriteStderr("'\n", 2)
        WriteStderr("file operands cannot be combined with --files0-from\n", 52)
        WriteStderr("Try 'du --help' for more information.\n", 38)
        SystemCall(60, 1)
    }
    IfCondition GreaterThan(DuConfig.nops, 1) ThenBlock: {
        DuConfig.hash_all = 1
    }
    IfCondition EqualTo(DuConfig.deref, 2) ThenBlock: {
        DuConfig.hash_all = 1
    }
    IfCondition NotEqual(DuConfig.files_from, 0) ThenBlock: {
        DuConfig.hash_all = 1
        IfCondition NotEqual(DuConfig.from_stdin, 0) ThenBlock: {
            ReadNames(0, "-")
        } ElseBlock: {
            fd = SystemCall(257, -100, DuConfig.files_from, 0, 0)
            IfCondition LessThan(fd, 0) ThenBlock: {
                WriteStderr("du: cannot open '", 17)
                n = StrLen(DuConfig.files_from)
                WriteStderr(DuConfig.files_from, n)
                WriteStderr("' for reading: ", 15)
                err = Subtract(0, fd)
                WriteErrno(err)
                WriteStderr("\n", 1)
                SystemCall(60, 1)
            }
            ReadNames(fd, DuConfig.files_from)
            SystemCall(3, fd)
        }
    } ElseBlock: {
        IfCondition EqualTo(DuConfig.nops, 0) ThenBlock: {
            dot = Allocate(1024)
            WRMEM_8(dot, 0, 46)
            WRMEM_8(dot, 1, 0)
            Walk(dot, 0)
            Deallocate(dot, 1024)
        } ElseBlock: {
            i = 0
            WhileLoop LessThan(i, DuConfig.nops) {
                p = OpAt(i)
                Walk(p, 0)
                i = Add(i, one)
            }
        }
    }
    IfCondition NotEqual(DuConfig.total, 0) ThenBlock: {
        PrintSize(DuConfig.grand, "total")
    }
    SystemCall(60, DuConfig.exit_status)
}

RunTask(Main)
