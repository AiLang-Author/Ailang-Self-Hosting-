// EnvSignal.ailang - GNU env signal options.
// Names are the Linux 1..31 set. No pools.
LibraryImport.Arena

Function.SgErr {
    Input: str: Address
    Body: {
        n = StringLength(str)
        SystemCall(1, 2, str, n)
    }
}

Function.SgByte {
    Input: ch: Integer
    Body: {
        buf = Allocate(2)
        SetByte(buf, 0, ch)
        SetByte(buf, 1, 0)
        SystemCall(1, 2, buf, 1)
    }
}

Function.SgName {
    Input: sig: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(sig, 1) ThenBlock: {
            ReturnValue("HUP")
        }
        IfCondition EqualTo(sig, 2) ThenBlock: {
            ReturnValue("INT")
        }
        IfCondition EqualTo(sig, 3) ThenBlock: {
            ReturnValue("QUIT")
        }
        IfCondition EqualTo(sig, 4) ThenBlock: {
            ReturnValue("ILL")
        }
        IfCondition EqualTo(sig, 5) ThenBlock: {
            ReturnValue("TRAP")
        }
        IfCondition EqualTo(sig, 6) ThenBlock: {
            ReturnValue("ABRT")
        }
        IfCondition EqualTo(sig, 7) ThenBlock: {
            ReturnValue("BUS")
        }
        IfCondition EqualTo(sig, 8) ThenBlock: {
            ReturnValue("FPE")
        }
        IfCondition EqualTo(sig, 9) ThenBlock: {
            ReturnValue("KILL")
        }
        IfCondition EqualTo(sig, 10) ThenBlock: {
            ReturnValue("USR1")
        }
        IfCondition EqualTo(sig, 11) ThenBlock: {
            ReturnValue("SEGV")
        }
        IfCondition EqualTo(sig, 12) ThenBlock: {
            ReturnValue("USR2")
        }
        IfCondition EqualTo(sig, 13) ThenBlock: {
            ReturnValue("PIPE")
        }
        IfCondition EqualTo(sig, 14) ThenBlock: {
            ReturnValue("ALRM")
        }
        IfCondition EqualTo(sig, 15) ThenBlock: {
            ReturnValue("TERM")
        }
        IfCondition EqualTo(sig, 16) ThenBlock: {
            ReturnValue("STKFLT")
        }
        IfCondition EqualTo(sig, 17) ThenBlock: {
            ReturnValue("CHLD")
        }
        IfCondition EqualTo(sig, 18) ThenBlock: {
            ReturnValue("CONT")
        }
        IfCondition EqualTo(sig, 19) ThenBlock: {
            ReturnValue("STOP")
        }
        IfCondition EqualTo(sig, 20) ThenBlock: {
            ReturnValue("TSTP")
        }
        IfCondition EqualTo(sig, 21) ThenBlock: {
            ReturnValue("TTIN")
        }
        IfCondition EqualTo(sig, 22) ThenBlock: {
            ReturnValue("TTOU")
        }
        IfCondition EqualTo(sig, 23) ThenBlock: {
            ReturnValue("URG")
        }
        IfCondition EqualTo(sig, 24) ThenBlock: {
            ReturnValue("XCPU")
        }
        IfCondition EqualTo(sig, 25) ThenBlock: {
            ReturnValue("XFSZ")
        }
        IfCondition EqualTo(sig, 26) ThenBlock: {
            ReturnValue("VTALRM")
        }
        IfCondition EqualTo(sig, 27) ThenBlock: {
            ReturnValue("PROF")
        }
        IfCondition EqualTo(sig, 28) ThenBlock: {
            ReturnValue("WINCH")
        }
        IfCondition EqualTo(sig, 29) ThenBlock: {
            ReturnValue("POLL")
        }
        IfCondition EqualTo(sig, 30) ThenBlock: {
            ReturnValue("PWR")
        }
        IfCondition EqualTo(sig, 31) ThenBlock: {
            ReturnValue("SYS")
        }
        ReturnValue(0)
    }
}

Function.SgFind {
    Input: name: Address
    Output: Integer
    Body: {
        i = 1
        one = 1
        WhileLoop LessEqual(i, 31) {
            known = SgName(i)
            eq = StringEquals(known, name)
            IfCondition EqualTo(eq, 1) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, one)
        }
        ReturnValue(-1)
    }
}

Function.SgUpper {
    Input: src: Address
    Input: dst: Address
    Output: Integer
    Body: {
        n = StringLength(src)
        IfCondition GreaterThan(n, 31) ThenBlock: {
            n = 31
        }
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            ch = GetByte(src, i)
            ch = BitwiseAnd(ch, 255)
            IfCondition GreaterEqual(ch, 97) ThenBlock: {
                IfCondition LessEqual(ch, 122) ThenBlock: {
                    ch = Subtract(ch, 32)
                }
            }
            SetByte(dst, i, ch)
            i = Add(i, one)
        }
        SetByte(dst, n, 0)
        ReturnValue(n)
    }
}

Function.SgNumber {
    Input: name: Address
    Output: Integer
    Body: {
        n = StringLength(name)
        IfCondition EqualTo(n, 0) ThenBlock: {
            ReturnValue(-1)
        }
        i = 0
        one = 1
        val = 0
        ten = 10
        WhileLoop LessThan(i, n) {
            ch = GetByte(name, i)
            ch = BitwiseAnd(ch, 255)
            IfCondition LessThan(ch, 48) ThenBlock: {
                ReturnValue(-1)
            }
            IfCondition GreaterThan(ch, 57) ThenBlock: {
                ReturnValue(-1)
            }
            dig = Subtract(ch, 48)
            val = Multiply(val, ten)
            val = Add(val, dig)
            i = Add(i, one)
        }
        IfCondition LessThan(val, 1) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition GreaterThan(val, 31) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(val)
    }
}

Function.SgResolve {
    Input: original: Address
    Output: Integer
    Body: {
        dst = Allocate(32)
        n = SgUpper(original, dst)
        first = GetByte(dst, 0)
        first = BitwiseAnd(first, 255)
        digit = 0
        IfCondition GreaterEqual(first, 48) ThenBlock: {
            IfCondition LessEqual(first, 57) ThenBlock: {
                digit = 1
            }
        }
        IfCondition EqualTo(digit, 1) ThenBlock: {
            num = SgNumber(dst)
            ReturnValue(num)
        }
        hit = SgFind(dst)
        IfCondition LessThan(hit, 0) ThenBlock: {
            IfCondition GreaterEqual(n, 4) ThenBlock: {
                b0 = GetByte(dst, 0)
                b1 = GetByte(dst, 1)
                b2 = GetByte(dst, 2)
                IfCondition EqualTo(b0, 83) ThenBlock: {
                    IfCondition EqualTo(b1, 73) ThenBlock: {
                        IfCondition EqualTo(b2, 71) ThenBlock: {
                            rest = Add(dst, 3)
                            hit = SgFind(rest)
                        }
                    }
                }
            }
        }
        ReturnValue(hit)
    }
}

Function.SgLoad {
    Input: addr: Address
    Output: Integer
    Body: {
        b0 = GetByte(addr, 0)
        b0 = BitwiseAnd(b0, 255)
        b1 = GetByte(addr, 1)
        b1 = BitwiseAnd(b1, 255)
        b2 = GetByte(addr, 2)
        b2 = BitwiseAnd(b2, 255)
        b3 = GetByte(addr, 3)
        b3 = BitwiseAnd(b3, 255)
        b4 = GetByte(addr, 4)
        b4 = BitwiseAnd(b4, 255)
        b5 = GetByte(addr, 5)
        b5 = BitwiseAnd(b5, 255)
        b6 = GetByte(addr, 6)
        b6 = BitwiseAnd(b6, 255)
        b7 = GetByte(addr, 7)
        b7 = BitwiseAnd(b7, 255)
        v = b0
        v = BitwiseOr(v, LeftShift(b1, 8))
        v = BitwiseOr(v, LeftShift(b2, 16))
        v = BitwiseOr(v, LeftShift(b3, 24))
        v = BitwiseOr(v, LeftShift(b4, 32))
        v = BitwiseOr(v, LeftShift(b5, 40))
        v = BitwiseOr(v, LeftShift(b6, 48))
        v = BitwiseOr(v, LeftShift(b7, 56))
        ReturnValue(v)
    }
}

Function.SgStore {
    Input: addr: Address
    Input: value: Integer
    Body: {
        cur = value
        i = 0
        one = 1
        eight = 8
        WhileLoop LessThan(i, 8) {
            low = BitwiseAnd(cur, 255)
            SetByte(addr, i, low)
            cur = RightShift(cur, eight)
            i = Add(i, one)
        }
    }
}

Function.SgShift {
    Input: sig: Integer
    Output: Integer
    Body: {
        bit = Subtract(sig, 1)
        one = 1
        mask = LeftShift(one, bit)
        ReturnValue(mask)
    }
}

Function.SgTest {
    Input: set: Address
    Input: sig: Integer
    Output: Integer
    Body: {
        word = SgLoad(set)
        mask = SgShift(sig)
        hit = BitwiseAnd(word, mask)
        IfCondition EqualTo(hit, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.SgOn {
    Input: set: Address
    Input: sig: Integer
    Body: {
        word = SgLoad(set)
        mask = SgShift(sig)
        word = BitwiseOr(word, mask)
        SgStore(set, word)
    }
}

Function.SgOff {
    Input: set: Address
    Input: sig: Integer
    Body: {
        word = SgLoad(set)
        mask = SgShift(sig)
        cleared = BitwiseNot(mask)
        word = BitwiseAnd(word, cleared)
        SgStore(set, word)
    }
}

Function.SgFill {
    Input: set: Address
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, 8) {
            SetByte(set, i, 255)
            i = Add(i, one)
        }
    }
}

Function.SgClear {
    Input: set: Address
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, 8) {
            SetByte(set, i, 0)
            i = Add(i, one)
        }
    }
}

Function.SgZero {
    Input: buf: Address
    Input: n: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            SetByte(buf, i, 0)
            i = Add(i, one)
        }
    }
}

Function.SgBad {
    Input: token: Address
    Body: {
        SgErr("env: '")
        SgErr(token)
        SgErr("': invalid signal\n")
    }
}

Function.SgApplyOne {
    Input: modes: Address
    Input: spec: Address
    Input: to_default: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(spec, 0) ThenBlock: {
            mode = 2
            IfCondition EqualTo(to_default, 0) ThenBlock: {
                mode = 4
            }
            i = 1
            one = 1
            WhileLoop LessEqual(i, 31) {
                SetByte(modes, i, mode)
                i = Add(i, one)
            }
            ReturnValue(0)
        }
        nlen = StringLength(spec)
        IfCondition EqualTo(nlen, 0) ThenBlock: {
            ReturnValue(0)
        }
        start = 0
        i = 0
        one = 1
        WhileLoop LessEqual(i, nlen) {
            at_end = EqualTo(i, nlen)
            ch = 0
            IfCondition EqualTo(at_end, 0) ThenBlock: {
                ch = GetByte(spec, i)
                ch = BitwiseAnd(ch, 255)
            }
            boundary = at_end
            IfCondition EqualTo(ch, 44) ThenBlock: {
                boundary = 1
            }
            IfCondition EqualTo(boundary, 1) ThenBlock: {
                tok_n = Subtract(i, start)
                IfCondition GreaterThan(tok_n, 0) ThenBlock: {
                    tok = Allocate(64)
                    k = 0
                    WhileLoop LessThan(k, tok_n) {
                        IfCondition LessThan(k, 63) ThenBlock: {
                            tb = GetByte(spec, Add(start, k))
                            SetByte(tok, k, tb)
                        }
                        k = Add(k, one)
                    }
                    keep = tok_n
                    IfCondition GreaterThan(keep, 63) ThenBlock: {
                        keep = 63
                    }
                    SetByte(tok, keep, 0)
                    sig = SgResolve(tok)
                    IfCondition LessThan(sig, 0) ThenBlock: {
                        SgBad(tok)
                        ReturnValue(-1)
                    }
                    mode = 3
                    IfCondition EqualTo(to_default, 1) ThenBlock: {
                        mode = 1
                    }
                    SetByte(modes, sig, mode)
                }
                start = Add(i, one)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.SgMaskOne {
    Input: block: Address
    Input: unblock: Address
    Input: spec: Address
    Input: do_block: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(spec, 0) ThenBlock: {
            IfCondition EqualTo(do_block, 1) ThenBlock: {
                SgFill(block)
                SgClear(unblock)
            } ElseBlock: {
                SgFill(unblock)
                SgClear(block)
            }
            ReturnValue(0)
        }
        nlen = StringLength(spec)
        IfCondition EqualTo(nlen, 0) ThenBlock: {
            ReturnValue(0)
        }
        start = 0
        i = 0
        one = 1
        WhileLoop LessEqual(i, nlen) {
            at_end = EqualTo(i, nlen)
            ch = 0
            IfCondition EqualTo(at_end, 0) ThenBlock: {
                ch = GetByte(spec, i)
                ch = BitwiseAnd(ch, 255)
            }
            boundary = at_end
            IfCondition EqualTo(ch, 44) ThenBlock: {
                boundary = 1
            }
            IfCondition EqualTo(boundary, 1) ThenBlock: {
                tok_n = Subtract(i, start)
                IfCondition GreaterThan(tok_n, 0) ThenBlock: {
                    tok = Allocate(64)
                    k = 0
                    WhileLoop LessThan(k, tok_n) {
                        IfCondition LessThan(k, 63) ThenBlock: {
                            tb = GetByte(spec, Add(start, k))
                            SetByte(tok, k, tb)
                        }
                        k = Add(k, one)
                    }
                    keep = tok_n
                    IfCondition GreaterThan(keep, 63) ThenBlock: {
                        keep = 63
                    }
                    SetByte(tok, keep, 0)
                    sig = SgResolve(tok)
                    IfCondition LessThan(sig, 0) ThenBlock: {
                        SgBad(tok)
                        ReturnValue(-1)
                    }
                    IfCondition EqualTo(do_block, 1) ThenBlock: {
                        SgOn(block, sig)
                        SgOff(unblock, sig)
                    } ElseBlock: {
                        SgOn(unblock, sig)
                        SgOff(block, sig)
                    }
                }
                start = Add(i, one)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.SgApply {
    Input: modes: Address
    Output: Integer
    Body: {
        act = Allocate(32)
        i = 1
        one = 1
        WhileLoop LessEqual(i, 31) {
            mode = GetByte(modes, i)
            mode = BitwiseAnd(mode, 255)
            IfCondition NotEqual(mode, 0) ThenBlock: {
                SgZero(act, 32)
                IfCondition EqualTo(mode, 3) ThenBlock: {
                    SetByte(act, 0, 1)
                }
                IfCondition EqualTo(mode, 4) ThenBlock: {
                    SetByte(act, 0, 1)
                }
                rc = SystemCall(13, i, act, 0, 8)
                IfCondition LessThan(rc, 0) ThenBlock: {
                    noerr = 0
                    IfCondition EqualTo(mode, 2) ThenBlock: {
                        noerr = 1
                    }
                    IfCondition EqualTo(mode, 4) ThenBlock: {
                        noerr = 1
                    }
                    IfCondition EqualTo(noerr, 0) ThenBlock: {
                        SgErr("env: failed to set signal action for signal ")
                        SgByte(Add(48, i))
                        SgErr("\n")
                        SystemCall(60, 125)
                    }
                }
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.SgInstall {
    Input: block: Address
    Input: unblock: Address
    Output: Integer
    Body: {
        cur = Allocate(8)
        SgZero(cur, 8)
        rc = SystemCall(14, 0, 0, cur, 8)
        IfCondition LessThan(rc, 0) ThenBlock: {
            SgErr("env: failed to get signal process mask\n")
            SystemCall(60, 125)
        }
        i = 1
        one = 1
        WhileLoop LessEqual(i, 31) {
            on = SgTest(block, i)
            IfCondition EqualTo(on, 1) ThenBlock: {
                SgOn(cur, i)
            } ElseBlock: {
                off = SgTest(unblock, i)
                IfCondition EqualTo(off, 1) ThenBlock: {
                    SgOff(cur, i)
                }
            }
            i = Add(i, one)
        }
        rc = SystemCall(14, 2, cur, 0, 8)
        IfCondition LessThan(rc, 0) ThenBlock: {
            SgErr("env: failed to set signal process mask\n")
            SystemCall(60, 125)
        }
        ReturnValue(0)
    }
}

Function.SgIgn {
    Input: act: Address
    Output: Integer
    Body: {
        b0 = GetByte(act, 0)
        b0 = BitwiseAnd(b0, 255)
        IfCondition NotEqual(b0, 1) ThenBlock: {
            ReturnValue(0)
        }
        i = 1
        one = 1
        WhileLoop LessThan(i, 8) {
            b = GetByte(act, i)
            b = BitwiseAnd(b, 255)
            IfCondition NotEqual(b, 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        ReturnValue(1)
    }
}

Function.SgWidth {
    Input: n: Integer
    Body: {
        IfCondition LessThan(n, 10) ThenBlock: {
            SgByte(32)
            dig = Add(48, n)
            SgByte(dig)
        } ElseBlock: {
            ten = 10
            hi = Divide(n, ten)
            lo = Modulo(n, ten)
            SgByte(Add(48, hi))
            SgByte(Add(48, lo))
        }
    }
}

Function.SgLine {
    Input: name: Address
    Input: sig: Integer
    Input: blocked: Integer
    Input: ignored: Integer
    Body: {
        SgErr(name)
        nlen = StringLength(name)
        pad = Subtract(10, nlen)
        one = 1
        WhileLoop GreaterThan(pad, 0) {
            SgByte(32)
            pad = Subtract(pad, one)
        }
        SgErr(" (")
        SgWidth(sig)
        SgErr("): ")
        IfCondition EqualTo(blocked, 1) ThenBlock: {
            SgErr("BLOCK")
        }
        both = 0
        IfCondition EqualTo(blocked, 1) ThenBlock: {
            IfCondition EqualTo(ignored, 1) ThenBlock: {
                both = 1
            }
        }
        IfCondition EqualTo(both, 1) ThenBlock: {
            SgErr(",")
        }
        IfCondition EqualTo(ignored, 1) ThenBlock: {
            SgErr("IGNORE")
        }
        SgErr("\n")
    }
}

Function.SgList {
    Output: Integer
    Body: {
        cur = Allocate(8)
        SgZero(cur, 8)
        rc = SystemCall(14, 0, 0, cur, 8)
        IfCondition LessThan(rc, 0) ThenBlock: {
            SgErr("env: failed to get signal process mask\n")
            SystemCall(60, 125)
        }
        act = Allocate(32)
        i = 1
        one = 1
        WhileLoop LessEqual(i, 31) {
            SgZero(act, 32)
            rc = SystemCall(13, i, 0, act, 8)
            ign = 0
            IfCondition GreaterEqual(rc, 0) ThenBlock: {
                ign = SgIgn(act)
            }
            blk = SgTest(cur, i)
            show = 0
            IfCondition EqualTo(ign, 1) ThenBlock: {
                show = 1
            }
            IfCondition EqualTo(blk, 1) ThenBlock: {
                show = 1
            }
            IfCondition EqualTo(show, 1) ThenBlock: {
                name = SgName(i)
                SgLine(name, i, blk, ign)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}
