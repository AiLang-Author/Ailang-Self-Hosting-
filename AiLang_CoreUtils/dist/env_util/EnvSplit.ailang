// EnvSplit.ailang - GNU env -S / --split-string.
// No pools. The caller copies argv0 and the unparsed tail around the result.
LibraryImport.Arena

Function.SpErr {
    Input: str: Address
    Body: {
        n = StringLength(str)
        SystemCall(1, 2, str, n)
    }
}

Function.SpByte {
    Input: ch: Integer
    Body: {
        buf = Allocate(2)
        SetByte(buf, 0, ch)
        SetByte(buf, 1, 0)
        n = 1
        SystemCall(1, 2, buf, n)
    }
}

Function.SpPush {
    Input: out: Address
    Input: len: Integer
    Input: cap: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(len, cap) ThenBlock: {
            ReturnValue(-1)
        }
        SetByte(out, len, ch)
        one = 1
        nxt = Add(len, one)
        ReturnValue(nxt)
    }
}

Function.SpSpace {
    Input: ch: Integer
    Output: Integer
    Body: {
        hit = 0
        IfCondition EqualTo(ch, 32) ThenBlock: {
            hit = 1
        }
        IfCondition EqualTo(ch, 9) ThenBlock: {
            hit = 1
        }
        IfCondition EqualTo(ch, 10) ThenBlock: {
            hit = 1
        }
        IfCondition EqualTo(ch, 11) ThenBlock: {
            hit = 1
        }
        IfCondition EqualTo(ch, 12) ThenBlock: {
            hit = 1
        }
        IfCondition EqualTo(ch, 13) ThenBlock: {
            hit = 1
        }
        ReturnValue(hit)
    }
}

Function.SpNameStart {
    Input: ch: Integer
    Output: Integer
    Body: {
        hit = 0
        IfCondition EqualTo(ch, 95) ThenBlock: {
            hit = 1
        }
        IfCondition GreaterEqual(ch, 65) ThenBlock: {
            IfCondition LessEqual(ch, 90) ThenBlock: {
                hit = 1
            }
        }
        IfCondition GreaterEqual(ch, 97) ThenBlock: {
            IfCondition LessEqual(ch, 122) ThenBlock: {
                hit = 1
            }
        }
        ReturnValue(hit)
    }
}

Function.SpNameChar {
    Input: ch: Integer
    Output: Integer
    Body: {
        hit = SpNameStart(ch)
        IfCondition GreaterEqual(ch, 48) ThenBlock: {
            IfCondition LessEqual(ch, 57) ThenBlock: {
                hit = 1
            }
        }
        ReturnValue(hit)
    }
}

Function.SpFind {
    Input: data: Address
    Input: length: Integer
    Input: name: Address
    Output: Address
    Body: {
        pos = 0
        nlen = StringLength(name)
        one = 1
        WhileLoop LessThan(pos, length) {
            entry = Add(data, pos)
            match = 1
            j = 0
            WhileLoop LessThan(j, nlen) {
                nb = GetByte(name, j)
                eb = GetByte(entry, j)
                IfCondition NotEqual(nb, eb) ThenBlock: {
                    match = 0
                    BreakLoop
                }
                j = Add(j, one)
            }
            IfCondition EqualTo(match, 1) ThenBlock: {
                eb = GetByte(entry, nlen)
                IfCondition EqualTo(eb, 61) ThenBlock: {
                    val = Add(entry, nlen)
                    val = Add(val, one)
                    ReturnValue(val)
                }
            }
            elen = StringLength(entry)
            elen = Add(elen, one)
            pos = Add(pos, elen)
        }
        ReturnValue(0)
    }
}

Function.ParseSplit {
    Input: text: Address
    Input: out: Address
    Input: cap: Integer
    Output: Integer
    Body: {
        ebuf = Allocate(262144)
        efd = SystemCall(2, "/proc/self/environ", 0, 0)
        elen = 0
        IfCondition GreaterEqual(efd, 0) ThenBlock: {
            elen = SystemCall(0, efd, ebuf, 262144)
            SystemCall(3, efd)
        }
        IfCondition LessThan(elen, 0) ThenBlock: {
            elen = 0
        }
        text_len = StringLength(text)
        out_len = 0
        narg = 0
        sep = 1
        dq = 0
        sq = 0
        i = 0
        one = 1
        WhileLoop LessThan(i, text_len) {
            ch = GetByte(text, i)
            ch = BitwiseAnd(ch, 255)
            do_add = 1
            newc = ch
            IfCondition EqualTo(do_add, 1) ThenBlock: {
                IfCondition EqualTo(ch, 39) ThenBlock: {
                    IfCondition EqualTo(dq, 0) ThenBlock: {
                        sq = Subtract(1, sq)
                        IfCondition EqualTo(sep, 1) ThenBlock: {
                            out_len = SpPush(out, out_len, cap, 0)
                            narg = Add(narg, one)
                            sep = 0
                        }
                        do_add = 0
                        i = Add(i, one)
                    }
                }
            }
            IfCondition EqualTo(do_add, 1) ThenBlock: {
                IfCondition EqualTo(ch, 34) ThenBlock: {
                    IfCondition EqualTo(sq, 0) ThenBlock: {
                        dq = Subtract(1, dq)
                        IfCondition EqualTo(sep, 1) ThenBlock: {
                            out_len = SpPush(out, out_len, cap, 0)
                            narg = Add(narg, one)
                            sep = 0
                        }
                        do_add = 0
                        i = Add(i, one)
                    }
                }
            }
            IfCondition EqualTo(do_add, 1) ThenBlock: {
                blank = SpSpace(ch)
                IfCondition EqualTo(blank, 1) ThenBlock: {
                    IfCondition EqualTo(sq, 0) ThenBlock: {
                        IfCondition EqualTo(dq, 0) ThenBlock: {
                            sep = 1
                            i = Add(i, one)
                            skipping = 1
                            WhileLoop EqualTo(skipping, 1) {
                                IfCondition LessThan(i, text_len) ThenBlock: {
                                    ch2 = GetByte(text, i)
                                    ch2 = BitwiseAnd(ch2, 255)
                                    blank2 = SpSpace(ch2)
                                    IfCondition EqualTo(blank2, 1) ThenBlock: {
                                        i = Add(i, one)
                                    } ElseBlock: {
                                        skipping = 0
                                    }
                                } ElseBlock: {
                                    skipping = 0
                                }
                            }
                            do_add = 0
                        }
                    }
                }
            }
            IfCondition EqualTo(do_add, 1) ThenBlock: {
                IfCondition EqualTo(ch, 35) ThenBlock: {
                    IfCondition EqualTo(sep, 1) ThenBlock: {
                        i = text_len
                        do_add = 0
                    }
                }
            }
            IfCondition EqualTo(do_add, 1) ThenBlock: {
                IfCondition EqualTo(ch, 92) ThenBlock: {
                    next_i = Add(i, one)
                    at_end = 0
                    nextb = 0
                    IfCondition GreaterEqual(next_i, text_len) ThenBlock: {
                        at_end = 1
                    } ElseBlock: {
                        nextb = GetByte(text, next_i)
                        nextb = BitwiseAnd(nextb, 255)
                    }
                    literal = 0
                    IfCondition EqualTo(sq, 1) ThenBlock: {
                        IfCondition EqualTo(at_end, 0) ThenBlock: {
                            IfCondition NotEqual(nextb, 92) ThenBlock: {
                                IfCondition NotEqual(nextb, 39) ThenBlock: {
                                    literal = 1
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(literal, 1) ThenBlock: {
                        newc = 92
                    } ElseBlock: {
                        IfCondition EqualTo(at_end, 1) ThenBlock: {
                            SpErr("env: invalid backslash at end of string in -S\n")
                            ReturnValue(-1)
                        }
                        i = next_i
                        taken = 0
                        IfCondition EqualTo(nextb, 34) ThenBlock: {
                            newc = nextb
                            taken = 1
                        }
                        IfCondition EqualTo(nextb, 35) ThenBlock: {
                            newc = nextb
                            taken = 1
                        }
                        IfCondition EqualTo(nextb, 36) ThenBlock: {
                            newc = nextb
                            taken = 1
                        }
                        IfCondition EqualTo(nextb, 39) ThenBlock: {
                            newc = nextb
                            taken = 1
                        }
                        IfCondition EqualTo(nextb, 92) ThenBlock: {
                            newc = nextb
                            taken = 1
                        }
                        IfCondition EqualTo(nextb, 95) ThenBlock: {
                            taken = 1
                            IfCondition EqualTo(dq, 0) ThenBlock: {
                                sep = 1
                                do_add = 0
                                i = Add(i, one)
                            } ElseBlock: {
                                newc = 32
                            }
                        }
                        IfCondition EqualTo(nextb, 99) ThenBlock: {
                            taken = 1
                            IfCondition EqualTo(dq, 1) ThenBlock: {
                                SpErr("env: '")
                                SpByte(92)
                                SpErr("c' must not appear in double-quoted -S string\n")
                                ReturnValue(-1)
                            }
                            i = text_len
                            do_add = 0
                        }
                        IfCondition EqualTo(nextb, 102) ThenBlock: {
                            newc = 12
                            taken = 1
                        }
                        IfCondition EqualTo(nextb, 110) ThenBlock: {
                            newc = 10
                            taken = 1
                        }
                        IfCondition EqualTo(nextb, 114) ThenBlock: {
                            newc = 13
                            taken = 1
                        }
                        IfCondition EqualTo(nextb, 116) ThenBlock: {
                            newc = 9
                            taken = 1
                        }
                        IfCondition EqualTo(nextb, 118) ThenBlock: {
                            newc = 11
                            taken = 1
                        }
                        IfCondition EqualTo(taken, 0) ThenBlock: {
                            SpErr("env: invalid sequence '")
                            SpByte(92)
                            SpByte(nextb)
                            SpErr("' in -S\n")
                            ReturnValue(-1)
                        }
                    }
                }
            }
            IfCondition EqualTo(do_add, 1) ThenBlock: {
                IfCondition EqualTo(ch, 36) ThenBlock: {
                    IfCondition EqualTo(sq, 0) ThenBlock: {
                        bad_var = 0
                        brace_at = Add(i, one)
                        IfCondition GreaterEqual(brace_at, text_len) ThenBlock: {
                            bad_var = 1
                        } ElseBlock: {
                            brace = GetByte(text, brace_at)
                            brace = BitwiseAnd(brace, 255)
                            IfCondition NotEqual(brace, 123) ThenBlock: {
                                bad_var = 1
                            }
                        }
                        name_at = Add(i, 2)
                        end_at = name_at
                        IfCondition EqualTo(bad_var, 0) ThenBlock: {
                            IfCondition GreaterEqual(name_at, text_len) ThenBlock: {
                                bad_var = 1
                            } ElseBlock: {
                                c0 = GetByte(text, name_at)
                                c0 = BitwiseAnd(c0, 255)
                                ok0 = SpNameStart(c0)
                                IfCondition EqualTo(ok0, 0) ThenBlock: {
                                    bad_var = 1
                                }
                            }
                        }
                        IfCondition EqualTo(bad_var, 0) ThenBlock: {
                            end_at = Add(name_at, one)
                            scanning = 1
                            WhileLoop EqualTo(scanning, 1) {
                                IfCondition GreaterEqual(end_at, text_len) ThenBlock: {
                                    bad_var = 1
                                    scanning = 0
                                } ElseBlock: {
                                    ce = GetByte(text, end_at)
                                    ce = BitwiseAnd(ce, 255)
                                    IfCondition EqualTo(ce, 125) ThenBlock: {
                                        scanning = 0
                                    } ElseBlock: {
                                        okc = SpNameChar(ce)
                                        IfCondition EqualTo(okc, 0) ThenBlock: {
                                            bad_var = 1
                                            scanning = 0
                                        } ElseBlock: {
                                            end_at = Add(end_at, one)
                                        }
                                    }
                                }
                            }
                        }
                        IfCondition EqualTo(bad_var, 1) ThenBlock: {
                            SpErr("env: only ${VARNAME} expansion is supported, error at: ")
                            restp = Add(text, i)
                            SpErr(restp)
                            SpErr("\n")
                            ReturnValue(-1)
                        }
                        nlen = Subtract(end_at, name_at)
                        nbuf = Allocate(256)
                        k = 0
                        WhileLoop LessThan(k, nlen) {
                            nb = GetByte(text, Add(name_at, k))
                            SetByte(nbuf, k, nb)
                            k = Add(k, one)
                        }
                        SetByte(nbuf, nlen, 0)
                        val = SpFind(ebuf, elen, nbuf)
                        IfCondition NotEqual(val, 0) ThenBlock: {
                            vlen = StringLength(val)
                            IfCondition GreaterThan(vlen, 0) ThenBlock: {
                                IfCondition EqualTo(sep, 1) ThenBlock: {
                                    out_len = SpPush(out, out_len, cap, 0)
                                    narg = Add(narg, one)
                                    sep = 0
                                }
                                k = 0
                                WhileLoop LessThan(k, vlen) {
                                    vb = GetByte(val, k)
                                    out_len = SpPush(out, out_len, cap, vb)
                                    k = Add(k, one)
                                }
                            }
                        }
                        i = Add(end_at, one)
                        do_add = 0
                    }
                }
            }
            IfCondition LessThan(out_len, 0) ThenBlock: {
                SpErr("env: -S string is too long\n")
                ReturnValue(-1)
            }
            IfCondition EqualTo(do_add, 1) ThenBlock: {
                IfCondition EqualTo(sep, 1) ThenBlock: {
                    out_len = SpPush(out, out_len, cap, 0)
                    narg = Add(narg, one)
                    sep = 0
                }
                out_len = SpPush(out, out_len, cap, newc)
                i = Add(i, one)
            }
            IfCondition LessThan(out_len, 0) ThenBlock: {
                SpErr("env: -S string is too long\n")
                ReturnValue(-1)
            }
        }
        openq = 0
        IfCondition EqualTo(dq, 1) ThenBlock: {
            openq = 1
        }
        IfCondition EqualTo(sq, 1) ThenBlock: {
            openq = 1
        }
        IfCondition EqualTo(openq, 1) ThenBlock: {
            SpErr("env: no terminating quote in -S string\n")
            ReturnValue(-1)
        }
        IfCondition EqualTo(narg, 0) ThenBlock: {
            ReturnValue(0)
        }
        out_len = SpPush(out, out_len, cap, 0)
        IfCondition LessThan(out_len, 0) ThenBlock: {
            SpErr("env: -S string is too long\n")
            ReturnValue(-1)
        }
        ReturnValue(out_len)
    }
}

Function.RebuildArgs {
    Input: argv0: Address
    Input: spec: Address
    Input: rest: Address
    Input: rest_len: Integer
    Input: out: Address
    Input: cap: Integer
    Output: Integer
    Body: {
        tmp = Allocate(65536)
        slen = ParseSplit(spec, tmp, 65536)
        IfCondition LessThan(slen, 0) ThenBlock: {
            ReturnValue(-1)
        }
        n = 0
        one = 1
        alen = StringLength(argv0)
        k = 0
        WhileLoop LessThan(k, alen) {
            ab = GetByte(argv0, k)
            n = SpPush(out, n, cap, ab)
            k = Add(k, one)
        }
        n = SpPush(out, n, cap, 0)
        IfCondition GreaterThan(slen, 0) ThenBlock: {
            k = 1
            WhileLoop LessThan(k, slen) {
                ab = GetByte(tmp, k)
                n = SpPush(out, n, cap, ab)
                k = Add(k, one)
            }
        }
        k = 0
        WhileLoop LessThan(k, rest_len) {
            ab = GetByte(rest, k)
            n = SpPush(out, n, cap, ab)
            k = Add(k, one)
        }
        IfCondition LessThan(n, 0) ThenBlock: {
            SpErr("env: -S string is too long\n")
            ReturnValue(-1)
        }
        ReturnValue(n)
    }
}
