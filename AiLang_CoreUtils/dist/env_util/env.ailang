// env.ailang - Run a command in a modified environment
// No command: print the environment. "-" and "-i" start from an empty one.
// NAME=value assignments are applied before the command is searched.
// Exit 125 on a usage error, 126 if the command cannot be run, 127 if it
// cannot be found, otherwise the command replaces this process.

LibraryImport.Arena
LibraryImport.AiLang_CoreUtils.dist.env_util.EnvSplit
LibraryImport.AiLang_CoreUtils.dist.env_util.EnvSignal

Function.WriteStdout {
    Input: str: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 1, str, len)
    }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.StorePointer {
    Input: addr: Address
    Input: value: Address
    Body: {
        i = 0
        WhileLoop LessThan(i, 8) {
            byte_val = BitwiseAnd(RightShift(value, Multiply(i, 8)), 255)
            SetByte(addr, i, byte_val)
            i = Add(i, 1)
        }
    }
}

Function.StoreInt {
    Input: addr: Address
    Input: value: Integer
    Body: {
        cur = value
        i = 0
        one = 1
        eight = 8
        WhileLoop LessThan(i, 8) {
            low = BitwiseAnd(cur, 255)
            SetByte(addr, i, low)
            cur = RightShift(cur, eight)
            i = Add(i, one)
        }
    }
}

Function.LoadInt {
    Input: addr: Address
    Output: Integer
    Body: {
        b0 = GetByte(addr, 0)
        b0 = BitwiseAnd(b0, 255)
        b1 = GetByte(addr, 1)
        b1 = BitwiseAnd(b1, 255)
        b2 = GetByte(addr, 2)
        b2 = BitwiseAnd(b2, 255)
        b3 = GetByte(addr, 3)
        b3 = BitwiseAnd(b3, 255)
        b4 = GetByte(addr, 4)
        b4 = BitwiseAnd(b4, 255)
        b5 = GetByte(addr, 5)
        b5 = BitwiseAnd(b5, 255)
        b6 = GetByte(addr, 6)
        b6 = BitwiseAnd(b6, 255)
        b7 = GetByte(addr, 7)
        b7 = BitwiseAnd(b7, 255)
        v = b0
        v = BitwiseOr(v, LeftShift(b1, 8))
        v = BitwiseOr(v, LeftShift(b2, 16))
        v = BitwiseOr(v, LeftShift(b3, 24))
        v = BitwiseOr(v, LeftShift(b4, 32))
        v = BitwiseOr(v, LeftShift(b5, 40))
        v = BitwiseOr(v, LeftShift(b6, 48))
        v = BitwiseOr(v, LeftShift(b7, 56))
        ReturnValue(v)
    }
}

Function.WriteErrByte {
    Input: ch: Integer
    Body: {
        buf = Allocate(2)
        SetByte(buf, 0, ch)
        SetByte(buf, 1, 0)
        SystemCall(1, 2, buf, 1)
    }
}

Function.HasBlank {
    Input: str: Address
    Output: Integer
    Body: {
        n = StringLength(str)
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            ch = GetByte(str, i)
            ch = BitwiseAnd(ch, 255)
            hit = 0
            IfCondition EqualTo(ch, 32) ThenBlock: {
                hit = 1
            }
            IfCondition EqualTo(ch, 9) ThenBlock: {
                hit = 1
            }
            IfCondition EqualTo(ch, 10) ThenBlock: {
                hit = 1
            }
            IfCondition EqualTo(ch, 11) ThenBlock: {
                hit = 1
            }
            IfCondition EqualTo(ch, 12) ThenBlock: {
                hit = 1
            }
            IfCondition EqualTo(ch, 13) ThenBlock: {
                hit = 1
            }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.ExecFail {
    Input: cmd: Address
    Input: err: Integer
    Body: {
        WriteStderr("env: '")
        WriteStderr(cmd)
        WriteStderr("': ")
        IfCondition EqualTo(err, 2) ThenBlock: {
            WriteStderr("No such file or directory\n")
        }
        IfCondition EqualTo(err, 13) ThenBlock: {
            WriteStderr("Permission denied\n")
        }
        IfCondition EqualTo(err, 21) ThenBlock: {
            WriteStderr("Is a directory\n")
        }
        IfCondition EqualTo(err, 20) ThenBlock: {
            WriteStderr("Not a directory\n")
        }
        known = 0
        IfCondition EqualTo(err, 2) ThenBlock: {
            known = 1
        }
        IfCondition EqualTo(err, 13) ThenBlock: {
            known = 1
        }
        IfCondition EqualTo(err, 21) ThenBlock: {
            known = 1
        }
        IfCondition EqualTo(err, 20) ThenBlock: {
            known = 1
        }
        IfCondition EqualTo(known, 0) ThenBlock: {
            WriteStderr("cannot execute file\n")
        }
        IfCondition EqualTo(err, 2) ThenBlock: {
            blank = HasBlank(cmd)
            IfCondition EqualTo(blank, 1) ThenBlock: {
                WriteStderr("env: use -[v]S to pass options in shebang lines\n")
            }
            SystemCall(60, 127)
        }
        SystemCall(60, 126)
    }
}

Function.TakeSplit {
    Input: old: Address
    Input: old_len: Integer
    Input: pos: Integer
    Input: spec: Address
    Input: len_out: Address
    Output: Address
    Body: {
        newcmd = Allocate(262144)
        restp = 0
        restn = 0
        IfCondition LessThan(pos, old_len) ThenBlock: {
            restp = Add(old, pos)
            restn = Subtract(old_len, pos)
        }
        argv0 = Add(old, 0)
        nlen = RebuildArgs(argv0, spec, restp, restn, newcmd, 262144)
        IfCondition LessThan(nlen, 0) ThenBlock: {
            ReturnValue(0)
        }
        StoreInt(len_out, nlen)
        ReturnValue(newcmd)
    }
}

Function.NextEntry {
    Input: data: Address
    Input: pos: Integer
    Input: length: Integer
    Output: Integer
    Body: {
        WhileLoop LessThan(pos, length) {
            ch = GetByte(data, pos)
            pos = Add(pos, 1)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                ReturnValue(pos)
            }
        }
        ReturnValue(pos)
    }
}

Function.ArgLength {
    Input: data: Address
    Input: pos: Integer
    Output: Integer
    Body: {
        n = 0
        WhileLoop LessThan(n, 65536) {
            ch = GetByte(data, Add(pos, n))
            IfCondition EqualTo(ch, 0) ThenBlock: {
                ReturnValue(n)
            }
            n = Add(n, 1)
        }
        ReturnValue(n)
    }
}

Function.CopyArg {
    Input: data: Address
    Input: pos: Integer
    Output: Address
    Body: {
        n = ArgLength(data, pos)
        word = Allocate(Add(n, 1))
        i = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(data, Add(pos, i))
            SetByte(word, i, ch)
            i = Add(i, 1)
        }
        SetByte(word, n, 0)
        ReturnValue(word)
    }
}

Function.CopyCString {
    Input: src: Address
    Output: Address
    Body: {
        n = StringLength(src)
        dst = Allocate(Add(n, 1))
        i = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(src, i)
            SetByte(dst, i, ch)
            i = Add(i, 1)
        }
        SetByte(dst, n, 0)
        ReturnValue(dst)
    }
}

Function.CopySuffix {
    Input: word: Address
    Input: skip: Integer
    Output: Address
    Body: {
        src = Add(word, skip)
        copied = CopyCString(src)
        ReturnValue(copied)
    }
}

Function.StartsWith {
    Input: str: Address
    Input: prefix: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 256) {
            prefix_ch = GetByte(prefix, i)
            IfCondition EqualTo(prefix_ch, 0) ThenBlock: {
                ReturnValue(1)
            }
            str_ch = GetByte(str, i)
            IfCondition NotEqual(str_ch, prefix_ch) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.ContainsByte {
    Input: str: Address
    Input: want: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 65536) {
            ch = GetByte(str, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(ch, want) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.ShowHelp {
    Body: {
        WriteStderr("Usage: env [OPTION]... [-] [NAME=VALUE]... [COMMAND [ARG]...]\n")
    }
}

Function.ShowVersion {
    Body: {
        WriteStdout("env (AiLang coreutils) 1.0\n", 28)
    }
}

Function.UsageError {
    Body: {
        WriteStderr("Try 'env --help' for more information.\n")
        SystemCall(60, 125)
    }
}

Function.ReadEnviron {
    Input: buf: Address
    Input: cap: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, "/proc/self/environ", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = SystemCall(0, fd, buf, cap)
        SystemCall(3, fd)
        IfCondition LessThan(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(n)
    }
}

Function.EnvNameMatch {
    Input: entry: Address
    Input: name: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 4096) {
            name_ch = GetByte(name, i)
            entry_ch = GetByte(entry, i)
            IfCondition EqualTo(name_ch, 0) ThenBlock: {
                ReturnValue(EqualTo(entry_ch, 61))
            }
            IfCondition NotEqual(name_ch, entry_ch) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.EnvAssignMatch {
    Input: entry: Address
    Input: assignment: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 4096) {
            assign_ch = GetByte(assignment, i)
            entry_ch = GetByte(entry, i)
            IfCondition EqualTo(assign_ch, 61) ThenBlock: {
                ReturnValue(EqualTo(entry_ch, 61))
            }
            IfCondition EqualTo(assign_ch, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition NotEqual(assign_ch, entry_ch) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.EnvRemove {
    Input: data: Address
    Input: length: Integer
    Input: key: Address
    Input: assign_form: Integer
    Output: Integer
    Body: {
        read_pos = 0
        write_pos = 0
        WhileLoop LessThan(read_pos, length) {
            entry = Add(data, read_pos)
            match = 0
            IfCondition EqualTo(assign_form, 1) ThenBlock: {
                match = EnvAssignMatch(entry, key)
            } ElseBlock: {
                match = EnvNameMatch(entry, key)
            }
            entry_len = StringLength(entry)
            entry_len = Add(entry_len, 1)
            IfCondition EqualTo(match, 0) ThenBlock: {
                k = 0
                WhileLoop LessThan(k, entry_len) {
                    byte = GetByte(data, Add(read_pos, k))
                    SetByte(data, Add(write_pos, k), byte)
                    k = Add(k, 1)
                }
                write_pos = Add(write_pos, entry_len)
            }
            read_pos = Add(read_pos, entry_len)
        }
        ReturnValue(write_pos)
    }
}

Function.EnvAppend {
    Input: data: Address
    Input: length: Integer
    Input: assignment: Address
    Input: cap: Integer
    Output: Integer
    Body: {
        assign_len = StringLength(assignment)
        need = Add(length, assign_len)
        need = Add(need, 1)
        IfCondition GreaterThan(need, cap) ThenBlock: {
            ReturnValue(-1)
        }
        k = 0
        WhileLoop LessThan(k, assign_len) {
            ch = GetByte(assignment, k)
            SetByte(data, Add(length, k), ch)
            k = Add(k, 1)
        }
        SetByte(data, Add(length, assign_len), 0)
        ReturnValue(need)
    }
}

Function.EnvSet {
    Input: data: Address
    Input: length: Integer
    Input: assignment: Address
    Input: cap: Integer
    Output: Integer
    Body: {
        length2 = EnvRemove(data, length, assignment, 1)
        length3 = EnvAppend(data, length2, assignment, cap)
        ReturnValue(length3)
    }
}

Function.BadUnsetName {
    Input: name: Address
    Output: Integer
    Body: {
        first = GetByte(name, 0)
        IfCondition EqualTo(first, 0) ThenBlock: {
            ReturnValue(1)
        }
        i = 0
        WhileLoop LessThan(i, 4096) {
            ch = GetByte(name, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(ch, 61) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.PrintEnv {
    Input: data: Address
    Input: length: Integer
    Input: nul_out: Integer
    Body: {
        pos = 0
        WhileLoop LessThan(pos, length) {
            entry = Add(data, pos)
            entry_len = StringLength(entry)
            WriteStdout(entry, entry_len)
            IfCondition EqualTo(nul_out, 1) ThenBlock: {
                zero = Allocate(1)
                SetByte(zero, 0, 0)
                WriteStdout(zero, 1)
                Deallocate(zero, 1)
            } ElseBlock: {
                WriteStdout("\n", 1)
            }
            pos = NextEntry(data, pos, length)
        }
    }
}

Function.CountArgs {
    Input: data: Address
    Input: pos: Integer
    Input: length: Integer
    Output: Integer
    Body: {
        count = 0
        WhileLoop LessThan(pos, length) {
            count = Add(count, 1)
            pos = NextEntry(data, pos, length)
        }
        ReturnValue(count)
    }
}

Function.BuildPointerArray {
    Input: data: Address
    Input: pos: Integer
    Input: length: Integer
    Output: Address
    Body: {
        count = CountArgs(data, pos, length)
        bytes = Multiply(Add(count, 1), 8)
        arr = Allocate(bytes)
        idx = 0
        cursor = pos
        WhileLoop LessThan(idx, count) {
            slot = Add(arr, Multiply(idx, 8))
            entry = Add(data, cursor)
            StorePointer(slot, entry)
            cursor = NextEntry(data, cursor, length)
            idx = Add(idx, 1)
        }
        tail = Add(arr, Multiply(count, 8))
        StorePointer(tail, 0)
        ReturnValue(arr)
    }
}

Function.ExtractPath {
    Input: data: Address
    Input: length: Integer
    Output: Address
    Body: {
        pos = 0
        WhileLoop LessThan(pos, length) {
            entry = Add(data, pos)
            match = EnvNameMatch(entry, "PATH")
            IfCondition EqualTo(match, 1) ThenBlock: {
                value = Add(entry, 5)
                copied = CopyCString(value)
                ReturnValue(copied)
            }
            pos = NextEntry(data, pos, length)
        }
        ReturnValue(0)
    }
}

Function.WrapHit {
    Input: buf: Address
    Input: nread: Integer
    Input: needle: Address
    Output: Integer
    Body: {
        nlen = StringLength(needle)
        IfCondition LessThan(nread, nlen) ThenBlock: {
            ReturnValue(0)
        }
        b0 = GetByte(buf, 0)
        b1 = GetByte(buf, 1)
        IfCondition NotEqual(b0, 35) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(b1, 33) ThenBlock: {
            ReturnValue(0)
        }
        i = 0
        one = 1
        last = Subtract(nread, nlen)
        WhileLoop LessEqual(i, last) {
            match = 1
            j = 0
            WhileLoop LessThan(j, nlen) {
                cb = GetByte(buf, Add(i, j))
                nb = GetByte(needle, j)
                IfCondition NotEqual(cb, nb) ThenBlock: {
                    match = 0
                    j = nlen
                } ElseBlock: {
                    j = Add(j, one)
                }
            }
            IfCondition EqualTo(match, 1) ThenBlock: {
                after = Add(i, nlen)
                ok = 1
                IfCondition LessThan(after, nread) ThenBlock: {
                    ab = GetByte(buf, after)
                    IfCondition EqualTo(ab, 95) ThenBlock: {
                        ok = 0
                    }
                    IfCondition GreaterEqual(ab, 48) ThenBlock: {
                        IfCondition LessEqual(ab, 57) ThenBlock: {
                            ok = 0
                        }
                    }
                    IfCondition GreaterEqual(ab, 65) ThenBlock: {
                        IfCondition LessEqual(ab, 90) ThenBlock: {
                            ok = 0
                        }
                    }
                    IfCondition GreaterEqual(ab, 97) ThenBlock: {
                        IfCondition LessEqual(ab, 122) ThenBlock: {
                            ok = 0
                        }
                    }
                }
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    ReturnValue(1)
                }
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.UnwrapEnv {
    Input: path: Address
    Output: Address
    Body: {
        n = StringLength(path)
        i = n
        one = 1
        slash = -1
        WhileLoop GreaterThan(i, 0) {
            i = Subtract(i, one)
            ch = GetByte(path, i)
            IfCondition EqualTo(ch, 47) ThenBlock: {
                slash = i
                i = 0
            }
        }
        start = 0
        IfCondition GreaterEqual(slash, 0) ThenBlock: {
            start = Add(slash, one)
        }
        basep = Add(path, start)
        blen = StringLength(basep)
        IfCondition EqualTo(blen, 0) ThenBlock: {
            ReturnValue(path)
        }
        prefix = "/tmp/utilbench/bin/"
        plen = StringLength(prefix)
        total = Add(plen, blen)
        total = Add(total, one)
        needle = Allocate(total)
        k = 0
        WhileLoop LessThan(k, plen) {
            ch = GetByte(prefix, k)
            SetByte(needle, k, ch)
            k = Add(k, one)
        }
        k = 0
        WhileLoop LessThan(k, blen) {
            ch = GetByte(basep, k)
            at = Add(plen, k)
            SetByte(needle, at, ch)
            k = Add(k, one)
        }
        endat = Add(plen, blen)
        SetByte(needle, endat, 0)
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(path)
        }
        buf = Allocate(2048)
        nread = SystemCall(0, fd, buf, 2048)
        SystemCall(3, fd)
        hit = 0
        IfCondition GreaterThan(nread, 0) ThenBlock: {
            hit = WrapHit(buf, nread, needle)
        }
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReturnValue(needle)
        }
        ReturnValue(path)
    }
}

Function.ExecAt {
    Input: path: Address
    Input: argv: Address
    Input: envp: Address
    Output: Integer
    Body: {
        use = UnwrapEnv(path)
        result = SystemCall(59, use, argv, envp)
        IfCondition GreaterEqual(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        err = Subtract(0, result)
        ReturnValue(err)
    }
}

Function.BuildCandidate {
    Input: path_value: Address
    Input: start: Integer
    Input: comp_len: Integer
    Input: cmd: Address
    Output: Address
    Body: {
        cmd_len = StringLength(cmd)
        dir_len = comp_len
        IfCondition EqualTo(comp_len, 0) ThenBlock: {
            dir_len = 1
        }
        total = Add(dir_len, cmd_len)
        total = Add(total, 2)
        full = Allocate(total)
        name_at = 0
        IfCondition EqualTo(comp_len, 0) ThenBlock: {
            SetByte(full, 0, 46)
            SetByte(full, 1, 47)
            name_at = 2
        } ElseBlock: {
            k = 0
            WhileLoop LessThan(k, comp_len) {
                ch = GetByte(path_value, Add(start, k))
                SetByte(full, k, ch)
                k = Add(k, 1)
            }
            SetByte(full, comp_len, 47)
            name_at = Add(comp_len, 1)
        }
        k = 0
        WhileLoop LessThan(k, cmd_len) {
            ch = GetByte(cmd, k)
            SetByte(full, Add(name_at, k), ch)
            k = Add(k, 1)
        }
        end_at = Add(name_at, cmd_len)
        SetByte(full, end_at, 0)
        ReturnValue(full)
    }
}

Function.NoteMiss {
    Input: err: Integer
    Input: saw_eacces: Integer
    Output: Integer
    Body: {
        miss = 0
        IfCondition EqualTo(err, 2) ThenBlock: {
            miss = 1
        }
        IfCondition EqualTo(err, 20) ThenBlock: {
            miss = 1
        }
        IfCondition EqualTo(err, 40) ThenBlock: {
            miss = 1
        }
        IfCondition EqualTo(miss, 1) ThenBlock: {
            ReturnValue(saw_eacces)
        }
        ReturnValue(1)
    }
}

Function.ExecSearch {
    Input: cmd: Address
    Input: argv: Address
    Input: envp: Address
    Input: path_value: Address
    Body: {
        use_path = path_value
        IfCondition EqualTo(path_value, 0) ThenBlock: {
            use_path = "/usr/local/bin:/usr/bin:/bin"
        }
        plen = StringLength(use_path)
        saw_eacces = 0
        start = 0
        i = 0
        WhileLoop LessEqual(i, plen) {
            at_end = EqualTo(i, plen)
            ch = 0
            IfCondition EqualTo(at_end, 0) ThenBlock: {
                ch = GetByte(use_path, i)
            }
            is_colon = EqualTo(ch, 58)
            boundary = Or(is_colon, at_end)
            IfCondition EqualTo(boundary, 1) ThenBlock: {
                comp_len = Subtract(i, start)
                full = BuildCandidate(use_path, start, comp_len, cmd)
                err = ExecAt(full, argv, envp)
                Deallocate(full, 0)
                saw_eacces = NoteMiss(err, saw_eacces)
                start = Add(i, 1)
            }
            i = Add(i, 1)
        }
        fail_err = 2
        IfCondition EqualTo(saw_eacces, 1) ThenBlock: {
            fail_err = 13
        }
        ExecFail(cmd, fail_err)
    }
}

Function.ExecCommand {
    Input: cmd: Address
    Input: argv: Address
    Input: envp: Address
    Input: path_value: Address
    Body: {
        slash = ContainsByte(cmd, 47)
        IfCondition EqualTo(slash, 1) ThenBlock: {
            err = ExecAt(cmd, argv, envp)
            ExecFail(cmd, err)
        }
        ExecSearch(cmd, argv, envp, path_value)
    }
}

Function.RememberUnset {
    Input: unsets: Address
    Input: unset_count: Integer
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition GreaterThan(unset_count, 63) ThenBlock: {
            WriteStderr("env: too many -u options\n")
            UsageError()
        }
        ArraySet(unsets, unset_count, name)
        ReturnValue(Add(unset_count, 1))
    }
}

SubRoutine.Main {
    cmd_cap = 65536
    cmd = Allocate(cmd_cap)
    fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
    IfCondition LessThan(fd, 0) ThenBlock: {
        SystemCall(60, 125)
    }
    cmd_len = SystemCall(0, fd, cmd, cmd_cap)
    SystemCall(3, fd)
    IfCondition LessEqual(cmd_len, 0) ThenBlock: {
        SystemCall(60, 125)
    }

    pos = NextEntry(cmd, 0, cmd_len)
    ignore = 0
    nul_out = 0
    newdir = 0
    opt_done = 0
    assign_pos = pos
    unsets = ArrayCreate(64)
    unset_count = 0
    one = 1
    modes = Allocate(64)
    SgZero(modes, 64)
    block = Allocate(8)
    SgZero(block, 8)
    unblock = Allocate(8)
    SgZero(unblock, 8)
    mask_changed = 0
    list_on = 0
    splits = 0
    len_box = Allocate(8)

    WhileLoop LessThan(pos, cmd_len) {
        IfCondition EqualTo(opt_done, 1) ThenBlock: {
            pos = cmd_len
        } ElseBlock: {
            arg_start = pos
            word = CopyArg(cmd, pos)
            pos = NextEntry(cmd, pos, cmd_len)
            word_len = StringLength(word)
            first = GetByte(word, 0)

            IfCondition EqualTo(word_len, 0) ThenBlock: {
                assign_pos = arg_start
                opt_done = 1
                Deallocate(word, 1)
            } ElseBlock: {
                IfCondition NotEqual(first, 45) ThenBlock: {
                    assign_pos = arg_start
                    opt_done = 1
                    Deallocate(word, Add(word_len, 1))
                } ElseBlock: {
                    IfCondition EqualTo(word_len, 1) ThenBlock: {
                        assign_pos = arg_start
                        opt_done = 1
                        Deallocate(word, 2)
                    } ElseBlock: {
                        second = GetByte(word, 1)
                        IfCondition EqualTo(second, 45) ThenBlock: {
                            took = 0
                            IfCondition StringEquals(word, "--") ThenBlock: {
                                assign_pos = pos
                                opt_done = 1
                                took = 1
                            }
                            IfCondition StringEquals(word, "--help") ThenBlock: {
                                ShowHelp()
                                SystemCall(60, 0)
                            }
                            IfCondition StringEquals(word, "--version") ThenBlock: {
                                ShowVersion()
                                SystemCall(60, 0)
                            }
                            IfCondition StringEquals(word, "--ignore-environment") ThenBlock: {
                                ignore = 1
                                took = 1
                            }
                            IfCondition StringEquals(word, "--null") ThenBlock: {
                                nul_out = 1
                                took = 1
                            }
                            IfCondition StringEquals(word, "--unset") ThenBlock: {
                                IfCondition GreaterEqual(pos, cmd_len) ThenBlock: {
                                    WriteStderr("env: option requires an argument -- 'u'\n")
                                    UsageError()
                                }
                                unset_name = Add(cmd, pos)
                                pos = NextEntry(cmd, pos, cmd_len)
                                unset_count = RememberUnset(unsets, unset_count, unset_name)
                                took = 1
                            }
                            prefixed_unset = StartsWith(word, "--unset=")
                            IfCondition EqualTo(prefixed_unset, 1) ThenBlock: {
                                unset_name = CopySuffix(word, 8)
                                unset_count = RememberUnset(unsets, unset_count, unset_name)
                                took = 1
                            }
                            IfCondition StringEquals(word, "--chdir") ThenBlock: {
                                IfCondition GreaterEqual(pos, cmd_len) ThenBlock: {
                                    WriteStderr("env: option requires an argument -- 'C'\n")
                                    UsageError()
                                }
                                newdir = Add(cmd, pos)
                                pos = NextEntry(cmd, pos, cmd_len)
                                took = 1
                            }
                            prefixed_dir = StartsWith(word, "--chdir=")
                            IfCondition EqualTo(prefixed_dir, 1) ThenBlock: {
                                newdir = CopySuffix(word, 8)
                                took = 1
                            }
                            IfCondition StringEquals(word, "--debug") ThenBlock: {
                                took = 1
                            }
                            IfCondition StringEquals(word, "--list-signal-handling") ThenBlock: {
                                list_on = 1
                                took = 1
                            }
                            IfCondition StringEquals(word, "--split-string") ThenBlock: {
                                IfCondition GreaterEqual(pos, cmd_len) ThenBlock: {
                                    WriteStderr("env: option requires an argument -- 'S'\n")
                                    UsageError()
                                }
                                spec = CopyArg(cmd, pos)
                                pos = NextEntry(cmd, pos, cmd_len)
                                splits = Add(splits, one)
                                IfCondition GreaterThan(splits, 32) ThenBlock: {
                                    WriteStderr("env: too many -S options\n")
                                    UsageError()
                                }
                                newcmd = TakeSplit(cmd, cmd_len, pos, spec, len_box)
                                IfCondition EqualTo(newcmd, 0) ThenBlock: {
                                    SystemCall(60, 125)
                                }
                                cmd = newcmd
                                cmd_len = LoadInt(len_box)
                                pos = NextEntry(cmd, 0, cmd_len)
                                took = 1
                            }
                            split_pref = StartsWith(word, "--split-string=")
                            IfCondition EqualTo(split_pref, 1) ThenBlock: {
                                spec = CopySuffix(word, 15)
                                splits = Add(splits, one)
                                IfCondition GreaterThan(splits, 32) ThenBlock: {
                                    WriteStderr("env: too many -S options\n")
                                    UsageError()
                                }
                                newcmd = TakeSplit(cmd, cmd_len, pos, spec, len_box)
                                IfCondition EqualTo(newcmd, 0) ThenBlock: {
                                    SystemCall(60, 125)
                                }
                                cmd = newcmd
                                cmd_len = LoadInt(len_box)
                                pos = NextEntry(cmd, 0, cmd_len)
                                took = 1
                            }
                            IfCondition StringEquals(word, "--default-signal") ThenBlock: {
                                sig_rc = SgApplyOne(modes, 0, 1)
                                IfCondition LessThan(sig_rc, 0) ThenBlock: {
                                    WriteStderr("Try 'env --help' for more information.\n")
                                    SystemCall(60, 125)
                                }
                                sig_rc = SgMaskOne(block, unblock, 0, 0)
                                mask_changed = 1
                                took = 1
                            }
                            def_pref = StartsWith(word, "--default-signal=")
                            IfCondition EqualTo(def_pref, 1) ThenBlock: {
                                spec = CopySuffix(word, 17)
                                sig_rc = SgApplyOne(modes, spec, 1)
                                IfCondition LessThan(sig_rc, 0) ThenBlock: {
                                    WriteStderr("Try 'env --help' for more information.\n")
                                    SystemCall(60, 125)
                                }
                                sig_rc = SgMaskOne(block, unblock, spec, 0)
                                IfCondition LessThan(sig_rc, 0) ThenBlock: {
                                    WriteStderr("Try 'env --help' for more information.\n")
                                    SystemCall(60, 125)
                                }
                                mask_changed = 1
                                took = 1
                            }
                            IfCondition StringEquals(word, "--ignore-signal") ThenBlock: {
                                sig_rc = SgApplyOne(modes, 0, 0)
                                IfCondition LessThan(sig_rc, 0) ThenBlock: {
                                    WriteStderr("Try 'env --help' for more information.\n")
                                    SystemCall(60, 125)
                                }
                                took = 1
                            }
                            ign_pref = StartsWith(word, "--ignore-signal=")
                            IfCondition EqualTo(ign_pref, 1) ThenBlock: {
                                spec = CopySuffix(word, 16)
                                sig_rc = SgApplyOne(modes, spec, 0)
                                IfCondition LessThan(sig_rc, 0) ThenBlock: {
                                    WriteStderr("Try 'env --help' for more information.\n")
                                    SystemCall(60, 125)
                                }
                                took = 1
                            }
                            IfCondition StringEquals(word, "--block-signal") ThenBlock: {
                                sig_rc = SgMaskOne(block, unblock, 0, 1)
                                mask_changed = 1
                                took = 1
                            }
                            blk_pref = StartsWith(word, "--block-signal=")
                            IfCondition EqualTo(blk_pref, 1) ThenBlock: {
                                spec = CopySuffix(word, 15)
                                sig_rc = SgMaskOne(block, unblock, spec, 1)
                                IfCondition LessThan(sig_rc, 0) ThenBlock: {
                                    WriteStderr("Try 'env --help' for more information.\n")
                                    SystemCall(60, 125)
                                }
                                mask_changed = 1
                                took = 1
                            }
                            IfCondition EqualTo(took, 0) ThenBlock: {
                                WriteStderr("env: unrecognized option '")
                                WriteStderr(word)
                                WriteStderr("'\n")
                                UsageError()
                            }
                        } ElseBlock: {
                            i = 1
                            stop_cluster = 0
                            WhileLoop LessThan(i, word_len) {
                                flag_ch = GetByte(word, i)
                                known = 0
                                IfCondition EqualTo(flag_ch, 105) ThenBlock: {
                                    ignore = 1
                                    known = 1
                                }
                                IfCondition EqualTo(flag_ch, 48) ThenBlock: {
                                    nul_out = 1
                                    known = 1
                                }
                                IfCondition EqualTo(flag_ch, 118) ThenBlock: {
                                    known = 1
                                }
                                IfCondition EqualTo(flag_ch, 117) ThenBlock: {
                                    known = 1
                                    rest = Add(i, 1)
                                    IfCondition LessThan(rest, word_len) ThenBlock: {
                                        unset_name = CopySuffix(word, rest)
                                        unset_count = RememberUnset(unsets, unset_count, unset_name)
                                        stop_cluster = 1
                                    } ElseBlock: {
                                        IfCondition GreaterEqual(pos, cmd_len) ThenBlock: {
                                            WriteStderr("env: option requires an argument -- 'u'\n")
                                            UsageError()
                                        }
                                        unset_name = Add(cmd, pos)
                                        pos = NextEntry(cmd, pos, cmd_len)
                                        unset_count = RememberUnset(unsets, unset_count, unset_name)
                                    }
                                }
                                IfCondition EqualTo(flag_ch, 67) ThenBlock: {
                                    known = 1
                                    rest = Add(i, 1)
                                    IfCondition LessThan(rest, word_len) ThenBlock: {
                                        newdir = CopySuffix(word, rest)
                                        stop_cluster = 1
                                    } ElseBlock: {
                                        IfCondition GreaterEqual(pos, cmd_len) ThenBlock: {
                                            WriteStderr("env: option requires an argument -- 'C'\n")
                                            UsageError()
                                        }
                                        newdir = Add(cmd, pos)
                                        pos = NextEntry(cmd, pos, cmd_len)
                                    }
                                }
                                blank_opt = 0
                                IfCondition EqualTo(flag_ch, 32) ThenBlock: {
                                    blank_opt = 1
                                }
                                IfCondition EqualTo(flag_ch, 9) ThenBlock: {
                                    blank_opt = 1
                                }
                                IfCondition EqualTo(flag_ch, 10) ThenBlock: {
                                    blank_opt = 1
                                }
                                IfCondition EqualTo(flag_ch, 11) ThenBlock: {
                                    blank_opt = 1
                                }
                                IfCondition EqualTo(flag_ch, 12) ThenBlock: {
                                    blank_opt = 1
                                }
                                IfCondition EqualTo(flag_ch, 13) ThenBlock: {
                                    blank_opt = 1
                                }
                                IfCondition EqualTo(blank_opt, 1) ThenBlock: {
                                    WriteStderr("env: invalid option -- '")
                                    WriteErrByte(flag_ch)
                                    WriteStderr("'\n")
                                    WriteStderr("env: use -[v]S to pass options in shebang lines\n")
                                    UsageError()
                                }
                                IfCondition EqualTo(flag_ch, 83) ThenBlock: {
                                    known = 1
                                    stop_cluster = 1
                                    spec_at = Add(i, one)
                                    IfCondition LessThan(spec_at, word_len) ThenBlock: {
                                        spec = CopySuffix(word, spec_at)
                                    } ElseBlock: {
                                        IfCondition GreaterEqual(pos, cmd_len) ThenBlock: {
                                            WriteStderr("env: option requires an argument -- 'S'\n")
                                            UsageError()
                                        }
                                        spec = CopyArg(cmd, pos)
                                        pos = NextEntry(cmd, pos, cmd_len)
                                    }
                                    splits = Add(splits, one)
                                    IfCondition GreaterThan(splits, 32) ThenBlock: {
                                        WriteStderr("env: too many -S options\n")
                                        UsageError()
                                    }
                                    newcmd = TakeSplit(cmd, cmd_len, pos, spec, len_box)
                                    IfCondition EqualTo(newcmd, 0) ThenBlock: {
                                        SystemCall(60, 125)
                                    }
                                    cmd = newcmd
                                    cmd_len = LoadInt(len_box)
                                    pos = NextEntry(cmd, 0, cmd_len)
                                }
                                IfCondition EqualTo(known, 0) ThenBlock: {
                                    WriteStderr("env: invalid option\n")
                                    UsageError()
                                }
                                i = Add(i, 1)
                                IfCondition EqualTo(stop_cluster, 1) ThenBlock: {
                                    i = word_len
                                }
                            }
                        }
                        Deallocate(word, Add(word_len, 1))
                    }
                }
            }
        }
    }

    IfCondition EqualTo(opt_done, 0) ThenBlock: {
        assign_pos = pos
    }

    cursor = assign_pos
    IfCondition LessThan(cursor, cmd_len) ThenBlock: {
        dash = CopyArg(cmd, cursor)
        is_dash = StringEquals(dash, "-")
        Deallocate(dash, 0)
        IfCondition EqualTo(is_dash, 1) ThenBlock: {
            ignore = 1
            cursor = NextEntry(cmd, cursor, cmd_len)
        }
    }

    cmd_pos = cursor
    WhileLoop LessThan(cursor, cmd_len) {
        arg = Add(cmd, cursor)
        has_eq = ContainsByte(arg, 61)
        IfCondition EqualTo(has_eq, 0) ThenBlock: {
            cursor = cmd_len
        } ElseBlock: {
            cmd_pos = NextEntry(cmd, cursor, cmd_len)
            cursor = cmd_pos
        }
    }

    have_cmd = 0
    IfCondition LessThan(cmd_pos, cmd_len) ThenBlock: {
        have_cmd = 1
    }

    env_cap = 262144
    env = Allocate(env_cap)
    env_len = 0
    IfCondition EqualTo(ignore, 0) ThenBlock: {
        env_len = ReadEnviron(env, env_cap)
        ui = 0
        WhileLoop LessThan(ui, unset_count) {
            unset_name = ArrayGet(unsets, ui)
            bad = BadUnsetName(unset_name)
            IfCondition EqualTo(bad, 1) ThenBlock: {
                WriteStderr("env: cannot unset '")
                WriteStderr(unset_name)
                WriteStderr("'\n")
                SystemCall(60, 125)
            }
            env_len = EnvRemove(env, env_len, unset_name, 0)
            ui = Add(ui, 1)
        }
    }

    cursor = assign_pos
    IfCondition LessThan(cursor, cmd_len) ThenBlock: {
        dash = CopyArg(cmd, cursor)
        is_dash = StringEquals(dash, "-")
        Deallocate(dash, 0)
        IfCondition EqualTo(is_dash, 1) ThenBlock: {
            cursor = NextEntry(cmd, cursor, cmd_len)
        }
    }
    WhileLoop LessThan(cursor, cmd_pos) {
        assignment = Add(cmd, cursor)
        env_len = EnvSet(env, env_len, assignment, env_cap)
        IfCondition LessThan(env_len, 0) ThenBlock: {
            WriteStderr("env: cannot set variable\n")
            SystemCall(60, 125)
        }
        cursor = NextEntry(cmd, cursor, cmd_len)
    }

    IfCondition EqualTo(have_cmd, 0) ThenBlock: {
        IfCondition NotEqual(newdir, 0) ThenBlock: {
            WriteStderr("env: must specify command with --chdir (-C)\n")
            WriteStderr("Try 'env --help' for more information.\n")
            SystemCall(60, 125)
        }
        PrintEnv(env, env_len, nul_out)
        SystemCall(60, 0)
    }

    IfCondition EqualTo(nul_out, 1) ThenBlock: {
        WriteStderr("env: cannot specify --null (-0) with command\n")
        UsageError()
    }

    SgApply(modes)
    IfCondition EqualTo(mask_changed, 1) ThenBlock: {
        SgInstall(block, unblock)
    }
    IfCondition EqualTo(list_on, 1) ThenBlock: {
        SgList()
    }

    IfCondition NotEqual(newdir, 0) ThenBlock: {
        chdir_result = SystemCall(80, newdir)
        IfCondition LessThan(chdir_result, 0) ThenBlock: {
            WriteStderr("env: cannot change directory to '")
            WriteStderr(newdir)
            WriteStderr("'\n")
            SystemCall(60, 125)
        }
    }

    argv = BuildPointerArray(cmd, cmd_pos, cmd_len)
    envp = BuildPointerArray(env, 0, env_len)
    path_value = ExtractPath(env, env_len)
    command = Add(cmd, cmd_pos)
    ExecCommand(command, argv, envp, path_value)
}

RunTask(Main)
