// fold.ailang - Wrap lines to specified width
// Usage: fold [-w WIDTH] [file]
// Default width: 80

LibraryImport.Arena

FixedPool.FoldConfig {
    "width": Initialize=80
    "spaces": Initialize=0
}

FixedPool.FoldConstants {
    "BUFFER_SIZE": Initialize=65536
    "OUT_SIZE": Initialize=262144
}

FixedPool.FoldOut {
    "buf": Initialize=0
    "pos": Initialize=0
    "column": Initialize=0
}

Function.WriteStdout {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 1, buffer, len)
    }
}

Function.FoldFlush {
    Body: {
        IfCondition GreaterThan(FoldOut.pos, 0) ThenBlock: {
            WriteStdout(FoldOut.buf, FoldOut.pos)
            FoldOut.pos = 0
        }
    }
}

Function.FoldByte {
    Input: ch: Integer
    Body: {
        IfCondition GreaterEqual(FoldOut.pos, FoldConstants.OUT_SIZE) ThenBlock: {
            FoldFlush()
        }
        SetByte(FoldOut.buf, FoldOut.pos, ch)
        FoldOut.pos = Add(FoldOut.pos, 1)
    }
}

Function.AdjustCol {
    Input: column: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ch, 8) ThenBlock: {
            IfCondition GreaterThan(column, 0) ThenBlock: {
                ReturnValue(Subtract(column, 1))
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(ch, 13) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(ch, 9) ThenBlock: {
            span = Subtract(8, Modulo(column, 8))
            ReturnValue(Add(column, span))
        }
        ReturnValue(Add(column, 1))
    }
}

Function.Recompute {
    Body: {
        column = 0
        i = 0
        WhileLoop LessThan(i, FoldOut.pos) {
            column = AdjustCol(column, GetByte(FoldOut.buf, i))
            i = Add(i, 1)
        }
        FoldOut.column = column
        ReturnValue(0)
    }
}

// Buffer the current line so -s can break after the last blank.
Function.ProcessFold {
    Input: fd: Integer
    Body: {
        buffer = Allocate(FoldConstants.BUFFER_SIZE)
        FoldOut.buf = Allocate(FoldConstants.OUT_SIZE)
        FoldOut.pos = 0
        FoldOut.column = 0

        WhileLoop 1 {
            bytes_read = SystemCall(0, fd, buffer, FoldConstants.BUFFER_SIZE)
            IfCondition LessEqual(bytes_read, 0) ThenBlock: { BreakLoop }

            i = 0
            WhileLoop LessThan(i, bytes_read) {
                ch = GetByte(buffer, i)
                IfCondition EqualTo(ch, 10) ThenBlock: {
                    FoldByte(10)
                    FoldFlush()
                    FoldOut.column = 0
                } ElseBlock: {
                    done = 0
                    WhileLoop EqualTo(done, 0) {
                        next_col = AdjustCol(FoldOut.column, ch)
                        IfCondition GreaterThan(next_col, FoldConfig.width) ThenBlock: {
                            broke = 0
                            IfCondition EqualTo(FoldConfig.spaces, 1) ThenBlock: {
                                end = FoldOut.pos
                                found = 0
                                WhileLoop GreaterThan(end, 0) {
                                    end = Subtract(end, 1)
                                    b = GetByte(FoldOut.buf, end)
                                    IfCondition Or(EqualTo(b, 32), EqualTo(b, 9)) ThenBlock: {
                                        found = 1
                                        BreakLoop
                                    }
                                }
                                IfCondition EqualTo(found, 1) ThenBlock: {
                                    cut = Add(end, 1)
                                    WriteStdout(FoldOut.buf, cut)
                                    WriteStdout("\n", 1)
                                    rest = Subtract(FoldOut.pos, cut)
                                    j = 0
                                    WhileLoop LessThan(j, rest) {
                                        SetByte(FoldOut.buf, j, GetByte(FoldOut.buf, Add(cut, j)))
                                        j = Add(j, 1)
                                    }
                                    FoldOut.pos = rest
                                    Recompute()
                                    broke = 1
                                }
                            }
                            IfCondition EqualTo(broke, 0) ThenBlock: {
                                IfCondition EqualTo(FoldOut.pos, 0) ThenBlock: {
                                    FoldByte(ch)
                                    FoldOut.column = next_col
                                    done = 1
                                } ElseBlock: {
                                    FoldByte(10)
                                    FoldFlush()
                                    FoldOut.column = 0
                                    FoldOut.pos = 0
                                }
                            }
                        } ElseBlock: {
                            FoldByte(ch)
                            FoldOut.column = next_col
                            done = 1
                        }
                    }
                }
                i = Add(i, 1)
            }
        }

        FoldFlush()
        Deallocate(FoldOut.buf, FoldConstants.OUT_SIZE)
        Deallocate(buffer, FoldConstants.BUFFER_SIZE)
    }
}

Function.StringToInt {
    Input: str: Address
    Output: Integer
    Body: {
        result = 0
        i = 0
        
        WhileLoop 1 {
            ch = GetByte(str, i)
            IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                ReturnValue(result)
            }
            digit = Subtract(ch, 48)
            result = Add(Multiply(result, 10), digit)
            i = Add(i, 1)
        }
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        ReturnValue(buffer)
    }
}

SubRoutine.Main {
    args_buffer = GetArgs()
    
    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        ProcessFold(0)
        SystemCall(60, 0)
    }
    
    // Skip program name
    pos = 0
    WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)
    
    filename = 0
    
    // Parse arguments
    WhileLoop LessThan(pos, 4096) {
        ch = GetByte(args_buffer, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            BreakLoop
        }
        
        // Check for -w flag or -N shorthand (GNU: `fold -20` = width 20)
        first = GetByte(args_buffer, pos)
        IfCondition EqualTo(first, 45) ThenBlock: {
            second = GetByte(args_buffer, Add(pos, 1))

            // GNU shorthand: -N (digit immediately after dash) = width
            IfCondition And(GreaterEqual(second, 48), LessEqual(second, 57)) ThenBlock: {
                FoldConfig.width = StringToInt(Add(args_buffer, Add(pos, 1)))
                WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
                    pos = Add(pos, 1)
                }
                pos = Add(pos, 1)
                ContinueLoop
            }

            IfCondition EqualTo(second, 115) ThenBlock: {
                FoldConfig.spaces = 1
                WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
                    pos = Add(pos, 1)
                }
                pos = Add(pos, 1)
                ContinueLoop
            }

            IfCondition EqualTo(second, 119) ThenBlock: {
                third = GetByte(args_buffer, Add(pos, 2))
                IfCondition And(GreaterEqual(third, 48), LessEqual(third, 57)) ThenBlock: {
                    FoldConfig.width = StringToInt(Add(args_buffer, Add(pos, 2)))
                    WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
                        pos = Add(pos, 1)
                    }
                    pos = Add(pos, 1)
                } ElseBlock: {
                    WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
                        pos = Add(pos, 1)
                    }
                    pos = Add(pos, 1)
                    FoldConfig.width = StringToInt(Add(args_buffer, pos))
                    WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
                        pos = Add(pos, 1)
                    }
                    pos = Add(pos, 1)
                }
                ContinueLoop
            }
        }
        
        // It's a filename
        file_start = pos
        file_len = 0
        
        WhileLoop And(LessThan(pos, 4096), NotEqual(GetByte(args_buffer, pos), 0)) {
            file_len = Add(file_len, 1)
            pos = Add(pos, 1)
        }
        
        filename = Allocate(Add(file_len, 1))
        i = 0
        WhileLoop LessThan(i, file_len) {
            ch = GetByte(args_buffer, Add(file_start, i))
            SetByte(filename, i, ch)
            i = Add(i, 1)
        }
        SetByte(filename, file_len, 0)
        
        pos = Add(pos, 1)
    }
    
    Deallocate(args_buffer, 4096)
    
    IfCondition EqualTo(filename, 0) ThenBlock: {
        ProcessFold(0)
    } ElseBlock: {
        fd = SystemCall(2, filename, 0, 0)
        
        IfCondition LessThan(fd, 0) ThenBlock: {
            SystemCall(60, 1)
        }
        
        ProcessFold(fd)
        SystemCall(3, fd)
        Deallocate(filename, 0)
    }
    
    SystemCall(60, 0)
}

RunTask(Main)