            StoreValue(Add(UnicodeData.fold_starts, 5592), 68944)
            StoreValue(Add(UnicodeData.fold_ends,   5592), 68965)
            StoreValue(Add(UnicodeData.fold_deltas, 5592), 32)
            StoreValue(Add(UnicodeData.fold_starts, 5600), 71840)
            StoreValue(Add(UnicodeData.fold_ends,   5600), 71871)
            StoreValue(Add(UnicodeData.fold_deltas, 5600), 32)
            StoreValue(Add(UnicodeData.fold_starts, 5608), 93760)
            StoreValue(Add(UnicodeData.fold_ends,   5608), 93791)
            StoreValue(Add(UnicodeData.fold_deltas, 5608), 32)
            StoreValue(Add(UnicodeData.fold_starts, 5616), 93856)
            StoreValue(Add(UnicodeData.fold_ends,   5616), 93880)
            StoreValue(Add(UnicodeData.fold_deltas, 5616), 27)
            StoreValue(Add(UnicodeData.fold_starts, 5624), 122688)
            StoreValue(Add(UnicodeData.fold_ends,   5624), 122688)
            StoreValue(Add(UnicodeData.fold_deltas, 5624), 1)
            StoreValue(Add(UnicodeData.fold_starts, 5632), 122696)
            StoreValue(Add(UnicodeData.fold_ends,   5632), 122696)
            StoreValue(Add(UnicodeData.fold_deltas, 5632), 1)
            StoreValue(Add(UnicodeData.fold_starts, 5640), 122698)
            StoreValue(Add(UnicodeData.fold_ends,   5640), 122698)
            StoreValue(Add(UnicodeData.fold_deltas, 5640), 1)
            StoreValue(Add(UnicodeData.fold_starts, 5648), 122701)
            StoreValue(Add(UnicodeData.fold_ends,   5648), 122701)
            StoreValue(Add(UnicodeData.fold_deltas, 5648), 1)
            StoreValue(Add(UnicodeData.fold_starts, 5656), 122705)
            StoreValue(Add(UnicodeData.fold_ends,   5656), 122705)
            StoreValue(Add(UnicodeData.fold_deltas, 5656), 1)
            StoreValue(Add(UnicodeData.fold_starts, 5664), 122728)
            StoreValue(Add(UnicodeData.fold_ends,   5664), 122728)
            StoreValue(Add(UnicodeData.fold_deltas, 5664), 1)
            StoreValue(Add(UnicodeData.fold_starts, 5672), 122730)
            StoreValue(Add(UnicodeData.fold_ends,   5672), 122730)
            StoreValue(Add(UnicodeData.fold_deltas, 5672), 1)
            StoreValue(Add(UnicodeData.fold_starts, 5680), 122732)
            StoreValue(Add(UnicodeData.fold_ends,   5680), 122732)
            StoreValue(Add(UnicodeData.fold_deltas, 5680), 1)
            StoreValue(Add(UnicodeData.fold_starts, 5688), 122734)
            StoreValue(Add(UnicodeData.fold_ends,   5688), 122734)
            StoreValue(Add(UnicodeData.fold_deltas, 5688), 1)
            StoreValue(Add(UnicodeData.fold_starts, 5696), 122738)
            StoreValue(Add(UnicodeData.fold_ends,   5696), 122738)
            StoreValue(Add(UnicodeData.fold_deltas, 5696), 1)
            StoreValue(Add(UnicodeData.fold_starts, 5704), 122740)
            StoreValue(Add(UnicodeData.fold_ends,   5704), 122740)
            StoreValue(Add(UnicodeData.fold_deltas, 5704), 1)
            StoreValue(Add(UnicodeData.fold_starts, 5712), 122742)
            StoreValue(Add(UnicodeData.fold_ends,   5712), 122742)
            StoreValue(Add(UnicodeData.fold_deltas, 5712), 1)
            StoreValue(Add(UnicodeData.fold_starts, 5720), 122744)
            StoreValue(Add(UnicodeData.fold_ends,   5720), 122744)
            StoreValue(Add(UnicodeData.fold_deltas, 5720), 1)
            StoreValue(Add(UnicodeData.fold_starts, 5728), 122746)
            StoreValue(Add(UnicodeData.fold_ends,   5728), 122746)
            StoreValue(Add(UnicodeData.fold_deltas, 5728), 1)
            StoreValue(Add(UnicodeData.fold_starts, 5736), 122748)
            StoreValue(Add(UnicodeData.fold_ends,   5736), 122748)
            StoreValue(Add(UnicodeData.fold_deltas, 5736), 1)
            StoreValue(Add(UnicodeData.fold_starts, 5744), 122750)
            StoreValue(Add(UnicodeData.fold_ends,   5744), 122750)
            StoreValue(Add(UnicodeData.fold_deltas, 5744), 1)
            StoreValue(Add(UnicodeData.fold_starts, 5752), 122773)
            StoreValue(Add(UnicodeData.fold_ends,   5752), 122773)
            StoreValue(Add(UnicodeData.fold_deltas, 5752), -122550)
            StoreValue(Add(UnicodeData.fold_starts, 5760), 125184)
            StoreValue(Add(UnicodeData.fold_ends,   5760), 125217)
            StoreValue(Add(UnicodeData.fold_deltas, 5760), 34)

            UnicodeData.ready = 1
        }
    }
}

// Binary search: is codepoint cp a word character?
// Returns 1 if yes, 0 if no.
Function.UnicodeIsWord {
    Input: cp: Integer
    Output: Integer
    Body: {
        lo = 0
        hi = Subtract(UnicodeData.word_count, 1)
        WhileLoop LessEqual(lo, hi) {
            mid = Divide(Add(lo, hi), 2)
            ms = Dereference(Add(UnicodeData.word_starts, Multiply(mid, 8)))
            me = Dereference(Add(UnicodeData.word_ends,   Multiply(mid, 8)))
            IfCondition LessThan(cp, ms) ThenBlock: {
                hi = Subtract(mid, 1)
            } ElseBlock: {
                IfCondition GreaterThan(cp, me) ThenBlock: {
                    lo = Add(mid, 1)
                } ElseBlock: {
                    ReturnValue(1)
                }
            }
        }
        ReturnValue(0)
    }
}

// Simple case fold: returns the folded codepoint.
// If cp has no fold mapping, returns cp unchanged.
Function.UnicodeFold {
    Input: cp: Integer
    Output: Integer
    Body: {
        lo = 0
        hi = Subtract(UnicodeData.fold_count, 1)
        WhileLoop LessEqual(lo, hi) {
            mid = Divide(Add(lo, hi), 2)
            ms = Dereference(Add(UnicodeData.fold_starts, Multiply(mid, 8)))
            me = Dereference(Add(UnicodeData.fold_ends,   Multiply(mid, 8)))
            IfCondition LessThan(cp, ms) ThenBlock: {
                hi = Subtract(mid, 1)
            } ElseBlock: {
                IfCondition GreaterThan(cp, me) ThenBlock: {
                    lo = Add(mid, 1)
                } ElseBlock: {
                    md = Dereference(Add(UnicodeData.fold_deltas, Multiply(mid, 8)))
                    ReturnValue(Add(cp, md))
                }
            }
        }
        ReturnValue(cp)
    }
}

// Decode one UTF-8 character from buf at offset pos.
// Returns the codepoint. Sets consumed bytes via the
// second output. Invalid sequences return 0xFFFD and
// consume 1 byte.
Function.UTF8Decode {
    Input: buf: Address
    Input: pos: Integer
    Input: len: Integer
    Input: out_advance: Address
    Output: Integer
    Body: {
        b0 = GetByte(buf, pos)
        IfCondition LessThan(b0, 128) ThenBlock: {
            StoreValue(out_advance, 1)
            ReturnValue(b0)
        }
        IfCondition LessThan(b0, 194) ThenBlock: {
            StoreValue(out_advance, 1)
            ReturnValue(65533)
        }
        IfCondition LessThan(b0, 224) ThenBlock: {
            IfCondition LessThan(Subtract(len, pos), 2) ThenBlock: {
                StoreValue(out_advance, 1)
                ReturnValue(65533)
            }
            b1 = GetByte(buf, Add(pos, 1))
            IfCondition Or(LessThan(b1, 128), GreaterEqual(b1, 192)) ThenBlock: {
                StoreValue(out_advance, 1)
                ReturnValue(65533)
            }
            cp = Add(Multiply(BitwiseAnd(b0, 31), 64), BitwiseAnd(b1, 63))
            StoreValue(out_advance, 2)
            ReturnValue(cp)
        }
        IfCondition LessThan(b0, 240) ThenBlock: {
            IfCondition LessThan(Subtract(len, pos), 3) ThenBlock: {
                StoreValue(out_advance, 1)
                ReturnValue(65533)
            }
            b1 = GetByte(buf, Add(pos, 1))
            b2 = GetByte(buf, Add(pos, 2))
            IfCondition Or(LessThan(b1, 128), GreaterEqual(b1, 192)) ThenBlock: {
                StoreValue(out_advance, 1)
                ReturnValue(65533)
            }
            IfCondition Or(LessThan(b2, 128), GreaterEqual(b2, 192)) ThenBlock: {
                StoreValue(out_advance, 1)
                ReturnValue(65533)
            }
            cp = Add(Add(Multiply(BitwiseAnd(b0, 15), 4096), Multiply(BitwiseAnd(b1, 63), 64)), BitwiseAnd(b2, 63))
            IfCondition LessThan(cp, 2048) ThenBlock: {
                StoreValue(out_advance, 1)
                ReturnValue(65533)
            }
            StoreValue(out_advance, 3)
            ReturnValue(cp)
        }
        IfCondition LessThan(b0, 245) ThenBlock: {
            IfCondition LessThan(Subtract(len, pos), 4) ThenBlock: {
                StoreValue(out_advance, 1)
                ReturnValue(65533)
            }
            b1 = GetByte(buf, Add(pos, 1))
            b2 = GetByte(buf, Add(pos, 2))
            b3 = GetByte(buf, Add(pos, 3))
            IfCondition Or(LessThan(b1, 128), GreaterEqual(b1, 192)) ThenBlock: {
                StoreValue(out_advance, 1)
                ReturnValue(65533)
            }
            IfCondition Or(LessThan(b2, 128), GreaterEqual(b2, 192)) ThenBlock: {
                StoreValue(out_advance, 1)
                ReturnValue(65533)
            }
            IfCondition Or(LessThan(b3, 128), GreaterEqual(b3, 192)) ThenBlock: {
                StoreValue(out_advance, 1)
                ReturnValue(65533)
            }
            cp = Add(Add(Add(Multiply(BitwiseAnd(b0, 7), 262144), Multiply(BitwiseAnd(b1, 63), 4096)), Multiply(BitwiseAnd(b2, 63), 64)), BitwiseAnd(b3, 63))
            IfCondition Or(LessThan(cp, 65536), GreaterThan(cp, 1114111)) ThenBlock: {
                StoreValue(out_advance, 1)
                ReturnValue(65533)
            }
            StoreValue(out_advance, 4)
            ReturnValue(cp)
        }
        StoreValue(out_advance, 1)
        ReturnValue(65533)
    }
}

// Encode one codepoint as UTF-8 into buf at offset pos.
// Returns the number of bytes written (1-4).
Function.UTF8Encode {
    Input: buf: Address
    Input: pos: Integer
    Input: cp: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(cp, 128) ThenBlock: {
            SetByte(buf, pos, cp)
            ReturnValue(1)
        }
        IfCondition LessThan(cp, 2048) ThenBlock: {
            SetByte(buf, pos, Add(192, Divide(cp, 64)))
            SetByte(buf, Add(pos, 1), Add(128, BitwiseAnd(cp, 63)))
            ReturnValue(2)
        }
        IfCondition LessThan(cp, 65536) ThenBlock: {
            SetByte(buf, pos, Add(224, Divide(cp, 4096)))
            SetByte(buf, Add(pos, 1), Add(128, BitwiseAnd(Divide(cp, 64), 63)))
            SetByte(buf, Add(pos, 2), Add(128, BitwiseAnd(cp, 63)))
            ReturnValue(3)
        }
        SetByte(buf, pos, Add(240, Divide(cp, 262144)))
        SetByte(buf, Add(pos, 1), Add(128, BitwiseAnd(Divide(cp, 4096), 63)))
        SetByte(buf, Add(pos, 2), Add(128, BitwiseAnd(Divide(cp, 64), 63)))
        SetByte(buf, Add(pos, 3), Add(128, BitwiseAnd(cp, 63)))
        ReturnValue(4)
    }
}

// Fold a string in-place using Unicode simple case fold.
// ASCII bytes use ToLowerByte; multibyte codepoints use UnicodeFold.
// When a fold changes UTF-8 byte length (rare, ~41 codepoints), the
// original bytes are kept so the output is always src_len bytes.
// Fold one multibyte codepoint from src[si..] into dst[si..].
// Preserves byte length: if fold changes length, keeps original.
// Returns number of bytes consumed.
Function.FoldOneMB {
    Input: dst: Address
    Input: src: Address
    Input: si: Integer
    Input: src_len: Integer
    Output: Integer
    Body: {
        fb = GetByte(src, si)
        IfCondition LessThan(fb, 128) ThenBlock: {
            SetByte(dst, si, ToLowerByte(fb))
            ReturnValue(1)
        }
        _fadvbuf = Allocate(8)
        mcp = UTF8Decode(src, si, src_len, _fadvbuf)
        madv = Dereference(_fadvbuf)
        Deallocate(_fadvbuf, 8)
        mfcp = UnicodeFold(mcp)
        mfbl = UTF8Encode(dst, si, mfcp)
        IfCondition NotEqual(mfbl, madv) ThenBlock: {
            mk = 0
            WhileLoop LessThan(mk, madv) {
                SetByte(dst, Add(si, mk), GetByte(src, Add(si, mk)))
                mk = Add(mk, 1)
            }
        }
        ReturnValue(madv)
    }
}

Function.UnicodeFoldStr {
    Input: src: Address
    Input: src_len: Integer
    Output: Address
    Body: {
        dst = Allocate(Add(src_len, 1))
        si = 0
        WhileLoop LessThan(si, src_len) {
            fadv = FoldOneMB(dst, src, si, src_len)
            si = Add(si, fadv)
        }
        SetByte(dst, src_len, 0)
        ReturnValue(dst)
    }
}

// Codepoint-level case-insensitive comparison.
// Compares plen bytes of pat_lc (already folded) against data[pos..].
// ASCII bytes use the lc_tab LUT; bytes >= 128 decode codepoints and
// fold via UnicodeFold. Returns 1 if equal, 0 if not.
Function.IcaseCmpUnicode {
    Input: data: Address
    Input: pos: Integer
    Input: data_len: Integer
    Input: pat_lc: Address
    Input: plen: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(Add(pos, plen), data_len) ThenBlock: { ReturnValue(0) }
        _icadv = Allocate(8)
        di = pos
        pi = 0
        ic_ok = 1
        WhileLoop And(LessThan(pi, plen), EqualTo(ic_ok, 1)) {
            db = GetByte(data, di)
            IfCondition LessThan(db, 128) ThenBlock: {
                IfCondition NotEqual(ToLowerByte(db), GetByte(pat_lc, pi)) ThenBlock: {
                    ic_ok = 0
                } ElseBlock: {
                    di = Add(di, 1)
                    pi = Add(pi, 1)
                }
            } ElseBlock: {
                dcp = UTF8Decode(data, di, data_len, _icadv)
                dadv = Dereference(_icadv)
                pcp = UTF8Decode(pat_lc, pi, plen, _icadv)
                padv = Dereference(_icadv)
                IfCondition NotEqual(UnicodeFold(dcp), pcp) ThenBlock: {
                    ic_ok = 0
                } ElseBlock: {
                    IfCondition NotEqual(dadv, padv) ThenBlock: {
                        ic_ok = 0
                    } ElseBlock: {
                        di = Add(di, dadv)
                        pi = Add(pi, padv)
                    }
                }
            }
        }
        Deallocate(_icadv, 8)
        IfCondition EqualTo(ic_ok, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// === CASE / MATCH HELPERS ===


Function.ToLowerByte {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(c, 65), LessEqual(c, 90)) ThenBlock: {
            ReturnValue(Add(c, 32))
        }
        ReturnValue(c)
    }
}

// English only, same as GNU grep in the C locale. Word bytes are
// digits, letters, and underscore. -i folds A-Z only. Bytes >= 0x80
// are not word bytes and are not case-folded. AILANG does not read
// the locale.
Function.IsWordChar {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(c, 65), LessEqual(c, 90)) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(c, 97), LessEqual(c, 122)) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 95) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Word boundary check for -w. At a match boundary, test whether the
// neighbor is a word character. ASCII bytes use the fast IsWordChar;
// bytes >= 0x80 decode UTF-8 and query UnicodeIsWord (binary search).
Function.WordEdgesOk {
    Input: data: Address
    Input: pos: Integer
    Input: plen: Integer
    Input: len: Integer
    Output: Integer
    Body: {
        left_ok = 0
        IfCondition EqualTo(pos, 0) ThenBlock: { left_ok = 1 }
        IfCondition EqualTo(left_ok, 0) ThenBlock: {
            lb = GetByte(data, Subtract(pos, 1))
            IfCondition LessThan(lb, 128) ThenBlock: {
                IfCondition EqualTo(IsWordChar(lb), 0) ThenBlock: {
                    left_ok = 1
                }
            } ElseBlock: {
                lstart = Subtract(pos, 1)
                WhileLoop And(GreaterThan(lstart, 0),
                              And(GreaterEqual(GetByte(data, lstart), 128),
                                  LessThan(GetByte(data, lstart), 192))) {
                    lstart = Subtract(lstart, 1)
                }
                lcp = UTF8Decode(data, lstart, len, AddressOf(UnicodeData.we_adv))
                IfCondition EqualTo(UnicodeIsWord(lcp), 0) ThenBlock: {
                    left_ok = 1
                }
            }
        }
        IfCondition EqualTo(left_ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        end_pos = Add(pos, plen)
        IfCondition GreaterEqual(end_pos, len) ThenBlock: {
            ReturnValue(1)
        }
        rb = GetByte(data, end_pos)
        IfCondition LessThan(rb, 128) ThenBlock: {
            IfCondition EqualTo(IsWordChar(rb), 0) ThenBlock: {
                ReturnValue(1)
            }
        } ElseBlock: {
            rcp = UTF8Decode(data, end_pos, len, AddressOf(UnicodeData.we_adv))
            IfCondition EqualTo(UnicodeIsWord(rcp), 0) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

// Case-insensitive compare: data[pos..pos+plen) vs pat_lc (already lowered).
// Uses lc_tab LUT. Returns 1 if equal, 0 if not.
Function.IcaseCmpAt {
    Input: data: Address
    Input: pos: Integer
    Input: pat_lc: Address
    Input: plen: Integer
    Output: Integer
    Body: {
        lut = Scratch.lc_tab
        ci = 0
        WhileLoop LessThan(ci, plen) {
            IfCondition NotEqual(GetByte(lut, GetByte(data, Add(pos, ci))),
                                 GetByte(pat_lc, ci)) ThenBlock: {
                ReturnValue(0)
            }
            ci = Add(ci, 1)
        }
        ReturnValue(1)
    }
}

// BuildBadCharTable removed: SearchBoyerMoore uses MemChr-anchored
// first-byte scan, not BM skip tables. The tables were allocated and
// initialized but never consulted.

// Substring search: MemChr-anchored on the pattern's FIRST byte, then
// MemCompare to verify. Both primitives are SSE2-vectorized in the
// AILang compiler, so the outer scan runs at ~2-4 GB/s instead of
// BM's 1-byte-per-position outer loop.
//
// Why FIRST byte (not last): in typical text/code, pattern starts are
// distinctive (uppercase letters, special chars) while ends are often
// common letters (vowels, 'n', 't', 's'). Anchoring on the rarer byte
// makes MemChr skip through non-matching regions in ~16-byte strides
// and minimizes MemCompare verify calls. An earlier last-byte variant
// regressed 10-40% on patterns like "Function" because 'n' triggered
// a verify at every 'n' in the text.
//
Function.SearchBoyerMoore {
    Input: line: Address
    Input: line_len: Integer
    Input: pat: Address
    Input: plen: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(plen, line_len) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(plen, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(MemMem(line, line_len, pat, plen))
    }
}

// Compare up to plen bytes of pat against line[pos..]. Honors -i.
// Returns 1 if equal, else 0.
Function.CompareAt {
    Input: line: Address
    Input: line_len: Integer
    Input: pos: Integer
    Input: pat: Address
    Input: pat_lc: Address
    Input: plen: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(Add(pos, plen), line_len) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GrepConfig.case_insensitive, 1) ThenBlock: {
            ci = 0
            WhileLoop LessThan(ci, plen) {
                cc = GetByte(line, Add(pos, ci))
                IfCondition GreaterEqual(cc, 128) ThenBlock: {
                    ReturnValue(IcaseCmpUnicode(line, pos, line_len, pat_lc, plen))
                }
                IfCondition NotEqual(ToLowerByte(cc), GetByte(pat_lc, ci)) ThenBlock: { ReturnValue(0) }
                ci = Add(ci, 1)
            }
            ReturnValue(1)
        }
        // Case-sensitive: SIMD-accelerated block compare.
        IfCondition EqualTo(MemCompare(Add(line, pos), pat, plen), 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Run the compiled regex handle against scratch[0..line_len].
// Caller guarantees scratch is NUL-terminated at line_len and contains
// the already-case-adjusted bytes (lowercased when -i is set).
//
// Performance note: the original version Allocate'd + Deallocate'd a
// scratch buffer per line. On a 100k-line file × 1000 iterations that
// churned Arena 100M times and pushed RSS over 6 GB. The reusable-
// scratch variant moves the allocation out to ProcessStream where it
// lives for the whole file scan.
Function.RegexLineSearch {
    Input: handle: Address
    Input: scratch: Address
    Input: line_len: Integer
    Input: prefix: Address
    Input: prefix_len: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(handle, 0) ThenBlock: { ReturnValue(0) }

        // Fast path: if the regex has a usable literal prefix (≥2 bytes),
        // Boyer-Moore skip to candidate positions and only run Regex_Match
        // where the prefix hits. Patterns like "Function\..*" were chewing
        // every byte position through the NFA; now we skip most of them.
        IfCondition GreaterEqual(prefix_len, 2) ThenBlock: {
            search_from = 0
            WhileLoop LessEqual(search_from, Subtract(line_len, prefix_len)) {
                found = SearchBoyerMoore(Add(scratch, search_from),
                                         Subtract(line_len, search_from),
                                         prefix, prefix_len)
                IfCondition LessThan(found, 0) ThenBlock: { BreakLoop }
                cand = Add(search_from, found)
                m = Regex_Match(handle, scratch, cand)
                IfCondition GreaterEqual(m, 0) ThenBlock: { ReturnValue(1) }
                search_from = Add(cand, 1)
            }
            ReturnValue(0)
        }

        // No-prefix path — three tiers in order of speed:
        //   1. Lazy DFA: single pattern + no ^/$ anchors. O(1) table
        //      lookup per byte. Returns -1 on DFA state overflow, in
        //      which case we fall through to the NFA.
        //   2. Regex_Search: single-pass unanchored NFA.
        // Multi-pattern grep or patterns with assertions skip straight
        // to Regex_Search (dfa_ok == 0).
        IfCondition EqualTo(Patterns.dfa_ok, 1) ThenBlock: {
            d = Regex_DFASearch(scratch, line_len)
            // DFASearch: 1 = match, 0 = no match, -1 = overflow (fall through).
            IfCondition GreaterThan(d, 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(d, 0) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(Regex_Search(handle, scratch, line_len))
    }
}

// Per-pattern strategy bodies. Each returns 1 on match, 0 on no match.
// Kept as separate functions so LineMatches' Branch dispatch is a thin
// jump table — each case body is a single function call with inlined
// arg marshalling. Cleaner to audit, and the compiler's Branch fast
// path (69b40c94) emits 2 instructions per Case dispatch.

Function.Match_RegexPrefixBM {
    Input: line: Address
    Input: line_len: Integer
    Input: pi: Integer
    Output: Integer
    Body: {
        rhandle    = Dereference(Add(Patterns.regex,         Multiply(pi, 8)))
        rx_pfx     = Dereference(Add(Patterns.rx_prefix,     Multiply(pi, 8)))
        rx_pfx_len = Dereference(Add(Patterns.rx_prefix_len, Multiply(pi, 8)))
        IfCondition EqualTo(rhandle, 0) ThenBlock: { ReturnValue(0) }

        pbm_from = 0
        pbm_matched = 0
        WhileLoop LessEqual(pbm_from, Subtract(line_len, rx_pfx_len)) {
            hit = SearchBoyerMoore(Add(line, pbm_from),
                                   Subtract(line_len, pbm_from),
                                   rx_pfx, rx_pfx_len)
            IfCondition LessThan(hit, 0) ThenBlock: { BreakLoop }
            cand = Add(pbm_from, hit)
            // BM hit → materialize NUL-terminated scratch (Regex_Match reads via StringLength).
            IfCondition EqualTo(pbm_matched, 0) ThenBlock: {
                MemoryCopy(Scratch.rx, line, line_len)
                SetByte(Scratch.rx, line_len, 0)
                pbm_matched = 1
            }
            m = Regex_Match(rhandle, Scratch.rx, cand)
            IfCondition GreaterEqual(m, 0) ThenBlock: { ReturnValue(1) }
            pbm_from = Add(cand, 1)
        }
        ReturnValue(0)
    }
}

Function.Match_RegexDFA {
    Input: line: Address
    Input: line_len: Integer
    Input: pi: Integer
    Output: Integer
    Body: {
        d = Regex_DFASearch(line, line_len)
        // 1 = match, 0 = no match, -1 = DFA overflow → NFA for this pattern.
        IfCondition GreaterThan(d, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(d, 0) ThenBlock: { ReturnValue(0) }
        nfa = Match_RegexNFA(line, line_len, pi)
        ReturnValue(nfa)
    }
}

Function.Match_RegexNFA {
    Input: line: Address
    Input: line_len: Integer
    Input: pi: Integer
    Output: Integer
    Body: {
        rhandle = Dereference(Add(Patterns.regex, Multiply(pi, 8)))
        IfCondition EqualTo(rhandle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Regex_Search(rhandle, line, line_len))
    }
}

Function.Match_RegexInsensitive {
    Input: line: Address
    Input: line_len: Integer
    Input: pi: Integer
    Output: Integer
    Body: {
        rhandle    = Dereference(Add(Patterns.regex,         Multiply(pi, 8)))
        rx_pfx     = Dereference(Add(Patterns.rx_prefix,     Multiply(pi, 8)))
        rx_pfx_len = Dereference(Add(Patterns.rx_prefix_len, Multiply(pi, 8)))
        lut = Scratch.lc_tab
        si = 0
        WhileLoop LessThan(si, line_len) {
            rb = GetByte(line, si)
            IfCondition LessThan(rb, 128) ThenBlock: {
                SetByte(Scratch.rx_lc, si, GetByte(lut, rb))
                si = Add(si, 1)
            } ElseBlock: {
                fadv2 = FoldOneMB(Scratch.rx_lc, line, si, line_len)
                si = Add(si, fadv2)
            }
        }
        SetByte(Scratch.rx_lc, line_len, 0)
        IfCondition EqualTo(rhandle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(RegexLineSearch(rhandle, Scratch.rx_lc, line_len,
                                    rx_pfx, rx_pfx_len))
    }
}

Function.Match_LiteralBM {
    Input: line: Address
    Input: line_len: Integer
    Input: pi: Integer
    Output: Integer
    Body: {
        pat    = Dereference(Add(Patterns.ptrs, Multiply(pi, 8)))
        plen   = Dereference(Add(Patterns.lens, Multiply(pi, 8)))
        search_from = 0
        WhileLoop LessEqual(search_from, Subtract(line_len, plen)) {
            found = SearchBoyerMoore(Add(line, search_from),
                                     Subtract(line_len, search_from),
                                     pat, plen)
            IfCondition LessThan(found, 0) ThenBlock: { BreakLoop }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Lowercase via 256-byte LUT into Scratch.rx_lc, then SIMD search.
Function.Match_LiteralInsensitive {
    Input: line: Address
    Input: line_len: Integer
    Input: pi: Integer
    Output: Integer
    Body: {
        pat_lc = Dereference(Add(Patterns.lc_ptrs, Multiply(pi, 8)))
        plen   = Dereference(Add(Patterns.lens,    Multiply(pi, 8)))
        IfCondition GreaterEqual(MemMemFold(line, line_len, pat_lc, plen), 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Match_WholeLine {
    Input: line: Address
    Input: line_len: Integer
    Input: pi: Integer
    Output: Integer
    Body: {
        pat    = Dereference(Add(Patterns.ptrs,    Multiply(pi, 8)))
        pat_lc = Dereference(Add(Patterns.lc_ptrs, Multiply(pi, 8)))
        plen   = Dereference(Add(Patterns.lens,    Multiply(pi, 8)))
        IfCondition EqualTo(plen, line_len) ThenBlock: {
            ReturnValue(CompareAt(line, line_len, 0, pat, pat_lc, plen))
        }
        ReturnValue(0)
    }
}

Function.Match_WordMatch {
    Input: line: Address
    Input: line_len: Integer
    Input: pi: Integer
    Output: Integer
    Body: {
        pat    = Dereference(Add(Patterns.ptrs,    Multiply(pi, 8)))
        pat_lc = Dereference(Add(Patterns.lc_ptrs, Multiply(pi, 8)))
        plen   = Dereference(Add(Patterns.lens,    Multiply(pi, 8)))
        IfCondition EqualTo(plen, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(plen, line_len) ThenBlock: { ReturnValue(0) }
        pos = 0
        WhileLoop LessEqual(pos, Subtract(line_len, plen)) {
            remain = Subtract(line_len, pos)
            IfCondition EqualTo(GrepConfig.case_insensitive, 1) ThenBlock: {
                found = MemMemFold(Add(line, pos), remain, pat_lc, plen)
            } ElseBlock: {
                found = MemMem(Add(line, pos), remain, pat, plen)
            }
            IfCondition LessThan(found, 0) ThenBlock: { ReturnValue(0) }
            at = Add(pos, found)
            IfCondition EqualTo(WordEdgesOk(line, at, plen, line_len), 1) ThenBlock: {
                ReturnValue(1)
            }
            pos = Add(at, 1)
        }
        ReturnValue(0)
    }
}

// Tight literal-pattern scan used by ProcessStream's inline fast
// path. Returns 1 iff `pat[0..plen)` occurs anywhere in `line[0..line_len)`.
// Uses rare-byte anchored MemChr scan to minimize false positives.
Function.FastLiteralSearch {
    Input: line: Address
    Input: line_len: Integer
    Input: pat: Address
    Input: plen: Integer
    Output: Integer
    Body: {
        // Four arguments, not six. A six-parameter frame kept the needle
        // in a register MemMem reuses, so a miss on a pipe looked like a hit.
        IfCondition GreaterThan(plen, line_len) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(plen, 0) ThenBlock: { ReturnValue(0) }
        found = MemMem(line, line_len, pat, plen)
        IfCondition LessThan(found, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Returns 1 if `line` matches any pattern per current flags.
// Per-line dispatch cost: one indexed load of Patterns.strategy +
// one Branch (2-instruction CMP RAX,imm ; JE per case). All decision
// logic about whole_line/word_match/case_sensitive/regex/BM/DFA/NFA
// was resolved once at CompileAllPatterns time.
Function.LineMatches {
    Input: line: Address
    Input: line_len: Integer
    Output: Integer
    Body: {
        pcount = Patterns.count
        IfCondition LessEqual(pcount, 0) ThenBlock: { ReturnValue(0) }

        pi = 0
        WhileLoop LessThan(pi, pcount) {
            strat = Dereference(Add(Patterns.strategy, Multiply(pi, 8)))
            hit = 0
            Branch strat {
                Case 0: { hit = 1 }                                            // EMPTY
                Case 1: { hit = Match_WholeLine(line, line_len, pi) }          // WHOLE_LINE
                Case 2: { hit = Match_WordMatch(line, line_len, pi) }          // WORD_MATCH
                Case 3: { hit = Match_RegexPrefixBM(line, line_len, pi) }      // REGEX_PREFIX_BM
                Case 4: { hit = Match_RegexDFA(line, line_len, pi) }            // REGEX_DFA
                Case 5: { hit = Match_RegexNFA(line, line_len, pi) }           // REGEX_NFA
                Case 6: { hit = Match_RegexInsensitive(line, line_len, pi) }   // REGEX_INSENSITIVE
                Case 7: { hit = Match_LiteralBM(line, line_len, pi) }          // LITERAL_BM
                Case 8: { hit = Match_LiteralInsensitive(line, line_len, pi) } // LITERAL_INSENSITIVE
            }
            IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
            pi = Add(pi, 1)
        }
        ReturnValue(0)
    }
}

// === PATTERN MANAGEMENT ===

Function.InitPatterns {
    Body: {
        Patterns.ptrs          = Allocate(Multiply(GrepConstants.MAX_PATTERNS, 8))
        Patterns.lens          = Allocate(Multiply(GrepConstants.MAX_PATTERNS, 8))
        Patterns.lc_ptrs       = Allocate(Multiply(GrepConstants.MAX_PATTERNS, 8))
        Patterns.regex         = Allocate(Multiply(GrepConstants.MAX_PATTERNS, 8))
        Patterns.rx_prefix     = Allocate(Multiply(GrepConstants.MAX_PATTERNS, 8))
        Patterns.rx_prefix_len = Allocate(Multiply(GrepConstants.MAX_PATTERNS, 8))
        Patterns.strategy      = Allocate(Multiply(GrepConstants.MAX_PATTERNS, 8))
        Patterns.count   = 0
        Patterns.longest = 0
    }
}

// 1 when pat has no regex metacharacter, so it matches as a literal.
Function.PatternIsLiteral {
    Input: pat: Address
    Input: plen: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, plen) {
            c = GetByte(pat, i)
            IfCondition EqualTo(c, 46) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 42) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 43) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 63) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 94) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 36) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 91) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 93) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 40) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 41) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 124) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 92) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 123) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 125) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// 1 when c is a regex metacharacter. Newline is rejected by callers
// separately so a needle never spans a line.
Function.IsRegexMeta {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(c, 46) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 42) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 43) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 63) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 94) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 36) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 91) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 93) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 40) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 41) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 124) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 92) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 123) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 125) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 when pat[start..start+n) is free of metacharacters and newlines.
Function.SpanIsLiteral {
    Input: pat: Address
    Input: start: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, n) {
            c = GetByte(pat, Add(start, i))
            IfCondition EqualTo(IsRegexMeta(c), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 10) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Classify one regex so ProcessMapped can scan the mapping for a
// required literal instead of running the engine on every line.
// -v stays on the line walk: a hit scan does not produce the non-matching lines.
Function.ClassifyRegexFast {
    Output: Integer
    Body: {
        Patterns.fast_rx_ok = 0
        Patterns.fast_rx_mode = 0
        Patterns.fast_rx_end = 0
        Patterns.fast_rx_drive = 0
        Patterns.fast_rx_alt_n = 0
        Patterns.fast_rx_class_n = 0
        IfCondition NotEqual(Patterns.count, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GrepConfig.invert, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GrepConfig.whole_line, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GrepConfig.word_match, 1) ThenBlock: { ReturnValue(0) }

        strat = Dereference(Patterns.strategy)
        is_rx = 0
        IfCondition EqualTo(strat, STRATEGY.REGEX_PREFIX_BM) ThenBlock: { is_rx = 1 }
        IfCondition EqualTo(strat, STRATEGY.REGEX_DFA) ThenBlock: { is_rx = 1 }
        IfCondition EqualTo(strat, STRATEGY.REGEX_NFA) ThenBlock: { is_rx = 1 }
        IfCondition EqualTo(strat, STRATEGY.REGEX_INSENSITIVE) ThenBlock: { is_rx = 1 }
        IfCondition EqualTo(is_rx, 0) ThenBlock: { ReturnValue(0) }

        // -i compiles and matches the lowercased pattern. Fold the file bytes.
        IfCondition EqualTo(GrepConfig.case_insensitive, 1) ThenBlock: {
            pat = Dereference(Patterns.lc_ptrs)
            Patterns.fast_rx_fold = 1
        } ElseBlock: {
            pat = Dereference(Patterns.ptrs)
            Patterns.fast_rx_fold = 0
        }
        plen = Dereference(Patterns.lens)
        IfCondition LessEqual(plen, 0) ThenBlock: { ReturnValue(0) }

        // ^literal or ^literal$
        IfCondition And(GreaterEqual(plen, 2), EqualTo(GetByte(pat, 0), 94)) ThenBlock: {
            lit_len = Subtract(plen, 1)
            end_anchor = 0
            IfCondition EqualTo(GetByte(pat, Subtract(plen, 1)), 36) ThenBlock: {
                end_anchor = 1
                lit_len = Subtract(plen, 2)
            }
            IfCondition And(GreaterEqual(lit_len, 1), EqualTo(SpanIsLiteral(pat, 1, lit_len), 1)) ThenBlock: {
                Patterns.fast_rx_mode = 1
                Patterns.fast_rx_end = end_anchor
                Patterns.fast_rx_a = Add(pat, 1)
                Patterns.fast_rx_a_len = lit_len
                Patterns.fast_rx_ok = 1
                ReturnValue(1)
            }
        }

        // literal .* literal. The leftmost copy of the left literal is enough:
        // a later copy ends later, so a right literal after it is also after
        // the leftmost one. `.` does not cross the newline we stop at.
        star_at = -1
        bad = 0
        i = 0
        WhileLoop LessThan(i, plen) {
            c = GetByte(pat, i)
            is_dotstar = 0
            IfCondition And(EqualTo(c, 46), LessThan(Add(i, 1), plen)) ThenBlock: {
                IfCondition EqualTo(GetByte(pat, Add(i, 1)), 42) ThenBlock: {
                    is_dotstar = 1
                }
            }
            IfCondition EqualTo(is_dotstar, 1) ThenBlock: {
                IfCondition NotEqual(star_at, -1) ThenBlock: { bad = 1 }
                star_at = i
                i = Add(i, 2)
            } ElseBlock: {
                IfCondition EqualTo(IsRegexMeta(c), 1) ThenBlock: { bad = 1 }
                IfCondition EqualTo(c, 10) ThenBlock: { bad = 1 }
                i = Add(i, 1)
            }
        }
        IfCondition And(EqualTo(bad, 0), GreaterThan(star_at, 0)) ThenBlock: {
            right_from = Add(star_at, 2)
            right_len = Subtract(plen, right_from)
            IfCondition GreaterThan(right_len, 0) ThenBlock: {
                Patterns.fast_rx_mode = 2
                Patterns.fast_rx_a = pat
                Patterns.fast_rx_a_len = star_at
                Patterns.fast_rx_b = Add(pat, right_from)
                Patterns.fast_rx_b_len = right_len
                // Scan the longer literal. Equal lengths stay on the left,
                // where one check decides the whole line.
                IfCondition GreaterThan(right_len, star_at) ThenBlock: {
                    Patterns.fast_rx_drive = 1
                }
                Patterns.fast_rx_ok = 1
                ReturnValue(1)
            }
        }

        // literal(|literal)+ with no other metacharacters.
        has_bar = 0
        pure = 1
        i = 0
        WhileLoop LessThan(i, plen) {
            c = GetByte(pat, i)
            IfCondition EqualTo(c, 124) ThenBlock: {
                has_bar = 1
            } ElseBlock: {
                IfCondition EqualTo(IsRegexMeta(c), 1) ThenBlock: { pure = 0 }
                IfCondition EqualTo(c, 10) ThenBlock: { pure = 0 }
            }
            i = Add(i, 1)
        }
        IfCondition And(EqualTo(has_bar, 1), EqualTo(pure, 1)) ThenBlock: {
            IfCondition EqualTo(Patterns.fast_rx_alts, 0) ThenBlock: {
                Patterns.fast_rx_alts = Allocate(64)
                Patterns.fast_rx_alt_lens = Allocate(64)
            }
            nalt = 0
            piece = 0
            i = 0
            WhileLoop LessEqual(i, plen) {
                split_here = 0
                IfCondition EqualTo(i, plen) ThenBlock: {
                    split_here = 1
                } ElseBlock: {
                    IfCondition EqualTo(GetByte(pat, i), 124) ThenBlock: {
                        split_here = 1
                    }
                }
                IfCondition EqualTo(split_here, 1) ThenBlock: {
                    piece_len = Subtract(i, piece)
                    IfCondition LessThan(piece_len, 1) ThenBlock: { pure = 0 }
                    IfCondition GreaterEqual(nalt, 8) ThenBlock: { pure = 0 }
                    IfCondition EqualTo(pure, 1) ThenBlock: {
                        StoreValue(Add(Patterns.fast_rx_alts, Multiply(nalt, 8)), Add(pat, piece))
                        StoreValue(Add(Patterns.fast_rx_alt_lens, Multiply(nalt, 8)), piece_len)
                        nalt = Add(nalt, 1)
                    }
                    piece = Add(i, 1)
                }
                i = Add(i, 1)
            }
            IfCondition And(EqualTo(pure, 1), GreaterEqual(nalt, 2)) ThenBlock: {
                Patterns.fast_rx_mode = 3
                Patterns.fast_rx_alt_n = nalt
                Patterns.fast_rx_ok = 1
                ReturnValue(1)
            }
        }

        // literal + one [abc] class + literal. No ranges, no negation.
        // The class check is a few byte compares, so ker[nm]el does not
        // enter the Thompson interpreter.
        lb = -1
        i = 0
        WhileLoop LessThan(i, plen) {
            IfCondition EqualTo(GetByte(pat, i), 91) ThenBlock: {
                IfCondition EqualTo(lb, -1) ThenBlock: {
                    lb = i
                } ElseBlock: {
                    lb = -2
                }
            }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(lb, 2) ThenBlock: {
            IfCondition EqualTo(SpanIsLiteral(pat, 0, lb), 1) ThenBlock: {
                rb = -1
                j = Add(lb, 1)
                WhileLoop LessThan(j, plen) {
                    IfCondition EqualTo(GetByte(pat, j), 93) ThenBlock: {
                        rb = j
                        BreakLoop
                    }
                    j = Add(j, 1)
                }
                IfCondition GreaterThan(rb, lb) ThenBlock: {
                    body_from = Add(lb, 1)
                    body_len = Subtract(rb, body_from)
                    body_ok = 1
                    IfCondition Or(LessThan(body_len, 1), GreaterThan(body_len, 32)) ThenBlock: {
                        body_ok = 0
                    }
                    IfCondition And(EqualTo(body_ok, 1), EqualTo(GetByte(pat, body_from), 94)) ThenBlock: {
                        body_ok = 0
                    }
                    bi = 0
                    WhileLoop And(EqualTo(body_ok, 1), LessThan(bi, body_len)) {
                        bc = GetByte(pat, Add(body_from, bi))
                        IfCondition EqualTo(bc, 45) ThenBlock: { body_ok = 0 }
                        IfCondition EqualTo(bc, 92) ThenBlock: { body_ok = 0 }
                        IfCondition EqualTo(bc, 91) ThenBlock: { body_ok = 0 }
                        bi = Add(bi, 1)
                    }
                    right_from = Add(rb, 1)
                    right_len = Subtract(plen, right_from)
                    IfCondition And(EqualTo(body_ok, 1), GreaterThan(right_len, 0)) ThenBlock: {
                        IfCondition EqualTo(SpanIsLiteral(pat, right_from, right_len), 0) ThenBlock: {
                            body_ok = 0
                        }
                    }
                    IfCondition And(EqualTo(body_ok, 1), LessThan(right_len, 0)) ThenBlock: {
                        body_ok = 0
                    }
                    IfCondition EqualTo(body_ok, 1) ThenBlock: {
                        IfCondition EqualTo(Patterns.fast_rx_class, 0) ThenBlock: {
                            Patterns.fast_rx_class = Allocate(32)
                        }
                        MemoryCopy(Patterns.fast_rx_class, Add(pat, body_from), body_len)
                        Patterns.fast_rx_class_n = body_len
                        Patterns.fast_rx_mode = 5
                        Patterns.fast_rx_a = pat
                        Patterns.fast_rx_a_len = lb
                        Patterns.fast_rx_b = Add(pat, right_from)
                        Patterns.fast_rx_b_len = right_len
                        Patterns.fast_rx_ok = 1
                        ReturnValue(1)
                    }
                }
            }
        }

        // Prefix filter. Lines that contain it still go through LineMatches.
        pfx_len = Dereference(Patterns.rx_prefix_len)
        pfx = Dereference(Patterns.rx_prefix)
        IfCondition And(GreaterEqual(pfx_len, 2), NotEqual(pfx, 0)) ThenBlock: {
            IfCondition EqualTo(SpanIsLiteral(pfx, 0, pfx_len), 1) ThenBlock: {
                Patterns.fast_rx_mode = 4
                Patterns.fast_rx_a = pfx
                Patterns.fast_rx_a_len = pfx_len
                Patterns.fast_rx_ok = 1
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

// Called after GrepConfig.fixed / case_insensitive are final. Builds
// the regex handle for each stored pattern unless -F is in effect.
// Patterns that fail to compile are downgraded to literal (handle = 0).
//
// The Thompson regex library defines a CASE_INSENSITIVE flag slot but
// doesn't actually implement it. We emulate -i by compiling the
// lowercased copy of the pattern (so "[A-Z]" becomes "[a-z]", "HELLO"
// becomes "hello"), and lowercasing the scratch line buffer before
// Regex_Match in RegexLineSearch.
Function.CompileAllPatterns {
    Body: {
        IfCondition EqualTo(GrepConfig.fixed, 1) ThenBlock: {
            // Pure literal mode — no regex, but still build BM tables.
        } ElseBlock: {
            i = 0
            WhileLoop LessThan(i, Patterns.count) {
                IfCondition EqualTo(GrepConfig.case_insensitive, 1) ThenBlock: {
                    pat = Dereference(Add(Patterns.lc_ptrs, Multiply(i, 8)))
                } ElseBlock: {
                    pat = Dereference(Add(Patterns.ptrs, Multiply(i, 8)))
                }
                plen_i = Dereference(Add(Patterns.lens, Multiply(i, 8)))
                IfCondition EqualTo(PatternIsLiteral(pat, plen_i), 1) ThenBlock: {
                    handle = 0
                } ElseBlock: {
                    handle = Regex_Compile(pat, 0)
                }
                StoreValue(Add(Patterns.regex, Multiply(i, 8)), handle)

                // Extract a literal prefix (CHAR-chain from start state).
                // If prefix_len >= 2 we get a useful BM pre-filter; shorter
                // prefixes lose to the linear scan (and plen==1 is just
                // MemChr inside SearchBoyerMoore, so still no win).
                IfCondition NotEqual(handle, 0) ThenBlock: {
                    prefix_buf = Allocate(32)
                    prefix_len = Regex_GetPrefix(handle, prefix_buf, 32)
                    StoreValue(Add(Patterns.rx_prefix,     Multiply(i, 8)), prefix_buf)
                    StoreValue(Add(Patterns.rx_prefix_len, Multiply(i, 8)), prefix_len)
                }
                i = Add(i, 1)
            }
        }

        // Lazy DFA: only useful for single-pattern grep (the shared
        // DFA buffer can't be multiplexed across patterns without a
        // per-handle rebuild on every line). Try to init; if the
        // regex has ^/$ anchors DFA_Init returns 0 and we stay on
        // Regex_Search for the no-prefix path.
        Patterns.dfa_ok = 0
        IfCondition EqualTo(Patterns.count, 1) ThenBlock: {
            h = Dereference(Patterns.regex)
            IfCondition NotEqual(h, 0) ThenBlock: {
                Patterns.dfa_ok = Regex_DFAInit(h)
            }
        }

        // Precompute the per-pattern dispatch strategy. This is the
        // input to LineMatches' Branch — 2 instructions per dispatch
        // (CMP RAX,imm32 ; JE) on the literal-case fast path, so the
        // per-line overhead is effectively O(1) regardless of how
        // many strategies exist.
        si = 0
        WhileLoop LessThan(si, Patterns.count) {
            s_plen   = Dereference(Add(Patterns.lens,          Multiply(si, 8)))
            s_rhand  = Dereference(Add(Patterns.regex,         Multiply(si, 8)))
            s_pfxlen = Dereference(Add(Patterns.rx_prefix_len, Multiply(si, 8)))
            strat = STRATEGY.LITERAL_BM
            IfCondition EqualTo(s_plen, 0) ThenBlock: {
                strat = STRATEGY.EMPTY
            } ElseBlock: {
                IfCondition EqualTo(GrepConfig.whole_line, 1) ThenBlock: {
                    strat = STRATEGY.WHOLE_LINE
                } ElseBlock: {
                    IfCondition EqualTo(GrepConfig.word_match, 1) ThenBlock: {
                        strat = STRATEGY.WORD_MATCH
                    } ElseBlock: {
                        IfCondition EqualTo(GrepConfig.case_insensitive, 1) ThenBlock: {
                            IfCondition NotEqual(s_rhand, 0) ThenBlock: {
                                strat = STRATEGY.REGEX_INSENSITIVE
                            } ElseBlock: {
                                strat = STRATEGY.LITERAL_INSENSITIVE
                            }
                        } ElseBlock: {
                            IfCondition NotEqual(s_rhand, 0) ThenBlock: {
                                IfCondition GreaterEqual(s_pfxlen, 2) ThenBlock: {
                                    strat = STRATEGY.REGEX_PREFIX_BM
                                } ElseBlock: {
                                    IfCondition EqualTo(Patterns.dfa_ok, 1) ThenBlock: {
                                        strat = STRATEGY.REGEX_DFA
                                    } ElseBlock: {
                                        strat = STRATEGY.REGEX_NFA
                                    }
                                }
                            }
                            // else: strat stays LITERAL_BM
                        }
                    }
                }
            }
            StoreValue(Add(Patterns.strategy, Multiply(si, 8)), strat)
            si = Add(si, 1)
        }

        // Batched fast-path hoist: a single LITERAL_BM pattern is the
        // common `-F` / default-mode-literal case. When this fires,
        // ProcessStream inlines the entire match check into its main
        // loop and skips the per-line line_buf copy.
        Patterns.fast_literal_ok = 0
        IfCondition EqualTo(Patterns.count, 1) ThenBlock: {
            only_strat = Dereference(Patterns.strategy)
            IfCondition EqualTo(only_strat, STRATEGY.LITERAL_BM) ThenBlock: {
                Patterns.fast_pat         = Dereference(Patterns.ptrs)
                Patterns.fast_plen        = Dereference(Patterns.lens)
                Patterns.fast_first_byte  = GetByte(Patterns.fast_pat, 0)
                Patterns.fast_literal_ok  = 1

                // Rare-byte heuristic: pick the pattern byte that is
                // least frequent in typical text/code as the MemChr
                // anchor. Non-alphanumeric > uppercase > consonant >
                // common letters. Falls back to last byte (GNU default).
                fp = Patterns.fast_pat
                fp_len = Patterns.fast_plen
                best_i = Subtract(fp_len, 1)
                best_score = 0
                ri = 0
                WhileLoop LessThan(ri, fp_len) {
                    rb = GetByte(fp, ri)
                    score = 0
                    IfCondition Or(LessThan(rb, 32), GreaterThan(rb, 126)) ThenBlock: {
                        score = 100
                    } ElseBlock: {
                        IfCondition Or(And(GreaterEqual(rb, 33), LessEqual(rb, 47)),
                                       Or(And(GreaterEqual(rb, 58), LessEqual(rb, 64)),
                                          And(GreaterEqual(rb, 91), LessEqual(rb, 96)))) ThenBlock: {
                            score = 80
                        } ElseBlock: {
                            IfCondition And(GreaterEqual(rb, 65), LessEqual(rb, 90)) ThenBlock: {
                                score = 60
                            } ElseBlock: {
                                IfCondition And(GreaterEqual(rb, 48), LessEqual(rb, 57)) ThenBlock: {
                                    score = 40
                                } ElseBlock: {
                                    score = 10
                                }
                            }
                        }
                    }
                    IfCondition GreaterThan(score, best_score) ThenBlock: {
                        best_score = score
                        best_i = ri
                    }
                    ri = Add(ri, 1)
                }
                Patterns.fast_rare_byte   = GetByte(fp, best_i)
                Patterns.fast_rare_offset = best_i
            }
        }

        // Case-insensitive literal fast path: single LITERAL_INSENSITIVE
        // pattern. Used by ProcessMapped to do search-then-split with
        // dual MemChr (lowercase + uppercase of the rare byte).
        Patterns.fast_icase_ok = 0
        IfCondition EqualTo(Patterns.count, 1) ThenBlock: {
            only_strat2 = Dereference(Patterns.strategy)
            IfCondition EqualTo(only_strat2, STRATEGY.LITERAL_INSENSITIVE) ThenBlock: {
                icp = Dereference(Patterns.lc_ptrs)
                icl = Dereference(Patterns.lens)
                Patterns.fast_icase_pat  = icp
                Patterns.fast_icase_plen = icl
                Patterns.fast_icase_ok   = 1
                // Pick rare byte from lowercased pattern, store both cases
                ic_best = Subtract(icl, 1)
                ic_bscore = 0
                ici = 0
                WhileLoop LessThan(ici, icl) {
                    icb = GetByte(icp, ici)
                    ics = 0
                    IfCondition Or(LessThan(icb, 32), GreaterThan(icb, 126)) ThenBlock: {
                        ics = 100
                    } ElseBlock: {
                        IfCondition And(GreaterEqual(icb, 97), LessEqual(icb, 122)) ThenBlock: {
                            ics = 10
                        } ElseBlock: {
                            ics = 50
                        }
                    }
                    IfCondition GreaterThan(ics, ic_bscore) ThenBlock: {
                        ic_bscore = ics
                        ic_best = ici
                    }
                    ici = Add(ici, 1)
                }
                lo = GetByte(icp, ic_best)
                Patterns.fast_icase_rare_lo = lo
                IfCondition And(GreaterEqual(lo, 97), LessEqual(lo, 122)) ThenBlock: {
                    Patterns.fast_icase_rare_up = Subtract(lo, 32)
                } ElseBlock: {
                    Patterns.fast_icase_rare_up = lo
                }
                Patterns.fast_icase_rare_off = ic_best
            }
        }

        // Single literal -w. The whole-file scan finds the bytes, then
        // WordEdgesOk keeps only matches with a non-word neighbor.
        // -x wins over -w in the strategy pick, so it stays off here.
        Patterns.fast_word_ok = 0
        IfCondition And(EqualTo(Patterns.count, 1),
                        And(EqualTo(GrepConfig.word_match, 1),
                            EqualTo(GrepConfig.whole_line, 0))) ThenBlock: {
            wp = Dereference(Patterns.ptrs)
            wl = Dereference(Patterns.lens)
            w_nl = 0
            wi = 0
            WhileLoop LessThan(wi, wl) {
                IfCondition EqualTo(GetByte(wp, wi), 10) ThenBlock: { w_nl = 1 }
                wi = Add(wi, 1)
            }
            IfCondition And(GreaterThan(wl, 0), EqualTo(w_nl, 0)) ThenBlock: {
                Patterns.fast_pat = wp
                Patterns.fast_plen = wl
                Patterns.fast_icase_pat = Dereference(Patterns.lc_ptrs)
                Patterns.fast_icase_plen = wl
                Patterns.fast_word_ok = 1
            }
        }

        ClassifyRegexFast()
    }
}

Function.AddPattern {
    Input: str: Address
    Body: {
        n = Patterns.count
        IfCondition GreaterEqual(n, GrepConstants.MAX_PATTERNS) ThenBlock: {
            // overflow, ignore
        } ElseBlock: {
            plen = StringLength(str)
            // Copy into owned NUL-terminated buffer so cmdline memory can
            // be freed safely and so Regex_Compile (which expects NUL
            // termination) sees a clean string.
            own = Allocate(Add(plen, 1))
            MemoryCopy(own, str, plen)
            SetByte(own, plen, 0)
            lc = UnicodeFoldStr(str, plen)

            StoreValue(Add(Patterns.ptrs,    Multiply(n, 8)), own)
            StoreValue(Add(Patterns.lc_ptrs, Multiply(n, 8)), lc)
            StoreValue(Add(Patterns.lens,    Multiply(n, 8)), plen)
            StoreValue(Add(Patterns.regex,   Multiply(n, 8)), 0)
            Patterns.count = Add(n, 1)
            IfCondition GreaterThan(plen, Patterns.longest) ThenBlock: {
                Patterns.longest = plen
            }
        }
    }
}

// === FILE PROCESSING ===
// Returns number of matches found in the stream. `label` is the filename
// to prefix matches with when the prefix mode is active (may be 0).
Function.ProcessStream {
    Input: fd: Integer
    Input: label: Address
    Input: show_prefix: Integer
    Output: Integer
    Body: {
        read_buf = Allocate(GrepConstants.BUFFER_SIZE)
        line_buf = Allocate(GrepConstants.LINE_MAX)
        line_len = 0
        line_no = 0
        match_count = 0
        stop_early = 0
        first_chunk = 1
        is_binary = 0

        WhileLoop 1 {
            IfCondition EqualTo(stop_early, 1) ThenBlock: { BreakLoop }
            n = SysRead(fd, read_buf, GrepConstants.BUFFER_SIZE)
            IfCondition LessEqual(n, 0) ThenBlock: { BreakLoop }

            // Binary detection (GNU default): if the first chunk contains
            // a NUL, treat as binary. On first match we'll emit
            // "Binary file X matches" and stop further line processing
            // for this file — matches GNU's --binary-files=binary mode.
            IfCondition EqualTo(first_chunk, 1) ThenBlock: {
                first_chunk = 0
                IfCondition NotEqual(MemChr(read_buf, 0, n), -1) ThenBlock: {
                    is_binary = 1
                }
            }

            // Line-scan the read buffer with MemChr for '\n' (SIMD-accelerated),
            // MemoryCopy each line fragment into line_buf. Replaces a per-byte
            // GetByte/SetByte loop; roughly the same logic but with strides of
            // up to a full line at a time.
            i = 0
            WhileLoop LessThan(i, n) {
                IfCondition EqualTo(stop_early, 1) ThenBlock: { BreakLoop }
                remaining = Subtract(n, i)
                search_ptr = Add(read_buf, i)
                nl_offset = MemChr(search_ptr, 10, remaining)

                IfCondition EqualTo(nl_offset, -1) ThenBlock: {
                    // No newline in rest of buffer: append (clamped to LINE_MAX)
                    space_left = Subtract(GrepConstants.LINE_MAX, line_len)
                    copy_bytes = remaining
                    IfCondition GreaterThan(copy_bytes, space_left) ThenBlock: {
                        copy_bytes = space_left
                    }
                    IfCondition GreaterThan(copy_bytes, 0) ThenBlock: {
                        MemoryCopy(Add(line_buf, line_len), search_ptr, copy_bytes)
                        line_len = Add(line_len, copy_bytes)
                    }
                    BreakLoop
                }

                // Found newline at search_ptr[nl_offset]. Two paths:
                //
                //   FAST: fast_literal_ok — single LITERAL_BM pattern, no
                //   continued line fragment. Search the raw read-buffer
                //   slice directly (no MemoryCopy into line_buf, no
                //   LineMatches dispatch). Output emits from the raw
                //   slice too. This shaves 2 function-call overheads
                //   and a MemoryCopy per line — on a 536 MB / 6.7 M
                //   line corpus that's ~540 MB of eliminated copies
                //   and ~20 M of eliminated calls.
                //
                //   SLOW: copy into line_buf and call LineMatches as
                //   before. Handles multi-pattern, continued lines
                //   from prior buffer, regex, whole-line, -i, -w.
                raw_match = 0
                fast_used = 0
                IfCondition And(EqualTo(Patterns.fast_literal_ok, 1),
                                EqualTo(line_len, 0)) ThenBlock: {
                    raw_match = FastLiteralSearch(search_ptr, nl_offset,
                                                  Patterns.fast_pat,
                                                  Patterns.fast_plen)
                    fast_used = 1
                } ElseBlock: {
                    space_left = Subtract(GrepConstants.LINE_MAX, line_len)
                    copy_bytes = nl_offset
                    IfCondition GreaterThan(copy_bytes, space_left) ThenBlock: {
                        copy_bytes = space_left
                    }
                    IfCondition GreaterThan(copy_bytes, 0) ThenBlock: {
                        MemoryCopy(Add(line_buf, line_len), search_ptr, copy_bytes)
                        line_len = Add(line_len, copy_bytes)
                    }
                    raw_match = LineMatches(line_buf, line_len)
                }

                line_no = Add(line_no, 1)
                IfCondition EqualTo(GrepConfig.invert, 1) ThenBlock: {
                    IfCondition EqualTo(raw_match, 1) ThenBlock: {
                        effective = 0
                    } ElseBlock: {
                        effective = 1
                    }
                } ElseBlock: {
                    effective = raw_match
                }

                IfCondition EqualTo(effective, 1) ThenBlock: {
                    match_count = Add(match_count, 1)
                    // Binary: GNU prints "Binary file X matches" on first
                    // match and stops. Short-circuit for -q/-l/-L.
                    IfCondition EqualTo(is_binary, 1) ThenBlock: {
                        IfCondition And(EqualTo(GrepConfig.quiet, 0),
                                        And(EqualTo(GrepConfig.files_with, 0),
                                            And(EqualTo(GrepConfig.files_without, 0),
                                                EqualTo(GrepConfig.count_only, 0)))) ThenBlock: {
                            IfCondition NotEqual(label, 0) ThenBlock: {
                                OutStr("Binary file ")
                                OutStr(label)
                                OutStr(" matches\n")
                            }
                        }
                        stop_early = 1
                    } ElseBlock: {
                        IfCondition Or(EqualTo(GrepConfig.quiet, 1),
                                       Or(EqualTo(GrepConfig.files_with, 1),
                                          EqualTo(GrepConfig.files_without, 1))) ThenBlock: {
                            stop_early = 1
                        } ElseBlock: {
                            IfCondition EqualTo(GrepConfig.count_only, 0) ThenBlock: {
                                IfCondition And(EqualTo(show_prefix, 1), NotEqual(label, 0)) ThenBlock: {
                                    OutStr(label)
                                    OutByte(58)  // ':'
                                }
                                IfCondition EqualTo(GrepConfig.line_numbers, 1) ThenBlock: {
                                    OutUInt(line_no)
                                    OutByte(58)
                                }
                                IfCondition EqualTo(fast_used, 1) ThenBlock: {
                                    OutBytes(search_ptr, nl_offset)
                                } ElseBlock: {
                                    OutBytes(line_buf, line_len)
                                }
                                OutByte(10)
                            }
                        }
                    }
                }
                line_len = 0
                i = Add(i, Add(nl_offset, 1))
            }
        }

        // Trailing no-newline line
        IfCondition And(GreaterThan(line_len, 0), EqualTo(stop_early, 0)) ThenBlock: {
            line_no = Add(line_no, 1)
            raw_match = LineMatches(line_buf, line_len)
            IfCondition EqualTo(GrepConfig.invert, 1) ThenBlock: {
                IfCondition EqualTo(raw_match, 1) ThenBlock: { effective = 0 } ElseBlock: { effective = 1 }
            } ElseBlock: {
                effective = raw_match
            }
            IfCondition EqualTo(effective, 1) ThenBlock: {
                match_count = Add(match_count, 1)
                IfCondition And(EqualTo(GrepConfig.count_only, 0),
                                And(EqualTo(GrepConfig.quiet, 0),
                                    And(EqualTo(GrepConfig.files_with, 0),
                                        EqualTo(GrepConfig.files_without, 0)))) ThenBlock: {
                    IfCondition And(EqualTo(show_prefix, 1), NotEqual(label, 0)) ThenBlock: {
                        OutStr(label)
                        OutByte(58)
                    }
                    IfCondition EqualTo(GrepConfig.line_numbers, 1) ThenBlock: {
                        OutUInt(line_no)
                        OutByte(58)
                    }
                    OutBytes(line_buf, line_len)
                    OutByte(10)
                }
            }
        }

        Deallocate(line_buf, GrepConstants.LINE_MAX)
        Deallocate(read_buf, GrepConstants.BUFFER_SIZE)
        ReturnValue(match_count)
    }
}

// === MMAP PATH: search-then-split ===
// For regular files we mmap the entire file and search the flat buffer.
// The fast literal path scans for the pattern first (MemChr + MemCompare
// in ~16-byte SIMD strides) and only locates line boundaries on a hit.
// Non-matching regions — the vast majority of typical input — never
// have their newlines scanned at all. This is the core technique that
// makes GNU grep and ripgrep fast.
//
// Line numbers are counted lazily: we accumulate newlines between the
// last-counted position and the current match only when -n is active.
// -v that must print lines falls back to line-at-a-time. -c -v on a
// single literal counts newlines once and subtracts the fast hit lines.

// Count newlines in data[from..to) using MemChr.
Function.CountNewlines {
    Input: data: Address
    Input: from: Integer
    Input: to: Integer
    Output: Integer
    Body: {
        count = 0
        pos = from
        WhileLoop LessThan(pos, to) {
            off = MemChr(Add(data, pos), 10, Subtract(to, pos))
            IfCondition LessThan(off, 0) ThenBlock: { BreakLoop }
            count = Add(count, 1)
            pos = Add(Add(pos, off), 1)
        }
        ReturnValue(count)
    }
}

// Walk backwards from `pos` to find the start of the line (byte after
// the preceding '\n', or 0 if at the start of the buffer).
Function.FindLineStart {
    Input: data: Address
    Input: pos: Integer
    Output: Integer
    Body: {
        p = Subtract(pos, 1)
        WhileLoop GreaterEqual(p, 0) {
            IfCondition EqualTo(GetByte(data, p), 10) ThenBlock: {
                ReturnValue(Add(p, 1))
            }
            p = Subtract(p, 1)
        }
        ReturnValue(0)
    }
}

// Higher means rarer in English text. MemMem anchors on the first two
// bytes, so a common pair like "er" verifies on every buffer/interface.
// The mapped literal scan searches the rarest adjacent pair instead.
Function.LiteralByteScore {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(c, 10) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 32) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 101) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 97) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 114) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 105) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 111) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 116) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 110) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 115) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 107) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(c, 118) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(c, 106) ThenBlock: { ReturnValue(16) }
        IfCondition EqualTo(c, 113) ThenBlock: { ReturnValue(16) }
        IfCondition EqualTo(c, 120) ThenBlock: { ReturnValue(16) }
        IfCondition EqualTo(c, 122) ThenBlock: { ReturnValue(16) }
        IfCondition And(GreaterEqual(c, 97), LessEqual(c, 122)) ThenBlock: { ReturnValue(4) }
        IfCondition And(GreaterEqual(c, 65), LessEqual(c, 90)) ThenBlock: { ReturnValue(14) }
        IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: { ReturnValue(8) }
        ReturnValue(24)
    }
}

// Offset of the rarest adjacent pair. The first pair wins a tie, so a
// word like "kernel" stays on its leading pair.
Function.BestPairOffset {
    Input: pat: Address
    Input: plen: Integer
    Output: Integer
    Body: {
        best_i = 0
        best = -1
        i = 0
        last = Subtract(plen, 1)
        WhileLoop LessThan(i, last) {
            sc = Add(LiteralByteScore(GetByte(pat, i)),
                     LiteralByteScore(GetByte(pat, Add(i, 1))))
            IfCondition GreaterThan(sc, best) ThenBlock: {
                best = sc
                best_i = i
            }
            i = Add(i, 1)
        }
        ReturnValue(best_i)
    }
}

// MemMem or MemMemFold. fold=1 compares ASCII A-Z as a-z on both sides.
Function.FindNeedle {
    Input: hay: Address
    Input: hay_len: Integer
    Input: needle: Address
    Input: needle_len: Integer
    Input: fold: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(fold, 1) ThenBlock: {
            ReturnValue(MemMemFold(hay, hay_len, needle, needle_len))
        }
        ReturnValue(MemMem(hay, hay_len, needle, needle_len))
    }
}

// Whole-mapping scan for one regex that has a required literal.
// Returns the match count. Caller already rejected -v.
Function.ProcessMappedRegex {
    Input: data: Address
    Input: data_len: Integer
    Input: label: Address
    Input: show_prefix: Integer
    Output: Integer
    Body: {
        match_count = 0
        stop_early = 0
        is_binary = 0
        check_len = data_len
        IfCondition GreaterThan(check_len, GrepConstants.BUFFER_SIZE) ThenBlock: {
            check_len = GrepConstants.BUFFER_SIZE
        }
        IfCondition NotEqual(MemChr(data, 0, check_len), -1) ThenBlock: {
            is_binary = 1
        }

        mode = Patterns.fast_rx_mode
        fold = Patterns.fast_rx_fold
        last_nl_pos = 0
        nl_count = 0
        scan_pos = 0

        WhileLoop LessThan(scan_pos, data_len) {
            IfCondition EqualTo(stop_early, 1) ThenBlock: { BreakLoop }
            remaining = Subtract(data_len, scan_pos)
            hay = Add(data, scan_pos)
            matched = 0
            cand = scan_pos
            advance = data_len

            IfCondition EqualTo(mode, 3) ThenBlock: {
                best = -1
                ai = 0
                WhileLoop LessThan(ai, Patterns.fast_rx_alt_n) {
                    ap = Dereference(Add(Patterns.fast_rx_alts, Multiply(ai, 8)))
                    al = Dereference(Add(Patterns.fast_rx_alt_lens, Multiply(ai, 8)))
                    off = FindNeedle(hay, remaining, ap, al, fold)
                    IfCondition GreaterEqual(off, 0) ThenBlock: {
                        IfCondition Or(LessThan(best, 0), LessThan(off, best)) ThenBlock: {
                            best = off
                        }
                    }
                    ai = Add(ai, 1)
                }
                IfCondition LessThan(best, 0) ThenBlock: { BreakLoop }
                cand = Add(scan_pos, best)
                matched = 1
            } ElseBlock: {
                off = FindNeedle(hay, remaining, Patterns.fast_rx_a, Patterns.fast_rx_a_len, fold)
                // Mode 2 with the right literal longer scans needle b instead.
                IfCondition And(EqualTo(mode, 2), EqualTo(Patterns.fast_rx_drive, 1)) ThenBlock: {
                    off = FindNeedle(hay, remaining, Patterns.fast_rx_b, Patterns.fast_rx_b_len, fold)
                }
                IfCondition LessThan(off, 0) ThenBlock: { BreakLoop }
                cand = Add(scan_pos, off)
            }

            line_start = FindLineStart(data, cand)
            end_remaining = Subtract(data_len, cand)
            nl_off = MemChr(Add(data, cand), 10, end_remaining)
            IfCondition LessThan(nl_off, 0) ThenBlock: {
                line_end = data_len
                advance = data_len
            } ElseBlock: {
                line_end = Add(cand, nl_off)
                advance = Add(line_end, 1)
            }
            line_len = Subtract(line_end, line_start)

            IfCondition EqualTo(mode, 1) ThenBlock: {
                matched = 0
                IfCondition EqualTo(cand, line_start) ThenBlock: {
                    matched = 1
                    IfCondition EqualTo(Patterns.fast_rx_end, 1) ThenBlock: {
                        IfCondition NotEqual(line_len, Patterns.fast_rx_a_len) ThenBlock: {
                            matched = 0
                        }
                    }
                }
            }

            IfCondition EqualTo(mode, 2) ThenBlock: {
                matched = 0
                IfCondition EqualTo(Patterns.fast_rx_drive, 1) ThenBlock: {
                    // Right literal at cand. Left literal must end at or before it.
                    region = Subtract(cand, line_start)
                    IfCondition GreaterEqual(region, Patterns.fast_rx_a_len) ThenBlock: {
                        left_off = FindNeedle(Add(data, line_start), region,
                                              Patterns.fast_rx_a, Patterns.fast_rx_a_len, fold)
                        IfCondition GreaterEqual(left_off, 0) ThenBlock: { matched = 1 }
                    }
                    // A later copy of the right literal on this line can still match.
                    IfCondition EqualTo(matched, 0) ThenBlock: {
                        advance = Add(cand, 1)
                    }
                } ElseBlock: {
                    suf_from = Add(cand, Patterns.fast_rx_a_len)
                    IfCondition LessThan(suf_from, line_end) ThenBlock: {
                        suf_off = FindNeedle(Add(data, suf_from), Subtract(line_end, suf_from),
                                             Patterns.fast_rx_b, Patterns.fast_rx_b_len, fold)
                        IfCondition GreaterEqual(suf_off, 0) ThenBlock: { matched = 1 }
                    }
                }
            }

            IfCondition EqualTo(mode, 4) ThenBlock: {
                matched = LineMatches(Add(data, line_start), line_len)
            }

            IfCondition EqualTo(mode, 5) ThenBlock: {
                matched = 0
                at = Add(cand, Patterns.fast_rx_a_len)
                IfCondition LessThan(at, line_end) ThenBlock: {
                    nb = GetByte(data, at)
                    IfCondition EqualTo(fold, 1) ThenBlock: {
                        nb = ToLowerByte(nb)
                    }
                    hitc = 0
                    ci = 0
                    WhileLoop LessThan(ci, Patterns.fast_rx_class_n) {
                        IfCondition EqualTo(nb, GetByte(Patterns.fast_rx_class, ci)) ThenBlock: {
                            hitc = 1
                        }
                        ci = Add(ci, 1)
                    }
                    IfCondition EqualTo(hitc, 1) ThenBlock: {
                        suf_from = Add(at, 1)
                        suf_len = Patterns.fast_rx_b_len
                        IfCondition EqualTo(suf_len, 0) ThenBlock: {
                            matched = 1
                        } ElseBlock: {
                            IfCondition LessEqual(Add(suf_from, suf_len), line_end) ThenBlock: {
                                IfCondition EqualTo(fold, 1) ThenBlock: {
                                    same = 1
                                    si = 0
                                    WhileLoop LessThan(si, suf_len) {
                                        IfCondition NotEqual(ToLowerByte(GetByte(data, Add(suf_from, si))),
                                                             GetByte(Patterns.fast_rx_b, si)) ThenBlock: {
                                            same = 0
                                        }
                                        si = Add(si, 1)
                                    }
                                    IfCondition EqualTo(same, 1) ThenBlock: { matched = 1 }
                                } ElseBlock: {
                                    IfCondition EqualTo(MemCompare(Add(data, suf_from), Patterns.fast_rx_b, suf_len), 0) ThenBlock: {
                                        matched = 1
                                    }
                                }
                            }
                        }
                    }
                }
                IfCondition EqualTo(matched, 0) ThenBlock: {
                    advance = Add(cand, 1)
                }
            }

            IfCondition EqualTo(matched, 1) ThenBlock: {
                match_count = Add(match_count, 1)
                IfCondition EqualTo(is_binary, 1) ThenBlock: {
                    IfCondition And(EqualTo(GrepConfig.quiet, 0),
                                    And(EqualTo(GrepConfig.files_with, 0),
                                        And(EqualTo(GrepConfig.files_without, 0),
                                            EqualTo(GrepConfig.count_only, 0)))) ThenBlock: {
                        IfCondition NotEqual(label, 0) ThenBlock: {
                            OutStr("Binary file ")
                            OutStr(label)
                            OutStr(" matches\n")
                        }
                    }
                    stop_early = 1
                } ElseBlock: {
                    IfCondition Or(EqualTo(GrepConfig.quiet, 1),
                                   Or(EqualTo(GrepConfig.files_with, 1),
                                      EqualTo(GrepConfig.files_without, 1))) ThenBlock: {
                        stop_early = 1
                    } ElseBlock: {
                        IfCondition EqualTo(GrepConfig.count_only, 0) ThenBlock: {
                            IfCondition And(EqualTo(show_prefix, 1), NotEqual(label, 0)) ThenBlock: {
                                OutStr(label)
                                OutByte(58)
                            }
                            IfCondition EqualTo(GrepConfig.line_numbers, 1) ThenBlock: {
                                nl_count = Add(nl_count, CountNewlines(data, last_nl_pos, line_start))
                                last_nl_pos = line_start
                                OutUInt(Add(nl_count, 1))
                                OutByte(58)
                            }
                            OutBytes(Add(data, line_start), line_len)
                            OutByte(10)
                        }
                    }
                }
            }

            scan_pos = advance
        }

        ReturnValue(match_count)
    }
}

// Search-then-split for the fast literal path on mmap'd data.
// Returns match count.
Function.ProcessMapped {
    Input: data: Address
    Input: data_len: Integer
    Input: label: Address
    Input: show_prefix: Integer
    Output: Integer
    Body: {
        match_count = 0
        stop_early = 0

        // Binary detection: check for NUL in the data.
        is_binary = 0
        check_len = data_len
        IfCondition GreaterThan(check_len, GrepConstants.BUFFER_SIZE) ThenBlock: {
            check_len = GrepConstants.BUFFER_SIZE
        }
        IfCondition NotEqual(MemChr(data, 0, check_len), -1) ThenBlock: {
            is_binary = 1
        }

        // -c -v on one literal (including a single -w): non-matching
        // lines are total lines minus the lines the search hits.
        // Printing -v, -q, -l/-L, a binary file, regex, or -x stays on
        // the line walk. A pattern byte of '\n' cannot use that subtraction.
        count_invert = 0
        IfCondition And(EqualTo(GrepConfig.invert, 1),
                        And(EqualTo(GrepConfig.count_only, 1),
                            And(EqualTo(is_binary, 0),
                                And(EqualTo(GrepConfig.quiet, 0),
                                    And(EqualTo(GrepConfig.files_with, 0),
                                        EqualTo(GrepConfig.files_without, 0)))))) ThenBlock: {
            IfCondition EqualTo(Patterns.fast_word_ok, 1) ThenBlock: {
                // CompileAllPatterns already rejected a newline in this pattern.
                count_invert = 1
            } ElseBlock: {
                IfCondition Or(EqualTo(Patterns.fast_literal_ok, 1),
                               EqualTo(Patterns.fast_icase_ok, 1)) ThenBlock: {
                    pat_has_nl = 0
                    IfCondition EqualTo(Patterns.fast_icase_ok, 1) ThenBlock: {
                        nl_pat = Patterns.fast_icase_pat
                        nl_plen = Patterns.fast_icase_plen
                    } ElseBlock: {
                        nl_pat = Patterns.fast_pat
                        nl_plen = Patterns.fast_plen
                    }
                    nl_i = 0
                    WhileLoop LessThan(nl_i, nl_plen) {
                        IfCondition EqualTo(GetByte(nl_pat, nl_i), 10) ThenBlock: {
                            pat_has_nl = 1
                        }
                        nl_i = Add(nl_i, 1)
                    }
                    IfCondition EqualTo(pat_has_nl, 0) ThenBlock: {
                        count_invert = 1
                    }
                }
            }
        }

        // A single regex with a required literal scans the mapping once.
        // -v stays on the line walk below.
        IfCondition EqualTo(Patterns.fast_rx_ok, 1) ThenBlock: {
            ReturnValue(ProcessMappedRegex(data, data_len, label, show_prefix))
        }

        // -v that prints, regex without a usable literal, -x, and
        // multi-pattern -w walk every line.
        // A single literal -w (fast_word_ok) uses the scan below.
        IfCondition Or(And(EqualTo(Patterns.fast_literal_ok, 0),
                           And(EqualTo(Patterns.fast_icase_ok, 0),
                               EqualTo(Patterns.fast_word_ok, 0))),
                       And(EqualTo(GrepConfig.invert, 1),
                           EqualTo(count_invert, 0))) ThenBlock: {
            // Line-at-a-time scan over the mmap'd buffer (still avoids
            // the read() syscall loop and buffer-boundary handling).
            line_start = 0
            line_no = 0
            WhileLoop LessThan(line_start, data_len) {
                IfCondition EqualTo(stop_early, 1) ThenBlock: { BreakLoop }
                remaining = Subtract(data_len, line_start)
                nl_off = MemChr(Add(data, line_start), 10, remaining)
                IfCondition LessThan(nl_off, 0) ThenBlock: {
                    line_end = data_len
                } ElseBlock: {
                    line_end = Add(line_start, nl_off)
                }
                line_len = Subtract(line_end, line_start)
                line_no = Add(line_no, 1)

                raw_match = LineMatches(Add(data, line_start), line_len)
                IfCondition EqualTo(GrepConfig.invert, 1) ThenBlock: {
                    IfCondition EqualTo(raw_match, 1) ThenBlock: { effective = 0 } ElseBlock: { effective = 1 }
                } ElseBlock: {
                    effective = raw_match
                }

                IfCondition EqualTo(effective, 1) ThenBlock: {
                    match_count = Add(match_count, 1)
                    IfCondition EqualTo(is_binary, 1) ThenBlock: {
                        IfCondition And(EqualTo(GrepConfig.quiet, 0),
                                        And(EqualTo(GrepConfig.files_with, 0),
                                            And(EqualTo(GrepConfig.files_without, 0),
                                                EqualTo(GrepConfig.count_only, 0)))) ThenBlock: {
                            IfCondition NotEqual(label, 0) ThenBlock: {
                                OutStr("Binary file ")
                                OutStr(label)
                                OutStr(" matches\n")
                            }
                        }
                        stop_early = 1
                    } ElseBlock: {
                        IfCondition Or(EqualTo(GrepConfig.quiet, 1),
                                       Or(EqualTo(GrepConfig.files_with, 1),
                                          EqualTo(GrepConfig.files_without, 1))) ThenBlock: {
                            stop_early = 1
                        } ElseBlock: {
                            IfCondition EqualTo(GrepConfig.count_only, 0) ThenBlock: {
                                IfCondition And(EqualTo(show_prefix, 1), NotEqual(label, 0)) ThenBlock: {
                                    OutStr(label)
                                    OutByte(58)
                                }
                                IfCondition EqualTo(GrepConfig.line_numbers, 1) ThenBlock: {
                                    OutUInt(line_no)
                                    OutByte(58)
                                }
                                OutBytes(Add(data, line_start), line_len)
                                OutByte(10)
                            }
                        }
                    }
                }
                IfCondition LessThan(nl_off, 0) ThenBlock: {
                    BreakLoop
                }
                line_start = Add(line_end, 1)
            }
            ReturnValue(match_count)
        }

        // === FAST LITERAL SEARCH-THEN-SPLIT ===
        // One SSE2 scan. A needle of 2+ bytes is found by its rarest
        // adjacent pair, then the full needle is checked at pair_off
        // bytes before that hit. MemMem's own anchor is the first two
        // bytes, which is the wrong pair for a word like error_handler.
        // MemMemFold folds ASCII A-Z. -w rejects a hit whose neighbor
        // is a word byte.
        use_fold = 0
        IfCondition EqualTo(Patterns.fast_icase_ok, 1) ThenBlock: { use_fold = 1 }
        IfCondition And(EqualTo(Patterns.fast_word_ok, 1),
                        EqualTo(GrepConfig.case_insensitive, 1)) ThenBlock: {
            use_fold = 1
        }
        IfCondition EqualTo(use_fold, 1) ThenBlock: {
            pat = Patterns.fast_icase_pat
            plen = Patterns.fast_icase_plen
        } ElseBlock: {
            pat = Patterns.fast_pat
            plen = Patterns.fast_plen
        }

        last_nl_pos = 0
        nl_count = 0
        scan_pos = 0
        consumed = 0
        pair_off = 0
        use_pair = 0
        // Offset 0 is already what MemMem anchors on. The extra verify
        // only pays when a later pair is rarer ("_h" in error_handler).
        IfCondition GreaterEqual(plen, 2) ThenBlock: {
            pair_off = BestPairOffset(pat, plen)
            IfCondition GreaterThan(pair_off, 0) ThenBlock: { use_pair = 1 }
        }

        WhileLoop LessThan(scan_pos, data_len) {
            IfCondition EqualTo(stop_early, 1) ThenBlock: { BreakLoop }
            remaining = Subtract(data_len, scan_pos)
            hay = Add(data, scan_pos)
            IfCondition EqualTo(use_pair, 1) ThenBlock: {
                off = FindNeedle(hay, remaining, Add(pat, pair_off), 2, use_fold)
                IfCondition LessThan(off, 0) ThenBlock: { BreakLoop }
                pair_at = Add(scan_pos, off)
                cand = Subtract(pair_at, pair_off)
                // cand before `consumed` is a match on a line already emitted.
                // A negative cand is a pair too close to the start of the buffer.
                IfCondition Or(LessThan(cand, consumed),
                               LessThan(Subtract(data_len, cand), plen)) ThenBlock: {
                    scan_pos = Add(pair_at, 1)
                    ContinueLoop
                }
                // The window is exactly one needle, so a hit is at offset 0.
                verified = 0
                IfCondition EqualTo(use_fold, 1) ThenBlock: {
                    IfCondition GreaterEqual(MemMemFold(Add(data, cand), plen, pat, plen), 0) ThenBlock: {
                        verified = 1
                    }
                } ElseBlock: {
                    IfCondition EqualTo(MemCompare(Add(data, cand), pat, plen), 0) ThenBlock: {
                        verified = 1
                    }
                }
                IfCondition EqualTo(verified, 0) ThenBlock: {
                    scan_pos = Add(pair_at, 1)
                    ContinueLoop
                }
            } ElseBlock: {
                IfCondition EqualTo(use_fold, 1) ThenBlock: {
                    off = MemMemFold(hay, remaining, pat, plen)
                } ElseBlock: {
                    off = MemMem(hay, remaining, pat, plen)
                }
                IfCondition LessThan(off, 0) ThenBlock: { BreakLoop }
                cand = Add(scan_pos, off)
            }

            // -w: a byte hit inside a longer word is not a match.
            // Resume just after this pair. Resuming at cand+1 rediscovers
            // the same pair when pair_off > 0 and never moves forward.
            // The next match's pair starts at cand+1+pair_off, which is
            // pair_at+1.
            IfCondition EqualTo(Patterns.fast_word_ok, 1) ThenBlock: {
                IfCondition EqualTo(WordEdgesOk(data, cand, plen, data_len), 0) ThenBlock: {
                    IfCondition EqualTo(use_pair, 1) ThenBlock: {
                        scan_pos = Add(pair_at, 1)
                    } ElseBlock: {
                        scan_pos = Add(cand, 1)
                    }
                    ContinueLoop
                }
            }

            // Pattern matched at `cand`. Find line boundaries.
            line_start = FindLineStart(data, cand)
            end_remaining = Subtract(data_len, cand)
            nl_off = MemChr(Add(data, cand), 10, end_remaining)
            IfCondition LessThan(nl_off, 0) ThenBlock: {
                line_end = data_len
            } ElseBlock: {
                line_end = Add(cand, nl_off)
            }
            line_len = Subtract(line_end, line_start)
            match_count = Add(match_count, 1)

            IfCondition EqualTo(is_binary, 1) ThenBlock: {
                IfCondition And(EqualTo(GrepConfig.quiet, 0),
                                And(EqualTo(GrepConfig.files_with, 0),
                                    And(EqualTo(GrepConfig.files_without, 0),
                                        EqualTo(GrepConfig.count_only, 0)))) ThenBlock: {
                    IfCondition NotEqual(label, 0) ThenBlock: {
                        OutStr("Binary file ")
                        OutStr(label)
                        OutStr(" matches\n")
                    }
                }
                stop_early = 1
            } ElseBlock: {
                IfCondition Or(EqualTo(GrepConfig.quiet, 1),
                               Or(EqualTo(GrepConfig.files_with, 1),
                                  EqualTo(GrepConfig.files_without, 1))) ThenBlock: {
                    stop_early = 1
                } ElseBlock: {
                    IfCondition EqualTo(GrepConfig.count_only, 0) ThenBlock: {
                        IfCondition And(EqualTo(show_prefix, 1), NotEqual(label, 0)) ThenBlock: {
                            OutStr(label)
                            OutByte(58)
                        }
                        IfCondition EqualTo(GrepConfig.line_numbers, 1) ThenBlock: {
                            nl_count = Add(nl_count, CountNewlines(data, last_nl_pos, line_start))
                            last_nl_pos = line_start
                            OutUInt(Add(nl_count, 1))
                            OutByte(58)
                        }
                        OutBytes(Add(data, line_start), line_len)
                        OutByte(10)
                    }
                }
            }

            // Skip past this line — no need to find more matches on it.
            IfCondition LessThan(nl_off, 0) ThenBlock: {
                BreakLoop
            }
            scan_pos = Add(line_end, 1)
            consumed = scan_pos
        }

        IfCondition EqualTo(count_invert, 1) ThenBlock: {
            total_lines = CountNewlines(data, 0, data_len)
            IfCondition GreaterThan(data_len, 0) ThenBlock: {
                IfCondition NotEqual(GetByte(data, Subtract(data_len, 1)), 10) ThenBlock: {
                    total_lines = Add(total_lines, 1)
                }
            }
            ReturnValue(Subtract(total_lines, match_count))
        }

        ReturnValue(match_count)
    }
}

// === ARG PARSING ===

Function.LoadCmdline {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(GrepConstants.ARGBUF)
        n = SystemCall(0, fd, buf, GrepConstants.ARGBUF)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, GrepConstants.ARGBUF)
            ReturnValue(0)
        }
        ReturnValue(buf)
    }
}

Function.NextArg {
    Input: buf: Address
    Input: limit: Integer
    Output: Address
    Body: {
        p = ArgPos.pos
        IfCondition GreaterEqual(p, limit) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(buf, p), 0) ThenBlock: { ReturnValue(0) }
        start = p
        WhileLoop And(LessThan(p, limit), NotEqual(GetByte(buf, p), 0)) {
            p = Add(p, 1)
        }
        ArgPos.pos = Add(p, 1)
        ReturnValue(Add(buf, start))
    }
}

Function.UsageAndExit {
    Input: code: Integer
    Body: {
        IfCondition EqualTo(code, 0) ThenBlock: {
            SystemCall(1, 1, "Usage: grep [OPTION]... PATTERN [FILE]...\n", 43)
        } ElseBlock: {
            WriteStderr("Usage: grep [OPTION]... PATTERN [FILE]...\n")
        }
        SystemCall(60, code)
    }
}

// Process one SHORT arg cluster like "-ivn" or "-e" (needing value).
// Returns 1 if successful, 0 if it needs the next arg (e.g. -e PATTERN).
Function.ApplyShortFlag {
    Input: ch: Integer
    Output: Integer
    Body: {
        // Returns 1 always for handled flags; -1 for flags that need a
        // value from the next argv slot; -2 for unknown.
        IfCondition EqualTo(ch, 105) ThenBlock: { GrepConfig.case_insensitive = 1  ReturnValue(1) }  // i
        IfCondition EqualTo(ch, 118) ThenBlock: { GrepConfig.invert = 1            ReturnValue(1) }  // v
        IfCondition EqualTo(ch, 110) ThenBlock: { GrepConfig.line_numbers = 1      ReturnValue(1) }  // n
        IfCondition EqualTo(ch, 99)  ThenBlock: { GrepConfig.count_only = 1        ReturnValue(1) }  // c
        IfCondition EqualTo(ch, 108) ThenBlock: { GrepConfig.files_with = 1        ReturnValue(1) }  // l
        IfCondition EqualTo(ch, 76)  ThenBlock: { GrepConfig.files_without = 1     ReturnValue(1) }  // L
        IfCondition EqualTo(ch, 113) ThenBlock: { GrepConfig.quiet = 1             ReturnValue(1) }  // q
        IfCondition EqualTo(ch, 115) ThenBlock: { GrepConfig.suppress_errs = 1     ReturnValue(1) }  // s
        IfCondition EqualTo(ch, 72)  ThenBlock: { GrepConfig.force_prefix = 1      ReturnValue(1) }  // H
        IfCondition EqualTo(ch, 104) ThenBlock: { GrepConfig.force_prefix = 0      ReturnValue(1) }  // h
        IfCondition EqualTo(ch, 70)  ThenBlock: { GrepConfig.fixed = 1             ReturnValue(1) }  // F
        IfCondition EqualTo(ch, 69)  ThenBlock: { ReturnValue(1) }                                   // E (extended; our default anyway)
        IfCondition EqualTo(ch, 120) ThenBlock: { GrepConfig.whole_line = 1        ReturnValue(1) }  // x
        IfCondition EqualTo(ch, 119) ThenBlock: { GrepConfig.word_match = 1        ReturnValue(1) }  // w
        IfCondition EqualTo(ch, 101) ThenBlock: { ReturnValue(-1) }                                  // e (needs value)
        ReturnValue(-2)
    }
}

SubRoutine.Main {
    InitOut()
    InitPatterns()

    cmd = LoadCmdline()
    IfCondition EqualTo(cmd, 0) ThenBlock: {
        WriteStderr("grep: could not read /proc/self/cmdline\n")
        SystemCall(60, 2)
    }

    files = Allocate(Multiply(GrepConstants.MAX_FILES, 8))
    file_count = 0
    have_pattern = 0

    ArgPos.pos = 0
    prog = NextArg(cmd, GrepConstants.ARGBUF)

    WhileLoop 1 {
        arg = NextArg(cmd, GrepConstants.ARGBUF)
        IfCondition EqualTo(arg, 0) ThenBlock: { BreakLoop }

        a0 = GetByte(arg, 0)
        a1 = GetByte(arg, 1)

        // Lone "-" = stdin, "--" ends option parsing.
        IfCondition And(EqualTo(a0, 45), EqualTo(a1, 0)) ThenBlock: {
            StoreValue(Add(files, Multiply(file_count, 8)), arg)
            file_count = Add(file_count, 1)
            ContinueLoop
        }
        IfCondition And(EqualTo(a0, 45), And(EqualTo(a1, 45), EqualTo(GetByte(arg, 2), 0))) ThenBlock: {
            // After --, remaining args are files.
            WhileLoop 1 {
                more = NextArg(cmd, GrepConstants.ARGBUF)
                IfCondition EqualTo(more, 0) ThenBlock: { BreakLoop }
                StoreValue(Add(files, Multiply(file_count, 8)), more)
                file_count = Add(file_count, 1)
            }
            BreakLoop
        }

        IfCondition And(EqualTo(a0, 45), NotEqual(a1, 0)) ThenBlock: {
            // Parse short flag cluster starting at index 1.
            ci = 1
            WhileLoop NotEqual(GetByte(arg, ci), 0) {
                fch = GetByte(arg, ci)
                r = ApplyShortFlag(fch)
                IfCondition EqualTo(r, -1) ThenBlock: {
                    // -e PATTERN: rest of this arg or next argv
                    IfCondition NotEqual(GetByte(arg, Add(ci, 1)), 0) ThenBlock: {
                        AddPattern(Add(arg, Add(ci, 1)))
                        have_pattern = 1
                    } ElseBlock: {
                        nxt = NextArg(cmd, GrepConstants.ARGBUF)
                        IfCondition EqualTo(nxt, 0) ThenBlock: {
                            WriteStderr("grep: option -e requires an argument\n")
                            SystemCall(60, 2)
                        }
                        AddPattern(nxt)
                        have_pattern = 1
                    }
                    BreakLoop
                }
                IfCondition EqualTo(r, -2) ThenBlock: {
                    WriteStderr("grep: unknown option\n")
                    SystemCall(60, 2)
                }
                ci = Add(ci, 1)
            }
            ContinueLoop
        }

        // Positional: first one is pattern (unless -e already supplied one),
        // remainder are files.
        IfCondition EqualTo(have_pattern, 0) ThenBlock: {
            AddPattern(arg)
            have_pattern = 1
        } ElseBlock: {
            StoreValue(Add(files, Multiply(file_count, 8)), arg)
            file_count = Add(file_count, 1)
        }
    }

    IfCondition EqualTo(have_pattern, 0) ThenBlock: {
        UsageAndExit(2)
    }

    // All flags finalised — now compile patterns (if regex mode).
    CompileAllPatterns()

    // Determine prefix mode: forced, or auto (multi-file -> on, single/stdin -> off).
    IfCondition EqualTo(GrepConfig.force_prefix, -1) ThenBlock: {
        IfCondition GreaterThan(file_count, 1) ThenBlock: {
            show_prefix = 1
        } ElseBlock: {
            show_prefix = 0
        }
    } ElseBlock: {
        show_prefix = GrepConfig.force_prefix
    }

    Totals.total_matches = 0
    any_error = 0

    IfCondition EqualTo(file_count, 0) ThenBlock: {
        // stdin only — label "(standard input)" only shown when forced prefix
        stdin_label = "(standard input)"
        matches = ProcessStream(0, stdin_label, show_prefix)
        Totals.total_matches = Add(Totals.total_matches, matches)

        IfCondition EqualTo(GrepConfig.count_only, 1) ThenBlock: {
            IfCondition EqualTo(show_prefix, 1) ThenBlock: {
                OutStr(stdin_label)
                OutByte(58)
            }
            OutUInt(matches)
            OutByte(10)
        }
        IfCondition And(EqualTo(GrepConfig.files_with, 1), GreaterThan(matches, 0)) ThenBlock: {
            OutStr(stdin_label)
            OutByte(10)
        }
        IfCondition And(EqualTo(GrepConfig.files_without, 1), EqualTo(matches, 0)) ThenBlock: {
            OutStr(stdin_label)
            OutByte(10)
        }
    } ElseBlock: {
        fi = 0
        WhileLoop LessThan(fi, file_count) {
            path = Dereference(Add(files, Multiply(fi, 8)))

            // "-" means stdin
            IfCondition And(EqualTo(GetByte(path, 0), 45), EqualTo(GetByte(path, 1), 0)) ThenBlock: {
                matches = ProcessStream(0, "(standard input)", show_prefix)
            } ElseBlock: {
                fd = SysOpen(path)
                IfCondition LessThan(fd, 0) ThenBlock: {
                    IfCondition EqualTo(GrepConfig.suppress_errs, 0) ThenBlock: {
                        WriteStderr("grep: ")
                        WriteStderr(path)
                        WriteStderr(": cannot open\n")
                    }
                    any_error = 1
                    matches = 0
                } ElseBlock: {
                    // Try mmap for regular files (S_ISREG: mode & 0xF000 == 0x8000).
                    // Falls back to read-loop for pipes, devices, empty files, etc.
                    statbuf = Allocate(144)
                    fstat_ok = SysFstat(fd, statbuf)
                    st_mode = Dereference(Add(statbuf, 24))
                    st_size = Dereference(Add(statbuf, 48))
                    Deallocate(statbuf, 144)

                    mmap_used = 0
                    IfCondition And(EqualTo(fstat_ok, 0),
                                    And(EqualTo(BitwiseAnd(st_mode, 61440), 32768),
                                        GreaterThan(st_size, 0))) ThenBlock: {
                        SysFadvise(fd)
                        mapped = SysMmap(st_size, fd)
                        IfCondition NotEqual(mapped, -1) ThenBlock: {
                            matches = ProcessMapped(mapped, st_size, path, show_prefix)
                            SysMunmap(mapped, st_size)
                            mmap_used = 1
                        }
                    }
                    IfCondition EqualTo(mmap_used, 0) ThenBlock: {
                        matches = ProcessStream(fd, path, show_prefix)
                    }
                    SysClose(fd)
                }
            }

            Totals.total_matches = Add(Totals.total_matches, matches)

            IfCondition EqualTo(GrepConfig.count_only, 1) ThenBlock: {
                IfCondition EqualTo(show_prefix, 1) ThenBlock: {
                    OutStr(path)
                    OutByte(58)
                }
                OutUInt(matches)
                OutByte(10)
            }
            IfCondition And(EqualTo(GrepConfig.files_with, 1), GreaterThan(matches, 0)) ThenBlock: {
                OutStr(path)
                OutByte(10)
            }
            IfCondition And(EqualTo(GrepConfig.files_without, 1), EqualTo(matches, 0)) ThenBlock: {
                OutStr(path)
                OutByte(10)
            }

            fi = Add(fi, 1)
        }
    }

    FlushOut()

    // Exit codes:
    //   2 if any file couldn't be read (error)
    //   0 if any match found
    //   1 if no match
    IfCondition EqualTo(any_error, 1) ThenBlock: { SystemCall(60, 2) }
    IfCondition GreaterThan(Totals.total_matches, 0) ThenBlock: { SystemCall(60, 0) }
    SystemCall(60, 1)
}

RunTask(Main)
