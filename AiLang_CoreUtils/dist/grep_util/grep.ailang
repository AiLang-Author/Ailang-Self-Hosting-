// grep.ailang - pattern search across files / stdin.
//
// Rewritten April 2026. Compliance-first. Regex support via
// Library.Regex_Thompson (Thompson NFA) — defaults to regex unless -F
// is given. Regex features working: . * + ? ^ $ [abc] [a-z] [^abc] |
//
// Implemented flags:
//   -e PATTERN          add a pattern (can be repeated)
//   -i                  case-insensitive
//   -v                  invert match
//   -n                  prefix lines with 1-based line number
//   -c                  print only match count per file
//   -l                  list only filenames that match
//   -L                  list only filenames with NO matches (GNU ext)
//   -q                  silent; exit code only
//   -s                  suppress file-error diagnostics
//   -H                  always prefix filename
//   -h                  never prefix filename
//   -F                  fixed string (disable regex)
//   -E                  extended regex (accepted; default anyway)
//   -x                  whole-line match only
//   -w                  whole-word match only
//   -                   read stdin
//
// Exit: 0 = at least one match, 1 = no match, 2 = error.
//
// Known gaps vs GNU:
//   * no -r / -R recursion
//   * no -A / -B / -C context lines
//   * no --include/--exclude
//   * no --color
//   * no \( \) grouping, \{m,n\} repetition, backreferences

LibraryImport.Arena
LibraryImport.Regex_Thompson

FixedPool.GrepConfig {
    "case_insensitive": Initialize=0
    "invert":           Initialize=0
    "line_numbers":     Initialize=0
    "count_only":       Initialize=0
    "files_with":       Initialize=0   // -l
    "files_without":    Initialize=0   // -L
    "quiet":            Initialize=0
    "suppress_errs":    Initialize=0
    "force_prefix":     Initialize=-1  // -H=1, -h=0, default -1 (auto)
    "whole_line":       Initialize=0   // -x
    "word_match":       Initialize=0   // -w
    "fixed":            Initialize=0   // -F (1 = treat patterns as literal)
}

FixedPool.GrepConstants {
    "BUFFER_SIZE":    Initialize=1048576   // 1 MiB read buffer — fewer read() syscalls
    "LINE_MAX":       Initialize=1048576   // 1 MiB max line
    "MAX_PATTERNS":   Initialize=256
    "MAX_FILES":      Initialize=4096
    "ARGBUF":         Initialize=16384
    "OUT_BUF":        Initialize=262144
}

FixedPool.Patterns {
    "ptrs":          Initialize=0   // array of Address (literal)
    "lens":          Initialize=0   // array of Integer (length each)
    "count":         Initialize=0
    "lc_ptrs":       Initialize=0   // lowercased copies for -i (literal path)
    "longest":       Initialize=0
    "regex":         Initialize=0   // array of Regex handles (or 0 = literal)
    // bc_tables removed: SearchBoyerMoore uses MemChr, not BM skip tables
    "rx_prefix":     Initialize=0   // array of Address: literal prefix extracted from regex (or 0)
    "rx_prefix_len": Initialize=0   // array of Integer: prefix length (<2 means unused)
    // rx_prefix_bc removed: SearchBoyerMoore uses MemChr, not BM skip tables
    "dfa_ok":        Initialize=0   // DFA available? (1=yes). Only set for single-pattern grep
    "strategy":      Initialize=0   // array of Integer: per-pattern dispatch strategy id (see STRATEGY.*)

    // Batched fast-path hoists for the single-pattern LITERAL_BM case.
    // When set, ProcessStream inlines the match into its main loop
    // (no MemoryCopy into line_buf, no LineMatches dispatch, no
    // Match_LiteralBM call). Saves ~3 function-call overheads per
    // line plus the per-line line-buffer copy.
    "fast_literal_ok":   Initialize=0
    "fast_pat":          Initialize=0   // pointer to pattern bytes
    "fast_plen":         Initialize=0   // pattern length
    "fast_first_byte":   Initialize=0   // GetByte(pat, 0)
    "fast_rare_byte":    Initialize=0   // rarest byte in the pattern (for MemChr anchor)
    "fast_rare_offset":  Initialize=0   // offset of that byte within the pattern
    "fast_icase_ok":     Initialize=0   // single LITERAL_INSENSITIVE pattern
    "fast_icase_pat":    Initialize=0   // lowercased pattern
    "fast_icase_plen":   Initialize=0
    "fast_icase_rare_lo":Initialize=0   // lowercase rare byte
    "fast_icase_rare_up":Initialize=0   // uppercase rare byte (or same if non-alpha)
    "fast_icase_rare_off":Initialize=0
    "fast_word_ok":      Initialize=0   // single literal -w, no newline in the pattern

    // Single-regex mmap scan. The line walker calls the Thompson
    // interpreter on every line; these modes MemMem a required literal
    // across the whole mapping and only then decide the line.
    //   1 anchor   ^literal or ^literal$
    //   2 dotstar  literal .* literal
    //   3 alt      literal|literal|...
    //   4 prefix   any other regex with a literal prefix of 2+ bytes
    //              (the line is still checked with the regex engine)
    //   5 class    literal + one simple [abc] class + literal
    "fast_rx_ok":      Initialize=0
    "fast_rx_mode":    Initialize=0
    "fast_rx_fold":    Initialize=0   // 1 = MemMemFold (pattern was lowercased for -i)
    "fast_rx_end":     Initialize=0   // mode 1: trailing $ so the whole line must equal the literal
    "fast_rx_drive":   Initialize=0   // mode 2: 0 = scan the left literal, 1 = scan the longer right one
    "fast_rx_a":       Initialize=0
    "fast_rx_a_len":   Initialize=0
    "fast_rx_b":       Initialize=0
    "fast_rx_b_len":   Initialize=0
    "fast_rx_class":   Initialize=0   // mode 5: bytes accepted by the one class
    "fast_rx_class_n": Initialize=0
    "fast_rx_alts":    Initialize=0   // mode 3: array of needle addresses
    "fast_rx_alt_lens":Initialize=0
    "fast_rx_alt_n":   Initialize=0
}

// Per-pattern dispatch strategy, computed once by CompileAllPatterns.
// LineMatches dispatches on this via Branch — constant-time per-line.
// Order matters for the Branch fast path (literal-integer cases).
FixedPool.STRATEGY {
    "EMPTY":              Initialize=0    // plen == 0 — matches every line
    "WHOLE_LINE":         Initialize=1    // -x
    "WORD_MATCH":         Initialize=2    // -w
    "REGEX_PREFIX_BM":    Initialize=3    // regex + literal prefix >= 2 bytes
    "REGEX_DFA":          Initialize=4    // regex + no prefix + DFA compiled
    "REGEX_NFA":          Initialize=5    // regex + no prefix + NFA fallback
    "REGEX_INSENSITIVE":  Initialize=6    // regex with -i (needs lowercased scratch)
    "LITERAL_BM":         Initialize=7    // plain literal, case-sensitive
    "LITERAL_INSENSITIVE":Initialize=8    // plain literal with -i
}

FixedPool.OutBuffer {
    "buf":  Initialize=0
    "pos":  Initialize=0
}

// Reusable scratch buffers for the regex path. Allocated once at
// startup (InitOut) and reused for every line, so the hot loop
// doesn't hit Arena per-line.
FixedPool.Scratch {
    "rx":    Initialize=0   // NUL-terminated copy of current line
    "rx_lc": Initialize=0   // lowercased copy of same (for -i)
    "num":   Initialize=0   // 24-byte digit buffer for OutUInt
    "lc_tab":Initialize=0   // 256-byte to-lowercase lookup table
    "ready": Initialize=0
}

FixedPool.Totals { "total_matches": Initialize=0 }

FixedPool.ArgPos { "pos": Initialize=0 }

// AUTO-GENERATED Unicode tables — regenerate with:
//   cd unicode && python3 gen_unicode_tables.py
FixedPool.UnicodeData {
    "word_starts":     Initialize=0
    "word_ends":       Initialize=0
    "word_count":      Initialize=817
    "fold_starts":     Initialize=0
    "fold_ends":       Initialize=0
    "fold_deltas":     Initialize=0
    "fold_count":      Initialize=721
    "ready":           Initialize=0
    "we_adv":          Initialize=0
}

// === SYSCALL WRAPPERS ===

Function.SysOpen {
    Input: filename: Address
    Output: Integer
    Body: { ReturnValue(SystemCall(2, filename, 0, 0)) }
}

Function.SysRead {
    Input: fd: Integer
    Input: buffer: Address
    Input: count: Integer
    Output: Integer
    Body: { ReturnValue(SystemCall(0, fd, buffer, count)) }
}

Function.SysClose {
    Input: fd: Integer
    Body: { SystemCall(3, fd) }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

// fstat(fd, statbuf) — fills 144-byte struct stat on x86_64 Linux.
// st_mode at offset 24 (4 bytes), st_size at offset 48 (8 bytes).
Function.SysFstat {
    Input: fd: Integer
    Input: statbuf: Address
    Output: Integer
    Body: { ReturnValue(SystemCall(5, fd, statbuf)) }
}

// mmap(addr=0, length, prot=PROT_READ=1, flags=MAP_PRIVATE=2, fd, offset=0)
Function.SysMmap {
    Input: length: Integer
    Input: fd: Integer
    Output: Address
    Body: { ReturnValue(SystemCall(9, 0, length, 1, 2, fd, 0)) }
}

Function.SysMunmap {
    Input: addr: Address
    Input: length: Integer
    Body: { SystemCall(11, addr, length) }
}

// fadvise64(fd, 0, 0, POSIX_FADV_SEQUENTIAL=2) — hint sequential read
Function.SysFadvise {
    Input: fd: Integer
    Body: { SystemCall(221, fd, 0, 0, 2) }
}

// === OUTPUT BUFFERING ===

Function.InitOut {
    Body: {
        OutBuffer.buf = Allocate(GrepConstants.OUT_BUF)
        OutBuffer.pos = 0
        Scratch.rx    = Allocate(Add(GrepConstants.LINE_MAX, 1))
        Scratch.rx_lc = Allocate(Add(GrepConstants.LINE_MAX, 1))
        Scratch.num   = Allocate(24)
        // English only. 256-byte lowercase LUT: A-Z (65-90) map to
        // a-z, every other byte stays itself. Same as GNU -i in the C
        // locale. Bytes >= 0x80 are not folded.
        Scratch.lc_tab = Allocate(256)
        lci = 0
        WhileLoop LessThan(lci, 256) {
            IfCondition And(GreaterEqual(lci, 65), LessEqual(lci, 90)) ThenBlock: {
                SetByte(Scratch.lc_tab, lci, Add(lci, 32))
            } ElseBlock: {
                SetByte(Scratch.lc_tab, lci, lci)
            }
            lci = Add(lci, 1)
        }
        Scratch.ready = 1
        UnicodeInit()
    }
}

Function.FlushOut {
    Body: {
        IfCondition GreaterThan(OutBuffer.pos, 0) ThenBlock: {
            SystemCall(1, 1, OutBuffer.buf, OutBuffer.pos)
            OutBuffer.pos = 0
        }
    }
}

Function.OutBytes {
    Input: data: Address
    Input: len: Integer
    Body: {
        IfCondition LessEqual(len, 0) ThenBlock: {
            // nothing
        } ElseBlock: {
            space = Subtract(GrepConstants.OUT_BUF, OutBuffer.pos)
            IfCondition LessThan(space, len) ThenBlock: { FlushOut() }
            MemoryCopy(Add(OutBuffer.buf, OutBuffer.pos), data, len)
            OutBuffer.pos = Add(OutBuffer.pos, len)
        }
    }
}

Function.OutByte {
    Input: b: Integer
    Body: {
        IfCondition GreaterEqual(OutBuffer.pos, GrepConstants.OUT_BUF) ThenBlock: {
            FlushOut()
        }
        SetByte(OutBuffer.buf, OutBuffer.pos, b)
        OutBuffer.pos = Add(OutBuffer.pos, 1)
    }
}

Function.OutStr {
    Input: str: Address
    Body: {
        OutBytes(str, StringLength(str))
    }
}

Function.OutUInt {
    Input: v: Integer
    Body: {
        IfCondition EqualTo(v, 0) ThenBlock: {
            OutByte(48)
        } ElseBlock: {
            digits = Scratch.num
            n = 0
            val = v
            WhileLoop GreaterThan(val, 0) {
                SetByte(digits, n, Add(48, Modulo(val, 10)))
                val = Divide(val, 10)
                n = Add(n, 1)
            }
            i = Subtract(n, 1)
            WhileLoop GreaterEqual(i, 0) {
                OutByte(GetByte(digits, i))
                i = Subtract(i, 1)
            }
        }
    }
}



