// Test the generated Unicode tables: word chars, case fold, UTF-8 codec.
LibraryImport.Arena

SubRoutine.Main {
    Arena_Init()
    pass_count = 0
    fail_count = 0

    PrintMessage("============================================\n")
    PrintMessage("  Unicode Tables Test\n")
    PrintMessage("============================================\n\n")

    UnicodeInit()

    // =====================================================================
    // TEST 1: ASCII word chars
    // =====================================================================
    PrintMessage("[TEST 1] ASCII word characters...\n")
    t1_ok = 1
    // Digits 0-9 (48-57)
    IfCondition EqualTo(UnicodeIsWord(48), 0)  ThenBlock: { t1_ok = 0 }
    IfCondition EqualTo(UnicodeIsWord(57), 0)  ThenBlock: { t1_ok = 0 }
    // Letters A-Z (65-90)
    IfCondition EqualTo(UnicodeIsWord(65), 0)  ThenBlock: { t1_ok = 0 }
    IfCondition EqualTo(UnicodeIsWord(90), 0)  ThenBlock: { t1_ok = 0 }
    // Letters a-z (97-122)
    IfCondition EqualTo(UnicodeIsWord(97), 0)  ThenBlock: { t1_ok = 0 }
    IfCondition EqualTo(UnicodeIsWord(122), 0) ThenBlock: { t1_ok = 0 }
    // Underscore (95)
    IfCondition EqualTo(UnicodeIsWord(95), 0)  ThenBlock: { t1_ok = 0 }
    // Non-word: space(32), !(33), .(46), @(64), [(91), {(123)
    IfCondition EqualTo(UnicodeIsWord(32), 1)  ThenBlock: { t1_ok = 0 }
    IfCondition EqualTo(UnicodeIsWord(33), 1)  ThenBlock: { t1_ok = 0 }
    IfCondition EqualTo(UnicodeIsWord(46), 1)  ThenBlock: { t1_ok = 0 }
    IfCondition EqualTo(UnicodeIsWord(64), 1)  ThenBlock: { t1_ok = 0 }
    IfCondition EqualTo(UnicodeIsWord(91), 1)  ThenBlock: { t1_ok = 0 }
    IfCondition EqualTo(UnicodeIsWord(123), 1) ThenBlock: { t1_ok = 0 }
    IfCondition EqualTo(t1_ok, 1) ThenBlock: {
        PrintMessage("[PASS]\n")
        pass_count = Add(pass_count, 1)
    } ElseBlock: {
        PrintMessage("[FAIL]\n")
        fail_count = Add(fail_count, 1)
    }

    // =====================================================================
    // TEST 2: Unicode word chars beyond ASCII
    // =====================================================================
    PrintMessage("\n[TEST 2] Unicode word characters...\n")
    t2_ok = 1
    // U+00E9 LATIN SMALL LETTER E WITH ACUTE (Alphabetic)
    IfCondition EqualTo(UnicodeIsWord(233), 0) ThenBlock: { t2_ok = 0 }
    // U+00DF LATIN SMALL LETTER SHARP S (Alphabetic)
    IfCondition EqualTo(UnicodeIsWord(223), 0) ThenBlock: { t2_ok = 0 }
    // U+0410 CYRILLIC CAPITAL LETTER A (Alphabetic)
    IfCondition EqualTo(UnicodeIsWord(1040), 0) ThenBlock: { t2_ok = 0 }
    // U+4E00 CJK UNIFIED IDEOGRAPH (Lo)
    IfCondition EqualTo(UnicodeIsWord(19968), 0) ThenBlock: { t2_ok = 0 }
    // U+0660 ARABIC-INDIC DIGIT ZERO (Nd)
    IfCondition EqualTo(UnicodeIsWord(1632), 0) ThenBlock: { t2_ok = 0 }
    // U+0300 COMBINING GRAVE ACCENT (Mn - Mark)
    IfCondition EqualTo(UnicodeIsWord(768), 0) ThenBlock: { t2_ok = 0 }
    // U+200D ZERO WIDTH JOINER
    IfCondition EqualTo(UnicodeIsWord(8205), 0) ThenBlock: { t2_ok = 0 }
    // U+00A0 NO-BREAK SPACE — NOT a word char
    IfCondition EqualTo(UnicodeIsWord(160), 1) ThenBlock: { t2_ok = 0 }
    // U+2019 RIGHT SINGLE QUOTATION MARK — NOT a word char
    IfCondition EqualTo(UnicodeIsWord(8217), 1) ThenBlock: { t2_ok = 0 }
    IfCondition EqualTo(t2_ok, 1) ThenBlock: {
        PrintMessage("[PASS]\n")
        pass_count = Add(pass_count, 1)
    } ElseBlock: {
        PrintMessage("[FAIL]\n")
        fail_count = Add(fail_count, 1)
    }

    // =====================================================================
    // TEST 3: ASCII case fold
    // =====================================================================
    PrintMessage("\n[TEST 3] ASCII case folding...\n")
    t3_ok = 1
    // A(65) -> a(97)
    IfCondition NotEqual(UnicodeFold(65), 97) ThenBlock: { t3_ok = 0 }
    // Z(90) -> z(122)
    IfCondition NotEqual(UnicodeFold(90), 122) ThenBlock: { t3_ok = 0 }
    // a(97) -> a(97) (no change)
    IfCondition NotEqual(UnicodeFold(97), 97) ThenBlock: { t3_ok = 0 }
    // 0(48) -> 0(48) (no change)
    IfCondition NotEqual(UnicodeFold(48), 48) ThenBlock: { t3_ok = 0 }
    IfCondition EqualTo(t3_ok, 1) ThenBlock: {
        PrintMessage("[PASS]\n")
        pass_count = Add(pass_count, 1)
    } ElseBlock: {
        PrintMessage("[FAIL]\n")
        fail_count = Add(fail_count, 1)
    }

    // =====================================================================
    // TEST 4: Unicode case fold
    // =====================================================================
    PrintMessage("\n[TEST 4] Unicode case folding...\n")
    t4_ok = 1
    // U+00C0 LATIN CAPITAL LETTER A WITH GRAVE -> U+00E0
    IfCondition NotEqual(UnicodeFold(192), 224) ThenBlock: { t4_ok = 0 }
    // U+0410 CYRILLIC CAPITAL A -> U+0430
    IfCondition NotEqual(UnicodeFold(1040), 1072) ThenBlock: { t4_ok = 0 }
    // U+00B5 MICRO SIGN (181) -> U+03BC GREEK SMALL MU (956)
    IfCondition NotEqual(UnicodeFold(181), 956) ThenBlock: { t4_ok = 0 }
    // U+1E9E LATIN CAPITAL LETTER SHARP S -> U+00DF
    IfCondition NotEqual(UnicodeFold(7838), 223) ThenBlock: { t4_ok = 0 }
    IfCondition EqualTo(t4_ok, 1) ThenBlock: {
        PrintMessage("[PASS]\n")
        pass_count = Add(pass_count, 1)
    } ElseBlock: {
        PrintMessage("[FAIL]\n")
        fail_count = Add(fail_count, 1)
    }

    // =====================================================================
    // TEST 5: UTF-8 decode ASCII
    // =====================================================================
    PrintMessage("\n[TEST 5] UTF-8 decode ASCII...\n")
    t5_ok = 1
    adv = Allocate(8)
    buf5 = "Hello"
    cp5 = UTF8Decode(buf5, 0, 5, adv)
    IfCondition NotEqual(cp5, 72) ThenBlock: { t5_ok = 0 }
    IfCondition NotEqual(Dereference(adv), 1) ThenBlock: { t5_ok = 0 }
    cp5b = UTF8Decode(buf5, 4, 5, adv)
    IfCondition NotEqual(cp5b, 111) ThenBlock: { t5_ok = 0 }
    IfCondition EqualTo(t5_ok, 1) ThenBlock: {
        PrintMessage("[PASS]\n")
        pass_count = Add(pass_count, 1)
    } ElseBlock: {
        PrintMessage("[FAIL]\n")
        fail_count = Add(fail_count, 1)
    }

    // =====================================================================
    // TEST 6: UTF-8 decode 2-byte (U+00E9 = é = 0xC3 0xA9)
    // =====================================================================
    PrintMessage("\n[TEST 6] UTF-8 decode 2-byte...\n")
    t6_ok = 1
    buf6 = Allocate(3)
    SetByte(buf6, 0, 195)
    SetByte(buf6, 1, 169)
    SetByte(buf6, 2, 0)
    cp6 = UTF8Decode(buf6, 0, 2, adv)
    IfCondition NotEqual(cp6, 233) ThenBlock: {
        PrintMessage("  got cp=")
        PrintNumber(cp6)
        PrintMessage(" expected 233\n")
        t6_ok = 0
    }
    IfCondition NotEqual(Dereference(adv), 2) ThenBlock: { t6_ok = 0 }
    Deallocate(buf6, 3)
    IfCondition EqualTo(t6_ok, 1) ThenBlock: {
        PrintMessage("[PASS]\n")
        pass_count = Add(pass_count, 1)
    } ElseBlock: {
        PrintMessage("[FAIL]\n")
        fail_count = Add(fail_count, 1)
    }

    // =====================================================================
    // TEST 7: UTF-8 decode 3-byte (U+4E00 = 一 = 0xE4 0xB8 0x80)
    // =====================================================================
    PrintMessage("\n[TEST 7] UTF-8 decode 3-byte...\n")
    t7_ok = 1
    buf7 = Allocate(4)
    SetByte(buf7, 0, 228)
    SetByte(buf7, 1, 184)
    SetByte(buf7, 2, 128)
    SetByte(buf7, 3, 0)
    cp7 = UTF8Decode(buf7, 0, 3, adv)
    IfCondition NotEqual(cp7, 19968) ThenBlock: {
        PrintMessage("  got cp=")
        PrintNumber(cp7)
        PrintMessage(" expected 19968\n")
        t7_ok = 0
    }
    IfCondition NotEqual(Dereference(adv), 3) ThenBlock: { t7_ok = 0 }
    Deallocate(buf7, 4)
    IfCondition EqualTo(t7_ok, 1) ThenBlock: {
        PrintMessage("[PASS]\n")
        pass_count = Add(pass_count, 1)
    } ElseBlock: {
        PrintMessage("[FAIL]\n")
        fail_count = Add(fail_count, 1)
    }

    // =====================================================================
    // TEST 8: UTF-8 decode 4-byte (U+1F600 = 😀 = 0xF0 0x9F 0x98 0x80)
    // =====================================================================
    PrintMessage("\n[TEST 8] UTF-8 decode 4-byte...\n")
    t8_ok = 1
    buf8 = Allocate(5)
    SetByte(buf8, 0, 240)
    SetByte(buf8, 1, 159)
    SetByte(buf8, 2, 152)
    SetByte(buf8, 3, 128)
    SetByte(buf8, 4, 0)
    cp8 = UTF8Decode(buf8, 0, 4, adv)
    IfCondition NotEqual(cp8, 128512) ThenBlock: {
        PrintMessage("  got cp=")
        PrintNumber(cp8)
        PrintMessage(" expected 128512\n")
        t8_ok = 0
    }
    IfCondition NotEqual(Dereference(adv), 4) ThenBlock: { t8_ok = 0 }
    Deallocate(buf8, 5)
    IfCondition EqualTo(t8_ok, 1) ThenBlock: {
        PrintMessage("[PASS]\n")
        pass_count = Add(pass_count, 1)
    } ElseBlock: {
        PrintMessage("[FAIL]\n")
        fail_count = Add(fail_count, 1)
    }

    // =====================================================================
    // TEST 9: UTF-8 encode round-trip
    // =====================================================================
    PrintMessage("\n[TEST 9] UTF-8 encode round-trip...\n")
    t9_ok = 1
    enc_buf = Allocate(8)

    // ASCII: H (72)
    n9 = UTF8Encode(enc_buf, 0, 72)
    IfCondition NotEqual(n9, 1) ThenBlock: { t9_ok = 0 }
    IfCondition NotEqual(GetByte(enc_buf, 0), 72) ThenBlock: { t9_ok = 0 }

    // 2-byte: é (233)
    n9 = UTF8Encode(enc_buf, 0, 233)
    IfCondition NotEqual(n9, 2) ThenBlock: { t9_ok = 0 }
    rt9 = UTF8Decode(enc_buf, 0, 2, adv)
    IfCondition NotEqual(rt9, 233) ThenBlock: { t9_ok = 0 }

    // 3-byte: 一 (19968)
    n9 = UTF8Encode(enc_buf, 0, 19968)
    IfCondition NotEqual(n9, 3) ThenBlock: { t9_ok = 0 }
    rt9 = UTF8Decode(enc_buf, 0, 3, adv)
    IfCondition NotEqual(rt9, 19968) ThenBlock: { t9_ok = 0 }

    // 4-byte: 😀 (128512)
    n9 = UTF8Encode(enc_buf, 0, 128512)
    IfCondition NotEqual(n9, 4) ThenBlock: { t9_ok = 0 }
    rt9 = UTF8Decode(enc_buf, 0, 4, adv)
    IfCondition NotEqual(rt9, 128512) ThenBlock: {
        PrintMessage("  4-byte round-trip: got ")
        PrintNumber(rt9)
        PrintMessage("\n")
        t9_ok = 0
    }

    Deallocate(enc_buf, 8)
    IfCondition EqualTo(t9_ok, 1) ThenBlock: {
        PrintMessage("[PASS]\n")
        pass_count = Add(pass_count, 1)
    } ElseBlock: {
        PrintMessage("[FAIL]\n")
        fail_count = Add(fail_count, 1)
    }

    // =====================================================================
    // TEST 10: UTF-8 invalid sequences
    // =====================================================================
    PrintMessage("\n[TEST 10] UTF-8 invalid sequences...\n")
    t10_ok = 1
    bad = Allocate(4)
    // Bare continuation byte (0x80)
    SetByte(bad, 0, 128)
    cp10 = UTF8Decode(bad, 0, 1, adv)
    IfCondition NotEqual(cp10, 65533) ThenBlock: { t10_ok = 0 }
    // Truncated 2-byte: 0xC3 alone
    SetByte(bad, 0, 195)
    cp10 = UTF8Decode(bad, 0, 1, adv)
    IfCondition NotEqual(cp10, 65533) ThenBlock: { t10_ok = 0 }
    // Overlong 2-byte: 0xC0 0x80 (should be rejected: b0 < 0xC2)
    SetByte(bad, 0, 192)
    SetByte(bad, 1, 128)
    cp10 = UTF8Decode(bad, 0, 2, adv)
    IfCondition NotEqual(cp10, 65533) ThenBlock: { t10_ok = 0 }
    Deallocate(bad, 4)
    IfCondition EqualTo(t10_ok, 1) ThenBlock: {
        PrintMessage("[PASS]\n")
        pass_count = Add(pass_count, 1)
    } ElseBlock: {
        PrintMessage("[FAIL]\n")
        fail_count = Add(fail_count, 1)
    }

    Deallocate(adv, 8)

    // =====================================================================
    // RESULTS
    // =====================================================================
    PrintMessage("\n============================================\n")
    PrintMessage("  Results: ")
    PrintNumber(pass_count)
    PrintMessage(" passed, ")
    PrintNumber(fail_count)
    PrintMessage(" failed\n")
    PrintMessage("============================================\n")

    IfCondition GreaterThan(fail_count, 0) ThenBlock: {
        HaltProgram
    }
}

RunTask(Main)
