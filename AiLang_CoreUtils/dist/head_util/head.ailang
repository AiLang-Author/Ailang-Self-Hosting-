// head.ailang - Output first part of files
// Default: first 10 lines
// Supports: -n (line count), -c (byte count), -q (quiet/no headers)

// Allocate/Deallocate now live in Library.Arena (slab allocator) — must
// be imported explicitly or linking fails.
LibraryImport.Arena

FixedPool.HeadConfig {
    "line_count": Initialize=10
    "byte_count": Initialize=0
    "quiet_mode": Initialize=0
    "use_bytes": Initialize=0
    "elide": Initialize=0
    "eol": Initialize=10
}

FixedPool.HeadConstants {
    "BUFFER_SIZE": Initialize=32768
    "OUT_SIZE": Initialize=262144
    "MAX_FILES": Initialize=1000
    "args_size": Initialize=0
}

FixedPool.HeadOut {
    "buf": Initialize=0
    "pos": Initialize=0
}

// === SYSCALL WRAPPERS ===

Function.SysOpen {
    Input: filename: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, filename, 0, 0)
        ReturnValue(fd)
    }
}

Function.SysRead {
    Input: fd: Integer
    Input: buffer: Address
    Input: count: Integer
    Output: Integer
    Body: {
        bytes = SystemCall(0, fd, buffer, count)
        ReturnValue(bytes)
    }
}

Function.SysClose {
    Input: fd: Integer
    Body: {
        SystemCall(3, fd)
    }
}

Function.SysWrite {
    Input: fd: Integer
    Input: buffer: Address
    Input: count: Integer
    Body: {
        SystemCall(1, fd, buffer, count)
    }
}

// === OUTPUT FUNCTIONS ===

Function.WriteStdout {
    Input: buffer: Address
    Input: count: Integer
    Body: {
        rc = SystemCall(1, 1, buffer, count)
        IfCondition LessThan(rc, count) ThenBlock: {
            msg = "head: error writing 'standard output'\n"
            nmsg = StringLength(msg)
            SystemCall(1, 2, msg, nmsg)
            SystemCall(60, 1)
        }
    }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SysWrite(2, str, len)
    }
}

// Convenience twin of WriteStderr for fd 1 — takes a NUL-terminated
// string and computes its length. Added when it was found that the
// multi-file header block was mis-routing the "==> <file> <==" lines
// to stderr, which broke diff-based conformance tests against GNU head.
Function.WriteStdoutStr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SysWrite(1, str, len)
    }
}

Function.HeadFlush {
    Body: {
        IfCondition GreaterThan(HeadOut.pos, 0) ThenBlock: {
            rc = SystemCall(1, 1, HeadOut.buf, HeadOut.pos)
            IfCondition LessThan(rc, HeadOut.pos) ThenBlock: {
                msg = "head: error writing 'standard output'\n"
                nmsg = StringLength(msg)
                SystemCall(1, 2, msg, nmsg)
                SystemCall(60, 1)
            }
            HeadOut.pos = 0
        }
    }
}

// Copy n bytes into the line buffer. A span bigger than OUT_SIZE is
// written on its own so a long line cannot overflow the buffer.
Function.HeadEmit {
    Input: src: Address
    Input: n: Integer
    Body: {
        IfCondition LessEqual(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        space = Subtract(HeadConstants.OUT_SIZE, HeadOut.pos)
        IfCondition GreaterThan(n, space) ThenBlock: {
            HeadFlush()
        }
        IfCondition GreaterThan(n, HeadConstants.OUT_SIZE) ThenBlock: {
            rc = SystemCall(1, 1, src, n)
            IfCondition LessThan(rc, n) ThenBlock: {
                msg = "head: error writing 'standard output'\n"
                nmsg = StringLength(msg)
                SystemCall(1, 2, msg, nmsg)
                SystemCall(60, 1)
            }
        } ElseBlock: {
            dest = Add(HeadOut.buf, HeadOut.pos)
            MemoryCopy(dest, src, n)
            HeadOut.pos = Add(HeadOut.pos, n)
        }
    }
}

// === CORE HEAD FUNCTIONS ===

// Head by line count (default mode)
Function.HeadLines {
    Input: fd: Integer
    Input: max_lines: Integer
    Body: {
        IfCondition LessEqual(max_lines, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(HeadConstants.BUFFER_SIZE)
        HeadOut.buf = Allocate(HeadConstants.OUT_SIZE)
        HeadOut.pos = 0
        lines_output = 0
        keep_reading = 1
        extra = 0
        
        WhileLoop EqualTo(keep_reading, 1) {
            bytes_read = SysRead(fd, buffer, HeadConstants.BUFFER_SIZE)
            
            IfCondition LessEqual(bytes_read, 0) ThenBlock: {
                keep_reading = 0
            } ElseBlock: {
                // MemChr splits lines. A line that crosses a read is written
                // in pieces and counted when its newline arrives.
                pos = 0
                WhileLoop And(LessThan(pos, bytes_read), LessThan(lines_output, max_lines)) {
                    remain = Subtract(bytes_read, pos)
                    search = Add(buffer, pos)
                    nl = MemChr(search, HeadConfig.eol, remain)
                    IfCondition LessThan(nl, 0) ThenBlock: {
                        HeadEmit(search, remain)
                        pos = bytes_read
                    } ElseBlock: {
                        line_len = Add(nl, 1)
                        HeadEmit(search, line_len)
                        lines_output = Add(lines_output, 1)
                        pos = Add(pos, line_len)
                    }
                }
                IfCondition GreaterEqual(lines_output, max_lines) ThenBlock: {
                    extra = Subtract(bytes_read, pos)
                    keep_reading = 0
                }
            }
        }

        // The read consumed a whole buffer. Put the fd back on the first
        // byte that was not part of the lines we kept, so a following cat
        // sees the rest of the file.
        IfCondition GreaterThan(extra, 0) ThenBlock: {
            back = Subtract(0, extra)
            SystemCall(8, fd, back, 1)
        }
        
        HeadFlush()
        Deallocate(HeadOut.buf, HeadConstants.OUT_SIZE)
        Deallocate(buffer, HeadConstants.BUFFER_SIZE)
    }
}

// Head by byte count (-c flag)
Function.HeadBytes {
    Input: fd: Integer
    Input: max_bytes: Integer
    Body: {
        buffer = Allocate(HeadConstants.BUFFER_SIZE)
        bytes_output = 0
        keep_reading = 1
        limit = max_bytes
        IfCondition EqualTo(HeadConfig.elide, 1) ThenBlock: {
            // A small elide holds the tail in a window so a lying st_size
            // (procfs, sysfs) and a fd already seeked forward both stay correct.
            // A huge count must not be allocated; use the distance still ahead.
            IfCondition And(GreaterThan(max_bytes, 0), LessEqual(max_bytes, 1048576)) ThenBlock: {
                HeadElideStream(fd, max_bytes)
                keep_reading = 0
            } ElseBlock: {
                IfCondition EqualTo(max_bytes, 0) ThenBlock: {
                    limit = 9223372036854775807
                } ElseBlock: {
                    cur = SystemCall(8, fd, 0, 1)
                    endpos = SystemCall(8, fd, 0, 2)
                    IfCondition And(GreaterEqual(cur, 0), GreaterEqual(endpos, 0)) ThenBlock: {
                        remain = Subtract(endpos, cur)
                        limit = Subtract(remain, max_bytes)
                        IfCondition LessThan(limit, 0) ThenBlock: {
                            limit = 0
                        }
                        SystemCall(8, fd, cur, 0)
                    } ElseBlock: {
                        limit = 0
                        keep_reading = 0
                    }
                }
            }
        }
        
        WhileLoop EqualTo(keep_reading, 1) {
            bytes_remaining = Subtract(limit, bytes_output)
            
            IfCondition LessEqual(bytes_remaining, 0) ThenBlock: {
                keep_reading = 0
                BreakLoop
            }
            
            // Read only what we need
            read_size = HeadConstants.BUFFER_SIZE
            IfCondition LessThan(bytes_remaining, read_size) ThenBlock: {
                read_size = bytes_remaining
            }
            
            bytes_read = SysRead(fd, buffer, read_size)
            
            IfCondition LessEqual(bytes_read, 0) ThenBlock: {
                keep_reading = 0
            } ElseBlock: {
                WriteStdout(buffer, bytes_read)
                bytes_output = Add(bytes_output, bytes_read)
            }
        }
        
        Deallocate(buffer, HeadConstants.BUFFER_SIZE)
    }
}

// Process stdin
Function.HeadStdin {
    Body: {
        IfCondition EqualTo(HeadConfig.use_bytes, 1) ThenBlock: {
            HeadBytes(0, HeadConfig.byte_count)
        } ElseBlock: {
            IfCondition EqualTo(HeadConfig.elide, 1) ThenBlock: {
                HeadElideLines(0, HeadConfig.line_count)
            } ElseBlock: {
                HeadLines(0, HeadConfig.line_count)
            }
        }
    }
}

// Process a single file
Function.HeadFile {
    Input: filename: Address
    Output: Integer
    Body: {
        fd = SysOpen(filename)
        
        IfCondition LessThan(fd, 0) ThenBlock: {
            WriteStderr("head: cannot open '")
            WriteStderr(filename)
            WriteStderr("' for reading: No such file or directory\n")
            ReturnValue(1)
        }
        
        IfCondition EqualTo(HeadConfig.use_bytes, 1) ThenBlock: {
            HeadBytes(fd, HeadConfig.byte_count)
        } ElseBlock: {
            IfCondition EqualTo(HeadConfig.elide, 1) ThenBlock: {
                HeadElideLines(fd, HeadConfig.line_count)
            } ElseBlock: {
                HeadLines(fd, HeadConfig.line_count)
            }
        }
        
        SysClose(fd)
        ReturnValue(0)
    }
}

// === FLAG PARSING ===

Function.IsFlag {
    Input: str: Address
    Output: Integer
    Body: {
        first = RDMEM_8(str, 0)
        second = RDMEM_8(str, 1)
        ReturnValue(And(EqualTo(first, 45), NotEqual(second, 0)))
    }
}

Function.StrEquals {
    Input: str1: Address
    Input: str2: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop 1 {
            ch1 = RDMEM_8(str1, i)
            ch2 = RDMEM_8(str2, i)
            
            IfCondition NotEqual(ch1, ch2) ThenBlock: {
                ReturnValue(0)
            }
            
            IfCondition EqualTo(ch1, 0) ThenBlock: {
                ReturnValue(1)
            }
            
            i = Add(i, 1)
        }
    }
}

Function.StringToInt {
    Input: str: Address
    Output: Integer
    Body: {
        result = 0
        i = 0
        
        WhileLoop 1 {
            ch = RDMEM_8(str, i)
            
            IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                ReturnValue(result)
            }
            
            digit = Subtract(ch, 48)
            result = Add(Multiply(result, 10), digit)
            i = Add(i, 1)
        }
    }
}

// -c -N keeps every byte except the last N. The count itself stays positive.
Function.TakeByteCount {
    Input: str: Address
    Body: {
        num = str
        IfCondition EqualTo(RDMEM_8(str, 0), 45) ThenBlock: {
            HeadConfig.elide = 1
            num = Add(str, 1)
        }
        HeadConfig.byte_count = StringToInt(num)
        HeadConfig.use_bytes = 1
    }
}

// -n -N keeps every line except the last N. The count itself stays positive.
Function.TakeLineCount {
    Input: str: Address
    Body: {
        num = str
        HeadConfig.elide = 0
        HeadConfig.use_bytes = 0
        IfCondition EqualTo(RDMEM_8(str, 0), 45) ThenBlock: {
            HeadConfig.elide = 1
            num = Add(str, 1)
        }
        HeadConfig.line_count = StringToInt(num)
    }
}

Function.IsLongLines {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(RDMEM_8(str, 0), 45) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(RDMEM_8(str, 1), 45) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(RDMEM_8(str, 2), 108) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(RDMEM_8(str, 3), 105) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(RDMEM_8(str, 4), 110) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(RDMEM_8(str, 5), 101) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(RDMEM_8(str, 6), 115) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// Drop the last n lines. A seekable fd is scanned twice so the offset
// ends just after the lines that were kept. A pipe keeps a window of n lines.
Function.HeadElideLinesPipe {
    Input: fd: Integer
    Input: n: Integer
    Body: {
        ring = Allocate(Multiply(n, 8))
        lens = Allocate(Multiply(n, 8))
        i = 0
        WhileLoop LessThan(i, n) {
            WRMEM_64(ring, Multiply(i, 8), 0)
            WRMEM_64(lens, Multiply(i, 8), 0)
            i = Add(i, 1)
        }
        buf = Allocate(HeadConstants.BUFFER_SIZE)
        line = Allocate(65536)
        llen = 0
        filled = 0
        slot = 0
        reading = 1
        WhileLoop EqualTo(reading, 1) {
            nr = SysRead(fd, buf, HeadConstants.BUFFER_SIZE)
            IfCondition LessEqual(nr, 0) ThenBlock: {
                reading = 0
            } ElseBlock: {
                j = 0
                WhileLoop LessThan(j, nr) {
                    b = RDMEM_8(buf, j)
                    IfCondition LessThan(llen, 65535) ThenBlock: {
                        WRMEM_8(line, llen, b)
                        llen = Add(llen, 1)
                    }
                    IfCondition EqualTo(b, HeadConfig.eol) ThenBlock: {
                        IfCondition EqualTo(filled, n) ThenBlock: {
                            old = RDMEM_64(ring, Multiply(slot, 8))
                            oldn = RDMEM_64(lens, Multiply(slot, 8))
                            WriteStdout(old, oldn)
                            Deallocate(old, 0)
                        } ElseBlock: {
                            filled = Add(filled, 1)
                        }
                        copy = Allocate(llen)
                        MemoryCopy(copy, line, llen)
                        WRMEM_64(ring, Multiply(slot, 8), copy)
                        WRMEM_64(lens, Multiply(slot, 8), llen)
                        one = 1
                        slot = Add(slot, one)
                        IfCondition EqualTo(slot, n) ThenBlock: {
                            slot = 0
                        }
                        llen = 0
                    }
                    j = Add(j, 1)
                }
            }
        }
        i = 0
        WhileLoop LessThan(i, n) {
            old = RDMEM_64(ring, Multiply(i, 8))
            IfCondition NotEqual(old, 0) ThenBlock: {
                Deallocate(old, 0)
            }
            i = Add(i, 1)
        }
        Deallocate(line, 65536)
        Deallocate(buf, HeadConstants.BUFFER_SIZE)
        Deallocate(lens, Multiply(n, 8))
        Deallocate(ring, Multiply(n, 8))
    }
}

Function.HeadElideLines {
    Input: fd: Integer
    Input: n: Integer
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: {
            HeadLines(fd, 2147483647)
            ReturnValue(0)
        }
        endpos = SystemCall(8, fd, 0, 2)
        IfCondition LessThan(endpos, 0) ThenBlock: {
            HeadElideLinesPipe(fd, n)
            ReturnValue(0)
        }
        SystemCall(8, fd, 0, 0)
        buf = Allocate(HeadConstants.BUFFER_SIZE)
        total = 0
        saw = 0
        last = HeadConfig.eol
        reading = 1
        WhileLoop EqualTo(reading, 1) {
            nr = SysRead(fd, buf, HeadConstants.BUFFER_SIZE)
            IfCondition LessEqual(nr, 0) ThenBlock: {
                reading = 0
            } ElseBlock: {
                saw = 1
                j = 0
                WhileLoop LessThan(j, nr) {
                    b = RDMEM_8(buf, j)
                    IfCondition EqualTo(b, HeadConfig.eol) ThenBlock: {
                        total = Add(total, 1)
                    }
                    last = b
                    j = Add(j, 1)
                }
            }
        }
        Deallocate(buf, HeadConstants.BUFFER_SIZE)
        IfCondition EqualTo(saw, 1) ThenBlock: {
            IfCondition NotEqual(last, HeadConfig.eol) ThenBlock: {
                total = Add(total, 1)
            }
        }
        keep = Subtract(total, n)
        IfCondition LessThan(keep, 0) ThenBlock: {
            keep = 0
        }
        SystemCall(8, fd, 0, 0)
        IfCondition GreaterThan(keep, 0) ThenBlock: {
            HeadLines(fd, keep)
        }
    }
}

Function.IsLongBytes {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(RDMEM_8(str, 0), 45) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(RDMEM_8(str, 1), 45) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(RDMEM_8(str, 2), 98) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(RDMEM_8(str, 3), 121) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(RDMEM_8(str, 4), 116) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(RDMEM_8(str, 5), 101) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(RDMEM_8(str, 6), 115) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// Drop the last n bytes of a pipe. lseek cannot size a pipe, so hold n bytes
// and write each byte only once n later bytes have arrived.
Function.HeadElideStream {
    Input: fd: Integer
    Input: n: Integer
    Body: {
        IfCondition GreaterThan(n, 1048576) ThenBlock: {
            n = 1048576
        }
        IfCondition LessEqual(n, 0) ThenBlock: {
            buf = Allocate(HeadConstants.BUFFER_SIZE)
            WhileLoop 1 {
                nr = SysRead(fd, buf, HeadConstants.BUFFER_SIZE)
                IfCondition LessEqual(nr, 0) ThenBlock: {
                    BreakLoop
                }
                WriteStdout(buf, nr)
            }
            Deallocate(buf, HeadConstants.BUFFER_SIZE)
        } ElseBlock: {
            hold = Allocate(n)
            buf = Allocate(HeadConstants.BUFFER_SIZE)
            filled = 0
            idx = 0
            WhileLoop 1 {
                nr = SysRead(fd, buf, HeadConstants.BUFFER_SIZE)
                IfCondition LessEqual(nr, 0) ThenBlock: {
                    BreakLoop
                }
                i = 0
                WhileLoop LessThan(i, nr) {
                    b = RDMEM_8(buf, i)
                    IfCondition EqualTo(filled, n) ThenBlock: {
                        WriteStdout(Add(hold, idx), 1)
                    } ElseBlock: {
                        filled = Add(filled, 1)
                    }
                    WRMEM_8(hold, idx, b)
                    idx = Add(idx, 1)
                    IfCondition EqualTo(idx, n) ThenBlock: {
                        idx = 0
                    }
                    i = Add(i, 1)
                }
            }
            Deallocate(buf, HeadConstants.BUFFER_SIZE)
            Deallocate(hold, n)
        }
    }
}

Function.ParseFlags {
    Input: flag_str: Address
    Output: Integer
    Body: {
        // Check for --help
        is_help = StrEquals(flag_str, "--help")
        IfCondition EqualTo(is_help, 1) ThenBlock: {
            WriteStderr("Usage: head [OPTION]... [FILE]...\n")
            WriteStderr("Print the first 10 lines of each FILE to standard output.\n")
            WriteStderr("With more than one FILE, precede each with a header.\n\n")
            WriteStderr("With no FILE, or when FILE is -, read standard input.\n\n")
            WriteStderr("  -c, --bytes=K        print the first K bytes\n")
            WriteStderr("  -n, --lines=K        print the first K lines (default: 10)\n")
            WriteStderr("  -q, --quiet          never print headers\n")
            WriteStderr("      --help           display this help and exit\n")
            SystemCall(60, 0)
        }
        
        // Check for --version
        is_version = StrEquals(flag_str, "--version")
        IfCondition EqualTo(is_version, 1) ThenBlock: {
            WriteStderr("head (AILANG coreutils) 1.0\n")
            SystemCall(60, 0)
        }

        is_bytes = IsLongBytes(flag_str)
        IfCondition EqualTo(is_bytes, 1) ThenBlock: {
            sep = RDMEM_8(flag_str, 7)
            IfCondition EqualTo(sep, 0) ThenBlock: {
                ReturnValue(3)
            }
            IfCondition EqualTo(sep, 61) ThenBlock: {
                TakeByteCount(Add(flag_str, 8))
                ReturnValue(1)
            }
        }

        is_lines = IsLongLines(flag_str)
        IfCondition EqualTo(is_lines, 1) ThenBlock: {
            sep = RDMEM_8(flag_str, 7)
            IfCondition EqualTo(sep, 0) ThenBlock: {
                ReturnValue(2)
            }
            IfCondition EqualTo(sep, 61) ThenBlock: {
                TakeLineCount(Add(flag_str, 8))
                ReturnValue(1)
            }
        }
        
        first = RDMEM_8(flag_str, 0)
        second = RDMEM_8(flag_str, 1)

        // Must start with -
        IfCondition NotEqual(first, 45) ThenBlock: {
            ReturnValue(0)
        }

        // GNU shorthand: -N means "first N lines" (e.g. `head -5`, `head -3 file`).
        // If the second byte is an ASCII digit, treat the whole arg past the
        // leading dash as a line count. This has to come BEFORE the -n/-c
        // checks so `-5` isn't misread as an unknown flag and dropped on
        // the floor (which made the main loop treat "-5" as a filename).
        IfCondition And(GreaterEqual(second, 48), LessEqual(second, 57)) ThenBlock: {
            val = 0
            i = 1
            one = 1
            ch = second
            WhileLoop And(GreaterEqual(ch, 48), LessEqual(ch, 57)) {
                digit = Subtract(ch, 48)
                val = Add(Multiply(val, 10), digit)
                i = Add(i, one)
                ch = RDMEM_8(flag_str, i)
            }
            suf = ch
            nxt = RDMEM_8(flag_str, Add(i, 1))
            IfCondition EqualTo(nxt, 0) ThenBlock: {
                HeadConfig.elide = 0
                IfCondition EqualTo(suf, 0) ThenBlock: {
                    HeadConfig.use_bytes = 0
                    HeadConfig.line_count = val
                    ReturnValue(1)
                }
                IfCondition EqualTo(suf, 99) ThenBlock: {
                    HeadConfig.use_bytes = 1
                    HeadConfig.byte_count = val
                    ReturnValue(1)
                }
                IfCondition EqualTo(suf, 98) ThenBlock: {
                    HeadConfig.use_bytes = 1
                    HeadConfig.byte_count = Multiply(val, 512)
                    ReturnValue(1)
                }
                IfCondition Or(EqualTo(suf, 107), EqualTo(suf, 75)) ThenBlock: {
                    HeadConfig.use_bytes = 1
                    HeadConfig.byte_count = Multiply(val, 1024)
                    ReturnValue(1)
                }
                IfCondition Or(EqualTo(suf, 109), EqualTo(suf, 77)) ThenBlock: {
                    HeadConfig.use_bytes = 1
                    HeadConfig.byte_count = Multiply(val, 1048576)
                    ReturnValue(1)
                }
            }
        }

        // Handle -n and -c with attached numbers (e.g., -n5, -c100)
        IfCondition EqualTo(second, 110) ThenBlock: {
            // -n flag
            third = RDMEM_8(flag_str, 2)
            IfCondition EqualTo(third, 0) ThenBlock: {
                // Just "-n", number comes in next arg
                ReturnValue(2)
            } ElseBlock: {
                // -n5 or -n-5, number is attached
                TakeLineCount(Add(flag_str, 2))
                ReturnValue(1)
            }
        }
        
        IfCondition EqualTo(second, 99) ThenBlock: {
            // -c flag
            third = RDMEM_8(flag_str, 2)
            IfCondition EqualTo(third, 0) ThenBlock: {
                // Just "-c", number comes in next arg
                ReturnValue(3)
            } ElseBlock: {
                // -c100 format, parse number
                number_str = Add(flag_str, 2)
                TakeByteCount(number_str)
                ReturnValue(1)
            }
        }
        
        // -q flag
        IfCondition EqualTo(second, 113) ThenBlock: {
            HeadConfig.quiet_mode = 1
            ReturnValue(1)
        }

        IfCondition EqualTo(second, 122) ThenBlock: {
            HeadConfig.eol = 0
            ReturnValue(1)
        }
        
        ReturnValue(0)
    }
}

// === ARGUMENT PARSING ===

Function.GetArgs {
    Output: Address
    Body: {
        cmdline_path = "/proc/self/cmdline"
        fd = SystemCall(257, -100, cmdline_path, 0, 0)
        
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
         HeadConstants.args_size = bytes_read
        ReturnValue(buffer)
    }
}

// === MAIN ===

SubRoutine.Main {
    args_buffer = GetArgs()
    
    // If no args, process stdin
    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        HeadStdin()
        SystemCall(60, 0)
    }
    
    // Skip program name
    pos = 0
    WhileLoop NotEqual(RDMEM_8(args_buffer, pos), 0) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)
    
    // Collect file paths
    file_paths = Allocate(Multiply(HeadConstants.MAX_FILES, 8))
    file_count = 0
    expect_number = 0  // 2 for -n, 3 for -c
    
    WhileLoop LessThan(pos, HeadConstants.args_size) {
    ch = RDMEM_8(args_buffer, pos)
    IfCondition EqualTo(ch, 0) ThenBlock: {
        pos = Add(pos, 1)
        ContinueLoop
    }
        
        arg_start = pos
        arg_len = 0
        
        WhileLoop And(LessThan(pos, 4096), NotEqual(RDMEM_8(args_buffer, pos), 0)) {
            arg_len = Add(arg_len, 1)
            pos = Add(pos, 1)
        }
        
        arg = Allocate(Add(arg_len, 1))
        i = 0
        WhileLoop LessThan(i, arg_len) {
            ch = RDMEM_8(args_buffer, Add(arg_start, i))
            WRMEM_8(arg, i, ch)
            i = Add(i, 1)
        }
        WRMEM_8(arg, arg_len, 0)
        
        // If expecting a number, parse it
        IfCondition EqualTo(expect_number, 2) ThenBlock: {
            TakeLineCount(arg)
            expect_number = 0
            Deallocate(arg, Add(arg_len, 1))
        } ElseBlock: {
            IfCondition EqualTo(expect_number, 3) ThenBlock: {
                TakeByteCount(arg)
                expect_number = 0
                Deallocate(arg, Add(arg_len, 1))
            } ElseBlock: {
                // Try to parse as flag
                flag_result = ParseFlags(arg)
                
                IfCondition GreaterThan(flag_result, 1) ThenBlock: {
                    // Flag expects next arg as number
                    expect_number = flag_result
                    Deallocate(arg, Add(arg_len, 1))
                } ElseBlock: {
                    IfCondition EqualTo(flag_result, 0) ThenBlock: {
                        // Not a flag, it's a filename
                        WRMEM_64(file_paths, Multiply(file_count, 8), arg)
                        file_count = Add(file_count, 1)
                    } ElseBlock: {
                        // Flag was parsed, deallocate
                        Deallocate(arg, Add(arg_len, 1))
                    }
                }
            }
        }
        
        pos = Add(pos, 1)
    }
    
    Deallocate(args_buffer, 4096)
    
    // If no files specified, read stdin
    IfCondition EqualTo(file_count, 0) ThenBlock: {
        HeadStdin()
        SystemCall(60, 0)
    }
    
    // Process files
    exit_code = 0
    show_headers = And(GreaterThan(file_count, 1), EqualTo(HeadConfig.quiet_mode, 0))
    
    i = 0
    WhileLoop LessThan(i, file_count) {
        path = RDMEM_64(file_paths, Multiply(i, 8))
        
        // Print header if multiple files. GNU head emits these on stdout,
        // interleaved with content. The old code sent them to stderr,
        // which caused the "==> file <==" lines to lose ordering with
        // the file bodies and broke diff against GNU head.
        IfCondition EqualTo(show_headers, 1) ThenBlock: {
            IfCondition GreaterThan(i, 0) ThenBlock: {
                WriteStdoutStr("\n")
            }
            WriteStdoutStr("==> ")
            WriteStdoutStr(path)
            WriteStdoutStr(" <==\n")
        }
        
        result = HeadFile(path)
        IfCondition NotEqual(result, 0) ThenBlock: {
            exit_code = 1
        }
        
        Deallocate(path, 0)
        i = Add(i, 1)
    }
    
    Deallocate(file_paths, Multiply(HeadConstants.MAX_FILES, 8))
    SystemCall(60, exit_code)
}

RunTask(Main)