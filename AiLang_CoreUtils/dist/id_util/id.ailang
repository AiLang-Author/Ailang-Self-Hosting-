// id.ailang - Print user and group IDs
// Default: uid=N(name) gid=N(name) groups=N(name),...
// -u user, -g group, -G all groups, -n names, -r real ids, -z NUL separators

LibraryImport.Arena

FixedPool.IdOpt {
    "user_only": Initialize=0
    "group_only": Initialize=0
    "groups": Initialize=0
    "names": Initialize=0
    "real_id": Initialize=0
    "zero": Initialize=0
    "failed": Initialize=0
    "nusers": Initialize=0
}

FixedPool.IdBuf {
    "len": Initialize=0
    "alen": Initialize=0
}

FixedPool.Found {
    "ok": Initialize=0
    "uid": Initialize=0
    "gid": Initialize=0
    "name": Initialize=0
    "name_len": Initialize=0
}

Function.WriteStdout {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 1, str, len)
    }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.WriteNumber {
    Input: num: Integer
    Body: {
        IfCondition LessThan(num, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(num, 10) ThenBlock: {
            ch = Add(48, num)
            buffer = Allocate(1)
            WRMEM_8(buffer, 0, ch)
            SystemCall(1, 1, buffer, 1)
            Deallocate(buffer, 1)
            ReturnValue(0)
        }

        digits = Allocate(20)
        count = 0
        temp = num
        WhileLoop GreaterThan(temp, 0) {
            digit = Modulo(temp, 10)
            WRMEM_8(digits, count, Add(48, digit))
            count = Add(count, 1)
            temp = Divide(temp, 10)
        }

        i = Subtract(count, 1)
        WhileLoop GreaterEqual(i, 0) {
            SystemCall(1, 1, Add(digits, i), 1)
            i = Subtract(i, 1)
        }
        Deallocate(digits, 20)
    }
}

Function.WriteSep {
    Body: {
        buf = Allocate(1)
        ch = 32
        IfCondition EqualTo(IdOpt.zero, 1) ThenBlock: {
            ch = 0
        }
        WRMEM_8(buf, 0, ch)
        SystemCall(1, 1, buf, 1)
        Deallocate(buf, 1)
    }
}

Function.WriteEnd {
    Body: {
        buf = Allocate(1)
        ch = 10
        IfCondition EqualTo(IdOpt.zero, 1) ThenBlock: {
            ch = 0
        }
        WRMEM_8(buf, 0, ch)
        SystemCall(1, 1, buf, 1)
        many = GreaterThan(IdOpt.nusers, 1)
        extra = And(EqualTo(IdOpt.zero, 1), EqualTo(IdOpt.groups, 1))
        extra = And(extra, many)
        IfCondition EqualTo(extra, 1) ThenBlock: {
            WRMEM_8(buf, 0, 0)
            SystemCall(1, 1, buf, 1)
        }
        Deallocate(buf, 1)
    }
}

Function.LoadFile {
    Input: path: Address
    Output: Address
    Body: {
        fd = SystemCall(2, path, 0, 0)
        buf = Allocate(131072)
        n = 0
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            n = SystemCall(0, fd, buf, 131071)
            SystemCall(3, fd)
        }
        IfCondition LessThan(n, 0) ThenBlock: {
            n = 0
        }
        WRMEM_8(buf, n, 0)
        IdBuf.len = n
        ReturnValue(buf)
    }
}

Function.CopyName {
    Input: src: Address
    Input: len: Integer
    Output: Address
    Body: {
        dst = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            WRMEM_8(dst, i, RDMEM_8(src, i))
            i = Add(i, 1)
        }
        WRMEM_8(dst, len, 0)
        ReturnValue(dst)
    }
}

// Scan one passwd buffer for a name or a uid. want_name 0 means match uid.
Function.ScanPasswd {
    Input: buf: Address
    Input: blen: Integer
    Input: name: Address
    Input: name_len: Integer
    Input: want_uid: Integer
    Input: by_uid: Integer
    Body: {
        Found.ok = 0
        i = 0
        WhileLoop LessThan(i, blen) {
            line = Add(buf, i)
            nlen = 0
            WhileLoop And(LessThan(i, blen), NotEqual(RDMEM_8(buf, i), 58)) {
                nlen = Add(nlen, 1)
                i = Add(i, 1)
            }
            IfCondition LessThan(i, blen) ThenBlock: {
                i = Add(i, 1)
            }
            WhileLoop And(LessThan(i, blen), NotEqual(RDMEM_8(buf, i), 58)) {
                i = Add(i, 1)
            }
            IfCondition LessThan(i, blen) ThenBlock: {
                i = Add(i, 1)
            }
            uid = 0
            WhileLoop And(LessThan(i, blen), And(GreaterEqual(RDMEM_8(buf, i), 48), LessEqual(RDMEM_8(buf, i), 57))) {
                uid = Add(Multiply(uid, 10), Subtract(RDMEM_8(buf, i), 48))
                i = Add(i, 1)
            }
            IfCondition LessThan(i, blen) ThenBlock: {
                i = Add(i, 1)
            }
            gid = 0
            WhileLoop And(LessThan(i, blen), And(GreaterEqual(RDMEM_8(buf, i), 48), LessEqual(RDMEM_8(buf, i), 57))) {
                gid = Add(Multiply(gid, 10), Subtract(RDMEM_8(buf, i), 48))
                i = Add(i, 1)
            }
            match = 0
            IfCondition EqualTo(by_uid, 1) ThenBlock: {
                IfCondition EqualTo(uid, want_uid) ThenBlock: {
                    match = 1
                }
            } ElseBlock: {
                IfCondition EqualTo(nlen, name_len) ThenBlock: {
                    same = 1
                    k = 0
                    WhileLoop LessThan(k, name_len) {
                        IfCondition NotEqual(RDMEM_8(line, k), RDMEM_8(name, k)) ThenBlock: {
                            same = 0
                        }
                        k = Add(k, 1)
                    }
                    match = same
                }
            }
            IfCondition EqualTo(match, 1) ThenBlock: {
                Found.ok = 1
                Found.uid = uid
                Found.gid = gid
                Found.name = CopyName(line, nlen)
                Found.name_len = nlen
                i = blen
            }
            WhileLoop And(LessThan(i, blen), NotEqual(RDMEM_8(buf, i), 10)) {
                i = Add(i, 1)
            }
            IfCondition LessThan(i, blen) ThenBlock: {
                i = Add(i, 1)
            }
        }
    }
}

Function.GroupName {
    Input: gbuf: Address
    Input: glen: Integer
    Input: gid: Integer
    Output: Address
    Body: {
        i = 0
        hit = 0
        WhileLoop LessThan(i, glen) {
            line = Add(gbuf, i)
            nlen = 0
            WhileLoop And(LessThan(i, glen), NotEqual(RDMEM_8(gbuf, i), 58)) {
                nlen = Add(nlen, 1)
                i = Add(i, 1)
            }
            IfCondition LessThan(i, glen) ThenBlock: {
                i = Add(i, 1)
            }
            WhileLoop And(LessThan(i, glen), NotEqual(RDMEM_8(gbuf, i), 58)) {
                i = Add(i, 1)
            }
            IfCondition LessThan(i, glen) ThenBlock: {
                i = Add(i, 1)
            }
            gg = 0
            WhileLoop And(LessThan(i, glen), And(GreaterEqual(RDMEM_8(gbuf, i), 48), LessEqual(RDMEM_8(gbuf, i), 57))) {
                gg = Add(Multiply(gg, 10), Subtract(RDMEM_8(gbuf, i), 48))
                i = Add(i, 1)
            }
            IfCondition EqualTo(gg, gid) ThenBlock: {
                hit = CopyName(line, nlen)
                i = glen
            }
            WhileLoop And(LessThan(i, glen), NotEqual(RDMEM_8(gbuf, i), 10)) {
                i = Add(i, 1)
            }
            IfCondition LessThan(i, glen) ThenBlock: {
                i = Add(i, 1)
            }
        }
        ReturnValue(hit)
    }
}

Function.WriteNamedId {
    Input: gbuf: Address
    Input: glen: Integer
    Input: idn: Integer
    Body: {
        IfCondition EqualTo(IdOpt.names, 1) ThenBlock: {
            nm = GroupName(gbuf, glen, idn)
            IfCondition EqualTo(nm, 0) ThenBlock: {
                WriteNumber(idn)
            } ElseBlock: {
                WriteStdout(nm)
                Deallocate(nm, 0)
            }
        } ElseBlock: {
            WriteNumber(idn)
            IfCondition EqualTo(IdOpt.groups, 0) ThenBlock: {
                IfCondition EqualTo(IdOpt.user_only, 0) ThenBlock: {
                    IfCondition EqualTo(IdOpt.group_only, 0) ThenBlock: {
                        nm = GroupName(gbuf, glen, idn)
                        IfCondition NotEqual(nm, 0) ThenBlock: {
                            WriteStdout("(")
                            WriteStdout(nm)
                            WriteStdout(")")
                            Deallocate(nm, 0)
                        }
                    }
                }
            }
        }
    }
}

Function.MemberAt {
    Input: members: Address
    Input: name: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop 1 {
            ch = RDMEM_8(members, i)
            IfCondition Or(EqualTo(ch, 0), EqualTo(ch, 10)) ThenBlock: {
                ReturnValue(0)
            }
            same = 1
            k = 0
            WhileLoop LessThan(k, name_len) {
                IfCondition NotEqual(RDMEM_8(members, Add(i, k)), RDMEM_8(name, k)) ThenBlock: {
                    same = 0
                }
                k = Add(k, 1)
            }
            endc = RDMEM_8(members, Add(i, name_len))
            ended = Or(EqualTo(endc, 44), Or(EqualTo(endc, 10), EqualTo(endc, 0)))
            IfCondition And(EqualTo(same, 1), EqualTo(ended, 1)) ThenBlock: {
                ReturnValue(1)
            }
            WhileLoop 1 {
                ch = RDMEM_8(members, i)
                IfCondition Or(EqualTo(ch, 44), Or(EqualTo(ch, 10), EqualTo(ch, 0))) ThenBlock: {
                    BreakLoop
                }
                i = Add(i, 1)
            }
            IfCondition EqualTo(RDMEM_8(members, i), 44) ThenBlock: {
                i = Add(i, 1)
            }
        }
        ReturnValue(0)
    }
}

Function.PrintUserGroups {
    Input: gbuf: Address
    Input: glen: Integer
    Input: name: Address
    Input: name_len: Integer
    Input: primary: Integer
    Body: {
        started = 0
        WriteNamedId(gbuf, glen, primary)
        started = 1
        i = 0
        WhileLoop LessThan(i, glen) {
            line = Add(gbuf, i)
            nlen = 0
            WhileLoop And(LessThan(i, glen), NotEqual(RDMEM_8(gbuf, i), 58)) {
                nlen = Add(nlen, 1)
                i = Add(i, 1)
            }
            IfCondition LessThan(i, glen) ThenBlock: {
                i = Add(i, 1)
            }
            WhileLoop And(LessThan(i, glen), NotEqual(RDMEM_8(gbuf, i), 58)) {
                i = Add(i, 1)
            }
            IfCondition LessThan(i, glen) ThenBlock: {
                i = Add(i, 1)
            }
            gg = 0
            WhileLoop And(LessThan(i, glen), And(GreaterEqual(RDMEM_8(gbuf, i), 48), LessEqual(RDMEM_8(gbuf, i), 57))) {
                gg = Add(Multiply(gg, 10), Subtract(RDMEM_8(gbuf, i), 48))
                i = Add(i, 1)
            }
            IfCondition LessThan(i, glen) ThenBlock: {
                i = Add(i, 1)
            }
            members = Add(gbuf, i)
            IfCondition NotEqual(gg, primary) ThenBlock: {
                hit = MemberAt(members, name, name_len)
                IfCondition EqualTo(hit, 1) ThenBlock: {
                    IfCondition EqualTo(started, 1) ThenBlock: {
                        IfCondition EqualTo(IdOpt.groups, 1) ThenBlock: {
                            WriteSep()
                        } ElseBlock: {
                            WriteStdout(",")
                        }
                    }
                    IfCondition EqualTo(IdOpt.names, 1) ThenBlock: {
                        nm = CopyName(line, nlen)
                        WriteStdout(nm)
                        Deallocate(nm, 0)
                    } ElseBlock: {
                        WriteNumber(gg)
                        IfCondition EqualTo(IdOpt.groups, 0) ThenBlock: {
                            WriteStdout("(")
                            nm = CopyName(line, nlen)
                            WriteStdout(nm)
                            WriteStdout(")")
                            Deallocate(nm, 0)
                        }
                    }
                    started = 1
                }
            }
            WhileLoop And(LessThan(i, glen), NotEqual(RDMEM_8(gbuf, i), 10)) {
                i = Add(i, 1)
            }
            IfCondition LessThan(i, glen) ThenBlock: {
                i = Add(i, 1)
            }
        }
    }
}

Function.PrintSelfGroups {
    Input: gbuf: Address
    Input: glen: Integer
    Input: primary: Integer
    Body: {
        list = Allocate(256)
        count = SystemCall(115, 64, list)
        IfCondition LessThan(count, 0) ThenBlock: {
            count = 0
        }
        WriteNamedId(gbuf, glen, primary)
        n = 0
        WhileLoop LessThan(n, count) {
            off = Multiply(n, 4)
            b0 = RDMEM_8(list, off)
            b1 = RDMEM_8(list, Add(off, 1))
            b2 = RDMEM_8(list, Add(off, 2))
            b3 = RDMEM_8(list, Add(off, 3))
            gg = Add(b0, Multiply(b1, 256))
            gg = Add(gg, Multiply(b2, 65536))
            gg = Add(gg, Multiply(b3, 16777216))
            IfCondition NotEqual(gg, primary) ThenBlock: {
                IfCondition EqualTo(IdOpt.groups, 1) ThenBlock: {
                    WriteSep()
                } ElseBlock: {
                    WriteStdout(",")
                }
                WriteNamedId(gbuf, glen, gg)
            }
            n = Add(n, 1)
        }
        Deallocate(list, 256)
    }
}

Function.AllDigits {
    Input: str: Address
    Output: Integer
    Body: {
        i = 0
        ch = RDMEM_8(str, 0)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(0)
        }
        WhileLoop NotEqual(RDMEM_8(str, i), 0) {
            ch = RDMEM_8(str, i)
            IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.ParseUid {
    Input: str: Address
    Output: Integer
    Body: {
        n = 0
        i = 0
        WhileLoop NotEqual(RDMEM_8(str, i), 0) {
            n = Add(Multiply(n, 10), Subtract(RDMEM_8(str, i), 48))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.PrintRecord {
    Input: pbuf: Address
    Input: plen: Integer
    Input: gbuf: Address
    Input: glen: Integer
    Input: spec: Address
    Body: {
        Found.ok = 0
        spec_len = StringLength(spec)
        IfCondition EqualTo(spec_len, 0) ThenBlock: {
            WriteStderr("id: '': no such user\n")
            IdOpt.failed = 1
            ReturnValue(0)
        }

        by_uid = 0
        want = 0
        name = spec
        name_len = spec_len
        IfCondition EqualTo(RDMEM_8(spec, 0), 43) ThenBlock: {
            by_uid = 1
            name = Add(spec, 1)
            want = ParseUid(name)
            name_len = StringLength(name)
        } ElseBlock: {
            digits = AllDigits(spec)
            IfCondition EqualTo(digits, 1) ThenBlock: {
                want = ParseUid(spec)
            }
        }

        IfCondition EqualTo(by_uid, 0) ThenBlock: {
            ScanPasswd(pbuf, plen, spec, spec_len, 0, 0)
        }
        IfCondition EqualTo(Found.ok, 0) ThenBlock: {
            try_uid = by_uid
            IfCondition EqualTo(AllDigits(spec), 1) ThenBlock: {
                try_uid = 1
                want = ParseUid(spec)
            }
            IfCondition EqualTo(try_uid, 1) ThenBlock: {
                ScanPasswd(pbuf, plen, 0, 0, want, 1)
            }
        }

        IfCondition EqualTo(Found.ok, 0) ThenBlock: {
            WriteStderr("id: '")
            WriteStderr(spec)
            WriteStderr("': no such user\n")
            IdOpt.failed = 1
            ReturnValue(0)
        }

        IfCondition EqualTo(IdOpt.user_only, 1) ThenBlock: {
            IfCondition EqualTo(IdOpt.names, 1) ThenBlock: {
                WriteStdout(Found.name)
            } ElseBlock: {
                WriteNumber(Found.uid)
            }
            Deallocate(Found.name, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(IdOpt.group_only, 1) ThenBlock: {
            WriteNamedId(gbuf, glen, Found.gid)
            Deallocate(Found.name, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(IdOpt.groups, 1) ThenBlock: {
            PrintUserGroups(gbuf, glen, Found.name, Found.name_len, Found.gid)
            Deallocate(Found.name, 0)
            ReturnValue(0)
        }

        WriteStdout("uid=")
        WriteNumber(Found.uid)
        WriteStdout("(")
        WriteStdout(Found.name)
        WriteStdout(") gid=")
        WriteNumber(Found.gid)
        WriteStdout("(")
        gname = GroupName(gbuf, glen, Found.gid)
        IfCondition NotEqual(gname, 0) ThenBlock: {
            WriteStdout(gname)
            Deallocate(gname, 0)
        }
        WriteStdout(") groups=")
        PrintUserGroups(gbuf, glen, Found.name, Found.name_len, Found.gid)
        Deallocate(Found.name, 0)
    }
}

Function.PrintSelf {
    Input: gbuf: Address
    Input: glen: Integer
    Input: pbuf: Address
    Input: plen: Integer
    Body: {
        uid = SystemCall(102)
        gid = SystemCall(104)
        euid = SystemCall(107)
        egid = SystemCall(108)
        IfCondition EqualTo(IdOpt.real_id, 1) ThenBlock: {
            euid = uid
            egid = gid
        }

        IfCondition EqualTo(IdOpt.user_only, 1) ThenBlock: {
            IfCondition EqualTo(IdOpt.names, 1) ThenBlock: {
                ScanPasswd(pbuf, plen, 0, 0, euid, 1)
                IfCondition EqualTo(Found.ok, 1) ThenBlock: {
                    WriteStdout(Found.name)
                    Deallocate(Found.name, 0)
                } ElseBlock: {
                    WriteNumber(euid)
                }
            } ElseBlock: {
                WriteNumber(euid)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(IdOpt.group_only, 1) ThenBlock: {
            WriteNamedId(gbuf, glen, egid)
            ReturnValue(0)
        }
        IfCondition EqualTo(IdOpt.groups, 1) ThenBlock: {
            PrintSelfGroups(gbuf, glen, gid)
            ReturnValue(0)
        }

        ScanPasswd(pbuf, plen, 0, 0, uid, 1)
        uname = Found.name
        IfCondition EqualTo(Found.ok, 0) ThenBlock: {
            uname = 0
        }
        WriteStdout("uid=")
        WriteNumber(uid)
        IfCondition NotEqual(uname, 0) ThenBlock: {
            WriteStdout("(")
            WriteStdout(uname)
            WriteStdout(")")
        }
        IfCondition NotEqual(euid, uid) ThenBlock: {
            WriteStdout(" euid=")
            WriteNumber(euid)
        }
        WriteStdout(" gid=")
        WriteNumber(gid)
        gname = GroupName(gbuf, glen, gid)
        IfCondition NotEqual(gname, 0) ThenBlock: {
            WriteStdout("(")
            WriteStdout(gname)
            WriteStdout(")")
            Deallocate(gname, 0)
        }
        IfCondition NotEqual(egid, gid) ThenBlock: {
            WriteStdout(" egid=")
            WriteNumber(egid)
        }
        WriteStdout(" groups=")
        PrintSelfGroups(gbuf, glen, gid)
        IfCondition NotEqual(uname, 0) ThenBlock: {
            Deallocate(uname, 0)
        }
    }
}

SubRoutine.Main {
    args = 0
    fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
    IfCondition GreaterEqual(fd, 0) ThenBlock: {
        args = Allocate(4096)
        nread = SystemCall(0, fd, args, 4096)
        SystemCall(3, fd)
        IfCondition LessEqual(nread, 0) ThenBlock: {
            Deallocate(args, 4096)
            args = 0
        } ElseBlock: {
            IdBuf.alen = nread
            IfCondition LessThan(nread, 4096) ThenBlock: {
                WRMEM_8(args, nread, 0)
            }
        }
    }

    pos = 0
    IfCondition NotEqual(args, 0) ThenBlock: {
        WhileLoop NotEqual(RDMEM_8(args, pos), 0) {
            pos = Add(pos, 1)
        }
        pos = Add(pos, 1)
    }

    parsing = 1
    WhileLoop EqualTo(parsing, 1) {
        IfCondition EqualTo(args, 0) ThenBlock: {
            parsing = 0
        } ElseBlock: {
            ch = RDMEM_8(args, pos)
            IfCondition NotEqual(ch, 45) ThenBlock: {
                parsing = 0
            } ElseBlock: {
                opt = Add(args, pos)
                IfCondition StringEquals(opt, "--") ThenBlock: {
                    WhileLoop NotEqual(RDMEM_8(args, pos), 0) {
                        pos = Add(pos, 1)
                    }
                    pos = Add(pos, 1)
                    parsing = 0
                } ElseBlock: {
                    IfCondition StringEquals(opt, "--zero") ThenBlock: {
                        IdOpt.zero = 1
                    }
                    IfCondition StringEquals(opt, "--user") ThenBlock: {
                        IdOpt.user_only = 1
                    }
                    IfCondition StringEquals(opt, "--group") ThenBlock: {
                        IdOpt.group_only = 1
                    }
                    IfCondition StringEquals(opt, "--groups") ThenBlock: {
                        IdOpt.groups = 1
                    }
                    IfCondition StringEquals(opt, "--name") ThenBlock: {
                        IdOpt.names = 1
                    }
                    IfCondition StringEquals(opt, "--real") ThenBlock: {
                        IdOpt.real_id = 1
                    }
                    second = RDMEM_8(args, Add(pos, 1))
                    IfCondition NotEqual(second, 45) ThenBlock: {
                        i = Add(pos, 1)
                        WhileLoop NotEqual(RDMEM_8(args, i), 0) {
                            och = RDMEM_8(args, i)
                            IfCondition EqualTo(och, 117) ThenBlock: { IdOpt.user_only = 1 }
                            IfCondition EqualTo(och, 103) ThenBlock: { IdOpt.group_only = 1 }
                            IfCondition EqualTo(och, 71) ThenBlock: { IdOpt.groups = 1 }
                            IfCondition EqualTo(och, 110) ThenBlock: { IdOpt.names = 1 }
                            IfCondition EqualTo(och, 114) ThenBlock: { IdOpt.real_id = 1 }
                            IfCondition EqualTo(och, 122) ThenBlock: { IdOpt.zero = 1 }
                            i = Add(i, 1)
                        }
                    }
                    WhileLoop NotEqual(RDMEM_8(args, pos), 0) {
                        pos = Add(pos, 1)
                    }
                    pos = Add(pos, 1)
                }
            }
        }
    }

    mode_count = Add(IdOpt.user_only, Add(IdOpt.group_only, IdOpt.groups))
    IfCondition And(EqualTo(IdOpt.zero, 1), EqualTo(mode_count, 0)) ThenBlock: {
        WriteStderr("id: option --zero not permitted in default format\n")
        SystemCall(60, 1)
    }

    pbuf = LoadFile("/etc/passwd")
    plen = IdBuf.len
    gbuf = LoadFile("/etc/group")
    glen = IdBuf.len

    saw_user = 0
    IfCondition NotEqual(args, 0) ThenBlock: {
        scan = pos
        WhileLoop LessThan(scan, IdBuf.alen) {
            IdOpt.nusers = Add(IdOpt.nusers, 1)
            WhileLoop And(LessThan(scan, IdBuf.alen), NotEqual(RDMEM_8(args, scan), 0)) {
                scan = Add(scan, 1)
            }
            IfCondition LessThan(scan, IdBuf.alen) ThenBlock: {
                scan = Add(scan, 1)
            }
        }
    }
    IfCondition NotEqual(args, 0) ThenBlock: {
        WhileLoop LessThan(pos, IdBuf.alen) {
            spec = Add(args, pos)
            PrintRecord(pbuf, plen, gbuf, glen, spec)
            saw_user = 1
            IfCondition EqualTo(Found.ok, 1) ThenBlock: {
                WriteEnd()
            }
            WhileLoop And(LessThan(pos, IdBuf.alen), NotEqual(RDMEM_8(args, pos), 0)) {
                pos = Add(pos, 1)
            }
            IfCondition LessThan(pos, IdBuf.alen) ThenBlock: {
                pos = Add(pos, 1)
            }
        }
    }

    IfCondition EqualTo(saw_user, 0) ThenBlock: {
        PrintSelf(gbuf, glen, pbuf, plen)
        WriteEnd()
    }

    Deallocate(pbuf, 131072)
    Deallocate(gbuf, 131072)
    SystemCall(60, IdOpt.failed)
}

RunTask(Main)
