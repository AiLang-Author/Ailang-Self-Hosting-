// Split from ln.ailang. Pools stay on ln.ailang. No Main.
LibraryImport.Arena

Function.PathExists {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(4, path, statbuf)
        Deallocate(statbuf, 144)
        ReturnValue(GreaterEqual(result, 0))
    }
}

Function.IsDirectory {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(4, path, statbuf)
        
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        
        st_mode = RDMEM_64(statbuf, 24)
        Deallocate(statbuf, 144)
        
        is_dir = BitwiseAnd(st_mode, 16384)
        ReturnValue(NotEqual(is_dir, 0))
    }
}

Function.BuildPath {
    Input: dir: Address
    Input: file: Address
    Output: Address
    Body: {
        dir_len = StringLength(dir)
        file_len = StringLength(file)
        
        needs_slash = 1
        IfCondition GreaterThan(dir_len, 0) ThenBlock: {
            last_char = RDMEM_8(dir, Subtract(dir_len, 1))
            IfCondition EqualTo(last_char, 47) ThenBlock: {
                needs_slash = 0
            }
        }
        
        total_len = Add(Add(dir_len, file_len), Add(needs_slash, 1))
        path = Allocate(total_len)
        
        i = 0
        at = 0
        one = 1
        WhileLoop LessThan(i, dir_len) {
            WRMEM_8(path, at, RDMEM_8(dir, i))
            nxt = Add(at, one)
            at = nxt
            i = Add(i, one)
        }
        
        IfCondition EqualTo(needs_slash, 1) ThenBlock: {
            WRMEM_8(path, at, 47)
            nxt = Add(at, one)
            at = nxt
        }
        
        j = 0
        WhileLoop LessThan(j, file_len) {
            WRMEM_8(path, at, RDMEM_8(file, j))
            nxt = Add(at, one)
            at = nxt
            j = Add(j, one)
        }
        
        WRMEM_8(path, at, 0)
        ReturnValue(path)
    }
}

Function.GetBasename {
    Input: path: Address
    Output: Address
    Body: {
        len = StringLength(path)
        
        real_len = len
        WhileLoop And(GreaterThan(real_len, 0), 
                     EqualTo(RDMEM_8(path, Subtract(real_len, 1)), 47)) {
            real_len = Subtract(real_len, 1)
        }
        
        last_slash = -1
        i = 0
        WhileLoop LessThan(i, real_len) {
            IfCondition EqualTo(RDMEM_8(path, i), 47) ThenBlock: {
                last_slash = i
            }
            i = Add(i, 1)
        }
        
        start = Add(last_slash, 1)
        basename_len = Subtract(real_len, start)
        
        IfCondition EqualTo(basename_len, 0) ThenBlock: {
            basename = Allocate(2)
            WRMEM_8(basename, 0, 47)
            WRMEM_8(basename, 1, 0)
            ReturnValue(basename)
        }
        
        basename = Allocate(Add(basename_len, 1))
        i = 0
        WhileLoop LessThan(i, basename_len) {
            WRMEM_8(basename, i, RDMEM_8(path, Add(start, i)))
            i = Add(i, 1)
        }
        WRMEM_8(basename, basename_len, 0)
        
        ReturnValue(basename)
    }
}

Function.GetErrorString {
    Input: errno: Integer
    Output: Address
    Body: {
        abs_errno = errno
        IfCondition LessThan(errno, 0) ThenBlock: {
            abs_errno = Subtract(0, errno)
        }
        
        IfCondition EqualTo(abs_errno, LnConstants.EEXIST) ThenBlock: {
            ReturnValue("File exists")
        }
        
        IfCondition EqualTo(abs_errno, LnConstants.ENOENT) ThenBlock: {
            ReturnValue("No such file or directory")
        }
        
        IfCondition EqualTo(abs_errno, LnConstants.EACCES) ThenBlock: {
            ReturnValue("Permission denied")
        }
        
        IfCondition EqualTo(abs_errno, LnConstants.EXDEV) ThenBlock: {
            ReturnValue("Invalid cross-device link")
        }
        
        IfCondition EqualTo(abs_errno, LnConstants.EISDIR) ThenBlock: {
            ReturnValue("Is a directory")
        }
        
        IfCondition EqualTo(abs_errno, LnConstants.ENOTDIR) ThenBlock: {
            ReturnValue("Not a directory")
        }
        
        IfCondition EqualTo(abs_errno, LnConstants.EPERM) ThenBlock: {
            ReturnValue("Operation not permitted")
        }
        
        ReturnValue("Unknown error")
    }
}

Function.PromptUser {
    Input: prompt: Address
    Output: Integer
    Body: {
        WriteStderr(prompt)
        
        response = Allocate(8)
        bytes = SystemCall(0, 0, response, 8)
        
        IfCondition LessEqual(bytes, 0) ThenBlock: {
            Deallocate(response, 8)
            ReturnValue(0)
        }
        
        ch = RDMEM_8(response, 0)
        Deallocate(response, 8)
        
        result = Or(EqualTo(ch, 121), EqualTo(ch, 89))
        ReturnValue(result)
    }
}

// ============================================================================
// CORE LINK FUNCTIONS
// ============================================================================

Function.CopyFrom {
    Input: base: Address
    Input: at: Integer
    Output: Address
    Body: {
        p = Add(base, at)
        n = StringLength(p)
        buf = Allocate(Add(n, 1))
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            WRMEM_8(buf, i, RDMEM_8(p, i))
            i = Add(i, one)
        }
        WRMEM_8(buf, n, 0)
        ReturnValue(buf)
    }
}

Function.OptPrefix {
    Input: flag: Address
    Input: word: Address
    Input: wlen: Integer
    Output: Integer
    Body: {
        b0 = RDMEM_8(flag, 0)
        b1 = RDMEM_8(flag, 1)
        IfCondition NotEqual(b0, 45) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(b1, 45) ThenBlock: {
            ReturnValue(0)
        }
        i = 0
        one = 1
        WhileLoop LessThan(i, wlen) {
            at = Add(i, 2)
            fc = RDMEM_8(flag, at)
            IfCondition EqualTo(fc, 0) ThenBlock: {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    ReturnValue(1)
                }
                ReturnValue(0)
            }
            IfCondition EqualTo(fc, 61) ThenBlock: {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    ReturnValue(1)
                }
                ReturnValue(0)
            }
            wc = RDMEM_8(word, i)
            IfCondition NotEqual(fc, wc) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        at = Add(wlen, 2)
        fc = RDMEM_8(flag, at)
        IfCondition EqualTo(fc, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(fc, 61) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.AfterEq {
    Input: flag: Address
    Output: Address
    Body: {
        i = 0
        one = 1
        WhileLoop 1 {
            c = RDMEM_8(flag, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(c, 61) ThenBlock: {
                nxt = Add(i, one)
                buf = CopyFrom(flag, nxt)
                ReturnValue(buf)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.TakeValue {
    Input: flag: Address
    Input: kind: Integer
    Body: {
        val = AfterEq(flag)
        IfCondition EqualTo(val, 0) ThenBlock: {
            LnConfig.want_arg = kind
            IfCondition EqualTo(kind, 1) ThenBlock: {
                LnConfig.backup = 1
            }
        } ElseBlock: {
            IfCondition EqualTo(kind, 1) ThenBlock: {
                LnConfig.suffix = val
                LnConfig.backup = 1
            } ElseBlock: {
                LnConfig.target_dir = val
            }
        }
    }
}

Function.RejectOpt {
    Input: flag: Address
    Body: {
        WriteStderr("ln: unrecognized option '")
        WriteStderr(flag)
        WriteStderr("'\n")
        WriteStderr("Try 'ln --help' for more information.\n")
        LnConfig.opt_fail = 1
    }
}

Function.ParseLong {
    Input: flag: Address
    Body: {
        is_help = OptPrefix(flag, "help", 4)
        IfCondition NotEqual(is_help, 0) ThenBlock: {
            ShowHelp()
            SystemCall(60, 0)
        }
        is_verb = OptPrefix(flag, "verbose", 7)
        is_vers = OptPrefix(flag, "version", 7)
        both = And(NotEqual(is_verb, 0), NotEqual(is_vers, 0))
        IfCondition NotEqual(both, 0) ThenBlock: {
            RejectOpt(flag)
            ReturnValue(0)
        }
        IfCondition NotEqual(is_verb, 0) ThenBlock: {
            LnConfig.verbose = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(is_vers, 0) ThenBlock: {
            ShowVersion()
            SystemCall(60, 0)
        }
        is_sym = OptPrefix(flag, "symbolic", 8)
        is_suf = OptPrefix(flag, "suffix", 6)
        both = And(NotEqual(is_sym, 0), NotEqual(is_suf, 0))
        IfCondition NotEqual(both, 0) ThenBlock: {
            RejectOpt(flag)
            ReturnValue(0)
        }
        IfCondition NotEqual(is_sym, 0) ThenBlock: {
            LnConfig.symbolic = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(is_suf, 0) ThenBlock: {
            TakeValue(flag, 1)
            ReturnValue(0)
        }
        is_nd = OptPrefix(flag, "no-dereference", 14)
        is_nt = OptPrefix(flag, "no-target-directory", 19)
        both = And(NotEqual(is_nd, 0), NotEqual(is_nt, 0))
        IfCondition NotEqual(both, 0) ThenBlock: {
            RejectOpt(flag)
            ReturnValue(0)
        }
        IfCondition NotEqual(is_nd, 0) ThenBlock: {
            LnConfig.no_dereference = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(is_nt, 0) ThenBlock: {
            LnConfig.no_target_dir = 1
            ReturnValue(0)
        }
        is_bak = OptPrefix(flag, "backup", 6)
        IfCondition NotEqual(is_bak, 0) ThenBlock: {
            LnConfig.backup = 1
            ReturnValue(0)
        }
        is_force = OptPrefix(flag, "force", 5)
        IfCondition NotEqual(is_force, 0) ThenBlock: {
            LnConfig.force = 1
            ReturnValue(0)
        }
        is_int = OptPrefix(flag, "interactive", 11)
        IfCondition NotEqual(is_int, 0) ThenBlock: {
            LnConfig.interactive = 1
            ReturnValue(0)
        }
        is_log = OptPrefix(flag, "logical", 7)
        IfCondition NotEqual(is_log, 0) ThenBlock: {
            LnConfig.logical = 1
            ReturnValue(0)
        }
        is_phy = OptPrefix(flag, "physical", 8)
        IfCondition NotEqual(is_phy, 0) ThenBlock: {
            LnConfig.logical = 0
            ReturnValue(0)
        }
        is_rel = OptPrefix(flag, "relative", 8)
        IfCondition NotEqual(is_rel, 0) ThenBlock: {
            LnConfig.relative = 1
            ReturnValue(0)
        }
        is_td = OptPrefix(flag, "target-directory", 16)
        IfCondition NotEqual(is_td, 0) ThenBlock: {
            TakeValue(flag, 2)
            ReturnValue(0)
        }
        RejectOpt(flag)
    }
}

Function.ParseShort {
    Input: flag: Address
    Body: {
        i = 1
        one = 1
        WhileLoop NotEqual(RDMEM_8(flag, i), 0) {
            c = RDMEM_8(flag, i)
            known = 0
            IfCondition EqualTo(c, 115) ThenBlock: {
                LnConfig.symbolic = 1
                known = 1
            }
            IfCondition EqualTo(c, 102) ThenBlock: {
                LnConfig.force = 1
                known = 1
            }
            IfCondition EqualTo(c, 105) ThenBlock: {
                LnConfig.interactive = 1
                known = 1
            }
            IfCondition EqualTo(c, 118) ThenBlock: {
                LnConfig.verbose = 1
                known = 1
            }
            IfCondition EqualTo(c, 110) ThenBlock: {
                LnConfig.no_dereference = 1
                known = 1
            }
            IfCondition EqualTo(c, 98) ThenBlock: {
                LnConfig.backup = 1
                known = 1
            }
            IfCondition EqualTo(c, 114) ThenBlock: {
                LnConfig.relative = 1
                known = 1
            }
            IfCondition EqualTo(c, 84) ThenBlock: {
                LnConfig.no_target_dir = 1
                known = 1
            }
            IfCondition EqualTo(c, 76) ThenBlock: {
                LnConfig.logical = 1
                known = 1
            }
            IfCondition EqualTo(c, 80) ThenBlock: {
                LnConfig.logical = 0
                known = 1
            }
            IfCondition EqualTo(c, 83) ThenBlock: {
                LnConfig.backup = 1
                nxt = Add(i, one)
                IfCondition EqualTo(RDMEM_8(flag, nxt), 0) ThenBlock: {
                    LnConfig.want_arg = 1
                } ElseBlock: {
                    LnConfig.suffix = CopyFrom(flag, nxt)
                }
                ReturnValue(0)
            }
            IfCondition EqualTo(c, 116) ThenBlock: {
                nxt = Add(i, one)
                IfCondition EqualTo(RDMEM_8(flag, nxt), 0) ThenBlock: {
                    LnConfig.want_arg = 2
                } ElseBlock: {
                    LnConfig.target_dir = CopyFrom(flag, nxt)
                }
                ReturnValue(0)
            }
            IfCondition EqualTo(known, 0) ThenBlock: {
                WriteStderr("ln: invalid option -- '")
                oneb = Allocate(2)
                WRMEM_8(oneb, 0, c)
                WRMEM_8(oneb, 1, 0)
                WriteStderr(oneb)
                Deallocate(oneb, 2)
                WriteStderr("'\n")
                LnConfig.opt_fail = 1
                ReturnValue(0)
            }
            i = Add(i, one)
        }
    }
}

Function.GetU32 {
    Input: buf: Address
    Input: off: Integer
    Output: Integer
    Body: {
        b0 = RDMEM_8(buf, off)
        o1 = Add(off, 1)
        o2 = Add(off, 2)
        o3 = Add(off, 3)
        b1 = RDMEM_8(buf, o1)
        b2 = RDMEM_8(buf, o2)
        b3 = RDMEM_8(buf, o3)
        v = b0
        v = Add(v, Multiply(b1, 256))
        v = Add(v, Multiply(b2, 65536))
        v = Add(v, Multiply(b3, 16777216))
        ReturnValue(v)
    }
}

Function.StatAt {
    Input: path: Address
    Input: flags: Integer
    Input: buf: Address
    Output: Integer
    Body: {
        rc = SystemCall(262, -100, path, buf, flags)
        ReturnValue(rc)
    }
}

Function.EndsSlash {
    Input: path: Address
    Output: Integer
    Body: {
        n = StringLength(path)
        IfCondition EqualTo(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        last = Subtract(n, 1)
        c = RDMEM_8(path, last)
        IfCondition EqualTo(c, 47) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.FieldEq {
    Input: a: Address
    Input: b: Address
    Input: off: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            pa = Add(off, i)
            ca = RDMEM_8(a, pa)
            cb = RDMEM_8(b, pa)
            IfCondition NotEqual(ca, cb) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        ReturnValue(1)
    }
}

Function.NlinkOne {
    Input: buf: Address
    Output: Integer
    Body: {
        b = RDMEM_8(buf, 16)
        IfCondition NotEqual(b, 1) ThenBlock: {
            ReturnValue(0)
        }
        i = 17
        one = 1
        WhileLoop LessThan(i, 24) {
            c = RDMEM_8(buf, i)
            IfCondition NotEqual(c, 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        ReturnValue(1)
    }
}

Function.SameFile {
    Input: src: Address
    Input: dst: Address
    Output: Integer
    Body: {
        sa = Allocate(144)
        sb = Allocate(144)
        ra = StatAt(src, 0, sa)
        rb = StatAt(dst, 256, sb)
        same = 0
        IfCondition GreaterEqual(ra, 0) ThenBlock: {
            IfCondition GreaterEqual(rb, 0) ThenBlock: {
                dev = FieldEq(sa, sb, 0, 8)
                ino = FieldEq(sa, sb, 8, 8)
                both = And(NotEqual(dev, 0), NotEqual(ino, 0))
                IfCondition NotEqual(both, 0) ThenBlock: {
                    one = NlinkOne(sa)
                    IfCondition NotEqual(one, 0) ThenBlock: {
                        same = 1
                    } ElseBlock: {
                        eq = StringCompare(src, dst)
                        IfCondition NotEqual(eq, 0) ThenBlock: {
                            same = 1
                        }
                    }
                }
            }
        }
        Deallocate(sa, 144)
        Deallocate(sb, 144)
        ReturnValue(same)
    }
}

Function.JoinSuffix {
    Input: dest: Address
    Output: Address
    Body: {
        dlen = StringLength(dest)
        slen = 1
        IfCondition NotEqual(LnConfig.suffix, 0) ThenBlock: {
            slen = StringLength(LnConfig.suffix)
        }
        total = Add(dlen, slen)
        total = Add(total, 1)
        out = Allocate(total)
        i = 0
        one = 1
        WhileLoop LessThan(i, dlen) {
            WRMEM_8(out, i, RDMEM_8(dest, i))
            i = Add(i, one)
        }
        IfCondition EqualTo(LnConfig.suffix, 0) ThenBlock: {
            WRMEM_8(out, dlen, 126)
        } ElseBlock: {
            j = 0
            WhileLoop LessThan(j, slen) {
                at = Add(dlen, j)
                WRMEM_8(out, at, RDMEM_8(LnConfig.suffix, j))
                j = Add(j, one)
            }
        }
        endp = Add(dlen, slen)
        WRMEM_8(out, endp, 0)
        ReturnValue(out)
    }
}

Function.BackupDest {
    Input: dest: Address
    Output: Integer
    Body: {
        name = JoinSuffix(dest)
        nlen = StringLength(name)
        rc = SystemCall(82, dest, name)
        freen = Add(nlen, 1)
        Deallocate(name, freen)
        IfCondition LessThan(rc, 0) ThenBlock: {
            WriteStderr("ln: cannot backup '")
            WriteStderr(dest)
            WriteStderr("': ")
            err = GetErrorString(rc)
            WriteStderr(err)
            WriteStderr("\n")
            ReturnValue(1)
        }
        buf = Allocate(144)
        st = StatAt(dest, 256, buf)
        Deallocate(buf, 144)
        IfCondition GreaterEqual(st, 0) ThenBlock: {
            SystemCall(87, dest)
        }
        ReturnValue(0)
    }
}

Function.DestIsDir {
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(LnConfig.no_target_dir, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf = Allocate(144)
        flags = 0
        IfCondition NotEqual(LnConfig.no_dereference, 0) ThenBlock: {
            flags = 256
        }
        rc = StatAt(path, flags, buf)
        IfCondition LessThan(rc, 0) ThenBlock: {
            Deallocate(buf, 144)
            ReturnValue(0)
        }
        mode = GetU32(buf, 24)
        typ = BitwiseAnd(mode, 61440)
        Deallocate(buf, 144)
        IfCondition EqualTo(typ, 16384) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.CopyInto {
    Input: dst: Address
    Input: src: Address
    Body: {
        i = 0
        one = 1
        WhileLoop 1 {
            c = RDMEM_8(src, i)
            WRMEM_8(dst, i, c)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
    }
}

Function.ShiftDown {
    Input: buf: Address
    Input: from: Integer
    Body: {
        j = 0
        one = 1
        WhileLoop 1 {
            c = RDMEM_8(buf, from)
            WRMEM_8(buf, j, c)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(0)
            }
            j = Add(j, one)
            from = Add(from, one)
        }
    }
}

Function.PopCur {
    Input: cur: Address
    Body: {
        len = StringLength(cur)
        IfCondition LessEqual(len, 1) ThenBlock: {
            WRMEM_8(cur, 0, 47)
            WRMEM_8(cur, 1, 0)
            ReturnValue(0)
        }
        cut = 0
        i = 0
        one = 1
        WhileLoop LessThan(i, len) {
            c = RDMEM_8(cur, i)
            IfCondition EqualTo(c, 47) ThenBlock: {
                cut = i
            }
            i = Add(i, one)
        }
        IfCondition EqualTo(cut, 0) ThenBlock: {
            WRMEM_8(cur, 0, 47)
            WRMEM_8(cur, 1, 0)
        } ElseBlock: {
            WRMEM_8(cur, cut, 0)
        }
    }
}

Function.AppendComp {
    Input: cur: Address
    Input: rest: Address
    Input: start: Integer
    Input: clen: Integer
    Body: {
        cur_len = StringLength(cur)
        pos = cur_len
        one = 1
        IfCondition EqualTo(cur_len, 1) ThenBlock: {
            c0 = RDMEM_8(cur, 0)
            IfCondition EqualTo(c0, 47) ThenBlock: {
                pos = 1
            }
        }
        IfCondition NotEqual(pos, 1) ThenBlock: {
            WRMEM_8(cur, cur_len, 47)
            pos = Add(cur_len, one)
        }
        IfCondition EqualTo(cur_len, 1) ThenBlock: {
            c0 = RDMEM_8(cur, 0)
            IfCondition NotEqual(c0, 47) ThenBlock: {
                WRMEM_8(cur, cur_len, 47)
                pos = Add(cur_len, one)
            }
        }
        j = 0
        WhileLoop LessThan(j, clen) {
            src = Add(start, j)
            ch = RDMEM_8(rest, src)
            WRMEM_8(cur, pos, ch)
            pos = Add(pos, one)
            j = Add(j, one)
        }
        WRMEM_8(cur, pos, 0)
    }
}

Function.SkipSlashes {
    Input: p: Address
    Input: idx: Integer
    Output: Integer
    Body: {
        out = idx
        one = 1
        WhileLoop 1 {
            c = RDMEM_8(p, out)
            IfCondition NotEqual(c, 47) ThenBlock: {
                ReturnValue(out)
            }
            nxt = Add(out, one)
            out = nxt
        }
        ReturnValue(idx)
    }
}

Function.CompEnd {
    Input: p: Address
    Input: idx: Integer
    Output: Integer
    Body: {
        out = idx
        one = 1
        WhileLoop 1 {
            c = RDMEM_8(p, out)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(out)
            }
            IfCondition EqualTo(c, 47) ThenBlock: {
                ReturnValue(out)
            }
            nxt = Add(out, one)
            out = nxt
        }
        ReturnValue(out)
    }
}

Function.CompEq {
    Input: a: Address
    Input: ai: Integer
    Input: b: Address
    Input: bi: Integer
    Output: Integer
    Body: {
        one = 1
        WhileLoop 1 {
            ca = RDMEM_8(a, ai)
            cb = RDMEM_8(b, bi)
            aend = 0
            IfCondition EqualTo(ca, 0) ThenBlock: { aend = 1 }
            IfCondition EqualTo(ca, 47) ThenBlock: { aend = 1 }
            bend = 0
            IfCondition EqualTo(cb, 0) ThenBlock: { bend = 1 }
            IfCondition EqualTo(cb, 47) ThenBlock: { bend = 1 }
            both = And(NotEqual(aend, 0), NotEqual(bend, 0))
            IfCondition NotEqual(both, 0) ThenBlock: {
                ReturnValue(1)
            }
            either = Or(NotEqual(aend, 0), NotEqual(bend, 0))
            IfCondition NotEqual(either, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition NotEqual(ca, cb) ThenBlock: {
                ReturnValue(0)
            }
            ai = Add(ai, one)
            bi = Add(bi, one)
        }
        ReturnValue(0)
    }
}

Function.DirName {
    Input: path: Address
    Output: Address
    Body: {
        len = StringLength(path)
        out = Allocate(4096)
        IfCondition EqualTo(len, 0) ThenBlock: {
            WRMEM_8(out, 0, 46)
            WRMEM_8(out, 1, 0)
            ReturnValue(out)
        }
        endp = len
        one = 1
        WhileLoop GreaterThan(endp, 1) {
            prev = Subtract(endp, one)
            c = RDMEM_8(path, prev)
            IfCondition NotEqual(c, 47) ThenBlock: {
                BreakLoop
            }
            endp = prev
        }
        cut = -1
        i = 0
        WhileLoop LessThan(i, endp) {
            c = RDMEM_8(path, i)
            IfCondition EqualTo(c, 47) ThenBlock: {
                cut = i
            }
            i = Add(i, one)
        }
        IfCondition LessThan(cut, 0) ThenBlock: {
            WRMEM_8(out, 0, 46)
            WRMEM_8(out, 1, 0)
            ReturnValue(out)
        }
        IfCondition EqualTo(cut, 0) ThenBlock: {
            WRMEM_8(out, 0, 47)
            WRMEM_8(out, 1, 0)
            ReturnValue(out)
        }
        i = 0
        WhileLoop LessThan(i, cut) {
            WRMEM_8(out, i, RDMEM_8(path, i))
            i = Add(i, one)
        }
        WRMEM_8(out, cut, 0)
        ReturnValue(out)
    }
}

Function.RelPath {
    Input: from: Address
    Input: dir: Address
    Output: Address
    Body: {
        ai = SkipSlashes(from, 0)
        bi = SkipSlashes(dir, 0)
        one = 1
        guard = 0
        WhileLoop LessThan(guard, 64) {
            fa = RDMEM_8(from, ai)
            db = RDMEM_8(dir, bi)
            IfCondition EqualTo(fa, 0) ThenBlock: { BreakLoop }
            IfCondition EqualTo(db, 0) ThenBlock: { BreakLoop }
            eq = CompEq(from, ai, dir, bi)
            IfCondition EqualTo(eq, 0) ThenBlock: { BreakLoop }
            ai = CompEnd(from, ai)
            ai = SkipSlashes(from, ai)
            bi = CompEnd(dir, bi)
            bi = SkipSlashes(dir, bi)
            guard = Add(guard, one)
        }
        ups = 0
        bj = bi
        ug = 0
        WhileLoop LessThan(ug, 64) {
            IfCondition EqualTo(RDMEM_8(dir, bj), 0) ThenBlock: { BreakLoop }
            ups = Add(ups, one)
            bj = CompEnd(dir, bj)
            bj = SkipSlashes(dir, bj)
            ug = Add(ug, one)
        }
        out = Allocate(4096)
        at = 0
        u = 0
        step = 3
        WhileLoop LessThan(u, ups) {
            WRMEM_8(out, at, 46)
            p1 = Add(at, one)
            WRMEM_8(out, p1, 46)
            p2 = Add(at, 2)
            WRMEM_8(out, p2, 47)
            nxt = Add(at, step)
            at = nxt
            u = Add(u, one)
        }
        pos = at
        IfCondition EqualTo(RDMEM_8(from, ai), 0) ThenBlock: {
            IfCondition GreaterThan(pos, 0) ThenBlock: {
                pos = Subtract(pos, one)
            }
            IfCondition EqualTo(pos, 0) ThenBlock: {
                WRMEM_8(out, 0, 46)
                pos = 1
            }
        } ElseBlock: {
            k = ai
            WhileLoop NotEqual(RDMEM_8(from, k), 0) {
                WRMEM_8(out, pos, RDMEM_8(from, k))
                nxt = Add(pos, one)
                pos = nxt
                nk = Add(k, one)
                k = nk
            }
        }
        WRMEM_8(out, pos, 0)
        ReturnValue(out)
    }
}

Function.Resolve {
    Input: path: Address
    Output: Address
    Body: {
        IfCondition EqualTo(RDMEM_8(path, 0), 0) ThenBlock: {
            ReturnValue(0)
        }
        cur = Allocate(4096)
        rest = Allocate(4096)
        linkb = Allocate(4096)
        tmp = Allocate(4096)
        one = 1
        IfCondition EqualTo(RDMEM_8(path, 0), 47) ThenBlock: {
            WRMEM_8(cur, 0, 47)
            WRMEM_8(cur, 1, 0)
        } ElseBlock: {
            n = SystemCall(79, cur, 4095)
            IfCondition LessThan(n, 0) ThenBlock: {
                WRMEM_8(cur, 0, 47)
                WRMEM_8(cur, 1, 0)
            }
        }
        CopyInto(rest, path)
        failed = 0
        steps = 0
        syms = 0
        WhileLoop LessThan(steps, 256) {
            steps = Add(steps, one)
            scan = 0
            k = 0
            WhileLoop EqualTo(RDMEM_8(rest, scan), 47) {
                nxt = Add(scan, one)
                k = nxt
                scan = nxt
            }
            IfCondition EqualTo(RDMEM_8(rest, k), 0) ThenBlock: {
                BreakLoop
            }
            start = k
            kend = k
            posk = k
            WhileLoop 1 {
                c = RDMEM_8(rest, posk)
                kend = posk
                IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
                IfCondition EqualTo(c, 47) ThenBlock: { BreakLoop }
                nxt = Add(posk, one)
                posk = nxt
            }
            clen = Subtract(kend, start)
            k = kend
            is_dot = 0
            IfCondition EqualTo(clen, 1) ThenBlock: {
                IfCondition EqualTo(RDMEM_8(rest, start), 46) ThenBlock: {
                    is_dot = 1
                }
            }
            is_dd = 0
            IfCondition EqualTo(clen, 2) ThenBlock: {
                c0 = RDMEM_8(rest, start)
                s1 = Add(start, one)
                c1 = RDMEM_8(rest, s1)
                IfCondition EqualTo(c0, 46) ThenBlock: {
                    IfCondition EqualTo(c1, 46) ThenBlock: {
                        is_dd = 1
                    }
                }
            }
            IfCondition NotEqual(is_dot, 0) ThenBlock: {
                ShiftDown(rest, k)
                ContinueLoop
            }
            IfCondition NotEqual(is_dd, 0) ThenBlock: {
                PopCur(cur)
                ShiftDown(rest, k)
                ContinueLoop
            }
            old_len = StringLength(cur)
            AppendComp(cur, rest, start, clen)
            rn = SystemCall(89, cur, linkb, 4095)
            IfCondition GreaterEqual(rn, 0) ThenBlock: {
                WRMEM_8(linkb, rn, 0)
                syms = Add(syms, one)
                IfCondition GreaterThan(syms, 40) ThenBlock: {
                    failed = 1
                    BreakLoop
                }
                IfCondition EqualTo(RDMEM_8(linkb, 0), 47) ThenBlock: {
                    WRMEM_8(cur, 0, 47)
                    WRMEM_8(cur, 1, 0)
                } ElseBlock: {
                    WRMEM_8(cur, old_len, 0)
                }
                CopyInto(tmp, linkb)
                scan = k
                m = k
                WhileLoop EqualTo(RDMEM_8(rest, scan), 47) {
                    nxt = Add(scan, one)
                    m = nxt
                    scan = nxt
                }
                IfCondition NotEqual(RDMEM_8(rest, m), 0) ThenBlock: {
                    tlen = StringLength(tmp)
                    IfCondition GreaterThan(tlen, 0) ThenBlock: {
                        last = Subtract(tlen, one)
                        lb = RDMEM_8(tmp, last)
                        IfCondition NotEqual(lb, 47) ThenBlock: {
                            WRMEM_8(tmp, tlen, 47)
                            tlen = Add(tlen, one)
                        }
                    }
                    q = 0
                    endq = tlen
                    WhileLoop NotEqual(RDMEM_8(rest, m), 0) {
                        at = Add(tlen, q)
                        WRMEM_8(tmp, at, RDMEM_8(rest, m))
                        nq = Add(q, one)
                        endq = Add(tlen, nq)
                        q = nq
                        nm = Add(m, one)
                        m = nm
                    }
                    WRMEM_8(tmp, endq, 0)
                }
                CopyInto(rest, tmp)
                ContinueLoop
            }
            errn = Subtract(0, rn)
            scan = k
            mend = k
            WhileLoop EqualTo(RDMEM_8(rest, scan), 47) {
                nxt = Add(scan, one)
                mend = nxt
                scan = nxt
            }
            lastc = 0
            IfCondition EqualTo(RDMEM_8(rest, mend), 0) ThenBlock: {
                lastc = 1
            }
            IfCondition EqualTo(errn, 22) ThenBlock: {
                ShiftDown(rest, k)
                ContinueLoop
            }
            IfCondition EqualTo(errn, 2) ThenBlock: {
                IfCondition NotEqual(lastc, 0) ThenBlock: {
                    BreakLoop
                }
                failed = 1
                BreakLoop
            }
            failed = 1
            BreakLoop
        }
        Deallocate(rest, 4096)
        Deallocate(linkb, 4096)
        Deallocate(tmp, 4096)
        IfCondition NotEqual(failed, 0) ThenBlock: {
            Deallocate(cur, 4096)
            ReturnValue(0)
        }
        ReturnValue(cur)
    }
}

Function.MakeRelative {
    Input: source: Address
    Input: dest: Address
    Output: Address
    Body: {
        dn = DirName(dest)
        rd = Resolve(dn)
        rf = Resolve(source)
        Deallocate(dn, 4096)
        IfCondition EqualTo(rd, 0) ThenBlock: {
            IfCondition NotEqual(rf, 0) ThenBlock: {
                Deallocate(rf, 4096)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(rf, 0) ThenBlock: {
            Deallocate(rd, 4096)
            ReturnValue(0)
        }
        rel = RelPath(rf, rd)
        Deallocate(rd, 4096)
        Deallocate(rf, 4096)
        ReturnValue(rel)
    }
}

Function.CreateLink {
    Input: target: Address
    Input: linkname: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LnConfig.symbolic, 0) ThenBlock: {
            flags = 256
            IfCondition NotEqual(LnConfig.logical, 0) ThenBlock: {
                flags = 0
            }
            slash = EndsSlash(target)
            IfCondition NotEqual(slash, 0) ThenBlock: {
                flags = 0
            }
            sbuf = Allocate(144)
            src_rc = StatAt(target, flags, sbuf)
            IfCondition LessThan(src_rc, 0) ThenBlock: {
                WriteStderr("ln: failed to access '")
                WriteStderr(target)
                WriteStderr("': ")
                err = GetErrorString(src_rc)
                WriteStderr(err)
                WriteStderr("\n")
                Deallocate(sbuf, 144)
                LnStats.errors = Add(LnStats.errors, 1)
                ReturnValue(1)
            }
            mode = GetU32(sbuf, 24)
            typ = BitwiseAnd(mode, 61440)
            Deallocate(sbuf, 144)
            IfCondition EqualTo(typ, 16384) ThenBlock: {
                WriteStderr("ln: ")
                WriteStderr(target)
                WriteStderr(": hard link not allowed for directory\n")
                LnStats.errors = Add(LnStats.errors, 1)
                ReturnValue(1)
            }
        }

        dbuf = Allocate(144)
        dst_rc = StatAt(linkname, 256, dbuf)
        IfCondition GreaterEqual(dst_rc, 0) ThenBlock: {
            mode = GetU32(dbuf, 24)
            typ = BitwiseAnd(mode, 61440)
            Deallocate(dbuf, 144)
            IfCondition EqualTo(typ, 16384) ThenBlock: {
                WriteStderr("ln: '")
                WriteStderr(linkname)
                WriteStderr("': cannot overwrite directory\n")
                LnStats.errors = Add(LnStats.errors, 1)
                ReturnValue(1)
            }
            IfCondition EqualTo(LnConfig.symbolic, 0) ThenBlock: {
                IfCondition EqualTo(LnConfig.backup, 0) ThenBlock: {
                    IfCondition NotEqual(LnConfig.force, 0) ThenBlock: {
                        seen = HitLn(linkname)
                        IfCondition EqualTo(seen, 1) ThenBlock: {
                            WriteStderr("ln: will not overwrite just-created '")
                            WriteStderr(linkname)
                            WriteStderr("' with '")
                            WriteStderr(target)
                            WriteStderr("'\n")
                            LnStats.errors = Add(LnStats.errors, 1)
                            ReturnValue(1)
                        }
                    }
                }
            }
            check = 0
            IfCondition NotEqual(LnConfig.force, 0) ThenBlock: {
                check = 1
            }
            IfCondition NotEqual(LnConfig.backup, 0) ThenBlock: {
                IfCondition EqualTo(LnConfig.symbolic, 0) ThenBlock: {
                    check = 1
                }
            }
            IfCondition NotEqual(check, 0) ThenBlock: {
                same = SameFile(target, linkname)
                IfCondition NotEqual(same, 0) ThenBlock: {
                    WriteStderr("ln: '")
                    WriteStderr(target)
                    WriteStderr("' and '")
                    WriteStderr(linkname)
                    WriteStderr("' are the same file\n")
                    LnStats.errors = Add(LnStats.errors, 1)
                    ReturnValue(1)
                }
            }
            allow = 0
            IfCondition NotEqual(LnConfig.force, 0) ThenBlock: { allow = 1 }
            IfCondition NotEqual(LnConfig.backup, 0) ThenBlock: { allow = 1 }
            IfCondition NotEqual(LnConfig.interactive, 0) ThenBlock: { allow = 1 }
            IfCondition EqualTo(allow, 0) ThenBlock: {
                WriteStderr("ln: failed to create ")
                IfCondition NotEqual(LnConfig.symbolic, 0) ThenBlock: {
                    WriteStderr("symbolic ")
                }
                WriteStderr("link '")
                WriteStderr(linkname)
                WriteStderr("': File exists\n")
                LnStats.errors = Add(LnStats.errors, 1)
                ReturnValue(1)
            }
            IfCondition NotEqual(LnConfig.interactive, 0) ThenBlock: {
                WriteStderr("ln: replace '")
                WriteStderr(linkname)
                WriteStderr("'? ")
                response = PromptUser("")
                IfCondition EqualTo(response, 0) ThenBlock: {
                    LnStats.errors = Add(LnStats.errors, 1)
                    ReturnValue(1)
                }
            }
            IfCondition NotEqual(LnConfig.backup, 0) ThenBlock: {
                backed = BackupDest(linkname)
                IfCondition NotEqual(backed, 0) ThenBlock: {
                    LnStats.errors = Add(LnStats.errors, 1)
                    ReturnValue(1)
                }
            }
            still = Allocate(144)
            st = StatAt(linkname, 256, still)
            Deallocate(still, 144)
            IfCondition GreaterEqual(st, 0) ThenBlock: {
                un = SystemCall(87, linkname)
                IfCondition LessThan(un, 0) ThenBlock: {
                    WriteStderr("ln: cannot remove '")
                    WriteStderr(linkname)
                    WriteStderr("': ")
                    err = GetErrorString(un)
                    WriteStderr(err)
                    WriteStderr("\n")
                    LnStats.errors = Add(LnStats.errors, 1)
                    ReturnValue(1)
                }
            }
        } ElseBlock: {
            Deallocate(dbuf, 144)
        }

        use = target
        rel = 0
        IfCondition NotEqual(LnConfig.symbolic, 0) ThenBlock: {
            IfCondition NotEqual(LnConfig.relative, 0) ThenBlock: {
                rel = MakeRelative(target, linkname)
                IfCondition NotEqual(rel, 0) ThenBlock: {
                    use = rel
                }
            }
        }

        result = 0
        IfCondition NotEqual(LnConfig.symbolic, 0) ThenBlock: {
            result = SystemCall(88, use, linkname)
        } ElseBlock: {
            lf = 0
            IfCondition NotEqual(LnConfig.logical, 0) ThenBlock: {
                lf = 1024
            }
            result = SystemCall(265, -100, target, -100, linkname, lf)
        }

        IfCondition LessThan(result, 0) ThenBlock: {
            WriteStderr("ln: failed to create ")
            IfCondition NotEqual(LnConfig.symbolic, 0) ThenBlock: {
                WriteStderr("symbolic ")
            }
            WriteStderr("link '")
            WriteStderr(linkname)
            WriteStderr("'")
            empty = RDMEM_8(use, 0)
            show_src = 0
            IfCondition EqualTo(LnConfig.symbolic, 0) ThenBlock: {
                show_src = 1
            }
            IfCondition EqualTo(empty, 0) ThenBlock: {
                show_src = 1
            }
            IfCondition NotEqual(show_src, 0) ThenBlock: {
                IfCondition NotEqual(LnConfig.symbolic, 0) ThenBlock: {
                    WriteStderr(" -> '")
                } ElseBlock: {
                    WriteStderr(" => '")
                }
                WriteStderr(use)
                WriteStderr("'")
            }
            WriteStderr(": ")
            err = GetErrorString(result)
            WriteStderr(err)
            WriteStderr("\n")
            IfCondition NotEqual(rel, 0) ThenBlock: {
                Deallocate(rel, 4096)
            }
            LnStats.errors = Add(LnStats.errors, 1)
            ReturnValue(1)
        }

        IfCondition NotEqual(rel, 0) ThenBlock: {
            Deallocate(rel, 4096)
        }
        LnStats.created = Add(LnStats.created, 1)
        IfCondition NotEqual(LnConfig.verbose, 0) ThenBlock: {
            WriteStderr("'")
            WriteStderr(linkname)
            WriteStderr("' -> '")
            WriteStderr(use)
            WriteStderr("'\n")
        }
        IfCondition EqualTo(LnConfig.symbolic, 0) ThenBlock: {
            NoteLn(linkname)
        }
        ReturnValue(0)
    }
}

Function.HitLn {
    Input: path: Address
    Output: Integer
    Body: {
        i = 0
        one = 1
        n = LnSeen.n
        WhileLoop LessThan(i, n) {
            saved = ArrayGet(LnSeen.paths, i)
            hit = StringEquals(saved, path)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.NoteLn {
    Input: path: Address
    Body: {
        slot = LnSeen.n
        IfCondition LessThan(slot, 64) ThenBlock: {
            kept = CopyFrom(path, 0)
            ArraySet(LnSeen.paths, slot, kept)
            LnSeen.n = Add(slot, 1)
        }
    }
}
