// logname.ailang - Print the user's login name.
//
// POSIX: "shall write the user's login name to standard output. The login
// name shall be the string that would be returned by getlogin()."
// getlogin(3) walks the utmp database; on Linux the canonical equivalent
// is reading /proc/self/loginuid — the audit-subsystem "login UID"
// inherited from whichever session originally authenticated. If no login
// session is associated with the process (daemons, cron, WSL without
// pam_loginuid), the file contains "4294967295" (i.e. -1 / no id) and
// POSIX mandates an error: "no login name".
//
// Previously this util did `id -un` semantics (getuid → /etc/passwd).
// That is useful but NOT logname; it returns a name even for daemon
// sessions, which hides the "is this a real login?" signal.

LibraryImport.Arena

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.WriteStdout {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 1, buffer, len)
    }
}

// Parse an ASCII decimal integer out of buffer[0..len]. Stops at the
// first non-digit (including newline). Returns -1 on empty / invalid.
Function.ParseDecimalUid {
    Input: buf: Address
    Input: len: Integer
    Output: Integer
    Body: {
        v = 0
        seen = 0
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(buf, i)
            IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                v = Add(Multiply(v, 10), Subtract(ch, 48))
                seen = 1
            } ElseBlock: {
                BreakLoop
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(seen, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(v)
    }
}

// Look up a UID in /etc/passwd and write the matching username + '\n'
// to stdout. Returns 1 on success, 0 if no entry matched.
Function.WriteUsernameForUid {
    Input: uid: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, "/etc/passwd", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }

        buf = Allocate(8192)
        n = SystemCall(0, fd, buf, 8192)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 8192)
            ReturnValue(0)
        }

        ok = 0
        i = 0
        line_start = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(GetByte(buf, i), 10) ThenBlock: {
                // Line: user:x:uid:gid:...:shell
                colons = 0
                uid_start = 0
                username_end = line_start
                found_user_end = 0
                j = line_start
                WhileLoop LessThan(j, i) {
                    c = GetByte(buf, j)
                    IfCondition EqualTo(c, 58) ThenBlock: {
                        colons = Add(colons, 1)
                        IfCondition EqualTo(colons, 1) ThenBlock: {
                            username_end = j
                            found_user_end = 1
                        }
                        IfCondition EqualTo(colons, 2) ThenBlock: {
                            uid_start = Add(j, 1)
                        }
                        IfCondition EqualTo(colons, 3) ThenBlock: {
                            line_uid = ParseDecimalUid(Add(buf, uid_start), Subtract(j, uid_start))
                            IfCondition And(GreaterEqual(line_uid, 0), EqualTo(line_uid, uid)) ThenBlock: {
                                IfCondition EqualTo(found_user_end, 1) ThenBlock: {
                                    WriteStdout(Add(buf, line_start), Subtract(username_end, line_start))
                                    WriteStdout("\n", 1)
                                    ok = 1
                                }
                            }
                            BreakLoop
                        }
                    }
                    j = Add(j, 1)
                }
                IfCondition EqualTo(ok, 1) ThenBlock: { BreakLoop }
                line_start = Add(i, 1)
            }
            i = Add(i, 1)
        }

        Deallocate(buf, 8192)
        ReturnValue(ok)
    }
}

SubRoutine.Main {
    // Read /proc/self/loginuid. Missing file or unset ("4294967295" /
    // text "-1") → POSIX "no login name" error path.
    fd = SystemCall(257, -100, "/proc/self/loginuid", 0, 0)
    IfCondition LessThan(fd, 0) ThenBlock: {
        WriteStderr("logname: no login name\n")
        SystemCall(60, 1)
    }

    loginuid_buf = Allocate(32)
    n = SystemCall(0, fd, loginuid_buf, 32)
    SystemCall(3, fd)
    IfCondition LessEqual(n, 0) ThenBlock: {
        Deallocate(loginuid_buf, 32)
        WriteStderr("logname: no login name\n")
        SystemCall(60, 1)
    }

    loginuid = ParseDecimalUid(loginuid_buf, n)
    Deallocate(loginuid_buf, 32)

    // -1 (4294967295 when read as unsigned 32-bit) means "not set".
    // We also treat any parse failure as "not set".
    IfCondition Or(LessThan(loginuid, 0), EqualTo(loginuid, 4294967295)) ThenBlock: {
        WriteStderr("logname: no login name\n")
        SystemCall(60, 1)
    }

    ok = WriteUsernameForUid(loginuid)
    IfCondition EqualTo(ok, 0) ThenBlock: {
        WriteStderr("logname: no login name\n")
        SystemCall(60, 1)
    }

    SystemCall(60, 0)
}

RunTask(Main)
