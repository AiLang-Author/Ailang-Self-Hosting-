// Color, classify indicators, and long-format dates. Pools stay on ls.ailang. No Main.
LibraryImport.Arena

Function.FoldByte {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(ch, 65) ThenBlock: {
            IfCondition LessEqual(ch, 90) ThenBlock: {
                ReturnValue(Add(ch, 32))
            }
        }
        ReturnValue(ch)
    }
}
Function.EqBytes {
    Input: a: Address
    Input: b: Address
    Input: n: Integer
    Output: Integer
    Body: {
        one = 1
        i = 0
        IfCondition EqualTo(n, 0) ThenBlock: {
            ReturnValue(1)
        }
        WhileLoop LessThan(i, n) {
            ca = GetByte(a, i)
            cb = GetByte(b, i)
            IfCondition NotEqual(ca, cb) ThenBlock: {
                ReturnValue(0)
            }
            next = Add(i, one)
            IfCondition EqualTo(next, n) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(1)
    }
}
Function.EqFoldN {
    Input: a: Address
    Input: b: Address
    Input: n: Integer
    Output: Integer
    Body: {
        one = 1
        i = 0
        IfCondition EqualTo(n, 0) ThenBlock: {
            ReturnValue(1)
        }
        WhileLoop LessThan(i, n) {
            ra = GetByte(a, i)
            rb = GetByte(b, i)
            ca = FoldByte(ra)
            cb = FoldByte(rb)
            IfCondition NotEqual(ca, cb) ThenBlock: {
                ReturnValue(0)
            }
            next = Add(i, one)
            IfCondition EqualTo(next, n) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(1)
    }
}
Function.EqCStr {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        one = 1
        i = 0
        WhileLoop 1 {
            ca = GetByte(a, i)
            cb = GetByte(b, i)
            IfCondition NotEqual(ca, cb) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(ca, 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(1)
    }
}
Function.CopySpan {
    Input: base: Address
    Input: at: Integer
    Input: n: Integer
    Output: Address
    Body: {
        one = 1
        buf = Allocate(Add(n, 1))
        IfCondition EqualTo(n, 0) ThenBlock: {
            SetByte(buf, 0, 0)
            ReturnValue(buf)
        }
        i = 0
        WhileLoop LessThan(i, n) {
            src = Add(at, i)
            ch = GetByte(base, src)
            SetByte(buf, i, ch)
            next = Add(i, one)
            IfCondition EqualTo(next, n) ThenBlock: {
                SetByte(buf, n, 0)
                ReturnValue(buf)
            }
            i = Add(i, one)
        }
        SetByte(buf, n, 0)
        ReturnValue(buf)
    }
}
Function.StartsAt {
    Input: text: Address
    Input: at: Integer
    Input: word: Address
    Input: wlen: Integer
    Output: Integer
    Body: {
        one = 1
        i = 0
        WhileLoop LessThan(i, wlen) {
            pos = Add(at, i)
            c = GetByte(text, pos)
            w = GetByte(word, i)
            IfCondition NotEqual(c, w) ThenBlock: {
                ReturnValue(0)
            }
            next = Add(i, one)
            IfCondition EqualTo(next, wlen) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(1)
    }
}
Function.AtWord {
    Input: text: Address
    Input: at: Integer
    Input: word: Address
    Input: wlen: Integer
    Output: Integer
    Body: {
        hit = StartsAt(text, at, word, wlen)
        IfCondition EqualTo(hit, 0) ThenBlock: {
            ReturnValue(0)
        }
        endat = Add(at, wlen)
        endb = GetByte(text, endat)
        IfCondition NotEqual(endb, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}
Function.Colored {
    Input: code: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(code, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = StringLength(code)
        IfCondition EqualTo(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(n, 1) ThenBlock: {
            b = GetByte(code, 0)
            IfCondition EqualTo(b, 48) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(n, 2) ThenBlock: {
            b0 = GetByte(code, 0)
            b1 = GetByte(code, 1)
            IfCondition EqualTo(b0, 48) ThenBlock: {
                IfCondition EqualTo(b1, 48) ThenBlock: {
                    ReturnValue(0)
                }
            }
        }
        ReturnValue(1)
    }
}
Function.ReadTo {
    Input: buf: Address
    Input: stop1: Integer
    Input: stop2: Integer
    Output: Address
    Body: {
        one = 1
        start = LsPaint.scan
        i = start
        WhileLoop 1 {
            ch = GetByte(buf, i)
            IfCondition EqualTo(ch, stop1) ThenBlock: {
                n = Subtract(i, start)
                got = CopySpan(buf, start, n)
                LsPaint.scan = i
                ReturnValue(got)
            }
            IfCondition EqualTo(ch, stop2) ThenBlock: {
                n = Subtract(i, start)
                got = CopySpan(buf, start, n)
                LsPaint.scan = i
                ReturnValue(got)
            }
            IfCondition EqualTo(ch, 0) ThenBlock: {
                n = Subtract(i, start)
                got = CopySpan(buf, start, n)
                LsPaint.scan = i
                ReturnValue(got)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}
Function.SetKey {
    Input: k0: Integer
    Input: k1: Integer
    Input: code: Address
    Body: {
        IfCondition EqualTo(k0, 100) ThenBlock: {
            IfCondition EqualTo(k1, 105) ThenBlock: {
                LsPaint.c_di = code
            }
        }
        IfCondition EqualTo(k0, 101) ThenBlock: {
            IfCondition EqualTo(k1, 120) ThenBlock: {
                LsPaint.c_ex = code
            }
        }
        IfCondition EqualTo(k0, 108) ThenBlock: {
            IfCondition EqualTo(k1, 110) ThenBlock: {
                LsPaint.c_ln = code
            }
        }
        IfCondition EqualTo(k0, 111) ThenBlock: {
            IfCondition EqualTo(k1, 119) ThenBlock: {
                LsPaint.c_ow = code
            }
            IfCondition EqualTo(k1, 114) ThenBlock: {
                LsPaint.c_or = code
            }
        }
        IfCondition EqualTo(k0, 115) ThenBlock: {
            IfCondition EqualTo(k1, 116) ThenBlock: {
                LsPaint.c_st = code
            }
            IfCondition EqualTo(k1, 117) ThenBlock: {
                LsPaint.c_su = code
            }
            IfCondition EqualTo(k1, 103) ThenBlock: {
                LsPaint.c_sg = code
            }
            IfCondition EqualTo(k1, 111) ThenBlock: {
                LsPaint.c_so = code
            }
        }
        IfCondition EqualTo(k0, 116) ThenBlock: {
            IfCondition EqualTo(k1, 119) ThenBlock: {
                LsPaint.c_tw = code
            }
        }
        IfCondition EqualTo(k0, 109) ThenBlock: {
            IfCondition EqualTo(k1, 104) ThenBlock: {
                LsPaint.c_mh = code
            }
            IfCondition EqualTo(k1, 105) ThenBlock: {
                LsPaint.c_mi = code
            }
        }
        IfCondition EqualTo(k0, 102) ThenBlock: {
            IfCondition EqualTo(k1, 105) ThenBlock: {
                LsPaint.c_fi = code
            }
        }
        IfCondition EqualTo(k0, 112) ThenBlock: {
            IfCondition EqualTo(k1, 105) ThenBlock: {
                LsPaint.c_pi = code
            }
        }
        IfCondition EqualTo(k0, 98) ThenBlock: {
            IfCondition EqualTo(k1, 100) ThenBlock: {
                LsPaint.c_bd = code
            }
        }
        IfCondition EqualTo(k0, 99) ThenBlock: {
            IfCondition EqualTo(k1, 100) ThenBlock: {
                LsPaint.c_cd = code
            }
        }
        IfCondition EqualTo(k0, 110) ThenBlock: {
            IfCondition EqualTo(k1, 111) ThenBlock: {
                LsPaint.c_no = code
            }
        }
    }
}
Function.AddExt {
    Input: suf: Address
    Input: code: Address
    Body: {
        slot = LsPaint.ext_n
        IfCondition GreaterEqual(slot, 24) ThenBlock: {
            ReturnValue(0)
        }
        off = Multiply(slot, 8)
        sp = Add(LsPaint.ext_suf, off)
        StoreValue(sp, suf)
        cp = Add(LsPaint.ext_code, off)
        StoreValue(cp, code)
        slen = StringLength(suf)
        lp = Add(LsPaint.ext_len, off)
        StoreValue(lp, slen)
        ep = Add(LsPaint.ext_exact, off)
        StoreValue(ep, 0)
        dp = Add(LsPaint.ext_dead, off)
        StoreValue(dp, 0)
        LsPaint.ext_n = Add(slot, 1)
        ReturnValue(0)
    }
}
Function.TakeColorItem {
    Input: buf: Address
    Body: {
        start = LsPaint.scan
        ch = GetByte(buf, start)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(ch, 58) ThenBlock: {
            LsPaint.scan = Add(start, 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(ch, 42) ThenBlock: {
            LsPaint.scan = Add(start, 1)
            suf = ReadTo(buf, 61, 0)
            eq = GetByte(buf, LsPaint.scan)
            IfCondition EqualTo(eq, 61) ThenBlock: {
                LsPaint.scan = Add(LsPaint.scan, 1)
                code = ReadTo(buf, 58, 0)
                AddExt(suf, code)
            }
        } ElseBlock: {
            k1at = Add(start, 1)
            k1 = GetByte(buf, k1at)
            k2at = Add(start, 2)
            eq = GetByte(buf, k2at)
            IfCondition EqualTo(eq, 61) ThenBlock: {
                LsPaint.scan = Add(k2at, 1)
                code = ReadTo(buf, 58, 0)
                SetKey(ch, k1, code)
            }
        }
        IfCondition EqualTo(LsPaint.scan, start) ThenBlock: {
            LsPaint.scan = Add(start, 1)
        }
        stop = GetByte(buf, LsPaint.scan)
        IfCondition EqualTo(stop, 58) ThenBlock: {
            LsPaint.scan = Add(LsPaint.scan, 1)
        }
        ReturnValue(0)
    }
}
Function.ExtDead {
    Input: i: Integer
    Output: Integer
    Body: {
        off = Multiply(i, 8)
        p = Add(LsPaint.ext_dead, off)
        ReturnValue(Dereference(p))
    }
}
Function.ExtLen {
    Input: i: Integer
    Output: Integer
    Body: {
        off = Multiply(i, 8)
        p = Add(LsPaint.ext_len, off)
        ReturnValue(Dereference(p))
    }
}
Function.ExtSuf {
    Input: i: Integer
    Output: Address
    Body: {
        off = Multiply(i, 8)
        p = Add(LsPaint.ext_suf, off)
        ReturnValue(Dereference(p))
    }
}
Function.ExtCode {
    Input: i: Integer
    Output: Address
    Body: {
        off = Multiply(i, 8)
        p = Add(LsPaint.ext_code, off)
        ReturnValue(Dereference(p))
    }
}
Function.ExtExact {
    Input: i: Integer
    Output: Integer
    Body: {
        off = Multiply(i, 8)
        p = Add(LsPaint.ext_exact, off)
        ReturnValue(Dereference(p))
    }
}
Function.SetDead {
    Input: i: Integer
    Body: {
        off = Multiply(i, 8)
        p = Add(LsPaint.ext_dead, off)
        StoreValue(p, 1)
    }
}
Function.SetExact {
    Input: i: Integer
    Body: {
        off = Multiply(i, 8)
        p = Add(LsPaint.ext_exact, off)
        StoreValue(p, 1)
    }
}
Function.NotePair {
    Input: later: Integer
    Input: earlier: Integer
    Body: {
        d = ExtDead(earlier)
        IfCondition EqualTo(d, 1) ThenBlock: {
            ReturnValue(0)
        }
        n1 = ExtLen(later)
        n2 = ExtLen(earlier)
        IfCondition NotEqual(n1, n2) ThenBlock: {
            ReturnValue(0)
        }
        s1 = ExtSuf(later)
        s2 = ExtSuf(earlier)
        same = EqBytes(s1, s2, n1)
        IfCondition EqualTo(same, 1) ThenBlock: {
            SetDead(earlier)
            ReturnValue(0)
        }
        fold = EqFoldN(s1, s2, n1)
        IfCondition EqualTo(fold, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(LsPaint.case_ign, 1) ThenBlock: {
            SetDead(earlier)
            ReturnValue(0)
        }
        c1 = ExtCode(later)
        c2 = ExtCode(earlier)
        cs = EqCStr(c1, c2)
        IfCondition EqualTo(cs, 1) ThenBlock: {
            SetDead(earlier)
            LsPaint.case_ign = 1
            ReturnValue(0)
        }
        SetExact(later)
        SetExact(earlier)
        ReturnValue(0)
    }
}
Function.PostLater {
    Input: i: Integer
    Body: {
        d = ExtDead(i)
        IfCondition EqualTo(d, 1) ThenBlock: {
            ReturnValue(0)
        }
        LsPaint.case_ign = 0
        j = i
        WhileLoop GreaterThan(j, 0) {
            j = Subtract(j, 1)
            NotePair(i, j)
        }
        ReturnValue(0)
    }
}
Function.PostExt {
    Body: {
        n = LsPaint.ext_n
        IfCondition LessThan(n, 2) ThenBlock: {
            ReturnValue(0)
        }
        i = n
        WhileLoop GreaterThan(i, 0) {
            i = Subtract(i, 1)
            PostLater(i)
        }
        ReturnValue(0)
    }
}
Function.ParseColors {
    Input: buf: Address
    Body: {
        LsPaint.scan = 0
        WhileLoop NotEqual(GetByte(buf, LsPaint.scan), 0) {
            TakeColorItem(buf)
        }
        PostExt()
        ReturnValue(0)
    }
}
Function.TryExt {
    Input: name: Address
    Input: nlen: Integer
    Input: i: Integer
    Body: {
        LsPaint.hit = 0
        d = ExtDead(i)
        IfCondition EqualTo(d, 1) ThenBlock: {
            ReturnValue(0)
        }
        slen = ExtLen(i)
        IfCondition GreaterThan(slen, nlen) ThenBlock: {
            ReturnValue(0)
        }
        off = Subtract(nlen, slen)
        p = Add(name, off)
        suf = ExtSuf(i)
        ex = ExtExact(i)
        ok = 0
        IfCondition EqualTo(ex, 1) ThenBlock: {
            ok = EqBytes(p, suf, slen)
        } ElseBlock: {
            ok = EqFoldN(p, suf, slen)
        }
        IfCondition EqualTo(ok, 1) ThenBlock: {
            LsPaint.hit = ExtCode(i)
        }
        ReturnValue(0)
    }
}
Function.MatchExt {
    Input: name: Address
    Output: Address
    Body: {
        nlen = StringLength(name)
        n = LsPaint.ext_n
        i = n
        WhileLoop GreaterThan(i, 0) {
            i = Subtract(i, 1)
            TryExt(name, nlen, i)
            IfCondition NotEqual(LsPaint.hit, 0) ThenBlock: {
                ReturnValue(LsPaint.hit)
            }
        }
        ReturnValue(0)
    }
}
Function.DirCode {
    Input: mode: Integer
    Output: Address
    Body: {
        sticky = BitwiseAnd(mode, 512)
        owr = BitwiseAnd(mode, 2)
        IfCondition NotEqual(sticky, 0) ThenBlock: {
            IfCondition NotEqual(owr, 0) ThenBlock: {
                live = Colored(LsPaint.c_tw)
                IfCondition EqualTo(live, 1) ThenBlock: {
                    ReturnValue(LsPaint.c_tw)
                }
            }
        }
        IfCondition NotEqual(owr, 0) ThenBlock: {
            live = Colored(LsPaint.c_ow)
            IfCondition EqualTo(live, 1) ThenBlock: {
                ReturnValue(LsPaint.c_ow)
            }
        }
        IfCondition NotEqual(sticky, 0) ThenBlock: {
            live = Colored(LsPaint.c_st)
            IfCondition EqualTo(live, 1) ThenBlock: {
                ReturnValue(LsPaint.c_st)
            }
        }
        live = Colored(LsPaint.c_di)
        IfCondition EqualTo(live, 1) ThenBlock: {
            ReturnValue(LsPaint.c_di)
        }
        ReturnValue(0)
    }
}
Function.RegCode {
    Input: mode: Integer
    Input: nlink: Integer
    Input: name: Address
    Output: Address
    Body: {
        su = BitwiseAnd(mode, 2048)
        IfCondition NotEqual(su, 0) ThenBlock: {
            live = Colored(LsPaint.c_su)
            IfCondition EqualTo(live, 1) ThenBlock: {
                ReturnValue(LsPaint.c_su)
            }
        }
        sg = BitwiseAnd(mode, 1024)
        IfCondition NotEqual(sg, 0) ThenBlock: {
            live = Colored(LsPaint.c_sg)
            IfCondition EqualTo(live, 1) ThenBlock: {
                ReturnValue(LsPaint.c_sg)
            }
        }
        ix = BitwiseAnd(mode, 73)
        IfCondition NotEqual(ix, 0) ThenBlock: {
            live = Colored(LsPaint.c_ex)
            IfCondition EqualTo(live, 1) ThenBlock: {
                ReturnValue(LsPaint.c_ex)
            }
        }
        IfCondition GreaterThan(nlink, 1) ThenBlock: {
            live = Colored(LsPaint.c_mh)
            IfCondition EqualTo(live, 1) ThenBlock: {
                ReturnValue(LsPaint.c_mh)
            }
        }
        ext = MatchExt(name)
        IfCondition NotEqual(ext, 0) ThenBlock: {
            live = Colored(ext)
            IfCondition EqualTo(live, 1) ThenBlock: {
                ReturnValue(ext)
            }
        }
        live = Colored(LsPaint.c_fi)
        IfCondition EqualTo(live, 1) ThenBlock: {
            ReturnValue(LsPaint.c_fi)
        }
        ReturnValue(0)
    }
}
Function.PickCode {
    Input: mode: Integer
    Input: nlink: Integer
    Input: name: Address
    Output: Address
    Body: {
        typ = BitwiseAnd(mode, 61440)
        IfCondition EqualTo(typ, 16384) ThenBlock: {
            ReturnValue(DirCode(mode))
        }
        IfCondition EqualTo(typ, 40960) ThenBlock: {
            live = Colored(LsPaint.c_ln)
            IfCondition EqualTo(live, 1) ThenBlock: {
                ReturnValue(LsPaint.c_ln)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(typ, 4096) ThenBlock: {
            live = Colored(LsPaint.c_pi)
            IfCondition EqualTo(live, 1) ThenBlock: {
                ReturnValue(LsPaint.c_pi)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(typ, 49152) ThenBlock: {
            live = Colored(LsPaint.c_so)
            IfCondition EqualTo(live, 1) ThenBlock: {
                ReturnValue(LsPaint.c_so)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(typ, 24576) ThenBlock: {
            live = Colored(LsPaint.c_bd)
            IfCondition EqualTo(live, 1) ThenBlock: {
                ReturnValue(LsPaint.c_bd)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(typ, 8192) ThenBlock: {
            live = Colored(LsPaint.c_cd)
            IfCondition EqualTo(live, 1) ThenBlock: {
                ReturnValue(LsPaint.c_cd)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(typ, 32768) ThenBlock: {
            ReturnValue(RegCode(mode, nlink, name))
        }
        ReturnValue(0)
    }
}
Function.IndByte {
    Input: mode: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(LsConfig.indicator, 0) ThenBlock: {
            ReturnValue(0)
        }
        typ = BitwiseAnd(mode, 61440)
        IfCondition EqualTo(typ, 32768) ThenBlock: {
            IfCondition EqualTo(LsConfig.indicator, 1) ThenBlock: {
                ix = BitwiseAnd(mode, 73)
                IfCondition NotEqual(ix, 0) ThenBlock: {
                    ReturnValue(42)
                }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(typ, 16384) ThenBlock: {
            ReturnValue(47)
        }
        IfCondition EqualTo(LsConfig.indicator, 3) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(typ, 40960) ThenBlock: {
            ReturnValue(64)
        }
        IfCondition EqualTo(typ, 4096) ThenBlock: {
            ReturnValue(124)
        }
        IfCondition EqualTo(typ, 49152) ThenBlock: {
            ReturnValue(61)
        }
        ReturnValue(0)
    }
}
Function.WriteOpenColor {
    Input: code: Address
    Body: {
        LsConfig.esc = 1
        IfCondition EqualTo(LsPaint.used, 0) ThenBlock: {
            LsPaint.used = 1
            WriteChar(27)
            WriteBuffered("[0m")
        }
        WriteChar(27)
        WriteBuffered("[")
        WriteBuffered(code)
        WriteBuffered("m")
        LsConfig.esc = 0
    }
}
Function.WriteEndColor {
    Body: {
        LsConfig.esc = 1
        WriteChar(27)
        WriteBuffered("[0m")
        LsConfig.esc = 0
    }
}
Function.PaintName {
    Input: name: Address
    Input: mode: Integer
    Input: nlink: Integer
    Body: {
        live = Colored(LsPaint.c_no)
        IfCondition EqualTo(live, 1) ThenBlock: {
            IfCondition EqualTo(LsPaint.active, 1) ThenBlock: {
                PaintColored(name, mode, nlink)
                ReturnValue(0)
            }
        }
        code = 0
        IfCondition EqualTo(LsPaint.active, 1) ThenBlock: {
            typ = BitwiseAnd(mode, 61440)
            IfCondition EqualTo(typ, 40960) ThenBlock: {
                code = ResolveCode(name, mode, nlink)
            } ElseBlock: {
                code = PickCode(mode, nlink, name)
            }
        }
        NeedPad(name)
        IfCondition EqualTo(LsConfig.hyper, 1) ThenBlock: {
            WriteOsc(name)
        }
        IfCondition NotEqual(code, 0) ThenBlock: {
            WriteOpenColor(code)
        }
        NoteFile()
        BeginVis(name)
        WriteQuoted(name)
        NoteFile()
        IfCondition NotEqual(code, 0) ThenBlock: {
            WriteEndColor()
        }
        MaybeK()
        IfCondition EqualTo(LsConfig.hyper, 1) ThenBlock: {
            CloseOsc()
        }
        ind = IndByte(mode)
        IfCondition NotEqual(ind, 0) ThenBlock: {
            WriteChar(ind)
        }
        ReturnValue(0)
    }
}
Function.TypeMode {
    Input: dtype: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(dtype, 4) ThenBlock: {
            ReturnValue(16384)
        }
        IfCondition EqualTo(dtype, 8) ThenBlock: {
            ReturnValue(32768)
        }
        IfCondition EqualTo(dtype, 10) ThenBlock: {
            ReturnValue(40960)
        }
        IfCondition EqualTo(dtype, 1) ThenBlock: {
            ReturnValue(4096)
        }
        IfCondition EqualTo(dtype, 12) ThenBlock: {
            ReturnValue(49152)
        }
        IfCondition EqualTo(dtype, 6) ThenBlock: {
            ReturnValue(24576)
        }
        IfCondition EqualTo(dtype, 2) ThenBlock: {
            ReturnValue(8192)
        }
        ReturnValue(0)
    }
}
Function.ColorNeedsStat {
    Output: Integer
    Body: {
        IfCondition EqualTo(LsConfig.indicator, 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(LsConfig.deref, 3) ThenBlock: {
            ReturnValue(1)
        }
        live = Colored(LsPaint.c_ex)
        IfCondition EqualTo(live, 1) ThenBlock: {
            ReturnValue(1)
        }
        live = Colored(LsPaint.c_su)
        IfCondition EqualTo(live, 1) ThenBlock: {
            ReturnValue(1)
        }
        live = Colored(LsPaint.c_sg)
        IfCondition EqualTo(live, 1) ThenBlock: {
            ReturnValue(1)
        }
        live = Colored(LsPaint.c_ow)
        IfCondition EqualTo(live, 1) ThenBlock: {
            ReturnValue(1)
        }
        live = Colored(LsPaint.c_st)
        IfCondition EqualTo(live, 1) ThenBlock: {
            ReturnValue(1)
        }
        live = Colored(LsPaint.c_tw)
        IfCondition EqualTo(live, 1) ThenBlock: {
            ReturnValue(1)
        }
        live = Colored(LsPaint.c_mh)
        IfCondition EqualTo(live, 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.PaintAt {
    Input: fd: Integer
    Input: name: Address
    Input: dtype: Integer
    Body: {
        need = ColorNeedsStat()
        extra = NeedLinkStat()
        IfCondition EqualTo(need, 0) ThenBlock: {
            IfCondition EqualTo(extra, 0) ThenBlock: {
                mode = TypeMode(dtype)
                go = Or(NotEqual(mode, 0), EqualTo(LsPaint.active, 0))
                IfCondition EqualTo(go, 1) ThenBlock: {
                    LsConfig.cur_fd = fd
                    OpenNorm()
                    PaintName(name, mode, 1)
                    ReturnValue(0)
                }
            }
        }
        flag = 256
        IfCondition EqualTo(LsConfig.deref, 3) ThenBlock: {
            flag = 0
        }
        sb = Allocate(144)
        res = SystemCall(262, fd, name, sb, flag)
        IfCondition LessThan(res, 0) ThenBlock: {
            IfCondition EqualTo(flag, 0) ThenBlock: {
                res = SystemCall(262, fd, name, sb, 256)
            }
        }
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(sb, 144)
            WriteQuoted(name)
            ReturnValue(0)
        }
        mode = GetUInt32(sb, 24)
        nlink = GetUInt64(sb, 16)
        Deallocate(sb, 144)
        ProbeLink(fd, name, mode)
        LsConfig.cur_fd = fd
        OpenNorm()
        PaintName(name, mode, nlink)
        ReturnValue(0)
    }
}
Function.ParseBlockSpec {
    Input: s: Address
    Output: Integer
    Body: {
        val = 0
        i = 0
        one = 1
        ch0 = GetByte(s, 0)
        IfCondition EqualTo(ch0, 39) ThenBlock: {
            i = 1
        }
        WhileLoop 1 {
            ch = GetByte(s, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                ReturnValue(val)
            }
            IfCondition LessThan(ch, 48) ThenBlock: {
                IfCondition EqualTo(ch, 75) ThenBlock: {
                    val = Multiply(val, 1024)
                }
                IfCondition EqualTo(ch, 107) ThenBlock: {
                    val = Multiply(val, 1024)
                }
                ReturnValue(val)
            }
            IfCondition GreaterThan(ch, 57) ThenBlock: {
                IfCondition EqualTo(ch, 75) ThenBlock: {
                    val = Multiply(val, 1024)
                }
                IfCondition EqualTo(ch, 107) ThenBlock: {
                    val = Multiply(val, 1024)
                }
                ReturnValue(val)
            }
            dig = Subtract(ch, 48)
            val = Multiply(val, 10)
            val = Add(val, dig)
            i = Add(i, one)
        }
        ReturnValue(val)
    }
}
Function.TakeBlock {
    Input: buf: Address
    Input: at: Integer
    Input: which: Integer
    Body: {
        spec = Add(buf, at)
        v = ParseBlockSpec(spec)
        IfCondition GreaterThan(v, 0) ThenBlock: {
            IfCondition EqualTo(which, 1) ThenBlock: {
                LsPaint.saw_ls = 1
                LsPaint.ls_bs = v
            }
            IfCondition EqualTo(which, 2) ThenBlock: {
                LsPaint.saw_bs = 1
                LsPaint.env_bs = v
            }
        }
        ReturnValue(0)
    }
}
Function.MarkUtc {
    Input: buf: Address
    Input: at: Integer
    Body: {
        utc = 0
        hit = AtWord(buf, at, "UTC0", 4)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            utc = 1
        }
        hit = AtWord(buf, at, "UTC", 3)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            utc = 1
        }
        hit = AtWord(buf, at, "GMT0", 4)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            utc = 1
        }
        hit = AtWord(buf, at, "GMT", 3)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            utc = 1
        }
        LsPaint.tz_utc = utc
        ReturnValue(0)
    }
}
Function.ScanOne {
    Input: buf: Address
    Input: i: Integer
    Body: {
        at_var = 0
        IfCondition EqualTo(i, 0) ThenBlock: {
            at_var = 1
        }
        IfCondition GreaterThan(i, 0) ThenBlock: {
            prev_at = Subtract(i, 1)
            prev = GetByte(buf, prev_at)
            IfCondition EqualTo(prev, 0) ThenBlock: {
                at_var = 1
            }
        }
        IfCondition EqualTo(at_var, 0) ThenBlock: {
            ReturnValue(0)
        }
        is_c = StartsAt(buf, i, "LS_COLORS=", 10)
        IfCondition EqualTo(is_c, 1) ThenBlock: {
            vat = Add(i, 10)
            b = GetByte(buf, vat)
            IfCondition NotEqual(b, 0) ThenBlock: {
                LsPaint.had = 1
                p = Add(buf, vat)
                ParseColors(p)
            }
        }
        is_ct = StartsAt(buf, i, "COLORTERM=", 10)
        IfCondition EqualTo(is_ct, 1) ThenBlock: {
            vat = Add(i, 10)
            b = GetByte(buf, vat)
            IfCondition NotEqual(b, 0) ThenBlock: {
                LsPaint.colorterm = 1
            }
        }
        is_t = StartsAt(buf, i, "TERM=", 5)
        IfCondition EqualTo(is_t, 1) ThenBlock: {
            vat = Add(i, 5)
            b = GetByte(buf, vat)
            IfCondition NotEqual(b, 0) ThenBlock: {
                dumb = AtWord(buf, vat, "dumb", 4)
                IfCondition EqualTo(dumb, 0) ThenBlock: {
                    LsPaint.term_ok = 1
                }
            }
        }
        is_tz = StartsAt(buf, i, "TZ=", 3)
        IfCondition EqualTo(is_tz, 1) ThenBlock: {
            vat = Add(i, 3)
            MarkUtc(buf, vat)
        }
        is_ls = StartsAt(buf, i, "LS_BLOCK_SIZE=", 14)
        IfCondition EqualTo(is_ls, 1) ThenBlock: {
            vat = Add(i, 14)
            TakeBlock(buf, vat, 1)
        }
        is_bs = StartsAt(buf, i, "BLOCK_SIZE=", 11)
        IfCondition EqualTo(is_bs, 1) ThenBlock: {
            vat = Add(i, 11)
            TakeBlock(buf, vat, 2)
        }
        is_ts = StartsAt(buf, i, "TIME_STYLE=", 11)
        IfCondition EqualTo(is_ts, 1) ThenBlock: {
            vat = Add(i, 11)
            TakeTimeEnv(buf, vat)
        }
        is_col = StartsAt(buf, i, "COLUMNS=", 8)
        IfCondition EqualTo(is_col, 1) ThenBlock: {
            vat = Add(i, 8)
            TakeCols(buf, vat)
        }
        ReturnValue(0)
    }
}
Function.LoadEnv {
    Body: {
        LsPaint.c_di = "01;34"
        LsPaint.c_ex = "01;32"
        LsPaint.c_ln = "01;36"
        LsPaint.c_ow = "34;42"
        LsPaint.c_st = "37;44"
        LsPaint.c_tw = "30;42"
        LsPaint.c_pi = "33"
        LsPaint.c_so = "01;35"
        LsPaint.c_bd = "01;33"
        LsPaint.c_cd = "01;33"
        LsPaint.c_su = "37;41"
        LsPaint.c_sg = "30;43"
        LsPaint.ext_suf = Allocate(192)
        LsPaint.ext_code = Allocate(192)
        LsPaint.ext_len = Allocate(192)
        LsPaint.ext_exact = Allocate(192)
        LsPaint.ext_dead = Allocate(192)
        LsPaint.ext_n = 0
        sb = Allocate(144)
        fr = SystemCall(5, 1, sb)
        IfCondition GreaterEqual(fr, 0) ThenBlock: {
            md = GetUInt32(sb, 24)
            kind = BitwiseAnd(md, 61440)
            IfCondition EqualTo(kind, 8192) ThenBlock: {
                LsPaint.tty = 1
            }
        }
        Deallocate(sb, 144)
        fd = SystemCall(2, "/proc/self/environ", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf = Allocate(65536)
        n = SystemCall(0, fd, buf, 65535)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 65536)
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            ScanOne(buf, i)
            i = Add(i, one)
        }
        Deallocate(buf, 65536)
        IfCondition EqualTo(LsConfig.block_set, 0) ThenBlock: {
            IfCondition EqualTo(LsPaint.saw_ls, 1) ThenBlock: {
                LsConfig.file_block = LsPaint.ls_bs
            } ElseBlock: {
                IfCondition EqualTo(LsPaint.saw_bs, 1) ThenBlock: {
                    LsConfig.file_block = LsPaint.env_bs
                }
            }
        }
        ReturnValue(0)
    }
}
Function.FinishStyle {
    Body: {
        IfCondition EqualTo(LsConfig.ind_auto, 1) ThenBlock: {
            IfCondition EqualTo(LsPaint.tty, 0) ThenBlock: {
                LsConfig.indicator = 0
            }
        }
        IfCondition EqualTo(LsConfig.color_mode, 0) ThenBlock: {
            LsPaint.active = 0
            ReturnValue(0)
        }
        allow = 0
        IfCondition EqualTo(LsPaint.had, 1) ThenBlock: {
            allow = 1
        } ElseBlock: {
            IfCondition EqualTo(LsPaint.colorterm, 1) ThenBlock: {
                allow = 1
            }
            IfCondition EqualTo(LsPaint.term_ok, 1) ThenBlock: {
                allow = 1
            }
        }
        IfCondition EqualTo(allow, 0) ThenBlock: {
            LsPaint.active = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.color_mode, 2) ThenBlock: {
            IfCondition EqualTo(LsPaint.tty, 0) ThenBlock: {
                LsPaint.active = 0
                ReturnValue(0)
            }
        }
        LsPaint.active = 1
        ReturnValue(0)
    }
}
Function.WhenCode {
    Input: val: Address
    Output: Integer
    Body: {
        hit = AtWord(val, 0, "always", 6)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReturnValue(1)
        }
        hit = AtWord(val, 0, "yes", 3)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReturnValue(1)
        }
        hit = AtWord(val, 0, "force", 5)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReturnValue(1)
        }
        hit = AtWord(val, 0, "never", 5)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReturnValue(3)
        }
        hit = AtWord(val, 0, "none", 4)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReturnValue(3)
        }
        hit = AtWord(val, 0, "no", 2)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReturnValue(3)
        }
        hit = AtWord(val, 0, "auto", 4)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReturnValue(2)
        }
        hit = AtWord(val, 0, "tty", 3)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReturnValue(2)
        }
        hit = AtWord(val, 0, "if-tty", 6)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReturnValue(2)
        }
        ReturnValue(0)
    }
}
Function.ApplyWhen {
    Input: arg: Address
    Input: arg_len: Integer
    Input: at: Integer
    Input: kind: Integer
    Body: {
        n = Subtract(arg_len, at)
        val = CopySpan(arg, at, n)
        got = WhenCode(val)
        IfCondition EqualTo(got, 0) ThenBlock: {
            WriteStderr("ls: invalid argument '")
            WriteStderr(val)
            WriteStderr("'\n")
            SystemCall(60, 1)
        }
        IfCondition EqualTo(kind, 1) ThenBlock: {
            IfCondition EqualTo(got, 1) ThenBlock: {
                LsConfig.color_mode = 1
            }
            IfCondition EqualTo(got, 2) ThenBlock: {
                LsConfig.color_mode = 2
            }
            IfCondition EqualTo(got, 3) ThenBlock: {
                LsConfig.color_mode = 0
            }
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            IfCondition EqualTo(got, 1) ThenBlock: {
                LsConfig.indicator = 1
                LsConfig.ind_auto = 0
            }
            IfCondition EqualTo(got, 2) ThenBlock: {
                LsConfig.indicator = 1
                LsConfig.ind_auto = 1
            }
            IfCondition EqualTo(got, 3) ThenBlock: {
                LsConfig.indicator = 0
                LsConfig.ind_auto = 0
            }
        }
        ReturnValue(0)
    }
}
Function.BadTime {
    Input: val: Address
    Body: {
        WriteStderr("ls: invalid argument '")
        WriteStderr(val)
        WriteStderr("' for 'time style'\n")
        WriteStderr("Valid arguments are:\n")
        WriteStderr("  - [posix-]full-iso\n")
        WriteStderr("  - [posix-]long-iso\n")
        WriteStderr("  - [posix-]iso\n")
        WriteStderr("  - [posix-]locale\n")
        WriteStderr("  - +FORMAT (e.g., +%H:%M) for a 'date'-style format\n")
        WriteStderr("Try 'ls --help' for more information.\n")
        SystemCall(60, 2)
        ReturnValue(0)
    }
}
Function.ApplyTime {
    Input: arg: Address
    Input: arg_len: Integer
    Body: {
        IfCondition EqualTo(arg_len, 22) ThenBlock: {
            hit = StartsAt(arg, 0, "--time-style=+%Y-%m-%d", 22)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                LsConfig.iso_date = 1
                LsConfig.long_iso = 0
                LsConfig.time_fmt = 0
                ReturnValue(0)
            }
        }
        n = Subtract(arg_len, 13)
        val = CopySpan(arg, 13, n)
        b = GetByte(val, 0)
        IfCondition EqualTo(b, 43) ThenBlock: {
            one = 1
            n2 = Subtract(n, one)
            LsConfig.time_fmt = CopySpan(val, one, n2)
            LsConfig.iso_date = 0
            LsConfig.long_iso = 0
            ReturnValue(0)
        }
        LsConfig.time_fmt = 0
        hit = AtWord(val, 0, "long-iso", 8)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            LsConfig.long_iso = 1
            LsConfig.iso_date = 0
            ReturnValue(0)
        }
        hit = AtWord(val, 0, "posix-long-iso", 14)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            LsConfig.long_iso = 1
            LsConfig.iso_date = 0
            ReturnValue(0)
        }
        hit = AtWord(val, 0, "full-iso", 8)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            LsConfig.time_fmt = "%Y-%m-%d %H:%M:%S.000000000 %z"
            LsConfig.long_iso = 0
            LsConfig.iso_date = 0
            ReturnValue(0)
        }
        hit = AtWord(val, 0, "posix-full-iso", 14)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            LsConfig.time_fmt = "%Y-%m-%d %H:%M:%S.000000000 %z"
            LsConfig.long_iso = 0
            LsConfig.iso_date = 0
            ReturnValue(0)
        }
        hit = AtWord(val, 0, "iso", 3)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            LsConfig.time_fmt = "%Y-%m-%d "
            LsConfig.long_iso = 0
            LsConfig.iso_date = 0
            ReturnValue(0)
        }
        hit = AtWord(val, 0, "posix-iso", 9)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            LsConfig.time_fmt = "%Y-%m-%d "
            LsConfig.long_iso = 0
            LsConfig.iso_date = 0
            ReturnValue(0)
        }
        hit = AtWord(val, 0, "locale", 6)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReturnValue(0)
        }
        hit = AtWord(val, 0, "posix-locale", 12)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReturnValue(0)
        }
        BadTime(val)
        ReturnValue(0)
    }
}
Function.ApplyIgnore {
    Input: arg: Address
    Input: arg_len: Integer
    Body: {
        vlen = Subtract(arg_len, 9)
        pat = Allocate(Add(vlen, 1))
        k = 0
        one = 1
        WhileLoop LessThan(k, vlen) {
            src = Add(9, k)
            SetByte(pat, k, GetByte(arg, src))
            next = Add(k, one)
            IfCondition EqualTo(next, vlen) ThenBlock: {
                SetByte(pat, vlen, 0)
                LsConfig.ignore = pat
                ReturnValue(0)
            }
            k = Add(k, one)
        }
        SetByte(pat, vlen, 0)
        LsConfig.ignore = pat
        ReturnValue(0)
    }
}
Function.ApplyLong {
    Input: arg: Address
    Input: arg_len: Integer
    Body: {
        hit = ApplyMore(arg, arg_len)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReturnValue(0)
        }
        ghit = ApplyGroup(arg, arg_len)
        IfCondition EqualTo(ghit, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterThan(arg_len, 9) ThenBlock: {
            hit = StartsAt(arg, 0, "--ignore=", 9)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ApplyIgnore(arg, arg_len)
                ReturnValue(0)
            }
        }
        IfCondition GreaterThan(arg_len, 13) ThenBlock: {
            hit = StartsAt(arg, 0, "--time-style=", 13)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ApplyTime(arg, arg_len)
                ReturnValue(0)
            }
        }
        IfCondition GreaterThan(arg_len, 11) ThenBlock: {
            hit = StartsAt(arg, 0, "--classify=", 11)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ApplyWhen(arg, arg_len, 11, 2)
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(arg_len, 10) ThenBlock: {
            hit = StartsAt(arg, 0, "--classify", 10)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                LsConfig.indicator = 1
                LsConfig.ind_auto = 0
                ReturnValue(0)
            }
        }
        IfCondition GreaterThan(arg_len, 8) ThenBlock: {
            hit = StartsAt(arg, 0, "--color=", 8)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ApplyWhen(arg, arg_len, 8, 1)
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(arg_len, 7) ThenBlock: {
            hit = StartsAt(arg, 0, "--color", 7)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                LsConfig.color_mode = 1
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(arg_len, 11) ThenBlock: {
            hit = StartsAt(arg, 0, "--file-type", 11)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                LsConfig.indicator = 2
                LsConfig.ind_auto = 0
                ReturnValue(0)
            }
        }
        IfCondition GreaterThan(arg_len, 18) ThenBlock: {
            hit = StartsAt(arg, 0, "--indicator-style=", 18)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                n = Subtract(arg_len, 18)
                val = CopySpan(arg, 18, n)
                w = AtWord(val, 0, "none", 4)
                IfCondition EqualTo(w, 1) ThenBlock: {
                    LsConfig.indicator = 0
                    ReturnValue(0)
                }
                w = AtWord(val, 0, "slash", 5)
                IfCondition EqualTo(w, 1) ThenBlock: {
                    LsConfig.indicator = 3
                    ReturnValue(0)
                }
                w = AtWord(val, 0, "file-type", 9)
                IfCondition EqualTo(w, 1) ThenBlock: {
                    LsConfig.indicator = 2
                    ReturnValue(0)
                }
                w = AtWord(val, 0, "classify", 8)
                IfCondition EqualTo(w, 1) ThenBlock: {
                    LsConfig.indicator = 1
                    ReturnValue(0)
                }
                WriteStderr("ls: invalid argument '")
                WriteStderr(val)
                WriteStderr("'\n")
                SystemCall(60, 1)
            }
        }
        IfCondition GreaterThan(arg_len, 13) ThenBlock: {
            hit = StartsAt(arg, 0, "--block-size=", 13)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                n = Subtract(arg_len, 13)
                val = CopySpan(arg, 13, n)
                v = ParseBlockSpec(val)
                IfCondition GreaterThan(v, 0) ThenBlock: {
                    LsConfig.file_block = v
                    LsConfig.block_set = 1
                }
                ReturnValue(0)
            }
        }
        ReturnValue(0)
    }
}
