// Column, comma, and -w/-T layout. Pools stay on ls.ailang. No Main.
LibraryImport.Arena
Function.IsHex {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(c, 48) ThenBlock: {
            IfCondition LessEqual(c, 57) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition GreaterEqual(c, 97) ThenBlock: {
            IfCondition LessEqual(c, 102) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition GreaterEqual(c, 65) ThenBlock: {
            IfCondition LessEqual(c, 70) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}
Function.BadHex {
    Input: s: Address
    Input: j: Integer
    Output: Integer
    Body: {
        c = RDMEM_8(s, Add(j, 2))
        IfCondition EqualTo(c, 0) ThenBlock: {
            ReturnValue(1)
        }
        n = 2
        one = 1
        WhileLoop 1 {
            at = Add(j, n)
            ch = RDMEM_8(s, at)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                ReturnValue(0)
            }
            ok = IsHex(ch)
            IfCondition EqualTo(ok, 0) ThenBlock: {
                ReturnValue(1)
            }
            n = Add(n, one)
        }
    }
}
Function.BadWidth {
    Input: s: Address
    Input: j: Integer
    Output: Integer
    Body: {
        c0 = RDMEM_8(s, j)
        c1 = RDMEM_8(s, Add(j, 1))
        IfCondition EqualTo(c0, 48) ThenBlock: {
            IfCondition EqualTo(c1, 120) ThenBlock: {
                bad = BadHex(s, j)
                ReturnValue(bad)
            }
            IfCondition EqualTo(c1, 88) ThenBlock: {
                bad = BadHex(s, j)
                ReturnValue(bad)
            }
        }
        IfCondition LessThan(c0, 48) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition GreaterThan(c0, 57) ThenBlock: {
            ReturnValue(1)
        }
        n = 0
        one = 1
        WhileLoop 1 {
            at = Add(j, n)
            c = RDMEM_8(s, at)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition LessThan(c, 48) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition GreaterThan(c, 57) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(c0, 48) ThenBlock: {
                IfCondition GreaterThan(c, 55) ThenBlock: {
                    ReturnValue(1)
                }
            }
            n = Add(n, one)
        }
    }
}
Function.HexDig {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(c, 96) ThenBlock: {
            ReturnValue(Subtract(c, 87))
        }
        IfCondition GreaterThan(c, 64) ThenBlock: {
            ReturnValue(Subtract(c, 55))
        }
        ReturnValue(Subtract(c, 48))
    }
}
Function.ParseHex {
    Input: s: Address
    Input: j: Integer
    Output: Integer
    Body: {
        n = 2
        val = 0
        one = 1
        WhileLoop 1 {
            at = Add(j, n)
            c = RDMEM_8(s, at)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(val)
            }
            dig = HexDig(c)
            val = Add(Multiply(val, 16), dig)
            n = Add(n, one)
        }
    }
}
Function.ParseOct {
    Input: s: Address
    Input: j: Integer
    Output: Integer
    Body: {
        val = 0
        n = 0
        one = 1
        WhileLoop 1 {
            at = Add(j, n)
            c = RDMEM_8(s, at)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(val)
            }
            dig = Subtract(c, 48)
            val = Add(Multiply(val, 8), dig)
            n = Add(n, one)
        }
    }
}
Function.ParseDec {
    Input: s: Address
    Input: j: Integer
    Output: Integer
    Body: {
        val = 0
        n = 0
        one = 1
        WhileLoop 1 {
            at = Add(j, n)
            c = RDMEM_8(s, at)
            IfCondition EqualTo(c, 0) ThenBlock: {
                IfCondition GreaterThan(n, 18) ThenBlock: {
                    ReturnValue(0)
                }
                ReturnValue(val)
            }
            dig = Subtract(c, 48)
            val = Add(Multiply(val, 10), dig)
            n = Add(n, one)
        }
    }
}
Function.ParseWidth {
    Input: s: Address
    Input: j: Integer
    Output: Integer
    Body: {
        c0 = RDMEM_8(s, j)
        c1 = RDMEM_8(s, Add(j, 1))
        IfCondition EqualTo(c0, 48) ThenBlock: {
            IfCondition EqualTo(c1, 120) ThenBlock: {
                val = ParseHex(s, j)
                ReturnValue(val)
            }
            IfCondition EqualTo(c1, 88) ThenBlock: {
                val = ParseHex(s, j)
                ReturnValue(val)
            }
            val = ParseOct(s, j)
            ReturnValue(val)
        }
        val = ParseDec(s, j)
        ReturnValue(val)
    }
}
Function.SpanLen {
    Input: s: Address
    Input: i: Integer
    Output: Integer
    Body: {
        n = 0
        one = 1
        WhileLoop 1 {
            at = Add(i, n)
            c = RDMEM_8(s, at)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(n)
            }
            n = Add(n, one)
        }
    }
}
Function.TakeNum {
    Input: flag_str: Address
    Input: i: Integer
    Input: kind: Integer
    Output: Integer
    Body: {
        j = Add(i, 1)
        c = RDMEM_8(flag_str, j)
        IfCondition EqualTo(c, 0) ThenBlock: {
            IfCondition EqualTo(kind, 1) ThenBlock: {
                WriteStderr("ls: option requires an argument -- 'w'\n")
            } ElseBlock: {
                WriteStderr("ls: option requires an argument -- 'T'\n")
            }
            SystemCall(60, 2)
            ReturnValue(1)
        }
        bad = BadWidth(flag_str, j)
        IfCondition EqualTo(bad, 1) ThenBlock: {
            IfCondition EqualTo(kind, 1) ThenBlock: {
                WriteStderr("ls: invalid line width: '")
            } ElseBlock: {
                WriteStderr("ls: invalid tab size: '")
            }
            suf = Add(flag_str, j)
            WriteStderr(suf)
            WriteStderr("'\n")
            SystemCall(60, 2)
            ReturnValue(1)
        }
        val = ParseWidth(flag_str, j)
        IfCondition EqualTo(kind, 1) ThenBlock: {
            LsConfig.width = val
            LsConfig.width_set = 1
        } ElseBlock: {
            LsConfig.tabsize = val
        }
        step = SpanLen(flag_str, i)
        ReturnValue(step)
    }
}
Function.ApplyShort {
    Input: flag_str: Address
    Input: i: Integer
    Output: Integer
    Body: {
        ch = RDMEM_8(flag_str, i)
        IfCondition EqualTo(ch, 97) ThenBlock: {
            LsConfig.show_all = 1
            LsConfig.almost = 0
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 65) ThenBlock: {
            LsConfig.show_all = 0
            LsConfig.almost = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 108) ThenBlock: {
            LsConfig.long_format = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 104) ThenBlock: {
            LsConfig.human_readable = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 116) ThenBlock: {
            LsConfig.sort_by_time = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 114) ThenBlock: {
            LsConfig.reverse_sort = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 82) ThenBlock: {
            LsConfig.recursive = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 100) ThenBlock: {
            LsConfig.dir_as_file = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 99) ThenBlock: {
            LsConfig.use_ctime = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 67) ThenBlock: {
            LsConfig.column = 1
            LsConfig.across = 0
            LsConfig.commas = 0
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 105) ThenBlock: {
            LsConfig.print_inode = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 103) ThenBlock: {
            LsConfig.long_format = 1
            LsConfig.omit_owner = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 71) ThenBlock: {
            LsConfig.omit_group = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 111) ThenBlock: {
            LsConfig.long_format = 1
            LsConfig.omit_group = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 70) ThenBlock: {
            LsConfig.indicator = 1
            LsConfig.ind_auto = 0
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 112) ThenBlock: {
            LsConfig.indicator = 3
            LsConfig.ind_auto = 0
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 85) ThenBlock: {
            LsConfig.sort_none = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 72) ThenBlock: {
            LsConfig.deref = 2
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 76) ThenBlock: {
            LsConfig.deref = 3
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 49) ThenBlock: {
            LsConfig.column = 0
            LsConfig.across = 0
            LsConfig.commas = 0
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 115) ThenBlock: {
            LsConfig.print_blocks = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 120) ThenBlock: {
            LsConfig.across = 1
            LsConfig.commas = 0
            LsConfig.column = 0
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 109) ThenBlock: {
            LsConfig.commas = 1
            LsConfig.across = 0
            LsConfig.column = 0
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 119) ThenBlock: {
            step = TakeNum(flag_str, i, 1)
            ReturnValue(step)
        }
        IfCondition EqualTo(ch, 84) ThenBlock: {
            step = TakeNum(flag_str, i, 2)
            ReturnValue(step)
        }
        IfCondition EqualTo(ch, 113) ThenBlock: {
            LsConfig.hide_ctrl = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 81) ThenBlock: {
            LsConfig.quote_style = 5
            LsConfig.qname = "c"
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 78) ThenBlock: {
            LsConfig.quote_style = 0
            LsConfig.qname = "literal"
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 118) ThenBlock: {
            LsConfig.sort_ver = 1
            LsConfig.sort_none = 0
            LsConfig.sort_width = 0
            ReturnValue(1)
        }
        ReturnValue(1)
    }
}
Function.WantLayout {
    Output: Integer
    Body: {
        IfCondition EqualTo(LsConfig.long_format, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.print_inode, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.across, 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(LsConfig.commas, 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(LsConfig.column, 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.LineWidth {
    Output: Integer
    Body: {
        IfCondition EqualTo(LsConfig.width_set, 0) ThenBlock: {
            ReturnValue(80)
        }
        IfCondition EqualTo(LsConfig.width, 0) ThenBlock: {
            ReturnValue(1000000)
        }
        ReturnValue(LsConfig.width)
    }
}
Function.KBlocks {
    Input: fd: Integer
    Input: name: Address
    Output: Integer
    Body: {
        sb = Allocate(144)
        res = SystemCall(262, fd, name, sb, 256)
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(sb, 144)
            ReturnValue(0)
        }
        b = GetUInt64(sb, 64)
        Deallocate(sb, 144)
        kb = Divide(b, 2)
        ReturnValue(kb)
    }
}
Function.Digits {
    Input: n: Integer
    Output: Integer
    Body: {
        d = 1
        one = 1
        ten = 10
        WhileLoop 1 {
            IfCondition LessThan(n, ten) ThenBlock: {
                ReturnValue(d)
            }
            n = Divide(n, ten)
            d = Add(d, one)
        }
    }
}
Function.ItemLen {
    Input: fd: Integer
    Input: name: Address
    Output: Integer
    Body: {
        n = QuoteLen(name)
        IfCondition EqualTo(LsConfig.print_blocks, 1) ThenBlock: {
            kb = KBlocks(fd, name)
            dg = Digits(kb)
            n = Add(n, Add(dg, 1))
        }
        ReturnValue(n)
    }
}
Function.EmitItem {
    Input: fd: Integer
    Input: name: Address
    Input: dtype: Integer
    Body: {
        IfCondition EqualTo(LsConfig.print_blocks, 1) ThenBlock: {
            kb = KBlocks(fd, name)
            s = NumberToString(kb)
            WriteBuffered(s)
            WriteBuffered(" ")
        }
        PaintAt(fd, name, dtype)
        ReturnValue(0)
    }
}
Function.SpaceGap {
    Input: nlen: Integer
    Body: {
        W = LineWidth()
        col = LsConfig.col
        need = Add(col, Add(2, nlen))
        IfCondition GreaterThan(need, W) ThenBlock: {
            IfCondition GreaterThan(col, 0) ThenBlock: {
                BreakLine()
                ReturnValue(0)
            }
        }
        WriteBuffered("  ")
        LsConfig.col = Add(col, 2)
        ReturnValue(0)
    }
}
Function.CommaGap {
    Input: nlen: Integer
    Body: {
        W = LineWidth()
        col = LsConfig.col
        need = Add(col, Add(1, nlen))
        IfCondition GreaterThan(need, W) ThenBlock: {
            IfCondition GreaterThan(col, 0) ThenBlock: {
                BreakLine()
                ReturnValue(0)
            }
        }
        WriteChar(32)
        LsConfig.col = Add(col, 1)
        ReturnValue(0)
    }
}
Function.GapBefore {
    Input: nlen: Integer
    Input: index: Integer
    Body: {
        IfCondition EqualTo(index, 0) ThenBlock: {
            LsConfig.col = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.commas, 1) ThenBlock: {
            CommaGap(nlen)
            ReturnValue(0)
        }
        SpaceGap(nlen)
        ReturnValue(0)
    }
}
Function.AccountName {
    Input: nlen: Integer
    Body: {
        LsConfig.col = Add(LsConfig.col, nlen)
        ReturnValue(0)
    }
}
Function.AccountComma {
    Input: index: Integer
    Input: count: Integer
    Body: {
        IfCondition EqualTo(LsConfig.commas, 0) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        nxt = Add(index, one)
        IfCondition LessThan(nxt, count) ThenBlock: {
            WriteChar(44)
            LsConfig.col = Add(LsConfig.col, 1)
        }
        ReturnValue(0)
    }
}
Function.LayoutEntries {
    Input: fd: Integer
    Input: entries: Address
    Input: count: Integer
    Body: {
        IfCondition EqualTo(count, 0) ThenBlock: {
            ReturnValue(0)
        }
        i = 0
        one = 1
        WhileLoop LessThan(i, count) {
            name = GetEntryName(entries, i)
            dt = GetEntryType(entries, i)
            nlen = ItemLen(fd, name)
            GapBefore(nlen, i)
            EmitItem(fd, name, dt)
            AccountName(nlen)
            AccountComma(i, count)
            i = Add(i, one)
        }
        BreakLine()
        ReturnValue(0)
    }
}
Function.LayoutPaths {
    Body: {
        count = LsConfig.pend_n
        IfCondition EqualTo(count, 0) ThenBlock: {
            ReturnValue(0)
        }
        i = 0
        one = 1
        WhileLoop LessThan(i, count) {
            off = Multiply(i, 8)
            name = RDMEM_64(LsConfig.pend, off)
            nlen = ItemLen(-100, name)
            GapBefore(nlen, i)
            EmitItem(-100, name, 0)
            AccountName(nlen)
            AccountComma(i, count)
            Deallocate(name, 0)
            i = Add(i, one)
        }
        BreakLine()
        LsConfig.pend_n = 0
        ReturnValue(0)
    }
}
Function.PushPend {
    Input: path: Address
    Body: {
        IfCondition EqualTo(LsConfig.pend, 0) ThenBlock: {
            LsConfig.pend = Allocate(800)
        }
        off = Multiply(LsConfig.pend_n, 8)
        WRMEM_64(LsConfig.pend, off, path)
        nxt = Add(LsConfig.pend_n, 1)
        LsConfig.pend_n = nxt
        ReturnValue(0)
    }
}
Function.HoldFile {
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LsConfig.long_format, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.print_inode, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.across, 1) ThenBlock: {
            is_dir = IsDirectory(path)
            IfCondition EqualTo(is_dir, 1) ThenBlock: {
                ReturnValue(0)
            }
            PushPend(path)
            ReturnValue(1)
        }
        IfCondition EqualTo(LsConfig.commas, 1) ThenBlock: {
            is_dir = IsDirectory(path)
            IfCondition EqualTo(is_dir, 1) ThenBlock: {
                ReturnValue(0)
            }
            PushPend(path)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
