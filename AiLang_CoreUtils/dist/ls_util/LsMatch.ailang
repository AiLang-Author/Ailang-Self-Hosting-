// Quoting-style, glob, version sort, and time-format helpers.
// No pool. No Main.
LibraryImport.Arena

Function.StyleName {
    Input: id: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(id, 1) ThenBlock: { ReturnValue("shell") }
        IfCondition EqualTo(id, 2) ThenBlock: { ReturnValue("shell-always") }
        IfCondition EqualTo(id, 3) ThenBlock: { ReturnValue("shell-escape") }
        IfCondition EqualTo(id, 4) ThenBlock: { ReturnValue("shell-escape-always") }
        IfCondition EqualTo(id, 5) ThenBlock: { ReturnValue("c") }
        IfCondition EqualTo(id, 6) ThenBlock: { ReturnValue("escape") }
        IfCondition EqualTo(id, 7) ThenBlock: { ReturnValue("locale") }
        IfCondition EqualTo(id, 8) ThenBlock: { ReturnValue("clocale") }
        ReturnValue("literal")
    }
}
Function.PrefixOf {
    Input: val: Address
    Input: full: Address
    Output: Integer
    Body: {
        n = StringLength(val)
        f = StringLength(full)
        IfCondition GreaterEqual(n, f) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        hit = StartsAt(full, 0, val, n)
        ReturnValue(hit)
    }
}
Function.StyleId {
    Input: val: Address
    Output: Integer
    Body: {
        hit = AtWord(val, 0, "literal", 7)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(0) }
        hit = AtWord(val, 0, "shell-escape-always", 19)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(4) }
        hit = AtWord(val, 0, "shell-escape", 12)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(3) }
        hit = AtWord(val, 0, "shell-always", 12)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(2) }
        hit = AtWord(val, 0, "shell", 5)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = AtWord(val, 0, "clocale", 7)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(8) }
        hit = AtWord(val, 0, "locale", 6)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(7) }
        hit = AtWord(val, 0, "escape", 6)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(6) }
        hit = AtWord(val, 0, "c", 1)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(5) }
        n = 0
        id = 0
        hit = PrefixOf(val, "literal")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            n = 1
            id = 0
        }
        hit = PrefixOf(val, "shell-escape-always")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            n = Add(n, 1)
            id = 4
        }
        hit = PrefixOf(val, "shell-escape")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            n = Add(n, 1)
            id = 3
        }
        hit = PrefixOf(val, "shell-always")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            n = Add(n, 1)
            id = 2
        }
        hit = PrefixOf(val, "shell")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            n = Add(n, 1)
            id = 1
        }
        hit = PrefixOf(val, "clocale")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            n = Add(n, 1)
            id = 8
        }
        hit = PrefixOf(val, "locale")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            n = Add(n, 1)
            id = 7
        }
        hit = PrefixOf(val, "escape")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            n = Add(n, 1)
            id = 6
        }
        hit = PrefixOf(val, "c")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            n = Add(n, 1)
            id = 5
        }
        IfCondition EqualTo(n, 1) ThenBlock: {
            ReturnValue(id)
        }
        ReturnValue(-1)
    }
}
Function.SetStyle {
    Input: val: Address
    Body: {
        id = StyleId(val)
        IfCondition LessThan(id, 0) ThenBlock: {
            WriteStderr("ls: invalid argument '")
            WriteStderr(val)
            WriteStderr("' for 'quoting style'\n")
            SystemCall(60, 2)
        }
        LsConfig.quote_style = id
        LsConfig.qname = StyleName(id)
        ReturnValue(0)
    }
}
Function.ApplySort {
    Input: val: Address
    Body: {
        hit = AtWord(val, 0, "width", 5)
        IfCondition EqualTo(hit, 0) ThenBlock: {
            hit = PrefixOf(val, "width")
        }
        IfCondition EqualTo(hit, 1) ThenBlock: {
            LsConfig.sort_width = 1
            LsConfig.sort_ver = 0
            LsConfig.sort_by_time = 0
            LsConfig.sort_none = 0
            ReturnValue(0)
        }
        hit = AtWord(val, 0, "version", 7)
        IfCondition EqualTo(hit, 0) ThenBlock: {
            hit = PrefixOf(val, "version")
        }
        IfCondition EqualTo(hit, 1) ThenBlock: {
            LsConfig.sort_ver = 1
            LsConfig.sort_width = 0
            LsConfig.sort_by_time = 0
            LsConfig.sort_none = 0
            ReturnValue(0)
        }
        hit = AtWord(val, 0, "none", 4)
        IfCondition EqualTo(hit, 0) ThenBlock: {
            hit = PrefixOf(val, "none")
        }
        IfCondition EqualTo(hit, 1) ThenBlock: {
            LsConfig.sort_none = 1
            ReturnValue(0)
        }
        hit = AtWord(val, 0, "time", 4)
        IfCondition EqualTo(hit, 0) ThenBlock: {
            hit = PrefixOf(val, "time")
        }
        IfCondition EqualTo(hit, 1) ThenBlock: {
            LsConfig.sort_by_time = 1
            LsConfig.sort_none = 0
            LsConfig.sort_ver = 0
            LsConfig.sort_width = 0
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}
Function.OptPrefix {
    Input: arg: Address
    Input: arg_len: Integer
    Input: full: Address
    Input: full_len: Integer
    Input: min_len: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(arg_len, min_len) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterThan(arg_len, full_len) ThenBlock: {
            ReturnValue(0)
        }
        hit = StartsAt(full, 0, arg, arg_len)
        ReturnValue(hit)
    }
}
Function.ApplyMore {
    Input: arg: Address
    Input: arg_len: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(arg_len, 16) ThenBlock: {
            hit = StartsAt(arg, 0, "--quoting-style=", 16)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                n = Subtract(arg_len, 16)
                val = CopySpan(arg, 16, n)
                SetStyle(val)
                ReturnValue(1)
            }
        }
        IfCondition GreaterThan(arg_len, 10) ThenBlock: {
            hit = StartsAt(arg, 0, "--quoting=", 10)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                style = StartsAt(arg, 0, "--quoting-style=", 16)
                IfCondition EqualTo(style, 0) ThenBlock: {
                    n = Subtract(arg_len, 10)
                    val = CopySpan(arg, 10, n)
                    SetStyle(val)
                    ReturnValue(1)
                }
            }
        }
        IfCondition GreaterThan(arg_len, 7) ThenBlock: {
            hit = StartsAt(arg, 0, "--sort=", 7)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                n = Subtract(arg_len, 7)
                val = CopySpan(arg, 7, n)
                ApplySort(val)
                ReturnValue(1)
            }
        }
        hit = OptPrefix(arg, arg_len, "--zero", 6, 4)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            LsConfig.zero_term = 1
            LsConfig.color_mode = 0
            LsConfig.across = 0
            LsConfig.commas = 0
            LsConfig.column = 0
            LsConfig.hide_ctrl = 0
            LsConfig.quote_style = 0
            ReturnValue(1)
        }
        hit = OptPrefix(arg, arg_len, "--dired", 7, 4)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            LsConfig.dired = 1
            ReturnValue(1)
        }
        hit = OptPrefix(arg, arg_len, "--hyperlink", 11, 7)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            LsConfig.hyper = 1
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.RangeWalk {
    Input: pat: Address
    Input: i: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        c = RDMEM_8(pat, i)
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(c, 93) ThenBlock: { ReturnValue(0) }
        one = 1
        n1 = Add(i, one)
        d = RDMEM_8(pat, n1)
        IfCondition EqualTo(d, 45) ThenBlock: {
            two = 2
            n2 = Add(i, two)
            e = RDMEM_8(pat, n2)
            IfCondition NotEqual(e, 0) ThenBlock: {
                IfCondition NotEqual(e, 93) ThenBlock: {
                    IfCondition GreaterEqual(ch, c) ThenBlock: {
                        IfCondition LessEqual(ch, e) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                    three = 3
                    n3 = Add(i, three)
                    hit = RangeWalk(pat, n3, ch)
                    ReturnValue(hit)
                }
            }
        }
        IfCondition EqualTo(ch, c) ThenBlock: {
            ReturnValue(1)
        }
        hit = RangeWalk(pat, n1, ch)
        ReturnValue(hit)
    }
}
Function.InClass {
    Input: pat: Address
    Input: pi: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        one = 1
        i = Add(pi, one)
        neg = 0
        c0 = RDMEM_8(pat, i)
        IfCondition EqualTo(c0, 94) ThenBlock: {
            neg = 1
            i = Add(i, one)
        }
        IfCondition EqualTo(c0, 33) ThenBlock: {
            neg = 1
            i = Add(i, one)
        }
        found = RangeWalk(pat, i, ch)
        IfCondition EqualTo(neg, 1) ThenBlock: {
            IfCondition EqualTo(found, 1) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        ReturnValue(found)
    }
}
Function.EndBr {
    Input: pat: Address
    Input: i: Integer
    Output: Integer
    Body: {
        c = RDMEM_8(pat, i)
        one = 1
        IfCondition EqualTo(c, 0) ThenBlock: {
            ReturnValue(i)
        }
        IfCondition EqualTo(c, 93) ThenBlock: {
            nxt = Add(i, one)
            ReturnValue(nxt)
        }
        nxt = Add(i, one)
        hit = EndBr(pat, nxt)
        ReturnValue(hit)
    }
}
Function.ClassEnd {
    Input: pat: Address
    Input: pi: Integer
    Output: Integer
    Body: {
        one = 1
        i = Add(pi, one)
        c0 = RDMEM_8(pat, i)
        IfCondition EqualTo(c0, 94) ThenBlock: {
            i = Add(i, one)
        }
        IfCondition EqualTo(c0, 33) ThenBlock: {
            i = Add(i, one)
        }
        hit = EndBr(pat, i)
        ReturnValue(hit)
    }
}
Function.GlobAt {
    Input: pat: Address
    Input: pi: Integer
    Input: name: Address
    Input: ni: Integer
    Output: Integer
    Body: {
        pb = RDMEM_8(pat, pi)
        nb = RDMEM_8(name, ni)
        IfCondition EqualTo(pb, 0) ThenBlock: {
            IfCondition EqualTo(nb, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        one = 1
        IfCondition EqualTo(pb, 42) ThenBlock: {
            p2 = Add(pi, one)
            hit = GlobAt(pat, p2, name, ni)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(nb, 0) ThenBlock: {
                ReturnValue(0)
            }
            n2 = Add(ni, one)
            hit2 = GlobAt(pat, pi, name, n2)
            ReturnValue(hit2)
        }
        IfCondition EqualTo(pb, 63) ThenBlock: {
            IfCondition EqualTo(nb, 0) ThenBlock: {
                ReturnValue(0)
            }
            p2 = Add(pi, one)
            n2 = Add(ni, one)
            hit = GlobAt(pat, p2, name, n2)
            ReturnValue(hit)
        }
        IfCondition EqualTo(pb, 91) ThenBlock: {
            IfCondition EqualTo(nb, 0) ThenBlock: {
                ReturnValue(0)
            }
            ok = InClass(pat, pi, nb)
            IfCondition EqualTo(ok, 0) ThenBlock: {
                ReturnValue(0)
            }
            p2 = ClassEnd(pat, pi)
            n2 = Add(ni, one)
            hit = GlobAt(pat, p2, name, n2)
            ReturnValue(hit)
        }
        IfCondition NotEqual(pb, nb) ThenBlock: {
            ReturnValue(0)
        }
        p2 = Add(pi, one)
        n2 = Add(ni, one)
        hit = GlobAt(pat, p2, name, n2)
        ReturnValue(hit)
    }
}
Function.NameIgnored {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LsConfig.ignore, 0) ThenBlock: {
            ReturnValue(0)
        }
        hit = GlobAt(LsConfig.ignore, 0, name, 0)
        ReturnValue(hit)
    }
}
Function.OrderAt {
    Input: s: Address
    Input: pos: Integer
    Input: len: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(pos, len) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition GreaterThan(pos, len) ThenBlock: {
            ReturnValue(-1)
        }
        c = RDMEM_8(s, pos)
        dig = IsDigitB(c)
        IfCondition EqualTo(dig, 1) ThenBlock: {
            ReturnValue(0)
        }
        al = IsAlpha(c)
        IfCondition EqualTo(al, 1) ThenBlock: {
            ReturnValue(c)
        }
        IfCondition EqualTo(c, 126) ThenBlock: {
            ReturnValue(-2)
        }
        ReturnValue(Add(c, 257))
    }
}
Function.EatRun {
    Input: s: Address
    Input: n: Integer
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(i, n) ThenBlock: {
            ReturnValue(i)
        }
        c = RDMEM_8(s, i)
        ok = IsAlnum(c)
        IfCondition EqualTo(c, 126) ThenBlock: {
            ok = 1
        }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(i)
        }
        one = 1
        nxt = Add(i, one)
        hit = EatRun(s, n, nxt)
        ReturnValue(hit)
    }
}
Function.EatOne {
    Input: s: Address
    Input: n: Integer
    Input: i: Integer
    Output: Integer
    Body: {
        one = 1
        i1 = Add(i, one)
        IfCondition GreaterEqual(i1, n) ThenBlock: {
            ReturnValue(i)
        }
        dot = RDMEM_8(s, i)
        IfCondition NotEqual(dot, 46) ThenBlock: {
            ReturnValue(i)
        }
        c = RDMEM_8(s, i1)
        ok = IsAlpha(c)
        IfCondition EqualTo(c, 126) ThenBlock: {
            ok = 1
        }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(i)
        }
        i2 = Add(i1, one)
        j = EatRun(s, n, i2)
        hit = EatOne(s, n, j)
        ReturnValue(hit)
    }
}
Function.PrefStep {
    Input: s: Address
    Input: n: Integer
    Input: i: Integer
    Input: pref: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(i, n) ThenBlock: {
            ReturnValue(pref)
        }
        one = 1
        ni = Add(i, one)
        nj = EatOne(s, n, ni)
        hit = PrefStep(s, n, nj, ni)
        ReturnValue(hit)
    }
}
Function.SetDiff {
    Input: d: Integer
    Body: {
        LsConfig.vdiff = d
        ReturnValue(0)
    }
}
Function.DigAt {
    Input: s: Address
    Input: n: Integer
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(i, n) ThenBlock: {
            ReturnValue(0)
        }
        c = RDMEM_8(s, i)
        dig = IsDigitB(c)
        ReturnValue(dig)
    }
}
Function.NonDig {
    Input: s: Address
    Input: n: Integer
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(i, n) ThenBlock: {
            ReturnValue(0)
        }
        c = RDMEM_8(s, i)
        dig = IsDigitB(c)
        IfCondition EqualTo(dig, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}
Function.SkipZero {
    Input: s: Address
    Input: n: Integer
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(i, n) ThenBlock: {
            ReturnValue(i)
        }
        c = RDMEM_8(s, i)
        IfCondition NotEqual(c, 48) ThenBlock: {
            ReturnValue(i)
        }
        one = 1
        nxt = Add(i, one)
        hit = SkipZero(s, n, nxt)
        ReturnValue(hit)
    }
}
Function.VerGo {
    Input: s1: Address
    Input: n1: Integer
    Input: i1: Integer
    Input: s2: Address
    Input: n2: Integer
    Input: i2: Integer
    Output: Integer
    Body: {
        a = 0
        b = 0
        IfCondition GreaterEqual(i1, n1) ThenBlock: { a = 1 }
        IfCondition GreaterEqual(i2, n2) ThenBlock: { b = 1 }
        IfCondition EqualTo(a, 1) ThenBlock: {
            IfCondition EqualTo(b, 1) ThenBlock: {
                ReturnValue(0)
            }
        }
        hit = VerNon(s1, n1, i1, s2, n2, i2)
        ReturnValue(hit)
    }
}
Function.VerDig {
    Input: s1: Address
    Input: n1: Integer
    Input: i1: Integer
    Input: s2: Address
    Input: n2: Integer
    Input: i2: Integer
    Output: Integer
    Body: {
        d1 = DigAt(s1, n1, i1)
        d2 = DigAt(s2, n2, i2)
        IfCondition EqualTo(d1, 1) ThenBlock: {
            IfCondition EqualTo(d2, 1) ThenBlock: {
                c1 = RDMEM_8(s1, i1)
                c2 = RDMEM_8(s2, i2)
                IfCondition EqualTo(LsConfig.vdiff, 0) ThenBlock: {
                    diff = Subtract(c1, c2)
                    SetDiff(diff)
                }
                one = 1
                a = Add(i1, one)
                b = Add(i2, one)
                hit = VerDig(s1, n1, a, s2, n2, b)
                ReturnValue(hit)
            }
        }
        IfCondition EqualTo(d1, 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(d2, 1) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition NotEqual(LsConfig.vdiff, 0) ThenBlock: {
            ReturnValue(LsConfig.vdiff)
        }
        hit = VerGo(s1, n1, i1, s2, n2, i2)
        ReturnValue(hit)
    }
}
Function.AfterZeros {
    Input: s1: Address
    Input: n1: Integer
    Input: i1: Integer
    Input: s2: Address
    Input: n2: Integer
    Input: i2: Integer
    Output: Integer
    Body: {
        SetDiff(0)
        z1 = SkipZero(s1, n1, i1)
        z2 = SkipZero(s2, n2, i2)
        hit = VerDig(s1, n1, z1, s2, n2, z2)
        ReturnValue(hit)
    }
}
Function.VerNon {
    Input: s1: Address
    Input: n1: Integer
    Input: i1: Integer
    Input: s2: Address
    Input: n2: Integer
    Input: i2: Integer
    Output: Integer
    Body: {
        nd1 = NonDig(s1, n1, i1)
        nd2 = NonDig(s2, n2, i2)
        IfCondition EqualTo(nd1, 0) ThenBlock: {
            IfCondition EqualTo(nd2, 0) ThenBlock: {
                hit = AfterZeros(s1, n1, i1, s2, n2, i2)
                ReturnValue(hit)
            }
        }
        o1 = OrderAt(s1, i1, n1)
        o2 = OrderAt(s2, i2, n2)
        IfCondition NotEqual(o1, o2) ThenBlock: {
            ReturnValue(Subtract(o1, o2))
        }
        one = 1
        a = Add(i1, one)
        b = Add(i2, one)
        hit = VerNon(s1, n1, a, s2, n2, b)
        ReturnValue(hit)
    }
}
Function.FileVer {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        ae = RDMEM_8(a, 0)
        be = RDMEM_8(b, 0)
        IfCondition EqualTo(ae, 0) ThenBlock: {
            IfCondition EqualTo(be, 0) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(-1)
        }
        IfCondition EqualTo(be, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(ae, 46) ThenBlock: {
            IfCondition NotEqual(be, 46) ThenBlock: {
                ReturnValue(-1)
            }
            a1 = RDMEM_8(a, 1)
            b1 = RDMEM_8(b, 1)
            IfCondition EqualTo(a1, 0) ThenBlock: {
                IfCondition EqualTo(b1, 0) ThenBlock: {
                    ReturnValue(0)
                }
                ReturnValue(-1)
            }
            IfCondition EqualTo(b1, 0) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(a1, 46) ThenBlock: {
                a2 = RDMEM_8(a, 2)
                IfCondition EqualTo(a2, 0) ThenBlock: {
                    IfCondition EqualTo(b1, 46) ThenBlock: {
                        b2 = RDMEM_8(b, 2)
                        IfCondition EqualTo(b2, 0) ThenBlock: {
                            ReturnValue(0)
                        }
                    }
                    ReturnValue(-1)
                }
            }
            IfCondition EqualTo(b1, 46) ThenBlock: {
                b2 = RDMEM_8(b, 2)
                IfCondition EqualTo(b2, 0) ThenBlock: {
                    ReturnValue(1)
                }
            }
        } ElseBlock: {
            IfCondition EqualTo(be, 46) ThenBlock: {
                ReturnValue(1)
            }
        }
        an = StringLength(a)
        bn = StringLength(b)
        ap = PrefStep(a, an, 0, 0)
        bp = PrefStep(b, bn, 0, 0)
        SetDiff(0)
        r = VerGo(a, ap, 0, b, bp, 0)
        IfCondition NotEqual(r, 0) ThenBlock: {
            ReturnValue(r)
        }
        IfCondition EqualTo(ap, an) ThenBlock: {
            IfCondition EqualTo(bp, bn) ThenBlock: {
                ReturnValue(0)
            }
        }
        SetDiff(0)
        r2 = VerGo(a, an, 0, b, bn, 0)
        ReturnValue(r2)
    }
}
Function.WidthCmp {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        la = StringLength(a)
        lb = StringLength(b)
        IfCondition LessThan(la, lb) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition GreaterThan(la, lb) ThenBlock: {
            ReturnValue(1)
        }
        hit = StrCmp(a, b)
        ReturnValue(hit)
    }
}
Function.NameCmp {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LsConfig.sort_width, 1) ThenBlock: {
            hit = WidthCmp(a, b)
            ReturnValue(hit)
        }
        IfCondition EqualTo(LsConfig.sort_ver, 1) ThenBlock: {
            hit = FileVer(a, b)
            ReturnValue(hit)
        }
        hit = StrCmp(a, b)
        ReturnValue(hit)
    }
}
Function.ColNum {
    Input: buf: Address
    Input: i: Integer
    Input: acc: Integer
    Output: Integer
    Body: {
        ch = RDMEM_8(buf, i)
        IfCondition LessThan(ch, 48) ThenBlock: {
            ReturnValue(acc)
        }
        IfCondition GreaterThan(ch, 57) ThenBlock: {
            ReturnValue(acc)
        }
        d = Subtract(ch, 48)
        acc2 = Multiply(acc, 10)
        acc2 = Add(acc2, d)
        one = 1
        nxt = Add(i, one)
        hit = ColNum(buf, nxt, acc2)
        ReturnValue(hit)
    }
}
Function.TakeCols {
    Input: buf: Address
    Input: at: Integer
    Body: {
        IfCondition EqualTo(LsConfig.width_set, 1) ThenBlock: {
            ReturnValue(0)
        }
        b = RDMEM_8(buf, at)
        IfCondition EqualTo(b, 0) ThenBlock: {
            ReturnValue(0)
        }
        v = ColNum(buf, at, 0)
        LsConfig.width = v
        LsConfig.width_set = 1
        ReturnValue(0)
    }
}
Function.RestLen {
    Input: buf: Address
    Input: i: Integer
    Output: Integer
    Body: {
        ch = RDMEM_8(buf, i)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        nxt = Add(i, one)
        n = RestLen(buf, nxt)
        ReturnValue(Add(n, 1))
    }
}
Function.TakeTimeEnv {
    Input: buf: Address
    Input: at: Integer
    Body: {
        b = RDMEM_8(buf, at)
        IfCondition NotEqual(b, 43) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        start = Add(at, one)
        n = RestLen(buf, start)
        p = CopySpan(buf, start, n)
        LsConfig.time_fmt = p
        LsConfig.iso_date = 0
        LsConfig.long_iso = 0
        ReturnValue(0)
    }
}
Function.FmtSpec {
    Input: spec: Integer
    Body: {
        mtime = LsConfig.stamp
        days = Divide(mtime, 86400)
        z = Add(days, 719468)
        era = Divide(z, 146097)
        doe = Modulo(z, 146097)
        part = doe
        part = Subtract(part, Divide(doe, 1460))
        part = Add(part, Divide(doe, 36524))
        part = Subtract(part, Divide(doe, 146096))
        yoe = Divide(part, 365)
        year = Add(yoe, Multiply(era, 400))
        doy = Multiply(365, yoe)
        doy = Add(doy, Divide(yoe, 4))
        doy = Subtract(doy, Divide(yoe, 100))
        doy = Subtract(doe, doy)
        mp = Multiply(5, doy)
        mp = Add(mp, 2)
        mp = Divide(mp, 153)
        day = Multiply(153, mp)
        day = Add(day, 2)
        day = Divide(day, 5)
        day = Subtract(doy, day)
        day = Add(day, 1)
        month = Add(mp, 3)
        IfCondition GreaterEqual(mp, 10) ThenBlock: {
            month = Subtract(mp, 9)
        }
        IfCondition LessEqual(month, 2) ThenBlock: {
            year = Add(year, 1)
        }
        tod = Modulo(mtime, 86400)
        hour = Divide(tod, 3600)
        rem = Modulo(tod, 3600)
        minute = Divide(rem, 60)
        sec = Modulo(tod, 60)
        IfCondition EqualTo(spec, 89) ThenBlock: {
            ys = NumberToString(year)
            WriteBuffered(ys)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 109) ThenBlock: {
            Pad2(month)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 100) ThenBlock: {
            Pad2(day)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 72) ThenBlock: {
            Pad2(hour)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 77) ThenBlock: {
            Pad2(minute)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 83) ThenBlock: {
            Pad2(sec)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 98) ThenBlock: {
            mon = Subtract(month, 1)
            mname = GetMonthName(mon)
            WriteBuffered(mname)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 122) ThenBlock: {
            WriteOff()
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 90) ThenBlock: {
            IfCondition NotEqual(LsConfig.tz_name, 0) ThenBlock: {
                WriteBuffered(LsConfig.tz_name)
            }
            ReturnValue(0)
        }
        WriteChar(spec)
        ReturnValue(0)
    }
}
Function.FmtStep {
    Input: i: Integer
    Body: {
        ch = RDMEM_8(LsConfig.time_fmt, i)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        IfCondition EqualTo(ch, 37) ThenBlock: {
            j = Add(i, one)
            spec = RDMEM_8(LsConfig.time_fmt, j)
            FmtSpec(spec)
            k = Add(j, one)
            FmtStep(k)
            ReturnValue(0)
        }
        WriteChar(ch)
        nxt = Add(i, one)
        FmtStep(nxt)
        ReturnValue(0)
    }
}
Function.PrintFmt {
    Input: mtime: Integer
    Body: {
        LsConfig.stamp = mtime
        FmtStep(0)
        ReturnValue(0)
    }
}
