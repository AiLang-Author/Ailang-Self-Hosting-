// Quoting, sort, dired, hyperlink, and time-format helpers.
// Pools stay on ls.ailang. No Main. No second import.
LibraryImport.Arena

Function.NoteOut {
    Input: n: Integer
    Body: {
        LsConfig.out_pos = Add(LsConfig.out_pos, n)
        ReturnValue(0)
    }
}
Function.TrackVis {
    Input: str: Address
    Input: len: Integer
    Body: {
        IfCondition EqualTo(LsConfig.esc, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessEqual(len, 0) ThenBlock: {
            ReturnValue(0)
        }
        cur = LsConfig.vis_col
        LsConfig.vis_col = Add(cur, len)
        ReturnValue(0)
    }
}
Function.WriteByte {
    Input: ch: Integer
    Body: {
        IfCondition GreaterEqual(OutputBuf.pos, OutputBuf.cap) ThenBlock: {
            RunTask(FlushBuffer)
        }
        WRMEM_8(OutputBuf.buf, OutputBuf.pos, ch)
        OutputBuf.pos = Add(OutputBuf.pos, 1)
        NoteOut(1)
        ReturnValue(0)
    }
}
Function.EndRec {
    Body: {
        IfCondition EqualTo(LsConfig.zero_term, 1) ThenBlock: {
            WriteByte(0)
        } ElseBlock: {
            WriteByte(10)
        }
        LsConfig.vis_col = 0
        ReturnValue(0)
    }
}
Function.BreakLine {
    Body: {
        WriteByte(10)
        LsConfig.vis_col = 0
        LsConfig.col = 0
        ReturnValue(0)
    }
}
Function.BeginLine {
    Body: {
        IfCondition EqualTo(LsConfig.dired, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.long_format, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.hyper, 1) ThenBlock: {
            ReturnValue(0)
        }
        WriteBuffered("  ")
        ReturnValue(0)
    }
}
Function.DiredOn {
    Output: Integer
    Body: {
        IfCondition EqualTo(LsConfig.dired, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.long_format, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.hyper, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.zero_term, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}
Function.EnsureTab {
    Input: which: Integer
    Body: {
        IfCondition EqualTo(which, 1) ThenBlock: {
            IfCondition EqualTo(LsConfig.dired_at, 0) ThenBlock: {
                LsConfig.dired_at = Allocate(4096)
            }
        } ElseBlock: {
            IfCondition EqualTo(LsConfig.sub_at, 0) ThenBlock: {
                LsConfig.sub_at = Allocate(4096)
            }
        }
        ReturnValue(0)
    }
}
Function.PushPos {
    Input: which: Integer
    Body: {
        EnsureTab(which)
        IfCondition EqualTo(which, 1) ThenBlock: {
            off = Multiply(LsConfig.dired_n, 8)
            WRMEM_64(LsConfig.dired_at, off, LsConfig.out_pos)
            nxt = Add(LsConfig.dired_n, 1)
            LsConfig.dired_n = nxt
        } ElseBlock: {
            off = Multiply(LsConfig.sub_n, 8)
            WRMEM_64(LsConfig.sub_at, off, LsConfig.out_pos)
            nxt = Add(LsConfig.sub_n, 1)
            LsConfig.sub_n = nxt
        }
        ReturnValue(0)
    }
}
Function.NoteFile {
    Body: {
        on = DiredOn()
        IfCondition EqualTo(on, 1) ThenBlock: {
            PushPos(1)
        }
        ReturnValue(0)
    }
}
Function.NoteSub {
    Body: {
        on = DiredOn()
        IfCondition EqualTo(on, 1) ThenBlock: {
            PushPos(2)
        }
        ReturnValue(0)
    }
}
Function.DumpOne {
    Input: tab: Address
    Input: n: Integer
    Input: i: Integer
    Body: {
        IfCondition GreaterEqual(i, n) ThenBlock: {
            ReturnValue(0)
        }
        off = Multiply(i, 8)
        v = RDMEM_64(tab, off)
        WriteBuffered(" ")
        s = NumberToString(v)
        WriteBuffered(s)
        one = 1
        nxt = Add(i, one)
        DumpOne(tab, n, nxt)
        ReturnValue(0)
    }
}
Function.DumpStack {
    Input: prefix: Address
    Input: tab: Address
    Input: n: Integer
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        WriteBuffered(prefix)
        DumpOne(tab, n, 0)
        EndRec()
        ReturnValue(0)
    }
}
Function.DumpDired {
    Body: {
        IfCondition EqualTo(LsConfig.dired, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.long_format, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.hyper, 1) ThenBlock: {
            ReturnValue(0)
        }
        DumpStack("//DIRED//", LsConfig.dired_at, LsConfig.dired_n)
        DumpStack("//SUBDIRED//", LsConfig.sub_at, LsConfig.sub_n)
        WriteBuffered("//DIRED-OPTIONS// --quoting-style=")
        IfCondition EqualTo(LsConfig.qname, 0) ThenBlock: {
            WriteBuffered("literal")
        } ElseBlock: {
            WriteBuffered(LsConfig.qname)
        }
        EndRec()
        ReturnValue(0)
    }
}
Function.IsAlnum {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(ch, 48) ThenBlock: {
            IfCondition LessEqual(ch, 57) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition GreaterEqual(ch, 65) ThenBlock: {
            IfCondition LessEqual(ch, 90) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition GreaterEqual(ch, 97) ThenBlock: {
            IfCondition LessEqual(ch, 122) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}
Function.IsAlpha {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(ch, 65) ThenBlock: {
            IfCondition LessEqual(ch, 90) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition GreaterEqual(ch, 97) ThenBlock: {
            IfCondition LessEqual(ch, 122) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}
Function.IsDigitB {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(ch, 48) ThenBlock: {
            IfCondition LessEqual(ch, 57) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}
Function.IsCtrl {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(ch, 32) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 127) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.IsSafe {
    Input: ch: Integer
    Output: Integer
    Body: {
        al = IsAlnum(ch)
        IfCondition EqualTo(al, 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 46) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 95) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 47) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 45) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 43) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 44) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 64) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}
Function.IsMeta {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ch, 32) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 9) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 10) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 33) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 34) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 35) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 36) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 38) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 39) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 40) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 41) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 42) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 59) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 60) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 61) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 62) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 63) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 91) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 92) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 93) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 94) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 96) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 123) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 124) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 125) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 126) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}
Function.HasUnsafe {
    Input: name: Address
    Input: i: Integer
    Output: Integer
    Body: {
        ch = RDMEM_8(name, i)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(0)
        }
        safe = IsSafe(ch)
        IfCondition EqualTo(safe, 0) ThenBlock: {
            ReturnValue(1)
        }
        one = 1
        nxt = Add(i, one)
        hit = HasUnsafe(name, nxt)
        ReturnValue(hit)
    }
}
Function.HasShellMeta {
    Input: name: Address
    Input: i: Integer
    Output: Integer
    Body: {
        ch = RDMEM_8(name, i)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(0)
        }
        meta = IsMeta(ch)
        IfCondition EqualTo(meta, 1) ThenBlock: {
            ReturnValue(1)
        }
        one = 1
        nxt = Add(i, one)
        hit = HasShellMeta(name, nxt)
        ReturnValue(hit)
    }
}
Function.ShowByte {
    Input: ch: Integer
    Body: {
        IfCondition EqualTo(LsConfig.hide_ctrl, 1) ThenBlock: {
            st = LsConfig.quote_style
            IfCondition LessEqual(st, 2) ThenBlock: {
                ctrl = IsCtrl(ch)
                IfCondition EqualTo(ctrl, 1) ThenBlock: {
                    WriteChar(63)
                    ReturnValue(0)
                }
            }
        }
        WriteChar(ch)
        ReturnValue(0)
    }
}
Function.LitWalk {
    Body: {
        name = LsConfig.qbuf
        n = StringLength(name)
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            ch = RDMEM_8(name, i)
            ShowByte(ch)
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}
Function.NamedEsc {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ch, 7) ThenBlock: { ReturnValue(97) }
        IfCondition EqualTo(ch, 8) ThenBlock: { ReturnValue(98) }
        IfCondition EqualTo(ch, 9) ThenBlock: { ReturnValue(116) }
        IfCondition EqualTo(ch, 10) ThenBlock: { ReturnValue(110) }
        IfCondition EqualTo(ch, 11) ThenBlock: { ReturnValue(118) }
        IfCondition EqualTo(ch, 12) ThenBlock: { ReturnValue(102) }
        IfCondition EqualTo(ch, 13) ThenBlock: { ReturnValue(114) }
        ReturnValue(0)
    }
}
Function.Oct3 {
    Input: ch: Integer
    Body: {
        d2 = Divide(ch, 64)
        rem = Modulo(ch, 64)
        d1 = Divide(rem, 8)
        d0 = Modulo(rem, 8)
        WriteChar(92)
        WriteChar(Add(48, d2))
        WriteChar(Add(48, d1))
        WriteChar(Add(48, d0))
        ReturnValue(0)
    }
}
Function.WriteCEsc {
    Input: ch: Integer
    Body: {
        n = NamedEsc(ch)
        IfCondition NotEqual(n, 0) ThenBlock: {
            WriteChar(92)
            WriteChar(n)
            ReturnValue(0)
        }
        IfCondition EqualTo(ch, 92) ThenBlock: {
            WriteChar(92)
            WriteChar(92)
            ReturnValue(0)
        }
        IfCondition EqualTo(ch, 34) ThenBlock: {
            WriteChar(92)
            WriteChar(34)
            ReturnValue(0)
        }
        Oct3(ch)
        ReturnValue(0)
    }
}
Function.WriteDolEsc {
    Input: ch: Integer
    Body: {
        IfCondition EqualTo(ch, 39) ThenBlock: {
            WriteChar(92)
            WriteChar(39)
            ReturnValue(0)
        }
        IfCondition EqualTo(ch, 92) ThenBlock: {
            WriteChar(92)
            WriteChar(92)
            ReturnValue(0)
        }
        n = NamedEsc(ch)
        IfCondition NotEqual(n, 0) ThenBlock: {
            WriteChar(92)
            WriteChar(n)
            ReturnValue(0)
        }
        Oct3(ch)
        ReturnValue(0)
    }
}
Function.CKind {
    Input: ch: Integer
    Output: Integer
    Body: {
        ctrl = IsCtrl(ch)
        IfCondition EqualTo(ctrl, 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 92) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 34) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}
Function.EscKind {
    Input: ch: Integer
    Output: Integer
    Body: {
        ctrl = IsCtrl(ch)
        IfCondition EqualTo(ctrl, 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 92) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 39) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}
Function.CStep {
    Input: i: Integer
    Body: {
        ch = RDMEM_8(LsConfig.qbuf, i)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(0)
        }
        kind = CKind(ch)
        IfCondition EqualTo(kind, 1) ThenBlock: {
            WriteCEsc(ch)
        } ElseBlock: {
            WriteChar(ch)
        }
        one = 1
        nxt = Add(i, one)
        CStep(nxt)
        ReturnValue(0)
    }
}
Function.EStep {
    Input: i: Integer
    Body: {
        ch = RDMEM_8(LsConfig.qbuf, i)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(ch, 32) ThenBlock: {
            WriteChar(92)
            WriteChar(32)
        } ElseBlock: {
            kind = CKind(ch)
            IfCondition EqualTo(kind, 1) ThenBlock: {
                WriteCEsc(ch)
            } ElseBlock: {
                WriteChar(ch)
            }
        }
        one = 1
        nxt = Add(i, one)
        EStep(nxt)
        ReturnValue(0)
    }
}
Function.EscStep {
    Input: i: Integer
    Body: {
        ch = RDMEM_8(LsConfig.qbuf, i)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(0)
        }
        kind = EscKind(ch)
        IfCondition EqualTo(kind, 1) ThenBlock: {
            IfCondition EqualTo(LsConfig.in_sq, 1) ThenBlock: {
                WriteChar(39)
                LsConfig.in_sq = 0
            }
            WriteChar(36)
            WriteChar(39)
            WriteDolEsc(ch)
            WriteChar(39)
        } ElseBlock: {
            IfCondition EqualTo(LsConfig.in_sq, 0) ThenBlock: {
                WriteChar(39)
                LsConfig.in_sq = 1
            }
            WriteChar(ch)
        }
        one = 1
        nxt = Add(i, one)
        EscStep(nxt)
        ReturnValue(0)
    }
}
Function.ShellEsc {
    Body: {
        LsConfig.in_sq = 0
        EscStep(0)
        IfCondition EqualTo(LsConfig.in_sq, 1) ThenBlock: {
            WriteChar(39)
        }
        ReturnValue(0)
    }
}
Function.ShellAlways {
    Body: {
        WriteChar(39)
        LitWalk()
        WriteChar(39)
        ReturnValue(0)
    }
}
Function.CQuote {
    Body: {
        WriteChar(34)
        CStep(0)
        WriteChar(34)
        ReturnValue(0)
    }
}
Function.LocaleQ {
    Body: {
        WriteChar(39)
        CStep(0)
        WriteChar(39)
        ReturnValue(0)
    }
}
Function.WriteQuoted {
    Input: name: Address
    Body: {
        LsConfig.qbuf = name
        st = LsConfig.quote_style
        IfCondition EqualTo(st, 0) ThenBlock: {
            LitWalk()
            ReturnValue(0)
        }
        IfCondition EqualTo(st, 1) ThenBlock: {
            bad = HasShellMeta(name, 0)
            IfCondition EqualTo(bad, 0) ThenBlock: {
                LitWalk()
                ReturnValue(0)
            }
            ShellAlways()
            ReturnValue(0)
        }
        IfCondition EqualTo(st, 2) ThenBlock: {
            ShellAlways()
            ReturnValue(0)
        }
        IfCondition EqualTo(st, 3) ThenBlock: {
            bad = HasUnsafe(name, 0)
            IfCondition EqualTo(bad, 0) ThenBlock: {
                LitWalk()
                ReturnValue(0)
            }
            ShellEsc()
            ReturnValue(0)
        }
        IfCondition EqualTo(st, 4) ThenBlock: {
            ShellEsc()
            ReturnValue(0)
        }
        IfCondition EqualTo(st, 5) ThenBlock: {
            CQuote()
            ReturnValue(0)
        }
        IfCondition EqualTo(st, 6) ThenBlock: {
            EStep(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(st, 7) ThenBlock: {
            LocaleQ()
            ReturnValue(0)
        }
        IfCondition EqualTo(st, 8) ThenBlock: {
            CQuote()
            ReturnValue(0)
        }
        LitWalk()
        ReturnValue(0)
    }
}
Function.EscByteWidth {
    Input: ch: Integer
    Output: Integer
    Body: {
        n = NamedEsc(ch)
        IfCondition NotEqual(n, 0) ThenBlock: {
            ReturnValue(2)
        }
        IfCondition EqualTo(ch, 92) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(ch, 34) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(ch, 39) ThenBlock: { ReturnValue(2) }
        ReturnValue(4)
    }
}
Function.EscWidth {
    Input: name: Address
    Input: i: Integer
    Input: inq: Integer
    Output: Integer
    Body: {
        ch = RDMEM_8(name, i)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            IfCondition EqualTo(inq, 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        one = 1
        nxt = Add(i, one)
        kind = EscKind(ch)
        IfCondition EqualTo(kind, 1) ThenBlock: {
            extra = 0
            IfCondition EqualTo(inq, 1) ThenBlock: {
                extra = 1
            }
            piece = EscByteWidth(ch)
            rest = EscWidth(name, nxt, 0)
            sum = Add(extra, 3)
            sum = Add(sum, piece)
            sum = Add(sum, rest)
            ReturnValue(sum)
        }
        addq = 0
        IfCondition EqualTo(inq, 0) ThenBlock: {
            addq = 1
        }
        rest = EscWidth(name, nxt, 1)
        sum = Add(addq, 1)
        sum = Add(sum, rest)
        ReturnValue(sum)
    }
}
Function.CWidth {
    Input: name: Address
    Input: i: Integer
    Output: Integer
    Body: {
        ch = RDMEM_8(name, i)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        nxt = Add(i, one)
        rest = CWidth(name, nxt)
        w = 1
        kind = CKind(ch)
        IfCondition EqualTo(kind, 1) ThenBlock: {
            w = EscByteWidth(ch)
        }
        sum = Add(w, rest)
        ReturnValue(sum)
    }
}
Function.EWidth {
    Input: name: Address
    Input: i: Integer
    Output: Integer
    Body: {
        ch = RDMEM_8(name, i)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        nxt = Add(i, one)
        rest = EWidth(name, nxt)
        w = 1
        IfCondition EqualTo(ch, 32) ThenBlock: {
            w = 2
        } ElseBlock: {
            kind = CKind(ch)
            IfCondition EqualTo(kind, 1) ThenBlock: {
                w = EscByteWidth(ch)
            }
        }
        sum = Add(w, rest)
        ReturnValue(sum)
    }
}
Function.QuoteLen {
    Input: name: Address
    Output: Integer
    Body: {
        st = LsConfig.quote_style
        n = StringLength(name)
        IfCondition EqualTo(st, 0) ThenBlock: {
            ReturnValue(n)
        }
        IfCondition EqualTo(st, 1) ThenBlock: {
            bad = HasShellMeta(name, 0)
            IfCondition EqualTo(bad, 0) ThenBlock: {
                ReturnValue(n)
            }
            ReturnValue(Add(n, 2))
        }
        IfCondition EqualTo(st, 2) ThenBlock: {
            ReturnValue(Add(n, 2))
        }
        IfCondition EqualTo(st, 3) ThenBlock: {
            bad = HasUnsafe(name, 0)
            IfCondition EqualTo(bad, 0) ThenBlock: {
                ReturnValue(n)
            }
            w = EscWidth(name, 0, 0)
            ReturnValue(w)
        }
        IfCondition EqualTo(st, 4) ThenBlock: {
            w = EscWidth(name, 0, 0)
            ReturnValue(w)
        }
        IfCondition EqualTo(st, 6) ThenBlock: {
            w = EWidth(name, 0)
            ReturnValue(w)
        }
        body = CWidth(name, 0)
        ReturnValue(Add(body, 2))
    }
}
Function.NameQuoted {
    Input: name: Address
    Output: Integer
    Body: {
        st = LsConfig.quote_style
        IfCondition EqualTo(st, 1) ThenBlock: {
            bad = HasShellMeta(name, 0)
            ReturnValue(bad)
        }
        IfCondition EqualTo(st, 3) ThenBlock: {
            bad = HasUnsafe(name, 0)
            ReturnValue(bad)
        }
        ReturnValue(0)
    }
}
Function.MarkOne {
    Input: entries: Address
    Input: i: Integer
    Input: count: Integer
    Body: {
        IfCondition GreaterEqual(i, count) ThenBlock: {
            ReturnValue(0)
        }
        name = GetEntryName(entries, i)
        q = NameQuoted(name)
        IfCondition EqualTo(q, 1) ThenBlock: {
            LsConfig.some_q = 1
            ReturnValue(0)
        }
        one = 1
        nxt = Add(i, one)
        MarkOne(entries, nxt, count)
        ReturnValue(0)
    }
}
Function.MarkQuoted {
    Input: entries: Address
    Input: count: Integer
    Body: {
        LsConfig.some_q = 0
        MarkOne(entries, 0, count)
        ReturnValue(0)
    }
}
Function.NeedPad {
    Input: name: Address
    Body: {
        IfCondition EqualTo(LsConfig.some_q, 0) ThenBlock: {
            ReturnValue(0)
        }
        st = LsConfig.quote_style
        ok = 0
        IfCondition EqualTo(st, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(st, 3) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        q = NameQuoted(name)
        IfCondition EqualTo(q, 1) ThenBlock: {
            ReturnValue(0)
        }
        use = 0
        IfCondition EqualTo(LsConfig.long_format, 1) ThenBlock: {
            use = 1
        }
        IfCondition EqualTo(LsConfig.across, 1) ThenBlock: {
            use = 1
        }
        IfCondition EqualTo(LsConfig.column, 1) ThenBlock: {
            use = 1
        }
        IfCondition EqualTo(use, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.width_set, 1) ThenBlock: {
            IfCondition EqualTo(LsConfig.width, 0) ThenBlock: {
                IfCondition EqualTo(LsConfig.long_format, 0) ThenBlock: {
                    ReturnValue(0)
                }
            }
        }
        WriteBuffered(" ")
        ReturnValue(0)
    }
}
Function.BeginVis {
    Input: name: Address
    Body: {
        LsConfig.name_col = LsConfig.vis_col
        qw = QuoteLen(name)
        LsConfig.qwidth = qw
        ReturnValue(0)
    }
}
Function.MaybeK {
    Body: {
        IfCondition EqualTo(LsPaint.used, 0) ThenBlock: {
            ReturnValue(0)
        }
        w = 80
        IfCondition EqualTo(LsConfig.width_set, 1) ThenBlock: {
            IfCondition EqualTo(LsConfig.width, 0) ThenBlock: {
                ReturnValue(0)
            }
            w = LsConfig.width
        }
        start = LsConfig.name_col
        qw = LsConfig.qwidth
        IfCondition LessEqual(qw, 0) ThenBlock: {
            ReturnValue(0)
        }
        a = Divide(start, w)
        span = Add(start, qw)
        one = 1
        span = Subtract(span, one)
        b = Divide(span, w)
        IfCondition EqualTo(a, b) ThenBlock: {
            ReturnValue(0)
        }
        LsConfig.esc = 1
        WriteChar(27)
        WriteBuffered("[K")
        LsConfig.esc = 0
        ReturnValue(0)
    }
}
Function.IsTarget {
    Output: Integer
    Body: {
        IfCondition EqualTo(LsPaint.c_ln, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = StringLength(LsPaint.c_ln)
        IfCondition NotEqual(n, 6) ThenBlock: {
            ReturnValue(0)
        }
        hit = StartsAt(LsPaint.c_ln, 0, "target", 6)
        ReturnValue(hit)
    }
}
Function.NeedLinkStat {
    Output: Integer
    Body: {
        t = IsTarget()
        IfCondition EqualTo(t, 1) ThenBlock: {
            ReturnValue(1)
        }
        live = Colored(LsPaint.c_or)
        IfCondition EqualTo(live, 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.ProbeLink {
    Input: dirfd: Integer
    Input: name: Address
    Input: mode: Integer
    Body: {
        typ = BitwiseAnd(mode, 61440)
        need = NeedLinkStat()
        IfCondition NotEqual(typ, 40960) ThenBlock: {
            LsConfig.link_ok = 1
            LsConfig.link_mode = mode
            ReturnValue(0)
        }
        IfCondition EqualTo(need, 0) ThenBlock: {
            LsConfig.link_ok = 1
            LsConfig.link_mode = mode
            ReturnValue(0)
        }
        sb = Allocate(144)
        res = SystemCall(262, dirfd, name, sb, 0)
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(sb, 144)
            LsConfig.link_ok = 0
            LsConfig.link_mode = 0
            ReturnValue(0)
        }
        m2 = GetUInt32(sb, 24)
        Deallocate(sb, 144)
        LsConfig.link_ok = 1
        LsConfig.link_mode = m2
        ReturnValue(0)
    }
}
Function.ResolveCode {
    Input: name: Address
    Input: mode: Integer
    Input: nlink: Integer
    Output: Address
    Body: {
        typ = BitwiseAnd(mode, 61440)
        IfCondition EqualTo(typ, 40960) ThenBlock: {
            t = IsTarget()
            IfCondition EqualTo(t, 1) ThenBlock: {
                IfCondition EqualTo(LsConfig.link_ok, 0) ThenBlock: {
                    IfCondition NotEqual(LsPaint.c_or, 0) ThenBlock: {
                        ReturnValue(LsPaint.c_or)
                    }
                    ReturnValue(0)
                }
                code = PickCode(LsConfig.link_mode, 1, name)
                ReturnValue(code)
            }
            IfCondition EqualTo(LsConfig.link_ok, 0) ThenBlock: {
                live = Colored(LsPaint.c_or)
                IfCondition EqualTo(live, 1) ThenBlock: {
                    ReturnValue(LsPaint.c_or)
                }
            }
            live = Colored(LsPaint.c_ln)
            IfCondition EqualTo(live, 1) ThenBlock: {
                ReturnValue(LsPaint.c_ln)
            }
            ReturnValue(0)
        }
        code = PickCode(mode, nlink, name)
        ReturnValue(code)
    }
}
Function.RawReg {
    Input: mode: Integer
    Input: nlink: Integer
    Input: name: Address
    Output: Address
    Body: {
        su = BitwiseAnd(mode, 2048)
        IfCondition NotEqual(su, 0) ThenBlock: {
            IfCondition NotEqual(LsPaint.c_su, 0) ThenBlock: {
                ReturnValue(LsPaint.c_su)
            }
        }
        sg = BitwiseAnd(mode, 1024)
        IfCondition NotEqual(sg, 0) ThenBlock: {
            IfCondition NotEqual(LsPaint.c_sg, 0) ThenBlock: {
                ReturnValue(LsPaint.c_sg)
            }
        }
        ix = BitwiseAnd(mode, 73)
        IfCondition NotEqual(ix, 0) ThenBlock: {
            IfCondition NotEqual(LsPaint.c_ex, 0) ThenBlock: {
                ReturnValue(LsPaint.c_ex)
            }
        }
        IfCondition GreaterThan(nlink, 1) ThenBlock: {
            IfCondition NotEqual(LsPaint.c_mh, 0) ThenBlock: {
                ReturnValue(LsPaint.c_mh)
            }
        }
        ext = MatchExt(name)
        IfCondition NotEqual(ext, 0) ThenBlock: {
            ReturnValue(ext)
        }
        IfCondition NotEqual(LsPaint.c_fi, 0) ThenBlock: {
            ReturnValue(LsPaint.c_fi)
        }
        ReturnValue(0)
    }
}
Function.RawCode {
    Input: name: Address
    Input: mode: Integer
    Input: nlink: Integer
    Output: Address
    Body: {
        typ = BitwiseAnd(mode, 61440)
        IfCondition EqualTo(typ, 40960) ThenBlock: {
            code = ResolveCode(name, mode, nlink)
            ReturnValue(code)
        }
        IfCondition EqualTo(typ, 32768) ThenBlock: {
            code = RawReg(mode, nlink, name)
            ReturnValue(code)
        }
        code = PickCode(mode, nlink, name)
        ReturnValue(code)
    }
}
Function.HexChar {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 10) ThenBlock: {
            ReturnValue(Add(48, n))
        }
        ReturnValue(Add(87, n))
    }
}
Function.BaseStart {
    Input: s: Address
    Input: i: Integer
    Input: last: Integer
    Output: Integer
    Body: {
        ch = RDMEM_8(s, i)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(last)
        }
        one = 1
        nxt = Add(i, one)
        IfCondition EqualTo(ch, 47) ThenBlock: {
            hit = BaseStart(s, nxt, nxt)
            ReturnValue(hit)
        }
        hit = BaseStart(s, nxt, last)
        ReturnValue(hit)
    }
}
Function.EncStep {
    Input: name: Address
    Input: i: Integer
    Input: buf: Address
    Input: o: Integer
    Body: {
        ch = RDMEM_8(name, i)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            WRMEM_8(buf, o, 0)
            ReturnValue(0)
        }
        safe = IsAlnum(ch)
        IfCondition EqualTo(ch, 45) ThenBlock: { safe = 1 }
        IfCondition EqualTo(ch, 46) ThenBlock: { safe = 1 }
        IfCondition EqualTo(ch, 95) ThenBlock: { safe = 1 }
        IfCondition EqualTo(ch, 126) ThenBlock: { safe = 1 }
        one = 1
        IfCondition EqualTo(safe, 1) ThenBlock: {
            WRMEM_8(buf, o, ch)
            i2 = Add(i, one)
            o2 = Add(o, one)
            EncStep(name, i2, buf, o2)
            ReturnValue(0)
        }
        WRMEM_8(buf, o, 37)
        hi = Divide(ch, 16)
        lo = Modulo(ch, 16)
        hc = HexChar(hi)
        lc = HexChar(lo)
        WRMEM_8(buf, Add(o, one), hc)
        two = 2
        WRMEM_8(buf, Add(o, two), lc)
        i2 = Add(i, one)
        three = 3
        o2 = Add(o, three)
        EncStep(name, i2, buf, o2)
        ReturnValue(0)
    }
}
Function.EncOf {
    Input: path: Address
    Output: Address
    Body: {
        b = BaseStart(path, 0, 0)
        buf = Allocate(1024)
        EncStep(path, b, buf, 0)
        ReturnValue(buf)
    }
}
Function.UrlPath {
    Input: path: Address
    Output: Address
    Body: {
        sb = Allocate(144)
        res = SystemCall(262, LsConfig.cur_fd, path, sb, 256)
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(sb, 144)
            ReturnValue(path)
        }
        mode = GetUInt32(sb, 24)
        Deallocate(sb, 144)
        typ = BitwiseAnd(mode, 61440)
        IfCondition NotEqual(typ, 40960) ThenBlock: {
            ReturnValue(path)
        }
        tgt = ReadLinkAt(LsConfig.cur_fd, path)
        IfCondition EqualTo(tgt, 0) ThenBlock: {
            ReturnValue(path)
        }
        ReturnValue(tgt)
    }
}
Function.WriteOsc {
    Input: path: Address
    Body: {
        u = UrlPath(path)
        enc = EncOf(u)
        LsConfig.esc = 1
        WriteChar(27)
        WriteBuffered("]8;;file:///")
        WriteBuffered(enc)
        WriteChar(7)
        LsConfig.esc = 0
        ReturnValue(0)
    }
}
Function.CloseOsc {
    Body: {
        LsConfig.esc = 1
        WriteChar(27)
        WriteBuffered("]8;;")
        WriteChar(7)
        LsConfig.esc = 0
        ReturnValue(0)
    }
}
Function.OpenNorm {
    Body: {
        IfCondition EqualTo(LsPaint.active, 0) ThenBlock: {
            ReturnValue(0)
        }
        live = Colored(LsPaint.c_no)
        IfCondition EqualTo(live, 0) ThenBlock: {
            ReturnValue(0)
        }
        LsConfig.esc = 1
        IfCondition EqualTo(LsPaint.used, 0) ThenBlock: {
            LsPaint.used = 1
            WriteChar(27)
            WriteBuffered("[0m")
        }
        WriteChar(27)
        WriteBuffered("[")
        WriteBuffered(LsPaint.c_no)
        WriteBuffered("m")
        LsConfig.esc = 0
        ReturnValue(0)
    }
}
Function.PaintColored {
    Input: name: Address
    Input: mode: Integer
    Input: nlink: Integer
    Body: {
        code = RawCode(name, mode, nlink)
        NeedPad(name)
        IfCondition EqualTo(LsConfig.hyper, 1) ThenBlock: {
            WriteOsc(name)
        }
        IfCondition NotEqual(code, 0) ThenBlock: {
            LsConfig.esc = 1
            WriteChar(27)
            WriteBuffered("[m")
            WriteChar(27)
            WriteBuffered("[")
            WriteBuffered(code)
            WriteBuffered("m")
            LsConfig.esc = 0
        }
        NoteFile()
        BeginVis(name)
        WriteQuoted(name)
        NoteFile()
        LsConfig.esc = 1
        WriteChar(27)
        WriteBuffered("[0m")
        LsConfig.esc = 0
        MaybeK()
        IfCondition EqualTo(LsConfig.hyper, 1) ThenBlock: {
            CloseOsc()
        }
        ind = IndByte(mode)
        IfCondition NotEqual(ind, 0) ThenBlock: {
            WriteChar(ind)
        }
        ReturnValue(0)
    }
}
Function.ColorTarget {
    Input: dirfd: Integer
    Input: target: Address
    Body: {
        sb = Allocate(144)
        res = SystemCall(262, dirfd, target, sb, 0)
        Deallocate(sb, 144)
        use = 0
        IfCondition LessThan(res, 0) ThenBlock: {
            IfCondition NotEqual(LsPaint.c_mi, 0) ThenBlock: {
                ln = StringLength(LsPaint.c_mi)
                IfCondition GreaterThan(ln, 0) ThenBlock: {
                    use = 1
                }
            }
        }
        IfCondition EqualTo(LsConfig.hyper, 1) ThenBlock: {
            WriteOsc(target)
        }
        IfCondition EqualTo(LsPaint.active, 0) ThenBlock: {
            use = 0
        }
        IfCondition EqualTo(use, 1) ThenBlock: {
            WriteOpenColor(LsPaint.c_mi)
        }
        WriteQuoted(target)
        IfCondition EqualTo(use, 1) ThenBlock: {
            WriteEndColor()
        }
        IfCondition EqualTo(LsConfig.hyper, 1) ThenBlock: {
            CloseOsc()
        }
        ReturnValue(0)
    }
}
Function.ErrText {
    Input: rc: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(rc, -13) ThenBlock: {
            ReturnValue("Permission denied")
        }
        IfCondition EqualTo(rc, -2) ThenBlock: {
            ReturnValue("No such file or directory")
        }
        IfCondition EqualTo(rc, -40) ThenBlock: {
            ReturnValue("Too many levels of symbolic links")
        }
        IfCondition EqualTo(rc, -20) ThenBlock: {
            ReturnValue("Not a directory")
        }
        IfCondition EqualTo(rc, -1) ThenBlock: {
            ReturnValue("Operation not permitted")
        }
        ReturnValue("No such file or directory")
    }
}
Function.TypeLetter {
    Input: dt: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(dt, 4) ThenBlock: { ReturnValue(100) }
        IfCondition EqualTo(dt, 8) ThenBlock: { ReturnValue(45) }
        IfCondition EqualTo(dt, 10) ThenBlock: { ReturnValue(108) }
        IfCondition EqualTo(dt, 1) ThenBlock: { ReturnValue(112) }
        IfCondition EqualTo(dt, 12) ThenBlock: { ReturnValue(115) }
        IfCondition EqualTo(dt, 6) ThenBlock: { ReturnValue(98) }
        IfCondition EqualTo(dt, 2) ThenBlock: { ReturnValue(99) }
        ReturnValue(63)
    }
}
Function.PadSp {
    Input: n: Integer
    Body: {
        IfCondition LessEqual(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        WriteChar(32)
        one = 1
        nxt = Subtract(n, one)
        PadSp(nxt)
        ReturnValue(0)
    }
}
Function.FailShown {
    Input: dirfd: Integer
    Input: filename: Address
    Output: Address
    Body: {
        IfCondition EqualTo(dirfd, -100) ThenBlock: {
            ReturnValue(filename)
        }
        IfCondition EqualTo(LsConfig.cur_path, 0) ThenBlock: {
            ReturnValue(filename)
        }
        full = BuildPath(LsConfig.cur_path, filename)
        ReturnValue(full)
    }
}
Function.FailStat {
    Input: dirfd: Integer
    Input: filename: Address
    Input: result: Integer
    Body: {
        LsConfig.minor = 1
        shown = FailShown(dirfd, filename)
        WriteStderr("ls: cannot access '")
        WriteStderr(shown)
        WriteStderr("': ")
        msg = ErrText(result)
        WriteStderr(msg)
        WriteStderr("\n")
        letter = TypeLetter(LsConfig.cur_dt)
        WriteChar(letter)
        WriteBuffered("?????????")
        WriteBuffered(" ?")
        IfCondition EqualTo(LsConfig.omit_owner, 0) ThenBlock: {
            WriteBuffered(" ?")
        }
        IfCondition EqualTo(LsConfig.omit_group, 0) ThenBlock: {
            WriteBuffered(" ?")
        }
        WriteBuffered(" ?")
        PadSp(12)
        WriteChar(63)
        WriteBuffered(" ")
        NoteFile()
        WriteQuoted(filename)
        NoteFile()
        EndRec()
        ReturnValue(0)
    }
}
Function.EmitHead {
    Input: path: Address
    Body: {
        IfCondition EqualTo(LsConfig.started, 1) ThenBlock: {
            WriteByte(10)
            LsConfig.vis_col = 0
        }
        LsConfig.started = 1
        LsConfig.cur_fd = -100
        BeginLine()
        IfCondition EqualTo(LsConfig.hyper, 1) ThenBlock: {
            WriteOsc(path)
        }
        NoteSub()
        WriteQuoted(path)
        NoteSub()
        IfCondition EqualTo(LsConfig.hyper, 1) ThenBlock: {
            CloseOsc()
        }
        WriteChar(58)
        EndRec()
        ReturnValue(0)
    }
}
Function.CheckZero {
    Body: {
        IfCondition EqualTo(LsConfig.zero_term, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.dired, 1) ThenBlock: {
            WriteStderr("ls: --dired and --zero are incompatible\n")
            SystemCall(60, 2)
        }
        LsConfig.color_mode = 0
        LsConfig.across = 0
        LsConfig.commas = 0
        LsConfig.column = 0
        LsConfig.hide_ctrl = 0
        LsConfig.quote_style = 0
        LsConfig.qname = "literal"
        LsPaint.active = 0
        ReturnValue(0)
    }
}
