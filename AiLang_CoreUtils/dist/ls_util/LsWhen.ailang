// Dates, stat, and name emit. Pools stay on ls.ailang. No Main.
LibraryImport.Arena

Function.Pad2 {
    Input: n: Integer
    Body: {
        IfCondition LessThan(n, 10) ThenBlock: {
            WriteBuffered("0")
        }
        s = NumberToString(n)
        WriteBuffered(s)
    }
}
Function.PrintCivil {
    Input: mtime: Integer
    Body: {
        days = Divide(mtime, 86400)
        z = Add(days, 719468)
        era = Divide(z, 146097)
        doe = Modulo(z, 146097)
        part = doe
        part = Subtract(part, Divide(doe, 1460))
        part = Add(part, Divide(doe, 36524))
        part = Subtract(part, Divide(doe, 146096))
        yoe = Divide(part, 365)
        year = Add(yoe, Multiply(era, 400))
        doy = Multiply(365, yoe)
        doy = Add(doy, Divide(yoe, 4))
        doy = Subtract(doy, Divide(yoe, 100))
        doy = Subtract(doe, doy)
        mp = Multiply(5, doy)
        mp = Add(mp, 2)
        mp = Divide(mp, 153)
        day = Multiply(153, mp)
        day = Add(day, 2)
        day = Divide(day, 5)
        day = Subtract(doy, day)
        day = Add(day, 1)
        month = Add(mp, 3)
        IfCondition GreaterEqual(mp, 10) ThenBlock: {
            month = Subtract(mp, 9)
        }
        IfCondition LessEqual(month, 2) ThenBlock: {
            year = Add(year, 1)
        }
        tod = Modulo(mtime, 86400)
        hour = Divide(tod, 3600)
        rem = Modulo(tod, 3600)
        minute = Divide(rem, 60)
        IfCondition EqualTo(LsConfig.long_iso, 1) ThenBlock: {
            ys = NumberToString(year)
            WriteBuffered(ys)
            WriteBuffered("-")
            Pad2(month)
            WriteBuffered("-")
            Pad2(day)
            WriteBuffered(" ")
            Pad2(hour)
            WriteBuffered(":")
            Pad2(minute)
            ReturnValue(0)
        }
        mon = Subtract(month, 1)
        mname = GetMonthName(mon)
        WriteBuffered(mname)
        WriteBuffered(" ")
        IfCondition LessThan(day, 10) ThenBlock: {
            WriteBuffered(" ")
        }
        ds = NumberToString(day)
        WriteBuffered(ds)
        tb = Allocate(16)
        SystemCall(228, 0, tb)
        now = GetUInt64(tb, 0)
        Deallocate(tb, 16)
        ago = Subtract(now, 15778476)
        recent = 0
        IfCondition GreaterThan(mtime, ago) ThenBlock: {
            IfCondition LessThan(mtime, now) ThenBlock: {
                recent = 1
            }
        }
        IfCondition EqualTo(recent, 1) ThenBlock: {
            WriteBuffered(" ")
            Pad2(hour)
            WriteBuffered(":")
            Pad2(minute)
        } ElseBlock: {
            WriteBuffered("  ")
            ys = NumberToString(year)
            WriteBuffered(ys)
        }
        ReturnValue(0)
    }
}
Function.ScaleSize {
    Input: size: Integer
    Output: Address
    Body: {
        b = LsConfig.file_block
        IfCondition LessEqual(b, 1) ThenBlock: {
            ReturnValue(NumberToString(size))
        }
        q = Divide(size, b)
        ReturnValue(NumberToString(q))
    }
}
Function.StatCmd {
    Input: path: Address
    Body: {
        LsStat.err = 0
        LsStat.is_dir = 0
        LsStat.ok = 0
        sb = Allocate(144)
        res = SystemCall(262, -100, path, sb, 256)
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(sb, 144)
            LsStat.err = 2
            ReturnValue(0)
        }
        mode = GetUInt32(sb, 24)
        nlink = GetUInt64(sb, 16)
        ino = GetUInt64(sb, 8)
        blocks = GetUInt64(sb, 64)
        Deallocate(sb, 144)
        LsStat.mode = mode
        LsStat.nlink = nlink
        LsStat.ino = ino
        LsStat.blocks = blocks
        LsStat.ok = 1
        typ = BitwiseAnd(mode, 61440)
        IfCondition EqualTo(typ, 16384) ThenBlock: {
            LsStat.is_dir = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(typ, 40960) ThenBlock: {
            ReturnValue(0)
        }
        follow = 0
        IfCondition EqualTo(LsConfig.deref, 3) ThenBlock: {
            follow = 1
        }
        IfCondition EqualTo(LsConfig.deref, 2) ThenBlock: {
            follow = 1
        }
        IfCondition EqualTo(LsConfig.indicator, 0) ThenBlock: {
            IfCondition EqualTo(LsConfig.long_format, 0) ThenBlock: {
                IfCondition EqualTo(LsConfig.dir_as_file, 0) ThenBlock: {
                    IfCondition EqualTo(LsConfig.deref, 0) ThenBlock: {
                        follow = 1
                    }
                }
            }
        }
        IfCondition EqualTo(follow, 0) ThenBlock: {
            ReturnValue(0)
        }
        sb2 = Allocate(144)
        res2 = SystemCall(262, -100, path, sb2, 0)
        IfCondition LessThan(res2, 0) ThenBlock: {
            Deallocate(sb2, 144)
            IfCondition EqualTo(LsConfig.deref, 2) ThenBlock: {
                LsStat.err = 2
            }
            IfCondition EqualTo(LsConfig.deref, 3) ThenBlock: {
                LsStat.err = 2
            }
            ReturnValue(0)
        }
        mode2 = GetUInt32(sb2, 24)
        nlink2 = GetUInt64(sb2, 16)
        ino2 = GetUInt64(sb2, 8)
        blocks2 = GetUInt64(sb2, 64)
        Deallocate(sb2, 144)
        typ2 = BitwiseAnd(mode2, 61440)
        IfCondition EqualTo(typ2, 16384) ThenBlock: {
            LsStat.is_dir = 1
            LsStat.mode = mode2
            LsStat.nlink = nlink2
            LsStat.ino = ino2
            LsStat.blocks = blocks2
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.deref, 2) ThenBlock: {
            LsStat.mode = mode2
            LsStat.nlink = nlink2
            LsStat.ino = ino2
            LsStat.blocks = blocks2
        }
        IfCondition EqualTo(LsConfig.deref, 3) ThenBlock: {
            LsStat.mode = mode2
            LsStat.nlink = nlink2
            LsStat.ino = ino2
            LsStat.blocks = blocks2
        }
        ReturnValue(0)
    }
}
Function.EmitKnown {
    Input: name: Address
    Body: {
        LsConfig.cur_fd = -100
        IfCondition EqualTo(LsConfig.print_inode, 1) ThenBlock: {
            s = NumberToString(LsStat.ino)
            WriteBuffered(s)
            WriteBuffered(" ")
        }
        ProbeLink(-100, name, LsStat.mode)
        OpenNorm()
        PaintName(name, LsStat.mode, LsStat.nlink)
        ReturnValue(0)
    }
}
Function.SetIno {
    Input: index: Integer
    Input: ino: Integer
    Body: {
        off = Multiply(index, 8)
        p = Add(LsStat.ino_tab, off)
        StoreValue(p, ino)
        ReturnValue(0)
    }
}
Function.GetIno {
    Input: index: Integer
    Output: Integer
    Body: {
        off = Multiply(index, 8)
        p = Add(LsStat.ino_tab, off)
        ReturnValue(Dereference(p))
    }
}
Function.ShowFollowIno {
    Input: fd: Integer
    Input: name: Address
    Body: {
        sb = Allocate(144)
        res = SystemCall(262, fd, name, sb, 0)
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(sb, 144)
            LsConfig.minor = 1
            WriteBuffered("? ")
            ReturnValue(0)
        }
        ino = GetUInt64(sb, 8)
        Deallocate(sb, 144)
        s = NumberToString(ino)
        WriteBuffered(s)
        WriteBuffered(" ")
        ReturnValue(0)
    }
}
Function.ShowBlocks {
    Input: fd: Integer
    Input: name: Address
    Body: {
        flag = 256
        IfCondition EqualTo(LsConfig.deref, 3) ThenBlock: {
            flag = 0
        }
        sb = Allocate(144)
        res = SystemCall(262, fd, name, sb, flag)
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(sb, 144)
            LsConfig.minor = 1
            WriteBuffered("? ")
            ReturnValue(0)
        }
        b = GetUInt64(sb, 64)
        Deallocate(sb, 144)
        kb = Divide(b, 2)
        s = NumberToString(kb)
        WriteBuffered(s)
        WriteBuffered(" ")
        ReturnValue(0)
    }
}
Function.BlockOf {
    Input: fd: Integer
    Input: name: Address
    Output: Integer
    Body: {
        flag = 256
        IfCondition EqualTo(LsConfig.deref, 3) ThenBlock: {
            flag = 0
        }
        sb = Allocate(144)
        res = SystemCall(262, fd, name, sb, flag)
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(sb, 144)
            LsConfig.minor = 1
            ReturnValue(0)
        }
        b = GetUInt64(sb, 64)
        Deallocate(sb, 144)
        ReturnValue(b)
    }
}
Function.AddBlocks {
    Input: fd: Integer
    Input: name: Address
    Body: {
        b = BlockOf(fd, name)
        cur = LsConfig.total_blocks
        LsConfig.total_blocks = Add(cur, b)
        ReturnValue(0)
    }
}
Function.SumBlocks {
    Input: fd: Integer
    Input: entries: Address
    Input: count: Integer
    Body: {
        LsConfig.total_blocks = 0
        i = 0
        one = 1
        WhileLoop LessThan(i, count) {
            name = GetEntryName(entries, i)
            AddBlocks(fd, name)
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}
Function.EmitShort {
    Input: fd: Integer
    Input: entries: Address
    Input: index: Integer
    Body: {
        name = GetEntryName(entries, index)
        IfCondition EqualTo(LsConfig.print_inode, 1) ThenBlock: {
            IfCondition EqualTo(LsConfig.deref, 3) ThenBlock: {
                ShowFollowIno(fd, name)
            } ElseBlock: {
                ino = GetIno(index)
                s = NumberToString(ino)
                WriteBuffered(s)
                WriteBuffered(" ")
            }
        }
        IfCondition EqualTo(LsConfig.print_blocks, 1) ThenBlock: {
            ShowBlocks(fd, name)
        }
        plain = 0
        IfCondition EqualTo(LsPaint.active, 0) ThenBlock: {
            IfCondition EqualTo(LsConfig.indicator, 0) ThenBlock: {
                IfCondition EqualTo(LsConfig.quote_style, 0) ThenBlock: {
                    IfCondition EqualTo(LsConfig.hide_ctrl, 0) ThenBlock: {
                        IfCondition EqualTo(LsConfig.hyper, 0) ThenBlock: {
                            plain = 1
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(plain, 1) ThenBlock: {
            WriteBuffered(name)
            ReturnValue(0)
        }
        dtype = GetEntryType(entries, index)
        PaintAt(fd, name, dtype)
        ReturnValue(0)
    }
}
Function.SwapIno {
    Input: i: Integer
    Input: j: Integer
    Body: {
        IfCondition EqualTo(LsStat.ino_tab, 0) ThenBlock: {
            ReturnValue(0)
        }
        off1 = Multiply(i, 8)
        off2 = Multiply(j, 8)
        p1 = Add(LsStat.ino_tab, off1)
        p2 = Add(LsStat.ino_tab, off2)
        a = Dereference(p1)
        b = Dereference(p2)
        StoreValue(p1, b)
        StoreValue(p2, a)
        ReturnValue(0)
    }
}
Function.LinkDir {
    Input: fd: Integer
    Input: name: Address
    Output: Integer
    Body: {
        sb = Allocate(144)
        res = SystemCall(262, fd, name, sb, 0)
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(sb, 144)
            ReturnValue(-1)
        }
        mode = GetUInt32(sb, 24)
        Deallocate(sb, 144)
        typ = BitwiseAnd(mode, 61440)
        IfCondition EqualTo(typ, 16384) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.ReportMiss {
    Input: dir: Address
    Input: name: Address
    Body: {
        full = BuildPath(dir, name)
        WriteStderr("ls: cannot access '")
        WriteStderr(full)
        WriteStderr("': No such file or directory\n")
        Deallocate(full, 0)
        LsConfig.minor = 1
        ReturnValue(0)
    }
}
Function.MustFollow {
    Output: Integer
    Body: {
        IfCondition EqualTo(LsPaint.active, 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition NotEqual(LsConfig.indicator, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(LsConfig.recursive, 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(LsConfig.print_inode, 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(LsConfig.print_blocks, 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.NoteMiss {
    Input: kind: Integer
    Input: path: Address
    Input: name: Address
    Body: {
        IfCondition NotEqual(kind, -1) ThenBlock: {
            ReturnValue(0)
        }
        hit = MustFollow()
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReportMiss(path, name)
        }
        ReturnValue(0)
    }
}
Function.MarkGroup {
    Input: entries: Address
    Input: index: Integer
    Input: fd: Integer
    Input: name: Address
    Input: d_type: Integer
    Body: {
        base = Multiply(index, LsConstants.ENTRY_SIZE)
        off = Add(base, 25)
        SetByte(entries, off, 0)
        IfCondition EqualTo(LsConfig.group_dirs, 0) ThenBlock: {
            ReturnValue(0)
        }
        mark = 0
        IfCondition EqualTo(d_type, 4) ThenBlock: {
            mark = 1
        }
        IfCondition EqualTo(d_type, 10) ThenBlock: {
            kind = LinkDir(fd, name)
            IfCondition EqualTo(kind, 1) ThenBlock: {
                mark = 1
            }
        }
        SetByte(entries, off, mark)
        ReturnValue(0)
    }
}
Function.GroupDecide {
    Input: path1: Address
    Input: path2: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LsConfig.group_dirs, 0) ThenBlock: {
            ReturnValue(-1)
        }
        d1 = IsDirectory(path1)
        d2 = IsDirectory(path2)
        IfCondition EqualTo(d1, d2) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition EqualTo(d1, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.IsPrefix {
    Input: arg: Address
    Input: n: Integer
    Input: full: Address
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            a = GetByte(arg, i)
            b = GetByte(full, i)
            IfCondition NotEqual(a, b) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        ReturnValue(1)
    }
}
Function.ApplyGroup {
    Input: arg: Address
    Input: arg_len: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(arg_len, 7) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterThan(arg_len, 25) ThenBlock: {
            ReturnValue(0)
        }
        hit = IsPrefix(arg, arg_len, "--group-directories-first")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            LsConfig.group_dirs = 1
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.EnsureSeen {
    Body: {
        IfCondition NotEqual(LsConfig.seen_dev, 0) ThenBlock: {
            ReturnValue(0)
        }
        LsConfig.seen_dev = Allocate(512)
        LsConfig.seen_ino = Allocate(512)
        LsConfig.seen_n = 0
        ReturnValue(0)
    }
}
Function.SeenPair {
    Input: dev: Integer
    Input: ino: Integer
    Output: Integer
    Body: {
        EnsureSeen()
        n = LsConfig.seen_n
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            off = Multiply(i, 8)
            d = Dereference(Add(LsConfig.seen_dev, off))
            IfCondition EqualTo(d, dev) ThenBlock: {
                v = Dereference(Add(LsConfig.seen_ino, off))
                IfCondition EqualTo(v, ino) ThenBlock: {
                    ReturnValue(1)
                }
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}
Function.PushSeen {
    Input: dev: Integer
    Input: ino: Integer
    Body: {
        EnsureSeen()
        n = LsConfig.seen_n
        IfCondition GreaterEqual(n, 64) ThenBlock: {
            ReturnValue(0)
        }
        off = Multiply(n, 8)
        StoreValue(Add(LsConfig.seen_dev, off), dev)
        StoreValue(Add(LsConfig.seen_ino, off), ino)
        LsConfig.seen_n = Add(n, 1)
        ReturnValue(0)
    }
}
Function.PopSeen {
    Body: {
        n = LsConfig.seen_n
        IfCondition GreaterThan(n, 0) ThenBlock: {
            LsConfig.seen_n = Subtract(n, 1)
        }
        ReturnValue(0)
    }
}
Function.NoteFd {
    Input: fd: Integer
    Output: Integer
    Body: {
        sb = Allocate(144)
        res = SystemCall(5, fd, sb)
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(sb, 144)
            ReturnValue(2)
        }
        dev = GetUInt64(sb, 0)
        ino = GetUInt64(sb, 8)
        Deallocate(sb, 144)
        hit = SeenPair(dev, ino)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReturnValue(1)
        }
        PushSeen(dev, ino)
        ReturnValue(0)
    }
}
Function.LeaveDir {
    Input: pushed: Integer
    Input: code: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(pushed, 1) ThenBlock: {
            PopSeen()
        }
        ReturnValue(code)
    }
}
