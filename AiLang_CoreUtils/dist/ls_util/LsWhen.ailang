// Dates, stat, and name emit. Pools stay on ls.ailang. No Main.
LibraryImport.Arena

Function.Pad2 {
    Input: n: Integer
    Body: {
        IfCondition LessThan(n, 10) ThenBlock: {
            WriteBuffered("0")
        }
        s = NumberToString(n)
        WriteBuffered(s)
    }
}
Function.PrintCivil {
    Input: mtime: Integer
    Body: {
        days = Divide(mtime, 86400)
        z = Add(days, 719468)
        era = Divide(z, 146097)
        doe = Modulo(z, 146097)
        part = doe
        part = Subtract(part, Divide(doe, 1460))
        part = Add(part, Divide(doe, 36524))
        part = Subtract(part, Divide(doe, 146096))
        yoe = Divide(part, 365)
        year = Add(yoe, Multiply(era, 400))
        doy = Multiply(365, yoe)
        doy = Add(doy, Divide(yoe, 4))
        doy = Subtract(doy, Divide(yoe, 100))
        doy = Subtract(doe, doy)
        mp = Multiply(5, doy)
        mp = Add(mp, 2)
        mp = Divide(mp, 153)
        day = Multiply(153, mp)
        day = Add(day, 2)
        day = Divide(day, 5)
        day = Subtract(doy, day)
        day = Add(day, 1)
        month = Add(mp, 3)
        IfCondition GreaterEqual(mp, 10) ThenBlock: {
            month = Subtract(mp, 9)
        }
        IfCondition LessEqual(month, 2) ThenBlock: {
            year = Add(year, 1)
        }
        tod = Modulo(mtime, 86400)
        hour = Divide(tod, 3600)
        rem = Modulo(tod, 3600)
        minute = Divide(rem, 60)
        IfCondition EqualTo(LsConfig.long_iso, 1) ThenBlock: {
            ys = NumberToString(year)
            WriteBuffered(ys)
            WriteBuffered("-")
            Pad2(month)
            WriteBuffered("-")
            Pad2(day)
            WriteBuffered(" ")
            Pad2(hour)
            WriteBuffered(":")
            Pad2(minute)
            ReturnValue(0)
        }
        mon = Subtract(month, 1)
        mname = GetMonthName(mon)
        WriteBuffered(mname)
        WriteBuffered(" ")
        IfCondition LessThan(day, 10) ThenBlock: {
            WriteBuffered(" ")
        }
        ds = NumberToString(day)
        WriteBuffered(ds)
        tb = Allocate(16)
        SystemCall(228, 0, tb)
        now = GetUInt64(tb, 0)
        Deallocate(tb, 16)
        ago = Subtract(now, 15778476)
        recent = 0
        IfCondition GreaterThan(mtime, ago) ThenBlock: {
            IfCondition LessThan(mtime, now) ThenBlock: {
                recent = 1
            }
        }
        IfCondition EqualTo(recent, 1) ThenBlock: {
            WriteBuffered(" ")
            Pad2(hour)
            WriteBuffered(":")
            Pad2(minute)
        } ElseBlock: {
            WriteBuffered("  ")
            ys = NumberToString(year)
            WriteBuffered(ys)
        }
        ReturnValue(0)
    }
}
Function.ScaleSize {
    Input: size: Integer
    Output: Address
    Body: {
        b = LsConfig.file_block
        IfCondition LessEqual(b, 1) ThenBlock: {
            ReturnValue(NumberToString(size))
        }
        q = Divide(size, b)
        ReturnValue(NumberToString(q))
    }
}
Function.StatCmd {
    Input: path: Address
    Body: {
        LsStat.err = 0
        LsStat.is_dir = 0
        LsStat.ok = 0
        sb = Allocate(144)
        res = SystemCall(262, -100, path, sb, 256)
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(sb, 144)
            LsStat.err = 2
            ReturnValue(0)
        }
        mode = GetUInt32(sb, 24)
        nlink = GetUInt64(sb, 16)
        ino = GetUInt64(sb, 8)
        blocks = GetUInt64(sb, 64)
        Deallocate(sb, 144)
        LsStat.mode = mode
        LsStat.nlink = nlink
        LsStat.ino = ino
        LsStat.blocks = blocks
        LsStat.ok = 1
        typ = BitwiseAnd(mode, 61440)
        IfCondition EqualTo(typ, 16384) ThenBlock: {
            LsStat.is_dir = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(typ, 40960) ThenBlock: {
            ReturnValue(0)
        }
        follow = 0
        IfCondition EqualTo(LsConfig.deref, 3) ThenBlock: {
            follow = 1
        }
        IfCondition EqualTo(LsConfig.deref, 2) ThenBlock: {
            follow = 1
        }
        IfCondition EqualTo(LsConfig.indicator, 0) ThenBlock: {
            IfCondition EqualTo(LsConfig.long_format, 0) ThenBlock: {
                IfCondition EqualTo(LsConfig.dir_as_file, 0) ThenBlock: {
                    IfCondition EqualTo(LsConfig.deref, 0) ThenBlock: {
                        follow = 1
                    }
                }
            }
        }
        IfCondition EqualTo(follow, 0) ThenBlock: {
            ReturnValue(0)
        }
        sb2 = Allocate(144)
        res2 = SystemCall(262, -100, path, sb2, 0)
        IfCondition LessThan(res2, 0) ThenBlock: {
            Deallocate(sb2, 144)
            IfCondition EqualTo(LsConfig.deref, 2) ThenBlock: {
                LsStat.err = 2
            }
            IfCondition EqualTo(LsConfig.deref, 3) ThenBlock: {
                LsStat.err = 2
            }
            ReturnValue(0)
        }
        mode2 = GetUInt32(sb2, 24)
        nlink2 = GetUInt64(sb2, 16)
        ino2 = GetUInt64(sb2, 8)
        blocks2 = GetUInt64(sb2, 64)
        Deallocate(sb2, 144)
        typ2 = BitwiseAnd(mode2, 61440)
        IfCondition EqualTo(typ2, 16384) ThenBlock: {
            LsStat.is_dir = 1
            LsStat.mode = mode2
            LsStat.nlink = nlink2
            LsStat.ino = ino2
            LsStat.blocks = blocks2
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.deref, 2) ThenBlock: {
            LsStat.mode = mode2
            LsStat.nlink = nlink2
            LsStat.ino = ino2
            LsStat.blocks = blocks2
        }
        IfCondition EqualTo(LsConfig.deref, 3) ThenBlock: {
            LsStat.mode = mode2
            LsStat.nlink = nlink2
            LsStat.ino = ino2
            LsStat.blocks = blocks2
        }
        ReturnValue(0)
    }
}
Function.EmitKnown {
    Input: name: Address
    Body: {
        LsConfig.cur_fd = -100
        IfCondition EqualTo(LsConfig.print_inode, 1) ThenBlock: {
            s = NumberToString(LsStat.ino)
            WriteBuffered(s)
            WriteBuffered(" ")
        }
        ProbeLink(-100, name, LsStat.mode)
        OpenNorm()
        PaintName(name, LsStat.mode, LsStat.nlink)
        ReturnValue(0)
    }
}
Function.SetIno {
    Input: index: Integer
    Input: ino: Integer
    Body: {
        off = Multiply(index, 8)
        p = Add(LsStat.ino_tab, off)
        WRMEM_64(p, ino)
        ReturnValue(0)
    }
}
Function.GetIno {
    Input: index: Integer
    Output: Integer
    Body: {
        off = Multiply(index, 8)
        p = Add(LsStat.ino_tab, off)
        ReturnValue(RDMEM_64(p))
    }
}
Function.ShowFollowIno {
    Input: fd: Integer
    Input: name: Address
    Body: {
        sb = Allocate(144)
        res = SystemCall(262, fd, name, sb, 0)
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(sb, 144)
            LsConfig.minor = 1
            WriteBuffered("? ")
            ReturnValue(0)
        }
        ino = GetUInt64(sb, 8)
        Deallocate(sb, 144)
        s = NumberToString(ino)
        WriteBuffered(s)
        WriteBuffered(" ")
        ReturnValue(0)
    }
}
Function.ShowBlocks {
    Input: fd: Integer
    Input: name: Address
    Body: {
        flag = 256
        IfCondition EqualTo(LsConfig.deref, 3) ThenBlock: {
            flag = 0
        }
        sb = Allocate(144)
        res = SystemCall(262, fd, name, sb, flag)
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(sb, 144)
            LsConfig.minor = 1
            WriteBuffered("? ")
            ReturnValue(0)
        }
        b = GetUInt64(sb, 64)
        Deallocate(sb, 144)
        kb = Divide(b, 2)
        s = NumberToString(kb)
        WriteBuffered(s)
        WriteBuffered(" ")
        ReturnValue(0)
    }
}
Function.BlockOf {
    Input: fd: Integer
    Input: name: Address
    Output: Integer
    Body: {
        flag = 256
        IfCondition EqualTo(LsConfig.deref, 3) ThenBlock: {
            flag = 0
        }
        sb = Allocate(144)
        res = SystemCall(262, fd, name, sb, flag)
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(sb, 144)
            LsConfig.minor = 1
            ReturnValue(0)
        }
        b = GetUInt64(sb, 64)
        Deallocate(sb, 144)
        ReturnValue(b)
    }
}
Function.AddBlocks {
    Input: fd: Integer
    Input: name: Address
    Body: {
        b = BlockOf(fd, name)
        cur = LsConfig.total_blocks
        LsConfig.total_blocks = Add(cur, b)
        ReturnValue(0)
    }
}
Function.SumBlocks {
    Input: fd: Integer
    Input: entries: Address
    Input: count: Integer
    Body: {
        LsConfig.total_blocks = 0
        i = 0
        one = 1
        WhileLoop LessThan(i, count) {
            name = GetEntryName(entries, i)
            AddBlocks(fd, name)
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}
Function.EmitShort {
    Input: fd: Integer
    Input: entries: Address
    Input: index: Integer
    Body: {
        name = GetEntryName(entries, index)
        IfCondition EqualTo(LsConfig.print_inode, 1) ThenBlock: {
            IfCondition EqualTo(LsConfig.deref, 3) ThenBlock: {
                ShowFollowIno(fd, name)
            } ElseBlock: {
                ino = GetIno(index)
                s = NumberToString(ino)
                WriteBuffered(s)
                WriteBuffered(" ")
            }
        }
        IfCondition EqualTo(LsConfig.print_blocks, 1) ThenBlock: {
            ShowBlocks(fd, name)
        }
        plain = 0
        IfCondition EqualTo(LsPaint.active, 0) ThenBlock: {
            IfCondition EqualTo(LsConfig.indicator, 0) ThenBlock: {
                IfCondition EqualTo(LsConfig.quote_style, 0) ThenBlock: {
                    IfCondition EqualTo(LsConfig.hide_ctrl, 0) ThenBlock: {
                        IfCondition EqualTo(LsConfig.hyper, 0) ThenBlock: {
                            plain = 1
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(plain, 1) ThenBlock: {
            WriteBuffered(name)
            ReturnValue(0)
        }
        dtype = GetEntryType(entries, index)
        PaintAt(fd, name, dtype)
        ReturnValue(0)
    }
}
Function.SwapIno {
    Input: i: Integer
    Input: j: Integer
    Body: {
        IfCondition EqualTo(LsStat.ino_tab, 0) ThenBlock: {
            ReturnValue(0)
        }
        off1 = Multiply(i, 8)
        off2 = Multiply(j, 8)
        p1 = Add(LsStat.ino_tab, off1)
        p2 = Add(LsStat.ino_tab, off2)
        a = RDMEM_64(p1)
        b = RDMEM_64(p2)
        WRMEM_64(p1, b)
        WRMEM_64(p2, a)
        ReturnValue(0)
    }
}
Function.LinkDir {
    Input: fd: Integer
    Input: name: Address
    Output: Integer
    Body: {
        sb = Allocate(144)
        res = SystemCall(262, fd, name, sb, 0)
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(sb, 144)
            ReturnValue(-1)
        }
        mode = GetUInt32(sb, 24)
        Deallocate(sb, 144)
        typ = BitwiseAnd(mode, 61440)
        IfCondition EqualTo(typ, 16384) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.ReportMiss {
    Input: dir: Address
    Input: name: Address
    Body: {
        full = BuildPath(dir, name)
        WriteStderr("ls: cannot access '")
        WriteStderr(full)
        WriteStderr("': No such file or directory\n")
        Deallocate(full, 0)
        LsConfig.minor = 1
        ReturnValue(0)
    }
}
Function.MustFollow {
    Output: Integer
    Body: {
        IfCondition EqualTo(LsPaint.active, 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition NotEqual(LsConfig.indicator, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(LsConfig.recursive, 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(LsConfig.print_inode, 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(LsConfig.print_blocks, 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.NoteMiss {
    Input: kind: Integer
    Input: path: Address
    Input: name: Address
    Body: {
        IfCondition NotEqual(kind, -1) ThenBlock: {
            ReturnValue(0)
        }
        hit = MustFollow()
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReportMiss(path, name)
        }
        ReturnValue(0)
    }
}
Function.MarkGroup {
    Input: entries: Address
    Input: index: Integer
    Input: fd: Integer
    Input: name: Address
    Input: d_type: Integer
    Body: {
        base = Multiply(index, LsConstants.ENTRY_SIZE)
        off = Add(base, 25)
        WRMEM_8(entries, off, 0)
        IfCondition EqualTo(LsConfig.group_dirs, 0) ThenBlock: {
            ReturnValue(0)
        }
        mark = 0
        IfCondition EqualTo(d_type, 4) ThenBlock: {
            mark = 1
        }
        IfCondition EqualTo(d_type, 10) ThenBlock: {
            kind = LinkDir(fd, name)
            IfCondition EqualTo(kind, 1) ThenBlock: {
                mark = 1
            }
        }
        WRMEM_8(entries, off, mark)
        ReturnValue(0)
    }
}
Function.GroupDecide {
    Input: path1: Address
    Input: path2: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LsConfig.group_dirs, 0) ThenBlock: {
            ReturnValue(-1)
        }
        d1 = IsDirectory(path1)
        d2 = IsDirectory(path2)
        IfCondition EqualTo(d1, d2) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition EqualTo(d1, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.IsPrefix {
    Input: arg: Address
    Input: n: Integer
    Input: full: Address
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            a = RDMEM_8(arg, i)
            b = RDMEM_8(full, i)
            IfCondition NotEqual(a, b) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        ReturnValue(1)
    }
}
Function.ApplyGroup {
    Input: arg: Address
    Input: arg_len: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(arg_len, 7) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterThan(arg_len, 25) ThenBlock: {
            ReturnValue(0)
        }
        hit = IsPrefix(arg, arg_len, "--group-directories-first")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            LsConfig.group_dirs = 1
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.EnsureSeen {
    Body: {
        IfCondition NotEqual(LsConfig.seen_dev, 0) ThenBlock: {
            ReturnValue(0)
        }
        LsConfig.seen_dev = Allocate(512)
        LsConfig.seen_ino = Allocate(512)
        LsConfig.seen_n = 0
        ReturnValue(0)
    }
}
Function.SeenPair {
    Input: dev: Integer
    Input: ino: Integer
    Output: Integer
    Body: {
        EnsureSeen()
        n = LsConfig.seen_n
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            off = Multiply(i, 8)
            d = RDMEM_64(LsConfig.seen_dev, off)
            IfCondition EqualTo(d, dev) ThenBlock: {
                v = RDMEM_64(LsConfig.seen_ino, off)
                IfCondition EqualTo(v, ino) ThenBlock: {
                    ReturnValue(1)
                }
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}
Function.PushSeen {
    Input: dev: Integer
    Input: ino: Integer
    Body: {
        EnsureSeen()
        n = LsConfig.seen_n
        IfCondition GreaterEqual(n, 64) ThenBlock: {
            ReturnValue(0)
        }
        off = Multiply(n, 8)
        WRMEM_64(LsConfig.seen_dev, off, dev)
        WRMEM_64(LsConfig.seen_ino, off, ino)
        LsConfig.seen_n = Add(n, 1)
        ReturnValue(0)
    }
}
Function.PopSeen {
    Body: {
        n = LsConfig.seen_n
        IfCondition GreaterThan(n, 0) ThenBlock: {
            LsConfig.seen_n = Subtract(n, 1)
        }
        ReturnValue(0)
    }
}
Function.NoteFd {
    Input: fd: Integer
    Output: Integer
    Body: {
        sb = Allocate(144)
        res = SystemCall(5, fd, sb)
        IfCondition LessThan(res, 0) ThenBlock: {
            Deallocate(sb, 144)
            ReturnValue(2)
        }
        dev = GetUInt64(sb, 0)
        ino = GetUInt64(sb, 8)
        Deallocate(sb, 144)
        hit = SeenPair(dev, ino)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReturnValue(1)
        }
        PushSeen(dev, ino)
        ReturnValue(0)
    }
}
Function.LeaveDir {
    Input: pushed: Integer
    Input: code: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(pushed, 1) ThenBlock: {
            PopSeen()
        }
        ReturnValue(code)
    }
}
Function.YearOf {
    Input: mtime: Integer
    Output: Integer
    Body: {
        days = Divide(mtime, 86400)
        z = Add(days, 719468)
        era = Divide(z, 146097)
        doe = Modulo(z, 146097)
        part = doe
        part = Subtract(part, Divide(doe, 1460))
        part = Add(part, Divide(doe, 36524))
        part = Subtract(part, Divide(doe, 146096))
        yoe = Divide(part, 365)
        year = Add(yoe, Multiply(era, 400))
        doy = Multiply(365, yoe)
        doy = Add(doy, Divide(yoe, 4))
        doy = Subtract(doy, Divide(yoe, 100))
        doy = Subtract(doe, doy)
        mp = Multiply(5, doy)
        mp = Add(mp, 2)
        mp = Divide(mp, 153)
        month = Add(mp, 3)
        IfCondition GreaterEqual(mp, 10) ThenBlock: {
            month = Subtract(mp, 9)
        }
        IfCondition LessEqual(month, 2) ThenBlock: {
            year = Add(year, 1)
        }
        ReturnValue(year)
    }
}
Function.CivilDays {
    Input: year: Integer
    Input: month: Integer
    Input: day: Integer
    Output: Integer
    Body: {
        y = year
        IfCondition LessEqual(month, 2) ThenBlock: {
            y = Subtract(year, 1)
        }
        era = Divide(y, 400)
        yoe = Subtract(y, Multiply(era, 400))
        mp = Add(month, 9)
        IfCondition GreaterThan(month, 2) ThenBlock: {
            mp = Subtract(month, 3)
        }
        doy = Multiply(153, mp)
        doy = Add(doy, 2)
        doy = Divide(doy, 5)
        doy = Add(doy, day)
        doy = Subtract(doy, 1)
        doe = Multiply(yoe, 365)
        doe = Add(doe, Divide(yoe, 4))
        doe = Subtract(doe, Divide(yoe, 100))
        doe = Add(doe, doy)
        days = Multiply(era, 146097)
        days = Add(days, doe)
        days = Subtract(days, 719468)
        ReturnValue(days)
    }
}
Function.DaysIn {
    Input: year: Integer
    Input: month: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(month, 2) ThenBlock: {
            leap = 0
            IfCondition EqualTo(Modulo(year, 4), 0) ThenBlock: {
                leap = 1
                IfCondition EqualTo(Modulo(year, 100), 0) ThenBlock: {
                    leap = 0
                    IfCondition EqualTo(Modulo(year, 400), 0) ThenBlock: {
                        leap = 1
                    }
                }
            }
            IfCondition EqualTo(leap, 1) ThenBlock: {
                ReturnValue(29)
            }
            ReturnValue(28)
        }
        IfCondition EqualTo(month, 4) ThenBlock: {
            ReturnValue(30)
        }
        IfCondition EqualTo(month, 6) ThenBlock: {
            ReturnValue(30)
        }
        IfCondition EqualTo(month, 9) ThenBlock: {
            ReturnValue(30)
        }
        IfCondition EqualTo(month, 11) ThenBlock: {
            ReturnValue(30)
        }
        ReturnValue(31)
    }
}
Function.NthDom {
    Input: year: Integer
    Input: month: Integer
    Input: week: Integer
    Input: dow: Integer
    Output: Integer
    Body: {
        one = 1
        base = CivilDays(year, month, one)
        dow0 = Add(base, 4)
        dow0 = Modulo(dow0, 7)
        delta = Subtract(dow, dow0)
        IfCondition LessThan(delta, 0) ThenBlock: {
            delta = Add(delta, 7)
        }
        dom = Add(one, delta)
        w = 1
        WhileLoop LessThan(w, week) {
            dom = Add(dom, 7)
            w = Add(w, one)
        }
        dim = DaysIn(year, month)
        IfCondition GreaterThan(dom, dim) ThenBlock: {
            dom = Subtract(dom, 7)
        }
        ReturnValue(dom)
    }
}
Function.IsAlpha {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(c, 65) ThenBlock: {
            IfCondition LessEqual(c, 90) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition GreaterEqual(c, 97) ThenBlock: {
            IfCondition LessEqual(c, 122) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}
Function.IsDigit {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(c, 48) ThenBlock: {
            IfCondition LessEqual(c, 57) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}
Function.NumVal {
    Input: s: Address
    Input: at: Integer
    Output: Integer
    Body: {
        v = 0
        one = 1
        guard = 0
        WhileLoop LessThan(guard, 8) {
            ch = RDMEM_8(s, at)
            d = IsDigit(ch)
            IfCondition EqualTo(d, 0) ThenBlock: {
                BreakLoop
            }
            v = Multiply(v, 10)
            v = Add(v, Subtract(ch, 48))
            at = Add(at, one)
            guard = Add(guard, one)
        }
        ReturnValue(v)
    }
}
Function.NumEnd {
    Input: s: Address
    Input: at: Integer
    Output: Integer
    Body: {
        one = 1
        guard = 0
        WhileLoop LessThan(guard, 8) {
            ch = RDMEM_8(s, at)
            d = IsDigit(ch)
            IfCondition EqualTo(d, 0) ThenBlock: {
                BreakLoop
            }
            at = Add(at, one)
            guard = Add(guard, one)
        }
        ReturnValue(at)
    }
}
Function.WestVal {
    Input: s: Address
    Input: at: Integer
    Output: Integer
    Body: {
        neg = 0
        one = 1
        ch = RDMEM_8(s, at)
        IfCondition EqualTo(ch, 45) ThenBlock: {
            neg = 1
            at = Add(at, one)
        }
        IfCondition EqualTo(ch, 43) ThenBlock: {
            at = Add(at, one)
        }
        hh = NumVal(s, at)
        at = NumEnd(s, at)
        mm = 0
        ss = 0
        ch = RDMEM_8(s, at)
        IfCondition EqualTo(ch, 58) ThenBlock: {
            at = Add(at, one)
            mm = NumVal(s, at)
            at = NumEnd(s, at)
            ch = RDMEM_8(s, at)
            IfCondition EqualTo(ch, 58) ThenBlock: {
                at = Add(at, one)
                ss = NumVal(s, at)
            }
        }
        west = Multiply(hh, 3600)
        west = Add(west, Multiply(mm, 60))
        west = Add(west, ss)
        IfCondition EqualTo(neg, 1) ThenBlock: {
            west = Subtract(0, west)
        }
        ReturnValue(west)
    }
}
Function.WestEnd {
    Input: s: Address
    Input: at: Integer
    Output: Integer
    Body: {
        one = 1
        ch = RDMEM_8(s, at)
        IfCondition EqualTo(ch, 45) ThenBlock: {
            at = Add(at, one)
        }
        IfCondition EqualTo(ch, 43) ThenBlock: {
            at = Add(at, one)
        }
        at = NumEnd(s, at)
        ch = RDMEM_8(s, at)
        IfCondition EqualTo(ch, 58) ThenBlock: {
            at = Add(at, one)
            at = NumEnd(s, at)
            ch = RDMEM_8(s, at)
            IfCondition EqualTo(ch, 58) ThenBlock: {
                at = Add(at, one)
                at = NumEnd(s, at)
            }
        }
        ReturnValue(at)
    }
}
Function.CopyZoneName {
    Input: s: Address
    Input: at: Integer
    Input: dest: Integer
    Output: Integer
    Body: {
        one = 1
        n = 0
        ch = RDMEM_8(s, at)
        IfCondition EqualTo(ch, 60) ThenBlock: {
            at = Add(at, one)
            WhileLoop LessThan(n, 14) {
                ch = RDMEM_8(s, at)
                IfCondition EqualTo(ch, 0) ThenBlock: {
                    BreakLoop
                }
                IfCondition EqualTo(ch, 62) ThenBlock: {
                    at = Add(at, one)
                    BreakLoop
                }
                WRMEM_8(LsConfig.tz_name, Add(dest, n), ch)
                n = Add(n, one)
                at = Add(at, one)
            }
        } ElseBlock: {
            WhileLoop LessThan(n, 14) {
                ch = RDMEM_8(s, at)
                a = IsAlpha(ch)
                IfCondition EqualTo(a, 0) ThenBlock: {
                    BreakLoop
                }
                WRMEM_8(LsConfig.tz_name, Add(dest, n), ch)
                n = Add(n, one)
                at = Add(at, one)
            }
        }
        WRMEM_8(LsConfig.tz_name, Add(dest, n), 0)
        ReturnValue(at)
    }
}
Function.CommaAt {
    Input: s: Address
    Input: at: Integer
    Output: Integer
    Body: {
        one = 1
        i = at
        guard = 0
        WhileLoop LessThan(guard, 48) {
            ch = RDMEM_8(s, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                ReturnValue(-1)
            }
            IfCondition EqualTo(ch, 44) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, one)
            guard = Add(guard, one)
        }
        ReturnValue(-1)
    }
}
Function.RuleUtc {
    Input: s: Address
    Input: at: Integer
    Input: year: Integer
    Input: west: Integer
    Output: Integer
    Body: {
        one = 1
        at = Add(at, one)
        month = NumVal(s, at)
        at = NumEnd(s, at)
        at = Add(at, one)
        week = NumVal(s, at)
        at = NumEnd(s, at)
        at = Add(at, one)
        dow = NumVal(s, at)
        at = NumEnd(s, at)
        hh = 2
        mm = 0
        ss = 0
        ch = RDMEM_8(s, at)
        IfCondition EqualTo(ch, 47) ThenBlock: {
            at = Add(at, one)
            hh = NumVal(s, at)
            at = NumEnd(s, at)
            ch = RDMEM_8(s, at)
            IfCondition EqualTo(ch, 58) ThenBlock: {
                at = Add(at, one)
                mm = NumVal(s, at)
                at = NumEnd(s, at)
                ch = RDMEM_8(s, at)
                IfCondition EqualTo(ch, 58) ThenBlock: {
                    at = Add(at, one)
                    ss = NumVal(s, at)
                }
            }
        }
        dom = NthDom(year, month, week, dow)
        days = CivilDays(year, month, dom)
        secs = Multiply(days, 86400)
        secs = Add(secs, Multiply(hh, 3600))
        secs = Add(secs, Multiply(mm, 60))
        secs = Add(secs, ss)
        secs = Add(secs, west)
        ReturnValue(secs)
    }
}
Function.InDst {
    Input: mtime: Integer
    Input: s: Address
    Input: rules: Integer
    Input: std_west: Integer
    Input: dst_west: Integer
    Output: Integer
    Body: {
        one = 1
        year = YearOf(mtime)
        c1 = CommaAt(s, rules)
        IfCondition LessThan(c1, 0) ThenBlock: {
            ReturnValue(0)
        }
        start_at = Add(c1, one)
        c2 = CommaAt(s, start_at)
        IfCondition LessThan(c2, 0) ThenBlock: {
            ReturnValue(0)
        }
        end_at = Add(c2, one)
        sm = NumVal(s, Add(start_at, one))
        em = NumVal(s, Add(end_at, one))
        su = RuleUtc(s, start_at, year, std_west)
        eu = RuleUtc(s, end_at, year, dst_west)
        IfCondition LessEqual(sm, em) ThenBlock: {
            IfCondition GreaterEqual(mtime, su) ThenBlock: {
                IfCondition LessThan(mtime, eu) ThenBlock: {
                    ReturnValue(1)
                }
            }
            ReturnValue(0)
        }
        IfCondition GreaterEqual(mtime, su) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition LessThan(mtime, eu) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.ParseTz {
    Input: s: Address
    Input: mtime: Integer
    Body: {
        one = 1
        p = CopyZoneName(s, 0, 0)
        ch = RDMEM_8(s, p)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(0)
        }
        std_west = WestVal(s, p)
        p = WestEnd(s, p)
        dst = 0
        ch = RDMEM_8(s, p)
        IfCondition EqualTo(ch, 60) ThenBlock: {
            dst = 1
        }
        a = IsAlpha(ch)
        IfCondition EqualTo(a, 1) ThenBlock: {
            dst = 1
        }
        IfCondition EqualTo(dst, 0) ThenBlock: {
            LsConfig.tz_off = Subtract(0, std_west)
            ReturnValue(0)
        }
        p = CopyZoneName(s, p, 16)
        dst_west = Subtract(std_west, 3600)
        ch = RDMEM_8(s, p)
        has = 0
        IfCondition EqualTo(ch, 43) ThenBlock: {
            has = 1
        }
        IfCondition EqualTo(ch, 45) ThenBlock: {
            has = 1
        }
        dgt = IsDigit(ch)
        IfCondition EqualTo(dgt, 1) ThenBlock: {
            has = 1
        }
        IfCondition EqualTo(has, 1) ThenBlock: {
            dst_west = WestVal(s, p)
            p = WestEnd(s, p)
        }
        use_dst = InDst(mtime, s, p, std_west, dst_west)
        IfCondition EqualTo(use_dst, 1) ThenBlock: {
            k = 0
            WhileLoop LessThan(k, 15) {
                b = RDMEM_8(LsConfig.tz_name, Add(16, k))
                WRMEM_8(LsConfig.tz_name, k, b)
                IfCondition EqualTo(b, 0) ThenBlock: {
                    BreakLoop
                }
                k = Add(k, one)
            }
            LsConfig.tz_off = Subtract(0, dst_west)
            ReturnValue(0)
        }
        LsConfig.tz_off = Subtract(0, std_west)
        ReturnValue(0)
    }
}
Function.CopyTz {
    Input: buf: Address
    Input: n: Integer
    Input: dest: Address
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            start = 0
            IfCondition EqualTo(i, 0) ThenBlock: {
                start = 1
            }
            IfCondition GreaterThan(i, 0) ThenBlock: {
                prev_at = Subtract(i, 1)
                prev = RDMEM_8(buf, prev_at)
                IfCondition EqualTo(prev, 0) ThenBlock: {
                    start = 1
                }
            }
            IfCondition EqualTo(start, 1) ThenBlock: {
                a = RDMEM_8(buf, i)
                b = RDMEM_8(buf, Add(i, 1))
                c = RDMEM_8(buf, Add(i, 2))
                IfCondition EqualTo(a, 84) ThenBlock: {
                    IfCondition EqualTo(b, 90) ThenBlock: {
                        IfCondition EqualTo(c, 61) ThenBlock: {
                            k = 0
                            src = Add(i, 3)
                            WhileLoop LessThan(k, 127) {
                                ch = RDMEM_8(buf, Add(src, k))
                                IfCondition EqualTo(ch, 0) ThenBlock: {
                                    BreakLoop
                                }
                                WRMEM_8(dest, k, ch)
                                k = Add(k, one)
                            }
                            WRMEM_8(dest, k, 0)
                        }
                    }
                }
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}
Function.ApplyZone {
    Input: mtime: Integer
    Body: {
        LsConfig.tz_off = 0
        IfCondition EqualTo(LsConfig.tz_name, 0) ThenBlock: {
            LsConfig.tz_name = Allocate(32)
        }
        WRMEM_8(LsConfig.tz_name, 0, 0)
        fd = SystemCall(2, "/proc/self/environ", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf = Allocate(262144)
        n = SystemCall(0, fd, buf, 262143)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 262144)
            ReturnValue(0)
        }
        WRMEM_8(buf, n, 0)
        tz = Allocate(128)
        WRMEM_8(tz, 0, 0)
        CopyTz(buf, n, tz)
        Deallocate(buf, 262144)
        IfCondition EqualTo(RDMEM_8(tz, 0), 0) ThenBlock: {
            Deallocate(tz, 128)
            ReturnValue(0)
        }
        ParseTz(tz, mtime)
        Deallocate(tz, 128)
        ReturnValue(0)
    }
}
Function.WriteOff {
    Body: {
        off = LsConfig.tz_off
        sign = 43
        IfCondition LessThan(off, 0) ThenBlock: {
            sign = 45
            off = Subtract(0, off)
        }
        WriteChar(sign)
        hh = Divide(off, 3600)
        rem = Modulo(off, 3600)
        mm = Divide(rem, 60)
        Pad2(hh)
        Pad2(mm)
        ReturnValue(0)
    }
}
Function.ShowTime {
    Input: mtime: Integer
    Body: {
        ApplyZone(mtime)
        show = Add(mtime, LsConfig.tz_off)
        IfCondition NotEqual(LsConfig.time_fmt, 0) ThenBlock: {
            PrintFmt(show)
            ReturnValue(0)
        }
        IfCondition EqualTo(LsConfig.iso_date, 1) ThenBlock: {
            PrintIsoDate(show)
            ReturnValue(0)
        }
        PrintCivil(show)
        ReturnValue(0)
    }
}
