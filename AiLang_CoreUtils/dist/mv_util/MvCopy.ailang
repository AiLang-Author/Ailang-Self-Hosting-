// MvCopy.ailang - cross-device copy, backup, and same-file checks for mv.
// Pools stay on mv.ailang. This file declares none and has no Main.

LibraryImport.Arena

// ============================================================================
// COPY AND REMOVE (for cross-device moves)
// ============================================================================

Function.DuplicateFile {
    Input: source: Address
    Input: dest: Address
    Output: Integer
    Body: {
        src_fd = SystemCall(2, source, MvConstants.O_RDONLY, 0)
        IfCondition LessThan(src_fd, 0) ThenBlock: {
            errtxt = GetErrorString(src_fd)
            WriteStderr("mv: cannot open '")
            WriteStderr(source)
            WriteStderr("': ")
            WriteStderr(errtxt)
            WriteStderr("\n")
            ReturnValue(1)
        }
        
        mode = GetFileMode(source)
        
        flags = BitwiseOr(MvConstants.O_WRONLY, MvConstants.O_CREAT)
        flags = BitwiseOr(flags, MvConstants.O_TRUNC)
        
        dst_fd = SystemCall(2, dest, flags, mode)
        IfCondition LessThan(dst_fd, 0) ThenBlock: {
            errtxt = GetErrorString(dst_fd)
            WriteStderr("mv: cannot create '")
            WriteStderr(dest)
            WriteStderr("': ")
            WriteStderr(errtxt)
            WriteStderr("\n")
            SystemCall(3, src_fd)
            ReturnValue(1)
        }
        
        buffer = Allocate(MvConstants.BUFFER_SIZE)
        
        WhileLoop 1 {
            bytes_read = SystemCall(0, src_fd, buffer, MvConstants.BUFFER_SIZE)
            
            IfCondition LessEqual(bytes_read, 0) ThenBlock: {
                BreakLoop
            }
            
            bytes_written = SystemCall(1, dst_fd, buffer, bytes_read)
            
            IfCondition NotEqual(bytes_written, bytes_read) ThenBlock: {
                WriteStderr("mv: write error\n")
                Deallocate(buffer, MvConstants.BUFFER_SIZE)
                SystemCall(3, src_fd)
                SystemCall(3, dst_fd)
                ReturnValue(1)
            }
        }
        
        Deallocate(buffer, MvConstants.BUFFER_SIZE)
        SystemCall(3, src_fd)
        SystemCall(3, dst_fd)
        
        ReturnValue(0)
    }
}
Function.MvNumbered {
    Input: dest: Address
    Output: Integer
    Body: {
        n = 1
        found = 0
        WhileLoop LessThan(n, 30) {
            num = IntToString(n)
            p1 = Concat2(dest, ".~")
            p2 = Concat2(p1, num)
            name = Concat2(p2, "~")
            Deallocate(p1, 0)
            Deallocate(p2, 0)
            Deallocate(num, 0)
            sb = Allocate(144)
            exists = SystemCall(6, name, sb)
            Deallocate(sb, 144)
            Deallocate(name, 0)
            IfCondition GreaterEqual(exists, 0) ThenBlock: {
                found = 1
            }
            n = Add(n, 1)
        }
        ReturnValue(found)
    }
}

Function.MvFreeNumber {
    Input: dest: Address
    Output: Address
    Body: {
        n = 1
        WhileLoop LessThan(n, 100) {
            num = IntToString(n)
            p1 = Concat2(dest, ".~")
            p2 = Concat2(p1, num)
            name = Concat2(p2, "~")
            Deallocate(p1, 0)
            Deallocate(p2, 0)
            Deallocate(num, 0)
            sb = Allocate(144)
            exists = SystemCall(6, name, sb)
            Deallocate(sb, 144)
            IfCondition LessThan(exists, 0) ThenBlock: {
                ReturnValue(name)
            }
            Deallocate(name, 0)
            n = Add(n, 1)
        }
        ReturnValue(0)
    }
}

Function.MvBackup {
    Input: dest: Address
    Output: Integer
    Body: {
        use_num = MvConfig.numbered
        IfCondition EqualTo(MvConfig.backup_mode, 2) ThenBlock: {
            use_num = MvNumbered(dest)
        }
        name = 0
        IfCondition EqualTo(use_num, 1) ThenBlock: {
            name = MvFreeNumber(dest)
        } ElseBlock: {
            IfCondition EqualTo(MvConfig.suffix, 0) ThenBlock: {
                name = Concat2(dest, "~")
            } ElseBlock: {
                name = Concat2(dest, MvConfig.suffix)
            }
        }
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(1)
        }
        renamed = SystemCall(82, dest, name)
        IfCondition LessThan(renamed, 0) ThenBlock: {
            Deallocate(name, 0)
            ReturnValue(1)
        }
        MvConfig.backup_to = name
        ReturnValue(0)
    }
}
Function.FileType {
    Input: mode: Integer
    Output: Integer
    Body: {
        kind = BitwiseAnd(mode, 61440)
        ReturnValue(kind)
    }
}

Function.LstatBuf {
    Input: path: Address
    Output: Address
    Body: {
        sb = Allocate(144)
        rc = SystemCall(6, path, sb)
        IfCondition LessThan(rc, 0) ThenBlock: {
            Deallocate(sb, 144)
            ReturnValue(0)
        }
        ReturnValue(sb)
    }
}

Function.SaySame {
    Input: source: Address
    Input: dest: Address
    Body: {
        WriteStderr("mv: '")
        WriteStderr(source)
        WriteStderr("' and '")
        WriteStderr(dest)
        WriteStderr("' are the same file\n")
    }
}

Function.SameFile {
    Input: source: Address
    Input: dest: Address
    Output: Integer
    Body: {
        ssb = LstatBuf(source)
        dsb = LstatBuf(dest)
        IfCondition EqualTo(dsb, 0) ThenBlock: {
            IfCondition NotEqual(ssb, 0) ThenBlock: {
                Deallocate(ssb, 144)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(ssb, 0) ThenBlock: {
            Deallocate(dsb, 144)
            ReturnValue(0)
        }
        sdev = Dereference(ssb)
        sino = Dereference(Add(ssb, 8))
        snlink = Dereference(Add(ssb, 16))
        smode = Dereference(Add(ssb, 24))
        ddev = Dereference(dsb)
        dino = Dereference(Add(dsb, 8))
        dnlink = Dereference(Add(dsb, 16))
        dmode = Dereference(Add(dsb, 24))
        Deallocate(ssb, 144)
        Deallocate(dsb, 144)
        skind = FileType(smode)
        dkind = FileType(dmode)
        same_ino = And(EqualTo(sdev, ddev), EqualTo(sino, dino))
        same_name = StringEquals(source, dest)
        IfCondition EqualTo(same_ino, 1) ThenBlock: {
            IfCondition EqualTo(MvConfig.backup, 1) ThenBlock: {
                IfCondition EqualTo(same_name, 0) ThenBlock: {
                    ReturnValue(0)
                }
            }
            SaySame(source, dest)
            ReturnValue(1)
        }
        IfCondition EqualTo(dkind, 40960) ThenBlock: {
            IfCondition NotEqual(skind, 40960) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(skind, 40960) ThenBlock: {
            IfCondition NotEqual(dkind, 40960) ThenBlock: {
                IfCondition EqualTo(MvConfig.backup, 1) ThenBlock: {
                    IfCondition EqualTo(same_name, 0) ThenBlock: {
                        ReturnValue(0)
                    }
                }
                IfCondition GreaterThan(dnlink, 1) ThenBlock: {
                    raw = Allocate(4096)
                    nread = SystemCall(89, source, raw, 4095)
                    IfCondition GreaterThan(nread, 0) ThenBlock: {
                        SetByte(raw, nread, 0)
                        hit = StringEquals(raw, dest)
                        Deallocate(raw, 4096)
                        IfCondition EqualTo(hit, 1) ThenBlock: {
                            SaySame(source, dest)
                            ReturnValue(1)
                        }
                        ReturnValue(0)
                    }
                    Deallocate(raw, 4096)
                }
                SaySame(source, dest)
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.FindCopy {
    Input: dev: Integer
    Input: ino: Integer
    Output: Address
    Body: {
        i = 0
        one = 1
        n = MvMemo.copy_n
        WhileLoop LessThan(i, n) {
            cd = ArrayGet(MvMemo.copy_dev, i)
            ci = ArrayGet(MvMemo.copy_ino, i)
            IfCondition EqualTo(cd, dev) ThenBlock: {
                IfCondition EqualTo(ci, ino) ThenBlock: {
                    found = ArrayGet(MvMemo.copy_path, i)
                    ReturnValue(found)
                }
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.NoteCopy {
    Input: dev: Integer
    Input: ino: Integer
    Input: path: Address
    Body: {
        slot = MvMemo.copy_n
        IfCondition LessThan(slot, 128) ThenBlock: {
            kept = CopyTail(path, 0)
            ArraySet(MvMemo.copy_dev, slot, dev)
            ArraySet(MvMemo.copy_ino, slot, ino)
            ArraySet(MvMemo.copy_path, slot, kept)
            MvMemo.copy_n = Add(slot, 1)
        }
    }
}

Function.HitDest {
    Input: path: Address
    Output: Integer
    Body: {
        sb = LstatBuf(path)
        IfCondition EqualTo(sb, 0) ThenBlock: {
            ReturnValue(0)
        }
        dev = Dereference(sb)
        ino = Dereference(Add(sb, 8))
        Deallocate(sb, 144)
        i = 0
        one = 1
        n = MvMemo.dest_n
        WhileLoop LessThan(i, n) {
            dd = ArrayGet(MvMemo.dest_dev, i)
            di = ArrayGet(MvMemo.dest_ino, i)
            IfCondition EqualTo(dd, dev) ThenBlock: {
                IfCondition EqualTo(di, ino) ThenBlock: {
                    dp = ArrayGet(MvMemo.dest_path, i)
                    hit = StringEquals(dp, path)
                    IfCondition EqualTo(hit, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                }
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.NoteDest {
    Input: path: Address
    Body: {
        sb = LstatBuf(path)
        IfCondition EqualTo(sb, 0) ThenBlock: {
            ReturnValue(0)
        }
        dev = Dereference(sb)
        ino = Dereference(Add(sb, 8))
        Deallocate(sb, 144)
        slot = MvMemo.dest_n
        IfCondition LessThan(slot, 128) ThenBlock: {
            kept = CopyTail(path, 0)
            ArraySet(MvMemo.dest_dev, slot, dev)
            ArraySet(MvMemo.dest_ino, slot, ino)
            ArraySet(MvMemo.dest_path, slot, kept)
            MvMemo.dest_n = Add(slot, 1)
        }
        ReturnValue(0)
    }
}

Function.HitSrcDir {
    Input: dev: Integer
    Input: ino: Integer
    Output: Integer
    Body: {
        i = 0
        one = 1
        n = MvMemo.src_n
        WhileLoop LessThan(i, n) {
            sd = ArrayGet(MvMemo.src_dev, i)
            si = ArrayGet(MvMemo.src_ino, i)
            IfCondition EqualTo(sd, dev) ThenBlock: {
                IfCondition EqualTo(si, ino) ThenBlock: {
                    ReturnValue(1)
                }
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.NoteSrcDir {
    Input: dev: Integer
    Input: ino: Integer
    Body: {
        slot = MvMemo.src_n
        IfCondition LessThan(slot, 64) ThenBlock: {
            ArraySet(MvMemo.src_dev, slot, dev)
            ArraySet(MvMemo.src_ino, slot, ino)
            MvMemo.src_n = Add(slot, 1)
        }
    }
}

Function.CopyOneX {
    Input: src: Address
    Input: dst: Address
    Input: name: Address
    Body: {
        buf = Allocate(256)
        n = SystemCall(191, src, name, buf, 256)
        IfCondition GreaterThan(n, 0) ThenBlock: {
            SystemCall(188, dst, name, buf, n, 0)
        }
        Deallocate(buf, 256)
    }
}

Function.CopyAcl {
    Input: src: Address
    Input: dst: Address
    Body: {
        CopyOneX(src, dst, "system.posix_acl_access")
        CopyOneX(src, dst, "system.posix_acl_default")
    }
}

Function.SayRenamed {
    Input: source: Address
    Input: dest: Address
    Body: {
        IfCondition EqualTo(MvConfig.verbose, 1) ThenBlock: {
            WriteStdout("renamed '")
            WriteStdout(source)
            WriteStdout("' -> '")
            WriteStdout(dest)
            WriteStdout("'")
            IfCondition NotEqual(MvConfig.backup_to, 0) ThenBlock: {
                WriteStdout(" (backup: '")
                WriteStdout(MvConfig.backup_to)
                WriteStdout("')")
            }
            WriteStdout("\n")
        }
    }
}

Function.CopyTree {
    Input: source: Address
    Input: dest: Address
    Input: depth: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(depth, 40) ThenBlock: {
            WriteStderr("mv: cannot move '")
            WriteStderr(source)
            WriteStderr("': File name too long\n")
            ReturnValue(1)
        }
        sb = LstatBuf(source)
        IfCondition EqualTo(sb, 0) ThenBlock: {
            errtxt = GetErrorString(-2)
            WriteStderr("mv: cannot stat '")
            WriteStderr(source)
            WriteStderr("': ")
            WriteStderr(errtxt)
            WriteStderr("\n")
            ReturnValue(1)
        }
        dev = Dereference(sb)
        ino = Dereference(Add(sb, 8))
        nlink = Dereference(Add(sb, 16))
        mode = Dereference(Add(sb, 24))
        rdev = Dereference(Add(sb, 40))
        Deallocate(sb, 144)
        kind = FileType(mode)
        IfCondition NotEqual(kind, 16384) ThenBlock: {
            prev = FindCopy(dev, ino)
            IfCondition NotEqual(prev, 0) ThenBlock: {
                linked = SystemCall(86, prev, dest)
                IfCondition LessThan(linked, 0) ThenBlock: {
                    errtxt = GetErrorString(linked)
                    WriteStderr("mv: cannot create hard link '")
                    WriteStderr(dest)
                    WriteStderr("' to '")
                    WriteStderr(prev)
                    WriteStderr("': ")
                    WriteStderr(errtxt)
                    WriteStderr("\n")
                    ReturnValue(1)
                }
                SystemCall(87, source)
                MvConfig.backup_to = 0
                SayRenamed(source, dest)
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(kind, 16384) ThenBlock: {
            dmode = BitwiseAnd(mode, 511)
            made = SystemCall(83, dest, dmode)
            IfCondition LessThan(made, 0) ThenBlock: {
                errtxt = GetErrorString(made)
                WriteStderr("mv: cannot create directory '")
                WriteStderr(dest)
                WriteStderr("': ")
                WriteStderr(errtxt)
                WriteStderr("\n")
                ReturnValue(1)
            }
            fullmode = BitwiseAnd(mode, 4095)
            SystemCall(90, dest, fullmode)
            CopyAcl(source, dest)
            MvConfig.backup_to = 0
            SayRenamed(source, dest)
            flags = 65536
            dir_fd = SystemCall(257, -100, source, flags, 0)
            IfCondition LessThan(dir_fd, 0) ThenBlock: {
                errtxt = GetErrorString(dir_fd)
                WriteStderr("mv: cannot open directory '")
                WriteStderr(source)
                WriteStderr("': ")
                WriteStderr(errtxt)
                WriteStderr("\n")
                ReturnValue(1)
            }
            buffer = Allocate(4096)
            WhileLoop 1 {
                nread = SystemCall(217, dir_fd, buffer, 4096)
                IfCondition LessEqual(nread, 0) ThenBlock: {
                    BreakLoop
                }
                pos = 0
                WhileLoop LessThan(pos, nread) {
                    reclo = GetByte(buffer, Add(pos, 16))
                    rechi = GetByte(buffer, Add(pos, 17))
                    reclen = Add(reclo, Multiply(rechi, 256))
                    IfCondition LessEqual(reclen, 0) ThenBlock: {
                        BreakLoop
                    }
                    name_at = Add(pos, 19)
                    name_len = 0
                    one = 1
                    WhileLoop 1 {
                        ch = GetByte(buffer, Add(name_at, name_len))
                        IfCondition EqualTo(ch, 0) ThenBlock: {
                            BreakLoop
                        }
                        name_len = Add(name_len, one)
                    }
                    name = Allocate(Add(name_len, 1))
                    j = 0
                    WhileLoop LessThan(j, name_len) {
                        SetByte(name, j, GetByte(buffer, Add(name_at, j)))
                        j = Add(j, one)
                    }
                    SetByte(name, name_len, 0)
                    dot1 = And(EqualTo(name_len, 1), EqualTo(GetByte(name, 0), 46))
                    dot2 = And(EqualTo(name_len, 2), EqualTo(GetByte(name, 0), 46))
                    dot2 = And(dot2, EqualTo(GetByte(name, 1), 46))
                    skip = Or(dot1, dot2)
                    IfCondition EqualTo(skip, 0) ThenBlock: {
                        child_src = BuildPath(source, name)
                        child_dst = BuildPath(dest, name)
                        child_rc = CopyTree(child_src, child_dst, Add(depth, 1))
                        Deallocate(child_src, 0)
                        Deallocate(child_dst, 0)
                        IfCondition NotEqual(child_rc, 0) ThenBlock: {
                            Deallocate(name, 0)
                            Deallocate(buffer, 4096)
                            SystemCall(3, dir_fd)
                            ReturnValue(1)
                        }
                    }
                    Deallocate(name, 0)
                    pos = Add(pos, reclen)
                }
            }
            Deallocate(buffer, 4096)
            SystemCall(3, dir_fd)
            removed = SystemCall(84, source)
            IfCondition LessThan(removed, 0) ThenBlock: {
                errtxt = GetErrorString(removed)
                WriteStderr("mv: cannot remove '")
                WriteStderr(source)
                WriteStderr("': ")
                WriteStderr(errtxt)
                WriteStderr("\n")
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 40960) ThenBlock: {
            raw = Allocate(4096)
            nread = SystemCall(89, source, raw, 4095)
            IfCondition LessThan(nread, 0) ThenBlock: {
                errtxt = GetErrorString(nread)
                WriteStderr("mv: cannot stat '")
                WriteStderr(source)
                WriteStderr("': ")
                WriteStderr(errtxt)
                WriteStderr("\n")
                Deallocate(raw, 4096)
                ReturnValue(1)
            }
            SetByte(raw, nread, 0)
            made = SystemCall(88, raw, dest)
            Deallocate(raw, 4096)
            IfCondition LessThan(made, 0) ThenBlock: {
                errtxt = GetErrorString(made)
                WriteStderr("mv: cannot create symbolic link '")
                WriteStderr(dest)
                WriteStderr("': ")
                WriteStderr(errtxt)
                WriteStderr("\n")
                ReturnValue(1)
            }
            SystemCall(87, source)
            MvConfig.backup_to = 0
            SayRenamed(source, dest)
            ReturnValue(0)
        }
        special = 0
        IfCondition EqualTo(kind, 4096) ThenBlock: {
            special = 1
        }
        IfCondition EqualTo(kind, 8192) ThenBlock: {
            special = 1
        }
        IfCondition EqualTo(kind, 24576) ThenBlock: {
            special = 1
        }
        IfCondition EqualTo(kind, 49152) ThenBlock: {
            special = 1
        }
        IfCondition EqualTo(special, 1) ThenBlock: {
            made = SystemCall(133, dest, mode, rdev)
            IfCondition LessThan(made, 0) ThenBlock: {
                errtxt = GetErrorString(made)
                WriteStderr("mv: cannot create special file '")
                WriteStderr(dest)
                WriteStderr("': ")
                WriteStderr(errtxt)
                WriteStderr("\n")
                ReturnValue(1)
            }
            SystemCall(87, source)
            MvConfig.backup_to = 0
            SayRenamed(source, dest)
            ReturnValue(0)
        }
        copied = DuplicateFile(source, dest)
        IfCondition NotEqual(copied, 0) ThenBlock: {
            ReturnValue(1)
        }
        fullmode = BitwiseAnd(mode, 4095)
        SystemCall(90, dest, fullmode)
        CopyAcl(source, dest)
        IfCondition GreaterThan(nlink, 1) ThenBlock: {
            NoteCopy(dev, ino, dest)
        }
        SystemCall(87, source)
        MvConfig.backup_to = 0
        SayRenamed(source, dest)
        ReturnValue(0)
    }
}

// ============================================================================
// CORE MOVE FUNCTION
// ============================================================================

Function.FailOver {
    Input: dest: Address
    Input: err: Integer
    Output: Integer
    Body: {
        errtxt = GetErrorString(err)
        WriteStderr("mv: cannot overwrite '")
        WriteStderr(dest)
        WriteStderr("': ")
        WriteStderr(errtxt)
        WriteStderr("\n")
        MvStats.errors = Add(MvStats.errors, 1)
        ReturnValue(1)
    }
}

Function.FailMove {
    Input: source: Address
    Input: dest: Address
    Input: err: Integer
    Output: Integer
    Body: {
        errtxt = GetErrorString(err)
        WriteStderr("mv: cannot move '")
        WriteStderr(source)
        WriteStderr("' to '")
        WriteStderr(dest)
        WriteStderr("': ")
        WriteStderr(errtxt)
        WriteStderr("\n")
        MvStats.errors = Add(MvStats.errors, 1)
        ReturnValue(1)
    }
}

Function.PrepareDest {
    Input: source: Address
    Input: dest: Address
    Output: Integer
    Body: {
        ssb = LstatBuf(source)
        dsb = LstatBuf(dest)
        IfCondition EqualTo(ssb, 0) ThenBlock: {
            IfCondition NotEqual(dsb, 0) ThenBlock: {
                Deallocate(dsb, 144)
            }
            ReturnValue(0)
        }
        skind = FileType(Dereference(Add(ssb, 24)))
        Deallocate(ssb, 144)
        IfCondition EqualTo(dsb, 0) ThenBlock: {
            ReturnValue(0)
        }
        dkind = FileType(Dereference(Add(dsb, 24)))
        Deallocate(dsb, 144)
        IfCondition EqualTo(skind, 16384) ThenBlock: {
            IfCondition EqualTo(dkind, 16384) ThenBlock: {
                removed = SystemCall(84, dest)
                IfCondition LessThan(removed, 0) ThenBlock: {
                    errtxt = GetErrorString(removed)
                    WriteStderr("mv: cannot overwrite '")
                    WriteStderr(dest)
                    WriteStderr("': ")
                    WriteStderr(errtxt)
                    WriteStderr("\n")
                    MvStats.errors = Add(MvStats.errors, 1)
                    ReturnValue(1)
                }
                ReturnValue(0)
            }
            FailMove(source, dest, -20)
            ReturnValue(1)
        }
        IfCondition EqualTo(dkind, 16384) ThenBlock: {
            errtxt = GetErrorString(-21)
            WriteStderr("mv: cannot overwrite '")
            WriteStderr(dest)
            WriteStderr("': ")
            WriteStderr(errtxt)
            WriteStderr("\n")
            MvStats.errors = Add(MvStats.errors, 1)
            ReturnValue(1)
        }
        removed = SystemCall(87, dest)
        IfCondition LessThan(removed, 0) ThenBlock: {
            FailMove(source, dest, removed)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.RelocateFile {
    Input: source: Address
    Input: dest: Address
    Output: Integer
    Body: {
        MvConfig.backup_to = 0
        ssb = LstatBuf(source)
        IfCondition EqualTo(ssb, 0) ThenBlock: {
            errtxt = GetErrorString(-2)
            WriteStderr("mv: cannot stat '")
            WriteStderr(source)
            WriteStderr("': ")
            WriteStderr(errtxt)
            WriteStderr("\n")
            MvStats.errors = Add(MvStats.errors, 1)
            ReturnValue(1)
        }
        sdev = Dereference(ssb)
        sino = Dereference(Add(ssb, 8))
        skind = FileType(Dereference(Add(ssb, 24)))
        Deallocate(ssb, 144)
        IfCondition EqualTo(skind, 16384) ThenBlock: {
            seen = HitSrcDir(sdev, sino)
            IfCondition EqualTo(seen, 1) ThenBlock: {
                WriteStderr("mv: warning: source directory '")
                WriteStderr(source)
                WriteStderr("' specified more than once\n")
                ReturnValue(0)
            }
            NoteSrcDir(sdev, sino)
        }
        dest_exists = PathExists(dest)
        IfCondition EqualTo(dest_exists, 1) ThenBlock: {
            same = SameFile(source, dest)
            IfCondition EqualTo(same, 1) ThenBlock: {
                MvStats.errors = Add(MvStats.errors, 1)
                ReturnValue(1)
            }
            IfCondition EqualTo(MvConfig.update_mode, 2) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(MvConfig.update_mode, 1) ThenBlock: {
                src_mtime = GetModTime(source)
                dst_mtime = GetModTime(dest)
                IfCondition LessEqual(src_mtime, dst_mtime) ThenBlock: {
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(MvConfig.no_clobber, 1) ThenBlock: {
                WriteStderr("mv: not replacing '")
                WriteStderr(dest)
                WriteStderr("'\n")
                MvStats.errors = Add(MvStats.errors, 1)
                ReturnValue(1)
            }
            IfCondition EqualTo(MvConfig.interactive, 1) ThenBlock: {
                WriteStderr("mv: overwrite '")
                WriteStderr(dest)
                WriteStderr("'? ")
                response = PromptUser("")
                IfCondition EqualTo(response, 0) ThenBlock: {
                    MvStats.errors = Add(MvStats.errors, 1)
                    ReturnValue(1)
                }
            }
            IfCondition NotEqual(MvConfig.backup_mode, 1) ThenBlock: {
                fresh = HitDest(dest)
                IfCondition EqualTo(fresh, 1) ThenBlock: {
                    WriteStderr("mv: will not overwrite just-created '")
                    WriteStderr(dest)
                    WriteStderr("' with '")
                    WriteStderr(source)
                    WriteStderr("'\n")
                    MvStats.errors = Add(MvStats.errors, 1)
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(MvConfig.backup, 1) ThenBlock: {
                bname = 0
                use_num = MvConfig.numbered
                IfCondition EqualTo(MvConfig.backup_mode, 2) ThenBlock: {
                    use_num = MvNumbered(dest)
                }
                IfCondition EqualTo(use_num, 1) ThenBlock: {
                    bname = MvFreeNumber(dest)
                } ElseBlock: {
                    IfCondition EqualTo(MvConfig.suffix, 0) ThenBlock: {
                        bname = Concat2(dest, "~")
                    } ElseBlock: {
                        bname = Concat2(dest, MvConfig.suffix)
                    }
                }
                IfCondition NotEqual(bname, 0) ThenBlock: {
                    IfCondition NotEqual(MvConfig.backup_mode, 1) ThenBlock: {
                        clash = StringEquals(bname, source)
                        bsb = LstatBuf(bname)
                        IfCondition NotEqual(bsb, 0) ThenBlock: {
                            bdev = Dereference(bsb)
                            bino = Dereference(Add(bsb, 8))
                            Deallocate(bsb, 144)
                            IfCondition EqualTo(bdev, sdev) ThenBlock: {
                                IfCondition EqualTo(bino, sino) ThenBlock: {
                                    clash = 1
                                }
                            }
                        }
                        IfCondition EqualTo(clash, 1) ThenBlock: {
                            WriteStderr("mv: backing up '")
                            WriteStderr(dest)
                            WriteStderr("' might destroy source;  '")
                            WriteStderr(source)
                            WriteStderr("' not moved\n")
                            MvStats.errors = Add(MvStats.errors, 1)
                            ReturnValue(1)
                        }
                    }
                    Deallocate(bname, 0)
                }
                backed = MvBackup(dest)
                IfCondition NotEqual(backed, 0) ThenBlock: {
                    MvStats.errors = Add(MvStats.errors, 1)
                    ReturnValue(1)
                }
            }
        }
        result = SystemCall(82, source, dest)
        IfCondition GreaterEqual(result, 0) ThenBlock: {
            MvStats.moved = Add(MvStats.moved, 1)
            SayRenamed(source, dest)
            NoteDest(dest)
            ReturnValue(0)
        }
        abs_error = Subtract(0, result)
        IfCondition EqualTo(abs_error, 22) ThenBlock: {
            WriteStderr("mv: cannot move '")
            WriteStderr(source)
            WriteStderr("' to a subdirectory of itself, '")
            WriteStderr(dest)
            WriteStderr("'\n")
            MvStats.errors = Add(MvStats.errors, 1)
            ReturnValue(1)
        }
        IfCondition EqualTo(abs_error, MvConstants.EXDEV) ThenBlock: {
            IfCondition EqualTo(MvConfig.no_copy, 1) ThenBlock: {
                FailMove(source, dest, result)
                ReturnValue(1)
            }
            ready = PrepareDest(source, dest)
            IfCondition NotEqual(ready, 0) ThenBlock: {
                ReturnValue(1)
            }
            copied = CopyTree(source, dest, 0)
            IfCondition NotEqual(copied, 0) ThenBlock: {
                MvStats.errors = Add(MvStats.errors, 1)
                ReturnValue(1)
            }
            MvStats.moved = Add(MvStats.moved, 1)
            NoteDest(dest)
            ReturnValue(0)
        }
        IfCondition EqualTo(abs_error, 17) ThenBlock: {
            FailOver(dest, result)
            ReturnValue(1)
        }
        IfCondition EqualTo(abs_error, 39) ThenBlock: {
            FailOver(dest, result)
            ReturnValue(1)
        }
        IfCondition EqualTo(abs_error, 16) ThenBlock: {
            FailOver(dest, result)
            ReturnValue(1)
        }
        IfCondition EqualTo(abs_error, 21) ThenBlock: {
            FailOver(dest, result)
            ReturnValue(1)
        }
        FailMove(source, dest, result)
        ReturnValue(1)
    }
}
