// mv.ailang - GNU-Compatible Move/Rename Utility
// Usage: mv [OPTION]... SOURCE... DIRECTORY
//        mv [OPTION]... SOURCE DEST
// Rename SOURCE to DEST, or move SOURCE(s) to DIRECTORY.
//
// Options:
//   -f, --force                  do not prompt before overwriting
//   -i, --interactive            prompt before overwrite
//   -n, --no-clobber             do not overwrite an existing file
//   -v, --verbose                explain what is being done
//   -b, --backup                 make a backup of each existing destination file
//   -u, --update                 move only when the SOURCE file is newer
//   --help                       display this help and exit
//   --version                    output version information and exit

LibraryImport.Arena
LibraryImport.AiLang_CoreUtils.dist.mv_util.MvCopy

FixedPool.MvConfig {
    "force": Initialize=0
    "interactive": Initialize=0
    "no_clobber": Initialize=0
    "verbose": Initialize=0
    "backup": Initialize=0
    "numbered": Initialize=0
    "backup_mode": Initialize=0
    "update": Initialize=0
    "suffix": Initialize=0
    "no_target": Initialize=0
    "target": Initialize=0
    "no_copy": Initialize=0
    "update_mode": Initialize=0
    "backup_to": Initialize=0
    "take": Initialize=0
    "endopt": Initialize=0
    "strip": Initialize=0
}

FixedPool.MvStats {
    "moved": Initialize=0
    "errors": Initialize=0
    "skipped": Initialize=0
}

FixedPool.MvWalk {
    "eq": Initialize=0
}

FixedPool.MvMemo {
    "dest_n": Initialize=0
    "src_n": Initialize=0
    "copy_n": Initialize=0
    "dest_dev": Initialize=0
    "dest_ino": Initialize=0
    "dest_path": Initialize=0
    "src_dev": Initialize=0
    "src_ino": Initialize=0
    "copy_dev": Initialize=0
    "copy_ino": Initialize=0
    "copy_path": Initialize=0
}

FixedPool.MvConstants {
    "EEXIST": Initialize=17
    "ENOENT": Initialize=2
    "EACCES": Initialize=13
    "EXDEV": Initialize=18
    "EISDIR": Initialize=21
    "ENOTDIR": Initialize=20
    "BUFFER_SIZE": Initialize=65536
    "O_RDONLY": Initialize=0
    "O_WRONLY": Initialize=1
    "O_CREAT": Initialize=64
    "O_TRUNC": Initialize=512
}

// ============================================================================
// UTILITY FUNCTIONS
// ============================================================================

Function.WriteStdout {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 1, str, len)
    }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.IntToString {
    Input: num: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(num, 0) ThenBlock: {
            str = Allocate(2)
            WRMEM_8(str, 0, 48)
            WRMEM_8(str, 1, 0)
            ReturnValue(str)
        }
        
        is_negative = LessThan(num, 0)
        abs_num = num
        IfCondition EqualTo(is_negative, 1) ThenBlock: {
            abs_num = Subtract(0, num)
        }
        
        temp = abs_num
        digits = 0
        WhileLoop GreaterThan(temp, 0) {
            temp = Divide(temp, 10)
            digits = Add(digits, 1)
        }
        
        total_len = digits
        IfCondition EqualTo(is_negative, 1) ThenBlock: {
            total_len = Add(total_len, 1)
        }
        
        str = Allocate(Add(total_len, 1))
        
        pos = 0
        IfCondition EqualTo(is_negative, 1) ThenBlock: {
            WRMEM_8(str, 0, 45)
            pos = 1
        }
        
        i = Subtract(total_len, 1)
        temp = abs_num
        WhileLoop GreaterThan(temp, 0) {
            digit = Modulo(temp, 10)
            WRMEM_8(str, i, Add(48, digit))
            temp = Divide(temp, 10)
            i = Subtract(i, 1)
        }
        
        WRMEM_8(str, total_len, 0)
        ReturnValue(str)
    }
}

Function.PathExists {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(4, path, statbuf)
        Deallocate(statbuf, 144)
        ReturnValue(GreaterEqual(result, 0))
    }
}

Function.IsDirectory {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(4, path, statbuf)
        
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        
        st_mode = RDMEM_64(statbuf, 24)
        Deallocate(statbuf, 144)
        
        is_dir = BitwiseAnd(st_mode, 16384)
        ReturnValue(NotEqual(is_dir, 0))
    }
}

Function.GetModTime {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(4, path, statbuf)
        
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        
        mtime = RDMEM_64(statbuf, 88)
        Deallocate(statbuf, 144)
        ReturnValue(mtime)
    }
}

Function.GetFileMode {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(4, path, statbuf)
        
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(420)
        }
        
        st_mode = RDMEM_64(statbuf, 24)
        Deallocate(statbuf, 144)
        
        permissions = BitwiseAnd(st_mode, 4095)
        ReturnValue(permissions)
    }
}

Function.BuildPath {
    Input: dir: Address
    Input: file: Address
    Output: Address
    Body: {
        dir_len = StringLength(dir)
        file_len = StringLength(file)
        
        needs_slash = 1
        IfCondition GreaterThan(dir_len, 0) ThenBlock: {
            last_char = RDMEM_8(dir, Subtract(dir_len, 1))
            IfCondition EqualTo(last_char, 47) ThenBlock: {
                needs_slash = 0
            }
        }
        
        total_len = Add(Add(dir_len, file_len), Add(needs_slash, 1))
        path = Allocate(total_len)
        
        i = 0
        WhileLoop LessThan(i, dir_len) {
            WRMEM_8(path, i, RDMEM_8(dir, i))
            i = Add(i, 1)
        }
        
        IfCondition EqualTo(needs_slash, 1) ThenBlock: {
            WRMEM_8(path, i, 47)
            i = Add(i, 1)
        }
        
        j = 0
        WhileLoop LessThan(j, file_len) {
            WRMEM_8(path, i, RDMEM_8(file, j))
            i = Add(i, 1)
            j = Add(j, 1)
        }
        
        WRMEM_8(path, i, 0)
        ReturnValue(path)
    }
}

Function.GetBasename {
    Input: path: Address
    Output: Address
    Body: {
        len = StringLength(path)
        
        real_len = len
        WhileLoop And(GreaterThan(real_len, 0), 
                     EqualTo(RDMEM_8(path, Subtract(real_len, 1)), 47)) {
            real_len = Subtract(real_len, 1)
        }
        
        last_slash = -1
        i = 0
        WhileLoop LessThan(i, real_len) {
            IfCondition EqualTo(RDMEM_8(path, i), 47) ThenBlock: {
                last_slash = i
            }
            i = Add(i, 1)
        }
        
        start = Add(last_slash, 1)
        basename_len = Subtract(real_len, start)
        
        IfCondition EqualTo(basename_len, 0) ThenBlock: {
            basename = Allocate(2)
            WRMEM_8(basename, 0, 47)
            WRMEM_8(basename, 1, 0)
            ReturnValue(basename)
        }
        
        basename = Allocate(Add(basename_len, 1))
        i = 0
        WhileLoop LessThan(i, basename_len) {
            WRMEM_8(basename, i, RDMEM_8(path, Add(start, i)))
            i = Add(i, 1)
        }
        WRMEM_8(basename, basename_len, 0)
        
        ReturnValue(basename)
    }
}

Function.GetErrorString {
    Input: errno: Integer
    Output: Address
    Body: {
        abs_errno = errno
        IfCondition LessThan(errno, 0) ThenBlock: {
            abs_errno = Subtract(0, errno)
        }
        
        IfCondition EqualTo(abs_errno, MvConstants.EEXIST) ThenBlock: {
            ReturnValue("File exists")
        }
        
        IfCondition EqualTo(abs_errno, MvConstants.ENOENT) ThenBlock: {
            ReturnValue("No such file or directory")
        }
        
        IfCondition EqualTo(abs_errno, MvConstants.EACCES) ThenBlock: {
            ReturnValue("Permission denied")
        }
        
        IfCondition EqualTo(abs_errno, MvConstants.EXDEV) ThenBlock: {
            ReturnValue("Invalid cross-device link")
        }
        
        IfCondition EqualTo(abs_errno, MvConstants.EISDIR) ThenBlock: {
            ReturnValue("Is a directory")
        }
        
        IfCondition EqualTo(abs_errno, MvConstants.ENOTDIR) ThenBlock: {
            ReturnValue("Not a directory")
        }
        
        IfCondition EqualTo(abs_errno, 39) ThenBlock: {
            ReturnValue("Directory not empty")
        }
        
        IfCondition EqualTo(abs_errno, 22) ThenBlock: {
            ReturnValue("Invalid argument")
        }
        
        IfCondition EqualTo(abs_errno, 16) ThenBlock: {
            ReturnValue("Device or resource busy")
        }
        
        IfCondition EqualTo(abs_errno, 1) ThenBlock: {
            ReturnValue("Operation not permitted")
        }
        
        IfCondition EqualTo(abs_errno, 30) ThenBlock: {
            ReturnValue("Read-only file system")
        }
        
        IfCondition EqualTo(abs_errno, 28) ThenBlock: {
            ReturnValue("No space left on device")
        }
        
        ReturnValue("Unknown error")
    }
}

Function.PromptUser {
    Input: prompt: Address
    Output: Integer
    Body: {
        WriteStderr(prompt)
        
        response = Allocate(8)
        bytes = SystemCall(0, 0, response, 8)
        
        IfCondition LessEqual(bytes, 0) ThenBlock: {
            Deallocate(response, 8)
            ReturnValue(0)
        }
        
        ch = RDMEM_8(response, 0)
        Deallocate(response, 8)
        
        result = Or(EqualTo(ch, 121), EqualTo(ch, 89))
        ReturnValue(result)
    }
}


Function.HasPrefix {
    Input: text: Address
    Input: prefix: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop 1 {
            c = RDMEM_8(prefix, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(1)
            }
            b = RDMEM_8(text, i)
            IfCondition NotEqual(b, c) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.CopyTail {
    Input: src: Address
    Input: at: Integer
    Output: Address
    Body: {
        p = Add(src, at)
        n = StringLength(p)
        buf = Allocate(Add(n, 1))
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            WRMEM_8(buf, i, RDMEM_8(p, i))
            i = Add(i, one)
        }
        WRMEM_8(buf, n, 0)
        ReturnValue(buf)
    }
}

Function.Concat2 {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        la = StringLength(a)
        lb = StringLength(b)
        out = Allocate(Add(Add(la, lb), 1))
        i = 0
        WhileLoop LessThan(i, la) {
            WRMEM_8(out, i, RDMEM_8(a, i))
            i = Add(i, 1)
        }
        j = 0
        WhileLoop LessThan(j, lb) {
            WRMEM_8(out, i, RDMEM_8(b, j))
            i = Add(i, 1)
            j = Add(j, 1)
        }
        WRMEM_8(out, i, 0)
        ReturnValue(out)
    }
}


Function.StripSlash {
    Input: path: Address
    Output: Address
    Body: {
        n = StringLength(path)
        end = n
        one = 1
        WhileLoop And(GreaterThan(end, 1), EqualTo(RDMEM_8(path, Subtract(end, 1)), 47)) {
            end = Subtract(end, one)
        }
        buf = Allocate(Add(end, 1))
        i = 0
        WhileLoop LessThan(i, end) {
            WRMEM_8(buf, i, RDMEM_8(path, i))
            i = Add(i, one)
        }
        WRMEM_8(buf, end, 0)
        ReturnValue(buf)
    }
}

Function.OptPrefix {
    Input: flag: Address
    Input: word: Address
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop 1 {
            fc = RDMEM_8(flag, Add(i, 2))
            IfCondition Or(EqualTo(fc, 0), EqualTo(fc, 61)) ThenBlock: {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    ReturnValue(1)
                }
                ReturnValue(0)
            }
            wc = RDMEM_8(word, i)
            IfCondition EqualTo(wc, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition NotEqual(fc, wc) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.EqTail {
    Input: flag: Address
    Output: Address
    Body: {
        i = 0
        one = 1
        WhileLoop 1 {
            ch = RDMEM_8(flag, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(ch, 61) ThenBlock: {
                tail = CopyTail(flag, Add(i, 1))
                ReturnValue(tail)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}


// ============================================================================
// ARGUMENT PARSING
// ============================================================================

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        ReturnValue(buffer)
    }
}

Function.StringCompare {
    Input: str1: Address
    Input: str2: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop 1 {
            ch1 = RDMEM_8(str1, i)
            ch2 = RDMEM_8(str2, i)
            
            IfCondition NotEqual(ch1, ch2) ThenBlock: {
                ReturnValue(0)
            }
            
            IfCondition EqualTo(ch1, 0) ThenBlock: {
                ReturnValue(1)
            }
            
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.ShowHelp {
    Body: {
        WriteStdout("Usage: mv [OPTION]... SOURCE... DIRECTORY\n")
        WriteStdout("  or:  mv [OPTION]... SOURCE DEST\n")
        WriteStdout("Rename SOURCE to DEST, or move SOURCE(s) to DIRECTORY.\n")
        WriteStdout("\n")
        WriteStdout("Mandatory arguments to long options are mandatory for short options too.\n")
        WriteStdout("  -f, --force              do not prompt before overwriting\n")
        WriteStdout("  -i, --interactive        prompt before overwrite\n")
        WriteStdout("  -n, --no-clobber         do not overwrite an existing file\n")
        WriteStdout("  -u, --update             move only when the SOURCE file is newer\n")
        WriteStdout("                             than the destination file or when the\n")
        WriteStdout("                             destination file is missing\n")
        WriteStdout("  -v, --verbose            explain what is being done\n")
        WriteStdout("      --help               display this help and exit\n")
        WriteStdout("      --version            output version information and exit\n")
        WriteStdout("\n")
        WriteStdout("The backup suffix is '~', unless set with --suffix or SIMPLE_BACKUP_SUFFIX.\n")
        WriteStdout("\n")
        WriteStdout("GNU coreutils compatible mv implementation in AiLang.\n")
    }
}

Function.ShowVersion {
    Body: {
        WriteStdout("mv (AiLang coreutils) 1.0\n")
        WriteStdout("Copyright (C) 2025 AiLang Project\n")
        WriteStdout("License: MIT\n")
        WriteStdout("\n")
        WriteStdout("Written in AiLang - A language designed for human and LLM comprehension.\n")
    }
}

// ============================================================================
// MAIN ROUTINE
// ============================================================================

Function.PushSource {
    Input: sources: Address
    Input: filename: Address
    Input: count: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(count, 256) ThenBlock: {
            ArraySet(sources, count, filename)
            nxt = Add(count, 1)
            ReturnValue(nxt)
        }
        ReturnValue(count)
    }
}

Function.MoveInto {
    Input: dir: Address
    Input: source: Address
    Body: {
        use = source
        IfCondition EqualTo(MvConfig.strip, 1) ThenBlock: {
            use = StripSlash(source)
        }
        base = GetBasename(use)
        dest = BuildPath(dir, base)
        RelocateFile(use, dest)
        Deallocate(base, 0)
        Deallocate(dest, 0)
    }
}

Function.SetClobber {
    Input: kind: Integer
    Body: {
        MvConfig.force = 0
        MvConfig.interactive = 0
        MvConfig.no_clobber = 0
        IfCondition EqualTo(kind, 1) ThenBlock: {
            MvConfig.force = 1
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            MvConfig.interactive = 1
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            MvConfig.no_clobber = 1
        }
    }
}

Function.ApplyUpdate {
    Input: flag: Address
    Body: {
        tail = EqTail(flag)
        MvConfig.update = 1
        MvConfig.update_mode = 1
        IfCondition NotEqual(tail, 0) ThenBlock: {
            IfCondition StringEquals(tail, "none") ThenBlock: {
                MvConfig.update_mode = 2
            }
            IfCondition StringEquals(tail, "all") ThenBlock: {
                MvConfig.update_mode = 3
                MvConfig.update = 0
            }
            IfCondition StringEquals(tail, "older") ThenBlock: {
                MvConfig.update_mode = 1
            }
            Deallocate(tail, 0)
        }
    }
}

Function.ApplyBackup {
    Input: flag: Address
    Body: {
        tail = EqTail(flag)
        MvConfig.backup = 1
        IfCondition EqualTo(tail, 0) ThenBlock: {
            MvConfig.backup_mode = 2
            ReturnValue(0)
        }
        is_num = HasPrefix(tail, "numbered")
        is_simple = HasPrefix(tail, "simple")
        is_never = HasPrefix(tail, "never")
        is_exist = HasPrefix(tail, "existing")
        is_nil = HasPrefix(tail, "nil")
        is_none = HasPrefix(tail, "none")
        is_off = HasPrefix(tail, "off")
        is_t = And(EqualTo(RDMEM_8(tail, 0), 116), EqualTo(RDMEM_8(tail, 1), 0))
        IfCondition EqualTo(is_num, 1) ThenBlock: {
            MvConfig.numbered = 1
            MvConfig.backup_mode = 1
        }
        IfCondition EqualTo(is_t, 1) ThenBlock: {
            MvConfig.numbered = 1
            MvConfig.backup_mode = 1
        }
        IfCondition EqualTo(is_simple, 1) ThenBlock: {
            MvConfig.numbered = 0
            MvConfig.backup_mode = 0
        }
        IfCondition EqualTo(is_never, 1) ThenBlock: {
            MvConfig.numbered = 0
            MvConfig.backup_mode = 0
        }
        IfCondition EqualTo(is_exist, 1) ThenBlock: {
            MvConfig.numbered = 0
            MvConfig.backup_mode = 2
        }
        IfCondition EqualTo(is_nil, 1) ThenBlock: {
            MvConfig.numbered = 0
            MvConfig.backup_mode = 2
        }
        IfCondition EqualTo(is_none, 1) ThenBlock: {
            MvConfig.backup = 0
        }
        IfCondition EqualTo(is_off, 1) ThenBlock: {
            MvConfig.backup = 0
        }
        Deallocate(tail, 0)
        ReturnValue(0)
    }
}

SubRoutine.Main {
    args_buffer = GetArgs()
    
    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        WriteStderr("mv: failed to read arguments\n")
        SystemCall(60, 1)
    }
    
    pos = 0
    WhileLoop NotEqual(RDMEM_8(args_buffer, pos), 0) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)
    
    max_sources = 256
    sources = ArrayCreate(max_sources)
    source_count = 0
    
    WhileLoop LessThan(pos, 4096) {
        ch = RDMEM_8(args_buffer, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            BreakLoop
        }
        
        first = RDMEM_8(args_buffer, pos)
        arg_start = pos
        arg_len = 0
        WhileLoop And(LessThan(pos, 4096), NotEqual(RDMEM_8(args_buffer, pos), 0)) {
            arg_len = Add(arg_len, 1)
            pos = Add(pos, 1)
        }
        flag = Allocate(Add(arg_len, 1))
        i = 0
        WhileLoop LessThan(i, arg_len) {
            WRMEM_8(flag, i, RDMEM_8(args_buffer, Add(arg_start, i)))
            i = Add(i, 1)
        }
        WRMEM_8(flag, arg_len, 0)
        
        IfCondition EqualTo(MvConfig.take, 1) ThenBlock: {
            MvConfig.target = flag
            MvConfig.take = 0
        } ElseBlock: {
            IfCondition EqualTo(MvConfig.take, 2) ThenBlock: {
                MvConfig.suffix = flag
                MvConfig.backup = 1
                MvConfig.take = 0
            } ElseBlock: {
                is_dash = EqualTo(first, 45)
                IfCondition And(EqualTo(is_dash, 1), EqualTo(MvConfig.endopt, 0)) ThenBlock: {
                    IfCondition EqualTo(arg_len, 1) ThenBlock: {
                        source_count = PushSource(sources, flag, source_count)
                    } ElseBlock: {
                        IfCondition EqualTo(RDMEM_8(flag, 1), 45) ThenBlock: {
                            IfCondition StringEquals(flag, "--") ThenBlock: {
                                MvConfig.endopt = 1
                            }
                            IfCondition StringEquals(flag, "--help") ThenBlock: {
                                ShowHelp()
                                SystemCall(60, 0)
                            }
                            IfCondition StringEquals(flag, "--version") ThenBlock: {
                                ShowVersion()
                                SystemCall(60, 0)
                            }
                            IfCondition OptPrefix(flag, "force") ThenBlock: {
                                SetClobber(1)
                            }
                            IfCondition OptPrefix(flag, "interactive") ThenBlock: {
                                SetClobber(2)
                            }
                            IfCondition OptPrefix(flag, "no-clobber") ThenBlock: {
                                SetClobber(3)
                            }
                            IfCondition OptPrefix(flag, "verbose") ThenBlock: {
                                MvConfig.verbose = 1
                            }
                            IfCondition OptPrefix(flag, "no-copy") ThenBlock: {
                                MvConfig.no_copy = 1
                            }
                            IfCondition OptPrefix(flag, "no-target-directory") ThenBlock: {
                                MvConfig.no_target = 1
                            }
                            IfCondition OptPrefix(flag, "strip-trailing-slashes") ThenBlock: {
                                MvConfig.strip = 1
                            }
                            IfCondition OptPrefix(flag, "target-directory") ThenBlock: {
                                tail = EqTail(flag)
                                IfCondition EqualTo(tail, 0) ThenBlock: {
                                    MvConfig.take = 1
                                } ElseBlock: {
                                    MvConfig.target = tail
                                }
                            }
                            IfCondition OptPrefix(flag, "suffix") ThenBlock: {
                                tail = EqTail(flag)
                                MvConfig.backup = 1
                                IfCondition EqualTo(tail, 0) ThenBlock: {
                                    MvConfig.take = 2
                                } ElseBlock: {
                                    MvConfig.suffix = tail
                                }
                            }
                            IfCondition OptPrefix(flag, "update") ThenBlock: {
                                ApplyUpdate(flag)
                            }
                            IfCondition OptPrefix(flag, "backup") ThenBlock: {
                                ApplyBackup(flag)
                            }
                            Deallocate(flag, 0)
                        } ElseBlock: {
                            i = 1
                            WhileLoop LessThan(i, arg_len) {
                                flag_char = RDMEM_8(flag, i)
                                IfCondition EqualTo(flag_char, 102) ThenBlock: {
                                    SetClobber(1)
                                }
                                IfCondition EqualTo(flag_char, 105) ThenBlock: {
                                    SetClobber(2)
                                }
                                IfCondition EqualTo(flag_char, 110) ThenBlock: {
                                    SetClobber(3)
                                }
                                IfCondition EqualTo(flag_char, 118) ThenBlock: {
                                    MvConfig.verbose = 1
                                }
                                IfCondition EqualTo(flag_char, 117) ThenBlock: {
                                    MvConfig.update = 1
                                    MvConfig.update_mode = 1
                                }
                                IfCondition EqualTo(flag_char, 98) ThenBlock: {
                                    MvConfig.backup = 1
                                    MvConfig.backup_mode = 2
                                }
                                IfCondition EqualTo(flag_char, 84) ThenBlock: {
                                    MvConfig.no_target = 1
                                }
                                IfCondition EqualTo(flag_char, 116) ThenBlock: {
                                    nxt = Add(i, 1)
                                    IfCondition LessThan(nxt, arg_len) ThenBlock: {
                                        MvConfig.target = CopyTail(flag, nxt)
                                        BreakLoop
                                    } ElseBlock: {
                                        MvConfig.take = 1
                                    }
                                }
                                IfCondition EqualTo(flag_char, 83) ThenBlock: {
                                    nxt = Add(i, 1)
                                    MvConfig.backup = 1
                                    IfCondition LessThan(nxt, arg_len) ThenBlock: {
                                        MvConfig.suffix = CopyTail(flag, nxt)
                                        BreakLoop
                                    } ElseBlock: {
                                        MvConfig.take = 2
                                    }
                                }
                                one = 1
                                i = Add(i, one)
                            }
                            Deallocate(flag, 0)
                        }
                    }
                } ElseBlock: {
                    source_count = PushSource(sources, flag, source_count)
                }
            }
        }
        pos = Add(pos, 1)
    }
    
    Deallocate(args_buffer, 4096)
    
    IfCondition EqualTo(MvConfig.backup, 1) ThenBlock: {
        IfCondition EqualTo(MvConfig.no_clobber, 1) ThenBlock: {
            WriteStderr("mv: options --backup and --no-clobber are mutually exclusive\n")
            WriteStderr("Try 'mv --help' for more information.\n")
            SystemCall(60, 1)
        }
    }
    IfCondition NotEqual(MvConfig.target, 0) ThenBlock: {
        IfCondition EqualTo(MvConfig.no_target, 1) ThenBlock: {
            WriteStderr("mv: cannot combine --target-directory (-t) and --no-target-directory (-T)\n")
            SystemCall(60, 1)
        }
    }
    
    MvMemo.dest_dev = ArrayCreate(128)
    MvMemo.dest_ino = ArrayCreate(128)
    MvMemo.dest_path = ArrayCreate(128)
    MvMemo.src_dev = ArrayCreate(64)
    MvMemo.src_ino = ArrayCreate(64)
    MvMemo.copy_dev = ArrayCreate(128)
    MvMemo.copy_ino = ArrayCreate(128)
    MvMemo.copy_path = ArrayCreate(128)
    
    IfCondition NotEqual(MvConfig.target, 0) ThenBlock: {
        IfCondition EqualTo(source_count, 0) ThenBlock: {
            WriteStderr("mv: missing file operand\n")
            WriteStderr("Try 'mv --help' for more information.\n")
            SystemCall(60, 1)
        }
        is_dir = IsDirectory(MvConfig.target)
        IfCondition EqualTo(is_dir, 0) ThenBlock: {
            errtxt = GetErrorString(-20)
            tsb = LstatBuf(MvConfig.target)
            IfCondition EqualTo(tsb, 0) ThenBlock: {
                errtxt = GetErrorString(-2)
            } ElseBlock: {
                Deallocate(tsb, 144)
            }
            WriteStderr("mv: target directory '")
            WriteStderr(MvConfig.target)
            WriteStderr("': ")
            WriteStderr(errtxt)
            WriteStderr("\n")
            SystemCall(60, 1)
        }
        i = 0
        WhileLoop LessThan(i, source_count) {
            source = ArrayGet(sources, i)
            MoveInto(MvConfig.target, source)
            i = Add(i, 1)
        }
    } ElseBlock: {
        IfCondition EqualTo(MvConfig.no_target, 1) ThenBlock: {
            IfCondition GreaterThan(source_count, 2) ThenBlock: {
                extra = ArrayGet(sources, 2)
                WriteStderr("mv: extra operand '")
                WriteStderr(extra)
                WriteStderr("'\n")
                WriteStderr("Try 'mv --help' for more information.\n")
                SystemCall(60, 1)
            }
        }
        IfCondition EqualTo(source_count, 0) ThenBlock: {
            WriteStderr("mv: missing file operand\n")
            WriteStderr("Try 'mv --help' for more information.\n")
            SystemCall(60, 1)
        }
        IfCondition EqualTo(source_count, 1) ThenBlock: {
            source = ArrayGet(sources, 0)
            WriteStderr("mv: missing destination file operand after '")
            WriteStderr(source)
            WriteStderr("'\n")
            WriteStderr("Try 'mv --help' for more information.\n")
            SystemCall(60, 1)
        }
        last_arg = ArrayGet(sources, Subtract(source_count, 1))
        IfCondition EqualTo(MvConfig.no_target, 1) ThenBlock: {
            source = ArrayGet(sources, 0)
            dest = StripSlash(last_arg)
            IfCondition EqualTo(MvConfig.strip, 1) ThenBlock: {
                source = StripSlash(source)
            }
            RelocateFile(source, dest)
        } ElseBlock: {
            IfCondition GreaterThan(source_count, 2) ThenBlock: {
                is_dir = IsDirectory(last_arg)
                IfCondition EqualTo(is_dir, 0) ThenBlock: {
                    errtxt = GetErrorString(-20)
                    tsb = LstatBuf(last_arg)
                    IfCondition EqualTo(tsb, 0) ThenBlock: {
                        errtxt = GetErrorString(-2)
                    } ElseBlock: {
                        Deallocate(tsb, 144)
                    }
                    WriteStderr("mv: target '")
                    WriteStderr(last_arg)
                    WriteStderr("': ")
                    WriteStderr(errtxt)
                    WriteStderr("\n")
                    SystemCall(60, 1)
                }
                i = 0
                last_i = Subtract(source_count, 1)
                WhileLoop LessThan(i, last_i) {
                    source = ArrayGet(sources, i)
                    MoveInto(last_arg, source)
                    i = Add(i, 1)
                }
            } ElseBlock: {
                source = ArrayGet(sources, 0)
                is_dir = IsDirectory(last_arg)
                IfCondition EqualTo(is_dir, 1) ThenBlock: {
                    MoveInto(last_arg, source)
                } ElseBlock: {
                    dest = StripSlash(last_arg)
                    IfCondition EqualTo(MvConfig.strip, 1) ThenBlock: {
                        source = StripSlash(source)
                    }
                    RelocateFile(source, dest)
                }
            }
        }
    }
    
    ArrayDestroy(sources)
    
    exit_code = 0
    IfCondition GreaterThan(MvStats.errors, 0) ThenBlock: {
        exit_code = 1
    }
    
    SystemCall(60, exit_code)
}

RunTask(Main)