// nl.ailang - Number lines, with GNU section delimiters and formats

LibraryImport.Arena

FixedPool.Nl {
    "nread": Initialize=0
    "start": Initialize=1
    "cur": Initialize=1
    "incr": Initialize=1
    "width": Initialize=6
    "fmt": Initialize=0
    "sh": Initialize=0
    "sb": Initialize=1
    "sf": Initialize=0
    "sect": Initialize=1
    "noreset": Initialize=0
    "pending": Initialize=0
    "seplen": Initialize=1
    "dlen": Initialize=2
    "sep": Initialize=0
    "delim": Initialize=0
}

Function.WriteOut {
    Input: buf: Address
    Input: len: Integer
    Body: {
        IfCondition LessEqual(len, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = SystemCall(1, 1, buf, len)
        IfCondition LessThan(n, len) ThenBlock: {
            SystemCall(60, 1)
        }
        ReturnValue(0)
    }
}

Function.PutByte {
    Input: ch: Integer
    Body: {
        b = Allocate(1)
        WRMEM_8(b, 0, ch)
        WriteOut(b, 1)
        Deallocate(b, 1)
        ReturnValue(0)
    }
}

Function.ParseNum {
    Input: s: Address
    Output: Integer
    Body: {
        i = 0
        neg = 0
        IfCondition EqualTo(RDMEM_8(s, 0), 45) ThenBlock: {
            neg = 1
            i = 1
        }
        IfCondition Or(LessThan(RDMEM_8(s, i), 48), GreaterThan(RDMEM_8(s, i), 57)) ThenBlock: {
            SystemCall(60, 1)
        }
        mag = 0
        WhileLoop 1 {
            c = RDMEM_8(s, i)
            IfCondition Or(LessThan(c, 48), GreaterThan(c, 57)) ThenBlock: {
                BreakLoop
            }
            dig = Subtract(c, 48)
            IfCondition GreaterThan(mag, 922337203685477580) ThenBlock: {
                SystemCall(60, 1)
            }
            IfCondition EqualTo(mag, 922337203685477580) ThenBlock: {
                IfCondition EqualTo(neg, 1) ThenBlock: {
                    IfCondition GreaterThan(dig, 8) ThenBlock: {
                        SystemCall(60, 1)
                    }
                    IfCondition EqualTo(dig, 8) ThenBlock: {
                        nxt = RDMEM_8(s, Add(i, 1))
                        IfCondition And(GreaterEqual(nxt, 48), LessEqual(nxt, 57)) ThenBlock: {
                            SystemCall(60, 1)
                        }
                        ReturnValue(-9223372036854775808)
                    }
                } ElseBlock: {
                    IfCondition GreaterThan(dig, 7) ThenBlock: {
                        SystemCall(60, 1)
                    }
                }
            }
            mag = Add(Multiply(mag, 10), dig)
            i = Add(i, 1)
        }
        IfCondition EqualTo(neg, 1) ThenBlock: {
            IfCondition GreaterThan(mag, 9223372036854775807) ThenBlock: {
                IfCondition EqualTo(mag, 9223372036854775808) ThenBlock: {
                    ReturnValue(-9223372036854775808)
                }
                SystemCall(60, 1)
            }
            ReturnValue(Subtract(0, mag))
        }
        IfCondition GreaterThan(mag, 9223372036854775807) ThenBlock: {
            SystemCall(60, 1)
        }
        ReturnValue(mag)
    }
}

Function.Bump {
    Body: {
        IfCondition EqualTo(Nl.incr, -9223372036854775808) ThenBlock: {
            IfCondition LessThan(Nl.cur, 0) ThenBlock: {
                Nl.pending = 1
                ReturnValue(0)
            }
            Nl.cur = Add(Nl.cur, Nl.incr)
            ReturnValue(0)
        }
        IfCondition GreaterThan(Nl.incr, 0) ThenBlock: {
            room = Subtract(9223372036854775807, Nl.incr)
            IfCondition GreaterThan(Nl.cur, room) ThenBlock: {
                Nl.pending = 1
                ReturnValue(0)
            }
        } ElseBlock: {
            IfCondition LessThan(Nl.incr, 0) ThenBlock: {
                floor = Subtract(-9223372036854775808, Nl.incr)
                IfCondition LessThan(Nl.cur, floor) ThenBlock: {
                    Nl.pending = 1
                    ReturnValue(0)
                }
            }
        }
        Nl.cur = Add(Nl.cur, Nl.incr)
        ReturnValue(0)
    }
}

Function.WriteNum {
    Input: num: Integer
    Body: {
        raw = Allocate(32)
        neg = 0
        mag = num
        IfCondition LessThan(num, 0) ThenBlock: {
            neg = 1
            IfCondition EqualTo(num, -9223372036854775808) ThenBlock: {
                mag = 9223372036854775807
            } ElseBlock: {
                mag = Subtract(0, num)
            }
        }
        digs = Allocate(24)
        nd = 0
        IfCondition EqualTo(mag, 0) ThenBlock: {
            WRMEM_8(digs, 0, 48)
            nd = 1
        }
        WhileLoop GreaterThan(mag, 0) {
            WRMEM_8(digs, nd, Add(48, Modulo(mag, 10)))
            nd = Add(nd, 1)
            mag = Divide(mag, 10)
        }
        IfCondition And(EqualTo(num, -9223372036854775808), GreaterThan(nd, 0)) ThenBlock: {
            WRMEM_8(digs, 0, 56)
        }
        total = nd
        IfCondition EqualTo(neg, 1) ThenBlock: {
            total = Add(total, 1)
        }
        pad = 0
        IfCondition LessThan(total, Nl.width) ThenBlock: {
            pad = Subtract(Nl.width, total)
        }
        out = Allocate(64)
        o = 0
        IfCondition EqualTo(Nl.fmt, 0) ThenBlock: {
            k = 0
            WhileLoop LessThan(k, pad) {
                WRMEM_8(out, o, 32)
                o = Add(o, 1)
                k = Add(k, 1)
            }
        }
        IfCondition EqualTo(Nl.fmt, 2) ThenBlock: {
            IfCondition EqualTo(neg, 1) ThenBlock: {
                WRMEM_8(out, o, 45)
                o = Add(o, 1)
                neg = 0
            }
            k = 0
            WhileLoop LessThan(k, pad) {
                WRMEM_8(out, o, 48)
                o = Add(o, 1)
                k = Add(k, 1)
            }
        }
        IfCondition EqualTo(neg, 1) ThenBlock: {
            WRMEM_8(out, o, 45)
            o = Add(o, 1)
        }
        k = Subtract(nd, 1)
        WhileLoop GreaterEqual(k, 0) {
            WRMEM_8(out, o, RDMEM_8(digs, k))
            o = Add(o, 1)
            k = Subtract(k, 1)
        }
        IfCondition EqualTo(Nl.fmt, 1) ThenBlock: {
            k = 0
            WhileLoop LessThan(k, pad) {
                WRMEM_8(out, o, 32)
                o = Add(o, 1)
                k = Add(k, 1)
            }
        }
        WriteOut(out, o)
        Deallocate(out, 64)
        Deallocate(digs, 24)
        Deallocate(raw, 32)
        ReturnValue(0)
    }
}

Function.WriteSep {
    Input: numbered: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, Nl.seplen) {
            c = RDMEM_8(Nl.sep, i)
            IfCondition And(EqualTo(numbered, 0), EqualTo(c, 9)) ThenBlock: {
                c = 32
            }
            PutByte(c)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.WritePlain {
    Body: {
        i = 0
        WhileLoop LessThan(i, Nl.width) {
            PutByte(32)
            i = Add(i, 1)
        }
        WriteSep(0)
        ReturnValue(0)
    }
}

Function.MatchRep {
    Input: line: Address
    Input: len: Integer
    Input: rep: Integer
    Output: Integer
    Body: {
        need = Multiply(Nl.dlen, rep)
        IfCondition NotEqual(len, need) ThenBlock: {
            ReturnValue(0)
        }
        i = 0
        WhileLoop LessThan(i, len) {
            d = Modulo(i, Nl.dlen)
            IfCondition NotEqual(RDMEM_8(line, i), RDMEM_8(Nl.delim, d)) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.StyleNow {
    Output: Integer
    Body: {
        IfCondition EqualTo(Nl.sect, 0) ThenBlock: {
            ReturnValue(Nl.sh)
        }
        IfCondition EqualTo(Nl.sect, 2) ThenBlock: {
            ReturnValue(Nl.sf)
        }
        ReturnValue(Nl.sb)
    }
}

Function.EmitLine {
    Input: line: Address
    Input: len: Integer
    Body: {
        IfCondition GreaterThan(Nl.dlen, 0) ThenBlock: {
            h = MatchRep(line, len, 3)
            b = MatchRep(line, len, 2)
            f = MatchRep(line, len, 1)
            hit = 0
            IfCondition EqualTo(h, 1) ThenBlock: {
                Nl.sect = 0
                hit = 1
            }
            IfCondition EqualTo(b, 1) ThenBlock: {
                Nl.sect = 1
                hit = 1
            }
            IfCondition EqualTo(f, 1) ThenBlock: {
                Nl.sect = 2
                hit = 1
            }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                PutByte(10)
                IfCondition EqualTo(Nl.noreset, 0) ThenBlock: {
                    Nl.cur = Nl.start
                    Nl.pending = 0
                }
                ReturnValue(0)
            }
        }
        st = StyleNow()
        do_num = 0
        IfCondition EqualTo(st, 2) ThenBlock: {
            do_num = 1
        }
        IfCondition And(EqualTo(st, 1), GreaterThan(len, 0)) ThenBlock: {
            do_num = 1
        }
        IfCondition EqualTo(do_num, 1) ThenBlock: {
            IfCondition EqualTo(Nl.pending, 1) ThenBlock: {
                SystemCall(60, 1)
            }
            WriteNum(Nl.cur)
            WriteSep(1)
            IfCondition GreaterThan(len, 0) ThenBlock: {
                WriteOut(line, len)
            }
            PutByte(10)
            Bump()
        } ElseBlock: {
            WritePlain()
            IfCondition GreaterThan(len, 0) ThenBlock: {
                WriteOut(line, len)
            }
            PutByte(10)
        }
        ReturnValue(0)
    }
}

Function.ProcessFd {
    Input: fd: Integer
    Body: {
        buf = Allocate(8192)
        line = Allocate(8192)
        llen = 0
        WhileLoop 1 {
            n = SystemCall(0, fd, buf, 8192)
            IfCondition LessEqual(n, 0) ThenBlock: {
                BreakLoop
            }
            i = 0
            WhileLoop LessThan(i, n) {
                c = RDMEM_8(buf, i)
                IfCondition EqualTo(c, 10) ThenBlock: {
                    EmitLine(line, llen)
                    llen = 0
                } ElseBlock: {
                    IfCondition LessThan(llen, 8191) ThenBlock: {
                        WRMEM_8(line, llen, c)
                        llen = Add(llen, 1)
                    }
                }
                i = Add(i, 1)
            }
        }
        IfCondition GreaterThan(llen, 0) ThenBlock: {
            EmitLine(line, llen)
        }
        Deallocate(line, 8192)
        Deallocate(buf, 8192)
        ReturnValue(0)
    }
}

Function.SetStyle {
    Input: which: Integer
    Input: s: Address
    Body: {
        c = RDMEM_8(s, 0)
        v = 1
        IfCondition EqualTo(c, 110) ThenBlock: {
            v = 0
        }
        IfCondition EqualTo(c, 97) ThenBlock: {
            v = 2
        }
        IfCondition EqualTo(which, 0) ThenBlock: {
            Nl.sh = v
        }
        IfCondition EqualTo(which, 1) ThenBlock: {
            Nl.sb = v
        }
        IfCondition EqualTo(which, 2) ThenBlock: {
            Nl.sf = v
        }
        ReturnValue(0)
    }
}

Function.SetFmt {
    Input: s: Address
    Body: {
        a = RDMEM_8(s, 0)
        b = RDMEM_8(s, 1)
        IfCondition And(EqualTo(a, 108), EqualTo(b, 110)) ThenBlock: {
            Nl.fmt = 1
        }
        IfCondition And(EqualTo(a, 114), EqualTo(b, 122)) ThenBlock: {
            Nl.fmt = 2
        }
        IfCondition And(EqualTo(a, 114), EqualTo(b, 110)) ThenBlock: {
            Nl.fmt = 0
        }
        ReturnValue(0)
    }
}

Function.CopyStr {
    Input: s: Address
    Input: dest: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 64) {
            c = RDMEM_8(s, i)
            WRMEM_8(dest, i, c)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(i)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buffer = Allocate(4096)
        nread = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        IfCondition LessEqual(nread, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        Nl.nread = nread
        ReturnValue(buffer)
    }
}

SubRoutine.Main {
    Nl.sep = Allocate(64)
    WRMEM_8(Nl.sep, 0, 9)
    WRMEM_8(Nl.sep, 1, 0)
    Nl.seplen = 1
    Nl.delim = Allocate(64)
    WRMEM_8(Nl.delim, 0, 92)
    WRMEM_8(Nl.delim, 1, 58)
    WRMEM_8(Nl.delim, 2, 0)
    Nl.dlen = 2
    args = GetArgs()
    IfCondition EqualTo(args, 0) ThenBlock: {
        ProcessFd(0)
        SystemCall(60, 0)
    }
    pos = 0
    WhileLoop NotEqual(RDMEM_8(args, pos), 0) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)
    limit = Subtract(Nl.nread, 1)
    opts = 1
    files = 0
    flist = Allocate(128)
    WhileLoop LessThan(pos, limit) {
        ch = RDMEM_8(args, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            EmitLine(args, 0)
            pos = Add(pos, 1)
        } ElseBlock: {
            arg = Add(args, pos)
            WhileLoop NotEqual(RDMEM_8(args, pos), 0) {
                pos = Add(pos, 1)
            }
            pos = Add(pos, 1)
            take = 1
            IfCondition EqualTo(opts, 1) ThenBlock: {
                IfCondition EqualTo(RDMEM_8(arg, 0), 45) ThenBlock: {
                    IfCondition NotEqual(RDMEM_8(arg, 1), 0) ThenBlock: {
                        take = 0
                        kind = RDMEM_8(arg, 1)
                        rest = Add(arg, 2)
                        IfCondition EqualTo(RDMEM_8(arg, 2), 0) ThenBlock: {
                            IfCondition Or(EqualTo(kind, 115), Or(EqualTo(kind, 110), Or(EqualTo(kind, 104), Or(EqualTo(kind, 98), Or(EqualTo(kind, 102), Or(EqualTo(kind, 118), Or(EqualTo(kind, 105), EqualTo(kind, 100)))))))) ThenBlock: {
                                IfCondition LessThan(pos, limit) ThenBlock: {
                                    rest = Add(args, pos)
                                    WhileLoop NotEqual(RDMEM_8(args, pos), 0) {
                                        pos = Add(pos, 1)
                                    }
                                    pos = Add(pos, 1)
                                }
                            }
                        }
                        IfCondition EqualTo(kind, 112) ThenBlock: {
                            Nl.noreset = 1
                        }
                        IfCondition EqualTo(kind, 115) ThenBlock: {
                            Nl.seplen = CopyStr(rest, Nl.sep)
                        }
                        IfCondition EqualTo(kind, 110) ThenBlock: {
                            SetFmt(rest)
                        }
                        IfCondition EqualTo(kind, 104) ThenBlock: {
                            SetStyle(0, rest)
                        }
                        IfCondition EqualTo(kind, 98) ThenBlock: {
                            SetStyle(1, rest)
                        }
                        IfCondition EqualTo(kind, 102) ThenBlock: {
                            SetStyle(2, rest)
                        }
                        IfCondition EqualTo(kind, 118) ThenBlock: {
                            Nl.start = ParseNum(rest)
                            Nl.cur = Nl.start
                        }
                        IfCondition EqualTo(kind, 105) ThenBlock: {
                            Nl.incr = ParseNum(rest)
                        }
                        IfCondition EqualTo(kind, 100) ThenBlock: {
                            Nl.dlen = CopyStr(rest, Nl.delim)
                            IfCondition EqualTo(Nl.dlen, 1) ThenBlock: {
                                WRMEM_8(Nl.delim, 1, 58)
                                WRMEM_8(Nl.delim, 2, 0)
                                Nl.dlen = 2
                            }
                        }
                        IfCondition EqualTo(kind, 119) ThenBlock: {
                            Nl.width = ParseNum(rest)
                        }
                    }
                }
            }
            IfCondition EqualTo(take, 1) ThenBlock: {
                WRMEM_64(flist, Multiply(files, 8), arg)
                files = Add(files, 1)
                opts = 0
            }
        }
    }
    IfCondition EqualTo(files, 0) ThenBlock: {
        ProcessFd(0)
    } ElseBlock: {
        fi = 0
        WhileLoop LessThan(fi, files) {
            farg = RDMEM_64(flist, Multiply(fi, 8))
            fd = SystemCall(2, farg, 0, 0)
            IfCondition LessThan(fd, 0) ThenBlock: {
                SystemCall(60, 1)
            }
            ProcessFd(fd)
            SystemCall(3, fd)
            fi = Add(fi, 1)
        }
    }
    SystemCall(60, 0)
}

RunTask(Main)
