// printenv.ailang - Print environment variable
// Usage: printenv [VARIABLE]

LibraryImport.Arena

Function.WriteStdout {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 1, buffer, len)
    }
}

Function.GetEnvVar {
    Input: var_name: Address
    Output: Address
    Body: {
        fd = SystemCall(2, "/proc/self/environ", 0, 0)
        
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(65536)
        bytes_read = SystemCall(0, fd, buffer, 65536)
        SystemCall(3, fd)
        
        var_len = StringLength(var_name)
        
        // Scan for VAR=value
        i = 0
        WhileLoop LessThan(i, bytes_read) {
            // Check if this entry matches
            match = 1
            j = 0
            WhileLoop LessThan(j, var_len) {
                IfCondition NotEqual(RDMEM_8(buffer, Add(i, j)), RDMEM_8(var_name, j)) ThenBlock: {
                    match = 0
                    BreakLoop
                }
                j = Add(j, 1)
            }
            
            // Check for '=' after var name
            IfCondition EqualTo(match, 1) ThenBlock: {
                IfCondition EqualTo(RDMEM_8(buffer, Add(i, var_len)), 61) ThenBlock: {
                    // Found it! Return pointer to value
                    ReturnValue(Add(buffer, Add(Add(i, var_len), 1)))
                }
            }
            
            // Skip to next null
            WhileLoop And(LessThan(i, bytes_read), NotEqual(RDMEM_8(buffer, i), 0)) {
                i = Add(i, 1)
            }
            i = Add(i, 1)
        }
        
        Deallocate(buffer, 65536)
        ReturnValue(0)
    }
}

// No name: print every variable, one per line. environ is NUL-separated.
Function.PrintAllEnv {
    Body: {
        fd = SystemCall(2, "/proc/self/environ", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            SystemCall(60, 1)
        }
        buffer = Allocate(65536)
        bytes_read = SystemCall(0, fd, buffer, 65536)
        SystemCall(3, fd)
        i = 0
        line_start = 0
        WhileLoop LessThan(i, bytes_read) {
            ch = RDMEM_8(buffer, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                len = Subtract(i, line_start)
                IfCondition GreaterThan(len, 0) ThenBlock: {
                    WriteStdout(Add(buffer, line_start), len)
                    WriteStdout("\n", 1)
                }
                line_start = Add(i, 1)
            }
            i = Add(i, 1)
        }
        Deallocate(buffer, 65536)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        ReturnValue(buffer)
    }
}

SubRoutine.Main {
    args_buffer = GetArgs()
    
    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        SystemCall(60, 1)
    }
    
    // Skip program name
    pos = 0
    WhileLoop NotEqual(RDMEM_8(args_buffer, pos), 0) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)
    
    saw_name = 0
    failed = 0
    options_done = 0

    WhileLoop LessThan(pos, 4096) {
        ch = RDMEM_8(args_buffer, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            BreakLoop
        }

        var_start = pos
        var_len = 0
        WhileLoop And(LessThan(pos, 4096), NotEqual(RDMEM_8(args_buffer, pos), 0)) {
            var_len = Add(var_len, 1)
            pos = Add(pos, 1)
        }

        var_name = Allocate(Add(var_len, 1))
        i = 0
        WhileLoop LessThan(i, var_len) {
            WRMEM_8(var_name, i, RDMEM_8(args_buffer, Add(var_start, i)))
            i = Add(i, 1)
        }
        WRMEM_8(var_name, var_len, 0)

        is_dd = 0
        IfCondition EqualTo(var_len, 2) ThenBlock: {
            IfCondition EqualTo(RDMEM_8(var_name, 0), 45) ThenBlock: {
                IfCondition EqualTo(RDMEM_8(var_name, 1), 45) ThenBlock: {
                    is_dd = 1
                }
            }
        }
        IfCondition EqualTo(options_done, 0) ThenBlock: {
            IfCondition EqualTo(is_dd, 1) ThenBlock: {
                options_done = 1
                Deallocate(var_name, Add(var_len, 1))
                pos = Add(pos, 1)
                ContinueLoop
            }
        }

        saw_name = 1
        has_eq = 0
        k = 0
        WhileLoop LessThan(k, var_len) {
            IfCondition EqualTo(RDMEM_8(var_name, k), 61) ThenBlock: {
                has_eq = 1
            }
            k = Add(k, 1)
        }
        IfCondition EqualTo(has_eq, 1) ThenBlock: {
            failed = 1
        } ElseBlock: {
            value = GetEnvVar(var_name)
            IfCondition EqualTo(value, 0) ThenBlock: {
                failed = 1
            } ElseBlock: {
                vlen = 0
                WhileLoop NotEqual(RDMEM_8(value, vlen), 0) {
                    vlen = Add(vlen, 1)
                }
                WriteStdout(value, vlen)
                WriteStdout("\n", 1)
            }
        }
        Deallocate(var_name, Add(var_len, 1))
        pos = Add(pos, 1)
    }

    Deallocate(args_buffer, 4096)

    IfCondition EqualTo(saw_name, 0) ThenBlock: {
        PrintAllEnv()
    }

    SystemCall(60, failed)
}

RunTask(Main)