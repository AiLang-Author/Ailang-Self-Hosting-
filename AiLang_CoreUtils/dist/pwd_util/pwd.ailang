// pwd.ailang - Print the working directory.
// Default is physical. -L, --logical, and POSIXLY_CORRECT use $PWD
// when that path is absolute, has no "." or ".." component, and names
// the same directory as ".".
LibraryImport.Arena

FixedPool.PwdState {
    "args_len": Initialize=0
    "logical":  Initialize=0
    "path_buf": Initialize=0
    "dot_stat": Initialize=0
    "ent_stat": Initialize=0
}

Function.WriteAll {
    Input: buf: Address
    Input: len: Integer
    Body: {
        n = SystemCall(1, 1, buf, len)
        IfCondition LessThan(n, len) ThenBlock: {
            SystemCall(60, 1)
        }
    }
}

Function.FindEnv {
    Input: buf: Address
    Input: n: Integer
    Input: key: Address
    Output: Address
    Body: {
        keylen = StringLength(key)
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            match = 1
            j = 0
            WhileLoop LessThan(j, keylen) {
                at = Add(i, j)
                a = RDMEM_8(buf, at)
                b = RDMEM_8(key, j)
                IfCondition NotEqual(a, b) ThenBlock: {
                    match = 0
                    j = keylen
                } ElseBlock: {
                    j = Add(j, one)
                }
            }
            IfCondition EqualTo(match, 1) ThenBlock: {
                eqat = Add(i, keylen)
                eq = RDMEM_8(buf, eqat)
                IfCondition EqualTo(eq, 61) ThenBlock: {
                    val = Add(buf, eqat)
                    val = Add(val, one)
                    ReturnValue(val)
                }
            }
            WhileLoop And(LessThan(i, n), NotEqual(RDMEM_8(buf, i), 0)) {
                i = Add(i, one)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.LoadEnv {
    Output: Address
    Body: {
        fd = SystemCall(2, "/proc/self/environ", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf = Allocate(65536)
        n = SystemCall(0, fd, buf, 65535)
        SystemCall(3, fd)
        IfCondition LessThan(n, 0) ThenBlock: {
            n = 0
        }
        WRMEM_8(buf, n, 0)
        PwdState.args_len = n
        ReturnValue(buf)
    }
}

Function.PwdTextOk {
    Input: wd: Address
    Output: Integer
    Body: {
        first = RDMEM_8(wd, 0)
        IfCondition NotEqual(first, 47) ThenBlock: {
            ReturnValue(0)
        }
        len = StringLength(wd)
        i = 0
        one = 1
        WhileLoop LessThan(i, len) {
            c = RDMEM_8(wd, i)
            nxt = Add(i, one)
            IfCondition And(EqualTo(c, 47), LessThan(nxt, len)) ThenBlock: {
                nch = RDMEM_8(wd, nxt)
                IfCondition EqualTo(nch, 46) ThenBlock: {
                    i2 = Add(i, 2)
                    b2 = 0
                    past2 = 1
                    IfCondition LessThan(i2, len) ThenBlock: {
                        b2 = RDMEM_8(wd, i2)
                        past2 = 0
                    }
                    bad = 0
                    IfCondition EqualTo(past2, 1) ThenBlock: { bad = 1 }
                    IfCondition EqualTo(b2, 47) ThenBlock: { bad = 1 }
                    IfCondition EqualTo(b2, 46) ThenBlock: {
                        i3 = Add(i, 3)
                        b3 = 0
                        past3 = 1
                        IfCondition LessThan(i3, len) ThenBlock: {
                            b3 = RDMEM_8(wd, i3)
                            past3 = 0
                        }
                        IfCondition EqualTo(past3, 1) ThenBlock: { bad = 1 }
                        IfCondition EqualTo(b3, 47) ThenBlock: { bad = 1 }
                    }
                    IfCondition EqualTo(bad, 1) ThenBlock: {
                        ReturnValue(0)
                    }
                }
            }
            i = Add(i, one)
        }
        ReturnValue(1)
    }
}

Function.SameAsDot {
    Input: path: Address
    Output: Integer
    Body: {
        a = Allocate(256)
        b = Allocate(256)
        ra = SystemCall(4, path, a)
        rb = SystemCall(4, ".", b)
        same = 0
        IfCondition And(GreaterEqual(ra, 0), GreaterEqual(rb, 0)) ThenBlock: {
            same = 1
            i = 0
            one = 1
            WhileLoop LessThan(i, 16) {
                ba = RDMEM_8(a, i)
                bb = RDMEM_8(b, i)
                IfCondition NotEqual(ba, bb) ThenBlock: {
                    same = 0
                    i = 16
                } ElseBlock: {
                    i = Add(i, one)
                }
            }
        }
        Deallocate(a, 256)
        Deallocate(b, 256)
        ReturnValue(same)
    }
}

Function.EqBytes {
    Input: a: Address
    Input: aoff: Integer
    Input: b: Address
    Input: boff: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        i = 0
        one = 1
        same = 1
        go = 1
        WhileLoop And(LessThan(i, n), EqualTo(go, 1)) {
            ia = Add(aoff, i)
            ib = Add(boff, i)
            ca = RDMEM_8(a, ia)
            cb = RDMEM_8(b, ib)
            IfCondition NotEqual(ca, cb) ThenBlock: {
                same = 0
                go = 0
            } ElseBlock: {
                i = Add(i, one)
            }
        }
        ReturnValue(same)
    }
}

Function.Copy16 {
    Input: dst: Address
    Input: src: Address
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, 16) {
            c = RDMEM_8(src, i)
            c = BitwiseAnd(c, 255)
            WRMEM_8(dst, i, c)
            i = Add(i, one)
        }
    }
}

Function.PrependComp {
    Input: start: Integer
    Input: name: Address
    Input: nlen: Integer
    Output: Integer
    Body: {
        need = Add(nlen, 1)
        IfCondition LessThan(start, need) ThenBlock: {
            ReturnValue(-1)
        }
        start = Subtract(start, need)
        buf = PwdState.path_buf
        WRMEM_8(buf, start, 47)
        i = 0
        one = 1
        WhileLoop LessThan(i, nlen) {
            c = RDMEM_8(name, i)
            c = BitwiseAnd(c, 255)
            at = Add(start, one)
            at = Add(at, i)
            WRMEM_8(buf, at, c)
            i = Add(i, one)
        }
        ReturnValue(start)
    }
}

Function.EntryMatches {
    Input: dent: Address
    Input: use_lstat: Integer
    Output: Integer
    Body: {
        dot = PwdState.dot_stat
        ent = PwdState.ent_stat
        i = 0
        one = 1
        zero = 1
        WhileLoop LessThan(i, 8) {
            c = RDMEM_8(dent, i)
            c = BitwiseAnd(c, 255)
            IfCondition NotEqual(c, 0) ThenBlock: {
                zero = 0
                i = 8
            } ElseBlock: {
                i = Add(i, one)
            }
        }
        need = use_lstat
        IfCondition EqualTo(zero, 1) ThenBlock: {
            need = 1
        }
        IfCondition EqualTo(need, 1) ThenBlock: {
            name = Add(dent, 19)
            rc = SystemCall(6, name, ent)
            IfCondition LessThan(rc, 0) ThenBlock: {
                ReturnValue(0)
            }
            same = EqBytes(ent, 0, dot, 0, 16)
            ReturnValue(same)
        }
        same = EqBytes(dent, 0, dot, 8, 8)
        ReturnValue(same)
    }
}

Function.ScanBatch {
    Input: dbuf: Address
    Input: nread: Integer
    Input: use_lstat: Integer
    Input: start: Integer
    Output: Integer
    Body: {
        off = 0
        hit = -1
        WhileLoop And(LessThan(off, nread), EqualTo(hit, -1)) {
            entry = Add(dbuf, off)
            lo = RDMEM_8(entry, 16)
            lo = BitwiseAnd(lo, 255)
            hi = RDMEM_8(entry, 17)
            hi = BitwiseAnd(hi, 255)
            reclen = Add(lo, Multiply(hi, 256))
            IfCondition LessEqual(reclen, 19) ThenBlock: {
                hit = -2
            } ElseBlock: {
                name = Add(entry, 19)
                skip = 0
                c0 = RDMEM_8(name, 0)
                c0 = BitwiseAnd(c0, 255)
                IfCondition EqualTo(c0, 46) ThenBlock: {
                    c1 = RDMEM_8(name, 1)
                    c1 = BitwiseAnd(c1, 255)
                    IfCondition EqualTo(c1, 0) ThenBlock: {
                        skip = 1
                    }
                    IfCondition EqualTo(c1, 46) ThenBlock: {
                        c2 = RDMEM_8(name, 2)
                        c2 = BitwiseAnd(c2, 255)
                        IfCondition EqualTo(c2, 0) ThenBlock: {
                            skip = 1
                        }
                    }
                }
                IfCondition EqualTo(skip, 0) ThenBlock: {
                    matched = EntryMatches(entry, use_lstat)
                    IfCondition EqualTo(matched, 1) ThenBlock: {
                        nlen = StringLength(name)
                        ns = PrependComp(start, name, nlen)
                        hit = ns
                        IfCondition LessThan(ns, 0) ThenBlock: {
                            hit = -2
                        }
                    }
                }
                off = Add(off, reclen)
            }
        }
        ReturnValue(hit)
    }
}

Function.FindInParent {
    Input: fd: Integer
    Input: use_lstat: Integer
    Input: start: Integer
    Output: Integer
    Body: {
        dbuf = Allocate(8192)
        found = -1
        nread = SystemCall(217, fd, dbuf, 8192)
        WhileLoop And(EqualTo(found, -1), GreaterThan(nread, 0)) {
            got = ScanBatch(dbuf, nread, use_lstat, start)
            IfCondition GreaterEqual(got, 0) ThenBlock: {
                found = got
            } ElseBlock: {
                IfCondition LessThan(got, -1) ThenBlock: {
                    found = got
                } ElseBlock: {
                    nread = SystemCall(217, fd, dbuf, 8192)
                }
            }
        }
        Deallocate(dbuf, 8192)
        ReturnValue(found)
    }
}

Function.RobustPwd {
    Output: Address
    Body: {
        cap = 65536
        path = Allocate(cap)
        last = Subtract(cap, 1)
        WRMEM_8(path, last, 0)
        start = last
        dot = Allocate(256)
        root = Allocate(256)
        parent = Allocate(256)
        ent = Allocate(256)
        PwdState.path_buf = path
        PwdState.dot_stat = dot
        PwdState.ent_stat = ent
        ra = SystemCall(4, ".", dot)
        rb = SystemCall(4, "/", root)
        IfCondition Or(LessThan(ra, 0), LessThan(rb, 0)) ThenBlock: {
            ReturnValue(0)
        }
        height = 0
        one = 1
        done = 0
        WhileLoop EqualTo(done, 0) {
            same = EqBytes(dot, 0, root, 0, 16)
            IfCondition EqualTo(same, 1) ThenBlock: {
                done = 1
            } ElseBlock: {
                IfCondition GreaterThan(height, 8192) ThenBlock: {
                    ReturnValue(0)
                }
                fd = SystemCall(257, -100, "..", 65536, 0)
                IfCondition LessThan(fd, 0) ThenBlock: {
                    ReturnValue(0)
                }
                rc = SystemCall(81, fd)
                IfCondition LessThan(rc, 0) ThenBlock: {
                    SystemCall(3, fd)
                    ReturnValue(0)
                }
                rc = SystemCall(5, fd, parent)
                IfCondition LessThan(rc, 0) ThenBlock: {
                    SystemCall(3, fd)
                    ReturnValue(0)
                }
                use_lstat = 0
                devsame = EqBytes(parent, 0, dot, 0, 8)
                IfCondition EqualTo(devsame, 0) ThenBlock: {
                    use_lstat = 1
                }
                ns = FindInParent(fd, use_lstat, start)
                SystemCall(3, fd)
                IfCondition LessThan(ns, 0) ThenBlock: {
                    ReturnValue(0)
                }
                start = ns
                Copy16(dot, parent)
                height = Add(height, one)
            }
        }
        c0 = RDMEM_8(path, start)
        IfCondition EqualTo(c0, 0) ThenBlock: {
            start = PrependComp(start, path, 0)
        }
        IfCondition LessThan(start, 0) ThenBlock: {
            ReturnValue(0)
        }
        ret = Add(path, start)
        ReturnValue(ret)
    }
}

Function.PhysicalPwd {
    Output: Address
    Body: {
        size = 4096
        done = 0
        buf = 0
        WhileLoop EqualTo(done, 0) {
            trial = Allocate(size)
            rc = SystemCall(79, trial, size)
            IfCondition GreaterThan(rc, 0) ThenBlock: {
                buf = trial
                done = 1
            } ElseBlock: {
                Deallocate(trial, size)
                grow = 0
                IfCondition EqualTo(rc, -34) ThenBlock: {
                    IfCondition LessThan(size, 1048576) ThenBlock: {
                        grow = 1
                    }
                }
                IfCondition EqualTo(grow, 1) ThenBlock: {
                    size = Multiply(size, 2)
                } ElseBlock: {
                    done = 1
                }
            }
        }
        IfCondition EqualTo(buf, 0) ThenBlock: {
            alt = RobustPwd()
            ReturnValue(alt)
        }
        ReturnValue(buf)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf = Allocate(8192)
        n = SystemCall(0, fd, buf, 8191)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 8192)
            ReturnValue(0)
        }
        WRMEM_8(buf, n, 0)
        PwdState.args_len = n
        ReturnValue(buf)
    }
}

SubRoutine.Main {
    env = LoadEnv()
    env_n = PwdState.args_len
    logical = 0
    IfCondition NotEqual(env, 0) ThenBlock: {
        posix = FindEnv(env, env_n, "POSIXLY_CORRECT")
        IfCondition NotEqual(posix, 0) ThenBlock: {
            logical = 1
        }
    }

    args = GetArgs()
    IfCondition NotEqual(args, 0) ThenBlock: {
        alen = PwdState.args_len
        pos = 0
        one = 1
        WhileLoop NotEqual(RDMEM_8(args, pos), 0) {
            pos = Add(pos, one)
        }
        pos = Add(pos, one)
        end_opts = 0
        WhileLoop LessThan(pos, alen) {
            ch = RDMEM_8(args, pos)
            ch = BitwiseAnd(ch, 255)
            is_opt = 0
            IfCondition And(EqualTo(end_opts, 0), EqualTo(ch, 45)) ThenBlock: {
                is_opt = 1
            }
            IfCondition EqualTo(is_opt, 1) ThenBlock: {
                n1p = Add(pos, one)
                n1 = RDMEM_8(args, n1p)
                n1 = BitwiseAnd(n1, 255)
                IfCondition EqualTo(n1, 45) ThenBlock: {
                    argp = Add(args, pos)
                    IfCondition StringEquals(argp, "--") ThenBlock: {
                        end_opts = 1
                    }
                    IfCondition StringEquals(argp, "--logical") ThenBlock: {
                        logical = 1
                    }
                    IfCondition StringEquals(argp, "--physical") ThenBlock: {
                        logical = 0
                    }
                    WhileLoop NotEqual(RDMEM_8(args, pos), 0) {
                        pos = Add(pos, one)
                    }
                    pos = Add(pos, one)
                } ElseBlock: {
                    pos = Add(pos, one)
                    done = 0
                    WhileLoop EqualTo(done, 0) {
                        f = RDMEM_8(args, pos)
                        f = BitwiseAnd(f, 255)
                        IfCondition EqualTo(f, 0) ThenBlock: {
                            pos = Add(pos, one)
                            done = 1
                        } ElseBlock: {
                            IfCondition EqualTo(f, 76) ThenBlock: {
                                logical = 1
                            }
                            IfCondition EqualTo(f, 80) ThenBlock: {
                                logical = 0
                            }
                            pos = Add(pos, one)
                        }
                    }
                }
            } ElseBlock: {
                WhileLoop And(LessThan(pos, alen), NotEqual(RDMEM_8(args, pos), 0)) {
                    pos = Add(pos, one)
                }
                pos = Add(pos, one)
            }
        }
    }

    printed = 0
    IfCondition EqualTo(logical, 1) ThenBlock: {
        IfCondition NotEqual(env, 0) ThenBlock: {
            wd = FindEnv(env, env_n, "PWD")
            IfCondition NotEqual(wd, 0) ThenBlock: {
                ok = PwdTextOk(wd)
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    same = SameAsDot(wd)
                    IfCondition EqualTo(same, 1) ThenBlock: {
                        wlen = StringLength(wd)
                        WriteAll(wd, wlen)
                        WriteAll("\n", 1)
                        printed = 1
                    }
                }
            }
        }
    }
    IfCondition EqualTo(printed, 0) ThenBlock: {
        phys = PhysicalPwd()
        IfCondition EqualTo(phys, 0) ThenBlock: {
            SystemCall(60, 1)
        }
        plen = StringLength(phys)
        WriteAll(phys, plen)
        WriteAll("\n", 1)
    }
    SystemCall(60, 0)
}

RunTask(Main)
