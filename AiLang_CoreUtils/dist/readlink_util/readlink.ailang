// readlink.ailang - GNU readlink.
// No flags: one readlink(2), quiet on errors.
// -f / -e / -m canonicalize. -n drops the delimiter for one operand.
// -z uses NUL. -v prints "readlink: PATH: strerror".
LibraryImport.Arena

FixedPool.Rl {
    "existing": Initialize=0
    "missing":  Initialize=0
    "verbose":  Initialize=0
    "err":      Initialize=0
    "cwd":      Initialize=0
    "cwdn":     Initialize=0
}

Function.WriteStdout {
    Input: buf: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 1, buf, len)
    }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.WriteErrno {
    Input: en: Integer
    Body: {
        IfCondition EqualTo(en, 2) ThenBlock: {
            WriteStderr("No such file or directory")
        }
        IfCondition EqualTo(en, 13) ThenBlock: {
            WriteStderr("Permission denied")
        }
        IfCondition EqualTo(en, 20) ThenBlock: {
            WriteStderr("Not a directory")
        }
        IfCondition EqualTo(en, 22) ThenBlock: {
            WriteStderr("Invalid argument")
        }
        IfCondition EqualTo(en, 36) ThenBlock: {
            WriteStderr("File name too long")
        }
        IfCondition EqualTo(en, 40) ThenBlock: {
            WriteStderr("Too many levels of symbolic links")
        }
        known = 0
        IfCondition EqualTo(en, 2) ThenBlock: { known = 1 }
        IfCondition EqualTo(en, 13) ThenBlock: { known = 1 }
        IfCondition EqualTo(en, 20) ThenBlock: { known = 1 }
        IfCondition EqualTo(en, 22) ThenBlock: { known = 1 }
        IfCondition EqualTo(en, 36) ThenBlock: { known = 1 }
        IfCondition EqualTo(en, 40) ThenBlock: { known = 1 }
        IfCondition EqualTo(known, 0) ThenBlock: {
            WriteStderr("Unknown error")
        }
    }
}

Function.Report {
    Input: path: Address
    Body: {
        IfCondition EqualTo(Rl.verbose, 1) ThenBlock: {
            WriteStderr("readlink: ")
            WriteStderr(path)
            WriteStderr(": ")
            WriteErrno(Rl.err)
            WriteStderr("\n")
        }
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buffer = Allocate(8192)
        n = SystemCall(0, fd, buffer, 8191)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buffer, 8192)
            ReturnValue(0)
        }
        WRMEM_8(buffer, n, 0)
        ReturnValue(buffer)
    }
}

Function.SkipArg {
    Input: args: Address
    Input: pos: Integer
    Output: Integer
    Body: {
        i = pos
        one = 1
        WhileLoop NotEqual(RDMEM_8(args, i), 0) {
            i = Add(i, one)
        }
        i = Add(i, one)
        ReturnValue(i)
    }
}

Function.LoadCwd {
    Body: {
        buf = Allocate(4096)
        n = SystemCall(89, "/proc/self/cwd", buf, 4095)
        IfCondition LessEqual(n, 0) ThenBlock: {
            n = SystemCall(79, buf, 4096)
        }
        IfCondition LessEqual(n, 0) ThenBlock: {
            WRMEM_8(buf, 0, 47)
            n = 1
        }
        WRMEM_8(buf, n, 0)
        Rl.cwd = buf
        Rl.cwdn = n
    }
}

Function.PopComp {
    Input: out: Address
    Input: olen: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(olen, 1) ThenBlock: {
            WRMEM_8(out, 0, 47)
            WRMEM_8(out, 1, 0)
            ReturnValue(1)
        }
        j = olen
        one = 1
        j = Subtract(j, one)
        go = 1
        WhileLoop And(GreaterThan(j, 0), EqualTo(go, 1)) {
            ch = RDMEM_8(out, j)
            IfCondition EqualTo(ch, 47) ThenBlock: {
                go = 0
            } ElseBlock: {
                j = Subtract(j, one)
            }
        }
        IfCondition EqualTo(j, 0) ThenBlock: {
            WRMEM_8(out, 1, 0)
            ReturnValue(1)
        }
        WRMEM_8(out, j, 0)
        ReturnValue(j)
    }
}

Function.AppendComp {
    Input: out: Address
    Input: olen: Integer
    Input: comp: Address
    Input: clen: Integer
    Output: Integer
    Body: {
        one = 1
        at = olen
        slash = 1
        IfCondition EqualTo(olen, 1) ThenBlock: {
            c0 = RDMEM_8(out, 0)
            IfCondition EqualTo(c0, 47) ThenBlock: {
                slash = 0
            }
        }
        IfCondition EqualTo(slash, 1) ThenBlock: {
            IfCondition GreaterThan(at, 4094) ThenBlock: {
                ReturnValue(-1)
            }
            WRMEM_8(out, at, 47)
            at = Add(at, one)
        }
        k = 0
        WhileLoop LessThan(k, clen) {
            IfCondition GreaterThan(at, 4094) ThenBlock: {
                ReturnValue(-1)
            }
            ck = RDMEM_8(comp, k)
            ck = BitwiseAnd(ck, 255)
            WRMEM_8(out, at, ck)
            at = Add(at, one)
            k = Add(k, one)
        }
        WRMEM_8(out, at, 0)
        ReturnValue(at)
    }
}

Function.RestKind {
    Input: src: Address
    Input: si: Integer
    Output: Integer
    Body: {
        i = si
        one = 1
        saw = 0
        go = 1
        WhileLoop EqualTo(go, 1) {
            ch = RDMEM_8(src, i)
            ch = BitwiseAnd(ch, 255)
            IfCondition EqualTo(ch, 47) ThenBlock: {
                saw = 1
                i = Add(i, one)
            } ElseBlock: {
                go = 0
            }
        }
        ch = RDMEM_8(src, i)
        ch = BitwiseAnd(ch, 255)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(saw)
        }
        ReturnValue(2)
    }
}

Function.Canon {
    Input: path: Address
    Output: Address
    Body: {
        out = Allocate(4096)
        comp = Allocate(256)
        one = 1
        olen = 0
        si = 0
        src = path
        owned = 0
        follows = 0
        Rl.err = 22
        IfCondition EqualTo(RDMEM_8(path, 0), 0) ThenBlock: {
            Deallocate(comp, 256)
            Deallocate(out, 4096)
            ReturnValue(0)
        }
        IfCondition EqualTo(RDMEM_8(path, 0), 47) ThenBlock: {
            WRMEM_8(out, 0, 47)
            WRMEM_8(out, 1, 0)
            olen = 1
            si = 1
            go = 1
            WhileLoop EqualTo(go, 1) {
                ch = RDMEM_8(src, si)
                ch = BitwiseAnd(ch, 255)
                IfCondition EqualTo(ch, 47) ThenBlock: {
                    si = Add(si, one)
                } ElseBlock: {
                    go = 0
                }
            }
        } ElseBlock: {
            k = 0
            WhileLoop LessThan(k, Rl.cwdn) {
                WRMEM_8(out, k, RDMEM_8(Rl.cwd, k))
                k = Add(k, one)
            }
            olen = Rl.cwdn
            WRMEM_8(out, olen, 0)
        }
        guard = 0
        done = 0
        failed = 0
        WhileLoop And(EqualTo(done, 0), EqualTo(failed, 0)) {
            guard = Add(guard, one)
            IfCondition GreaterThan(guard, 4096) ThenBlock: {
                Rl.err = 40
                failed = 1
            }
            IfCondition EqualTo(failed, 0) ThenBlock: {
                ch = RDMEM_8(src, si)
                ch = BitwiseAnd(ch, 255)
                IfCondition EqualTo(ch, 0) ThenBlock: {
                    done = 1
                }
                IfCondition EqualTo(ch, 47) ThenBlock: {
                    si = Add(si, one)
                }
                IfCondition And(NotEqual(ch, 0), NotEqual(ch, 47)) ThenBlock: {
                    clen = 0
                    taking = 1
                    WhileLoop EqualTo(taking, 1) {
                        c2 = RDMEM_8(src, si)
                        c2 = BitwiseAnd(c2, 255)
                        IfCondition EqualTo(c2, 0) ThenBlock: {
                            taking = 0
                        }
                        IfCondition EqualTo(c2, 47) ThenBlock: {
                            taking = 0
                        }
                        IfCondition EqualTo(taking, 1) ThenBlock: {
                            IfCondition GreaterThan(clen, 254) ThenBlock: {
                                Rl.err = 36
                                failed = 1
                                taking = 0
                            } ElseBlock: {
                                WRMEM_8(comp, clen, c2)
                                clen = Add(clen, one)
                                si = Add(si, one)
                            }
                        }
                    }
                    WRMEM_8(comp, clen, 0)
                    dot = 0
                    dotdot = 0
                    IfCondition EqualTo(clen, 1) ThenBlock: {
                        IfCondition EqualTo(RDMEM_8(comp, 0), 46) ThenBlock: {
                            dot = 1
                        }
                    }
                    IfCondition EqualTo(clen, 2) ThenBlock: {
                        c0 = RDMEM_8(comp, 0)
                        c1 = RDMEM_8(comp, 1)
                        IfCondition And(EqualTo(c0, 46), EqualTo(c1, 46)) ThenBlock: {
                            dotdot = 1
                        }
                    }
                    IfCondition EqualTo(dotdot, 1) ThenBlock: {
                        olen = PopComp(out, olen)
                    }
                    IfCondition And(EqualTo(dot, 0), EqualTo(dotdot, 0)) ThenBlock: {
                        IfCondition EqualTo(failed, 0) ThenBlock: {
                            rest = RestKind(src, si)
                            old = olen
                            nlen = AppendComp(out, olen, comp, clen)
                            IfCondition LessThan(nlen, 0) ThenBlock: {
                                Rl.err = 36
                                failed = 1
                            } ElseBlock: {
                                olen = nlen
                                sb = Allocate(256)
                                st = SystemCall(6, out, sb)
                                kind = 0
                                IfCondition GreaterEqual(st, 0) ThenBlock: {
                                    mode = RDMEM_64(sb, 24)
                                    bits = BitwiseAnd(mode, 61440)
                                    kind = 3
                                    IfCondition EqualTo(bits, 40960) ThenBlock: {
                                        kind = 1
                                    }
                                    IfCondition EqualTo(bits, 16384) ThenBlock: {
                                        kind = 2
                                    }
                                }
                                Deallocate(sb, 256)
                                IfCondition LessThan(st, 0) ThenBlock: {
                                    en = Subtract(0, st)
                                    allow = 0
                                    IfCondition EqualTo(Rl.missing, 1) ThenBlock: {
                                        IfCondition EqualTo(en, 2) ThenBlock: {
                                            allow = 1
                                        }
                                        IfCondition EqualTo(en, 20) ThenBlock: {
                                            allow = 1
                                        }
                                    }
                                    IfCondition EqualTo(Rl.existing, 0) ThenBlock: {
                                        IfCondition EqualTo(Rl.missing, 0) ThenBlock: {
                                            IfCondition EqualTo(en, 2) ThenBlock: {
                                                IfCondition NotEqual(rest, 2) ThenBlock: {
                                                    allow = 1
                                                }
                                            }
                                        }
                                    }
                                    IfCondition EqualTo(allow, 0) ThenBlock: {
                                        olen = old
                                        WRMEM_8(out, olen, 0)
                                        Rl.err = en
                                        failed = 1
                                    }
                                }
                                IfCondition EqualTo(kind, 1) ThenBlock: {
                                    IfCondition GreaterEqual(follows, 40) ThenBlock: {
                                        IfCondition EqualTo(Rl.missing, 1) ThenBlock: {
                                            kind = 3
                                        } ElseBlock: {
                                            olen = old
                                            WRMEM_8(out, olen, 0)
                                            Rl.err = 40
                                            failed = 1
                                        }
                                    } ElseBlock: {
                                        linkb = Allocate(4096)
                                        ln = SystemCall(89, out, linkb, 4095)
                                        olen = old
                                        WRMEM_8(out, olen, 0)
                                        IfCondition LessThan(ln, 0) ThenBlock: {
                                            Rl.err = Subtract(0, ln)
                                            failed = 1
                                            Deallocate(linkb, 4096)
                                        } ElseBlock: {
                                            follows = Add(follows, one)
                                            restp = Add(src, si)
                                            rn = StringLength(restp)
                                            nb = Allocate(8192)
                                            MemoryCopy(nb, linkb, ln)
                                            MemoryCopy(Add(nb, ln), restp, rn)
                                            WRMEM_8(nb, Add(ln, rn), 0)
                                            Deallocate(linkb, 4096)
                                            IfCondition EqualTo(owned, 1) ThenBlock: {
                                                Deallocate(src, 8192)
                                            }
                                            src = nb
                                            owned = 1
                                            si = 0
                                            IfCondition EqualTo(RDMEM_8(src, 0), 47) ThenBlock: {
                                                WRMEM_8(out, 0, 47)
                                                WRMEM_8(out, 1, 0)
                                                olen = 1
                                                si = 1
                                                go2 = 1
                                                WhileLoop EqualTo(go2, 1) {
                                                    sch = RDMEM_8(src, si)
                                                    sch = BitwiseAnd(sch, 255)
                                                    IfCondition EqualTo(sch, 47) ThenBlock: {
                                                        si = Add(si, one)
                                                    } ElseBlock: {
                                                        go2 = 0
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                IfCondition EqualTo(kind, 3) ThenBlock: {
                                    IfCondition EqualTo(Rl.missing, 0) ThenBlock: {
                                        bad = 0
                                        IfCondition EqualTo(rest, 2) ThenBlock: {
                                            bad = 1
                                        }
                                        IfCondition EqualTo(rest, 1) ThenBlock: {
                                            bad = 1
                                        }
                                        IfCondition EqualTo(bad, 1) ThenBlock: {
                                            olen = old
                                            WRMEM_8(out, olen, 0)
                                            Rl.err = 20
                                            failed = 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(owned, 1) ThenBlock: {
            Deallocate(src, 8192)
        }
        Deallocate(comp, 256)
        IfCondition EqualTo(failed, 1) ThenBlock: {
            Deallocate(out, 4096)
            ReturnValue(0)
        }
        IfCondition EqualTo(Rl.existing, 1) ThenBlock: {
            sb2 = Allocate(256)
            st2 = SystemCall(6, out, sb2)
            Deallocate(sb2, 256)
            IfCondition LessThan(st2, 0) ThenBlock: {
                Rl.err = Subtract(0, st2)
                Deallocate(out, 4096)
                ReturnValue(0)
            }
        }
        ReturnValue(out)
    }
}

Function.Plain {
    Input: path: Address
    Output: Address
    Body: {
        buf = Allocate(4096)
        n = SystemCall(89, path, buf, 4095)
        IfCondition LessThan(n, 0) ThenBlock: {
            Rl.err = Subtract(0, n)
            Deallocate(buf, 4096)
            ReturnValue(0)
        }
        WRMEM_8(buf, n, 0)
        ReturnValue(buf)
    }
}

SubRoutine.Main {
    args = GetArgs()
    IfCondition EqualTo(args, 0) ThenBlock: {
        WriteStderr("readlink: failed to read arguments\n")
        SystemCall(60, 1)
    }
    LoadCwd()
    pos = 0
    one = 1
    WhileLoop NotEqual(RDMEM_8(args, pos), 0) {
        pos = Add(pos, one)
    }
    pos = Add(pos, one)
    mode = 0
    verbose = 0
    zero = 0
    nonewline = 0
    end_opts = 0
    files = Allocate(2048)
    nfiles = 0
    limit = 8191
    WhileLoop LessThan(pos, limit) {
        ch = RDMEM_8(args, pos)
        ch = BitwiseAnd(ch, 255)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            pos = limit
        }
        IfCondition NotEqual(ch, 0) ThenBlock: {
            is_opt = 0
            IfCondition And(EqualTo(end_opts, 0), EqualTo(ch, 45)) ThenBlock: {
                n1 = RDMEM_8(args, Add(pos, one))
                n1 = BitwiseAnd(n1, 255)
                IfCondition NotEqual(n1, 0) ThenBlock: {
                    is_opt = 1
                }
            }
            IfCondition EqualTo(is_opt, 1) ThenBlock: {
                IfCondition EqualTo(n1, 45) ThenBlock: {
                    argp = Add(args, pos)
                    IfCondition StringEquals(argp, "--") ThenBlock: {
                        end_opts = 1
                    }
                    IfCondition StringEquals(argp, "--canonicalize") ThenBlock: {
                        mode = 1
                    }
                    IfCondition StringEquals(argp, "--canonicalize-existing") ThenBlock: {
                        mode = 2
                    }
                    IfCondition StringEquals(argp, "--canonicalize-missing") ThenBlock: {
                        mode = 3
                    }
                    IfCondition StringEquals(argp, "--no-newline") ThenBlock: {
                        nonewline = 1
                    }
                    IfCondition StringEquals(argp, "--verbose") ThenBlock: {
                        verbose = 1
                    }
                    IfCondition StringEquals(argp, "--quiet") ThenBlock: {
                        verbose = 0
                    }
                    IfCondition StringEquals(argp, "--silent") ThenBlock: {
                        verbose = 0
                    }
                    IfCondition StringEquals(argp, "--zero") ThenBlock: {
                        zero = 1
                    }
                    pos = SkipArg(args, pos)
                } ElseBlock: {
                    pos = Add(pos, one)
                    cluster = 1
                    WhileLoop EqualTo(cluster, 1) {
                        f = RDMEM_8(args, pos)
                        f = BitwiseAnd(f, 255)
                        IfCondition EqualTo(f, 0) ThenBlock: {
                            pos = Add(pos, one)
                            cluster = 0
                        } ElseBlock: {
                            IfCondition EqualTo(f, 102) ThenBlock: { mode = 1 }
                            IfCondition EqualTo(f, 101) ThenBlock: { mode = 2 }
                            IfCondition EqualTo(f, 109) ThenBlock: { mode = 3 }
                            IfCondition EqualTo(f, 110) ThenBlock: { nonewline = 1 }
                            IfCondition EqualTo(f, 118) ThenBlock: { verbose = 1 }
                            IfCondition EqualTo(f, 113) ThenBlock: { verbose = 0 }
                            IfCondition EqualTo(f, 115) ThenBlock: { verbose = 0 }
                            IfCondition EqualTo(f, 122) ThenBlock: { zero = 1 }
                            pos = Add(pos, one)
                        }
                    }
                }
            } ElseBlock: {
                IfCondition LessThan(nfiles, 256) ThenBlock: {
                    slot = Multiply(nfiles, 8)
                    WRMEM_64(files, slot, Add(args, pos))
                    nfiles = Add(nfiles, one)
                }
                pos = SkipArg(args, pos)
            }
        }
    }
    IfCondition EqualTo(nfiles, 0) ThenBlock: {
        WriteStderr("readlink: missing operand\n")
        SystemCall(60, 1)
    }
    Rl.existing = 0
    Rl.missing = 0
    Rl.verbose = verbose
    IfCondition EqualTo(mode, 2) ThenBlock: {
        Rl.existing = 1
    }
    IfCondition EqualTo(mode, 3) ThenBlock: {
        Rl.missing = 1
    }
    had = 0
    fi = 0
    WhileLoop LessThan(fi, nfiles) {
        fp = RDMEM_64(files, Multiply(fi, 8))
        got = 0
        IfCondition EqualTo(mode, 0) ThenBlock: {
            got = Plain(fp)
        } ElseBlock: {
            got = Canon(fp)
        }
        IfCondition EqualTo(got, 0) ThenBlock: {
            had = 1
            Report(fp)
        } ElseBlock: {
            glen = StringLength(got)
            WriteStdout(got, glen)
            use_delim = 1
            IfCondition EqualTo(nfiles, 1) ThenBlock: {
                IfCondition EqualTo(nonewline, 1) ThenBlock: {
                    use_delim = 0
                }
            }
            IfCondition EqualTo(use_delim, 1) ThenBlock: {
                IfCondition EqualTo(zero, 1) ThenBlock: {
                    zbuf = Allocate(1)
                    WRMEM_8(zbuf, 0, 0)
                    WriteStdout(zbuf, 1)
                    Deallocate(zbuf, 1)
                } ElseBlock: {
                    WriteStdout("\n", 1)
                }
            }
            Deallocate(got, 4096)
        }
        fi = Add(fi, one)
    }
    SystemCall(60, had)
}

RunTask(Main)
