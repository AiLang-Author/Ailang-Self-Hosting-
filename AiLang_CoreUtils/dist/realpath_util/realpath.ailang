// realpath.ailang - Print the resolved absolute file name
// Usage: realpath [OPTION]... FILE...
// Default: every component but the last must exist.

LibraryImport.Arena

Function.WriteStdout {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 1, str, len)
    }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }

        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)

        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }

        ReturnValue(buffer)
    }
}

Function.WriteFail {
    Input: path: Address
    Input: err: Integer
    Body: {
        WriteStderr("realpath: ")
        WriteStderr(path)
        IfCondition EqualTo(err, -20) ThenBlock: {
            WriteStderr(": Not a directory\n")
        } ElseBlock: {
            WriteStderr(": No such file or directory\n")
        }
    }
}

// readlink(/proc/self/fd/N) into dest. Returns the byte count, or < 0.
Function.ReadLinkOfFd {
    Input: fd: Integer
    Input: dest: Address
    Output: Integer
    Body: {
        prefix = "/proc/self/fd/"
        full = Allocate(64)
        j = 0
        i = 0
        WhileLoop NotEqual(GetByte(prefix, i), 0) {
            SetByte(full, j, GetByte(prefix, i))
            i = Add(i, 1)
            j = Add(j, 1)
        }

        IfCondition LessThan(fd, 10) ThenBlock: {
            SetByte(full, j, Add(48, fd))
            j = Add(j, 1)
        } ElseBlock: {
            IfCondition LessThan(fd, 100) ThenBlock: {
                tens = Divide(fd, 10)
                ones = Modulo(fd, 10)
                SetByte(full, j, Add(48, tens))
                j = Add(j, 1)
                SetByte(full, j, Add(48, ones))
                j = Add(j, 1)
            } ElseBlock: {
                hundreds = Divide(fd, 100)
                rest = Modulo(fd, 100)
                tens = Divide(rest, 10)
                ones = Modulo(rest, 10)
                SetByte(full, j, Add(48, hundreds))
                j = Add(j, 1)
                SetByte(full, j, Add(48, tens))
                j = Add(j, 1)
                SetByte(full, j, Add(48, ones))
                j = Add(j, 1)
            }
        }
        SetByte(full, j, 0)

        bytes = SystemCall(89, full, dest, 4095)
        Deallocate(full, 64)
        ReturnValue(bytes)
    }
}

Function.EmitResolved {
    Input: buf: Address
    Input: len: Integer
    Body: {
        SetByte(buf, len, 10)
        SystemCall(1, 1, buf, Add(len, 1))
    }
}

// Resolve one path. must_exist is 1 for -e. Returns 1 on error.
Function.ResolveOne {
    Input: file_path: Address
    Input: must_exist: Integer
    Output: Integer
    Body: {
        resolved = Allocate(4096)
        fd = SystemCall(2, file_path, 0, 0)

        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            bytes = ReadLinkOfFd(fd, resolved)
            SystemCall(3, fd)
            IfCondition GreaterThan(bytes, 0) ThenBlock: {
                EmitResolved(resolved, bytes)
                Deallocate(resolved, 4096)
                ReturnValue(0)
            }
            Deallocate(resolved, 4096)
            ReturnValue(1)
        }

        IfCondition EqualTo(must_exist, 1) ThenBlock: {
            WriteFail(file_path, fd)
            Deallocate(resolved, 4096)
            ReturnValue(1)
        }

        // Missing final component. Canonicalize the parent, then append the name.
        path_len = StringLength(file_path)
        copy = Allocate(Add(path_len, 1))
        MemoryCopy(copy, file_path, path_len)
        SetByte(copy, path_len, 0)

        end = path_len
        WhileLoop GreaterThan(end, 1) {
            prev = Subtract(end, 1)
            ch = GetByte(copy, prev)
            IfCondition NotEqual(ch, 47) ThenBlock: {
                BreakLoop
            }
            SetByte(copy, prev, 0)
            end = prev
        }

        i = Subtract(end, 1)
        WhileLoop GreaterEqual(i, 0) {
            IfCondition EqualTo(GetByte(copy, i), 47) ThenBlock: {
                BreakLoop
            }
            i = Subtract(i, 1)
        }

        parent = copy
        name = copy
        name_len = end
        IfCondition GreaterEqual(i, 0) ThenBlock: {
            SetByte(copy, i, 0)
            name = Add(copy, Add(i, 1))
            name_len = Subtract(end, Add(i, 1))
            IfCondition EqualTo(i, 0) ThenBlock: {
                parent = "/"
            }
        } ElseBlock: {
            parent = "."
        }

        // O_DIRECTORY so a file used as a parent is "Not a directory".
        pfd = SystemCall(2, parent, 65536, 0)
        IfCondition LessThan(pfd, 0) ThenBlock: {
            WriteFail(file_path, pfd)
            Deallocate(copy, Add(path_len, 1))
            Deallocate(resolved, 4096)
            ReturnValue(1)
        }

        nbytes = ReadLinkOfFd(pfd, resolved)
        SystemCall(3, pfd)
        IfCondition LessEqual(nbytes, 0) ThenBlock: {
            WriteFail(file_path, -2)
            Deallocate(copy, Add(path_len, 1))
            Deallocate(resolved, 4096)
            ReturnValue(1)
        }

        is_dot = 0
        is_dotdot = 0
        IfCondition EqualTo(name_len, 1) ThenBlock: {
            IfCondition EqualTo(GetByte(name, 0), 46) ThenBlock: {
                is_dot = 1
            }
        }
        IfCondition EqualTo(name_len, 2) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, 0), 46), EqualTo(GetByte(name, 1), 46)) ThenBlock: {
                is_dotdot = 1
            }
        }

        IfCondition EqualTo(is_dot, 1) ThenBlock: {
            EmitResolved(resolved, nbytes)
        } ElseBlock: {
            IfCondition EqualTo(is_dotdot, 1) ThenBlock: {
                j = Subtract(nbytes, 1)
                WhileLoop GreaterThan(j, 0) {
                    IfCondition EqualTo(GetByte(resolved, j), 47) ThenBlock: {
                        BreakLoop
                    }
                    j = Subtract(j, 1)
                }
                IfCondition EqualTo(j, 0) ThenBlock: {
                    EmitResolved(resolved, 1)
                } ElseBlock: {
                    EmitResolved(resolved, j)
                }
            } ElseBlock: {
                out_len = nbytes
                need_slash = 1
                IfCondition EqualTo(nbytes, 1) ThenBlock: {
                    IfCondition EqualTo(GetByte(resolved, 0), 47) ThenBlock: {
                        need_slash = 0
                    }
                }
                IfCondition EqualTo(need_slash, 1) ThenBlock: {
                    SetByte(resolved, out_len, 47)
                    out_len = Add(out_len, 1)
                }
                k = 0
                WhileLoop LessThan(k, name_len) {
                    SetByte(resolved, Add(out_len, k), GetByte(name, k))
                    k = Add(k, 1)
                }
                out_len = Add(out_len, name_len)
                EmitResolved(resolved, out_len)
            }
        }

        Deallocate(copy, Add(path_len, 1))
        Deallocate(resolved, 4096)
        ReturnValue(0)
    }
}

SubRoutine.Main {
    args_buffer = GetArgs()

    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        WriteStderr("realpath: failed to read arguments\n")
        SystemCall(60, 1)
    }

    pos = 0
    WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)

    IfCondition EqualTo(GetByte(args_buffer, pos), 0) ThenBlock: {
        WriteStderr("realpath: missing operand\n")
        Deallocate(args_buffer, 4096)
        SystemCall(60, 1)
    }

    had_error = 0
    must_exist = 0

    WhileLoop LessThan(pos, 4096) {
        ch = GetByte(args_buffer, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            BreakLoop
        }

        is_flag = 0
        IfCondition EqualTo(ch, 45) ThenBlock: {
            nxt = GetByte(args_buffer, Add(pos, 1))
            third = GetByte(args_buffer, Add(pos, 2))
            IfCondition And(EqualTo(nxt, 101), EqualTo(third, 0)) ThenBlock: {
                must_exist = 1
                is_flag = 1
            }
            IfCondition EqualTo(nxt, 45) ThenBlock: {
                flag = Add(args_buffer, pos)
                IfCondition StringEquals(flag, "--canonicalize-existing") ThenBlock: {
                    must_exist = 1
                    is_flag = 1
                }
            }
        }

        IfCondition EqualTo(is_flag, 0) ThenBlock: {
            file_path = Add(args_buffer, pos)
            status = ResolveOne(file_path, must_exist)
            IfCondition NotEqual(status, 0) ThenBlock: {
                had_error = 1
            }
        }

        WhileLoop And(LessThan(pos, 4096), NotEqual(GetByte(args_buffer, pos), 0)) {
            pos = Add(pos, 1)
        }
        pos = Add(pos, 1)
    }

    Deallocate(args_buffer, 4096)
    SystemCall(60, had_error)
}

RunTask(Main)
