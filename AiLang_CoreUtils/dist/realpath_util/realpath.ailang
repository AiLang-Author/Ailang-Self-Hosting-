// realpath.ailang - Canonicalize paths the way GNU realpath 9.4 does.
// -P follows symlinks as they are met. -L cancels ".." first, then follows.
// -s does not follow symlinks. -m allows missing components. -e requires all.

LibraryImport.Arena

FixedPool.Rp {
    "nread": Initialize=0
    "missing": Initialize=0
    "existing": Initialize=0
    "nolinks": Initialize=0
    "logical": Initialize=0
    "nulout": Initialize=0
    "quiet": Initialize=0
    "cwd": Initialize=0
    "cwdn": Initialize=0
    "relto": Initialize=0
    "relbase": Initialize=0
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buffer = Allocate(8192)
        bytes_read = SystemCall(0, fd, buffer, 8191)
        SystemCall(3, fd)
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 8192)
            ReturnValue(0)
        }
        SetByte(buffer, bytes_read, 0)
        Rp.nread = bytes_read
        ReturnValue(buffer)
    }
}

Function.ReadLinkOfFd {
    Input: fd: Integer
    Input: dest: Address
    Output: Integer
    Body: {
        prefix = "/proc/self/fd/"
        full = Allocate(64)
        j = 0
        i = 0
        one = 1
        WhileLoop NotEqual(GetByte(prefix, i), 0) {
            SetByte(full, j, GetByte(prefix, i))
            i = Add(i, one)
            j = Add(j, one)
        }
        IfCondition LessThan(fd, 10) ThenBlock: {
            SetByte(full, j, Add(48, fd))
            j = Add(j, one)
        } ElseBlock: {
            IfCondition LessThan(fd, 100) ThenBlock: {
                tens = Divide(fd, 10)
                ones = Modulo(fd, 10)
                SetByte(full, j, Add(48, tens))
                j = Add(j, one)
                SetByte(full, j, Add(48, ones))
                j = Add(j, one)
            } ElseBlock: {
                hundreds = Divide(fd, 100)
                rest = Modulo(fd, 100)
                tens = Divide(rest, 10)
                ones = Modulo(rest, 10)
                SetByte(full, j, Add(48, hundreds))
                j = Add(j, one)
                SetByte(full, j, Add(48, tens))
                j = Add(j, one)
                SetByte(full, j, Add(48, ones))
                j = Add(j, one)
            }
        }
        SetByte(full, j, 0)
        bytes = SystemCall(89, full, dest, 4095)
        Deallocate(full, 64)
        ReturnValue(bytes)
    }
}

Function.LoadCwd {
    Body: {
        buf = Allocate(4096)
        n = SystemCall(89, "/proc/self/cwd", buf, 4095)
        IfCondition LessEqual(n, 0) ThenBlock: {
            SetByte(buf, 0, 47)
            n = 1
        }
        SetByte(buf, n, 0)
        Rp.cwd = buf
        Rp.cwdn = n
    }
}

Function.IsDir {
    Input: path: Address
    Output: Integer
    Body: {
        sb = Allocate(144)
        r = SystemCall(262, -100, path, sb, 0)
        IfCondition LessThan(r, 0) ThenBlock: {
            Deallocate(sb, 144)
            ReturnValue(0)
        }
        mode = Dereference(Add(sb, 24))
        kind = BitwiseAnd(mode, 61440)
        Deallocate(sb, 144)
        IfCondition EqualTo(kind, 16384) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.PrefixAt {
    Input: s: Address
    Input: lit: Address
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, 64) {
            a = GetByte(lit, i)
            IfCondition EqualTo(a, 0) ThenBlock: {
                ReturnValue(1)
            }
            b = GetByte(s, i)
            IfCondition NotEqual(a, b) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.SkipArg {
    Input: args: Address
    Input: pos: Integer
    Output: Integer
    Body: {
        i = pos
        one = 1
        WhileLoop NotEqual(GetByte(args, i), 0) {
            i = Add(i, one)
        }
        i = Add(i, one)
        ReturnValue(i)
    }
}

Function.PopComp {
    Input: out: Address
    Input: olen: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(olen, 1) ThenBlock: {
            SetByte(out, 0, 47)
            SetByte(out, 1, 0)
            ReturnValue(1)
        }
        j = olen
        one = 1
        j = Subtract(j, one)
        WhileLoop GreaterThan(j, 0) {
            ch = GetByte(out, j)
            IfCondition EqualTo(ch, 47) ThenBlock: {
                BreakLoop
            }
            j = Subtract(j, one)
        }
        IfCondition EqualTo(j, 0) ThenBlock: {
            SetByte(out, 1, 0)
            ReturnValue(1)
        }
        SetByte(out, j, 0)
        ReturnValue(j)
    }
}

Function.Lex {
    Input: path: Address
    Output: Address
    Body: {
        out = Allocate(4096)
        olen = 0
        i = 0
        one = 1
        IfCondition EqualTo(GetByte(path, 0), 47) ThenBlock: {
            SetByte(out, 0, 47)
            olen = 1
            i = 1
        } ElseBlock: {
            k = 0
            WhileLoop LessThan(k, Rp.cwdn) {
                SetByte(out, k, GetByte(Rp.cwd, k))
                k = Add(k, one)
            }
            olen = Rp.cwdn
        }
        SetByte(out, olen, 0)
        guard = 0
        WhileLoop LessThan(guard, 512) {
            guard = Add(guard, one)
            ch = GetByte(path, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition EqualTo(ch, 47) ThenBlock: {
                i = Add(i, one)
            } ElseBlock: {
                cs = i
                WhileLoop LessThan(guard, 1000) {
                    c2 = GetByte(path, i)
                    IfCondition EqualTo(c2, 0) ThenBlock: {
                        BreakLoop
                    }
                    IfCondition EqualTo(c2, 47) ThenBlock: {
                        BreakLoop
                    }
                    i = Add(i, one)
                }
                clen = Subtract(i, cs)
                dot = 0
                IfCondition EqualTo(clen, 1) ThenBlock: {
                    IfCondition EqualTo(GetByte(path, cs), 46) ThenBlock: {
                        dot = 1
                    }
                }
                dotdot = 0
                IfCondition EqualTo(clen, 2) ThenBlock: {
                    IfCondition EqualTo(GetByte(path, cs), 46) ThenBlock: {
                        IfCondition EqualTo(GetByte(path, Add(cs, one)), 46) ThenBlock: {
                            dotdot = 1
                        }
                    }
                }
                IfCondition EqualTo(dotdot, 1) ThenBlock: {
                    olen = PopComp(out, olen)
                }
                IfCondition EqualTo(dot, 0) ThenBlock: {
                    IfCondition EqualTo(dotdot, 0) ThenBlock: {
                        need = 1
                        IfCondition EqualTo(olen, 1) ThenBlock: {
                            IfCondition EqualTo(GetByte(out, 0), 47) ThenBlock: {
                                need = 0
                            }
                        }
                        IfCondition EqualTo(need, 1) ThenBlock: {
                            SetByte(out, olen, 47)
                            olen = Add(olen, one)
                        }
                        k = 0
                        WhileLoop LessThan(k, clen) {
                            SetByte(out, Add(olen, k), GetByte(path, Add(cs, k)))
                            k = Add(k, one)
                        }
                        olen = Add(olen, clen)
                        SetByte(out, olen, 0)
                    }
                }
            }
        }
        IfCondition EqualTo(olen, 0) ThenBlock: {
            SetByte(out, 0, 47)
            SetByte(out, 1, 0)
        }
        ReturnValue(out)
    }
}

Function.ExistsOK {
    Input: path: Address
    Output: Integer
    Body: {
        sb = Allocate(144)
        r = SystemCall(262, -100, path, sb, 256)
        Deallocate(sb, 144)
        IfCondition GreaterEqual(r, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition NotEqual(r, -2) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Rp.existing, 1) ThenBlock: {
            ReturnValue(0)
        }
        n = StringLength(path)
        IfCondition LessEqual(n, 1) ThenBlock: {
            ReturnValue(1)
        }
        parent = Allocate(4096)
        MemoryCopy(parent, path, n)
        SetByte(parent, n, 0)
        j = Subtract(n, 1)
        one = 1
        WhileLoop GreaterThan(j, 0) {
            IfCondition EqualTo(GetByte(parent, j), 47) ThenBlock: {
                BreakLoop
            }
            j = Subtract(j, one)
        }
        IfCondition EqualTo(j, 0) ThenBlock: {
            SetByte(parent, 1, 0)
        } ElseBlock: {
            SetByte(parent, j, 0)
        }
        ok = IsDir(parent)
        Deallocate(parent, 4096)
        ReturnValue(ok)
    }
}

Function.ReadFd {
    Input: fd: Integer
    Output: Address
    Body: {
        dest = Allocate(4096)
        n = ReadLinkOfFd(fd, dest)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(dest, 4096)
            ReturnValue(0)
        }
        SetByte(dest, n, 0)
        ReturnValue(dest)
    }
}

Function.Phys {
    Input: path: Address
    Output: Address
    Body: {
        IfCondition EqualTo(GetByte(path, 0), 0) ThenBlock: {
            ReturnValue(0)
        }
        fd = -1
        i = 0
        IfCondition EqualTo(GetByte(path, 0), 47) ThenBlock: {
            fd = SystemCall(2, "/", 0)
            i = 1
        } ElseBlock: {
            fd = SystemCall(2, ".", 0)
        }
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        comp = Allocate(256)
        one = 1
        guard = 0
        WhileLoop LessThan(guard, 512) {
            guard = Add(guard, one)
            ch = GetByte(path, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition EqualTo(ch, 47) ThenBlock: {
                i = Add(i, one)
            } ElseBlock: {
                cs = i
                WhileLoop LessThan(i, 4096) {
                    c2 = GetByte(path, i)
                    IfCondition EqualTo(c2, 0) ThenBlock: {
                        BreakLoop
                    }
                    IfCondition EqualTo(c2, 47) ThenBlock: {
                        BreakLoop
                    }
                    i = Add(i, one)
                }
                clen = Subtract(i, cs)
                skip = 0
                IfCondition EqualTo(clen, 1) ThenBlock: {
                    IfCondition EqualTo(GetByte(path, cs), 46) ThenBlock: {
                        skip = 1
                    }
                }
                IfCondition EqualTo(skip, 0) ThenBlock: {
                    copy_n = clen
                    IfCondition GreaterThan(copy_n, 255) ThenBlock: {
                        copy_n = 255
                    }
                    k = 0
                    WhileLoop LessThan(k, copy_n) {
                        SetByte(comp, k, GetByte(path, Add(cs, k)))
                        k = Add(k, one)
                    }
                    SetByte(comp, copy_n, 0)
                    nfd = SystemCall(257, fd, comp, 0, 0)
                    IfCondition LessThan(nfd, 0) ThenBlock: {
                        rest_more = 0
                        j = i
                        WhileLoop LessThan(j, 4096) {
                            cj = GetByte(path, j)
                            IfCondition EqualTo(cj, 0) ThenBlock: {
                                BreakLoop
                            }
                            IfCondition NotEqual(cj, 47) ThenBlock: {
                                rest_more = 1
                                BreakLoop
                            }
                            j = Add(j, one)
                        }
                        allow = 0
                        IfCondition EqualTo(Rp.missing, 1) ThenBlock: {
                            allow = 1
                        }
                        IfCondition EqualTo(Rp.existing, 0) ThenBlock: {
                            IfCondition EqualTo(nfd, -2) ThenBlock: {
                                IfCondition EqualTo(rest_more, 0) ThenBlock: {
                                    allow = 1
                                }
                            }
                        }
                        IfCondition EqualTo(allow, 1) ThenBlock: {
                            base = ReadFd(fd)
                            SystemCall(3, fd)
                            Deallocate(comp, 256)
                            IfCondition EqualTo(base, 0) ThenBlock: {
                                ReturnValue(0)
                            }
                            restp = Add(path, cs)
                            bn = StringLength(base)
                            rn = StringLength(restp)
                            absjoin = Allocate(4096)
                            MemoryCopy(absjoin, base, bn)
                            at = bn
                            slash = 1
                            IfCondition EqualTo(bn, 1) ThenBlock: {
                                IfCondition EqualTo(GetByte(base, 0), 47) ThenBlock: {
                                    slash = 0
                                }
                            }
                            IfCondition EqualTo(slash, 1) ThenBlock: {
                                SetByte(absjoin, at, 47)
                                at = Add(at, one)
                            }
                            MemoryCopy(Add(absjoin, at), restp, rn)
                            SetByte(absjoin, Add(at, rn), 0)
                            Deallocate(base, 4096)
                            out = Lex(absjoin)
                            Deallocate(absjoin, 4096)
                            ReturnValue(out)
                        }
                        SystemCall(3, fd)
                        Deallocate(comp, 256)
                        ReturnValue(0)
                    }
                    SystemCall(3, fd)
                    fd = nfd
                }
            }
        }
        Deallocate(comp, 256)
        dest = ReadFd(fd)
        SystemCall(3, fd)
        ReturnValue(dest)
    }
}

Function.Canon {
    Input: path: Address
    Output: Address
    Body: {
        IfCondition EqualTo(GetByte(path, 0), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Rp.nolinks, 1) ThenBlock: {
            lex = Lex(path)
            IfCondition EqualTo(lex, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(Rp.missing, 0) ThenBlock: {
                ok = ExistsOK(lex)
                IfCondition EqualTo(ok, 0) ThenBlock: {
                    Deallocate(lex, 4096)
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(Rp.logical, 1) ThenBlock: {
                phys = Phys(lex)
                Deallocate(lex, 4096)
                ReturnValue(phys)
            }
            ReturnValue(lex)
        }
        got = Phys(path)
        ReturnValue(got)
    }
}

Function.CommonLen {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        i = 0
        one = 1
        last = 0
        WhileLoop LessThan(i, 4096) {
            ca = GetByte(a, i)
            cb = GetByte(b, i)
            IfCondition EqualTo(ca, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition NotEqual(ca, cb) ThenBlock: {
                BreakLoop
            }
            IfCondition EqualTo(ca, 47) ThenBlock: {
                last = i
            }
            i = Add(i, one)
        }
        ca = GetByte(a, i)
        cb = GetByte(b, i)
        boundary = 0
        IfCondition EqualTo(ca, 0) ThenBlock: {
            IfCondition EqualTo(cb, 0) ThenBlock: {
                boundary = 1
            }
            IfCondition EqualTo(cb, 47) ThenBlock: {
                boundary = 1
            }
        }
        IfCondition EqualTo(cb, 0) ThenBlock: {
            IfCondition EqualTo(ca, 47) ThenBlock: {
                boundary = 1
            }
            IfCondition EqualTo(ca, 0) ThenBlock: {
                boundary = 1
            }
        }
        IfCondition EqualTo(boundary, 1) ThenBlock: {
            ReturnValue(i)
        }
        IfCondition EqualTo(last, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(last)
    }
}

Function.CountRest {
    Input: s: Address
    Input: at: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(GetByte(s, at), 0) ThenBlock: {
            ReturnValue(0)
        }
        i = at
        one = 1
        IfCondition EqualTo(GetByte(s, i), 47) ThenBlock: {
            i = Add(i, one)
        }
        n = 0
        IfCondition EqualTo(GetByte(s, i), 0) ThenBlock: {
            ReturnValue(0)
        }
        n = 1
        WhileLoop NotEqual(GetByte(s, i), 0) {
            IfCondition EqualTo(GetByte(s, i), 47) ThenBlock: {
                nxt = Add(i, one)
                IfCondition NotEqual(GetByte(s, nxt), 0) ThenBlock: {
                    n = Add(n, one)
                }
            }
            i = Add(i, one)
        }
        ReturnValue(n)
    }
}

Function.EmitRel {
    Input: path: Address
    Input: start: Address
    Body: {
        com = CommonLen(path, start)
        ups = CountRest(start, com)
        tail = Add(path, com)
        IfCondition EqualTo(GetByte(tail, 0), 47) ThenBlock: {
            one = 1
            tail = Add(tail, one)
        }
        buf = Allocate(4096)
        pos = 0
        one = 1
        IfCondition EqualTo(ups, 0) ThenBlock: {
            IfCondition EqualTo(GetByte(tail, 0), 0) ThenBlock: {
                SetByte(buf, 0, 46)
                pos = 1
            } ElseBlock: {
                tn = StringLength(tail)
                MemoryCopy(buf, tail, tn)
                pos = tn
            }
        } ElseBlock: {
            u = 0
            WhileLoop LessThan(u, ups) {
                IfCondition GreaterThan(u, 0) ThenBlock: {
                    SetByte(buf, pos, 47)
                    pos = Add(pos, one)
                }
                SetByte(buf, pos, 46)
                pos = Add(pos, one)
                SetByte(buf, pos, 46)
                pos = Add(pos, one)
                u = Add(u, one)
            }
            IfCondition NotEqual(GetByte(tail, 0), 0) ThenBlock: {
                SetByte(buf, pos, 47)
                pos = Add(pos, one)
                tn = StringLength(tail)
                MemoryCopy(Add(buf, pos), tail, tn)
                pos = Add(pos, tn)
            }
        }
        sep = 10
        IfCondition EqualTo(Rp.nulout, 1) ThenBlock: {
            sep = 0
        }
        SetByte(buf, pos, sep)
        SystemCall(1, 1, buf, Add(pos, one))
        Deallocate(buf, 4096)
    }
}

Function.EmitAbs {
    Input: path: Address
    Body: {
        n = StringLength(path)
        sep = 10
        IfCondition EqualTo(Rp.nulout, 1) ThenBlock: {
            sep = 0
        }
        buf = Allocate(4096)
        MemoryCopy(buf, path, n)
        SetByte(buf, n, sep)
        one = 1
        SystemCall(1, 1, buf, Add(n, one))
        Deallocate(buf, 4096)
    }
}

Function.PathPrefix {
    Input: base: Address
    Input: path: Address
    Output: Integer
    Body: {
        com = CommonLen(base, path)
        bl = StringLength(base)
        IfCondition EqualTo(com, bl) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(bl, 1) ThenBlock: {
            IfCondition EqualTo(GetByte(base, 0), 47) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.Report {
    Input: path: Address
    Body: {
        IfCondition EqualTo(Rp.quiet, 0) ThenBlock: {
            WriteStderr("realpath: ")
            WriteStderr(path)
            WriteStderr(": No such file or directory\n")
        }
    }
}

Function.UseAbs {
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Rp.relto, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition NotEqual(Rp.relbase, 0) ThenBlock: {
            hit = PathPrefix(Rp.relbase, path)
            IfCondition EqualTo(hit, 0) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    args = GetArgs()
    IfCondition EqualTo(args, 0) ThenBlock: {
        WriteStderr("realpath: failed to read arguments\n")
        SystemCall(60, 1)
    }
    LoadCwd()
    pos = 0
    one = 1
    WhileLoop NotEqual(GetByte(args, pos), 0) {
        pos = Add(pos, one)
    }
    pos = Add(pos, one)
    files = Allocate(256)
    nfiles = 0
    limit = Subtract(Rp.nread, 1)
    WhileLoop LessThan(pos, limit) {
        ch = GetByte(args, pos)
        IfCondition EqualTo(ch, 45) ThenBlock: {
            nxt = GetByte(args, Add(pos, 1))
            IfCondition EqualTo(nxt, 0) ThenBlock: {
                StoreValue(Add(files, Multiply(nfiles, 8)), Add(args, pos))
                nfiles = Add(nfiles, 1)
                pos = SkipArg(args, pos)
            } ElseBlock: {
                IfCondition EqualTo(nxt, 45) ThenBlock: {
                    arg = Add(args, pos)
                    third = GetByte(args, Add(pos, 2))
                    IfCondition EqualTo(third, 0) ThenBlock: {
                        pos = SkipArg(args, pos)
                        WhileLoop LessThan(pos, limit) {
                            StoreValue(Add(files, Multiply(nfiles, 8)), Add(args, pos))
                            nfiles = Add(nfiles, 1)
                            pos = SkipArg(args, pos)
                        }
                        BreakLoop
                    }
                    hit = PrefixAt(arg, "--relative-to=")
                    IfCondition EqualTo(hit, 1) ThenBlock: {
                        Rp.relto = Add(arg, 14)
                    }
                    hit = PrefixAt(arg, "--relative-base=")
                    IfCondition EqualTo(hit, 1) ThenBlock: {
                        Rp.relbase = Add(arg, 16)
                    }
                    hit = PrefixAt(arg, "--relative-to")
                    IfCondition EqualTo(hit, 1) ThenBlock: {
                        IfCondition EqualTo(GetByte(arg, 13), 0) ThenBlock: {
                            pos = SkipArg(args, pos)
                            Rp.relto = Add(args, pos)
                        }
                    }
                    hit = PrefixAt(arg, "--relative-base")
                    IfCondition EqualTo(hit, 1) ThenBlock: {
                        IfCondition EqualTo(GetByte(arg, 15), 0) ThenBlock: {
                            pos = SkipArg(args, pos)
                            Rp.relbase = Add(args, pos)
                        }
                    }
                    hit = StringEquals(arg, "--canonicalize-existing")
                    IfCondition EqualTo(hit, 1) ThenBlock: {
                        Rp.existing = 1
                        Rp.missing = 0
                    }
                    hit = StringEquals(arg, "--canonicalize-missing")
                    IfCondition EqualTo(hit, 1) ThenBlock: {
                        Rp.missing = 1
                        Rp.existing = 0
                    }
                    pos = SkipArg(args, pos)
                } ElseBlock: {
                    k = 1
                    WhileLoop NotEqual(GetByte(args, Add(pos, k)), 0) {
                        flag = GetByte(args, Add(pos, k))
                        IfCondition EqualTo(flag, 101) ThenBlock: {
                            Rp.existing = 1
                            Rp.missing = 0
                        }
                        IfCondition EqualTo(flag, 109) ThenBlock: {
                            Rp.missing = 1
                            Rp.existing = 0
                        }
                        IfCondition EqualTo(flag, 76) ThenBlock: {
                            Rp.nolinks = 1
                            Rp.logical = 1
                        }
                        IfCondition EqualTo(flag, 115) ThenBlock: {
                            Rp.nolinks = 1
                            Rp.logical = 0
                        }
                        IfCondition EqualTo(flag, 80) ThenBlock: {
                            Rp.nolinks = 0
                            Rp.logical = 0
                        }
                        IfCondition EqualTo(flag, 113) ThenBlock: {
                            Rp.quiet = 1
                        }
                        IfCondition EqualTo(flag, 122) ThenBlock: {
                            Rp.nulout = 1
                        }
                        k = Add(k, one)
                    }
                    pos = SkipArg(args, pos)
                }
            }
        } ElseBlock: {
            StoreValue(Add(files, Multiply(nfiles, 8)), Add(args, pos))
            nfiles = Add(nfiles, 1)
            pos = SkipArg(args, pos)
        }
    }
    IfCondition EqualTo(nfiles, 0) ThenBlock: {
        WriteStderr("realpath: missing operand\n")
        SystemCall(60, 1)
    }
    IfCondition NotEqual(Rp.relbase, 0) ThenBlock: {
        IfCondition EqualTo(Rp.relto, 0) ThenBlock: {
            Rp.relto = Rp.relbase
        }
    }
    IfCondition NotEqual(Rp.relto, 0) ThenBlock: {
        canon_to = Canon(Rp.relto)
        IfCondition EqualTo(canon_to, 0) ThenBlock: {
            Report(Rp.relto)
            SystemCall(60, 1)
        }
        IfCondition EqualTo(Rp.existing, 1) ThenBlock: {
            dir_ok = IsDir(canon_to)
            IfCondition EqualTo(dir_ok, 0) ThenBlock: {
                Report(Rp.relto)
                SystemCall(60, 1)
            }
        }
        Rp.relto = canon_to
    }
    IfCondition NotEqual(Rp.relbase, 0) ThenBlock: {
        IfCondition NotEqual(Rp.relbase, Rp.relto) ThenBlock: {
            canon_base = Canon(Rp.relbase)
            IfCondition EqualTo(canon_base, 0) ThenBlock: {
                Report(Rp.relbase)
                SystemCall(60, 1)
            }
            pre = PathPrefix(canon_base, Rp.relto)
            IfCondition EqualTo(pre, 1) ThenBlock: {
                Rp.relbase = canon_base
            } ElseBlock: {
                Deallocate(canon_base, 4096)
                Deallocate(Rp.relto, 4096)
                Rp.relbase = 0
                Rp.relto = 0
            }
        } ElseBlock: {
            Rp.relbase = Rp.relto
        }
    }
    had = 0
    fi = 0
    WhileLoop LessThan(fi, nfiles) {
        fp = Dereference(Add(files, Multiply(fi, 8)))
        can = Canon(fp)
        IfCondition EqualTo(can, 0) ThenBlock: {
            Report(fp)
            had = 1
        } ElseBlock: {
            abs_only = UseAbs(can)
            IfCondition EqualTo(abs_only, 1) ThenBlock: {
                EmitAbs(can)
            } ElseBlock: {
                EmitRel(can, Rp.relto)
            }
            Deallocate(can, 4096)
        }
        fi = Add(fi, one)
    }
    SystemCall(60, had)
}

RunTask(Main)
