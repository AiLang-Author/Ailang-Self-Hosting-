// RmDeep.ailang - delete a child whose full path does not fit in PATH_MAX.
// Uses openat/unlinkat from the parent directory fd. No pools.
LibraryImport.Arena

Function.RemoveTreeAt {
    Input: dirfd: Integer
    Input: depth: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(depth, 8192) ThenBlock: {
            ReturnValue(1)
        }
        buf = Allocate(4096)
        err = 0
        reading = 1
        WhileLoop EqualTo(reading, 1) {
            nread = SystemCall(217, dirfd, buf, 4096)
            IfCondition LessThan(nread, 0) ThenBlock: {
                err = 1
                reading = 0
            }
            IfCondition EqualTo(nread, 0) ThenBlock: {
                reading = 0
            }
            off = 0
            WhileLoop LessThan(off, nread) {
                entry = Add(buf, off)
                lo = RDMEM_8(entry, 16)
                lo = BitwiseAnd(lo, 255)
                hi = RDMEM_8(entry, 17)
                hi = BitwiseAnd(hi, 255)
                reclen = Add(lo, Multiply(hi, 256))
                IfCondition LessEqual(reclen, 19) ThenBlock: {
                    off = nread
                } ElseBlock: {
                    dtype = RDMEM_8(entry, 18)
                    dtype = BitwiseAnd(dtype, 255)
                    name = Add(entry, 19)
                    c0 = RDMEM_8(name, 0)
                    c0 = BitwiseAnd(c0, 255)
                    skip = 0
                    IfCondition EqualTo(c0, 46) ThenBlock: {
                        c1 = RDMEM_8(name, 1)
                        c1 = BitwiseAnd(c1, 255)
                        IfCondition EqualTo(c1, 0) ThenBlock: {
                            skip = 1
                        }
                        IfCondition EqualTo(c1, 46) ThenBlock: {
                            c2 = RDMEM_8(name, 2)
                            c2 = BitwiseAnd(c2, 255)
                            IfCondition EqualTo(c2, 0) ThenBlock: {
                                skip = 1
                            }
                        }
                    }
                    IfCondition EqualTo(skip, 0) ThenBlock: {
                        isdir = 0
                        IfCondition EqualTo(dtype, 4) ThenBlock: {
                            isdir = 1
                        }
                        IfCondition EqualTo(isdir, 0) ThenBlock: {
                            ur = SystemCall(263, dirfd, name, 0)
                            IfCondition LessThan(ur, 0) ThenBlock: {
                                en = Subtract(0, ur)
                                IfCondition EqualTo(en, 21) ThenBlock: {
                                    isdir = 1
                                } ElseBlock: {
                                    err = 1
                                }
                            }
                        }
                        IfCondition EqualTo(isdir, 1) ThenBlock: {
                            sub = SystemCall(257, dirfd, name, 65536, 0)
                            IfCondition LessThan(sub, 0) ThenBlock: {
                                err = 1
                            } ElseBlock: {
                                next = Add(depth, 1)
                                sube = RemoveTreeAt(sub, next)
                                SystemCall(3, sub)
                                IfCondition NotEqual(sube, 0) ThenBlock: {
                                    err = 1
                                }
                                rd = SystemCall(263, dirfd, name, 512)
                                IfCondition LessThan(rd, 0) ThenBlock: {
                                    err = 1
                                }
                            }
                        }
                    }
                    off = Add(off, reclen)
                }
            }
        }
        Deallocate(buf, 4096)
        ReturnValue(err)
    }
}

Function.RemoveTooLong {
    Input: dirfd: Integer
    Input: name: Address
    Input: dtype: Integer
    Output: Integer
    Body: {
        kind = BitwiseAnd(dtype, 255)
        isdir = 0
        IfCondition EqualTo(kind, 4) ThenBlock: {
            isdir = 1
        }
        IfCondition EqualTo(isdir, 0) ThenBlock: {
            ur = SystemCall(263, dirfd, name, 0)
            IfCondition GreaterEqual(ur, 0) ThenBlock: {
                ReturnValue(0)
            }
            en = Subtract(0, ur)
            IfCondition EqualTo(en, 21) ThenBlock: {
                isdir = 1
            } ElseBlock: {
                ReturnValue(1)
            }
        }
        sub = SystemCall(257, dirfd, name, 65536, 0)
        IfCondition LessThan(sub, 0) ThenBlock: {
            ReturnValue(1)
        }
        sube = RemoveTreeAt(sub, 0)
        SystemCall(3, sub)
        rd = SystemCall(263, dirfd, name, 512)
        IfCondition LessThan(rd, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(sube)
    }
}
