// rm.ailang - GNU-Compatible File/Directory Removal Utility
// Usage: rm [OPTION]... [FILE]...
// Remove (unlink) the FILE(s).
//
// Options:
//   -f, --force           ignore nonexistent files and arguments, never prompt
//   -i                    prompt before every removal
//   -I                    prompt once before removing more than three files, or
//                           when removing recursively
//   -r, -R, --recursive   remove directories and their contents recursively
//   -d, --dir             remove empty directories
//   -v, --verbose         explain what is being done
//   --help                display this help and exit
//   --version             output version information and exit

LibraryImport.Arena

FixedPool.RmConfig {
    "force": Initialize=0
    "interactive": Initialize=0
    "interactive_once": Initialize=0
    "recursive": Initialize=0
    "dir": Initialize=0
    "verbose": Initialize=0
    "prompted_once": Initialize=0
    "prompt_never": Initialize=0
    "presume_tty": Initialize=0
    "preserve_root": Initialize=1
    "cmdline_len": Initialize=0
    "scan_i": Initialize=0
    "aux": Initialize=0
}

FixedPool.RmStats {
    "files_removed": Initialize=0
    "dirs_removed": Initialize=0
    "errors": Initialize=0
    "skipped": Initialize=0
}

FixedPool.RmConstants {
    "ENOENT": Initialize=2
    "EACCES": Initialize=13
    "EBUSY": Initialize=16
    "EEXIST": Initialize=17
    "EISDIR": Initialize=21
    "ENOTDIR": Initialize=20
    "ENOTEMPTY": Initialize=39
    "EROFS": Initialize=30
    "EINVAL": Initialize=22
    "EILSEQ": Initialize=84
    "O_RDONLY": Initialize=0
    "O_DIRECTORY": Initialize=65536
    "AT_FDCWD": Initialize=-100
    "DT_DIR": Initialize=4
    "DT_REG": Initialize=8
}

// ============================================================================
// UTILITY FUNCTIONS
// ============================================================================

Function.WriteStdout {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 1, str, len)
    }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.IntToString {
    Input: num: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(num, 0) ThenBlock: {
            str = Allocate(2)
            SetByte(str, 0, 48)
            SetByte(str, 1, 0)
            ReturnValue(str)
        }
        
        is_negative = LessThan(num, 0)
        abs_num = num
        IfCondition EqualTo(is_negative, 1) ThenBlock: {
            abs_num = Subtract(0, num)
        }
        
        temp = abs_num
        digits = 0
        WhileLoop GreaterThan(temp, 0) {
            temp = Divide(temp, 10)
            digits = Add(digits, 1)
        }
        
        total_len = digits
        IfCondition EqualTo(is_negative, 1) ThenBlock: {
            total_len = Add(total_len, 1)
        }
        
        str = Allocate(Add(total_len, 1))
        
        pos = 0
        IfCondition EqualTo(is_negative, 1) ThenBlock: {
            SetByte(str, 0, 45)
            pos = 1
        }
        
        i = Subtract(total_len, 1)
        temp = abs_num
        WhileLoop GreaterThan(temp, 0) {
            digit = Modulo(temp, 10)
            SetByte(str, i, Add(48, digit))
            temp = Divide(temp, 10)
            i = Subtract(i, 1)
        }
        
        SetByte(str, total_len, 0)
        ReturnValue(str)
    }
}

Function.PathExists {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(6, path, statbuf)
        Deallocate(statbuf, 144)
        ReturnValue(GreaterEqual(result, 0))
    }
}

Function.IsDirectory {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(6, path, statbuf)
        
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        
        st_mode = Dereference(Add(statbuf, 24))
        Deallocate(statbuf, 144)
        
        is_dir = BitwiseAnd(st_mode, 16384)
        ReturnValue(NotEqual(is_dir, 0))
    }
}

Function.ApplyForce {
    Body: {
        RmConfig.force = 1
        RmConfig.prompt_never = 1
        RmConfig.interactive = 0
        RmConfig.interactive_once = 0
    }
}

Function.ApplyInteractive {
    Input: mode: Integer
    Body: {
        IfCondition EqualTo(mode, 0) ThenBlock: {
            RmConfig.prompt_never = 1
            RmConfig.interactive = 0
            RmConfig.interactive_once = 0
        }
        IfCondition EqualTo(mode, 1) ThenBlock: {
            RmConfig.prompt_never = 0
            RmConfig.interactive = 0
            RmConfig.interactive_once = 1
            RmConfig.force = 0
        }
        IfCondition EqualTo(mode, 2) ThenBlock: {
            RmConfig.prompt_never = 0
            RmConfig.interactive = 1
            RmConfig.interactive_once = 0
            RmConfig.force = 0
        }
    }
}

Function.IsFilesystemRoot {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(6, path, statbuf)
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        dev = Dereference(statbuf)
        ino = Dereference(Add(statbuf, 8))
        Deallocate(statbuf, 144)

        rootbuf = Allocate(144)
        root_result = SystemCall(6, "/", rootbuf)
        IfCondition LessThan(root_result, 0) ThenBlock: {
            Deallocate(rootbuf, 144)
            ReturnValue(0)
        }
        root_dev = Dereference(rootbuf)
        root_ino = Dereference(Add(rootbuf, 8))
        Deallocate(rootbuf, 144)

        same_dev = EqualTo(dev, root_dev)
        same_ino = EqualTo(ino, root_ino)
        ReturnValue(And(same_dev, same_ino))
    }
}

Function.StdinIsTty {
    Output: Integer
    Body: {
        IfCondition EqualTo(RmConfig.presume_tty, 1) ThenBlock: {
            ReturnValue(1)
        }
        termios = Allocate(64)
        result = SystemCall(16, 0, 21505, termios)
        Deallocate(termios, 64)
        ReturnValue(GreaterEqual(result, 0))
    }
}

Function.PathKind {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(6, path, statbuf)
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        mode = Dereference(Add(statbuf, 24))
        Deallocate(statbuf, 144)
        kind = BitwiseAnd(mode, 61440)
        ReturnValue(kind)
    }
}

Function.IsWriteProtected {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(6, path, statbuf)
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(0)
        }
        mode = Dereference(Add(statbuf, 24))
        Deallocate(statbuf, 144)
        kind = BitwiseAnd(mode, 61440)
        IfCondition EqualTo(kind, 40960) ThenBlock: {
            ReturnValue(0)
        }
        acc = SystemCall(269, -100, path, 2, 512)
        IfCondition GreaterEqual(acc, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.ShouldPrompt {
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(RmConfig.prompt_never, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(RmConfig.interactive, 1) ThenBlock: {
            ReturnValue(1)
        }
        tty = StdinIsTty()
        IfCondition EqualTo(tty, 0) ThenBlock: {
            ReturnValue(0)
        }
        kind = PathKind(path)
        IfCondition EqualTo(kind, 40960) ThenBlock: {
            ReturnValue(0)
        }
        protected = IsWriteProtected(path)
        ReturnValue(protected)
    }
}

Function.BuildPath {
    Input: dir: Address
    Input: file: Address
    Output: Address
    Body: {
        dir_len = StringLength(dir)
        file_len = StringLength(file)
        
        needs_slash = 1
        IfCondition GreaterThan(dir_len, 0) ThenBlock: {
            last_char = GetByte(dir, Subtract(dir_len, 1))
            IfCondition EqualTo(last_char, 47) ThenBlock: {
                needs_slash = 0
            }
        }
        
        total_len = Add(Add(dir_len, file_len), Add(needs_slash, 1))
        path = Allocate(total_len)
        
        i = 0
        WhileLoop LessThan(i, dir_len) {
            SetByte(path, i, GetByte(dir, i))
            i = Add(i, 1)
        }
        
        IfCondition EqualTo(needs_slash, 1) ThenBlock: {
            SetByte(path, i, 47)
            i = Add(i, 1)
        }
        
        j = 0
        WhileLoop LessThan(j, file_len) {
            SetByte(path, i, GetByte(file, j))
            i = Add(i, 1)
            j = Add(j, 1)
        }
        
        SetByte(path, i, 0)
        ReturnValue(path)
    }
}

Function.GetErrorString {
    Input: errno: Integer
    Output: Address
    Body: {
        abs_errno = errno
        IfCondition LessThan(errno, 0) ThenBlock: {
            abs_errno = Subtract(0, errno)
        }
        
        IfCondition EqualTo(abs_errno, RmConstants.ENOENT) ThenBlock: {
            ReturnValue("No such file or directory")
        }
        
        IfCondition EqualTo(abs_errno, RmConstants.EACCES) ThenBlock: {
            ReturnValue("Permission denied")
        }
        
        IfCondition EqualTo(abs_errno, RmConstants.EISDIR) ThenBlock: {
            ReturnValue("Is a directory")
        }
        
        IfCondition EqualTo(abs_errno, RmConstants.ENOTDIR) ThenBlock: {
            ReturnValue("Not a directory")
        }
        
        IfCondition EqualTo(abs_errno, RmConstants.ENOTEMPTY) ThenBlock: {
            ReturnValue("Directory not empty")
        }
        
        IfCondition EqualTo(abs_errno, RmConstants.EBUSY) ThenBlock: {
            ReturnValue("Device or resource busy")
        }
        
        IfCondition EqualTo(abs_errno, RmConstants.EROFS) ThenBlock: {
            ReturnValue("Read-only file system")
        }

        IfCondition EqualTo(abs_errno, RmConstants.EINVAL) ThenBlock: {
            ReturnValue("Invalid argument")
        }

        IfCondition EqualTo(abs_errno, RmConstants.EILSEQ) ThenBlock: {
            ReturnValue("Invalid or incomplete multibyte or wide character")
        }
        
        ReturnValue("Unknown error")
    }
}

Function.PromptUser {
    Input: prompt: Address
    Output: Integer
    Body: {
        WriteStderr(prompt)
        
        response = Allocate(1)
        bytes = SystemCall(0, 0, response, 1)
        
        IfCondition LessEqual(bytes, 0) ThenBlock: {
            Deallocate(response, 1)
            ReturnValue(0)
        }
        
        ch = GetByte(response, 0)
        Deallocate(response, 1)

        IfCondition NotEqual(ch, 10) ThenBlock: {
            drain = Allocate(1)
            WhileLoop 1 {
                nread = SystemCall(0, 0, drain, 1)
                IfCondition LessEqual(nread, 0) ThenBlock: {
                    BreakLoop
                }
                drained = GetByte(drain, 0)
                IfCondition EqualTo(drained, 10) ThenBlock: {
                    BreakLoop
                }
            }
            Deallocate(drain, 1)
        }
        
        result = Or(EqualTo(ch, 121), EqualTo(ch, 89))
        ReturnValue(result)
    }
}

Function.PromptForPath {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(6, path, statbuf)
        mode = 0
        size = 0
        IfCondition GreaterEqual(result, 0) ThenBlock: {
            mode = Dereference(Add(statbuf, 24))
            size = Dereference(Add(statbuf, 48))
        }
        Deallocate(statbuf, 144)

        kind = BitwiseAnd(mode, 61440)
        exec_bits = BitwiseAnd(mode, 73)

        IfCondition EqualTo(kind, 16384) ThenBlock: {
            IfCondition EqualTo(exec_bits, 0) ThenBlock: {
                WriteStderr("rm: attempt removal of inaccessible directory '")
                WriteStderr(path)
                WriteStderr("'? ")
                answer = PromptUser("")
                ReturnValue(answer)
            }
        }

        WriteStderr("rm: remove ")
        show_wp = IsWriteProtected(path)
        IfCondition EqualTo(kind, 40960) ThenBlock: {
            show_wp = 0
        }
        IfCondition EqualTo(show_wp, 1) ThenBlock: {
            WriteStderr("write-protected ")
        }

        phrase = "file '"
        IfCondition EqualTo(kind, 32768) ThenBlock: {
            phrase = "regular file '"
            IfCondition EqualTo(size, 0) ThenBlock: {
                phrase = "regular empty file '"
            }
        }
        IfCondition EqualTo(kind, 16384) ThenBlock: {
            phrase = "directory '"
        }
        IfCondition EqualTo(kind, 40960) ThenBlock: {
            phrase = "symbolic link '"
        }
        WriteStderr(phrase)
        WriteStderr(path)
        WriteStderr("'? ")
        answer = PromptUser("")
        ReturnValue(answer)
    }
}

Function.AskRemove {
    Input: path: Address
    Output: Integer
    Body: {
        ask = ShouldPrompt(path)
        IfCondition EqualTo(ask, 0) ThenBlock: {
            ReturnValue(1)
        }
        answer = PromptForPath(path)
        IfCondition EqualTo(answer, 0) ThenBlock: {
            RmStats.skipped = Add(RmStats.skipped, 1)
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// ============================================================================
// CORE REMOVAL FUNCTIONS
// ============================================================================

Function.RemoveFile {
    Input: path: Address
    Output: Integer
    Body: {
        proceed = AskRemove(path)
        IfCondition EqualTo(proceed, 0) ThenBlock: {
            ReturnValue(2)
        }

        result = SystemCall(87, path)
        
        IfCondition GreaterEqual(result, 0) ThenBlock: {
            RmStats.files_removed = Add(RmStats.files_removed, 1)
            
            IfCondition EqualTo(RmConfig.verbose, 1) ThenBlock: {
                WriteStdout("removed '")
                WriteStdout(path)
                WriteStdout("'\n")
            }
            
            ReturnValue(0)
        }
        
        abs_error = Subtract(0, result)
        
        IfCondition EqualTo(abs_error, RmConstants.ENOENT) ThenBlock: {
            IfCondition EqualTo(RmConfig.force, 1) ThenBlock: {
                ReturnValue(0)
            }
        }
        
        IfCondition EqualTo(abs_error, RmConstants.EISDIR) ThenBlock: {
            IfCondition EqualTo(RmConfig.recursive, 0) ThenBlock: {
                WriteStderr("rm: cannot remove '")
                WriteStderr(path)
                WriteStderr("': Is a directory\n")
                RmStats.errors = Add(RmStats.errors, 1)
                ReturnValue(1)
            }
        }
        
        WriteStderr("rm: cannot remove '")
        WriteStderr(path)
        WriteStderr("': ")
        WriteStderr(GetErrorString(result))
        WriteStderr("\n")
        
        RmStats.errors = Add(RmStats.errors, 1)
        ReturnValue(1)
    }
}

Function.RemoveEmptyDirectory {
    Input: path: Address
    Output: Integer
    Body: {
        proceed = AskRemove(path)
        IfCondition EqualTo(proceed, 0) ThenBlock: {
            ReturnValue(2)
        }

        result = SystemCall(84, path)
        
        IfCondition GreaterEqual(result, 0) ThenBlock: {
            RmStats.dirs_removed = Add(RmStats.dirs_removed, 1)
            
            IfCondition EqualTo(RmConfig.verbose, 1) ThenBlock: {
                WriteStdout("removed directory '")
                WriteStdout(path)
                WriteStdout("'\n")
            }
            
            ReturnValue(0)
        }
        
        abs_error = Subtract(0, result)
        
        IfCondition EqualTo(abs_error, RmConstants.ENOENT) ThenBlock: {
            IfCondition EqualTo(RmConfig.force, 1) ThenBlock: {
                ReturnValue(0)
            }
        }
        
        WriteStderr("rm: cannot remove '")
        WriteStderr(path)
        WriteStderr("': ")
        WriteStderr(GetErrorString(result))
        WriteStderr("\n")
        
        RmStats.errors = Add(RmStats.errors, 1)
        ReturnValue(1)
    }
}

// fts trims two or more trailing slashes to one. "//" stays "//". "///" becomes "/".
Function.TrimTrailingSlashes {
    Input: path: Address
    Body: {
        len = StringLength(path)
        IfCondition GreaterThan(len, 2) ThenBlock: {
            last = GetByte(path, Subtract(len, 1))
            IfCondition EqualTo(last, 47) ThenBlock: {
                RmConfig.scan_i = len
                WhileLoop 1 {
                    IfCondition LessEqual(RmConfig.scan_i, 1) ThenBlock: {
                        BreakLoop
                    }
                    prev = GetByte(path, Subtract(RmConfig.scan_i, 2))
                    IfCondition NotEqual(prev, 47) ThenBlock: {
                        BreakLoop
                    }
                    RmConfig.scan_i = Subtract(RmConfig.scan_i, 1)
                }
                SetByte(path, RmConfig.scan_i, 0)
            }
        }
    }
}

Function.IsDotOrDotDot {
    Input: path: Address
    Output: Integer
    Body: {
        len = StringLength(path)
        IfCondition EqualTo(len, 0) ThenBlock: {
            ReturnValue(0)
        }
        end = len
        last = GetByte(path, Subtract(len, 1))
        IfCondition EqualTo(last, 47) ThenBlock: {
            IfCondition GreaterThan(len, 1) ThenBlock: {
                end = Subtract(len, 1)
            }
        }
        IfCondition EqualTo(end, 0) ThenBlock: {
            ReturnValue(0)
        }
        RmConfig.scan_i = end
        WhileLoop GreaterThan(RmConfig.scan_i, 0) {
            RmConfig.scan_i = Subtract(RmConfig.scan_i, 1)
            ch = GetByte(path, RmConfig.scan_i)
            IfCondition EqualTo(ch, 47) ThenBlock: {
                RmConfig.scan_i = Add(RmConfig.scan_i, 1)
                BreakLoop
            }
        }
        comp = Subtract(end, RmConfig.scan_i)
        IfCondition EqualTo(comp, 1) ThenBlock: {
            c0 = GetByte(path, RmConfig.scan_i)
            IfCondition EqualTo(c0, 46) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(comp, 2) ThenBlock: {
            c0 = GetByte(path, RmConfig.scan_i)
            c1 = GetByte(path, Add(RmConfig.scan_i, 1))
            IfCondition And(EqualTo(c0, 46), EqualTo(c1, 46)) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.StatErrno {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = SystemCall(6, path, statbuf)
        Deallocate(statbuf, 144)
        IfCondition GreaterEqual(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Subtract(0, result))
    }
}

Function.IsIgnorableMissing {
    Input: err: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(err, RmConstants.ENOENT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(err, RmConstants.ENOTDIR) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(err, RmConstants.EINVAL) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(err, RmConstants.EILSEQ) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.DirNonEmpty {
    Input: path: Address
    Output: Integer
    Body: {
        flags = BitwiseOr(RmConstants.O_RDONLY, RmConstants.O_DIRECTORY)
        dir_fd = SystemCall(257, RmConstants.AT_FDCWD, path, flags, 0)
        IfCondition LessThan(dir_fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buffer = Allocate(32768)
        RmConfig.aux = 0
        WhileLoop EqualTo(RmConfig.aux, 0) {
            bytes_read = SystemCall(217, dir_fd, buffer, 32768)
            IfCondition LessEqual(bytes_read, 0) ThenBlock: {
                BreakLoop
            }
            pos = 0
            WhileLoop LessThan(pos, bytes_read) {
                d_reclen = Add(GetByte(buffer, Add(pos, 16)), Multiply(GetByte(buffer, Add(pos, 17)), 256))
                name_start = Add(pos, 19)
                n0 = GetByte(buffer, name_start)
                n1 = GetByte(buffer, Add(name_start, 1))
                n2 = GetByte(buffer, Add(name_start, 2))
                is_dot = And(EqualTo(n0, 46), EqualTo(n1, 0))
                is_dotdot = And(EqualTo(n0, 46), And(EqualTo(n1, 46), EqualTo(n2, 0)))
                IfCondition Not(Or(is_dot, is_dotdot)) ThenBlock: {
                    RmConfig.aux = 1
                    BreakLoop
                }
                IfCondition LessEqual(d_reclen, 0) ThenBlock: {
                    BreakLoop
                }
                pos = Add(pos, d_reclen)
            }
        }
        Deallocate(buffer, 32768)
        SystemCall(3, dir_fd)
        ReturnValue(RmConfig.aux)
    }
}

Function.AskDescend {
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(RmConfig.interactive, 0) ThenBlock: {
            ReturnValue(1)
        }
        state = DirNonEmpty(path)
        IfCondition EqualTo(state, 0) ThenBlock: {
            ReturnValue(1)
        }
        wp = IsWriteProtected(path)
        IfCondition EqualTo(wp, 1) ThenBlock: {
            WriteStderr("rm: descend into write-protected directory '")
        } ElseBlock: {
            WriteStderr("rm: descend into directory '")
        }
        WriteStderr(path)
        WriteStderr("'? ")
        answer = PromptUser("")
        ReturnValue(answer)
    }
}

Function.RemoveDirectoryRecursive {
    Input: path: Address
    Output: Integer
    Body: {
        go = AskDescend(path)
        IfCondition EqualTo(go, 0) ThenBlock: {
            RmStats.skipped = Add(RmStats.skipped, 1)
            ReturnValue(2)
        }

        flags = BitwiseOr(RmConstants.O_RDONLY, RmConstants.O_DIRECTORY)
        dir_fd = SystemCall(257, RmConstants.AT_FDCWD, path, flags, 0)
        
        IfCondition LessThan(dir_fd, 0) ThenBlock: {
            abs_error = Subtract(0, dir_fd)
            
            IfCondition EqualTo(abs_error, RmConstants.ENOTDIR) ThenBlock: {
                ReturnValue(RemoveFile(path))
            }
            
            IfCondition EqualTo(abs_error, RmConstants.ENOENT) ThenBlock: {
                IfCondition EqualTo(RmConfig.force, 1) ThenBlock: {
                    ReturnValue(0)
                }
            }

            IfCondition EqualTo(abs_error, RmConstants.EACCES) ThenBlock: {
                rmdir_result = SystemCall(84, path)
                IfCondition GreaterEqual(rmdir_result, 0) ThenBlock: {
                    RmStats.dirs_removed = Add(RmStats.dirs_removed, 1)
                    IfCondition EqualTo(RmConfig.verbose, 1) ThenBlock: {
                        WriteStdout("removed directory '")
                        WriteStdout(path)
                        WriteStdout("'\n")
                    }
                    ReturnValue(0)
                }
            }
            
            WriteStderr("rm: cannot remove '")
            WriteStderr(path)
            WriteStderr("': ")
            WriteStderr(GetErrorString(dir_fd))
            WriteStderr("\n")
            
            RmStats.errors = Add(RmStats.errors, 1)
            ReturnValue(1)
        }
        
        buffer = Allocate(32768)
        errors = 0
        blocked = 0
        
        WhileLoop 1 {
            bytes_read = SystemCall(217, dir_fd, buffer, 32768)
            
            IfCondition LessEqual(bytes_read, 0) ThenBlock: {
                BreakLoop
            }
            
            pos = 0
            WhileLoop LessThan(pos, bytes_read) {
                d_reclen = Add(GetByte(buffer, Add(pos, 16)), 
                              Multiply(GetByte(buffer, Add(pos, 17)), 256))
                d_type = GetByte(buffer, Add(pos, 18))
                name_start = Add(pos, 19)
                
                name_len = 0
                WhileLoop 1 {
                    ch = GetByte(buffer, Add(name_start, name_len))
                    IfCondition EqualTo(ch, 0) ThenBlock: {
                        BreakLoop
                    }
                    name_len = Add(name_len, 1)
                }
                
                name = Allocate(Add(name_len, 1))
                i = 0
                WhileLoop LessThan(i, name_len) {
                    SetByte(name, i, GetByte(buffer, Add(name_start, i)))
                    i = Add(i, 1)
                }
                SetByte(name, name_len, 0)
                
                is_dot = And(EqualTo(name_len, 1), EqualTo(GetByte(name, 0), 46))
                is_dotdot = And(EqualTo(name_len, 2), 
                               And(EqualTo(GetByte(name, 0), 46), 
                                   EqualTo(GetByte(name, 1), 46)))
                
                IfCondition Not(Or(is_dot, is_dotdot)) ThenBlock: {
                    entry_path = BuildPath(path, name)
                    
                    remove_result = 0
                    IfCondition EqualTo(d_type, RmConstants.DT_DIR) ThenBlock: {
                        remove_result = RemoveDirectoryRecursive(entry_path)
                    } ElseBlock: {
                        remove_result = RemoveFile(entry_path)
                    }
                    
                    IfCondition EqualTo(remove_result, 1) ThenBlock: {
                        errors = Add(errors, 1)
                    }
                    IfCondition EqualTo(remove_result, 2) ThenBlock: {
                        blocked = 1
                    }
                    
                    Deallocate(entry_path, 0)
                }
                
                Deallocate(name, Add(name_len, 1))
                pos = Add(pos, d_reclen)
            }
        }
        
        Deallocate(buffer, 32768)
        SystemCall(3, dir_fd)
        
        IfCondition GreaterThan(errors, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(blocked, 1) ThenBlock: {
            ReturnValue(2)
        }
        
        ReturnValue(RemoveEmptyDirectory(path))
    }
}

Function.RemovePath {
    Input: path: Address
    Output: Integer
    Body: {
        TrimTrailingSlashes(path)
        err = StatErrno(path)

        IfCondition NotEqual(err, 0) ThenBlock: {
            IfCondition EqualTo(RmConfig.force, 1) ThenBlock: {
                ign = IsIgnorableMissing(err)
                IfCondition EqualTo(ign, 1) ThenBlock: {
                    ReturnValue(0)
                }
            }

            WriteStderr("rm: cannot remove '")
            WriteStderr(path)
            WriteStderr("': ")
            WriteStderr(GetErrorString(err))
            WriteStderr("\n")
            RmStats.errors = Add(RmStats.errors, 1)
            ReturnValue(1)
        }

        IfCondition EqualTo(RmConfig.recursive, 1) ThenBlock: {
            is_dir_early = IsDirectory(path)
            IfCondition EqualTo(is_dir_early, 1) ThenBlock: {
                dot = IsDotOrDotDot(path)
                IfCondition EqualTo(dot, 1) ThenBlock: {
                    WriteStderr("rm: refusing to remove '.' or '..' directory: skipping '")
                    WriteStderr(path)
                    WriteStderr("'\n")
                    RmStats.errors = Add(RmStats.errors, 1)
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(RmConfig.preserve_root, 1) ThenBlock: {
                is_root = IsFilesystemRoot(path)
                IfCondition EqualTo(is_root, 1) ThenBlock: {
                    IfCondition StringEquals(path, "/") ThenBlock: {
                        WriteStderr("rm: it is dangerous to operate recursively on '/'\n")
                    } ElseBlock: {
                        WriteStderr("rm: it is dangerous to operate recursively on '")
                        WriteStderr(path)
                        WriteStderr("' (same as '/')\n")
                    }
                    WriteStderr("rm: use --no-preserve-root to override this failsafe\n")
                    RmStats.errors = Add(RmStats.errors, 1)
                    ReturnValue(1)
                }
            }
        }
        
        is_dir = IsDirectory(path)
        
        IfCondition EqualTo(is_dir, 1) ThenBlock: {
            IfCondition EqualTo(RmConfig.recursive, 1) ThenBlock: {
                ReturnValue(RemoveDirectoryRecursive(path))
            }
            
            IfCondition EqualTo(RmConfig.dir, 1) ThenBlock: {
                ReturnValue(RemoveEmptyDirectory(path))
            }
            
            WriteStderr("rm: cannot remove '")
            WriteStderr(path)
            WriteStderr("': Is a directory\n")
            RmStats.errors = Add(RmStats.errors, 1)
            ReturnValue(1)
        }
        
        ReturnValue(RemoveFile(path))
    }
}

// ============================================================================
// ARGUMENT PARSING
// ============================================================================

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }

        RmConfig.cmdline_len = bytes_read
        ReturnValue(buffer)
    }
}

Function.StringCompare {
    Input: str1: Address
    Input: str2: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop 1 {
            ch1 = GetByte(str1, i)
            ch2 = GetByte(str2, i)
            
            IfCondition NotEqual(ch1, ch2) ThenBlock: {
                ReturnValue(0)
            }
            
            IfCondition EqualTo(ch1, 0) ThenBlock: {
                ReturnValue(1)
            }
            
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.ShowHelp {
    Body: {
        WriteStdout("Usage: rm [OPTION]... [FILE]...\n")
        WriteStdout("Remove (unlink) the FILE(s).\n")
        WriteStdout("\n")
        WriteStdout("  -f, --force           ignore nonexistent files and arguments, never prompt\n")
        WriteStdout("  -i                    prompt before every removal\n")
        WriteStdout("  -I                    prompt once before removing more than three files, or\n")
        WriteStdout("                          when removing recursively; less intrusive than -i,\n")
        WriteStdout("                          while still giving protection against most mistakes\n")
        WriteStdout("  -r, -R, --recursive   remove directories and their contents recursively\n")
        WriteStdout("  -d, --dir             remove empty directories\n")
        WriteStdout("  -v, --verbose         explain what is being done\n")
        WriteStdout("      --help            display this help and exit\n")
        WriteStdout("      --version         output version information and exit\n")
        WriteStdout("\n")
        WriteStdout("By default, rm does not remove directories.  Use the --recursive (-r or -R)\n")
        WriteStdout("option to remove each listed directory, too, along with all of its contents.\n")
        WriteStdout("\n")
        WriteStdout("To remove a file whose name starts with a '-', for example '-foo',\n")
        WriteStdout("use one of these commands:\n")
        WriteStdout("  rm -- -foo\n")
        WriteStdout("\n")
        WriteStdout("  rm ./-foo\n")
        WriteStdout("\n")
        WriteStdout("Note that if you use rm to remove a file, it might be possible to recover\n")
        WriteStdout("some of its contents, given sufficient expertise and/or time.  For greater\n")
        WriteStdout("assurance that the contents are truly unrecoverable, consider using shred.\n")
        WriteStdout("\n")
        WriteStdout("GNU coreutils compatible rm implementation in AiLang.\n")
    }
}

Function.ShowVersion {
    Body: {
        WriteStdout("rm (AILANG coreutils) 9.4\n")
        WriteStdout("Copyright (C) 2025 AiLang Project\n")
        WriteStdout("License: MIT\n")
        WriteStdout("\n")
        WriteStdout("Written in AiLang - A language designed for human and LLM comprehension.\n")
    }
}

// ============================================================================
// MAIN ROUTINE
// ============================================================================

SubRoutine.Main {
    args_buffer = GetArgs()
    
    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        WriteStderr("rm: failed to read arguments\n")
        SystemCall(60, 1)
    }
    
    pos = 0
    WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)
    
    end_opts = 0
    max_files = 256
    files = ArrayCreate(max_files)
    file_count = 0
    
    WhileLoop LessThan(pos, RmConfig.cmdline_len) {
        ch = GetByte(args_buffer, pos)
        
        first = ch
        take_file = 1
        IfCondition EqualTo(end_opts, 0) ThenBlock: {
            IfCondition EqualTo(first, 45) ThenBlock: {
                take_file = 0
            }
        }
        
        arg_start = pos
        arg_len = 0
        WhileLoop And(LessThan(pos, RmConfig.cmdline_len), NotEqual(GetByte(args_buffer, pos), 0)) {
            arg_len = Add(arg_len, 1)
            pos = Add(pos, 1)
        }
        
        word = Allocate(Add(arg_len, 1))
        i = 0
        WhileLoop LessThan(i, arg_len) {
            SetByte(word, i, GetByte(args_buffer, Add(arg_start, i)))
            i = Add(i, 1)
        }
        SetByte(word, arg_len, 0)
        
        keep_word = 0
        IfCondition EqualTo(take_file, 1) ThenBlock: {
            keep_word = 1
        } ElseBlock: {
            IfCondition EqualTo(arg_len, 1) ThenBlock: {
                keep_word = 1
            } ElseBlock: {
                second = GetByte(word, 1)
                IfCondition EqualTo(second, 45) ThenBlock: {
                    handled = 0
                    IfCondition StringEquals(word, "--") ThenBlock: {
                        end_opts = 1
                        handled = 1
                    }
                    IfCondition StringEquals(word, "--help") ThenBlock: {
                        ShowHelp()
                        Deallocate(word, Add(arg_len, 1))
                        ArrayDestroy(files)
                        Deallocate(args_buffer, 4096)
                        SystemCall(60, 0)
                    }
                    IfCondition StringEquals(word, "--version") ThenBlock: {
                        ShowVersion()
                        Deallocate(word, Add(arg_len, 1))
                        ArrayDestroy(files)
                        Deallocate(args_buffer, 4096)
                        SystemCall(60, 0)
                    }
                    IfCondition StringEquals(word, "--force") ThenBlock: {
                        ApplyForce()
                        handled = 1
                    }
                    IfCondition StringEquals(word, "--recursive") ThenBlock: {
                        RmConfig.recursive = 1
                        handled = 1
                    }
                    IfCondition StringEquals(word, "--dir") ThenBlock: {
                        RmConfig.dir = 1
                        handled = 1
                    }
                    IfCondition StringEquals(word, "--verbose") ThenBlock: {
                        RmConfig.verbose = 1
                        handled = 1
                    }
                    IfCondition StringEquals(word, "---presume-input-tty") ThenBlock: {
                        RmConfig.presume_tty = 1
                        handled = 1
                    }
                    IfCondition StringEquals(word, "--interactive") ThenBlock: {
                        ApplyInteractive(2)
                        handled = 1
                    }
                    IfCondition StringEquals(word, "--interactive=always") ThenBlock: {
                        ApplyInteractive(2)
                        handled = 1
                    }
                    IfCondition StringEquals(word, "--interactive=yes") ThenBlock: {
                        ApplyInteractive(2)
                        handled = 1
                    }
                    IfCondition StringEquals(word, "--interactive=once") ThenBlock: {
                        ApplyInteractive(1)
                        handled = 1
                    }
                    IfCondition StringEquals(word, "--interactive=never") ThenBlock: {
                        ApplyInteractive(0)
                        handled = 1
                    }
                    IfCondition StringEquals(word, "--interactive=no") ThenBlock: {
                        ApplyInteractive(0)
                        handled = 1
                    }
                    IfCondition StringEquals(word, "--interactive=none") ThenBlock: {
                        ApplyInteractive(0)
                        handled = 1
                    }
                    IfCondition StringEquals(word, "--one-file-system") ThenBlock: {
                        handled = 1
                    }
                    IfCondition StringEquals(word, "--preserve-root") ThenBlock: {
                        RmConfig.preserve_root = 1
                        handled = 1
                    }
                    IfCondition StringEquals(word, "--preserve-root=all") ThenBlock: {
                        RmConfig.preserve_root = 1
                        handled = 1
                    }
                    IfCondition StringEquals(word, "--no-preserve-root") ThenBlock: {
                        RmConfig.preserve_root = 0
                        handled = 1
                    }
                    IfCondition EqualTo(handled, 0) ThenBlock: {
                        WriteStderr("rm: unrecognized option '")
                        WriteStderr(word)
                        WriteStderr("'\n")
                        WriteStderr("Try 'rm --help' for more information.\n")
                        SystemCall(60, 1)
                    }
                } ElseBlock: {
                    i = 1
                    WhileLoop LessThan(i, arg_len) {
                        flag_char = GetByte(word, i)
                        known = 0
                        IfCondition EqualTo(flag_char, 102) ThenBlock: {
                            ApplyForce()
                            known = 1
                        }
                        IfCondition EqualTo(flag_char, 105) ThenBlock: {
                            ApplyInteractive(2)
                            known = 1
                        }
                        IfCondition EqualTo(flag_char, 73) ThenBlock: {
                            ApplyInteractive(1)
                            known = 1
                        }
                        IfCondition EqualTo(flag_char, 114) ThenBlock: {
                            RmConfig.recursive = 1
                            known = 1
                        }
                        IfCondition EqualTo(flag_char, 82) ThenBlock: {
                            RmConfig.recursive = 1
                            known = 1
                        }
                        IfCondition EqualTo(flag_char, 100) ThenBlock: {
                            RmConfig.dir = 1
                            known = 1
                        }
                        IfCondition EqualTo(flag_char, 118) ThenBlock: {
                            RmConfig.verbose = 1
                            known = 1
                        }
                        IfCondition EqualTo(known, 0) ThenBlock: {
                            bad = Allocate(2)
                            SetByte(bad, 0, flag_char)
                            SetByte(bad, 1, 0)
                            WriteStderr("rm: invalid option -- '")
                            WriteStderr(bad)
                            WriteStderr("'\n")
                            WriteStderr("Try 'rm --help' for more information.\n")
                            SystemCall(60, 1)
                        }
                        i = Add(i, 1)
                    }
                }
                Deallocate(word, Add(arg_len, 1))
            }
        }
        
        IfCondition EqualTo(keep_word, 1) ThenBlock: {
            IfCondition LessThan(file_count, max_files) ThenBlock: {
                ArraySet(files, file_count, word)
                file_count = Add(file_count, 1)
            }
        }
        
        pos = Add(pos, 1)
    }
    
    Deallocate(args_buffer, 4096)
    
    IfCondition EqualTo(file_count, 0) ThenBlock: {
        IfCondition EqualTo(RmConfig.force, 1) ThenBlock: {
            ArrayDestroy(files)
            SystemCall(60, 0)
        }
        WriteStderr("rm: missing operand\n")
        WriteStderr("Try 'rm --help' for more information.\n")
        ArrayDestroy(files)
        SystemCall(60, 1)
    }
    
    IfCondition EqualTo(RmConfig.interactive_once, 1) ThenBlock: {
        should_prompt = 0
        
        IfCondition GreaterThan(file_count, 3) ThenBlock: {
            should_prompt = 1
        }
        
        IfCondition EqualTo(RmConfig.recursive, 1) ThenBlock: {
            should_prompt = 1
        }
        
        IfCondition EqualTo(should_prompt, 1) ThenBlock: {
            IfCondition EqualTo(RmConfig.prompted_once, 0) ThenBlock: {
                WriteStderr("rm: remove ")
                count_str = IntToString(file_count)
                WriteStderr(count_str)
                Deallocate(count_str, 0)
                WriteStderr(" argument")
                
                IfCondition GreaterThan(file_count, 1) ThenBlock: {
                    WriteStderr("s")
                }
                
                IfCondition EqualTo(RmConfig.recursive, 1) ThenBlock: {
                    WriteStderr(" recursively")
                }
                
                WriteStderr("? ")
                
                response = PromptUser("")
                RmConfig.prompted_once = 1
                
                IfCondition EqualTo(response, 0) ThenBlock: {
                    ArrayDestroy(files)
                    SystemCall(60, 0)
                }
            }
        }
    }
    
    i = 0
    WhileLoop LessThan(i, file_count) {
        file = ArrayGet(files, i)
        result = RemovePath(file)
        Deallocate(file, 0)
        i = Add(i, 1)
    }
    
    ArrayDestroy(files)
    
    exit_code = 0
    IfCondition GreaterThan(RmStats.errors, 0) ThenBlock: {
        exit_code = 1
    }
    
    SystemCall(60, exit_code)
}

RunTask(Main)