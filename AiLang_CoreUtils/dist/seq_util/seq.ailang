// seq.ailang - Print number sequences
// Usage: seq [FIRST [INCREMENT]] LAST

LibraryImport.Arena

FixedPool.SeqBuffer {
    "buffer": Initialize=0
    "position": Initialize=0
    "size": Initialize=262144
}

// format is 0 when seq is printing plain integers.
// idx is the scan cursor. A loop that does i = Add(i, 1) does not
// keep that value after the loop, so the cursor lives here.
FixedPool.SeqOpt {
    "format": Initialize=0
    "idx": Initialize=0
    "parsed": Initialize=0
    "equal": Initialize=0
    "width": Initialize=0
}

Function.InitBuffer {
    Body: {
        SeqBuffer.buffer = Allocate(SeqBuffer.size)
        SeqBuffer.position = 0
    }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.ReportWriteError {
    Input: n: Integer
    Body: {
        err = n
        IfCondition LessThan(err, 0) ThenBlock: {
            err = Subtract(0, err)
        }
        WriteStderr("seq: write error: ")
        IfCondition EqualTo(err, 28) ThenBlock: {
            WriteStderr("No space left on device\n")
        } ElseBlock: {
            IfCondition EqualTo(err, 32) ThenBlock: {
                WriteStderr("Broken pipe\n")
            } ElseBlock: {
                WriteStderr("Unknown error\n")
            }
        }
        SystemCall(60, 1)
    }
}

Function.FlushBuffer {
    Body: {
        IfCondition GreaterThan(SeqBuffer.position, 0) ThenBlock: {
            n = SystemCall(1, 1, SeqBuffer.buffer, SeqBuffer.position)
            IfCondition LessThan(n, SeqBuffer.position) ThenBlock: {
                ReportWriteError(n)
            }
            SeqBuffer.position = 0
        }
    }
}

Function.BufferByte {
    Input: byte: Integer
    Body: {
        IfCondition GreaterEqual(SeqBuffer.position, SeqBuffer.size) ThenBlock: {
            FlushBuffer()
        }
        WRMEM_8(SeqBuffer.buffer, SeqBuffer.position, byte)
        SeqBuffer.position = Add(SeqBuffer.position, 1)
    }
}

// One byte straight into the output buffer. The pool cursor is updated
// in place so a later flush sees every digit.
Function.PutByte {
    Input: byte: Integer
    Body: {
        WRMEM_8(SeqBuffer.buffer, SeqBuffer.position, byte)
        SeqBuffer.position = Add(SeqBuffer.position, 1)
    }
}

Function.WriteNumber {
    Input: num: Integer
    Body: {
        // Sign, up to 20 digits, and a newline, written straight into the buffer.
        limit = Subtract(SeqBuffer.size, 24)
        IfCondition GreaterThan(SeqBuffer.position, limit) ThenBlock: {
            FlushBuffer()
        }
        buf = SeqBuffer.buffer
        pos = SeqBuffer.position

        IfCondition LessThan(num, 0) ThenBlock: {
            WRMEM_8(buf, pos, 45)
            pos = Add(pos, 1)
            num = Subtract(0, num)
        }

        IfCondition LessThan(num, 10) ThenBlock: {
            WRMEM_8(buf, pos, Add(48, num))
            pos = Add(pos, 1)
            WRMEM_8(buf, pos, 10)
            pos = Add(pos, 1)
            SeqBuffer.position = pos
            ReturnValue(0)
        }

        IfCondition LessThan(num, 100) ThenBlock: {
            WRMEM_8(buf, pos, Add(48, Divide(num, 10)))
            pos = Add(pos, 1)
            WRMEM_8(buf, pos, Add(48, Modulo(num, 10)))
            pos = Add(pos, 1)
            WRMEM_8(buf, pos, 10)
            pos = Add(pos, 1)
            SeqBuffer.position = pos
            ReturnValue(0)
        }

        IfCondition LessThan(num, 1000) ThenBlock: {
            hi = Divide(num, 100)
            rest = Modulo(num, 100)
            WRMEM_8(buf, pos, Add(48, hi))
            pos = Add(pos, 1)
            WRMEM_8(buf, pos, Add(48, Divide(rest, 10)))
            pos = Add(pos, 1)
            WRMEM_8(buf, pos, Add(48, Modulo(rest, 10)))
            pos = Add(pos, 1)
            WRMEM_8(buf, pos, 10)
            pos = Add(pos, 1)
            SeqBuffer.position = pos
            ReturnValue(0)
        }

        IfCondition LessThan(num, 10000) ThenBlock: {
            hi = Divide(num, 1000)
            rest = Modulo(num, 1000)
            WRMEM_8(buf, pos, Add(48, hi))
            pos = Add(pos, 1)
            mid = Divide(rest, 100)
            rest = Modulo(rest, 100)
            WRMEM_8(buf, pos, Add(48, mid))
            pos = Add(pos, 1)
            WRMEM_8(buf, pos, Add(48, Divide(rest, 10)))
            pos = Add(pos, 1)
            WRMEM_8(buf, pos, Add(48, Modulo(rest, 10)))
            pos = Add(pos, 1)
            WRMEM_8(buf, pos, 10)
            pos = Add(pos, 1)
            SeqBuffer.position = pos
            ReturnValue(0)
        }

        IfCondition LessThan(num, 100000) ThenBlock: {
            hi = Divide(num, 10000)
            rest = Modulo(num, 10000)
            WRMEM_8(buf, pos, Add(48, hi))
            pos = Add(pos, 1)
            hi = Divide(rest, 1000)
            rest = Modulo(rest, 1000)
            WRMEM_8(buf, pos, Add(48, hi))
            pos = Add(pos, 1)
            hi = Divide(rest, 100)
            rest = Modulo(rest, 100)
            WRMEM_8(buf, pos, Add(48, hi))
            pos = Add(pos, 1)
            WRMEM_8(buf, pos, Add(48, Divide(rest, 10)))
            pos = Add(pos, 1)
            WRMEM_8(buf, pos, Add(48, Modulo(rest, 10)))
            pos = Add(pos, 1)
            WRMEM_8(buf, pos, 10)
            pos = Add(pos, 1)
            SeqBuffer.position = pos
            ReturnValue(0)
        }

        IfCondition LessThan(num, 1000000) ThenBlock: {
            hi = Divide(num, 100000)
            rest = Modulo(num, 100000)
            WRMEM_8(buf, pos, Add(48, hi))
            pos = Add(pos, 1)
            hi = Divide(rest, 10000)
            rest = Modulo(rest, 10000)
            WRMEM_8(buf, pos, Add(48, hi))
            pos = Add(pos, 1)
            hi = Divide(rest, 1000)
            rest = Modulo(rest, 1000)
            WRMEM_8(buf, pos, Add(48, hi))
            pos = Add(pos, 1)
            hi = Divide(rest, 100)
            rest = Modulo(rest, 100)
            WRMEM_8(buf, pos, Add(48, hi))
            pos = Add(pos, 1)
            WRMEM_8(buf, pos, Add(48, Divide(rest, 10)))
            pos = Add(pos, 1)
            WRMEM_8(buf, pos, Add(48, Modulo(rest, 10)))
            pos = Add(pos, 1)
            WRMEM_8(buf, pos, 10)
            pos = Add(pos, 1)
            SeqBuffer.position = pos
            ReturnValue(0)
        }

        SeqBuffer.position = pos
        temp = num
        digits = 0
        WhileLoop GreaterThan(temp, 0) {
            temp = Divide(temp, 10)
            digits = Add(digits, 1)
        }

        i = Subtract(digits, 1)
        temp = num
        WhileLoop GreaterEqual(i, 0) {
            divisor = 1
            j = 0
            WhileLoop LessThan(j, i) {
                divisor = Multiply(divisor, 10)
                j = Add(j, 1)
            }
            digit = Divide(temp, divisor)
            PutByte(Add(48, digit))
            temp = Subtract(temp, Multiply(digit, divisor))
            i = Subtract(i, 1)
        }
        PutByte(10)
    }
}

Function.StringToInt {
    Input: str: Address
    Output: Integer
    Body: {
        result = 0
        i = 0
        negative = 0
        
        first = RDMEM_8(str, 0)
        IfCondition EqualTo(first, 45) ThenBlock: {
            negative = 1
            i = 1
        }
        
        WhileLoop 1 {
            ch = RDMEM_8(str, i)
            IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                BreakLoop
            }
            digit = Subtract(ch, 48)
            result = Add(Multiply(result, 10), digit)
            i = Add(i, 1)
        }
        
        IfCondition EqualTo(negative, 1) ThenBlock: {
            result = Subtract(0, result)
        }
        
        ReturnValue(result)
    }
}

// Copy the tail of str starting at off into a new NUL-terminated buffer.
Function.CopyTail {
    Input: str: Address
    Input: off: Integer
    Output: Address
    Body: {
        SeqOpt.idx = 0
        WhileLoop NotEqual(RDMEM_8(str, Add(off, SeqOpt.idx)), 0) {
            SeqOpt.idx = Add(SeqOpt.idx, 1)
        }
        n = SeqOpt.idx
        buf = Allocate(Add(n, 1))
        SeqOpt.idx = 0
        WhileLoop LessThan(SeqOpt.idx, n) {
            WRMEM_8(buf, SeqOpt.idx, RDMEM_8(str, Add(off, SeqOpt.idx)))
            SeqOpt.idx = Add(SeqOpt.idx, 1)
        }
        WRMEM_8(buf, n, 0)
        ReturnValue(buf)
    }
}

// Digit count of num, including a leading minus. Result also sits in SeqOpt.parsed.
Function.DecDigits {
    Input: num: Integer
    Output: Integer
    Body: {
        one = 1
        SeqOpt.parsed = 0
        IfCondition LessThan(num, 0) ThenBlock: {
            SeqOpt.parsed = 1
            num = Subtract(0, num)
        }
        IfCondition EqualTo(num, 0) ThenBlock: {
            SeqOpt.parsed = Add(SeqOpt.parsed, one)
            n = SeqOpt.parsed
            ReturnValue(n)
        }
        WhileLoop GreaterThan(num, 0) {
            SeqOpt.parsed = Add(SeqOpt.parsed, one)
            num = Divide(num, 10)
        }
        n = SeqOpt.parsed
        ReturnValue(n)
    }
}

// seq -w on integers: format %0Nd so WriteFormatted zero-pads.
Function.SetEqualFormat {
    Body: {
        w = SeqOpt.width
        buf = Allocate(16)
        tens = Divide(w, 10)
        ones = Modulo(w, 10)
        WRMEM_8(buf, 0, 37)
        WRMEM_8(buf, 1, 48)
        IfCondition GreaterThan(tens, 0) ThenBlock: {
            WRMEM_8(buf, 2, Add(48, tens))
            WRMEM_8(buf, 3, Add(48, ones))
            WRMEM_8(buf, 4, 100)
            WRMEM_8(buf, 5, 0)
        } ElseBlock: {
            WRMEM_8(buf, 2, Add(48, ones))
            WRMEM_8(buf, 3, 100)
            WRMEM_8(buf, 4, 0)
        }
        SeqOpt.format = buf
    }
}

// Print num using a printf-style width. Digits are stored least-significant first.
Function.EmitNumber {
    Input: num: Integer
    Input: width: Integer
    Input: pad_zero: Integer
    Body: {
        neg = 0
        IfCondition LessThan(num, 0) ThenBlock: {
            neg = 1
            num = Subtract(0, num)
        }
        digs = Allocate(24)
        SeqOpt.idx = 0
        IfCondition EqualTo(num, 0) ThenBlock: {
            WRMEM_8(digs, 0, 48)
            SeqOpt.idx = 1
        } ElseBlock: {
            WhileLoop GreaterThan(num, 0) {
                WRMEM_8(digs, SeqOpt.idx, Add(48, Modulo(num, 10)))
                SeqOpt.idx = Add(SeqOpt.idx, 1)
                num = Divide(num, 10)
            }
        }
        dcount = SeqOpt.idx
        total = Add(dcount, neg)
        pad = Subtract(width, total)
        IfCondition LessThan(pad, 0) ThenBlock: {
            pad = 0
        }
        IfCondition EqualTo(pad_zero, 1) ThenBlock: {
            IfCondition EqualTo(neg, 1) ThenBlock: {
                PutByte(45)
            }
            WhileLoop GreaterThan(pad, 0) {
                PutByte(48)
                pad = Subtract(pad, 1)
            }
        } ElseBlock: {
            WhileLoop GreaterThan(pad, 0) {
                PutByte(32)
                pad = Subtract(pad, 1)
            }
            IfCondition EqualTo(neg, 1) ThenBlock: {
                PutByte(45)
            }
        }
        SeqOpt.idx = Subtract(dcount, 1)
        WhileLoop GreaterEqual(SeqOpt.idx, 0) {
            PutByte(RDMEM_8(digs, SeqOpt.idx))
            IfCondition EqualTo(SeqOpt.idx, 0) ThenBlock: {
                BreakLoop
            }
            SeqOpt.idx = Subtract(SeqOpt.idx, 1)
        }
        Deallocate(digs, 24)
    }
}

// GNU seq --format. Literals are copied. %0Nd, %d, and %g print the integer.
Function.WriteFormatted {
    Input: num: Integer
    Body: {
        IfCondition EqualTo(SeqOpt.format, 0) ThenBlock: {
            WriteNumber(num)
            ReturnValue(0)
        }
        limit = Subtract(SeqBuffer.size, 128)
        IfCondition GreaterThan(SeqBuffer.position, limit) ThenBlock: {
            FlushBuffer()
        }
        fmt = SeqOpt.format
        SeqOpt.idx = 0
        WhileLoop NotEqual(RDMEM_8(fmt, SeqOpt.idx), 0) {
            ch = RDMEM_8(fmt, SeqOpt.idx)
            SeqOpt.idx = Add(SeqOpt.idx, 1)
            IfCondition EqualTo(ch, 37) ThenBlock: {
                pad_zero = 0
                width = 0
                WhileLoop 1 {
                    ch = RDMEM_8(fmt, SeqOpt.idx)
                    IfCondition EqualTo(ch, 48) ThenBlock: {
                        pad_zero = 1
                        SeqOpt.idx = Add(SeqOpt.idx, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(ch, 45) ThenBlock: {
                            pad_zero = 0
                            SeqOpt.idx = Add(SeqOpt.idx, 1)
                        } ElseBlock: {
                            BreakLoop
                        }
                    }
                }
                WhileLoop 1 {
                    ch = RDMEM_8(fmt, SeqOpt.idx)
                    IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                        BreakLoop
                    }
                    width = Add(Multiply(width, 10), Subtract(ch, 48))
                    SeqOpt.idx = Add(SeqOpt.idx, 1)
                }
                ch = RDMEM_8(fmt, SeqOpt.idx)
                IfCondition EqualTo(ch, 46) ThenBlock: {
                    SeqOpt.idx = Add(SeqOpt.idx, 1)
                    WhileLoop 1 {
                        ch = RDMEM_8(fmt, SeqOpt.idx)
                        IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                            BreakLoop
                        }
                        SeqOpt.idx = Add(SeqOpt.idx, 1)
                    }
                }
                ch = RDMEM_8(fmt, SeqOpt.idx)
                IfCondition NotEqual(ch, 0) ThenBlock: {
                    SeqOpt.idx = Add(SeqOpt.idx, 1)
                }
                do_num = 0
                IfCondition EqualTo(ch, 103) ThenBlock: { do_num = 1 }
                IfCondition EqualTo(ch, 100) ThenBlock: { do_num = 1 }
                IfCondition EqualTo(ch, 117) ThenBlock: { do_num = 1 }
                IfCondition EqualTo(ch, 105) ThenBlock: { do_num = 1 }
                IfCondition EqualTo(ch, 102) ThenBlock: { do_num = 1 }
                IfCondition EqualTo(ch, 37) ThenBlock: {
                    PutByte(37)
                }
                IfCondition EqualTo(do_num, 1) ThenBlock: {
                    saved = SeqOpt.idx
                    EmitNumber(num, width, pad_zero)
                    SeqOpt.idx = saved
                }
            } ElseBlock: {
                PutByte(ch)
            }
        }
        PutByte(10)
    }
}

// 10^n. n is 0..18. The result is returned in SeqOpt.parsed as well.
Function.Pow10 {
    Input: n: Integer
    Output: Integer
    Body: {
        v = 1
        k = n
        WhileLoop 1 {
            IfCondition LessEqual(k, 0) ThenBlock: {
                SeqOpt.parsed = v
                ReturnValue(v)
            }
            v = Multiply(v, 10)
            k = Subtract(k, 1)
        }
        SeqOpt.parsed = v
        ReturnValue(v)
    }
}

// 0 integer, 1 decimal, 2 +inf, 3 -inf, -1 not a number.
// Fractional digit count is left in SeqOpt.parsed.
Function.ClassifyArg {
    Input: str: Address
    Output: Integer
    Body: {
        len = StringLength(str)
        SeqOpt.parsed = 0
        IfCondition EqualTo(len, 0) ThenBlock: {
            ReturnValue(-1)
        }
        SeqOpt.idx = 0
        neg = 0
        ch = RDMEM_8(str, 0)
        IfCondition EqualTo(ch, 43) ThenBlock: {
            SeqOpt.idx = 1
        }
        IfCondition EqualTo(ch, 45) ThenBlock: {
            neg = 1
            SeqOpt.idx = 1
        }
        rest = Subtract(len, SeqOpt.idx)
        is_inf = 0
        IfCondition EqualTo(rest, 3) ThenBlock: {
            c0 = RDMEM_8(str, SeqOpt.idx)
            c1 = RDMEM_8(str, Add(SeqOpt.idx, 1))
            c2 = RDMEM_8(str, Add(SeqOpt.idx, 2))
            IfCondition EqualTo(c0, 105) ThenBlock: {
                IfCondition EqualTo(c1, 110) ThenBlock: {
                    IfCondition EqualTo(c2, 102) ThenBlock: {
                        is_inf = 1
                    }
                }
            }
        }
        IfCondition EqualTo(rest, 8) ThenBlock: {
            c0 = RDMEM_8(str, SeqOpt.idx)
            c1 = RDMEM_8(str, Add(SeqOpt.idx, 1))
            c2 = RDMEM_8(str, Add(SeqOpt.idx, 2))
            c3 = RDMEM_8(str, Add(SeqOpt.idx, 3))
            c4 = RDMEM_8(str, Add(SeqOpt.idx, 4))
            c5 = RDMEM_8(str, Add(SeqOpt.idx, 5))
            c6 = RDMEM_8(str, Add(SeqOpt.idx, 6))
            c7 = RDMEM_8(str, Add(SeqOpt.idx, 7))
            IfCondition EqualTo(c0, 105) ThenBlock: {
                IfCondition EqualTo(c1, 110) ThenBlock: {
                    IfCondition EqualTo(c2, 102) ThenBlock: {
                        IfCondition EqualTo(c3, 105) ThenBlock: {
                            IfCondition EqualTo(c4, 110) ThenBlock: {
                                IfCondition EqualTo(c5, 105) ThenBlock: {
                                    IfCondition EqualTo(c6, 116) ThenBlock: {
                                        IfCondition EqualTo(c7, 121) ThenBlock: {
                                            is_inf = 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(is_inf, 1) ThenBlock: {
            IfCondition EqualTo(neg, 1) ThenBlock: {
                ReturnValue(3)
            }
            ReturnValue(2)
        }
        saw_digit = 0
        saw_dot = 0
        frac = 0
        WhileLoop LessThan(SeqOpt.idx, len) {
            ch = RDMEM_8(str, SeqOpt.idx)
            is_digit = 0
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: {
                    is_digit = 1
                }
            }
            IfCondition EqualTo(is_digit, 1) ThenBlock: {
                saw_digit = 1
                IfCondition EqualTo(saw_dot, 1) ThenBlock: {
                    frac = Add(frac, 1)
                }
            } ElseBlock: {
                IfCondition EqualTo(ch, 46) ThenBlock: {
                    IfCondition EqualTo(saw_dot, 1) ThenBlock: {
                        ReturnValue(-1)
                    }
                    saw_dot = 1
                } ElseBlock: {
                    ReturnValue(-1)
                }
            }
            SeqOpt.idx = Add(SeqOpt.idx, 1)
        }
        IfCondition EqualTo(saw_digit, 0) ThenBlock: {
            ReturnValue(-1)
        }
        SeqOpt.parsed = frac
        IfCondition EqualTo(saw_dot, 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Scale str to 10^scale. Extra fractional digits are dropped.
// The value is left in SeqOpt.parsed.
Function.ParseScaled {
    Input: str: Address
    Input: scale: Integer
    Output: Integer
    Body: {
        len = StringLength(str)
        SeqOpt.idx = 0
        neg = 0
        IfCondition GreaterThan(len, 0) ThenBlock: {
            ch = RDMEM_8(str, 0)
            IfCondition EqualTo(ch, 43) ThenBlock: {
                SeqOpt.idx = 1
            }
            IfCondition EqualTo(ch, 45) ThenBlock: {
                neg = 1
                SeqOpt.idx = 1
            }
        }
        val = 0
        seen_dot = 0
        frac_used = 0
        WhileLoop LessThan(SeqOpt.idx, len) {
            ch = RDMEM_8(str, SeqOpt.idx)
            IfCondition EqualTo(ch, 46) ThenBlock: {
                seen_dot = 1
            } ElseBlock: {
                digit = Subtract(ch, 48)
                take = 0
                IfCondition EqualTo(seen_dot, 0) ThenBlock: {
                    take = 1
                } ElseBlock: {
                    IfCondition LessThan(frac_used, scale) ThenBlock: {
                        take = 1
                        frac_used = Add(frac_used, 1)
                    }
                }
                IfCondition EqualTo(take, 1) ThenBlock: {
                    val = Add(Multiply(val, 10), digit)
                }
            }
            SeqOpt.idx = Add(SeqOpt.idx, 1)
        }
        WhileLoop LessThan(frac_used, scale) {
            val = Multiply(val, 10)
            frac_used = Add(frac_used, 1)
        }
        IfCondition EqualTo(neg, 1) ThenBlock: {
            val = Subtract(0, val)
        }
        SeqOpt.parsed = val
        ReturnValue(val)
    }
}

Function.WriteScaled {
    Input: num: Integer
    Input: scale: Integer
    Body: {
        limit = Subtract(SeqBuffer.size, 64)
        IfCondition GreaterThan(SeqBuffer.position, limit) ThenBlock: {
            FlushBuffer()
        }
        IfCondition LessThan(num, 0) ThenBlock: {
            BufferByte(45)
            num = Subtract(0, num)
        }
        pow = 1
        left = scale
        WhileLoop GreaterThan(left, 0) {
            pow = Multiply(pow, 10)
            left = Subtract(left, 1)
        }
        ip = Divide(num, pow)
        fp = Modulo(num, pow)
        digs = Allocate(24)
        SeqOpt.idx = 0
        IfCondition EqualTo(ip, 0) ThenBlock: {
            WRMEM_8(digs, 0, 48)
            SeqOpt.idx = 1
        } ElseBlock: {
            WhileLoop GreaterThan(ip, 0) {
                WRMEM_8(digs, SeqOpt.idx, Add(48, Modulo(ip, 10)))
                SeqOpt.idx = Add(SeqOpt.idx, 1)
                ip = Divide(ip, 10)
            }
        }
        dcount = SeqOpt.idx
        SeqOpt.idx = Subtract(dcount, 1)
        WhileLoop GreaterEqual(SeqOpt.idx, 0) {
            BufferByte(RDMEM_8(digs, SeqOpt.idx))
            IfCondition EqualTo(SeqOpt.idx, 0) ThenBlock: {
                BreakLoop
            }
            SeqOpt.idx = Subtract(SeqOpt.idx, 1)
        }
        Deallocate(digs, 24)
        IfCondition GreaterThan(scale, 0) ThenBlock: {
            BufferByte(46)
            place = pow
            left = scale
            WhileLoop GreaterThan(left, 0) {
                place = Divide(place, 10)
                digit = Divide(fp, place)
                BufferByte(Add(48, digit))
                fp = Modulo(fp, place)
                left = Subtract(left, 1)
            }
        }
        BufferByte(10)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        cmdline_path = "/proc/self/cmdline"
        fd = SystemCall(257, -100, cmdline_path, 0, 0)
        
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        ReturnValue(buffer)
    }
}

SubRoutine.Main {
    InitBuffer()
    
    args_buffer = GetArgs()
    
    // Skip program name
    pos = 0
    WhileLoop NotEqual(RDMEM_8(args_buffer, pos), 0) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)
    
    // Collect arguments. --format=FMT and -f FMT are not numeric operands.
    args = Allocate(24)  // 3 args max
    arg_count = 0
    take_fmt = 0
    
    WhileLoop LessThan(pos, 4096) {
        ch = RDMEM_8(args_buffer, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            BreakLoop
        }
        
        arg_start = pos
        arg_len = 0
        
        WhileLoop And(LessThan(pos, 4096), NotEqual(RDMEM_8(args_buffer, pos), 0)) {
            arg_len = Add(arg_len, 1)
            pos = Add(pos, 1)
        }
        
        arg = Allocate(Add(arg_len, 1))
        i = 0
        WhileLoop LessThan(i, arg_len) {
            ch = RDMEM_8(args_buffer, Add(arg_start, i))
            WRMEM_8(arg, i, ch)
            i = Add(i, 1)
        }
        WRMEM_8(arg, arg_len, 0)

        IfCondition EqualTo(take_fmt, 1) ThenBlock: {
            SeqOpt.format = arg
            take_fmt = 0
        } ElseBlock: {
            b0 = RDMEM_8(arg, 0)
            b1 = RDMEM_8(arg, 1)
            is_opt = 0
            IfCondition EqualTo(b0, 45) ThenBlock: {
                IfCondition NotEqual(b1, 0) ThenBlock: {
                    IfCondition Or(LessThan(b1, 48), GreaterThan(b1, 57)) ThenBlock: {
                        is_opt = 1
                    }
                }
            }
            IfCondition EqualTo(is_opt, 1) ThenBlock: {
                IfCondition EqualTo(b1, 45) ThenBlock: {
                    c2 = RDMEM_8(arg, 2)
                    c3 = RDMEM_8(arg, 3)
                    c4 = RDMEM_8(arg, 4)
                    c5 = RDMEM_8(arg, 5)
                    c6 = RDMEM_8(arg, 6)
                    c7 = RDMEM_8(arg, 7)
                    c8 = RDMEM_8(arg, 8)
                    match = 0
                    IfCondition EqualTo(c2, 102) ThenBlock: {
                        IfCondition EqualTo(c3, 111) ThenBlock: {
                            IfCondition EqualTo(c4, 114) ThenBlock: {
                                IfCondition EqualTo(c5, 109) ThenBlock: {
                                    IfCondition EqualTo(c6, 97) ThenBlock: {
                                        IfCondition EqualTo(c7, 116) ThenBlock: {
                                            match = 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(match, 1) ThenBlock: {
                        IfCondition EqualTo(c8, 61) ThenBlock: {
                            SeqOpt.format = CopyTail(arg, 9)
                        } ElseBlock: {
                            IfCondition EqualTo(c8, 0) ThenBlock: {
                                take_fmt = 1
                            }
                        }
                    }
                } ElseBlock: {
                    IfCondition EqualTo(b1, 102) ThenBlock: {
                        b2 = RDMEM_8(arg, 2)
                        IfCondition EqualTo(b2, 0) ThenBlock: {
                            take_fmt = 1
                        } ElseBlock: {
                            SeqOpt.format = CopyTail(arg, 2)
                        }
                    }
                    IfCondition EqualTo(b1, 119) ThenBlock: {
                        b2 = RDMEM_8(arg, 2)
                        IfCondition EqualTo(b2, 0) ThenBlock: {
                            SeqOpt.equal = 1
                        }
                    }
                }
            } ElseBlock: {
                WRMEM_64(args, Multiply(arg_count, 8), arg)
                arg_count = Add(arg_count, 1)
            }
        }
        pos = Add(pos, 1)
    }
    
    Deallocate(args_buffer, 4096)
    
    // seq LAST, seq FIRST LAST, or seq FIRST INCREMENT LAST.
    // Precision is the wider of FIRST and INCREMENT. LAST does not widen it.
    // +inf with a positive step, or -inf with a negative step, does not stop.
    first_s = 0
    step_s = 0
    last_s = 0
    IfCondition EqualTo(arg_count, 1) ThenBlock: {
        last_s = RDMEM_64(args)
    } ElseBlock: {
        IfCondition EqualTo(arg_count, 2) ThenBlock: {
            first_s = RDMEM_64(args)
            last_s = RDMEM_64(args, 8)
        } ElseBlock: {
            IfCondition GreaterEqual(arg_count, 3) ThenBlock: {
                first_s = RDMEM_64(args)
                step_s = RDMEM_64(args, 8)
                last_s = RDMEM_64(args, 16)
            }
        }
    }

    first_frac = 0
    step_frac = 0
    last_kind = 0
    IfCondition NotEqual(first_s, 0) ThenBlock: {
        ClassifyArg(first_s)
        first_frac = SeqOpt.parsed
    }
    IfCondition NotEqual(step_s, 0) ThenBlock: {
        ClassifyArg(step_s)
        step_frac = SeqOpt.parsed
    }
    IfCondition NotEqual(last_s, 0) ThenBlock: {
        last_kind = ClassifyArg(last_s)
    }

    scale = first_frac
    IfCondition GreaterThan(step_frac, scale) ThenBlock: {
        scale = step_frac
    }
    IfCondition GreaterThan(scale, 18) ThenBlock: {
        scale = 18
    }

    Pow10(scale)
    one = SeqOpt.parsed
    IfCondition EqualTo(first_s, 0) ThenBlock: {
        first = one
    } ElseBlock: {
        ParseScaled(first_s, scale)
        first = SeqOpt.parsed
    }
    IfCondition EqualTo(step_s, 0) ThenBlock: {
        increment = one
    } ElseBlock: {
        ParseScaled(step_s, scale)
        increment = SeqOpt.parsed
    }
    last = 0
    IfCondition EqualTo(last_kind, 2) ThenBlock: {
        last_kind = 2
    } ElseBlock: {
        IfCondition EqualTo(last_kind, 3) ThenBlock: {
            last_kind = 3
        } ElseBlock: {
            IfCondition NotEqual(last_s, 0) ThenBlock: {
                ParseScaled(last_s, scale)
                last = SeqOpt.parsed
            }
            last_kind = 0
        }
    }

    IfCondition EqualTo(SeqOpt.equal, 1) ThenBlock: {
        IfCondition EqualTo(scale, 0) ThenBlock: {
            SeqOpt.width = DecDigits(first)
            d2 = DecDigits(last)
            IfCondition GreaterThan(d2, SeqOpt.width) ThenBlock: {
                SeqOpt.width = d2
            }
            SetEqualFormat()
        }
    }

    IfCondition EqualTo(increment, 0) ThenBlock: {
        WriteStderr("seq: invalid Zero increment value: '")
        WriteStderr(step_s)
        WriteStderr("'\n")
        WriteStderr("Try 'seq --help' for more information.\n")
        SystemCall(60, 1)
    }

    // 2 is +inf, 3 is -inf. Anything else is a finite end.
    IfCondition EqualTo(last_kind, 2) ThenBlock: {
        IfCondition GreaterThan(increment, 0) ThenBlock: {
            current = first
            WhileLoop 1 {
                IfCondition GreaterThan(scale, 0) ThenBlock: {
                    WriteScaled(current, scale)
                } ElseBlock: {
                    WriteFormatted(current)
                }
                current = Add(current, increment)
            }
        }
    } ElseBlock: {
        IfCondition EqualTo(last_kind, 3) ThenBlock: {
            IfCondition LessThan(increment, 0) ThenBlock: {
                current = first
                WhileLoop 1 {
                    IfCondition GreaterThan(scale, 0) ThenBlock: {
                        WriteScaled(current, scale)
                    } ElseBlock: {
                        WriteFormatted(current)
                    }
                    current = Add(current, increment)
                }
            }
        } ElseBlock: {
            IfCondition GreaterThan(increment, 0) ThenBlock: {
                current = first
                WhileLoop LessEqual(current, last) {
                    IfCondition GreaterThan(scale, 0) ThenBlock: {
                        WriteScaled(current, scale)
                    } ElseBlock: {
                        WriteFormatted(current)
                    }
                    current = Add(current, increment)
                }
            } ElseBlock: {
                current = first
                WhileLoop GreaterEqual(current, last) {
                    IfCondition GreaterThan(scale, 0) ThenBlock: {
                        WriteScaled(current, scale)
                    } ElseBlock: {
                        WriteFormatted(current)
                    }
                    current = Add(current, increment)
                }
            }
        }
    }
    
    FlushBuffer()
    Deallocate(SeqBuffer.buffer, SeqBuffer.size)
    Deallocate(args, 24)
    SystemCall(60, 0)
}

RunTask(Main)