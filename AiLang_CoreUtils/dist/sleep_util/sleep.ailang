// sleep.ailang - Delay for the sum of the interval operands

LibraryImport.Arena

FixedPool.Slp {
    "sec": Initialize=0
    "nsec": Initialize=0
    "bad": Initialize=0
    "pos": Initialize=0
    "nread": Initialize=0
    "opts": Initialize=1
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buffer = Allocate(4096)
        nread = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        IfCondition LessEqual(nread, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        Slp.nread = nread
        ReturnValue(buffer)
    }
}

Function.HexDig {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
            ReturnValue(Subtract(ch, 48))
        }
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 102)) ThenBlock: {
            ReturnValue(Subtract(ch, 87))
        }
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 70)) ThenBlock: {
            ReturnValue(Subtract(ch, 55))
        }
        ReturnValue(-1)
    }
}

Function.AddTime {
    Input: sec: Integer
    Input: nsec: Integer
    Body: {
        IfCondition GreaterThan(sec, 2000000000) ThenBlock: {
            Slp.sec = 2000000000
            Slp.nsec = 0
            ReturnValue(0)
        }
        extra = Divide(nsec, 1000000000)
        nsec = Modulo(nsec, 1000000000)
        sec = Add(sec, extra)
        sum_ns = Add(Slp.nsec, nsec)
        IfCondition GreaterEqual(sum_ns, 1000000000) ThenBlock: {
            sum_ns = Subtract(sum_ns, 1000000000)
            sec = Add(sec, 1)
        }
        Slp.nsec = sum_ns
        sum_s = Add(Slp.sec, sec)
        IfCondition GreaterThan(sum_s, 2000000000) ThenBlock: {
            sum_s = 2000000000
        }
        Slp.sec = sum_s
        ReturnValue(0)
    }
}

Function.ApplySuffix {
    Input: s: Address
    Input: i: Integer
    Input: sec: Integer
    Input: nsec: Integer
    Output: Integer
    Body: {
        c = GetByte(s, i)
        mult = 1
        IfCondition NotEqual(c, 0) ThenBlock: {
            nxt = GetByte(s, Add(i, 1))
            IfCondition NotEqual(nxt, 0) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(c, 115) ThenBlock: {
                mult = 1
            } ElseBlock: {
                IfCondition EqualTo(c, 109) ThenBlock: {
                    mult = 60
                } ElseBlock: {
                    IfCondition EqualTo(c, 104) ThenBlock: {
                        mult = 3600
                    } ElseBlock: {
                        IfCondition EqualTo(c, 100) ThenBlock: {
                            mult = 86400
                        } ElseBlock: {
                            ReturnValue(1)
                        }
                    }
                }
            }
        }
        IfCondition GreaterThan(sec, 20000) ThenBlock: {
            AddTime(2000000000, 0)
            ReturnValue(0)
        }
        add_s = Multiply(sec, mult)
        add_n = Multiply(nsec, mult)
        carry = Divide(add_n, 1000000000)
        add_n = Modulo(add_n, 1000000000)
        add_s = Add(add_s, carry)
        AddTime(add_s, add_n)
        ReturnValue(0)
    }
}

Function.ParseHex {
    Input: s: Address
    Output: Integer
    Body: {
        i = 2
        intv = 0
        saw = 0
        WhileLoop LessThan(i, 200) {
            d = HexDig(GetByte(s, i))
            IfCondition LessThan(d, 0) ThenBlock: {
                BreakLoop
            }
            intv = Add(Multiply(intv, 16), d)
            saw = 1
            i = Add(i, 1)
        }
        frac = 0
        pow = 0
        ch = GetByte(s, i)
        IfCondition Or(EqualTo(ch, 46), EqualTo(ch, 44)) ThenBlock: {
            i = Add(i, 1)
            WhileLoop LessThan(i, 200) {
                d = HexDig(GetByte(s, i))
                IfCondition LessThan(d, 0) ThenBlock: {
                    BreakLoop
                }
                IfCondition LessThan(pow, 8) ThenBlock: {
                    frac = Add(Multiply(frac, 16), d)
                    pow = Add(pow, 1)
                }
                saw = 1
                i = Add(i, 1)
            }
        }
        exp = 0
        esign = 1
        ch = GetByte(s, i)
        IfCondition Or(EqualTo(ch, 112), EqualTo(ch, 80)) ThenBlock: {
            i = Add(i, 1)
            ch = GetByte(s, i)
            IfCondition EqualTo(ch, 45) ThenBlock: {
                esign = -1
                i = Add(i, 1)
            } ElseBlock: {
                IfCondition EqualTo(ch, 43) ThenBlock: {
                    i = Add(i, 1)
                }
            }
            WhileLoop LessThan(i, 200) {
                ch = GetByte(s, i)
                IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                    BreakLoop
                }
                exp = Add(Multiply(exp, 10), Subtract(ch, 48))
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(saw, 0) ThenBlock: {
            ReturnValue(1)
        }
        num = intv
        k = 0
        WhileLoop LessThan(k, pow) {
            num = Multiply(num, 16)
            k = Add(k, 1)
        }
        num = Add(num, frac)
        shift = exp
        IfCondition EqualTo(esign, -1) ThenBlock: {
            shift = Subtract(0, exp)
        }
        shift = Subtract(shift, Multiply(pow, 4))
        ns = Multiply(num, 1000000000)
        IfCondition GreaterEqual(shift, 0) ThenBlock: {
            WhileLoop GreaterThan(shift, 0) {
                IfCondition GreaterThan(ns, 1000000000) ThenBlock: {
                    AddTime(2000000000, 0)
                    ReturnValue(ApplySuffix(s, i, 0, 0))
                }
                ns = Multiply(ns, 2)
                shift = Subtract(shift, 1)
            }
        } ElseBlock: {
            sh = Subtract(0, shift)
            WhileLoop GreaterThan(sh, 0) {
                ns = Divide(ns, 2)
                sh = Subtract(sh, 1)
            }
        }
        sec = Divide(ns, 1000000000)
        nsec = Modulo(ns, 1000000000)
        bad = ApplySuffix(s, i, sec, nsec)
        ReturnValue(bad)
    }
}

Function.ParseOne {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(GetByte(s, 0), 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(GetByte(s, 0), 45) ThenBlock: {
            ReturnValue(1)
        }
        inf = 0
        IfCondition EqualTo(GetByte(s, 0), 105) ThenBlock: {
            IfCondition EqualTo(GetByte(s, 1), 110) ThenBlock: {
                IfCondition EqualTo(GetByte(s, 2), 102) ThenBlock: {
                    inf = 1
                }
            }
        }
        IfCondition EqualTo(inf, 1) ThenBlock: {
            AddTime(2000000000, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(GetByte(s, 0), 110) ThenBlock: {
            IfCondition EqualTo(GetByte(s, 1), 97) ThenBlock: {
                IfCondition EqualTo(GetByte(s, 2), 110) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(GetByte(s, 0), 48) ThenBlock: {
            c1 = GetByte(s, 1)
            IfCondition Or(EqualTo(c1, 120), EqualTo(c1, 88)) ThenBlock: {
                ReturnValue(ParseHex(s))
            }
        }
        i = 0
        sec = 0
        saw = 0
        WhileLoop LessThan(i, 200) {
            ch = GetByte(s, i)
            IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                BreakLoop
            }
            IfCondition GreaterThan(sec, 200000000) ThenBlock: {
                sec = 2000000000
            } ElseBlock: {
                sec = Add(Multiply(sec, 10), Subtract(ch, 48))
            }
            saw = 1
            i = Add(i, 1)
        }
        nsec = 0
        place = 100000000
        ch = GetByte(s, i)
        IfCondition Or(EqualTo(ch, 46), EqualTo(ch, 44)) ThenBlock: {
            i = Add(i, 1)
            WhileLoop LessThan(i, 200) {
                ch = GetByte(s, i)
                IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                    BreakLoop
                }
                IfCondition GreaterThan(place, 0) ThenBlock: {
                    nsec = Add(nsec, Multiply(Subtract(ch, 48), place))
                    place = Divide(place, 10)
                }
                saw = 1
                i = Add(i, 1)
            }
        }
        // 1.189...e+4932 and 2e1s. A bare "1e" or "1e+" is invalid.
        IfCondition EqualTo(saw, 1) ThenBlock: {
            ch = GetByte(s, i)
            IfCondition Or(EqualTo(ch, 101), EqualTo(ch, 69)) ThenBlock: {
                i = Add(i, 1)
                esign = 1
                ch = GetByte(s, i)
                IfCondition EqualTo(ch, 45) ThenBlock: {
                    esign = -1
                    i = Add(i, 1)
                } ElseBlock: {
                    IfCondition EqualTo(ch, 43) ThenBlock: {
                        i = Add(i, 1)
                    }
                }
                exp = 0
                esaw = 0
                one = 1
                WhileLoop LessThan(i, 400) {
                    ch = GetByte(s, i)
                    IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                        BreakLoop
                    }
                    IfCondition LessThan(exp, 10000) ThenBlock: {
                        exp = Add(Multiply(exp, 10), Subtract(ch, 48))
                    }
                    esaw = 1
                    i = Add(i, one)
                }
                IfCondition EqualTo(esaw, 0) ThenBlock: {
                    ReturnValue(1)
                }
                IfCondition EqualTo(esign, 1) ThenBlock: {
                    big = 0
                    IfCondition GreaterThan(exp, 19) ThenBlock: {
                        IfCondition GreaterThan(sec, 0) ThenBlock: {
                            big = 1
                        }
                        IfCondition GreaterThan(nsec, 0) ThenBlock: {
                            big = 1
                        }
                    }
                    IfCondition EqualTo(big, 1) ThenBlock: {
                        sec = 2000000000
                        nsec = 0
                    } ElseBlock: {
                        k = 0
                        WhileLoop LessThan(k, exp) {
                            IfCondition GreaterThan(sec, 200000000) ThenBlock: {
                                sec = 2000000000
                                nsec = 0
                                BreakLoop
                            }
                            hi = Divide(nsec, 100000000)
                            nsec = Multiply(Modulo(nsec, 100000000), 10)
                            sec = Add(Multiply(sec, 10), hi)
                            k = Add(k, one)
                        }
                    }
                } ElseBlock: {
                    IfCondition GreaterThan(exp, 24) ThenBlock: {
                        sec = 0
                        nsec = 0
                    } ElseBlock: {
                        k = 0
                        WhileLoop LessThan(k, exp) {
                            rem = Modulo(sec, 10)
                            sec = Divide(sec, 10)
                            nsec = Add(Multiply(rem, 100000000), Divide(nsec, 10))
                            k = Add(k, one)
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(saw, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(ApplySuffix(s, i, sec, nsec))
    }
}

SubRoutine.Main {
    args = GetArgs()
    IfCondition EqualTo(args, 0) ThenBlock: {
        SystemCall(60, 1)
    }
    Slp.pos = 0
    WhileLoop NotEqual(GetByte(args, Slp.pos), 0) {
        Slp.pos = Add(Slp.pos, 1)
    }
    Slp.pos = Add(Slp.pos, 1)
    limit = Subtract(Slp.nread, 1)
    count = 0
    WhileLoop LessThan(Slp.pos, limit) {
        ch = GetByte(args, Slp.pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            bad = ParseOne(Add(args, Slp.pos))
            IfCondition EqualTo(bad, 1) ThenBlock: {
                Slp.bad = 1
            }
            count = Add(count, 1)
            Slp.pos = Add(Slp.pos, 1)
        } ElseBlock: {
            arg = Add(args, Slp.pos)
            WhileLoop NotEqual(GetByte(args, Slp.pos), 0) {
                Slp.pos = Add(Slp.pos, 1)
            }
            Slp.pos = Add(Slp.pos, 1)
            skip = 0
            IfCondition EqualTo(Slp.opts, 1) ThenBlock: {
                IfCondition And(EqualTo(GetByte(arg, 0), 45), EqualTo(GetByte(arg, 1), 45)) ThenBlock: {
                    IfCondition EqualTo(GetByte(arg, 2), 0) ThenBlock: {
                        Slp.opts = 0
                        skip = 1
                    }
                }
            }
            IfCondition EqualTo(skip, 0) ThenBlock: {
                bad = ParseOne(arg)
                IfCondition EqualTo(bad, 1) ThenBlock: {
                    Slp.bad = 1
                }
                count = Add(count, 1)
            }
        }
    }
    IfCondition EqualTo(count, 0) ThenBlock: {
        SystemCall(60, 1)
    }
    IfCondition EqualTo(Slp.bad, 1) ThenBlock: {
        SystemCall(60, 1)
    }
    ts = Allocate(16)
    StoreValue(ts, Slp.sec)
    StoreValue(Add(ts, 8), Slp.nsec)
    SystemCall(35, ts, 0)
    Deallocate(ts, 16)
    Deallocate(args, 4096)
    SystemCall(60, 0)
}

RunTask(Main)
