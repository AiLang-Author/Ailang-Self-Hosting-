LibraryImport.AiLang_CoreUtils.dist.sort_util.sort_cmp
LibraryImport.AiLang_CoreUtils.dist.sort_util.sort_parse
LibraryImport.AiLang_CoreUtils.dist.sort_util.sort_run

Function.Err {
    Input: s: Address
    Body: {
        n = StringLength(s)
        SystemCall(1, 2, s, n)
    }
}

Function.ErrChar {
    Input: b: Integer
    Body: {
        WRMEM_8(Ptr.scratch, 0, b)
        WRMEM_8(Ptr.scratch, 1, 0)
        Err(Ptr.scratch)
    }
}

Function.IntToStr {
    Input: num: Integer
    Output: Address
    Body: {
        str = Allocate(32)
        IfCondition EqualTo(num, 0) ThenBlock: {
            WRMEM_8(str, 0, 48)
            WRMEM_8(str, 1, 0)
            ReturnValue(str)
        }
        neg = 0
        absn = num
        IfCondition LessThan(num, 0) ThenBlock: {
            neg = 1
            absn = Subtract(0, num)
        }
        digits = 0
        temp = absn
        WhileLoop GreaterThan(temp, 0) {
            temp = Divide(temp, 10)
            digits = Add(digits, 1)
        }
        total = digits
        IfCondition EqualTo(neg, 1) ThenBlock: {
            total = Add(total, 1)
            WRMEM_8(str, 0, 45)
        }
        i = Subtract(total, 1)
        temp = absn
        WhileLoop GreaterThan(temp, 0) {
            digit = Modulo(temp, 10)
            WRMEM_8(str, i, Add(48, digit))
            temp = Divide(temp, 10)
            i = Subtract(i, 1)
        }
        WRMEM_8(str, total, 0)
        ReturnValue(str)
    }
}

Function.GetErrStr {
    Input: err: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(err, 1) ThenBlock: { ReturnValue("Operation not permitted") }
        IfCondition EqualTo(err, 2) ThenBlock: { ReturnValue("No such file or directory") }
        IfCondition EqualTo(err, 5) ThenBlock: { ReturnValue("Input/output error") }
        IfCondition EqualTo(err, 13) ThenBlock: { ReturnValue("Permission denied") }
        IfCondition EqualTo(err, 16) ThenBlock: { ReturnValue("Device or resource busy") }
        IfCondition EqualTo(err, 17) ThenBlock: { ReturnValue("File exists") }
        IfCondition EqualTo(err, 20) ThenBlock: { ReturnValue("Not a directory") }
        IfCondition EqualTo(err, 21) ThenBlock: { ReturnValue("Is a directory") }
        IfCondition EqualTo(err, 22) ThenBlock: { ReturnValue("Invalid argument") }
        IfCondition EqualTo(err, 24) ThenBlock: { ReturnValue("Too many open files") }
        IfCondition EqualTo(err, 28) ThenBlock: { ReturnValue("No space left on device") }
        IfCondition EqualTo(err, 30) ThenBlock: { ReturnValue("Read-only file system") }
        IfCondition EqualTo(err, 36) ThenBlock: { ReturnValue("File name too long") }
        IfCondition EqualTo(err, 40) ThenBlock: { ReturnValue("Too many levels of symbolic links") }
        ReturnValue("Unknown error")
    }
}

Function.Die {
    Input: code: Integer
    Body: {
        FlushOut()
        SystemCall(60, code)
    }
}

Function.DieMsg {
    Input: kind: Address
    Input: path: Address
    Input: err: Integer
    Body: {
        msg = GetErrStr(err)
        Err("sort: ")
        Err(kind)
        Err(": ")
        Err(path)
        Err(": ")
        Err(msg)
        Err("\n")
        Die(2)
    }
}

Function.TryHelp {
    Body: {
        Err("Try 'sort --help' for more information.\n")
    }
}

Function.OutByte {
    Input: b: Integer
    Body: {
        IfCondition GreaterEqual(Opt.obuf_n, 65532) ThenBlock: {
            FlushOut()
        }
        WRMEM_8(Ptr.obuf, Opt.obuf_n, b)
        one = 1
        Opt.obuf_n = Add(Opt.obuf_n, one)
    }
}

Function.OutStr {
    Input: s: Address
    Body: {
        one = 1
        i = 0
        WhileLoop 1 {
            ch = RDMEM_8(s, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            OutByte(ch)
            i = Add(i, one)
        }
    }
}

Function.FlushOut {
    Body: {
        IfCondition GreaterThan(Opt.obuf_n, 0) ThenBlock: {
            SystemCall(1, Work.wfd, Ptr.obuf, Opt.obuf_n)
            Opt.obuf_n = 0
        }
    }
}

Function.Bucket {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(n, 32) ThenBlock: { ReturnValue(32) }
        IfCondition LessEqual(n, 64) ThenBlock: { ReturnValue(64) }
        IfCondition LessEqual(n, 128) ThenBlock: { ReturnValue(128) }
        IfCondition LessEqual(n, 256) ThenBlock: { ReturnValue(256) }
        IfCondition LessEqual(n, 512) ThenBlock: { ReturnValue(512) }
        IfCondition LessEqual(n, 1024) ThenBlock: { ReturnValue(1024) }
        IfCondition LessEqual(n, 2048) ThenBlock: { ReturnValue(2048) }
        IfCondition LessEqual(n, 4096) ThenBlock: { ReturnValue(4096) }
        IfCondition LessEqual(n, 8192) ThenBlock: { ReturnValue(8192) }
        IfCondition LessEqual(n, 16384) ThenBlock: { ReturnValue(16384) }
        IfCondition LessEqual(n, 32768) ThenBlock: { ReturnValue(32768) }
        IfCondition LessEqual(n, 65536) ThenBlock: { ReturnValue(65536) }
        IfCondition LessEqual(n, 131072) ThenBlock: { ReturnValue(131072) }
        IfCondition LessEqual(n, 262144) ThenBlock: { ReturnValue(262144) }
        IfCondition LessEqual(n, 524288) ThenBlock: { ReturnValue(524288) }
        IfCondition LessEqual(n, 1048576) ThenBlock: { ReturnValue(1048576) }
        IfCondition LessEqual(n, 2097152) ThenBlock: { ReturnValue(2097152) }
        IfCondition LessEqual(n, 4194304) ThenBlock: { ReturnValue(4194304) }
        ReturnValue(8388608)
    }
}

Function.CEq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        one = 1
        i = 0
        WhileLoop 1 {
            ca = RDMEM_8(a, i)
            cb = RDMEM_8(b, i)
            IfCondition NotEqual(ca, cb) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(ca, 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.IsPre {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        one = 1
        i = 0
        WhileLoop 1 {
            ca = RDMEM_8(a, i)
            IfCondition EqualTo(ca, 0) ThenBlock: {
                ReturnValue(1)
            }
            cb = RDMEM_8(b, i)
            IfCondition NotEqual(ca, cb) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.ReadI32 {
    Input: buf: Address
    Input: off: Integer
    Output: Integer
    Body: {
        b0 = RDMEM_8(buf, off)
        o1 = Add(off, 1)
        b1 = RDMEM_8(buf, o1)
        o2 = Add(off, 2)
        b2 = RDMEM_8(buf, o2)
        o3 = Add(off, 3)
        b3 = RDMEM_8(buf, o3)
        v = b0
        v = Add(v, Multiply(b1, 256))
        v = Add(v, Multiply(b2, 65536))
        v = Add(v, Multiply(b3, 16777216))
        Work.val = v
        ReturnValue(Work.val)
    }
}

Function.InitAll {
    Body: {
        Ptr.keys = Allocate(4096)
        Ptr.months = Allocate(128)
        Ptr.lines = Allocate(2097152)
        Ptr.lines2 = Allocate(2097152)
        Ptr.numbuf = Allocate(512)
        Ptr.numbuf2 = Allocate(512)
        Ptr.norm = Allocate(4096)
        Ptr.norm2 = Allocate(4096)
        Ptr.vlin = Allocate(8192)
        Ptr.vlin2 = Allocate(8192)
        Ptr.optbuf = Allocate(64)
        Ptr.args = Allocate(32768)
        Ptr.files = Allocate(32768)
        Ptr.obuf = Allocate(65536)
        Ptr.env = Allocate(65536)
        Ptr.envp = Allocate(8192)
        Ptr.cmd = Allocate(1048576)
        Ptr.spawn = Allocate(32)
        Ptr.rdbuf = Allocate(262144)
        Ptr.carry = Allocate(1048576)
        Ptr.progpath = Allocate(4096)
        Ptr.scratch = Allocate(256)
        Opt.tmpdir = "/tmp"
        Opt.batch = 16
        Opt.eol = 10
        Opt.posix2 = 200809
        Opt.traditional = 1
        Opt.cap_lines = 262144
        Opt.seed = 1
        Opt.parallel = 1
        InitKey(0)
        InstallMonths()
        Work.wfd = 1
        WRMEM_64(Ptr.envp, 0)
    }
}

SubRoutine.Main {
    InitAll()
    LoadEnviron()
    LoadArgs()
    ParseArgs()
    RunSort()
}

RunTask(Main)
