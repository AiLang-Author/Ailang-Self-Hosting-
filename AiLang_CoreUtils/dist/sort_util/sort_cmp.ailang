// Comparison, keys, months, debug underlines, and warnings for sort.
// Pools live on sort.ailang. No pool declarations in this file.
// Key slot is 16 int64s: sword, schar, eword, echar, skips, skipe,
// ignore, fold, numeric, general, human, month, version, random,
// reverse, traditional. -1 is SIZE_MAX. User keys are 1..nkeys.

Function.LineLen {
    Input: line: Address
    Output: Integer
    Body: {
        n = RDMEM_64(line)
        Opt.tmp = n
        ReturnValue(Opt.tmp)
    }
}

Function.ByteOf {
    Input: line: Address
    Input: off: Integer
    Output: Integer
    Body: {
        b = RDMEM_8(line, Add(16, off))
        Opt.ch = b
        ReturnValue(Opt.ch)
    }
}

Function.KeyAddr {
    Input: ki: Integer
    Input: field: Integer
    Output: Address
    Body: {
        off = Multiply(Add(Multiply(ki, 16), field), 8)
        p = Add(Ptr.keys, off)
        ReturnValue(p)
    }
}

Function.KeyGet {
    Input: ki: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        p = KeyAddr(ki, field)
        v = RDMEM_64(p)
        Opt.tmp = v
        ReturnValue(Opt.tmp)
    }
}

Function.KeySet {
    Input: ki: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        p = KeyAddr(ki, field)
        WRMEM_64(p, val)
    }
}

Function.InitKey {
    Input: ki: Integer
    Body: {
        KeySet(ki, 0, -1)
        KeySet(ki, 1, 0)
        KeySet(ki, 2, -1)
        KeySet(ki, 3, 0)
        one = 1
        f = 4
        WhileLoop LessThan(f, 16) {
            KeySet(ki, f, 0)
            f = Add(f, one)
        }
    }
}

Function.IsDigit {
    Input: ch: Integer
    Output: Integer
    Body: {
        ok = And(GreaterEqual(ch, 48), LessEqual(ch, 57))
        ReturnValue(ok)
    }
}

Function.IsAlpha {
    Input: ch: Integer
    Output: Integer
    Body: {
        up = And(GreaterEqual(ch, 65), LessEqual(ch, 90))
        lo = And(GreaterEqual(ch, 97), LessEqual(ch, 122))
        ok = Or(EqualTo(up, 1), EqualTo(lo, 1))
        ReturnValue(ok)
    }
}

Function.IsAlnum {
    Input: ch: Integer
    Output: Integer
    Body: {
        d = IsDigit(ch)
        a = IsAlpha(ch)
        ok = Or(EqualTo(d, 1), EqualTo(a, 1))
        ReturnValue(ok)
    }
}

Function.IsBlank {
    Input: ch: Integer
    Output: Integer
    Body: {
        sp = EqualTo(ch, 32)
        tb = EqualTo(ch, 9)
        nl = EqualTo(ch, 10)
        ok = Or(EqualTo(sp, 1), Or(EqualTo(tb, 1), EqualTo(nl, 1)))
        ReturnValue(ok)
    }
}

Function.FoldByte {
    Input: ch: Integer
    Output: Integer
    Body: {
        lo = And(GreaterEqual(ch, 97), LessEqual(ch, 122))
        IfCondition EqualTo(lo, 1) ThenBlock: {
            ReturnValue(Subtract(ch, 32))
        }
        ReturnValue(ch)
    }
}

Function.StrLen {
    Input: str: Address
    Output: Integer
    Body: {
        one = 1
        n = 0
        WhileLoop NotEqual(RDMEM_8(str, n), 0) {
            n = Add(n, one)
        }
        Opt.tmp = n
        ReturnValue(Opt.tmp)
    }
}

Function.BegOff {
    Input: line: Address
    Input: ki: Integer
    Output: Integer
    Body: {
        one = 1
        len = LineLen(line)
        ptr = 0
        sword = KeyGet(ki, 0)
        IfCondition EqualTo(sword, -1) ThenBlock: {
            sword = 0
        }
        WhileLoop And(LessThan(ptr, len), GreaterThan(sword, 0)) {
            IfCondition EqualTo(Opt.tab_set, 1) ThenBlock: {
                WhileLoop LessThan(ptr, len) {
                    ch = ByteOf(line, ptr)
                    IfCondition EqualTo(ch, Opt.tab) ThenBlock: {
                        BreakLoop
                    }
                    ptr = Add(ptr, one)
                }
            } ElseBlock: {
                WhileLoop LessThan(ptr, len) {
                    ch = ByteOf(line, ptr)
                    bk = IsBlank(ch)
                    IfCondition EqualTo(bk, 0) ThenBlock: {
                        BreakLoop
                    }
                    ptr = Add(ptr, one)
                }
                WhileLoop LessThan(ptr, len) {
                    ch = ByteOf(line, ptr)
                    bk = IsBlank(ch)
                    IfCondition EqualTo(bk, 1) ThenBlock: {
                        BreakLoop
                    }
                    ptr = Add(ptr, one)
                }
            }
            step = And(EqualTo(Opt.tab_set, 1), LessThan(ptr, len))
            ptr = Add(ptr, step)
            sword = Subtract(sword, one)
        }
        sk = KeyGet(ki, 4)
        IfCondition EqualTo(sk, 1) ThenBlock: {
            WhileLoop LessThan(ptr, len) {
                ch = ByteOf(line, ptr)
                bk = IsBlank(ch)
                IfCondition EqualTo(bk, 0) ThenBlock: {
                    BreakLoop
                }
                ptr = Add(ptr, one)
            }
        }
        schar = KeyGet(ki, 1)
        room = Subtract(len, ptr)
        IfCondition GreaterThan(schar, room) ThenBlock: {
            ptr = len
        } ElseBlock: {
            ptr = Add(ptr, schar)
        }
        Opt.tmp = ptr
        ReturnValue(Opt.tmp)
    }
}

Function.LimOff {
    Input: line: Address
    Input: ki: Integer
    Output: Integer
    Body: {
        one = 1
        len = LineLen(line)
        ptr = 0
        eword = KeyGet(ki, 2)
        echar = KeyGet(ki, 3)
        IfCondition EqualTo(echar, 0) ThenBlock: {
            eword = Add(eword, one)
        }
        left = eword
        WhileLoop And(LessThan(ptr, len), GreaterThan(left, 0)) {
            IfCondition EqualTo(Opt.tab_set, 1) ThenBlock: {
                WhileLoop LessThan(ptr, len) {
                    ch = ByteOf(line, ptr)
                    IfCondition EqualTo(ch, Opt.tab) ThenBlock: {
                        BreakLoop
                    }
                    ptr = Add(ptr, one)
                }
                left = Subtract(left, one)
                step = 0
                IfCondition LessThan(ptr, len) ThenBlock: {
                    IfCondition GreaterThan(left, 0) ThenBlock: {
                        step = 1
                    }
                    IfCondition NotEqual(echar, 0) ThenBlock: {
                        step = 1
                    }
                }
                IfCondition EqualTo(step, 1) ThenBlock: {
                    ptr = Add(ptr, one)
                }
            } ElseBlock: {
                WhileLoop LessThan(ptr, len) {
                    ch = ByteOf(line, ptr)
                    bk = IsBlank(ch)
                    IfCondition EqualTo(bk, 0) ThenBlock: {
                        BreakLoop
                    }
                    ptr = Add(ptr, one)
                }
                WhileLoop LessThan(ptr, len) {
                    ch = ByteOf(line, ptr)
                    bk = IsBlank(ch)
                    IfCondition EqualTo(bk, 1) ThenBlock: {
                        BreakLoop
                    }
                    ptr = Add(ptr, one)
                }
                left = Subtract(left, one)
            }
        }
        IfCondition NotEqual(echar, 0) ThenBlock: {
            se = KeyGet(ki, 5)
            IfCondition EqualTo(se, 1) ThenBlock: {
                WhileLoop LessThan(ptr, len) {
                    ch = ByteOf(line, ptr)
                    bk = IsBlank(ch)
                    IfCondition EqualTo(bk, 0) ThenBlock: {
                        BreakLoop
                    }
                    ptr = Add(ptr, one)
                }
            }
            room = Subtract(len, ptr)
            IfCondition GreaterThan(echar, room) ThenBlock: {
                ptr = len
            } ElseBlock: {
                ptr = Add(ptr, echar)
            }
        }
        Opt.tmp = ptr
        ReturnValue(Opt.tmp)
    }
}

Function.KeyEnds {
    Input: line: Address
    Input: ki: Integer
    Body: {
        len = LineLen(line)
        sw = KeyGet(ki, 0)
        ew = KeyGet(ki, 2)
        IfCondition EqualTo(ew, -1) ThenBlock: {
            Opt.lim = len
        } ElseBlock: {
            Opt.lim = LimOff(line, ki)
        }
        IfCondition EqualTo(sw, -1) ThenBlock: {
            Opt.beg = 0
            sk = KeyGet(ki, 4)
            IfCondition EqualTo(sk, 1) ThenBlock: {
                one = 1
                ptr = 0
                lim = Opt.lim
                WhileLoop LessThan(ptr, lim) {
                    ch = ByteOf(line, ptr)
                    bk = IsBlank(ch)
                    IfCondition EqualTo(bk, 0) ThenBlock: {
                        BreakLoop
                    }
                    ptr = Add(ptr, one)
                }
                Opt.beg = ptr
            }
        } ElseBlock: {
            Opt.beg = BegOff(line, ki)
        }
    }
}

Function.FillKey {
    Input: str: Address
    Body: {
        buf = Allocate(128)
        one = 1
        NumKey.pos = 0
        WhileLoop 1 {
            ch = RDMEM_8(str, NumKey.pos)
            blank = Or(EqualTo(ch, 32), Or(EqualTo(ch, 9), EqualTo(ch, 10)))
            IfCondition EqualTo(blank, 0) ThenBlock: {
                BreakLoop
            }
            NumKey.pos = Add(NumKey.pos, one)
        }
        sign = 1
        ch = RDMEM_8(str, NumKey.pos)
        IfCondition EqualTo(ch, 45) ThenBlock: {
            sign = -1
            NumKey.pos = Add(NumKey.pos, one)
        } ElseBlock: {
            IfCondition EqualTo(ch, 43) ThenBlock: {
                NumKey.pos = Add(NumKey.pos, one)
            }
        }
        seen_dot = 0
        NumKey.int_sig = 0
        NumKey.frac_zeros = 0
        NumKey.len = 0
        WhileLoop 1 {
            ch = RDMEM_8(str, NumKey.pos)
            is_digit = And(GreaterEqual(ch, 48), LessEqual(ch, 57))
            IfCondition EqualTo(is_digit, 1) ThenBlock: {
                lead_zero = And(EqualTo(ch, 48), EqualTo(NumKey.len, 0))
                IfCondition EqualTo(lead_zero, 1) ThenBlock: {
                    IfCondition EqualTo(seen_dot, 1) ThenBlock: {
                        NumKey.frac_zeros = Add(NumKey.frac_zeros, one)
                    }
                } ElseBlock: {
                    IfCondition LessThan(NumKey.len, 127) ThenBlock: {
                        WRMEM_8(buf, NumKey.len, ch)
                        NumKey.len = Add(NumKey.len, one)
                    }
                    IfCondition EqualTo(seen_dot, 0) ThenBlock: {
                        NumKey.int_sig = Add(NumKey.int_sig, one)
                    }
                }
                NumKey.pos = Add(NumKey.pos, one)
            } ElseBlock: {
                dot = And(EqualTo(ch, 46), EqualTo(seen_dot, 0))
                IfCondition EqualTo(dot, 1) ThenBlock: {
                    seen_dot = 1
                    NumKey.pos = Add(NumKey.pos, one)
                } ElseBlock: {
                    BreakLoop
                }
            }
        }
        NumKey.exp_add = 0
        IfCondition EqualTo(Opt.general_fill, 1) ThenBlock: {
            ch = RDMEM_8(str, NumKey.pos)
            is_exp = Or(EqualTo(ch, 101), EqualTo(ch, 69))
            IfCondition EqualTo(is_exp, 1) ThenBlock: {
                NumKey.pos = Add(NumKey.pos, one)
                exp_sign = 1
                ch = RDMEM_8(str, NumKey.pos)
                IfCondition EqualTo(ch, 45) ThenBlock: {
                    exp_sign = -1
                    NumKey.pos = Add(NumKey.pos, one)
                } ElseBlock: {
                    IfCondition EqualTo(ch, 43) ThenBlock: {
                        NumKey.pos = Add(NumKey.pos, one)
                    }
                }
                WhileLoop 1 {
                    ch = RDMEM_8(str, NumKey.pos)
                    is_digit = And(GreaterEqual(ch, 48), LessEqual(ch, 57))
                    IfCondition EqualTo(is_digit, 0) ThenBlock: {
                        BreakLoop
                    }
                    digit = Subtract(ch, 48)
                    NumKey.exp_add = Add(Multiply(NumKey.exp_add, 10), digit)
                    NumKey.pos = Add(NumKey.pos, one)
                }
                IfCondition EqualTo(exp_sign, -1) ThenBlock: {
                    NumKey.exp_add = Subtract(0, NumKey.exp_add)
                }
            }
        }
        WhileLoop And(GreaterThan(NumKey.len, 0), EqualTo(RDMEM_8(buf, Subtract(NumKey.len, 1)), 48)) {
            NumKey.len = Subtract(NumKey.len, one)
        }
        IfCondition EqualTo(NumKey.len, 0) ThenBlock: {
            NumKey.sign = 0
            NumKey.exp = 0
        } ElseBlock: {
            NumKey.sign = sign
            IfCondition GreaterThan(NumKey.int_sig, 0) ThenBlock: {
                NumKey.exp = Add(Subtract(NumKey.int_sig, 1), NumKey.exp_add)
            } ElseBlock: {
                NumKey.exp = Subtract(NumKey.exp_add, Add(NumKey.frac_zeros, 1))
            }
        }
        WRMEM_8(buf, NumKey.len, 0)
        NumKey.digits = buf
    }
}

Function.CompareDecimal {
    Input: str1: Address
    Input: str2: Address
    Output: Integer
    Body: {
        FillKey(str1)
        sign1 = NumKey.sign
        exp1 = NumKey.exp
        len1 = NumKey.len
        dig1 = NumKey.digits
        FillKey(str2)
        sign2 = NumKey.sign
        exp2 = NumKey.exp
        len2 = NumKey.len
        dig2 = NumKey.digits
        cmp = 0
        IfCondition LessThan(sign1, sign2) ThenBlock: {
            cmp = -1
        }
        IfCondition GreaterThan(sign1, sign2) ThenBlock: {
            cmp = 1
        }
        same = EqualTo(sign1, sign2)
        IfCondition And(EqualTo(same, 1), NotEqual(sign1, 0)) ThenBlock: {
            NumKey.cmp = 0
            IfCondition LessThan(exp1, exp2) ThenBlock: {
                NumKey.cmp = -1
            }
            IfCondition GreaterThan(exp1, exp2) ThenBlock: {
                NumKey.cmp = 1
            }
            IfCondition EqualTo(exp1, exp2) ThenBlock: {
                one = 1
                k = 0
                limit = len1
                IfCondition LessThan(len2, len1) ThenBlock: {
                    limit = len2
                }
                WhileLoop LessThan(k, limit) {
                    b1 = RDMEM_8(dig1, k)
                    b2 = RDMEM_8(dig2, k)
                    IfCondition LessThan(b1, b2) ThenBlock: {
                        NumKey.cmp = -1
                        BreakLoop
                    }
                    IfCondition GreaterThan(b1, b2) ThenBlock: {
                        NumKey.cmp = 1
                        BreakLoop
                    }
                    k = Add(k, one)
                }
                IfCondition EqualTo(NumKey.cmp, 0) ThenBlock: {
                    IfCondition LessThan(len1, len2) ThenBlock: {
                        NumKey.cmp = -1
                    }
                    IfCondition GreaterThan(len1, len2) ThenBlock: {
                        NumKey.cmp = 1
                    }
                }
            }
            IfCondition EqualTo(sign1, -1) ThenBlock: {
                NumKey.cmp = Subtract(0, NumKey.cmp)
            }
            cmp = NumKey.cmp
        }
        Deallocate(dig1, 128)
        Deallocate(dig2, 128)
        Opt.diff = cmp
        ReturnValue(Opt.diff)
    }
}

Function.CopyZ {
    Input: line: Address
    Input: beg: Integer
    Input: n: Integer
    Input: dest: Address
    Body: {
        one = 1
        i = 0
        lim = n
        IfCondition GreaterThan(lim, 511) ThenBlock: {
            lim = 511
        }
        WhileLoop LessThan(i, lim) {
            off = Add(beg, i)
            ch = ByteOf(line, off)
            WRMEM_8(dest, i, ch)
            i = Add(i, one)
        }
        WRMEM_8(dest, i, 0)
        Opt.copy_n = i
    }
}

Function.UnitOf {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(ch, 107), EqualTo(ch, 75)) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 77) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(ch, 71) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(ch, 84) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(ch, 80) ThenBlock: { ReturnValue(5) }
        IfCondition EqualTo(ch, 69) ThenBlock: { ReturnValue(6) }
        IfCondition EqualTo(ch, 90) ThenBlock: { ReturnValue(7) }
        IfCondition EqualTo(ch, 89) ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(ch, 82) ThenBlock: { ReturnValue(9) }
        IfCondition EqualTo(ch, 81) ThenBlock: { ReturnValue(10) }
        ReturnValue(0)
    }
}

Function.UnitOrder {
    Input: str: Address
    Output: Integer
    Body: {
        one = 1
        i = 0
        WhileLoop 1 {
            ch = RDMEM_8(str, i)
            blank = Or(EqualTo(ch, 32), Or(EqualTo(ch, 9), EqualTo(ch, 10)))
            IfCondition EqualTo(blank, 0) ThenBlock: {
                BreakLoop
            }
            i = Add(i, one)
        }
        minus = 0
        ch = RDMEM_8(str, i)
        IfCondition EqualTo(ch, 45) ThenBlock: {
            minus = 1
            i = Add(i, one)
        }
        maxd = 0
        WhileLoop 1 {
            ch = RDMEM_8(str, i)
            dig = IsDigit(ch)
            IfCondition EqualTo(dig, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition GreaterThan(ch, maxd) ThenBlock: {
                maxd = ch
            }
            i = Add(i, one)
        }
        ch = RDMEM_8(str, i)
        IfCondition EqualTo(ch, 46) ThenBlock: {
            i = Add(i, one)
            WhileLoop 1 {
                ch = RDMEM_8(str, i)
                dig = IsDigit(ch)
                IfCondition EqualTo(dig, 0) ThenBlock: {
                    BreakLoop
                }
                IfCondition GreaterThan(ch, maxd) ThenBlock: {
                    maxd = ch
                }
                i = Add(i, one)
            }
        }
        order = 0
        IfCondition GreaterThan(maxd, 48) ThenBlock: {
            ch = RDMEM_8(str, i)
            order = UnitOf(ch)
        }
        IfCondition EqualTo(minus, 1) ThenBlock: {
            order = Subtract(0, order)
        }
        Opt.tmp = order
        ReturnValue(Opt.tmp)
    }
}

Function.HasPrefix {
    Input: str: Address
    Input: i: Integer
    Input: word: Address
    Output: Integer
    Body: {
        one = 1
        j = 0
        WhileLoop 1 {
            wc = RDMEM_8(word, j)
            IfCondition EqualTo(wc, 0) ThenBlock: {
                ReturnValue(1)
            }
            sc = RDMEM_8(str, Add(i, j))
            sf = FoldByte(sc)
            wf = FoldByte(wc)
            IfCondition NotEqual(sf, wf) ThenBlock: {
                ReturnValue(0)
            }
            j = Add(j, one)
        }
        ReturnValue(0)
    }
}

Function.GenClass {
    Input: str: Address
    Output: Integer
    Body: {
        one = 1
        i = 0
        WhileLoop 1 {
            ch = RDMEM_8(str, i)
            blank = Or(EqualTo(ch, 32), Or(EqualTo(ch, 9), EqualTo(ch, 10)))
            IfCondition EqualTo(blank, 0) ThenBlock: {
                BreakLoop
            }
            i = Add(i, one)
        }
        ch = RDMEM_8(str, i)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(ch, 45) ThenBlock: {
            i = Add(i, one)
        } ElseBlock: {
            IfCondition EqualTo(ch, 43) ThenBlock: {
                i = Add(i, one)
            }
        }
        infp = HasPrefix(str, i, "inf")
        IfCondition EqualTo(infp, 1) ThenBlock: {
            k = 0
            WhileLoop 1 {
                ch = RDMEM_8(str, k)
                blank = Or(EqualTo(ch, 32), Or(EqualTo(ch, 9), EqualTo(ch, 10)))
                IfCondition EqualTo(blank, 0) ThenBlock: {
                    BreakLoop
                }
                k = Add(k, one)
            }
            ch = RDMEM_8(str, k)
            IfCondition EqualTo(ch, 45) ThenBlock: {
                ReturnValue(2)
            }
            ReturnValue(4)
        }
        nanp = HasPrefix(str, i, "nan")
        IfCondition EqualTo(nanp, 1) ThenBlock: {
            ReturnValue(1)
        }
        saw = 0
        ch = RDMEM_8(str, i)
        dig = IsDigit(ch)
        IfCondition EqualTo(dig, 1) ThenBlock: {
            saw = 1
        }
        IfCondition EqualTo(ch, 46) ThenBlock: {
            nxt = RDMEM_8(str, Add(i, one))
            nd = IsDigit(nxt)
            IfCondition EqualTo(nd, 1) ThenBlock: {
                saw = 1
            }
        }
        IfCondition EqualTo(saw, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Distinguish -inf. The byte before the prefix is the sign if we stepped.
        // Recompute sign from the first nonblank.
        j = 0
        WhileLoop 1 {
            ch = RDMEM_8(str, j)
            blank = Or(EqualTo(ch, 32), Or(EqualTo(ch, 9), EqualTo(ch, 10)))
            IfCondition EqualTo(blank, 0) ThenBlock: {
                BreakLoop
            }
            j = Add(j, one)
        }
        ch = RDMEM_8(str, j)
        IfCondition EqualTo(ch, 45) ThenBlock: {
            j = Add(j, one)
        } ElseBlock: {
            IfCondition EqualTo(ch, 43) ThenBlock: {
                j = Add(j, one)
            }
        }
        inf2 = HasPrefix(str, j, "inf")
        IfCondition EqualTo(inf2, 1) ThenBlock: {
            ch = RDMEM_8(str, 0)
            k = 0
            WhileLoop 1 {
                ch = RDMEM_8(str, k)
                blank = Or(EqualTo(ch, 32), Or(EqualTo(ch, 9), EqualTo(ch, 10)))
                IfCondition EqualTo(blank, 0) ThenBlock: {
                    BreakLoop
                }
                k = Add(k, one)
            }
            ch = RDMEM_8(str, k)
            IfCondition EqualTo(ch, 45) ThenBlock: {
                ReturnValue(2)
            }
            ReturnValue(4)
        }
        ReturnValue(3)
    }
}

Function.StoreMonth {
    Input: idx: Integer
    Input: s: Address
    Body: {
        WRMEM_64(Ptr.months, Multiply(idx, 8), s)
    }
}

Function.InstallMonths {
    Body: {
        StoreMonth(0, "JAN")
        StoreMonth(1, "FEB")
        StoreMonth(2, "MAR")
        StoreMonth(3, "APR")
        StoreMonth(4, "MAY")
        StoreMonth(5, "JUN")
        StoreMonth(6, "JUL")
        StoreMonth(7, "AUG")
        StoreMonth(8, "SEP")
        StoreMonth(9, "OCT")
        StoreMonth(10, "NOV")
        StoreMonth(11, "DEC")
        Opt.months_ready = 1
    }
}

Function.MonthLoad {
    Input: buf: Address
    Input: n: Integer
    Body: {
        IfCondition LessEqual(n, 0) ThenBlock: {
            InstallMonths()
            ReturnValue(0)
        }
        one = 1
        i = 0
        part = 0
        start = 0
        ok = 1
        WhileLoop And(LessThan(i, n), LessThan(part, 12)) {
            ch = RDMEM_8(buf, i)
            cut = Or(EqualTo(ch, 59), EqualTo(ch, 10))
            IfCondition EqualTo(cut, 1) ThenBlock: {
                // copy start..i, drop blanks, fold ASCII
                raw = Subtract(i, start)
                tmp = Allocate(64)
                j = 0
                k = 0
                WhileLoop LessThan(j, raw) {
                    c = RDMEM_8(buf, Add(start, j))
                    bk = Or(EqualTo(c, 32), EqualTo(c, 9))
                    IfCondition EqualTo(bk, 0) ThenBlock: {
                        c = FoldByte(c)
                        WRMEM_8(tmp, k, c)
                        k = Add(k, one)
                    }
                    j = Add(j, one)
                }
                WRMEM_8(tmp, k, 0)
                IfCondition EqualTo(k, 0) ThenBlock: {
                    ok = 0
                }
                StoreMonth(part, tmp)
                part = Add(part, one)
                i = Add(i, one)
                start = i
            } ElseBlock: {
                i = Add(i, one)
            }
        }
        IfCondition And(LessThan(part, 12), LessThan(start, n)) ThenBlock: {
            raw = Subtract(n, start)
            tmp = Allocate(64)
            j = 0
            k = 0
            WhileLoop LessThan(j, raw) {
                c = RDMEM_8(buf, Add(start, j))
                IfCondition EqualTo(c, 10) ThenBlock: {
                    c = 0
                }
                IfCondition NotEqual(c, 0) ThenBlock: {
                    bk = Or(EqualTo(c, 32), EqualTo(c, 9))
                    IfCondition EqualTo(bk, 0) ThenBlock: {
                        c = FoldByte(c)
                        WRMEM_8(tmp, k, c)
                        k = Add(k, one)
                    }
                }
                j = Add(j, one)
            }
            WRMEM_8(tmp, k, 0)
            IfCondition GreaterThan(k, 0) ThenBlock: {
                StoreMonth(part, tmp)
                part = Add(part, one)
            }
        }
        IfCondition NotEqual(part, 12) ThenBlock: {
            ok = 0
        }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            InstallMonths()
        } ElseBlock: {
            Opt.months_ready = 1
        }
        ReturnValue(0)
    }
}

Function.MonthOf {
    Input: str: Address
    Output: Integer
    Body: {
        one = 1
        i = 0
        WhileLoop 1 {
            ch = RDMEM_8(str, i)
            blank = Or(EqualTo(ch, 32), Or(EqualTo(ch, 9), EqualTo(ch, 10)))
            IfCondition EqualTo(blank, 0) ThenBlock: {
                BreakLoop
            }
            i = Add(i, one)
        }
        best = 0
        bestn = 0
        m = 0
        WhileLoop LessThan(m, 12) {
            name = RDMEM_64(Ptr.months, Multiply(m, 8))
            nl = StrLen(name)
            IfCondition GreaterThan(nl, bestn) ThenBlock: {
                j = 0
                match = 1
                WhileLoop LessThan(j, nl) {
                    sc = RDMEM_8(str, Add(i, j))
                    sf = FoldByte(sc)
                    nc = RDMEM_8(name, j)
                    IfCondition NotEqual(sf, nc) ThenBlock: {
                        match = 0
                        BreakLoop
                    }
                    j = Add(j, one)
                }
                IfCondition EqualTo(match, 1) ThenBlock: {
                    best = Add(m, one)
                    bestn = nl
                }
            }
            m = Add(m, one)
        }
        Opt.month_val = best
        Opt.copy_n = bestn
        ReturnValue(best)
    }
}

Function.OrderAt {
    Input: line: Address
    Input: base: Integer
    Input: len: Integer
    Input: pos: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(pos, len) ThenBlock: {
            ReturnValue(-1)
        }
        c = ByteOf(line, Add(base, pos))
        d = IsDigit(c)
        IfCondition EqualTo(d, 1) ThenBlock: {
            ReturnValue(0)
        }
        a = IsAlpha(c)
        IfCondition EqualTo(a, 1) ThenBlock: {
            ReturnValue(c)
        }
        IfCondition EqualTo(c, 126) ThenBlock: {
            ReturnValue(-2)
        }
        ReturnValue(Add(c, 256))
    }
}

Function.VerRev {
    Input: la: Address
    Input: ba: Integer
    Input: na: Integer
    Input: lb: Address
    Input: bb: Integer
    Input: nb: Integer
    Output: Integer
    Body: {
        one = 1
        p1 = 0
        p2 = 0
        WhileLoop 1 {
            done = And(GreaterEqual(p1, na), GreaterEqual(p2, nb))
            IfCondition EqualTo(done, 1) ThenBlock: {
                BreakLoop
            }
            WhileLoop 1 {
                d1 = 0
                d2 = 0
                IfCondition LessThan(p1, na) ThenBlock: {
                    ch = ByteOf(la, Add(ba, p1))
                    d1 = IsDigit(ch)
                }
                IfCondition LessThan(p2, nb) ThenBlock: {
                    ch = ByteOf(lb, Add(bb, p2))
                    d2 = IsDigit(ch)
                }
                left = 0
                IfCondition And(LessThan(p1, na), EqualTo(d1, 0)) ThenBlock: {
                    left = 1
                }
                right = 0
                IfCondition And(LessThan(p2, nb), EqualTo(d2, 0)) ThenBlock: {
                    right = 1
                }
                go = Or(EqualTo(left, 1), EqualTo(right, 1))
                IfCondition EqualTo(go, 0) ThenBlock: {
                    BreakLoop
                }
                c1 = OrderAt(la, ba, na, p1)
                c2 = OrderAt(lb, bb, nb, p2)
                IfCondition NotEqual(c1, c2) ThenBlock: {
                    Opt.diff = Subtract(c1, c2)
                    ReturnValue(Opt.diff)
                }
                p1 = Add(p1, one)
                p2 = Add(p2, one)
            }
            WhileLoop LessThan(p1, na) {
                ch = ByteOf(la, Add(ba, p1))
                IfCondition NotEqual(ch, 48) ThenBlock: {
                    BreakLoop
                }
                p1 = Add(p1, one)
            }
            WhileLoop LessThan(p2, nb) {
                ch = ByteOf(lb, Add(bb, p2))
                IfCondition NotEqual(ch, 48) ThenBlock: {
                    BreakLoop
                }
                p2 = Add(p2, one)
            }
            first = 0
            WhileLoop 1 {
                d1 = 0
                d2 = 0
                IfCondition LessThan(p1, na) ThenBlock: {
                    ch = ByteOf(la, Add(ba, p1))
                    d1 = IsDigit(ch)
                }
                IfCondition LessThan(p2, nb) ThenBlock: {
                    ch = ByteOf(lb, Add(bb, p2))
                    d2 = IsDigit(ch)
                }
                both = And(EqualTo(d1, 1), EqualTo(d2, 1))
                IfCondition EqualTo(both, 0) ThenBlock: {
                    BreakLoop
                }
                IfCondition EqualTo(first, 0) ThenBlock: {
                    ca = ByteOf(la, Add(ba, p1))
                    cb = ByteOf(lb, Add(bb, p2))
                    first = Subtract(ca, cb)
                }
                p1 = Add(p1, one)
                p2 = Add(p2, one)
            }
            more1 = 0
            IfCondition LessThan(p1, na) ThenBlock: {
                ch = ByteOf(la, Add(ba, p1))
                more1 = IsDigit(ch)
            }
            IfCondition EqualTo(more1, 1) ThenBlock: {
                ReturnValue(1)
            }
            more2 = 0
            IfCondition LessThan(p2, nb) ThenBlock: {
                ch = ByteOf(lb, Add(bb, p2))
                more2 = IsDigit(ch)
            }
            IfCondition EqualTo(more2, 1) ThenBlock: {
                ReturnValue(-1)
            }
            IfCondition NotEqual(first, 0) ThenBlock: {
                ReturnValue(first)
            }
        }
        ReturnValue(0)
    }
}

Function.PrefixLen {
    Input: line: Address
    Input: base: Integer
    Input: len: Integer
    Output: Integer
    Body: {
        one = 1
        i = 0
        prefix = 0
        WhileLoop 1 {
            IfCondition EqualTo(i, len) ThenBlock: {
                Opt.tmp = prefix
                ReturnValue(Opt.tmp)
            }
            i = Add(i, one)
            prefix = i
            WhileLoop 1 {
                nxt = Add(i, one)
                IfCondition GreaterEqual(nxt, len) ThenBlock: {
                    BreakLoop
                }
                dot = ByteOf(line, Add(base, i))
                IfCondition NotEqual(dot, 46) ThenBlock: {
                    BreakLoop
                }
                nc = ByteOf(line, Add(base, nxt))
                al = IsAlpha(nc)
                til = EqualTo(nc, 126)
                ok = Or(EqualTo(al, 1), EqualTo(til, 1))
                IfCondition EqualTo(ok, 0) ThenBlock: {
                    BreakLoop
                }
                two = 2
                i = Add(i, two)
                WhileLoop LessThan(i, len) {
                    c = ByteOf(line, Add(base, i))
                    an = IsAlnum(c)
                    til = EqualTo(c, 126)
                    ok = Or(EqualTo(an, 1), EqualTo(til, 1))
                    IfCondition EqualTo(ok, 0) ThenBlock: {
                        BreakLoop
                    }
                    i = Add(i, one)
                }
            }
        }
        ReturnValue(prefix)
    }
}

Function.VerCmp {
    Input: la: Address
    Input: ba: Integer
    Input: na: Integer
    Input: lb: Address
    Input: bb: Integer
    Input: nb: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(na, 0) ThenBlock: {
            IfCondition EqualTo(nb, 0) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(-1)
        }
        IfCondition EqualTo(nb, 0) ThenBlock: {
            ReturnValue(1)
        }
        ca = ByteOf(la, ba)
        cb = ByteOf(lb, bb)
        IfCondition EqualTo(ca, 46) ThenBlock: {
            IfCondition NotEqual(cb, 46) ThenBlock: {
                ReturnValue(-1)
            }
            IfCondition EqualTo(na, 1) ThenBlock: {
                IfCondition EqualTo(nb, 1) ThenBlock: {
                    ReturnValue(0)
                }
                ReturnValue(-1)
            }
            IfCondition EqualTo(nb, 1) ThenBlock: {
                ReturnValue(1)
            }
            a2 = ByteOf(la, Add(ba, 1))
            b2 = ByteOf(lb, Add(bb, 1))
            adot = And(EqualTo(a2, 46), EqualTo(na, 2))
            bdot = And(EqualTo(b2, 46), EqualTo(nb, 2))
            IfCondition EqualTo(adot, 1) ThenBlock: {
                IfCondition EqualTo(bdot, 1) ThenBlock: {
                    ReturnValue(0)
                }
                ReturnValue(-1)
            }
            IfCondition EqualTo(bdot, 1) ThenBlock: {
                ReturnValue(1)
            }
        } ElseBlock: {
            IfCondition EqualTo(cb, 46) ThenBlock: {
                ReturnValue(1)
            }
        }
        ap = PrefixLen(la, ba, na)
        bp = PrefixLen(lb, bb, nb)
        result = VerRev(la, ba, ap, lb, bb, bp)
        one_pass = And(EqualTo(ap, na), EqualTo(bp, nb))
        IfCondition NotEqual(result, 0) ThenBlock: {
            ReturnValue(result)
        }
        IfCondition EqualTo(one_pass, 1) ThenBlock: {
            ReturnValue(0)
        }
        result = VerRev(la, ba, na, lb, bb, nb)
        ReturnValue(result)
    }
}

Function.NormKey {
    Input: line: Address
    Input: beg: Integer
    Input: n: Integer
    Input: dest: Address
    Input: ign: Integer
    Input: fold: Integer
    Output: Integer
    Body: {
        one = 1
        i = 0
        o = 0
        WhileLoop And(LessThan(i, n), LessThan(o, 4095)) {
            ch = ByteOf(line, Add(beg, i))
            keep = 1
            IfCondition EqualTo(ign, 1) ThenBlock: {
                al = IsAlnum(ch)
                bk = IsBlank(ch)
                keep = Or(EqualTo(al, 1), EqualTo(bk, 1))
            }
            IfCondition EqualTo(ign, 2) ThenBlock: {
                keep = And(GreaterEqual(ch, 32), LessEqual(ch, 126))
            }
            IfCondition EqualTo(keep, 1) ThenBlock: {
                IfCondition EqualTo(fold, 1) ThenBlock: {
                    ch = FoldByte(ch)
                }
                WRMEM_8(dest, o, ch)
                o = Add(o, one)
            }
            i = Add(i, one)
        }
        WRMEM_8(dest, o, 0)
        Opt.tmp = o
        ReturnValue(Opt.tmp)
    }
}

Function.MixSpan {
    Input: line: Address
    Input: beg: Integer
    Input: n: Integer
    Input: fold: Integer
    Body: {
        one = 1
        Opt.hrun = Opt.seed
        base = Add(Add(line, 16), beg)
        Work.i = 0
        WhileLoop LessThan(Work.i, n) {
            ch = RDMEM_8(Add(base, Work.i), 0)
            Opt.ch = ch
            IfCondition EqualTo(fold, 1) ThenBlock: {
                Opt.ch = FoldByte(ch)
            }
            h = BitwiseXor(Opt.hrun, Opt.ch)
            h = Multiply(h, 16777619)
            Opt.hrun = h
            Work.i = Add(Work.i, one)
        }
        IfCondition LessThan(Opt.hrun, 0) ThenBlock: {
            Opt.hrun = Add(Opt.hrun, 2147483647)
        }
    }
}

Function.HashBuf {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        one = 1
        Opt.hrun = Opt.seed
        i = 0
        WhileLoop LessThan(i, n) {
            ch = RDMEM_8(buf, i)
            Opt.hrun = Multiply(Opt.hrun, 131)
            Opt.hrun = Add(Opt.hrun, ch)
            Opt.hrun = Modulo(Opt.hrun, 2147483647)
            i = Add(i, one)
        }
        IfCondition LessThan(Opt.hrun, 0) ThenBlock: {
            Opt.hrun = Add(Opt.hrun, 2147483647)
        }
        h = Opt.hrun
        ReturnValue(h)
    }
}

Function.CmpRaw {
    Input: la: Address
    Input: ba: Integer
    Input: na: Integer
    Input: lb: Address
    Input: bb: Integer
    Input: nb: Integer
    Output: Integer
    Body: {
        ign = Opt.ign
        fold = Opt.fold
        one = 1
        ia = 0
        ib = 0
        WhileLoop 1 {
            WhileLoop LessThan(ia, na) {
                IfCondition EqualTo(ign, 0) ThenBlock: {
                    BreakLoop
                }
                ch = ByteOf(la, Add(ba, ia))
                skip = 0
                IfCondition EqualTo(ign, 1) ThenBlock: {
                    al = IsAlnum(ch)
                    bk = IsBlank(ch)
                    keep = Or(EqualTo(al, 1), EqualTo(bk, 1))
                    IfCondition EqualTo(keep, 0) ThenBlock: {
                        skip = 1
                    }
                }
                IfCondition EqualTo(ign, 2) ThenBlock: {
                    keep = And(GreaterEqual(ch, 32), LessEqual(ch, 126))
                    IfCondition EqualTo(keep, 0) ThenBlock: {
                        skip = 1
                    }
                }
                IfCondition EqualTo(skip, 0) ThenBlock: {
                    BreakLoop
                }
                ia = Add(ia, one)
            }
            WhileLoop LessThan(ib, nb) {
                IfCondition EqualTo(ign, 0) ThenBlock: {
                    BreakLoop
                }
                ch = ByteOf(lb, Add(bb, ib))
                skip = 0
                IfCondition EqualTo(ign, 1) ThenBlock: {
                    al = IsAlnum(ch)
                    bk = IsBlank(ch)
                    keep = Or(EqualTo(al, 1), EqualTo(bk, 1))
                    IfCondition EqualTo(keep, 0) ThenBlock: {
                        skip = 1
                    }
                }
                IfCondition EqualTo(ign, 2) ThenBlock: {
                    keep = And(GreaterEqual(ch, 32), LessEqual(ch, 126))
                    IfCondition EqualTo(keep, 0) ThenBlock: {
                        skip = 1
                    }
                }
                IfCondition EqualTo(skip, 0) ThenBlock: {
                    BreakLoop
                }
                ib = Add(ib, one)
            }
            enda = GreaterEqual(ia, na)
            endb = GreaterEqual(ib, nb)
            IfCondition And(EqualTo(enda, 1), EqualTo(endb, 1)) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(enda, 1) ThenBlock: {
                ReturnValue(-1)
            }
            IfCondition EqualTo(endb, 1) ThenBlock: {
                ReturnValue(1)
            }
            ca = ByteOf(la, Add(ba, ia))
            cb = ByteOf(lb, Add(bb, ib))
            IfCondition EqualTo(fold, 1) ThenBlock: {
                ca = FoldByte(ca)
                cb = FoldByte(cb)
            }
            IfCondition LessThan(ca, cb) ThenBlock: {
                ReturnValue(-1)
            }
            IfCondition GreaterThan(ca, cb) ThenBlock: {
                ReturnValue(1)
            }
            ia = Add(ia, one)
            ib = Add(ib, one)
        }
        ReturnValue(0)
    }
}

Function.KeyDiff {
    Input: la: Address
    Input: lb: Address
    Input: ki: Integer
    Output: Integer
    Body: {
        KeyEnds(la, ki)
        ba = Opt.beg
        ea = Opt.lim
        KeyEnds(lb, ki)
        bb = Opt.beg
        eb = Opt.lim
        na = Subtract(ea, ba)
        nb = Subtract(eb, bb)
        IfCondition LessThan(na, 0) ThenBlock: { na = 0 }
        IfCondition LessThan(nb, 0) ThenBlock: { nb = 0 }
        ign = KeyGet(ki, 6)
        fold = KeyGet(ki, 7)
        num = KeyGet(ki, 8)
        gen = KeyGet(ki, 9)
        hum = KeyGet(ki, 10)
        mon = KeyGet(ki, 11)
        ver = KeyGet(ki, 12)
        rnd = KeyGet(ki, 13)
        rev = KeyGet(ki, 14)
        diff = 0
        IfCondition EqualTo(rnd, 1) ThenBlock: {
            IfCondition EqualTo(ign, 0) ThenBlock: {
                MixSpan(la, ba, na, fold)
                NumKey.int_sig = Opt.hrun
                MixSpan(lb, bb, nb, fold)
                hb = Opt.hrun
                ha = NumKey.int_sig
            } ElseBlock: {
                nn = NormKey(la, ba, na, Ptr.norm, ign, fold)
                HashBuf(Ptr.norm, nn)
                NumKey.int_sig = Opt.hrun
                nn = NormKey(lb, bb, nb, Ptr.norm2, ign, fold)
                HashBuf(Ptr.norm2, nn)
                hb = Opt.hrun
                ha = NumKey.int_sig
            }
            diff = Subtract(ha, hb)
            IfCondition EqualTo(diff, 0) ThenBlock: {
                Opt.ign = ign
                Opt.fold = fold
                Opt.diff = CmpRaw(la, ba, na, lb, bb, nb)
                diff = Opt.diff
            }
        } ElseBlock: {
            IfCondition EqualTo(ver, 1) ThenBlock: {
                Opt.ign = ign
                Opt.fold = fold
                diff = FileVer(la, ba, na, lb, bb, nb)
            } ElseBlock: {
                IfCondition Or(EqualTo(num, 1), Or(EqualTo(gen, 1), EqualTo(hum, 1))) ThenBlock: {
                    CopyZ(la, ba, na, Ptr.numbuf)
                    CopyZ(lb, bb, nb, Ptr.numbuf2)
                    IfCondition EqualTo(hum, 1) ThenBlock: {
                        oa = UnitOrder(Ptr.numbuf)
                        ob = UnitOrder(Ptr.numbuf2)
                        IfCondition LessThan(oa, ob) ThenBlock: {
                            diff = -1
                        }
                        IfCondition GreaterThan(oa, ob) ThenBlock: {
                            diff = 1
                        }
                        IfCondition EqualTo(oa, ob) ThenBlock: {
                            Opt.general_fill = 0
                            diff = CompareDecimal(Ptr.numbuf, Ptr.numbuf2)
                        }
                    } ElseBlock: {
                        IfCondition EqualTo(gen, 1) ThenBlock: {
                            ca = GenClass(Ptr.numbuf)
                            cb = GenClass(Ptr.numbuf2)
                            IfCondition LessThan(ca, cb) ThenBlock: {
                                diff = -1
                            }
                            IfCondition GreaterThan(ca, cb) ThenBlock: {
                                diff = 1
                            }
                            IfCondition EqualTo(ca, cb) ThenBlock: {
                                IfCondition EqualTo(ca, 3) ThenBlock: {
                                    Opt.general_fill = 1
                                    diff = CompareDecimal(Ptr.numbuf, Ptr.numbuf2)
                                } ElseBlock: {
                                    diff = 0
                                }
                            }
                        } ElseBlock: {
                            Opt.general_fill = 0
                            diff = CompareDecimal(Ptr.numbuf, Ptr.numbuf2)
                        }
                    }
                } ElseBlock: {
                    IfCondition EqualTo(mon, 1) ThenBlock: {
                        CopyZ(la, ba, na, Ptr.numbuf)
                        CopyZ(lb, bb, nb, Ptr.numbuf2)
                        ma = MonthOf(Ptr.numbuf)
                        mb = MonthOf(Ptr.numbuf2)
                        IfCondition LessThan(ma, mb) ThenBlock: {
                            diff = -1
                        }
                        IfCondition GreaterThan(ma, mb) ThenBlock: {
                            diff = 1
                        }
                    } ElseBlock: {
                        Opt.ign = ign
                        Opt.fold = fold
                        diff = CmpRaw(la, ba, na, lb, bb, nb)
                    }
                }
            }
        }
        IfCondition And(NotEqual(diff, 0), EqualTo(rev, 1)) ThenBlock: {
            diff = Subtract(0, diff)
        }
        Opt.diff = diff
        ReturnValue(Opt.diff)
    }
}

Function.FileVer {
    Input: la: Address
    Input: ba: Integer
    Input: na: Integer
    Input: lb: Address
    Input: bb: Integer
    Input: nb: Integer
    Output: Integer
    Body: {
        ign = Opt.ign
        fold = Opt.fold
        na2 = NormKey(la, ba, na, Ptr.norm, ign, fold)
        nb2 = NormKey(lb, bb, nb, Ptr.norm2, ign, fold)
        // Compare the normalized buffers as raw byte arrays via a tiny header.
        // Store them as line records so ByteOf works: [len][idx][bytes][NUL]
        ReturnValue(VerOnNorm(na2, nb2))
    }
}

Function.VerOnNorm {
    Input: na: Integer
    Input: nb: Integer
    Output: Integer
    Body: {
        // Ptr.norm and Ptr.norm2 are raw. Build line-shaped copies if needed.
        // VerCmp/ByteOf expect a 16-byte header. Use Ptr.vlin and Ptr.vlin2.
        one = 1
        WRMEM_64(Ptr.vlin, na)
        WRMEM_64(Ptr.vlin, 8, 0)
        i = 0
        WhileLoop LessThan(i, na) {
            WRMEM_8(Ptr.vlin, Add(16, i), RDMEM_8(Ptr.norm, i))
            i = Add(i, one)
        }
        WRMEM_64(Ptr.vlin2, nb)
        WRMEM_64(Ptr.vlin2, 8, 0)
        i = 0
        WhileLoop LessThan(i, nb) {
            WRMEM_8(Ptr.vlin2, Add(16, i), RDMEM_8(Ptr.norm2, i))
            i = Add(i, one)
        }
        d = VerCmp(Ptr.vlin, 0, na, Ptr.vlin2, 0, nb)
        ReturnValue(d)
    }
}

Function.CompareIdx {
    Input: ia: Integer
    Input: ib: Integer
    Output: Integer
    Body: {
        la = RDMEM_64(Ptr.lines, Multiply(ia, 8))
        lb = RDMEM_64(Ptr.lines, Multiply(ib, 8))
        diff = 0
        IfCondition GreaterThan(Opt.nkeys, 0) ThenBlock: {
            one = 1
            ki = 1
            WhileLoop LessEqual(ki, Opt.nkeys) {
                diff = KeyDiff(la, lb, ki)
                IfCondition NotEqual(diff, 0) ThenBlock: {
                    BreakLoop
                }
                ki = Add(ki, one)
            }
            stop = Or(NotEqual(diff, 0), Or(EqualTo(Opt.unique, 1), EqualTo(Opt.stable, 1)))
            IfCondition EqualTo(stop, 1) ThenBlock: {
                Opt.diff = diff
                ReturnValue(Opt.diff)
            }
        }
        na = LineLen(la)
        nb = LineLen(lb)
        Opt.ign = 0
        Opt.fold = 0
        diff = CmpRaw(la, 0, na, lb, 0, nb)
        IfCondition And(NotEqual(diff, 0), EqualTo(Opt.reverse, 1)) ThenBlock: {
            diff = Subtract(0, diff)
        }
        Opt.diff = diff
        ReturnValue(Opt.diff)
    }
}

Function.IsDefault {
    Input: ki: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(KeyGet(ki, 6), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(KeyGet(ki, 7), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(KeyGet(ki, 4), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(KeyGet(ki, 5), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(KeyGet(ki, 8), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(KeyGet(ki, 9), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(KeyGet(ki, 10), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(KeyGet(ki, 11), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(KeyGet(ki, 12), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(KeyGet(ki, 13), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.InheritKeys {
    Body: {
        one = 1
        i = 1
        WhileLoop LessEqual(i, Opt.nkeys) {
            d = IsDefault(i)
            r = KeyGet(i, 14)
            IfCondition And(EqualTo(d, 1), EqualTo(r, 0)) ThenBlock: {
                f = 4
                WhileLoop LessEqual(f, 14) {
                    v = KeyGet(0, f)
                    KeySet(i, f, v)
                    f = Add(f, one)
                }
            }
            i = Add(i, one)
        }
        IfCondition EqualTo(Opt.nkeys, 0) ThenBlock: {
            d = IsDefault(0)
            IfCondition EqualTo(d, 0) ThenBlock: {
                f = 0
                WhileLoop LessThan(f, 16) {
                    v = KeyGet(0, f)
                    KeySet(1, f, v)
                    f = Add(f, one)
                }
                Opt.nkeys = 1
                Opt.gkey_only = 1
            }
        }
        Opt.reverse = KeyGet(0, 14)
    }
}

Function.OrderCount {
    Input: ki: Integer
    Output: Integer
    Body: {
        c = 0
        IfCondition NotEqual(KeyGet(ki, 8), 0) ThenBlock: { c = Add(c, 1) }
        IfCondition NotEqual(KeyGet(ki, 9), 0) ThenBlock: { c = Add(c, 1) }
        IfCondition NotEqual(KeyGet(ki, 10), 0) ThenBlock: { c = Add(c, 1) }
        IfCondition NotEqual(KeyGet(ki, 11), 0) ThenBlock: { c = Add(c, 1) }
        flag = 0
        IfCondition NotEqual(KeyGet(ki, 12), 0) ThenBlock: { flag = 1 }
        IfCondition NotEqual(KeyGet(ki, 13), 0) ThenBlock: { flag = 1 }
        IfCondition NotEqual(KeyGet(ki, 6), 0) ThenBlock: { flag = 1 }
        c = Add(c, flag)
        ReturnValue(c)
    }
}

Function.PushOpt {
    Input: ch: Integer
    Body: {
        WRMEM_8(Ptr.optbuf, Opt.on, ch)
        one = 1
        Opt.on = Add(Opt.on, one)
        WRMEM_8(Ptr.optbuf, Opt.on, 0)
    }
}

Function.BuildOpts {
    Input: ki: Integer
    Body: {
        Opt.on = 0
        WRMEM_8(Ptr.optbuf, 0, 0)
        IfCondition Or(NotEqual(KeyGet(ki, 4), 0), NotEqual(KeyGet(ki, 5), 0)) ThenBlock: {
            PushOpt(98)
        }
        IfCondition EqualTo(KeyGet(ki, 6), 1) ThenBlock: { PushOpt(100) }
        IfCondition NotEqual(KeyGet(ki, 7), 0) ThenBlock: { PushOpt(102) }
        IfCondition NotEqual(KeyGet(ki, 9), 0) ThenBlock: { PushOpt(103) }
        IfCondition NotEqual(KeyGet(ki, 10), 0) ThenBlock: { PushOpt(104) }
        IfCondition EqualTo(KeyGet(ki, 6), 2) ThenBlock: { PushOpt(105) }
        IfCondition NotEqual(KeyGet(ki, 11), 0) ThenBlock: { PushOpt(77) }
        IfCondition NotEqual(KeyGet(ki, 8), 0) ThenBlock: { PushOpt(110) }
        IfCondition NotEqual(KeyGet(ki, 13), 0) ThenBlock: { PushOpt(82) }
        IfCondition NotEqual(KeyGet(ki, 14), 0) ThenBlock: { PushOpt(114) }
        IfCondition NotEqual(KeyGet(ki, 12), 0) ThenBlock: { PushOpt(86) }
    }
}

Function.CheckCompat {
    Body: {
        one = 1
        i = 1
        WhileLoop LessEqual(i, Opt.nkeys) {
            c = OrderCount(i)
            IfCondition GreaterThan(c, 1) ThenBlock: {
                KeySet(i, 4, 0)
                KeySet(i, 5, 0)
                KeySet(i, 14, 0)
                BuildOpts(i)
                Err("sort: options '-")
                Err(Ptr.optbuf)
                Err("' are incompatible\n")
                SystemCall(60, 2)
            }
            i = Add(i, one)
        }
    }
}

Function.AnyKey {
    Input: field: Integer
    Output: Integer
    Body: {
        one = 1
        i = 0
        last = Opt.nkeys
        WhileLoop LessEqual(i, last) {
            v = KeyGet(i, field)
            IfCondition NotEqual(v, 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.ErrNum {
    Input: n: Integer
    Body: {
        s = IntToStr(n)
        Err(s)
        Deallocate(s, 32)
    }
}

Function.WarnKeys {
    Body: {
        one = 1
        // ugkey is slot 30, a copy of gkey
        f = 0
        WhileLoop LessThan(f, 16) {
            v = KeyGet(0, f)
            KeySet(30, f, v)
            f = Add(f, one)
        }
        Opt.basic_num = 0
        Opt.gen_num = 0
        Opt.basic_span = 0
        Opt.gen_span = 0
        Opt.num_warned = 0
        kn = 1
        i = 1
        WhileLoop LessEqual(i, Opt.nkeys) {
            num = KeyGet(i, 8)
            gen = KeyGet(i, 9)
            hum = KeyGet(i, 10)
            isn = Or(NotEqual(num, 0), Or(NotEqual(gen, 0), NotEqual(hum, 0)))
            IfCondition EqualTo(isn, 1) ThenBlock: {
                IfCondition NotEqual(gen, 0) ThenBlock: {
                    Opt.gen_num = 1
                } ElseBlock: {
                    Opt.basic_num = 1
                }
            }
            trad = KeyGet(i, 15)
            IfCondition EqualTo(trad, 1) ThenBlock: {
                sw = KeyGet(i, 0)
                ew = KeyGet(i, 2)
                ec = KeyGet(i, 3)
                sp = sw
                IfCondition EqualTo(sw, -1) ThenBlock: {
                    sp = 0
                }
                Err("sort: obsolescent key '+")
                ErrNum(sp)
                IfCondition NotEqual(ew, -1) ThenBlock: {
                    Err(" -")
                    ErrNum(Add(ew, 1))
                }
                Err("' used; consider '-k ")
                ErrNum(Add(sp, 1))
                IfCondition NotEqual(ew, -1) ThenBlock: {
                    Err(",")
                    extra = 0
                    IfCondition EqualTo(ec, -1) ThenBlock: {
                        extra = 1
                    }
                    ErrNum(Add(Add(ew, 1), extra))
                }
                Err("' instead\n")
            }
            sw = KeyGet(i, 0)
            ew = KeyGet(i, 2)
            zw = 0
            IfCondition And(NotEqual(sw, -1), NotEqual(ew, -1)) ThenBlock: {
                IfCondition LessThan(ew, sw) ThenBlock: {
                    zw = 1
                }
            }
            IfCondition EqualTo(zw, 1) ThenBlock: {
                Err("sort: key ")
                ErrNum(kn)
                Err(" has zero width and will be ignored\n")
            }
            mon = KeyGet(i, 11)
            implicit = Or(EqualTo(isn, 1), NotEqual(mon, 0))
            sch = KeyGet(i, 1)
            ech = KeyGet(i, 3)
            line_off = And(EqualTo(ew, 0), NotEqual(ech, 0))
            IfCondition EqualTo(zw, 0) ThenBlock: {
                show = 1
                IfCondition EqualTo(Opt.gkey_only, 1) ThenBlock: { show = 0 }
                IfCondition EqualTo(Opt.tab_set, 1) ThenBlock: { show = 0 }
                IfCondition EqualTo(line_off, 1) ThenBlock: { show = 0 }
                IfCondition EqualTo(show, 1) ThenBlock: {
                    sk = KeyGet(i, 4)
                    se = KeyGet(i, 5)
                    hit = 0
                    IfCondition And(EqualTo(sk, 0), EqualTo(implicit, 0)) ThenBlock: { hit = 1 }
                    IfCondition And(EqualTo(sk, 0), NotEqual(sch, 0)) ThenBlock: { hit = 1 }
                    IfCondition And(EqualTo(se, 0), NotEqual(ech, 0)) ThenBlock: { hit = 1 }
                    IfCondition EqualTo(hit, 1) ThenBlock: {
                        Err("sort: leading blanks are significant in key ")
                        ErrNum(kn)
                        Err("; consider also specifying 'b'\n")
                    }
                }
            }
            IfCondition And(EqualTo(Opt.gkey_only, 0), EqualTo(isn, 1)) ThenBlock: {
                sw2 = sw
                IfCondition EqualTo(sw2, -1) ThenBlock: {
                    sw2 = 0
                } ElseBlock: {
                    sw2 = Add(sw2, 1)
                }
                IfCondition EqualTo(sw2, 0) ThenBlock: {
                    sw2 = 1
                }
                ew2 = ew
                IfCondition EqualTo(ew2, -1) ThenBlock: {
                    ew2 = 0
                } ElseBlock: {
                    ew2 = Add(ew2, 1)
                }
                span = 0
                IfCondition EqualTo(ew2, 0) ThenBlock: { span = 1 }
                IfCondition LessThan(sw2, ew2) ThenBlock: { span = 1 }
                IfCondition EqualTo(span, 1) ThenBlock: {
                    Err("sort: key ")
                    ErrNum(kn)
                    Err(" is numeric and spans multiple fields\n")
                    IfCondition NotEqual(gen, 0) ThenBlock: {
                        Opt.gen_span = 1
                    } ElseBlock: {
                        Opt.basic_span = 1
                    }
                }
            }
            // clear ugkey flags that this key has
            IfCondition And(NotEqual(KeyGet(30, 6), 0), EqualTo(KeyGet(30, 6), KeyGet(i, 6))) ThenBlock: {
                KeySet(30, 6, 0)
            }
            IfCondition And(NotEqual(KeyGet(30, 7), 0), EqualTo(KeyGet(30, 7), KeyGet(i, 7))) ThenBlock: {
                KeySet(30, 7, 0)
            }
            IfCondition NotEqual(KeyGet(i, 4), 0) ThenBlock: { KeySet(30, 4, 0) }
            IfCondition NotEqual(KeyGet(i, 5), 0) ThenBlock: { KeySet(30, 5, 0) }
            IfCondition NotEqual(KeyGet(i, 11), 0) ThenBlock: { KeySet(30, 11, 0) }
            IfCondition NotEqual(KeyGet(i, 8), 0) ThenBlock: { KeySet(30, 8, 0) }
            IfCondition NotEqual(KeyGet(i, 9), 0) ThenBlock: { KeySet(30, 9, 0) }
            IfCondition NotEqual(KeyGet(i, 10), 0) ThenBlock: { KeySet(30, 10, 0) }
            IfCondition NotEqual(KeyGet(i, 13), 0) ThenBlock: { KeySet(30, 13, 0) }
            IfCondition NotEqual(KeyGet(i, 12), 0) ThenBlock: { KeySet(30, 12, 0) }
            IfCondition NotEqual(KeyGet(i, 14), 0) ThenBlock: { KeySet(30, 14, 0) }
            kn = Add(kn, one)
            i = Add(i, one)
        }
        span_any = Or(EqualTo(Opt.basic_span, 1), EqualTo(Opt.gen_span, 1))
        IfCondition And(EqualTo(Opt.basic_span, 1), EqualTo(Opt.tab, 44)) ThenBlock: {
            // comma is not a thousands separator in the C locale
            Opt.num_warned = Opt.num_warned
        }
        IfCondition And(EqualTo(span_any, 1), EqualTo(Opt.tab_set, 1)) ThenBlock: {
            IfCondition EqualTo(Opt.tab, 46) ThenBlock: {
                Err("sort: field separator '.' is treated as a decimal point in numbers\n")
                Opt.num_warned = 1
            } ElseBlock: {
                IfCondition EqualTo(Opt.tab, 45) ThenBlock: {
                    Err("sort: field separator '-' is treated as a minus sign in numbers\n")
                }
                IfCondition And(EqualTo(Opt.gen_span, 1), EqualTo(Opt.tab, 43)) ThenBlock: {
                    Err("sort: field separator '+' is treated as a plus sign in numbers\n")
                }
            }
        }
        have_num = Or(EqualTo(Opt.basic_num, 1), EqualTo(Opt.gen_num, 1))
        IfCondition And(EqualTo(have_num, 1), EqualTo(Opt.num_warned, 0)) ThenBlock: {
            Err("sort: note numbers use '.' as a decimal point in this locale\n")
        }
        ug_rev = KeyGet(30, 14)
        keep_r = Or(EqualTo(Opt.stable, 1), EqualTo(Opt.unique, 1))
        IfCondition EqualTo(keep_r, 0) ThenBlock: {
            KeySet(30, 14, 0)
        }
        d = IsDefault(30)
        rev_now = KeyGet(30, 14)
        need = 0
        IfCondition EqualTo(d, 0) ThenBlock: { need = 1 }
        IfCondition And(NotEqual(rev_now, 0), And(EqualTo(keep_r, 1), GreaterThan(Opt.nkeys, 0))) ThenBlock: {
            need = 1
        }
        IfCondition EqualTo(need, 1) ThenBlock: {
            BuildOpts(30)
            IfCondition EqualTo(Opt.on, 1) ThenBlock: {
                Err("sort: option '-")
                Err(Ptr.optbuf)
                Err("' is ignored\n")
            }
            IfCondition GreaterThan(Opt.on, 1) ThenBlock: {
                Err("sort: options '-")
                Err(Ptr.optbuf)
                Err("' are ignored\n")
            }
        }
        KeySet(30, 14, ug_rev)
        IfCondition And(NotEqual(ug_rev, 0), And(EqualTo(keep_r, 0), GreaterThan(Opt.nkeys, 0))) ThenBlock: {
            Err("sort: option '-r' only applies to last-resort comparison\n")
        }
    }
}

Function.DebugWidth {
    Input: line: Address
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        one = 1
        w = 0
        i = a
        WhileLoop LessThan(i, b) {
            ch = ByteOf(line, i)
            addw = 1
            IfCondition Or(LessThan(ch, 32), EqualTo(ch, 127)) ThenBlock: {
                addw = 0
            }
            IfCondition EqualTo(ch, 9) ThenBlock: {
                addw = 1
            }
            w = Add(w, addw)
            i = Add(i, one)
        }
        Opt.tmp = w
        ReturnValue(Opt.tmp)
    }
}

Function.Tighten {
    Input: line: Address
    Input: ki: Integer
    Body: {
        beg = Opt.beg
        lim = Opt.lim
        one = 1
        num = KeyGet(ki, 8)
        gen = KeyGet(ki, 9)
        hum = KeyGet(ki, 10)
        mon = KeyGet(ki, 11)
        sk = KeyGet(ki, 4)
        sw = KeyGet(ki, 0)
        do_it = Or(EqualTo(mon, 1), Or(NotEqual(num, 0), Or(NotEqual(gen, 0), NotEqual(hum, 0))))
        whole = And(EqualTo(sk, 1), EqualTo(sw, -1))
        do_it = Or(EqualTo(do_it, 1), EqualTo(whole, 1))
        IfCondition EqualTo(do_it, 0) ThenBlock: {
            ReturnValue(0)
        }
        WhileLoop LessThan(beg, lim) {
            ch = ByteOf(line, beg)
            bk = IsBlank(ch)
            IfCondition EqualTo(bk, 0) ThenBlock: {
                BreakLoop
            }
            beg = Add(beg, one)
        }
        IfCondition LessThan(lim, beg) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(mon, 1) ThenBlock: {
            CopyZ(line, beg, Subtract(lim, beg), Ptr.numbuf)
            MonthOf(Ptr.numbuf)
            Opt.beg = beg
            Opt.lim = Add(beg, Opt.copy_n)
            IfCondition GreaterThan(Opt.lim, lim) ThenBlock: {
                Opt.lim = lim
            }
            ReturnValue(0)
        }
        IfCondition Or(NotEqual(num, 0), NotEqual(hum, 0)) ThenBlock: {
            i = beg
            ch = ByteOf(line, i)
            IfCondition And(LessThan(i, lim), EqualTo(ch, 45)) ThenBlock: {
                i = Add(i, one)
            }
            maxd = 0
            WhileLoop LessThan(i, lim) {
                ch = ByteOf(line, i)
                dig = IsDigit(ch)
                IfCondition EqualTo(dig, 0) ThenBlock: {
                    BreakLoop
                }
                IfCondition GreaterThan(ch, maxd) ThenBlock: {
                    maxd = ch
                }
                i = Add(i, one)
            }
            IfCondition And(LessThan(i, lim), EqualTo(ch, 46)) ThenBlock: {
                i = Add(i, one)
                WhileLoop LessThan(i, lim) {
                    ch = ByteOf(line, i)
                    dig = IsDigit(ch)
                    IfCondition EqualTo(dig, 0) ThenBlock: {
                        BreakLoop
                    }
                    IfCondition GreaterThan(ch, maxd) ThenBlock: {
                        maxd = ch
                    }
                    i = Add(i, one)
                }
            }
            IfCondition GreaterEqual(maxd, 48) ThenBlock: {
                IfCondition And(EqualTo(hum, 1), LessThan(i, lim)) ThenBlock: {
                    ch = ByteOf(line, i)
                    u = UnitOf(ch)
                    IfCondition NotEqual(u, 0) ThenBlock: {
                        i = Add(i, one)
                    }
                }
                Opt.beg = beg
                Opt.lim = i
            } ElseBlock: {
                Opt.beg = beg
                Opt.lim = beg
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(gen, 0) ThenBlock: {
            i = beg
            IfCondition LessThan(i, lim) ThenBlock: {
                ch = ByteOf(line, i)
                sig = Or(EqualTo(ch, 45), EqualTo(ch, 43))
                IfCondition EqualTo(sig, 1) ThenBlock: {
                    i = Add(i, one)
                }
            }
            infp = 0
            IfCondition LessThan(i, lim) ThenBlock: {
                // inf / nan word
                c0 = ByteOf(line, i)
                f0 = FoldByte(c0)
                IfCondition Or(EqualTo(f0, 73), EqualTo(f0, 78)) ThenBlock: {
                    j = i
                    WhileLoop LessThan(j, lim) {
                        ch = ByteOf(line, j)
                        al = IsAlpha(ch)
                        IfCondition EqualTo(al, 0) ThenBlock: {
                            BreakLoop
                        }
                        j = Add(j, one)
                    }
                    i = j
                    infp = 1
                }
            }
            IfCondition EqualTo(infp, 0) ThenBlock: {
                saw = 0
                WhileLoop LessThan(i, lim) {
                    ch = ByteOf(line, i)
                    dig = IsDigit(ch)
                    IfCondition EqualTo(dig, 0) ThenBlock: {
                        BreakLoop
                    }
                    saw = 1
                    i = Add(i, one)
                }
                IfCondition And(LessThan(i, lim), EqualTo(ByteOf(line, i), 46)) ThenBlock: {
                    i = Add(i, one)
                    WhileLoop LessThan(i, lim) {
                        ch = ByteOf(line, i)
                        dig = IsDigit(ch)
                        IfCondition EqualTo(dig, 0) ThenBlock: {
                            BreakLoop
                        }
                        saw = 1
                        i = Add(i, one)
                    }
                }
                IfCondition EqualTo(saw, 1) ThenBlock: {
                    IfCondition LessThan(i, lim) ThenBlock: {
                        ch = FoldByte(ByteOf(line, i))
                        IfCondition EqualTo(ch, 69) ThenBlock: {
                            k = Add(i, one)
                            IfCondition LessThan(k, lim) ThenBlock: {
                                sg = ByteOf(line, k)
                                IfCondition Or(EqualTo(sg, 43), EqualTo(sg, 45)) ThenBlock: {
                                    k = Add(k, one)
                                }
                            }
                            ed = 0
                            WhileLoop LessThan(k, lim) {
                                dig = IsDigit(ByteOf(line, k))
                                IfCondition EqualTo(dig, 0) ThenBlock: {
                                    BreakLoop
                                }
                                ed = 1
                                k = Add(k, one)
                            }
                            IfCondition EqualTo(ed, 1) ThenBlock: {
                                i = k
                            }
                        }
                    }
                } ElseBlock: {
                    i = beg
                }
            }
            Opt.beg = beg
            Opt.lim = i
            ReturnValue(0)
        }
        Opt.beg = beg
        ReturnValue(0)
    }
}

Function.MarkKey {
    Input: off: Integer
    Input: width: Integer
    Body: {
        one = 1
        i = 0
        WhileLoop LessThan(i, off) {
            OutByte(32)
            i = Add(i, one)
        }
        IfCondition EqualTo(width, 0) ThenBlock: {
            OutStr("^ no match for key\n")
        } ElseBlock: {
            i = 0
            WhileLoop LessThan(i, width) {
                OutByte(95)
                i = Add(i, one)
            }
            OutByte(10)
        }
    }
}

Function.DebugKey {
    Input: line: Address
    Input: ki: Integer
    Body: {
        len = LineLen(line)
        IfCondition EqualTo(ki, 0) ThenBlock: {
            w = DebugWidth(line, 0, len)
            MarkKey(0, w)
            ReturnValue(0)
        }
        KeyEnds(line, ki)
        Tighten(line, ki)
        beg = Opt.beg
        lim = Opt.lim
        off = DebugWidth(line, 0, beg)
        width = DebugWidth(line, beg, lim)
        MarkKey(off, width)
        ReturnValue(0)
    }
}

Function.DebugShow {
    Input: line: Address
    Body: {
        one = 1
        n = LineLen(line)
        i = 0
        WhileLoop LessThan(i, n) {
            ch = ByteOf(line, i)
            IfCondition EqualTo(ch, 9) ThenBlock: {
                OutByte(62)
            } ElseBlock: {
                OutByte(ch)
            }
            i = Add(i, one)
        }
        OutByte(10)
        IfCondition EqualTo(Opt.nkeys, 0) ThenBlock: {
            DebugKey(line, 0)
            ReturnValue(0)
        }
        ki = 1
        WhileLoop LessEqual(ki, Opt.nkeys) {
            DebugKey(line, ki)
            ki = Add(ki, one)
        }
        keep = Or(EqualTo(Opt.unique, 1), EqualTo(Opt.stable, 1))
        IfCondition EqualTo(keep, 0) ThenBlock: {
            DebugKey(line, 0)
        }
        ReturnValue(0)
    }
}
