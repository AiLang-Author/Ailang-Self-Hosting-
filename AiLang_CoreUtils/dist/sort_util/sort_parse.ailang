// Option, key, argv, and environ parsing for sort. Pools live on sort.ailang.

Function.ArgPtr {
    Input: i: Integer
    Output: Address
    Body: {
        p = Dereference(Add(Ptr.args, Multiply(i, 8)))
        Work.argp = p
        ReturnValue(Work.argp)
    }
}

Function.PeekArg {
    Output: Address
    Body: {
        one = 1
        n = Add(Opt.argi, one)
        IfCondition GreaterEqual(n, Opt.argc) ThenBlock: {
            ReturnValue(0)
        }
        p = ArgPtr(n)
        ReturnValue(p)
    }
}

Function.NextArg {
    Output: Address
    Body: {
        one = 1
        n = Add(Opt.argi, one)
        IfCondition GreaterEqual(n, Opt.argc) ThenBlock: {
            ReturnValue(0)
        }
        Opt.argi = n
        p = ArgPtr(n)
        ReturnValue(p)
    }
}

Function.AddFile {
    Input: p: Address
    Body: {
        IfCondition GreaterEqual(Opt.nfiles, 4000) ThenBlock: {
            Err("sort: too many files\n")
            Die(2)
        }
        StoreValue(Add(Ptr.files, Multiply(Opt.nfiles, 8)), p)
        one = 1
        Opt.nfiles = Add(Opt.nfiles, one)
    }
}

Function.CopySlice {
    Input: start: Integer
    Input: len: Integer
    Output: Address
    Body: {
        need = Add(len, 1)
        sz = Bucket(need)
        dest = Allocate(sz)
        one = 1
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(Ptr.cmd, Add(start, i))
            SetByte(dest, i, ch)
            i = Add(i, one)
        }
        SetByte(dest, len, 0)
        Work.argp = dest
        ReturnValue(Work.argp)
    }
}

Function.LoadArgs {
    Body: {
        fd = SystemCall(2, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            Err("sort: cannot read command line\n")
            Die(2)
        }
        n = SystemCall(0, fd, Ptr.cmd, 1048575)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Err("sort: cannot read command line\n")
            Die(2)
        }
        one = 1
        pos = 0
        Opt.argc = 0
        WhileLoop LessThan(pos, n) {
            start = pos
            WhileLoop LessThan(pos, n) {
                ch = GetByte(Ptr.cmd, pos)
                IfCondition EqualTo(ch, 0) ThenBlock: {
                    BreakLoop
                }
                pos = Add(pos, one)
            }
            len = Subtract(pos, start)
            dest = CopySlice(start, len)
            IfCondition GreaterEqual(Opt.argc, 4000) ThenBlock: {
                Err("sort: too many arguments\n")
                Die(2)
            }
            StoreValue(Add(Ptr.args, Multiply(Opt.argc, 8)), dest)
            Opt.argc = Add(Opt.argc, one)
            IfCondition LessThan(pos, n) ThenBlock: {
                pos = Add(pos, one)
            }
        }
    }
}

Function.ParsePosix {
    Input: vp: Address
    Input: at: Integer
    Body: {
        one = 1
        i = at
        val = 0
        saw = 0
        bad = 0
        WhileLoop 1 {
            ch = GetByte(vp, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            dig = IsDigit(ch)
            IfCondition EqualTo(dig, 0) ThenBlock: {
                bad = 1
                BreakLoop
            }
            val = Multiply(val, 10)
            val = Add(val, Subtract(ch, 48))
            saw = 1
            i = Add(i, one)
        }
        IfCondition EqualTo(bad, 0) ThenBlock: {
            IfCondition EqualTo(saw, 1) ThenBlock: {
                Opt.posix2 = val
            }
        }
    }
}

Function.SeeVar {
    Input: vp: Address
    Body: {
        pre = IsPre("_POSIX2_VERSION=", vp)
        IfCondition EqualTo(pre, 1) ThenBlock: {
            ParsePosix(vp, 16)
        }
        pre = IsPre("POSIXLY_CORRECT=", vp)
        IfCondition EqualTo(pre, 1) ThenBlock: {
            Opt.posixly = 1
        }
        pre = IsPre("TMPDIR=", vp)
        IfCondition EqualTo(pre, 1) ThenBlock: {
            Opt.tmpdir = Add(vp, 7)
        }
        pre = IsPre("PATH=", vp)
        IfCondition EqualTo(pre, 1) ThenBlock: {
            Ptr.path = Add(vp, 5)
        }
    }
}

Function.LoadEnviron {
    Body: {
        fd = SystemCall(2, "/proc/self/environ", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = SystemCall(0, fd, Ptr.env, 65535)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        SetByte(Ptr.env, n, 0)
        one = 1
        pos = 0
        cnt = 0
        WhileLoop LessThan(pos, n) {
            StoreValue(Add(Ptr.envp, Multiply(cnt, 8)), Add(Ptr.env, pos))
            cnt = Add(cnt, one)
            IfCondition GreaterEqual(cnt, 1000) ThenBlock: {
                BreakLoop
            }
            WhileLoop LessThan(pos, n) {
                ch = GetByte(Ptr.env, pos)
                IfCondition EqualTo(ch, 0) ThenBlock: {
                    BreakLoop
                }
                pos = Add(pos, one)
            }
            IfCondition LessThan(pos, n) ThenBlock: {
                pos = Add(pos, one)
            }
        }
        StoreValue(Add(Ptr.envp, Multiply(cnt, 8)), 0)
        i = 0
        WhileLoop LessThan(i, cnt) {
            vp = Dereference(Add(Ptr.envp, Multiply(i, 8)))
            SeeVar(vp)
            i = Add(i, one)
        }
        lo = 0
        IfCondition GreaterEqual(Opt.posix2, 200112) ThenBlock: {
            IfCondition LessThan(Opt.posix2, 200809) ThenBlock: {
                lo = 1
            }
        }
        IfCondition EqualTo(lo, 1) ThenBlock: {
            Opt.traditional = 0
        }
    }
}

Function.BadSpec {
    Input: msg: Address
    Input: spec: Address
    Body: {
        Err("sort: ")
        Err(msg)
        Err(": invalid field specification '")
        Err(spec)
        Err("'\n")
        Die(2)
    }
}

Function.CopyTail {
    Input: s: Address
    Input: at: Integer
    Output: Address
    Body: {
        one = 1
        i = 0
        WhileLoop LessThan(i, 250) {
            ch = GetByte(s, Add(at, i))
            SetByte(Ptr.scratch, i, ch)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            i = Add(i, one)
        }
        SetByte(Ptr.scratch, i, 0)
        ReturnValue(Ptr.scratch)
    }
}

Function.BadCount {
    Input: msg: Address
    Input: spec: Address
    Input: at: Integer
    Body: {
        tail = CopyTail(spec, at)
        Err("sort: ")
        Err(msg)
        Err(": invalid count at start of '")
        Err(tail)
        Err("'\n")
        Die(2)
    }
}

Function.ParseCount {
    Input: spec: Address
    Input: at: Integer
    Input: hard: Integer
    Input: msg: Address
    Output: Integer
    Body: {
        one = 1
        i = at
        ch = GetByte(spec, i)
        dig = IsDigit(ch)
        IfCondition EqualTo(dig, 0) ThenBlock: {
            IfCondition EqualTo(hard, 1) ThenBlock: {
                BadCount(msg, spec, at)
            }
            ReturnValue(0)
        }
        val = 0
        ov = 0
        WhileLoop 1 {
            ch = GetByte(spec, i)
            dig = IsDigit(ch)
            IfCondition EqualTo(dig, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition GreaterThan(val, 99999999) ThenBlock: {
                ov = 1
            }
            val = Multiply(val, 10)
            val = Add(val, Subtract(ch, 48))
            i = Add(i, one)
        }
        IfCondition EqualTo(ov, 1) ThenBlock: {
            val = 999999999
        }
        Work.num = val
        Work.pos = i
        Work.ok = 1
        ReturnValue(Work.ok)
    }
}

Function.ApplyOrder {
    Input: spec: Address
    Input: at: Integer
    Input: slot: Integer
    Input: bl: Integer
    Body: {
        one = 1
        i = at
        WhileLoop 1 {
            ch = GetByte(spec, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            known = 0
            IfCondition EqualTo(ch, 98) ThenBlock: {
                IfCondition Or(EqualTo(bl, 1), EqualTo(bl, 3)) ThenBlock: {
                    KeySet(slot, 4, 1)
                }
                IfCondition Or(EqualTo(bl, 2), EqualTo(bl, 3)) ThenBlock: {
                    KeySet(slot, 5, 1)
                }
                known = 1
            }
            IfCondition EqualTo(ch, 100) ThenBlock: {
                KeySet(slot, 6, 1)
                known = 1
            }
            IfCondition EqualTo(ch, 102) ThenBlock: {
                KeySet(slot, 7, 1)
                known = 1
            }
            IfCondition EqualTo(ch, 103) ThenBlock: {
                KeySet(slot, 9, 1)
                known = 1
            }
            IfCondition EqualTo(ch, 104) ThenBlock: {
                KeySet(slot, 10, 1)
                known = 1
            }
            IfCondition EqualTo(ch, 105) ThenBlock: {
                ign = KeyGet(slot, 6)
                IfCondition EqualTo(ign, 0) ThenBlock: {
                    KeySet(slot, 6, 2)
                }
                known = 1
            }
            IfCondition EqualTo(ch, 77) ThenBlock: {
                KeySet(slot, 11, 1)
                known = 1
            }
            IfCondition EqualTo(ch, 110) ThenBlock: {
                KeySet(slot, 8, 1)
                known = 1
            }
            IfCondition EqualTo(ch, 82) ThenBlock: {
                KeySet(slot, 13, 1)
                known = 1
            }
            IfCondition EqualTo(ch, 114) ThenBlock: {
                KeySet(slot, 14, 1)
                known = 1
            }
            IfCondition EqualTo(ch, 86) ThenBlock: {
                KeySet(slot, 12, 1)
                known = 1
            }
            IfCondition EqualTo(known, 0) ThenBlock: {
                BreakLoop
            }
            i = Add(i, one)
        }
        Work.pos = i
    }
}

Function.CopyKey {
    Input: src: Integer
    Input: dst: Integer
    Body: {
        one = 1
        f = 0
        WhileLoop LessThan(f, 16) {
            v = KeyGet(src, f)
            KeySet(dst, f, v)
            f = Add(f, one)
        }
    }
}

Function.ParseKeySpec {
    Input: spec: Address
    Body: {
        IfCondition GreaterEqual(Opt.nkeys, 28) ThenBlock: {
            Err("sort: too many keys\n")
            Die(2)
        }
        InitKey(29)
        ParseCount(spec, 0, 1, "invalid number at field start")
        IfCondition EqualTo(Work.num, 0) ThenBlock: {
            BadSpec("field number is zero", spec)
        }
        sword = Work.num
        IfCondition GreaterThan(sword, 999999999) ThenBlock: {
            sword = 999999999
        }
        sword = Subtract(sword, 1)
        pos = Work.pos
        schar = 0
        ch = GetByte(spec, pos)
        IfCondition EqualTo(ch, 46) ThenBlock: {
            nxt = Add(pos, 1)
            ParseCount(spec, nxt, 1, "invalid number after '.'")
            IfCondition EqualTo(Work.num, 0) ThenBlock: {
                BadSpec("character offset is zero", spec)
            }
            schar = Work.num
            IfCondition GreaterThan(schar, 999999999) ThenBlock: {
                schar = 999999999
            }
            schar = Subtract(schar, 1)
            pos = Work.pos
        }
        both = 0
        IfCondition EqualTo(sword, 0) ThenBlock: {
            IfCondition EqualTo(schar, 0) ThenBlock: {
                both = 1
            }
        }
        IfCondition EqualTo(both, 1) ThenBlock: {
            sword = -1
        }
        KeySet(29, 0, sword)
        KeySet(29, 1, schar)
        ApplyOrder(spec, pos, 29, 1)
        pos = Work.pos
        ch = GetByte(spec, pos)
        IfCondition NotEqual(ch, 44) ThenBlock: {
            IfCondition NotEqual(ch, 0) ThenBlock: {
                BadSpec("stray character in field spec", spec)
            }
            KeySet(29, 2, -1)
            KeySet(29, 3, 0)
        } ElseBlock: {
            nxt = Add(pos, 1)
            ParseCount(spec, nxt, 1, "invalid number after ','")
            IfCondition EqualTo(Work.num, 0) ThenBlock: {
                BadSpec("field number is zero", spec)
            }
            eword = Work.num
            IfCondition GreaterThan(eword, 999999999) ThenBlock: {
                eword = 999999999
            }
            eword = Subtract(eword, 1)
            pos = Work.pos
            echar = 0
            ch = GetByte(spec, pos)
            IfCondition EqualTo(ch, 46) ThenBlock: {
                nxt = Add(pos, 1)
                ParseCount(spec, nxt, 1, "invalid number after '.'")
                echar = Work.num
                IfCondition GreaterThan(echar, 999999999) ThenBlock: {
                    echar = 999999999
                }
                pos = Work.pos
            }
            ApplyOrder(spec, pos, 29, 2)
            pos = Work.pos
            ch = GetByte(spec, pos)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                BadSpec("stray character in field spec", spec)
            }
            KeySet(29, 2, eword)
            KeySet(29, 3, echar)
        }
        one = 1
        Opt.nkeys = Add(Opt.nkeys, one)
        CopyKey(29, Opt.nkeys)
    }
}

Function.TryPlus {
    Input: spec: Address
    Output: Integer
    Body: {
        one = 1
        ch = GetByte(spec, 0)
        IfCondition NotEqual(ch, 43) ThenBlock: {
            ReturnValue(0)
        }
        minus = 0
        nxt = PeekArg()
        IfCondition NotEqual(nxt, 0) ThenBlock: {
            c0 = GetByte(nxt, 0)
            c1 = GetByte(nxt, 1)
            dig = IsDigit(c1)
            IfCondition And(EqualTo(c0, 45), EqualTo(dig, 1)) ThenBlock: {
                minus = 1
            }
        }
        use = Opt.traditional
        IfCondition EqualTo(minus, 1) ThenBlock: {
            IfCondition EqualTo(Opt.posixly, 0) ThenBlock: {
                use = 1
                Opt.traditional = 1
            }
        }
        IfCondition EqualTo(use, 0) ThenBlock: {
            ReturnValue(0)
        }
        ok = ParseCount(spec, 1, 0, "invalid number at field start")
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        sword = Work.num
        pos = Work.pos
        schar = 0
        ch = GetByte(spec, pos)
        IfCondition EqualTo(ch, 46) ThenBlock: {
            nxtat = Add(pos, 1)
            ok = ParseCount(spec, nxtat, 0, "invalid number after '.'")
            IfCondition EqualTo(ok, 0) ThenBlock: {
                ReturnValue(0)
            }
            schar = Work.num
            pos = Work.pos
        }
        both = 0
        IfCondition EqualTo(sword, 0) ThenBlock: {
            IfCondition EqualTo(schar, 0) ThenBlock: {
                both = 1
            }
        }
        IfCondition EqualTo(both, 1) ThenBlock: {
            sword = -1
        }
        InitKey(29)
        KeySet(29, 0, sword)
        KeySet(29, 1, schar)
        ApplyOrder(spec, pos, 29, 1)
        pos = Work.pos
        ch = GetByte(spec, pos)
        IfCondition NotEqual(ch, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(minus, 1) ThenBlock: {
            endp = NextArg()
            ParseCount(endp, 1, 1, "invalid number after '-'")
            eword = Work.num
            pos = Work.pos
            echar = 0
            ch = GetByte(endp, pos)
            IfCondition EqualTo(ch, 46) ThenBlock: {
                nxtat = Add(pos, 1)
                ParseCount(endp, nxtat, 1, "invalid number after '.'")
                echar = Work.num
                pos = Work.pos
            }
            IfCondition EqualTo(echar, 0) ThenBlock: {
                IfCondition NotEqual(eword, 0) ThenBlock: {
                    eword = Subtract(eword, 1)
                }
            }
            ApplyOrder(endp, pos, 29, 2)
            pos = Work.pos
            ch = GetByte(endp, pos)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                BadSpec("stray character in field spec", endp)
            }
            KeySet(29, 2, eword)
            KeySet(29, 3, echar)
        } ElseBlock: {
            KeySet(29, 2, -1)
            KeySet(29, 3, 0)
        }
        KeySet(29, 15, 1)
        IfCondition GreaterEqual(Opt.nkeys, 28) ThenBlock: {
            Err("sort: too many keys\n")
            Die(2)
        }
        Opt.nkeys = Add(Opt.nkeys, one)
        CopyKey(29, Opt.nkeys)
        Work.ok = 1
        ReturnValue(Work.ok)
    }
}

Function.BadSize {
    Input: text: Address
    Input: is_long: Integer
    Body: {
        IfCondition EqualTo(is_long, 1) ThenBlock: {
            Err("sort: invalid --buffer-size argument '")
        } ElseBlock: {
            Err("sort: invalid -S argument '")
        }
        Err(text)
        Err("'\n")
        Die(2)
    }
}

Function.UnitPow {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(ch, 107), EqualTo(ch, 75)) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition Or(EqualTo(ch, 109), EqualTo(ch, 77)) ThenBlock: {
            ReturnValue(2)
        }
        IfCondition Or(EqualTo(ch, 103), EqualTo(ch, 71)) ThenBlock: {
            ReturnValue(3)
        }
        IfCondition Or(EqualTo(ch, 116), EqualTo(ch, 84)) ThenBlock: {
            ReturnValue(4)
        }
        IfCondition Or(EqualTo(ch, 112), EqualTo(ch, 80)) ThenBlock: {
            ReturnValue(5)
        }
        IfCondition Or(EqualTo(ch, 101), EqualTo(ch, 69)) ThenBlock: {
            ReturnValue(6)
        }
        IfCondition Or(EqualTo(ch, 122), EqualTo(ch, 90)) ThenBlock: {
            ReturnValue(7)
        }
        IfCondition Or(EqualTo(ch, 121), EqualTo(ch, 89)) ThenBlock: {
            ReturnValue(8)
        }
        IfCondition Or(EqualTo(ch, 114), EqualTo(ch, 82)) ThenBlock: {
            ReturnValue(9)
        }
        IfCondition Or(EqualTo(ch, 113), EqualTo(ch, 81)) ThenBlock: {
            ReturnValue(10)
        }
        IfCondition EqualTo(ch, 98) ThenBlock: {
            ReturnValue(-2)
        }
        ReturnValue(-1)
    }
}

Function.Mul1024 {
    Input: n: Integer
    Input: times: Integer
    Output: Integer
    Body: {
        one = 1
        v = n
        t = 0
        ov = 0
        WhileLoop LessThan(t, times) {
            IfCondition GreaterThan(v, 9007199254740992) ThenBlock: {
                ov = 1
                BreakLoop
            }
            v = Multiply(v, 1024)
            t = Add(t, one)
        }
        IfCondition EqualTo(ov, 1) ThenBlock: {
            v = 9007199254740992
        }
        Work.val = v
        ReturnValue(Work.val)
    }
}

Function.ParseSize {
    Input: text: Address
    Input: is_long: Integer
    Body: {
        one = 1
        i = 0
        ch = GetByte(text, i)
        dig = IsDigit(ch)
        IfCondition EqualTo(dig, 0) ThenBlock: {
            BadSize(text, is_long)
        }
        val = 0
        ov = 0
        WhileLoop 1 {
            ch = GetByte(text, i)
            dig = IsDigit(ch)
            IfCondition EqualTo(dig, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition GreaterThan(val, 9007199254740992) ThenBlock: {
                ov = 1
            }
            val = Multiply(val, 10)
            val = Add(val, Subtract(ch, 48))
            i = Add(i, one)
        }
        IfCondition EqualTo(ov, 1) ThenBlock: {
            val = 9007199254740992
        }
        ch = GetByte(text, i)
        IfCondition NotEqual(ch, 0) ThenBlock: {
            nxt = Add(i, one)
            nx = GetByte(text, nxt)
            IfCondition NotEqual(nx, 0) ThenBlock: {
                BadSize(text, is_long)
            }
            pw = UnitPow(ch)
            IfCondition EqualTo(pw, -1) ThenBlock: {
                BadSize(text, is_long)
            }
            IfCondition GreaterThan(pw, 0) ThenBlock: {
                val = Mul1024(val, pw)
            }
        } ElseBlock: {
            val = Mul1024(val, 1)
        }
        IfCondition EqualTo(Opt.sort_set, 0) ThenBlock: {
            Opt.sort_size = val
            Opt.sort_set = 1
        } ElseBlock: {
            IfCondition GreaterThan(val, Opt.sort_size) ThenBlock: {
                Opt.sort_size = val
            }
        }
    }
}

Function.BadBatch {
    Input: text: Address
    Input: big: Integer
    Body: {
        IfCondition EqualTo(big, 1) ThenBlock: {
            Err("sort: --batch-size argument '")
            Err(text)
            Err("' too large\n")
            Err("sort: maximum --batch-size argument with current rlimit is ")
            ErrNum(Work.maxn)
            Err("\n")
            Die(2)
        }
        Err("sort: invalid --batch-size argument '")
        Err(text)
        Err("'\n")
        Die(2)
    }
}

Function.ParseBatch {
    Input: text: Address
    Body: {
        buf = Allocate(32)
        r = SystemCall(97, 7, buf)
        maxn = 1021
        IfCondition GreaterEqual(r, 0) ThenBlock: {
            hi = ReadI32(buf, 4)
            cur = ReadI32(buf, 0)
            IfCondition NotEqual(hi, 0) ThenBlock: {
                maxn = 100000000
            } ElseBlock: {
                IfCondition GreaterThan(cur, 3) ThenBlock: {
                    maxn = Subtract(cur, 3)
                }
            }
        }
        Deallocate(buf, 32)
        Work.maxn = maxn
        ch = GetByte(text, 0)
        IfCondition EqualTo(ch, 45) ThenBlock: {
            BadBatch(text, 0)
        }
        dig = IsDigit(ch)
        IfCondition EqualTo(dig, 0) ThenBlock: {
            BadBatch(text, 0)
        }
        one = 1
        i = 0
        val = 0
        ov = 0
        WhileLoop 1 {
            ch = GetByte(text, i)
            dig = IsDigit(ch)
            IfCondition EqualTo(dig, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition GreaterThan(val, 999999999) ThenBlock: {
                ov = 1
            }
            val = Multiply(val, 10)
            val = Add(val, Subtract(ch, 48))
            i = Add(i, one)
        }
        IfCondition NotEqual(ch, 0) ThenBlock: {
            BadBatch(text, 0)
        }
        IfCondition EqualTo(ov, 1) ThenBlock: {
            BadBatch(text, 1)
        }
        IfCondition GreaterThan(val, maxn) ThenBlock: {
            BadBatch(text, 1)
        }
        IfCondition LessThan(val, 2) ThenBlock: {
            Err("sort: invalid --batch-size argument '")
            Err(text)
            Err("'\n")
            Err("sort: minimum --batch-size argument is '2'\n")
            Die(2)
        }
        Opt.batch = val
    }
}

Function.ParseParallel {
    Input: text: Address
    Body: {
        ch = GetByte(text, 0)
        IfCondition Or(EqualTo(ch, 45), EqualTo(ch, 0)) ThenBlock: {
            Err("sort: invalid --parallel argument '")
            Err(text)
            Err("'\n")
            Die(2)
        }
        one = 1
        i = 0
        val = 0
        WhileLoop 1 {
            ch = GetByte(text, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            dig = IsDigit(ch)
            IfCondition EqualTo(dig, 0) ThenBlock: {
                Err("sort: invalid --parallel argument '")
                Err(text)
                Err("'\n")
                Die(2)
            }
            val = Multiply(val, 10)
            val = Add(val, Subtract(ch, 48))
            i = Add(i, one)
        }
        IfCondition EqualTo(val, 0) ThenBlock: {
            Err("sort: number in parallel must be nonzero\n")
            Die(2)
        }
        Opt.parallel = val
    }
}

Function.SetTab {
    Input: text: Address
    Body: {
        c0 = GetByte(text, 0)
        IfCondition EqualTo(c0, 0) ThenBlock: {
            Err("sort: empty tab\n")
            Die(2)
        }
        c1 = GetByte(text, 1)
        tab = c0
        IfCondition NotEqual(c1, 0) ThenBlock: {
            c2 = GetByte(text, 2)
            isnul = 0
            IfCondition EqualTo(c0, 92) ThenBlock: {
                IfCondition EqualTo(c1, 48) ThenBlock: {
                    IfCondition EqualTo(c2, 0) ThenBlock: {
                        isnul = 1
                    }
                }
            }
            IfCondition EqualTo(isnul, 1) ThenBlock: {
                tab = 0
            } ElseBlock: {
                Err("sort: multi-character tab '")
                Err(text)
                Err("'\n")
                Die(2)
            }
        }
        IfCondition EqualTo(Opt.tab_set, 1) ThenBlock: {
            IfCondition NotEqual(Opt.tab, tab) ThenBlock: {
                Err("sort: incompatible tabs\n")
                Die(2)
            }
        }
        Opt.tab = tab
        Opt.tab_set = 1
    }
}

Function.SetOut {
    Input: text: Address
    Body: {
        IfCondition EqualTo(Opt.out_set, 1) ThenBlock: {
            eq = CEq(Opt.out_file, text)
            IfCondition EqualTo(eq, 0) ThenBlock: {
                Err("sort: multiple output files specified\n")
                Die(2)
            }
        }
        Opt.out_file = text
        Opt.out_set = 1
    }
}

Function.SetCheck {
    Input: mode: Integer
    Body: {
        IfCondition NotEqual(Opt.check, 0) ThenBlock: {
            IfCondition NotEqual(Opt.check, mode) ThenBlock: {
                Err("sort: options '-cC' are incompatible\n")
                Die(2)
            }
        }
        Opt.check = mode
    }
}

Function.ApplyOne {
    Input: ch: Integer
    Body: {
        SetByte(Ptr.scratch, 0, ch)
        SetByte(Ptr.scratch, 1, 0)
        ApplyOrder(Ptr.scratch, 0, 0, 3)
    }
}

Function.SortKind {
    Input: name: Address
    Body: {
        hit = CEq(name, "general-numeric")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ApplyOne(103)
            ReturnValue(0)
        }
        hit = CEq(name, "human-numeric")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ApplyOne(104)
            ReturnValue(0)
        }
        hit = CEq(name, "month")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ApplyOne(77)
            ReturnValue(0)
        }
        hit = CEq(name, "numeric")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ApplyOne(110)
            ReturnValue(0)
        }
        hit = CEq(name, "random")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ApplyOne(82)
            ReturnValue(0)
        }
        hit = CEq(name, "version")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ApplyOne(86)
            ReturnValue(0)
        }
        Err("sort: invalid argument '")
        Err(name)
        Err("' for '--sort'\n")
        Err("Valid arguments are:\n")
        Err("  - 'general-numeric'\n")
        Err("  - 'human-numeric'\n")
        Err("  - 'month'\n")
        Err("  - 'numeric'\n")
        Err("  - 'random'\n")
        Err("  - 'version'\n")
        TryHelp()
        Die(1)
    }
}

Function.CheckKind {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            SetCheck(99)
            ReturnValue(0)
        }
        hit = CEq(name, "diagnose-first")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            SetCheck(99)
            ReturnValue(0)
        }
        hit = CEq(name, "quiet")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            SetCheck(67)
            ReturnValue(0)
        }
        hit = CEq(name, "silent")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            SetCheck(67)
            ReturnValue(0)
        }
        Err("sort: invalid argument '")
        Err(name)
        Err("' for '--check'\n")
        Err("Valid arguments are:\n")
        Err("  - 'quiet', 'silent'\n")
        Err("  - 'diagnose-first'\n")
        TryHelp()
        Die(1)
    }
}

Function.NoteOpt {
    Input: user: Address
    Input: full: Address
    Input: id: Integer
    Body: {
        eq = CEq(user, full)
        IfCondition EqualTo(eq, 1) ThenBlock: {
            Work.exact = id
        } ElseBlock: {
            pre = IsPre(user, full)
            IfCondition EqualTo(pre, 1) ThenBlock: {
                one = 1
                Work.hits = Add(Work.hits, one)
                Work.which = id
            }
        }
    }
}

Function.MatchLong {
    Input: user: Address
    Output: Integer
    Body: {
        Work.exact = 0
        Work.hits = 0
        Work.which = 0
        NoteOpt(user, "ignore-leading-blanks", 1)
        NoteOpt(user, "check", 2)
        NoteOpt(user, "compress-program", 3)
        NoteOpt(user, "debug", 4)
        NoteOpt(user, "dictionary-order", 5)
        NoteOpt(user, "ignore-case", 6)
        NoteOpt(user, "files0-from", 7)
        NoteOpt(user, "general-numeric-sort", 8)
        NoteOpt(user, "ignore-nonprinting", 9)
        NoteOpt(user, "key", 10)
        NoteOpt(user, "merge", 11)
        NoteOpt(user, "month-sort", 12)
        NoteOpt(user, "numeric-sort", 13)
        NoteOpt(user, "human-numeric-sort", 14)
        NoteOpt(user, "version-sort", 15)
        NoteOpt(user, "random-sort", 16)
        NoteOpt(user, "random-source", 17)
        NoteOpt(user, "sort", 18)
        NoteOpt(user, "output", 19)
        NoteOpt(user, "reverse", 20)
        NoteOpt(user, "stable", 21)
        NoteOpt(user, "batch-size", 22)
        NoteOpt(user, "buffer-size", 23)
        NoteOpt(user, "field-separator", 24)
        NoteOpt(user, "temporary-directory", 25)
        NoteOpt(user, "unique", 26)
        NoteOpt(user, "zero-terminated", 27)
        NoteOpt(user, "parallel", 28)
        NoteOpt(user, "help", 29)
        NoteOpt(user, "version", 30)
        IfCondition NotEqual(Work.exact, 0) ThenBlock: {
            Work.which = Work.exact
            ReturnValue(Work.which)
        }
        IfCondition EqualTo(Work.hits, 1) ThenBlock: {
            ReturnValue(Work.which)
        }
        IfCondition GreaterThan(Work.hits, 1) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(0)
    }
}

Function.NeedsArg {
    Input: id: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(id, 3) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(id, 7) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(id, 10) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(id, 17) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(id, 18) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(id, 19) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(id, 22) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(id, 23) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(id, 24) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(id, 25) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(id, 28) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.TakeLong {
    Input: id: Integer
    Input: arg: Address
    Input: has: Integer
    Body: {
        need = NeedsArg(id)
        IfCondition EqualTo(need, 1) ThenBlock: {
            IfCondition EqualTo(has, 0) ThenBlock: {
                arg = NextArg()
                IfCondition EqualTo(arg, 0) ThenBlock: {
                    Err("sort: option '--")
                    Err(Ptr.optbuf)
                    Err("' requires an argument\n")
                    TryHelp()
                    Die(2)
                }
            }
        }
        IfCondition EqualTo(need, 0) ThenBlock: {
            IfCondition NotEqual(id, 2) ThenBlock: {
                IfCondition EqualTo(has, 1) ThenBlock: {
                    Err("sort: option '--")
                    Err(Ptr.optbuf)
                    Err("' doesn't allow an argument\n")
                    TryHelp()
                    Die(2)
                }
            }
        }
        IfCondition EqualTo(id, 1) ThenBlock: { ApplyOne(98) }
        IfCondition EqualTo(id, 2) ThenBlock: {
            IfCondition EqualTo(has, 0) ThenBlock: {
                CheckKind(0)
            } ElseBlock: {
                CheckKind(arg)
            }
        }
        IfCondition EqualTo(id, 3) ThenBlock: {
            IfCondition EqualTo(Opt.compress, 1) ThenBlock: {
                eq = CEq(Opt.compress_prog, arg)
                IfCondition EqualTo(eq, 0) ThenBlock: {
                    Err("sort: multiple compress programs specified\n")
                    Die(2)
                }
            }
            Opt.compress = 1
            Opt.compress_prog = arg
        }
        IfCondition EqualTo(id, 4) ThenBlock: { Opt.debug = 1 }
        IfCondition EqualTo(id, 5) ThenBlock: { ApplyOne(100) }
        IfCondition EqualTo(id, 6) ThenBlock: { ApplyOne(102) }
        IfCondition EqualTo(id, 7) ThenBlock: {
            Opt.files0 = 1
            Opt.files0_path = arg
        }
        IfCondition EqualTo(id, 8) ThenBlock: { ApplyOne(103) }
        IfCondition EqualTo(id, 9) ThenBlock: { ApplyOne(105) }
        IfCondition EqualTo(id, 10) ThenBlock: { ParseKeySpec(arg) }
        IfCondition EqualTo(id, 11) ThenBlock: { Opt.merge = 1 }
        IfCondition EqualTo(id, 12) ThenBlock: { ApplyOne(77) }
        IfCondition EqualTo(id, 13) ThenBlock: { ApplyOne(110) }
        IfCondition EqualTo(id, 14) ThenBlock: { ApplyOne(104) }
        IfCondition EqualTo(id, 15) ThenBlock: { ApplyOne(86) }
        IfCondition EqualTo(id, 16) ThenBlock: { ApplyOne(82) }
        IfCondition EqualTo(id, 17) ThenBlock: {
            IfCondition EqualTo(Opt.random_set, 1) ThenBlock: {
                eq = CEq(Opt.random_src, arg)
                IfCondition EqualTo(eq, 0) ThenBlock: {
                    Err("sort: multiple random sources specified\n")
                    Die(2)
                }
            }
            Opt.random_set = 1
            Opt.random_src = arg
        }
        IfCondition EqualTo(id, 18) ThenBlock: { SortKind(arg) }
        IfCondition EqualTo(id, 19) ThenBlock: { SetOut(arg) }
        IfCondition EqualTo(id, 20) ThenBlock: { ApplyOne(114) }
        IfCondition EqualTo(id, 21) ThenBlock: { Opt.stable = 1 }
        IfCondition EqualTo(id, 22) ThenBlock: { ParseBatch(arg) }
        IfCondition EqualTo(id, 23) ThenBlock: { ParseSize(arg, 1) }
        IfCondition EqualTo(id, 24) ThenBlock: { SetTab(arg) }
        IfCondition EqualTo(id, 25) ThenBlock: { Opt.tmpdir = arg }
        IfCondition EqualTo(id, 26) ThenBlock: { Opt.unique = 1 }
        IfCondition EqualTo(id, 27) ThenBlock: { Opt.eol = 0 }
        IfCondition EqualTo(id, 28) ThenBlock: { ParseParallel(arg) }
        IfCondition EqualTo(id, 29) ThenBlock: {
            OutStr("Usage: sort [OPTION]... [FILE]...\n")
            FlushOut()
            Die(0)
        }
        IfCondition EqualTo(id, 30) ThenBlock: {
            OutStr("sort (AILANG coreutils) 9.4\n")
            FlushOut()
            Die(0)
        }
    }
}

Function.ParseLong {
    Input: s: Address
    Body: {
        one = 1
        i = 2
        n = 0
        has = 0
        WhileLoop LessThan(n, 60) {
            ch = GetByte(s, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition EqualTo(ch, 61) ThenBlock: {
                has = 1
                BreakLoop
            }
            SetByte(Ptr.optbuf, n, ch)
            n = Add(n, one)
            i = Add(i, one)
        }
        SetByte(Ptr.optbuf, n, 0)
        id = MatchLong(Ptr.optbuf)
        IfCondition EqualTo(id, 0) ThenBlock: {
            Err("sort: unrecognized option '--")
            Err(Ptr.optbuf)
            Err("'\n")
            TryHelp()
            Die(2)
        }
        IfCondition LessThan(id, 0) ThenBlock: {
            Err("sort: option '--")
            Err(Ptr.optbuf)
            Err("' is ambiguous\n")
            TryHelp()
            Die(2)
        }
        arg = 0
        IfCondition EqualTo(has, 1) ThenBlock: {
            nxt = Add(i, one)
            arg = Add(s, nxt)
        }
        TakeLong(id, arg, has)
    }
}

Function.AllDigits {
    Input: s: Address
    Output: Integer
    Body: {
        one = 1
        i = 0
        WhileLoop 1 {
            ch = GetByte(s, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                ReturnValue(1)
            }
            dig = IsDigit(ch)
            IfCondition EqualTo(dig, 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        ReturnValue(1)
    }
}

Function.NeedShort {
    Input: s: Address
    Input: i: Integer
    Input: letter: Integer
    Output: Address
    Body: {
        one = 1
        nxt = Add(i, one)
        ch = GetByte(s, nxt)
        IfCondition NotEqual(ch, 0) ThenBlock: {
            Work.argp = Add(s, nxt)
            ReturnValue(Work.argp)
        }
        arg = NextArg()
        IfCondition EqualTo(arg, 0) ThenBlock: {
            Err("sort: option requires an argument -- '")
            ErrChar(letter)
            Err("'\n")
            TryHelp()
            Die(2)
        }
        ReturnValue(arg)
    }
}

Function.ParseShort {
    Input: s: Address
    Body: {
        one = 1
        i = 1
        WhileLoop 1 {
            ch = GetByte(s, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition EqualTo(ch, 107) ThenBlock: {
                arg = NeedShort(s, i, 107)
                ParseKeySpec(arg)
                BreakLoop
            }
            IfCondition EqualTo(ch, 111) ThenBlock: {
                arg = NeedShort(s, i, 111)
                SetOut(arg)
                BreakLoop
            }
            IfCondition EqualTo(ch, 83) ThenBlock: {
                arg = NeedShort(s, i, 83)
                ParseSize(arg, 0)
                BreakLoop
            }
            IfCondition EqualTo(ch, 116) ThenBlock: {
                arg = NeedShort(s, i, 116)
                SetTab(arg)
                BreakLoop
            }
            IfCondition EqualTo(ch, 84) ThenBlock: {
                arg = NeedShort(s, i, 84)
                Opt.tmpdir = arg
                BreakLoop
            }
            IfCondition EqualTo(ch, 121) ThenBlock: {
                nxt = Add(i, one)
                c = GetByte(s, nxt)
                IfCondition NotEqual(c, 0) ThenBlock: {
                    BreakLoop
                }
                pk = PeekArg()
                IfCondition EqualTo(pk, 0) ThenBlock: {
                    Err("sort: option requires an argument -- 'y'\n")
                    TryHelp()
                    Die(2)
                }
                all = AllDigits(pk)
                IfCondition EqualTo(all, 1) ThenBlock: {
                    NextArg()
                }
                BreakLoop
            }
            known = 0
            IfCondition EqualTo(ch, 98) ThenBlock: {
                ApplyOne(98)
                known = 1
            }
            IfCondition EqualTo(ch, 99) ThenBlock: {
                SetCheck(99)
                known = 1
            }
            IfCondition EqualTo(ch, 67) ThenBlock: {
                SetCheck(67)
                known = 1
            }
            IfCondition EqualTo(ch, 100) ThenBlock: {
                ApplyOne(100)
                known = 1
            }
            IfCondition EqualTo(ch, 102) ThenBlock: {
                ApplyOne(102)
                known = 1
            }
            IfCondition EqualTo(ch, 103) ThenBlock: {
                ApplyOne(103)
                known = 1
            }
            IfCondition EqualTo(ch, 104) ThenBlock: {
                ApplyOne(104)
                known = 1
            }
            IfCondition EqualTo(ch, 105) ThenBlock: {
                ApplyOne(105)
                known = 1
            }
            IfCondition EqualTo(ch, 109) ThenBlock: {
                Opt.merge = 1
                known = 1
            }
            IfCondition EqualTo(ch, 77) ThenBlock: {
                ApplyOne(77)
                known = 1
            }
            IfCondition EqualTo(ch, 110) ThenBlock: {
                ApplyOne(110)
                known = 1
            }
            IfCondition EqualTo(ch, 114) ThenBlock: {
                ApplyOne(114)
                known = 1
            }
            IfCondition EqualTo(ch, 82) ThenBlock: {
                ApplyOne(82)
                known = 1
            }
            IfCondition EqualTo(ch, 115) ThenBlock: {
                Opt.stable = 1
                known = 1
            }
            IfCondition EqualTo(ch, 117) ThenBlock: {
                Opt.unique = 1
                known = 1
            }
            IfCondition EqualTo(ch, 86) ThenBlock: {
                ApplyOne(86)
                known = 1
            }
            IfCondition EqualTo(ch, 122) ThenBlock: {
                Opt.eol = 0
                known = 1
            }
            IfCondition EqualTo(known, 0) ThenBlock: {
                Err("sort: invalid option -- '")
                ErrChar(ch)
                Err("'\n")
                TryHelp()
                Die(2)
            }
            i = Add(i, one)
        }
    }
}

Function.HandleTok {
    Input: p: Address
    Body: {
        c0 = GetByte(p, 0)
        c1 = GetByte(p, 1)
        c2 = GetByte(p, 2)
        IfCondition EqualTo(c0, 43) ThenBlock: {
            got = TryPlus(p)
            IfCondition EqualTo(got, 0) ThenBlock: {
                AddFile(p)
            }
            ReturnValue(0)
        }
        isopt = 0
        IfCondition EqualTo(c0, 45) ThenBlock: {
            IfCondition NotEqual(c1, 0) ThenBlock: {
                isopt = 1
            }
        }
        IfCondition EqualTo(isopt, 1) ThenBlock: {
            IfCondition EqualTo(c1, 45) ThenBlock: {
                IfCondition EqualTo(c2, 0) ThenBlock: {
                    Opt.opt_done = 1
                    ReturnValue(0)
                }
                ParseLong(p)
                ReturnValue(0)
            }
            ParseShort(p)
            ReturnValue(0)
        }
        AddFile(p)
    }
}

Function.ParseArgs {
    Body: {
        one = 1
        Opt.argi = 1
        WhileLoop LessThan(Opt.argi, Opt.argc) {
            p = ArgPtr(Opt.argi)
            as_file = 0
            IfCondition EqualTo(Opt.opt_done, 1) ThenBlock: {
                as_file = 1
            }
            IfCondition EqualTo(as_file, 0) ThenBlock: {
                IfCondition And(EqualTo(Opt.posixly, 1), GreaterThan(Opt.nfiles, 0)) ThenBlock: {
                    c0 = GetByte(p, 0)
                    c1 = GetByte(p, 1)
                    allow = 0
                    IfCondition And(EqualTo(Opt.traditional, 1), EqualTo(Opt.check, 0)) ThenBlock: {
                        IfCondition And(EqualTo(c0, 45), EqualTo(c1, 111)) ThenBlock: {
                            allow = 1
                        }
                    }
                    IfCondition EqualTo(allow, 0) ThenBlock: {
                        as_file = 1
                    }
                }
            }
            IfCondition EqualTo(as_file, 1) ThenBlock: {
                AddFile(p)
            } ElseBlock: {
                HandleTok(p)
            }
            Opt.argi = Add(Opt.argi, one)
        }
    }
}
