// Read, sort, check, and write for sort. Pools live on sort.ailang.

Function.FileAt {
    Input: i: Integer
    Output: Address
    Body: {
        p = Dereference(Add(Ptr.files, Multiply(i, 8)))
        Work.name = p
        ReturnValue(Work.name)
    }
}

Function.LineAt {
    Input: i: Integer
    Output: Address
    Body: {
        p = Dereference(Add(Ptr.lines, Multiply(i, 8)))
        Work.rec = p
        ReturnValue(Work.rec)
    }
}

Function.IsDash {
    Input: p: Address
    Output: Integer
    Body: {
        c0 = GetByte(p, 0)
        c1 = GetByte(p, 1)
        ok = 0
        IfCondition And(EqualTo(c0, 45), EqualTo(c1, 0)) ThenBlock: {
            ok = 1
        }
        Work.dash = ok
        ReturnValue(Work.dash)
    }
}

Function.CopyFrom {
    Input: src: Address
    Input: off: Integer
    Input: len: Integer
    Output: Address
    Body: {
        need = Add(len, 1)
        sz = Bucket(need)
        dest = Allocate(sz)
        one = 1
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(src, Add(off, i))
            SetByte(dest, i, ch)
            i = Add(i, one)
        }
        SetByte(dest, len, 0)
        Work.argp = dest
        ReturnValue(Work.argp)
    }
}

Function.PutStr {
    Input: dst: Address
    Input: at: Integer
    Input: src: Address
    Output: Integer
    Body: {
        one = 1
        i = 0
        WhileLoop 1 {
            ch = GetByte(src, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            SetByte(dst, Add(at, i), ch)
            i = Add(i, one)
        }
        Work.pos = Add(at, i)
        ReturnValue(Work.pos)
    }
}

Function.AppendCarry {
    Input: src: Address
    Input: off: Integer
    Input: len: Integer
    Body: {
        IfCondition EqualTo(len, 0) ThenBlock: {
            ReturnValue(0)
        }
        sum = Add(Work.acc, len)
        IfCondition GreaterThan(sum, 1048575) ThenBlock: {
            Err("sort: line too long\n")
            Die(2)
        }
        one = 1
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(src, Add(off, i))
            SetByte(Ptr.carry, Add(Work.acc, i), ch)
            i = Add(i, one)
        }
        Work.acc = sum
    }
}

Function.PushLine {
    Input: src: Address
    Input: off: Integer
    Input: len: Integer
    Body: {
        IfCondition GreaterEqual(Opt.line_count, Opt.cap_lines) ThenBlock: {
            Err("sort: too many lines\n")
            Die(2)
        }
        IfCondition GreaterThan(len, 1048576) ThenBlock: {
            Err("sort: line too long\n")
            Die(2)
        }
        need = Add(len, 17)
        sz = Bucket(need)
        rec = Allocate(sz)
        StoreValue(rec, len)
        StoreValue(Add(rec, 8), Opt.line_count)
        one = 1
        i = 0
        base = 16
        WhileLoop LessThan(i, len) {
            ch = GetByte(src, Add(off, i))
            SetByte(rec, Add(base, i), ch)
            i = Add(i, one)
        }
        SetByte(rec, Add(base, len), 0)
        slot = Add(Ptr.lines, Multiply(Opt.line_count, 8))
        StoreValue(slot, rec)
        Opt.line_count = Add(Opt.line_count, one)
    }
}

Function.ReadFd {
    Input: fd: Integer
    Body: {
        Work.acc = 0
        Work.err = 0
        one = 1
        WhileLoop 1 {
            n = SystemCall(0, fd, Ptr.rdbuf, 262144)
            IfCondition LessThan(n, 0) ThenBlock: {
                Work.err = Subtract(0, n)
                BreakLoop
            }
            IfCondition EqualTo(n, 0) ThenBlock: {
                BreakLoop
            }
            seg = 0
            i = 0
            WhileLoop LessThan(i, n) {
                ch = GetByte(Ptr.rdbuf, i)
                IfCondition EqualTo(ch, Opt.eol) ThenBlock: {
                    plen = Subtract(i, seg)
                    IfCondition EqualTo(Work.acc, 0) ThenBlock: {
                        PushLine(Ptr.rdbuf, seg, plen)
                    } ElseBlock: {
                        AppendCarry(Ptr.rdbuf, seg, plen)
                        PushLine(Ptr.carry, 0, Work.acc)
                        Work.acc = 0
                    }
                    i = Add(i, one)
                    seg = i
                } ElseBlock: {
                    i = Add(i, one)
                }
            }
            IfCondition LessThan(seg, n) ThenBlock: {
                left = Subtract(n, seg)
                AppendCarry(Ptr.rdbuf, seg, left)
            }
        }
        IfCondition EqualTo(Work.err, 0) ThenBlock: {
            IfCondition GreaterThan(Work.acc, 0) ThenBlock: {
                PushLine(Ptr.carry, 0, Work.acc)
                Work.acc = 0
            }
        }
    }
}

Function.ReadFile {
    Input: name: Address
    Input: kind: Address
    Body: {
        dash = IsDash(name)
        IfCondition EqualTo(dash, 1) ThenBlock: {
            ReadFd(0)
            IfCondition NotEqual(Work.err, 0) ThenBlock: {
                DieMsg("read failed", name, Work.err)
            }
            ReturnValue(0)
        }
        fd = SystemCall(2, name, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            err = Subtract(0, fd)
            DieMsg(kind, name, err)
        }
        ReadFd(fd)
        SystemCall(3, fd)
        IfCondition NotEqual(Work.err, 0) ThenBlock: {
            DieMsg("read failed", name, Work.err)
        }
    }
}

Function.ReadAll {
    Input: kind: Address
    Body: {
        one = 1
        i = 0
        WhileLoop LessThan(i, Opt.nfiles) {
            name = FileAt(i)
            ReadFile(name, kind)
            i = Add(i, one)
        }
    }
}

Function.ComparePtr {
    Input: la: Address
    Input: lb: Address
    Output: Integer
    Body: {
        diff = 0
        IfCondition GreaterThan(Opt.nkeys, 0) ThenBlock: {
            one = 1
            ki = 1
            WhileLoop LessEqual(ki, Opt.nkeys) {
                diff = KeyDiff(la, lb, ki)
                IfCondition NotEqual(diff, 0) ThenBlock: {
                    BreakLoop
                }
                ki = Add(ki, one)
            }
            stop = Or(NotEqual(diff, 0), Or(EqualTo(Opt.unique, 1), EqualTo(Opt.stable, 1)))
            IfCondition EqualTo(stop, 1) ThenBlock: {
                Opt.diff = diff
                ReturnValue(Opt.diff)
            }
        }
        na = LineLen(la)
        nb = LineLen(lb)
        Opt.ign = 0
        Opt.fold = 0
        diff = CmpRaw(la, 0, na, lb, 0, nb)
        IfCondition And(NotEqual(diff, 0), EqualTo(Opt.reverse, 1)) ThenBlock: {
            diff = Subtract(0, diff)
        }
        Opt.diff = diff
        ReturnValue(Opt.diff)
    }
}

Function.MergeRange {
    Input: left: Integer
    Input: mid: Integer
    Input: right: Integer
    Body: {
        i = left
        j = mid
        k = left
        one = 1
        WhileLoop And(LessThan(i, mid), LessThan(j, right)) {
            la = LineAt(i)
            lb = LineAt(j)
            d = ComparePtr(la, lb)
            IfCondition LessEqual(d, 0) ThenBlock: {
                StoreValue(Add(Ptr.lines2, Multiply(k, 8)), la)
                i = Add(i, one)
            } ElseBlock: {
                StoreValue(Add(Ptr.lines2, Multiply(k, 8)), lb)
                j = Add(j, one)
            }
            k = Add(k, one)
        }
        WhileLoop LessThan(i, mid) {
            la = LineAt(i)
            StoreValue(Add(Ptr.lines2, Multiply(k, 8)), la)
            i = Add(i, one)
            k = Add(k, one)
        }
        WhileLoop LessThan(j, right) {
            lb = LineAt(j)
            StoreValue(Add(Ptr.lines2, Multiply(k, 8)), lb)
            j = Add(j, one)
            k = Add(k, one)
        }
        k = left
        WhileLoop LessThan(k, right) {
            p = Dereference(Add(Ptr.lines2, Multiply(k, 8)))
            StoreValue(Add(Ptr.lines, Multiply(k, 8)), p)
            k = Add(k, one)
        }
    }
}

Function.MergeSort {
    Body: {
        one = 1
        width = 1
        WhileLoop LessThan(width, Opt.line_count) {
            left = 0
            step = Add(width, width)
            WhileLoop LessThan(left, Opt.line_count) {
                mid = Add(left, width)
                IfCondition GreaterThan(mid, Opt.line_count) ThenBlock: {
                    mid = Opt.line_count
                }
                right = Add(mid, width)
                IfCondition GreaterThan(right, Opt.line_count) ThenBlock: {
                    right = Opt.line_count
                }
                go = And(LessThan(left, mid), LessThan(mid, right))
                IfCondition EqualTo(go, 1) ThenBlock: {
                    MergeRange(left, mid, right)
                }
                left = Add(left, step)
            }
            width = step
        }
    }
}

Function.UniqueLines {
    Body: {
        IfCondition LessEqual(Opt.line_count, 1) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        kept = 1
        i = 1
        WhileLoop LessThan(i, Opt.line_count) {
            prev_i = Subtract(kept, one)
            prev = LineAt(prev_i)
            cur = LineAt(i)
            d = ComparePtr(prev, cur)
            IfCondition NotEqual(d, 0) ThenBlock: {
                StoreValue(Add(Ptr.lines, Multiply(kept, 8)), cur)
                kept = Add(kept, one)
            }
            i = Add(i, one)
        }
        Opt.line_count = kept
    }
}

Function.WriteFd {
    Input: fd: Integer
    Input: buf: Address
    Input: n: Integer
    Body: {
        IfCondition LessEqual(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        off = 0
        left = n
        WhileLoop GreaterThan(left, 0) {
            nw = SystemCall(1, fd, Add(buf, off), left)
            IfCondition LessThan(nw, 0) ThenBlock: {
                err = Subtract(0, nw)
                msg = GetErrStr(err)
                Err("sort: write failed: ")
                IfCondition EqualTo(Opt.out_set, 1) ThenBlock: {
                    Err(Opt.out_file)
                } ElseBlock: {
                    Err("standard output")
                }
                Err(": ")
                Err(msg)
                Err("\n")
                Die(2)
            }
            IfCondition EqualTo(nw, 0) ThenBlock: {
                Err("sort: write failed: standard output\n")
                Die(2)
            }
            off = Add(off, nw)
            left = Subtract(left, nw)
        }
    }
}

Function.WriteAll {
    Body: {
        IfCondition And(EqualTo(Opt.debug, 1), EqualTo(Opt.out_set, 0)) ThenBlock: {
            Work.wfd = 1
            one = 1
            i = 0
            WhileLoop LessThan(i, Opt.line_count) {
                line = LineAt(i)
                DebugShow(line)
                i = Add(i, one)
            }
            FlushOut()
            ReturnValue(0)
        }
        fd = 1
        IfCondition EqualTo(Opt.out_set, 1) ThenBlock: {
            fd = SystemCall(2, Opt.out_file, 577, 438)
            IfCondition LessThan(fd, 0) ThenBlock: {
                err = Subtract(0, fd)
                DieMsg("open failed", Opt.out_file, err)
            }
        }
        Work.wfd = fd
        one = 1
        i = 0
        WhileLoop LessThan(i, Opt.line_count) {
            line = LineAt(i)
            nb = LineLen(line)
            IfCondition GreaterThan(nb, 0) ThenBlock: {
                WriteFd(fd, Add(line, 16), nb)
            }
            SetByte(Ptr.scratch, 0, Opt.eol)
            WriteFd(fd, Ptr.scratch, 1)
            i = Add(i, one)
        }
        IfCondition NotEqual(fd, 1) ThenBlock: {
            SystemCall(3, fd)
        }
    }
}

Function.CheckOrder {
    Body: {
        IfCondition LessEqual(Opt.line_count, 1) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        i = 1
        WhileLoop LessThan(i, Opt.line_count) {
            prev_i = Subtract(i, one)
            prev = LineAt(prev_i)
            cur = LineAt(i)
            d = ComparePtr(prev, cur)
            bad = 0
            IfCondition EqualTo(Opt.unique, 1) ThenBlock: {
                IfCondition GreaterEqual(d, 0) ThenBlock: {
                    bad = 1
                }
            } ElseBlock: {
                IfCondition GreaterThan(d, 0) ThenBlock: {
                    bad = 1
                }
            }
            IfCondition EqualTo(bad, 1) ThenBlock: {
                IfCondition EqualTo(Opt.check, 67) ThenBlock: {
                    Die(1)
                }
                Err("sort: ")
                nm = FileAt(0)
                Err(nm)
                Err(":")
                ln = Add(i, one)
                s = IntToStr(ln)
                Err(s)
                Deallocate(s, 32)
                Err(": disorder: ")
                nb = LineLen(cur)
                IfCondition GreaterThan(nb, 0) ThenBlock: {
                    SystemCall(1, 2, Add(cur, 16), nb)
                }
                SetByte(Ptr.scratch, 0, Opt.eol)
                SystemCall(1, 2, Ptr.scratch, 1)
                Die(1)
            }
            i = Add(i, one)
        }
    }
}

Function.CheckInputs {
    Body: {
        one = 1
        i = 0
        WhileLoop LessThan(i, Opt.nfiles) {
            name = FileAt(i)
            dash = IsDash(name)
            IfCondition EqualTo(dash, 0) ThenBlock: {
                fd = SystemCall(2, name, 0, 0)
                IfCondition LessThan(fd, 0) ThenBlock: {
                    err = Subtract(0, fd)
                    DieMsg("cannot read", name, err)
                }
                SystemCall(3, fd)
            }
            i = Add(i, one)
        }
    }
}

Function.CheckOutput {
    Body: {
        IfCondition EqualTo(Opt.out_set, 0) ThenBlock: {
            ReturnValue(0)
        }
        fd = SystemCall(2, Opt.out_file, 65, 438)
        IfCondition LessThan(fd, 0) ThenBlock: {
            err = Subtract(0, fd)
            DieMsg("open failed", Opt.out_file, err)
        }
        SystemCall(3, fd)
    }
}

Function.TryTemp {
    Body: {
        tl = StringLength(Opt.tmpdir)
        IfCondition GreaterThan(tl, 4000) ThenBlock: {
            Err("sort: cannot create temporary file in '")
            Err(Opt.tmpdir)
            Err("': File name too long\n")
            Die(2)
        }
        at = PutStr(Ptr.progpath, 0, Opt.tmpdir)
        slash = 1
        IfCondition GreaterThan(at, 0) ThenBlock: {
            prev_at = Subtract(at, 1)
            prev = GetByte(Ptr.progpath, prev_at)
            IfCondition EqualTo(prev, 47) ThenBlock: {
                slash = 0
            }
        }
        IfCondition EqualTo(slash, 1) ThenBlock: {
            SetByte(Ptr.progpath, at, 47)
            one = 1
            at = Add(at, one)
        }
        at = PutStr(Ptr.progpath, at, "ailang-sort-")
        pid = SystemCall(39)
        s = IntToStr(pid)
        at = PutStr(Ptr.progpath, at, s)
        Deallocate(s, 32)
        SetByte(Ptr.progpath, at, 0)
        fd = SystemCall(2, Ptr.progpath, 194, 384)
        IfCondition LessThan(fd, 0) ThenBlock: {
            err = Subtract(0, fd)
            msg = GetErrStr(err)
            Err("sort: cannot create temporary file in '")
            Err(Opt.tmpdir)
            Err("': ")
            Err(msg)
            Err("\n")
            Die(2)
        }
        SystemCall(3, fd)
        SystemCall(87, Ptr.progpath)
    }
}

Function.HasSlash {
    Input: name: Address
    Output: Integer
    Body: {
        one = 1
        i = 0
        Work.found = 0
        WhileLoop 1 {
            ch = GetByte(name, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            IfCondition EqualTo(ch, 47) ThenBlock: {
                Work.found = 1
                BreakLoop
            }
            i = Add(i, one)
        }
        ReturnValue(Work.found)
    }
}

Function.BuildCand {
    Input: dir: Address
    Input: start: Integer
    Input: dlen: Integer
    Input: name: Address
    Body: {
        one = 1
        at = 0
        IfCondition EqualTo(dlen, 0) ThenBlock: {
            SetByte(Ptr.progpath, 0, 46)
            SetByte(Ptr.progpath, 1, 47)
            at = 2
        } ElseBlock: {
            i = 0
            WhileLoop LessThan(i, dlen) {
                ch = GetByte(dir, Add(start, i))
                SetByte(Ptr.progpath, i, ch)
                i = Add(i, one)
            }
            SetByte(Ptr.progpath, dlen, 47)
            at = Add(dlen, one)
        }
        at = PutStr(Ptr.progpath, at, name)
        SetByte(Ptr.progpath, at, 0)
    }
}

Function.TryOpen {
    Output: Integer
    Body: {
        fd = SystemCall(2, Ptr.progpath, 0, 0)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(3, fd)
            Work.opened = 1
            ReturnValue(1)
        }
        Work.opened = 0
        ReturnValue(0)
    }
}

Function.FindProg {
    Input: name: Address
    Output: Address
    Body: {
        slash = HasSlash(name)
        IfCondition EqualTo(slash, 1) ThenBlock: {
            at = PutStr(Ptr.progpath, 0, name)
            SetByte(Ptr.progpath, at, 0)
            Work.prog = Ptr.progpath
            ReturnValue(Work.prog)
        }
        IfCondition EqualTo(Ptr.path, 0) ThenBlock: {
            BuildCand("/usr/bin", 0, 8, name)
            hit = TryOpen()
            IfCondition EqualTo(hit, 1) ThenBlock: {
                Work.prog = Ptr.progpath
                ReturnValue(Work.prog)
            }
            BuildCand("/bin", 0, 4, name)
            hit = TryOpen()
            IfCondition EqualTo(hit, 1) ThenBlock: {
                Work.prog = Ptr.progpath
                ReturnValue(Work.prog)
            }
            BuildCand(".", 0, 0, name)
            hit = TryOpen()
            IfCondition EqualTo(hit, 1) ThenBlock: {
                Work.prog = Ptr.progpath
                ReturnValue(Work.prog)
            }
            Work.prog = 0
            ReturnValue(0)
        }
        one = 1
        start = 0
        WhileLoop 1 {
            i = start
            cut = 0
            WhileLoop 1 {
                cut = GetByte(Ptr.path, i)
                IfCondition Or(EqualTo(cut, 0), EqualTo(cut, 58)) ThenBlock: {
                    BreakLoop
                }
                i = Add(i, one)
            }
            dlen = Subtract(i, start)
            BuildCand(Ptr.path, start, dlen, name)
            hit = TryOpen()
            IfCondition EqualTo(hit, 1) ThenBlock: {
                Work.prog = Ptr.progpath
                ReturnValue(Work.prog)
            }
            IfCondition EqualTo(cut, 0) ThenBlock: {
                BreakLoop
            }
            start = Add(i, one)
        }
        Work.prog = 0
        ReturnValue(0)
    }
}

Function.Spawn {
    Input: prog: Address
    Input: arg: Address
    Input: capture: Integer
    Body: {
        StoreValue(Ptr.spawn, prog)
        IfCondition EqualTo(arg, 0) ThenBlock: {
            StoreValue(Add(Ptr.spawn, 8), 0)
        } ElseBlock: {
            StoreValue(Add(Ptr.spawn, 8), arg)
            StoreValue(Add(Ptr.spawn, 16), 0)
        }
        IfCondition NotEqual(capture, 0) ThenBlock: {
            fds = Allocate(32)
            r = SystemCall(22, fds)
            IfCondition NotEqual(r, 0) ThenBlock: {
                Deallocate(fds, 32)
                Err("sort: cannot create pipe\n")
                Die(2)
            }
            ReadI32(fds, 0)
            Work.pipe0 = Work.val
            ReadI32(fds, 4)
            Work.pipe1 = Work.val
            Deallocate(fds, 32)
        }
        Work.nul = SystemCall(2, "/dev/null", 2, 0)
        IfCondition LessThan(Work.nul, 0) ThenBlock: {
            err = Subtract(0, Work.nul)
            DieMsg("open failed", "/dev/null", err)
        }
        pid = SystemCall(57)
        IfCondition EqualTo(pid, 0) ThenBlock: {
            SystemCall(33, Work.nul, 0)
            IfCondition EqualTo(capture, 1) ThenBlock: {
                SystemCall(33, Work.pipe1, 1)
                SystemCall(33, Work.nul, 2)
            }
            IfCondition EqualTo(capture, 2) ThenBlock: {
                SystemCall(33, Work.nul, 1)
                SystemCall(33, Work.pipe1, 2)
            }
            IfCondition EqualTo(capture, 0) ThenBlock: {
                SystemCall(33, Work.nul, 1)
                SystemCall(33, Work.nul, 2)
            }
            SystemCall(3, Work.nul)
            IfCondition NotEqual(capture, 0) ThenBlock: {
                SystemCall(3, Work.pipe0)
                SystemCall(3, Work.pipe1)
            }
            SystemCall(59, prog, Ptr.spawn, Ptr.envp)
            SystemCall(60, 127)
        }
        SystemCall(3, Work.nul)
        IfCondition LessThan(pid, 0) ThenBlock: {
            IfCondition NotEqual(capture, 0) ThenBlock: {
                SystemCall(3, Work.pipe0)
                SystemCall(3, Work.pipe1)
            }
            Err("sort: fork failed\n")
            Die(2)
        }
        IfCondition NotEqual(capture, 0) ThenBlock: {
            SystemCall(3, Work.pipe1)
            Work.abn = 0
            WhileLoop LessThan(Work.abn, 4000) {
                room = Subtract(4000, Work.abn)
                n = SystemCall(0, Work.pipe0, Add(Ptr.carry, Work.abn), room)
                IfCondition LessEqual(n, 0) ThenBlock: {
                    BreakLoop
                }
                Work.abn = Add(Work.abn, n)
            }
            WhileLoop 1 {
                n = SystemCall(0, Work.pipe0, Ptr.rdbuf, 262144)
                IfCondition LessEqual(n, 0) ThenBlock: {
                    BreakLoop
                }
            }
            SystemCall(3, Work.pipe0)
            SetByte(Ptr.carry, Work.abn, 0)
        }
        st = Allocate(32)
        SystemCall(61, pid, st, 0, 0)
        b0 = GetByte(st, 0)
        b1 = GetByte(st, 1)
        Deallocate(st, 32)
        IfCondition EqualTo(b0, 0) ThenBlock: {
            Work.val = b1
        } ElseBlock: {
            Work.val = 127
        }
    }
}

Function.Contains {
    Input: buf: Address
    Input: n: Integer
    Input: needle: Address
    Output: Integer
    Body: {
        sl = StringLength(needle)
        Work.found = 0
        IfCondition EqualTo(sl, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(n, sl) ThenBlock: {
            ReturnValue(0)
        }
        last = Subtract(n, sl)
        one = 1
        i = 0
        WhileLoop LessEqual(i, last) {
            j = 0
            ok = 1
            WhileLoop LessThan(j, sl) {
                ca = GetByte(buf, Add(i, j))
                cb = GetByte(needle, j)
                IfCondition NotEqual(ca, cb) ThenBlock: {
                    ok = 0
                    BreakLoop
                }
                j = Add(j, one)
            }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                Work.found = 1
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(Work.found)
    }
}

Function.ProbeLocale {
    Body: {
        Spawn("/usr/bin/locale", 0, 2)
        Opt.failed_locale = 0
        IfCondition NotEqual(Work.val, 0) ThenBlock: {
            Opt.failed_locale = 1
            ReturnValue(0)
        }
        hit = Contains(Ptr.carry, Work.abn, "Cannot set")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            Opt.failed_locale = 1
        }
    }
}

Function.LoadAbmon {
    Body: {
        Spawn("/usr/bin/locale", "abmon", 1)
        IfCondition EqualTo(Work.val, 0) ThenBlock: {
            MonthLoad(Ptr.carry, Work.abn)
        } ElseBlock: {
            InstallMonths()
        }
    }
}

Function.SeedRandom {
    Body: {
        n = 0
        IfCondition EqualTo(Opt.random_set, 1) ThenBlock: {
            fd = SystemCall(2, Opt.random_src, 0, 0)
            IfCondition LessThan(fd, 0) ThenBlock: {
                err = Subtract(0, fd)
                DieMsg("open failed", Opt.random_src, err)
            }
            n = SystemCall(0, fd, Ptr.numbuf, 4096)
            SystemCall(3, fd)
            IfCondition LessThan(n, 0) ThenBlock: {
                n = 0
            }
        } ElseBlock: {
            n = SystemCall(318, Ptr.numbuf, 8, 0)
            IfCondition LessThan(n, 1) ThenBlock: {
                SystemCall(228, 0, Ptr.numbuf)
                n = 16
            }
        }
        HashBuf(Ptr.numbuf, n)
        h = Opt.hrun
        IfCondition LessThan(h, 0) ThenBlock: {
            h = Add(h, 2147483647)
        }
        IfCondition EqualTo(h, 0) ThenBlock: {
            h = 1
        }
        Opt.seed = h
    }
}

Function.LoadFiles0 {
    Body: {
        IfCondition GreaterThan(Opt.nfiles, 0) ThenBlock: {
            Err("sort: extra operand '")
            nm = FileAt(0)
            Err(nm)
            Err("'\n")
            Err("file operands cannot be combined with --files0-from\n")
            TryHelp()
            Die(2)
        }
        dash = IsDash(Opt.files0_path)
        fd = 0
        IfCondition EqualTo(dash, 0) ThenBlock: {
            fd = SystemCall(2, Opt.files0_path, 0, 0)
            IfCondition LessThan(fd, 0) ThenBlock: {
                err = Subtract(0, fd)
                DieMsg("open failed", Opt.files0_path, err)
            }
        }
        acc = 0
        n = 0
        WhileLoop LessThan(acc, 1048575) {
            room = Subtract(1048575, acc)
            n = SystemCall(0, fd, Add(Ptr.carry, acc), room)
            IfCondition LessEqual(n, 0) ThenBlock: {
                BreakLoop
            }
            acc = Add(acc, n)
        }
        IfCondition NotEqual(fd, 0) ThenBlock: {
            SystemCall(3, fd)
        }
        IfCondition LessEqual(acc, 0) ThenBlock: {
            IfCondition LessThan(n, 0) ThenBlock: {
                err = Subtract(0, n)
                DieMsg("read failed", Opt.files0_path, err)
            }
            Err("sort: no input from '")
            Err(Opt.files0_path)
            Err("'\n")
            Die(2)
        }
        pos = 0
        line = 1
        one = 1
        WhileLoop LessThan(pos, acc) {
            ch = GetByte(Ptr.carry, pos)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                Err("sort: ")
                IfCondition EqualTo(dash, 1) ThenBlock: {
                    Err("-")
                } ElseBlock: {
                    Err(Opt.files0_path)
                }
                Err(":")
                ErrNum(line)
                Err(": invalid zero-length file name\n")
                Die(2)
            }
            start = pos
            WhileLoop LessThan(pos, acc) {
                ch = GetByte(Ptr.carry, pos)
                IfCondition EqualTo(ch, 0) ThenBlock: {
                    BreakLoop
                }
                pos = Add(pos, one)
            }
            len = Subtract(pos, start)
            name = CopyFrom(Ptr.carry, start, len)
            bad = IsDash(name)
            IfCondition EqualTo(bad, 1) ThenBlock: {
                Err("sort: when reading file names from stdin, no file name of '-' allowed\n")
                Die(2)
            }
            AddFile(name)
            IfCondition LessThan(pos, acc) ThenBlock: {
                pos = Add(pos, one)
                IfCondition GreaterEqual(pos, acc) ThenBlock: {
                    BreakLoop
                }
            }
            line = Add(line, one)
        }
    }
}

Function.RunCompress {
    Body: {
        prog = FindProg(Opt.compress_prog)
        IfCondition EqualTo(prog, 0) ThenBlock: {
            Err("sort: couldn't execute compress program: No such file or directory\n")
            Die(2)
        }
        Spawn(prog, 0, 0)
    }
}

Function.RunSort {
    Body: {
        IfCondition EqualTo(Opt.files0, 1) ThenBlock: {
            LoadFiles0()
        }
        InheritKeys()
        CheckCompat()
        Opt.need_m = AnyKey(11)
        Opt.need_r = AnyKey(13)
        IfCondition Or(EqualTo(Opt.debug, 1), EqualTo(Opt.need_m, 1)) ThenBlock: {
            ProbeLocale()
        }
        IfCondition EqualTo(Opt.debug, 1) ThenBlock: {
            bad = 0
            IfCondition NotEqual(Opt.check, 0) ThenBlock: {
                bad = 1
            }
            IfCondition EqualTo(Opt.out_set, 1) ThenBlock: {
                bad = 1
            }
            IfCondition EqualTo(bad, 1) ThenBlock: {
                Err("sort: options '-")
                IfCondition NotEqual(Opt.check, 0) ThenBlock: {
                    ErrChar(Opt.check)
                } ElseBlock: {
                    ErrChar(111)
                }
                Err(" --debug' are incompatible\n")
                Die(2)
            }
            IfCondition EqualTo(Opt.failed_locale, 1) ThenBlock: {
                Err("sort: failed to set locale\n")
            }
            Err("sort: text ordering performed using simple byte comparison\n")
            WarnKeys()
        }
        IfCondition EqualTo(Opt.nfiles, 0) ThenBlock: {
            AddFile("-")
        }
        IfCondition NotEqual(Opt.check, 0) ThenBlock: {
            IfCondition GreaterThan(Opt.nfiles, 1) ThenBlock: {
                Err("sort: extra operand '")
                nm = FileAt(1)
                Err(nm)
                Err("' not allowed with -")
                ErrChar(Opt.check)
                Err("\n")
                Die(2)
            }
            IfCondition EqualTo(Opt.out_set, 1) ThenBlock: {
                Err("sort: options '-")
                ErrChar(Opt.check)
                Err("o' are incompatible\n")
                Die(2)
            }
            ReadAll("open failed")
            CheckOrder()
            Die(0)
        }
        IfCondition EqualTo(Opt.merge, 1) ThenBlock: {
            IfCondition GreaterThan(Opt.nfiles, Opt.batch) ThenBlock: {
                TryTemp()
            }
        }
        IfCondition EqualTo(Opt.need_r, 1) ThenBlock: {
            SeedRandom()
        }
        CheckInputs()
        CheckOutput()
        IfCondition EqualTo(Opt.compress, 1) ThenBlock: {
            IfCondition EqualTo(Opt.sort_set, 1) ThenBlock: {
                IfCondition LessEqual(Opt.sort_size, 1048576) ThenBlock: {
                    RunCompress()
                }
            }
        }
        IfCondition EqualTo(Opt.need_m, 1) ThenBlock: {
            LoadAbmon()
        }
        ReadAll("cannot read")
        IfCondition GreaterThan(Opt.line_count, 1) ThenBlock: {
            MergeSort()
        }
        IfCondition EqualTo(Opt.unique, 1) ThenBlock: {
            UniqueLines()
        }
        WriteAll()
        Die(0)
    }
}
