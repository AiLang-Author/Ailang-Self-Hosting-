// stat.ailang - Display file or filesystem status
// Usage: stat [OPTIONS] FILE...

LibraryImport.Arena

FixedPool.StatConstants {
    "STAT_SIZE": Initialize=144
    "AT_FDCWD": Initialize=-100
    "S_IFMT": Initialize=61440
    "S_IFSOCK": Initialize=49152
    "S_IFLNK": Initialize=40960
    "S_IFREG": Initialize=32768
    "S_IFBLK": Initialize=24576
    "S_IFDIR": Initialize=16384
    "S_IFCHR": Initialize=8192
    "S_IFIFO": Initialize=4096
}

FixedPool.StatConfig {
    "filesystem": Initialize=0
    "dereference": Initialize=0
    "have_format": Initialize=0
    "format": Initialize=0
    "trailing_nl": Initialize=1
    "want_fmt": Initialize=0
    "fail": Initialize=0
    "fmt_left": Initialize=0
    "fmt_zero": Initialize=0
    "fmt_width": Initialize=0
    "fmt_prec": Initialize=-1
    "fmt_mod": Initialize=0
}

FixedPool.StatWork {
    "best": Initialize=-1
}

Function.WriteStdout {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 1, buffer, len)
    }
}

Function.WriteStderr {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 2, buffer, len)
    }
}

Function.GetStringLength {
    Input: str: Address
    Output: Integer
    Body: {
        len = 0
        WhileLoop NotEqual(RDMEM_8(str, len), 0) {
            len = Add(len, 1)
        }
        ReturnValue(len)
    }
}

Function.ConvertNumberToString {
    Input: num: Integer
    Output: Address
    Body: {
        buffer = Allocate(32)
        
        IfCondition EqualTo(num, 0) ThenBlock: {
            WRMEM_8(buffer, 0, 48)
            WRMEM_8(buffer, 1, 0)
            ReturnValue(buffer)
        }
        
        is_neg = 0
        IfCondition LessThan(num, 0) ThenBlock: {
            is_neg = 1
            num = Subtract(0, num)
        }
        
        pos = 0
        temp = Allocate(32)
        
        WhileLoop GreaterThan(num, 0) {
            digit = Modulo(num, 10)
            WRMEM_8(temp, pos, Add(48, digit))
            pos = Add(pos, 1)
            num = Divide(num, 10)
        }
        
        write_pos = 0
        IfCondition NotEqual(is_neg, 0) ThenBlock: {
            WRMEM_8(buffer, 0, 45)
            write_pos = 1
        }
        
        i = Subtract(pos, 1)
        WhileLoop GreaterEqual(i, 0) {
            ch = RDMEM_8(temp, i)
            WRMEM_8(buffer, write_pos, ch)
            write_pos = Add(write_pos, 1)
            i = Subtract(i, 1)
        }
        
        WRMEM_8(buffer, write_pos, 0)
        Deallocate(temp, 32)
        
        ReturnValue(buffer)
    }
}

Function.ConvertOctalToString {
    Input: num: Integer
    Output: Address
    Body: {
        buffer = Allocate(16)
        
        // Convert to 4-digit octal
        WRMEM_8(buffer, 0, 48)  // Leading 0
        
        pos = 4
        temp_num = num
        
        i = 0
        WhileLoop LessThan(i, 3) {
            digit = BitwiseAnd(temp_num, 7)
            WRMEM_8(buffer, pos, Add(48, digit))
            temp_num = RightShift(temp_num, 3)
            pos = Subtract(pos, 1)
            i = Add(i, 1)
        }
        
        WRMEM_8(buffer, 5, 0)
        ReturnValue(buffer)
    }
}

// Get 32-bit value from buffer
Function.GetUInt32 {
    Input: addr: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        ptr = Add(addr, offset)
        
        b0 = RDMEM_8(ptr, 0)
        b1 = RDMEM_8(ptr, 1)
        b2 = RDMEM_8(ptr, 2)
        b3 = RDMEM_8(ptr, 3)
        
        value = Add(b0, Multiply(b1, 256))
        value = Add(value, Multiply(b2, 65536))
        value = Add(value, Multiply(b3, 16777216))
        
        ReturnValue(value)
    }
}

// Get 64-bit value from buffer
Function.GetUInt64 {
    Input: addr: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        ptr = Add(addr, offset)
        
        b0 = RDMEM_8(ptr, 0)
        b1 = RDMEM_8(ptr, 1)
        b2 = RDMEM_8(ptr, 2)
        b3 = RDMEM_8(ptr, 3)
        b4 = RDMEM_8(ptr, 4)
        b5 = RDMEM_8(ptr, 5)
        b6 = RDMEM_8(ptr, 6)
        b7 = RDMEM_8(ptr, 7)
        
        value = Add(b0, Multiply(b1, 256))
        value = Add(value, Multiply(b2, 65536))
        value = Add(value, Multiply(b3, 16777216))
        value = Add(value, Multiply(b4, 4294967296))
        value = Add(value, Multiply(b5, 1099511627776))
        value = Add(value, Multiply(b6, 281474976710656))
        value = Add(value, Multiply(b7, 72057594037927936))
        
        ReturnValue(value)
    }
}

// Get file type string
Function.GetFileTypeString {
    Input: mode: Integer
    Output: Address
    Body: {
        buffer = Allocate(32)
        file_type = BitwiseAnd(mode, StatConstants.S_IFMT)
        
        IfCondition EqualTo(file_type, StatConstants.S_IFREG) ThenBlock: {
            WRMEM_8(buffer, 0, 114)  // r
            WRMEM_8(buffer, 1, 101)  // e
            WRMEM_8(buffer, 2, 103)  // g
            WRMEM_8(buffer, 3, 117)  // u
            WRMEM_8(buffer, 4, 108)  // l
            WRMEM_8(buffer, 5, 97)   // a
            WRMEM_8(buffer, 6, 114)  // r
            WRMEM_8(buffer, 7, 32)   // space
            WRMEM_8(buffer, 8, 102)  // f
            WRMEM_8(buffer, 9, 105)  // i
            WRMEM_8(buffer, 10, 108) // l
            WRMEM_8(buffer, 11, 101) // e
            WRMEM_8(buffer, 12, 0)
            ReturnValue(buffer)
        }
        
        IfCondition EqualTo(file_type, StatConstants.S_IFDIR) ThenBlock: {
            WRMEM_8(buffer, 0, 100)  // d
            WRMEM_8(buffer, 1, 105)  // i
            WRMEM_8(buffer, 2, 114)  // r
            WRMEM_8(buffer, 3, 101)  // e
            WRMEM_8(buffer, 4, 99)   // c
            WRMEM_8(buffer, 5, 116)  // t
            WRMEM_8(buffer, 6, 111)  // o
            WRMEM_8(buffer, 7, 114)  // r
            WRMEM_8(buffer, 8, 121)  // y
            WRMEM_8(buffer, 9, 0)
            ReturnValue(buffer)
        }
        
        IfCondition EqualTo(file_type, StatConstants.S_IFLNK) ThenBlock: {
            WRMEM_8(buffer, 0, 115)  // s
            WRMEM_8(buffer, 1, 121)  // y
            WRMEM_8(buffer, 2, 109)  // m
            WRMEM_8(buffer, 3, 108)  // l
            WRMEM_8(buffer, 4, 105)  // i
            WRMEM_8(buffer, 5, 110)  // n
            WRMEM_8(buffer, 6, 107)  // k
            WRMEM_8(buffer, 7, 0)
            ReturnValue(buffer)
        }
        
        IfCondition EqualTo(file_type, StatConstants.S_IFCHR) ThenBlock: {
            WRMEM_8(buffer, 0, 99)   // c
            WRMEM_8(buffer, 1, 104)  // h
            WRMEM_8(buffer, 2, 97)   // a
            WRMEM_8(buffer, 3, 114)  // r
            WRMEM_8(buffer, 4, 32)   // space
            WRMEM_8(buffer, 5, 100)  // d
            WRMEM_8(buffer, 6, 101)  // e
            WRMEM_8(buffer, 7, 118)  // v
            WRMEM_8(buffer, 8, 0)
            ReturnValue(buffer)
        }
        
        IfCondition EqualTo(file_type, StatConstants.S_IFBLK) ThenBlock: {
            WRMEM_8(buffer, 0, 98)   // b
            WRMEM_8(buffer, 1, 108)  // l
            WRMEM_8(buffer, 2, 111)  // o
            WRMEM_8(buffer, 3, 99)   // c
            WRMEM_8(buffer, 4, 107)  // k
            WRMEM_8(buffer, 5, 32)   // space
            WRMEM_8(buffer, 6, 100)  // d
            WRMEM_8(buffer, 7, 101)  // e
            WRMEM_8(buffer, 8, 118)  // v
            WRMEM_8(buffer, 9, 0)
            ReturnValue(buffer)
        }
        
        WRMEM_8(buffer, 0, 117)  // u
        WRMEM_8(buffer, 1, 110)  // n
        WRMEM_8(buffer, 2, 107)  // k
        WRMEM_8(buffer, 3, 110)  // n
        WRMEM_8(buffer, 4, 111)  // o
        WRMEM_8(buffer, 5, 119)  // w
        WRMEM_8(buffer, 6, 110)  // n
        WRMEM_8(buffer, 7, 0)
        
        ReturnValue(buffer)
    }
}

// Print permission bit
Function.PrintPermBit {
    Input: mode: Integer
    Input: bit: Integer
    Input: letter: Integer
    Body: {
        has_perm = BitwiseAnd(mode, bit)
        
        temp = Allocate(1)
        IfCondition NotEqual(has_perm, 0) ThenBlock: {
            WRMEM_8(temp, 0, letter)
        } ElseBlock: {
            WRMEM_8(temp, 0, 45)
        }
        WriteStdout(temp, 1)
        Deallocate(temp, 1)
    }
}

Function.PrintOne {
    Input: ch: Integer
    Body: {
        temp = Allocate(1)
        WRMEM_8(temp, 0, ch)
        WriteStdout(temp, 1)
        Deallocate(temp, 1)
    }
}

Function.PrintClass {
    Input: mode: Integer
    Input: rbit: Integer
    Input: wbit: Integer
    Input: xbit: Integer
    Input: sbit: Integer
    Input: sch: Integer
    Body: {
        rc = 45
        rset = BitwiseAnd(mode, rbit)
        IfCondition NotEqual(rset, 0) ThenBlock: {
            rc = 114
        }
        PrintOne(rc)
        wc = 45
        wset = BitwiseAnd(mode, wbit)
        IfCondition NotEqual(wset, 0) ThenBlock: {
            wc = 119
        }
        PrintOne(wc)
        hasx = BitwiseAnd(mode, xbit)
        hass = BitwiseAnd(mode, sbit)
        xc = 45
        IfCondition NotEqual(hasx, 0) ThenBlock: {
            xc = 120
        }
        IfCondition NotEqual(hass, 0) ThenBlock: {
            xc = sch
            IfCondition EqualTo(hasx, 0) ThenBlock: {
                xc = Subtract(sch, 32)
            }
        }
        PrintOne(xc)
    }
}

// Print symbolic permissions (10 characters, GNU %A)
Function.PrintSymbolicPermissions {
    Input: mode: Integer
    Body: {
        file_type = BitwiseAnd(mode, StatConstants.S_IFMT)
        tc = 63
        IfCondition EqualTo(file_type, StatConstants.S_IFREG) ThenBlock: { tc = 45 }
        IfCondition EqualTo(file_type, StatConstants.S_IFDIR) ThenBlock: { tc = 100 }
        IfCondition EqualTo(file_type, StatConstants.S_IFLNK) ThenBlock: { tc = 108 }
        IfCondition EqualTo(file_type, StatConstants.S_IFCHR) ThenBlock: { tc = 99 }
        IfCondition EqualTo(file_type, StatConstants.S_IFBLK) ThenBlock: { tc = 98 }
        IfCondition EqualTo(file_type, StatConstants.S_IFIFO) ThenBlock: { tc = 112 }
        IfCondition EqualTo(file_type, StatConstants.S_IFSOCK) ThenBlock: { tc = 115 }
        PrintOne(tc)
        PrintClass(mode, 256, 128, 64, 2048, 115)
        PrintClass(mode, 32, 16, 8, 1024, 115)
        PrintClass(mode, 4, 2, 1, 512, 116)
    }
}

// Print detailed file stats
Function.PrintFileStats {
    Input: path: Address
    Input: statbuf: Address
    Body: {
        // struct stat layout (x86_64):
        // 0: st_dev (8 bytes)
        // 8: st_ino (8 bytes)
        // 16: st_nlink (8 bytes)
        // 24: st_mode (4 bytes)
        // 28: st_uid (4 bytes)
        // 32: st_gid (4 bytes)
        // 40: st_rdev (8 bytes)
        // 48: st_size (8 bytes)
        // 56: st_blksize (8 bytes)
        // 64: st_blocks (8 bytes)
        // 72: st_atime (8 bytes)
        // 88: st_mtime (8 bytes)
        // 104: st_ctime (8 bytes)
        
        st_dev = GetUInt64(statbuf, 0)
        st_ino = GetUInt64(statbuf, 8)
        st_nlink = GetUInt64(statbuf, 16)
        st_mode = GetUInt32(statbuf, 24)
        st_uid = GetUInt32(statbuf, 28)
        st_gid = GetUInt32(statbuf, 32)
        st_size = GetUInt64(statbuf, 48)
        st_blksize = GetUInt64(statbuf, 56)
        st_blocks = GetUInt64(statbuf, 64)
        
        // Print information
        WriteStdout("  File: ", 8)
        WriteStdout(path, GetStringLength(path))
        WriteStdout("\n", 1)
        
        WriteStdout("  Size: ", 8)
        size_str = ConvertNumberToString(st_size)
        WriteStdout(size_str, GetStringLength(size_str))
        Deallocate(size_str, 32)
        
        WriteStdout("\t\tBlocks: ", 10)
        blocks_str = ConvertNumberToString(st_blocks)
        WriteStdout(blocks_str, GetStringLength(blocks_str))
        Deallocate(blocks_str, 32)
        
        WriteStdout(" IO Block: ", 11)
        blksize_str = ConvertNumberToString(st_blksize)
        WriteStdout(blksize_str, GetStringLength(blksize_str))
        Deallocate(blksize_str, 32)
        
        WriteStdout(" ", 1)
        file_type = GetFileTypeString(st_mode)
        WriteStdout(file_type, GetStringLength(file_type))
        Deallocate(file_type, 32)
        WriteStdout("\n", 1)
        
        WriteStdout("Device: ", 8)
        dev_str = ConvertNumberToString(st_dev)
        WriteStdout(dev_str, GetStringLength(dev_str))
        Deallocate(dev_str, 32)
        
        WriteStdout("\tInode: ", 8)
        ino_str = ConvertNumberToString(st_ino)
        WriteStdout(ino_str, GetStringLength(ino_str))
        Deallocate(ino_str, 32)
        
        WriteStdout("  Links: ", 9)
        nlink_str = ConvertNumberToString(st_nlink)
        WriteStdout(nlink_str, GetStringLength(nlink_str))
        Deallocate(nlink_str, 32)
        WriteStdout("\n", 1)
        
        WriteStdout("Access: (", 9)
        perms_str = ConvertOctalToString(BitwiseAnd(st_mode, 511))
        WriteStdout(perms_str, GetStringLength(perms_str))
        Deallocate(perms_str, 16)
        WriteStdout("/", 1)
        PrintSymbolicPermissions(st_mode)
        WriteStdout(")  Uid: (", 9)
        
        uid_str = ConvertNumberToString(st_uid)
        WriteStdout(uid_str, GetStringLength(uid_str))
        Deallocate(uid_str, 32)
        
        WriteStdout(")   Gid: (", 10)
        gid_str = ConvertNumberToString(st_gid)
        WriteStdout(gid_str, GetStringLength(gid_str))
        Deallocate(gid_str, 32)
        WriteStdout(")\n", 2)
    }
}

Function.CopyAt {
    Input: base: Address
    Input: at: Integer
    Output: Address
    Body: {
        n = 0
        WhileLoop NotEqual(RDMEM_8(base, Add(at, n)), 0) {
            n = Add(n, 1)
        }
        buf = Allocate(Add(n, 1))
        i = 0
        WhileLoop LessThan(i, n) {
            WRMEM_8(buf, i, RDMEM_8(base, Add(at, i)))
            i = Add(i, 1)
        }
        WRMEM_8(buf, n, 0)
        ReturnValue(buf)
    }
}

Function.WriteNum {
    Input: num: Integer
    Body: {
        text = ConvertNumberToString(num)
        nlen = GetStringLength(text)
        WriteStdout(text, nlen)
        Deallocate(text, 32)
    }
}

Function.WriteHex {
    Input: num: Integer
    Body: {
        IfCondition EqualTo(num, 0) ThenBlock: {
            WriteStdout("0", 1)
            ReturnValue(0)
        }
        tmp = Allocate(16)
        n = num
        pos = 0
        WhileLoop GreaterThan(n, 0) {
            nib = BitwiseAnd(n, 15)
            ch = Add(48, nib)
            IfCondition GreaterThan(nib, 9) ThenBlock: {
                ch = Add(87, nib)
            }
            WRMEM_8(tmp, pos, ch)
            pos = Add(pos, 1)
            n = RightShift(n, 4)
        }
        one = Allocate(1)
        i = Subtract(pos, 1)
        WhileLoop GreaterEqual(i, 0) {
            WRMEM_8(one, 0, RDMEM_8(tmp, i))
            WriteStdout(one, 1)
            i = Subtract(i, 1)
        }
        Deallocate(one, 1)
        Deallocate(tmp, 16)
    }
}

Function.WritePad {
    Input: num: Integer
    Input: width: Integer
    Body: {
        text = ConvertNumberToString(num)
        nlen = GetStringLength(text)
        pad = Subtract(width, nlen)
        WhileLoop GreaterThan(pad, 0) {
            WriteStdout("0", 1)
            pad = Subtract(pad, 1)
        }
        WriteStdout(text, nlen)
        Deallocate(text, 32)
    }
}

Function.Be32 {
    Input: buf: Address
    Input: off: Integer
    Output: Integer
    Body: {
        b0 = RDMEM_8(buf, off)
        o1 = Add(off, 1)
        b1 = RDMEM_8(buf, o1)
        o2 = Add(off, 2)
        b2 = RDMEM_8(buf, o2)
        o3 = Add(off, 3)
        b3 = RDMEM_8(buf, o3)
        v = Multiply(b0, 16777216)
        v = Add(v, Multiply(b1, 65536))
        v = Add(v, Multiply(b2, 256))
        v = Add(v, b3)
        IfCondition GreaterEqual(v, 2147483648) ThenBlock: {
            v = Subtract(v, 4294967296)
        }
        ReturnValue(v)
    }
}

// Seconds east of UTC for unix_sec, from the v1 TZif data in /etc/localtime.
Function.ZoneOffset {
    Input: unix_sec: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, "/etc/localtime", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf = Allocate(8192)
        nread = SystemCall(0, fd, buf, 8192)
        SystemCall(3, fd)
        IfCondition LessThan(nread, 44) ThenBlock: {
            Deallocate(buf, 8192)
            ReturnValue(0)
        }
        IfCondition NotEqual(RDMEM_8(buf, 0), 84) ThenBlock: {
            Deallocate(buf, 8192)
            ReturnValue(0)
        }
        timecnt = Be32(buf, 32)
        typecnt = Be32(buf, 36)
        IfCondition LessEqual(timecnt, 0) ThenBlock: {
            Deallocate(buf, 8192)
            ReturnValue(0)
        }
        IfCondition LessEqual(typecnt, 0) ThenBlock: {
            Deallocate(buf, 8192)
            ReturnValue(0)
        }
        need = Add(44, Multiply(timecnt, 5))
        need = Add(need, Multiply(typecnt, 6))
        IfCondition GreaterThan(need, nread) ThenBlock: {
            Deallocate(buf, 8192)
            ReturnValue(0)
        }
        StatWork.best = -1
        i = 0
        WhileLoop LessThan(i, timecnt) {
            toff = Add(44, Multiply(i, 4))
            trans = Be32(buf, toff)
            IfCondition LessEqual(trans, unix_sec) ThenBlock: {
                StatWork.best = i
            }
            i = Add(i, 1)
        }
        idxbase = Add(44, Multiply(timecnt, 4))
        ti = 0
        IfCondition GreaterEqual(StatWork.best, 0) ThenBlock: {
            ip = Add(idxbase, StatWork.best)
            ti = RDMEM_8(buf, ip)
        }
        typebase = Add(idxbase, timecnt)
        gmoff = Multiply(ti, 6)
        gmoff = Add(typebase, gmoff)
        gm = Be32(buf, gmoff)
        Deallocate(buf, 8192)
        ReturnValue(gm)
    }
}

Function.PrintTime {
    Input: statbuf: Address
    Body: {
        sec = GetUInt64(statbuf, 88)
        nsec = GetUInt32(statbuf, 96)
        off = ZoneOffset(sec)
        local = Add(sec, off)
        days = Divide(local, 86400)
        rem = Modulo(local, 86400)
        hour = Divide(rem, 3600)
        minleft = Modulo(rem, 3600)
        minute = Divide(minleft, 60)
        second = Modulo(minleft, 60)
        z = Add(days, 719468)
        era = Divide(z, 146097)
        doe = Modulo(z, 146097)
        part = doe
        part = Subtract(part, Divide(doe, 1460))
        part = Add(part, Divide(doe, 36524))
        part = Subtract(part, Divide(doe, 146096))
        yoe = Divide(part, 365)
        year = Add(yoe, Multiply(era, 400))
        doy = Multiply(365, yoe)
        doy = Add(doy, Divide(yoe, 4))
        doy = Subtract(doy, Divide(yoe, 100))
        doy = Subtract(doe, doy)
        mp = Multiply(5, doy)
        mp = Add(mp, 2)
        mp = Divide(mp, 153)
        day = Multiply(153, mp)
        day = Add(day, 2)
        day = Divide(day, 5)
        day = Subtract(doy, day)
        day = Add(day, 1)
        month = Add(mp, 3)
        IfCondition GreaterEqual(mp, 10) ThenBlock: {
            month = Subtract(mp, 9)
        }
        IfCondition LessEqual(month, 2) ThenBlock: {
            year = Add(year, 1)
        }
        WritePad(year, 4)
        WriteStdout("-", 1)
        WritePad(month, 2)
        WriteStdout("-", 1)
        WritePad(day, 2)
        WriteStdout(" ", 1)
        WritePad(hour, 2)
        WriteStdout(":", 1)
        WritePad(minute, 2)
        WriteStdout(":", 1)
        WritePad(second, 2)
        WriteStdout(".", 1)
        WritePad(nsec, 9)
        WriteStdout(" ", 1)
        sign = 43
        absoff = off
        IfCondition LessThan(off, 0) ThenBlock: {
            sign = 45
            absoff = Subtract(0, off)
        }
        PrintOne(sign)
        oh = Divide(absoff, 3600)
        om = Modulo(absoff, 3600)
        om = Divide(om, 60)
        WritePad(oh, 2)
        WritePad(om, 2)
    }
}

Function.PrintTypeName {
    Input: mode: Integer
    Body: {
        file_type = BitwiseAnd(mode, StatConstants.S_IFMT)
        IfCondition EqualTo(file_type, StatConstants.S_IFREG) ThenBlock: {
            WriteStdout("regular file", 12)
            ReturnValue(0)
        }
        IfCondition EqualTo(file_type, StatConstants.S_IFDIR) ThenBlock: {
            WriteStdout("directory", 9)
            ReturnValue(0)
        }
        IfCondition EqualTo(file_type, StatConstants.S_IFLNK) ThenBlock: {
            WriteStdout("symbolic link", 13)
            ReturnValue(0)
        }
        IfCondition EqualTo(file_type, StatConstants.S_IFCHR) ThenBlock: {
            WriteStdout("character special file", 22)
            ReturnValue(0)
        }
        IfCondition EqualTo(file_type, StatConstants.S_IFBLK) ThenBlock: {
            WriteStdout("block special file", 18)
            ReturnValue(0)
        }
        IfCondition EqualTo(file_type, StatConstants.S_IFIFO) ThenBlock: {
            WriteStdout("fifo", 4)
            ReturnValue(0)
        }
        IfCondition EqualTo(file_type, StatConstants.S_IFSOCK) ThenBlock: {
            WriteStdout("socket", 6)
            ReturnValue(0)
        }
        WriteStdout("weird file", 10)
    }
}

Function.PrintSpec {
    Input: statbuf: Address
    Input: spec: Integer
    Body: {
        mode = GetUInt32(statbuf, 24)
        IfCondition EqualTo(spec, 102) ThenBlock: {
            WriteHex(mode)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 65) ThenBlock: {
            PrintSymbolicPermissions(mode)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 121) ThenBlock: {
            PrintTime(statbuf)
            ReturnValue(0)
        }
        ino = GetUInt64(statbuf, 8)
        IfCondition EqualTo(spec, 105) ThenBlock: {
            WriteNum(ino)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 70) ThenBlock: {
            PrintTypeName(mode)
            ReturnValue(0)
        }
        blocks = GetUInt64(statbuf, 64)
        IfCondition EqualTo(spec, 98) ThenBlock: {
            WriteNum(blocks)
            ReturnValue(0)
        }
        // %B is the size of each %b block. Linux always reports 512.
        IfCondition EqualTo(spec, 66) ThenBlock: {
            WriteNum(512)
            ReturnValue(0)
        }
        blksize = GetUInt64(statbuf, 56)
        IfCondition EqualTo(spec, 111) ThenBlock: {
            WriteNum(blksize)
            ReturnValue(0)
        }
        dev = GetUInt64(statbuf, 0)
        IfCondition EqualTo(spec, 100) ThenBlock: {
            WriteNum(dev)
            ReturnValue(0)
        }
        sz = GetUInt64(statbuf, 48)
        IfCondition EqualTo(spec, 115) ThenBlock: {
            WriteNum(sz)
            ReturnValue(0)
        }
        gid = GetUInt32(statbuf, 32)
        IfCondition EqualTo(spec, 103) ThenBlock: {
            WriteNum(gid)
            ReturnValue(0)
        }
        uid = GetUInt32(statbuf, 28)
        IfCondition EqualTo(spec, 117) ThenBlock: {
            WriteNum(uid)
            ReturnValue(0)
        }
        nlink = GetUInt64(statbuf, 16)
        IfCondition EqualTo(spec, 104) ThenBlock: {
            WriteNum(nlink)
            ReturnValue(0)
        }
    }
}

// Long-option name at opt[2..] is a non-empty prefix of word, ended by NUL or '='.
Function.NameMatch {
    Input: opt: Address
    Input: word: Address
    Input: wlen: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, wlen) {
            at = Add(i, 2)
            c = RDMEM_8(opt, at)
            IfCondition EqualTo(c, 61) ThenBlock: {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    ReturnValue(1)
                }
                ReturnValue(0)
            }
            IfCondition EqualTo(c, 0) ThenBlock: {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    ReturnValue(1)
                }
                ReturnValue(0)
            }
            w = RDMEM_8(word, i)
            IfCondition NotEqual(c, w) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        endat = Add(wlen, 2)
        cend = RDMEM_8(opt, endat)
        IfCondition EqualTo(cend, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(cend, 61) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.ValueAfterEq {
    Input: opt: Address
    Output: Address
    Body: {
        i = 2
        WhileLoop NotEqual(RDMEM_8(opt, i), 0) {
            IfCondition EqualTo(RDMEM_8(opt, i), 61) ThenBlock: {
                at = Add(i, 1)
                buf = CopyAt(opt, at)
                ReturnValue(buf)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.TakeFormat {
    Input: opt: Address
    Input: nl: Integer
    Body: {
        StatConfig.trailing_nl = nl
        val = ValueAfterEq(opt)
        IfCondition EqualTo(val, 0) ThenBlock: {
            StatConfig.want_fmt = 1
        } ElseBlock: {
            StatConfig.format = val
            StatConfig.have_format = 1
            StatConfig.want_fmt = 0
        }
    }
}

Function.ParseOption {
    Input: opt: Address
    Body: {
        b1 = RDMEM_8(opt, 1)
        IfCondition EqualTo(b1, 0) ThenBlock: {
            StatConfig.fail = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(b1, 45) ThenBlock: {
            mf = NameMatch(opt, "format", 6)
            mp = NameMatch(opt, "printf", 6)
            md = NameMatch(opt, "dereference", 11)
            ms = NameMatch(opt, "file-system", 11)
            hits = Add(mf, mp)
            hits = Add(hits, md)
            hits = Add(hits, ms)
            IfCondition NotEqual(hits, 1) ThenBlock: {
                WriteStderr("stat: unrecognized option '", 27)
                olen = GetStringLength(opt)
                WriteStderr(opt, olen)
                WriteStderr("'\n", 2)
                StatConfig.fail = 1
                ReturnValue(0)
            }
            IfCondition EqualTo(md, 1) ThenBlock: {
                StatConfig.dereference = 1
                ReturnValue(0)
            }
            IfCondition EqualTo(ms, 1) ThenBlock: {
                StatConfig.filesystem = 1
                ReturnValue(0)
            }
            IfCondition EqualTo(mp, 1) ThenBlock: {
                TakeFormat(opt, 0)
                ReturnValue(0)
            }
            TakeFormat(opt, 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(b1, 76) ThenBlock: {
            StatConfig.dereference = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(b1, 102) ThenBlock: {
            StatConfig.filesystem = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(b1, 99) ThenBlock: {
            StatConfig.trailing_nl = 1
            rest = RDMEM_8(opt, 2)
            IfCondition EqualTo(rest, 0) ThenBlock: {
                StatConfig.want_fmt = 1
            } ElseBlock: {
                StatConfig.format = CopyAt(opt, 2)
                StatConfig.have_format = 1
                StatConfig.want_fmt = 0
            }
            ReturnValue(0)
        }
        WriteStderr("stat: invalid option -- '", 25)
        bad = Allocate(1)
        WRMEM_8(bad, 0, b1)
        WriteStderr(bad, 1)
        Deallocate(bad, 1)
        WriteStderr("'\n", 2)
        StatConfig.fail = 1
    }
}

Function.WriteErrno {
    Input: err: Integer
    Body: {
        abs = err
        IfCondition LessThan(err, 0) ThenBlock: {
            abs = Subtract(0, err)
        }
        IfCondition EqualTo(abs, 2) ThenBlock: {
            WriteStderr("No such file or directory", 25)
            ReturnValue(0)
        }
        IfCondition EqualTo(abs, 13) ThenBlock: {
            WriteStderr("Permission denied", 17)
            ReturnValue(0)
        }
        IfCondition EqualTo(abs, 20) ThenBlock: {
            WriteStderr("Not a directory", 15)
            ReturnValue(0)
        }
        IfCondition EqualTo(abs, 40) ThenBlock: {
            WriteStderr("Too many levels of symbolic links", 33)
            ReturnValue(0)
        }
        IfCondition EqualTo(abs, 1) ThenBlock: {
            WriteStderr("Operation not permitted", 23)
            ReturnValue(0)
        }
        WriteStderr("Unknown error", 13)
    }
}

Function.StartsAt {
    Input: buf: Address
    Input: at: Integer
    Input: lit: Address
    Input: nlen: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, nlen) {
            pos = Add(at, i)
            a = RDMEM_8(buf, pos)
            b = RDMEM_8(lit, i)
            IfCondition NotEqual(a, b) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.HasLocale {
    Output: Integer
    Body: {
        fd = SystemCall(257, -100, "/proc/self/environ", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf = Allocate(8192)
        n = SystemCall(0, fd, buf, 8191)
        SystemCall(3, fd)
        IfCondition LessThan(n, 0) ThenBlock: {
            n = 0
        }
        WRMEM_8(buf, n, 0)
        found = 0
        i = 0
        WhileLoop LessThan(i, n) {
            at_start = 0
            IfCondition EqualTo(i, 0) ThenBlock: {
                at_start = 1
            } ElseBlock: {
                prev = Subtract(i, 1)
                pb = RDMEM_8(buf, prev)
                IfCondition EqualTo(pb, 0) ThenBlock: {
                    at_start = 1
                }
            }
            IfCondition NotEqual(at_start, 0) ThenBlock: {
                ok = StartsAt(buf, i, "QUOTING_STYLE=locale", 20)
                IfCondition NotEqual(ok, 0) ThenBlock: {
                    endp = Add(i, 20)
                    eb = RDMEM_8(buf, endp)
                    IfCondition EqualTo(eb, 0) ThenBlock: {
                        found = 1
                    }
                }
            }
            i = Add(i, 1)
        }
        Deallocate(buf, 8192)
        ReturnValue(found)
    }
}

Function.WriteQuoted {
    Input: s: Address
    Body: {
        n = GetStringLength(s)
        locale = HasLocale()
        IfCondition NotEqual(locale, 0) ThenBlock: {
            PrintOne(39)
            i = 0
            WhileLoop LessThan(i, n) {
                c = RDMEM_8(s, i)
                IfCondition EqualTo(c, 39) ThenBlock: {
                    PrintOne(92)
                }
                IfCondition EqualTo(c, 92) ThenBlock: {
                    PrintOne(92)
                }
                PrintOne(c)
                i = Add(i, 1)
            }
            PrintOne(39)
            ReturnValue(0)
        }
        has_q = 0
        has_dq = 0
        i = 0
        WhileLoop LessThan(i, n) {
            c = RDMEM_8(s, i)
            IfCondition EqualTo(c, 39) ThenBlock: {
                has_q = 1
            }
            IfCondition EqualTo(c, 34) ThenBlock: {
                has_dq = 1
            }
            IfCondition EqualTo(c, 92) ThenBlock: {
                has_dq = 1
            }
            IfCondition EqualTo(c, 36) ThenBlock: {
                has_dq = 1
            }
            IfCondition EqualTo(c, 96) ThenBlock: {
                has_dq = 1
            }
            i = Add(i, 1)
        }
        both = And(NotEqual(has_q, 0), NotEqual(has_dq, 0))
        IfCondition NotEqual(both, 0) ThenBlock: {
            PrintOne(39)
            i = 0
            WhileLoop LessThan(i, n) {
                c = RDMEM_8(s, i)
                IfCondition EqualTo(c, 39) ThenBlock: {
                    PrintOne(39)
                    PrintOne(92)
                    PrintOne(39)
                }
                PrintOne(c)
                i = Add(i, 1)
            }
            PrintOne(39)
            ReturnValue(0)
        }
        IfCondition NotEqual(has_q, 0) ThenBlock: {
            PrintOne(34)
            i = 0
            WhileLoop LessThan(i, n) {
                c = RDMEM_8(s, i)
                PrintOne(c)
                i = Add(i, 1)
            }
            PrintOne(34)
            ReturnValue(0)
        }
        PrintOne(39)
        i = 0
        WhileLoop LessThan(i, n) {
            c = RDMEM_8(s, i)
            PrintOne(c)
            i = Add(i, 1)
        }
        PrintOne(39)
    }
}

Function.MajorOf {
    Input: dev: Integer
    Output: Integer
    Body: {
        lo = BitwiseAnd(dev, 1048320)
        maj = RightShift(lo, 8)
        ReturnValue(maj)
    }
}

Function.MinorOf {
    Input: dev: Integer
    Output: Integer
    Body: {
        lo = BitwiseAnd(dev, 255)
        hi = RightShift(dev, 12)
        hi = BitwiseAnd(hi, 4294967040)
        minor = Add(lo, hi)
        ReturnValue(minor)
    }
}

Function.StatDev {
    Input: path: Address
    Output: Integer
    Body: {
        st = Allocate(144)
        rc = SystemCall(262, -100, path, st, 0)
        dev = -1
        IfCondition GreaterEqual(rc, 0) ThenBlock: {
            dev = GetUInt64(st, 0)
        }
        Deallocate(st, 144)
        ReturnValue(dev)
    }
}

Function.CopyStr {
    Input: dst: Address
    Input: src: Address
    Output: Integer
    Body: {
        n = 0
        WhileLoop NotEqual(RDMEM_8(src, n), 0) {
            WRMEM_8(dst, n, RDMEM_8(src, n))
            n = Add(n, 1)
        }
        WRMEM_8(dst, n, 0)
        ReturnValue(n)
    }
}

Function.WriteMount {
    Input: path: Address
    Body: {
        dev = StatDev(path)
        buf = Allocate(4096)
        par = Allocate(4096)
        p0 = RDMEM_8(path, 0)
        IfCondition EqualTo(p0, 47) ThenBlock: {
            CopyStr(buf, path)
        } ElseBlock: {
            n = SystemCall(79, buf, 4095)
            IfCondition LessThan(n, 0) ThenBlock: {
                WRMEM_8(buf, 0, 47)
                WRMEM_8(buf, 1, 0)
            }
            is_dot = 0
            IfCondition EqualTo(p0, 46) ThenBlock: {
                IfCondition EqualTo(RDMEM_8(path, 1), 0) ThenBlock: {
                    is_dot = 1
                }
            }
            IfCondition EqualTo(is_dot, 0) ThenBlock: {
                IfCondition NotEqual(p0, 0) ThenBlock: {
                    ln = GetStringLength(buf)
                    last = Subtract(ln, 1)
                    IfCondition GreaterEqual(last, 0) ThenBlock: {
                        lb = RDMEM_8(buf, last)
                        IfCondition NotEqual(lb, 47) ThenBlock: {
                            WRMEM_8(buf, ln, 47)
                            ln = Add(ln, 1)
                        }
                    }
                    k = 0
                    WhileLoop NotEqual(RDMEM_8(path, k), 0) {
                        at = Add(ln, k)
                        WRMEM_8(buf, at, RDMEM_8(path, k))
                        k = Add(k, 1)
                    }
                    endp = Add(ln, k)
                    WRMEM_8(buf, endp, 0)
                }
            }
        }
        guard = 0
        WhileLoop LessThan(guard, 40) {
            slen = GetStringLength(buf)
            root = 0
            IfCondition EqualTo(slen, 1) ThenBlock: {
                IfCondition EqualTo(RDMEM_8(buf, 0), 47) ThenBlock: {
                    root = 1
                }
            }
            IfCondition NotEqual(root, 0) ThenBlock: {
                WriteStdout("/", 1)
                BreakLoop
            }
            last = Subtract(slen, 1)
            WhileLoop GreaterThan(last, 0) {
                cb = RDMEM_8(buf, last)
                IfCondition EqualTo(cb, 47) ThenBlock: {
                    BreakLoop
                }
                last = Subtract(last, 1)
            }
            IfCondition EqualTo(last, 0) ThenBlock: {
                WRMEM_8(par, 0, 47)
                WRMEM_8(par, 1, 0)
            } ElseBlock: {
                j = 0
                WhileLoop LessThan(j, last) {
                    WRMEM_8(par, j, RDMEM_8(buf, j))
                    j = Add(j, 1)
                }
                WRMEM_8(par, last, 0)
            }
            pdev = StatDev(par)
            IfCondition NotEqual(pdev, dev) ThenBlock: {
                WriteStdout(buf, slen)
                BreakLoop
            }
            CopyStr(buf, par)
            guard = Add(guard, 1)
        }
        Deallocate(buf, 4096)
        Deallocate(par, 4096)
    }
}

Function.BirthSec {
    Input: path: Address
    Output: Integer
    Body: {
        buf = Allocate(256)
        flags = 256
        IfCondition NotEqual(StatConfig.dereference, 0) ThenBlock: {
            flags = 0
        }
        rc = SystemCall(332, -100, path, flags, 2048, buf)
        sec = 0
        IfCondition GreaterEqual(rc, 0) ThenBlock: {
            mask = GetUInt32(buf, 0)
            bit = BitwiseAnd(mask, 2048)
            IfCondition NotEqual(bit, 0) ThenBlock: {
                sec = GetUInt64(buf, 80)
            }
        }
        Deallocate(buf, 256)
        ReturnValue(sec)
    }
}

Function.BadDirective {
    Input: fmt: Address
    Input: a: Integer
    Input: b: Integer
    Body: {
        n = Subtract(b, a)
        n = Add(n, 1)
        IfCondition GreaterThan(n, 40) ThenBlock: {
            n = 40
        }
        p = Add(fmt, a)
        WriteStderr("stat: '", 7)
        WriteStderr(p, n)
        WriteStderr("': invalid directive\n", 21)
        StatConfig.fail = 1
    }
}

Function.WritePadded {
    Input: text: Address
    Input: len: Integer
    Input: width: Integer
    Input: left: Integer
    Input: zero: Integer
    Body: {
        IfCondition LessEqual(width, len) ThenBlock: {
            WriteStdout(text, len)
            ReturnValue(0)
        }
        pad = Subtract(width, len)
        ch = 32
        IfCondition NotEqual(zero, 0) ThenBlock: {
            IfCondition EqualTo(left, 0) ThenBlock: {
                ch = 48
            }
        }
        IfCondition NotEqual(left, 0) ThenBlock: {
            WriteStdout(text, len)
            i = 0
            WhileLoop LessThan(i, pad) {
                PrintOne(32)
                i = Add(i, 1)
            }
            ReturnValue(0)
        }
        i = 0
        WhileLoop LessThan(i, pad) {
            PrintOne(ch)
            i = Add(i, 1)
        }
        WriteStdout(text, len)
    }
}

Function.WriteEpoch {
    Input: sec: Integer
    Input: nsec: Integer
    Body: {
        text = ConvertNumberToString(sec)
        slen = GetStringLength(text)
        outb = Allocate(96)
        i = 0
        WhileLoop LessThan(i, slen) {
            WRMEM_8(outb, i, RDMEM_8(text, i))
            i = Add(i, 1)
        }
        Deallocate(text, 32)
        prec = StatConfig.fmt_prec
        IfCondition GreaterThan(prec, 0) ThenBlock: {
            WRMEM_8(outb, i, 46)
            i = Add(i, 1)
            use = prec
            IfCondition GreaterThan(use, 9) ThenBlock: {
                use = 9
            }
            extra = Subtract(prec, use)
            div = 1
            k = use
            WhileLoop LessThan(k, 9) {
                div = Multiply(div, 10)
                k = Add(k, 1)
            }
            frac = Divide(nsec, div)
            pos = Subtract(use, 1)
            val = frac
            base = i
            WhileLoop GreaterEqual(pos, 0) {
                digit = Modulo(val, 10)
                at = Add(base, pos)
                WRMEM_8(outb, at, Add(48, digit))
                val = Divide(val, 10)
                pos = Subtract(pos, 1)
            }
            i = Add(i, use)
            e = 0
            WhileLoop LessThan(e, extra) {
                WRMEM_8(outb, i, 48)
                i = Add(i, 1)
                e = Add(e, 1)
            }
        }
        WRMEM_8(outb, i, 0)
        WritePadded(outb, i, StatConfig.fmt_width, StatConfig.fmt_left, StatConfig.fmt_zero)
        Deallocate(outb, 96)
    }
}

Function.EmitLetter {
    Input: statbuf: Address
    Input: path: Address
    Input: spec: Integer
    Body: {
        IfCondition EqualTo(spec, 110) ThenBlock: {
            nlen = GetStringLength(path)
            WriteStdout(path, nlen)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 78) ThenBlock: {
            WriteQuoted(path)
            mode = GetUInt32(statbuf, 24)
            typ = BitwiseAnd(mode, 61440)
            IfCondition EqualTo(typ, 40960) ThenBlock: {
                lbuf = Allocate(4096)
                ln = SystemCall(89, path, lbuf, 4095)
                IfCondition GreaterEqual(ln, 0) ThenBlock: {
                    WRMEM_8(lbuf, ln, 0)
                    WriteStdout(" -> ", 4)
                    WriteQuoted(lbuf)
                }
                Deallocate(lbuf, 4096)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 109) ThenBlock: {
            WriteMount(path)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 88) ThenBlock: {
            sec = GetUInt64(statbuf, 72)
            nsec = GetUInt32(statbuf, 80)
            WriteEpoch(sec, nsec)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 89) ThenBlock: {
            sec = GetUInt64(statbuf, 88)
            nsec = GetUInt32(statbuf, 96)
            WriteEpoch(sec, nsec)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 90) ThenBlock: {
            sec = GetUInt64(statbuf, 104)
            nsec = GetUInt32(statbuf, 112)
            WriteEpoch(sec, nsec)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 87) ThenBlock: {
            sec = BirthSec(path)
            WriteEpoch(sec, 0)
            ReturnValue(0)
        }
        dev = GetUInt64(statbuf, 0)
        rdev = GetUInt64(statbuf, 40)
        IfCondition EqualTo(spec, 100) ThenBlock: {
            val = dev
            IfCondition EqualTo(StatConfig.fmt_mod, 72) ThenBlock: {
                val = MajorOf(dev)
            }
            IfCondition EqualTo(StatConfig.fmt_mod, 76) ThenBlock: {
                val = MinorOf(dev)
            }
            WriteNum(val)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 114) ThenBlock: {
            val = rdev
            IfCondition EqualTo(StatConfig.fmt_mod, 72) ThenBlock: {
                val = MajorOf(rdev)
            }
            IfCondition EqualTo(StatConfig.fmt_mod, 76) ThenBlock: {
                val = MinorOf(rdev)
            }
            WriteNum(val)
            ReturnValue(0)
        }
        IfCondition EqualTo(spec, 82) ThenBlock: {
            WriteHex(rdev)
            ReturnValue(0)
        }
        PrintSpec(statbuf, spec)
    }
}

Function.EmitDirective {
    Input: fmt: Address
    Input: i: Integer
    Input: statbuf: Address
    Input: path: Address
    Output: Integer
    Body: {
        StatConfig.fmt_left = 0
        StatConfig.fmt_zero = 0
        StatConfig.fmt_width = 0
        StatConfig.fmt_prec = -1
        StatConfig.fmt_mod = 0
        start = Subtract(i, 1)
        guard = 0
        WhileLoop LessThan(guard, 64) {
            c = RDMEM_8(fmt, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                any = 0
                IfCondition NotEqual(StatConfig.fmt_left, 0) ThenBlock: { any = 1 }
                IfCondition NotEqual(StatConfig.fmt_zero, 0) ThenBlock: { any = 1 }
                IfCondition GreaterThan(StatConfig.fmt_width, 0) ThenBlock: { any = 1 }
                IfCondition GreaterEqual(StatConfig.fmt_prec, 0) ThenBlock: { any = 1 }
                IfCondition NotEqual(StatConfig.fmt_mod, 0) ThenBlock: { any = 1 }
                IfCondition NotEqual(any, 0) ThenBlock: {
                    endp = Subtract(i, 1)
                    BadDirective(fmt, start, endp)
                    ReturnValue(-1)
                }
                PrintOne(37)
                ReturnValue(i)
            }
            IfCondition EqualTo(c, 45) ThenBlock: {
                StatConfig.fmt_left = 1
                i = Add(i, 1)
                guard = Add(guard, 1)
                ContinueLoop
            }
            zero_ok = And(EqualTo(c, 48), EqualTo(StatConfig.fmt_width, 0))
            zero_ok = And(zero_ok, LessThan(StatConfig.fmt_prec, 0))
            IfCondition NotEqual(zero_ok, 0) ThenBlock: {
                StatConfig.fmt_zero = 1
                i = Add(i, 1)
                guard = Add(guard, 1)
                ContinueLoop
            }
            is_dig = And(GreaterEqual(c, 48), LessEqual(c, 57))
            dig_w = And(is_dig, LessThan(StatConfig.fmt_prec, 0))
            IfCondition NotEqual(dig_w, 0) ThenBlock: {
                d = Subtract(c, 48)
                w = Multiply(StatConfig.fmt_width, 10)
                StatConfig.fmt_width = Add(w, d)
                i = Add(i, 1)
                guard = Add(guard, 1)
                ContinueLoop
            }
            IfCondition EqualTo(c, 46) ThenBlock: {
                i = Add(i, 1)
                c2 = RDMEM_8(fmt, i)
                dig2 = And(GreaterEqual(c2, 48), LessEqual(c2, 57))
                IfCondition NotEqual(dig2, 0) ThenBlock: {
                    StatConfig.fmt_prec = 0
                    WhileLoop LessThan(guard, 64) {
                        c2 = RDMEM_8(fmt, i)
                        dig2 = And(GreaterEqual(c2, 48), LessEqual(c2, 57))
                        IfCondition EqualTo(dig2, 0) ThenBlock: {
                            BreakLoop
                        }
                        d = Subtract(c2, 48)
                        p = Multiply(StatConfig.fmt_prec, 10)
                        StatConfig.fmt_prec = Add(p, d)
                        i = Add(i, 1)
                        guard = Add(guard, 1)
                    }
                } ElseBlock: {
                    StatConfig.fmt_prec = 9
                }
                guard = Add(guard, 1)
                ContinueLoop
            }
            IfCondition EqualTo(c, 72) ThenBlock: {
                StatConfig.fmt_mod = 72
                i = Add(i, 1)
                guard = Add(guard, 1)
                ContinueLoop
            }
            IfCondition EqualTo(c, 76) ThenBlock: {
                StatConfig.fmt_mod = 76
                i = Add(i, 1)
                guard = Add(guard, 1)
                ContinueLoop
            }
            IfCondition EqualTo(c, 73) ThenBlock: {
                i = Add(i, 1)
                guard = Add(guard, 1)
                ContinueLoop
            }
            IfCondition EqualTo(c, 37) ThenBlock: {
                any = 0
                IfCondition NotEqual(StatConfig.fmt_left, 0) ThenBlock: { any = 1 }
                IfCondition NotEqual(StatConfig.fmt_zero, 0) ThenBlock: { any = 1 }
                IfCondition GreaterThan(StatConfig.fmt_width, 0) ThenBlock: { any = 1 }
                IfCondition GreaterEqual(StatConfig.fmt_prec, 0) ThenBlock: { any = 1 }
                IfCondition NotEqual(StatConfig.fmt_mod, 0) ThenBlock: { any = 1 }
                IfCondition NotEqual(any, 0) ThenBlock: {
                    BadDirective(fmt, start, i)
                    ReturnValue(-1)
                }
                PrintOne(37)
                nxt = Add(i, 1)
                ReturnValue(nxt)
            }
            BreakLoop
        }
        EmitLetter(statbuf, path, c)
        nxt = Add(i, 1)
        ReturnValue(nxt)
    }
}

Function.HexVal {
    Input: c: Integer
    Output: Integer
    Body: {
        dig = And(GreaterEqual(c, 48), LessEqual(c, 57))
        IfCondition NotEqual(dig, 0) ThenBlock: {
            d = Subtract(c, 48)
            ReturnValue(d)
        }
        low = And(GreaterEqual(c, 97), LessEqual(c, 102))
        IfCondition NotEqual(low, 0) ThenBlock: {
            d = Subtract(c, 87)
            ReturnValue(d)
        }
        up = And(GreaterEqual(c, 65), LessEqual(c, 70))
        IfCondition NotEqual(up, 0) ThenBlock: {
            d = Subtract(c, 55)
            ReturnValue(d)
        }
        ReturnValue(-1)
    }
}

Function.EmitEscape {
    Input: fmt: Address
    Input: i: Integer
    Output: Integer
    Body: {
        c = RDMEM_8(fmt, i)
        IfCondition EqualTo(c, 0) ThenBlock: {
            WriteStderr("stat: warning: backslash at end of format\n", 42)
            PrintOne(92)
            ReturnValue(i)
        }
        IfCondition EqualTo(c, 97) ThenBlock: { PrintOne(7) }
        IfCondition EqualTo(c, 98) ThenBlock: { PrintOne(8) }
        IfCondition EqualTo(c, 102) ThenBlock: { PrintOne(12) }
        IfCondition EqualTo(c, 110) ThenBlock: { PrintOne(10) }
        IfCondition EqualTo(c, 114) ThenBlock: { PrintOne(13) }
        IfCondition EqualTo(c, 116) ThenBlock: { PrintOne(9) }
        IfCondition EqualTo(c, 118) ThenBlock: { PrintOne(11) }
        IfCondition EqualTo(c, 92) ThenBlock: { PrintOne(92) }
        known = 0
        IfCondition EqualTo(c, 97) ThenBlock: { known = 1 }
        IfCondition EqualTo(c, 98) ThenBlock: { known = 1 }
        IfCondition EqualTo(c, 102) ThenBlock: { known = 1 }
        IfCondition EqualTo(c, 110) ThenBlock: { known = 1 }
        IfCondition EqualTo(c, 114) ThenBlock: { known = 1 }
        IfCondition EqualTo(c, 116) ThenBlock: { known = 1 }
        IfCondition EqualTo(c, 118) ThenBlock: { known = 1 }
        IfCondition EqualTo(c, 92) ThenBlock: { known = 1 }
        IfCondition NotEqual(known, 0) ThenBlock: {
            nxt = Add(i, 1)
            ReturnValue(nxt)
        }
        oct = And(GreaterEqual(c, 48), LessEqual(c, 55))
        IfCondition NotEqual(oct, 0) ThenBlock: {
            val = Subtract(c, 48)
            i = Add(i, 1)
            k = 1
            WhileLoop LessThan(k, 3) {
                c2 = RDMEM_8(fmt, i)
                oct2 = And(GreaterEqual(c2, 48), LessEqual(c2, 55))
                IfCondition EqualTo(oct2, 0) ThenBlock: {
                    BreakLoop
                }
                val = Multiply(val, 8)
                d = Subtract(c2, 48)
                val = Add(val, d)
                i = Add(i, 1)
                k = Add(k, 1)
            }
            PrintOne(val)
            ReturnValue(i)
        }
        IfCondition EqualTo(c, 120) ThenBlock: {
            i = Add(i, 1)
            hb = RDMEM_8(fmt, i)
            h1 = HexVal(hb)
            IfCondition LessThan(h1, 0) ThenBlock: {
                WriteStderr("stat: warning: unrecognized escape '\\x'\n", 40)
                PrintOne(120)
                ReturnValue(i)
            }
            val = h1
            i = Add(i, 1)
            hb = RDMEM_8(fmt, i)
            h2 = HexVal(hb)
            IfCondition GreaterEqual(h2, 0) ThenBlock: {
                val = Multiply(val, 16)
                val = Add(val, h2)
                i = Add(i, 1)
            }
            PrintOne(val)
            ReturnValue(i)
        }
        WriteStderr("stat: warning: unrecognized escape '", 36)
        one = Allocate(1)
        WRMEM_8(one, 0, 92)
        WriteStderr(one, 1)
        WRMEM_8(one, 0, c)
        WriteStderr(one, 1)
        WriteStderr("'\n", 2)
        Deallocate(one, 1)
        PrintOne(c)
        nxt = Add(i, 1)
        ReturnValue(nxt)
    }
}

Function.PrintFormat {
    Input: statbuf: Address
    Input: path: Address
    Body: {
        fmt = StatConfig.format
        i = 0
        WhileLoop NotEqual(RDMEM_8(fmt, i), 0) {
            ch = RDMEM_8(fmt, i)
            IfCondition EqualTo(ch, 37) ThenBlock: {
                ni = Add(i, 1)
                ni = EmitDirective(fmt, ni, statbuf, path)
                IfCondition LessThan(ni, 0) ThenBlock: {
                    ReturnValue(0)
                }
                i = ni
                ContinueLoop
            }
            IfCondition EqualTo(ch, 92) ThenBlock: {
                IfCondition EqualTo(StatConfig.trailing_nl, 0) ThenBlock: {
                    ni = Add(i, 1)
                    ni = EmitEscape(fmt, ni)
                    i = ni
                    ContinueLoop
                }
            }
            PrintOne(ch)
            i = Add(i, 1)
        }
        IfCondition EqualTo(StatConfig.trailing_nl, 1) ThenBlock: {
            WriteStdout("\n", 1)
        }
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        ReturnValue(buffer)
    }
}

SubRoutine.Main {
    args_buffer = GetArgs()
    
    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        WriteStderr("stat: cannot read arguments\n", 28)
        SystemCall(60, 1)
    }
    
    // Skip program name
    pos = 0
    WhileLoop NotEqual(RDMEM_8(args_buffer, pos), 0) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)
    
    // Check if we have any arguments
    first_arg = RDMEM_8(args_buffer, pos)
    IfCondition EqualTo(first_arg, 0) ThenBlock: {
        WriteStderr("stat: missing operand\n", 22)
        WriteStderr("Try 'stat --help' for more information.\n", 41)
        Deallocate(args_buffer, 4096)
        SystemCall(60, 1)
    }
    
    // Parse options and process files
    errors = 0
    files = 0
    
    WhileLoop LessThan(pos, 4096) {
        ch = RDMEM_8(args_buffer, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            BreakLoop
        }

        IfCondition EqualTo(StatConfig.want_fmt, 1) ThenBlock: {
            StatConfig.format = CopyAt(args_buffer, pos)
            StatConfig.have_format = 1
            StatConfig.want_fmt = 0
            WhileLoop NotEqual(RDMEM_8(args_buffer, pos), 0) {
                pos = Add(pos, 1)
            }
            pos = Add(pos, 1)
            ContinueLoop
        }
        
        // A lone "-" is stdin, not an option.
        is_opt = 0
        IfCondition EqualTo(ch, 45) ThenBlock: {
            nxtb = Add(pos, 1)
            nb = RDMEM_8(args_buffer, nxtb)
            IfCondition NotEqual(nb, 0) ThenBlock: {
                is_opt = 1
            }
        }
        IfCondition NotEqual(is_opt, 0) ThenBlock: {
            opt = CopyAt(args_buffer, pos)
            ParseOption(opt)
            Deallocate(opt, 0)
            IfCondition EqualTo(StatConfig.fail, 1) ThenBlock: {
                Deallocate(args_buffer, 4096)
                SystemCall(60, 1)
            }
            
            // Skip to next argument
            WhileLoop NotEqual(RDMEM_8(args_buffer, pos), 0) {
                pos = Add(pos, 1)
            }
            pos = Add(pos, 1)
        } ElseBlock: {
            file_at = pos
            file_path = CopyAt(args_buffer, file_at)
            files = Add(files, 1)

            b0 = RDMEM_8(file_path, 0)
            b1 = RDMEM_8(file_path, 1)
            is_dash = 0
            IfCondition EqualTo(b0, 45) ThenBlock: {
                IfCondition EqualTo(b1, 0) ThenBlock: {
                    is_dash = 1
                }
            }
            skip_stat = 0
            IfCondition NotEqual(is_dash, 0) ThenBlock: {
                IfCondition NotEqual(StatConfig.filesystem, 0) ThenBlock: {
                    WriteStderr("stat: using '-' to denote standard input does not work in file system mode\n", 75)
                    errors = Add(errors, 1)
                    skip_stat = 1
                }
            }

            IfCondition EqualTo(skip_stat, 0) ThenBlock: {
                statbuf = Allocate(StatConstants.STAT_SIZE)
                flags = 0
                IfCondition EqualTo(StatConfig.dereference, 0) ThenBlock: {
                    flags = 256
                }
                slash = 0
                IfCondition EqualTo(is_dash, 0) ThenBlock: {
                    plen = GetStringLength(file_path)
                    IfCondition GreaterThan(plen, 0) ThenBlock: {
                        lastb = Subtract(plen, 1)
                        lb = RDMEM_8(file_path, lastb)
                        IfCondition EqualTo(lb, 47) ThenBlock: {
                            slash = 1
                            flags = 0
                        }
                    }
                    result = SystemCall(262, StatConstants.AT_FDCWD, file_path, statbuf, flags)
                    IfCondition GreaterEqual(result, 0) ThenBlock: {
                        IfCondition NotEqual(slash, 0) ThenBlock: {
                            mode = GetUInt32(statbuf, 24)
                            typ = BitwiseAnd(mode, 61440)
                            IfCondition NotEqual(typ, 16384) ThenBlock: {
                                result = -20
                            }
                        }
                    }
                } ElseBlock: {
                    result = SystemCall(5, 0, statbuf)
                }

                IfCondition LessThan(result, 0) ThenBlock: {
                    WriteStderr("stat: cannot stat '", 19)
                    plen = GetStringLength(file_path)
                    WriteStderr(file_path, plen)
                    WriteStderr("': ", 3)
                    WriteErrno(result)
                    WriteStderr("\n", 1)
                    errors = Add(errors, 1)
                } ElseBlock: {
                    IfCondition EqualTo(StatConfig.have_format, 1) ThenBlock: {
                        PrintFormat(statbuf, file_path)
                        IfCondition NotEqual(StatConfig.fail, 0) ThenBlock: {
                            errors = Add(errors, 1)
                        }
                    } ElseBlock: {
                        PrintFileStats(file_path, statbuf)
                    }
                }
                Deallocate(statbuf, StatConstants.STAT_SIZE)
            }

            Deallocate(file_path, 0)
            
            // Skip to next argument
            WhileLoop NotEqual(RDMEM_8(args_buffer, pos), 0) {
                pos = Add(pos, 1)
            }
            pos = Add(pos, 1)
        }
    }

    IfCondition EqualTo(StatConfig.want_fmt, 1) ThenBlock: {
        WriteStderr("stat: option requires an argument -- 'c'\n", 41)
        Deallocate(args_buffer, 4096)
        SystemCall(60, 1)
    }
    IfCondition EqualTo(files, 0) ThenBlock: {
        WriteStderr("stat: missing operand\n", 22)
        WriteStderr("Try 'stat --help' for more information.\n", 41)
        Deallocate(args_buffer, 4096)
        SystemCall(60, 1)
    }
    
    Deallocate(args_buffer, 4096)
    
    IfCondition GreaterThan(errors, 0) ThenBlock: {
        SystemCall(60, 1)
    }
    
    SystemCall(60, 0)
}

RunTask(Main)