// sync.ailang - sync, fsync, and fdatasync

LibraryImport.Arena

FixedPool.SyncOpt {
    "nread": Initialize=0
    "pos": Initialize=0
    "data": Initialize=0
    "fs": Initialize=0
    "files": Initialize=0
    "bad": Initialize=0
    "opts": Initialize=1
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buffer = Allocate(4096)
        nread = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        IfCondition LessEqual(nread, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        SyncOpt.nread = nread
        ReturnValue(buffer)
    }
}

Function.Starts {
    Input: s: Address
    Input: lit: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 32) {
            b = RDMEM_8(lit, i)
            IfCondition EqualTo(b, 0) ThenBlock: {
                ReturnValue(1)
            }
            a = RDMEM_8(s, i)
            IfCondition NotEqual(a, b) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.SyncOne {
    Input: path: Address
    Body: {
        fd = SystemCall(2, path, 2048, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            rd_err = Subtract(0, fd)
            fd = SystemCall(2, path, 2049, 0)
            IfCondition LessThan(fd, 0) ThenBlock: {
                WriteStderr("sync: error opening '")
                WriteStderr(path)
                IfCondition EqualTo(rd_err, 13) ThenBlock: {
                    WriteStderr("': Permission denied\n")
                } ElseBlock: {
                    IfCondition EqualTo(rd_err, 2) ThenBlock: {
                        WriteStderr("': No such file or directory\n")
                    } ElseBlock: {
                        WriteStderr("': error\n")
                    }
                }
                SyncOpt.bad = 1
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(SyncOpt.fs, 1) ThenBlock: {
            SystemCall(306, fd)
        } ElseBlock: {
            IfCondition EqualTo(SyncOpt.data, 1) ThenBlock: {
                SystemCall(75, fd)
            } ElseBlock: {
                SystemCall(74, fd)
            }
        }
        SystemCall(3, fd)
        ReturnValue(0)
    }
}

SubRoutine.Main {
    args = GetArgs()
    IfCondition EqualTo(args, 0) ThenBlock: {
        SystemCall(162)
        SystemCall(60, 0)
    }
    SyncOpt.pos = 0
    WhileLoop NotEqual(RDMEM_8(args, SyncOpt.pos), 0) {
        SyncOpt.pos = Add(SyncOpt.pos, 1)
    }
    SyncOpt.pos = Add(SyncOpt.pos, 1)
    limit = Subtract(SyncOpt.nread, 1)
    WhileLoop LessThan(SyncOpt.pos, limit) {
        ch = RDMEM_8(args, SyncOpt.pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            SyncOpt.pos = Add(SyncOpt.pos, 1)
        } ElseBlock: {
            arg = Add(args, SyncOpt.pos)
            WhileLoop NotEqual(RDMEM_8(args, SyncOpt.pos), 0) {
                SyncOpt.pos = Add(SyncOpt.pos, 1)
            }
            SyncOpt.pos = Add(SyncOpt.pos, 1)
            take = 1
            IfCondition EqualTo(SyncOpt.opts, 1) ThenBlock: {
                IfCondition EqualTo(RDMEM_8(arg, 0), 45) ThenBlock: {
                    IfCondition EqualTo(RDMEM_8(arg, 1), 0) ThenBlock: {
                        take = 1
                    } ElseBlock: {
                        take = 0
                        IfCondition And(EqualTo(RDMEM_8(arg, 1), 45), EqualTo(RDMEM_8(arg, 2), 0)) ThenBlock: {
                            SyncOpt.opts = 0
                        } ElseBlock: {
                            is_data = Starts(arg, "--data")
                            is_fs = Starts(arg, "--file-system")
                            is_d = 0
                            IfCondition And(EqualTo(RDMEM_8(arg, 1), 100), EqualTo(RDMEM_8(arg, 2), 0)) ThenBlock: {
                                is_d = 1
                            }
                            IfCondition EqualTo(is_data, 1) ThenBlock: {
                                SyncOpt.data = 1
                            }
                            IfCondition EqualTo(is_fs, 1) ThenBlock: {
                                SyncOpt.fs = 1
                            }
                            IfCondition EqualTo(is_d, 1) ThenBlock: {
                                SyncOpt.data = 1
                            }
                            known = 0
                            IfCondition EqualTo(is_data, 1) ThenBlock: {
                                known = 1
                            }
                            IfCondition EqualTo(is_fs, 1) ThenBlock: {
                                known = 1
                            }
                            IfCondition EqualTo(is_d, 1) ThenBlock: {
                                known = 1
                            }
                            IfCondition EqualTo(known, 0) ThenBlock: {
                                SyncOpt.bad = 1
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(take, 1) ThenBlock: {
                SyncOpt.files = Add(SyncOpt.files, 1)
                SyncOpt.opts = 0
                SyncOne(arg)
            }
        }
    }
    IfCondition And(EqualTo(SyncOpt.data, 1), EqualTo(SyncOpt.fs, 1)) ThenBlock: {
        SystemCall(60, 1)
    }
    IfCondition And(EqualTo(SyncOpt.data, 1), EqualTo(SyncOpt.files, 0)) ThenBlock: {
        SystemCall(60, 1)
    }
    IfCondition EqualTo(SyncOpt.files, 0) ThenBlock: {
        IfCondition EqualTo(SyncOpt.bad, 1) ThenBlock: {
            SystemCall(60, 1)
        }
        SystemCall(162)
        SystemCall(60, 0)
    }
    IfCondition EqualTo(SyncOpt.bad, 1) ThenBlock: {
        SystemCall(60, 1)
    }
    Deallocate(args, 4096)
    SystemCall(60, 0)
}

RunTask(Main)
