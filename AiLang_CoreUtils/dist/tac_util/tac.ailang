// tac.ailang - Concatenate and print files line by line, in reverse.
// Usage: tac [FILE]...
//
// Mirror of `cat` with lines output last-to-first. Reads each file into
// memory, records newline positions, then walks them backwards. If the
// file lacks a trailing newline, the trailing partial line is still
// treated as line N (emitted first in reverse order, GNU behaviour).
//
// April 2026 rewrite: the old version double-emitted the file forward
// after reversing (`line_start` was 0 after the loop, so the partial-
// line handler ran across the whole buffer). Also missing Arena import
// and multi-file support.

LibraryImport.Arena

FixedPool.TacConstants {
    "READ_CHUNK": Initialize=65536
    "MAX_FILE":   Initialize=16777216  // 16 MiB per file cap
    "MAX_LINES":  Initialize=1000000
    "MAX_FILES":  Initialize=1000
    "ARGBUF":     Initialize=8192
}

FixedPool.ArgPos { "pos": Initialize=0 }

Function.WriteStdout {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 1, buffer, len)
    }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

// Read all bytes from fd into an Allocate'd buffer. Writes the size
// into the TacReadState pool slot so the caller can retrieve it.
FixedPool.TacReadState { "size": Initialize=0 }

Function.SlurpFd {
    Input: fd: Integer
    Output: Address
    Body: {
        cap = TacConstants.MAX_FILE
        buf = Allocate(cap)
        total = 0
        WhileLoop 1 {
            space = Subtract(cap, total)
            IfCondition LessEqual(space, 0) ThenBlock: { BreakLoop }
            want = TacConstants.READ_CHUNK
            IfCondition LessThan(space, want) ThenBlock: { want = space }
            got = SystemCall(0, fd, Add(buf, total), want)
            IfCondition LessEqual(got, 0) ThenBlock: { BreakLoop }
            total = Add(total, got)
        }
        TacReadState.size = total
        ReturnValue(buf)
    }
}

// Emit the contents of `buf` (length `n`) in reversed line order.
// A "line" is the run of bytes up to and including the next '\n'.
// If the buffer lacks a trailing '\n', the trailing partial line is
// emitted first, with a '\n' appended to match GNU tac's output.
Function.EmitReversed {
    Input: buf: Address
    Input: n: Integer
    Body: {
        IfCondition LessEqual(n, 0) ThenBlock: {
            // nothing to emit
        } ElseBlock: {
            // Record newline positions.
            line_ends = Allocate(Multiply(TacConstants.MAX_LINES, 8))
            line_count = 0
            i = 0
            WhileLoop LessThan(i, n) {
                IfCondition EqualTo(GetByte(buf, i), 10) ThenBlock: {
                    IfCondition LessThan(line_count, TacConstants.MAX_LINES) ThenBlock: {
                        StoreValue(Add(line_ends, Multiply(line_count, 8)), i)
                        line_count = Add(line_count, 1)
                    }
                }
                i = Add(i, 1)
            }

            last_byte = GetByte(buf, Subtract(n, 1))

            IfCondition NotEqual(last_byte, 10) ThenBlock: {
                // Partial trailing line — emit it FIRST without adding a
                // newline. GNU tac treats the trailing bytes as belonging
                // to the final record with no separator, so "x\ny\nz"
                // becomes "zy\nx\n" (the "z" concatenates onto the front
                // of the reversed "y\n"). Do NOT synthesize a \n here.
                IfCondition GreaterThan(line_count, 0) ThenBlock: {
                    tstart = Add(Dereference(Add(line_ends, Multiply(Subtract(line_count, 1), 8))), 1)
                } ElseBlock: {
                    tstart = 0
                }
                tlen = Subtract(n, tstart)
                IfCondition GreaterThan(tlen, 0) ThenBlock: {
                    WriteStdout(Add(buf, tstart), tlen)
                }
            }

            // Walk newlines back-to-front; each entry is a line's final '\n'.
            idx = Subtract(line_count, 1)
            WhileLoop GreaterEqual(idx, 0) {
                end = Dereference(Add(line_ends, Multiply(idx, 8)))
                IfCondition EqualTo(idx, 0) ThenBlock: {
                    start = 0
                } ElseBlock: {
                    start = Add(Dereference(Add(line_ends, Multiply(Subtract(idx, 1), 8))), 1)
                }
                seg_len = Add(Subtract(end, start), 1)
                WriteStdout(Add(buf, start), seg_len)
                idx = Subtract(idx, 1)
            }

            Deallocate(line_ends, Multiply(TacConstants.MAX_LINES, 8))
        }
    }
}

Function.ProcessFd {
    Input: fd: Integer
    Body: {
        buf = SlurpFd(fd)
        n = TacReadState.size
        EmitReversed(buf, n)
        Deallocate(buf, TacConstants.MAX_FILE)
    }
}

// === ARG PARSING ===

Function.LoadCmdline {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(TacConstants.ARGBUF)
        n = SystemCall(0, fd, buf, TacConstants.ARGBUF)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, TacConstants.ARGBUF)
            ReturnValue(0)
        }
        ReturnValue(buf)
    }
}

Function.NextArg {
    Input: buf: Address
    Input: limit: Integer
    Output: Address
    Body: {
        p = ArgPos.pos
        IfCondition GreaterEqual(p, limit) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(buf, p), 0) ThenBlock: { ReturnValue(0) }
        start = p
        WhileLoop And(LessThan(p, limit), NotEqual(GetByte(buf, p), 0)) {
            p = Add(p, 1)
        }
        ArgPos.pos = Add(p, 1)
        ReturnValue(Add(buf, start))
    }
}

SubRoutine.Main {
    buf = LoadCmdline()
    IfCondition EqualTo(buf, 0) ThenBlock: {
        ProcessFd(0)
        SystemCall(60, 0)
    }

    files = Allocate(Multiply(TacConstants.MAX_FILES, 8))
    file_count = 0

    ArgPos.pos = 0
    prog = NextArg(buf, TacConstants.ARGBUF)

    WhileLoop 1 {
        arg = NextArg(buf, TacConstants.ARGBUF)
        IfCondition EqualTo(arg, 0) ThenBlock: { BreakLoop }
        a0 = GetByte(arg, 0)
        a1 = GetByte(arg, 1)
        // Any flags (unsupported) would land here — for now treat
        // everything except lone "-" as a file path and "-" as stdin.
        IfCondition And(EqualTo(a0, 45), NotEqual(a1, 0)) ThenBlock: {
            WriteStderr("tac: unknown option (only file arguments supported)\n")
            SystemCall(60, 1)
        }
        StoreValue(Add(files, Multiply(file_count, 8)), arg)
        file_count = Add(file_count, 1)
    }

    exit_code = 0
    IfCondition EqualTo(file_count, 0) ThenBlock: {
        ProcessFd(0)
    } ElseBlock: {
        i = 0
        WhileLoop LessThan(i, file_count) {
            path = Dereference(Add(files, Multiply(i, 8)))
            IfCondition And(EqualTo(GetByte(path, 0), 45), EqualTo(GetByte(path, 1), 0)) ThenBlock: {
                ProcessFd(0)
            } ElseBlock: {
                fd = SystemCall(2, path, 0, 0)
                IfCondition LessThan(fd, 0) ThenBlock: {
                    WriteStderr("tac: cannot open file\n")
                    exit_code = 1
                } ElseBlock: {
                    ProcessFd(fd)
                    SystemCall(3, fd)
                }
            }
            i = Add(i, 1)
        }
    }

    Deallocate(files, Multiply(TacConstants.MAX_FILES, 8))
    Deallocate(buf, TacConstants.ARGBUF)
    SystemCall(60, exit_code)
}

RunTask(Main)
