// Follow, dump, and diagnostics. Pools stay on tail.ailang. No Main.
LibraryImport.Arena

Function.WriteHeader {
    Input: name: Address
    Body: {
        IfCondition EqualTo(TailConfig.headers, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(TailConfig.first_header, 0) ThenBlock: {
            WriteOut(1, "\n")
        }
        WriteOut(1, "==> ")
        WritePretty(1, name)
        WriteOut(1, " <==\n")
        TailConfig.first_header = 0
    }
}
Function.CopyRest {
    Input: fd: Integer
    Body: {
        buf = Allocate(65536)
        WhileLoop 1 {
            n = SysRead(fd, buf, 65536)
            IfCondition LessEqual(n, 0) ThenBlock: {
                BreakLoop
            }
            wr = SysWrite(1, buf, n)
            IfCondition LessThan(wr, 0) ThenBlock: {
                TailConfig.errors = 1
                TailConfig.stop = 1
                BreakLoop
            }
        }
        Deallocate(buf, 65536)
    }
}
Function.LineStart {
    Input: buf: Address
    Input: total: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(total, 0) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        scan = Subtract(total, 1)
        lastb = RDMEM_8(buf, scan)
        IfCondition EqualTo(lastb, TailConfig.delim) ThenBlock: {
            scan = Subtract(scan, 1)
        }
        lines = 0
        i = scan
        start = 0
        found = 0
        WhileLoop And(GreaterEqual(i, 0), EqualTo(found, 0)) {
            ch = RDMEM_8(buf, i)
            IfCondition EqualTo(ch, TailConfig.delim) ThenBlock: {
                lines = Add(lines, one)
                IfCondition GreaterEqual(lines, TailConfig.count) ThenBlock: {
                    start = Add(i, 1)
                    found = 1
                } ElseBlock: {
                    i = Subtract(i, one)
                }
            } ElseBlock: {
                i = Subtract(i, one)
            }
        }
        IfCondition EqualTo(found, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(start)
    }
}
Function.EmitSpan {
    Input: buf: Address
    Input: total: Integer
    Body: {
        start = 0
        IfCondition EqualTo(TailConfig.from_start, 1) ThenBlock: {
            IfCondition EqualTo(TailConfig.use_bytes, 1) ThenBlock: {
                start = TailConfig.count
                IfCondition GreaterThan(start, total) ThenBlock: {
                    start = total
                }
            } ElseBlock: {
                need = TailConfig.count
                i = 0
                one = 1
                WhileLoop And(LessThan(i, total), GreaterThan(need, 0)) {
                    IfCondition EqualTo(RDMEM_8(buf, i), TailConfig.delim) ThenBlock: {
                        need = Subtract(need, one)
                    }
                    i = Add(i, one)
                }
                IfCondition EqualTo(need, 0) ThenBlock: {
                    start = i
                } ElseBlock: {
                    start = total
                }
            }
        } ElseBlock: {
            IfCondition EqualTo(TailConfig.use_bytes, 1) ThenBlock: {
                IfCondition EqualTo(TailConfig.count, 0) ThenBlock: {
                    start = total
                } ElseBlock: {
                    IfCondition GreaterThan(total, TailConfig.count) ThenBlock: {
                        start = Subtract(total, TailConfig.count)
                    }
                }
            } ElseBlock: {
                IfCondition EqualTo(TailConfig.count, 0) ThenBlock: {
                    start = total
                } ElseBlock: {
                    start = LineStart(buf, total)
                }
            }
        }
        left = Subtract(total, start)
        IfCondition GreaterThan(left, 0) ThenBlock: {
            wr = SysWrite(1, Add(buf, start), left)
            IfCondition LessThan(wr, 0) ThenBlock: {
                TailConfig.errors = 1
                TailConfig.stop = 1
            }
        }
    }
}
Function.Slurp {
    Input: fd: Integer
    Output: Integer
    Body: {
        cap = 262144
        buf = Allocate(cap)
        total = 0
        WhileLoop 1 {
            space = Subtract(cap, total)
            IfCondition LessEqual(space, 0) ThenBlock: {
                BreakLoop
            }
            chunk = 65536
            IfCondition GreaterThan(chunk, space) ThenBlock: {
                chunk = space
            }
            n = SysRead(fd, Add(buf, total), chunk)
            IfCondition LessEqual(n, 0) ThenBlock: {
                BreakLoop
            }
            total = Add(total, n)
        }
        EmitSpan(buf, total)
        Deallocate(buf, cap)
        ReturnValue(total)
    }
}
Function.DumpFd {
    Input: fd: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(TailConfig.presume, 1) ThenBlock: {
            Slurp(fd)
            ReturnValue(-1)
        }
        curp = SystemCall(8, fd, 0, 1)
        IfCondition LessThan(curp, 0) ThenBlock: {
            Slurp(fd)
            ReturnValue(-1)
        }
        endp = SystemCall(8, fd, 0, 2)
        IfCondition LessThan(endp, 0) ThenBlock: {
            SystemCall(8, fd, curp, 0)
            Slurp(fd)
            ReturnValue(-1)
        }
        IfCondition EqualTo(endp, 0) ThenBlock: {
            SystemCall(8, fd, 0, 0)
            Slurp(fd)
            ReturnValue(0)
        }
        IfCondition EqualTo(TailConfig.from_start, 0) ThenBlock: {
            IfCondition EqualTo(TailConfig.use_bytes, 1) ThenBlock: {
                st = Allocate(144)
                sr = SystemCall(5, fd, st)
                blk = 0
                IfCondition GreaterEqual(sr, 0) ThenBlock: {
                    blk = RDMEM_64(st, 56)
                }
                Deallocate(st, 144)
                IfCondition GreaterThan(blk, 0) ThenBlock: {
                    IfCondition LessEqual(endp, blk) ThenBlock: {
                        SystemCall(8, fd, curp, 0)
                        got = Slurp(fd)
                        ReturnValue(got)
                    }
                }
            }
        }
        IfCondition EqualTo(TailConfig.from_start, 1) ThenBlock: {
            IfCondition EqualTo(TailConfig.use_bytes, 1) ThenBlock: {
                start = Add(curp, TailConfig.count)
                IfCondition GreaterThan(start, endp) ThenBlock: {
                    start = endp
                }
                SystemCall(8, fd, start, 0)
                CopyRest(fd)
            } ElseBlock: {
                SystemCall(8, fd, curp, 0)
                need = TailConfig.count
                buf = Allocate(65536)
                one = 1
                WhileLoop GreaterThan(need, 0) {
                    n = SysRead(fd, buf, 65536)
                    IfCondition LessEqual(n, 0) ThenBlock: {
                        need = 0
                    } ElseBlock: {
                        i = 0
                        cut = -1
                        WhileLoop And(LessThan(i, n), GreaterThan(need, 0)) {
                            IfCondition EqualTo(RDMEM_8(buf, i), TailConfig.delim) ThenBlock: {
                                need = Subtract(need, one)
                                IfCondition EqualTo(need, 0) ThenBlock: {
                                    cut = Add(i, 1)
                                }
                            }
                            i = Add(i, one)
                        }
                        IfCondition GreaterEqual(cut, 0) ThenBlock: {
                            IfCondition LessThan(cut, n) ThenBlock: {
                                wr = SysWrite(1, Add(buf, cut), Subtract(n, cut))
                                IfCondition LessThan(wr, 0) ThenBlock: {
                                    TailConfig.errors = 1
                                    TailConfig.stop = 1
                                }
                            }
                        }
                    }
                }
                Deallocate(buf, 65536)
                CopyRest(fd)
            }
            ReturnValue(endp)
        }
        IfCondition EqualTo(TailConfig.use_bytes, 1) ThenBlock: {
            IfCondition EqualTo(TailConfig.count, 0) ThenBlock: {
                SystemCall(8, fd, endp, 0)
                ReturnValue(endp)
            }
            start = Subtract(endp, TailConfig.count)
            IfCondition LessThan(start, curp) ThenBlock: {
                start = curp
            }
            SystemCall(8, fd, start, 0)
            CopyRest(fd)
            ReturnValue(endp)
        }
        IfCondition EqualTo(TailConfig.count, 0) ThenBlock: {
            SystemCall(8, fd, endp, 0)
            ReturnValue(endp)
        }
        span = Subtract(endp, curp)
        IfCondition EqualTo(span, 0) ThenBlock: {
            ReturnValue(endp)
        }
        take = span
        IfCondition GreaterThan(take, 262144) ThenBlock: {
            take = 262144
        }
        buf = Allocate(take)
        SystemCall(8, fd, Subtract(endp, take), 0)
        got = SysRead(fd, buf, take)
        IfCondition LessThan(got, 0) ThenBlock: {
            got = 0
        }
        EmitSpan(buf, got)
        Deallocate(buf, take)
        SystemCall(8, fd, endp, 0)
        ReturnValue(endp)
    }
}
Function.KindOf {
    Input: st: Address
    Output: Integer
    Body: {
        raw = RDMEM_64(st, 24)
        mode = BitwiseAnd(raw, 65535)
        ReturnValue(BitwiseAnd(mode, 61440))
    }
}
Function.SetNonblock {
    Input: fd: Integer
    Body: {
        fl = SystemCall(72, fd, 3, 0)
        IfCondition GreaterEqual(fl, 0) ThenBlock: {
            nf = BitwiseOr(fl, 2048)
            SystemCall(72, fd, 4, nf)
        }
    }
}
Function.IsTty {
    Input: fd: Integer
    Output: Integer
    Body: {
        buf = Allocate(72)
        rc = SystemCall(16, fd, 21505, buf)
        Deallocate(buf, 72)
        IfCondition GreaterEqual(rc, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.CloseIf {
    Input: fd: Integer
    Input: flags: Integer
    Body: {
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        std = BitwiseAnd(flags, 4)
        IfCondition NotEqual(std, 0) ThenBlock: {
            ReturnValue(0)
        }
        SystemCall(3, fd)
    }
}
Function.SayRead {
    Input: name: Address
    Input: err: Integer
    Body: {
        msg = ErrText(err)
        WriteOut(2, "tail: error reading ")
        WriteQName(name)
        WriteOut(2, ": ")
        WriteOut(2, msg)
        WriteOut(2, "\n")
    }
}
Function.SayFollowType {
    Input: name: Address
    Input: give: Integer
    Body: {
        WriteOut(2, "tail: ")
        WritePretty(2, name)
        WriteOut(2, ": cannot follow end of this type of file")
        IfCondition EqualTo(give, 1) ThenBlock: {
            WriteOut(2, "; giving up on this name")
        }
        WriteOut(2, "\n")
    }
}
Function.OpenOne {
    Input: idx: Integer
    Input: name: Address
    Body: {
        slot = SlotAt(idx)
        SetF(slot, 0, name)
        SetF(slot, 8, -1)
        SetF(slot, 16, 0)
        SetF(slot, 24, 0)
        SetF(slot, 32, 0)
        SetF(slot, 40, 0)
        SetF(slot, 48, 0)
        SetF(slot, 56, 0)
        SetF(slot, 64, 0)
        dash = And(EqualTo(RDMEM_8(name, 0), 45), EqualTo(RDMEM_8(name, 1), 0))
        flags = 0
        fd = -1
        IfCondition EqualTo(dash, 1) ThenBlock: {
            TailConfig.read_stdin = 1
            flags = 4
            fd = 0
            SetF(slot, 56, flags)
            st = Allocate(144)
            sr = SystemCall(5, fd, st)
            IfCondition LessThan(sr, 0) ThenBlock: {
                err = AbsErr(sr)
                Deallocate(st, 144)
                WriteOut(2, "tail: cannot fstat ")
                WriteQName(name)
                WriteOut(2, ": ")
                msg = ErrText(err)
                WriteOut(2, msg)
                WriteOut(2, "\n")
                TailConfig.errors = 1
                IfCondition GreaterThan(TailConfig.follow, 0) ThenBlock: {
                    SayRead(name, err)
                    ign = 2
                    IfCondition EqualTo(TailConfig.retry, 1) ThenBlock: {
                        ign = 0
                    }
                    SetF(slot, 56, BitwiseOr(flags, ign))
                    SetF(slot, 48, err)
                } ElseBlock: {
                    SetF(slot, 56, BitwiseOr(flags, 2))
                }
                ReturnValue(0)
            }
            kind = KindOf(st)
            dev = RDMEM_64(st)
            ino = RDMEM_64(st, 8)
            Deallocate(st, 144)
        } ElseBlock: {
            fd = SysOpen(name, 0)
            IfCondition LessThan(fd, 0) ThenBlock: {
                err = AbsErr(fd)
                WriteOut(2, "tail: cannot open ")
                WriteQName(name)
                WriteOut(2, " for reading: ")
                msg = ErrText(err)
                WriteOut(2, msg)
                WriteOut(2, "\n")
                TailConfig.errors = 1
                ign = 2
                IfCondition And(GreaterThan(TailConfig.follow, 0), EqualTo(TailConfig.retry, 1)) ThenBlock: {
                    ign = 0
                }
                SetF(slot, 48, err)
                SetF(slot, 56, ign)
                ReturnValue(0)
            }
            st = Allocate(144)
            sr = SystemCall(5, fd, st)
            kind = 0
            dev = 0
            ino = 0
            IfCondition GreaterEqual(sr, 0) ThenBlock: {
                kind = KindOf(st)
                dev = RDMEM_64(st)
                ino = RDMEM_64(st, 8)
            }
            Deallocate(st, 144)
        }
        tailable = 0
        IfCondition EqualTo(kind, 32768) ThenBlock: { tailable = 1 }
        IfCondition EqualTo(kind, 4096) ThenBlock: { tailable = 1 }
        IfCondition EqualTo(kind, 8192) ThenBlock: { tailable = 1 }
        IfCondition EqualTo(kind, 49152) ThenBlock: { tailable = 1 }
        IfCondition EqualTo(tailable, 0) ThenBlock: {
            IfCondition EqualTo(kind, 16384) ThenBlock: {
                SayRead(name, 21)
            }
            IfCondition GreaterThan(TailConfig.follow, 0) ThenBlock: {
                give = 1
                IfCondition And(EqualTo(TailConfig.follow, 2), EqualTo(TailConfig.retry, 1)) ThenBlock: {
                    give = 0
                }
                SayFollowType(name, give)
                ign = 2
                IfCondition EqualTo(give, 0) ThenBlock: {
                    ign = 0
                }
                SetF(slot, 56, BitwiseOr(flags, ign))
            }
            TailConfig.errors = 1
            CloseIf(fd, flags)
            SetF(slot, 48, -1)
            SetF(slot, 8, -1)
            ReturnValue(0)
        }
        pipe_in = 0
        IfCondition EqualTo(kind, 4096) ThenBlock: {
            IfCondition EqualTo(dash, 1) ThenBlock: {
                pipe_in = 1
            }
        }
        IfCondition NotEqual(kind, 32768) ThenBlock: {
            flags = BitwiseOr(flags, 8)
        }
        WriteHeader(name)
        pos = DumpFd(fd)
        IfCondition LessThan(pos, 0) ThenBlock: {
            pos = 0
        }
        IfCondition EqualTo(pipe_in, 1) ThenBlock: {
            IfCondition GreaterThan(TailConfig.follow, 0) ThenBlock: {
                flags = BitwiseOr(flags, 2)
                flags = BitwiseOr(flags, 16)
                fd = -1
            }
        }
        flags = BitwiseOr(flags, 1)
        IfCondition GreaterThan(TailConfig.follow, 0) ThenBlock: {
            IfCondition GreaterEqual(fd, 0) ThenBlock: {
                SetNonblock(fd)
            }
        }
        SetF(slot, 8, fd)
        SetF(slot, 16, dev)
        SetF(slot, 24, ino)
        SetF(slot, 32, pos)
        SetF(slot, 40, kind)
        SetF(slot, 48, 0)
        SetF(slot, 56, flags)
        IfCondition EqualTo(TailConfig.follow, 0) ThenBlock: {
            CloseIf(fd, flags)
            SetF(slot, 8, -1)
        }
    }
}
Function.ReadAllNew {
    Input: fd: Integer
    Input: name: Address
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(idx, TailConfig.last_idx) ThenBlock: {
            WriteHeader(name)
            TailConfig.last_idx = idx
        }
        st = Allocate(144)
        sr = SystemCall(5, fd, st)
        sz = 0
        IfCondition GreaterEqual(sr, 0) ThenBlock: {
            sz = RDMEM_64(st, 48)
        }
        Deallocate(st, 144)
        SystemCall(8, fd, 0, 0)
        IfCondition GreaterThan(sz, 0) ThenBlock: {
            left = sz
            buf = Allocate(65536)
            WhileLoop GreaterThan(left, 0) {
                want = 65536
                IfCondition GreaterThan(want, left) ThenBlock: {
                    want = left
                }
                n = SysRead(fd, buf, want)
                IfCondition LessEqual(n, 0) ThenBlock: {
                    left = 0
                } ElseBlock: {
                    wr = SysWrite(1, buf, n)
                    left = Subtract(left, n)
                    IfCondition LessThan(wr, 0) ThenBlock: {
                        TailConfig.errors = 1
                        TailConfig.stop = 1
                        left = 0
                    }
                }
            }
            Deallocate(buf, 65536)
        } ElseBlock: {
            CopyRest(fd)
        }
        ReturnValue(sz)
    }
}
Function.NoteGone {
    Input: slot: Address
    Input: name: Address
    Input: err: Integer
    Body: {
        flags = GetF(slot, 56)
        fd = GetF(slot, 8)
        prev = GetF(slot, 48)
        opened = BitwiseAnd(flags, 1)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            CloseIf(fd, flags)
            SetF(slot, 8, -1)
        }
        IfCondition NotEqual(prev, err) ThenBlock: {
            IfCondition NotEqual(opened, 0) ThenBlock: {
                IfCondition EqualTo(TailConfig.retry, 1) ThenBlock: {
                    msg = ErrText(err)
                    WriteOut(2, "tail: ")
                    WriteQName(name)
                    WriteOut(2, " has become inaccessible: ")
                    WriteOut(2, msg)
                    WriteOut(2, "\n")
                } ElseBlock: {
                    msg = ErrText(err)
                    WriteOut(2, "tail: ")
                    WritePretty(2, name)
                    WriteOut(2, ": ")
                    WriteOut(2, msg)
                    WriteOut(2, "\n")
                }
            }
        }
        SetF(slot, 48, err)
        IfCondition EqualTo(TailConfig.follow, 1) ThenBlock: {
            IfCondition EqualTo(TailConfig.retry, 0) ThenBlock: {
                nf = BitwiseOr(flags, 2)
                SetF(slot, 56, nf)
            }
        }
    }
}
Function.Recheck {
    Input: idx: Integer
    Output: Integer
    Body: {
        slot = SlotAt(idx)
        name = GetF(slot, 0)
        flags = GetF(slot, 56)
        IfCondition NotEqual(BitwiseAnd(flags, 2), 0) ThenBlock: {
            ReturnValue(0)
        }
        fd = SysOpen(name, 2048)
        IfCondition LessThan(fd, 0) ThenBlock: {
            err = AbsErr(fd)
            NoteGone(slot, name, err)
            ReturnValue(0)
        }
        st = Allocate(144)
        sr = SystemCall(5, fd, st)
        kind = 0
        dev = 0
        ino = 0
        sz = 0
        IfCondition GreaterEqual(sr, 0) ThenBlock: {
            kind = KindOf(st)
            dev = RDMEM_64(st)
            ino = RDMEM_64(st, 8)
            sz = RDMEM_64(st, 48)
        }
        Deallocate(st, 144)
        okkind = 0
        IfCondition EqualTo(kind, 32768) ThenBlock: { okkind = 1 }
        IfCondition EqualTo(kind, 4096) ThenBlock: { okkind = 1 }
        IfCondition EqualTo(kind, 8192) ThenBlock: { okkind = 1 }
        IfCondition EqualTo(kind, 49152) ThenBlock: { okkind = 1 }
        IfCondition EqualTo(okkind, 0) ThenBlock: {
            give = 1
            IfCondition And(EqualTo(TailConfig.follow, 2), EqualTo(TailConfig.retry, 1)) ThenBlock: {
                give = 0
            }
            prev = GetF(slot, 48)
            opened = BitwiseAnd(flags, 1)
            show = 0
            IfCondition NotEqual(opened, 0) ThenBlock: {
                show = 1
            }
            IfCondition NotEqual(prev, -1) ThenBlock: {
                show = 1
            }
            IfCondition EqualTo(show, 1) ThenBlock: {
                WriteOut(2, "tail: ")
                WriteQName(name)
                WriteOut(2, " has been replaced with an untailable file")
                IfCondition EqualTo(give, 1) ThenBlock: {
                    WriteOut(2, "; giving up on this name")
                }
                WriteOut(2, "\n")
            }
            SystemCall(3, fd)
            old = GetF(slot, 8)
            CloseIf(old, flags)
            SetF(slot, 8, -1)
            SetF(slot, 48, -1)
            nf = BitwiseAnd(flags, 65534)
            IfCondition EqualTo(give, 1) ThenBlock: {
                nf = BitwiseOr(nf, 2)
            }
            SetF(slot, 56, nf)
            TailConfig.errors = 1
            ReturnValue(0)
        }
        oldfd = GetF(slot, 8)
        olddev = GetF(slot, 16)
        oldino = GetF(slot, 24)
        prev = GetF(slot, 48)
        fresh = 0
        IfCondition LessThan(oldfd, 0) ThenBlock: {
            fresh = 1
        } ElseBlock: {
            same = And(EqualTo(dev, olddev), EqualTo(ino, oldino))
            IfCondition EqualTo(same, 0) ThenBlock: {
                fresh = 2
            }
        }
        IfCondition EqualTo(fresh, 0) ThenBlock: {
            SystemCall(3, fd)
            SetF(slot, 64, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(fresh, 1) ThenBlock: {
            WriteOut(2, "tail: ")
            WriteQName(name)
            IfCondition And(NotEqual(prev, 0), NotEqual(prev, 2)) ThenBlock: {
                WriteOut(2, " has become accessible\n")
            } ElseBlock: {
                WriteOut(2, " has appeared;  following new file\n")
            }
        } ElseBlock: {
            WriteOut(2, "tail: ")
            WriteQName(name)
            WriteOut(2, " has been replaced;  following new file\n")
            CloseIf(oldfd, flags)
        }
        wrote = ReadAllNew(fd, name, idx)
        SetF(slot, 8, fd)
        SetF(slot, 16, dev)
        SetF(slot, 24, ino)
        SetF(slot, 32, wrote)
        SetF(slot, 40, kind)
        SetF(slot, 48, 0)
        SetF(slot, 64, 0)
        nf = 1
        IfCondition NotEqual(BitwiseAnd(flags, 4), 0) ThenBlock: {
            nf = BitwiseOr(nf, 4)
        }
        IfCondition NotEqual(kind, 32768) ThenBlock: {
            nf = BitwiseOr(nf, 8)
        }
        SetF(slot, 56, nf)
        IfCondition GreaterThan(wrote, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.ReadGrow {
    Input: idx: Integer
    Output: Integer
    Body: {
        slot = SlotAt(idx)
        name = GetF(slot, 0)
        fd = GetF(slot, 8)
        flags = GetF(slot, 56)
        IfCondition NotEqual(BitwiseAnd(flags, 8), 0) ThenBlock: {
            buf = Allocate(65536)
            n = SysRead(fd, buf, 65536)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                IfCondition NotEqual(idx, TailConfig.last_idx) ThenBlock: {
                    WriteHeader(name)
                    TailConfig.last_idx = idx
                }
                wr = SysWrite(1, buf, n)
                Deallocate(buf, 65536)
                IfCondition LessThan(wr, 0) ThenBlock: {
                    TailConfig.errors = 1
                    TailConfig.stop = 1
                }
                ReturnValue(1)
            }
            Deallocate(buf, 65536)
            ReturnValue(0)
        }
        st = Allocate(144)
        sr = SystemCall(5, fd, st)
        IfCondition LessThan(sr, 0) ThenBlock: {
            Deallocate(st, 144)
            err = AbsErr(sr)
            NoteGone(slot, name, err)
            ReturnValue(0)
        }
        sz = RDMEM_64(st, 48)
        Deallocate(st, 144)
        pos = GetF(slot, 32)
        IfCondition LessThan(sz, pos) ThenBlock: {
            WriteOut(2, "tail: ")
            WritePretty(2, name)
            WriteOut(2, ": file truncated\n")
            SystemCall(8, fd, 0, 0)
            pos = 0
            SetF(slot, 32, 0)
        }
        IfCondition GreaterThan(sz, pos) ThenBlock: {
            IfCondition NotEqual(idx, TailConfig.last_idx) ThenBlock: {
                WriteHeader(name)
                TailConfig.last_idx = idx
            }
            SystemCall(8, fd, pos, 0)
            left = Subtract(sz, pos)
            buf = Allocate(65536)
            WhileLoop GreaterThan(left, 0) {
                want = 65536
                IfCondition GreaterThan(want, left) ThenBlock: {
                    want = left
                }
                n = SysRead(fd, buf, want)
                IfCondition LessEqual(n, 0) ThenBlock: {
                    left = 0
                } ElseBlock: {
                    wr = SysWrite(1, buf, n)
                    left = Subtract(left, n)
                    IfCondition LessThan(wr, 0) ThenBlock: {
                        TailConfig.errors = 1
                        TailConfig.stop = 1
                        left = 0
                    }
                }
            }
            Deallocate(buf, 65536)
            SetF(slot, 32, sz)
            SetF(slot, 64, 0)
            ReturnValue(1)
        }
        one = 1
        unc = GetF(slot, 64)
        do_re = 0
        IfCondition GreaterEqual(unc, TailConfig.max_same) ThenBlock: {
            do_re = 1
        }
        unc = Add(unc, one)
        SetF(slot, 64, unc)
        IfCondition EqualTo(TailConfig.follow, 2) ThenBlock: {
            IfCondition EqualTo(do_re, 1) ThenBlock: {
                hit = Recheck(idx)
                ReturnValue(hit)
            }
        }
        ReturnValue(0)
    }
}
Function.Consider {
    Input: idx: Integer
    Output: Integer
    Body: {
        slot = SlotAt(idx)
        flags = GetF(slot, 56)
        IfCondition NotEqual(BitwiseAnd(flags, 2), 0) ThenBlock: {
            ReturnValue(0)
        }
        fd = GetF(slot, 8)
        IfCondition LessThan(fd, 0) ThenBlock: {
            IfCondition EqualTo(TailConfig.follow, 2) ThenBlock: {
                hit = Recheck(idx)
                ReturnValue(hit)
            }
            IfCondition EqualTo(TailConfig.retry, 1) ThenBlock: {
                hit = Recheck(idx)
                ReturnValue(hit)
            }
            ReturnValue(0)
        }
        hit = ReadGrow(idx)
        ReturnValue(hit)
    }
}
Function.Live {
    Output: Integer
    Body: {
        one = 1
        i = 0
        IfCondition EqualTo(TailConfig.follow, 2) ThenBlock: {
            IfCondition EqualTo(TailConfig.retry, 1) ThenBlock: {
                ReturnValue(1)
            }
            WhileLoop LessThan(i, TailConfig.file_count) {
                slot = SlotAt(i)
                flags = GetF(slot, 56)
                IfCondition EqualTo(BitwiseAnd(flags, 2), 0) ThenBlock: {
                    ReturnValue(1)
                }
                i = Add(i, one)
            }
            ReturnValue(0)
        }
        i = 0
        WhileLoop LessThan(i, TailConfig.file_count) {
            slot = SlotAt(i)
            fd = GetF(slot, 8)
            flags = GetF(slot, 56)
            IfCondition GreaterEqual(fd, 0) ThenBlock: {
                ReturnValue(1)
            }
            ign = BitwiseAnd(flags, 2)
            IfCondition And(EqualTo(ign, 0), EqualTo(TailConfig.retry, 1)) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}
Function.PidDead {
    Output: Integer
    Body: {
        IfCondition EqualTo(TailConfig.pid, 0) ThenBlock: {
            ReturnValue(0)
        }
        rc = SystemCall(62, TailConfig.pid, 0)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(rc, -1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}
Function.FollowAll {
    Body: {
        IfCondition GreaterThan(TailConfig.file_count, 0) ThenBlock: {
            TailConfig.last_idx = Subtract(TailConfig.file_count, 1)
        }
        dead = 0
        one = 1
        WhileLoop 1 {
            IfCondition EqualTo(TailConfig.stop, 1) ThenBlock: {
                BreakLoop
            }
            shut = StdoutClosed()
            IfCondition EqualTo(shut, 1) ThenBlock: {
                TailConfig.errors = 1
                BreakLoop
            }
            any = 0
            i = 0
            WhileLoop LessThan(i, TailConfig.file_count) {
                hit = Consider(i)
                IfCondition EqualTo(hit, 1) ThenBlock: {
                    any = 1
                }
                i = Add(i, one)
            }
            alive = Live()
            IfCondition EqualTo(alive, 0) ThenBlock: {
                WriteOut(2, "tail: no files remaining\n")
                TailConfig.errors = 1
                BreakLoop
            }
            IfCondition EqualTo(any, 0) ThenBlock: {
                IfCondition EqualTo(dead, 1) ThenBlock: {
                    BreakLoop
                }
                gone = PidDead()
                IfCondition EqualTo(gone, 1) ThenBlock: {
                    dead = 1
                } ElseBlock: {
                    NanoSleep()
                }
            }
        }
    }
}
Function.CloseStdin {
    Body: {
        IfCondition EqualTo(TailConfig.read_stdin, 0) ThenBlock: {
            ReturnValue(0)
        }
        rc = SystemCall(3, 0)
        IfCondition LessThan(rc, 0) ThenBlock: {
            err = AbsErr(rc)
            msg = ErrText(err)
            WriteOut(2, "tail: -: ")
            WriteOut(2, msg)
            WriteOut(2, "\n")
            SystemCall(60, 1)
        }
    }
}
Function.WarnStdin {
    Body: {
        IfCondition EqualTo(TailConfig.follow, 0) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        i = 0
        saw = 0
        WhileLoop LessThan(i, TailConfig.file_count) {
            nm = RDMEM_64(TailConfig.names, Multiply(i, 8))
            dash = And(EqualTo(RDMEM_8(nm, 0), 45), EqualTo(RDMEM_8(nm, 1), 0))
            IfCondition EqualTo(dash, 1) ThenBlock: {
                saw = 1
            }
            i = Add(i, one)
        }
        IfCondition EqualTo(saw, 0) ThenBlock: {
            ReturnValue(0)
        }
        block = 0
        IfCondition EqualTo(TailConfig.pid, 0) ThenBlock: {
            IfCondition EqualTo(TailConfig.follow, 1) ThenBlock: {
                IfCondition EqualTo(TailConfig.file_count, 1) ThenBlock: {
                    st = Allocate(144)
                    sr = SystemCall(5, 0, st)
                    IfCondition GreaterEqual(sr, 0) ThenBlock: {
                        kind = KindOf(st)
                        IfCondition NotEqual(kind, 32768) ThenBlock: {
                            block = 1
                        }
                    }
                    Deallocate(st, 144)
                }
            }
        }
        IfCondition EqualTo(block, 1) ThenBlock: {
            ReturnValue(0)
        }
        tty = IsTty(0)
        IfCondition EqualTo(tty, 1) ThenBlock: {
            WriteOut(2, "tail: warning: following standard input indefinitely is ineffective\n")
        }
    }
}
Function.RunFiles {
    Body: {
        IfCondition EqualTo(TailConfig.count, 0) ThenBlock: {
            IfCondition EqualTo(TailConfig.from_start, 0) ThenBlock: {
                IfCondition EqualTo(TailConfig.follow, 0) ThenBlock: {
                    ReturnValue(0)
                }
            }
        }
        WarnStdin()
        TailConfig.files = Allocate(5120)
        one = 1
        i = 0
        WhileLoop LessThan(i, TailConfig.file_count) {
            name = RDMEM_64(TailConfig.names, Multiply(i, 8))
            OpenOne(i, name)
            i = Add(i, one)
        }
        IfCondition GreaterThan(TailConfig.follow, 0) ThenBlock: {
            viable = 0
            i = 0
            WhileLoop LessThan(i, TailConfig.file_count) {
                slot = SlotAt(i)
                flags = GetF(slot, 56)
                anon = BitwiseAnd(flags, 16)
                ign = BitwiseAnd(flags, 2)
                skip = And(NotEqual(anon, 0), NotEqual(ign, 0))
                IfCondition EqualTo(skip, 0) ThenBlock: {
                    viable = 1
                }
                i = Add(i, one)
            }
            IfCondition EqualTo(viable, 1) ThenBlock: {
                st = Allocate(144)
                sr = SystemCall(5, 1, st)
                Deallocate(st, 144)
                IfCondition LessThan(sr, 0) ThenBlock: {
                    err = AbsErr(sr)
                    msg = ErrText(err)
                    WriteOut(2, "tail: standard output: ")
                    WriteOut(2, msg)
                    WriteOut(2, "\n")
                    SystemCall(60, 1)
                }
                fell = FollowInotify()
                IfCondition EqualTo(fell, 0) ThenBlock: {
                    FollowAll()
                }
            }
        }
        CloseStdin()
    }
}
