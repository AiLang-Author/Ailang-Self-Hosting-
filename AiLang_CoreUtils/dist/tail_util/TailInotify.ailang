// Inotify follow. Pools stay on tail.ailang. No Main.
LibraryImport.Arena

Function.Low32 {
    Input: p: Address
    Output: Integer
    Body: {
        b0 = GetByte(p, 0)
        b1 = GetByte(p, 1)
        b2 = GetByte(p, 2)
        b3 = GetByte(p, 3)
        v = BitwiseOr(b0, Multiply(b1, 256))
        v = BitwiseOr(v, Multiply(b2, 65536))
        v = BitwiseOr(v, Multiply(b3, 16777216))
        ReturnValue(v)
    }
}
Function.Put32 {
    Input: p: Address
    Input: val: Integer
    Body: {
        SetByte(p, 0, BitwiseAnd(val, 255))
        SetByte(p, 1, BitwiseAnd(Divide(val, 256), 255))
        SetByte(p, 2, BitwiseAnd(Divide(val, 65536), 255))
        SetByte(p, 3, BitwiseAnd(Divide(val, 16777216), 255))
    }
}
Function.SlotW {
    Input: idx: Integer
    Output: Address
    Body: {
        off = Multiply(idx, 16)
        ReturnValue(Add(TailConfig.iwatch, off))
    }
}
Function.GetW {
    Input: idx: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        base = SlotW(idx)
        p = Add(base, field)
        v = Dereference(p)
        ReturnValue(v)
    }
}
Function.PutW {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        base = SlotW(idx)
        p = Add(base, field)
        StoreValue(p, val)
    }
}
Function.FileMask {
    Output: Integer
    Body: {
        IfCondition EqualTo(TailConfig.follow, 1) ThenBlock: {
            ReturnValue(2)
        }
        ReturnValue(3078)
    }
}
Function.AddWatch {
    Input: path: Address
    Input: mask: Integer
    Output: Integer
    Body: {
        rc = SystemCall(254, TailConfig.ino_fd, path, mask)
        ReturnValue(rc)
    }
}
Function.RmWatch {
    Input: wd: Integer
    Body: {
        IfCondition LessThan(wd, 0) ThenBlock: {
            ReturnValue(0)
        }
        rc = SystemCall(255, TailConfig.ino_fd, wd)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            ReturnValue(0)
        }
    }
}
Function.DirLen {
    Input: name: Address
    Output: Integer
    Body: {
        one = 1
        n = StringLength(name)
        base = 0
        i = 0
        saw = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(name, i)
            IfCondition EqualTo(ch, 47) ThenBlock: {
                saw = 1
            } ElseBlock: {
                IfCondition EqualTo(saw, 1) ThenBlock: {
                    base = i
                    saw = 0
                }
            }
            i = Add(i, one)
        }
        pref = 0
        c0 = GetByte(name, 0)
        IfCondition EqualTo(c0, 47) ThenBlock: {
            pref = 1
        }
        length = base
        WhileLoop GreaterThan(length, pref) {
            prev = Subtract(length, one)
            pch = GetByte(name, prev)
            IfCondition NotEqual(pch, 47) ThenBlock: {
                BreakLoop
            }
            length = prev
        }
        ReturnValue(length)
    }
}
Function.BasePtr {
    Input: name: Address
    Output: Address
    Body: {
        one = 1
        n = StringLength(name)
        base = 0
        i = 0
        saw = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(name, i)
            IfCondition EqualTo(ch, 47) ThenBlock: {
                saw = 1
            } ElseBlock: {
                IfCondition EqualTo(saw, 1) ThenBlock: {
                    base = i
                    saw = 0
                }
            }
            i = Add(i, one)
        }
        ReturnValue(Add(name, base))
    }
}
Function.CanInotify {
    Output: Integer
    Body: {
        IfCondition EqualTo(TailConfig.no_ino, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(TailConfig.file_count, 0) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        i = 0
        open_ok = 0
        bad_kind = 0
        link = 0
        dash = 0
        WhileLoop LessThan(i, TailConfig.file_count) {
            slot = SlotAt(i)
            name = GetF(slot, 0)
            flags = GetF(slot, 56)
            ign = BitwiseAnd(flags, 2)
            d0 = GetByte(name, 0)
            d1 = GetByte(name, 1)
            isdash = And(EqualTo(d0, 45), EqualTo(d1, 0))
            IfCondition And(EqualTo(ign, 0), EqualTo(isdash, 1)) ThenBlock: {
                dash = 1
            }
            st = Allocate(144)
            sr = SystemCall(6, name, st)
            IfCondition GreaterEqual(sr, 0) ThenBlock: {
                sk = KindOf(st)
                IfCondition EqualTo(sk, 40960) ThenBlock: {
                    link = 1
                }
            }
            Deallocate(st, 144)
            fd = GetF(slot, 8)
            IfCondition GreaterEqual(fd, 0) ThenBlock: {
                open_ok = 1
                k = GetF(slot, 40)
                okk = 0
                IfCondition EqualTo(k, 32768) ThenBlock: {
                    okk = 1
                }
                IfCondition EqualTo(k, 4096) ThenBlock: {
                    okk = 1
                }
                IfCondition EqualTo(okk, 0) ThenBlock: {
                    bad_kind = 1
                }
            }
            i = Add(i, one)
        }
        IfCondition EqualTo(dash, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(link, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(bad_kind, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(open_ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(TailConfig.follow, 1) ThenBlock: {
            IfCondition NotEqual(TailConfig.errors, 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        ReturnValue(1)
    }
}
Function.WatchParent {
    Input: idx: Integer
    Input: name: Address
    Output: Integer
    Body: {
        dlen = DirLen(name)
        wd = -1
        IfCondition EqualTo(dlen, 0) ThenBlock: {
            dot = Allocate(2)
            SetByte(dot, 0, 46)
            SetByte(dot, 1, 0)
            wd = AddWatch(dot, 1924)
            Deallocate(dot, 2)
        } ElseBlock: {
            saved = GetByte(name, dlen)
            SetByte(name, dlen, 0)
            wd = AddWatch(name, 1924)
            SetByte(name, dlen, saved)
        }
        IfCondition LessThan(wd, 0) ThenBlock: {
            aerr = AbsErr(wd)
            IfCondition EqualTo(aerr, 28) ThenBlock: {
                WriteOut(2, "tail: inotify resources exhausted\n")
            } ElseBlock: {
                msg = ErrText(aerr)
                WriteOut(2, "tail: cannot watch parent directory of ")
                WriteQName(name)
                WriteOut(2, ": ")
                WriteOut(2, msg)
                WriteOut(2, "\n")
            }
            ReturnValue(1)
        }
        PutW(idx, 8, wd)
        ReturnValue(0)
    }
}
Function.AddWatches {
    Output: Integer
    Body: {
        one = 1
        i = 0
        found = 0
        unwatch = 0
        WhileLoop LessThan(i, TailConfig.file_count) {
            slot = SlotAt(i)
            flags = GetF(slot, 56)
            ign = BitwiseAnd(flags, 2)
            IfCondition EqualTo(ign, 0) ThenBlock: {
                PutW(i, 0, -1)
                PutW(i, 8, -1)
                name = GetF(slot, 0)
                IfCondition EqualTo(TailConfig.follow, 2) ThenBlock: {
                    bad = WatchParent(i, name)
                    IfCondition EqualTo(bad, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                }
                mask = FileMask()
                fwd = AddWatch(name, mask)
                IfCondition LessThan(fwd, 0) ThenBlock: {
                    fd = GetF(slot, 8)
                    IfCondition GreaterEqual(fd, 0) ThenBlock: {
                        unwatch = 1
                    }
                    aerr = AbsErr(fwd)
                    boom = 0
                    IfCondition EqualTo(aerr, 28) ThenBlock: {
                        boom = 1
                    }
                    IfCondition EqualTo(aerr, 12) ThenBlock: {
                        boom = 1
                    }
                    IfCondition EqualTo(boom, 1) ThenBlock: {
                        WriteOut(2, "tail: inotify resources exhausted\n")
                        ReturnValue(1)
                    }
                    prev = GetF(slot, 48)
                    IfCondition NotEqual(aerr, prev) ThenBlock: {
                        msg = ErrText(aerr)
                        WriteOut(2, "tail: cannot watch ")
                        WriteQName(name)
                        WriteOut(2, ": ")
                        WriteOut(2, msg)
                        WriteOut(2, "\n")
                    }
                } ElseBlock: {
                    PutW(i, 0, fwd)
                    found = 1
                }
            }
            i = Add(i, one)
        }
        IfCondition EqualTo(TailConfig.follow, 1) ThenBlock: {
            IfCondition EqualTo(unwatch, 1) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(found, 0) ThenBlock: {
                ReturnValue(2)
            }
        }
        ReturnValue(0)
    }
}
Function.ParentHit {
    Input: wd: Integer
    Output: Integer
    Body: {
        one = 1
        i = 0
        WhileLoop LessThan(i, TailConfig.file_count) {
            pwd = GetW(i, 8)
            IfCondition EqualTo(pwd, wd) ThenBlock: {
                IfCondition GreaterEqual(pwd, 0) ThenBlock: {
                    ReturnValue(1)
                }
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}
Function.FindDir {
    Input: wd: Integer
    Input: ename: Address
    Output: Integer
    Body: {
        one = 1
        i = 0
        WhileLoop LessThan(i, TailConfig.file_count) {
            pwd = GetW(i, 8)
            IfCondition EqualTo(pwd, wd) ThenBlock: {
                slot = SlotAt(i)
                name = GetF(slot, 0)
                base = BasePtr(name)
                eq = StringEquals(ename, base)
                IfCondition EqualTo(eq, 1) ThenBlock: {
                    ReturnValue(i)
                }
            }
            i = Add(i, one)
        }
        ReturnValue(-1)
    }
}
Function.FindWd {
    Input: wd: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(wd, 0) ThenBlock: {
            ReturnValue(-1)
        }
        one = 1
        i = 0
        WhileLoop LessThan(i, TailConfig.file_count) {
            fwd = GetW(i, 0)
            IfCondition EqualTo(fwd, wd) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, one)
        }
        ReturnValue(-1)
    }
}
Function.StealWd {
    Input: idx: Integer
    Input: wd: Integer
    Body: {
        IfCondition LessThan(wd, 0) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        i = 0
        WhileLoop LessThan(i, TailConfig.file_count) {
            IfCondition NotEqual(i, idx) ThenBlock: {
                fwd = GetW(i, 0)
                IfCondition EqualTo(fwd, wd) ThenBlock: {
                    hit = Recheck(i)
                    IfCondition EqualTo(hit, 1) ThenBlock: {
                        hit = 0
                    }
                    PutW(i, 0, -1)
                    slot = SlotAt(i)
                    fd = GetF(slot, 8)
                    flags = GetF(slot, 56)
                    CloseIf(fd, flags)
                    SetF(slot, 8, -1)
                }
            }
            i = Add(i, one)
        }
    }
}
Function.HandleDir {
    Input: idx: Integer
    Input: mask: Integer
    Output: Integer
    Body: {
        slot = SlotAt(idx)
        name = GetF(slot, 0)
        deleting = BitwiseAnd(mask, 512)
        old = GetW(idx, 0)
        new_wd = -1
        IfCondition EqualTo(deleting, 0) ThenBlock: {
            maskf = FileMask()
            new_wd = AddWatch(name, maskf)
        }
        IfCondition And(EqualTo(deleting, 0), LessThan(new_wd, 0)) ThenBlock: {
            aerr = AbsErr(new_wd)
            boom = 0
            IfCondition EqualTo(aerr, 28) ThenBlock: {
                boom = 1
            }
            IfCondition EqualTo(aerr, 12) ThenBlock: {
                boom = 1
            }
            IfCondition EqualTo(boom, 1) ThenBlock: {
                WriteOut(2, "tail: inotify resources exhausted\n")
                ReturnValue(1)
            }
            msg = ErrText(aerr)
            WriteOut(2, "tail: cannot watch ")
            WriteQName(name)
            WriteOut(2, ": ")
            WriteOut(2, msg)
            WriteOut(2, "\n")
        }
        new_watch = 0
        IfCondition EqualTo(deleting, 0) ThenBlock: {
            changed = 0
            IfCondition LessThan(old, 0) ThenBlock: {
                changed = 1
            }
            IfCondition NotEqual(new_wd, old) ThenBlock: {
                changed = 1
            }
            IfCondition EqualTo(changed, 1) ThenBlock: {
                new_watch = 1
            }
        }
        IfCondition EqualTo(new_watch, 1) ThenBlock: {
            IfCondition GreaterEqual(old, 0) ThenBlock: {
                RmWatch(old)
            }
            PutW(idx, 0, new_wd)
            IfCondition LessThan(new_wd, 0) ThenBlock: {
                ReturnValue(0)
            }
            StealWd(idx, new_wd)
        }
        IfCondition EqualTo(TailConfig.follow, 2) ThenBlock: {
            hit = Recheck(idx)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ReturnValue(0)
            }
        }
        ReturnValue(0)
    }
}
Function.HandleFile {
    Input: idx: Integer
    Input: mask: Integer
    Body: {
        ign = BitwiseAnd(mask, 32768)
        mod = BitwiseAnd(mask, 2)
        rec = BitwiseAnd(mask, 3588)
        IfCondition And(NotEqual(ign, 0), EqualTo(rec, 0)) ThenBlock: {
            IfCondition EqualTo(mod, 0) ThenBlock: {
                PutW(idx, 0, -1)
                ReturnValue(0)
            }
        }
        IfCondition NotEqual(rec, 0) ThenBlock: {
            delself = BitwiseAnd(mask, 1024)
            IfCondition NotEqual(delself, 0) ThenBlock: {
                old = GetW(idx, 0)
                IfCondition GreaterEqual(old, 0) ThenBlock: {
                    RmWatch(old)
                }
                PutW(idx, 0, -1)
            }
            hit = Recheck(idx)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(mod, 0) ThenBlock: {
            slot = SlotAt(idx)
            fd = GetF(slot, 8)
            IfCondition GreaterEqual(fd, 0) ThenBlock: {
                hit = ReadGrow(idx)
                IfCondition EqualTo(hit, 1) ThenBlock: {
                    ReturnValue(0)
                }
            }
        }
    }
}
Function.EatEvents {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        sixteen = 16
        off = 0
        WhileLoop LessThan(off, n) {
            need = Add(off, sixteen)
            IfCondition GreaterThan(need, n) ThenBlock: {
                BreakLoop
            }
            ev = Add(buf, off)
            wd = Low32(ev)
            mp = Add(ev, 4)
            mask = Low32(mp)
            lp = Add(ev, 12)
            elen = Low32(lp)
            step = Add(sixteen, elen)
            nxt = Add(off, step)
            IfCondition GreaterThan(nxt, n) ThenBlock: {
                BreakLoop
            }
            delself = BitwiseAnd(mask, 1024)
            IfCondition And(NotEqual(delself, 0), EqualTo(elen, 0)) ThenBlock: {
                ph = ParentHit(wd)
                IfCondition EqualTo(ph, 1) ThenBlock: {
                    WriteOut(2, "tail: directory containing watched file was removed\n")
                    ReturnValue(1)
                }
            }
            IfCondition NotEqual(elen, 0) ThenBlock: {
                np = Add(ev, 16)
                idx = FindDir(wd, np)
                IfCondition GreaterEqual(idx, 0) ThenBlock: {
                    hr = HandleDir(idx, mask)
                    IfCondition EqualTo(hr, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                }
            } ElseBlock: {
                idx2 = FindWd(wd)
                IfCondition GreaterEqual(idx2, 0) ThenBlock: {
                    HandleFile(idx2, mask)
                }
            }
            off = nxt
        }
        ReturnValue(0)
    }
}
Function.PollIno {
    Output: Integer
    Body: {
        pfd = Allocate(16)
        one = 1
        i = 0
        WhileLoop LessThan(i, 16) {
            SetByte(pfd, i, 0)
            i = Add(i, one)
        }
        Put32(pfd, TailConfig.ino_fd)
        SetByte(pfd, 4, 1)
        nfds = 1
        st = Allocate(144)
        sr = SystemCall(5, 1, st)
        kind = 0
        IfCondition GreaterEqual(sr, 0) ThenBlock: {
            kind = KindOf(st)
        }
        Deallocate(st, 144)
        IfCondition EqualTo(kind, 4096) ThenBlock: {
            nfds = 2
            outp = Add(pfd, 8)
            Put32(outp, 1)
            SetByte(pfd, 12, 1)
        }
        delay = -1
        IfCondition NotEqual(TailConfig.pid, 0) ThenBlock: {
            IfCondition EqualTo(TailConfig.ino_dead, 1) ThenBlock: {
                Deallocate(pfd, 16)
                ReturnValue(-2)
            }
            gone = PidDead()
            IfCondition EqualTo(gone, 1) ThenBlock: {
                TailConfig.ino_dead = 1
                seen = TailConfig.ino_dead
                IfCondition EqualTo(seen, 1) ThenBlock: {
                    delay = 0
                }
            } ElseBlock: {
                asleep = 0
                IfCondition LessEqual(TailConfig.sleep_sec, 0) ThenBlock: {
                    IfCondition LessEqual(TailConfig.sleep_nsec, 0) ThenBlock: {
                        asleep = 1
                    }
                }
                IfCondition EqualTo(asleep, 1) ThenBlock: {
                    delay = 0
                } ElseBlock: {
                    ms = Multiply(TailConfig.sleep_sec, 1000)
                    extra = Divide(TailConfig.sleep_nsec, 1000000)
                    remn = Multiply(extra, 1000000)
                    rem = Subtract(TailConfig.sleep_nsec, remn)
                    delay = Add(ms, extra)
                    IfCondition GreaterThan(rem, 0) ThenBlock: {
                        delay = Add(delay, one)
                    }
                }
            }
        }
        rc = SystemCall(7, pfd, nfds, delay)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            Deallocate(pfd, 16)
            ReturnValue(0)
        }
        IfCondition LessThan(rc, 0) ThenBlock: {
            Deallocate(pfd, 16)
            IfCondition EqualTo(rc, -4) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(-3)
        }
        IfCondition EqualTo(nfds, 2) ThenBlock: {
            rev = GetByte(pfd, 14)
            bad = BitwiseAnd(rev, 56)
            IfCondition NotEqual(bad, 0) ThenBlock: {
                Deallocate(pfd, 16)
                ReturnValue(-1)
            }
        }
        Deallocate(pfd, 16)
        ReturnValue(1)
    }
}
Function.NoneLeft {
    Output: Integer
    Body: {
        IfCondition NotEqual(TailConfig.follow, 2) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(TailConfig.retry, 1) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        i = 0
        WhileLoop LessThan(i, TailConfig.file_count) {
            slot = SlotAt(i)
            flags = GetF(slot, 56)
            ign = BitwiseAnd(flags, 2)
            IfCondition EqualTo(ign, 0) ThenBlock: {
                wd = GetW(i, 0)
                IfCondition GreaterEqual(wd, 0) ThenBlock: {
                    ReturnValue(0)
                }
            }
            i = Add(i, one)
        }
        ReturnValue(1)
    }
}
Function.RevertIno {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(TailConfig.ino_fd, 0) ThenBlock: {
            SystemCall(3, TailConfig.ino_fd)
            TailConfig.ino_fd = -1
        }
        WriteOut(2, "tail: inotify cannot be used, reverting to polling\n")
        ReturnValue(0)
    }
}
Function.FollowInotify {
    Output: Integer
    Body: {
        can = CanInotify()
        IfCondition EqualTo(can, 0) ThenBlock: {
            ReturnValue(0)
        }
        fd = SystemCall(253)
        IfCondition And(GreaterEqual(fd, 0), LessThan(fd, 3)) ThenBlock: {
            neu = SystemCall(72, fd, 0, 3)
            IfCondition GreaterEqual(neu, 0) ThenBlock: {
                SystemCall(3, fd)
                fd = neu
            }
        }
        IfCondition LessThan(fd, 0) ThenBlock: {
            aerr = AbsErr(fd)
            msg = ErrText(aerr)
            WriteOut(2, "tail: inotify cannot be used, reverting to polling: ")
            WriteOut(2, msg)
            WriteOut(2, "\n")
            ReturnValue(0)
        }
        TailConfig.ino_fd = fd
        TailConfig.ino_dead = 0
        TailConfig.iwatch = Allocate(1024)
        one = 1
        z = 0
        WhileLoop LessThan(z, 64) {
            PutW(z, 0, -1)
            PutW(z, 8, -1)
            z = Add(z, one)
        }
        aw = AddWatches()
        IfCondition EqualTo(aw, 2) ThenBlock: {
            SystemCall(3, TailConfig.ino_fd)
            TailConfig.ino_fd = -1
            SystemCall(60, 1)
        }
        IfCondition EqualTo(aw, 1) ThenBlock: {
            fell = RevertIno()
            ReturnValue(fell)
        }
        IfCondition GreaterThan(TailConfig.file_count, 0) ThenBlock: {
            TailConfig.last_idx = Subtract(TailConfig.file_count, 1)
        }
        i = 0
        WhileLoop LessThan(i, TailConfig.file_count) {
            slot = SlotAt(i)
            flags = GetF(slot, 56)
            ign = BitwiseAnd(flags, 2)
            IfCondition EqualTo(ign, 0) ThenBlock: {
                hit = Consider(i)
                IfCondition EqualTo(hit, 1) ThenBlock: {
                    ign = 0
                }
            }
            i = Add(i, one)
        }
        evbuf = Allocate(4096)
        WhileLoop 1 {
            IfCondition EqualTo(TailConfig.stop, 1) ThenBlock: {
                SystemCall(60, TailConfig.errors)
            }
            left = NoneLeft()
            IfCondition EqualTo(left, 1) ThenBlock: {
                WriteOut(2, "tail: no files remaining\n")
                SystemCall(60, 1)
            }
            pr = PollIno()
            IfCondition EqualTo(pr, -2) ThenBlock: {
                SystemCall(60, 0)
            }
            IfCondition EqualTo(pr, -1) ThenBlock: {
                TailConfig.errors = 1
                SystemCall(60, 1)
            }
            IfCondition EqualTo(pr, -3) ThenBlock: {
                BreakLoop
            }
            IfCondition EqualTo(pr, 0) ThenBlock: {
                ContinueLoop
            }
            n = SysRead(TailConfig.ino_fd, evbuf, 4096)
            IfCondition LessEqual(n, 0) ThenBlock: {
                BreakLoop
            }
            stop = EatEvents(evbuf, n)
            IfCondition EqualTo(stop, 1) ThenBlock: {
                BreakLoop
            }
        }
        Deallocate(evbuf, 4096)
        fell = RevertIno()
        ReturnValue(fell)
    }
}
