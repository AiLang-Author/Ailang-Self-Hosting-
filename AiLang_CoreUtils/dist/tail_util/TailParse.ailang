// Option parse and obsolete counts. Pools stay on tail.ailang. No Main.
LibraryImport.Arena

Function.SysOpen {
    Input: filename: Address
    Input: flags: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, filename, flags, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(fd)
        }
        IfCondition GreaterEqual(fd, 3) ThenBlock: {
            ReturnValue(fd)
        }
        neu = SystemCall(72, fd, 0, 3)
        SystemCall(3, fd)
        ReturnValue(neu)
    }
}
Function.SysRead {
    Input: fd: Integer
    Input: buffer: Address
    Input: count: Integer
    Output: Integer
    Body: {
        ReturnValue(SystemCall(0, fd, buffer, count))
    }
}
Function.SysWrite {
    Input: fd: Integer
    Input: buffer: Address
    Input: count: Integer
    Output: Integer
    Body: {
        ReturnValue(SystemCall(1, fd, buffer, count))
    }
}
Function.WriteOut {
    Input: fd: Integer
    Input: str: Address
    Body: {
        len = StringLength(str)
        SysWrite(fd, str, len)
    }
}
Function.ErrText {
    Input: err: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(err, 1) ThenBlock: { ReturnValue("Operation not permitted") }
        IfCondition EqualTo(err, 2) ThenBlock: { ReturnValue("No such file or directory") }
        IfCondition EqualTo(err, 9) ThenBlock: { ReturnValue("Bad file descriptor") }
        IfCondition EqualTo(err, 13) ThenBlock: { ReturnValue("Permission denied") }
        IfCondition EqualTo(err, 20) ThenBlock: { ReturnValue("Not a directory") }
        IfCondition EqualTo(err, 21) ThenBlock: { ReturnValue("Is a directory") }
        IfCondition EqualTo(err, 22) ThenBlock: { ReturnValue("Invalid argument") }
        ReturnValue("Unknown error")
    }
}
Function.AbsErr {
    Input: rc: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(rc, 0) ThenBlock: {
            ReturnValue(Subtract(0, rc))
        }
        ReturnValue(rc)
    }
}
Function.WritePretty {
    Input: fd: Integer
    Input: name: Address
    Body: {
        dash = And(EqualTo(RDMEM_8(name, 0), 45), EqualTo(RDMEM_8(name, 1), 0))
        IfCondition EqualTo(dash, 1) ThenBlock: {
            WriteOut(fd, "standard input")
        } ElseBlock: {
            WriteOut(fd, name)
        }
    }
}
Function.WriteQName {
    Input: name: Address
    Body: {
        WriteOut(2, "'")
        WritePretty(2, name)
        WriteOut(2, "'")
    }
}
Function.NanoSleep {
    Body: {
        req = Allocate(16)
        i = 0
        one = 1
        sec = TailConfig.sleep_sec
        nsec = TailConfig.sleep_nsec
        WhileLoop LessThan(i, 8) {
            WRMEM_8(req, i, BitwiseAnd(sec, 255))
            sec = Divide(sec, 256)
            WRMEM_8(req, Add(i, 8), BitwiseAnd(nsec, 255))
            nsec = Divide(nsec, 256)
            i = Add(i, one)
        }
        SystemCall(35, req, 0)
        Deallocate(req, 16)
    }
}
Function.StdoutClosed {
    Output: Integer
    Body: {
        pfd = Allocate(8)
        WRMEM_8(pfd, 0, 1)
        WRMEM_8(pfd, 1, 0)
        WRMEM_8(pfd, 2, 0)
        WRMEM_8(pfd, 3, 0)
        WRMEM_8(pfd, 4, 0)
        WRMEM_8(pfd, 5, 0)
        WRMEM_8(pfd, 6, 0)
        WRMEM_8(pfd, 7, 0)
        rc = SystemCall(7, pfd, 1, 0)
        IfCondition GreaterThan(rc, 0) ThenBlock: {
            re = RDMEM_8(pfd, 6)
            closed = BitwiseAnd(re, 56)
            Deallocate(pfd, 8)
            IfCondition NotEqual(closed, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        Deallocate(pfd, 8)
        ReturnValue(0)
    }
}
Function.SlotAt {
    Input: idx: Integer
    Output: Address
    Body: {
        off = Multiply(idx, 80)
        ReturnValue(Add(TailConfig.files, off))
    }
}
Function.GetF {
    Input: slot: Address
    Input: off: Integer
    Output: Integer
    Body: {
        ReturnValue(RDMEM_64(slot, off))
    }
}
Function.SetF {
    Input: slot: Address
    Input: off: Integer
    Input: val: Integer
    Body: {
        WRMEM_64(slot, off, val)
    }
}
Function.IsPrefix {
    Input: user: Address
    Input: full: Address
    Output: Integer
    Body: {
        one = 1
        i = 0
        IfCondition EqualTo(RDMEM_8(user, 0), 0) ThenBlock: {
            ReturnValue(0)
        }
        WhileLoop 1 {
            uc = RDMEM_8(user, i)
            IfCondition EqualTo(uc, 0) ThenBlock: {
                ReturnValue(1)
            }
            fc = RDMEM_8(full, i)
            IfCondition NotEqual(uc, fc) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
    }
}
Function.BadNum {
    Input: kind: Integer
    Input: text: Address
    Body: {
        IfCondition EqualTo(kind, 1) ThenBlock: {
            WriteOut(2, "tail: invalid number of bytes: '")
        } ElseBlock: {
            WriteOut(2, "tail: invalid number of lines: '")
        }
        WriteOut(2, text)
        WriteOut(2, "'\n")
        SystemCall(60, 1)
    }
}
Function.DieHelp {
    Body: {
        WriteOut(2, "Try 'tail --help' for more information.\n")
        SystemCall(60, 1)
    }
}
Function.ParseU {
    Input: str: Address
    Body: {
        one = 1
        i = 0
        val = 0
        anyd = 0
        bad = 0
        WhileLoop 1 {
            ch = RDMEM_8(str, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            digit = And(GreaterEqual(ch, 48), LessEqual(ch, 57))
            IfCondition EqualTo(digit, 0) ThenBlock: {
                bad = 1
                BreakLoop
            }
            anyd = 1
            IfCondition GreaterThan(val, 922337203685477580) ThenBlock: {
                bad = 1
                BreakLoop
            }
            val = Add(Multiply(val, 10), Subtract(ch, 48))
            IfCondition LessThan(val, 0) ThenBlock: {
                bad = 1
                BreakLoop
            }
            i = Add(i, one)
        }
        IfCondition EqualTo(anyd, 0) ThenBlock: {
            bad = 1
        }
        TailNum.bad = bad
        TailNum.val = val
    }
}
Function.ParseCount {
    Input: str: Address
    Input: kind: Integer
    Body: {
        ch = RDMEM_8(str, 0)
        p = str
        TailConfig.from_start = 0
        IfCondition EqualTo(ch, 43) ThenBlock: {
            TailConfig.from_start = 1
            p = Add(str, 1)
        }
        IfCondition EqualTo(ch, 45) ThenBlock: {
            p = Add(str, 1)
        }
        ParseU(p)
        IfCondition EqualTo(TailNum.bad, 1) ThenBlock: {
            BadNum(kind, p)
        }
        TailConfig.count = TailNum.val
        TailConfig.use_bytes = kind
    }
}
Function.ParseSleep {
    Input: str: Address
    Body: {
        one = 1
        i = 0
        sec = 0
        anyd = 0
        bad = 0
        WhileLoop 1 {
            ch = RDMEM_8(str, i)
            digit = And(GreaterEqual(ch, 48), LessEqual(ch, 57))
            IfCondition EqualTo(digit, 0) ThenBlock: {
                BreakLoop
            }
            anyd = 1
            sec = Add(Multiply(sec, 10), Subtract(ch, 48))
            i = Add(i, one)
        }
        nsec = 0
        IfCondition EqualTo(RDMEM_8(str, i), 46) ThenBlock: {
            i = Add(i, one)
            scale = 100000000
            WhileLoop GreaterThan(scale, 0) {
                ch = RDMEM_8(str, i)
                digit = And(GreaterEqual(ch, 48), LessEqual(ch, 57))
                IfCondition EqualTo(digit, 0) ThenBlock: {
                    scale = 0
                } ElseBlock: {
                    anyd = 1
                    nsec = Add(nsec, Multiply(Subtract(ch, 48), scale))
                    scale = Divide(scale, 10)
                    i = Add(i, one)
                }
            }
        }
        IfCondition NotEqual(RDMEM_8(str, i), 0) ThenBlock: {
            bad = 1
        }
        IfCondition EqualTo(anyd, 0) ThenBlock: {
            bad = 1
        }
        IfCondition EqualTo(bad, 1) ThenBlock: {
            WriteOut(2, "tail: invalid number of seconds: '")
            WriteOut(2, str)
            WriteOut(2, "'\n")
            SystemCall(60, 1)
        }
        TailConfig.sleep_sec = sec
        TailConfig.sleep_nsec = nsec
    }
}
Function.PosixVer {
    Output: Integer
    Body: {
        fd = SystemCall(257, -100, "/proc/self/environ", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(200809)
        }
        buf = Allocate(8192)
        n = SystemCall(0, fd, buf, 8192)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 8192)
            ReturnValue(200809)
        }
        key = "_POSIX2_VERSION="
        one = 1
        i = 0
        ver = 200809
        WhileLoop LessThan(i, n) {
            hit = 1
            k = 0
            WhileLoop And(LessThan(k, 16), EqualTo(hit, 1)) {
                kb = RDMEM_8(key, k)
                bb = RDMEM_8(buf, Add(i, k))
                IfCondition NotEqual(kb, bb) ThenBlock: {
                    hit = 0
                } ElseBlock: {
                    k = Add(k, one)
                }
            }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                p = Add(buf, Add(i, 16))
                ParseU(p)
                IfCondition EqualTo(TailNum.bad, 0) ThenBlock: {
                    ver = TailNum.val
                }
                i = n
            } ElseBlock: {
                WhileLoop And(LessThan(i, n), NotEqual(RDMEM_8(buf, i), 0)) {
                    i = Add(i, one)
                }
                i = Add(i, one)
            }
        }
        Deallocate(buf, 8192)
        ReturnValue(ver)
    }
}
Function.CopyArg {
    Input: buf: Address
    Input: off: Integer
    Output: Address
    Body: {
        one = 1
        len = 0
        WhileLoop NotEqual(RDMEM_8(buf, Add(off, len)), 0) {
            len = Add(len, one)
        }
        name = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            WRMEM_8(name, i, RDMEM_8(buf, Add(off, i)))
            i = Add(i, one)
        }
        WRMEM_8(name, len, 0)
        ReturnValue(name)
    }
}
Function.AddFile {
    Input: name: Address
    Body: {
        IfCondition LessThan(TailConfig.file_count, 64) ThenBlock: {
            WRMEM_64(TailConfig.names, Multiply(TailConfig.file_count, 8), name)
            one = 1
            TailConfig.file_count = Add(TailConfig.file_count, one)
        }
    }
}
Function.TryObsolete {
    Input: arg: Address
    Output: Integer
    Body: {
        ver = PosixVer()
        obs = 0
        trad = 0
        IfCondition LessThan(ver, 200112) ThenBlock: {
            obs = 1
            trad = 1
        }
        IfCondition GreaterEqual(ver, 200809) ThenBlock: {
            trad = 1
        }
        sign = RDMEM_8(arg, 0)
        IfCondition EqualTo(sign, 43) ThenBlock: {
            IfCondition EqualTo(trad, 0) ThenBlock: {
                ReturnValue(0)
            }
        } ElseBlock: {
            IfCondition NotEqual(sign, 45) ThenBlock: {
                ReturnValue(0)
            }
        }
        one = 1
        i = 1
        IfCondition EqualTo(sign, 45) ThenBlock: {
            c0 = RDMEM_8(arg, 1)
            c1 = RDMEM_8(arg, 2)
            probe = c0
            IfCondition EqualTo(c0, 99) ThenBlock: {
                probe = c1
            }
            IfCondition EqualTo(obs, 0) ThenBlock: {
                IfCondition EqualTo(probe, 0) ThenBlock: {
                    ReturnValue(0)
                }
            }
        }
        val = 0
        anyd = 0
        bad = 0
        WhileLoop 1 {
            ch = RDMEM_8(arg, i)
            digit = And(GreaterEqual(ch, 48), LessEqual(ch, 57))
            IfCondition EqualTo(digit, 0) ThenBlock: {
                BreakLoop
            }
            anyd = 1
            IfCondition GreaterThan(val, 922337203685477580) ThenBlock: {
                bad = 1
                BreakLoop
            }
            val = Add(Multiply(val, 10), Subtract(ch, 48))
            IfCondition LessThan(val, 0) ThenBlock: {
                bad = 1
                BreakLoop
            }
            i = Add(i, one)
        }
        IfCondition EqualTo(bad, 1) ThenBlock: {
            BadNum(1, arg)
        }
        unit = RDMEM_8(arg, i)
        bytes = 0
        IfCondition EqualTo(unit, 98) ThenBlock: {
            bytes = 1
            IfCondition EqualTo(anyd, 0) ThenBlock: {
                val = 5120
            } ElseBlock: {
                IfCondition GreaterThan(val, 18014398509481983) ThenBlock: {
                    BadNum(1, arg)
                }
                val = Multiply(val, 512)
            }
            i = Add(i, one)
        } ElseBlock: {
            IfCondition EqualTo(unit, 99) ThenBlock: {
                bytes = 1
                i = Add(i, one)
            } ElseBlock: {
                IfCondition EqualTo(unit, 108) ThenBlock: {
                    i = Add(i, one)
                }
            }
        }
        fore = 0
        IfCondition EqualTo(RDMEM_8(arg, i), 102) ThenBlock: {
            fore = 1
            i = Add(i, one)
        }
        IfCondition NotEqual(RDMEM_8(arg, i), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(anyd, 0) ThenBlock: {
            val = 10
            IfCondition EqualTo(unit, 98) ThenBlock: {
                val = 5120
            }
        }
        TailConfig.count = val
        TailConfig.use_bytes = bytes
        IfCondition EqualTo(sign, 43) ThenBlock: {
            TailConfig.from_start = 1
        } ElseBlock: {
            TailConfig.from_start = 0
        }
        IfCondition EqualTo(fore, 1) ThenBlock: {
            TailConfig.follow = 1
        }
        ReturnValue(1)
    }
}
Function.NextArg {
    Input: buf: Address
    Input: name: Address
    Output: Address
    Body: {
        one = 1
        nxt = Add(TailNum.extra, one)
        IfCondition GreaterEqual(nxt, TailConfig.argn) ThenBlock: {
            WriteOut(2, "tail: option '--")
            WriteOut(2, name)
            WriteOut(2, "' requires an argument\n")
            DieHelp()
        }
        off = RDMEM_64(TailConfig.offs, Multiply(nxt, 8))
        TailNum.extra = nxt
        ReturnValue(Add(buf, off))
    }
}
Function.TakeValue {
    Input: buf: Address
    Input: rest: Address
    Input: och: Integer
    Output: Address
    Body: {
        IfCondition NotEqual(RDMEM_8(rest, 0), 0) ThenBlock: {
            ReturnValue(rest)
        }
        one = 1
        nxt = Add(TailNum.extra, one)
        IfCondition GreaterEqual(nxt, TailConfig.argn) ThenBlock: {
            WriteOut(2, "tail: option requires an argument -- '")
            tmp = Allocate(2)
            WRMEM_8(tmp, 0, och)
            WRMEM_8(tmp, 1, 0)
            WriteOut(2, tmp)
            WriteOut(2, "'\n")
            DieHelp()
        }
        off = RDMEM_64(TailConfig.offs, Multiply(nxt, 8))
        TailNum.extra = nxt
        ReturnValue(Add(buf, off))
    }
}
Function.ApplyFollow {
    Input: val: Address
    Body: {
        IfCondition EqualTo(RDMEM_8(val, 0), 0) ThenBlock: {
            TailConfig.follow = 1
        } ElseBlock: {
            nn = IsPrefix(val, "name")
            dd = IsPrefix(val, "descriptor")
            IfCondition And(EqualTo(nn, 1), EqualTo(dd, 0)) ThenBlock: {
                TailConfig.follow = 2
            } ElseBlock: {
                IfCondition And(EqualTo(dd, 1), EqualTo(nn, 0)) ThenBlock: {
                    TailConfig.follow = 1
                } ElseBlock: {
                    WriteOut(2, "tail: invalid argument '")
                    WriteOut(2, val)
                    WriteOut(2, "' for '--follow'\n")
                    DieHelp()
                }
            }
        }
    }
}
Function.ParseLong {
    Input: buf: Address
    Input: arg: Address
    Body: {
        body = Add(arg, 2)
        IfCondition EqualTo(RDMEM_8(arg, 2), 45) ThenBlock: {
            rest = Add(arg, 3)
            di = IsPrefix(rest, "disable-inotify")
            pr = IsPrefix(rest, "presume-input-pipe")
            IfCondition And(EqualTo(di, 1), EqualTo(pr, 0)) ThenBlock: {
                TailConfig.no_ino = 1
                ReturnValue(0)
            }
            IfCondition And(EqualTo(pr, 1), EqualTo(di, 0)) ThenBlock: {
                TailConfig.presume = 1
                ReturnValue(0)
            }
            WriteOut(2, "tail: unrecognized option '")
            WriteOut(2, arg)
            WriteOut(2, "'\n")
            DieHelp()
        }
        one = 1
        i = 0
        eq = -1
        hit = 0
        WhileLoop And(NotEqual(RDMEM_8(body, i), 0), EqualTo(hit, 0)) {
            IfCondition EqualTo(RDMEM_8(body, i), 61) ThenBlock: {
                eq = i
                hit = 1
            } ElseBlock: {
                i = Add(i, one)
            }
        }
        name = body
        val = body
        has = 0
        IfCondition GreaterEqual(eq, 0) ThenBlock: {
            WRMEM_8(body, eq, 0)
            val = Add(body, Add(eq, 1))
            has = 1
        }
        si = IsPrefix(name, "silent")
        sl = IsPrefix(name, "sleep-interval")
        IfCondition And(EqualTo(si, 1), EqualTo(sl, 1)) ThenBlock: {
            WriteOut(2, "tail: option '--")
            WriteOut(2, name)
            WriteOut(2, "' is ambiguous\n")
            DieHelp()
        }
        hit = IsPrefix(name, "bytes")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            IfCondition EqualTo(has, 0) ThenBlock: {
                val = NextArg(buf, name)
            }
            ParseCount(val, 1)
            ReturnValue(0)
        }
        hit = IsPrefix(name, "lines")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            IfCondition EqualTo(has, 0) ThenBlock: {
                val = NextArg(buf, name)
            }
            ParseCount(val, 0)
            ReturnValue(0)
        }
        hit = IsPrefix(name, "follow")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            IfCondition EqualTo(has, 1) ThenBlock: {
                ApplyFollow(val)
            } ElseBlock: {
                TailConfig.follow = 1
            }
            ReturnValue(0)
        }
        hit = IsPrefix(name, "max-unchanged-stats")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            IfCondition EqualTo(has, 0) ThenBlock: {
                val = NextArg(buf, name)
            }
            ParseU(val)
            IfCondition EqualTo(TailNum.bad, 1) ThenBlock: {
                WriteOut(2, "tail: invalid maximum number of unchanged stats between opens: '")
                WriteOut(2, val)
                WriteOut(2, "'\n")
                SystemCall(60, 1)
            }
            TailConfig.max_same = TailNum.val
            ReturnValue(0)
        }
        hit = IsPrefix(name, "pid")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            IfCondition EqualTo(has, 0) ThenBlock: {
                val = NextArg(buf, name)
            }
            ParseU(val)
            IfCondition EqualTo(TailNum.bad, 1) ThenBlock: {
                WriteOut(2, "tail: invalid PID: '")
                WriteOut(2, val)
                WriteOut(2, "'\n")
                SystemCall(60, 1)
            }
            TailConfig.pid = TailNum.val
            ReturnValue(0)
        }
        hit = IsPrefix(name, "quiet")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            TailConfig.header_mode = 1
            ReturnValue(0)
        }
        hit = IsPrefix(name, "retry")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            TailConfig.retry = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(si, 1) ThenBlock: {
            TailConfig.header_mode = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(sl, 1) ThenBlock: {
            IfCondition EqualTo(has, 0) ThenBlock: {
                val = NextArg(buf, name)
            }
            ParseSleep(val)
            ReturnValue(0)
        }
        hit = IsPrefix(name, "verbose")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            TailConfig.header_mode = 2
            ReturnValue(0)
        }
        hit = IsPrefix(name, "zero-terminated")
        IfCondition EqualTo(hit, 1) ThenBlock: {
            TailConfig.delim = 0
            ReturnValue(0)
        }
        WriteOut(2, "tail: unrecognized option '")
        WriteOut(2, arg)
        WriteOut(2, "'\n")
        DieHelp()
    }
}
Function.ParseShort {
    Input: buf: Address
    Input: arg: Address
    Body: {
        one = 1
        i = 1
        WhileLoop NotEqual(RDMEM_8(arg, i), 0) {
            och = RDMEM_8(arg, i)
            rest = Add(arg, Add(i, 1))
            IfCondition And(GreaterEqual(och, 48), LessEqual(och, 57)) ThenBlock: {
                WriteOut(2, "tail: option used in invalid context -- ")
                tmp = Allocate(2)
                WRMEM_8(tmp, 0, och)
                WRMEM_8(tmp, 1, 10)
                SysWrite(2, tmp, 2)
                SystemCall(60, 1)
            }
            IfCondition EqualTo(och, 102) ThenBlock: {
                TailConfig.follow = 1
            }
            IfCondition EqualTo(och, 70) ThenBlock: {
                TailConfig.follow = 2
                TailConfig.retry = 1
            }
            IfCondition EqualTo(och, 113) ThenBlock: {
                TailConfig.header_mode = 1
            }
            IfCondition EqualTo(och, 118) ThenBlock: {
                TailConfig.header_mode = 2
            }
            IfCondition EqualTo(och, 122) ThenBlock: {
                TailConfig.delim = 0
            }
            IfCondition EqualTo(och, 110) ThenBlock: {
                val = TakeValue(buf, rest, 110)
                ParseCount(val, 0)
                ReturnValue(0)
            }
            IfCondition EqualTo(och, 99) ThenBlock: {
                val = TakeValue(buf, rest, 99)
                ParseCount(val, 1)
                ReturnValue(0)
            }
            IfCondition EqualTo(och, 115) ThenBlock: {
                val = TakeValue(buf, rest, 115)
                ParseSleep(val)
                ReturnValue(0)
            }
            known = 0
            IfCondition EqualTo(och, 102) ThenBlock: { known = 1 }
            IfCondition EqualTo(och, 70) ThenBlock: { known = 1 }
            IfCondition EqualTo(och, 113) ThenBlock: { known = 1 }
            IfCondition EqualTo(och, 118) ThenBlock: { known = 1 }
            IfCondition EqualTo(och, 122) ThenBlock: { known = 1 }
            IfCondition EqualTo(known, 0) ThenBlock: {
                WriteOut(2, "tail: invalid option -- '")
                tmp = Allocate(2)
                WRMEM_8(tmp, 0, och)
                WRMEM_8(tmp, 1, 0)
                WriteOut(2, tmp)
                WriteOut(2, "'\n")
                DieHelp()
            }
            i = Add(i, one)
        }
    }
}
Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buffer = Allocate(8192)
        nread = SystemCall(0, fd, buffer, 8192)
        SystemCall(3, fd)
        IfCondition LessEqual(nread, 0) ThenBlock: {
            Deallocate(buffer, 8192)
            ReturnValue(0)
        }
        TailConfig.nread = nread
        ReturnValue(buffer)
    }
}
Function.FinishParse {
    Body: {
        IfCondition EqualTo(TailConfig.file_count, 0) ThenBlock: {
            dash = Allocate(2)
            WRMEM_8(dash, 0, 45)
            WRMEM_8(dash, 1, 0)
            AddFile(dash)
        }
        IfCondition EqualTo(TailConfig.from_start, 1) ThenBlock: {
            IfCondition GreaterThan(TailConfig.count, 0) ThenBlock: {
                TailConfig.count = Subtract(TailConfig.count, 1)
            }
        }
        IfCondition EqualTo(TailConfig.retry, 1) ThenBlock: {
            IfCondition EqualTo(TailConfig.follow, 0) ThenBlock: {
                WriteOut(2, "tail: warning: --retry ignored; --retry is useful only when following\n")
                TailConfig.retry = 0
            } ElseBlock: {
                IfCondition EqualTo(TailConfig.follow, 1) ThenBlock: {
                    WriteOut(2, "tail: warning: --retry only effective for the initial open\n")
                }
            }
        }
        IfCondition GreaterThan(TailConfig.pid, 0) ThenBlock: {
            IfCondition EqualTo(TailConfig.follow, 0) ThenBlock: {
                WriteOut(2, "tail: warning: PID ignored; --pid=PID is useful only when following\n")
                TailConfig.pid = 0
            }
        }
        IfCondition EqualTo(TailConfig.header_mode, 1) ThenBlock: {
            TailConfig.headers = 0
        } ElseBlock: {
            IfCondition EqualTo(TailConfig.header_mode, 2) ThenBlock: {
                TailConfig.headers = 1
            } ElseBlock: {
                IfCondition GreaterThan(TailConfig.file_count, 1) ThenBlock: {
                    TailConfig.headers = 1
                }
            }
        }
        IfCondition EqualTo(TailConfig.follow, 2) ThenBlock: {
            one = 1
            i = 0
            WhileLoop LessThan(i, TailConfig.file_count) {
                nm = RDMEM_64(TailConfig.names, Multiply(i, 8))
                dash = And(EqualTo(RDMEM_8(nm, 0), 45), EqualTo(RDMEM_8(nm, 1), 0))
                IfCondition EqualTo(dash, 1) ThenBlock: {
                    WriteOut(2, "tail: cannot follow '-' by name\n")
                    SystemCall(60, 1)
                }
                i = Add(i, one)
            }
        }
    }
}
Function.ParseArgs {
    Body: {
        buf = GetArgs()
        IfCondition EqualTo(buf, 0) ThenBlock: {
            SystemCall(60, 1)
        }
        one = 1
        pos = 0
        WhileLoop And(LessThan(pos, TailConfig.nread), NotEqual(RDMEM_8(buf, pos), 0)) {
            pos = Add(pos, one)
        }
        IfCondition LessThan(pos, TailConfig.nread) ThenBlock: {
            pos = Add(pos, one)
        }
        offs = Allocate(1024)
        TailConfig.offs = offs
        nuser = 0
        WhileLoop And(LessThan(pos, TailConfig.nread), LessThan(nuser, 128)) {
            WRMEM_64(offs, Multiply(nuser, 8), pos)
            nuser = Add(nuser, one)
            WhileLoop And(LessThan(pos, TailConfig.nread), NotEqual(RDMEM_8(buf, pos), 0)) {
                pos = Add(pos, one)
            }
            IfCondition LessThan(pos, TailConfig.nread) ThenBlock: {
                pos = Add(pos, one)
            }
        }
        TailConfig.argn = nuser
        TailConfig.names = Allocate(512)
        shape = 0
        IfCondition EqualTo(nuser, 1) ThenBlock: {
            shape = 1
        }
        IfCondition EqualTo(nuser, 2) ThenBlock: {
            o1 = RDMEM_64(offs, 8)
            b0 = RDMEM_8(buf, o1)
            b1 = RDMEM_8(buf, Add(o1, 1))
            optish = And(EqualTo(b0, 45), NotEqual(b1, 0))
            IfCondition EqualTo(optish, 0) ThenBlock: {
                shape = 1
            }
            IfCondition And(EqualTo(b0, 45), EqualTo(b1, 45)) ThenBlock: {
                IfCondition EqualTo(RDMEM_8(buf, Add(o1, 2)), 0) ThenBlock: {
                    shape = 1
                }
            }
        }
        IfCondition EqualTo(nuser, 3) ThenBlock: {
            o1 = RDMEM_64(offs, 8)
            IfCondition EqualTo(RDMEM_8(buf, o1), 45) ThenBlock: {
                IfCondition EqualTo(RDMEM_8(buf, Add(o1, 1)), 45) ThenBlock: {
                    IfCondition EqualTo(RDMEM_8(buf, Add(o1, 2)), 0) ThenBlock: {
                        shape = 1
                    }
                }
            }
        }
        used = 0
        IfCondition EqualTo(shape, 1) ThenBlock: {
            o0 = RDMEM_64(offs, 0)
            used = TryObsolete(Add(buf, o0))
        }
        IfCondition EqualTo(used, 1) ThenBlock: {
            IfCondition EqualTo(nuser, 2) ThenBlock: {
                o1 = RDMEM_64(offs, 8)
                b0 = RDMEM_8(buf, o1)
                b1 = RDMEM_8(buf, Add(o1, 1))
                isdd = And(EqualTo(b0, 45), EqualTo(b1, 45))
                IfCondition EqualTo(isdd, 0) ThenBlock: {
                    nm = CopyArg(buf, o1)
                    AddFile(nm)
                }
                IfCondition EqualTo(isdd, 1) ThenBlock: {
                    IfCondition NotEqual(RDMEM_8(buf, Add(o1, 2)), 0) ThenBlock: {
                        nm = CopyArg(buf, o1)
                        AddFile(nm)
                    }
                }
            }
            IfCondition EqualTo(nuser, 3) ThenBlock: {
                o2 = RDMEM_64(offs, 16)
                nm = CopyArg(buf, o2)
                AddFile(nm)
            }
            Deallocate(buf, 8192)
            FinishParse()
            ReturnValue(0)
        }
        ai = 0
        done = 0
        WhileLoop LessThan(ai, nuser) {
            off = RDMEM_64(offs, Multiply(ai, 8))
            arg = Add(buf, off)
            b0 = RDMEM_8(arg, 0)
            b1 = RDMEM_8(arg, 1)
            IfCondition EqualTo(done, 1) ThenBlock: {
                nm = CopyArg(buf, off)
                AddFile(nm)
            } ElseBlock: {
                isopt = And(EqualTo(b0, 45), NotEqual(b1, 0))
                IfCondition EqualTo(isopt, 0) ThenBlock: {
                    nm = CopyArg(buf, off)
                    AddFile(nm)
                } ElseBlock: {
                    IfCondition EqualTo(b1, 45) ThenBlock: {
                        IfCondition EqualTo(RDMEM_8(arg, 2), 0) ThenBlock: {
                            done = 1
                        } ElseBlock: {
                            TailNum.extra = ai
                            ParseLong(buf, arg)
                            ai = TailNum.extra
                        }
                    } ElseBlock: {
                        TailNum.extra = ai
                        ParseShort(buf, arg)
                        ai = TailNum.extra
                    }
                }
            }
            ai = Add(ai, one)
        }
        Deallocate(buf, 8192)
        FinishParse()
    }
}
