// tail.ailang - GNU tail. Pools and Main only.
LibraryImport.Arena
LibraryImport.AiLang_CoreUtils.dist.tail_util.TailParse
LibraryImport.AiLang_CoreUtils.dist.tail_util.TailFollow
LibraryImport.AiLang_CoreUtils.dist.tail_util.TailInotify
FixedPool.TailConfig {
    "count": Initialize=10
    "use_bytes": Initialize=0
    "from_start": Initialize=0
    "follow": Initialize=0
    "retry": Initialize=0
    "sleep_sec": Initialize=1
    "sleep_nsec": Initialize=0
    "file_count": Initialize=0
    "delim": Initialize=10
    "headers": Initialize=0
    "header_mode": Initialize=0
    "pid": Initialize=0
    "errors": Initialize=0
    "stop": Initialize=0
    "names": Initialize=0
    "files": Initialize=0
    "offs": Initialize=0
    "argn": Initialize=0
    "nread": Initialize=0
    "read_stdin": Initialize=0
    "first_header": Initialize=1
    "max_same": Initialize=5
    "presume": Initialize=0
    "last_idx": Initialize=0
    "no_ino": Initialize=0
    "iwatch": Initialize=0
    "ino_fd": Initialize=-1
    "ino_dead": Initialize=0
}
FixedPool.TailNum {
    "val": Initialize=0
    "bad": Initialize=0
    "extra": Initialize=0
}
Function.Start {
    Body: {
        ParseArgs()
        RunFiles()
        SystemCall(60, TailConfig.errors)
    }
}
SubRoutine.Main {
    Start()
}
RunTask(Main)
