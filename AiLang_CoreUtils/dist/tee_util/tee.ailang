// tee.ailang - Copy stdin to stdout and files. GNU output-error modes.

LibraryImport.Arena

FixedPool.TeeOpt {
    "mode": Initialize=0
    "append": Initialize=0
    "bad": Initialize=0
    "nread": Initialize=0
    "pos": Initialize=0
    "opts": Initialize=1
    "nfiles": Initialize=0
    "alive": Initialize=1
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.Eq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 40) {
            ca = RDMEM_8(a, i)
            cb = RDMEM_8(b, i)
            IfCondition NotEqual(ca, cb) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(ca, 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.IgnorePipe {
    Body: {
        act = Allocate(152)
        i = 0
        WhileLoop LessThan(i, 152) {
            WRMEM_8(act, i, 0)
            i = Add(i, 1)
        }
        WRMEM_8(act, 0, 1)
        SystemCall(13, 13, act, 0, 8)
        Deallocate(act, 152)
        ReturnValue(0)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buffer = Allocate(4096)
        nread = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        IfCondition LessEqual(nread, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        TeeOpt.nread = nread
        ReturnValue(buffer)
    }
}

Function.FailOut {
    Input: name: Address
    Input: rc: Integer
    Output: Integer
    Body: {
        err = 0
        IfCondition LessThan(rc, 0) ThenBlock: {
            err = Subtract(0, rc)
        }
        epipe = 0
        IfCondition EqualTo(err, 32) ThenBlock: {
            epipe = 1
        }
        report = 1
        IfCondition EqualTo(epipe, 1) ThenBlock: {
            IfCondition EqualTo(TeeOpt.mode, 1) ThenBlock: {
                report = 0
            }
            IfCondition EqualTo(TeeOpt.mode, 4) ThenBlock: {
                report = 0
            }
        }
        IfCondition EqualTo(report, 1) ThenBlock: {
            WriteStderr("tee: ")
            WriteStderr(name)
            WriteStderr(": write error\n")
            TeeOpt.bad = 1
            IfCondition EqualTo(TeeOpt.mode, 3) ThenBlock: {
                SystemCall(60, 1)
            }
            IfCondition EqualTo(TeeOpt.mode, 4) ThenBlock: {
                SystemCall(60, 1)
            }
        }
        ReturnValue(1)
    }
}

Function.WaitOut {
    Input: fd: Integer
    Body: {
        pfd = Allocate(8)
        i = 0
        one = 1
        WhileLoop LessThan(i, 8) {
            WRMEM_8(pfd, i, 0)
            i = Add(i, one)
        }
        b0 = Modulo(fd, 256)
        rest = Divide(fd, 256)
        b1 = Modulo(rest, 256)
        rest = Divide(rest, 256)
        b2 = Modulo(rest, 256)
        b3 = Divide(rest, 256)
        WRMEM_8(pfd, 0, b0)
        WRMEM_8(pfd, 1, b1)
        WRMEM_8(pfd, 2, b2)
        WRMEM_8(pfd, 3, b3)
        WRMEM_8(pfd, 4, 4)
        SystemCall(7, pfd, 1, 200)
        Deallocate(pfd, 8)
        ReturnValue(0)
    }
}
Function.WriteAll {
    Input: fd: Integer
    Input: name: Address
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        left = n
        off = 0
        WhileLoop GreaterThan(left, 0) {
            wr = SystemCall(1, fd, Add(buf, off), left)
            IfCondition EqualTo(wr, -11) ThenBlock: {
                WaitOut(fd)
            } ElseBlock: {
                IfCondition LessEqual(wr, 0) ThenBlock: {
                    dropped = FailOut(name, wr)
                    ReturnValue(dropped)
                }
                left = Subtract(left, wr)
                off = Add(off, wr)
            }
        }
        ReturnValue(0)
    }
}

Function.PollWait {
    Output: Integer
    Body: {
        pfd = Allocate(16)
        i = 0
        WhileLoop LessThan(i, 16) {
            WRMEM_8(pfd, i, 0)
            i = Add(i, 1)
        }
        WRMEM_8(pfd, 4, 1)
        WRMEM_8(pfd, 8, 1)
        WRMEM_8(pfd, 12, 24)
        SystemCall(7, pfd, 2, 200)
        rev = RDMEM_8(pfd, 14)
        sin = RDMEM_8(pfd, 6)
        Deallocate(pfd, 16)
        IfCondition NotEqual(sin, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(rev, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(2)
    }
}

SubRoutine.Main {
    args = GetArgs()
    IfCondition EqualTo(args, 0) ThenBlock: {
        SystemCall(60, 1)
    }
    fds = Allocate(800)
    names = Allocate(800)
    TeeOpt.pos = 0
    WhileLoop NotEqual(RDMEM_8(args, TeeOpt.pos), 0) {
        TeeOpt.pos = Add(TeeOpt.pos, 1)
    }
    TeeOpt.pos = Add(TeeOpt.pos, 1)
    limit = Subtract(TeeOpt.nread, 1)
    WRMEM_64(fds, 1)
    WRMEM_64(names, "standard output")
    TeeOpt.nfiles = 1
    WhileLoop LessThan(TeeOpt.pos, limit) {
        ch = RDMEM_8(args, TeeOpt.pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            TeeOpt.pos = Add(TeeOpt.pos, 1)
        } ElseBlock: {
            arg = Add(args, TeeOpt.pos)
            WhileLoop NotEqual(RDMEM_8(args, TeeOpt.pos), 0) {
                TeeOpt.pos = Add(TeeOpt.pos, 1)
            }
            TeeOpt.pos = Add(TeeOpt.pos, 1)
            use = 1
            IfCondition EqualTo(TeeOpt.opts, 1) ThenBlock: {
                IfCondition EqualTo(RDMEM_8(arg, 0), 45) ThenBlock: {
                    IfCondition NotEqual(RDMEM_8(arg, 1), 0) ThenBlock: {
                        use = 0
                        IfCondition And(EqualTo(RDMEM_8(arg, 1), 45), EqualTo(RDMEM_8(arg, 2), 0)) ThenBlock: {
                            TeeOpt.opts = 0
                        } ElseBlock: {
                            IfCondition Eq(arg, "-a") ThenBlock: {
                                TeeOpt.append = 1
                            } ElseBlock: {
                                IfCondition Eq(arg, "-p") ThenBlock: {
                                    TeeOpt.mode = 1
                                } ElseBlock: {
                                    IfCondition Eq(arg, "--output-error=warn") ThenBlock: {
                                        TeeOpt.mode = 2
                                    } ElseBlock: {
                                        IfCondition Eq(arg, "--output-error=warn-nopipe") ThenBlock: {
                                            TeeOpt.mode = 1
                                        } ElseBlock: {
                                            IfCondition Eq(arg, "--output-error=exit") ThenBlock: {
                                                TeeOpt.mode = 3
                                            } ElseBlock: {
                                                IfCondition Eq(arg, "--output-error=exit-nopipe") ThenBlock: {
                                                    TeeOpt.mode = 4
                                                } ElseBlock: {
                                                    TeeOpt.bad = 1
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(use, 1) ThenBlock: {
                flags = 577
                IfCondition EqualTo(TeeOpt.append, 1) ThenBlock: {
                    flags = 1089
                }
                fd = SystemCall(2, arg, flags, 420)
                IfCondition LessThan(fd, 0) ThenBlock: {
                    WriteStderr("tee: ")
                    WriteStderr(arg)
                    WriteStderr(": cannot open for writing\n")
                    TeeOpt.bad = 1
                    IfCondition EqualTo(TeeOpt.mode, 3) ThenBlock: {
                        SystemCall(60, 1)
                    }
                    IfCondition EqualTo(TeeOpt.mode, 4) ThenBlock: {
                        SystemCall(60, 1)
                    }
                } ElseBlock: {
                    WRMEM_64(fds, Multiply(TeeOpt.nfiles, 8), fd)
                    WRMEM_64(names, Multiply(TeeOpt.nfiles, 8), arg)
                    TeeOpt.nfiles = Add(TeeOpt.nfiles, 1)
                    TeeOpt.alive = Add(TeeOpt.alive, 1)
                }
            }
        }
    }
    IfCondition NotEqual(TeeOpt.mode, 0) ThenBlock: {
        IgnorePipe()
    }
    buf = Allocate(65536)
    WhileLoop GreaterThan(TeeOpt.alive, 0) {
        IfCondition Or(EqualTo(TeeOpt.mode, 1), EqualTo(TeeOpt.mode, 4)) ThenBlock: {
            kind = PollWait()
            IfCondition EqualTo(kind, 1) ThenBlock: {
                dropped = FailOut("standard output", -32)
                IfCondition EqualTo(dropped, 1) ThenBlock: {
                    WRMEM_64(fds, 0)
                    TeeOpt.alive = Subtract(TeeOpt.alive, 1)
                }
            }
        }
        IfCondition LessEqual(TeeOpt.alive, 0) ThenBlock: {
            BreakLoop
        }
        n = SystemCall(0, 0, buf, 65536)
        IfCondition LessEqual(n, 0) ThenBlock: {
            BreakLoop
        }
        i = 0
        WhileLoop LessThan(i, TeeOpt.nfiles) {
            fd = RDMEM_64(fds, Multiply(i, 8))
            IfCondition GreaterThan(fd, 0) ThenBlock: {
                name = RDMEM_64(names, Multiply(i, 8))
                drop = WriteAll(fd, name, buf, n)
                IfCondition EqualTo(drop, 1) ThenBlock: {
                    WRMEM_64(fds, Multiply(i, 8), 0)
                    TeeOpt.alive = Subtract(TeeOpt.alive, 1)
                }
            }
            i = Add(i, 1)
        }
    }
    code = 0
    IfCondition EqualTo(TeeOpt.bad, 1) ThenBlock: {
        code = 1
    }
    SystemCall(60, code)
}

RunTask(Main)
