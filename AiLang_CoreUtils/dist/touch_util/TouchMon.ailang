// `YYYY-MM-DD +N month` for ls abmon-align. No pool. No Main.
LibraryImport.Arena

Function.HasWord {
    Input: text: Address
    Input: i: Integer
    Output: Integer
    Body: {
        c0 = GetByte(text, i)
        IfCondition EqualTo(c0, 0) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        IfCondition EqualTo(c0, 109) ThenBlock: {
            c1 = GetByte(text, Add(i, one))
            two = 2
            c2 = GetByte(text, Add(i, two))
            three = 3
            c3 = GetByte(text, Add(i, three))
            four = 4
            c4 = GetByte(text, Add(i, four))
            IfCondition EqualTo(c1, 111) ThenBlock: {
                IfCondition EqualTo(c2, 110) ThenBlock: {
                    IfCondition EqualTo(c3, 116) ThenBlock: {
                        IfCondition EqualTo(c4, 104) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                }
            }
        }
        nxt = Add(i, one)
        hit = HasWord(text, nxt)
        ReturnValue(hit)
    }
}
Function.ReadNum {
    Input: text: Address
    Input: i: Integer
    Input: acc: Integer
    Output: Integer
    Body: {
        ch = GetByte(text, i)
        d = Digit(ch)
        IfCondition LessThan(d, 0) ThenBlock: {
            ReturnValue(acc)
        }
        acc2 = Add(Multiply(acc, 10), d)
        one = 1
        nxt = Add(i, one)
        hit = ReadNum(text, nxt, acc2)
        ReturnValue(hit)
    }
}
Function.BumpMon {
    Input: year: Integer
    Input: month: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: {
            packed = Add(Multiply(year, 16), month)
            ReturnValue(packed)
        }
        one = 1
        n2 = Subtract(n, one)
        IfCondition EqualTo(month, 12) ThenBlock: {
            y2 = Add(year, one)
            hit = BumpMon(y2, 1, n2)
            ReturnValue(hit)
        }
        m2 = Add(month, one)
        hit = BumpMon(year, m2, n2)
        ReturnValue(hit)
    }
}
Function.ApplyMonthTail {
    Input: text: Address
    Input: year: Integer
    Input: month: Integer
    Input: day: Integer
    Output: Integer
    Body: {
        hit = HasWord(text, 0)
        IfCondition EqualTo(hit, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = ReadNum(text, 12, 0)
        packed = BumpMon(year, month, n)
        y = Divide(packed, 16)
        m = Modulo(packed, 16)
        days = DaysFromCivil(y, m, day)
        sec = Multiply(days, 86400)
        TouchOpt.date_sec = sec
        TouchWork.leap = 0
        TouchWork.explicit = 0
        ApplyZone()
        ReturnValue(1)
    }
}
