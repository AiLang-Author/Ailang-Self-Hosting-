// `YYYY-MM-DD +N month` for ls abmon-align. No pool. No Main.
LibraryImport.Arena

Function.HasWord {
    Input: text: Address
    Input: i: Integer
    Output: Integer
    Body: {
        c0 = RDMEM_8(text, i)
        IfCondition EqualTo(c0, 0) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        IfCondition EqualTo(c0, 109) ThenBlock: {
            c1 = RDMEM_8(text, Add(i, one))
            two = 2
            c2 = RDMEM_8(text, Add(i, two))
            three = 3
            c3 = RDMEM_8(text, Add(i, three))
            four = 4
            c4 = RDMEM_8(text, Add(i, four))
            IfCondition EqualTo(c1, 111) ThenBlock: {
                IfCondition EqualTo(c2, 110) ThenBlock: {
                    IfCondition EqualTo(c3, 116) ThenBlock: {
                        IfCondition EqualTo(c4, 104) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                }
            }
        }
        nxt = Add(i, one)
        hit = HasWord(text, nxt)
        ReturnValue(hit)
    }
}
Function.ReadNum {
    Input: text: Address
    Input: i: Integer
    Input: acc: Integer
    Output: Integer
    Body: {
        ch = RDMEM_8(text, i)
        d = Digit(ch)
        IfCondition LessThan(d, 0) ThenBlock: {
            ReturnValue(acc)
        }
        acc2 = Add(Multiply(acc, 10), d)
        one = 1
        nxt = Add(i, one)
        hit = ReadNum(text, nxt, acc2)
        ReturnValue(hit)
    }
}
Function.BumpMon {
    Input: year: Integer
    Input: month: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: {
            packed = Add(Multiply(year, 16), month)
            ReturnValue(packed)
        }
        one = 1
        n2 = Subtract(n, one)
        IfCondition EqualTo(month, 12) ThenBlock: {
            y2 = Add(year, one)
            hit = BumpMon(y2, 1, n2)
            ReturnValue(hit)
        }
        m2 = Add(month, one)
        hit = BumpMon(year, m2, n2)
        ReturnValue(hit)
    }
}
Function.ApplyMonthTail {
    Input: text: Address
    Input: year: Integer
    Input: month: Integer
    Input: day: Integer
    Output: Integer
    Body: {
        hit = HasWord(text, 0)
        IfCondition EqualTo(hit, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = ReadNum(text, 12, 0)
        packed = BumpMon(year, month, n)
        y = Divide(packed, 16)
        m = Modulo(packed, 16)
        days = DaysFromCivil(y, m, day)
        sec = Multiply(days, 86400)
        TouchOpt.date_sec = sec
        TouchWork.leap = 0
        TouchWork.explicit = 0
        ApplyZone()
        ReturnValue(1)
    }
}
Function.SkipSp {
    Input: text: Address
    Input: i: Integer
    Output: Integer
    Body: {
        c = RDMEM_8(text, i)
        IfCondition NotEqual(c, 32) ThenBlock: {
            ReturnValue(i)
        }
        one = 1
        nxt = Add(i, one)
        hit = SkipSp(text, nxt)
        ReturnValue(hit)
    }
}
Function.IsToday {
    Input: text: Address
    Input: i: Integer
    Output: Integer
    Body: {
        one = 1
        two = 2
        three = 3
        four = 4
        c0 = RDMEM_8(text, i)
        c1 = RDMEM_8(text, Add(i, one))
        c2 = RDMEM_8(text, Add(i, two))
        c3 = RDMEM_8(text, Add(i, three))
        c4 = RDMEM_8(text, Add(i, four))
        IfCondition NotEqual(c0, 116) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(c1, 111) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(c2, 100) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(c3, 97) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(c4, 121) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}
Function.SpanDigits {
    Input: text: Address
    Input: i: Integer
    Output: Integer
    Body: {
        d = Digit(RDMEM_8(text, i))
        IfCondition LessThan(d, 0) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        rest = SpanDigits(text, Add(i, one))
        n = Add(rest, one)
        ReturnValue(n)
    }
}
Function.IsDayWord {
    Input: text: Address
    Input: i: Integer
    Output: Integer
    Body: {
        one = 1
        two = 2
        three = 3
        four = 4
        c0 = RDMEM_8(text, i)
        c1 = RDMEM_8(text, Add(i, one))
        c2 = RDMEM_8(text, Add(i, two))
        IfCondition NotEqual(c0, 100) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(c1, 97) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(c2, 121) ThenBlock: { ReturnValue(0) }
        c3 = RDMEM_8(text, Add(i, three))
        IfCondition EqualTo(c3, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c3, 32) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(c3, 115) ThenBlock: { ReturnValue(0) }
        c4 = RDMEM_8(text, Add(i, four))
        IfCondition EqualTo(c4, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c4, 32) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}
Function.ApplyClockRel {
    Input: text: Address
    Output: Integer
    Body: {
        h0 = Digit(RDMEM_8(text, 0))
        h1 = Digit(RDMEM_8(text, 1))
        colon = RDMEM_8(text, 2)
        m0 = Digit(RDMEM_8(text, 3))
        m1 = Digit(RDMEM_8(text, 4))
        IfCondition LessThan(h0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(h1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(colon, 58) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(m0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(m1, 0) ThenBlock: { ReturnValue(0) }
        hour = Add(Multiply(h0, 10), h1)
        minute = Add(Multiply(m0, 10), m1)
        IfCondition GreaterThan(hour, 23) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(minute, 59) ThenBlock: { ReturnValue(0) }
        sp = SkipSp(text, 5)
        today = IsToday(text, sp)
        IfCondition EqualTo(today, 0) ThenBlock: { ReturnValue(0) }
        five = 5
        after = Add(sp, five)
        sp2 = SkipSp(text, after)
        c = RDMEM_8(text, sp2)
        sign = 1
        num_at = sp2
        one = 1
        IfCondition EqualTo(c, 45) ThenBlock: {
            sign = Subtract(0, 1)
            num_at = Add(sp2, one)
        }
        IfCondition EqualTo(c, 43) ThenBlock: {
            num_at = Add(sp2, one)
        }
        span = SpanDigits(text, num_at)
        days = 0
        IfCondition GreaterThan(span, 0) ThenBlock: {
            n = ReadNum(text, num_at, 0)
            word_at = Add(num_at, span)
            sp3 = SkipSp(text, word_at)
            dayw = IsDayWord(text, sp3)
            IfCondition EqualTo(dayw, 0) ThenBlock: { ReturnValue(0) }
            days = n
            IfCondition LessThan(sign, 0) ThenBlock: {
                days = Subtract(0, n)
            }
        } ElseBlock: {
            IfCondition NotEqual(c, 0) ThenBlock: { ReturnValue(0) }
        }
        now = NowSec()
        off = 0
        IfCondition EqualTo(TouchOpt.tz_utc, 0) ThenBlock: {
            off = ZoneOffset(now)
        }
        local = Add(now, off)
        day0 = Divide(local, 86400)
        day1 = Add(day0, days)
        sec = Multiply(day1, 86400)
        sec = Add(sec, Multiply(hour, 3600))
        sec = Add(sec, Multiply(minute, 60))
        TouchOpt.date_sec = sec
        TouchWork.leap = 0
        TouchWork.explicit = 0
        ApplyZone()
        ReturnValue(1)
    }
}
