// touch.ailang - Create empty file or update timestamp.
// GNU 9.4: -a -m -c -h -f -d -r -t, --reference, obsolescent MMDDhhmm,
// UTIME_NOW/NULL stamps, and cannot-touch versus setting-times errors.
LibraryImport.Arena
LibraryImport.AiLang_CoreUtils.dist.touch_util.TouchMon
FixedPool.TouchOpt {
    "atime": Initialize=0
    "mtime": Initialize=0
    "nofollow": Initialize=0
    "nocreate": Initialize=0
    "have_date": Initialize=0
    "date_sec": Initialize=0
    "mt_sec": Initialize=0
    "at_nsec": Initialize=0
    "mt_nsec": Initialize=0
    "date_ok": Initialize=0
    "want": Initialize=0
    "idx": Initialize=0
    "fail": Initialize=0
    "saw_d": Initialize=0
    "saw_t": Initialize=0
    "use_ref": Initialize=0
    "posix2": Initialize=200809
    "tz_utc": Initialize=0
    "base_sec": Initialize=0
    "rel": Initialize=0
    "am_now": Initialize=0
    "year": Initialize=0
    "month": Initialize=0
    "day": Initialize=0
    "date_text": Initialize=0
    "ref_text": Initialize=0
    "t_text": Initialize=0
}
FixedPool.TouchWork {
    "best": Initialize=-1
    "open_err": Initialize=0
    "explicit": Initialize=0
    "off": Initialize=0
    "leap": Initialize=0
    "bad": Initialize=0
}
Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}
Function.GetUInt32 {
    Input: addr: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        ptr = Add(addr, offset)
        b0 = GetByte(ptr, 0)
        b1 = GetByte(ptr, 1)
        b2 = GetByte(ptr, 2)
        b3 = GetByte(ptr, 3)
        value = Add(b0, Multiply(b1, 256))
        value = Add(value, Multiply(b2, 65536))
        value = Add(value, Multiply(b3, 16777216))
        ReturnValue(value)
    }
}
Function.GetUInt64 {
    Input: addr: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        lo = GetUInt32(addr, offset)
        hi_at = Add(offset, 4)
        hi = GetUInt32(addr, hi_at)
        value = Add(lo, Multiply(hi, 4294967296))
        ReturnValue(value)
    }
}
Function.StoreU32 {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Body: {
        b0 = BitwiseAnd(val, 255)
        b1 = BitwiseAnd(RightShift(val, 8), 255)
        b2 = BitwiseAnd(RightShift(val, 16), 255)
        b3 = BitwiseAnd(RightShift(val, 24), 255)
        SetByte(buf, off, b0)
        o1 = Add(off, 1)
        SetByte(buf, o1, b1)
        o2 = Add(off, 2)
        SetByte(buf, o2, b2)
        o3 = Add(off, 3)
        SetByte(buf, o3, b3)
    }
}
Function.StoreU64 {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Body: {
        StoreU32(buf, off, val)
        hi_at = Add(off, 4)
        StoreU32(buf, hi_at, 0)
    }
}
Function.Be32 {
    Input: buf: Address
    Input: off: Integer
    Output: Integer
    Body: {
        b0 = GetByte(buf, off)
        o1 = Add(off, 1)
        b1 = GetByte(buf, o1)
        o2 = Add(off, 2)
        b2 = GetByte(buf, o2)
        o3 = Add(off, 3)
        b3 = GetByte(buf, o3)
        v = Multiply(b0, 16777216)
        v = Add(v, Multiply(b1, 65536))
        v = Add(v, Multiply(b2, 256))
        v = Add(v, b3)
        IfCondition GreaterEqual(v, 2147483648) ThenBlock: {
            v = Subtract(v, 4294967296)
        }
        ReturnValue(v)
    }
}
Function.ZoneOffset {
    Input: unix_sec: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, "/etc/localtime", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf = Allocate(8192)
        nread = SystemCall(0, fd, buf, 8192)
        SystemCall(3, fd)
        IfCondition LessThan(nread, 44) ThenBlock: {
            Deallocate(buf, 8192)
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(buf, 0), 84) ThenBlock: {
            Deallocate(buf, 8192)
            ReturnValue(0)
        }
        timecnt = Be32(buf, 32)
        typecnt = Be32(buf, 36)
        IfCondition LessEqual(timecnt, 0) ThenBlock: {
            Deallocate(buf, 8192)
            ReturnValue(0)
        }
        IfCondition LessEqual(typecnt, 0) ThenBlock: {
            Deallocate(buf, 8192)
            ReturnValue(0)
        }
        need = Add(44, Multiply(timecnt, 5))
        need = Add(need, Multiply(typecnt, 6))
        IfCondition GreaterThan(need, nread) ThenBlock: {
            Deallocate(buf, 8192)
            ReturnValue(0)
        }
        TouchWork.best = -1
        i = 0
        WhileLoop LessThan(i, timecnt) {
            toff = Add(44, Multiply(i, 4))
            trans = Be32(buf, toff)
            IfCondition LessEqual(trans, unix_sec) ThenBlock: {
                TouchWork.best = i
            }
            i = Add(i, 1)
        }
        idxbase = Add(44, Multiply(timecnt, 4))
        ti = 0
        IfCondition GreaterEqual(TouchWork.best, 0) ThenBlock: {
            ip = Add(idxbase, TouchWork.best)
            ti = GetByte(buf, ip)
        }
        typebase = Add(idxbase, timecnt)
        gmoff = Multiply(ti, 6)
        gmoff = Add(typebase, gmoff)
        gm = Be32(buf, gmoff)
        Deallocate(buf, 8192)
        ReturnValue(gm)
    }
}
Function.NowSec {
    Output: Integer
    Body: {
        buf = Allocate(16)
        got = SystemCall(228, 0, buf)
        IfCondition LessThan(got, 0) ThenBlock: {
            Deallocate(buf, 16)
            ReturnValue(0)
        }
        sec = GetUInt64(buf, 0)
        Deallocate(buf, 16)
        ReturnValue(sec)
    }
}
Function.DaysFromCivil {
    Input: year: Integer
    Input: month: Integer
    Input: day: Integer
    Output: Integer
    Body: {
        yy = year
        IfCondition LessEqual(month, 2) ThenBlock: {
            yy = Subtract(year, 1)
        }
        era = Divide(yy, 400)
        yoe = Multiply(era, 400)
        yoe = Subtract(yy, yoe)
        madd = 9
        IfCondition GreaterThan(month, 2) ThenBlock: {
            madd = Subtract(0, 3)
        }
        mp = Add(month, madd)
        doy = Multiply(153, mp)
        doy = Add(doy, 2)
        doy = Divide(doy, 5)
        doy = Add(doy, day)
        doy = Subtract(doy, 1)
        doe = Multiply(yoe, 365)
        doe = Add(doe, Divide(yoe, 4))
        doe = Subtract(doe, Divide(yoe, 100))
        doe = Add(doe, doy)
        days = Multiply(era, 146097)
        days = Add(days, doe)
        days = Subtract(days, 719468)
        ReturnValue(days)
    }
}
Function.Digit {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(ch, 48) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition GreaterThan(ch, 57) ThenBlock: {
            ReturnValue(-1)
        }
        v = Subtract(ch, 48)
        ReturnValue(v)
    }
}
Function.ApplyZone {
    Body: {
        sec = TouchOpt.date_sec
        off = 0
        IfCondition EqualTo(TouchWork.explicit, 1) ThenBlock: {
            off = TouchWork.off
        } ElseBlock: {
            IfCondition EqualTo(TouchOpt.tz_utc, 0) ThenBlock: {
                off = ZoneOffset(sec)
                guess = Subtract(sec, off)
                off = ZoneOffset(guess)
            }
        }
        unix = Subtract(sec, off)
        TouchOpt.date_sec = unix
        TouchOpt.mt_sec = unix
        TouchOpt.at_nsec = 0
        TouchOpt.mt_nsec = 0
        TouchWork.explicit = 0
        TouchOpt.date_ok = 1
    }
}
Function.ParseAbsolute {
    Input: text: Address
    Body: {
        d0 = Digit(GetByte(text, 0))
        d1 = Digit(GetByte(text, 1))
        d2 = Digit(GetByte(text, 2))
        d3 = Digit(GetByte(text, 3))
        IfCondition LessThan(d0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(d1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(d2, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(d3, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(text, 4), 45) ThenBlock: { ReturnValue(0) }
        m0 = Digit(GetByte(text, 5))
        m1 = Digit(GetByte(text, 6))
        IfCondition LessThan(m0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(m1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(text, 7), 45) ThenBlock: { ReturnValue(0) }
        y0 = Digit(GetByte(text, 8))
        y1 = Digit(GetByte(text, 9))
        IfCondition LessThan(y0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(y1, 0) ThenBlock: { ReturnValue(0) }
        year = Multiply(d0, 1000)
        year = Add(year, Multiply(d1, 100))
        year = Add(year, Multiply(d2, 10))
        year = Add(year, d3)
        month = Add(Multiply(m0, 10), m1)
        day = Add(Multiply(y0, 10), y1)
        hour = 0
        minute = 0
        second = 0
        TouchOpt.idx = 10
        TouchWork.explicit = 0
        sep = GetByte(text, 10)
        IfCondition NotEqual(sep, 0) ThenBlock: {
            timed = 0
            IfCondition EqualTo(sep, 32) ThenBlock: { timed = 1 }
            IfCondition EqualTo(sep, 84) ThenBlock: { timed = 1 }
            IfCondition EqualTo(timed, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(sep, 32) ThenBlock: {
                plusb = GetByte(text, 11)
                IfCondition EqualTo(plusb, 43) ThenBlock: {
                    took = ApplyMonthTail(text, year, month, day)
                    IfCondition EqualTo(took, 1) ThenBlock: {
                        ReturnValue(0)
                    }
                }
            }
            h0 = Digit(GetByte(text, 11))
            h1 = Digit(GetByte(text, 12))
            IfCondition LessThan(h0, 0) ThenBlock: { ReturnValue(0) }
            IfCondition LessThan(h1, 0) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(GetByte(text, 13), 58) ThenBlock: { ReturnValue(0) }
            n0 = Digit(GetByte(text, 14))
            n1 = Digit(GetByte(text, 15))
            IfCondition LessThan(n0, 0) ThenBlock: { ReturnValue(0) }
            IfCondition LessThan(n1, 0) ThenBlock: { ReturnValue(0) }
            hour = Add(Multiply(h0, 10), h1)
            minute = Add(Multiply(n0, 10), n1)
            TouchOpt.idx = 16
            IfCondition EqualTo(GetByte(text, 16), 58) ThenBlock: {
                s0 = Digit(GetByte(text, 17))
                s1 = Digit(GetByte(text, 18))
                IfCondition LessThan(s0, 0) ThenBlock: { ReturnValue(0) }
                IfCondition LessThan(s1, 0) ThenBlock: { ReturnValue(0) }
                second = Add(Multiply(s0, 10), s1)
                TouchOpt.idx = 19
            }
        }
        step = 1
        WhileLoop EqualTo(GetByte(text, TouchOpt.idx), 32) {
            TouchOpt.idx = Add(TouchOpt.idx, step)
        }
        zch = GetByte(text, TouchOpt.idx)
        IfCondition NotEqual(zch, 0) ThenBlock: {
            zsign = 0
            IfCondition EqualTo(zch, 43) ThenBlock: { zsign = 1 }
            IfCondition EqualTo(zch, 45) ThenBlock: { zsign = -1 }
            IfCondition EqualTo(zsign, 0) ThenBlock: { ReturnValue(0) }
            TouchOpt.idx = Add(TouchOpt.idx, step)
            zh0 = Digit(GetByte(text, TouchOpt.idx))
            TouchOpt.idx = Add(TouchOpt.idx, step)
            zh1 = Digit(GetByte(text, TouchOpt.idx))
            TouchOpt.idx = Add(TouchOpt.idx, step)
            IfCondition LessThan(zh0, 0) ThenBlock: { ReturnValue(0) }
            IfCondition LessThan(zh1, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(GetByte(text, TouchOpt.idx), 58) ThenBlock: {
                TouchOpt.idx = Add(TouchOpt.idx, step)
            }
            zm0 = Digit(GetByte(text, TouchOpt.idx))
            TouchOpt.idx = Add(TouchOpt.idx, step)
            zm1 = Digit(GetByte(text, TouchOpt.idx))
            IfCondition LessThan(zm0, 0) ThenBlock: { ReturnValue(0) }
            IfCondition LessThan(zm1, 0) ThenBlock: { ReturnValue(0) }
            zhh = Add(Multiply(zh0, 10), zh1)
            zmm = Add(Multiply(zm0, 10), zm1)
            zoff = Add(Multiply(zhh, 3600), Multiply(zmm, 60))
            IfCondition LessThan(zsign, 0) ThenBlock: {
                zoff = Subtract(0, zoff)
            }
            TouchWork.off = zoff
            TouchWork.explicit = 1
        }
        days = DaysFromCivil(year, month, day)
        sec = Multiply(days, 86400)
        sec = Add(sec, Multiply(hour, 3600))
        sec = Add(sec, Multiply(minute, 60))
        sec = Add(sec, second)
        TouchOpt.date_sec = sec
        TouchWork.leap = 0
        ApplyZone()
    }
}
Function.ParseRelative {
    Input: text: Address
    Body: {
        yday = WordIs(text, "yesterday", 9)
        IfCondition EqualTo(yday, 1) ThenBlock: {
            base = NowSec()
            stamp = Subtract(base, 86400)
            TouchOpt.date_sec = stamp
            TouchOpt.mt_sec = stamp
            TouchOpt.date_ok = 1
            ReturnValue(0)
        }
        TouchOpt.idx = 0
        sign = 1
        step = 1
        c0 = GetByte(text, 0)
        IfCondition EqualTo(c0, 45) ThenBlock: {
            sign = Subtract(0, 1)
            TouchOpt.idx = step
        }
        IfCondition EqualTo(c0, 43) ThenBlock: {
            TouchOpt.idx = step
        }
        WhileLoop EqualTo(GetByte(text, TouchOpt.idx), 32) {
            TouchOpt.idx = Add(TouchOpt.idx, step)
        }
        n = 0
        saw = 0
        WhileLoop 1 {
            ch = GetByte(text, TouchOpt.idx)
            dig = Digit(ch)
            IfCondition LessThan(dig, 0) ThenBlock: {
                BreakLoop
            }
            n = Multiply(n, 10)
            n = Add(n, dig)
            saw = 1
            TouchOpt.idx = Add(TouchOpt.idx, step)
        }
        IfCondition EqualTo(saw, 0) ThenBlock: {
            ReturnValue(0)
        }
        WhileLoop EqualTo(GetByte(text, TouchOpt.idx), 32) {
            TouchOpt.idx = Add(TouchOpt.idx, step)
        }
        unit = GetByte(text, TouchOpt.idx)
        mult = 0
        IfCondition EqualTo(unit, 104) ThenBlock: { mult = 3600 }
        IfCondition EqualTo(unit, 109) ThenBlock: { mult = 60 }
        IfCondition EqualTo(unit, 115) ThenBlock: { mult = 1 }
        IfCondition EqualTo(unit, 100) ThenBlock: { mult = 86400 }
        IfCondition EqualTo(mult, 0) ThenBlock: {
            ReturnValue(0)
        }
        base = NowSec()
        IfCondition EqualTo(TouchOpt.rel, 1) ThenBlock: {
            base = TouchOpt.base_sec
        }
        delta = Multiply(n, mult)
        stamp = Add(base, delta)
        IfCondition LessThan(sign, 0) ThenBlock: {
            stamp = Subtract(base, delta)
        }
        TouchOpt.date_sec = stamp
        TouchOpt.mt_sec = stamp
        TouchOpt.date_ok = 1
    }
}
Function.ParseDate {
    Input: text: Address
    Body: {
        TouchOpt.date_ok = 0
        mark = GetByte(text, 4)
        IfCondition EqualTo(mark, 45) ThenBlock: {
            ParseAbsolute(text)
            ReturnValue(0)
        }
        ParseRelative(text)
    }
}
Function.CopyFrom {
    Input: base: Address
    Input: at: Integer
    Output: Address
    Body: {
        n = 0
        WhileLoop NotEqual(GetByte(base, Add(at, n)), 0) {
            n = Add(n, 1)
        }
        buf = Allocate(Add(n, 1))
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(buf, i, GetByte(base, Add(at, i)))
            i = Add(i, 1)
        }
        SetByte(buf, n, 0)
        ReturnValue(buf)
    }
}
Function.StartsAt {
    Input: text: Address
    Input: at: Integer
    Input: word: Address
    Input: wlen: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, wlen) {
            ca = Add(at, i)
            c = GetByte(text, ca)
            w = GetByte(word, i)
            IfCondition NotEqual(c, w) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}
Function.WordIs {
    Input: text: Address
    Input: word: Address
    Input: wlen: Integer
    Output: Integer
    Body: {
        hit = StartsAt(text, 0, word, wlen)
        IfCondition EqualTo(hit, 0) ThenBlock: { ReturnValue(0) }
        endb = GetByte(text, wlen)
        IfCondition NotEqual(endb, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}
Function.TakeTime {
    Input: text: Address
    Body: {
        ok = 0
        hit = WordIs(text, "access", 6)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            TouchOpt.atime = 1
            ok = 1
        }
        hit = WordIs(text, "atime", 5)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            TouchOpt.atime = 1
            ok = 1
        }
        hit = WordIs(text, "use", 3)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            TouchOpt.atime = 1
            ok = 1
        }
        hit = WordIs(text, "modify", 6)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            TouchOpt.mtime = 1
            ok = 1
        }
        hit = WordIs(text, "mtime", 5)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            TouchOpt.mtime = 1
            ok = 1
        }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            TouchOpt.fail = 1
            WriteStderr("touch: invalid argument '")
            WriteStderr(text)
            WriteStderr("' for '--time'\n")
        }
    }
}
Function.GetErrorString {
    Input: err: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(err, 1) ThenBlock: { ReturnValue("Operation not permitted") }
        IfCondition EqualTo(err, 2) ThenBlock: { ReturnValue("No such file or directory") }
        IfCondition EqualTo(err, 9) ThenBlock: { ReturnValue("Bad file descriptor") }
        IfCondition EqualTo(err, 13) ThenBlock: { ReturnValue("Permission denied") }
        IfCondition EqualTo(err, 20) ThenBlock: { ReturnValue("Not a directory") }
        IfCondition EqualTo(err, 21) ThenBlock: { ReturnValue("Is a directory") }
        IfCondition EqualTo(err, 22) ThenBlock: { ReturnValue("Invalid argument") }
        IfCondition EqualTo(err, 30) ThenBlock: { ReturnValue("Read-only file system") }
        IfCondition EqualTo(err, 40) ThenBlock: { ReturnValue("Too many levels of symbolic links") }
        ReturnValue("Unknown error")
    }
}
Function.Report {
    Input: kind: Integer
    Input: path: Address
    Input: err: Integer
    Body: {
        msg = GetErrorString(err)
        IfCondition EqualTo(kind, 1) ThenBlock: {
            WriteStderr("touch: cannot touch '")
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            WriteStderr("touch: setting times of '")
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            WriteStderr("touch: failed to get attributes of '")
        }
        WriteStderr(path)
        WriteStderr("': ")
        WriteStderr(msg)
        WriteStderr("\n")
    }
}
Function.IsNow {
    Input: text: Address
    Output: Integer
    Body: {
        c0 = GetByte(text, 0)
        c1 = GetByte(text, 1)
        c2 = GetByte(text, 2)
        c3 = GetByte(text, 3)
        ok = 0
        IfCondition EqualTo(c0, 110) ThenBlock: {
            IfCondition EqualTo(c1, 111) ThenBlock: {
                IfCondition EqualTo(c2, 119) ThenBlock: {
                    IfCondition EqualTo(c3, 0) ThenBlock: {
                        ok = 1
                    }
                }
            }
        }
        ReturnValue(ok)
    }
}
Function.CurrentYear {
    Body: {
        now = NowSec()
        off = 0
        IfCondition EqualTo(TouchOpt.tz_utc, 0) ThenBlock: {
            off = ZoneOffset(now)
        }
        local = Add(now, off)
        days = Divide(local, 86400)
        z = Add(days, 719468)
        era = Divide(z, 146097)
        doe = Modulo(z, 146097)
        part = doe
        part = Subtract(part, Divide(doe, 1460))
        part = Add(part, Divide(doe, 36524))
        part = Subtract(part, Divide(doe, 146096))
        yoe = Divide(part, 365)
        year = Add(yoe, Multiply(era, 400))
        doy = Multiply(365, yoe)
        doy = Add(doy, Divide(yoe, 4))
        doy = Subtract(doy, Divide(yoe, 100))
        doy = Subtract(doe, doy)
        mp = Multiply(5, doy)
        mp = Add(mp, 2)
        mp = Divide(mp, 153)
        month = Add(mp, 3)
        IfCondition GreaterEqual(mp, 10) ThenBlock: {
            month = Subtract(mp, 9)
        }
        IfCondition LessEqual(month, 2) ThenBlock: {
            year = Add(year, 1)
        }
        TouchOpt.year = year
    }
}
Function.PairAt {
    Input: text: Address
    Input: index: Integer
    Output: Integer
    Body: {
        at = Multiply(index, 2)
        b0 = GetByte(text, at)
        at1 = Add(at, 1)
        b1 = GetByte(text, at1)
        d0 = Digit(b0)
        d1 = Digit(b1)
        v = Add(Multiply(d0, 10), d1)
        ReturnValue(v)
    }
}
Function.MonthDays {
    Input: month: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(month, 2) ThenBlock: {
            y = TouchOpt.year
            leap = 0
            m4 = Modulo(y, 4)
            m100 = Modulo(y, 100)
            m400 = Modulo(y, 400)
            IfCondition EqualTo(m4, 0) ThenBlock: { leap = 1 }
            IfCondition EqualTo(m100, 0) ThenBlock: { leap = 0 }
            IfCondition EqualTo(m400, 0) ThenBlock: { leap = 1 }
            IfCondition EqualTo(leap, 1) ThenBlock: { ReturnValue(29) }
            ReturnValue(28)
        }
        IfCondition EqualTo(month, 4) ThenBlock: { ReturnValue(30) }
        IfCondition EqualTo(month, 6) ThenBlock: { ReturnValue(30) }
        IfCondition EqualTo(month, 9) ThenBlock: { ReturnValue(30) }
        IfCondition EqualTo(month, 11) ThenBlock: { ReturnValue(30) }
        ReturnValue(31)
    }
}
Function.ApplyYear {
    Input: text: Address
    Input: pair_index: Integer
    Input: npairs: Integer
    Input: pre2000: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(npairs, 0) ThenBlock: {
            CurrentYear()
            ReturnValue(1)
        }
        IfCondition EqualTo(npairs, 1) ThenBlock: {
            yy = PairAt(text, pair_index)
            IfCondition LessEqual(yy, 68) ThenBlock: {
                IfCondition EqualTo(pre2000, 1) ThenBlock: { ReturnValue(0) }
                TouchOpt.year = Add(2000, yy)
                ReturnValue(1)
            }
            TouchOpt.year = Add(1900, yy)
            ReturnValue(1)
        }
        IfCondition EqualTo(npairs, 2) ThenBlock: {
            IfCondition EqualTo(pre2000, 1) ThenBlock: { ReturnValue(0) }
            hi = PairAt(text, pair_index)
            lo_at = Add(pair_index, 1)
            lo = PairAt(text, lo_at)
            TouchOpt.year = Add(Multiply(hi, 100), lo)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.ParseStamp {
    Input: text: Address
    Input: leading: Integer
    Body: {
        TouchOpt.date_ok = 0
        TouchWork.leap = 0
        TouchWork.explicit = 0
        slen = 0
        dot = -1
        step = 1
        WhileLoop 1 {
            ch = GetByte(text, slen)
            IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
            IfCondition EqualTo(ch, 46) ThenBlock: {
                IfCondition GreaterEqual(dot, 0) ThenBlock: { ReturnValue(0) }
                dot = slen
            }
            slen = Add(slen, step)
        }
        len = slen
        IfCondition EqualTo(leading, 1) ThenBlock: {
            IfCondition GreaterEqual(dot, 0) ThenBlock: {
                tail = Subtract(slen, dot)
                IfCondition NotEqual(tail, 3) ThenBlock: { ReturnValue(0) }
                len = dot
            }
        } ElseBlock: {
            IfCondition GreaterEqual(dot, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition LessThan(len, 8) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(len, 12) ThenBlock: { ReturnValue(0) }
        even = Modulo(len, 2)
        IfCondition NotEqual(even, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, len) {
            dig = Digit(GetByte(text, i))
            IfCondition LessThan(dig, 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, step)
        }
        np = Divide(len, 2)
        ypairs = Subtract(np, 4)
        mm_at = 0
        yok = 0
        IfCondition EqualTo(leading, 1) ThenBlock: {
            mm_at = ypairs
            yok = ApplyYear(text, 0, ypairs, 0)
        } ElseBlock: {
            yok = ApplyYear(text, 4, ypairs, 1)
        }
        IfCondition EqualTo(yok, 0) ThenBlock: { ReturnValue(0) }
        p1 = Add(mm_at, 1)
        p2 = Add(mm_at, 2)
        p3 = Add(mm_at, 3)
        month = PairAt(text, mm_at)
        day = PairAt(text, p1)
        hour = PairAt(text, p2)
        minute = PairAt(text, p3)
        second = 0
        IfCondition GreaterEqual(dot, 0) ThenBlock: {
            s_at = Add(dot, 1)
            s_at2 = Add(dot, 2)
            s0 = Digit(GetByte(text, s_at))
            s1 = Digit(GetByte(text, s_at2))
            IfCondition LessThan(s0, 0) ThenBlock: { ReturnValue(0) }
            IfCondition LessThan(s1, 0) ThenBlock: { ReturnValue(0) }
            second = Add(Multiply(s0, 10), s1)
        }
        IfCondition LessThan(month, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(month, 12) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(hour, 23) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(minute, 59) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(second, 60) ThenBlock: { ReturnValue(0) }
        md = MonthDays(month)
        IfCondition LessThan(day, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(day, md) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(second, 60) ThenBlock: {
            second = 59
            TouchWork.leap = 1
        }
        days = DaysFromCivil(TouchOpt.year, month, day)
        sec = Multiply(days, 86400)
        sec = Add(sec, Multiply(hour, 3600))
        sec = Add(sec, Multiply(minute, 60))
        sec = Add(sec, second)
        TouchOpt.date_sec = sec
        ApplyZone()
        IfCondition EqualTo(TouchWork.leap, 1) ThenBlock: {
            TouchOpt.date_sec = Add(TouchOpt.date_sec, step)
            TouchOpt.mt_sec = Add(TouchOpt.mt_sec, step)
        }
        TouchOpt.date_ok = 1
    }
}
Function.MarkTz {
    Input: buf: Address
    Input: at: Integer
    Body: {
        utc = 0
        hit = StartsAt(buf, at, "UTC0", 4)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            endb = GetByte(buf, Add(at, 4))
            IfCondition EqualTo(endb, 0) ThenBlock: { utc = 1 }
        }
        hit = StartsAt(buf, at, "UTC", 3)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            endb = GetByte(buf, Add(at, 3))
            IfCondition EqualTo(endb, 0) ThenBlock: { utc = 1 }
        }
        hit = StartsAt(buf, at, "GMT0", 4)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            endb = GetByte(buf, Add(at, 4))
            IfCondition EqualTo(endb, 0) ThenBlock: { utc = 1 }
        }
        hit = StartsAt(buf, at, "GMT", 3)
        IfCondition EqualTo(hit, 1) ThenBlock: {
            endb = GetByte(buf, Add(at, 3))
            IfCondition EqualTo(endb, 0) ThenBlock: { utc = 1 }
        }
        TouchOpt.tz_utc = utc
    }
}
Function.ParsePosix {
    Input: buf: Address
    Input: at: Integer
    Body: {
        val = 0
        saw = 0
        bad = 0
        j = at
        WhileLoop 1 {
            ch = GetByte(buf, j)
            IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
            dig = Digit(ch)
            IfCondition LessThan(dig, 0) ThenBlock: {
                bad = 1
                BreakLoop
            }
            val = Multiply(val, 10)
            val = Add(val, dig)
            saw = 1
            j = Add(j, 1)
        }
        IfCondition EqualTo(bad, 0) ThenBlock: {
            IfCondition EqualTo(saw, 1) ThenBlock: {
                TouchOpt.posix2 = val
            }
        }
    }
}
Function.ScanEnviron {
    Body: {
        fd = SystemCall(2, "/proc/self/environ", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(65536)
        n = SystemCall(0, fd, buf, 65535)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 65536)
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        i = 0
        step = 1
        WhileLoop LessThan(i, n) {
            at_var = 0
            IfCondition EqualTo(i, 0) ThenBlock: { at_var = 1 }
            IfCondition GreaterThan(i, 0) ThenBlock: {
                prev_at = Subtract(i, 1)
                prev = GetByte(buf, prev_at)
                IfCondition EqualTo(prev, 0) ThenBlock: { at_var = 1 }
            }
            IfCondition EqualTo(at_var, 1) ThenBlock: {
                is_p = StartsAt(buf, i, "_POSIX2_VERSION=", 16)
                IfCondition EqualTo(is_p, 1) ThenBlock: {
                    val_at = Add(i, 16)
                    ParsePosix(buf, val_at)
                }
                is_tz = StartsAt(buf, i, "TZ=", 3)
                IfCondition EqualTo(is_tz, 1) ThenBlock: {
                    tz_at = Add(i, 3)
                    MarkTz(buf, tz_at)
                }
            }
            i = Add(i, step)
        }
        Deallocate(buf, 65536)
    }
}
Function.StatRef {
    Output: Integer
    Body: {
        buf = Allocate(144)
        flag = 0
        IfCondition EqualTo(TouchOpt.nofollow, 1) ThenBlock: { flag = 256 }
        r = SystemCall(262, -100, TouchOpt.ref_text, buf, flag)
        IfCondition LessThan(r, 0) ThenBlock: {
            err = Subtract(0, r)
            Report(3, TouchOpt.ref_text, err)
            Deallocate(buf, 144)
            ReturnValue(0)
        }
        TouchOpt.date_sec = GetUInt64(buf, 72)
        TouchOpt.at_nsec = GetUInt32(buf, 80)
        TouchOpt.mt_sec = GetUInt64(buf, 88)
        TouchOpt.mt_nsec = GetUInt32(buf, 96)
        Deallocate(buf, 144)
        ReturnValue(1)
    }
}
Function.ApplyFlex {
    Output: Integer
    Body: {
        saved_mt = TouchOpt.mt_sec
        TouchOpt.rel = 1
        TouchOpt.base_sec = TouchOpt.date_sec
        ParseDate(TouchOpt.date_text)
        IfCondition EqualTo(TouchOpt.date_ok, 0) ThenBlock: {
            TouchOpt.rel = 0
            ReturnValue(0)
        }
        new_at = TouchOpt.date_sec
        TouchOpt.base_sec = saved_mt
        ParseDate(TouchOpt.date_text)
        TouchOpt.rel = 0
        IfCondition EqualTo(TouchOpt.date_ok, 0) ThenBlock: { ReturnValue(0) }
        TouchOpt.mt_sec = TouchOpt.date_sec
        TouchOpt.date_sec = new_at
        ReturnValue(1)
    }
}
Function.IsDir {
    Input: path: Address
    Output: Integer
    Body: {
        buf = Allocate(144)
        r = SystemCall(262, -100, path, buf, 0)
        kind = 0
        IfCondition GreaterEqual(r, 0) ThenBlock: {
            mode = GetUInt32(buf, 24)
            mode = BitwiseAnd(mode, 61440)
            IfCondition EqualTo(mode, 16384) ThenBlock: { kind = 1 }
        }
        Deallocate(buf, 144)
        ReturnValue(kind)
    }
}
Function.TouchOne {
    Input: path: Address
    Body: {
        TouchWork.bad = 0
        TouchWork.open_err = 0
        b0 = GetByte(path, 0)
        b1 = GetByte(path, 1)
        is_dash = 0
        IfCondition EqualTo(b0, 45) ThenBlock: {
            IfCondition EqualTo(b1, 0) ThenBlock: { is_dash = 1 }
        }
        fd = -1
        IfCondition EqualTo(is_dash, 0) ThenBlock: {
            IfCondition EqualTo(TouchOpt.nofollow, 0) ThenBlock: {
                IfCondition EqualTo(TouchOpt.nocreate, 0) ThenBlock: {
                    fd = SystemCall(2, path, 2369, 438)
                    IfCondition LessThan(fd, 0) ThenBlock: {
                        TouchWork.open_err = Subtract(0, fd)
                        fd = -1
                    }
                }
            }
        }
        times = 0
        IfCondition EqualTo(TouchOpt.am_now, 0) ThenBlock: {
            times = Allocate(32)
            z = 0
            WhileLoop LessThan(z, 32) {
                SetByte(times, z, 0)
                z = Add(z, 1)
            }
            at_sec = 0
            mt_sec = 0
            at_ns = 1073741823
            mt_ns = 1073741823
            IfCondition EqualTo(TouchOpt.have_date, 1) ThenBlock: {
                at_sec = TouchOpt.date_sec
                mt_sec = TouchOpt.mt_sec
                at_ns = TouchOpt.at_nsec
                mt_ns = TouchOpt.mt_nsec
            }
            only_m = 0
            IfCondition EqualTo(TouchOpt.mtime, 1) ThenBlock: {
                IfCondition EqualTo(TouchOpt.atime, 0) ThenBlock: { only_m = 1 }
            }
            only_a = 0
            IfCondition EqualTo(TouchOpt.atime, 1) ThenBlock: {
                IfCondition EqualTo(TouchOpt.mtime, 0) ThenBlock: { only_a = 1 }
            }
            IfCondition EqualTo(only_m, 1) ThenBlock: { at_ns = 1073741822 }
            IfCondition EqualTo(only_a, 1) ThenBlock: { mt_ns = 1073741822 }
            StoreU64(times, 0, at_sec)
            StoreU32(times, 8, at_ns)
            StoreU64(times, 16, mt_sec)
            StoreU32(times, 24, mt_ns)
        }
        ut = 0
        IfCondition EqualTo(is_dash, 1) ThenBlock: {
            ut = SystemCall(280, 1, 0, times, 0)
        } ElseBlock: {
            flag = 0
            IfCondition EqualTo(TouchOpt.nofollow, 1) ThenBlock: { flag = 256 }
            ut = SystemCall(280, -100, path, times, flag)
        }
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(3, fd)
        }
        IfCondition NotEqual(times, 0) ThenBlock: {
            Deallocate(times, 32)
        }
        IfCondition LessThan(ut, 0) ThenBlock: {
            ut_err = Subtract(0, ut)
            silenced = 0
            IfCondition EqualTo(is_dash, 1) ThenBlock: {
                IfCondition EqualTo(TouchOpt.nocreate, 1) ThenBlock: {
                    IfCondition EqualTo(ut_err, 9) ThenBlock: { silenced = 1 }
                }
            }
            IfCondition EqualTo(silenced, 0) ThenBlock: {
                use_open = 0
                IfCondition NotEqual(TouchWork.open_err, 0) ThenBlock: {
                    use_open = 1
                    IfCondition EqualTo(TouchWork.open_err, 21) ThenBlock: { use_open = 0 }
                    IfCondition EqualTo(TouchWork.open_err, 22) ThenBlock: {
                        dir = IsDir(path)
                        IfCondition EqualTo(dir, 1) ThenBlock: { use_open = 0 }
                    }
                }
                IfCondition EqualTo(use_open, 1) ThenBlock: {
                    Report(1, path, TouchWork.open_err)
                    TouchWork.bad = 1
                } ElseBlock: {
                    IfCondition EqualTo(TouchOpt.nocreate, 1) ThenBlock: {
                        IfCondition EqualTo(ut_err, 2) ThenBlock: { silenced = 1 }
                    }
                    IfCondition EqualTo(silenced, 0) ThenBlock: {
                        Report(2, path, ut_err)
                        TouchWork.bad = 1
                    }
                }
            }
        }
    }
}
Function.ResolveTimes {
    Body: {
        both = 0
        IfCondition EqualTo(TouchOpt.saw_t, 1) ThenBlock: {
            IfCondition EqualTo(TouchOpt.saw_d, 1) ThenBlock: { both = 1 }
            IfCondition EqualTo(TouchOpt.use_ref, 1) ThenBlock: { both = 1 }
        }
        IfCondition EqualTo(both, 1) ThenBlock: {
            WriteStderr("touch: cannot specify times from more than one source\n")
            WriteStderr("Try 'touch --help' for more information.\n")
            TouchOpt.fail = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(TouchOpt.use_ref, 1) ThenBlock: {
            ok = StatRef()
            IfCondition EqualTo(ok, 0) ThenBlock: {
                TouchOpt.fail = 1
                ReturnValue(0)
            }
            TouchOpt.have_date = 1
            IfCondition EqualTo(TouchOpt.saw_d, 1) ThenBlock: {
                now = IsNow(TouchOpt.date_text)
                IfCondition EqualTo(now, 0) ThenBlock: {
                    flexed = ApplyFlex()
                    IfCondition EqualTo(flexed, 0) ThenBlock: {
                        WriteStderr("touch: invalid date format '")
                        WriteStderr(TouchOpt.date_text)
                        WriteStderr("'\n")
                        TouchOpt.fail = 1
                    }
                }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(TouchOpt.saw_d, 1) ThenBlock: {
            now = IsNow(TouchOpt.date_text)
            IfCondition EqualTo(now, 1) ThenBlock: {
                TouchOpt.have_date = 0
            } ElseBlock: {
                TouchOpt.rel = 0
                ParseDate(TouchOpt.date_text)
                IfCondition EqualTo(TouchOpt.date_ok, 0) ThenBlock: {
                    WriteStderr("touch: invalid date format '")
                    WriteStderr(TouchOpt.date_text)
                    WriteStderr("'\n")
                    TouchOpt.fail = 1
                    ReturnValue(0)
                }
                TouchOpt.have_date = 1
            }
        }
    }
}
Function.ParseLong {
    Input: opt: Address
    Body: {
        is_date = StartsAt(opt, 2, "date", 4)
        IfCondition EqualTo(is_date, 1) ThenBlock: {
            endc = GetByte(opt, 6)
            IfCondition EqualTo(endc, 0) ThenBlock: {
                TouchOpt.want = 1
                ReturnValue(0)
            }
            IfCondition EqualTo(endc, 61) ThenBlock: {
                TouchOpt.date_text = CopyFrom(opt, 7)
                TouchOpt.saw_d = 1
                ReturnValue(0)
            }
        }
        is_nd = StartsAt(opt, 2, "no-dereference", 14)
        IfCondition EqualTo(is_nd, 1) ThenBlock: {
            endc = GetByte(opt, 16)
            IfCondition EqualTo(endc, 0) ThenBlock: {
                TouchOpt.nofollow = 1
                ReturnValue(0)
            }
        }
        is_nc = StartsAt(opt, 2, "no-create", 9)
        IfCondition EqualTo(is_nc, 1) ThenBlock: {
            endc = GetByte(opt, 11)
            IfCondition EqualTo(endc, 0) ThenBlock: {
                TouchOpt.nocreate = 1
                ReturnValue(0)
            }
        }
        is_ref = StartsAt(opt, 2, "reference", 9)
        IfCondition EqualTo(is_ref, 1) ThenBlock: {
            endc = GetByte(opt, 11)
            IfCondition EqualTo(endc, 0) ThenBlock: {
                TouchOpt.want = 3
                TouchOpt.use_ref = 1
                ReturnValue(0)
            }
            IfCondition EqualTo(endc, 61) ThenBlock: {
                TouchOpt.ref_text = CopyFrom(opt, 12)
                TouchOpt.use_ref = 1
                ReturnValue(0)
            }
        }
        is_abbr = StartsAt(opt, 2, "ref", 3)
        IfCondition EqualTo(is_abbr, 1) ThenBlock: {
            endc = GetByte(opt, 5)
            IfCondition EqualTo(endc, 0) ThenBlock: {
                TouchOpt.want = 3
                TouchOpt.use_ref = 1
                ReturnValue(0)
            }
            IfCondition EqualTo(endc, 61) ThenBlock: {
                TouchOpt.ref_text = CopyFrom(opt, 6)
                TouchOpt.use_ref = 1
                ReturnValue(0)
            }
        }
        is_time = StartsAt(opt, 2, "time", 4)
        IfCondition EqualTo(is_time, 1) ThenBlock: {
            endc = GetByte(opt, 6)
            IfCondition EqualTo(endc, 61) ThenBlock: {
                val = CopyFrom(opt, 7)
                TakeTime(val)
                ReturnValue(0)
            }
            IfCondition EqualTo(endc, 0) ThenBlock: {
                WriteStderr("touch: option '--time' requires an argument\n")
                TouchOpt.fail = 1
                ReturnValue(0)
            }
        }
        TouchOpt.fail = 1
        WriteStderr("touch: unrecognized option '")
        WriteStderr(opt)
        WriteStderr("'\n")
    }
}
Function.ParseShort {
    Input: opt: Address
    Body: {
        TouchOpt.idx = 1
        WhileLoop NotEqual(GetByte(opt, TouchOpt.idx), 0) {
            c = GetByte(opt, TouchOpt.idx)
            known = 0
            IfCondition EqualTo(c, 97) ThenBlock: {
                TouchOpt.atime = 1
                known = 1
            }
            IfCondition EqualTo(c, 109) ThenBlock: {
                TouchOpt.mtime = 1
                known = 1
            }
            IfCondition EqualTo(c, 104) ThenBlock: {
                TouchOpt.nofollow = 1
                known = 1
            }
            IfCondition EqualTo(c, 99) ThenBlock: {
                TouchOpt.nocreate = 1
                known = 1
            }
            IfCondition EqualTo(c, 102) ThenBlock: {
                known = 1
            }
            IfCondition EqualTo(c, 100) ThenBlock: {
                nxt = Add(TouchOpt.idx, 1)
                more = GetByte(opt, nxt)
                IfCondition EqualTo(more, 0) ThenBlock: {
                    TouchOpt.want = 1
                } ElseBlock: {
                    TouchOpt.date_text = CopyFrom(opt, nxt)
                    TouchOpt.saw_d = 1
                }
                ReturnValue(0)
            }
            IfCondition EqualTo(c, 116) ThenBlock: {
                nxt = Add(TouchOpt.idx, 1)
                more = GetByte(opt, nxt)
                IfCondition EqualTo(more, 0) ThenBlock: {
                    TouchOpt.want = 2
                } ElseBlock: {
                    val = CopyFrom(opt, nxt)
                    TouchOpt.date_ok = 0
                    ParseStamp(val, 1)
                    IfCondition EqualTo(TouchOpt.date_ok, 0) ThenBlock: {
                        WriteStderr("touch: invalid date format '")
                        WriteStderr(val)
                        WriteStderr("'\n")
                        TouchOpt.fail = 1
                    } ElseBlock: {
                        TouchOpt.saw_t = 1
                        TouchOpt.have_date = 1
                    }
                }
                ReturnValue(0)
            }
            IfCondition EqualTo(c, 114) ThenBlock: {
                nxt = Add(TouchOpt.idx, 1)
                more = GetByte(opt, nxt)
                IfCondition EqualTo(more, 0) ThenBlock: {
                    TouchOpt.want = 3
                } ElseBlock: {
                    TouchOpt.ref_text = CopyFrom(opt, nxt)
                    TouchOpt.use_ref = 1
                }
                ReturnValue(0)
            }
            IfCondition EqualTo(known, 0) ThenBlock: {
                TouchOpt.fail = 1
                WriteStderr("touch: invalid option -- '")
                one = Allocate(2)
                SetByte(one, 0, c)
                SetByte(one, 1, 0)
                WriteStderr(one)
                Deallocate(one, 2)
                WriteStderr("'\n")
                ReturnValue(0)
            }
            TouchOpt.idx = Add(TouchOpt.idx, 1)
        }
    }
}
Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buffer = Allocate(1048576)
        bytes_read = SystemCall(0, fd, buffer, 1048576)
        SystemCall(3, fd)
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 1048576)
            ReturnValue(0)
        }
        IfCondition LessThan(bytes_read, 1048576) ThenBlock: {
            SetByte(buffer, bytes_read, 0)
        }
        ReturnValue(buffer)
    }
}
SubRoutine.Main {
    TouchOpt.posix2 = 200809
    ScanEnviron()
    args_buffer = GetArgs()
    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        WriteStderr("touch: missing file operand\n")
        SystemCall(60, 1)
    }
    pos = 0
    WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)
    exit_code = 0
    options_done = 0
    files = Allocate(32768)
    file_count = 0
    WhileLoop LessThan(pos, 1048576) {
        ch = GetByte(args_buffer, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            BreakLoop
        }
        file_start = pos
        file_len = 0
        WhileLoop And(LessThan(pos, 1048576), NotEqual(GetByte(args_buffer, pos), 0)) {
            file_len = Add(file_len, 1)
            pos = Add(pos, 1)
        }
        filename = Allocate(Add(file_len, 1))
        i = 0
        WhileLoop LessThan(i, file_len) {
            SetByte(filename, i, GetByte(args_buffer, Add(file_start, i)))
            i = Add(i, 1)
        }
        SetByte(filename, file_len, 0)
        IfCondition EqualTo(TouchOpt.want, 1) ThenBlock: {
            TouchOpt.date_text = filename
            TouchOpt.saw_d = 1
            TouchOpt.want = 0
            pos = Add(pos, 1)
            ContinueLoop
        }
        IfCondition EqualTo(TouchOpt.want, 2) ThenBlock: {
            TouchOpt.date_ok = 0
            ParseStamp(filename, 1)
            IfCondition EqualTo(TouchOpt.date_ok, 0) ThenBlock: {
                WriteStderr("touch: invalid date format '")
                WriteStderr(filename)
                WriteStderr("'\n")
                SystemCall(60, 1)
            }
            TouchOpt.saw_t = 1
            TouchOpt.have_date = 1
            TouchOpt.want = 0
            pos = Add(pos, 1)
            ContinueLoop
        }
        IfCondition EqualTo(TouchOpt.want, 3) ThenBlock: {
            TouchOpt.ref_text = filename
            TouchOpt.use_ref = 1
            TouchOpt.want = 0
            pos = Add(pos, 1)
            ContinueLoop
        }
        is_opt = 0
        IfCondition EqualTo(options_done, 0) ThenBlock: {
            IfCondition EqualTo(GetByte(filename, 0), 45) ThenBlock: {
                IfCondition GreaterThan(file_len, 1) ThenBlock: {
                    is_opt = 1
                }
            }
        }
        IfCondition EqualTo(is_opt, 1) ThenBlock: {
            endopt = 0
            IfCondition EqualTo(file_len, 2) ThenBlock: {
                IfCondition EqualTo(GetByte(filename, 1), 45) ThenBlock: {
                    endopt = 1
                }
            }
            IfCondition EqualTo(endopt, 1) ThenBlock: {
                options_done = 1
            } ElseBlock: {
                IfCondition EqualTo(GetByte(filename, 1), 45) ThenBlock: {
                    ParseLong(filename)
                } ElseBlock: {
                    ParseShort(filename)
                }
                IfCondition EqualTo(TouchOpt.fail, 1) ThenBlock: {
                    Deallocate(filename, Add(file_len, 1))
                    Deallocate(args_buffer, 1048576)
                    SystemCall(60, 1)
                }
            }
            Deallocate(filename, Add(file_len, 1))
            pos = Add(pos, 1)
            ContinueLoop
        }
        options_done = 1
        IfCondition GreaterEqual(file_count, 4096) ThenBlock: {
            WriteStderr("touch: too many operands\n")
            SystemCall(60, 1)
        }
        slot = Multiply(file_count, 8)
        StoreValue(Add(files, slot), filename)
        file_count = Add(file_count, 1)
        pos = Add(pos, 1)
    }
    IfCondition NotEqual(TouchOpt.want, 0) ThenBlock: {
        letter = 100
        IfCondition EqualTo(TouchOpt.want, 2) ThenBlock: { letter = 116 }
        IfCondition EqualTo(TouchOpt.want, 3) ThenBlock: { letter = 114 }
        one = Allocate(2)
        SetByte(one, 0, letter)
        SetByte(one, 1, 0)
        WriteStderr("touch: option requires an argument -- '")
        WriteStderr(one)
        WriteStderr("'\n")
        WriteStderr("Try 'touch --help' for more information.\n")
        SystemCall(60, 1)
    }
    ResolveTimes()
    IfCondition EqualTo(TouchOpt.fail, 1) ThenBlock: {
        SystemCall(60, 1)
    }
    start = 0
    can_old = 0
    IfCondition EqualTo(TouchOpt.have_date, 0) ThenBlock: {
        IfCondition EqualTo(TouchOpt.saw_d, 0) ThenBlock: {
            IfCondition EqualTo(TouchOpt.saw_t, 0) ThenBlock: {
                IfCondition EqualTo(TouchOpt.use_ref, 0) ThenBlock: {
                    IfCondition LessThan(TouchOpt.posix2, 200112) ThenBlock: {
                        IfCondition GreaterEqual(file_count, 2) ThenBlock: {
                            can_old = 1
                        }
                    }
                }
            }
        }
    }
    IfCondition EqualTo(can_old, 1) ThenBlock: {
        first = Dereference(files)
        TouchOpt.date_ok = 0
        ParseStamp(first, 0)
        IfCondition EqualTo(TouchOpt.date_ok, 1) ThenBlock: {
            TouchOpt.have_date = 1
            start = 1
        }
    }
    TouchOpt.am_now = 0
    IfCondition EqualTo(TouchOpt.have_date, 0) ThenBlock: {
        only = 0
        IfCondition EqualTo(TouchOpt.atime, 1) ThenBlock: {
            IfCondition EqualTo(TouchOpt.mtime, 0) ThenBlock: { only = 1 }
        }
        IfCondition EqualTo(TouchOpt.mtime, 1) ThenBlock: {
            IfCondition EqualTo(TouchOpt.atime, 0) ThenBlock: { only = 1 }
        }
        IfCondition EqualTo(only, 0) ThenBlock: {
            TouchOpt.am_now = 1
        }
    }
    IfCondition EqualTo(file_count, start) ThenBlock: {
        WriteStderr("touch: missing file operand\n")
        WriteStderr("Try 'touch --help' for more information.\n")
        exit_code = 1
    } ElseBlock: {
        fi = start
        WhileLoop LessThan(fi, file_count) {
            slot = Multiply(fi, 8)
            name = Dereference(Add(files, slot))
            TouchOne(name)
            IfCondition EqualTo(TouchWork.bad, 1) ThenBlock: {
                exit_code = 1
            }
            fi = Add(fi, 1)
        }
    }
    Deallocate(args_buffer, 1048576)
    SystemCall(60, exit_code)
}
RunTask(Main)
