// GNU tr set parser. Pools stay on tr.ailang. No Main.
// Elements are 8 bytes: type, a, b, pad, count as 4 little-endian bytes.
// Types: 1 char, 2 range, 3 class, 4 repeat, 5 equiv.
// A repeat count of 0 is an indefinite fill, resolved against string1.
LibraryImport.Arena

Function.Die {
    Input: msg: Address
    Body: {
        n = StringLength(msg)
        SystemCall(1, 2, msg, n)
        SystemCall(60, 1)
    }
}

Function.Warn {
    Input: msg: Address
    Body: {
        n = StringLength(msg)
        SystemCall(1, 2, msg, n)
    }
}

Function.ByteAt {
    Input: buf: Address
    Input: i: Integer
    Output: Integer
    Body: {
        v = RDMEM_8(buf, i)
        v = BitwiseAnd(v, 255)
        ReturnValue(v)
    }
}

Function.EqSpan {
    Input: buf: Address
    Input: start: Integer
    Input: lit: Address
    Input: n: Integer
    Output: Integer
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            at = Add(start, i)
            a = ByteAt(buf, at)
            b = ByteAt(lit, i)
            IfCondition NotEqual(a, b) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, one)
        }
        ReturnValue(1)
    }
}

Function.AppendStr {
    Input: dst: Address
    Input: pos: Integer
    Input: src: Address
    Output: Integer
    Body: {
        n = StringLength(src)
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            c = ByteAt(src, i)
            WRMEM_8(dst, pos, c)
            pos = Add(pos, one)
            i = Add(i, one)
        }
        ReturnValue(pos)
    }
}

Function.ClassId {
    Input: buf: Address
    Input: start: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(n, 6) ThenBlock: {
            hit = EqSpan(buf, start, "xdigit", 6)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ReturnValue(11)
            }
            ReturnValue(-1)
        }
        IfCondition NotEqual(n, 5) ThenBlock: {
            ReturnValue(-1)
        }
        hit = EqSpan(buf, start, "alnum", 5)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(0) }
        hit = EqSpan(buf, start, "alpha", 5)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = EqSpan(buf, start, "blank", 5)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(2) }
        hit = EqSpan(buf, start, "cntrl", 5)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(3) }
        hit = EqSpan(buf, start, "digit", 5)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(4) }
        hit = EqSpan(buf, start, "graph", 5)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(5) }
        hit = EqSpan(buf, start, "lower", 5)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(6) }
        hit = EqSpan(buf, start, "print", 5)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(7) }
        hit = EqSpan(buf, start, "punct", 5)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(8) }
        hit = EqSpan(buf, start, "space", 5)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(9) }
        hit = EqSpan(buf, start, "upper", 5)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(10) }
        ReturnValue(-1)
    }
}

Function.InClass {
    Input: id: Integer
    Input: c: Integer
    Output: Integer
    Body: {
        lo = 0
        IfCondition And(GreaterEqual(c, 97), LessEqual(c, 122)) ThenBlock: {
            lo = 1
        }
        up = 0
        IfCondition And(GreaterEqual(c, 65), LessEqual(c, 90)) ThenBlock: {
            up = 1
        }
        dg = 0
        IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
            dg = 1
        }
        IfCondition EqualTo(id, 6) ThenBlock: { ReturnValue(lo) }
        IfCondition EqualTo(id, 10) ThenBlock: { ReturnValue(up) }
        IfCondition EqualTo(id, 4) ThenBlock: { ReturnValue(dg) }
        IfCondition EqualTo(id, 1) ThenBlock: {
            IfCondition Or(EqualTo(lo, 1), EqualTo(up, 1)) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(id, 0) ThenBlock: {
            IfCondition Or(EqualTo(lo, 1), EqualTo(up, 1)) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(dg)
        }
        IfCondition EqualTo(id, 11) ThenBlock: {
            IfCondition EqualTo(dg, 1) ThenBlock: { ReturnValue(1) }
            IfCondition And(GreaterEqual(c, 97), LessEqual(c, 102)) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition And(GreaterEqual(c, 65), LessEqual(c, 70)) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(id, 2) ThenBlock: {
            IfCondition Or(EqualTo(c, 9), EqualTo(c, 32)) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(id, 9) ThenBlock: {
            IfCondition EqualTo(c, 32) ThenBlock: { ReturnValue(1) }
            IfCondition And(GreaterEqual(c, 9), LessEqual(c, 13)) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(id, 3) ThenBlock: {
            IfCondition LessThan(c, 32) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(c, 127) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(id, 5) ThenBlock: {
            IfCondition And(GreaterEqual(c, 33), LessEqual(c, 126)) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(id, 7) ThenBlock: {
            IfCondition And(GreaterEqual(c, 32), LessEqual(c, 126)) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(id, 8) ThenBlock: {
            graph = 0
            IfCondition And(GreaterEqual(c, 33), LessEqual(c, 126)) ThenBlock: {
                graph = 1
            }
            IfCondition EqualTo(graph, 0) ThenBlock: { ReturnValue(0) }
            IfCondition Or(EqualTo(lo, 1), EqualTo(up, 1)) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(dg, 1) ThenBlock: { ReturnValue(0) }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.ClassLen {
    Input: id: Integer
    Output: Integer
    Body: {
        n = 0
        c = 0
        one = 1
        WhileLoop LessThan(c, 256) {
            hit = InClass(id, c)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                n = Add(n, one)
            }
            c = Add(c, one)
        }
        ReturnValue(n)
    }
}

Function.ElemPtr {
    Input: base: Address
    Input: i: Integer
    Output: Address
    Body: {
        off = Multiply(i, 8)
        p = Add(base, off)
        ReturnValue(p)
    }
}

Function.PutU32 {
    Input: p: Address
    Input: off: Integer
    Input: n: Integer
    Body: {
        b0 = BitwiseAnd(n, 255)
        WRMEM_8(p, off, b0)
        n1 = RightShift(n, 8)
        b1 = BitwiseAnd(n1, 255)
        o1 = Add(off, 1)
        WRMEM_8(p, o1, b1)
        n2 = RightShift(n, 16)
        b2 = BitwiseAnd(n2, 255)
        o2 = Add(off, 2)
        WRMEM_8(p, o2, b2)
        n3 = RightShift(n, 24)
        b3 = BitwiseAnd(n3, 255)
        o3 = Add(off, 3)
        WRMEM_8(p, o3, b3)
    }
}

Function.GetU32 {
    Input: p: Address
    Input: off: Integer
    Output: Integer
    Body: {
        b0 = ByteAt(p, off)
        o1 = Add(off, 1)
        b1 = ByteAt(p, o1)
        o2 = Add(off, 2)
        b2 = ByteAt(p, o2)
        o3 = Add(off, 3)
        b3 = ByteAt(p, o3)
        v = b0
        s1 = LeftShift(b1, 8)
        v = BitwiseOr(v, s1)
        s2 = LeftShift(b2, 16)
        v = BitwiseOr(v, s2)
        s3 = LeftShift(b3, 24)
        v = BitwiseOr(v, s3)
        ReturnValue(v)
    }
}

Function.AppendElem {
    Input: elems: Address
    Input: n: Integer
    Input: typ: Integer
    Input: a: Integer
    Input: b: Integer
    Input: cnt: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(n, 1000) ThenBlock: {
            Die("tr: too many characters in set\n")
        }
        p = ElemPtr(elems, n)
        WRMEM_8(p, 0, typ)
        WRMEM_8(p, 1, a)
        WRMEM_8(p, 2, b)
        WRMEM_8(p, 3, 0)
        PutU32(p, 4, cnt)
        one = 1
        ReturnValue(Add(n, one))
    }
}

Function.Unquote {
    Input: src: Address
    Input: slen: Integer
    Input: buf: Address
    Input: esc: Address
    Output: Integer
    Body: {
        i = 0
        j = 0
        one = 1
        WhileLoop LessThan(i, slen) {
            c = ByteAt(src, i)
            IfCondition EqualTo(c, 92) ThenBlock: {
                nxt = Add(i, one)
                IfCondition GreaterEqual(nxt, slen) ThenBlock: {
                    Warn("tr: warning: an unescaped backslash at end of string is not portable\n")
                    WRMEM_8(buf, j, 92)
                    WRMEM_8(esc, j, 0)
                    j = Add(j, one)
                    i = Add(i, one)
                } ElseBlock: {
                    nch = ByteAt(src, nxt)
                    val = nch
                    used = 2
                    oct = 0
                    IfCondition And(GreaterEqual(nch, 48), LessEqual(nch, 55)) ThenBlock: {
                        oct = 1
                    }
                    IfCondition EqualTo(oct, 1) ThenBlock: {
                        val = Subtract(nch, 48)
                        d2i = Add(i, 2)
                        IfCondition LessThan(d2i, slen) ThenBlock: {
                            d2 = ByteAt(src, d2i)
                            IfCondition And(GreaterEqual(d2, 48), LessEqual(d2, 55)) ThenBlock: {
                                val = Add(Multiply(val, 8), Subtract(d2, 48))
                                used = 3
                                d3i = Add(i, 3)
                                IfCondition LessThan(d3i, slen) ThenBlock: {
                                    d3 = ByteAt(src, d3i)
                                    IfCondition And(GreaterEqual(d3, 48), LessEqual(d3, 55)) ThenBlock: {
                                        val3 = Add(Multiply(val, 8), Subtract(d3, 48))
                                        IfCondition LessEqual(val3, 255) ThenBlock: {
                                            val = val3
                                            used = 4
                                        }
                                    }
                                }
                            }
                        }
                    } ElseBlock: {
                        IfCondition EqualTo(nch, 110) ThenBlock: { val = 10 }
                        IfCondition EqualTo(nch, 116) ThenBlock: { val = 9 }
                        IfCondition EqualTo(nch, 114) ThenBlock: { val = 13 }
                        IfCondition EqualTo(nch, 92) ThenBlock: { val = 92 }
                        IfCondition EqualTo(nch, 97) ThenBlock: { val = 7 }
                        IfCondition EqualTo(nch, 98) ThenBlock: { val = 8 }
                        IfCondition EqualTo(nch, 102) ThenBlock: { val = 12 }
                        IfCondition EqualTo(nch, 118) ThenBlock: { val = 11 }
                    }
                    WRMEM_8(buf, j, val)
                    WRMEM_8(esc, j, 1)
                    j = Add(j, one)
                    i = Add(i, used)
                }
            } ElseBlock: {
                WRMEM_8(buf, j, c)
                WRMEM_8(esc, j, 0)
                j = Add(j, one)
                i = Add(i, one)
            }
        }
        ReturnValue(j)
    }
}

Function.FindClose {
    Input: buf: Address
    Input: esc: Address
    Input: len: Integer
    Input: start: Integer
    Input: which: Integer
    Output: Integer
    Body: {
        k = start
        one = 1
        WhileLoop LessThan(Add(k, one), len) {
            a = ByteAt(buf, k)
            ae = ByteAt(esc, k)
            k2 = Add(k, one)
            b = ByteAt(buf, k2)
            be = ByteAt(esc, k2)
            IfCondition And(EqualTo(a, which), EqualTo(ae, 0)) ThenBlock: {
                IfCondition And(EqualTo(b, 93), EqualTo(be, 0)) ThenBlock: {
                    ReturnValue(k)
                }
            }
            k = Add(k, one)
        }
        ReturnValue(-1)
    }
}

Function.StarDigits {
    Input: buf: Address
    Input: esc: Address
    Input: len: Integer
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(idx, len) ThenBlock: {
            ReturnValue(0)
        }
        star = ByteAt(buf, idx)
        se = ByteAt(esc, idx)
        IfCondition EqualTo(se, 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(star, 42) ThenBlock: { ReturnValue(0) }
        one = 1
        k = Add(idx, one)
        WhileLoop LessThan(k, len) {
            c = ByteAt(buf, k)
            e = ByteAt(esc, k)
            digit = 0
            IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                digit = 1
            }
            stop = 0
            IfCondition EqualTo(e, 1) ThenBlock: { stop = 1 }
            IfCondition EqualTo(digit, 0) ThenBlock: { stop = 1 }
            IfCondition EqualTo(stop, 1) ThenBlock: {
                IfCondition And(EqualTo(c, 93), EqualTo(e, 0)) ThenBlock: {
                    ReturnValue(1)
                }
                ReturnValue(0)
            }
            k = Add(k, one)
        }
        ReturnValue(0)
    }
}

Function.DieRepeat {
    Input: buf: Address
    Input: start: Integer
    Input: n: Integer
    Body: {
        msg = Allocate(160)
        p = AppendStr(msg, 0, "tr: invalid repeat count '")
        k = 0
        one = 1
        WhileLoop LessThan(k, n) {
            at = Add(start, k)
            c = ByteAt(buf, at)
            WRMEM_8(msg, p, c)
            p = Add(p, one)
            k = Add(k, one)
        }
        p = AppendStr(msg, p, "' in [c*n] construct\n")
        SystemCall(1, 2, msg, p)
        SystemCall(60, 1)
    }
}

Function.ParseRepeat {
    Input: buf: Address
    Input: esc: Address
    Input: len: Integer
    Input: start_idx: Integer
    Output: Integer
    Body: {
        one = 1
        star_at = Add(start_idx, one)
        IfCondition GreaterEqual(star_at, len) ThenBlock: {
            ReturnValue(-1)
        }
        star = ByteAt(buf, star_at)
        se = ByteAt(esc, star_at)
        IfCondition EqualTo(se, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(star, 42) ThenBlock: { ReturnValue(-1) }
        k = Add(start_idx, 2)
        WhileLoop LessThan(k, len) {
            e = ByteAt(esc, k)
            IfCondition NotEqual(e, 0) ThenBlock: {
                ReturnValue(-1)
            }
            c = ByteAt(buf, k)
            IfCondition EqualTo(c, 93) ThenBlock: {
                d0 = Add(start_idx, 2)
                dlen = Subtract(k, d0)
                count = 0
                IfCondition GreaterThan(dlen, 0) ThenBlock: {
                    base = 10
                    first = ByteAt(buf, d0)
                    IfCondition EqualTo(first, 48) ThenBlock: {
                        base = 8
                    }
                    val = 0
                    di = 0
                    WhileLoop LessThan(di, dlen) {
                        at = Add(d0, di)
                        dig = ByteAt(buf, at)
                        IfCondition Or(LessThan(dig, 48), GreaterThan(dig, 57)) ThenBlock: {
                            DieRepeat(buf, d0, dlen)
                        }
                        dv = Subtract(dig, 48)
                        IfCondition And(EqualTo(base, 8), GreaterThan(dv, 7)) ThenBlock: {
                            DieRepeat(buf, d0, dlen)
                        }
                        lim = Divide(2147483647, base)
                        IfCondition GreaterThan(val, lim) ThenBlock: {
                            DieRepeat(buf, d0, dlen)
                        }
                        val = Multiply(val, base)
                        val = Add(val, dv)
                        di = Add(di, one)
                    }
                    count = val
                }
                ch = ByteAt(buf, start_idx)
                TrBuild.ch = ch
                TrBuild.length = count
                TrBuild.idx = k
                ReturnValue(0)
            }
            k = Add(k, one)
        }
        ReturnValue(-1)
    }
}

Function.DieClass {
    Input: buf: Address
    Input: start: Integer
    Input: n: Integer
    Body: {
        msg = Allocate(192)
        p = AppendStr(msg, 0, "tr: invalid character class '")
        k = 0
        one = 1
        WhileLoop LessThan(k, n) {
            at = Add(start, k)
            c = ByteAt(buf, at)
            WRMEM_8(msg, p, c)
            p = Add(p, one)
            k = Add(k, one)
        }
        p = AppendStr(msg, p, "'\n")
        SystemCall(1, 2, msg, p)
        SystemCall(60, 1)
    }
}

Function.DieEquiv {
    Input: buf: Address
    Input: start: Integer
    Input: n: Integer
    Body: {
        msg = Allocate(192)
        p = AppendStr(msg, 0, "tr: ")
        k = 0
        one = 1
        WhileLoop LessThan(k, n) {
            at = Add(start, k)
            c = ByteAt(buf, at)
            WRMEM_8(msg, p, c)
            p = Add(p, one)
            k = Add(k, one)
        }
        p = AppendStr(msg, p, ": equivalence class operand must be a single character\n")
        SystemCall(1, 2, msg, p)
        SystemCall(60, 1)
    }
}

Function.DieRange {
    Input: a: Integer
    Input: b: Integer
    Body: {
        msg = Allocate(128)
        p = AppendStr(msg, 0, "tr: range-endpoints of '")
        WRMEM_8(msg, p, a)
        one = 1
        p = Add(p, one)
        WRMEM_8(msg, p, 45)
        p = Add(p, one)
        WRMEM_8(msg, p, b)
        p = Add(p, one)
        p = AppendStr(msg, p, "' are in reverse collating sequence order\n")
        SystemCall(1, 2, msg, p)
        SystemCall(60, 1)
    }
}

Function.ParseSpec {
    Input: src: Address
    Input: elems: Address
    Output: Integer
    Body: {
        slen = StringLength(src)
        cap = Add(slen, 1)
        buf = Allocate(cap)
        esc = Allocate(cap)
        ulen = Unquote(src, slen, buf, esc)
        n = 0
        i = 0
        one = 1
        two = 2
        three = 3
        limit = Subtract(ulen, 2)
        WhileLoop LessThan(i, limit) {
            c = ByteAt(buf, i)
            e = ByteAt(esc, i)
            matched = 0
            IfCondition And(EqualTo(c, 91), EqualTo(e, 0)) ThenBlock: {
                ip1 = Add(i, one)
                second = ByteAt(buf, ip1)
                se = ByteAt(esc, ip1)
                bracket_kind = 0
                is_ce = 0
                IfCondition EqualTo(se, 0) ThenBlock: {
                    IfCondition Or(EqualTo(second, 58), EqualTo(second, 61)) ThenBlock: {
                        is_ce = 1
                    }
                }
                IfCondition EqualTo(is_ce, 1) ThenBlock: {
                    from = Add(i, two)
                    close = FindClose(buf, esc, ulen, from, second)
                    IfCondition GreaterEqual(close, 0) ThenBlock: {
                        op_len = Subtract(close, from)
                        IfCondition EqualTo(op_len, 0) ThenBlock: {
                            IfCondition EqualTo(second, 58) ThenBlock: {
                                Die("tr: missing character class name '[::]'\n")
                            }
                            Die("tr: missing equivalence class character '[==]'\n")
                        }
                        IfCondition EqualTo(second, 58) ThenBlock: {
                            id = ClassId(buf, from, op_len)
                            IfCondition LessThan(id, 0) ThenBlock: {
                                star = StarDigits(buf, esc, ulen, from)
                                IfCondition EqualTo(star, 1) ThenBlock: {
                                    bracket_kind = 2
                                } ElseBlock: {
                                    DieClass(buf, from, op_len)
                                }
                            } ElseBlock: {
                                n = AppendElem(elems, n, 3, id, 0, 0)
                                step = Add(close, two)
                                i = step
                                bracket_kind = 1
                            }
                        } ElseBlock: {
                            IfCondition NotEqual(op_len, 1) ThenBlock: {
                                star = StarDigits(buf, esc, ulen, from)
                                IfCondition EqualTo(star, 1) ThenBlock: {
                                    bracket_kind = 2
                                } ElseBlock: {
                                    DieEquiv(buf, from, op_len)
                                }
                            } ElseBlock: {
                                ech = ByteAt(buf, from)
                                n = AppendElem(elems, n, 5, ech, 0, 0)
                                step = Add(close, two)
                                i = step
                                bracket_kind = 1
                            }
                        }
                    }
                }
                IfCondition NotEqual(bracket_kind, 1) ThenBlock: {
                    rc = ParseRepeat(buf, esc, ulen, ip1)
                    IfCondition EqualTo(rc, 0) ThenBlock: {
                        rch = TrBuild.ch
                        rcnt = TrBuild.length
                        rend = TrBuild.idx
                        n = AppendElem(elems, n, 4, rch, 0, rcnt)
                        i = Add(rend, one)
                        bracket_kind = 1
                    }
                }
                IfCondition EqualTo(bracket_kind, 1) ThenBlock: {
                    matched = 1
                }
            }
            IfCondition EqualTo(matched, 0) ThenBlock: {
                hpos = Add(i, one)
                hy = ByteAt(buf, hpos)
                he = ByteAt(esc, hpos)
                IfCondition And(EqualTo(hy, 45), EqualTo(he, 0)) ThenBlock: {
                    bpos = Add(i, two)
                    bch = ByteAt(buf, bpos)
                    IfCondition GreaterThan(c, bch) ThenBlock: {
                        DieRange(c, bch)
                    }
                    n = AppendElem(elems, n, 2, c, bch, 0)
                    i = Add(i, three)
                } ElseBlock: {
                    n = AppendElem(elems, n, 1, c, 0, 0)
                    i = Add(i, one)
                }
            }
        }
        WhileLoop LessThan(i, ulen) {
            c = ByteAt(buf, i)
            n = AppendElem(elems, n, 1, c, 0, 0)
            i = Add(i, one)
        }
        Deallocate(buf, cap)
        Deallocate(esc, cap)
        SpecStats(elems, n)
        ReturnValue(n)
    }
}

Function.SpecStats {
    Input: elems: Address
    Input: n: Integer
    Body: {
        length = 0
        indef = 0
        indef_at = 0
        has_class = 0
        has_restr = 0
        has_equiv = 0
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            p = ElemPtr(elems, i)
            typ = ByteAt(p, 0)
            IfCondition Or(EqualTo(typ, 1), EqualTo(typ, 5)) ThenBlock: {
                length = Add(length, one)
                IfCondition EqualTo(typ, 5) ThenBlock: {
                    has_equiv = 1
                }
            }
            IfCondition EqualTo(typ, 2) ThenBlock: {
                a = ByteAt(p, 1)
                b = ByteAt(p, 2)
                span = Subtract(b, a)
                span = Add(span, one)
                length = Add(length, span)
            }
            IfCondition EqualTo(typ, 3) ThenBlock: {
                has_class = 1
                id = ByteAt(p, 1)
                cl = ClassLen(id)
                length = Add(length, cl)
                restr = 1
                IfCondition Or(EqualTo(id, 6), EqualTo(id, 10)) ThenBlock: {
                    restr = 0
                }
                IfCondition EqualTo(restr, 1) ThenBlock: {
                    has_restr = 1
                }
            }
            IfCondition EqualTo(typ, 4) ThenBlock: {
                cnt = GetU32(p, 4)
                IfCondition GreaterThan(cnt, 0) ThenBlock: {
                    length = Add(length, cnt)
                } ElseBlock: {
                    indef = Add(indef, one)
                    indef_at = i
                }
            }
            IfCondition GreaterThan(length, 2147483647) ThenBlock: {
                Die("tr: too many characters in set\n")
            }
            i = Add(i, one)
        }
        TrBuild.length = length
        TrBuild.indef = indef
        TrBuild.indef_at = indef_at
        TrBuild.has_class = has_class
        TrBuild.has_restricted = has_restr
        TrBuild.has_equiv = has_equiv
        TrBuild.count = n
    }
}

Function.PackSt {
    Input: idx: Integer
    Input: sub: Integer
    Output: Integer
    Body: {
        hi = LeftShift(idx, 20)
        ReturnValue(BitwiseOr(hi, sub))
    }
}

Function.StIdx {
    Input: st: Integer
    Output: Integer
    Body: {
        ReturnValue(RightShift(st, 20))
    }
}

Function.StSub {
    Input: st: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseAnd(st, 1048575))
    }
}

Function.GetNext {
    Input: elems: Address
    Input: ncount: Integer
    Input: state: Integer
    Output: Integer
    Body: {
        one = 1
        cur = state
        guard = 0
        WhileLoop LessThan(guard, 10000) {
            guard = Add(guard, one)
            idx = StIdx(cur)
            sub = StSub(cur)
            IfCondition GreaterEqual(idx, ncount) ThenBlock: {
                TrBuild.ch = -1
                TrBuild.cls = 0
                TrBuild.idx = idx
                ReturnValue(cur)
            }
            p = ElemPtr(elems, idx)
            typ = ByteAt(p, 0)
            a = ByteAt(p, 1)
            b = ByteAt(p, 2)
            IfCondition Or(EqualTo(typ, 1), EqualTo(typ, 5)) ThenBlock: {
                TrBuild.ch = a
                TrBuild.cls = 0
                TrBuild.idx = idx
                nxt = Add(idx, one)
                ret = PackSt(nxt, 0)
                ReturnValue(ret)
            }
            IfCondition EqualTo(typ, 2) ThenBlock: {
                ch = Add(a, sub)
                TrBuild.ch = ch
                TrBuild.cls = 0
                TrBuild.idx = idx
                IfCondition GreaterEqual(ch, b) ThenBlock: {
                    nxt = Add(idx, one)
                    ret = PackSt(nxt, 0)
                    ReturnValue(ret)
                }
                ns = Add(sub, one)
                ret = PackSt(idx, ns)
                ReturnValue(ret)
            }
            advanced = 0
            IfCondition EqualTo(typ, 4) ThenBlock: {
                cnt = GetU32(p, 4)
                IfCondition EqualTo(cnt, 0) ThenBlock: {
                    nxt = Add(idx, one)
                    cur = PackSt(nxt, 0)
                    advanced = 1
                } ElseBlock: {
                    TrBuild.ch = a
                    TrBuild.cls = 0
                    TrBuild.idx = idx
                    ns = Add(sub, one)
                    IfCondition GreaterEqual(ns, cnt) ThenBlock: {
                        nxt = Add(idx, one)
                        ret = PackSt(nxt, 0)
                        ReturnValue(ret)
                    }
                    ret = PackSt(idx, ns)
                    ReturnValue(ret)
                }
            }
            IfCondition EqualTo(typ, 3) ThenBlock: {
                c = sub
                found = 0
                WhileLoop And(LessThan(c, 256), EqualTo(found, 0)) {
                    hit = InClass(a, c)
                    IfCondition EqualTo(hit, 1) ThenBlock: {
                        found = 1
                    } ElseBlock: {
                        c = Add(c, one)
                    }
                }
                IfCondition EqualTo(found, 1) ThenBlock: {
                    cls = 0
                    IfCondition EqualTo(a, 6) ThenBlock: { cls = 1 }
                    IfCondition EqualTo(a, 10) ThenBlock: { cls = 2 }
                    TrBuild.ch = c
                    TrBuild.cls = cls
                    TrBuild.idx = idx
                    // The call that returns the last member must leave the
                    // walker on the next element, same as a finished range.
                    ns = Add(c, one)
                    more = 0
                    WhileLoop And(LessThan(ns, 256), EqualTo(more, 0)) {
                        nxt_hit = InClass(a, ns)
                        IfCondition EqualTo(nxt_hit, 1) ThenBlock: {
                            more = 1
                        } ElseBlock: {
                            ns = Add(ns, one)
                        }
                    }
                    IfCondition EqualTo(more, 1) ThenBlock: {
                        ret = PackSt(idx, ns)
                        ReturnValue(ret)
                    }
                    nxt = Add(idx, one)
                    ret = PackSt(nxt, 0)
                    ReturnValue(ret)
                }
                nxt = Add(idx, one)
                cur = PackSt(nxt, 0)
                advanced = 1
            }
            IfCondition EqualTo(advanced, 0) ThenBlock: {
                nxt = Add(idx, one)
                cur = PackSt(nxt, 0)
            }
        }
        TrBuild.ch = -1
        TrBuild.cls = 0
        TrBuild.idx = 0
        ReturnValue(cur)
    }
}

Function.ValidateCase {
    Input: e1: Address
    Input: n1: Integer
    Input: e2: Address
    Input: n2: Integer
    Input: len1: Integer
    Input: len2: Integer
    Body: {
        st1 = 0
        st2 = 0
        one = 1
        guard = 0
        WhileLoop LessThan(guard, 10000) {
            sub1 = StSub(st1)
            sub2 = StSub(st2)
            new1 = 0
            new2 = 0
            IfCondition EqualTo(sub1, 0) ThenBlock: { new1 = 1 }
            IfCondition EqualTo(sub2, 0) ThenBlock: { new2 = 1 }
            st1 = GetNext(e1, n1, st1)
            c1 = TrBuild.ch
            cls1 = TrBuild.cls
            idx1 = TrBuild.idx
            st2 = GetNext(e2, n2, st2)
            c2 = TrBuild.ch
            cls2 = TrBuild.cls
            idx2 = TrBuild.idx
            IfCondition And(EqualTo(new2, 1), NotEqual(cls2, 0)) ThenBlock: {
                aligned = 0
                IfCondition And(EqualTo(new1, 1), NotEqual(cls1, 0)) ThenBlock: {
                    aligned = 1
                }
                IfCondition EqualTo(aligned, 0) ThenBlock: {
                    Die("tr: misaligned [:upper:] and/or [:lower:] construct\n")
                }
            }
            IfCondition NotEqual(cls2, 0) ThenBlock: {
                len1 = Subtract(len1, 25)
                len2 = Subtract(len2, 25)
                nidx1 = Add(idx1, one)
                nidx2 = Add(idx2, one)
                st1 = PackSt(nidx1, 0)
                st2 = PackSt(nidx2, 0)
            }
            IfCondition Or(LessThan(c1, 0), LessThan(c2, 0)) ThenBlock: {
                guard = 10000
            } ElseBlock: {
                guard = Add(guard, one)
            }
        }
        TrCase.l1 = len1
        TrCase.l2 = len2
    }
}

Function.Homogeneous {
    Input: elems: Address
    Input: n: Integer
    Output: Integer
    Body: {
        st = 0
        first = -2
        guard = 0
        one = 1
        WhileLoop LessThan(guard, 300000) {
            st = GetNext(elems, n, st)
            c = TrBuild.ch
            IfCondition LessThan(c, 0) ThenBlock: {
                guard = 300000
            } ElseBlock: {
                IfCondition EqualTo(first, -2) ThenBlock: {
                    first = c
                } ElseBlock: {
                    IfCondition NotEqual(c, first) ThenBlock: {
                        ReturnValue(0)
                    }
                }
                guard = Add(guard, one)
            }
        }
        IfCondition LessThan(first, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.ExtendSet {
    Input: elems: Address
    Input: n: Integer
    Input: diff: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(n, 0) ThenBlock: {
            ReturnValue(n)
        }
        one = 1
        last = Subtract(n, one)
        p = ElemPtr(elems, last)
        typ = ByteAt(p, 0)
        IfCondition EqualTo(typ, 3) ThenBlock: {
            Die("tr: when translating with string1 longer than string2,\nthe latter string must not end with a character class\n")
        }
        ch = ByteAt(p, 1)
        IfCondition EqualTo(typ, 2) ThenBlock: {
            ch = ByteAt(p, 2)
        }
        n2 = AppendElem(elems, n, 4, ch, 0, diff)
        ReturnValue(n2)
    }
}

Function.ResolveIndef {
    Input: elems: Address
    Input: at: Integer
    Input: nfill: Integer
    Body: {
        p = ElemPtr(elems, at)
        PutU32(p, 4, nfill)
    }
}

Function.Zero256 {
    Input: p: Address
    Body: {
        i = 0
        one = 1
        WhileLoop LessThan(i, 256) {
            WRMEM_8(p, i, 0)
            i = Add(i, one)
        }
    }
}

Function.FillMember {
    Input: elems: Address
    Input: n: Integer
    Input: comp: Integer
    Output: Address
    Body: {
        table = Allocate(256)
        Zero256(table)
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            p = ElemPtr(elems, i)
            typ = ByteAt(p, 0)
            a = ByteAt(p, 1)
            b = ByteAt(p, 2)
            IfCondition Or(EqualTo(typ, 1), EqualTo(typ, 5)) ThenBlock: {
                WRMEM_8(table, a, 1)
            }
            IfCondition EqualTo(typ, 2) ThenBlock: {
                c = a
                WhileLoop LessEqual(c, b) {
                    WRMEM_8(table, c, 1)
                    c = Add(c, one)
                }
            }
            IfCondition EqualTo(typ, 4) ThenBlock: {
                cnt = GetU32(p, 4)
                IfCondition GreaterThan(cnt, 0) ThenBlock: {
                    WRMEM_8(table, a, 1)
                }
            }
            IfCondition EqualTo(typ, 3) ThenBlock: {
                c = 0
                WhileLoop LessThan(c, 256) {
                    hit = InClass(a, c)
                    IfCondition EqualTo(hit, 1) ThenBlock: {
                        WRMEM_8(table, c, 1)
                    }
                    c = Add(c, one)
                }
            }
            i = Add(i, one)
        }
        IfCondition EqualTo(comp, 1) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, 256) {
                b = ByteAt(table, i)
                IfCondition EqualTo(b, 0) ThenBlock: {
                    WRMEM_8(table, i, 1)
                } ElseBlock: {
                    WRMEM_8(table, i, 0)
                }
                i = Add(i, one)
            }
        }
        ReturnValue(table)
    }
}

Function.CardComplement {
    Input: elems: Address
    Input: n: Integer
    Output: Integer
    Body: {
        table = FillMember(elems, n, 1)
        i = 0
        count = 0
        one = 1
        WhileLoop LessThan(i, 256) {
            b = ByteAt(table, i)
            IfCondition EqualTo(b, 1) ThenBlock: {
                count = Add(count, one)
            }
            i = Add(i, one)
        }
        Deallocate(table, 256)
        ReturnValue(count)
    }
}

Function.MakeXlate {
    Input: e1: Address
    Input: n1: Integer
    Input: e2: Address
    Input: n2: Integer
    Input: comp: Integer
    Output: Address
    Body: {
        table = Allocate(256)
        i = 0
        one = 1
        WhileLoop LessThan(i, 256) {
            WRMEM_8(table, i, i)
            i = Add(i, one)
        }
        IfCondition EqualTo(comp, 1) ThenBlock: {
            mem = FillMember(e1, n1, 0)
            st = 0
            i = 0
            WhileLoop LessThan(i, 256) {
                m = ByteAt(mem, i)
                IfCondition EqualTo(m, 0) ThenBlock: {
                    st = GetNext(e2, n2, st)
                    c2 = TrBuild.ch
                    IfCondition LessThan(c2, 0) ThenBlock: {
                        i = 256
                    } ElseBlock: {
                        c2 = BitwiseAnd(c2, 255)
                        WRMEM_8(table, i, c2)
                        i = Add(i, one)
                    }
                } ElseBlock: {
                    i = Add(i, one)
                }
            }
            Deallocate(mem, 256)
            ReturnValue(table)
        }
        st1 = 0
        st2 = 0
        guard = 0
        WhileLoop LessThan(guard, 300000) {
            st1 = GetNext(e1, n1, st1)
            c1 = TrBuild.ch
            st2 = GetNext(e2, n2, st2)
            c2 = TrBuild.ch
            IfCondition Or(LessThan(c1, 0), LessThan(c2, 0)) ThenBlock: {
                guard = 300000
            } ElseBlock: {
                c1 = BitwiseAnd(c1, 255)
                c2 = BitwiseAnd(c2, 255)
                WRMEM_8(table, c1, c2)
                guard = Add(guard, one)
            }
        }
        ReturnValue(table)
    }
}
