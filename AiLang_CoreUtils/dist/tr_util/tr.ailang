// tr.ailang - Translate, delete, or squeeze characters
// Usage: tr SET1 SET2      (translate SET1[i] -> SET2[i])
//        tr -d SET1        (delete characters in SET1)
//        tr -s SET1        (squeeze runs of chars in SET1 into one)
//        tr -ds SET1 SET2  (delete + squeeze)
//
// SET syntax supports ranges (a-z, 0-9) and C-style escapes:
//   \n \r \t \\ \0  plus any other "\c" as literal c.
//
// April 2026 refresh: added Arena import (Allocate moved there), set
// expansion for ranges/escapes (the old binary translated "a-z" as the
// three literal chars a,-,z which broke `tr a-z A-Z`), and -s support.

LibraryImport.Arena

FixedPool.TrConfig {
    "delete_mode":  Initialize=0
    "squeeze_mode": Initialize=0
}

FixedPool.TrConstants {
    "BUFFER_SIZE": Initialize=65536
    "SET_MAX":     Initialize=1024
}

Function.WriteStdout {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 1, buffer, len)
    }
}

// Expand a SET string:  ranges (a-z), escapes (\n \t \r \\ \0).
// Writes expanded bytes into `out` and returns the count. Caller allocates
// `out` with at least TrConstants.SET_MAX bytes.
FixedPool.ExpandState { "len": Initialize=0 }

Function.DecodeEscape {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(c, 110) ThenBlock: { ReturnValue(10) }   // \n
        IfCondition EqualTo(c, 116) ThenBlock: { ReturnValue(9) }    // \t
        IfCondition EqualTo(c, 114) ThenBlock: { ReturnValue(13) }   // \r
        IfCondition EqualTo(c, 92)  ThenBlock: { ReturnValue(92) }   // \\
        IfCondition EqualTo(c, 48)  ThenBlock: { ReturnValue(0) }    // \0
        IfCondition EqualTo(c, 97)  ThenBlock: { ReturnValue(7) }    // \a
        IfCondition EqualTo(c, 98)  ThenBlock: { ReturnValue(8) }    // \b
        IfCondition EqualTo(c, 102) ThenBlock: { ReturnValue(12) }   // \f
        IfCondition EqualTo(c, 118) ThenBlock: { ReturnValue(11) }   // \v
        // Unknown escape: return the literal char (GNU behavior).
        ReturnValue(c)
    }
}

// Read one "input character" from src at position *p. Handles one level of
// escape. Returns the byte; advances *p via ExpandState.len (used as scratch).
FixedPool.ReadState { "next_pos": Initialize=0 }

Function.ReadOneChar {
    Input: src: Address
    Input: p: Integer
    Input: limit: Integer
    Output: Integer
    Body: {
        c = GetByte(src, p)
        IfCondition And(EqualTo(c, 92), LessThan(Add(p, 1), limit)) ThenBlock: {
            nxt = GetByte(src, Add(p, 1))
            ReadState.next_pos = Add(p, 2)
            ReturnValue(DecodeEscape(nxt))
        }
        ReadState.next_pos = Add(p, 1)
        ReturnValue(c)
    }
}

Function.ExpandSet {
    Input: src: Address
    Input: out: Address
    Output: Integer
    Body: {
        slen = StringLength(src)
        olen = 0
        p = 0
        WhileLoop LessThan(p, slen) {
            a = ReadOneChar(src, p, slen)
            p = ReadState.next_pos
            // Range a-b
            IfCondition And(LessThan(p, slen), EqualTo(GetByte(src, p), 45)) ThenBlock: {
                IfCondition LessThan(Add(p, 1), slen) ThenBlock: {
                    p = Add(p, 1)
                    b = ReadOneChar(src, p, slen)
                    p = ReadState.next_pos
                    IfCondition LessEqual(a, b) ThenBlock: {
                        j = a
                        WhileLoop And(LessEqual(j, b), LessThan(olen, TrConstants.SET_MAX)) {
                            SetByte(out, olen, j)
                            olen = Add(olen, 1)
                            j = Add(j, 1)
                        }
                    } ElseBlock: {
                        // Descending range: emit a, -, b literally (GNU errors;
                        // we match conservatively by keeping both endpoints).
                        IfCondition LessThan(olen, TrConstants.SET_MAX) ThenBlock: {
                            SetByte(out, olen, a)
                            olen = Add(olen, 1)
                        }
                        IfCondition LessThan(olen, TrConstants.SET_MAX) ThenBlock: {
                            SetByte(out, olen, 45)
                            olen = Add(olen, 1)
                        }
                        IfCondition LessThan(olen, TrConstants.SET_MAX) ThenBlock: {
                            SetByte(out, olen, b)
                            olen = Add(olen, 1)
                        }
                    }
                } ElseBlock: {
                    // Trailing '-' after last char: emit as literal plus '-'
                    IfCondition LessThan(olen, TrConstants.SET_MAX) ThenBlock: {
                        SetByte(out, olen, a)
                        olen = Add(olen, 1)
                    }
                    IfCondition LessThan(olen, TrConstants.SET_MAX) ThenBlock: {
                        SetByte(out, olen, 45)
                        olen = Add(olen, 1)
                    }
                    p = Add(p, 1)
                }
            } ElseBlock: {
                IfCondition LessThan(olen, TrConstants.SET_MAX) ThenBlock: {
                    SetByte(out, olen, a)
                    olen = Add(olen, 1)
                }
            }
        }
        ReturnValue(olen)
    }
}

Function.BuildTranslationTable {
    Input: from_buf: Address
    Input: from_len: Integer
    Input: to_buf: Address
    Input: to_len: Integer
    Output: Address
    Body: {
        table = Allocate(256)
        i = 0
        WhileLoop LessThan(i, 256) {
            SetByte(table, i, i)
            i = Add(i, 1)
        }
        IfCondition LessEqual(to_len, 0) ThenBlock: { ReturnValue(table) }

        i = 0
        WhileLoop LessThan(i, from_len) {
            from_ch = GetByte(from_buf, i)
            IfCondition LessThan(i, to_len) ThenBlock: {
                to_ch = GetByte(to_buf, i)
            } ElseBlock: {
                to_ch = GetByte(to_buf, Subtract(to_len, 1))
            }
            SetByte(table, from_ch, to_ch)
            i = Add(i, 1)
        }
        ReturnValue(table)
    }
}

// Membership table: 1 if the byte is in the (expanded) set, else 0.
Function.BuildMemberTable {
    Input: set_buf: Address
    Input: set_len: Integer
    Output: Address
    Body: {
        table = Allocate(256)
        i = 0
        WhileLoop LessThan(i, 256) {
            SetByte(table, i, 0)
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, set_len) {
            SetByte(table, GetByte(set_buf, i), 1)
            i = Add(i, 1)
        }
        ReturnValue(table)
    }
}

// Unified stream processor.
// `xtab` is the 256-byte translation table (identity if not translating).
// `dtab` is the 256-byte delete-membership table (or 0 to skip delete).
// `stab` is the 256-byte squeeze-membership table (or 0 to skip squeeze).
// The three stages run in POSIX order: translate -> delete -> squeeze.
Function.ProcessTr {
    Input: xtab: Address
    Input: dtab: Address
    Input: stab: Address
    Body: {
        buffer = Allocate(TrConstants.BUFFER_SIZE)
        out    = Allocate(TrConstants.BUFFER_SIZE)
        last_emitted = -1   // for squeeze

        WhileLoop 1 {
            n = SystemCall(0, 0, buffer, TrConstants.BUFFER_SIZE)
            IfCondition LessEqual(n, 0) ThenBlock: { BreakLoop }

            out_pos = 0
            i = 0
            WhileLoop LessThan(i, n) {
                ch = GetByte(buffer, i)

                IfCondition NotEqual(xtab, 0) ThenBlock: {
                    ch = GetByte(xtab, ch)
                }

                drop = 0
                IfCondition NotEqual(dtab, 0) ThenBlock: {
                    IfCondition EqualTo(GetByte(dtab, ch), 1) ThenBlock: {
                        drop = 1
                    }
                }

                IfCondition EqualTo(drop, 0) ThenBlock: {
                    squeeze_here = 0
                    IfCondition NotEqual(stab, 0) ThenBlock: {
                        IfCondition And(EqualTo(GetByte(stab, ch), 1), EqualTo(ch, last_emitted)) ThenBlock: {
                            squeeze_here = 1
                        }
                    }
                    IfCondition EqualTo(squeeze_here, 0) ThenBlock: {
                        SetByte(out, out_pos, ch)
                        out_pos = Add(out_pos, 1)
                        last_emitted = ch
                    }
                }

                i = Add(i, 1)
            }

            IfCondition GreaterThan(out_pos, 0) ThenBlock: {
                WriteStdout(out, out_pos)
            }
        }

        Deallocate(buffer, TrConstants.BUFFER_SIZE)
        Deallocate(out, TrConstants.BUFFER_SIZE)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        ReturnValue(buffer)
    }
}

SubRoutine.Main {
    args_buffer = GetArgs()

    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        SystemCall(60, 1)
    }

    // Skip program name
    pos = 0
    WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)

    set1 = 0
    set2 = 0

    // Parse flags and capture two positional SETs (pointers into args_buffer).
    WhileLoop LessThan(pos, 4096) {
        ch = GetByte(args_buffer, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }

        IfCondition EqualTo(ch, 45) ThenBlock: {
            // Collect all flag chars of this arg (-d, -s, -ds, -sd)
            q = Add(pos, 1)
            WhileLoop And(LessThan(q, 4096), NotEqual(GetByte(args_buffer, q), 0)) {
                f = GetByte(args_buffer, q)
                IfCondition EqualTo(f, 100) ThenBlock: { TrConfig.delete_mode  = 1 }
                IfCondition EqualTo(f, 115) ThenBlock: { TrConfig.squeeze_mode = 1 }
                q = Add(q, 1)
            }
            // Advance past this arg's NUL
            pos = Add(q, 1)
            ContinueLoop
        }

        // Positional: pointer directly into args_buffer - strings are NUL-
        // terminated in cmdline, so we don't need to copy.
        arg_start = pos
        WhileLoop And(LessThan(pos, 4096), NotEqual(GetByte(args_buffer, pos), 0)) {
            pos = Add(pos, 1)
        }
        pos = Add(pos, 1)
        IfCondition EqualTo(set1, 0) ThenBlock: {
            set1 = Add(args_buffer, arg_start)
        } ElseBlock: {
            IfCondition EqualTo(set2, 0) ThenBlock: {
                set2 = Add(args_buffer, arg_start)
            }
        }
    }

    // Expand both SETs (ranges + escapes).
    set1_exp = 0
    set1_len = 0
    set2_exp = 0
    set2_len = 0
    IfCondition NotEqual(set1, 0) ThenBlock: {
        set1_exp = Allocate(TrConstants.SET_MAX)
        set1_len = ExpandSet(set1, set1_exp)
    }
    IfCondition NotEqual(set2, 0) ThenBlock: {
        set2_exp = Allocate(TrConstants.SET_MAX)
        set2_len = ExpandSet(set2, set2_exp)
    }

    IfCondition EqualTo(set1, 0) ThenBlock: {
        WriteStdout("tr: missing operand\n", 20)
        SystemCall(60, 1)
    }

    // Build tables. If we're only deleting/squeezing, xtab stays 0 so
    // ProcessTr skips the translate step.
    xtab = 0
    dtab = 0
    stab = 0

    IfCondition And(EqualTo(TrConfig.delete_mode, 0), NotEqual(set2, 0)) ThenBlock: {
        xtab = BuildTranslationTable(set1_exp, set1_len, set2_exp, set2_len)
    }
    IfCondition EqualTo(TrConfig.delete_mode, 1) ThenBlock: {
        dtab = BuildMemberTable(set1_exp, set1_len)
    }
    IfCondition EqualTo(TrConfig.squeeze_mode, 1) ThenBlock: {
        // When both translating and squeezing, POSIX says squeeze SET2.
        IfCondition And(EqualTo(TrConfig.delete_mode, 0), NotEqual(set2, 0)) ThenBlock: {
            stab = BuildMemberTable(set2_exp, set2_len)
        } ElseBlock: {
            stab = BuildMemberTable(set1_exp, set1_len)
        }
    }

    ProcessTr(xtab, dtab, stab)

    IfCondition NotEqual(xtab, 0) ThenBlock: { Deallocate(xtab, 256) }
    IfCondition NotEqual(dtab, 0) ThenBlock: { Deallocate(dtab, 256) }
    IfCondition NotEqual(stab, 0) ThenBlock: { Deallocate(stab, 256) }
    IfCondition NotEqual(set1_exp, 0) ThenBlock: { Deallocate(set1_exp, TrConstants.SET_MAX) }
    IfCondition NotEqual(set2_exp, 0) ThenBlock: { Deallocate(set2_exp, TrConstants.SET_MAX) }

    Deallocate(args_buffer, 4096)
    SystemCall(60, 0)
}

RunTask(Main)