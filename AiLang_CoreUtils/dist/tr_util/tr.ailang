// tr.ailang - GNU tr. Pools and Main. Set syntax lives in TrSets.ailang.
LibraryImport.Arena

FixedPool.TrConfig {
    "delete_mode":  Initialize=0
    "squeeze_mode": Initialize=0
    "complement":   Initialize=0
    "truncate":     Initialize=0
    "args_len":     Initialize=0
}

FixedPool.TrBuild {
    "ch":              Initialize=0
    "cls":             Initialize=0
    "idx":             Initialize=0
    "length":          Initialize=0
    "count":           Initialize=0
    "indef":           Initialize=0
    "indef_at":        Initialize=0
    "has_class":       Initialize=0
    "has_restricted":  Initialize=0
    "has_equiv":       Initialize=0
}

FixedPool.TrCase {
    "l1": Initialize=0
    "l2": Initialize=0
}

FixedPool.TrConstants {
    "BUFFER_SIZE": Initialize=65536
}

LibraryImport.AiLang_CoreUtils.dist.tr_util.TrSets

Function.WriteStdout {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        n = SystemCall(1, 1, buffer, len)
        IfCondition LessThan(n, len) ThenBlock: {
            SystemCall(60, 1)
        }
    }
}

Function.ProcessTr {
    Input: xtab: Address
    Input: dtab: Address
    Input: stab: Address
    Body: {
        buffer = Allocate(TrConstants.BUFFER_SIZE)
        out    = Allocate(TrConstants.BUFFER_SIZE)
        last_emitted = -1

        plain = 0
        IfCondition And(EqualTo(dtab, 0), EqualTo(stab, 0)) ThenBlock: {
            plain = 1
        }

        WhileLoop 1 {
            n = SystemCall(0, 0, buffer, TrConstants.BUFFER_SIZE)
            IfCondition LessEqual(n, 0) ThenBlock: { BreakLoop }

            IfCondition EqualTo(plain, 1) ThenBlock: {
                IfCondition NotEqual(xtab, 0) ThenBlock: {
                    i = 0
                    one = 1
                    WhileLoop LessThan(i, n) {
                        ch = GetByte(buffer, i)
                        ch = BitwiseAnd(ch, 255)
                        mapped = GetByte(xtab, ch)
                        mapped = BitwiseAnd(mapped, 255)
                        SetByte(out, i, mapped)
                        i = Add(i, one)
                    }
                    WriteStdout(out, n)
                } ElseBlock: {
                    WriteStdout(buffer, n)
                }
            } ElseBlock: {
                out_pos = 0
                i = 0
                one = 1
                WhileLoop LessThan(i, n) {
                    ch = GetByte(buffer, i)
                    ch = BitwiseAnd(ch, 255)

                    IfCondition NotEqual(xtab, 0) ThenBlock: {
                        ch = GetByte(xtab, ch)
                        ch = BitwiseAnd(ch, 255)
                    }

                    drop = 0
                    IfCondition NotEqual(dtab, 0) ThenBlock: {
                        bit = GetByte(dtab, ch)
                        bit = BitwiseAnd(bit, 255)
                        IfCondition EqualTo(bit, 1) ThenBlock: {
                            drop = 1
                        }
                    }

                    IfCondition EqualTo(drop, 0) ThenBlock: {
                        squeeze_here = 0
                        IfCondition NotEqual(stab, 0) ThenBlock: {
                            bit = GetByte(stab, ch)
                            bit = BitwiseAnd(bit, 255)
                            IfCondition And(EqualTo(bit, 1), EqualTo(ch, last_emitted)) ThenBlock: {
                                squeeze_here = 1
                            }
                        }
                        IfCondition EqualTo(squeeze_here, 0) ThenBlock: {
                            SetByte(out, out_pos, ch)
                            out_pos = Add(out_pos, one)
                            last_emitted = ch
                        }
                    }

                    i = Add(i, one)
                }

                IfCondition GreaterThan(out_pos, 0) ThenBlock: {
                    WriteStdout(out, out_pos)
                }
            }
        }

        Deallocate(buffer, TrConstants.BUFFER_SIZE)
        Deallocate(out, TrConstants.BUFFER_SIZE)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }

        buffer = Allocate(8192)
        bytes_read = SystemCall(0, fd, buffer, 8191)
        SystemCall(3, fd)

        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 8192)
            ReturnValue(0)
        }

        SetByte(buffer, bytes_read, 0)
        TrConfig.args_len = bytes_read
        ReturnValue(buffer)
    }
}

Function.SaveArg {
    Input: args: Address
    Input: at: Integer
    Input: nargs: Integer
    Input: set1: Address
    Input: set2: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(nargs, 0) ThenBlock: {
            TrBuild.idx = Add(args, at)
        }
        IfCondition EqualTo(nargs, 1) ThenBlock: {
            TrBuild.length = Add(args, at)
        }
        one = 1
        ReturnValue(Add(nargs, one))
    }
}

SubRoutine.Main {
    args_buffer = GetArgs()
    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        SystemCall(60, 1)
    }

    pos = 0
    one = 1
    WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
        pos = Add(pos, one)
    }
    pos = Add(pos, one)

    set1 = 0
    set2 = 0
    nargs = 0
    saw_pos = 0
    end_opts = 0

    WhileLoop LessThan(pos, TrConfig.args_len) {
        ch = GetByte(args_buffer, pos)
        ch = BitwiseAnd(ch, 255)
        opt = 0
        IfCondition EqualTo(end_opts, 0) ThenBlock: {
            IfCondition EqualTo(saw_pos, 0) ThenBlock: {
                IfCondition EqualTo(ch, 45) ThenBlock: {
                    opt = 1
                }
            }
        }
        IfCondition EqualTo(opt, 1) ThenBlock: {
            n1p = Add(pos, one)
            n1 = GetByte(args_buffer, n1p)
            n1 = BitwiseAnd(n1, 255)
            IfCondition EqualTo(n1, 0) ThenBlock: {
                saw_pos = 1
                IfCondition EqualTo(nargs, 0) ThenBlock: {
                    set1 = Add(args_buffer, pos)
                }
                IfCondition EqualTo(nargs, 1) ThenBlock: {
                    set2 = Add(args_buffer, pos)
                }
                nargs = Add(nargs, one)
                pos = Add(n1p, one)
            } ElseBlock: {
                IfCondition EqualTo(n1, 45) ThenBlock: {
                    argp = Add(args_buffer, pos)
                    n2p = Add(n1p, one)
                    n2 = GetByte(args_buffer, n2p)
                    IfCondition EqualTo(n2, 0) ThenBlock: {
                        end_opts = 1
                        pos = Add(n2p, one)
                    } ElseBlock: {
                        known = 0
                        IfCondition StringEquals(argp, "--complement") ThenBlock: {
                            TrConfig.complement = 1
                            known = 1
                        }
                        IfCondition StringEquals(argp, "--delete") ThenBlock: {
                            TrConfig.delete_mode = 1
                            known = 1
                        }
                        IfCondition StringEquals(argp, "--squeeze-repeats") ThenBlock: {
                            TrConfig.squeeze_mode = 1
                            known = 1
                        }
                        IfCondition StringEquals(argp, "--truncate-set1") ThenBlock: {
                            TrConfig.truncate = 1
                            known = 1
                        }
                        IfCondition EqualTo(known, 0) ThenBlock: {
                            Die("tr: unrecognized option\n")
                        }
                        WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
                            pos = Add(pos, one)
                        }
                        pos = Add(pos, one)
                    }
                } ElseBlock: {
                    pos = Add(pos, one)
                    done = 0
                    WhileLoop EqualTo(done, 0) {
                        f = GetByte(args_buffer, pos)
                        f = BitwiseAnd(f, 255)
                        IfCondition EqualTo(f, 0) ThenBlock: {
                            pos = Add(pos, one)
                            done = 1
                        } ElseBlock: {
                            IfCondition Or(EqualTo(f, 99), EqualTo(f, 67)) ThenBlock: {
                                TrConfig.complement = 1
                            } ElseBlock: {
                                IfCondition EqualTo(f, 100) ThenBlock: {
                                    TrConfig.delete_mode = 1
                                } ElseBlock: {
                                    IfCondition EqualTo(f, 115) ThenBlock: {
                                        TrConfig.squeeze_mode = 1
                                    } ElseBlock: {
                                        IfCondition EqualTo(f, 116) ThenBlock: {
                                            TrConfig.truncate = 1
                                        } ElseBlock: {
                                            IfCondition NotEqual(f, 65) ThenBlock: {
                                                Die("tr: invalid option\n")
                                            }
                                        }
                                    }
                                }
                            }
                            pos = Add(pos, one)
                        }
                    }
                }
            }
        } ElseBlock: {
            saw_pos = 1
            IfCondition EqualTo(nargs, 0) ThenBlock: {
                set1 = Add(args_buffer, pos)
            }
            IfCondition EqualTo(nargs, 1) ThenBlock: {
                set2 = Add(args_buffer, pos)
            }
            nargs = Add(nargs, one)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                pos = Add(pos, one)
            } ElseBlock: {
                WhileLoop NotEqual(GetByte(args_buffer, pos), 0) {
                    pos = Add(pos, one)
                }
                pos = Add(pos, one)
            }
        }
    }

    need2 = 0
    IfCondition EqualTo(TrConfig.delete_mode, TrConfig.squeeze_mode) ThenBlock: {
        need2 = 1
    }
    min_ops = Add(1, need2)
    max_ops = 2
    IfCondition And(EqualTo(TrConfig.delete_mode, 1), EqualTo(TrConfig.squeeze_mode, 0)) ThenBlock: {
        max_ops = 1
    }
    IfCondition LessThan(nargs, min_ops) ThenBlock: {
        Die("tr: missing operand\n")
    }
    IfCondition GreaterThan(nargs, max_ops) ThenBlock: {
        Die("tr: extra operand\n")
    }

    e1 = Allocate(8192)
    e2 = Allocate(8192)
    n1 = ParseSpec(set1, e1)
    s1_len = TrBuild.length
    s1_indef = TrBuild.indef
    s1_class = TrBuild.has_class

    IfCondition EqualTo(TrConfig.complement, 1) ThenBlock: {
        s1_len = CardComplement(e1, n1)
    }
    IfCondition GreaterThan(s1_indef, 0) ThenBlock: {
        Die("tr: the [c*] repeat construct may not appear in string1\n")
    }

    n2 = 0
    s2_len = 0
    s2_indef = 0
    s2_class = 0
    s2_restr = 0
    s2_equiv = 0
    IfCondition EqualTo(nargs, 2) ThenBlock: {
        n2 = ParseSpec(set2, e2)
        s2_len = TrBuild.length
        s2_indef = TrBuild.indef
        s2_at = TrBuild.indef_at
        s2_class = TrBuild.has_class
        s2_restr = TrBuild.has_restricted
        s2_equiv = TrBuild.has_equiv
        can_fill = 0
        IfCondition GreaterEqual(s1_len, s2_len) ThenBlock: {
            IfCondition EqualTo(s2_indef, 1) ThenBlock: {
                can_fill = 1
            }
        }
        IfCondition EqualTo(can_fill, 1) ThenBlock: {
            fill = Subtract(s1_len, s2_len)
            ResolveIndef(e2, s2_at, fill)
            s2_len = s1_len
        }
        IfCondition GreaterThan(s2_indef, 1) ThenBlock: {
            Die("tr: only one [c*] repeat construct may appear in string2\n")
        }
    }

    translating = 0
    IfCondition And(EqualTo(nargs, 2), EqualTo(TrConfig.delete_mode, 0)) ThenBlock: {
        translating = 1
    }

    IfCondition EqualTo(translating, 1) ThenBlock: {
        IfCondition EqualTo(s2_equiv, 1) ThenBlock: {
            Die("tr: [=c=] expressions may not appear in string2 when translating\n")
        }
        IfCondition EqualTo(s2_restr, 1) ThenBlock: {
            Die("tr: when translating, the only character classes that may appear in\nstring2 are 'upper' and 'lower'\n")
        }
        do_case = 0
        IfCondition EqualTo(TrConfig.complement, 0) ThenBlock: {
            IfCondition EqualTo(s2_class, 1) ThenBlock: {
                do_case = 1
            }
        }
        IfCondition EqualTo(do_case, 1) ThenBlock: {
            ValidateCase(e1, n1, e2, n2, s1_len, s2_len)
            s1_len = TrCase.l1
            s2_len = TrCase.l2
        }
        IfCondition GreaterThan(s1_len, s2_len) ThenBlock: {
            IfCondition EqualTo(TrConfig.truncate, 0) ThenBlock: {
                IfCondition EqualTo(s2_len, 0) ThenBlock: {
                    Die("tr: when not truncating set1, string2 must be non-empty\n")
                }
                diff = Subtract(s1_len, s2_len)
                n2 = ExtendSet(e2, n2, diff)
                s2_len = s1_len
            }
        }
        IfCondition And(EqualTo(TrConfig.complement, 1), EqualTo(s1_class, 1)) ThenBlock: {
            ok = 0
            IfCondition EqualTo(s2_len, s1_len) ThenBlock: {
                ok = Homogeneous(e2, n2)
            }
            IfCondition EqualTo(ok, 0) ThenBlock: {
                Die("tr: when translating with complemented character classes,\nstring2 must map all characters in the domain to one\n")
            }
        }
    } ElseBlock: {
        IfCondition And(EqualTo(nargs, 2), GreaterThan(s2_indef, 0)) ThenBlock: {
            Die("tr: the [c*] construct may appear in string2 only when translating\n")
        }
    }

    xtab = 0
    dtab = 0
    stab = 0
    IfCondition EqualTo(translating, 1) ThenBlock: {
        xtab = MakeXlate(e1, n1, e2, n2, TrConfig.complement)
    }
    IfCondition EqualTo(TrConfig.delete_mode, 1) ThenBlock: {
        dtab = FillMember(e1, n1, TrConfig.complement)
    }
    IfCondition EqualTo(TrConfig.squeeze_mode, 1) ThenBlock: {
        IfCondition EqualTo(nargs, 2) ThenBlock: {
            stab = FillMember(e2, n2, 0)
        } ElseBlock: {
            stab = FillMember(e1, n1, TrConfig.complement)
        }
    }

    ProcessTr(xtab, dtab, stab)
    SystemCall(60, 0)
}

RunTask(Main)
