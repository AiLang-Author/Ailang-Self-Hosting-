// true.ailang - Exit 0. --help and --version write a line and fail if the write fails.

LibraryImport.Arena

Function.ArgIs {
    Input: buf: Address
    Input: at: Integer
    Input: lit: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 16) {
            a = RDMEM_8(buf, Add(at, i))
            b = RDMEM_8(lit, i)
            IfCondition NotEqual(a, b) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(a, 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
    IfCondition LessThan(fd, 0) ThenBlock: {
        SystemCall(60, 0)
    }
    buffer = Allocate(4096)
    nread = SystemCall(0, fd, buffer, 4096)
    SystemCall(3, fd)
    pos = 0
    WhileLoop And(LessThan(pos, nread), NotEqual(RDMEM_8(buffer, pos), 0)) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)
    show = 0
    IfCondition LessThan(pos, nread) ThenBlock: {
        help = ArgIs(buffer, pos, "--help")
        ver = ArgIs(buffer, pos, "--version")
        IfCondition EqualTo(help, 1) ThenBlock: {
            show = 1
        }
        IfCondition EqualTo(ver, 1) ThenBlock: {
            show = 1
        }
    }
    IfCondition EqualTo(show, 1) ThenBlock: {
        msg = "true (AILANG coreutils) 9.4\n"
        mlen = StringLength(msg)
        wr = SystemCall(1, 1, msg, mlen)
        IfCondition LessThan(wr, mlen) ThenBlock: {
            SystemCall(60, 1)
        }
    }
    Deallocate(buffer, 4096)
    SystemCall(60, 0)
}

RunTask(Main)
