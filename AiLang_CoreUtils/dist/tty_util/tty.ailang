// tty.ailang - Print the file name of the terminal connected to stdin
// Usage: tty [OPTION]...

LibraryImport.Arena

Function.WriteOut {
    Input: buf: Address
    Input: len: Integer
    Output: Integer
    Body: {
        n = SystemCall(1, 1, buf, len)
        IfCondition LessThan(n, 0) ThenBlock: {
            ReturnValue(3)
        }
        ReturnValue(0)
    }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        ReturnValue(buffer)
    }
}

SubRoutine.Main {
    silent = 0
    extra = 0
    args = GetArgs()
    IfCondition NotEqual(args, 0) ThenBlock: {
        pos = 0
        WhileLoop NotEqual(RDMEM_8(args, pos), 0) {
            pos = Add(pos, 1)
        }
        pos = Add(pos, 1)
        WhileLoop LessThan(pos, 4096) {
            ch = RDMEM_8(args, pos)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            arg_start = pos
            arg_len = 0
            WhileLoop And(LessThan(pos, 4096), NotEqual(RDMEM_8(args, pos), 0)) {
                arg_len = Add(arg_len, 1)
                pos = Add(pos, 1)
            }
            arg = Allocate(Add(arg_len, 1))
            i = 0
            WhileLoop LessThan(i, arg_len) {
                WRMEM_8(arg, i, RDMEM_8(args, Add(arg_start, i)))
                i = Add(i, 1)
            }
            WRMEM_8(arg, arg_len, 0)
            known = 0
            IfCondition StringEquals(arg, "-s") ThenBlock: {
                silent = 1
                known = 1
            }
            IfCondition StringEquals(arg, "--silent") ThenBlock: {
                silent = 1
                known = 1
            }
            IfCondition StringEquals(arg, "--quiet") ThenBlock: {
                silent = 1
                known = 1
            }
            IfCondition EqualTo(known, 0) ThenBlock: {
                extra = 1
            }
            Deallocate(arg, Add(arg_len, 1))
            pos = Add(pos, 1)
        }
        Deallocate(args, 4096)
    }
    IfCondition EqualTo(extra, 1) ThenBlock: {
        SystemCall(60, 2)
    }

    // A path under /dev is not enough: /dev/null is not a terminal.
    // TCGETS (0x5401) succeeds only on a terminal.
    termios = Allocate(64)
    tty_rc = SystemCall(16, 0, 21505, termios)
    Deallocate(termios, 64)
    IfCondition LessThan(tty_rc, 0) ThenBlock: {
        IfCondition EqualTo(silent, 0) ThenBlock: {
            wr = WriteOut("not a tty\n", 10)
            IfCondition EqualTo(wr, 3) ThenBlock: {
                SystemCall(60, 3)
            }
        }
        SystemCall(60, 1)
    }

    // ttyname on fd 0 (stdin) - use readlink on /proc/self/fd/0
    link_path = "/proc/self/fd/0"
    buffer = Allocate(4096)
    
    // readlink(path, buf, bufsize) - syscall 89
    bytes = SystemCall(89, link_path, buffer, 4096)
    
    IfCondition LessThan(bytes, 0) ThenBlock: {
        IfCondition EqualTo(silent, 0) ThenBlock: {
            wr = WriteOut("not a tty\n", 10)
            IfCondition EqualTo(wr, 3) ThenBlock: {
                SystemCall(60, 3)
            }
        }
        Deallocate(buffer, 4096)
        SystemCall(60, 1)
    }
    
    // A valid TTY path will start with /dev/
    // Check if the first 5 bytes are "/dev/"
    is_dev_path = 0
    IfCondition GreaterEqual(bytes, 5) ThenBlock: {
        IfCondition And(EqualTo(RDMEM_8(buffer, 0), 47), And(EqualTo(RDMEM_8(buffer, 1), 100), And(EqualTo(RDMEM_8(buffer, 2), 101), And(EqualTo(RDMEM_8(buffer, 3), 118), EqualTo(RDMEM_8(buffer, 4), 47))))) ThenBlock: {
            is_dev_path = 1
        }
    }
    
    IfCondition EqualTo(is_dev_path, 0) ThenBlock: {
        IfCondition EqualTo(silent, 0) ThenBlock: {
            wr = WriteOut("not a tty\n", 10)
            IfCondition EqualTo(wr, 3) ThenBlock: {
                SystemCall(60, 3)
            }
        }
        Deallocate(buffer, 4096)
        SystemCall(60, 1)
    }

    IfCondition EqualTo(silent, 1) ThenBlock: {
        Deallocate(buffer, 4096)
        SystemCall(60, 0)
    }

    WRMEM_8(buffer, bytes, 10)
    wr = WriteOut(buffer, Add(bytes, 1))
    Deallocate(buffer, 4096)
    IfCondition EqualTo(wr, 3) ThenBlock: {
        SystemCall(60, 3)
    }
    SystemCall(60, 0)
}

RunTask(Main)