// unexpand.ailang - Convert spaces to tabs using GNU tab-stop lists

LibraryImport.Arena

FixedPool.Ex {
    "nread": Initialize=0
    "whole": Initialize=0
    "force": Initialize=0
    "first": Initialize=0
    "ntab": Initialize=0
    "extend": Initialize=0
    "incre": Initialize=0
    "tsize": Initialize=8
    "tabs": Initialize=0
    "tidx": Initialize=0
    "lastf": Initialize=0
}

Function.WriteOut {
    Input: buf: Address
    Input: len: Integer
    Body: {
        IfCondition LessEqual(len, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = SystemCall(1, 1, buf, len)
        IfCondition LessThan(n, len) ThenBlock: {
            SystemCall(60, 1)
        }
        ReturnValue(0)
    }
}

Function.PutByte {
    Input: ch: Integer
    Body: {
        b = Allocate(1)
        SetByte(b, 0, ch)
        WriteOut(b, 1)
        Deallocate(b, 1)
        ReturnValue(0)
    }
}

Function.PutSpaces {
    Input: n: Integer
    Body: {
        left = n
        blk = Allocate(64)
        i = 0
        WhileLoop LessThan(i, 64) {
            SetByte(blk, i, 32)
            i = Add(i, 1)
        }
        WhileLoop GreaterThan(left, 0) {
            take = left
            IfCondition GreaterThan(take, 64) ThenBlock: {
                take = 64
            }
            WriteOut(blk, take)
            left = Subtract(left, take)
        }
        Deallocate(blk, 64)
        ReturnValue(0)
    }
}

Function.AddTab {
    Input: v: Integer
    Body: {
        IfCondition GreaterEqual(Ex.ntab, 64) ThenBlock: {
            SystemCall(60, 1)
        }
        StoreValue(Add(Ex.tabs, Multiply(Ex.ntab, 8)), v)
        Ex.ntab = Add(Ex.ntab, 1)
        ReturnValue(0)
    }
}

Function.SetExtend {
    Input: v: Integer
    Body: {
        IfCondition NotEqual(Ex.extend, 0) ThenBlock: {
            SystemCall(60, 1)
        }
        Ex.extend = v
        ReturnValue(0)
    }
}

Function.SetIncre {
    Input: v: Integer
    Body: {
        IfCondition NotEqual(Ex.incre, 0) ThenBlock: {
            SystemCall(60, 1)
        }
        Ex.incre = v
        ReturnValue(0)
    }
}

Function.ApplyStop {
    Input: tabval: Integer
    Input: extf: Integer
    Input: incf: Integer
    Body: {
        IfCondition EqualTo(extf, 1) ThenBlock: {
            SetExtend(tabval)
        } ElseBlock: {
            IfCondition EqualTo(incf, 1) ThenBlock: {
                SetIncre(tabval)
            } ElseBlock: {
                AddTab(tabval)
            }
        }
        ReturnValue(0)
    }
}

Function.ParseStops {
    Input: s: Address
    Body: {
        i = 0
        have = 0
        tabval = 0
        extf = 0
        incf = 0
        WhileLoop LessThan(i, 400) {
            c = GetByte(s, i)
            IfCondition EqualTo(c, 0) ThenBlock: {
                BreakLoop
            }
            blank = 0
            IfCondition EqualTo(c, 44) ThenBlock: {
                blank = 1
            }
            IfCondition EqualTo(c, 32) ThenBlock: {
                blank = 1
            }
            IfCondition EqualTo(c, 9) ThenBlock: {
                blank = 1
            }
            IfCondition EqualTo(blank, 1) ThenBlock: {
                IfCondition EqualTo(have, 1) ThenBlock: {
                    ApplyStop(tabval, extf, incf)
                    have = 0
                }
            } ElseBlock: {
                IfCondition EqualTo(c, 47) ThenBlock: {
                    IfCondition EqualTo(have, 1) ThenBlock: {
                        SystemCall(60, 1)
                    }
                    extf = 1
                    incf = 0
                } ElseBlock: {
                    IfCondition EqualTo(c, 43) ThenBlock: {
                        IfCondition EqualTo(have, 1) ThenBlock: {
                            SystemCall(60, 1)
                        }
                        incf = 1
                        extf = 0
                    } ElseBlock: {
                        IfCondition Or(LessThan(c, 48), GreaterThan(c, 57)) ThenBlock: {
                            SystemCall(60, 1)
                        }
                        IfCondition EqualTo(have, 0) ThenBlock: {
                            tabval = 0
                            have = 1
                        }
                        IfCondition GreaterThan(tabval, 922337203685477580) ThenBlock: {
                            msg = "unexpand: tab stop value is too large\n"
                            n = StringLength(msg)
                            SystemCall(1, 2, msg, n)
                            SystemCall(60, 1)
                        }
                        tabval = Add(Multiply(tabval, 10), Subtract(c, 48))
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(have, 1) ThenBlock: {
            ApplyStop(tabval, extf, incf)
        }
        ReturnValue(0)
    }
}

Function.Finalize {
    Body: {
        prev = 0
        i = 0
        WhileLoop LessThan(i, Ex.ntab) {
            v = Dereference(Add(Ex.tabs, Multiply(i, 8)))
            IfCondition EqualTo(v, 0) ThenBlock: {
                SystemCall(60, 1)
            }
            IfCondition LessEqual(v, prev) ThenBlock: {
                SystemCall(60, 1)
            }
            prev = v
            i = Add(i, 1)
        }
        IfCondition And(NotEqual(Ex.extend, 0), NotEqual(Ex.incre, 0)) ThenBlock: {
            SystemCall(60, 1)
        }
        IfCondition EqualTo(Ex.ntab, 0) ThenBlock: {
            Ex.tsize = 8
            IfCondition NotEqual(Ex.extend, 0) ThenBlock: {
                Ex.tsize = Ex.extend
            }
            IfCondition NotEqual(Ex.incre, 0) ThenBlock: {
                Ex.tsize = Ex.incre
            }
        } ElseBlock: {
            IfCondition And(EqualTo(Ex.ntab, 1), And(EqualTo(Ex.extend, 0), EqualTo(Ex.incre, 0))) ThenBlock: {
                Ex.tsize = Dereference(Ex.tabs)
            } ElseBlock: {
                Ex.tsize = 0
            }
        }
        ReturnValue(0)
    }
}

Function.NextCol {
    Input: column: Integer
    Output: Integer
    Body: {
        Ex.lastf = 0
        IfCondition NotEqual(Ex.tsize, 0) ThenBlock: {
            rem = Modulo(column, Ex.tsize)
            ReturnValue(Add(column, Subtract(Ex.tsize, rem)))
        }
        idx = Ex.tidx
        WhileLoop LessThan(idx, Ex.ntab) {
            tab = Dereference(Add(Ex.tabs, Multiply(idx, 8)))
            IfCondition LessThan(column, tab) ThenBlock: {
                Ex.tidx = idx
                ReturnValue(tab)
            }
            idx = Add(idx, 1)
        }
        Ex.tidx = idx
        IfCondition NotEqual(Ex.extend, 0) ThenBlock: {
            rem = Modulo(column, Ex.extend)
            ReturnValue(Add(column, Subtract(Ex.extend, rem)))
        }
        IfCondition NotEqual(Ex.incre, 0) ThenBlock: {
            endt = Dereference(Add(Ex.tabs, Multiply(Subtract(Ex.ntab, 1), 8)))
            diff = Subtract(column, endt)
            rem = Modulo(diff, Ex.incre)
            ReturnValue(Add(column, Subtract(Ex.incre, rem)))
        }
        Ex.lastf = 1
        ReturnValue(0)
    }
}

Function.EmitPending {
    Input: pbuf: Address
    Input: pending: Integer
    Input: oneb: Integer
    Body: {
        IfCondition GreaterThan(pending, 0) ThenBlock: {
            n = pending
            IfCondition And(GreaterThan(n, 1), EqualTo(oneb, 1)) ThenBlock: {
                SetByte(pbuf, 0, 9)
            }
            WriteOut(pbuf, n)
        }
        ReturnValue(0)
    }
}

Function.ExpandFd {
    Input: fd: Integer
    Body: {
        buf = Allocate(4096)
        pbuf = Allocate(4096)
        WhileLoop 1 {
            column = 0
            convert = 1
            prevb = 1
            pending = 0
            oneb = 0
            Ex.tidx = 0
            WhileLoop 1 {
                n = SystemCall(0, fd, buf, 4096)
                eof = 0
                IfCondition LessEqual(n, 0) ThenBlock: {
                    eof = 1
                    n = 1
                }
                i = 0
                WhileLoop LessThan(i, n) {
                    c = 0
                    IfCondition EqualTo(eof, 0) ThenBlock: {
                        c = GetByte(buf, i)
                    } ElseBlock: {
                        c = -1
                    }
                    blank = 0
                    IfCondition Or(EqualTo(c, 32), EqualTo(c, 9)) ThenBlock: {
                        blank = 1
                    }
                    held = 0
                    IfCondition EqualTo(convert, 1) ThenBlock: {
                        IfCondition EqualTo(blank, 1) ThenBlock: {
                            nxt = NextCol(column)
                            IfCondition EqualTo(Ex.lastf, 1) ThenBlock: {
                                convert = 0
                            }
                            IfCondition EqualTo(convert, 1) ThenBlock: {
                                IfCondition EqualTo(c, 9) ThenBlock: {
                                    column = nxt
                                    IfCondition GreaterThan(pending, 0) ThenBlock: {
                                        SetByte(pbuf, 0, 9)
                                    }
                                } ElseBlock: {
                                    column = Add(column, 1)
                                    known = 1
                                    IfCondition And(EqualTo(prevb, 1), EqualTo(column, nxt)) ThenBlock: {
                                        known = 0
                                    }
                                    IfCondition EqualTo(known, 1) ThenBlock: {
                                        IfCondition EqualTo(column, nxt) ThenBlock: {
                                            oneb = 1
                                        }
                                        SetByte(pbuf, pending, c)
                                        pending = Add(pending, 1)
                                        prevb = 1
                                        held = 1
                                    } ElseBlock: {
                                        SetByte(pbuf, 0, 9)
                                        c = 9
                                    }
                                }
                                IfCondition EqualTo(held, 0) ThenBlock: {
                                    pending = oneb
                                }
                            }
                        } ElseBlock: {
                            IfCondition EqualTo(c, 8) ThenBlock: {
                                IfCondition GreaterThan(column, 0) ThenBlock: {
                                    column = Subtract(column, 1)
                                }
                                IfCondition GreaterThan(Ex.tidx, 0) ThenBlock: {
                                    Ex.tidx = Subtract(Ex.tidx, 1)
                                }
                            } ElseBlock: {
                                column = Add(column, 1)
                            }
                        }
                    }
                    IfCondition EqualTo(held, 0) ThenBlock: {
                        EmitPending(pbuf, pending, oneb)
                        pending = 0
                        oneb = 0
                        prevb = blank
                        IfCondition EqualTo(Ex.whole, 0) ThenBlock: {
                            IfCondition EqualTo(blank, 0) ThenBlock: {
                                convert = 0
                            }
                        }
                        IfCondition GreaterEqual(c, 0) ThenBlock: {
                            PutByte(c)
                        }
                        IfCondition EqualTo(c, 10) ThenBlock: {
                            column = 0
                            convert = 1
                            prevb = 1
                            Ex.tidx = 0
                        }
                    }
                    IfCondition EqualTo(eof, 1) ThenBlock: {
                        Deallocate(pbuf, 4096)
                        Deallocate(buf, 4096)
                        ReturnValue(0)
                    }
                    i = Add(i, 1)
                }
            }
        }
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buffer = Allocate(4096)
        nread = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        IfCondition LessEqual(nread, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        Ex.nread = nread
        ReturnValue(buffer)
    }
}

Function.Starts {
    Input: s: Address
    Input: lit: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 20) {
            b = GetByte(lit, i)
            IfCondition EqualTo(b, 0) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition NotEqual(GetByte(s, i), b) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.OpenArg {
    Input: arg: Address
    Output: Integer
    Body: {
        IfCondition And(EqualTo(GetByte(arg, 0), 45), EqualTo(GetByte(arg, 1), 0)) ThenBlock: {
            ReturnValue(0)
        }
        fd = SystemCall(2, arg, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            SystemCall(60, 1)
        }
        ReturnValue(fd)
    }
}

SubRoutine.Main {
    Ex.tabs = Allocate(512)
    args = GetArgs()
    IfCondition EqualTo(args, 0) ThenBlock: {
        Finalize()
        ExpandFd(0)
        SystemCall(60, 0)
    }
    pos = 0
    WhileLoop NotEqual(GetByte(args, pos), 0) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)
    limit = Subtract(Ex.nread, 1)
    opts = 1
    files = 0
    flist = Allocate(128)
    WhileLoop LessThan(pos, limit) {
        ch = GetByte(args, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            pos = Add(pos, 1)
        } ElseBlock: {
            arg = Add(args, pos)
            WhileLoop NotEqual(GetByte(args, pos), 0) {
                pos = Add(pos, 1)
            }
            pos = Add(pos, 1)
            take = 1
            IfCondition EqualTo(opts, 1) ThenBlock: {
                IfCondition EqualTo(GetByte(arg, 0), 45) ThenBlock: {
                    IfCondition EqualTo(GetByte(arg, 1), 0) ThenBlock: {
                        take = 1
                    } ElseBlock: {
                        take = 0
                        IfCondition And(EqualTo(GetByte(arg, 1), 45), EqualTo(GetByte(arg, 2), 0)) ThenBlock: {
                            opts = 0
                        } ElseBlock: {
                            IfCondition EqualTo(GetByte(arg, 1), 97) ThenBlock: {
                                Ex.force = 1
                            } ElseBlock: {
                                IfCondition Or(EqualTo(GetByte(arg, 1), 116), And(GreaterEqual(GetByte(arg, 1), 48), LessEqual(GetByte(arg, 1), 57))) ThenBlock: {
                                    IfCondition EqualTo(GetByte(arg, 1), 116) ThenBlock: {
                                        Ex.force = 1
                                        IfCondition EqualTo(GetByte(arg, 2), 0) ThenBlock: {
                                            IfCondition LessThan(pos, limit) ThenBlock: {
                                                nxt = Add(args, pos)
                                                WhileLoop NotEqual(GetByte(args, pos), 0) {
                                                    pos = Add(pos, 1)
                                                }
                                                pos = Add(pos, 1)
                                                ParseStops(nxt)
                                            }
                                        } ElseBlock: {
                                            ParseStops(Add(arg, 2))
                                        }
                                    } ElseBlock: {
                                        ParseStops(Add(arg, 1))
                                    }
                                } ElseBlock: {
                                    IfCondition EqualTo(Starts(arg, "--tabs="), 1) ThenBlock: {
                                        Ex.force = 1
                                        ParseStops(Add(arg, 7))
                                    } ElseBlock: {
                                        IfCondition EqualTo(Starts(arg, "--tab="), 1) ThenBlock: {
                                            Ex.force = 1
                                            ParseStops(Add(arg, 6))
                                        } ElseBlock: {
                                            IfCondition EqualTo(Starts(arg, "--tabs"), 1) ThenBlock: {
                                                Ex.force = 1
                                                IfCondition LessThan(pos, limit) ThenBlock: {
                                                    nxt = Add(args, pos)
                                                    WhileLoop NotEqual(GetByte(args, pos), 0) {
                                                        pos = Add(pos, 1)
                                                    }
                                                    pos = Add(pos, 1)
                                                    ParseStops(nxt)
                                                }
                                            } ElseBlock: {
                                                IfCondition EqualTo(Starts(arg, "--first-only"), 1) ThenBlock: {
                                                    Ex.first = 1
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(take, 1) ThenBlock: {
                StoreValue(Add(flist, Multiply(files, 8)), arg)
                files = Add(files, 1)
                opts = 0
            }
        }
    }
    IfCondition EqualTo(Ex.first, 1) ThenBlock: {
        Ex.whole = 0
    } ElseBlock: {
        IfCondition EqualTo(Ex.force, 1) ThenBlock: {
            Ex.whole = 1
        }
    }
    Finalize()
    IfCondition EqualTo(files, 0) ThenBlock: {
        ExpandFd(0)
    } ElseBlock: {
        fi = 0
        WhileLoop LessThan(fi, files) {
            farg = Dereference(Add(flist, Multiply(fi, 8)))
            fd = OpenArg(farg)
            ExpandFd(fd)
            IfCondition GreaterThan(fd, 0) ThenBlock: {
                SystemCall(3, fd)
            }
            fi = Add(fi, 1)
        }
    }
    SystemCall(60, 0)
}

RunTask(Main)
