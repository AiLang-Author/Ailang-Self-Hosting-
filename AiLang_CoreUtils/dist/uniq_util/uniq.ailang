// uniq.ailang - FULLY OPTIMIZED with buffered I/O
// Usage: uniq [file]

LibraryImport.Arena

FixedPool.UniqConstants {
    "BUFFER_SIZE": Initialize=262144     
    "OUTPUT_BUFFER_SIZE": Initialize=524288 
    "MAX_LINE_LENGTH": Initialize=65536
}

FixedPool.OutputBuffer {
    "buffer": Initialize=0
    "position": Initialize=0
}

FixedPool.UniqOpt {
    "cmp_w": Initialize=0
    "only_dup": Initialize=0
    "gcount": Initialize=0
    "file": Initialize=0
}

Function.InitOutputBuffer {
    Body: {
        OutputBuffer.buffer = Allocate(UniqConstants.OUTPUT_BUFFER_SIZE)
        OutputBuffer.position = 0
    }
}

Function.FlushOutputBuffer {
    Body: {
        IfCondition GreaterThan(OutputBuffer.position, 0) ThenBlock: {
            n = SystemCall(1, 1, OutputBuffer.buffer, OutputBuffer.position)
            IfCondition LessThan(n, OutputBuffer.position) ThenBlock: {
                SystemCall(60, 1)
            }
            OutputBuffer.position = 0
        }
    }
}

Function.BuffWrite {
    Input: data: Address
    Input: len: Integer
    Body: {
        // If data won't fit, flush first
        space = Subtract(UniqConstants.OUTPUT_BUFFER_SIZE, OutputBuffer.position)
        
        IfCondition LessThan(space, len) ThenBlock: {
            FlushOutputBuffer()
        }
        
        // Use MemCopy to add to buffer
        MemoryCopy(Add(OutputBuffer.buffer, OutputBuffer.position), data, len)
        OutputBuffer.position = Add(OutputBuffer.position, len)
    }
}

Function.BuffWriteByte {
    Input: byte: Integer
    Body: {
        IfCondition GreaterEqual(OutputBuffer.position, UniqConstants.OUTPUT_BUFFER_SIZE) ThenBlock: {
            FlushOutputBuffer()
        }
        
        SetByte(OutputBuffer.buffer, OutputBuffer.position, byte)
        OutputBuffer.position = Add(OutputBuffer.position, 1)
    }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.SysOpen {
    Input: filename: Address
    Output: Integer
    Body: {
        ReturnValue(SystemCall(2, filename, 0, 0))
    }
}

Function.SysRead {
    Input: fd: Integer
    Input: buffer: Address
    Input: count: Integer
    Output: Integer
    Body: {
        ReturnValue(SystemCall(0, fd, buffer, count))
    }
}

Function.SysClose {
    Input: fd: Integer
    Body: {
        SystemCall(3, fd)
    }
}

Function.ProcessUniq {
    Input: fd: Integer
    Body: {
        InitOutputBuffer()
        
        buffer = Allocate(UniqConstants.BUFFER_SIZE)
        prev_line = Allocate(UniqConstants.MAX_LINE_LENGTH)
        curr_line = Allocate(UniqConstants.MAX_LINE_LENGTH)
        
        prev_len = 0
        curr_len = 0
        
        buffer_pos = 0
        buffer_len = 0
        
        first_line = 1
        
        WhileLoop 1 {
            // Read more data if needed
            IfCondition GreaterEqual(buffer_pos, buffer_len) ThenBlock: {
                buffer_len = SysRead(fd, buffer, UniqConstants.BUFFER_SIZE)
                IfCondition LessEqual(buffer_len, 0) ThenBlock: {
                    IfCondition EqualTo(UniqOpt.only_dup, 1) ThenBlock: {
                        IfCondition GreaterThan(UniqOpt.gcount, 1) ThenBlock: {
                            BuffWrite(prev_line, prev_len)
                            BuffWriteByte(10)
                        }
                    } ElseBlock: {
                        IfCondition GreaterThan(curr_len, 0) ThenBlock: {
                            BuffWrite(curr_line, curr_len)
                            BuffWriteByte(10)
                        }
                    }
                    FlushOutputBuffer()
                    BreakLoop
                }
                buffer_pos = 0
            }
            
            // Find next newline using MemChr (SSE2)
            remaining = Subtract(buffer_len, buffer_pos)
            search_ptr = Add(buffer, buffer_pos)
            newline_offset = MemChr(search_ptr, 10, remaining)
            
            IfCondition EqualTo(newline_offset, -1) ThenBlock: {
                // No newline found - copy remaining to curr_line buffer
                bytes_to_copy = remaining
                space_left = Subtract(UniqConstants.MAX_LINE_LENGTH, curr_len)
                
                IfCondition GreaterThan(bytes_to_copy, space_left) ThenBlock: {
                    bytes_to_copy = space_left
                }
                
                IfCondition GreaterThan(bytes_to_copy, 0) ThenBlock: {
                    MemoryCopy(Add(curr_line, curr_len), search_ptr, bytes_to_copy)
                    curr_len = Add(curr_len, bytes_to_copy)
                }
                
                buffer_pos = buffer_len
                ContinueLoop
            }
            
            // Found newline! Copy line segment
            bytes_to_copy = newline_offset
            space_left = Subtract(UniqConstants.MAX_LINE_LENGTH, curr_len)
            
            IfCondition GreaterThan(bytes_to_copy, space_left) ThenBlock: {
                bytes_to_copy = space_left
            }
            
            IfCondition GreaterThan(bytes_to_copy, 0) ThenBlock: {
                MemoryCopy(Add(curr_line, curr_len), search_ptr, bytes_to_copy)
                curr_len = Add(curr_len, bytes_to_copy)
            }
            
            // Compare with previous line using MemCompare (SSE2)
            IfCondition EqualTo(first_line, 1) ThenBlock: {
                ResetCount()
                IfCondition EqualTo(UniqOpt.only_dup, 0) ThenBlock: {
                    BuffWrite(curr_line, curr_len)
                    BuffWriteByte(10)
                    FlushOutputBuffer()
                }
                MemoryCopy(prev_line, curr_line, curr_len)
                prev_len = curr_len
                first_line = 0
            } ElseBlock: {
                same = SameLine(curr_line, curr_len, prev_line, prev_len)
                IfCondition EqualTo(same, 1) ThenBlock: {
                    BumpCount()
                } ElseBlock: {
                    IfCondition EqualTo(UniqOpt.only_dup, 1) ThenBlock: {
                        IfCondition GreaterThan(UniqOpt.gcount, 1) ThenBlock: {
                            BuffWrite(prev_line, prev_len)
                            BuffWriteByte(10)
                        }
                    } ElseBlock: {
                        BuffWrite(curr_line, curr_len)
                        BuffWriteByte(10)
                        FlushOutputBuffer()
                    }
                    ResetCount()
                    MemoryCopy(prev_line, curr_line, curr_len)
                    prev_len = curr_len
                }
            }
            
            // Move to next line
            buffer_pos = Add(buffer_pos, Add(newline_offset, 1))
            curr_len = 0
        }
        
        Deallocate(curr_line, UniqConstants.MAX_LINE_LENGTH)
        Deallocate(prev_line, UniqConstants.MAX_LINE_LENGTH)
        Deallocate(buffer, UniqConstants.BUFFER_SIZE)
        Deallocate(OutputBuffer.buffer, UniqConstants.OUTPUT_BUFFER_SIZE)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        ReturnValue(buffer)
    }
}

Function.SetWidth {
    Input: w: Integer
    Body: {
        UniqOpt.cmp_w = w
        ReturnValue(0)
    }
}
Function.SetDup {
    Body: {
        UniqOpt.only_dup = 1
        ReturnValue(0)
    }
}
Function.SetFile {
    Input: p: Address
    Body: {
        UniqOpt.file = p
        ReturnValue(0)
    }
}
Function.ResetCount {
    Body: {
        UniqOpt.gcount = 1
        ReturnValue(0)
    }
}
Function.BumpCount {
    Body: {
        UniqOpt.gcount = Add(UniqOpt.gcount, 1)
        ReturnValue(0)
    }
}
Function.WinLen {
    Input: n: Integer
    Output: Integer
    Body: {
        w = UniqOpt.cmp_w
        IfCondition EqualTo(w, 0) ThenBlock: {
            ReturnValue(n)
        }
        IfCondition GreaterThan(n, w) ThenBlock: {
            ReturnValue(w)
        }
        ReturnValue(n)
    }
}
Function.SameLine {
    Input: a: Address
    Input: an: Integer
    Input: b: Address
    Input: bn: Integer
    Output: Integer
    Body: {
        wa = WinLen(an)
        wb = WinLen(bn)
        IfCondition NotEqual(wa, wb) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(wa, 0) ThenBlock: {
            ReturnValue(1)
        }
        cmp = MemCompare(a, b, wa)
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
Function.ReadDigits {
    Input: s: Address
    Input: i: Integer
    Input: acc: Integer
    Output: Integer
    Body: {
        ch = GetByte(s, i)
        IfCondition LessThan(ch, 48) ThenBlock: {
            ReturnValue(acc)
        }
        IfCondition GreaterThan(ch, 57) ThenBlock: {
            ReturnValue(acc)
        }
        d = Subtract(ch, 48)
        acc2 = Add(Multiply(acc, 10), d)
        one = 1
        nxt = Add(i, one)
        hit = ReadDigits(s, nxt, acc2)
        ReturnValue(hit)
    }
}
Function.TokLen {
    Input: buf: Address
    Input: pos: Integer
    Output: Integer
    Body: {
        ch = GetByte(buf, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(0)
        }
        one = 1
        nxt = Add(pos, one)
        rest = TokLen(buf, nxt)
        ReturnValue(Add(rest, 1))
    }
}
Function.CopyTok {
    Input: buf: Address
    Input: pos: Integer
    Input: n: Integer
    Output: Address
    Body: {
        p = Allocate(Add(n, 1))
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            SetByte(p, i, GetByte(buf, Add(pos, i)))
            i = Add(i, one)
        }
        SetByte(p, n, 0)
        ReturnValue(p)
    }
}
Function.HandleOpt {
    Input: tok: Address
    Body: {
        c0 = GetByte(tok, 0)
        c1 = GetByte(tok, 1)
        c2 = GetByte(tok, 2)
        IfCondition EqualTo(c1, 122) ThenBlock: {
            SystemCall(60, 1)
        }
        IfCondition EqualTo(c1, 100) ThenBlock: {
            IfCondition EqualTo(c2, 0) ThenBlock: {
                SetDup()
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(c1, 119) ThenBlock: {
            w = ReadDigits(tok, 2, 0)
            SetWidth(w)
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}
Function.WalkArgs {
    Input: buf: Address
    Input: pos: Integer
    Body: {
        IfCondition GreaterEqual(pos, 4096) ThenBlock: {
            ReturnValue(0)
        }
        ch = GetByte(buf, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = TokLen(buf, pos)
        one = 1
        IfCondition EqualTo(ch, 45) ThenBlock: {
            tok = CopyTok(buf, pos, n)
            HandleOpt(tok)
            Deallocate(tok, 0)
            nxt = Add(pos, Add(n, one))
            WalkArgs(buf, nxt)
            ReturnValue(0)
        }
        IfCondition EqualTo(UniqOpt.file, 0) ThenBlock: {
            tok = CopyTok(buf, pos, n)
            SetFile(tok)
        }
        ReturnValue(0)
    }
}
Function.SkipProg {
    Input: buf: Address
    Input: i: Integer
    Output: Integer
    Body: {
        ch = GetByte(buf, i)
        one = 1
        nxt = Add(i, one)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(nxt)
        }
        hit = SkipProg(buf, nxt)
        ReturnValue(hit)
    }
}
SubRoutine.Main {
    args_buffer = GetArgs()
    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        ProcessUniq(0)
        SystemCall(60, 0)
    }
    pos = SkipProg(args_buffer, 0)
    WalkArgs(args_buffer, pos)
    Deallocate(args_buffer, 4096)
    filename = UniqOpt.file
    IfCondition EqualTo(filename, 0) ThenBlock: {
        ProcessUniq(0)
    } ElseBlock: {
        fd = SysOpen(filename)
        IfCondition LessThan(fd, 0) ThenBlock: {
            WriteStderr("uniq: ")
            WriteStderr(filename)
            WriteStderr(": cannot open\n")
            SystemCall(60, 1)
        }
        ProcessUniq(fd)
        SysClose(fd)
    }
    SystemCall(60, 0)
}

RunTask(Main)