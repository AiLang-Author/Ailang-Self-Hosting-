// uniq.ailang - GNU uniq.
// Records end at newline, or at NUL with -z. A final partial record is
// still a record and is emitted with the delimiter. -f/-s/-w limit the
// key. -f stops at the end of the line, so a huge field count stays cheap.
LibraryImport.Arena

FixedPool.U {
    "delim": Initialize=10
    "skip_f": Initialize=0
    "skip_c": Initialize=0
    "check_w": Initialize=0
    "fold": Initialize=0
    "count_on": Initialize=0
    "out_u": Initialize=1
    "out_f": Initialize=1
    "out_l": Initialize=0
    "dgroup": Initialize=0
    "grp": Initialize=0
    "outfd": Initialize=1
    "file0": Initialize=0
    "file1": Initialize=0
    "nfiles": Initialize=0
}

Function.WriteAll {
    Input: fd: Integer
    Input: buf: Address
    Input: len: Integer
    Body: {
        off = 0
        one = 1
        WhileLoop LessThan(off, len) {
            left = Subtract(len, off)
            p = Add(buf, off)
            n = SystemCall(1, fd, p, left)
            IfCondition LessEqual(n, 0) ThenBlock: {
                SystemCall(1, 2, "uniq: write error\n", 18)
                SystemCall(60, 1)
            }
            off = Add(off, n)
        }
    }
}

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.WriteByte {
    Input: fd: Integer
    Input: b: Integer
    Body: {
        buf = Allocate(1)
        SetByte(buf, 0, b)
        WriteAll(fd, buf, 1)
        Deallocate(buf, 1)
    }
}

Function.DieTry {
    Body: {
        WriteStderr("Try 'uniq --help' for more information.\n")
        SystemCall(60, 1)
    }
}

Function.BadNum {
    Input: text: Address
    Input: kind: Integer
    Body: {
        WriteStderr("uniq: ")
        WriteStderr(text)
        WriteStderr(": ")
        IfCondition EqualTo(kind, 0) ThenBlock: {
            WriteStderr("invalid number of fields to skip\n")
        }
        IfCondition EqualTo(kind, 1) ThenBlock: {
            WriteStderr("invalid number of bytes to skip\n")
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            WriteStderr("invalid number of bytes to compare\n")
        }
        SystemCall(60, 1)
    }
}

Function.BadRepeat {
    Input: arg: Address
    Body: {
        WriteStderr("uniq: invalid argument '")
        WriteStderr(arg)
        WriteStderr("' for '--all-repeated'\n")
        WriteStderr("Valid arguments are:\n")
        WriteStderr("  - 'none'\n")
        WriteStderr("  - 'prepend'\n")
        WriteStderr("  - 'separate'\n")
        DieTry()
    }
}

Function.BadGroup {
    Input: arg: Address
    Body: {
        WriteStderr("uniq: invalid argument '")
        WriteStderr(arg)
        WriteStderr("' for '--group'\n")
        WriteStderr("Valid arguments are:\n")
        WriteStderr("  - 'prepend'\n")
        WriteStderr("  - 'append'\n")
        WriteStderr("  - 'separate'\n")
        WriteStderr("  - 'both'\n")
        DieTry()
    }
}

Function.OpenFail {
    Input: path: Address
    Input: en: Integer
    Body: {
        WriteStderr("uniq: '")
        WriteStderr(path)
        WriteStderr("': ")
        IfCondition EqualTo(en, 2) ThenBlock: {
            WriteStderr("No such file or directory\n")
        }
        IfCondition EqualTo(en, 13) ThenBlock: {
            WriteStderr("Permission denied\n")
        }
        IfCondition EqualTo(en, 20) ThenBlock: {
            WriteStderr("Not a directory\n")
        }
        IfCondition EqualTo(en, 21) ThenBlock: {
            WriteStderr("Is a directory\n")
        }
        known = 0
        IfCondition EqualTo(en, 2) ThenBlock: { known = 1 }
        IfCondition EqualTo(en, 13) ThenBlock: { known = 1 }
        IfCondition EqualTo(en, 20) ThenBlock: { known = 1 }
        IfCondition EqualTo(en, 21) ThenBlock: { known = 1 }
        IfCondition EqualTo(known, 0) ThenBlock: {
            WriteStderr("Unknown error\n")
        }
        SystemCall(60, 1)
    }
}

Function.OpenIn {
    Input: path: Address
    Output: Integer
    Body: {
        dash = 0
        IfCondition StringEquals(path, "-") ThenBlock: {
            dash = 1
        }
        IfCondition EqualTo(dash, 1) ThenBlock: {
            ReturnValue(0)
        }
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            en = Subtract(0, fd)
            OpenFail(path, en)
        }
        ReturnValue(fd)
    }
}

Function.OpenOut {
    Input: path: Address
    Output: Integer
    Body: {
        dash = 0
        IfCondition StringEquals(path, "-") ThenBlock: {
            dash = 1
        }
        IfCondition EqualTo(dash, 1) ThenBlock: {
            ReturnValue(1)
        }
        fd = SystemCall(2, path, 577, 438)
        IfCondition LessThan(fd, 0) ThenBlock: {
            en = Subtract(0, fd)
            OpenFail(path, en)
        }
        ReturnValue(fd)
    }
}

Function.GetArgs {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buffer = Allocate(8192)
        n = SystemCall(0, fd, buffer, 8191)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buffer, 8192)
            ReturnValue(0)
        }
        SetByte(buffer, n, 0)
        ReturnValue(buffer)
    }
}

Function.SkipArg {
    Input: args: Address
    Input: pos: Integer
    Output: Integer
    Body: {
        i = pos
        one = 1
        WhileLoop NotEqual(GetByte(args, i), 0) {
            i = Add(i, one)
        }
        i = Add(i, one)
        ReturnValue(i)
    }
}

Function.FindEnv {
    Input: buf: Address
    Input: n: Integer
    Input: key: Address
    Output: Address
    Body: {
        keylen = StringLength(key)
        i = 0
        one = 1
        WhileLoop LessThan(i, n) {
            match = 1
            j = 0
            WhileLoop LessThan(j, keylen) {
                at = Add(i, j)
                a = GetByte(buf, at)
                b = GetByte(key, j)
                IfCondition NotEqual(a, b) ThenBlock: {
                    match = 0
                    j = keylen
                } ElseBlock: {
                    j = Add(j, one)
                }
            }
            IfCondition EqualTo(match, 1) ThenBlock: {
                eqat = Add(i, keylen)
                eq = GetByte(buf, eqat)
                IfCondition EqualTo(eq, 61) ThenBlock: {
                    val = Add(buf, eqat)
                    val = Add(val, one)
                    ReturnValue(val)
                }
            }
            WhileLoop And(LessThan(i, n), NotEqual(GetByte(buf, i), 0)) {
                i = Add(i, one)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.ParseSize {
    Input: s: Address
    Output: Integer
    Body: {
        i = 0
        one = 1
        c = GetByte(s, 0)
        c = BitwiseAnd(c, 255)
        IfCondition EqualTo(c, 43) ThenBlock: {
            i = one
            c = GetByte(s, i)
            c = BitwiseAnd(c, 255)
        }
        IfCondition EqualTo(c, 0) ThenBlock: {
            ReturnValue(-2)
        }
        acc = 0
        any = 0
        go = 1
        WhileLoop EqualTo(go, 1) {
            digit = 1
            IfCondition LessThan(c, 48) ThenBlock: {
                digit = 0
            }
            IfCondition GreaterThan(c, 57) ThenBlock: {
                digit = 0
            }
            IfCondition EqualTo(digit, 0) ThenBlock: {
                go = 0
            } ElseBlock: {
                any = 1
                IfCondition GreaterThan(acc, 922337203685477580) ThenBlock: {
                    ReturnValue(-1)
                }
                d = Subtract(c, 48)
                acc = Multiply(acc, 10)
                acc = Add(acc, d)
                IfCondition LessThan(acc, 0) ThenBlock: {
                    ReturnValue(-1)
                }
                i = Add(i, one)
                c = GetByte(s, i)
                c = BitwiseAnd(c, 255)
            }
        }
        IfCondition EqualTo(any, 0) ThenBlock: {
            ReturnValue(-2)
        }
        IfCondition NotEqual(c, 0) ThenBlock: {
            ReturnValue(-2)
        }
        ReturnValue(acc)
    }
}

Function.AfterPrefix {
    Input: s: Address
    Input: pre: Address
    Output: Integer
    Body: {
        n = StringLength(pre)
        i = 0
        one = 1
        ok = 1
        WhileLoop LessThan(i, n) {
            a = GetByte(s, i)
            b = GetByte(pre, i)
            IfCondition NotEqual(a, b) ThenBlock: {
                ok = 0
                i = n
            } ElseBlock: {
                i = Add(i, one)
            }
        }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(n)
    }
}

Function.IsSep {
    Input: ch: Integer
    Output: Integer
    Body: {
        c = BitwiseAnd(ch, 255)
        IfCondition EqualTo(c, 32) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(c, 9) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(c, 10) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.FoldByte {
    Input: ch: Integer
    Output: Integer
    Body: {
        c = BitwiseAnd(ch, 255)
        up = 0
        IfCondition GreaterEqual(c, 65) ThenBlock: {
            IfCondition LessEqual(c, 90) ThenBlock: {
                up = 1
            }
        }
        IfCondition EqualTo(up, 1) ThenBlock: {
            c = Add(c, 32)
        }
        ReturnValue(c)
    }
}

Function.FindField {
    Input: line: Address
    Input: size: Integer
    Output: Integer
    Body: {
        i = 0
        count = 0
        one = 1
        limit = U.skip_f
        WhileLoop And(LessThan(count, limit), LessThan(i, size)) {
            go = 1
            WhileLoop And(EqualTo(go, 1), LessThan(i, size)) {
                ch = GetByte(line, i)
                blank = IsSep(ch)
                IfCondition EqualTo(blank, 1) ThenBlock: {
                    i = Add(i, one)
                } ElseBlock: {
                    go = 0
                }
            }
            go = 1
            WhileLoop And(EqualTo(go, 1), LessThan(i, size)) {
                ch = GetByte(line, i)
                blank = IsSep(ch)
                IfCondition EqualTo(blank, 0) ThenBlock: {
                    i = Add(i, one)
                } ElseBlock: {
                    go = 0
                }
            }
            count = Add(count, one)
        }
        sc = U.skip_c
        remain = Subtract(size, i)
        IfCondition GreaterThan(sc, remain) ThenBlock: {
            i = size
        } ElseBlock: {
            i = Add(i, sc)
        }
        ReturnValue(i)
    }
}

Function.KeysDiffer {
    Input: a: Address
    Input: an: Integer
    Input: b: Address
    Input: bn: Integer
    Output: Integer
    Body: {
        al = an
        bl = bn
        w = U.check_w
        IfCondition GreaterEqual(w, 0) ThenBlock: {
            IfCondition GreaterThan(al, w) ThenBlock: {
                al = w
            }
            IfCondition GreaterThan(bl, w) ThenBlock: {
                bl = w
            }
        }
        IfCondition NotEqual(al, bl) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(al, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(U.fold, 0) ThenBlock: {
            cmp = MemCompare(a, b, al)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        i = 0
        one = 1
        WhileLoop LessThan(i, al) {
            ca = GetByte(a, i)
            cb = GetByte(b, i)
            fa = FoldByte(ca)
            fb = FoldByte(cb)
            IfCondition NotEqual(fa, fb) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, one)
        }
        ReturnValue(0)
    }
}

Function.WriteCount {
    Input: fd: Integer
    Input: n: Integer
    Body: {
        digs = Allocate(24)
        nd = 0
        one = 1
        mag = n
        IfCondition EqualTo(mag, 0) ThenBlock: {
            SetByte(digs, 0, 48)
            nd = 1
        }
        WhileLoop GreaterThan(mag, 0) {
            d = Modulo(mag, 10)
            SetByte(digs, nd, Add(48, d))
            nd = Add(nd, one)
            mag = Divide(mag, 10)
        }
        pad = 0
        IfCondition LessThan(nd, 7) ThenBlock: {
            pad = Subtract(7, nd)
        }
        out = Allocate(32)
        o = 0
        k = 0
        WhileLoop LessThan(k, pad) {
            SetByte(out, o, 32)
            o = Add(o, one)
            k = Add(k, one)
        }
        j = nd
        WhileLoop GreaterThan(j, 0) {
            j = Subtract(j, one)
            ch = GetByte(digs, j)
            SetByte(out, o, ch)
            o = Add(o, one)
        }
        SetByte(out, o, 32)
        o = Add(o, one)
        WriteAll(fd, out, o)
        Deallocate(digs, 24)
        Deallocate(out, 32)
    }
}

Function.WriteLine {
    Input: fd: Integer
    Input: buf: Address
    Input: len: Integer
    Input: matched: Integer
    Input: count: Integer
    Body: {
        show = 0
        IfCondition EqualTo(count, 0) ThenBlock: {
            IfCondition EqualTo(U.out_u, 1) ThenBlock: {
                show = 1
            }
        } ElseBlock: {
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(U.out_f, 1) ThenBlock: {
                    show = 1
                }
            } ElseBlock: {
                IfCondition EqualTo(U.out_l, 1) ThenBlock: {
                    show = 1
                }
            }
        }
        IfCondition EqualTo(show, 1) ThenBlock: {
            IfCondition EqualTo(U.count_on, 1) ThenBlock: {
                shown = Add(count, 1)
                WriteCount(fd, shown)
            }
            WriteAll(fd, buf, len)
        }
    }
}

Function.MissArg {
    Input: ch: Integer
    Input: longn: Address
    Body: {
        IfCondition EqualTo(longn, 0) ThenBlock: {
            tb = Allocate(2)
            SetByte(tb, 0, ch)
            SetByte(tb, 1, 0)
            WriteStderr("uniq: option requires an argument -- '")
            WriteStderr(tb)
            WriteStderr("'\n")
            DieTry()
        }
        WriteStderr("uniq: option '")
        WriteStderr(longn)
        WriteStderr("' requires an argument\n")
        DieTry()
    }
}

Function.NoteFile {
    Input: nfiles: Integer
    Input: argp: Address
    Body: {
        IfCondition GreaterEqual(nfiles, 2) ThenBlock: {
            WriteStderr("uniq: extra operand '")
            WriteStderr(argp)
            WriteStderr("'\n")
            DieTry()
        }
    }
}

Function.Process {
    Input: fd: Integer
    Body: {
        one = 1
        delim = U.delim
        outfd = U.outfd
        g = U.grp
        dg = U.dgroup
        later = U.out_l
        fast = 0
        IfCondition EqualTo(U.out_u, 1) ThenBlock: {
            IfCondition EqualTo(U.out_f, 1) ThenBlock: {
                IfCondition EqualTo(U.count_on, 0) ThenBlock: {
                    IfCondition EqualTo(later, 0) ThenBlock: {
                        fast = 1
                    }
                }
            }
        }
        inbuf = Allocate(262144)
        line = Allocate(65536)
        prev = Allocate(65536)
        empty = 0
        pos = empty
        blen = empty
        have = 0
        printed = 0
        match_count = 0
        first_delim = 1
        plen = 0
        pkoff = 0
        pklen = 0
        stop = 0
        WhileLoop EqualTo(stop, 0) {
            llen = empty
            done = empty
            eof = empty
            WhileLoop EqualTo(done, 0) {
                IfCondition GreaterEqual(pos, blen) ThenBlock: {
                    blen = SystemCall(0, fd, inbuf, 262144)
                    pos = empty
                    IfCondition LessThan(blen, 0) ThenBlock: {
                        WriteStderr("uniq: read error\n")
                        SystemCall(60, 1)
                    }
                    IfCondition EqualTo(blen, 0) ThenBlock: {
                        eof = 1
                        done = 1
                    }
                }
                IfCondition EqualTo(done, 0) ThenBlock: {
                    ch = GetByte(inbuf, pos)
                    ch = BitwiseAnd(ch, 255)
                    pos = Add(pos, one)
                    IfCondition EqualTo(ch, delim) ThenBlock: {
                        IfCondition LessThan(llen, 65535) ThenBlock: {
                            SetByte(line, llen, ch)
                            llen = Add(llen, one)
                        }
                        done = 1
                    } ElseBlock: {
                        IfCondition LessThan(llen, 65534) ThenBlock: {
                            SetByte(line, llen, ch)
                            llen = Add(llen, one)
                        }
                    }
                }
            }
            IfCondition EqualTo(eof, 1) ThenBlock: {
                IfCondition GreaterThan(llen, 0) ThenBlock: {
                    IfCondition LessThan(llen, 65535) ThenBlock: {
                        SetByte(line, llen, delim)
                        llen = Add(llen, one)
                    }
                    eof = 0
                }
            }
            IfCondition EqualTo(eof, 1) ThenBlock: {
                stop = 1
            }
            IfCondition EqualTo(stop, 0) ThenBlock: {
                clen = Subtract(llen, one)
                koff = FindField(line, clen)
                klen = Subtract(clen, koff)
                fresh = 0
                hold = 0
                IfCondition EqualTo(fast, 0) ThenBlock: {
                    IfCondition EqualTo(have, 0) ThenBlock: {
                        hold = 1
                    }
                }
                IfCondition EqualTo(hold, 1) ThenBlock: {
                    MemoryCopy(prev, line, llen)
                    plen = llen
                    pkoff = koff
                    pklen = klen
                    have = 1
                    fresh = 1
                }
                IfCondition EqualTo(fresh, 0) ThenBlock: {
                    newg = 1
                    matched = 0
                    IfCondition EqualTo(have, 1) ThenBlock: {
                        la = Add(line, koff)
                        pa = Add(prev, pkoff)
                        diff = KeysDiffer(la, klen, pa, pklen)
                        IfCondition EqualTo(diff, 0) ThenBlock: {
                            newg = 0
                            matched = 1
                        }
                    }
                    IfCondition EqualTo(fast, 1) ThenBlock: {
                        sep = 0
                        IfCondition EqualTo(newg, 1) ThenBlock: {
                            IfCondition NotEqual(g, 0) ThenBlock: {
                                IfCondition EqualTo(g, 1) ThenBlock: {
                                    sep = 1
                                }
                                IfCondition EqualTo(g, 4) ThenBlock: {
                                    sep = 1
                                }
                                IfCondition EqualTo(printed, 1) ThenBlock: {
                                    IfCondition EqualTo(g, 2) ThenBlock: {
                                        sep = 1
                                    }
                                    IfCondition EqualTo(g, 3) ThenBlock: {
                                        sep = 1
                                    }
                                }
                            }
                        }
                        IfCondition EqualTo(sep, 1) ThenBlock: {
                            WriteByte(outfd, delim)
                        }
                        show = 0
                        IfCondition EqualTo(newg, 1) ThenBlock: {
                            show = 1
                        }
                        IfCondition NotEqual(g, 0) ThenBlock: {
                            show = 1
                        }
                        IfCondition EqualTo(show, 1) ThenBlock: {
                            WriteAll(outfd, line, llen)
                            MemoryCopy(prev, line, llen)
                            plen = llen
                            pkoff = koff
                            pklen = klen
                            have = 1
                            printed = 1
                        }
                    } ElseBlock: {
                        IfCondition EqualTo(matched, 1) ThenBlock: {
                            match_count = Add(match_count, one)
                        }
                        IfCondition NotEqual(dg, 0) ThenBlock: {
                            IfCondition EqualTo(matched, 0) ThenBlock: {
                                IfCondition GreaterThan(match_count, 0) ThenBlock: {
                                    first_delim = 0
                                }
                            } ElseBlock: {
                                IfCondition EqualTo(match_count, 1) ThenBlock: {
                                    put = 0
                                    IfCondition EqualTo(dg, 1) ThenBlock: {
                                        put = 1
                                    }
                                    IfCondition EqualTo(dg, 2) ThenBlock: {
                                        IfCondition EqualTo(first_delim, 0) ThenBlock: {
                                            put = 1
                                        }
                                    }
                                    IfCondition EqualTo(put, 1) ThenBlock: {
                                        WriteByte(outfd, delim)
                                    }
                                }
                            }
                        }
                        emit = 0
                        IfCondition EqualTo(matched, 0) ThenBlock: {
                            emit = 1
                        }
                        IfCondition EqualTo(later, 1) ThenBlock: {
                            emit = 1
                        }
                        IfCondition EqualTo(emit, 1) ThenBlock: {
                            WriteLine(outfd, prev, plen, matched, match_count)
                            MemoryCopy(prev, line, llen)
                            plen = llen
                            pkoff = koff
                            pklen = klen
                            IfCondition EqualTo(matched, 0) ThenBlock: {
                                match_count = 0
                            }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(fast, 1) ThenBlock: {
            IfCondition EqualTo(printed, 1) ThenBlock: {
                tail = 0
                IfCondition EqualTo(g, 2) ThenBlock: {
                    tail = 1
                }
                IfCondition EqualTo(g, 4) ThenBlock: {
                    tail = 1
                }
                IfCondition EqualTo(tail, 1) ThenBlock: {
                    WriteByte(outfd, delim)
                }
            }
        } ElseBlock: {
            IfCondition EqualTo(have, 1) ThenBlock: {
                WriteLine(outfd, prev, plen, 0, match_count)
            }
        }
        Deallocate(inbuf, 262144)
        Deallocate(line, 65536)
        Deallocate(prev, 65536)
    }
}

Function.ParseOpts {
    Input: args: Address
    Body: {
        one = 1
        delim = 10
        skip_f = 0
        skip_c = 0
        check_w = -1
        fold = 0
        count_on = 0
        out_u = 1
        out_f = 1
        out_l = 0
        dgroup = 0
        grp = 0
        opt_used = 0
        sfo = 0
        nfiles = 0
        file0 = 0
        file1 = 0
        end_opts = 0
        posixly = 0
        strict = 0
        efd = SystemCall(2, "/proc/self/environ", 0, 0)
        IfCondition GreaterEqual(efd, 0) ThenBlock: {
            envb = Allocate(65536)
            envn = SystemCall(0, efd, envb, 65535)
            SystemCall(3, efd)
            IfCondition LessThan(envn, 0) ThenBlock: {
                envn = 0
            }
            SetByte(envb, envn, 0)
            pval = FindEnv(envb, envn, "POSIXLY_CORRECT")
            IfCondition NotEqual(pval, 0) ThenBlock: {
                posixly = 1
            }
            vval = FindEnv(envb, envn, "_POSIX2_VERSION")
            ver = 200809
            IfCondition NotEqual(vval, 0) ThenBlock: {
                vb = GetByte(vval, 0)
                IfCondition NotEqual(vb, 0) ThenBlock: {
                    pv = ParseSize(vval)
                    IfCondition GreaterEqual(pv, 0) ThenBlock: {
                        ver = pv
                    }
                }
            }
            IfCondition GreaterEqual(ver, 200112) ThenBlock: {
                IfCondition LessThan(ver, 200809) ThenBlock: {
                    strict = 1
                }
            }
        }
        pos = SkipArg(args, 0)
        go = 1
        WhileLoop EqualTo(go, 1) {
            c0 = GetByte(args, pos)
            c0 = BitwiseAnd(c0, 255)
            halt = 0
            IfCondition EqualTo(c0, 0) ThenBlock: {
                halt = 1
            }
            IfCondition GreaterEqual(pos, 8190) ThenBlock: {
                halt = 1
            }
            IfCondition EqualTo(halt, 1) ThenBlock: {
                go = 0
            } ElseBlock: {
                c1at = Add(pos, one)
                c1 = GetByte(args, c1at)
                c1 = BitwiseAnd(c1, 255)
                argp = Add(args, pos)
                take = 0
                IfCondition EqualTo(end_opts, 1) ThenBlock: {
                    take = 1
                }
                IfCondition EqualTo(posixly, 1) ThenBlock: {
                    IfCondition GreaterThan(nfiles, 0) ThenBlock: {
                        take = 1
                    }
                }
                mode = 0
                IfCondition EqualTo(take, 0) ThenBlock: {
                    IfCondition EqualTo(c0, 45) ThenBlock: {
                        IfCondition EqualTo(c1, 45) ThenBlock: {
                            mode = 1
                        } ElseBlock: {
                            IfCondition NotEqual(c1, 0) ThenBlock: {
                                mode = 2
                            }
                        }
                    }
                    IfCondition EqualTo(mode, 0) ThenBlock: {
                        IfCondition EqualTo(c0, 43) ThenBlock: {
                            IfCondition EqualTo(strict, 0) ThenBlock: {
                                mode = 3
                            }
                        }
                    }
                }
                as_file = 0
                IfCondition EqualTo(mode, 0) ThenBlock: {
                    as_file = 1
                }
                IfCondition EqualTo(mode, 1) ThenBlock: {
                    c2 = GetByte(argp, 2)
                    c2 = BitwiseAnd(c2, 255)
                    IfCondition EqualTo(c2, 0) ThenBlock: {
                        end_opts = 1
                        pos = SkipArg(args, pos)
                    } ElseBlock: {
                        known = 0
                        ate = 0
                        IfCondition StringEquals(argp, "--count") ThenBlock: {
                            count_on = 1
                            opt_used = 1
                            known = 1
                        }
                        IfCondition StringEquals(argp, "--repeated") ThenBlock: {
                            out_u = 0
                            opt_used = 1
                            known = 1
                        }
                        IfCondition StringEquals(argp, "--unique") ThenBlock: {
                            out_f = 0
                            opt_used = 1
                            known = 1
                        }
                        IfCondition StringEquals(argp, "--ignore-case") ThenBlock: {
                            fold = 1
                            known = 1
                        }
                        IfCondition StringEquals(argp, "--zero-terminated") ThenBlock: {
                            delim = 0
                            known = 1
                        }
                        idx = AfterPrefix(argp, "--all-repeated")
                        IfCondition GreaterEqual(idx, 0) ThenBlock: {
                            ch = GetByte(argp, idx)
                            ch = BitwiseAnd(ch, 255)
                            IfCondition EqualTo(ch, 0) ThenBlock: {
                                out_u = 0
                                out_l = 1
                                opt_used = 1
                                dgroup = 0
                                known = 1
                            }
                            IfCondition EqualTo(ch, 61) ThenBlock: {
                                idx1 = Add(idx, one)
                                suf = Add(argp, idx1)
                                okm = 0
                                IfCondition StringEquals(suf, "none") ThenBlock: {
                                    dgroup = 0
                                    okm = 1
                                }
                                IfCondition StringEquals(suf, "prepend") ThenBlock: {
                                    dgroup = 1
                                    okm = 1
                                }
                                IfCondition StringEquals(suf, "separate") ThenBlock: {
                                    dgroup = 2
                                    okm = 1
                                }
                                IfCondition EqualTo(okm, 0) ThenBlock: {
                                    BadRepeat(suf)
                                }
                                out_u = 0
                                out_l = 1
                                opt_used = 1
                                known = 1
                            }
                        }
                        idx = AfterPrefix(argp, "--group")
                        IfCondition GreaterEqual(idx, 0) ThenBlock: {
                            ch = GetByte(argp, idx)
                            ch = BitwiseAnd(ch, 255)
                            IfCondition EqualTo(ch, 0) ThenBlock: {
                                grp = 3
                                known = 1
                            }
                            IfCondition EqualTo(ch, 61) ThenBlock: {
                                idx1 = Add(idx, one)
                                suf = Add(argp, idx1)
                                okm = 0
                                IfCondition StringEquals(suf, "prepend") ThenBlock: {
                                    grp = 1
                                    okm = 1
                                }
                                IfCondition StringEquals(suf, "append") ThenBlock: {
                                    grp = 2
                                    okm = 1
                                }
                                IfCondition StringEquals(suf, "separate") ThenBlock: {
                                    grp = 3
                                    okm = 1
                                }
                                IfCondition StringEquals(suf, "both") ThenBlock: {
                                    grp = 4
                                    okm = 1
                                }
                                IfCondition EqualTo(okm, 0) ThenBlock: {
                                    BadGroup(suf)
                                }
                                known = 1
                            }
                        }
                        idx = AfterPrefix(argp, "--skip-fields")
                        IfCondition GreaterEqual(idx, 0) ThenBlock: {
                            ch = GetByte(argp, idx)
                            ch = BitwiseAnd(ch, 255)
                            IfCondition EqualTo(ch, 0) ThenBlock: {
                                pos = SkipArg(args, pos)
                                nb = GetByte(args, pos)
                                IfCondition EqualTo(nb, 0) ThenBlock: {
                                    MissArg(0, "--skip-fields")
                                }
                                nump = Add(args, pos)
                                val = ParseSize(nump)
                                IfCondition EqualTo(val, -2) ThenBlock: {
                                    BadNum(nump, 0)
                                }
                                skip_f = val
                                sfo = 2
                                pos = SkipArg(args, pos)
                                ate = 1
                                known = 1
                            }
                            IfCondition EqualTo(ch, 61) ThenBlock: {
                                idx1 = Add(idx, one)
                                nump = Add(argp, idx1)
                                val = ParseSize(nump)
                                IfCondition EqualTo(val, -2) ThenBlock: {
                                    BadNum(nump, 0)
                                }
                                skip_f = val
                                sfo = 2
                                known = 1
                            }
                        }
                        idx = AfterPrefix(argp, "--skip-chars")
                        IfCondition GreaterEqual(idx, 0) ThenBlock: {
                            ch = GetByte(argp, idx)
                            ch = BitwiseAnd(ch, 255)
                            IfCondition EqualTo(ch, 0) ThenBlock: {
                                pos = SkipArg(args, pos)
                                nb = GetByte(args, pos)
                                IfCondition EqualTo(nb, 0) ThenBlock: {
                                    MissArg(0, "--skip-chars")
                                }
                                nump = Add(args, pos)
                                val = ParseSize(nump)
                                IfCondition EqualTo(val, -2) ThenBlock: {
                                    BadNum(nump, 1)
                                }
                                skip_c = val
                                pos = SkipArg(args, pos)
                                ate = 1
                                known = 1
                            }
                            IfCondition EqualTo(ch, 61) ThenBlock: {
                                idx1 = Add(idx, one)
                                nump = Add(argp, idx1)
                                val = ParseSize(nump)
                                IfCondition EqualTo(val, -2) ThenBlock: {
                                    BadNum(nump, 1)
                                }
                                skip_c = val
                                known = 1
                            }
                        }
                        idx = AfterPrefix(argp, "--check-chars")
                        IfCondition GreaterEqual(idx, 0) ThenBlock: {
                            ch = GetByte(argp, idx)
                            ch = BitwiseAnd(ch, 255)
                            IfCondition EqualTo(ch, 0) ThenBlock: {
                                pos = SkipArg(args, pos)
                                nb = GetByte(args, pos)
                                IfCondition EqualTo(nb, 0) ThenBlock: {
                                    MissArg(0, "--check-chars")
                                }
                                nump = Add(args, pos)
                                val = ParseSize(nump)
                                IfCondition EqualTo(val, -2) ThenBlock: {
                                    BadNum(nump, 2)
                                }
                                check_w = val
                                pos = SkipArg(args, pos)
                                ate = 1
                                known = 1
                            }
                            IfCondition EqualTo(ch, 61) ThenBlock: {
                                idx1 = Add(idx, one)
                                nump = Add(argp, idx1)
                                val = ParseSize(nump)
                                IfCondition EqualTo(val, -2) ThenBlock: {
                                    BadNum(nump, 2)
                                }
                                check_w = val
                                known = 1
                            }
                        }
                        IfCondition EqualTo(known, 0) ThenBlock: {
                            WriteStderr("uniq: unrecognized option '")
                            WriteStderr(argp)
                            WriteStderr("'\n")
                            DieTry()
                        }
                        IfCondition EqualTo(ate, 0) ThenBlock: {
                            pos = SkipArg(args, pos)
                        }
                    }
                }
                IfCondition EqualTo(mode, 2) ThenBlock: {
                    pos = Add(pos, one)
                    cluster = 1
                    WhileLoop EqualTo(cluster, 1) {
                        f = GetByte(args, pos)
                        f = BitwiseAnd(f, 255)
                        IfCondition EqualTo(f, 0) ThenBlock: {
                            pos = Add(pos, one)
                            cluster = 0
                        } ElseBlock: {
                            ateflag = 0
                            digit = 0
                            IfCondition GreaterEqual(f, 48) ThenBlock: {
                                IfCondition LessEqual(f, 57) ThenBlock: {
                                    digit = 1
                                }
                            }
                            IfCondition EqualTo(digit, 1) ThenBlock: {
                                IfCondition EqualTo(sfo, 2) ThenBlock: {
                                    skip_f = 0
                                }
                                IfCondition GreaterEqual(skip_f, 0) ThenBlock: {
                                    IfCondition GreaterThan(skip_f, 922337203685477580) ThenBlock: {
                                        skip_f = -1
                                    } ElseBlock: {
                                        d = Subtract(f, 48)
                                        skip_f = Multiply(skip_f, 10)
                                        skip_f = Add(skip_f, d)
                                        IfCondition LessThan(skip_f, 0) ThenBlock: {
                                            skip_f = -1
                                        }
                                    }
                                }
                                sfo = 1
                                pos = Add(pos, one)
                                ateflag = 1
                            }
                            IfCondition EqualTo(ateflag, 0) ThenBlock: {
                                IfCondition EqualTo(f, 99) ThenBlock: {
                                    count_on = 1
                                    opt_used = 1
                                    pos = Add(pos, one)
                                    ateflag = 1
                                }
                            }
                            IfCondition EqualTo(ateflag, 0) ThenBlock: {
                                IfCondition EqualTo(f, 100) ThenBlock: {
                                    out_u = 0
                                    opt_used = 1
                                    pos = Add(pos, one)
                                    ateflag = 1
                                }
                            }
                            IfCondition EqualTo(ateflag, 0) ThenBlock: {
                                IfCondition EqualTo(f, 68) ThenBlock: {
                                    out_u = 0
                                    out_l = 1
                                    opt_used = 1
                                    dgroup = 0
                                    pos = Add(pos, one)
                                    ateflag = 1
                                }
                            }
                            IfCondition EqualTo(ateflag, 0) ThenBlock: {
                                IfCondition EqualTo(f, 105) ThenBlock: {
                                    fold = 1
                                    pos = Add(pos, one)
                                    ateflag = 1
                                }
                            }
                            IfCondition EqualTo(ateflag, 0) ThenBlock: {
                                IfCondition EqualTo(f, 117) ThenBlock: {
                                    out_f = 0
                                    opt_used = 1
                                    pos = Add(pos, one)
                                    ateflag = 1
                                }
                            }
                            IfCondition EqualTo(ateflag, 0) ThenBlock: {
                                IfCondition EqualTo(f, 122) ThenBlock: {
                                    delim = 0
                                    pos = Add(pos, one)
                                    ateflag = 1
                                }
                            }
                            IfCondition EqualTo(ateflag, 0) ThenBlock: {
                                need = 0
                                kind = 0
                                IfCondition EqualTo(f, 102) ThenBlock: {
                                    need = 1
                                    kind = 0
                                }
                                IfCondition EqualTo(f, 115) ThenBlock: {
                                    need = 1
                                    kind = 1
                                }
                                IfCondition EqualTo(f, 119) ThenBlock: {
                                    need = 1
                                    kind = 2
                                }
                                IfCondition EqualTo(need, 1) ThenBlock: {
                                    nxt = Add(pos, one)
                                    nb = GetByte(args, nxt)
                                    nb = BitwiseAnd(nb, 255)
                                    IfCondition EqualTo(nb, 0) ThenBlock: {
                                        pos = Add(nxt, one)
                                        nb2 = GetByte(args, pos)
                                        IfCondition EqualTo(nb2, 0) ThenBlock: {
                                            MissArg(f, 0)
                                        }
                                        nump = Add(args, pos)
                                        val = ParseSize(nump)
                                        IfCondition EqualTo(val, -2) ThenBlock: {
                                            BadNum(nump, kind)
                                        }
                                        pos = SkipArg(args, pos)
                                    } ElseBlock: {
                                        nump = Add(args, nxt)
                                        val = ParseSize(nump)
                                        IfCondition EqualTo(val, -2) ThenBlock: {
                                            BadNum(nump, kind)
                                        }
                                        pos = SkipArg(args, nxt)
                                    }
                                    IfCondition EqualTo(kind, 0) ThenBlock: {
                                        skip_f = val
                                        sfo = 2
                                    }
                                    IfCondition EqualTo(kind, 1) ThenBlock: {
                                        skip_c = val
                                    }
                                    IfCondition EqualTo(kind, 2) ThenBlock: {
                                        check_w = val
                                    }
                                    cluster = 0
                                    ateflag = 1
                                }
                            }
                            IfCondition EqualTo(ateflag, 0) ThenBlock: {
                                tb = Allocate(2)
                                SetByte(tb, 0, f)
                                SetByte(tb, 1, 0)
                                WriteStderr("uniq: invalid option -- '")
                                WriteStderr(tb)
                                WriteStderr("'\n")
                                DieTry()
                            }
                        }
                    }
                }
                IfCondition EqualTo(mode, 3) ThenBlock: {
                    val = ParseSize(argp)
                    IfCondition GreaterEqual(val, -1) ThenBlock: {
                        skip_c = val
                        pos = SkipArg(args, pos)
                    } ElseBlock: {
                        as_file = 1
                    }
                }
                IfCondition EqualTo(as_file, 1) ThenBlock: {
                    NoteFile(nfiles, argp)
                    IfCondition EqualTo(nfiles, 0) ThenBlock: {
                        file0 = argp
                    }
                    IfCondition EqualTo(nfiles, 1) ThenBlock: {
                        file1 = argp
                    }
                    nfiles = Add(nfiles, one)
                    pos = SkipArg(args, pos)
                }
            }
        }
        IfCondition NotEqual(grp, 0) ThenBlock: {
            IfCondition EqualTo(opt_used, 1) ThenBlock: {
                WriteStderr("uniq: --group is mutually exclusive with -c/-d/-D/-u\n")
                DieTry()
            }
        }
        IfCondition EqualTo(count_on, 1) ThenBlock: {
            IfCondition EqualTo(out_l, 1) ThenBlock: {
                WriteStderr("uniq: printing all duplicated lines and repeat counts is meaningless\n")
                DieTry()
            }
        }
        big = 9223372036854775807
        sf = skip_f
        IfCondition EqualTo(sf, -1) ThenBlock: {
            sf = big
        }
        sc = skip_c
        IfCondition EqualTo(sc, -1) ThenBlock: {
            sc = big
        }
        U.delim = delim
        U.skip_f = sf
        U.skip_c = sc
        U.check_w = check_w
        U.fold = fold
        U.count_on = count_on
        U.out_u = out_u
        U.out_f = out_f
        U.out_l = out_l
        U.dgroup = dgroup
        U.grp = grp
        U.file0 = file0
        U.file1 = file1
        U.nfiles = nfiles
    }
}

SubRoutine.Main {
    args = GetArgs()
    IfCondition EqualTo(args, 0) ThenBlock: {
        args = Allocate(4)
        SetByte(args, 0, 0)
    }
    ParseOpts(args)
    infd = 0
    IfCondition GreaterThan(U.nfiles, 0) ThenBlock: {
        infd = OpenIn(U.file0)
    }
    outfd = 1
    IfCondition GreaterThan(U.nfiles, 1) ThenBlock: {
        outfd = OpenOut(U.file1)
    }
    U.outfd = outfd
    Process(infd)
    SystemCall(60, 0)
}

RunTask(Main)
