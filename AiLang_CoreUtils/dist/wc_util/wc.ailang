// wc_optimized.ailang - Fast word, line, character, and byte counter
// Optimized with MemChr, buffered output, and pointer arithmetic
// Version 2.2 - With DebugPerf timing

LibraryImport.Arena

FixedPool.WcConfig {
    "count_lines": Initialize=0       
    "count_words": Initialize=0       
    "count_chars": Initialize=0       
    "max_line_length": Initialize=0
    "show_all": Initialize=1
    "width": Initialize=1
    "total_mode": Initialize=0
}

FixedPool.WcPrint {
    "started": Initialize=0
}

FixedPool.WcCounts {
    "lines": Initialize=0
    "words": Initialize=0
    "chars": Initialize=0
    "max_line": Initialize=0
    "current_line_len": Initialize=0
    "in_word": Initialize=0
}

FixedPool.WcConstants {
    "BUFFER_SIZE": Initialize=262144  
    "MAX_FILES": Initialize=100
}

FixedPool.WcTotals {
    "total_lines": Initialize=0
    "total_words": Initialize=0
    "total_chars": Initialize=0
    "total_max_line": Initialize=0
}

FixedPool.OutputBuffer {
    "buffer": Initialize=0
    "position": Initialize=0
    "size": Initialize=65536
}

FixedPool.Spaces {
    "pad7": Initialize="       "  
}

// === BUFFERED OUTPUT FUNCTIONS ===

Function.InitBuffers {
    Body: {
        OutputBuffer.buffer = Allocate(OutputBuffer.size)
        OutputBuffer.position = 0
    }
}

Function.FlushOutput {
    Body: {
        IfCondition GreaterThan(OutputBuffer.position, 0) ThenBlock: {
            SystemCall(1, 1, OutputBuffer.buffer, OutputBuffer.position)
            OutputBuffer.position = 0
        }
    }
}

Function.WriteBuffered {
    Input: data: Address
    Input: len: Integer
    Body: {
        space_left = Subtract(OutputBuffer.size, OutputBuffer.position)
        IfCondition LessThan(space_left, len) ThenBlock: {
            FlushOutput()
        }
        
        MemoryCopy(Add(OutputBuffer.buffer, OutputBuffer.position), data, len)
        OutputBuffer.position = Add(OutputBuffer.position, len)
    }
}

Function.WriteByteBuffered {
    Input: byte: Integer
    Body: {
        IfCondition GreaterEqual(OutputBuffer.position, OutputBuffer.size) ThenBlock: {
            FlushOutput()
        }
        WRMEM_8(OutputBuffer.buffer, OutputBuffer.position, byte)
        OutputBuffer.position = Add(OutputBuffer.position, 1)
    }
}

Function.WriteStderr {
    Input: buffer: Address
    Input: len: Integer
    Body: {
        SystemCall(1, 2, buffer, len)
    }
}

Function.GetStringLength {
    Input: str: Address
    Output: Integer
    Body: {
        len = 0
        WhileLoop NotEqual(RDMEM_8(str, len), 0) {
            len = Add(len, 1)
        }
        ReturnValue(len)
    }
}

// === STRING UTILITIES ===

Function.StringsMatch {
    Input: str1: Address
    Input: str2: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop 1 {
            ch1 = RDMEM_8(str1, i)
            ch2 = RDMEM_8(str2, i)
            
            IfCondition NotEqual(ch1, ch2) ThenBlock: {
                ReturnValue(0)
            }
            
            IfCondition EqualTo(ch1, 0) ThenBlock: {
                ReturnValue(1)
            }
            
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.CheckIfFlag {
    Input: str: Address
    Output: Integer
    Body: {
        first = RDMEM_8(str, 0)
        second = RDMEM_8(str, 1)
        
        IfCondition And(EqualTo(first, 45), NotEqual(second, 0)) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// === COUNTING LOGIC ===

Function.ResetCounts {
    Body: {
        WcCounts.lines = 0
        WcCounts.words = 0
        WcCounts.chars = 0
        WcCounts.max_line = 0
        WcCounts.current_line_len = 0
        WcCounts.in_word = 0
    }
}

Function.CountFileOptimized {
    Input: fd: Integer
    Body: {
        buffer = Allocate(WcConstants.BUFFER_SIZE)
        
        need_words = WcConfig.count_words
        need_max_line = WcConfig.max_line_length
        
        IfCondition EqualTo(WcConfig.show_all, 1) ThenBlock: {
            need_words = 1
        }
        
        keep_reading = 1
        WhileLoop EqualTo(keep_reading, 1) {
            bytes_read = SystemCall(0, fd, buffer, WcConstants.BUFFER_SIZE)
            
            IfCondition LessEqual(bytes_read, 0) ThenBlock: {
                keep_reading = 0
            } ElseBlock: {
                WcCounts.chars = Add(WcCounts.chars, bytes_read)
                
                // Fast line count using MemChr
                scan_pos = 0
                WhileLoop LessThan(scan_pos, bytes_read) {
                    search_start = Add(buffer, scan_pos)
                    search_len = Subtract(bytes_read, scan_pos)
                    newline_offset = MemChr(search_start, 10, search_len)
                    
                    IfCondition LessThan(newline_offset, 0) ThenBlock: {
                        IfCondition NotEqual(need_max_line, 0) ThenBlock: {
                            WcCounts.current_line_len = Add(WcCounts.current_line_len, search_len)
                        }
                        BreakLoop
                    } ElseBlock: {
                        WcCounts.lines = Add(WcCounts.lines, 1)
                        
                        IfCondition NotEqual(need_max_line, 0) ThenBlock: {
                            line_len = Add(WcCounts.current_line_len, newline_offset)
                            IfCondition GreaterThan(line_len, WcCounts.max_line) ThenBlock: {
                                WcCounts.max_line = line_len
                            }
                            WcCounts.current_line_len = 0
                        }
                        
                        scan_pos = Add(scan_pos, Add(newline_offset, 1))
                    }
                }
                
                // Word counting - only if needed
                IfCondition NotEqual(need_words, 0) ThenBlock: {
                    ptr = buffer
                    end_ptr = Add(buffer, bytes_read)
                    
                    WhileLoop LessThan(ptr, end_ptr) {
                        ch = RDMEM_8(ptr, 0)
                        
                        is_space = 0
                        Branch ch {
                            Case 9: { is_space = 1 }
                            Case 10: { is_space = 1 }
                            Case 13: { is_space = 1 }
                            Case 32: { is_space = 1 }
                            Default: { is_space = 0 }
                        }
                        
                        Fork EqualTo(is_space, 1) TrueBlock: {
                            WcCounts.in_word = 0
                        } FalseBlock: {
                            Fork EqualTo(WcCounts.in_word, 0) TrueBlock: {
                                WcCounts.words = Add(WcCounts.words, 1)
                                WcCounts.in_word = 1
                            } FalseBlock: {
                            }
                        }
                        
                        ptr = Add(ptr, 1)
                    }
                }
            }
        }
        
        IfCondition And(NotEqual(need_max_line, 0), GreaterThan(WcCounts.current_line_len, WcCounts.max_line)) ThenBlock: {
            WcCounts.max_line = WcCounts.current_line_len
        }
        
        Deallocate(buffer, WcConstants.BUFFER_SIZE)
    }
}

// === BUFFERED OUTPUT FORMATTING ===

Function.PrintFormattedNumber {
    Input: num: Integer
    Body: {
        num_str = NumberToString(num)
        num_len = GetStringLength(num_str)

        pad = Subtract(WcConfig.width, num_len)
        IfCondition LessThan(pad, 0) ThenBlock: {
            pad = 0
        }

        IfCondition EqualTo(WcPrint.started, 1) ThenBlock: {
            WriteByteBuffered(32)
        }
        WcPrint.started = 1

        WhileLoop GreaterThan(pad, 0) {
            WriteByteBuffered(32)
            pad = Subtract(pad, 1)
        }

        WriteBuffered(num_str, num_len)
    }
}

Function.PrintResults {
    Input: filename: Address
    Body: {
        WcPrint.started = 0
        should_show_lines = 0
        IfCondition EqualTo(WcConfig.show_all, 1) ThenBlock: {
            should_show_lines = 1
        } ElseBlock: {
            IfCondition EqualTo(WcConfig.count_lines, 1) ThenBlock: {
                should_show_lines = 1
            }
        }

        IfCondition EqualTo(should_show_lines, 1) ThenBlock: {
            PrintFormattedNumber(WcCounts.lines)
        }

        should_show_words = 0
        IfCondition EqualTo(WcConfig.show_all, 1) ThenBlock: {
            should_show_words = 1
        } ElseBlock: {
            IfCondition EqualTo(WcConfig.count_words, 1) ThenBlock: {
                should_show_words = 1
            }
        }

        IfCondition EqualTo(should_show_words, 1) ThenBlock: {
            PrintFormattedNumber(WcCounts.words)
        }

        should_show_chars = 0
        IfCondition EqualTo(WcConfig.show_all, 1) ThenBlock: {
            should_show_chars = 1
        } ElseBlock: {
            IfCondition EqualTo(WcConfig.count_chars, 1) ThenBlock: {
                should_show_chars = 1
            }
        }

        IfCondition EqualTo(should_show_chars, 1) ThenBlock: {
            PrintFormattedNumber(WcCounts.chars)
        }

        IfCondition EqualTo(WcConfig.max_line_length, 1) ThenBlock: {
            PrintFormattedNumber(WcCounts.max_line)
        }

        IfCondition NotEqual(filename, 0) ThenBlock: {
            IfCondition EqualTo(WcPrint.started, 1) ThenBlock: {
                WriteByteBuffered(32)
            }
            fname_len = GetStringLength(filename)
            WriteBuffered(filename, fname_len)
        }

        WriteByteBuffered(10)
    }
}

// === FILE PROCESSING ===

// 1 when the user asked only for a byte count (-c or -m).
Function.BytesOnly {
    Output: Integer
    Body: {
        ok = 1
        IfCondition EqualTo(WcConfig.show_all, 1) ThenBlock: { ok = 0 }
        IfCondition EqualTo(WcConfig.count_lines, 1) ThenBlock: { ok = 0 }
        IfCondition EqualTo(WcConfig.count_words, 1) ThenBlock: { ok = 0 }
        IfCondition EqualTo(WcConfig.max_line_length, 1) ThenBlock: { ok = 0 }
        IfCondition EqualTo(WcConfig.count_chars, 0) ThenBlock: { ok = 0 }
        ReturnValue(ok)
    }
}

// Regular files: st_size from fstat. Returns 1 when WcCounts.chars is set.
Function.TryStatBytes {
    Input: fd: Integer
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        rc = SystemCall(5, fd, statbuf)
        ok = 0
        IfCondition GreaterEqual(rc, 0) ThenBlock: {
            b0 = RDMEM_8(statbuf, 24)
            b1 = RDMEM_8(statbuf, 25)
            mode = Add(b0, Multiply(b1, 256))
            file_type = BitwiseAnd(mode, 61440)
            IfCondition EqualTo(file_type, 32768) ThenBlock: {
                s0 = RDMEM_8(statbuf, 48)
                s1 = RDMEM_8(statbuf, 49)
                s2 = RDMEM_8(statbuf, 50)
                s3 = RDMEM_8(statbuf, 51)
                s4 = RDMEM_8(statbuf, 52)
                s5 = RDMEM_8(statbuf, 53)
                s6 = RDMEM_8(statbuf, 54)
                s7 = RDMEM_8(statbuf, 55)
                low = Add(s0, Multiply(s1, 256))
                low = Add(low, Multiply(s2, 65536))
                low = Add(low, Multiply(s3, 16777216))
                high = Add(s4, Multiply(s5, 256))
                high = Add(high, Multiply(s6, 65536))
                high = Add(high, Multiply(s7, 16777216))
                WcCounts.chars = Add(low, Multiply(high, 4294967296))
                ok = 1
            }
        }
        Deallocate(statbuf, 144)
        ReturnValue(ok)
    }
}

Function.ProcessSingleFile {
    Input: filename: Address
    Output: Integer
    Body: {
        is_stdin = And(EqualTo(RDMEM_8(filename, 0), 45), EqualTo(RDMEM_8(filename, 1), 0))
        IfCondition EqualTo(is_stdin, 1) ThenBlock: {
            ProcessStdinInput(filename)
            ReturnValue(0)
        }

        ResetCounts()
        fd = SystemCall(2, filename, 0, 0)

        IfCondition LessThan(fd, 0) ThenBlock: {
            WriteStderr("wc: ", 4)
            fname_len = GetStringLength(filename)
            WriteStderr(filename, fname_len)
            WriteStderr(": No such file or directory\n", 28)
            ReturnValue(1)
        }

        counted = 0
        IfCondition EqualTo(BytesOnly(), 1) ThenBlock: {
            counted = TryStatBytes(fd)
        }
        IfCondition EqualTo(counted, 0) ThenBlock: {
            CountFileOptimized(fd)
        }
        SystemCall(3, fd)
        IfCondition NotEqual(WcConfig.total_mode, 2) ThenBlock: {
            PrintResults(filename)
        }

        WcTotals.total_lines = Add(WcTotals.total_lines, WcCounts.lines)
        WcTotals.total_words = Add(WcTotals.total_words, WcCounts.words)
        WcTotals.total_chars = Add(WcTotals.total_chars, WcCounts.chars)

        IfCondition GreaterThan(WcCounts.max_line, WcTotals.total_max_line) ThenBlock: {
            WcTotals.total_max_line = WcCounts.max_line
        }
        ReturnValue(0)
    }
}

Function.ProcessStdinInput {
    Input: filename: Address
    Body: {
        ResetCounts()
        counted = 0
        IfCondition EqualTo(BytesOnly(), 1) ThenBlock: {
            counted = TryStatBytes(0)
        }
        IfCondition EqualTo(counted, 0) ThenBlock: {
            CountFileOptimized(0)
        }
        IfCondition NotEqual(WcConfig.total_mode, 2) ThenBlock: {
            PrintResults(filename)
        }
        WcTotals.total_lines = Add(WcTotals.total_lines, WcCounts.lines)
        WcTotals.total_words = Add(WcTotals.total_words, WcCounts.words)
        WcTotals.total_chars = Add(WcTotals.total_chars, WcCounts.chars)
        IfCondition GreaterThan(WcCounts.max_line, WcTotals.total_max_line) ThenBlock: {
            WcTotals.total_max_line = WcCounts.max_line
        }
    }
}

// Size of a regular file, or of stdin when path is 0.
// Returns the size, -1 when the file is not regular, -2 when stat fails.
Function.StatSize {
    Input: path: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        result = 0
        IfCondition EqualTo(path, 0) ThenBlock: {
            result = SystemCall(5, 0, statbuf)
        } ElseBlock: {
            result = SystemCall(4, path, statbuf)
        }
        IfCondition LessThan(result, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(-2)
        }
        mode = RDMEM_64(statbuf, 24)
        size = RDMEM_64(statbuf, 48)
        Deallocate(statbuf, 144)
        kind = BitwiseAnd(mode, 61440)
        IfCondition EqualTo(kind, 32768) ThenBlock: {
            ReturnValue(size)
        }
        ReturnValue(-1)
    }
}

// === FLAG PARSING ===

Function.HandleFlags {
    Input: flag_str: Address
    Body: {
        i = 1
        
        WcConfig.show_all = 0
        
        WhileLoop NotEqual(RDMEM_8(flag_str, i), 0) {
            ch = RDMEM_8(flag_str, i)
            
            IfCondition EqualTo(ch, 108) ThenBlock: {
                WcConfig.count_lines = 1
            }
            
            IfCondition EqualTo(ch, 119) ThenBlock: {
                WcConfig.count_words = 1
            }
            
            IfCondition Or(EqualTo(ch, 99), EqualTo(ch, 109)) ThenBlock: {
                WcConfig.count_chars = 1
            }
            
            IfCondition EqualTo(ch, 76) ThenBlock: {
                WcConfig.max_line_length = 1
            }
            
            i = Add(i, 1)
        }
    }
}

// === ARGUMENT PARSING ===

Function.GetArgs {
    Output: Address
    Body: {
        cmdline_path = "/proc/self/cmdline"
        fd = SystemCall(257, -100, cmdline_path, 0, 0)
        
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        ReturnValue(buffer)
    }
}

Function.EmitLine {
    Input: s: Address
    Body: {
        WriteBuffered(s, GetStringLength(s))
    }
}

Function.ShowHelp {
    Body: {
        EmitLine("Usage: wc [OPTION]... [FILE]...\n")
        EmitLine("Print newline, word, and byte counts for each FILE.\n")
        EmitLine("\n")
        EmitLine("  -c              print the byte counts\n")
        EmitLine("  -m              print the character counts\n")
        EmitLine("  -l              print the newline counts\n")
        EmitLine("  -L              print the maximum display width\n")
        EmitLine("  -w              print the word counts\n")
        EmitLine("      --help      display this help and exit\n")
        EmitLine("      --version   output version information and exit\n")
        EmitLine("\n")
        EmitLine("With no FILE, or when FILE is -, read standard input.\n")
        FlushOutput()
    }
}

Function.ShowVersion {
    Body: {
        EmitLine("wc (AILang coreutils) 2.2 - Optimized with profiling\n")
        EmitLine("Written in AILang - Performance focused\n")
        EmitLine("Compatible with GNU wc\n")
        FlushOutput()
    }
}

// === MAIN ===

SubRoutine.Main {
    DebugPerf.Start("Main_Total")
    
    InitBuffers()
    
    args_buffer = GetArgs()
    
    IfCondition EqualTo(args_buffer, 0) ThenBlock: {
        DebugPerf.Start("Process_Stdin")
        ProcessStdinInput(0)
        DebugPerf.End("Process_Stdin")
        FlushOutput()
        SystemCall(60, 0)
    }
    
    pos = 0
    WhileLoop NotEqual(RDMEM_8(args_buffer, pos), 0) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)
    
    file_paths = Allocate(Multiply(WcConstants.MAX_FILES, 8))
    file_count = 0
    exit_code = 0
    
    WhileLoop LessThan(pos, 4096) {
        ch = RDMEM_8(args_buffer, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            BreakLoop
        }
        
        arg_start = pos
        arg_len = 0
        
        WhileLoop And(LessThan(pos, 4096), NotEqual(RDMEM_8(args_buffer, pos), 0)) {
            arg_len = Add(arg_len, 1)
            pos = Add(pos, 1)
        }
        
        arg = Allocate(Add(arg_len, 1))
        i = 0
        WhileLoop LessThan(i, arg_len) {
            ch = RDMEM_8(args_buffer, Add(arg_start, i))
            WRMEM_8(arg, i, ch)
            i = Add(i, 1)
        }
        WRMEM_8(arg, arg_len, 0)
        
        is_flag = CheckIfFlag(arg)
        
        IfCondition EqualTo(is_flag, 1) ThenBlock: {
            second = RDMEM_8(arg, 1)
            IfCondition EqualTo(second, 45) ThenBlock: {
                is_help = StringsMatch(arg, "--help")
                IfCondition EqualTo(is_help, 1) ThenBlock: {
                    ShowHelp()
                    SystemCall(60, 0)
                }
                
                is_version = StringsMatch(arg, "--version")
                IfCondition EqualTo(is_version, 1) ThenBlock: {
                    ShowVersion()
                    SystemCall(60, 0)
                }

                is_total = StringsMatch(arg, "--total")
                IfCondition EqualTo(is_total, 1) ThenBlock: {
                    WriteStderr("wc: option '--total' requires an argument\n", 42)
                    SystemCall(60, 1)
                }

                mode_name = 0
                is_auto = StringsMatch(arg, "--total=auto")
                is_always = StringsMatch(arg, "--total=always")
                is_only = StringsMatch(arg, "--total=only")
                is_never = StringsMatch(arg, "--total=never")
                IfCondition EqualTo(is_auto, 1) ThenBlock: {
                    WcConfig.total_mode = 0
                    mode_name = 1
                }
                IfCondition EqualTo(is_always, 1) ThenBlock: {
                    WcConfig.total_mode = 1
                    mode_name = 1
                }
                IfCondition EqualTo(is_only, 1) ThenBlock: {
                    WcConfig.total_mode = 2
                    mode_name = 1
                }
                IfCondition EqualTo(is_never, 1) ThenBlock: {
                    WcConfig.total_mode = 3
                    mode_name = 1
                }
                IfCondition EqualTo(mode_name, 1) ThenBlock: {
                    Deallocate(arg, 0)
                    pos = Add(pos, 1)
                    ContinueLoop
                }
            }
            
            HandleFlags(arg)
            Deallocate(arg, 0)
        } ElseBlock: {
            first = RDMEM_8(arg, 0)
            second = RDMEM_8(arg, 1)
            is_dash = And(EqualTo(first, 45), EqualTo(second, 0))
            
            IfCondition EqualTo(is_dash, 1) ThenBlock: {
                WRMEM_64(file_paths, Multiply(file_count, 8), arg)
                file_count = Add(file_count, 1)
            } ElseBlock: {
                WRMEM_64(file_paths, Multiply(file_count, 8), arg)
                file_count = Add(file_count, 1)
            }
        }
        
        pos = Add(pos, 1)
    }
    
    Deallocate(args_buffer, 4096)

    cols = 3
    IfCondition EqualTo(WcConfig.show_all, 0) ThenBlock: {
        cols = 0
        IfCondition EqualTo(WcConfig.count_lines, 1) ThenBlock: {
            cols = Add(cols, 1)
        }
        IfCondition EqualTo(WcConfig.count_words, 1) ThenBlock: {
            cols = Add(cols, 1)
        }
        IfCondition EqualTo(WcConfig.count_chars, 1) ThenBlock: {
            cols = Add(cols, 1)
        }
        IfCondition EqualTo(WcConfig.max_line_length, 1) ThenBlock: {
            cols = Add(cols, 1)
        }
    }

    nfiles = file_count
    IfCondition EqualTo(nfiles, 0) ThenBlock: {
        nfiles = 1
    }
    one_col = And(EqualTo(nfiles, 1), EqualTo(cols, 1))
    IfCondition EqualTo(WcConfig.total_mode, 2) ThenBlock: {
        one_col = 1
    }

    WcConfig.width = 1
    IfCondition EqualTo(one_col, 0) ThenBlock: {
        size_sum = 0
        min_width = 1
        IfCondition EqualTo(file_count, 0) ThenBlock: {
            sz = StatSize(0)
            IfCondition EqualTo(sz, -1) ThenBlock: {
                min_width = 7
            }
            IfCondition GreaterEqual(sz, 0) ThenBlock: {
                size_sum = sz
            }
        } ElseBlock: {
            j = 0
            WhileLoop LessThan(j, file_count) {
                wpath = RDMEM_64(file_paths, Multiply(j, 8))
                wstdin = And(EqualTo(RDMEM_8(wpath, 0), 45), EqualTo(RDMEM_8(wpath, 1), 0))
                sz = 0
                IfCondition EqualTo(wstdin, 1) ThenBlock: {
                    sz = StatSize(0)
                } ElseBlock: {
                    sz = StatSize(wpath)
                }
                IfCondition EqualTo(sz, -1) ThenBlock: {
                    min_width = 7
                }
                IfCondition GreaterEqual(sz, 0) ThenBlock: {
                    size_sum = Add(size_sum, sz)
                }
                j = Add(j, 1)
            }
        }
        WcConfig.width = 1
        span = size_sum
        WhileLoop GreaterEqual(span, 10) {
            WcConfig.width = Add(WcConfig.width, 1)
            span = Divide(span, 10)
        }
        IfCondition LessThan(WcConfig.width, min_width) ThenBlock: {
            WcConfig.width = min_width
        }
    }

    IfCondition EqualTo(file_count, 0) ThenBlock: {
        ProcessStdinInput(0)
    } ElseBlock: {
        i = 0
        WhileLoop LessThan(i, file_count) {
            path = RDMEM_64(file_paths, Multiply(i, 8))
            result = ProcessSingleFile(path)
            IfCondition NotEqual(result, 0) ThenBlock: {
                exit_code = 1
            }
            Deallocate(path, 0)
            i = Add(i, 1)
        }
    }

    show_total = 0
    IfCondition EqualTo(WcConfig.total_mode, 1) ThenBlock: {
        show_total = 1
    }
    IfCondition EqualTo(WcConfig.total_mode, 2) ThenBlock: {
        show_total = 1
    }
    many = GreaterThan(file_count, 1)
    auto_total = And(EqualTo(WcConfig.total_mode, 0), many)
    IfCondition EqualTo(auto_total, 1) ThenBlock: {
        show_total = 1
    }

    IfCondition EqualTo(show_total, 1) ThenBlock: {
        WcCounts.lines = WcTotals.total_lines
        WcCounts.words = WcTotals.total_words
        WcCounts.chars = WcTotals.total_chars
        WcCounts.max_line = WcTotals.total_max_line
        IfCondition EqualTo(WcConfig.total_mode, 2) ThenBlock: {
            PrintResults(0)
        } ElseBlock: {
            PrintResults("total")
        }
    }

    FlushOutput()
    // Note: `Deallocate(file_paths, Multiply(WcConstants.MAX_FILES, 8))`
    // with a nested Multiply in the size arg exercised a compiler rough
    // edge per the triage log. Compute the size into a local first.
    fp_size = Multiply(WcConstants.MAX_FILES, 8)
    Deallocate(file_paths, fp_size)
    
    DebugPerf.End("Main_Total")
    
    IfCondition NotEqual(exit_code, 0) ThenBlock: {
        SystemCall(60, exit_code)
    }
    
    SystemCall(60, 0)
}

RunTask(Main)