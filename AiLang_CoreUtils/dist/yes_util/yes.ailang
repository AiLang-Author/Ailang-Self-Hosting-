// yes.ailang - Repeat a line until stdout will not take it
// Default line is "y". Extra operands are joined with spaces.
// A short or failed write stops the program. EPIPE exits 0.
// Any other write error exits 1 with "yes: standard output: write error".

LibraryImport.Arena

Function.WriteStderr {
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, 2, str, len)
    }
}

Function.ShowHelp {
    Body: {
        SystemCall(1, 1, "Usage: yes [STRING]...\n", 24)
        SystemCall(1, 1, "Repeatedly output a line with all specified STRING(s), or 'y'.\n", 61)
    }
}

Function.ShowVersion {
    Body: {
        SystemCall(1, 1, "yes (AiLang coreutils) 1.0\n", 27)
    }
}

Function.AppendByte {
    Input: line: Address
    Input: line_len: Integer
    Input: byte: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(line_len, 65533) ThenBlock: {
            ReturnValue(-1)
        }
        WRMEM_8(line, line_len, byte)
        ReturnValue(Add(line_len, 1))
    }
}

Function.RepeatLine {
    Input: line: Address
    Input: line_len: Integer
    Body: {
        WhileLoop 1 {
            sent = 0
            WhileLoop LessThan(sent, line_len) {
                ptr = Add(line, sent)
                left = Subtract(line_len, sent)
                wrote = SystemCall(1, 1, ptr, left)
                IfCondition LessEqual(wrote, 0) ThenBlock: {
                    IfCondition EqualTo(wrote, -32) ThenBlock: {
                        WriteStderr("yes: standard output: Broken pipe\n")
                        SystemCall(60, 0)
                    }
                    IfCondition NotEqual(wrote, -4) ThenBlock: {
                        WriteStderr("yes: standard output: write error\n")
                        SystemCall(60, 1)
                    }
                } ElseBlock: {
                    sent = Add(sent, wrote)
                }
            }
        }
    }
}

SubRoutine.Main {
    fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
    IfCondition LessThan(fd, 0) ThenBlock: {
        SystemCall(60, 1)
    }

    args = Allocate(262144)
    cmd_len = SystemCall(0, fd, args, 262143)
    SystemCall(3, fd)
    IfCondition LessThan(cmd_len, 0) ThenBlock: {
        SystemCall(60, 1)
    }
    WRMEM_8(args, cmd_len, 0)

    pos = 0
    WhileLoop NotEqual(RDMEM_8(args, pos), 0) {
        pos = Add(pos, 1)
    }
    pos = Add(pos, 1)

    IfCondition LessThan(pos, cmd_len) ThenBlock: {
        first = Add(args, pos)
        IfCondition StringEquals(first, "--help") ThenBlock: {
            ShowHelp()
            SystemCall(60, 0)
        }
        IfCondition StringEquals(first, "--version") ThenBlock: {
            ShowVersion()
            SystemCall(60, 0)
        }
        IfCondition StringEquals(first, "--") ThenBlock: {
            WhileLoop NotEqual(RDMEM_8(args, pos), 0) {
                pos = Add(pos, 1)
            }
            pos = Add(pos, 1)
        }
    }

    line = Allocate(65536)
    line_len = 0
    arg_count = 0

    WhileLoop LessThan(pos, cmd_len) {
        IfCondition EqualTo(RDMEM_8(args, pos), 0) ThenBlock: {
            pos = cmd_len
        } ElseBlock: {
            IfCondition GreaterThan(arg_count, 0) ThenBlock: {
                line_len = AppendByte(line, line_len, 32)
                IfCondition LessThan(line_len, 0) ThenBlock: {
                    WriteStderr("yes: argument list too long\n")
                    SystemCall(60, 1)
                }
            }
            WhileLoop NotEqual(RDMEM_8(args, pos), 0) {
                byte = RDMEM_8(args, pos)
                line_len = AppendByte(line, line_len, byte)
                IfCondition LessThan(line_len, 0) ThenBlock: {
                    WriteStderr("yes: argument list too long\n")
                    SystemCall(60, 1)
                }
                pos = Add(pos, 1)
            }
            pos = Add(pos, 1)
            arg_count = Add(arg_count, 1)
        }
    }

    IfCondition EqualTo(arg_count, 0) ThenBlock: {
        line_len = AppendByte(line, line_len, 121)
    }
    line_len = AppendByte(line, line_len, 10)
    IfCondition LessThan(line_len, 0) ThenBlock: {
        WriteStderr("yes: argument list too long\n")
        SystemCall(60, 1)
    }

    RepeatLine(line, line_len)
}

RunTask(Main)
