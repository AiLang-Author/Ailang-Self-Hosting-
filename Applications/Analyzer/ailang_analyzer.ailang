// ailang_analyzer.ailang
// Standalone Code Analysis CLI for AILang
// Compiles to: analyzer.x
//
// Usage: ./analyzer.x <file.ailang> [--json] [--brief] [function]
//
// Runs all 4 analysis passes and prints unified report.
// Exit code: 0 = clean, 1 = warnings only, 2 = errors found
//
// Pass 1 (Analyzer):  Memory & Structure — leaks, dropped blocks, unstored allocs, missing returns
// Pass 2 (Analyzer2): Control Flow — unreachable, infinite loops, nested call-args, contracts
// Pass 3 (Analyzer3): Data Flow — use after free, double free, alloc-in-loop, call graph
// Pass 4 (Analyzer4): Pool-Type Flow — Address safety, field validation, FreeLinkage mismatch
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL).

// =============================================================================
// IMPORTS - Frontend only, no compiler backend
// =============================================================================
LibraryImport.Arrays

// Frontend - Lexer
LibraryImport.Compiler.Frontend.Lexer.CLexerCore
LibraryImport.Compiler.Frontend.Lexer.CLexerMain

// Frontend - Parser
LibraryImport.Compiler.Frontend.Parser.CParserCore
LibraryImport.Compiler.Frontend.Parser.CParserMain

// Frontend - AST
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.Frontend.AST.CASTNodes

// Import resolution
LibraryImport.Compiler.Import.CImportResolver
LibraryImport.Compiler.Import.CFileMap

// Analysis passes
LibraryImport.Analyzer
LibraryImport.Analyzer2
LibraryImport.Analyzer3
LibraryImport.Analyzer4
LibraryImport.DiagnosticStore

// =============================================================================
// CLI STATE
// =============================================================================
FixedPool.ACli {
    "filename": Initialize=0, CanChange=True
    "filter": Initialize=0, CanChange=True
    "json_mode": Initialize=0, CanChange=True
    "brief": Initialize=0, CanChange=True
    "help_mode": Initialize=0, CanChange=True
    "source": Initialize=0, CanChange=True
    "source_len": Initialize=0, CanChange=True
    "resolved": Initialize=0, CanChange=True
    "ast": Initialize=0, CanChange=True
}

// =============================================================================
// FILE LOADING
// =============================================================================
Function.ACli.LoadFile {
    Input: filename: Address
    Output: Address
    Body: {
        fd = SystemCall(2, filename, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        size = SystemCall(8, fd, 0, 2)
        SystemCall(8, fd, 0, 0)
        
        IfCondition LessEqual(size, 0) ThenBlock: {
            SystemCall(3, fd)
            ReturnValue(0)
        }
        
        buffer = Allocate(Add(size, 1))
        IfCondition EqualTo(buffer, 0) ThenBlock: {
            SystemCall(3, fd)
            ReturnValue(0)
        }
        
        bytes_read = SystemCall(0, fd, buffer, size)
        SystemCall(3, fd)
        
        IfCondition LessThan(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, Add(size, 1))
            ReturnValue(0)
        }
        
        SetByte(buffer, bytes_read, 0)
        ReturnValue(buffer)
    }
}

// =============================================================================
// ARG PARSING - reads /proc/self/cmdline by index (1-based)
// =============================================================================
Function.ACli.GetArg {
    Input: target_index: Integer
    Output: Address
    Body: {
        cmdline_path = "/proc/self/cmdline"
        fd = SystemCall(2, cmdline_path, 0, 0)
        
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        current_arg = 0
        offset = 0
        
        WhileLoop LessThan(current_arg, target_index) {
            WhileLoop LessThan(offset, bytes_read) {
                ch = GetByte(buffer, offset)
                offset = Add(offset, 1)
                IfCondition EqualTo(ch, 0) ThenBlock: {
                    BreakLoop
                }
            }
            current_arg = Add(current_arg, 1)
        }
        
        IfCondition GreaterEqual(offset, bytes_read) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        start_pos = offset
        len = 0
        WhileLoop LessThan(offset, bytes_read) {
            ch = GetByte(buffer, offset)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            len = Add(len, 1)
            offset = Add(offset, 1)
        }
        
        IfCondition EqualTo(len, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        arg_str = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(buffer, Add(start_pos, i))
            SetByte(arg_str, i, ch)
            i = Add(i, 1)
        }
        SetByte(arg_str, len, 0)
        
        Deallocate(buffer, 4096)
        ReturnValue(arg_str)
    }
}

// =============================================================================
// UNIFIED REPORT - reads from all 4 passes
// =============================================================================
Function.ACli.ReportDetails {
    Body: {
            PrintMessage("--- Memory & Structure ---\n")
            PrintMessage("Functions analyzed: ")
            PrintNumber(Analyzer.functions_analyzed)
            PrintMessage("\n")
            PrintMessage("SubRoutines analyzed: ")
            PrintNumber(Analyzer.subroutines_analyzed)
            PrintMessage("\n")
            PrintMessage("Functions defined: ")
            PrintNumber(Array.Size(Analyzer.defined_funcs))
            PrintMessage("\n")
            PrintMessage("Functions called: ")
            PrintNumber(Array.Size(Analyzer.called_funcs))
            PrintMessage("\n")
            PrintMessage("Allocate calls: ")
            PrintNumber(Analyzer.total_allocs)
            PrintMessage("\n")
            PrintMessage("Deallocate calls: ")
            PrintNumber(Analyzer.total_deallocs)
            PrintMessage("\n")
            PrintMessage("Max nesting depth: ")
            PrintNumber(Analyzer.max_block_depth)
            IfCondition NotEqual(Analyzer.max_depth_func, 0) ThenBlock: {
                PrintMessage(" in '")
                PrintMessage(Analyzer.max_depth_func)
                PrintMessage("'")
            }
            PrintMessage("\n")

            // --- Pass 2: Control Flow ---
            PrintMessage("\n--- Control Flow ---\n")
            PrintMessage("Unreachable code: ")
            PrintNumber(Analyzer2.unreachable_warnings)
            PrintMessage("\n")
            PrintMessage("Infinite loops: ")
            PrintNumber(Analyzer2.infinite_loop_warnings)
            PrintMessage("\n")
            PrintMessage("Missing else: ")
            PrintNumber(Analyzer2.missing_else_warnings)
            PrintMessage("\n")
            PrintMessage("Excessive arity: ")
            PrintNumber(Analyzer2.arity_warnings)
            PrintMessage("\n")
            PrintMessage("Duplicate symbols: ")
            PrintNumber(Analyzer2.duplicate_warnings)
            PrintMessage("\n")
            PrintMessage("Multiple Output decls: ")
            PrintNumber(Analyzer2.multi_output_warnings)
            PrintMessage("\n")
            PrintMessage("File-scope contract errors: ")
            PrintNumber(Analyzer2.toplevel_errors)
            PrintMessage("\n")
            PrintMessage("Nested call-args: ")
            PrintNumber(Analyzer2.nested_call_warnings)
            PrintMessage("\n")
            PrintMessage("Functions registered: ")
            PrintNumber(Array.Size(Analyzer2.func_names))
            PrintMessage("\n")

            // --- Pass 3: Data Flow ---
            PrintMessage("\n--- Data Flow ---\n")
            PrintMessage("Uninitialized vars: ")
            PrintNumber(Analyzer3.uninit_warnings)
            PrintMessage("\n")
            PrintMessage("Dead assignments: ")
            PrintNumber(Analyzer3.dead_assign_warnings)
            PrintMessage("\n")
            PrintMessage("Double dealloc: ")
            PrintNumber(Analyzer3.double_dealloc_warnings)
            PrintMessage("\n")
            PrintMessage("Alloc-in-loop: ")
            PrintNumber(Analyzer3.alloc_in_loop_warnings)
            PrintMessage("\n")
            PrintMessage("Variable shadowing: ")
            PrintNumber(Analyzer3.shadow_warnings)
            PrintMessage("\n")
            PrintMessage("Loop var modification: ")
            PrintNumber(Analyzer3.loop_mod_warnings)
            PrintMessage("\n")
            PrintMessage("Recursive cycles: ")
            PrintNumber(Analyzer3.recursive_cycles)
            PrintMessage("\n")
            PrintMessage("Unused imports: ")
            PrintNumber(Analyzer3.unused_import_warnings)
            PrintMessage("\n")
            PrintMessage("Known pools: ")
            PrintNumber(Array.Size(Analyzer3.known_pools))
            PrintMessage("\n")

            // --- Pass 4: Pool-Type Flow ---
            PrintMessage("\n--- Pool-Type Flow ---\n")
            PrintMessage("Pools registered: ")
            PrintNumber(Analyzer4.pools_registered)
            PrintMessage("\n")
            PrintMessage("Variables tracked: ")
            PrintNumber(Analyzer4.vars_tracked)
            PrintMessage("\n")
            PrintMessage("Call sites recorded: ")
            PrintNumber(Analyzer4.callsites_recorded)
            PrintMessage("\n")
            PrintMessage("Type conflicts: ")
            PrintNumber(Analyzer4.type_conflict_warnings)
            PrintMessage("\n")
            PrintMessage("Field mismatches: ")
            PrintNumber(Analyzer4.field_mismatch_warnings)
            PrintMessage("\n")
            PrintMessage("FreeLinkage mismatches: ")
            PrintNumber(Analyzer4.free_mismatch_warnings)
            PrintMessage("\n")
            PrintMessage("Raw-to-Pool access: ")
            PrintNumber(Analyzer4.raw_to_pool_warnings)
            PrintMessage("\n")

    }
}

Function.ACli.Report {
    Body: {
        PrintMessage("\n")
        PrintMessage("========================================\n")
        PrintMessage("        Code Analysis Report\n")
        PrintMessage("========================================\n")
        PrintMessage("  File: ")
        PrintMessage(ACli.filename)
        PrintMessage("\n")
        PrintMessage("========================================\n\n")

        // Findings lead. Pass counts and the call graph follow them.
        PrintMessage("--- Memory issues ---\n")
        PrintMessage("Leaks (never freed): ")
        PrintNumber(Analyzer.leak_warnings)
        PrintMessage("\n")
        PrintMessage("Dropped (overwritten live block): ")
        PrintNumber(Analyzer.drop_warnings)
        PrintMessage("\n")
        PrintMessage("Discarded (result not stored): ")
        PrintNumber(Analyzer.discard_warnings)
        PrintMessage("\n")
        PrintMessage("Returned and freed: ")
        PrintNumber(Analyzer.both_warnings)
        PrintMessage("\n")
        PrintMessage("Use after free: ")
        PrintNumber(Analyzer3.uaf_warnings)
        PrintMessage("\n")
        PrintMessage("Double free: ")
        PrintNumber(Analyzer3.double_dealloc_warnings)
        PrintMessage("\n")
        PrintMessage("Alloc in loop: ")
        PrintNumber(Analyzer3.alloc_in_loop_warnings)
        PrintMessage("\n")
        PrintMessage("Freed on one path: ")
        PrintNumber(Analyzer.path_warnings)
        PrintMessage("\n")
        PrintMessage("Size mismatch: ")
        PrintNumber(Analyzer.size_warnings)
        PrintMessage("\n")
        PrintMessage("Arena temporary: ")
        PrintNumber(Analyzer.arena_warnings)
        PrintMessage("\n")
        PrintMessage("Kind mismatch: ")
        PrintNumber(Analyzer.kind_warnings)
        PrintMessage("\n")
        PrintMessage("Unowned free: ")
        PrintNumber(Analyzer.free_warnings)
        PrintMessage("\n")
        PrintMessage("Freed inside loop: ")
        PrintNumber(Analyzer3.repeat_warnings)
        PrintMessage("\n")

        IfCondition EqualTo(ACli.brief, 0) ThenBlock: {
            ACli.ReportDetails()
        }
        
        // Call graph stays available in --brief when a function name is passed.
        // Call graph is a lookup. Without a function name, print the size only.
        PrintMessage("\n--- Call graph ---\n")
        count = Array.Size(Analyzer3.call_graph_from)
        IfCondition EqualTo(ACli.filter, 0) ThenBlock: {
            PrintMessage("Edges: ")
            PrintNumber(count)
            PrintMessage(" (pass a function name to list its callers)\n")
        } ElseBlock: {
            PrintMessage("Callers of '")
            PrintMessage(ACli.filter)
            PrintMessage("':\n")
            i = 0
            shown = 0
            WhileLoop LessThan(i, count) {
                caller = Array.Get(Analyzer3.call_graph_from, i)
                callee = Array.Get(Analyzer3.call_graph_to, i)
                is_match = Analyzer3.StrEqual(callee, ACli.filter)
                IfCondition EqualTo(is_match, 1) ThenBlock: {
                    PrintMessage("  ")
                    PrintMessage(caller)
                    PrintMessage(" calls ")
                    PrintMessage(callee)
                    PrintMessage("\n")
                    shown = Add(shown, 1)
                }
                i = Add(i, 1)
            }
            IfCondition EqualTo(shown, 0) ThenBlock: {
                PrintMessage("  (none)\n")
            }
        }
        
        // === ERRORS ===
        total_errors = Add(Analyzer.error_count, Analyzer2.error_count)
        total_errors = Add(total_errors, Analyzer3.error_count)
        IfCondition GreaterThan(total_errors, 0) ThenBlock: {
            PrintMessage("\n========================================\n")
            PrintMessage("ERRORS:\n")
            PrintMessage("========================================\n")
            
            i = 0
            WhileLoop LessThan(i, Analyzer.error_count) {
                msg = Array.Get(Analyzer.errors, i)
                PrintMessage("  [MEM] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }

            i = 0
            WhileLoop LessThan(i, Analyzer2.error_count) {
                msg = Array.Get(Analyzer2.errors, i)
                PrintMessage("  [CFG] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
            
            i = 0
            WhileLoop LessThan(i, Analyzer3.error_count) {
                msg = Array.Get(Analyzer3.errors, i)
                PrintMessage("  [DFA] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
        }
        
        // === WARNINGS ===
        total_warnings = Add(Analyzer.warning_count, Analyzer2.warning_count)
        total_warnings = Add(total_warnings, Analyzer3.warning_count)
        total_warnings = Add(total_warnings, Analyzer4.warning_count)
        
        IfCondition GreaterThan(total_warnings, 0) ThenBlock: {
            PrintMessage("\n========================================\n")
            PrintMessage("WARNINGS:\n")
            PrintMessage("========================================\n")
            
            i = 0
            WhileLoop LessThan(i, Analyzer.warning_count) {
                msg = Array.Get(Analyzer.warnings, i)
                PrintMessage("  [MEM] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
            
            i = 0
            WhileLoop LessThan(i, Analyzer2.warning_count) {
                msg = Array.Get(Analyzer2.warnings, i)
                PrintMessage("  [CFG] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
            
            i = 0
            WhileLoop LessThan(i, Analyzer3.warning_count) {
                msg = Array.Get(Analyzer3.warnings, i)
                PrintMessage("  [DFA] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
            
            i = 0
            WhileLoop LessThan(i, Analyzer4.warning_count) {
                msg = Array.Get(Analyzer4.warnings, i)
                PrintMessage("  [PTF] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
        }
        
        // === HINTS ===
        total_hints = Add(Analyzer2.hint_count, Analyzer4.hint_count)
        IfCondition GreaterThan(total_hints, 0) ThenBlock: {
            PrintMessage("\n========================================\n")
            PrintMessage("HINTS:\n")
            PrintMessage("========================================\n")
            
            i = 0
            WhileLoop LessThan(i, Analyzer2.hint_count) {
                msg = Array.Get(Analyzer2.hints, i)
                PrintMessage("  [OPT] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
            
            i = 0
            WhileLoop LessThan(i, Analyzer4.hint_count) {
                msg = Array.Get(Analyzer4.hints, i)
                PrintMessage("  [PTF] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
        }
        
        // === SUMMARY ===
        total_warnings = Add(Analyzer.warning_count, Analyzer2.warning_count)
        total_warnings = Add(total_warnings, Analyzer3.warning_count)
        total_warnings = Add(total_warnings, Analyzer4.warning_count)
        total_errors = Add(Analyzer.error_count, Analyzer2.error_count)
        total_errors = Add(total_errors, Analyzer3.error_count)
        total_hints = Add(Analyzer2.hint_count, Analyzer4.hint_count)
        
        PrintMessage("\n========================================\n")
        PrintMessage("  Summary: ")
        PrintNumber(total_errors)
        PrintMessage(" errors, ")
        PrintNumber(total_warnings)
        PrintMessage(" warnings, ")
        PrintNumber(total_hints)
        PrintMessage(" hints\n")
        PrintMessage("  Memory: ")
        PrintNumber(Analyzer.leak_warnings)
        PrintMessage(" leaks, ")
        PrintNumber(Analyzer.drop_warnings)
        PrintMessage(" dropped, ")
        PrintNumber(Analyzer.discard_warnings)
        PrintMessage(" discarded, ")
        PrintNumber(Analyzer.both_warnings)
        PrintMessage(" returned-and-freed, ")
        PrintNumber(Analyzer3.uaf_warnings)
        PrintMessage(" use-after-free, ")
        PrintNumber(Analyzer3.double_dealloc_warnings)
        PrintMessage(" double-free, ")
        PrintNumber(Analyzer3.alloc_in_loop_warnings)
        PrintMessage(" alloc-in-loop, ")
        PrintNumber(Analyzer.path_warnings)
        PrintMessage(" one-path, ")
        PrintNumber(Analyzer.size_warnings)
        PrintMessage(" size, ")
        PrintNumber(Analyzer.arena_warnings)
        PrintMessage(" arena, ")
        PrintNumber(Analyzer.kind_warnings)
        PrintMessage(" kind, ")
        PrintNumber(Analyzer.free_warnings)
        PrintMessage(" unowned, ")
        PrintNumber(Analyzer3.repeat_warnings)
        PrintMessage(" loop-free\n")
        PrintMessage("========================================\n")
    }
}

// =============================================================================
// JSON
// =============================================================================
Function.ACli.Drain {
    Input: list: Address
    Input: count: Integer
    Input: code: Address
    Input: severity: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, count) {
            msg = Array.Get(list, i)
            DiagStore.Add(0, 0, severity, code, msg)
            i = Add(i, 1)
        }
    }
}

Function.ACli.EmitJSON {
    Body: {
        DiagStore.Init()
        DiagStore.SetFile(ACli.filename)
        sev_w = DiagSeverity.WARNING
        sev_e = DiagSeverity.ERROR
        sev_h = DiagSeverity.HINT
        ACli.Drain(Analyzer.warnings, Analyzer.warning_count, "MEM", sev_w)
        ACli.Drain(Analyzer.errors, Analyzer.error_count, "MEM", sev_e)
        ACli.Drain(Analyzer2.warnings, Analyzer2.warning_count, "CFG", sev_w)
        ACli.Drain(Analyzer2.errors, Analyzer2.error_count, "CFG", sev_e)
        ACli.Drain(Analyzer2.hints, Analyzer2.hint_count, "OPT", sev_h)
        ACli.Drain(Analyzer3.warnings, Analyzer3.warning_count, "DFA", sev_w)
        ACli.Drain(Analyzer3.errors, Analyzer3.error_count, "DFA", sev_e)
        ACli.Drain(Analyzer4.warnings, Analyzer4.warning_count, "PTF", sev_w)
        ACli.Drain(Analyzer4.hints, Analyzer4.hint_count, "PTF", sev_h)
        n = DiagStore.Count()
        PrintMessage("--- JSON ---\n")
        IfCondition EqualTo(n, 0) ThenBlock: {
            PrintMessage("[]\n")
        }
        IfCondition GreaterThan(n, 0) ThenBlock: {
            text = DiagStore.ToJSON()
            PrintMessage(text)
            PrintMessage("\n")
        }
    }
}

// =============================================================================
// HELP
// =============================================================================
Function.ACli.PrintHelp {
    Body: {
        PrintMessage("AILang Code Analyzer\n")
        PrintMessage("Usage: ./analyzer.x <file.ailang> [--json] [--brief] [function]\n")
        PrintMessage("       ./analyzer.x --help\n")
        PrintMessage("\n")
        PrintMessage("Exit 0 when the file is clean, 1 for warnings, 2 for errors.\n")
        PrintMessage("--json    print the findings again as one JSON array\n")
        PrintMessage("--brief   scoreboard, warnings, and summary. Skip the pass stats.\n")
        PrintMessage("A function name lists what calls that function.\n")
        PrintMessage("\n")
        PrintMessage("Passes: [MEM] ownership  [CFG] control flow  [DFA] use after free  [PTF] pools\n")
        PrintMessage("\n")
        PrintMessage("One name inside one function. An If counts only when both arms agree.\n")
        PrintMessage("A call in this file can give a fresh block or take a parameter.\n")
        PrintMessage("A call into another file leaves the block with the caller.\n")
        PrintMessage("\n")
        PrintMessage("  MEM-LEAK     allocated, not freed, not returned\n")
        PrintMessage("  MEM-DROP     a live block was overwritten\n")
        PrintMessage("  MEM-DISCARD  Allocate result was not stored\n")
        PrintMessage("  MEM-BOTH     returned and also freed\n")
        PrintMessage("  MEM-UAF      used after free, including a free on another path\n")
        PrintMessage("  MEM-DOUBLE   freed again\n")
        PrintMessage("  MEM-LOOP     allocated in a loop and not freed before the next trip\n")
        PrintMessage("  MEM-REPEAT   freed in a loop, but allocated outside that loop\n")
        PrintMessage("  MEM-PATH     freed or allocated on some paths only\n")
        PrintMessage("  MEM-SIZE     free size, or the two arms, disagree\n")
        PrintMessage("  MEM-KIND     byte block freed as an array, or the reverse\n")
        PrintMessage("  MEM-ARENA    bare arena temp, or an arena temp passed to a free\n")
        PrintMessage("  MEM-FREE     freed a name this function does not own\n")
    }
}

Function.ACli.TakeOpt {
    Input: arg: Address
    Body: {
        IfCondition EqualTo(arg, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(arg, "--json")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ACli.json_mode = 1
            ReturnValue(0)
        }
        cmp = StringCompare(arg, "--brief")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ACli.brief = 1
            ReturnValue(0)
        }
        cmp = StringCompare(arg, "--help")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ACli.help_mode = 1
            ReturnValue(0)
        }
        cmp = StringCompare(arg, "-h")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ACli.help_mode = 1
            ReturnValue(0)
        }
        ACli.filter = arg
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()
    ACli.filename = ACli.GetArg(1)
    ACli.json_mode = 0
    ACli.brief = 0
    ACli.help_mode = 0
    ACli.filter = 0
    IfCondition NotEqual(ACli.filename, 0) ThenBlock: {
        cmp = StringCompare(ACli.filename, "--help")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ACli.help_mode = 1
        }
        cmp = StringCompare(ACli.filename, "-h")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ACli.help_mode = 1
        }
    }
    ACli.TakeOpt(ACli.GetArg(2))
    ACli.TakeOpt(ACli.GetArg(3))
    ACli.TakeOpt(ACli.GetArg(4))

    IfCondition EqualTo(ACli.help_mode, 1) ThenBlock: {
        ACli.PrintHelp()
        ProcessExit(0)
    }
    IfCondition EqualTo(ACli.filename, 0) ThenBlock: {
        ACli.PrintHelp()
        ProcessExit(1)
    }
    
    PrintMessage("AILang Analyzer - ")
    PrintMessage(ACli.filename)
    PrintMessage("\n")
    
    // Step 1: Load
    ACli.source = ACli.LoadFile(ACli.filename)
    IfCondition EqualTo(ACli.source, 0) ThenBlock: {
        PrintMessage("ERROR: Cannot read file: ")
        PrintMessage(ACli.filename)
        PrintMessage("\n")
        ProcessExit(1)
    }
    ACli.source_len = StringLength(ACli.source)
    
    // Step 2: Resolve imports
    ACli.resolved = Import_ResolveAll(ACli.source)
    IfCondition EqualTo(ACli.resolved, 0) ThenBlock: {
        ACli.resolved = ACli.source
        FileMap_Init()
        FileMap_AddEntry(1, ACli.filename)
    }
    
    // Step 3: Lex
    resolved_len = StringLength(ACli.resolved)
    Lex_Init(ACli.resolved, resolved_len)
    Lex_Tokenize()
    
    IfCondition EqualTo(Lex.error, 1) ThenBlock: {
        PrintMessage("ERROR: Lexer failed at line ")
        PrintNumber(Lex.error_line)
        PrintMessage("\n")
        ProcessExit(1)
    }
    
    // Step 4: Parse
    Parse_Init(Lex.token_count)
    ACli.ast = Parse_Program()
    
    IfCondition EqualTo(Parse_HasError(), 1) ThenBlock: {
        PrintMessage("ERROR: Parse failed at line ")
        PrintNumber(PParser.p_error_line)
        PrintMessage(": ")
        IfCondition NotEqual(PParser.p_error_msg, 0) ThenBlock: {
            PrintMessage(PParser.p_error_msg)
        }
        PrintMessage("\n")
        ProcessExit(1)
    }
    
    // Step 5: Run all analysis passes
    // Pass 1: Memory & Structure
    Analyzer.Init()
    Analyzer.WalkNode(ACli.ast)
    Analyzer.PostAnalysis()
    
    // Pass 2: Control Flow
    Analyzer2.Run(ACli.ast)
    
    // Pass 3: Data Flow
    Analyzer3.Run(ACli.ast)
    
    // Pass 4: Pool-Type Flow
    Analyzer4.Run(ACli.ast)
    
    // Step 6: Report
    ACli.Report()
    IfCondition EqualTo(ACli.json_mode, 1) ThenBlock: {
        ACli.EmitJSON()
    }

    // Capture counts before Cleanup zeros them.
    total_errors = Add(Analyzer.error_count, Analyzer2.error_count)
    total_errors = Add(total_errors, Analyzer3.error_count)
    total_warnings = Add(Analyzer.warning_count, Analyzer2.warning_count)
    total_warnings = Add(total_warnings, Analyzer3.warning_count)
    total_warnings = Add(total_warnings, Analyzer4.warning_count)
    
    // Step 7: Cleanup
    Analyzer.Cleanup()
    Analyzer2.Cleanup()
    Analyzer3.Cleanup()
    Analyzer4.Cleanup()
    
    IfCondition GreaterThan(total_errors, 0) ThenBlock: {
        ProcessExit(2)
    }
    IfCondition GreaterThan(total_warnings, 0) ThenBlock: {
        ProcessExit(1)
    }
    
    HaltProgram()
}

RunTask(Main)