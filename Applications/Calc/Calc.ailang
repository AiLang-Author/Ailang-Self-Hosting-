// Calc.ailang
// Calculator — standalone test binary
//
// Tests the Calculator JSON state machine by sending JSON requests
// and verifying JSON responses. No UI, no display server — pure
// JSON round-trip validation.
//
// Build: ./ailang.x Calc.ailang Calc.x
// Run:   ./Calc.x
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.JSON
LibraryImport.Calculator

SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  Calculator — JSON State Machine Test\n")
    PrintMessage("============================================\n\n")

    Calc_ExprInit()

    pass_count = 0
    fail_count = 0

    // =========================================================================
    // TEST 1: CLEAR — reset to 0
    // =========================================================================
    PrintMessage("[Calc] TEST 1: Clear\n")
    resp1 = Calc_JsonHandle("{\"method\":\"clear\"}", 18)
    IfCondition EqualTo(resp1, 0) ThenBlock: {
        PrintMessage("[Calc] FAIL — no response\n\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        p1 = ParseJSON(resp1)
        o1 = JSON.AsObject(p1)
        d1 = JSON.GetString(o1, "display")
        c1 = StringCompare(d1, "0")
        IfCondition EqualTo(c1, 0) ThenBlock: {
            PrintMessage("[Calc] PASS — display=\"0\"\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[Calc] FAIL — expected \"0\" got \"")
            PrintString(d1)
            PrintMessage("\"\n\n")
            fail_count = Add(fail_count, 1)
        }
        JSON.Free(p1)
    }

    // =========================================================================
    // TEST 2: DIGIT — enter 42
    // =========================================================================
    PrintMessage("[Calc] TEST 2: Digit entry (4, 2)\n")
    Calc_JsonHandle("{\"method\":\"clear\"}", 18)

    Calc_JsonHandle("{\"method\":\"digit\",\"value\":4}", 27)
    resp2 = Calc_JsonHandle("{\"method\":\"digit\",\"value\":2}", 27)
    IfCondition EqualTo(resp2, 0) ThenBlock: {
        PrintMessage("[Calc] FAIL — no response\n\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        p2 = ParseJSON(resp2)
        o2 = JSON.AsObject(p2)
        d2 = JSON.GetString(o2, "display")
        c2 = StringCompare(d2, "42")
        IfCondition EqualTo(c2, 0) ThenBlock: {
            PrintMessage("[Calc] PASS — display=\"42\"\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[Calc] FAIL — expected \"42\" got \"")
            PrintString(d2)
            PrintMessage("\"\n\n")
            fail_count = Add(fail_count, 1)
        }
        JSON.Free(p2)
    }

    // =========================================================================
    // TEST 3: ADD — 25 + 17 = 42
    // =========================================================================
    PrintMessage("[Calc] TEST 3: Addition (25 + 17 = 42)\n")
    Calc_JsonHandle("{\"method\":\"clear\"}", 18)

    Calc_JsonHandle("{\"method\":\"digit\",\"value\":2}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":5}", 27)
    Calc_JsonHandle("{\"method\":\"operator\",\"op\":1}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":1}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":7}", 27)
    resp3 = Calc_JsonHandle("{\"method\":\"equals\"}", 19)
    IfCondition EqualTo(resp3, 0) ThenBlock: {
        PrintMessage("[Calc] FAIL — no response\n\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        p3 = ParseJSON(resp3)
        o3 = JSON.AsObject(p3)
        d3 = JSON.GetString(o3, "display")
        c3 = StringCompare(d3, "42")
        IfCondition EqualTo(c3, 0) ThenBlock: {
            PrintMessage("[Calc] PASS — display=\"42\"\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[Calc] FAIL — expected \"42\" got \"")
            PrintString(d3)
            PrintMessage("\"\n\n")
            fail_count = Add(fail_count, 1)
        }
        JSON.Free(p3)
    }

    // =========================================================================
    // TEST 4: SUBTRACT — 100 - 58 = 42
    // =========================================================================
    PrintMessage("[Calc] TEST 4: Subtraction (100 - 58 = 42)\n")
    Calc_JsonHandle("{\"method\":\"clear\"}", 18)

    Calc_JsonHandle("{\"method\":\"digit\",\"value\":1}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":0}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":0}", 27)
    Calc_JsonHandle("{\"method\":\"operator\",\"op\":2}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":5}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":8}", 27)
    resp4 = Calc_JsonHandle("{\"method\":\"equals\"}", 19)
    IfCondition EqualTo(resp4, 0) ThenBlock: {
        PrintMessage("[Calc] FAIL — no response\n\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        p4 = ParseJSON(resp4)
        o4 = JSON.AsObject(p4)
        d4 = JSON.GetString(o4, "display")
        c4 = StringCompare(d4, "42")
        IfCondition EqualTo(c4, 0) ThenBlock: {
            PrintMessage("[Calc] PASS — display=\"42\"\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[Calc] FAIL — expected \"42\" got \"")
            PrintString(d4)
            PrintMessage("\"\n\n")
            fail_count = Add(fail_count, 1)
        }
        JSON.Free(p4)
    }

    // =========================================================================
    // TEST 5: MULTIPLY — 6 * 7 = 42
    // =========================================================================
    PrintMessage("[Calc] TEST 5: Multiplication (6 * 7 = 42)\n")
    Calc_JsonHandle("{\"method\":\"clear\"}", 18)

    Calc_JsonHandle("{\"method\":\"digit\",\"value\":6}", 27)
    Calc_JsonHandle("{\"method\":\"operator\",\"op\":3}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":7}", 27)
    resp5 = Calc_JsonHandle("{\"method\":\"equals\"}", 19)
    IfCondition EqualTo(resp5, 0) ThenBlock: {
        PrintMessage("[Calc] FAIL — no response\n\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        p5 = ParseJSON(resp5)
        o5 = JSON.AsObject(p5)
        d5 = JSON.GetString(o5, "display")
        c5 = StringCompare(d5, "42")
        IfCondition EqualTo(c5, 0) ThenBlock: {
            PrintMessage("[Calc] PASS — display=\"42\"\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[Calc] FAIL — expected \"42\" got \"")
            PrintString(d5)
            PrintMessage("\"\n\n")
            fail_count = Add(fail_count, 1)
        }
        JSON.Free(p5)
    }

    // =========================================================================
    // TEST 6: DIVIDE — 84 / 2 = 42
    // =========================================================================
    PrintMessage("[Calc] TEST 6: Division (84 / 2 = 42)\n")
    Calc_JsonHandle("{\"method\":\"clear\"}", 18)

    Calc_JsonHandle("{\"method\":\"digit\",\"value\":8}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":4}", 27)
    Calc_JsonHandle("{\"method\":\"operator\",\"op\":4}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":2}", 27)
    resp6 = Calc_JsonHandle("{\"method\":\"equals\"}", 19)
    IfCondition EqualTo(resp6, 0) ThenBlock: {
        PrintMessage("[Calc] FAIL — no response\n\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        p6 = ParseJSON(resp6)
        o6 = JSON.AsObject(p6)
        d6 = JSON.GetString(o6, "display")
        c6 = StringCompare(d6, "42")
        IfCondition EqualTo(c6, 0) ThenBlock: {
            PrintMessage("[Calc] PASS — display=\"42\"\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[Calc] FAIL — expected \"42\" got \"")
            PrintString(d6)
            PrintMessage("\"\n\n")
            fail_count = Add(fail_count, 1)
        }
        JSON.Free(p6)
    }

    // =========================================================================
    // TEST 7: NEGATE — enter 42, negate = -42
    // =========================================================================
    PrintMessage("[Calc] TEST 7: Negate (42 -> -42)\n")
    Calc_JsonHandle("{\"method\":\"clear\"}", 18)

    Calc_JsonHandle("{\"method\":\"digit\",\"value\":4}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":2}", 27)
    resp7 = Calc_JsonHandle("{\"method\":\"negate\"}", 19)
    IfCondition EqualTo(resp7, 0) ThenBlock: {
        PrintMessage("[Calc] FAIL — no response\n\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        p7 = ParseJSON(resp7)
        o7 = JSON.AsObject(p7)
        d7 = JSON.GetString(o7, "display")
        c7 = StringCompare(d7, "-42")
        IfCondition EqualTo(c7, 0) ThenBlock: {
            PrintMessage("[Calc] PASS — display=\"-42\"\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[Calc] FAIL — expected \"-42\" got \"")
            PrintString(d7)
            PrintMessage("\"\n\n")
            fail_count = Add(fail_count, 1)
        }
        JSON.Free(p7)
    }

    // =========================================================================
    // TEST 8: BACKSPACE — enter 425, backspace = 42
    // =========================================================================
    PrintMessage("[Calc] TEST 8: Backspace (425 -> 42)\n")
    Calc_JsonHandle("{\"method\":\"clear\"}", 18)

    Calc_JsonHandle("{\"method\":\"digit\",\"value\":4}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":2}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":5}", 27)
    resp8 = Calc_JsonHandle("{\"method\":\"backspace\"}", 22)
    IfCondition EqualTo(resp8, 0) ThenBlock: {
        PrintMessage("[Calc] FAIL — no response\n\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        p8 = ParseJSON(resp8)
        o8 = JSON.AsObject(p8)
        d8 = JSON.GetString(o8, "display")
        c8 = StringCompare(d8, "42")
        IfCondition EqualTo(c8, 0) ThenBlock: {
            PrintMessage("[Calc] PASS — display=\"42\"\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[Calc] FAIL — expected \"42\" got \"")
            PrintString(d8)
            PrintMessage("\"\n\n")
            fail_count = Add(fail_count, 1)
        }
        JSON.Free(p8)
    }

    // =========================================================================
    // TEST 9: CHAIN — 10 + 20 + 12 = 42
    // =========================================================================
    PrintMessage("[Calc] TEST 9: Chained ops (10 + 20 + 12 = 42)\n")
    Calc_JsonHandle("{\"method\":\"clear\"}", 18)

    Calc_JsonHandle("{\"method\":\"digit\",\"value\":1}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":0}", 27)
    Calc_JsonHandle("{\"method\":\"operator\",\"op\":1}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":2}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":0}", 27)
    Calc_JsonHandle("{\"method\":\"operator\",\"op\":1}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":1}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":2}", 27)
    resp9 = Calc_JsonHandle("{\"method\":\"equals\"}", 19)
    IfCondition EqualTo(resp9, 0) ThenBlock: {
        PrintMessage("[Calc] FAIL — no response\n\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        p9 = ParseJSON(resp9)
        o9 = JSON.AsObject(p9)
        d9 = JSON.GetString(o9, "display")
        c9 = StringCompare(d9, "42")
        IfCondition EqualTo(c9, 0) ThenBlock: {
            PrintMessage("[Calc] PASS — display=\"42\"\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[Calc] FAIL — expected \"42\" got \"")
            PrintString(d9)
            PrintMessage("\"\n\n")
            fail_count = Add(fail_count, 1)
        }
        JSON.Free(p9)
    }

    // =========================================================================
    // TEST 10: DIVIDE BY ZERO — 42 / 0 = 0
    // =========================================================================
    PrintMessage("[Calc] TEST 10: Divide by zero (42 / 0 = 0)\n")
    Calc_JsonHandle("{\"method\":\"clear\"}", 18)

    Calc_JsonHandle("{\"method\":\"digit\",\"value\":4}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":2}", 27)
    Calc_JsonHandle("{\"method\":\"operator\",\"op\":4}", 27)
    Calc_JsonHandle("{\"method\":\"digit\",\"value\":0}", 27)
    resp10 = Calc_JsonHandle("{\"method\":\"equals\"}", 19)
    IfCondition EqualTo(resp10, 0) ThenBlock: {
        PrintMessage("[Calc] FAIL — no response\n\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        p10 = ParseJSON(resp10)
        o10 = JSON.AsObject(p10)
        d10 = JSON.GetString(o10, "display")
        c10 = StringCompare(d10, "0")
        IfCondition EqualTo(c10, 0) ThenBlock: {
            PrintMessage("[Calc] PASS — display=\"0\"\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[Calc] FAIL — expected \"0\" got \"")
            PrintString(d10)
            PrintMessage("\"\n\n")
            fail_count = Add(fail_count, 1)
        }
        JSON.Free(p10)
    }

    // =========================================================================
    // RESULTS
    // =========================================================================
    PrintMessage("============================================\n")
    PrintMessage("  Calculator Results: ")
    PrintNumber(pass_count)
    PrintMessage(" passed, ")
    PrintNumber(fail_count)
    PrintMessage(" failed\n")
    PrintMessage("============================================\n")
}

RunTask(Main)
