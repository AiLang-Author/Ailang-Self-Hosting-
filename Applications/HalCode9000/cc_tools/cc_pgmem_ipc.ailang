// cc_pgmem_ipc.ailang — HalCode9000 PostgreSQL memory + context tool.
//
// Internal service (not model-facing). Called by HalCode9000 agent loop and
// sub-agents to park/pickup working context, track tasks and token usage,
// and search the code symbol index.
//
// Socket:   @halcode/pgmem
// DB:       ailang_system @ 127.0.0.1:5432 (no password, local unix trust)
//
// Protocol (simple direct — no schema/method envelope):
//   Request:  {"op":"park", "key":"...", ...}
//   Response: {"ok":true, ...fields}   or   {"ok":false,"error":"..."}
//
// Ops:
//   session_start  role project [parent_id]        -> {session_id}
//   session_end    session_id                       -> {}
//   park           key kind content [scope] [session_id] [project] -> {id}
//   pickup         key [session_id]                 -> {content,kind,scope,id}
//   search         query [kind] [scope] [session_id] -> {rows:[...]}
//   tree           [scope] [session_id]             -> {rows:[...]}
//   compact        keys summary [session_id]        -> {summary_id}
//   task_create    title kind effort [min_tier] [session_id] [parent_id] -> {task_id}
//   task_start     task_id assigned_to provider     -> {}
//   task_end       task_id status input_tokens output_tokens cost_usd [result_key] -> {}
//   task_list      [session_id] [status]            -> {tasks:[...]}
//   rate           task_id score tags [notes]       -> {}
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.JSON
LibraryImport.StringUtils
LibraryImport.XArrays
LibraryImport.PostgreSQL_Complete

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.PGMemSys {
    "SYS_OPEN":     Initialize=2
    "SYS_READ":     Initialize=0
    "SYS_CLOSE":    Initialize=3
    "SYS_MKDIR":    Initialize=83
    "O_RDONLY":     Initialize=0
}

FixedPool.PGMemConst {
    "SOCK_PATH":    Initialize=0, CanChange=True
    "PG_HOST":      Initialize=0, CanChange=True
    "PG_PORT":      Initialize=5432
    "PG_DB":        Initialize=0, CanChange=True
    "PG_USER":      Initialize=0, CanChange=True
    "PG_PASS":      Initialize=0, CanChange=True
    "BACKLOG":      Initialize=8
    "MAX_ROWS":     Initialize=50       // max rows returned per search
    "ESC_BUF_SZ":   Initialize=131072  // 128KB scratch for escape + SQL building
}

FixedPool.PGMemState {
    "conn":         Initialize=0, CanChange=True   // PG connection handle
    "project_id":   Initialize=0, CanChange=True   // default project id (int)
    "project_name": Initialize=0, CanChange=True
    "listen_fd":    Initialize=-1, CanChange=True
    "running":      Initialize=1, CanChange=True
    "esc_buf":      Initialize=0, CanChange=True   // reusable escape buffer
}

// =============================================================================
// HELPERS
// =============================================================================

// Escape single quotes for SQL string literals (replace ' with '').
// Returns pointer into PGMemState.esc_buf — valid until next EscStr call.
Function.PGMem_EscStr {
    Input: src: Address
    Output: Address
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue("") }
        dst = PGMemState.esc_buf
        si = 0
        di = 0
        lim = Subtract(PGMemConst.ESC_BUF_SZ, 2)
        WhileLoop LessThan(di, lim) {
            c = GetByte(src, si)
            IfCondition EqualTo(c, 0) ThenBlock: {
                BreakLoop
            } ElseBlock: {
                IfCondition EqualTo(c, 39) ThenBlock: {   // single-quote
                    SetByte(dst, di, 39)
                    di = Add(di, 1)
                    SetByte(dst, di, 39)
                } ElseBlock: {
                    SetByte(dst, di, c)
                }
                di = Add(di, 1)
                si = Add(si, 1)
            }
        }
        SetByte(dst, di, 0)
        ReturnValue(dst)
    }
}

// Return hex char for nibble 0-15.
Function.PGMem_HexNib {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 10) ThenBlock: { ReturnValue(Add(n, 48)) }
        ReturnValue(Add(n, 87))   // 'a' = 97, 97-10=87
    }
}

// Generate a UUID string from /dev/urandom. Returns Allocate'd 37-byte buffer.
Function.PGMem_UUID {
    Output: Address
    Body: {
        rbuf = Allocate(16)
        fd = SystemCall(PGMemSys.SYS_OPEN, "/dev/urandom", PGMemSys.O_RDONLY, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            Deallocate(rbuf, 16)
            ReturnValue(0)
        }
        SystemCall(PGMemSys.SYS_READ, fd, rbuf, 16, 0, 0)
        SystemCall(PGMemSys.SYS_CLOSE, fd, 0, 0, 0, 0)

        // Force version 4 and variant bits
        b6 = GetByte(rbuf, 6)
        SetByte(rbuf, 6, BitwiseOr(BitwiseAnd(b6, 15), 64))   // version 4
        b8 = GetByte(rbuf, 8)
        SetByte(rbuf, 8, BitwiseOr(BitwiseAnd(b8, 63), 128))  // variant 10xx

        out = Allocate(37)
        op = 0
        bi = 0
        // Layout: 8-4-4-4-12 (dashes at positions 8,13,18,23)
        group_sizes = Allocate(5)
        SetByte(group_sizes, 0, 4)
        SetByte(group_sizes, 1, 2)
        SetByte(group_sizes, 2, 2)
        SetByte(group_sizes, 3, 2)
        SetByte(group_sizes, 4, 6)
        gi = 0
        WhileLoop LessThan(gi, 5) {
            IfCondition GreaterThan(gi, 0) ThenBlock: {
                SetByte(out, op, 45)   // '-'
                op = Add(op, 1)
            }
            gs = GetByte(group_sizes, gi)
            ci = 0
            WhileLoop LessThan(ci, gs) {
                b = GetByte(rbuf, bi)
                SetByte(out, op,        PGMem_HexNib(RightShift(BitwiseAnd(b, 240), 4)))
                SetByte(out, Add(op,1), PGMem_HexNib(BitwiseAnd(b, 15)))
                op = Add(op, 2)
                bi = Add(bi, 1)
                ci = Add(ci, 1)
            }
            gi = Add(gi, 1)
        }
        SetByte(out, 36, 0)
        Deallocate(rbuf, 16)
        Deallocate(group_sizes, 5)
        ReturnValue(out)
    }
}

// Send {"ok":true} plus optional extra key-value pairs already serialized.
// extra: a JSON object string like ,"id":42  (the comma-prefixed tail) or ""
Function.PGMem_SendOK {
    Input: fd: Integer
    Input: extra: Address
    Body: {
        IfCondition EqualTo(extra, 0) ThenBlock: {
            Socket.SendMsg(fd, "{\"ok\":true}")
        } ElseBlock: {
            msg = StringConcat("{\"ok\":true", extra)
            msg = StringConcat(msg, "}")
            Socket.SendMsg(fd, msg)
        }
    }
}

// cc_tools schema response — lets IPCDispatch.RegisterTool connect to pgmem.
Function.PGMem_SendSchema {
    Input: fd: Integer
    Body: {
        schema = "{\"name\":\"Pgmem\",\"description\":\"PostgreSQL context memory store. Park large content for later retrieval, or search previously stored results.\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"op\":{\"type\":\"string\",\"description\":\"Operation: park (store), pickup (retrieve by key), search (full-text search), compact (summarise)\"},\"key\":{\"type\":\"string\",\"description\":\"Key for park/pickup\"},\"content\":{\"type\":\"string\",\"description\":\"Content to store (park op)\"},\"kind\":{\"type\":\"string\",\"description\":\"Kind tag: tool_result, note, summary\"},\"query\":{\"type\":\"string\",\"description\":\"Search query (search op)\"},\"scope\":{\"type\":\"string\",\"description\":\"Scope: session, project, persistent\"}},\"required\":[\"op\"]}}"
        resp = StringConcat("{\"method\":\"schema_response\",\"schema\":", schema)
        resp = StringConcat(resp, "}")
        Socket.SendMsg(fd, resp)
    }
}

Function.PGMem_SendError {
    Input: fd: Integer
    Input: err: Address
    Body: {
        e = PGMem_EscStr(err)
        msg = StringConcat("{\"ok\":false,\"error\":\"", e)
        msg = StringConcat(msg, "\"}")
        Socket.SendMsg(fd, msg)
    }
}

// =============================================================================
// SCHEMA MIGRATION  — idempotent, runs on startup
// =============================================================================
Function.PGMem_Migrate {
    Output: Integer
    Body: {
        conn = PGMemState.conn
        PG_Query(conn, "CREATE TABLE IF NOT EXISTS hc_projects (id SERIAL PRIMARY KEY, name TEXT UNIQUE NOT NULL, path TEXT NOT NULL DEFAULT '')")
        PG_Query(conn, "CREATE TABLE IF NOT EXISTS hc_files (id SERIAL PRIMARY KEY, project_id INTEGER REFERENCES hc_projects(id), path TEXT NOT NULL, rel_path TEXT NOT NULL, lang TEXT, hash TEXT, indexed_at TIMESTAMPTZ DEFAULT NOW(), UNIQUE(project_id, path))")
        PG_Query(conn, "CREATE TABLE IF NOT EXISTS hc_symbols (id SERIAL PRIMARY KEY, file_id INTEGER REFERENCES hc_files(id), project_id INTEGER REFERENCES hc_projects(id), name TEXT NOT NULL, kind TEXT, line_start INTEGER, signature TEXT, body TEXT, tsv TSVECTOR GENERATED ALWAYS AS (to_tsvector('english', coalesce(name,'') || ' ' || coalesce(body,''))) STORED)")
        PG_Query(conn, "CREATE INDEX IF NOT EXISTS hc_symbols_tsv ON hc_symbols USING GIN(tsv)")
        PG_Query(conn, "CREATE TABLE IF NOT EXISTS hc_sessions (id TEXT PRIMARY KEY, project_id INTEGER REFERENCES hc_projects(id), parent_id TEXT REFERENCES hc_sessions(id), role TEXT, started_at TIMESTAMPTZ DEFAULT NOW(), ended_at TIMESTAMPTZ, status TEXT DEFAULT 'active')")
        PG_Query(conn, "CREATE TABLE IF NOT EXISTS hc_context (id SERIAL PRIMARY KEY, project_id INTEGER REFERENCES hc_projects(id), session_id TEXT REFERENCES hc_sessions(id), agent_id TEXT, parent_id INTEGER REFERENCES hc_context(id), key TEXT, kind TEXT, content TEXT, scope TEXT DEFAULT 'session', status TEXT DEFAULT 'active', archived_by INTEGER REFERENCES hc_context(id), tsv TSVECTOR GENERATED ALWAYS AS (to_tsvector('english', coalesce(key,'') || ' ' || coalesce(content,''))) STORED, created_at TIMESTAMPTZ DEFAULT NOW(), expires_at TIMESTAMPTZ)")
        PG_Query(conn, "CREATE INDEX IF NOT EXISTS hc_context_tsv ON hc_context USING GIN(tsv)")
        PG_Query(conn, "CREATE INDEX IF NOT EXISTS hc_context_lookup ON hc_context(project_id, scope, kind, status)")
        PG_Query(conn, "CREATE TABLE IF NOT EXISTS hc_tasks (id SERIAL PRIMARY KEY, project_id INTEGER REFERENCES hc_projects(id), session_id TEXT REFERENCES hc_sessions(id), parent_id INTEGER REFERENCES hc_tasks(id), title TEXT NOT NULL, kind TEXT, effort TEXT, min_tier INTEGER DEFAULT 1, assigned_to TEXT, provider TEXT, status TEXT DEFAULT 'pending', result_key TEXT, input_tokens INTEGER DEFAULT 0, output_tokens INTEGER DEFAULT 0, cost_usd NUMERIC(10,6), started_at TIMESTAMPTZ, ended_at TIMESTAMPTZ, created_at TIMESTAMPTZ DEFAULT NOW())")
        PG_Query(conn, "CREATE INDEX IF NOT EXISTS hc_tasks_session ON hc_tasks(session_id, status)")
        PG_Query(conn, "CREATE TABLE IF NOT EXISTS hc_model_ratings (id SERIAL PRIMARY KEY, task_id INTEGER REFERENCES hc_tasks(id) ON DELETE CASCADE, rated_by TEXT NOT NULL, score INTEGER NOT NULL CHECK (score BETWEEN 1 AND 5), tags TEXT[], usable BOOLEAN NOT NULL DEFAULT true, notes TEXT, rated_at TIMESTAMPTZ DEFAULT NOW())")

        ReturnValue(1)
    }
}

// =============================================================================
// PROJECT
// =============================================================================
Function.PGMem_GetOrCreateProject {
    Input: name: Address
    Output: Integer
    Body: {
        n = PGMem_EscStr(name)
        sql = StringConcat("INSERT INTO hc_projects (name, path) VALUES ('", n)
        sql = StringConcat(sql, "','")
        sql = StringConcat(sql, n)
        sql = StringConcat(sql, "') ON CONFLICT (name) DO UPDATE SET path=EXCLUDED.path RETURNING id")
        rows = PG_Query(PGMemState.conn, sql)
        IfCondition EqualTo(rows, 0) ThenBlock: { ReturnValue(0) }
        cnt = XArray.XSize(rows)
        IfCondition EqualTo(cnt, 0) ThenBlock: {
            PG_DestroyResult(rows)
            ReturnValue(0)
        }
        row = XArray.XGet(rows, 0)
        id_str = HashMap.HGetSimple(row, "id")
        id_int = StringToNumber(id_str)
        PG_DestroyResult(rows)
        ReturnValue(id_int)
    }
}

// =============================================================================
// OP: session_start
// =============================================================================
Function.PGMem_OpSessionStart {
    Input: fd: Integer
    Input: args: Address
    Body: {
        role = JSON.GetString(args, "role")
        IfCondition EqualTo(role, 0) ThenBlock: { role = "main" }
        parent_id = JSON.GetString(args, "parent_id")

        uuid = PGMem_UUID()
        IfCondition EqualTo(uuid, 0) ThenBlock: {
            PGMem_SendError(fd, "uuid generation failed")
            ReturnValue(0)
        }

        proj_str = NumberToString(PGMemState.project_id)
        r = PGMem_EscStr(role)
        sql = StringConcat("INSERT INTO hc_sessions (id, project_id, role, status) VALUES ('", uuid)
        sql = StringConcat(sql, "',")
        sql = StringConcat(sql, proj_str)
        sql = StringConcat(sql, ",'")
        sql = StringConcat(sql, r)
        sql = StringConcat(sql, "','active')")

        IfCondition NotEqual(parent_id, 0) ThenBlock: {
            p = PGMem_EscStr(parent_id)
            sql = StringConcat("INSERT INTO hc_sessions (id, project_id, parent_id, role, status) VALUES ('", uuid)
            sql = StringConcat(sql, "',")
            sql = StringConcat(sql, proj_str)
            sql = StringConcat(sql, ",'")
            sql = StringConcat(sql, p)
            sql = StringConcat(sql, "','")
            sql = StringConcat(sql, r)
            sql = StringConcat(sql, "','active')")
        }

        PG_Query(PGMemState.conn, sql)

        extra = StringConcat(",\"session_id\":\"", uuid)
        extra = StringConcat(extra, "\"")
        PGMem_SendOK(fd, extra)
        Deallocate(uuid, 37)
    }
}

// =============================================================================
// OP: session_end
// =============================================================================
Function.PGMem_OpSessionEnd {
    Input: fd: Integer
    Input: args: Address
    Body: {
        sid = JSON.GetString(args, "session_id")
        IfCondition EqualTo(sid, 0) ThenBlock: {
            PGMem_SendError(fd, "session_id required")
            ReturnValue(0)
        }
        s = PGMem_EscStr(sid)
        sql = StringConcat("UPDATE hc_sessions SET ended_at=NOW(), status='complete' WHERE id='", s)
        sql = StringConcat(sql, "'")
        PG_Query(PGMemState.conn, sql)

        // Expire session-scoped context
        sql2 = StringConcat("UPDATE hc_context SET status='inactive' WHERE session_id='", s)
        sql2 = StringConcat(sql2, "' AND scope='session' AND status='active'")
        PG_Query(PGMemState.conn, sql2)

        PGMem_SendOK(fd, 0)
    }
}

// =============================================================================
// OP: park
// =============================================================================
Function.PGMem_OpPark {
    Input: fd: Integer
    Input: args: Address
    Body: {
        key = JSON.GetString(args, "key")
        kind = JSON.GetString(args, "kind")
        content = JSON.GetString(args, "content")
        IfCondition EqualTo(key, 0) ThenBlock: {
            PGMem_SendError(fd, "key required")
            ReturnValue(0)
        }
        IfCondition EqualTo(content, 0) ThenBlock: { content = "" }
        IfCondition EqualTo(kind, 0) ThenBlock: { kind = "note" }

        scope = JSON.GetString(args, "scope")
        IfCondition EqualTo(scope, 0) ThenBlock: { scope = "session" }

        sid = JSON.GetString(args, "session_id")
        proj_str = NumberToString(PGMemState.project_id)

        k  = PGMem_EscStr(key)
        kd = PGMem_EscStr(kind)
        sc = PGMem_EscStr(scope)
        co = PGMem_EscStr(content)

        IfCondition NotEqual(sid, 0) ThenBlock: {
            se = PGMem_EscStr(sid)
            sql = StringConcat("INSERT INTO hc_context (project_id, session_id, key, kind, scope, content, status) VALUES (", proj_str)
            sql = StringConcat(sql, ",'")
            sql = StringConcat(sql, se)
            sql = StringConcat(sql, "','")
            sql = StringConcat(sql, k)
            sql = StringConcat(sql, "','")
            sql = StringConcat(sql, kd)
            sql = StringConcat(sql, "','")
            sql = StringConcat(sql, sc)
            sql = StringConcat(sql, "','")
            sql = StringConcat(sql, co)
            sql = StringConcat(sql, "','active') RETURNING id")
        } ElseBlock: {
            sql = StringConcat("INSERT INTO hc_context (project_id, key, kind, scope, content, status) VALUES (", proj_str)
            sql = StringConcat(sql, ",'")
            sql = StringConcat(sql, k)
            sql = StringConcat(sql, "','")
            sql = StringConcat(sql, kd)
            sql = StringConcat(sql, "','")
            sql = StringConcat(sql, sc)
            sql = StringConcat(sql, "','")
            sql = StringConcat(sql, co)
            sql = StringConcat(sql, "','active') RETURNING id")
        }

        rows = PG_Query(PGMemState.conn, sql)
        IfCondition EqualTo(rows, 0) ThenBlock: {
            PGMem_SendError(fd, "park insert failed")
            ReturnValue(0)
        }
        id_str = "0"
        IfCondition GreaterThan(XArray.XSize(rows), 0) ThenBlock: {
            row = XArray.XGet(rows, 0)
            id_str = HashMap.HGetSimple(row, "id")
        }
        PG_DestroyResult(rows)
        ek = PGMem_EscStr(key)
        extra = StringConcat(",\"id\":", id_str)
        extra = StringConcat(extra, ",\"content\":\"parked key=")
        extra = StringConcat(extra, ek)
        extra = StringConcat(extra, " id=")
        extra = StringConcat(extra, id_str)
        extra = StringConcat(extra, "\"")
        PGMem_SendOK(fd, extra)
    }
}

// =============================================================================
// OP: pickup
// =============================================================================
Function.PGMem_OpPickup {
    Input: fd: Integer
    Input: args: Address
    Body: {
        key = JSON.GetString(args, "key")
        IfCondition EqualTo(key, 0) ThenBlock: {
            PGMem_SendError(fd, "key required")
            ReturnValue(0)
        }
        k = PGMem_EscStr(key)
        proj_str = NumberToString(PGMemState.project_id)
        sid = JSON.GetString(args, "session_id")

        IfCondition NotEqual(sid, 0) ThenBlock: {
            se = PGMem_EscStr(sid)
            sql = StringConcat("SELECT id, key, kind, scope, content FROM hc_context WHERE project_id=", proj_str)
            sql = StringConcat(sql, " AND key='")
            sql = StringConcat(sql, k)
            sql = StringConcat(sql, "' AND status='active' AND (session_id='")
            sql = StringConcat(sql, se)
            sql = StringConcat(sql, "' OR scope IN ('project','persistent')) ORDER BY created_at DESC LIMIT 1")
        } ElseBlock: {
            sql = StringConcat("SELECT id, key, kind, scope, content FROM hc_context WHERE project_id=", proj_str)
            sql = StringConcat(sql, " AND key='")
            sql = StringConcat(sql, k)
            sql = StringConcat(sql, "' AND status='active' ORDER BY created_at DESC LIMIT 1")
        }

        rows = PG_Query(PGMemState.conn, sql)
        IfCondition EqualTo(rows, 0) ThenBlock: {
            PGMem_SendError(fd, "not found")
            ReturnValue(0)
        }
        IfCondition EqualTo(XArray.XSize(rows), 0) ThenBlock: {
            PG_DestroyResult(rows)
            PGMem_SendError(fd, "not found")
            ReturnValue(0)
        }
        row = XArray.XGet(rows, 0)
        v_id      = HashMap.HGetSimple(row, "id")
        v_kind    = HashMap.HGetSimple(row, "kind")
        v_scope   = HashMap.HGetSimple(row, "scope")
        v_content = HashMap.HGetSimple(row, "content")
        IfCondition EqualTo(v_content, 0) ThenBlock: { v_content = "" }
        ek = PGMem_EscStr(v_kind)
        es = PGMem_EscStr(v_scope)
        ec = PGMem_EscStr(v_content)
        extra = StringConcat(",\"id\":", v_id)
        extra = StringConcat(extra, ",\"kind\":\"")
        extra = StringConcat(extra, ek)
        extra = StringConcat(extra, "\",\"scope\":\"")
        extra = StringConcat(extra, es)
        extra = StringConcat(extra, "\",\"content\":\"")
        extra = StringConcat(extra, ec)
        extra = StringConcat(extra, "\"")
        PG_DestroyResult(rows)
        PGMem_SendOK(fd, extra)
    }
}

// =============================================================================
// OP: search
// =============================================================================
Function.PGMem_OpSearch {
    Input: fd: Integer
    Input: args: Address
    Body: {
        query = JSON.GetString(args, "query")
        IfCondition EqualTo(query, 0) ThenBlock: {
            PGMem_SendError(fd, "query required")
            ReturnValue(0)
        }
        kind  = JSON.GetString(args, "kind")
        scope = JSON.GetString(args, "scope")
        sid   = JSON.GetString(args, "session_id")
        proj_str = NumberToString(PGMemState.project_id)
        q = PGMem_EscStr(query)

        sql = StringConcat("SELECT id, key, kind, scope, content FROM hc_context WHERE project_id=", proj_str)
        sql = StringConcat(sql, " AND status='active' AND tsv @@ plainto_tsquery('english','")
        sql = StringConcat(sql, q)
        sql = StringConcat(sql, "')")

        IfCondition NotEqual(kind, 0) ThenBlock: {
            kd = PGMem_EscStr(kind)
            sql = StringConcat(sql, " AND kind='")
            sql = StringConcat(sql, kd)
            sql = StringConcat(sql, "'")
        }
        IfCondition NotEqual(scope, 0) ThenBlock: {
            sc = PGMem_EscStr(scope)
            sql = StringConcat(sql, " AND scope='")
            sql = StringConcat(sql, sc)
            sql = StringConcat(sql, "'")
        }
        IfCondition NotEqual(sid, 0) ThenBlock: {
            se = PGMem_EscStr(sid)
            sql = StringConcat(sql, " AND (session_id='")
            sql = StringConcat(sql, se)
            sql = StringConcat(sql, "' OR scope IN ('project','persistent'))")
        }
        sql = StringConcat(sql, " ORDER BY created_at DESC LIMIT ")
        sql = StringConcat(sql, NumberToString(PGMemConst.MAX_ROWS))

        PGMem_EmitContextRows(fd, sql)
    }
}

// =============================================================================
// OP: tree
// =============================================================================
Function.PGMem_OpTree {
    Input: fd: Integer
    Input: args: Address
    Body: {
        scope = JSON.GetString(args, "scope")
        sid   = JSON.GetString(args, "session_id")
        IfCondition EqualTo(scope, 0) ThenBlock: { scope = "persistent" }
        proj_str = NumberToString(PGMemState.project_id)
        sc = PGMem_EscStr(scope)

        sql = StringConcat("SELECT id, key, kind, scope, content FROM hc_context WHERE project_id=", proj_str)
        sql = StringConcat(sql, " AND status='active' AND scope='")
        sql = StringConcat(sql, sc)
        sql = StringConcat(sql, "'")

        IfCondition NotEqual(sid, 0) ThenBlock: {
            se = PGMem_EscStr(sid)
            sql = StringConcat(sql, " AND session_id='")
            sql = StringConcat(sql, se)
            sql = StringConcat(sql, "'")
        }
        sql = StringConcat(sql, " ORDER BY created_at ASC LIMIT ")
        sql = StringConcat(sql, NumberToString(PGMemConst.MAX_ROWS))

        PGMem_EmitContextRows(fd, sql)
    }
}

// Shared: run a context SELECT sql and send {ok:true, rows:[...]} response.
Function.PGMem_EmitContextRows {
    Input: fd: Integer
    Input: sql: Address
    Body: {
        rows = PG_Query(PGMemState.conn, sql)
        arr = JSON.NewArray()
        IfCondition NotEqual(rows, 0) ThenBlock: {
            cnt = XArray.XSize(rows)
            i = 0
            WhileLoop LessThan(i, cnt) {
                row = XArray.XGet(rows, i)
                obj = JSON.NewObject()
                JSON.SetString(obj, "id",      HashMap.HGetSimple(row, "id"))
                JSON.SetString(obj, "key",     HashMap.HGetSimple(row, "key"))
                JSON.SetString(obj, "kind",    HashMap.HGetSimple(row, "kind"))
                JSON.SetString(obj, "scope",   HashMap.HGetSimple(row, "scope"))
                JSON.SetString(obj, "content", HashMap.HGetSimple(row, "content"))
                JSON.PushObject(arr, obj)
                i = Add(i, 1)
            }
            PG_DestroyResult(rows)
        }
        resp = JSON.NewObject()
        JSON.SetBool(resp, "ok", 1)
        JSON.SetArray(resp, "rows", arr)
        out = JSON.Serialize(resp)
        Socket.SendMsg(fd, out)
    }
}

// =============================================================================
// OP: compact  (ACID — summary row + retire stale rows in one transaction)
// =============================================================================
Function.PGMem_OpCompact {
    Input: fd: Integer
    Input: args: Address
    Body: {
        keys    = JSON.GetString(args, "keys")    // comma-separated
        summary = JSON.GetString(args, "summary")
        sid     = JSON.GetString(args, "session_id")
        IfCondition EqualTo(keys, 0) ThenBlock: {
            PGMem_SendError(fd, "keys required")
            ReturnValue(0)
        }
        IfCondition EqualTo(summary, 0) ThenBlock: {
            PGMem_SendError(fd, "summary required")
            ReturnValue(0)
        }

        proj_str = NumberToString(PGMemState.project_id)
        su = PGMem_EscStr(summary)

        PG_Begin(PGMemState.conn)

        // Insert summary row
        IfCondition NotEqual(sid, 0) ThenBlock: {
            se = PGMem_EscStr(sid)
            ins = StringConcat("INSERT INTO hc_context (project_id, session_id, key, kind, scope, content, status) VALUES (", proj_str)
            ins = StringConcat(ins, ",'")
            ins = StringConcat(ins, se)
            ins = StringConcat(ins, "','compaction-summary','summary','persistent','")
            ins = StringConcat(ins, su)
            ins = StringConcat(ins, "','active') RETURNING id")
        } ElseBlock: {
            ins = StringConcat("INSERT INTO hc_context (project_id, key, kind, scope, content, status) VALUES (", proj_str)
            ins = StringConcat(ins, ",'compaction-summary','summary','persistent','")
            ins = StringConcat(ins, su)
            ins = StringConcat(ins, "','active') RETURNING id")
        }

        sum_rows = PG_Query(PGMemState.conn, ins)
        IfCondition EqualTo(sum_rows, 0) ThenBlock: {
            PG_Rollback(PGMemState.conn)
            PGMem_SendError(fd, "compact: summary insert failed")
            ReturnValue(0)
        }
        sum_id_str = "0"
        IfCondition GreaterThan(XArray.XSize(sum_rows), 0) ThenBlock: {
            srow = XArray.XGet(sum_rows, 0)
            sum_id_str = HashMap.HGetSimple(srow, "id")
        }
        PG_DestroyResult(sum_rows)

        // Build IN list from comma-separated keys  ('k1','k2',...)
        // Simple: iterate chars, copy them, wrap each token in quotes
        in_list = PGMem_KeysToInList(keys)
        upd = StringConcat("UPDATE hc_context SET status='inactive', archived_by=", sum_id_str)
        upd = StringConcat(upd, " WHERE project_id=")
        upd = StringConcat(upd, proj_str)
        upd = StringConcat(upd, " AND status='active' AND key IN (")
        upd = StringConcat(upd, in_list)
        upd = StringConcat(upd, ")")
        PG_Query(PGMemState.conn, upd)
        PG_Commit(PGMemState.conn)

        extra = StringConcat(",\"summary_id\":", sum_id_str)
        PGMem_SendOK(fd, extra)
    }
}

// Convert "k1,k2,k3" -> "'k1','k2','k3'" for SQL IN clause.
Function.PGMem_KeysToInList {
    Input: keys: Address
    Output: Address
    Body: {
        buf = Allocate(4096)
        src = keys
        di = 0
        // Write opening quote for first token
        SetByte(buf, di, 39)  // '
        di = Add(di, 1)
        si = 0
        WhileLoop EqualTo(1, 1) {
            c = GetByte(src, si)
            IfCondition EqualTo(c, 0) ThenBlock: {
                SetByte(buf, di, 39)   // close last token
                di = Add(di, 1)
                si = Add(si, 4096)     // break
            } ElseBlock: {
                IfCondition EqualTo(c, 44) ThenBlock: {   // comma
                    SetByte(buf, di, 39)   // close token
                    di = Add(di, 1)
                    SetByte(buf, di, 44)   // comma
                    di = Add(di, 1)
                    SetByte(buf, di, 39)   // open next token
                    di = Add(di, 1)
                } ElseBlock: {
                    IfCondition EqualTo(c, 39) ThenBlock: {  // escape quote
                        SetByte(buf, di, 39)
                        di = Add(di, 1)
                    }
                    SetByte(buf, di, c)
                    di = Add(di, 1)
                }
                si = Add(si, 1)
            }
        }
        SetByte(buf, di, 0)
        ReturnValue(buf)
    }
}

// =============================================================================
// OP: task_create
// =============================================================================
Function.PGMem_OpTaskCreate {
    Input: fd: Integer
    Input: args: Address
    Body: {
        title  = JSON.GetString(args, "title")
        kind   = JSON.GetString(args, "kind")
        effort = JSON.GetString(args, "effort")
        IfCondition EqualTo(title, 0) ThenBlock: {
            PGMem_SendError(fd, "title required")
            ReturnValue(0)
        }
        IfCondition EqualTo(kind,   0) ThenBlock: { kind   = "general" }
        IfCondition EqualTo(effort, 0) ThenBlock: { effort = "medium"  }

        tier_str = JSON.GetString(args, "min_tier")
        IfCondition EqualTo(tier_str, 0) ThenBlock: { tier_str = "1" }
        sid      = JSON.GetString(args, "session_id")
        par_str  = JSON.GetString(args, "parent_id")
        proj_str = NumberToString(PGMemState.project_id)

        ti = PGMem_EscStr(title)
        kd = PGMem_EscStr(kind)
        ef = PGMem_EscStr(effort)

        IfCondition NotEqual(sid, 0) ThenBlock: {
            se = PGMem_EscStr(sid)
            sql = StringConcat("INSERT INTO hc_tasks (project_id, session_id, title, kind, effort, min_tier, status) VALUES (", proj_str)
            sql = StringConcat(sql, ",'")
            sql = StringConcat(sql, se)
            sql = StringConcat(sql, "','")
            sql = StringConcat(sql, ti)
            sql = StringConcat(sql, "','")
            sql = StringConcat(sql, kd)
            sql = StringConcat(sql, "','")
            sql = StringConcat(sql, ef)
            sql = StringConcat(sql, "',")
            sql = StringConcat(sql, tier_str)
            sql = StringConcat(sql, ",'pending') RETURNING id")
        } ElseBlock: {
            sql = StringConcat("INSERT INTO hc_tasks (project_id, title, kind, effort, min_tier, status) VALUES (", proj_str)
            sql = StringConcat(sql, ",'")
            sql = StringConcat(sql, ti)
            sql = StringConcat(sql, "','")
            sql = StringConcat(sql, kd)
            sql = StringConcat(sql, "','")
            sql = StringConcat(sql, ef)
            sql = StringConcat(sql, "',")
            sql = StringConcat(sql, tier_str)
            sql = StringConcat(sql, ",'pending') RETURNING id")
        }

        rows = PG_Query(PGMemState.conn, sql)
        id_str = "0"
        IfCondition NotEqual(rows, 0) ThenBlock: {
            IfCondition GreaterThan(XArray.XSize(rows), 0) ThenBlock: {
                row = XArray.XGet(rows, 0)
                id_str = HashMap.HGetSimple(row, "id")
            }
            PG_DestroyResult(rows)
        }
        extra = StringConcat(",\"task_id\":", id_str)
        PGMem_SendOK(fd, extra)
    }
}

// =============================================================================
// OP: task_start
// =============================================================================
Function.PGMem_OpTaskStart {
    Input: fd: Integer
    Input: args: Address
    Body: {
        task_id  = JSON.GetString(args, "task_id")
        assigned = JSON.GetString(args, "assigned_to")
        provider = JSON.GetString(args, "provider")
        IfCondition EqualTo(task_id, 0) ThenBlock: {
            PGMem_SendError(fd, "task_id required")
            ReturnValue(0)
        }
        IfCondition EqualTo(assigned, 0) ThenBlock: { assigned = "unknown" }
        IfCondition EqualTo(provider, 0) ThenBlock: { provider = "unknown" }

        a = PGMem_EscStr(assigned)
        p = PGMem_EscStr(provider)
        sql = StringConcat("UPDATE hc_tasks SET status='running', assigned_to='", a)
        sql = StringConcat(sql, "', provider='")
        sql = StringConcat(sql, p)
        sql = StringConcat(sql, "', started_at=NOW() WHERE id=")
        sql = StringConcat(sql, task_id)
        PG_Query(PGMemState.conn, sql)
        PGMem_SendOK(fd, 0)
    }
}

// =============================================================================
// OP: task_end
// =============================================================================
Function.PGMem_OpTaskEnd {
    Input: fd: Integer
    Input: args: Address
    Body: {
        task_id  = JSON.GetString(args, "task_id")
        status   = JSON.GetString(args, "status")
        in_tok   = JSON.GetString(args, "input_tokens")
        out_tok  = JSON.GetString(args, "output_tokens")
        cost     = JSON.GetString(args, "cost_usd")
        rkey     = JSON.GetString(args, "result_key")
        IfCondition EqualTo(task_id, 0) ThenBlock: {
            PGMem_SendError(fd, "task_id required")
            ReturnValue(0)
        }
        IfCondition EqualTo(status,  0) ThenBlock: { status  = "complete" }
        IfCondition EqualTo(in_tok,  0) ThenBlock: { in_tok  = "0" }
        IfCondition EqualTo(out_tok, 0) ThenBlock: { out_tok = "0" }
        IfCondition EqualTo(cost,    0) ThenBlock: { cost    = "0" }

        st = PGMem_EscStr(status)
        sql = StringConcat("UPDATE hc_tasks SET status='", st)
        sql = StringConcat(sql, "', ended_at=NOW(), input_tokens=")
        sql = StringConcat(sql, in_tok)
        sql = StringConcat(sql, ", output_tokens=")
        sql = StringConcat(sql, out_tok)
        sql = StringConcat(sql, ", cost_usd=")
        sql = StringConcat(sql, cost)

        IfCondition NotEqual(rkey, 0) ThenBlock: {
            rk = PGMem_EscStr(rkey)
            sql = StringConcat(sql, ", result_key='")
            sql = StringConcat(sql, rk)
            sql = StringConcat(sql, "'")
        }

        sql = StringConcat(sql, " WHERE id=")
        sql = StringConcat(sql, task_id)
        PG_Query(PGMemState.conn, sql)
        PGMem_SendOK(fd, 0)
    }
}

// =============================================================================
// OP: task_list
// =============================================================================
Function.PGMem_OpTaskList {
    Input: fd: Integer
    Input: args: Address
    Body: {
        sid    = JSON.GetString(args, "status")    // filter by status (optional)
        sessid = JSON.GetString(args, "session_id")
        proj_str = NumberToString(PGMemState.project_id)

        sql = StringConcat("SELECT id, title, kind, effort, assigned_to, provider, status, input_tokens, output_tokens, cost_usd FROM hc_tasks WHERE project_id=", proj_str)

        IfCondition NotEqual(sessid, 0) ThenBlock: {
            se = PGMem_EscStr(sessid)
            sql = StringConcat(sql, " AND session_id='")
            sql = StringConcat(sql, se)
            sql = StringConcat(sql, "'")
        }
        IfCondition NotEqual(sid, 0) ThenBlock: {
            st = PGMem_EscStr(sid)
            sql = StringConcat(sql, " AND status='")
            sql = StringConcat(sql, st)
            sql = StringConcat(sql, "'")
        }
        sql = StringConcat(sql, " ORDER BY created_at ASC LIMIT ")
        sql = StringConcat(sql, NumberToString(PGMemConst.MAX_ROWS))

        rows = PG_Query(PGMemState.conn, sql)
        arr = JSON.NewArray()
        IfCondition NotEqual(rows, 0) ThenBlock: {
            cnt = XArray.XSize(rows)
            i = 0
            WhileLoop LessThan(i, cnt) {
                row = XArray.XGet(rows, i)
                obj = JSON.NewObject()
                JSON.SetString(obj, "id",            HashMap.HGetSimple(row, "id"))
                JSON.SetString(obj, "title",         HashMap.HGetSimple(row, "title"))
                JSON.SetString(obj, "kind",          HashMap.HGetSimple(row, "kind"))
                JSON.SetString(obj, "effort",        HashMap.HGetSimple(row, "effort"))
                JSON.SetString(obj, "assigned_to",   HashMap.HGetSimple(row, "assigned_to"))
                JSON.SetString(obj, "provider",      HashMap.HGetSimple(row, "provider"))
                JSON.SetString(obj, "status",        HashMap.HGetSimple(row, "status"))
                JSON.SetString(obj, "input_tokens",  HashMap.HGetSimple(row, "input_tokens"))
                JSON.SetString(obj, "output_tokens", HashMap.HGetSimple(row, "output_tokens"))
                JSON.SetString(obj, "cost_usd",      HashMap.HGetSimple(row, "cost_usd"))
                JSON.PushObject(arr, obj)
                i = Add(i, 1)
            }
            PG_DestroyResult(rows)
        }
        resp = JSON.NewObject()
        JSON.SetBool(resp, "ok", 1)
        JSON.SetArray(resp, "tasks", arr)
        out = JSON.Serialize(resp)
        Socket.SendMsg(fd, out)
    }
}

// =============================================================================
// OP: rate  (frontier model rates a completed task)
// =============================================================================
Function.PGMem_OpRate {
    Input: fd: Integer
    Input: args: Address
    Body: {
        task_id  = JSON.GetString(args, "task_id")
        score    = JSON.GetString(args, "score")
        rated_by = JSON.GetString(args, "rated_by")
        notes    = JSON.GetString(args, "notes")
        tags     = JSON.GetString(args, "tags")     // comma-separated
        IfCondition EqualTo(task_id,  0) ThenBlock: { PGMem_SendError(fd, "task_id required")  ReturnValue(0) }
        IfCondition EqualTo(score,    0) ThenBlock: { PGMem_SendError(fd, "score required")     ReturnValue(0) }
        IfCondition EqualTo(rated_by, 0) ThenBlock: { rated_by = "unknown" }
        IfCondition EqualTo(notes,    0) ThenBlock: { notes = "" }

        rb = PGMem_EscStr(rated_by)
        no = PGMem_EscStr(notes)
        usable = "true"
        score_int = StringToNumber(score)
        IfCondition LessThan(score_int, 3) ThenBlock: { usable = "false" }

        IfCondition NotEqual(tags, 0) ThenBlock: {
            // Build Postgres array literal: ARRAY['tag1','tag2']
            in_list = PGMem_KeysToInList(tags)
            tags_sql = StringConcat("ARRAY[", in_list)
            tags_sql = StringConcat(tags_sql, "]")
            sql = StringConcat("INSERT INTO hc_model_ratings (task_id, rated_by, score, tags, usable, notes) VALUES (", task_id)
            sql = StringConcat(sql, ",'")
            sql = StringConcat(sql, rb)
            sql = StringConcat(sql, "',")
            sql = StringConcat(sql, score)
            sql = StringConcat(sql, ",")
            sql = StringConcat(sql, tags_sql)
            sql = StringConcat(sql, ",")
            sql = StringConcat(sql, usable)
            sql = StringConcat(sql, ",'")
            sql = StringConcat(sql, no)
            sql = StringConcat(sql, "')")
        } ElseBlock: {
            sql = StringConcat("INSERT INTO hc_model_ratings (task_id, rated_by, score, usable, notes) VALUES (", task_id)
            sql = StringConcat(sql, ",'")
            sql = StringConcat(sql, rb)
            sql = StringConcat(sql, "',")
            sql = StringConcat(sql, score)
            sql = StringConcat(sql, ",")
            sql = StringConcat(sql, usable)
            sql = StringConcat(sql, ",'")
            sql = StringConcat(sql, no)
            sql = StringConcat(sql, "')")
        }
        PG_Query(PGMemState.conn, sql)
        PGMem_SendOK(fd, 0)
    }
}

// =============================================================================
// DISPATCH
// =============================================================================
Function.PGMem_HandleRequest {
    Input: fd: Integer
    Input: req: Address
    Body: {
        obj = JSON.AsObject(ParseJSON(req))
        IfCondition EqualTo(obj, 0) ThenBlock: {
            PGMem_SendError(fd, "invalid json")
            ReturnValue(0)
        }

        // cc_tools envelope: {"method":"schema"} or {"method":"call","args":{...}}
        method = JSON.GetString(obj, "method")
        IfCondition NotEqual(method, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(method, "schema"), 0) ThenBlock: {
                PGMem_SendSchema(fd)
                ReturnValue(0)
            }
            IfCondition EqualTo(StringCompare(method, "call"), 0) ThenBlock: {
                args = JSON.GetObject(obj, "args")
                IfCondition EqualTo(args, 0) ThenBlock: {
                    PGMem_SendError(fd, "args required for call")
                    ReturnValue(0)
                }
                obj = args
            }
        }

        op = JSON.GetString(obj, "op")
        IfCondition EqualTo(op, 0) ThenBlock: {
            PGMem_SendError(fd, "op required")
            ReturnValue(0)
        }

        IfCondition EqualTo(StringCompare(op, "session_start"), 0) ThenBlock: { PGMem_OpSessionStart(fd, obj) ReturnValue(0) }
        IfCondition EqualTo(StringCompare(op, "session_end"),   0) ThenBlock: { PGMem_OpSessionEnd(fd, obj)   ReturnValue(0) }
        IfCondition EqualTo(StringCompare(op, "park"),          0) ThenBlock: { PGMem_OpPark(fd, obj)         ReturnValue(0) }
        IfCondition EqualTo(StringCompare(op, "pickup"),        0) ThenBlock: { PGMem_OpPickup(fd, obj)       ReturnValue(0) }
        IfCondition EqualTo(StringCompare(op, "search"),        0) ThenBlock: { PGMem_OpSearch(fd, obj)       ReturnValue(0) }
        IfCondition EqualTo(StringCompare(op, "tree"),          0) ThenBlock: { PGMem_OpTree(fd, obj)         ReturnValue(0) }
        IfCondition EqualTo(StringCompare(op, "compact"),       0) ThenBlock: { PGMem_OpCompact(fd, obj)      ReturnValue(0) }
        IfCondition EqualTo(StringCompare(op, "task_create"),   0) ThenBlock: { PGMem_OpTaskCreate(fd, obj)   ReturnValue(0) }
        IfCondition EqualTo(StringCompare(op, "task_start"),    0) ThenBlock: { PGMem_OpTaskStart(fd, obj)    ReturnValue(0) }
        IfCondition EqualTo(StringCompare(op, "task_end"),      0) ThenBlock: { PGMem_OpTaskEnd(fd, obj)      ReturnValue(0) }
        IfCondition EqualTo(StringCompare(op, "task_list"),     0) ThenBlock: { PGMem_OpTaskList(fd, obj)     ReturnValue(0) }
        IfCondition EqualTo(StringCompare(op, "rate"),          0) ThenBlock: { PGMem_OpRate(fd, obj)         ReturnValue(0) }

        PGMem_SendError(fd, "unknown op")
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()
    PGMemConst.SOCK_PATH = "@halcode/Pgmem"
    PGMemConst.PG_HOST   = "/var/run/postgresql"   // Unix-socket directory
    PGMemConst.PG_DB     = "ailang_system"
    PGMemConst.PG_USER   = "sean"                   // local peer-auth user
    PGMemConst.PG_PASS   = ""
    PGMemState.esc_buf   = Allocate(PGMemConst.ESC_BUF_SZ)

    // Project defaults — override via env/args in future
    PGMemState.project_name = "HalCode9000"

    PrintMessage("[cc_pgmem_ipc] connecting to postgres (unix socket)...\n")
    conn = PG_ConnectUnix(PGMemConst.PG_HOST, PGMemConst.PG_PORT,
                          PGMemConst.PG_DB, PGMemConst.PG_USER, PGMemConst.PG_PASS)
    IfCondition EqualTo(conn, 0) ThenBlock: {
        PrintMessage("[cc_pgmem_ipc] ERROR: postgres connect failed\n")
        Exit(1)
    }
    PGMemState.conn = conn
    PrintMessage("[cc_pgmem_ipc] connected\n")

    PrintMessage("[cc_pgmem_ipc] running schema migration...\n")
    PGMem_Migrate()
    PrintMessage("[cc_pgmem_ipc] migration ok\n")

    proj_id = PGMem_GetOrCreateProject(PGMemState.project_name)
    IfCondition EqualTo(proj_id, 0) ThenBlock: {
        PrintMessage("[cc_pgmem_ipc] ERROR: could not get/create project\n")
        Exit(1)
    }
    PGMemState.project_id = proj_id
    PrintMessage("[cc_pgmem_ipc] project_id=")
    PrintNumber(proj_id)
    PrintMessage("\n")

    fd = Socket.Create(1, 1)
    IfCondition LessThan(fd, 0) ThenBlock: {
        PrintMessage("[cc_pgmem_ipc] ERROR: socket create failed\n")
        Exit(1)
    }

    bind_rc = Socket.BindUnix(fd, PGMemConst.SOCK_PATH)
    IfCondition LessThan(bind_rc, 0) ThenBlock: {
        PrintMessage("[cc_pgmem_ipc] ERROR: bind to ")
        PrintMessage(PGMemConst.SOCK_PATH)
        PrintMessage(" failed (already in use?)\n")
        Exit(1)
    }

    listen_rc = Socket.Listen(fd, PGMemConst.BACKLOG)
    IfCondition LessThan(listen_rc, 0) ThenBlock: {
        PrintMessage("[cc_pgmem_ipc] ERROR: listen failed\n")
        Exit(1)
    }
    PGMemState.listen_fd = fd

    PrintMessage("[cc_pgmem_ipc] listening on ")
    PrintMessage(PGMemConst.SOCK_PATH)
    PrintMessage("\n")

    WhileLoop EqualTo(PGMemState.running, 1) {
        client_fd = Socket.Accept(PGMemState.listen_fd)
        IfCondition GreaterEqual(client_fd, 0) ThenBlock: {
            done = 0
            WhileLoop EqualTo(done, 0) {
                req = Socket.RecvMsg(client_fd)
                IfCondition EqualTo(req, 0) ThenBlock: { done = 1 }
                IfCondition NotEqual(req, 0) ThenBlock: {
                    IfCondition NotEqual(req, -1) ThenBlock: {
                        PGMem_HandleRequest(client_fd, req)
                    }
                }
            }
            Socket.Close(client_fd)
        }
        // On accept error (e.g. EINTR), check if we should still be running
        IfCondition LessThan(client_fd, 0) ThenBlock: {
            IfCondition EqualTo(PGMemState.running, 0) ThenBlock: {
                // Shutting down, exit accept loop
            }
        }
    }
    PG_Disconnect(PGMemState.conn)
}

RunTask(Main)
