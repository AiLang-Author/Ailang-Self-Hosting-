Function.SK_SleepMs {
    Input: ms: Integer
    Body: {
        IfCondition EqualTo(SK.ts, 0) ThenBlock: { SK.ts = Allocate(16) }
        StoreValue(SK.ts, 0)
        StoreValue(Add(SK.ts, 8), Multiply(ms, 1000000))
        SystemCall(SKSys.SYS_NANOSLEEP, SK.ts, 0)
    }
}

Function.SK_Boot {
    Body: {
        IfCondition NotEqual(SK.root, 0) ThenBlock: { ReturnValue(0) }
        SK.root = Allocate(512)
        MemorySet(SK.root, 0, 512)
        SK.pbuild = Allocate(600)
        MemorySet(SK.pbuild, 0, 600)
        src = "/dev/shm/synth_app"
        i = 0
        stop = 0
        WhileLoop EqualTo(stop, 0) {
            c = GetByte(src, i)
            SetByte(SK.root, i, c)
            IfCondition EqualTo(c, 0) ThenBlock: { stop = 1 }
            IfCondition EqualTo(stop, 0) ThenBlock: { i = Add(i, 1) }
        }
        cmd = Allocate(512)
        MemorySet(cmd, 0, 512)
        n = SK_ReadFile("/proc/self/cmdline", cmd, 500)
        i = 0
        stop = 0
        WhileLoop EqualTo(stop, 0) {
            IfCondition GreaterEqual(i, n) ThenBlock: { stop = 1 }
            IfCondition EqualTo(stop, 0) ThenBlock: {
                IfCondition EqualTo(GetByte(cmd, i), 0) ThenBlock: { stop = 1 }
                IfCondition EqualTo(stop, 0) ThenBlock: { i = Add(i, 1) }
            }
        }
        IfCondition LessThan(i, n) ThenBlock: { i = Add(i, 1) }
        IfCondition LessThan(i, n) ThenBlock: {
            IfCondition NotEqual(GetByte(cmd, i), 0) ThenBlock: {
                MemorySet(SK.root, 0, 512)
                k = 0
                stop = 0
                WhileLoop EqualTo(stop, 0) {
                    IfCondition GreaterEqual(i, n) ThenBlock: { stop = 1 }
                    IfCondition GreaterEqual(k, 500) ThenBlock: { stop = 1 }
                    IfCondition EqualTo(stop, 0) ThenBlock: {
                        c = GetByte(cmd, i)
                        SetByte(SK.root, k, c)
                        IfCondition EqualTo(c, 0) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(stop, 0) ThenBlock: {
                            i = Add(i, 1)
                            k = Add(k, 1)
                        }
                    }
                }
                IfCondition LessThan(i, n) ThenBlock: {
                    IfCondition EqualTo(GetByte(cmd, i), 0) ThenBlock: { i = Add(i, 1) }
                }
                IfCondition LessThan(i, n) ThenBlock: {
                    IfCondition EqualTo(GetByte(cmd, i), 99) ThenBlock: { SK.playhead = 1 }
                }
            }
        }
        Deallocate(cmd, 512)
    }
}

Function.SK_Path {
    Input: name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SK.root, 0) ThenBlock: { SK_Boot() }
        dst = SK.pbuild
        MemorySet(dst, 0, 600)
        i = 0
        stop = 0
        WhileLoop EqualTo(stop, 0) {
            c = GetByte(SK.root, i)
            IfCondition EqualTo(c, 0) ThenBlock: { stop = 1 }
            IfCondition EqualTo(stop, 0) ThenBlock: {
                SetByte(dst, i, c)
                i = Add(i, 1)
            }
        }
        SetByte(dst, i, 47)
        i = Add(i, 1)
        j = 0
        stop = 0
        WhileLoop EqualTo(stop, 0) {
            c = GetByte(name, j)
            SetByte(dst, i, c)
            IfCondition EqualTo(c, 0) ThenBlock: { stop = 1 }
            IfCondition EqualTo(stop, 0) ThenBlock: {
                i = Add(i, 1)
                j = Add(j, 1)
            }
        }
        ReturnValue(dst)
    }
}

Function.SK_Ensure {
    Body: {
        IfCondition EqualTo(SK.root, 0) ThenBlock: { SK_Boot() }
        SystemCall(SKSys.SYS_MKDIR, "/dev/shm", 493)
        SystemCall(SKSys.SYS_MKDIR, SK.root, 493)
    }
}

Function.SK_OpenPcm {
    Output: Address
    Body: {
        flags = Add(SKSys.O_RDWR, SKSys.O_CREAT)
        pcm_path = SK_Path("pcm.bin")
        fd = SystemCall(SKSys.SYS_OPEN, pcm_path, flags, 438)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        total = Add(SKConst.HDR, Multiply(SKConst.CAP, 4))
        SystemCall(SKSys.SYS_FTRUNCATE, fd, total)
        ptr = SystemCall(SKSys.SYS_MMAP, 0, total, SKSys.PROT_RW, SKSys.MAP_SHARED, fd, 0)
        IfCondition LessEqual(ptr, 0) ThenBlock: {
            SystemCall(SKSys.SYS_CLOSE, fd)
            ReturnValue(0)
        }
        StoreValue(Add(ptr, SKOff.MAGIC), SKConst.MAGIC)
        StoreValue(Add(ptr, SKOff.CAP), SKConst.CAP)
        mag = Dereference(Add(ptr, SKOff.WRITE))
        IfCondition EqualTo(mag, 0) ThenBlock: {
            StoreValue(Add(ptr, SKOff.WRITE), 0)
            StoreValue(Add(ptr, SKOff.READ), 0)
        }
        ReturnValue(ptr)
    }
}

Function.SK_ReadFile {
    Input: path: Address
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        fd = SystemCall(SKSys.SYS_OPEN, path, SKSys.O_RDONLY, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        MemorySet(buf, 0, n)
        r = SystemCall(SKSys.SYS_READ, fd, buf, n)
        SystemCall(SKSys.SYS_CLOSE, fd)
        IfCondition LessThan(r, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(r)
    }
}

Function.SK_PathSame {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 512) {
            ca = GetByte(a, i)
            cb = GetByte(b, i)
            IfCondition NotEqual(ca, cb) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(ca, 0) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.SK_PollBank {
    Body: {
        bank_path = SK_Path("bank.txt")
        n = SK_ReadFile(bank_path, SK.bbuf, 500)
        IfCondition LessThan(n, 4) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n) {
            c = GetByte(SK.bbuf, i)
            IfCondition EqualTo(c, 10) ThenBlock: { SetByte(SK.bbuf, i, 0) }
            IfCondition EqualTo(c, 13) ThenBlock: { SetByte(SK.bbuf, i, 0) }
            i = Add(i, 1)
        }
        SetByte(SK.bbuf, n, 0)
        same = SK_PathSame(SK.bbuf, SK.bpath)
        IfCondition EqualTo(same, 1) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 512) {
            SetByte(SK.bpath, i, GetByte(SK.bbuf, i))
            i = Add(i, 1)
        }
        PrintMessage("loading bank ")
        PrintString(SK.bpath)
        PrintMessage("\n")
        b = SF2_Load(SK.bpath)
        IfCondition EqualTo(b, 0) ThenBlock: {
            PrintMessage("bank load failed\n")
            ReturnValue(0)
        }
        SK.bank = b
        PrintMessage("bank ok samples=")
        PrintNumber(SF2_Count(b))
        PrintMessage(" regions=")
        PrintNumber(SF2_RegionCount(b))
        np = SF2_PresetCount(b)
        PrintMessage(" presets=")
        PrintNumber(np)
        PrintMessage("\n")
        IfCondition LessThan(np, 16) ThenBlock: {
            PrintMessage("  (few presets — load GeneralUser GS for GM MIDI songs)\n")
        }
        smp = SF2_Lookup(b, 60, 100)
        IfCondition NotEqual(smp, 0) ThenBlock: {
            Synth_SetBankSample(SK.syn, smp)
        }
    }
}

Function.SK_OpenMidi {
    Output: Address
    Body: {
        flags = Add(SKSys.O_RDWR, SKSys.O_CREAT)
        midi_path = SK_Path("midi.bin")
        fd = SystemCall(SKSys.SYS_OPEN, midi_path, flags, 438)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        total = Add(32, 4096)
        SystemCall(SKSys.SYS_FTRUNCATE, fd, total)
        ptr = SystemCall(SKSys.SYS_MMAP, 0, total, SKSys.PROT_RW, SKSys.MAP_SHARED, fd, 0)
        IfCondition LessEqual(ptr, 0) ThenBlock: {
            SystemCall(SKSys.SYS_CLOSE, fd)
            ReturnValue(0)
        }
        ReturnValue(ptr)
    }
}

Function.SK_ChanInit {
    Body: {
        IfCondition EqualTo(SK.prog, 0) ThenBlock: { SK.prog = Allocate(16) }
        IfCondition EqualTo(SK.bmsb, 0) ThenBlock: { SK.bmsb = Allocate(16) }
        IfCondition EqualTo(SK.chvol, 0) ThenBlock: { SK.chvol = Allocate(16) }
        IfCondition EqualTo(SK.pbend, 0) ThenBlock: { SK.pbend = Allocate(128) }
        IfCondition EqualTo(SK.pbrange, 0) ThenBlock: { SK.pbrange = Allocate(16) }
        IfCondition EqualTo(SK.rpn_m, 0) ThenBlock: { SK.rpn_m = Allocate(16) }
        IfCondition EqualTo(SK.rpn_l, 0) ThenBlock: { SK.rpn_l = Allocate(16) }
        IfCondition EqualTo(SK.instid, 0) ThenBlock: { SK.instid = Allocate(128) }
        IfCondition EqualTo(SK.ilock, 0) ThenBlock: { SK.ilock = Allocate(16) }
        IfCondition EqualTo(SK.mlock, 0) ThenBlock: { SK.mlock = Allocate(16) }
        IfCondition EqualTo(SK.csus, 0) ThenBlock: { SK.csus = Allocate(16) }
        IfCondition EqualTo(SK.phold, 0) ThenBlock: { SK.phold = Allocate(2048) }
        MemorySet(SK.prog, 0, 16)
        MemorySet(SK.bmsb, 0, 16)
        MemorySet(SK.pbend, 0, 128)
        MemorySet(SK.instid, 0, 128)
        MemorySet(SK.ilock, 0, 16)
        MemorySet(SK.mlock, 0, 16)
        MemorySet(SK.csus, 0, 16)
        MemorySet(SK.phold, 0, 2048)
        i = 0
        WhileLoop LessThan(i, 16) {
            SetByte(SK.chvol, i, 127)
            SetByte(SK.pbrange, i, 2)
            SetByte(SK.rpn_m, i, 127)
            SetByte(SK.rpn_l, i, 127)
            po = Multiply(i, 8)
            StoreValue(Add(SK.pbend, po), 8192)
            i = Add(i, 1)
        }
    }
}

Function.SK_BendCents {
    Input: ch: Integer
    Output: Integer
    Body: {
        chn = BitwiseAnd(ch, 15)
        pb = 8192
        IfCondition NotEqual(SK.pbend, 0) ThenBlock: {
            po = Multiply(chn, 8)
            pb = Dereference(Add(SK.pbend, po))
        }
        rg = 2
        IfCondition NotEqual(SK.pbrange, 0) ThenBlock: { rg = GetByte(SK.pbrange, chn) }
        IfCondition LessThan(rg, 1) ThenBlock: { rg = 2 }
        IfCondition GreaterThan(rg, 24) ThenBlock: { rg = 24 }
        span = Multiply(rg, 100)
        delta = Subtract(pb, 8192)
        cents = Divide(Multiply(delta, span), 8192)
        ReturnValue(cents)
    }
}

Function.SK_ApplyBend {
    Input: ch: Integer
    Input: pb: Integer
    Body: {
        chn = BitwiseAnd(ch, 15)
        IfCondition NotEqual(SK.pbend, 0) ThenBlock: {
            po = Multiply(chn, 8)
            StoreValue(Add(SK.pbend, po), pb)
        }
        cents = SK_BendCents(chn)
        n = Synth_VoiceCount(SK.syn)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Synth_VoiceCh(SK.syn, i), chn) ThenBlock: {
                Synth_SetPitchMod(SK.syn, i, cents)
            }
            i = Add(i, 1)
        }
    }
}

Function.SK_SusFlush {
    Input: ch: Integer
    Body: {
        IfCondition EqualTo(SK.phold, 0) ThenBlock: { ReturnValue(0) }
        chn = BitwiseAnd(ch, 15)
        i = 0
        WhileLoop LessThan(i, 128) {
            off = Multiply(chn, 128)
            off = Add(off, i)
            h = GetByte(SK.phold, off)
            IfCondition EqualTo(h, 1) ThenBlock: {
                Synth_NoteOff(SK.syn, i, chn)
                SetByte(SK.phold, off, 0)
            }
            i = Add(i, 1)
        }
    }
}

Function.SK_SustainOff {
    Input: ch: Integer
    Input: note: Integer
    Body: {
        chn = BitwiseAnd(ch, 15)
        n = BitwiseAnd(note, 127)
        down = 0
        IfCondition NotEqual(SK.csus, 0) ThenBlock: {
            down = GetByte(SK.csus, chn)
        }
        IfCondition EqualTo(down, 1) ThenBlock: {
            IfCondition NotEqual(SK.phold, 0) ThenBlock: {
                off = Multiply(chn, 128)
                off = Add(off, n)
                SetByte(SK.phold, off, 1)
            }
        } ElseBlock: {
            Synth_NoteOff(SK.syn, n, chn)
            IfCondition NotEqual(SK.phold, 0) ThenBlock: {
                off = Multiply(chn, 128)
                off = Add(off, n)
                SetByte(SK.phold, off, 0)
            }
        }
    }
}

Function.SK_MidiCC {
    Input: ch: Integer
    Input: d1: Integer
    Input: d2: Integer
    Body: {
        chn = BitwiseAnd(ch, 15)
        IfCondition EqualTo(d1, 1) ThenBlock: {
            SK.mod = Multiply(d2, 2)
            SK.mod_midi = 1
            Synth_ModSet(SMod.MODWHEEL, SK.mod)
        }
        IfCondition EqualTo(d1, 64) ThenBlock: {
            down = 0
            IfCondition GreaterEqual(d2, 64) ThenBlock: { down = 1 }
            was = 0
            IfCondition NotEqual(SK.csus, 0) ThenBlock: {
                was = GetByte(SK.csus, chn)
                SetByte(SK.csus, chn, down)
            }
            IfCondition EqualTo(down, 0) ThenBlock: {
                IfCondition EqualTo(was, 1) ThenBlock: { SK_SusFlush(chn) }
            }
        }
        IfCondition EqualTo(d1, 7) ThenBlock: {
            IfCondition NotEqual(SK.chvol, 0) ThenBlock: { SetByte(SK.chvol, chn, d2) }
        }
        IfCondition EqualTo(d1, 0) ThenBlock: {
            IfCondition NotEqual(SK.bmsb, 0) ThenBlock: { SetByte(SK.bmsb, chn, d2) }
        }
        IfCondition EqualTo(d1, 101) ThenBlock: {
            IfCondition NotEqual(SK.rpn_m, 0) ThenBlock: { SetByte(SK.rpn_m, chn, d2) }
        }
        IfCondition EqualTo(d1, 100) ThenBlock: {
            IfCondition NotEqual(SK.rpn_l, 0) ThenBlock: { SetByte(SK.rpn_l, chn, d2) }
        }
        IfCondition EqualTo(d1, 6) ThenBlock: {
            rm = 127
            rl = 127
            IfCondition NotEqual(SK.rpn_m, 0) ThenBlock: { rm = GetByte(SK.rpn_m, chn) }
            IfCondition NotEqual(SK.rpn_l, 0) ThenBlock: { rl = GetByte(SK.rpn_l, chn) }
            IfCondition And(EqualTo(rm, 0), EqualTo(rl, 0)) ThenBlock: {
                IfCondition NotEqual(SK.pbrange, 0) ThenBlock: { SetByte(SK.pbrange, chn, d2) }
            }
        }
    }
}

Function.SK_DbgOk {
    Output: Integer
    Body: {
        IfCondition GreaterThan(SK.dbg_n, 200) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SK.dbg_n, 200) ThenBlock: {
            PrintMessage("SF debug capped at 200 lines\n")
            SK.dbg_n = 201
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.SK_DbgPlay {
    Input: ch: Integer
    Input: pr: Integer
    Input: note: Integer
    Input: nth: Integer
    Input: smp: Address
    Body: {
        ReturnValue(0)
        IfCondition EqualTo(ch, 9) ThenBlock: { ReturnValue(0) }
        ok = SK_DbgOk()
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        root = SF2_LastRoot()
        co = SF2_LastCoarse()
        fi = SF2_LastFine()
        sc = SF2_LastScale()
        atn = SF2_LastAtten()
        fc = SF2_LastFc()
        qq = SF2_LastQ()
        PrintMessage("SF ch=")
        PrintNumber(ch)
        PrintMessage(" prog=")
        PrintNumber(pr)
        PrintMessage(" note=")
        PrintNumber(note)
        PrintMessage(" z=")
        PrintNumber(nth)
        PrintMessage(" root=")
        PrintNumber(root)
        PrintMessage(" co=")
        PrintNumber(co)
        PrintMessage(" fi=")
        PrintNumber(fi)
        PrintMessage(" sc=")
        PrintNumber(sc)
        PrintMessage(" at=")
        PrintNumber(atn)
        PrintMessage(" fc=")
        PrintNumber(fc)
        e2p = SF2_LastE2f()
        PrintMessage(" e2f=")
        PrintNumber(e2p)
        mag = 0
        nfr = 0
        srate = 0
        hroot = 0
        ls = 0
        le = 0
        md = 0
        IfCondition NotEqual(smp, 0) ThenBlock: {
            mag = Dereference(smp)
            nfr = Dereference(Add(smp, 16))
            srate = Dereference(Add(smp, 24))
            hroot = Dereference(Add(smp, 32))
            ls = Dereference(Add(smp, 40))
            le = Dereference(Add(smp, 48))
            md = Dereference(Add(smp, 56))
        }
        PrintMessage(" mag=")
        PrintNumber(mag)
        IfCondition NotEqual(mag, 1397572944) ThenBlock: { PrintMessage(" NOT_SMP") }
        PrintMessage(" n=")
        PrintNumber(nfr)
        PrintMessage(" srate=")
        PrintNumber(srate)
        PrintMessage(" hroot=")
        PrintNumber(hroot)
        PrintMessage(" lp=")
        PrintNumber(ls)
        PrintMessage("-")
        PrintNumber(le)
        PrintMessage(" mode=")
        PrintNumber(md)
        d = co
        IfCondition GreaterThan(sc, 0) ThenBlock: {
            dk = Subtract(note, root)
            dk = Divide(Multiply(dk, sc), 100)
            d = Add(dk, co)
        }
        PrintMessage(" dsemi=")
        PrintNumber(d)
        st = 0
        rt = SK.rate
        IfCondition LessThan(rt, 1) ThenBlock: { rt = 48000 }
        IfCondition NotEqual(smp, 0) ThenBlock: {
            st = Smp_StepD(smp, d, rt)
        }
        PrintMessage(" step=")
        PrintNumber(st)
        nat = 65536
        IfCondition GreaterThan(srate, 0) ThenBlock: {
            nat = Divide(Multiply(srate, 65536), rt)
        }
        IfCondition LessThan(nat, 1) ThenBlock: { nat = 1 }
        rx = Divide(Multiply(st, 100), nat)
        PrintMessage(" ratio%=")
        PrintNumber(rx)
        IfCondition GreaterThan(rx, 400) ThenBlock: { PrintMessage(" FAST") }
        IfCondition GreaterThan(rx, 1600) ThenBlock: { PrintMessage(" ULTRA") }
        PrintMessage("\n")
        SK.dbg_n = Add(SK.dbg_n, 1)
    }
}

Function.SK_InstGet {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(SK.instid, 0) ThenBlock: { ReturnValue(0) }
        pch = BitwiseAnd(ch, 15)
        ReturnValue(Dereference(Add(SK.instid, Multiply(pch, 8))))
    }
}

Function.SK_InstSet {
    Input: ch: Integer
    Input: id: Integer
    Input: lock: Integer
    Body: {
        IfCondition EqualTo(SK.instid, 0) ThenBlock: { ReturnValue(0) }
        pch = BitwiseAnd(ch, 15)
        IfCondition EqualTo(lock, 0) ThenBlock: {
            IfCondition NotEqual(SK.ilock, 0) ThenBlock: {
                IfCondition EqualTo(GetByte(SK.ilock, pch), 1) ThenBlock: { ReturnValue(0) }
            }
        }
        StoreValue(Add(SK.instid, Multiply(pch, 8)), id)
        IfCondition EqualTo(lock, 1) ThenBlock: {
            IfCondition NotEqual(SK.ilock, 0) ThenBlock: { SetByte(SK.ilock, pch, 1) }
        }
    }
}

Function.SK_PackInit {
    Body: {
        IfCondition NotEqual(SK.psmp, 0) ThenBlock: {
            IfCondition EqualTo(SK.pack_new, 0) ThenBlock: { ReturnValue(0) }
            SK.pn = 0
            SK.pack_new = 0
            IfCondition NotEqual(SK.piid, 0) ThenBlock: { MemorySet(SK.piid, 0, 512) }
            IfCondition NotEqual(SK.psmp, 0) ThenBlock: { MemorySet(SK.psmp, 0, 65536) }
            IfCondition NotEqual(SK.pslo, 0) ThenBlock: { MemorySet(SK.pslo, 0, 65536) }
            IfCondition NotEqual(SK.patk, 0) ThenBlock: { MemorySet(SK.patk, 0, 2048) }
            IfCondition NotEqual(SK.pdec, 0) ThenBlock: { MemorySet(SK.pdec, 0, 512) }
            IfCondition NotEqual(SK.prel, 0) ThenBlock: { MemorySet(SK.prel, 0, 512) }
            IfCondition NotEqual(SK.pname, 0) ThenBlock: { MemorySet(SK.pname, 0, 512) }
            ReturnValue(0)
        }
        SK.piid = Allocate(512)
        MemorySet(SK.piid, 0, 512)
        SK.psmp = Allocate(65536)
        MemorySet(SK.psmp, 0, 65536)
        SK.pslo = Allocate(65536)
        MemorySet(SK.pslo, 0, 65536)
        SK.patk = Allocate(2048)
        MemorySet(SK.patk, 0, 2048)
        SK.pdec = Allocate(512)
        MemorySet(SK.pdec, 0, 512)
        SK.prel = Allocate(512)
        MemorySet(SK.prel, 0, 512)
        SK.pname = Allocate(512)
        MemorySet(SK.pname, 0, 512)
        SK.pn = 0
    }
}

Function.SK_PackSlot {
    Input: iid: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(SK.piid, 0) ThenBlock: { ReturnValue(-1) }
        i = 0
        WhileLoop LessThan(i, SK.pn) {
            IfCondition EqualTo(Dereference(Add(SK.piid, Multiply(i, 8))), iid) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(SK.pn, 64) ThenBlock: { ReturnValue(-1) }
        StoreValue(Add(SK.piid, Multiply(SK.pn, 8)), iid)
        sl = SK.pn
        SK.pn = Add(SK.pn, 1)
        ReturnValue(sl)
    }
}

Function.SK_PackFind {
    Input: iid: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(SK.piid, 0) ThenBlock: { ReturnValue(-1) }
        i = 0
        WhileLoop LessThan(i, SK.pn) {
            IfCondition EqualTo(Dereference(Add(SK.piid, Multiply(i, 8))), iid) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

Function.SK_PackGet {
    Input: iid: Integer
    Input: note: Integer
    Input: vel: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(SK.psmp, 0) ThenBlock: { ReturnValue(0) }
        sl = SK_PackFind(iid)
        IfCondition LessThan(sl, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(note, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(note, 127) ThenBlock: { ReturnValue(0) }
        off = Add(Multiply(sl, 128), note)
        po = Multiply(off, 8)
        smp = 0
        IfCondition LessEqual(vel, 80) ThenBlock: {
            IfCondition NotEqual(SK.pslo, 0) ThenBlock: {
                smp = Dereference(Add(SK.pslo, po))
            }
        }
        IfCondition EqualTo(smp, 0) ThenBlock: {
            smp = Dereference(Add(SK.psmp, po))
        }
        ReturnValue(smp)
    }
}

Function.SK_PackPut {
    Input: sl: Integer
    Input: note: Integer
    Input: smp: Address
    Input: vel: Integer
    Body: {
        IfCondition EqualTo(SK.psmp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(sl, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(note, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(note, 127) ThenBlock: { ReturnValue(0) }
        off = Add(Multiply(sl, 128), note)
        po = Multiply(off, 8)
        IfCondition LessEqual(vel, 80) ThenBlock: {
            IfCondition NotEqual(SK.pslo, 0) ThenBlock: {
                StoreValue(Add(SK.pslo, po), smp)
            }
        } ElseBlock: {
            StoreValue(Add(SK.psmp, po), smp)
        }
        IfCondition NotEqual(smp, 0) ThenBlock: {
            StoreValue(Add(smp, 32), note)
        }
    }
}

Function.SK_AtkSlot {
    Input: note: Integer
    Input: vel: Integer
    Output: Integer
    Body: {
        n = note
        IfCondition LessThan(n, 0) ThenBlock: { n = 0 }
        IfCondition GreaterThan(n, 127) ThenBlock: { n = 127 }
        IfCondition LessEqual(vel, 80) ThenBlock: { ReturnValue(Add(n, 128)) }
        ReturnValue(n)
    }
}

Function.SK_ManFields {
    Input: mb: Address
    Input: k: Integer
    Input: j: Integer
    Body: {
        p = Add(k, 2)
        note = 0
        dig = 1
        WhileLoop EqualTo(dig, 1) {
            IfCondition GreaterEqual(p, j) ThenBlock: { dig = 0 }
            IfCondition EqualTo(dig, 1) ThenBlock: {
                dch = GetByte(mb, p)
                IfCondition LessThan(dch, 48) ThenBlock: { dig = 0 }
                IfCondition GreaterThan(dch, 57) ThenBlock: { dig = 0 }
                IfCondition EqualTo(dig, 1) ThenBlock: {
                    note = Add(Multiply(note, 10), Subtract(dch, 48))
                    p = Add(p, 1)
                }
            }
        }
        IfCondition GreaterThan(note, 127) ThenBlock: { note = 127 }
        skipsp = 1
        WhileLoop EqualTo(skipsp, 1) {
            IfCondition GreaterEqual(p, j) ThenBlock: { skipsp = 0 }
            IfCondition EqualTo(skipsp, 1) ThenBlock: {
                IfCondition NotEqual(GetByte(mb, p), 32) ThenBlock: { skipsp = 0 }
                IfCondition EqualTo(skipsp, 1) ThenBlock: { p = Add(p, 1) }
            }
        }
        vel = 127
        IfCondition LessThan(p, j) ThenBlock: {
            dch = GetByte(mb, p)
            isdig = 0
            IfCondition GreaterEqual(dch, 48) ThenBlock: {
                IfCondition LessEqual(dch, 57) ThenBlock: { isdig = 1 }
            }
            IfCondition EqualTo(isdig, 1) ThenBlock: {
                vel = 0
                dig = 1
                WhileLoop EqualTo(dig, 1) {
                    IfCondition GreaterEqual(p, j) ThenBlock: { dig = 0 }
                    IfCondition EqualTo(dig, 1) ThenBlock: {
                        dch = GetByte(mb, p)
                        IfCondition LessThan(dch, 48) ThenBlock: { dig = 0 }
                        IfCondition GreaterThan(dch, 57) ThenBlock: { dig = 0 }
                        IfCondition EqualTo(dig, 1) ThenBlock: {
                            vel = Add(Multiply(vel, 10), Subtract(dch, 48))
                            p = Add(p, 1)
                        }
                    }
                }
                skipsp = 1
                WhileLoop EqualTo(skipsp, 1) {
                    IfCondition GreaterEqual(p, j) ThenBlock: { skipsp = 0 }
                    IfCondition EqualTo(skipsp, 1) ThenBlock: {
                        IfCondition NotEqual(GetByte(mb, p), 32) ThenBlock: { skipsp = 0 }
                        IfCondition EqualTo(skipsp, 1) ThenBlock: { p = Add(p, 1) }
                    }
                }
            }
        }
        IfCondition LessThan(vel, 1) ThenBlock: { vel = 1 }
        IfCondition GreaterThan(vel, 127) ThenBlock: { vel = 127 }
        SK.mnote = note
        SK.mvel = vel
        SK.mpath = 0
        IfCondition LessThan(p, j) ThenBlock: {
            SK.mpath = Add(mb, p)
        }
    }
}

Function.SK_PackPath {
    Input: rel: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SK.proot, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(rel, 0) ThenBlock: { ReturnValue(0) }
        fpath = Allocate(600)
        MemorySet(fpath, 0, 600)
        pl = StringLength(SK.proot)
        MemoryCopy(fpath, SK.proot, pl)
        SetByte(fpath, pl, 47)
        off = Add(pl, 1)
        dst = Add(fpath, off)
        rl = StringLength(rel)
        IfCondition GreaterThan(rl, 400) ThenBlock: { rl = 400 }
        MemoryCopy(dst, rel, rl)
        ReturnValue(fpath)
    }
}

Function.SK_Eq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        stop = 0
        ok = 1
        WhileLoop EqualTo(stop, 0) {
            ca = GetByte(a, i)
            cb = GetByte(b, i)
            IfCondition NotEqual(ca, cb) ThenBlock: {
                ok = 0
                stop = 1
            }
            IfCondition EqualTo(ca, 0) ThenBlock: { stop = 1 }
            IfCondition EqualTo(stop, 0) ThenBlock: { i = Add(i, 1) }
        }
        ReturnValue(ok)
    }
}

Function.SK_PackSlotByName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(SK.pname, 0) ThenBlock: { ReturnValue(-1) }
        i = 0
        found = -1
        WhileLoop LessThan(i, SK.pn) {
            p = Dereference(Add(SK.pname, Multiply(i, 8)))
            IfCondition NotEqual(p, 0) ThenBlock: {
                eq = SK_Eq(p, name)
                IfCondition EqualTo(eq, 1) ThenBlock: { found = i }
            }
            IfCondition GreaterEqual(found, 0) ThenBlock: { i = SK.pn }
            IfCondition LessThan(found, 0) ThenBlock: { i = Add(i, 1) }
        }
        ReturnValue(found)
    }
}

Function.SK_PackJson {
    Body: {
        IfCondition EqualTo(SK.proot, 0) ThenBlock: { ReturnValue(0) }
        jpath = SK_PackPath("pack.json")
        IfCondition EqualTo(jpath, 0) ThenBlock: { ReturnValue(0) }
        jb = Allocate(8192)
        MemorySet(jb, 0, 8192)
        jn = SK_ReadFile(jpath, jb, 8190)
        IfCondition LessThan(jn, 8) ThenBlock: { ReturnValue(0) }
        i = 0
        cur = -1
        WhileLoop LessThan(i, jn) {
            c = GetByte(jb, i)
            IfCondition EqualTo(c, 34) ThenBlock: {
                i = Add(i, 1)
                tok = Add(jb, i)
                stop = 0
                WhileLoop EqualTo(stop, 0) {
                    IfCondition GreaterEqual(i, jn) ThenBlock: { stop = 1 }
                    IfCondition EqualTo(stop, 0) ThenBlock: {
                        qc = GetByte(jb, i)
                        IfCondition EqualTo(qc, 34) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(stop, 0) ThenBlock: { i = Add(i, 1) }
                    }
                }
                SetByte(jb, i, 0)
                sln = SK_PackSlotByName(tok)
                IfCondition GreaterEqual(sln, 0) ThenBlock: { cur = sln }
                IfCondition LessThan(sln, 0) ThenBlock: {
                    IfCondition GreaterEqual(cur, 0) ThenBlock: {
                        kind = 0
                        ek = SK_Eq(tok, "decay_ms")
                        IfCondition EqualTo(ek, 1) ThenBlock: { kind = 1 }
                        er = SK_Eq(tok, "release_ms")
                        IfCondition EqualTo(er, 1) ThenBlock: { kind = 2 }
                        IfCondition GreaterThan(kind, 0) ThenBlock: {
                            p = Add(i, 1)
                            dig = 0
                            WhileLoop EqualTo(dig, 0) {
                                IfCondition GreaterEqual(p, jn) ThenBlock: { dig = 1 }
                                IfCondition EqualTo(dig, 0) ThenBlock: {
                                    dch = GetByte(jb, p)
                                    IfCondition LessThan(dch, 48) ThenBlock: { p = Add(p, 1) }
                                    IfCondition GreaterThan(dch, 57) ThenBlock: { p = Add(p, 1) }
                                    IfCondition GreaterEqual(dch, 48) ThenBlock: {
                                        IfCondition LessEqual(dch, 57) ThenBlock: { dig = 1 }
                                    }
                                }
                            }
                            num = 0
                            dig = 1
                            WhileLoop EqualTo(dig, 1) {
                                IfCondition GreaterEqual(p, jn) ThenBlock: { dig = 0 }
                                IfCondition EqualTo(dig, 1) ThenBlock: {
                                    dch = GetByte(jb, p)
                                    IfCondition LessThan(dch, 48) ThenBlock: { dig = 0 }
                                    IfCondition GreaterThan(dch, 57) ThenBlock: { dig = 0 }
                                    IfCondition EqualTo(dig, 1) ThenBlock: {
                                        num = Add(Multiply(num, 10), Subtract(dch, 48))
                                        p = Add(p, 1)
                                    }
                                }
                            }
                            IfCondition EqualTo(kind, 1) ThenBlock: {
                                IfCondition NotEqual(SK.pdec, 0) ThenBlock: {
                                    StoreValue(Add(SK.pdec, Multiply(cur, 8)), num)
                                }
                            }
                            IfCondition EqualTo(kind, 2) ThenBlock: {
                                IfCondition NotEqual(SK.prel, 0) ThenBlock: {
                                    StoreValue(Add(SK.prel, Multiply(cur, 8)), num)
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        s = 0
        WhileLoop LessThan(s, SK.pn) {
            dv = 0
            rv = 0
            IfCondition NotEqual(SK.pdec, 0) ThenBlock: {
                dv = Dereference(Add(SK.pdec, Multiply(s, 8)))
            }
            IfCondition NotEqual(SK.prel, 0) ThenBlock: {
                rv = Dereference(Add(SK.prel, Multiply(s, 8)))
            }
            PrintMessage("pack env ")
            IfCondition NotEqual(SK.pname, 0) ThenBlock: {
                pn = Dereference(Add(SK.pname, Multiply(s, 8)))
                IfCondition NotEqual(pn, 0) ThenBlock: { PrintString(pn) }
            }
            PrintMessage(" decay_ms=")
            PrintNumber(dv)
            PrintMessage(" release_ms=")
            PrintNumber(rv)
            PrintMessage("\n")
            s = Add(s, 1)
        }
    }
}

Function.SK_PackLoad {
    Body: {
        SK_PackInit()
        pack_path = SK_Path("pack.txt")
        n = SK_ReadFile(pack_path, SK.cbuf, 500)
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        SetByte(SK.cbuf, n, 0)
        SK.proot = Allocate(512)
        MemorySet(SK.proot, 0, 512)
        i = 0
        stop = 0
        WhileLoop EqualTo(stop, 0) {
            IfCondition GreaterEqual(i, n) ThenBlock: { stop = 1 }
            IfCondition EqualTo(stop, 0) ThenBlock: {
                c = GetByte(SK.cbuf, i)
                IfCondition EqualTo(c, 10) ThenBlock: { stop = 1 }
                IfCondition EqualTo(c, 0) ThenBlock: { stop = 1 }
                IfCondition EqualTo(stop, 0) ThenBlock: {
                    SetByte(SK.proot, i, c)
                    i = Add(i, 1)
                }
            }
        }
        mpath = SK_PackPath("manifest.txt")
        mb = Allocate(524288)
        MemorySet(mb, 0, 524288)
        got = SK_ReadFile(mpath, mb, 524286)
        IfCondition LessThan(got, 8) ThenBlock: {
            PrintMessage("pack no manifest\n")
            ReturnValue(0)
        }
        SetByte(mb, got, 0)
        PrintMessage("pack ")
        PrintString(SK.proot)
        PrintMessage("\n")
        sl = -1
        ln0 = 0
        j = 0
        WhileLoop LessEqual(j, got) {
            eol = 0
            IfCondition EqualTo(j, got) ThenBlock: { eol = 1 }
            IfCondition LessThan(j, got) ThenBlock: {
                cj = GetByte(mb, j)
                IfCondition EqualTo(cj, 10) ThenBlock: { eol = 1 }
            }
            IfCondition EqualTo(eol, 1) ThenBlock: {
                IfCondition GreaterThan(j, ln0) ThenBlock: {
                    k = ln0
                    WhileLoop LessThan(k, j) {
                        IfCondition NotEqual(GetByte(mb, k), 32) ThenBlock: {
                            k = j
                        }
                        IfCondition LessThan(k, j) ThenBlock: {
                            IfCondition EqualTo(GetByte(mb, k), 32) ThenBlock: { k = Add(k, 1) }
                        }
                    }
                    k = ln0
                    sp = 1
                    WhileLoop EqualTo(sp, 1) {
                        IfCondition GreaterEqual(k, j) ThenBlock: { sp = 0 }
                        IfCondition EqualTo(sp, 1) ThenBlock: {
                            IfCondition NotEqual(GetByte(mb, k), 32) ThenBlock: { sp = 0 }
                            IfCondition EqualTo(sp, 1) ThenBlock: { k = Add(k, 1) }
                        }
                    }
                    IfCondition LessThan(k, j) ThenBlock: {
                        tag = GetByte(mb, k)
                        IfCondition EqualTo(tag, 73) ThenBlock: {
                            nm = Add(mb, Add(k, 2))
                            e = 0
                            capn = Subtract(j, Add(k, 2))
                            IfCondition GreaterThan(capn, 40) ThenBlock: { capn = 40 }
                            WhileLoop LessThan(e, capn) {
                                cc = GetByte(nm, e)
                                IfCondition EqualTo(cc, 10) ThenBlock: { SetByte(nm, e, 0) }
                                IfCondition EqualTo(cc, 13) ThenBlock: { SetByte(nm, e, 0) }
                                e = Add(e, 1)
                            }
                            SetByte(nm, capn, 0)
                            cur_iid = Opcode_Find(nm)
                            sl = -1
                            IfCondition NotEqual(cur_iid, 0) ThenBlock: {
                                sl = SK_PackSlot(cur_iid)
                            }
                            IfCondition GreaterEqual(sl, 0) ThenBlock: {
                                IfCondition NotEqual(SK.pname, 0) ThenBlock: {
                                    StoreValue(Add(SK.pname, Multiply(sl, 8)), nm)
                                }
                            }
                            PrintMessage("  pack inst ")
                            PrintString(nm)
                            PrintMessage(" iid=")
                            PrintNumber(cur_iid)
                            PrintMessage("\n")
                        }
                        IfCondition EqualTo(tag, 65) ThenBlock: {
                            IfCondition GreaterEqual(sl, 0) ThenBlock: {
                                SK_ManFields(mb, k, j)
                                IfCondition NotEqual(SK.mpath, 0) ThenBlock: {
                                    SetByte(mb, j, 0)
                                    fpath = SK_PackPath(SK.mpath)
                                    sm = Smp_LoadWav(fpath)
                                    ai = SK_AtkSlot(SK.mnote, SK.mvel)
                                    StoreValue(Add(SK.patk, Multiply(ai, 8)), sm)
                                }
                            }
                        }
                        IfCondition EqualTo(tag, 76) ThenBlock: {
                            IfCondition GreaterEqual(sl, 0) ThenBlock: {
                                SK_ManFields(mb, k, j)
                                IfCondition NotEqual(SK.mpath, 0) ThenBlock: {
                                    SetByte(mb, j, 0)
                                    fpath = SK_PackPath(SK.mpath)
                                    held = Smp_LoadWav(fpath)
                                    ai = SK_AtkSlot(SK.mnote, SK.mvel)
                                    atk = Dereference(Add(SK.patk, Multiply(ai, 8)))
                                    joined = Smp_JoinHeld(atk, held)
                                    SK_PackPut(sl, SK.mnote, joined, SK.mvel)
                                }
                            }
                        }
                        IfCondition EqualTo(tag, 84) ThenBlock: {
                            IfCondition GreaterEqual(sl, 0) ThenBlock: {
                                p = Add(k, 2)
                                a = 0
                                dig = 1
                                WhileLoop EqualTo(dig, 1) {
                                    IfCondition GreaterEqual(p, j) ThenBlock: { dig = 0 }
                                    IfCondition EqualTo(dig, 1) ThenBlock: {
                                        dch = GetByte(mb, p)
                                        IfCondition LessThan(dch, 48) ThenBlock: { dig = 0 }
                                        IfCondition GreaterThan(dch, 57) ThenBlock: { dig = 0 }
                                        IfCondition EqualTo(dig, 1) ThenBlock: {
                                            a = Add(Multiply(a, 10), Subtract(dch, 48))
                                            p = Add(p, 1)
                                        }
                                    }
                                }
                                sp = 1
                                WhileLoop EqualTo(sp, 1) {
                                    IfCondition GreaterEqual(p, j) ThenBlock: { sp = 0 }
                                    IfCondition EqualTo(sp, 1) ThenBlock: {
                                        IfCondition NotEqual(GetByte(mb, p), 32) ThenBlock: { sp = 0 }
                                        IfCondition EqualTo(sp, 1) ThenBlock: { p = Add(p, 1) }
                                    }
                                }
                                b = 0
                                dig = 1
                                WhileLoop EqualTo(dig, 1) {
                                    IfCondition GreaterEqual(p, j) ThenBlock: { dig = 0 }
                                    IfCondition EqualTo(dig, 1) ThenBlock: {
                                        dch = GetByte(mb, p)
                                        IfCondition LessThan(dch, 48) ThenBlock: { dig = 0 }
                                        IfCondition GreaterThan(dch, 57) ThenBlock: { dig = 0 }
                                        IfCondition EqualTo(dig, 1) ThenBlock: {
                                            b = Add(Multiply(b, 10), Subtract(dch, 48))
                                            p = Add(p, 1)
                                        }
                                    }
                                }
                                IfCondition NotEqual(SK.pdec, 0) ThenBlock: {
                                    StoreValue(Add(SK.pdec, Multiply(sl, 8)), a)
                                }
                                IfCondition NotEqual(SK.prel, 0) ThenBlock: {
                                    StoreValue(Add(SK.prel, Multiply(sl, 8)), b)
                                }
                                PrintMessage("pack env decay_ms=")
                                PrintNumber(a)
                                PrintMessage(" release_ms=")
                                PrintNumber(b)
                                PrintMessage("\n")
                            }
                        }
                        IfCondition EqualTo(tag, 72) ThenBlock: {
                            IfCondition GreaterEqual(sl, 0) ThenBlock: {
                                SK_ManFields(mb, k, j)
                                IfCondition NotEqual(SK.mpath, 0) ThenBlock: {
                                    SetByte(mb, j, 0)
                                    fpath = SK_PackPath(SK.mpath)
                                    hit = Smp_LoadWav(fpath)
                                    SK_PackPut(sl, SK.mnote, hit, SK.mvel)
                                }
                            }
                        }
                    }
                }
                ln0 = Add(j, 1)
            }
            j = Add(j, 1)
        }
        SK_PackJson()
        PrintMessage("pack instruments=")
        PrintNumber(SK.pn)
        PrintMessage("\n")
    }
}

Function.SK_StartInst {
    Input: iid: Integer
    Input: note: Integer
    Input: vel: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        packed = SK_PackGet(iid, note, vel)
        IfCondition NotEqual(packed, 0) ThenBlock: {
            vl = vel
            IfCondition LessThan(vl, 1) ThenBlock: { vl = 1 }
            IfCondition GreaterThan(vl, 127) ThenBlock: { vl = 127 }
            vi = Synth_AllocVoice(SK.syn, note, ch)
            dms = 0
            rms = 5
            sl = SK_PackFind(iid)
            IfCondition GreaterEqual(sl, 0) ThenBlock: {
                IfCondition NotEqual(SK.pdec, 0) ThenBlock: {
                    dv = Dereference(Add(SK.pdec, Multiply(sl, 8)))
                    IfCondition GreaterThan(dv, 0) ThenBlock: { dms = dv }
                }
                IfCondition NotEqual(SK.prel, 0) ThenBlock: {
                    rv = Dereference(Add(SK.prel, Multiply(sl, 8)))
                    IfCondition GreaterThan(rv, 0) ThenBlock: { rms = rv }
                }
            }
            SynthG.pack_dec = dms
            SynthG.pack_rel = rms
            Synth_VoiceOnPack(SK.syn, vi, packed, note, vl)
            ReturnValue(1)
        }
        IfCondition GreaterThan(SK.pn, 0) ThenBlock: {
            PrintMessage("NOTE_MISS inst=")
            PrintNumber(iid)
            PrintMessage(" note=")
            PrintNumber(note)
            PrintMessage("\n")
            ReturnValue(0)
        }
        nstart = 0
        nth = 0
        have_uni = 0
        WhileLoop LessThan(nth, 16) {
            SF2_SetNth(nth)
            smp = SF2_LookupI(SK.bank, note, vel, iid)
            IfCondition EqualTo(smp, 0) ThenBlock: {
                nth = 16
            } ElseBlock: {
                co = SF2_LastCoarse()
                aco = co
                IfCondition LessThan(aco, 0) ThenBlock: { aco = Subtract(0, aco) }
                skip = 0
                IfCondition EqualTo(have_uni, 1) ThenBlock: {
                    IfCondition GreaterEqual(aco, 3) ThenBlock: { skip = 1 }
                }
                IfCondition EqualTo(skip, 1) ThenBlock: {
                    nth = Add(nth, 1)
                } ElseBlock: {
                    at = SF2_LastAtten()
                    g = 256
                    WhileLoop GreaterEqual(at, 60) {
                        g = Divide(g, 2)
                        at = Subtract(at, 60)
                    }
                    IfCondition EqualTo(g, 0) ThenBlock: {
                        nth = Add(nth, 1)
                    } ElseBlock: {
                        vl = vel
                        IfCondition NotEqual(SK.chvol, 0) ThenBlock: {
                            cv = GetByte(SK.chvol, BitwiseAnd(ch, 15))
                            IfCondition GreaterThan(cv, 0) ThenBlock: {
                                vl = Divide(Multiply(vel, cv), 127)
                            }
                        }
                        vl = Divide(Multiply(vl, g), 256)
                        IfCondition LessThan(vl, 1) ThenBlock: { vl = 1 }
                        IfCondition GreaterThan(vl, 127) ThenBlock: { vl = 127 }
                        vi = Synth_AllocVoice(SK.syn, note, ch)
                        Synth_VoiceOnSample(SK.syn, vi, smp, note, vl)
                        fc = SF2_LastFc()
                        e2 = SF2_LastE2f()
                        playfc = Add(fc, e2)
                        IfCondition LessThan(playfc, 0) ThenBlock: { playfc = 0 }
                        IfCondition GreaterThan(playfc, 13500) ThenBlock: { playfc = 13500 }
                        qq = SF2_LastQ()
                        IfCondition LessThan(qq, 0) ThenBlock: { qq = 0 }
                        IfCondition GreaterThan(qq, 240) ThenBlock: { qq = 240 }
                        Synth_SetFilterCents(SK.syn, vi, playfc, qq)
                        bc = SK_BendCents(ch)
                        IfCondition NotEqual(bc, 0) ThenBlock: {
                            Synth_SetPitchMod(SK.syn, vi, bc)
                        }
                        IfCondition LessThan(aco, 3) ThenBlock: { have_uni = 1 }
                        nstart = Add(nstart, 1)
                        nth = Add(nth, 1)
                    }
                }
            }
        }
        ReturnValue(nstart)
    }
}

Function.SK_StartZones {
    Input: pr: Integer
    Input: sfb: Integer
    Input: note: Integer
    Input: vel: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        iid = Opcode_FromSF2(sfb, pr)
        IfCondition NotEqual(iid, 0) ThenBlock: {
            n0 = SK_StartInst(iid, note, vel, ch)
            IfCondition GreaterThan(n0, 0) ThenBlock: { ReturnValue(n0) }
        }
        nstart = 0
        nth = 0
        WhileLoop LessThan(nth, 16) {
            SF2_SetNth(nth)
            smp = SF2_LookupP(SK.bank, note, vel, pr, sfb)
            IfCondition EqualTo(smp, 0) ThenBlock: {
                nth = 16
            } ElseBlock: {
                at = SF2_LastAtten()
                g = 256
                WhileLoop GreaterEqual(at, 60) {
                    g = Divide(g, 2)
                    at = Subtract(at, 60)
                }
                IfCondition EqualTo(g, 0) ThenBlock: {
                    okd = SK_DbgOk()
                    IfCondition EqualTo(okd, 1) ThenBlock: {
                        PrintMessage("SF DROP_ATTEN ch=")
                        PrintNumber(ch)
                        PrintMessage(" prog=")
                        PrintNumber(pr)
                        PrintMessage(" note=")
                        PrintNumber(note)
                        PrintMessage(" z=")
                        PrintNumber(nth)
                        PrintMessage(" at=")
                        atx = SF2_LastAtten()
                        PrintNumber(atx)
                        PrintMessage("\n")
                        SK.dbg_n = Add(SK.dbg_n, 1)
                    }
                    nth = Add(nth, 1)
                } ElseBlock: {
                    vl = Divide(Multiply(vel, g), 256)
                    IfCondition LessThan(vl, 1) ThenBlock: { vl = 1 }
                    vi = Synth_AllocVoice(SK.syn, note, ch)
                    Synth_VoiceOnSample(SK.syn, vi, smp, note, vl)
                    fc = SF2_LastFc()
                    e2 = SF2_LastE2f()
                    playfc = Add(fc, e2)
                    IfCondition LessThan(playfc, 0) ThenBlock: { playfc = 0 }
                    IfCondition GreaterThan(playfc, 13500) ThenBlock: { playfc = 13500 }
                    qq = SF2_LastQ()
                    IfCondition LessThan(qq, 0) ThenBlock: { qq = 0 }
                    IfCondition GreaterThan(qq, 240) ThenBlock: { qq = 240 }
                    Synth_SetFilterCents(SK.syn, vi, playfc, qq)
                    SK_DbgPlay(ch, pr, note, nth, smp)
                    bc = SK_BendCents(ch)
                    IfCondition NotEqual(bc, 0) ThenBlock: {
                        Synth_SetPitchMod(SK.syn, vi, bc)
                    }
                    nstart = Add(nstart, 1)
                    nth = Add(nth, 1)
                }
            }
        }
        ReturnValue(nstart)
    }
}

Function.SK_NoteOn {
    Input: note: Integer
    Input: vel: Integer
    Input: ch: Integer
    Body: {
        chn = BitwiseAnd(ch, 15)
        n = BitwiseAnd(note, 127)
        IfCondition NotEqual(SK.phold, 0) ThenBlock: {
            off = Multiply(chn, 128)
            off = Add(off, n)
            SetByte(SK.phold, off, 0)
        }
        used = 0
        vv = vel
        IfCondition NotEqual(SK.chvol, 0) ThenBlock: {
            cv = GetByte(SK.chvol, BitwiseAnd(ch, 15))
            IfCondition GreaterThan(cv, 0) ThenBlock: {
                vv = Divide(Multiply(vel, cv), 127)
            }
        }
        use_sf = 0
        IfCondition EqualTo(SK.as_sample, 1) ThenBlock: {
            IfCondition GreaterThan(SK.pn, 0) ThenBlock: { use_sf = 1 }
            IfCondition NotEqual(SK.bank, 0) ThenBlock: {
                IfCondition EqualTo(SK.wave, 8) ThenBlock: { use_sf = 1 }
                IfCondition EqualTo(SK.splay, 1) ThenBlock: { use_sf = 1 }
            }
        }
        IfCondition EqualTo(use_sf, 1) ThenBlock: {
            iid = SK_InstGet(ch)
            IfCondition EqualTo(iid, 0) ThenBlock: {
                locked = 0
                pch = BitwiseAnd(ch, 15)
                IfCondition NotEqual(SK.mlock, 0) ThenBlock: {
                    locked = GetByte(SK.mlock, pch)
                }
                IfCondition EqualTo(locked, 0) ThenBlock: {
                    IfCondition GreaterThan(SK.jam, 0) ThenBlock: {
                        iid = SK.jam
                        SK_InstSet(ch, iid, 0)
                    }
                }
            }
            IfCondition EqualTo(iid, 0) ThenBlock: {
                pch = BitwiseAnd(ch, 15)
                IfCondition EqualTo(SK.mlock, 0) ThenBlock: {
                    PrintMessage("BIND_MISS track=")
                    PrintNumber(ch)
                    PrintMessage("\n")
                } ElseBlock: {
                    IfCondition EqualTo(GetByte(SK.mlock, pch), 0) ThenBlock: {
                        SetByte(SK.mlock, pch, 1)
                        PrintMessage("BIND_MISS track=")
                        PrintNumber(ch)
                        IfCondition EqualTo(pch, 9) ThenBlock: {
                            PrintMessage(" NO_KIT_NAME")
                        }
                        PrintMessage(" (no InstID)\n")
                    }
                }
            } ElseBlock: {
                nst = SK_StartInst(iid, note, vel, ch)
                IfCondition GreaterThan(nst, 0) ThenBlock: { used = 1 }
                IfCondition EqualTo(nst, 0) ThenBlock: {
                    pch = BitwiseAnd(ch, 15)
                    IfCondition NotEqual(SK.mlock, 0) ThenBlock: {
                        IfCondition EqualTo(GetByte(SK.mlock, pch), 0) ThenBlock: {
                            SetByte(SK.mlock, pch, 2)
                            PrintMessage("BIND_EMPTY track=")
                            PrintNumber(ch)
                            PrintMessage(" inst=")
                            PrintNumber(iid)
                            PrintMessage("\n")
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(used, 0) ThenBlock: {
            IfCondition EqualTo(SK.splay, 1) ThenBlock: { ReturnValue(0) }
            SK_SynthOn(n, vv, SKConst.SYNTHCH)
        }
    }
}

Function.SK_SynthWave {
    Output: Integer
    Body: {
        wv = SK.wave
        IfCondition LessThan(wv, 0) ThenBlock: { wv = 0 }
        IfCondition GreaterThan(wv, 7) ThenBlock: { wv = 3 }
        ReturnValue(wv)
    }
}

Function.SK_SynthShape {
    Input: index: Integer
    Input: arm: Integer
    Body: {
        m1 = SK_ModAmt(1)
        cut = SK_Clamp(Add(SK.cutoff, m1), 0, 256)
        m2 = SK_ModAmt(2)
        rs = SK_Clamp(Add(SK.res, m2), 0, 240)
        pit = SK_ModAmt(3)
        m4 = SK_ModAmt(4)
        lfd = SK_Clamp(Add(SK.lfopwm, m4), 0, 256)
        m5 = SK_ModAmt(5)
        pww = SK_Clamp(Add(SK.pw, m5), 8, 248)
        m6 = SK_ModAmt(6)
        drv = SK_Clamp(Add(SK.drive, m6), 0, 256)
        m9 = SK_ModAmt(9)
        fev = SK_Clamp(Add(SK.fenv, m9), 0, 256)
        m10 = SK_ModAmt(10)
        sub = SK_Clamp(Add(SK.submix, m10), 0, 256)
        wv = SK_SynthWave()
        w2 = SK.wave2
        IfCondition LessThan(w2, 0) ThenBlock: { w2 = 0 }
        IfCondition GreaterThan(w2, 7) ThenBlock: { w2 = 3 }
        Synth_SetADSR(SK.syn, index, SK.atk, SK.dec, SK.suslvl, SK.rel)
        IfCondition EqualTo(SK.cutmode, 1) ThenBlock: {
            rate = SK.rate
            IfCondition LessThan(rate, 8000) ThenBlock: { rate = 48000 }
            base = Synth_SemiCoeff(SK.cutsemi, rate)
            Synth_SetCutoffCoeff(SK.syn, index, base, rs)
            IfCondition EqualTo(SK.usefeg, 1) ThenBlock: {
                open = Synth_SemiCoeff(Add(SK.cutsemi, SK.envmod), rate)
                amt = Subtract(open, base)
                Synth_SetFEG(SK.syn, index, SK.fatk, SK.fdec, SK.fsus, SK.frel)
                Synth_SetFegAmt(SK.syn, index, amt)
                Synth_SetFenv(SK.syn, index, 0)
                IfCondition EqualTo(arm, 1) ThenBlock: { Synth_FegArm(SK.syn, index) }
            } ElseBlock: {
                Synth_SetFegAmt(SK.syn, index, 0)
                Synth_SetFenv(SK.syn, index, fev)
            }
        } ElseBlock: {
            Synth_SetFilter(SK.syn, index, cut, rs)
            Synth_SetFegAmt(SK.syn, index, 0)
            Synth_SetFenv(SK.syn, index, fev)
        }
        Synth_SetWave(SK.syn, index, wv)
        Synth_SetOsc2(SK.syn, index, w2, SK.oscmix, SK.o2oct)
        Synth_SetPulse(SK.syn, index, pww)
        Synth_SetDetune(SK.syn, index, SK.detune)
        Synth_SetPitchMod(SK.syn, index, pit)
        Synth_SetLFO(SK.syn, index, SK.lforate, lfd)
        Synth_SetLFOTaps(SK.syn, index, SK.lfofilt, SK.lfoamp)
        Synth_SetSub(SK.syn, index, sub)
        Synth_SetDrive(SK.syn, index, drv)
    }
}

Function.SK_SynthOn {
    Input: note: Integer
    Input: vel: Integer
    Input: ch: Integer
    Body: {
        chn = BitwiseAnd(ch, 15)
        n = BitwiseAnd(note, 127)
        IfCondition NotEqual(SK.phold, 0) ThenBlock: {
            off = Multiply(chn, 128)
            off = Add(off, n)
            SetByte(SK.phold, off, 0)
        }
        vv = vel
        IfCondition LessThan(vv, 1) ThenBlock: { vv = 1 }
        IfCondition GreaterThan(vv, 127) ThenBlock: { vv = 127 }
        wv = SK_SynthWave()
        vi = Synth_AllocVoice(SK.syn, n, chn)
        Synth_SetADSR(SK.syn, vi, SK.atk, SK.dec, SK.suslvl, SK.rel)
        Synth_VoiceOnNote(SK.syn, vi, wv, n, vv)
        SK_SynthShape(vi, 1)
    }
}

Function.SK_OnPC {
    Input: ch: Integer
    Input: prog: Integer
    Body: {
        IfCondition NotEqual(SK.prog, 0) ThenBlock: {
            SetByte(SK.prog, BitwiseAnd(ch, 15), BitwiseAnd(prog, 127))
        }
        pch = BitwiseAnd(ch, 15)
        IfCondition EqualTo(pch, 9) ThenBlock: { ReturnValue(0) }
        iid = Opcode_FromGM(prog)
        IfCondition NotEqual(iid, 0) ThenBlock: {
            SK_InstSet(ch, iid, 0)
        }
    }
}

Function.SK_MapLine {
    Input: buf: Address
    Input: a: Integer
    Input: b: Integer
    Body: {
        i = a
        WhileLoop LessThan(i, b) {
            c = GetByte(buf, i)
            sp = 0
            IfCondition EqualTo(c, 32) ThenBlock: { sp = 1 }
            IfCondition EqualTo(c, 9) ThenBlock: { sp = 1 }
            IfCondition EqualTo(sp, 0) ThenBlock: { BreakLoop }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(i, b) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, i)
        IfCondition EqualTo(c0, 35) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(c0, 116) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Add(i, 5), b) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 1)), 114) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 2)), 97) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 3)), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 4)), 107) ThenBlock: { ReturnValue(0) }
        i = Add(i, 5)
        WhileLoop LessThan(i, b) {
            c = GetByte(buf, i)
            IfCondition And(NotEqual(c, 32), NotEqual(c, 9)) ThenBlock: { BreakLoop }
            i = Add(i, 1)
        }
        chn = 0
        gotn = 0
        WhileLoop LessThan(i, b) {
            c = GetByte(buf, i)
            IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                chn = Add(Multiply(chn, 10), Subtract(c, 48))
                gotn = 1
                i = Add(i, 1)
            } ElseBlock: {
                BreakLoop
            }
        }
        IfCondition EqualTo(gotn, 0) ThenBlock: { ReturnValue(0) }
        tid = chn
        bind = chn
        j = i
        WhileLoop LessThan(j, Subtract(b, 4)) {
            IfCondition EqualTo(GetByte(buf, j), 115) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, Add(j, 1)), 114) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, Add(j, 2)), 99) ThenBlock: {
                        IfCondition EqualTo(GetByte(buf, Add(j, 3)), 61) ThenBlock: {
                            k = Add(j, 4)
                            WhileLoop LessThan(k, b) {
                                ck = GetByte(buf, k)
                                IfCondition EqualTo(ck, 58) ThenBlock: {
                                    k = Add(k, 1)
                                    mch = 0
                                    gotc = 0
                                    WhileLoop LessThan(k, b) {
                                        dk = GetByte(buf, k)
                                        IfCondition And(GreaterEqual(dk, 48), LessEqual(dk, 57)) ThenBlock: {
                                            mch = Add(Multiply(mch, 10), Subtract(dk, 48))
                                            gotc = 1
                                            k = Add(k, 1)
                                        } ElseBlock: {
                                            BreakLoop
                                        }
                                    }
                                    IfCondition EqualTo(gotc, 1) ThenBlock: {
                                        IfCondition GreaterThan(mch, 0) ThenBlock: {
                                            bind = Subtract(mch, 1)
                                        }
                                    }
                                    k = b
                                }
                                k = Add(k, 1)
                            }
                        }
                    }
                }
            }
            j = Add(j, 1)
        }
        nm = 0
        WhileLoop LessThan(i, Subtract(b, 5)) {
            IfCondition EqualTo(GetByte(buf, i), 105) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, Add(i, 1)), 110) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, Add(i, 2)), 115) ThenBlock: {
                        IfCondition EqualTo(GetByte(buf, Add(i, 3)), 116) ThenBlock: {
                            IfCondition EqualTo(GetByte(buf, Add(i, 4)), 61) ThenBlock: {
                                nm = Add(buf, Add(i, 5))
                                i = b
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(nm, 0) ThenBlock: { ReturnValue(0) }
        e = 0
        WhileLoop LessThan(e, 63) {
            cc = GetByte(nm, e)
            IfCondition EqualTo(cc, 0) ThenBlock: { e = 63 }
            IfCondition EqualTo(cc, 10) ThenBlock: {
                SetByte(nm, e, 0)
                e = 63
            }
            IfCondition EqualTo(cc, 13) ThenBlock: {
                SetByte(nm, e, 0)
                e = 63
            }
            IfCondition EqualTo(cc, 32) ThenBlock: {
                SetByte(nm, e, 0)
                e = 63
            }
            e = Add(e, 1)
        }
        iid = Opcode_Find(nm)
        IfCondition EqualTo(iid, 0) ThenBlock: {
            PrintMessage("songmap unknown ")
            PrintString(nm)
            PrintMessage("\n")
            ReturnValue(0)
        }
        SK_InstSet(bind, iid, 1)
        PrintMessage("songmap track=")
        PrintNumber(tid)
        PrintMessage(" ch=")
        PrintNumber(bind)
        PrintMessage(" inst=")
        PrintNumber(iid)
        PrintMessage(" ")
        PrintString(nm)
        PrintMessage("\n")
    }
}

Function.SK_LoadMap {
    Body: {
        IfCondition EqualTo(SK.spath, 0) ThenBlock: { ReturnValue(0) }
        mpath = Allocate(600)
        MemorySet(mpath, 0, 600)
        i = 0
        WhileLoop LessThan(i, 500) {
            c = GetByte(SK.spath, i)
            IfCondition EqualTo(c, 0) ThenBlock: { i = 500 }
            IfCondition NotEqual(c, 0) ThenBlock: { SetByte(mpath, i, c) }
            i = Add(i, 1)
        }
        n = StringLength(mpath)
        SetByte(mpath, n, 46)
        SetByte(mpath, Add(n, 1), 115)
        SetByte(mpath, Add(n, 2), 111)
        SetByte(mpath, Add(n, 3), 110)
        SetByte(mpath, Add(n, 4), 103)
        SetByte(mpath, Add(n, 5), 109)
        SetByte(mpath, Add(n, 6), 97)
        SetByte(mpath, Add(n, 7), 112)
        SetByte(mpath, Add(n, 8), 0)
        mb = Allocate(4096)
        got = SK_ReadFile(mpath, mb, 4095)
        IfCondition LessThan(got, 4) ThenBlock: {
            Deallocate(mb, 4096)
            Deallocate(mpath, 600)
            ReturnValue(0)
        }
        SetByte(mb, got, 0)
        PrintMessage("songmap ")
        PrintString(mpath)
        PrintMessage("\n")
        ln0 = 0
        j = 0
        WhileLoop LessEqual(j, got) {
            cj = GetByte(mb, j)
            IfCondition Or(EqualTo(cj, 10), EqualTo(j, got)) ThenBlock: {
                IfCondition GreaterThan(j, ln0) ThenBlock: {
                    SK_MapLine(mb, ln0, j)
                }
                ln0 = Add(j, 1)
            }
            j = Add(j, 1)
        }
        Deallocate(mb, 4096)
        Deallocate(mpath, 600)
    }
}

Function.SK_ApplyMidi {
    Body: {
        kind = MIDI_StreamLastKind()
        IfCondition NotEqual(kind, 1) ThenBlock: { ReturnValue(0) }
        st = MIDI_StreamLastStatus()
        hi = BitwiseAnd(st, 240)
        ch = BitwiseAnd(st, 15)
        d1 = MIDI_StreamLastD1()
        d2 = MIDI_StreamLastD2()
        IfCondition EqualTo(hi, 144) ThenBlock: {
            IfCondition GreaterThan(SK.pn, 0) ThenBlock: {
                SK.as_sample = 1
                IfCondition EqualTo(d2, 0) ThenBlock: {
                    SK_SustainOff(ch, d1)
                } ElseBlock: {
                    SK_NoteOn(d1, d2, ch)
                }
                SK.as_sample = 0
            } ElseBlock: {
                IfCondition EqualTo(d2, 0) ThenBlock: {
                    SK_SustainOff(SKConst.SYNTHCH, d1)
                } ElseBlock: {
                    SK_SynthOn(d1, d2, SKConst.SYNTHCH)
                }
            }
        }
        IfCondition EqualTo(hi, 128) ThenBlock: {
            IfCondition GreaterThan(SK.pn, 0) ThenBlock: {
                SK.as_sample = 1
                SK_SustainOff(ch, d1)
                SK.as_sample = 0
            } ElseBlock: {
                SK_SustainOff(SKConst.SYNTHCH, d1)
            }
        }
        IfCondition EqualTo(hi, 176) ThenBlock: {
            IfCondition EqualTo(d1, 64) ThenBlock: {
                IfCondition GreaterThan(SK.pn, 0) ThenBlock: {
                    SK_MidiCC(ch, d1, d2)
                } ElseBlock: {
                    SK_MidiCC(SKConst.SYNTHCH, d1, d2)
                }
            } ElseBlock: {
                SK_MidiCC(ch, d1, d2)
            }
        }
        IfCondition EqualTo(hi, 192) ThenBlock: { SK_OnPC(ch, d1) }
        IfCondition EqualTo(hi, 224) ThenBlock: {
            pb = Add(d1, Multiply(d2, 128))
            IfCondition GreaterThan(SK.pn, 0) ThenBlock: {
                SK_ApplyBend(ch, pb)
            } ElseBlock: {
                SK_ApplyBend(SKConst.SYNTHCH, pb)
            }
        }
    }
}

Function.SK_PollMidi {
    Body: {
        IfCondition EqualTo(SK.midi, 0) ThenBlock: { ReturnValue(0) }
        w = Dereference(SK.midi)
        r = Dereference(Add(SK.midi, 8))
        cap = Dereference(Add(SK.midi, 16))
        IfCondition EqualTo(cap, 0) ThenBlock: { cap = 4096 }
        data = Add(SK.midi, 32)
        WhileLoop LessThan(r, w) {
            b = GetByte(data, Modulo(r, cap))
            done = MIDI_StreamFeed(b)
            IfCondition EqualTo(done, 1) ThenBlock: { SK_ApplyMidi() }
            r = Add(r, 1)
        }
        StoreValue(Add(SK.midi, 8), r)
    }
}

Function.SK_PcmRate {
    Output: Integer
    Body: {
        IfCondition EqualTo(SK.pcm, 0) ThenBlock: { ReturnValue(48000) }
        r = Dereference(Add(SK.pcm, SKOff.RATE))
        IfCondition LessThan(r, 8000) ThenBlock: { ReturnValue(SK.rate) }
        IfCondition GreaterThan(r, 192000) ThenBlock: { ReturnValue(SK.rate) }
        ReturnValue(r)
    }
}

Function.SK_PcmSpace {
    Output: Integer
    Body: {
        IfCondition EqualTo(SK.pcm, 0) ThenBlock: { ReturnValue(0) }
        cap = Dereference(Add(SK.pcm, SKOff.CAP))
        IfCondition EqualTo(cap, 0) ThenBlock: { cap = SKConst.CAP }
        w = Dereference(Add(SK.pcm, SKOff.WRITE))
        r = Dereference(Add(SK.pcm, SKOff.READ))
        used = Subtract(w, r)
        IfCondition LessThan(used, 0) ThenBlock: { used = 0 }
        IfCondition GreaterThan(used, cap) ThenBlock: { used = cap }
        ReturnValue(Subtract(cap, used))
    }
}

Function.SK_TickFrames {
    Input: tick: Integer
    Output: Integer
    Body: {
        us = MIDI_TickToUS(SK.song, tick)
        rt = SK.rate
        IfCondition LessThan(rt, 8000) ThenBlock: { rt = 48000 }
        ReturnValue(Divide(Multiply(us, rt), 1000000))
    }
}

Function.SK_AllOff {
    Body: {
        ch = 0
        WhileLoop LessThan(ch, SKConst.SYNTHCH) {
            IfCondition NotEqual(SK.csus, 0) ThenBlock: {
                SetByte(SK.csus, ch, 0)
            }
            SK_SusFlush(ch)
            ch = Add(ch, 1)
        }
        Synth_ReleaseAll(SK.syn)
        IfCondition NotEqual(SK.phold, 0) ThenBlock: {
            MemorySet(SK.phold, 0, 1920)
        }
    }
}

Function.SK_SongApply {
    Input: ev: Address
    Body: {
        kind = MIDI_EvKind(ev)
        IfCondition NotEqual(kind, 1) ThenBlock: { ReturnValue(0) }
        st = MIDI_EvStatus(ev)
        hi = BitwiseAnd(st, 240)
        d1 = MIDI_EvD1(ev)
        d2 = MIDI_EvD2(ev)
        ch = MIDI_EvCh(ev)
        IfCondition EqualTo(hi, 144) ThenBlock: {
            IfCondition GreaterThan(SK.pn, 0) ThenBlock: {
                SK.as_sample = 1
                IfCondition EqualTo(d2, 0) ThenBlock: {
                    SK_SustainOff(ch, d1)
                } ElseBlock: {
                    SK_NoteOn(d1, d2, ch)
                }
                SK.as_sample = 0
            } ElseBlock: {
                IfCondition EqualTo(ch, 9) ThenBlock: {
                    IfCondition EqualTo(SK.nodrum, 0) ThenBlock: {
                        PrintMessage("synth song skips channel 10 drums\n")
                        SK.nodrum = 1
                    }
                } ElseBlock: {
                    IfCondition EqualTo(d2, 0) ThenBlock: {
                        SK_SustainOff(ch, d1)
                    } ElseBlock: {
                        SK_SynthOn(d1, d2, ch)
                    }
                }
            }
        }
        IfCondition EqualTo(hi, 128) ThenBlock: {
            IfCondition GreaterThan(SK.pn, 0) ThenBlock: {
                SK.as_sample = 1
                SK_SustainOff(ch, d1)
                SK.as_sample = 0
            } ElseBlock: {
                IfCondition NotEqual(ch, 9) ThenBlock: {
                    SK_SustainOff(ch, d1)
                }
            }
        }
        IfCondition EqualTo(hi, 176) ThenBlock: { SK_MidiCC(ch, d1, d2) }
        IfCondition EqualTo(hi, 192) ThenBlock: { SK_OnPC(ch, d1) }
        IfCondition EqualTo(hi, 224) ThenBlock: {
            pb = Add(d1, Multiply(d2, 128))
            SK_ApplyBend(ch, pb)
        }
    }
}

Function.SK_SongStop {
    Body: {
        SK.splay = 0
        SK_AllOff()
        PrintMessage("song stop\n")
    }
}

Function.SK_SongCueFirst {
    Body: {
        IfCondition EqualTo(SK.song, 0) ThenBlock: { ReturnValue(0) }
        cnt = MIDI_SongCount(SK.song)
        div = SK.sdiv
        IfCondition EqualTo(div, 0) ThenBlock: { div = 480 }
        tempo = SK.st_tempo
        IfCondition EqualTo(tempo, 0) ThenBlock: { tempo = 500000 }
        i = 0
        tick0 = 0
        us = 0
        found = 0
        WhileLoop LessThan(i, cnt) {
            IfCondition EqualTo(found, 1) ThenBlock: { i = cnt }
            IfCondition EqualTo(found, 0) ThenBlock: {
                ev = MIDI_SongEvent(SK.song, i)
                IfCondition EqualTo(ev, 0) ThenBlock: {
                    found = 1
                } ElseBlock: {
                    tk = MIDI_EvTick(ev)
                    dt = Subtract(tk, tick0)
                    IfCondition LessThan(dt, 0) ThenBlock: { dt = 0 }
                    add_us = Divide(Multiply(dt, tempo), div)
                    us = Add(us, add_us)
                    tick0 = tk
                    kind = MIDI_EvKind(ev)
                    st = MIDI_EvStatus(ev)
                    IfCondition EqualTo(kind, 2) ThenBlock: {
                        IfCondition EqualTo(st, 81) ThenBlock: {
                            nt = MIDI_EvLen(ev)
                            IfCondition GreaterThan(nt, 0) ThenBlock: { tempo = nt }
                        }
                    }
                    IfCondition EqualTo(kind, 1) ThenBlock: {
                        hi = BitwiseAnd(st, 240)
                        d2 = MIDI_EvD2(ev)
                        IfCondition EqualTo(hi, 144) ThenBlock: {
                            IfCondition GreaterThan(d2, 0) ThenBlock: {
                                found = 1
                                SK.sev = i
                                SK.st_tick = tk
                                SK.st_us = us
                                SK.st_tempo = tempo
                                rt = SK.rate
                                IfCondition LessThan(rt, 8000) ThenBlock: { rt = 48000 }
                                SK.sframe = Divide(Multiply(us, rt), 1000000)
                            }
                        }
                    }
                    IfCondition EqualTo(found, 0) ThenBlock: { i = Add(i, 1) }
                }
            }
        }
    }
}

Function.SK_SongPlay {
    Body: {
        IfCondition EqualTo(SK.song, 0) ThenBlock: {
            PrintMessage("song play: nothing loaded\n")
            ReturnValue(0)
        }
        SK.sev = 0
        SK.sframe = 0
        SK.splay = 1
        SK_ChanInit()
        SK_LoadMap()
        SK.dbg_n = 0
        SK.st_tick = 0
        SK.st_us = 0
        SK.st_tempo = MIDI_SongTempo(SK.song)
        IfCondition EqualTo(SK.st_tempo, 0) ThenBlock: { SK.st_tempo = 500000 }
        SK.sdiv = MIDI_SongDivision(SK.song)
        IfCondition EqualTo(SK.sdiv, 0) ThenBlock: { SK.sdiv = 480 }
        SK_SongCueFirst()
        PrintMessage("song play events=")
        PrintNumber(MIDI_SongCount(SK.song))
        PrintMessage(" cue_ev=")
        PrintNumber(SK.sev)
        PrintMessage(" cue_frame=")
        PrintNumber(SK.sframe)
        PrintMessage(" tempo=")
        PrintNumber(SK.st_tempo)
        PrintMessage(" div=")
        PrintNumber(SK.sdiv)
        PrintMessage(" clock=")
        PrintNumber(SK.rate)
        PrintMessage(" Hz\n")
    }
}

Function.SK_PollSong {
    Body: {
        song_path = SK_Path("song.txt")
        n = SK_ReadFile(song_path, SK.sbuf, 500)
        IfCondition GreaterThan(n, 4) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, n) {
                c = GetByte(SK.sbuf, i)
                IfCondition EqualTo(c, 10) ThenBlock: { SetByte(SK.sbuf, i, 0) }
                IfCondition EqualTo(c, 13) ThenBlock: { SetByte(SK.sbuf, i, 0) }
                i = Add(i, 1)
            }
            SetByte(SK.sbuf, n, 0)
            same = SK_PathSame(SK.sbuf, SK.spath)
            IfCondition EqualTo(same, 0) ThenBlock: {
                i = 0
                WhileLoop LessThan(i, 512) {
                    SetByte(SK.spath, i, GetByte(SK.sbuf, i))
                    i = Add(i, 1)
                }
                SK_AllOff()
                SK.splay = 0
                PrintMessage("song load ")
                PrintString(SK.spath)
                PrintMessage("\n")
                IfCondition NotEqual(SK.song, 0) ThenBlock: {
                    MIDI_SongFree(SK.song)
                    SK.song = 0
                }
                loaded = MIDI_SongLoadPath(SK.spath)
                SK.song = loaded
                IfCondition EqualTo(loaded, 0) ThenBlock: {
                    PrintMessage("song load failed (open/read/parse)\n")
                    SK.send = 0
                } ElseBlock: {
                    cnt = MIDI_SongCount(loaded)
                    err = MIDI_SongErr(loaded)
                    fmt = MIDI_SongFormat(loaded)
                    ntr = MIDI_SongTracks(loaded)
                    last = 0
                    IfCondition GreaterThan(cnt, 0) ThenBlock: {
                        li = Subtract(cnt, 1)
                        ev = MIDI_SongEvent(loaded, li)
                        last = MIDI_EvTick(ev)
                    }
                    SK.send = Add(SK_TickFrames(last), 48000)
                    PrintMessage("  format=")
                    PrintNumber(fmt)
                    PrintMessage(" tracks=")
                    PrintNumber(ntr)
                    PrintMessage(" events=")
                    PrintNumber(cnt)
                    PrintMessage(" err=")
                    PrintNumber(err)
                    PrintMessage(" last_tick=")
                    PrintNumber(last)
                    PrintMessage(" frames=")
                    PrintNumber(SK.send)
                    PrintMessage("\n")
                    SK_LoadMap()
                }
            }
        }
        cmd_path = SK_Path("song_cmd.txt")
        cn = SK_ReadFile(cmd_path, SK.cbuf, 16)
        IfCondition GreaterThan(cn, 3) ThenBlock: {
            c0 = GetByte(SK.cbuf, 0)
            IfCondition EqualTo(c0, 112) ThenBlock: { SK_SongPlay() }
            IfCondition EqualTo(c0, 115) ThenBlock: { SK_SongStop() }
            cmd_path = SK_Path("song_cmd.txt")
            fd = SystemCall(SKSys.SYS_OPEN, cmd_path, 577, 420)
            IfCondition GreaterEqual(fd, 0) ThenBlock: {
                SystemCall(SKSys.SYS_WRITE, fd, "\n", 1)
                SystemCall(SKSys.SYS_CLOSE, fd)
            }
        }
    }
}

Function.SK_SongTick {
    Input: frames: Integer
    Body: {
        IfCondition EqualTo(SK.splay, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SK.song, 0) ThenBlock: { ReturnValue(0) }
        endp = Add(SK.sframe, frames)
        cnt = MIDI_SongCount(SK.song)
        div = SK.sdiv
        IfCondition EqualTo(div, 0) ThenBlock: { div = 480 }
        smpte = BitwiseAnd(div, 32768)
        go = 1
        WhileLoop And(LessThan(SK.sev, cnt), EqualTo(go, 1)) {
            ev = MIDI_SongEvent(SK.song, SK.sev)
            IfCondition EqualTo(ev, 0) ThenBlock: {
                go = 0
            } ElseBlock: {
                tk = MIDI_EvTick(ev)
                dt = Subtract(tk, SK.st_tick)
                IfCondition LessThan(dt, 0) ThenBlock: { dt = 0 }
                us = 0
                IfCondition NotEqual(smpte, 0) ThenBlock: {
                    us = MIDI_TickToUS(SK.song, tk)
                } ElseBlock: {
                    add_us = Divide(Multiply(dt, SK.st_tempo), div)
                    us = Add(SK.st_us, add_us)
                }
                rt = SK.rate
                IfCondition LessThan(rt, 8000) ThenBlock: { rt = 48000 }
                ef = Divide(Multiply(us, rt), 1000000)
                IfCondition GreaterEqual(ef, endp) ThenBlock: {
                    go = 0
                } ElseBlock: {
                    SK.st_tick = tk
                    SK.st_us = us
                    kind = MIDI_EvKind(ev)
                    st = MIDI_EvStatus(ev)
                    IfCondition EqualTo(kind, 2) ThenBlock: {
                        IfCondition EqualTo(st, 81) ThenBlock: {
                            nt = MIDI_EvLen(ev)
                            IfCondition GreaterThan(nt, 0) ThenBlock: { SK.st_tempo = nt }
                        }
                    }
                    SK_SongApply(ev)
                    SK.sev = Add(SK.sev, 1)
                }
            }
        }
        SK.sframe = endp
        IfCondition GreaterThan(SK.sframe, SK.send) ThenBlock: { SK_SongStop() }
    }
}

Function.SK_CmdQuit {
    Output: Integer
    Body: {
        quit_path = SK_Path("cmd.txt")
        n = SK_ReadFile(quit_path, SK.cbuf, 16)
        IfCondition LessThan(n, 4) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(SK.cbuf, 0), 113) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SK_ParseInt {
    Input: buf: Address
    Input: pos: Integer
    Input: lim: Integer
    Output: Integer
    Body: {
        i = pos
        done = 0
        WhileLoop And(LessThan(i, lim), EqualTo(done, 0)) {
            c = GetByte(buf, i)
            sp = 0
            IfCondition EqualTo(c, 32) ThenBlock: { sp = 1 }
            IfCondition EqualTo(c, 10) ThenBlock: { sp = 1 }
            IfCondition EqualTo(c, 9) ThenBlock: { sp = 1 }
            IfCondition EqualTo(sp, 1) ThenBlock: {
                i = Add(i, 1)
            } ElseBlock: {
                done = 1
            }
        }
        IfCondition GreaterEqual(i, lim) ThenBlock: { ReturnValue(0) }
        sign = 1
        IfCondition EqualTo(GetByte(buf, i), 45) ThenBlock: {
            sign = Subtract(0, 1)
            i = Add(i, 1)
        }
        v = 0
        reading = 1
        WhileLoop And(LessThan(i, lim), EqualTo(reading, 1)) {
            c = GetByte(buf, i)
            IfCondition And(GreaterEqual(c, 48), LessThan(c, 58)) ThenBlock: {
                v = Add(Multiply(v, 10), Subtract(c, 48))
                i = Add(i, 1)
            } ElseBlock: {
                reading = 0
            }
        }
        ReturnValue(Multiply(v, sign))
    }
}

Function.SK_NextTok {
    Input: buf: Address
    Input: pos: Integer
    Input: lim: Integer
    Output: Integer
    Body: {
        i = pos
        WhileLoop LessThan(i, lim) {
            c = GetByte(buf, i)
            IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(lim) }
            sp = 0
            IfCondition EqualTo(c, 32) ThenBlock: { sp = 1 }
            IfCondition EqualTo(c, 10) ThenBlock: { sp = 1 }
            IfCondition EqualTo(c, 9) ThenBlock: { sp = 1 }
            IfCondition EqualTo(sp, 1) ThenBlock: { ReturnValue(Add(i, 1)) }
            i = Add(i, 1)
        }
        ReturnValue(lim)
    }
}

Function.SK_Same {
    Input: slot: Integer
    Input: now: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(SK.snap, 0) ThenBlock: { ReturnValue(0) }
        old = Dereference(Add(SK.snap, Multiply(slot, 8)))
        IfCondition EqualTo(old, now) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SK_FillSnap {
    Input: buf: Address
    Input: n: Integer
    Body: {
        IfCondition EqualTo(SK.snap, 0) ThenBlock: {
            SK.snap = Allocate(256)
            MemorySet(SK.snap, 0, 256)
        }
        i = 0
        p = 0
        WhileLoop LessThan(i, 32) {
            v = SK_ParseInt(buf, p, n)
            StoreValue(Add(SK.snap, Multiply(i, 8)), v)
            p = SK_NextTok(buf, p, n)
            i = Add(i, 1)
        }
    }
}

Function.SK_PollCtl {
    Body: {
        ctl_path = SK_Path("ctl.txt")
        n = SK_ReadFile(ctl_path, SK.cbuf, 512)
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        csum = 0
        ci = 0
        WhileLoop LessThan(ci, n) {
            csum = Add(csum, GetByte(SK.cbuf, ci))
            ci = Add(ci, 1)
        }
        keep_preset = SK.preset
        kwave = SK.wave
        kwave2 = SK.wave2
        kmix = SK.oscmix
        kcut = SK.cutoff
        kres = SK.res
        katk = SK.atk
        kdec = SK.dec
        krel = SK.rel
        ksus = SK.suslvl
        kfenv = SK.fenv
        kmode = SK.cutmode
        ksemi = SK.cutsemi
        kem = SK.envmod
        kuse = SK.usefeg
        kfa = SK.fatk
        kfd = SK.fdec
        kfs = SK.fsus
        kfr = SK.frel
        IfCondition EqualTo(SK.preset, 1) ThenBlock: {
            IfCondition EqualTo(csum, SK.ctlsum) ThenBlock: { ReturnValue(0) }
        }
        buf = SK.cbuf
        lim = n
        p = 0
        SK.wave = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.cutoff = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.res = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.delayms = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.fb = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.wet = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.vol = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.atk = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.dec = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.rel = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.oct = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.pw = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.detune = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.fenv = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.lforate = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.lfopwm = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.submix = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.drive = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.wave2 = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.oscmix = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.o2oct = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.suslvl = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.lfofilt = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.lfoamp = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        parsed_mod = SK_ParseInt(buf, p, lim)
        IfCondition EqualTo(SK.mod_midi, 0) ThenBlock: { SK.mod = parsed_mod }
        Synth_ModSet(SMod.MODWHEEL, SK.mod)
        p = SK_NextTok(buf, p, lim)
        SK.md0 = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.ma0 = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.md1 = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.ma1 = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.md2 = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.ma2 = SK_ParseInt(buf, p, lim)
        IfCondition EqualTo(SK.pw, 0) ThenBlock: { SK.pw = 64 }
        IfCondition LessThan(SK.wave, 0) ThenBlock: { SK.wave = 0 }
        IfCondition GreaterThan(SK.wave, 7) ThenBlock: { SK.wave = 3 }
        IfCondition LessThan(SK.wave2, 0) ThenBlock: { SK.wave2 = 0 }
        IfCondition GreaterThan(SK.wave2, 7) ThenBlock: { SK.wave2 = 3 }
        IfCondition LessThan(SK.oscmix, 0) ThenBlock: { SK.oscmix = 0 }
        IfCondition GreaterThan(SK.oscmix, 256) ThenBlock: { SK.oscmix = 256 }
        IfCondition LessThan(SK.o2oct, 0) ThenBlock: { SK.o2oct = 0 }
        IfCondition GreaterThan(SK.o2oct, 4) ThenBlock: { SK.o2oct = 4 }
        IfCondition LessThan(SK.suslvl, 0) ThenBlock: { SK.suslvl = 0 }
        IfCondition GreaterThan(SK.suslvl, 256) ThenBlock: { SK.suslvl = 256 }
        IfCondition LessThan(SK.oct, 0) ThenBlock: { SK.oct = 0 }
        IfCondition GreaterThan(SK.oct, 4) ThenBlock: { SK.oct = 4 }
        IfCondition EqualTo(keep_preset, 1) ThenBlock: {
            IfCondition EqualTo(SK_Same(0, SK.wave), 1) ThenBlock: { SK.wave = kwave }
            IfCondition EqualTo(SK_Same(18, SK.wave2), 1) ThenBlock: { SK.wave2 = kwave2 }
            IfCondition EqualTo(SK_Same(19, SK.oscmix), 1) ThenBlock: { SK.oscmix = kmix }
            IfCondition EqualTo(SK_Same(1, SK.cutoff), 1) ThenBlock: {
                SK.cutoff = kcut
                SK.cutmode = kmode
                SK.cutsemi = ksemi
                SK.envmod = kem
            } ElseBlock: {
                IfCondition EqualTo(kmode, 1) ThenBlock: {
                    oldc = 0
                    IfCondition NotEqual(SK.snap, 0) ThenBlock: {
                        oldc = Dereference(Add(SK.snap, 8))
                    }
                    delta = Subtract(SK.cutoff, oldc)
                    step = Divide(Multiply(delta, 130000), 256)
                    SK.cutsemi = Add(ksemi, step)
                    SK.cutmode = 1
                    SK.envmod = kem
                    IfCondition NotEqual(SK.snap, 0) ThenBlock: {
                        StoreValue(Add(SK.snap, 8), SK.cutoff)
                    }
                } ElseBlock: {
                    SK.cutmode = 0
                }
            }
            IfCondition EqualTo(SK_Same(2, SK.res), 1) ThenBlock: { SK.res = kres }
            IfCondition EqualTo(SK_Same(7, SK.atk), 1) ThenBlock: { SK.atk = katk }
            IfCondition EqualTo(SK_Same(8, SK.dec), 1) ThenBlock: { SK.dec = kdec }
            IfCondition EqualTo(SK_Same(9, SK.rel), 1) ThenBlock: { SK.rel = krel }
            IfCondition EqualTo(SK_Same(21, SK.suslvl), 1) ThenBlock: { SK.suslvl = ksus }
            IfCondition EqualTo(SK_Same(13, SK.fenv), 1) ThenBlock: {
                SK.fenv = kfenv
                SK.usefeg = kuse
                SK.fatk = kfa
                SK.fdec = kfd
                SK.fsus = kfs
                SK.frel = kfr
            } ElseBlock: {
                SK.usefeg = 0
            }
        }
        cut = SK_Clamp(Add(SK.cutoff, SK_ModAmt(1)), 0, 256)
        rs = SK_Clamp(Add(SK.res, SK_ModAmt(2)), 0, 240)
        pit = SK_ModAmt(3)
        lfd = SK_Clamp(Add(SK.lfopwm, SK_ModAmt(4)), 0, 256)
        pww = SK_Clamp(Add(SK.pw, SK_ModAmt(5)), 8, 248)
        drv = SK_Clamp(Add(SK.drive, SK_ModAmt(6)), 0, 256)
        amp = SK_Clamp(Add(SK.vol, SK_ModAmt(7)), 0, 512)
        dly = SK_Clamp(Add(SK.wet, SK_ModAmt(8)), 0, 256)
        fev = SK_Clamp(Add(SK.fenv, SK_ModAmt(9)), 0, 256)
        sub = SK_Clamp(Add(SK.submix, SK_ModAmt(10)), 0, 256)
        n = Synth_VoiceCount(SK.syn)
        i = 0
        WhileLoop LessThan(i, n) {
            vv = Synth_Voice(SK.syn, i)
            wv = 0
            IfCondition NotEqual(vv, 0) ThenBlock: { wv = GetByte(vv, 16) }
            IfCondition EqualTo(wv, 8) ThenBlock: {
                i = i
            } ElseBlock: {
                SK_SynthShape(i, 0)
            }
            i = Add(i, 1)
        }
        Synth_SetDelay(SK.syn, SK.delayms, SK.fb, dly)
        Synth_SetMixGain(SK.syn, amp)
        IfCondition EqualTo(keep_preset, 1) ThenBlock: { SK.ctlsum = csum }
    }
}

Function.SK_ModAmt {
    Input: dest: Integer
    Output: Integer
    Body: {
        a = 0
        IfCondition EqualTo(SK.md0, dest) ThenBlock: {
            a = Add(a, Divide(Multiply(SK.mod, SK.ma0), 256))
        }
        IfCondition EqualTo(SK.md1, dest) ThenBlock: {
            a = Add(a, Divide(Multiply(SK.mod, SK.ma1), 256))
        }
        IfCondition EqualTo(SK.md2, dest) ThenBlock: {
            a = Add(a, Divide(Multiply(SK.mod, SK.ma2), 256))
        }
        ReturnValue(a)
    }
}

Function.SK_Clamp {
    Input: x: Integer
    Input: lo: Integer
    Input: hi: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(x, lo) ThenBlock: { ReturnValue(lo) }
        IfCondition GreaterThan(x, hi) ThenBlock: { ReturnValue(hi) }
        ReturnValue(x)
    }
}

Function.SK_MidiOf {
    Input: slot: Integer
    Output: Integer
    Body: {
        n = 60
        IfCondition EqualTo(slot, 1) ThenBlock: { n = 62 }
        IfCondition EqualTo(slot, 2) ThenBlock: { n = 64 }
        IfCondition EqualTo(slot, 3) ThenBlock: { n = 65 }
        IfCondition EqualTo(slot, 4) ThenBlock: { n = 67 }
        IfCondition EqualTo(slot, 5) ThenBlock: { n = 69 }
        IfCondition EqualTo(slot, 6) ThenBlock: { n = 71 }
        oct = Subtract(SK.oct, 2)
        ReturnValue(Add(n, Multiply(oct, 12)))
    }
}

Function.SK_KeyNow {
    Input: slot: Integer
    Output: Integer
    Body: {
        c = GetByte(SK.kbuf, slot)
        IfCondition EqualTo(c, 49) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SK_PrevGet {
    Input: slot: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(slot, 0) ThenBlock: { ReturnValue(SK.p0) }
        IfCondition EqualTo(slot, 1) ThenBlock: { ReturnValue(SK.p1) }
        IfCondition EqualTo(slot, 2) ThenBlock: { ReturnValue(SK.p2) }
        IfCondition EqualTo(slot, 3) ThenBlock: { ReturnValue(SK.p3) }
        IfCondition EqualTo(slot, 4) ThenBlock: { ReturnValue(SK.p4) }
        IfCondition EqualTo(slot, 5) ThenBlock: { ReturnValue(SK.p5) }
        ReturnValue(SK.p6)
    }
}

Function.SK_PrevSet {
    Input: slot: Integer
    Input: v: Integer
    Body: {
        IfCondition EqualTo(slot, 0) ThenBlock: { SK.p0 = v }
        IfCondition EqualTo(slot, 1) ThenBlock: { SK.p1 = v }
        IfCondition EqualTo(slot, 2) ThenBlock: { SK.p2 = v }
        IfCondition EqualTo(slot, 3) ThenBlock: { SK.p3 = v }
        IfCondition EqualTo(slot, 4) ThenBlock: { SK.p4 = v }
        IfCondition EqualTo(slot, 5) ThenBlock: { SK.p5 = v }
        IfCondition EqualTo(slot, 6) ThenBlock: { SK.p6 = v }
    }
}

Function.SK_PedGet {
    Input: slot: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(slot, 0) ThenBlock: { ReturnValue(SK.ped0) }
        IfCondition EqualTo(slot, 1) ThenBlock: { ReturnValue(SK.ped1) }
        IfCondition EqualTo(slot, 2) ThenBlock: { ReturnValue(SK.ped2) }
        IfCondition EqualTo(slot, 3) ThenBlock: { ReturnValue(SK.ped3) }
        IfCondition EqualTo(slot, 4) ThenBlock: { ReturnValue(SK.ped4) }
        IfCondition EqualTo(slot, 5) ThenBlock: { ReturnValue(SK.ped5) }
        ReturnValue(SK.ped6)
    }
}

Function.SK_PedSet {
    Input: slot: Integer
    Input: v: Integer
    Body: {
        IfCondition EqualTo(slot, 0) ThenBlock: { SK.ped0 = v }
        IfCondition EqualTo(slot, 1) ThenBlock: { SK.ped1 = v }
        IfCondition EqualTo(slot, 2) ThenBlock: { SK.ped2 = v }
        IfCondition EqualTo(slot, 3) ThenBlock: { SK.ped3 = v }
        IfCondition EqualTo(slot, 4) ThenBlock: { SK.ped4 = v }
        IfCondition EqualTo(slot, 5) ThenBlock: { SK.ped5 = v }
        IfCondition EqualTo(slot, 6) ThenBlock: { SK.ped6 = v }
    }
}

Function.SK_PollKeys {
    Body: {
        key_path = SK_Path("keys.txt")
        n = SK_ReadFile(key_path, SK.kbuf, 16)
        IfCondition LessThan(n, 7) ThenBlock: { ReturnValue(0) }
        SK.sus = 0
        IfCondition GreaterThan(n, 7) ThenBlock: {
            IfCondition EqualTo(GetByte(SK.kbuf, 7), 49) ThenBlock: { SK.sus = 1 }
        }
        i = 0
        WhileLoop LessThan(i, 7) {
            now = SK_KeyNow(i)
            was = SK_PrevGet(i)
            IfCondition And(EqualTo(was, 0), EqualTo(now, 1)) ThenBlock: {
                note = SK_MidiOf(i)
                IfCondition GreaterThan(SK.pn, 0) ThenBlock: {
                    SK.as_sample = 1
                    SK_NoteOn(note, 100, 0)
                    SK.as_sample = 0
                } ElseBlock: {
                    SK_SynthOn(note, 100, SKConst.SYNTHCH)
                }
                SK_PedSet(i, 0)
            }
            IfCondition And(EqualTo(was, 1), EqualTo(now, 0)) ThenBlock: {
                IfCondition EqualTo(SK.sus, 1) ThenBlock: {
                    SK_PedSet(i, 1)
                } ElseBlock: {
                    note = SK_MidiOf(i)
                    IfCondition GreaterThan(SK.pn, 0) ThenBlock: {
                        Synth_NoteOff(SK.syn, note, 0)
                    } ElseBlock: {
                        Synth_NoteOff(SK.syn, note, SKConst.SYNTHCH)
                    }
                    SK_PedSet(i, 0)
                }
            }
            SK_PrevSet(i, now)
            i = Add(i, 1)
        }
        IfCondition And(EqualTo(SK.psus, 1), EqualTo(SK.sus, 0)) ThenBlock: {
            j = 0
            WhileLoop LessThan(j, 7) {
                IfCondition EqualTo(SK_PedGet(j), 1) ThenBlock: {
                    IfCondition EqualTo(SK_KeyNow(j), 0) ThenBlock: {
                        note = SK_MidiOf(j)
                        IfCondition GreaterThan(SK.pn, 0) ThenBlock: {
                            Synth_NoteOff(SK.syn, note, 0)
                        } ElseBlock: {
                            Synth_NoteOff(SK.syn, note, SKConst.SYNTHCH)
                        }
                    }
                    SK_PedSet(j, 0)
                }
                j = Add(j, 1)
            }
        }
        SK.psus = SK.sus
    }
}

Function.SK_CardRoom {
    Output: Integer
    Body: {
        fd = AudioState.fd
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(16, fd, 16674, 0, 0, 0)
        MemorySet(SK.stat, 0, 152)
        r = SystemCall(16, fd, 2157461792, SK.stat, 0, 0)
        IfCondition LessThan(r, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(SK.stat, 64)))
    }
}

Function.SK_CardWait {
    Body: {
        state = 1
        WhileLoop EqualTo(state, 1) {
            room = SK_CardRoom()
            IfCondition GreaterEqual(room, SK.period) ThenBlock: { state = 0 }
            ElseBlock: {
                SystemCall(35, SK.nap, 0, 0)
            }
        }
    }
}

Function.SK_CardOpen {
    Output: Integer
    Body: {
        AudioWant.per_min = 256
        AudioWant.per_max = 256
        AudioWant.buf_min = 1024
        AudioWant.buf_max = 1024
        AudioWant.nper_min = 4
        AudioWant.nper_max = 4
        r = Audio_Init()
        IfCondition LessThan(r, 0) ThenBlock: {
            PrintMessage("card open failed\n")
            ReturnValue(0)
        }
        per = AudioState.period_size
        IfCondition LessThan(per, 1) ThenBlock: { per = 256 }
        SK.period = per
        SK.cardbuf = Allocate(Multiply(per, 4))
        SK.stat = Allocate(152)
        SK.nap = Allocate(16)
        IfCondition EqualTo(SK.cardbuf, 0) ThenBlock: { ReturnValue(0) }
        MemorySet(SK.nap, 0, 16)
        StoreValue(Add(SK.nap, 8), 2000000)
        IfCondition NotEqual(SK.pcm, 0) ThenBlock: {
            StoreValue(Add(SK.pcm, SKOff.RATE), 48000)
        }
        SK.rate = 48000
        SK.card = 1
        PrintMessage("card period ")
        PrintNumber(per)
        PrintMessage(" frames, 48000 Hz, /dev/snd/pcmC0D0p\n")
        ReturnValue(1)
    }
}

Function.SK_CardPlay {
    Input: frames: Integer
    Output: Integer
    Body: {
        Synth_RenderS16Stereo(SK.syn, SK.cardbuf, frames)
        spinning = 1
        wr = 0
        WhileLoop EqualTo(spinning, 1) {
            wr = Audio_WriteFrames(SK.cardbuf, frames)
            IfCondition LessThan(wr, 0) ThenBlock: {
                PrintMessage("card write failed\n")
                spinning = 0
            }
            ElseBlock: {
                IfCondition LessThan(wr, 1) ThenBlock: {
                    SystemCall(35, SK.nap, 0, 0)
                }
                ElseBlock: {
                    spinning = 0
                }
            }
        }
        ReturnValue(wr)
    }
}

Function.SK_PushPcm {
    Input: frames: Integer
    Output: Integer
    Body: {
        pcm = SK.pcm
        cap = Dereference(Add(pcm, SKOff.CAP))
        w = Dereference(Add(pcm, SKOff.WRITE))
        r = Dereference(Add(pcm, SKOff.READ))
        used = Subtract(w, r)
        IfCondition LessThan(used, 0) ThenBlock: { used = 0 }
        space = Subtract(cap, used)
        IfCondition LessThan(space, frames) ThenBlock: { ReturnValue(0) }
        nbytes = Multiply(frames, 4)
        IfCondition EqualTo(SK.rbuf, 0) ThenBlock: {
            SK.rbuf = Allocate(4096)
        }
        tmp = SK.rbuf
        Synth_RenderS16Stereo(SK.syn, tmp, frames)
        data = Add(pcm, SKOff.DATA)
        wslot = Modulo(w, cap)
        n1 = Subtract(cap, wslot)
        IfCondition GreaterThan(n1, frames) ThenBlock: { n1 = frames }
        b1 = Multiply(n1, 4)
        dst = Add(data, Multiply(wslot, 4))
        MemoryCopy(dst, tmp, b1)
        IfCondition LessThan(n1, frames) ThenBlock: {
            n2 = Subtract(frames, n1)
            src2 = Add(tmp, b1)
            MemoryCopy(data, src2, Multiply(n2, 4))
        }
        StoreValue(Add(pcm, SKOff.WRITE), Add(w, frames))
        ReturnValue(1)
    }
}

Function.SK_PollPack {
    Body: {
        pack_path = SK_Path("pack.txt")
        n = SK_ReadFile(pack_path, SK.cbuf, 500)
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        SetByte(SK.cbuf, n, 0)
        i = 0
        WhileLoop LessThan(i, n) {
            c = GetByte(SK.cbuf, i)
            IfCondition EqualTo(c, 10) ThenBlock: { SetByte(SK.cbuf, i, 0) }
            IfCondition EqualTo(c, 13) ThenBlock: { SetByte(SK.cbuf, i, 0) }
            i = Add(i, 1)
        }
        IfCondition NotEqual(SK.proot, 0) ThenBlock: {
            same = SK_PathSame(SK.proot, SK.cbuf)
            IfCondition EqualTo(same, 1) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(SK.splay, 1) ThenBlock: {
            IfCondition GreaterThan(SK.pn, 0) ThenBlock: { ReturnValue(0) }
        }
        SK.pack_new = 1
        PrintMessage("pack reload\n")
        SK_PackLoad()
    }
}

Function.SK_AppendInt {
    Input: buf: Address
    Input: pos: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        v = val
        IfCondition LessThan(v, 0) ThenBlock: {
            SetByte(buf, pos, 45)
            pos = Add(pos, 1)
            v = Subtract(0, v)
        }
        IfCondition EqualTo(v, 0) ThenBlock: {
            SetByte(buf, pos, 48)
            ReturnValue(Add(pos, 1))
        }
        n = 0
        tmp = v
        WhileLoop GreaterThan(tmp, 0) {
            n = Add(n, 1)
            tmp = Divide(tmp, 10)
        }
        endp = Add(pos, n)
        i = endp
        WhileLoop GreaterThan(v, 0) {
            i = Subtract(i, 1)
            dig = Modulo(v, 10)
            SetByte(buf, i, Add(48, dig))
            v = Divide(v, 10)
        }
        ReturnValue(endp)
    }
}

Function.SK_WriteBuf {
    Input: name: Address
    Input: buf: Address
    Input: n: Integer
    Body: {
        path = SK_Path(name)
        fd = SystemCall(SKSys.SYS_OPEN, path, 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(SKSys.SYS_WRITE, fd, buf, n)
            SystemCall(SKSys.SYS_CLOSE, fd)
        }
    }
}

Function.SK_PublishPatch {
    Input: typ1: Integer
    Input: typ2: Integer
    Body: {
        IfCondition EqualTo(SK.snap, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SK.pub, 0) ThenBlock: { SK.pub = Allocate(512) }
        StoreValue(Add(SK.snap, 0), SK.wave)
        StoreValue(Add(SK.snap, 8), SK.cutoff)
        StoreValue(Add(SK.snap, 16), SK.res)
        StoreValue(Add(SK.snap, 56), SK.atk)
        StoreValue(Add(SK.snap, 64), SK.dec)
        StoreValue(Add(SK.snap, 72), SK.rel)
        StoreValue(Add(SK.snap, 104), 0)
        StoreValue(Add(SK.snap, 144), SK.wave2)
        StoreValue(Add(SK.snap, 152), SK.oscmix)
        StoreValue(Add(SK.snap, 168), SK.suslvl)
        SK.lforate = 0
        SK.lfopwm = 0
        SK.lfofilt = 0
        SK.lfoamp = 0
        SK.submix = 0
        SK.drive = 0
        SK.detune = 0
        SK.delayms = 0
        SK.fb = 0
        SK.wet = 0
        StoreValue(Add(SK.snap, 24), 0)
        StoreValue(Add(SK.snap, 32), 0)
        StoreValue(Add(SK.snap, 40), 0)
        StoreValue(Add(SK.snap, 96), 0)
        StoreValue(Add(SK.snap, 112), 0)
        StoreValue(Add(SK.snap, 120), 0)
        StoreValue(Add(SK.snap, 128), 0)
        StoreValue(Add(SK.snap, 136), 0)
        StoreValue(Add(SK.snap, 176), 0)
        StoreValue(Add(SK.snap, 184), 0)
        buf = SK.pub
        pos = 0
        i = 0
        WhileLoop LessThan(i, 31) {
            v = Dereference(Add(SK.snap, Multiply(i, 8)))
            pos = SK_AppendInt(buf, pos, v)
            SetByte(buf, pos, 32)
            pos = Add(pos, 1)
            i = Add(i, 1)
        }
        SetByte(buf, Subtract(pos, 1), 10)
        SK_WriteBuf("ctl.txt", buf, pos)
        csum = 0
        ci = 0
        WhileLoop LessThan(ci, pos) {
            csum = Add(csum, GetByte(buf, ci))
            ci = Add(ci, 1)
        }
        SK.ctlsum = csum
        pos = 0
        pos = SK_AppendInt(buf, pos, SK.wave)
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = SK_AppendInt(buf, pos, SK.wave2)
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = SK_AppendInt(buf, pos, typ1)
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = SK_AppendInt(buf, pos, typ2)
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = SK_AppendInt(buf, pos, SK.oscmix)
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = SK_AppendInt(buf, pos, SK.cutoff)
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = SK_AppendInt(buf, pos, SK.res)
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = SK_AppendInt(buf, pos, SK.atk)
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = SK_AppendInt(buf, pos, SK.dec)
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = SK_AppendInt(buf, pos, SK.suslvl)
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = SK_AppendInt(buf, pos, SK.rel)
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = SK_AppendInt(buf, pos, SK.envmod)
        SetByte(buf, pos, 10)
        pos = Add(pos, 1)
        SK_WriteBuf("heard.txt", buf, pos)
    }
}

Function.SK_PollSurge {
    Body: {
        spath = SK_Path("surge.txt")
        n = SK_ReadFile(spath, SK.bbuf, 500)
        IfCondition LessThan(n, 4) ThenBlock: { ReturnValue(0) }
        SetByte(SK.bbuf, n, 0)
        i = 0
        WhileLoop LessThan(i, n) {
            c = GetByte(SK.bbuf, i)
            IfCondition EqualTo(c, 10) ThenBlock: { SetByte(SK.bbuf, i, 0) }
            IfCondition EqualTo(c, 13) ThenBlock: { SetByte(SK.bbuf, i, 0) }
            i = Add(i, 1)
        }
        IfCondition EqualTo(SK.surgelast, 0) ThenBlock: {
            SK.surgelast = Allocate(512)
            MemorySet(SK.surgelast, 0, 512)
        }
        same = SK_PathSame(SK.surgelast, SK.bbuf)
        IfCondition EqualTo(same, 1) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 500) {
            SetByte(SK.surgelast, i, GetByte(SK.bbuf, i))
            i = Add(i, 1)
        }
        ok = Surge_Load(SK.surgelast)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        SK.wave = SurgeG.wave
        SK.wave2 = SurgeG.wave2
        SK.oscmix = SurgeG.oscmix
        SK.cutoff = SurgeG.cutoff
        SK.res = SurgeG.res
        SK.fenv = 0
        SK.atk = SurgeG.atk
        SK.dec = SurgeG.dec
        SK.suslvl = SurgeG.sus
        SK.rel = SurgeG.rel
        SK.cutsemi = SurgeG.cutmilli
        SK.envmod = SurgeG.envmod
        SK.cutmode = 1
        SK.fatk = SurgeG.fatk
        SK.fdec = SurgeG.fdec
        SK.fsus = SurgeG.fsus
        SK.frel = SurgeG.frel
        SK.usefeg = 0
        IfCondition NotEqual(SurgeG.envmod, 0) ThenBlock: { SK.usefeg = 1 }
        cpath = SK_Path("ctl.txt")
        cn = SK_ReadFile(cpath, SK.cbuf, 512)
        csum = 0
        ci = 0
        WhileLoop LessThan(ci, cn) {
            csum = Add(csum, GetByte(SK.cbuf, ci))
            ci = Add(ci, 1)
        }
        SK_FillSnap(SK.cbuf, cn)
        SK.preset = 1
        SK_PublishPatch(SurgeG.typ1, SurgeG.typ2)
        nvoice = Synth_VoiceCount(SK.syn)
        vi = 0
        WhileLoop LessThan(vi, nvoice) {
            vv = Synth_Voice(SK.syn, vi)
            wv = 0
            IfCondition NotEqual(vv, 0) ThenBlock: { wv = GetByte(vv, 16) }
            IfCondition NotEqual(wv, 8) ThenBlock: { SK_SynthShape(vi, 0) }
            vi = Add(vi, 1)
        }
    }
}

Function.SK_PollRoutes {
    Body: {
        rpath = SK_Path("routes.txt")
        n = SK_ReadFile(rpath, SK.bbuf, 500)
        IfCondition LessThan(n, 2) ThenBlock: { ReturnValue(0) }
        Synth_RouteClear()
        i = 0
        WhileLoop LessThan(i, n) {
            src = SK_ParseInt(SK.bbuf, i, n)
            i = SK_NextTok(SK.bbuf, i, n)
            dst = SK_ParseInt(SK.bbuf, i, n)
            i = SK_NextTok(SK.bbuf, i, n)
            depth = SK_ParseInt(SK.bbuf, i, n)
            i = SK_NextTok(SK.bbuf, i, n)
            use = 0
            IfCondition GreaterThan(src, 0) ThenBlock: { use = 1 }
            IfCondition NotEqual(depth, 0) ThenBlock: { use = 1 }
            IfCondition EqualTo(use, 1) ThenBlock: {
                Synth_RouteAdd(src, dst, depth)
            }
        }
    }
}

Function.SK_PollInst {
    Body: {
        inst_path = SK_Path("inst.txt")
        n = SK_ReadFile(inst_path, SK.cbuf, 200)
        IfCondition LessThan(n, 2) ThenBlock: { ReturnValue(0) }
        SetByte(SK.cbuf, n, 0)
        i = 0
        WhileLoop LessThan(i, n) {
            c = GetByte(SK.cbuf, i)
            IfCondition EqualTo(c, 10) ThenBlock: { SetByte(SK.cbuf, i, 0) }
            IfCondition EqualTo(c, 13) ThenBlock: { SetByte(SK.cbuf, i, 0) }
            i = Add(i, 1)
        }
        iid = Opcode_Find(SK.cbuf)
        IfCondition NotEqual(iid, SK.jam) ThenBlock: {
            SK.jam = iid
            PrintMessage("sample instrument ")
            PrintString(SK.cbuf)
            PrintMessage(" id=")
            PrintNumber(iid)
            PrintMessage("\n")
        }
    }
}

SubRoutine.Main {
    Arena_Init()
    SK_Boot()
    PrintMessage("synthkit kernel ")
    PrintString(SK.root)
    PrintMessage("\n")
    SK_Ensure()
    SK.kbuf = Allocate(32)
    SK.cbuf = Allocate(512)
    SK.bbuf = Allocate(512)
    SK.bpath = Allocate(512)
    MemorySet(SK.bpath, 0, 512)
    SK.sbuf = Allocate(512)
    SK.spath = Allocate(512)
    MemorySet(SK.spath, 0, 512)
    SK.ts = Allocate(16)
    SK_ChanInit()
    SK.pcm = SK_OpenPcm()
    IfCondition EqualTo(SK.pcm, 0) ThenBlock: {
        PrintMessage("pcm mmap failed\n")
        SystemCall(SKSys.SYS_EXIT, 1)
    }
    IfCondition EqualTo(SK.playhead, 1) ThenBlock: { SK_CardOpen() }
    SK.syn = Synth_New(0, 48000)
    PrintMessage("voice pool grows with the music\n")
    MIDI_StreamInit()
    SK.midi = SK_OpenMidi()
    smp = Smp_LoadWav("/home/bob/Ailang-Self-Hosting-/tests/sample/sine_c4.wav")
    IfCondition EqualTo(smp, 0) ThenBlock: {
        smp = Smp_LoadWav("../../tests/sample/sine_c4.wav")
    }
    IfCondition NotEqual(smp, 0) ThenBlock: {
        Smp_SetLoop(smp, 0, Dereference(Add(smp, 16)), 1)
        Synth_SetBankSample(SK.syn, smp)
        PrintMessage("sample bank loaded\n")
    }
    op_path = SK_Path("opcode16.json")
    Opcode_LoadJson(op_path)
    Opcode_LoadJson("/home/bob/Ailang-Self-Hosting-/Librarys/Media/opcode16.json")
    SK_PackLoad()
    ready_path = SK_Path("ready.txt")
    rfd = SystemCall(SKSys.SYS_OPEN, ready_path, 577, 420)
    IfCondition GreaterEqual(rfd, 0) ThenBlock: {
        SystemCall(SKSys.SYS_WRITE, rfd, "1\n", 2)
        SystemCall(SKSys.SYS_CLOSE, rfd)
    }
    SK_PollCtl()
    IfCondition EqualTo(SK.pn, 0) ThenBlock: {
        SK_PollBank()
    } ElseBlock: {
        PrintMessage("pack live — SF2 bank skipped hwm=")
        livec = Synth_LiveCount()
        PrintNumber(livec)
        PrintMessage("\n")
    }
    SK.run = 1
    tick = 0
    mon = 0
    WhileLoop EqualTo(SK.run, 1) {
        IfCondition EqualTo(SK_CmdQuit(), 1) ThenBlock: { SK.run = 0 }
        hw = SK_PcmRate()
        IfCondition NotEqual(hw, SK.rate) ThenBlock: {
            SK.rate = hw
            PrintMessage("pcm clock ")
            PrintNumber(SK.rate)
            PrintMessage(" Hz (sound card playhead)\n")
        }
        tick = Add(tick, 1)
        IfCondition EqualTo(Modulo(tick, 16), 0) ThenBlock: { SK_PollCtl() }
        IfCondition EqualTo(Modulo(tick, 16), 0) ThenBlock: {
            IfCondition EqualTo(SK.splay, 0) ThenBlock: {
                IfCondition EqualTo(SK.pn, 0) ThenBlock: { SK_PollBank() }
            }
            SK_PollPack()
            SK_PollInst()
            SK_PollSong()
            SK_PollRoutes()
            SK_PollSurge()
        }
        SK_PollMidi()
        SK_PollKeys()
        space = SK_PcmSpace()
        burst = 0
        IfCondition EqualTo(SK.card, 1) ThenBlock: {
            SK_CardWait()
            SK_SongTick(SK.period)
            wr = SK_CardPlay(SK.period)
            IfCondition GreaterThan(wr, 0) ThenBlock: {
                burst = 1
                mon = Add(mon, SK.period)
            }
        }
        ElseBlock: {
            go = 1
            WhileLoop EqualTo(go, 1) {
                IfCondition LessThan(space, SKConst.PERIOD) ThenBlock: { go = 0 }
                IfCondition GreaterEqual(burst, 8) ThenBlock: { go = 0 }
                IfCondition EqualTo(go, 1) ThenBlock: {
                    SK_SongTick(SKConst.PERIOD)
                    ok = SK_PushPcm(SKConst.PERIOD)
                    IfCondition EqualTo(ok, 0) ThenBlock: {
                        go = 0
                    } ElseBlock: {
                        burst = Add(burst, 1)
                        space = SK_PcmSpace()
                        mon = Add(mon, SKConst.PERIOD)
                    }
                }
            }
        }
        IfCondition GreaterEqual(mon, 24000) ThenBlock: {
            mon = 0
            nlive = Synth_LiveCount()
            nalloc = Synth_AllocCount()
            clips = Synth_TakeClips()
            pk = Synth_TakePeak()
            sus0 = 0
            sus1 = 0
            IfCondition NotEqual(SK.csus, 0) ThenBlock: {
                sus0 = GetByte(SK.csus, 0)
                sus1 = GetByte(SK.csus, 1)
            }
            PrintMessage("PLAY nlive=")
            PrintNumber(nlive)
            PrintMessage(" nalloc=")
            PrintNumber(nalloc)
            PrintMessage(" clips=")
            PrintNumber(clips)
            PrintMessage(" peak=")
            PrintNumber(pk)
            PrintMessage(" sus=")
            PrintNumber(sus0)
            PrintMessage(",")
            PrintNumber(sus1)
            PrintMessage(" burst=")
            PrintNumber(burst)
            PrintMessage(" space=")
            PrintNumber(space)
            PrintMessage("\n")
        }
        IfCondition EqualTo(burst, 0) ThenBlock: { SK_SleepMs(1) }
    }
    Synth_Free(SK.syn)
    PrintMessage("synthkit stop\n")
}

RunTask(Main)
