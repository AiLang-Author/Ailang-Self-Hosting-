// synth_app.ailang — synth kernel. Host is GTK chrome + PCM playhead.
// IPC: /dev/shm/synth_app/{keys.txt,ctl.txt,cmd.txt,pcm.bin}
//
// keys.txt : 7 chars 0/1 for C D E F G A B
// ctl.txt  : wave cutoff res delayms fb wet vol atk dec rel oct pw
//            detune fenv lforate lfopwm submix drive
//            wave2 oscmix o2oct suslvl lfofilt lfoamp
//            modv md0 ma0 md1 ma1 md2 ma2
// cmd.txt  : quit
// pcm.bin  : mmap ring, stereo s16 48kHz
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Arena
LibraryImport.Media.Synth
LibraryImport.Media.Sample
LibraryImport.Media.SF2
LibraryImport.Media.MIDI
LibraryImport.Media.Opcode

FixedPool.SKSys {
    "SYS_READ":      Initialize=0
    "SYS_WRITE":     Initialize=1
    "SYS_OPEN":      Initialize=2
    "SYS_CLOSE":     Initialize=3
    "SYS_MMAP":      Initialize=9
    "SYS_NANOSLEEP": Initialize=35
    "SYS_FTRUNCATE": Initialize=77
    "SYS_MKDIR":     Initialize=83
    "SYS_EXIT":      Initialize=60
    "O_RDWR":        Initialize=2
    "O_CREAT":       Initialize=64
    "O_RDONLY":      Initialize=0
    "PROT_RW":       Initialize=3
    "MAP_SHARED":    Initialize=1
}

FixedPool.SKOff {
    "MAGIC": Initialize=0
    "CAP":   Initialize=8
    "WRITE": Initialize=16
    "READ":  Initialize=24
    "RATE":  Initialize=32
    "DATA":  Initialize=64
}

FixedPool.SKConst {
    "CAP":     Initialize=8192
    "PERIOD":  Initialize=256
    "HDR":     Initialize=64
    "MAGIC":   Initialize=1296910669
    "VOICES":  Initialize=256
}

