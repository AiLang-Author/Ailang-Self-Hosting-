Function.SK_SleepMs {
    Input: ms: Integer
    Body: {
        IfCondition EqualTo(SK.ts, 0) ThenBlock: { SK.ts = Allocate(16) }
        StoreValue(SK.ts, 0)
        StoreValue(Add(SK.ts, 8), Multiply(ms, 1000000))
        SystemCall(SKSys.SYS_NANOSLEEP, SK.ts, 0)
    }
}

Function.SK_Ensure {
    Body: {
        SystemCall(SKSys.SYS_MKDIR, "/dev/shm", 493)
        SystemCall(SKSys.SYS_MKDIR, "/dev/shm/synth_app", 493)
    }
}

Function.SK_OpenPcm {
    Output: Address
    Body: {
        flags = Add(SKSys.O_RDWR, SKSys.O_CREAT)
        fd = SystemCall(SKSys.SYS_OPEN, "/dev/shm/synth_app/pcm.bin", flags, 438)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        total = Add(SKConst.HDR, Multiply(SKConst.CAP, 4))
        SystemCall(SKSys.SYS_FTRUNCATE, fd, total)
        ptr = SystemCall(SKSys.SYS_MMAP, 0, total, SKSys.PROT_RW, SKSys.MAP_SHARED, fd, 0)
        IfCondition LessEqual(ptr, 0) ThenBlock: {
            SystemCall(SKSys.SYS_CLOSE, fd)
            ReturnValue(0)
        }
        StoreValue(Add(ptr, SKOff.MAGIC), SKConst.MAGIC)
        StoreValue(Add(ptr, SKOff.CAP), SKConst.CAP)
        mag = Dereference(Add(ptr, SKOff.WRITE))
        IfCondition EqualTo(mag, 0) ThenBlock: {
            StoreValue(Add(ptr, SKOff.WRITE), 0)
            StoreValue(Add(ptr, SKOff.READ), 0)
        }
        ReturnValue(ptr)
    }
}

Function.SK_ReadFile {
    Input: path: Address
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        fd = SystemCall(SKSys.SYS_OPEN, path, SKSys.O_RDONLY, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        MemorySet(buf, 0, n)
        r = SystemCall(SKSys.SYS_READ, fd, buf, n)
        SystemCall(SKSys.SYS_CLOSE, fd)
        IfCondition LessThan(r, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(r)
    }
}

Function.SK_PathSame {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 512) {
            ca = GetByte(a, i)
            cb = GetByte(b, i)
            IfCondition NotEqual(ca, cb) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(ca, 0) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.SK_PollBank {
    Body: {
        n = SK_ReadFile("/dev/shm/synth_app/bank.txt", SK.bbuf, 500)
        IfCondition LessThan(n, 4) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n) {
            c = GetByte(SK.bbuf, i)
            IfCondition EqualTo(c, 10) ThenBlock: { SetByte(SK.bbuf, i, 0) }
            IfCondition EqualTo(c, 13) ThenBlock: { SetByte(SK.bbuf, i, 0) }
            i = Add(i, 1)
        }
        SetByte(SK.bbuf, n, 0)
        same = SK_PathSame(SK.bbuf, SK.bpath)
        IfCondition EqualTo(same, 1) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 512) {
            SetByte(SK.bpath, i, GetByte(SK.bbuf, i))
            i = Add(i, 1)
        }
        PrintMessage("loading bank ")
        PrintString(SK.bpath)
        PrintMessage("\n")
        b = SF2_Load(SK.bpath)
        IfCondition EqualTo(b, 0) ThenBlock: {
            PrintMessage("bank load failed\n")
            ReturnValue(0)
        }
        SK.bank = b
        PrintMessage("bank ok samples=")
        PrintNumber(SF2_Count(b))
        PrintMessage(" regions=")
        PrintNumber(SF2_RegionCount(b))
        np = SF2_PresetCount(b)
        PrintMessage(" presets=")
        PrintNumber(np)
        PrintMessage("\n")
        IfCondition LessThan(np, 16) ThenBlock: {
            PrintMessage("  (few presets — load GeneralUser GS for GM MIDI songs)\n")
        }
        smp = SF2_Lookup(b, 60, 100)
        IfCondition NotEqual(smp, 0) ThenBlock: {
            Synth_SetBankSample(SK.syn, smp)
        }
    }
}

Function.SK_OpenMidi {
    Output: Address
    Body: {
        flags = Add(SKSys.O_RDWR, SKSys.O_CREAT)
        fd = SystemCall(SKSys.SYS_OPEN, "/dev/shm/synth_app/midi.bin", flags, 438)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        total = Add(32, 4096)
        SystemCall(SKSys.SYS_FTRUNCATE, fd, total)
        ptr = SystemCall(SKSys.SYS_MMAP, 0, total, SKSys.PROT_RW, SKSys.MAP_SHARED, fd, 0)
        IfCondition LessEqual(ptr, 0) ThenBlock: {
            SystemCall(SKSys.SYS_CLOSE, fd)
            ReturnValue(0)
        }
        ReturnValue(ptr)
    }
}

Function.SK_ChanInit {
    Body: {
        IfCondition EqualTo(SK.prog, 0) ThenBlock: { SK.prog = Allocate(16) }
        IfCondition EqualTo(SK.bmsb, 0) ThenBlock: { SK.bmsb = Allocate(16) }
        IfCondition EqualTo(SK.chvol, 0) ThenBlock: { SK.chvol = Allocate(16) }
        IfCondition EqualTo(SK.pbend, 0) ThenBlock: { SK.pbend = Allocate(128) }
        IfCondition EqualTo(SK.pbrange, 0) ThenBlock: { SK.pbrange = Allocate(16) }
        IfCondition EqualTo(SK.rpn_m, 0) ThenBlock: { SK.rpn_m = Allocate(16) }
        IfCondition EqualTo(SK.rpn_l, 0) ThenBlock: { SK.rpn_l = Allocate(16) }
        IfCondition EqualTo(SK.instid, 0) ThenBlock: { SK.instid = Allocate(128) }
        IfCondition EqualTo(SK.ilock, 0) ThenBlock: { SK.ilock = Allocate(16) }
        IfCondition EqualTo(SK.mlock, 0) ThenBlock: { SK.mlock = Allocate(16) }
        MemorySet(SK.prog, 0, 16)
        MemorySet(SK.bmsb, 0, 16)
        MemorySet(SK.pbend, 0, 128)
        MemorySet(SK.instid, 0, 128)
        MemorySet(SK.ilock, 0, 16)
        MemorySet(SK.mlock, 0, 16)
        i = 0
        WhileLoop LessThan(i, 16) {
            SetByte(SK.chvol, i, 127)
            SetByte(SK.pbrange, i, 2)
            SetByte(SK.rpn_m, i, 127)
            SetByte(SK.rpn_l, i, 127)
            po = Multiply(i, 8)
            StoreValue(Add(SK.pbend, po), 8192)
            i = Add(i, 1)
        }
    }
}

Function.SK_BendCents {
    Input: ch: Integer
    Output: Integer
    Body: {
        chn = BitwiseAnd(ch, 15)
        pb = 8192
        IfCondition NotEqual(SK.pbend, 0) ThenBlock: {
            po = Multiply(chn, 8)
            pb = Dereference(Add(SK.pbend, po))
        }
        rg = 2
        IfCondition NotEqual(SK.pbrange, 0) ThenBlock: { rg = GetByte(SK.pbrange, chn) }
        IfCondition LessThan(rg, 1) ThenBlock: { rg = 2 }
        IfCondition GreaterThan(rg, 24) ThenBlock: { rg = 24 }
        span = Multiply(rg, 100)
        delta = Subtract(pb, 8192)
        cents = Divide(Multiply(delta, span), 8192)
        ReturnValue(cents)
    }
}

Function.SK_ApplyBend {
    Input: ch: Integer
    Input: pb: Integer
    Body: {
        chn = BitwiseAnd(ch, 15)
        IfCondition NotEqual(SK.pbend, 0) ThenBlock: {
            po = Multiply(chn, 8)
            StoreValue(Add(SK.pbend, po), pb)
        }
        cents = SK_BendCents(chn)
        n = Synth_VoiceCount(SK.syn)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Synth_VoiceCh(SK.syn, i), chn) ThenBlock: {
                Synth_SetPitchMod(SK.syn, i, cents)
            }
            i = Add(i, 1)
        }
    }
}

Function.SK_MidiCC {
    Input: ch: Integer
    Input: d1: Integer
    Input: d2: Integer
    Body: {
        chn = BitwiseAnd(ch, 15)
        IfCondition EqualTo(d1, 1) ThenBlock: {
            SK.mod = Multiply(d2, 2)
            SK.mod_midi = 1
        }
        IfCondition EqualTo(d1, 64) ThenBlock: {
            IfCondition GreaterEqual(d2, 64) ThenBlock: { SK.sus = 1 }
            ElseBlock: { SK.sus = 0 }
        }
        IfCondition EqualTo(d1, 7) ThenBlock: {
            IfCondition NotEqual(SK.chvol, 0) ThenBlock: { SetByte(SK.chvol, chn, d2) }
        }
        IfCondition EqualTo(d1, 0) ThenBlock: {
            IfCondition NotEqual(SK.bmsb, 0) ThenBlock: { SetByte(SK.bmsb, chn, d2) }
        }
        IfCondition EqualTo(d1, 101) ThenBlock: {
            IfCondition NotEqual(SK.rpn_m, 0) ThenBlock: { SetByte(SK.rpn_m, chn, d2) }
        }
        IfCondition EqualTo(d1, 100) ThenBlock: {
            IfCondition NotEqual(SK.rpn_l, 0) ThenBlock: { SetByte(SK.rpn_l, chn, d2) }
        }
        IfCondition EqualTo(d1, 6) ThenBlock: {
            rm = 127
            rl = 127
            IfCondition NotEqual(SK.rpn_m, 0) ThenBlock: { rm = GetByte(SK.rpn_m, chn) }
            IfCondition NotEqual(SK.rpn_l, 0) ThenBlock: { rl = GetByte(SK.rpn_l, chn) }
            IfCondition And(EqualTo(rm, 0), EqualTo(rl, 0)) ThenBlock: {
                IfCondition NotEqual(SK.pbrange, 0) ThenBlock: { SetByte(SK.pbrange, chn, d2) }
            }
        }
    }
}

Function.SK_DbgOk {
    Output: Integer
    Body: {
        IfCondition GreaterThan(SK.dbg_n, 200) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SK.dbg_n, 200) ThenBlock: {
            PrintMessage("SF debug capped at 200 lines\n")
            SK.dbg_n = 201
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.SK_DbgPlay {
    Input: ch: Integer
    Input: pr: Integer
    Input: note: Integer
    Input: nth: Integer
    Input: smp: Address
    Body: {
        ReturnValue(0)
        IfCondition EqualTo(ch, 9) ThenBlock: { ReturnValue(0) }
        ok = SK_DbgOk()
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        root = SF2_LastRoot()
        co = SF2_LastCoarse()
        fi = SF2_LastFine()
        sc = SF2_LastScale()
        atn = SF2_LastAtten()
        fc = SF2_LastFc()
        qq = SF2_LastQ()
        PrintMessage("SF ch=")
        PrintNumber(ch)
        PrintMessage(" prog=")
        PrintNumber(pr)
        PrintMessage(" note=")
        PrintNumber(note)
        PrintMessage(" z=")
        PrintNumber(nth)
        PrintMessage(" root=")
        PrintNumber(root)
        PrintMessage(" co=")
        PrintNumber(co)
        PrintMessage(" fi=")
        PrintNumber(fi)
        PrintMessage(" sc=")
        PrintNumber(sc)
        PrintMessage(" at=")
        PrintNumber(atn)
        PrintMessage(" fc=")
        PrintNumber(fc)
        e2p = SF2_LastE2f()
        PrintMessage(" e2f=")
        PrintNumber(e2p)
        mag = 0
        nfr = 0
        srate = 0
        hroot = 0
        ls = 0
        le = 0
        md = 0
        IfCondition NotEqual(smp, 0) ThenBlock: {
            mag = Dereference(smp)
            nfr = Dereference(Add(smp, 16))
            srate = Dereference(Add(smp, 24))
            hroot = Dereference(Add(smp, 32))
            ls = Dereference(Add(smp, 40))
            le = Dereference(Add(smp, 48))
            md = Dereference(Add(smp, 56))
        }
        PrintMessage(" mag=")
        PrintNumber(mag)
        IfCondition NotEqual(mag, 1397572944) ThenBlock: { PrintMessage(" NOT_SMP") }
        PrintMessage(" n=")
        PrintNumber(nfr)
        PrintMessage(" srate=")
        PrintNumber(srate)
        PrintMessage(" hroot=")
        PrintNumber(hroot)
        PrintMessage(" lp=")
        PrintNumber(ls)
        PrintMessage("-")
        PrintNumber(le)
        PrintMessage(" mode=")
        PrintNumber(md)
        d = co
        IfCondition GreaterThan(sc, 0) ThenBlock: {
            dk = Subtract(note, root)
            dk = Divide(Multiply(dk, sc), 100)
            d = Add(dk, co)
        }
        PrintMessage(" dsemi=")
        PrintNumber(d)
        st = 0
        rt = SK.rate
        IfCondition LessThan(rt, 1) ThenBlock: { rt = 48000 }
        IfCondition NotEqual(smp, 0) ThenBlock: {
            st = Smp_StepD(smp, d, rt)
        }
        PrintMessage(" step=")
        PrintNumber(st)
        nat = 65536
        IfCondition GreaterThan(srate, 0) ThenBlock: {
            nat = Divide(Multiply(srate, 65536), rt)
        }
        IfCondition LessThan(nat, 1) ThenBlock: { nat = 1 }
        rx = Divide(Multiply(st, 100), nat)
        PrintMessage(" ratio%=")
        PrintNumber(rx)
        IfCondition GreaterThan(rx, 400) ThenBlock: { PrintMessage(" FAST") }
        IfCondition GreaterThan(rx, 1600) ThenBlock: { PrintMessage(" ULTRA") }
        PrintMessage("\n")
        SK.dbg_n = Add(SK.dbg_n, 1)
    }
}

Function.SK_InstGet {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(SK.instid, 0) ThenBlock: { ReturnValue(0) }
        pch = BitwiseAnd(ch, 15)
        ReturnValue(Dereference(Add(SK.instid, Multiply(pch, 8))))
    }
}

Function.SK_InstSet {
    Input: ch: Integer
    Input: id: Integer
    Input: lock: Integer
    Body: {
        IfCondition EqualTo(SK.instid, 0) ThenBlock: { ReturnValue(0) }
        pch = BitwiseAnd(ch, 15)
        IfCondition EqualTo(lock, 0) ThenBlock: {
            IfCondition NotEqual(SK.ilock, 0) ThenBlock: {
                IfCondition EqualTo(GetByte(SK.ilock, pch), 1) ThenBlock: { ReturnValue(0) }
            }
        }
        StoreValue(Add(SK.instid, Multiply(pch, 8)), id)
        IfCondition EqualTo(lock, 1) ThenBlock: {
            IfCondition NotEqual(SK.ilock, 0) ThenBlock: { SetByte(SK.ilock, pch, 1) }
        }
    }
}

Function.SK_PackInit {
    Body: {
        IfCondition NotEqual(SK.psmp, 0) ThenBlock: { ReturnValue(0) }
        SK.piid = Allocate(512)
        MemorySet(SK.piid, 0, 512)
        SK.psmp = Allocate(65536)
        MemorySet(SK.psmp, 0, 65536)
        SK.patk = Allocate(1024)
        MemorySet(SK.patk, 0, 1024)
        SK.pn = 0
    }
}

Function.SK_PackSlot {
    Input: iid: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(SK.piid, 0) ThenBlock: { ReturnValue(-1) }
        i = 0
        WhileLoop LessThan(i, SK.pn) {
            IfCondition EqualTo(Dereference(Add(SK.piid, Multiply(i, 8))), iid) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(SK.pn, 64) ThenBlock: { ReturnValue(-1) }
        StoreValue(Add(SK.piid, Multiply(SK.pn, 8)), iid)
        sl = SK.pn
        SK.pn = Add(SK.pn, 1)
        ReturnValue(sl)
    }
}

Function.SK_PackFind {
    Input: iid: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(SK.piid, 0) ThenBlock: { ReturnValue(-1) }
        i = 0
        WhileLoop LessThan(i, SK.pn) {
            IfCondition EqualTo(Dereference(Add(SK.piid, Multiply(i, 8))), iid) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

Function.SK_PackGet {
    Input: iid: Integer
    Input: note: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(SK.psmp, 0) ThenBlock: { ReturnValue(0) }
        sl = SK_PackFind(iid)
        IfCondition LessThan(sl, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(note, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(note, 127) ThenBlock: { ReturnValue(0) }
        off = Add(Multiply(sl, 128), note)
        ReturnValue(Dereference(Add(SK.psmp, Multiply(off, 8))))
    }
}

Function.SK_PackPut {
    Input: sl: Integer
    Input: note: Integer
    Input: smp: Address
    Body: {
        IfCondition EqualTo(SK.psmp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(sl, 0) ThenBlock: { ReturnValue(0) }
        off = Add(Multiply(sl, 128), note)
        StoreValue(Add(SK.psmp, Multiply(off, 8)), smp)
    }
}

Function.SK_PackPath {
    Input: rel: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SK.proot, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(rel, 0) ThenBlock: { ReturnValue(0) }
        fpath = Allocate(600)
        MemorySet(fpath, 0, 600)
        pl = StringLength(SK.proot)
        MemoryCopy(fpath, SK.proot, pl)
        SetByte(fpath, pl, 47)
        off = Add(pl, 1)
        dst = Add(fpath, off)
        rl = StringLength(rel)
        IfCondition GreaterThan(rl, 400) ThenBlock: { rl = 400 }
        MemoryCopy(dst, rel, rl)
        ReturnValue(fpath)
    }
}

Function.SK_PackLoad {
    Body: {
        SK_PackInit()
        n = SK_ReadFile("/dev/shm/synth_app/pack.txt", SK.cbuf, 500)
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        SetByte(SK.cbuf, n, 0)
        SK.proot = Allocate(512)
        MemorySet(SK.proot, 0, 512)
        i = 0
        stop = 0
        WhileLoop EqualTo(stop, 0) {
            IfCondition GreaterEqual(i, n) ThenBlock: { stop = 1 }
            IfCondition EqualTo(stop, 0) ThenBlock: {
                c = GetByte(SK.cbuf, i)
                IfCondition EqualTo(c, 10) ThenBlock: { stop = 1 }
                IfCondition EqualTo(c, 0) ThenBlock: { stop = 1 }
                IfCondition EqualTo(stop, 0) ThenBlock: {
                    SetByte(SK.proot, i, c)
                    i = Add(i, 1)
                }
            }
        }
        mpath = SK_PackPath("manifest.txt")
        mb = Allocate(524288)
        MemorySet(mb, 0, 524288)
        got = SK_ReadFile(mpath, mb, 524286)
        IfCondition LessThan(got, 8) ThenBlock: {
            PrintMessage("pack no manifest\n")
            ReturnValue(0)
        }
        SetByte(mb, got, 0)
        PrintMessage("pack ")
        PrintString(SK.proot)
        PrintMessage("\n")
        sl = -1
        ln0 = 0
        j = 0
        WhileLoop LessEqual(j, got) {
            eol = 0
            IfCondition EqualTo(j, got) ThenBlock: { eol = 1 }
            IfCondition LessThan(j, got) ThenBlock: {
                cj = GetByte(mb, j)
                IfCondition EqualTo(cj, 10) ThenBlock: { eol = 1 }
            }
            IfCondition EqualTo(eol, 1) ThenBlock: {
                IfCondition GreaterThan(j, ln0) ThenBlock: {
                    k = ln0
                    WhileLoop LessThan(k, j) {
                        IfCondition NotEqual(GetByte(mb, k), 32) ThenBlock: {
                            k = j
                        }
                        IfCondition LessThan(k, j) ThenBlock: {
                            IfCondition EqualTo(GetByte(mb, k), 32) ThenBlock: { k = Add(k, 1) }
                        }
                    }
                    k = ln0
                    sp = 1
                    WhileLoop EqualTo(sp, 1) {
                        IfCondition GreaterEqual(k, j) ThenBlock: { sp = 0 }
                        IfCondition EqualTo(sp, 1) ThenBlock: {
                            IfCondition NotEqual(GetByte(mb, k), 32) ThenBlock: { sp = 0 }
                            IfCondition EqualTo(sp, 1) ThenBlock: { k = Add(k, 1) }
                        }
                    }
                    IfCondition LessThan(k, j) ThenBlock: {
                        tag = GetByte(mb, k)
                        IfCondition EqualTo(tag, 73) ThenBlock: {
                            nm = Add(mb, Add(k, 2))
                            e = 0
                            capn = Subtract(j, Add(k, 2))
                            IfCondition GreaterThan(capn, 40) ThenBlock: { capn = 40 }
                            WhileLoop LessThan(e, capn) {
                                cc = GetByte(nm, e)
                                IfCondition EqualTo(cc, 10) ThenBlock: { SetByte(nm, e, 0) }
                                IfCondition EqualTo(cc, 13) ThenBlock: { SetByte(nm, e, 0) }
                                e = Add(e, 1)
                            }
                            SetByte(nm, capn, 0)
                            cur_iid = Opcode_Find(nm)
                            sl = -1
                            IfCondition NotEqual(cur_iid, 0) ThenBlock: {
                                sl = SK_PackSlot(cur_iid)
                            }
                            PrintMessage("  pack inst ")
                            PrintString(nm)
                            PrintMessage(" iid=")
                            PrintNumber(cur_iid)
                            PrintMessage("\n")
                        }
                        IfCondition EqualTo(tag, 65) ThenBlock: {
                            IfCondition GreaterEqual(sl, 0) ThenBlock: {
                                p = Add(k, 2)
                                note = 0
                                dig = 1
                                WhileLoop EqualTo(dig, 1) {
                                    IfCondition GreaterEqual(p, j) ThenBlock: { dig = 0 }
                                    IfCondition EqualTo(dig, 1) ThenBlock: {
                                        dch = GetByte(mb, p)
                                        IfCondition LessThan(dch, 48) ThenBlock: { dig = 0 }
                                        IfCondition GreaterThan(dch, 57) ThenBlock: { dig = 0 }
                                        IfCondition EqualTo(dig, 1) ThenBlock: {
                                            note = Add(Multiply(note, 10), Subtract(dch, 48))
                                            p = Add(p, 1)
                                        }
                                    }
                                }
                                IfCondition GreaterThan(note, 127) ThenBlock: { note = 127 }
                                WhileLoop LessThan(p, j) {
                                    IfCondition NotEqual(GetByte(mb, p), 32) ThenBlock: {
                                        p = j
                                    }
                                    IfCondition LessThan(p, j) ThenBlock: {
                                        IfCondition EqualTo(GetByte(mb, p), 32) ThenBlock: { p = Add(p, 1) }
                                    }
                                }
                                p = Add(k, 2)
                                note = 0
                                dig = 1
                                WhileLoop EqualTo(dig, 1) {
                                    IfCondition GreaterEqual(p, j) ThenBlock: { dig = 0 }
                                    IfCondition EqualTo(dig, 1) ThenBlock: {
                                        dch = GetByte(mb, p)
                                        IfCondition LessThan(dch, 48) ThenBlock: { dig = 0 }
                                        IfCondition GreaterThan(dch, 57) ThenBlock: { dig = 0 }
                                        IfCondition EqualTo(dig, 1) ThenBlock: {
                                            note = Add(Multiply(note, 10), Subtract(dch, 48))
                                            p = Add(p, 1)
                                        }
                                    }
                                }
                                IfCondition GreaterThan(note, 127) ThenBlock: { note = 127 }
                                skipsp = 1
                                WhileLoop EqualTo(skipsp, 1) {
                                    IfCondition GreaterEqual(p, j) ThenBlock: { skipsp = 0 }
                                    IfCondition EqualTo(skipsp, 1) ThenBlock: {
                                        IfCondition NotEqual(GetByte(mb, p), 32) ThenBlock: { skipsp = 0 }
                                        IfCondition EqualTo(skipsp, 1) ThenBlock: { p = Add(p, 1) }
                                    }
                                }
                                IfCondition LessThan(p, j) ThenBlock: {
                                    rel = Add(mb, p)
                                    SetByte(mb, j, 0)
                                    fpath = SK_PackPath(rel)
                                    sm = Smp_LoadWav(fpath)
                                    IfCondition LessThan(note, 128) ThenBlock: {
                                        StoreValue(Add(SK.patk, Multiply(note, 8)), sm)
                                    }
                                }
                            }
                        }
                        IfCondition EqualTo(tag, 76) ThenBlock: {
                            IfCondition GreaterEqual(sl, 0) ThenBlock: {
                                p = Add(k, 2)
                                note = 0
                                dig = 1
                                WhileLoop EqualTo(dig, 1) {
                                    IfCondition GreaterEqual(p, j) ThenBlock: { dig = 0 }
                                    IfCondition EqualTo(dig, 1) ThenBlock: {
                                        dch = GetByte(mb, p)
                                        IfCondition LessThan(dch, 48) ThenBlock: { dig = 0 }
                                        IfCondition GreaterThan(dch, 57) ThenBlock: { dig = 0 }
                                        IfCondition EqualTo(dig, 1) ThenBlock: {
                                            note = Add(Multiply(note, 10), Subtract(dch, 48))
                                            p = Add(p, 1)
                                        }
                                    }
                                }
                                IfCondition GreaterThan(note, 127) ThenBlock: { note = 127 }
                                skipsp = 1
                                WhileLoop EqualTo(skipsp, 1) {
                                    IfCondition GreaterEqual(p, j) ThenBlock: { skipsp = 0 }
                                    IfCondition EqualTo(skipsp, 1) ThenBlock: {
                                        IfCondition NotEqual(GetByte(mb, p), 32) ThenBlock: { skipsp = 0 }
                                        IfCondition EqualTo(skipsp, 1) ThenBlock: { p = Add(p, 1) }
                                    }
                                }
                                IfCondition LessThan(p, j) ThenBlock: {
                                    rel = Add(mb, p)
                                    SetByte(mb, j, 0)
                                    fpath = SK_PackPath(rel)
                                    held = Smp_LoadWav(fpath)
                                    atk = 0
                                    IfCondition LessThan(note, 128) ThenBlock: {
                                        atk = Dereference(Add(SK.patk, Multiply(note, 8)))
                                    }
                                    joined = Smp_JoinHeld(atk, held)
                                    SK_PackPut(sl, note, joined)
                                }
                            }
                        }
                        IfCondition EqualTo(tag, 72) ThenBlock: {
                            IfCondition GreaterEqual(sl, 0) ThenBlock: {
                                p = Add(k, 2)
                                note = 0
                                dig = 1
                                WhileLoop EqualTo(dig, 1) {
                                    IfCondition GreaterEqual(p, j) ThenBlock: { dig = 0 }
                                    IfCondition EqualTo(dig, 1) ThenBlock: {
                                        dch = GetByte(mb, p)
                                        IfCondition LessThan(dch, 48) ThenBlock: { dig = 0 }
                                        IfCondition GreaterThan(dch, 57) ThenBlock: { dig = 0 }
                                        IfCondition EqualTo(dig, 1) ThenBlock: {
                                            note = Add(Multiply(note, 10), Subtract(dch, 48))
                                            p = Add(p, 1)
                                        }
                                    }
                                }
                                IfCondition GreaterThan(note, 127) ThenBlock: { note = 127 }
                                skipsp = 1
                                WhileLoop EqualTo(skipsp, 1) {
                                    IfCondition GreaterEqual(p, j) ThenBlock: { skipsp = 0 }
                                    IfCondition EqualTo(skipsp, 1) ThenBlock: {
                                        IfCondition NotEqual(GetByte(mb, p), 32) ThenBlock: { skipsp = 0 }
                                        IfCondition EqualTo(skipsp, 1) ThenBlock: { p = Add(p, 1) }
                                    }
                                }
                                IfCondition LessThan(p, j) ThenBlock: {
                                    rel = Add(mb, p)
                                    SetByte(mb, j, 0)
                                    fpath = SK_PackPath(rel)
                                    hit = Smp_LoadWav(fpath)
                                    SK_PackPut(sl, note, hit)
                                }
                            }
                        }
                    }
                }
                ln0 = Add(j, 1)
            }
            j = Add(j, 1)
        }
        PrintMessage("pack instruments=")
        PrintNumber(SK.pn)
        PrintMessage("\n")
    }
}

Function.SK_StartInst {
    Input: iid: Integer
    Input: note: Integer
    Input: vel: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        packed = SK_PackGet(iid, note)
        IfCondition NotEqual(packed, 0) ThenBlock: {
            vl = vel
            IfCondition LessThan(vl, 1) ThenBlock: { vl = 1 }
            IfCondition GreaterThan(vl, 127) ThenBlock: { vl = 127 }
            vi = Synth_AllocVoice(SK.syn, note, ch)
            Synth_VoiceOnSample(SK.syn, vi, packed, note, vl)
            vv = Synth_Voice(SK.syn, vi)
            IfCondition NotEqual(vv, 0) ThenBlock: {
                StoreValue(Add(vv, 8), 65536)
                StoreValue(Add(vv, 184), 65536)
            }
            ReturnValue(1)
        }
        IfCondition GreaterThan(SK.pn, 0) ThenBlock: {
            PrintMessage("NOTE_MISS inst=")
            PrintNumber(iid)
            PrintMessage(" note=")
            PrintNumber(note)
            PrintMessage("\n")
            ReturnValue(0)
        }
        nstart = 0
        nth = 0
        have_uni = 0
        WhileLoop LessThan(nth, 16) {
            SF2_SetNth(nth)
            smp = SF2_LookupI(SK.bank, note, vel, iid)
            IfCondition EqualTo(smp, 0) ThenBlock: {
                nth = 16
            } ElseBlock: {
                co = SF2_LastCoarse()
                aco = co
                IfCondition LessThan(aco, 0) ThenBlock: { aco = Subtract(0, aco) }
                skip = 0
                IfCondition EqualTo(have_uni, 1) ThenBlock: {
                    IfCondition GreaterEqual(aco, 3) ThenBlock: { skip = 1 }
                }
                IfCondition EqualTo(skip, 1) ThenBlock: {
                    nth = Add(nth, 1)
                } ElseBlock: {
                    at = SF2_LastAtten()
                    g = 256
                    WhileLoop GreaterEqual(at, 60) {
                        g = Divide(g, 2)
                        at = Subtract(at, 60)
                    }
                    IfCondition EqualTo(g, 0) ThenBlock: {
                        nth = Add(nth, 1)
                    } ElseBlock: {
                        vl = vel
                        IfCondition NotEqual(SK.chvol, 0) ThenBlock: {
                            cv = GetByte(SK.chvol, BitwiseAnd(ch, 15))
                            IfCondition GreaterThan(cv, 0) ThenBlock: {
                                vl = Divide(Multiply(vel, cv), 127)
                            }
                        }
                        vl = Divide(Multiply(vl, g), 256)
                        IfCondition LessThan(vl, 1) ThenBlock: { vl = 1 }
                        IfCondition GreaterThan(vl, 127) ThenBlock: { vl = 127 }
                        vi = Synth_AllocVoice(SK.syn, note, ch)
                        Synth_VoiceOnSample(SK.syn, vi, smp, note, vl)
                        fc = SF2_LastFc()
                        e2 = SF2_LastE2f()
                        playfc = Add(fc, e2)
                        IfCondition LessThan(playfc, 0) ThenBlock: { playfc = 0 }
                        IfCondition GreaterThan(playfc, 13500) ThenBlock: { playfc = 13500 }
                        qq = SF2_LastQ()
                        IfCondition LessThan(qq, 0) ThenBlock: { qq = 0 }
                        IfCondition GreaterThan(qq, 240) ThenBlock: { qq = 240 }
                        Synth_SetFilterCents(SK.syn, vi, playfc, qq)
                        bc = SK_BendCents(ch)
                        IfCondition NotEqual(bc, 0) ThenBlock: {
                            Synth_SetPitchMod(SK.syn, vi, bc)
                        }
                        IfCondition LessThan(aco, 3) ThenBlock: { have_uni = 1 }
                        nstart = Add(nstart, 1)
                        nth = Add(nth, 1)
                    }
                }
            }
        }
        ReturnValue(nstart)
    }
}

Function.SK_StartZones {
    Input: pr: Integer
    Input: sfb: Integer
    Input: note: Integer
    Input: vel: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        iid = Opcode_FromSF2(sfb, pr)
        IfCondition NotEqual(iid, 0) ThenBlock: {
            n0 = SK_StartInst(iid, note, vel, ch)
            IfCondition GreaterThan(n0, 0) ThenBlock: { ReturnValue(n0) }
        }
        nstart = 0
        nth = 0
        WhileLoop LessThan(nth, 16) {
            SF2_SetNth(nth)
            smp = SF2_LookupP(SK.bank, note, vel, pr, sfb)
            IfCondition EqualTo(smp, 0) ThenBlock: {
                nth = 16
            } ElseBlock: {
                at = SF2_LastAtten()
                g = 256
                WhileLoop GreaterEqual(at, 60) {
                    g = Divide(g, 2)
                    at = Subtract(at, 60)
                }
                IfCondition EqualTo(g, 0) ThenBlock: {
                    okd = SK_DbgOk()
                    IfCondition EqualTo(okd, 1) ThenBlock: {
                        PrintMessage("SF DROP_ATTEN ch=")
                        PrintNumber(ch)
                        PrintMessage(" prog=")
                        PrintNumber(pr)
                        PrintMessage(" note=")
                        PrintNumber(note)
                        PrintMessage(" z=")
                        PrintNumber(nth)
                        PrintMessage(" at=")
                        atx = SF2_LastAtten()
                        PrintNumber(atx)
                        PrintMessage("\n")
                        SK.dbg_n = Add(SK.dbg_n, 1)
                    }
                    nth = Add(nth, 1)
                } ElseBlock: {
                    vl = Divide(Multiply(vel, g), 256)
                    IfCondition LessThan(vl, 1) ThenBlock: { vl = 1 }
                    vi = Synth_AllocVoice(SK.syn, note, ch)
                    Synth_VoiceOnSample(SK.syn, vi, smp, note, vl)
                    fc = SF2_LastFc()
                    e2 = SF2_LastE2f()
                    playfc = Add(fc, e2)
                    IfCondition LessThan(playfc, 0) ThenBlock: { playfc = 0 }
                    IfCondition GreaterThan(playfc, 13500) ThenBlock: { playfc = 13500 }
                    qq = SF2_LastQ()
                    IfCondition LessThan(qq, 0) ThenBlock: { qq = 0 }
                    IfCondition GreaterThan(qq, 240) ThenBlock: { qq = 240 }
                    Synth_SetFilterCents(SK.syn, vi, playfc, qq)
                    SK_DbgPlay(ch, pr, note, nth, smp)
                    bc = SK_BendCents(ch)
                    IfCondition NotEqual(bc, 0) ThenBlock: {
                        Synth_SetPitchMod(SK.syn, vi, bc)
                    }
                    nstart = Add(nstart, 1)
                    nth = Add(nth, 1)
                }
            }
        }
        ReturnValue(nstart)
    }
}

Function.SK_NoteOn {
    Input: note: Integer
    Input: vel: Integer
    Input: ch: Integer
    Body: {
        used = 0
        vv = vel
        IfCondition NotEqual(SK.chvol, 0) ThenBlock: {
            cv = GetByte(SK.chvol, BitwiseAnd(ch, 15))
            IfCondition GreaterThan(cv, 0) ThenBlock: {
                vv = Divide(Multiply(vel, cv), 127)
            }
        }
        use_sf = 0
        IfCondition GreaterThan(SK.pn, 0) ThenBlock: { use_sf = 1 }
        IfCondition NotEqual(SK.bank, 0) ThenBlock: {
            IfCondition EqualTo(SK.wave, 8) ThenBlock: { use_sf = 1 }
            IfCondition EqualTo(SK.splay, 1) ThenBlock: { use_sf = 1 }
        }
        IfCondition EqualTo(use_sf, 1) ThenBlock: {
            iid = SK_InstGet(ch)
            IfCondition EqualTo(iid, 0) ThenBlock: {
                pch = BitwiseAnd(ch, 15)
                IfCondition EqualTo(SK.mlock, 0) ThenBlock: {
                    PrintMessage("BIND_MISS track=")
                    PrintNumber(ch)
                    PrintMessage("\n")
                } ElseBlock: {
                    IfCondition EqualTo(GetByte(SK.mlock, pch), 0) ThenBlock: {
                        SetByte(SK.mlock, pch, 1)
                        PrintMessage("BIND_MISS track=")
                        PrintNumber(ch)
                        IfCondition EqualTo(pch, 9) ThenBlock: {
                            PrintMessage(" NO_KIT_NAME")
                        }
                        PrintMessage(" (no InstID)\n")
                    }
                }
            } ElseBlock: {
                nst = SK_StartInst(iid, note, vel, ch)
                IfCondition GreaterThan(nst, 0) ThenBlock: { used = 1 }
                IfCondition EqualTo(nst, 0) ThenBlock: {
                    pch = BitwiseAnd(ch, 15)
                    IfCondition NotEqual(SK.mlock, 0) ThenBlock: {
                        IfCondition EqualTo(GetByte(SK.mlock, pch), 0) ThenBlock: {
                            SetByte(SK.mlock, pch, 2)
                            PrintMessage("BIND_EMPTY track=")
                            PrintNumber(ch)
                            PrintMessage(" inst=")
                            PrintNumber(iid)
                            PrintMessage("\n")
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(used, 0) ThenBlock: {
            IfCondition EqualTo(SK.splay, 1) ThenBlock: { ReturnValue(0) }
            vi = Synth_AllocVoice(SK.syn, note, ch)
            Synth_VoiceOnNote(SK.syn, vi, SK.wave, note, vv)
        }
    }
}

Function.SK_OnPC {
    Input: ch: Integer
    Input: prog: Integer
    Body: {
        IfCondition NotEqual(SK.prog, 0) ThenBlock: {
            SetByte(SK.prog, BitwiseAnd(ch, 15), BitwiseAnd(prog, 127))
        }
        pch = BitwiseAnd(ch, 15)
        IfCondition EqualTo(pch, 9) ThenBlock: { ReturnValue(0) }
        iid = Opcode_FromGM(prog)
        IfCondition NotEqual(iid, 0) ThenBlock: {
            SK_InstSet(ch, iid, 0)
        }
    }
}

Function.SK_MapLine {
    Input: buf: Address
    Input: a: Integer
    Input: b: Integer
    Body: {
        i = a
        WhileLoop LessThan(i, b) {
            c = GetByte(buf, i)
            sp = 0
            IfCondition EqualTo(c, 32) ThenBlock: { sp = 1 }
            IfCondition EqualTo(c, 9) ThenBlock: { sp = 1 }
            IfCondition EqualTo(sp, 0) ThenBlock: { BreakLoop }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(i, b) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, i)
        IfCondition EqualTo(c0, 35) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(c0, 116) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Add(i, 5), b) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 1)), 114) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 2)), 97) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 3)), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 4)), 107) ThenBlock: { ReturnValue(0) }
        i = Add(i, 5)
        WhileLoop LessThan(i, b) {
            c = GetByte(buf, i)
            IfCondition And(NotEqual(c, 32), NotEqual(c, 9)) ThenBlock: { BreakLoop }
            i = Add(i, 1)
        }
        chn = 0
        gotn = 0
        WhileLoop LessThan(i, b) {
            c = GetByte(buf, i)
            IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                chn = Add(Multiply(chn, 10), Subtract(c, 48))
                gotn = 1
                i = Add(i, 1)
            } ElseBlock: {
                BreakLoop
            }
        }
        IfCondition EqualTo(gotn, 0) ThenBlock: { ReturnValue(0) }
        tid = chn
        bind = chn
        j = i
        WhileLoop LessThan(j, Subtract(b, 4)) {
            IfCondition EqualTo(GetByte(buf, j), 115) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, Add(j, 1)), 114) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, Add(j, 2)), 99) ThenBlock: {
                        IfCondition EqualTo(GetByte(buf, Add(j, 3)), 61) ThenBlock: {
                            k = Add(j, 4)
                            WhileLoop LessThan(k, b) {
                                ck = GetByte(buf, k)
                                IfCondition EqualTo(ck, 58) ThenBlock: {
                                    k = Add(k, 1)
                                    mch = 0
                                    gotc = 0
                                    WhileLoop LessThan(k, b) {
                                        dk = GetByte(buf, k)
                                        IfCondition And(GreaterEqual(dk, 48), LessEqual(dk, 57)) ThenBlock: {
                                            mch = Add(Multiply(mch, 10), Subtract(dk, 48))
                                            gotc = 1
                                            k = Add(k, 1)
                                        } ElseBlock: {
                                            BreakLoop
                                        }
                                    }
                                    IfCondition EqualTo(gotc, 1) ThenBlock: {
                                        IfCondition GreaterThan(mch, 0) ThenBlock: {
                                            bind = Subtract(mch, 1)
                                        }
                                    }
                                    k = b
                                }
                                k = Add(k, 1)
                            }
                        }
                    }
                }
            }
            j = Add(j, 1)
        }
        nm = 0
        WhileLoop LessThan(i, Subtract(b, 5)) {
            IfCondition EqualTo(GetByte(buf, i), 105) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, Add(i, 1)), 110) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, Add(i, 2)), 115) ThenBlock: {
                        IfCondition EqualTo(GetByte(buf, Add(i, 3)), 116) ThenBlock: {
                            IfCondition EqualTo(GetByte(buf, Add(i, 4)), 61) ThenBlock: {
                                nm = Add(buf, Add(i, 5))
                                i = b
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(nm, 0) ThenBlock: { ReturnValue(0) }
        e = 0
        WhileLoop LessThan(e, 63) {
            cc = GetByte(nm, e)
            IfCondition EqualTo(cc, 0) ThenBlock: { e = 63 }
            IfCondition EqualTo(cc, 10) ThenBlock: {
                SetByte(nm, e, 0)
                e = 63
            }
            IfCondition EqualTo(cc, 13) ThenBlock: {
                SetByte(nm, e, 0)
                e = 63
            }
            IfCondition EqualTo(cc, 32) ThenBlock: {
                SetByte(nm, e, 0)
                e = 63
            }
            e = Add(e, 1)
        }
        iid = Opcode_Find(nm)
        IfCondition EqualTo(iid, 0) ThenBlock: {
            PrintMessage("songmap unknown ")
            PrintString(nm)
            PrintMessage("\n")
            ReturnValue(0)
        }
        SK_InstSet(bind, iid, 1)
        PrintMessage("songmap track=")
        PrintNumber(tid)
        PrintMessage(" ch=")
        PrintNumber(bind)
        PrintMessage(" inst=")
        PrintNumber(iid)
        PrintMessage(" ")
        PrintString(nm)
        PrintMessage("\n")
    }
}

Function.SK_LoadMap {
    Body: {
        IfCondition EqualTo(SK.spath, 0) ThenBlock: { ReturnValue(0) }
        mpath = Allocate(600)
        MemorySet(mpath, 0, 600)
        i = 0
        WhileLoop LessThan(i, 500) {
            c = GetByte(SK.spath, i)
            IfCondition EqualTo(c, 0) ThenBlock: { i = 500 }
            IfCondition NotEqual(c, 0) ThenBlock: { SetByte(mpath, i, c) }
            i = Add(i, 1)
        }
        n = StringLength(mpath)
        SetByte(mpath, n, 46)
        SetByte(mpath, Add(n, 1), 115)
        SetByte(mpath, Add(n, 2), 111)
        SetByte(mpath, Add(n, 3), 110)
        SetByte(mpath, Add(n, 4), 103)
        SetByte(mpath, Add(n, 5), 109)
        SetByte(mpath, Add(n, 6), 97)
        SetByte(mpath, Add(n, 7), 112)
        SetByte(mpath, Add(n, 8), 0)
        mb = Allocate(4096)
        got = SK_ReadFile(mpath, mb, 4095)
        IfCondition LessThan(got, 4) ThenBlock: {
            Deallocate(mb, 4096)
            Deallocate(mpath, 600)
            ReturnValue(0)
        }
        SetByte(mb, got, 0)
        PrintMessage("songmap ")
        PrintString(mpath)
        PrintMessage("\n")
        ln0 = 0
        j = 0
        WhileLoop LessEqual(j, got) {
            cj = GetByte(mb, j)
            IfCondition Or(EqualTo(cj, 10), EqualTo(j, got)) ThenBlock: {
                IfCondition GreaterThan(j, ln0) ThenBlock: {
                    SK_MapLine(mb, ln0, j)
                }
                ln0 = Add(j, 1)
            }
            j = Add(j, 1)
        }
        Deallocate(mb, 4096)
        Deallocate(mpath, 600)
    }
}

Function.SK_ApplyMidi {
    Body: {
        kind = MIDI_StreamLastKind()
        IfCondition NotEqual(kind, 1) ThenBlock: { ReturnValue(0) }
        st = MIDI_StreamLastStatus()
        hi = BitwiseAnd(st, 240)
        ch = BitwiseAnd(st, 15)
        d1 = MIDI_StreamLastD1()
        d2 = MIDI_StreamLastD2()
        IfCondition EqualTo(hi, 144) ThenBlock: {
            IfCondition EqualTo(d2, 0) ThenBlock: {
                Synth_NoteOff(SK.syn, d1, ch)
            } ElseBlock: {
                SK_NoteOn(d1, d2, ch)
            }
        }
        IfCondition EqualTo(hi, 128) ThenBlock: {
            IfCondition EqualTo(SK.sus, 1) ThenBlock: { ReturnValue(0) }
            Synth_NoteOff(SK.syn, d1, ch)
        }
        IfCondition EqualTo(hi, 176) ThenBlock: { SK_MidiCC(ch, d1, d2) }
        IfCondition EqualTo(hi, 192) ThenBlock: { SK_OnPC(ch, d1) }
        IfCondition EqualTo(hi, 224) ThenBlock: {
            pb = Add(d1, Multiply(d2, 128))
            SK_ApplyBend(ch, pb)
        }
    }
}

Function.SK_PollMidi {
    Body: {
        IfCondition EqualTo(SK.midi, 0) ThenBlock: { ReturnValue(0) }
        w = Dereference(SK.midi)
        r = Dereference(Add(SK.midi, 8))
        cap = Dereference(Add(SK.midi, 16))
        IfCondition EqualTo(cap, 0) ThenBlock: { cap = 4096 }
        data = Add(SK.midi, 32)
        WhileLoop LessThan(r, w) {
            b = GetByte(data, Modulo(r, cap))
            done = MIDI_StreamFeed(b)
            IfCondition EqualTo(done, 1) ThenBlock: { SK_ApplyMidi() }
            r = Add(r, 1)
        }
        StoreValue(Add(SK.midi, 8), r)
    }
}

Function.SK_PcmRate {
    Output: Integer
    Body: {
        IfCondition EqualTo(SK.pcm, 0) ThenBlock: { ReturnValue(48000) }
        r = Dereference(Add(SK.pcm, SKOff.RATE))
        IfCondition LessThan(r, 8000) ThenBlock: { ReturnValue(SK.rate) }
        IfCondition GreaterThan(r, 192000) ThenBlock: { ReturnValue(SK.rate) }
        ReturnValue(r)
    }
}

Function.SK_PcmSpace {
    Output: Integer
    Body: {
        IfCondition EqualTo(SK.pcm, 0) ThenBlock: { ReturnValue(0) }
        cap = Dereference(Add(SK.pcm, SKOff.CAP))
        IfCondition EqualTo(cap, 0) ThenBlock: { cap = SKConst.CAP }
        w = Dereference(Add(SK.pcm, SKOff.WRITE))
        r = Dereference(Add(SK.pcm, SKOff.READ))
        used = Subtract(w, r)
        IfCondition LessThan(used, 0) ThenBlock: { used = 0 }
        IfCondition GreaterThan(used, cap) ThenBlock: { used = cap }
        ReturnValue(Subtract(cap, used))
    }
}

Function.SK_TickFrames {
    Input: tick: Integer
    Output: Integer
    Body: {
        us = MIDI_TickToUS(SK.song, tick)
        rt = SK.rate
        IfCondition LessThan(rt, 8000) ThenBlock: { rt = 48000 }
        ReturnValue(Divide(Multiply(us, rt), 1000000))
    }
}

Function.SK_AllOff {
    Body: {
        n = Synth_VoiceCount(SK.syn)
        i = 0
        WhileLoop LessThan(i, n) {
            Synth_VoiceOff(SK.syn, i)
            i = Add(i, 1)
        }
    }
}

Function.SK_SongApply {
    Input: ev: Address
    Body: {
        kind = MIDI_EvKind(ev)
        IfCondition NotEqual(kind, 1) ThenBlock: { ReturnValue(0) }
        st = MIDI_EvStatus(ev)
        hi = BitwiseAnd(st, 240)
        d1 = MIDI_EvD1(ev)
        d2 = MIDI_EvD2(ev)
        ch = MIDI_EvCh(ev)
        IfCondition EqualTo(hi, 144) ThenBlock: {
            IfCondition EqualTo(d2, 0) ThenBlock: {
                Synth_NoteOff(SK.syn, d1, ch)
            } ElseBlock: {
                SK_NoteOn(d1, d2, ch)
            }
        }
        IfCondition EqualTo(hi, 128) ThenBlock: {
            Synth_NoteOff(SK.syn, d1, ch)
        }
        IfCondition EqualTo(hi, 176) ThenBlock: { SK_MidiCC(ch, d1, d2) }
        IfCondition EqualTo(hi, 192) ThenBlock: { SK_OnPC(ch, d1) }
        IfCondition EqualTo(hi, 224) ThenBlock: {
            pb = Add(d1, Multiply(d2, 128))
            SK_ApplyBend(ch, pb)
        }
    }
}

Function.SK_SongStop {
    Body: {
        SK.splay = 0
        SK_AllOff()
        PrintMessage("song stop\n")
    }
}

Function.SK_SongPlay {
    Body: {
        IfCondition EqualTo(SK.song, 0) ThenBlock: {
            PrintMessage("song play: nothing loaded\n")
            ReturnValue(0)
        }
        SK.sev = 0
        SK.sframe = 0
        SK.splay = 1
        SK_ChanInit()
        SK_LoadMap()
        SK.dbg_n = 0
        SK.st_tick = 0
        SK.st_us = 0
        SK.st_tempo = MIDI_SongTempo(SK.song)
        IfCondition EqualTo(SK.st_tempo, 0) ThenBlock: { SK.st_tempo = 500000 }
        SK.sdiv = MIDI_SongDivision(SK.song)
        IfCondition EqualTo(SK.sdiv, 0) ThenBlock: { SK.sdiv = 480 }
        PrintMessage("song play events=")
        PrintNumber(MIDI_SongCount(SK.song))
        PrintMessage(" tempo=")
        PrintNumber(SK.st_tempo)
        PrintMessage(" div=")
        PrintNumber(SK.sdiv)
        PrintMessage(" clock=")
        PrintNumber(SK.rate)
        PrintMessage(" Hz\n")
    }
}

Function.SK_PollSong {
    Body: {
        n = SK_ReadFile("/dev/shm/synth_app/song.txt", SK.sbuf, 500)
        IfCondition GreaterThan(n, 4) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, n) {
                c = GetByte(SK.sbuf, i)
                IfCondition EqualTo(c, 10) ThenBlock: { SetByte(SK.sbuf, i, 0) }
                IfCondition EqualTo(c, 13) ThenBlock: { SetByte(SK.sbuf, i, 0) }
                i = Add(i, 1)
            }
            SetByte(SK.sbuf, n, 0)
            same = SK_PathSame(SK.sbuf, SK.spath)
            IfCondition EqualTo(same, 0) ThenBlock: {
                i = 0
                WhileLoop LessThan(i, 512) {
                    SetByte(SK.spath, i, GetByte(SK.sbuf, i))
                    i = Add(i, 1)
                }
                SK_AllOff()
                SK.splay = 0
                PrintMessage("song load ")
                PrintString(SK.spath)
                PrintMessage("\n")
                IfCondition NotEqual(SK.song, 0) ThenBlock: {
                    MIDI_SongFree(SK.song)
                    SK.song = 0
                }
                loaded = MIDI_SongLoadPath(SK.spath)
                SK.song = loaded
                IfCondition EqualTo(loaded, 0) ThenBlock: {
                    PrintMessage("song load failed (open/read/parse)\n")
                    SK.send = 0
                } ElseBlock: {
                    cnt = MIDI_SongCount(loaded)
                    err = MIDI_SongErr(loaded)
                    fmt = MIDI_SongFormat(loaded)
                    ntr = MIDI_SongTracks(loaded)
                    last = 0
                    IfCondition GreaterThan(cnt, 0) ThenBlock: {
                        li = Subtract(cnt, 1)
                        ev = MIDI_SongEvent(loaded, li)
                        last = MIDI_EvTick(ev)
                    }
                    SK.send = Add(SK_TickFrames(last), 48000)
                    PrintMessage("  format=")
                    PrintNumber(fmt)
                    PrintMessage(" tracks=")
                    PrintNumber(ntr)
                    PrintMessage(" events=")
                    PrintNumber(cnt)
                    PrintMessage(" err=")
                    PrintNumber(err)
                    PrintMessage(" last_tick=")
                    PrintNumber(last)
                    PrintMessage(" frames=")
                    PrintNumber(SK.send)
                    PrintMessage("\n")
                    SK_LoadMap()
                }
            }
        }
        cn = SK_ReadFile("/dev/shm/synth_app/song_cmd.txt", SK.cbuf, 16)
        IfCondition GreaterThan(cn, 3) ThenBlock: {
            c0 = GetByte(SK.cbuf, 0)
            IfCondition EqualTo(c0, 112) ThenBlock: { SK_SongPlay() }
            IfCondition EqualTo(c0, 115) ThenBlock: { SK_SongStop() }
            fd = SystemCall(SKSys.SYS_OPEN, "/dev/shm/synth_app/song_cmd.txt", 577, 420)
            IfCondition GreaterEqual(fd, 0) ThenBlock: {
                SystemCall(SKSys.SYS_WRITE, fd, "\n", 1)
                SystemCall(SKSys.SYS_CLOSE, fd)
            }
        }
    }
}

Function.SK_SongTick {
    Input: frames: Integer
    Body: {
        IfCondition EqualTo(SK.splay, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SK.song, 0) ThenBlock: { ReturnValue(0) }
        endp = Add(SK.sframe, frames)
        cnt = MIDI_SongCount(SK.song)
        div = SK.sdiv
        IfCondition EqualTo(div, 0) ThenBlock: { div = 480 }
        smpte = BitwiseAnd(div, 32768)
        go = 1
        WhileLoop And(LessThan(SK.sev, cnt), EqualTo(go, 1)) {
            ev = MIDI_SongEvent(SK.song, SK.sev)
            IfCondition EqualTo(ev, 0) ThenBlock: {
                go = 0
            } ElseBlock: {
                tk = MIDI_EvTick(ev)
                dt = Subtract(tk, SK.st_tick)
                IfCondition LessThan(dt, 0) ThenBlock: { dt = 0 }
                us = 0
                IfCondition NotEqual(smpte, 0) ThenBlock: {
                    us = MIDI_TickToUS(SK.song, tk)
                } ElseBlock: {
                    add_us = Divide(Multiply(dt, SK.st_tempo), div)
                    us = Add(SK.st_us, add_us)
                }
                rt = SK.rate
                IfCondition LessThan(rt, 8000) ThenBlock: { rt = 48000 }
                ef = Divide(Multiply(us, rt), 1000000)
                IfCondition GreaterEqual(ef, endp) ThenBlock: {
                    go = 0
                } ElseBlock: {
                    SK.st_tick = tk
                    SK.st_us = us
                    kind = MIDI_EvKind(ev)
                    st = MIDI_EvStatus(ev)
                    IfCondition EqualTo(kind, 2) ThenBlock: {
                        IfCondition EqualTo(st, 81) ThenBlock: {
                            nt = MIDI_EvLen(ev)
                            IfCondition GreaterThan(nt, 0) ThenBlock: { SK.st_tempo = nt }
                        }
                    }
                    SK_SongApply(ev)
                    SK.sev = Add(SK.sev, 1)
                }
            }
        }
        SK.sframe = endp
        IfCondition GreaterThan(SK.sframe, SK.send) ThenBlock: { SK_SongStop() }
    }
}

Function.SK_CmdQuit {
    Output: Integer
    Body: {
        n = SK_ReadFile("/dev/shm/synth_app/cmd.txt", SK.cbuf, 16)
        IfCondition LessThan(n, 4) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(SK.cbuf, 0), 113) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SK_ParseInt {
    Input: buf: Address
    Input: pos: Integer
    Input: lim: Integer
    Output: Integer
    Body: {
        i = pos
        done = 0
        WhileLoop And(LessThan(i, lim), EqualTo(done, 0)) {
            c = GetByte(buf, i)
            sp = 0
            IfCondition EqualTo(c, 32) ThenBlock: { sp = 1 }
            IfCondition EqualTo(c, 10) ThenBlock: { sp = 1 }
            IfCondition EqualTo(c, 9) ThenBlock: { sp = 1 }
            IfCondition EqualTo(sp, 1) ThenBlock: {
                i = Add(i, 1)
            } ElseBlock: {
                done = 1
            }
        }
        IfCondition GreaterEqual(i, lim) ThenBlock: { ReturnValue(0) }
        sign = 1
        IfCondition EqualTo(GetByte(buf, i), 45) ThenBlock: {
            sign = Subtract(0, 1)
            i = Add(i, 1)
        }
        v = 0
        reading = 1
        WhileLoop And(LessThan(i, lim), EqualTo(reading, 1)) {
            c = GetByte(buf, i)
            IfCondition And(GreaterEqual(c, 48), LessThan(c, 58)) ThenBlock: {
                v = Add(Multiply(v, 10), Subtract(c, 48))
                i = Add(i, 1)
            } ElseBlock: {
                reading = 0
            }
        }
        ReturnValue(Multiply(v, sign))
    }
}

Function.SK_NextTok {
    Input: buf: Address
    Input: pos: Integer
    Input: lim: Integer
    Output: Integer
    Body: {
        i = pos
        WhileLoop LessThan(i, lim) {
            c = GetByte(buf, i)
            IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(lim) }
            sp = 0
            IfCondition EqualTo(c, 32) ThenBlock: { sp = 1 }
            IfCondition EqualTo(c, 10) ThenBlock: { sp = 1 }
            IfCondition EqualTo(c, 9) ThenBlock: { sp = 1 }
            IfCondition EqualTo(sp, 1) ThenBlock: { ReturnValue(Add(i, 1)) }
            i = Add(i, 1)
        }
        ReturnValue(lim)
    }
}

Function.SK_PollCtl {
    Body: {
        n = SK_ReadFile("/dev/shm/synth_app/ctl.txt", SK.cbuf, 512)
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        buf = SK.cbuf
        lim = n
        p = 0
        SK.wave = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.cutoff = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.res = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.delayms = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.fb = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.wet = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.vol = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.atk = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.dec = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.rel = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.oct = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.pw = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.detune = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.fenv = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.lforate = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.lfopwm = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.submix = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.drive = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.wave2 = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.oscmix = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.o2oct = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.suslvl = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.lfofilt = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.lfoamp = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        parsed_mod = SK_ParseInt(buf, p, lim)
        IfCondition EqualTo(SK.mod_midi, 0) ThenBlock: { SK.mod = parsed_mod }
        p = SK_NextTok(buf, p, lim)
        SK.md0 = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.ma0 = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.md1 = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.ma1 = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.md2 = SK_ParseInt(buf, p, lim)
        p = SK_NextTok(buf, p, lim)
        SK.ma2 = SK_ParseInt(buf, p, lim)
        IfCondition EqualTo(SK.pw, 0) ThenBlock: { SK.pw = 64 }
        IfCondition LessThan(SK.wave, 0) ThenBlock: { SK.wave = 0 }
        IfCondition GreaterThan(SK.wave, 8) ThenBlock: { SK.wave = 8 }
        IfCondition LessThan(SK.wave2, 0) ThenBlock: { SK.wave2 = 0 }
        IfCondition GreaterThan(SK.wave2, 8) ThenBlock: { SK.wave2 = 8 }
        IfCondition LessThan(SK.oscmix, 0) ThenBlock: { SK.oscmix = 0 }
        IfCondition GreaterThan(SK.oscmix, 256) ThenBlock: { SK.oscmix = 256 }
        IfCondition LessThan(SK.o2oct, 0) ThenBlock: { SK.o2oct = 0 }
        IfCondition GreaterThan(SK.o2oct, 4) ThenBlock: { SK.o2oct = 4 }
        IfCondition LessThan(SK.suslvl, 0) ThenBlock: { SK.suslvl = 0 }
        IfCondition GreaterThan(SK.suslvl, 256) ThenBlock: { SK.suslvl = 256 }
        IfCondition LessThan(SK.oct, 0) ThenBlock: { SK.oct = 0 }
        IfCondition GreaterThan(SK.oct, 4) ThenBlock: { SK.oct = 4 }
        cut = SK_Clamp(Add(SK.cutoff, SK_ModAmt(1)), 0, 256)
        rs = SK_Clamp(Add(SK.res, SK_ModAmt(2)), 0, 240)
        pit = SK_ModAmt(3)
        lfd = SK_Clamp(Add(SK.lfopwm, SK_ModAmt(4)), 0, 256)
        pww = SK_Clamp(Add(SK.pw, SK_ModAmt(5)), 8, 248)
        drv = SK_Clamp(Add(SK.drive, SK_ModAmt(6)), 0, 256)
        amp = SK_Clamp(Add(SK.vol, SK_ModAmt(7)), 0, 512)
        dly = SK_Clamp(Add(SK.wet, SK_ModAmt(8)), 0, 256)
        fev = SK_Clamp(Add(SK.fenv, SK_ModAmt(9)), 0, 256)
        sub = SK_Clamp(Add(SK.submix, SK_ModAmt(10)), 0, 256)
        n = Synth_VoiceCount(SK.syn)
        i = 0
        WhileLoop LessThan(i, n) {
            vv = Synth_Voice(SK.syn, i)
            wv = 0
            IfCondition NotEqual(vv, 0) ThenBlock: { wv = GetByte(vv, 16) }
            IfCondition EqualTo(wv, 8) ThenBlock: {
                i = i
            } ElseBlock: {
                Synth_SetADSR(SK.syn, i, SK.atk, SK.dec, SK.suslvl, SK.rel)
                Synth_SetFilter(SK.syn, i, cut, rs)
                Synth_SetWave(SK.syn, i, SK.wave)
                Synth_SetOsc2(SK.syn, i, SK.wave2, SK.oscmix, SK.o2oct)
                Synth_SetPulse(SK.syn, i, pww)
                Synth_SetDetune(SK.syn, i, SK.detune)
                Synth_SetPitchMod(SK.syn, i, pit)
                Synth_SetFenv(SK.syn, i, fev)
                Synth_SetLFO(SK.syn, i, SK.lforate, lfd)
                Synth_SetLFOTaps(SK.syn, i, SK.lfofilt, SK.lfoamp)
                Synth_SetSub(SK.syn, i, sub)
                Synth_SetDrive(SK.syn, i, drv)
            }
            i = Add(i, 1)
        }
        Synth_SetDelay(SK.syn, SK.delayms, SK.fb, dly)
        Synth_SetMixGain(SK.syn, amp)
    }
}

Function.SK_ModAmt {
    Input: dest: Integer
    Output: Integer
    Body: {
        a = 0
        IfCondition EqualTo(SK.md0, dest) ThenBlock: {
            a = Add(a, Divide(Multiply(SK.mod, SK.ma0), 256))
        }
        IfCondition EqualTo(SK.md1, dest) ThenBlock: {
            a = Add(a, Divide(Multiply(SK.mod, SK.ma1), 256))
        }
        IfCondition EqualTo(SK.md2, dest) ThenBlock: {
            a = Add(a, Divide(Multiply(SK.mod, SK.ma2), 256))
        }
        ReturnValue(a)
    }
}

Function.SK_Clamp {
    Input: x: Integer
    Input: lo: Integer
    Input: hi: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(x, lo) ThenBlock: { ReturnValue(lo) }
        IfCondition GreaterThan(x, hi) ThenBlock: { ReturnValue(hi) }
        ReturnValue(x)
    }
}

Function.SK_MidiOf {
    Input: slot: Integer
    Output: Integer
    Body: {
        n = 60
        IfCondition EqualTo(slot, 1) ThenBlock: { n = 62 }
        IfCondition EqualTo(slot, 2) ThenBlock: { n = 64 }
        IfCondition EqualTo(slot, 3) ThenBlock: { n = 65 }
        IfCondition EqualTo(slot, 4) ThenBlock: { n = 67 }
        IfCondition EqualTo(slot, 5) ThenBlock: { n = 69 }
        IfCondition EqualTo(slot, 6) ThenBlock: { n = 71 }
        oct = Subtract(SK.oct, 2)
        ReturnValue(Add(n, Multiply(oct, 12)))
    }
}

Function.SK_KeyNow {
    Input: slot: Integer
    Output: Integer
    Body: {
        c = GetByte(SK.kbuf, slot)
        IfCondition EqualTo(c, 49) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SK_PrevGet {
    Input: slot: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(slot, 0) ThenBlock: { ReturnValue(SK.p0) }
        IfCondition EqualTo(slot, 1) ThenBlock: { ReturnValue(SK.p1) }
        IfCondition EqualTo(slot, 2) ThenBlock: { ReturnValue(SK.p2) }
        IfCondition EqualTo(slot, 3) ThenBlock: { ReturnValue(SK.p3) }
        IfCondition EqualTo(slot, 4) ThenBlock: { ReturnValue(SK.p4) }
        IfCondition EqualTo(slot, 5) ThenBlock: { ReturnValue(SK.p5) }
        ReturnValue(SK.p6)
    }
}

Function.SK_PrevSet {
    Input: slot: Integer
    Input: v: Integer
    Body: {
        IfCondition EqualTo(slot, 0) ThenBlock: { SK.p0 = v }
        IfCondition EqualTo(slot, 1) ThenBlock: { SK.p1 = v }
        IfCondition EqualTo(slot, 2) ThenBlock: { SK.p2 = v }
        IfCondition EqualTo(slot, 3) ThenBlock: { SK.p3 = v }
        IfCondition EqualTo(slot, 4) ThenBlock: { SK.p4 = v }
        IfCondition EqualTo(slot, 5) ThenBlock: { SK.p5 = v }
        IfCondition EqualTo(slot, 6) ThenBlock: { SK.p6 = v }
    }
}

Function.SK_PedGet {
    Input: slot: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(slot, 0) ThenBlock: { ReturnValue(SK.ped0) }
        IfCondition EqualTo(slot, 1) ThenBlock: { ReturnValue(SK.ped1) }
        IfCondition EqualTo(slot, 2) ThenBlock: { ReturnValue(SK.ped2) }
        IfCondition EqualTo(slot, 3) ThenBlock: { ReturnValue(SK.ped3) }
        IfCondition EqualTo(slot, 4) ThenBlock: { ReturnValue(SK.ped4) }
        IfCondition EqualTo(slot, 5) ThenBlock: { ReturnValue(SK.ped5) }
        ReturnValue(SK.ped6)
    }
}

Function.SK_PedSet {
    Input: slot: Integer
    Input: v: Integer
    Body: {
        IfCondition EqualTo(slot, 0) ThenBlock: { SK.ped0 = v }
        IfCondition EqualTo(slot, 1) ThenBlock: { SK.ped1 = v }
        IfCondition EqualTo(slot, 2) ThenBlock: { SK.ped2 = v }
        IfCondition EqualTo(slot, 3) ThenBlock: { SK.ped3 = v }
        IfCondition EqualTo(slot, 4) ThenBlock: { SK.ped4 = v }
        IfCondition EqualTo(slot, 5) ThenBlock: { SK.ped5 = v }
        IfCondition EqualTo(slot, 6) ThenBlock: { SK.ped6 = v }
    }
}

Function.SK_PollKeys {
    Body: {
        n = SK_ReadFile("/dev/shm/synth_app/keys.txt", SK.kbuf, 16)
        IfCondition LessThan(n, 7) ThenBlock: { ReturnValue(0) }
        SK.sus = 0
        IfCondition GreaterThan(n, 7) ThenBlock: {
            IfCondition EqualTo(GetByte(SK.kbuf, 7), 49) ThenBlock: { SK.sus = 1 }
        }
        i = 0
        WhileLoop LessThan(i, 7) {
            now = SK_KeyNow(i)
            was = SK_PrevGet(i)
            IfCondition And(EqualTo(was, 0), EqualTo(now, 1)) ThenBlock: {
                note = SK_MidiOf(i)
                SK_NoteOn(note, 100, 0)
                SK_PedSet(i, 0)
            }
            IfCondition And(EqualTo(was, 1), EqualTo(now, 0)) ThenBlock: {
                IfCondition EqualTo(SK.sus, 1) ThenBlock: {
                    SK_PedSet(i, 1)
                } ElseBlock: {
                    note = SK_MidiOf(i)
                    Synth_NoteOff(SK.syn, note, 0)
                    SK_PedSet(i, 0)
                }
            }
            SK_PrevSet(i, now)
            i = Add(i, 1)
        }
        IfCondition And(EqualTo(SK.psus, 1), EqualTo(SK.sus, 0)) ThenBlock: {
            j = 0
            WhileLoop LessThan(j, 7) {
                IfCondition EqualTo(SK_PedGet(j), 1) ThenBlock: {
                    IfCondition EqualTo(SK_KeyNow(j), 0) ThenBlock: {
                        note = SK_MidiOf(j)
                        Synth_NoteOff(SK.syn, note, 0)
                    }
                    SK_PedSet(j, 0)
                }
                j = Add(j, 1)
            }
        }
        SK.psus = SK.sus
    }
}

Function.SK_PushPcm {
    Input: frames: Integer
    Output: Integer
    Body: {
        pcm = SK.pcm
        cap = Dereference(Add(pcm, SKOff.CAP))
        w = Dereference(Add(pcm, SKOff.WRITE))
        r = Dereference(Add(pcm, SKOff.READ))
        used = Subtract(w, r)
        IfCondition LessThan(used, 0) ThenBlock: { used = 0 }
        space = Subtract(cap, used)
        IfCondition LessThan(space, frames) ThenBlock: { ReturnValue(0) }
        nbytes = Multiply(frames, 4)
        IfCondition EqualTo(SK.rbuf, 0) ThenBlock: {
            SK.rbuf = Allocate(4096)
        }
        tmp = SK.rbuf
        Synth_RenderS16Stereo(SK.syn, tmp, frames)
        data = Add(pcm, SKOff.DATA)
        wslot = Modulo(w, cap)
        n1 = Subtract(cap, wslot)
        IfCondition GreaterThan(n1, frames) ThenBlock: { n1 = frames }
        b1 = Multiply(n1, 4)
        dst = Add(data, Multiply(wslot, 4))
        MemoryCopy(dst, tmp, b1)
        IfCondition LessThan(n1, frames) ThenBlock: {
            n2 = Subtract(frames, n1)
            src2 = Add(tmp, b1)
            MemoryCopy(data, src2, Multiply(n2, 4))
        }
        StoreValue(Add(pcm, SKOff.WRITE), Add(w, frames))
        ReturnValue(1)
    }
}

SubRoutine.Main {
    Arena_Init()
    PrintMessage("synthkit kernel /dev/shm/synth_app\n")
    SK_Ensure()
    SK.kbuf = Allocate(32)
    SK.cbuf = Allocate(512)
    SK.bbuf = Allocate(512)
    SK.bpath = Allocate(512)
    MemorySet(SK.bpath, 0, 512)
    SK.sbuf = Allocate(512)
    SK.spath = Allocate(512)
    MemorySet(SK.spath, 0, 512)
    SK.ts = Allocate(16)
    SK_ChanInit()
    SK.pcm = SK_OpenPcm()
    IfCondition EqualTo(SK.pcm, 0) ThenBlock: {
        PrintMessage("pcm mmap failed\n")
        SystemCall(SKSys.SYS_EXIT, 1)
    }
    SK.syn = Synth_New(SKConst.VOICES, 48000)
    nv = Synth_VoiceCount(SK.syn)
    PrintMessage("voices=")
    PrintNumber(nv)
    PrintMessage("\n")
    MIDI_StreamInit()
    SK.midi = SK_OpenMidi()
    smp = Smp_LoadWav("/home/bob/Ailang-Self-Hosting-/tests/sample/sine_c4.wav")
    IfCondition EqualTo(smp, 0) ThenBlock: {
        smp = Smp_LoadWav("../../tests/sample/sine_c4.wav")
    }
    IfCondition NotEqual(smp, 0) ThenBlock: {
        Smp_SetLoop(smp, 0, Dereference(Add(smp, 16)), 1)
        Synth_SetBankSample(SK.syn, smp)
        PrintMessage("sample bank loaded\n")
    }
    Opcode_LoadJson("/dev/shm/synth_app/opcode16.json")
    Opcode_LoadJson("/home/bob/Ailang-Self-Hosting-/Librarys/Media/opcode16.json")
    SK_PackLoad()
    SK_PollCtl()
    IfCondition EqualTo(SK.pn, 0) ThenBlock: {
        SK_PollBank()
    } ElseBlock: {
        PrintMessage("pack live — SF2 bank skipped\n")
    }
    SK.run = 1
    tick = 0
    WhileLoop EqualTo(SK.run, 1) {
        IfCondition EqualTo(SK_CmdQuit(), 1) ThenBlock: { SK.run = 0 }
        hw = SK_PcmRate()
        IfCondition NotEqual(hw, SK.rate) ThenBlock: {
            SK.rate = hw
            PrintMessage("pcm clock ")
            PrintNumber(SK.rate)
            PrintMessage(" Hz (sound card playhead)\n")
        }
        tick = Add(tick, 1)
        IfCondition EqualTo(Modulo(tick, 16), 0) ThenBlock: { SK_PollCtl() }
        IfCondition EqualTo(Modulo(tick, 16), 0) ThenBlock: {
            IfCondition EqualTo(SK.splay, 0) ThenBlock: {
                IfCondition EqualTo(SK.pn, 0) ThenBlock: { SK_PollBank() }
            }
            SK_PollSong()
        }
        SK_PollMidi()
        SK_PollKeys()
        space = SK_PcmSpace()
        burst = 0
        go = 1
        WhileLoop EqualTo(go, 1) {
            IfCondition LessThan(space, SKConst.PERIOD) ThenBlock: { go = 0 }
            IfCondition GreaterEqual(burst, 8) ThenBlock: { go = 0 }
            IfCondition EqualTo(go, 1) ThenBlock: {
                SK_SongTick(SKConst.PERIOD)
                ok = SK_PushPcm(SKConst.PERIOD)
                IfCondition EqualTo(ok, 0) ThenBlock: {
                    go = 0
                } ElseBlock: {
                    burst = Add(burst, 1)
                    space = SK_PcmSpace()
                }
            }
        }
        IfCondition EqualTo(burst, 0) ThenBlock: { SK_SleepMs(1) }
    }
    Synth_Free(SK.syn)
    PrintMessage("synthkit stop\n")
}

RunTask(Main)
