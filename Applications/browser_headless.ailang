// browser_headless.ailang — Headless HTML renderer for visual testing
//
// Reads HTML from /tmp/render_test.html
// Renders to an in-memory framebuffer (1024x700, BGRA)
// Writes output as PPM to /tmp/render_out.ppm
//
// Usage: ./browser_headless.x
//        (Python runner writes HTML to /tmp/render_test.html first)
//
// Build: ./ailang.x Applications/browser_headless.ailang browser_headless.x
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.TermFont
LibraryImport.Browser.HTMLTokenizer
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayout
LibraryImport.Browser.HTMLRender

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.HLConst {
    "WIDTH":      Initialize=1024
    "HEIGHT":     Initialize=700
    "BUF_SIZE":   Initialize=2867200   // 1024 * 700 * 4 (BGRA)
    "MAX_HTML":   Initialize=1048576   // 1 MB max input
    // Syscall numbers (x86-64)
    "SYS_READ":   Initialize=0
    "SYS_WRITE":  Initialize=1
    "SYS_OPEN":   Initialize=2
    "SYS_CLOSE":  Initialize=3
    "SYS_EXIT":   Initialize=60
    // Open flags
    "O_RDONLY":   Initialize=0
    "O_WRONLY":   Initialize=1
    "O_CREAT":    Initialize=64
    "O_TRUNC":    Initialize=512
}

FixedPool.HLState {
    "html_buf":   Initialize=0
    "html_len":   Initialize=0
    "canvas":     Initialize=0
    "ppm_hdr":    Initialize=0
}

// =============================================================================
// READ FILE — read entire file into buffer
// =============================================================================
Function.HL_ReadFile {
    Input: path: Address
    Output: Integer
    Body: {
        fd = SystemCall(HLConst.SYS_OPEN, path, HLConst.O_RDONLY, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[Headless] Cannot open input file\n")
            ReturnValue(-1)
        }

        HLState.html_buf = Allocate(HLConst.MAX_HTML)
        total = 0
        rd_done = 0
        WhileLoop EqualTo(rd_done, 0) {
            remain = Subtract(HLConst.MAX_HTML, total)
            IfCondition LessEqual(remain, 0) ThenBlock: {
                rd_done = 1
            } ElseBlock: {
                chunk = remain
                IfCondition GreaterThan(chunk, 65536) ThenBlock: { chunk = 65536 }
                n = SystemCall(HLConst.SYS_READ, fd, Add(HLState.html_buf, total), chunk)
                IfCondition LessEqual(n, 0) ThenBlock: {
                    rd_done = 1
                } ElseBlock: {
                    total = Add(total, n)
                }
            }
        }
        SystemCall(HLConst.SYS_CLOSE, fd)
        HLState.html_len = total
        ReturnValue(total)
    }
}

// =============================================================================
// WRITE PPM — convert BGRA buffer to PPM and write to file
// PPM format: "P6\n<w> <h>\n255\n" followed by RGB bytes
// =============================================================================
Function.HL_WritePPM {
    Input: path: Address
    Output: Integer
    Body: {
        // Create/truncate output file
        flags = Add(HLConst.O_WRONLY, Add(HLConst.O_CREAT, HLConst.O_TRUNC))
        fd = SystemCall(HLConst.SYS_OPEN, path, flags, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[Headless] Cannot open output file\n")
            ReturnValue(-1)
        }

        // Write PPM header: "P6\n1024 700\n255\n" (16 bytes)
        hdr = "P6\n1024 700\n255\n"
        hdr_len = 16
        SystemCall(HLConst.SYS_WRITE, fd, hdr, hdr_len)

        // Convert BGRA to RGB and write in chunks
        // Allocate a row-sized RGB buffer (1024 * 3 = 3072 bytes)
        row_buf = Allocate(3072)
        row = 0
        WhileLoop LessThan(row, HLConst.HEIGHT) {
            col = 0
            row_off = Multiply(row, Multiply(HLConst.WIDTH, 4))
            WhileLoop LessThan(col, HLConst.WIDTH) {
                pix_off = Add(row_off, Multiply(col, 4))
                // BGRA layout: B at +0, G at +1, R at +2, A at +3
                b_val = GetByte(HLState.canvas, pix_off)
                g_val = GetByte(HLState.canvas, Add(pix_off, 1))
                r_val = GetByte(HLState.canvas, Add(pix_off, 2))
                // Write as RGB
                rgb_off = Multiply(col, 3)
                SetByte(row_buf, rgb_off, r_val)
                SetByte(row_buf, Add(rgb_off, 1), g_val)
                SetByte(row_buf, Add(rgb_off, 2), b_val)
                col = Add(col, 1)
            }
            SystemCall(HLConst.SYS_WRITE, fd, row_buf, 3072)
            row = Add(row, 1)
        }

        SystemCall(HLConst.SYS_CLOSE, fd)
        ReturnValue(0)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()

    // Init libraries
    HTK_Init()
    DOM_Init()
    CSS_Init()
    TermFont_Init()

    // Allocate framebuffer
    HLState.canvas = Allocate(HLConst.BUF_SIZE)
    MemorySet(HLState.canvas, 0, HLConst.BUF_SIZE)

    // Read input HTML
    rlen = HL_ReadFile("/tmp/render_test.html")
    IfCondition LessEqual(rlen, 0) ThenBlock: {
        PrintMessage("[Headless] No input or read failed\n")
        SystemCall(HLConst.SYS_EXIT, 1)
    }

    PrintMessage("[Headless] Read ")
    PrintNumber(HLState.html_len)
    PrintMessage(" bytes\n")

    // Tokenize
    tok_count = HTK_Tokenize(HLState.html_buf, HLState.html_len)
    PrintMessage("[Headless] Tokens: ")
    PrintNumber(tok_count)
    PrintMessage("\n")

    // Build DOM
    dom_root = DOM_ParseString(HLState.html_buf, HLState.html_len)
    IfCondition LessThan(dom_root, 0) ThenBlock: {
        PrintMessage("[Headless] DOM parse failed\n")
        SystemCall(HLConst.SYS_EXIT, 1)
    }
    PrintMessage("[Headless] DOM nodes: ")
    PrintNumber(DOM_NodeCount())
    PrintMessage("\n")

    // Parse CSS from <style> blocks
    style_node = DOM_FindByTag(dom_root, "style")
    IfCondition GreaterEqual(style_node, 0) ThenBlock: {
        style_text = DOM_GetText(style_node)
        IfCondition NotEqual(style_text, 0) ThenBlock: {
            style_len = StringLength(style_text)
            css_count = CSS_ParseSheet(style_text, style_len)
            PrintMessage("[Headless] CSS rules: ")
            PrintNumber(css_count)
            PrintMessage("\n")
        }
    }

    // Layout
    LYState.show_noscript = 0
    Layout_Init()
    Layout_SetViewport(HLConst.WIDTH, HLConst.HEIGHT)
    cmd_count = Layout_Run(dom_root)

    // Noscript fallback if zero commands
    IfCondition EqualTo(cmd_count, 0) ThenBlock: {
        PrintMessage("[Headless] Zero commands — enabling noscript fallback\n")
        LYState.show_noscript = 1
        Layout_Init()
        Layout_SetViewport(HLConst.WIDTH, HLConst.HEIGHT)
        cmd_count = Layout_Run(dom_root)
    }
    PrintMessage("[Headless] Draw commands: ")
    PrintNumber(cmd_count)
    PrintMessage("\n")

    // Dump hit regions
    PrintMessage("[Headless] Hit regions: ")
    PrintNumber(Layout_HitCount())
    PrintMessage("\n")
    dbg_hi = 0
    WhileLoop LessThan(dbg_hi, Layout_HitCount()) {
        dbg_off = Multiply(dbg_hi, LYHit.REGION_SIZE)
        dbg_base = Add(LYState.hit_pool, dbg_off)
        PrintMessage("  [")
        PrintNumber(dbg_hi)
        PrintMessage("] x=")
        PrintNumber(Dereference(Add(dbg_base, LYHit.H_X)))
        PrintMessage(" y=")
        PrintNumber(Dereference(Add(dbg_base, LYHit.H_Y)))
        PrintMessage(" w=")
        PrintNumber(Dereference(Add(dbg_base, LYHit.H_W)))
        PrintMessage(" h=")
        PrintNumber(Dereference(Add(dbg_base, LYHit.H_H)))
        PrintMessage(" type=")
        PrintNumber(Dereference(Add(dbg_base, LYHit.H_TYPE)))
        PrintMessage("\n")
        dbg_hi = Add(dbg_hi, 1)
    }

    // Render to canvas
    Render_Init()
    Render_SetTarget(HLState.canvas, HLConst.WIDTH, HLConst.HEIGHT)
    Render_Clear(0xFFF0F0F2)
    Render_Exec()

    // Write PPM output
    HL_WritePPM("/tmp/render_out.ppm")
    PrintMessage("[Headless] Written /tmp/render_out.ppm\n")

    SystemCall(HLConst.SYS_EXIT, 0)
}

RunTask(Main)
