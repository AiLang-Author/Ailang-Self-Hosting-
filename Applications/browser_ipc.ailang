// browser_ipc.ailang — Pure Ailang Browser (IPC client)
//
// Fetches a URL, parses HTML, builds DOM, resolves CSS, lays out blocks,
// renders to ShmCanvas, and presents in the display server window.
//
// No C++. No runtime. No GC. Direct-to-assembly.
//
// Build: ./ailang.x Applications/browser_ipc.ailang browser_ipc.x
// Run:   ./browser_ipc.x  (after SysDisplay.x is running)
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Socket
LibraryImport.JSON
LibraryImport.ShmCanvas
LibraryImport.Browser.URL
LibraryImport.Browser.DNS
LibraryImport.Browser.HTTPClient
LibraryImport.Browser.HTMLTokenizer
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayout
LibraryImport.Browser.HTMLRender
LibraryImport.Browser.JSLexer
LibraryImport.Browser.JSParser
LibraryImport.Browser.JSCompiler
LibraryImport.Browser.JSRuntime
LibraryImport.Browser.JSVM
LibraryImport.Browser.JSBridge
LibraryImport.Browser.JSEngine

// =============================================================================
// SYSCALL CONSTANTS
// =============================================================================
FixedPool.BrSys {
    "SYS_NANOSLEEP": Initialize=35
}

// =============================================================================
// STATE
// =============================================================================
FixedPool.BrState {
    "running":    Initialize=1
    "sock":       Initialize=0
    "win_id":     Initialize=0
    "canvas_w":   Initialize=1024
    "canvas_h":   Initialize=700
    "canvas_buf": Initialize=0
    "ts_tick":    Initialize=0
    "cur_url":    Initialize=0
    "cur_url_len": Initialize=0
    "scroll_y":   Initialize=0
    "content_h":  Initialize=0
}

// =============================================================================
// MOUSE EVENT TEMPORARIES (clobber-safe)
// =============================================================================
FixedPool.BrMouse {
    "x":       Initialize=0
    "y":       Initialize=0
    "event":   Initialize=0
    "button":  Initialize=0
    "hit_idx": Initialize=0
    "hit_type": Initialize=0
    "hit_node": Initialize=0
    "mobj":    Initialize=0
}

// =============================================================================
// HOVER STATE — tracks currently hovered DOM node for :hover CSS
// =============================================================================
FixedPool.BrHover {
    "node":  Initialize=-1    // currently hovered DOM node (-1 = none)
    "prev":  Initialize=-1    // previous hover node (for change detection)
}

// =============================================================================
// KEYBOARD / FOCUS STATE (clobber-safe)
// =============================================================================
FixedPool.BrFocus {
    "node":      Initialize=-1    // focused DOM node index (-1 = none)
    "input_buf": Initialize=0     // buffer for typed text (256 bytes)
    "input_len": Initialize=0     // current length of typed text
    "input_max": Initialize=255   // max input length
}

// =============================================================================
// FORM SUBMISSION TEMPORARIES
// =============================================================================
FixedPool.BrForm {
    "query_buf": Initialize=0     // buffer for building query string (2048 bytes)
    "query_len": Initialize=0
    "form_node": Initialize=-1    // <form> ancestor node
    "child":     Initialize=0
    "name_ptr":  Initialize=0
    "val_ptr":   Initialize=0
    "fi":        Initialize=0     // loop index (clobber-safe)
    "fi_count":  Initialize=0     // total DOM node count
    "fi_skip":   Initialize=0     // skip flag for submit/button types
    "first_p":   Initialize=1     // first param flag
}

// =============================================================================
// URL HISTORY — simple back/forward stack
// =============================================================================
FixedPool.BrHistConst {
    "MAX_ENTRIES": Initialize=64
    "ENTRY_SIZE":  Initialize=16
}

FixedPool.BrHist {
    "pool":    Initialize=0
    "count":   Initialize=0
    "pos":     Initialize=0
}

// =============================================================================
// FILE-BASED DIAGNOSTICS — write to /tmp/browser_diag.log
// =============================================================================
FixedPool.BrLog {
    "fd":     Initialize=-1
    "buf":    Initialize=0
}

Function.BrLog_Init {
    Body: {
        BrLog.buf = Allocate(512)
        // open("/tmp/browser_diag.log", O_WRONLY|O_CREAT|O_TRUNC, 0666)
        // O_WRONLY=1, O_CREAT=64, O_TRUNC=512 → 1|64|512 = 577
        BrLog.fd = SystemCall(2, "/tmp/browser_diag.log", 577, 438)
    }
}

Function.BrLog_Write {
    Input: msg: Address
    Body: {
        IfCondition LessThan(BrLog.fd, 0) ThenBlock: { ReturnValue(0) }
        mlen = StringLength(msg)
        IfCondition GreaterThan(mlen, 0) ThenBlock: {
            SystemCall(1, BrLog.fd, msg, mlen)
        }
    }
}

Function.BrLog_WriteNum {
    Input: msg: Address
    Input: num: Integer
    Body: {
        BrLog_Write(msg)
        // Convert number to string in BrLog.buf
        IfCondition LessThan(BrLog.fd, 0) ThenBlock: { ReturnValue(0) }
        // Simple number-to-ascii in buffer
        IfCondition EqualTo(num, 0) ThenBlock: {
            SetByte(BrLog.buf, 0, 48)
            SetByte(BrLog.buf, 1, 10)
            SystemCall(1, BrLog.fd, BrLog.buf, 2)
            ReturnValue(0)
        }
        neg = 0
        val = num
        IfCondition LessThan(val, 0) ThenBlock: {
            neg = 1
            val = Subtract(0, val)
        }
        // Write digits in reverse
        dpos = 20
        WhileLoop GreaterThan(val, 0) {
            dpos = Subtract(dpos, 1)
            digit = Modulo(val, 10)
            SetByte(BrLog.buf, dpos, Add(48, digit))
            val = Divide(val, 10)
        }
        IfCondition EqualTo(neg, 1) ThenBlock: {
            dpos = Subtract(dpos, 1)
            SetByte(BrLog.buf, dpos, 45)
        }
        SetByte(BrLog.buf, 20, 10)
        dlen = Subtract(21, dpos)
        SystemCall(1, BrLog.fd, Add(BrLog.buf, dpos), dlen)
    }
}

// =============================================================================
// HEADLESS MODE — ./browser_ipc.x --headless /path/input.html /path/output.ppm
// =============================================================================
FixedPool.BrHeadless {
    "enabled":   Initialize=0
    "in_path":   Initialize=0
    "out_path":  Initialize=0
    "html_buf":  Initialize=0
    "html_len":  Initialize=0
    "MAX_HTML":  Initialize=2097152
}

Function.BrHeadless_DetectFlag {
    Output: Integer
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }

        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }

        // Walk NUL-terminated args: argv[0]=binary, then scan for --headless
        pos = 0
        arg_idx = 0
        WhileLoop LessThan(pos, bytes_read) {
            IfCondition EqualTo(GetByte(buffer, pos), 0) ThenBlock: {
                pos = Add(pos, 1)
            } ElseBlock: {
                arg_ptr = Add(buffer, pos)
                IfCondition EqualTo(StringCompare(arg_ptr, "--headless"), 0) ThenBlock: {
                    BrHeadless.enabled = 1
                }
                // argv after --headless: first is input, second is output
                IfCondition EqualTo(arg_idx, 2) ThenBlock: {
                    BrHeadless.in_path = Allocate(512)
                    MemoryCopy(BrHeadless.in_path, arg_ptr, Add(StringLength(arg_ptr), 1))
                }
                IfCondition EqualTo(arg_idx, 3) ThenBlock: {
                    BrHeadless.out_path = Allocate(512)
                    MemoryCopy(BrHeadless.out_path, arg_ptr, Add(StringLength(arg_ptr), 1))
                }
                // Advance past this arg
                WhileLoop And(LessThan(pos, bytes_read), NotEqual(GetByte(buffer, pos), 0)) {
                    pos = Add(pos, 1)
                }
                arg_idx = Add(arg_idx, 1)
            }
        }

        Deallocate(buffer, 4096)
        ReturnValue(BrHeadless.enabled)
    }
}

// Read stdin for input/output paths (fallback for piped usage)
Function.BrHeadless_ReadStdin {
    Body: {
        in_buf = Allocate(512)
        MemorySet(in_buf, 0, 512)
        // Read one line from stdin
        rpos = 0
        reading = 1
        WhileLoop EqualTo(reading, 1) {
            IfCondition GreaterEqual(rpos, 510) ThenBlock: { reading = 0 }
            IfCondition EqualTo(reading, 1) ThenBlock: {
                n = SystemCall(0, 0, Add(in_buf, rpos), 1)
                IfCondition LessEqual(n, 0) ThenBlock: { reading = 0 }
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    ch = GetByte(in_buf, rpos)
                    IfCondition EqualTo(ch, 10) ThenBlock: {
                        SetByte(in_buf, rpos, 0)
                        reading = 0
                    }
                    IfCondition NotEqual(ch, 10) ThenBlock: {
                        rpos = Add(rpos, 1)
                    }
                }
            }
        }
        BrHeadless.in_path = in_buf

        // Read second line for output path
        out_buf = Allocate(512)
        MemorySet(out_buf, 0, 512)
        rpos = 0
        reading = 1
        WhileLoop EqualTo(reading, 1) {
            IfCondition GreaterEqual(rpos, 510) ThenBlock: { reading = 0 }
            IfCondition EqualTo(reading, 1) ThenBlock: {
                n = SystemCall(0, 0, Add(out_buf, rpos), 1)
                IfCondition LessEqual(n, 0) ThenBlock: { reading = 0 }
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    ch = GetByte(out_buf, rpos)
                    IfCondition EqualTo(ch, 10) ThenBlock: {
                        SetByte(out_buf, rpos, 0)
                        reading = 0
                    }
                    IfCondition NotEqual(ch, 10) ThenBlock: {
                        rpos = Add(rpos, 1)
                    }
                }
            }
        }
        BrHeadless.out_path = out_buf
    }
}

Function.BrHeadless_ReadFile {
    Output: Integer
    Body: {
        fd = SystemCall(2, BrHeadless.in_path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[Headless] Cannot open: ")
            PrintMessage(BrHeadless.in_path)
            PrintMessage("\n")
            ReturnValue(0)
        }

        BrHeadless.html_buf = Allocate(BrHeadless.MAX_HTML)
        total = 0
        reading = 1
        WhileLoop EqualTo(reading, 1) {
            remain = Subtract(BrHeadless.MAX_HTML, total)
            IfCondition LessEqual(remain, 0) ThenBlock: { reading = 0 }
            IfCondition EqualTo(reading, 1) ThenBlock: {
                n = SystemCall(0, fd, Add(BrHeadless.html_buf, total), remain)
                IfCondition LessEqual(n, 0) ThenBlock: { reading = 0 }
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    total = Add(total, n)
                }
            }
        }
        SystemCall(3, fd)
        SetByte(BrHeadless.html_buf, total, 0)
        BrHeadless.html_len = total
        ReturnValue(total)
    }
}

Function.BrHeadless_WritePPM {
    Input: pixels: Address
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(pixels, 0) ThenBlock: { ReturnValue(0) }
        // O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0644 = 420
        fd = SystemCall(2, BrHeadless.out_path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[Headless] Cannot write: ")
            PrintMessage(BrHeadless.out_path)
            PrintMessage("\n")
            ReturnValue(0)
        }

        // PPM header: "P6\n1024 700\n255\n" (fixed size — always 1024x700)
        ppm_hdr = "P6\n1024 700\n255\n"
        ppm_hdr_len = StringLength(ppm_hdr)
        SystemCall(1, fd, ppm_hdr, ppm_hdr_len)

        // BGRA -> RGB row by row
        row_bytes = Multiply(w, 3)
        row_buf = Allocate(Add(row_bytes, 8))
        pitch = Multiply(w, 4)

        y = 0
        WhileLoop LessThan(y, h) {
            src = Add(pixels, Multiply(y, pitch))
            x = 0
            WhileLoop LessThan(x, w) {
                si = Multiply(x, 4)
                di = Multiply(x, 3)
                SetByte(row_buf, di,          GetByte(src, Add(si, 2)))  // R
                SetByte(row_buf, Add(di, 1),  GetByte(src, Add(si, 1)))  // G
                SetByte(row_buf, Add(di, 2),  GetByte(src, si))           // B
                x = Add(x, 1)
            }
            SystemCall(1, fd, row_buf, row_bytes)
            y = Add(y, 1)
        }

        Deallocate(row_buf, Add(row_bytes, 8))
        SystemCall(3, fd)
        ReturnValue(1)
    }
}

// Full headless render pipeline — same as Br_FetchAndRender but from file
// Headless URL fetch mode — fetch URL, parse, layout, render to PPM
Function.BrHeadless_RunURL {
    Body: {
        PrintMessage("[BrTest] URL mode: ")
        PrintMessage(BrHeadless.in_path)
        PrintMessage("\n")

        // Init all browser subsystems including networking
        URL_Init()
        DNS_Init()
        HTTP_Init()
        HTK_Init()
        DOM_Init()
        CSS_Init()
        LY__InjectUAStyles()
        JSEngine_Init()
        BrURL.buf = Allocate(2048)

        // Set current URL
        BrState.cur_url = BrHeadless.in_path
        BrState.cur_url_len = StringLength(BrHeadless.in_path)

        // Fetch page
        PrintMessage("[BrTest] Fetching URL...\n")
        url_h = URL_Parse(BrState.cur_url, BrState.cur_url_len)
        IfCondition LessThan(url_h, 0) ThenBlock: {
            PrintMessage("[BrTest] URL parse failed\n")
            SystemCall(60, 1, 0, 0, 0, 0)
        }

        BrPipe.resp = HTTP_Get(url_h)
        IfCondition LessThan(BrPipe.resp, 0) ThenBlock: {
            PrintMessage("[BrTest] HTTP fetch failed\n")
            SystemCall(60, 1, 0, 0, 0, 0)
        }

        // Follow redirects
        status = HTTP_GetStatus(BrPipe.resp)
        redir_count = 0
        WhileLoop And(LessThan(redir_count, 5), Or(Or(EqualTo(status, 301), EqualTo(status, 302)), Or(EqualTo(status, 307), EqualTo(status, 308)))) {
            redir_loc = HTTP_GetLocation(BrPipe.resp)
            IfCondition EqualTo(redir_loc, 0) ThenBlock: { redir_count = 5 }
            IfCondition NotEqual(redir_loc, 0) ThenBlock: {
                redir_len = StringLength(redir_loc)
                IfCondition LessEqual(redir_len, 0) ThenBlock: { redir_count = 5 }
                IfCondition GreaterThan(redir_len, 0) ThenBlock: {
                    PrintMessage("[BrTest] Redirect -> ")
                    PrintMessage(redir_loc)
                    PrintMessage("\n")
                    BrState.cur_url = redir_loc
                    BrState.cur_url_len = redir_len
                    redir_url_h = URL_Parse(redir_loc, redir_len)
                    IfCondition GreaterEqual(redir_url_h, 0) ThenBlock: {
                        BrPipe.resp = HTTP_Get(redir_url_h)
                        IfCondition GreaterEqual(BrPipe.resp, 0) ThenBlock: {
                            status = HTTP_GetStatus(BrPipe.resp)
                        }
                    }
                }
            }
            redir_count = Add(redir_count, 1)
        }

        PrintMessage("[BrTest] HTTP ")
        PrintNumber(status)
        PrintMessage("\n")

        BrPipe.body = HTTP_GetBody(BrPipe.resp)
        BrPipe.body_len = HTTP_GetBodyLen(BrPipe.resp)
        PrintMessage("[BrTest] Body: ")
        PrintNumber(BrPipe.body_len)
        PrintMessage(" bytes\n")

        IfCondition LessEqual(BrPipe.body_len, 0) ThenBlock: {
            PrintMessage("[BrTest] Empty body\n")
            SystemCall(60, 1, 0, 0, 0, 0)
        }

        // Tokenize + DOM
        PrintMessage("[BrTest] Tokenizing...\n")
        tok_count = HTK_Tokenize(BrPipe.body, BrPipe.body_len)
        PrintMessage("[BrTest] Tokens: ")
        PrintNumber(tok_count)
        PrintMessage("\n")

        BrPipe.dom_root = DOM_ParseString(BrPipe.body, BrPipe.body_len)
        IfCondition LessThan(BrPipe.dom_root, 0) ThenBlock: {
            PrintMessage("[BrTest] DOM parse failed\n")
            SystemCall(60, 1, 0, 0, 0, 0)
        }
        PrintMessage("[BrTest] DOM nodes: ")
        PrintNumber(DOM_NodeCount())
        PrintMessage("\n")

        // CSS — full stylesheet loading (inline + external)
        PrintMessage("[BrTest] Loading stylesheets...\n")
        css_count = Br_LoadStylesheets()
        PrintMessage("[BrTest] CSS rules: ")
        PrintNumber(css_count)
        PrintMessage(" sheets: ")
        PrintNumber(BrCSS.sheets_loaded)
        PrintMessage("\n")

        // JavaScript
        PrintMessage("[BrTest] Running scripts...\n")
        js_count = JSEngine_LoadPage(BrPipe.dom_root)

        // Init VIF fonts
        VIF_Init()
        VFont_Init()
        hl_face = VFont_LoadFace("fonts/DejaVuSans.vif")
        IfCondition LessThan(hl_face, 0) ThenBlock: {
            hl_face = VFont_LoadFace("fonts/AlteixSans.vif")
        }
        FontState.default_face = hl_face
        IfCondition GreaterEqual(hl_face, 0) ThenBlock: {
            FontState.default_inst = VFont_CreateInstance(hl_face, 16)
        }

        // Layout — with page URL set for remote image fetching
        PrintMessage("[BrTest] Running layout...\n")
        LY__SetPageURL(BrState.cur_url, BrState.cur_url_len)
        Layout_Init()
        Layout_SetViewport(BrState.canvas_w, BrState.canvas_h)
        cmd_count = Layout_Run(BrPipe.dom_root)
        PrintMessage("[BrTest] Render commands: ")
        PrintNumber(cmd_count)
        PrintMessage("\n")
        PrintMessage("[BrTest] Content height: ")
        PrintNumber(Layout_ContentHeight())
        PrintMessage("\n")

        // Render to pixel buffer
        PrintMessage("[BrTest] Rendering...\n")
        canvas_sz = Multiply(Multiply(BrState.canvas_w, BrState.canvas_h), 4)
        canvas_pix = Allocate(canvas_sz)
        MemorySet(canvas_pix, 255, canvas_sz)

        Render_Init()
        Render_SetTarget(canvas_pix, BrState.canvas_w, BrState.canvas_h)
        Render_SetScroll(0)
        Render_Clear(0xFFFFFFFF)
        Render_Exec()

        // Write PPM
        PrintMessage("[BrTest] Writing PPM...\n")
        wr = BrHeadless_WritePPM(canvas_pix, BrState.canvas_w, BrState.canvas_h)
        IfCondition EqualTo(wr, 1) ThenBlock: {
            PrintMessage("[BrTest] PASS — PPM written to ")
            PrintMessage(BrHeadless.out_path)
            PrintMessage("\n")
        }

        Deallocate(canvas_pix, canvas_sz)
    }
}

Function.BrHeadless_Run {
    Body: {
        // Detect if input is a URL (starts with "http")
        IfCondition NotEqual(BrHeadless.in_path, 0) ThenBlock: {
            IfCondition GreaterThan(StringLength(BrHeadless.in_path), 4) ThenBlock: {
                IfCondition EqualTo(GetByte(BrHeadless.in_path, 0), 104) ThenBlock: {
                    IfCondition EqualTo(GetByte(BrHeadless.in_path, 1), 116) ThenBlock: {
                        IfCondition EqualTo(GetByte(BrHeadless.in_path, 2), 116) ThenBlock: {
                            IfCondition EqualTo(GetByte(BrHeadless.in_path, 3), 112) ThenBlock: {
                                BrHeadless_RunURL()
                                ReturnValue(0)
                            }
                        }
                    }
                }
            }
        }

        // File-based headless mode (original path)
        // Read HTML from file
        bytes = BrHeadless_ReadFile()
        IfCondition EqualTo(bytes, 0) ThenBlock: {
            PrintMessage("[Headless] FAIL — no HTML data\n")
            SystemCall(60, 1, 0, 0, 0, 0)
        }
        PrintMessage("[BrTest] Read ")
        PrintNumber(bytes)
        PrintMessage(" bytes of HTML\n")

        // Init browser subsystems
        URL_Init()
        HTK_Init()
        DOM_Init()
        CSS_Init()
        LY__InjectUAStyles()
        JSEngine_Init()

        // Set image base directory from input file path (for relative <img src>)
        IfCondition NotEqual(BrHeadless.in_path, 0) ThenBlock: {
            ip_len = StringLength(BrHeadless.in_path)
            // Find last '/' to extract directory
            ip_last_slash = -1
            ip_i = 0
            WhileLoop LessThan(ip_i, ip_len) {
                IfCondition EqualTo(GetByte(BrHeadless.in_path, ip_i), 47) ThenBlock: {
                    ip_last_slash = ip_i
                }
                ip_i = Add(ip_i, 1)
            }
            IfCondition GreaterEqual(ip_last_slash, 0) ThenBlock: {
                ip_dir = Allocate(Add(ip_last_slash, 1))
                MemoryCopy(ip_dir, BrHeadless.in_path, ip_last_slash)
                SetByte(ip_dir, ip_last_slash, 0)
                LY__SetImageBaseDir(ip_dir)
                PrintMessage("[BrTest] Image base dir: ")
                PrintMessage(ip_dir)
                PrintMessage("\n")
            }
        }

        // Tokenize
        PrintMessage("[BrTest] Tokenizing...\n")
        tok_count = HTK_Tokenize(BrHeadless.html_buf, BrHeadless.html_len)
        PrintMessage("[BrTest] Tokens: ")
        PrintNumber(tok_count)
        PrintMessage("\n")

        // DOM
        PrintMessage("[BrTest] Building DOM...\n")
        dom_root = DOM_ParseString(BrHeadless.html_buf, BrHeadless.html_len)
        IfCondition LessThan(dom_root, 0) ThenBlock: {
            PrintMessage("[BrTest] FAIL — DOM parse failed\n")
            SystemCall(60, 1, 0, 0, 0, 0)
        }
        PrintMessage("[BrTest] DOM nodes: ")
        PrintNumber(DOM_NodeCount())
        PrintMessage("\n")

        // Set cur_url so Br_ResolveURL doesn't crash on NULL
        BrState.cur_url = BrHeadless.in_path
        BrState.cur_url_len = StringLength(BrHeadless.in_path)
        BrURL.buf = Allocate(2048)

        // CSS — use same Br_LoadStylesheets as interactive mode
        PrintMessage("[BrTest] Parsing CSS...\n")
        css_total = Br_LoadStylesheets()
        PrintMessage("[BrTest] CSS rules: ")
        PrintNumber(css_total)
        PrintMessage("\n")

        // JavaScript
        PrintMessage("[BrTest] Running scripts...\n")
        js_count = JSEngine_LoadPage(dom_root)

        // Init VIF fonts before layout (layout needs font metrics for text measurement)
        VIF_Init()
        VFont_Init()
        hl_face = VFont_LoadFace("fonts/DejaVuSans.vif")
        IfCondition LessThan(hl_face, 0) ThenBlock: {
            hl_face = VFont_LoadFace("fonts/AlteixSans.vif")
        }
        FontState.default_face = hl_face
        IfCondition GreaterEqual(hl_face, 0) ThenBlock: {
            FontState.default_inst = VFont_CreateInstance(hl_face, 16)
        }

        // Layout
        PrintMessage("[BrTest] Running layout...\n")
        Layout_Init()
        Layout_SetViewport(BrState.canvas_w, BrState.canvas_h)
        cmd_count = Layout_Run(dom_root)
        PrintMessage("[BrTest] Render commands: ")
        PrintNumber(cmd_count)
        PrintMessage("\n")
        PrintMessage("[BrTest] Content height: ")
        PrintNumber(Layout_ContentHeight())
        PrintMessage("\n")

        // Dump first 40 draw commands for diagnostics
        diag_i = 0
        diag_max = cmd_count
        IfCondition GreaterThan(diag_max, 40) ThenBlock: { diag_max = 40 }
        WhileLoop LessThan(diag_i, diag_max) {
            diag_type = LY__CmdGet(diag_i, LYConst.C_TYPE)
            diag_x = LY__CmdGet(diag_i, LYConst.C_X)
            diag_y = LY__CmdGet(diag_i, LYConst.C_Y)
            diag_w = LY__CmdGet(diag_i, LYConst.C_W)
            diag_h = LY__CmdGet(diag_i, LYConst.C_H)
            diag_c = LY__CmdGet(diag_i, LYConst.C_COLOR)
            PrintMessage("[CMD ")
            PrintNumber(diag_i)
            PrintMessage("] t=")
            PrintNumber(diag_type)
            PrintMessage(" x=")
            PrintNumber(diag_x)
            PrintMessage(" y=")
            PrintNumber(diag_y)
            PrintMessage(" w=")
            PrintNumber(diag_w)
            PrintMessage(" h=")
            PrintNumber(diag_h)
            PrintMessage(" c=")
            PrintNumber(diag_c)
            // If text command, print the text content
            IfCondition EqualTo(diag_type, 2) ThenBlock: {
                diag_txt = LY__CmdGet(diag_i, LYConst.C_PTR)
                IfCondition NotEqual(diag_txt, 0) ThenBlock: {
                    PrintMessage(" \"")
                    PrintMessage(diag_txt)
                    PrintMessage("\"")
                }
            }
            PrintMessage("\n")
            diag_i = Add(diag_i, 1)
        }

        // Render to pixel buffer
        PrintMessage("[BrTest] Rendering...\n")
        canvas_sz = Multiply(Multiply(BrState.canvas_w, BrState.canvas_h), 4)
        canvas_pix = Allocate(canvas_sz)
        MemorySet(canvas_pix, 255, canvas_sz)

        Render_Init()
        Render_SetTarget(canvas_pix, BrState.canvas_w, BrState.canvas_h)
        Render_SetScroll(0)
        Render_Clear(0xFFFFFFFF)
        Render_Exec()

        // Write PPM
        PrintMessage("[BrTest] Writing PPM...\n")
        wr = BrHeadless_WritePPM(canvas_pix, BrState.canvas_w, BrState.canvas_h)
        IfCondition EqualTo(wr, 1) ThenBlock: {
            PrintMessage("[BrTest] PASS — PPM written to ")
            PrintMessage(BrHeadless.out_path)
            PrintMessage("\n")
        }

        Deallocate(canvas_pix, canvas_sz)
        Deallocate(BrHeadless.html_buf, BrHeadless.MAX_HTML)
    }
}

// =============================================================================
// CLOBBER-SAFE TEMPS for fetch+render pipeline
// =============================================================================
FixedPool.BrPipe {
    "resp":      Initialize=0
    "body":      Initialize=0
    "body_len":  Initialize=0
    "dom_root":  Initialize=0
}

// =============================================================================
// URL RESOLUTION — resolve relative href against current page URL
// =============================================================================
FixedPool.BrURL {
    "buf":       Initialize=0
    "base_h":    Initialize=0
    "href_ptr":  Initialize=0
    "href_sz":   Initialize=0
}

Function.Br_ResolveURL {
    Input: href: Address
    Input: href_len: Integer
    Output: Address
    Body: {
        // Save inputs to FixedPool immediately (args clobbered by any function call)
        BrURL.href_ptr = href
        BrURL.href_sz = href_len

        // If href is already absolute (starts with "http"), return as-is
        // GetByte is intrinsic — no clobber
        IfCondition GreaterThan(BrURL.href_sz, 4) ThenBlock: {
            c0 = GetByte(BrURL.href_ptr, 0)
            c1 = GetByte(BrURL.href_ptr, 1)
            c2 = GetByte(BrURL.href_ptr, 2)
            c3 = GetByte(BrURL.href_ptr, 3)
            // "http" = 104,116,116,112
            IfCondition EqualTo(c0, 104) ThenBlock: {
                IfCondition EqualTo(c1, 116) ThenBlock: {
                    IfCondition EqualTo(c2, 116) ThenBlock: {
                        IfCondition EqualTo(c3, 112) ThenBlock: {
                            ReturnValue(BrURL.href_ptr)
                        }
                    }
                }
            }
        }

        // Protocol-relative URL: "//cdn.example.com/..."
        IfCondition GreaterThan(BrURL.href_sz, 2) ThenBlock: {
            pr0 = GetByte(BrURL.href_ptr, 0)
            pr1 = GetByte(BrURL.href_ptr, 1)
            IfCondition EqualTo(pr0, 47) ThenBlock: {
                IfCondition EqualTo(pr1, 47) ThenBlock: {
                    // Prepend current scheme
                    BrURL.base_h = URL_Parse(BrState.cur_url, BrState.cur_url_len)
                    IfCondition GreaterEqual(BrURL.base_h, 0) ThenBlock: {
                        bs2 = URL_GetScheme(BrURL.base_h)
                        bs2_len = StringLength(bs2)
                        MemoryCopy(BrURL.buf, bs2, bs2_len)
                        SetByte(BrURL.buf, bs2_len, 58)  // ':'
                        MemoryCopy(Add(BrURL.buf, Add(bs2_len, 1)), BrURL.href_ptr, BrURL.href_sz)
                        SetByte(BrURL.buf, Add(Add(bs2_len, 1), BrURL.href_sz), 0)
                        ReturnValue(BrURL.buf)
                    }
                }
            }
        }

        // Parse base URL to get scheme + host + path
        BrURL.base_h = URL_Parse(BrState.cur_url, BrState.cur_url_len)
        IfCondition LessThan(BrURL.base_h, 0) ThenBlock: {
            ReturnValue(BrURL.href_ptr)
        }

        // URL_Get* are simple FixedPool reads — base_h in FixedPool is safe
        base_scheme = URL_GetScheme(BrURL.base_h)
        base_host = URL_GetHost(BrURL.base_h)
        base_path = URL_GetPath(BrURL.base_h)

        // Build resolved URL into buffer
        // StringLength/MemoryCopy/GetByte/SetByte are intrinsics — no clobber
        pos = 0

        // scheme://
        s_len = StringLength(base_scheme)
        MemoryCopy(Add(BrURL.buf, pos), base_scheme, s_len)
        pos = Add(pos, s_len)
        SetByte(BrURL.buf, pos, 58)     // ':'
        pos = Add(pos, 1)
        SetByte(BrURL.buf, pos, 47)     // '/'
        pos = Add(pos, 1)
        SetByte(BrURL.buf, pos, 47)     // '/'
        pos = Add(pos, 1)

        // host
        h_len = StringLength(base_host)
        MemoryCopy(Add(BrURL.buf, pos), base_host, h_len)
        pos = Add(pos, h_len)

        // If href starts with '/', it's absolute path
        first = GetByte(BrURL.href_ptr, 0)
        IfCondition EqualTo(first, 47) ThenBlock: {
            MemoryCopy(Add(BrURL.buf, pos), BrURL.href_ptr, BrURL.href_sz)
            pos = Add(pos, BrURL.href_sz)
            SetByte(BrURL.buf, pos, 0)
            ReturnValue(BrURL.buf)
        }

        // Relative path — find last '/' in base_path
        bp_len = StringLength(base_path)
        last_slash = 0
        si = 0
        WhileLoop LessThan(si, bp_len) {
            IfCondition EqualTo(GetByte(base_path, si), 47) ThenBlock: {
                last_slash = si
            }
            si = Add(si, 1)
        }

        // Copy base path up to and including last '/'
        copy_len = Add(last_slash, 1)
        MemoryCopy(Add(BrURL.buf, pos), base_path, copy_len)
        pos = Add(pos, copy_len)

        // Append relative href
        MemoryCopy(Add(BrURL.buf, pos), BrURL.href_ptr, BrURL.href_sz)
        pos = Add(pos, BrURL.href_sz)
        SetByte(BrURL.buf, pos, 0)
        ReturnValue(BrURL.buf)
    }
}

// =============================================================================
// CSS STYLESHEET LOADING — find all <style> and <link rel="stylesheet"> tags
// =============================================================================
FixedPool.BrCSS {
    "total_rules":   Initialize=0
    "sheets_loaded": Initialize=0
    "fetch_body":    Initialize=0
    "fetch_len":     Initialize=0
    "ni":            Initialize=0
    "node_count":    Initialize=0
    "abs_url":       Initialize=0
    "abs_len":       Initialize=0
    "css_resp":      Initialize=0
}

Function.Br_LoadStylesheets {
    Output: Integer
    Body: {
        CSS_Reset()
        LY__InjectUAStyles()
        BrCSS.total_rules = 0
        BrCSS.sheets_loaded = 0
        BrCSS.node_count = DOM_NodeCount()
        BrCSS.ni = 0

        // Scan all DOM nodes for <style> and <link rel="stylesheet">
        WhileLoop LessThan(BrCSS.ni, BrCSS.node_count) {
            ntype = DOM_GetType(BrCSS.ni)
            IfCondition EqualTo(ntype, 1) ThenBlock: {
                // ELEMENT node — get tag (survives because DOM stores stable ptrs)
                tag = DOM_GetTag(BrCSS.ni)
                IfCondition NotEqual(tag, 0) ThenBlock: {

                    // ── <style> ──
                    is_style = StringCompare(tag, "style")
                    IfCondition EqualTo(is_style, 0) ThenBlock: {
                        // CSS text is in the first child TEXT node, not on the element
                        st_ch = DOM_GetFirstChild(BrCSS.ni)
                        IfCondition GreaterEqual(st_ch, 0) ThenBlock: {
                            st_text = DOM_GetText(st_ch)
                            st_len = DOM_GetTextLen(st_ch)
                            IfCondition GreaterThan(st_len, 0) ThenBlock: {
                                // CSS_ParseSheet clobbers locals — ni/node_count safe in FixedPool
                                new_rules = CSS_ParseSheet(st_text, st_len)
                                BrCSS.total_rules = Add(BrCSS.total_rules, new_rules)
                                BrCSS.sheets_loaded = Add(BrCSS.sheets_loaded, 1)
                            }
                        }
                    }

                    // ── <link rel="stylesheet"> ──
                    // Re-read tag — StringCompare above may have clobbered the local
                    tag2 = DOM_GetTag(BrCSS.ni)
                    IfCondition NotEqual(tag2, 0) ThenBlock: {
                        is_link = StringCompare(tag2, "link")
                        IfCondition EqualTo(is_link, 0) ThenBlock: {
                            rel = DOM_GetAttr(BrCSS.ni, "rel")
                            IfCondition NotEqual(rel, 0) ThenBlock: {
                                is_ss = StringCompare(rel, "stylesheet")
                                IfCondition EqualTo(is_ss, 0) ThenBlock: {
                                    css_href = DOM_GetAttr(BrCSS.ni, "href")
                                    IfCondition NotEqual(css_href, 0) ThenBlock: {
                                        css_href_len = StringLength(css_href)
                                        IfCondition GreaterThan(css_href_len, 0) ThenBlock: {
                                            // Resolve relative URL against current page
                                            BrCSS.abs_url = Br_ResolveURL(css_href, css_href_len)
                                            BrCSS.abs_len = StringLength(BrCSS.abs_url)

                                            BrLog_Write("[CSS] fetch: ")
                                            BrLog_Write(BrCSS.abs_url)
                                            BrLog_Write("\n")
                                            PrintMessage("[CSS] Fetching: ")
                                            PrintString(BrCSS.abs_url)
                                            PrintMessage("\n")

                                            // URL_Parse clobbers locals
                                            css_url_h = URL_Parse(BrCSS.abs_url, BrCSS.abs_len)
                                            IfCondition GreaterEqual(css_url_h, 0) ThenBlock: {
                                                // HTTP_Get clobbers locals
                                                BrCSS.css_resp = HTTP_Get(css_url_h)
                                                IfCondition GreaterEqual(BrCSS.css_resp, 0) ThenBlock: {
                                                    BrCSS.fetch_body = HTTP_GetBody(BrCSS.css_resp)
                                                    BrCSS.fetch_len = HTTP_GetBodyLen(BrCSS.css_resp)
                                                    IfCondition GreaterThan(BrCSS.fetch_len, 0) ThenBlock: {
                                                        new_rules2 = CSS_ParseSheet(BrCSS.fetch_body, BrCSS.fetch_len)
                                                        BrCSS.total_rules = Add(BrCSS.total_rules, new_rules2)
                                                        BrCSS.sheets_loaded = Add(BrCSS.sheets_loaded, 1)
                                                        PrintMessage("[CSS] External: ")
                                                        PrintNumber(new_rules2)
                                                        PrintMessage(" rules\n")
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            BrCSS.ni = Add(BrCSS.ni, 1)
        }

        PrintMessage("[CSS] Total: ")
        PrintNumber(BrCSS.sheets_loaded)
        PrintMessage(" sheets, ")
        PrintNumber(BrCSS.total_rules)
        PrintMessage(" rules\n")

        ReturnValue(BrCSS.total_rules)
    }
}

// =============================================================================
// HISTORY — push/back/forward
// =============================================================================
Function.BrHist_Init {
    Output: Integer
    Body: {
        sz = Multiply(BrHistConst.MAX_ENTRIES, BrHistConst.ENTRY_SIZE)
        BrHist.pool = Allocate(sz)
        MemorySet(BrHist.pool, 0, sz)
        BrHist.count = 0
        BrHist.pos = 0
        ReturnValue(0)
    }
}

Function.BrHist_Push {
    Input: url: Address
    Input: url_len: Integer
    Output: Integer
    Body: {
        // Truncate forward history when navigating from mid-stack
        BrHist.count = BrHist.pos

        IfCondition GreaterEqual(BrHist.count, BrHistConst.MAX_ENTRIES) ThenBlock: {
            ReturnValue(0)
        }

        off = Multiply(BrHist.count, BrHistConst.ENTRY_SIZE)
        base = Add(BrHist.pool, off)
        StoreValue(base, url)
        StoreValue(Add(base, 8), url_len)
        BrHist.count = Add(BrHist.count, 1)
        BrHist.pos = BrHist.count
        ReturnValue(1)
    }
}

Function.BrHist_CanBack {
    Output: Integer
    Body: {
        IfCondition GreaterThan(BrHist.pos, 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.BrHist_CanFwd {
    Output: Integer
    Body: {
        IfCondition LessThan(BrHist.pos, BrHist.count) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.BrHist_Back {
    Output: Integer
    Body: {
        IfCondition LessEqual(BrHist.pos, 1) ThenBlock: {
            ReturnValue(0)
        }
        BrHist.pos = Subtract(BrHist.pos, 1)
        idx = Subtract(BrHist.pos, 1)
        off = Multiply(idx, BrHistConst.ENTRY_SIZE)
        base = Add(BrHist.pool, off)
        BrState.cur_url = Dereference(base)
        BrState.cur_url_len = Dereference(Add(base, 8))
        ReturnValue(1)
    }
}

Function.BrHist_Fwd {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(BrHist.pos, BrHist.count) ThenBlock: {
            ReturnValue(0)
        }
        off = Multiply(BrHist.pos, BrHistConst.ENTRY_SIZE)
        base = Add(BrHist.pool, off)
        BrState.cur_url = Dereference(base)
        BrState.cur_url_len = Dereference(Add(base, 8))
        BrHist.pos = Add(BrHist.pos, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// FETCH + RENDER — uses BrState.cur_url / cur_url_len
// All intermediate state saved to FixedPool to survive function calls.
// =============================================================================
Function.Br_FetchAndRender {
    Output: Integer
    Body: {
        // Fetch using current URL from state
        PrintMessage("[Browser] Fetching: ")
        PrintString(BrState.cur_url)
        PrintMessage("\n")

        url_h = URL_Parse(BrState.cur_url, BrState.cur_url_len)
        IfCondition LessThan(url_h, 0) ThenBlock: {
            PrintMessage("[Browser] URL parse failed\n")
            ReturnValue(0)
        }

        // Debug log to file (display server covers TTY, can't see stdout)
        br_dbg = SystemCall(2, "/tmp/browser_debug.log", 1089, 420)
        IfCondition GreaterEqual(br_dbg, 0) ThenBlock: {
            SystemCall(1, br_dbg, "=== Br_FetchAndRender ===\nURL: ", 31)
            SystemCall(1, br_dbg, BrState.cur_url, BrState.cur_url_len)
            SystemCall(1, br_dbg, "\n", 1)
        }

        BrPipe.resp = HTTP_Get(url_h)

        IfCondition GreaterEqual(br_dbg, 0) ThenBlock: {
            dbg_rs = IntToString(BrPipe.resp)
            SystemCall(1, br_dbg, "HTTP_Get returned resp=", 23)
            SystemCall(1, br_dbg, dbg_rs, StringLength(dbg_rs))
            SystemCall(1, br_dbg, "\n", 1)
        }

        IfCondition LessThan(BrPipe.resp, 0) ThenBlock: {
            IfCondition GreaterEqual(br_dbg, 0) ThenBlock: {
                SystemCall(1, br_dbg, "FETCH FAILED\n", 13)
                SystemCall(3, br_dbg)
            }
            PrintMessage("[Browser] HTTP fetch failed\n")
            ReturnValue(0)
        }

        status = HTTP_GetStatus(BrPipe.resp)

        // Follow redirects (301, 302, 307, 308) — up to 5 hops
        redir_count = 0
        WhileLoop And(LessThan(redir_count, 5), Or(Or(EqualTo(status, 301), EqualTo(status, 302)), Or(EqualTo(status, 307), EqualTo(status, 308)))) {
            redir_loc = HTTP_GetLocation(BrPipe.resp)
            IfCondition EqualTo(redir_loc, 0) ThenBlock: {
                redir_count = 5
            }
            IfCondition NotEqual(redir_loc, 0) ThenBlock: {
                redir_len = StringLength(redir_loc)
                IfCondition LessEqual(redir_len, 0) ThenBlock: {
                    redir_count = 5
                }
                IfCondition GreaterThan(redir_len, 0) ThenBlock: {
                    PrintMessage("[Browser] Redirect -> ")
                    PrintString(redir_loc)
                    PrintMessage("\n")
                    IfCondition GreaterEqual(br_dbg, 0) ThenBlock: {
                        SystemCall(1, br_dbg, "redirect -> ", 12)
                        SystemCall(1, br_dbg, redir_loc, redir_len)
                        SystemCall(1, br_dbg, "\n", 1)
                    }
                    // Update current URL to the redirect target
                    BrState.cur_url = redir_loc
                    BrState.cur_url_len = redir_len
                    // Parse and fetch the new URL
                    redir_url_h = URL_Parse(redir_loc, redir_len)
                    IfCondition LessThan(redir_url_h, 0) ThenBlock: {
                        PrintMessage("[Browser] Redirect URL parse failed\n")
                        redir_count = 5
                    }
                    IfCondition GreaterEqual(redir_url_h, 0) ThenBlock: {
                        BrPipe.resp = HTTP_Get(redir_url_h)
                        IfCondition LessThan(BrPipe.resp, 0) ThenBlock: {
                            PrintMessage("[Browser] Redirect fetch failed\n")
                            redir_count = 5
                        }
                        IfCondition GreaterEqual(BrPipe.resp, 0) ThenBlock: {
                            status = HTTP_GetStatus(BrPipe.resp)
                        }
                    }
                }
            }
            redir_count = Add(redir_count, 1)
        }

        IfCondition GreaterEqual(br_dbg, 0) ThenBlock: {
            dbg_ss = IntToString(status)
            SystemCall(1, br_dbg, "final status=", 13)
            SystemCall(1, br_dbg, dbg_ss, StringLength(dbg_ss))
            SystemCall(1, br_dbg, "\nbody_len=", 10)
        }

        PrintMessage("[Browser] HTTP ")
        PrintNumber(status)
        PrintMessage("\n")

        // Save body ptr and len to FixedPool before next calls clobber resp
        BrPipe.body = HTTP_GetBody(BrPipe.resp)
        BrPipe.body_len = HTTP_GetBodyLen(BrPipe.resp)

        IfCondition GreaterEqual(br_dbg, 0) ThenBlock: {
            dbg_bl = IntToString(BrPipe.body_len)
            SystemCall(1, br_dbg, dbg_bl, StringLength(dbg_bl))
            SystemCall(1, br_dbg, "\n", 1)
            // Write first 200 bytes of body to log
            dbg_preview = BrPipe.body_len
            IfCondition GreaterThan(dbg_preview, 200) ThenBlock: { dbg_preview = 200 }
            IfCondition GreaterThan(dbg_preview, 0) ThenBlock: {
                SystemCall(1, br_dbg, "body_preview: ", 14)
                SystemCall(1, br_dbg, BrPipe.body, dbg_preview)
                SystemCall(1, br_dbg, "\n", 1)
            }
            SystemCall(3, br_dbg)
        }

        PrintMessage("[Browser] Body: ")
        PrintNumber(BrPipe.body_len)
        PrintMessage(" bytes\n")

        IfCondition LessEqual(BrPipe.body_len, 0) ThenBlock: {
            PrintMessage("[Browser] Empty body\n")
            ReturnValue(0)
        }

        // Reset DOM/CSS for fresh page (prevents cross-page pollution)
        DOM_Init()
        CSS_Init()
        LY__InjectUAStyles()

        // Tokenize
        BrLog_Write("=== Br_FetchAndRender ===\n")
        BrLog_WriteNum("body_len=", BrPipe.body_len)
        PrintMessage("[Browser] Tokenizing...\n")
        tok_count = HTK_Tokenize(BrPipe.body, BrPipe.body_len)
        PrintMessage("[Browser] Tokens: ")
        PrintNumber(tok_count)
        PrintMessage("\n")

        // DOM — use FixedPool body since locals are clobbered
        PrintMessage("[Browser] Building DOM...\n")
        BrPipe.dom_root = DOM_ParseString(BrPipe.body, BrPipe.body_len)
        IfCondition LessThan(BrPipe.dom_root, 0) ThenBlock: {
            PrintMessage("[Browser] DOM parse failed\n")
            ReturnValue(0)
        }
        BrLog_WriteNum("dom_nodes=", DOM_NodeCount())
        PrintMessage("[Browser] DOM nodes: ")
        PrintNumber(DOM_NodeCount())
        PrintMessage("\n")

        // CSS — find ALL <style> blocks + external <link rel="stylesheet">
        BrLog_Write("loading stylesheets...\n")
        PrintMessage("[Browser] Loading stylesheets...\n")
        css_count = Br_LoadStylesheets()
        PrintMessage("[Browser] CSS rules: ")
        PrintNumber(css_count)
        PrintMessage("  sheets: ")
        PrintNumber(BrCSS.sheets_loaded)
        PrintMessage("\n")
        BrLog_WriteNum("css_rules=", css_count)
        BrLog_WriteNum("css_vars=", CSSVar.count)

        // JavaScript — execute <script> tags (may mutate DOM before layout)
        PrintMessage("[Browser] Running scripts...\n")
        js_count = JSEngine_LoadPage(BrPipe.dom_root)
        IfCondition GreaterThan(js_count, 0) ThenBlock: {
            PrintMessage("[Browser] Executed ")
            PrintNumber(js_count)
            PrintMessage(" script(s)\n")
        }

        // Layout
        BrLog_Write("layout...\n")
        PrintMessage("[Browser] Layout...\n")
        LY__SetPageURL(BrState.cur_url, BrState.cur_url_len)
        Layout_Init()
        Layout_SetViewport(BrState.canvas_w, BrState.canvas_h)
        cmd_count = Layout_Run(BrPipe.dom_root)
        BrLog_WriteNum("draw_cmds=", cmd_count)
        BrLog_WriteNum("content_h=", Layout_ContentHeight())
        BrLog_WriteNum("ly_nodes=", LYState.dbg_nodes)
        BrLog_WriteNum("ly_blocks=", LYState.dbg_blocks)
        BrLog_WriteNum("ly_inlines=", LYState.dbg_inlines)
        BrLog_WriteNum("ly_texts=", LYState.dbg_texts)
        BrLog_WriteNum("ly_none=", LYState.dbg_none)
        BrLog_WriteNum("ly_floats=", LYState.dbg_floats)
        BrLog_WriteNum("ly_fl_chk=", LYState.dbg_fl_chk)
        BrLog_WriteNum("css_vars_final=", CSSVar.count)
        PrintMessage("[Browser] Draw commands: ")
        PrintNumber(cmd_count)
        PrintMessage("  height: ")
        PrintNumber(Layout_ContentHeight())
        PrintMessage("  css_vars: ")
        PrintNumber(CSSVar.count)
        PrintMessage("/2048\n")

        // Reset scroll and focus on new page load
        BrState.scroll_y = 0
        BrState.content_h = Layout_ContentHeight()
        BrFocus.node = -1
        BrFocus.input_len = 0

        // Render to canvas buffer — use BrState for buf
        PrintMessage("[Browser] Rendering...\n")
        Render_Init()
        Render_SetTarget(BrState.canvas_buf, BrState.canvas_w, BrState.canvas_h)
        Render_SetScroll(0)
        Render_Clear(0xFFF0F0F2)
        Render_Exec()

        // Present — use BrState for sock and win_id
        ShmCanvas_Present(BrState.sock, BrState.win_id)
        PrintMessage("[Browser] Presented to display server\n")

        ReturnValue(cmd_count)
    }
}

// =============================================================================
// REPAINT — re-render current layout with current scroll offset (no re-fetch)
// =============================================================================
Function.Br_Repaint {
    Body: {
        Render_SetTarget(BrState.canvas_buf, BrState.canvas_w, BrState.canvas_h)
        Render_SetScroll(BrState.scroll_y)
        Render_Clear(0xFFF0F0F2)
        Render_Exec()
        ShmCanvas_Present(BrState.sock, BrState.win_id)
    }
}

// =============================================================================
// FIND FORM ANCESTOR — walk up DOM tree to find enclosing <form>
// Returns node index of <form> or -1 if none found
// =============================================================================
Function.Br_FindFormAncestor {
    Input: node: Integer
    Output: Integer
    Body: {
        BrForm.child = node
        WhileLoop GreaterEqual(BrForm.child, 0) {
            BrForm.name_ptr = DOM_GetTag(BrForm.child)
            IfCondition NotEqual(BrForm.name_ptr, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(BrForm.name_ptr, "form"), 0) ThenBlock: {
                    ReturnValue(BrForm.child)
                }
            }
            BrForm.child = DOM_GetParent(BrForm.child)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// SUBMIT FORM — gather all <input> values and navigate via GET
// Walks DOM descendants of form_node, collects name=value pairs,
// builds query string, appends to form action URL, navigates.
// =============================================================================
Function.Br_SubmitForm {
    Input: form_node: Integer
    Body: {
        // Save form_node to FixedPool immediately (clobber safety)
        BrForm.form_node = form_node

        // Get form action (URL to submit to)
        BrForm.name_ptr = DOM_GetAttr(BrForm.form_node, "action")
        IfCondition EqualTo(BrForm.name_ptr, 0) ThenBlock: {
            // No action attr — use current page URL
            BrForm.name_ptr = BrState.cur_url
        }

        // Resolve action URL — StringLength is intrinsic (no clobber)
        BrForm.val_ptr = Br_ResolveURL(BrForm.name_ptr, StringLength(BrForm.name_ptr))
        IfCondition EqualTo(BrForm.val_ptr, 0) ThenBlock: { ReturnValue(0) }

        // Copy action URL to query buf — StringLength/MemoryCopy are intrinsics
        BrForm.query_len = StringLength(BrForm.val_ptr)
        MemoryCopy(BrForm.query_buf, BrForm.val_ptr, BrForm.query_len)

        // Append '?'
        SetByte(BrForm.query_buf, BrForm.query_len, 63)
        BrForm.query_len = Add(BrForm.query_len, 1)

        // Walk all DOM nodes to find <input> descendants of this form
        BrForm.fi = 0
        BrForm.fi_count = DOM_NodeCount()
        BrForm.first_p = 1
        WhileLoop LessThan(BrForm.fi, BrForm.fi_count) {
            BrForm.name_ptr = DOM_GetTag(BrForm.fi)
            IfCondition NotEqual(BrForm.name_ptr, 0) ThenBlock: {
                BrForm.fi_skip = StringCompare(BrForm.name_ptr, "input")
                IfCondition EqualTo(BrForm.fi_skip, 0) ThenBlock: {
                    // Check if this input is a descendant of our form
                    BrForm.child = Br_FindFormAncestor(BrForm.fi)
                    IfCondition EqualTo(BrForm.child, BrForm.form_node) ThenBlock: {
                        // Check type — skip submit/button
                        BrForm.val_ptr = DOM_GetAttr(BrForm.fi, "type")
                        BrForm.fi_skip = 0
                        IfCondition NotEqual(BrForm.val_ptr, 0) ThenBlock: {
                            IfCondition EqualTo(StringCompare(BrForm.val_ptr, "submit"), 0) ThenBlock: { BrForm.fi_skip = 1 }
                            IfCondition EqualTo(BrForm.fi_skip, 0) ThenBlock: {
                                IfCondition EqualTo(StringCompare(BrForm.val_ptr, "button"), 0) ThenBlock: { BrForm.fi_skip = 1 }
                            }
                        }

                        IfCondition EqualTo(BrForm.fi_skip, 0) ThenBlock: {
                            BrForm.name_ptr = DOM_GetAttr(BrForm.fi, "name")
                            IfCondition NotEqual(BrForm.name_ptr, 0) ThenBlock: {
                                // Get value — check if this is the focused input
                                BrForm.val_ptr = 0
                                IfCondition EqualTo(BrForm.fi, BrFocus.node) ThenBlock: {
                                    // Use the live input buffer
                                    BrForm.val_ptr = BrFocus.input_buf
                                }
                                IfCondition NotEqual(BrForm.fi, BrFocus.node) ThenBlock: {
                                    // Use DOM value attribute
                                    BrForm.val_ptr = DOM_GetAttr(BrForm.fi, "value")
                                }

                                // Append &name=value (or name=value for first)
                                IfCondition EqualTo(BrForm.first_p, 0) ThenBlock: {
                                    SetByte(BrForm.query_buf, BrForm.query_len, 38) // '&'
                                    BrForm.query_len = Add(BrForm.query_len, 1)
                                }
                                BrForm.first_p = 0

                                // Copy name — StringLength/MemoryCopy are intrinsics
                                BrForm.fi_skip = StringLength(BrForm.name_ptr)
                                MemoryCopy(Add(BrForm.query_buf, BrForm.query_len), BrForm.name_ptr, BrForm.fi_skip)
                                BrForm.query_len = Add(BrForm.query_len, BrForm.fi_skip)

                                // '='
                                SetByte(BrForm.query_buf, BrForm.query_len, 61)
                                BrForm.query_len = Add(BrForm.query_len, 1)

                                // Copy value (URL-encode spaces as +)
                                // All ops below use intrinsics only (GetByte, SetByte, StringLength)
                                IfCondition NotEqual(BrForm.val_ptr, 0) ThenBlock: {
                                    BrForm.fi_skip = StringLength(BrForm.val_ptr)
                                    BrForm.fi_count = 0  // reuse as vi counter
                                    WhileLoop LessThan(BrForm.fi_count, BrForm.fi_skip) {
                                        BrForm.child = GetByte(BrForm.val_ptr, BrForm.fi_count)
                                        IfCondition EqualTo(BrForm.child, 32) ThenBlock: {
                                            SetByte(BrForm.query_buf, BrForm.query_len, 43)
                                        }
                                        IfCondition NotEqual(BrForm.child, 32) ThenBlock: {
                                            SetByte(BrForm.query_buf, BrForm.query_len, BrForm.child)
                                        }
                                        BrForm.query_len = Add(BrForm.query_len, 1)
                                        BrForm.fi_count = Add(BrForm.fi_count, 1)
                                    }
                                    // Restore fi_count for outer loop
                                    BrForm.fi_count = DOM_NodeCount()
                                }
                            }
                        }
                    }
                }
            }
            BrForm.fi = Add(BrForm.fi, 1)
        }

        // Null-terminate
        SetByte(BrForm.query_buf, BrForm.query_len, 0)

        PrintMessage("[Browser] Form submit: ")
        PrintString(BrForm.query_buf)
        PrintMessage("\n")

        // Navigate
        BrState.cur_url = BrForm.query_buf
        BrState.cur_url_len = BrForm.query_len
        BrHist_Push(BrState.cur_url, BrState.cur_url_len)
        BrFocus.node = -1
        BrFocus.input_len = 0
        Br_FetchAndRender()
    }
}

// =============================================================================
// MAIN — all IPC setup inline (proven pattern from calc_ipc)
// =============================================================================
SubRoutine.Main {
    Arena_Init()

    // Check for --headless mode: ./browser_ipc.x --headless input.html output.ppm
    // Also supports piped stdin (for WPT runner compatibility):
    //   echo -e "input.html\noutput.ppm" | ./browser_ipc.x --headless
    BrHeadless_DetectFlag()
    IfCondition EqualTo(BrHeadless.enabled, 1) ThenBlock: {
        // If paths not from argv, read from stdin
        IfCondition EqualTo(BrHeadless.in_path, 0) ThenBlock: {
            BrHeadless_ReadStdin()
        }
        PrintMessage("[BrTest] Input:  ")
        PrintMessage(BrHeadless.in_path)
        PrintMessage("\n")
        PrintMessage("[BrTest] Output: ")
        PrintMessage(BrHeadless.out_path)
        PrintMessage("\n")
        BrHeadless_Run()
        SystemCall(60, 0, 0, 0, 0, 0)
    }

    // Init browser libraries — MUST be called before any parse/fetch calls
    URL_Init()
    DNS_Init()
    HTTP_Init()
    HTK_Init()
    DOM_Init()
    CSS_Init()
    JSEngine_Init()
    BrHist_Init()
    BrLog_Init()
    BrURL.buf = Allocate(2048)
    BrFocus.input_buf = Allocate(256)
    BrForm.query_buf = Allocate(2048)

    // Set default URL
    BrState.cur_url = "http://example.com/"
    BrState.cur_url_len = 19
    BrHist_Push(BrState.cur_url, BrState.cur_url_len)

    PrintMessage("============================================\n")
    PrintMessage("  Ailang Browser — Pure Ailang Engine\n")
    PrintMessage("  No C++. No runtime. No GC.\n")
    PrintMessage("============================================\n\n")

    // ---- 1. Connect to display server ----
    sock = Socket.Create(1, 1)
    IfCondition LessThan(sock, 0) ThenBlock: {
        PrintMessage("[Browser] Socket create failed\n")
        HaltProgram
    }

    cres = Socket.ConnectUnix(sock, "/tmp/ailang_display.sock")
    IfCondition LessThan(cres, 0) ThenBlock: {
        PrintMessage("[Browser] Connect failed — is SysDisplay.x running?\n")
        Socket.Close(sock)
        HaltProgram
    }
    // Save sock to FixedPool — local vars get clobbered by function calls
    BrState.sock = sock
    PrintMessage("[Browser] Connected to display server\n")

    // ---- 2. Register ----
    Socket.SendMsg(BrState.sock, "{\"method\":\"register\",\"service\":\"browser\"}")
    PrintMessage("[Browser] Registered\n")

    // ---- 3. Create window ----
    Socket.SendMsg(BrState.sock, "{\"method\":\"window.create\",\"title\":\"Ailang Browser\",\"w\":1024,\"h\":700,\"html\":\"config/browser.html\"}")
    PrintMessage("[Browser] Sent window.create\n")

    resp = Socket.RecvMsg(BrState.sock)
    IfCondition EqualTo(resp, 0) ThenBlock: {
        PrintMessage("[Browser] No response to window.create\n")
        Socket.Close(BrState.sock)
        HaltProgram
    }

    parsed = ParseJSON(resp)
    IfCondition EqualTo(parsed, 0) ThenBlock: {
        PrintMessage("[Browser] Failed to parse response\n")
        Socket.Close(BrState.sock)
        HaltProgram
    }

    pobj = JSON.AsObject(parsed)
    wid = JSON.GetNumber(pobj, "win_id")
    BrState.win_id = wid
    JSON.Free(parsed)
    PrintMessage("[Browser] Window created, win_id=")
    PrintNumber(BrState.win_id)
    PrintMessage("\n")

    // ---- 4. Create ShmCanvas ----
    canvas_buf = ShmCanvas_Create(BrState.win_id, BrState.canvas_w, BrState.canvas_h)
    IfCondition EqualTo(canvas_buf, 0) ThenBlock: {
        PrintMessage("[Browser] ShmCanvas_Create failed\n")
        Socket.Close(BrState.sock)
        HaltProgram
    }
    BrState.canvas_buf = canvas_buf

    ShmCanvas_AttachCaptureNative(BrState.sock, BrState.win_id, BrState.canvas_w, BrState.canvas_h)
    PrintMessage("[Browser] Canvas attached\n")

    // Clear to white initially
    ShmCanvas_Clear(0xFFFFFFFF)
    ShmCanvas_Present(BrState.sock, BrState.win_id)

    // ---- 5. Init fonts + Fetch, parse, layout, render ----
    // Init VIF fonts early so layout can use real glyph metrics
    Render_Init()
    PrintMessage("[Browser] === Starting fetch+render ===\n")
    fr = Br_FetchAndRender()
    PrintMessage("[Browser] === fetch+render returned: ")
    PrintNumber(fr)
    PrintMessage(" ===\n")
    IfCondition EqualTo(fr, 0) ThenBlock: {
        PrintMessage("[Browser] Page load failed — showing error\n")
        Render_Init()
        Render_SetTarget(BrState.canvas_buf, BrState.canvas_w, BrState.canvas_h)
        Render_Clear(0xFFFFFFFF)
        Render_DrawTextBg(20, 20, "Failed to load page", 19, 0xFF0000FF)
        ShmCanvas_Present(BrState.sock, BrState.win_id)
    }

    // ---- 6. Event loop ----
    Socket.SetNonBlock(BrState.sock)

    // Save ts_tick to FixedPool so it survives function calls in loop
    BrState.ts_tick = Allocate(16)
    StoreValue(BrState.ts_tick, 0)
    StoreValue(Add(BrState.ts_tick, 8), 50000000)

    PrintMessage("[Browser] Entering event loop, running=")
    PrintNumber(BrState.running)
    PrintMessage("\n")

    WhileLoop EqualTo(BrState.running, 1) {
        msg = Socket.RecvMsg(BrState.sock)
        IfCondition NotEqual(msg, 0) ThenBlock: {
            PrintMessage("[Browser] Got IPC msg\n")
            pmsg = ParseJSON(msg)
            IfCondition NotEqual(pmsg, 0) ThenBlock: {
                BrMouse.mobj = JSON.AsObject(pmsg)
                method = JSON.GetString(BrMouse.mobj, "method")

                IfCondition NotEqual(method, 0) ThenBlock: {
                    PrintMessage("[Browser] method=")
                    PrintMessage(method)
                    PrintMessage("\n")

                    cmp_closed = StringCompare(method, "window.closed")
                    IfCondition EqualTo(cmp_closed, 0) ThenBlock: {
                        PrintMessage("[Browser] Window closed\n")
                        BrState.running = 0
                    }

                    // ---- MOUSE EVENTS ----
                    cmp_mouse = StringCompare(method, "input.mouse")
                    IfCondition EqualTo(cmp_mouse, 0) ThenBlock: {
                        // Save to FixedPool immediately (clobber safety)
                        BrMouse.x = JSON.GetNumber(BrMouse.mobj, "x")
                        BrMouse.y = JSON.GetNumber(BrMouse.mobj, "y")
                        BrMouse.event = JSON.GetNumber(BrMouse.mobj, "event")
                        BrMouse.button = JSON.GetNumber(BrMouse.mobj, "button")

                        // SCROLL WHEEL — ev=3, button=delta (positive=up, negative=down)
                        IfCondition EqualTo(BrMouse.event, 3) ThenBlock: {
                            IfCondition GreaterThan(BrMouse.button, 0) ThenBlock: {
                                // Scroll up
                                BrState.scroll_y = Subtract(BrState.scroll_y, 48)
                                IfCondition LessThan(BrState.scroll_y, 0) ThenBlock: {
                                    BrState.scroll_y = 0
                                }
                                Br_Repaint()
                            }
                            IfCondition LessThan(BrMouse.button, 0) ThenBlock: {
                                // Scroll down — clamp to content_h - viewport_h
                                BrState.scroll_y = Add(BrState.scroll_y, 48)
                                max_scroll = Subtract(BrState.content_h, BrState.canvas_h)
                                IfCondition LessThan(max_scroll, 0) ThenBlock: { max_scroll = 0 }
                                IfCondition GreaterThan(BrState.scroll_y, max_scroll) ThenBlock: {
                                    BrState.scroll_y = max_scroll
                                }
                                Br_Repaint()
                            }
                        }

                        // LEFT CLICK DOWN — ev=1 (DOWN), button=0 (left)
                        // IPCBroker_SendMouse sends btn_idx: 0=left, 1=right, 2=middle
                        IfCondition EqualTo(BrMouse.event, 1) ThenBlock: {
                            IfCondition EqualTo(BrMouse.button, 0) ThenBlock: {
                                // Hit-test at mouse position + scroll offset
                                // Layout stores absolute Y coords; mouse Y is viewport-relative
                                BrMouse.hit_idx = Layout_HitTest(BrMouse.x, Add(BrMouse.y, BrState.scroll_y))
                                IfCondition GreaterEqual(BrMouse.hit_idx, 0) ThenBlock: {
                                    BrMouse.hit_type = Layout_HitType(BrMouse.hit_idx)
                                    BrMouse.hit_node = Layout_HitNode(BrMouse.hit_idx)

                                    // LINK click — navigate to href
                                    IfCondition EqualTo(BrMouse.hit_type, 3) ThenBlock: {
                                        link_href = DOM_GetAttr(BrMouse.hit_node, "href")
                                        IfCondition NotEqual(link_href, 0) ThenBlock: {
                                            PrintMessage("[Browser] Link click: ")
                                            PrintMessage(link_href)
                                            PrintMessage("\n")
                                            link_len = StringLength(link_href)
                                            link_abs = Br_ResolveURL(link_href, link_len)
                                            IfCondition NotEqual(link_abs, 0) ThenBlock: {
                                                BrState.cur_url = link_abs
                                                BrState.cur_url_len = StringLength(link_abs)
                                                BrHist_Push(BrState.cur_url, BrState.cur_url_len)
                                                Br_FetchAndRender()
                                            }
                                        }
                                    }

                                    // INPUT click — set focus and load current value
                                    IfCondition EqualTo(BrMouse.hit_type, 1) ThenBlock: {
                                        PrintMessage("[Browser] Input focused\n")
                                        BrFocus.node = BrMouse.hit_node
                                        // Load current value from DOM into input buffer
                                        BrFocus.input_len = 0
                                        MemorySet(BrFocus.input_buf, 0, 256)
                                        BrForm.val_ptr = DOM_GetAttr(BrFocus.node, "value")
                                        IfCondition NotEqual(BrForm.val_ptr, 0) ThenBlock: {
                                            BrFocus.input_len = StringLength(BrForm.val_ptr)
                                            IfCondition GreaterThan(BrFocus.input_len, BrFocus.input_max) ThenBlock: {
                                                BrFocus.input_len = BrFocus.input_max
                                            }
                                            MemoryCopy(BrFocus.input_buf, BrForm.val_ptr, BrFocus.input_len)
                                        }
                                    }

                                    // BUTTON click — trigger form submit
                                    IfCondition EqualTo(BrMouse.hit_type, 2) ThenBlock: {
                                        PrintMessage("[Browser] Button clicked — submitting form\n")
                                        BrForm.form_node = Br_FindFormAncestor(BrMouse.hit_node)
                                        IfCondition GreaterEqual(BrForm.form_node, 0) ThenBlock: {
                                            Br_SubmitForm(BrForm.form_node)
                                        }
                                    }

                                    // Fire JS "click" event (bubbles up DOM tree)
                                    JSBridge_FireEvent(BrMouse.hit_node, "click")
                                }
                            }
                        }

                        // MOUSE MOVE — ev=0 (MOVE): update hover state for :hover CSS
                        IfCondition EqualTo(BrMouse.event, 0) ThenBlock: {
                            hover_hit = Layout_HitTest(BrMouse.x, Add(BrMouse.y, BrState.scroll_y))
                            IfCondition GreaterEqual(hover_hit, 0) ThenBlock: {
                                BrHover.node = Layout_HitNode(hover_hit)
                            } ElseBlock: {
                                BrHover.node = -1
                            }
                            // Re-layout + repaint if hover target changed
                            IfCondition NotEqual(BrHover.node, BrHover.prev) ThenBlock: {
                                BrHover.prev = BrHover.node
                                LY__CSSSetHoverNode(BrHover.node)
                                Layout_Init()
                                Layout_SetViewport(BrState.canvas_w, BrState.canvas_h)
                                Layout_Run(BrPipe.dom_root)
                                BrState.content_h = Layout_ContentHeight()
                                Br_Repaint()
                            }
                        }
                    }

                    // ---- KEY EVENTS ----
                    cmp_key = StringCompare(method, "input.key")
                    IfCondition EqualTo(cmp_key, 0) ThenBlock: {
                        BrMouse.x = JSON.GetNumber(BrMouse.mobj, "keycode")
                        BrMouse.y = JSON.GetNumber(BrMouse.mobj, "char")
                        // BrMouse.x = keycode, BrMouse.y = char (reuse fields)

                        // Only process if an input is focused
                        IfCondition GreaterEqual(BrFocus.node, 0) ThenBlock: {

                            // ENTER key (keycode=28) — submit form
                            IfCondition EqualTo(BrMouse.x, 28) ThenBlock: {
                                // Null-terminate input buffer
                                SetByte(BrFocus.input_buf, BrFocus.input_len, 0)
                                PrintMessage("[Browser] Enter pressed, submitting\n")
                                BrForm.form_node = Br_FindFormAncestor(BrFocus.node)
                                IfCondition GreaterEqual(BrForm.form_node, 0) ThenBlock: {
                                    Br_SubmitForm(BrForm.form_node)
                                }
                            }

                            // BACKSPACE (keycode=14) — delete last character
                            IfCondition EqualTo(BrMouse.x, 14) ThenBlock: {
                                IfCondition GreaterThan(BrFocus.input_len, 0) ThenBlock: {
                                    BrFocus.input_len = Subtract(BrFocus.input_len, 1)
                                    SetByte(BrFocus.input_buf, BrFocus.input_len, 0)
                                    // Re-render to show updated text
                                    DOM_SetAttr(BrFocus.node, "value", BrFocus.input_buf)
                                    // Re-layout and re-render
                                    Layout_Init()
                                    Layout_SetViewport(BrState.canvas_w, BrState.canvas_h)
                                    Layout_Run(BrPipe.dom_root)
                                    BrState.content_h = Layout_ContentHeight()
                                    Br_Repaint()
                                }
                            }

                            // PRINTABLE CHARACTER (char > 31 and char < 127)
                            IfCondition GreaterThan(BrMouse.y, 31) ThenBlock: {
                                IfCondition LessThan(BrMouse.y, 127) ThenBlock: {
                                    IfCondition LessThan(BrFocus.input_len, BrFocus.input_max) ThenBlock: {
                                        SetByte(BrFocus.input_buf, BrFocus.input_len, BrMouse.y)
                                        BrFocus.input_len = Add(BrFocus.input_len, 1)
                                        SetByte(BrFocus.input_buf, BrFocus.input_len, 0)
                                        // Update DOM and re-render
                                        DOM_SetAttr(BrFocus.node, "value", BrFocus.input_buf)
                                        Layout_Init()
                                        Layout_SetViewport(BrState.canvas_w, BrState.canvas_h)
                                        Layout_Run(BrPipe.dom_root)
                                        BrState.content_h = Layout_ContentHeight()
                                        Br_Repaint()
                                    }
                                }
                            }
                        }
                    }

                    // ---- ACTION EVENTS ----
                    cmp_action = StringCompare(method, "input.action")
                    IfCondition EqualTo(cmp_action, 0) ThenBlock: {
                        action = JSON.GetString(BrMouse.mobj, "action")
                        IfCondition NotEqual(action, 0) ThenBlock: {
                            PrintMessage("[Browser] Action: ")
                            PrintMessage(action)
                            PrintMessage("\n")

                            // Back
                            cmp_back = StringCompare(action, "lb.back")
                            IfCondition EqualTo(cmp_back, 0) ThenBlock: {
                                nav_ok = BrHist_Back()
                                IfCondition EqualTo(nav_ok, 1) ThenBlock: {
                                    PrintMessage("[Browser] Navigate back\n")
                                    Br_FetchAndRender()
                                }
                            }

                            // Forward
                            cmp_fwd = StringCompare(action, "lb.fwd")
                            IfCondition EqualTo(cmp_fwd, 0) ThenBlock: {
                                nav_ok = BrHist_Fwd()
                                IfCondition EqualTo(nav_ok, 1) ThenBlock: {
                                    PrintMessage("[Browser] Navigate forward\n")
                                    Br_FetchAndRender()
                                }
                            }

                            // Reload
                            cmp_reload = StringCompare(action, "lb.reload")
                            IfCondition EqualTo(cmp_reload, 0) ThenBlock: {
                                PrintMessage("[Browser] Reload\n")
                                Br_FetchAndRender()
                            }

                            // Address bar navigate
                            cmp_addr = StringCompare(action, "addr.go")
                            IfCondition EqualTo(cmp_addr, 0) ThenBlock: {
                                new_url = JSON.GetString(BrMouse.mobj, "text")
                                IfCondition NotEqual(new_url, 0) ThenBlock: {
                                    PrintMessage("[Browser] Navigate to: ")
                                    PrintMessage(new_url)
                                    PrintMessage("\n")
                                    BrState.cur_url = new_url
                                    BrState.cur_url_len = StringLength(new_url)
                                    BrHist_Push(BrState.cur_url, BrState.cur_url_len)
                                    Br_FetchAndRender()
                                }
                            }
                        }
                    }
                }

                JSON.Free(pmsg)
            }
        }

        SystemCall(BrSys.SYS_NANOSLEEP, BrState.ts_tick, 0)
    }

    // ---- 7. Cleanup ----
    JSEngine_Shutdown()
    Deallocate(BrState.ts_tick, 16)
    ShmCanvas_Destroy(BrState.win_id)
    Socket.Close(BrState.sock)

    PrintMessage("\n============================================\n")
    PrintMessage("  Ailang Browser finished\n")
    PrintMessage("============================================\n")
}

RunTask(Main)
