// browser_ipc.ailang — Pure Ailang Browser (IPC client)
//
// Fetches a URL, parses HTML, builds DOM, resolves CSS, lays out blocks,
// renders to ShmCanvas, and presents in the display server window.
//
// No C++. No runtime. No GC. Direct-to-assembly.
//
// Build: ./ailang.x Applications/browser_ipc.ailang browser_ipc.x
// Run:   ./browser_ipc.x  (after SysDisplay.x is running)
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Socket
LibraryImport.JSON
LibraryImport.ShmCanvas
LibraryImport.TermFont
LibraryImport.Browser.URL
LibraryImport.Browser.DNS
LibraryImport.Browser.HTTPClient
LibraryImport.Browser.HTMLTokenizer
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayout
LibraryImport.Browser.HTMLRender
LibraryImport.Browser.JSLexer
LibraryImport.Browser.JSParser
LibraryImport.Browser.JSCompiler
LibraryImport.Browser.JSRuntime
LibraryImport.Browser.JSVM
LibraryImport.Browser.JSBridge
LibraryImport.Browser.JSEngine

// =============================================================================
// SYSCALL CONSTANTS
// =============================================================================
FixedPool.BrSys {
    "SYS_NANOSLEEP": Initialize=35
}

// =============================================================================
// STATE
// =============================================================================
FixedPool.BrState {
    "running":    Initialize=1
    "sock":       Initialize=0
    "win_id":     Initialize=0
    "canvas_w":   Initialize=1024
    "canvas_h":   Initialize=700
    "canvas_buf": Initialize=0
    "ts_tick":    Initialize=0
    "cur_url":    Initialize=0
    "cur_url_len": Initialize=0
}

// =============================================================================
// URL HISTORY — simple back/forward stack
// =============================================================================
FixedPool.BrHistConst {
    "MAX_ENTRIES": Initialize=64
    "ENTRY_SIZE":  Initialize=16
}

FixedPool.BrHist {
    "pool":    Initialize=0
    "count":   Initialize=0
    "pos":     Initialize=0
}

// =============================================================================
// CLOBBER-SAFE TEMPS for fetch+render pipeline
// =============================================================================
FixedPool.BrPipe {
    "resp":      Initialize=0
    "body":      Initialize=0
    "body_len":  Initialize=0
    "dom_root":  Initialize=0
}

// =============================================================================
// HISTORY — push/back/forward
// =============================================================================
Function.BrHist_Init {
    Output: Integer
    Body: {
        sz = Multiply(BrHistConst.MAX_ENTRIES, BrHistConst.ENTRY_SIZE)
        BrHist.pool = Allocate(sz)
        MemorySet(BrHist.pool, 0, sz)
        BrHist.count = 0
        BrHist.pos = 0
        ReturnValue(0)
    }
}

Function.BrHist_Push {
    Input: url: Address
    Input: url_len: Integer
    Output: Integer
    Body: {
        // Truncate forward history when navigating from mid-stack
        BrHist.count = BrHist.pos

        IfCondition GreaterEqual(BrHist.count, BrHistConst.MAX_ENTRIES) ThenBlock: {
            ReturnValue(0)
        }

        off = Multiply(BrHist.count, BrHistConst.ENTRY_SIZE)
        base = Add(BrHist.pool, off)
        StoreValue(base, url)
        StoreValue(Add(base, 8), url_len)
        BrHist.count = Add(BrHist.count, 1)
        BrHist.pos = BrHist.count
        ReturnValue(1)
    }
}

Function.BrHist_CanBack {
    Output: Integer
    Body: {
        IfCondition GreaterThan(BrHist.pos, 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.BrHist_CanFwd {
    Output: Integer
    Body: {
        IfCondition LessThan(BrHist.pos, BrHist.count) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.BrHist_Back {
    Output: Integer
    Body: {
        IfCondition LessEqual(BrHist.pos, 1) ThenBlock: {
            ReturnValue(0)
        }
        BrHist.pos = Subtract(BrHist.pos, 1)
        idx = Subtract(BrHist.pos, 1)
        off = Multiply(idx, BrHistConst.ENTRY_SIZE)
        base = Add(BrHist.pool, off)
        BrState.cur_url = Dereference(base)
        BrState.cur_url_len = Dereference(Add(base, 8))
        ReturnValue(1)
    }
}

Function.BrHist_Fwd {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(BrHist.pos, BrHist.count) ThenBlock: {
            ReturnValue(0)
        }
        off = Multiply(BrHist.pos, BrHistConst.ENTRY_SIZE)
        base = Add(BrHist.pool, off)
        BrState.cur_url = Dereference(base)
        BrState.cur_url_len = Dereference(Add(base, 8))
        BrHist.pos = Add(BrHist.pos, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// FETCH + RENDER — uses BrState.cur_url / cur_url_len
// All intermediate state saved to FixedPool to survive function calls.
// =============================================================================
Function.Br_FetchAndRender {
    Output: Integer
    Body: {
        // Fetch using current URL from state
        PrintMessage("[Browser] Fetching: ")
        PrintString(BrState.cur_url)
        PrintMessage("\n")

        url_h = URL_Parse(BrState.cur_url, BrState.cur_url_len)
        IfCondition LessThan(url_h, 0) ThenBlock: {
            PrintMessage("[Browser] URL parse failed\n")
            ReturnValue(0)
        }

        BrPipe.resp = HTTP_Get(url_h)
        IfCondition LessThan(BrPipe.resp, 0) ThenBlock: {
            PrintMessage("[Browser] HTTP fetch failed\n")
            ReturnValue(0)
        }

        status = HTTP_GetStatus(BrPipe.resp)
        PrintMessage("[Browser] HTTP ")
        PrintNumber(status)
        PrintMessage("\n")

        // Save body ptr and len to FixedPool before next calls clobber resp
        BrPipe.body = HTTP_GetBody(BrPipe.resp)
        BrPipe.body_len = HTTP_GetBodyLen(BrPipe.resp)
        PrintMessage("[Browser] Body: ")
        PrintNumber(BrPipe.body_len)
        PrintMessage(" bytes\n")

        IfCondition LessEqual(BrPipe.body_len, 0) ThenBlock: {
            PrintMessage("[Browser] Empty body\n")
            ReturnValue(0)
        }

        // Tokenize
        PrintMessage("[Browser] Tokenizing...\n")
        tok_count = HTK_Tokenize(BrPipe.body, BrPipe.body_len)
        PrintMessage("[Browser] Tokens: ")
        PrintNumber(tok_count)
        PrintMessage("\n")

        // DOM — use FixedPool body since locals are clobbered
        PrintMessage("[Browser] Building DOM...\n")
        BrPipe.dom_root = DOM_ParseString(BrPipe.body, BrPipe.body_len)
        IfCondition LessThan(BrPipe.dom_root, 0) ThenBlock: {
            PrintMessage("[Browser] DOM parse failed\n")
            ReturnValue(0)
        }
        PrintMessage("[Browser] DOM nodes: ")
        PrintNumber(DOM_NodeCount())
        PrintMessage("\n")

        // CSS — find <style> blocks
        PrintMessage("[Browser] Parsing CSS...\n")
        style_node = DOM_FindByTag(BrPipe.dom_root, "style")
        IfCondition GreaterEqual(style_node, 0) ThenBlock: {
            style_text = DOM_GetText(style_node)
            IfCondition NotEqual(style_text, 0) ThenBlock: {
                style_len = StringLength(style_text)
                css_count = CSS_ParseSheet(style_text, style_len)
                PrintMessage("[Browser] CSS rules: ")
                PrintNumber(css_count)
                PrintMessage("\n")
            }
        }

        // JavaScript — execute <script> tags (may mutate DOM before layout)
        PrintMessage("[Browser] Running scripts...\n")
        js_count = JSEngine_LoadPage(BrPipe.dom_root)
        IfCondition GreaterThan(js_count, 0) ThenBlock: {
            PrintMessage("[Browser] Executed ")
            PrintNumber(js_count)
            PrintMessage(" script(s)\n")
        }

        // Layout
        PrintMessage("[Browser] Layout...\n")
        Layout_Init()
        Layout_SetViewport(BrState.canvas_w, BrState.canvas_h)
        cmd_count = Layout_Run(BrPipe.dom_root)
        PrintMessage("[Browser] Draw commands: ")
        PrintNumber(cmd_count)
        PrintMessage("  height: ")
        PrintNumber(Layout_ContentHeight())
        PrintMessage("\n")

        // Render to canvas buffer — use BrState for buf
        PrintMessage("[Browser] Rendering...\n")
        Render_Init()
        Render_SetTarget(BrState.canvas_buf, BrState.canvas_w, BrState.canvas_h)
        Render_Clear(0xFFF0F0F2)
        Render_Exec()

        // Present — use BrState for sock and win_id
        ShmCanvas_Present(BrState.sock, BrState.win_id)
        PrintMessage("[Browser] Presented to display server\n")

        ReturnValue(cmd_count)
    }
}

// =============================================================================
// MAIN — all IPC setup inline (proven pattern from calc_ipc)
// =============================================================================
SubRoutine.Main {
    Arena_Init()

    // Init browser libraries — MUST be called before any parse/fetch calls
    URL_Init()
    DNS_Init()
    HTTP_Init()
    HTK_Init()
    DOM_Init()
    CSS_Init()
    JSEngine_Init()
    BrHist_Init()

    // Set default URL
    BrState.cur_url = "http://example.com/"
    BrState.cur_url_len = 19
    BrHist_Push(BrState.cur_url, BrState.cur_url_len)

    PrintMessage("============================================\n")
    PrintMessage("  Ailang Browser — Pure Ailang Engine\n")
    PrintMessage("  No C++. No runtime. No GC.\n")
    PrintMessage("============================================\n\n")

    // ---- 1. Connect to display server ----
    sock = Socket.Create(1, 1)
    IfCondition LessThan(sock, 0) ThenBlock: {
        PrintMessage("[Browser] Socket create failed\n")
        HaltProgram
    }

    cres = Socket.ConnectUnix(sock, "/tmp/ailang_display.sock")
    IfCondition LessThan(cres, 0) ThenBlock: {
        PrintMessage("[Browser] Connect failed — is SysDisplay.x running?\n")
        Socket.Close(sock)
        HaltProgram
    }
    // Save sock to FixedPool — local vars get clobbered by function calls
    BrState.sock = sock
    PrintMessage("[Browser] Connected to display server\n")

    // ---- 2. Register ----
    Socket.SendMsg(BrState.sock, "{\"method\":\"register\",\"service\":\"browser\"}")
    PrintMessage("[Browser] Registered\n")

    // ---- 3. Create window ----
    Socket.SendMsg(BrState.sock, "{\"method\":\"window.create\",\"title\":\"Ailang Browser\",\"w\":1024,\"h\":700,\"html\":\"config/browser.html\"}")
    PrintMessage("[Browser] Sent window.create\n")

    resp = Socket.RecvMsg(BrState.sock)
    IfCondition EqualTo(resp, 0) ThenBlock: {
        PrintMessage("[Browser] No response to window.create\n")
        Socket.Close(BrState.sock)
        HaltProgram
    }

    parsed = ParseJSON(resp)
    IfCondition EqualTo(parsed, 0) ThenBlock: {
        PrintMessage("[Browser] Failed to parse response\n")
        Socket.Close(BrState.sock)
        HaltProgram
    }

    pobj = JSON.AsObject(parsed)
    wid = JSON.GetNumber(pobj, "win_id")
    BrState.win_id = wid
    JSON.Free(parsed)
    PrintMessage("[Browser] Window created, win_id=")
    PrintNumber(BrState.win_id)
    PrintMessage("\n")

    // ---- 4. Create ShmCanvas ----
    canvas_buf = ShmCanvas_Create(BrState.win_id, BrState.canvas_w, BrState.canvas_h)
    IfCondition EqualTo(canvas_buf, 0) ThenBlock: {
        PrintMessage("[Browser] ShmCanvas_Create failed\n")
        Socket.Close(BrState.sock)
        HaltProgram
    }
    BrState.canvas_buf = canvas_buf

    ShmCanvas_Attach(BrState.sock, BrState.win_id, BrState.canvas_w, BrState.canvas_h)
    PrintMessage("[Browser] Canvas attached\n")

    // Clear to white initially
    ShmCanvas_Clear(0xFFFFFFFF)
    ShmCanvas_Present(BrState.sock, BrState.win_id)

    // ---- 5. Fetch, parse, layout, render ----
    PrintMessage("[Browser] === Starting fetch+render ===\n")
    fr = Br_FetchAndRender()
    PrintMessage("[Browser] === fetch+render returned: ")
    PrintNumber(fr)
    PrintMessage(" ===\n")
    IfCondition EqualTo(fr, 0) ThenBlock: {
        PrintMessage("[Browser] Page load failed — showing error\n")
        Render_Init()
        Render_SetTarget(BrState.canvas_buf, BrState.canvas_w, BrState.canvas_h)
        Render_Clear(0xFFFFFFFF)
        Render_DrawTextBg(20, 20, "Failed to load page", 19, 0xFF0000FF)
        ShmCanvas_Present(BrState.sock, BrState.win_id)
    }

    // ---- 6. Event loop ----
    Socket.SetNonBlock(BrState.sock)

    // Save ts_tick to FixedPool so it survives function calls in loop
    BrState.ts_tick = Allocate(16)
    StoreValue(BrState.ts_tick, 0)
    StoreValue(Add(BrState.ts_tick, 8), 50000000)

    PrintMessage("[Browser] Entering event loop, running=")
    PrintNumber(BrState.running)
    PrintMessage("\n")

    WhileLoop EqualTo(BrState.running, 1) {
        msg = Socket.RecvMsg(BrState.sock)
        IfCondition NotEqual(msg, 0) ThenBlock: {
            PrintMessage("[Browser] Got IPC msg\n")
            pmsg = ParseJSON(msg)
            IfCondition NotEqual(pmsg, 0) ThenBlock: {
                mobj = JSON.AsObject(pmsg)
                method = JSON.GetString(mobj, "method")

                IfCondition NotEqual(method, 0) ThenBlock: {
                    PrintMessage("[Browser] method=")
                    PrintMessage(method)
                    PrintMessage("\n")

                    cmp_closed = StringCompare(method, "window.closed")
                    IfCondition EqualTo(cmp_closed, 0) ThenBlock: {
                        PrintMessage("[Browser] Window closed\n")
                        BrState.running = 0
                    }

                    cmp_action = StringCompare(method, "input.action")
                    IfCondition EqualTo(cmp_action, 0) ThenBlock: {
                        action = JSON.GetString(mobj, "action")
                        IfCondition NotEqual(action, 0) ThenBlock: {
                            PrintMessage("[Browser] Action: ")
                            PrintMessage(action)
                            PrintMessage("\n")

                            // Back
                            cmp_back = StringCompare(action, "lb.back")
                            IfCondition EqualTo(cmp_back, 0) ThenBlock: {
                                nav_ok = BrHist_Back()
                                IfCondition EqualTo(nav_ok, 1) ThenBlock: {
                                    PrintMessage("[Browser] Navigate back\n")
                                    Br_FetchAndRender()
                                }
                            }

                            // Forward
                            cmp_fwd = StringCompare(action, "lb.fwd")
                            IfCondition EqualTo(cmp_fwd, 0) ThenBlock: {
                                nav_ok = BrHist_Fwd()
                                IfCondition EqualTo(nav_ok, 1) ThenBlock: {
                                    PrintMessage("[Browser] Navigate forward\n")
                                    Br_FetchAndRender()
                                }
                            }

                            // Reload
                            cmp_reload = StringCompare(action, "lb.reload")
                            IfCondition EqualTo(cmp_reload, 0) ThenBlock: {
                                PrintMessage("[Browser] Reload\n")
                                Br_FetchAndRender()
                            }

                            // Address bar navigate
                            cmp_addr = StringCompare(action, "addr.go")
                            IfCondition EqualTo(cmp_addr, 0) ThenBlock: {
                                new_url = JSON.GetString(mobj, "text")
                                IfCondition NotEqual(new_url, 0) ThenBlock: {
                                    PrintMessage("[Browser] Navigate to: ")
                                    PrintMessage(new_url)
                                    PrintMessage("\n")
                                    BrState.cur_url = new_url
                                    BrState.cur_url_len = StringLength(new_url)
                                    BrHist_Push(BrState.cur_url, BrState.cur_url_len)
                                    Br_FetchAndRender()
                                }
                            }
                        }
                    }
                }

                JSON.Free(pmsg)
            }
        }

        SystemCall(BrSys.SYS_NANOSLEEP, BrState.ts_tick, 0)
    }

    // ---- 7. Cleanup ----
    JSEngine_Shutdown()
    Deallocate(BrState.ts_tick, 16)
    ShmCanvas_Destroy(BrState.win_id)
    Socket.Close(BrState.sock)

    PrintMessage("\n============================================\n")
    PrintMessage("  Ailang Browser finished\n")
    PrintMessage("============================================\n")
}

RunTask(Main)
