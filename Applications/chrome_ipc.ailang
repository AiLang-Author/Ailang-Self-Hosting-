// chrome_ipc.ailang
// Sandboxed Chrome browser — runs Chrome inside Xvfb, reads framebuffer
// directly via mmap of /tmp/Xvfb_screen0 (xwd format), streams BGRA pixels
// through ShmCanvas to the display server. No ffmpeg needed.
//
// Architecture:
//   Manages 3 child processes:
//     1. Xvfb :99 -screen 0 WxHx24 -ac -fbdir /tmp  (virtual X server)
//     2. google-chrome --display=:99 ...               (browser, isolated)
//     3. xdotool - (persistent pipe)                   (input forwarding)
//
//   Frame loop (direct mmap — no pipe, no encoding):
//     - Xvfb writes pixels to /tmp/Xvfb_screen0 (mmap'd shared file)
//     - Chrome app mmaps the same file read-only
//     - Each tick: MemoryCopy from xvfb mmap (offset 3232) to shm canvas
//     - ShmCanvas_Present() -> server blits
//
//   Input forwarding (persistent pipe — no fork/exec per event):
//     - input.key -> write "key <keysym>\n" to xdotool stdin pipe
//     - input.mouse -> write "mousemove/mousedown/mouseup\n" to pipe
//     - input.action -> toolbar: back/fwd/reload/close
//
// Security model:
//   - Chrome runs in its own X session, never sees /dev/fb0
//   - No GPU access (--disable-gpu), software rendering only
//   - --no-first-run --disable-sync --disable-extensions
//   - --mute-audio (no audio capture initially)
//
// Prerequisites: sudo apt install xvfb xdotool google-chrome-stable
//
// Build: ./ailang.x Testcode/chrome_ipc.ailang chrome_ipc.x
// Run:   ./chrome_ipc.x  (after SysDisplay.x is running)
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.StringUtils
LibraryImport.JSON
LibraryImport.Hash
LibraryImport.ShmCanvas

// =============================================================================
// SYSCALL CONSTANTS
// =============================================================================
FixedPool.CSys {
    "SYS_READ":      Initialize=0
    "SYS_WRITE":     Initialize=1
    "SYS_OPEN":      Initialize=2
    "SYS_CLOSE":     Initialize=3
    "SYS_STAT":      Initialize=4
    "SYS_FSTAT":     Initialize=5
    "SYS_MMAP":      Initialize=9
    "SYS_MUNMAP":    Initialize=11
    "SYS_PIPE":      Initialize=22
    "SYS_DUP2":      Initialize=33
    "SYS_FORK":      Initialize=57
    "SYS_EXECVE":    Initialize=59
    "SYS_EXIT":      Initialize=60
    "SYS_KILL":      Initialize=62
    "SYS_WAIT4":     Initialize=61
    "SYS_FCNTL":     Initialize=72
    "SYS_NANOSLEEP": Initialize=35
    "SYS_UNLINK":    Initialize=87
    "SYS_GETUID":    Initialize=102
    "SYS_SETUID":    Initialize=105
    "SYS_SETGID":    Initialize=106
    "SYS_SETSID":    Initialize=112
}

FixedPool.CMmap {
    "O_RDONLY":    Initialize=0
    "PROT_READ":   Initialize=1
    "MAP_SHARED":  Initialize=1
}

FixedPool.CFcntl {
    "F_GETFL":    Initialize=3
    "F_SETFL":    Initialize=4
    "O_NONBLOCK": Initialize=2048
}

FixedPool.CSig {
    "SIGTERM":  Initialize=15
    "SIGSTOP":  Initialize=19
    "SIGCONT":  Initialize=18
    "WNOHANG":  Initialize=1
}

// =============================================================================
// STATE
// =============================================================================
FixedPool.ChromeState {
    "running":      Initialize=1
    "win_id":       Initialize=0
    "sock":         Initialize=0
    "canvas_w":     Initialize=1024
    "canvas_h":     Initialize=700
    "xvfb_pid":     Initialize=0
    "chrome_pid":   Initialize=0
    "xdotool_pid":  Initialize=0
    "xdotool_wr":   Initialize=-1
    "frame_size":   Initialize=0
    "display_num":  Initialize=99
    "capturing":    Initialize=0
    "mouse_skip":   Initialize=0
    "pending_mx":   Initialize=0
    "pending_my":   Initialize=0
    "mouse_dirty":  Initialize=0
    "cmd_buf":      Initialize=0
    "xvfb_fb_ptr":  Initialize=0
    "xvfb_fb_fd":   Initialize=-1
    "xvfb_fb_size": Initialize=0
    "xvfb_w":       Initialize=1920
    "xvfb_h":       Initialize=1080
}

// XWD header: 160 byte header + 256 colors * 12 bytes = 3232 byte pixel offset
FixedPool.XvfbConst {
    "PIXEL_OFFSET": Initialize=3232
    "SYS_MKDIR":    Initialize=83
    "DIR_MODE":     Initialize=493
}

// PID file constants — O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 = 577, mode 0644 = 420
FixedPool.CPid {
    "O_WRCREAT": Initialize=577
    "FMODE":     Initialize=420
}

// =============================================================================
// KEYMAP — scancode to X11 keysym name for xdotool
// We store keysym strings for special keys; printable chars use xdotool type.
// =============================================================================

// =============================================================================
// NUM TO STRING
// =============================================================================
Function.Chrome_NumToStr {
    Input: val: Integer
    Input: buf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            SetByte(buf, 1, 0)
            ReturnValue(1)
        }
        tmp = Allocate(24)
        n = 0
        v = val
        WhileLoop GreaterThan(v, 0) {
            SetByte(tmp, n, Add(48, Modulo(v, 10)))
            v = Divide(v, 10)
            n = Add(n, 1)
        }
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(buf, i, GetByte(tmp, Subtract(Subtract(n, 1), i)))
            i = Add(i, 1)
        }
        SetByte(buf, n, 0)
        Deallocate(tmp, 24)
        ReturnValue(n)
    }
}

// =============================================================================
// PID FILE — write PID to /tmp/<name>.pid for crash recovery
// =============================================================================
Function.Chrome_WritePidFile {
    Input: path: Address
    Input: pid: Integer
    Body: {
        fd = SystemCall(CSys.SYS_OPEN, path, CPid.O_WRCREAT, CPid.FMODE)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(16)
        nlen = Chrome_NumToStr(pid, buf)
        SetByte(buf, nlen, 10)
        SystemCall(CSys.SYS_WRITE, fd, buf, Add(nlen, 1), 0, 0)
        SystemCall(CSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        Deallocate(buf, 16)
    }
}

// =============================================================================
// PID FILE — read PID from file, returns 0 on failure
// =============================================================================
Function.Chrome_ReadPidFile {
    Input: path: Address
    Output: Integer
    Body: {
        fd = SystemCall(CSys.SYS_OPEN, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(16)
        MemorySet(buf, 0, 16)
        nr = SystemCall(CSys.SYS_READ, fd, buf, 15, 0, 0)
        SystemCall(CSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        IfCondition LessEqual(nr, 0) ThenBlock: {
            Deallocate(buf, 16)
            ReturnValue(0)
        }
        pid = 0
        i = 0
        WhileLoop LessThan(i, nr) {
            ch = GetByte(buf, i)
            IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                pid = Add(Multiply(pid, 10), Subtract(ch, 48))
            } ElseBlock: {
                IfCondition GreaterThan(pid, 0) ThenBlock: { i = nr }
            }
            i = Add(i, 1)
        }
        Deallocate(buf, 16)
        ReturnValue(pid)
    }
}

// =============================================================================
// KILL STALE PID — try SIGKILL, report EPERM (can't kill root-owned orphan)
// Returns: 1=killed, 0=no such process, -1=permission denied
// =============================================================================
Function.Chrome_KillStalePid {
    Input: pid: Integer
    Input: label: Address
    Output: Integer
    Body: {
        IfCondition LessEqual(pid, 1) ThenBlock: { ReturnValue(0) }
        kr = SystemCall(CSys.SYS_KILL, pid, 9, 0, 0, 0)
        IfCondition EqualTo(kr, 0) ThenBlock: {
            PrintMessage("[Chrome] Killed stale ")
            PrintMessage(label)
            PrintMessage(" pid=")
            PrintNumber(pid)
            PrintMessage("\n")
            ReturnValue(1)
        }
        // -1 = EPERM (permission denied — root-owned process)
        neg_one = Subtract(0, 1)
        IfCondition EqualTo(kr, neg_one) ThenBlock: {
            PrintMessage("[Chrome] ERROR: Stale ")
            PrintMessage(label)
            PrintMessage(" pid=")
            PrintNumber(pid)
            PrintMessage(" owned by another user. Run: sudo kill -9 ")
            PrintNumber(pid)
            PrintMessage("\n")
            ReturnValue(-1)
        }
        // -3 = ESRCH (no such process) — already dead, fine
        ReturnValue(0)
    }
}

// =============================================================================
// REMOVE PID FILES — called from StopAll
// =============================================================================
Function.Chrome_RemovePidFiles {
    Body: {
        SystemCall(CSys.SYS_UNLINK, "/tmp/chrome_ailang_xvfb.pid", 0, 0, 0, 0)
        SystemCall(CSys.SYS_UNLINK, "/tmp/chrome_ailang_browser.pid", 0, 0, 0, 0)
        SystemCall(CSys.SYS_UNLINK, "/tmp/chrome_ailang_xdotool.pid", 0, 0, 0, 0)
    }
}

// =============================================================================
// DROP PRIVILEGES — if running as root, drop to owner of /home/bob
// Called in child fork BEFORE execve. stat() gets real user's UID/GID,
// then setgid + setuid. Prevents Electron "don't run as root" refusal.
// x86-64 struct stat: st_uid at offset 28 (dword), st_gid at offset 32 (dword)
// =============================================================================
Function.Chrome_EnsureJail {
    Body: {
        SystemCall(XvfbConst.SYS_MKDIR, "/data", 493, 0, 0, 0)
        SystemCall(XvfbConst.SYS_MKDIR, "/data/sandboxes", 493, 0, 0, 0)
        SystemCall(XvfbConst.SYS_MKDIR, "/data/sandboxes/chrome", 493, 0, 0, 0)
        SystemCall(XvfbConst.SYS_MKDIR, "/data/sandboxes/chrome/home", 493, 0, 0, 0)
        SystemCall(XvfbConst.SYS_MKDIR, "/data/sandboxes/chrome/tmp", 493, 0, 0, 0)
        SystemCall(XvfbConst.SYS_MKDIR, "/data/sandboxes/chrome/home/.chrome", 493, 0, 0, 0)
        sb = Allocate(144)
        sr = SystemCall(CSys.SYS_STAT, "/home/bob", sb, 0, 0, 0)
        IfCondition GreaterEqual(sr, 0) ThenBlock: {
            ruid = Dereference(Add(sb, 28), "dword")
            rgid = Dereference(Add(sb, 32), "dword")
            IfCondition GreaterThan(ruid, 0) ThenBlock: {
                SystemCall(92, "/data/sandboxes/chrome",  ruid, rgid, 0, 0)
                SystemCall(92, "/data/sandboxes/chrome/home", ruid, rgid, 0, 0)
                SystemCall(92, "/data/sandboxes/chrome/tmp", ruid, rgid, 0, 0)
                SystemCall(92, "/data/sandboxes/chrome/home/.chrome", ruid, rgid, 0, 0)
            }
        }
        Deallocate(sb, 144)
        // Chromium shm fallback needs W_OK|X_OK on TMPDIR (01777).
        Chrome_ShellExec("chmod 1777 /data/sandboxes/chrome/tmp")
        PrintMessage("[Chrome] jail /data/sandboxes/chrome ready\n")
    }
}

Function.Chrome_DropPriv {
    Body: {
        uid = SystemCall(CSys.SYS_GETUID, 0, 0, 0, 0, 0)
        IfCondition NotEqual(uid, 0) ThenBlock: { ReturnValue(0) }

        sb = Allocate(144)
        sr = SystemCall(CSys.SYS_STAT, "/home/bob", sb, 0, 0, 0)
        IfCondition LessThan(sr, 0) ThenBlock: {
            Deallocate(sb, 144)
            ReturnValue(0)
        }

        ruid = Dereference(Add(sb, 28), "dword")
        rgid = Dereference(Add(sb, 32), "dword")
        Deallocate(sb, 144)

        IfCondition EqualTo(ruid, 0) ThenBlock: { ReturnValue(0) }

        SystemCall(CSys.SYS_SETGID, rgid, 0, 0, 0, 0)
        SystemCall(CSys.SYS_SETUID, ruid, 0, 0, 0, 0)
    }
}

// =============================================================================
// BUILD SIZE STRING — "WxH" from canvas_w and canvas_h
// =============================================================================
Function.Chrome_BuildSizeStr {
    Output: Integer
    Body: {
        buf = Allocate(24)
        w_tmp = Allocate(12)
        h_tmp = Allocate(12)
        wlen = Chrome_NumToStr(ChromeState.canvas_w, w_tmp)
        hlen = Chrome_NumToStr(ChromeState.canvas_h, h_tmp)
        MemoryCopy(buf, w_tmp, wlen)
        SetByte(buf, wlen, 120)
        MemoryCopy(Add(buf, Add(wlen, 1)), h_tmp, hlen)
        SetByte(buf, Add(Add(wlen, 1), hlen), 0)
        Deallocate(w_tmp, 12)
        Deallocate(h_tmp, 12)
        ReturnValue(buf)
    }
}

// =============================================================================
// BUILD XVFB SIZE — "WxHx24" from canvas_w and canvas_h
// =============================================================================
Function.Chrome_BuildXvfbSize {
    Output: Integer
    Body: {
        buf = Allocate(32)
        w_tmp = Allocate(12)
        h_tmp = Allocate(12)
        wlen = Chrome_NumToStr(ChromeState.xvfb_w, w_tmp)
        hlen = Chrome_NumToStr(ChromeState.xvfb_h, h_tmp)
        off = 0
        MemoryCopy(buf, w_tmp, wlen)
        off = wlen
        SetByte(buf, off, 120)
        off = Add(off, 1)
        MemoryCopy(Add(buf, off), h_tmp, hlen)
        off = Add(off, hlen)
        // "x24"
        SetByte(buf, off, 120)
        SetByte(buf, Add(off, 1), 50)
        SetByte(buf, Add(off, 2), 52)
        off = Add(off, 3)
        SetByte(buf, off, 0)
        Deallocate(w_tmp, 12)
        Deallocate(h_tmp, 12)
        ReturnValue(buf)
    }
}

// =============================================================================
// BUILD CHROME WINDOW SIZE — "W,H" for --window-size=W,H
// =============================================================================
Function.Chrome_BuildWinSize {
    Output: Integer
    Body: {
        buf = Allocate(24)
        w_tmp = Allocate(12)
        h_tmp = Allocate(12)
        // Match the Auckland content canvas, not the Xvfb screen.
        wlen = Chrome_NumToStr(ChromeState.canvas_w, w_tmp)
        hlen = Chrome_NumToStr(ChromeState.canvas_h, h_tmp)
        off = 0
        MemoryCopy(buf, w_tmp, wlen)
        off = wlen
        SetByte(buf, off, 44)
        off = Add(off, 1)
        MemoryCopy(Add(buf, off), h_tmp, hlen)
        off = Add(off, hlen)
        SetByte(buf, off, 0)
        Deallocate(w_tmp, 12)
        Deallocate(h_tmp, 12)
        ReturnValue(buf)
    }
}

// =============================================================================
// BUILD DISPLAY STRING — ":99" (or whatever display_num is)
// =============================================================================
Function.Chrome_BuildDisplayStr {
    Output: Integer
    Body: {
        buf = Allocate(8)
        SetByte(buf, 0, 58)
        nbuf = Allocate(8)
        nlen = Chrome_NumToStr(ChromeState.display_num, nbuf)
        MemoryCopy(Add(buf, 1), nbuf, nlen)
        SetByte(buf, Add(1, nlen), 0)
        Deallocate(nbuf, 8)
        ReturnValue(buf)
    }
}

// =============================================================================
// SHELL HELPER — fork/exec /bin/sh -c "<cmd>". Waits for completion.
// More reliable than pkill alone — shell handles globbing, multiple commands.
// =============================================================================
Function.Chrome_ShellExec {
    Input: cmd: Address
    Body: {
        pid = SystemCall(CSys.SYS_FORK, 0, 0, 0, 0, 0)
        IfCondition EqualTo(pid, 0) ThenBlock: {
            argv = Allocate(32)
            StoreValue(Add(argv, 0), "/bin/sh")
            StoreValue(Add(argv, 8), "-c")
            StoreValue(Add(argv, 16), cmd)
            StoreValue(Add(argv, 24), 0)
            SystemCall(CSys.SYS_EXECVE, "/bin/sh", argv, 0)
            SystemCall(CSys.SYS_EXIT, 0)
        }
        IfCondition GreaterThan(pid, 0) ThenBlock: {
            status = Allocate(8)
            SystemCall(CSys.SYS_WAIT4, pid, status, 0, 0, 0, 0)
            Deallocate(status, 8)
        }
    }
}

// =============================================================================
// KILL PROCESS GROUP — kill(-pgid, SIGKILL) to kill entire session group
// Since Chrome/Xvfb children call setsid(), their PID = PGID.
// This kills ONLY our sandboxed processes, never the desktop Chrome.
// =============================================================================
Function.Chrome_KillGroup {
    Input: pid: Integer
    Body: {
        IfCondition GreaterThan(pid, 0) ThenBlock: {
            // kill(-pid, 9) = SIGKILL entire process group rooted at pid
            neg_pid = Subtract(0, pid)
            SystemCall(CSys.SYS_KILL, neg_pid, 9, 0, 0, 0)
        }
    }
}

// =============================================================================
// CLEANUP STALE — kill orphaned processes from prior crash using PID files.
// PID files give us exact PIDs — no broad pkill that could hit desktop apps.
// If kill fails with EPERM (root-owned orphan), prints sudo command for user.
// =============================================================================
Function.Chrome_CleanupStaleXvfb {
    Body: {
        PrintMessage("[Chrome] Checking for orphaned processes...\n")
        had_error = 0

        // 1. Kill stale Chrome browser (process group — kills all subprocesses)
        cpid = Chrome_ReadPidFile("/tmp/chrome_ailang_browser.pid")
        IfCondition GreaterThan(cpid, 1) ThenBlock: {
            // Kill entire process group (setsid'd, so PID=PGID)
            Chrome_KillGroup(cpid)
            cr = Chrome_KillStalePid(cpid, "Chrome")
            neg_one = Subtract(0, 1)
            IfCondition EqualTo(cr, neg_one) ThenBlock: { had_error = 1 }
        }

        // 2. Kill stale xdotool
        dpid = Chrome_ReadPidFile("/tmp/chrome_ailang_xdotool.pid")
        IfCondition GreaterThan(dpid, 1) ThenBlock: {
            Chrome_KillStalePid(dpid, "xdotool")
        }

        // 3. Kill stale Xvfb (must be last — Xvfb holds the display lock)
        xpid = Chrome_ReadPidFile("/tmp/chrome_ailang_xvfb.pid")
        IfCondition GreaterThan(xpid, 1) ThenBlock: {
            xr = Chrome_KillStalePid(xpid, "Xvfb")
            neg_one = Subtract(0, 1)
            IfCondition EqualTo(xr, neg_one) ThenBlock: { had_error = 1 }
        }

        // Wait 200ms for processes to die
        ts = Allocate(16)
        StoreValue(ts, 0)
        StoreValue(Add(ts, 8), 200000000)
        SystemCall(CSys.SYS_NANOSLEEP, ts, 0)
        Deallocate(ts, 16)

        // Remove PID files
        Chrome_RemovePidFiles()

        // Remove stale lock/socket/framebuffer files
        SystemCall(CSys.SYS_UNLINK, "/tmp/.X99-lock", 0, 0, 0, 0)
        SystemCall(CSys.SYS_UNLINK, "/tmp/.X11-unix/X99", 0, 0, 0, 0)
        SystemCall(CSys.SYS_UNLINK, "/tmp/chrome_fb/Xvfb_screen0", 0, 0, 0, 0)
        Chrome_ShellExec("rmdir /tmp/chrome_fb 2>/dev/null")

        // Jail v0: persist /data/sandboxes/chrome/home/.chrome — do not wipe.

        IfCondition EqualTo(had_error, 1) ThenBlock: {
            PrintMessage("[Chrome] WARNING: Some processes could not be killed (see above)\n")
            PrintMessage("[Chrome] Kill them manually, then restart chrome_ipc.x\n")
        } ElseBlock: {
            PrintMessage("[Chrome] Cleanup complete\n")
        }
    }
}

// =============================================================================
// LAUNCH XVFB — fork/exec Xvfb :99 -screen 0 WxHx24 -ac -fbdir /tmp
// =============================================================================
Function.Chrome_LaunchXvfb {
    Output: Integer
    Body: {
        disp_str = Chrome_BuildDisplayStr()
        size_str = Chrome_BuildXvfbSize()

        pid = SystemCall(CSys.SYS_FORK, 0, 0, 0, 0, 0)
        IfCondition LessThan(pid, 0) ThenBlock: {
            PrintMessage("[Chrome] Xvfb fork failed\n")
            ReturnValue(-1)
        }

        IfCondition EqualTo(pid, 0) ThenBlock: {
            // ===== CHILD =====
            Chrome_DropPriv()

            // Redirect stdout/stderr to /dev/null — prevents TTY corruption
            devnull = SystemCall(CSys.SYS_OPEN, "/dev/null", 1, 0)
            SystemCall(CSys.SYS_DUP2, devnull, 1, 0, 0, 0)
            SystemCall(CSys.SYS_DUP2, devnull, 2, 0, 0, 0)
            SystemCall(CSys.SYS_CLOSE, devnull, 0, 0, 0, 0)

            // Ensure /tmp/chrome_fb/ exists (separate from VSCode's fbdir)
            SystemCall(XvfbConst.SYS_MKDIR, "/tmp/chrome_fb", XvfbConst.DIR_MODE)

            // Xvfb :99 -screen 0 WxHx24 -ac -fbdir /tmp/chrome_fb
            argv = Allocate(72)
            StoreValue(Add(argv, 0),  "/usr/bin/Xvfb")
            StoreValue(Add(argv, 8),  disp_str)
            StoreValue(Add(argv, 16), "-screen")
            StoreValue(Add(argv, 24), "0")
            StoreValue(Add(argv, 32), size_str)
            StoreValue(Add(argv, 40), "-ac")
            StoreValue(Add(argv, 48), "-fbdir")
            StoreValue(Add(argv, 56), "/tmp/chrome_fb")
            StoreValue(Add(argv, 64), 0)

            SystemCall(CSys.SYS_EXECVE, "/usr/bin/Xvfb", argv, 0)
            PrintMessage("[Chrome] Xvfb execve failed\n")
            SystemCall(CSys.SYS_EXIT, 1)
        }

        // ===== PARENT =====
        ChromeState.xvfb_pid = pid
        Chrome_WritePidFile("/tmp/chrome_ailang_xvfb.pid", pid)
        PrintMessage("[Chrome] Xvfb launched pid=")
        PrintNumber(pid)
        PrintMessage("\n")
        ReturnValue(pid)
    }
}

// =============================================================================
// LAUNCH CHROME — fork/exec google-chrome with sandboxed flags
// =============================================================================
Function.Chrome_LaunchBrowser {
    Output: Integer
    Body: {
        disp_str = Chrome_BuildDisplayStr()
        win_size = Chrome_BuildWinSize()

        // Build --window-size=W,H
        ws_arg = Allocate(48)
        MemoryCopy(ws_arg, "--window-size=", 14)
        wsl = StringLength(win_size)
        MemoryCopy(Add(ws_arg, 14), win_size, wsl)
        SetByte(ws_arg, Add(14, wsl), 0)

        // Build --display=:99
        dd_arg = Allocate(24)
        MemoryCopy(dd_arg, "--display=", 10)
        dsl = StringLength(disp_str)
        MemoryCopy(Add(dd_arg, 10), disp_str, dsl)
        SetByte(dd_arg, Add(10, dsl), 0)

        pid = SystemCall(CSys.SYS_FORK, 0, 0, 0, 0, 0)
        IfCondition LessThan(pid, 0) ThenBlock: {
            PrintMessage("[Chrome] Chrome fork failed\n")
            ReturnValue(-1)
        }

        IfCondition EqualTo(pid, 0) ThenBlock: {
            // ===== CHILD =====
            Chrome_DropPriv()
            // New session so Chrome's children don't inherit our terminal
            SystemCall(CSys.SYS_SETSID)

            logfd = SystemCall(CSys.SYS_OPEN, "/tmp/chrome.child.log", 577, 420)
            IfCondition GreaterEqual(logfd, 0) ThenBlock: {
                SystemCall(CSys.SYS_DUP2, logfd, 1, 0, 0, 0)
                SystemCall(CSys.SYS_DUP2, logfd, 2, 0, 0, 0)
                IfCondition GreaterThan(logfd, 2) ThenBlock: {
                    SystemCall(CSys.SYS_CLOSE, logfd, 0, 0, 0, 0)
                }
            }

            // Exec the ELF, not /usr/bin/google-chrome-stable (that script
            // needs /dev/fd and looks for ./chrome next to itself).
            // Regular window, not --app: Chrome paints its own tab strip,
            // URL bar, and back/fwd. Auckland only supplies the OS frame.
            argv = Allocate(208)
            StoreValue(Add(argv, 0),   "/opt/google/chrome/chrome")
            StoreValue(Add(argv, 8),   dd_arg)
            StoreValue(Add(argv, 16),  "--no-sandbox")
            StoreValue(Add(argv, 24),  "--disable-gpu")
            StoreValue(Add(argv, 32),  ws_arg)
            StoreValue(Add(argv, 40),  "--window-position=0,0")
            StoreValue(Add(argv, 48),  "--hide-crash-restore-bubble")
            StoreValue(Add(argv, 56),  "--no-first-run")
            StoreValue(Add(argv, 64),  "--disable-sync")
            StoreValue(Add(argv, 72),  "--disable-extensions")
            StoreValue(Add(argv, 80),  "--disable-default-apps")
            StoreValue(Add(argv, 88),  "--mute-audio")
            StoreValue(Add(argv, 96),  "--user-data-dir=/data/sandboxes/chrome/home/.chrome")
            StoreValue(Add(argv, 104), "--disable-dev-shm-usage")
            StoreValue(Add(argv, 112), "--disable-features=MediaDrmPreprovisioning,TranslateUI,Dbus,OptimizationGuide,OnDeviceModel")
            StoreValue(Add(argv, 120), "--autoplay-policy=no-user-gesture-required")
            StoreValue(Add(argv, 128), "--crash-dumps-dir=/data/sandboxes/chrome/tmp")
            StoreValue(Add(argv, 136), "--disable-breakpad")
            // Hides "unsupported command-line flag: --no-sandbox".
            // --disable-infobars is a no-op in Chrome 145.
            StoreValue(Add(argv, 144), "--test-type")
            StoreValue(Add(argv, 152), "--ozone-platform=x11")
            StoreValue(Add(argv, 160), "--disable-component-update")
            StoreValue(Add(argv, 168), "--disk-cache-size=1")
            StoreValue(Add(argv, 176), "https://www.google.com/")
            StoreValue(Add(argv, 184), 0)

            // No dbus-daemon / systemd. NSS finds sqlite via LD_LIBRARY_PATH.
            envp = Allocate(112)
            denv = Allocate(24)
            MemoryCopy(denv, "DISPLAY=", 8)
            MemoryCopy(Add(denv, 8), disp_str, Add(dsl, 1))
            StoreValue(Add(envp, 0),  denv)
            StoreValue(Add(envp, 8),  "HOME=/data/sandboxes/chrome/home")
            StoreValue(Add(envp, 16), "TMPDIR=/data/sandboxes/chrome/tmp")
            StoreValue(Add(envp, 24), "XDG_RUNTIME_DIR=/data/sandboxes/chrome/tmp")
            StoreValue(Add(envp, 32), "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")
            StoreValue(Add(envp, 40), "LANG=en_US.UTF-8")
            StoreValue(Add(envp, 48), "FONTCONFIG_PATH=/etc/fonts")
            StoreValue(Add(envp, 56), "LD_LIBRARY_PATH=/opt/google/chrome:/usr/lib:/usr/lib/x86_64-linux-gnu")
            StoreValue(Add(envp, 64), "NSS_LIBDIR=/opt/google/chrome")
            StoreValue(Add(envp, 72), "XDG_SESSION_TYPE=x11")
            StoreValue(Add(envp, 80), "USER=bob")
            StoreValue(Add(envp, 88), 0)

            SystemCall(CSys.SYS_EXECVE, "/opt/google/chrome/chrome", argv, envp)
            PrintMessage("[Chrome] Chrome execve failed\n")
            SystemCall(CSys.SYS_EXIT, 1)
        }

        // ===== PARENT =====
        ChromeState.chrome_pid = pid
        Chrome_WritePidFile("/tmp/chrome_ailang_browser.pid", pid)
        PrintMessage("[Chrome] Chrome launched pid=")
        PrintNumber(pid)
        PrintMessage("\n")
        ReturnValue(pid)
    }
}

// =============================================================================
// MMAP XVFB FRAMEBUFFER — open /tmp/Xvfb_screen0 and mmap it read-only
// Xvfb -fbdir /tmp writes the framebuffer in xwd format:
//   3232 bytes header (160 header + 256 colors * 12 bytes) + pixel data
// Pixel format: BGRX (32bpp, LSBFirst) — same as BGRA with alpha=0
// Returns: 1 on success, -1 on failure
// =============================================================================
Function.Chrome_MmapFB {
    Output: Integer
    Body: {
        // Open the xvfb framebuffer file
        fd = SystemCall(CSys.SYS_OPEN, "/tmp/chrome_fb/Xvfb_screen0", CMmap.O_RDONLY, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[Chrome] Failed to open /tmp/Xvfb_screen0\n")
            ReturnValue(-1)
        }

        // Calculate total file size: header + pixels
        fsize = ChromeState.frame_size
        total = Add(XvfbConst.PIXEL_OFFSET, fsize)

        // mmap(NULL, total, PROT_READ, MAP_SHARED, fd, 0)
        ptr = SystemCall(CSys.SYS_MMAP, 0, total, CMmap.PROT_READ, CMmap.MAP_SHARED, fd, 0)
        IfCondition LessThan(ptr, 0) ThenBlock: {
            PrintMessage("[Chrome] mmap /tmp/Xvfb_screen0 failed\n")
            SystemCall(CSys.SYS_CLOSE, fd, 0, 0, 0, 0)
            ReturnValue(-1)
        }

        ChromeState.xvfb_fb_ptr  = ptr
        ChromeState.xvfb_fb_fd   = fd
        ChromeState.xvfb_fb_size = total
        ChromeState.capturing    = 1

        PrintMessage("[Chrome] mmap'd Xvfb framebuffer: ptr=")
        PrintNumber(ptr)
        PrintMessage(" size=")
        PrintNumber(total)
        PrintMessage(" pixel_offset=")
        PrintNumber(XvfbConst.PIXEL_OFFSET)
        PrintMessage("\n")

        ReturnValue(1)
    }
}

// =============================================================================
// COPY FRAME — memcpy pixels from mmap'd Xvfb FB to shm canvas buffer
// Always succeeds (no I/O, just memory copy). Returns 1.
// =============================================================================
Function.Chrome_CopyFrame {
    Output: Integer
    Body: {
        src = ChromeState.xvfb_fb_ptr
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(-1) }

        dst = ShmCanvasState.buf
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(-1) }

        vw = ChromeState.canvas_w
        vh = ChromeState.canvas_h
        src_stride = Multiply(ChromeState.xvfb_w, 4)
        dst_stride = Multiply(vw, 4)
        src_base = Add(src, XvfbConst.PIXEL_OFFSET)

        // Fast path: full-width viewport, single copy
        IfCondition EqualTo(vw, ChromeState.xvfb_w) ThenBlock: {
            MemoryCopy(dst, src_base, Multiply(dst_stride, vh))
            Chrome_BlitCursor()
            ReturnValue(1)
        }

        // Row-by-row copy for partial-width viewport
        row = 0
        WhileLoop LessThan(row, vh) {
            src_row = Add(src_base, Multiply(row, src_stride))
            dst_row = Add(dst, Multiply(row, dst_stride))
            MemoryCopy(dst_row, src_row, dst_stride)
            row = Add(row, 1)
        }
        Chrome_BlitCursor()
        ReturnValue(1)
    }
}

// Xvfb does not composite the X cursor into Xvfb_screen0. capture_mouse
// hides the display.x pointer, so we paint a software arrow at the last
// forwarded coords. Native substitute for a logind/Xorg hardware cursor.
Function.Chrome_PutPixel {
    Input: x: Integer
    Input: y: Integer
    Input: b: Integer
    Input: g: Integer
    Input: r: Integer
    Body: {
        vw = ChromeState.canvas_w
        vh = ChromeState.canvas_h
        IfCondition LessThan(x, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(y, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(x, vw) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(y, vh) ThenBlock: { ReturnValue(0) }
        p = Add(ShmCanvasState.buf, Add(Multiply(y, Multiply(vw, 4)), Multiply(x, 4)))
        SetByte(p, 0, b)
        SetByte(p, 1, g)
        SetByte(p, 2, r)
        SetByte(p, 3, 255)
    }
}

Function.Chrome_BlitCursor {
    Body: {
        mx = ChromeState.pending_mx
        my = ChromeState.pending_my
        y = 0
        WhileLoop LessThan(y, 16) {
            maxx = y
            IfCondition GreaterThan(maxx, 10) ThenBlock: { maxx = 10 }
            IfCondition GreaterEqual(y, 12) ThenBlock: {
                maxx = 4
            }
            x = 0
            WhileLoop LessEqual(x, maxx) {
                IfCondition Or(EqualTo(x, 0), Or(EqualTo(x, maxx), Or(EqualTo(y, 0), EqualTo(y, 15)))) ThenBlock: {
                    Chrome_PutPixel(Add(mx, x), Add(my, y), 0, 0, 0)
                } ElseBlock: {
                    Chrome_PutPixel(Add(mx, x), Add(my, y), 255, 255, 255)
                }
                x = Add(x, 1)
            }
            y = Add(y, 1)
        }
    }
}

// =============================================================================
// KILL PROCESS — SIGTERM + waitpid helper
// =============================================================================
Function.Chrome_KillChild {
    Input: pid: Integer
    Body: {
        IfCondition GreaterThan(pid, 0) ThenBlock: {
            SystemCall(CSys.SYS_KILL, pid, CSig.SIGTERM, 0, 0, 0)
            status = Allocate(8)
            SystemCall(CSys.SYS_WAIT4, pid, status, CSig.WNOHANG, 0, 0, 0)
            Deallocate(status, 8)
        }
    }
}

// =============================================================================
// STOP ALL — kill xdotool, chrome, xvfb in reverse order, unmap framebuffer
// Uses process group kills (kill -PGID) to only kill OUR sandboxed processes.
// NEVER uses broad pkill that could hit desktop Chrome.
// =============================================================================
Function.Chrome_StopAll {
    Body: {
        // Close xdotool write pipe first (causes clean EOF exit), then kill
        xdt_wr = ChromeState.xdotool_wr
        IfCondition GreaterEqual(xdt_wr, 0) ThenBlock: {
            SystemCall(CSys.SYS_CLOSE, xdt_wr, 0, 0, 0, 0)
            ChromeState.xdotool_wr = -1
        }
        IfCondition GreaterThan(ChromeState.xdotool_pid, 0) ThenBlock: {
            Chrome_KillChild(ChromeState.xdotool_pid)
            PrintMessage("[Chrome] xdotool stopped pid=")
            PrintNumber(ChromeState.xdotool_pid)
            PrintMessage("\n")
            ChromeState.xdotool_pid = 0
        }

        // Kill Chrome's entire process group (renderer, gpu, zygote, crashpad, etc.)
        // Chrome did setsid() so chrome_pid IS the PGID. kill(-pgid, 9) kills the group.
        IfCondition GreaterThan(ChromeState.chrome_pid, 0) ThenBlock: {
            Chrome_KillGroup(ChromeState.chrome_pid)
            // Also SIGTERM the lead process for clean exit
            Chrome_KillChild(ChromeState.chrome_pid)
            PrintMessage("[Chrome] Chrome group killed pid=")
            PrintNumber(ChromeState.chrome_pid)
            PrintMessage("\n")
            ChromeState.chrome_pid = 0
        }

        // Unmap Xvfb framebuffer before killing Xvfb
        IfCondition GreaterThan(ChromeState.xvfb_fb_ptr, 0) ThenBlock: {
            SystemCall(CSys.SYS_MUNMAP, ChromeState.xvfb_fb_ptr, ChromeState.xvfb_fb_size)
            ChromeState.xvfb_fb_ptr = 0
        }
        IfCondition GreaterEqual(ChromeState.xvfb_fb_fd, 0) ThenBlock: {
            SystemCall(CSys.SYS_CLOSE, ChromeState.xvfb_fb_fd, 0, 0, 0, 0)
            ChromeState.xvfb_fb_fd = -1
        }

        IfCondition GreaterThan(ChromeState.xvfb_pid, 0) ThenBlock: {
            Chrome_KillChild(ChromeState.xvfb_pid)
            PrintMessage("[Chrome] Xvfb stopped pid=")
            PrintNumber(ChromeState.xvfb_pid)
            PrintMessage("\n")
            ChromeState.xvfb_pid = 0
        }

        // Wait 100ms for process group to fully die
        ts = Allocate(16)
        StoreValue(ts, 0)
        StoreValue(Add(ts, 8), 100000000)
        SystemCall(CSys.SYS_NANOSLEEP, ts, 0)
        Deallocate(ts, 16)

        // Reap zombies
        status = Allocate(8)
        reap = 0
        WhileLoop LessThan(reap, 5) {
            wr = SystemCall(CSys.SYS_WAIT4, -1, status, CSig.WNOHANG, 0, 0, 0)
            IfCondition LessEqual(wr, 0) ThenBlock: { reap = 5 }
            reap = Add(reap, 1)
        }
        Deallocate(status, 8)

        // Clean up Xvfb files so next launch starts clean
        SystemCall(CSys.SYS_UNLINK, "/tmp/.X99-lock", 0, 0, 0, 0)
        SystemCall(CSys.SYS_UNLINK, "/tmp/.X11-unix/X99", 0, 0, 0, 0)
        SystemCall(CSys.SYS_UNLINK, "/tmp/chrome_fb/Xvfb_screen0", 0, 0, 0, 0)

        // Clean up Chrome profile locks (prevents "Chrome is already running" on restart)
        Chrome_ShellExec("rm -f /tmp/chrome_ailang_profile/SingletonLock /tmp/chrome_ailang_profile/SingletonSocket /tmp/chrome_ailang_profile/SingletonCookie 2>/dev/null")

        // Remove PID files (clean exit — no orphans to find next time)
        Chrome_RemovePidFiles()

        ChromeState.capturing = 0
        PrintMessage("[Chrome] All processes stopped, files cleaned\n")
    }
}

// =============================================================================
// LAUNCH ALL — start Xvfb, wait, start Chrome, wait, mmap framebuffer
// =============================================================================
Function.Chrome_LaunchAll {
    Body: {
        ts_wait = Allocate(16)

        // 1. Launch Xvfb (with -fbdir /tmp for direct framebuffer access)
        xr = Chrome_LaunchXvfb()
        IfCondition LessThan(xr, 0) ThenBlock: {
            PrintMessage("[Chrome] Failed to fork Xvfb — is Xvfb installed? (sudo apt install xvfb)\n")
            Deallocate(ts_wait, 16)
            ReturnValue(0)
        }

        // 2. Wait 500ms for Xvfb to initialize + write /tmp/Xvfb_screen0
        StoreValue(ts_wait, 0)
        StoreValue(Add(ts_wait, 8), 500000000)
        SystemCall(CSys.SYS_NANOSLEEP, ts_wait, 0)
        PrintMessage("[Chrome] Xvfb startup wait complete\n")

        // Check if Xvfb already died (binary not found?)
        xcheck = Allocate(8)
        xw = SystemCall(CSys.SYS_WAIT4, ChromeState.xvfb_pid, xcheck, CSig.WNOHANG, 0, 0, 0)
        Deallocate(xcheck, 8)
        IfCondition EqualTo(xw, ChromeState.xvfb_pid) ThenBlock: {
            PrintMessage("[Chrome] Xvfb exited immediately — is /usr/bin/Xvfb installed? (sudo apt install xvfb)\n")
            ChromeState.xvfb_pid = 0
            Deallocate(ts_wait, 16)
            ReturnValue(0)
        }

        // 3. Quarantine home (persist profile; not FileTree)
        Chrome_EnsureJail()

        // 4. Launch Chrome
        cr = Chrome_LaunchBrowser()
        IfCondition LessThan(cr, 0) ThenBlock: {
            PrintMessage("[Chrome] Failed to fork Chrome — is google-chrome-stable installed?\n")
            Deallocate(ts_wait, 16)
            ReturnValue(0)
        }

        // 4. Wait 4s for Chrome (NSS + first paint). Do not abort mmap if
        // the pid is still alive — zygote forks are not a fatal exit.
        StoreValue(ts_wait, 4)
        StoreValue(Add(ts_wait, 8), 0)
        SystemCall(CSys.SYS_NANOSLEEP, ts_wait, 0)
        PrintMessage("[Chrome] Chrome startup wait complete\n")

        // Check if Chrome already died
        ccheck = Allocate(8)
        cw = SystemCall(CSys.SYS_WAIT4, ChromeState.chrome_pid, ccheck, CSig.WNOHANG, 0, 0, 0)
        Deallocate(ccheck, 8)
        IfCondition EqualTo(cw, ChromeState.chrome_pid) ThenBlock: {
            PrintMessage("[Chrome] Chrome exited immediately — check google-chrome-stable\n")
            ChromeState.chrome_pid = 0
            Deallocate(ts_wait, 16)
            ReturnValue(0)
        }

        // 5. Launch persistent xdotool pipe (for keyboard/mouse input)
        xr2 = Chrome_LaunchXdotool()
        IfCondition LessThan(xr2, 0) ThenBlock: {
            PrintMessage("[Chrome] xdotool launch failed — input forwarding disabled\n")
        }

        // 6. Mmap Xvfb framebuffer (replaces ffmpeg — zero-copy pixel access)
        ChromeState.frame_size = Multiply(Multiply(ChromeState.xvfb_w, ChromeState.xvfb_h), 4)
        mr = Chrome_MmapFB()
        IfCondition LessThan(mr, 0) ThenBlock: {
            PrintMessage("[Chrome] Failed to mmap Xvfb framebuffer\n")
            Deallocate(ts_wait, 16)
            ReturnValue(0)
        }

        Deallocate(ts_wait, 16)
        PrintMessage("[Chrome] All processes running + framebuffer mapped\n")
        Chrome_XdotoolResize(ChromeState.canvas_w, ChromeState.canvas_h)
        ReturnValue(1)
    }
}

// =============================================================================
// LAUNCH PERSISTENT XDOTOOL — fork/exec "xdotool -" with stdin pipe
// Reads commands line-by-line from stdin, reuses one X11 connection.
// Eliminates fork/exec overhead (~5-15ms → ~0.1ms per event).
// =============================================================================
Function.Chrome_LaunchXdotool {
    Output: Integer
    Body: {
        disp_str = Chrome_BuildDisplayStr()
        dsl = StringLength(disp_str)

        // Create pipe: parent writes commands, child reads from stdin
        pipefds = Allocate(8)
        pr = SystemCall(CSys.SYS_PIPE, pipefds, 0, 0, 0, 0)
        IfCondition LessThan(pr, 0) ThenBlock: {
            PrintMessage("[Chrome] xdotool pipe() failed\n")
            Deallocate(pipefds, 8)
            ReturnValue(-1)
        }
        xdt_read  = Dereference(pipefds, "dword")
        xdt_write = Dereference(Add(pipefds, 4), "dword")
        Deallocate(pipefds, 8)

        pid = SystemCall(CSys.SYS_FORK, 0, 0, 0, 0, 0)
        IfCondition LessThan(pid, 0) ThenBlock: {
            PrintMessage("[Chrome] xdotool fork failed\n")
            SystemCall(CSys.SYS_CLOSE, xdt_read, 0, 0, 0, 0)
            SystemCall(CSys.SYS_CLOSE, xdt_write, 0, 0, 0, 0)
            ReturnValue(-1)
        }

        IfCondition EqualTo(pid, 0) ThenBlock: {
            // ===== CHILD =====
            Chrome_DropPriv()
            SystemCall(CSys.SYS_CLOSE, xdt_write, 0, 0, 0, 0)
            // dup2(xdt_read, 0) — stdin = command pipe
            SystemCall(CSys.SYS_DUP2, xdt_read, 0, 0, 0, 0)
            SystemCall(CSys.SYS_CLOSE, xdt_read, 0, 0, 0, 0)

            // Redirect stdout/stderr to /dev/null — prevents TTY corruption
            devnull = SystemCall(CSys.SYS_OPEN, "/dev/null", 1, 0)
            SystemCall(CSys.SYS_DUP2, devnull, 1, 0, 0, 0)
            SystemCall(CSys.SYS_DUP2, devnull, 2, 0, 0, 0)
            SystemCall(CSys.SYS_CLOSE, devnull, 0, 0, 0, 0)

            // argv: xdotool -
            argv = Allocate(24)
            StoreValue(Add(argv, 0), "/usr/bin/xdotool")
            StoreValue(Add(argv, 8), "-")
            StoreValue(Add(argv, 16), 0)

            // envp: DISPLAY=:99
            denv = Allocate(24)
            MemoryCopy(denv, "DISPLAY=", 8)
            MemoryCopy(Add(denv, 8), disp_str, Add(dsl, 1))
            envp = Allocate(16)
            StoreValue(Add(envp, 0), denv)
            StoreValue(Add(envp, 8), 0)

            SystemCall(CSys.SYS_EXECVE, "/usr/bin/xdotool", argv, envp)
            SystemCall(CSys.SYS_EXIT, 1)
        }

        // ===== PARENT =====
        SystemCall(CSys.SYS_CLOSE, xdt_read, 0, 0, 0, 0)
        ChromeState.xdotool_pid = pid
        ChromeState.xdotool_wr  = xdt_write
        Chrome_WritePidFile("/tmp/chrome_ailang_xdotool.pid", pid)

        PrintMessage("[Chrome] xdotool pipe launched pid=")
        PrintNumber(pid)
        PrintMessage(" wr_fd=")
        PrintNumber(xdt_write)
        PrintMessage("\n")

        ReturnValue(pid)
    }
}

// =============================================================================
// WRITE COMMAND TO XDOTOOL PIPE — single write() syscall, no fork/exec
// cmd must be a complete command string like "key Return" (no newline).
// This function appends the newline.
// =============================================================================
Function.Chrome_XdotoolWrite {
    Input: cmd: Address
    Body: {
        wr = ChromeState.xdotool_wr
        IfCondition LessThan(wr, 0) ThenBlock: { ReturnValue(0) }

        // Copy cmd + newline into cmd_buf
        buf = ChromeState.cmd_buf
        clen = StringLength(cmd)
        MemoryCopy(buf, cmd, clen)
        SetByte(buf, clen, 10)
        SystemCall(CSys.SYS_WRITE, wr, buf, Add(clen, 1), 0, 0)
    }
}

// =============================================================================
// XDOTOOL KEY — write "key <keysym>\n" to pipe
// =============================================================================
Function.Chrome_XdotoolKey {
    Input: keysym: Address
    Body: {
        buf = ChromeState.cmd_buf
        MemoryCopy(buf, "key ", 4)
        klen = StringLength(keysym)
        MemoryCopy(Add(buf, 4), keysym, klen)
        SetByte(buf, Add(4, klen), 10)
        wr = ChromeState.xdotool_wr
        IfCondition LessThan(wr, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(CSys.SYS_WRITE, wr, buf, Add(5, klen), 0, 0)
    }
}

// =============================================================================
// XDOTOOL TYPE — write "type <char>\n" to pipe
// =============================================================================
Function.Chrome_XdotoolType {
    Input: ch: Integer
    Body: {
        buf = ChromeState.cmd_buf
        MemoryCopy(buf, "type ", 5)
        SetByte(buf, 5, ch)
        SetByte(buf, 6, 10)
        wr = ChromeState.xdotool_wr
        IfCondition LessThan(wr, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(CSys.SYS_WRITE, wr, buf, 7, 0, 0)
    }
}

// =============================================================================
// XDOTOOL MOUSEMOVE — write "mousemove X Y\n" to pipe
// =============================================================================
Function.Chrome_XdotoolMouseMove {
    Input: mx: Integer
    Input: my: Integer
    Body: {
        buf = ChromeState.cmd_buf
        MemoryCopy(buf, "mousemove ", 10)
        xbuf = Allocate(12)
        ybuf = Allocate(12)
        xlen = Chrome_NumToStr(mx, xbuf)
        ylen = Chrome_NumToStr(my, ybuf)
        off = 10
        MemoryCopy(Add(buf, off), xbuf, xlen)
        off = Add(off, xlen)
        SetByte(buf, off, 32)
        off = Add(off, 1)
        MemoryCopy(Add(buf, off), ybuf, ylen)
        off = Add(off, ylen)
        SetByte(buf, off, 10)
        off = Add(off, 1)
        Deallocate(xbuf, 12)
        Deallocate(ybuf, 12)
        wr = ChromeState.xdotool_wr
        IfCondition LessThan(wr, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(CSys.SYS_WRITE, wr, buf, off, 0, 0)
    }
}

// =============================================================================
// XDOTOOL MOUSEDOWN — write "mousedown BUTTON\n" to pipe
// Button mapping: IPC 0=left,1=right,2=mid → xdotool 1=left,2=mid,3=right
// =============================================================================
Function.Chrome_XdotoolMouseDown {
    Input: button: Integer
    Body: {
        xbtn = 1
        IfCondition EqualTo(button, 1) ThenBlock: { xbtn = 3 }
        IfCondition EqualTo(button, 2) ThenBlock: { xbtn = 2 }
        buf = ChromeState.cmd_buf
        MemoryCopy(buf, "mousedown ", 10)
        SetByte(buf, 10, Add(48, xbtn))
        SetByte(buf, 11, 10)
        wr = ChromeState.xdotool_wr
        IfCondition LessThan(wr, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(CSys.SYS_WRITE, wr, buf, 12, 0, 0)
    }
}

// =============================================================================
// XDOTOOL MOUSEUP — write "mouseup BUTTON\n" to pipe
// =============================================================================
Function.Chrome_XdotoolMouseUp {
    Input: button: Integer
    Body: {
        xbtn = 1
        IfCondition EqualTo(button, 1) ThenBlock: { xbtn = 3 }
        IfCondition EqualTo(button, 2) ThenBlock: { xbtn = 2 }
        buf = ChromeState.cmd_buf
        MemoryCopy(buf, "mouseup ", 8)
        SetByte(buf, 8, Add(48, xbtn))
        SetByte(buf, 9, 10)
        wr = ChromeState.xdotool_wr
        IfCondition LessThan(wr, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(CSys.SYS_WRITE, wr, buf, 10, 0, 0)
    }
}

// =============================================================================
// SCROLL WHEEL — xdotool click 4 (up) or click 5 (down)
// delta: positive = scroll up, negative = scroll down
// =============================================================================
Function.Chrome_XdotoolScroll {
    Input: delta: Integer
    Body: {
        wr = ChromeState.xdotool_wr
        IfCondition LessThan(wr, 0) ThenBlock: { ReturnValue(0) }

        // "click 4\n" (up) or "click 5\n" (down)
        buf = ChromeState.cmd_buf
        MemoryCopy(buf, "click ", 6)
        IfCondition GreaterThan(delta, 0) ThenBlock: {
            SetByte(buf, 6, 52)
        } ElseBlock: {
            SetByte(buf, 6, 53)
        }
        SetByte(buf, 7, 10)
        SystemCall(CSys.SYS_WRITE, wr, buf, 8, 0, 0)
    }
}

// =============================================================================
// HANDLE MOUSE — dispatch IPC mouse event to xdotool
// ev: 0=MOVE, 1=DOWN, 2=UP, 3=SCROLL (matches AKMouseEv + scroll)
// button: 0=left, 1=right, 2=middle (for DOWN/UP), delta (for SCROLL)
//
// MOVE events are deferred — we store the latest position and flush once
// per main loop tick via Chrome_FlushMouse(). This coalesces 10-60 moves
// per frame into a single fork/exec xdotool call.
// DOWN/UP fire immediately (with a move to the click position first).
// =============================================================================
Function.Chrome_EnsureXdotool {
    Body: {
        IfCondition GreaterEqual(ChromeState.xdotool_wr, 0) ThenBlock: { ReturnValue(0) }
        PrintMessage("[Chrome] restarting xdotool pipe\n")
        Chrome_LaunchXdotool()
        IfCondition GreaterEqual(ChromeState.xdotool_wr, 0) ThenBlock: {
            Chrome_XdotoolResize(ChromeState.canvas_w, ChromeState.canvas_h)
        }
    }
}

Function.Chrome_HandleMouse {
    Input: mx: Integer
    Input: my: Integer
    Input: ev: Integer
    Input: button: Integer
    Body: {
        // Don't forward if Chrome isn't running
        IfCondition EqualTo(ChromeState.chrome_pid, 0) ThenBlock: { ReturnValue(0) }
        Chrome_EnsureXdotool()

        // MOVE — defer, just store latest position
        IfCondition EqualTo(ev, 0) ThenBlock: {
            ChromeState.pending_mx = mx
            ChromeState.pending_my = my
            ChromeState.mouse_dirty = 1
            ReturnValue(0)
        }

        // DOWN — focus Chrome, move, then press
        IfCondition EqualTo(ev, 1) ThenBlock: {
            Chrome_XdotoolWrite("search --onlyvisible --class Google-chrome windowfocus %@")
            Chrome_XdotoolMouseMove(mx, my)
            ChromeState.mouse_dirty = 0
            Chrome_XdotoolMouseDown(button)
            ReturnValue(0)
        }

        // UP — release button at current position
        IfCondition EqualTo(ev, 2) ThenBlock: {
            Chrome_XdotoolMouseUp(button)
            ReturnValue(0)
        }

        // SCROLL — button field carries wheel delta
        IfCondition EqualTo(ev, 3) ThenBlock: {
            Chrome_XdotoolMouseMove(mx, my)
            ChromeState.mouse_dirty = 0
            Chrome_XdotoolScroll(button)
            ReturnValue(0)
        }
    }
}

// =============================================================================
// FLUSH MOUSE — send one coalesced mousemove per tick if dirty
// Called from main loop, not from message handler
// =============================================================================
Function.Chrome_FlushMouse {
    Body: {
        IfCondition EqualTo(ChromeState.mouse_dirty, 1) ThenBlock: {
            Chrome_XdotoolMouseMove(ChromeState.pending_mx, ChromeState.pending_my)
            ChromeState.mouse_dirty = 0
        }
    }
}

// =============================================================================
// CLIPBOARD — consume the display-server slot (characters).
// Context-menu paste arrives as clipboard.paste. Ctrl+C/V still go to
// Chrome's nested X session so in-page copy works until an X-clip bridge
// pulls that text into the Ailang slot.
// =============================================================================
Function.Chrome_ApplyPaste {
    Input: data: Address
    Body: {
        IfCondition EqualTo(data, 0) ThenBlock: { ReturnValue(0) }
        dlen = StringLength(data)
        i = 0
        WhileLoop LessThan(i, dlen) {
            ch = GetByte(data, i)
            IfCondition Or(EqualTo(ch, 10), EqualTo(ch, 13)) ThenBlock: {
                Chrome_XdotoolKey("Return")
            } ElseBlock: {
                IfCondition GreaterEqual(ch, 32) ThenBlock: {
                    Chrome_XdotoolType(ch)
                }
            }
            i = Add(i, 1)
        }
    }
}

Function.Chrome_HandleClipMsg {
    Input: mobj: Address
    Input: method: Address
    Output: Integer
    Body: {
        cmp = StringCompare(method, "clipboard.paste")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            tname = JSON.GetString(mobj, "type")
            IfCondition And(NotEqual(tname, 0), EqualTo(StringCompare(tname, "empty"), 0)) ThenBlock: {
                ReturnValue(1)
            }
            Chrome_ApplyPaste(JSON.GetString(mobj, "data"))
            ReturnValue(1)
        }
        cmp = StringCompare(method, "clipboard.data")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            tname = JSON.GetString(mobj, "type")
            IfCondition And(NotEqual(tname, 0), EqualTo(StringCompare(tname, "empty"), 0)) ThenBlock: {
                ReturnValue(1)
            }
            Chrome_ApplyPaste(JSON.GetString(mobj, "data"))
            ReturnValue(1)
        }
        cmp = StringCompare(method, "clipboard.copy")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Chrome_XdotoolKey("ctrl+c")
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// HANDLE KEY — translate IPC keycode to xdotool command
// =============================================================================
Function.Chrome_HandleKey {
    Input: keycode: Integer
    Input: ch: Integer
    Input: shift: Integer
    Input: ctrl: Integer
    Body: {
        // Don't forward if Chrome isn't running
        IfCondition EqualTo(ChromeState.chrome_pid, 0) ThenBlock: { ReturnValue(0) }

        // Ctrl combos → xdotool key
        IfCondition EqualTo(ctrl, 1) ThenBlock: {
            // Ctrl+L (38) → focus URL bar
            IfCondition EqualTo(keycode, 38) ThenBlock: {
                Chrome_XdotoolKey("ctrl+l")
                ReturnValue(0)
            }
            // Ctrl+T (20) → new tab
            IfCondition EqualTo(keycode, 20) ThenBlock: {
                Chrome_XdotoolKey("ctrl+t")
                ReturnValue(0)
            }
            // Ctrl+W (17) → close tab
            IfCondition EqualTo(keycode, 17) ThenBlock: {
                Chrome_XdotoolKey("ctrl+w")
                ReturnValue(0)
            }
            // Ctrl+R (19) → reload
            IfCondition EqualTo(keycode, 19) ThenBlock: {
                Chrome_XdotoolKey("ctrl+r")
                ReturnValue(0)
            }
            // Ctrl+C (46) → copy
            IfCondition EqualTo(keycode, 46) ThenBlock: {
                Chrome_XdotoolKey("ctrl+c")
                ReturnValue(0)
            }
            // Ctrl+V (47) → paste
            IfCondition EqualTo(keycode, 47) ThenBlock: {
                Chrome_XdotoolKey("ctrl+v")
                ReturnValue(0)
            }
            ReturnValue(0)
        }

        // Arrow keys
        IfCondition EqualTo(keycode, 103) ThenBlock: {
            Chrome_XdotoolKey("Up")
            ReturnValue(0)
        }
        IfCondition EqualTo(keycode, 108) ThenBlock: {
            Chrome_XdotoolKey("Down")
            ReturnValue(0)
        }
        IfCondition EqualTo(keycode, 105) ThenBlock: {
            Chrome_XdotoolKey("Left")
            ReturnValue(0)
        }
        IfCondition EqualTo(keycode, 106) ThenBlock: {
            Chrome_XdotoolKey("Right")
            ReturnValue(0)
        }

        // Enter (28)
        IfCondition EqualTo(keycode, 28) ThenBlock: {
            Chrome_XdotoolKey("Return")
            ReturnValue(0)
        }

        // Backspace (14)
        IfCondition EqualTo(keycode, 14) ThenBlock: {
            Chrome_XdotoolKey("BackSpace")
            ReturnValue(0)
        }

        // Tab (15)
        IfCondition EqualTo(keycode, 15) ThenBlock: {
            Chrome_XdotoolKey("Tab")
            ReturnValue(0)
        }

        // Escape (1)
        IfCondition EqualTo(keycode, 1) ThenBlock: {
            Chrome_XdotoolKey("Escape")
            ReturnValue(0)
        }

        // Space (57)
        IfCondition EqualTo(keycode, 57) ThenBlock: {
            Chrome_XdotoolKey("space")
            ReturnValue(0)
        }

        // Delete (111)
        IfCondition EqualTo(keycode, 111) ThenBlock: {
            Chrome_XdotoolKey("Delete")
            ReturnValue(0)
        }

        // Home (102)
        IfCondition EqualTo(keycode, 102) ThenBlock: {
            Chrome_XdotoolKey("Home")
            ReturnValue(0)
        }

        // End (107)
        IfCondition EqualTo(keycode, 107) ThenBlock: {
            Chrome_XdotoolKey("End")
            ReturnValue(0)
        }

        // PageUp (104)
        IfCondition EqualTo(keycode, 104) ThenBlock: {
            Chrome_XdotoolKey("Page_Up")
            ReturnValue(0)
        }

        // PageDown (109)
        IfCondition EqualTo(keycode, 109) ThenBlock: {
            Chrome_XdotoolKey("Page_Down")
            ReturnValue(0)
        }

        // F5 (63) → reload
        IfCondition EqualTo(keycode, 63) ThenBlock: {
            Chrome_XdotoolKey("F5")
            ReturnValue(0)
        }

        // Printable character → xdotool type
        IfCondition And(GreaterEqual(ch, 32), LessEqual(ch, 126)) ThenBlock: {
            Chrome_XdotoolType(ch)
            ReturnValue(0)
        }
    }
}

// =============================================================================
// HANDLE ACTION — toolbar button actions
// =============================================================================
Function.Chrome_HandleAction {
    Input: sock: Integer
    Input: action: Address
    Input: text: Address
    Body: {
        cmp = StringCompare(action, "c.back")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Chrome_XdotoolKey("alt+Left")
            PrintMessage("[Chrome] Back\n")
            ReturnValue(1)
        }
        cmp = StringCompare(action, "lb.back")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Chrome_XdotoolKey("alt+Left")
            PrintMessage("[Chrome] Back\n")
            ReturnValue(1)
        }

        cmp = StringCompare(action, "c.fwd")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Chrome_XdotoolKey("alt+Right")
            PrintMessage("[Chrome] Forward\n")
            ReturnValue(1)
        }
        cmp = StringCompare(action, "lb.fwd")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Chrome_XdotoolKey("alt+Right")
            PrintMessage("[Chrome] Forward\n")
            ReturnValue(1)
        }

        cmp = StringCompare(action, "c.reload")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Chrome_XdotoolKey("F5")
            PrintMessage("[Chrome] Reload\n")
            ReturnValue(1)
        }
        cmp = StringCompare(action, "lb.reload")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Chrome_XdotoolKey("F5")
            PrintMessage("[Chrome] Reload\n")
            ReturnValue(1)
        }

        cmp = StringCompare(action, "addr.go")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            IfCondition NotEqual(text, 0) ThenBlock: {
                Chrome_Navigate(text)
            }
            ReturnValue(1)
        }

        ReturnValue(0)
    }
}

Function.Chrome_Navigate {
    Input: url: Address
    Body: {
        Chrome_XdotoolKey("ctrl+l")
        ts = Allocate(16)
        StoreValue(ts, 0)
        StoreValue(Add(ts, 8), 80000000)
        SystemCall(CSys.SYS_NANOSLEEP, ts, 0)
        Deallocate(ts, 16)
        Chrome_XdotoolTypeStr(url)
        Chrome_XdotoolKey("Return")
        PrintMessage("[Chrome] Go ")
        PrintMessage(url)
        PrintMessage("\n")
    }
}

Function.Chrome_XdotoolTypeStr {
    Input: s: Address
    Body: {
        wr = ChromeState.xdotool_wr
        IfCondition LessThan(wr, 0) ThenBlock: { ReturnValue(0) }
        buf = ChromeState.cmd_buf
        MemoryCopy(buf, "type -- ", 8)
        slen = StringLength(s)
        IfCondition GreaterThan(slen, 110) ThenBlock: { slen = 110 }
        MemoryCopy(Add(buf, 8), s, slen)
        SetByte(buf, Add(8, slen), 10)
        SystemCall(CSys.SYS_WRITE, wr, buf, Add(9, slen), 0, 0)
    }
}

// =============================================================================
// XDOTOOL WINDOW RESIZE — fit Chrome to the Auckland canvas
// Xvfb has no WM. Hardcoded window id 2 + --sync kills the xdotool pipe.
// Search by WM_CLASS, no --sync, pin at 0,0 so CopyFrame is 1:1.
// =============================================================================
Function.Chrome_XdotoolResize {
    Input: w: Integer
    Input: h: Integer
    Body: {
        Chrome_EnsureXdotool()
        wr = ChromeState.xdotool_wr
        IfCondition LessThan(wr, 0) ThenBlock: { ReturnValue(0) }

        buf = ChromeState.cmd_buf
        prefix = "search --onlyvisible --class Google-chrome windowsize %@ "
        plen = StringLength(prefix)
        MemoryCopy(buf, prefix, plen)
        off = plen

        w_tmp = Allocate(12)
        wlen = Chrome_NumToStr(w, w_tmp)
        MemoryCopy(Add(buf, off), w_tmp, wlen)
        off = Add(off, wlen)
        Deallocate(w_tmp, 12)

        SetByte(buf, off, 32)
        off = Add(off, 1)

        h_tmp = Allocate(12)
        hlen = Chrome_NumToStr(h, h_tmp)
        MemoryCopy(Add(buf, off), h_tmp, hlen)
        off = Add(off, hlen)
        Deallocate(h_tmp, 12)

        tail = " windowmove %@ 0 0 windowfocus %@"
        tlen = StringLength(tail)
        MemoryCopy(Add(buf, off), tail, tlen)
        off = Add(off, tlen)
        SetByte(buf, off, 10)
        off = Add(off, 1)

        SystemCall(CSys.SYS_WRITE, wr, buf, off, 0, 0)
        PrintMessage("[Chrome] X11 windowsize ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage("\n")
    }
}

// =============================================================================
// HANDLE RESIZE — viewport-only, processes stay alive
// =============================================================================
Function.Chrome_HandleResize {
    Input: sock: Integer
    Input: new_w: Integer
    Input: new_h: Integer
    Body: {
        IfCondition LessEqual(new_w, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(new_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition And(EqualTo(new_w, ChromeState.canvas_w), EqualTo(new_h, ChromeState.canvas_h)) ThenBlock: {
            ReturnValue(0)
        }

        PrintMessage("[Chrome] Viewport resize: ")
        PrintNumber(ChromeState.canvas_w)
        PrintMessage("x")
        PrintNumber(ChromeState.canvas_h)
        PrintMessage(" -> ")
        PrintNumber(new_w)
        PrintMessage("x")
        PrintNumber(new_h)
        PrintMessage("\n")

        // Clamp to Xvfb backing resolution
        IfCondition GreaterThan(new_w, ChromeState.xvfb_w) ThenBlock: { new_w = ChromeState.xvfb_w }
        IfCondition GreaterThan(new_h, ChromeState.xvfb_h) ThenBlock: { new_h = ChromeState.xvfb_h }

        // Destroy old canvas only — processes untouched
        ShmCanvas_Destroy(ChromeState.win_id)

        ChromeState.canvas_w = new_w
        ChromeState.canvas_h = new_h

        wid = ChromeState.win_id
        buf = ShmCanvas_Create(wid, new_w, new_h)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            PrintMessage("[Chrome] ShmCanvas_Create failed after resize\n")
            ReturnValue(0)
        }

        ShmCanvas_AttachCapture(sock, wid, new_w, new_h)
        ShmCanvas_Clear(4278190080)
        ShmCanvas_Present(sock, wid)

        // Tell Chrome to resize inside Xvfb to match the OS window
        Chrome_XdotoolResize(new_w, new_h)

        PrintMessage("[Chrome] Viewport resized — Chrome fitted to canvas\n")
    }
}

// =============================================================================
// CHECK CHILDREN — reap any dead xdotool children (fire-and-forget)
// Also check if critical processes (Xvfb, Chrome) died
// =============================================================================
Function.Chrome_CheckChildren {
    Body: {
        // Reap dead children — 3 processes: Xvfb, Chrome, xdotool
        status = Allocate(8)

        reap_pass = 0
        WhileLoop LessThan(reap_pass, 3) {
            wr = SystemCall(CSys.SYS_WAIT4, -1, status, CSig.WNOHANG, 0, 0, 0)
            IfCondition LessEqual(wr, 0) ThenBlock: {
                reap_pass = 3
            } ElseBlock: {
                IfCondition EqualTo(wr, ChromeState.xvfb_pid) ThenBlock: {
                    PrintMessage("[Chrome] Xvfb exited — display lost\n")
                    ChromeState.xvfb_pid = 0
                    ChromeState.capturing = 0
                }
                IfCondition EqualTo(wr, ChromeState.chrome_pid) ThenBlock: {
                    PrintMessage("[Chrome] Chrome exited\n")
                    ChromeState.chrome_pid = 0
                }
                IfCondition EqualTo(wr, ChromeState.xdotool_pid) ThenBlock: {
                    PrintMessage("[Chrome] xdotool exited — will restart on next input\n")
                    ChromeState.xdotool_pid = 0
                    ChromeState.xdotool_wr = -1
                }
            }
            reap_pass = Add(reap_pass, 1)
        }

        Deallocate(status, 8)
    }
}

// =============================================================================
// POLL IPC MESSAGES
// =============================================================================
Function.Chrome_PollMessages {
    Input: sock: Integer
    Body: {
        // Drain up to 32 pending messages per tick (mouse events flood at 60Hz)
        poll_pass = 0
        WhileLoop LessThan(poll_pass, 32) {
            msg = Socket.RecvMsg(sock)
            IfCondition EqualTo(msg, 0) ThenBlock: {
                poll_pass = 32
            } ElseBlock: {
                pmsg = ParseJSON(msg)
                IfCondition NotEqual(pmsg, 0) ThenBlock: {
                    mobj = JSON.AsObject(pmsg)
                    method = JSON.GetString(mobj, "method")
                    IfCondition NotEqual(method, 0) ThenBlock: {

                        cmp = StringCompare(method, "window.closed")
                        IfCondition EqualTo(cmp, 0) ThenBlock: {
                            PrintMessage("[Chrome] Window closed\n")
                            Chrome_StopAll()
                            ChromeState.running = 0
                            poll_pass = 32
                        }

                        IfCondition EqualTo(Chrome_HandleClipMsg(mobj, method), 1) ThenBlock: {
                            cmp = 0
                        }

                        cmp = StringCompare(method, "input.key")
                        IfCondition EqualTo(cmp, 0) ThenBlock: {
                            kc = JSON.GetNumber(mobj, "keycode")
                            kch = JSON.GetNumber(mobj, "char")
                            ksh = JSON.GetNumber(mobj, "shift")
                            kct = JSON.GetNumber(mobj, "ctrl")
                            Chrome_HandleKey(kc, kch, ksh, kct)
                        }

                        cmp = StringCompare(method, "input.mouse")
                        IfCondition EqualTo(cmp, 0) ThenBlock: {
                            mmx = JSON.GetNumber(mobj, "x")
                            mmy = JSON.GetNumber(mobj, "y")
                            mev = JSON.GetNumber(mobj, "event")
                            mbtn = JSON.GetNumber(mobj, "button")
                            Chrome_HandleMouse(mmx, mmy, mev, mbtn)
                        }

                        cmp = StringCompare(method, "input.action")
                        IfCondition EqualTo(cmp, 0) ThenBlock: {
                            action = JSON.GetString(mobj, "action")
                            IfCondition NotEqual(action, 0) ThenBlock: {
                                txt = JSON.GetString(mobj, "text")
                                Chrome_HandleAction(sock, action, txt)
                            }
                        }

                        cmp = StringCompare(method, "window.resized")
                        IfCondition EqualTo(cmp, 0) ThenBlock: {
                            rw = JSON.GetNumber(mobj, "width")
                            rh = JSON.GetNumber(mobj, "height")
                            Chrome_HandleResize(sock, rw, rh)
                        }
                    }
                    JSON.Free(pmsg)
                }
            }
            poll_pass = Add(poll_pass, 1)
        }
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  Chrome Browser — Xvfb + mmap + ShmCanvas\n")
    PrintMessage("============================================\n\n")

    // Kill any orphaned processes from a prior crashed chrome_ipc instance
    Chrome_CleanupStaleXvfb()

    // Connect to display server
    sock = Socket.Create(1, 1)
    IfCondition LessThan(sock, 0) ThenBlock: {
        PrintMessage("[Chrome] Socket create failed\n")
        HaltProgram
    }

    cres = Socket.ConnectUnix(sock, "/tmp/ailang_display.sock")
    IfCondition LessThan(cres, 0) ThenBlock: {
        PrintMessage("[Chrome] Connect failed — is display server running?\n")
        Socket.Close(sock)
        HaltProgram
    }
    PrintMessage("[Chrome] Connected to display server\n")
    ChromeState.sock = sock

    // Register
    Socket.SendMsg(sock, "{\"method\":\"register\",\"service\":\"chrome\"}")
    PrintMessage("[Chrome] Sent register\n")

    // Create window (1024x700 content = canvas, system toolbar="about" added by WM)
    Socket.SendMsg(sock, "{\"method\":\"window.create\",\"title\":\"Chrome\",\"w\":1024,\"h\":700,\"html\":\"config/chrome.html\"}")
    PrintMessage("[Chrome] Sent window.create\n")

    // Wait for window.created
    resp = Socket.RecvMsg(sock)
    IfCondition EqualTo(resp, 0) ThenBlock: {
        PrintMessage("[Chrome] No response\n")
        Socket.Close(sock)
        HaltProgram
    }

    parsed = ParseJSON(resp)
    IfCondition NotEqual(parsed, 0) ThenBlock: {
        pobj = JSON.AsObject(parsed)
        wid = JSON.GetNumber(pobj, "win_id")
        ChromeState.win_id = wid

        // Read screen dimensions from display server
        sw = JSON.GetNumber(pobj, "screen_w")
        sh = JSON.GetNumber(pobj, "screen_h")
        IfCondition GreaterThan(sw, 0) ThenBlock: { ChromeState.xvfb_w = sw }
        IfCondition GreaterThan(sh, 0) ThenBlock: { ChromeState.xvfb_h = sh }

        PrintMessage("[Chrome] Window created, win_id=")
        PrintNumber(wid)
        PrintMessage(" screen=")
        PrintNumber(ChromeState.xvfb_w)
        PrintMessage("x")
        PrintNumber(ChromeState.xvfb_h)
        PrintMessage("\n")
        JSON.Free(parsed)
    }

    // Create shared memory canvas (1024x708 = window minus toolbar)
    cw = ChromeState.canvas_w
    ch = ChromeState.canvas_h
    wid = ChromeState.win_id
    buf = ShmCanvas_Create(wid, cw, ch)
    IfCondition EqualTo(buf, 0) ThenBlock: {
        PrintMessage("[Chrome] ShmCanvas_Create failed\n")
        Socket.Close(sock)
        HaltProgram
    }

    ShmCanvas_AttachCapture(sock, wid, cw, ch)
    PrintMessage("[Chrome] Canvas attached (mouse capture)\n")

    // Clear to black
    ShmCanvas_Clear(4278190080)
    ShmCanvas_Present(sock, wid)

    // Set socket non-blocking before launch (launch may take a while)
    Socket.SetNonBlock(sock)

    // Allocate command buffer for xdotool pipe writes (reused, never freed)
    ChromeState.cmd_buf = Allocate(256)

    // Launch Xvfb → Chrome → xdotool → mmap framebuffer
    lr = Chrome_LaunchAll()
    IfCondition EqualTo(lr, 0) ThenBlock: {
        PrintMessage("[Chrome] Child processes failed — window stays open with black canvas\n")
        PrintMessage("[Chrome] Install prerequisites: sudo apt install xvfb xdotool\n")
    }

    // Tick timespecs — 5ms for responsive mouse, 30fps frames arrive every 33ms
    ts_tick = Allocate(16)
    StoreValue(ts_tick, 0)
    StoreValue(Add(ts_tick, 8), 5000000)

    ts_idle = Allocate(16)
    StoreValue(ts_idle, 0)
    StoreValue(Add(ts_idle, 8), 50000000)

    PrintMessage("[Chrome] Entering main loop (mmap framebuffer)\n\n")

    // ===== MAIN LOOP =====
    WhileLoop EqualTo(ChromeState.running, 1) {

        IfCondition EqualTo(ChromeState.capturing, 1) ThenBlock: {
            // Copy pixels from Xvfb mmap'd framebuffer to shm canvas
            vr = Chrome_CopyFrame()
            IfCondition EqualTo(vr, 1) ThenBlock: {
                ShmCanvas_Present(sock, wid)
            }

            SystemCall(CSys.SYS_NANOSLEEP, ts_tick, 0)
        } ElseBlock: {
            // Idle — not capturing
            SystemCall(CSys.SYS_NANOSLEEP, ts_idle, 0)
        }

        // Poll IPC messages
        Chrome_PollMessages(sock)

        // Flush coalesced mouse move (one xdotool per tick max)
        Chrome_FlushMouse()

        // Check/reap children
        Chrome_CheckChildren()
    }

    // Cleanup
    Chrome_StopAll()
    ShmCanvas_Destroy(wid)
    Deallocate(ts_tick, 16)
    Deallocate(ts_idle, 16)
    Socket.Close(sock)

    PrintMessage("\n============================================\n")
    PrintMessage("  Chrome Browser finished\n")
    PrintMessage("============================================\n")
}

RunTask(Main)
