// deepseek_cli.ailang — Standalone CLI for DeepSeek
//
// A lightweight, non-interactive CLI wrapper for DeepSeek.
// Perfect for piping large files, quick shell queries, or using
// as a cheap sub-agent from inside HalCode9000's Bash tool.
//
// Build: ./ailang.x Applications/deepseek_cli.ailang deepseek.x
// Usage: echo "Summarize this:" | cat - file.txt | ./deepseek.x

LibraryImport.Arena
LibraryImport.JSON
LibraryImport.StringUtils
LibraryImport.HTTP

FixedPool.DS_Sys {
    "SYS_READ":  Initialize=0
    "SYS_WRITE": Initialize=1
    "SYS_OPEN":  Initialize=2
    "SYS_CLOSE": Initialize=3
    "SYS_EXIT":  Initialize=60
}

Function.DS_WriteStdout {
    Input: s: Address
    Body: {
        len = StringLength(s)
        IfCondition GreaterThan(len, 0) ThenBlock: {
            SystemCall(DS_Sys.SYS_WRITE, 1, s, len, 0, 0)
        }
    }
}

Function.DS_GetEnv {
    Input: var_name: Address
    Output: Address
    Body: {
        fd = SystemCall(DS_Sys.SYS_OPEN, "/proc/self/environ", 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(65536)
        n = SystemCall(DS_Sys.SYS_READ, fd, buf, 65536, 0, 0)
        SystemCall(DS_Sys.SYS_CLOSE, fd, 0, 0, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: { Deallocate(buf, 65536) ReturnValue(0) }
        var_len = StringLength(var_name)
        i = 0
        WhileLoop LessThan(i, n) {
            match = 1
            j = 0
            WhileLoop LessThan(j, var_len) {
                IfCondition NotEqual(GetByte(buf, Add(i, j)), GetByte(var_name, j)) ThenBlock: { match = 0 BreakLoop }
                j = Add(j, 1)
            }
            IfCondition EqualTo(match, 1) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, Add(i, var_len)), 61) ThenBlock: {
                    val_start = Add(i, Add(var_len, 1))
                    val_end = val_start
                    WhileLoop LessThan(val_end, n) {
                        IfCondition EqualTo(GetByte(buf, val_end), 0) ThenBlock: { BreakLoop }
                        val_end = Add(val_end, 1)
                    }
                    val_len = Subtract(val_end, val_start)
                    out = Allocate(Add(val_len, 1))
                    k = 0
                    WhileLoop LessThan(k, val_len) { SetByte(out, k, GetByte(buf, Add(val_start, k))) k = Add(k, 1) }
                    SetByte(out, val_len, 0)
                    Deallocate(buf, 65536)
                    ReturnValue(out)
                }
            }
            WhileLoop LessThan(i, n) { IfCondition EqualTo(GetByte(buf, i), 0) ThenBlock: { BreakLoop } i = Add(i, 1) }
            i = Add(i, 1)
        }
        Deallocate(buf, 65536)
        ReturnValue(0)
    }
}

Function.DS_ReadDeepseekKey {
    Output: Address
    Body: {
        env_key = DS_GetEnv("DEEPSEEK_API_KEY")
        IfCondition NotEqual(env_key, 0) ThenBlock: { ReturnValue(env_key) }

        home = DS_GetEnv("HOME")
        IfCondition EqualTo(home, 0) ThenBlock: { ReturnValue(0) }
        path = StringConcat(home, "/.halcode/deepseek_key")
        
        fd = SystemCall(DS_Sys.SYS_OPEN, path, 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        
        buf = Allocate(512)
        n = SystemCall(DS_Sys.SYS_READ, fd, buf, 511, 0, 0)
        SystemCall(DS_Sys.SYS_CLOSE, fd, 0, 0, 0, 0)
        
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 512)
            ReturnValue(0)
        }
        
        WhileLoop GreaterThan(n, 0) {
            last = GetByte(buf, Subtract(n, 1))
            is_space = 0
            IfCondition EqualTo(last, 10) ThenBlock: { is_space = 1 }
            IfCondition EqualTo(last, 13) ThenBlock: { is_space = 1 }
            IfCondition EqualTo(last, 32) ThenBlock: { is_space = 1 }
            IfCondition EqualTo(is_space, 1) ThenBlock: {
                n = Subtract(n, 1)
            } ElseBlock: { BreakLoop }
        }
        SetByte(buf, n, 0)
        ReturnValue(buf)
    }
}

Function.DS_ReadAllStdin {
    Output: Address
    Body: {
        cap = 131072
        buf = Allocate(cap)
        used = 0
        WhileLoop 1 {
            rem = Subtract(cap, Add(used, 1))
            IfCondition LessEqual(rem, 0) ThenBlock: {
                new_cap = Multiply(cap, 2)
                bigger = Allocate(new_cap)
                MemoryCopy(bigger, buf, used)
                Deallocate(buf, cap)
                buf = bigger
                cap = new_cap
                rem = Subtract(cap, Add(used, 1))
            }
            n = SystemCall(DS_Sys.SYS_READ, 0, Add(buf, used), rem, 0, 0)
            IfCondition LessEqual(n, 0) ThenBlock: { BreakLoop }
            used = Add(used, n)
        }
        SetByte(buf, used, 0)
        ReturnValue(buf)
    }
}

SubRoutine.Main {
    api_key = DS_ReadDeepseekKey()
    IfCondition EqualTo(api_key, 0) ThenBlock: {
        DS_WriteStdout("Error: DEEPSEEK_API_KEY env var not set, and ~/.halcode/deepseek_key not found.\n")
        SystemCall(DS_Sys.SYS_EXIT, 1, 0, 0, 0, 0)
    }

    prompt = DS_ReadAllStdin()
    IfCondition EqualTo(StringLength(prompt), 0) ThenBlock: {
        DS_WriteStdout("Error: No input provided on stdin.\n")
        SystemCall(DS_Sys.SYS_EXIT, 1, 0, 0, 0, 0)
    }

    // Build Request
    req = JSON.NewObject()
    JSON.SetString(req, "model", "deepseek-v4-flash")
    JSON.SetBool(req, "stream", 0)
    
    msgs = JSON.NewArray()
    
    sys_prompt = DS_GetEnv("DS_SYSTEM_PROMPT")
    IfCondition NotEqual(sys_prompt, 0) ThenBlock: {
        sys_msg = JSON.NewObject()
        JSON.SetString(sys_msg, "role", "system")
        JSON.SetString(sys_msg, "content", sys_prompt)
        JSON.PushObject(msgs, sys_msg)
    }

    msg = JSON.NewObject()
    JSON.SetString(msg, "role", "user")
    JSON.SetString(msg, "content", prompt)
    JSON.PushObject(msgs, msg)
    JSON.SetArray(req, "messages", msgs)
    
    body_str = JSON.SerializeObject(req)
    
    h1 = StringConcat("Authorization: Bearer ", api_key)
    h2 = StringConcat(h1, "\nContent-Type: application/json\n")
    
    resp_str = HTTP.Post("https://api.deepseek.com/v1/chat/completions", h2, body_str)
    IfCondition EqualTo(resp_str, 0) ThenBlock: {
        DS_WriteStdout("Error: HTTP request failed.\n")
        SystemCall(DS_Sys.SYS_EXIT, 1, 0, 0, 0, 0)
    }
    
    parsed = ParseJSON(resp_str)
    IfCondition NotEqual(parsed, 0) ThenBlock: {
        obj = JSON.AsObject(parsed)
        choices = JSON.GetArray(obj, "choices")
        IfCondition NotEqual(choices, 0) ThenBlock: {
            c0 = JSON.AsObject(JSON.ArrayGet(choices, 0))
            m = JSON.GetObject(c0, "message")
            content = JSON.GetString(m, "content")
            IfCondition NotEqual(content, 0) ThenBlock: {
                DS_WriteStdout(content)
                DS_WriteStdout("\n")
                SystemCall(DS_Sys.SYS_EXIT, 0, 0, 0, 0, 0)
            }
        }
    }
    
    // Fallback: print raw response if parsing failed or format unexpected
    DS_WriteStdout(resp_str)
    DS_WriteStdout("\n")
    SystemCall(DS_Sys.SYS_EXIT, 0, 0, 0, 0, 0)
}

RunTask(Main)