// deskbar_ipc.ailang
// Shell strip as its own process. Display hosts a SHELL window
// (docked, no chrome, hotzone); this binary is replaceable.
//
// Build: ./ailang.x Applications/deskbar_ipc.ailang -o /tmp/deskbar.x
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.StringUtils
LibraryImport.JSON

FixedPool.DeskbarIPCState {
    "running": Initialize=1, CanChange=True
    "win_id":  Initialize=0, CanChange=True
}

SubRoutine.Main {
    Arena_Init()
    PrintMessage("============================================\n")
    PrintMessage("  Deskbar IPC Client\n")
    PrintMessage("============================================\n\n")
    sock = Socket.Create(1, 1)
    IfCondition LessThan(sock, 0) ThenBlock: {
        PrintMessage("[DeskbarIPC] socket fail\n")
        HaltProgram
    }
    cres = Socket.ConnectUnix(sock, "/tmp/ailang_display.sock")
    IfCondition LessThan(cres, 0) ThenBlock: {
        PrintMessage("[DeskbarIPC] connect fail\n")
        Socket.Close(sock)
        HaltProgram
    }
    Socket.SendMsg(sock, "{\"method\":\"register\",\"service\":\"deskbar\"}")
    Socket.SendMsg(sock, "{\"method\":\"window.create\",\"title\":\"Deskbar\",\"w\":1152,\"h\":40,\"html\":\"config/deskbar.html\"}")
    resp = Socket.RecvMsg(sock)
    IfCondition EqualTo(resp, 0) ThenBlock: {
        PrintMessage("[DeskbarIPC] no window.created\n")
        Socket.Close(sock)
        HaltProgram
    }
    parsed = ParseJSON(resp)
    IfCondition NotEqual(parsed, 0) ThenBlock: {
        pobj = JSON.AsObject(parsed)
        DeskbarIPCState.win_id = JSON.GetNumber(pobj, "win_id")
        JSON.Free(parsed)
    }
    PrintMessage("[DeskbarIPC] win=")
    PrintNumber(DeskbarIPCState.win_id)
    PrintMessage("\n")

    WhileLoop EqualTo(DeskbarIPCState.running, 1) {
        msg = Socket.RecvMsg(sock)
        IfCondition EqualTo(msg, 0) ThenBlock: {
            DeskbarIPCState.running = 0
        } ElseBlock: {
            pmsg = ParseJSON(msg)
            IfCondition NotEqual(pmsg, 0) ThenBlock: {
                mobj = JSON.AsObject(pmsg)
                method = JSON.GetString(mobj, "method")
                IfCondition NotEqual(method, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(method, "window.closed"), 0) ThenBlock: {
                        DeskbarIPCState.running = 0
                    }
                }
                JSON.Free(pmsg)
            }
        }
    }
    Socket.Close(sock)
    PrintMessage("[DeskbarIPC] exit\n")
}
