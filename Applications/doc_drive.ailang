// doc_drive.ailang — open a Letter paper camera test window.
// Build: ./ailang.x Applications/doc_drive.ailang -o /tmp/doc_drive.x
// Run on guest with display.x up: /tmp/doc_drive.x
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.StringUtils
LibraryImport.JSON

SubRoutine.Main {
    Arena_Init()
    PrintMessage("[DocDrive] connecting\n")

    sock = Socket.Create(1, 1)
    IfCondition LessThan(sock, 0) ThenBlock: {
        PrintMessage("[DocDrive] socket fail\n")
        HaltProgram
    }
    cres = Socket.ConnectUnix(sock, "/tmp/ailang_display.sock")
    IfCondition LessThan(cres, 0) ThenBlock: {
        PrintMessage("[DocDrive] connect fail — is display.x up?\n")
        Socket.Close(sock)
        HaltProgram
    }

    Socket.SendMsg(sock, "{\"method\":\"register\",\"service\":\"doc_drive\"}")
    Socket.SendMsg(sock, "{\"method\":\"window.create\",\"title\":\"Letter camera\",\"w\":520,\"h\":420,\"html\":\"config/docview_test.html\"}")

    resp = Socket.RecvMsg(sock)
    IfCondition EqualTo(resp, 0) ThenBlock: {
        PrintMessage("[DocDrive] no window.created\n")
        Socket.Close(sock)
        HaltProgram
    }
    PrintMessage("[DocDrive] ")
    PrintMessage(resp)
    PrintMessage("\n")
    PrintMessage("[DocDrive] window stays open — empty Letter sheet in the camera\n")
    Socket.Close(sock)
}
