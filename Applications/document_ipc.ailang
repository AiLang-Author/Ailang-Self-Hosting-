// document_ipc.ailang
// Programs-menu IPC app: Letter paper camera (DocView).
// Same shape as notepad_ipc — register, window.create, stay until closed.
//
// Build: ./ailang.x Applications/document_ipc.ailang -o document.x
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.StringUtils
LibraryImport.JSON
LibraryImport.Arrays
LibraryImport.Hash

FixedPool.DocIPCState {
    "running":   Initialize=1, CanChange=True
    "win_id":    Initialize=0, CanChange=True
    "msg_count": Initialize=0, CanChange=True
}

SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  Document IPC Client\n")
    PrintMessage("============================================\n\n")

    sock = Socket.Create(1, 1)
    IfCondition LessThan(sock, 0) ThenBlock: {
        PrintMessage("[Document] socket fail\n")
        HaltProgram
    }

    cres = Socket.ConnectUnix(sock, "/tmp/ailang_display.sock")
    IfCondition LessThan(cres, 0) ThenBlock: {
        PrintMessage("[Document] connect fail — is display.x up?\n")
        Socket.Close(sock)
        HaltProgram
    }

    Socket.SendMsg(sock, "{\"method\":\"register\",\"service\":\"document\"}")
    Socket.SendMsg(sock, "{\"method\":\"window.create\",\"title\":\"Untitled - Document\",\"w\":720,\"h\":520,\"html\":\"config/document.html\"}")

    resp = Socket.RecvMsg(sock)
    IfCondition EqualTo(resp, 0) ThenBlock: {
        PrintMessage("[Document] no window.created\n")
        Socket.Close(sock)
        HaltProgram
    }

    parsed = ParseJSON(resp)
    IfCondition NotEqual(parsed, 0) ThenBlock: {
        pobj = JSON.AsObject(parsed)
        DocIPCState.win_id = JSON.GetNumber(pobj, "win_id")
        JSON.Free(parsed)
    }
    PrintMessage("[Document] win_id=")
    PrintNumber(DocIPCState.win_id)
    PrintMessage("\n")

    WhileLoop EqualTo(DocIPCState.running, 1) {
        msg = Socket.RecvMsg(sock)
        IfCondition EqualTo(msg, 0) ThenBlock: {
            DocIPCState.running = 0
        }
        ElseBlock: {
            DocIPCState.msg_count = Add(DocIPCState.msg_count, 1)
            pmsg = ParseJSON(msg)
            IfCondition NotEqual(pmsg, 0) ThenBlock: {
                mobj = JSON.AsObject(pmsg)
                method = JSON.GetString(mobj, "method")
                IfCondition NotEqual(method, 0) ThenBlock: {
                    cmp_closed = StringCompare(method, "window.closed")
                    IfCondition EqualTo(cmp_closed, 0) ThenBlock: {
                        DocIPCState.running = 0
                    }
                }
                JSON.Free(pmsg)
            }
        }
    }

    Socket.Close(sock)
    PrintMessage("[Document] exit\n")
}

// Compiler only emits an entry call for some layouts if a later
// declaration exists (otherwise Main is jmp-skipped and the ELF
// mmap+exit(0)s). Keep a real call:
RunTask(Main)
