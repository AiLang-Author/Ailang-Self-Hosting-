// notepad_drive.ailang — IPC driver for the notepad TEXTFIELD.
// Connects to the display server, opens a Notepad window, inserts a
// known string via textfield.insert, and prints the reply.
//
// Build: ./ailang.x Applications/notepad_drive.ailang -o /tmp/notepad_drive.x
// Run:   /tmp/notepad_drive.x   (guest, with display.x up)
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.StringUtils
LibraryImport.JSON

SubRoutine.Main {
    Arena_Init()
    PrintMessage("[Drive] connecting\n")

    sock = Socket.Create(1, 1)
    IfCondition LessThan(sock, 0) ThenBlock: {
        PrintMessage("[Drive] socket fail\n")
        HaltProgram
    }
    cres = Socket.ConnectUnix(sock, "/tmp/ailang_display.sock")
    IfCondition LessThan(cres, 0) ThenBlock: {
        PrintMessage("[Drive] connect fail\n")
        Socket.Close(sock)
        HaltProgram
    }

    Socket.SendMsg(sock, "{\"method\":\"register\",\"service\":\"notepad_drive\"}")
    Socket.SendMsg(sock, "{\"method\":\"window.create\",\"title\":\"Drive - Notepad\",\"w\":620,\"h\":460,\"html\":\"config/notepad.html\"}")

    resp = Socket.RecvMsg(sock)
    IfCondition EqualTo(resp, 0) ThenBlock: {
        PrintMessage("[Drive] no window.created\n")
        Socket.Close(sock)
        HaltProgram
    }

    win_id = 0
    parsed = ParseJSON(resp)
    IfCondition NotEqual(parsed, 0) ThenBlock: {
        pobj = JSON.AsObject(parsed)
        win_id = JSON.GetNumber(pobj, "win_id")
        JSON.Free(parsed)
    }
    PrintMessage("[Drive] win_id=")
    PrintNumber(win_id)
    PrintMessage("\n")

    IfCondition LessEqual(win_id, 0) ThenBlock: {
        PrintMessage("[Drive] bad win_id\n")
        Socket.Close(sock)
        HaltProgram
    }

    // Build insert JSON: {"method":"textfield.insert","win_id":N,"text":"..."}
    req = JSON.NewObject()
    JSON.SetString(req, "method", "textfield.insert")
    JSON.SetNumber(req, "win_id", win_id)
    JSON.SetString(req, "text", "The quick brown fox jumps over the lazy dog.")
    req_str = JSON.SerializeObject(req)
    Socket.SendMsg(sock, req_str)
    JSON.Free(req)
    PrintMessage("[Drive] sent insert\n")

    ack = Socket.RecvMsg(sock)
    IfCondition EqualTo(ack, 0) ThenBlock: {
        PrintMessage("[Drive] no insert ack\n")
    } ElseBlock: {
        PrintMessage("[Drive] ack: ")
        PrintMessage(ack)
        PrintMessage("\n")
    }

    PrintMessage("[Drive] done — window stays open\n")
    Socket.Close(sock)
}
