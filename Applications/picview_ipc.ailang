// picview_ipc.ailang
// Standalone picture viewer. Decode JPEG/PNG here, stream BGRA
// through ShmCanvas. Display.x never sees the decoder.
//
// Parent writes the blob path to /tmp/picview.path then fork/execs us.
//
// Build: ./ailang.x Applications/picview_ipc.ailang -o picview.x
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.StringUtils
LibraryImport.JSON
LibraryImport.Hash
LibraryImport.ShmCanvas
LibraryImport.Display.Content.ImgXlat
LibraryImport.Browser.ImageDecode

FixedPool.PVSys {
    "SYS_READ":  Initialize=0
    "SYS_OPEN":  Initialize=2
    "SYS_CLOSE": Initialize=3
    "SYS_STAT":  Initialize=4
}

FixedPool.PVState {
    "running": Initialize=1, CanChange=True
    "win_id":  Initialize=0, CanChange=True
    "sock":    Initialize=0, CanChange=True
    "handle":  Initialize=-1, CanChange=True
    "cw":      Initialize=640, CanChange=True
    "ch":      Initialize=480, CanChange=True
    "path":    Initialize=0, CanChange=True
    "buf":     Initialize=0, CanChange=True
    "n":       Initialize=0, CanChange=True
    "fd":      Initialize=-1, CanChange=True
}

Function.PV_ReadPath {
    Output: Integer
    Body: {
        PVState.fd = SystemCall(PVSys.SYS_OPEN, "/tmp/picview.path", 0, 0, 0, 0)
        IfCondition LessThan(PVState.fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        PVState.buf = Allocate(256)
        MemorySet(PVState.buf, 0, 256)
        PVState.n = SystemCall(PVSys.SYS_READ, PVState.fd, PVState.buf, 255, 0, 0)
        SystemCall(PVSys.SYS_CLOSE, PVState.fd, 0, 0, 0, 0)
        IfCondition LessThan(PVState.n, 8) ThenBlock: {
            ReturnValue(0)
        }
        SetByte(PVState.buf, PVState.n, 0)
        PVState.path = PVState.buf
        ReturnValue(1)
    }
}

Function.PV_LoadFile {
    Output: Integer
    Body: {
        IfCondition EqualTo(PVState.path, 0) ThenBlock: {
            ReturnValue(-1)
        }
        PVState.fd = SystemCall(PVSys.SYS_OPEN, PVState.path, 0, 0, 0, 0)
        IfCondition LessThan(PVState.fd, 0) ThenBlock: {
            PrintMessage("[PicView] open fail\n")
            ReturnValue(-1)
        }
        PVState.buf = Allocate(65536)
        IfCondition EqualTo(PVState.buf, 0) ThenBlock: {
            PrintMessage("[PicView] buf alloc fail\n")
            SystemCall(PVSys.SYS_CLOSE, PVState.fd, 0, 0, 0, 0)
            ReturnValue(-1)
        }
        PVState.n = SystemCall(PVSys.SYS_READ, PVState.fd, PVState.buf, 65536, 0, 0)
        SystemCall(PVSys.SYS_CLOSE, PVState.fd, 0, 0, 0, 0)
        PrintMessage("[PicView] read n=")
        PrintNumber(PVState.n)
        PrintMessage("\n")
        IfCondition LessThan(PVState.n, 8) ThenBlock: {
            PrintMessage("[PicView] read fail n=")
            PrintNumber(PVState.n)
            PrintMessage("\n")
            ReturnValue(-1)
        }
        PVState.handle = ImgXlat_Translate(PVState.buf, PVState.n)
        ReturnValue(PVState.handle)
    }
}

Function.PV_Fill {
    Input: color: Integer
    Body: {
        ImgBlit.sdata = ShmCanvasState.buf
        IfCondition EqualTo(ImgBlit.sdata, 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgBlit.pitch = Multiply(Multiply(PVState.cw, PVState.ch), 4)
        ImgBlit.x = 0
        WhileLoop LessThan(ImgBlit.x, ImgBlit.pitch) {
            StoreValue(Add(ImgBlit.sdata, ImgBlit.x), color, "dword")
            ImgBlit.x = Add(ImgBlit.x, 4)
        }
    }
}

Function.PV_Present {
    Body: {
        IfCondition EqualTo(ShmCanvasState.buf, 0) ThenBlock: {
            ReturnValue(0)
        }
        PV_Fill(0xFF060912)
        IfCondition LessThan(PVState.handle, 0) ThenBlock: {
            ShmCanvas_Present(PVState.sock, PVState.win_id)
            ReturnValue(0)
        }
        ImgBlit.sw = IMG_GetWidth(PVState.handle)
        ImgBlit.sh = IMG_GetHeight(PVState.handle)
        IfCondition Or(LessEqual(ImgBlit.sw, 0), LessEqual(ImgBlit.sh, 0)) ThenBlock: {
            ShmCanvas_Present(PVState.sock, PVState.win_id)
            ReturnValue(0)
        }
        IfCondition GreaterThan(Multiply(ImgBlit.sw, PVState.ch), Multiply(ImgBlit.sh, PVState.cw)) ThenBlock: {
            ImgBlit.dw = PVState.cw
            ImgBlit.dh = Divide(Multiply(ImgBlit.sh, PVState.cw), ImgBlit.sw)
        }
        ElseBlock: {
            ImgBlit.dh = PVState.ch
            ImgBlit.dw = Divide(Multiply(ImgBlit.sw, PVState.ch), ImgBlit.sh)
        }
        IfCondition LessThan(ImgBlit.dw, 1) ThenBlock: { ImgBlit.dw = 1 }
        IfCondition LessThan(ImgBlit.dh, 1) ThenBlock: { ImgBlit.dh = 1 }
        ImgBlit.surf = 0
        ImgBlit.sdata = ShmCanvasState.buf
        ImgBlit.spitch = Multiply(PVState.cw, 4)
        ImgBlit.dx = Divide(Subtract(PVState.cw, ImgBlit.dw), 2)
        ImgBlit.dy = Divide(Subtract(PVState.ch, ImgBlit.dh), 2)
        ImgBlit.cx0 = 0
        ImgBlit.cy0 = 0
        ImgBlit.cx1 = PVState.cw
        ImgBlit.cy1 = PVState.ch
        ImgXlat_Blit(PVState.handle)
        ShmCanvas_Present(PVState.sock, PVState.win_id)
    }
}

Function.PV_Reload {
    Body: {
        IfCondition EqualTo(PV_ReadPath(), 0) ThenBlock: {
            PrintMessage("[PicView] reload: no path\n")
            PVState.handle = -1
            PV_Present()
            ReturnValue(0)
        }
        PrintMessage("[PicView] path=")
        PrintMessage(PVState.path)
        PrintMessage("\n")
        IfCondition LessThan(PV_LoadFile(), 0) ThenBlock: {
            PrintMessage("[PicView] load fail\n")
            PVState.handle = -1
        }
        PV_Present()
    }
}

Function.PV_HandleMsg {
    Input: msg: Address
    Body: {
        IfCondition EqualTo(msg, 0) ThenBlock: {
            PVState.running = 0
            ReturnValue(0)
        }
        pmsg = ParseJSON(msg)
        IfCondition EqualTo(pmsg, 0) ThenBlock: {
            ReturnValue(0)
        }
        mobj = JSON.AsObject(pmsg)
        method = JSON.GetString(mobj, "method")
        IfCondition NotEqual(method, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(method, "window.closed"), 0) ThenBlock: {
                PVState.running = 0
            }
            IfCondition EqualTo(StringCompare(method, "input.action"), 0) ThenBlock: {
                action = JSON.GetString(mobj, "action")
                IfCondition NotEqual(action, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(action, "pv.reload"), 0) ThenBlock: {
                        PV_Reload()
                    }
                    IfCondition EqualTo(StringCompare(action, "doc.open"), 0) ThenBlock: {
                        Socket.SendMsg(PVState.sock, "{\"method\":\"file.pick\"}")
                    }
                }
            }
        }
        JSON.Free(pmsg)
    }
}

SubRoutine.Main {
    Arena_Init()
    IMG_Init()
    PrintMessage("[PicView] standalone\n")

    had = PV_ReadPath()
    IfCondition EqualTo(had, 1) ThenBlock: {
        PrintMessage("[PicView] path=")
        PrintMessage(PVState.path)
        PrintMessage("\n")
        IfCondition LessThan(PV_LoadFile(), 0) ThenBlock: {
            PrintMessage("[PicView] load fail — empty window\n")
            PVState.handle = -1
            had = 0
        }
    }
    ElseBlock: {
        PrintMessage("[PicView] no /tmp/picview.path\n")
        PVState.handle = -1
    }

    PVState.sock = Socket.Create(1, 1)
    IfCondition LessThan(PVState.sock, 0) ThenBlock: {
        HaltProgram
    }
    IfCondition LessThan(Socket.ConnectUnix(PVState.sock, "/tmp/ailang_display.sock"), 0) ThenBlock: {
        PrintMessage("[PicView] display sock fail\n")
        HaltProgram
    }
    Socket.SendMsg(PVState.sock, "{\"method\":\"register\",\"service\":\"picview\"}")
    Socket.SendMsg(PVState.sock, "{\"method\":\"window.create\",\"title\":\"Picture\",\"w\":640,\"h\":480,\"html\":\"config/picview.html\"}")
    resp = Socket.RecvMsg(PVState.sock)
    IfCondition EqualTo(resp, 0) ThenBlock: {
        PrintMessage("[PicView] no window.created\n")
        HaltProgram
    }
    parsed = ParseJSON(resp)
    IfCondition NotEqual(parsed, 0) ThenBlock: {
        pobj = JSON.AsObject(parsed)
        PVState.win_id = JSON.GetNumber(pobj, "win_id")
        JSON.Free(parsed)
    }
    PrintMessage("[PicView] win=")
    PrintNumber(PVState.win_id)
    PrintMessage("\n")

    IfCondition EqualTo(ShmCanvas_Create(PVState.win_id, PVState.cw, PVState.ch), 0) ThenBlock: {
        PrintMessage("[PicView] shm fail\n")
        HaltProgram
    }
    ShmCanvas_Attach(PVState.sock, PVState.win_id, PVState.cw, PVState.ch)
    PV_Present()

    IfCondition EqualTo(had, 0) ThenBlock: {
        Socket.SendMsg(PVState.sock, "{\"method\":\"file.pick\"}")
    }

    WhileLoop EqualTo(PVState.running, 1) {
        msg = Socket.RecvMsg(PVState.sock)
        PV_HandleMsg(msg)
    }
    ShmCanvas_Destroy(PVState.win_id)
    Socket.Close(PVState.sock)
    PrintMessage("[PicView] exit\n")
}

RunTask(Main)
