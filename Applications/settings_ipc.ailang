// settings_ipc.ailang
// Standalone IPC Settings application — connects to display server,
// provides GUI for configuring Theme, Font sizes, and Layout dimensions.
//
// Protocol:
//   1. Connect to /tmp/ailang_display.sock
//   2. Send {"method":"register","service":"settings"}
//   3. Send {"method":"window.create","title":"Settings","w":420,"h":520,"html":"config/settings.html"}
//   4. Receive {"method":"window.created","win_id":N}
//   5. Service loop:
//      - Receive {"method":"input.action","action":"s.theme.dark",...}
//      - Dispatch to Settings_HandleAction
//      - Send window.setlabel to update value displays
//      - Send sys.action / settings.save to apply changes
//   6. On {"method":"window.closed"} → exit
//
// Build: ./ailang.x Applications/settings_ipc.ailang -o settings.x

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.StringUtils
LibraryImport.JSON
LibraryImport.Arrays
LibraryImport.Hash

FixedPool.SettingsState {
    "running":     Initialize=1
    "win_id":      Initialize=0
    "sock":        Initialize=0
    "msg_count":   Initialize=0
    "font_body":   Initialize=18
    "font_title":  Initialize=24
    "font_menu":   Initialize=14
    "font_label":  Initialize=12
    "toolbar_h":   Initialize=24
    "deskbar_h":   Initialize=40
    "border_w":    Initialize=4
    "header_h":    Initialize=24
}

SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  Settings IPC Client\n")
    PrintMessage("============================================\n\n")

    sock_path = "/tmp/ailang_display.sock"

    // Connect to display server
    sock = Socket.Create(1, 1)
    IfCondition LessThan(sock, 0) ThenBlock: {
        PrintMessage("[Settings] Socket create failed\n")
        HaltProgram
    }

    cres = Socket.ConnectUnix(sock, sock_path)
    IfCondition LessThan(cres, 0) ThenBlock: {
        PrintMessage("[Settings] Connect failed — is display server running?\n")
        Socket.Close(sock)
        HaltProgram
    }
    SettingsState.sock = sock
    PrintMessage("[Settings] Connected to display server\n")

    // Step 1: Register
    Socket.SendMsg(sock, "{\"method\":\"register\",\"service\":\"settings\"}")
    PrintMessage("[Settings] Sent register\n")

    // Step 2: Request window
    Socket.SendMsg(sock, "{\"method\":\"window.create\",\"title\":\"Settings\",\"w\":420,\"h\":520,\"html\":\"config/settings.html\"}")
    PrintMessage("[Settings] Sent window.create\n")

    // Step 3: Wait for window.created response
    resp = Socket.RecvMsg(sock)
    IfCondition EqualTo(resp, 0) ThenBlock: {
        PrintMessage("[Settings] No response to window.create\n")
        Socket.Close(sock)
        HaltProgram
    }

    parsed = ParseJSON(resp)
    IfCondition NotEqual(parsed, 0) ThenBlock: {
        pobj = JSON.AsObject(parsed)
        wid = JSON.GetNumber(pobj, "win_id")
        SettingsState.win_id = wid
        PrintMessage("[Settings] Window created, win_id=")
        PrintNumber(wid)
        PrintMessage("\n")
        JSON.Free(parsed)
    }

    PrintMessage("[Settings] Waiting for input...\n\n")

    // Step 4: Service loop
    WhileLoop EqualTo(SettingsState.running, 1) {
        msg = Socket.RecvMsg(sock)
        IfCondition EqualTo(msg, 0) ThenBlock: {
            PrintMessage("[Settings] Connection closed\n")
            SettingsState.running = 0
        } ElseBlock: {
            SettingsState.msg_count = Add(SettingsState.msg_count, 1)

            pmsg = ParseJSON(msg)
            IfCondition NotEqual(pmsg, 0) ThenBlock: {
                mobj = JSON.AsObject(pmsg)
                method = JSON.GetString(mobj, "method")

                IfCondition NotEqual(method, 0) ThenBlock: {
                    // Check for window.closed
                    cmp_closed = StringCompare(method, "window.closed")
                    IfCondition EqualTo(cmp_closed, 0) ThenBlock: {
                        PrintMessage("[Settings] Window closed by user\n")
                        SettingsState.running = 0
                    }

                    // Check for input.action
                    cmp_action = StringCompare(method, "input.action")
                    IfCondition EqualTo(cmp_action, 0) ThenBlock: {
                        action = JSON.GetString(mobj, "action")
                        IfCondition NotEqual(action, 0) ThenBlock: {
                            action_len = JSON.GetNumber(mobj, "action_len")
                            Settings_HandleAction(action, action_len)
                        }
                    }
                }
                JSON.Free(pmsg)
            }
        }
    }

    Socket.Close(sock)

    PrintMessage("\n============================================\n")
    PrintMessage("  Settings handled ")
    PrintNumber(SettingsState.msg_count)
    PrintMessage(" messages\n")
    PrintMessage("============================================\n")
}

// =============================================================================
// HANDLE ACTION — dispatch Auckland action strings
//
// Action strings from settings.html:
//   "s.theme.dark"   "s.theme.light"
//   "s.font_body.up" "s.font_body.dn"
//   "s.font_title.up" "s.font_title.dn"
//   "s.font_menu.up" "s.font_menu.dn"
//   "s.font_label.up" "s.font_label.dn"
//   "s.toolbar_h.up" "s.toolbar_h.dn"
//   "s.deskbar_h.up" "s.deskbar_h.dn"
//   "s.border_w.up"  "s.border_w.dn"
//   "s.header_h.up"  "s.header_h.dn"
//   "s.apply"        "s.reset"
// =============================================================================
Function.Settings_HandleAction {
    Input: action: Address
    Input: action_len: Integer
    Body: {
        // All actions start with "s."
        IfCondition LessThan(action_len, 3) ThenBlock: { ReturnValue(0) }

        c0 = GetByte(action, 0)
        c1 = GetByte(action, 1)
        // 's'=115 '.'=46
        IfCondition NotEqual(c0, 115) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(c1, 46) ThenBlock: { ReturnValue(0) }

        // --- s.theme.dark (12 chars) ---
        cmp_td = StringCompare(action, "s.theme.dark")
        IfCondition EqualTo(cmp_td, 0) ThenBlock: {
            PrintMessage("[Settings] Switch to dark theme\n")
            Settings_SendSysAction(SettingsState.sock, "sys.theme.dark")
            Settings_SetLabel(SettingsState.win_id, "theme_name", 10, "dark", 4)
            Settings_SetStatus("Theme: dark")
            ReturnValue(0)
        }

        // --- s.theme.light (13 chars) ---
        cmp_tl = StringCompare(action, "s.theme.light")
        IfCondition EqualTo(cmp_tl, 0) ThenBlock: {
            PrintMessage("[Settings] Switch to light theme\n")
            Settings_SendSysAction(SettingsState.sock, "sys.theme.light")
            Settings_SetLabel(SettingsState.win_id, "theme_name", 10, "light", 5)
            Settings_SetStatus("Theme: light")
            ReturnValue(0)
        }

        // --- s.font_body.up ---
        cmp_fbu = StringCompare(action, "s.font_body.up")
        IfCondition EqualTo(cmp_fbu, 0) ThenBlock: {
            IfCondition LessThan(SettingsState.font_body, 32) ThenBlock: {
                SettingsState.font_body = Add(SettingsState.font_body, 1)
            }
            Settings_UpdateNumLabel("font_body", 9, SettingsState.font_body)
            ReturnValue(0)
        }
        cmp_fbd = StringCompare(action, "s.font_body.dn")
        IfCondition EqualTo(cmp_fbd, 0) ThenBlock: {
            IfCondition GreaterThan(SettingsState.font_body, 8) ThenBlock: {
                SettingsState.font_body = Subtract(SettingsState.font_body, 1)
            }
            Settings_UpdateNumLabel("font_body", 9, SettingsState.font_body)
            ReturnValue(0)
        }

        // --- s.font_title.up ---
        cmp_ftu = StringCompare(action, "s.font_title.up")
        IfCondition EqualTo(cmp_ftu, 0) ThenBlock: {
            IfCondition LessThan(SettingsState.font_title, 48) ThenBlock: {
                SettingsState.font_title = Add(SettingsState.font_title, 1)
            }
            Settings_UpdateNumLabel("font_title", 10, SettingsState.font_title)
            ReturnValue(0)
        }
        cmp_ftd = StringCompare(action, "s.font_title.dn")
        IfCondition EqualTo(cmp_ftd, 0) ThenBlock: {
            IfCondition GreaterThan(SettingsState.font_title, 10) ThenBlock: {
                SettingsState.font_title = Subtract(SettingsState.font_title, 1)
            }
            Settings_UpdateNumLabel("font_title", 10, SettingsState.font_title)
            ReturnValue(0)
        }

        // --- s.font_menu.up ---
        cmp_fmu = StringCompare(action, "s.font_menu.up")
        IfCondition EqualTo(cmp_fmu, 0) ThenBlock: {
            IfCondition LessThan(SettingsState.font_menu, 28) ThenBlock: {
                SettingsState.font_menu = Add(SettingsState.font_menu, 1)
            }
            Settings_UpdateNumLabel("font_menu", 9, SettingsState.font_menu)
            ReturnValue(0)
        }
        cmp_fmd = StringCompare(action, "s.font_menu.dn")
        IfCondition EqualTo(cmp_fmd, 0) ThenBlock: {
            IfCondition GreaterThan(SettingsState.font_menu, 8) ThenBlock: {
                SettingsState.font_menu = Subtract(SettingsState.font_menu, 1)
            }
            Settings_UpdateNumLabel("font_menu", 9, SettingsState.font_menu)
            ReturnValue(0)
        }

        // --- s.font_label.up ---
        cmp_flu = StringCompare(action, "s.font_label.up")
        IfCondition EqualTo(cmp_flu, 0) ThenBlock: {
            IfCondition LessThan(SettingsState.font_label, 24) ThenBlock: {
                SettingsState.font_label = Add(SettingsState.font_label, 1)
            }
            Settings_UpdateNumLabel("font_label", 10, SettingsState.font_label)
            ReturnValue(0)
        }
        cmp_fld = StringCompare(action, "s.font_label.dn")
        IfCondition EqualTo(cmp_fld, 0) ThenBlock: {
            IfCondition GreaterThan(SettingsState.font_label, 6) ThenBlock: {
                SettingsState.font_label = Subtract(SettingsState.font_label, 1)
            }
            Settings_UpdateNumLabel("font_label", 10, SettingsState.font_label)
            ReturnValue(0)
        }

        // --- s.toolbar_h.up ---
        cmp_thu = StringCompare(action, "s.toolbar_h.up")
        IfCondition EqualTo(cmp_thu, 0) ThenBlock: {
            IfCondition LessThan(SettingsState.toolbar_h, 48) ThenBlock: {
                SettingsState.toolbar_h = Add(SettingsState.toolbar_h, 2)
            }
            Settings_UpdateNumLabel("toolbar_h", 9, SettingsState.toolbar_h)
            ReturnValue(0)
        }
        cmp_thd = StringCompare(action, "s.toolbar_h.dn")
        IfCondition EqualTo(cmp_thd, 0) ThenBlock: {
            IfCondition GreaterThan(SettingsState.toolbar_h, 16) ThenBlock: {
                SettingsState.toolbar_h = Subtract(SettingsState.toolbar_h, 2)
            }
            Settings_UpdateNumLabel("toolbar_h", 9, SettingsState.toolbar_h)
            ReturnValue(0)
        }

        // --- s.deskbar_h.up ---
        cmp_dhu = StringCompare(action, "s.deskbar_h.up")
        IfCondition EqualTo(cmp_dhu, 0) ThenBlock: {
            IfCondition LessThan(SettingsState.deskbar_h, 64) ThenBlock: {
                SettingsState.deskbar_h = Add(SettingsState.deskbar_h, 2)
            }
            Settings_UpdateNumLabel("deskbar_h", 9, SettingsState.deskbar_h)
            ReturnValue(0)
        }
        cmp_dhd = StringCompare(action, "s.deskbar_h.dn")
        IfCondition EqualTo(cmp_dhd, 0) ThenBlock: {
            IfCondition GreaterThan(SettingsState.deskbar_h, 24) ThenBlock: {
                SettingsState.deskbar_h = Subtract(SettingsState.deskbar_h, 2)
            }
            Settings_UpdateNumLabel("deskbar_h", 9, SettingsState.deskbar_h)
            ReturnValue(0)
        }

        // --- s.border_w.up ---
        cmp_bwu = StringCompare(action, "s.border_w.up")
        IfCondition EqualTo(cmp_bwu, 0) ThenBlock: {
            IfCondition LessThan(SettingsState.border_w, 12) ThenBlock: {
                SettingsState.border_w = Add(SettingsState.border_w, 1)
            }
            Settings_UpdateNumLabel("border_w", 8, SettingsState.border_w)
            ReturnValue(0)
        }
        cmp_bwd = StringCompare(action, "s.border_w.dn")
        IfCondition EqualTo(cmp_bwd, 0) ThenBlock: {
            IfCondition GreaterThan(SettingsState.border_w, 1) ThenBlock: {
                SettingsState.border_w = Subtract(SettingsState.border_w, 1)
            }
            Settings_UpdateNumLabel("border_w", 8, SettingsState.border_w)
            ReturnValue(0)
        }

        // --- s.header_h.up ---
        cmp_hhu = StringCompare(action, "s.header_h.up")
        IfCondition EqualTo(cmp_hhu, 0) ThenBlock: {
            IfCondition LessThan(SettingsState.header_h, 48) ThenBlock: {
                SettingsState.header_h = Add(SettingsState.header_h, 2)
            }
            Settings_UpdateNumLabel("header_h", 8, SettingsState.header_h)
            ReturnValue(0)
        }
        cmp_hhd = StringCompare(action, "s.header_h.dn")
        IfCondition EqualTo(cmp_hhd, 0) ThenBlock: {
            IfCondition GreaterThan(SettingsState.header_h, 16) ThenBlock: {
                SettingsState.header_h = Subtract(SettingsState.header_h, 2)
            }
            Settings_UpdateNumLabel("header_h", 8, SettingsState.header_h)
            ReturnValue(0)
        }

        // --- s.apply ---
        cmp_apply = StringCompare(action, "s.apply")
        IfCondition EqualTo(cmp_apply, 0) ThenBlock: {
            PrintMessage("[Settings] Apply settings\n")
            Settings_SaveAll()
            Settings_SendSysAction(SettingsState.sock, "sys.settings.apply")
            Settings_SetStatus("Settings applied")
            ReturnValue(0)
        }

        // --- s.reset ---
        cmp_reset = StringCompare(action, "s.reset")
        IfCondition EqualTo(cmp_reset, 0) ThenBlock: {
            PrintMessage("[Settings] Reset to defaults\n")
            SettingsState.font_body = 18
            SettingsState.font_title = 24
            SettingsState.font_menu = 14
            SettingsState.font_label = 12
            SettingsState.toolbar_h = 24
            SettingsState.deskbar_h = 40
            SettingsState.border_w = 4
            SettingsState.header_h = 24
            Settings_UpdateNumLabel("font_body", 9, 18)
            Settings_UpdateNumLabel("font_title", 10, 24)
            Settings_UpdateNumLabel("font_menu", 9, 14)
            Settings_UpdateNumLabel("font_label", 10, 12)
            Settings_UpdateNumLabel("toolbar_h", 9, 24)
            Settings_UpdateNumLabel("deskbar_h", 9, 40)
            Settings_UpdateNumLabel("border_w", 8, 4)
            Settings_UpdateNumLabel("header_h", 8, 24)
            Settings_SetStatus("Reset to defaults")
            ReturnValue(0)
        }

        PrintMessage("[Settings] Unknown action: ")
        PrintString(action)
        PrintMessage("\n")
    }
}

// =============================================================================
// SAVE ALL — send settings.save for each pending value
// =============================================================================
Function.Settings_SaveAll {
    Body: {
        sock = SettingsState.sock
        Settings_SaveOne(sock, "font_body", 9, SettingsState.font_body)
        Settings_SaveOne(sock, "font_title", 10, SettingsState.font_title)
        Settings_SaveOne(sock, "font_menu", 9, SettingsState.font_menu)
        Settings_SaveOne(sock, "font_label", 10, SettingsState.font_label)
        Settings_SaveOne(sock, "toolbar_h", 9, SettingsState.toolbar_h)
        Settings_SaveOne(sock, "deskbar_h", 9, SettingsState.deskbar_h)
        Settings_SaveOne(sock, "border_w", 8, SettingsState.border_w)
        Settings_SaveOne(sock, "header_h", 8, SettingsState.header_h)
    }
}

// =============================================================================
// SAVE ONE — send {"method":"settings.save","key":"K","value":"V"}
// =============================================================================
Function.Settings_SaveOne {
    Input: sock: Integer
    Input: key: Address
    Input: key_len: Integer
    Input: value: Integer
    Body: {
        // Build JSON: {"method":"settings.save","key":"...","value":"..."}
        buf = Allocate(128)
        pos = 0

        prefix = "{\"method\":\"settings.save\",\"key\":\""
        plen = StringLength(prefix)
        MemoryCopy(buf, prefix, plen)
        pos = plen

        // Copy key
        MemoryCopy(Add(buf, pos), key, key_len)
        pos = Add(pos, key_len)

        // ","value":"
        mid = "\",\"value\":\""
        mlen = StringLength(mid)
        MemoryCopy(Add(buf, pos), mid, mlen)
        pos = Add(pos, mlen)

        // Write value as decimal
        pos = Settings_WriteInt(buf, pos, value)

        // "}
        SetByte(buf, pos, 34)
        pos = Add(pos, 1)
        SetByte(buf, pos, 125)
        pos = Add(pos, 1)
        SetByte(buf, pos, 0)

        Socket.SendMsg(sock, buf)
    }
}

// =============================================================================
// UPDATE NUM LABEL — update a label with an integer value
// =============================================================================
Function.Settings_UpdateNumLabel {
    Input: id_str: Address
    Input: id_len: Integer
    Input: value: Integer
    Body: {
        // Convert value to string
        vbuf = Allocate(8)
        vlen = Settings_IntToStr(vbuf, value)

        Settings_SetLabel(SettingsState.win_id, id_str, id_len, vbuf, vlen)
    }
}

// =============================================================================
// SET LABEL — send window.setlabel to display server
// {"method":"window.setlabel","win_id":N,"id":"xxx","text":"yyy"}
// =============================================================================
Function.Settings_SetLabel {
    Input: win_id: Integer
    Input: id_str: Address
    Input: id_len: Integer
    Input: text: Address
    Input: text_len: Integer
    Body: {
        buf = Allocate(192)
        pos = 0

        // {"method":"window.setlabel","win_id":
        prefix = "{\"method\":\"window.setlabel\",\"win_id\":"
        plen = StringLength(prefix)
        MemoryCopy(buf, prefix, plen)
        pos = plen

        // Write win_id
        pos = Settings_WriteInt(buf, pos, win_id)

        // ,"id":"
        m1 = ",\"id\":\""
        m1len = StringLength(m1)
        MemoryCopy(Add(buf, pos), m1, m1len)
        pos = Add(pos, m1len)

        // Copy id
        MemoryCopy(Add(buf, pos), id_str, id_len)
        pos = Add(pos, id_len)

        // ","text":"
        m2 = "\",\"text\":\""
        m2len = StringLength(m2)
        MemoryCopy(Add(buf, pos), m2, m2len)
        pos = Add(pos, m2len)

        // Copy text
        MemoryCopy(Add(buf, pos), text, text_len)
        pos = Add(pos, text_len)

        // "}
        SetByte(buf, pos, 34)
        pos = Add(pos, 1)
        SetByte(buf, pos, 125)
        pos = Add(pos, 1)
        SetByte(buf, pos, 0)

        Socket.SendMsg(SettingsState.sock, buf)
    }
}

// =============================================================================
// SET STATUS — update the status label
// =============================================================================
Function.Settings_SetStatus {
    Input: text: Address
    Body: {
        tlen = StringLength(text)
        Settings_SetLabel(SettingsState.win_id, "status", 6, text, tlen)
    }
}

// =============================================================================
// SEND SYS ACTION — send {"method":"sys.action","action":"..."}
// =============================================================================
Function.Settings_SendSysAction {
    Input: sock: Integer
    Input: action_str: Address
    Body: {
        buf = Allocate(96)
        pos = 0

        prefix = "{\"method\":\"sys.action\",\"action\":\""
        plen = StringLength(prefix)
        MemoryCopy(buf, prefix, plen)
        pos = plen

        alen = StringLength(action_str)
        MemoryCopy(Add(buf, pos), action_str, alen)
        pos = Add(pos, alen)

        // "}
        SetByte(buf, pos, 34)
        pos = Add(pos, 1)
        SetByte(buf, pos, 125)
        pos = Add(pos, 1)
        SetByte(buf, pos, 0)

        Socket.SendMsg(sock, buf)
    }
}

// =============================================================================
// INT TO STR — convert integer to decimal string, returns length
// =============================================================================
Function.Settings_IntToStr {
    Input: buf: Address
    Input: value: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(value, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            SetByte(buf, 1, 0)
            ReturnValue(1)
        }

        // Handle up to 3 digits (max value 999)
        tmp = Allocate(8)
        ti = 0
        v = value

        WhileLoop GreaterThan(v, 0) {
            d = Subtract(v, Multiply(Divide(v, 10), 10))
            SetByte(tmp, ti, Add(48, d))
            ti = Add(ti, 1)
            v = Divide(v, 10)
        }

        // Reverse into buf
        bi = 0
        ri = Subtract(ti, 1)
        WhileLoop GreaterEqual(ri, 0) {
            ch = GetByte(tmp, ri)
            SetByte(buf, bi, ch)
            bi = Add(bi, 1)
            ri = Subtract(ri, 1)
        }
        SetByte(buf, bi, 0)
        ReturnValue(bi)
    }
}

// =============================================================================
// WRITE INT — write integer at position in buffer, returns new position
// =============================================================================
Function.Settings_WriteInt {
    Input: buf: Address
    Input: pos: Integer
    Input: value: Integer
    Output: Integer
    Body: {
        tmp = Allocate(8)
        slen = Settings_IntToStr(tmp, value)
        MemoryCopy(Add(buf, pos), tmp, slen)
        ReturnValue(Add(pos, slen))
    }
}

RunTask(Main)
