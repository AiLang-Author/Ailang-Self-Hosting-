// terminal_ipc.ailang
// IPC terminal emulator — fork/exec /bin/bash via Linux PTY, render with
// embedded 8x16 bitmap font on ShmCanvas, forward keyboard via PTY master fd.
//
// Architecture:
//   - Open /dev/ptmx (PTY master), unlock, get slave path /dev/pts/N
//   - Fork: child does setsid + open slave + TIOCSCTTY + dup2(0/1/2) + execve bash
//   - Parent: non-blocking reads from master fd, feeds VT100 parser
//   - Parser writes chars+attrs into 80x24 cell grid
//   - TermFont renders grid to ShmCanvas every dirty tick
//   - Keyboard input from IPC → translated → written to PTY master
//
// Build: ./ailang.x Applications/terminal_ipc.ailang terminal_ipc.x
// Run:   ./terminal_ipc.x  (after SysDisplay.x is running)
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.StringUtils
LibraryImport.JSON
LibraryImport.Hash
LibraryImport.ShmCanvas
LibraryImport.TermFont

// =============================================================================
// SYSCALL CONSTANTS
// =============================================================================
FixedPool.TSys {
    "SYS_READ":      Initialize=0
    "SYS_WRITE":     Initialize=1
    "SYS_OPEN":      Initialize=2
    "SYS_CLOSE":     Initialize=3
    "SYS_IOCTL":     Initialize=16
    "SYS_DUP2":      Initialize=33
    "SYS_FORK":      Initialize=57
    "SYS_EXECVE":    Initialize=59
    "SYS_EXIT":      Initialize=60
    "SYS_KILL":      Initialize=62
    "SYS_WAIT4":     Initialize=61
    "SYS_FCNTL":     Initialize=72
    "SYS_SETSID":    Initialize=112
    "SYS_NANOSLEEP": Initialize=35
}

FixedPool.TFcntl {
    "F_GETFL":    Initialize=3
    "F_SETFL":    Initialize=4
    "O_NONBLOCK": Initialize=2048
    "O_RDWR":     Initialize=2
    "O_NOCTTY":   Initialize=256
}

FixedPool.TIoctl {
    "TIOCSPTLCK":  Initialize=1074025521
    "TIOCGPTN":    Initialize=2147767344
    "TIOCSCTTY":   Initialize=21518
    "TIOCSWINSZ":  Initialize=21524
}

FixedPool.TSig {
    "SIGTERM":  Initialize=15
    "WNOHANG":  Initialize=1
}

