    "COLS":      Initialize=80
    "ROWS":      Initialize=24
    "CHAR_W":    Initialize=8
    "CHAR_H":    Initialize=16
    "CANVAS_W":  Initialize=640
    "CANVAS_H":  Initialize=384
    "GRID_SIZE": Initialize=1920
}

