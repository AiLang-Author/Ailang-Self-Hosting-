// test_submit.ailang — Headless test for form submit URL resolution
//
// Simulates: user on http://www.google.com/ clicks submit on form action="/search"
// Expected output: http://www.google.com/search?q=test
//
// Build: ./ailang.x Applications/test_submit.ailang test_submit.x
// Run:   ./test_submit.x

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Browser.HTMLTokenizer
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayout
LibraryImport.Browser.HTMLRender
LibraryImport.TermFont
LibraryImport.Browser.URL

FixedPool.TSState {
    "cur_url":     Initialize=0
    "cur_url_len": Initialize=0
}

SubRoutine.Main {
    Arena_Init()
    HTK_Init()
    DOM_Init()
    CSS_Init()
    TermFont_Init()
    URL_Init()

    // Simulate: current URL is http://www.google.com/
    TSState.cur_url = "http://www.google.com/"
    TSState.cur_url_len = 22

    PrintMessage("=== Test Submit URL Resolution ===\n\n")
    PrintMessage("Current URL: ")
    PrintMessage(TSState.cur_url)
    PrintMessage("\nCurrent URL len: ")
    PrintNumber(TSState.cur_url_len)
    PrintMessage("\n\n")

    // Parse test HTML
    html = "<!doctype html><html><head><title>Test</title></head><body><form action=\"/search\" name=\"f\"><input name=\"q\" type=\"text\" value=\"\"><input name=\"btnG\" value=\"Search\" type=\"submit\"></form></body></html>"
    html_len = StringLength(html)

    tok_count = HTK_Tokenize(html, html_len)
    PrintMessage("Tokens: ")
    PrintNumber(tok_count)
    PrintMessage("\n")

    dom_root = DOM_ParseString(html, html_len)
    PrintMessage("DOM root: ")
    PrintNumber(dom_root)
    PrintMessage("\n")
    PrintMessage("DOM nodes: ")
    PrintNumber(DOM_NodeCount())
    PrintMessage("\n\n")

    // Find form node
    form_node = DOM_FindByTag(dom_root, "form")
    PrintMessage("Form node: ")
    PrintNumber(form_node)
    PrintMessage("\n")

    // Get action attribute
    action = DOM_GetAttr(form_node, "action")
    IfCondition EqualTo(action, 0) ThenBlock: {
        PrintMessage("ERROR: No action attribute!\n")
        SystemCall(60, 1)
    }
    PrintMessage("Action: ")
    PrintMessage(action)
    PrintMessage("\n")

    // Resolve relative URL
    act_len = StringLength(action)
    act_first = GetByte(action, 0)
    PrintMessage("Action first byte: ")
    PrintNumber(act_first)
    PrintMessage(" (should be 47 for '/')\n")

    IfCondition EqualTo(act_first, 47) ThenBlock: {
        PrintMessage("Action is relative, resolving...\n")
        cur_len = TSState.cur_url_len
        origin_end = 0
        oi = 0
        WhileLoop LessThan(oi, cur_len) {
            IfCondition And(EqualTo(GetByte(TSState.cur_url, oi), 47),
                           And(GreaterThan(oi, 0), EqualTo(GetByte(TSState.cur_url, Subtract(oi, 1)), 47))) ThenBlock: {
                PrintMessage("  Found // at oi=")
                PrintNumber(oi)
                PrintMessage("\n")
                // Found "//", find next "/"
                oj = Add(oi, 1)
                WhileLoop LessThan(oj, cur_len) {
                    IfCondition EqualTo(GetByte(TSState.cur_url, oj), 47) ThenBlock: {
                        origin_end = oj
                        oj = cur_len
                    }
                    oj = Add(oj, 1)
                }
                IfCondition EqualTo(origin_end, 0) ThenBlock: {
                    origin_end = cur_len
                }
                oi = cur_len
            }
            oi = Add(oi, 1)
        }
        PrintMessage("  origin_end = ")
        PrintNumber(origin_end)
        PrintMessage("\n")

        IfCondition GreaterThan(origin_end, 0) ThenBlock: {
            abs_action = Allocate(Add(origin_end, Add(act_len, 1)))
            MemoryCopy(abs_action, TSState.cur_url, origin_end)
            MemoryCopy(Add(abs_action, origin_end), action, act_len)
            SetByte(abs_action, Add(origin_end, act_len), 0)
            action = abs_action
            act_len = Add(origin_end, act_len)
            PrintMessage("  Resolved action: ")
            PrintMessage(action)
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("  ERROR: origin_end = 0, cannot resolve!\n")
        }
    } ElseBlock: {
        PrintMessage("Action is already absolute\n")
    }

    // Build query (simulating user typed "test")
    query = Allocate(1024)
    qpos = 0
    alen = StringLength(action)
    MemoryCopy(query, action, alen)
    qpos = alen
    SetByte(query, qpos, 63)
    qpos = Add(qpos, 1)
    // name=q
    MemoryCopy(Add(query, qpos), "q", 1)
    qpos = Add(qpos, 1)
    SetByte(query, qpos, 61)
    qpos = Add(qpos, 1)
    // value=test
    MemoryCopy(Add(query, qpos), "test", 4)
    qpos = Add(qpos, 4)
    SetByte(query, qpos, 0)

    PrintMessage("\nFinal URL: ")
    PrintMessage(query)
    PrintMessage("\nFinal URL len: ")
    PrintNumber(qpos)
    PrintMessage("\n")

    // Now try URL_Parse on the final URL
    url_h = URL_Parse(query, qpos)
    PrintMessage("\nURL_Parse result: ")
    PrintNumber(url_h)
    PrintMessage("\n")
    IfCondition GreaterEqual(url_h, 0) ThenBlock: {
        PrintMessage("  Host: ")
        PrintMessage(URL_GetHost(url_h))
        PrintMessage("\n  Port: ")
        PrintNumber(URL_GetPort(url_h))
        PrintMessage("\n  Path: ")
        PrintMessage(URL_GetPath(url_h))
        PrintMessage("\n  Query: ")
        pq = URL_GetQuery(url_h)
        IfCondition NotEqual(pq, 0) ThenBlock: {
            PrintMessage(pq)
        } ElseBlock: {
            PrintMessage("(null)")
        }
        PrintMessage("\n  HTTPS: ")
        PrintNumber(URL_IsHTTPS(url_h))
        PrintMessage("\n")
    } ElseBlock: {
        PrintMessage("  URL PARSE FAILED!\n")
    }

    PrintMessage("\n=== DONE ===\n")
    SystemCall(60, 0)
}

RunTask(Main)
