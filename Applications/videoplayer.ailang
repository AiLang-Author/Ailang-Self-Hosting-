// videoplayer.ailang
// IPC video player — decodes media via ffmpeg, renders video frames into
// a shared memory canvas + routes audio through the 3-bus ALSA mixer.
//
// Architecture:
//   - fork/exec ffmpeg with TWO pipes:
//       stdout (pipe:1)  → raw BGRA video frames
//       fd 4   (pipe:4)  → raw S16LE 48kHz stereo PCM audio
//   - Both pipes non-blocking. -re flag paces ffmpeg at native rate.
//   - Steady 2ms tick services BOTH audio and video every iteration.
//   - Audio: pipe → ring buffer → mixer → ALSA (steady feed, never starved)
//   - Video: accumulate partial reads → present when full frame ready
//   - SIGSTOP/SIGCONT for pause/resume, SIGTERM for stop
//
// Protocol:
//   1. Connect to /tmp/ailang_display.sock
//   2. Register as "videoplayer"
//   3. Create window with config/videoplayer.html
//   4. Create shm canvas 640x480
//   5. Init ALSA audio engine (graceful fallback to video-only)
//   6. On v.play:  fork ffmpeg → 2 pipes → read frames + audio → present
//   7. On v.paus:  kill(pid, SIGSTOP)
//   8. On v.play (resume): kill(pid, SIGCONT)
//   9. On v.stop:  kill(pid, SIGTERM), close pipes, Audio_Drop
//  10. On window.closed: cleanup, Audio_Shutdown, exit
//
// Build: ./ailang.x Applications/videoplayer.ailang videoplayer.x
// Run:   ./videoplayer.x  (after SysDisplay.x is running)
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.StringUtils
LibraryImport.JSON
LibraryImport.HashMap
LibraryImport.ShmCanvas
LibraryImport.Display.Render.AudioEngine

// =============================================================================
// SYSCALL CONSTANTS
// =============================================================================
FixedPool.VPSys {
    "SYS_READ":      Initialize=0
    "SYS_CLOSE":     Initialize=3
    "SYS_IOCTL":     Initialize=16
    "SYS_PIPE":      Initialize=22
    "SYS_DUP2":      Initialize=33
    "SYS_FCNTL":     Initialize=72
    "SYS_FORK":      Initialize=57
    "SYS_EXECVE":    Initialize=59
    "SYS_EXIT":      Initialize=60
    "SYS_KILL":      Initialize=62
    "SYS_WAIT4":     Initialize=61
    "SYS_NANOSLEEP":   Initialize=35
}

FixedPool.VPFcntl {
    "F_GETFL":      Initialize=3
    "F_SETFL":      Initialize=4
    "O_NONBLOCK":   Initialize=2048
}

FixedPool.VPSignal {
    "SIGTERM":  Initialize=15
    "SIGSTOP":  Initialize=19
    "SIGCONT":  Initialize=18
    "WNOHANG":  Initialize=1
}

// =============================================================================
// STATE
// =============================================================================
FixedPool.VPState {
    "running":      Initialize=1
    "win_id":       Initialize=0
    "sock":         Initialize=0
    "canvas_w":     Initialize=640
    "canvas_h":     Initialize=480
    "ffmpeg_pid":   Initialize=0
    "pipe_rd":      Initialize=-1
    "audio_pipe_rd": Initialize=-1
    "playing":      Initialize=0
    "paused":       Initialize=0
    "frame_num":    Initialize=0
    "file_path":    Initialize=0
    "audio_buf":    Initialize=0
    "audio_ok":     Initialize=0
    "frame_size":     Initialize=0
    "vid_got":        Initialize=0
    "vid_fps":        Initialize=30
    "vid_ready":      Initialize=0
    "frames_presented": Initialize=0
    "frames_dropped":   Initialize=0
}

// =============================================================================
// DEFAULT TEST FILE — user can override via v.open
// =============================================================================
FixedPool.VPFiles {
    "default": Initialize=0
}

// =============================================================================
// NUMBER TO STRING
// =============================================================================
Function.VP_NumToStr {
    Input: val: Integer
    Input: buf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            SetByte(buf, 1, 0)
            ReturnValue(1)
        }
        tmp = Allocate(24)
        n = 0
        v = val
        WhileLoop GreaterThan(v, 0) {
            SetByte(tmp, n, Add(48, Modulo(v, 10)))
            v = Divide(v, 10)
            n = Add(n, 1)
        }
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(buf, i, GetByte(tmp, Subtract(Subtract(n, 1), i)))
            i = Add(i, 1)
        }
        SetByte(buf, n, 0)
        Deallocate(tmp, 24)
        ReturnValue(n)
    }
}

// =============================================================================
// FORMAT TIME — seconds to "MM:SS" string
// =============================================================================
Function.VP_FormatTime {
    Input: secs: Integer
    Input: buf: Address
    Body: {
        m = Divide(secs, 60)
        s = Modulo(secs, 60)
        // MM
        SetByte(buf, 0, Add(48, Divide(m, 10)))
        SetByte(buf, 1, Add(48, Modulo(m, 10)))
        SetByte(buf, 2, 58)
        // SS
        SetByte(buf, 3, Add(48, Divide(s, 10)))
        SetByte(buf, 4, Add(48, Modulo(s, 10)))
        SetByte(buf, 5, 0)
    }
}

// =============================================================================
// IPC HELPERS
// =============================================================================
Function.VP_SetLabel {
    Input: sock: Integer
    Input: id: Address
    Input: text: Address
    Body: {
        req = JSON.NewObject()
        JSON.SetString(req, "method", "window.setlabel")
        JSON.SetNumber(req, "win_id", VPState.win_id)
        JSON.SetString(req, "id", id)
        JSON.SetString(req, "text", text)
        msg = JSON.SerializeObject(req)
        Socket.SendMsg(sock, msg)
        JSON.Free(req)
    }
}

// =============================================================================
// READ VIDEO TICK — non-blocking partial frame accumulation.
// Called every 2ms tick. Reads whatever bytes are available from the video
// pipe and accumulates into the canvas buffer.
// Returns:  1 = full frame ready (present it)
//           0 = partial (more data needed, keep ticking)
//          -1 = EOF / pipe closed (playback finished)
// =============================================================================
Function.VP_ReadVideoTick {
    Output: Integer
    Body: {
        rd = VPState.pipe_rd
        IfCondition LessThan(rd, 0) ThenBlock: { ReturnValue(-1) }

        buf = ShmCanvasState.buf
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(-1) }

        fsize = VPState.frame_size
        got = VPState.vid_got

        // Read whatever is available (non-blocking, may return EAGAIN)
        WhileLoop LessThan(got, fsize) {
            remain = Subtract(fsize, got)
            // Cap each read to 65536 to keep the tick short
            IfCondition GreaterThan(remain, 65536) ThenBlock: {
                remain = 65536
            }
            n = SystemCall(VPSys.SYS_READ, rd, Add(buf, got), remain)
            IfCondition EqualTo(n, 0) ThenBlock: {
                // EOF — pipe closed
                VPState.vid_got = 0
                ReturnValue(-1)
            }
            IfCondition LessThan(n, 0) ThenBlock: {
                // EAGAIN — no more data right now
                VPState.vid_got = got
                ReturnValue(0)
            }
            got = Add(got, n)
        }

        // Full frame accumulated
        VPState.vid_got = 0
        VPState.frame_num = Add(VPState.frame_num, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// BUILD SIZE STRING — "WxH" from canvas_w and canvas_h
// =============================================================================
Function.VP_BuildSizeStr {
    Output: Integer
    Body: {
        buf = Allocate(24)
        w_tmp = Allocate(12)
        h_tmp = Allocate(12)
        wlen = VP_NumToStr(VPState.canvas_w, w_tmp)
        hlen = VP_NumToStr(VPState.canvas_h, h_tmp)
        MemoryCopy(buf, w_tmp, wlen)
        SetByte(buf, wlen, 120)
        MemoryCopy(Add(buf, Add(wlen, 1)), h_tmp, hlen)
        SetByte(buf, Add(Add(wlen, 1), hlen), 0)
        Deallocate(w_tmp, 12)
        Deallocate(h_tmp, 12)
        ReturnValue(buf)
    }
}

// =============================================================================
// BUILD FFMPEG ARGV
// =============================================================================
// Video-only: ffmpeg -re -i <file> -f rawvideo -pix_fmt bgra -s WxH -v quiet pipe:1
// -re reads input at native rate — this paces raw pipe output to the file's fps.
Function.VP_BuildArgvVideoOnly {
    Input: filepath: Address
    Output: Integer
    Body: {
        size_str = VP_BuildSizeStr()
        // 14 arg pointers + null = 15 * 8 = 120 bytes
        argv = Allocate(120)
        StoreValue(Add(argv, 0),  "/usr/bin/ffmpeg")
        StoreValue(Add(argv, 8),  "-re")
        StoreValue(Add(argv, 16), "-i")
        StoreValue(Add(argv, 24), filepath)
        StoreValue(Add(argv, 32), "-an")
        StoreValue(Add(argv, 40), "-f")
        StoreValue(Add(argv, 48), "rawvideo")
        StoreValue(Add(argv, 56), "-pix_fmt")
        StoreValue(Add(argv, 64), "bgra")
        StoreValue(Add(argv, 72), "-s")
        StoreValue(Add(argv, 80), size_str)
        StoreValue(Add(argv, 88), "-v")
        StoreValue(Add(argv, 96), "quiet")
        StoreValue(Add(argv, 104), "pipe:1")
        StoreValue(Add(argv, 112), 0)
        ReturnValue(argv)
    }
}

// Video + Audio:
// ffmpeg -re -i <file> -map 0:v -f rawvideo -pix_fmt bgra -s WxH pipe:1
//        -map 0:a -af volume=3.0 -f s16le -ar 48000 -ac 2 pipe:4  -v quiet
// -re reads input at native rate — paces BOTH video and audio output.
// -af volume=2.0 pre-boosts audio at decode stage in float precision (clean).
// Most media is mastered well below 0dBFS. Software mixer stays near unity;
// user adjusts master_vol (Up/Down keys) from there.
Function.VP_BuildArgvAV {
    Input: filepath: Address
    Output: Integer
    Body: {
        size_str = VP_BuildSizeStr()
        // 26 arg pointers + null terminator = 27 * 8 = 216 bytes
        argv = Allocate(216)
        StoreValue(Add(argv, 0),   "/usr/bin/ffmpeg")
        StoreValue(Add(argv, 8),   "-re")
        StoreValue(Add(argv, 16),  "-i")
        StoreValue(Add(argv, 24),  filepath)
        // Video output: stdout
        StoreValue(Add(argv, 32),  "-map")
        StoreValue(Add(argv, 40),  "0:v:0")
        StoreValue(Add(argv, 48),  "-f")
        StoreValue(Add(argv, 56),  "rawvideo")
        StoreValue(Add(argv, 64),  "-pix_fmt")
        StoreValue(Add(argv, 72),  "bgra")
        StoreValue(Add(argv, 80),  "-s")
        StoreValue(Add(argv, 88),  size_str)
        StoreValue(Add(argv, 96),  "pipe:1")
        // Audio output: fd 4, with volume pre-boost
        StoreValue(Add(argv, 104), "-map")
        StoreValue(Add(argv, 112), "0:a:0?")
        StoreValue(Add(argv, 120), "-af")
        StoreValue(Add(argv, 128), "volume=2.0")
        StoreValue(Add(argv, 136), "-f")
        StoreValue(Add(argv, 144), "s16le")
        StoreValue(Add(argv, 152), "-ar")
        StoreValue(Add(argv, 160), "48000")
        StoreValue(Add(argv, 168), "-ac")
        StoreValue(Add(argv, 176), "2")
        StoreValue(Add(argv, 184), "pipe:4")
        // Quiet mode
        StoreValue(Add(argv, 192), "-v")
        StoreValue(Add(argv, 200), "quiet")
        StoreValue(Add(argv, 208), 0)
        ReturnValue(argv)
    }
}

// =============================================================================
// LAUNCH FFMPEG — fork, pipe, dup2, execve
// =============================================================================
Function.VP_LaunchFFmpeg {
    Input: filepath: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(filepath, 0) ThenBlock: {
            PrintMessage("[VP] No file path set\n")
            ReturnValue(-1)
        }

        // Create video pipe: pipefds[0]=read, pipefds[1]=write
        pipefds = Allocate(8)
        pr = SystemCall(VPSys.SYS_PIPE, pipefds, 0, 0, 0, 0)
        IfCondition LessThan(pr, 0) ThenBlock: {
            PrintMessage("[VP] video pipe() failed\n")
            Deallocate(pipefds, 8)
            ReturnValue(-1)
        }
        vid_read  = Dereference(pipefds, "dword")
        vid_write = Dereference(Add(pipefds, 4), "dword")

        // Create audio pipe ONLY if audio engine is available
        aud_read  = -1
        aud_write = -1
        have_audio = VPState.audio_ok
        IfCondition EqualTo(have_audio, 1) ThenBlock: {
            pr2 = SystemCall(VPSys.SYS_PIPE, pipefds, 0, 0, 0, 0)
            IfCondition GreaterEqual(pr2, 0) ThenBlock: {
                aud_read  = Dereference(pipefds, "dword")
                aud_write = Dereference(Add(pipefds, 4), "dword")
            } ElseBlock: {
                PrintMessage("[VP] audio pipe() failed, video only\n")
                have_audio = 0
            }
        }
        Deallocate(pipefds, 8)

        PrintMessage("[VP] pipes: vid_rd=")
        PrintNumber(vid_read)
        PrintMessage(" vid_wr=")
        PrintNumber(vid_write)
        IfCondition EqualTo(have_audio, 1) ThenBlock: {
            PrintMessage(" aud_rd=")
            PrintNumber(aud_read)
            PrintMessage(" aud_wr=")
            PrintNumber(aud_write)
        }
        PrintMessage("\n")

        // Fork
        pid = SystemCall(VPSys.SYS_FORK, 0, 0, 0, 0, 0)
        IfCondition LessThan(pid, 0) ThenBlock: {
            PrintMessage("[VP] fork() failed\n")
            SystemCall(VPSys.SYS_CLOSE, vid_read, 0, 0, 0, 0)
            SystemCall(VPSys.SYS_CLOSE, vid_write, 0, 0, 0, 0)
            IfCondition EqualTo(have_audio, 1) ThenBlock: {
                SystemCall(VPSys.SYS_CLOSE, aud_read, 0, 0, 0, 0)
                SystemCall(VPSys.SYS_CLOSE, aud_write, 0, 0, 0, 0)
            }
            ReturnValue(-1)
        }

        IfCondition EqualTo(pid, 0) ThenBlock: {
            // ===== CHILD PROCESS =====
            // Close parent's read ends
            SystemCall(VPSys.SYS_CLOSE, vid_read, 0, 0, 0, 0)

            // dup2(vid_write, 1) — stdout = video pipe
            SystemCall(VPSys.SYS_DUP2, vid_write, 1, 0, 0, 0)
            SystemCall(VPSys.SYS_CLOSE, vid_write, 0, 0, 0, 0)

            IfCondition EqualTo(have_audio, 1) ThenBlock: {
                SystemCall(VPSys.SYS_CLOSE, aud_read, 0, 0, 0, 0)
                // dup2(aud_write, 4) — fd 4 = audio pipe
                SystemCall(VPSys.SYS_DUP2, aud_write, 4, 0, 0, 0)
                SystemCall(VPSys.SYS_CLOSE, aud_write, 0, 0, 0, 0)
                argv = VP_BuildArgvAV(filepath)
            } ElseBlock: {
                argv = VP_BuildArgvVideoOnly(filepath)
            }

            // exec ffmpeg
            SystemCall(VPSys.SYS_EXECVE, "/usr/bin/ffmpeg", argv, 0)

            // If execve returns, something went wrong
            PrintMessage("[VP] execve failed!\n")
            SystemCall(VPSys.SYS_EXIT, 1, 0, 0, 0, 0)
        }

        // ===== PARENT PROCESS =====
        // Close write ends (only ffmpeg writes)
        SystemCall(VPSys.SYS_CLOSE, vid_write, 0, 0, 0, 0)

        IfCondition EqualTo(have_audio, 1) ThenBlock: {
            SystemCall(VPSys.SYS_CLOSE, aud_write, 0, 0, 0, 0)
            // Make audio pipe non-blocking so we can drain without stalling
            flags = SystemCall(VPSys.SYS_FCNTL, aud_read, VPFcntl.F_GETFL, 0, 0, 0)
            SystemCall(VPSys.SYS_FCNTL, aud_read, VPFcntl.F_SETFL, BitwiseOr(flags, VPFcntl.O_NONBLOCK), 0, 0)
        }

        // Video pipe also non-blocking — -re paces ffmpeg, we tick at 2ms
        vflags = SystemCall(VPSys.SYS_FCNTL, vid_read, VPFcntl.F_GETFL, 0, 0, 0)
        SystemCall(VPSys.SYS_FCNTL, vid_read, VPFcntl.F_SETFL, BitwiseOr(vflags, VPFcntl.O_NONBLOCK), 0, 0)

        VPState.pipe_rd       = vid_read
        VPState.audio_pipe_rd = aud_read
        VPState.ffmpeg_pid    = pid
        VPState.playing       = 1
        VPState.paused        = 0
        VPState.frame_num     = 0
        VPState.vid_ready     = 0
        VPState.frames_presented = 0
        VPState.frames_dropped   = 0
        VPState.frame_size    = Multiply(Multiply(VPState.canvas_w, VPState.canvas_h), 4)

        // Reset audio clock — this is the A/V sync master
        Mixer_ResetClock()

        PrintMessage("[VP] ffmpeg launched pid=")
        PrintNumber(pid)
        PrintMessage(" vid_fd=")
        PrintNumber(vid_read)
        IfCondition EqualTo(have_audio, 1) ThenBlock: {
            PrintMessage(" aud_fd=")
            PrintNumber(aud_read)
        } ElseBlock: {
            PrintMessage(" (video only)")
        }
        PrintMessage("\n")

        ReturnValue(pid)
    }
}

// =============================================================================
// STOP FFMPEG — send SIGTERM, close pipe, reap child
// =============================================================================
Function.VP_StopFFmpeg {
    Body: {
        pid = VPState.ffmpeg_pid
        IfCondition GreaterThan(pid, 0) ThenBlock: {
            // If paused, resume first so it can receive SIGTERM
            IfCondition EqualTo(VPState.paused, 1) ThenBlock: {
                SystemCall(VPSys.SYS_KILL, pid, VPSignal.SIGCONT, 0, 0, 0)
            }
            SystemCall(VPSys.SYS_KILL, pid, VPSignal.SIGTERM, 0, 0, 0)

            // Reap child (WNOHANG — non-blocking)
            status_buf = Allocate(8)
            SystemCall(VPSys.SYS_WAIT4, pid, status_buf, VPSignal.WNOHANG, 0, 0, 0)
            Deallocate(status_buf, 8)

            PrintMessage("[VP] ffmpeg stopped pid=")
            PrintNumber(pid)
            PrintMessage("\n")
        }

        rd = VPState.pipe_rd
        IfCondition GreaterEqual(rd, 0) ThenBlock: {
            SystemCall(VPSys.SYS_CLOSE, rd, 0, 0, 0, 0)
        }

        ard = VPState.audio_pipe_rd
        IfCondition GreaterEqual(ard, 0) ThenBlock: {
            SystemCall(VPSys.SYS_CLOSE, ard, 0, 0, 0, 0)
        }

        // Drop any pending audio immediately, then re-prepare for next playback.
        // Audio_Drop() leaves ALSA in SETUP state — WRITEI_FRAMES will return
        // -EBADFD (-77) unless we re-prepare. Also flush ring buffers so stale
        // PCM from previous file doesn't bleed into the next one.
        IfCondition EqualTo(VPState.audio_ok, 1) ThenBlock: {
            Audio_Drop()
            Audio_Prepare()
            AppBus.write_pos = 0
            AppBus.read_pos  = 0
            MixerState.mix_pending = 0
            Mixer_ResetClock()
        }

        VPState.ffmpeg_pid    = 0
        VPState.pipe_rd       = -1
        VPState.audio_pipe_rd = -1
        VPState.playing       = 0
        VPState.paused        = 0
        VPState.vid_got       = 0
        VPState.vid_ready     = 0
        VPState.frames_presented = 0
        VPState.frames_dropped   = 0
    }
}

// =============================================================================
// DRAIN AUDIO — read available audio from pipe, feed to mixer
// Non-blocking read: returns immediately if no data.
// Reads up to 4096 bytes per call (one period worth).
// =============================================================================
Function.VP_DrainAudio {
    Body: {
        ard = VPState.audio_pipe_rd
        IfCondition LessThan(ard, 0) ThenBlock: {
            Mixer_DrainTick()
            ReturnValue(0)
        }
        IfCondition EqualTo(VPState.audio_ok, 0) ThenBlock: { ReturnValue(0) }

        abuf = VPState.audio_buf
        // Loop: drain ALL available audio from pipe (non-blocking)
        // Use done flag to break out — MUST fall through to Mixer_DrainTick
        total_read = 0
        done = 0
        WhileLoop And(LessThan(total_read, 131072), EqualTo(done, 0)) {
            n = SystemCall(VPSys.SYS_READ, ard, abuf, 16384, 0, 0)
            IfCondition LessEqual(n, 0) ThenBlock: {
                // EAGAIN or EOF — pipe empty, exit loop
                done = 1
            } ElseBlock: {
                Mixer_AppWrite(abuf, n)
                total_read = Add(total_read, n)
            }
        }

        // Debug: log first few ticks
        IfCondition LessThan(VPState.frame_num, 5) ThenBlock: {
            PrintMessage("[VP-DBG] audio read=")
            PrintNumber(total_read)
            PrintMessage(" ring_wp=")
            PrintNumber(AppBus.write_pos)
            PrintMessage(" ring_rp=")
            PrintNumber(AppBus.read_pos)
            PrintMessage("\n")
        }

        // ALWAYS push ring buffer → ALSA. This is the critical line.
        pw = Mixer_DrainTick()

        IfCondition LessThan(VPState.frame_num, 5) ThenBlock: {
            PrintMessage("[VP-DBG] periods_written=")
            PrintNumber(pw)
            PrintMessage("\n")
        }
    }
}

// =============================================================================
// HANDLE RESIZE — destroy old canvas, recreate at new size, restart ffmpeg
// =============================================================================
Function.VP_HandleResize {
    Input: sock: Integer
    Input: new_w: Integer
    Input: new_h: Integer
    Body: {
        // Ignore zero or unchanged
        IfCondition LessEqual(new_w, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(new_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition And(EqualTo(new_w, VPState.canvas_w), EqualTo(new_h, VPState.canvas_h)) ThenBlock: {
            ReturnValue(0)
        }

        was_playing = VPState.playing
        was_paused  = VPState.paused

        // Stop ffmpeg if running
        IfCondition EqualTo(VPState.playing, 1) ThenBlock: {
            VP_StopFFmpeg()
        }

        // Destroy old canvas
        ShmCanvas_Destroy(VPState.win_id)

        // Update dimensions
        VPState.canvas_w = new_w
        VPState.canvas_h = new_h

        PrintMessage("[VP] Resize: ")
        PrintNumber(new_w)
        PrintMessage("x")
        PrintNumber(new_h)
        PrintMessage("\n")

        // Create new canvas at new size
        wid = VPState.win_id
        buf = ShmCanvas_Create(wid, new_w, new_h)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            PrintMessage("[VP] ShmCanvas_Create failed after resize\n")
            ReturnValue(0)
        }

        // Re-attach to display server
        ShmCanvas_Attach(sock, wid, new_w, new_h)

        // Clear to black
        ShmCanvas_Clear(4278190080)
        ShmCanvas_Present(sock, wid)

        // Restart ffmpeg if was playing
        IfCondition EqualTo(was_playing, 1) ThenBlock: {
            fpath = VPState.file_path
            IfCondition NotEqual(fpath, 0) ThenBlock: {
                VP_LaunchFFmpeg(fpath)
                PrintMessage("[VP] Restarted ffmpeg at new resolution\n")
            }
        }
    }
}

// =============================================================================
// POLL IPC MESSAGES — non-blocking check for actions/keys/close
// =============================================================================
Function.VP_PollMessages {
    Input: sock: Integer
    Body: {
        msg = Socket.RecvMsg(sock)
        IfCondition EqualTo(msg, 0) ThenBlock: { ReturnValue(0) }

        pmsg = ParseJSON(msg)
        IfCondition NotEqual(pmsg, 0) ThenBlock: {
            mobj = JSON.AsObject(pmsg)
            method = JSON.GetString(mobj, "method")
            IfCondition NotEqual(method, 0) ThenBlock: {

                cmp = StringCompare(method, "window.closed")
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    PrintMessage("[VP] Window closed\n")
                    VP_StopFFmpeg()
                    VPState.running = 0
                }

                cmp = StringCompare(method, "input.action")
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    action = JSON.GetString(mobj, "action")
                    IfCondition NotEqual(action, 0) ThenBlock: {
                        VP_HandleAction(sock, action)
                    }
                }

                cmp = StringCompare(method, "input.key")
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    kc = JSON.GetNumber(mobj, "keycode")
                    VP_HandleKey(sock, kc)
                }

                cmp = StringCompare(method, "window.resized")
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    rw = JSON.GetNumber(mobj, "width")
                    rh = JSON.GetNumber(mobj, "height")
                    VP_HandleResize(sock, rw, rh)
                }
            }
            JSON.Free(pmsg)
        }
    }
}

// =============================================================================
// ACTION HANDLER
// =============================================================================
Function.VP_HandleAction {
    Input: sock: Integer
    Input: action: Address
    Body: {
        // v.play — start or resume
        cmp = StringCompare(action, "v.play")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            IfCondition EqualTo(VPState.paused, 1) ThenBlock: {
                // Resume
                SystemCall(VPSys.SYS_KILL, VPState.ffmpeg_pid, VPSignal.SIGCONT, 0, 0, 0)
                VPState.paused = 0
                VP_SetLabel(sock, "status", "Playing")
                PrintMessage("[VP] Resumed\n")
            } ElseBlock: {
                IfCondition EqualTo(VPState.playing, 0) ThenBlock: {
                    // Start fresh
                    fpath = VPState.file_path
                    IfCondition EqualTo(fpath, 0) ThenBlock: {
                        VP_SetLabel(sock, "status", "No file loaded")
                        ReturnValue(0)
                    }
                    r = VP_LaunchFFmpeg(fpath)
                    IfCondition LessThan(r, 0) ThenBlock: {
                        VP_SetLabel(sock, "status", "Launch failed")
                        ReturnValue(0)
                    }
                    VP_SetLabel(sock, "status", "Playing")
                    PrintMessage("[VP] Playing: ")
                    PrintString(fpath)
                    PrintMessage("\n")
                }
            }
            ReturnValue(1)
        }

        // v.paus — pause
        cmp = StringCompare(action, "v.paus")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            IfCondition And(EqualTo(VPState.playing, 1), EqualTo(VPState.paused, 0)) ThenBlock: {
                SystemCall(VPSys.SYS_KILL, VPState.ffmpeg_pid, VPSignal.SIGSTOP, 0, 0, 0)
                VPState.paused = 1
                VP_SetLabel(sock, "status", "Paused")
                PrintMessage("[VP] Paused\n")
            }
            ReturnValue(1)
        }

        // v.stop — stop playback
        cmp = StringCompare(action, "v.stop")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            VP_StopFFmpeg()
            // Clear canvas to black
            ShmCanvas_Clear(4278190080)
            ShmCanvas_Present(sock, VPState.win_id)
            VP_SetLabel(sock, "status", "Stopped")
            VP_SetLabel(sock, "pos", "00:00")
            PrintMessage("[VP] Stopped\n")
            ReturnValue(1)
        }

        // doc.open — File > Open from toolbar menu
        cmp = StringCompare(action, "doc.open")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            // Stop current playback if any
            IfCondition EqualTo(VPState.playing, 1) ThenBlock: {
                VP_StopFFmpeg()
            }
            VPState.file_path = VPFiles.default
            PrintMessage("[VP] File > Open: ")
            IfCondition NotEqual(VPState.file_path, 0) ThenBlock: {
                PrintString(VPState.file_path)
            }
            PrintMessage("\n")
            // Auto-play after load
            VP_HandleAction(sock, "v.play")
            ReturnValue(1)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// KEY HANDLER — keyboard shortcuts
// =============================================================================
Function.VP_HandleKey {
    Input: sock: Integer
    Input: keycode: Integer
    Body: {
        // Space (scancode 57) — toggle play/pause
        IfCondition EqualTo(keycode, 57) ThenBlock: {
            IfCondition EqualTo(VPState.paused, 1) ThenBlock: {
                VP_HandleAction(sock, "v.play")
            } ElseBlock: {
                IfCondition EqualTo(VPState.playing, 1) ThenBlock: {
                    VP_HandleAction(sock, "v.paus")
                } ElseBlock: {
                    VP_HandleAction(sock, "v.play")
                }
            }
            ReturnValue(1)
        }

        // S key (scancode 31) — stop
        IfCondition EqualTo(keycode, 31) ThenBlock: {
            VP_HandleAction(sock, "v.stop")
            ReturnValue(1)
        }

        // Up arrow (scancode 103) — master volume up (step=64, range 0-1024)
        IfCondition EqualTo(keycode, 103) ThenBlock: {
            newvol = Add(MixerState.master_vol, 64)
            Mixer_SetMasterVol(newvol)
            PrintMessage("[VP] Master vol=")
            PrintNumber(MixerState.master_vol)
            PrintMessage("/1024\n")
            ReturnValue(1)
        }

        // Down arrow (scancode 108) — master volume down (step=64, range 0-1024)
        IfCondition EqualTo(keycode, 108) ThenBlock: {
            newvol = Subtract(MixerState.master_vol, 64)
            Mixer_SetMasterVol(newvol)
            PrintMessage("[VP] Master vol=")
            PrintNumber(MixerState.master_vol)
            PrintMessage("/1024\n")
            ReturnValue(1)
        }

        // M key (scancode 50) — mute/unmute toggle
        IfCondition EqualTo(keycode, 50) ThenBlock: {
            IfCondition EqualTo(MixerState.master_vol, 0) ThenBlock: {
                Mixer_SetMasterVol(256)
                PrintMessage("[VP] Unmuted (256/1024)\n")
            } ElseBlock: {
                Mixer_SetMasterVol(0)
                PrintMessage("[VP] Muted\n")
            }
            ReturnValue(1)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  Video Player — ffmpeg + Shared Memory Canvas\n")
    PrintMessage("============================================\n\n")

    // Default demo file — user should place a video at this path
    VPFiles.default = "/home/bob/test_video.mp4"
    VPState.file_path = VPFiles.default

    // Connect to display server
    sock_path = "/tmp/ailang_display.sock"
    sock = Socket.Create(1, 1)
    IfCondition LessThan(sock, 0) ThenBlock: {
        PrintMessage("[VP] Socket create failed\n")
        HaltProgram
    }

    cres = Socket.ConnectUnix(sock, sock_path)
    IfCondition LessThan(cres, 0) ThenBlock: {
        PrintMessage("[VP] Connect failed — is display server running?\n")
        Socket.Close(sock)
        HaltProgram
    }
    PrintMessage("[VP] Connected to display server\n")
    VPState.sock = sock

    // Register
    Socket.SendMsg(sock, "{\"method\":\"register\",\"service\":\"videoplayer\"}")
    PrintMessage("[VP] Sent register\n")

    // Create window (640x480 matches canvas dimensions)
    Socket.SendMsg(sock, "{\"method\":\"window.create\",\"title\":\"Video Player\",\"w\":640,\"h\":480,\"html\":\"config/videoplayer.html\"}")
    PrintMessage("[VP] Sent window.create\n")

    // Wait for window.created
    resp = Socket.RecvMsg(sock)
    IfCondition EqualTo(resp, 0) ThenBlock: {
        PrintMessage("[VP] No response\n")
        Socket.Close(sock)
        HaltProgram
    }

    parsed = ParseJSON(resp)
    IfCondition NotEqual(parsed, 0) ThenBlock: {
        pobj = JSON.AsObject(parsed)
        wid = JSON.GetNumber(pobj, "win_id")
        VPState.win_id = wid
        PrintMessage("[VP] Window created, win_id=")
        PrintNumber(wid)
        PrintMessage("\n")
        JSON.Free(parsed)
    }

    // Create shared memory canvas
    cw = VPState.canvas_w
    ch = VPState.canvas_h
    wid = VPState.win_id
    buf = ShmCanvas_Create(wid, cw, ch)
    IfCondition EqualTo(buf, 0) ThenBlock: {
        PrintMessage("[VP] ShmCanvas_Create failed\n")
        Socket.Close(sock)
        HaltProgram
    }

    // Attach canvas to window
    ShmCanvas_Attach(sock, wid, cw, ch)
    PrintMessage("[VP] Canvas attached\n")

    // Clear to black initially
    ShmCanvas_Clear(4278190080)
    ShmCanvas_Present(sock, wid)

    // Initialize audio engine
    ar = Audio_Init()
    IfCondition GreaterEqual(ar, 0) ThenBlock: {
        VPState.audio_ok = 1
        PrintMessage("[VP] Audio engine ready\n")
    } ElseBlock: {
        VPState.audio_ok = 0
        PrintMessage("[VP] Audio unavailable — video only\n")
    }

    // Allocate audio read buffer (16384 bytes = multiple periods)
    VPState.audio_buf = Allocate(16384)

    // Set socket non-blocking for frame loop
    Socket.SetNonBlock(sock)

    // Allocate timespec for tick sleep: 2ms
    // This is the heartbeat — both audio and video are serviced every tick.
    ts_tick = Allocate(16)
    StoreValue(ts_tick, 0)
    StoreValue(Add(ts_tick, 8), 2000000)

    // Allocate timespec for idle sleep: 50ms
    ts_idle = Allocate(16)
    StoreValue(ts_idle, 0)
    StoreValue(Add(ts_idle, 8), 50000000)

    PrintMessage("[VP] Keys: Space=play/pause S=stop M=mute Up/Down=volume\n")

    // Auto-play default file on startup
    IfCondition NotEqual(VPState.file_path, 0) ThenBlock: {
        PrintMessage("[VP] Auto-playing: ")
        PrintString(VPState.file_path)
        PrintMessage("\n")
        VP_LaunchFFmpeg(VPState.file_path)
    }

    PrintMessage("[VP] Entering main loop\n\n")

    // ===== MAIN LOOP — AUDIO-DRIVEN FRAME SYNC =====
    //
    // Audio is the master clock. The ALSA sound card's crystal oscillator
    // runs at exactly 48kHz — it's the most accurate clock in the system.
    //
    // Strategy:
    //   1. AUDIO FIRST: drain pipe → ring buffer → mixer → ALSA. Every tick.
    //      Mixer_DrainTick increments samples_written — this IS the clock.
    //   2. VIDEO FOLLOWS: accumulate frames from pipe, but only PRESENT when
    //      the audio clock says it's time:
    //        expected_frame = (samples_written * fps) / sample_rate
    //      If video is behind: drop frames to catch up.
    //      If video is ahead: hold current frame until audio catches up.
    //   3. This ensures audio never glitches (highest priority) and video
    //      tracks audio position exactly. Dropped frames are invisible;
    //      audio pops are not.
    //
    // Tick rate: 2ms. -re paces ffmpeg at native rate, audio clock paces us.
    //
    WhileLoop EqualTo(VPState.running, 1) {

        IfCondition And(EqualTo(VPState.playing, 1), EqualTo(VPState.paused, 0)) ThenBlock: {
            // ===== PLAYING =====

            // STEP 1: Audio — drain pipe into ring buffer, push to ALSA.
            // This is the MASTER CLOCK. It must run first, every tick.
            VP_DrainAudio()

            // STEP 2: Video — accumulate partial reads from pipe.
            // Keep reading frames even if we won't present yet.
            IfCondition EqualTo(VPState.vid_ready, 0) ThenBlock: {
                vr = VP_ReadVideoTick()
                IfCondition EqualTo(vr, 1) ThenBlock: {
                    // Full frame accumulated in canvas buffer — mark ready
                    VPState.vid_ready = 1
                }
                IfCondition EqualTo(vr, -1) ThenBlock: {
                    // EOF or error — playback finished
                    VP_StopFFmpeg()
                    VP_SetLabel(sock, "status", "Finished")
                    PrintMessage("[VP] Playback finished: ")
                    PrintNumber(VPState.frames_presented)
                    PrintMessage(" presented, ")
                    PrintNumber(VPState.frames_dropped)
                    PrintMessage(" dropped\n")
                }
            }

            // STEP 3: Audio-driven presentation decision.
            // Ask the audio clock what frame we SHOULD be showing.
            IfCondition EqualTo(VPState.vid_ready, 1) ThenBlock: {
                audio_pos = Mixer_GetSamplesWritten()
                // expected_frame = (audio_pos * fps) / sample_rate
                // = (audio_pos * 30) / 48000
                // Simplify: (audio_pos * 30) / 48000 = audio_pos / 1600
                expected_frame = Divide(audio_pos, 1600)

                presented = VPState.frames_presented

                IfCondition GreaterEqual(expected_frame, presented) ThenBlock: {
                    // Audio clock says it's time (or past time) — present
                    ShmCanvas_Present(sock, wid)
                    VPState.frames_presented = Add(presented, 1)
                    VPState.vid_ready = 0

                    // If we're behind by more than 1 frame, drop-read to catch up
                    IfCondition GreaterThan(expected_frame, Add(presented, 2)) ThenBlock: {
                        // Drop frames: read and discard until we catch up
                        drop_target = Subtract(expected_frame, Add(presented, 1))
                        dropped = 0
                        WhileLoop LessThan(dropped, drop_target) {
                            dr = VP_ReadVideoTick()
                            IfCondition EqualTo(dr, 1) ThenBlock: {
                                dropped = Add(dropped, 1)
                            } ElseBlock: {
                                // No more frames available or EOF — stop dropping
                                dropped = drop_target
                            }
                        }
                        VPState.frames_dropped = Add(VPState.frames_dropped, dropped)
                    }

                    // Update position display every 30 presented frames
                    fp = VPState.frames_presented
                    IfCondition EqualTo(Modulo(fp, 30), 0) ThenBlock: {
                        // Use audio clock for time display (more accurate)
                        secs = Divide(audio_pos, 48000)
                        tbuf = Allocate(8)
                        VP_FormatTime(secs, tbuf)
                        VP_SetLabel(sock, "pos", tbuf)
                        Deallocate(tbuf, 8)
                    }

                    // Log every 300 presented frames
                    IfCondition EqualTo(Modulo(fp, 300), 0) ThenBlock: {
                        PrintMessage("[VP] presented=")
                        PrintNumber(fp)
                        PrintMessage(" dropped=")
                        PrintNumber(VPState.frames_dropped)
                        PrintMessage(" audio_pos=")
                        PrintNumber(audio_pos)
                        PrintMessage("\n")
                    }
                }
                // else: video ahead of audio — hold frame, wait for audio
            }

            // Steady tick — 2ms heartbeat
            SystemCall(VPSys.SYS_NANOSLEEP, ts_tick, 0)

        } ElseBlock: {
            // ===== IDLE or PAUSED =====
            // Still drain audio during pause so ALSA buffer doesn't underrun
            IfCondition EqualTo(VPState.audio_ok, 1) ThenBlock: {
                Mixer_DrainTick()
            }
            SystemCall(VPSys.SYS_NANOSLEEP, ts_idle, 0)
        }

        // Poll for IPC messages (actions, keys, close)
        VP_PollMessages(sock)
    }

    // Cleanup
    VP_StopFFmpeg()
    ShmCanvas_Destroy(wid)
    IfCondition EqualTo(VPState.audio_ok, 1) ThenBlock: {
        Audio_Shutdown()
    }
    Deallocate(VPState.audio_buf, 16384)
    Deallocate(ts_tick, 16)
    Deallocate(ts_idle, 16)
    Socket.Close(sock)

    PrintMessage("\n============================================\n")
    PrintMessage("  Video Player finished after ")
    PrintNumber(VPState.frame_num)
    PrintMessage(" frames\n")
    PrintMessage("============================================\n")
}

RunTask(Main)
