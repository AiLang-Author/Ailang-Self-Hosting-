// =============================================================================
// ZERO GRADS
// =============================================================================
SubRoutine.ATTN_ZeroGrads {
    zgd_dmod  = TFConfig.DModel
    zgd_seqln = TFConfig.SeqLen
    zgd_vocab = TFConfig.VocabSize
    zgd_dff   = TFConfig.DFF

    TF_MatZero(TFW.dW1,      zgd_dmod,  zgd_dff)
    TF_MatZero(TFW.dW2,      zgd_dff,   zgd_dmod)
    TF_MatZero(TFW.dMlp_out, zgd_seqln, zgd_dmod)
    TF_MatZero(TFW.dResid2,  zgd_seqln, zgd_dmod)
    TF_MatZero(TFW.dEmbed,  zgd_vocab, zgd_dmod)
    TF_MatZero(TFW.dPosEmb, zgd_seqln, zgd_dmod)
    TF_MatZero(TFW.dWq,     zgd_dmod,  zgd_dmod)
    TF_MatZero(TFW.dWk,     zgd_dmod,  zgd_dmod)
    TF_MatZero(TFW.dWv,     zgd_dmod,  zgd_dmod)
    TF_MatZero(TFW.dWout,   zgd_vocab, zgd_dmod)
    TF_MatZero(TFW.dWr,     zgd_dmod,  zgd_dmod)
    TF_MatZero(TFW.dLogits, zgd_seqln, zgd_vocab)
    TF_MatZero(TFW.dResid,  zgd_seqln, zgd_dmod)
    TF_MatZero(TFW.dCtx,    zgd_seqln, zgd_dmod)
    TF_MatZero(TFW.dEmb,    zgd_seqln, zgd_dmod)
    TF_MatZero(TFW.dQ,      zgd_seqln, zgd_dmod)
    TF_MatZero(TFW.dK,      zgd_seqln, zgd_dmod)
    TF_MatZero(TFW.dV,      zgd_seqln, zgd_dmod)
    zgd_hsl = Multiply(TFConfig.NumHeads, zgd_seqln)
    TF_MatZero(TFW.dScores, zgd_hsl, zgd_seqln)
}

// =============================================================================
// BACKWARD — populates carriers then calls library functions
// =============================================================================
SubRoutine.ATTN_Backward {
    bwd_dmod  = TFConfig.DModel
    bwd_seqln = TFConfig.SeqLen
    bwd_vocab = TFConfig.VocabSize
    bwd_headdim = Divide(bwd_dmod, TFConfig.NumHeads)
    bwd_scale = TF_ISqrt(bwd_headdim)
    bwd_dff   = TFConfig.DFF
    bwd_tgt   = TFState.targets
    bwd_tok   = TFState.tokens

    TFBackOut.Wout    = TFW.Wout
    TFBackOut.targets = bwd_tgt
    TFBackOut.seqln   = bwd_seqln
    TFBackOut.dmod    = bwd_dmod
    TFBackOut.vocab   = bwd_vocab
    TFTrain_BackOutProj(TFW.dWout, TFW.dResid2, TFW.dLogits, TFW.probs, TFW.resid2)
    pos = 0
    WhileLoop LessThan(pos, bwd_seqln) {
        col = 0
        WhileLoop LessThan(col, bwd_dmod) {
            v = TF_MatGet(TFW.dResid2, pos, col, bwd_dmod)
            TF_MatSet(TFW.dMlp_out, pos, col, bwd_dmod, v)
            TF_MatSet(TFW.dResid, pos, col, bwd_dmod, v)
            col = Add(col, 1)
        }
        pos = Add(pos, 1)
    }

    TFBackMLP.W1     = TFW.W1
    TFBackMLP.W2     = TFW.W2
    TFBackMLP.x      = TFW.resid
    TFBackMLP.hidden = TFW.mlp_hidden
    TFBackMLP.seqln  = bwd_seqln
    TFBackMLP.dmod   = bwd_dmod
    TFBackMLP.dff    = bwd_dff
    TFTrain_BackMLP(TFW.dW1, TFW.dW2, TFW.dResid, TFW.dMlp_out)

    // =================================================================
    // RULE CACHE BACKWARD
    // =================================================================
    bwd_wpos = TFState.RuleWritePos

    // Step 1: Accumulate d_rule_vec = sum of dResid[pos] for pos > write_pos
    bwd_drv = TF_VecAlloc(bwd_dmod)
    bwd_rc_col = 0
    WhileLoop LessThan(bwd_rc_col, bwd_dmod) {
        TF_VecSet(bwd_drv, bwd_rc_col, 0)
        bwd_rc_col = Add(bwd_rc_col, 1)
    }

    bwd_rc_pos = Add(bwd_wpos, 1)
    bwd_rc_count = 0
    WhileLoop LessThan(bwd_rc_pos, bwd_seqln) {
        bwd_rc_col = 0
        WhileLoop LessThan(bwd_rc_col, bwd_dmod) {
            bwd_rc_old = TF_VecGet(bwd_drv, bwd_rc_col)
            bwd_rc_dval = TF_MatGet(TFW.dResid, bwd_rc_pos, bwd_rc_col, bwd_dmod)
            TF_VecSet(bwd_drv, bwd_rc_col, Add(bwd_rc_old, bwd_rc_dval))
            bwd_rc_col = Add(bwd_rc_col, 1)
        }
        bwd_rc_pos = Add(bwd_rc_pos, 1)
        bwd_rc_count = Add(bwd_rc_count, 1)
    }

    // Stabilize gradient: average the broadcasted gradient to prevent explosion
    IfCondition GreaterThan(bwd_rc_count, 0) ThenBlock: {
        bwd_rc_col = 0
        WhileLoop LessThan(bwd_rc_col, bwd_dmod) {
            bwd_rc_val = TF_VecGet(bwd_drv, bwd_rc_col)
            bwd_rc_val = Divide(bwd_rc_val, bwd_rc_count)
            TF_VecSet(bwd_drv, bwd_rc_col, bwd_rc_val)
            bwd_rc_col = Add(bwd_rc_col, 1)
        }
    }

    // Step 2: dWr += outer(d_rule_vec, resid[write_pos])
    bwd_rc_src = TF_VecAlloc(bwd_dmod)
    bwd_rc_col = 0
    WhileLoop LessThan(bwd_rc_col, bwd_dmod) {
        TF_VecSet(bwd_rc_src, bwd_rc_col, TF_MatGet(TFW.resid, bwd_wpos, bwd_rc_col, bwd_dmod))
        bwd_rc_col = Add(bwd_rc_col, 1)
    }
    TF_FOuterAccum(TFW.dWr, bwd_drv, bwd_rc_src, bwd_dmod, bwd_dmod)

    // Step 3: d_resid[write_pos] += Wr^T · d_rule_vec
    bwd_rc_dx = TF_VecAlloc(bwd_dmod)
    TF_MatTVecMul(bwd_rc_dx, TFW.Wr, bwd_drv, bwd_dmod, bwd_dmod)
    bwd_rc_col = 0
    WhileLoop LessThan(bwd_rc_col, bwd_dmod) {
        bwd_rc_old = TF_MatGet(TFW.dResid, bwd_wpos, bwd_rc_col, bwd_dmod)
        bwd_rc_new = Add(bwd_rc_old, TF_VecGet(bwd_rc_dx, bwd_rc_col))
        TF_MatSet(TFW.dResid, bwd_wpos, bwd_rc_col, bwd_dmod, bwd_rc_new)
        bwd_rc_col = Add(bwd_rc_col, 1)
    }

    TF_VecFree(bwd_drv, bwd_dmod)
    TF_VecFree(bwd_rc_src, bwd_dmod)
    TF_VecFree(bwd_rc_dx, bwd_dmod)

    TFBackCtx.attn  = TFW.attn
    TFBackCtx.vvec  = TFW.vvec
    TFBackCtx.seqln = bwd_seqln
    TFBackCtx.dmod  = bwd_dmod
    TFBackCtx.scale = bwd_scale
    TFBackCtx.numheads = TFConfig.NumHeads
    TFTrain_BackAttnCtx(TFW.dCtx, TFW.dEmb, TFW.dV, TFW.dScores, TFW.dResid)

    TFBackQK.seqln = bwd_seqln
    TFBackQK.dmod  = bwd_dmod
    TFBackQK.numheads = TFConfig.NumHeads
    TFTrain_BackQK(TFW.dQ, TFW.dK, TFW.dScores, TFW.qvec, TFW.kvec)

    TFBackWA.Wq    = TFW.Wq
    TFBackWA.Wk    = TFW.Wk
    TFBackWA.Wv    = TFW.Wv
    TFBackWA.emb   = TFW.emb
    TFBackWA.seqln = bwd_seqln
    TFBackWA.dmod  = bwd_dmod
    TFBackWA.dK    = TFW.dK
    TFBackWA.dV    = TFW.dV
    TFTrain_BackWeightsA(TFW.dWq, TFW.dWk, TFW.dWv, TFW.dEmb, TFW.dQ)

    TFBackWB.tokens = bwd_tok
    TFBackWB.seqln  = bwd_seqln
    TFBackWB.dmod   = bwd_dmod
    TFTrain_BackWeightsB(TFW.dEmbed, TFW.dPosEmb, TFW.dEmb)

    Debug("bwd", level=2) { PrintMessage("[DBG] bwd done\n") }
}