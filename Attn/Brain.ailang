// =============================================================================
// REGISTRY
// =============================================================================

SubRoutine.Registry_Init {
    SkillRegistry.signatures = Allocate(Multiply(32, Multiply(32, 8)))
    SkillRegistry.paths = Allocate(Multiply(32, 8))
    SkillRegistry.count = 0
}

Function.Registry_AddSkill {
    Input: path: Address
    Input: signature: Integer
    Output: Integer
    Body: {
        idx = SkillRegistry.count
        IfCondition GreaterEqual(idx, SkillRegistry.max_skills) ThenBlock: {
            PrintMessage("[REGISTRY] Full — cannot add more skills\n")
            ReturnValue(0)
        }
        idx_off = Multiply(idx, 8)
        path_ptr = Add(SkillRegistry.paths, idx_off)
        StoreValue(path_ptr, path)
        idx_off2 = Multiply(idx, 256)
        sig_base = Add(SkillRegistry.signatures, idx_off2)
        sig_i = 0
        WhileLoop LessThan(sig_i, 32) {
            sig_off = Multiply(sig_i, 8)
            sig_ptr = Add(sig_base, sig_off)
            sig_val = TF_VecGet(signature, sig_i)
            StoreValue(sig_ptr, sig_val)
            sig_i = Add(sig_i, 1)
        }
        SkillRegistry.count = Add(idx, 1)
        PrintMessage("[REGISTRY] Added skill ")
        PrintNumber(idx)
        PrintMessage(": ")
        PrintString(path)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.Registry_Match {
    Input: input_sig: Integer
    Output: Integer
    Body: {
        best_idx = -1
        best_dist = 999999999
        
        idx = 0
        WhileLoop LessThan(idx, SkillRegistry.count) {
            idx_off2 = Multiply(idx, 256)
            sig_base = Add(SkillRegistry.signatures, idx_off2)
            dist = 0
            sig_i = 0
            WhileLoop LessThan(sig_i, 32) {
                sig_off = Multiply(sig_i, 8)
                sig_ptr = Add(sig_base, sig_off)
                stored_val = Dereference(sig_ptr)
                input_val = TF_VecGet(input_sig, sig_i)
                diff = Subtract(stored_val, input_val)
                IfCondition LessThan(diff, 0) ThenBlock: { diff = Subtract(0, diff) }
                dist = Add(dist, diff)
                sig_i = Add(sig_i, 1)
            }
            
            IfCondition LessThan(dist, best_dist) ThenBlock: {
                best_dist = dist
                best_idx = idx
            }
            idx = Add(idx, 1)
        }
        
        IfCondition GreaterThan(best_dist, 1000) ThenBlock: {
            PrintMessage("[REGISTRY] No match (dist=")
            PrintNumber(best_dist)
            PrintMessage(")\n")
            ReturnValue(-1)
        }
        
        PrintMessage("[REGISTRY] Matched skill ")
        PrintNumber(best_idx)
        PrintMessage(" (dist=")
        PrintNumber(best_dist)
        PrintMessage(")\n")
        ReturnValue(best_idx)
    }
}

// =============================================================================
// SPECIALIST LOADER
// =============================================================================

Function.Specialist_LoadWeights {
    Input: path: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[SPECIALIST] Cannot open: ")
            PrintString(path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        
        tmp_sig = TF_VecAlloc(32)
        ok = TF_ReadSkillHeader(fd, tmp_sig)
        TF_VecFree(tmp_sig, 32)
        
        IfCondition EqualTo(ok, 0) ThenBlock: {
            SystemCall(3, fd)
            ReturnValue(0)
        }
        
        IfCondition NotEqual(SkillInfo.DModel, TFConfig.DModel) ThenBlock: {
            PrintMessage("[SPECIALIST] DModel mismatch\n")
            SystemCall(3, fd)
            ReturnValue(0)
        }
        
        // Load order MUST match Train.ailang save order:
        // Embed, PosEmb, Wq, Wk, Wv, W1, W2, Wout, [Wr]
        sz_emb = Multiply(SkillInfo.VocabSize, SkillInfo.DModel)
        TF_ReadBuffer(fd, TFWf.Embed,  sz_emb)
        sz_pos = Multiply(SkillInfo.SeqLen, SkillInfo.DModel)
        TF_ReadBuffer(fd, TFWf.PosEmb, sz_pos)
        sz_wqkv = Multiply(SkillInfo.DModel, SkillInfo.DModel)
        TF_ReadBuffer(fd, TFWf.Wq,     sz_wqkv)
        TF_ReadBuffer(fd, TFWf.Wk,     sz_wqkv)
        TF_ReadBuffer(fd, TFWf.Wv,     sz_wqkv)
        sz_w1 = Multiply(SkillInfo.DModel, SkillInfo.DFF)
        TF_ReadBuffer(fd, TFWf.W1,     sz_w1)
        sz_w2 = Multiply(SkillInfo.DFF, SkillInfo.DModel)
        TF_ReadBuffer(fd, TFWf.W2,     sz_w2)
        sz_wout = Multiply(SkillInfo.VocabSize, SkillInfo.DModel)
        TF_ReadBuffer(fd, TFWf.Wout,   sz_wout)
        
        IfCondition EqualTo(SkillInfo.HasRC, 1) ThenBlock: {
            sz_wr = Multiply(SkillInfo.DModel, SkillInfo.DModel)
            TF_ReadBuffer(fd, TFWf.Wr, sz_wr)
        }
        
        SystemCall(3, fd)
        
        PrintMessage("[SPECIALIST] Loaded: ")
        PrintString(path)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// BRAIN HELPERS
// =============================================================================

Function.Brain_TryRegister {
    Input: path: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[BRAIN] Skill not found: ")
            PrintString(path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        tmp_sig = TF_VecAlloc(32)
        ok = TF_ReadSkillHeader(fd, tmp_sig)
        SystemCall(3, fd)
        IfCondition EqualTo(ok, 1) ThenBlock: {
            Registry_AddSkill(path, tmp_sig)
        }
        TF_VecFree(tmp_sig, 32)
        ReturnValue(ok)
    }
}

// =============================================================================
// TEST INPUT GENERATION
// Matches GenSample pattern indices exactly:
//  0 = count by 1    prompt: S S+1 S+2 S+3
//  1 = count by 2    prompt: S S+2 S+4 S+6
//  2 = repeat-3      prompt: S S+1 S+2 S
//  3 = count by 3    prompt: S S+3 S+6 S+9
//  4 = count by 5    prompt: S S+5 S+10 S+15
//  5 = countdown     prompt: S S-1 S-2 S-3
//  6 = count by 7    prompt: S S+7 S+14 S+21
//  7 = count by 4    prompt: S S+4 S+8 S+12
//  8 = repeat-2      prompt: S S+1 S S+1
//  9 = repeat-4      prompt: S S+1 S+2 S+3
// 10 = addition      prompt: A + B =
// =============================================================================
Function.Brain_GenerateTestInput {
    Input: test_type: Integer
    Body: {
        bgi_start = TF_RandMod(10)

        // Count by 1
        IfCondition EqualTo(test_type, 0) ThenBlock: {
            bgi_pp = 0
            WhileLoop LessThan(bgi_pp, 4) {
                bgi_tok = Modulo(Add(bgi_start, bgi_pp), 10)
                TF_VecSet(TFState.tokens, bgi_pp, bgi_tok)
                bgi_pp = Add(bgi_pp, 1)
            }
        }

        // Count by 2
        IfCondition EqualTo(test_type, 1) ThenBlock: {
            bgi_pp = 0
            WhileLoop LessThan(bgi_pp, 4) {
                bgi_tok = Modulo(Add(bgi_start, Multiply(bgi_pp, 2)), 10)
                TF_VecSet(TFState.tokens, bgi_pp, bgi_tok)
                bgi_pp = Add(bgi_pp, 1)
            }
        }

        // Repeat-3
        IfCondition EqualTo(test_type, 2) ThenBlock: {
            bgi_pp = 0
            WhileLoop LessThan(bgi_pp, 4) {
                bgi_phase = Modulo(bgi_pp, 3)
                bgi_tok = Modulo(Add(bgi_start, bgi_phase), 10)
                TF_VecSet(TFState.tokens, bgi_pp, bgi_tok)
                bgi_pp = Add(bgi_pp, 1)
            }
        }

        // Count by 3
        IfCondition EqualTo(test_type, 3) ThenBlock: {
            bgi_pp = 0
            WhileLoop LessThan(bgi_pp, 4) {
                bgi_tok = Modulo(Add(bgi_start, Multiply(bgi_pp, 3)), 10)
                TF_VecSet(TFState.tokens, bgi_pp, bgi_tok)
                bgi_pp = Add(bgi_pp, 1)
            }
        }

        // Count by 5
        IfCondition EqualTo(test_type, 4) ThenBlock: {
            bgi_pp = 0
            WhileLoop LessThan(bgi_pp, 4) {
                bgi_tok = Modulo(Add(bgi_start, Multiply(bgi_pp, 5)), 10)
                TF_VecSet(TFState.tokens, bgi_pp, bgi_tok)
                bgi_pp = Add(bgi_pp, 1)
            }
        }

        // Countdown
        IfCondition EqualTo(test_type, 5) ThenBlock: {
            bgi_pp = 0
            WhileLoop LessThan(bgi_pp, 4) {
                bgi_tok = Modulo(Subtract(Add(bgi_start, 100), bgi_pp), 10)
                TF_VecSet(TFState.tokens, bgi_pp, bgi_tok)
                bgi_pp = Add(bgi_pp, 1)
            }
        }

        // Count by 7
        IfCondition EqualTo(test_type, 6) ThenBlock: {
            bgi_pp = 0
            WhileLoop LessThan(bgi_pp, 4) {
                bgi_tok = Modulo(Add(bgi_start, Multiply(bgi_pp, 7)), 10)
                TF_VecSet(TFState.tokens, bgi_pp, bgi_tok)
                bgi_pp = Add(bgi_pp, 1)
            }
        }

        // Count by 4
        IfCondition EqualTo(test_type, 7) ThenBlock: {
            bgi_pp = 0
            WhileLoop LessThan(bgi_pp, 4) {
                bgi_tok = Modulo(Add(bgi_start, Multiply(bgi_pp, 4)), 10)
                TF_VecSet(TFState.tokens, bgi_pp, bgi_tok)
                bgi_pp = Add(bgi_pp, 1)
            }
        }

        // Repeat-2
        IfCondition EqualTo(test_type, 8) ThenBlock: {
            bgi_pp = 0
            WhileLoop LessThan(bgi_pp, 4) {
                bgi_phase = Modulo(bgi_pp, 2)
                bgi_tok = Modulo(Add(bgi_start, bgi_phase), 10)
                TF_VecSet(TFState.tokens, bgi_pp, bgi_tok)
                bgi_pp = Add(bgi_pp, 1)
            }
        }

        // Repeat-4
        IfCondition EqualTo(test_type, 9) ThenBlock: {
            bgi_pp = 0
            WhileLoop LessThan(bgi_pp, 4) {
                bgi_phase = Modulo(bgi_pp, 4)
                bgi_tok = Modulo(Add(bgi_start, bgi_phase), 10)
                TF_VecSet(TFState.tokens, bgi_pp, bgi_tok)
                bgi_pp = Add(bgi_pp, 1)
            }
        }

        // Addition
        IfCondition EqualTo(test_type, 10) ThenBlock: {
            bgi_a = TF_RandMod(10)
            bgi_b = TF_RandMod(10)
            TF_VecSet(TFState.tokens, 0, bgi_a)
            TF_VecSet(TFState.tokens, 1, 10)
            TF_VecSet(TFState.tokens, 2, bgi_b)
            TF_VecSet(TFState.tokens, 3, 13)
        }

        // Zero-pad positions 4+
        bgi_pp = 4
        WhileLoop LessThan(bgi_pp, TFConfig.SeqLen) {
            TF_VecSet(TFState.tokens, bgi_pp, 0)
            bgi_pp = Add(bgi_pp, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// BRAIN RUN
// =============================================================================
SubRoutine.Brain_Run {
    Registry_Init()

    // Register all skills by index — matches GetSkillPath/GenSample
    br_skill_idx = 0
    WhileLoop NotEqual(GetTrainSequence(br_skill_idx), -1) {
        br_skill_id = GetTrainSequence(br_skill_idx)
        br_skill_path = GetSkillPath(br_skill_id)
        Brain_TryRegister(br_skill_path)
        br_skill_idx = Add(br_skill_idx, 1)
    }

    PrintMessage("\n[BRAIN] ")
    PrintNumber(SkillRegistry.count)
    PrintMessage(" skills loaded\n")

    brain_test = 0
    WhileLoop LessThan(brain_test, 10) {
        test_type = TF_RandMod(SkillRegistry.count)
        Brain_GenerateTestInput(test_type)
        input_sig = TF_VecAlloc(32)
        sig_i = 0
        WhileLoop LessThan(sig_i, 32) {
            IfCondition LessThan(sig_i, TFConfig.SeqLen) ThenBlock: {
                tok_val = TF_VecGet(TFState.tokens, sig_i)
                TF_VecSet(input_sig, sig_i, tok_val)
            } ElseBlock: {
                TF_VecSet(input_sig, sig_i, 0)
            }
            sig_i = Add(sig_i, 1)
        }
        matched = Registry_Match(input_sig)
        TF_VecFree(input_sig, 32)
        IfCondition GreaterEqual(matched, 0) ThenBlock: {
            match_off = Multiply(matched, 8)
            match_ptr = Add(SkillRegistry.paths, match_off)
            matched_path = Dereference(match_ptr)
            Specialist_LoadWeights(matched_path)
            ATTN_ConvertWeights()
            TFRuleCache.written = 0
            TFState.RuleWritePos = 3
            PrintMessage("INPUT: ")
            br_pp = 0
            WhileLoop LessThan(br_pp, 4) {
                p_tok = TF_VecGet(TFState.tokens, br_pp)
                PrintNumber(p_tok)
                PrintMessage(" ")
                br_pp = Add(br_pp, 1)
            }
            PrintMessage("=> ")
            br_prow = TF_VecAlloc(TFConfig.VocabSize)
            br_gpos = 4
            WhileLoop LessThan(br_gpos, TFConfig.SeqLen) {
                ATTN_Forward()
                br_rpos = Subtract(br_gpos, 1)
                br_col = 0
                WhileLoop LessThan(br_col, TFConfig.VocabSize) {
                    br_val = TF_MatGet(TFW.probs, br_rpos, br_col, TFConfig.VocabSize)
                    TF_VecSet(br_prow, br_col, br_val)
                    br_col = Add(br_col, 1)
                }
                br_best = TF_VecArgMax(br_prow, TFConfig.VocabSize)
                TF_VecSet(TFState.tokens, br_gpos, br_best)
                br_gpos = Add(br_gpos, 1)
            }
            TF_VecFree(br_prow, TFConfig.VocabSize)
            br_pp = 4
            WhileLoop LessThan(br_pp, TFConfig.SeqLen) {
                p_tok = TF_VecGet(TFState.tokens, br_pp)
                PrintNumber(p_tok)
                PrintMessage(" ")
                br_pp = Add(br_pp, 1)
            }
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("[BRAIN] Unknown pattern — would train new skill here\n")
        }
        brain_test = Add(brain_test, 1)
    }
}