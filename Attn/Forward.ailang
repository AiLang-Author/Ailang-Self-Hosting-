// =============================================================================
// CONVERT — float masters → Q8 integer working copies before forward pass
// =============================================================================
SubRoutine.ATTN_ConvertWeights {
    cv_dmod  = TFConfig.DModel
    cv_seqln = TFConfig.SeqLen
    cv_vocab = TFConfig.VocabSize
    cv_dff   = TFConfig.DFF

    cv_sz_w1 = Multiply(cv_dmod, cv_dff)
    TF_FloatToQ8(TFW.W1,     TFWf.W1,     cv_sz_w1)
    cv_sz_w2 = Multiply(cv_dff,  cv_dmod)
    TF_FloatToQ8(TFW.W2,     TFWf.W2,     cv_sz_w2)
    cv_sz_emb = Multiply(cv_vocab, cv_dmod)
    TF_FloatToQ8(TFW.Embed,  TFWf.Embed,  cv_sz_emb)
    cv_sz_pos = Multiply(cv_seqln, cv_dmod)
    TF_FloatToQ8(TFW.PosEmb, TFWf.PosEmb, cv_sz_pos)
    cv_sz_qkv = Multiply(cv_dmod, cv_dmod)
    TF_FloatToQ8(TFW.Wq,     TFWf.Wq,     cv_sz_qkv)
    TF_FloatToQ8(TFW.Wk,     TFWf.Wk,     cv_sz_qkv)
    TF_FloatToQ8(TFW.Wv,     TFWf.Wv,     cv_sz_qkv)
    cv_sz_out = Multiply(cv_vocab, cv_dmod)
    TF_FloatToQ8(TFW.Wout,   TFWf.Wout,   cv_sz_out)
    cv_sz_wr = Multiply(cv_dmod, cv_dmod)
    TF_FloatToQ8(TFW.Wr,     TFWf.Wr,     cv_sz_wr)
}

// =============================================================================
// FORWARD — calls library functions in sequence, all state explicit
// =============================================================================
SubRoutine.ATTN_Forward {
    fwd_dmod  = TFConfig.DModel
    fwd_seqln = TFConfig.SeqLen
    fwd_vocab = TFConfig.VocabSize
    fwd_scale = TF_ISqrt(fwd_dmod)
    fwd_dff   = TFConfig.DFF
    fwd_tok   = TFState.tokens

    TFLayer_Embed(TFW.emb, fwd_tok, TFW.Embed, TFW.PosEmb, fwd_seqln, fwd_dmod)

    TFProjCarrier.Wk    = TFW.Wk
    TFProjCarrier.Wv    = TFW.Wv
    TFProjCarrier.seqln = fwd_seqln
    TFProjCarrier.dmod  = fwd_dmod
    TFLayer_ProjQKV(TFW.qvec, TFW.kvec, TFW.vvec, TFW.emb, TFW.Wq)

    TFLayer_AttnScores(TFW.scores, TFW.qvec, TFW.kvec, fwd_seqln, fwd_dmod, TFConfig.NumHeads)

    // =========================================================================
    // CAUSAL MASK — prevent tokens from attending to future positions
    // Sets scores[h*seqln+row, col] = -1000000 where col > row
    // Softmax will map these to probability 0
    // Backward pass unaffected: grad of 0 probability = 0
    // =========================================================================
    mask_h = 0
    WhileLoop LessThan(mask_h, TFConfig.NumHeads) {
        mask_r = 0
        WhileLoop LessThan(mask_r, fwd_seqln) {
            mask_c = Add(mask_r, 1)
            mask_h_seq = Multiply(mask_h, fwd_seqln)
            WhileLoop LessThan(mask_c, fwd_seqln) {
                mask_row_idx = Add(mask_h_seq, mask_r)
                TF_MatSet(TFW.scores, mask_row_idx, mask_c, fwd_seqln, -1000000)
                mask_c = Add(mask_c, 1)
            }
            mask_r = Add(mask_r, 1)
        }
        mask_h = Add(mask_h, 1)
    }

    TFLayer_AttnSoftmax(TFW.attn, TFW.scores, fwd_seqln, TFConfig.NumHeads)

    TFLayer_Context(TFW.ctx, TFW.attn, TFW.vvec, fwd_seqln, fwd_dmod, TFConfig.NumHeads)

    TFLayer_Residual(TFW.resid, TFW.ctx, TFW.emb, fwd_seqln, fwd_dmod)

    // =================================================================
    // RULE CACHE: Write rule vector from prompt's last position
    // rule_vec = Wr · resid[write_pos]
    // Only writes once per sequence
    // =================================================================
    fwd_wpos = TFState.RuleWritePos

    IfCondition EqualTo(TFRuleCache.written, 0) ThenBlock: {
        rc_src = TF_VecAlloc(fwd_dmod)
        rc_col = 0
        WhileLoop LessThan(rc_col, fwd_dmod) {
            rc_val = TF_MatGet(TFW.resid, fwd_wpos, rc_col, fwd_dmod)
            TF_VecSet(rc_src, rc_col, rc_val)
            rc_col = Add(rc_col, 1)
        }
        TF_MatVecMul(TFRuleCache.vec, TFW.Wr, rc_src, fwd_dmod, fwd_dmod)
        TFRuleCache.written = 1
        TF_VecFree(rc_src, fwd_dmod)
    }

    // =================================================================
    // RULE CACHE: Inject rule vector into residual for positions AFTER prompt
    // =================================================================
    rc_pos = Add(fwd_wpos, 1)
    WhileLoop LessThan(rc_pos, fwd_seqln) {
        rc_col = 0
        WhileLoop LessThan(rc_col, fwd_dmod) {
            rc_old = TF_MatGet(TFW.resid, rc_pos, rc_col, fwd_dmod)
            rc_rv  = TF_VecGet(TFRuleCache.vec, rc_col)
            rc_new = Add(rc_old, rc_rv)
            TF_MatSet(TFW.resid, rc_pos, rc_col, fwd_dmod, rc_new)
            rc_col = Add(rc_col, 1)
        }
        rc_pos = Add(rc_pos, 1)
    }

    TFProjCarrier.seqln = fwd_seqln
    TFProjCarrier.dmod  = fwd_dmod
    TFProjCarrier.dff   = fwd_dff
    TFLayer_MLP(TFW.mlp_out, TFW.mlp_hidden, TFW.resid, TFW.W1, TFW.W2)

    TFLayer_Residual(TFW.resid2, TFW.mlp_out, TFW.resid, fwd_seqln, fwd_dmod)

    TFOutProjCarrier.seqln = fwd_seqln
    TFOutProjCarrier.dmod  = fwd_dmod
    TFOutProjCarrier.vocab = fwd_vocab
    TFLayer_OutputProj(TFW.logits, TFW.probs, TFW.resid2, TFW.Wout)
}