Function.GenPattern_Repeat4 {
    Input: gen_start: Integer
    Body: {
        gp_pos = 0
        WhileLoop LessThan(gp_pos, TFConfig.SeqLen) {
            gp_phase = Modulo(gp_pos, 4)
            gp_val = Modulo(Add(gen_start, gp_phase), 10)
            TF_VecSet(TFState.tokens, gp_pos, gp_val)
            gp_nphase = Modulo(Add(gp_pos, 1), 4)
            gp_tgt = Modulo(Add(gen_start, gp_nphase), 10)
            TF_VecSet(TFState.targets, gp_pos, gp_tgt)
