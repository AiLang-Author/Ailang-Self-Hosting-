// Attn/GenSample.ailang
// Training sample generation — all pattern types
// Now generates in prompt+continuation format for inference compatibility
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

// =============================================================================
// INDIVIDUAL PATTERN GENERATORS
// Each fills tokens[0..seqln-1] with a complete sequence
// and targets[0..seqln-1] with shifted next-token predictions
// =============================================================================

Function.GenPattern_CountBy1 {
    Input: gen_start: Integer
    Body: {
        gp_pos = 0
        WhileLoop LessThan(gp_pos, TFConfig.SeqLen) {
            gp_val = Modulo(Add(gen_start, gp_pos), 10)
            TF_VecSet(TFState.tokens, gp_pos, gp_val)
            gp_tgt = Modulo(Add(gen_start, Add(gp_pos, 1)), 10)
            TF_VecSet(TFState.targets, gp_pos, gp_tgt)
            gp_pos = Add(gp_pos, 1)
        }
        ReturnValue(0)
    }
}

Function.GenPattern_CountBy2 {
    Input: gen_start: Integer
    Body: {
        gp_pos = 0
        WhileLoop LessThan(gp_pos, TFConfig.SeqLen) {
            gp_val = Modulo(Add(gen_start, Multiply(gp_pos, 2)), 10)
            TF_VecSet(TFState.tokens, gp_pos, gp_val)
            gp_tgt = Modulo(Add(gen_start, Multiply(Add(gp_pos, 1), 2)), 10)
            TF_VecSet(TFState.targets, gp_pos, gp_tgt)
            gp_pos = Add(gp_pos, 1)
        }
        ReturnValue(0)
    }
}

Function.GenPattern_Repeat3 {
    Input: gen_start: Integer
    Body: {
        gp_pos = 0
        WhileLoop LessThan(gp_pos, TFConfig.SeqLen) {
            gp_phase = Modulo(gp_pos, 3)
            gp_val = Modulo(Add(gen_start, gp_phase), 10)
            TF_VecSet(TFState.tokens, gp_pos, gp_val)
            gp_nphase = Modulo(Add(gp_pos, 1), 3)
            gp_tgt = Modulo(Add(gen_start, gp_nphase), 10)
            TF_VecSet(TFState.targets, gp_pos, gp_tgt)
            gp_pos = Add(gp_pos, 1)
        }
        ReturnValue(0)
    }
}

