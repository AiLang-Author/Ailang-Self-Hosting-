Function.GenPattern_Addition {
    Body: {
        ga_seqln = TFConfig.SeqLen
        ga_tmask = TFState.target_mask
        ga_tok = TFState.tokens
        ga_tgt = TFState.targets

        ga_pp = 0
        WhileLoop LessThan(ga_pp, ga_seqln) {
            space_left = Subtract(ga_seqln, ga_pp)
            IfCondition LessThan(space_left, 6) ThenBlock: {
                WhileLoop LessThan(ga_pp, ga_seqln) {
                    TF_VecSet(ga_tok, ga_pp, 14)
                    IfCondition GreaterThan(ga_pp, 0) ThenBlock: {
                        prev_tok = TF_VecGet(ga_tok, Subtract(ga_pp, 1))
                        IfCondition EqualTo(prev_tok, 14) ThenBlock: {
                            TF_VecSet(ga_tmask, Subtract(ga_pp, 1), 0)
                        } ElseBlock: {
                            TF_VecSet(ga_tmask, Subtract(ga_pp, 1), 1)
                        }
                    }
                    ga_pp = Add(ga_pp, 1)
                }
            } ElseBlock: {
                ga_a = TF_RandMod(10)
                ga_b = TF_RandMod(10)
                ga_sum = Add(ga_a, ga_b)

                TF_VecSet(ga_tok, ga_pp, ga_a)
                IfCondition GreaterThan(ga_pp, 0) ThenBlock: {
                    TF_VecSet(ga_tmask, Subtract(ga_pp, 1), 0)
                }
                ga_pp = Add(ga_pp, 1)

                TF_VecSet(ga_tok, ga_pp, 10)
                IfCondition GreaterThan(ga_pp, 0) ThenBlock: {
                    TF_VecSet(ga_tmask, Subtract(ga_pp, 1), 1)
                }
                ga_pp = Add(ga_pp, 1)

                TF_VecSet(ga_tok, ga_pp, ga_b)
                IfCondition GreaterThan(ga_pp, 0) ThenBlock: {
                    TF_VecSet(ga_tmask, Subtract(ga_pp, 1), 0)
                }
                ga_pp = Add(ga_pp, 1)

                TF_VecSet(ga_tok, ga_pp, 13)
                IfCondition GreaterThan(ga_pp, 0) ThenBlock: {
                    TF_VecSet(ga_tmask, Subtract(ga_pp, 1), 1)
                }
                ga_pp = Add(ga_pp, 1)

                IfCondition GreaterEqual(ga_sum, 10) ThenBlock: {
                    ga_tens = Divide(ga_sum, 10)
                    ga_ones = Modulo(ga_sum, 10)
                    TF_VecSet(ga_tok, ga_pp, ga_tens)
                    IfCondition GreaterThan(ga_pp, 0) ThenBlock: { TF_VecSet(ga_tmask, Subtract(ga_pp, 1), 1) }
                    ga_pp = Add(ga_pp, 1)
                    TF_VecSet(ga_tok, ga_pp, ga_ones)
                    IfCondition GreaterThan(ga_pp, 0) ThenBlock: { TF_VecSet(ga_tmask, Subtract(ga_pp, 1), 1) }
                    ga_pp = Add(ga_pp, 1)
                } ElseBlock: {
                    TF_VecSet(ga_tok, ga_pp, ga_sum)
                    IfCondition GreaterThan(ga_pp, 0) ThenBlock: { TF_VecSet(ga_tmask, Subtract(ga_pp, 1), 1) }
                    ga_pp = Add(ga_pp, 1)
                }

                IfCondition LessThan(ga_pp, ga_seqln) ThenBlock: {
                    TF_VecSet(ga_tok, ga_pp, 14)
                    IfCondition GreaterThan(ga_pp, 0) ThenBlock: { TF_VecSet(ga_tmask, Subtract(ga_pp, 1), 1) }
                    ga_pp = Add(ga_pp, 1)
                }
            }
        }

        ga_pos = 0
        WhileLoop LessThan(ga_pos, Subtract(ga_seqln, 1)) {
            TF_VecSet(ga_tgt, ga_pos, TF_VecGet(ga_tok, Add(ga_pos, 1)))
            ga_pos = Add(ga_pos, 1)
        }
        TF_VecSet(ga_tgt, Subtract(ga_seqln, 1), 14)
        ReturnValue(0)
    }
}

// =============================================================================
// MAIN DISPATCHER
// =============================================================================
SubRoutine.ATTN_GenSample {
    gen_seqln = TFConfig.SeqLen
    gen_tok   = TFState.tokens
    gen_tgt   = TFState.targets
    gen_tmask = TFState.target_mask

    // Default: all positions active
    gen_pos = 0
    WhileLoop LessThan(gen_pos, gen_seqln) {
        TF_VecSet(gen_tmask, gen_pos, 1)
        gen_pos = Add(gen_pos, 1)
    }

    gen_pattern = TFState.SkillType

    // === BRAIN ROUTER: pick random skill, generate its data, override targets ===
    IfCondition EqualTo(gen_pattern, 99) ThenBlock: {
        max_seq = 0
        WhileLoop NotEqual(GetTrainSequence(max_seq), -1) { max_seq = Add(max_seq, 1) }
        rnd_idx = TF_RandMod(max_seq)
        rnd_skill = GetTrainSequence(rnd_idx)
        TFState.SkillType = rnd_skill
        ATTN_GenSample()
        TFState.SkillType = 99
        gen_bp = 0
        WhileLoop LessThan(gen_bp, gen_seqln) {
            TF_VecSet(TFState.targets, gen_bp, rnd_skill)
            gen_bp = Add(gen_bp, 1)
        }
    }

    // === REVERSAL (legacy) ===
    IfCondition EqualTo(gen_pattern, 99) ThenBlock: {
        // already handled above, skip
    }

    gen_start = TF_RandMod(10)

    // === DISPATCH TO PATTERN GENERATOR ===
    IfCondition EqualTo(gen_pattern, 0) ThenBlock: { GenPattern_CountBy1(gen_start) }
    IfCondition EqualTo(gen_pattern, 1) ThenBlock: { GenPattern_CountBy2(gen_start) }
    IfCondition EqualTo(gen_pattern, 2) ThenBlock: { GenPattern_Repeat3(gen_start) }
    IfCondition EqualTo(gen_pattern, 3) ThenBlock: { GenPattern_CountBy3(gen_start) }
    IfCondition EqualTo(gen_pattern, 4) ThenBlock: { GenPattern_CountBy5(gen_start) }
    IfCondition EqualTo(gen_pattern, 5) ThenBlock: { GenPattern_Countdown(gen_start) }
    IfCondition EqualTo(gen_pattern, 6) ThenBlock: { GenPattern_CountBy7(gen_start) }
    IfCondition EqualTo(gen_pattern, 7) ThenBlock: { GenPattern_CountBy4(gen_start) }
    IfCondition EqualTo(gen_pattern, 8) ThenBlock: { GenPattern_Repeat2(gen_start) }
    IfCondition EqualTo(gen_pattern, 9) ThenBlock: { GenPattern_Repeat4(gen_start) }
    IfCondition EqualTo(gen_pattern, 10) ThenBlock: { GenPattern_Addition() }

    // =================================================================
    // PROMPT MASKING — don't train on predicting prompt positions
    // Positions 0-3 are "given" context, model only learns to predict 4+
    // This matches inference where we feed 4 prompt tokens and generate the rest
    // Skip masking for brain (pattern 99) since it was already handled above
    // Skip masking for addition (pattern 10) since it has its own mask logic
    // =================================================================
    IfCondition NotEqual(gen_pattern, 99) ThenBlock: {
        IfCondition NotEqual(gen_pattern, 10) ThenBlock: {
            TF_VecSet(gen_tmask, 0, 0)
            TF_VecSet(gen_tmask, 1, 0)
            TF_VecSet(gen_tmask, 2, 0)
            TF_VecSet(gen_tmask, 3, 0)
        }
    }
}