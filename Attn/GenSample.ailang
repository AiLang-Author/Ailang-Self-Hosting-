Function.GenPattern_Countdown {
    Input: gen_start: Integer
    Body: {
        gp_pos = 0
        WhileLoop LessThan(gp_pos, TFConfig.SeqLen) {
            gp_val = Modulo(Subtract(Add(gen_start, 100), gp_pos), 10)
            TF_VecSet(TFState.tokens, gp_pos, gp_val)
            gp_tgt = Modulo(Subtract(Add(gen_start, 100), Add(gp_pos, 1)), 10)
            TF_VecSet(TFState.targets, gp_pos, gp_tgt)
            gp_pos = Add(gp_pos, 1)
        }
        ReturnValue(0)
    }
}

