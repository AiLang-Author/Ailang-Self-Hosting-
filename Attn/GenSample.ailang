Function.GenPattern_CountBy5 {
    Input: gen_start: Integer
    Body: {
        gp_pos = 0
        WhileLoop LessThan(gp_pos, TFConfig.SeqLen) {
            gp_val = Modulo(Add(gen_start, Multiply(gp_pos, 5)), 10)
