// Attn/Infer.ailang
// Inference — reversal and autoregressive generation for all patterns
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

SubRoutine.ATTN_Infer {
    inf_seqln = TFConfig.SeqLen
    inf_vocab = TFConfig.VocabSize
    inf_prow  = TF_VecAlloc(inf_vocab)

    IfCondition EqualTo(TFState.TaskMode, 1) ThenBlock: {
        // === LEGACY REVERSAL INFERENCE ===
        inf_total = 10
        inf_ok    = 0
        inf_pred  = TF_VecAlloc(inf_seqln)

        inf_i = 0
        WhileLoop LessThan(inf_i, inf_total) {
            ATTN_GenSample()
            TFRuleCache.written = 0
            ATTN_ConvertWeights()
            ATTN_Forward()

            inf_pos = 0
            WhileLoop LessThan(inf_pos, inf_seqln) {
                inf_col = 0
                WhileLoop LessThan(inf_col, inf_vocab) {
                    inf_val = TF_MatGet(TFW.probs, inf_pos, inf_col, inf_vocab)
                    TF_VecSet(inf_prow, inf_col, inf_val)
                    inf_col = Add(inf_col, 1)
                }
                inf_pred_val = TF_VecArgMax(inf_prow, inf_vocab)
                TF_VecSet(inf_pred, inf_pos, inf_pred_val)
                inf_pos = Add(inf_pos, 1)
            }

            inf_all = 1
            inf_pos = 0
            WhileLoop LessThan(inf_pos, inf_seqln) {
                inf_pval = TF_VecGet(inf_pred,        inf_pos)
                inf_tval = TF_VecGet(TFState.targets, inf_pos)
                IfCondition NotEqual(inf_pval, inf_tval) ThenBlock: {
                    inf_all = 0
                }
                inf_pos = Add(inf_pos, 1)
            }

            // Print input
            inf_pos = 0
            WhileLoop LessThan(inf_pos, inf_seqln) {
                PrintNumber(TF_VecGet(TFState.tokens, inf_pos))
                PrintMessage(" ")
                inf_pos = Add(inf_pos, 1)
            }
            PrintMessage("-> ")
            // Print prediction
            inf_pos = 0
            WhileLoop LessThan(inf_pos, inf_seqln) {
                PrintNumber(TF_VecGet(inf_pred, inf_pos))
                PrintMessage(" ")
                inf_pos = Add(inf_pos, 1)
            }
            IfCondition EqualTo(inf_all, 1) ThenBlock: {
                PrintMessage("OK")
                inf_ok = Add(inf_ok, 1)
            } ElseBlock: {
                PrintMessage("FAIL")
            }
            PrintMessage("\n")

            inf_i = Add(inf_i, 1)
        }
        PrintMessage("ACCURACY ")
        PrintNumber(inf_ok)
        PrintMessage("/")
        PrintNumber(inf_total)
        PrintMessage("\n")

        TF_VecFree(inf_pred, inf_seqln)

    } ElseBlock: {
        // === AUTOREGRESSIVE GENERATION — test all patterns ===
        inf_ptype = 0
         WhileLoop LessThan(inf_ptype, 10) {
            IfCondition EqualTo(inf_ptype, 3) ThenBlock: {
                // Skip unused pattern 3
            } ElseBlock: {
                // Print pattern label
                IfCondition EqualTo(inf_ptype, 0) ThenBlock: { PrintMessage("\n--- COUNT BY 2 ---\n") }
                IfCondition EqualTo(inf_ptype, 1) ThenBlock: { PrintMessage("\n--- COUNT BY 1 ---\n") }
                IfCondition EqualTo(inf_ptype, 2) ThenBlock: { PrintMessage("\n--- REPEAT-3 ---\n") }
                IfCondition EqualTo(inf_ptype, 4) ThenBlock: { PrintMessage("\n--- COUNT BY 3 ---\n") }
                IfCondition EqualTo(inf_ptype, 5) ThenBlock: { PrintMessage("\n--- COUNT BY 5 ---\n") }
                IfCondition EqualTo(inf_ptype, 6) ThenBlock: { PrintMessage("\n--- COUNT BACKWARD ---\n") }
                IfCondition EqualTo(inf_ptype, 7) ThenBlock: { PrintMessage("\n--- SUCCESSOR ---\n") }
                IfCondition EqualTo(inf_ptype, 8) ThenBlock: { PrintMessage("\n--- COUNT BY 10 (V=25) ---\n") }
                IfCondition EqualTo(inf_ptype, 9) ThenBlock: { PrintMessage("\n--- ADDITION ---\n") }

                inf_run = 0
                WhileLoop LessThan(inf_run, 3) {
                    IfCondition NotEqual(inf_ptype, 9) ThenBlock: {
                        // Generate appropriate prompt (4 tokens)
                        inf_pstart = TF_RandMod(10)

                        inf_pp = 0
                        WhileLoop LessThan(inf_pp, 4) {
                            IfCondition EqualTo(inf_ptype, 0) ThenBlock: { inf_ptok = Modulo(Add(inf_pstart, Multiply(inf_pp, 2)), 10) }
                            IfCondition EqualTo(inf_ptype, 1) ThenBlock: { inf_ptok = Modulo(Add(inf_pstart, inf_pp), 10) }
                            IfCondition EqualTo(inf_ptype, 2) ThenBlock: { inf_ptok = Modulo(Add(inf_pstart, Modulo(inf_pp, 3)), 10) }
                            IfCondition EqualTo(inf_ptype, 4) ThenBlock: { inf_ptok = Modulo(Add(inf_pstart, Multiply(inf_pp, 3)), 10) }
                            IfCondition EqualTo(inf_ptype, 5) ThenBlock: { inf_ptok = Modulo(Add(inf_pstart, Multiply(inf_pp, 5)), 10) }
                            IfCondition EqualTo(inf_ptype, 6) ThenBlock: { inf_ptok = Modulo(Add(Subtract(inf_pstart, inf_pp), 100), 10) }
                            IfCondition EqualTo(inf_ptype, 7) ThenBlock: { inf_ptok = Modulo(Add(inf_pstart, inf_pp), 10) }
                            IfCondition EqualTo(inf_ptype, 8) ThenBlock: { inf_ptok = Modulo(Multiply(inf_pp, 10), 25) }
                            TF_VecSet(TFState.tokens, inf_pp, inf_ptok)
                            inf_pp = Add(inf_pp, 1)
                        }

                    // Zero-pad rest
                    inf_pp = 4
                    WhileLoop LessThan(inf_pp, inf_seqln) {
                        TF_VecSet(TFState.tokens, inf_pp, 0)
                        inf_pp = Add(inf_pp, 1)
                    }

                    // Print prompt
                    PrintMessage("PROMPT: ")
                    inf_pp = 0
                    WhileLoop LessThan(inf_pp, 4) {
                        PrintNumber(TF_VecGet(TFState.tokens, inf_pp))
                        PrintMessage(" ")
                        inf_pp = Add(inf_pp, 1)
                    }
                    PrintMessage("=> ")

                    // Autoregressive generation
                    TFRuleCache.written = 0
                    inf_gen_pos = 4
                    WhileLoop LessThan(inf_gen_pos, inf_seqln) {
                        ATTN_ConvertWeights()
                        ATTN_Forward()
                        inf_read_pos = Subtract(inf_gen_pos, 1)
                        inf_col = 0
                        WhileLoop LessThan(inf_col, inf_vocab) {
                            inf_val = TF_MatGet(TFW.probs, inf_read_pos, inf_col, inf_vocab)
                            TF_VecSet(inf_prow, inf_col, inf_val)
                            inf_col = Add(inf_col, 1)
                        }
                        inf_next_tok = TF_VecArgMax(inf_prow, inf_vocab)
                        TF_VecSet(TFState.tokens, inf_gen_pos, inf_next_tok)
                        inf_gen_pos = Add(inf_gen_pos, 1)
                    }

                    // Print generated
                    inf_pp = 4
                    WhileLoop LessThan(inf_pp, inf_seqln) {
                        PrintNumber(TF_VecGet(TFState.tokens, inf_pp))
                        PrintMessage(" ")
                        inf_pp = Add(inf_pp, 1)
                    }
                    PrintMessage("\n")
                }

                // Special handling for arithmetic prompts
                IfCondition EqualTo(inf_ptype, 9) ThenBlock: {
                    inf_a = TF_RandMod(10)
                    inf_b = TF_RandMod(10)
                    TF_VecSet(TFState.tokens, 0, inf_a)
                    TF_VecSet(TFState.tokens, 1, 10)
                    TF_VecSet(TFState.tokens, 2, inf_b)
                    TF_VecSet(TFState.tokens, 3, 13)

                    // Zero-pad rest
                    inf_pp = 4
                    WhileLoop LessThan(inf_pp, inf_seqln) {
                        TF_VecSet(TFState.tokens, inf_pp, 0)
                        inf_pp = Add(inf_pp, 1)
                    }

                    // Print: "A + B = "
                    PrintMessage("PROMPT: ")
                    PrintNumber(inf_a)
                    PrintMessage(" + ")
                    PrintNumber(inf_b)
                    PrintMessage(" = ")

                    // Autoreg generate
                    TFRuleCache.written = 0
                    inf_gen_pos = 4
                    WhileLoop LessThan(inf_gen_pos, inf_seqln) {
                        ATTN_ConvertWeights()
                        ATTN_Forward()
                        inf_read_pos = Subtract(inf_gen_pos, 1)
                        inf_col = 0
                        WhileLoop LessThan(inf_col, inf_vocab) {
                            inf_val = TF_MatGet(TFW.probs, inf_read_pos, inf_col, inf_vocab)
                            TF_VecSet(inf_prow, inf_col, inf_val)
                            inf_col = Add(inf_col, 1)
                        }
                        inf_next_tok = TF_VecArgMax(inf_prow, inf_vocab)
                        TF_VecSet(TFState.tokens, inf_gen_pos, inf_next_tok)
                        inf_gen_pos = Add(inf_gen_pos, 1)
                    }

                    // Print only until PAD token (14) or end
                    inf_pp = 4
                    WhileLoop LessThan(inf_pp, inf_seqln) {
                        inf_out_tok = TF_VecGet(TFState.tokens, inf_pp)
                        IfCondition EqualTo(inf_out_tok, 14) ThenBlock: {
                            inf_pp = inf_seqln  // break
                        } ElseBlock: {
                            PrintNumber(inf_out_tok)
                            PrintMessage(" ")
                            inf_pp = Add(inf_pp, 1)
                        }
                    }
                    PrintMessage("  (correct: ")
                    PrintNumber(Add(inf_a, inf_b))
                    PrintMessage(")")
                    PrintMessage("\n")
                    }

                inf_run = Add(inf_run, 1)
                }
            }
            inf_ptype = Add(inf_ptype, 1)
        }
    }

    TF_VecFree(inf_prow, inf_vocab)
}