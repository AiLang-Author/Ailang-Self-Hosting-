// Attn/Init.ailang
// Model initialization — allocate all weights, caches, gradient buffers
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

SubRoutine.ATTN_Init {
    dbg_seed = TFRand.seed
    PrintMessage("[DBG] RNG seed = ")
    PrintNumber(dbg_seed)
    PrintMessage("\n")
    PrintMessage("ATTN - AILANG IS ALL YOU NEED\n")
    PrintMessage("D=")
    PrintNumber(TFConfig.DModel)
    PrintMessage(" SEQ=")
    PrintNumber(TFConfig.SeqLen)
    PrintMessage(" V=")
    PrintNumber(TFConfig.VocabSize)
    PrintMessage("\n\n")

    init_dmod  = TFConfig.DModel
    init_seqln = TFConfig.SeqLen
    init_vocab = TFConfig.VocabSize
    init_dff   = TFConfig.DFF

    // Init act tables
    TFAct_Init()

    // Allocate weights using SubRoutine to enable RNG updates
    TFAllocCarrier.rows = init_vocab
    TFAllocCarrier.cols = init_dmod
    TFAllocCarrier.range = 2
    TFLayer_AllocMatSub()
    TFW.Embed = TFAllocCarrier.result

    dbg_seed2 = TFRand.seed
    PrintMessage("[DBG] After Embed: seed = ")
    PrintNumber(dbg_seed2)
    PrintMessage("\n")
    PrintMessage("  Embed[0,0..3] = ")
    PrintNumber(TF_MatGet(TFW.Embed, 0, 0, init_dmod))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Embed, 0, 1, init_dmod))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Embed, 0, 2, init_dmod))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Embed, 0, 3, init_dmod))
    PrintMessage("\n")
    PrintMessage("  Embed[1,0..3] = ")
    PrintNumber(TF_MatGet(TFW.Embed, 1, 0, init_dmod))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Embed, 1, 1, init_dmod))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Embed, 1, 2, init_dmod))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Embed, 1, 3, init_dmod))
    PrintMessage("\n")
    PrintMessage("  Embed[5,0..3] = ")
    PrintNumber(TF_MatGet(TFW.Embed, 5, 0, init_dmod))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Embed, 5, 1, init_dmod))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Embed, 5, 2, init_dmod))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Embed, 5, 3, init_dmod))
    PrintMessage("\n")

    TFAllocCarrier.rows = init_seqln
    TFAllocCarrier.cols = init_dmod
    TFAllocCarrier.range = 2
    TFLayer_AllocMatSub()
    TFW.PosEmb = TFAllocCarrier.result

    TFAllocCarrier.rows = init_dmod
    TFAllocCarrier.cols = init_dmod
    TFAllocCarrier.range = 2
    TFLayer_AllocMatSub()
    TFW.Wq = TFAllocCarrier.result

    TFAllocCarrier.rows = init_dmod
    TFAllocCarrier.cols = init_dmod
    TFAllocCarrier.range = 2
    TFLayer_AllocMatSub()
    TFW.Wk = TFAllocCarrier.result

    TFAllocCarrier.rows = init_dmod
    TFAllocCarrier.cols = init_dmod
    TFAllocCarrier.range = 2
    TFLayer_AllocMatSub()
    TFW.Wv = TFAllocCarrier.result

    TFAllocCarrier.rows = init_vocab
    TFAllocCarrier.cols = init_dmod
    TFAllocCarrier.range = 2
    TFLayer_AllocMatSub()
    TFW.Wout = TFAllocCarrier.result

    // Rule cache weights (ReZero: explicitly zero-allocated to prevent modulo by zero)
    TFW.Wr = TF_MatAlloc(init_dmod, init_dmod)
    TF_MatZero(TFW.Wr, init_dmod, init_dmod)

    TFWf.Wr = TF_MatAlloc(init_dmod, init_dmod)
    TF_IntToFloat(TFWf.Wr, TFW.Wr, Multiply(init_dmod, init_dmod))
    TFW.dWr = TF_MatAlloc(init_dmod, init_dmod)

    TFAllocCarrier.rows = init_dmod
    TFAllocCarrier.cols = init_dff
    TFAllocCarrier.range = 2
    TFLayer_AllocMatSub()
    TFW.W1 = TFAllocCarrier.result

    TFAllocCarrier.rows = init_dff
    TFAllocCarrier.cols = init_dmod
    TFAllocCarrier.range = 2
    TFLayer_AllocMatSub()
    TFW.W2 = TFAllocCarrier.result

    // Allocate forward cache
    TFW.emb    = TF_MatAlloc(init_seqln, init_dmod)
    TFW.qvec   = TF_MatAlloc(init_seqln, init_dmod)
    TFW.kvec   = TF_MatAlloc(init_seqln, init_dmod)
    TFW.vvec   = TF_MatAlloc(init_seqln, init_dmod)
    init_hsl   = Multiply(TFConfig.NumHeads, init_seqln)
    TFW.scores = TF_MatAlloc(init_hsl, init_seqln)
    TFW.attn   = TF_MatAlloc(init_hsl, init_seqln)
    TFW.ctx    = TF_MatAlloc(init_seqln, init_dmod)
    TFW.resid  = TF_MatAlloc(init_seqln, init_dmod)
    TFW.logits = TF_MatAlloc(init_seqln, init_vocab)
    TFW.probs  = TF_MatAlloc(init_seqln, init_vocab)
    TFW.mlp_hidden = TF_MatAlloc(init_seqln, init_dff)
    TFW.mlp_out    = TF_MatAlloc(init_seqln, init_dmod)
    TFW.resid2     = TF_MatAlloc(init_seqln, init_dmod)

    // Allocate gradient buffers
    TFW.dW1      = TF_MatAlloc(init_dmod, init_dff)
    TFW.dW2      = TF_MatAlloc(init_dff,  init_dmod)
    TFW.dMlp_out = TF_MatAlloc(init_seqln, init_dmod)
    TFW.dResid2  = TF_MatAlloc(init_seqln, init_dmod)
    TFW.dEmbed  = TF_MatAlloc(init_vocab, init_dmod)
    TFW.dPosEmb = TF_MatAlloc(init_seqln, init_dmod)
    TFW.dWq     = TF_MatAlloc(init_dmod,  init_dmod)
    TFW.dWk     = TF_MatAlloc(init_dmod,  init_dmod)
    TFW.dWv     = TF_MatAlloc(init_dmod,  init_dmod)
    TFW.dWout   = TF_MatAlloc(init_vocab, init_dmod)
    TFW.dLogits = TF_MatAlloc(init_seqln, init_vocab)
    TFW.dResid  = TF_MatAlloc(init_seqln, init_dmod)
    TFW.dCtx    = TF_MatAlloc(init_seqln, init_dmod)
    TFW.dEmb    = TF_MatAlloc(init_seqln, init_dmod)
    TFW.dQ      = TF_MatAlloc(init_seqln, init_dmod)
    TFW.dK      = TF_MatAlloc(init_seqln, init_dmod)
    TFW.dV      = TF_MatAlloc(init_seqln, init_dmod)
    TFW.dScores = TF_MatAlloc(init_hsl, init_seqln)

    // Rule cache vector (DModel elements)
    TFRuleCache.vec = TF_VecAlloc(init_dmod)
    TFRuleCache.written = 0

    // Allocate float master weight buffers and copy integer weights
    TFWf.W1     = TF_MatAlloc(init_dmod,  init_dff)
    TFWf.W2     = TF_MatAlloc(init_dff,   init_dmod)
    TFWf.Embed  = TF_MatAlloc(init_vocab, init_dmod)
    TFWf.PosEmb = TF_MatAlloc(init_seqln, init_dmod)
    TFWf.Wq     = TF_MatAlloc(init_dmod,  init_dmod)
    TFWf.Wk     = TF_MatAlloc(init_dmod,  init_dmod)
    TFWf.Wv     = TF_MatAlloc(init_dmod,  init_dmod)
    TFWf.Wout   = TF_MatAlloc(init_vocab, init_dmod)
    TF_IntToFloat(TFWf.W1,     TFW.W1,     Multiply(init_dmod,  init_dff))
    TF_IntToFloat(TFWf.W2,     TFW.W2,     Multiply(init_dff,   init_dmod))
    TF_IntToFloat(TFWf.Embed,  TFW.Embed,  Multiply(init_vocab, init_dmod))
    TF_IntToFloat(TFWf.PosEmb, TFW.PosEmb, Multiply(init_seqln, init_dmod))
    TF_IntToFloat(TFWf.Wq,     TFW.Wq,     Multiply(init_dmod,  init_dmod))
    TF_IntToFloat(TFWf.Wk,     TFW.Wk,     Multiply(init_dmod,  init_dmod))
    TF_IntToFloat(TFWf.Wv,     TFW.Wv,     Multiply(init_dmod,  init_dmod))
    TF_IntToFloat(TFWf.Wout,   TFW.Wout,   Multiply(init_vocab, init_dmod))

    // Allocate token/target buffers
    TFState.tokens  = TF_VecAlloc(init_seqln)
    TFState.targets = TF_VecAlloc(init_seqln)
    TFState.step     = 0
    TFState.loss_acc = 0
    TFState.acc_num  = 0
    TFState.acc_den  = 0
    TFState.best_acc = 0
    TFState.decay_count = 0
    TFState.converge_count = 0
    TFState.stuck_count = 0
    TFState.lr_multiplier = 100

    TFState.SkillType = TrainJob.SkillType
    TFState.SkillPath = GetSkillPath(TrainJob.SkillType)
    IfCondition EqualTo(TrainJob.SkillType, 99) ThenBlock: {
        TFState.SkillPath = "skills/brain.bin"
    }

    TFState.Signature = TF_VecAlloc(32)
    sig_z = 0
    WhileLoop LessThan(sig_z, 32) {
        TF_VecSet(TFState.Signature, sig_z, 0)
        sig_z = Add(sig_z, 1)
    }
    TFState.SigCount = 0
    SkillInfo.HasRC = 1
    TFState.target_mask = TF_VecAlloc(init_seqln)

    PrintMessage("[ATTN] tokens=")
    PrintNumber(TFState.tokens)
    PrintMessage(" targets=")
    PrintNumber(TFState.targets)
    PrintMessage("\n")

    // Print param count
    vd  = Multiply(init_vocab, init_dmod)
    sd  = Multiply(init_seqln, init_dmod)
    dd  = Multiply(init_dmod,  init_dmod)
    ffnd = Multiply(init_dmod, init_dff)
    tot = Add(Add(Multiply(vd, 2), sd), Multiply(dd, 4))
    tot = Add(tot, Multiply(ffnd, 2))
    PrintMessage("[ATTN] init ok — params=")
    PrintNumber(tot)
    PrintMessage("\n\n")
}