// =============================================================================
// WORKAROUND: Local Wout Load/Store
// =============================================================================
Function.TF_SaveWout {
    Input: fd: Integer
    Input: fWout: Integer
    Output: Integer
    Body: {
        vd = Multiply(TFConfig.VocabSize, TFConfig.DModel)
        TF_WriteBuffer(fd, fWout, vd)
        ReturnValue(1)
    }
}

Function.TF_LoadWout {
    Input: fd: Integer
    Input: fWout: Integer
    Output: Integer
    Body: {
        vd = Multiply(TFConfig.VocabSize, TFConfig.DModel)
        TF_ReadBuffer(fd, fWout, vd)
        ReturnValue(1)
    }
}

// =============================================================================
// LOAD WEIGHTS
// =============================================================================
SubRoutine.ATTN_LoadWeights {
    PrintMessage("[LOAD] Reading model.bin...\n")
    // open("model.bin", O_RDONLY, 0)
    load_fd = SystemCall(2, "model.bin", 0, 0)
    IfCondition LessThan(load_fd, 0) ThenBlock: {
        PrintMessage("[LOAD] No model.bin found — will train\n")
        TFState.step = 0
    }
    IfCondition GreaterEqual(load_fd, 0) ThenBlock: {
        ok = TF_LoadModel(load_fd, TFWf.Embed, TFWf.PosEmb, TFWf.Wq, TFWf.Wk, TFWf.Wv)
        TF_LoadMLP(load_fd, TFWf.W1, TFWf.W2)
        TF_LoadWout(load_fd, TFWf.Wout)
        TF_ReadBuffer(load_fd, TFWf.Wr, Multiply(TFConfig.DModel, TFConfig.DModel))
        SystemCall(3, load_fd)
        IfCondition EqualTo(ok, 1) ThenBlock: {
            PrintMessage("[LOAD] Weights loaded successfully\n")
            TFState.step = 40000
        }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage("[LOAD] Header mismatch — will train\n")
            TFState.step = 0
        }
    }
}