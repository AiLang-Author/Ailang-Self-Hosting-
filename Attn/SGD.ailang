// Attn/SGD.ailang
// SGD weight update
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

SubRoutine.ATTN_SGDUpdate {
    sgd_dmod  = TFConfig.DModel
    sgd_seqln = TFConfig.SeqLen
    sgd_vocab = TFConfig.VocabSize
    sgd_den   = TFConfig.LR_Scale

    // Sequence Packing Adjustment:
    // Because the sequence is packed with active tokens instead of empty PADs,
    // the gradient accumulators receive ~10x more signal. Scale denominator to compensate.
    sgd_den = Multiply(sgd_den, 2)

    // Brain-mode scaling: when training the router (SkillType 99),
    // gradients are ~64x larger due to bootstrapping from specialist weights.
    // Scale denominator to keep weight updates in the same range as specialists.
    IfCondition EqualTo(TFState.SkillType, 99) ThenBlock: {
    //    sgd_den = Multiply(sgd_den, 64)
    }

    // Apply LR decay: multiply denominator by 100/lr_multiplier
    // lr_multiplier=100 → no change, =50 → 2× slower, =10 → 10× slower
    sgd_den = Divide(Multiply(sgd_den, 100), TFState.lr_multiplier)
    sgd_lr_a  = TFConfig.LR_Attn
    sgd_lr_e  = TFConfig.LR_Embed
    sgd_lr_o  = TFConfig.LR_Out
    sgd_dff   = TFConfig.DFF

    // Update float masters (not integer working copies)
    TF_FSGD(TFWf.W1,     TFW.dW1,     sgd_dmod,  sgd_dff,   sgd_lr_a, sgd_den)
    TF_FSGD(TFWf.W2,     TFW.dW2,     sgd_dff,   sgd_dmod,  sgd_lr_a, sgd_den)
    TF_FSGD(TFWf.Wq,     TFW.dWq,     sgd_dmod,  sgd_dmod,  sgd_lr_a, sgd_den)
    TF_FSGD(TFWf.Wk,     TFW.dWk,     sgd_dmod,  sgd_dmod,  sgd_lr_a, sgd_den)
    TF_FSGD(TFWf.Wv,     TFW.dWv,     sgd_dmod,  sgd_dmod,  sgd_lr_a, sgd_den)
    TF_FSGD(TFWf.Embed,  TFW.dEmbed,  sgd_vocab, sgd_dmod,  sgd_lr_e, sgd_den)
    TF_FSGD(TFWf.PosEmb, TFW.dPosEmb, sgd_seqln, sgd_dmod,  sgd_lr_e, sgd_den)
    TF_FSGD(TFWf.Wout,   TFW.dWout,   sgd_vocab, sgd_dmod,  sgd_lr_o, sgd_den)
    // Rule Cache needs a slower LR to prevent memory vector explosion over time
    sgd_den_wr = Multiply(sgd_den, 10)
    TF_FSGD(TFWf.Wr,     TFW.dWr,     sgd_dmod,  sgd_dmod,  sgd_lr_a, sgd_den_wr)
}