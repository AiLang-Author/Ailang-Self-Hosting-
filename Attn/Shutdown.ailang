// Attn/Shutdown.ailang
// Free all allocated memory
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

SubRoutine.ATTN_Shutdown {
    sdn_dmod  = TFConfig.DModel
    sdn_seqln = TFConfig.SeqLen
    sdn_vocab = TFConfig.VocabSize
    sdn_dff   = TFConfig.DFF

    TFAct_Shutdown()

    // Free float master weight buffers
    TF_MatFree(TFWf.W1,     sdn_dmod,  sdn_dff)
    TF_MatFree(TFWf.W2,     sdn_dff,   sdn_dmod)
    TF_MatFree(TFWf.Embed,  sdn_vocab, sdn_dmod)
    TF_MatFree(TFWf.PosEmb, sdn_seqln, sdn_dmod)
    TF_MatFree(TFWf.Wq,     sdn_dmod,  sdn_dmod)
    TF_MatFree(TFWf.Wk,     sdn_dmod,  sdn_dmod)
    TF_MatFree(TFWf.Wv,     sdn_dmod,  sdn_dmod)
    TF_MatFree(TFWf.Wout,   sdn_vocab, sdn_dmod)
    TF_MatFree(TFWf.Wr,     sdn_dmod,  sdn_dmod)

    TF_MatFree(TFW.W1,      sdn_dmod,  sdn_dff)
    TF_MatFree(TFW.W2,      sdn_dff,   sdn_dmod)
    TF_MatFree(TFW.Embed,   sdn_vocab, sdn_dmod)
    TF_MatFree(TFW.PosEmb,  sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.Wq,      sdn_dmod,  sdn_dmod)
    TF_MatFree(TFW.Wk,      sdn_dmod,  sdn_dmod)
    TF_MatFree(TFW.Wv,      sdn_dmod,  sdn_dmod)
    TF_MatFree(TFW.Wout,    sdn_vocab, sdn_dmod)
    TF_MatFree(TFW.Wr,      sdn_dmod,  sdn_dmod)
    TF_MatFree(TFW.emb,     sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.qvec,    sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.kvec,    sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.vvec,    sdn_seqln, sdn_dmod)
    sdn_hsl = Multiply(TFConfig.NumHeads, sdn_seqln)
    TF_MatFree(TFW.scores,  sdn_hsl, sdn_seqln)
    TF_MatFree(TFW.attn,    sdn_hsl, sdn_seqln)
    TF_MatFree(TFW.ctx,     sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.resid,   sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.logits,  sdn_seqln, sdn_vocab)
    TF_MatFree(TFW.probs,   sdn_seqln, sdn_vocab)
    TF_MatFree(TFW.mlp_hidden, sdn_seqln, sdn_dff)
    TF_MatFree(TFW.mlp_out,    sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.resid2,     sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.dW1,      sdn_dmod,  sdn_dff)
    TF_MatFree(TFW.dW2,      sdn_dff,   sdn_dmod)
    TF_MatFree(TFW.dMlp_out, sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.dResid2,  sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.dEmbed,  sdn_vocab, sdn_dmod)
    TF_MatFree(TFW.dPosEmb, sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.dWq,     sdn_dmod,  sdn_dmod)
    TF_MatFree(TFW.dWk,     sdn_dmod,  sdn_dmod)
    TF_MatFree(TFW.dWv,     sdn_dmod,  sdn_dmod)
    TF_MatFree(TFW.dWout,   sdn_vocab, sdn_dmod)
    TF_MatFree(TFW.dWr,     sdn_dmod,  sdn_dmod)
    TF_MatFree(TFW.dLogits, sdn_seqln, sdn_vocab)
    TF_MatFree(TFW.dResid,  sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.dCtx,    sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.dEmb,    sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.dQ,      sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.dK,      sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.dV,      sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.dScores, sdn_hsl, sdn_seqln)
    TF_VecFree(TFRuleCache.vec, sdn_dmod)

    TF_VecFree(TFState.tokens,  sdn_seqln)
    TF_VecFree(TFState.targets, sdn_seqln)
    TF_VecFree(TFState.Signature, 32)
    TF_VecFree(TFState.target_mask, sdn_seqln)

    PrintMessage("[ATTN] done\n")
}