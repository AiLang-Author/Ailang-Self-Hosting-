// Attn/Skills.ailang
// Skill index = GenSample pattern number. No exceptions.

Function.GetSkillPath {
    Input: idx: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(idx, 0)  ThenBlock: { ReturnValue("skills/skill_00.bin") }
        IfCondition EqualTo(idx, 1)  ThenBlock: { ReturnValue("skills/skill_01.bin") }
        IfCondition EqualTo(idx, 2)  ThenBlock: { ReturnValue("skills/skill_02.bin") }
        IfCondition EqualTo(idx, 3)  ThenBlock: { ReturnValue("skills/skill_03.bin") }
        IfCondition EqualTo(idx, 4)  ThenBlock: { ReturnValue("skills/skill_04.bin") }
        IfCondition EqualTo(idx, 5)  ThenBlock: { ReturnValue("skills/skill_05.bin") }
        IfCondition EqualTo(idx, 6)  ThenBlock: { ReturnValue("skills/skill_06.bin") }
        IfCondition EqualTo(idx, 7)  ThenBlock: { ReturnValue("skills/skill_07.bin") }
        IfCondition EqualTo(idx, 8)  ThenBlock: { ReturnValue("skills/skill_08.bin") }
        IfCondition EqualTo(idx, 9)  ThenBlock: { ReturnValue("skills/skill_09.bin") }
        IfCondition EqualTo(idx, 10) ThenBlock: { ReturnValue("skills/skill_10.bin") }
        ReturnValue(0)
    }
}

Function.GetTrainSequence {
    Input: step: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(step, 0)  ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(step, 1)  ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(step, 2)  ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(step, 3)  ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(step, 4)  ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(step, 5)  ThenBlock: { ReturnValue(5) }
        IfCondition EqualTo(step, 6)  ThenBlock: { ReturnValue(6) }
        IfCondition EqualTo(step, 7)  ThenBlock: { ReturnValue(7) }
        IfCondition EqualTo(step, 8)  ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(step, 9)  ThenBlock: { ReturnValue(9) }
        IfCondition EqualTo(step, 10) ThenBlock: { ReturnValue(10) }
        ReturnValue(-1)
    }
}
