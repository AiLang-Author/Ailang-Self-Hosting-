// =============================================================================
// FLOAT MASTER WEIGHTS — Q16 accumulators (SGD updates happen here)
// =============================================================================
FixedPool.TFWf {
    "W1":     Initialize=0
    "W2":     Initialize=0
    "Embed":  Initialize=0
    "PosEmb": Initialize=0
    "Wq":     Initialize=0
    "Wk":     Initialize=0
    "Wv":     Initialize=0
    "Wout":   Initialize=0
    "Wr":     Initialize=0
}

// =============================================================================
// ALL MODEL STATE — owned here, nowhere else
// =============================================================================
FixedPool.TFW {
    // Weights
    "W1":     Initialize=0
    "W2":     Initialize=0
    "Embed":  Initialize=0
    "PosEmb": Initialize=0
    "Wq":     Initialize=0
    "Wk":     Initialize=0
    "Wv":     Initialize=0
    "Wout":   Initialize=0
    "Wr":     Initialize=0
    // Forward cache
    "emb":    Initialize=0
    "qvec":   Initialize=0
    "kvec":   Initialize=0
    "vvec":   Initialize=0
    "scores": Initialize=0
    "attn":   Initialize=0
    "ctx":    Initialize=0
    "resid":  Initialize=0
    "logits": Initialize=0
    "probs":  Initialize=0
    "mlp_hidden": Initialize=0
    "mlp_out":    Initialize=0
    "resid2":     Initialize=0
    // Gradient buffers
    "dW1":     Initialize=0
    "dW2":     Initialize=0
    "dMlp_out":Initialize=0
    "dResid2": Initialize=0
    "dEmbed":  Initialize=0
    "dPosEmb": Initialize=0
    "dWq":     Initialize=0
    "dWk":     Initialize=0
    "dWv":     Initialize=0
    "dWout":   Initialize=0
    "dWr":     Initialize=0
    "dLogits": Initialize=0
    "dResid":  Initialize=0
    "dCtx":    Initialize=0
    "dEmb":    Initialize=0
    "dQ":      Initialize=0
    "dK":      Initialize=0
    "dV":      Initialize=0
    "dScores": Initialize=0
}

// =============================================================================
// TRAIN JOB CONFIG
// =============================================================================
FixedPool.TrainJob {
    "Mode":      Initialize=2    // 0=train specialist, 1=brain mode, 2=auto-train all & run brain
    "SkillType": Initialize=0    // which task to train (mode 0)
}

// =============================================================================
// TRAINING HEAD/TAIL STATE
// =============================================================================
FixedPool.TFState {
    "tokens":   Initialize=0
    "targets":  Initialize=0
    "step":     Initialize=0
    "loss_acc": Initialize=0
    "acc_num":  Initialize=0
    "acc_den":  Initialize=0
    "best_acc":       Initialize=0
    "decay_count":    Initialize=0
    "converge_count": Initialize=0
    "stuck_count":    Initialize=0
    "lr_multiplier":  Initialize=100
    "TaskMode":       Initialize=0    // 0=next-token-prediction, 1=reversal (legacy)
    "RuleWritePos":   Initialize=3    // Store rule after this position (end of prompt)
    "SkillType":      Initialize=0
    "SkillPath":      Initialize=0
    "Signature":      Initialize=0
    "SigCount":       Initialize=0
    "target_mask":    Initialize=0
}

// =============================================================================
// SKILL REGISTRY
// =============================================================================
FixedPool.SkillRegistry {
    "count":      Initialize=0     // number of registered skills
    "signatures": Initialize=0     // pointer to array of signature vectors
    "paths":      Initialize=0     // pointer to array of path string pointers
    "configs":    Initialize=0     // pointer to array of config data
    "max_skills": Initialize=32    // max skills supported
}

// =============================================================================
// RULE CACHE
// =============================================================================
FixedPool.TFRuleCache {
    "vec":     Initialize=0    // Pointer to rule vector [DModel]
    "written": Initialize=0    // 0=not stored, 1=rule stored
}