// =============================================================================
// LOSS — respects target_mask (skip prompt positions)
// =============================================================================
Function.TFTrain_Loss {
    Input:  probs:   Integer
    Input:  targets: Integer
    Input:  seqln:   Integer
    Input:  vocab:   Integer
    Output: Integer
    Body: {
        prob_row  = TF_VecAlloc(vocab)
        step_loss = 0
        loss_count = 0
        pos = 0
        WhileLoop LessThan(pos, seqln) {
            lm_val = TF_VecGet(TFState.target_mask, pos)
            IfCondition EqualTo(lm_val, 1) ThenBlock: {
                col = 0
                WhileLoop LessThan(col, vocab) {
                    TF_VecSet(prob_row, col, TF_MatGet(probs, pos, col, vocab))
                    col = Add(col, 1)
                }
                tgt  = TF_VecGet(targets, pos)
                loss = TFAct_CrossEntropy(prob_row, tgt)
                step_loss = Add(step_loss, loss)
                loss_count = Add(loss_count, 1)
            }
            pos = Add(pos, 1)
        }
        IfCondition EqualTo(loss_count, 0) ThenBlock: { loss_count = 1 }
        avg = Divide(step_loss, loss_count)
        TF_VecFree(prob_row, vocab)
        ReturnValue(avg)
    }
}

SubRoutine.ATTN_Train {
    trn_max_steps = 40000
    trn_log_every = TFConfig.LogEvery
    trn_seqln     = TFConfig.SeqLen
    trn_vocab     = TFConfig.VocabSize

    PrintMessage("TRAINING...\n")

    trn_step = 0
    WhileLoop LessThan(trn_step, trn_max_steps) {

        Debug("step", level=2) {
            PrintMessage("[DBG] step=")
            PrintNumber(trn_step)
            PrintMessage("\n")
        }

        TFRuleCache.written = 0
        ATTN_GenSample()
        ATTN_ConvertWeights()

IfCondition EqualTo(trn_step, 1) ThenBlock: {
    PrintMessage("[DBG] Q8 after convert: Wq[0,0..3]=")
    PrintNumber(TF_MatGet(TFW.Wq, 0, 0, 16))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Wq, 0, 1, 16))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Wq, 0, 2, 16))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Wq, 0, 3, 16))
    PrintMessage("\n")
}


        ATTN_Forward()

        IfCondition EqualTo(trn_step, 0) ThenBlock: {
            PrintMessage("[DBG] --- STEP 0 FORWARD TRACE ---\n")
            PrintMessage("tokens[0]= ")
            PrintNumber(TF_VecGet(TFState.tokens, 0))
            PrintMessage(" targets[0]= ")
            PrintNumber(TF_VecGet(TFState.targets, 0))
            PrintMessage("\n")
            PrintMessage("emb[0,0] = ")
            PrintNumber(TF_MatGet(TFW.emb, 0, 0, 16))
            PrintMessage("  qvec[0,0] = ")
            PrintNumber(TF_MatGet(TFW.qvec, 0, 0, 16))
            PrintMessage("\n")
            PrintMessage("scores[0,0..7] = ")
            PrintNumber(TF_MatGet(TFW.scores, 0, 0, 8))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.scores, 0, 1, 8))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.scores, 0, 2, 8))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.scores, 0, 3, 8))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.scores, 0, 4, 8))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.scores, 0, 5, 8))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.scores, 0, 6, 8))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.scores, 0, 7, 8))
            PrintMessage("\n")
            PrintMessage("attn[0,0..7] = ")
            PrintNumber(TF_MatGet(TFW.attn, 0, 0, 8))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.attn, 0, 1, 8))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.attn, 0, 2, 8))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.attn, 0, 3, 8))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.attn, 0, 4, 8))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.attn, 0, 5, 8))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.attn, 0, 6, 8))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.attn, 0, 7, 8))
            PrintMessage("\n")
            PrintMessage("resid[0,0..3] = ")
            PrintNumber(TF_MatGet(TFW.resid, 0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.resid, 0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.resid, 0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.resid, 0, 3, 16))
            PrintMessage("\n")
            PrintMessage("Wout[0,0..3] = ")
            PrintNumber(TF_MatGet(TFW.Wout, 0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 0, 3, 16))
            PrintMessage("\n")
            PrintMessage("Wout[1,0..3] = ")
            PrintNumber(TF_MatGet(TFW.Wout, 1, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 1, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 1, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 1, 3, 16))
            PrintMessage("\n")
            PrintMessage("Wq[0,0..3] = ")
            PrintNumber(TF_MatGet(TFW.Wq, 0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wq, 0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wq, 0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wq, 0, 3, 16))
            PrintMessage("\n")
            PrintMessage("Embed[0,0..3] = ")
            PrintNumber(TF_MatGet(TFW.Embed, 0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Embed, 0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Embed, 0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Embed, 0, 3, 16))
            PrintMessage("\n")
            PrintMessage("Wout[5,0..3] = ")
            PrintNumber(TF_MatGet(TFW.Wout, 5, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 5, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 5, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 5, 3, 16))
            PrintMessage("\n")
            PrintMessage("logits[0,0..4] = ")
            PrintNumber(TF_MatGet(TFW.logits, 0, 0, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.logits, 0, 1, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.logits, 0, 2, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.logits, 0, 3, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.logits, 0, 4, 10))
            PrintMessage("\n")
            PrintMessage("probs[0,0..4] = ")
            PrintNumber(TF_MatGet(TFW.probs, 0, 0, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.probs, 0, 1, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.probs, 0, 2, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.probs, 0, 3, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.probs, 0, 4, 10))
            PrintMessage("\n")
        }

        trn_loss = TFTrain_Loss(TFW.probs, TFState.targets, trn_seqln, trn_vocab)

        // Custom Accuracy Tracker that ignores the Target Mask
        trn_correct = 0
        trn_active  = 0
        trn_pos = 0
        WhileLoop LessThan(trn_pos, trn_seqln) {
            mask_val = TF_VecGet(TFState.target_mask, trn_pos)
            IfCondition EqualTo(mask_val, 1) ThenBlock: {
                trn_active = Add(trn_active, 1)
                best_col = 0
                best_val = -999999
                col = 0
                WhileLoop LessThan(col, trn_vocab) {
                    pval = TF_MatGet(TFW.probs, trn_pos, col, trn_vocab)
                    IfCondition GreaterThan(pval, best_val) ThenBlock: {
                        best_val = pval
                        best_col = col
                    }
                    col = Add(col, 1)
                }
                tgt = TF_VecGet(TFState.targets, trn_pos)
                IfCondition EqualTo(best_col, tgt) ThenBlock: {
                    trn_correct = Add(trn_correct, 1)
                }
            }
            trn_pos = Add(trn_pos, 1)
        }

        TFState.loss_acc = Add(TFState.loss_acc, trn_loss)
        TFState.acc_num  = Add(TFState.acc_num, trn_correct)
        TFState.acc_den  = Add(TFState.acc_den, trn_active)

        ATTN_ZeroGrads()
        ATTN_Backward()

        IfCondition EqualTo(trn_step, 0) ThenBlock: {
            PrintMessage("[DBG] --- STEP 0 GRADIENT TRACE ---\n")
            PrintMessage("dLogits[0,0] = ")
            PrintNumber(TF_MatGet(TFW.dLogits, 0, 0, 10))
            PrintMessage("  dLogits[0,tgt] = ")
            PrintNumber(TF_MatGet(TFW.dLogits, 0, TF_VecGet(TFState.targets, 0), 10))
            PrintMessage("\n")
            PrintMessage("dResid[0,0] = ")
            PrintNumber(TF_MatGet(TFW.dResid, 0, 0, 16))
            PrintMessage("  dCtx[0,0] = ")
            PrintNumber(TF_MatGet(TFW.dCtx, 0, 0, 16))
            PrintMessage("\n")
            PrintMessage("dScores[0,0] = ")
            PrintNumber(TF_MatGet(TFW.dScores, 0, 0, 8))
            PrintMessage("  dScores[0,1] = ")
            PrintNumber(TF_MatGet(TFW.dScores, 0, 1, 8))
            PrintMessage("\n")
            PrintMessage("dQ[0,0] = ")
            PrintNumber(TF_MatGet(TFW.dQ, 0, 0, 16))
            PrintMessage("  dK[0,0] = ")
            PrintNumber(TF_MatGet(TFW.dK, 0, 0, 16))
            PrintMessage("\n")
            PrintMessage("dWq[0,0] = ")
            PrintNumber(TF_MatGet(TFW.dWq, 0, 0, 16))
            PrintMessage("  dWout[0,0] = ")
            PrintNumber(TF_MatGet(TFW.dWout, 0, 0, 16))
            PrintMessage("\n")
            PrintMessage("Wq[0,0] before = ")
            PrintNumber(TF_MatGet(TFW.Wq, 0, 0, 16))
            PrintMessage("\n")
        }

        IfCondition EqualTo(trn_step, 1) ThenBlock: {
            PrintMessage("[DBG] STEP 1 FWD:\n")
            PrintMessage("  emb[0,0..3]=")
            PrintNumber(TF_MatGet(TFW.emb, 0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.emb, 0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.emb, 0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.emb, 0, 3, 16))
            PrintMessage("\n")
            PrintMessage("  ctx[0,0..3]=")
            PrintNumber(TF_MatGet(TFW.ctx, 0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.ctx, 0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.ctx, 0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.ctx, 0, 3, 16))
            PrintMessage("\n")
            PrintMessage("  resid[0,0..3]=")
            PrintNumber(TF_MatGet(TFW.resid, 0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.resid, 0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.resid, 0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.resid, 0, 3, 16))
            PrintMessage("\n")
            PrintMessage("  Embed[0,0..3]=")
            PrintNumber(TF_MatGet(TFW.Embed, 0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Embed, 0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Embed, 0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Embed, 0, 3, 16))
            PrintMessage("\n")
            PrintMessage("  PosEmb[0,0..3]=")
            PrintNumber(TF_MatGet(TFW.PosEmb, 0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.PosEmb, 0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.PosEmb, 0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.PosEmb, 0, 3, 16))
            PrintMessage("\n")
        }

        IfCondition EqualTo(trn_step, 1) ThenBlock: {
            PrintMessage("[DBG] STEP 1 BWD: dLogits[0,0..3]=")
            PrintNumber(TF_MatGet(TFW.dLogits, 0, 0, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.dLogits, 0, 1, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.dLogits, 0, 2, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.dLogits, 0, 3, 10))
            PrintMessage("\n")
            PrintMessage("         dWout[0,0]=")
            PrintNumber(TF_MatGet(TFW.dWout, 0, 0, 16))
            PrintMessage("\n")
        }

        IfCondition EqualTo(trn_step, 0) ThenBlock: {
            dbg_tgt0 = TF_VecGet(TFState.targets, 0)
            PrintMessage("[DBG] PRE-SGD target=")
            PrintNumber(dbg_tgt0)
            PrintMessage("\n")
            PrintMessage("  Wout[tgt,0..3] = ")
            PrintNumber(TF_MatGet(TFW.Wout, dbg_tgt0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, dbg_tgt0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, dbg_tgt0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, dbg_tgt0, 3, 16))
            PrintMessage("\n")
            PrintMessage("  dWout[tgt,0..3] = ")
            PrintNumber(TF_MatGet(TFW.dWout, dbg_tgt0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.dWout, dbg_tgt0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.dWout, dbg_tgt0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.dWout, dbg_tgt0, 3, 16))
            PrintMessage("\n")
            PrintMessage("  dWout[0,0..3] = ")
            PrintNumber(TF_MatGet(TFW.dWout, 0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.dWout, 0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.dWout, 0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.dWout, 0, 3, 16))
            PrintMessage("\n")
            PrintMessage("  dLogits[0,tgt] = ")
            PrintNumber(TF_MatGet(TFW.dLogits, 0, dbg_tgt0, 10))
            PrintMessage("  dLogits[0,0] = ")
            PrintNumber(TF_MatGet(TFW.dLogits, 0, 0, 10))
            PrintMessage("\n")
            PrintMessage("  resid[0,0..3] = ")
            PrintNumber(TF_MatGet(TFW.resid, 0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.resid, 0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.resid, 0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.resid, 0, 3, 16))
            PrintMessage("\n")
        }

        ATTN_SGDUpdate()

        IfCondition EqualTo(trn_step, 0) ThenBlock: {
            PrintMessage("[DBG] POST-SGD\n")
            PrintMessage("  Wout[tgt,0..3] = ")
            PrintNumber(TF_MatGet(TFW.Wout, dbg_tgt0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, dbg_tgt0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, dbg_tgt0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, dbg_tgt0, 3, 16))
            PrintMessage("\n")
            PrintMessage("  Wout[0,0..3] = ")
            PrintNumber(TF_MatGet(TFW.Wout, 0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 0, 3, 16))
            PrintMessage("\n")
            PrintMessage("  Wq[0,0..3] = ")
            PrintNumber(TF_MatGet(TFW.Wq, 0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wq, 0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wq, 0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wq, 0, 3, 16))
            PrintMessage("\n")
        }

        trn_step = Add(trn_step, 1)

        // Logging
        trn_log_due = EqualTo(Modulo(trn_step, trn_log_every), 0)
        IfCondition EqualTo(trn_log_due, 1) ThenBlock: {
            trn_avg_loss = Divide(TFState.loss_acc, trn_log_every)
            trn_acc_pct  = 0
            IfCondition GreaterThan(TFState.acc_den, 0) ThenBlock: {
                trn_acc_pct = Divide(Multiply(TFState.acc_num, 100), TFState.acc_den)
            }

            // =============================================================
            // KEYBOARD INTERRUPT (E=Exit/Save, R=Retrain)
            // =============================================================
            // Set stdin to non-blocking (fcntl(0, F_SETFL, O_NONBLOCK))
            SystemCall(72, 0, 4, 2048)
            term_buf = Allocate(8)
            term_read = SystemCall(0, 0, term_buf, 1)
            IfCondition GreaterThan(term_read, 0) ThenBlock: {
                term_char = GetByte(term_buf, 0)
                
                // Drain rest of input (e.g. the Enter key)
                drain_read = 1
                WhileLoop GreaterThan(drain_read, 0) {
                    drain_read = SystemCall(0, 0, term_buf, 1)
                }
                
                // 'E' (69) or 'e' (101) -> Exit and Save
                IfCondition EqualTo(term_char, 101) ThenBlock: { term_char = 69 }
                IfCondition EqualTo(term_char, 69) ThenBlock: {
                    PrintMessage("\n[KEYBOARD] 'E' pressed: Saving model and advancing...\n")
                    trn_acc_pct = 100
                    TFState.converge_count = 5
                }
                
                // 'R' (82) or 'r' (114) -> Reset and Retrain
                IfCondition EqualTo(term_char, 114) ThenBlock: { term_char = 82 }
                IfCondition EqualTo(term_char, 82) ThenBlock: {
                    PrintMessage("\n[KEYBOARD] 'R' pressed: Manual reset! Re-rolling weights...\n")
                    TFRand.seed = Add(TFRand.seed, trn_step)
                    TF_MatRandInit(TFW.W1, TFConfig.DModel, TFConfig.DFF, 2)
                    TF_MatRandInit(TFW.W2, TFConfig.DFF, TFConfig.DModel, 2)
                    TF_MatRandInit(TFW.Embed, TFConfig.VocabSize, TFConfig.DModel, 2)
                    TF_MatRandInit(TFW.PosEmb, TFConfig.SeqLen, TFConfig.DModel, 2)
                    TF_MatRandInit(TFW.Wq, TFConfig.DModel, TFConfig.DModel, 2)
                    TF_MatRandInit(TFW.Wk, TFConfig.DModel, TFConfig.DModel, 2)
                    TF_MatRandInit(TFW.Wv, TFConfig.DModel, TFConfig.DModel, 2)
                    TF_MatRandInit(TFW.Wout, TFConfig.VocabSize, TFConfig.DModel, 2)
                    
                    TF_IntToFloat(TFWf.W1, TFW.W1, Multiply(TFConfig.DModel, TFConfig.DFF))
                    TF_IntToFloat(TFWf.W2, TFW.W2, Multiply(TFConfig.DFF, TFConfig.DModel))
                    TF_IntToFloat(TFWf.Embed, TFW.Embed, Multiply(TFConfig.VocabSize, TFConfig.DModel))
                    TF_IntToFloat(TFWf.PosEmb, TFW.PosEmb, Multiply(TFConfig.SeqLen, TFConfig.DModel))
                    TF_IntToFloat(TFWf.Wq, TFW.Wq, Multiply(TFConfig.DModel, TFConfig.DModel))
                    TF_IntToFloat(TFWf.Wk, TFW.Wk, Multiply(TFConfig.DModel, TFConfig.DModel))
                    TF_IntToFloat(TFWf.Wv, TFW.Wv, Multiply(TFConfig.DModel, TFConfig.DModel))
                    TF_IntToFloat(TFWf.Wout, TFW.Wout, Multiply(TFConfig.VocabSize, TFConfig.DModel))
                    
                    TF_MatZero(TFW.Wr, TFConfig.DModel, TFConfig.DModel)
                    TF_IntToFloat(TFWf.Wr, TFW.Wr, Multiply(TFConfig.DModel, TFConfig.DModel))
                    
                    TFState.lr_multiplier = 100
                    TFState.stuck_count = 0
                    trn_step = 0
                    trn_acc_pct = 0
                }
            }
            Deallocate(term_buf, 8)
            // Restore stdin to blocking (fcntl(0, F_SETFL, 0))
            SystemCall(72, 0, 4, 0)




            // =============================================================
            // STUCK DETECTION & LR BOOST
            // =============================================================
            IfCondition LessThan(trn_acc_pct, 20) ThenBlock: {
                TFState.stuck_count = Add(TFState.stuck_count, 1)
            } ElseBlock: {
                TFState.stuck_count = 0
            }

            IfCondition GreaterEqual(TFState.stuck_count, 10) ThenBlock: {
                IfCondition LessThan(TFState.lr_multiplier, 1000) ThenBlock: {
                    TFState.lr_multiplier = Multiply(TFState.lr_multiplier, 2)
                    PrintMessage("[STUCK] Boosting LR! Multiplier increased to ")
                    PrintNumber(TFState.lr_multiplier)
                    PrintMessage("\n")
                }
                TFState.stuck_count = 0
            }

            // =============================================================
            // PROGRESSIVE LR ROLLOFF
            // =============================================================
            lr_new = TFState.lr_multiplier
            IfCondition GreaterEqual(trn_acc_pct, 40) ThenBlock: { lr_new = 90 }
            IfCondition GreaterEqual(trn_acc_pct, 50) ThenBlock: { lr_new = 85 }
            IfCondition GreaterEqual(trn_acc_pct, 60) ThenBlock: { lr_new = 80 }
            IfCondition GreaterEqual(trn_acc_pct, 65) ThenBlock: { lr_new = 75 }
            IfCondition GreaterEqual(trn_acc_pct, 70) ThenBlock: { lr_new = 70 }
            IfCondition GreaterEqual(trn_acc_pct, 75) ThenBlock: { lr_new = 65 }
            IfCondition GreaterEqual(trn_acc_pct, 80) ThenBlock: { lr_new = 60 }
            IfCondition GreaterEqual(trn_acc_pct, 85) ThenBlock: { lr_new = 55 }
            IfCondition GreaterEqual(trn_acc_pct, 90) ThenBlock: { lr_new = 50 }

            IfCondition LessThan(lr_new, TFState.lr_multiplier) ThenBlock: {
                TFState.lr_multiplier = lr_new
                PrintMessage("[LR ROLLOFF] ACC=")
                PrintNumber(trn_acc_pct)
                PrintMessage("% -> LR at ")
                PrintNumber(lr_new)
                PrintMessage("%\n")
            }

            // Early stopping
            IfCondition GreaterEqual(trn_acc_pct, 90) ThenBlock: {
                TFState.converge_count = Add(TFState.converge_count, 1)
            }
            IfCondition LessThan(trn_acc_pct, 90) ThenBlock: {
                TFState.converge_count = 0
            }
            IfCondition GreaterEqual(TFState.converge_count, 5) ThenBlock: {
                PrintMessage("\nCONVERGED at step ")
                PrintNumber(trn_step)
                PrintMessage(" (5 consecutive windows >= target)\n")

                // Save trained weights
                PrintMessage("[SAVE] Writing skill file...\n")
                IfCondition GreaterThan(TFState.SigCount, 0) ThenBlock: {
                    sig_i = 0
                    WhileLoop LessThan(sig_i, 32) {
                        sig_val = TF_VecGet(TFState.Signature, sig_i)
                        TF_VecSet(TFState.Signature, sig_i, Divide(sig_val, TFState.SigCount))
                        sig_i = Add(sig_i, 1)
                    }
                    TFState.SigCount = 0
                }

                save_fd = SystemCall(2, TFState.SkillPath, 577, 420)
                IfCondition LessThan(save_fd, 0) ThenBlock: {
                    PrintMessage("\n[ERROR] Failed to save! Does the 'skills/' directory exist?\n\n")
                } ElseBlock: {
                    TF_WriteSkillHeader(save_fd, TFState.Signature, 1)
                    TF_WriteBuffer(save_fd, TFWf.Embed,  Multiply(TFConfig.VocabSize, TFConfig.DModel))
                    TF_WriteBuffer(save_fd, TFWf.PosEmb, Multiply(TFConfig.SeqLen, TFConfig.DModel))
                    TF_WriteBuffer(save_fd, TFWf.Wq,     Multiply(TFConfig.DModel, TFConfig.DModel))
                    TF_WriteBuffer(save_fd, TFWf.Wk,     Multiply(TFConfig.DModel, TFConfig.DModel))
                    TF_WriteBuffer(save_fd, TFWf.Wv,     Multiply(TFConfig.DModel, TFConfig.DModel))
                    TF_WriteBuffer(save_fd, TFWf.W1,     Multiply(TFConfig.DModel, TFConfig.DFF))
                    TF_WriteBuffer(save_fd, TFWf.W2,     Multiply(TFConfig.DFF, TFConfig.DModel))
                    TF_WriteBuffer(save_fd, TFWf.Wout,   Multiply(TFConfig.VocabSize, TFConfig.DModel))
                    IfCondition EqualTo(SkillInfo.HasRC, 1) ThenBlock: {
                        TF_WriteBuffer(save_fd, TFWf.Wr, Multiply(TFConfig.DModel, TFConfig.DModel))
                    }
                    SystemCall(3, save_fd)
                    PrintMessage("[SAVE] Done\n")
                    PrintMessage("[VERIFY] In-memory counter test: 0 1 2 3 => ")
TF_VecSet(TFState.tokens, 0, 0)
TF_VecSet(TFState.tokens, 1, 1)
TF_VecSet(TFState.tokens, 2, 2)
TF_VecSet(TFState.tokens, 3, 3)
vr_pad = 4
WhileLoop LessThan(vr_pad, TFConfig.SeqLen) {
    TF_VecSet(TFState.tokens, vr_pad, 0)
    vr_pad = Add(vr_pad, 1)
}
TFRuleCache.written = 0
ATTN_ConvertWeights()
ATTN_Forward()
vr_best = 0
vr_bval = TF_MatGet(TFW.logits, 3, 0, TFConfig.VocabSize)
vr_c = 1
WhileLoop LessThan(vr_c, TFConfig.VocabSize) {
    vr_v = TF_MatGet(TFW.logits, 3, vr_c, TFConfig.VocabSize)
    IfCondition GreaterThan(vr_v, vr_bval) ThenBlock: {
        vr_bval = vr_v
        vr_best = vr_c
    }
    vr_c = Add(vr_c, 1)
}
PrintNumber(vr_best)
PrintMessage(" (should be 4)\n")
                }

                trn_step = trn_max_steps
            }
            
            trn_loss_int   = Divide(trn_avg_loss, 4096)
            trn_loss_frac  = Modulo(trn_avg_loss, 4096)
            trn_loss_frac4 = Divide(Multiply(trn_loss_frac, 10000), 4096)
            PrintMessage(" STEP ")
            PrintNumber(trn_step)
            PrintMessage("  LOSS=")
            PrintNumber(trn_loss_int)
            PrintMessage(".")
            IfCondition LessThan(trn_loss_frac4, 1000) ThenBlock: { PrintMessage("0") }
            IfCondition LessThan(trn_loss_frac4, 100)  ThenBlock: { PrintMessage("0") }
            IfCondition LessThan(trn_loss_frac4, 10)   ThenBlock: { PrintMessage("0") }
            PrintNumber(trn_loss_frac4)
            PrintMessage("  ACC=0.")
            IfCondition LessThan(trn_acc_pct, 10) ThenBlock: { PrintMessage("0") }
            PrintNumber(trn_acc_pct)
            PrintMessage("\n")
            TFState.loss_acc = 0
            TFState.acc_num  = 0
            TFState.acc_den  = 0
        }

        TFState.step = trn_step
    }
    PrintMessage("\n")
}