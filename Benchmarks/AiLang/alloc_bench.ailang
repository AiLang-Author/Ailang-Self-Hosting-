// =============================================================================
// AILANG Comprehensive Performance Benchmark Suite
// With DebugPerf instrumentation for RDTSC cycle-accurate profiling
// Compile with: ./compiler.x -P bench_suite.ailang bench_suite.x
// =============================================================================

LibraryImport.Arena

// =============================================================================
// TEST 1: Prime Sieve
// =============================================================================
Function.Bench_Primes {
    Output: Integer
    Body: {
        DebugPerf.Start("primes_total")
        limit = 1000000
        count = 0
        n = 2
        WhileLoop LessThan(n, limit) {
            DebugPerf.Start("primes_inner")
            is_prime = 1
            i = 2
            WhileLoop LessThan(Multiply(i, i), Add(n, 1)) {
                IfCondition EqualTo(Modulo(n, i), 0) ThenBlock: {
                    is_prime = 0
                }
                i = Add(i, 1)
            }
            IfCondition EqualTo(is_prime, 1) ThenBlock: {
                count = Add(count, 1)
            }
            DebugPerf.End("primes_inner")
            n = Add(n, 1)
        }
        DebugPerf.End("primes_total")
        ReturnValue(count)
    }
}

// =============================================================================
// TEST 2: Integer Arithmetic Stress
// =============================================================================
Function.Bench_Arithmetic {
    Output: Integer
    Body: {
        DebugPerf.Start("arithmetic")
        result = 0
        i = 1
        WhileLoop LessThan(i, 10000000) {
            a = Multiply(i, 31337)
            b = Modulo(a, 99991)
            c = BitwiseXor(b, LeftShift(i, 3))
            d = BitwiseAnd(c, 0xFFFF)
            result = BitwiseXor(result, Add(d, i))
            i = Add(i, 1)
        }
        DebugPerf.End("arithmetic")
        ReturnValue(result)
    }
}

// =============================================================================
// TEST 3: Memory Sequential
// =============================================================================
Function.Bench_MemSequential {
    Output: Integer
    Body: {
        DebugPerf.Start("mem_seq_total")
        size = 10000000
        buf = Allocate(Multiply(size, 8))

        DebugPerf.Start("mem_seq_write")
        i = 0
        WhileLoop LessThan(i, size) {
            off = Multiply(i, 8)
            StoreValue(Add(buf, off), Multiply(i, 7))
            i = Add(i, 1)
        }
        DebugPerf.End("mem_seq_write")

        DebugPerf.Start("mem_seq_read")
        sum = 0
        i = 0
        WhileLoop LessThan(i, size) {
            off = Multiply(i, 8)
            val = Dereference(Add(buf, off))
            sum = Add(sum, val)
            i = Add(i, 1)
        }
        DebugPerf.End("mem_seq_read")

        Deallocate(buf, Multiply(size, 8))
        DebugPerf.End("mem_seq_total")
        ReturnValue(sum)
    }
}

// =============================================================================
// TEST 4: Memory Random
// =============================================================================
Function.Bench_MemRandom {
    Output: Integer
    Body: {
        DebugPerf.Start("mem_random_total")
        size = 1000000
        buf = Allocate(Multiply(size, 8))

        DebugPerf.Start("mem_random_fill")
        i = 0
        WhileLoop LessThan(i, size) {
            off = Multiply(i, 8)
            StoreValue(Add(buf, off), i)
            i = Add(i, 1)
        }
        DebugPerf.End("mem_random_fill")

        DebugPerf.Start("mem_random_read")
        sum = 0
        i = 0
        WhileLoop LessThan(i, size) {
            idx = Modulo(Multiply(i, 1000003), size)
            off = Multiply(idx, 8)
            val = Dereference(Add(buf, off))
            sum = Add(sum, val)
            i = Add(i, 1)
        }
        DebugPerf.End("mem_random_read")

        Deallocate(buf, Multiply(size, 8))
        DebugPerf.End("mem_random_total")
        ReturnValue(sum)
    }
}

// =============================================================================
// TEST 5: Recursive Fibonacci
// =============================================================================
Function.Fib {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 2) ThenBlock: {
            ReturnValue(n)
        }
        a = Fib(Subtract(n, 1))
        b = Fib(Subtract(n, 2))
        ReturnValue(Add(a, b))
    }
}

Function.Bench_Fibonacci {
    Output: Integer
    Body: {
        DebugPerf.Start("fibonacci")
        result = 0
        i = 0
        WhileLoop LessThan(i, 10) {
            result = Add(result, Fib(35))
            i = Add(i, 1)
        }
        DebugPerf.End("fibonacci")
        ReturnValue(result)
    }
}

// =============================================================================
// TEST 6: String Operations
// =============================================================================
Function.Bench_Strings {
    Output: Integer
    Body: {
        DebugPerf.Start("strings_total")
        count = 0
        i = 0
        WhileLoop LessThan(i, 100000) {
            DebugPerf.Start("strings_concat")
            s1 = StringConcat("Hello", " World")
            DebugPerf.End("strings_concat")

            DebugPerf.Start("strings_upper")
            s2 = StringToUpper(s1)
            DebugPerf.End("strings_upper")

            DebugPerf.Start("strings_length")
            l = StringLength(s2)
            DebugPerf.End("strings_length")

            IfCondition EqualTo(l, 11) ThenBlock: {
                count = Add(count, 1)
            }
            i = Add(i, 1)
        }
        DebugPerf.End("strings_total")
        ReturnValue(count)
    }
}

// =============================================================================
// TEST 7: Bubble Sort
// =============================================================================
Function.Bench_BubbleSort {
    Output: Integer
    Body: {
        DebugPerf.Start("bubblesort_total")
        size = 10000
        buf = Allocate(Multiply(size, 8))

        DebugPerf.Start("bubblesort_fill")
        i = 0
        WhileLoop LessThan(i, size) {
            off = Multiply(i, 8)
            StoreValue(Add(buf, off), Subtract(size, i))
            i = Add(i, 1)
        }
        DebugPerf.End("bubblesort_fill")

        DebugPerf.Start("bubblesort_sort")
        i = 0
        WhileLoop LessThan(i, size) {
            j = 0
            WhileLoop LessThan(j, Subtract(Subtract(size, i), 1)) {
                off_j  = Multiply(j, 8)
                off_j1 = Multiply(Add(j, 1), 8)
                a = Dereference(Add(buf, off_j))
                b = Dereference(Add(buf, off_j1))
                IfCondition GreaterThan(a, b) ThenBlock: {
                    StoreValue(Add(buf, off_j),  b)
                    StoreValue(Add(buf, off_j1), a)
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        DebugPerf.End("bubblesort_sort")

        DebugPerf.Start("bubblesort_sum")
        sum = 0
        i = 0
        WhileLoop LessThan(i, size) {
            off = Multiply(i, 8)
            sum = Add(sum, Dereference(Add(buf, off)))
            i = Add(i, 1)
        }
        DebugPerf.End("bubblesort_sum")

        Deallocate(buf, Multiply(size, 8))
        DebugPerf.End("bubblesort_total")
        ReturnValue(sum)
    }
}

// =============================================================================
// TEST 8: Matrix Multiply
// =============================================================================
Function.Bench_MatrixMultiply {
    Output: Integer
    Body: {
        DebugPerf.Start("matmul_total")
        N = 64
        sz = Multiply(N, N)
        bytes = Multiply(sz, 8)

        a = Allocate(bytes)
        b = Allocate(bytes)
        c = Allocate(bytes)

        DebugPerf.Start("matmul_fill")
        i = 0
        WhileLoop LessThan(i, sz) {
            off = Multiply(i, 8)
            StoreValue(Add(a, off), Add(i, 1))
            StoreValue(Add(b, off), Subtract(sz, i))
            StoreValue(Add(c, off), 0)
            i = Add(i, 1)
        }
        DebugPerf.End("matmul_fill")

        DebugPerf.Start("matmul_compute")
        row = 0
        WhileLoop LessThan(row, N) {
            col = 0
            WhileLoop LessThan(col, N) {
                sum = 0
                k = 0
                WhileLoop LessThan(k, N) {
                    a_off = Multiply(Add(Multiply(row, N), k), 8)
                    b_off = Multiply(Add(Multiply(k, N), col), 8)
                    av = Dereference(Add(a, a_off))
                    bv = Dereference(Add(b, b_off))
                    sum = Add(sum, Multiply(av, bv))
                    k = Add(k, 1)
                }
                c_off = Multiply(Add(Multiply(row, N), col), 8)
                StoreValue(Add(c, c_off), sum)
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }
        DebugPerf.End("matmul_compute")

        DebugPerf.Start("matmul_sum")
        total = 0
        i = 0
        WhileLoop LessThan(i, sz) {
            off = Multiply(i, 8)
            total = Add(total, Dereference(Add(c, off)))
            i = Add(i, 1)
        }
        DebugPerf.End("matmul_sum")

        Deallocate(a, bytes)
        Deallocate(b, bytes)
        Deallocate(c, bytes)
        DebugPerf.End("matmul_total")
        ReturnValue(total)
    }
}

// =============================================================================
// TEST 9: Allocation Speed
// =============================================================================
Function.Bench_Allocation {
    Body: {
        DebugPerf.Start("alloc_sequential")
        i = 0
        last = 0
        WhileLoop LessThan(i, 10000000) {
            ptr = Allocate(64)
            SetByte(ptr, 0, 1)
            last = ptr
            i = Add(i, 1)
        }
        DebugPerf.End("alloc_sequential")

        DebugPerf.Start("alloc_free_cycle")
        i = 0
        WhileLoop LessThan(i, 10000000) {
            ptr = Allocate(64)
            SetByte(ptr, 0, 1)
            Deallocate(ptr, 64)
            i = Add(i, 1)
        }
        DebugPerf.End("alloc_free_cycle")

        DebugPerf.Start("alloc_mixed_sizes")
        i = 0
        WhileLoop LessThan(i, 10000000) {
            mod = Modulo(i, 3)
            IfCondition EqualTo(mod, 0) ThenBlock: {
                ptr = Allocate(64)
                SetByte(ptr, 0, 1)
                Deallocate(ptr, 64)
            }
            IfCondition EqualTo(mod, 1) ThenBlock: {
                ptr = Allocate(128)
                SetByte(ptr, 0, 1)
                Deallocate(ptr, 128)
            }
            IfCondition EqualTo(mod, 2) ThenBlock: {
                ptr = Allocate(256)
                SetByte(ptr, 0, 1)
                Deallocate(ptr, 256)
            }
            i = Add(i, 1)
        }
        DebugPerf.End("alloc_mixed_sizes")
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    PrintMessage("=== AILANG Benchmark Suite + RDTSC Profiling ===\n")
    PrintMessage("Compile with -P flag for cycle counts\n\n")

    PrintMessage("1. Prime Sieve (1M)... ")
    r1 = Bench_Primes()
    PrintMessage("Primes: ")
    PrintNumber(r1)
    PrintMessage("\n")

    PrintMessage("2. Integer Arithmetic (10M)... ")
    r2 = Bench_Arithmetic()
    PrintMessage("Result: ")
    PrintNumber(r2)
    PrintMessage("\n")

    PrintMessage("3. Memory Sequential (10M)... ")
    r3 = Bench_MemSequential()
    PrintMessage("Sum: ")
    PrintNumber(r3)
    PrintMessage("\n")

    PrintMessage("4. Memory Random (1M)... ")
    r4 = Bench_MemRandom()
    PrintMessage("Sum: ")
    PrintNumber(r4)
    PrintMessage("\n")

    PrintMessage("5. Fibonacci Fib(35)x10... ")
    r5 = Bench_Fibonacci()
    PrintMessage("Result: ")
    PrintNumber(r5)
    PrintMessage("\n")

    PrintMessage("6. String Ops (100K)... ")
    r6 = Bench_Strings()
    PrintMessage("Count: ")
    PrintNumber(r6)
    PrintMessage("\n")

    PrintMessage("7. Bubble Sort (10K)... ")
    r7 = Bench_BubbleSort()
    PrintMessage("Sum: ")
    PrintNumber(r7)
    PrintMessage("\n")

    PrintMessage("8. Matrix Multiply (64x64)... ")
    r8 = Bench_MatrixMultiply()
    PrintMessage("Checksum: ")
    PrintNumber(r8)
    PrintMessage("\n")

    PrintMessage("9. Allocation Speed (10M each)...\n")
    Bench_Allocation()

    PrintMessage("\n=== Complete ===\n")
}

RunTask(Main)