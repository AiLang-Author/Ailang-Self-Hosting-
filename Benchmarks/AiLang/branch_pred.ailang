SubRoutine.Main {
    sum = 0
    i = 0
    WhileLoop LessThan(i, 100000000) {
        IfCondition EqualTo(Modulo(i, 2), 0) ThenBlock: {
            sum = Add(sum, 1)
        } ElseBlock: {
            sum = Subtract(sum, 1)
        }
        i = Add(i, 1)
    }
    PrintMessage("Sum: ")
    PrintNumber(sum)
    PrintMessage("\n")
}
RunTask(Main)
