Function.Fib {
    Input: n: Integer
    Output: Integer
    Body: {
        result = 0
        is_base = LessThan(n, 2)
        IfCondition EqualTo(is_base, 1) ThenBlock: {
            result = n
        } ElseBlock: {
            n1 = Subtract(n, 1)
            n2 = Subtract(n, 2)
            a = Fib(n1)
            b = Fib(n2)
            result = Add(a, b)
        }
        ReturnValue(result)
    }
}