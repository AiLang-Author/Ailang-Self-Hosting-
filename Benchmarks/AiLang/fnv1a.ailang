// FNV-1a 64, RFC 9923.
// Offset basis 0xCBF29CE484222325, prime 0x100000001B3.
// hash = (hash xor byte) * prime, wrapping mod 2^64.
// FOOBAR is the published "foobar" vector.
// HASH is one running hash of the buffer repeated 80 times.

LibraryImport.Arena

SubRoutine.Main {
    Arena_Init()
    n = 65536
    passes = 80
    basis = 0xCBF29CE484222325
    prime = 0x100000001B3
    buf = Arena_AllocGeneral(n)
    foo = Arena_AllocGeneral(6)

    SetByte(foo, 0, 102)
    SetByte(foo, 1, 111)
    SetByte(foo, 2, 111)
    SetByte(foo, 3, 98)
    SetByte(foo, 4, 97)
    SetByte(foo, 5, 114)

    fooh = basis
    i = 0
    WhileLoop LessThan(i, 6) {
        b = GetByte(foo, i)
        fooh = BitwiseXor(fooh, b)
        fooh = Multiply(fooh, prime)
        i = Add(i, 1)
    }

    i = 0
    WhileLoop LessThan(i, n) {
        b = BitwiseAnd(Add(Multiply(i, 131), 17), 255)
        SetByte(buf, i, b)
        i = Add(i, 1)
    }

    h = basis
    p = 0
    WhileLoop LessThan(p, passes) {
        i = 0
        WhileLoop LessThan(i, n) {
            b = GetByte(buf, i)
            h = BitwiseXor(h, b)
            h = Multiply(h, prime)
            i = Add(i, 1)
        }
        p = Add(p, 1)
    }

    PrintMessage("FOOBAR ")
    PrintNumber(fooh)
    PrintMessage("\nHASH ")
    PrintNumber(h)
    PrintMessage("\n")
}
RunTask(Main)
