// Scalar mandelbrot, same arithmetic as Greg Buchholz, Benchmarks Game
// gcc #8. N is 512 so a five-run pin fits on this machine. The official
// timing size is 16000. Width is a multiple of 8, so every row emits
// whole bytes. Checksum is the sum and xor of the P4 bitmap bytes.
// Multiplies and adds stay separate so the bits match the C build
// with -ffp-contract=off.

LibraryImport.Arena

SubRoutine.Main {
    Arena_Init()
    n = 512
    iter = 50
    two = Float_FromInt(2)
    one = Float_FromInt(1)
    three = Float_FromInt(3)
    one5 = Float_Div(three, two)
    four = Float_FromInt(4)
    wf = Float_FromInt(n)
    sum = 0
    mix = 0
    nbytes = 0

    y = 0
    WhileLoop LessThan(y, n) {
        yf = Float_FromInt(y)
        two_y = Float_Mul(two, yf)
        ny = Float_Div(two_y, wf)
        ci = Float_Sub(ny, one)
        byte_acc = 0
        bit_num = 0
        x = 0
        WhileLoop LessThan(x, n) {
            xf = Float_FromInt(x)
            two_x = Float_Mul(two, xf)
            nx = Float_Div(two_x, wf)
            cr = Float_Sub(nx, one5)
            zr = 0
            zi = 0
            tr = 0
            ti = 0
            i = 0
            WhileLoop And(LessThan(i, iter), Float_Le(Float_Add(tr, ti), four)) {
                two_zr = Float_Mul(two, zr)
                zi_m = Float_Mul(two_zr, zi)
                zi = Float_Add(zi_m, ci)
                diff = Float_Sub(tr, ti)
                zr = Float_Add(diff, cr)
                tr = Float_Mul(zr, zr)
                ti = Float_Mul(zi, zi)
                i = Add(i, 1)
            }
            byte_acc = LeftShift(byte_acc, 1)
            mag = Float_Add(tr, ti)
            inside = Float_Le(mag, four)
            IfCondition EqualTo(inside, 1) ThenBlock: {
                byte_acc = BitwiseOr(byte_acc, 1)
            }
            bit_num = Add(bit_num, 1)
            IfCondition EqualTo(bit_num, 8) ThenBlock: {
                b = BitwiseAnd(byte_acc, 255)
                sum = Add(sum, b)
                mix = BitwiseXor(mix, b)
                nbytes = Add(nbytes, 1)
                byte_acc = 0
                bit_num = 0
            }
            x = Add(x, 1)
        }
        y = Add(y, 1)
    }

    PrintMessage("SUM ")
    PrintNumber(sum)
    PrintMessage("\nXOR ")
    PrintNumber(mix)
    PrintMessage("\nBYTES ")
    PrintNumber(nbytes)
    PrintMessage("\n")
}
RunTask(Main)
