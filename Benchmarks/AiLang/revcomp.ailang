// In-memory reverse complement.
// Pair table and two-pointer swap are Mr Ledrug's Benchmarks Game gcc #2.
// The pair string is ATCGGCTAUAMKRYWWSSYRKMVBHDDHBVNN followed by two
// newlines. FASTA headers, the 60-column rewrap, threads, and stdin
// are not part of this pin. The buffer is the fasta LCG sequence
// (IA 3877, IC 29573, IM 139968, seed 42) over ATCGUMRWSYKVHDBN.
// 21 passes leave the reverse complement.

LibraryImport.Arena

Function.ToUpper {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(GreaterEqual(c, 97), 1) ThenBlock: {
            IfCondition EqualTo(LessEqual(c, 122), 1) ThenBlock: {
                ReturnValue(Subtract(c, 32))
            }
        }
        ReturnValue(c)
    }
}

Function.ToLower {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(GreaterEqual(c, 65), 1) ThenBlock: {
            IfCondition EqualTo(LessEqual(c, 90), 1) ThenBlock: {
                ReturnValue(Add(c, 32))
            }
        }
        ReturnValue(c)
    }
}

SubRoutine.Main {
    Arena_Init()
    len = 100000
    passes = 21
    tbl = Arena_AllocGeneral(128)
    buf = Arena_AllocGeneral(len)
    pairs = Arena_AllocGeneral(36)
    alpha = Arena_AllocGeneral(16)

    i = 0
    WhileLoop LessThan(i, 128) {
        WRMEM_8(tbl, i, 0)
        i = Add(i, 1)
    }

    // ATCGGCTAUAMKRYWWSSYRKMVBHDDHBVNN \n \n and a trailing NUL.
    WRMEM_8(pairs, 0, 65)
    WRMEM_8(pairs, 1, 84)
    WRMEM_8(pairs, 2, 67)
    WRMEM_8(pairs, 3, 71)
    WRMEM_8(pairs, 4, 71)
    WRMEM_8(pairs, 5, 67)
    WRMEM_8(pairs, 6, 84)
    WRMEM_8(pairs, 7, 65)
    WRMEM_8(pairs, 8, 85)
    WRMEM_8(pairs, 9, 65)
    WRMEM_8(pairs, 10, 77)
    WRMEM_8(pairs, 11, 75)
    WRMEM_8(pairs, 12, 82)
    WRMEM_8(pairs, 13, 89)
    WRMEM_8(pairs, 14, 87)
    WRMEM_8(pairs, 15, 87)
    WRMEM_8(pairs, 16, 83)
    WRMEM_8(pairs, 17, 83)
    WRMEM_8(pairs, 18, 89)
    WRMEM_8(pairs, 19, 82)
    WRMEM_8(pairs, 20, 75)
    WRMEM_8(pairs, 21, 77)
    WRMEM_8(pairs, 22, 86)
    WRMEM_8(pairs, 23, 66)
    WRMEM_8(pairs, 24, 72)
    WRMEM_8(pairs, 25, 68)
    WRMEM_8(pairs, 26, 68)
    WRMEM_8(pairs, 27, 72)
    WRMEM_8(pairs, 28, 66)
    WRMEM_8(pairs, 29, 86)
    WRMEM_8(pairs, 30, 78)
    WRMEM_8(pairs, 31, 78)
    WRMEM_8(pairs, 32, 10)
    WRMEM_8(pairs, 33, 10)
    WRMEM_8(pairs, 34, 0)

    // ATCGUMRWSYKVHDBN
    WRMEM_8(alpha, 0, 65)
    WRMEM_8(alpha, 1, 84)
    WRMEM_8(alpha, 2, 67)
    WRMEM_8(alpha, 3, 71)
    WRMEM_8(alpha, 4, 85)
    WRMEM_8(alpha, 5, 77)
    WRMEM_8(alpha, 6, 82)
    WRMEM_8(alpha, 7, 87)
    WRMEM_8(alpha, 8, 83)
    WRMEM_8(alpha, 9, 89)
    WRMEM_8(alpha, 10, 75)
    WRMEM_8(alpha, 11, 86)
    WRMEM_8(alpha, 12, 72)
    WRMEM_8(alpha, 13, 68)
    WRMEM_8(alpha, 14, 66)
    WRMEM_8(alpha, 15, 78)

    s = 0
    ch = RDMEM_8(pairs, s)
    WhileLoop NotEqual(ch, 0) {
        c1 = RDMEM_8(pairs, Add(s, 1))
        up = ToUpper(ch)
        lo = ToLower(ch)
        WRMEM_8(tbl, up, c1)
        WRMEM_8(tbl, lo, c1)
        s = Add(s, 2)
        ch = RDMEM_8(pairs, s)
    }

    seed = 42
    i = 0
    WhileLoop LessThan(i, len) {
        seed = Modulo(Add(Multiply(seed, 3877), 29573), 139968)
        idx = Modulo(seed, 16)
        b = RDMEM_8(alpha, idx)
        WRMEM_8(buf, i, b)
        i = Add(i, 1)
    }

    p = 0
    WhileLoop LessThan(p, passes) {
        left = 0
        right = Subtract(len, 1)
        WhileLoop LessEqual(left, right) {
            bleft = RDMEM_8(buf, left)
            bright = RDMEM_8(buf, right)
            c = RDMEM_8(tbl, bleft)
            nleft = RDMEM_8(tbl, bright)
            WRMEM_8(buf, left, nleft)
            WRMEM_8(buf, right, c)
            left = Add(left, 1)
            right = Subtract(right, 1)
        }
        p = Add(p, 1)
    }

    sum = 0
    mix = 0
    i = 0
    WhileLoop LessThan(i, len) {
        b = RDMEM_8(buf, i)
        sum = Add(sum, b)
        mix = BitwiseXor(mix, b)
        i = Add(i, 1)
    }

    PrintMessage("SUM ")
    PrintNumber(sum)
    PrintMessage("\nXOR ")
    PrintNumber(mix)
    PrintMessage("\n")
}
RunTask(Main)
