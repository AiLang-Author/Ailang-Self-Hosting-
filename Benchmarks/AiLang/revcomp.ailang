// In-memory reverse complement.
// Pair table and two-pointer swap are Mr Ledrug's Benchmarks Game gcc #2.
// The pair string is ATCGGCTAUAMKRYWWSSYRKMVBHDDHBVNN followed by two
// newlines. FASTA headers, the 60-column rewrap, threads, and stdin
// are not part of this pin. The buffer is the fasta LCG sequence
// (IA 3877, IC 29573, IM 139968, seed 42) over ATCGUMRWSYKVHDBN.
// 21 passes leave the reverse complement.

LibraryImport.Arena

Function.ToUpper {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(GreaterEqual(c, 97), 1) ThenBlock: {
            IfCondition EqualTo(LessEqual(c, 122), 1) ThenBlock: {
                ReturnValue(Subtract(c, 32))
            }
        }
        ReturnValue(c)
    }
}

Function.ToLower {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(GreaterEqual(c, 65), 1) ThenBlock: {
            IfCondition EqualTo(LessEqual(c, 90), 1) ThenBlock: {
                ReturnValue(Add(c, 32))
            }
        }
        ReturnValue(c)
    }
}

SubRoutine.Main {
    Arena_Init()
    len = 100000
    passes = 21
    tbl = Arena_AllocGeneral(128)
    buf = Arena_AllocGeneral(len)
    pairs = Arena_AllocGeneral(36)
    alpha = Arena_AllocGeneral(16)

    i = 0
    WhileLoop LessThan(i, 128) {
        SetByte(tbl, i, 0)
        i = Add(i, 1)
    }

    // ATCGGCTAUAMKRYWWSSYRKMVBHDDHBVNN \n \n and a trailing NUL.
    SetByte(pairs, 0, 65)
    SetByte(pairs, 1, 84)
    SetByte(pairs, 2, 67)
    SetByte(pairs, 3, 71)
    SetByte(pairs, 4, 71)
    SetByte(pairs, 5, 67)
    SetByte(pairs, 6, 84)
    SetByte(pairs, 7, 65)
    SetByte(pairs, 8, 85)
    SetByte(pairs, 9, 65)
    SetByte(pairs, 10, 77)
    SetByte(pairs, 11, 75)
    SetByte(pairs, 12, 82)
    SetByte(pairs, 13, 89)
    SetByte(pairs, 14, 87)
    SetByte(pairs, 15, 87)
    SetByte(pairs, 16, 83)
    SetByte(pairs, 17, 83)
    SetByte(pairs, 18, 89)
    SetByte(pairs, 19, 82)
    SetByte(pairs, 20, 75)
    SetByte(pairs, 21, 77)
    SetByte(pairs, 22, 86)
    SetByte(pairs, 23, 66)
    SetByte(pairs, 24, 72)
    SetByte(pairs, 25, 68)
    SetByte(pairs, 26, 68)
    SetByte(pairs, 27, 72)
    SetByte(pairs, 28, 66)
    SetByte(pairs, 29, 86)
    SetByte(pairs, 30, 78)
    SetByte(pairs, 31, 78)
    SetByte(pairs, 32, 10)
    SetByte(pairs, 33, 10)
    SetByte(pairs, 34, 0)

    // ATCGUMRWSYKVHDBN
    SetByte(alpha, 0, 65)
    SetByte(alpha, 1, 84)
    SetByte(alpha, 2, 67)
    SetByte(alpha, 3, 71)
    SetByte(alpha, 4, 85)
    SetByte(alpha, 5, 77)
    SetByte(alpha, 6, 82)
    SetByte(alpha, 7, 87)
    SetByte(alpha, 8, 83)
    SetByte(alpha, 9, 89)
    SetByte(alpha, 10, 75)
    SetByte(alpha, 11, 86)
    SetByte(alpha, 12, 72)
    SetByte(alpha, 13, 68)
    SetByte(alpha, 14, 66)
    SetByte(alpha, 15, 78)

    s = 0
    ch = GetByte(pairs, s)
    WhileLoop NotEqual(ch, 0) {
        c1 = GetByte(pairs, Add(s, 1))
        up = ToUpper(ch)
        lo = ToLower(ch)
        SetByte(tbl, up, c1)
        SetByte(tbl, lo, c1)
        s = Add(s, 2)
        ch = GetByte(pairs, s)
    }

    seed = 42
    i = 0
    WhileLoop LessThan(i, len) {
        seed = Modulo(Add(Multiply(seed, 3877), 29573), 139968)
        idx = Modulo(seed, 16)
        b = GetByte(alpha, idx)
        SetByte(buf, i, b)
        i = Add(i, 1)
    }

    p = 0
    WhileLoop LessThan(p, passes) {
        left = 0
        right = Subtract(len, 1)
        WhileLoop LessEqual(left, right) {
            bleft = GetByte(buf, left)
            bright = GetByte(buf, right)
            c = GetByte(tbl, bleft)
            nleft = GetByte(tbl, bright)
            SetByte(buf, left, nleft)
            SetByte(buf, right, c)
            left = Add(left, 1)
            right = Subtract(right, 1)
        }
        p = Add(p, 1)
    }

    sum = 0
    mix = 0
    i = 0
    WhileLoop LessThan(i, len) {
        b = GetByte(buf, i)
        sum = Add(sum, b)
        mix = BitwiseXor(mix, b)
        i = Add(i, 1)
    }

    PrintMessage("SUM ")
    PrintNumber(sum)
    PrintMessage("\nXOR ")
    PrintNumber(mix)
    PrintMessage("\n")
}
RunTask(Main)
