// =============================================================================
// AILANG Comprehensive Performance Benchmark Suite
// Tests: integer arithmetic, memory access, string ops, function call overhead,
//        recursive algorithms, sorting, and matrix math
// =============================================================================


LibraryImport.Arena

// =============================================================================
// TEST 1: Prime Sieve (existing baseline)
// =============================================================================
Function.Bench_Primes {
    Output: Integer
    Body: {
        DebugPerf.Start("primes")
        limit = 1000000
        count = 0
        n = 2
        WhileLoop LessThan(n, limit) {
            is_prime = 1
            i = 2
            WhileLoop LessThan(Multiply(i, i), Add(n, 1)) {
                IfCondition EqualTo(Modulo(n, i), 0) ThenBlock: {
                    is_prime = 0
                }
                i = Add(i, 1)
            }
            IfCondition EqualTo(is_prime, 1) ThenBlock: {
                count = Add(count, 1)
            }
            n = Add(n, 1)
        }
        DebugPerf.End("primes")
        ReturnValue(count)
    }
}

// =============================================================================
// TEST 2: Integer Arithmetic Stress
// Heavy arithmetic — multiply, divide, modulo, bitwise in tight loop
// =============================================================================
Function.Bench_Arithmetic {
    Output: Integer
    Body: {
        DebugPerf.Start("arithmetic")
        result = 0
        i = 1
        WhileLoop LessThan(i, 10000000) {
            a = Multiply(i, 31337)
            b = Modulo(a, 99991)
            c = BitwiseXor(b, LeftShift(i, 3))
            d = BitwiseAnd(c, 0xFFFF)
            result = BitwiseXor(result, Add(d, i))
            i = Add(i, 1)
        }
        DebugPerf.End("arithmetic")
        ReturnValue(result)
    }
}

// =============================================================================
// TEST 3: Memory Sequential Read/Write
// Cache-friendly sequential access pattern
// =============================================================================
Function.Bench_MemSequential {
    Output: Integer
    Body: {
        DebugPerf.Start("mem_sequential")
        size = 10000000
        buf = Allocate(Multiply(size, 8))

        // Write pass
        i = 0
        WhileLoop LessThan(i, size) {
            off = Multiply(i, 8)
            StoreValue(Add(buf, off), Multiply(i, 7))
            i = Add(i, 1)
        }

        // Read pass
        sum = 0
        i = 0
        WhileLoop LessThan(i, size) {
            off = Multiply(i, 8)
            val = Dereference(Add(buf, off))
            sum = Add(sum, val)
            i = Add(i, 1)
        }

        Deallocate(buf, Multiply(size, 8))
        DebugPerf.End("mem_sequential")
        ReturnValue(sum)
    }
}

// =============================================================================
// TEST 4: Memory Random Access
// Cache-hostile random access pattern
// =============================================================================
Function.Bench_MemRandom {
    Output: Integer
    Body: {
        DebugPerf.Start("mem_random")
        size = 1000000
        buf = Allocate(Multiply(size, 8))

        // Fill
        i = 0
        WhileLoop LessThan(i, size) {
            off = Multiply(i, 8)
            StoreValue(Add(buf, off), i)
            i = Add(i, 1)
        }

        // Random read
        sum = 0
        i = 0
        WhileLoop LessThan(i, size) {
            idx = Modulo(Multiply(i, 1000003), size)
            off = Multiply(idx, 8)
            val = Dereference(Add(buf, off))
            sum = Add(sum, val)
            i = Add(i, 1)
        }

        Deallocate(buf, Multiply(size, 8))
        DebugPerf.End("mem_random")
        ReturnValue(sum)
    }
}

// =============================================================================
// TEST 5: Recursive Fibonacci
// Tests function call overhead and stack depth
// =============================================================================
Function.Fib {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 2) ThenBlock: {
            ReturnValue(n)
        }
        a = Fib(Subtract(n, 1))
        b = Fib(Subtract(n, 2))
        ReturnValue(Add(a, b))
    }
}

Function.Bench_Fibonacci {
    Output: Integer
    Body: {
        DebugPerf.Start("fibonacci")
        result = 0
        i = 0
        WhileLoop LessThan(i, 10) {
            result = Add(result, Fib(35))
            i = Add(i, 1)
        }
        DebugPerf.End("fibonacci")
        ReturnValue(result)
    }
}

// =============================================================================
// TEST 6: String Operations
// Tests StringConcat, StringLength, StringCompare in a loop
// =============================================================================
Function.Bench_Strings {
    Output: Integer
    Body: {
        DebugPerf.Start("strings")
        count = 0
        i = 0
        words = "hello"
        WhileLoop LessThan(i, 100000) {
            s1 = StringConcat("Hello", " World")
            s2 = StringToUpper(s1)
            l = StringLength(s2)
            IfCondition EqualTo(l, 11) ThenBlock: {
                count = Add(count, 1)
            }
            i = Add(i, 1)
        }
        DebugPerf.End("strings")
        ReturnValue(count)
    }
}

// =============================================================================
// TEST 7: Bubble Sort
// Tests branching and memory access in a sorting algorithm
// =============================================================================
Function.Bench_BubbleSort {
    Output: Integer
    Body: {
        DebugPerf.Start("bubblesort")
        size = 10000
        buf = Allocate(Multiply(size, 8))

        // Fill with descending values
        i = 0
        WhileLoop LessThan(i, size) {
            off = Multiply(i, 8)
            StoreValue(Add(buf, off), Subtract(size, i))
            i = Add(i, 1)
        }

        // Bubble sort
        i = 0
        WhileLoop LessThan(i, size) {
            j = 0
            WhileLoop LessThan(j, Subtract(Subtract(size, i), 1)) {
                off_j  = Multiply(j, 8)
                off_j1 = Multiply(Add(j, 1), 8)
                a = Dereference(Add(buf, off_j))
                b = Dereference(Add(buf, off_j1))
                IfCondition GreaterThan(a, b) ThenBlock: {
                    StoreValue(Add(buf, off_j),  b)
                    StoreValue(Add(buf, off_j1), a)
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }

        // Sum sorted array to verify
        sum = 0
        i = 0
        WhileLoop LessThan(i, size) {
            off = Multiply(i, 8)
            sum = Add(sum, Dereference(Add(buf, off)))
            i = Add(i, 1)
        }

        Deallocate(buf, Multiply(size, 8))
        DebugPerf.End("bubblesort")
        ReturnValue(sum)
    }
}

// =============================================================================
// TEST 8: Matrix Multiply (64x64)
// Tests nested loops with heavy arithmetic and memory access
// =============================================================================
Function.Bench_MatrixMultiply {
    Output: Integer
    Body: {
        DebugPerf.Start("matmul")
        N = 64
        sz = Multiply(N, N)
        bytes = Multiply(sz, 8)

        a = Allocate(bytes)
        b = Allocate(bytes)
        c = Allocate(bytes)

        // Fill A and B
        i = 0
        WhileLoop LessThan(i, sz) {
            off = Multiply(i, 8)
            StoreValue(Add(a, off), Add(i, 1))
            StoreValue(Add(b, off), Subtract(sz, i))
            StoreValue(Add(c, off), 0)
            i = Add(i, 1)
        }

        // C = A * B
        row = 0
        WhileLoop LessThan(row, N) {
            col = 0
            WhileLoop LessThan(col, N) {
                sum = 0
                k = 0
                WhileLoop LessThan(k, N) {
                    a_off = Multiply(Add(Multiply(row, N), k), 8)
                    b_off = Multiply(Add(Multiply(k, N), col), 8)
                    av = Dereference(Add(a, a_off))
                    bv = Dereference(Add(b, b_off))
                    sum = Add(sum, Multiply(av, bv))
                    k = Add(k, 1)
                }
                c_off = Multiply(Add(Multiply(row, N), col), 8)
                StoreValue(Add(c, c_off), sum)
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }

        // Checksum
        total = 0
        i = 0
        WhileLoop LessThan(i, sz) {
            off = Multiply(i, 8)
            total = Add(total, Dereference(Add(c, off)))
            i = Add(i, 1)
        }

        Deallocate(a, bytes)
        Deallocate(b, bytes)
        Deallocate(c, bytes)
        DebugPerf.End("matmul")
        ReturnValue(total)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    PrintMessage("=== AILANG Benchmark Suite ===\n\n")

    PrintMessage("1. Prime Sieve (1M)... ")
    r1 = Bench_Primes()
    PrintMessage("Primes found: ")
    PrintNumber(r1)
    PrintMessage("\n")

    PrintMessage("2. Integer Arithmetic (10M ops)... ")
    r2 = Bench_Arithmetic()
    PrintMessage("Result: ")
    PrintNumber(r2)
    PrintMessage("\n")

    PrintMessage("3. Memory Sequential (10M elements)... ")
    r3 = Bench_MemSequential()
    PrintMessage("Sum: ")
    PrintNumber(r3)
    PrintMessage("\n")

    PrintMessage("4. Memory Random (1M elements)... ")
    r4 = Bench_MemRandom()
    PrintMessage("Sum: ")
    PrintNumber(r4)
    PrintMessage("\n")

    PrintMessage("5. Fibonacci (Fib(35) x10)... ")
    r5 = Bench_Fibonacci()
    PrintMessage("Result: ")
    PrintNumber(r5)
    PrintMessage("\n")

    PrintMessage("6. String Operations (100K)... ")
    r6 = Bench_Strings()
    PrintMessage("Count: ")
    PrintNumber(r6)
    PrintMessage("\n")

    PrintMessage("7. Bubble Sort (10K elements)... ")
    r7 = Bench_BubbleSort()
    PrintMessage("Sum: ")
    PrintNumber(r7)
    PrintMessage("\n")

    PrintMessage("8. Matrix Multiply (64x64)... ")
    r8 = Bench_MatrixMultiply()
    PrintMessage("Checksum: ")
    PrintNumber(r8)
    PrintMessage("\n")

    PrintMessage("\n=== Complete ===\n")
}

RunTask(Main)