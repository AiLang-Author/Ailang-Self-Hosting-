// c64_basic_tui.ailang
// C64 BASIC Interpreter with TUI - Classic Blue Screen Experience
// Uses Library.TUI for full-screen terminal control
//
// Full featured interpreter with:
//   - Math: ABS, SGN, INT, SQR, RND, PEEK, POKE
//   - Strings: LEN, ASC, CHR$, LEFT$, RIGHT$, MID$, STR$, VAL
//   - File I/O: SAVE, LOAD
//   - Flow: GOTO, GOSUB, RETURN, FOR/NEXT, IF/THEN
//   - I/O: PRINT, INPUT, LIST, NEW, CLR, CLS, END

LibraryImport.Arrays
LibraryImport.C64Math
LibraryImport.C64String
LibraryImport.C64FileIO
LibraryImport.BasicNum

// =============================================================================
// C64 COLOR SCHEME
// =============================================================================
FixedPool.C64Colors {
    "BG_BLUE": Initialize=4       
    "FG_LIGHT_BLUE": Initialize=6  
    "FG_WHITE": Initialize=7       
    "BORDER": Initialize=4        
}

// =============================================================================
// SCREEN LAYOUT
// =============================================================================
FixedPool.Screen {
    "width": Initialize=80
    "height": Initialize=24
    "input_row": Initialize=23     
    "status_row": Initialize=24     
    "output_start": Initialize=3   
    "output_end": Initialize=22    
    "cursor_row": Initialize=3     
    "cursor_col": Initialize=1     
    "scroll_top": Initialize=3      
    "scroll_bottom": Initialize=22
    "cells_ptr": Initialize=0
    "cells_len": Initialize=0
    "gen": Initialize=0
}

// =============================================================================
// INPUT BUFFER
// =============================================================================
FixedPool.InputBuf {
    "buffer_ptr": Initialize=0
    "pos": Initialize=0
    "max_len": Initialize=78
}

// =============================================================================
// BASIC STATE (same as before)
// =============================================================================
FixedPool.BState {
    "vars_ptr": Initialize=0
    "prog_nums_ptr": Initialize=0
    "prog_text_ptr": Initialize=0
    "gosub_stack_ptr": Initialize=0
    "gosub_sp": Initialize=0
    "for_var_ptr": Initialize=0
    "for_limit_ptr": Initialize=0
    "for_step_ptr": Initialize=0
    "for_line_ptr": Initialize=0
    "for_sp": Initialize=0
    "running": Initialize=0
    "current_idx": Initialize=0
    "current_line_num": Initialize=0
    "error_flag": Initialize=0
    "rng_seed": Initialize=12345
   
    "str_vars_ptr": Initialize=0
  
    "data_ptr": Initialize=0
    "data_line_idx": Initialize=0
    "data_pos": Initialize=0
    "option_base": Initialize=0
    "option_set": Initialize=0
    "arrays_used": Initialize=0
    "arr_ptr": Initialize=0
    "arr_d1": Initialize=0
    "arr_d2": Initialize=0
    "arr_rank": Initialize=0
    "fn_body": Initialize=0
    "fn_dummy": Initialize=0
    "fn_set": Initialize=0
    "sub1": Initialize=0
    "sub2": Initialize=0
    "busy": Initialize=0
}

FixedPool.ArrRef {
    "letter": Initialize=0
    "rank": Initialize=0
    "s1": Initialize=0
    "s2": Initialize=0
}

FixedPool.Parser {
    "line_ptr": Initialize=0
    "pos": Initialize=0
    "line_len": Initialize=0
}

// =============================================================================
// C64 SCREEN OUTPUT FUNCTIONS
// =============================================================================

Function.C64_Host_Sleep {
    Body: {
        ts = Allocate(16)
        i = 0
        WhileLoop LessThan(i, 16) {
            SetByte(ts, i, 0)
            i = Add(i, 1)
        }
        SetByte(ts, 8, 0)
        SetByte(ts, 9, 45)
        SetByte(ts, 10, 49)
        SetByte(ts, 11, 1)
        SystemCall(35, ts, 0)
        Deallocate(ts, 16)
    }
}

Function.C64_Host_Poke {
    Input: row: Integer
    Input: col: Integer
    Input: ch: Integer
    Body: {
        IfCondition LessThan(row, 1) ThenBlock: { }
        IfCondition GreaterThan(row, Screen.height) ThenBlock: { }
        IfCondition LessThan(col, 1) ThenBlock: { }
        IfCondition GreaterThan(col, Screen.width) ThenBlock: { }
        IfCondition And(GreaterEqual(row, 1), LessEqual(row, Screen.height)) ThenBlock: {
            IfCondition And(GreaterEqual(col, 1), LessEqual(col, Screen.width)) ThenBlock: {
                rr = Subtract(row, 1)
                cc = Subtract(col, 1)
                idx = Add(Multiply(rr, Screen.width), cc)
                SetByte(Screen.cells_ptr, idx, ch)
            }
        }
    }
}

Function.C64_Host_Flush {
    Body: {
        path = "/tmp/c64_basic/screen.bin"
        flags = 577
        fd = SystemCall(2, path, flags, 384)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, Screen.cells_ptr, Screen.cells_len)
            SystemCall(3, fd)
        }
        Screen.gen = Add(Screen.gen, 1)
        gpath = "/tmp/c64_basic/gen.txt"
        fd2 = SystemCall(2, gpath, flags, 384)
        IfCondition GreaterEqual(fd2, 0) ThenBlock: {
            gs = NumberToString(Screen.gen)
            gl = StringLength(gs)
            SystemCall(1, fd2, gs, gl)
            SystemCall(3, fd2)
        }
        cpath = "/tmp/c64_basic/cursor.txt"
        fd3 = SystemCall(2, cpath, flags, 384)
        IfCondition GreaterEqual(fd3, 0) ThenBlock: {
            rs = NumberToString(Screen.cursor_row)
            cs = NumberToString(Screen.cursor_col)
            sp = " "
            nl = "\n"
            a = StringConcat(rs, sp)
            b = StringConcat(a, cs)
            line = StringConcat(b, nl)
            ln = StringLength(line)
            SystemCall(1, fd3, line, ln)
            SystemCall(3, fd3)
        }
    }
}

Function.C64_LogReset {
    Body: {
        path = "/tmp/c64_basic/output.txt"
        flags = 577
        fd = SystemCall(2, path, flags, 384)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(3, fd)
        }
        bpath = "/tmp/c64_basic/busy.txt"
        fd2 = SystemCall(2, bpath, flags, 384)
        IfCondition GreaterEqual(fd2, 0) ThenBlock: {
            SystemCall(1, fd2, "0", 1)
            SystemCall(3, fd2)
        }
    }
}

Function.C64_Host_SetBusy {
    Input: v: Integer
    Body: {
        BState.busy = v
        path = "/tmp/c64_basic/busy.txt"
        flags = 577
        fd = SystemCall(2, path, flags, 384)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            IfCondition EqualTo(v, 1) ThenBlock: {
                SystemCall(1, fd, "1", 1)
            } ElseBlock: {
                SystemCall(1, fd, "0", 1)
            }
            SystemCall(3, fd)
        }
    }
}

Function.C64_LogStr {
    Input: str: Address
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        n = StringLength(str)
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        path = "/tmp/c64_basic/output.txt"
        flags = 1089
        fd = SystemCall(2, path, flags, 384)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, str, n)
            SystemCall(3, fd)
        }
    }
}

Function.C64_Host_Fill {
    Input: ch: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, Screen.cells_len) {
            SetByte(Screen.cells_ptr, i, ch)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.C64_Host_GetKey {
    Output: Integer
    Body: {
        buf = Allocate(16)
        i = 0
        WhileLoop LessThan(i, 16) {
            SetByte(buf, i, 0)
            i = Add(i, 1)
        }
        path = "/tmp/c64_basic/keys.txt"
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            Deallocate(buf, 16)
            C64_Host_Sleep()
            ReturnValue(0)
        }
        n = SystemCall(0, fd, buf, 15)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 16)
            C64_Host_Sleep()
            ReturnValue(0)
        }
        tfd = SystemCall(2, path, 577, 384)
        IfCondition GreaterEqual(tfd, 0) ThenBlock: {
            SystemCall(3, tfd)
        }
        v = 0
        p = 0
        WhileLoop LessThan(p, n) {
            ch = GetByte(buf, p)
            IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                v = Multiply(v, 10)
                v = Add(v, Subtract(ch, 48))
            }
            p = Add(p, 1)
        }
        Deallocate(buf, 16)
        ReturnValue(v)
    }
}

Function.C64_Init {
    Body: {
        Screen.width = 80
        Screen.height = 24
        Screen.status_row = 24
        Screen.input_row = 23
        Screen.output_end = 22
        Screen.scroll_bottom = 22
        Screen.output_start = 3
        Screen.scroll_top = 3
        Screen.cells_len = Multiply(Screen.width, Screen.height)
        Screen.cells_ptr = Allocate(Screen.cells_len)
        C64_Host_Fill(32)
        InputBuf.buffer_ptr = Allocate(128)
        InputBuf.max_len = 120
        InputBuf.pos = 0
        Screen.cursor_row = Screen.output_start
        Screen.cursor_col = 1
        BasicNum.Init()
        C64_LogReset()
        C64_Host_Flush()
    }
}

Function.C64_Shutdown {
    Body: {
        IfCondition NotEqual(InputBuf.buffer_ptr, 0) ThenBlock: {
            Deallocate(InputBuf.buffer_ptr, 128)
            InputBuf.buffer_ptr = 0
        }
        BCleanup()
        IfCondition NotEqual(Screen.cells_ptr, 0) ThenBlock: {
            Deallocate(Screen.cells_ptr, Screen.cells_len)
            Screen.cells_ptr = 0
        }
    }
}

// Print string at current cursor position with scrolling
Function.C64_Print {
    Input: str: Address
    Body: {
        i = 0
        len = StringLength(str)
        WhileLoop LessThan(i, len) {
            ch = GetByte(str, i)
            IfCondition EqualTo(ch, 10) ThenBlock: {
                Screen.cursor_col = 1
                Screen.cursor_row = Add(Screen.cursor_row, 1)
                C64_CheckScroll()
            } ElseBlock: {
                C64_Host_Poke(Screen.cursor_row, Screen.cursor_col, ch)
                Screen.cursor_col = Add(Screen.cursor_col, 1)
                IfCondition GreaterThan(Screen.cursor_col, Screen.width) ThenBlock: {
                    Screen.cursor_col = 1
                    Screen.cursor_row = Add(Screen.cursor_row, 1)
                    C64_CheckScroll()
                }
            }
            i = Add(i, 1)
        }
        C64_LogStr(str)
        C64_Host_Flush()
    }
}

// Print number as Minimal BASIC numeric
Function.C64_PrintNum {
    Input: num: Integer
    Body: {
        s = BasicNum.Format(num)
        C64_Print(s)
    }
}

Function.C64_PrintInt {
    Input: num: Integer
    Body: {
        s = NumberToString(num)
        C64_Print(s)
    }
}

Function.C64_PrintZone {
    Body: {
        zone = 15
        col0 = Subtract(Screen.cursor_col, 1)
        nxt = Multiply(Add(Divide(col0, zone), 1), zone)
        IfCondition GreaterEqual(nxt, Screen.width) ThenBlock: {
            C64_NewLine()
        } ElseBlock: {
            sp = " "
            WhileLoop LessEqual(Screen.cursor_col, nxt) {
                C64_Print(sp)
            }
        }
    }
}

Function.C64_PrintTab {
    Input: arg: Integer
    Body: {
        t = BasicNum.ToInt(arg)
        IfCondition LessThan(t, 1) ThenBlock: {
            C64_Print("TAB EXCEPTION")
            C64_NewLine()
            t = 1
        }
        IfCondition GreaterThan(t, Screen.width) ThenBlock: {
            t = Screen.width
        }
        IfCondition GreaterThan(Screen.cursor_col, t) ThenBlock: {
            C64_NewLine()
        }
        sp = " "
        WhileLoop LessThan(Screen.cursor_col, t) {
            C64_Print(sp)
        }
    }
}

Function.C64_NewLine {
    Body: {
        Screen.cursor_col = 1
        Screen.cursor_row = Add(Screen.cursor_row, 1)
        C64_CheckScroll()
        C64_LogStr("\n")
        C64_Host_Flush()
    }
}

// Scroll the output area up by one line
Function.C64_ScrollUp {
    Body: {
        w = Screen.width
        top = Subtract(Screen.scroll_top, 1)
        bot = Subtract(Screen.scroll_bottom, 1)
        src = Add(Multiply(Add(top, 1), w), 0)
        dst = Multiply(top, w)
        n = Multiply(Subtract(bot, top), w)
        i = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(Screen.cells_ptr, Add(src, i))
            SetByte(Screen.cells_ptr, Add(dst, i), ch)
            i = Add(i, 1)
        }
        base = Multiply(bot, w)
        c = 0
        WhileLoop LessThan(c, w) {
            SetByte(Screen.cells_ptr, Add(base, c), 32)
            c = Add(c, 1)
        }
        C64_Host_Flush()
    }
}

// Check if we need to scroll
Function.C64_CheckScroll {
    Body: {
        IfCondition GreaterThan(Screen.cursor_row, Screen.scroll_bottom) ThenBlock: {
            C64_ScrollUp()
            Screen.cursor_row = Screen.scroll_bottom
        }
    }
}

// Clear output area (within scroll region)
Function.C64_ClearOutput {
    Body: {
        r = Screen.output_start
        WhileLoop LessEqual(r, Screen.output_end) {
            c = 1
            WhileLoop LessEqual(c, Screen.width) {
                C64_Host_Poke(r, c, 32)
                c = Add(c, 1)
            }
            r = Add(r, 1)
        }
        Screen.cursor_row = Screen.output_start
        Screen.cursor_col = 1
        C64_Host_Flush()
    }
}

// =============================================================================
// ERROR REPORTING
// =============================================================================
Function.C64_Error {
    Input: msg: Address
    Body: {
        C64_Print("?")
        C64_Print(msg)
        C64_Print(" ERROR")
        
        // Add line number if running a program
        IfCondition EqualTo(BState.running, 1) ThenBlock: {
            C64_Print(" IN ")
            C64_PrintInt(BState.current_line_num)
        }
        C64_NewLine()
        
        BState.error_flag = 1
        BState.running = 0
    }
}

// Draw the C64 boot screen header (outside scroll region)
Function.C64_DrawHeader {
    Body: {
        c = 1
        WhileLoop LessEqual(c, Screen.width) {
            C64_Host_Poke(1, c, 32)
            C64_Host_Poke(2, c, 32)
            c = Add(c, 1)
        }
        old_r = Screen.cursor_row
        old_c = Screen.cursor_col
        Screen.cursor_row = 1
        Screen.cursor_col = 5
        C64_Print("**** COMMODORE 64 BASIC V2 ****")
        Screen.cursor_row = 2
        Screen.cursor_col = 2
        C64_Print("64K RAM SYSTEM  38911 BASIC BYTES FREE")
        Screen.cursor_row = old_r
        Screen.cursor_col = old_c
        C64_Host_Flush()
    }
}

// Draw status bar at bottom
Function.C64_DrawStatus {
    Input: msg: Address
    Body: {
        c = 1
        WhileLoop LessEqual(c, Screen.width) {
            C64_Host_Poke(Screen.status_row, c, 32)
            c = Add(c, 1)
        }
        old_r = Screen.cursor_row
        old_c = Screen.cursor_col
        Screen.cursor_row = Screen.status_row
        Screen.cursor_col = 1
        C64_Print(msg)
        Screen.cursor_row = old_r
        Screen.cursor_col = old_c
        C64_Host_Flush()
    }
}

// Draw input line with prompt
Function.C64_DrawInputLine {
    Body: {
        c = 1
        WhileLoop LessEqual(c, Screen.width) {
            C64_Host_Poke(Screen.input_row, c, 32)
            c = Add(c, 1)
        }
        i = 0
        WhileLoop LessThan(i, InputBuf.pos) {
            ch = GetByte(InputBuf.buffer_ptr, i)
            col = Add(i, 1)
            C64_Host_Poke(Screen.input_row, col, ch)
            i = Add(i, 1)
        }
        Screen.cursor_row = Screen.input_row
        Screen.cursor_col = Add(InputBuf.pos, 1)
        C64_Host_Flush()
    }
}

// =============================================================================
// INPUT HANDLING
// =============================================================================

Function.C64_Host_PastePending {
    Output: Integer
    Body: {
        ppath = "/tmp/c64_basic/paste.txt"
        fd = SystemCall(2, ppath, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        b = Allocate(4)
        n = SystemCall(0, fd, b, 1)
        SystemCall(3, fd)
        Deallocate(b, 4)
        IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.C64_Host_TakePasteLine {
    Output: Integer
    Body: {
        buf = Allocate(16384)
        zi = 0
        WhileLoop LessThan(zi, 16384) {
            SetByte(buf, zi, 0)
            zi = Add(zi, 1)
        }
        ppath = "/tmp/c64_basic/paste.txt"
        fd = SystemCall(2, ppath, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            Deallocate(buf, 16384)
            ReturnValue(0)
        }
        n = SystemCall(0, fd, buf, 16383)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 16384)
            ReturnValue(0)
        }
        i = 0
        found = 0
        WhileLoop And(LessThan(i, n), EqualTo(found, 0)) {
            ch = GetByte(buf, i)
            IfCondition EqualTo(ch, 10) ThenBlock: { found = 1 }
            IfCondition EqualTo(ch, 13) ThenBlock: { found = 1 }
            IfCondition EqualTo(found, 0) ThenBlock: { i = Add(i, 1) }
        }
        ln = i
        IfCondition GreaterThan(ln, 120) ThenBlock: { ln = 120 }
        j = 0
        WhileLoop LessThan(j, ln) {
            ch = GetByte(buf, j)
            SetByte(InputBuf.buffer_ptr, j, ch)
            j = Add(j, 1)
        }
        SetByte(InputBuf.buffer_ptr, ln, 0)
        InputBuf.pos = ln
        rest = Add(i, 1)
        IfCondition LessThan(rest, n) ThenBlock: {
            ch2 = GetByte(buf, i)
            IfCondition EqualTo(ch2, 13) ThenBlock: {
                IfCondition LessThan(rest, n) ThenBlock: {
                    nx = GetByte(buf, rest)
                    IfCondition EqualTo(nx, 10) ThenBlock: { rest = Add(rest, 1) }
                }
            }
        }
        flags = 577
        tfd = SystemCall(2, ppath, flags, 384)
        IfCondition GreaterEqual(tfd, 0) ThenBlock: {
            IfCondition LessThan(rest, n) ThenBlock: {
                left = Subtract(n, rest)
                SystemCall(1, tfd, Add(buf, rest), left)
            }
            SystemCall(3, tfd)
        }
        Deallocate(buf, 16384)
        ReturnValue(1)
    }
}

Function.C64_ReadLine {
    Output: Address
    Body: {
        InputBuf.pos = 0
        
        // Clear input buffer
        i = 0
        WhileLoop LessThan(i, 128) {
            SetByte(InputBuf.buffer_ptr, i, 0)
            i = Add(i, 1)
        }
        
        C64_DrawInputLine()
        
        done = 0
        WhileLoop EqualTo(done, 0) {
            gotp = C64_Host_TakePasteLine()
            IfCondition EqualTo(gotp, 1) ThenBlock: {
                IfCondition GreaterThan(InputBuf.pos, 0) ThenBlock: {
                    done = 1
                }
            }
            IfCondition EqualTo(done, 0) ThenBlock: {
            key = C64_Host_GetKey()
            IfCondition EqualTo(key, 13) ThenBlock: { done = 1 }
            IfCondition EqualTo(key, 10) ThenBlock: { done = 1 }
            IfCondition EqualTo(key, 8) ThenBlock: {
                IfCondition GreaterThan(InputBuf.pos, 0) ThenBlock: {
                    InputBuf.pos = Subtract(InputBuf.pos, 1)
                    SetByte(InputBuf.buffer_ptr, InputBuf.pos, 0)
                    C64_DrawInputLine()
                }
            }
            IfCondition EqualTo(key, 127) ThenBlock: {
                IfCondition GreaterThan(InputBuf.pos, 0) ThenBlock: {
                    InputBuf.pos = Subtract(InputBuf.pos, 1)
                    SetByte(InputBuf.buffer_ptr, InputBuf.pos, 0)
                    C64_DrawInputLine()
                }
            }
            IfCondition EqualTo(key, 27) ThenBlock: {
                SetByte(InputBuf.buffer_ptr, 0, 81)
                SetByte(InputBuf.buffer_ptr, 1, 85)
                SetByte(InputBuf.buffer_ptr, 2, 73)
                SetByte(InputBuf.buffer_ptr, 3, 84)
                SetByte(InputBuf.buffer_ptr, 4, 0)
                InputBuf.pos = 4
                done = 1
            }
            IfCondition EqualTo(done, 0) ThenBlock: {
                IfCondition And(GreaterEqual(key, 32), LessEqual(key, 126)) ThenBlock: {
                    IfCondition LessThan(InputBuf.pos, InputBuf.max_len) ThenBlock: {
                        SetByte(InputBuf.buffer_ptr, InputBuf.pos, key)
                        InputBuf.pos = Add(InputBuf.pos, 1)
                        SetByte(InputBuf.buffer_ptr, InputBuf.pos, 0)
                        C64_DrawInputLine()
                    }
                }
            }
            }
        }
        
        // Null terminate
        SetByte(InputBuf.buffer_ptr, InputBuf.pos, 0)
        
        start = 0
        sdone = 0
        WhileLoop And(LessThan(start, InputBuf.pos), EqualTo(sdone, 0)) {
            ch = GetByte(InputBuf.buffer_ptr, start)
            IfCondition Or(EqualTo(ch, 32), EqualTo(ch, 9)) ThenBlock: {
                start = Add(start, 1)
            } ElseBlock: {
                sdone = 1
            }
        }
        outlen = Subtract(InputBuf.pos, start)
        IfCondition LessThan(outlen, 0) ThenBlock: { outlen = 0 }
        bufsize = Add(outlen, 1)
        result = Allocate(bufsize)
        i = 0
        WhileLoop LessThan(i, outlen) {
            src = Add(start, i)
            ch = GetByte(InputBuf.buffer_ptr, src)
            SetByte(result, i, ch)
            i = Add(i, 1)
        }
        SetByte(result, outlen, 0)
        Screen.cursor_col = 1
        C64_Print(result)
        C64_NewLine()
        
        ReturnValue(result)
    }
}

// =============================================================================
// BASIC INITIALIZATION
// =============================================================================
Function.BInit {
    Output: Integer
    Body: {
        // Numeric scalars: A-Z and A0-Z9 = 286 slots
        v = ArrayCreate(286)
        BState.vars_ptr = v
        i = 0
        WhileLoop LessThan(i, 286) {
            ArraySet(v, i, 0)
            i = Add(i, 1)
        }
        asz = 208
        BState.arr_ptr = Allocate(asz)
        BState.arr_d1 = Allocate(asz)
        BState.arr_d2 = Allocate(asz)
        BState.arr_rank = Allocate(asz)
        BState.fn_body = Allocate(asz)
        BState.fn_dummy = Allocate(asz)
        BState.fn_set = Allocate(asz)
        i = 0
        WhileLoop LessThan(i, 26) {
            off = Multiply(i, 8)
            StoreValue(Add(BState.arr_ptr, off), 0)
            StoreValue(Add(BState.arr_d1, off), 0)
            StoreValue(Add(BState.arr_d2, off), 0)
            StoreValue(Add(BState.arr_rank, off), 0)
            StoreValue(Add(BState.fn_body, off), 0)
            StoreValue(Add(BState.fn_dummy, off), 0)
            StoreValue(Add(BState.fn_set, off), 0)
            i = Add(i, 1)
        }
        BState.option_base = 0
        BState.option_set = 0
        BState.arrays_used = 0
        
        // String variables A$-Z$ (store pointers to strings)
        sv = ArrayCreate(26)
        BState.str_vars_ptr = sv
        i = 0
        WhileLoop LessThan(i, 26) {
            // Initialize with empty strings
            empty = Allocate(1)
            SetByte(empty, 0, 0)
            ArraySet(sv, i, empty)
            i = Add(i, 1)
        }
        
        // Program storage
        BState.prog_nums_ptr = Array.Create(256)
        BState.prog_text_ptr = Array.Create(256)
        
        // GOSUB stack
        BState.gosub_stack_ptr = ArrayCreate(32)
        BState.gosub_sp = 0
        
        // FOR stack
        BState.for_var_ptr = ArrayCreate(16)
        BState.for_limit_ptr = ArrayCreate(16)
        BState.for_step_ptr = ArrayCreate(16)
        BState.for_line_ptr = ArrayCreate(16)
        BState.for_sp = 0
        
        BState.running = 0
        BState.error_flag = 0
        BState.current_line_num = 0
        
        // DATA pointer
        BState.data_line_idx = 0
        BState.data_pos = 0
        
        // Initialize libraries
        C64FileIO.Init()
        
        ReturnValue(1)
    }
}

// Cleanup function
Function.BCleanup {
    Body: {
        // Free string variables
        sv = BState.str_vars_ptr
        IfCondition NotEqual(sv, 0) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, 26) {
                str_ptr = ArrayGet(sv, i)
                IfCondition NotEqual(str_ptr, 0) ThenBlock: {
                    Deallocate(str_ptr, 0)
                }
                i = Add(i, 1)
            }
        }
        
        C64Math.Cleanup()
        C64FileIO.Cleanup()
    }
}

// =============================================================================
// STRING VARIABLE HELPERS
// =============================================================================

// Check if current position is a string variable (X$)
// Returns: variable index (0-25) if string var, -1 if not
Function.PCheckStringVar {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
            ReturnValue(-1)
        }
        
        // First char must be a letter
        pcsv_ch = GetByte(Parser.line_ptr, Parser.pos)
        pcsv_isalpha = PIsAlpha(pcsv_ch)
        IfCondition EqualTo(pcsv_isalpha, 0) ThenBlock: {
            ReturnValue(-1)
        }
        
        // Skip over any additional alphanumeric characters
        pcsv_peek = Add(Parser.pos, 1)
        pcsv_done = 0
        WhileLoop And(LessThan(pcsv_peek, Parser.line_len), EqualTo(pcsv_done, 0)) {
            pcsv_peek_ch = GetByte(Parser.line_ptr, pcsv_peek)
            pcsv_peek_alpha = PIsAlpha(pcsv_peek_ch)
            pcsv_peek_digit = PIsDigit(pcsv_peek_ch)
            IfCondition Or(EqualTo(pcsv_peek_alpha, 1), EqualTo(pcsv_peek_digit, 1)) ThenBlock: {
                pcsv_peek = Add(pcsv_peek, 1)
            } ElseBlock: {
                pcsv_done = 1
            }
        }
        
        // Check if the character after the name is $
        IfCondition GreaterEqual(pcsv_peek, Parser.line_len) ThenBlock: {
            ReturnValue(-1)
        }
        
        pcsv_dollar = GetByte(Parser.line_ptr, pcsv_peek)
        IfCondition NotEqual(pcsv_dollar, 36) ThenBlock: {
            // Not a $ sign
            ReturnValue(-1)
        }
        
        // It's a string variable - return index based on first letter only
        pcsv_upper = PToUpper(pcsv_ch)
        pcsv_idx = Subtract(pcsv_upper, 65)
        ReturnValue(pcsv_idx)
    }
}

// Parse a string variable name (advances parser past X$)
Function.PParseStringVarName {
    Output: Integer
    Body: {
        // Get first letter for the index
        ppsv_ch = GetByte(Parser.line_ptr, Parser.pos)
        ppsv_upper = PToUpper(ppsv_ch)
        ppsv_idx = Subtract(ppsv_upper, 65)
        
        // Skip the first letter
        Parser.pos = Add(Parser.pos, 1)
        
        // Skip any additional alphanumeric characters
        ppsv_done = 0
        WhileLoop And(LessThan(Parser.pos, Parser.line_len), EqualTo(ppsv_done, 0)) {
            ppsv_ch = GetByte(Parser.line_ptr, Parser.pos)
            ppsv_alpha = PIsAlpha(ppsv_ch)
            ppsv_digit = PIsDigit(ppsv_ch)
            IfCondition Or(EqualTo(ppsv_alpha, 1), EqualTo(ppsv_digit, 1)) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
            } ElseBlock: {
                ppsv_done = 1
            }
        }
        
        // Skip the $ sign
        Parser.pos = Add(Parser.pos, 1)
        
        ReturnValue(ppsv_idx)
    }
}
// Get string variable value
Function.GetStringVar {
    Input: vidx: Integer
    Output: Address
    Body: {
        IfCondition Or(LessThan(vidx, 0), GreaterEqual(vidx, 26)) ThenBlock: {
            empty = Allocate(1)
            SetByte(empty, 0, 0)
            ReturnValue(empty)
        }
        
        sv = BState.str_vars_ptr
        str_ptr = ArrayGet(sv, vidx)
        
        // Return a copy
        len = StringLength(str_ptr)
        bufsize = Add(len, 1)
        copy = Allocate(bufsize)
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(str_ptr, i)
            SetByte(copy, i, ch)
            i = Add(i, 1)
        }
        SetByte(copy, len, 0)
        
        ReturnValue(copy)
    }
}

// Set string variable value
Function.SetStringVar {
    Input: vidx: Integer
    Input: value: Address
    Body: {
        IfCondition Or(LessThan(vidx, 0), GreaterEqual(vidx, 26)) ThenBlock: {
            ReturnValue(0)
        }
        
        sv = BState.str_vars_ptr
        
        // Free old value
        old_str = ArrayGet(sv, vidx)
        IfCondition NotEqual(old_str, 0) ThenBlock: {
            Deallocate(old_str, 0)
        }
        
        // Copy new value
        len = StringLength(value)
        bufsize = Add(len, 1)
        new_str = Allocate(bufsize)
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(value, i)
            SetByte(new_str, i, ch)
            i = Add(i, 1)
        }
        SetByte(new_str, len, 0)
        
        ArraySet(sv, vidx, new_str)
        ReturnValue(0)
    }
}

// =============================================================================
// STRING EXPRESSION PARSER
// =============================================================================

// Parse a single string term (literal, variable, or function)
Function.PStrTerm {
    Output: Address
    Body: {
        PSkipSpaces()
        
        IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
            pst_empty = Allocate(1)
            SetByte(pst_empty, 0, 0)
            ReturnValue(pst_empty)
        }
        
        pst_ch = GetByte(Parser.line_ptr, Parser.pos)
        
        // === String literal "..." ===
        IfCondition EqualTo(pst_ch, 34) ThenBlock: {
            pst_result = PParseStr()
            ReturnValue(pst_result)
        }
        
        // === Check for string variable A$ ===
        pst_svidx = PCheckStringVar()
        IfCondition GreaterEqual(pst_svidx, 0) ThenBlock: {
            PParseStringVarName()
            pst_result = GetStringVar(pst_svidx)
            ReturnValue(pst_result)
        }
        
        // === Check for string functions ===
        pst_isalpha = PIsAlpha(pst_ch)
        IfCondition EqualTo(pst_isalpha, 1) ThenBlock: {
            pst_save_pos = Parser.pos
            pst_word = ParseWord()
            
            // --- CHR$(n) ---
            pst_cmp = StringCompare(pst_word, "CHR$")
            IfCondition EqualTo(pst_cmp, 0) ThenBlock: {
                Deallocate(pst_word, 0)
                PSkipSpaces()
                pst_ch = GetByte(Parser.line_ptr, Parser.pos)
                IfCondition EqualTo(pst_ch, 40) ThenBlock: {
                    Parser.pos = Add(Parser.pos, 1)
                    pst_codef = PExpr()
                    pst_code = BasicNum.ToInt(pst_codef)
                    PSkipSpaces()
                    pst_ch = GetByte(Parser.line_ptr, Parser.pos)
                    IfCondition EqualTo(pst_ch, 41) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                    }
                    pst_result = C64String.CHR(pst_code)
                    ReturnValue(pst_result)
                }
            }
            
            // --- STR$(n) ---
            pst_cmp = StringCompare(pst_word, "STR$")
            IfCondition EqualTo(pst_cmp, 0) ThenBlock: {
                Deallocate(pst_word, 0)
                PSkipSpaces()
                pst_ch = GetByte(Parser.line_ptr, Parser.pos)
                IfCondition EqualTo(pst_ch, 40) ThenBlock: {
                    Parser.pos = Add(Parser.pos, 1)
                    pst_num = PExpr()
                    PSkipSpaces()
                    pst_ch = GetByte(Parser.line_ptr, Parser.pos)
                    IfCondition EqualTo(pst_ch, 41) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                    }
                    pst_fmt = BasicNum.Format(pst_num)
                    pst_n = StringLength(pst_fmt)
                    pst_bs = Add(pst_n, 1)
                    pst_result = Allocate(pst_bs)
                    pst_i = 0
                    WhileLoop LessThan(pst_i, pst_n) {
                        pst_c = GetByte(pst_fmt, pst_i)
                        SetByte(pst_result, pst_i, pst_c)
                        pst_i = Add(pst_i, 1)
                    }
                    SetByte(pst_result, pst_n, 0)
                    ReturnValue(pst_result)
                }
            }
            
            // --- LEFT$(s$, n) ---
            pst_cmp = StringCompare(pst_word, "LEFT$")
            IfCondition EqualTo(pst_cmp, 0) ThenBlock: {
                Deallocate(pst_word, 0)
                PSkipSpaces()
                pst_ch = GetByte(Parser.line_ptr, Parser.pos)
                IfCondition EqualTo(pst_ch, 40) ThenBlock: {
                    Parser.pos = Add(Parser.pos, 1)
                    pst_str_arg = PStrExpr()
                    PSkipSpaces()
                    pst_ch = GetByte(Parser.line_ptr, Parser.pos)
                    IfCondition EqualTo(pst_ch, 44) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                    }
                    pst_n_argf = PExpr()
                    pst_n_arg = BasicNum.ToInt(pst_n_argf)
                    PSkipSpaces()
                    pst_ch = GetByte(Parser.line_ptr, Parser.pos)
                    IfCondition EqualTo(pst_ch, 41) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                    }
                    pst_result = C64String.LEFT(pst_str_arg, pst_n_arg)
                    Deallocate(pst_str_arg, 0)
                    ReturnValue(pst_result)
                }
            }
            
            // --- RIGHT$(s$, n) ---
            pst_cmp = StringCompare(pst_word, "RIGHT$")
            IfCondition EqualTo(pst_cmp, 0) ThenBlock: {
                Deallocate(pst_word, 0)
                PSkipSpaces()
                pst_ch = GetByte(Parser.line_ptr, Parser.pos)
                IfCondition EqualTo(pst_ch, 40) ThenBlock: {
                    Parser.pos = Add(Parser.pos, 1)
                    pst_str_arg = PStrExpr()
                    PSkipSpaces()
                    pst_ch = GetByte(Parser.line_ptr, Parser.pos)
                    IfCondition EqualTo(pst_ch, 44) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                    }
                    pst_n_argf = PExpr()
                    pst_n_arg = BasicNum.ToInt(pst_n_argf)
                    PSkipSpaces()
                    pst_ch = GetByte(Parser.line_ptr, Parser.pos)
                    IfCondition EqualTo(pst_ch, 41) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                    }
                    pst_result = C64String.RIGHT(pst_str_arg, pst_n_arg)
                    Deallocate(pst_str_arg, 0)
                    ReturnValue(pst_result)
                }
            }
            
            // --- MID$(s$, start, len) ---
            pst_cmp = StringCompare(pst_word, "MID$")
            IfCondition EqualTo(pst_cmp, 0) ThenBlock: {
                Deallocate(pst_word, 0)
                PSkipSpaces()
                pst_ch = GetByte(Parser.line_ptr, Parser.pos)
                IfCondition EqualTo(pst_ch, 40) ThenBlock: {
                    Parser.pos = Add(Parser.pos, 1)
                    pst_str_arg = PStrExpr()
                    PSkipSpaces()
                    pst_ch = GetByte(Parser.line_ptr, Parser.pos)
                    IfCondition EqualTo(pst_ch, 44) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                    }
                    pst_start_argf = PExpr()
                    pst_start_arg = BasicNum.ToInt(pst_start_argf)
                    PSkipSpaces()
                    pst_ch = GetByte(Parser.line_ptr, Parser.pos)
                    pst_len_arg = 255
                    IfCondition EqualTo(pst_ch, 44) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                        pst_len_argf = PExpr()
                        pst_len_arg = BasicNum.ToInt(pst_len_argf)
                        PSkipSpaces()
                        pst_ch = GetByte(Parser.line_ptr, Parser.pos)
                    }
                    IfCondition EqualTo(pst_ch, 41) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                    }
                    pst_result = C64String.MID(pst_str_arg, pst_start_arg, pst_len_arg)
                    Deallocate(pst_str_arg, 0)
                    ReturnValue(pst_result)
                }
            }
            
            // --- Not a recognized string function, restore position ---
            Deallocate(pst_word, 0)
            Parser.pos = pst_save_pos
        }
        
        // === Unknown - return empty string ===
        pst_empty = Allocate(1)
        SetByte(pst_empty, 0, 0)
        ReturnValue(pst_empty)
    }
}

// =============================================================================
// PStrExpr - Parse string expression with concatenation (+)
// =============================================================================
Function.PStrExpr {
    Output: Address
    Body: {
        // Get first string term
        pse_left = PStrTerm()
        
        // Check for concatenation operator(s)
        pse_done = 0
        WhileLoop EqualTo(pse_done, 0) {
            PSkipSpaces()
            
            IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
                pse_done = 1
            } ElseBlock: {
                pse_ch = GetByte(Parser.line_ptr, Parser.pos)
                
                // + operator for string concatenation
                IfCondition EqualTo(pse_ch, 43) ThenBlock: {
                    Parser.pos = Add(Parser.pos, 1)
                    pse_right = PStrTerm()
                    
                    // Concatenate left + right
                    pse_new = C64String.CONCAT(pse_left, pse_right)
                    
                    // Free old strings
                    Deallocate(pse_left, 0)
                    Deallocate(pse_right, 0)
                    
                    // Result becomes new left
                    pse_left = pse_new
                } ElseBlock: {
                    // Not a + operator, we're done
                    pse_done = 1
                }
            }
        }
        
        ReturnValue(pse_left)
    }
}

// =============================================================================
// PARSER HELPERS (same as original)
// =============================================================================
Function.PSetLine {
    Input: line: Address
    Body: {
        Parser.line_ptr = line
        Parser.pos = 0
        Parser.line_len = StringLength(line)
    }
}

Function.PSkipFrom {
    Input: start: Integer
    Output: Integer
    Body: {
        tpos = start
        done = 0
        WhileLoop And(LessThan(tpos, Parser.line_len), EqualTo(done, 0)) {
            tch = GetByte(Parser.line_ptr, tpos)
            IfCondition EqualTo(tch, 32) ThenBlock: {
                tpos = Add(tpos, 1)
            } ElseBlock: {
                done = 1
            }
        }
        ReturnValue(tpos)
    }
}

Function.PCharAt {
    Input: at: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(at, Parser.line_len) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(at, 0) ThenBlock: {
            ReturnValue(0)
        }
        c = GetByte(Parser.line_ptr, at)
        ReturnValue(c)
    }
}

Function.PSkipSpaces {
    Body: {
        done = 0
        WhileLoop And(LessThan(Parser.pos, Parser.line_len), EqualTo(done, 0)) {
            ch = GetByte(Parser.line_ptr, Parser.pos)
            IfCondition Or(EqualTo(ch, 32), EqualTo(ch, 9)) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
            } ElseBlock: {
                done = 1
            }
        }
    }
}

Function.PIsDigit {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.PIsAlpha {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.PToUpper {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: {
            ReturnValue(Subtract(ch, 32))
        }
        ReturnValue(ch)
    }
}

Function.PParseInt {
    Output: Integer
    Body: {
        val = 0
        neg = 0
        ch = GetByte(Parser.line_ptr, Parser.pos)
        IfCondition EqualTo(ch, 45) ThenBlock: {
            neg = 1
            Parser.pos = Add(Parser.pos, 1)
        } ElseBlock: {
            IfCondition EqualTo(ch, 43) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
            }
        }
        done = 0
        WhileLoop And(LessThan(Parser.pos, Parser.line_len), EqualTo(done, 0)) {
            ch = GetByte(Parser.line_ptr, Parser.pos)
            isdig = PIsDigit(ch)
            IfCondition EqualTo(isdig, 1) ThenBlock: {
                digit = Subtract(ch, 48)
                val = Multiply(val, 10)
                val = Add(val, digit)
                Parser.pos = Add(Parser.pos, 1)
            } ElseBlock: {
                done = 1
            }
        }
        IfCondition EqualTo(neg, 1) ThenBlock: {
            val = Subtract(0, val)
        }
        ReturnValue(val)
    }
}

Function.PParseNum {
    Output: Integer
    Body: {
        IfCondition EqualTo(BasicNum.ready, 0) ThenBlock: {
            BasicNum.Init()
        }
        ten = BasicNum.ten
        val = BasicNum.zero
        neg = 0
        ch = GetByte(Parser.line_ptr, Parser.pos)
        IfCondition EqualTo(ch, 45) ThenBlock: {
            neg = 1
            Parser.pos = Add(Parser.pos, 1)
        } ElseBlock: {
            IfCondition EqualTo(ch, 43) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
            }
        }
        saw = 0
        frac = 0
        fdiv = BasicNum.one
        done = 0
        WhileLoop And(LessThan(Parser.pos, Parser.line_len), EqualTo(done, 0)) {
            ch = GetByte(Parser.line_ptr, Parser.pos)
            isdig = PIsDigit(ch)
            IfCondition EqualTo(isdig, 1) ThenBlock: {
                d = Float_FromInt(Subtract(ch, 48))
                IfCondition EqualTo(frac, 0) ThenBlock: {
                    t1 = Float_Mul(val, ten)
                    val = Float_Add(t1, d)
                } ElseBlock: {
                    fdiv = Float_Mul(fdiv, ten)
                    t1 = Float_Div(d, fdiv)
                    val = Float_Add(val, t1)
                }
                saw = 1
                Parser.pos = Add(Parser.pos, 1)
            } ElseBlock: {
                IfCondition And(EqualTo(ch, 46), EqualTo(frac, 0)) ThenBlock: {
                    frac = 1
                    Parser.pos = Add(Parser.pos, 1)
                } ElseBlock: {
                    done = 1
                }
            }
        }
        IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
            ch = GetByte(Parser.line_ptr, Parser.pos)
            uch = PToUpper(ch)
            IfCondition EqualTo(uch, 69) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
                esign = 1
                IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
                    ch = GetByte(Parser.line_ptr, Parser.pos)
                    IfCondition EqualTo(ch, 43) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(ch, 45) ThenBlock: {
                            esign = -1
                            Parser.pos = Add(Parser.pos, 1)
                        }
                    }
                }
                ev = 0
                edone = 0
                WhileLoop And(LessThan(Parser.pos, Parser.line_len), EqualTo(edone, 0)) {
                    ch = GetByte(Parser.line_ptr, Parser.pos)
                    isdig = PIsDigit(ch)
                    IfCondition EqualTo(isdig, 1) ThenBlock: {
                        ev = Multiply(ev, 10)
                        ev = Add(ev, Subtract(ch, 48))
                        Parser.pos = Add(Parser.pos, 1)
                    } ElseBlock: {
                        edone = 1
                    }
                }
                k = 0
                WhileLoop LessThan(k, ev) {
                    IfCondition EqualTo(esign, 1) ThenBlock: {
                        val = Float_Mul(val, ten)
                    } ElseBlock: {
                        val = Float_Div(val, ten)
                    }
                    k = Add(k, 1)
                }
            }
        }
        IfCondition EqualTo(neg, 1) ThenBlock: {
            val = Float_Neg(val)
        }
        ReturnValue(val)
    }
}

Function.PParseScalarIdx {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
            ReturnValue(-1)
        }
        ch = GetByte(Parser.line_ptr, Parser.pos)
        isalph = PIsAlpha(ch)
        IfCondition EqualTo(isalph, 0) ThenBlock: {
            ReturnValue(-1)
        }
        uch = PToUpper(ch)
        letter = Subtract(uch, 65)
        Parser.pos = Add(Parser.pos, 1)
        dig = 10
        IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
            ch = GetByte(Parser.line_ptr, Parser.pos)
            dchk = PIsDigit(ch)
            IfCondition EqualTo(dchk, 1) ThenBlock: {
                dig = Subtract(ch, 48)
                Parser.pos = Add(Parser.pos, 1)
            }
        }
        idx = Add(Multiply(letter, 11), dig)
        ReturnValue(idx)
    }
}

Function.PEatArg {
    Output: Integer
    Body: {
        PSkipSpaces()
        IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
            ReturnValue(BasicNum.zero)
        }
        ch = GetByte(Parser.line_ptr, Parser.pos)
        IfCondition NotEqual(ch, 40) ThenBlock: {
            ReturnValue(BasicNum.zero)
        }
        Parser.pos = Add(Parser.pos, 1)
        v = PExpr()
        PSkipSpaces()
        IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
            ch = GetByte(Parser.line_ptr, Parser.pos)
            IfCondition EqualTo(ch, 44) ThenBlock: {
                C64_Error("INCORRECT NUMBER OF ARGUMENTS")
                ReturnValue(BasicNum.zero)
            }
            IfCondition EqualTo(ch, 41) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
            }
        }
        ReturnValue(v)
    }
}

Function.MetaGet {
    Input: base: Integer
    Input: idx: Integer
    Output: Integer
    Body: {
        off = Multiply(idx, 8)
        v = Dereference(Add(base, off))
        ReturnValue(v)
    }
}

Function.MetaSet {
    Input: base: Integer
    Input: idx: Integer
    Input: val: Integer
    Body: {
        off = Multiply(idx, 8)
        StoreValue(Add(base, off), val)
    }
}

Function.ArrEnsure {
    Input: letter: Integer
    Input: rank: Integer
    Input: u1: Integer
    Input: u2: Integer
    Output: Integer
    Body: {
        IfCondition Or(LessThan(letter, 0), GreaterThan(letter, 25)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(BState.arrays_used, 0) ThenBlock: {
            BState.arrays_used = 1
        }
        oldr = MetaGet(BState.arr_rank, letter)
        base = BState.option_base
        IfCondition EqualTo(oldr, 0) ThenBlock: {
            IfCondition EqualTo(rank, 1) ThenBlock: {
                IfCondition EqualTo(u1, -1) ThenBlock: {
                    u1 = 10
                }
                n = Add(Subtract(u1, base), 1)
                IfCondition LessThan(n, 1) ThenBlock: {
                    C64_Error("BAD SUBSCRIPT")
                    ReturnValue(0)
                }
                bytes = Multiply(n, 8)
                p = Allocate(bytes)
                zi = 0
                WhileLoop LessThan(zi, n) {
                    StoreValue(Add(p, Multiply(zi, 8)), 0)
                    zi = Add(zi, 1)
                }
                MetaSet(BState.arr_ptr, letter, p)
                MetaSet(BState.arr_d1, letter, u1)
                MetaSet(BState.arr_d2, letter, 0)
                MetaSet(BState.arr_rank, letter, 1)
                ReturnValue(1)
            }
            IfCondition EqualTo(u1, -1) ThenBlock: { u1 = 10 }
            IfCondition EqualTo(u2, -1) ThenBlock: { u2 = 10 }
            n1 = Add(Subtract(u1, base), 1)
            n2 = Add(Subtract(u2, base), 1)
            n = Multiply(n1, n2)
            IfCondition LessThan(n, 1) ThenBlock: {
                C64_Error("BAD SUBSCRIPT")
                ReturnValue(0)
            }
            bytes = Multiply(n, 8)
            p = Allocate(bytes)
            zi = 0
            WhileLoop LessThan(zi, n) {
                StoreValue(Add(p, Multiply(zi, 8)), 0)
                zi = Add(zi, 1)
            }
            MetaSet(BState.arr_ptr, letter, p)
            MetaSet(BState.arr_d1, letter, u1)
            MetaSet(BState.arr_d2, letter, u2)
            MetaSet(BState.arr_rank, letter, 2)
            ReturnValue(1)
        }
        IfCondition NotEqual(oldr, rank) ThenBlock: {
            C64_Error("BAD SUBSCRIPT")
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.ArrIndex {
    Input: letter: Integer
    Output: Integer
    Body: {
        rank = MetaGet(BState.arr_rank, letter)
        base = BState.option_base
        s1 = ArrRef.s1
        s2 = ArrRef.s2
        u1 = MetaGet(BState.arr_d1, letter)
        u2 = MetaGet(BState.arr_d2, letter)
        IfCondition LessThan(s1, base) ThenBlock: {
            C64_Error("BAD SUBSCRIPT")
            ReturnValue(-1)
        }
        IfCondition GreaterThan(s1, u1) ThenBlock: {
            C64_Error("BAD SUBSCRIPT")
            ReturnValue(-1)
        }
        IfCondition EqualTo(rank, 1) ThenBlock: {
            ReturnValue(Subtract(s1, base))
        }
        IfCondition LessThan(s2, base) ThenBlock: {
            C64_Error("BAD SUBSCRIPT")
            ReturnValue(-1)
        }
        IfCondition GreaterThan(s2, u2) ThenBlock: {
            C64_Error("BAD SUBSCRIPT")
            ReturnValue(-1)
        }
        n2 = Add(Subtract(u2, base), 1)
        row = Subtract(s1, base)
        col = Subtract(s2, base)
        off = Add(Multiply(row, n2), col)
        ReturnValue(off)
    }
}

Function.ArrGet {
    Input: letter: Integer
    Output: Integer
    Body: {
        p = MetaGet(BState.arr_ptr, letter)
        IfCondition EqualTo(p, 0) ThenBlock: {
            ReturnValue(BasicNum.zero)
        }
        off = ArrIndex(letter)
        IfCondition LessThan(off, 0) ThenBlock: {
            ReturnValue(BasicNum.zero)
        }
        v = Dereference(Add(p, Multiply(off, 8)))
        ReturnValue(v)
    }
}

Function.ArrSet {
    Input: letter: Integer
    Input: val: Integer
    Body: {
        p = MetaGet(BState.arr_ptr, letter)
        IfCondition EqualTo(p, 0) ThenBlock: {
            ReturnValue(0)
        }
        off = ArrIndex(letter)
        IfCondition LessThan(off, 0) ThenBlock: {
            ReturnValue(0)
        }
        StoreValue(Add(p, Multiply(off, 8)), val)
    }
}

Function.PParseArrayRef {
    Output: Integer
    Body: {
        ch = GetByte(Parser.line_ptr, Parser.pos)
        uch = PToUpper(ch)
        letter = Subtract(uch, 65)
        Parser.pos = Add(Parser.pos, 1)
        PSkipSpaces()
        ch = GetByte(Parser.line_ptr, Parser.pos)
        IfCondition NotEqual(ch, 40) ThenBlock: {
            ReturnValue(-1)
        }
        Parser.pos = Add(Parser.pos, 1)
        e1 = PExpr()
        s1 = BasicNum.ToInt(e1)
        rank = 1
        s2 = 0
        PSkipSpaces()
        ch = GetByte(Parser.line_ptr, Parser.pos)
        IfCondition EqualTo(ch, 44) ThenBlock: {
            Parser.pos = Add(Parser.pos, 1)
            e2 = PExpr()
            s2 = BasicNum.ToInt(e2)
            rank = 2
            PSkipSpaces()
        }
        IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
            ch = GetByte(Parser.line_ptr, Parser.pos)
            IfCondition EqualTo(ch, 41) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
            }
        }
        ArrRef.letter = letter
        ArrRef.rank = rank
        ArrRef.s1 = s1
        ArrRef.s2 = s2
        ok = ArrEnsure(letter, rank, -1, -1)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(letter)
    }
}

Function.PEvalFn {
    Input: fn_idx: Integer
    Input: arg: Integer
    Output: Integer
    Body: {
        set = MetaGet(BState.fn_set, fn_idx)
        IfCondition EqualTo(set, 0) ThenBlock: {
            C64_Error("UNDEFINED FUNCTION")
            ReturnValue(BasicNum.zero)
        }
        body = MetaGet(BState.fn_body, fn_idx)
        dummy = MetaGet(BState.fn_dummy, fn_idx)
        oldv = ArrayGet(BState.vars_ptr, dummy)
        ArraySet(BState.vars_ptr, dummy, arg)
        save_ptr = Parser.line_ptr
        save_pos = Parser.pos
        save_len = Parser.line_len
        PSetLine(body)
        r = PExpr()
        Parser.line_ptr = save_ptr
        Parser.pos = save_pos
        Parser.line_len = save_len
        ArraySet(BState.vars_ptr, dummy, oldv)
        ReturnValue(r)
    }
}

Function.PParseStr {
    Output: Address
    Body: {
        // Skip opening quote
        Parser.pos = Add(Parser.pos, 1)
        pps_start = Parser.pos
        
        // Find closing quote
        pps_done = 0
        WhileLoop And(LessThan(Parser.pos, Parser.line_len), EqualTo(pps_done, 0)) {
            pps_ch = GetByte(Parser.line_ptr, Parser.pos)
            IfCondition EqualTo(pps_ch, 34) ThenBlock: {
                pps_done = 1
            } ElseBlock: {
                Parser.pos = Add(Parser.pos, 1)
            }
        }
        
        // Calculate length and allocate
        pps_len = Subtract(Parser.pos, pps_start)
        pps_bufsize = Add(pps_len, 1)
        pps_str = Allocate(pps_bufsize)
        
        // Copy characters
        pps_i = 0
        WhileLoop LessThan(pps_i, pps_len) {
            pps_srcpos = Add(pps_start, pps_i)
            pps_ch = GetByte(Parser.line_ptr, pps_srcpos)
            SetByte(pps_str, pps_i, pps_ch)
            pps_i = Add(pps_i, 1)
        }
        
        // Null terminate
        SetByte(pps_str, pps_len, 0)
        
        // Skip closing quote
        Parser.pos = Add(Parser.pos, 1)
        
        ReturnValue(pps_str)
    }
}

// =============================================================================
// EXPRESSION PARSER
// =============================================================================
Function.PFactor {
    Output: Integer
    Body: {
        PSkipSpaces()
        IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
            ReturnValue(BasicNum.zero)
        }
        ch = GetByte(Parser.line_ptr, Parser.pos)

        isdig = PIsDigit(ch)
        IfCondition EqualTo(isdig, 1) ThenBlock: {
            ReturnValue(PParseNum())
        }
        IfCondition EqualTo(ch, 46) ThenBlock: {
            ReturnValue(PParseNum())
        }

        IfCondition EqualTo(ch, 40) ThenBlock: {
            Parser.pos = Add(Parser.pos, 1)
            val = PExpr()
            PSkipSpaces()
            IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
                ch = GetByte(Parser.line_ptr, Parser.pos)
                IfCondition EqualTo(ch, 41) ThenBlock: {
                    Parser.pos = Add(Parser.pos, 1)
                }
            }
            ReturnValue(val)
        }

        isalph = PIsAlpha(ch)
        IfCondition EqualTo(isalph, 1) ThenBlock: {
            save_pos = Parser.pos
            word = ParseWord()
            kw = MatchKW(word)

            IfCondition EqualTo(kw, 20) ThenBlock: {
                Deallocate(word, 0)
                arg = PEatArg()
                ReturnValue(BasicNum.Abs(arg))
            }
            IfCondition EqualTo(kw, 21) ThenBlock: {
                Deallocate(word, 0)
                arg = PEatArg()
                ReturnValue(BasicNum.Sgn(arg))
            }
            IfCondition EqualTo(kw, 22) ThenBlock: {
                Deallocate(word, 0)
                arg = PEatArg()
                ReturnValue(BasicNum.IntFloor(arg))
            }
            IfCondition EqualTo(kw, 23) ThenBlock: {
                Deallocate(word, 0)
                arg = PEatArg()
                IfCondition EqualTo(Float_Lt(arg, BasicNum.zero), 1) ThenBlock: {
                    C64_Error("ILLEGAL QUANTITY")
                    ReturnValue(BasicNum.zero)
                }
                ReturnValue(Float_Sqrt(arg))
            }
            IfCondition EqualTo(kw, 24) ThenBlock: {
                Deallocate(word, 0)
                PSkipSpaces()
                IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
                    ch = GetByte(Parser.line_ptr, Parser.pos)
                    IfCondition EqualTo(ch, 40) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                        PSkipSpaces()
                        ch = GetByte(Parser.line_ptr, Parser.pos)
                        IfCondition EqualTo(ch, 41) ThenBlock: {
                            Parser.pos = Add(Parser.pos, 1)
                            ReturnValue(BasicNum.Rnd())
                        }
                        arg = PExpr()
                        PSkipSpaces()
                        ch = GetByte(Parser.line_ptr, Parser.pos)
                        IfCondition EqualTo(ch, 44) ThenBlock: {
                            C64_Error("INCORRECT NUMBER OF ARGUMENTS")
                            ReturnValue(BasicNum.zero)
                        }
                        IfCondition EqualTo(ch, 41) ThenBlock: {
                            Parser.pos = Add(Parser.pos, 1)
                        }
                        ReturnValue(BasicNum.Rnd())
                    }
                }
                ReturnValue(BasicNum.Rnd())
            }
            IfCondition EqualTo(kw, 25) ThenBlock: {
                Deallocate(word, 0)
                arg = PEatArg()
                ai = BasicNum.ToInt(arg)
                pv = C64Math.PEEK(ai)
                ReturnValue(Float_FromInt(pv))
            }
            IfCondition EqualTo(kw, 50) ThenBlock: {
                Deallocate(word, 0)
                arg = PEatArg()
                ReturnValue(Float_Sin(arg))
            }
            IfCondition EqualTo(kw, 51) ThenBlock: {
                Deallocate(word, 0)
                arg = PEatArg()
                ReturnValue(Float_Cos(arg))
            }
            IfCondition EqualTo(kw, 52) ThenBlock: {
                Deallocate(word, 0)
                arg = PEatArg()
                ReturnValue(Float_Tan(arg))
            }
            IfCondition EqualTo(kw, 53) ThenBlock: {
                Deallocate(word, 0)
                arg = PEatArg()
                ReturnValue(Float_Atan2(arg, BasicNum.one))
            }
            IfCondition EqualTo(kw, 54) ThenBlock: {
                Deallocate(word, 0)
                arg = PEatArg()
                IfCondition EqualTo(Float_Le(arg, BasicNum.zero), 1) ThenBlock: {
                    C64_Error("ILLEGAL QUANTITY")
                    ReturnValue(BasicNum.zero)
                }
                ReturnValue(Float_Log(arg))
            }
            IfCondition EqualTo(kw, 55) ThenBlock: {
                Deallocate(word, 0)
                arg = PEatArg()
                ReturnValue(Float_Exp(arg))
            }
            IfCondition EqualTo(kw, 30) ThenBlock: {
                Deallocate(word, 0)
                PSkipSpaces()
                Parser.pos = Add(Parser.pos, 1)
                str = PStrExpr()
                PSkipSpaces()
                IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
                    ch = GetByte(Parser.line_ptr, Parser.pos)
                    IfCondition EqualTo(ch, 41) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                    }
                }
                result = C64String.LEN(str)
                Deallocate(str, 0)
                ReturnValue(Float_FromInt(result))
            }
            IfCondition EqualTo(kw, 31) ThenBlock: {
                Deallocate(word, 0)
                PSkipSpaces()
                Parser.pos = Add(Parser.pos, 1)
                str = PStrExpr()
                PSkipSpaces()
                IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
                    ch = GetByte(Parser.line_ptr, Parser.pos)
                    IfCondition EqualTo(ch, 41) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                    }
                }
                result = C64String.ASC(str)
                Deallocate(str, 0)
                ReturnValue(Float_FromInt(result))
            }
            IfCondition EqualTo(kw, 32) ThenBlock: {
                Deallocate(word, 0)
                PSkipSpaces()
                Parser.pos = Add(Parser.pos, 1)
                str = PStrExpr()
                PSkipSpaces()
                IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
                    ch = GetByte(Parser.line_ptr, Parser.pos)
                    IfCondition EqualTo(ch, 41) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                    }
                }
                result = BasicNum.ParseStr(str)
                Deallocate(str, 0)
                ReturnValue(result)
            }

            // FNA..FNZ
            wlen = StringLength(word)
            IfCondition EqualTo(wlen, 3) ThenBlock: {
                c0 = GetByte(word, 0)
                c1 = GetByte(word, 1)
                c2 = GetByte(word, 2)
                IfCondition And(EqualTo(c0, 70), EqualTo(c1, 78)) ThenBlock: {
                    IfCondition And(GreaterEqual(c2, 65), LessEqual(c2, 90)) ThenBlock: {
                        Deallocate(word, 0)
                        fn_idx = Subtract(c2, 65)
                        arg = PEatArg()
                        ReturnValue(PEvalFn(fn_idx, arg))
                    }
                }
            }
            Deallocate(word, 0)

            Parser.pos = save_pos
            PSkipSpaces()
            tpos = Add(Parser.pos, 1)
            tch = PCharAt(tpos)
            tdig = PIsDigit(tch)
            IfCondition EqualTo(tdig, 1) ThenBlock: {
                tpos = Add(tpos, 1)
            }
            tpos = PSkipFrom(tpos)
            tch = PCharAt(tpos)
            IfCondition EqualTo(tch, 40) ThenBlock: {
                npos = Add(Parser.pos, 1)
                nch = PCharAt(npos)
                ndig = PIsDigit(nch)
                IfCondition EqualTo(ndig, 0) ThenBlock: {
                    letter = PParseArrayRef()
                    IfCondition LessThan(letter, 0) ThenBlock: {
                        ReturnValue(BasicNum.zero)
                    }
                    ReturnValue(ArrGet(letter))
                }
            }
            vidx = PParseScalarIdx()
            IfCondition And(GreaterEqual(vidx, 0), LessThan(vidx, 286)) ThenBlock: {
                val = ArrayGet(BState.vars_ptr, vidx)
                ReturnValue(val)
            }
            ReturnValue(BasicNum.zero)
        }
        ReturnValue(BasicNum.zero)
    }
}

Function.PUnary {
    Output: Integer
    Body: {
        PSkipSpaces()
        IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
            ReturnValue(BasicNum.zero)
        }
        ch = GetByte(Parser.line_ptr, Parser.pos)
        IfCondition EqualTo(ch, 43) ThenBlock: {
            Parser.pos = Add(Parser.pos, 1)
            ReturnValue(PPower())
        }
        IfCondition EqualTo(ch, 45) ThenBlock: {
            Parser.pos = Add(Parser.pos, 1)
            v = PPower()
            ReturnValue(Float_Neg(v))
        }
        ReturnValue(PPower())
    }
}

Function.PPower {
    Output: Integer
    Body: {
        left = PFactor()
        done = 0
        WhileLoop EqualTo(done, 0) {
            PSkipSpaces()
            IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
                done = 1
            } ElseBlock: {
                ch = GetByte(Parser.line_ptr, Parser.pos)
                IfCondition EqualTo(ch, 94) ThenBlock: {
                    Parser.pos = Add(Parser.pos, 1)
                    right = PFactor()
                    r = BasicNum.Pow(left, right)
                    IfCondition EqualTo(Float_IsNan(r), 1) ThenBlock: {
                        C64_Error("ILLEGAL QUANTITY")
                        ReturnValue(BasicNum.zero)
                    }
                    IfCondition EqualTo(Float_IsInf(r), 1) ThenBlock: {
                        C64_Error("OVERFLOW")
                        ReturnValue(BasicNum.zero)
                    }
                    left = r
                } ElseBlock: {
                    done = 1
                }
            }
        }
        ReturnValue(left)
    }
}

Function.PTerm {
    Output: Integer
    Body: {
        left = PUnary()
        done = 0
        WhileLoop EqualTo(done, 0) {
            PSkipSpaces()
            IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
                done = 1
            } ElseBlock: {
                ch = GetByte(Parser.line_ptr, Parser.pos)
                IfCondition EqualTo(ch, 42) ThenBlock: {
                    Parser.pos = Add(Parser.pos, 1)
                    right = PUnary()
                    left = Float_Mul(left, right)
                } ElseBlock: {
                    IfCondition EqualTo(ch, 47) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                        right = PUnary()
                        zeq = Float_Eq(right, BasicNum.zero)
                        IfCondition EqualTo(zeq, 1) ThenBlock: {
                            C64_Error("DIVISION BY ZERO")
                            ReturnValue(BasicNum.zero)
                        }
                        left = Float_Div(left, right)
                    } ElseBlock: {
                        done = 1
                    }
                }
            }
        }
        ReturnValue(left)
    }
}

Function.PExpr {
    Output: Integer
    Body: {
        left = PTerm()
        done = 0
        WhileLoop EqualTo(done, 0) {
            PSkipSpaces()
            IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
                done = 1
            } ElseBlock: {
                ch = GetByte(Parser.line_ptr, Parser.pos)
                IfCondition EqualTo(ch, 43) ThenBlock: {
                    Parser.pos = Add(Parser.pos, 1)
                    right = PTerm()
                    left = Float_Add(left, right)
                } ElseBlock: {
                    IfCondition EqualTo(ch, 45) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                        right = PTerm()
                        left = Float_Sub(left, right)
                    } ElseBlock: {
                        done = 1
                    }
                }
            }
        }
        ReturnValue(left)
    }
}

// =============================================================================
// PCompare - Fixed to handle both numeric and string comparisons
// =============================================================================
// Replace the existing PCompare function in c64_basic_interpreter.ailang
// =============================================================================

Function.PCompare {
    Output: Integer
    Body: {
        PSkipSpaces()
        
        // Check if this is a string comparison
       
        pcmp_is_string = 0
        
        IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
            pcmp_ch = GetByte(Parser.line_ptr, Parser.pos)
            
            // Check for string literal
            IfCondition EqualTo(pcmp_ch, 34) ThenBlock: {
                pcmp_is_string = 1
            } ElseBlock: {
                // Check for string variable
                pcmp_svidx = PCheckStringVar()
                IfCondition GreaterEqual(pcmp_svidx, 0) ThenBlock: {
                    pcmp_is_string = 1
                } ElseBlock: {
                    // Check for string function (word ending in $)
                    pcmp_isalpha = PIsAlpha(pcmp_ch)
                    IfCondition EqualTo(pcmp_isalpha, 1) ThenBlock: {
                        pcmp_peek = Parser.pos
                        pcmp_peek_done = 0
                        WhileLoop And(LessThan(pcmp_peek, Parser.line_len), EqualTo(pcmp_peek_done, 0)) {
                            pcmp_peek_ch = GetByte(Parser.line_ptr, pcmp_peek)
                            pcmp_peek_alpha = PIsAlpha(pcmp_peek_ch)
                            IfCondition EqualTo(pcmp_peek_alpha, 1) ThenBlock: {
                                pcmp_peek = Add(pcmp_peek, 1)
                            } ElseBlock: {
                                pcmp_peek_done = 1
                            }
                        }
                        IfCondition LessThan(pcmp_peek, Parser.line_len) ThenBlock: {
                            pcmp_peek_ch = GetByte(Parser.line_ptr, pcmp_peek)
                            IfCondition EqualTo(pcmp_peek_ch, 36) ThenBlock: {
                                pcmp_is_string = 1
                            }
                        }
                    }
                }
            }
        }
        
        // Handle string comparison
        IfCondition EqualTo(pcmp_is_string, 1) ThenBlock: {
            pcmp_left_str = PStrExpr()
            PSkipSpaces()
            
            IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
                // No operator, just return if string is non-empty (truthy)
                pcmp_len = StringLength(pcmp_left_str)
                Deallocate(pcmp_left_str, 0)
                IfCondition GreaterThan(pcmp_len, 0) ThenBlock: {
                    ReturnValue(-1)
                }
                ReturnValue(0)
            }
            
            pcmp_op = GetByte(Parser.line_ptr, Parser.pos)
            
            // = operator
            IfCondition EqualTo(pcmp_op, 61) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
                pcmp_right_str = PStrExpr()
                pcmp_cmp = StringCompare(pcmp_left_str, pcmp_right_str)
                Deallocate(pcmp_left_str, 0)
                Deallocate(pcmp_right_str, 0)
                IfCondition EqualTo(pcmp_cmp, 0) ThenBlock: {
                    ReturnValue(-1)
                }
                ReturnValue(0)
            }
            
            // <> operator
            IfCondition EqualTo(pcmp_op, 60) ThenBlock: {
                pcmp_next_pos = Add(Parser.pos, 1)
                IfCondition LessThan(pcmp_next_pos, Parser.line_len) ThenBlock: {
                    pcmp_next_ch = GetByte(Parser.line_ptr, pcmp_next_pos)
                    IfCondition EqualTo(pcmp_next_ch, 62) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 2)
                        pcmp_right_str = PStrExpr()
                        pcmp_cmp = StringCompare(pcmp_left_str, pcmp_right_str)
                        Deallocate(pcmp_left_str, 0)
                        Deallocate(pcmp_right_str, 0)
                        IfCondition NotEqual(pcmp_cmp, 0) ThenBlock: {
                            ReturnValue(-1)
                        }
                        ReturnValue(0)
                    }
                }
            }
            
            // < operator (string comparison)
            IfCondition EqualTo(pcmp_op, 60) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
                pcmp_right_str = PStrExpr()
                pcmp_cmp = StringCompare(pcmp_left_str, pcmp_right_str)
                Deallocate(pcmp_left_str, 0)
                Deallocate(pcmp_right_str, 0)
                IfCondition LessThan(pcmp_cmp, 0) ThenBlock: {
                    ReturnValue(-1)
                }
                ReturnValue(0)
            }
            
            // > operator (string comparison)
            IfCondition EqualTo(pcmp_op, 62) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
                pcmp_right_str = PStrExpr()
                pcmp_cmp = StringCompare(pcmp_left_str, pcmp_right_str)
                Deallocate(pcmp_left_str, 0)
                Deallocate(pcmp_right_str, 0)
                IfCondition GreaterThan(pcmp_cmp, 0) ThenBlock: {
                    ReturnValue(-1)
                }
                ReturnValue(0)
            }
            
            // No valid operator found
            Deallocate(pcmp_left_str, 0)
            ReturnValue(0)
        }
        
        pcmp_left = PExpr()
        PSkipSpaces()
        
        IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
            IfCondition EqualTo(Float_Eq(pcmp_left, BasicNum.zero), 1) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(-1)
        }
        
        pcmp_ch = GetByte(Parser.line_ptr, Parser.pos)
        
        IfCondition EqualTo(pcmp_ch, 61) ThenBlock: {
            Parser.pos = Add(Parser.pos, 1)
            pcmp_right = PExpr()
            IfCondition EqualTo(Float_Eq(pcmp_left, pcmp_right), 1) ThenBlock: { ReturnValue(-1) }
            ReturnValue(0)
        }
        
        IfCondition EqualTo(pcmp_ch, 60) ThenBlock: {
            Parser.pos = Add(Parser.pos, 1)
            IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
                pcmp_nch = GetByte(Parser.line_ptr, Parser.pos)
                IfCondition EqualTo(pcmp_nch, 62) ThenBlock: {
                    Parser.pos = Add(Parser.pos, 1)
                    pcmp_right = PExpr()
                    IfCondition EqualTo(Float_Ne(pcmp_left, pcmp_right), 1) ThenBlock: { ReturnValue(-1) }
                    ReturnValue(0)
                }
                IfCondition EqualTo(pcmp_nch, 61) ThenBlock: {
                    Parser.pos = Add(Parser.pos, 1)
                    pcmp_right = PExpr()
                    IfCondition EqualTo(Float_Le(pcmp_left, pcmp_right), 1) ThenBlock: { ReturnValue(-1) }
                    ReturnValue(0)
                }
            }
            pcmp_right = PExpr()
            IfCondition EqualTo(Float_Lt(pcmp_left, pcmp_right), 1) ThenBlock: { ReturnValue(-1) }
            ReturnValue(0)
        }
        
        IfCondition EqualTo(pcmp_ch, 62) ThenBlock: {
            Parser.pos = Add(Parser.pos, 1)
            IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
                pcmp_nch = GetByte(Parser.line_ptr, Parser.pos)
                IfCondition EqualTo(pcmp_nch, 61) ThenBlock: {
                    Parser.pos = Add(Parser.pos, 1)
                    pcmp_right = PExpr()
                    IfCondition EqualTo(Float_Ge(pcmp_left, pcmp_right), 1) ThenBlock: { ReturnValue(-1) }
                    ReturnValue(0)
                }
            }
            pcmp_right = PExpr()
            IfCondition EqualTo(Float_Gt(pcmp_left, pcmp_right), 1) ThenBlock: { ReturnValue(-1) }
            ReturnValue(0)
        }
        
        IfCondition EqualTo(Float_Eq(pcmp_left, BasicNum.zero), 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// COMMANDS (Modified for TUI output)
// =============================================================================
Function.CmdPrint {
    Body: {
        print_newline = 1
        print_done = 0
        
        WhileLoop EqualTo(print_done, 0) {
            PSkipSpaces()
            
            // Check if we've reached end of line
            IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
                print_done = 1
            } ElseBlock: {
                print_ch = GetByte(Parser.line_ptr, Parser.pos)
                
                // === STRING LITERAL: "..." or "..."+"..." ===
                // Use PStrExpr to handle concatenation
                IfCondition EqualTo(print_ch, 34) ThenBlock: {
                    print_str = PStrExpr()
                    C64_Print(print_str)
                    Deallocate(print_str, 0)
                    print_newline = 1
                    
                // === SEMICOLON: suppress newline, no space ===
                } ElseBlock: {
                    IfCondition EqualTo(print_ch, 59) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                        print_newline = 0
                        
                    // === COMMA: tab to next column ===
                    } ElseBlock: {
                        IfCondition EqualTo(print_ch, 44) ThenBlock: {
                            Parser.pos = Add(Parser.pos, 1)
                            C64_PrintZone()
                            print_newline = 0
                            
                        // === COLON: end of this statement ===
                        } ElseBlock: {
                            IfCondition EqualTo(print_ch, 58) ThenBlock: {
                                print_done = 1
                                
                            // === Something else: variable, function, or expression ===
                            } ElseBlock: {
                                // First check: is it a string variable like A$ ?
                                print_svidx = PCheckStringVar()
                                IfCondition GreaterEqual(print_svidx, 0) ThenBlock: {
                                    // It's a string variable - use PStrExpr for possible concatenation
                                    print_str = PStrExpr()
                                    C64_Print(print_str)
                                    Deallocate(print_str, 0)
                                    print_newline = 1
                                } ElseBlock: {
                                    // Second check: is it a string function like LEFT$, CHR$, etc?
                                    print_is_strfunc = 0
                                    print_isalpha = PIsAlpha(print_ch)
                                    
                                    IfCondition EqualTo(print_isalpha, 1) ThenBlock: {
                                        // Peek ahead to see if word ends with $
                                        // Don't consume any input, just look
                                        print_peek = Parser.pos
                                        print_peek_done = 0
                                        
                                        // Skip over alphabetic characters
                                        WhileLoop And(LessThan(print_peek, Parser.line_len), EqualTo(print_peek_done, 0)) {
                                            print_peek_ch = GetByte(Parser.line_ptr, print_peek)
                                            print_peek_alpha = PIsAlpha(print_peek_ch)
                                            IfCondition EqualTo(print_peek_alpha, 1) ThenBlock: {
                                                print_peek = Add(print_peek, 1)
                                            } ElseBlock: {
                                                print_peek_done = 1
                                            }
                                        }
                                        
                                        // Check if the character after the word is $
                                        IfCondition LessThan(print_peek, Parser.line_len) ThenBlock: {
                                            print_peek_ch = GetByte(Parser.line_ptr, print_peek)
                                            IfCondition EqualTo(print_peek_ch, 36) ThenBlock: {
                                                // Yes, it's a string function (ends with $)
                                                print_is_strfunc = 1
                                            }
                                        }
                                    }
                                    
                                    // Now handle based on what we detected
                                    IfCondition EqualTo(print_is_strfunc, 1) ThenBlock: {
                                        print_str = PStrExpr()
                                        C64_Print(print_str)
                                        Deallocate(print_str, 0)
                                        print_newline = 1
                                    } ElseBlock: {
                                        print_is_tab = 0
                                        IfCondition EqualTo(print_isalpha, 1) ThenBlock: {
                                            print_save = Parser.pos
                                            print_w = ParseWord()
                                            print_kw = MatchKW(print_w)
                                            Deallocate(print_w, 0)
                                            IfCondition EqualTo(print_kw, 49) ThenBlock: {
                                                print_is_tab = 1
                                                tabarg = PEatArg()
                                                C64_PrintTab(tabarg)
                                                print_newline = 1
                                            } ElseBlock: {
                                                Parser.pos = print_save
                                            }
                                        }
                                        IfCondition EqualTo(print_is_tab, 0) ThenBlock: {
                                            print_val = PExpr()
                                            C64_PrintNum(print_val)
                                            print_newline = 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        
        // Print newline unless suppressed by semicolon
        IfCondition EqualTo(print_newline, 1) ThenBlock: {
            C64_NewLine()
        }
    }
}

Function.CmdLet {
    Body: {
        PSkipSpaces()
        
        // Check if it's a string variable
        svidx = PCheckStringVar()
        IfCondition GreaterEqual(svidx, 0) ThenBlock: {
            // String assignment: A$ = "value"
            PParseStringVarName()
            PSkipSpaces()
            ch = GetByte(Parser.line_ptr, Parser.pos)
            IfCondition EqualTo(ch, 61) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
            }
            str_val = PStrExpr()
            SetStringVar(svidx, str_val)
            Deallocate(str_val, 0)
            ReturnValue(0)
        }
        
        // Numeric assignment: array or scalar
        lsave = Parser.pos
        lch = GetByte(Parser.line_ptr, Parser.pos)
        isarr = 0
        lalpha = PIsAlpha(lch)
        IfCondition EqualTo(lalpha, 1) ThenBlock: {
            tpos = Add(Parser.pos, 1)
            tch = PCharAt(tpos)
            tdig = PIsDigit(tch)
            IfCondition EqualTo(tdig, 1) ThenBlock: {
                tpos = Add(tpos, 1)
            }
            tpos = PSkipFrom(tpos)
            tch = PCharAt(tpos)
            IfCondition EqualTo(tch, 40) ThenBlock: {
                npos = Add(Parser.pos, 1)
                nch = PCharAt(npos)
                ndig = PIsDigit(nch)
                IfCondition EqualTo(ndig, 0) ThenBlock: {
                    isarr = 1
                }
            }
        }
        IfCondition EqualTo(isarr, 1) ThenBlock: {
            letter = PParseArrayRef()
            PSkipSpaces()
            lc = GetByte(Parser.line_ptr, Parser.pos)
            IfCondition EqualTo(lc, 61) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
            }
            lval = PExpr()
            ArrSet(letter, lval)
            ReturnValue(0)
        }

        lvidx = PParseScalarIdx()
        PSkipSpaces()
        lc = GetByte(Parser.line_ptr, Parser.pos)
        IfCondition EqualTo(lc, 61) ThenBlock: {
            Parser.pos = Add(Parser.pos, 1)
        }
        lval = PExpr()
        IfCondition And(GreaterEqual(lvidx, 0), LessThan(lvidx, 286)) ThenBlock: {
            ArraySet(BState.vars_ptr, lvidx, lval)
        }
    }
}

Function.CmdInput {
    Body: {
        PSkipSpaces()
        ch = GetByte(Parser.line_ptr, Parser.pos)
        
        // Optional prompt string
        IfCondition EqualTo(ch, 34) ThenBlock: {
            prompt = PParseStr()
            C64_Print(prompt)
            Deallocate(prompt, 0)
            PSkipSpaces()
            ch = GetByte(Parser.line_ptr, Parser.pos)
            IfCondition EqualTo(ch, 59) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
            }
            IfCondition EqualTo(ch, 44) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
            }
        } ElseBlock: {
            C64_Print("? ")
        }
        
        PSkipSpaces()
        
        // Check if it's a string variable
        svidx = PCheckStringVar()
        IfCondition GreaterEqual(svidx, 0) ThenBlock: {
            // String input
            PParseStringVarName()
            inp = C64_ReadLine()
            SetStringVar(svidx, inp)
            Deallocate(inp, 0)
            ReturnValue(0)
        }
        
        isarr = 0
        ch = GetByte(Parser.line_ptr, Parser.pos)
        ialpha = PIsAlpha(ch)
        IfCondition EqualTo(ialpha, 1) ThenBlock: {
            tpos = Add(Parser.pos, 1)
            tpos = PSkipFrom(tpos)
            tch = PCharAt(tpos)
            IfCondition EqualTo(tch, 40) ThenBlock: {
                isarr = 1
            }
        }
        IfCondition EqualTo(isarr, 1) ThenBlock: {
            letter = PParseArrayRef()
            inp = C64_ReadLine()
            val = BasicNum.ParseStr(inp)
            Deallocate(inp, 0)
            ArrSet(letter, val)
            ReturnValue(0)
        }
        vidx = PParseScalarIdx()
        inp = C64_ReadLine()
        val = BasicNum.ParseStr(inp)
        Deallocate(inp, 0)
        IfCondition And(GreaterEqual(vidx, 0), LessThan(vidx, 286)) ThenBlock: {
            ArraySet(BState.vars_ptr, vidx, val)
        }
    }
}

// =============================================================================
// KEYWORD MATCHING
// =============================================================================
Function.MatchKW {
    Input: word: Address
    Output: Integer
    Body: {
        // Core commands: 1-19
        c = StringCompare(word, "PRINT")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(1) }
        c = StringCompare(word, "LET")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(2) }
        c = StringCompare(word, "GOTO")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(3) }
        c = StringCompare(word, "GOSUB")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(4) }
        c = StringCompare(word, "RETURN")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(5) }
        c = StringCompare(word, "IF")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(6) }
        c = StringCompare(word, "THEN")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(7) }
        c = StringCompare(word, "FOR")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(8) }
        c = StringCompare(word, "TO")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(9) }
        c = StringCompare(word, "STEP")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(10) }
        c = StringCompare(word, "NEXT")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(11) }
        c = StringCompare(word, "INPUT")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(12) }
        c = StringCompare(word, "REM")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(13) }
        c = StringCompare(word, "END")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(14) }
        c = StringCompare(word, "LIST")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(15) }
        c = StringCompare(word, "RUN")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(16) }
        c = StringCompare(word, "NEW")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(17) }
        c = StringCompare(word, "CLR")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(18) }
        c = StringCompare(word, "CLS")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(19) }
        
        // Math functions: 20-29
        c = StringCompare(word, "ABS")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(20) }
        c = StringCompare(word, "SGN")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(21) }
        c = StringCompare(word, "INT")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(22) }
        c = StringCompare(word, "SQR")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(23) }
        c = StringCompare(word, "RND")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(24) }
        c = StringCompare(word, "PEEK")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(25) }
        
        // POKE is a statement, not function: 26
        c = StringCompare(word, "POKE")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(26) }
        
        // File I/O: 27-28
        c = StringCompare(word, "SAVE")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(27) }
        c = StringCompare(word, "LOAD")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(28) }
        
        // String functions: 30-39
        c = StringCompare(word, "LEN")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(30) }
        c = StringCompare(word, "ASC")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(31) }
        c = StringCompare(word, "VAL")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(32) }
        
        // DATA/READ/RESTORE: 40-42
        c = StringCompare(word, "DATA")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(40) }
        c = StringCompare(word, "READ")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(41) }
        c = StringCompare(word, "RESTORE")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(42) }
        
        c = StringCompare(word, "ON")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(43) }
        c = StringCompare(word, "STOP")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(44) }
        c = StringCompare(word, "DIM")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(45) }
        c = StringCompare(word, "DEF")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(46) }
        c = StringCompare(word, "OPTION")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(47) }
        c = StringCompare(word, "RANDOMIZE")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(48) }
        c = StringCompare(word, "TAB")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(49) }
        c = StringCompare(word, "SIN")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(50) }
        c = StringCompare(word, "COS")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(51) }
        c = StringCompare(word, "TAN")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(52) }
        c = StringCompare(word, "ATN")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(53) }
        c = StringCompare(word, "LOG")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(54) }
        c = StringCompare(word, "EXP")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(55) }
        
        ReturnValue(0)
    }
}

Function.ParseWord {
    Output: Address
    Body: {
        pw_start = Parser.pos
        
        // Consume alphanumeric characters
        pw_done = 0
        WhileLoop And(LessThan(Parser.pos, Parser.line_len), EqualTo(pw_done, 0)) {
            pw_ch = GetByte(Parser.line_ptr, Parser.pos)
            pw_ok = PIsAlpha(pw_ch)
            IfCondition EqualTo(pw_ok, 0) ThenBlock: {
                pw_ok = PIsDigit(pw_ch)
            }
            IfCondition EqualTo(pw_ok, 1) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
            } ElseBlock: {
                pw_done = 1
            }
        }
        
        // Check if next char is $ (for string functions like CHR$, LEFT$, etc.)
        IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
            pw_ch = GetByte(Parser.line_ptr, Parser.pos)
            IfCondition EqualTo(pw_ch, 36) ThenBlock: {
                // Include the $ in the word
                Parser.pos = Add(Parser.pos, 1)
            }
        }
        
        // Calculate word length and allocate
        pw_len = Subtract(Parser.pos, pw_start)
        pw_bufsize = Add(pw_len, 1)
        pw_word = Allocate(pw_bufsize)
        
        // Copy characters, converting to uppercase
        pw_i = 0
        WhileLoop LessThan(pw_i, pw_len) {
            pw_srcpos = Add(pw_start, pw_i)
            pw_ch = GetByte(Parser.line_ptr, pw_srcpos)
            pw_uch = PToUpper(pw_ch)
            SetByte(pw_word, pw_i, pw_uch)
            pw_i = Add(pw_i, 1)
        }
        SetByte(pw_word, pw_len, 0)
        
        ReturnValue(pw_word)
    }
}

// =============================================================================
// FIND LINE BY NUMBER
// =============================================================================
Function.FindLine {
    Input: num: Integer
    Output: Integer
    Body: {
        count = Array.Size(BState.prog_nums_ptr)
        i = 0
        WhileLoop LessThan(i, count) {
            n = Array.Get(BState.prog_nums_ptr, i)
            IfCondition EqualTo(n, num) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// GOTO / GOSUB / RETURN
// =============================================================================
Function.CmdGoto {
    Output: Integer
    Body: {
        PSkipSpaces()
        target = PParseInt()
        idx = FindLine(target)
        IfCondition EqualTo(idx, -1) ThenBlock: {
            C64_Print("?UNDEF'D STATEMENT ERROR\n")
            BState.error_flag = 1
            ReturnValue(-1)
        }
        BState.current_idx = idx
        ReturnValue(-2)
    }
}

Function.CmdGosub {
    Output: Integer
    Body: {
        sp = BState.gosub_sp
        IfCondition GreaterEqual(sp, 32) ThenBlock: {
            C64_Error("OUT OF MEMORY")
            ReturnValue(-1)
        }
        
        ArraySet(BState.gosub_stack_ptr, sp, Add(BState.current_idx, 1))
        BState.gosub_sp = Add(sp, 1)
        
        ReturnValue(CmdGoto())
    }
}

Function.CmdReturn {
    Output: Integer
    Body: {
        sp = BState.gosub_sp
        IfCondition EqualTo(sp, 0) ThenBlock: {
            C64_Error("RETURN WITHOUT GOSUB")
            ReturnValue(-1)
        }
        
        sp = Subtract(sp, 1)
        BState.gosub_sp = sp
        ret = ArrayGet(BState.gosub_stack_ptr, sp)
        BState.current_idx = ret
        ReturnValue(-2)
    }
}

// =============================================================================
// DATA/READ SUPPORT
// =============================================================================

// Find next DATA value in program
Function.FindNextData {
    Output: Address
    Body: {
        prog_count = Array.Size(BState.prog_nums_ptr)
        
        // Search from current data position
        WhileLoop LessThan(BState.data_line_idx, prog_count) {
            line_text = Array.Get(BState.prog_text_ptr, BState.data_line_idx)
            line_len = StringLength(line_text)
            
            // If at start of line, check if it's a DATA line
            IfCondition EqualTo(BState.data_pos, 0) ThenBlock: {
                // Skip leading spaces
                skip_sp = 1
                WhileLoop And(LessThan(BState.data_pos, line_len), EqualTo(skip_sp, 1)) {
                    ch = GetByte(line_text, BState.data_pos)
                    IfCondition Or(EqualTo(ch, 32), EqualTo(ch, 9)) ThenBlock: {
                        BState.data_pos = Add(BState.data_pos, 1)
                    } ElseBlock: {
                        skip_sp = 0
                    }
                }
                
                // Check for DATA keyword (need at least 4 chars)
                is_data = 0
                remaining = Subtract(line_len, BState.data_pos)
                IfCondition GreaterEqual(remaining, 4) ThenBlock: {
                    p1 = BState.data_pos
                    p2 = Add(p1, 1)
                    p3 = Add(p1, 2)
                    p4 = Add(p1, 3)
                    c1 = GetByte(line_text, p1)
                    c2 = GetByte(line_text, p2)
                    c3 = GetByte(line_text, p3)
                    c4 = GetByte(line_text, p4)
                    
                    // Convert to upper case
                    IfCondition And(GreaterEqual(c1, 97), LessEqual(c1, 122)) ThenBlock: {
                        c1 = Subtract(c1, 32)
                    }
                    IfCondition And(GreaterEqual(c2, 97), LessEqual(c2, 122)) ThenBlock: {
                        c2 = Subtract(c2, 32)
                    }
                    IfCondition And(GreaterEqual(c3, 97), LessEqual(c3, 122)) ThenBlock: {
                        c3 = Subtract(c3, 32)
                    }
                    IfCondition And(GreaterEqual(c4, 97), LessEqual(c4, 122)) ThenBlock: {
                        c4 = Subtract(c4, 32)
                    }
                    
                    // Check D-A-T-A (68-65-84-65)
                    IfCondition EqualTo(c1, 68) ThenBlock: {
                        IfCondition EqualTo(c2, 65) ThenBlock: {
                            IfCondition EqualTo(c3, 84) ThenBlock: {
                                IfCondition EqualTo(c4, 65) ThenBlock: {
                                    is_data = 1
                                    BState.data_pos = Add(BState.data_pos, 4)
                                }
                            }
                        }
                    }
                }
                
                IfCondition EqualTo(is_data, 0) ThenBlock: {
                    // Not a DATA line, move to next
                    BState.data_line_idx = Add(BState.data_line_idx, 1)
                    BState.data_pos = 0
                    ContinueLoop
                }
            }
            
            // Skip spaces
            skip_sp2 = 1
            WhileLoop And(LessThan(BState.data_pos, line_len), EqualTo(skip_sp2, 1)) {
                ch = GetByte(line_text, BState.data_pos)
                IfCondition Or(EqualTo(ch, 32), EqualTo(ch, 9)) ThenBlock: {
                    BState.data_pos = Add(BState.data_pos, 1)
                } ElseBlock: {
                    skip_sp2 = 0
                }
            }
            
            // Check for end of line
            IfCondition GreaterEqual(BState.data_pos, line_len) ThenBlock: {
                BState.data_line_idx = Add(BState.data_line_idx, 1)
                BState.data_pos = 0
                ContinueLoop
            }
            
            // Skip comma if present
            ch = GetByte(line_text, BState.data_pos)
            IfCondition EqualTo(ch, 44) ThenBlock: {
                BState.data_pos = Add(BState.data_pos, 1)
                // Skip spaces after comma
                skip_sp3 = 1
                WhileLoop And(LessThan(BState.data_pos, line_len), EqualTo(skip_sp3, 1)) {
                    ch = GetByte(line_text, BState.data_pos)
                    IfCondition Or(EqualTo(ch, 32), EqualTo(ch, 9)) ThenBlock: {
                        BState.data_pos = Add(BState.data_pos, 1)
                    } ElseBlock: {
                        skip_sp3 = 0
                    }
                }
            }
            
            // Check for end of line again after comma
            IfCondition GreaterEqual(BState.data_pos, line_len) ThenBlock: {
                BState.data_line_idx = Add(BState.data_line_idx, 1)
                BState.data_pos = 0
                ContinueLoop
            }
            
            // Now extract the data value
            ch = GetByte(line_text, BState.data_pos)
            
            // String value (quoted)
            IfCondition EqualTo(ch, 34) ThenBlock: {
                BState.data_pos = Add(BState.data_pos, 1)
                start = BState.data_pos
                find_quote = 1
                WhileLoop And(LessThan(BState.data_pos, line_len), EqualTo(find_quote, 1)) {
                    ch = GetByte(line_text, BState.data_pos)
                    IfCondition EqualTo(ch, 34) ThenBlock: {
                        find_quote = 0
                    } ElseBlock: {
                        BState.data_pos = Add(BState.data_pos, 1)
                    }
                }
                slen = Subtract(BState.data_pos, start)
                bufsize = Add(slen, 1)
                result = Allocate(bufsize)
                i = 0
                WhileLoop LessThan(i, slen) {
                    src_idx = Add(start, i)
                    ch = GetByte(line_text, src_idx)
                    SetByte(result, i, ch)
                    i = Add(i, 1)
                }
                SetByte(result, slen, 0)
                BState.data_pos = Add(BState.data_pos, 1)
                ReturnValue(result)
            }
            
            // Numeric or unquoted string value
            start = BState.data_pos
            find_end = 1
            WhileLoop And(LessThan(BState.data_pos, line_len), EqualTo(find_end, 1)) {
                ch = GetByte(line_text, BState.data_pos)
                IfCondition Or(EqualTo(ch, 44), EqualTo(ch, 58)) ThenBlock: {
                    find_end = 0
                } ElseBlock: {
                    BState.data_pos = Add(BState.data_pos, 1)
                }
            }
            
            // Trim trailing spaces
            end_pos = BState.data_pos
            trim_done = 0
            WhileLoop And(GreaterThan(end_pos, start), EqualTo(trim_done, 0)) {
                prev = Subtract(end_pos, 1)
                ch = GetByte(line_text, prev)
                IfCondition Or(EqualTo(ch, 32), EqualTo(ch, 9)) ThenBlock: {
                    end_pos = prev
                } ElseBlock: {
                    trim_done = 1
                }
            }
            
            slen = Subtract(end_pos, start)
            bufsize = Add(slen, 1)
            result = Allocate(bufsize)
            i = 0
            WhileLoop LessThan(i, slen) {
                src_idx = Add(start, i)
                ch = GetByte(line_text, src_idx)
                SetByte(result, i, ch)
                i = Add(i, 1)
            }
            SetByte(result, slen, 0)
            ReturnValue(result)
        }
        
        // No more DATA
        ReturnValue(0)
    }
}

// READ command
Function.CmdRead {
    Body: {
        read_done = 0
        WhileLoop EqualTo(read_done, 0) {
            PSkipSpaces()
            
            IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
                read_done = 1
            } ElseBlock: {
                ch = GetByte(Parser.line_ptr, Parser.pos)
                
                // Check for string variable
                svidx = PCheckStringVar()
                IfCondition GreaterEqual(svidx, 0) ThenBlock: {
                    PParseStringVarName()
                    data_val = FindNextData()
                    IfCondition EqualTo(data_val, 0) ThenBlock: {
                        C64_Error("OUT OF DATA")
                        ReturnValue(0)
                    }
                    SetStringVar(svidx, data_val)
                    Deallocate(data_val, 0)
                } ElseBlock: {
                    isalph = PIsAlpha(ch)
                    IfCondition EqualTo(isalph, 1) ThenBlock: {
                        isarr = 0
                        tpos = Add(Parser.pos, 1)
                        tpos = PSkipFrom(tpos)
                        tch = PCharAt(tpos)
                        IfCondition EqualTo(tch, 40) ThenBlock: {
                            npos = Add(Parser.pos, 1)
                            nch = PCharAt(npos)
                            ndig = PIsDigit(nch)
                            IfCondition EqualTo(ndig, 0) ThenBlock: {
                                isarr = 1
                            }
                        }
                        data_val = FindNextData()
                        IfCondition EqualTo(data_val, 0) ThenBlock: {
                            C64_Error("OUT OF DATA")
                            ReturnValue(0)
                        }
                        num_val = BasicNum.ParseStr(data_val)
                        Deallocate(data_val, 0)
                        IfCondition EqualTo(isarr, 1) ThenBlock: {
                            letter = PParseArrayRef()
                            ArrSet(letter, num_val)
                        } ElseBlock: {
                            vidx = PParseScalarIdx()
                            IfCondition And(GreaterEqual(vidx, 0), LessThan(vidx, 286)) ThenBlock: {
                                ArraySet(BState.vars_ptr, vidx, num_val)
                            }
                        }
                    } ElseBlock: {
                        read_done = 1
                    }
                }
                
                // Check for comma (more variables)
                PSkipSpaces()
                IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
                    ch = GetByte(Parser.line_ptr, Parser.pos)
                    IfCondition EqualTo(ch, 44) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                    } ElseBlock: {
                        read_done = 1
                    }
                }
            }
        }
    }
}

// =============================================================================
// ON x GOTO/GOSUB
// =============================================================================
Function.CmdOn {
    Output: Integer
    Body: {
        idxf = PExpr()
        idx = BasicNum.ToInt(idxf)
        
        PSkipSpaces()
        word = ParseWord()
        
        is_gosub = 0
        cmp = StringCompare(word, "GOSUB")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            is_gosub = 1
        }
        Deallocate(word, 0)
        
        // Parse line numbers
        line_nums = ArrayCreate(20)
        line_count = 0
        
        parse_lines = 1
        WhileLoop EqualTo(parse_lines, 1) {
            PSkipSpaces()
            IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
                parse_lines = 0
            } ElseBlock: {
                ch = GetByte(Parser.line_ptr, Parser.pos)
                isdig = PIsDigit(ch)
                IfCondition EqualTo(isdig, 1) ThenBlock: {
                    line_num = PParseInt()
                    ArraySet(line_nums, line_count, line_num)
                    line_count = Add(line_count, 1)
                    
                    PSkipSpaces()
                    IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
                        ch = GetByte(Parser.line_ptr, Parser.pos)
                        IfCondition EqualTo(ch, 44) ThenBlock: {
                            Parser.pos = Add(Parser.pos, 1)
                        } ElseBlock: {
                            parse_lines = 0
                        }
                    }
                } ElseBlock: {
                    parse_lines = 0
                }
            }
        }
        
        // Check if index is valid (1-based)
        IfCondition Or(LessThan(idx, 1), GreaterThan(idx, line_count)) ThenBlock: {
            ArrayDestroy(line_nums)
            ReturnValue(0)
        }
        
        // Get target line number
        arr_idx = Subtract(idx, 1)
        target = ArrayGet(line_nums, arr_idx)
        ArrayDestroy(line_nums)
        
        // Find line index
        line_idx = FindLine(target)
        IfCondition EqualTo(line_idx, -1) ThenBlock: {
            C64_Error("UNDEF'D STATEMENT")
            ReturnValue(-1)
        }
        
        // GOSUB needs to push return address
        IfCondition EqualTo(is_gosub, 1) ThenBlock: {
            sp = BState.gosub_sp
            IfCondition GreaterEqual(sp, 32) ThenBlock: {
                C64_Error("OUT OF MEMORY")
                ReturnValue(-1)
            }
            next_idx = Add(BState.current_idx, 1)
            ArraySet(BState.gosub_stack_ptr, sp, next_idx)
            BState.gosub_sp = Add(sp, 1)
        }
        
        BState.current_idx = line_idx
        ReturnValue(-2)
    }
}


// =============================================================================
// IF/THEN
// =============================================================================
Function.CmdIf {
    Output: Integer
    Body: {
        cond = PCompare()
        
        PSkipSpaces()
        word = ParseWord()
        Deallocate(word, 0)
        
        IfCondition EqualTo(cond, 0) ThenBlock: {
            Parser.pos = Parser.line_len
            ReturnValue(0)
        }
        
        PSkipSpaces()
        IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
            ch = GetByte(Parser.line_ptr, Parser.pos)
            isdig = PIsDigit(ch)
            IfCondition EqualTo(isdig, 1) ThenBlock: {
                ReturnValue(CmdGoto())
            }
        }
        
        ReturnValue(ExecStmt())
    }
}

// =============================================================================
// FOR/NEXT
// =============================================================================
Function.CmdFor {
    Body: {
        PSkipSpaces()
        vidx = PParseScalarIdx()
        
        PSkipSpaces()
        ch = GetByte(Parser.line_ptr, Parser.pos)
        IfCondition EqualTo(ch, 61) ThenBlock: {
            Parser.pos = Add(Parser.pos, 1)
        }
        
        init = PExpr()
        
        PSkipSpaces()
        toword = ParseWord()
        Deallocate(toword, 0)
        
        limit = PExpr()
        
        step = BasicNum.one
        PSkipSpaces()
        IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
            stepsave = Parser.pos
            stepword = ParseWord()
            stepkw = MatchKW(stepword)
            Deallocate(stepword, 0)
            IfCondition EqualTo(stepkw, 10) ThenBlock: {
                step = PExpr()
            } ElseBlock: {
                Parser.pos = stepsave
            }
        }

        IfCondition And(GreaterEqual(vidx, 0), LessThan(vidx, 286)) ThenBlock: {
            ArraySet(BState.vars_ptr, vidx, init)
        }
        
        fsp = BState.for_sp
        IfCondition LessThan(fsp, 16) ThenBlock: {
            for_var_arr = BState.for_var_ptr
            for_limit_arr = BState.for_limit_ptr
            for_step_arr = BState.for_step_ptr
            for_line_arr = BState.for_line_ptr
            
            ArraySet(for_var_arr, fsp, vidx)
            ArraySet(for_limit_arr, fsp, limit)
            ArraySet(for_step_arr, fsp, step)
            // Store the NEXT line to jump to (line after FOR)
            next_line = Add(BState.current_idx, 1)
            ArraySet(for_line_arr, fsp, next_line)
            BState.for_sp = Add(fsp, 1)
        }
    }
}

Function.CmdNext {
    Output: Integer
    Body: {
        nsp = BState.for_sp
        IfCondition EqualTo(nsp, 0) ThenBlock: {
            C64_Error("NEXT WITHOUT FOR")
            ReturnValue(-1)
        }
        
        nsp = Subtract(nsp, 1)
        
        // Read FOR stack - avoid any nested calls
        for_var_arr = BState.for_var_ptr
        for_limit_arr = BState.for_limit_ptr
        for_step_arr = BState.for_step_ptr
        for_line_arr = BState.for_line_ptr
        vars_arr = BState.vars_ptr
        
        nvidx = ArrayGet(for_var_arr, nsp)
        nlimit = ArrayGet(for_limit_arr, nsp)
        nstep = ArrayGet(for_step_arr, nsp)
        nloopln = ArrayGet(for_line_arr, nsp)
        
        // Get current value and increment
        ncur = ArrayGet(vars_arr, nvidx)
        ncur = Float_Add(ncur, nstep)
        ArraySet(vars_arr, nvidx, ncur)
        
        nisdone = 0
        IfCondition EqualTo(Float_Ge(nstep, BasicNum.zero), 1) ThenBlock: {
            IfCondition EqualTo(Float_Gt(ncur, nlimit), 1) ThenBlock: {
                nisdone = 1
            }
        } ElseBlock: {
            IfCondition EqualTo(Float_Lt(ncur, nlimit), 1) ThenBlock: {
                nisdone = 1
            }
        }
        
        IfCondition EqualTo(nisdone, 1) ThenBlock: {
            BState.for_sp = nsp
            ReturnValue(0)
        }
        
        BState.for_sp = Add(nsp, 1)
        BState.current_idx = nloopln
        ReturnValue(-2)
    }
}

// =============================================================================
// LIST
// =============================================================================
Function.CmdList {
    Body: {
        count = Array.Size(BState.prog_nums_ptr)
        i = 0
        WhileLoop LessThan(i, count) {
            num = Array.Get(BState.prog_nums_ptr, i)
            txt = Array.Get(BState.prog_text_ptr, i)
            C64_PrintInt(num)
            C64_Print(" ")
            C64_Print(txt)
            C64_NewLine()
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// RUN
// =============================================================================
Function.CmdRun {
    Body: {
        BState.running = 1
        BState.current_idx = 0
        BState.error_flag = 0
        BState.current_line_num = 0
        
        // Reset DATA pointer
        BState.data_line_idx = 0
        BState.data_pos = 0
        
        C64_Host_SetBusy(1)
        i = 0
        WhileLoop LessThan(i, 286) {
            ArraySet(BState.vars_ptr, i, 0)
            i = Add(i, 1)
        }
        BState.option_base = 0
        BState.option_set = 0
        BState.arrays_used = 0
        i = 0
        WhileLoop LessThan(i, 26) {
            ap = MetaGet(BState.arr_ptr, i)
            IfCondition NotEqual(ap, 0) ThenBlock: {
                Deallocate(ap, 0)
            }
            MetaSet(BState.arr_ptr, i, 0)
            MetaSet(BState.arr_d1, i, 0)
            MetaSet(BState.arr_d2, i, 0)
            MetaSet(BState.arr_rank, i, 0)
            fb = MetaGet(BState.fn_body, i)
            IfCondition NotEqual(fb, 0) ThenBlock: {
                Deallocate(fb, 0)
            }
            MetaSet(BState.fn_body, i, 0)
            MetaSet(BState.fn_dummy, i, 0)
            MetaSet(BState.fn_set, i, 0)
            i = Add(i, 1)
        }
        
        // Clear string variables
        sv = BState.str_vars_ptr
        i = 0
        WhileLoop LessThan(i, 26) {
            old_str = ArrayGet(sv, i)
            IfCondition NotEqual(old_str, 0) ThenBlock: {
                Deallocate(old_str, 0)
            }
            empty = Allocate(1)
            SetByte(empty, 0, 0)
            ArraySet(sv, i, empty)
            i = Add(i, 1)
        }
        
        BState.gosub_sp = 0
        BState.for_sp = 0
        
        count = Array.Size(BState.prog_nums_ptr)
        
        done = 0
        WhileLoop And(EqualTo(BState.running, 1), EqualTo(done, 0)) {
            IfCondition GreaterEqual(BState.current_idx, count) ThenBlock: {
                done = 1
            } ElseBlock: {
                // Get current line number for error reporting
                BState.current_line_num = Array.Get(BState.prog_nums_ptr, BState.current_idx)
                
                txt = Array.Get(BState.prog_text_ptr, BState.current_idx)
                old = BState.current_idx
                
                ExecLine(txt)
                
                IfCondition EqualTo(BState.current_idx, old) ThenBlock: {
                    BState.current_idx = Add(BState.current_idx, 1)
                }
                
                IfCondition EqualTo(BState.error_flag, 1) ThenBlock: {
                    BState.running = 0
                }
            }
        }
        
        BState.running = 0
        C64_Host_SetBusy(0)
    }
}

// =============================================================================
// NEW
// =============================================================================
Function.CmdNew {
    Body: {
        count = Array.Size(BState.prog_nums_ptr)
        i = 0
        WhileLoop LessThan(i, count) {
            txt = Array.Get(BState.prog_text_ptr, i)
            Deallocate(txt, 0)
            i = Add(i, 1)
        }
        Array.Clear(BState.prog_nums_ptr)
        Array.Clear(BState.prog_text_ptr)
        
        i = 0
        WhileLoop LessThan(i, 286) {
            ArraySet(BState.vars_ptr, i, 0)
            i = Add(i, 1)
        }
    }
}

Function.CmdDim {
    Body: {
        IfCondition EqualTo(BState.option_set, 0) ThenBlock: {
            BState.option_set = 1
        }
        dim_done = 0
        WhileLoop EqualTo(dim_done, 0) {
            PSkipSpaces()
            IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
                dim_done = 1
            } ElseBlock: {
                ch = GetByte(Parser.line_ptr, Parser.pos)
                da = PIsAlpha(ch)
                IfCondition EqualTo(da, 0) ThenBlock: {
                    dim_done = 1
                } ElseBlock: {
                    uch = PToUpper(ch)
                    letter = Subtract(uch, 65)
                    Parser.pos = Add(Parser.pos, 1)
                    IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
                        nch = GetByte(Parser.line_ptr, Parser.pos)
                        dd = PIsDigit(nch)
                        IfCondition EqualTo(dd, 1) ThenBlock: {
                            C64_Error("BAD ARRAY NAME")
                            ReturnValue(0)
                        }
                    }
                    PSkipSpaces()
                    ch = GetByte(Parser.line_ptr, Parser.pos)
                    IfCondition NotEqual(ch, 40) ThenBlock: {
                        C64_Error("SYNTAX")
                        ReturnValue(0)
                    }
                    Parser.pos = Add(Parser.pos, 1)
                    e1 = PExpr()
                    u1 = BasicNum.ToInt(e1)
                    rank = 1
                    u2 = 0
                    PSkipSpaces()
                    ch = GetByte(Parser.line_ptr, Parser.pos)
                    IfCondition EqualTo(ch, 44) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                        e2 = PExpr()
                        u2 = BasicNum.ToInt(e2)
                        rank = 2
                        PSkipSpaces()
                    }
                    IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
                        ch = GetByte(Parser.line_ptr, Parser.pos)
                        IfCondition EqualTo(ch, 41) ThenBlock: {
                            Parser.pos = Add(Parser.pos, 1)
                        }
                    }
                    oldr = MetaGet(BState.arr_rank, letter)
                    IfCondition NotEqual(oldr, 0) ThenBlock: {
                        ap = MetaGet(BState.arr_ptr, letter)
                        IfCondition NotEqual(ap, 0) ThenBlock: {
                            Deallocate(ap, 0)
                        }
                        MetaSet(BState.arr_rank, letter, 0)
                    }
                    ArrEnsure(letter, rank, u1, u2)
                    PSkipSpaces()
                    IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
                        ch = GetByte(Parser.line_ptr, Parser.pos)
                        IfCondition EqualTo(ch, 44) ThenBlock: {
                            Parser.pos = Add(Parser.pos, 1)
                        } ElseBlock: {
                            dim_done = 1
                        }
                    }
                }
            }
        }
    }
}

Function.CmdDef {
    Body: {
        PSkipSpaces()
        word = ParseWord()
        wlen = StringLength(word)
        IfCondition NotEqual(wlen, 3) ThenBlock: {
            Deallocate(word, 0)
            C64_Error("SYNTAX")
            ReturnValue(0)
        }
        c0 = GetByte(word, 0)
        c1 = GetByte(word, 1)
        c2 = GetByte(word, 2)
        Deallocate(word, 0)
        IfCondition NotEqual(c0, 70) ThenBlock: {
            C64_Error("SYNTAX")
            ReturnValue(0)
        }
        IfCondition NotEqual(c1, 78) ThenBlock: {
            C64_Error("SYNTAX")
            ReturnValue(0)
        }
        fn_idx = Subtract(c2, 65)
        PSkipSpaces()
        ch = GetByte(Parser.line_ptr, Parser.pos)
        IfCondition EqualTo(ch, 40) ThenBlock: {
            Parser.pos = Add(Parser.pos, 1)
        }
        dummy = PParseScalarIdx()
        PSkipSpaces()
        IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
            ch = GetByte(Parser.line_ptr, Parser.pos)
            IfCondition EqualTo(ch, 41) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
            }
        }
        PSkipSpaces()
        IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
            ch = GetByte(Parser.line_ptr, Parser.pos)
            IfCondition EqualTo(ch, 61) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
            }
        }
        PSkipSpaces()
        rest = Subtract(Parser.line_len, Parser.pos)
        bufsize = Add(rest, 1)
        body = Allocate(bufsize)
        i = 0
        WhileLoop LessThan(i, rest) {
            src = Add(Parser.pos, i)
            ch = GetByte(Parser.line_ptr, src)
            SetByte(body, i, ch)
            i = Add(i, 1)
        }
        SetByte(body, rest, 0)
        old = MetaGet(BState.fn_body, fn_idx)
        IfCondition NotEqual(old, 0) ThenBlock: {
            Deallocate(old, 0)
        }
        MetaSet(BState.fn_body, fn_idx, body)
        MetaSet(BState.fn_dummy, fn_idx, dummy)
        MetaSet(BState.fn_set, fn_idx, 1)
        Parser.pos = Parser.line_len
    }
}

Function.CmdOption {
    Body: {
        PSkipSpaces()
        word = ParseWord()
        Deallocate(word, 0)
        PSkipSpaces()
        b = PParseInt()
        IfCondition EqualTo(BState.arrays_used, 1) ThenBlock: {
            C64_Error("OPTION AFTER DIM")
            ReturnValue(0)
        }
        IfCondition And(NotEqual(b, 0), NotEqual(b, 1)) ThenBlock: {
            C64_Error("BAD OPTION")
            ReturnValue(0)
        }
        BState.option_base = b
        BState.option_set = 1
    }
}

Function.CmdRandomize {
    Body: {
        PSkipSpaces()
        IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
            ch = GetByte(Parser.line_ptr, Parser.pos)
            IfCondition And(NotEqual(ch, 58), GreaterThan(Parser.line_len, Parser.pos)) ThenBlock: {
                isdig = PIsDigit(ch)
                isalph = PIsAlpha(ch)
                IfCondition Or(EqualTo(isdig, 1), EqualTo(isalph, 1)) ThenBlock: {
                    seedf = PExpr()
                    seed = BasicNum.ToInt(seedf)
                    BasicNum.Randomize(seed)
                    ReturnValue(0)
                }
            }
        }
        BasicNum.Randomize(0)
    }
}

// =============================================================================
// EXECUTE STATEMENT
// =============================================================================
Function.ExecStmt {
    Output: Integer
    Body: {
        PSkipSpaces()
        
        IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
            ReturnValue(0)
        }
        
        ech = GetByte(Parser.line_ptr, Parser.pos)
        eisalph = PIsAlpha(ech)
        
        IfCondition EqualTo(eisalph, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        esave = Parser.pos
        eword = ParseWord()
        ekw = MatchKW(eword)
        Deallocate(eword, 0)
        
        IfCondition EqualTo(ekw, 1) ThenBlock: { CmdPrint() ReturnValue(0) }
        IfCondition EqualTo(ekw, 2) ThenBlock: { CmdLet() ReturnValue(0) }
        IfCondition EqualTo(ekw, 3) ThenBlock: { ReturnValue(CmdGoto()) }
        IfCondition EqualTo(ekw, 4) ThenBlock: { ReturnValue(CmdGosub()) }
        IfCondition EqualTo(ekw, 5) ThenBlock: { ReturnValue(CmdReturn()) }
        IfCondition EqualTo(ekw, 6) ThenBlock: { ReturnValue(CmdIf()) }
        IfCondition EqualTo(ekw, 8) ThenBlock: { CmdFor() ReturnValue(0) }
        IfCondition EqualTo(ekw, 11) ThenBlock: { ReturnValue(CmdNext()) }
        IfCondition EqualTo(ekw, 12) ThenBlock: { CmdInput() ReturnValue(0) }
        IfCondition EqualTo(ekw, 13) ThenBlock: { Parser.pos = Parser.line_len ReturnValue(0) }
        IfCondition EqualTo(ekw, 14) ThenBlock: { BState.running = 0 ReturnValue(-1) }
        IfCondition EqualTo(ekw, 44) ThenBlock: {
            C64_Print("BREAK")
            C64_NewLine()
            BState.running = 0
            ReturnValue(-1)
        }
        IfCondition EqualTo(ekw, 45) ThenBlock: { CmdDim() ReturnValue(0) }
        IfCondition EqualTo(ekw, 46) ThenBlock: { CmdDef() ReturnValue(0) }
        IfCondition EqualTo(ekw, 47) ThenBlock: { CmdOption() ReturnValue(0) }
        IfCondition EqualTo(ekw, 48) ThenBlock: { CmdRandomize() ReturnValue(0) }
        IfCondition EqualTo(ekw, 15) ThenBlock: { CmdList() ReturnValue(0) }
        IfCondition EqualTo(ekw, 16) ThenBlock: { CmdRun() ReturnValue(0) }
        IfCondition EqualTo(ekw, 17) ThenBlock: { CmdNew() ReturnValue(0) }
        IfCondition EqualTo(ekw, 18) ThenBlock: {
            ei = 0
            WhileLoop LessThan(ei, 286) {
                ArraySet(BState.vars_ptr, ei, 0)
                ei = Add(ei, 1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(ekw, 19) ThenBlock: {
            C64_ClearOutput()
            ReturnValue(0)
        }
        
        // POKE addr, value
        IfCondition EqualTo(ekw, 26) ThenBlock: {
            poke_addrf = PExpr()
            poke_addr = BasicNum.ToInt(poke_addrf)
            PSkipSpaces()
            ch = GetByte(Parser.line_ptr, Parser.pos)
            IfCondition EqualTo(ch, 44) ThenBlock: {
                Parser.pos = Add(Parser.pos, 1)
            }
            poke_valf = PExpr()
            poke_val = BasicNum.ToInt(poke_valf)
            C64Math.POKE(poke_addr, poke_val)
            ReturnValue(0)
        }
        
        // SAVE "filename"
        IfCondition EqualTo(ekw, 27) ThenBlock: {
            PSkipSpaces()
            ch = GetByte(Parser.line_ptr, Parser.pos)
            IfCondition EqualTo(ch, 34) ThenBlock: {
                save_filename = PParseStr()
                save_result = C64FileIO.SaveProgram(save_filename, BState.prog_nums_ptr, BState.prog_text_ptr)
                IfCondition EqualTo(save_result, 1) ThenBlock: {
                    C64_Print("SAVED.")
                    C64_NewLine()
                } ElseBlock: {
                    C64_Print("?DEVICE NOT PRESENT ERROR")
                    C64_NewLine()
                }
                Deallocate(save_filename, 0)
            } ElseBlock: {
                C64_Print("?SYNTAX ERROR")
                C64_NewLine()
            }
            ReturnValue(0)
        }
        
        // LOAD "filename"
        IfCondition EqualTo(ekw, 28) ThenBlock: {
            PSkipSpaces()
            ch = GetByte(Parser.line_ptr, Parser.pos)
            IfCondition EqualTo(ch, 34) ThenBlock: {
                load_filename = PParseStr()
                load_result = C64FileIO.LoadProgram(load_filename, BState.prog_nums_ptr, BState.prog_text_ptr)
                IfCondition GreaterEqual(load_result, 0) ThenBlock: {
                    C64_Print("LOADED ")
                    C64_PrintNum(load_result)
                    C64_Print(" LINES.")
                    C64_NewLine()
                } ElseBlock: {
                    C64_Print("?FILE NOT FOUND ERROR")
                    C64_NewLine()
                }
                Deallocate(load_filename, 0)
            } ElseBlock: {
                C64_Print("?SYNTAX ERROR")
                C64_NewLine()
            }
            ReturnValue(0)
        }
        
        // DATA - just skip (processed by READ)
        IfCondition EqualTo(ekw, 40) ThenBlock: {
            Parser.pos = Parser.line_len
            ReturnValue(0)
        }
        
        // READ var, var, ...
        IfCondition EqualTo(ekw, 41) ThenBlock: {
            CmdRead()
            ReturnValue(0)
        }
        
        // RESTORE
        IfCondition EqualTo(ekw, 42) ThenBlock: {
            BState.data_line_idx = 0
            BState.data_pos = 0
            ReturnValue(0)
        }
        
        // ON x GOTO/GOSUB line1, line2, ...
        IfCondition EqualTo(ekw, 43) ThenBlock: {
            ReturnValue(CmdOn())
        }
        
        IfCondition EqualTo(ekw, 0) ThenBlock: {
            Parser.pos = esave
            CmdLet()
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// EXECUTE LINE
// =============================================================================
Function.ExecLine {
    Input: line: Address
    Body: {
        PSetLine(line)
        
        done = 0
        WhileLoop And(LessThan(Parser.pos, Parser.line_len), EqualTo(done, 0)) {
            result = ExecStmt()
            
            IfCondition EqualTo(result, -1) ThenBlock: { done = 1 }
            IfCondition EqualTo(result, -2) ThenBlock: { done = 1 }
            
            IfCondition EqualTo(done, 0) ThenBlock: {
                PSkipSpaces()
                IfCondition LessThan(Parser.pos, Parser.line_len) ThenBlock: {
                    ch = GetByte(Parser.line_ptr, Parser.pos)
                    IfCondition EqualTo(ch, 58) ThenBlock: {
                        Parser.pos = Add(Parser.pos, 1)
                    } ElseBlock: {
                        done = 1
                    }
                }
            }
        }
    }
}

// =============================================================================
// STORE LINE
// =============================================================================
Function.StoreLine {
    Input: num: Integer
    Input: text: Address
    Body: {
        tlen = StringLength(text)
        bufsize = Add(tlen, 1)
        tcopy = Allocate(bufsize)
        i = 0
        WhileLoop LessThan(i, tlen) {
            ch = GetByte(text, i)
            SetByte(tcopy, i, ch)
            i = Add(i, 1)
        }
        SetByte(tcopy, tlen, 0)
        
        idx = FindLine(num)
        
        IfCondition NotEqual(idx, -1) ThenBlock: {
            old = Array.Get(BState.prog_text_ptr, idx)
            Deallocate(old, 0)
            Array.Set(BState.prog_text_ptr, idx, tcopy)
        } ElseBlock: {
            count = Array.Size(BState.prog_nums_ptr)
            ins = count
            i = 0
            found = 0
            WhileLoop And(LessThan(i, count), EqualTo(found, 0)) {
                n = Array.Get(BState.prog_nums_ptr, i)
                IfCondition GreaterThan(n, num) ThenBlock: {
                    ins = i
                    found = 1
                }
                i = Add(i, 1)
            }
            
            Array.Insert(BState.prog_nums_ptr, ins, num)
            Array.Insert(BState.prog_text_ptr, ins, tcopy)
        }
    }
}

// =============================================================================
// DELETE LINE
// =============================================================================
Function.DeleteLine {
    Input: num: Integer
    Body: {
        idx = FindLine(num)
        IfCondition NotEqual(idx, -1) ThenBlock: {
            txt = Array.Get(BState.prog_text_ptr, idx)
            Deallocate(txt, 0)
            Array.Delete(BState.prog_nums_ptr, idx)
            Array.Delete(BState.prog_text_ptr, idx)
        }
    }
}

// =============================================================================
// PROCESS INPUT
// =============================================================================
Function.ProcessInput {
    Input: inp: Address
    Body: {
        PSetLine(inp)
        PSkipSpaces()
        
        IfCondition EqualTo(Parser.line_len, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        ch = GetByte(Parser.line_ptr, Parser.pos)
        isdig = PIsDigit(ch)
        
        IfCondition EqualTo(isdig, 1) ThenBlock: {
            num = PParseInt()
            PSkipSpaces()
            
            IfCondition GreaterEqual(Parser.pos, Parser.line_len) ThenBlock: {
                DeleteLine(num)
            } ElseBlock: {
                rlen = Subtract(Parser.line_len, Parser.pos)
                bufsize = Add(rlen, 1)
                rest = Allocate(bufsize)
                i = 0
                WhileLoop LessThan(i, rlen) {
                    srcpos = Add(Parser.pos, i)
                    ch = GetByte(inp, srcpos)
                    SetByte(rest, i, ch)
                    i = Add(i, 1)
                }
                SetByte(rest, rlen, 0)
                StoreLine(num, rest)
                Deallocate(rest, 0)
            }
        } ElseBlock: {
            ExecLine(inp)
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    // Initialize TUI and C64 screen
    C64_Init()
    BInit()
    
    // Draw header
    C64_DrawHeader()
    
    // Initial cursor position
    Screen.cursor_row = Screen.output_start
    Screen.cursor_col = 1
    
    // Welcome message
    C64_NewLine()
    C64_Print("READY.")
    C64_NewLine()
    
    // Status bar
    C64_DrawStatus(" F1=HELP  ESC=QUIT ")
    
    repl_run = 1
    WhileLoop EqualTo(repl_run, 1) {
        user_inp = C64_ReadLine()
        
        // Check for QUIT
        cmp = StringCompare(user_inp, "QUIT")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            repl_run = 0
        } ElseBlock: {
            cmp = StringCompare(user_inp, "quit")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                repl_run = 0
            } ElseBlock: {
                cmp = StringCompare(user_inp, "EXIT")
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    repl_run = 0
                } ElseBlock: {
                    cmp = StringCompare(user_inp, "exit")
                    IfCondition EqualTo(cmp, 0) ThenBlock: {
                        repl_run = 0
                    } ElseBlock: {
                        ilen = StringLength(user_inp)
                        IfCondition GreaterThan(ilen, 0) ThenBlock: {
                            ProcessInput(user_inp)
                            more = C64_Host_PastePending()
                            IfCondition EqualTo(more, 0) ThenBlock: {
                                C64_Print("READY.")
                                C64_NewLine()
                            }
                        }
                    }
                }
            }
        }
        
        Deallocate(user_inp, 0)
    }
    
    // Clean shutdown
    C64_Print("GOODBYE!")
    C64_NewLine()
    C64_Host_Flush()
    
    C64_Shutdown()
}

RunTask(Main)