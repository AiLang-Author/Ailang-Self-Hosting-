// Publish tools.json from CAD_UI (kernel owns chrome cmds). PG catalog is optional override later.
Function.CA_PublishToolsJson {
    Output: Integer
    Body: {
        n = CAD_UI.WriteToolsJson("/tmp/cad_app/tools.json")
        IfCondition LessThan(n, 1) ThenBlock: {
            n = CAD_Repo.PublishToolsJson("default", "/tmp/cad_app/tools.json")
        }
        IfCondition LessThan(n, 1) ThenBlock: {
            CA_Log("cad_app: tools.json FAIL\n", 25)
            ReturnValue(-1)
        }
        PrintMessage("cad_app: tools.json bytes=")
        PrintNumber(n)
        PrintMessage("\n")
        CA_Log("cad_app: tools.json from CAD_UI\n", 32)
        ReturnValue(0)
    }
}

// Ensure PG connection + schema (once). HARD DEP — no offline path.
Function.CA_RepoEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.repo_ok, 1) ThenBlock: {
            ReturnValue(0)
        }
        rc = CAD_Repo.ConnectLocal()
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: PG connect FAIL (need cad_db)\n", 39)
            ReturnValue(-1)
        }
        rc = CAD_Repo.InitSchema(0)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: PG schema FAIL\n", 24)
            ReturnValue(-1)
        }
        CAD_Repo.EnsureUiCatalogTable()
        CadApp.repo_ok = 1
        CA_Log("cad_app: PG ready\n", 18)
        CA_PublishToolsJson()
        ReturnValue(0)
    }
}

// Ensure we have a writable name buffer; default "untitled".


// Ensure we have a writable name buffer; default "untitled".
Function.CA_EnsureName {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.name_buf, 0) ThenBlock: {
            CadApp.name_buf = Allocate(80)
            // default untitled
            SetByte(CadApp.name_buf, 0, 117)
            SetByte(CadApp.name_buf, 1, 110)
            SetByte(CadApp.name_buf, 2, 116)
            SetByte(CadApp.name_buf, 3, 105)
            SetByte(CadApp.name_buf, 4, 116)
            SetByte(CadApp.name_buf, 5, 108)
            SetByte(CadApp.name_buf, 6, 101)
            SetByte(CadApp.name_buf, 7, 100)
            SetByte(CadApp.name_buf, 8, 0)
        }
        IfCondition EqualTo(CadApp.part_name, 0) ThenBlock: {
            CadApp.part_name = CadApp.name_buf
        }
        ReturnValue(0)
    }
}

// Copy C-string src into name_buf and set part_name.


// Copy C-string src into name_buf and set part_name.
Function.CA_SetPartName {
    Input: src: Address
    Output: Integer
    Body: {
        CA_EnsureName()
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(-1) }
        i = 0
        WhileLoop LessThan(i, 63) {
            c = GetByte(src, i)
            SetByte(CadApp.name_buf, i, c)
            IfCondition EqualTo(c, 0) ThenBlock: {
                i = 64
            }
            IfCondition NotEqual(c, 0) ThenBlock: {
                i = Add(i, 1)
            }
        }
        SetByte(CadApp.name_buf, 63, 0)
        CadApp.part_name = CadApp.name_buf
        ReturnValue(0)
    }
}

// 0 part  1 assembly  2 group  3 machine  (first letter of word)
Function.CA_SetDocKind {
    Input: src: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(CadApp.doc_kind) }
        c = GetByte(src, 0)
        IfCondition EqualTo(c, 112) ThenBlock: { CadApp.doc_kind = 0 }
        IfCondition EqualTo(c, 80) ThenBlock: { CadApp.doc_kind = 0 }
        IfCondition EqualTo(c, 97) ThenBlock: { CadApp.doc_kind = 1 }
        IfCondition EqualTo(c, 65) ThenBlock: { CadApp.doc_kind = 1 }
        IfCondition EqualTo(c, 103) ThenBlock: { CadApp.doc_kind = 2 }
        IfCondition EqualTo(c, 71) ThenBlock: { CadApp.doc_kind = 2 }
        IfCondition EqualTo(c, 109) ThenBlock: { CadApp.doc_kind = 3 }
        IfCondition EqualTo(c, 77) ThenBlock: { CadApp.doc_kind = 3 }
        ReturnValue(CadApp.doc_kind)
    }
}

// Alias for Sketch_N. Identity stays Sketch_N; label is user text (Machinebase).
Function.CA_SetSketchAlias {
    Input: sk_i: Integer
    Input: src: Address
    Output: Integer
    Body: {
        IfCondition LessThan(sk_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(sk_i, 16) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sk_alias, 0) ThenBlock: {
            CadApp.sk_alias = Allocate(512)
        }
        IfCondition EqualTo(CadApp.sk_alias, 0) ThenBlock: { ReturnValue(-1) }
        base = Multiply(sk_i, 32)
        n = 0
        i = 0
        WhileLoop LessThan(i, 31) {
            c = GetByte(src, i)
            ok = 0
            IfCondition EqualTo(c, 0) ThenBlock: { i = 31 }
            IfCondition NotEqual(c, 0) ThenBlock: {
                IfCondition EqualTo(c, 32) ThenBlock: { ok = 1 }
                IfCondition EqualTo(c, 45) ThenBlock: { ok = 1 }
                IfCondition EqualTo(c, 95) ThenBlock: { ok = 1 }
                IfCondition GreaterEqual(c, 48) ThenBlock: {
                    IfCondition LessEqual(c, 57) ThenBlock: { ok = 1 }
                }
                IfCondition GreaterEqual(c, 65) ThenBlock: {
                    IfCondition LessEqual(c, 90) ThenBlock: { ok = 1 }
                }
                IfCondition GreaterEqual(c, 97) ThenBlock: {
                    IfCondition LessEqual(c, 122) ThenBlock: { ok = 1 }
                }
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    SetByte(CadApp.sk_alias, Add(base, n), c)
                    n = Add(n, 1)
                    i = Add(i, 1)
                }
                IfCondition EqualTo(ok, 0) ThenBlock: { i = 31 }
            }
        }
        SetByte(CadApp.sk_alias, Add(base, n), 0)
        ReturnValue(0)
    }
}

// Alias for a feature-tree row (Pad, Fillet, …). Type label stays.
Function.CA_SetFeatAlias {
    Input: feat_i: Integer
    Input: src: Address
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, 32) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.feat_alias, 0) ThenBlock: {
            CadApp.feat_alias = Allocate(1024)
        }
        IfCondition EqualTo(CadApp.feat_alias, 0) ThenBlock: { ReturnValue(-1) }
        base = Multiply(feat_i, 32)
        n = 0
        i = 0
        WhileLoop LessThan(i, 31) {
            c = GetByte(src, i)
            ok = 0
            IfCondition EqualTo(c, 0) ThenBlock: { i = 31 }
            IfCondition NotEqual(c, 0) ThenBlock: {
                IfCondition EqualTo(c, 32) ThenBlock: { ok = 1 }
                IfCondition EqualTo(c, 45) ThenBlock: { ok = 1 }
                IfCondition EqualTo(c, 95) ThenBlock: { ok = 1 }
                IfCondition GreaterEqual(c, 48) ThenBlock: {
                    IfCondition LessEqual(c, 57) ThenBlock: { ok = 1 }
                }
                IfCondition GreaterEqual(c, 65) ThenBlock: {
                    IfCondition LessEqual(c, 90) ThenBlock: { ok = 1 }
                }
                IfCondition GreaterEqual(c, 97) ThenBlock: {
                    IfCondition LessEqual(c, 122) ThenBlock: { ok = 1 }
                }
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    SetByte(CadApp.feat_alias, Add(base, n), c)
                    n = Add(n, 1)
                    i = Add(i, 1)
                }
                IfCondition EqualTo(ok, 0) ThenBlock: { i = 31 }
            }
        }
        SetByte(CadApp.feat_alias, Add(base, n), 0)
        ReturnValue(0)
    }
}

// Copy n qwords. Forensic — no nested calls inside the loop.
Function.CA_CopyWords {
    Input: src: Address
    Input: dst: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n) {
            ArraySet(dst, i, ArrayGet(src, i))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

// Full sketch store: lines, loop, circles, arcs, profiles, pool,
// join anchors (circle/arc T/X), constraints, user points, plane.
// Same layout as CreateSketch — enough to rebuild the page exactly.
Function.CA_SketchCopy {
    Input: src: Integer
    Input: dst: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(dst, 4, CAD_Store.Read(src, 4))
        CAD_Store.Write(dst, 19, CAD_Store.Read(src, 19))
        CAD_Store.Write(dst, 23, CAD_Store.Read(src, 23))
        CAD_Store.Write(dst, 27, CAD_Store.Read(src, 27))
        // lines
        nl = CAD_Store.Read(src, 0)
        IfCondition GreaterThan(nl, 4096) ThenBlock: { nl = 4096 }
        CA_CopyWords(CAD_Store.Read(src, 1), CAD_Store.Read(dst, 1), Multiply(nl, 4))
        CAD_Store.Write(dst, 0, nl)
        // primary loop (closed ring after split/trim)
        nlp = CAD_Store.Read(src, 2)
        IfCondition GreaterThan(nlp, 4096) ThenBlock: { nlp = 4096 }
        CA_CopyWords(CAD_Store.Read(src, 3), CAD_Store.Read(dst, 3), Multiply(nlp, 2))
        CAD_Store.Write(dst, 2, nlp)
        // circles
        nc = CAD_Store.Read(src, 7)
        IfCondition GreaterThan(nc, 64) ThenBlock: { nc = 64 }
        CA_CopyWords(CAD_Store.Read(src, 8), CAD_Store.Read(dst, 8), Multiply(nc, 3))
        CAD_Store.Write(dst, 7, nc)
        // arcs (trim turns circles into arcs — must keep every piece)
        na = CAD_Store.Read(src, 10)
        IfCondition GreaterThan(na, 512) ThenBlock: { na = 512 }
        CA_CopyWords(CAD_Store.Read(src, 11), CAD_Store.Read(dst, 11), Multiply(na, 5))
        CAD_Store.Write(dst, 10, na)
        // profile meta + pool
        np = CAD_Store.Read(src, 12)
        IfCondition GreaterThan(np, 64) ThenBlock: { np = 64 }
        pm = CAD_Store.Read(src, 13)
        CA_CopyWords(pm, CAD_Store.Read(dst, 13), Multiply(np, 2))
        CAD_Store.Write(dst, 12, np)
        pool_n = 0
        IfCondition GreaterThan(np, 0) ThenBlock: {
            pm = CAD_Store.Read(src, 13)
            pi = 0
            WhileLoop LessThan(pi, np) {
                pn = ArrayGet(pm, Multiply(pi, 2))
                pst = ArrayGet(pm, Add(Multiply(pi, 2), 1))
                pend = Add(pst, Multiply(pn, 2))
                IfCondition GreaterThan(pend, pool_n) ThenBlock: { pool_n = pend }
                pi = Add(pi, 1)
            }
        }
        IfCondition GreaterThan(pool_n, 16384) ThenBlock: { pool_n = 16384 }
        CA_CopyWords(CAD_Store.Read(src, 14), CAD_Store.Read(dst, 14), pool_n)
        // join anchors — circle×arc / T / X (drawn on top of curves)
        npt = CAD_Store.Read(src, 16)
        IfCondition GreaterThan(npt, 1024) ThenBlock: { npt = 1024 }
        CA_CopyWords(CAD_Store.Read(src, 17), CAD_Store.Read(dst, 17), Multiply(npt, 2))
        CAD_Store.Write(dst, 16, npt)
        // constraints
        ncs = CAD_Store.Read(src, 20)
        IfCondition GreaterThan(ncs, 128) ThenBlock: { ncs = 128 }
        CA_CopyWords(CAD_Store.Read(src, 21), CAD_Store.Read(dst, 21), Multiply(ncs, 8))
        CAD_Store.Write(dst, 20, ncs)
        // user points
        nu = CAD_Store.Read(src, 24)
        IfCondition GreaterThan(nu, 512) ThenBlock: { nu = 512 }
        CA_CopyWords(CAD_Store.Read(src, 25), CAD_Store.Read(dst, 25), Multiply(nu, 2))
        CAD_Store.Write(dst, 24, nu)
        ReturnValue(1)
    }
}

Function.CA_HistEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.hist_sk, 0) ThenBlock: {
            CadApp.hist_sk = Allocate(256)
            CadApp.hist_solid = Allocate(256)
            CadApp.hist_kind = Allocate(256)
            CadApp.hist_mode = Allocate(256)
        }
        IfCondition EqualTo(CadApp.hist_sk, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

// Write /tmp/cad_app/hist.txt  first line: n cur   then "i * label"
Function.CA_WriteHist {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppIpc.tree, 0) ThenBlock: { CadAppIpc.tree = Allocate(4096) }
        buf = Allocate(1024)
        pos = 0
        pos = CAD_Repo.AppendInt(buf, pos, CadApp.hist_n)
        pos = CAD_Repo.AppendStr(buf, pos, " ")
        pos = CAD_Repo.AppendInt(buf, pos, CadApp.hist_cur)
        pos = CAD_Repo.AppendStr(buf, pos, "\n")
        i = 0
        WhileLoop LessThan(i, CadApp.hist_n) {
            pos = CAD_Repo.AppendInt(buf, pos, i)
            pos = CAD_Repo.AppendStr(buf, pos, " ")
            IfCondition EqualTo(i, CadApp.hist_cur) ThenBlock: {
                pos = CAD_Repo.AppendStr(buf, pos, "* ")
            }
            IfCondition NotEqual(i, CadApp.hist_cur) ThenBlock: {
                pos = CAD_Repo.AppendStr(buf, pos, ". ")
            }
            k = ArrayGet(CadApp.hist_kind, i)
            IfCondition EqualTo(k, 0) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Sketch") }
            IfCondition EqualTo(k, 1) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Extrude") }
            IfCondition EqualTo(k, 2) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Revolve") }
            IfCondition EqualTo(k, 3) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Cut") }
            IfCondition EqualTo(k, 4) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Fillet") }
            IfCondition EqualTo(k, 5) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Chamfer") }
            IfCondition EqualTo(k, 6) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Clear") }
            IfCondition EqualTo(k, 7) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Trim") }
            IfCondition EqualTo(k, 8) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Polygon") }
            IfCondition EqualTo(k, 9) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Line") }
            IfCondition EqualTo(k, 10) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Circle") }
            IfCondition EqualTo(k, 11) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Rect") }
            IfCondition EqualTo(k, 12) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Fillet2") }
            IfCondition EqualTo(k, 13) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Constr") }
            IfCondition EqualTo(k, 14) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Point") }
            pos = CAD_Repo.AppendStr(buf, pos, "\n")
            i = Add(i, 1)
        }
        SetByte(buf, pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/hist.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, buf, pos)
            SystemCall(3, fd, 0, 0)
        }
        Deallocate(buf, 1024)
        ReturnValue(0)
    }
}

// Push a snapshot after a real change. kind 0..6. Drops redo tail.
Function.CA_HistPush {
    Input: kind: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_HistEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        nxt = Add(CadApp.hist_cur, 1)
        IfCondition LessThan(nxt, CadApp.hist_n) ThenBlock: {
            CadApp.hist_n = nxt
        }
        IfCondition GreaterEqual(CadApp.hist_n, 32) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, 31) {
                ArraySet(CadApp.hist_sk, i, ArrayGet(CadApp.hist_sk, Add(i, 1)))
                ArraySet(CadApp.hist_solid, i, ArrayGet(CadApp.hist_solid, Add(i, 1)))
                ArraySet(CadApp.hist_kind, i, ArrayGet(CadApp.hist_kind, Add(i, 1)))
                ArraySet(CadApp.hist_mode, i, ArrayGet(CadApp.hist_mode, Add(i, 1)))
                i = Add(i, 1)
            }
            CadApp.hist_n = 31
        }
        wp = CAD_Store.Read(CadApp.sketch, 4)
        snap = CAD_Sketch.CreateSketch(wp)
        IfCondition NotEqual(snap, 0) ThenBlock: {
            CA_SketchCopy(CadApp.sketch, snap)
        }
        slot = CadApp.hist_n
        ArraySet(CadApp.hist_sk, slot, snap)
        ArraySet(CadApp.hist_solid, slot, CadApp.solid)
        ArraySet(CadApp.hist_kind, slot, kind)
        ArraySet(CadApp.hist_mode, slot, CadApp.mode)
        CadApp.hist_n = Add(CadApp.hist_n, 1)
        CadApp.hist_cur = Subtract(CadApp.hist_n, 1)
        CA_WriteHist()
        ReturnValue(1)
    }
}

Function.CA_HistGo {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(idx, CadApp.hist_n) ThenBlock: { ReturnValue(-1) }
        snap = ArrayGet(CadApp.hist_sk, idx)
        IfCondition NotEqual(snap, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                CA_SketchCopy(snap, CadApp.sketch)
                CAD_Sketch.RebuildAnchors(CadApp.sketch)
                CadApp.nprof = CAD_Store.Read(CadApp.sketch, 12)
            }
        }
        CadApp.solid = ArrayGet(CadApp.hist_solid, idx)
        CadApp.mode = ArrayGet(CadApp.hist_mode, idx)
        CadApp.hist_cur = idx
        CadApp.nclick = 0
        CadApp.face_pick = 0
        CadApp.plane_pick = 0
        CadApp.dirty = 1
        CAD_View.InvalidateMesh()
        CA_WriteHist()
        ReturnValue(0)
    }
}

Function.CA_HistBack {
    Output: Integer
    Body: {
        IfCondition LessEqual(CadApp.hist_cur, 0) ThenBlock: {
            CA_Log("cad_app: history at start\n", 26)
            ReturnValue(-1)
        }
        ReturnValue(CA_HistGo(Subtract(CadApp.hist_cur, 1)))
    }
}

Function.CA_HistFwd {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(Add(CadApp.hist_cur, 1), CadApp.hist_n) ThenBlock: {
            CA_Log("cad_app: history at end\n", 24)
            ReturnValue(-1)
        }
        ReturnValue(CA_HistGo(Add(CadApp.hist_cur, 1)))
    }
}

// Keep only the current step — settled design, drop the scrapbook.
Function.CA_HistPrune {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.hist_n, 1) ThenBlock: { ReturnValue(0) }
        cur = CadApp.hist_cur
        ArraySet(CadApp.hist_sk, 0, ArrayGet(CadApp.hist_sk, cur))
        ArraySet(CadApp.hist_solid, 0, ArrayGet(CadApp.hist_solid, cur))
        ArraySet(CadApp.hist_kind, 0, ArrayGet(CadApp.hist_kind, cur))
        ArraySet(CadApp.hist_mode, 0, ArrayGet(CadApp.hist_mode, cur))
        CadApp.hist_n = 1
        CadApp.hist_cur = 0
        CA_WriteHist()
        CA_Log("cad_app: history pruned\n", 24)
        ReturnValue(0)
    }
}

Function.CA_HistFlushRepo {
    Input: rev_id: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(rev_id, 1) ThenBlock: { ReturnValue(-1) }
        i = 0
        WhileLoop LessThan(i, CadApp.hist_n) {
            CAD_Repo.InsertHist(rev_id, i, ArrayGet(CadApp.hist_kind, i))
            i = Add(i, 1)
        }
        hbuf = Allocate(1024)
        CA_WriteHist()
        fd = SystemCall(2, "/tmp/cad_app/hist.txt", 0, 0)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            n = SystemCall(0, fd, hbuf, 1023)
            SystemCall(3, fd, 0, 0)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                SetByte(hbuf, n, 0)
                CAD_Repo.PutAssetText(rev_id, "hist_log", "text/plain", hbuf)
            }
        }
        Deallocate(hbuf, 1024)
        ReturnValue(0)
    }
}

// Write list_buf + selection to IPC files for host overlay.


// Write list_buf + selection to IPC files for host overlay.
Function.CA_WriteListFiles {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.list_buf, 0) ThenBlock: {
            CA_WriteFileStr("/tmp/cad_app/parts.txt", "(empty)\n", 8)
        }
        IfCondition NotEqual(CadApp.list_buf, 0) ThenBlock: {
            fd = SystemCall(2, "/tmp/cad_app/parts.txt", 577, 420)
            IfCondition GreaterEqual(fd, 0) ThenBlock: {
                // write up to 4000 chars
                n = 0
                WhileLoop LessThan(n, 4000) {
                    IfCondition EqualTo(GetByte(CadApp.list_buf, n), 0) ThenBlock: {
                        n = 4000
                    }
                    IfCondition LessThan(n, 4000) ThenBlock: {
                        IfCondition NotEqual(GetByte(CadApp.list_buf, n), 0) ThenBlock: {
                            n = Add(n, 1)
                        }
                    }
                }
                // recount properly
                n = 0
                WhileLoop NotEqual(GetByte(CadApp.list_buf, n), 0) {
                    n = Add(n, 1)
                    IfCondition GreaterThan(n, 4000) ThenBlock: {
                        n = 4000
                    }
                }
                SystemCall(1, fd, CadApp.list_buf, n)
                SystemCall(3, fd, 0, 0)
            }
        }
        // sel index
        sb = Allocate(16)
        pos = 0
        v = CadApp.list_sel
        IfCondition EqualTo(v, 0) ThenBlock: {
            SetByte(sb, 0, 48)
            pos = 1
        }
        IfCondition GreaterThan(v, 0) ThenBlock: {
            tmp = Allocate(16)
            n = 0
            WhileLoop GreaterThan(v, 0) {
                SetByte(tmp, n, Add(48, Modulo(v, 10)))
                v = Divide(v, 10)
                n = Add(n, 1)
            }
            i = Subtract(n, 1)
            WhileLoop GreaterEqual(i, 0) {
                SetByte(sb, pos, GetByte(tmp, i))
                pos = Add(pos, 1)
                i = Subtract(i, 1)
            }
            Deallocate(tmp, 16)
        }
        SetByte(sb, pos, 10)
        pos = Add(pos, 1)
        SetByte(sb, pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/sel.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, sb, pos)
            SystemCall(3, fd, 0, 0)
        }
        Deallocate(sb, 16)
        ReturnValue(0)
    }
}

// nth line (0-based) from list_buf → out 64-byte name. Returns 1 ok.


// nth line (0-based) from list_buf → out 64-byte name. Returns 1 ok.
Function.CA_ListNameAt {
    Input: idx: Integer
    Input: out: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.list_buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        line = 0
        i = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            IfCondition EqualTo(GetByte(CadApp.list_buf, i), 0) ThenBlock: {
                done = 1
            }
            IfCondition EqualTo(done, 0) ThenBlock: {
                IfCondition EqualTo(line, idx) ThenBlock: {
                    j = 0
                    WhileLoop EqualTo(done, 0) {
                        c = GetByte(CadApp.list_buf, i)
                        IfCondition EqualTo(c, 0) ThenBlock: {
                            SetByte(out, j, 0)
                            done = 2
                        }
                        IfCondition EqualTo(c, 10) ThenBlock: {
                            SetByte(out, j, 0)
                            done = 2
                        }
                        IfCondition EqualTo(c, 9) ThenBlock: {
                            SetByte(out, j, 0)
                            done = 2
                        }
                        IfCondition EqualTo(done, 0) ThenBlock: {
                            IfCondition LessThan(j, 63) ThenBlock: {
                                SetByte(out, j, c)
                                j = Add(j, 1)
                            }
                            i = Add(i, 1)
                        }
                    }
                    IfCondition EqualTo(j, 0) ThenBlock: { ReturnValue(0) }
                    ReturnValue(1)
                }
                // advance to next line
                c = GetByte(CadApp.list_buf, i)
                IfCondition EqualTo(c, 10) ThenBlock: {
                    line = Add(line, 1)
                }
                i = Add(i, 1)
            }
        }
        ReturnValue(0)
    }
}

// Refresh part list from Postgres; open browser.


// Refresh part list from Postgres; open browser.
Function.CA_DocList {
    Output: Integer
    Body: {
        CA_Log("cad_app: list enter\n", 20)
        CA_WriteFileStr("/tmp/cad_app/parts.txt", "(empty)\n", 8)
        ens = CA_RepoEnsure()
        CA_LogInt("cad_app: list ensure=", 21, ens)
        IfCondition EqualTo(CadApp.repo_ok, 0) ThenBlock: {
            CA_Log("cad_app: list needs PG\n", 23)
            ReturnValue(-1)
        }
        IfCondition EqualTo(CadApp.list_buf, 0) ThenBlock: {
            CadApp.list_buf = Allocate(4096)
        }
        CA_Log("cad_app: list query\n", 20)
        n = CAD_Repo.ListParts(CadApp.list_buf, 4096)
        CA_LogInt("cad_app: list n=", 16, n)
        IfCondition LessThan(n, 0) ThenBlock: {
            CA_Log("cad_app: list FAIL\n", 19)
            CA_WriteFileStr("/tmp/cad_app/parts.txt", "(empty)\n", 8)
            ReturnValue(-2)
        }
        CadApp.list_count = n
        // Gtk File dialog owns the picker. Do not enter the old in-FB browser
        // (list_open=1 hid the solid and g/load wiped the live part).
        CadApp.list_open = 0
        IfCondition GreaterEqual(CadApp.list_sel, n) ThenBlock: {
            CadApp.list_sel = 0
        }
        IfCondition LessThan(n, 1) ThenBlock: {
            SetByte(CadApp.list_buf, 0, 40)
            SetByte(CadApp.list_buf, 1, 110)
            SetByte(CadApp.list_buf, 2, 111)
            SetByte(CadApp.list_buf, 3, 110)
            SetByte(CadApp.list_buf, 4, 101)
            SetByte(CadApp.list_buf, 5, 41)
            SetByte(CadApp.list_buf, 6, 10)
            SetByte(CadApp.list_buf, 7, 0)
            CadApp.list_count = 0
        }
        CA_Log("cad_app: list write parts.txt\n", 30)
        CA_WriteListFiles()
        CA_Log("cad_app: list open\n", 19)
        ReturnValue(0)
    }
}


Function.CA_DocSelNext {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.list_open, 0) ThenBlock: {
            ReturnValue(CA_DocList())
        }
        IfCondition GreaterThan(CadApp.list_count, 0) ThenBlock: {
            CadApp.list_sel = Add(CadApp.list_sel, 1)
            IfCondition GreaterEqual(CadApp.list_sel, CadApp.list_count) ThenBlock: {
                CadApp.list_sel = 0
            }
        }
        CA_WriteListFiles()
        ReturnValue(0)
    }
}


Function.CA_DocSelPrev {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.list_open, 0) ThenBlock: {
            ReturnValue(CA_DocList())
        }
        IfCondition LessThan(CadApp.list_count, 1) ThenBlock: {
            CA_WriteListFiles()
            ReturnValue(0)
        }
        // sel = (sel - 1 + count) % count
        s = Add(Subtract(CadApp.list_sel, 1), CadApp.list_count)
        // modulo via while
        WhileLoop GreaterEqual(s, CadApp.list_count) {
            s = Subtract(s, CadApp.list_count)
        }
        CadApp.list_sel = s
        CA_WriteListFiles()
        ReturnValue(0)
    }
}

// Open selected list entry (or current part_name if list closed).


// Open selected list entry (or current part_name if list closed).
Function.CA_DocOpen {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.list_open, 1) ThenBlock: {
            IfCondition GreaterThan(CadApp.list_count, 0) ThenBlock: {
                nm = Allocate(80)
                IfCondition EqualTo(CA_ListNameAt(CadApp.list_sel, nm), 1) ThenBlock: {
                    CA_SetPartName(nm)
                }
                Deallocate(nm, 80)
            }
        }
        ReturnValue(CA_RepoLoad())
    }
}

// Wipe solid + sketch + hole + profile selection (the "data tree").
// Forces sketch mode so viewport is empty axes, not the last pad.


// Wipe solid + sketch + hole + profile selection (the "data tree").
// Forces sketch mode so viewport is empty axes, not the last pad.
Function.CA_ClearModel {
    Output: Integer
    Body: {
        // drop solid handle (viewport must not re-render last body)
        CAD_View.InvalidateMesh()
        CadApp.solid = 0
        CadApp.hole_sk = 0
        CadApp.hole_path = 0
        // replace sketch with empty (orphan old sketch store entries)
        CadApp.sketch = CAD_Sketch.CreateSketch(1)
        CadApp.sk_n = 0
        CadApp.sk_list = 0
        CadApp.feat_n = 0
        CadApp.feat_sel = 0
        CadApp.pad_edit = 0
        CadApp.last_pad = -1
        CadApp.rev_edit = 0
        CadApp.last_revf = -1
        CadApp.proj_n = 0
        CadApp.hist_n = 0
        CadApp.hist_cur = 0
        CadApp.plane_kind = 0
        IfCondition NotEqual(CadApp.sk_alias, 0) ThenBlock: {
            zi = 0
            WhileLoop LessThan(zi, 512) {
                SetByte(CadApp.sk_alias, zi, 0)
                zi = Add(zi, 1)
            }
        }
        IfCondition NotEqual(CadApp.feat_alias, 0) ThenBlock: {
            zi = 0
            WhileLoop LessThan(zi, 1024) {
                SetByte(CadApp.feat_alias, zi, 0)
                zi = Add(zi, 1)
            }
        }
        CA_SketchRegister(CadApp.sketch)
        CadApp.nclick = 0
        CadApp.hover_ok = 0
        CadApp.cx0 = 0
        CadApp.cy0 = 0
        CadApp.arc_a0 = 0
        CadApp.arc_rad = 0
        CadApp.tool = 0
        CadApp.nprof = 0
        CadApp.prof_sel = 0
        CadApp.prof_user = 0
        CadApp.mode = 1
        CadApp.dirty = 0
        CadApp.auto_pad = 0
        CadAppRev.ok = 0
        CadApp.plane = 0
        CadApp.sk0_plane = 0
        CadApp.plane_n = 0
        CadApp.face_pick = 0
        CadApp.plane_pick = 0
        CadApp.hover_plane = 0
        CadApp.pln_ptn = 0
        CadApp.last_face = 0
        CA_BindSketchPlane()
        CadApp.undo_ok = 0
        CadApp.keep_solid = 0
        CadApp.sk_i = 0
        // clear framebuffer so last pad pixels cannot linger
        w = CadApp.width
        h = CadApp.height_px
        IfCondition LessThan(w, 16) ThenBlock: { w = 800 }
        IfCondition LessThan(h, 16) ThenBlock: { h = 600 }
        need = 0
        IfCondition EqualTo(FB.initialized, 0) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.width, w) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.height, h) ThenBlock: { need = 1 }
        IfCondition EqualTo(need, 1) ThenBlock: {
            FB_InitHeadless(w, h)
        }
        FB_Clear(FB_RGB(24, 28, 36))
        ReturnValue(0)
    }
}

// Close document: clear model tree, untitled


// Close document: clear model tree, untitled
Function.CA_DocClose {
    Output: Integer
    Body: {
        CA_ClearModel()
        CadApp.part_rev = 0
        CadApp.list_open = 0
        CadApp.doc_kind = 0
        CA_SetPartName("untitled")
        CA_Log("cad_app: closed (model cleared)\n", 32)
        ReturnValue(0)
    }
}

// New document: empty sketch + no solid, name partN


// New document: empty sketch + no solid, name partN
Function.CA_DocNew {
    Output: Integer
    Body: {
        CA_EnsureName()
        // name part + gen
        SetByte(CadApp.name_buf, 0, 112)
        SetByte(CadApp.name_buf, 1, 97)
        SetByte(CadApp.name_buf, 2, 114)
        SetByte(CadApp.name_buf, 3, 116)
        // append digits of gen+1
        v = Add(CadApp.gen, 1)
        // write at least one digit
        tmp = Allocate(16)
        n = 0
        IfCondition EqualTo(v, 0) ThenBlock: {
            SetByte(tmp, 0, 48)
            n = 1
        }
        WhileLoop GreaterThan(v, 0) {
            SetByte(tmp, n, Add(48, Modulo(v, 10)))
            v = Divide(v, 10)
            n = Add(n, 1)
        }
        p = 4
        i = Subtract(n, 1)
        WhileLoop GreaterEqual(i, 0) {
            SetByte(CadApp.name_buf, p, GetByte(tmp, i))
            p = Add(p, 1)
            i = Subtract(i, 1)
        }
        SetByte(CadApp.name_buf, p, 0)
        Deallocate(tmp, 16)
        CadApp.part_name = CadApp.name_buf
        // full wipe: solid + sketch + profiles (viewport no longer shows last pad)
        CA_ClearModel()
        CadApp.dirty = 1
        CadApp.part_rev = 0
        CadApp.list_open = 0
        CA_Log("cad_app: new doc (model cleared)\n", 33)
        ReturnValue(0)
    }
}

// Save current sketch+solid+hole to Postgres under CadApp.part_name.


// Save current sketch+solid+hole to Postgres under CadApp.part_name.
Function.CA_RepoSave {
    Output: Integer
    Body: {
        CA_Log("cad_app: save enter\n", 20)
        ens = CA_RepoEnsure()
        CA_LogInt("cad_app: save ensure=", 21, ens)
        IfCondition EqualTo(CadApp.repo_ok, 0) ThenBlock: {
            CA_Log("cad_app: save needs PG\n", 23)
            ReturnValue(-1)
        }
        CA_EnsureName()
        CA_Log("cad_app: save name ok\n", 22)
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: save needs sketch\n", 27)
            ReturnValue(-3)
        }
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CadApp.auto_pad = 1
            rc = CA_BuildSolid()
            CadApp.auto_pad = 0
            IfCondition NotEqual(rc, 0) ThenBlock: {
                CA_Log("cad_app: save needs a solid or closed profile\n", 46)
                ReturnValue(-3)
            }
        }
        // Prefer the last pad feature's HUD height if it was typed.
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            pi = Subtract(CadApp.feat_n, 1)
            WhileLoop GreaterEqual(pi, 0) {
                IfCondition EqualTo(ArrayGet(CadApp.feat_kind, pi), 1) ThenBlock: {
                    ha = ArrayGet(CadApp.feat_aux, pi)
                    IfCondition GreaterThan(ha, 0) ThenBlock: {
                        CadApp.height = ha
                        pi = 0
                    }
                }
                pi = Subtract(pi, 1)
            }
        }
        IfCondition LessThan(CadApp.height, 1) ThenBlock: { CadApp.height = 10 }
        IfCondition LessThan(CadApp.rev_deg, 1) ThenBlock: { CadApp.rev_deg = 360 }
        CAD_Repo_State.save_kind = CadApp.doc_kind
        CAD_Repo_State.save_rev_deg = CadApp.rev_deg
        CA_LogInt("cad_app: save H=", 16, CadApp.height)
        CA_Log("cad_app: save SavePart\n", 23)
        rc = CAD_Repo.SavePart(CadApp.part_name, CadApp.sketch, CadApp.solid, CadApp.height, CadApp.hole_sk)
        CA_LogInt("cad_app: save SavePart rc=", 26, rc)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: repo save FAIL\n", 24)
            ReturnValue(rc)
        }
        rid = CAD_Repo_State.last_rev_id
        IfCondition GreaterThan(rid, 0) ThenBlock: {
            tbuf = Allocate(8192)
            nt = CA_FormatPlaneTree(tbuf)
            IfCondition GreaterThan(nt, 0) ThenBlock: {
                CAD_Repo.PutAssetText(rid, "plane_tree", "application/json", tbuf)
            }
            Deallocate(tbuf, 8192)
            fbuf = Allocate(4096)
            nf = CA_FormatFaceMap(fbuf)
            IfCondition GreaterThan(nf, 0) ThenBlock: {
                CAD_Repo.PutAssetText(rid, "face_map", "application/json", fbuf)
            }
            Deallocate(fbuf, 4096)
        }
        CadApp.part_rev = CAD_Repo_State.last_rev
        CadApp.dirty = 0
        CadApp.list_open = 0
        IfCondition GreaterThan(rid, 0) ThenBlock: {
            CA_HistFlushRepo(rid)
        }
        CA_LogInt("cad_app: repo save H=", 21, CadApp.height)
        CA_LogInt("cad_app: repo save rev=", 23, CAD_Repo_State.last_rev)
        ReturnValue(0)
    }
}

// Load part from Postgres by CadApp.part_name → sketch/solid/height/hole.


// Load part from Postgres by CadApp.part_name → sketch/solid/height/hole.
Function.CA_RepoLoad {
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_RepoEnsure(), 0) ThenBlock: {
        }
        IfCondition EqualTo(CadApp.repo_ok, 0) ThenBlock: { ReturnValue(-1) }
        CA_EnsureName()
        pack = Allocate(64)
        rc = CAD_Repo.LoadPart(CadApp.part_name, pack)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            Deallocate(pack, 64)
            CA_Log("cad_app: repo load FAIL\n", 24)
            ReturnValue(rc)
        }
        h_sk = ArrayGet(pack, 0)
        h_sol = ArrayGet(pack, 1)
        h_hgt = ArrayGet(pack, 2)
        h_hole = ArrayGet(pack, 3)
        Deallocate(pack, 64)
        // Drop leftover sketches / pads so load is not mixed with the last part.
        CA_ClearModel()
        CadApp.sketch = h_sk
        CadApp.height = h_hgt
        CadApp.rev_deg = CAD_Repo_State.last_rev_deg
        IfCondition LessThan(CadApp.rev_deg, 1) ThenBlock: { CadApp.rev_deg = 360 }
        CadApp.hole_sk = h_hole
        CadApp.solid = 0
        IfCondition GreaterThan(CadApp.sk_n, 0) ThenBlock: {
            ArraySet(CadApp.sk_list, 0, h_sk)
        }
        IfCondition EqualTo(CadApp.sk_n, 0) ThenBlock: {
            CA_SketchRegister(h_sk)
        }
        CadApp.sk_i = 0
        CadApp.auto_pad = 1
        rc2 = CA_BuildSolid()
        CadApp.auto_pad = 0
        IfCondition NotEqual(rc2, 0) ThenBlock: {
            CadApp.solid = h_sol
        }
        CadApp.mode = 0
        CadApp.dirty = 0
        CadApp.part_rev = CAD_Repo_State.last_rev
        CadApp.list_open = 0
        IfCondition EqualTo(CAD_Repo.FetchAssetToFile(CadApp.part_name, 0, "plane_tree", "/tmp/cad_repo_planes.txt"), 0) ThenBlock: {
            slot = Allocate(16)
            n = CAD_Repo.ReadFileAll("/tmp/cad_repo_planes.txt", slot, 8192)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                tbuf = ArrayGet(slot, 0)
                CA_ParsePlaneTree(tbuf)
                Deallocate(tbuf, 8192)
            }
            Deallocate(slot, 16)
        }
        IfCondition EqualTo(CAD_Repo.FetchAssetToFile(CadApp.part_name, 0, "face_map", "/tmp/cad_repo_faces.txt"), 0) ThenBlock: {
            slot = Allocate(16)
            n = CAD_Repo.ReadFileAll("/tmp/cad_repo_faces.txt", slot, 4096)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                fbuf = ArrayGet(slot, 0)
                CA_ParseFaceMap(fbuf)
                CA_RegenPlaneTree()
                Deallocate(fbuf, 4096)
            }
            Deallocate(slot, 16)
        }
        IfCondition EqualTo(CadApp.sk0_plane, 0) ThenBlock: {
            CA_EnsurePlane()
        }
        IfCondition EqualTo(CAD_Repo.FetchAssetToFile(CadApp.part_name, 0, "hist_log", "/tmp/cad_app/hist.txt"), 0) ThenBlock: {
            CA_Log("cad_app: hist_log loaded\n", 25)
        }
        CadApp.hist_n = 0
        CadApp.hist_cur = 0
        CA_HistPush(1)
        CA_Log("cad_app: repo load ok (plane_tree+hist)\n", 40)
        ReturnValue(0)
    }
}

// File → Delete: drop the named Postgres document, then close the workspace.
Function.CA_RepoForget {
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_RepoEnsure(), 0) ThenBlock: {
        }
        IfCondition EqualTo(CadApp.repo_ok, 0) ThenBlock: {
            CA_Log("cad_app: forget needs PG\n", 25)
            ReturnValue(-1)
        }
        CA_EnsureName()
        rc = CAD_Repo.DeletePart(CadApp.part_name)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: forget FAIL\n", 21)
            ReturnValue(rc)
        }
        CA_Log("cad_app: forgot part\n", 21)
        CA_DocClose()
        ReturnValue(0)
    }
}

// Copy part name and append _dirty (for unsaved stash).
Function.CA_SetStashName {
    Output: Integer
    Body: {
        CA_EnsureName()
        n = 0
        WhileLoop NotEqual(GetByte(CadApp.name_buf, n), 0) {
            n = Add(n, 1)
            IfCondition GreaterThan(n, 62) ThenBlock: { n = 63 }
        }
        already = 0
        IfCondition GreaterEqual(n, 6) ThenBlock: {
            IfCondition EqualTo(GetByte(CadApp.name_buf, Subtract(n, 6)), 95) ThenBlock: {
                IfCondition EqualTo(GetByte(CadApp.name_buf, Subtract(n, 5)), 100) ThenBlock: {
                    already = 1
                }
            }
        }
        IfCondition EqualTo(already, 0) ThenBlock: {
            IfCondition GreaterThan(n, 56) ThenBlock: { n = 56 }
            SetByte(CadApp.name_buf, n, 95)
            SetByte(CadApp.name_buf, Add(n, 1), 100)
            SetByte(CadApp.name_buf, Add(n, 2), 105)
            SetByte(CadApp.name_buf, Add(n, 3), 114)
            SetByte(CadApp.name_buf, Add(n, 4), 116)
            SetByte(CadApp.name_buf, Add(n, 5), 121)
            SetByte(CadApp.name_buf, Add(n, 6), 0)
        }
        CadApp.part_name = CadApp.name_buf
        ReturnValue(0)
    }
}

// File leave: persist current work as <name>_dirty (overwrite that stash).
Function.CA_RepoStash {
    Output: Integer
    Body: {
        CA_EnsureName()
        CA_SetStashName()
        CAD_Repo_State.do_overwrite = 1
        rc = CA_RepoSave()
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: stash FAIL\n", 20)
            ReturnValue(rc)
        }
        CA_Log("cad_app: stashed dirty part\n", 28)
        ReturnValue(0)
    }
}



Function.CA_UndoPush {
    Output: Integer
    Body: {
        ReturnValue(0)
    }
}

Function.CA_Undo {
    Output: Integer
    Body: {
        ReturnValue(CA_HistBack())
    }
}

// Empty the current sketch only — keep the solid and the rest of the tree.
Function.CA_ClearSketch {
    Output: Integer
    Body: {
        sk = CadApp.sketch
        IfCondition EqualTo(sk, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
            CA_SketchRegister(CadApp.sketch)
            sk = CadApp.sketch
        }
        IfCondition NotEqual(sk, 0) ThenBlock: {
            CAD_Store.Write(sk, 0, 0)
            CAD_Store.Write(sk, 2, 0)
            CAD_Store.Write(sk, 7, 0)
            CAD_Store.Write(sk, 10, 0)
            CAD_Store.Write(sk, 12, 0)
            CAD_Store.Write(sk, 16, 0)
            CAD_Store.Write(sk, 20, 0)
            CAD_Store.Write(sk, 24, 0)
            CAD_Store.Write(sk, 27, 0)
        }
        CadApp.nclick = 0
        CadApp.hover_ok = 0
        CadApp.cx0 = 0
        CadApp.cy0 = 0
        CadApp.nprof = 0
        CadApp.prof_sel = 0
        CadApp.prof_user = 0
        CadApp.prof_mask = 0
        CadApp.n_face_ref = 0
        CadApp.tool = 0
        CadApp.mode = 1
        CadApp.dirty = 1
        CA_HistPush(6)
        CA_Log("cad_app: sketch cleared (model kept)\n", 37)
        ReturnValue(0)
    }
}

Function.CA_NewSketch {
    Output: Integer
    Body: {
        CA_ClearModel()
        CadApp.dirty = 1
        CA_Log("cad_app: new sketch (model cleared)\n", 36)
        ReturnValue(0)
    }
}

// Host close / quit cmd: drop model, tess cache, PG session, log.
Function.CA_Shutdown {
    Output: Integer
    Body: {
        CA_Log("cad_app: shutdown begin\n", 24)
        CA_ClearModel()
        CAD_View.InvalidateMesh()
        CAD_Repo.EndSession()
        CAD_Repo.Disconnect()
        CA_Log("cad_app: shutdown ok\n", 21)
        fd = CadApp.log_fd
        IfCondition GreaterThan(fd, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
        }
        CadApp.log_fd = 0
        CadApp.running = 0
        ReturnValue(0)
    }
}

