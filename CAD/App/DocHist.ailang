Function.CA_PublishToolsJson {
    Output: Integer
    Body: {
        n = CAD_UI.WriteToolsJson("/tmp/cad_app/tools.json")
        IfCondition LessThan(n, 1) ThenBlock: {
            n = CAD_Repo.PublishToolsJson("default", "/tmp/cad_app/tools.json")
        }
        IfCondition LessThan(n, 1) ThenBlock: {
            CA_Log("cad_app: tools.json FAIL\n", 25)
            ReturnValue(-1)
        }
        PrintMessage("cad_app: tools.json bytes=")
        PrintNumber(n)
        PrintMessage("\n")
        CA_Log("cad_app: tools.json from CAD_UI\n", 32)
        ReturnValue(0)
    }
}

// Ensure PG connection + schema (once). HARD DEP — no offline path.
Function.CA_RepoEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.repo_ok, 1) ThenBlock: {
            ReturnValue(0)
        }
        rc = CAD_Repo.ConnectLocal()
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: PG connect FAIL (need cad_db)\n", 39)
            ReturnValue(-1)
        }
        rc = CAD_Repo.InitSchema(0)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: PG schema FAIL\n", 24)
            ReturnValue(-1)
        }
        CAD_Repo.EnsureUiCatalogTable()
        CadApp.repo_ok = 1
        CA_Log("cad_app: PG ready\n", 18)
        CA_PublishToolsJson()
        ReturnValue(0)
    }
}

// Ensure we have a writable name buffer; default "untitled".


// Ensure we have a writable name buffer; default "untitled".
Function.CA_EnsureName {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.name_buf, 0) ThenBlock: {
            CadApp.name_buf = Allocate(80)
            // default untitled
            SetByte(CadApp.name_buf, 0, 117)
            SetByte(CadApp.name_buf, 1, 110)
            SetByte(CadApp.name_buf, 2, 116)
            SetByte(CadApp.name_buf, 3, 105)
            SetByte(CadApp.name_buf, 4, 116)
            SetByte(CadApp.name_buf, 5, 108)
            SetByte(CadApp.name_buf, 6, 101)
            SetByte(CadApp.name_buf, 7, 100)
            SetByte(CadApp.name_buf, 8, 0)
        }
        IfCondition EqualTo(CadApp.part_name, 0) ThenBlock: {
            CadApp.part_name = CadApp.name_buf
        }
        ReturnValue(0)
    }
}

// Copy C-string src into name_buf and set part_name.


// Copy C-string src into name_buf and set part_name.
Function.CA_SetPartName {
    Input: src: Address
    Output: Integer
    Body: {
        CA_EnsureName()
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(-1) }
        i = 0
        o = 0
        WhileLoop LessThan(i, 63) {
            c = GetByte(src, i)
            IfCondition EqualTo(c, 0) ThenBlock: { i = 63 }
            IfCondition EqualTo(c, 10) ThenBlock: { i = 63 }
            IfCondition EqualTo(c, 13) ThenBlock: { i = 63 }
            IfCondition LessThan(i, 63) ThenBlock: {
                ok = 0
                IfCondition GreaterEqual(c, 48) ThenBlock: {
                    IfCondition LessEqual(c, 57) ThenBlock: { ok = 1 }
                }
                IfCondition GreaterEqual(c, 65) ThenBlock: {
                    IfCondition LessEqual(c, 90) ThenBlock: { ok = 1 }
                }
                IfCondition GreaterEqual(c, 97) ThenBlock: {
                    IfCondition LessEqual(c, 122) ThenBlock: { ok = 1 }
                }
                IfCondition EqualTo(c, 95) ThenBlock: { ok = 1 }
                IfCondition EqualTo(c, 45) ThenBlock: { ok = 1 }
                IfCondition EqualTo(c, 46) ThenBlock: { ok = 1 }
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    SetByte(CadApp.name_buf, o, c)
                    o = Add(o, 1)
                }
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(o, 0) ThenBlock: {
            SetByte(CadApp.name_buf, 0, 117)
            SetByte(CadApp.name_buf, 1, 110)
            SetByte(CadApp.name_buf, 2, 116)
            SetByte(CadApp.name_buf, 3, 105)
            SetByte(CadApp.name_buf, 4, 116)
            SetByte(CadApp.name_buf, 5, 108)
            SetByte(CadApp.name_buf, 6, 101)
            SetByte(CadApp.name_buf, 7, 100)
            o = 8
        }
        SetByte(CadApp.name_buf, o, 0)
        w = Add(o, 1)
        WhileLoop LessThan(w, 80) {
            SetByte(CadApp.name_buf, w, 0)
            w = Add(w, 1)
        }
        CadApp.part_name = CadApp.name_buf
        ReturnValue(0)
    }
}

// 0 part  1 assembly  2 group  3 machine  (first letter of word)
Function.CA_SetDocKind {
    Input: src: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(CadApp.doc_kind) }
        c = GetByte(src, 0)
        IfCondition EqualTo(c, 112) ThenBlock: { CadApp.doc_kind = 0 }
        IfCondition EqualTo(c, 80) ThenBlock: { CadApp.doc_kind = 0 }
        IfCondition EqualTo(c, 97) ThenBlock: { CadApp.doc_kind = 1 }
        IfCondition EqualTo(c, 65) ThenBlock: { CadApp.doc_kind = 1 }
        IfCondition EqualTo(c, 103) ThenBlock: { CadApp.doc_kind = 2 }
        IfCondition EqualTo(c, 71) ThenBlock: { CadApp.doc_kind = 2 }
        IfCondition EqualTo(c, 109) ThenBlock: { CadApp.doc_kind = 3 }
        IfCondition EqualTo(c, 77) ThenBlock: { CadApp.doc_kind = 3 }
        ReturnValue(CadApp.doc_kind)
    }
}

// Alias for Sketch_N. Identity stays Sketch_N; label is user text (Machinebase).
Function.CA_SetSketchAlias {
    Input: sk_i: Integer
    Input: src: Address
    Output: Integer
    Body: {
        IfCondition LessThan(sk_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(sk_i, 64) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sk_alias, 0) ThenBlock: {
            CadApp.sk_alias = Allocate(2048)
        }
        IfCondition EqualTo(CadApp.sk_alias, 0) ThenBlock: { ReturnValue(-1) }
        base = Multiply(sk_i, 32)
        n = 0
        i = 0
        WhileLoop LessThan(i, 31) {
            c = GetByte(src, i)
            ok = 0
            IfCondition EqualTo(c, 0) ThenBlock: { i = 31 }
            IfCondition NotEqual(c, 0) ThenBlock: {
                IfCondition EqualTo(c, 32) ThenBlock: { ok = 1 }
                IfCondition EqualTo(c, 45) ThenBlock: { ok = 1 }
                IfCondition EqualTo(c, 95) ThenBlock: { ok = 1 }
                IfCondition GreaterEqual(c, 48) ThenBlock: {
                    IfCondition LessEqual(c, 57) ThenBlock: { ok = 1 }
                }
                IfCondition GreaterEqual(c, 65) ThenBlock: {
                    IfCondition LessEqual(c, 90) ThenBlock: { ok = 1 }
                }
                IfCondition GreaterEqual(c, 97) ThenBlock: {
                    IfCondition LessEqual(c, 122) ThenBlock: { ok = 1 }
                }
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    SetByte(CadApp.sk_alias, Add(base, n), c)
                    n = Add(n, 1)
                    i = Add(i, 1)
                }
                IfCondition EqualTo(ok, 0) ThenBlock: { i = 31 }
            }
        }
        SetByte(CadApp.sk_alias, Add(base, n), 0)
        ReturnValue(0)
    }
}

// Alias for a feature-tree row (Pad, Fillet, …). Type label stays.
Function.CA_SetFeatAlias {
    Input: feat_i: Integer
    Input: src: Address
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, 128) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.feat_alias, 0) ThenBlock: {
            CadApp.feat_alias = Allocate(4096)
        }
        IfCondition EqualTo(CadApp.feat_alias, 0) ThenBlock: { ReturnValue(-1) }
        base = Multiply(feat_i, 32)
        n = 0
        i = 0
        WhileLoop LessThan(i, 31) {
            c = GetByte(src, i)
            ok = 0
            IfCondition EqualTo(c, 0) ThenBlock: { i = 31 }
            IfCondition NotEqual(c, 0) ThenBlock: {
                IfCondition EqualTo(c, 32) ThenBlock: { ok = 1 }
                IfCondition EqualTo(c, 45) ThenBlock: { ok = 1 }
                IfCondition EqualTo(c, 95) ThenBlock: { ok = 1 }
                IfCondition GreaterEqual(c, 48) ThenBlock: {
                    IfCondition LessEqual(c, 57) ThenBlock: { ok = 1 }
                }
                IfCondition GreaterEqual(c, 65) ThenBlock: {
                    IfCondition LessEqual(c, 90) ThenBlock: { ok = 1 }
                }
                IfCondition GreaterEqual(c, 97) ThenBlock: {
                    IfCondition LessEqual(c, 122) ThenBlock: { ok = 1 }
                }
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    SetByte(CadApp.feat_alias, Add(base, n), c)
                    n = Add(n, 1)
                    i = Add(i, 1)
                }
                IfCondition EqualTo(ok, 0) ThenBlock: { i = 31 }
            }
        }
        SetByte(CadApp.feat_alias, Add(base, n), 0)
        ReturnValue(0)
    }
}

// Copy n qwords. Forensic — no nested calls inside the loop.
Function.CA_CopyWords {
    Input: src: Address
    Input: dst: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n) {
            ArraySet(dst, i, ArrayGet(src, i))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

// Full sketch store: lines, loop, circles, arcs, profiles, pool,
// join anchors (circle/arc T/X), constraints, user points, plane.
// Same layout as CreateSketch — enough to rebuild the page exactly.
Function.CA_SketchCopy {
    Input: src: Integer
    Input: dst: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(dst, 4, CAD_Store.Read(src, 4))
        CAD_Store.Write(dst, 19, CAD_Store.Read(src, 19))
        CAD_Store.Write(dst, 23, CAD_Store.Read(src, 23))
        CAD_Store.Write(dst, 27, CAD_Store.Read(src, 27))
        // lines
        nl = CAD_Store.Read(src, 0)
        IfCondition GreaterThan(nl, 4096) ThenBlock: { nl = 4096 }
        CA_CopyWords(CAD_Store.Read(src, 1), CAD_Store.Read(dst, 1), Multiply(nl, 4))
        CAD_Store.Write(dst, 0, nl)
        // primary loop (closed ring after split/trim)
        nlp = CAD_Store.Read(src, 2)
        IfCondition GreaterThan(nlp, 4096) ThenBlock: { nlp = 4096 }
        CA_CopyWords(CAD_Store.Read(src, 3), CAD_Store.Read(dst, 3), Multiply(nlp, 2))
        CAD_Store.Write(dst, 2, nlp)
        // circles
        nc = CAD_Store.Read(src, 7)
        IfCondition GreaterThan(nc, 64) ThenBlock: { nc = 64 }
        CA_CopyWords(CAD_Store.Read(src, 8), CAD_Store.Read(dst, 8), Multiply(nc, 3))
        CAD_Store.Write(dst, 7, nc)
        // arcs (trim turns circles into arcs — must keep every piece)
        na = CAD_Store.Read(src, 10)
        IfCondition GreaterThan(na, 512) ThenBlock: { na = 512 }
        CA_CopyWords(CAD_Store.Read(src, 11), CAD_Store.Read(dst, 11), Multiply(na, 5))
        CAD_Store.Write(dst, 10, na)
        // profile meta + pool
        np = CAD_Store.Read(src, 12)
        IfCondition GreaterThan(np, 64) ThenBlock: { np = 64 }
        pm = CAD_Store.Read(src, 13)
        CA_CopyWords(pm, CAD_Store.Read(dst, 13), Multiply(np, 2))
        CAD_Store.Write(dst, 12, np)
        pool_n = 0
        IfCondition GreaterThan(np, 0) ThenBlock: {
            pm = CAD_Store.Read(src, 13)
            pi = 0
            WhileLoop LessThan(pi, np) {
                pn = ArrayGet(pm, Multiply(pi, 2))
                pst = ArrayGet(pm, Add(Multiply(pi, 2), 1))
                pend = Add(pst, Multiply(pn, 2))
                IfCondition GreaterThan(pend, pool_n) ThenBlock: { pool_n = pend }
                pi = Add(pi, 1)
            }
        }
        IfCondition GreaterThan(pool_n, 16384) ThenBlock: { pool_n = 16384 }
        CA_CopyWords(CAD_Store.Read(src, 14), CAD_Store.Read(dst, 14), pool_n)
        // join anchors — circle×arc / T / X (drawn on top of curves)
        npt = CAD_Store.Read(src, 16)
        IfCondition GreaterThan(npt, 1024) ThenBlock: { npt = 1024 }
        CA_CopyWords(CAD_Store.Read(src, 17), CAD_Store.Read(dst, 17), Multiply(npt, 2))
        CAD_Store.Write(dst, 16, npt)
        // constraints
        ncs = CAD_Store.Read(src, 20)
        IfCondition GreaterThan(ncs, 128) ThenBlock: { ncs = 128 }
        CA_CopyWords(CAD_Store.Read(src, 21), CAD_Store.Read(dst, 21), Multiply(ncs, 8))
        CAD_Store.Write(dst, 20, ncs)
        // user points
        nu = CAD_Store.Read(src, 24)
        IfCondition GreaterThan(nu, 512) ThenBlock: { nu = 512 }
        CA_CopyWords(CAD_Store.Read(src, 25), CAD_Store.Read(dst, 25), Multiply(nu, 2))
        CAD_Store.Write(dst, 24, nu)
        ReturnValue(1)
    }
}

Function.CA_HistEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.hist_sk, 0) ThenBlock: {
            CadApp.hist_sk = Allocate(1024)
            CadApp.hist_solid = Allocate(1024)
            CadApp.hist_kind = Allocate(1024)
            CadApp.hist_mode = Allocate(1024)
        }
        IfCondition EqualTo(CadApp.hist_ski, 0) ThenBlock: {
            CadApp.hist_ski = Allocate(1024)
        }
        IfCondition EqualTo(CadApp.hist_fi, 0) ThenBlock: {
            CadApp.hist_fi = Allocate(1024)
            CA_ZeroSpan(CadApp.hist_fi, 0, 128)
        }
        IfCondition EqualTo(CadApp.hist_sk, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

// 0 when the active sketch is not in the list. Else sketch index + 1.
Function.CA_HistSketchSlot {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.sk_list, 0) ThenBlock: { ReturnValue(0) }
        CadAppReplay.i = 0
        WhileLoop LessThan(CadAppReplay.i, CadApp.sk_n) {
            CadAppReplay.e = ArrayGet(CadApp.sk_list, CadAppReplay.i)
            IfCondition EqualTo(CadAppReplay.e, CadApp.sketch) ThenBlock: {
                ReturnValue(Add(CadAppReplay.i, 1))
            }
            CadAppReplay.i = Add(CadAppReplay.i, 1)
        }
        ReturnValue(0)
    }
}

// Write /tmp/cad_app/hist.txt  first line: n cur   then "i * label"
Function.CA_WriteHist {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppIpc.hist, 0) ThenBlock: { CadAppIpc.hist = Allocate(4096) }
        IfCondition EqualTo(CadAppIpc.hist, 0) ThenBlock: { ReturnValue(-1) }
        CA_FeatOrdBackfill()
        CadAppRepo.pos = 0
        CadAppRepo.pos = CAD_Repo.AppendInt(CadAppIpc.hist, CadAppRepo.pos, CadApp.hist_n)
        CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, " ")
        CadAppRepo.pos = CAD_Repo.AppendInt(CadAppIpc.hist, CadAppRepo.pos, CadApp.hist_cur)
        CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "\n")
        // Index lives in CadAppRepo.body. CadAppRepo.feat_i is the replay cursor.
        // Resetting feat_i here made CA_RepoReplayFeats sweep the same extrude twice.
        CadAppRepo.body = 0
        WhileLoop LessThan(CadAppRepo.body, CadApp.hist_n) {
            IfCondition GreaterThan(CadAppRepo.pos, 4000) ThenBlock: {
                CadAppRepo.body = CadApp.hist_n
            }
            IfCondition LessThan(CadAppRepo.pos, 4001) ThenBlock: {
                CadAppRepo.pos = CAD_Repo.AppendInt(CadAppIpc.hist, CadAppRepo.pos, CadAppRepo.body)
                CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, " ")
                IfCondition EqualTo(CadAppRepo.body, CadApp.hist_cur) ThenBlock: {
                    CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "* ")
                }
                IfCondition NotEqual(CadAppRepo.body, CadApp.hist_cur) ThenBlock: {
                    CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, ". ")
                }
                CadAppRepo.pos = CA_AppendHistName(CadAppRepo.body)
                CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "\n")
                CadAppRepo.body = Add(CadAppRepo.body, 1)
            }
        }
        SetByte(CadAppIpc.hist, CadAppRepo.pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/hist.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, CadAppIpc.hist, CadAppRepo.pos)
            SystemCall(3, fd, 0, 0)
        }
        ReturnValue(0)
    }
}

// Push a snapshot after a real change. kind 0..6. Drops redo tail.
Function.CA_HistPush {
    Input: kind: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_HistEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        nxt = Add(CadApp.hist_cur, 1)
        IfCondition LessThan(nxt, CadApp.hist_n) ThenBlock: {
            CadApp.hist_n = nxt
        }
        IfCondition GreaterEqual(CadApp.hist_n, 128) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, 127) {
                ArraySet(CadApp.hist_sk, i, ArrayGet(CadApp.hist_sk, Add(i, 1)))
                ArraySet(CadApp.hist_solid, i, ArrayGet(CadApp.hist_solid, Add(i, 1)))
                ArraySet(CadApp.hist_kind, i, ArrayGet(CadApp.hist_kind, Add(i, 1)))
                ArraySet(CadApp.hist_mode, i, ArrayGet(CadApp.hist_mode, Add(i, 1)))
                IfCondition NotEqual(CadApp.hist_ski, 0) ThenBlock: {
                    ArraySet(CadApp.hist_ski, i, ArrayGet(CadApp.hist_ski, Add(i, 1)))
                }
                IfCondition NotEqual(CadApp.hist_fi, 0) ThenBlock: {
                    ArraySet(CadApp.hist_fi, i, ArrayGet(CadApp.hist_fi, Add(i, 1)))
                }
                i = Add(i, 1)
            }
            CadApp.hist_n = 127
        }
        wp = CAD_Store.Read(CadApp.sketch, 4)
        snap = CAD_Sketch.CreateSketch(wp)
        IfCondition NotEqual(snap, 0) ThenBlock: {
            CA_SketchCopy(CadApp.sketch, snap)
        }
        slot = CadApp.hist_n
        ArraySet(CadApp.hist_sk, slot, snap)
        ArraySet(CadApp.hist_solid, slot, CadApp.solid)
        ArraySet(CadApp.hist_kind, slot, kind)
        ArraySet(CadApp.hist_mode, slot, CadApp.mode)
        IfCondition NotEqual(CadApp.hist_ski, 0) ThenBlock: {
            CadAppReplay.guard = CA_HistSketchSlot()
            ArraySet(CadApp.hist_ski, CadApp.hist_n, CadAppReplay.guard)
        }
        IfCondition NotEqual(CadApp.hist_fi, 0) ThenBlock: {
            CadAppReplay.guard = 0
            IfCondition EqualTo(CadApp.replay, 1) ThenBlock: {
                IfCondition GreaterEqual(CadAppRepo.feat_i, 0) ThenBlock: {
                    IfCondition LessThan(CadAppRepo.feat_i, CadApp.feat_n) ThenBlock: {
                        IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadAppRepo.feat_i), ArrayGet(CadApp.hist_kind, CadApp.hist_n)) ThenBlock: {
                            CadAppReplay.guard = Add(CadAppRepo.feat_i, 1)
                        }
                    }
                }
            }
            IfCondition EqualTo(CadAppReplay.guard, 0) ThenBlock: {
                IfCondition GreaterEqual(CadApp.feat_sel, 0) ThenBlock: {
                    IfCondition LessThan(CadApp.feat_sel, CadApp.feat_n) ThenBlock: {
                        IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadApp.feat_sel), ArrayGet(CadApp.hist_kind, CadApp.hist_n)) ThenBlock: {
                            CadAppReplay.guard = Add(CadApp.feat_sel, 1)
                        }
                    }
                }
            }
            ArraySet(CadApp.hist_fi, CadApp.hist_n, CadAppReplay.guard)
        }
        CadApp.hist_n = Add(CadApp.hist_n, 1)
        CadApp.hist_cur = Subtract(CadApp.hist_n, 1)
        CA_WriteHist()
        CA_CmdPut()
        ReturnValue(1)
    }
}

// Millimetres as a float to integer micrometers. Sign bit stays a sign.
Function.CA_MmToUm {
    Input: mm: Integer
    Output: Integer
    Body: {
        sign = 0
        bits = mm
        IfCondition NotEqual(BitwiseAnd(mm, 0x8000000000000000), 0) ThenBlock: {
            sign = 1
            bits = BitwiseAnd(mm, 0x7FFFFFFFFFFFFFFF)
        }
        um = Float_ToInt(Float_Mul(bits, 0x408F400000000000))
        IfCondition EqualTo(sign, 1) ThenBlock: { um = Subtract(0, um) }
        ReturnValue(um)
    }
}

// One cad_cmd row for the step just pushed. Redo tail (seq >= this) is deleted.
// a/b are integer millimetres, except fillet a, which is micrometres.
// Fillet and chamfer edges go to cad_cmd_edge.
Function.CA_CmdPut {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.hist_n, 1) ThenBlock: { ReturnValue(0) }
        CA_EnsureName()
        CAD_Repo_State.cmd_rev = CAD_Repo.EnsureCmdRev(CadApp.part_name)
        IfCondition LessThan(CAD_Repo_State.cmd_rev, 1) ThenBlock: { ReturnValue(0) }
        CAD_Repo_State.cmd_seq = CadApp.hist_cur
        CAD_Repo_State.cmd_kind = ArrayGet(CadApp.hist_kind, CadApp.hist_cur)
        CAD_Repo_State.cmd_sk = 0
        IfCondition NotEqual(CadApp.hist_ski, 0) ThenBlock: {
            CAD_Repo_State.cmd_sk = ArrayGet(CadApp.hist_ski, CadApp.hist_cur)
            IfCondition GreaterThan(CAD_Repo_State.cmd_sk, 0) ThenBlock: {
                CAD_Repo_State.cmd_sk = Subtract(CAD_Repo_State.cmd_sk, 1)
            }
        }
        CAD_Repo_State.cmd_a = 0
        CAD_Repo_State.cmd_b = 0
        CAD_Repo_State.cmd_c = 0
        CAD_Repo_State.cmd_d = 0
        IfCondition EqualTo(CAD_Repo_State.cmd_kind, 1) ThenBlock: {
            CAD_Repo_State.cmd_a = CadApp.height
            CAD_Repo_State.cmd_b = CadAppPad.oi
        }
        IfCondition EqualTo(CAD_Repo_State.cmd_kind, 3) ThenBlock: {
            CAD_Repo_State.cmd_a = CadApp.height
            CAD_Repo_State.cmd_b = CadAppPad.oi
        }
        IfCondition EqualTo(CAD_Repo_State.cmd_kind, 2) ThenBlock: { CAD_Repo_State.cmd_a = CadApp.rev_deg }
        IfCondition EqualTo(CAD_Repo_State.cmd_kind, 4) ThenBlock: {
            CAD_Repo_State.cmd_a = CA_FilletMmToUm(CadApp.fillet_r)
            IfCondition GreaterThan(CadApp.last_bl_n, 0) ThenBlock: {
                CAD_Repo_State.cmd_d = CadApp.last_bl_n
            }
            IfCondition GreaterThan(CAD_Repo_State.cmd_d, 64) ThenBlock: { CAD_Repo_State.cmd_d = 64 }
        }
        IfCondition EqualTo(CAD_Repo_State.cmd_kind, 5) ThenBlock: {
            CAD_Repo_State.cmd_a = CadApp.chamfer_d
            CAD_Repo_State.cmd_b = CadApp.chamfer_a
            IfCondition GreaterThan(CadApp.last_bl_n, 0) ThenBlock: {
                CAD_Repo_State.cmd_d = CadApp.last_bl_n
            }
            IfCondition GreaterThan(CAD_Repo_State.cmd_d, 64) ThenBlock: { CAD_Repo_State.cmd_d = 64 }
        }
        IfCondition EqualTo(CAD_Repo_State.cmd_kind, 10) ThenBlock: { CAD_Repo_State.cmd_a = CadApp.circ_r }
        IfCondition EqualTo(CAD_Repo_State.cmd_kind, 11) ThenBlock: {
            CAD_Repo_State.cmd_a = CadApp.rect_w
            CAD_Repo_State.cmd_b = CadApp.rect_h
        }
        CAD_Repo.PutCmd()
        IfCondition EqualTo(CAD_Repo_State.cmd_kind, 4) ThenBlock: {
            CA_LogInt("cad_app: cmd edges n=", 21, CAD_Repo_State.cmd_d)
            CA_CmdPutEdges()
        }
        IfCondition EqualTo(CAD_Repo_State.cmd_kind, 5) ThenBlock: {
            CA_LogInt("cad_app: cmd edges n=", 21, CAD_Repo_State.cmd_d)
            CA_CmdPutEdges()
        }
        CA_LogInt("cad_app: cmd seq=", 17, CadApp.hist_cur)
        ReturnValue(0)
    }
}

Function.CA_CmdPutEdges {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.last_bl_x, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CadApp.last_bl_n, 1) ThenBlock: { ReturnValue(0) }
        CAD_Repo_State.cmd_d = CadApp.last_bl_n
        IfCondition GreaterThan(CAD_Repo_State.cmd_d, 64) ThenBlock: { CAD_Repo_State.cmd_d = 64 }
        CAD_Repo_State.cmd_i = 0
        WhileLoop LessThan(CAD_Repo_State.cmd_i, CAD_Repo_State.cmd_d) {
            CAD_Repo_State.cmd_x = CA_MmToUm(ArrayGet(CadApp.last_bl_x, CAD_Repo_State.cmd_i))
            CAD_Repo_State.cmd_y = CA_MmToUm(ArrayGet(CadApp.last_bl_y, CAD_Repo_State.cmd_i))
            CAD_Repo_State.cmd_z = CA_MmToUm(ArrayGet(CadApp.last_bl_z, CAD_Repo_State.cmd_i))
            CAD_Repo.PutCmdEdge()
            CAD_Repo_State.cmd_i = Add(CAD_Repo_State.cmd_i, 1)
        }
        ReturnValue(0)
    }
}

Function.CA_HistGo {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(idx, CadApp.hist_n) ThenBlock: { ReturnValue(-1) }
        CadAppReplay.hi = idx
        CadAppReplay.ski = 0
        IfCondition NotEqual(CadApp.hist_ski, 0) ThenBlock: {
            CadAppReplay.ski = ArrayGet(CadApp.hist_ski, CadAppReplay.hi)
        }
        CadAppReplay.tool = ArrayGet(CadApp.hist_sk, CadAppReplay.hi)
        IfCondition GreaterThan(CadAppReplay.ski, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.sk_list, 0) ThenBlock: {
                CadAppReplay.guard = Subtract(CadAppReplay.ski, 1)
                IfCondition GreaterEqual(CadAppReplay.guard, 0) ThenBlock: {
                    IfCondition LessThan(CadAppReplay.guard, CadApp.sk_n) ThenBlock: {
                        CadAppReplay.e = ArrayGet(CadApp.sk_list, CadAppReplay.guard)
                        IfCondition NotEqual(CadAppReplay.tool, 0) ThenBlock: {
                            IfCondition NotEqual(CadAppReplay.e, 0) ThenBlock: {
                                CA_SketchCopy(CadAppReplay.tool, CadAppReplay.e)
                                CadAppReplay.e = ArrayGet(CadApp.sk_list, Subtract(CadAppReplay.ski, 1))
                                CAD_Sketch.RebuildAnchors(CadAppReplay.e)
                                CadApp.sketch = CadAppReplay.e
                                CadApp.nprof = CAD_Store.Read(CadApp.sketch, 12)
                            }
                        }
                    }
                }
            }
        }
        CadAppReplay.sk = CadApp.sketch
        CadApp.replay = 1
        CadAppReplay.snap = 1
        CA_ReplayTo(CadAppReplay.hi)
        CadAppReplay.snap = 0
        CadApp.replay = 0
        CadApp.sketch = CadAppReplay.sk
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            CadApp.nprof = CAD_Store.Read(CadApp.sketch, 12)
        }
        CadApp.mode = ArrayGet(CadApp.hist_mode, CadAppReplay.hi)
        CadApp.hist_cur = CadAppReplay.hi
        CadApp.nclick = 0
        CadApp.face_pick = 0
        CadApp.plane_pick = 0
        CadApp.dirty = 1
        CAD_View.InvalidateMesh()
        CA_WriteHist()
        CA_HudClose()
        ReturnValue(0)
    }
}

// Timeline chip. Rebuild to this step, mark that work-tree row, open its HUD.
// The slider calls CA_HistGo and does not reach here.
Function.CA_HistPick {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_HistGo(idx), 0) ThenBlock: { ReturnValue(-1) }
        CadAppReplay.fi = 0
        IfCondition NotEqual(CadApp.hist_fi, 0) ThenBlock: {
            CadAppReplay.fi = ArrayGet(CadApp.hist_fi, CadApp.hist_cur)
        }
        IfCondition LessThan(CadAppReplay.fi, 1) ThenBlock: {
            CA_HistFeatFallback()
            CadAppReplay.fi = CadAppReplay.guard
        }
        IfCondition GreaterThan(CadAppReplay.fi, 0) ThenBlock: {
            IfCondition LessEqual(CadAppReplay.fi, CadApp.feat_n) ThenBlock: {
                CadApp.feat_sel = Subtract(CadAppReplay.fi, 1)
            }
        }
        CA_HistOpenHud()
        CA_LogInt("cad_app: hist pick i=", 21, CadApp.hist_cur)
        ReturnValue(0)
    }
}

Function.CA_HistBack {
    Output: Integer
    Body: {
        IfCondition LessEqual(CadApp.hist_cur, 0) ThenBlock: {
            CA_Log("cad_app: history at start\n", 26)
            ReturnValue(-1)
        }
        ReturnValue(CA_HistGo(Subtract(CadApp.hist_cur, 1)))
    }
}

Function.CA_HistFwd {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(Add(CadApp.hist_cur, 1), CadApp.hist_n) ThenBlock: {
            CA_Log("cad_app: history at end\n", 24)
            ReturnValue(-1)
        }
        ReturnValue(CA_HistGo(Add(CadApp.hist_cur, 1)))
    }
}

// Drop the redo tail after the marker. Keep steps 0..hist_cur.
Function.CA_HistPrune {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.hist_n, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CadApp.hist_cur, 0) ThenBlock: {
            CadApp.hist_cur = 0
        }
        IfCondition GreaterEqual(CadApp.hist_cur, CadApp.hist_n) ThenBlock: {
            CadApp.hist_cur = Subtract(CadApp.hist_n, 1)
        }
        CadAppReplay.n = Add(CadApp.hist_cur, 1)
        CadAppReplay.hi = Subtract(CadApp.hist_n, CadAppReplay.n)
        CadApp.hist_n = CadAppReplay.n
        CA_LogInt("cad_app: prune keep=", 20, CadApp.hist_n)
        CA_LogInt("cad_app: prune drop=", 20, CadAppReplay.hi)
        CA_Log("cad_app: history pruned\n", 24)
        CA_WriteHist()
        CA_EnsureName()
        CAD_Repo_State.cmd_rev = CAD_Repo.EnsureCmdRev(CadApp.part_name)
        IfCondition GreaterThan(CAD_Repo_State.cmd_rev, 0) ThenBlock: {
            CAD_Repo_State.cmd_seq = CadApp.hist_cur
            CAD_Repo.DropCmdAfter()
        }
        ReturnValue(0)
    }
}

// Copy shared entities onto a snapshot. Counts on dst stay, so a shorter
// page cannot wipe a line or arc that was added later on this sketch.
Function.CA_HistCopyShared {
    Input: src: Integer
    Input: dst: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(src, dst) ThenBlock: { ReturnValue(0) }
        CadAppReplay.n = CAD_Store.Read(src, 0)
        CadAppReplay.ne = CAD_Store.Read(dst, 0)
        IfCondition LessThan(CadAppReplay.ne, CadAppReplay.n) ThenBlock: { CadAppReplay.n = CadAppReplay.ne }
        IfCondition GreaterThan(CadAppReplay.n, 4096) ThenBlock: { CadAppReplay.n = 4096 }
        IfCondition GreaterThan(CadAppReplay.n, 0) ThenBlock: {
            CA_CopyWords(CAD_Store.Read(src, 1), CAD_Store.Read(dst, 1), Multiply(CadAppReplay.n, 4))
        }
        CadAppReplay.n = CAD_Store.Read(src, 7)
        CadAppReplay.ne = CAD_Store.Read(dst, 7)
        IfCondition LessThan(CadAppReplay.ne, CadAppReplay.n) ThenBlock: { CadAppReplay.n = CadAppReplay.ne }
        IfCondition GreaterThan(CadAppReplay.n, 64) ThenBlock: { CadAppReplay.n = 64 }
        IfCondition GreaterThan(CadAppReplay.n, 0) ThenBlock: {
            CA_CopyWords(CAD_Store.Read(src, 8), CAD_Store.Read(dst, 8), Multiply(CadAppReplay.n, 3))
        }
        CadAppReplay.n = CAD_Store.Read(src, 10)
        CadAppReplay.ne = CAD_Store.Read(dst, 10)
        IfCondition LessThan(CadAppReplay.ne, CadAppReplay.n) ThenBlock: { CadAppReplay.n = CadAppReplay.ne }
        IfCondition GreaterThan(CadAppReplay.n, 512) ThenBlock: { CadAppReplay.n = 512 }
        IfCondition GreaterThan(CadAppReplay.n, 0) ThenBlock: {
            CA_CopyWords(CAD_Store.Read(src, 11), CAD_Store.Read(dst, 11), Multiply(CadAppReplay.n, 5))
        }
        CadAppReplay.n = CAD_Store.Read(src, 20)
        CadAppReplay.ne = CAD_Store.Read(dst, 20)
        IfCondition LessThan(CadAppReplay.ne, CadAppReplay.n) ThenBlock: { CadAppReplay.n = CadAppReplay.ne }
        IfCondition GreaterThan(CadAppReplay.n, 128) ThenBlock: { CadAppReplay.n = 128 }
        IfCondition GreaterThan(CadAppReplay.n, 0) ThenBlock: {
            CA_CopyWords(CAD_Store.Read(src, 21), CAD_Store.Read(dst, 21), Multiply(CadAppReplay.n, 8))
        }
        CadAppReplay.n = CAD_Store.Read(src, 24)
        CadAppReplay.ne = CAD_Store.Read(dst, 24)
        IfCondition LessThan(CadAppReplay.ne, CadAppReplay.n) ThenBlock: { CadAppReplay.n = CadAppReplay.ne }
        IfCondition GreaterThan(CadAppReplay.n, 512) ThenBlock: { CadAppReplay.n = 512 }
        IfCondition GreaterThan(CadAppReplay.n, 0) ThenBlock: {
            CA_CopyWords(CAD_Store.Read(src, 25), CAD_Store.Read(dst, 25), Multiply(CadAppReplay.n, 2))
        }
        ReturnValue(1)
    }
}

// Push the live sketch's edited entities into every snapshot of that sketch.
Function.CA_HistSyncSketchGeom {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.hist_sk, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.hist_ski, 0) ThenBlock: { ReturnValue(0) }
        CadAppReplay.guard = CA_HistSketchSlot()
        IfCondition EqualTo(CadAppReplay.guard, 0) ThenBlock: { ReturnValue(0) }
        CadAppReplay.i = 0
        WhileLoop LessThan(CadAppReplay.i, CadApp.hist_n) {
            IfCondition EqualTo(ArrayGet(CadApp.hist_ski, CadAppReplay.i), CadAppReplay.guard) ThenBlock: {
                CadAppReplay.e = ArrayGet(CadApp.hist_sk, CadAppReplay.i)
                IfCondition NotEqual(CadAppReplay.e, 0) ThenBlock: {
                    CA_HistCopyShared(CadApp.sketch, CadAppReplay.e)
                }
            }
            CadAppReplay.i = Add(CadAppReplay.i, 1)
        }
        ReturnValue(0)
    }
}

// Update the cad_cmd row for the selected feature. Later seq rows stay.
Function.CA_CmdTouch {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.hist_n, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.hist_fi, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CadApp.feat_sel, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(CadApp.feat_sel, CadApp.feat_n) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(0) }
        CadAppReplay.fk = ArrayGet(CadApp.feat_kind, CadApp.feat_sel)
        CadAppReplay.guard = Add(CadApp.feat_sel, 1)
        CadAppReplay.hi = -1
        CadAppReplay.i = 0
        WhileLoop LessThan(CadAppReplay.i, CadApp.hist_n) {
            IfCondition EqualTo(ArrayGet(CadApp.hist_fi, CadAppReplay.i), CadAppReplay.guard) ThenBlock: {
                CadAppReplay.hi = CadAppReplay.i
            }
            CadAppReplay.i = Add(CadAppReplay.i, 1)
        }
        IfCondition LessThan(CadAppReplay.hi, 0) ThenBlock: { ReturnValue(0) }
        CadAppReplay.ok = 0
        IfCondition EqualTo(CadAppReplay.fk, 1) ThenBlock: { CadAppReplay.ok = 1 }
        IfCondition EqualTo(CadAppReplay.fk, 2) ThenBlock: { CadAppReplay.ok = 1 }
        IfCondition EqualTo(CadAppReplay.fk, 3) ThenBlock: { CadAppReplay.ok = 1 }
        IfCondition EqualTo(CadAppReplay.fk, 4) ThenBlock: { CadAppReplay.ok = 1 }
        IfCondition EqualTo(CadAppReplay.fk, 5) ThenBlock: { CadAppReplay.ok = 1 }
        IfCondition EqualTo(CadAppReplay.fk, 10) ThenBlock: { CadAppReplay.ok = 1 }
        IfCondition EqualTo(CadAppReplay.fk, 11) ThenBlock: { CadAppReplay.ok = 1 }
        IfCondition EqualTo(CadAppReplay.ok, 0) ThenBlock: { ReturnValue(0) }
        CA_EnsureName()
        CAD_Repo_State.cmd_rev = CAD_Repo.EnsureCmdRev(CadApp.part_name)
        IfCondition LessThan(CAD_Repo_State.cmd_rev, 1) ThenBlock: { ReturnValue(0) }
        CAD_Repo_State.cmd_seq = CadAppReplay.hi
        CAD_Repo_State.cmd_kind = CadAppReplay.fk
        CAD_Repo_State.cmd_a = 0
        CAD_Repo_State.cmd_b = 0
        CAD_Repo_State.cmd_c = 0
        CAD_Repo_State.cmd_d = 0
        IfCondition EqualTo(CadAppReplay.fk, 1) ThenBlock: {
            CAD_Repo_State.cmd_a = CadApp.height
            CAD_Repo_State.cmd_b = 0
            IfCondition NotEqual(CadAppPad.ois, 0) ThenBlock: {
                IfCondition GreaterEqual(CadApp.feat_sel, 0) ThenBlock: {
                    IfCondition LessThan(CadApp.feat_sel, CadApp.feat_n) ThenBlock: {
                        CAD_Repo_State.cmd_b = ArrayGet(CadAppPad.ois, CadApp.feat_sel)
                    }
                }
            }
        }
        IfCondition EqualTo(CadAppReplay.fk, 3) ThenBlock: {
            CAD_Repo_State.cmd_a = CadApp.height
            CAD_Repo_State.cmd_b = 0
            IfCondition NotEqual(CadAppPad.ois, 0) ThenBlock: {
                IfCondition GreaterEqual(CadApp.feat_sel, 0) ThenBlock: {
                    IfCondition LessThan(CadApp.feat_sel, CadApp.feat_n) ThenBlock: {
                        CAD_Repo_State.cmd_b = ArrayGet(CadAppPad.ois, CadApp.feat_sel)
                    }
                }
            }
        }
        IfCondition EqualTo(CadAppReplay.fk, 2) ThenBlock: { CAD_Repo_State.cmd_a = CadApp.rev_deg }
        IfCondition EqualTo(CadAppReplay.fk, 4) ThenBlock: {
            CAD_Repo_State.cmd_a = CA_FilletMmToUm(CadApp.fillet_r)
        }
        IfCondition EqualTo(CadAppReplay.fk, 5) ThenBlock: {
            CAD_Repo_State.cmd_a = CadApp.chamfer_d
            CAD_Repo_State.cmd_b = CadApp.chamfer_a
        }
        IfCondition EqualTo(CadAppReplay.fk, 10) ThenBlock: { CAD_Repo_State.cmd_a = CadApp.circ_r }
        IfCondition EqualTo(CadAppReplay.fk, 11) ThenBlock: {
            CAD_Repo_State.cmd_a = CadApp.rect_w
            CAD_Repo_State.cmd_b = CadApp.rect_h
        }
        CAD_Repo.UpdateCmd()
        CA_LogInt("cad_app: cmd edit seq=", 22, CadAppReplay.hi)
        ReturnValue(0)
    }
}

// Replay the whole command list with the edited numbers. Does not push
// and does not drop the redo tail. Returns 1 when feat_sel applied.
Function.CA_FeatRegen {
    Output: Integer
    Body: {
        CadAppReplay.ski = 0
        IfCondition LessThan(CadApp.hist_n, 1) ThenBlock: {
            CAD_View.InvalidateMesh()
            ReturnValue(0)
        }
        CA_CmdTouch()
        CA_HistSyncSketchGeom()
        CadAppReplay.sk = CadApp.sketch
        CadApp.replay = 1
        CadAppReplay.snap = 1
        CadAppReplay.ski = 0
        CadAppReplay.hi = Subtract(CadApp.hist_n, 1)
        CA_ReplayTo(CadAppReplay.hi)
        CadAppReplay.snap = 0
        CadApp.replay = 0
        CadApp.sketch = CadAppReplay.sk
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            CadApp.nprof = CAD_Store.Read(CadApp.sketch, 12)
        }
        CadApp.dirty = 1
        CAD_View.InvalidateMesh()
        CA_WriteHist()
        ReturnValue(CadAppReplay.ski)
    }
}

// Nth feature of this history kind, index+1. Used when hist_fi was never stored.
Function.CA_HistFeatFallback {
    Output: Integer
    Body: {
        CadAppReplay.guard = 0
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.hist_kind, 0) ThenBlock: { ReturnValue(0) }
        CadAppReplay.fk = ArrayGet(CadApp.hist_kind, CadApp.hist_cur)
        CadAppReplay.n = 0
        CadAppReplay.i = 0
        WhileLoop LessEqual(CadAppReplay.i, CadApp.hist_cur) {
            IfCondition LessThan(CadAppReplay.i, CadApp.hist_n) ThenBlock: {
                IfCondition EqualTo(ArrayGet(CadApp.hist_kind, CadAppReplay.i), CadAppReplay.fk) ThenBlock: {
                    CadAppReplay.n = Add(CadAppReplay.n, 1)
                }
            }
            CadAppReplay.i = Add(CadAppReplay.i, 1)
        }
        IfCondition LessThan(CadAppReplay.n, 1) ThenBlock: { ReturnValue(0) }
        CadAppReplay.got = 0
        CadAppReplay.i = 0
        WhileLoop LessThan(CadAppReplay.i, CadApp.feat_n) {
            IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadAppReplay.i), CadAppReplay.fk) ThenBlock: {
                CadAppReplay.got = Add(CadAppReplay.got, 1)
                IfCondition EqualTo(CadAppReplay.got, CadAppReplay.n) ThenBlock: {
                    CadAppReplay.guard = Add(CadAppReplay.i, 1)
                    ReturnValue(CadAppReplay.guard)
                }
            }
            CadAppReplay.i = Add(CadAppReplay.i, 1)
        }
        ReturnValue(0)
    }
}

// Open the editor for one feature. The work-tree * mark follows feat_sel.
Function.CA_FeatOpenHud {
    Input: fi: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(fi, 0) ThenBlock: {
            CA_HudClose()
            ReturnValue(0)
        }
        IfCondition GreaterEqual(fi, CadApp.feat_n) ThenBlock: {
            CA_HudClose()
            ReturnValue(0)
        }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: {
            CA_HudClose()
            ReturnValue(0)
        }
        CadApp.feat_sel = fi
        CadApp.fillet_edit = 0
        CadApp.chamfer_edit = 0
        CadAppReplay.fk = ArrayGet(CadApp.feat_kind, CadApp.feat_sel)
        IfCondition EqualTo(CadAppReplay.fk, 0) ThenBlock: {
            CA_HudClose()
            ReturnValue(0)
        }
        IfCondition EqualTo(CadAppReplay.fk, 6) ThenBlock: {
            CA_HudClose()
            ReturnValue(0)
        }
        IfCondition EqualTo(CadAppReplay.fk, 7) ThenBlock: {
            CA_HudClose()
            ReturnValue(0)
        }
        CA_LogInt("cad_app: open hud k=", 20, CadAppReplay.fk)
        CadAppReplay.ok = -1
        IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadApp.feat_sel), 1) ThenBlock: {
            CadAppReplay.ok = CA_PadEditFeat(CadApp.feat_sel)
        }
        IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadApp.feat_sel), 2) ThenBlock: {
            CadAppReplay.ok = CA_RevEditFeat(CadApp.feat_sel)
        }
        IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadApp.feat_sel), 3) ThenBlock: {
            CadAppReplay.ok = CA_PadEditFeat(CadApp.feat_sel)
        }
        IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadApp.feat_sel), 4) ThenBlock: {
            CadAppReplay.ok = CA_Fillet3dEditFeat(CadApp.feat_sel)
        }
        IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadApp.feat_sel), 5) ThenBlock: {
            CadAppReplay.ok = CA_ChamferEditFeat(CadApp.feat_sel)
        }
        IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadApp.feat_sel), 8) ThenBlock: {
            CadAppReplay.ok = CA_PolyEditFeat(CadApp.feat_sel)
        }
        IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadApp.feat_sel), 9) ThenBlock: {
            CadAppReplay.ok = CA_LineEditFeat(CadApp.feat_sel)
        }
        IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadApp.feat_sel), 10) ThenBlock: {
            CadAppReplay.ok = CA_CircEditFeat(CadApp.feat_sel)
        }
        IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadApp.feat_sel), 11) ThenBlock: {
            CadAppReplay.ok = CA_RectEditFeat(CadApp.feat_sel)
        }
        IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadApp.feat_sel), 12) ThenBlock: {
            CadAppReplay.ok = CA_FilletEditFeat(CadApp.feat_sel)
        }
        IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadApp.feat_sel), 13) ThenBlock: {
            CadAppReplay.ok = CA_CstrEditFeat(CadApp.feat_sel)
        }
        IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadApp.feat_sel), 14) ThenBlock: {
            CadAppReplay.ok = CA_PointEditFeat(CadApp.feat_sel)
        }
        IfCondition NotEqual(CadAppReplay.ok, 0) ThenBlock: {
            CA_HudClose()
            ReturnValue(0)
        }
        CA_WriteDimHud()
        ReturnValue(0)
    }
}

// History chip. Scrub does not call this.
Function.CA_HistOpenHud {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.hist_kind, 0) ThenBlock: {
            CA_HudClose()
            ReturnValue(0)
        }
        CadAppReplay.fk = ArrayGet(CadApp.hist_kind, CadApp.hist_cur)
        IfCondition EqualTo(CadAppReplay.fk, 0) ThenBlock: {
            CA_HudClose()
            ReturnValue(0)
        }
        IfCondition EqualTo(CadAppReplay.fk, 6) ThenBlock: {
            CA_HudClose()
            ReturnValue(0)
        }
        IfCondition EqualTo(CadAppReplay.fk, 7) ThenBlock: {
            CA_HudClose()
            ReturnValue(0)
        }
        CadAppReplay.fi = 0
        IfCondition NotEqual(CadApp.hist_fi, 0) ThenBlock: {
            CadAppReplay.fi = ArrayGet(CadApp.hist_fi, CadApp.hist_cur)
        }
        IfCondition LessThan(CadAppReplay.fi, 1) ThenBlock: {
            CA_HistFeatFallback()
            CadAppReplay.fi = CadAppReplay.guard
        }
        IfCondition LessThan(CadAppReplay.fi, 1) ThenBlock: {
            CA_HudClose()
            ReturnValue(0)
        }
        CA_FeatOpenHud(Subtract(CadAppReplay.fi, 1))
        ReturnValue(0)
    }
}

Function.CA_HistFlushRepo {
    Input: rev_id: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(rev_id, 1) ThenBlock: { ReturnValue(-1) }
        i = 0
        WhileLoop LessThan(i, CadApp.hist_n) {
            CAD_Repo.InsertHist(rev_id, i, ArrayGet(CadApp.hist_kind, i))
            i = Add(i, 1)
        }
        hbuf = Allocate(1024)
        CA_WriteHist()
        fd = SystemCall(2, "/tmp/cad_app/hist.txt", 0, 0)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            n = SystemCall(0, fd, hbuf, 1023)
            SystemCall(3, fd, 0, 0)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                SetByte(hbuf, n, 0)
                CAD_Repo.PutAssetText(rev_id, "hist_log", "text/plain", hbuf)
            }
        }
        Deallocate(hbuf, 1024)
        ReturnValue(0)
    }
}

