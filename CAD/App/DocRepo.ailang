Function.CA_FormatFeatTree {
    Input: buf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(0) }
        pos = 0
        pos = CAD_Repo.AppendStr(buf, pos, "FT2 n=")
        pos = CAD_Repo.AppendInt(buf, pos, CadApp.feat_n)
        pos = CAD_Repo.AppendStr(buf, pos, "\n")
        CadAppRepo.i = 0
        WhileLoop LessThan(CadAppRepo.i, CadApp.feat_n) {
            fk = ArrayGet(CadApp.feat_kind, CadAppRepo.i)
            fs = ArrayGet(CadApp.feat_sk, CadAppRepo.i)
            ax = 0
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                ax = ArrayGet(CadApp.feat_aux, CadAppRepo.i)
            }
            IfCondition EqualTo(fk, 0) ThenBlock: {
                IfCondition NotEqual(CadApp.sk_list, 0) ThenBlock: {
                    IfCondition GreaterEqual(fs, 0) ThenBlock: {
                        IfCondition LessThan(fs, CadApp.sk_n) ThenBlock: {
                            hsk = ArrayGet(CadApp.sk_list, fs)
                            pl = CAD_Sketch.GetPlaneId(hsk)
                            IfCondition NotEqual(pl, 0) ThenBlock: {
                                ax = CAD_Plane.GetPid(pl)
                            }
                        }
                    }
                }
            }
            pos = CAD_Repo.AppendInt(buf, pos, fk)
            pos = CAD_Repo.AppendStr(buf, pos, " ")
            pos = CAD_Repo.AppendInt(buf, pos, fs)
            pos = CAD_Repo.AppendStr(buf, pos, " ")
            pos = CAD_Repo.AppendInt(buf, pos, ax)
            pos = CAD_Repo.AppendStr(buf, pos, "\n")
            CadAppRepo.i = Add(CadAppRepo.i, 1)
        }
        SetByte(buf, pos, 0)
        ReturnValue(pos)
    }
}

Function.CA_ParseFeatTree {
    Input: buf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: {
            CadApp.feat_kind = Allocate(1024)
            CadApp.feat_sk = Allocate(1024)
            CadApp.feat_aux = Allocate(1024)
        }
        IfCondition EqualTo(CadApp.feat_aux, 0) ThenBlock: { CadApp.feat_aux = Allocate(1024) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(0) }
        p = 0
        p = CAD_Plane.SkipSp(buf, p)
        // FT1 stored fillet aux as whole millimetres. FT2 stores micrometres.
        CadAppRepo.pass = 0
        IfCondition EqualTo(GetByte(buf, p), 70) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, Add(p, 2)), 49) ThenBlock: {
                CadAppRepo.pass = 1
            }
            skipped = 0
            WhileLoop EqualTo(skipped, 0) {
                ch = GetByte(buf, p)
                IfCondition EqualTo(ch, 0) ThenBlock: { skipped = 1 }
                IfCondition EqualTo(ch, 10) ThenBlock: {
                    p = Add(p, 1)
                    skipped = 1
                }
                IfCondition EqualTo(skipped, 0) ThenBlock: { p = Add(p, 1) }
            }
        }
        tmp = Allocate(16)
        CadApp.feat_n = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            IfCondition GreaterEqual(CadApp.feat_n, 128) ThenBlock: { done = 1 }
            IfCondition EqualTo(done, 0) ThenBlock: {
                p = CAD_Plane.SkipSp(buf, p)
                IfCondition EqualTo(GetByte(buf, p), 0) ThenBlock: { done = 1 }
            }
            IfCondition EqualTo(done, 0) ThenBlock: {
                ni = CAD_Plane.ParseDec(buf, p, tmp)
                IfCondition LessThan(ni, 0) ThenBlock: { done = 1 }
                IfCondition GreaterEqual(ni, 0) ThenBlock: {
                    fk = ArrayGet(tmp, 0)
                    p = ni
                    ni = CAD_Plane.ParseDec(buf, p, tmp)
                    IfCondition LessThan(ni, 0) ThenBlock: { done = 1 }
                    IfCondition GreaterEqual(ni, 0) ThenBlock: {
                        fs = ArrayGet(tmp, 0)
                        p = ni
                        ni = CAD_Plane.ParseDec(buf, p, tmp)
                        IfCondition LessThan(ni, 0) ThenBlock: { done = 1 }
                        IfCondition GreaterEqual(ni, 0) ThenBlock: {
                            ax = ArrayGet(tmp, 0)
                            p = ni
                            IfCondition EqualTo(fk, 4) ThenBlock: {
                                IfCondition EqualTo(CadAppRepo.pass, 1) ThenBlock: {
                                    IfCondition GreaterThan(ax, 0) ThenBlock: {
                                        ax = Multiply(ax, 1000)
                                    }
                                }
                            }
                            ArraySet(CadApp.feat_kind, CadApp.feat_n, fk)
                            ArraySet(CadApp.feat_sk, CadApp.feat_n, fs)
                            ArraySet(CadApp.feat_aux, CadApp.feat_n, ax)
                            IfCondition NotEqual(CadApp.feat_ord, 0) ThenBlock: {
                                ArraySet(CadApp.feat_ord, CadApp.feat_n, 0)
                            }
                            CadApp.feat_n = Add(CadApp.feat_n, 1)
                        }
                    }
                }
            }
        }
        Deallocate(tmp, 16)
        CadAppRepo.pass = 0
        CA_LogInt("cad_app: feat_tree n=", 21, CadApp.feat_n)
        ReturnValue(CadApp.feat_n)
    }
}

// 1 if the sketch has lines, circles, or arcs (empty pages must not be profile_dxf).
Function.CA_SketchHasGeom {
    Input: hsk: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(hsk, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(CAD_Store.Read(hsk, 0), 0) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterThan(CAD_Store.Read(hsk, 7), 0) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterThan(CAD_Store.Read(hsk, 10), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// SavePart writes CadApp.sketch as profile_dxf. Empty current page → load FAIL.
Function.CA_RepoPickSaveSketch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_SketchHasGeom(CadApp.sketch), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(CadApp.sk_list, 0) ThenBlock: { ReturnValue(0) }
        CadAppRepo.i = 0
        WhileLoop LessThan(CadAppRepo.i, CadApp.sk_n) {
            hsk = ArrayGet(CadApp.sk_list, CadAppRepo.i)
            IfCondition EqualTo(CA_SketchHasGeom(hsk), 1) ThenBlock: {
                CadApp.sketch = hsk
                ReturnValue(1)
            }
            CadAppRepo.i = Add(CadAppRepo.i, 1)
        }
        ReturnValue(0)
    }
}

Function.CA_RepoSaveSketches {
    Input: rid: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(rid, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(rid, 0) ThenBlock: {
            CAD_Repo_State.last_rev_id = rid
        }
        IfCondition EqualTo(CadApp.sk_list, 0) ThenBlock: { ReturnValue(0) }
        CadAppRepo.i = 0
        CadAppRepo.n = 0
        WhileLoop LessThan(CadAppRepo.i, CadApp.sk_n) {
            sl = CadApp.sk_list
            hsk = 0
            IfCondition NotEqual(sl, 0) ThenBlock: {
                hsk = ArrayGet(sl, CadAppRepo.i)
            }
            IfCondition NotEqual(hsk, 0) ThenBlock: {
                IfCondition EqualTo(CA_SketchHasGeom(hsk), 1) ThenBlock: {
                    CadApp.tmp_a = Allocate(40)
                    CadApp.tmp_b = Allocate(20)
                    rp = 0
                    rp = CAD_Repo.AppendStr(CadApp.tmp_b, rp, "sketch_")
                    rp = CAD_Repo.AppendInt(CadApp.tmp_b, rp, CadAppRepo.i)
                    SetByte(CadApp.tmp_b, rp, 0)
                    pp = 0
                    pp = CAD_Repo.AppendStr(CadApp.tmp_a, pp, "/tmp/cad_repo_sk")
                    pp = CAD_Repo.AppendInt(CadApp.tmp_a, pp, CadAppRepo.i)
                    pp = CAD_Repo.AppendStr(CadApp.tmp_a, pp, ".dxf")
                    SetByte(CadApp.tmp_a, pp, 0)
                    IfCondition EqualTo(CAD_DXF.ExportSketch(hsk, CadApp.tmp_a), 0) ThenBlock: {
                        rp = 0
                        rp = CAD_Repo.AppendStr(CadApp.tmp_b, rp, "sketch_")
                        rp = CAD_Repo.AppendInt(CadApp.tmp_b, rp, CadAppRepo.i)
                        SetByte(CadApp.tmp_b, rp, 0)
                        slot = Allocate(16)
                        n_dxf = CAD_Repo.ReadFileAll(CadApp.tmp_a, slot, 262144)
                        IfCondition GreaterThan(n_dxf, 0) ThenBlock: {
                            dxf_buf = ArrayGet(slot, 0)
                            CAD_Repo.PutAssetText(CAD_Repo_State.last_rev_id, CadApp.tmp_b, "application/dxf", dxf_buf)
                            Deallocate(dxf_buf, 262144)
                            CadAppRepo.n = Add(CadAppRepo.n, 1)
                        }
                        Deallocate(slot, 16)
                    }
                    Deallocate(CadApp.tmp_a, 40)
                    Deallocate(CadApp.tmp_b, 20)
                    CadApp.tmp_a = 0
                    CadApp.tmp_b = 0
                }
            }
            CadAppRepo.i = Add(CadAppRepo.i, 1)
        }
        CA_LogInt("cad_app: saved sketches=", 24, CadAppRepo.n)
        ReturnValue(CadAppRepo.n)
    }
}

Function.CA_RepoLoadSketches {
    Output: Integer
    Body: {
        CadAppRepo.i = 0
        CadAppRepo.n = 0
        WhileLoop LessThan(CadAppRepo.i, 64) {
            CadApp.tmp_a = Allocate(40)
            CadApp.tmp_b = Allocate(20)
            rp = 0
            rp = CAD_Repo.AppendStr(CadApp.tmp_b, rp, "sketch_")
            rp = CAD_Repo.AppendInt(CadApp.tmp_b, rp, CadAppRepo.i)
            SetByte(CadApp.tmp_b, rp, 0)
            pp = 0
            pp = CAD_Repo.AppendStr(CadApp.tmp_a, pp, "/tmp/cad_repo_sk")
            pp = CAD_Repo.AppendInt(CadApp.tmp_a, pp, CadAppRepo.i)
            pp = CAD_Repo.AppendStr(CadApp.tmp_a, pp, ".dxf")
            SetByte(CadApp.tmp_a, pp, 0)
            rc = CAD_Repo.FetchAssetToFile(CadApp.part_name, 0, CadApp.tmp_b, CadApp.tmp_a)
            IfCondition EqualTo(rc, 0) ThenBlock: {
                slot = Allocate(16)
                ArraySet(slot, 0, 0)
                irc = CAD_DXF.ImportFile(CadApp.tmp_a, slot)
                hsk = ArrayGet(slot, 0)
                Deallocate(slot, 16)
                IfCondition EqualTo(irc, 0) ThenBlock: {
                    IfCondition NotEqual(hsk, 0) ThenBlock: {
                        IfCondition EqualTo(CadAppRepo.i, 0) ThenBlock: {
                            CadApp.sketch = hsk
                            IfCondition EqualTo(CadApp.sk_list, 0) ThenBlock: {
                                CA_SketchAttach(hsk)
                            }
                            IfCondition NotEqual(CadApp.sk_list, 0) ThenBlock: {
                                ArraySet(CadApp.sk_list, 0, hsk)
                            }
                            IfCondition EqualTo(CadApp.sk_n, 0) ThenBlock: {
                                CA_SketchAttach(hsk)
                            }
                        }
                        IfCondition GreaterThan(CadAppRepo.i, 0) ThenBlock: {
                            CA_SketchAttach(hsk)
                        }
                        CadAppRepo.n = Add(CadAppRepo.n, 1)
                    }
                }
            }
            Deallocate(CadApp.tmp_a, 40)
            Deallocate(CadApp.tmp_b, 20)
            CadApp.tmp_a = 0
            CadApp.tmp_b = 0
            CadAppRepo.i = Add(CadAppRepo.i, 1)
        }
        CA_LogInt("cad_app: loaded sketches=", 25, CadAppRepo.n)
        ReturnValue(CadAppRepo.n)
    }
}

// Rebuild one pad or cut onto CadApp.solid. fk 3 skips the snap that
// lifts an on-face tool, and clamps a too-deep cut onto the far face.
Function.CA_ReplayApplyPad {
    Output: Integer
    Body: {
        CadAppReplay.ok = 0
        IfCondition EqualTo(CadApp.sk_list, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CadAppReplay.fs, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(CadAppReplay.fs, CadApp.sk_n) ThenBlock: { ReturnValue(0) }
        CadApp.sketch = ArrayGet(CadApp.sk_list, CadAppReplay.fs)
        IfCondition EqualTo(CadAppReplay.snap, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.hist_sk, 0) ThenBlock: {
                IfCondition GreaterEqual(CadAppReplay.hs, 0) ThenBlock: {
                    IfCondition LessThan(CadAppReplay.hs, CadApp.hist_n) ThenBlock: {
                        CadAppReplay.e = ArrayGet(CadApp.hist_sk, CadAppReplay.hs)
                        IfCondition NotEqual(CadAppReplay.e, 0) ThenBlock: {
                            IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                                CA_SketchCopy(CadAppReplay.e, CadApp.sketch)
                                CAD_Sketch.RebuildAnchors(CadApp.sketch)
                            }
                        }
                    }
                }
            }
        }
        CA_BindSketchPlane()
        CadAppReplay.fk = ArrayGet(CadApp.feat_kind, CadAppReplay.fi)
        CadAppReplay.aux = 0
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            CadAppReplay.aux = ArrayGet(CadApp.feat_aux, CadAppReplay.fi)
        }
        IfCondition LessThan(CadAppReplay.aux, 1) ThenBlock: {
            IfCondition GreaterThan(CadAppReplay.aux, Subtract(0, 1)) ThenBlock: {
                CadAppReplay.aux = 10
            }
        }
        CadApp.height = CadAppReplay.aux
        // Stored sign is the arrow direction. Kind 3 is still the cut.
        CadAppReplay.hh = Float_FromInt(CadAppReplay.aux)
        CadApp.extrude_op = 0
        IfCondition EqualTo(CadAppReplay.fk, 3) ThenBlock: { CadApp.extrude_op = 1 }
        CadAppReplay.pln = CAD_Sketch.GetPlaneId(CadApp.sketch)
        IfCondition EqualTo(CadAppReplay.pln, 0) ThenBlock: { CadAppReplay.pln = CadApp.plane }
        CadAppReplay.cut = CadApp.solid
        // Drop the last picked loop. It is still the hole's 32-gon, and a
        // plex miss would extrude that circle as the pad.
        CadAppPick.prof_nn = 0
        CA_RebuildProfiles()
        // ois is a profile bitmask (bit 0 = profile 0). 0 means empty
        // and falls back to profile 0. The first sweep is the lowest bit.
        CadAppPad.msk = 0
        CadAppReplay.bj = 0
        IfCondition NotEqual(CadAppPad.ois, 0) ThenBlock: {
            IfCondition GreaterEqual(CadAppReplay.fi, 0) ThenBlock: {
                IfCondition LessThan(CadAppReplay.fi, CadApp.feat_n) ThenBlock: {
                    CadAppPad.msk = ArrayGet(CadAppPad.ois, CadAppReplay.fi)
                }
            }
        }
        IfCondition NotEqual(CadAppPad.msk, 0) ThenBlock: {
            CadAppPad.k = 0
            WhileLoop LessThan(CadAppPad.k, 32) {
                bit = LeftShift(1, CadAppPad.k)
                IfCondition NotEqual(BitwiseAnd(CadAppPad.msk, bit), 0) ThenBlock: {
                    CadAppReplay.bj = CadAppPad.k
                    CadAppPad.k = 32
                }
                IfCondition LessThan(CadAppPad.k, 32) ThenBlock: {
                    CadAppPad.k = Add(CadAppPad.k, 1)
                }
            }
        }
        IfCondition LessThan(CadAppReplay.bj, 0) ThenBlock: { CadAppReplay.bj = 0 }
        // .n is CA_ReplayTo's solid count for the whole walk. A profile
        // count stored there stopped the walk after the pad, so the cut
        // never swept.
        CadAppReplay.ne = CAD_Store.Read(CadApp.sketch, 12)
        IfCondition GreaterThan(CadAppReplay.ne, 0) ThenBlock: {
            IfCondition GreaterEqual(CadAppReplay.bj, CadAppReplay.ne) ThenBlock: {
                CadAppReplay.bj = 0
                CadAppPad.msk = 1
            }
        }
        IfCondition EqualTo(CadAppReplay.ne, 0) ThenBlock: {
            CadAppReplay.bj = 0
            CadAppPad.msk = 0
        }
        CadAppPad.pi = CadAppReplay.bj
        CadAppPad.pln = CadAppReplay.pln
        CAD_Topo.SweepReset()
        CAD_Topo_Sweep.hz = CadAppReplay.hh
        CA_SweepFromSketch(CadAppReplay.bj)
        CadAppReplay.fk = ArrayGet(CadApp.feat_kind, CadAppReplay.fi)
        CadApp.extrude_op = 0
        IfCondition EqualTo(CadAppReplay.fk, 3) ThenBlock: { CadApp.extrude_op = 1 }
        CAD_Topo_Sweep.hz = CadAppReplay.hh
        IfCondition EqualTo(CadAppReplay.fk, 3) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                IfCondition NotEqual(CadAppReplay.pln, 0) ThenBlock: {
                    CadAppReplay.fr = Allocate(128)
                    IfCondition NotEqual(CadAppReplay.fr, 0) ThenBlock: {
                        CadAppReplay.guard = CAD_Plane.EvalFrame(CadAppReplay.pln, CadAppReplay.fr)
                        IfCondition EqualTo(CadAppReplay.guard, 0) ThenBlock: {
                            CAD_Bool_Punch.ox = ArrayGet(CadAppReplay.fr, 0)
                            CAD_Bool_Punch.oy = ArrayGet(CadAppReplay.fr, 1)
                            CAD_Bool_Punch.oz = ArrayGet(CadAppReplay.fr, 2)
                            CAD_Bool_Punch.nx = ArrayGet(CadAppReplay.fr, 9)
                            CAD_Bool_Punch.ny = ArrayGet(CadAppReplay.fr, 10)
                            CAD_Bool_Punch.nz = ArrayGet(CadAppReplay.fr, 11)
                            CadAppReplay.guard = CAD_Bool.SolidSpan(CadApp.solid)
                            IfCondition GreaterThan(CadAppReplay.guard, 0) ThenBlock: {
                                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_Sweep.hz), 1) ThenBlock: {
                                    IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Punch.span_min), 1) ThenBlock: {
                                        IfCondition EqualTo(CAD_Num.Le(CAD_Topo_Sweep.hz, CAD_Bool_Punch.span_min), 1) ThenBlock: {
                                            CAD_Topo_Sweep.hz = CAD_Bool_Punch.span_min
                                        }
                                    }
                                }
                            }
                        }
                        Deallocate(CadAppReplay.fr, 128)
                    }
                }
            }
        }
        CadAppPad.hg = CAD_Topo_Sweep.hz
        CadAppReplay.tool = 0
        IfCondition GreaterThan(CAD_Topo_Sweep.ncont, 0) ThenBlock: {
            CadAppReplay.tool = CAD_Topo.ExtrudeContours()
        }
        IfCondition EqualTo(CadAppReplay.tool, 0) ThenBlock: {
            CadAppReplay.e = CAD_Sketch.CreateSketch(1)
            IfCondition NotEqual(CadAppReplay.e, 0) ThenBlock: {
                CA_CopySketchGeom(CadApp.sketch, CadAppReplay.e)
                CadAppReplay.tool = CAD_Feat.ExtrudeOnPlane(CadAppReplay.e, CadAppReplay.hh, CadAppReplay.pln)
            }
        }
        IfCondition EqualTo(CadAppReplay.tool, 0) ThenBlock: {
            CA_LogInt("cad_app: replay pad FAIL i=", 27, CadAppReplay.fi)
            ReturnValue(0)
        }
        // Same island bodies the live pad keeps. Replay was dropping them.
        CadAppReplay.tool = CA_ExtrudeSavedIslands(CadAppReplay.tool)
        IfCondition EqualTo(CadAppReplay.tool, 0) ThenBlock: {
            CA_LogInt("cad_app: replay pad FAIL i=", 27, CadAppReplay.fi)
            ReturnValue(0)
        }
        IfCondition NotEqual(CadAppReplay.pln, 0) ThenBlock: {
            CadAppReplay.fr = Allocate(128)
            IfCondition NotEqual(CadAppReplay.fr, 0) ThenBlock: {
                CAD_Plane.EvalFrame(CadAppReplay.pln, CadAppReplay.fr)
                CAD_Topo.MapSolidByFrame(CadAppReplay.tool, CadAppReplay.fr)
                CadAppReplay.guard = 0
                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_Sweep.hz), 1) ThenBlock: {
                    IfCondition NotEqual(CadAppReplay.cut, 0) ThenBlock: { CadAppReplay.guard = 1 }
                }
                IfCondition EqualTo(CadAppReplay.guard, 0) ThenBlock: {
                    CAD_Topo.SnapSolidToFrame(CadAppReplay.tool, CadAppReplay.fr)
                }
                Deallocate(CadAppReplay.fr, 128)
            }
            CAD_Topo.RebuildKind0Planes(CadAppReplay.tool)
        }
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CadApp.solid = CadAppReplay.tool
            CadAppPad.ok = CadApp.solid
            CA_PadBooleanOthers()
            CadAppReplay.ok = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.solid, CadAppReplay.tool) ThenBlock: {
            CadAppReplay.ok = 1
            ReturnValue(1)
        }
        CadAppReplay.fk = ArrayGet(CadApp.feat_kind, CadAppReplay.fi)
        IfCondition EqualTo(CadAppReplay.fk, 3) ThenBlock: {
            CadAppReplay.guard = CAD_Bool.Difference(CadApp.solid, CadAppReplay.tool)
            CadAppPad.ok = 0
            IfCondition GreaterThan(CadAppReplay.guard, 0) ThenBlock: {
                CadApp.solid = CadAppReplay.guard
                CadAppPad.ok = CadAppReplay.guard
            }
            CA_PadBooleanOthers()
            IfCondition EqualTo(CadAppPad.any, 0) ThenBlock: {
                CA_LogInt("cad_app: replay cut miss i=", 27, CadAppReplay.fi)
                ReturnValue(0)
            }
            CAD_Topo.RebuildKind0Planes(CadApp.solid)
            CadAppReplay.ok = 1
            ReturnValue(1)
        }
        CAD_Topo.RebuildKind0Planes(CadApp.solid)
        CAD_Topo.RebuildKind0Planes(CadAppReplay.tool)
        CadAppReplay.guard = CAD_Bool.GlueOnFace(CadApp.solid, CadAppReplay.tool)
        IfCondition GreaterThan(CadAppReplay.guard, 0) ThenBlock: {
            CadApp.solid = CadAppReplay.guard
            CadAppPad.ok = CadAppReplay.guard
            CA_PadBooleanOthers()
            CadAppReplay.ok = 1
            ReturnValue(1)
        }
        CadApp.solid = CAD_Topo.CompoundAdd(CadApp.solid, CadAppReplay.tool)
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(0) }
        CadAppPad.ok = CadApp.solid
        CA_PadBooleanOthers()
        CadAppReplay.ok = 1
        ReturnValue(1)
    }
}

// Match stored midpoints to the rebuilt solid. All of them, or none.
Function.CA_ReplayPickEdges {
    Output: Integer
    Body: {
        CadAppReplay.hh = 0
        IfCondition NotEqual(CadApp.feat_en, 0) ThenBlock: {
            CadAppReplay.hh = ArrayGet(CadApp.feat_en, CadAppReplay.fi)
        }
        IfCondition LessThan(CadAppReplay.hh, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(CadAppReplay.hh, 64) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.feat_ex, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadAppReplay.eds, 0) ThenBlock: { CadAppReplay.eds = Allocate(2048) }
        IfCondition EqualTo(CadAppReplay.buf, 0) ThenBlock: { CadAppReplay.buf = Allocate(512) }
        IfCondition EqualTo(CadAppReplay.used, 0) ThenBlock: { CadAppReplay.used = Allocate(2048) }
        IfCondition EqualTo(CadAppReplay.eds, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadAppReplay.buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadAppReplay.used, 0) ThenBlock: { ReturnValue(0) }
        CadAppReplay.i = 0
        WhileLoop LessThan(CadAppReplay.i, 256) {
            ArraySet(CadAppReplay.used, CadAppReplay.i, 0)
            CadAppReplay.i = Add(CadAppReplay.i, 1)
        }
        CadAppReplay.ne = CAD_Topo.SolidCollectEdges(CadApp.solid, CadAppReplay.eds, 256)
        IfCondition LessThan(CadAppReplay.ne, 1) ThenBlock: { ReturnValue(0) }
        CadAppReplay.tool = Multiply(CadAppReplay.fi, 64)
        CadAppReplay.i = 0
        WhileLoop LessThan(CadAppReplay.i, CadAppReplay.hh) {
            CadAppReplay.tx = ArrayGet(CadApp.feat_ex, Add(CadAppReplay.tool, CadAppReplay.i))
            CadAppReplay.ty = ArrayGet(CadApp.feat_ey, Add(CadAppReplay.tool, CadAppReplay.i))
            CadAppReplay.tz = ArrayGet(CadApp.feat_ez, Add(CadAppReplay.tool, CadAppReplay.i))
            CadAppReplay.best = 0
            CadAppReplay.best_d = 0x412E848000000000
            CadAppReplay.bj = 0
            CadAppReplay.fs = 0
            WhileLoop LessThan(CadAppReplay.fs, CadAppReplay.ne) {
                CadAppReplay.guard = ArrayGet(CadAppReplay.used, CadAppReplay.fs)
                IfCondition EqualTo(CadAppReplay.guard, 0) ThenBlock: {
                    CadAppReplay.guard = ArrayGet(CadAppReplay.eds, CadAppReplay.fs)
                    CadAppReplay.ok = CA_EdgeMid(CadAppReplay.guard)
                    IfCondition NotEqual(CadAppReplay.ok, 0) ThenBlock: {
                        CadAppReplay.ax = Float_Sub(CadAppReplay.mx, CadAppReplay.tx)
                        CadAppReplay.ay = Float_Sub(CadAppReplay.my, CadAppReplay.ty)
                        CadAppReplay.az = Float_Sub(CadAppReplay.mz, CadAppReplay.tz)
                        CadAppReplay.d2 = CAD_Num.Sq(CadAppReplay.ax)
                        CadAppReplay.d2 = Float_Add(CadAppReplay.d2, CAD_Num.Sq(CadAppReplay.ay))
                        CadAppReplay.d2 = Float_Add(CadAppReplay.d2, CAD_Num.Sq(CadAppReplay.az))
                        IfCondition EqualTo(CAD_Num.Le(CadAppReplay.d2, 0x3FD0000000000000), 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.Le(CadAppReplay.d2, CadAppReplay.best_d), 1) ThenBlock: {
                                CadAppReplay.best = CadAppReplay.guard
                                CadAppReplay.best_d = CadAppReplay.d2
                                CadAppReplay.bj = CadAppReplay.fs
                            }
                        }
                    }
                }
                CadAppReplay.fs = Add(CadAppReplay.fs, 1)
            }
            IfCondition EqualTo(CadAppReplay.best, 0) ThenBlock: { ReturnValue(0) }
            ArraySet(CadAppReplay.buf, CadAppReplay.i, CadAppReplay.best)
            ArraySet(CadAppReplay.used, CadAppReplay.bj, 1)
            CadAppReplay.i = Add(CadAppReplay.i, 1)
        }
        ReturnValue(1)
    }
}

Function.CA_ReplayApplyBlend {
    Output: Integer
    Body: {
        CadAppReplay.ok = 0
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CA_ReplayPickEdges(), 0) ThenBlock: {
            IfCondition EqualTo(CadAppReplay.fk, 4) ThenBlock: {
                CA_LogInt("cad_app: replay skip fillet i=", 30, CadAppReplay.fi)
            }
            IfCondition EqualTo(CadAppReplay.fk, 5) ThenBlock: {
                CA_LogInt("cad_app: replay skip chamfer i=", 31, CadAppReplay.fi)
            }
            CadAppReplay.ok = 0
            ReturnValue(0)
        }
        IfCondition LessThan(CadAppReplay.aux, 1) ThenBlock: {
            CA_LogInt("cad_app: replay skip fillet i=", 30, CadAppReplay.fi)
            CadAppReplay.ok = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(CadAppReplay.fk, 4) ThenBlock: {
            CadAppReplay.rmm = CA_FilletUmToMm(CadAppReplay.aux)
            CadAppReplay.guard = CAD_Topo.FilletPlaneEdges(CadApp.solid, CadAppReplay.buf, CadAppReplay.hh, CadAppReplay.rmm)
            IfCondition EqualTo(CadAppReplay.guard, 0) ThenBlock: {
                CA_LogInt("cad_app: replay skip fillet i=", 30, CadAppReplay.fi)
                CadAppReplay.ok = 0
                ReturnValue(0)
            }
            CadApp.solid = CadAppReplay.guard
            CadAppReplay.ok = 1
            ReturnValue(1)
        }
        CadAppReplay.rmm = Float_FromInt(CadAppReplay.aux)
        CadAppReplay.pln = CadApp.chamfer_a
        IfCondition LessThan(CadAppReplay.pln, 1) ThenBlock: { CadAppReplay.pln = 45 }
        IfCondition GreaterThan(CadAppReplay.pln, 89) ThenBlock: { CadAppReplay.pln = 89 }
        CAD_Topo.FilletCompile(CadApp.solid, CadAppReplay.buf, CadAppReplay.hh, CadAppReplay.rmm)
        CadAppReplay.guard = CAD_Topo.ChamferEmitChain(CadApp.solid, CadAppReplay.rmm, CadAppReplay.pln)
        IfCondition EqualTo(CadAppReplay.guard, 0) ThenBlock: {
            CA_LogInt("cad_app: replay skip chamfer i=", 31, CadAppReplay.fi)
            CadAppReplay.ok = 0
            ReturnValue(0)
        }
        CadApp.solid = CadAppReplay.guard
        CadAppReplay.ok = 1
        ReturnValue(1)
    }
}

Function.CA_ReplayApplyFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        CadAppReplay.fi = feat_i
        CadAppReplay.ok = 0
        CadAppReplay.fk = ArrayGet(CadApp.feat_kind, CadAppReplay.fi)
        CadAppReplay.fs = ArrayGet(CadApp.feat_sk, CadAppReplay.fi)
        CadAppReplay.aux = 0
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            CadAppReplay.aux = ArrayGet(CadApp.feat_aux, CadAppReplay.fi)
        }
        IfCondition EqualTo(CadAppReplay.fk, 2) ThenBlock: {
            CA_LogInt("cad_app: replay skip revolve i=", 31, CadAppReplay.fi)
            ReturnValue(0)
        }
        IfCondition EqualTo(CadAppReplay.fk, 1) ThenBlock: {
            ReturnValue(CA_ReplayApplyPad())
        }
        IfCondition EqualTo(CadAppReplay.fk, 3) ThenBlock: {
            ReturnValue(CA_ReplayApplyPad())
        }
        IfCondition EqualTo(CadAppReplay.fk, 4) ThenBlock: {
            ReturnValue(CA_ReplayApplyBlend())
        }
        IfCondition EqualTo(CadAppReplay.fk, 5) ThenBlock: {
            ReturnValue(CA_ReplayApplyBlend())
        }
        ReturnValue(0)
    }
}

// Rebuild solid features that belong at or before this history step.
// Hist index of solid number CadAppReplay.got (0-based) at or before hi.
Function.CA_ReplayHistStep {
    Output: Integer
    Body: {
        CadAppReplay.hs = 0
        CadAppReplay.e = 0
        CadAppReplay.i = 0
        WhileLoop LessThan(CadAppReplay.i, CadApp.hist_n) {
            IfCondition LessEqual(CadAppReplay.i, CadAppReplay.hi) ThenBlock: {
                CadAppReplay.fk = ArrayGet(CadApp.hist_kind, CadAppReplay.i)
                CadAppReplay.guard = 0
                IfCondition GreaterEqual(CadAppReplay.fk, 1) ThenBlock: {
                    IfCondition LessEqual(CadAppReplay.fk, 5) ThenBlock: {
                        CadAppReplay.guard = 1
                    }
                }
                IfCondition EqualTo(CadAppReplay.guard, 1) ThenBlock: {
                    IfCondition EqualTo(CadAppReplay.e, CadAppReplay.got) ThenBlock: {
                        CadAppReplay.hs = CadAppReplay.i
                    }
                    CadAppReplay.e = Add(CadAppReplay.e, 1)
                }
            }
            CadAppReplay.i = Add(CadAppReplay.i, 1)
        }
        ReturnValue(CadAppReplay.hs)
    }
}

// Feature for one solid history step. hist_fi is 1-based.
// 0 falls back to the ordinal-th solid feature (pad, then cut).
Function.CA_ReplayFeatForStep {
    Input: hist_i: Integer
    Input: ordinal: Integer
    Output: Integer
    Body: {
        CadAppReplay.guard = ordinal
        CadAppReplay.bx = hist_i
        CadAppReplay.tool = 0
        IfCondition NotEqual(CadApp.hist_fi, 0) ThenBlock: {
            CadAppReplay.tool = ArrayGet(CadApp.hist_fi, CadAppReplay.bx)
        }
        IfCondition GreaterEqual(CadAppReplay.tool, 1) ThenBlock: {
            IfCondition LessEqual(CadAppReplay.tool, CadApp.feat_n) ThenBlock: {
                CadAppReplay.fk = ArrayGet(CadApp.feat_kind, Subtract(CadAppReplay.tool, 1))
                IfCondition EqualTo(CadAppReplay.fk, ArrayGet(CadApp.hist_kind, CadAppReplay.bx)) ThenBlock: {
                    ReturnValue(Subtract(CadAppReplay.tool, 1))
                }
            }
        }
        CadAppReplay.tool = 0
        CadAppReplay.i = 0
        WhileLoop LessThan(CadAppReplay.i, CadApp.feat_n) {
            CadAppReplay.fk = ArrayGet(CadApp.feat_kind, CadAppReplay.i)
            CadAppReplay.e = 0
            IfCondition GreaterEqual(CadAppReplay.fk, 1) ThenBlock: {
                IfCondition LessEqual(CadAppReplay.fk, 5) ThenBlock: {
                    CadAppReplay.e = 1
                }
            }
            IfCondition EqualTo(CadAppReplay.e, 1) ThenBlock: {
                IfCondition EqualTo(CadAppReplay.tool, CadAppReplay.guard) ThenBlock: {
                    ReturnValue(CadAppReplay.i)
                }
                CadAppReplay.tool = Add(CadAppReplay.tool, 1)
            }
            CadAppReplay.i = Add(CadAppReplay.i, 1)
        }
        ReturnValue(-1)
    }
}

// Does not push history and does not drop the redo tail.
// ski becomes 1 when the selected feature actually applied.
// .hs is the history index, .got the solid ordinal, .hi the limit.
// ApplyPad does not write them. An Allocate(64) cursor was reused by
// profile rebuild and the step index was cleared after the pad.
Function.CA_ReplayTo {
    Input: idx: Integer
    Output: Integer
    Body: {
        CadAppReplay.hi = idx
        CadAppReplay.ski = 0
        CadApp.solid = 0
        CadAppReplay.n = 0
        CadAppReplay.i = 0
        WhileLoop LessEqual(CadAppReplay.i, CadAppReplay.hi) {
            IfCondition LessThan(CadAppReplay.i, CadApp.hist_n) ThenBlock: {
                CadAppReplay.fk = ArrayGet(CadApp.hist_kind, CadAppReplay.i)
                IfCondition GreaterEqual(CadAppReplay.fk, 1) ThenBlock: {
                    IfCondition LessEqual(CadAppReplay.fk, 5) ThenBlock: {
                        CadAppReplay.n = Add(CadAppReplay.n, 1)
                    }
                }
            }
            CadAppReplay.i = Add(CadAppReplay.i, 1)
        }
        CA_LogInt("cad_app: replay solid n=", 24, CadAppReplay.n)
        CadAppReplay.hs = 0
        CadAppReplay.got = 0
        WhileLoop LessEqual(CadAppReplay.hs, CadAppReplay.hi) {
            CadAppReplay.e = 0
            IfCondition LessThan(CadAppReplay.hs, CadApp.hist_n) ThenBlock: {
                CadAppReplay.e = 1
            }
            IfCondition EqualTo(CadAppReplay.e, 0) ThenBlock: {
                CadAppReplay.hs = Add(CadAppReplay.hi, 1)
            }
            IfCondition EqualTo(CadAppReplay.e, 1) ThenBlock: {
                CadAppReplay.fk = ArrayGet(CadApp.hist_kind, CadAppReplay.hs)
                CadAppReplay.e = 0
                IfCondition GreaterEqual(CadAppReplay.fk, 1) ThenBlock: {
                    IfCondition LessEqual(CadAppReplay.fk, 5) ThenBlock: {
                        CadAppReplay.e = 1
                    }
                }
                IfCondition EqualTo(CadAppReplay.e, 1) ThenBlock: {
                    CadAppReplay.fi = CA_ReplayFeatForStep(CadAppReplay.hs, CadAppReplay.got)
                    IfCondition GreaterEqual(CadAppReplay.fi, 0) ThenBlock: {
                        CA_ReplayApplyFeat(CadAppReplay.fi)
                        IfCondition EqualTo(CadAppReplay.fi, CadApp.feat_sel) ThenBlock: {
                            IfCondition EqualTo(CadAppReplay.ok, 1) ThenBlock: {
                                CadAppReplay.ski = 1
                            }
                        }
                    }
                    CadAppReplay.got = Add(CadAppReplay.got, 1)
                }
                CadAppReplay.hs = Add(CadAppReplay.hs, 1)
            }
        }
        ReturnValue(CadApp.solid)
    }
}

Function.CA_RepoReplayFeats {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.feat_n, 1) ThenBlock: { ReturnValue(-1) }
        CadApp.replay = 1
        CadApp.solid = 0
        CadApp.pad_edit = 1
        CadApp.auto_pad = 0
        CadApp.hole_sk = 0
        CadApp.hist_n = 0
        CadApp.hist_cur = 0
        CadAppRepo.feat_i = 0
        CadAppRepo.n = 0
        WhileLoop LessThan(CadAppRepo.feat_i, CadApp.feat_n) {
            fk = ArrayGet(CadApp.feat_kind, CadAppRepo.feat_i)
            fs = ArrayGet(CadApp.feat_sk, CadAppRepo.feat_i)
            ax = 0
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                ax = ArrayGet(CadApp.feat_aux, CadAppRepo.feat_i)
            }
            IfCondition EqualTo(fk, 0) ThenBlock: {
                IfCondition NotEqual(CadApp.sk_list, 0) ThenBlock: {
                    IfCondition GreaterEqual(fs, 0) ThenBlock: {
                        IfCondition LessThan(fs, CadApp.sk_n) ThenBlock: {
                            hsk = ArrayGet(CadApp.sk_list, fs)
                            IfCondition NotEqual(ax, 0) ThenBlock: {
                                pl = CA_PlaneByPid(ax)
                                IfCondition NotEqual(pl, 0) ThenBlock: {
                                    CAD_Sketch.SetPlaneId(hsk, pl)
                                }
                            }
                        }
                    }
                }
            }
            CadAppReplay.fk = ArrayGet(CadApp.feat_kind, CadAppRepo.feat_i)
            CadAppReplay.guard = 0
            IfCondition GreaterEqual(CadAppReplay.fk, 1) ThenBlock: {
                IfCondition LessEqual(CadAppReplay.fk, 5) ThenBlock: {
                    CadAppReplay.guard = 1
                }
            }
            IfCondition EqualTo(CadAppReplay.guard, 1) ThenBlock: {
                CA_ReplayApplyFeat(CadAppRepo.feat_i)
                CadAppReplay.fk = ArrayGet(CadApp.feat_kind, CadAppRepo.feat_i)
                IfCondition EqualTo(CadAppReplay.fk, 1) ThenBlock: {
                    IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                        CA_HistPush(1)
                    }
                }
                IfCondition EqualTo(CadAppReplay.fk, 3) ThenBlock: {
                    IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                        CA_HistPush(3)
                    }
                }
                IfCondition EqualTo(CadAppReplay.fk, 2) ThenBlock: { CA_HistPush(2) }
                IfCondition EqualTo(CadAppReplay.fk, 4) ThenBlock: { CA_HistPush(4) }
                IfCondition EqualTo(CadAppReplay.fk, 5) ThenBlock: { CA_HistPush(5) }
                IfCondition EqualTo(CadAppReplay.ok, 1) ThenBlock: {
                    IfCondition EqualTo(CadAppReplay.fk, 1) ThenBlock: {
                        CadAppRepo.n = Add(CadAppRepo.n, 1)
                    }
                    IfCondition EqualTo(CadAppReplay.fk, 3) ThenBlock: {
                        CadAppRepo.n = Add(CadAppRepo.n, 1)
                    }
                }
            }
            CadAppRepo.feat_i = Add(CadAppRepo.feat_i, 1)
        }
        CadApp.pad_edit = 0
        CadApp.auto_pad = 0
        CadApp.replay = 0
        CadApp.prof_user = 0
        CadApp.dirty = 0
        CA_LogInt("cad_app: replay pads=", 21, CadAppRepo.n)
        ReturnValue(CadAppRepo.n)
    }
}

// Save current sketch+solid+hole to Postgres under CadApp.part_name.
Function.CA_RepoSave {
    Output: Integer
    Body: {
        CA_Log("cad_app: save enter\n", 20)
        ens = CA_RepoEnsure()
        CA_LogInt("cad_app: save ensure=", 21, ens)
        IfCondition EqualTo(CadApp.repo_ok, 0) ThenBlock: {
            CA_Log("cad_app: save needs PG\n", 23)
            ReturnValue(-1)
        }
        CA_EnsureName()
        CA_Log("cad_app: save name ok\n", 22)
        CA_RepoPickSaveSketch()
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: save needs sketch\n", 27)
            ReturnValue(-3)
        }
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CadApp.auto_pad = 1
            rc = CA_BuildSolid()
            CadApp.auto_pad = 0
            IfCondition NotEqual(rc, 0) ThenBlock: {
                CA_Log("cad_app: save needs a solid or closed profile\n", 46)
                ReturnValue(-3)
            }
        }
        // Prefer the last pad feature's HUD height if it was typed.
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            pi = Subtract(CadApp.feat_n, 1)
            WhileLoop GreaterEqual(pi, 0) {
                IfCondition EqualTo(ArrayGet(CadApp.feat_kind, pi), 1) ThenBlock: {
                    ha = ArrayGet(CadApp.feat_aux, pi)
                    IfCondition GreaterThan(ha, 0) ThenBlock: {
                        CadApp.height = ha
                        pi = 0
                    }
                }
                pi = Subtract(pi, 1)
            }
        }
        IfCondition LessThan(CadApp.height, 1) ThenBlock: { CadApp.height = 10 }
        IfCondition LessThan(CadApp.rev_deg, 1) ThenBlock: { CadApp.rev_deg = 360 }
        CAD_Repo_State.save_kind = CadApp.doc_kind
        CAD_Repo_State.save_rev_deg = CadApp.rev_deg
        CA_LogInt("cad_app: save H=", 16, CadApp.height)
        CA_Log("cad_app: save SavePart\n", 23)
        CA_SetPartName(CadApp.name_buf)
        IfCondition EqualTo(CAD_Repo.IsSafeName(CadApp.part_name), 0) ThenBlock: {
            CA_Log("cad_app: save name not safe\n", 28)
            ReturnValue(-3)
        }
        rc = CAD_Repo.SavePart(CadApp.part_name, CadApp.sketch, CadApp.solid, CadApp.height, CadApp.hole_sk)
        CA_LogInt("cad_app: save SavePart rc=", 26, rc)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: repo save FAIL\n", 24)
            ReturnValue(rc)
        }
        rid = CAD_Repo_State.last_rev_id
        IfCondition GreaterThan(rid, 0) ThenBlock: {
            tbuf = Allocate(8192)
            nt = CA_FormatPlaneTree(tbuf)
            IfCondition GreaterThan(nt, 0) ThenBlock: {
                CAD_Repo.PutAssetText(rid, "plane_tree", "application/json", tbuf)
            }
            Deallocate(tbuf, 8192)
            fbuf = Allocate(4096)
            nf = CA_FormatFaceMap(fbuf)
            IfCondition GreaterThan(nf, 0) ThenBlock: {
                CAD_Repo.PutAssetText(rid, "face_map", "application/json", fbuf)
            }
            Deallocate(fbuf, 4096)
            ftb = Allocate(4096)
            nft = CA_FormatFeatTree(ftb)
            IfCondition GreaterThan(nft, 0) ThenBlock: {
                CAD_Repo.PutAssetText(rid, "feat_tree", "text/plain", ftb)
            }
            Deallocate(ftb, 4096)
            CA_RepoSaveSketches(rid)
        }
        CadApp.part_rev = CAD_Repo_State.last_rev
        CadApp.dirty = 0
        CadApp.list_open = 0
        IfCondition GreaterThan(rid, 0) ThenBlock: {
            CA_HistFlushRepo(rid)
        }
        CA_LogInt("cad_app: repo save H=", 21, CadApp.height)
        CA_LogInt("cad_app: repo save rev=", 23, CAD_Repo_State.last_rev)
        ReturnValue(0)
    }
}

// Load part from Postgres by CadApp.part_name → sketch/solid/height/hole.


// Load part from Postgres by CadApp.part_name → sketch/solid/height/hole.
Function.CA_RepoLoad {
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_RepoEnsure(), 0) ThenBlock: {
        }
        IfCondition EqualTo(CadApp.repo_ok, 0) ThenBlock: { ReturnValue(-1) }
        CA_EnsureName()
        pack = Allocate(64)
        rc = CAD_Repo.LoadPart(CadApp.part_name, pack)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            Deallocate(pack, 64)
            CA_LogInt("cad_app: repo load FAIL rc=", 27, rc)
            ReturnValue(rc)
        }
        h_sk = ArrayGet(pack, 0)
        h_sol = ArrayGet(pack, 1)
        h_hgt = ArrayGet(pack, 2)
        h_hole = ArrayGet(pack, 3)
        Deallocate(pack, 64)
        // Drop leftover sketches / pads so load is not mixed with the last part.
        CA_ClearModel()
        CadApp.height = h_hgt
        CadApp.rev_deg = CAD_Repo_State.last_rev_deg
        IfCondition LessThan(CadApp.rev_deg, 1) ThenBlock: { CadApp.rev_deg = 360 }
        CadApp.hole_sk = h_hole
        CadApp.solid = 0
        CadApp.part_rev = CAD_Repo_State.last_rev
        CadApp.list_open = 0
        IfCondition EqualTo(CAD_Repo.FetchAssetToFile(CadApp.part_name, 0, "plane_tree", "/tmp/cad_repo_planes.txt"), 0) ThenBlock: {
            slot = Allocate(16)
            n = CAD_Repo.ReadFileAll("/tmp/cad_repo_planes.txt", slot, 8192)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                tbuf = ArrayGet(slot, 0)
                CA_ParsePlaneTree(tbuf)
                Deallocate(tbuf, 8192)
            }
            Deallocate(slot, 16)
        }
        IfCondition EqualTo(CAD_Repo.FetchAssetToFile(CadApp.part_name, 0, "face_map", "/tmp/cad_repo_faces.txt"), 0) ThenBlock: {
            slot = Allocate(16)
            n = CAD_Repo.ReadFileAll("/tmp/cad_repo_faces.txt", slot, 4096)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                fbuf = ArrayGet(slot, 0)
                CA_ParseFaceMap(fbuf)
                CA_RegenPlaneTree()
                Deallocate(fbuf, 4096)
            }
            Deallocate(slot, 16)
        }
        IfCondition EqualTo(CadApp.sk0_plane, 0) ThenBlock: {
            CA_EnsurePlane()
        }
        nsk = CA_RepoLoadSketches()
        nft = 0
        IfCondition EqualTo(CAD_Repo.FetchAssetToFile(CadApp.part_name, 0, "feat_tree", "/tmp/cad_repo_feats.txt"), 0) ThenBlock: {
            slot = Allocate(16)
            n = CAD_Repo.ReadFileAll("/tmp/cad_repo_feats.txt", slot, 4096)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                ftb = ArrayGet(slot, 0)
                nft = CA_ParseFeatTree(ftb)
                Deallocate(ftb, 4096)
            }
            Deallocate(slot, 16)
        }
        did = 0
        IfCondition GreaterThan(nsk, 0) ThenBlock: {
            IfCondition GreaterThan(nft, 0) ThenBlock: {
                nrp = CA_RepoReplayFeats()
                IfCondition GreaterThan(nrp, 0) ThenBlock: { did = 1 }
            }
        }
        IfCondition EqualTo(did, 0) ThenBlock: {
            CadApp.sketch = h_sk
            IfCondition GreaterThan(CadApp.sk_n, 0) ThenBlock: {
                ArraySet(CadApp.sk_list, 0, h_sk)
            }
            IfCondition EqualTo(CadApp.sk_n, 0) ThenBlock: {
                CA_SketchRegister(h_sk)
            }
            CadApp.sk_i = 0
            CadApp.auto_pad = 1
            rc2 = CA_BuildSolid()
            CadApp.auto_pad = 0
            IfCondition NotEqual(rc2, 0) ThenBlock: {
                CadApp.solid = h_sol
            }
        }
        CadApp.mode = 0
        CadApp.dirty = 0
        IfCondition EqualTo(CAD_Repo.FetchAssetToFile(CadApp.part_name, 0, "hist_log", "/tmp/cad_app/hist.txt"), 0) ThenBlock: {
            CA_Log("cad_app: hist_log loaded\n", 25)
        }
        IfCondition EqualTo(CadApp.hist_n, 0) ThenBlock: {
            CA_HistPush(1)
        }
        CA_WriteHist()
        CA_Log("cad_app: repo load ok (sketches+feat_tree)\n", 43)
        ReturnValue(0)
    }
}

// File → Delete: drop the named Postgres document, then close the workspace.
Function.CA_RepoForget {
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_RepoEnsure(), 0) ThenBlock: {
        }
        IfCondition EqualTo(CadApp.repo_ok, 0) ThenBlock: {
            CA_Log("cad_app: forget needs PG\n", 25)
            ReturnValue(-1)
        }
        CA_EnsureName()
        rc = CAD_Repo.DeletePart(CadApp.part_name)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: forget FAIL\n", 21)
            ReturnValue(rc)
        }
        CA_Log("cad_app: forgot part\n", 21)
        CA_DocClose()
        ReturnValue(0)
    }
}

// Copy part name and append _dirty (for unsaved stash).
Function.CA_SetStashName {
    Output: Integer
    Body: {
        CA_EnsureName()
        n = 0
        WhileLoop NotEqual(GetByte(CadApp.name_buf, n), 0) {
            n = Add(n, 1)
            IfCondition GreaterThan(n, 62) ThenBlock: { n = 63 }
        }
        already = 0
        IfCondition GreaterEqual(n, 6) ThenBlock: {
            IfCondition EqualTo(GetByte(CadApp.name_buf, Subtract(n, 6)), 95) ThenBlock: {
                IfCondition EqualTo(GetByte(CadApp.name_buf, Subtract(n, 5)), 100) ThenBlock: {
                    already = 1
                }
            }
        }
        IfCondition EqualTo(already, 0) ThenBlock: {
            IfCondition GreaterThan(n, 56) ThenBlock: { n = 56 }
            SetByte(CadApp.name_buf, n, 95)
            SetByte(CadApp.name_buf, Add(n, 1), 100)
            SetByte(CadApp.name_buf, Add(n, 2), 105)
            SetByte(CadApp.name_buf, Add(n, 3), 114)
            SetByte(CadApp.name_buf, Add(n, 4), 116)
            SetByte(CadApp.name_buf, Add(n, 5), 121)
            SetByte(CadApp.name_buf, Add(n, 6), 0)
        }
        CadApp.part_name = CadApp.name_buf
        ReturnValue(0)
    }
}

// File leave: persist current work as <name>_dirty (overwrite that stash).
Function.CA_RepoStash {
    Output: Integer
    Body: {
        CA_EnsureName()
        CA_SetStashName()
        CAD_Repo_State.do_overwrite = 1
        rc = CA_RepoSave()
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: stash FAIL\n", 20)
            ReturnValue(rc)
        }
        CA_Log("cad_app: stashed dirty part\n", 28)
        ReturnValue(0)
    }
}



Function.CA_UndoPush {
    Output: Integer
    Body: {
        ReturnValue(0)
    }
}

Function.CA_Undo {
    Output: Integer
    Body: {
        ReturnValue(CA_HistBack())
    }
}

// Empty the current sketch only — keep the solid and the rest of the tree.
Function.CA_ClearSketch {
    Output: Integer
    Body: {
        sk = CadApp.sketch
        IfCondition EqualTo(sk, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
            CA_SketchRegister(CadApp.sketch)
            sk = CadApp.sketch
        }
        IfCondition NotEqual(sk, 0) ThenBlock: {
            CAD_Store.Write(sk, 0, 0)
            CAD_Store.Write(sk, 2, 0)
            CAD_Store.Write(sk, 7, 0)
            CAD_Store.Write(sk, 10, 0)
            CAD_Store.Write(sk, 12, 0)
            CAD_Store.Write(sk, 16, 0)
            CAD_Store.Write(sk, 20, 0)
            CAD_Store.Write(sk, 24, 0)
            CAD_Store.Write(sk, 27, 0)
        }
        CadApp.nclick = 0
        CadApp.hover_ok = 0
        CadApp.cx0 = 0
        CadApp.cy0 = 0
        CadApp.nprof = 0
        CadApp.prof_sel = 0
        CadApp.prof_user = 0
        CadApp.prof_mask = 0
        CadApp.n_face_ref = 0
        CadApp.tool = 0
        CadApp.mode = 1
        CadApp.dirty = 1
        CA_HistPush(6)
        CA_Log("cad_app: sketch cleared (model kept)\n", 37)
        ReturnValue(0)
    }
}

Function.CA_NewSketch {
    Output: Integer
    Body: {
        CA_ClearModel()
        CadApp.dirty = 1
        CA_Log("cad_app: new sketch (model cleared)\n", 36)
        ReturnValue(0)
    }
}

// Host close / quit cmd: drop model, tess cache, PG session, log.
Function.CA_Shutdown {
    Output: Integer
    Body: {
        CA_Log("cad_app: shutdown begin\n", 24)
        CA_ClearModel()
        CAD_View.InvalidateMesh()
        CAD_Repo.EndSession()
        CAD_Repo.Disconnect()
        CA_Log("cad_app: shutdown ok\n", 21)
        fd = CadApp.log_fd
        IfCondition GreaterThan(fd, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
        }
        CadApp.log_fd = 0
        CadApp.running = 0
        ReturnValue(0)
    }
}
