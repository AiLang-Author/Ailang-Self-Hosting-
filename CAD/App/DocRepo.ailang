Function.CA_FormatFeatTree {
    Input: buf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(0) }
        pos = 0
        pos = CAD_Repo.AppendStr(buf, pos, "FT1 n=")
        pos = CAD_Repo.AppendInt(buf, pos, CadApp.feat_n)
        pos = CAD_Repo.AppendStr(buf, pos, "\n")
        CadAppRepo.i = 0
        WhileLoop LessThan(CadAppRepo.i, CadApp.feat_n) {
            fk = ArrayGet(CadApp.feat_kind, CadAppRepo.i)
            fs = ArrayGet(CadApp.feat_sk, CadAppRepo.i)
            ax = 0
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                ax = ArrayGet(CadApp.feat_aux, CadAppRepo.i)
            }
            IfCondition EqualTo(fk, 0) ThenBlock: {
                IfCondition NotEqual(CadApp.sk_list, 0) ThenBlock: {
                    IfCondition GreaterEqual(fs, 0) ThenBlock: {
                        IfCondition LessThan(fs, CadApp.sk_n) ThenBlock: {
                            hsk = ArrayGet(CadApp.sk_list, fs)
                            pl = CAD_Sketch.GetPlaneId(hsk)
                            IfCondition NotEqual(pl, 0) ThenBlock: {
                                ax = CAD_Plane.GetPid(pl)
                            }
                        }
                    }
                }
            }
            pos = CAD_Repo.AppendInt(buf, pos, fk)
            pos = CAD_Repo.AppendStr(buf, pos, " ")
            pos = CAD_Repo.AppendInt(buf, pos, fs)
            pos = CAD_Repo.AppendStr(buf, pos, " ")
            pos = CAD_Repo.AppendInt(buf, pos, ax)
            pos = CAD_Repo.AppendStr(buf, pos, "\n")
            CadAppRepo.i = Add(CadAppRepo.i, 1)
        }
        SetByte(buf, pos, 0)
        ReturnValue(pos)
    }
}

Function.CA_ParseFeatTree {
    Input: buf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: {
            CadApp.feat_kind = Allocate(1024)
            CadApp.feat_sk = Allocate(1024)
            CadApp.feat_aux = Allocate(1024)
        }
        IfCondition EqualTo(CadApp.feat_aux, 0) ThenBlock: { CadApp.feat_aux = Allocate(1024) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(0) }
        p = 0
        p = CAD_Plane.SkipSp(buf, p)
        IfCondition EqualTo(GetByte(buf, p), 70) ThenBlock: {
            skipped = 0
            WhileLoop EqualTo(skipped, 0) {
                ch = GetByte(buf, p)
                IfCondition EqualTo(ch, 0) ThenBlock: { skipped = 1 }
                IfCondition EqualTo(ch, 10) ThenBlock: {
                    p = Add(p, 1)
                    skipped = 1
                }
                IfCondition EqualTo(skipped, 0) ThenBlock: { p = Add(p, 1) }
            }
        }
        tmp = Allocate(16)
        CadApp.feat_n = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            IfCondition GreaterEqual(CadApp.feat_n, 128) ThenBlock: { done = 1 }
            IfCondition EqualTo(done, 0) ThenBlock: {
                p = CAD_Plane.SkipSp(buf, p)
                IfCondition EqualTo(GetByte(buf, p), 0) ThenBlock: { done = 1 }
            }
            IfCondition EqualTo(done, 0) ThenBlock: {
                ni = CAD_Plane.ParseDec(buf, p, tmp)
                IfCondition LessThan(ni, 0) ThenBlock: { done = 1 }
                IfCondition GreaterEqual(ni, 0) ThenBlock: {
                    fk = ArrayGet(tmp, 0)
                    p = ni
                    ni = CAD_Plane.ParseDec(buf, p, tmp)
                    IfCondition LessThan(ni, 0) ThenBlock: { done = 1 }
                    IfCondition GreaterEqual(ni, 0) ThenBlock: {
                        fs = ArrayGet(tmp, 0)
                        p = ni
                        ni = CAD_Plane.ParseDec(buf, p, tmp)
                        IfCondition LessThan(ni, 0) ThenBlock: { done = 1 }
                        IfCondition GreaterEqual(ni, 0) ThenBlock: {
                            ax = ArrayGet(tmp, 0)
                            p = ni
                            ArraySet(CadApp.feat_kind, CadApp.feat_n, fk)
                            ArraySet(CadApp.feat_sk, CadApp.feat_n, fs)
                            ArraySet(CadApp.feat_aux, CadApp.feat_n, ax)
                            CadApp.feat_n = Add(CadApp.feat_n, 1)
                        }
                    }
                }
            }
        }
        Deallocate(tmp, 16)
        CA_LogInt("cad_app: feat_tree n=", 21, CadApp.feat_n)
        ReturnValue(CadApp.feat_n)
    }
}

// 1 if the sketch has lines, circles, or arcs (empty pages must not be profile_dxf).
Function.CA_SketchHasGeom {
    Input: hsk: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(hsk, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(CAD_Store.Read(hsk, 0), 0) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterThan(CAD_Store.Read(hsk, 7), 0) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterThan(CAD_Store.Read(hsk, 10), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// SavePart writes CadApp.sketch as profile_dxf. Empty current page → load FAIL.
Function.CA_RepoPickSaveSketch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_SketchHasGeom(CadApp.sketch), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(CadApp.sk_list, 0) ThenBlock: { ReturnValue(0) }
        CadAppRepo.i = 0
        WhileLoop LessThan(CadAppRepo.i, CadApp.sk_n) {
            hsk = ArrayGet(CadApp.sk_list, CadAppRepo.i)
            IfCondition EqualTo(CA_SketchHasGeom(hsk), 1) ThenBlock: {
                CadApp.sketch = hsk
                ReturnValue(1)
            }
            CadAppRepo.i = Add(CadAppRepo.i, 1)
        }
        ReturnValue(0)
    }
}

Function.CA_RepoSaveSketches {
    Input: rid: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(rid, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(rid, 0) ThenBlock: {
            CAD_Repo_State.last_rev_id = rid
        }
        IfCondition EqualTo(CadApp.sk_list, 0) ThenBlock: { ReturnValue(0) }
        CadAppRepo.i = 0
        CadAppRepo.n = 0
        WhileLoop LessThan(CadAppRepo.i, CadApp.sk_n) {
            sl = CadApp.sk_list
            hsk = 0
            IfCondition NotEqual(sl, 0) ThenBlock: {
                hsk = ArrayGet(sl, CadAppRepo.i)
            }
            IfCondition NotEqual(hsk, 0) ThenBlock: {
                IfCondition EqualTo(CA_SketchHasGeom(hsk), 1) ThenBlock: {
                    CadApp.tmp_a = Allocate(40)
                    CadApp.tmp_b = Allocate(20)
                    rp = 0
                    rp = CAD_Repo.AppendStr(CadApp.tmp_b, rp, "sketch_")
                    rp = CAD_Repo.AppendInt(CadApp.tmp_b, rp, CadAppRepo.i)
                    SetByte(CadApp.tmp_b, rp, 0)
                    pp = 0
                    pp = CAD_Repo.AppendStr(CadApp.tmp_a, pp, "/tmp/cad_repo_sk")
                    pp = CAD_Repo.AppendInt(CadApp.tmp_a, pp, CadAppRepo.i)
                    pp = CAD_Repo.AppendStr(CadApp.tmp_a, pp, ".dxf")
                    SetByte(CadApp.tmp_a, pp, 0)
                    IfCondition EqualTo(CAD_DXF.ExportSketch(hsk, CadApp.tmp_a), 0) ThenBlock: {
                        rp = 0
                        rp = CAD_Repo.AppendStr(CadApp.tmp_b, rp, "sketch_")
                        rp = CAD_Repo.AppendInt(CadApp.tmp_b, rp, CadAppRepo.i)
                        SetByte(CadApp.tmp_b, rp, 0)
                        slot = Allocate(16)
                        n_dxf = CAD_Repo.ReadFileAll(CadApp.tmp_a, slot, 262144)
                        IfCondition GreaterThan(n_dxf, 0) ThenBlock: {
                            dxf_buf = ArrayGet(slot, 0)
                            CAD_Repo.PutAssetText(CAD_Repo_State.last_rev_id, CadApp.tmp_b, "application/dxf", dxf_buf)
                            Deallocate(dxf_buf, 262144)
                            CadAppRepo.n = Add(CadAppRepo.n, 1)
                        }
                        Deallocate(slot, 16)
                    }
                    Deallocate(CadApp.tmp_a, 40)
                    Deallocate(CadApp.tmp_b, 20)
                    CadApp.tmp_a = 0
                    CadApp.tmp_b = 0
                }
            }
            CadAppRepo.i = Add(CadAppRepo.i, 1)
        }
        CA_LogInt("cad_app: saved sketches=", 24, CadAppRepo.n)
        ReturnValue(CadAppRepo.n)
    }
}

Function.CA_RepoLoadSketches {
    Output: Integer
    Body: {
        CadAppRepo.i = 0
        CadAppRepo.n = 0
        WhileLoop LessThan(CadAppRepo.i, 64) {
            CadApp.tmp_a = Allocate(40)
            CadApp.tmp_b = Allocate(20)
            rp = 0
            rp = CAD_Repo.AppendStr(CadApp.tmp_b, rp, "sketch_")
            rp = CAD_Repo.AppendInt(CadApp.tmp_b, rp, CadAppRepo.i)
            SetByte(CadApp.tmp_b, rp, 0)
            pp = 0
            pp = CAD_Repo.AppendStr(CadApp.tmp_a, pp, "/tmp/cad_repo_sk")
            pp = CAD_Repo.AppendInt(CadApp.tmp_a, pp, CadAppRepo.i)
            pp = CAD_Repo.AppendStr(CadApp.tmp_a, pp, ".dxf")
            SetByte(CadApp.tmp_a, pp, 0)
            rc = CAD_Repo.FetchAssetToFile(CadApp.part_name, 0, CadApp.tmp_b, CadApp.tmp_a)
            IfCondition EqualTo(rc, 0) ThenBlock: {
                slot = Allocate(16)
                ArraySet(slot, 0, 0)
                irc = CAD_DXF.ImportFile(CadApp.tmp_a, slot)
                hsk = ArrayGet(slot, 0)
                Deallocate(slot, 16)
                IfCondition EqualTo(irc, 0) ThenBlock: {
                    IfCondition NotEqual(hsk, 0) ThenBlock: {
                        IfCondition EqualTo(CadAppRepo.i, 0) ThenBlock: {
                            CadApp.sketch = hsk
                            IfCondition EqualTo(CadApp.sk_list, 0) ThenBlock: {
                                CA_SketchAttach(hsk)
                            }
                            IfCondition NotEqual(CadApp.sk_list, 0) ThenBlock: {
                                ArraySet(CadApp.sk_list, 0, hsk)
                            }
                            IfCondition EqualTo(CadApp.sk_n, 0) ThenBlock: {
                                CA_SketchAttach(hsk)
                            }
                        }
                        IfCondition GreaterThan(CadAppRepo.i, 0) ThenBlock: {
                            CA_SketchAttach(hsk)
                        }
                        CadAppRepo.n = Add(CadAppRepo.n, 1)
                    }
                }
            }
            Deallocate(CadApp.tmp_a, 40)
            Deallocate(CadApp.tmp_b, 20)
            CadApp.tmp_a = 0
            CadApp.tmp_b = 0
            CadAppRepo.i = Add(CadAppRepo.i, 1)
        }
        CA_LogInt("cad_app: loaded sketches=", 25, CadAppRepo.n)
        ReturnValue(CadAppRepo.n)
    }
}

Function.CA_RepoReplayFeats {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.feat_n, 1) ThenBlock: { ReturnValue(-1) }
        CadApp.replay = 1
        CadApp.solid = 0
        CadApp.pad_edit = 1
        CadApp.auto_pad = 0
        CadApp.hole_sk = 0
        CadAppRepo.feat_i = 0
        CadAppRepo.n = 0
        WhileLoop LessThan(CadAppRepo.feat_i, CadApp.feat_n) {
            fk = ArrayGet(CadApp.feat_kind, CadAppRepo.feat_i)
            fs = ArrayGet(CadApp.feat_sk, CadAppRepo.feat_i)
            ax = 0
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                ax = ArrayGet(CadApp.feat_aux, CadAppRepo.feat_i)
            }
            IfCondition EqualTo(fk, 0) ThenBlock: {
                IfCondition NotEqual(CadApp.sk_list, 0) ThenBlock: {
                    IfCondition GreaterEqual(fs, 0) ThenBlock: {
                        IfCondition LessThan(fs, CadApp.sk_n) ThenBlock: {
                            hsk = ArrayGet(CadApp.sk_list, fs)
                            IfCondition NotEqual(ax, 0) ThenBlock: {
                                pl = CA_PlaneByPid(ax)
                                IfCondition NotEqual(pl, 0) ThenBlock: {
                                    CAD_Sketch.SetPlaneId(hsk, pl)
                                }
                            }
                        }
                    }
                }
            }
            go = 0
            IfCondition EqualTo(fk, 1) ThenBlock: { go = 1 }
            IfCondition EqualTo(fk, 3) ThenBlock: { go = 1 }
            IfCondition EqualTo(go, 1) ThenBlock: {
                IfCondition NotEqual(CadApp.sk_list, 0) ThenBlock: {
                    IfCondition GreaterEqual(fs, 0) ThenBlock: {
                        IfCondition LessThan(fs, CadApp.sk_n) ThenBlock: {
                            CadApp.sketch = ArrayGet(CadApp.sk_list, fs)
                            CA_BindSketchPlane()
                            // re-read after Bind (locals die)
                            ax = 0
                            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                                ax = ArrayGet(CadApp.feat_aux, CadAppRepo.feat_i)
                            }
                            fk = ArrayGet(CadApp.feat_kind, CadAppRepo.feat_i)
                            CadApp.height = ax
                            IfCondition LessThan(CadApp.height, 1) ThenBlock: {
                                IfCondition GreaterThan(CadApp.height, Subtract(0, 1)) ThenBlock: {
                                    CadApp.height = 10
                                }
                            }
                            hh = Float_FromInt(CadApp.height)
                            IfCondition LessThan(CadApp.height, 0) ThenBlock: {
                                hh = Float_FromInt(Subtract(0, CadApp.height))
                            }
                            pln = CAD_Sketch.GetPlaneId(CadApp.sketch)
                            IfCondition EqualTo(pln, 0) ThenBlock: { pln = CadApp.plane }
                            tool = CAD_Feat.ExtrudeOnPlane(CadApp.sketch, hh, pln)
                            IfCondition EqualTo(tool, 0) ThenBlock: {
                                hh = Float_FromInt(CadApp.height)
                                IfCondition LessThan(CadApp.height, 0) ThenBlock: {
                                    hh = Float_FromInt(Subtract(0, CadApp.height))
                                }
                                tool = CAD_Feat.ExtrudeProfile(CadApp.sketch, hh)
                            }
                            IfCondition EqualTo(tool, 0) ThenBlock: {
                                CA_LogInt("cad_app: replay pad FAIL i=", 27, CadAppRepo.feat_i)
                            }
                            IfCondition NotEqual(tool, 0) ThenBlock: {
                                IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
                                    CadApp.solid = tool
                                    CadAppRepo.n = Add(CadAppRepo.n, 1)
                                }
                                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                                    IfCondition NotEqual(CadApp.solid, tool) ThenBlock: {
                                        fk = ArrayGet(CadApp.feat_kind, CadAppRepo.feat_i)
                                        IfCondition EqualTo(fk, 3) ThenBlock: {
                                            cut = CAD_Bool.Difference(CadApp.solid, tool)
                                            IfCondition NotEqual(cut, 0) ThenBlock: {
                                                CadApp.solid = cut
                                                CadAppRepo.n = Add(CadAppRepo.n, 1)
                                            }
                                        }
                                        IfCondition NotEqual(fk, 3) ThenBlock: {
                                            CAD_Topo.RebuildKind0Planes(CadApp.solid)
                                            CAD_Topo.RebuildKind0Planes(tool)
                                            glued = CAD_Bool.GlueOnFace(CadApp.solid, tool)
                                            IfCondition NotEqual(glued, 0) ThenBlock: {
                                                CadApp.solid = glued
                                            }
                                            IfCondition EqualTo(glued, 0) ThenBlock: {
                                                CadApp.solid = CAD_Topo.CompoundAdd(CadApp.solid, tool)
                                            }
                                            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                                                CadAppRepo.n = Add(CadAppRepo.n, 1)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            CadAppRepo.feat_i = Add(CadAppRepo.feat_i, 1)
        }
        CadApp.pad_edit = 0
        CadApp.auto_pad = 0
        CadApp.replay = 0
        CadApp.prof_user = 0
        CadApp.dirty = 0
        CA_LogInt("cad_app: replay pads=", 21, CadAppRepo.n)
        ReturnValue(CadAppRepo.n)
    }
}

// Save current sketch+solid+hole to Postgres under CadApp.part_name.
Function.CA_RepoSave {
    Output: Integer
    Body: {
        CA_Log("cad_app: save enter\n", 20)
        ens = CA_RepoEnsure()
        CA_LogInt("cad_app: save ensure=", 21, ens)
        IfCondition EqualTo(CadApp.repo_ok, 0) ThenBlock: {
            CA_Log("cad_app: save needs PG\n", 23)
            ReturnValue(-1)
        }
        CA_EnsureName()
        CA_Log("cad_app: save name ok\n", 22)
        CA_RepoPickSaveSketch()
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: save needs sketch\n", 27)
            ReturnValue(-3)
        }
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CadApp.auto_pad = 1
            rc = CA_BuildSolid()
            CadApp.auto_pad = 0
            IfCondition NotEqual(rc, 0) ThenBlock: {
                CA_Log("cad_app: save needs a solid or closed profile\n", 46)
                ReturnValue(-3)
            }
        }
        // Prefer the last pad feature's HUD height if it was typed.
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            pi = Subtract(CadApp.feat_n, 1)
            WhileLoop GreaterEqual(pi, 0) {
                IfCondition EqualTo(ArrayGet(CadApp.feat_kind, pi), 1) ThenBlock: {
                    ha = ArrayGet(CadApp.feat_aux, pi)
                    IfCondition GreaterThan(ha, 0) ThenBlock: {
                        CadApp.height = ha
                        pi = 0
                    }
                }
                pi = Subtract(pi, 1)
            }
        }
        IfCondition LessThan(CadApp.height, 1) ThenBlock: { CadApp.height = 10 }
        IfCondition LessThan(CadApp.rev_deg, 1) ThenBlock: { CadApp.rev_deg = 360 }
        CAD_Repo_State.save_kind = CadApp.doc_kind
        CAD_Repo_State.save_rev_deg = CadApp.rev_deg
        CA_LogInt("cad_app: save H=", 16, CadApp.height)
        CA_Log("cad_app: save SavePart\n", 23)
        CA_SetPartName(CadApp.name_buf)
        IfCondition EqualTo(CAD_Repo.IsSafeName(CadApp.part_name), 0) ThenBlock: {
            CA_Log("cad_app: save name not safe\n", 28)
            ReturnValue(-3)
        }
        rc = CAD_Repo.SavePart(CadApp.part_name, CadApp.sketch, CadApp.solid, CadApp.height, CadApp.hole_sk)
        CA_LogInt("cad_app: save SavePart rc=", 26, rc)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: repo save FAIL\n", 24)
            ReturnValue(rc)
        }
        rid = CAD_Repo_State.last_rev_id
        IfCondition GreaterThan(rid, 0) ThenBlock: {
            tbuf = Allocate(8192)
            nt = CA_FormatPlaneTree(tbuf)
            IfCondition GreaterThan(nt, 0) ThenBlock: {
                CAD_Repo.PutAssetText(rid, "plane_tree", "application/json", tbuf)
            }
            Deallocate(tbuf, 8192)
            fbuf = Allocate(4096)
            nf = CA_FormatFaceMap(fbuf)
            IfCondition GreaterThan(nf, 0) ThenBlock: {
                CAD_Repo.PutAssetText(rid, "face_map", "application/json", fbuf)
            }
            Deallocate(fbuf, 4096)
            ftb = Allocate(4096)
            nft = CA_FormatFeatTree(ftb)
            IfCondition GreaterThan(nft, 0) ThenBlock: {
                CAD_Repo.PutAssetText(rid, "feat_tree", "text/plain", ftb)
            }
            Deallocate(ftb, 4096)
            CA_RepoSaveSketches(rid)
        }
        CadApp.part_rev = CAD_Repo_State.last_rev
        CadApp.dirty = 0
        CadApp.list_open = 0
        IfCondition GreaterThan(rid, 0) ThenBlock: {
            CA_HistFlushRepo(rid)
        }
        CA_LogInt("cad_app: repo save H=", 21, CadApp.height)
        CA_LogInt("cad_app: repo save rev=", 23, CAD_Repo_State.last_rev)
        ReturnValue(0)
    }
}

// Load part from Postgres by CadApp.part_name → sketch/solid/height/hole.


// Load part from Postgres by CadApp.part_name → sketch/solid/height/hole.
Function.CA_RepoLoad {
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_RepoEnsure(), 0) ThenBlock: {
        }
        IfCondition EqualTo(CadApp.repo_ok, 0) ThenBlock: { ReturnValue(-1) }
        CA_EnsureName()
        pack = Allocate(64)
        rc = CAD_Repo.LoadPart(CadApp.part_name, pack)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            Deallocate(pack, 64)
            CA_LogInt("cad_app: repo load FAIL rc=", 27, rc)
            ReturnValue(rc)
        }
        h_sk = ArrayGet(pack, 0)
        h_sol = ArrayGet(pack, 1)
        h_hgt = ArrayGet(pack, 2)
        h_hole = ArrayGet(pack, 3)
        Deallocate(pack, 64)
        // Drop leftover sketches / pads so load is not mixed with the last part.
        CA_ClearModel()
        CadApp.height = h_hgt
        CadApp.rev_deg = CAD_Repo_State.last_rev_deg
        IfCondition LessThan(CadApp.rev_deg, 1) ThenBlock: { CadApp.rev_deg = 360 }
        CadApp.hole_sk = h_hole
        CadApp.solid = 0
        CadApp.part_rev = CAD_Repo_State.last_rev
        CadApp.list_open = 0
        IfCondition EqualTo(CAD_Repo.FetchAssetToFile(CadApp.part_name, 0, "plane_tree", "/tmp/cad_repo_planes.txt"), 0) ThenBlock: {
            slot = Allocate(16)
            n = CAD_Repo.ReadFileAll("/tmp/cad_repo_planes.txt", slot, 8192)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                tbuf = ArrayGet(slot, 0)
                CA_ParsePlaneTree(tbuf)
                Deallocate(tbuf, 8192)
            }
            Deallocate(slot, 16)
        }
        IfCondition EqualTo(CAD_Repo.FetchAssetToFile(CadApp.part_name, 0, "face_map", "/tmp/cad_repo_faces.txt"), 0) ThenBlock: {
            slot = Allocate(16)
            n = CAD_Repo.ReadFileAll("/tmp/cad_repo_faces.txt", slot, 4096)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                fbuf = ArrayGet(slot, 0)
                CA_ParseFaceMap(fbuf)
                CA_RegenPlaneTree()
                Deallocate(fbuf, 4096)
            }
            Deallocate(slot, 16)
        }
        IfCondition EqualTo(CadApp.sk0_plane, 0) ThenBlock: {
            CA_EnsurePlane()
        }
        nsk = CA_RepoLoadSketches()
        nft = 0
        IfCondition EqualTo(CAD_Repo.FetchAssetToFile(CadApp.part_name, 0, "feat_tree", "/tmp/cad_repo_feats.txt"), 0) ThenBlock: {
            slot = Allocate(16)
            n = CAD_Repo.ReadFileAll("/tmp/cad_repo_feats.txt", slot, 4096)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                ftb = ArrayGet(slot, 0)
                nft = CA_ParseFeatTree(ftb)
                Deallocate(ftb, 4096)
            }
            Deallocate(slot, 16)
        }
        did = 0
        IfCondition GreaterThan(nsk, 0) ThenBlock: {
            IfCondition GreaterThan(nft, 0) ThenBlock: {
                nrp = CA_RepoReplayFeats()
                IfCondition GreaterThan(nrp, 0) ThenBlock: { did = 1 }
            }
        }
        IfCondition EqualTo(did, 0) ThenBlock: {
            CadApp.sketch = h_sk
            IfCondition GreaterThan(CadApp.sk_n, 0) ThenBlock: {
                ArraySet(CadApp.sk_list, 0, h_sk)
            }
            IfCondition EqualTo(CadApp.sk_n, 0) ThenBlock: {
                CA_SketchRegister(h_sk)
            }
            CadApp.sk_i = 0
            CadApp.auto_pad = 1
            rc2 = CA_BuildSolid()
            CadApp.auto_pad = 0
            IfCondition NotEqual(rc2, 0) ThenBlock: {
                CadApp.solid = h_sol
            }
        }
        CadApp.mode = 0
        CadApp.dirty = 0
        IfCondition EqualTo(CAD_Repo.FetchAssetToFile(CadApp.part_name, 0, "hist_log", "/tmp/cad_app/hist.txt"), 0) ThenBlock: {
            CA_Log("cad_app: hist_log loaded\n", 25)
        }
        CadApp.hist_n = 0
        CadApp.hist_cur = 0
        CA_HistPush(1)
        CA_Log("cad_app: repo load ok (sketches+feat_tree)\n", 43)
        ReturnValue(0)
    }
}

// File → Delete: drop the named Postgres document, then close the workspace.
Function.CA_RepoForget {
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_RepoEnsure(), 0) ThenBlock: {
        }
        IfCondition EqualTo(CadApp.repo_ok, 0) ThenBlock: {
            CA_Log("cad_app: forget needs PG\n", 25)
            ReturnValue(-1)
        }
        CA_EnsureName()
        rc = CAD_Repo.DeletePart(CadApp.part_name)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: forget FAIL\n", 21)
            ReturnValue(rc)
        }
        CA_Log("cad_app: forgot part\n", 21)
        CA_DocClose()
        ReturnValue(0)
    }
}

// Copy part name and append _dirty (for unsaved stash).
Function.CA_SetStashName {
    Output: Integer
    Body: {
        CA_EnsureName()
        n = 0
        WhileLoop NotEqual(GetByte(CadApp.name_buf, n), 0) {
            n = Add(n, 1)
            IfCondition GreaterThan(n, 62) ThenBlock: { n = 63 }
        }
        already = 0
        IfCondition GreaterEqual(n, 6) ThenBlock: {
            IfCondition EqualTo(GetByte(CadApp.name_buf, Subtract(n, 6)), 95) ThenBlock: {
                IfCondition EqualTo(GetByte(CadApp.name_buf, Subtract(n, 5)), 100) ThenBlock: {
                    already = 1
                }
            }
        }
        IfCondition EqualTo(already, 0) ThenBlock: {
            IfCondition GreaterThan(n, 56) ThenBlock: { n = 56 }
            SetByte(CadApp.name_buf, n, 95)
            SetByte(CadApp.name_buf, Add(n, 1), 100)
            SetByte(CadApp.name_buf, Add(n, 2), 105)
            SetByte(CadApp.name_buf, Add(n, 3), 114)
            SetByte(CadApp.name_buf, Add(n, 4), 116)
            SetByte(CadApp.name_buf, Add(n, 5), 121)
            SetByte(CadApp.name_buf, Add(n, 6), 0)
        }
        CadApp.part_name = CadApp.name_buf
        ReturnValue(0)
    }
}

// File leave: persist current work as <name>_dirty (overwrite that stash).
Function.CA_RepoStash {
    Output: Integer
    Body: {
        CA_EnsureName()
        CA_SetStashName()
        CAD_Repo_State.do_overwrite = 1
        rc = CA_RepoSave()
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: stash FAIL\n", 20)
            ReturnValue(rc)
        }
        CA_Log("cad_app: stashed dirty part\n", 28)
        ReturnValue(0)
    }
}



Function.CA_UndoPush {
    Output: Integer
    Body: {
        ReturnValue(0)
    }
}

Function.CA_Undo {
    Output: Integer
    Body: {
        ReturnValue(CA_HistBack())
    }
}

// Empty the current sketch only — keep the solid and the rest of the tree.
Function.CA_ClearSketch {
    Output: Integer
    Body: {
        sk = CadApp.sketch
        IfCondition EqualTo(sk, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
            CA_SketchRegister(CadApp.sketch)
            sk = CadApp.sketch
        }
        IfCondition NotEqual(sk, 0) ThenBlock: {
            CAD_Store.Write(sk, 0, 0)
            CAD_Store.Write(sk, 2, 0)
            CAD_Store.Write(sk, 7, 0)
            CAD_Store.Write(sk, 10, 0)
            CAD_Store.Write(sk, 12, 0)
            CAD_Store.Write(sk, 16, 0)
            CAD_Store.Write(sk, 20, 0)
            CAD_Store.Write(sk, 24, 0)
            CAD_Store.Write(sk, 27, 0)
        }
        CadApp.nclick = 0
        CadApp.hover_ok = 0
        CadApp.cx0 = 0
        CadApp.cy0 = 0
        CadApp.nprof = 0
        CadApp.prof_sel = 0
        CadApp.prof_user = 0
        CadApp.prof_mask = 0
        CadApp.n_face_ref = 0
        CadApp.tool = 0
        CadApp.mode = 1
        CadApp.dirty = 1
        CA_HistPush(6)
        CA_Log("cad_app: sketch cleared (model kept)\n", 37)
        ReturnValue(0)
    }
}

Function.CA_NewSketch {
    Output: Integer
    Body: {
        CA_ClearModel()
        CadApp.dirty = 1
        CA_Log("cad_app: new sketch (model cleared)\n", 36)
        ReturnValue(0)
    }
}

// Host close / quit cmd: drop model, tess cache, PG session, log.
Function.CA_Shutdown {
    Output: Integer
    Body: {
        CA_Log("cad_app: shutdown begin\n", 24)
        CA_ClearModel()
        CAD_View.InvalidateMesh()
        CAD_Repo.EndSession()
        CAD_Repo.Disconnect()
        CA_Log("cad_app: shutdown ok\n", 21)
        fd = CadApp.log_fd
        IfCondition GreaterThan(fd, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
        }
        CadApp.log_fd = 0
        CadApp.running = 0
        ReturnValue(0)
    }
}
