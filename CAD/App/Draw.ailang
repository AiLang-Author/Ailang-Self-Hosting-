// Projection ring color from sketch-pad background: push toward white on dark
// pads, toward black on light pads (readable delta, not neon on noise).
Function.CA_ProfileProjColor {
    Input: br: Integer
    Input: bg: Integer
    Input: bb: Integer
    Output: Integer
    Body: {
        // luminance ~ (r+g+b)/3
        lum = Divide(Add(Add(br, bg), bb), 3)
        // delta steps the tint away from the pad
        d = 150
        IfCondition LessThan(lum, 128) ThenBlock: {
            // dark pad → light grey-cyan projection
            r = Add(br, d)
            g = Add(bg, d)
            b = Add(bb, Add(d, 20))
            IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
            IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
            IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
            // floor so it never collapses into bg
            IfCondition LessThan(r, 140) ThenBlock: { r = 140 }
            IfCondition LessThan(g, 150) ThenBlock: { g = 150 }
            IfCondition LessThan(b, 170) ThenBlock: { b = 170 }
            ReturnValue(FB_RGB(r, g, b))
        }
        // light pad → charcoal projection
        r = Subtract(br, d)
        g = Subtract(bg, d)
        b = Subtract(bb, d)
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition LessThan(b, 0) ThenBlock: { b = 0 }
        IfCondition GreaterThan(r, 80) ThenBlock: { r = 80 }
        IfCondition GreaterThan(g, 80) ThenBlock: { g = 80 }
        IfCondition GreaterThan(b, 90) ThenBlock: { b = 90 }
        ReturnValue(FB_RGB(r, g, b))
    }
}


// Ensure sketch camera: extent in mm, scale px/mm
Function.CA_UpdateSketchCam {
    Output: Integer
    Body: {
        CadApp.extent = Float_FromInt(50)
        // grow from line AABB if any
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            IfCondition GreaterThan(nl, 0) ThenBlock: {
                lines = CAD_Store.Read(CadApp.sketch, 1)
                xmin = ArrayGet(lines, 0)
                ymin = ArrayGet(lines, 1)
                xmax = xmin
                ymax = ymin
                i = 0
                WhileLoop LessThan(i, nl) {
                    b = Multiply(i, 4)
                    x1 = ArrayGet(lines, b)
                    y1 = ArrayGet(lines, Add(b, 1))
                    x2 = ArrayGet(lines, Add(b, 2))
                    y2 = ArrayGet(lines, Add(b, 3))
                    IfCondition EqualTo(Float_Le(x1, xmin), 1) ThenBlock: { xmin = x1 }
                    IfCondition EqualTo(Float_Le(xmax, x1), 1) ThenBlock: { xmax = x1 }
                    IfCondition EqualTo(Float_Le(y1, ymin), 1) ThenBlock: { ymin = y1 }
                    IfCondition EqualTo(Float_Le(ymax, y1), 1) ThenBlock: { ymax = y1 }
                    IfCondition EqualTo(Float_Le(x2, xmin), 1) ThenBlock: { xmin = x2 }
                    IfCondition EqualTo(Float_Le(xmax, x2), 1) ThenBlock: { xmax = x2 }
                    IfCondition EqualTo(Float_Le(y2, ymin), 1) ThenBlock: { ymin = y2 }
                    IfCondition EqualTo(Float_Le(ymax, y2), 1) ThenBlock: { ymax = y2 }
                    i = Add(i, 1)
                }
                dx = Float_Sub(xmax, xmin)
                dy = Float_Sub(ymax, ymin)
                ext = dx
                IfCondition EqualTo(Float_Le(ext, dy), 1) ThenBlock: { ext = dy }
                half = Float_Div(ext, 0x4000000000000000)
                // pad 20%
                ext = Float_Mul(ext, 0x3FF3333333333333)
                IfCondition EqualTo(Float_Le(ext, Float_FromInt(10)), 1) ThenBlock: {
                    ext = Float_FromInt(50)
                }
                CadApp.extent = ext
            }
        }
        mw = CadApp.width
        IfCondition LessThan(CadApp.height_px, mw) ThenBlock: { mw = CadApp.height_px }
        IfCondition EqualTo(CadApp.sk_zoom, 0) ThenBlock: {
            CadApp.sk_zoom = 0x3FF0000000000000
        }
        IfCondition EqualTo(CAD_Num.IsZero(CadApp.extent, 0), 1) ThenBlock: {
            CadApp.extent = Float_FromInt(50)
        }
        // base fit * user scroll zoom
        base = Float_Div(Float_Mul(0x3FEB333333333333, Float_FromInt(mw)), CadApp.extent)
        CadApp.scale = Float_Mul(base, CadApp.sk_zoom)
        ReturnValue(0)
    }
}

// 1 = sketching on a face with the solid still in view.
Function.CA_SketchInContext {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

// Kernel camera — host only sends orbit/pan/zoom. Never leave sketch mode.
// In-context / 3D: CAD_View (same camera as the solid).
// Flat 2D sketch (no solid): remap orbit → sketch pan, zoom → sk_zoom.
Function.CA_ViewPan {
    Input: dx: Integer
    Input: dy: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_SketchInContext(), 1) ThenBlock: {
            CAD_View.PanPixels(dx, dy)
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
            CAD_View.PanPixels(dx, dy)
            ReturnValue(0)
        }
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
            sc = 0x3FF0000000000000
        }
        CadApp.sk_pan_x = Float_Sub(CadApp.sk_pan_x, Float_Div(Float_FromInt(dx), sc))
        CadApp.sk_pan_y = Float_Add(CadApp.sk_pan_y, Float_Div(Float_FromInt(dy), sc))
        ReturnValue(1)
    }
}

Function.CA_ViewZoom {
    Input: steps: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_SketchInContext(), 1) ThenBlock: {
            CAD_View.ZoomSteps(steps)
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
            CAD_View.ZoomSteps(steps)
            ReturnValue(0)
        }
        IfCondition EqualTo(CadApp.sk_zoom, 0) ThenBlock: {
            CadApp.sk_zoom = 0x3FF0000000000000
        }
        zin = 0x3FF2666666666666
        zout = 0x3FEBD37A6F4DE9BE
        zmin = 0x3FB999999999999A
        zmax = 0x4034000000000000
        zs = steps
        s = 0
        WhileLoop LessThan(s, 64) {
            IfCondition EqualTo(zs, 0) ThenBlock: { s = 64 }
            IfCondition GreaterThan(zs, 0) ThenBlock: {
                CadApp.sk_zoom = Float_Mul(CadApp.sk_zoom, zin)
                zs = Subtract(zs, 1)
            }
            IfCondition LessThan(zs, 0) ThenBlock: {
                CadApp.sk_zoom = Float_Mul(CadApp.sk_zoom, zout)
                zs = Add(zs, 1)
            }
            s = Add(s, 1)
        }
        IfCondition EqualTo(Float_Le(CadApp.sk_zoom, zmin), 1) ThenBlock: {
            CadApp.sk_zoom = zmin
        }
        IfCondition EqualTo(Float_Le(zmax, CadApp.sk_zoom), 1) ThenBlock: {
            CadApp.sk_zoom = zmax
        }
        ReturnValue(1)
    }
}

Function.CA_ViewOrbit {
    Input: dx: Integer
    Input: dy: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_SketchInContext(), 1) ThenBlock: {
            CAD_View.OrbitPixels(dx, dy)
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
            ReturnValue(CA_ViewPan(dx, dy))
        }
        CAD_View.OrbitPixels(dx, dy)
        ReturnValue(0)
    }
}

// pixel → UV on the active sketch plane (ray ∩ plane).
Function.CA_PixToSketchUV {
    Input: px: Integer
    Input: py: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(out_xy, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: { ReturnValue(-1) }
        CA_PickBufs()
        IfCondition EqualTo(CadAppPick.fr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadAppPick.pl, 0) ThenBlock: { ReturnValue(-1) }
        CA_BuildViewFrame(CadAppPick.fr)
        CA_CamBasis()
        cx = ArrayGet(CadAppPick.fr, 0)
        cy = ArrayGet(CadAppPick.fr, 1)
        cz = ArrayGet(CadAppPick.fr, 2)
        sc = ArrayGet(CadAppPick.fr, 3)
        hw = ArrayGet(CadAppPick.fr, 4)
        hh = ArrayGet(CadAppPick.fr, 5)
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: { ReturnValue(-1) }
        uu = Float_Sub(Float_Div(Float_Sub(Float_FromInt(px), hw), sc), CAD_View_State.pan_u)
        vv = Float_Sub(Float_Div(Float_Sub(hh, Float_FromInt(py)), sc), CAD_View_State.pan_v)
        CadAppPick.wx = Float_Add(cx, Float_Add(Float_Mul(uu, CadAppPick.rx), Float_Mul(vv, CadAppPick.ux)))
        CadAppPick.wy = Float_Add(cy, Float_Add(Float_Mul(uu, CadAppPick.ry), Float_Mul(vv, CadAppPick.uy)))
        CadAppPick.wz = Float_Add(cz, Float_Add(Float_Mul(uu, CadAppPick.rz), Float_Mul(vv, CadAppPick.uz)))
        CadAppPick.dx = Float_Sub(0, CadAppPick.cdx)
        CadAppPick.dy = Float_Sub(0, CadAppPick.cdy)
        CadAppPick.dz = Float_Sub(0, CadAppPick.cdz)
        CAD_Plane.EvalFrame(CadApp.plane, CadAppPick.pl)
        CadAppPick.ox = ArrayGet(CadAppPick.pl, 0)
        CadAppPick.oy = ArrayGet(CadAppPick.pl, 1)
        CadAppPick.oz = ArrayGet(CadAppPick.pl, 2)
        CadAppPick.nx = ArrayGet(CadAppPick.pl, 9)
        CadAppPick.ny = ArrayGet(CadAppPick.pl, 10)
        CadAppPick.nz = ArrayGet(CadAppPick.pl, 11)
        den = Float_Add(Float_Add(Float_Mul(CadAppPick.dx, CadAppPick.nx), Float_Mul(CadAppPick.dy, CadAppPick.ny)), Float_Mul(CadAppPick.dz, CadAppPick.nz))
        IfCondition EqualTo(CAD_Num.IsZero(den, 0), 1) ThenBlock: { ReturnValue(-1) }
        CadAppPick.last_t = Float_Div(Float_Add(Float_Add(Float_Mul(Float_Sub(CadAppPick.ox, CadAppPick.wx), CadAppPick.nx), Float_Mul(Float_Sub(CadAppPick.oy, CadAppPick.wy), CadAppPick.ny)), Float_Mul(Float_Sub(CadAppPick.oz, CadAppPick.wz), CadAppPick.nz)), den)
        ArraySet(CadAppPick.hit, 0, Float_Add(CadAppPick.wx, Float_Mul(CadAppPick.last_t, CadAppPick.dx)))
        ArraySet(CadAppPick.hit, 1, Float_Add(CadAppPick.wy, Float_Mul(CadAppPick.last_t, CadAppPick.dy)))
        ArraySet(CadAppPick.hit, 2, Float_Add(CadAppPick.wz, Float_Mul(CadAppPick.last_t, CadAppPick.dz)))
        hx = ArrayGet(CadAppPick.hit, 0)
        hy = ArrayGet(CadAppPick.hit, 1)
        hz = ArrayGet(CadAppPick.hit, 2)
        xx = ArrayGet(CadAppPick.pl, 3)
        xy = ArrayGet(CadAppPick.pl, 4)
        xz = ArrayGet(CadAppPick.pl, 5)
        yx = ArrayGet(CadAppPick.pl, 6)
        yy = ArrayGet(CadAppPick.pl, 7)
        yz = ArrayGet(CadAppPick.pl, 8)
        ArraySet(out_xy, 0, Float_Add(Float_Add(Float_Mul(Float_Sub(hx, CadAppPick.ox), xx), Float_Mul(Float_Sub(hy, CadAppPick.oy), xy)), Float_Mul(Float_Sub(hz, CadAppPick.oz), xz)))
        ArraySet(out_xy, 1, Float_Add(Float_Add(Float_Mul(Float_Sub(hx, CadAppPick.ox), yx), Float_Mul(Float_Sub(hy, CadAppPick.oy), yy)), Float_Mul(Float_Sub(hz, CadAppPick.oz), yz)))
        ReturnValue(0)
    }
}

Function.CA_UvToPix3 {
    Input: wx: Integer
    Input: wy: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(out_xy, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: { ReturnValue(-1) }
        CA_PickBufs()
        IfCondition EqualTo(CadAppPick.pl, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Plane.EvalFrame(CadApp.plane, CadAppPick.pl)
        CadAppPick.ox = ArrayGet(CadAppPick.pl, 0)
        CadAppPick.oy = ArrayGet(CadAppPick.pl, 1)
        CadAppPick.oz = ArrayGet(CadAppPick.pl, 2)
        CadAppPick.wx = Float_Add(CadAppPick.ox, Float_Add(Float_Mul(wx, ArrayGet(CadAppPick.pl, 3)), Float_Mul(wy, ArrayGet(CadAppPick.pl, 6))))
        CadAppPick.wy = Float_Add(CadAppPick.oy, Float_Add(Float_Mul(wx, ArrayGet(CadAppPick.pl, 4)), Float_Mul(wy, ArrayGet(CadAppPick.pl, 7))))
        CadAppPick.wz = Float_Add(CadAppPick.oz, Float_Add(Float_Mul(wx, ArrayGet(CadAppPick.pl, 5)), Float_Mul(wy, ArrayGet(CadAppPick.pl, 8))))
        CA_BuildViewFrame(CadAppPick.fr)
        IfCondition EqualTo(CadAppPick.pr, 0) ThenBlock: { CadAppPick.pr = Allocate(32) }
        IfCondition EqualTo(CadAppPick.pr, 0) ThenBlock: { ReturnValue(-1) }
        CAD_View.ProjectPoint(CadAppPick.wx, CadAppPick.wy, CadAppPick.wz, CadAppPick.fr, CadAppPick.pr)
        ix = Float_ToInt(ArrayGet(CadAppPick.pr, 0))
        iy = Float_ToInt(ArrayGet(CadAppPick.pr, 1))
        IfCondition LessThan(ix, -10000) ThenBlock: { ix = -10000 }
        IfCondition GreaterThan(ix, 10000) ThenBlock: { ix = 10000 }
        IfCondition LessThan(iy, -10000) ThenBlock: { iy = -10000 }
        IfCondition GreaterThan(iy, 10000) ThenBlock: { iy = 10000 }
        ArraySet(out_xy, 0, ix)
        ArraySet(out_xy, 1, iy)
        ReturnValue(0)
    }
}

// pixel → world XY (top view, Y up)


// pixel → world XY (top view, Y up)
Function.CA_PixToWorld {
    Input: px: Integer
    Input: py: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_SketchInContext(), 1) ThenBlock: {
            rc = CA_PixToSketchUV(px, py, out_xy)
            IfCondition NotEqual(rc, 0) ThenBlock: {
                ArraySet(out_xy, 0, 0)
                ArraySet(out_xy, 1, 0)
            }
            ReturnValue(rc)
        }
        CA_UpdateSketchCam()
        hw = Float_Div(Float_FromInt(CadApp.width), 0x4000000000000000)
        hh = Float_Div(Float_FromInt(CadApp.height_px), 0x4000000000000000)
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
            sc = 0x3FF0000000000000
        }
        // screen → world around pan center
        wx = Float_Add(CadApp.sk_pan_x, Float_Div(Float_Sub(Float_FromInt(px), hw), sc))
        wy = Float_Add(CadApp.sk_pan_y, Float_Div(Float_Sub(hh, Float_FromInt(py)), sc))
        ArraySet(out_xy, 0, wx)
        ArraySet(out_xy, 1, wy)
        ReturnValue(0)
    }
}


Function.CA_WorldToPix {
    Input: wx: Integer
    Input: wy: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_SketchInContext(), 1) ThenBlock: {
            ReturnValue(CA_UvToPix3(wx, wy, out_xy))
        }
        CA_UpdateSketchCam()
        hw = Float_Div(Float_FromInt(CadApp.width), 0x4000000000000000)
        hh = Float_Div(Float_FromInt(CadApp.height_px), 0x4000000000000000)
        sc = CadApp.scale
        sx = Float_Add(hw, Float_Mul(Float_Sub(wx, CadApp.sk_pan_x), sc))
        sy = Float_Sub(hh, Float_Mul(Float_Sub(wy, CadApp.sk_pan_y), sc))
        ix = Float_ToInt(sx)
        iy = Float_ToInt(sy)
        // Clamp so FB_Line never sees billion-pixel endpoints (freezes sketcher)
        IfCondition LessThan(ix, -10000) ThenBlock: { ix = -10000 }
        IfCondition GreaterThan(ix, 10000) ThenBlock: { ix = 10000 }
        IfCondition LessThan(iy, -10000) ThenBlock: { iy = -10000 }
        IfCondition GreaterThan(iy, 10000) ThenBlock: { iy = 10000 }
        ArraySet(out_xy, 0, ix)
        ArraySet(out_xy, 1, iy)
        ReturnValue(0)
    }
}

// Scanline fill of closed polygon in PIXEL coords (x,y pairs).


// Scanline fill of closed polygon in PIXEL coords (x,y pairs).
Function.CA_FillPolyPx {
    Input: pxy: Address
    Input: n: Integer
    Input: col: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        ymin = ArrayGet(pxy, 1)
        ymax = ymin
        i = 0
        WhileLoop LessThan(i, n) {
            y = ArrayGet(pxy, Add(Multiply(i, 2), 1))
            IfCondition LessThan(y, ymin) ThenBlock: { ymin = y }
            IfCondition GreaterThan(y, ymax) ThenBlock: { ymax = y }
            i = Add(i, 1)
        }
        IfCondition LessThan(ymin, 0) ThenBlock: { ymin = 0 }
        IfCondition GreaterThan(ymax, CadApp.height_px) ThenBlock: { ymax = CadApp.height_px }
        xs = Allocate(2048)
        y = ymin
        WhileLoop LessThan(y, ymax) {
            nx = 0
            i = 0
            WhileLoop LessThan(i, n) {
                j = Add(i, 1)
                IfCondition EqualTo(j, n) ThenBlock: { j = 0 }
                y0 = ArrayGet(pxy, Add(Multiply(i, 2), 1))
                y1 = ArrayGet(pxy, Add(Multiply(j, 2), 1))
                x0 = ArrayGet(pxy, Multiply(i, 2))
                x1 = ArrayGet(pxy, Multiply(j, 2))
                a = 0
                b = 0
                IfCondition LessThan(y0, y) ThenBlock: { a = 1 }
                IfCondition LessThan(y1, y) ThenBlock: { b = 1 }
                IfCondition NotEqual(a, b) ThenBlock: {
                    den = Subtract(y1, y0)
                    IfCondition NotEqual(den, 0) ThenBlock: {
                        num = Multiply(Subtract(y, y0), Subtract(x1, x0))
                        xi = Add(x0, Divide(num, den))
                        IfCondition LessThan(nx, 256) ThenBlock: {
                            ArraySet(xs, nx, xi)
                            nx = Add(nx, 1)
                        }
                    }
                }
                i = Add(i, 1)
            }
            a = 0
            WhileLoop LessThan(a, nx) {
                b = Add(a, 1)
                WhileLoop LessThan(b, nx) {
                    IfCondition GreaterThan(ArrayGet(xs, a), ArrayGet(xs, b)) ThenBlock: {
                        t = ArrayGet(xs, a)
                        ArraySet(xs, a, ArrayGet(xs, b))
                        ArraySet(xs, b, t)
                    }
                    b = Add(b, 1)
                }
                a = Add(a, 1)
            }
            p = 0
            WhileLoop LessThan(p, nx) {
                IfCondition LessThan(Add(p, 1), nx) ThenBlock: {
                    FB_HLine(ArrayGet(xs, p), ArrayGet(xs, Add(p, 1)), y, col)
                }
                p = Add(p, 2)
            }
            y = Add(y, 1)
        }
        Deallocate(xs, 2048)
        ReturnValue(1)
    }
}


Function.CA_DrawSketchToFB {
    Output: Integer
    Body: {
        CA_Log("cad_app: draw2d enter\n", 22)
        w = CadApp.width
        h = CadApp.height_px
        need = 0
        IfCondition EqualTo(FB.initialized, 0) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.width, w) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.height, h) ThenBlock: { need = 1 }
        IfCondition EqualTo(need, 1) ThenBlock: {
            IfCondition EqualTo(FB_InitHeadless(w, h), 0) ThenBlock: { ReturnValue(-1) }
        }
        ctx = CA_SketchInContext()
        // Never wipe a live solid. Empty 2D pad only when there is no body.
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            IfCondition EqualTo(ctx, 0) ThenBlock: {
                FB_Clear(FB_RGB(24, 28, 36))
            }
        }
        // Sketch_0 datum: full axes + origin glyph (immutable O / +X / +Y)
        CA_UpdateSketchCam()
        IfCondition EqualTo(CadAppPrev.pt, 0) ThenBlock: { CadAppPrev.pt = Allocate(32) }
        pt = CadAppPrev.pt
        IfCondition EqualTo(pt, 0) ThenBlock: { ReturnValue(-1) }
        CA_WorldToPix(0, 0, pt)
        ox = ArrayGet(pt, 0)
        oy = ArrayGet(pt, 1)
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            IfCondition EqualTo(ctx, 0) ThenBlock: {
                FB_Line(0, oy, w, oy, FB_RGB(70, 90, 120))
                FB_Line(ox, 0, ox, h, FB_RGB(70, 90, 120))
            }
        }
        // thicker ticks near O so datum reads as "from zero"
        CA_WorldToPix(0x4024000000000000, 0, pt)
        tx = ArrayGet(pt, 0)
        ty = ArrayGet(pt, 1)
        FB_Line(ox, oy, tx, ty, FB_RGB(120, 180, 255))
        FB_DrawString(Add(tx, 4), Subtract(ty, 4), "X", FB_RGB(120, 180, 255), -1)
        CA_WorldToPix(0, 0x4024000000000000, pt)
        tx = ArrayGet(pt, 0)
        ty = ArrayGet(pt, 1)
        FB_Line(ox, oy, tx, ty, FB_RGB(120, 255, 160))
        FB_DrawString(Add(tx, 4), Subtract(ty, 4), "Y", FB_RGB(120, 255, 160), -1)
        // Z = plane normal / pad (ISO 841). In-context only — 2D pad has no depth.
        IfCondition EqualTo(ctx, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.plane, 0) ThenBlock: {
                CA_PickBufs()
                IfCondition EqualTo(CadAppPick.hit, 0) ThenBlock: { CadAppPick.hit = Allocate(32) }
                CAD_Plane.MapLocal(CadApp.plane, 0, 0, 0x4024000000000000, CadAppPick.hit)
                CA_BuildViewFrame(CadAppPick.fr)
                CA_World3ToPix(ArrayGet(CadAppPick.hit, 0), ArrayGet(CadAppPick.hit, 1), ArrayGet(CadAppPick.hit, 2), CadAppPick.fr, pt)
                FB_Line(ox, oy, ArrayGet(pt, 0), ArrayGet(pt, 1), FB_RGB(255, 110, 110))
                FB_DrawString(Add(ArrayGet(pt, 0), 4), Subtract(ArrayGet(pt, 1), 4), "Z", FB_RGB(255, 110, 110), -1)
            }
        }
        // origin marker (also in-context — WorldToPix maps via plane)
        FB_FillRect(Subtract(ox, 4), Subtract(oy, 4), 9, 9, FB_RGB(255, 220, 80))
        FB_FillRect(Subtract(ox, 2), Subtract(oy, 2), 5, 5, FB_RGB(40, 40, 50))
        // user Points always (face-ref gold, typed/user magenta) — in-context too
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            nup = CAD_Sketch.GetUserPointCount(CadApp.sketch)
            nref = CAD_Store.Read(CadApp.sketch, 27)
            CadApp.n_face_ref = nref
            IfCondition GreaterThan(nup, 0) ThenBlock: {
                upxy = Allocate(32)
                ui = 0
                WhileLoop LessThan(ui, nup) {
                    CAD_Sketch.GetUserPoint(CadApp.sketch, ui, upxy)
                    CA_WorldToPix(ArrayGet(upxy, 0), ArrayGet(upxy, 1), pt)
                    ux = ArrayGet(pt, 0)
                    uy = ArrayGet(pt, 1)
                    pc = FB_RGB(255, 80, 220)
                    IfCondition LessThan(ui, nref) ThenBlock: {
                        pc = FB_RGB(255, 210, 60)
                    }
                    FB_Line(Subtract(ux, 5), uy, Add(ux, 5), uy, pc)
                    FB_Line(ux, Subtract(uy, 5), ux, Add(uy, 5), pc)
                    FB_FillRect(Subtract(ux, 2), Subtract(uy, 2), 5, 5, pc)
                    ui = Add(ui, 1)
                }
                Deallocate(upxy, 32)
            }
        }
        // Projected face edges (dashed). Toggle: proj
        IfCondition EqualTo(CadApp.show_proj, 1) ThenBlock: {
            IfCondition GreaterThan(CadApp.proj_n, 1) ThenBlock: {
                IfCondition NotEqual(CadApp.proj_xy, 0) ThenBlock: {
                    pi = 0
                    WhileLoop LessThan(pi, CadApp.proj_n) {
                        nj = Add(pi, 1)
                        IfCondition EqualTo(nj, CadApp.proj_n) ThenBlock: { nj = 0 }
                        CA_WorldToPix(ArrayGet(CadApp.proj_xy, Multiply(pi, 2)), ArrayGet(CadApp.proj_xy, Add(Multiply(pi, 2), 1)), pt)
                        xa = ArrayGet(pt, 0)
                        ya = ArrayGet(pt, 1)
                        CA_WorldToPix(ArrayGet(CadApp.proj_xy, Multiply(nj, 2)), ArrayGet(CadApp.proj_xy, Add(Multiply(nj, 2), 1)), pt)
                        CA_LineDash(xa, ya, ArrayGet(pt, 0), ArrayGet(pt, 1), FB_RGB(255, 200, 70))
                        pi = Add(pi, 1)
                    }
                }
            }
        }
        // lines
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
          IfCondition EqualTo(ctx, 0) ThenBlock: {
            CAD_Sketch.EnsureDatum(CadApp.sketch)
            CA_Log("cad_app: draw2d after datum\n", 28)
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            lines = CAD_Store.Read(CadApp.sketch, 1)
            i = 0
            WhileLoop LessThan(i, nl) {
                b = Multiply(i, 4)
                CA_WorldToPix(ArrayGet(lines, b), ArrayGet(lines, Add(b, 1)), pt)
                x0 = ArrayGet(pt, 0)
                y0 = ArrayGet(pt, 1)
                CA_WorldToPix(ArrayGet(lines, Add(b, 2)), ArrayGet(lines, Add(b, 3)), pt)
                x1 = ArrayGet(pt, 0)
                y1 = ArrayGet(pt, 1)
                col = FB_RGB(100, 220, 255)
                IfCondition EqualTo(CadApp.tool, 11) ThenBlock: {
                    col = FB_RGB(255, 180, 40)
                }
                IfCondition EqualTo(CadAppRev.ok, 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(ArrayGet(lines, b), CadAppRev.x0, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(ArrayGet(lines, Add(b, 1)), CadAppRev.y0, 0), 1) ThenBlock: {
                            col = FB_RGB(255, 240, 40)
                        }
                    }
                }
                FB_Line(x0, y0, x1, y1, col)
                IfCondition EqualTo(CadApp.tool, 11) ThenBlock: {
                    FB_Line(Add(x0, 1), y0, Add(x1, 1), y1, col)
                    FB_Line(x0, Add(y0, 1), x1, Add(y1, 1), col)
                }
                i = Add(i, 1)
            }
            // circles: display-only smooth ring (entity stays a true circle — no anchors)
            nc = CAD_Sketch.GetCircleCount(CadApp.sketch)
            circs = CAD_Store.Read(CadApp.sketch, 8)
            two_pi = 0x401921FB54442D18
            ci = 0
            WhileLoop LessThan(ci, nc) {
                base = Multiply(ci, 3)
                cx = ArrayGet(circs, base)
                cy = ArrayGet(circs, Add(base, 1))
                rad = ArrayGet(circs, Add(base, 2))
                k = 0
                WhileLoop LessThan(k, 64) {
                    a0 = Float_Mul(two_pi, Float_Div(Float_FromInt(k), Float_FromInt(64)))
                    a1 = Float_Mul(two_pi, Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(64)))
                    CA_WorldToPix(Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a0))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a0))), pt)
                    x0 = ArrayGet(pt, 0)
                    y0 = ArrayGet(pt, 1)
                    CA_WorldToPix(Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a1))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a1))), pt)
                    x1 = ArrayGet(pt, 0)
                    y1 = ArrayGet(pt, 1)
                    FB_Line(x0, y0, x1, y1, FB_RGB(255, 200, 80))
                    k = Add(k, 1)
                }
                ci = Add(ci, 1)
            }
            // arcs as tess preview (if any stored) — UNDER profile rings
            na = CAD_Sketch.GetArcCount(CadApp.sketch)
            IfCondition GreaterThan(na, 0) ThenBlock: {
                arcs = CAD_Store.Read(CadApp.sketch, 11)
                two_pi = 0x401921FB54442D18
                ai = 0
                WhileLoop LessThan(ai, na) {
                    base = Multiply(ai, 5)
                    cx = ArrayGet(arcs, base)
                    cy = ArrayGet(arcs, Add(base, 1))
                    rad = ArrayGet(arcs, Add(base, 2))
                    a0 = ArrayGet(arcs, Add(base, 3))
                    a1 = ArrayGet(arcs, Add(base, 4))
                    span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
                    // display-only tess (entity is still a true arc)
                    nseg = Float_ToInt(Float_Div(Float_Mul(Float_FromInt(48), span), two_pi))
                    IfCondition LessThan(nseg, 8) ThenBlock: { nseg = 8 }
                    IfCondition GreaterThan(nseg, 64) ThenBlock: { nseg = 64 }
                    k = 0
                    WhileLoop LessThan(k, nseg) {
                        t0 = Float_Div(Float_FromInt(k), Float_FromInt(nseg))
                        t1 = Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(nseg))
                        ang0 = Float_Add(a0, Float_Mul(span, t0))
                        ang1 = Float_Add(a0, Float_Mul(span, t1))
                        CA_WorldToPix(Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang0))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang0))), pt)
                        x0 = ArrayGet(pt, 0)
                        y0 = ArrayGet(pt, 1)
                        CA_WorldToPix(Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang1))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang1))), pt)
                        x1 = ArrayGet(pt, 0)
                        y1 = ArrayGet(pt, 1)
                        FB_Line(x0, y0, x1, y1, FB_RGB(200, 140, 255))
                        k = Add(k, 1)
                    }
                    ai = Add(ai, 1)
                }
            }
            // junction anchors ON TOP of curves (ends / crosses / T-touches)
            npt = CAD_Sketch.GetPointCount(CadApp.sketch)
            pts = CAD_Store.Read(CadApp.sketch, 17)
            IfCondition NotEqual(pts, 0) ThenBlock: {
                i = 0
                WhileLoop LessThan(i, npt) {
                    CA_WorldToPix(ArrayGet(pts, Multiply(i, 2)), ArrayGet(pts, Add(Multiply(i, 2), 1)), pt)
                    x0 = ArrayGet(pt, 0)
                    y0 = ArrayGet(pt, 1)
                    FB_FillRect(Subtract(x0, 3), Subtract(y0, 3), 7, 7, FB_RGB(255, 120, 80))
                    i = Add(i, 1)
                }
            }
            }
            // profiles LAST (also in-context — WorldToPix maps via the face):
            //   available (not selected) = light red outline
            //   selected = bright red fill + bright red thick edge
            //   nested selected hole inside selected outer = dark void punch
            CA_Log("cad_app: draw2d after geom\n", 27)
            nprof = CAD_Store.Read(CadApp.sketch, 12)
            CA_LogInt("cad_app: draw2d nprof=", 22, nprof)
            IfCondition GreaterThan(nprof, 0) ThenBlock: {
                pi = 0
                xy = Allocate(65536)
                pxy = Allocate(65536)
                oxy = Allocate(65536)
                // light red = available faces (no auto-pick)
                avail_col = FB_RGB(200, 90, 90)
                // bright red = user-selected
                sel_col = FB_RGB(255, 30, 30)
                fill_col = FB_RGB(200, 40, 45)
                void_col = FB_RGB(24, 28, 36)
                // find largest selected as outer for void punch
                outer_i = -1
                outer_a = 0
                outer_nn = 0
                IfCondition EqualTo(CadApp.prof_user, 1) ThenBlock: {
                    pi = 0
                    WhileLoop LessThan(pi, nprof) {
                        bit = LeftShift(1, pi)
                        sel = 0
                        IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: { sel = 1 }
                        IfCondition EqualTo(sel, 1) ThenBlock: {
                            nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                            IfCondition GreaterEqual(nn, 3) ThenBlock: {
                                ar = CAD_Sketch.LoopSignedArea(xy, nn)
                                IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                                better = 0
                                IfCondition EqualTo(outer_i, -1) ThenBlock: { better = 1 }
                                IfCondition EqualTo(Float_Le(outer_a, ar), 1) ThenBlock: {
                                    IfCondition NotEqual(pi, outer_i) ThenBlock: { better = 1 }
                                }
                                IfCondition EqualTo(better, 1) ThenBlock: {
                                    outer_i = pi
                                    outer_a = ar
                                    outer_nn = nn
                                    k = 0
                                    WhileLoop LessThan(k, nn) {
                                        ArraySet(oxy, Multiply(k, 2), ArrayGet(xy, Multiply(k, 2)))
                                        ArraySet(oxy, Add(Multiply(k, 2), 1), ArrayGet(xy, Add(Multiply(k, 2), 1)))
                                        k = Add(k, 1)
                                    }
                                }
                            }
                        }
                        pi = Add(pi, 1)
                    }
                }
                // pass 1a: light-red FILL for ALL available faces (so they read as selectable)
                avail_fill = FB_RGB(110, 48, 52)
                pi = 0
                WhileLoop LessThan(pi, nprof) {
                    nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                    IfCondition GreaterEqual(nn, 3) ThenBlock: {
                        k = 0
                        WhileLoop LessThan(k, nn) {
                            CA_WorldToPix(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), pt)
                            ArraySet(pxy, Multiply(k, 2), ArrayGet(pt, 0))
                            ArraySet(pxy, Add(Multiply(k, 2), 1), ArrayGet(pt, 1))
                            k = Add(k, 1)
                        }
                        CA_FillPolyPx(pxy, nn, avail_fill)
                    }
                    pi = Add(pi, 1)
                }
                // pass 1b: bright fill for SELECTED faces, then punch nested voids
                IfCondition EqualTo(CadApp.prof_user, 1) ThenBlock: {
                    pi = 0
                    WhileLoop LessThan(pi, nprof) {
                        IfCondition LessThan(pi, 32) ThenBlock: {
                            bit = LeftShift(1, pi)
                            sel = 0
                            IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: { sel = 1 }
                            IfCondition EqualTo(sel, 1) ThenBlock: {
                                nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                                IfCondition GreaterEqual(nn, 3) ThenBlock: {
                                    k = 0
                                    WhileLoop LessThan(k, nn) {
                                        CA_WorldToPix(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), pt)
                                        ArraySet(pxy, Multiply(k, 2), ArrayGet(pt, 0))
                                        ArraySet(pxy, Add(Multiply(k, 2), 1), ArrayGet(pt, 1))
                                        k = Add(k, 1)
                                    }
                                    CA_FillPolyPx(pxy, nn, fill_col)
                                }
                            }
                        }
                        pi = Add(pi, 1)
                    }
                }
                // Nested closed chain sits ON TOP of its parent (own ID).
                // Paint smaller rings last so the octagon is not swallowed by the square.
                pi = 0
                WhileLoop LessThan(pi, nprof) {
                    nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                    IfCondition GreaterEqual(nn, 3) ThenBlock: {
                        sx = 0
                        sy = 0
                        k = 0
                        WhileLoop LessThan(k, nn) {
                            sx = Float_Add(sx, ArrayGet(xy, Multiply(k, 2)))
                            sy = Float_Add(sy, ArrayGet(xy, Add(Multiply(k, 2), 1)))
                            k = Add(k, 1)
                        }
                        invn = Float_Div(0x3FF0000000000000, Float_FromInt(nn))
                        cx = Float_Mul(sx, invn)
                        cy = Float_Mul(sy, invn)
                        nested = 0
                        pj = 0
                        WhileLoop LessThan(pj, nprof) {
                            IfCondition NotEqual(pj, pi) ThenBlock: {
                                n2 = CAD_Sketch.GetProfileXY(CadApp.sketch, pj, oxy)
                                IfCondition GreaterEqual(n2, 3) ThenBlock: {
                                    IfCondition EqualTo(CA_PointInPoly(cx, cy, oxy, n2), 1) ThenBlock: {
                                        a1 = CAD_Sketch.LoopSignedArea(xy, nn)
                                        a2 = CAD_Sketch.LoopSignedArea(oxy, n2)
                                        IfCondition EqualTo(Float_Le(a1, 0), 1) ThenBlock: { a1 = Float_Sub(0, a1) }
                                        IfCondition EqualTo(Float_Le(a2, 0), 1) ThenBlock: { a2 = Float_Sub(0, a2) }
                                        IfCondition EqualTo(Float_Le(a1, a2), 1) ThenBlock: { nested = 1 }
                                    }
                                }
                            }
                            pj = Add(pj, 1)
                        }
                        IfCondition EqualTo(nested, 1) ThenBlock: {
                            k = 0
                            WhileLoop LessThan(k, nn) {
                                CA_WorldToPix(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), pt)
                                ArraySet(pxy, Multiply(k, 2), ArrayGet(pt, 0))
                                ArraySet(pxy, Add(Multiply(k, 2), 1), ArrayGet(pt, 1))
                                k = Add(k, 1)
                            }
                            ncol = avail_fill
                            bit = LeftShift(1, pi)
                            IfCondition EqualTo(CadApp.prof_user, 1) ThenBlock: {
                                IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: {
                                    ncol = fill_col
                                }
                            }
                            CA_FillPolyPx(pxy, nn, ncol)
                        }
                    }
                    pi = Add(pi, 1)
                }
                // pass 2: outlines — light red available, bright red selected
                pi = 0
                WhileLoop LessThan(pi, nprof) {
                    nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                    col = avail_col
                    thick = 1
                    selected = 0
                    IfCondition EqualTo(CadApp.prof_user, 1) ThenBlock: {
                        bit = LeftShift(1, pi)
                        IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: {
                            selected = 1
                        }
                    }
                    IfCondition EqualTo(selected, 1) ThenBlock: {
                        col = sel_col
                        thick = 2
                    }
                    IfCondition GreaterEqual(nn, 3) ThenBlock: {
                        k = 0
                        WhileLoop LessThan(k, nn) {
                            k2 = Add(k, 1)
                            IfCondition EqualTo(k2, nn) ThenBlock: { k2 = 0 }
                            CA_WorldToPix(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), pt)
                            x0 = ArrayGet(pt, 0)
                            y0 = ArrayGet(pt, 1)
                            CA_WorldToPix(ArrayGet(xy, Multiply(k2, 2)), ArrayGet(xy, Add(Multiply(k2, 2), 1)), pt)
                            x1 = ArrayGet(pt, 0)
                            y1 = ArrayGet(pt, 1)
                            FB_Line(x0, y0, x1, y1, col)
                            IfCondition GreaterThan(thick, 1) ThenBlock: {
                                FB_Line(Add(x0, 1), y0, Add(x1, 1), y1, col)
                                FB_Line(x0, Add(y0, 1), x1, Add(y1, 1), col)
                            }
                            k = Add(k, 1)
                        }
                    }
                    pi = Add(pi, 1)
                }
                Deallocate(xy, 65536)
                Deallocate(pxy, 65536)
                Deallocate(oxy, 65536)
            }
        }
        // rubber-band / drag preview for any in-progress tool
        IfCondition GreaterThan(CadApp.nclick, 0) ThenBlock: {
            CA_WorldToPix(CadApp.cx0, CadApp.cy0, pt)
            x0 = ArrayGet(pt, 0)
            y0 = ArrayGet(pt, 1)
            FB_FillRect(Subtract(x0, 3), Subtract(y0, 3), 7, 7, FB_RGB(255, 80, 80))
            IfCondition EqualTo(CadApp.hover_ok, 1) ThenBlock: {
                x1 = CadApp.hover_px
                y1 = CadApp.hover_py
                xy = Allocate(32)
                CA_PixToWorld(x1, y1, xy)
                hx = ArrayGet(xy, 0)
                hy = ArrayGet(xy, 1)
                Deallocate(xy, 32)
                two_pi = 0x401921FB54442D18
                // LINE + live length / angle (shared vertex or origin)
                IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
                    FB_Line(x0, y0, x1, y1, FB_RGB(255, 120, 160))
                    CA_DrawLineAngleLive(hx, hy, x0, y0, x1, y1)
                }
                // RECT
                IfCondition EqualTo(CadApp.tool, 1) ThenBlock: {
                    FB_Line(x0, y0, x1, y0, FB_RGB(255, 120, 160))
                    FB_Line(x1, y0, x1, y1, FB_RGB(255, 120, 160))
                    FB_Line(x1, y1, x0, y1, FB_RGB(255, 120, 160))
                    FB_Line(x0, y1, x0, y0, FB_RGB(255, 120, 160))
                }
                // CIRCLE: drag radius from center (nclick==1)
                IfCondition EqualTo(CadApp.tool, 2) ThenBlock: {
                    CA_DrawCircPreview(hx, hy)
                    FB_Line(x0, y0, x1, y1, FB_RGB(255, 160, 40))
                }
                // ARC nclick=1: drag radius (full circle ghost + spoke)
                IfCondition EqualTo(CadApp.tool, 3) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                        dx = Float_Sub(hx, CadApp.cx0)
                        dy = Float_Sub(hy, CadApp.cy0)
                        rad = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                        k = 0
                        WhileLoop LessThan(k, 32) {
                            a0 = Float_Mul(two_pi, Float_Div(Float_FromInt(k), Float_FromInt(32)))
                            a1 = Float_Mul(two_pi, Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(32)))
                            CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(a0))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(a0))), pt)
                            xa = ArrayGet(pt, 0)
                            ya = ArrayGet(pt, 1)
                            CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(a1))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(a1))), pt)
                            xb = ArrayGet(pt, 0)
                            yb = ArrayGet(pt, 1)
                            FB_Line(xa, ya, xb, yb, FB_RGB(180, 120, 255))
                            k = Add(k, 1)
                        }
                        FB_Line(x0, y0, x1, y1, FB_RGB(220, 160, 255))
                    }
                    // ARC nclick=2: radius fixed, drag end angle
                    IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: {
                        rad = CadApp.arc_rad
                        a0 = CadApp.arc_a0
                        a1 = CAD_Geom.Atan2(Float_Sub(hy, CadApp.cy0), Float_Sub(hx, CadApp.cx0))
                        span = Float_Sub(a1, a0)
                        IfCondition EqualTo(Float_Le(span, 0), 1) ThenBlock: {
                            span = Float_Add(span, two_pi)
                        }
                        nseg = 24
                        k = 0
                        WhileLoop LessThan(k, nseg) {
                            t0 = Float_Div(Float_FromInt(k), Float_FromInt(nseg))
                            t1 = Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(nseg))
                            ang0 = Float_Add(a0, Float_Mul(span, t0))
                            ang1 = Float_Add(a0, Float_Mul(span, t1))
                            CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(ang0))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(ang0))), pt)
                            xa = ArrayGet(pt, 0)
                            ya = ArrayGet(pt, 1)
                            CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(ang1))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(ang1))), pt)
                            xb = ArrayGet(pt, 0)
                            yb = ArrayGet(pt, 1)
                            FB_Line(xa, ya, xb, yb, FB_RGB(255, 120, 255))
                            k = Add(k, 1)
                        }
                        // spokes to start and hover end
                        CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(a0))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(a0))), pt)
                        FB_Line(x0, y0, ArrayGet(pt, 0), ArrayGet(pt, 1), FB_RGB(200, 100, 220))
                        FB_Line(x0, y0, x1, y1, FB_RGB(200, 100, 220))
                    }
                }
                // ARC3 preview — own function (locals isolation)
                IfCondition EqualTo(CadApp.tool, 9) ThenBlock: {
                    CA_DrawArc3Preview(hx, hy)
                }
                IfCondition GreaterEqual(CadApp.tool, 12) ThenBlock: {
                    CA_DrawConstructPreview(hx, hy)
                }
            }
            // ARC3: even without host hover yet, show start (and through if pick2)
            IfCondition EqualTo(CadApp.hover_ok, 0) ThenBlock: {
                IfCondition EqualTo(CadApp.tool, 9) ThenBlock: {
                    CA_DrawArc3Preview(CadApp.cx0, CadApp.cy0)
                }
            }
        }
        IfCondition EqualTo(CadApp.tool, 17) ThenBlock: {
            CA_DrawPolyHud()
        }
        CA_Log("cad_app: draw2d ok\n", 19)
        ReturnValue(0)
    }
}

// Live angle/length while placing a line (nclick=1).
// hx,hy world hover; x0,y0,x1,y1 pixel ends of rubber-band.
// Reference: shared existing line at start → relative angle;
//            start at origin → from +X; else absolute from +X.


// Live angle/length while placing a line (nclick=1).
// hx,hy world hover; x0,y0,x1,y1 pixel ends of rubber-band.
// Reference: shared existing line at start → relative angle;
//            start at origin → from +X; else absolute from +X.
Function.CA_DrawLineAngleLive {
    Input: hx: Integer
    Input: hy: Integer
    Input: px0: Integer
    Input: py0: Integer
    Input: px1: Integer
    Input: py1: Integer
    Output: Integer
    Body: {
        dx = Float_Sub(hx, CadApp.cx0)
        dy = Float_Sub(hy, CadApp.cy0)
        len2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        IfCondition EqualTo(CAD_Num.IsZero(len2, 0), 1) ThenBlock: {
            CadApp.live_ang = -1
            CadApp.live_len = 0
            ReturnValue(0)
        }
        len = CAD_Num.Sqrt(len2)
        CadApp.live_len = Float_ToInt(len)
        // new line absolute angle from +X
        ang_new = CAD_Geom.Atan2(dy, dx)
        // find shared-endpoint line for relative angle
        ref_ok = 0
        rx = 0
        ry = 0
        CA_UpdateSketchCam()
        sc = CadApp.scale
        snap = Float_Div(Float_FromInt(8), sc)
        snap2 = Float_Mul(snap, snap)
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            lines = CAD_Store.Read(CadApp.sketch, 1)
            i = 0
            WhileLoop LessThan(i, nl) {
                b = Multiply(i, 4)
                ax = ArrayGet(lines, b)
                ay = ArrayGet(lines, Add(b, 1))
                bx = ArrayGet(lines, Add(b, 2))
                by = ArrayGet(lines, Add(b, 3))
                dax = Float_Sub(ax, CadApp.cx0)
                day = Float_Sub(ay, CadApp.cy0)
                da2 = Float_Add(Float_Mul(dax, dax), Float_Mul(day, day))
                dbx = Float_Sub(bx, CadApp.cx0)
                dby = Float_Sub(by, CadApp.cy0)
                db2 = Float_Add(Float_Mul(dbx, dbx), Float_Mul(dby, dby))
                // start coincides with A → ref dir A←B (from shared along line)
                IfCondition EqualTo(Float_Le(da2, snap2), 1) ThenBlock: {
                    rx = Float_Sub(bx, ax)
                    ry = Float_Sub(by, ay)
                    ref_ok = 1
                }
                // start coincides with B
                IfCondition EqualTo(Float_Le(db2, snap2), 1) ThenBlock: {
                    rx = Float_Sub(ax, bx)
                    ry = Float_Sub(ay, by)
                    ref_ok = 1
                }
                i = Add(i, 1)
            }
        }
        // origin start?
        ox = CadApp.cx0
        oy = CadApp.cy0
        at_o = 0
        IfCondition EqualTo(CAD_Num.IsZero(ox, 0), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(oy, 0), 1) ThenBlock: {
                at_o = 1
            }
        }
        // if near origin within snap
        IfCondition EqualTo(at_o, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                d0 = Float_Add(Float_Mul(ox, ox), Float_Mul(oy, oy))
                IfCondition EqualTo(Float_Le(d0, snap2), 1) ThenBlock: {
                    at_o = 1
                }
            }
        }
        ang_show = ang_new
        CadApp.live_aref = 0
        IfCondition EqualTo(ref_ok, 1) ThenBlock: {
            ang_ref = CAD_Geom.Atan2(ry, rx)
            dang = Float_Sub(ang_new, ang_ref)
            // normalize to (-pi, pi]
            pi = 0x400921FB54442D18
            two_pi = 0x401921FB54442D18
            WhileLoop EqualTo(Float_Le(pi, dang), 1) {
                dang = Float_Sub(dang, two_pi)
            }
            WhileLoop EqualTo(Float_Le(dang, Float_Sub(0, pi)), 1) {
                dang = Float_Add(dang, two_pi)
            }
            // display absolute value 0..180
            IfCondition EqualTo(Float_Le(dang, 0), 1) ThenBlock: {
                dang = Float_Sub(0, dang)
            }
            ang_show = dang
            CadApp.live_aref = 1
        }
        IfCondition EqualTo(ref_ok, 0) ThenBlock: {
            IfCondition EqualTo(at_o, 1) ThenBlock: {
                // from +X through origin
                IfCondition EqualTo(Float_Le(ang_show, 0), 1) ThenBlock: {
                    // keep signed? show 0..360 style as 0..180 abs from +X for HUD
                    // use absolute polar 0..360 mapped to nearest display
                    IfCondition EqualTo(Float_Le(ang_show, 0), 1) ThenBlock: {
                        ang_show = Float_Sub(0, ang_show)
                    }
                }
                CadApp.live_aref = 2
            }
            IfCondition EqualTo(at_o, 0) ThenBlock: {
                // free absolute: 0..180 from +X magnitude for readability
                IfCondition EqualTo(Float_Le(ang_show, 0), 1) ThenBlock: {
                    ang_show = Float_Sub(0, ang_show)
                }
                CadApp.live_aref = 0
            }
        }
        // radians → degrees integer
        rad2deg = 0x404CA5DC1A63C1F8
        degf = Float_Mul(ang_show, rad2deg)
        deg = Float_ToInt(degf)
        // round-ish: if frac would help, leave int
        IfCondition LessThan(deg, 0) ThenBlock: { deg = Subtract(0, deg) }
        IfCondition GreaterThan(deg, 180) ThenBlock: {
            deg = Subtract(360, deg)
            IfCondition LessThan(deg, 0) ThenBlock: { deg = Subtract(0, deg) }
        }
        CadApp.live_ang = deg
        // --- draw: small arc wedge at start + text near mid ---
        // reference arm (pixel): short stub along ref or +X
        stub = 28
        IfCondition EqualTo(ref_ok, 1) ThenBlock: {
            rl2 = Float_Add(Float_Mul(rx, rx), Float_Mul(ry, ry))
            IfCondition EqualTo(CAD_Num.IsZero(rl2, 0), 0) ThenBlock: {
                rl = CAD_Num.Sqrt(rl2)
                rux = Float_Div(rx, rl)
                ruy = Float_Div(ry, rl)
                // world stub then to pix
                wxr = Float_Add(CadApp.cx0, Float_Mul(rux, Float_FromInt(12)))
                wyr = Float_Add(CadApp.cy0, Float_Mul(ruy, Float_FromInt(12)))
                ptx = Allocate(32)
                CA_WorldToPix(wxr, wyr, ptx)
                FB_Line(px0, py0, ArrayGet(ptx, 0), ArrayGet(ptx, 1), FB_RGB(120, 200, 255))
                Deallocate(ptx, 32)
            }
        }
        IfCondition EqualTo(ref_ok, 0) ThenBlock: {
            // +X stub
            wxr = Float_Add(CadApp.cx0, Float_FromInt(12))
            ptx = Allocate(32)
            CA_WorldToPix(wxr, CadApp.cy0, ptx)
            FB_Line(px0, py0, ArrayGet(ptx, 0), ArrayGet(ptx, 1), FB_RGB(120, 200, 255))
            Deallocate(ptx, 32)
        }
        // arc samples between ref and new (in world angles)
        a0 = ang_new
        a1 = ang_new
        IfCondition EqualTo(ref_ok, 1) ThenBlock: {
            a0 = CAD_Geom.Atan2(ry, rx)
            a1 = ang_new
        }
        IfCondition EqualTo(ref_ok, 0) ThenBlock: {
            a0 = 0
            a1 = ang_new
        }
        // ensure short arc direction
        span = Float_Sub(a1, a0)
        pi = 0x400921FB54442D18
        two_pi = 0x401921FB54442D18
        WhileLoop EqualTo(Float_Le(pi, span), 1) {
            span = Float_Sub(span, two_pi)
        }
        WhileLoop EqualTo(Float_Le(span, Float_Sub(0, pi)), 1) {
            span = Float_Add(span, two_pi)
        }
        // sample arc at ~10 mm radius in world
        ar = Float_FromInt(10)
        nseg = 10
        k = 0
        pta = Allocate(32)
        ptb = Allocate(32)
        WhileLoop LessThan(k, nseg) {
            t0 = Float_Div(Float_FromInt(k), Float_FromInt(nseg))
            t1 = Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(nseg))
            ang0 = Float_Add(a0, Float_Mul(span, t0))
            ang1 = Float_Add(a0, Float_Mul(span, t1))
            CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(ar, CAD_Geom.Cos(ang0))), Float_Add(CadApp.cy0, Float_Mul(ar, CAD_Geom.Sin(ang0))), pta)
            CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(ar, CAD_Geom.Cos(ang1))), Float_Add(CadApp.cy0, Float_Mul(ar, CAD_Geom.Sin(ang1))), ptb)
            FB_Line(ArrayGet(pta, 0), ArrayGet(pta, 1), ArrayGet(ptb, 0), ArrayGet(ptb, 1), FB_RGB(255, 220, 80))
            k = Add(k, 1)
        }
        Deallocate(pta, 32)
        Deallocate(ptb, 32)
        // label near midpoint of rubber-band: "45d L=12"
        mx = Divide(Add(px0, px1), 2)
        my = Divide(Add(py0, py1), 2)
        // build small string in stack buffer
        lab = Allocate(48)
        pos = 0
        // digits for deg
        dv = deg
        IfCondition EqualTo(dv, 0) ThenBlock: {
            SetByte(lab, pos, 48)
            pos = Add(pos, 1)
        }
        IfCondition GreaterThan(dv, 0) ThenBlock: {
            tmp = Allocate(16)
            n = 0
            WhileLoop GreaterThan(dv, 0) {
                SetByte(tmp, n, Add(48, Modulo(dv, 10)))
                dv = Divide(dv, 10)
                n = Add(n, 1)
            }
            ii = Subtract(n, 1)
            WhileLoop GreaterEqual(ii, 0) {
                SetByte(lab, pos, GetByte(tmp, ii))
                pos = Add(pos, 1)
                ii = Subtract(ii, 1)
            }
            Deallocate(tmp, 16)
        }
        SetByte(lab, pos, 100)
        pos = Add(pos, 1)
        // " L="
        SetByte(lab, pos, 32)
        pos = Add(pos, 1)
        SetByte(lab, pos, 76)
        pos = Add(pos, 1)
        SetByte(lab, pos, 61)
        pos = Add(pos, 1)
        lv = CadApp.live_len
        IfCondition LessThan(lv, 0) ThenBlock: { lv = Subtract(0, lv) }
        IfCondition EqualTo(lv, 0) ThenBlock: {
            SetByte(lab, pos, 48)
            pos = Add(pos, 1)
        }
        IfCondition GreaterThan(lv, 0) ThenBlock: {
            tmp = Allocate(16)
            n = 0
            WhileLoop GreaterThan(lv, 0) {
                SetByte(tmp, n, Add(48, Modulo(lv, 10)))
                lv = Divide(lv, 10)
                n = Add(n, 1)
            }
            ii = Subtract(n, 1)
            WhileLoop GreaterEqual(ii, 0) {
                SetByte(lab, pos, GetByte(tmp, ii))
                pos = Add(pos, 1)
                ii = Subtract(ii, 1)
            }
            Deallocate(tmp, 16)
        }
        SetByte(lab, pos, 0)
        // dark plate + yellow text
        tw = Multiply(pos, 8)
        FB_FillRect(Subtract(mx, 4), Subtract(my, 14), Add(tw, 8), 16, FB_RGB(20, 24, 32))
        FB_DrawString(mx, Subtract(my, 12), lab, FB_RGB(255, 230, 90), -1)
        Deallocate(lab, 48)
        ReturnValue(0)
    }
}

// Mirror all sketch entities across X-axis (axis=0: y→-y) or Y-axis (axis=1: x→-x).
// Adds mirrored copies (keeps originals). Returns count of new entities or -1.


// Build ProjectPoint frame from solid bounds or default ±50 cube.
Function.CA_BuildViewFrame {
    Input: out_frame: Address
    Output: Integer
    Body: {
        // Reuse the projection DrawMesh just used. A second camera is the bug.
        IfCondition EqualTo(CAD_View_State.fr_ok, 1) ThenBlock: {
            IfCondition EqualTo(CAD_View_State.cache_solid, CadApp.solid) ThenBlock: {
                ArraySet(out_frame, 0, CAD_View_State.fr_cx)
                ArraySet(out_frame, 1, CAD_View_State.fr_cy)
                ArraySet(out_frame, 2, CAD_View_State.fr_cz)
                ArraySet(out_frame, 3, CAD_View_State.fr_sc)
                ArraySet(out_frame, 4, CAD_View_State.fr_hw)
                ArraySet(out_frame, 5, CAD_View_State.fr_hh)
                ReturnValue(0)
            }
        }
        aabb = Allocate(64)
        mn = Allocate(32)
        mx = Allocate(32)
        got = 0
        IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.SolidBounds(CadApp.solid, mn, mx), 1) ThenBlock: {
                ArraySet(aabb, 0, ArrayGet(mn, 0))
                ArraySet(aabb, 1, ArrayGet(mn, 1))
                ArraySet(aabb, 2, ArrayGet(mn, 2))
                ArraySet(aabb, 3, ArrayGet(mx, 0))
                ArraySet(aabb, 4, ArrayGet(mx, 1))
                ArraySet(aabb, 5, ArrayGet(mx, 2))
                got = 1
            }
        }
        Deallocate(mn, 32)
        Deallocate(mx, 32)
        IfCondition EqualTo(got, 0) ThenBlock: {
            ArraySet(aabb, 0, Float_FromInt(-50))
            ArraySet(aabb, 1, Float_FromInt(-50))
            ArraySet(aabb, 2, Float_FromInt(-10))
            ArraySet(aabb, 3, Float_FromInt(50))
            ArraySet(aabb, 4, Float_FromInt(50))
            ArraySet(aabb, 5, Float_FromInt(60))
        }
        CAD_View.EnsureCamDefaults()
        CAD_View.BuildFrame(aabb, CadApp.width, CadApp.height_px, out_frame)
        Deallocate(aabb, 64)
        ReturnValue(0)
    }
}

// Project world XYZ to pixel ints via view frame. out_xy [sx,sy] ints.


// Project world XYZ to pixel ints via view frame. out_xy [sx,sy] ints.
Function.CA_World3ToPix {
    Input: x_r: Integer
    Input: y_r: Integer
    Input: z_r: Integer
    Input: vframe: Address
    Input: out_xy: Address
    Output: Integer
    Body: {
        pr = Allocate(32)
        CAD_View.ProjectPoint(x_r, y_r, z_r, vframe, pr)
        ArraySet(out_xy, 0, Float_ToInt(ArrayGet(pr, 0)))
        ArraySet(out_xy, 1, Float_ToInt(ArrayGet(pr, 1)))
        Deallocate(pr, 32)
        ReturnValue(0)
    }
}

// Semi-transparent line: draw every other pixel for see-through grid.


// Semi-transparent line: draw every other pixel for see-through grid.
Function.CA_LineDash {
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Input: col: Integer
    Output: Integer
    Body: {
        dx = Subtract(x1, x0)
        dy = Subtract(y1, y0)
        IfCondition LessThan(dx, 0) ThenBlock: { adx = Subtract(0, dx) }
        IfCondition GreaterEqual(dx, 0) ThenBlock: { adx = dx }
        IfCondition LessThan(dy, 0) ThenBlock: { ady = Subtract(0, dy) }
        IfCondition GreaterEqual(dy, 0) ThenBlock: { ady = dy }
        n = adx
        IfCondition GreaterThan(ady, n) ThenBlock: { n = ady }
        IfCondition LessThan(n, 1) ThenBlock: {
            FB_SetPixel(x0, y0, col)
            ReturnValue(0)
        }
        i = 0
        WhileLoop LessEqual(i, n) {
            // dash: draw 2 on, 1 off
            m = Modulo(i, 3)
            IfCondition NotEqual(m, 2) ThenBlock: {
                t = Float_Div(Float_FromInt(i), Float_FromInt(n))
                x = Add(x0, Float_ToInt(Float_Mul(t, Float_FromInt(dx))))
                y = Add(y0, Float_ToInt(Float_Mul(t, Float_FromInt(dy))))
                FB_SetPixel(x, y, col)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Outline one planar face in the current view (CadAppPick.fr). No heap.
Function.CA_DrawFaceOutline3D {
    Input: face_handle: Integer
    Input: col: Integer
    Input: thick: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_handle, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.face = face_handle
        CadAppPick.col = col
        CadAppPick.thick = thick
        IfCondition EqualTo(CadAppPick.fr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadAppPick.pr, 0) ThenBlock: { CadAppPick.pr = Allocate(32) }
        IfCondition EqualTo(CadAppPick.pr, 0) ThenBlock: { ReturnValue(0) }
        lp = CAD_Store.Read(CadAppPick.face, 1)
        IfCondition EqualTo(lp, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.hd = CAD_Store.Read(lp, 0)
        IfCondition EqualTo(CadAppPick.hd, 0) ThenBlock: { ReturnValue(0) }
        ce0 = CadAppPick.hd
        edc = CAD_Store.Read(ce0, 0)
        IfCondition NotEqual(edc, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(edc, 0), CAD_Store.Read(edc, 1)) ThenBlock: {
                crvc = CAD_Store.Read(edc, 2)
                IfCondition NotEqual(crvc, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(crvc, 0), 2) ThenBlock: {
                        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: {
                            CAD_Tess_State.samp = Allocate(8192)
                        }
                        ns = CAD_Tess.SampleCircleEdge(edc, 48, CAD_Tess_State.samp)
                        samp = CAD_Tess_State.samp
                        si = 0
                        WhileLoop LessThan(si, Subtract(ns, 1)) {
                            CAD_View.ProjectPoint(ArrayGet(samp, Multiply(si, 3)), ArrayGet(samp, Add(Multiply(si, 3), 1)), ArrayGet(samp, Add(Multiply(si, 3), 2)), CadAppPick.fr, CadAppPick.pr)
                            CadAppPick.ax = Float_ToInt(ArrayGet(CadAppPick.pr, 0))
                            CadAppPick.ay = Float_ToInt(ArrayGet(CadAppPick.pr, 1))
                            CAD_View.ProjectPoint(ArrayGet(samp, Multiply(Add(si, 1), 3)), ArrayGet(samp, Add(Multiply(Add(si, 1), 3), 1)), ArrayGet(samp, Add(Multiply(Add(si, 1), 3), 2)), CadAppPick.fr, CadAppPick.pr)
                            CadAppPick.bx = Float_ToInt(ArrayGet(CadAppPick.pr, 0))
                            CadAppPick.by = Float_ToInt(ArrayGet(CadAppPick.pr, 1))
                            FB_Line(CadAppPick.ax, CadAppPick.ay, CadAppPick.bx, CadAppPick.by, CadAppPick.col)
                            IfCondition GreaterThan(CadAppPick.thick, 1) ThenBlock: {
                                FB_Line(Add(CadAppPick.ax, 1), CadAppPick.ay, Add(CadAppPick.bx, 1), CadAppPick.by, CadAppPick.col)
                                FB_Line(CadAppPick.ax, Add(CadAppPick.ay, 1), CadAppPick.bx, Add(CadAppPick.by, 1), CadAppPick.col)
                            }
                            si = Add(si, 1)
                        }
                        ReturnValue(1)
                    }
                }
            }
        }
        CadAppPick.ce = CadAppPick.hd
        cguard = 0
        WhileLoop LessThan(cguard, 512) {
            ce = CadAppPick.ce
            IfCondition EqualTo(ce, 0) ThenBlock: { cguard = 512 }
            IfCondition NotEqual(ce, 0) ThenBlock: {
            CadAppPick.ov = CAD_Store.Read(ce, 5)
            ov = CadAppPick.ov
            IfCondition EqualTo(ov, 0) ThenBlock: {
                CadAppPick.ce = CAD_Store.Read(ce, 2)
                cguard = Add(cguard, 1)
                IfCondition EqualTo(CadAppPick.ce, CadAppPick.hd) ThenBlock: { cguard = 512 }
            }
            IfCondition NotEqual(ov, 0) ThenBlock: {
            CadAppPick.wx = CAD_Store.Read(ov, 0)
            CadAppPick.wy = CAD_Store.Read(ov, 1)
            CadAppPick.wz = CAD_Store.Read(ov, 2)
            CAD_View.ProjectPoint(CadAppPick.wx, CadAppPick.wy, CadAppPick.wz, CadAppPick.fr, CadAppPick.pr)
            CadAppPick.ax = Float_ToInt(ArrayGet(CadAppPick.pr, 0))
            CadAppPick.ay = Float_ToInt(ArrayGet(CadAppPick.pr, 1))
            ce = CadAppPick.ce
            nxt = CAD_Store.Read(ce, 2)
            IfCondition EqualTo(nxt, 0) ThenBlock: { cguard = 512 }
            IfCondition NotEqual(nxt, 0) ThenBlock: {
            CadAppPick.ce = nxt
            ov = CAD_Store.Read(nxt, 5)
            CadAppPick.ov = ov
            IfCondition NotEqual(ov, 0) ThenBlock: {
            CadAppPick.wx = CAD_Store.Read(ov, 0)
            CadAppPick.wy = CAD_Store.Read(ov, 1)
            CadAppPick.wz = CAD_Store.Read(ov, 2)
            CAD_View.ProjectPoint(CadAppPick.wx, CadAppPick.wy, CadAppPick.wz, CadAppPick.fr, CadAppPick.pr)
            CadAppPick.bx = Float_ToInt(ArrayGet(CadAppPick.pr, 0))
            CadAppPick.by = Float_ToInt(ArrayGet(CadAppPick.pr, 1))
            FB_Line(CadAppPick.ax, CadAppPick.ay, CadAppPick.bx, CadAppPick.by, CadAppPick.col)
            IfCondition GreaterThan(CadAppPick.thick, 1) ThenBlock: {
                FB_Line(Add(CadAppPick.ax, 1), CadAppPick.ay, Add(CadAppPick.bx, 1), CadAppPick.by, CadAppPick.col)
                FB_Line(CadAppPick.ax, Add(CadAppPick.ay, 1), CadAppPick.bx, Add(CadAppPick.by, 1), CadAppPick.col)
            }
            }
            cguard = Add(cguard, 1)
            IfCondition EqualTo(CadAppPick.ce, CadAppPick.hd) ThenBlock: { cguard = 512 }
            }
            }
            }
        }
        ReturnValue(1)
    }
}

// Light-red every planar face; bright-red the hover target. Sketch-on-Face only.
Function.CA_DrawSketchableFaces {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(0) }
        CA_Log("cad_app: sketchable-faces enter\n", 32)
        CA_PickBufs()
        IfCondition EqualTo(CadAppPick.fr, 0) ThenBlock: { ReturnValue(0) }
        CA_BuildViewFrame(CadAppPick.fr)
        CadApp.pick_shell = CAD_Store.Read(CadApp.solid, 0)
        sguard = 0
        WhileLoop NotEqual(CadApp.pick_shell, 0) {
            CadApp.pick_fh = CAD_Store.Read(CadApp.pick_shell, 0)
            fguard = 0
            WhileLoop NotEqual(CadApp.pick_fh, 0) {
                fh = CadApp.pick_fh
                IfCondition EqualTo(CAD_Topo.FaceGetPlane(fh, CadAppPick.pl), 0) ThenBlock: {
                    fh = CadApp.pick_fh
                    CadAppPick.col = FB_RGB(255, 90, 90)
                    CadAppPick.thick = 1
                    IfCondition EqualTo(fh, CadApp.hover_face) ThenBlock: {
                        CadAppPick.col = FB_RGB(255, 24, 24)
                        CadAppPick.thick = 3
                    }
                    CA_DrawFaceOutline3D(fh, CadAppPick.col, CadAppPick.thick)
                }
                fh = CadApp.pick_fh
                CadApp.pick_fh = CAD_Store.Read(fh, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 512) ThenBlock: { CadApp.pick_fh = 0 }
            }
            sh = CadApp.pick_shell
            CadApp.pick_shell = CAD_Store.Read(sh, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { CadApp.pick_shell = 0 }
        }
        CA_Log("cad_app: sketchable-faces ok\n", 29)
        ReturnValue(1)
    }
}

// Drop every solid edge onto the sketch plane (the "lower projection").
Function.CA_DrawSolidOnSketchPlane {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: { ReturnValue(0) }
        CA_PickBufs()
        CAD_Plane.EvalFrame(CadApp.plane, CadAppPick.pl)
        CadAppPick.ox = ArrayGet(CadAppPick.pl, 0)
        CadAppPick.oy = ArrayGet(CadAppPick.pl, 1)
        CadAppPick.oz = ArrayGet(CadAppPick.pl, 2)
        CadAppPick.nx = ArrayGet(CadAppPick.pl, 9)
        CadAppPick.ny = ArrayGet(CadAppPick.pl, 10)
        CadAppPick.nz = ArrayGet(CadAppPick.pl, 11)
        CA_BuildViewFrame(CadAppPick.fr)
        CadApp.pick_shell = CAD_Store.Read(CadApp.solid, 0)
        sguard = 0
        WhileLoop NotEqual(CadApp.pick_shell, 0) {
            CadApp.pick_fh = CAD_Store.Read(CadApp.pick_shell, 0)
            fguard = 0
            WhileLoop NotEqual(CadApp.pick_fh, 0) {
                lp = CAD_Store.Read(CadApp.pick_fh, 1)
                IfCondition NotEqual(lp, 0) ThenBlock: {
                    CadAppPick.hd = CAD_Store.Read(lp, 0)
                    CadAppPick.ce = CadAppPick.hd
                    cguard = 0
                    WhileLoop LessThan(cguard, 512) {
                        ce = CadAppPick.ce
                        CadAppPick.ov = CAD_Store.Read(ce, 5)
                        nxt = CAD_Store.Read(ce, 2)
                        IfCondition NotEqual(CadAppPick.ov, 0) ThenBlock: {
                            IfCondition NotEqual(nxt, 0) ThenBlock: {
                                ov2 = CAD_Store.Read(nxt, 5)
                                IfCondition NotEqual(ov2, 0) ThenBlock: {
                                    CadAppPick.wx = CAD_Store.Read(CadAppPick.ov, 0)
                                    CadAppPick.wy = CAD_Store.Read(CadAppPick.ov, 1)
                                    CadAppPick.wz = CAD_Store.Read(CadAppPick.ov, 2)
                                    CadAppPick.last_t = Float_Add(Float_Add(Float_Mul(Float_Sub(CadAppPick.wx, CadAppPick.ox), CadAppPick.nx), Float_Mul(Float_Sub(CadAppPick.wy, CadAppPick.oy), CadAppPick.ny)), Float_Mul(Float_Sub(CadAppPick.wz, CadAppPick.oz), CadAppPick.nz))
                                    CadAppPick.ax = Float_Sub(CadAppPick.wx, Float_Mul(CadAppPick.last_t, CadAppPick.nx))
                                    CadAppPick.ay = Float_Sub(CadAppPick.wy, Float_Mul(CadAppPick.last_t, CadAppPick.ny))
                                    CadAppPick.bx = Float_Sub(CadAppPick.wz, Float_Mul(CadAppPick.last_t, CadAppPick.nz))
                                    CAD_View.ProjectPoint(CadAppPick.ax, CadAppPick.ay, CadAppPick.bx, CadAppPick.fr, CadAppPick.pr)
                                    xa = Float_ToInt(ArrayGet(CadAppPick.pr, 0))
                                    ya = Float_ToInt(ArrayGet(CadAppPick.pr, 1))
                                    CadAppPick.wx = CAD_Store.Read(ov2, 0)
                                    CadAppPick.wy = CAD_Store.Read(ov2, 1)
                                    CadAppPick.wz = CAD_Store.Read(ov2, 2)
                                    CadAppPick.last_t = Float_Add(Float_Add(Float_Mul(Float_Sub(CadAppPick.wx, CadAppPick.ox), CadAppPick.nx), Float_Mul(Float_Sub(CadAppPick.wy, CadAppPick.oy), CadAppPick.ny)), Float_Mul(Float_Sub(CadAppPick.wz, CadAppPick.oz), CadAppPick.nz))
                                    CadAppPick.ax = Float_Sub(CadAppPick.wx, Float_Mul(CadAppPick.last_t, CadAppPick.nx))
                                    CadAppPick.ay = Float_Sub(CadAppPick.wy, Float_Mul(CadAppPick.last_t, CadAppPick.ny))
                                    CadAppPick.bx = Float_Sub(CadAppPick.wz, Float_Mul(CadAppPick.last_t, CadAppPick.nz))
                                    CAD_View.ProjectPoint(CadAppPick.ax, CadAppPick.ay, CadAppPick.bx, CadAppPick.fr, CadAppPick.pr)
                                    CA_LineDash(xa, ya, Float_ToInt(ArrayGet(CadAppPick.pr, 0)), Float_ToInt(ArrayGet(CadAppPick.pr, 1)), FB_RGB(90, 140, 110))
                                }
                            }
                        }
                        CadAppPick.ce = nxt
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(CadAppPick.ce, CadAppPick.hd) ThenBlock: { cguard = 512 }
                    }
                }
                CadApp.pick_fh = CAD_Store.Read(CadApp.pick_fh, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 512) ThenBlock: { CadApp.pick_fh = 0 }
            }
            CadApp.pick_shell = CAD_Store.Read(CadApp.pick_shell, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { CadApp.pick_shell = 0 }
        }
        ReturnValue(1)
    }
}

// Half-extent of sketch UV (mm), at least 40. Used so the 3D plane grid
// matches the profile — a hard-coded ±40 mm square looked like a second sketch.
Function.CA_SketchAbsExtent {
    Input: sk: Integer
    Output: Integer
    Body: {
        forty = Float_FromInt(40)
        IfCondition EqualTo(sk, 0) ThenBlock: { ReturnValue(forty) }
        CadAppPick.hu = forty
        nl = CAD_Sketch.GetLineCount(sk)
        lines = CAD_Store.Read(sk, 1)
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, nl) {
            IfCondition NotEqual(lines, 0) ThenBlock: {
                base = Multiply(CadAppPick.pi, 4)
                CadAppPick.pj = 0
                WhileLoop LessThan(CadAppPick.pj, 4) {
                    a = CAD_Num.Abs(ArrayGet(lines, Add(base, CadAppPick.pj)))
                    IfCondition EqualTo(Float_Le(CadAppPick.hu, a), 1) ThenBlock: {
                        CadAppPick.hu = a
                    }
                    CadAppPick.pj = Add(CadAppPick.pj, 1)
                }
            }
            CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        nc = CAD_Sketch.GetCircleCount(sk)
        circs = CAD_Store.Read(sk, 8)
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, nc) {
            IfCondition NotEqual(circs, 0) ThenBlock: {
                cb = Multiply(CadAppPick.pi, 3)
                rad = ArrayGet(circs, Add(cb, 2))
                a = Float_Add(CAD_Num.Abs(ArrayGet(circs, cb)), rad)
                IfCondition EqualTo(Float_Le(CadAppPick.hu, a), 1) ThenBlock: {
                    CadAppPick.hu = a
                }
                a = Float_Add(CAD_Num.Abs(ArrayGet(circs, Add(cb, 1))), rad)
                IfCondition EqualTo(Float_Le(CadAppPick.hu, a), 1) ThenBlock: {
                    CadAppPick.hu = a
                }
            }
            CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        na = CAD_Sketch.GetArcCount(sk)
        arcs = CAD_Store.Read(sk, 11)
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, na) {
            IfCondition NotEqual(arcs, 0) ThenBlock: {
                ab = Multiply(CadAppPick.pi, 5)
                rad = ArrayGet(arcs, Add(ab, 2))
                a = Float_Add(CAD_Num.Abs(ArrayGet(arcs, ab)), rad)
                IfCondition EqualTo(Float_Le(CadAppPick.hu, a), 1) ThenBlock: {
                    CadAppPick.hu = a
                }
                a = Float_Add(CAD_Num.Abs(ArrayGet(arcs, Add(ab, 1))), rad)
                IfCondition EqualTo(Float_Le(CadAppPick.hu, a), 1) ThenBlock: {
                    CadAppPick.hu = a
                }
            }
            CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        CadAppPick.hu = Float_Add(CadAppPick.hu, Float_FromInt(10))
        ReturnValue(CadAppPick.hu)
    }
}

// Draw one construction plane: UV grid + axes + normal (see-through dashes).
// active=1 → brighter border.
Function.CA_DrawOnePlane3D {
    Input: plane_h: Integer
    Input: vframe: Address
    Input: active: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(0) }
        // Face-derived plane: outline the real B-Rep face (not a ±40 mm square
        // about the projected Sketch_0 origin — that looked like a misplaced sketch).
        skip_sq = 0
        CadApp.pick_best_f = plane_h
        CadAppPick.face = CadApp.pick_best_f
        IfCondition EqualTo(CAD_Plane.GetMode(CadAppPick.face), 3) ThenBlock: {
            fh = CAD_Plane.GetFaceHandle(CadAppPick.face)
            IfCondition NotEqual(fh, 0) ThenBlock: {
                skip_sq = 1
                IfCondition EqualTo(CadAppPick.fr, 0) ThenBlock: { CadAppPick.fr = Allocate(64) }
                IfCondition NotEqual(CadAppPick.fr, 0) ThenBlock: {
                    ArraySet(CadAppPick.fr, 0, ArrayGet(vframe, 0))
                    ArraySet(CadAppPick.fr, 1, ArrayGet(vframe, 1))
                    ArraySet(CadAppPick.fr, 2, ArrayGet(vframe, 2))
                    ArraySet(CadAppPick.fr, 3, ArrayGet(vframe, 3))
                    ArraySet(CadAppPick.fr, 4, ArrayGet(vframe, 4))
                    ArraySet(CadAppPick.fr, 5, ArrayGet(vframe, 5))
                    fc = FB_RGB(80, 200, 220)
                    IfCondition EqualTo(active, 1) ThenBlock: {
                        fc = FB_RGB(255, 220, 60)
                    }
                    CA_DrawFaceOutline3D(fh, fc, 2)
                }
            }
        }
        // Grid follows the sketch. A hard-coded ±40 mm square after Extrude
        // looked like a second, smaller rectangle on Sketch_0 (not the profile).
        CadAppPick.hu = Float_FromInt(40)
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            skpl = CAD_Sketch.GetPlaneId(CadApp.sketch)
            IfCondition EqualTo(skpl, 0) ThenBlock: { skpl = CadApp.plane }
            IfCondition EqualTo(skpl, plane_h) ThenBlock: {
                CadAppPick.hu = CA_SketchAbsExtent(CadApp.sketch)
            }
        }
        IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
            IfCondition NotEqual(CAD_Plane.GetMode(CadAppPick.face), 3) ThenBlock: {
                skip_sq = 1
            }
        }
        e = CadAppPick.hu
        step = Float_FromInt(10)
        pxyz = Allocate(32)
        a = Allocate(32)
        b = Allocate(32)
        // border color
        bc = FB_RGB(80, 200, 220)
        IfCondition EqualTo(active, 1) ThenBlock: {
            bc = FB_RGB(255, 220, 60)
        }
        gc = FB_RGB(50, 110, 130)
        // UV grid (toggle via cmd "grid" / "grid 0" / "grid 1")
        IfCondition EqualTo(CadApp.show_grid, 1) ThenBlock: {
            // grid lines parallel to U (const v)
            v = Float_Sub(0, e)
            WhileLoop EqualTo(Float_Le(v, e), 1) {
                CAD_Plane.MapLocal(CadApp.pick_best_f, Float_Sub(0, e), v, 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
                CAD_Plane.MapLocal(CadApp.pick_best_f, e, v, 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
                CA_LineDash(ArrayGet(a, 0), ArrayGet(a, 1), ArrayGet(b, 0), ArrayGet(b, 1), gc)
                v = Float_Add(v, step)
            }
            // grid parallel to V (const u)
            u = Float_Sub(0, e)
            WhileLoop EqualTo(Float_Le(u, e), 1) {
                CAD_Plane.MapLocal(CadApp.pick_best_f, u, Float_Sub(0, e), 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
                CAD_Plane.MapLocal(CadApp.pick_best_f, u, e, 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
                CA_LineDash(ArrayGet(a, 0), ArrayGet(a, 1), ArrayGet(b, 0), ArrayGet(b, 1), gc)
                u = Float_Add(u, step)
            }
        }
        // Dummy ±40 mm (or any) yellow square is NOT the sketch. After a pad
        // it sat inside the body and looked like a size-mismatch profile.
        IfCondition EqualTo(skip_sq, 0) ThenBlock: {
        CAD_Plane.MapLocal(CadApp.pick_best_f, Float_Sub(0, e), Float_Sub(0, e), 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
        x00 = ArrayGet(a, 0)
        y00 = ArrayGet(a, 1)
        CAD_Plane.MapLocal(CadApp.pick_best_f, e, Float_Sub(0, e), 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
        x10 = ArrayGet(a, 0)
        y10 = ArrayGet(a, 1)
        CAD_Plane.MapLocal(CadApp.pick_best_f, e, e, 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
        x11 = ArrayGet(a, 0)
        y11 = ArrayGet(a, 1)
        CAD_Plane.MapLocal(CadApp.pick_best_f, Float_Sub(0, e), e, 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
        x01 = ArrayGet(a, 0)
        y01 = ArrayGet(a, 1)
        FB_Line(x00, y00, x10, y10, bc)
        FB_Line(x10, y10, x11, y11, bc)
        FB_Line(x11, y11, x01, y01, bc)
        FB_Line(x01, y01, x00, y00, bc)
        }
        // +U red, +V green, +N cyan
        CAD_Plane.MapLocal(CadApp.pick_best_f, 0, 0, 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
        ox = ArrayGet(a, 0)
        oy = ArrayGet(a, 1)
        CAD_Plane.MapLocal(CadApp.pick_best_f, Float_FromInt(30), 0, 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
        FB_Line(ox, oy, ArrayGet(b, 0), ArrayGet(b, 1), FB_RGB(255, 80, 80))
        CAD_Plane.MapLocal(CadApp.pick_best_f, 0, Float_FromInt(30), 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
        FB_Line(ox, oy, ArrayGet(b, 0), ArrayGet(b, 1), FB_RGB(80, 255, 120))
        CAD_Plane.MapLocal(CadApp.pick_best_f, 0, 0, Float_FromInt(20), pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
        FB_Line(ox, oy, ArrayGet(b, 0), ArrayGet(b, 1), FB_RGB(80, 220, 255))
        FB_FillRect(Subtract(ox, 3), Subtract(oy, 3), 7, 7, FB_RGB(255, 220, 80))
        Deallocate(pxyz, 32)
        Deallocate(a, 32)
        Deallocate(b, 32)
        ReturnValue(0)
    }
}

// Draw all registered planes + active; sketch lines mapped through sketch plane.


// Draw all registered planes + active; sketch lines mapped through sketch plane.
Function.CA_DrawPlanesAndSketch3D {
    Output: Integer
    Body: {
        w = CadApp.width
        h = CadApp.height_px
        need = 0
        IfCondition EqualTo(FB.initialized, 0) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.width, w) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.height, h) ThenBlock: { need = 1 }
        IfCondition EqualTo(need, 1) ThenBlock: {
            IfCondition EqualTo(FB_InitHeadless(w, h), 0) ThenBlock: { ReturnValue(-1) }
        }
        // if no solid, clear dark; if solid, already rendered into FB
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            FB_Clear(FB_RGB(24, 28, 36))
        }
        vframe = Allocate(64)
        CA_BuildViewFrame(vframe)
        // world XY always as faint reference if list empty
        IfCondition EqualTo(CadApp.plane_n, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.plane, 0) ThenBlock: {
                CA_PlaneRegister(CadApp.plane)
            }
        }
        has_act = 0
        i = 0
        WhileLoop LessThan(i, CadApp.plane_n) {
            pl = ArrayGet(CadApp.plane_list, i)
            act = 0
            IfCondition EqualTo(pl, CadApp.plane) ThenBlock: {
                act = 1
                has_act = 1
            }
            CA_DrawOnePlane3D(pl, vframe, act)
            i = Add(i, 1)
        }
        IfCondition EqualTo(has_act, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.plane, 0) ThenBlock: {
                CA_DrawOnePlane3D(CadApp.plane, vframe, 1)
            }
        }
        IfCondition NotEqual(CadApp.hover_plane, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.hover_plane, CadApp.plane) ThenBlock: {
                CA_DrawOnePlane3D(CadApp.hover_plane, vframe, 1)
            }
        }
        // project current sketch onto its plane (see original geometry in 3D)
        // View tab Sketch / skvis — off hides curves; 2D editor still draws.
        IfCondition EqualTo(CadApp.show_sketch, 1) ThenBlock: {
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            skpl = CAD_Sketch.GetPlaneId(CadApp.sketch)
            IfCondition EqualTo(skpl, 0) ThenBlock: {
                skpl = CadApp.plane
            }
            IfCondition EqualTo(skpl, 0) ThenBlock: {
                CA_EnsurePlane()
                skpl = CadApp.plane
            }
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            lines = CAD_Store.Read(CadApp.sketch, 1)
            pxyz = Allocate(32)
            a = Allocate(32)
            b = Allocate(32)
            li = 0
            WhileLoop LessThan(li, nl) {
                base = Multiply(li, 4)
                u0 = ArrayGet(lines, base)
                v0 = ArrayGet(lines, Add(base, 1))
                u1 = ArrayGet(lines, Add(base, 2))
                v1 = ArrayGet(lines, Add(base, 3))
                CAD_Plane.MapLocal(skpl, u0, v0, 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
                CAD_Plane.MapLocal(skpl, u1, v1, 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
                col = FB_RGB(100, 220, 255)
                IfCondition EqualTo(CadApp.tool, 11) ThenBlock: {
                    col = FB_RGB(255, 180, 40)
                }
                IfCondition EqualTo(CadAppRev.ok, 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(u0, CadAppRev.x0, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(v0, CadAppRev.y0, 0), 1) ThenBlock: {
                            col = FB_RGB(255, 240, 40)
                        }
                    }
                }
                FB_Line(ArrayGet(a, 0), ArrayGet(a, 1), ArrayGet(b, 0), ArrayGet(b, 1), col)
                IfCondition EqualTo(CadApp.tool, 11) ThenBlock: {
                    FB_Line(Add(ArrayGet(a, 0), 1), ArrayGet(a, 1), Add(ArrayGet(b, 0), 1), ArrayGet(b, 1), col)
                    FB_Line(ArrayGet(a, 0), Add(ArrayGet(a, 1), 1), ArrayGet(b, 0), Add(ArrayGet(b, 1), 1), col)
                }
                li = Add(li, 1)
            }
            // picked revolve axis — always draw + label (not only while tool=11)
            IfCondition EqualTo(CadAppRev.ok, 1) ThenBlock: {
                CAD_Plane.MapLocal(skpl, CadAppRev.x0, CadAppRev.y0, 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
                CAD_Plane.MapLocal(skpl, CadAppRev.x1, CadAppRev.y1, 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
                ax = ArrayGet(a, 0)
                ay = ArrayGet(a, 1)
                bx = ArrayGet(b, 0)
                by = ArrayGet(b, 1)
                acol = FB_RGB(255, 230, 40)
                FB_Line(ax, ay, bx, by, acol)
                FB_Line(Add(ax, 1), ay, Add(bx, 1), by, acol)
                FB_Line(ax, Add(ay, 1), bx, Add(by, 1), acol)
                FB_FillRect(Subtract(ax, 3), Subtract(ay, 3), 7, 7, acol)
                FB_FillRect(Subtract(bx, 3), Subtract(by, 3), 7, 7, acol)
                mx = Divide(Add(ax, bx), 2)
                my = Divide(Add(ay, by), 2)
                FB_FillRect(Subtract(mx, 2), Subtract(my, 14), 40, 12, FB_RGB(20, 24, 32))
                FB_DrawString(mx, Subtract(my, 12), "AXIS", acol, -1)
            }
            // circles (pure circle sketch has nl=0 — must tess project)
            nc = CAD_Sketch.GetCircleCount(CadApp.sketch)
            circs = CAD_Store.Read(CadApp.sketch, 8)
            two_pi = 0x401921FB54442D18
            ci = 0
            WhileLoop LessThan(ci, nc) {
                cb = Multiply(ci, 3)
                cx = ArrayGet(circs, cb)
                cy = ArrayGet(circs, Add(cb, 1))
                rad = ArrayGet(circs, Add(cb, 2))
                k = 0
                WhileLoop LessThan(k, 96) {
                    a0 = Float_Mul(two_pi, Float_Div(Float_FromInt(k), Float_FromInt(96)))
                    a1 = Float_Mul(two_pi, Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(96)))
                    CAD_Plane.MapLocal(skpl, Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a0))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a0))), 0, pxyz)
                    CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
                    CAD_Plane.MapLocal(skpl, Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a1))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a1))), 0, pxyz)
                    CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
                    FB_Line(ArrayGet(a, 0), ArrayGet(a, 1), ArrayGet(b, 0), ArrayGet(b, 1), FB_RGB(255, 200, 80))
                    k = Add(k, 1)
                }
                ci = Add(ci, 1)
            }
            // arcs
            na = CAD_Sketch.GetArcCount(CadApp.sketch)
            arcs = CAD_Store.Read(CadApp.sketch, 11)
            ai = 0
            WhileLoop LessThan(ai, na) {
                ab = Multiply(ai, 5)
                cx = ArrayGet(arcs, ab)
                cy = ArrayGet(arcs, Add(ab, 1))
                rad = ArrayGet(arcs, Add(ab, 2))
                aa0 = ArrayGet(arcs, Add(ab, 3))
                aa1 = ArrayGet(arcs, Add(ab, 4))
                span = CAD_Num.PosMod2Pi(Float_Sub(aa1, aa0))
                nseg = 32
                k = 0
                WhileLoop LessThan(k, nseg) {
                    t0 = Float_Div(Float_FromInt(k), Float_FromInt(nseg))
                    t1 = Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(nseg))
                    ang0 = Float_Add(aa0, Float_Mul(span, t0))
                    ang1 = Float_Add(aa0, Float_Mul(span, t1))
                    CAD_Plane.MapLocal(skpl, Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang0))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang0))), 0, pxyz)
                    CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
                    CAD_Plane.MapLocal(skpl, Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang1))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang1))), 0, pxyz)
                    CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
                    FB_Line(ArrayGet(a, 0), ArrayGet(a, 1), ArrayGet(b, 0), ArrayGet(b, 1), FB_RGB(200, 140, 255))
                    k = Add(k, 1)
                }
                ai = Add(ai, 1)
            }
            Deallocate(pxyz, 32)
            Deallocate(a, 32)
            Deallocate(b, 32)
        }
        }
        // View cube is host chrome (Gtk). Camera stays in CAD.View.
        Deallocate(vframe, 64)
        ReturnValue(0)
    }
}

// New sketch on active plane (bare plane OK — no solid required).


// Free tess cache so sketch edit does not remesh a lathe (crash on SKETCH tab).
// B-Rep solid is kept; next 3D frame remeshes once.
Function.CA_HoldSolidTess {
    Output: Integer
    Body: {
        // Keep the last shaded mesh. Dumping it forced a remesh (lathe crash)
        // or a failed render + FB_Clear — sketch looked like an empty 2D pad.
        ReturnValue(0)
    }
}

Function.CA_PublishFrame {
    Output: Integer
    Body: {
        CA_PlanePruneImplicit()
        CA_BindSketchPlane()
        CA_LogInt("cad_app: frame mode=", 20, CadApp.mode)
        CA_LogInt("cad_app: frame tool=", 20, CadApp.tool)
        // mode 0 = 3D: solid (if any) + construction planes + projected sketch
        // mode 1 = 2D UV sketch for drawing on the active plane
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                // Shade default; wire cmd toggles fishnet. Never SetViewMode here
                // (that reset orbit every frame).
                CAD_View.SetWire(CadApp.wire)
                CAD_View.SetDefl(0x3FB999999999999A)
                CA_Log("cad_app: frame 3d render\n", 25)
                rc = CAD_View.RenderSolidToFB(CadApp.solid, CadApp.width, CadApp.height_px)
                CA_LogInt("cad_app: frame 3d rc=", 21, rc)
                IfCondition NotEqual(rc, 0) ThenBlock: {
                    PrintMessage("cad_app: render solid FAIL rc=")
                    PrintNumber(rc)
                    PrintMessage(" (solid kept)\n")
                    CA_Log("cad_app: render solid FAIL (solid kept)\n", 40)
                    FB_Clear(FB_RGB(28, 32, 40))
                    IfCondition EqualTo(CadApp.show_planes, 1) ThenBlock: {
                        CA_DrawPlanesAndSketch3D()
                    }
                }
                // Overlay planes/sketch WITHOUT clearing solid (DrawPlanes skips clear when solid!=0)
                IfCondition EqualTo(rc, 0) ThenBlock: {
                    IfCondition EqualTo(CadApp.show_planes, 1) ThenBlock: {
                        CA_DrawPlanesAndSketch3D()
                    }
                    // selected 3D edge for fillet (cyan/yellow)
                    CA_DrawSelectedEdgeHighlight()
                    CA_DrawSelectedFaceHighlight()
                    want_face = 0
                    IfCondition EqualTo(CadApp.face_pick, 1) ThenBlock: { want_face = 1 }
                    IfCondition GreaterEqual(CadApp.plane_pick, 2) ThenBlock: { want_face = 1 }
                    IfCondition EqualTo(want_face, 1) ThenBlock: {
                        CA_Log("cad_app: pub sketchable\n", 24)
                        CA_DrawSketchableFaces()
                        CA_Log("cad_app: pub sketchable done\n", 29)
                    }
                }
            }
            IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
                IfCondition EqualTo(CadApp.show_planes, 1) ThenBlock: {
                    rc = CA_DrawPlanesAndSketch3D()
                    IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(rc) }
                }
                IfCondition EqualTo(CadApp.show_planes, 0) ThenBlock: {
                    rc = CA_DrawSketchToFB()
                    IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(rc) }
                }
            }
        }
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                CAD_View.SetWire(CadApp.wire)
                CAD_View.SetDefl(0x3FB999999999999A)
                rc = CAD_View.RenderSolidToFB(CadApp.solid, CadApp.width, CadApp.height_px)
                IfCondition NotEqual(rc, 0) ThenBlock: {
                    FB_Clear(FB_RGB(28, 32, 40))
                }
                CA_DrawSolidOnSketchPlane()
                IfCondition EqualTo(CadApp.show_planes, 1) ThenBlock: {
                    CA_DrawPlanesAndSketch3D()
                }
            }
            rc = CA_DrawSketchToFB()
            IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(rc) }
        }
        IfCondition EqualTo(CadApp.tool, 4) ThenBlock: {
            IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
                FB_FillRect(8, 8, 520, 22, FB_RGB(20, 24, 32))
                FB_DrawString(12, 12, "PICK PROFILE: click the light-red outline, then Extrude", FB_RGB(255, 180, 80), -1)
            }
        }
        IfCondition EqualTo(CadApp.tool, 11) ThenBlock: {
            FB_FillRect(8, 8, 420, 22, FB_RGB(20, 24, 32))
            FB_DrawString(12, 12, "REVOLVE: click a sketch LINE for the axis", FB_RGB(255, 230, 80), -1)
        }
        IfCondition EqualTo(CadApp.face_pick, 1) ThenBlock: {
            FB_FillRect(8, 8, 520, 22, FB_RGB(20, 24, 32))
            FB_DrawString(12, 12, "SKETCH ON FACE: click bright-red face  Shift+click=next along ray", FB_RGB(255, 160, 140), -1)
        }
        IfCondition EqualTo(CadApp.plane_pick, 1) ThenBlock: {
            FB_FillRect(8, 8, 520, 22, FB_RGB(20, 24, 32))
            FB_DrawString(12, 12, "PICK PLANE: click a cyan/gold plane  or a Plane row in the tree", FB_RGB(255, 220, 80), -1)
        }
        IfCondition EqualTo(CadApp.plane_pick, 2) ThenBlock: {
            FB_FillRect(8, 8, 520, 22, FB_RGB(20, 24, 32))
            FB_DrawString(12, 12, "PLANE FROM FACE: click a planar face (no sketch yet)", FB_RGB(255, 200, 120), -1)
        }
        IfCondition EqualTo(CadApp.plane_pick, 3) ThenBlock: {
            FB_FillRect(8, 8, 520, 22, FB_RGB(20, 24, 32))
            FB_DrawString(12, 12, "PLANE ORIGIN: click a vertex or a point on the plane", FB_RGB(180, 255, 140), -1)
        }
        IfCondition EqualTo(CadApp.plane_pick, 4) ThenBlock: {
            FB_FillRect(8, 8, 520, 22, FB_RGB(20, 24, 32))
            IfCondition EqualTo(CadApp.pln_ptn, 0) ThenBlock: {
                FB_DrawString(12, 12, "THROUGH 3 PTS: click first point (vertex / face / plane)", FB_RGB(200, 180, 255), -1)
            }
            IfCondition EqualTo(CadApp.pln_ptn, 1) ThenBlock: {
                FB_DrawString(12, 12, "THROUGH 3 PTS: click second point", FB_RGB(200, 180, 255), -1)
            }
            IfCondition GreaterEqual(CadApp.pln_ptn, 2) ThenBlock: {
                FB_DrawString(12, 12, "THROUGH 3 PTS: click third point", FB_RGB(200, 180, 255), -1)
            }
        }
        CA_Log("cad_app: pub after draw\n", 24)
        CAD_View.WriteFBRaw("/tmp/cad_app/meta.bin", "/tmp/cad_app/frame.raw")
        CA_Log("cad_app: pub after raw\n", 23)
        CadApp.gen = Add(CadApp.gen, 1)
        CA_WriteGen()
        CA_Log("cad_app: pub after gen\n", 23)
        IfCondition EqualTo(CadAppIpc.lite, 1) ThenBlock: {
            ReturnValue(0)
        }
        CA_Log("cad_app: pub before status\n", 27)
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
            IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
                CA_WriteFileStr("/tmp/cad_app/status.txt", "SKETCH line  (r pad m 3d)", 25)
            }
            IfCondition EqualTo(CadApp.tool, 1) ThenBlock: {
                CA_WriteFileStr("/tmp/cad_app/status.txt", "SKETCH rect  (r pad m 3d)", 25)
            }
            IfCondition EqualTo(CadApp.tool, 2) ThenBlock: {
                CA_WriteFileStr("/tmp/cad_app/status.txt", "SKETCH circ  (r pad m 3d)", 25)
            }
        }
        IfCondition EqualTo(CadApp.tool, 11) ThenBlock: {
            CA_WriteFileStr("/tmp/cad_app/status.txt", "REVOLVE: click a sketch LINE for the axis", 41)
        }
        CA_WriteStatus()
        CA_Log("cad_app: pub after status\n", 26)
        CA_WriteToolFile()
        CA_Log("cad_app: pub after tool\n", 24)
        CA_WriteHud()
        CA_Log("cad_app: pub after hud\n", 23)
        CA_WriteCam()
        CA_Log("cad_app: pub after cam\n", 23)
        CA_WritePalette()
        CA_Log("cad_app: pub after pal\n", 23)
        CA_WriteTree()
        CA_Log("cad_app: pub after tree\n", 24)
        CA_WriteHist()
        CA_Log("cad_app: pub ok\n", 16)
        ReturnValue(0)
    }
}


// Circle rubber-band. Pin cx/r/pt — Cos/Sin + WorldToPix clobber Address locals.
Function.CA_DrawCircPreview {
    Input: hx: Integer
    Input: hy: Integer
    Output: Integer
    Body: {
        CadAppPrev.hx = hx
        CadAppPrev.hy = hy
        CadAppPrev.cx = CadApp.cx0
        CadAppPrev.cy = CadApp.cy0
        dx = Float_Sub(CadAppPrev.hx, CadAppPrev.cx)
        dy = Float_Sub(CadAppPrev.hy, CadAppPrev.cy)
        CadAppPrev.rad = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CadAppPrev.pt, 0) ThenBlock: { CadAppPrev.pt = Allocate(32) }
        IfCondition EqualTo(CadAppPrev.pt, 0) ThenBlock: { ReturnValue(-1) }
        two_pi = 0x401921FB54442D18
        CadAppPrev.k = 0
        WhileLoop LessThan(CadAppPrev.k, 32) {
            k = CadAppPrev.k
            a0 = Float_Mul(two_pi, Float_Div(Float_FromInt(k), Float_FromInt(32)))
            c0 = CAD_Geom.Cos(a0)
            s0 = CAD_Geom.Sin(a0)
            wx = Float_Add(CadAppPrev.cx, Float_Mul(CadAppPrev.rad, c0))
            wy = Float_Add(CadAppPrev.cy, Float_Mul(CadAppPrev.rad, s0))
            CA_WorldToPix(wx, wy, CadAppPrev.pt)
            CadAppPrev.xa = ArrayGet(CadAppPrev.pt, 0)
            CadAppPrev.ya = ArrayGet(CadAppPrev.pt, 1)
            k = CadAppPrev.k
            a1 = Float_Mul(two_pi, Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(32)))
            c1 = CAD_Geom.Cos(a1)
            s1 = CAD_Geom.Sin(a1)
            wx = Float_Add(CadAppPrev.cx, Float_Mul(CadAppPrev.rad, c1))
            wy = Float_Add(CadAppPrev.cy, Float_Mul(CadAppPrev.rad, s1))
            CA_WorldToPix(wx, wy, CadAppPrev.pt)
            CadAppPrev.xb = ArrayGet(CadAppPrev.pt, 0)
            CadAppPrev.yb = ArrayGet(CadAppPrev.pt, 1)
            FB_Line(CadAppPrev.xa, CadAppPrev.ya, CadAppPrev.xb, CadAppPrev.yb, FB_RGB(255, 200, 80))
            CadAppPrev.k = Add(CadAppPrev.k, 1)
        }
        ReturnValue(0)
    }
}

// Arc3 rubber-band: markers + live arc from CAD_Sketch.Arc3Fit (same as commit).
Function.CA_DrawArc3Preview {
    Input: hx: Integer
    Input: hy: Integer
    Output: Integer
    Body: {
        pt = Allocate(32)
        col = FB_RGB(80, 255, 255)
        col_th = FB_RGB(255, 220, 60)
        col_arc = FB_RGB(0, 255, 180)
        two_pi = 0x401921FB54442D18
        CA_WorldToPix(CadApp.cx0, CadApp.cy0, pt)
        sx = ArrayGet(pt, 0)
        sy = ArrayGet(pt, 1)
        FB_FillRect(Subtract(sx, 4), Subtract(sy, 4), 9, 9, FB_RGB(255, 60, 60))
        FB_FillRect(Subtract(sx, 2), Subtract(sy, 2), 5, 5, col)
        IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
            CA_WorldToPix(hx, hy, pt)
            ex = ArrayGet(pt, 0)
            ey = ArrayGet(pt, 1)
            FB_Line(sx, sy, ex, ey, col)
            FB_Line(Add(sx, 1), sy, Add(ex, 1), ey, col)
            FB_FillRect(Subtract(ex, 3), Subtract(ey, 3), 7, 7, col_th)
        }
        IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: {
            p1x = CadApp.arc_rad
            p1y = CadApp.arc_a0
            CA_WorldToPix(p1x, p1y, pt)
            mx = ArrayGet(pt, 0)
            my = ArrayGet(pt, 1)
            CA_WorldToPix(hx, hy, pt)
            ex = ArrayGet(pt, 0)
            ey = ArrayGet(pt, 1)
            FB_Line(sx, sy, mx, my, col_th)
            FB_Line(Add(sx, 1), sy, Add(mx, 1), my, col_th)
            FB_Line(mx, my, ex, ey, col_th)
            FB_Line(Add(mx, 1), my, Add(ex, 1), ey, col_th)
            FB_FillRect(Subtract(mx, 3), Subtract(my, 3), 7, 7, col_th)
            FB_FillRect(Subtract(ex, 3), Subtract(ey, 3), 7, 7, col)
            // Shared fit → CAD_Sketch_Arc3 (commit will use Arc3CommitLast)
            // pin all 6 before Fit (FixedPool field args + hx/hy)
            f0x = CadApp.cx0
            f0y = CadApp.cy0
            f2x = hx
            f2y = hy
            fr = CAD_Sketch.Arc3Fit(f0x, f0y, p1x, p1y, f2x, f2y)
            IfCondition EqualTo(fr, 0) ThenBlock: {
                acx = CAD_Sketch_Arc3.cx
                acy = CAD_Sketch_Arc3.cy
                rad = CAD_Sketch_Arc3.rad
                aa0 = CAD_Sketch_Arc3.a0
                aa1 = CAD_Sketch_Arc3.a1
                span = Float_Sub(aa1, aa0)
                IfCondition EqualTo(Float_Le(span, 0), 1) ThenBlock: {
                    span = Float_Add(span, two_pi)
                }
                nseg = 40
                k = 0
                WhileLoop LessThan(k, nseg) {
                    t0 = Float_Div(Float_FromInt(k), Float_FromInt(nseg))
                    t1 = Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(nseg))
                    ang0 = Float_Add(aa0, Float_Mul(span, t0))
                    ang1 = Float_Add(aa0, Float_Mul(span, t1))
                    CA_WorldToPix(Float_Add(acx, Float_Mul(rad, CAD_Geom.Cos(ang0))), Float_Add(acy, Float_Mul(rad, CAD_Geom.Sin(ang0))), pt)
                    xa = ArrayGet(pt, 0)
                    ya = ArrayGet(pt, 1)
                    CA_WorldToPix(Float_Add(acx, Float_Mul(rad, CAD_Geom.Cos(ang1))), Float_Add(acy, Float_Mul(rad, CAD_Geom.Sin(ang1))), pt)
                    xb = ArrayGet(pt, 0)
                    yb = ArrayGet(pt, 1)
                    FB_Line(xa, ya, xb, yb, col_arc)
                    FB_Line(Add(xa, 1), ya, Add(xb, 1), yb, col_arc)
                    k = Add(k, 1)
                }
                CA_WorldToPix(acx, acy, pt)
                FB_FillRect(Subtract(ArrayGet(pt, 0), 3), Subtract(ArrayGet(pt, 1), 3), 7, 7, FB_RGB(255, 80, 80))
            }
        }
        Deallocate(pt, 32)
        ReturnValue(1)
    }
}

Function.CA_DrawArcSeg {
    Input: cx: Integer
    Input: cy: Integer
    Input: rad: Integer
    Input: a0: Integer
    Input: span: Integer
    Input: col: Integer
    Output: Integer
    Body: {
        pt = Allocate(32)
        nseg = 32
        k = 0
        WhileLoop LessThan(k, nseg) {
            t0 = Float_Div(Float_FromInt(k), Float_FromInt(nseg))
            t1 = Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(nseg))
            ang0 = Float_Add(a0, Float_Mul(span, t0))
            ang1 = Float_Add(a0, Float_Mul(span, t1))
            CA_WorldToPix(Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang0))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang0))), pt)
            xa = ArrayGet(pt, 0)
            ya = ArrayGet(pt, 1)
            CA_WorldToPix(Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang1))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang1))), pt)
            FB_Line(xa, ya, ArrayGet(pt, 0), ArrayGet(pt, 1), col)
            k = Add(k, 1)
        }
        Deallocate(pt, 32)
        ReturnValue(0)
    }
}

Function.CA_DrawConstructPreview {
    Input: hx: Integer
    Input: hy: Integer
    Output: Integer
    Body: {
        pt = Allocate(32)
        col = FB_RGB(80, 220, 255)
        two_pi = 0x401921FB54442D18
        pi = 0x400921FB54442D18
        half = 0x4000000000000000
        tool = CadApp.tool
        CA_WorldToPix(CadApp.cx0, CadApp.cy0, pt)
        sx = ArrayGet(pt, 0)
        sy = ArrayGet(pt, 1)
        CA_WorldToPix(hx, hy, pt)
        ex = ArrayGet(pt, 0)
        ey = ArrayGet(pt, 1)
        FB_FillRect(Subtract(sx, 3), Subtract(sy, 3), 7, 7, FB_RGB(255, 80, 80))
        // spline CVs + sampled curve
        IfCondition EqualTo(tool, 18) ThenBlock: {
            n = CadApp.spl_n
            IfCondition GreaterThan(n, 0) ThenBlock: {
                IfCondition NotEqual(CadApp.spl_xy, 0) ThenBlock: {
                    i = 0
                    WhileLoop LessThan(i, n) {
                        CA_WorldToPix(ArrayGet(CadApp.spl_xy, Multiply(i, 2)), ArrayGet(CadApp.spl_xy, Add(Multiply(i, 2), 1)), pt)
                        px = ArrayGet(pt, 0)
                        py = ArrayGet(pt, 1)
                        FB_FillRect(Subtract(px, 3), Subtract(py, 3), 7, 7, FB_RGB(255, 200, 60))
                        IfCondition GreaterThan(i, 0) ThenBlock: {
                            CA_WorldToPix(ArrayGet(CadApp.spl_xy, Multiply(Subtract(i, 1), 2)), ArrayGet(CadApp.spl_xy, Add(Multiply(Subtract(i, 1), 2), 1)), pt)
                            FB_Line(ArrayGet(pt, 0), ArrayGet(pt, 1), px, py, FB_RGB(180, 140, 40))
                        }
                        i = Add(i, 1)
                    }
                    IfCondition GreaterThan(n, 0) ThenBlock: {
                        CA_WorldToPix(ArrayGet(CadApp.spl_xy, Multiply(Subtract(n, 1), 2)), ArrayGet(CadApp.spl_xy, Add(Multiply(Subtract(n, 1), 2), 1)), pt)
                        FB_Line(ArrayGet(pt, 0), ArrayGet(pt, 1), ex, ey, FB_RGB(180, 140, 40))
                    }
                    IfCondition GreaterThan(n, 1) ThenBlock: {
                        tmp = Allocate(2048)
                        ArraySet(tmp, Multiply(n, 2), hx)
                        ArraySet(tmp, Add(Multiply(n, 2), 1), hy)
                        i = 0
                        WhileLoop LessThan(i, n) {
                            ArraySet(tmp, Multiply(i, 2), ArrayGet(CadApp.spl_xy, Multiply(i, 2)))
                            ArraySet(tmp, Add(Multiply(i, 2), 1), ArrayGet(CadApp.spl_xy, Add(Multiply(i, 2), 1)))
                            i = Add(i, 1)
                        }
                        samp = Allocate(8192)
                        ns = CAD_UI.SampleSplineXY(tmp, Add(n, 1), samp, 256)
                        i = 0
                        WhileLoop LessThan(i, Subtract(ns, 1)) {
                            CA_WorldToPix(ArrayGet(samp, Multiply(i, 2)), ArrayGet(samp, Add(Multiply(i, 2), 1)), pt)
                            xa = ArrayGet(pt, 0)
                            ya = ArrayGet(pt, 1)
                            CA_WorldToPix(ArrayGet(samp, Multiply(Add(i, 1), 2)), ArrayGet(samp, Add(Multiply(Add(i, 1), 2), 1)), pt)
                            FB_Line(xa, ya, ArrayGet(pt, 0), ArrayGet(pt, 1), col)
                            i = Add(i, 1)
                        }
                        Deallocate(samp, 8192)
                        Deallocate(tmp, 2048)
                    }
                }
            }
            Deallocate(pt, 32)
            ReturnValue(0)
        }
        dx = Float_Sub(hx, CadApp.cx0)
        dy = Float_Sub(hy, CadApp.cy0)
        // 2-pt arc / 2-pt circle
        IfCondition EqualTo(tool, 12) ThenBlock: {
            mx = Float_Div(Float_Add(CadApp.cx0, hx), half)
            my = Float_Div(Float_Add(CadApp.cy0, hy), half)
            rad = Float_Div(CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))), half)
            IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 0) ThenBlock: {
                a0 = CAD_Geom.Atan2(Float_Sub(CadApp.cy0, my), Float_Sub(CadApp.cx0, mx))
                CA_DrawArcSeg(mx, my, rad, a0, pi, col)
            }
            FB_Line(sx, sy, ex, ey, FB_RGB(200, 160, 80))
        }
        IfCondition EqualTo(tool, 13) ThenBlock: {
            mx = Float_Div(Float_Add(CadApp.cx0, hx), half)
            my = Float_Div(Float_Add(CadApp.cy0, hy), half)
            rad = Float_Div(CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))), half)
            IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 0) ThenBlock: {
                CA_DrawArcSeg(mx, my, rad, 0, two_pi, col)
            }
            FB_Line(sx, sy, ex, ey, FB_RGB(200, 160, 80))
        }
        // center rect
        IfCondition EqualTo(tool, 15) ThenBlock: {
            hw = dx
            hh = dy
            IfCondition EqualTo(Float_Le(hw, 0), 1) ThenBlock: { hw = Float_Sub(0, hw) }
            IfCondition EqualTo(Float_Le(hh, 0), 1) ThenBlock: { hh = Float_Sub(0, hh) }
            CA_WorldToPix(Float_Sub(CadApp.cx0, hw), Float_Sub(CadApp.cy0, hh), pt)
            x0 = ArrayGet(pt, 0)
            y0 = ArrayGet(pt, 1)
            CA_WorldToPix(Float_Add(CadApp.cx0, hw), Float_Sub(CadApp.cy0, hh), pt)
            x1 = ArrayGet(pt, 0)
            y1 = ArrayGet(pt, 1)
            CA_WorldToPix(Float_Add(CadApp.cx0, hw), Float_Add(CadApp.cy0, hh), pt)
            x2 = ArrayGet(pt, 0)
            y2 = ArrayGet(pt, 1)
            CA_WorldToPix(Float_Sub(CadApp.cx0, hw), Float_Add(CadApp.cy0, hh), pt)
            x3 = ArrayGet(pt, 0)
            y3 = ArrayGet(pt, 1)
            FB_Line(x0, y0, x1, y1, col)
            FB_Line(x1, y1, x2, y2, col)
            FB_Line(x2, y2, x3, y3, col)
            FB_Line(x3, y3, x0, y0, col)
        }
        // n-gon / slot ghost — own function (Cos/Sin + WorldToPix clobber)
        IfCondition EqualTo(tool, 17) ThenBlock: {
            CA_DrawPolyPreview(hx, hy)
        }
        // 3-pt circle
        IfCondition EqualTo(tool, 14) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                FB_Line(sx, sy, ex, ey, col)
            }
            IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: {
                CAD_UI.Pend3(CadApp.cx0, CadApp.cy0, CadApp.arc_rad, CadApp.arc_a0, hx, hy)
                CAD_Sketch.Arc3Pend(CAD_UI_State.x0, CAD_UI_State.y0, CAD_UI_State.x1, CAD_UI_State.y1, CAD_UI_State.x2, CAD_UI_State.y2)
                fr = CAD_Sketch.Arc3FitPend()
                IfCondition EqualTo(fr, 0) ThenBlock: {
                    CA_DrawArcSeg(CAD_Sketch_Arc3.cx, CAD_Sketch_Arc3.cy, CAD_Sketch_Arc3.rad, 0, two_pi, col)
                }
                CA_WorldToPix(CadApp.arc_rad, CadApp.arc_a0, pt)
                FB_FillRect(Subtract(ArrayGet(pt, 0), 3), Subtract(ArrayGet(pt, 1), 3), 7, 7, FB_RGB(255, 220, 60))
            }
        }
        // 3-pt rectangle
        IfCondition EqualTo(tool, 16) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                FB_Line(sx, sy, ex, ey, col)
            }
            IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: {
                x0 = CadApp.cx0
                y0 = CadApp.cy0
                x1 = CadApp.arc_rad
                y1 = CadApp.arc_a0
                edx = Float_Sub(x1, x0)
                edy = Float_Sub(y1, y0)
                elen = CAD_Num.Sqrt(Float_Add(Float_Mul(edx, edx), Float_Mul(edy, edy)))
                IfCondition EqualTo(CAD_Num.IsZero(elen, 0), 0) ThenBlock: {
                    ux = Float_Div(edx, elen)
                    uy = Float_Div(edy, elen)
                    nx = Float_Sub(0, uy)
                    ny = ux
                    ht = Float_Add(Float_Mul(Float_Sub(hx, x0), nx), Float_Mul(Float_Sub(hy, y0), ny))
                    qx = Float_Mul(nx, ht)
                    qy = Float_Mul(ny, ht)
                    CA_WorldToPix(x0, y0, pt)
                    ax = ArrayGet(pt, 0)
                    ay = ArrayGet(pt, 1)
                    CA_WorldToPix(x1, y1, pt)
                    bx = ArrayGet(pt, 0)
                    by = ArrayGet(pt, 1)
                    CA_WorldToPix(Float_Add(x1, qx), Float_Add(y1, qy), pt)
                    cxp = ArrayGet(pt, 0)
                    cyp = ArrayGet(pt, 1)
                    CA_WorldToPix(Float_Add(x0, qx), Float_Add(y0, qy), pt)
                    dxp = ArrayGet(pt, 0)
                    dyp = ArrayGet(pt, 1)
                    FB_Line(ax, ay, bx, by, col)
                    FB_Line(bx, by, cxp, cyp, col)
                    FB_Line(cxp, cyp, dxp, dyp, col)
                    FB_Line(dxp, dyp, ax, ay, col)
                }
            }
        }
        Deallocate(pt, 32)
        ReturnValue(0)
    }
}

// Always-on polygon HUD so N-sides is visible before the first click.
Function.CA_DrawPolyHud {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppPrev.lab, 0) ThenBlock: { CadAppPrev.lab = Allocate(64) }
        IfCondition EqualTo(CadAppPrev.lab, 0) ThenBlock: { ReturnValue(0) }
        lab = CadAppPrev.lab
        SetByte(lab, 0, 80)
        SetByte(lab, 1, 79)
        SetByte(lab, 2, 76)
        SetByte(lab, 3, 89)
        SetByte(lab, 4, 32)
        SetByte(lab, 5, 78)
        SetByte(lab, 6, 61)
        CadAppPrev.pos = 7
        nv = CadApp.poly_n
        CadAppPrev.ns = nv
        IfCondition LessThan(nv, 3) ThenBlock: {
            SetByte(lab, 7, 115)
            SetByte(lab, 8, 108)
            SetByte(lab, 9, 111)
            SetByte(lab, 10, 116)
            CadAppPrev.pos = 11
        }
        IfCondition GreaterEqual(nv, 3) ThenBlock: {
            d1 = Divide(nv, 10)
            d0 = Subtract(nv, Multiply(d1, 10))
            IfCondition GreaterThan(d1, 0) ThenBlock: {
                SetByte(lab, CadAppPrev.pos, Add(48, d1))
                CadAppPrev.pos = Add(CadAppPrev.pos, 1)
            }
            SetByte(lab, CadAppPrev.pos, Add(48, d0))
            CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        }
        SetByte(lab, CadAppPrev.pos, 32)
        CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        SetByte(lab, CadAppPrev.pos, 99)
        CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        SetByte(lab, CadAppPrev.pos, 108)
        CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        SetByte(lab, CadAppPrev.pos, 105)
        CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        SetByte(lab, CadAppPrev.pos, 99)
        CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        SetByte(lab, CadAppPrev.pos, 107)
        CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        SetByte(lab, CadAppPrev.pos, 32)
        CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        SetByte(lab, CadAppPrev.pos, 99)
        CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        SetByte(lab, CadAppPrev.pos, 101)
        CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        SetByte(lab, CadAppPrev.pos, 110)
        CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        SetByte(lab, CadAppPrev.pos, 116)
        CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        SetByte(lab, CadAppPrev.pos, 101)
        CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        SetByte(lab, CadAppPrev.pos, 114)
        CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        SetByte(lab, CadAppPrev.pos, 0)
        FB_FillRect(8, 8, Add(Multiply(CadAppPrev.pos, 8), 16), 18, FB_RGB(20, 24, 32))
        FB_DrawString(12, 12, lab, FB_RGB(80, 220, 255), -1)
        ReturnValue(0)
    }
}

// "N=6 R=12" next to the hover point. No NumberToString (heap).
Function.CA_DrawPolyLabel {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppPrev.lab, 0) ThenBlock: { CadAppPrev.lab = Allocate(64) }
        IfCondition EqualTo(CadAppPrev.lab, 0) ThenBlock: { ReturnValue(0) }
        lab = CadAppPrev.lab
        CadAppPrev.pos = 0
        SetByte(lab, 0, 78)
        SetByte(lab, 1, 61)
        CadAppPrev.pos = 2
        nv = CadAppPrev.ns
        IfCondition LessThan(nv, 0) ThenBlock: { nv = 0 }
        IfCondition EqualTo(nv, 0) ThenBlock: {
            SetByte(lab, CadAppPrev.pos, 48)
            CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        }
        IfCondition GreaterThan(nv, 0) ThenBlock: {
            d1 = Divide(nv, 10)
            d0 = Subtract(nv, Multiply(d1, 10))
            IfCondition GreaterThan(d1, 0) ThenBlock: {
                SetByte(lab, CadAppPrev.pos, Add(48, d1))
                CadAppPrev.pos = Add(CadAppPrev.pos, 1)
            }
            SetByte(lab, CadAppPrev.pos, Add(48, d0))
            CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        }
        SetByte(lab, CadAppPrev.pos, 32)
        CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        SetByte(lab, CadAppPrev.pos, 82)
        CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        SetByte(lab, CadAppPrev.pos, 61)
        CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        rv = Float_ToInt(CadAppPrev.rad)
        IfCondition LessThan(rv, 0) ThenBlock: { rv = Subtract(0, rv) }
        IfCondition EqualTo(rv, 0) ThenBlock: {
            SetByte(lab, CadAppPrev.pos, 48)
            CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        }
        IfCondition GreaterThan(rv, 0) ThenBlock: {
            d2 = Divide(rv, 100)
            rv = Subtract(rv, Multiply(d2, 100))
            d1 = Divide(rv, 10)
            d0 = Subtract(rv, Multiply(d1, 10))
            IfCondition GreaterThan(d2, 0) ThenBlock: {
                SetByte(lab, CadAppPrev.pos, Add(48, d2))
                CadAppPrev.pos = Add(CadAppPrev.pos, 1)
            }
            IfCondition GreaterThan(d2, 0) ThenBlock: {
                SetByte(lab, CadAppPrev.pos, Add(48, d1))
                CadAppPrev.pos = Add(CadAppPrev.pos, 1)
            }
            IfCondition EqualTo(d2, 0) ThenBlock: {
                IfCondition GreaterThan(d1, 0) ThenBlock: {
                    SetByte(lab, CadAppPrev.pos, Add(48, d1))
                    CadAppPrev.pos = Add(CadAppPrev.pos, 1)
                }
            }
            SetByte(lab, CadAppPrev.pos, Add(48, d0))
            CadAppPrev.pos = Add(CadAppPrev.pos, 1)
        }
        SetByte(lab, CadAppPrev.pos, 0)
        mx = Add(CadAppPrev.xb, 10)
        my = Subtract(CadAppPrev.yb, 16)
        IfCondition LessThan(mx, 8) ThenBlock: { mx = 8 }
        IfCondition LessThan(my, 8) ThenBlock: { my = 8 }
        tw = Multiply(CadAppPrev.pos, 8)
        FB_FillRect(Subtract(mx, 4), Subtract(my, 2), Add(tw, 10), 16, FB_RGB(20, 24, 32))
        FB_DrawString(mx, my, lab, FB_RGB(255, 230, 90), -1)
        ReturnValue(0)
    }
}

// Polygon rubber-band: sides + radius spoke + N=/R= label.
// Cos/Sin computed into temps — never nested in WorldToPix.
Function.CA_DrawPolyPreview {
    Input: hx: Integer
    Input: hy: Integer
    Output: Integer
    Body: {
        CadAppPrev.hx = hx
        CadAppPrev.hy = hy
        CadAppPrev.cx = CadApp.cx0
        CadAppPrev.cy = CadApp.cy0
        IfCondition EqualTo(CadApp.poly_mode, 2) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: {
                CadAppPrev.hx = CadApp.arc_rad
                CadAppPrev.hy = CadApp.arc_a0
            }
        }
        IfCondition EqualTo(CadApp.poly_mode, 1) ThenBlock: {
            dx = Float_Sub(hx, CadApp.cx0)
            dy = Float_Sub(hy, CadApp.cy0)
            elen = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
            IfCondition EqualTo(CAD_Num.IsZero(elen, 0), 0) ThenBlock: {
                IfCondition GreaterEqual(CadApp.poly_n, 3) ThenBlock: {
                    half = Float_Div(elen, 0x4000000000000000)
                    pin = Float_Div(0x400921FB54442D18, Float_FromInt(CadApp.poly_n))
                    s = CAD_Geom.Sin(pin)
                    IfCondition EqualTo(CAD_Num.IsZero(s, 0), 0) ThenBlock: {
                        rad = Float_Div(half, s)
                        dist = Float_Mul(rad, CAD_Geom.Cos(pin))
                        inv = Float_Div(0x3FF0000000000000, elen)
                        CadAppPrev.cx = Float_Add(Float_Div(Float_Add(CadApp.cx0, hx), 0x4000000000000000), Float_Mul(Float_Mul(Float_Sub(0, dy), inv), dist))
                        CadAppPrev.cy = Float_Add(Float_Div(Float_Add(CadApp.cy0, hy), 0x4000000000000000), Float_Mul(Float_Mul(dx, inv), dist))
                        CadAppPrev.hx = CadApp.cx0
                        CadAppPrev.hy = CadApp.cy0
                    }
                }
            }
        }
        dx = Float_Sub(CadAppPrev.hx, CadAppPrev.cx)
        dy = Float_Sub(CadAppPrev.hy, CadAppPrev.cy)
        CadAppPrev.rad = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CadAppPrev.pt, 0) ThenBlock: { CadAppPrev.pt = Allocate(32) }
        IfCondition EqualTo(CadAppPrev.pt, 0) ThenBlock: { ReturnValue(-1) }
        CadAppPrev.ns = CadApp.poly_n
        CA_WorldToPix(CadAppPrev.cx, CadAppPrev.cy, CadAppPrev.pt)
        CadAppPrev.xa = ArrayGet(CadAppPrev.pt, 0)
        CadAppPrev.ya = ArrayGet(CadAppPrev.pt, 1)
        CA_WorldToPix(CadAppPrev.hx, CadAppPrev.hy, CadAppPrev.pt)
        CadAppPrev.xb = ArrayGet(CadAppPrev.pt, 0)
        CadAppPrev.yb = ArrayGet(CadAppPrev.pt, 1)
        FB_FillRect(Subtract(CadAppPrev.xa, 3), Subtract(CadAppPrev.ya, 3), 7, 7, FB_RGB(255, 80, 80))
        FB_FillRect(Subtract(CadAppPrev.xb, 3), Subtract(CadAppPrev.yb, 3), 7, 7, FB_RGB(80, 220, 255))
        IfCondition EqualTo(CAD_Num.IsZero(CadAppPrev.rad, 0), 1) ThenBlock: {
            CA_DrawPolyLabel()
            ReturnValue(0)
        }
        // radius spoke so size is obvious
        FB_Line(CadAppPrev.xa, CadAppPrev.ya, CadAppPrev.xb, CadAppPrev.yb, FB_RGB(200, 160, 80))
        two_pi = 0x401921FB54442D18
        IfCondition LessThan(CadAppPrev.ns, 3) ThenBlock: {
            // slot: diameter line + capsule ghost
            FB_Line(CadAppPrev.xa, CadAppPrev.ya, CadAppPrev.xb, CadAppPrev.yb, FB_RGB(80, 220, 255))
            mx = Float_Div(Float_Add(CadAppPrev.cx, CadAppPrev.hx), 0x4000000000000000)
            my = Float_Div(Float_Add(CadAppPrev.cy, CadAppPrev.hy), 0x4000000000000000)
            CA_DrawArcSeg(mx, my, Float_Div(CadAppPrev.rad, 0x4000000000000000), 0, two_pi, FB_RGB(120, 180, 220))
            CA_DrawPolyLabel()
            ReturnValue(0)
        }
        CadAppPrev.a0 = CAD_Geom.Atan2(dy, dx)
        CadAppPrev.step = Float_Div(two_pi, Float_FromInt(CadAppPrev.ns))
        col = FB_RGB(80, 220, 255)
        CadAppPrev.k = 0
        WhileLoop LessThan(CadAppPrev.k, CadAppPrev.ns) {
            k = CadAppPrev.k
            ang0 = Float_Add(CadAppPrev.a0, Float_Mul(CadAppPrev.step, Float_FromInt(k)))
            c0 = CAD_Geom.Cos(ang0)
            s0 = CAD_Geom.Sin(ang0)
            wx = Float_Add(CadAppPrev.cx, Float_Mul(CadAppPrev.rad, c0))
            wy = Float_Add(CadAppPrev.cy, Float_Mul(CadAppPrev.rad, s0))
            CA_WorldToPix(wx, wy, CadAppPrev.pt)
            CadAppPrev.xa = ArrayGet(CadAppPrev.pt, 0)
            CadAppPrev.ya = ArrayGet(CadAppPrev.pt, 1)
            k = CadAppPrev.k
            ang1 = Float_Add(CadAppPrev.a0, Float_Mul(CadAppPrev.step, Float_FromInt(Add(k, 1))))
            c1 = CAD_Geom.Cos(ang1)
            s1 = CAD_Geom.Sin(ang1)
            wx = Float_Add(CadAppPrev.cx, Float_Mul(CadAppPrev.rad, c1))
            wy = Float_Add(CadAppPrev.cy, Float_Mul(CadAppPrev.rad, s1))
            CA_WorldToPix(wx, wy, CadAppPrev.pt)
            CadAppPrev.xb = ArrayGet(CadAppPrev.pt, 0)
            CadAppPrev.yb = ArrayGet(CadAppPrev.pt, 1)
            FB_Line(CadAppPrev.xa, CadAppPrev.ya, CadAppPrev.xb, CadAppPrev.yb, col)
            FB_Line(Add(CadAppPrev.xa, 1), CadAppPrev.ya, Add(CadAppPrev.xb, 1), CadAppPrev.yb, col)
            CadAppPrev.k = Add(CadAppPrev.k, 1)
        }
        // restore hover pixel for the label
        CA_WorldToPix(CadAppPrev.hx, CadAppPrev.hy, CadAppPrev.pt)
        CadAppPrev.xb = ArrayGet(CadAppPrev.pt, 0)
        CadAppPrev.yb = ArrayGet(CadAppPrev.pt, 1)
        CA_DrawPolyLabel()
        ReturnValue(0)
    }
}

