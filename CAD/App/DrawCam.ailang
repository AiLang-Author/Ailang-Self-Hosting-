Function.CA_ProfileProjColor {
    Input: br: Integer
    Input: bg: Integer
    Input: bb: Integer
    Output: Integer
    Body: {
        // luminance ~ (r+g+b)/3
        lum = Divide(Add(Add(br, bg), bb), 3)
        // delta steps the tint away from the pad
        d = 150
        IfCondition LessThan(lum, 128) ThenBlock: {
            // dark pad → light grey-cyan projection
            r = Add(br, d)
            g = Add(bg, d)
            b = Add(bb, Add(d, 20))
            IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
            IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
            IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
            // floor so it never collapses into bg
            IfCondition LessThan(r, 140) ThenBlock: { r = 140 }
            IfCondition LessThan(g, 150) ThenBlock: { g = 150 }
            IfCondition LessThan(b, 170) ThenBlock: { b = 170 }
            ReturnValue(FB_RGB(r, g, b))
        }
        // light pad → charcoal projection
        r = Subtract(br, d)
        g = Subtract(bg, d)
        b = Subtract(bb, d)
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition LessThan(b, 0) ThenBlock: { b = 0 }
        IfCondition GreaterThan(r, 80) ThenBlock: { r = 80 }
        IfCondition GreaterThan(g, 80) ThenBlock: { g = 80 }
        IfCondition GreaterThan(b, 90) ThenBlock: { b = 90 }
        ReturnValue(FB_RGB(r, g, b))
    }
}


// Ensure sketch camera: extent in mm, scale px/mm
Function.CA_UpdateSketchCam {
    Output: Integer
    Body: {
        CadApp.extent = Float_FromInt(50)
        // grow from line AABB if any
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            IfCondition GreaterThan(nl, 0) ThenBlock: {
                lines = CAD_Store.Read(CadApp.sketch, 1)
                xmin = ArrayGet(lines, 0)
                ymin = ArrayGet(lines, 1)
                xmax = xmin
                ymax = ymin
                i = 0
                WhileLoop LessThan(i, nl) {
                    b = Multiply(i, 4)
                    x1 = ArrayGet(lines, b)
                    y1 = ArrayGet(lines, Add(b, 1))
                    x2 = ArrayGet(lines, Add(b, 2))
                    y2 = ArrayGet(lines, Add(b, 3))
                    IfCondition EqualTo(Float_Le(x1, xmin), 1) ThenBlock: { xmin = x1 }
                    IfCondition EqualTo(Float_Le(xmax, x1), 1) ThenBlock: { xmax = x1 }
                    IfCondition EqualTo(Float_Le(y1, ymin), 1) ThenBlock: { ymin = y1 }
                    IfCondition EqualTo(Float_Le(ymax, y1), 1) ThenBlock: { ymax = y1 }
                    IfCondition EqualTo(Float_Le(x2, xmin), 1) ThenBlock: { xmin = x2 }
                    IfCondition EqualTo(Float_Le(xmax, x2), 1) ThenBlock: { xmax = x2 }
                    IfCondition EqualTo(Float_Le(y2, ymin), 1) ThenBlock: { ymin = y2 }
                    IfCondition EqualTo(Float_Le(ymax, y2), 1) ThenBlock: { ymax = y2 }
                    i = Add(i, 1)
                }
                dx = Float_Sub(xmax, xmin)
                dy = Float_Sub(ymax, ymin)
                ext = dx
                IfCondition EqualTo(Float_Le(ext, dy), 1) ThenBlock: { ext = dy }
                half = Float_Div(ext, 0x4000000000000000)
                // pad 20%
                ext = Float_Mul(ext, 0x3FF3333333333333)
                IfCondition EqualTo(Float_Le(ext, Float_FromInt(10)), 1) ThenBlock: {
                    ext = Float_FromInt(50)
                }
                CadApp.extent = ext
            }
        }
        mw = CadApp.width
        IfCondition LessThan(CadApp.height_px, mw) ThenBlock: { mw = CadApp.height_px }
        IfCondition EqualTo(CadApp.sk_zoom, 0) ThenBlock: {
            CadApp.sk_zoom = 0x3FF0000000000000
        }
        IfCondition EqualTo(CAD_Num.IsZero(CadApp.extent, 0), 1) ThenBlock: {
            CadApp.extent = Float_FromInt(50)
        }
        // base fit * user scroll zoom
        base = Float_Div(Float_Mul(0x3FEB333333333333, Float_FromInt(mw)), CadApp.extent)
        CadApp.scale = Float_Mul(base, CadApp.sk_zoom)
        ReturnValue(0)
    }
}

// 1 = sketching on a face with the solid still in view.
Function.CA_SketchInContext {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

// Kernel camera — host only sends orbit/pan/zoom. Never leave sketch mode.
// In-context / 3D: CAD_View (same camera as the solid).
// Flat 2D sketch (no solid): remap orbit → sketch pan, zoom → sk_zoom.
Function.CA_ViewPan {
    Input: dx: Integer
    Input: dy: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_SketchInContext(), 1) ThenBlock: {
            CAD_View.PanPixels(dx, dy)
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
            CAD_View.PanPixels(dx, dy)
            ReturnValue(0)
        }
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
            sc = 0x3FF0000000000000
        }
        CadApp.sk_pan_x = Float_Sub(CadApp.sk_pan_x, Float_Div(Float_FromInt(dx), sc))
        CadApp.sk_pan_y = Float_Add(CadApp.sk_pan_y, Float_Div(Float_FromInt(dy), sc))
        ReturnValue(1)
    }
}

Function.CA_ViewZoom {
    Input: steps: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_SketchInContext(), 1) ThenBlock: {
            CAD_View.ZoomSteps(steps)
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
            CAD_View.ZoomSteps(steps)
            ReturnValue(0)
        }
        IfCondition EqualTo(CadApp.sk_zoom, 0) ThenBlock: {
            CadApp.sk_zoom = 0x3FF0000000000000
        }
        zin = 0x3FF2666666666666
        zout = 0x3FEBD37A6F4DE9BE
        zmin = 0x3FB999999999999A
        zmax = 0x4034000000000000
        zs = steps
        s = 0
        WhileLoop LessThan(s, 64) {
            IfCondition EqualTo(zs, 0) ThenBlock: { s = 64 }
            IfCondition GreaterThan(zs, 0) ThenBlock: {
                CadApp.sk_zoom = Float_Mul(CadApp.sk_zoom, zin)
                zs = Subtract(zs, 1)
            }
            IfCondition LessThan(zs, 0) ThenBlock: {
                CadApp.sk_zoom = Float_Mul(CadApp.sk_zoom, zout)
                zs = Add(zs, 1)
            }
            s = Add(s, 1)
        }
        IfCondition EqualTo(Float_Le(CadApp.sk_zoom, zmin), 1) ThenBlock: {
            CadApp.sk_zoom = zmin
        }
        IfCondition EqualTo(Float_Le(zmax, CadApp.sk_zoom), 1) ThenBlock: {
            CadApp.sk_zoom = zmax
        }
        ReturnValue(1)
    }
}

Function.CA_ViewOrbit {
    Input: dx: Integer
    Input: dy: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_SketchInContext(), 1) ThenBlock: {
            CAD_View.OrbitPixels(dx, dy)
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
            ReturnValue(CA_ViewPan(dx, dy))
        }
        CAD_View.OrbitPixels(dx, dy)
        ReturnValue(0)
    }
}

// pixel → UV on the active sketch plane (ray ∩ plane).
Function.CA_PixToSketchUV {
    Input: px: Integer
    Input: py: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(out_xy, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: { ReturnValue(-1) }
        CA_PickBufs()
        IfCondition EqualTo(CadAppPick.fr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadAppPick.pl, 0) ThenBlock: { ReturnValue(-1) }
        CA_BuildViewFrame(CadAppPick.fr)
        CA_CamBasis()
        cx = ArrayGet(CadAppPick.fr, 0)
        cy = ArrayGet(CadAppPick.fr, 1)
        cz = ArrayGet(CadAppPick.fr, 2)
        sc = ArrayGet(CadAppPick.fr, 3)
        hw = ArrayGet(CadAppPick.fr, 4)
        hh = ArrayGet(CadAppPick.fr, 5)
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: { ReturnValue(-1) }
        uu = Float_Sub(Float_Div(Float_Sub(Float_FromInt(px), hw), sc), CAD_View_State.pan_u)
        vv = Float_Sub(Float_Div(Float_Sub(hh, Float_FromInt(py)), sc), CAD_View_State.pan_v)
        CadAppPick.wx = Float_Add(cx, Float_Add(Float_Mul(uu, CadAppPick.rx), Float_Mul(vv, CadAppPick.ux)))
        CadAppPick.wy = Float_Add(cy, Float_Add(Float_Mul(uu, CadAppPick.ry), Float_Mul(vv, CadAppPick.uy)))
        CadAppPick.wz = Float_Add(cz, Float_Add(Float_Mul(uu, CadAppPick.rz), Float_Mul(vv, CadAppPick.uz)))
        CadAppPick.dx = Float_Sub(0, CadAppPick.cdx)
        CadAppPick.dy = Float_Sub(0, CadAppPick.cdy)
        CadAppPick.dz = Float_Sub(0, CadAppPick.cdz)
        CAD_Plane.EvalFrame(CadApp.plane, CadAppPick.pl)
        CadAppPick.ox = ArrayGet(CadAppPick.pl, 0)
        CadAppPick.oy = ArrayGet(CadAppPick.pl, 1)
        CadAppPick.oz = ArrayGet(CadAppPick.pl, 2)
        CadAppPick.nx = ArrayGet(CadAppPick.pl, 9)
        CadAppPick.ny = ArrayGet(CadAppPick.pl, 10)
        CadAppPick.nz = ArrayGet(CadAppPick.pl, 11)
        den = Float_Add(Float_Add(Float_Mul(CadAppPick.dx, CadAppPick.nx), Float_Mul(CadAppPick.dy, CadAppPick.ny)), Float_Mul(CadAppPick.dz, CadAppPick.nz))
        IfCondition EqualTo(CAD_Num.IsZero(den, 0), 1) ThenBlock: { ReturnValue(-1) }
        CadAppPick.last_t = Float_Div(Float_Add(Float_Add(Float_Mul(Float_Sub(CadAppPick.ox, CadAppPick.wx), CadAppPick.nx), Float_Mul(Float_Sub(CadAppPick.oy, CadAppPick.wy), CadAppPick.ny)), Float_Mul(Float_Sub(CadAppPick.oz, CadAppPick.wz), CadAppPick.nz)), den)
        ArraySet(CadAppPick.hit, 0, Float_Add(CadAppPick.wx, Float_Mul(CadAppPick.last_t, CadAppPick.dx)))
        ArraySet(CadAppPick.hit, 1, Float_Add(CadAppPick.wy, Float_Mul(CadAppPick.last_t, CadAppPick.dy)))
        ArraySet(CadAppPick.hit, 2, Float_Add(CadAppPick.wz, Float_Mul(CadAppPick.last_t, CadAppPick.dz)))
        hx = ArrayGet(CadAppPick.hit, 0)
        hy = ArrayGet(CadAppPick.hit, 1)
        hz = ArrayGet(CadAppPick.hit, 2)
        xx = ArrayGet(CadAppPick.pl, 3)
        xy = ArrayGet(CadAppPick.pl, 4)
        xz = ArrayGet(CadAppPick.pl, 5)
        yx = ArrayGet(CadAppPick.pl, 6)
        yy = ArrayGet(CadAppPick.pl, 7)
        yz = ArrayGet(CadAppPick.pl, 8)
        ArraySet(out_xy, 0, Float_Add(Float_Add(Float_Mul(Float_Sub(hx, CadAppPick.ox), xx), Float_Mul(Float_Sub(hy, CadAppPick.oy), xy)), Float_Mul(Float_Sub(hz, CadAppPick.oz), xz)))
        ArraySet(out_xy, 1, Float_Add(Float_Add(Float_Mul(Float_Sub(hx, CadAppPick.ox), yx), Float_Mul(Float_Sub(hy, CadAppPick.oy), yy)), Float_Mul(Float_Sub(hz, CadAppPick.oz), yz)))
        ReturnValue(0)
    }
}

Function.CA_UvToPix3 {
    Input: wx: Integer
    Input: wy: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(out_xy, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: { ReturnValue(-1) }
        CA_PickBufs()
        IfCondition EqualTo(CadAppPick.pl, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Plane.EvalFrame(CadApp.plane, CadAppPick.pl)
        CadAppPick.ox = ArrayGet(CadAppPick.pl, 0)
        CadAppPick.oy = ArrayGet(CadAppPick.pl, 1)
        CadAppPick.oz = ArrayGet(CadAppPick.pl, 2)
        CadAppPick.wx = Float_Add(CadAppPick.ox, Float_Add(Float_Mul(wx, ArrayGet(CadAppPick.pl, 3)), Float_Mul(wy, ArrayGet(CadAppPick.pl, 6))))
        CadAppPick.wy = Float_Add(CadAppPick.oy, Float_Add(Float_Mul(wx, ArrayGet(CadAppPick.pl, 4)), Float_Mul(wy, ArrayGet(CadAppPick.pl, 7))))
        CadAppPick.wz = Float_Add(CadAppPick.oz, Float_Add(Float_Mul(wx, ArrayGet(CadAppPick.pl, 5)), Float_Mul(wy, ArrayGet(CadAppPick.pl, 8))))
        CA_BuildViewFrame(CadAppPick.fr)
        IfCondition EqualTo(CadAppPick.pr, 0) ThenBlock: { CadAppPick.pr = Allocate(32) }
        IfCondition EqualTo(CadAppPick.pr, 0) ThenBlock: { ReturnValue(-1) }
        CAD_View.ProjectPoint(CadAppPick.wx, CadAppPick.wy, CadAppPick.wz, CadAppPick.fr, CadAppPick.pr)
        ix = Float_ToInt(ArrayGet(CadAppPick.pr, 0))
        iy = Float_ToInt(ArrayGet(CadAppPick.pr, 1))
        IfCondition LessThan(ix, -10000) ThenBlock: { ix = -10000 }
        IfCondition GreaterThan(ix, 10000) ThenBlock: { ix = 10000 }
        IfCondition LessThan(iy, -10000) ThenBlock: { iy = -10000 }
        IfCondition GreaterThan(iy, 10000) ThenBlock: { iy = 10000 }
        ArraySet(out_xy, 0, ix)
        ArraySet(out_xy, 1, iy)
        ReturnValue(0)
    }
}

// pixel → world XY (top view, Y up)


// pixel → world XY (top view, Y up)
Function.CA_PixToWorld {
    Input: px: Integer
    Input: py: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_SketchInContext(), 1) ThenBlock: {
            rc = CA_PixToSketchUV(px, py, out_xy)
            IfCondition NotEqual(rc, 0) ThenBlock: {
                ArraySet(out_xy, 0, 0)
                ArraySet(out_xy, 1, 0)
            }
            ReturnValue(rc)
        }
        CA_UpdateSketchCam()
        hw = Float_Div(Float_FromInt(CadApp.width), 0x4000000000000000)
        hh = Float_Div(Float_FromInt(CadApp.height_px), 0x4000000000000000)
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
            sc = 0x3FF0000000000000
        }
        // screen → world around pan center
        wx = Float_Add(CadApp.sk_pan_x, Float_Div(Float_Sub(Float_FromInt(px), hw), sc))
        wy = Float_Add(CadApp.sk_pan_y, Float_Div(Float_Sub(hh, Float_FromInt(py)), sc))
        ArraySet(out_xy, 0, wx)
        ArraySet(out_xy, 1, wy)
        ReturnValue(0)
    }
}


Function.CA_WorldToPix {
    Input: wx: Integer
    Input: wy: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_SketchInContext(), 1) ThenBlock: {
            ReturnValue(CA_UvToPix3(wx, wy, out_xy))
        }
        CA_UpdateSketchCam()
        hw = Float_Div(Float_FromInt(CadApp.width), 0x4000000000000000)
        hh = Float_Div(Float_FromInt(CadApp.height_px), 0x4000000000000000)
        sc = CadApp.scale
        sx = Float_Add(hw, Float_Mul(Float_Sub(wx, CadApp.sk_pan_x), sc))
        sy = Float_Sub(hh, Float_Mul(Float_Sub(wy, CadApp.sk_pan_y), sc))
        ix = Float_ToInt(sx)
        iy = Float_ToInt(sy)
        // Clamp so FB_Line never sees billion-pixel endpoints (freezes sketcher)
        IfCondition LessThan(ix, -10000) ThenBlock: { ix = -10000 }
        IfCondition GreaterThan(ix, 10000) ThenBlock: { ix = 10000 }
        IfCondition LessThan(iy, -10000) ThenBlock: { iy = -10000 }
        IfCondition GreaterThan(iy, 10000) ThenBlock: { iy = 10000 }
        ArraySet(out_xy, 0, ix)
        ArraySet(out_xy, 1, iy)
        ReturnValue(0)
    }
}

// Scanline fill of closed polygon in PIXEL coords (x,y pairs).


// Scanline fill of closed polygon in PIXEL coords (x,y pairs).
Function.CA_FillPolyPx {
    Input: pxy: Address
    Input: n: Integer
    Input: col: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        ymin = ArrayGet(pxy, 1)
        ymax = ymin
        i = 0
        WhileLoop LessThan(i, n) {
            y = ArrayGet(pxy, Add(Multiply(i, 2), 1))
            IfCondition LessThan(y, ymin) ThenBlock: { ymin = y }
            IfCondition GreaterThan(y, ymax) ThenBlock: { ymax = y }
            i = Add(i, 1)
        }
        IfCondition LessThan(ymin, 0) ThenBlock: { ymin = 0 }
        IfCondition GreaterThan(ymax, CadApp.height_px) ThenBlock: { ymax = CadApp.height_px }
        xs = Allocate(2048)
        y = ymin
        WhileLoop LessThan(y, ymax) {
            nx = 0
            i = 0
            WhileLoop LessThan(i, n) {
                j = Add(i, 1)
                IfCondition EqualTo(j, n) ThenBlock: { j = 0 }
                y0 = ArrayGet(pxy, Add(Multiply(i, 2), 1))
                y1 = ArrayGet(pxy, Add(Multiply(j, 2), 1))
                x0 = ArrayGet(pxy, Multiply(i, 2))
                x1 = ArrayGet(pxy, Multiply(j, 2))
                a = 0
                b = 0
                IfCondition LessThan(y0, y) ThenBlock: { a = 1 }
                IfCondition LessThan(y1, y) ThenBlock: { b = 1 }
                IfCondition NotEqual(a, b) ThenBlock: {
                    den = Subtract(y1, y0)
                    IfCondition NotEqual(den, 0) ThenBlock: {
                        num = Multiply(Subtract(y, y0), Subtract(x1, x0))
                        xi = Add(x0, Divide(num, den))
                        IfCondition LessThan(nx, 256) ThenBlock: {
                            ArraySet(xs, nx, xi)
                            nx = Add(nx, 1)
                        }
                    }
                }
                i = Add(i, 1)
            }
            a = 0
            WhileLoop LessThan(a, nx) {
                b = Add(a, 1)
                WhileLoop LessThan(b, nx) {
                    IfCondition GreaterThan(ArrayGet(xs, a), ArrayGet(xs, b)) ThenBlock: {
                        t = ArrayGet(xs, a)
                        ArraySet(xs, a, ArrayGet(xs, b))
                        ArraySet(xs, b, t)
                    }
                    b = Add(b, 1)
                }
                a = Add(a, 1)
            }
            p = 0
            WhileLoop LessThan(p, nx) {
                IfCondition LessThan(Add(p, 1), nx) ThenBlock: {
                    FB_HLine(ArrayGet(xs, p), ArrayGet(xs, Add(p, 1)), y, col)
                }
                p = Add(p, 2)
            }
            y = Add(y, 1)
        }
        Deallocate(xs, 2048)
        ReturnValue(1)
    }
}
