// Sketch grid. Flat sketch paints this pass with FB_Line.
// Sketch-on-face uses the construction grid in DrawOnePlane3D, on the plane.
// Step follows zoom (about 56 px, sequence 1-2-5). A ruler labels each line.
// Pointers live in an Allocate buffer held by CadAppPrev.pos.
// xa/ya/xb/yb/step are scratch; the preview rewrites them before use.
Function.CA_GridDone {
    Output: Integer
    Body: {
        g = CadAppPrev.pos
        IfCondition EqualTo(g, 0) ThenBlock: { ReturnValue(0) }
        g = CadAppPrev.pos
        pt = ArrayGet(g, 1)
        CadAppPrev.xa = pt
        g = CadAppPrev.pos
        oldp = ArrayGet(g, 0)
        CadAppPrev.ya = oldp
        g = CadAppPrev.pos
        oldk = ArrayGet(g, 11)
        CadAppPrev.xb = oldk
        g = CadAppPrev.pos
        CadAppPrev.step = g
        CadAppPrev.pos = CadAppPrev.ya
        CadAppPrev.k = CadAppPrev.xb
        IfCondition NotEqual(CadAppPrev.xa, 0) ThenBlock: {
            Deallocate(CadAppPrev.xa, 32)
        }
        Deallocate(CadAppPrev.step, 128)
        CadAppPrev.xa = 0
        CadAppPrev.ya = 0
        CadAppPrev.xb = 0
        CadAppPrev.yb = 0
        CadAppPrev.step = 0
        ReturnValue(0)
    }
}

// One screen corner into the UV bounds. Slots: 2 umin, 3 umax, 4 vmin, 5 vmax, 8 seen.
Function.CA_GridCorner {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        g = CadAppPrev.pos
        pt = ArrayGet(g, 1)
        rc = CA_PixToWorld(px, py, pt)
        IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(-1) }
        g = CadAppPrev.pos
        pt = ArrayGet(g, 1)
        u = ArrayGet(pt, 0)
        CadAppPrev.xa = u
        g = CadAppPrev.pos
        ArraySet(g, 13, CadAppPrev.xa)
        g = CadAppPrev.pos
        pt = ArrayGet(g, 1)
        v = ArrayGet(pt, 1)
        CadAppPrev.xa = v
        g = CadAppPrev.pos
        ArraySet(g, 14, CadAppPrev.xa)
        g = CadAppPrev.pos
        seen = ArrayGet(g, 8)
        IfCondition EqualTo(seen, 0) ThenBlock: {
            g = CadAppPrev.pos
            u = ArrayGet(g, 13)
            CadAppPrev.xa = u
            g = CadAppPrev.pos
            ArraySet(g, 2, CadAppPrev.xa)
            g = CadAppPrev.pos
            ArraySet(g, 3, CadAppPrev.xa)
            g = CadAppPrev.pos
            v = ArrayGet(g, 14)
            CadAppPrev.xa = v
            g = CadAppPrev.pos
            ArraySet(g, 4, CadAppPrev.xa)
            g = CadAppPrev.pos
            ArraySet(g, 5, CadAppPrev.xa)
            g = CadAppPrev.pos
            ArraySet(g, 8, 1)
            ReturnValue(0)
        }
        g = CadAppPrev.pos
        u = ArrayGet(g, 13)
        CadAppPrev.xa = u
        g = CadAppPrev.pos
        umin = ArrayGet(g, 2)
        CadAppPrev.ya = umin
        le = Float_Le(CadAppPrev.xa, CadAppPrev.ya)
        IfCondition EqualTo(le, 1) ThenBlock: {
            g = CadAppPrev.pos
            u = ArrayGet(g, 13)
            CadAppPrev.xa = u
            g = CadAppPrev.pos
            ArraySet(g, 2, CadAppPrev.xa)
        }
        g = CadAppPrev.pos
        u = ArrayGet(g, 13)
        CadAppPrev.xa = u
        g = CadAppPrev.pos
        umax = ArrayGet(g, 3)
        CadAppPrev.ya = umax
        le = Float_Le(CadAppPrev.ya, CadAppPrev.xa)
        IfCondition EqualTo(le, 1) ThenBlock: {
            g = CadAppPrev.pos
            u = ArrayGet(g, 13)
            CadAppPrev.xa = u
            g = CadAppPrev.pos
            ArraySet(g, 3, CadAppPrev.xa)
        }
        g = CadAppPrev.pos
        v = ArrayGet(g, 14)
        CadAppPrev.xa = v
        g = CadAppPrev.pos
        vmin = ArrayGet(g, 4)
        CadAppPrev.ya = vmin
        le = Float_Le(CadAppPrev.xa, CadAppPrev.ya)
        IfCondition EqualTo(le, 1) ThenBlock: {
            g = CadAppPrev.pos
            v = ArrayGet(g, 14)
            CadAppPrev.xa = v
            g = CadAppPrev.pos
            ArraySet(g, 4, CadAppPrev.xa)
        }
        g = CadAppPrev.pos
        v = ArrayGet(g, 14)
        CadAppPrev.xa = v
        g = CadAppPrev.pos
        vmax = ArrayGet(g, 5)
        CadAppPrev.ya = vmax
        le = Float_Le(CadAppPrev.ya, CadAppPrev.xa)
        IfCondition EqualTo(le, 1) ThenBlock: {
            g = CadAppPrev.pos
            v = ArrayGet(g, 14)
            CadAppPrev.xa = v
            g = CadAppPrev.pos
            ArraySet(g, 5, CadAppPrev.xa)
        }
        ReturnValue(0)
    }
}

// Larger of (umax-umin) and (vmax-vmin), left in xa.
Function.CA_GridSpan {
    Output: Integer
    Body: {
        g = CadAppPrev.pos
        a = ArrayGet(g, 3)
        CadAppPrev.xa = a
        g = CadAppPrev.pos
        b = ArrayGet(g, 2)
        CadAppPrev.ya = b
        s = Float_Sub(CadAppPrev.xa, CadAppPrev.ya)
        CadAppPrev.xa = s
        g = CadAppPrev.pos
        a = ArrayGet(g, 5)
        CadAppPrev.yb = a
        g = CadAppPrev.pos
        b = ArrayGet(g, 4)
        CadAppPrev.xb = b
        s = Float_Sub(CadAppPrev.yb, CadAppPrev.xb)
        CadAppPrev.yb = s
        le = Float_Le(CadAppPrev.yb, CadAppPrev.xa)
        IfCondition EqualTo(le, 0) ThenBlock: {
            CadAppPrev.xa = CadAppPrev.yb
        }
        ReturnValue(0)
    }
}

// Snap xa down to a multiple of slot 6. Result in slot 7.
Function.CA_GridSnap {
    Output: Integer
    Body: {
        g = CadAppPrev.pos
        st = ArrayGet(g, 6)
        CadAppPrev.ya = st
        ratio = Float_Div(CadAppPrev.xa, CadAppPrev.ya)
        n = Float_ToInt(ratio)
        nf = Float_FromInt(n)
        CadAppPrev.xb = nf
        start = Float_Mul(CadAppPrev.xb, CadAppPrev.ya)
        CadAppPrev.xb = start
        le = Float_Le(CadAppPrev.xb, CadAppPrev.xa)
        IfCondition EqualTo(le, 0) ThenBlock: {
            start = Float_Sub(CadAppPrev.xb, CadAppPrev.ya)
            CadAppPrev.xb = start
        }
        g = CadAppPrev.pos
        ArraySet(g, 7, CadAppPrev.xb)
        ReturnValue(0)
    }
}

// Stroke the segment whose world ends are xa,ya and xb,yb.
Function.CA_GridSeg {
    Output: Integer
    Body: {
        g = CadAppPrev.pos
        pt = ArrayGet(g, 1)
        CA_WorldToPix(CadAppPrev.xa, CadAppPrev.ya, pt)
        g = CadAppPrev.pos
        pt = ArrayGet(g, 1)
        x = ArrayGet(pt, 0)
        CadAppPrev.xa = x
        g = CadAppPrev.pos
        pt = ArrayGet(g, 1)
        y = ArrayGet(pt, 1)
        CadAppPrev.ya = y
        g = CadAppPrev.pos
        u = ArrayGet(g, 10)
        CadAppPrev.xb = u
        g = CadAppPrev.pos
        v = ArrayGet(g, 13)
        CadAppPrev.yb = v
        g = CadAppPrev.pos
        pt = ArrayGet(g, 1)
        CA_WorldToPix(CadAppPrev.xb, CadAppPrev.yb, pt)
        g = CadAppPrev.pos
        pt = ArrayGet(g, 1)
        x = ArrayGet(pt, 0)
        CadAppPrev.xb = x
        g = CadAppPrev.pos
        pt = ArrayGet(g, 1)
        y = ArrayGet(pt, 1)
        CadAppPrev.yb = y
        g = CadAppPrev.pos
        col = ArrayGet(g, 15)
        FB_Line(CadAppPrev.xa, CadAppPrev.ya, CadAppPrev.xb, CadAppPrev.yb, col)
        ReturnValue(0)
    }
}

// Zoom step. ppm is pixels per mm. Result in CadAppPrev.a0.
// Sequence 0.1, 0.2, 0.5, 1, 2, 5, ... until a division is about 56 px.
// Then coarsen so extent/step stays under 48 lines.
Function.CA_GridStep {
    Input: ppm: Integer
    Input: extent: Integer
    Output: Integer
    Body: {
        CadAppPrev.hx = ppm
        CadAppPrev.hy = extent
        IfCondition EqualTo(CAD_Num.IsZero(CadAppPrev.hx, 0), 1) ThenBlock: {
            CadAppPrev.a0 = 0x4024000000000000
            ReturnValue(0)
        }
        CadAppPrev.a0 = 0x3FB999999999999A
        CadAppPrev.step = 0
        CadAppPrev.cx = 0
        WhileLoop LessThan(CadAppPrev.cx, 13) {
            CadAppPrev.cy = Float_FromInt(56)
            CadAppPrev.rad = Float_Mul(CadAppPrev.a0, CadAppPrev.hx)
            IfCondition EqualTo(Float_Le(CadAppPrev.cy, CadAppPrev.rad), 1) ThenBlock: {
                CadAppPrev.cx = 13
            }
            IfCondition EqualTo(Float_Le(CadAppPrev.cy, CadAppPrev.rad), 0) ThenBlock: {
                CadAppPrev.cy = Modulo(CadAppPrev.step, 3)
                IfCondition EqualTo(CadAppPrev.cy, 1) ThenBlock: {
                    CadAppPrev.a0 = Float_Mul(CadAppPrev.a0, 0x4004000000000000)
                }
                IfCondition NotEqual(CadAppPrev.cy, 1) ThenBlock: {
                    CadAppPrev.a0 = Float_Mul(CadAppPrev.a0, 0x4000000000000000)
                }
                CadAppPrev.step = Add(CadAppPrev.step, 1)
                CadAppPrev.cx = Add(CadAppPrev.cx, 1)
            }
        }
        CadAppPrev.cx = 0
        WhileLoop LessThan(CadAppPrev.cx, 6) {
            CadAppPrev.rad = Float_Div(CadAppPrev.hy, CadAppPrev.a0)
            CadAppPrev.cy = Float_FromInt(48)
            IfCondition EqualTo(Float_Le(CadAppPrev.rad, CadAppPrev.cy), 1) ThenBlock: {
                CadAppPrev.cx = 6
            }
            IfCondition EqualTo(Float_Le(CadAppPrev.rad, CadAppPrev.cy), 0) ThenBlock: {
                CadAppPrev.cy = Modulo(CadAppPrev.step, 3)
                IfCondition EqualTo(CadAppPrev.cy, 1) ThenBlock: {
                    CadAppPrev.a0 = Float_Mul(CadAppPrev.a0, 0x4004000000000000)
                }
                IfCondition NotEqual(CadAppPrev.cy, 1) ThenBlock: {
                    CadAppPrev.a0 = Float_Mul(CadAppPrev.a0, 0x4000000000000000)
                }
                CadAppPrev.step = Add(CadAppPrev.step, 1)
                CadAppPrev.cx = Add(CadAppPrev.cx, 1)
            }
        }
        ReturnValue(0)
    }
}

// Round CadAppPrev.hy to the step in a0. Half step is hx.
Function.CA_GridRoundAxis {
    Output: Integer
    Body: {
        CadAppPrev.cy = Float_Le(0, CadAppPrev.hy)
        IfCondition EqualTo(CadAppPrev.cy, 1) ThenBlock: {
            CadAppPrev.hy = Float_Add(CadAppPrev.hy, CadAppPrev.hx)
        }
        IfCondition EqualTo(CadAppPrev.cy, 0) ThenBlock: {
            CadAppPrev.hy = Float_Sub(CadAppPrev.hy, CadAppPrev.hx)
        }
        CadAppPrev.hy = Float_Div(CadAppPrev.hy, CadAppPrev.a0)
        CadAppPrev.cx = Float_ToInt(CadAppPrev.hy)
        CadAppPrev.hy = Float_FromInt(CadAppPrev.cx)
        CadAppPrev.hy = Float_Mul(CadAppPrev.hy, CadAppPrev.a0)
        ReturnValue(0)
    }
}

// Ruler digit. Millimetres are CadAppPrev.hx. The 3D caller depth-tests the anchor.
Function.CA_GridLabel {
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        CadAppPrev.xb = x
        CadAppPrev.yb = y
        IfCondition LessThan(CadAppPrev.xb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CadAppPrev.yb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(CadAppPrev.xb, Subtract(CadApp.width, 36)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterThan(CadAppPrev.yb, Subtract(CadApp.height_px, 10)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(CadAppPrev.lab, 0) ThenBlock: {
            CadAppPrev.lab = Allocate(64)
        }
        IfCondition EqualTo(CadAppPrev.lab, 0) ThenBlock: { ReturnValue(0) }
        CadAppPrev.rad = CadAppPrev.hx
        CadAppPrev.step = 0
        IfCondition EqualTo(CAD_Num.IsNeg(CadAppPrev.rad), 1) ThenBlock: {
            CadAppPrev.step = 1
            CadAppPrev.rad = Float_Sub(0, CadAppPrev.rad)
        }
        CadAppPrev.xa = 0
        IfCondition EqualTo(Float_Le(0x3FF0000000000000, CadAppPrev.a0), 0) ThenBlock: {
            CadAppPrev.xa = 1
            CadAppPrev.rad = Float_Mul(CadAppPrev.rad, 0x4024000000000000)
        }
        CadAppPrev.rad = Float_Add(CadAppPrev.rad, 0x3FE0000000000000)
        CadAppPrev.cx = Float_ToInt(CadAppPrev.rad)
        IfCondition EqualTo(CadAppPrev.cx, 0) ThenBlock: {
            CadAppPrev.step = 0
        }
        CadAppPrev.cy = 16
        IfCondition EqualTo(CadAppPrev.cx, 0) ThenBlock: {
            SetByte(CadAppPrev.lab, 16, 48)
            CadAppPrev.cy = 17
        }
        IfCondition GreaterThan(CadAppPrev.cx, 0) ThenBlock: {
            WhileLoop GreaterThan(CadAppPrev.cx, 0) {
                IfCondition GreaterThan(CadAppPrev.cy, 28) ThenBlock: {
                    CadAppPrev.cx = 0
                }
                IfCondition GreaterThan(CadAppPrev.cx, 0) ThenBlock: {
                    CadAppPrev.rad = Modulo(CadAppPrev.cx, 10)
                    CadAppPrev.hx = Add(48, CadAppPrev.rad)
                    SetByte(CadAppPrev.lab, CadAppPrev.cy, CadAppPrev.hx)
                    CadAppPrev.cy = Add(CadAppPrev.cy, 1)
                    CadAppPrev.cx = Divide(CadAppPrev.cx, 10)
                }
            }
        }
        CadAppPrev.ya = 0
        IfCondition EqualTo(CadAppPrev.step, 1) ThenBlock: {
            SetByte(CadAppPrev.lab, 0, 45)
            CadAppPrev.ya = 1
        }
        IfCondition EqualTo(CadAppPrev.xa, 1) ThenBlock: {
            IfCondition EqualTo(CadAppPrev.cy, 17) ThenBlock: {
                SetByte(CadAppPrev.lab, CadAppPrev.ya, 48)
                CadAppPrev.ya = Add(CadAppPrev.ya, 1)
            }
            IfCondition GreaterThan(CadAppPrev.cy, 17) ThenBlock: {
                CadAppPrev.rad = Subtract(CadAppPrev.cy, 1)
                WhileLoop GreaterThan(CadAppPrev.rad, 16) {
                    CadAppPrev.hx = GetByte(CadAppPrev.lab, CadAppPrev.rad)
                    SetByte(CadAppPrev.lab, CadAppPrev.ya, CadAppPrev.hx)
                    CadAppPrev.ya = Add(CadAppPrev.ya, 1)
                    CadAppPrev.rad = Subtract(CadAppPrev.rad, 1)
                }
            }
            SetByte(CadAppPrev.lab, CadAppPrev.ya, 46)
            CadAppPrev.ya = Add(CadAppPrev.ya, 1)
            CadAppPrev.hx = GetByte(CadAppPrev.lab, 16)
            SetByte(CadAppPrev.lab, CadAppPrev.ya, CadAppPrev.hx)
            CadAppPrev.ya = Add(CadAppPrev.ya, 1)
        }
        IfCondition EqualTo(CadAppPrev.xa, 0) ThenBlock: {
            CadAppPrev.rad = Subtract(CadAppPrev.cy, 1)
            WhileLoop GreaterEqual(CadAppPrev.rad, 16) {
                CadAppPrev.hx = GetByte(CadAppPrev.lab, CadAppPrev.rad)
                SetByte(CadAppPrev.lab, CadAppPrev.ya, CadAppPrev.hx)
                CadAppPrev.ya = Add(CadAppPrev.ya, 1)
                CadAppPrev.rad = Subtract(CadAppPrev.rad, 1)
            }
        }
        SetByte(CadAppPrev.lab, CadAppPrev.ya, 0)
        CadAppPrev.hx = FB_RGB(190, 220, 230)
        FB_DrawString(CadAppPrev.xb, CadAppPrev.yb, CadAppPrev.lab, CadAppPrev.hx, -1)
        ReturnValue(0)
    }
}

// Round xy to the grid step when the grid is on. Datum snap stays closer.
Function.CA_SnapToGrid {
    Input: xy: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(CadApp.show_grid, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(xy, 0) ThenBlock: { ReturnValue(0) }
        CadAppPrev.yb = xy
        IfCondition EqualTo(CA_SketchInContext(), 1) ThenBlock: {
            IfCondition EqualTo(CadAppPick.fr, 0) ThenBlock: {
                CadAppPick.fr = Allocate(64)
            }
            IfCondition EqualTo(CadAppPick.fr, 0) ThenBlock: { ReturnValue(0) }
            CA_BuildViewFrame(CadAppPick.fr)
            // Same span and step as the plane grid. hu is only the edge-on fallback.
            CadAppPick.hu = Float_FromInt(40)
            IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                CA_SketchAbsExtent(CadApp.sketch)
            }
            CA_PlaneVisSpan(CadApp.plane, CadAppPick.fr)
            CadAppPrev.hx = CadAppPick.pn
            CadAppPrev.hy = Float_Sub(CadAppPick.by, CadAppPick.bx)
            CadAppPrev.rad = Float_Sub(CadAppPick.best_t, CadAppPick.ov)
            IfCondition EqualTo(Float_Le(CadAppPrev.hy, CadAppPrev.rad), 1) ThenBlock: {
                CadAppPrev.hy = CadAppPrev.rad
            }
        }
        IfCondition EqualTo(CA_SketchInContext(), 0) ThenBlock: {
            CA_UpdateSketchCam()
            CadAppPrev.hx = CadApp.scale
            CadAppPrev.hy = Float_FromInt(80)
            IfCondition EqualTo(CAD_Num.IsZero(CadAppPrev.hx, 0), 0) ThenBlock: {
                CadAppPrev.hy = Float_Div(Float_FromInt(CadApp.width), CadAppPrev.hx)
            }
        }
        CA_GridStep(CadAppPrev.hx, CadAppPrev.hy)
        CadAppPrev.hx = Float_Mul(CadAppPrev.a0, 0x3FE0000000000000)
        CadAppPrev.hy = ArrayGet(CadAppPrev.yb, 0)
        CA_GridRoundAxis()
        ArraySet(CadAppPrev.yb, 0, CadAppPrev.hy)
        CadAppPrev.hy = ArrayGet(CadAppPrev.yb, 1)
        CA_GridRoundAxis()
        ArraySet(CadAppPrev.yb, 1, CadAppPrev.hy)
        ReturnValue(1)
    }
}

Function.CA_DrawSketchGrid {
    Output: Integer
    Body: {
        IfCondition NotEqual(CadApp.show_grid, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CadApp.width, 2) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CadApp.height_px, 2) ThenBlock: { ReturnValue(0) }
        CadAppPrev.step = CadAppPrev.pos
        g = Allocate(128)
        CadAppPrev.pos = g
        IfCondition EqualTo(CadAppPrev.pos, 0) ThenBlock: {
            CadAppPrev.pos = CadAppPrev.step
            CadAppPrev.step = 0
            ReturnValue(0)
        }
        ArraySet(CadAppPrev.pos, 0, CadAppPrev.step)
        g = CadAppPrev.pos
        ArraySet(g, 11, CadAppPrev.k)
        pt = Allocate(32)
        g = CadAppPrev.pos
        ArraySet(g, 1, pt)
        g = CadAppPrev.pos
        ArraySet(g, 8, 0)
        g = CadAppPrev.pos
        pt = ArrayGet(g, 1)
        IfCondition EqualTo(pt, 0) ThenBlock: {
            CA_GridDone()
            ReturnValue(0)
        }
        c = FB_RGB(50, 110, 130)
        CadAppPrev.xa = c
        g = CadAppPrev.pos
        ArraySet(g, 15, CadAppPrev.xa)
        g = CadAppPrev.pos
        ArraySet(g, 6, 0x4024000000000000)
        rc = CA_GridCorner(0, 0)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_GridDone()
            ReturnValue(0)
        }
        CadAppPrev.xa = Subtract(CadApp.width, 1)
        rc = CA_GridCorner(CadAppPrev.xa, 0)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_GridDone()
            ReturnValue(0)
        }
        CadAppPrev.ya = Subtract(CadApp.height_px, 1)
        rc = CA_GridCorner(0, CadAppPrev.ya)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_GridDone()
            ReturnValue(0)
        }
        CadAppPrev.xa = Subtract(CadApp.width, 1)
        CadAppPrev.ya = Subtract(CadApp.height_px, 1)
        rc = CA_GridCorner(CadAppPrev.xa, CadAppPrev.ya)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_GridDone()
            ReturnValue(0)
        }
        CA_GridSpan()
        CadAppPrev.hy = CadAppPrev.xa
        CA_GridStep(CadApp.scale, CadAppPrev.hy)
        g = CadAppPrev.pos
        ArraySet(g, 6, CadAppPrev.a0)
        g = CadAppPrev.pos
        u = ArrayGet(g, 2)
        CadAppPrev.xa = u
        CA_GridSnap()
        CadAppPrev.k = 0
        WhileLoop LessThan(CadAppPrev.k, 140) {
            g = CadAppPrev.pos
            u = ArrayGet(g, 7)
            CadAppPrev.xa = u
            g = CadAppPrev.pos
            umax = ArrayGet(g, 3)
            CadAppPrev.ya = umax
            le = Float_Le(CadAppPrev.xa, CadAppPrev.ya)
            IfCondition EqualTo(le, 0) ThenBlock: { CadAppPrev.k = 140 }
            IfCondition EqualTo(le, 1) ThenBlock: {
                g = CadAppPrev.pos
                u = ArrayGet(g, 7)
                CadAppPrev.xa = u
                g = CadAppPrev.pos
                vmin = ArrayGet(g, 4)
                CadAppPrev.ya = vmin
                g = CadAppPrev.pos
                ArraySet(g, 10, CadAppPrev.xa)
                g = CadAppPrev.pos
                vmax = ArrayGet(g, 5)
                CadAppPrev.xb = vmax
                g = CadAppPrev.pos
                ArraySet(g, 13, CadAppPrev.xb)
                CA_GridSeg()
                g = CadAppPrev.pos
                u = ArrayGet(g, 7)
                CadAppPrev.hx = u
                CadAppPrev.xb = Add(CadAppPrev.xa, 2)
                CadAppPrev.yb = Subtract(CadApp.height_px, 16)
                CA_GridLabel(CadAppPrev.xb, CadAppPrev.yb)
                g = CadAppPrev.pos
                u = ArrayGet(g, 7)
                CadAppPrev.xa = u
                g = CadAppPrev.pos
                st = ArrayGet(g, 6)
                CadAppPrev.ya = st
                nxt = Float_Add(CadAppPrev.xa, CadAppPrev.ya)
                CadAppPrev.xb = nxt
                g = CadAppPrev.pos
                ArraySet(g, 7, CadAppPrev.xb)
                CadAppPrev.k = Add(CadAppPrev.k, 1)
            }
        }
        g = CadAppPrev.pos
        v = ArrayGet(g, 4)
        CadAppPrev.xa = v
        CA_GridSnap()
        CadAppPrev.k = 0
        WhileLoop LessThan(CadAppPrev.k, 140) {
            g = CadAppPrev.pos
            v = ArrayGet(g, 7)
            CadAppPrev.xa = v
            g = CadAppPrev.pos
            vmax = ArrayGet(g, 5)
            CadAppPrev.ya = vmax
            le = Float_Le(CadAppPrev.xa, CadAppPrev.ya)
            IfCondition EqualTo(le, 0) ThenBlock: { CadAppPrev.k = 140 }
            IfCondition EqualTo(le, 1) ThenBlock: {
                g = CadAppPrev.pos
                umin = ArrayGet(g, 2)
                CadAppPrev.xa = umin
                g = CadAppPrev.pos
                v = ArrayGet(g, 7)
                CadAppPrev.ya = v
                g = CadAppPrev.pos
                umax = ArrayGet(g, 3)
                CadAppPrev.xb = umax
                g = CadAppPrev.pos
                ArraySet(g, 10, CadAppPrev.xb)
                g = CadAppPrev.pos
                ArraySet(g, 13, CadAppPrev.ya)
                CA_GridSeg()
                g = CadAppPrev.pos
                v = ArrayGet(g, 7)
                CadAppPrev.hx = v
                CA_GridLabel(4, CadAppPrev.ya)
                g = CadAppPrev.pos
                v = ArrayGet(g, 7)
                CadAppPrev.xa = v
                g = CadAppPrev.pos
                st = ArrayGet(g, 6)
                CadAppPrev.ya = st
                nxt = Float_Add(CadAppPrev.xa, CadAppPrev.ya)
                CadAppPrev.xb = nxt
                g = CadAppPrev.pos
                ArraySet(g, 7, CadAppPrev.xb)
                CadAppPrev.k = Add(CadAppPrev.k, 1)
            }
        }
        CA_GridDone()
        ReturnValue(0)
    }
}

// Screen pixel onto plane_h. UV comes back in dx, dy. 0 = hit.
// The view frame pointer is CadAppPrev.pos slot 5. The plane frame is pl.
Function.CA_PlaneCornerUV {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        // Park the pixel before any call. Inputs do not survive a call.
        CadAppPick.pi = px
        CadAppPick.pj = py
        IfCondition EqualTo(CadAppPrev.pos, 0) ThenBlock: { ReturnValue(-1) }
        CadAppPrev.xa = ArrayGet(CadAppPrev.pos, 5)
        IfCondition EqualTo(CadAppPrev.xa, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadAppPick.pl, 0) ThenBlock: { ReturnValue(-1) }
        CadAppPrev.hx = ArrayGet(CadAppPrev.xa, 3)
        IfCondition EqualTo(CAD_Num.IsZero(CadAppPrev.hx, 0), 1) ThenBlock: { ReturnValue(-1) }
        CadAppPrev.hy = ArrayGet(CadAppPrev.xa, 4)
        CadAppPrev.rad = ArrayGet(CadAppPrev.xa, 5)
        CadAppPrev.cx = Float_FromInt(CadAppPick.pi)
        CadAppPrev.cx = Float_Sub(CadAppPrev.cx, CadAppPrev.hy)
        CadAppPrev.cx = Float_Div(CadAppPrev.cx, CadAppPrev.hx)
        CadAppPrev.cx = Float_Sub(CadAppPrev.cx, CAD_View_State.pan_u)
        CadAppPrev.cy = Float_FromInt(CadAppPick.pj)
        CadAppPrev.cy = Float_Sub(CadAppPrev.rad, CadAppPrev.cy)
        CadAppPrev.cy = Float_Div(CadAppPrev.cy, CadAppPrev.hx)
        CadAppPrev.cy = Float_Sub(CadAppPrev.cy, CAD_View_State.pan_v)
        CadAppPick.wx = ArrayGet(CadAppPrev.xa, 0)
        CadAppPick.wy = ArrayGet(CadAppPrev.xa, 1)
        CadAppPick.wz = ArrayGet(CadAppPrev.xa, 2)
        CadAppPrev.hx = Float_Mul(CadAppPrev.cx, CAD_View_State.b_rx)
        CadAppPrev.hy = Float_Mul(CadAppPrev.cy, CAD_View_State.b_ux)
        CadAppPrev.hx = Float_Add(CadAppPrev.hx, CadAppPrev.hy)
        CadAppPick.wx = Float_Add(CadAppPick.wx, CadAppPrev.hx)
        CadAppPrev.hx = Float_Mul(CadAppPrev.cx, CAD_View_State.b_ry)
        CadAppPrev.hy = Float_Mul(CadAppPrev.cy, CAD_View_State.b_uy)
        CadAppPrev.hx = Float_Add(CadAppPrev.hx, CadAppPrev.hy)
        CadAppPick.wy = Float_Add(CadAppPick.wy, CadAppPrev.hx)
        CadAppPrev.hx = Float_Mul(CadAppPrev.cx, CAD_View_State.b_rz)
        CadAppPrev.hy = Float_Mul(CadAppPrev.cy, CAD_View_State.b_uz)
        CadAppPrev.hx = Float_Add(CadAppPrev.hx, CadAppPrev.hy)
        CadAppPick.wz = Float_Add(CadAppPick.wz, CadAppPrev.hx)
        CadAppPick.nx = ArrayGet(CadAppPick.pl, 9)
        CadAppPick.ny = ArrayGet(CadAppPick.pl, 10)
        CadAppPick.nz = ArrayGet(CadAppPick.pl, 11)
        CadAppPrev.hx = Float_Mul(CAD_View_State.b_dx, CadAppPick.nx)
        CadAppPrev.hy = Float_Mul(CAD_View_State.b_dy, CadAppPick.ny)
        CadAppPrev.hx = Float_Add(CadAppPrev.hx, CadAppPrev.hy)
        CadAppPrev.hy = Float_Mul(CAD_View_State.b_dz, CadAppPick.nz)
        CadAppPrev.hx = Float_Add(CadAppPrev.hx, CadAppPrev.hy)
        IfCondition EqualTo(CAD_Num.IsZero(CadAppPrev.hx, 0), 1) ThenBlock: { ReturnValue(-1) }
        CadAppPick.ox = ArrayGet(CadAppPick.pl, 0)
        CadAppPick.oy = ArrayGet(CadAppPick.pl, 1)
        CadAppPick.oz = ArrayGet(CadAppPick.pl, 2)
        CadAppPrev.ya = Float_Sub(CadAppPick.ox, CadAppPick.wx)
        CadAppPrev.ya = Float_Mul(CadAppPrev.ya, CadAppPick.nx)
        CadAppPrev.step = Float_Sub(CadAppPick.oy, CadAppPick.wy)
        CadAppPrev.step = Float_Mul(CadAppPrev.step, CadAppPick.ny)
        CadAppPrev.ya = Float_Add(CadAppPrev.ya, CadAppPrev.step)
        CadAppPrev.step = Float_Sub(CadAppPick.oz, CadAppPick.wz)
        CadAppPrev.step = Float_Mul(CadAppPrev.step, CadAppPick.nz)
        CadAppPrev.ya = Float_Add(CadAppPrev.ya, CadAppPrev.step)
        CadAppPick.last_t = Float_Div(CadAppPrev.ya, CadAppPrev.hx)
        CadAppPrev.ya = Float_Mul(CadAppPick.last_t, CAD_View_State.b_dx)
        CadAppPick.wx = Float_Add(CadAppPick.wx, CadAppPrev.ya)
        CadAppPrev.ya = Float_Mul(CadAppPick.last_t, CAD_View_State.b_dy)
        CadAppPick.wy = Float_Add(CadAppPick.wy, CadAppPrev.ya)
        CadAppPrev.ya = Float_Mul(CadAppPick.last_t, CAD_View_State.b_dz)
        CadAppPick.wz = Float_Add(CadAppPick.wz, CadAppPrev.ya)
        CadAppPrev.hx = ArrayGet(CadAppPick.pl, 3)
        CadAppPrev.hy = ArrayGet(CadAppPick.pl, 4)
        CadAppPrev.rad = ArrayGet(CadAppPick.pl, 5)
        CadAppPrev.ya = Float_Sub(CadAppPick.wx, CadAppPick.ox)
        CadAppPrev.ya = Float_Mul(CadAppPrev.ya, CadAppPrev.hx)
        CadAppPrev.step = Float_Sub(CadAppPick.wy, CadAppPick.oy)
        CadAppPrev.step = Float_Mul(CadAppPrev.step, CadAppPrev.hy)
        CadAppPrev.ya = Float_Add(CadAppPrev.ya, CadAppPrev.step)
        CadAppPrev.step = Float_Sub(CadAppPick.wz, CadAppPick.oz)
        CadAppPrev.step = Float_Mul(CadAppPrev.step, CadAppPrev.rad)
        CadAppPick.dx = Float_Add(CadAppPrev.ya, CadAppPrev.step)
        CadAppPrev.hx = ArrayGet(CadAppPick.pl, 6)
        CadAppPrev.hy = ArrayGet(CadAppPick.pl, 7)
        CadAppPrev.rad = ArrayGet(CadAppPick.pl, 8)
        CadAppPrev.ya = Float_Sub(CadAppPick.wx, CadAppPick.ox)
        CadAppPrev.ya = Float_Mul(CadAppPrev.ya, CadAppPrev.hx)
        CadAppPrev.step = Float_Sub(CadAppPick.wy, CadAppPick.oy)
        CadAppPrev.step = Float_Mul(CadAppPrev.step, CadAppPrev.hy)
        CadAppPrev.ya = Float_Add(CadAppPrev.ya, CadAppPrev.step)
        CadAppPrev.step = Float_Sub(CadAppPick.wz, CadAppPick.oz)
        CadAppPrev.step = Float_Mul(CadAppPrev.step, CadAppPrev.rad)
        CadAppPick.dy = Float_Add(CadAppPrev.ya, CadAppPrev.step)
        ReturnValue(0)
    }
}

// Visible UV of this plane, same idea as the flat sketch grid.
// bx, by = u min, max. ov, best_t = v min, max. pn = pixels per mm on the plane.
// hu is the fallback half-size when the plane is edge-on.
Function.CA_PlaneVisSpan {
    Input: plane_h: Integer
    Input: vframe: Address
    Output: Integer
    Body: {
        // Park both inputs before any call. A later ArrayGet would drop them.
        CadAppPrev.k = plane_h
        CadAppPick.face = vframe
        CadAppPick.bx = Float_Sub(0, CadAppPick.hu)
        CadAppPick.by = CadAppPick.hu
        CadAppPick.ov = CadAppPick.bx
        CadAppPick.best_t = CadAppPick.hu
        CadAppPick.pn = 0
        IfCondition NotEqual(CadAppPick.face, 0) ThenBlock: {
            CadAppPick.pn = ArrayGet(CadAppPick.face, 3)
        }
        IfCondition EqualTo(CadAppPrev.k, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadAppPick.face, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CadApp.width, 2) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CadApp.height_px, 2) ThenBlock: { ReturnValue(0) }
        CadAppPrev.xb = CadAppPrev.pos
        CadAppPrev.pos = Allocate(64)
        IfCondition EqualTo(CadAppPrev.pos, 0) ThenBlock: {
            CadAppPrev.pos = CadAppPrev.xb
            ReturnValue(0)
        }
        ArraySet(CadAppPrev.pos, 6, CadAppPrev.xb)
        ArraySet(CadAppPrev.pos, 5, CadAppPick.face)
        ArraySet(CadAppPrev.pos, 4, CadAppPick.pn)
        // Slot 0. A 64-byte block keeps the freelist word at offset 0,
        // and ArraySet element 0 starts at +8, so slot 7 is the next block.
        ArraySet(CadAppPrev.pos, 0, 0)
        IfCondition EqualTo(CAD_View_State.b_ok, 0) ThenBlock: {
            CAD_View.BuildBasis()
        }
        CA_PickBufs()
        IfCondition EqualTo(CadAppPick.pl, 0) ThenBlock: {
            CadAppPrev.xb = ArrayGet(CadAppPrev.pos, 6)
            Deallocate(CadAppPrev.pos, 64)
            CadAppPrev.pos = CadAppPrev.xb
            ReturnValue(0)
        }
        IfCondition EqualTo(CadAppPick.pr, 0) ThenBlock: {
            CadAppPrev.xb = ArrayGet(CadAppPrev.pos, 6)
            Deallocate(CadAppPrev.pos, 64)
            CadAppPrev.pos = CadAppPrev.xb
            ReturnValue(0)
        }
        CAD_Plane.EvalFrame(CadAppPrev.k, CadAppPick.pl)
        CadAppPick.face = CadAppPrev.k
        CadAppPick.ox = ArrayGet(CadAppPick.pl, 0)
        CadAppPick.oy = ArrayGet(CadAppPick.pl, 1)
        CadAppPick.oz = ArrayGet(CadAppPick.pl, 2)
        CadAppPrev.xa = ArrayGet(CadAppPrev.pos, 5)
        CAD_View.ProjectPoint(CadAppPick.ox, CadAppPick.oy, CadAppPick.oz, CadAppPrev.xa, CadAppPick.pr)
        CadAppPick.wx = ArrayGet(CadAppPick.pr, 0)
        CadAppPick.wy = ArrayGet(CadAppPick.pr, 1)
        CadAppPrev.hx = ArrayGet(CadAppPick.pl, 3)
        CadAppPrev.hy = ArrayGet(CadAppPick.pl, 4)
        CadAppPrev.rad = ArrayGet(CadAppPick.pl, 5)
        CadAppPrev.hx = Float_Mul(CadAppPrev.hx, 0x4024000000000000)
        CadAppPrev.hy = Float_Mul(CadAppPrev.hy, 0x4024000000000000)
        CadAppPrev.rad = Float_Mul(CadAppPrev.rad, 0x4024000000000000)
        CadAppPick.nx = Float_Add(CadAppPick.ox, CadAppPrev.hx)
        CadAppPick.ny = Float_Add(CadAppPick.oy, CadAppPrev.hy)
        CadAppPick.nz = Float_Add(CadAppPick.oz, CadAppPrev.rad)
        CadAppPrev.xa = ArrayGet(CadAppPrev.pos, 5)
        CAD_View.ProjectPoint(CadAppPick.nx, CadAppPick.ny, CadAppPick.nz, CadAppPrev.xa, CadAppPick.pr)
        CadAppPrev.cx = ArrayGet(CadAppPick.pr, 0)
        CadAppPrev.cy = ArrayGet(CadAppPick.pr, 1)
        CadAppPrev.hx = Float_Sub(CadAppPrev.cx, CadAppPick.wx)
        CadAppPrev.hy = Float_Sub(CadAppPrev.cy, CadAppPick.wy)
        CadAppPrev.hx = Float_Mul(CadAppPrev.hx, CadAppPrev.hx)
        CadAppPrev.hy = Float_Mul(CadAppPrev.hy, CadAppPrev.hy)
        CadAppPrev.hx = Float_Add(CadAppPrev.hx, CadAppPrev.hy)
        CadAppPrev.a0 = CAD_Num.Sqrt(CadAppPrev.hx)
        CadAppPrev.hx = ArrayGet(CadAppPick.pl, 6)
        CadAppPrev.hy = ArrayGet(CadAppPick.pl, 7)
        CadAppPrev.rad = ArrayGet(CadAppPick.pl, 8)
        CadAppPrev.hx = Float_Mul(CadAppPrev.hx, 0x4024000000000000)
        CadAppPrev.hy = Float_Mul(CadAppPrev.hy, 0x4024000000000000)
        CadAppPrev.rad = Float_Mul(CadAppPrev.rad, 0x4024000000000000)
        CadAppPick.nx = Float_Add(CadAppPick.ox, CadAppPrev.hx)
        CadAppPick.ny = Float_Add(CadAppPick.oy, CadAppPrev.hy)
        CadAppPick.nz = Float_Add(CadAppPick.oz, CadAppPrev.rad)
        CadAppPrev.xa = ArrayGet(CadAppPrev.pos, 5)
        CAD_View.ProjectPoint(CadAppPick.nx, CadAppPick.ny, CadAppPick.nz, CadAppPrev.xa, CadAppPick.pr)
        CadAppPrev.cx = ArrayGet(CadAppPick.pr, 0)
        CadAppPrev.cy = ArrayGet(CadAppPick.pr, 1)
        CadAppPrev.hx = Float_Sub(CadAppPrev.cx, CadAppPick.wx)
        CadAppPrev.hy = Float_Sub(CadAppPrev.cy, CadAppPick.wy)
        CadAppPrev.hx = Float_Mul(CadAppPrev.hx, CadAppPrev.hx)
        CadAppPrev.hy = Float_Mul(CadAppPrev.hy, CadAppPrev.hy)
        CadAppPrev.hx = Float_Add(CadAppPrev.hx, CadAppPrev.hy)
        CadAppPrev.hx = CAD_Num.Sqrt(CadAppPrev.hx)
        // Pixels per mm of each axis. Slot 7 is the next block, so 1 and 2.
        CadAppPrev.rad = Float_Div(CadAppPrev.a0, 0x4024000000000000)
        ArraySet(CadAppPrev.pos, 1, CadAppPrev.rad)
        CadAppPrev.rad = Float_Div(CadAppPrev.hx, 0x4024000000000000)
        ArraySet(CadAppPrev.pos, 2, CadAppPrev.rad)
        IfCondition EqualTo(Float_Le(CadAppPrev.a0, CadAppPrev.hx), 1) ThenBlock: {
            CadAppPrev.a0 = CadAppPrev.hx
        }
        CadAppPrev.a0 = Float_Div(CadAppPrev.a0, 0x4024000000000000)
        IfCondition EqualTo(Float_Le(0x3F947AE147AE147B, CadAppPrev.a0), 1) ThenBlock: {
            CadAppPick.pn = CadAppPrev.a0
        }
        CadAppPick.pins = 0
        WhileLoop LessThan(CadAppPick.pins, 4) {
            CadAppPrev.cx = 0
            IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: {
                CadAppPrev.cx = Subtract(CadApp.width, 1)
            }
            IfCondition EqualTo(CadAppPick.pins, 3) ThenBlock: {
                CadAppPrev.cx = Subtract(CadApp.width, 1)
            }
            CadAppPrev.cy = 0
            IfCondition GreaterEqual(CadAppPick.pins, 2) ThenBlock: {
                CadAppPrev.cy = Subtract(CadApp.height_px, 1)
            }
            CadAppPrev.k = CA_PlaneCornerUV(CadAppPrev.cx, CadAppPrev.cy)
            IfCondition EqualTo(CadAppPrev.k, 0) ThenBlock: {
                CadAppPrev.xa = CAD_Num.Abs(CadAppPick.dx)
                CadAppPrev.ya = CAD_Num.Abs(CadAppPick.dy)
                CadAppPrev.hx = Float_FromInt(100000)
                CadAppPrev.k = 0
                IfCondition EqualTo(Float_Le(CadAppPrev.hx, CadAppPrev.xa), 1) ThenBlock: {
                    CadAppPrev.k = 1
                }
                IfCondition EqualTo(Float_Le(CadAppPrev.hx, CadAppPrev.ya), 1) ThenBlock: {
                    CadAppPrev.k = 1
                }
                IfCondition EqualTo(CadAppPrev.k, 0) ThenBlock: {
                    CadAppPrev.rad = ArrayGet(CadAppPrev.pos, 0)
                    IfCondition EqualTo(CadAppPrev.rad, 0) ThenBlock: {
                        CadAppPick.bx = CadAppPick.dx
                        CadAppPick.by = CadAppPick.dx
                        CadAppPick.ov = CadAppPick.dy
                        CadAppPick.best_t = CadAppPick.dy
                    }
                    IfCondition NotEqual(CadAppPrev.rad, 0) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CadAppPick.dx, CadAppPick.bx), 1) ThenBlock: {
                            CadAppPick.bx = CadAppPick.dx
                        }
                        IfCondition EqualTo(Float_Le(CadAppPick.by, CadAppPick.dx), 1) ThenBlock: {
                            CadAppPick.by = CadAppPick.dx
                        }
                        IfCondition EqualTo(Float_Le(CadAppPick.dy, CadAppPick.ov), 1) ThenBlock: {
                            CadAppPick.ov = CadAppPick.dy
                        }
                        IfCondition EqualTo(Float_Le(CadAppPick.best_t, CadAppPick.dy), 1) ThenBlock: {
                            CadAppPick.best_t = CadAppPick.dy
                        }
                    }
                    CadAppPrev.cx = Add(CadAppPrev.rad, 1)
                    ArraySet(CadAppPrev.pos, 0, CadAppPrev.cx)
                }
            }
            CadAppPick.pins = Add(CadAppPick.pins, 1)
        }
        CadAppPrev.rad = ArrayGet(CadAppPrev.pos, 0)
        IfCondition LessThan(CadAppPrev.rad, 2) ThenBlock: {
            CadAppPick.bx = Float_Sub(0, CadAppPick.hu)
            CadAppPick.by = CadAppPick.hu
            CadAppPick.ov = CadAppPick.bx
            CadAppPick.best_t = CadAppPick.hu
            CadAppPick.pn = ArrayGet(CadAppPrev.pos, 4)
        }
        // A grazing axis maps the screen onto tens of thousands of mm.
        // The ruler then prints 17500 beside a normal 20 mm axis.
        // That axis keeps the sketch extent. The face-on axis still fills the view.
        CadAppPrev.hx = ArrayGet(CadAppPrev.pos, 4)
        CadAppPrev.cx = CAD_Num.IsZero(CadAppPrev.hx, 0)
        IfCondition EqualTo(CadAppPrev.cx, 0) ThenBlock: {
            CadAppPrev.hy = Float_Mul(CadAppPrev.hx, 0x3FC999999999999A)
            CadAppPrev.rad = ArrayGet(CadAppPrev.pos, 1)
            IfCondition EqualTo(Float_Le(CadAppPrev.rad, CadAppPrev.hy), 1) ThenBlock: {
                CadAppPick.bx = Float_Sub(0, CadAppPick.hu)
                CadAppPick.by = CadAppPick.hu
            }
            CadAppPrev.rad = ArrayGet(CadAppPrev.pos, 2)
            IfCondition EqualTo(Float_Le(CadAppPrev.rad, CadAppPrev.hy), 1) ThenBlock: {
                CadAppPick.ov = Float_Sub(0, CadAppPick.hu)
                CadAppPick.best_t = CadAppPick.hu
            }
        }
        CadAppPrev.xb = ArrayGet(CadAppPrev.pos, 6)
        Deallocate(CadAppPrev.pos, 64)
        CadAppPrev.pos = CadAppPrev.xb
        ReturnValue(1)
    }
}
