// Loft pick paints each closed profile as its own face.
// The large face is light red. A smaller face inside it is orange.
// Each chosen end is yellow. The rest of the sketch stays put.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_Num
LibraryImport.Display.Render.Framebuffer

// tmp_b slots while this draw runs:
// 0 saved tmp_b, 1 frame, 2 xy, 3 pixels, 4 sketch index, 5 nprof,
// 6 profile, 7 max area, 8 area, 9 color, 10 plane, 11 sketch,
// 12 count, 13 vertex, 14 pass, 15 red, 16 orange, 17 yellow,
// 18 half area, 20 depth table, 21 how many, 22 scan, 23 best,
// 24 best depth, 25 painted, 26 picked, 27 anchor color, 28 edge,
// 30 world x, 31 world y, 32 world z, 34 map scratch.

Function.CA_LoftFaceProject {
    Output: Integer
    Body: {
        ArraySet(CadApp.tmp_b, 13, 0)
        WhileLoop LessThan(ArrayGet(CadApp.tmp_b, 13), ArrayGet(CadApp.tmp_b, 12)) {
            CadAppPick.bx = Multiply(ArrayGet(CadApp.tmp_b, 13), 2)
            CadAppPick.hv = ArrayGet(CadApp.tmp_b, 2)
            CadAppPick.hu = ArrayGet(CadAppPick.hv, CadAppPick.bx)
            CadAppPick.bx = Add(CadAppPick.bx, 1)
            CadAppPick.hv = ArrayGet(CadApp.tmp_b, 2)
            CadAppPick.clk_x = ArrayGet(CadAppPick.hv, CadAppPick.bx)
            CadAppPick.ax = ArrayGet(CadApp.tmp_b, 10)
            CadAppPick.ay = ArrayGet(CadApp.tmp_b, 34)
            CAD_Plane.MapLocal(CadAppPick.ax, CadAppPick.hu, CadAppPick.clk_x, 0, CadAppPick.ay)
            CadAppPick.ax = ArrayGet(CadApp.tmp_b, 34)
            ArraySet(CadApp.tmp_b, 30, ArrayGet(CadAppPick.ax, 0))
            ArraySet(CadApp.tmp_b, 31, ArrayGet(CadAppPick.ax, 1))
            ArraySet(CadApp.tmp_b, 32, ArrayGet(CadAppPick.ax, 2))
            CadAppPick.hu = ArrayGet(CadApp.tmp_b, 30)
            CadAppPick.hv = ArrayGet(CadApp.tmp_b, 31)
            CadAppPick.hit_a = ArrayGet(CadApp.tmp_b, 32)
            CadAppPick.ax = ArrayGet(CadApp.tmp_b, 1)
            CadAppPick.ay = ArrayGet(CadApp.tmp_b, 34)
            CA_World3ToPix(CadAppPick.hu, CadAppPick.hv, CadAppPick.hit_a, CadAppPick.ax, CadAppPick.ay)
            CadAppPick.ax = ArrayGet(CadApp.tmp_b, 34)
            CadAppPick.hu = ArrayGet(CadAppPick.ax, 0)
            CadAppPick.clk_x = ArrayGet(CadAppPick.ax, 1)
            CadAppPick.bx = Multiply(ArrayGet(CadApp.tmp_b, 13), 2)
            CadAppPick.hv = ArrayGet(CadApp.tmp_b, 3)
            ArraySet(CadAppPick.hv, CadAppPick.bx, CadAppPick.hu)
            CadAppPick.bx = Add(CadAppPick.bx, 1)
            ArraySet(CadAppPick.hv, CadAppPick.bx, CadAppPick.clk_x)
            CadAppPick.bx = ArrayGet(CadApp.tmp_b, 13)
            ArraySet(CadApp.tmp_b, 13, Add(CadAppPick.bx, 1))
        }
        ReturnValue(0)
    }
}

Function.CA_LoftFaceFill {
    Output: Integer
    Body: {
        CadAppPick.ax = ArrayGet(CadApp.tmp_b, 11)
        CadAppPick.ay = ArrayGet(CadApp.tmp_b, 6)
        CadAppPick.hv = ArrayGet(CadApp.tmp_b, 2)
        CadAppPick.prof_nn = CAD_Sketch.GetProfileXY(CadAppPick.ax, CadAppPick.ay, CadAppPick.hv)
        ArraySet(CadApp.tmp_b, 12, CadAppPick.prof_nn)
        IfCondition LessThan(CadAppPick.prof_nn, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(CadAppPick.prof_nn, 256) ThenBlock: { ReturnValue(0) }
        CadAppPick.hv = ArrayGet(CadApp.tmp_b, 2)
        CadAppPick.hit_a = CAD_Sketch.LoopSignedArea(CadAppPick.hv, ArrayGet(CadApp.tmp_b, 12))
        CadAppPick.hit_a = CAD_Num.Abs(CadAppPick.hit_a)
        ArraySet(CadApp.tmp_b, 8, CadAppPick.hit_a)
        CadAppPick.pins = 0
        IfCondition EqualTo(ArrayGet(CadApp.tmp_b, 14), 0) ThenBlock: {
            IfCondition EqualTo(Float_Le(ArrayGet(CadApp.tmp_b, 18), CadAppPick.hit_a), 1) ThenBlock: {
                CadAppPick.pins = 1
            }
        }
        IfCondition EqualTo(ArrayGet(CadApp.tmp_b, 14), 1) ThenBlock: {
            IfCondition EqualTo(Float_Le(CadAppPick.hit_a, ArrayGet(CadApp.tmp_b, 18)), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(ArrayGet(CadApp.tmp_b, 18), CadAppPick.hit_a), 0) ThenBlock: {
                    CadAppPick.pins = 1
                }
            }
        }
        IfCondition EqualTo(CadAppPick.pins, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = ArrayGet(CadApp.tmp_b, 15)
        IfCondition EqualTo(ArrayGet(CadApp.tmp_b, 14), 1) ThenBlock: {
            CadAppPick.ax = ArrayGet(CadApp.tmp_b, 16)
        }
        ArraySet(CadApp.tmp_b, 26, 0)
        IfCondition GreaterEqual(CadApp.nclick, 1) ThenBlock: {
            IfCondition EqualTo(CadApp.fillet_li, ArrayGet(CadApp.tmp_b, 4)) ThenBlock: {
                IfCondition EqualTo(CadApp.fillet_lj, ArrayGet(CadApp.tmp_b, 6)) ThenBlock: {
                    CadAppPick.ax = ArrayGet(CadApp.tmp_b, 17)
                    ArraySet(CadApp.tmp_b, 26, 1)
                }
            }
        }
        IfCondition GreaterEqual(CadApp.nclick, 2) ThenBlock: {
            IfCondition EqualTo(CadApp.cstr_ia, ArrayGet(CadApp.tmp_b, 4)) ThenBlock: {
                IfCondition EqualTo(CadApp.cstr_ib, ArrayGet(CadApp.tmp_b, 6)) ThenBlock: {
                    CadAppPick.ax = ArrayGet(CadApp.tmp_b, 17)
                    ArraySet(CadApp.tmp_b, 26, 1)
                }
            }
        }
        ArraySet(CadApp.tmp_b, 9, CadAppPick.ax)
        CA_LoftFaceProject()
        CadAppPick.ax = ArrayGet(CadApp.tmp_b, 3)
        CadAppPick.pins = ArrayGet(CadApp.tmp_b, 12)
        CadAppPick.bx = ArrayGet(CadApp.tmp_b, 9)
        CA_FillPolyPx(CadAppPick.ax, CadAppPick.pins, CadAppPick.bx)
        IfCondition LessEqual(ArrayGet(CadApp.tmp_b, 12), 12) ThenBlock: {
            ArraySet(CadApp.tmp_b, 13, 0)
            WhileLoop LessThan(ArrayGet(CadApp.tmp_b, 13), ArrayGet(CadApp.tmp_b, 12)) {
                CadAppPick.bx = Multiply(ArrayGet(CadApp.tmp_b, 13), 2)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 3)
                CadAppPick.hu = ArrayGet(CadAppPick.hv, CadAppPick.bx)
                CadAppPick.bx = Add(CadAppPick.bx, 1)
                CadAppPick.clk_x = ArrayGet(CadAppPick.hv, CadAppPick.bx)
                FB_FillRect(Subtract(CadAppPick.hu, 3), Subtract(CadAppPick.clk_x, 3), 7, 7, ArrayGet(CadApp.tmp_b, 27))
                ArraySet(CadApp.tmp_b, 13, Add(ArrayGet(CadApp.tmp_b, 13), 1))
            }
        }
        IfCondition EqualTo(ArrayGet(CadApp.tmp_b, 26), 1) ThenBlock: {
            ArraySet(CadApp.tmp_b, 13, 0)
            WhileLoop LessThan(ArrayGet(CadApp.tmp_b, 13), ArrayGet(CadApp.tmp_b, 12)) {
                CadAppPick.bx = Multiply(ArrayGet(CadApp.tmp_b, 13), 2)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 3)
                CadAppPick.hu = ArrayGet(CadAppPick.hv, CadAppPick.bx)
                CadAppPick.bx = Add(CadAppPick.bx, 1)
                CadAppPick.clk_x = ArrayGet(CadAppPick.hv, CadAppPick.bx)
                CadAppPick.by = Add(ArrayGet(CadApp.tmp_b, 13), 1)
                IfCondition EqualTo(CadAppPick.by, ArrayGet(CadApp.tmp_b, 12)) ThenBlock: { CadAppPick.by = 0 }
                CadAppPick.pi = Multiply(CadAppPick.by, 2)
                CadAppPick.hit_a = ArrayGet(CadAppPick.hv, CadAppPick.pi)
                CadAppPick.pi = Add(CadAppPick.pi, 1)
                CadAppPick.found_n = ArrayGet(CadAppPick.hv, CadAppPick.pi)
                FB_Line(CadAppPick.hu, CadAppPick.clk_x, CadAppPick.hit_a, CadAppPick.found_n, ArrayGet(CadApp.tmp_b, 28))
                ArraySet(CadApp.tmp_b, 13, Add(ArrayGet(CadApp.tmp_b, 13), 1))
            }
        }
        ReturnValue(1)
    }
}

Function.CA_LoftFaceSketch {
    Output: Integer
    Body: {
        CadAppPick.ax = ArrayGet(CadApp.sk_list, ArrayGet(CadApp.tmp_b, 4))
        ArraySet(CadApp.tmp_b, 11, CadAppPick.ax)
        CadAppPick.ax = CAD_Sketch.GetPlaneId(ArrayGet(CadApp.tmp_b, 11))
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { CadAppPick.ax = CadApp.plane }
        ArraySet(CadApp.tmp_b, 10, CadAppPick.ax)
        CadAppPick.pins = CAD_Store.Read(ArrayGet(CadApp.tmp_b, 11), 12)
        IfCondition GreaterThan(CadAppPick.pins, 32) ThenBlock: { CadAppPick.pins = 32 }
        ArraySet(CadApp.tmp_b, 5, CadAppPick.pins)
        IfCondition LessThan(CadAppPick.pins, 1) ThenBlock: { ReturnValue(0) }
        ArraySet(CadApp.tmp_b, 7, 0)
        ArraySet(CadApp.tmp_b, 6, 0)
        WhileLoop LessThan(ArrayGet(CadApp.tmp_b, 6), ArrayGet(CadApp.tmp_b, 5)) {
            CadAppPick.ax = ArrayGet(CadApp.tmp_b, 11)
            CadAppPick.ay = ArrayGet(CadApp.tmp_b, 6)
            CadAppPick.hv = ArrayGet(CadApp.tmp_b, 2)
            CadAppPick.prof_nn = CAD_Sketch.GetProfileXY(CadAppPick.ax, CadAppPick.ay, CadAppPick.hv)
            IfCondition GreaterEqual(CadAppPick.prof_nn, 3) ThenBlock: {
                CadAppPick.hit_a = CAD_Sketch.LoopSignedArea(ArrayGet(CadApp.tmp_b, 2), CadAppPick.prof_nn)
                CadAppPick.hit_a = CAD_Num.Abs(CadAppPick.hit_a)
                CadAppPick.pins = 0
                IfCondition EqualTo(CAD_Num.IsZero(ArrayGet(CadApp.tmp_b, 7), 0), 1) ThenBlock: { CadAppPick.pins = 1 }
                IfCondition EqualTo(Float_Le(ArrayGet(CadApp.tmp_b, 7), CadAppPick.hit_a), 1) ThenBlock: { CadAppPick.pins = 1 }
                IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: { ArraySet(CadApp.tmp_b, 7, CadAppPick.hit_a) }
            }
            ArraySet(CadApp.tmp_b, 6, Add(ArrayGet(CadApp.tmp_b, 6), 1))
        }
        CadAppPick.hit_a = Float_Mul(ArrayGet(CadApp.tmp_b, 7), 0x3FE0000000000000)
        ArraySet(CadApp.tmp_b, 18, CadAppPick.hit_a)
        ArraySet(CadApp.tmp_b, 14, 0)
        WhileLoop LessThan(ArrayGet(CadApp.tmp_b, 14), 2) {
            ArraySet(CadApp.tmp_b, 6, 0)
            WhileLoop LessThan(ArrayGet(CadApp.tmp_b, 6), ArrayGet(CadApp.tmp_b, 5)) {
                CA_LoftFaceFill()
                ArraySet(CadApp.tmp_b, 6, Add(ArrayGet(CadApp.tmp_b, 6), 1))
            }
            ArraySet(CadApp.tmp_b, 14, Add(ArrayGet(CadApp.tmp_b, 14), 1))
        }
        ReturnValue(0)
    }
}

Function.CA_LoftFaceDepth {
    Output: Integer
    Body: {
        CadAppPick.ax = ArrayGet(CadApp.sk_list, ArrayGet(CadApp.tmp_b, 4))
        ArraySet(CadApp.tmp_b, 11, CadAppPick.ax)
        CadAppPick.pins = CAD_Store.Read(CadAppPick.ax, 12)
        IfCondition LessThan(CadAppPick.pins, 1) ThenBlock: { ReturnValue(0) }
        CadAppPick.hv = ArrayGet(CadApp.tmp_b, 2)
        CadAppPick.prof_nn = CAD_Sketch.GetProfileXY(ArrayGet(CadApp.tmp_b, 11), 0, CadAppPick.hv)
        IfCondition LessThan(CadAppPick.prof_nn, 3) ThenBlock: { ReturnValue(0) }
        ArraySet(CadApp.tmp_b, 30, 0)
        ArraySet(CadApp.tmp_b, 31, 0)
        ArraySet(CadApp.tmp_b, 13, 0)
        ArraySet(CadApp.tmp_b, 12, CadAppPick.prof_nn)
        WhileLoop LessThan(ArrayGet(CadApp.tmp_b, 13), ArrayGet(CadApp.tmp_b, 12)) {
            CadAppPick.bx = Multiply(ArrayGet(CadApp.tmp_b, 13), 2)
            CadAppPick.hv = ArrayGet(CadApp.tmp_b, 2)
            CadAppPick.hu = ArrayGet(CadAppPick.hv, CadAppPick.bx)
            ArraySet(CadApp.tmp_b, 30, Float_Add(ArrayGet(CadApp.tmp_b, 30), CadAppPick.hu))
            CadAppPick.bx = Add(CadAppPick.bx, 1)
            CadAppPick.hu = ArrayGet(CadAppPick.hv, CadAppPick.bx)
            ArraySet(CadApp.tmp_b, 31, Float_Add(ArrayGet(CadApp.tmp_b, 31), CadAppPick.hu))
            ArraySet(CadApp.tmp_b, 13, Add(ArrayGet(CadApp.tmp_b, 13), 1))
        }
        CadAppPick.hu = Float_Div(0x3FF0000000000000, Float_FromInt(ArrayGet(CadApp.tmp_b, 12)))
        ArraySet(CadApp.tmp_b, 30, Float_Mul(ArrayGet(CadApp.tmp_b, 30), CadAppPick.hu))
        ArraySet(CadApp.tmp_b, 31, Float_Mul(ArrayGet(CadApp.tmp_b, 31), CadAppPick.hu))
        CadAppPick.ax = CAD_Sketch.GetPlaneId(ArrayGet(CadApp.tmp_b, 11))
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { CadAppPick.ax = CadApp.plane }
        ArraySet(CadApp.tmp_b, 10, CadAppPick.ax)
        CadAppPick.ay = ArrayGet(CadApp.tmp_b, 34)
        CAD_Plane.MapLocal(CadAppPick.ax, ArrayGet(CadApp.tmp_b, 30), ArrayGet(CadApp.tmp_b, 31), 0, CadAppPick.ay)
        CadAppPick.ax = ArrayGet(CadApp.tmp_b, 34)
        ArraySet(CadApp.tmp_b, 30, ArrayGet(CadAppPick.ax, 0))
        ArraySet(CadApp.tmp_b, 31, ArrayGet(CadAppPick.ax, 1))
        ArraySet(CadApp.tmp_b, 32, ArrayGet(CadAppPick.ax, 2))
        CA_World3ToPix(ArrayGet(CadApp.tmp_b, 30), ArrayGet(CadApp.tmp_b, 31), ArrayGet(CadApp.tmp_b, 32), ArrayGet(CadApp.tmp_b, 1), ArrayGet(CadApp.tmp_b, 34))
        CadAppPick.ax = ArrayGet(CadApp.tmp_b, 34)
        CadAppPick.hv = ArrayGet(CadApp.tmp_b, 20)
        ArraySet(CadAppPick.hv, ArrayGet(CadApp.tmp_b, 21), ArrayGet(CadAppPick.ax, 2))
        CadAppPick.bx = Add(ArrayGet(CadApp.tmp_b, 21), 32)
        ArraySet(CadAppPick.hv, CadAppPick.bx, ArrayGet(CadApp.tmp_b, 4))
        ArraySet(CadApp.tmp_b, 21, Add(ArrayGet(CadApp.tmp_b, 21), 1))
        ReturnValue(1)
    }
}

Function.CA_DrawLoftFaces {
    Input: vframe: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(CadApp.tool, 21) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vframe, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CadApp.sk_n, 1) ThenBlock: { ReturnValue(0) }
        CadAppPick.hv = vframe
        CadAppPick.ax = Allocate(512)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CadAppPick.ax, 0, CadApp.tmp_b)
        ArraySet(CadAppPick.ax, 1, CadAppPick.hv)
        CadApp.tmp_b = CadAppPick.ax
        CadAppPick.ax = Allocate(65536)
        ArraySet(CadApp.tmp_b, 2, CadAppPick.ax)
        CadAppPick.ax = Allocate(65536)
        ArraySet(CadApp.tmp_b, 3, CadAppPick.ax)
        CadAppPick.ax = Allocate(512)
        ArraySet(CadApp.tmp_b, 20, CadAppPick.ax)
        CadAppPick.ax = Allocate(32)
        ArraySet(CadApp.tmp_b, 34, CadAppPick.ax)
        CadAppPick.found_n = 1
        IfCondition EqualTo(ArrayGet(CadApp.tmp_b, 2), 0) ThenBlock: { CadAppPick.found_n = 0 }
        IfCondition EqualTo(ArrayGet(CadApp.tmp_b, 3), 0) ThenBlock: { CadAppPick.found_n = 0 }
        IfCondition EqualTo(ArrayGet(CadApp.tmp_b, 20), 0) ThenBlock: { CadAppPick.found_n = 0 }
        IfCondition EqualTo(ArrayGet(CadApp.tmp_b, 34), 0) ThenBlock: { CadAppPick.found_n = 0 }
        IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
            ArraySet(CadApp.tmp_b, 15, FB_RGB(176, 64, 70))
            ArraySet(CadApp.tmp_b, 16, FB_RGB(232, 120, 40))
            ArraySet(CadApp.tmp_b, 17, FB_RGB(240, 200, 40))
            ArraySet(CadApp.tmp_b, 27, FB_RGB(255, 120, 80))
            ArraySet(CadApp.tmp_b, 28, FB_RGB(255, 30, 30))
            ArraySet(CadApp.tmp_b, 21, 0)
            ArraySet(CadApp.tmp_b, 4, 0)
            WhileLoop LessThan(ArrayGet(CadApp.tmp_b, 4), CadApp.sk_n) {
                IfCondition LessThan(ArrayGet(CadApp.tmp_b, 21), 30) ThenBlock: { CA_LoftFaceDepth() }
                ArraySet(CadApp.tmp_b, 4, Add(ArrayGet(CadApp.tmp_b, 4), 1))
            }
            ArraySet(CadApp.tmp_b, 25, 0)
            WhileLoop LessThan(ArrayGet(CadApp.tmp_b, 25), ArrayGet(CadApp.tmp_b, 21)) {
                ArraySet(CadApp.tmp_b, 23, -1)
                ArraySet(CadApp.tmp_b, 22, 0)
                WhileLoop LessThan(ArrayGet(CadApp.tmp_b, 22), ArrayGet(CadApp.tmp_b, 21)) {
                    CadAppPick.hv = ArrayGet(CadApp.tmp_b, 20)
                    CadAppPick.bx = Add(ArrayGet(CadApp.tmp_b, 22), 32)
                    CadAppPick.ax = ArrayGet(CadAppPick.hv, CadAppPick.bx)
                    IfCondition GreaterEqual(CadAppPick.ax, 0) ThenBlock: {
                        CadAppPick.hu = ArrayGet(CadAppPick.hv, ArrayGet(CadApp.tmp_b, 22))
                        CadAppPick.pins = 0
                        IfCondition EqualTo(ArrayGet(CadApp.tmp_b, 23), -1) ThenBlock: { CadAppPick.pins = 1 }
                        IfCondition EqualTo(CadAppPick.pins, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsEqual(CadAppPick.hu, ArrayGet(CadApp.tmp_b, 24), 0), 0) ThenBlock: {
                                IfCondition EqualTo(Float_Le(CadAppPick.hu, ArrayGet(CadApp.tmp_b, 24)), 1) ThenBlock: {
                                    CadAppPick.pins = 1
                                }
                            }
                        }
                        IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: {
                            ArraySet(CadApp.tmp_b, 23, ArrayGet(CadApp.tmp_b, 22))
                            ArraySet(CadApp.tmp_b, 24, CadAppPick.hu)
                        }
                    }
                    ArraySet(CadApp.tmp_b, 22, Add(ArrayGet(CadApp.tmp_b, 22), 1))
                }
                IfCondition LessThan(ArrayGet(CadApp.tmp_b, 23), 0) ThenBlock: {
                    ArraySet(CadApp.tmp_b, 25, ArrayGet(CadApp.tmp_b, 21))
                }
                IfCondition GreaterEqual(ArrayGet(CadApp.tmp_b, 23), 0) ThenBlock: {
                    CadAppPick.hv = ArrayGet(CadApp.tmp_b, 20)
                    CadAppPick.bx = Add(ArrayGet(CadApp.tmp_b, 23), 32)
                    ArraySet(CadApp.tmp_b, 4, ArrayGet(CadAppPick.hv, CadAppPick.bx))
                    ArraySet(CadAppPick.hv, CadAppPick.bx, -1)
                    CA_LoftFaceSketch()
                    ArraySet(CadApp.tmp_b, 25, Add(ArrayGet(CadApp.tmp_b, 25), 1))
                }
            }
        }
        CadAppPick.ax = ArrayGet(CadApp.tmp_b, 2)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: { Deallocate(CadAppPick.ax, 65536) }
        CadAppPick.ax = ArrayGet(CadApp.tmp_b, 3)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: { Deallocate(CadAppPick.ax, 65536) }
        CadAppPick.ax = ArrayGet(CadApp.tmp_b, 20)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: { Deallocate(CadAppPick.ax, 512) }
        CadAppPick.ax = ArrayGet(CadApp.tmp_b, 34)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: { Deallocate(CadAppPick.ax, 32) }
        CadAppPick.ay = ArrayGet(CadApp.tmp_b, 0)
        CadAppPick.ax = CadApp.tmp_b
        CadApp.tmp_b = CadAppPick.ay
        Deallocate(CadAppPick.ax, 512)
        ReturnValue(0)
    }
}
