// Every sketch in the isometric view, so a loft can show two profiles.
// Lines, circles, and arcs. A 2D fillet corner is an arc.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Num
LibraryImport.Display.Render.Framebuffer

// vframe is the live 3D frame. A loft pick fills that one profile yellow.

// One sketch segment. pa and pb are pixel records from CA_World3ToPix
// (x, y, view depth). In the model view a curve on the face you are
// looking at stays, and the body still hides a curve behind it.
// Sketch mode draws on top of the sheet.
Function.CA_SketchSeg {
    Input: pa: Address
    Input: pb: Address
    Input: col: Integer
    Output: Integer
    Body: {
        CadAppPrev.xa = ArrayGet(pa, 0)
        CadAppPrev.ya = ArrayGet(pa, 1)
        CadAppPrev.cx = ArrayGet(pa, 2)
        CadAppPrev.xb = ArrayGet(pb, 0)
        CadAppPrev.yb = ArrayGet(pb, 1)
        CadAppPrev.cy = ArrayGet(pb, 2)
        CadAppPrev.rad = col
        CadAppPrev.step = 0
        CadAppPick.dx = 0
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                CadAppPick.dx = 1
            }
        }
        IfCondition EqualTo(CadAppPick.dx, 1) ThenBlock: {
            ReturnValue(CA_LineDepth(CadAppPrev.xa, CadAppPrev.ya, CadAppPrev.cx, CadAppPrev.xb, CadAppPrev.yb, CadAppPrev.cy))
        }
        ReturnValue(CA_LineOpen(CadAppPrev.xa, CadAppPrev.ya, CadAppPrev.xb, CadAppPrev.yb, col))
    }
}

// Stroke every arc on the sketch parked in tmp_a. A fillet corner is an arc.
// Angles stay in the slab. A call would drop a local before the next sample.
Function.CA_DrawSketchArcs3D {
    Output: Integer
    Body: {
        CadAppPick.ax = ArrayGet(CadApp.tmp_a, 8)
        CadAppPick.pins = CAD_Sketch.GetArcCount(CadAppPick.ax)
        ArraySet(CadApp.tmp_a, 35, CadAppPick.pins)
        IfCondition LessThan(CadAppPick.pins, 1) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = ArrayGet(CadApp.tmp_a, 8)
        CadAppPick.ax = CAD_Store.Read(CadAppPick.ax, 11)
        ArraySet(CadApp.tmp_a, 36, CadAppPick.ax)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CadApp.tmp_a, 37, 0)
        CadAppPick.pi = 0
        CadAppPick.pj = ArrayGet(CadApp.tmp_a, 35)
        WhileLoop LessThan(CadAppPick.pi, CadAppPick.pj) {
            CadAppPick.ax = ArrayGet(CadApp.tmp_a, 36)
            CadAppPick.ay = Multiply(ArrayGet(CadApp.tmp_a, 37), 5)
            CadAppPick.hu = ArrayGet(CadAppPick.ax, CadAppPick.ay)
            CadAppPick.ay = Add(CadAppPick.ay, 1)
            CadAppPick.hv = ArrayGet(CadAppPick.ax, CadAppPick.ay)
            CadAppPick.ay = Add(CadAppPick.ay, 1)
            CadAppPick.hit_a = ArrayGet(CadAppPick.ax, CadAppPick.ay)
            CadAppPick.ay = Add(CadAppPick.ay, 1)
            CadAppPick.clk_x = ArrayGet(CadAppPick.ax, CadAppPick.ay)
            CadAppPick.ay = Add(CadAppPick.ay, 1)
            CadAppPick.clk_y = ArrayGet(CadAppPick.ax, CadAppPick.ay)
            ArraySet(CadApp.tmp_a, 38, CadAppPick.hu)
            ArraySet(CadApp.tmp_a, 39, CadAppPick.hv)
            ArraySet(CadApp.tmp_a, 40, CadAppPick.hit_a)
            ArraySet(CadApp.tmp_a, 41, CadAppPick.clk_x)
            ArraySet(CadApp.tmp_a, 42, CadAppPick.clk_y)
            CadAppPick.hu = ArrayGet(CadApp.tmp_a, 42)
            CadAppPick.hv = ArrayGet(CadApp.tmp_a, 41)
            CadAppPick.hu = Float_Sub(CadAppPick.hu, CadAppPick.hv)
            CadAppPick.hu = CAD_Num.PosMod2Pi(CadAppPick.hu)
            ArraySet(CadApp.tmp_a, 43, CadAppPick.hu)
            CadAppPick.pins = CAD_Num.IsZero(CadAppPick.hu, 0)
            IfCondition EqualTo(CadAppPick.pins, 0) ThenBlock: {
                CadAppPick.hu = ArrayGet(CadApp.tmp_a, 43)
                CadAppPick.hv = ArrayGet(CadApp.tmp_a, 18)
                CadAppPick.hu = Float_Div(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hv = Float_FromInt(96)
                CadAppPick.hu = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.bx = Float_ToInt(CadAppPick.hu)
                IfCondition LessThan(CadAppPick.bx, 8) ThenBlock: { CadAppPick.bx = 8 }
                IfCondition GreaterThan(CadAppPick.bx, 96) ThenBlock: { CadAppPick.bx = 96 }
                ArraySet(CadApp.tmp_a, 44, CadAppPick.bx)
                ArraySet(CadApp.tmp_a, 45, 0)
                CadAppPick.bx = 0
                CadAppPick.by = ArrayGet(CadApp.tmp_a, 44)
                WhileLoop LessThan(CadAppPick.bx, CadAppPick.by) {
                    CadAppPick.hu = Float_FromInt(ArrayGet(CadApp.tmp_a, 45))
                    CadAppPick.hv = Float_FromInt(ArrayGet(CadApp.tmp_a, 44))
                    CadAppPick.hu = Float_Div(CadAppPick.hu, CadAppPick.hv)
                    CadAppPick.hv = ArrayGet(CadApp.tmp_a, 43)
                    CadAppPick.hu = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                    CadAppPick.hv = ArrayGet(CadApp.tmp_a, 41)
                    CadAppPick.hu = Float_Add(CadAppPick.hv, CadAppPick.hu)
                    ArraySet(CadApp.tmp_a, 46, CadAppPick.hu)
                    CadAppPick.bx = ArrayGet(CadApp.tmp_a, 45)
                    CadAppPick.bx = Add(CadAppPick.bx, 1)
                    CadAppPick.hu = Float_FromInt(CadAppPick.bx)
                    CadAppPick.hv = Float_FromInt(ArrayGet(CadApp.tmp_a, 44))
                    CadAppPick.hu = Float_Div(CadAppPick.hu, CadAppPick.hv)
                    CadAppPick.hv = ArrayGet(CadApp.tmp_a, 43)
                    CadAppPick.hu = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                    CadAppPick.hv = ArrayGet(CadApp.tmp_a, 41)
                    CadAppPick.hu = Float_Add(CadAppPick.hv, CadAppPick.hu)
                    ArraySet(CadApp.tmp_a, 47, CadAppPick.hu)
                    CadAppPick.hu = ArrayGet(CadApp.tmp_a, 46)
                    CadAppPick.hu = CAD_Geom.Cos(CadAppPick.hu)
                    CadAppPick.hv = ArrayGet(CadApp.tmp_a, 40)
                    CadAppPick.hu = Float_Mul(CadAppPick.hv, CadAppPick.hu)
                    CadAppPick.hv = ArrayGet(CadApp.tmp_a, 38)
                    CadAppPick.clk_x = Float_Add(CadAppPick.hv, CadAppPick.hu)
                    CadAppPick.hu = ArrayGet(CadApp.tmp_a, 46)
                    CadAppPick.hu = CAD_Geom.Sin(CadAppPick.hu)
                    CadAppPick.hv = ArrayGet(CadApp.tmp_a, 40)
                    CadAppPick.hu = Float_Mul(CadAppPick.hv, CadAppPick.hu)
                    CadAppPick.hv = ArrayGet(CadApp.tmp_a, 39)
                    CadAppPick.clk_y = Float_Add(CadAppPick.hv, CadAppPick.hu)
                    ArraySet(CadApp.tmp_a, 19, CadAppPick.clk_x)
                    ArraySet(CadApp.tmp_a, 20, CadAppPick.clk_y)
                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 9)
                    CadAppPick.hu = ArrayGet(CadApp.tmp_a, 19)
                    CadAppPick.hv = ArrayGet(CadApp.tmp_a, 20)
                    CadAppPick.ay = ArrayGet(CadApp.tmp_a, 4)
                    CAD_Plane.MapLocal(CadAppPick.ax, CadAppPick.hu, CadAppPick.hv, 0, CadAppPick.ay)
                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 4)
                    CadAppPick.hu = ArrayGet(CadAppPick.ax, 0)
                    CadAppPick.hv = ArrayGet(CadAppPick.ax, 1)
                    CadAppPick.hit_a = ArrayGet(CadAppPick.ax, 2)
                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 0)
                    CadAppPick.ay = ArrayGet(CadApp.tmp_a, 5)
                    CA_World3ToPix(CadAppPick.hu, CadAppPick.hv, CadAppPick.hit_a, CadAppPick.ax, CadAppPick.ay)
                    CadAppPick.hu = ArrayGet(CadApp.tmp_a, 47)
                    CadAppPick.hu = CAD_Geom.Cos(CadAppPick.hu)
                    CadAppPick.hv = ArrayGet(CadApp.tmp_a, 40)
                    CadAppPick.hu = Float_Mul(CadAppPick.hv, CadAppPick.hu)
                    CadAppPick.hv = ArrayGet(CadApp.tmp_a, 38)
                    CadAppPick.clk_x = Float_Add(CadAppPick.hv, CadAppPick.hu)
                    CadAppPick.hu = ArrayGet(CadApp.tmp_a, 47)
                    CadAppPick.hu = CAD_Geom.Sin(CadAppPick.hu)
                    CadAppPick.hv = ArrayGet(CadApp.tmp_a, 40)
                    CadAppPick.hu = Float_Mul(CadAppPick.hv, CadAppPick.hu)
                    CadAppPick.hv = ArrayGet(CadApp.tmp_a, 39)
                    CadAppPick.clk_y = Float_Add(CadAppPick.hv, CadAppPick.hu)
                    ArraySet(CadApp.tmp_a, 19, CadAppPick.clk_x)
                    ArraySet(CadApp.tmp_a, 20, CadAppPick.clk_y)
                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 9)
                    CadAppPick.hu = ArrayGet(CadApp.tmp_a, 19)
                    CadAppPick.hv = ArrayGet(CadApp.tmp_a, 20)
                    CadAppPick.ay = ArrayGet(CadApp.tmp_a, 4)
                    CAD_Plane.MapLocal(CadAppPick.ax, CadAppPick.hu, CadAppPick.hv, 0, CadAppPick.ay)
                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 4)
                    CadAppPick.hu = ArrayGet(CadAppPick.ax, 0)
                    CadAppPick.hv = ArrayGet(CadAppPick.ax, 1)
                    CadAppPick.hit_a = ArrayGet(CadAppPick.ax, 2)
                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 5)
                    CadAppPick.pins = ArrayGet(CadAppPick.ax, 0)
                    CadAppPick.prof_nn = ArrayGet(CadAppPick.ax, 1)
                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 0)
                    CadAppPick.ay = ArrayGet(CadApp.tmp_a, 6)
                    CA_World3ToPix(CadAppPick.hu, CadAppPick.hv, CadAppPick.hit_a, CadAppPick.ax, CadAppPick.ay)
                    CA_SketchSeg(ArrayGet(CadApp.tmp_a, 5), ArrayGet(CadApp.tmp_a, 6), ArrayGet(CadApp.tmp_a, 13))
                    CadAppPick.bx = ArrayGet(CadApp.tmp_a, 45)
                    CadAppPick.bx = Add(CadAppPick.bx, 1)
                    ArraySet(CadApp.tmp_a, 45, CadAppPick.bx)
                    CadAppPick.by = ArrayGet(CadApp.tmp_a, 44)
                }
            }
            CadAppPick.pi = ArrayGet(CadApp.tmp_a, 37)
            CadAppPick.pi = Add(CadAppPick.pi, 1)
            ArraySet(CadApp.tmp_a, 37, CadAppPick.pi)
            CadAppPick.pj = ArrayGet(CadApp.tmp_a, 35)
        }
        ReturnValue(0)
    }
}

Function.CA_DrawAllSketches3D {
    Input: vframe: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(vframe, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.sk_list, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = Allocate(512)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CadAppPick.ax, 1, CadApp.tmp_a)
        CadApp.tmp_a = CadAppPick.ax
        ArraySet(CadApp.tmp_a, 0, vframe)
        CadAppPick.ax = FB_RGB(255, 200, 80)
        ArraySet(CadApp.tmp_a, 2, CadAppPick.ax)
        CadAppPick.ax = FB_RGB(80, 220, 255)
        ArraySet(CadApp.tmp_a, 3, CadAppPick.ax)
        CadAppPick.ax = Allocate(32)
        ArraySet(CadApp.tmp_a, 4, CadAppPick.ax)
        CadAppPick.ax = Allocate(32)
        ArraySet(CadApp.tmp_a, 5, CadAppPick.ax)
        CadAppPick.ax = Allocate(32)
        ArraySet(CadApp.tmp_a, 6, CadAppPick.ax)
        IfCondition EqualTo(ArrayGet(CadApp.tmp_a, 4), 0) ThenBlock: { CadAppPick.found_n = 0 }
        IfCondition NotEqual(ArrayGet(CadApp.tmp_a, 4), 0) ThenBlock: { CadAppPick.found_n = 1 }
        IfCondition EqualTo(ArrayGet(CadApp.tmp_a, 5), 0) ThenBlock: { CadAppPick.found_n = 0 }
        IfCondition EqualTo(ArrayGet(CadApp.tmp_a, 6), 0) ThenBlock: { CadAppPick.found_n = 0 }
        IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
            ArraySet(CadApp.tmp_a, 7, 0)
            ArraySet(CadApp.tmp_a, 18, 0x401921FB54442D18)
            ArraySet(CadApp.tmp_a, 31, 0)
            ArraySet(CadApp.tmp_a, 32, 0)
            ArraySet(CadApp.tmp_a, 33, 0)
            CadAppPick.ax = FB_RGB(180, 255, 80)
            ArraySet(CadApp.tmp_a, 34, CadAppPick.ax)
            IfCondition GreaterEqual(CadApp.feat_sel, 0) ThenBlock: {
                IfCondition LessThan(CadApp.feat_sel, CadApp.feat_n) ThenBlock: {
                    IfCondition NotEqual(CadApp.feat_kind, 0) ThenBlock: {
                        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                            IfCondition NotEqual(CadApp.pg_tab, 0) ThenBlock: {
                                CadAppPick.ax = ArrayGet(CadApp.feat_kind, CadApp.feat_sel)
                                IfCondition EqualTo(CadAppPick.ax, 8) ThenBlock: {
                                    CadAppPick.ay = ArrayGet(CadApp.feat_aux, CadApp.feat_sel)
                                    IfCondition GreaterEqual(CadAppPick.ay, 0) ThenBlock: {
                                        IfCondition LessThan(CadAppPick.ay, CadApp.pg_n) ThenBlock: {
                                            CadAppPick.bx = Multiply(CadAppPick.ay, 10)
                                            CadAppPick.ax = ArrayGet(CadApp.pg_tab, Add(CadAppPick.bx, 5))
                                            ArraySet(CadApp.tmp_a, 31, CadAppPick.ax)
                                            CadAppPick.ax = ArrayGet(CadApp.pg_tab, Add(CadAppPick.bx, 3))
                                            ArraySet(CadApp.tmp_a, 32, CadAppPick.ax)
                                            CadAppPick.ax = ArrayGet(CadApp.pg_tab, Add(CadAppPick.bx, 4))
                                            CadAppPick.ay = ArrayGet(CadApp.tmp_a, 32)
                                            CadAppPick.ax = Add(CadAppPick.ay, CadAppPick.ax)
                                            ArraySet(CadApp.tmp_a, 33, CadAppPick.ax)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            CadAppPick.by = 0
            WhileLoop LessThan(CadAppPick.by, CadApp.sk_n) {
                CadAppPick.ax = ArrayGet(CadApp.tmp_a, 7)
                CadAppPick.ax = ArrayGet(CadApp.sk_list, CadAppPick.ax)
                ArraySet(CadApp.tmp_a, 8, CadAppPick.ax)
                CadAppPick.ax = ArrayGet(CadApp.tmp_a, 8)
                CadAppPick.ax = CAD_Sketch.GetPlaneId(CadAppPick.ax)
                IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { CadAppPick.ax = CadApp.plane }
                ArraySet(CadApp.tmp_a, 9, CadAppPick.ax)
                CadAppPick.ax = ArrayGet(CadApp.tmp_a, 2)
                ArraySet(CadApp.tmp_a, 13, CadAppPick.ax)
                CadAppPick.ax = ArrayGet(CadApp.tmp_a, 8)
                CadAppPick.pins = CAD_Sketch.GetLineCount(CadAppPick.ax)
                ArraySet(CadApp.tmp_a, 11, CadAppPick.pins)
                CadAppPick.ax = ArrayGet(CadApp.tmp_a, 8)
                CadAppPick.ax = CAD_Store.Read(CadAppPick.ax, 1)
                ArraySet(CadApp.tmp_a, 10, CadAppPick.ax)
                ArraySet(CadApp.tmp_a, 12, 0)
                CadAppPick.pi = 0
                CadAppPick.pj = ArrayGet(CadApp.tmp_a, 11)
                WhileLoop LessThan(CadAppPick.pi, CadAppPick.pj) {
                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 10)
                    CadAppPick.ay = Multiply(ArrayGet(CadApp.tmp_a, 12), 4)
                    CadAppPick.hu = ArrayGet(CadAppPick.ax, CadAppPick.ay)
                    CadAppPick.ay = Add(CadAppPick.ay, 1)
                    CadAppPick.hv = ArrayGet(CadAppPick.ax, CadAppPick.ay)
                    CadAppPick.ay = Add(CadAppPick.ay, 1)
                    CadAppPick.clk_x = ArrayGet(CadAppPick.ax, CadAppPick.ay)
                    CadAppPick.ay = Add(CadAppPick.ay, 1)
                    CadAppPick.clk_y = ArrayGet(CadAppPick.ax, CadAppPick.ay)
                    ArraySet(CadApp.tmp_a, 24, CadAppPick.hu)
                    ArraySet(CadApp.tmp_a, 25, CadAppPick.hv)
                    ArraySet(CadApp.tmp_a, 26, CadAppPick.clk_x)
                    ArraySet(CadApp.tmp_a, 27, CadAppPick.clk_y)
                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 9)
                    CadAppPick.hu = ArrayGet(CadApp.tmp_a, 24)
                    CadAppPick.hv = ArrayGet(CadApp.tmp_a, 25)
                    CadAppPick.ay = ArrayGet(CadApp.tmp_a, 4)
                    CAD_Plane.MapLocal(CadAppPick.ax, CadAppPick.hu, CadAppPick.hv, 0, CadAppPick.ay)
                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 4)
                    CadAppPick.hu = ArrayGet(CadAppPick.ax, 0)
                    CadAppPick.hv = ArrayGet(CadAppPick.ax, 1)
                    CadAppPick.hit_a = ArrayGet(CadAppPick.ax, 2)
                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 0)
                    CadAppPick.ay = ArrayGet(CadApp.tmp_a, 5)
                    CA_World3ToPix(CadAppPick.hu, CadAppPick.hv, CadAppPick.hit_a, CadAppPick.ax, CadAppPick.ay)
                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 9)
                    CadAppPick.hu = ArrayGet(CadApp.tmp_a, 26)
                    CadAppPick.hv = ArrayGet(CadApp.tmp_a, 27)
                    CadAppPick.ay = ArrayGet(CadApp.tmp_a, 4)
                    CAD_Plane.MapLocal(CadAppPick.ax, CadAppPick.hu, CadAppPick.hv, 0, CadAppPick.ay)
                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 4)
                    CadAppPick.hu = ArrayGet(CadAppPick.ax, 0)
                    CadAppPick.hv = ArrayGet(CadAppPick.ax, 1)
                    CadAppPick.hit_a = ArrayGet(CadAppPick.ax, 2)
                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 13)
                    ArraySet(CadApp.tmp_a, 30, CadAppPick.ax)
                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 8)
                    CadAppPick.ay = ArrayGet(CadApp.tmp_a, 31)
                    IfCondition EqualTo(CadAppPick.ax, CadAppPick.ay) ThenBlock: {
                        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: {
                            CadAppPick.bx = ArrayGet(CadApp.tmp_a, 12)
                            CadAppPick.by = ArrayGet(CadApp.tmp_a, 32)
                            CadAppPick.pj = ArrayGet(CadApp.tmp_a, 33)
                            CadAppPick.found_n = 0
                            IfCondition GreaterEqual(CadAppPick.bx, CadAppPick.by) ThenBlock: {
                                IfCondition LessThan(CadAppPick.bx, CadAppPick.pj) ThenBlock: {
                                    CadAppPick.found_n = 1
                                }
                            }
                            IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                                IfCondition NotEqual(CadApp.tool, 21) ThenBlock: {
                                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 34)
                                    ArraySet(CadApp.tmp_a, 30, CadAppPick.ax)
                                }
                            }
                        }
                    }
                    CadAppPick.bx = ArrayGet(CadApp.tmp_a, 5)
                    CadAppPick.pins = ArrayGet(CadAppPick.bx, 0)
                    CadAppPick.prof_nn = ArrayGet(CadAppPick.bx, 1)
                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 0)
                    CadAppPick.ay = ArrayGet(CadApp.tmp_a, 6)
                    CA_World3ToPix(CadAppPick.hu, CadAppPick.hv, CadAppPick.hit_a, CadAppPick.ax, CadAppPick.ay)
                    CA_SketchSeg(ArrayGet(CadApp.tmp_a, 5), ArrayGet(CadApp.tmp_a, 6), ArrayGet(CadApp.tmp_a, 30))
                    CadAppPick.pi = ArrayGet(CadApp.tmp_a, 12)
                    CadAppPick.pi = Add(CadAppPick.pi, 1)
                    ArraySet(CadApp.tmp_a, 12, CadAppPick.pi)
                    CadAppPick.pj = ArrayGet(CadApp.tmp_a, 11)
                }
                CadAppPick.ax = ArrayGet(CadApp.tmp_a, 8)
                CadAppPick.pins = CAD_Sketch.GetCircleCount(CadAppPick.ax)
                ArraySet(CadApp.tmp_a, 15, CadAppPick.pins)
                CadAppPick.ax = ArrayGet(CadApp.tmp_a, 8)
                CadAppPick.ax = CAD_Store.Read(CadAppPick.ax, 8)
                ArraySet(CadApp.tmp_a, 14, CadAppPick.ax)
                ArraySet(CadApp.tmp_a, 16, 0)
                CadAppPick.pi = 0
                CadAppPick.pj = ArrayGet(CadApp.tmp_a, 15)
                WhileLoop LessThan(CadAppPick.pi, CadAppPick.pj) {
                    CadAppPick.ax = ArrayGet(CadApp.tmp_a, 14)
                    CadAppPick.ay = Multiply(ArrayGet(CadApp.tmp_a, 16), 3)
                    CadAppPick.hu = ArrayGet(CadAppPick.ax, CadAppPick.ay)
                    CadAppPick.ay = Add(CadAppPick.ay, 1)
                    CadAppPick.hv = ArrayGet(CadAppPick.ax, CadAppPick.ay)
                    CadAppPick.ay = Add(CadAppPick.ay, 1)
                    CadAppPick.hit_a = ArrayGet(CadAppPick.ax, CadAppPick.ay)
                    ArraySet(CadApp.tmp_a, 21, CadAppPick.hu)
                    ArraySet(CadApp.tmp_a, 22, CadAppPick.hv)
                    ArraySet(CadApp.tmp_a, 23, CadAppPick.hit_a)
                    ArraySet(CadApp.tmp_a, 17, 0)
                    CadAppPick.bx = 0
                    WhileLoop LessThan(CadAppPick.bx, 96) {
                        CadAppPick.hu = Float_FromInt(ArrayGet(CadApp.tmp_a, 17))
                        CadAppPick.hu = Float_Div(CadAppPick.hu, Float_FromInt(96))
                        CadAppPick.hv = ArrayGet(CadApp.tmp_a, 18)
                        CadAppPick.hu = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                        ArraySet(CadApp.tmp_a, 28, CadAppPick.hu)
                        CadAppPick.bx = ArrayGet(CadApp.tmp_a, 17)
                        CadAppPick.bx = Add(CadAppPick.bx, 1)
                        CadAppPick.hu = Float_FromInt(CadAppPick.bx)
                        CadAppPick.hu = Float_Div(CadAppPick.hu, Float_FromInt(96))
                        CadAppPick.hv = ArrayGet(CadApp.tmp_a, 18)
                        CadAppPick.hu = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                        ArraySet(CadApp.tmp_a, 29, CadAppPick.hu)
                        CadAppPick.hu = ArrayGet(CadApp.tmp_a, 28)
                        CadAppPick.hu = CAD_Geom.Cos(CadAppPick.hu)
                        CadAppPick.hv = ArrayGet(CadApp.tmp_a, 23)
                        CadAppPick.hu = Float_Mul(CadAppPick.hv, CadAppPick.hu)
                        CadAppPick.hv = ArrayGet(CadApp.tmp_a, 21)
                        CadAppPick.clk_x = Float_Add(CadAppPick.hv, CadAppPick.hu)
                        CadAppPick.hu = ArrayGet(CadApp.tmp_a, 28)
                        CadAppPick.hu = CAD_Geom.Sin(CadAppPick.hu)
                        CadAppPick.hv = ArrayGet(CadApp.tmp_a, 23)
                        CadAppPick.hu = Float_Mul(CadAppPick.hv, CadAppPick.hu)
                        CadAppPick.hv = ArrayGet(CadApp.tmp_a, 22)
                        CadAppPick.clk_y = Float_Add(CadAppPick.hv, CadAppPick.hu)
                        ArraySet(CadApp.tmp_a, 19, CadAppPick.clk_x)
                        ArraySet(CadApp.tmp_a, 20, CadAppPick.clk_y)
                        CadAppPick.ax = ArrayGet(CadApp.tmp_a, 9)
                        CadAppPick.hu = ArrayGet(CadApp.tmp_a, 19)
                        CadAppPick.hv = ArrayGet(CadApp.tmp_a, 20)
                        CadAppPick.ay = ArrayGet(CadApp.tmp_a, 4)
                        CAD_Plane.MapLocal(CadAppPick.ax, CadAppPick.hu, CadAppPick.hv, 0, CadAppPick.ay)
                        CadAppPick.ax = ArrayGet(CadApp.tmp_a, 4)
                        CadAppPick.hu = ArrayGet(CadAppPick.ax, 0)
                        CadAppPick.hv = ArrayGet(CadAppPick.ax, 1)
                        CadAppPick.hit_a = ArrayGet(CadAppPick.ax, 2)
                        CadAppPick.ax = ArrayGet(CadApp.tmp_a, 0)
                        CadAppPick.ay = ArrayGet(CadApp.tmp_a, 5)
                        CA_World3ToPix(CadAppPick.hu, CadAppPick.hv, CadAppPick.hit_a, CadAppPick.ax, CadAppPick.ay)
                        CadAppPick.hu = ArrayGet(CadApp.tmp_a, 29)
                        CadAppPick.hu = CAD_Geom.Cos(CadAppPick.hu)
                        CadAppPick.hv = ArrayGet(CadApp.tmp_a, 23)
                        CadAppPick.hu = Float_Mul(CadAppPick.hv, CadAppPick.hu)
                        CadAppPick.hv = ArrayGet(CadApp.tmp_a, 21)
                        CadAppPick.clk_x = Float_Add(CadAppPick.hv, CadAppPick.hu)
                        CadAppPick.hu = ArrayGet(CadApp.tmp_a, 29)
                        CadAppPick.hu = CAD_Geom.Sin(CadAppPick.hu)
                        CadAppPick.hv = ArrayGet(CadApp.tmp_a, 23)
                        CadAppPick.hu = Float_Mul(CadAppPick.hv, CadAppPick.hu)
                        CadAppPick.hv = ArrayGet(CadApp.tmp_a, 22)
                        CadAppPick.clk_y = Float_Add(CadAppPick.hv, CadAppPick.hu)
                        ArraySet(CadApp.tmp_a, 19, CadAppPick.clk_x)
                        ArraySet(CadApp.tmp_a, 20, CadAppPick.clk_y)
                        CadAppPick.ax = ArrayGet(CadApp.tmp_a, 9)
                        CadAppPick.hu = ArrayGet(CadApp.tmp_a, 19)
                        CadAppPick.hv = ArrayGet(CadApp.tmp_a, 20)
                        CadAppPick.ay = ArrayGet(CadApp.tmp_a, 4)
                        CAD_Plane.MapLocal(CadAppPick.ax, CadAppPick.hu, CadAppPick.hv, 0, CadAppPick.ay)
                        CadAppPick.ax = ArrayGet(CadApp.tmp_a, 4)
                        CadAppPick.hu = ArrayGet(CadAppPick.ax, 0)
                        CadAppPick.hv = ArrayGet(CadAppPick.ax, 1)
                        CadAppPick.hit_a = ArrayGet(CadAppPick.ax, 2)
                        CadAppPick.ax = ArrayGet(CadApp.tmp_a, 5)
                        CadAppPick.pins = ArrayGet(CadAppPick.ax, 0)
                        CadAppPick.prof_nn = ArrayGet(CadAppPick.ax, 1)
                        CadAppPick.ax = ArrayGet(CadApp.tmp_a, 0)
                        CadAppPick.ay = ArrayGet(CadApp.tmp_a, 6)
                        CA_World3ToPix(CadAppPick.hu, CadAppPick.hv, CadAppPick.hit_a, CadAppPick.ax, CadAppPick.ay)
                        CA_SketchSeg(ArrayGet(CadApp.tmp_a, 5), ArrayGet(CadApp.tmp_a, 6), ArrayGet(CadApp.tmp_a, 13))
                        CadAppPick.bx = ArrayGet(CadApp.tmp_a, 17)
                        CadAppPick.bx = Add(CadAppPick.bx, 1)
                        ArraySet(CadApp.tmp_a, 17, CadAppPick.bx)
                    }
                    CadAppPick.pi = ArrayGet(CadApp.tmp_a, 16)
                    CadAppPick.pi = Add(CadAppPick.pi, 1)
                    ArraySet(CadApp.tmp_a, 16, CadAppPick.pi)
                    CadAppPick.pj = ArrayGet(CadApp.tmp_a, 15)
                }
                CA_DrawSketchArcs3D()
                CadAppPick.by = ArrayGet(CadApp.tmp_a, 7)
                CadAppPick.by = Add(CadAppPick.by, 1)
                ArraySet(CadApp.tmp_a, 7, CadAppPick.by)
            }
        }
        CadAppPick.ax = ArrayGet(CadApp.tmp_a, 4)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: { Deallocate(CadAppPick.ax, 32) }
        CadAppPick.ax = ArrayGet(CadApp.tmp_a, 5)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: { Deallocate(CadAppPick.ax, 32) }
        CadAppPick.ax = ArrayGet(CadApp.tmp_a, 6)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: { Deallocate(CadAppPick.ax, 32) }
        CadAppPick.ay = ArrayGet(CadApp.tmp_a, 1)
        CadAppPick.ax = CadApp.tmp_a
        CadApp.tmp_a = CadAppPick.ay
        Deallocate(CadAppPick.ax, 512)
        ReturnValue(0)
    }
}
