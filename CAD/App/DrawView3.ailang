Function.CA_BuildViewFrame {
    Input: out_frame: Address
    Output: Integer
    Body: {
        // Reuse the projection DrawMesh just used. A second camera is the bug.
        IfCondition EqualTo(CAD_View_State.fr_ok, 1) ThenBlock: {
            IfCondition EqualTo(CAD_View_State.cache_solid, CadApp.solid) ThenBlock: {
                ArraySet(out_frame, 0, CAD_View_State.fr_cx)
                ArraySet(out_frame, 1, CAD_View_State.fr_cy)
                ArraySet(out_frame, 2, CAD_View_State.fr_cz)
                ArraySet(out_frame, 3, CAD_View_State.fr_sc)
                ArraySet(out_frame, 4, CAD_View_State.fr_hw)
                ArraySet(out_frame, 5, CAD_View_State.fr_hh)
                ReturnValue(0)
            }
        }
        aabb = Allocate(64)
        mn = Allocate(32)
        mx = Allocate(32)
        got = 0
        IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.SolidBounds(CadApp.solid, mn, mx), 1) ThenBlock: {
                ArraySet(aabb, 0, ArrayGet(mn, 0))
                ArraySet(aabb, 1, ArrayGet(mn, 1))
                ArraySet(aabb, 2, ArrayGet(mn, 2))
                ArraySet(aabb, 3, ArrayGet(mx, 0))
                ArraySet(aabb, 4, ArrayGet(mx, 1))
                ArraySet(aabb, 5, ArrayGet(mx, 2))
                got = 1
            }
        }
        Deallocate(mn, 32)
        Deallocate(mx, 32)
        IfCondition EqualTo(got, 0) ThenBlock: {
            ArraySet(aabb, 0, Float_FromInt(-50))
            ArraySet(aabb, 1, Float_FromInt(-50))
            ArraySet(aabb, 2, Float_FromInt(-10))
            ArraySet(aabb, 3, Float_FromInt(50))
            ArraySet(aabb, 4, Float_FromInt(50))
            ArraySet(aabb, 5, Float_FromInt(60))
        }
        CAD_View.EnsureCamDefaults()
        CAD_View.BuildFrame(aabb, CadApp.width, CadApp.height_px, out_frame)
        Deallocate(aabb, 64)
        ReturnValue(0)
    }
}

// Project world XYZ to pixel ints via view frame. out_xy [sx,sy] ints.


// Project world XYZ to pixel ints via view frame. out_xy [sx,sy] ints.
Function.CA_World3ToPix {
    Input: x_r: Integer
    Input: y_r: Integer
    Input: z_r: Integer
    Input: vframe: Address
    Input: out_xy: Address
    Output: Integer
    Body: {
        pr = Allocate(32)
        CAD_View.ProjectPoint(x_r, y_r, z_r, vframe, pr)
        ArraySet(out_xy, 0, Float_ToInt(ArrayGet(pr, 0)))
        ArraySet(out_xy, 1, Float_ToInt(ArrayGet(pr, 1)))
        Deallocate(pr, 32)
        ReturnValue(0)
    }
}

// Semi-transparent line: draw every other pixel for see-through grid.


// Semi-transparent line: draw every other pixel for see-through grid.
Function.CA_LineDash {
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Input: col: Integer
    Output: Integer
    Body: {
        dx = Subtract(x1, x0)
        dy = Subtract(y1, y0)
        IfCondition LessThan(dx, 0) ThenBlock: { adx = Subtract(0, dx) }
        IfCondition GreaterEqual(dx, 0) ThenBlock: { adx = dx }
        IfCondition LessThan(dy, 0) ThenBlock: { ady = Subtract(0, dy) }
        IfCondition GreaterEqual(dy, 0) ThenBlock: { ady = dy }
        n = adx
        IfCondition GreaterThan(ady, n) ThenBlock: { n = ady }
        IfCondition LessThan(n, 1) ThenBlock: {
            CAD_View.PlotOpen(x0, y0, col)
            ReturnValue(0)
        }
        i = 0
        WhileLoop LessEqual(i, n) {
            // dash: draw 2 on, 1 off
            m = Modulo(i, 3)
            IfCondition NotEqual(m, 2) ThenBlock: {
                t = Float_Div(Float_FromInt(i), Float_FromInt(n))
                x = Add(x0, Float_ToInt(Float_Mul(t, Float_FromInt(dx))))
                y = Add(y0, Float_ToInt(Float_Mul(t, Float_FromInt(dy))))
                CAD_View.PlotOpen(x, y, col)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.CA_LineOpen {
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Input: col: Integer
    Output: Integer
    Body: {
        dx = Subtract(x1, x0)
        dy = Subtract(y1, y0)
        IfCondition LessThan(dx, 0) ThenBlock: { adx = Subtract(0, dx) }
        IfCondition GreaterEqual(dx, 0) ThenBlock: { adx = dx }
        IfCondition LessThan(dy, 0) ThenBlock: { ady = Subtract(0, dy) }
        IfCondition GreaterEqual(dy, 0) ThenBlock: { ady = dy }
        n = adx
        IfCondition GreaterThan(ady, n) ThenBlock: { n = ady }
        IfCondition LessThan(n, 1) ThenBlock: {
            CAD_View.PlotOpen(x0, y0, col)
            ReturnValue(0)
        }
        i = 0
        WhileLoop LessEqual(i, n) {
            t = Float_Div(Float_FromInt(i), Float_FromInt(n))
            x = Add(x0, Float_ToInt(Float_Mul(t, Float_FromInt(dx))))
            y = Add(y0, Float_ToInt(Float_Mul(t, Float_FromInt(dy))))
            CAD_View.PlotOpen(x, y, col)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Outline one planar face in the current view (CadAppPick.fr). No heap.
Function.CA_DrawFaceOutline3D {
    Input: face_handle: Integer
    Input: col: Integer
    Input: thick: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_handle, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.face = face_handle
        CadAppPick.col = col
        CadAppPick.thick = thick
        IfCondition EqualTo(CadAppPick.fr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadAppPick.pr, 0) ThenBlock: { CadAppPick.pr = Allocate(32) }
        IfCondition EqualTo(CadAppPick.pr, 0) ThenBlock: { ReturnValue(0) }
        lp = CAD_Store.Read(CadAppPick.face, 1)
        IfCondition EqualTo(lp, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.hd = CAD_Store.Read(lp, 0)
        IfCondition EqualTo(CadAppPick.hd, 0) ThenBlock: { ReturnValue(0) }
        ce0 = CadAppPick.hd
        edc = CAD_Store.Read(ce0, 0)
        IfCondition NotEqual(edc, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(edc, 0), CAD_Store.Read(edc, 1)) ThenBlock: {
                crvc = CAD_Store.Read(edc, 2)
                IfCondition NotEqual(crvc, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(crvc, 0), 2) ThenBlock: {
                        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: {
                            CAD_Tess_State.samp = Allocate(65536)
                        }
                        ns = CAD_Tess.SampleCircleEdge(edc, 48, CAD_Tess_State.samp)
                        samp = CAD_Tess_State.samp
                        si = 0
                        WhileLoop LessThan(si, Subtract(ns, 1)) {
                            CAD_View.ProjectPoint(ArrayGet(samp, Multiply(si, 3)), ArrayGet(samp, Add(Multiply(si, 3), 1)), ArrayGet(samp, Add(Multiply(si, 3), 2)), CadAppPick.fr, CadAppPick.pr)
                            CadAppPick.ax = Float_ToInt(ArrayGet(CadAppPick.pr, 0))
                            CadAppPick.ay = Float_ToInt(ArrayGet(CadAppPick.pr, 1))
                            CAD_View.ProjectPoint(ArrayGet(samp, Multiply(Add(si, 1), 3)), ArrayGet(samp, Add(Multiply(Add(si, 1), 3), 1)), ArrayGet(samp, Add(Multiply(Add(si, 1), 3), 2)), CadAppPick.fr, CadAppPick.pr)
                            CadAppPick.bx = Float_ToInt(ArrayGet(CadAppPick.pr, 0))
                            CadAppPick.by = Float_ToInt(ArrayGet(CadAppPick.pr, 1))
                            CA_LineOpen(CadAppPick.ax, CadAppPick.ay, CadAppPick.bx, CadAppPick.by, CadAppPick.col)
                            si = Add(si, 1)
                        }
                        ReturnValue(1)
                    }
                }
            }
        }
        CadAppPick.ce = CadAppPick.hd
        cguard = 0
        WhileLoop LessThan(cguard, 512) {
            ce = CadAppPick.ce
            IfCondition EqualTo(ce, 0) ThenBlock: { cguard = 512 }
            IfCondition NotEqual(ce, 0) ThenBlock: {
            CadAppPick.ov = CAD_Store.Read(ce, 5)
            ov = CadAppPick.ov
            IfCondition EqualTo(ov, 0) ThenBlock: {
                CadAppPick.ce = CAD_Store.Read(ce, 2)
                cguard = Add(cguard, 1)
                IfCondition EqualTo(CadAppPick.ce, CadAppPick.hd) ThenBlock: { cguard = 512 }
            }
            IfCondition NotEqual(ov, 0) ThenBlock: {
            CadAppPick.wx = CAD_Store.Read(ov, 0)
            CadAppPick.wy = CAD_Store.Read(ov, 1)
            CadAppPick.wz = CAD_Store.Read(ov, 2)
            CAD_View.ProjectPoint(CadAppPick.wx, CadAppPick.wy, CadAppPick.wz, CadAppPick.fr, CadAppPick.pr)
            CadAppPick.ax = Float_ToInt(ArrayGet(CadAppPick.pr, 0))
            CadAppPick.ay = Float_ToInt(ArrayGet(CadAppPick.pr, 1))
            ce = CadAppPick.ce
            nxt = CAD_Store.Read(ce, 2)
            IfCondition EqualTo(nxt, 0) ThenBlock: { cguard = 512 }
            IfCondition NotEqual(nxt, 0) ThenBlock: {
            CadAppPick.ce = nxt
            ov = CAD_Store.Read(nxt, 5)
            CadAppPick.ov = ov
            IfCondition NotEqual(ov, 0) ThenBlock: {
            CadAppPick.wx = CAD_Store.Read(ov, 0)
            CadAppPick.wy = CAD_Store.Read(ov, 1)
            CadAppPick.wz = CAD_Store.Read(ov, 2)
            CAD_View.ProjectPoint(CadAppPick.wx, CadAppPick.wy, CadAppPick.wz, CadAppPick.fr, CadAppPick.pr)
            CadAppPick.bx = Float_ToInt(ArrayGet(CadAppPick.pr, 0))
            CadAppPick.by = Float_ToInt(ArrayGet(CadAppPick.pr, 1))
            CA_LineOpen(CadAppPick.ax, CadAppPick.ay, CadAppPick.bx, CadAppPick.by, CadAppPick.col)
            }
            cguard = Add(cguard, 1)
            IfCondition EqualTo(CadAppPick.ce, CadAppPick.hd) ThenBlock: { cguard = 512 }
            }
            }
            }
        }
        ReturnValue(1)
    }
}

// Light-red every planar face; bright-red the hover target. Sketch-on-Face only.
Function.CA_DrawSketchableFaces {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(0) }
        CA_Log("cad_app: sketchable-faces enter\n", 32)
        CA_PickBufs()
        IfCondition EqualTo(CadAppPick.fr, 0) ThenBlock: { ReturnValue(0) }
        CA_BuildViewFrame(CadAppPick.fr)
        CadApp.pick_shell = CAD_Store.Read(CadApp.solid, 0)
        sguard = 0
        WhileLoop NotEqual(CadApp.pick_shell, 0) {
            CadApp.pick_fh = CAD_Store.Read(CadApp.pick_shell, 0)
            fguard = 0
            WhileLoop NotEqual(CadApp.pick_fh, 0) {
                fh = CadApp.pick_fh
                IfCondition EqualTo(CAD_Topo.FaceGetPlane(fh, CadAppPick.pl), 0) ThenBlock: {
                    fh = CadApp.pick_fh
                    CadAppPick.col = FB_RGB(255, 90, 90)
                    CadAppPick.thick = 1
                    IfCondition EqualTo(fh, CadApp.hover_face) ThenBlock: {
                        CadAppPick.col = FB_RGB(255, 24, 24)
                        CadAppPick.thick = 3
                    }
                    CA_DrawFaceOutline3D(fh, CadAppPick.col, CadAppPick.thick)
                }
                fh = CadApp.pick_fh
                CadApp.pick_fh = CAD_Store.Read(fh, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 512) ThenBlock: { CadApp.pick_fh = 0 }
            }
            sh = CadApp.pick_shell
            CadApp.pick_shell = CAD_Store.Read(sh, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { CadApp.pick_shell = 0 }
        }
        CA_Log("cad_app: sketchable-faces ok\n", 29)
        ReturnValue(1)
    }
}

// Drop every solid edge onto the sketch plane (the "lower projection").
Function.CA_DrawSolidOnSketchPlane {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: { ReturnValue(0) }
        CAD_View.SetOcclude(0)
        CA_PickBufs()
        CAD_Plane.EvalFrame(CadApp.plane, CadAppPick.pl)
        CadAppPick.ox = ArrayGet(CadAppPick.pl, 0)
        CadAppPick.oy = ArrayGet(CadAppPick.pl, 1)
        CadAppPick.oz = ArrayGet(CadAppPick.pl, 2)
        CadAppPick.nx = ArrayGet(CadAppPick.pl, 9)
        CadAppPick.ny = ArrayGet(CadAppPick.pl, 10)
        CadAppPick.nz = ArrayGet(CadAppPick.pl, 11)
        CA_BuildViewFrame(CadAppPick.fr)
        CadApp.pick_shell = CAD_Store.Read(CadApp.solid, 0)
        sguard = 0
        WhileLoop NotEqual(CadApp.pick_shell, 0) {
            CadApp.pick_fh = CAD_Store.Read(CadApp.pick_shell, 0)
            fguard = 0
            WhileLoop NotEqual(CadApp.pick_fh, 0) {
                lp = CAD_Store.Read(CadApp.pick_fh, 1)
                IfCondition NotEqual(lp, 0) ThenBlock: {
                    CadAppPick.hd = CAD_Store.Read(lp, 0)
                    CadAppPick.ce = CadAppPick.hd
                    cguard = 0
                    WhileLoop LessThan(cguard, 512) {
                        ce = CadAppPick.ce
                        CadAppPick.ov = CAD_Store.Read(ce, 5)
                        nxt = CAD_Store.Read(ce, 2)
                        IfCondition NotEqual(CadAppPick.ov, 0) ThenBlock: {
                            IfCondition NotEqual(nxt, 0) ThenBlock: {
                                ov2 = CAD_Store.Read(nxt, 5)
                                IfCondition NotEqual(ov2, 0) ThenBlock: {
                                    CadAppPick.wx = CAD_Store.Read(CadAppPick.ov, 0)
                                    CadAppPick.wy = CAD_Store.Read(CadAppPick.ov, 1)
                                    CadAppPick.wz = CAD_Store.Read(CadAppPick.ov, 2)
                                    CadAppPick.last_t = Float_Add(Float_Add(Float_Mul(Float_Sub(CadAppPick.wx, CadAppPick.ox), CadAppPick.nx), Float_Mul(Float_Sub(CadAppPick.wy, CadAppPick.oy), CadAppPick.ny)), Float_Mul(Float_Sub(CadAppPick.wz, CadAppPick.oz), CadAppPick.nz))
                                    CadAppPick.ax = Float_Sub(CadAppPick.wx, Float_Mul(CadAppPick.last_t, CadAppPick.nx))
                                    CadAppPick.ay = Float_Sub(CadAppPick.wy, Float_Mul(CadAppPick.last_t, CadAppPick.ny))
                                    CadAppPick.bx = Float_Sub(CadAppPick.wz, Float_Mul(CadAppPick.last_t, CadAppPick.nz))
                                    CAD_View.ProjectPoint(CadAppPick.ax, CadAppPick.ay, CadAppPick.bx, CadAppPick.fr, CadAppPick.pr)
                                    xa = Float_ToInt(ArrayGet(CadAppPick.pr, 0))
                                    ya = Float_ToInt(ArrayGet(CadAppPick.pr, 1))
                                    CadAppPick.wx = CAD_Store.Read(ov2, 0)
                                    CadAppPick.wy = CAD_Store.Read(ov2, 1)
                                    CadAppPick.wz = CAD_Store.Read(ov2, 2)
                                    CadAppPick.last_t = Float_Add(Float_Add(Float_Mul(Float_Sub(CadAppPick.wx, CadAppPick.ox), CadAppPick.nx), Float_Mul(Float_Sub(CadAppPick.wy, CadAppPick.oy), CadAppPick.ny)), Float_Mul(Float_Sub(CadAppPick.wz, CadAppPick.oz), CadAppPick.nz))
                                    CadAppPick.ax = Float_Sub(CadAppPick.wx, Float_Mul(CadAppPick.last_t, CadAppPick.nx))
                                    CadAppPick.ay = Float_Sub(CadAppPick.wy, Float_Mul(CadAppPick.last_t, CadAppPick.ny))
                                    CadAppPick.bx = Float_Sub(CadAppPick.wz, Float_Mul(CadAppPick.last_t, CadAppPick.nz))
                                    CAD_View.ProjectPoint(CadAppPick.ax, CadAppPick.ay, CadAppPick.bx, CadAppPick.fr, CadAppPick.pr)
                                    CA_LineDash(xa, ya, Float_ToInt(ArrayGet(CadAppPick.pr, 0)), Float_ToInt(ArrayGet(CadAppPick.pr, 1)), FB_RGB(90, 140, 110))
                                }
                            }
                        }
                        CadAppPick.ce = nxt
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(CadAppPick.ce, CadAppPick.hd) ThenBlock: { cguard = 512 }
                    }
                }
                CadApp.pick_fh = CAD_Store.Read(CadApp.pick_fh, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 512) ThenBlock: { CadApp.pick_fh = 0 }
            }
            CadApp.pick_shell = CAD_Store.Read(CadApp.pick_shell, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { CadApp.pick_shell = 0 }
        }
        ReturnValue(1)
    }
}

// Half-extent of sketch UV (mm), at least 40. Used so the 3D plane grid
// matches the profile — a hard-coded ±40 mm square looked like a second sketch.
Function.CA_SketchAbsExtent {
    Input: sk: Integer
    Output: Integer
    Body: {
        forty = Float_FromInt(40)
        IfCondition EqualTo(sk, 0) ThenBlock: { ReturnValue(forty) }
        CadAppPick.hu = forty
        nl = CAD_Sketch.GetLineCount(sk)
        lines = CAD_Store.Read(sk, 1)
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, nl) {
            IfCondition NotEqual(lines, 0) ThenBlock: {
                base = Multiply(CadAppPick.pi, 4)
                CadAppPick.pj = 0
                WhileLoop LessThan(CadAppPick.pj, 4) {
                    a = CAD_Num.Abs(ArrayGet(lines, Add(base, CadAppPick.pj)))
                    IfCondition EqualTo(Float_Le(CadAppPick.hu, a), 1) ThenBlock: {
                        CadAppPick.hu = a
                    }
                    CadAppPick.pj = Add(CadAppPick.pj, 1)
                }
            }
            CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        nc = CAD_Sketch.GetCircleCount(sk)
        circs = CAD_Store.Read(sk, 8)
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, nc) {
            IfCondition NotEqual(circs, 0) ThenBlock: {
                cb = Multiply(CadAppPick.pi, 3)
                rad = ArrayGet(circs, Add(cb, 2))
                a = Float_Add(CAD_Num.Abs(ArrayGet(circs, cb)), rad)
                IfCondition EqualTo(Float_Le(CadAppPick.hu, a), 1) ThenBlock: {
                    CadAppPick.hu = a
                }
                a = Float_Add(CAD_Num.Abs(ArrayGet(circs, Add(cb, 1))), rad)
                IfCondition EqualTo(Float_Le(CadAppPick.hu, a), 1) ThenBlock: {
                    CadAppPick.hu = a
                }
            }
            CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        na = CAD_Sketch.GetArcCount(sk)
        arcs = CAD_Store.Read(sk, 11)
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, na) {
            IfCondition NotEqual(arcs, 0) ThenBlock: {
                ab = Multiply(CadAppPick.pi, 5)
                rad = ArrayGet(arcs, Add(ab, 2))
                a = Float_Add(CAD_Num.Abs(ArrayGet(arcs, ab)), rad)
                IfCondition EqualTo(Float_Le(CadAppPick.hu, a), 1) ThenBlock: {
                    CadAppPick.hu = a
                }
                a = Float_Add(CAD_Num.Abs(ArrayGet(arcs, Add(ab, 1))), rad)
                IfCondition EqualTo(Float_Le(CadAppPick.hu, a), 1) ThenBlock: {
                    CadAppPick.hu = a
                }
            }
            CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        CadAppPick.hu = Float_Add(CadAppPick.hu, Float_FromInt(10))
        ReturnValue(CadAppPick.hu)
    }
}

// Draw one construction plane: UV grid + axes + normal (see-through dashes).
// active=1 → brighter border.
Function.CA_DrawOnePlane3D {
    Input: plane_h: Integer
    Input: vframe: Address
    Input: active: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(0) }
        // Active sketch plane stays on top of the solid (grid + face outline).
        // Other construction planes hide where the body covers them.
        CAD_View.SetOcclude(1)
        IfCondition EqualTo(plane_h, CadApp.plane) ThenBlock: { CAD_View.SetOcclude(0) }
        // Face-derived plane: outline the real B-Rep face (not a ±40 mm square
        // about the projected Sketch_0 origin — that looked like a misplaced sketch).
        skip_sq = 0
        CadApp.pick_best_f = plane_h
        CadAppPick.face = CadApp.pick_best_f
        IfCondition EqualTo(CAD_Plane.GetMode(CadAppPick.face), 3) ThenBlock: {
            fh = CAD_Plane.GetFaceHandle(CadAppPick.face)
            // Digon/rebuild replaces the solid; the stored face handle is
            // dead and outlines as a skewed quad (brokenprojection.png).
            IfCondition NotEqual(fh, 0) ThenBlock: {
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                    fsh = CAD_Store.Read(fh, 2)
                    ssh = CAD_Store.Read(CadApp.solid, 0)
                    IfCondition NotEqual(fsh, ssh) ThenBlock: { fh = 0 }
                }
            }
            skip_sq = 1
            IfCondition NotEqual(fh, 0) ThenBlock: {
                IfCondition EqualTo(CadAppPick.fr, 0) ThenBlock: { CadAppPick.fr = Allocate(64) }
                IfCondition NotEqual(CadAppPick.fr, 0) ThenBlock: {
                    ArraySet(CadAppPick.fr, 0, ArrayGet(vframe, 0))
                    ArraySet(CadAppPick.fr, 1, ArrayGet(vframe, 1))
                    ArraySet(CadAppPick.fr, 2, ArrayGet(vframe, 2))
                    ArraySet(CadAppPick.fr, 3, ArrayGet(vframe, 3))
                    ArraySet(CadAppPick.fr, 4, ArrayGet(vframe, 4))
                    ArraySet(CadAppPick.fr, 5, ArrayGet(vframe, 5))
                    fc = FB_RGB(80, 200, 220)
                    IfCondition EqualTo(active, 1) ThenBlock: {
                        fc = FB_RGB(255, 220, 60)
                    }
                    CA_DrawFaceOutline3D(fh, fc, 2)
                }
            }
        }
        // Grid follows the sketch. A hard-coded ±40 mm square after Extrude
        // looked like a second, smaller rectangle on Sketch_0 (not the profile).
        CadAppPick.hu = Float_FromInt(40)
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            skpl = CAD_Sketch.GetPlaneId(CadApp.sketch)
            IfCondition EqualTo(skpl, 0) ThenBlock: { skpl = CadApp.plane }
            IfCondition EqualTo(skpl, plane_h) ThenBlock: {
                CadAppPick.hu = CA_SketchAbsExtent(CadApp.sketch)
            }
        }
        IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
            IfCondition NotEqual(CAD_Plane.GetMode(CadAppPick.face), 3) ThenBlock: {
                skip_sq = 1
            }
        }
        e = CadAppPick.hu
        step = Float_FromInt(10)
        pxyz = Allocate(32)
        a = Allocate(32)
        b = Allocate(32)
        // border color
        bc = FB_RGB(80, 200, 220)
        IfCondition EqualTo(active, 1) ThenBlock: {
            bc = FB_RGB(255, 220, 60)
        }
        gc = FB_RGB(50, 110, 130)
        // UV grid (toggle via cmd "grid" / "grid 0" / "grid 1")
        IfCondition EqualTo(CadApp.show_grid, 1) ThenBlock: {
            // grid lines parallel to U (const v)
            v = Float_Sub(0, e)
            WhileLoop EqualTo(Float_Le(v, e), 1) {
                CAD_Plane.MapLocal(CadApp.pick_best_f, Float_Sub(0, e), v, 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
                CAD_Plane.MapLocal(CadApp.pick_best_f, e, v, 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
                CA_LineDash(ArrayGet(a, 0), ArrayGet(a, 1), ArrayGet(b, 0), ArrayGet(b, 1), gc)
                v = Float_Add(v, step)
            }
            // grid parallel to V (const u)
            u = Float_Sub(0, e)
            WhileLoop EqualTo(Float_Le(u, e), 1) {
                CAD_Plane.MapLocal(CadApp.pick_best_f, u, Float_Sub(0, e), 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
                CAD_Plane.MapLocal(CadApp.pick_best_f, u, e, 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
                CA_LineDash(ArrayGet(a, 0), ArrayGet(a, 1), ArrayGet(b, 0), ArrayGet(b, 1), gc)
                u = Float_Add(u, step)
            }
        }
        // Dummy ±40 mm (or any) yellow square is NOT the sketch. After a pad
        // it sat inside the body and looked like a size-mismatch profile.
        IfCondition EqualTo(skip_sq, 0) ThenBlock: {
        CAD_Plane.MapLocal(CadApp.pick_best_f, Float_Sub(0, e), Float_Sub(0, e), 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
        x00 = ArrayGet(a, 0)
        y00 = ArrayGet(a, 1)
        CAD_Plane.MapLocal(CadApp.pick_best_f, e, Float_Sub(0, e), 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
        x10 = ArrayGet(a, 0)
        y10 = ArrayGet(a, 1)
        CAD_Plane.MapLocal(CadApp.pick_best_f, e, e, 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
        x11 = ArrayGet(a, 0)
        y11 = ArrayGet(a, 1)
        CAD_Plane.MapLocal(CadApp.pick_best_f, Float_Sub(0, e), e, 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
        x01 = ArrayGet(a, 0)
        y01 = ArrayGet(a, 1)
        CA_LineOpen(x00, y00, x10, y10, bc)
        CA_LineOpen(x10, y10, x11, y11, bc)
        CA_LineOpen(x11, y11, x01, y01, bc)
        CA_LineOpen(x01, y01, x00, y00, bc)
        }
        // +U red, +V green, +N cyan
        CAD_Plane.MapLocal(CadApp.pick_best_f, 0, 0, 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
        ox = ArrayGet(a, 0)
        oy = ArrayGet(a, 1)
        CAD_Plane.MapLocal(CadApp.pick_best_f, Float_FromInt(30), 0, 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
        CA_LineOpen(ox, oy, ArrayGet(b, 0), ArrayGet(b, 1), FB_RGB(255, 80, 80))
        CAD_Plane.MapLocal(CadApp.pick_best_f, 0, Float_FromInt(30), 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
        CA_LineOpen(ox, oy, ArrayGet(b, 0), ArrayGet(b, 1), FB_RGB(80, 255, 120))
        CAD_Plane.MapLocal(CadApp.pick_best_f, 0, 0, Float_FromInt(20), pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
        CA_LineOpen(ox, oy, ArrayGet(b, 0), ArrayGet(b, 1), FB_RGB(80, 220, 255))
        IfCondition EqualTo(CAD_View.Covered(ox, oy), 0) ThenBlock: {
            FB_FillRect(Subtract(ox, 3), Subtract(oy, 3), 7, 7, FB_RGB(255, 220, 80))
        }
        Deallocate(pxyz, 32)
        Deallocate(a, 32)
        Deallocate(b, 32)
        ReturnValue(0)
    }
}

// Draw all registered planes + active; sketch lines mapped through sketch plane.


// Draw all registered planes + active; sketch lines mapped through sketch plane.
Function.CA_DrawPlanesAndSketch3D {
    Output: Integer
    Body: {
        w = CadApp.width
        h = CadApp.height_px
        need = 0
        IfCondition EqualTo(FB.initialized, 0) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.width, w) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.height, h) ThenBlock: { need = 1 }
        IfCondition EqualTo(need, 1) ThenBlock: {
            IfCondition EqualTo(FB_InitHeadless(w, h), 0) ThenBlock: { ReturnValue(-1) }
        }
        // if no solid, clear dark; if solid, already rendered into FB
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            FB_Clear(FB_RGB(24, 28, 36))
        }
        vframe = Allocate(64)
        CA_BuildViewFrame(vframe)
        // world XY always as faint reference if list empty
        IfCondition EqualTo(CadApp.plane_n, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.plane, 0) ThenBlock: {
                CA_PlaneRegister(CadApp.plane)
            }
        }
        has_act = 0
        i = 0
        WhileLoop LessThan(i, CadApp.plane_n) {
            pl = ArrayGet(CadApp.plane_list, i)
            act = 0
            IfCondition EqualTo(pl, CadApp.plane) ThenBlock: {
                act = 1
                has_act = 1
            }
            CA_DrawOnePlane3D(pl, vframe, act)
            i = Add(i, 1)
        }
        IfCondition EqualTo(has_act, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.plane, 0) ThenBlock: {
                CA_DrawOnePlane3D(CadApp.plane, vframe, 1)
            }
        }
        IfCondition NotEqual(CadApp.hover_plane, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.hover_plane, CadApp.plane) ThenBlock: {
                CA_DrawOnePlane3D(CadApp.hover_plane, vframe, 1)
            }
        }
        // 3D model view: z-test sketches against the solid so a consumed
        // on-face profile does not draw as a cyan rectangle through the cove.
        // Sketch mode still wants the curves on top of the plane.
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: { CAD_View.SetOcclude(1) }
        }
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: { CAD_View.SetOcclude(0) }
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { CAD_View.SetOcclude(0) }
        // project current sketch onto its plane (see original geometry in 3D)
        // View tab Sketch / skvis — off hides curves; 2D editor still draws.
        IfCondition EqualTo(CadApp.show_sketch, 1) ThenBlock: {
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            skpl = CAD_Sketch.GetPlaneId(CadApp.sketch)
            IfCondition EqualTo(skpl, 0) ThenBlock: {
                skpl = CadApp.plane
            }
            IfCondition EqualTo(skpl, 0) ThenBlock: {
                CA_EnsurePlane()
                skpl = CadApp.plane
            }
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            lines = CAD_Store.Read(CadApp.sketch, 1)
            pxyz = Allocate(32)
            a = Allocate(32)
            b = Allocate(32)
            li = 0
            WhileLoop LessThan(li, nl) {
                base = Multiply(li, 4)
                u0 = ArrayGet(lines, base)
                v0 = ArrayGet(lines, Add(base, 1))
                u1 = ArrayGet(lines, Add(base, 2))
                v1 = ArrayGet(lines, Add(base, 3))
                CAD_Plane.MapLocal(skpl, u0, v0, 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
                CAD_Plane.MapLocal(skpl, u1, v1, 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
                col = FB_RGB(100, 220, 255)
                IfCondition EqualTo(CadApp.tool, 11) ThenBlock: {
                    col = FB_RGB(255, 180, 40)
                }
                IfCondition EqualTo(CadAppRev.ok, 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(u0, CadAppRev.x0, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(v0, CadAppRev.y0, 0), 1) ThenBlock: {
                            col = FB_RGB(255, 240, 40)
                        }
                    }
                }
                CA_LineOpen(ArrayGet(a, 0), ArrayGet(a, 1), ArrayGet(b, 0), ArrayGet(b, 1), col)
                li = Add(li, 1)
            }
            // picked revolve axis — always draw + label (not only while tool=11)
            IfCondition EqualTo(CadAppRev.ok, 1) ThenBlock: {
                CAD_Plane.MapLocal(skpl, CadAppRev.x0, CadAppRev.y0, 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
                CAD_Plane.MapLocal(skpl, CadAppRev.x1, CadAppRev.y1, 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
                ax = ArrayGet(a, 0)
                ay = ArrayGet(a, 1)
                bx = ArrayGet(b, 0)
                by = ArrayGet(b, 1)
                acol = FB_RGB(255, 230, 40)
                CA_LineOpen(ax, ay, bx, by, acol)
                FB_FillRect(Subtract(ax, 3), Subtract(ay, 3), 7, 7, acol)
                FB_FillRect(Subtract(bx, 3), Subtract(by, 3), 7, 7, acol)
                mx = Divide(Add(ax, bx), 2)
                my = Divide(Add(ay, by), 2)
                FB_FillRect(Subtract(mx, 2), Subtract(my, 14), 40, 12, FB_RGB(20, 24, 32))
                FB_DrawString(mx, Subtract(my, 12), "AXIS", acol, -1)
            }
            // circles (pure circle sketch has nl=0 — must tess project)
            nc = CAD_Sketch.GetCircleCount(CadApp.sketch)
            circs = CAD_Store.Read(CadApp.sketch, 8)
            two_pi = 0x401921FB54442D18
            ci = 0
            WhileLoop LessThan(ci, nc) {
                cb = Multiply(ci, 3)
                cx = ArrayGet(circs, cb)
                cy = ArrayGet(circs, Add(cb, 1))
                rad = ArrayGet(circs, Add(cb, 2))
                k = 0
                WhileLoop LessThan(k, 96) {
                    a0 = Float_Mul(two_pi, Float_Div(Float_FromInt(k), Float_FromInt(96)))
                    a1 = Float_Mul(two_pi, Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(96)))
                    CAD_Plane.MapLocal(skpl, Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a0))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a0))), 0, pxyz)
                    CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
                    CAD_Plane.MapLocal(skpl, Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a1))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a1))), 0, pxyz)
                    CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
                    CA_LineOpen(ArrayGet(a, 0), ArrayGet(a, 1), ArrayGet(b, 0), ArrayGet(b, 1), FB_RGB(255, 200, 80))
                    k = Add(k, 1)
                }
                ci = Add(ci, 1)
            }
            // arcs
            na = CAD_Sketch.GetArcCount(CadApp.sketch)
            arcs = CAD_Store.Read(CadApp.sketch, 11)
            ai = 0
            WhileLoop LessThan(ai, na) {
                ab = Multiply(ai, 5)
                cx = ArrayGet(arcs, ab)
                cy = ArrayGet(arcs, Add(ab, 1))
                rad = ArrayGet(arcs, Add(ab, 2))
                aa0 = ArrayGet(arcs, Add(ab, 3))
                aa1 = ArrayGet(arcs, Add(ab, 4))
                span = CAD_Num.PosMod2Pi(Float_Sub(aa1, aa0))
                nseg = 32
                k = 0
                WhileLoop LessThan(k, nseg) {
                    t0 = Float_Div(Float_FromInt(k), Float_FromInt(nseg))
                    t1 = Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(nseg))
                    ang0 = Float_Add(aa0, Float_Mul(span, t0))
                    ang1 = Float_Add(aa0, Float_Mul(span, t1))
                    CAD_Plane.MapLocal(skpl, Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang0))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang0))), 0, pxyz)
                    CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
                    CAD_Plane.MapLocal(skpl, Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang1))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang1))), 0, pxyz)
                    CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
                    CA_LineOpen(ArrayGet(a, 0), ArrayGet(a, 1), ArrayGet(b, 0), ArrayGet(b, 1), FB_RGB(200, 140, 255))
                    k = Add(k, 1)
                }
                ai = Add(ai, 1)
            }
            Deallocate(pxyz, 32)
            Deallocate(a, 32)
            Deallocate(b, 32)
        }
        }
        // View cube is host chrome (Gtk). Camera stays in CAD.View.
        Deallocate(vframe, 64)
        ReturnValue(0)
    }
}

// New sketch on active plane (bare plane OK — no solid required).


// Free tess cache so sketch edit does not remesh a lathe (crash on SKETCH tab).
// B-Rep solid is kept; next 3D frame remeshes once.
Function.CA_HoldSolidTess {
    Output: Integer
    Body: {
        // Keep the last shaded mesh. Dumping it forced a remesh (lathe crash)
        // or a failed render + FB_Clear — sketch looked like an empty 2D pad.
        ReturnValue(0)
    }
}

Function.CA_PublishFrame {
    Output: Integer
    Body: {
        CA_PlanePruneImplicit()
        CA_BindSketchPlane()
        // frame/pub chatter stripped — pad/sweep logs live in Solid.ailang
        // mode 0 = 3D: solid (if any) + construction planes + projected sketch
        // mode 1 = 2D UV sketch for drawing on the active plane
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                // Shade default; wire cmd toggles fishnet. Never SetViewMode here
                // (that reset orbit every frame).
                CAD_View.SetWire(CadApp.wire)
                rc = CAD_View.RenderSolidToFB(CadApp.solid, CadApp.width, CadApp.height_px)
                IfCondition NotEqual(rc, 0) ThenBlock: {
                    PrintMessage("cad_app: render solid FAIL rc=")
                    PrintNumber(rc)
                    PrintMessage(" (solid kept)\n")
                    CA_Log("cad_app: render solid FAIL (solid kept)\n", 40)
                    // Do not FB_Clear — keep last good pixels so a tess
                    // miss after fillet does not blank the view.
                    IfCondition EqualTo(CadApp.show_planes, 1) ThenBlock: {
                        CA_DrawPlanesAndSketch3D()
                    }
                }
                // Overlay planes/sketch WITHOUT clearing solid (DrawPlanes skips clear when solid!=0)
                IfCondition EqualTo(rc, 0) ThenBlock: {
                    IfCondition EqualTo(CadApp.show_planes, 1) ThenBlock: {
                        CA_DrawPlanesAndSketch3D()
                    }
                    // selected 3D edge for fillet (cyan/yellow)
                    CA_DrawSelectedEdgeHighlight()
                    CA_DrawSelectedFaceHighlight()
                    want_face = 0
                    IfCondition EqualTo(CadApp.face_pick, 1) ThenBlock: { want_face = 1 }
                    IfCondition GreaterEqual(CadApp.plane_pick, 2) ThenBlock: { want_face = 1 }
                    IfCondition EqualTo(want_face, 1) ThenBlock: {
                        CA_DrawSketchableFaces()
                    }
                }
            }
            IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
                IfCondition EqualTo(CadApp.show_planes, 1) ThenBlock: {
                    rc = CA_DrawPlanesAndSketch3D()
                    IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(rc) }
                }
                IfCondition EqualTo(CadApp.show_planes, 0) ThenBlock: {
                    rc = CA_DrawSketchToFB()
                    IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(rc) }
                }
            }
        }
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                CAD_View.SetWire(CadApp.wire)
                rc = CAD_View.RenderSolidToFB(CadApp.solid, CadApp.width, CadApp.height_px)
                CA_DrawSolidOnSketchPlane()
                IfCondition EqualTo(CadApp.show_planes, 1) ThenBlock: {
                    CA_DrawPlanesAndSketch3D()
                }
            }
            rc = CA_DrawSketchToFB()
            IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(rc) }
        }
        IfCondition EqualTo(CadApp.tool, 4) ThenBlock: {
            IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
                FB_FillRect(8, 8, 520, 22, FB_RGB(20, 24, 32))
                FB_DrawString(12, 12, "PICK PROFILE: click the light-red outline, then Extrude", FB_RGB(255, 180, 80), -1)
            }
        }
        IfCondition EqualTo(CadApp.tool, 11) ThenBlock: {
            FB_FillRect(8, 8, 420, 22, FB_RGB(20, 24, 32))
            FB_DrawString(12, 12, "REVOLVE: click a sketch LINE for the axis", FB_RGB(255, 230, 80), -1)
        }
        IfCondition EqualTo(CadApp.face_pick, 1) ThenBlock: {
            FB_FillRect(8, 8, 520, 22, FB_RGB(20, 24, 32))
            FB_DrawString(12, 12, "SKETCH ON FACE: click bright-red face  Shift+click=next along ray", FB_RGB(255, 160, 140), -1)
        }
        IfCondition EqualTo(CadApp.plane_pick, 1) ThenBlock: {
            FB_FillRect(8, 8, 520, 22, FB_RGB(20, 24, 32))
            FB_DrawString(12, 12, "PICK PLANE: click a cyan/gold plane  or a Plane row in the tree", FB_RGB(255, 220, 80), -1)
        }
        IfCondition EqualTo(CadApp.plane_pick, 2) ThenBlock: {
            FB_FillRect(8, 8, 520, 22, FB_RGB(20, 24, 32))
            FB_DrawString(12, 12, "PLANE FROM FACE: click a planar face (no sketch yet)", FB_RGB(255, 200, 120), -1)
        }
        IfCondition EqualTo(CadApp.plane_pick, 3) ThenBlock: {
            FB_FillRect(8, 8, 520, 22, FB_RGB(20, 24, 32))
            FB_DrawString(12, 12, "PLANE ORIGIN: click a vertex or a point on the plane", FB_RGB(180, 255, 140), -1)
        }
        IfCondition EqualTo(CadApp.plane_pick, 4) ThenBlock: {
            FB_FillRect(8, 8, 520, 22, FB_RGB(20, 24, 32))
            IfCondition EqualTo(CadApp.pln_ptn, 0) ThenBlock: {
                FB_DrawString(12, 12, "THROUGH 3 PTS: click first point (vertex / face / plane)", FB_RGB(200, 180, 255), -1)
            }
            IfCondition EqualTo(CadApp.pln_ptn, 1) ThenBlock: {
                FB_DrawString(12, 12, "THROUGH 3 PTS: click second point", FB_RGB(200, 180, 255), -1)
            }
            IfCondition GreaterEqual(CadApp.pln_ptn, 2) ThenBlock: {
                FB_DrawString(12, 12, "THROUGH 3 PTS: click third point", FB_RGB(200, 180, 255), -1)
            }
        }
        CAD_View.WriteFBRaw("/tmp/cad_app/meta.bin", "/tmp/cad_app/frame.raw")
        CadApp.gen = Add(CadApp.gen, 1)
        CA_WriteGen()
        IfCondition EqualTo(CadAppIpc.lite, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
            IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
                CA_WriteFileStr("/tmp/cad_app/status.txt", "SKETCH line  (r pad m 3d)", 25)
            }
            IfCondition EqualTo(CadApp.tool, 1) ThenBlock: {
                CA_WriteFileStr("/tmp/cad_app/status.txt", "SKETCH rect  (r pad m 3d)", 25)
            }
            IfCondition EqualTo(CadApp.tool, 2) ThenBlock: {
                CA_WriteFileStr("/tmp/cad_app/status.txt", "SKETCH circ  (r pad m 3d)", 25)
            }
        }
        IfCondition EqualTo(CadApp.tool, 11) ThenBlock: {
            CA_WriteFileStr("/tmp/cad_app/status.txt", "REVOLVE: click a sketch LINE for the axis", 41)
        }
        CA_WriteStatus()
        CA_WriteToolFile()
        CA_WriteHud()
        CA_WriteCam()
        CA_WritePalette()
        CA_WriteTree()
        CA_WriteHist()
        ReturnValue(0)
    }
}


// Circle rubber-band. Pin cx/r/pt — Cos/Sin + WorldToPix clobber Address locals.
