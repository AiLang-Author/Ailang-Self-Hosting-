// Parse signed int at buf[i], write value to out_addr[0], return new index or -1
Function.CA_ParseSigned {
    Input: buf: Address
    Input: i: Integer
    Input: out_addr: Address
    Output: Integer
    Body: {
        WhileLoop EqualTo(GetByte(buf, i), 32) {
            i = Add(i, 1)
            IfCondition GreaterThan(i, 70) ThenBlock: { ReturnValue(-1) }
        }
        neg = 0
        IfCondition EqualTo(GetByte(buf, i), 45) ThenBlock: {
            neg = 1
            i = Add(i, 1)
        }
        val = 0
        got = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            ch = GetByte(buf, i)
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: {
                    val = Add(Multiply(val, 10), Subtract(ch, 48))
                    got = 1
                    i = Add(i, 1)
                }
                IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
                IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            }
            IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
            IfCondition GreaterThan(i, 70) ThenBlock: { done = 1 }
        }
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(neg, 1) ThenBlock: { val = Subtract(0, val) }
        ArraySet(out_addr, 0, val)
        ReturnValue(i)
    }
}

// Parse [+-]digits[.digits] as hundredths (37.45 → 3745). Returns new index or -1.
Function.CA_ParseFixed100 {
    Input: buf: Address
    Input: i: Integer
    Input: out_addr: Address
    Output: Integer
    Body: {
        WhileLoop EqualTo(GetByte(buf, i), 32) {
            i = Add(i, 1)
            IfCondition GreaterThan(i, 80) ThenBlock: { ReturnValue(-1) }
        }
        neg = 0
        IfCondition EqualTo(GetByte(buf, i), 45) ThenBlock: {
            neg = 1
            i = Add(i, 1)
        }
        val = 0
        got = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            ch = GetByte(buf, i)
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: {
                    val = Add(Multiply(val, 10), Subtract(ch, 48))
                    got = 1
                    i = Add(i, 1)
                }
                IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
                IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            }
            IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
            IfCondition GreaterThan(i, 80) ThenBlock: { done = 1 }
        }
        frac = 0
        nd = 0
        IfCondition EqualTo(GetByte(buf, i), 46) ThenBlock: {
            i = Add(i, 1)
            fd = 0
            WhileLoop LessThan(fd, 2) {
                ch = GetByte(buf, i)
                IfCondition GreaterEqual(ch, 48) ThenBlock: {
                    IfCondition LessEqual(ch, 57) ThenBlock: {
                        frac = Add(Multiply(frac, 10), Subtract(ch, 48))
                        nd = Add(nd, 1)
                        i = Add(i, 1)
                    }
                }
                fd = Add(fd, 1)
            }
        }
        IfCondition EqualTo(got, 0) ThenBlock: {
            IfCondition EqualTo(nd, 0) ThenBlock: { ReturnValue(-1) }
        }
        IfCondition EqualTo(nd, 1) ThenBlock: { frac = Multiply(frac, 10) }
        hundred = Add(Multiply(val, 100), frac)
        IfCondition EqualTo(neg, 1) ThenBlock: { hundred = Subtract(0, hundred) }
        ArraySet(out_addr, 0, hundred)
        ReturnValue(i)
    }
}

// Parse "click N M" — returns 1 if click handled


// Parse "click N M" — returns 1 if click handled
Function.CA_TryParseClick {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        // need "click "
        IfCondition LessThan(n, 8) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 0), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 1), 108) ThenBlock: { ReturnValue(0) }
        // parse ints after "click "
        i = 6
        // skip spaces
        WhileLoop LessThan(i, n) {
            IfCondition NotEqual(GetByte(buf, i), 32) ThenBlock: {
                // break by setting flag
                i2 = i
                i = n
            }
            IfCondition LessThan(i, n) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, i), 32) ThenBlock: { i = Add(i, 1) }
            }
        }
        i = 6
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(GetByte(buf, i), 32) ThenBlock: { i = Add(i, 1) }
            IfCondition NotEqual(GetByte(buf, i), 32) ThenBlock: {
                // fall through
                i = i
            }
            IfCondition GreaterThan(i, 5) ThenBlock: {
                IfCondition NotEqual(GetByte(buf, i), 32) ThenBlock: {
                    // parse
                    i = i
                }
            }
        }
        // simpler: fixed parse from index 6
        i = 6
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(GetByte(buf, i), 32) ThenBlock: { i = Add(i, 1) }
            IfCondition NotEqual(GetByte(buf, i), 32) ThenBlock: {
                // start digits
                px = 0
                WhileLoop LessThan(i, n) {
                    ch = GetByte(buf, i)
                    IfCondition LessThan(ch, 48) ThenBlock: { i = n }
                    IfCondition GreaterThan(ch, 57) ThenBlock: {
                        IfCondition GreaterEqual(ch, 48) ThenBlock: {
                            IfCondition LessEqual(ch, 57) ThenBlock: {
                                // digit
                            }
                        }
                    }
                    IfCondition LessThan(i, n) ThenBlock: {
                        ch = GetByte(buf, i)
                        IfCondition GreaterEqual(ch, 48) ThenBlock: {
                            IfCondition LessEqual(ch, 57) ThenBlock: {
                                px = Add(Multiply(px, 10), Subtract(ch, 48))
                                i = Add(i, 1)
                            }
                            IfCondition GreaterThan(ch, 57) ThenBlock: { i = n }
                            IfCondition LessThan(ch, 48) ThenBlock: { i = n }
                        }
                        IfCondition LessThan(ch, 48) ThenBlock: { i = n }
                    }
                }
                // skip spaces
                j = 6
                // re-parse cleanly
                j = 6
                WhileLoop EqualTo(GetByte(buf, j), 32) {
                    j = Add(j, 1)
                    IfCondition GreaterThan(j, n) ThenBlock: { j = n }
                }
                px = 0
                WhileLoop LessThan(j, n) {
                    ch = GetByte(buf, j)
                    IfCondition GreaterEqual(ch, 48) ThenBlock: {
                        IfCondition LessEqual(ch, 57) ThenBlock: {
                            px = Add(Multiply(px, 10), Subtract(ch, 48))
                            j = Add(j, 1)
                        }
                        IfCondition GreaterThan(ch, 57) ThenBlock: { j = n }
                        IfCondition LessThan(ch, 48) ThenBlock: { j = n }
                    }
                    IfCondition LessThan(ch, 48) ThenBlock: { j = n }
                    IfCondition GreaterThan(ch, 57) ThenBlock: {
                        IfCondition LessThan(ch, 48) ThenBlock: { j = n }
                    }
                }
                // after first number, j may be past end due to break — rescan
                j = 6
                WhileLoop LessThan(j, n) {
                    IfCondition EqualTo(GetByte(buf, j), 32) ThenBlock: { j = Add(j, 1) }
                    IfCondition NotEqual(GetByte(buf, j), 32) ThenBlock: {
                        // mark
                        j = j
                    }
                }
                ReturnValue(0)
            }
        }
        ReturnValue(0)
    }
}

// Clean integer parse: "click X Y"


// Clean integer parse: "click X Y"
Function.CA_ParseClick {
    Input: buf: Address
    Output: Integer
    Body: {
        // verify prefix click
        IfCondition NotEqual(GetByte(buf, 0), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 1), 108) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 2), 105) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 3), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 4), 107) ThenBlock: { ReturnValue(0) }
        i = 5
        WhileLoop EqualTo(GetByte(buf, i), 32) {
            i = Add(i, 1)
            IfCondition GreaterThan(i, 60) ThenBlock: { ReturnValue(0) }
        }
        px = 0
        got = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            ch = GetByte(buf, i)
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: {
                    px = Add(Multiply(px, 10), Subtract(ch, 48))
                    got = 1
                    i = Add(i, 1)
                }
                IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
                IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            }
            IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
            IfCondition GreaterThan(i, 60) ThenBlock: { done = 1 }
        }
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        WhileLoop EqualTo(GetByte(buf, i), 32) {
            i = Add(i, 1)
            IfCondition GreaterThan(i, 60) ThenBlock: { ReturnValue(0) }
        }
        py = 0
        got = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            ch = GetByte(buf, i)
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: {
                    py = Add(Multiply(py, 10), Subtract(ch, 48))
                    got = 1
                    i = Add(i, 1)
                }
                IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
                IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            }
            IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
            IfCondition GreaterThan(i, 60) ThenBlock: { done = 1 }
        }
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        // optional third int: shift (1 = multi-select toggle)
        CadApp.click_shift = 0
        WhileLoop EqualTo(GetByte(buf, i), 32) {
            i = Add(i, 1)
            IfCondition GreaterThan(i, 70) ThenBlock: { i = 71 }
        }
        IfCondition LessThan(i, 70) ThenBlock: {
            ch = GetByte(buf, i)
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: {
                    CadApp.click_shift = Subtract(ch, 48)
                }
            }
        }
        CA_OnClick(px, py)
        ReturnValue(1)
    }
}


Function.CA_PollCmd {
    Output: Integer
    Body: {
        fd = SystemCall(2, "/tmp/cad_app/cmd.txt", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadAppIpc.cmd, 0) ThenBlock: { CadAppIpc.cmd = Allocate(80) }
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            ReturnValue(0)
        }
        n = SystemCall(0, fd, buf, 79)
        SystemCall(3, fd, 0, 0)
        fd2 = SystemCall(2, "/tmp/cad_app/cmd.txt", 577, 420)
        IfCondition GreaterEqual(fd2, 0) ThenBlock: { SystemCall(3, fd2, 0, 0) }
        IfCondition LessThan(n, 1) ThenBlock: {
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        // breadcrumb every cmd except orbit/hover (those fire every mouse move)
        c00 = GetByte(buf, 0)
        skip_log = 0
        IfCondition EqualTo(c00, 111) ThenBlock: { skip_log = 1 }
        IfCondition EqualTo(c00, 104) ThenBlock: { skip_log = 1 }
        IfCondition EqualTo(skip_log, 0) ThenBlock: {
            CA_Log("cad_app: ipc ", 13)
            nn = n
            IfCondition GreaterThan(nn, 48) ThenBlock: { nn = 48 }
            CA_Log(buf, nn)
            IfCondition NotEqual(GetByte(buf, Subtract(n, 1)), 10) ThenBlock: {
                CA_Log("\n", 1)
            }
        }
        // orbit dx dy
        IfCondition EqualTo(GetByte(buf, 0), 111) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 114) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 98) ThenBlock: {
                    out = CA_IpcOut()
                    i = CA_ParseSigned(buf, 5, out)
                    ok = 0
                    dx = 0
                    dy = 0
                    IfCondition GreaterThan(i, 0) ThenBlock: {
                        dx = ArrayGet(out, 0)
                        j = CA_ParseSigned(buf, i, out)
                        IfCondition GreaterThan(j, 0) ThenBlock: {
                            dy = ArrayGet(out, 0)
                            ok = 1
                        }
                    }
                    // parse buf is pinned (CadAppIpc.parse)
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        CA_ViewOrbit(dx, dy)
                        CA_PublishFrame()
                    }
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        // zoom N — sketch: sk_zoom; 3D: view zoom
        IfCondition EqualTo(GetByte(buf, 0), 122) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                out = CA_IpcOut()
                i = CA_ParseSigned(buf, 4, out)
                zs = 0
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    zs = ArrayGet(out, 0)
                    CA_ViewZoom(zs)
                    CA_PublishFrame()
                }
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        // pan dx dy (pixel deltas from sketch hold-drag)
        IfCondition EqualTo(GetByte(buf, 0), 112) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 97) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 110) ThenBlock: {
                    out = CA_IpcOut()
                    i = CA_ParseSigned(buf, 3, out)
                    IfCondition GreaterThan(i, 0) ThenBlock: {
                        pdx = ArrayGet(out, 0)
                        j = CA_ParseSigned(buf, i, out)
                        IfCondition GreaterThan(j, 0) ThenBlock: {
                            pdy = ArrayGet(out, 0)
                            CA_ViewPan(pdx, pdy)
                            CA_PublishFrame()
                        }
                    }
                    // parse buf is pinned (CadAppIpc.parse)
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        // hover x y (rubber-band)
        IfCondition EqualTo(GetByte(buf, 0), 104) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                out = CA_IpcOut()
                i = CA_ParseSigned(buf, 5, out)
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    hx = ArrayGet(out, 0)
                    j = CA_ParseSigned(buf, i, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        hy = ArrayGet(out, 0)
                        CA_OnHover(hx, hy)
                    }
                }
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        // click
        IfCondition EqualTo(CA_ParseClick(buf), 1) ThenBlock: {
            // cmd buf pinned
            ReturnValue(2)
        }
        c0 = GetByte(buf, 0)
        IfCondition EqualTo(c0, 113) ThenBlock: {
            // cmd buf pinned
            ReturnValue(1)
        }
        // mode (bare "m"/"mode") vs mirror_x / mirror_y
        IfCondition EqualTo(c0, 109) ThenBlock: {
            b1 = GetByte(buf, 1)
            // mirror… (mi…)
            IfCondition EqualTo(b1, 105) ThenBlock: {
                // mirror_x / mirror x / mirx → axis 0 (y→-y)
                // mirror_y / mirror y / miry → axis 1 (x→-x)
                axm = 1
                // scan for 'x' or 'y' in cmd
                si = 0
                WhileLoop LessThan(si, 16) {
                    ch = GetByte(buf, si)
                    IfCondition EqualTo(ch, 0) ThenBlock: { si = 16 }
                    IfCondition EqualTo(ch, 10) ThenBlock: { si = 16 }
                    IfCondition EqualTo(ch, 120) ThenBlock: { axm = 0 }
                    IfCondition EqualTo(ch, 121) ThenBlock: { axm = 1 }
                    si = Add(si, 1)
                }
                CA_MirrorSketch(axm)
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            // mode / bare m
            do_mode = 0
            IfCondition EqualTo(b1, 0) ThenBlock: { do_mode = 1 }
            IfCondition EqualTo(b1, 10) ThenBlock: { do_mode = 1 }
            IfCondition EqualTo(b1, 13) ThenBlock: { do_mode = 1 }
            IfCondition EqualTo(b1, 32) ThenBlock: { do_mode = 1 }
            IfCondition EqualTo(b1, 111) ThenBlock: { do_mode = 1 }
            IfCondition EqualTo(do_mode, 1) ThenBlock: {
                CadApp.mode = Subtract(1, CadApp.mode)
                CadApp.nclick = 0
                CadApp.hover_ok = 0
                CadApp.live_ang = -1
                IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
                    IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                        CadApp.sketch = CAD_Sketch.CreateSketch(1)
                    }
                    CadApp.show_sketch = 1
                    CA_HoldSolidTess()
                    CA_Log("cad_app: sketch mode\n", 21)
                }
                IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
                    CadApp.tool = 4
                    CA_Log("cad_app: 3D mode (pick)\n", 24)
                }
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        // tool_line / tool_rect / …  OR bare "tools" (refresh tools.json from PG)
        IfCondition EqualTo(c0, 116) ThenBlock: {
            // tsel K id — left-click tree: select, do not open HUD
            IfCondition EqualTo(GetByte(buf, 1), 115) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 101) ThenBlock: {
                    k = GetByte(buf, 5)
                    out = CA_IpcOut()
                    j = CA_ParseSigned(buf, 6, out)
                    id = 0
                    IfCondition GreaterThan(j, 0) ThenBlock: { id = ArrayGet(out, 0) }
                    CA_TreeSelect(k, id)
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
            // tree K id — navigator Edit (RMB / double-click)
            IfCondition EqualTo(GetByte(buf, 1), 114) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 101) ThenBlock: {
                    k = GetByte(buf, 5)
                    out = CA_IpcOut()
                    j = CA_ParseSigned(buf, 6, out)
                    id = 0
                    IfCondition GreaterThan(j, 0) ThenBlock: { id = ArrayGet(out, 0) }
                    IfCondition EqualTo(k, 83) ThenBlock: {
                        IfCondition GreaterEqual(id, 0) ThenBlock: {
                            IfCondition LessThan(id, CadApp.sk_n) ThenBlock: {
                                CadApp.sketch = ArrayGet(CadApp.sk_list, id)
                                CadApp.mode = 1
                                CadApp.show_sketch = 1
                                CadApp.nclick = 0
                                pl = CAD_Sketch.GetPlaneId(CadApp.sketch)
                                IfCondition NotEqual(pl, 0) ThenBlock: { CadApp.plane = pl }
                                fi = 0
                                WhileLoop LessThan(fi, CadApp.feat_n) {
                                    IfCondition EqualTo(ArrayGet(CadApp.feat_kind, fi), 0) ThenBlock: {
                                        IfCondition EqualTo(ArrayGet(CadApp.feat_sk, fi), id) ThenBlock: {
                                            CadApp.feat_sel = fi
                                        }
                                    }
                                    fi = Add(fi, 1)
                                }
                                CA_LogInt("cad_app: tree sketch ", 21, id)
                            }
                        }
                    }
                    // G — polygon feature: stay in sketch, reopen N/L/D HUD
                    IfCondition EqualTo(k, 71) ThenBlock: {
                        CA_PolyEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    // L — line
                    IfCondition EqualTo(k, 76) ThenBlock: {
                        CA_LineEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    // O — circle
                    IfCondition EqualTo(k, 79) ThenBlock: {
                        CA_CircEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    // E — rectangle
                    IfCondition EqualTo(k, 69) ThenBlock: {
                        CA_RectEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    IfCondition EqualTo(k, 74) ThenBlock: {
                        CA_FilletEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    IfCondition EqualTo(k, 88) ThenBlock: {
                        CA_CstrEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    IfCondition EqualTo(k, 84) ThenBlock: {
                        CA_PointEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    // B pad — reopen height HUD (same as sketch children)
                    IfCondition EqualTo(k, 66) ThenBlock: {
                        CA_PadEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    // R revolve — reopen angle HUD
                    IfCondition EqualTo(k, 82) ThenBlock: {
                        CA_RevEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    // F 3D fillet — reopen R= HUD
                    IfCondition EqualTo(k, 70) ThenBlock: {
                        CA_Fillet3dEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    // C chamfer — reopen D= HUD
                    IfCondition EqualTo(k, 67) ThenBlock: {
                        CA_ChamferEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    // U cut — reopen extrude HUD in CUT
                    IfCondition EqualTo(k, 85) ThenBlock: {
                        CA_PadEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    go3 = 0
                    IfCondition EqualTo(go3, 1) ThenBlock: {
                        CadApp.mode = 0
                        CadApp.face_pick = 0
                        CA_PlaneClearPick()
                        IfCondition GreaterEqual(id, 0) ThenBlock: {
                            IfCondition LessThan(id, CadApp.feat_n) ThenBlock: {
                                CadApp.feat_sel = id
                            }
                        }
                        CA_Log("cad_app: tree feature 3d\n", 25)
                    }
                    IfCondition EqualTo(k, 77) ThenBlock: {
                        CadApp.mode = 0
                        CadApp.face_pick = 0
                        CA_PlaneClearPick()
                        CadApp.feat_sel = CadApp.feat_n
                        CA_Log("cad_app: tree model\n", 20)
                    }
                    // N — construction plane row → make active
                    IfCondition EqualTo(k, 78) ThenBlock: {
                        CA_PlaneActivateIdx(id)
                        CA_LookAlongActivePlane()
                        CA_LogInt("cad_app: tree plane ", 20, id)
                    }
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
            // "tools" — re-publish UI catalog JSON for host chrome
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 111) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, 3), 108) ThenBlock: {
                        IfCondition EqualTo(GetByte(buf, 4), 115) ThenBlock: {
                            CA_RepoEnsure()
                            CA_PublishToolsJson()
                            CA_PublishFrame()
                            // cmd buf pinned
                            ReturnValue(2)
                        }
                    }
                }
            }
            // tool_* — CAD_UI owns ids / variants (arc2, circ3, rectc, polyN, spline, …)
            tid = CAD_UI.ParseTool(buf)
            IfCondition LessThan(tid, 0) ThenBlock: {
                // cmd buf pinned
                ReturnValue(0)
            }
            CadApp.tool = tid
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CadApp.spl_n = 0
            CadApp.hud_kind = 0
            CadApp.hud_field = 0
            IfCondition GreaterThan(CAD_UI_State.nsides, 1) ThenBlock: {
                CadApp.poly_n = CAD_UI_State.nsides
            }
            // chamfer stays in 3D edge-pick; HUD types D
            IfCondition EqualTo(tid, 10) ThenBlock: {
                CadApp.chamfer_edit = 0
                CadApp.nclick = CadApp.sel_nedges
                CadApp.mode = 0
                CA_HudOpenChamfer()
                CA_Log("cad_app: 3D CHAMFER - click edges, type D, Enter\n", 49)
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            // fillet 2d vs 3d
            IfCondition EqualTo(tid, 8) ThenBlock: {
                IfCondition EqualTo(CadApp.fillet_r, 0) ThenBlock: {
                    CadApp.fillet_r = 0x4000000000000000
                }
                CadApp.hover_ok = 0
                IfCondition EqualTo(CAD_UI_State.is2d, 1) ThenBlock: {
                    CadApp.mode = 1
                    CadApp.nclick = 0
                    CadApp.fillet_li = -1
                    CadApp.fillet_lj = -1
                    CadApp.last_fillet = -1
                    CA_Log("cad_app: SKETCH FILLET - click 2 lines at a corner\n", 51)
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
                CadApp.mode = 0
                CadApp.fillet_edit = 0
                CadApp.nclick = CadApp.sel_nedges
                CA_HudOpenFillet3d()
                CA_Log("cad_app: 3D FILLET - edges, then FACE middle, R, Enter\n", 56)
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            CadApp.mode = 1
            CA_HoldSolidTess()
            IfCondition EqualTo(tid, 4) ThenBlock: {
                CadApp.mode = 0
                skn = 0
                IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                    skn = CAD_Store.Read(CadApp.sketch, 12)
                }
                IfCondition EqualTo(skn, 0) ThenBlock: {
                    CA_RebuildProfiles()
                }
                IfCondition GreaterThan(skn, 0) ThenBlock: {
                    CadApp.nprof = skn
                    CA_Log("cad_app: Pick - click a profile area (inner = own ID)\n", 55)
                    CA_Log("  or its outline; Shift+click multi\n", 37)
                }
                IfCondition EqualTo(skn, 0) ThenBlock: {
                    IfCondition GreaterThan(CadApp.nprof, 0) ThenBlock: {
                        CA_Log("cad_app: Pick - light red faces ready; click to select\n", 55)
                    }
                    IfCondition EqualTo(CadApp.nprof, 0) ThenBlock: {
                        CA_Log("cad_app: Pick - no profiles; Trim stubs then Profiles\n", 54)
                    }
                }
            }
            IfCondition EqualTo(tid, 6) ThenBlock: {
                CA_Log("cad_app: POINT tool - click to place\n", 37)
            }
            IfCondition EqualTo(tid, 9) ThenBlock: {
                CA_Log("cad_app: ARC3 - start, through, end\n", 36)
            }
            IfCondition EqualTo(tid, 12) ThenBlock: {
                CA_Log("cad_app: ARC2 - diameter start, end\n", 36)
            }
            IfCondition EqualTo(tid, 13) ThenBlock: {
                CA_Log("cad_app: CIRC2 - diameter P0, P1\n", 33)
            }
            IfCondition EqualTo(tid, 14) ThenBlock: {
                CA_Log("cad_app: CIRC3 - three points on rim\n", 37)
            }
            IfCondition EqualTo(tid, 15) ThenBlock: {
                CadApp.last_rect = -1
                CadApp.rect_w = 0
                CadApp.rect_h = 0
                CA_Log("cad_app: RECTC - center, then corner\n", 37)
            }
            IfCondition EqualTo(tid, 16) ThenBlock: {
                CA_Log("cad_app: RECT3 - corner, edge, height\n", 38)
            }
            IfCondition EqualTo(tid, 17) ThenBlock: {
                CA_Log("cad_app: POLY - center, then vertex\n", 36)
            }
            IfCondition EqualTo(tid, 18) ThenBlock: {
                CA_Log("cad_app: SPLINE - clicks=CVs, then done\n", 40)
            }
            CA_PublishFrame()
            // cmd buf pinned
            ReturnValue(2)
        }
        // fname N ALIAS — name a pad/fillet/… row (id stays)
        IfCondition EqualTo(c0, 102) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 110) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 97) ThenBlock: {
                    out = CA_IpcOut()
                    i = 5
                    WhileLoop EqualTo(GetByte(buf, i), 32) {
                        i = Add(i, 1)
                        IfCondition GreaterThan(i, 70) ThenBlock: { i = 71 }
                    }
                    fid = 0
                    j = CA_ParseSigned(buf, i, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        fid = ArrayGet(out, 0)
                        i = j
                        WhileLoop EqualTo(GetByte(buf, i), 32) {
                            i = Add(i, 1)
                            IfCondition GreaterThan(i, 70) ThenBlock: { i = 71 }
                        }
                    }
                    nm = Allocate(64)
                    k = 0
                    WhileLoop LessThan(k, 31) {
                        c = GetByte(buf, Add(i, k))
                        stop = 0
                        IfCondition EqualTo(c, 0) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(c, 10) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(c, 13) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(stop, 1) ThenBlock: { k = 31 }
                        IfCondition EqualTo(stop, 0) ThenBlock: {
                            SetByte(nm, k, c)
                            k = Add(k, 1)
                        }
                    }
                    SetByte(nm, 31, 0)
                    IfCondition LessThan(k, 31) ThenBlock: { SetByte(nm, k, 0) }
                    CA_SetFeatAlias(fid, nm)
                    Deallocate(nm, 64)
                    CA_LogInt("cad_app: feature alias ", 23, fid)
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
        }
        // forget [NAME] — File → Delete (Postgres document)
        IfCondition EqualTo(c0, 102) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 114) ThenBlock: {
                    i = 6
                    WhileLoop EqualTo(GetByte(buf, i), 32) {
                        i = Add(i, 1)
                        IfCondition GreaterThan(i, 70) ThenBlock: { i = 71 }
                    }
                    c = GetByte(buf, i)
                    has = 1
                    IfCondition EqualTo(c, 0) ThenBlock: { has = 0 }
                    IfCondition EqualTo(c, 10) ThenBlock: { has = 0 }
                    IfCondition EqualTo(c, 13) ThenBlock: { has = 0 }
                    IfCondition EqualTo(has, 1) ThenBlock: {
                        nm = Allocate(64)
                        k = 0
                        WhileLoop LessThan(k, 63) {
                            c = GetByte(buf, Add(i, k))
                            stop = 0
                            IfCondition EqualTo(c, 0) ThenBlock: { stop = 1 }
                            IfCondition EqualTo(c, 10) ThenBlock: { stop = 1 }
                            IfCondition EqualTo(c, 13) ThenBlock: { stop = 1 }
                            IfCondition EqualTo(c, 32) ThenBlock: { stop = 1 }
                            IfCondition EqualTo(stop, 1) ThenBlock: { k = 63 }
                            IfCondition EqualTo(stop, 0) ThenBlock: {
                                SetByte(nm, k, c)
                                k = Add(k, 1)
                            }
                        }
                        SetByte(nm, 63, 0)
                        IfCondition LessThan(k, 63) ThenBlock: { SetByte(nm, k, 0) }
                        CA_SetPartName(nm)
                        Deallocate(nm, 64)
                    }
                    CA_RepoForget()
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
        }
        // plane_* / profiles / pt — all start with 'p'
        IfCondition EqualTo(c0, 112) ThenBlock: {
            // prune — drop hist scrapbook (keep current)
            IfCondition EqualTo(GetByte(buf, 1), 114) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 117) ThenBlock: {
                    CA_HistPrune()
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
            // plane_* commands: plane_top plane_off plane_org plane_flip
            // plane_from plane_pick plane_3pt plane_ang plane_xy|xz|yz
            IfCondition EqualTo(GetByte(buf, 1), 108) ThenBlock: {
                // "plane..."
                // plane_top
                IfCondition EqualTo(GetByte(buf, 6), 116) ThenBlock: {
                    CA_PlaneOnTop()
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
                // plane_pick — activate an existing construction plane
                IfCondition EqualTo(GetByte(buf, 6), 112) ThenBlock: {
                    CA_PlaneBeginPick()
                    CA_PublishFrame()
                    ReturnValue(2)
                }
                // plane_3pt — through three points
                IfCondition EqualTo(GetByte(buf, 6), 51) ThenBlock: {
                    CA_PlaneBegin3Pt()
                    CA_PublishFrame()
                    ReturnValue(2)
                }
                // plane_off [N]  vs plane_org (set origin)
                IfCondition EqualTo(GetByte(buf, 6), 111) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, 7), 114) ThenBlock: {
                        CA_PlaneBeginOrigin()
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    out = CA_IpcOut()
                    j = CA_ParseFixed100(buf, 10, out)
                    IfCondition LessThan(j, 0) ThenBlock: {
                        CadApp.plane_kind = 1
                        CA_Log("cad_app: Offset — type mm in HUD, Enter\n", 40)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    CadApp.plane_kind = 0
                    CA_PlaneOffsetCenti(ArrayGet(out, 0))
                    CA_PublishFrame()
                    ReturnValue(2)
                }
                // plane_flip vs plane_from
                IfCondition EqualTo(GetByte(buf, 6), 102) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, 7), 114) ThenBlock: {
                        CA_PlaneBeginFromFace()
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    CA_PlaneFlip()
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
                // plane_ang [N] — no number arms HUD (type deg)
                IfCondition EqualTo(GetByte(buf, 6), 97) ThenBlock: {
                    out = CA_IpcOut()
                    j = CA_ParseFixed100(buf, 10, out)
                    IfCondition LessThan(j, 0) ThenBlock: {
                        CadApp.plane_kind = 2
                        CA_Log("cad_app: Angle — type deg in HUD, Enter\n", 40)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    CadApp.plane_kind = 0
                    CA_PlaneAngleXCenti(ArrayGet(out, 0))
                    CA_PublishFrame()
                    ReturnValue(2)
                }
                // plane_xy / plane_xz / plane_yz
                IfCondition EqualTo(GetByte(buf, 6), 120) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, 7), 121) ThenBlock: {
                        CA_PlaneDatumXY()
                    }
                    IfCondition EqualTo(GetByte(buf, 7), 122) ThenBlock: {
                        CA_PlaneDatumXZ()
                    }
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
                IfCondition EqualTo(GetByte(buf, 6), 121) ThenBlock: {
                    CA_PlaneDatumYZ()
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
                // bare "plane" → OnTop if solid else new XY
                IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
                    CA_PlaneDatumXY()
                }
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                    CA_PlaneOnTop()
                }
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            // "proj" — show/hide face projections in the sketch
            IfCondition EqualTo(GetByte(buf, 1), 114) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 111) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, 3), 106) ThenBlock: {
                        CadApp.show_proj = Subtract(1, CadApp.show_proj)
                        CA_LogInt("cad_app: projections=", 21, CadApp.show_proj)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                }
            }
            // "profiles" or "prof" — Solid tab / Pick. No body → keep sketch visible.
            IfCondition EqualTo(GetByte(buf, 1), 114) ThenBlock: {
                IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
                    CadApp.mode = 1
                }
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                    CadApp.mode = 0
                }
                CadApp.tool = 4
                CadApp.nclick = 0
                CA_RebuildProfiles()
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            // pmode N — 0 center  1 edge  2 center-3pt
            IfCondition EqualTo(GetByte(buf, 1), 109) ThenBlock: {
                out = CA_IpcOut()
                j = CA_ParseSigned(buf, 5, out)
                IfCondition GreaterThan(j, 0) ThenBlock: {
                    CadApp.poly_mode = ArrayGet(out, 0)
                    IfCondition LessThan(CadApp.poly_mode, 0) ThenBlock: { CadApp.poly_mode = 0 }
                    IfCondition GreaterThan(CadApp.poly_mode, 2) ThenBlock: { CadApp.poly_mode = 2 }
                    CadApp.tool = 17
                    CadApp.nclick = 0
                    CadApp.hud_kind = 0
                    CadApp.hud_field = 0
                    CA_PublishFrame()
                }
                ReturnValue(2)
            }
            // pt X Y — place user Point at integer mm UV (HUD-style numeric entry)
            IfCondition EqualTo(GetByte(buf, 1), 116) ThenBlock: {
                IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                    CadApp.sketch = CAD_Sketch.CreateSketch(1)
                }
                out = CA_IpcOut()
                i = CA_ParseSigned(buf, 2, out)
                ok = 0
                pxm = 0
                pym = 0
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    pxm = ArrayGet(out, 0)
                    j = CA_ParseSigned(buf, i, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        pym = ArrayGet(out, 0)
                        ok = 1
                    }
                }
                // parse buf is pinned (CadAppIpc.parse)
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    CadApp.mode = 1
                    pi = CAD_Sketch.AddUserPoint(CadApp.sketch, Float_FromInt(pxm), Float_FromInt(pym), 0)
                    CadApp.last_upt = pi
                    CadApp.dirty = 1
                    CA_Log("cad_app: point at UV (pt X Y)\n", 30)
                    CA_PublishFrame()
                }
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        // sketch_pln / solve — start with 's'
        IfCondition EqualTo(c0, 115) ThenBlock: {
            // setkind part|assembly|group|machine
            IfCondition EqualTo(GetByte(buf, 1), 101) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 116) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, 3), 107) ThenBlock: {
                        i = 7
                        WhileLoop EqualTo(GetByte(buf, i), 32) {
                            i = Add(i, 1)
                            IfCondition GreaterThan(i, 40) ThenBlock: { i = 41 }
                        }
                        nm = Allocate(32)
                        k = 0
                        WhileLoop LessThan(k, 31) {
                            c = GetByte(buf, Add(i, k))
                            stop = 0
                            IfCondition EqualTo(c, 0) ThenBlock: { stop = 1 }
                            IfCondition EqualTo(c, 10) ThenBlock: { stop = 1 }
                            IfCondition EqualTo(c, 13) ThenBlock: { stop = 1 }
                            IfCondition EqualTo(c, 32) ThenBlock: { stop = 1 }
                            IfCondition EqualTo(stop, 1) ThenBlock: { k = 31 }
                            IfCondition EqualTo(stop, 0) ThenBlock: {
                                SetByte(nm, k, c)
                                k = Add(k, 1)
                            }
                        }
                        SetByte(nm, 31, 0)
                        IfCondition LessThan(k, 31) ThenBlock: { SetByte(nm, k, 0) }
                        CA_SetDocKind(nm)
                        Deallocate(nm, 32)
                        CA_Log("cad_app: doc kind set\n", 22)
                        CA_WriteStatus()
                        ReturnValue(2)
                    }
                }
            }
            // sname [N] ALIAS — keep Sketch_N id, set user name
            IfCondition EqualTo(GetByte(buf, 1), 110) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 97) ThenBlock: {
                    out = CA_IpcOut()
                    i = 5
                    WhileLoop EqualTo(GetByte(buf, i), 32) {
                        i = Add(i, 1)
                        IfCondition GreaterThan(i, 70) ThenBlock: { i = 71 }
                    }
                    sid = CA_CurrentSkIdx()
                    j = CA_ParseSigned(buf, i, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        IfCondition EqualTo(GetByte(buf, j), 32) ThenBlock: {
                            sid = ArrayGet(out, 0)
                            i = j
                            WhileLoop EqualTo(GetByte(buf, i), 32) {
                                i = Add(i, 1)
                                IfCondition GreaterThan(i, 70) ThenBlock: { i = 71 }
                            }
                        }
                    }
                    nm = Allocate(64)
                    k = 0
                    WhileLoop LessThan(k, 31) {
                        c = GetByte(buf, Add(i, k))
                        stop = 0
                        IfCondition EqualTo(c, 0) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(c, 10) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(c, 13) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(stop, 1) ThenBlock: { k = 31 }
                        IfCondition EqualTo(stop, 0) ThenBlock: {
                            SetByte(nm, k, c)
                            k = Add(k, 1)
                        }
                    }
                    SetByte(nm, 31, 0)
                    IfCondition LessThan(k, 31) ThenBlock: { SetByte(nm, k, 0) }
                    CA_SetSketchAlias(sid, nm)
                    Deallocate(nm, 64)
                    CA_LogInt("cad_app: sketch alias ", 22, sid)
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
            // sketch_pln — new sketch on active construction plane
            IfCondition EqualTo(GetByte(buf, 1), 107) ThenBlock: {
                CA_SketchOnActivePlane()
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            // solve — multipass constraint projection
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 108) ThenBlock: {
                    IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                        napp = CAD_Sketch.SolveConstraints(CadApp.sketch)
                        CA_InvalidateProfiles()
                        CadApp.dirty = 1
                        CA_Log("cad_app: SolveConstraints done\n", 31)
                        CA_PublishFrame()
                    }
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        // cstr_* — interactive constraint tools (pick geom after)
        // cstr_coinc cstr_h cstr_v cstr_fixo cstr_disto cstr_rad cstr_tang cstr_pon cstr_eqr cstr_dist
        IfCondition EqualTo(c0, 99) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 115) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 116) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, 3), 114) ThenBlock: {
                        IfCondition EqualTo(GetByte(buf, 4), 95) ThenBlock: {
                            // cstr_
                            b5 = GetByte(buf, 5)
                            // coinc
                            IfCondition EqualTo(b5, 99) ThenBlock: {
                                CA_BeginConstraint(9)
                                CA_Log("cad_app: COIN - click point A, then B\n", 38)
                            }
                            // h
                            IfCondition EqualTo(b5, 104) ThenBlock: {
                                CA_BeginConstraint(7)
                                CA_Log("cad_app: H - click a line\n", 26)
                            }
                            // v
                            IfCondition EqualTo(b5, 118) ThenBlock: {
                                CA_BeginConstraint(8)
                                CA_Log("cad_app: V - click a line\n", 26)
                            }
                            // fixo / fixx / fixy  (fixu/fixv aliases)
                            IfCondition EqualTo(b5, 102) ThenBlock: {
                                b8 = GetByte(buf, 8)
                                IfCondition EqualTo(b8, 120) ThenBlock: {
                                    CA_BeginConstraint(2)
                                    CA_Log("cad_app: FixX - click point, lock X\n", 36)
                                }
                                IfCondition EqualTo(b8, 117) ThenBlock: {
                                    CA_BeginConstraint(2)
                                    CA_Log("cad_app: FixX - click point, lock X\n", 36)
                                }
                                IfCondition EqualTo(b8, 121) ThenBlock: {
                                    CA_BeginConstraint(3)
                                    CA_Log("cad_app: FixY - click point, lock Y\n", 36)
                                }
                                IfCondition EqualTo(b8, 118) ThenBlock: {
                                    CA_BeginConstraint(3)
                                    CA_Log("cad_app: FixY - click point, lock Y\n", 36)
                                }
                                IfCondition EqualTo(b8, 111) ThenBlock: {
                                    CA_BeginConstraint(1)
                                    CA_Log("cad_app: FixO - click point or end\n", 35)
                                }
                            }
                            // disto / dist
                            IfCondition EqualTo(b5, 100) ThenBlock: {
                                // cstr_disto vs cstr_dist
                                IfCondition EqualTo(GetByte(buf, 9), 111) ThenBlock: {
                                    CA_BeginConstraint(6)
                                    CA_Log("cad_app: DistO - click point, lock |O|\n", 39)
                                }
                                IfCondition NotEqual(GetByte(buf, 9), 111) ThenBlock: {
                                    CA_BeginConstraint(15)
                                    CA_Log("cad_app: Dist - click pt A then B\n", 34)
                                }
                            }
                            // rad
                            IfCondition EqualTo(b5, 114) ThenBlock: {
                                CA_BeginConstraint(11)
                                CA_Log("cad_app: Rad - click circle rim/center\n", 39)
                            }
                            // tang
                            IfCondition EqualTo(b5, 116) ThenBlock: {
                                CA_BeginConstraint(13)
                                CA_Log("cad_app: TANG - line+circ or 2 circs\n", 37)
                            }
                            // pon
                            IfCondition EqualTo(b5, 112) ThenBlock: {
                                CA_BeginConstraint(10)
                                CA_Log("cad_app: OnLn - point then line\n", 32)
                            }
                            // eqr
                            IfCondition EqualTo(b5, 101) ThenBlock: {
                                CA_BeginConstraint(12)
                                CA_Log("cad_app: EqR - click 2 circles\n", 31)
                            }
                            CA_PublishFrame()
                            // cmd buf pinned
                            ReturnValue(2)
                        }
                    }
                }
            }
        }
        // csk — clear current sketch only (keep solid / tree)
        IfCondition EqualTo(c0, 99) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 115) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 107) ThenBlock: {
                    CA_ClearSketch()
                    CadApp.dirty = 1
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
        }
        // clear model tree / last pad (cmd "clear")
        IfCondition EqualTo(c0, 99) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 108) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 101) ThenBlock: {
                    CA_ClearModel()
                    CadApp.dirty = 1
                    CA_Log("cad_app: model tree cleared\n", 28)
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        // ninc / ndec — polygon side count (any N, 2=slot, 3..64)
        IfCondition EqualTo(c0, 110) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 105) ThenBlock: {
                CadApp.poly_n = Add(CadApp.poly_n, 1)
                IfCondition GreaterThan(CadApp.poly_n, 64) ThenBlock: { CadApp.poly_n = 64 }
                CadApp.tool = 17
                CA_PublishFrame()
                ReturnValue(2)
            }
            IfCondition EqualTo(GetByte(buf, 1), 100) ThenBlock: {
                IfCondition GreaterThan(CadApp.poly_n, 2) ThenBlock: {
                    CadApp.poly_n = Subtract(CadApp.poly_n, 1)
                }
                CadApp.tool = 17
                CA_PublishFrame()
                ReturnValue(2)
            }
            // nsides N
            IfCondition EqualTo(GetByte(buf, 1), 115) ThenBlock: {
                out = CA_IpcOut()
                j = CA_ParseSigned(buf, 6, out)
                IfCondition GreaterThan(j, 0) ThenBlock: {
                    nn = ArrayGet(out, 0)
                    IfCondition LessThan(nn, 2) ThenBlock: { nn = 2 }
                    IfCondition GreaterThan(nn, 64) ThenBlock: { nn = 64 }
                    CadApp.poly_n = nn
                    CadApp.tool = 17
                    CA_PublishFrame()
                }
                ReturnValue(2)
            }
        }
        // name PART  (must beat newdoc — both start with n)
        IfCondition EqualTo(c0, 110) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 97) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 109) ThenBlock: {
                    nm = Allocate(64)
                    i = 4
                    WhileLoop EqualTo(GetByte(buf, i), 32) {
                        i = Add(i, 1)
                        IfCondition GreaterThan(i, 70) ThenBlock: { i = 71 }
                    }
                    j = 0
                    WhileLoop LessThan(j, 63) {
                        c = GetByte(buf, Add(i, j))
                        stop = 0
                        IfCondition EqualTo(c, 0) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(c, 10) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(c, 13) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(stop, 1) ThenBlock: { j = 63 }
                        IfCondition EqualTo(stop, 0) ThenBlock: {
                            SetByte(nm, j, c)
                            j = Add(j, 1)
                        }
                    }
                    SetByte(nm, 63, 0)
                    IfCondition LessThan(j, 63) ThenBlock: { SetByte(nm, j, 0) }
                    CA_SetPartName(nm)
                    Deallocate(nm, 64)
                    CA_Log("cad_app: part name set\n", 23)
                    CA_WriteStatus()
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        // new document
        IfCondition EqualTo(c0, 110) ThenBlock: {
            // newdoc vs new sketch: "newdoc" or plain n
            IfCondition EqualTo(GetByte(buf, 1), 101) ThenBlock: {
                // "new..." -> DocNew if newdoc, else NewSketch
                IfCondition EqualTo(GetByte(buf, 3), 100) ThenBlock: {
                    CA_DocNew()
                }
                IfCondition NotEqual(GetByte(buf, 3), 100) ThenBlock: {
                    CA_DocNew()
                }
            }
            IfCondition NotEqual(GetByte(buf, 1), 101) ThenBlock: {
                CA_DocNew()
            }
            CA_PublishFrame()
            // cmd buf pinned
            ReturnValue(2)
        }
        // redo — before repad/revolve
        IfCondition EqualTo(c0, 114) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 101) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 100) ThenBlock: {
                    CA_HistFwd()
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
        }
        // repad / reload / revolve  (all start with 'r')
        IfCondition EqualTo(c0, 114) ThenBlock: {
            // "reload" if third char is 'l'
            IfCondition EqualTo(GetByte(buf, 2), 108) ThenBlock: {
                CA_ReloadDxf()
                CadApp.mode = 0
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            // "revolve" if second char is 'e' and third is 'v'
            IfCondition EqualTo(GetByte(buf, 1), 101) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 118) ThenBlock: {
                    rrc = CA_RevolveFromSketch()
                    // -4 = waiting for axis click; stay on revaxis tool
                    IfCondition NotEqual(rrc, -4) ThenBlock: {
                        CadApp.mode = 0
                    }
                    IfCondition EqualTo(rrc, -4) ThenBlock: {
                        CadApp.tool = 11
                        CadApp.mode = 0
                    }
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
            // default: repad
            CA_PadFromSketch()
            CadApp.mode = 0
            // cmd buf pinned
            ReturnValue(2)
        }
        // undo (must beat bare "u" = cut)
        IfCondition EqualTo(c0, 117) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 110) ThenBlock: {
                CA_HistBack()
                CA_PublishFrame()
                ReturnValue(2)
            }
            CA_CutFromSketch()
            CadApp.mode = 0
            CA_PublishFrame()
            // cmd buf pinned
            ReturnValue(2)
        }
        IfCondition EqualTo(c0, 99) ThenBlock: {
            // "cut ..." vs click — click already handled; "cut" alone
            IfCondition EqualTo(GetByte(buf, 1), 117) ThenBlock: {
                CA_CutFromSketch()
                CadApp.mode = 0
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        // y / Next = cycle pad profile selection (explicit user choice)
        IfCondition EqualTo(c0, 121) ThenBlock: {
            CadApp.mode = 1
            CadApp.solid = 0
            skn = 0
            IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                skn = CAD_Store.Read(CadApp.sketch, 12)
            }
            IfCondition EqualTo(skn, 0) ThenBlock: {
                CA_RebuildProfiles()
                skn = CadApp.nprof
            }
            IfCondition EqualTo(skn, 0) ThenBlock: {
                IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                    skn = CAD_Store.Read(CadApp.sketch, 12)
                }
            }
            IfCondition EqualTo(skn, 0) ThenBlock: {
                CA_Log("cad_app: no profiles to select\n", 31)
            }
            IfCondition GreaterThan(skn, 0) ThenBlock: {
                CadApp.nprof = skn
                IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
                    CA_Log("cad_app: Next - click a light-red face first (no auto-select)\n", 63)
                }
                IfCondition EqualTo(CadApp.prof_user, 1) ThenBlock: {
                    CadApp.prof_sel = Add(CadApp.prof_sel, 1)
                    IfCondition GreaterEqual(CadApp.prof_sel, skn) ThenBlock: {
                        CadApp.prof_sel = 0
                    }
                    ok = CA_ApplyProfileSel(CadApp.prof_sel, skn, 0)
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        CA_Log("cad_app: Next - profile selected (red)\n", 39)
                    }
                }
            }
            CA_PublishFrame()
            // cmd buf pinned
            ReturnValue(2)
        }
        // fillet [Rmm] — solid body blend (NOT sketch tool_fillet)
        // "fillet" / "fillet 5" / "fillet3d"
        IfCondition EqualTo(c0, 102) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 105) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 108) ThenBlock: {
                    // "fillet" (f-i-l-l) — not "files" (f-i-l-e)
                    IfCondition EqualTo(GetByte(buf, 3), 108) ThenBlock: {
                    rmm = 2
                    out = CA_IpcOut()
                    // skip "fillet" then optional space+number
                    j = 6
                    WhileLoop EqualTo(GetByte(buf, j), 32) {
                        j = Add(j, 1)
                    }
                    // fillet3d → still default R
                    IfCondition NotEqual(GetByte(buf, j), 0) ThenBlock: {
                        IfCondition NotEqual(GetByte(buf, j), 10) ThenBlock: {
                            k = CA_ParseSigned(buf, j, out)
                            IfCondition GreaterThan(k, 0) ThenBlock: {
                                rmm = ArrayGet(out, 0)
                            }
                        }
                    }
                    // parse buf is pinned (CadAppIpc.parse)
                    CA_FilletSolid(rmm)
                    CadApp.mode = 0
                    CadApp.tool = 8
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                    }
                }
            }
        }
        // chamfer [Dmm] — solid body bevel
        IfCondition EqualTo(c0, 99) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 104) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 97) ThenBlock: {
                    dmm = 2
                    out = CA_IpcOut()
                    j = 7
                    WhileLoop EqualTo(GetByte(buf, j), 32) {
                        j = Add(j, 1)
                    }
                    IfCondition NotEqual(GetByte(buf, j), 0) ThenBlock: {
                        IfCondition NotEqual(GetByte(buf, j), 10) ThenBlock: {
                            k = CA_ParseSigned(buf, j, out)
                            IfCondition GreaterThan(k, 0) ThenBlock: {
                                dmm = ArrayGet(out, 0)
                            }
                        }
                    }
                    // parse buf is pinned (CadAppIpc.parse)
                    CA_ChamferSolid(dmm)
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        // --- document browser ---
        // "files" / "file" only — bare "f" used to be ISO cube and ran DocList+remesh (crash)
        IfCondition EqualTo(c0, 102) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 105) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 108) ThenBlock: {
                    CA_Log("cad_app: ipc files\n", 19)
                    CA_DocList()
                    CA_Log("cad_app: ipc files done\n", 24)
                    // parts.txt only — do not remesh / do not leave list_open
                    ReturnValue(2)
                }
            }
        }
        // iso — viewcube ISO (was wrongly sent as "f")
        IfCondition EqualTo(c0, 105) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 115) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 111) ThenBlock: {
                    CadApp.view = 0
                    CAD_View.SetViewMode(0)
                    CA_Log("cad_app: view ISO\n", 18)
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        // j = sel next
        IfCondition EqualTo(c0, 106) ThenBlock: {
            CA_DocSelNext()
            CA_PublishFrame()
            // cmd buf pinned
            ReturnValue(2)
        }
        // i = sel prev (single key only — not "import")
        IfCondition EqualTo(c0, 105) ThenBlock: {
            b1 = GetByte(buf, 1)
            IfCondition EqualTo(b1, 0) ThenBlock: {
                CA_DocSelPrev()
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            IfCondition EqualTo(b1, 10) ThenBlock: {
                CA_DocSelPrev()
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            IfCondition EqualTo(b1, 13) ThenBlock: {
                CA_DocSelPrev()
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            IfCondition EqualTo(b1, 32) ThenBlock: {
                CA_DocSelPrev()
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            // import — DXF from path.txt (Gtk file dialog / agent)
            IfCondition EqualTo(b1, 109) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 112) ThenBlock: {
                    rc = CA_ImportFromPathFile()
                    CadApp.mode = 0
                    IfCondition NotEqual(rc, 0) ThenBlock: {
                        CA_Log("cad_app: import FAIL\n", 21)
                    }
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        // ontop — 3D pie / Solid "On Face" (must beat "open")
        IfCondition EqualTo(GetByte(buf, 0), 111) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 110) ThenBlock: {
                CA_PlaneOnTop()
                CA_PublishFrame()
                ReturnValue(2)
            }
        }
        // opac N — solid fill % (must beat "open")
        IfCondition EqualTo(GetByte(buf, 0), 111) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 112) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 97) ThenBlock: {
                    out = CA_IpcOut()
                    j = CA_ParseSigned(buf, 4, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        CadApp.opac = CAD_View.SetOpacity(ArrayGet(out, 0))
                    }
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
        }
        // open (selected)
        IfCondition EqualTo(GetByte(buf, 0), 111) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 112) ThenBlock: {
                CA_DocOpen()
                CadApp.mode = 0
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        // close
        IfCondition EqualTo(c0, 107) ThenBlock: {
            // k = close document
            CA_DocClose()
            CA_PublishFrame()
            // cmd buf pinned
            ReturnValue(2)
        }
        IfCondition EqualTo(c0, 99) ThenBlock: {
            // cancel (ca...) vs close (cl...)
            IfCondition EqualTo(GetByte(buf, 1), 97) ThenBlock: {
                // Cancel USE only (keep tool). Light path — no full PublishFrame
                // (was locking when many arcs/circles forced a heavy redraw mid-gesture).
                CA_CancelTool()
                CA_WriteToolFile()
                CA_WriteStatus()
                // cmd buf pinned
                ReturnValue(2)
            }
            IfCondition EqualTo(GetByte(buf, 1), 108) ThenBlock: {
                CA_DocClose()
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        // put/save to Postgres (p or "save")
        IfCondition EqualTo(c0, 112) ThenBlock: {
            CA_Log("cad_app: ipc put/save\n", 22)
            CA_RepoSave()
            CA_Log("cad_app: ipc save done\n", 23)
            CA_PublishFrame()
            // cmd buf pinned
            ReturnValue(2)
        }
        IfCondition EqualTo(c0, 115) ThenBlock: {
            // saveover — replace latest rev in place
            IfCondition EqualTo(GetByte(buf, 1), 97) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 4), 111) ThenBlock: {
                    CA_Log("cad_app: ipc saveover\n", 22)
                    CAD_Repo_State.do_overwrite = 1
                    CA_RepoSave()
                    CA_Log("cad_app: ipc saveover done\n", 27)
                    CA_PublishFrame()
                    ReturnValue(2)
                }
                CA_Log("cad_app: ipc save\n", 18)
                CA_RepoSave()
                CA_Log("cad_app: ipc save done\n", 23)
                CA_PublishFrame()
                ReturnValue(2)
            }
        }
        // grid / grid 0 / grid 1 — before bare "g" (must not steal "grid")
        IfCondition EqualTo(c0, 103) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 114) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 105) ThenBlock: {
                    setg = 0
                    IfCondition EqualTo(GetByte(buf, 4), 32) ThenBlock: {
                        IfCondition EqualTo(GetByte(buf, 5), 48) ThenBlock: {
                            CadApp.show_grid = 0
                            setg = 1
                        }
                        IfCondition EqualTo(GetByte(buf, 5), 49) ThenBlock: {
                            CadApp.show_grid = 1
                            setg = 1
                        }
                    }
                    IfCondition EqualTo(setg, 0) ThenBlock: {
                        CadApp.show_grid = Subtract(1, CadApp.show_grid)
                    }
                    CA_Log("cad_app: grid\n", 14)
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        // skvis / skvis 0 / skvis 1 — 3D sketch overlay (View tab Sketch)
        IfCondition EqualTo(c0, 115) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 107) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 118) ThenBlock: {
                    setg = 0
                    IfCondition EqualTo(GetByte(buf, 5), 32) ThenBlock: {
                        IfCondition EqualTo(GetByte(buf, 6), 48) ThenBlock: {
                            CadApp.show_sketch = 0
                            setg = 1
                        }
                        IfCondition EqualTo(GetByte(buf, 6), 49) ThenBlock: {
                            CadApp.show_sketch = 1
                            setg = 1
                        }
                    }
                    IfCondition EqualTo(setg, 0) ThenBlock: {
                        CadApp.show_sketch = Subtract(1, CadApp.show_sketch)
                    }
                    CA_LogInt("cad_app: skvis=", 16, CadApp.show_sketch)
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
        }
        // get/load from Postgres (bare "g" only — not "grid")
        IfCondition EqualTo(c0, 103) ThenBlock: {
            b1 = GetByte(buf, 1)
            bare = 0
            IfCondition EqualTo(b1, 0) ThenBlock: { bare = 1 }
            IfCondition EqualTo(b1, 10) ThenBlock: { bare = 1 }
            IfCondition EqualTo(b1, 13) ThenBlock: { bare = 1 }
            IfCondition EqualTo(b1, 32) ThenBlock: { bare = 1 }
            IfCondition EqualTo(bare, 1) ThenBlock: {
                IfCondition EqualTo(CadApp.list_open, 1) ThenBlock: {
                    CA_DocOpen()
                }
                IfCondition EqualTo(CadApp.list_open, 0) ThenBlock: {
                    CA_RepoLoad()
                }
                CadApp.mode = 0
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        IfCondition EqualTo(c0, 108) ThenBlock: {
            // load (not tool_line which starts with t)
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                CA_RepoLoad()
                CadApp.mode = 0
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        // wire
        IfCondition EqualTo(c0, 119) ThenBlock: {
            CadApp.wire = Subtract(1, CadApp.wire)
            CA_PublishFrame()
            // cmd buf pinned
            ReturnValue(2)
        }
        // side N — polygon side length mm (0 = use click)
        IfCondition EqualTo(c0, 115) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 105) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 100) ThenBlock: {
                    out = CA_IpcOut()
                    j = CA_ParseSigned(buf, 4, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        CadApp.poly_side = ArrayGet(out, 0)
                        IfCondition LessThan(CadApp.poly_side, 0) ThenBlock: { CadApp.poly_side = 0 }
                        CadApp.tool = 17
                        CA_PublishFrame()
                    }
                    ReturnValue(2)
                }
            }
        }
        // shot / screenshot — write live BMP under IPC dir + test-stl
        IfCondition EqualTo(c0, 115) ThenBlock: {
            do_shot = 0
            IfCondition EqualTo(GetByte(buf, 1), 104) ThenBlock: { do_shot = 1 }
            IfCondition EqualTo(GetByte(buf, 1), 99) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 114) ThenBlock: { do_shot = 1 }
            }
            IfCondition EqualTo(do_shot, 1) ThenBlock: {
                CA_PublishFrame()
                CAD_View.SaveFBToBMP("/tmp/cad_app/shot.bmp")
                CAD_View.SaveFBToBMP("test-stl/cad_app_live.bmp")
                CA_Log("cad_app: screenshot ok\n", 23)
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        // view0..view7 — ISO / top / front / (3=free) / right / left / back / bottom
        IfCondition EqualTo(c0, 118) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 105) ThenBlock: {
                c4 = GetByte(buf, 4)
                vm = -1
                IfCondition EqualTo(c4, 48) ThenBlock: { vm = 0 }
                IfCondition EqualTo(c4, 49) ThenBlock: { vm = 1 }
                IfCondition EqualTo(c4, 50) ThenBlock: { vm = 2 }
                IfCondition EqualTo(c4, 52) ThenBlock: { vm = 4 }
                IfCondition EqualTo(c4, 53) ThenBlock: { vm = 5 }
                IfCondition EqualTo(c4, 54) ThenBlock: { vm = 6 }
                IfCondition EqualTo(c4, 55) ThenBlock: { vm = 7 }
                IfCondition GreaterEqual(vm, 0) ThenBlock: {
                    CadApp.view = vm
                    CAD_View.SetViewMode(vm)
                    CA_PublishFrame()
                }
                ReturnValue(2)
            }
        }
        // height N / pad_h N — set pad/extrude thickness (mm) without requiring rebuild
        // hinc / hdec — nudge ±1 mm; rebuild solid only if sketch/solid present
        IfCondition EqualTo(c0, 104) ThenBlock: {
            c1 = GetByte(buf, 1)
            // htab — cycle kernel HUD field (N/L/D or L/A)
            IfCondition EqualTo(c1, 116) ThenBlock: {
                CA_HudTab()
                CA_PublishFrame()
                ReturnValue(2)
            }
            // hudok = Enter with no digits (accept + close)
            // hudoff = idle dismiss (no apply)
            IfCondition EqualTo(c1, 117) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 4), 107) ThenBlock: {
                    CA_HudOk()
                }
                IfCondition NotEqual(GetByte(buf, 4), 107) ThenBlock: {
                    CA_HudClose()
                }
                CA_PublishFrame()
                ReturnValue(2)
            }
            // hist N — slider / timeline
            IfCondition EqualTo(c1, 105) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 115) ThenBlock: {
                    out = CA_IpcOut()
                    j = CA_ParseSigned(buf, 5, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        CA_HistGo(ArrayGet(out, 0))
                    }
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
            // "height N" (he...) or "h 12" bare short form after "h "
            IfCondition EqualTo(c1, 101) ThenBlock: {
                // height N — number after "height "
                out = CA_IpcOut()
                j = CA_ParseSigned(buf, 7, out)
                IfCondition GreaterThan(j, 0) ThenBlock: {
                    nh = ArrayGet(out, 0)
                    IfCondition LessThan(nh, 1) ThenBlock: { nh = 1 }
                    IfCondition GreaterThan(nh, 10000) ThenBlock: { nh = 10000 }
                    CadApp.height = nh
                    CA_Log("cad_app: pad height set\n", 24)
                    IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                        CA_PadApplyHeight()
                    }
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
            // "h 12" short form (space then digits) — not hover/hinc/hdec
            IfCondition EqualTo(c1, 32) ThenBlock: {
                out = CA_IpcOut()
                j = CA_ParseSigned(buf, 2, out)
                IfCondition GreaterThan(j, 0) ThenBlock: {
                    nh = ArrayGet(out, 0)
                    IfCondition LessThan(nh, 1) ThenBlock: { nh = 1 }
                    IfCondition GreaterThan(nh, 10000) ThenBlock: { nh = 10000 }
                    CadApp.height = nh
                    CA_Log("cad_app: pad height set\n", 24)
                    IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                        CA_PadApplyHeight()
                    }
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
            // hinc
            IfCondition EqualTo(c1, 105) ThenBlock: {
                CadApp.height = Add(CadApp.height, 1)
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                    CA_PadApplyHeight()
                }
                CA_PublishFrame()
                ReturnValue(2)
            }
            // hdec
            IfCondition EqualTo(c1, 100) ThenBlock: {
                IfCondition GreaterThan(CadApp.height, 1) ThenBlock: {
                    CadApp.height = Subtract(CadApp.height, 1)
                }
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                    CA_PadApplyHeight()
                }
                CA_PublishFrame()
                ReturnValue(2)
            }
        }
        // stash — persist unsaved work as <name>_dirty
        IfCondition EqualTo(c0, 115) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 116) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 97) ThenBlock: {
                    CA_RepoStash()
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
        }
        // step
        IfCondition EqualTo(c0, 115) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                CAD_IO.ExportSTEP(CadApp.solid, "test-stl/cad_app_live.stp")
                CA_Log("cad_app: STEP ok\n", 17)
            }
            // cmd buf pinned
            ReturnValue(2)
        }
        // bmp
        IfCondition EqualTo(c0, 98) ThenBlock: {
            CA_PublishFrame()
            CAD_View.SaveFBToBMP("test-stl/cad_app_live.bmp")
            CA_Log("cad_app: BMP ok\n", 16)
            // cmd buf pinned
            ReturnValue(2)
        }
        // dim N — type-in length / radius / poly side / HUD field (hundredths)
        IfCondition EqualTo(c0, 100) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 105) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 109) ThenBlock: {
                    out = CA_IpcOut()
                    j = CA_ParseFixed100(buf, 3, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        used = 0
                        IfCondition NotEqual(CadApp.hud_kind, 0) ThenBlock: {
                            CA_HudEnter(ArrayGet(out, 0))
                            used = 1
                        }
                        IfCondition EqualTo(used, 0) ThenBlock: {
                            CA_CommitDim(Divide(ArrayGet(out, 0), 100))
                        }
                    }
                    ReturnValue(2)
                }
            }
        }
        // done = finish spline; else dxf export
        IfCondition EqualTo(c0, 100) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                CA_FinishSpline()
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                CAD_DXF.ExportSketch(CadApp.sketch, "test-stl/cad_app_sketch.dxf")
                CA_Log("cad_app: DXF ok\n", 16)
            }
            // cmd buf pinned
            ReturnValue(2)
        }
        // cmd buf pinned
        ReturnValue(0)
    }
}


Function.CA_BuildSchema {
    Output: Address
    Body: {
        s = UtilArgs_NewSchema("cad_app", "Live DXF/sketch → solid viewer")
        UtilArgs_AddField(s, "in", "path", 0, "Input plate/profile DXF", "in")
        UtilArgs_AddField(s, "hole", "path", 0, "Optional hole DXF (through cut)", "hole")
        UtilArgs_AddField(s, "name", "string", 0, "Part name for Postgres save/load", "name")
        UtilArgs_AddField(s, "save", "bool", 0, "Headless: save part to Postgres", "save")
        UtilArgs_AddField(s, "load", "bool", 0, "Headless: load part from Postgres", "load")
        UtilArgs_AddField(s, "height", "int", 0, "Pad / plate thickness mm", "height")
        UtilArgs_AddField(s, "width", "int", 0, "View width", "width")
        UtilArgs_AddField(s, "imgh", "int", 0, "View height", "imgh")
        UtilArgs_AddField(s, "shot", "path", 0, "Headless BMP", "shot")
        UtilArgs_AddField(s, "headless", "bool", 0, "One-shot BMP", "headless")
        UtilArgs_AddField(s, "nohost", "bool", 0, "No X11 host", "nohost")
        UtilArgs_AddField(s, "sketch-demo", "bool", 0, "Headless: build rect sketch and pad", "sketch-demo")
        UtilArgs_SetShort(s, "in", "i")
        UtilArgs_SetShort(s, "hole", "k")
        UtilArgs_SetShort(s, "height", "H")
        UtilArgs_SetShort(s, "width", "W")
        UtilArgs_SetShort(s, "shot", "o")
        // No default DXF — interactive starts empty (diamond looked like stale session data)
        UtilArgs_SetDefault(s, "height", "20")
        UtilArgs_SetDefault(s, "width", "800")
        UtilArgs_SetDefault(s, "imgh", "600")
        UtilArgs_SetDefault(s, "shot", "test-stl/cad_app.bmp")
        ReturnValue(s)
    }
}

