LibraryImport.Arena
LibraryImport.UtilArgs
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_View
LibraryImport.Cad.CAD_Repo
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_UI
LibraryImport.Display.Render.Framebuffer
LibraryImport.StringUtils

// CA_PollCmd first-byte 'c' (99).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdC {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        IfCondition EqualTo(c0, 99) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 115) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 116) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, 3), 114) ThenBlock: {
                        IfCondition EqualTo(GetByte(buf, 4), 95) ThenBlock: {
                            // cstr_
                            b5 = GetByte(buf, 5)
                            // coinc
                            IfCondition EqualTo(b5, 99) ThenBlock: {
                                CA_BeginConstraint(9)
                                CA_Log("cad_app: COIN - click point A, then B\n", 38)
                            }
                            // h
                            IfCondition EqualTo(b5, 104) ThenBlock: {
                                CA_BeginConstraint(7)
                                CA_Log("cad_app: H - click a line\n", 26)
                            }
                            // v
                            IfCondition EqualTo(b5, 118) ThenBlock: {
                                CA_BeginConstraint(8)
                                CA_Log("cad_app: V - click a line\n", 26)
                            }
                            // fixo / fixx / fixy  (fixu/fixv aliases)
                            IfCondition EqualTo(b5, 102) ThenBlock: {
                                b8 = GetByte(buf, 8)
                                IfCondition EqualTo(b8, 120) ThenBlock: {
                                    CA_BeginConstraint(2)
                                    CA_Log("cad_app: FixX - click point, lock X\n", 36)
                                }
                                IfCondition EqualTo(b8, 117) ThenBlock: {
                                    CA_BeginConstraint(2)
                                    CA_Log("cad_app: FixX - click point, lock X\n", 36)
                                }
                                IfCondition EqualTo(b8, 121) ThenBlock: {
                                    CA_BeginConstraint(3)
                                    CA_Log("cad_app: FixY - click point, lock Y\n", 36)
                                }
                                IfCondition EqualTo(b8, 118) ThenBlock: {
                                    CA_BeginConstraint(3)
                                    CA_Log("cad_app: FixY - click point, lock Y\n", 36)
                                }
                                IfCondition EqualTo(b8, 111) ThenBlock: {
                                    CA_BeginConstraint(1)
                                    CA_Log("cad_app: FixO - click point or end\n", 35)
                                }
                            }
                            // disto / dist
                            IfCondition EqualTo(b5, 100) ThenBlock: {
                                // cstr_disto vs cstr_dist
                                IfCondition EqualTo(GetByte(buf, 9), 111) ThenBlock: {
                                    CA_BeginConstraint(6)
                                    CA_Log("cad_app: DistO - click point, lock |O|\n", 39)
                                }
                                IfCondition NotEqual(GetByte(buf, 9), 111) ThenBlock: {
                                    CA_BeginConstraint(15)
                                    CA_Log("cad_app: Dist - click pt A then B\n", 34)
                                }
                            }
                            // rad
                            IfCondition EqualTo(b5, 114) ThenBlock: {
                                CA_BeginConstraint(11)
                                CA_Log("cad_app: Rad - click circle rim/center\n", 39)
                            }
                            // tang
                            IfCondition EqualTo(b5, 116) ThenBlock: {
                                CA_BeginConstraint(13)
                                CA_Log("cad_app: TANG - line+circ or 2 circs\n", 37)
                            }
                            // pon
                            IfCondition EqualTo(b5, 112) ThenBlock: {
                                CA_BeginConstraint(10)
                                CA_Log("cad_app: OnLn - point then line\n", 32)
                            }
                            // eqr
                            IfCondition EqualTo(b5, 101) ThenBlock: {
                                CA_BeginConstraint(12)
                                CA_Log("cad_app: EqR - click 2 circles\n", 31)
                            }
                            CA_PublishFrame()
                            // cmd buf pinned
                            ReturnValue(2)
                        }
                    }
                }
            }
        }
        // csk — clear current sketch only (keep solid / tree)
        IfCondition EqualTo(c0, 99) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 115) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 107) ThenBlock: {
                    CA_ClearSketch()
                    CadApp.dirty = 1
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
        }
        // clear model tree / last pad (cmd "clear")
        IfCondition EqualTo(c0, 99) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 108) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 101) ThenBlock: {
                    CA_ClearModel()
                    CadApp.dirty = 1
                    CA_Log("cad_app: model tree cleared\n", 28)
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        IfCondition EqualTo(c0, 99) ThenBlock: {
            // "cut ..." vs click — click already handled; "cut" alone
            IfCondition EqualTo(GetByte(buf, 1), 117) ThenBlock: {
                CA_CutFromSketch()
                CadApp.mode = 0
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        // chamfer [Dmm] — solid body bevel
        IfCondition EqualTo(c0, 99) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 104) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 97) ThenBlock: {
                    dmm = 2
                    out = CA_IpcOut()
                    j = 7
                    WhileLoop EqualTo(GetByte(buf, j), 32) {
                        j = Add(j, 1)
                    }
                    IfCondition NotEqual(GetByte(buf, j), 0) ThenBlock: {
                        IfCondition NotEqual(GetByte(buf, j), 10) ThenBlock: {
                            k = CA_ParseSigned(buf, j, out)
                            IfCondition GreaterThan(k, 0) ThenBlock: {
                                dmm = ArrayGet(out, 0)
                            }
                        }
                    }
                    // parse buf is pinned (CadAppIpc.parse)
                    CA_ChamferSolid(dmm)
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        IfCondition EqualTo(c0, 99) ThenBlock: {
            // cancel (ca...) vs close (cl...)
            IfCondition EqualTo(GetByte(buf, 1), 97) ThenBlock: {
                // Cancel USE only (keep tool). Light path — no full PublishFrame
                // (was locking when many arcs/circles forced a heavy redraw mid-gesture).
                CA_CancelTool()
                CA_WriteToolFile()
                CA_WriteStatus()
                // cmd buf pinned
                ReturnValue(2)
            }
            IfCondition EqualTo(GetByte(buf, 1), 108) ThenBlock: {
                CA_DocClose()
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        ReturnValue(0)
    }
}

