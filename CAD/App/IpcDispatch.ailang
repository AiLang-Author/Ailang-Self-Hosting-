// CAD/App/IpcDispatch — CA_PollCmd. Branch on first byte → CA_Ipc* helpers.
// Loaded last from Ipc.ailang so the helpers already exist.

LibraryImport.Arena
LibraryImport.UtilArgs
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_View
LibraryImport.Cad.CAD_Repo
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_UI
LibraryImport.Display.Render.Framebuffer
LibraryImport.StringUtils

Function.CA_PollCmd {
    Output: Integer
    Body: {
        fd = SystemCall(2, "/tmp/cad_app/cmd.txt", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadAppIpc.cmd, 0) ThenBlock: { CadAppIpc.cmd = Allocate(80) }
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            ReturnValue(0)
        }
        n = SystemCall(0, fd, buf, 79)
        SystemCall(3, fd, 0, 0)
        fd2 = SystemCall(2, "/tmp/cad_app/cmd.txt", 577, 420)
        IfCondition GreaterEqual(fd2, 0) ThenBlock: { SystemCall(3, fd2, 0, 0) }
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(0) }
        SetByte(buf, n, 0)
        c00 = GetByte(buf, 0)
        skip_log = 0
        Fork EqualTo(c00, 111) TrueBlock: {
            skip_log = 1
        } FalseBlock: {
            Fork EqualTo(c00, 104) TrueBlock: {
                skip_log = 1
            } FalseBlock: {
                skip_log = 0
            }
        }
        IfCondition EqualTo(skip_log, 0) ThenBlock: {
            CA_Log("cad_app: ipc ", 13)
            nn = n
            IfCondition GreaterThan(nn, 48) ThenBlock: { nn = 48 }
            CA_Log(buf, nn)
            IfCondition NotEqual(GetByte(buf, Subtract(n, 1)), 10) ThenBlock: {
                CA_Log("\n", 1)
            }
        }
        // click before Branch — "click" is c… and would collide with cstr/clear.
        IfCondition EqualTo(CA_ParseClick(buf), 1) ThenBlock: { ReturnValue(2) }
        c0 = GetByte(buf, 0)
        Branch c0 {
            Case 98: { ReturnValue(CA_IpcCmdB()) }
            Case 99: { ReturnValue(CA_IpcCmdC()) }
            Case 100: { ReturnValue(CA_IpcCmdD()) }
            Case 102: { ReturnValue(CA_IpcCmdF()) }
            Case 103: { ReturnValue(CA_IpcCmdG()) }
            Case 104: { ReturnValue(CA_IpcCmdH()) }
            Case 105: { ReturnValue(CA_IpcCmdI()) }
            Case 106: { ReturnValue(CA_IpcCmdJ()) }
            Case 107: { ReturnValue(CA_IpcCmdK()) }
            Case 108: { ReturnValue(CA_IpcCmdL()) }
            Case 109: { ReturnValue(CA_IpcCmdM()) }
            Case 110: { ReturnValue(CA_IpcCmdN()) }
            Case 111: { ReturnValue(CA_IpcCmdO()) }
            Case 112: { ReturnValue(CA_IpcCmdP()) }
            Case 113: { ReturnValue(CA_IpcCmdQ()) }
            Case 114: { ReturnValue(CA_IpcCmdR()) }
            Case 115: { ReturnValue(CA_IpcCmdS()) }
            Case 116: { ReturnValue(CA_IpcCmdT()) }
            Case 117: { ReturnValue(CA_IpcCmdU()) }
            Case 118: { ReturnValue(CA_IpcCmdV()) }
            Case 119: { ReturnValue(CA_IpcCmdW()) }
            Case 121: { ReturnValue(CA_IpcCmdY()) }
            Case 122: { ReturnValue(CA_IpcCmdZ()) }
            Default: { ReturnValue(0) }
        }
        ReturnValue(0)
    }
}
