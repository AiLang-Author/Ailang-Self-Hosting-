// CAD/App/IpcF — CA_PollCmd helpers (Branch first-byte).
// API: Function.CA_Ipc*  loaded via Import.CAD.App.Ipc

LibraryImport.Arena
LibraryImport.UtilArgs
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_View
LibraryImport.Cad.CAD_Repo
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_UI
LibraryImport.Display.Render.Framebuffer
LibraryImport.StringUtils

// CA_PollCmd first-byte 'f' (102).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdF {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        IfCondition EqualTo(c0, 102) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 110) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 97) ThenBlock: {
                    out = CA_IpcOut()
                    i = 5
                    WhileLoop EqualTo(GetByte(buf, i), 32) {
                        i = Add(i, 1)
                        IfCondition GreaterThan(i, 70) ThenBlock: { i = 71 }
                    }
                    fid = 0
                    j = CA_ParseSigned(buf, i, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        fid = ArrayGet(out, 0)
                        i = j
                        WhileLoop EqualTo(GetByte(buf, i), 32) {
                            i = Add(i, 1)
                            IfCondition GreaterThan(i, 70) ThenBlock: { i = 71 }
                        }
                    }
                    nm = Allocate(64)
                    k = 0
                    WhileLoop LessThan(k, 31) {
                        c = GetByte(buf, Add(i, k))
                        stop = 0
                        IfCondition EqualTo(c, 0) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(c, 10) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(c, 13) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(stop, 1) ThenBlock: { k = 31 }
                        IfCondition EqualTo(stop, 0) ThenBlock: {
                            SetByte(nm, k, c)
                            k = Add(k, 1)
                        }
                    }
                    SetByte(nm, 31, 0)
                    IfCondition LessThan(k, 31) ThenBlock: { SetByte(nm, k, 0) }
                    CA_SetFeatAlias(fid, nm)
                    Deallocate(nm, 64)
                    CA_LogInt("cad_app: feature alias ", 23, fid)
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
        }
        // forget [NAME] — File → Delete (Postgres document)
        IfCondition EqualTo(c0, 102) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 114) ThenBlock: {
                    i = 6
                    WhileLoop EqualTo(GetByte(buf, i), 32) {
                        i = Add(i, 1)
                        IfCondition GreaterThan(i, 70) ThenBlock: { i = 71 }
                    }
                    c = GetByte(buf, i)
                    has = 1
                    IfCondition EqualTo(c, 0) ThenBlock: { has = 0 }
                    IfCondition EqualTo(c, 10) ThenBlock: { has = 0 }
                    IfCondition EqualTo(c, 13) ThenBlock: { has = 0 }
                    IfCondition EqualTo(has, 1) ThenBlock: {
                        nm = Allocate(64)
                        k = 0
                        WhileLoop LessThan(k, 63) {
                            c = GetByte(buf, Add(i, k))
                            stop = 0
                            IfCondition EqualTo(c, 0) ThenBlock: { stop = 1 }
                            IfCondition EqualTo(c, 10) ThenBlock: { stop = 1 }
                            IfCondition EqualTo(c, 13) ThenBlock: { stop = 1 }
                            IfCondition EqualTo(c, 32) ThenBlock: { stop = 1 }
                            IfCondition EqualTo(stop, 1) ThenBlock: { k = 63 }
                            IfCondition EqualTo(stop, 0) ThenBlock: {
                                SetByte(nm, k, c)
                                k = Add(k, 1)
                            }
                        }
                        SetByte(nm, 63, 0)
                        IfCondition LessThan(k, 63) ThenBlock: { SetByte(nm, k, 0) }
                        CA_SetPartName(nm)
                        Deallocate(nm, 64)
                    }
                    CA_RepoForget()
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
        }
        IfCondition EqualTo(c0, 102) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 105) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 108) ThenBlock: {
                    // "fillet" (f-i-l-l) — not "files" (f-i-l-e)
                    IfCondition EqualTo(GetByte(buf, 3), 108) ThenBlock: {
                    rmm = 2
                    out = CA_IpcOut()
                    // skip "fillet" then optional space+number
                    j = 6
                    WhileLoop EqualTo(GetByte(buf, j), 32) {
                        j = Add(j, 1)
                    }
                    // fillet3d → still default R
                    IfCondition NotEqual(GetByte(buf, j), 0) ThenBlock: {
                        IfCondition NotEqual(GetByte(buf, j), 10) ThenBlock: {
                            k = CA_ParseSigned(buf, j, out)
                            IfCondition GreaterThan(k, 0) ThenBlock: {
                                rmm = ArrayGet(out, 0)
                            }
                        }
                    }
                    // parse buf is pinned (CadAppIpc.parse)
                    CA_FilletSolid(rmm)
                    CadApp.mode = 0
                    CadApp.tool = 8
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                    }
                }
            }
        }
        // --- document browser ---
        // "files" / "file" only — bare "f" used to be ISO cube and ran DocList+remesh (crash)
        IfCondition EqualTo(c0, 102) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 105) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 108) ThenBlock: {
                    CA_Log("cad_app: ipc files\n", 19)
                    CA_DocList()
                    CA_Log("cad_app: ipc files done\n", 24)
                    // parts.txt only — do not remesh / do not leave list_open
                    ReturnValue(2)
                }
            }
        }
        ReturnValue(0)
    }
}

