// CA_PollCmd first-byte 'n' (110).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdN {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        // ninc / ndec — polygon side count (any N, 2=slot, 3..64)
        IfCondition EqualTo(c0, 110) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 105) ThenBlock: {
                CadApp.poly_n = Add(CadApp.poly_n, 1)
                IfCondition GreaterThan(CadApp.poly_n, 64) ThenBlock: { CadApp.poly_n = 64 }
                CadApp.tool = 17
                CA_PublishFrame()
                ReturnValue(2)
            }
            IfCondition EqualTo(GetByte(buf, 1), 100) ThenBlock: {
                IfCondition GreaterThan(CadApp.poly_n, 2) ThenBlock: {
                    CadApp.poly_n = Subtract(CadApp.poly_n, 1)
                }
                CadApp.tool = 17
                CA_PublishFrame()
                ReturnValue(2)
            }
            // nsides N
            IfCondition EqualTo(GetByte(buf, 1), 115) ThenBlock: {
                out = CA_IpcOut()
                j = CA_ParseSigned(buf, 6, out)
                IfCondition GreaterThan(j, 0) ThenBlock: {
                    nn = ArrayGet(out, 0)
                    IfCondition LessThan(nn, 2) ThenBlock: { nn = 2 }
                    IfCondition GreaterThan(nn, 64) ThenBlock: { nn = 64 }
                    CadApp.poly_n = nn
                    CadApp.tool = 17
                    CA_PublishFrame()
                }
                ReturnValue(2)
            }
        }
        // name PART  (must beat newdoc — both start with n)
        IfCondition EqualTo(c0, 110) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 97) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 109) ThenBlock: {
                    nm = Allocate(64)
                    i = 4
                    WhileLoop EqualTo(GetByte(buf, i), 32) {
                        i = Add(i, 1)
                        IfCondition GreaterThan(i, 70) ThenBlock: { i = 71 }
                    }
                    j = 0
                    WhileLoop LessThan(j, 63) {
                        c = GetByte(buf, Add(i, j))
                        stop = 0
                        IfCondition EqualTo(c, 0) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(c, 10) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(c, 13) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(stop, 1) ThenBlock: { j = 63 }
                        IfCondition EqualTo(stop, 0) ThenBlock: {
                            SetByte(nm, j, c)
                            j = Add(j, 1)
                        }
                    }
                    SetByte(nm, 63, 0)
                    IfCondition LessThan(j, 63) ThenBlock: { SetByte(nm, j, 0) }
                    CA_SetPartName(nm)
                    Deallocate(nm, 64)
                    CA_Log("cad_app: part name set\n", 23)
                    CA_WriteStatus()
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        // new document
        IfCondition EqualTo(c0, 110) ThenBlock: {
            // newdoc vs new sketch: "newdoc" or plain n
            IfCondition EqualTo(GetByte(buf, 1), 101) ThenBlock: {
                // "new..." -> DocNew if newdoc, else NewSketch
                IfCondition EqualTo(GetByte(buf, 3), 100) ThenBlock: {
                    CA_DocNew()
                }
                IfCondition NotEqual(GetByte(buf, 3), 100) ThenBlock: {
                    CA_DocNew()
                }
            }
            IfCondition NotEqual(GetByte(buf, 1), 101) ThenBlock: {
                CA_DocNew()
            }
            CA_PublishFrame()
            // cmd buf pinned
            ReturnValue(2)
        }
        ReturnValue(0)
    }
}

// CA_PollCmd first-byte 'r' (114).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdR {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        IfCondition EqualTo(c0, 114) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 101) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 100) ThenBlock: {
                    CA_HistFwd()
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
        }
        // repad / reload / revolve  (all start with 'r')
        IfCondition EqualTo(c0, 114) ThenBlock: {
            // "reload" if third char is 'l'
            IfCondition EqualTo(GetByte(buf, 2), 108) ThenBlock: {
                CA_ReloadDxf()
                CadApp.mode = 0
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            // "revolve" if second char is 'e' and third is 'v'
            IfCondition EqualTo(GetByte(buf, 1), 101) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 118) ThenBlock: {
                    rrc = CA_RevolveFromSketch()
                    // -4 = waiting for axis click; stay on revaxis tool
                    IfCondition NotEqual(rrc, -4) ThenBlock: {
                        CadApp.mode = 0
                    }
                    IfCondition EqualTo(rrc, -4) ThenBlock: {
                        CadApp.tool = 11
                        CadApp.mode = 0
                    }
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
            // default: repad
            CA_PadFromSketch()
            // JOIN pad waits in the extrude HUD — stay in sketch so the
            // bright-red fill stays visible (3D occlude would hide it and
            // the next click then toggled the profile off).
            IfCondition EqualTo(CadApp.hud_kind, 7) ThenBlock: {
                CadApp.mode = 1
            }
            IfCondition NotEqual(CadApp.hud_kind, 7) ThenBlock: {
                CadApp.mode = 0
            }
            CA_PublishFrame()
            // cmd buf pinned
            ReturnValue(2)
        }
        ReturnValue(0)
    }
}

// CA_PollCmd first-byte 'u' (117).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdU {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        IfCondition EqualTo(c0, 117) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 110) ThenBlock: {
                CA_HistBack()
                CA_PublishFrame()
                ReturnValue(2)
            }
            CA_CutFromSketch()
            CadApp.mode = 0
            CA_PublishFrame()
            // cmd buf pinned
            ReturnValue(2)
        }
        ReturnValue(0)
    }
}

// CA_PollCmd first-byte 'y' (121).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdY {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        IfCondition EqualTo(c0, 121) ThenBlock: {
            CadApp.mode = 1
            CadApp.solid = 0
            skn = 0
            IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                skn = CAD_Store.Read(CadApp.sketch, 12)
            }
            IfCondition EqualTo(skn, 0) ThenBlock: {
                CA_RebuildProfiles()
                skn = CadApp.nprof
            }
            IfCondition EqualTo(skn, 0) ThenBlock: {
                IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                    skn = CAD_Store.Read(CadApp.sketch, 12)
                }
            }
            IfCondition EqualTo(skn, 0) ThenBlock: {
                CA_Log("cad_app: no profiles to select\n", 31)
            }
            IfCondition GreaterThan(skn, 0) ThenBlock: {
                CadApp.nprof = skn
                IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
                    CA_Log("cad_app: Next - click a light-red face first (no auto-select)\n", 63)
                }
                IfCondition EqualTo(CadApp.prof_user, 1) ThenBlock: {
                    CadApp.prof_sel = Add(CadApp.prof_sel, 1)
                    IfCondition GreaterEqual(CadApp.prof_sel, skn) ThenBlock: {
                        CadApp.prof_sel = 0
                    }
                    ok = CA_ApplyProfileSel(CadApp.prof_sel, skn, 0)
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        CA_Log("cad_app: Next - profile selected (red)\n", 39)
                    }
                }
            }
            CA_PublishFrame()
            // cmd buf pinned
            ReturnValue(2)
        }
        ReturnValue(0)
    }
}

// CA_PollCmd first-byte 'i' (105).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdI {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        // iso — viewcube ISO (was wrongly sent as "f")
        IfCondition EqualTo(c0, 105) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 115) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 111) ThenBlock: {
                    CadApp.view = 0
                    CAD_View.SetViewMode(0)
                    CA_Log("cad_app: view ISO\n", 18)
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        // i = sel prev (single key only — not "import")
        IfCondition EqualTo(c0, 105) ThenBlock: {
            b1 = GetByte(buf, 1)
            IfCondition EqualTo(b1, 0) ThenBlock: {
                CA_DocSelPrev()
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            IfCondition EqualTo(b1, 10) ThenBlock: {
                CA_DocSelPrev()
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            IfCondition EqualTo(b1, 13) ThenBlock: {
                CA_DocSelPrev()
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            IfCondition EqualTo(b1, 32) ThenBlock: {
                CA_DocSelPrev()
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            // import — DXF from path.txt (Gtk file dialog / agent)
            IfCondition EqualTo(b1, 109) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 112) ThenBlock: {
                    rc = CA_ImportFromPathFile()
                    CadApp.mode = 0
                    IfCondition NotEqual(rc, 0) ThenBlock: {
                        CA_Log("cad_app: import FAIL\n", 21)
                    }
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        ReturnValue(0)
    }
}

// CA_PollCmd first-byte 'j' (106).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdJ {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        // j = sel next
        IfCondition EqualTo(c0, 106) ThenBlock: {
            CA_DocSelNext()
            CA_PublishFrame()
            // cmd buf pinned
            ReturnValue(2)
        }
        ReturnValue(0)
    }
}

// CA_PollCmd first-byte 'g' (103).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdG {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        // grid / grid 0 / grid 1 — before bare "g" (must not steal "grid")
        IfCondition EqualTo(c0, 103) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 114) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 105) ThenBlock: {
                    setg = 0
                    IfCondition EqualTo(GetByte(buf, 4), 32) ThenBlock: {
                        IfCondition EqualTo(GetByte(buf, 5), 48) ThenBlock: {
                            CadApp.show_grid = 0
                            setg = 1
                        }
                        IfCondition EqualTo(GetByte(buf, 5), 49) ThenBlock: {
                            CadApp.show_grid = 1
                            setg = 1
                        }
                    }
                    IfCondition EqualTo(setg, 0) ThenBlock: {
                        CadApp.show_grid = Subtract(1, CadApp.show_grid)
                    }
                    CA_Log("cad_app: grid\n", 14)
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        // get/load from Postgres (bare "g" only — not "grid")
        IfCondition EqualTo(c0, 103) ThenBlock: {
            b1 = GetByte(buf, 1)
            bare = 0
            IfCondition EqualTo(b1, 0) ThenBlock: { bare = 1 }
            IfCondition EqualTo(b1, 10) ThenBlock: { bare = 1 }
            IfCondition EqualTo(b1, 13) ThenBlock: { bare = 1 }
            IfCondition EqualTo(b1, 32) ThenBlock: { bare = 1 }
            IfCondition EqualTo(bare, 1) ThenBlock: {
                IfCondition EqualTo(CadApp.list_open, 1) ThenBlock: {
                    CA_DocOpen()
                }
                IfCondition EqualTo(CadApp.list_open, 0) ThenBlock: {
                    CA_RepoLoad()
                }
                CadApp.mode = 0
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        ReturnValue(0)
    }
}

// CA_PollCmd first-byte 'k' (107).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdK {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        // close
        IfCondition EqualTo(c0, 107) ThenBlock: {
            // k = close document
            CA_DocClose()
            CA_PublishFrame()
            // cmd buf pinned
            ReturnValue(2)
        }
        ReturnValue(0)
    }
}

// CA_PollCmd first-byte 'l' (108).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdL {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        IfCondition EqualTo(c0, 108) ThenBlock: {
            // load (not tool_line which starts with t)
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                CA_RepoLoad()
                CadApp.mode = 0
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        ReturnValue(0)
    }
}

// CA_PollCmd first-byte 'b' (98).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdB {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        // bmp
        IfCondition EqualTo(c0, 98) ThenBlock: {
            CA_PublishFrame()
            CAD_View.SaveFBToBMP("test-stl/cad_app_live.bmp")
            CA_Log("cad_app: BMP ok\n", 16)
            // cmd buf pinned
            ReturnValue(2)
        }
        ReturnValue(0)
    }
}

// CA_PollCmd first-byte 'd' (100).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdD {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        // dim N — type-in length / radius / poly side / HUD field (hundredths)
        IfCondition EqualTo(c0, 100) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 105) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 109) ThenBlock: {
                    out = CA_IpcOut()
                    j = CA_ParseFixed100(buf, 3, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        used = 0
                        IfCondition NotEqual(CadApp.hud_kind, 0) ThenBlock: {
                            CA_HudEnter(ArrayGet(out, 0))
                            used = 1
                        }
                        IfCondition EqualTo(used, 0) ThenBlock: {
                            CA_CommitDim(Divide(ArrayGet(out, 0), 100))
                        }
                    }
                    ReturnValue(2)
                }
            }
        }
        // done = finish spline; else dxf export
        IfCondition EqualTo(c0, 100) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                CA_FinishSpline()
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                CAD_DXF.ExportSketch(CadApp.sketch, "test-stl/cad_app_sketch.dxf")
                CA_Log("cad_app: DXF ok\n", 16)
            }
            // cmd buf pinned
            ReturnValue(2)
        }
        ReturnValue(0)
    }
}

