LibraryImport.StringUtils

// CA_PollCmd first-byte 'o' (111).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdO {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        // orbit dx dy
        IfCondition EqualTo(GetByte(buf, 0), 111) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 114) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 98) ThenBlock: {
                    out = CA_IpcOut()
                    i = CA_ParseSigned(buf, 5, out)
                    ok = 0
                    dx = 0
                    dy = 0
                    IfCondition GreaterThan(i, 0) ThenBlock: {
                        dx = ArrayGet(out, 0)
                        j = CA_ParseSigned(buf, i, out)
                        IfCondition GreaterThan(j, 0) ThenBlock: {
                            dy = ArrayGet(out, 0)
                            ok = 1
                        }
                    }
                    // parse buf is pinned (CadAppIpc.parse)
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        CA_ViewOrbit(dx, dy)
                        CA_PublishFrame()
                    }
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        // ontop — 3D pie / Solid "On Face" (must beat "open")
        IfCondition EqualTo(GetByte(buf, 0), 111) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 110) ThenBlock: {
                CA_PlaneOnTop()
                CA_PublishFrame()
                ReturnValue(2)
            }
        }
        // opac N — solid fill % (must beat "open")
        IfCondition EqualTo(GetByte(buf, 0), 111) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 112) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 97) ThenBlock: {
                    out = CA_IpcOut()
                    j = CA_ParseSigned(buf, 4, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        CadApp.opac = CAD_View.SetOpacity(ArrayGet(out, 0))
                    }
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
        }
        // open (selected)
        IfCondition EqualTo(GetByte(buf, 0), 111) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 112) ThenBlock: {
                CA_DocOpen()
                CadApp.mode = 0
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        ReturnValue(0)
    }
}

// CA_PollCmd first-byte 'z' (122).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdZ {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        // zoom N — sketch: sk_zoom; 3D: view zoom
        IfCondition EqualTo(GetByte(buf, 0), 122) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                out = CA_IpcOut()
                i = CA_ParseSigned(buf, 4, out)
                zs = 0
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    zs = ArrayGet(out, 0)
                    CA_ViewZoom(zs)
                    CA_PublishFrame()
                }
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        ReturnValue(0)
    }
}

// CA_PollCmd first-byte 'h' (104).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdH {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        IfCondition EqualTo(GetByte(buf, 0), 104) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                out = CA_IpcOut()
                i = CA_ParseSigned(buf, 5, out)
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    hx = ArrayGet(out, 0)
                    j = CA_ParseSigned(buf, i, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        hy = ArrayGet(out, 0)
                        CA_OnHover(hx, hy)
                    }
                }
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        // height N / pad_h N — set pad/extrude thickness (mm) without requiring rebuild
        // hinc / hdec — nudge ±1 mm; rebuild solid only if sketch/solid present
        IfCondition EqualTo(c0, 104) ThenBlock: {
            c1 = GetByte(buf, 1)
            // htab — next kernel HUD field
            IfCondition EqualTo(c1, 116) ThenBlock: {
                CA_HudTab()
                CA_PublishFrame()
                ReturnValue(2)
            }
            // hstab — previous HUD field (Shift-Tab / Up)
            IfCondition EqualTo(c1, 115) ThenBlock: {
                CA_HudTabBack()
                CA_PublishFrame()
                ReturnValue(2)
            }
            // hleft — toggle Pick / OP or nudge the active number down
            IfCondition EqualTo(c1, 108) ThenBlock: {
                CA_HudLeft()
                CA_PublishFrame()
                ReturnValue(2)
            }
            // hright — toggle Pick / OP or nudge the active number up
            IfCondition EqualTo(c1, 114) ThenBlock: {
                CA_HudRight()
                CA_PublishFrame()
                ReturnValue(2)
            }
            // hudok = Enter with no digits (accept + close)
            // hudoff = idle dismiss (no apply)
            IfCondition EqualTo(c1, 117) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 4), 107) ThenBlock: {
                    CA_HudOk()
                }
                IfCondition NotEqual(GetByte(buf, 4), 107) ThenBlock: {
                    CA_HudClose()
                }
                CA_PublishFrame()
                ReturnValue(2)
            }
            // hist N — slider / timeline
            IfCondition EqualTo(c1, 105) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 115) ThenBlock: {
                    out = CA_IpcOut()
                    j = CA_ParseSigned(buf, 5, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        CA_HistGo(ArrayGet(out, 0))
                    }
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
            // "height N" (he...) or "h 12" bare short form after "h "
            IfCondition EqualTo(c1, 101) ThenBlock: {
                // height N — number after "height "
                out = CA_IpcOut()
                j = CA_ParseSigned(buf, 7, out)
                IfCondition GreaterThan(j, 0) ThenBlock: {
                    nh = ArrayGet(out, 0)
                    IfCondition LessThan(nh, 1) ThenBlock: { nh = 1 }
                    IfCondition GreaterThan(nh, 10000) ThenBlock: { nh = 10000 }
                    CadApp.height = nh
                    CA_Log("cad_app: pad height set\n", 24)
                    IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                        CA_PadApplyHeight()
                    }
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
            // "h 12" short form (space then digits) — not hover/hinc/hdec
            IfCondition EqualTo(c1, 32) ThenBlock: {
                out = CA_IpcOut()
                j = CA_ParseSigned(buf, 2, out)
                IfCondition GreaterThan(j, 0) ThenBlock: {
                    nh = ArrayGet(out, 0)
                    IfCondition LessThan(nh, 1) ThenBlock: { nh = 1 }
                    IfCondition GreaterThan(nh, 10000) ThenBlock: { nh = 10000 }
                    CadApp.height = nh
                    CA_Log("cad_app: pad height set\n", 24)
                    IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                        CA_PadApplyHeight()
                    }
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
            // hinc
            IfCondition EqualTo(c1, 105) ThenBlock: {
                CadApp.height = Add(CadApp.height, 1)
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                    CA_PadApplyHeight()
                }
                CA_PublishFrame()
                ReturnValue(2)
            }
            // hdec
            IfCondition EqualTo(c1, 100) ThenBlock: {
                IfCondition GreaterThan(CadApp.height, 1) ThenBlock: {
                    CadApp.height = Subtract(CadApp.height, 1)
                }
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                    CA_PadApplyHeight()
                }
                CA_PublishFrame()
                ReturnValue(2)
            }
        }
        ReturnValue(0)
    }
}

// CA_PollCmd first-byte 'w' (119).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdW {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        // wire
        IfCondition EqualTo(c0, 119) ThenBlock: {
            CadApp.wire = Subtract(1, CadApp.wire)
            CA_PublishFrame()
            // cmd buf pinned
            ReturnValue(2)
        }
        ReturnValue(0)
    }
}

// CA_PollCmd first-byte 'v' (118).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdV {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        // view0..view7 — ISO / top / front / (3=free) / right / left / back / bottom
        IfCondition EqualTo(c0, 118) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 105) ThenBlock: {
                c4 = GetByte(buf, 4)
                vm = -1
                IfCondition EqualTo(c4, 48) ThenBlock: { vm = 0 }
                IfCondition EqualTo(c4, 49) ThenBlock: { vm = 1 }
                IfCondition EqualTo(c4, 50) ThenBlock: { vm = 2 }
                IfCondition EqualTo(c4, 52) ThenBlock: { vm = 4 }
                IfCondition EqualTo(c4, 53) ThenBlock: { vm = 5 }
                IfCondition EqualTo(c4, 54) ThenBlock: { vm = 6 }
                IfCondition EqualTo(c4, 55) ThenBlock: { vm = 7 }
                IfCondition GreaterEqual(vm, 0) ThenBlock: {
                    CadApp.view = vm
                    CAD_View.SetViewMode(vm)
                    CA_PublishFrame()
                }
                ReturnValue(2)
            }
        }
        ReturnValue(0)
    }
}

// CA_PollCmd first-byte 'q' (113).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdQ {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        IfCondition EqualTo(c0, 113) ThenBlock: {
            // cmd buf pinned
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// CA_PollCmd first-byte 'm' (109).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdM {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        IfCondition EqualTo(c0, 109) ThenBlock: {
            b1 = GetByte(buf, 1)
            // mirror… (mi…)
            IfCondition EqualTo(b1, 105) ThenBlock: {
                // mirror_x / mirror x / mirx → axis 0 (y→-y)
                // mirror_y / mirror y / miry → axis 1 (x→-x)
                axm = 1
                // scan for 'x' or 'y' in cmd
                si = 0
                WhileLoop LessThan(si, 16) {
                    ch = GetByte(buf, si)
                    IfCondition EqualTo(ch, 0) ThenBlock: { si = 16 }
                    IfCondition EqualTo(ch, 10) ThenBlock: { si = 16 }
                    IfCondition EqualTo(ch, 120) ThenBlock: { axm = 0 }
                    IfCondition EqualTo(ch, 121) ThenBlock: { axm = 1 }
                    si = Add(si, 1)
                }
                CA_MirrorSketch(axm)
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            // mode / bare m
            do_mode = 0
            IfCondition EqualTo(b1, 0) ThenBlock: { do_mode = 1 }
            IfCondition EqualTo(b1, 10) ThenBlock: { do_mode = 1 }
            IfCondition EqualTo(b1, 13) ThenBlock: { do_mode = 1 }
            IfCondition EqualTo(b1, 32) ThenBlock: { do_mode = 1 }
            IfCondition EqualTo(b1, 111) ThenBlock: { do_mode = 1 }
            IfCondition EqualTo(do_mode, 1) ThenBlock: {
                CadApp.mode = Subtract(1, CadApp.mode)
                CadApp.nclick = 0
                CadApp.hover_ok = 0
                CadApp.live_ang = -1
                IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
                    IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                        CadApp.sketch = CAD_Sketch.CreateSketch(1)
                    }
                    CadApp.show_sketch = 1
                    CA_HoldSolidTess()
                    CA_Log("cad_app: sketch mode\n", 21)
                }
                IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
                    CadApp.tool = 4
                    CA_Log("cad_app: 3D mode (pick)\n", 24)
                }
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        ReturnValue(0)
    }
}

