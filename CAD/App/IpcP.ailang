// CAD/App/IpcP — CA_PollCmd helpers (Branch first-byte).
// API: Function.CA_Ipc*  loaded via Import.CAD.App.Ipc

LibraryImport.Arena
LibraryImport.UtilArgs
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_View
LibraryImport.Cad.CAD_Repo
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_UI
LibraryImport.Display.Render.Framebuffer
LibraryImport.StringUtils

// CA_PollCmd first-byte 'p' (112).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdP {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        IfCondition EqualTo(GetByte(buf, 0), 112) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 97) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 110) ThenBlock: {
                    out = CA_IpcOut()
                    i = CA_ParseSigned(buf, 3, out)
                    IfCondition GreaterThan(i, 0) ThenBlock: {
                        pdx = ArrayGet(out, 0)
                        j = CA_ParseSigned(buf, i, out)
                        IfCondition GreaterThan(j, 0) ThenBlock: {
                            pdy = ArrayGet(out, 0)
                            CA_ViewPan(pdx, pdy)
                            CA_PublishFrame()
                        }
                    }
                    // parse buf is pinned (CadAppIpc.parse)
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        // plane_* / profiles / pt — all start with 'p'
        IfCondition EqualTo(c0, 112) ThenBlock: {
            // prune — drop hist scrapbook (keep current)
            IfCondition EqualTo(GetByte(buf, 1), 114) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 117) ThenBlock: {
                    CA_HistPrune()
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
            // plane_* commands: plane_top plane_off plane_org plane_flip
            // plane_from plane_pick plane_3pt plane_ang plane_xy|xz|yz
            IfCondition EqualTo(GetByte(buf, 1), 108) ThenBlock: {
                // "plane..."
                // plane_top
                IfCondition EqualTo(GetByte(buf, 6), 116) ThenBlock: {
                    CA_PlaneOnTop()
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
                // plane_pick — activate an existing construction plane
                IfCondition EqualTo(GetByte(buf, 6), 112) ThenBlock: {
                    CA_PlaneBeginPick()
                    CA_PublishFrame()
                    ReturnValue(2)
                }
                // plane_3pt — through three points
                IfCondition EqualTo(GetByte(buf, 6), 51) ThenBlock: {
                    CA_PlaneBegin3Pt()
                    CA_PublishFrame()
                    ReturnValue(2)
                }
                // plane_off [N]  vs plane_org (set origin)
                IfCondition EqualTo(GetByte(buf, 6), 111) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, 7), 114) ThenBlock: {
                        CA_PlaneBeginOrigin()
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    out = CA_IpcOut()
                    j = CA_ParseFixed100(buf, 10, out)
                    IfCondition LessThan(j, 0) ThenBlock: {
                        CadApp.plane_kind = 1
                        CA_Log("cad_app: Offset — type mm in HUD, Enter\n", 40)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    CadApp.plane_kind = 0
                    CA_PlaneOffsetCenti(ArrayGet(out, 0))
                    CA_PublishFrame()
                    ReturnValue(2)
                }
                // plane_flip vs plane_from
                IfCondition EqualTo(GetByte(buf, 6), 102) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, 7), 114) ThenBlock: {
                        CA_PlaneBeginFromFace()
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    CA_PlaneFlip()
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
                // plane_ang [N] — no number arms HUD (type deg)
                IfCondition EqualTo(GetByte(buf, 6), 97) ThenBlock: {
                    out = CA_IpcOut()
                    j = CA_ParseFixed100(buf, 10, out)
                    IfCondition LessThan(j, 0) ThenBlock: {
                        CadApp.plane_kind = 2
                        CA_Log("cad_app: Angle — type deg in HUD, Enter\n", 40)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    CadApp.plane_kind = 0
                    CA_PlaneAngleXCenti(ArrayGet(out, 0))
                    CA_PublishFrame()
                    ReturnValue(2)
                }
                // plane_xy / plane_xz / plane_yz
                IfCondition EqualTo(GetByte(buf, 6), 120) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, 7), 121) ThenBlock: {
                        CA_PlaneDatumXY()
                    }
                    IfCondition EqualTo(GetByte(buf, 7), 122) ThenBlock: {
                        CA_PlaneDatumXZ()
                    }
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
                IfCondition EqualTo(GetByte(buf, 6), 121) ThenBlock: {
                    CA_PlaneDatumYZ()
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
                // bare "plane" → OnTop if solid else new XY
                IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
                    CA_PlaneDatumXY()
                }
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                    CA_PlaneOnTop()
                }
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            // "proj" — show/hide face projections in the sketch
            IfCondition EqualTo(GetByte(buf, 1), 114) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 111) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, 3), 106) ThenBlock: {
                        CadApp.show_proj = Subtract(1, CadApp.show_proj)
                        CA_LogInt("cad_app: projections=", 21, CadApp.show_proj)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                }
            }
            // "profiles" or "prof" — Solid tab / Pick. No body → keep sketch visible.
            IfCondition EqualTo(GetByte(buf, 1), 114) ThenBlock: {
                IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
                    CadApp.mode = 1
                }
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                    CadApp.mode = 0
                }
                CadApp.tool = 4
                CadApp.nclick = 0
                CA_RebuildProfiles()
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            // pmode N — 0 center  1 edge  2 center-3pt
            IfCondition EqualTo(GetByte(buf, 1), 109) ThenBlock: {
                out = CA_IpcOut()
                j = CA_ParseSigned(buf, 5, out)
                IfCondition GreaterThan(j, 0) ThenBlock: {
                    CadApp.poly_mode = ArrayGet(out, 0)
                    IfCondition LessThan(CadApp.poly_mode, 0) ThenBlock: { CadApp.poly_mode = 0 }
                    IfCondition GreaterThan(CadApp.poly_mode, 2) ThenBlock: { CadApp.poly_mode = 2 }
                    CadApp.tool = 17
                    CadApp.nclick = 0
                    CadApp.hud_kind = 0
                    CadApp.hud_field = 0
                    CA_PublishFrame()
                }
                ReturnValue(2)
            }
            // pt X Y — place user Point at integer mm UV (HUD-style numeric entry)
            IfCondition EqualTo(GetByte(buf, 1), 116) ThenBlock: {
                IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                    CadApp.sketch = CAD_Sketch.CreateSketch(1)
                }
                out = CA_IpcOut()
                i = CA_ParseSigned(buf, 2, out)
                ok = 0
                pxm = 0
                pym = 0
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    pxm = ArrayGet(out, 0)
                    j = CA_ParseSigned(buf, i, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        pym = ArrayGet(out, 0)
                        ok = 1
                    }
                }
                // parse buf is pinned (CadAppIpc.parse)
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    CadApp.mode = 1
                    pi = CAD_Sketch.AddUserPoint(CadApp.sketch, Float_FromInt(pxm), Float_FromInt(pym), 0)
                    CadApp.last_upt = pi
                    CadApp.dirty = 1
                    CA_Log("cad_app: point at UV (pt X Y)\n", 30)
                    CA_PublishFrame()
                }
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        // put/save to Postgres (p or "save")
        IfCondition EqualTo(c0, 112) ThenBlock: {
            CA_Log("cad_app: ipc put/save\n", 22)
            CA_RepoSave()
            CA_Log("cad_app: ipc save done\n", 23)
            CA_PublishFrame()
            // cmd buf pinned
            ReturnValue(2)
        }
        ReturnValue(0)
    }
}

