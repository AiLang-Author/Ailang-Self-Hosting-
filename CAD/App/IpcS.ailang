// CAD/App/IpcS — CA_PollCmd helpers (Branch first-byte).
// API: Function.CA_Ipc*  loaded via Import.CAD.App.Ipc

LibraryImport.Arena
LibraryImport.UtilArgs
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_View
LibraryImport.Cad.CAD_Repo
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_UI
LibraryImport.Display.Render.Framebuffer
LibraryImport.StringUtils

// CA_PollCmd first-byte 's' (115).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdS {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        // sketch_pln / solve — start with 's'
        IfCondition EqualTo(c0, 115) ThenBlock: {
            // setkind part|assembly|group|machine
            IfCondition EqualTo(GetByte(buf, 1), 101) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 116) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, 3), 107) ThenBlock: {
                        i = 7
                        WhileLoop EqualTo(GetByte(buf, i), 32) {
                            i = Add(i, 1)
                            IfCondition GreaterThan(i, 40) ThenBlock: { i = 41 }
                        }
                        nm = Allocate(32)
                        k = 0
                        WhileLoop LessThan(k, 31) {
                            c = GetByte(buf, Add(i, k))
                            stop = 0
                            IfCondition EqualTo(c, 0) ThenBlock: { stop = 1 }
                            IfCondition EqualTo(c, 10) ThenBlock: { stop = 1 }
                            IfCondition EqualTo(c, 13) ThenBlock: { stop = 1 }
                            IfCondition EqualTo(c, 32) ThenBlock: { stop = 1 }
                            IfCondition EqualTo(stop, 1) ThenBlock: { k = 31 }
                            IfCondition EqualTo(stop, 0) ThenBlock: {
                                SetByte(nm, k, c)
                                k = Add(k, 1)
                            }
                        }
                        SetByte(nm, 31, 0)
                        IfCondition LessThan(k, 31) ThenBlock: { SetByte(nm, k, 0) }
                        CA_SetDocKind(nm)
                        Deallocate(nm, 32)
                        CA_Log("cad_app: doc kind set\n", 22)
                        CA_WriteStatus()
                        ReturnValue(2)
                    }
                }
            }
            // sname [N] ALIAS — keep Sketch_N id, set user name
            IfCondition EqualTo(GetByte(buf, 1), 110) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 97) ThenBlock: {
                    out = CA_IpcOut()
                    i = 5
                    WhileLoop EqualTo(GetByte(buf, i), 32) {
                        i = Add(i, 1)
                        IfCondition GreaterThan(i, 70) ThenBlock: { i = 71 }
                    }
                    sid = CA_CurrentSkIdx()
                    j = CA_ParseSigned(buf, i, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        IfCondition EqualTo(GetByte(buf, j), 32) ThenBlock: {
                            sid = ArrayGet(out, 0)
                            i = j
                            WhileLoop EqualTo(GetByte(buf, i), 32) {
                                i = Add(i, 1)
                                IfCondition GreaterThan(i, 70) ThenBlock: { i = 71 }
                            }
                        }
                    }
                    nm = Allocate(64)
                    k = 0
                    WhileLoop LessThan(k, 31) {
                        c = GetByte(buf, Add(i, k))
                        stop = 0
                        IfCondition EqualTo(c, 0) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(c, 10) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(c, 13) ThenBlock: { stop = 1 }
                        IfCondition EqualTo(stop, 1) ThenBlock: { k = 31 }
                        IfCondition EqualTo(stop, 0) ThenBlock: {
                            SetByte(nm, k, c)
                            k = Add(k, 1)
                        }
                    }
                    SetByte(nm, 31, 0)
                    IfCondition LessThan(k, 31) ThenBlock: { SetByte(nm, k, 0) }
                    CA_SetSketchAlias(sid, nm)
                    Deallocate(nm, 64)
                    CA_LogInt("cad_app: sketch alias ", 22, sid)
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
            // sketch_pln — new sketch on active construction plane
            IfCondition EqualTo(GetByte(buf, 1), 107) ThenBlock: {
                CA_SketchOnActivePlane()
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            // solve — multipass constraint projection
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 108) ThenBlock: {
                    IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                        napp = CAD_Sketch.SolveConstraints(CadApp.sketch)
                        CA_InvalidateProfiles()
                        CadApp.dirty = 1
                        CA_Log("cad_app: SolveConstraints done\n", 31)
                        CA_PublishFrame()
                    }
                    // cmd buf pinned
                    ReturnValue(2)
                }
            }
        }
        IfCondition EqualTo(c0, 115) ThenBlock: {
            // saveover — replace latest rev in place
            IfCondition EqualTo(GetByte(buf, 1), 97) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 4), 111) ThenBlock: {
                    CA_Log("cad_app: ipc saveover\n", 22)
                    CAD_Repo_State.do_overwrite = 1
                    CA_RepoSave()
                    CA_Log("cad_app: ipc saveover done\n", 27)
                    CA_PublishFrame()
                    ReturnValue(2)
                }
                CA_Log("cad_app: ipc save\n", 18)
                CA_RepoSave()
                CA_Log("cad_app: ipc save done\n", 23)
                CA_PublishFrame()
                ReturnValue(2)
            }
        }
        // skvis / skvis 0 / skvis 1 — 3D sketch overlay (View tab Sketch)
        IfCondition EqualTo(c0, 115) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 107) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 118) ThenBlock: {
                    setg = 0
                    IfCondition EqualTo(GetByte(buf, 5), 32) ThenBlock: {
                        IfCondition EqualTo(GetByte(buf, 6), 48) ThenBlock: {
                            CadApp.show_sketch = 0
                            setg = 1
                        }
                        IfCondition EqualTo(GetByte(buf, 6), 49) ThenBlock: {
                            CadApp.show_sketch = 1
                            setg = 1
                        }
                    }
                    IfCondition EqualTo(setg, 0) ThenBlock: {
                        CadApp.show_sketch = Subtract(1, CadApp.show_sketch)
                    }
                    CA_LogInt("cad_app: skvis=", 16, CadApp.show_sketch)
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
        }
        // side N — polygon side length mm (0 = use click)
        IfCondition EqualTo(c0, 115) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 105) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 100) ThenBlock: {
                    out = CA_IpcOut()
                    j = CA_ParseSigned(buf, 4, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        CadApp.poly_side = ArrayGet(out, 0)
                        IfCondition LessThan(CadApp.poly_side, 0) ThenBlock: { CadApp.poly_side = 0 }
                        CadApp.tool = 17
                        CA_PublishFrame()
                    }
                    ReturnValue(2)
                }
            }
        }
        // shot / screenshot — write live BMP under IPC dir + test-stl
        IfCondition EqualTo(c0, 115) ThenBlock: {
            do_shot = 0
            IfCondition EqualTo(GetByte(buf, 1), 104) ThenBlock: { do_shot = 1 }
            IfCondition EqualTo(GetByte(buf, 1), 99) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 114) ThenBlock: { do_shot = 1 }
            }
            IfCondition EqualTo(do_shot, 1) ThenBlock: {
                CA_PublishFrame()
                CAD_View.SaveFBToBMP("/tmp/cad_app/shot.bmp")
                CAD_View.SaveFBToBMP("test-stl/cad_app_live.bmp")
                CA_Log("cad_app: screenshot ok\n", 23)
                // cmd buf pinned
                ReturnValue(2)
            }
        }
        // stash — persist unsaved work as <name>_dirty
        IfCondition EqualTo(c0, 115) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 116) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 97) ThenBlock: {
                    CA_RepoStash()
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
        }
        // step
        IfCondition EqualTo(c0, 115) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                CAD_IO.ExportSTEP(CadApp.solid, "test-stl/cad_app_live.stp")
                CA_Log("cad_app: STEP ok\n", 17)
            }
            // cmd buf pinned
            ReturnValue(2)
        }
        ReturnValue(0)
    }
}

