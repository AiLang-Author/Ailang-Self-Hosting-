// CAD/App/IpcT — CA_PollCmd helpers (Branch first-byte).
// API: Function.CA_Ipc*  loaded via Import.CAD.App.Ipc

LibraryImport.Arena
LibraryImport.UtilArgs
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_View
LibraryImport.Cad.CAD_Repo
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_UI
LibraryImport.Display.Render.Framebuffer
LibraryImport.StringUtils

// CA_PollCmd first-byte 't' (116).
// Return 0 = not handled (fall through unused); else PollCmd result.
Function.CA_IpcCmdT {
    Output: Integer
    Body: {
        buf = CadAppIpc.cmd
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(buf, 0)
        IfCondition EqualTo(c0, 116) ThenBlock: {
            // tsel K id — left-click tree: select, do not open HUD
            IfCondition EqualTo(GetByte(buf, 1), 115) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 101) ThenBlock: {
                    k = GetByte(buf, 5)
                    out = CA_IpcOut()
                    j = CA_ParseSigned(buf, 6, out)
                    id = 0
                    IfCondition GreaterThan(j, 0) ThenBlock: { id = ArrayGet(out, 0) }
                    CA_TreeSelect(k, id)
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
            // tree K id — navigator Edit (RMB / double-click)
            IfCondition EqualTo(GetByte(buf, 1), 114) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 101) ThenBlock: {
                    k = GetByte(buf, 5)
                    out = CA_IpcOut()
                    j = CA_ParseSigned(buf, 6, out)
                    id = 0
                    IfCondition GreaterThan(j, 0) ThenBlock: { id = ArrayGet(out, 0) }
                    IfCondition EqualTo(k, 83) ThenBlock: {
                        IfCondition GreaterEqual(id, 0) ThenBlock: {
                            IfCondition LessThan(id, CadApp.sk_n) ThenBlock: {
                                CadApp.sketch = ArrayGet(CadApp.sk_list, id)
                                CadApp.mode = 1
                                CadApp.show_sketch = 1
                                CadApp.nclick = 0
                                pl = CAD_Sketch.GetPlaneId(CadApp.sketch)
                                IfCondition NotEqual(pl, 0) ThenBlock: { CadApp.plane = pl }
                                fi = 0
                                WhileLoop LessThan(fi, CadApp.feat_n) {
                                    IfCondition EqualTo(ArrayGet(CadApp.feat_kind, fi), 0) ThenBlock: {
                                        IfCondition EqualTo(ArrayGet(CadApp.feat_sk, fi), id) ThenBlock: {
                                            CadApp.feat_sel = fi
                                        }
                                    }
                                    fi = Add(fi, 1)
                                }
                                CA_LogInt("cad_app: tree sketch ", 21, id)
                            }
                        }
                    }
                    // G — polygon feature: stay in sketch, reopen N/L/D HUD
                    IfCondition EqualTo(k, 71) ThenBlock: {
                        CA_PolyEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    // L — line
                    IfCondition EqualTo(k, 76) ThenBlock: {
                        CA_LineEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    // O — circle
                    IfCondition EqualTo(k, 79) ThenBlock: {
                        CA_CircEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    // E — rectangle
                    IfCondition EqualTo(k, 69) ThenBlock: {
                        CA_RectEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    IfCondition EqualTo(k, 74) ThenBlock: {
                        CA_FilletEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    IfCondition EqualTo(k, 88) ThenBlock: {
                        CA_CstrEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    IfCondition EqualTo(k, 84) ThenBlock: {
                        CA_PointEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    // B pad — reopen height HUD (same as sketch children)
                    IfCondition EqualTo(k, 66) ThenBlock: {
                        CA_PadEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    // R revolve — reopen angle HUD
                    IfCondition EqualTo(k, 82) ThenBlock: {
                        CA_RevEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    // F 3D fillet — reopen R= HUD
                    IfCondition EqualTo(k, 70) ThenBlock: {
                        CA_Fillet3dEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    // C chamfer — reopen D= HUD
                    IfCondition EqualTo(k, 67) ThenBlock: {
                        CA_ChamferEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    // U cut — reopen extrude HUD in CUT
                    IfCondition EqualTo(k, 85) ThenBlock: {
                        CA_PadEditFeat(id)
                        CA_PublishFrame()
                        ReturnValue(2)
                    }
                    go3 = 0
                    IfCondition EqualTo(go3, 1) ThenBlock: {
                        CadApp.mode = 0
                        CadApp.face_pick = 0
                        CA_PlaneClearPick()
                        IfCondition GreaterEqual(id, 0) ThenBlock: {
                            IfCondition LessThan(id, CadApp.feat_n) ThenBlock: {
                                CadApp.feat_sel = id
                            }
                        }
                        CA_Log("cad_app: tree feature 3d\n", 25)
                    }
                    IfCondition EqualTo(k, 77) ThenBlock: {
                        CadApp.mode = 0
                        CadApp.face_pick = 0
                        CA_PlaneClearPick()
                        CadApp.feat_sel = CadApp.feat_n
                        CA_Log("cad_app: tree model\n", 20)
                    }
                    // N — construction plane row → make active
                    IfCondition EqualTo(k, 78) ThenBlock: {
                        CA_PlaneActivateIdx(id)
                        CA_LookAlongActivePlane()
                        CA_LogInt("cad_app: tree plane ", 20, id)
                    }
                    CA_PublishFrame()
                    ReturnValue(2)
                }
            }
            // "tools" — re-publish UI catalog JSON for host chrome
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 111) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, 3), 108) ThenBlock: {
                        IfCondition EqualTo(GetByte(buf, 4), 115) ThenBlock: {
                            CA_RepoEnsure()
                            CA_PublishToolsJson()
                            CA_PublishFrame()
                            // cmd buf pinned
                            ReturnValue(2)
                        }
                    }
                }
            }
            // tool_* — CAD_UI owns ids / variants (arc2, circ3, rectc, polyN, spline, …)
            tid = CAD_UI.ParseTool(buf)
            IfCondition LessThan(tid, 0) ThenBlock: {
                // cmd buf pinned
                ReturnValue(0)
            }
            CadApp.tool = tid
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CadApp.spl_n = 0
            CadApp.hud_kind = 0
            CadApp.hud_field = 0
            IfCondition GreaterThan(CAD_UI_State.nsides, 1) ThenBlock: {
                CadApp.poly_n = CAD_UI_State.nsides
            }
            // chamfer stays in 3D edge-pick; HUD types D
            IfCondition EqualTo(tid, 10) ThenBlock: {
                CadApp.chamfer_edit = 0
                CadApp.nclick = CadApp.sel_nedges
                CadApp.mode = 0
                CadApp.fillet_pick = 0
                CA_HudOpenChamfer()
                CA_Log("cad_app: 3D CHAMFER - Tab Pick/D, arrows, Enter\n", 48)
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            // fillet 2d vs 3d
            IfCondition EqualTo(tid, 8) ThenBlock: {
                IfCondition EqualTo(CadApp.fillet_r, 0) ThenBlock: {
                    CadApp.fillet_r = 0x4020000000000000
                }
                CadApp.hover_ok = 0
                IfCondition EqualTo(CAD_UI_State.is2d, 1) ThenBlock: {
                    CadApp.mode = 1
                    CadApp.nclick = 0
                    CadApp.fillet_li = -1
                    CadApp.fillet_lj = -1
                    CadApp.last_fillet = -1
                    CA_Log("cad_app: SKETCH FILLET - click 2 lines at a corner\n", 51)
                    CA_PublishFrame()
                    // cmd buf pinned
                    ReturnValue(2)
                }
                CadApp.mode = 0
                CadApp.fillet_edit = 0
                CadApp.nclick = CadApp.sel_nedges
                CadApp.fillet_pick = 0
                CA_HudOpenFillet3d()
                CA_Log("cad_app: 3D FILLET - Tab Pick/R, arrows, Enter\n", 47)
                CA_PublishFrame()
                // cmd buf pinned
                ReturnValue(2)
            }
            CadApp.mode = 1
            CA_HoldSolidTess()
            IfCondition EqualTo(tid, 4) ThenBlock: {
                CadApp.mode = 0
                skn = 0
                IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                    skn = CAD_Store.Read(CadApp.sketch, 12)
                }
                IfCondition EqualTo(skn, 0) ThenBlock: {
                    CA_RebuildProfiles()
                }
                IfCondition GreaterThan(skn, 0) ThenBlock: {
                    CadApp.nprof = skn
                    CA_Log("cad_app: Pick - click a profile area (inner = own ID)\n", 55)
                    CA_Log("  or its outline; Shift+click multi\n", 37)
                }
                IfCondition EqualTo(skn, 0) ThenBlock: {
                    IfCondition GreaterThan(CadApp.nprof, 0) ThenBlock: {
                        CA_Log("cad_app: Pick - light red faces ready; click to select\n", 55)
                    }
                    IfCondition EqualTo(CadApp.nprof, 0) ThenBlock: {
                        CA_Log("cad_app: Pick - no profiles; Trim stubs then Profiles\n", 54)
                    }
                }
            }
            IfCondition EqualTo(tid, 6) ThenBlock: {
                CA_Log("cad_app: POINT tool - click to place\n", 37)
            }
            IfCondition EqualTo(tid, 9) ThenBlock: {
                CA_Log("cad_app: ARC3 - start, through, end\n", 36)
            }
            IfCondition EqualTo(tid, 12) ThenBlock: {
                CA_Log("cad_app: ARC2 - diameter start, end\n", 36)
            }
            IfCondition EqualTo(tid, 13) ThenBlock: {
                CA_Log("cad_app: CIRC2 - diameter P0, P1\n", 33)
            }
            IfCondition EqualTo(tid, 14) ThenBlock: {
                CA_Log("cad_app: CIRC3 - three points on rim\n", 37)
            }
            IfCondition EqualTo(tid, 15) ThenBlock: {
                CadApp.last_rect = -1
                CadApp.rect_w = 0
                CadApp.rect_h = 0
                CA_Log("cad_app: RECTC - center, then corner\n", 37)
            }
            IfCondition EqualTo(tid, 16) ThenBlock: {
                CA_Log("cad_app: RECT3 - corner, edge, height\n", 38)
            }
            IfCondition EqualTo(tid, 17) ThenBlock: {
                CA_Log("cad_app: POLY - center, then vertex\n", 36)
            }
            IfCondition EqualTo(tid, 18) ThenBlock: {
                CA_Log("cad_app: SPLINE - clicks=CVs, then done\n", 40)
            }
            CA_PublishFrame()
            // cmd buf pinned
            ReturnValue(2)
        }
        ReturnValue(0)
    }
}

