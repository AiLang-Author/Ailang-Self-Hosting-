// Create plane from face handle + new sketch. Keeps solid.


// Create plane from face handle + new sketch. Keeps solid.
Function.CA_SketchOnFace {
    Input: face_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_Log("cad_app: sketch-on-face needs solid\n", 36)
            ReturnValue(-1)
        }
        IfCondition EqualTo(face_handle, 0) ThenBlock: {
            CA_Log("cad_app: sketch-on-face needs face\n", 35)
            ReturnValue(-2)
        }
        CA_EnsurePlane()
        CA_UndoPush()
        // Pin parent BEFORE CreateFromFace (nested calls clobber locals).
        CadApp.pick_best_f = CadApp.plane
        IfCondition EqualTo(CadApp.pick_best_f, 0) ThenBlock: {
            CadApp.pick_best_f = CadApp.sk0_plane
        }
        CadApp.last_face = face_handle
        pl = CAD_Plane.CreateFromFace(CadApp.last_face, CadApp.solid)
        IfCondition EqualTo(pl, 0) ThenBlock: {
            CA_Log("cad_app: plane FAIL (need planar face)\n", 39)
            ReturnValue(-2)
        }
        CadApp.plane = pl
        CAD_Plane.SetParent(CadApp.plane, CadApp.pick_best_f)
        CAD_Plane.EnsurePid(CadApp.plane)
        CA_FacePlaneFromVerts(CadApp.last_face)
        fr = Allocate(128)
        CAD_Plane.FrameFromFacePlane(CadAppPick.pl, fr)
        CAD_Plane.WriteCacheFromFrame(CadApp.plane, fr)
        CA_OrientPlaneOutward(CadApp.last_face, CadApp.solid)
        fl = CAD_Store.Read(CadApp.plane, 18)
        CAD_Store.Write(CadApp.plane, 18, BitwiseOr(fl, 4))
        Deallocate(fr, 128)
        sk = CAD_Sketch.CreateSketch(1)
        IfCondition EqualTo(sk, 0) ThenBlock: {
            CA_Log("cad_app: sketch FAIL\n", 21)
            ReturnValue(-2)
        }
        CadApp.sketch = sk
        CAD_Sketch.SetPlaneId(CadApp.sketch, CadApp.plane)
        CadApp.sk_i = Add(CadApp.sk_i, 1)
        CA_SketchRegister(sk)
        CadApp.face_pick = 0
        CadApp.hover_face = 0
        CadApp.nprof = 0
        CadApp.prof_user = 0
        CadApp.prof_mask = 0
        CadApp.prof_sel = 0
        CadApp.mode = 1
        CadApp.tool = 0
        CadApp.nclick = 0
        CadApp.dirty = 1
        CA_PlaneRegister(CadApp.plane)
        CA_ImportFaceRefs(CadApp.last_face)
        PrintMessage("cad_app: NEW sketch ")
        PrintNumber(CadApp.sk_i)
        PrintMessage(" on face sk0=")
        PrintNumber(CAD_Plane.GetPid(CadApp.sk0_plane))
        PrintMessage(" pl=")
        PrintNumber(CAD_Plane.GetPid(CadApp.plane))
        PrintMessage(" par=")
        PrintNumber(CAD_Plane.GetPid(CadApp.pick_best_f))
        PrintMessage(" face=")
        PrintNumber(CadApp.last_face)
        PrintMessage("\n")
        CA_LookAlongActivePlane()
        CA_LogInt("cad_app: NEW sketch on face #", 29, CadApp.sk_i)
        CA_Log("  empty UV on that face (prior sketches stay in the tree)\n", 59)
        ReturnValue(0)
    }
}

// Point the 3D camera along -normal so the active face is front-on (solid stays).
Function.CA_LookAlongActivePlane {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: { ReturnValue(0) }
        CA_PickBufs()
        IfCondition EqualTo(CadAppPick.pl, 0) ThenBlock: { ReturnValue(0) }
        CAD_Plane.EvalFrame(CadApp.plane, CadAppPick.pl)
        nx = ArrayGet(CadAppPick.pl, 9)
        ny = ArrayGet(CadAppPick.pl, 10)
        nz = ArrayGet(CadAppPick.pl, 11)
        rxy = CAD_Num.Sqrt(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)))
        CAD_View_State.pitch_r = CAD_Geom.Atan2(Float_Sub(0, nz), rxy)
        CAD_View_State.yaw_r = CAD_Geom.Atan2(Float_Sub(0, nx), Float_Sub(0, ny))
        CAD_View_State.view_mode = 3
        ReturnValue(1)
    }
}

// Project the host face's vertices into the new sketch as frozen User Points
// (FixX + FixY). Constrainable (Coincident / Dist / DistO) without becoming
// pad profiles. Faces with >12 verts (tess circles) skip verts — type X Y.
// Slot 27 = n_face_ref.
Function.CA_ImportFaceRefs {
    Input: face_handle: Integer
    Output: Integer
    Body: {
        CadApp.n_face_ref = 0
        CadApp.proj_n = 0
        IfCondition EqualTo(face_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.proj_xy, 0) ThenBlock: { CadApp.proj_xy = Allocate(1024) }
        CA_PickBufs()
        IfCondition EqualTo(CadAppPick.pl, 0) ThenBlock: { ReturnValue(0) }
        CAD_Plane.EvalFrame(CadApp.plane, CadAppPick.pl)
        CadAppPick.ox = ArrayGet(CadAppPick.pl, 0)
        CadAppPick.oy = ArrayGet(CadAppPick.pl, 1)
        CadAppPick.oz = ArrayGet(CadAppPick.pl, 2)
        CadAppPick.dx = ArrayGet(CadAppPick.pl, 3)
        CadAppPick.dy = ArrayGet(CadAppPick.pl, 4)
        CadAppPick.dz = ArrayGet(CadAppPick.pl, 5)
        CadAppPick.rx = ArrayGet(CadAppPick.pl, 6)
        CadAppPick.ry = ArrayGet(CadAppPick.pl, 7)
        CadAppPick.rz = ArrayGet(CadAppPick.pl, 8)
        lp = CAD_Store.Read(face_handle, 1)
        IfCondition EqualTo(lp, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.hd = CAD_Store.Read(lp, 0)
        IfCondition EqualTo(CadAppPick.hd, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ce = CadAppPick.hd
        nuniq = 0
        cguard = 0
        WhileLoop LessThan(cguard, 256) {
            ce = CadAppPick.ce
            CadAppPick.ov = CAD_Store.Read(ce, 5)
            IfCondition NotEqual(CadAppPick.ov, 0) ThenBlock: {
                CadAppPick.wx = CAD_Store.Read(CadAppPick.ov, 0)
                CadAppPick.wy = CAD_Store.Read(CadAppPick.ov, 1)
                CadAppPick.wz = CAD_Store.Read(CadAppPick.ov, 2)
                CadAppPick.ax = Float_Add(Float_Add(Float_Mul(Float_Sub(CadAppPick.wx, CadAppPick.ox), CadAppPick.dx), Float_Mul(Float_Sub(CadAppPick.wy, CadAppPick.oy), CadAppPick.dy)), Float_Mul(Float_Sub(CadAppPick.wz, CadAppPick.oz), CadAppPick.dz))
                CadAppPick.ay = Float_Add(Float_Add(Float_Mul(Float_Sub(CadAppPick.wx, CadAppPick.ox), CadAppPick.rx), Float_Mul(Float_Sub(CadAppPick.wy, CadAppPick.oy), CadAppPick.ry)), Float_Mul(Float_Sub(CadAppPick.wz, CadAppPick.oz), CadAppPick.rz))
                // unique by ~0.05 mm
                seen = 0
                k = 0
                WhileLoop LessThan(k, nuniq) {
                    du = Float_Sub(ArrayGet(CadAppPick.uv, Multiply(k, 2)), CadAppPick.ax)
                    dv = Float_Sub(ArrayGet(CadAppPick.uv, Add(Multiply(k, 2), 1)), CadAppPick.ay)
                    IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(du, du), Float_Mul(dv, dv)), 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                        seen = 1
                        k = nuniq
                    }
                    IfCondition LessThan(k, nuniq) ThenBlock: {
                        k = Add(k, 1)
                    }
                }
                IfCondition EqualTo(seen, 0) ThenBlock: {
                    IfCondition LessThan(nuniq, 64) ThenBlock: {
                        ArraySet(CadAppPick.uv, Multiply(nuniq, 2), CadAppPick.ax)
                        ArraySet(CadAppPick.uv, Add(Multiply(nuniq, 2), 1), CadAppPick.ay)
                        nuniq = Add(nuniq, 1)
                    }
                }
                // Ordered loop for dashed projection (keep consecutive, even if many)
                IfCondition NotEqual(CadApp.proj_xy, 0) ThenBlock: {
                    IfCondition LessThan(CadApp.proj_n, 64) ThenBlock: {
                        keep = 1
                        IfCondition GreaterThan(CadApp.proj_n, 0) ThenBlock: {
                            pu = ArrayGet(CadApp.proj_xy, Multiply(Subtract(CadApp.proj_n, 1), 2))
                            pv = ArrayGet(CadApp.proj_xy, Add(Multiply(Subtract(CadApp.proj_n, 1), 2), 1))
                            du = Float_Sub(CadAppPick.ax, pu)
                            dv = Float_Sub(CadAppPick.ay, pv)
                            IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(du, du), Float_Mul(dv, dv)), 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                                keep = 0
                            }
                        }
                        IfCondition EqualTo(keep, 1) ThenBlock: {
                            ArraySet(CadApp.proj_xy, Multiply(CadApp.proj_n, 2), CadAppPick.ax)
                            ArraySet(CadApp.proj_xy, Add(Multiply(CadApp.proj_n, 2), 1), CadAppPick.ay)
                            CadApp.proj_n = Add(CadApp.proj_n, 1)
                        }
                    }
                }
            }
            CadAppPick.ce = CAD_Store.Read(ce, 2)
            cguard = Add(cguard, 1)
            IfCondition EqualTo(CadAppPick.ce, CadAppPick.hd) ThenBlock: { cguard = 256 }
            IfCondition EqualTo(CadAppPick.ce, 0) ThenBlock: { cguard = 256 }
        }
        IfCondition EqualTo(nuniq, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(nuniq, 12) ThenBlock: {
            CA_Log("cad_app: face refs skip (many verts; type pt X Y)\n", 51)
            CAD_Store.Write(CadApp.sketch, 27, 0)
            ReturnValue(0)
        }
        CadAppPick.ins_i = 0
        WhileLoop LessThan(CadAppPick.ins_i, nuniq) {
            i = CadAppPick.ins_i
            CadAppPick.ax = ArrayGet(CadAppPick.uv, Multiply(i, 2))
            CadAppPick.ay = ArrayGet(CadAppPick.uv, Add(Multiply(i, 2), 1))
            CadAppPick.face = CAD_Sketch.AddUserPoint(CadApp.sketch, CadAppPick.ax, CadAppPick.ay, 0)
            IfCondition GreaterEqual(CadAppPick.face, 0) ThenBlock: {
                i = CadAppPick.ins_i
                CadAppPick.ax = ArrayGet(CadAppPick.uv, Multiply(i, 2))
                CAD_Sketch.AddConstraint(CadApp.sketch, 2, 3, CadAppPick.face, CadAppPick.ax)
                i = CadAppPick.ins_i
                CadAppPick.ay = ArrayGet(CadAppPick.uv, Add(Multiply(i, 2), 1))
                CAD_Sketch.AddConstraint(CadApp.sketch, 3, 3, CadAppPick.face, CadAppPick.ay)
            }
            CadAppPick.ins_i = Add(CadAppPick.ins_i, 1)
        }
        CadApp.n_face_ref = nuniq
        CAD_Store.Write(CadApp.sketch, 27, nuniq)
        CA_LogInt("cad_app: face refs (frozen UV verts) n=", 39, nuniq)
        CA_LogInt("cad_app: face proj edges n=", 27, CadApp.proj_n)
        ReturnValue(nuniq)
    }
}

// Pick planar B-Rep face under pixel in current 3D view. Returns face handle or 0.


// Camera basis for free-orbit ortho (same as CAD_View.ProjectPoint).
Function.CA_CamBasis {
    Output: Integer
    Body: {
        yaw = CAD_View_State.yaw_r
        pitch = CAD_View_State.pitch_r
        cyaw = CAD_Geom.Cos(yaw)
        syaw = CAD_Geom.Sin(yaw)
        cp = CAD_Geom.Cos(pitch)
        sp = CAD_Geom.Sin(pitch)
        CadAppPick.cdx = Float_Mul(cp, syaw)
        CadAppPick.cdy = Float_Mul(cp, cyaw)
        CadAppPick.cdz = sp
        rx = Float_Sub(0, CadAppPick.cdy)
        ry = CadAppPick.cdx
        rl = CAD_Num.Sqrt(Float_Add(Float_Mul(rx, rx), Float_Mul(ry, ry)))
        IfCondition EqualTo(CAD_Num.IsZero(rl, 0), 1) ThenBlock: {
            rx = 0x3FF0000000000000
            ry = 0
            rl = 0x3FF0000000000000
        }
        CadAppPick.rx = Float_Div(rx, rl)
        CadAppPick.ry = Float_Div(ry, rl)
        CadAppPick.rz = 0
        ux = Float_Sub(Float_Mul(CadAppPick.cdy, CadAppPick.rz), Float_Mul(CadAppPick.cdz, CadAppPick.ry))
        uy = Float_Sub(Float_Mul(CadAppPick.cdz, CadAppPick.rx), Float_Mul(CadAppPick.cdx, CadAppPick.rz))
        uz = Float_Sub(Float_Mul(CadAppPick.cdx, CadAppPick.ry), Float_Mul(CadAppPick.cdy, CadAppPick.rx))
        ul = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ux, ux), Float_Mul(uy, uy)), Float_Mul(uz, uz)))
        IfCondition EqualTo(CAD_Num.IsZero(ul, 0), 0) ThenBlock: {
            ux = Float_Div(ux, ul)
            uy = Float_Div(uy, ul)
            uz = Float_Div(uz, ul)
        }
        CadAppPick.ux = ux
        CadAppPick.uy = uy
        CadAppPick.uz = uz
        ReturnValue(0)
    }
}

// Fit CadAppPick.pl from live loop verts (Newell + first edge).
// Stored face planes stay at local z after Translate/Map — verts are world.
Function.CA_FacePlaneFromVerts {
    Input: face_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadAppPick.pl, 0) ThenBlock: { CadAppPick.pl = Allocate(128) }
        IfCondition EqualTo(CadAppPick.pl, 0) ThenBlock: { ReturnValue(-1) }
        CadAppPick.face = face_handle
        lp = CAD_Store.Read(CadAppPick.face, 1)
        IfCondition EqualTo(lp, 0) ThenBlock: { ReturnValue(-1) }
        CadAppPick.hd = CAD_Store.Read(lp, 0)
        IfCondition EqualTo(CadAppPick.hd, 0) ThenBlock: { ReturnValue(-1) }
        CadAppPick.ce = CadAppPick.hd
        ov = CAD_Store.Read(CadAppPick.ce, 5)
        IfCondition EqualTo(ov, 0) ThenBlock: { ReturnValue(-1) }
        CadAppPick.ox = CAD_Store.Read(ov, 0)
        CadAppPick.oy = CAD_Store.Read(ov, 1)
        CadAppPick.oz = CAD_Store.Read(ov, 2)
        nxt = CAD_Store.Read(CadAppPick.ce, 2)
        IfCondition EqualTo(nxt, 0) ThenBlock: { ReturnValue(-1) }
        ov = CAD_Store.Read(nxt, 5)
        IfCondition EqualTo(ov, 0) ThenBlock: { ReturnValue(-1) }
        CadAppPick.ax = CAD_Store.Read(ov, 0)
        CadAppPick.ay = CAD_Store.Read(ov, 1)
        CadAppPick.bx = CAD_Store.Read(ov, 2)
        CadAppPick.nx = 0
        CadAppPick.ny = 0
        CadAppPick.nz = 0
        CadAppPick.ce = CadAppPick.hd
        cguard = 0
        WhileLoop LessThan(cguard, 512) {
            ce = CadAppPick.ce
            ov = CAD_Store.Read(ce, 5)
            nxt = CAD_Store.Read(ce, 2)
            IfCondition EqualTo(ov, 0) ThenBlock: { cguard = 512 }
            IfCondition EqualTo(nxt, 0) ThenBlock: { cguard = 512 }
            IfCondition NotEqual(ov, 0) ThenBlock: {
                IfCondition NotEqual(nxt, 0) ThenBlock: {
                    ov2 = CAD_Store.Read(nxt, 5)
                    IfCondition NotEqual(ov2, 0) ThenBlock: {
                        CadAppPick.hu = CAD_Store.Read(ov, 0)
                        CadAppPick.hv = CAD_Store.Read(ov, 1)
                        CadAppPick.last_t = CAD_Store.Read(ov, 2)
                        CadAppPick.pi = CAD_Store.Read(ov2, 0)
                        CadAppPick.pj = CAD_Store.Read(ov2, 1)
                        CadAppPick.pins = CAD_Store.Read(ov2, 2)
                        CadAppPick.nx = Float_Add(CadAppPick.nx, Float_Mul(Float_Sub(CadAppPick.hv, CadAppPick.pj), Float_Add(CadAppPick.last_t, CadAppPick.pins)))
                        CadAppPick.ny = Float_Add(CadAppPick.ny, Float_Mul(Float_Sub(CadAppPick.last_t, CadAppPick.pins), Float_Add(CadAppPick.hu, CadAppPick.pi)))
                        CadAppPick.nz = Float_Add(CadAppPick.nz, Float_Mul(Float_Sub(CadAppPick.hu, CadAppPick.pi), Float_Add(CadAppPick.hv, CadAppPick.pj)))
                    }
                    CadAppPick.ce = nxt
                }
            }
            cguard = Add(cguard, 1)
            IfCondition EqualTo(CadAppPick.ce, CadAppPick.hd) ThenBlock: { cguard = 512 }
        }
        nl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CadAppPick.nx, CadAppPick.nx), Float_Mul(CadAppPick.ny, CadAppPick.ny)), Float_Mul(CadAppPick.nz, CadAppPick.nz)))
        IfCondition EqualTo(CAD_Num.IsZero(nl, 0), 1) ThenBlock: { ReturnValue(-1) }
        CadAppPick.nx = Float_Div(CadAppPick.nx, nl)
        CadAppPick.ny = Float_Div(CadAppPick.ny, nl)
        CadAppPick.nz = Float_Div(CadAppPick.nz, nl)
        // X = first edge flattened onto plane (pinned — Float_* clobbers locals)
        CadAppPick.hu = Float_Sub(CadAppPick.ax, CadAppPick.ox)
        CadAppPick.hv = Float_Sub(CadAppPick.ay, CadAppPick.oy)
        CadAppPick.last_t = Float_Sub(CadAppPick.bx, CadAppPick.oz)
        CadAppPick.pi = Float_Add(Float_Add(Float_Mul(CadAppPick.hu, CadAppPick.nx), Float_Mul(CadAppPick.hv, CadAppPick.ny)), Float_Mul(CadAppPick.last_t, CadAppPick.nz))
        CadAppPick.hu = Float_Sub(CadAppPick.hu, Float_Mul(CadAppPick.pi, CadAppPick.nx))
        CadAppPick.hv = Float_Sub(CadAppPick.hv, Float_Mul(CadAppPick.pi, CadAppPick.ny))
        CadAppPick.last_t = Float_Sub(CadAppPick.last_t, Float_Mul(CadAppPick.pi, CadAppPick.nz))
        xl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CadAppPick.hu, CadAppPick.hu), Float_Mul(CadAppPick.hv, CadAppPick.hv)), Float_Mul(CadAppPick.last_t, CadAppPick.last_t)))
        IfCondition EqualTo(CAD_Num.IsZero(xl, 0), 1) ThenBlock: { ReturnValue(-1) }
        CadAppPick.hu = Float_Div(CadAppPick.hu, xl)
        CadAppPick.hv = Float_Div(CadAppPick.hv, xl)
        CadAppPick.last_t = Float_Div(CadAppPick.last_t, xl)
        // Y = N × X
        CadAppPick.pi = Float_Sub(Float_Mul(CadAppPick.ny, CadAppPick.last_t), Float_Mul(CadAppPick.nz, CadAppPick.hv))
        CadAppPick.pj = Float_Sub(Float_Mul(CadAppPick.nz, CadAppPick.hu), Float_Mul(CadAppPick.nx, CadAppPick.last_t))
        CadAppPick.pins = Float_Sub(Float_Mul(CadAppPick.nx, CadAppPick.hv), Float_Mul(CadAppPick.ny, CadAppPick.hu))
        ArraySet(CadAppPick.pl, 0, 1)
        ArraySet(CadAppPick.pl, 1, CadAppPick.ox)
        ArraySet(CadAppPick.pl, 2, CadAppPick.oy)
        ArraySet(CadAppPick.pl, 3, CadAppPick.oz)
        ArraySet(CadAppPick.pl, 4, CadAppPick.hu)
        ArraySet(CadAppPick.pl, 5, CadAppPick.hv)
        ArraySet(CadAppPick.pl, 6, CadAppPick.last_t)
        ArraySet(CadAppPick.pl, 7, CadAppPick.pi)
        ArraySet(CadAppPick.pl, 8, CadAppPick.pj)
        ArraySet(CadAppPick.pl, 9, CadAppPick.pins)
        ArraySet(CadAppPick.pl, 10, CadAppPick.nx)
        ArraySet(CadAppPick.pl, 11, CadAppPick.ny)
        ArraySet(CadAppPick.pl, 12, CadAppPick.nz)
        // UV origin = face centroid (on THIS face), not first vert / part origin.
        CA_PickBufs()
        IfCondition EqualTo(CAD_Topo.FaceCentroid(CadAppPick.face, CadAppPick.pa), 1) ThenBlock: {
            ArraySet(CadAppPick.pl, 1, ArrayGet(CadAppPick.pa, 0))
            ArraySet(CadAppPick.pl, 2, ArrayGet(CadAppPick.pa, 1))
            ArraySet(CadAppPick.pl, 3, ArrayGet(CadAppPick.pa, 2))
        }
        ReturnValue(0)
    }
}

// Flip cached Y/N on CadApp.plane so +N points away from CadApp.solid.
// Uses only pinned CadApp.* — FaceCentroid/SolidBounds clobber Inputs.
Function.CA_OrientPlaneOutward {
    Input: face_handle: Integer
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        CadApp.last_face = face_handle
        IfCondition EqualTo(CadApp.last_face, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: { ReturnValue(0) }
        CA_PickBufs()
        IfCondition EqualTo(CadAppPick.pa, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FaceCentroid(CadApp.last_face, CadAppPick.pa), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo.SolidBounds(CadApp.solid, CadAppPick.pb, CadAppPick.pr), 0) ThenBlock: {
            ReturnValue(0)
        }
        CadAppPick.hu = Float_Div(Float_Add(ArrayGet(CadAppPick.pb, 0), ArrayGet(CadAppPick.pr, 0)), 0x4000000000000000)
        CadAppPick.hv = Float_Div(Float_Add(ArrayGet(CadAppPick.pb, 1), ArrayGet(CadAppPick.pr, 1)), 0x4000000000000000)
        CadAppPick.last_t = Float_Div(Float_Add(ArrayGet(CadAppPick.pb, 2), ArrayGet(CadAppPick.pr, 2)), 0x4000000000000000)
        CadAppPick.ax = Float_Sub(ArrayGet(CadAppPick.pa, 0), CadAppPick.hu)
        CadAppPick.ay = Float_Sub(ArrayGet(CadAppPick.pa, 1), CadAppPick.hv)
        CadAppPick.bx = Float_Sub(ArrayGet(CadAppPick.pa, 2), CadAppPick.last_t)
        CadAppPick.nx = CAD_Store.Read(CadApp.plane, 10)
        CadAppPick.ny = CAD_Store.Read(CadApp.plane, 11)
        CadAppPick.nz = CAD_Store.Read(CadApp.plane, 12)
        CadAppPick.hu = Float_Add(Float_Add(Float_Mul(CadAppPick.nx, CadAppPick.ax), Float_Mul(CadAppPick.ny, CadAppPick.ay)), Float_Mul(CadAppPick.nz, CadAppPick.bx))
        IfCondition EqualTo(CAD_Num.IsNeg(CadAppPick.hu), 1) ThenBlock: {
            CAD_Store.Write(CadApp.plane, 7, Float_Sub(0, CAD_Store.Read(CadApp.plane, 7)))
            CAD_Store.Write(CadApp.plane, 8, Float_Sub(0, CAD_Store.Read(CadApp.plane, 8)))
            CAD_Store.Write(CadApp.plane, 9, Float_Sub(0, CAD_Store.Read(CadApp.plane, 9)))
            CAD_Store.Write(CadApp.plane, 10, Float_Sub(0, CAD_Store.Read(CadApp.plane, 10)))
            CAD_Store.Write(CadApp.plane, 11, Float_Sub(0, CAD_Store.Read(CadApp.plane, 11)))
            CAD_Store.Write(CadApp.plane, 12, Float_Sub(0, CAD_Store.Read(CadApp.plane, 12)))
            CA_Log("cad_app: face N flipped outward (pad away from solid)\n", 53)
        }
        ReturnValue(1)
    }
}

// Disk test for a 1-vert circle cap. Uses CadAppPick.ox/hit/hd. Does not touch last_t.
Function.CA_FaceHitDisk {
    Output: Integer
    Body: {
        CadAppPick.n_circ = Add(CadAppPick.n_circ, 1)
        IfCondition EqualTo(CadAppPick.hd, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.pins = 0
        edc = CAD_Store.Read(CadAppPick.hd, 0)
        IfCondition NotEqual(edc, 0) ThenBlock: {
            crvc = CAD_Store.Read(edc, 2)
            IfCondition NotEqual(crvc, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(crvc, 0), 2) ThenBlock: {
                    CadAppPick.pins = CAD_Store.Read(crvc, 10)
                }
            }
        }
        IfCondition EqualTo(CAD_Num.IsZero(CadAppPick.pins, 0), 1) ThenBlock: {
            ov = CAD_Store.Read(CadAppPick.hd, 5)
            IfCondition EqualTo(ov, 0) ThenBlock: { ReturnValue(0) }
            CadAppPick.hu = Float_Sub(CAD_Store.Read(ov, 0), CadAppPick.ox)
            CadAppPick.hv = Float_Sub(CAD_Store.Read(ov, 1), CadAppPick.oy)
            CadAppPick.pi = Float_Sub(CAD_Store.Read(ov, 2), CadAppPick.oz)
            CadAppPick.pins = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CadAppPick.hu, CadAppPick.hu), Float_Mul(CadAppPick.hv, CadAppPick.hv)), Float_Mul(CadAppPick.pi, CadAppPick.pi)))
        }
        IfCondition EqualTo(CAD_Num.IsZero(CadAppPick.pins, 0), 1) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = ArrayGet(CadAppPick.hit, 0)
        CadAppPick.ay = ArrayGet(CadAppPick.hit, 1)
        CadAppPick.bx = ArrayGet(CadAppPick.hit, 2)
        CadAppPick.hu = Float_Sub(CadAppPick.ax, CadAppPick.ox)
        CadAppPick.hv = Float_Sub(CadAppPick.ay, CadAppPick.oy)
        CadAppPick.pi = Float_Sub(CadAppPick.bx, CadAppPick.oz)
        CadAppPick.hu = Float_Add(Float_Add(Float_Mul(CadAppPick.hu, CadAppPick.hu), Float_Mul(CadAppPick.hv, CadAppPick.hv)), Float_Mul(CadAppPick.pi, CadAppPick.pi))
        CadAppPick.hv = Float_Mul(CadAppPick.pins, CadAppPick.pins)
        IfCondition EqualTo(CAD_Num.Le(CadAppPick.hu, CadAppPick.hv), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Even-odd in face UV. Same interpolant as CAD_Topo.PointInFaceUV (pinned, no heap).
Function.CA_FaceContainsHit {
    Input: face_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_handle, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.face = face_handle
        IfCondition EqualTo(CadAppPick.uv, 0) ThenBlock: { CadAppPick.uv = Allocate(4096) }
        IfCondition EqualTo(CadAppPick.uv, 0) ThenBlock: { ReturnValue(0) }
        lp = CAD_Store.Read(CadAppPick.face, 1)
        IfCondition EqualTo(lp, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.hd = CAD_Store.Read(lp, 0)
        IfCondition EqualTo(CadAppPick.hd, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ce = CadAppPick.hd
        CadAppPick.pn = 0
        cguard = 0
        WhileLoop LessThan(cguard, 512) {
            ce = CadAppPick.ce
            CadAppPick.ov = CAD_Store.Read(ce, 5)
            ov = CadAppPick.ov
            IfCondition NotEqual(ov, 0) ThenBlock: {
                dx = Float_Sub(CAD_Store.Read(ov, 0), CadAppPick.ox)
                dy = Float_Sub(CAD_Store.Read(ov, 1), CadAppPick.oy)
                dz = Float_Sub(CAD_Store.Read(ov, 2), CadAppPick.oz)
                xx = ArrayGet(CadAppPick.pl, 4)
                xy = ArrayGet(CadAppPick.pl, 5)
                xz = ArrayGet(CadAppPick.pl, 6)
                yx = ArrayGet(CadAppPick.pl, 7)
                yy = ArrayGet(CadAppPick.pl, 8)
                yz = ArrayGet(CadAppPick.pl, 9)
                u = Float_Add(Float_Add(Float_Mul(dx, xx), Float_Mul(dy, xy)), Float_Mul(dz, xz))
                v = Float_Add(Float_Add(Float_Mul(dx, yx), Float_Mul(dy, yy)), Float_Mul(dz, yz))
                n = CadAppPick.pn
                IfCondition LessThan(n, 256) ThenBlock: {
                    ArraySet(CadAppPick.uv, Multiply(n, 2), u)
                    ArraySet(CadAppPick.uv, Add(Multiply(n, 2), 1), v)
                    CadAppPick.pn = Add(n, 1)
                }
            }
            ce = CadAppPick.ce
            CadAppPick.ce = CAD_Store.Read(ce, 2)
            cguard = Add(cguard, 1)
            IfCondition EqualTo(CadAppPick.ce, CadAppPick.hd) ThenBlock: { cguard = 512 }
        }
        IfCondition LessThan(CadAppPick.pn, 3) ThenBlock: {
            ReturnValue(CA_FaceHitDisk())
        }
        hx = ArrayGet(CadAppPick.hit, 0)
        hy = ArrayGet(CadAppPick.hit, 1)
        hz = ArrayGet(CadAppPick.hit, 2)
        xx = ArrayGet(CadAppPick.pl, 4)
        xy = ArrayGet(CadAppPick.pl, 5)
        xz = ArrayGet(CadAppPick.pl, 6)
        yx = ArrayGet(CadAppPick.pl, 7)
        yy = ArrayGet(CadAppPick.pl, 8)
        yz = ArrayGet(CadAppPick.pl, 9)
        CadAppPick.hu = Float_Add(Float_Add(Float_Mul(Float_Sub(hx, CadAppPick.ox), xx), Float_Mul(Float_Sub(hy, CadAppPick.oy), xy)), Float_Mul(Float_Sub(hz, CadAppPick.oz), xz))
        CadAppPick.hv = Float_Add(Float_Add(Float_Mul(Float_Sub(hx, CadAppPick.ox), yx), Float_Mul(Float_Sub(hy, CadAppPick.oy), yy)), Float_Mul(Float_Sub(hz, CadAppPick.oz), yz))
        CadAppPick.pins = 0
        CadAppPick.pi = 0
        CadAppPick.pj = Subtract(CadAppPick.pn, 1)
        WhileLoop LessThan(CadAppPick.pi, CadAppPick.pn) {
            i = CadAppPick.pi
            j = CadAppPick.pj
            ui = ArrayGet(CadAppPick.uv, Multiply(i, 2))
            vi = ArrayGet(CadAppPick.uv, Add(Multiply(i, 2), 1))
            uj = ArrayGet(CadAppPick.uv, Multiply(j, 2))
            vj = ArrayGet(CadAppPick.uv, Add(Multiply(j, 2), 1))
            hv = CadAppPick.hv
            hu = CadAppPick.hu
            cross = 0
            IfCondition EqualTo(CAD_Num.Le(vi, hv), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.Le(hv, vj), 1) ThenBlock: { cross = 1 }
            }
            IfCondition EqualTo(CAD_Num.Le(vj, hv), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.Le(hv, vi), 1) ThenBlock: { cross = 1 }
            }
            IfCondition EqualTo(cross, 1) ThenBlock: {
                den = Float_Sub(vj, vi)
                IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                    i = CadAppPick.pi
                    j = CadAppPick.pj
                    ui = ArrayGet(CadAppPick.uv, Multiply(i, 2))
                    vi = ArrayGet(CadAppPick.uv, Add(Multiply(i, 2), 1))
                    uj = ArrayGet(CadAppPick.uv, Multiply(j, 2))
                    vj = ArrayGet(CadAppPick.uv, Add(Multiply(j, 2), 1))
                    hv = CadAppPick.hv
                    hu = CadAppPick.hu
                    tt = Float_Div(Float_Sub(hv, vi), Float_Sub(vj, vi))
                    uint = Float_Add(ui, Float_Mul(tt, Float_Sub(uj, ui)))
                    IfCondition EqualTo(CAD_Num.Le(hu, uint), 1) ThenBlock: {
                        CadAppPick.pins = Subtract(1, CadAppPick.pins)
                    }
                }
            }
            CadAppPick.pj = CadAppPick.pi
            CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        ReturnValue(CadAppPick.pins)
    }
}

// Front-most planar face under the pixel. Ortho ray + in-face (no click-through).
Function.CA_PickFaceAt {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(0) }
        CA_PickBufs()
        IfCondition EqualTo(CadAppPick.fr, 0) ThenBlock: { ReturnValue(0) }
        CA_BuildViewFrame(CadAppPick.fr)
        CA_CamBasis()
        cx = ArrayGet(CadAppPick.fr, 0)
        cy = ArrayGet(CadAppPick.fr, 1)
        cz = ArrayGet(CadAppPick.fr, 2)
        sc = ArrayGet(CadAppPick.fr, 3)
        hw = ArrayGet(CadAppPick.fr, 4)
        hh = ArrayGet(CadAppPick.fr, 5)
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: { ReturnValue(0) }
        uu = Float_Sub(Float_Div(Float_Sub(Float_FromInt(px), hw), sc), CAD_View_State.pan_u)
        vv = Float_Sub(Float_Div(Float_Sub(hh, Float_FromInt(py)), sc), CAD_View_State.pan_v)
        CadAppPick.wx = Float_Add(cx, Float_Add(Float_Mul(uu, CadAppPick.rx), Float_Mul(vv, CadAppPick.ux)))
        CadAppPick.wy = Float_Add(cy, Float_Add(Float_Mul(uu, CadAppPick.ry), Float_Mul(vv, CadAppPick.uy)))
        CadAppPick.wz = Float_Add(cz, Float_Add(Float_Mul(uu, CadAppPick.rz), Float_Mul(vv, CadAppPick.uz)))
        // into the scene (away from camera)
        CadAppPick.dx = Float_Sub(0, CadAppPick.cdx)
        CadAppPick.dy = Float_Sub(0, CadAppPick.cdy)
        CadAppPick.dz = Float_Sub(0, CadAppPick.cdz)
        CadAppPick.best_f = 0
        CadAppPick.best_t = 0x42C1D206A0000000
        CadAppPick.n_hits = 0
        CadAppPick.n_plane = 0
        CadAppPick.n_circ = 0
        CadApp.pick_n = 0
        CadApp.pick_shell = CAD_Store.Read(CadApp.solid, 0)
        sguard = 0
        WhileLoop NotEqual(CadApp.pick_shell, 0) {
            CadApp.pick_fh = CAD_Store.Read(CadApp.pick_shell, 0)
            fguard = 0
            WhileLoop NotEqual(CadApp.pick_fh, 0) {
                CadApp.pick_n = Add(CadApp.pick_n, 1)
                fh = CadApp.pick_fh
                IfCondition EqualTo(CAD_Topo.FaceGetPlane(fh, CadAppPick.pl), 0) ThenBlock: {
                    CadAppPick.n_plane = Add(CadAppPick.n_plane, 1)
                    fh = CadApp.pick_fh
                    // Keep FaceGetPlane. Vert Newell on a 1-vert circle smashes the disk.
                    CadAppPick.ox = ArrayGet(CadAppPick.pl, 1)
                    CadAppPick.oy = ArrayGet(CadAppPick.pl, 2)
                    CadAppPick.oz = ArrayGet(CadAppPick.pl, 3)
                    CadAppPick.nx = ArrayGet(CadAppPick.pl, 10)
                    CadAppPick.ny = ArrayGet(CadAppPick.pl, 11)
                    CadAppPick.nz = ArrayGet(CadAppPick.pl, 12)
                    den = Float_Add(Float_Add(Float_Mul(CadAppPick.dx, CadAppPick.nx), Float_Mul(CadAppPick.dy, CadAppPick.ny)), Float_Mul(CadAppPick.dz, CadAppPick.nz))
                    IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                        CadAppPick.last_t = Float_Div(Float_Add(Float_Add(Float_Mul(Float_Sub(CadAppPick.ox, CadAppPick.wx), CadAppPick.nx), Float_Mul(Float_Sub(CadAppPick.oy, CadAppPick.wy), CadAppPick.ny)), Float_Mul(Float_Sub(CadAppPick.oz, CadAppPick.wz), CadAppPick.nz)), den)
                        ArraySet(CadAppPick.hit, 0, Float_Add(CadAppPick.wx, Float_Mul(CadAppPick.last_t, CadAppPick.dx)))
                        ArraySet(CadAppPick.hit, 1, Float_Add(CadAppPick.wy, Float_Mul(CadAppPick.last_t, CadAppPick.dy)))
                        ArraySet(CadAppPick.hit, 2, Float_Add(CadAppPick.wz, Float_Mul(CadAppPick.last_t, CadAppPick.dz)))
                        fh = CadApp.pick_fh
                        IfCondition EqualTo(CA_FaceContainsHit(fh), 1) ThenBlock: {
                            CA_HitInsert(CadAppPick.last_t, CadApp.pick_fh)
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CadAppPick.last_t, CadAppPick.best_t)), 1) ThenBlock: {
                                CadAppPick.best_t = CadAppPick.last_t
                                CadAppPick.best_f = CadApp.pick_fh
                            }
                        }
                    }
                }
                fh = CadApp.pick_fh
                CadApp.pick_fh = CAD_Store.Read(fh, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 512) ThenBlock: { CadApp.pick_fh = 0 }
            }
            sh = CadApp.pick_shell
            CadApp.pick_shell = CAD_Store.Read(sh, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { CadApp.pick_shell = 0 }
        }
        IfCondition EqualTo(CadAppPick.quiet, 0) ThenBlock: {
            PrintMessage("cad_app: face pick n=")
            PrintNumber(CadApp.pick_n)
            PrintMessage(" fh=")
            PrintNumber(CadAppPick.best_f)
            PrintMessage("\n")
        }
        IfCondition GreaterThan(CadAppPick.n_hits, 0) ThenBlock: {
            CadAppPick.best_f = ArrayGet(CadAppPick.hit_f, 0)
            CadAppPick.best_t = ArrayGet(CadAppPick.hit_t, 0)
        }
        IfCondition EqualTo(CadAppPick.quiet, 0) ThenBlock: {
            CA_LogInt("cad_app: face pick hits=", 25, CadAppPick.n_hits)
            CA_LogInt("cad_app: face pick n=", 21, CadApp.pick_n)
            CA_LogInt("cad_app: face pick planar=", 26, CadAppPick.n_plane)
            CA_LogInt("cad_app: face pick circ=", 24, CadAppPick.n_circ)
        }
        ReturnValue(CadAppPick.best_f)
    }
}

// Insert (t,fh) into hit_t/hit_f sorted by increasing t (front-most first).
Function.CA_HitInsert {
    Input: t_r: Integer
    Input: fh: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppPick.hit_t, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(CadAppPick.n_hits, 128) ThenBlock: { ReturnValue(0) }
        CadAppPick.last_t = t_r
        CadAppPick.face = fh
        CadAppPick.ins_i = CadAppPick.n_hits
        i = 0
        WhileLoop LessThan(i, CadAppPick.n_hits) {
            prv = ArrayGet(CadAppPick.hit_t, i)
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CadAppPick.last_t, prv)), 1) ThenBlock: {
                CadAppPick.ins_i = i
                i = CadAppPick.n_hits
            }
            IfCondition LessThan(i, CadAppPick.n_hits) ThenBlock: {
                i = Add(i, 1)
            }
        }
        j = CadAppPick.n_hits
        WhileLoop GreaterThan(j, CadAppPick.ins_i) {
            ArraySet(CadAppPick.hit_t, j, ArrayGet(CadAppPick.hit_t, Subtract(j, 1)))
            ArraySet(CadAppPick.hit_f, j, ArrayGet(CadAppPick.hit_f, Subtract(j, 1)))
            j = Subtract(j, 1)
        }
        ArraySet(CadAppPick.hit_t, CadAppPick.ins_i, CadAppPick.last_t)
        ArraySet(CadAppPick.hit_f, CadAppPick.ins_i, CadAppPick.face)
        CadAppPick.n_hits = Add(CadAppPick.n_hits, 1)
        ReturnValue(1)
    }
}

// Next face along the same ray after cur (wrap). 0 if none.
Function.CA_PickFaceNext {
    Input: px: Integer
    Input: py: Integer
    Input: cur: Integer
    Output: Integer
    Body: {
        CA_PickFaceAt(px, py)
        IfCondition LessThan(CadAppPick.n_hits, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(cur, 0) ThenBlock: {
            ReturnValue(ArrayGet(CadAppPick.hit_f, 0))
        }
        i = 0
        found = -1
        WhileLoop LessThan(i, CadAppPick.n_hits) {
            IfCondition EqualTo(ArrayGet(CadAppPick.hit_f, i), cur) ThenBlock: {
                found = i
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(found, 0) ThenBlock: {
            ReturnValue(ArrayGet(CadAppPick.hit_f, 0))
        }
        nxt = Add(found, 1)
        IfCondition GreaterEqual(nxt, CadAppPick.n_hits) ThenBlock: { nxt = 0 }
        ReturnValue(ArrayGet(CadAppPick.hit_f, nxt))
    }
}

Function.CA_PlaneByPid {
    Input: pid: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(pid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.plane_list, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, CadApp.plane_n) {
            pl = ArrayGet(CadApp.plane_list, i)
            IfCondition EqualTo(CAD_Plane.GetPid(pl), pid) ThenBlock: {
                ReturnValue(pl)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Parent-first regen. FACE: live handle, then signature (loud miss). No XY fallback.
Function.CA_RegenPlaneTree {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.plane_list, 0) ThenBlock: { ReturnValue(0) }
        misses = 0
        fr = Allocate(128)
        i = 0
        WhileLoop LessThan(i, CadApp.plane_n) {
            pl = ArrayGet(CadApp.plane_list, i)
            IfCondition EqualTo(CAD_Plane.GetMode(pl), 3) ThenBlock: {
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                    CAD_Store.Write(pl, 16, CadApp.solid)
                }
            }
            rc = CAD_Plane.EvalFrame(pl, fr)
            IfCondition EqualTo(rc, -1) ThenBlock: {
                misses = Add(misses, 1)
                PrintMessage("cad_app: FACE MISS pid=")
                PrintNumber(CAD_Plane.GetPid(pl))
                PrintMessage(" (signature last-resort failed)\n")
                CA_Log("cad_app: FACE MISS - plane face lost after regen\n", 49)
            }
            i = Add(i, 1)
        }
        Deallocate(fr, 128)
        ReturnValue(misses)
    }
}

// plane_tree asset (PT1 text, stored as application/json).
Function.CA_FormatPlaneTree {
    Input: buf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        CA_EnsurePlane()
        sk0p = CAD_Plane.GetPid(CadApp.sk0_plane)
        act = 0
        IfCondition NotEqual(CadApp.plane, 0) ThenBlock: {
            act = CAD_Plane.GetPid(CadApp.plane)
        }
        skpl = act
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            sph = CAD_Sketch.GetPlaneId(CadApp.sketch)
            IfCondition NotEqual(sph, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Plane.GetPid(sph), 0) ThenBlock: {
                    skpl = CAD_Plane.GetPid(sph)
                }
            }
        }
        pos = 0
        pos = CAD_Repo.AppendStr(buf, pos, "{\"v\":1,\"fmt\":\"PT1\",\"sk0\":")
        pos = CAD_Repo.AppendInt(buf, pos, sk0p)
        pos = CAD_Repo.AppendStr(buf, pos, ",\"act\":")
        pos = CAD_Repo.AppendInt(buf, pos, act)
        pos = CAD_Repo.AppendStr(buf, pos, ",\"skpl\":")
        pos = CAD_Repo.AppendInt(buf, pos, skpl)
        pos = CAD_Repo.AppendStr(buf, pos, ",\"n\":")
        pos = CAD_Repo.AppendInt(buf, pos, CadApp.plane_n)
        pos = CAD_Repo.AppendStr(buf, pos, ",\"planes\":[\n")
        i = 0
        WhileLoop LessThan(i, CadApp.plane_n) {
            pl = ArrayGet(CadApp.plane_list, i)
            pos = CAD_Plane.ExportLine(pl, buf, pos)
            i = Add(i, 1)
        }
        pos = CAD_Repo.AppendStr(buf, pos, "]}\n")
        SetByte(buf, pos, 0)
        ReturnValue(pos)
    }
}

Function.CA_ScanKeyInt {
    Input: buf: Address
    Input: key: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        kn = 0
        WhileLoop NotEqual(GetByte(key, kn), 0) {
            kn = Add(kn, 1)
        }
        i = 0
        WhileLoop NotEqual(GetByte(buf, i), 0) {
            m = 1
            k = 0
            WhileLoop LessThan(k, kn) {
                IfCondition NotEqual(GetByte(buf, Add(i, k)), GetByte(key, k)) ThenBlock: {
                    m = 0
                    k = kn
                }
                IfCondition EqualTo(m, 1) ThenBlock: { k = Add(k, 1) }
            }
            IfCondition EqualTo(m, 1) ThenBlock: {
                tmp = Allocate(16)
                j = CAD_Plane.ParseDec(buf, Add(i, kn), tmp)
                v = 0
                IfCondition GreaterThan(j, 0) ThenBlock: { v = ArrayGet(tmp, 0) }
                Deallocate(tmp, 16)
                ReturnValue(v)
            }
            i = Add(i, 1)
            IfCondition GreaterThan(i, 4096) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(0)
    }
}

Function.CA_ParsePlaneTree {
    Input: buf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(-1) }
        CadApp.plane_n = 0
        CadApp.plane = 0
        CadApp.sk0_plane = 0
        IfCondition EqualTo(CadApp.plane_list, 0) ThenBlock: {
            CadApp.plane_list = Allocate(128)
        }
        want = CA_ScanKeyInt(buf, "\"n\":")
        sk0p = CA_ScanKeyInt(buf, "\"sk0\":")
        act = CA_ScanKeyInt(buf, "\"act\":")
        skpl = CA_ScanKeyInt(buf, "\"skpl\":")
        i = 0
        found = 0
        WhileLoop EqualTo(found, 0) {
            IfCondition EqualTo(GetByte(buf, i), 0) ThenBlock: { found = 2 }
            IfCondition EqualTo(GetByte(buf, i), 80) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, Add(i, 1)), 32) ThenBlock: { found = 1 }
            }
            IfCondition EqualTo(found, 0) ThenBlock: { i = Add(i, 1) }
            IfCondition GreaterThan(i, 8192) ThenBlock: { found = 2 }
        }
        IfCondition NotEqual(found, 1) ThenBlock: {
            CA_EnsurePlane()
            ReturnValue(-2)
        }
        ngot = 0
        outh = Allocate(16)
        done = 0
        WhileLoop EqualTo(done, 0) {
            i = CAD_Plane.SkipSp(buf, i)
            IfCondition NotEqual(GetByte(buf, i), 80) ThenBlock: { done = 1 }
            IfCondition EqualTo(done, 0) ThenBlock: {
                ni = CAD_Plane.ParseLine(buf, i, outh)
                IfCondition LessThan(ni, 0) ThenBlock: { done = 1 }
                IfCondition GreaterEqual(ni, 0) ThenBlock: {
                    pl = ArrayGet(outh, 0)
                    CA_PlaneRegister(pl)
                    ngot = Add(ngot, 1)
                    i = ni
                    IfCondition GreaterEqual(ngot, 16) ThenBlock: { done = 1 }
                }
            }
        }
        Deallocate(outh, 16)
        // remap parent pid → handle
        j = 0
        WhileLoop LessThan(j, CadApp.plane_n) {
            pl = ArrayGet(CadApp.plane_list, j)
            ppid = CAD_Store.Read(pl, 17)
            IfCondition NotEqual(ppid, 0) ThenBlock: {
                ph = CA_PlaneByPid(ppid)
                CAD_Plane.SetParent(pl, ph)
            }
            j = Add(j, 1)
        }
        CadApp.sk0_plane = CA_PlaneByPid(sk0p)
        IfCondition EqualTo(CadApp.sk0_plane, 0) ThenBlock: {
            IfCondition GreaterThan(CadApp.plane_n, 0) ThenBlock: {
                CadApp.sk0_plane = ArrayGet(CadApp.plane_list, 0)
            }
        }
        CadApp.plane = CA_PlaneByPid(act)
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: {
            CadApp.plane = CadApp.sk0_plane
        }
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            sph = CA_PlaneByPid(skpl)
            IfCondition EqualTo(sph, 0) ThenBlock: { sph = CadApp.plane }
            CAD_Sketch.SetPlaneId(CadApp.sketch, sph)
        }
        CA_RegenPlaneTree()
        PrintMessage("cad_app: plane_tree n=")
        PrintNumber(ngot)
        PrintMessage(" sk0=")
        PrintNumber(CAD_Plane.GetPid(CadApp.sk0_plane))
        PrintMessage(" pl=")
        PrintNumber(CAD_Plane.GetPid(CadApp.plane))
        PrintMessage("\n")
        ReturnValue(0)
    }
}

Function.CA_FormatFaceMap {
    Input: buf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        nf = 0
        i = 0
        WhileLoop LessThan(i, CadApp.plane_n) {
            pl = ArrayGet(CadApp.plane_list, i)
            IfCondition EqualTo(CAD_Plane.GetMode(pl), 3) ThenBlock: {
                nf = Add(nf, 1)
            }
            i = Add(i, 1)
        }
        pos = 0
        pos = CAD_Repo.AppendStr(buf, pos, "{\"v\":1,\"fmt\":\"FM1\",\"n\":")
        pos = CAD_Repo.AppendInt(buf, pos, nf)
        pos = CAD_Repo.AppendStr(buf, pos, ",\"faces\":[\n")
        i = 0
        WhileLoop LessThan(i, CadApp.plane_n) {
            pl = ArrayGet(CadApp.plane_list, i)
            IfCondition EqualTo(CAD_Plane.GetMode(pl), 3) ThenBlock: {
                SetByte(buf, pos, 70)
                pos = Add(pos, 1)
                SetByte(buf, pos, 32)
                pos = Add(pos, 1)
                pos = CAD_Plane.AppendDec(buf, pos, CAD_Plane.GetPid(pl))
                sl = 20
                WhileLoop LessEqual(sl, 25) {
                    SetByte(buf, pos, 32)
                    pos = Add(pos, 1)
                    pos = CAD_Plane.AppendHex64(buf, pos, CAD_Store.Read(pl, sl))
                    sl = Add(sl, 1)
                }
                SetByte(buf, pos, 10)
                pos = Add(pos, 1)
            }
            i = Add(i, 1)
        }
        pos = CAD_Repo.AppendStr(buf, pos, "]}\n")
        SetByte(buf, pos, 0)
        ReturnValue(pos)
    }
}

Function.CA_ParseFaceMap {
    Input: buf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        found = 0
        WhileLoop EqualTo(found, 0) {
            IfCondition EqualTo(GetByte(buf, i), 0) ThenBlock: { found = 2 }
            IfCondition EqualTo(GetByte(buf, i), 70) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, Add(i, 1)), 32) ThenBlock: { found = 1 }
            }
            IfCondition EqualTo(found, 0) ThenBlock: { i = Add(i, 1) }
            IfCondition GreaterThan(i, 4096) ThenBlock: { found = 2 }
        }
        IfCondition NotEqual(found, 1) ThenBlock: { ReturnValue(0) }
        n = 0
        tmp = Allocate(16)
        done = 0
        WhileLoop EqualTo(done, 0) {
            i = CAD_Plane.SkipSp(buf, i)
            IfCondition NotEqual(GetByte(buf, i), 70) ThenBlock: { done = 1 }
            IfCondition EqualTo(done, 0) ThenBlock: {
                i = Add(i, 1)
                i = CAD_Plane.ParseDec(buf, i, tmp)
                IfCondition LessThan(i, 0) ThenBlock: { done = 1 }
                IfCondition GreaterEqual(i, 0) ThenBlock: {
                    pid = ArrayGet(tmp, 0)
                    pl = CA_PlaneByPid(pid)
                    sl = 20
                    WhileLoop LessEqual(sl, 25) {
                        i = CAD_Plane.ParseHex(buf, i, tmp)
                        IfCondition NotEqual(pl, 0) ThenBlock: {
                            CAD_Store.Write(pl, sl, ArrayGet(tmp, 0))
                        }
                        sl = Add(sl, 1)
                    }
                    IfCondition NotEqual(pl, 0) ThenBlock: {
                        fl = CAD_Store.Read(pl, 18)
                        CAD_Store.Write(pl, 18, BitwiseOr(fl, 1))
                    }
                    n = Add(n, 1)
                }
            }
        }
        Deallocate(tmp, 16)
        ReturnValue(n)
    }
}

// Revolve lives in Solid.ailang (CA_RevolveFromSketch).
// User clicks a sketch line for the axis; lathe stays in the sketch plane.

// -------------------------------------------------------------------------
// Construction-plane picking: face / existing plane / origin / through 3pt
// -------------------------------------------------------------------------

Function.CA_PlaneClearPick {
    Output: Integer
    Body: {
        CadApp.plane_pick = 0
        CadApp.hover_plane = 0
        CadApp.pln_ptn = 0
        ReturnValue(0)
    }
}

Function.CA_PlaneBeginPick {
    Output: Integer
    Body: {
        CA_EnsurePlane()
        CadApp.plane_pick = 1
        CadApp.face_pick = 0
        CadApp.hover_face = 0
        CadApp.hover_plane = 0
        CadApp.mode = 0
        CadApp.nclick = 0
        CadApp.show_planes = 1
        CA_Log("cad_app: Pick Plane - click a construction plane (or tree row)\n", 62)
        ReturnValue(0)
    }
}

Function.CA_PlaneBeginFromFace {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_Log("cad_app: From Face needs a solid (pad first)\n", 45)
            ReturnValue(-1)
        }
        CadApp.plane_pick = 2
        CadApp.face_pick = 0
        CadApp.hover_face = 0
        CadApp.mode = 0
        CadApp.nclick = 0
        CadApp.show_planes = 1
        CA_PickBufs()
        CA_Log("cad_app: From Face - click a planar face (plane only, no sketch)\n", 64)
        ReturnValue(0)
    }
}

Function.CA_PlaneBeginOrigin {
    Output: Integer
    Body: {
        CA_EnsurePlane()
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: {
            CA_Log("cad_app: Origin needs an active plane\n", 38)
            ReturnValue(-1)
        }
        CadApp.plane_pick = 3
        CadApp.face_pick = 0
        CadApp.mode = 0
        CadApp.nclick = 0
        CadApp.show_planes = 1
        CA_Log("cad_app: Origin - click a vertex or point on the plane\n", 55)
        ReturnValue(0)
    }
}

Function.CA_PlaneBegin3Pt {
    Output: Integer
    Body: {
        CA_EnsurePlane()
        CadApp.plane_pick = 4
        CadApp.face_pick = 0
        CadApp.mode = 0
        CadApp.nclick = 0
        CadApp.pln_ptn = 0
        IfCondition EqualTo(CadApp.pln_xyz, 0) ThenBlock: {
            CadApp.pln_xyz = Allocate(96)
        }
        CadApp.show_planes = 1
        CA_Log("cad_app: Through 3 pts - click three points\n", 44)
        ReturnValue(0)
    }
}

Function.CA_PlaneActivateHandle {
    Input: pl: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(pl, 0) ThenBlock: { ReturnValue(-1) }
        CadApp.plane = pl
        CAD_Plane.EnsurePid(pl)
        CA_PlaneRegister(pl)
        CadApp.mode = 0
        CadApp.show_planes = 1
        CA_PlaneClearPick()
        PrintMessage("cad_app: active plane pid=")
        PrintNumber(CAD_Plane.GetPid(pl))
        PrintMessage("\n")
        ReturnValue(0)
    }
}

Function.CA_PlaneActivateIdx {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(idx, CadApp.plane_n) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.plane_list, 0) ThenBlock: { ReturnValue(-1) }
        pl = ArrayGet(CadApp.plane_list, idx)
        ReturnValue(CA_PlaneActivateHandle(pl))
    }
}

// New construction plane from a planar face. Does NOT start a sketch.
Function.CA_PlaneFromFace {
    Input: face_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_Log("cad_app: From Face needs solid\n", 31)
            ReturnValue(-1)
        }
        IfCondition EqualTo(face_handle, 0) ThenBlock: {
            CA_Log("cad_app: From Face needs face\n", 30)
            ReturnValue(-2)
        }
        CA_EnsurePlane()
        CadApp.pick_best_f = CadApp.plane
        IfCondition EqualTo(CadApp.pick_best_f, 0) ThenBlock: {
            CadApp.pick_best_f = CadApp.sk0_plane
        }
        CadApp.last_face = face_handle
        pl = CAD_Plane.CreateFromFace(CadApp.last_face, CadApp.solid)
        IfCondition EqualTo(pl, 0) ThenBlock: {
            CA_Log("cad_app: plane FAIL (need planar face)\n", 39)
            ReturnValue(-2)
        }
        CadApp.plane = pl
        CAD_Plane.SetParent(CadApp.plane, CadApp.pick_best_f)
        CAD_Plane.EnsurePid(CadApp.plane)
        CA_FacePlaneFromVerts(CadApp.last_face)
        fr = Allocate(128)
        CAD_Plane.FrameFromFacePlane(CadAppPick.pl, fr)
        CAD_Plane.WriteCacheFromFrame(CadApp.plane, fr)
        CA_OrientPlaneOutward(CadApp.last_face, CadApp.solid)
        fl = CAD_Store.Read(CadApp.plane, 18)
        CAD_Store.Write(CadApp.plane, 18, BitwiseOr(fl, 4))
        Deallocate(fr, 128)
        CA_PlaneRegister(CadApp.plane)
        CadApp.mode = 0
        CadApp.show_planes = 1
        CA_PlaneClearPick()
        CA_LookAlongActivePlane()
        PrintMessage("cad_app: plane from face pid=")
        PrintNumber(CAD_Plane.GetPid(CadApp.plane))
        PrintMessage(" (Sketch on Plane to draw)\n")
        ReturnValue(0)
    }
}

// View-ray at pixel into CadAppPick.wx/d* (same basis as face pick).
Function.CA_RaySetup {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        CA_PickBufs()
        IfCondition EqualTo(CadAppPick.fr, 0) ThenBlock: { ReturnValue(-1) }
        CA_BuildViewFrame(CadAppPick.fr)
        CA_CamBasis()
        cx = ArrayGet(CadAppPick.fr, 0)
        cy = ArrayGet(CadAppPick.fr, 1)
        cz = ArrayGet(CadAppPick.fr, 2)
        sc = ArrayGet(CadAppPick.fr, 3)
        hw = ArrayGet(CadAppPick.fr, 4)
        hh = ArrayGet(CadAppPick.fr, 5)
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: { ReturnValue(-1) }
        uu = Float_Sub(Float_Div(Float_Sub(Float_FromInt(px), hw), sc), CAD_View_State.pan_u)
        vv = Float_Sub(Float_Div(Float_Sub(hh, Float_FromInt(py)), sc), CAD_View_State.pan_v)
        CadAppPick.wx = Float_Add(cx, Float_Add(Float_Mul(uu, CadAppPick.rx), Float_Mul(vv, CadAppPick.ux)))
        CadAppPick.wy = Float_Add(cy, Float_Add(Float_Mul(uu, CadAppPick.ry), Float_Mul(vv, CadAppPick.uy)))
        CadAppPick.wz = Float_Add(cz, Float_Add(Float_Mul(uu, CadAppPick.rz), Float_Mul(vv, CadAppPick.uz)))
        CadAppPick.dx = Float_Sub(0, CadAppPick.cdx)
        CadAppPick.dy = Float_Sub(0, CadAppPick.cdy)
        CadAppPick.dz = Float_Sub(0, CadAppPick.cdz)
        ReturnValue(0)
    }
}

// Front-most registered construction plane under the pixel (drawn square / face).
Function.CA_PickPlaneAt {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.plane_n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.plane_list, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CA_RaySetup(px, py), 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.best_f = 0
        CadAppPick.best_t = 0x42C1D206A0000000
        CadAppPick.hu = Float_FromInt(40)
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, CadApp.plane_n) {
            CadApp.pick_best_f = ArrayGet(CadApp.plane_list, CadAppPick.pi)
            IfCondition NotEqual(CadApp.pick_best_f, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Plane.EvalFrame(CadApp.pick_best_f, CadAppPick.pl), 0) ThenBlock: {
                    CadAppPick.ox = ArrayGet(CadAppPick.pl, 0)
                    CadAppPick.oy = ArrayGet(CadAppPick.pl, 1)
                    CadAppPick.oz = ArrayGet(CadAppPick.pl, 2)
                    CadAppPick.nx = ArrayGet(CadAppPick.pl, 9)
                    CadAppPick.ny = ArrayGet(CadAppPick.pl, 10)
                    CadAppPick.nz = ArrayGet(CadAppPick.pl, 11)
                    CadAppPick.hv = Float_Add(Float_Add(Float_Mul(CadAppPick.dx, CadAppPick.nx), Float_Mul(CadAppPick.dy, CadAppPick.ny)), Float_Mul(CadAppPick.dz, CadAppPick.nz))
                    IfCondition EqualTo(CAD_Num.IsZero(CadAppPick.hv, 0), 0) ThenBlock: {
                        CadAppPick.last_t = Float_Div(Float_Add(Float_Add(Float_Mul(Float_Sub(CadAppPick.ox, CadAppPick.wx), CadAppPick.nx), Float_Mul(Float_Sub(CadAppPick.oy, CadAppPick.wy), CadAppPick.ny)), Float_Mul(Float_Sub(CadAppPick.oz, CadAppPick.wz), CadAppPick.nz)), CadAppPick.hv)
                        ArraySet(CadAppPick.hit, 0, Float_Add(CadAppPick.wx, Float_Mul(CadAppPick.last_t, CadAppPick.dx)))
                        ArraySet(CadAppPick.hit, 1, Float_Add(CadAppPick.wy, Float_Mul(CadAppPick.last_t, CadAppPick.dy)))
                        ArraySet(CadAppPick.hit, 2, Float_Add(CadAppPick.wz, Float_Mul(CadAppPick.last_t, CadAppPick.dz)))
                        CadAppPick.pins = 0
                        IfCondition EqualTo(CAD_Plane.GetMode(CadApp.pick_best_f), 3) ThenBlock: {
                            CadAppPick.face = CAD_Plane.GetFaceHandle(CadApp.pick_best_f)
                            IfCondition NotEqual(CadAppPick.face, 0) ThenBlock: {
                                CadAppPick.pins = CA_FaceContainsHit(CadAppPick.face)
                            }
                        }
                        IfCondition EqualTo(CadAppPick.pins, 0) ThenBlock: {
                            CadAppPick.ax = Float_Add(Float_Add(Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 0), CadAppPick.ox), ArrayGet(CadAppPick.pl, 3)), Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 1), CadAppPick.oy), ArrayGet(CadAppPick.pl, 4))), Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 2), CadAppPick.oz), ArrayGet(CadAppPick.pl, 5)))
                            CadAppPick.ay = Float_Add(Float_Add(Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 0), CadAppPick.ox), ArrayGet(CadAppPick.pl, 6)), Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 1), CadAppPick.oy), ArrayGet(CadAppPick.pl, 7))), Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 2), CadAppPick.oz), ArrayGet(CadAppPick.pl, 8)))
                            IfCondition EqualTo(CAD_Num.Le(CadAppPick.ax, CadAppPick.hu), 1) ThenBlock: {
                                IfCondition EqualTo(CAD_Num.Le(Float_Sub(0, CadAppPick.ax), CadAppPick.hu), 1) ThenBlock: {
                                    IfCondition EqualTo(CAD_Num.Le(CadAppPick.ay, CadAppPick.hu), 1) ThenBlock: {
                                        IfCondition EqualTo(CAD_Num.Le(Float_Sub(0, CadAppPick.ay), CadAppPick.hu), 1) ThenBlock: {
                                            CadAppPick.pins = 1
                                        }
                                    }
                                }
                            }
                        }
                        IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CadAppPick.last_t, CadAppPick.best_t)), 1) ThenBlock: {
                                CadAppPick.best_t = CadAppPick.last_t
                                CadAppPick.best_f = CadApp.pick_best_f
                            }
                        }
                    }
                }
            }
            CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        ReturnValue(CadAppPick.best_f)
    }
}

// Snap CadAppPick.hit to the nearest vertex of fh if within 4 mm.
Function.CA_SnapHitToVertex {
    Input: fh: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(fh, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.face = fh
        CadAppPick.hd = 0
        lp = CAD_Store.Read(CadAppPick.face, 1)
        IfCondition EqualTo(lp, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.hd = CAD_Store.Read(lp, 0)
        IfCondition EqualTo(CadAppPick.hd, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ce = CadAppPick.hd
        CadAppPick.hv = Float_FromInt(16)
        CadAppPick.pins = 0
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, 256) {
            CadAppPick.ov = CAD_Store.Read(CadAppPick.ce, 5)
            IfCondition NotEqual(CadAppPick.ov, 0) ThenBlock: {
                CadAppPick.ax = Float_Sub(CAD_Store.Read(CadAppPick.ov, 0), ArrayGet(CadAppPick.hit, 0))
                CadAppPick.ay = Float_Sub(CAD_Store.Read(CadAppPick.ov, 1), ArrayGet(CadAppPick.hit, 1))
                CadAppPick.bx = Float_Sub(CAD_Store.Read(CadAppPick.ov, 2), ArrayGet(CadAppPick.hit, 2))
                CadAppPick.last_t = Float_Add(Float_Add(Float_Mul(CadAppPick.ax, CadAppPick.ax), Float_Mul(CadAppPick.ay, CadAppPick.ay)), Float_Mul(CadAppPick.bx, CadAppPick.bx))
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CadAppPick.last_t, CadAppPick.hv)), 1) ThenBlock: {
                    CadAppPick.hv = CadAppPick.last_t
                    CadAppPick.ox = CAD_Store.Read(CadAppPick.ov, 0)
                    CadAppPick.oy = CAD_Store.Read(CadAppPick.ov, 1)
                    CadAppPick.oz = CAD_Store.Read(CadAppPick.ov, 2)
                    CadAppPick.pins = 1
                }
            }
            CadAppPick.ce = CAD_Store.Read(CadAppPick.ce, 2)
            CadAppPick.pi = Add(CadAppPick.pi, 1)
            IfCondition EqualTo(CadAppPick.ce, CadAppPick.hd) ThenBlock: { CadAppPick.pi = 256 }
            IfCondition EqualTo(CadAppPick.ce, 0) ThenBlock: { CadAppPick.pi = 256 }
        }
        IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: {
            ArraySet(CadAppPick.hit, 0, CadAppPick.ox)
            ArraySet(CadAppPick.hit, 1, CadAppPick.oy)
            ArraySet(CadAppPick.hit, 2, CadAppPick.oz)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// World hit at pixel: face (vertex-snapped) else active/world plane. 1 = ok.
Function.CA_PickWorldAt {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
            CadAppPick.quiet = 1
            fh = CA_PickFaceAt(px, py)
            CadAppPick.quiet = 0
            IfCondition NotEqual(fh, 0) ThenBlock: {
                CA_SnapHitToVertex(fh)
                ReturnValue(1)
            }
        }
        IfCondition NotEqual(CA_RaySetup(px, py), 0) ThenBlock: { ReturnValue(0) }
        pl = CadApp.plane
        IfCondition EqualTo(pl, 0) ThenBlock: { pl = CadApp.sk0_plane }
        IfCondition NotEqual(pl, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Plane.EvalFrame(pl, CadAppPick.pl), 0) ThenBlock: {
                CadAppPick.ox = ArrayGet(CadAppPick.pl, 0)
                CadAppPick.oy = ArrayGet(CadAppPick.pl, 1)
                CadAppPick.oz = ArrayGet(CadAppPick.pl, 2)
                CadAppPick.nx = ArrayGet(CadAppPick.pl, 9)
                CadAppPick.ny = ArrayGet(CadAppPick.pl, 10)
                CadAppPick.nz = ArrayGet(CadAppPick.pl, 11)
                den = Float_Add(Float_Add(Float_Mul(CadAppPick.dx, CadAppPick.nx), Float_Mul(CadAppPick.dy, CadAppPick.ny)), Float_Mul(CadAppPick.dz, CadAppPick.nz))
                IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                    CadAppPick.last_t = Float_Div(Float_Add(Float_Add(Float_Mul(Float_Sub(CadAppPick.ox, CadAppPick.wx), CadAppPick.nx), Float_Mul(Float_Sub(CadAppPick.oy, CadAppPick.wy), CadAppPick.ny)), Float_Mul(Float_Sub(CadAppPick.oz, CadAppPick.wz), CadAppPick.nz)), den)
                    ArraySet(CadAppPick.hit, 0, Float_Add(CadAppPick.wx, Float_Mul(CadAppPick.last_t, CadAppPick.dx)))
                    ArraySet(CadAppPick.hit, 1, Float_Add(CadAppPick.wy, Float_Mul(CadAppPick.last_t, CadAppPick.dy)))
                    ArraySet(CadAppPick.hit, 2, Float_Add(CadAppPick.wz, Float_Mul(CadAppPick.last_t, CadAppPick.dz)))
                    ReturnValue(1)
                }
            }
        }
        ReturnValue(0)
    }
}

Function.CA_PlaneSetOriginAtHit {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadAppPick.hit, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(CAD_Plane.EvalFrame(CadApp.plane, CadAppPick.pl), 0) ThenBlock: {
            ReturnValue(-1)
        }
        CadAppPick.ox = ArrayGet(CadAppPick.pl, 0)
        CadAppPick.oy = ArrayGet(CadAppPick.pl, 1)
        CadAppPick.oz = ArrayGet(CadAppPick.pl, 2)
        CadAppPick.ax = Float_Add(Float_Add(Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 0), CadAppPick.ox), ArrayGet(CadAppPick.pl, 3)), Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 1), CadAppPick.oy), ArrayGet(CadAppPick.pl, 4))), Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 2), CadAppPick.oz), ArrayGet(CadAppPick.pl, 5)))
        CadAppPick.ay = Float_Add(Float_Add(Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 0), CadAppPick.ox), ArrayGet(CadAppPick.pl, 6)), Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 1), CadAppPick.oy), ArrayGet(CadAppPick.pl, 7))), Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 2), CadAppPick.oz), ArrayGet(CadAppPick.pl, 8)))
        CAD_Plane.TranslateLocal(CadApp.plane, CadAppPick.ax, CadAppPick.ay, 0)
        CadApp.show_planes = 1
        CA_Log("cad_app: plane origin set (projected click / vertex)\n", 53)
        ReturnValue(0)
    }
}

Function.CA_PlaneCommit3Pt {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.pln_xyz, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(CadApp.pln_ptn, 3) ThenBlock: { ReturnValue(-1) }
        CadAppPick.ox = ArrayGet(CadApp.pln_xyz, 0)
        CadAppPick.oy = ArrayGet(CadApp.pln_xyz, 1)
        CadAppPick.oz = ArrayGet(CadApp.pln_xyz, 2)
        CadAppPick.dx = Float_Sub(ArrayGet(CadApp.pln_xyz, 3), CadAppPick.ox)
        CadAppPick.dy = Float_Sub(ArrayGet(CadApp.pln_xyz, 4), CadAppPick.oy)
        CadAppPick.dz = Float_Sub(ArrayGet(CadApp.pln_xyz, 5), CadAppPick.oz)
        CadAppPick.rx = Float_Sub(ArrayGet(CadApp.pln_xyz, 6), CadAppPick.ox)
        CadAppPick.ry = Float_Sub(ArrayGet(CadApp.pln_xyz, 7), CadAppPick.oy)
        CadAppPick.rz = Float_Sub(ArrayGet(CadApp.pln_xyz, 8), CadAppPick.oz)
        CadAppPick.nx = Float_Sub(Float_Mul(CadAppPick.dy, CadAppPick.rz), Float_Mul(CadAppPick.dz, CadAppPick.ry))
        CadAppPick.ny = Float_Sub(Float_Mul(CadAppPick.dz, CadAppPick.rx), Float_Mul(CadAppPick.dx, CadAppPick.rz))
        CadAppPick.nz = Float_Sub(Float_Mul(CadAppPick.dx, CadAppPick.ry), Float_Mul(CadAppPick.dy, CadAppPick.rx))
        CadAppPick.hv = Float_Add(Float_Add(Float_Mul(CadAppPick.nx, CadAppPick.nx), Float_Mul(CadAppPick.ny, CadAppPick.ny)), Float_Mul(CadAppPick.nz, CadAppPick.nz))
        IfCondition EqualTo(CAD_Num.IsZero(CadAppPick.hv, 0), 1) ThenBlock: {
            CA_Log("cad_app: 3pt plane FAIL (colinear)\n", 35)
            CadApp.pln_ptn = 0
            ReturnValue(-2)
        }
        CadAppPick.last_t = CAD_Num.Sqrt(CadAppPick.hv)
        IfCondition EqualTo(CAD_Num.IsZero(CadAppPick.last_t, 0), 1) ThenBlock: {
            CA_Log("cad_app: 3pt plane FAIL (normal)\n", 33)
            CadApp.pln_ptn = 0
            ReturnValue(-2)
        }
        CadAppPick.nx = Float_Div(CadAppPick.nx, CadAppPick.last_t)
        CadAppPick.ny = Float_Div(CadAppPick.ny, CadAppPick.last_t)
        CadAppPick.nz = Float_Div(CadAppPick.nz, CadAppPick.last_t)
        CadAppPick.hv = Float_Add(Float_Add(Float_Mul(CadAppPick.dx, CadAppPick.dx), Float_Mul(CadAppPick.dy, CadAppPick.dy)), Float_Mul(CadAppPick.dz, CadAppPick.dz))
        IfCondition EqualTo(CAD_Num.IsZero(CadAppPick.hv, 0), 1) ThenBlock: {
            CA_Log("cad_app: 3pt plane FAIL (edge)\n", 31)
            CadApp.pln_ptn = 0
            ReturnValue(-2)
        }
        CadAppPick.last_t = CAD_Num.Sqrt(CadAppPick.hv)
        CadAppPick.dx = Float_Div(CadAppPick.dx, CadAppPick.last_t)
        CadAppPick.dy = Float_Div(CadAppPick.dy, CadAppPick.last_t)
        CadAppPick.dz = Float_Div(CadAppPick.dz, CadAppPick.last_t)
        // Y = N × X
        CadAppPick.ux = Float_Sub(Float_Mul(CadAppPick.ny, CadAppPick.dz), Float_Mul(CadAppPick.nz, CadAppPick.dy))
        CadAppPick.uy = Float_Sub(Float_Mul(CadAppPick.nz, CadAppPick.dx), Float_Mul(CadAppPick.nx, CadAppPick.dz))
        CadAppPick.uz = Float_Sub(Float_Mul(CadAppPick.nx, CadAppPick.dy), Float_Mul(CadAppPick.ny, CadAppPick.dx))
        fr = Allocate(128)
        ArraySet(fr, 0, CadAppPick.ox)
        ArraySet(fr, 1, CadAppPick.oy)
        ArraySet(fr, 2, CadAppPick.oz)
        ArraySet(fr, 3, CadAppPick.dx)
        ArraySet(fr, 4, CadAppPick.dy)
        ArraySet(fr, 5, CadAppPick.dz)
        ArraySet(fr, 6, CadAppPick.ux)
        ArraySet(fr, 7, CadAppPick.uy)
        ArraySet(fr, 8, CadAppPick.uz)
        ArraySet(fr, 9, CadAppPick.nx)
        ArraySet(fr, 10, CadAppPick.ny)
        ArraySet(fr, 11, CadAppPick.nz)
        CA_EnsurePlane()
        CadApp.pick_best_f = CadApp.sk0_plane
        pl = CAD_Plane.CreateFromFrame(fr)
        Deallocate(fr, 128)
        IfCondition EqualTo(pl, 0) ThenBlock: {
            CA_Log("cad_app: 3pt plane FAIL (alloc)\n", 32)
            ReturnValue(-2)
        }
        CadApp.plane = pl
        CAD_Plane.SetParent(CadApp.plane, CadApp.pick_best_f)
        CAD_Plane.EnsurePid(CadApp.plane)
        CA_PlaneRegister(CadApp.plane)
        CadApp.mode = 0
        CadApp.show_planes = 1
        CA_PlaneClearPick()
        CA_LookAlongActivePlane()
        PrintMessage("cad_app: plane through 3 pts pid=")
        PrintNumber(CAD_Plane.GetPid(CadApp.plane))
        PrintMessage("\n")
        ReturnValue(0)
    }
}

// Dispatch a 3D click while a construction-plane gesture is armed.
Function.CA_PlanePickClick {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.plane_pick, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.plane_pick, 1) ThenBlock: {
            pl = CA_PickPlaneAt(px, py)
            IfCondition EqualTo(pl, 0) ThenBlock: {
                CA_Log("cad_app: plane miss - click a cyan square or tree Plane row\n", 60)
                ReturnValue(1)
            }
            CA_PlaneActivateHandle(pl)
            CA_LookAlongActivePlane()
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.plane_pick, 2) ThenBlock: {
            IfCondition NotEqual(CadApp.click_shift, 0) ThenBlock: {
                CadApp.hover_face = CA_PickFaceNext(px, py, CadApp.hover_face)
                CadApp.click_shift = 0
                ReturnValue(1)
            }
            fh = CA_PickFaceAt(px, py)
            IfCondition EqualTo(fh, 0) ThenBlock: { fh = CadApp.hover_face }
            IfCondition EqualTo(fh, 0) ThenBlock: {
                CA_Log("cad_app: face miss - orbit and click the solid\n", 47)
                ReturnValue(1)
            }
            CA_PlaneFromFace(fh)
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.plane_pick, 3) ThenBlock: {
            IfCondition EqualTo(CA_PickWorldAt(px, py), 0) ThenBlock: {
                CA_Log("cad_app: origin miss - click a face or the plane\n", 50)
                ReturnValue(1)
            }
            CA_PlaneSetOriginAtHit()
            CA_PlaneClearPick()
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.plane_pick, 4) ThenBlock: {
            IfCondition EqualTo(CadApp.pln_xyz, 0) ThenBlock: {
                CadApp.pln_xyz = Allocate(96)
            }
            IfCondition EqualTo(CA_PickWorldAt(px, py), 0) ThenBlock: {
                CA_Log("cad_app: 3pt miss - click a face, vertex, or plane\n", 51)
                ReturnValue(1)
            }
            b = Multiply(CadApp.pln_ptn, 3)
            ArraySet(CadApp.pln_xyz, b, ArrayGet(CadAppPick.hit, 0))
            ArraySet(CadApp.pln_xyz, Add(b, 1), ArrayGet(CadAppPick.hit, 1))
            ArraySet(CadApp.pln_xyz, Add(b, 2), ArrayGet(CadAppPick.hit, 2))
            CadApp.pln_ptn = Add(CadApp.pln_ptn, 1)
            CA_LogInt("cad_app: 3pt point ", 19, CadApp.pln_ptn)
            IfCondition GreaterEqual(CadApp.pln_ptn, 3) ThenBlock: {
                CA_PlaneCommit3Pt()
            }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

