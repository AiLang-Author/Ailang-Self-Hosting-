LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_Bool
LibraryImport.Display.Render.Framebuffer
LibraryImport.StringUtils

Function.CA_ImportFaceRefs {
    Input: face_handle: Integer
    Output: Integer
    Body: {
        CadApp.n_face_ref = 0
        CadApp.proj_n = 0
        IfCondition EqualTo(face_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.proj_xy, 0) ThenBlock: { CadApp.proj_xy = Allocate(1024) }
        CA_PickBufs()
        IfCondition EqualTo(CadAppPick.pl, 0) ThenBlock: { ReturnValue(0) }
        CAD_Plane.EvalFrame(CadApp.plane, CadAppPick.pl)
        CadAppPick.ox = ArrayGet(CadAppPick.pl, 0)
        CadAppPick.oy = ArrayGet(CadAppPick.pl, 1)
        CadAppPick.oz = ArrayGet(CadAppPick.pl, 2)
        CadAppPick.dx = ArrayGet(CadAppPick.pl, 3)
        CadAppPick.dy = ArrayGet(CadAppPick.pl, 4)
        CadAppPick.dz = ArrayGet(CadAppPick.pl, 5)
        CadAppPick.rx = ArrayGet(CadAppPick.pl, 6)
        CadAppPick.ry = ArrayGet(CadAppPick.pl, 7)
        CadAppPick.rz = ArrayGet(CadAppPick.pl, 8)
        lp = CAD_Store.Read(face_handle, 1)
        IfCondition EqualTo(lp, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.hd = CAD_Store.Read(lp, 0)
        IfCondition EqualTo(CadAppPick.hd, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ce = CadAppPick.hd
        nuniq = 0
        cguard = 0
        WhileLoop LessThan(cguard, 256) {
            ce = CadAppPick.ce
            CadAppPick.ov = CAD_Store.Read(ce, 5)
            IfCondition NotEqual(CadAppPick.ov, 0) ThenBlock: {
                CadAppPick.wx = CAD_Store.Read(CadAppPick.ov, 0)
                CadAppPick.wy = CAD_Store.Read(CadAppPick.ov, 1)
                CadAppPick.wz = CAD_Store.Read(CadAppPick.ov, 2)
                CadAppPick.ax = Float_Add(Float_Add(Float_Mul(Float_Sub(CadAppPick.wx, CadAppPick.ox), CadAppPick.dx), Float_Mul(Float_Sub(CadAppPick.wy, CadAppPick.oy), CadAppPick.dy)), Float_Mul(Float_Sub(CadAppPick.wz, CadAppPick.oz), CadAppPick.dz))
                CadAppPick.ay = Float_Add(Float_Add(Float_Mul(Float_Sub(CadAppPick.wx, CadAppPick.ox), CadAppPick.rx), Float_Mul(Float_Sub(CadAppPick.wy, CadAppPick.oy), CadAppPick.ry)), Float_Mul(Float_Sub(CadAppPick.wz, CadAppPick.oz), CadAppPick.rz))
                // unique by ~0.05 mm
                seen = 0
                k = 0
                WhileLoop LessThan(k, nuniq) {
                    du = Float_Sub(ArrayGet(CadAppPick.uv, Multiply(k, 2)), CadAppPick.ax)
                    dv = Float_Sub(ArrayGet(CadAppPick.uv, Add(Multiply(k, 2), 1)), CadAppPick.ay)
                    IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(du, du), Float_Mul(dv, dv)), 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                        seen = 1
                        k = nuniq
                    }
                    IfCondition LessThan(k, nuniq) ThenBlock: {
                        k = Add(k, 1)
                    }
                }
                IfCondition EqualTo(seen, 0) ThenBlock: {
                    IfCondition LessThan(nuniq, 64) ThenBlock: {
                        ArraySet(CadAppPick.uv, Multiply(nuniq, 2), CadAppPick.ax)
                        ArraySet(CadAppPick.uv, Add(Multiply(nuniq, 2), 1), CadAppPick.ay)
                        nuniq = Add(nuniq, 1)
                    }
                }
                // Ordered loop for dashed projection (keep consecutive, even if many)
                IfCondition NotEqual(CadApp.proj_xy, 0) ThenBlock: {
                    IfCondition LessThan(CadApp.proj_n, 64) ThenBlock: {
                        keep = 1
                        IfCondition GreaterThan(CadApp.proj_n, 0) ThenBlock: {
                            pu = ArrayGet(CadApp.proj_xy, Multiply(Subtract(CadApp.proj_n, 1), 2))
                            pv = ArrayGet(CadApp.proj_xy, Add(Multiply(Subtract(CadApp.proj_n, 1), 2), 1))
                            du = Float_Sub(CadAppPick.ax, pu)
                            dv = Float_Sub(CadAppPick.ay, pv)
                            IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(du, du), Float_Mul(dv, dv)), 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                                keep = 0
                            }
                        }
                        IfCondition EqualTo(keep, 1) ThenBlock: {
                            ArraySet(CadApp.proj_xy, Multiply(CadApp.proj_n, 2), CadAppPick.ax)
                            ArraySet(CadApp.proj_xy, Add(Multiply(CadApp.proj_n, 2), 1), CadAppPick.ay)
                            CadApp.proj_n = Add(CadApp.proj_n, 1)
                        }
                    }
                }
            }
            CadAppPick.ce = CAD_Store.Read(ce, 2)
            cguard = Add(cguard, 1)
            IfCondition EqualTo(CadAppPick.ce, CadAppPick.hd) ThenBlock: { cguard = 256 }
            IfCondition EqualTo(CadAppPick.ce, 0) ThenBlock: { cguard = 256 }
        }
        IfCondition EqualTo(nuniq, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(nuniq, 12) ThenBlock: {
            CA_Log("cad_app: face refs skip (many verts; type pt X Y)\n", 51)
            CAD_Store.Write(CadApp.sketch, 27, 0)
            ReturnValue(0)
        }
        CadAppPick.ins_i = 0
        WhileLoop LessThan(CadAppPick.ins_i, nuniq) {
            i = CadAppPick.ins_i
            CadAppPick.ax = ArrayGet(CadAppPick.uv, Multiply(i, 2))
            CadAppPick.ay = ArrayGet(CadAppPick.uv, Add(Multiply(i, 2), 1))
            CadAppPick.face = CAD_Sketch.AddUserPoint(CadApp.sketch, CadAppPick.ax, CadAppPick.ay, 0)
            IfCondition GreaterEqual(CadAppPick.face, 0) ThenBlock: {
                i = CadAppPick.ins_i
                CadAppPick.ax = ArrayGet(CadAppPick.uv, Multiply(i, 2))
                CAD_Sketch.AddConstraint(CadApp.sketch, 2, 3, CadAppPick.face, CadAppPick.ax)
                i = CadAppPick.ins_i
                CadAppPick.ay = ArrayGet(CadAppPick.uv, Add(Multiply(i, 2), 1))
                CAD_Sketch.AddConstraint(CadApp.sketch, 3, 3, CadAppPick.face, CadAppPick.ay)
            }
            CadAppPick.ins_i = Add(CadAppPick.ins_i, 1)
        }
        CadApp.n_face_ref = nuniq
        CAD_Store.Write(CadApp.sketch, 27, nuniq)
        CA_LogInt("cad_app: face refs (frozen UV verts) n=", 39, nuniq)
        CA_LogInt("cad_app: face proj edges n=", 27, CadApp.proj_n)
        ReturnValue(nuniq)
    }
}

// Pick planar B-Rep face under pixel in current 3D view. Returns face handle or 0.


// Camera basis for free-orbit ortho (same as CAD_View.ProjectPoint).
Function.CA_CamBasis {
    Output: Integer
    Body: {
        yaw = CAD_View_State.yaw_r
        pitch = CAD_View_State.pitch_r
        cyaw = CAD_Geom.Cos(yaw)
        syaw = CAD_Geom.Sin(yaw)
        cp = CAD_Geom.Cos(pitch)
        sp = CAD_Geom.Sin(pitch)
        CadAppPick.cdx = Float_Mul(cp, syaw)
        CadAppPick.cdy = Float_Mul(cp, cyaw)
        CadAppPick.cdz = sp
        rx = Float_Sub(0, CadAppPick.cdy)
        ry = CadAppPick.cdx
        rl = CAD_Num.Sqrt(Float_Add(Float_Mul(rx, rx), Float_Mul(ry, ry)))
        IfCondition EqualTo(CAD_Num.IsZero(rl, 0), 1) ThenBlock: {
            rx = 0x3FF0000000000000
            ry = 0
            rl = 0x3FF0000000000000
        }
        CadAppPick.rx = Float_Div(rx, rl)
        CadAppPick.ry = Float_Div(ry, rl)
        CadAppPick.rz = 0
        ux = Float_Sub(Float_Mul(CadAppPick.cdy, CadAppPick.rz), Float_Mul(CadAppPick.cdz, CadAppPick.ry))
        uy = Float_Sub(Float_Mul(CadAppPick.cdz, CadAppPick.rx), Float_Mul(CadAppPick.cdx, CadAppPick.rz))
        uz = Float_Sub(Float_Mul(CadAppPick.cdx, CadAppPick.ry), Float_Mul(CadAppPick.cdy, CadAppPick.rx))
        ul = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ux, ux), Float_Mul(uy, uy)), Float_Mul(uz, uz)))
        IfCondition EqualTo(CAD_Num.IsZero(ul, 0), 0) ThenBlock: {
            ux = Float_Div(ux, ul)
            uy = Float_Div(uy, ul)
            uz = Float_Div(uz, ul)
        }
        CadAppPick.ux = ux
        CadAppPick.uy = uy
        CadAppPick.uz = uz
        ReturnValue(0)
    }
}

// Fit CadAppPick.pl from live loop verts (Newell + first edge).
// Stored face planes stay at local z after Translate/Map — verts are world.
Function.CA_FacePlaneFromVerts {
    Input: face_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadAppPick.pl, 0) ThenBlock: { CadAppPick.pl = Allocate(128) }
        IfCondition EqualTo(CadAppPick.pl, 0) ThenBlock: { ReturnValue(-1) }
        CadAppPick.face = face_handle
        lp = CAD_Store.Read(CadAppPick.face, 1)
        IfCondition EqualTo(lp, 0) ThenBlock: { ReturnValue(-1) }
        CadAppPick.hd = CAD_Store.Read(lp, 0)
        IfCondition EqualTo(CadAppPick.hd, 0) ThenBlock: { ReturnValue(-1) }
        CadAppPick.ce = CadAppPick.hd
        ov = CAD_Store.Read(CadAppPick.ce, 5)
        IfCondition EqualTo(ov, 0) ThenBlock: { ReturnValue(-1) }
        CadAppPick.ox = CAD_Store.Read(ov, 0)
        CadAppPick.oy = CAD_Store.Read(ov, 1)
        CadAppPick.oz = CAD_Store.Read(ov, 2)
        nxt = CAD_Store.Read(CadAppPick.ce, 2)
        IfCondition EqualTo(nxt, 0) ThenBlock: { ReturnValue(-1) }
        ov = CAD_Store.Read(nxt, 5)
        IfCondition EqualTo(ov, 0) ThenBlock: { ReturnValue(-1) }
        CadAppPick.ax = CAD_Store.Read(ov, 0)
        CadAppPick.ay = CAD_Store.Read(ov, 1)
        CadAppPick.bx = CAD_Store.Read(ov, 2)
        CadAppPick.nx = 0
        CadAppPick.ny = 0
        CadAppPick.nz = 0
        CadAppPick.ce = CadAppPick.hd
        cguard = 0
        WhileLoop LessThan(cguard, 512) {
            ce = CadAppPick.ce
            ov = CAD_Store.Read(ce, 5)
            nxt = CAD_Store.Read(ce, 2)
            IfCondition EqualTo(ov, 0) ThenBlock: { cguard = 512 }
            IfCondition EqualTo(nxt, 0) ThenBlock: { cguard = 512 }
            IfCondition NotEqual(ov, 0) ThenBlock: {
                IfCondition NotEqual(nxt, 0) ThenBlock: {
                    ov2 = CAD_Store.Read(nxt, 5)
                    IfCondition NotEqual(ov2, 0) ThenBlock: {
                        CadAppPick.hu = CAD_Store.Read(ov, 0)
                        CadAppPick.hv = CAD_Store.Read(ov, 1)
                        CadAppPick.last_t = CAD_Store.Read(ov, 2)
                        CadAppPick.pi = CAD_Store.Read(ov2, 0)
                        CadAppPick.pj = CAD_Store.Read(ov2, 1)
                        CadAppPick.pins = CAD_Store.Read(ov2, 2)
                        CadAppPick.nx = Float_Add(CadAppPick.nx, Float_Mul(Float_Sub(CadAppPick.hv, CadAppPick.pj), Float_Add(CadAppPick.last_t, CadAppPick.pins)))
                        CadAppPick.ny = Float_Add(CadAppPick.ny, Float_Mul(Float_Sub(CadAppPick.last_t, CadAppPick.pins), Float_Add(CadAppPick.hu, CadAppPick.pi)))
                        CadAppPick.nz = Float_Add(CadAppPick.nz, Float_Mul(Float_Sub(CadAppPick.hu, CadAppPick.pi), Float_Add(CadAppPick.hv, CadAppPick.pj)))
                    }
                    CadAppPick.ce = nxt
                }
            }
            cguard = Add(cguard, 1)
            IfCondition EqualTo(CadAppPick.ce, CadAppPick.hd) ThenBlock: { cguard = 512 }
        }
        nl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CadAppPick.nx, CadAppPick.nx), Float_Mul(CadAppPick.ny, CadAppPick.ny)), Float_Mul(CadAppPick.nz, CadAppPick.nz)))
        IfCondition EqualTo(CAD_Num.IsZero(nl, 0), 1) ThenBlock: { ReturnValue(-1) }
        CadAppPick.nx = Float_Div(CadAppPick.nx, nl)
        CadAppPick.ny = Float_Div(CadAppPick.ny, nl)
        CadAppPick.nz = Float_Div(CadAppPick.nz, nl)
        // X = first edge flattened onto plane (pinned — Float_* clobbers locals)
        CadAppPick.hu = Float_Sub(CadAppPick.ax, CadAppPick.ox)
        CadAppPick.hv = Float_Sub(CadAppPick.ay, CadAppPick.oy)
        CadAppPick.last_t = Float_Sub(CadAppPick.bx, CadAppPick.oz)
        CadAppPick.pi = Float_Add(Float_Add(Float_Mul(CadAppPick.hu, CadAppPick.nx), Float_Mul(CadAppPick.hv, CadAppPick.ny)), Float_Mul(CadAppPick.last_t, CadAppPick.nz))
        CadAppPick.hu = Float_Sub(CadAppPick.hu, Float_Mul(CadAppPick.pi, CadAppPick.nx))
        CadAppPick.hv = Float_Sub(CadAppPick.hv, Float_Mul(CadAppPick.pi, CadAppPick.ny))
        CadAppPick.last_t = Float_Sub(CadAppPick.last_t, Float_Mul(CadAppPick.pi, CadAppPick.nz))
        xl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CadAppPick.hu, CadAppPick.hu), Float_Mul(CadAppPick.hv, CadAppPick.hv)), Float_Mul(CadAppPick.last_t, CadAppPick.last_t)))
        IfCondition EqualTo(CAD_Num.IsZero(xl, 0), 1) ThenBlock: { ReturnValue(-1) }
        CadAppPick.hu = Float_Div(CadAppPick.hu, xl)
        CadAppPick.hv = Float_Div(CadAppPick.hv, xl)
        CadAppPick.last_t = Float_Div(CadAppPick.last_t, xl)
        // Y = N × X
        CadAppPick.pi = Float_Sub(Float_Mul(CadAppPick.ny, CadAppPick.last_t), Float_Mul(CadAppPick.nz, CadAppPick.hv))
        CadAppPick.pj = Float_Sub(Float_Mul(CadAppPick.nz, CadAppPick.hu), Float_Mul(CadAppPick.nx, CadAppPick.last_t))
        CadAppPick.pins = Float_Sub(Float_Mul(CadAppPick.nx, CadAppPick.hv), Float_Mul(CadAppPick.ny, CadAppPick.hu))
        ArraySet(CadAppPick.pl, 0, 1)
        ArraySet(CadAppPick.pl, 1, CadAppPick.ox)
        ArraySet(CadAppPick.pl, 2, CadAppPick.oy)
        ArraySet(CadAppPick.pl, 3, CadAppPick.oz)
        ArraySet(CadAppPick.pl, 4, CadAppPick.hu)
        ArraySet(CadAppPick.pl, 5, CadAppPick.hv)
        ArraySet(CadAppPick.pl, 6, CadAppPick.last_t)
        ArraySet(CadAppPick.pl, 7, CadAppPick.pi)
        ArraySet(CadAppPick.pl, 8, CadAppPick.pj)
        ArraySet(CadAppPick.pl, 9, CadAppPick.pins)
        ArraySet(CadAppPick.pl, 10, CadAppPick.nx)
        ArraySet(CadAppPick.pl, 11, CadAppPick.ny)
        ArraySet(CadAppPick.pl, 12, CadAppPick.nz)
        // UV origin = face centroid (on THIS face), not first vert / part origin.
        CA_PickBufs()
        IfCondition EqualTo(CAD_Topo.FaceCentroid(CadAppPick.face, CadAppPick.pa), 1) ThenBlock: {
            ArraySet(CadAppPick.pl, 1, ArrayGet(CadAppPick.pa, 0))
            ArraySet(CadAppPick.pl, 2, ArrayGet(CadAppPick.pa, 1))
            ArraySet(CadAppPick.pl, 3, ArrayGet(CadAppPick.pa, 2))
        }
        ReturnValue(0)
    }
}

// Flip cached Y/N on CadApp.plane so +N points away from CadApp.solid.
// Uses only pinned CadApp.* — FaceCentroid/SolidBounds clobber Inputs.
Function.CA_OrientPlaneOutward {
    Input: face_handle: Integer
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        CadApp.last_face = face_handle
        IfCondition EqualTo(CadApp.last_face, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: { ReturnValue(0) }
        CA_PickBufs()
        IfCondition EqualTo(CadAppPick.pa, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FaceCentroid(CadApp.last_face, CadAppPick.pa), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo.SolidBounds(CadApp.solid, CadAppPick.pb, CadAppPick.pr), 0) ThenBlock: {
            ReturnValue(0)
        }
        CadAppPick.hu = Float_Div(Float_Add(ArrayGet(CadAppPick.pb, 0), ArrayGet(CadAppPick.pr, 0)), 0x4000000000000000)
        CadAppPick.hv = Float_Div(Float_Add(ArrayGet(CadAppPick.pb, 1), ArrayGet(CadAppPick.pr, 1)), 0x4000000000000000)
        CadAppPick.last_t = Float_Div(Float_Add(ArrayGet(CadAppPick.pb, 2), ArrayGet(CadAppPick.pr, 2)), 0x4000000000000000)
        CadAppPick.ax = Float_Sub(ArrayGet(CadAppPick.pa, 0), CadAppPick.hu)
        CadAppPick.ay = Float_Sub(ArrayGet(CadAppPick.pa, 1), CadAppPick.hv)
        CadAppPick.bx = Float_Sub(ArrayGet(CadAppPick.pa, 2), CadAppPick.last_t)
        CadAppPick.nx = CAD_Store.Read(CadApp.plane, 10)
        CadAppPick.ny = CAD_Store.Read(CadApp.plane, 11)
        CadAppPick.nz = CAD_Store.Read(CadApp.plane, 12)
        CadAppPick.hu = Float_Add(Float_Add(Float_Mul(CadAppPick.nx, CadAppPick.ax), Float_Mul(CadAppPick.ny, CadAppPick.ay)), Float_Mul(CadAppPick.nz, CadAppPick.bx))
        IfCondition EqualTo(CAD_Num.IsNeg(CadAppPick.hu), 1) ThenBlock: {
            CAD_Store.Write(CadApp.plane, 7, Float_Sub(0, CAD_Store.Read(CadApp.plane, 7)))
            CAD_Store.Write(CadApp.plane, 8, Float_Sub(0, CAD_Store.Read(CadApp.plane, 8)))
            CAD_Store.Write(CadApp.plane, 9, Float_Sub(0, CAD_Store.Read(CadApp.plane, 9)))
            CAD_Store.Write(CadApp.plane, 10, Float_Sub(0, CAD_Store.Read(CadApp.plane, 10)))
            CAD_Store.Write(CadApp.plane, 11, Float_Sub(0, CAD_Store.Read(CadApp.plane, 11)))
            CAD_Store.Write(CadApp.plane, 12, Float_Sub(0, CAD_Store.Read(CadApp.plane, 12)))
            CA_Log("cad_app: face N flipped outward (pad away from solid)\n", 53)
        }
        ReturnValue(1)
    }
}

// Disk test for a 1-vert circle cap. Uses CadAppPick.ox/hit/hd. Does not touch last_t.
Function.CA_FaceHitDisk {
    Output: Integer
    Body: {
        CadAppPick.n_circ = Add(CadAppPick.n_circ, 1)
        IfCondition EqualTo(CadAppPick.hd, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.pins = 0
        edc = CAD_Store.Read(CadAppPick.hd, 0)
        IfCondition NotEqual(edc, 0) ThenBlock: {
            crvc = CAD_Store.Read(edc, 2)
            IfCondition NotEqual(crvc, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(crvc, 0), 2) ThenBlock: {
                    CadAppPick.pins = CAD_Store.Read(crvc, 10)
                }
            }
        }
        IfCondition EqualTo(CAD_Num.IsZero(CadAppPick.pins, 0), 1) ThenBlock: {
            ov = CAD_Store.Read(CadAppPick.hd, 5)
            IfCondition EqualTo(ov, 0) ThenBlock: { ReturnValue(0) }
            CadAppPick.hu = Float_Sub(CAD_Store.Read(ov, 0), CadAppPick.ox)
            CadAppPick.hv = Float_Sub(CAD_Store.Read(ov, 1), CadAppPick.oy)
            CadAppPick.pi = Float_Sub(CAD_Store.Read(ov, 2), CadAppPick.oz)
            CadAppPick.pins = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CadAppPick.hu, CadAppPick.hu), Float_Mul(CadAppPick.hv, CadAppPick.hv)), Float_Mul(CadAppPick.pi, CadAppPick.pi)))
        }
        IfCondition EqualTo(CAD_Num.IsZero(CadAppPick.pins, 0), 1) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = ArrayGet(CadAppPick.hit, 0)
        CadAppPick.ay = ArrayGet(CadAppPick.hit, 1)
        CadAppPick.bx = ArrayGet(CadAppPick.hit, 2)
        CadAppPick.hu = Float_Sub(CadAppPick.ax, CadAppPick.ox)
        CadAppPick.hv = Float_Sub(CadAppPick.ay, CadAppPick.oy)
        CadAppPick.pi = Float_Sub(CadAppPick.bx, CadAppPick.oz)
        CadAppPick.hu = Float_Add(Float_Add(Float_Mul(CadAppPick.hu, CadAppPick.hu), Float_Mul(CadAppPick.hv, CadAppPick.hv)), Float_Mul(CadAppPick.pi, CadAppPick.pi))
        CadAppPick.hv = Float_Mul(CadAppPick.pins, CadAppPick.pins)
        IfCondition EqualTo(CAD_Num.Le(CadAppPick.hu, CadAppPick.hv), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Even-odd in face UV. Same interpolant as CAD_Topo.PointInFaceUV (pinned, no heap).
Function.CA_FaceContainsHit {
    Input: face_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_handle, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.face = face_handle
        IfCondition EqualTo(CadAppPick.uv, 0) ThenBlock: { CadAppPick.uv = Allocate(4096) }
        IfCondition EqualTo(CadAppPick.uv, 0) ThenBlock: { ReturnValue(0) }
        lp = CAD_Store.Read(CadAppPick.face, 1)
        IfCondition EqualTo(lp, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.hd = CAD_Store.Read(lp, 0)
        IfCondition EqualTo(CadAppPick.hd, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ce = CadAppPick.hd
        CadAppPick.pn = 0
        cguard = 0
        WhileLoop LessThan(cguard, 512) {
            ce = CadAppPick.ce
            CadAppPick.ov = CAD_Store.Read(ce, 5)
            ov = CadAppPick.ov
            IfCondition NotEqual(ov, 0) ThenBlock: {
                dx = Float_Sub(CAD_Store.Read(ov, 0), CadAppPick.ox)
                dy = Float_Sub(CAD_Store.Read(ov, 1), CadAppPick.oy)
                dz = Float_Sub(CAD_Store.Read(ov, 2), CadAppPick.oz)
                xx = ArrayGet(CadAppPick.pl, 4)
                xy = ArrayGet(CadAppPick.pl, 5)
                xz = ArrayGet(CadAppPick.pl, 6)
                yx = ArrayGet(CadAppPick.pl, 7)
                yy = ArrayGet(CadAppPick.pl, 8)
                yz = ArrayGet(CadAppPick.pl, 9)
                u = Float_Add(Float_Add(Float_Mul(dx, xx), Float_Mul(dy, xy)), Float_Mul(dz, xz))
                v = Float_Add(Float_Add(Float_Mul(dx, yx), Float_Mul(dy, yy)), Float_Mul(dz, yz))
                n = CadAppPick.pn
                IfCondition LessThan(n, 256) ThenBlock: {
                    ArraySet(CadAppPick.uv, Multiply(n, 2), u)
                    ArraySet(CadAppPick.uv, Add(Multiply(n, 2), 1), v)
                    CadAppPick.pn = Add(n, 1)
                }
            }
            ce = CadAppPick.ce
            CadAppPick.ce = CAD_Store.Read(ce, 2)
            cguard = Add(cguard, 1)
            IfCondition EqualTo(CadAppPick.ce, CadAppPick.hd) ThenBlock: { cguard = 512 }
        }
        IfCondition LessThan(CadAppPick.pn, 3) ThenBlock: {
            ReturnValue(CA_FaceHitDisk())
        }
        hx = ArrayGet(CadAppPick.hit, 0)
        hy = ArrayGet(CadAppPick.hit, 1)
        hz = ArrayGet(CadAppPick.hit, 2)
        xx = ArrayGet(CadAppPick.pl, 4)
        xy = ArrayGet(CadAppPick.pl, 5)
        xz = ArrayGet(CadAppPick.pl, 6)
        yx = ArrayGet(CadAppPick.pl, 7)
        yy = ArrayGet(CadAppPick.pl, 8)
        yz = ArrayGet(CadAppPick.pl, 9)
        CadAppPick.hu = Float_Add(Float_Add(Float_Mul(Float_Sub(hx, CadAppPick.ox), xx), Float_Mul(Float_Sub(hy, CadAppPick.oy), xy)), Float_Mul(Float_Sub(hz, CadAppPick.oz), xz))
        CadAppPick.hv = Float_Add(Float_Add(Float_Mul(Float_Sub(hx, CadAppPick.ox), yx), Float_Mul(Float_Sub(hy, CadAppPick.oy), yy)), Float_Mul(Float_Sub(hz, CadAppPick.oz), yz))
        CadAppPick.pins = 0
        CadAppPick.pi = 0
        CadAppPick.pj = Subtract(CadAppPick.pn, 1)
        WhileLoop LessThan(CadAppPick.pi, CadAppPick.pn) {
            i = CadAppPick.pi
            j = CadAppPick.pj
            ui = ArrayGet(CadAppPick.uv, Multiply(i, 2))
            vi = ArrayGet(CadAppPick.uv, Add(Multiply(i, 2), 1))
            uj = ArrayGet(CadAppPick.uv, Multiply(j, 2))
            vj = ArrayGet(CadAppPick.uv, Add(Multiply(j, 2), 1))
            hv = CadAppPick.hv
            hu = CadAppPick.hu
            cross = 0
            IfCondition EqualTo(CAD_Num.Le(vi, hv), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.Le(hv, vj), 1) ThenBlock: { cross = 1 }
            }
            IfCondition EqualTo(CAD_Num.Le(vj, hv), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.Le(hv, vi), 1) ThenBlock: { cross = 1 }
            }
            IfCondition EqualTo(cross, 1) ThenBlock: {
                den = Float_Sub(vj, vi)
                IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                    i = CadAppPick.pi
                    j = CadAppPick.pj
                    ui = ArrayGet(CadAppPick.uv, Multiply(i, 2))
                    vi = ArrayGet(CadAppPick.uv, Add(Multiply(i, 2), 1))
                    uj = ArrayGet(CadAppPick.uv, Multiply(j, 2))
                    vj = ArrayGet(CadAppPick.uv, Add(Multiply(j, 2), 1))
                    hv = CadAppPick.hv
                    hu = CadAppPick.hu
                    tt = Float_Div(Float_Sub(hv, vi), Float_Sub(vj, vi))
                    uint = Float_Add(ui, Float_Mul(tt, Float_Sub(uj, ui)))
                    IfCondition EqualTo(CAD_Num.Le(hu, uint), 1) ThenBlock: {
                        CadAppPick.pins = Subtract(1, CadAppPick.pins)
                    }
                }
            }
            CadAppPick.pj = CadAppPick.pi
            CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        ReturnValue(CadAppPick.pins)
    }
}

// Front-most planar face under the pixel. Ortho ray + in-face (no click-through).
Function.CA_PickFaceAt {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(0) }
        CA_PickBufs()
        IfCondition EqualTo(CadAppPick.fr, 0) ThenBlock: { ReturnValue(0) }
        CA_BuildViewFrame(CadAppPick.fr)
        CA_CamBasis()
        cx = ArrayGet(CadAppPick.fr, 0)
        cy = ArrayGet(CadAppPick.fr, 1)
        cz = ArrayGet(CadAppPick.fr, 2)
        sc = ArrayGet(CadAppPick.fr, 3)
        hw = ArrayGet(CadAppPick.fr, 4)
        hh = ArrayGet(CadAppPick.fr, 5)
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: { ReturnValue(0) }
        uu = Float_Sub(Float_Div(Float_Sub(Float_FromInt(px), hw), sc), CAD_View_State.pan_u)
        vv = Float_Sub(Float_Div(Float_Sub(hh, Float_FromInt(py)), sc), CAD_View_State.pan_v)
        CadAppPick.wx = Float_Add(cx, Float_Add(Float_Mul(uu, CadAppPick.rx), Float_Mul(vv, CadAppPick.ux)))
        CadAppPick.wy = Float_Add(cy, Float_Add(Float_Mul(uu, CadAppPick.ry), Float_Mul(vv, CadAppPick.uy)))
        CadAppPick.wz = Float_Add(cz, Float_Add(Float_Mul(uu, CadAppPick.rz), Float_Mul(vv, CadAppPick.uz)))
        // into the scene (away from camera)
        CadAppPick.dx = Float_Sub(0, CadAppPick.cdx)
        CadAppPick.dy = Float_Sub(0, CadAppPick.cdy)
        CadAppPick.dz = Float_Sub(0, CadAppPick.cdz)
        CadAppPick.best_f = 0
        CadAppPick.best_t = 0x42C1D206A0000000
        CadAppPick.n_hits = 0
        CadAppPick.n_plane = 0
        CadAppPick.n_circ = 0
        CadApp.pick_n = 0
        CadApp.pick_shell = CAD_Store.Read(CadApp.solid, 0)
        sguard = 0
        WhileLoop NotEqual(CadApp.pick_shell, 0) {
            CadApp.pick_fh = CAD_Store.Read(CadApp.pick_shell, 0)
            fguard = 0
            WhileLoop NotEqual(CadApp.pick_fh, 0) {
                CadApp.pick_n = Add(CadApp.pick_n, 1)
                fh = CadApp.pick_fh
                IfCondition EqualTo(CAD_Topo.FaceGetPlane(fh, CadAppPick.pl), 0) ThenBlock: {
                    CadAppPick.n_plane = Add(CadAppPick.n_plane, 1)
                    fh = CadApp.pick_fh
                    // Keep FaceGetPlane. Vert Newell on a 1-vert circle smashes the disk.
                    CadAppPick.ox = ArrayGet(CadAppPick.pl, 1)
                    CadAppPick.oy = ArrayGet(CadAppPick.pl, 2)
                    CadAppPick.oz = ArrayGet(CadAppPick.pl, 3)
                    CadAppPick.nx = ArrayGet(CadAppPick.pl, 10)
                    CadAppPick.ny = ArrayGet(CadAppPick.pl, 11)
                    CadAppPick.nz = ArrayGet(CadAppPick.pl, 12)
                    den = Float_Add(Float_Add(Float_Mul(CadAppPick.dx, CadAppPick.nx), Float_Mul(CadAppPick.dy, CadAppPick.ny)), Float_Mul(CadAppPick.dz, CadAppPick.nz))
                    IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                        CadAppPick.last_t = Float_Div(Float_Add(Float_Add(Float_Mul(Float_Sub(CadAppPick.ox, CadAppPick.wx), CadAppPick.nx), Float_Mul(Float_Sub(CadAppPick.oy, CadAppPick.wy), CadAppPick.ny)), Float_Mul(Float_Sub(CadAppPick.oz, CadAppPick.wz), CadAppPick.nz)), den)
                        ArraySet(CadAppPick.hit, 0, Float_Add(CadAppPick.wx, Float_Mul(CadAppPick.last_t, CadAppPick.dx)))
                        ArraySet(CadAppPick.hit, 1, Float_Add(CadAppPick.wy, Float_Mul(CadAppPick.last_t, CadAppPick.dy)))
                        ArraySet(CadAppPick.hit, 2, Float_Add(CadAppPick.wz, Float_Mul(CadAppPick.last_t, CadAppPick.dz)))
                        fh = CadApp.pick_fh
                        IfCondition EqualTo(CA_FaceContainsHit(fh), 1) ThenBlock: {
                            CA_HitInsert(CadAppPick.last_t, CadApp.pick_fh)
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CadAppPick.last_t, CadAppPick.best_t)), 1) ThenBlock: {
                                CadAppPick.best_t = CadAppPick.last_t
                                CadAppPick.best_f = CadApp.pick_fh
                            }
                        }
                    }
                }
                fh = CadApp.pick_fh
                CadApp.pick_fh = CAD_Store.Read(fh, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 512) ThenBlock: { CadApp.pick_fh = 0 }
            }
            sh = CadApp.pick_shell
            CadApp.pick_shell = CAD_Store.Read(sh, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { CadApp.pick_shell = 0 }
        }
        IfCondition EqualTo(CadAppPick.quiet, 0) ThenBlock: {
            PrintMessage("cad_app: face pick n=")
            PrintNumber(CadApp.pick_n)
            PrintMessage(" fh=")
            PrintNumber(CadAppPick.best_f)
            PrintMessage("\n")
        }
        IfCondition GreaterThan(CadAppPick.n_hits, 0) ThenBlock: {
            CadAppPick.best_f = ArrayGet(CadAppPick.hit_f, 0)
            CadAppPick.best_t = ArrayGet(CadAppPick.hit_t, 0)
        }
        IfCondition EqualTo(CadAppPick.quiet, 0) ThenBlock: {
            CA_LogInt("cad_app: face pick hits=", 25, CadAppPick.n_hits)
            CA_LogInt("cad_app: face pick n=", 21, CadApp.pick_n)
            CA_LogInt("cad_app: face pick planar=", 26, CadAppPick.n_plane)
            CA_LogInt("cad_app: face pick circ=", 24, CadAppPick.n_circ)
        }
        ReturnValue(CadAppPick.best_f)
    }
}

// Insert (t,fh) into hit_t/hit_f sorted by increasing t (front-most first).
Function.CA_HitInsert {
    Input: t_r: Integer
    Input: fh: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppPick.hit_t, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(CadAppPick.n_hits, 128) ThenBlock: { ReturnValue(0) }
        CadAppPick.last_t = t_r
        CadAppPick.face = fh
        CadAppPick.ins_i = CadAppPick.n_hits
        i = 0
        WhileLoop LessThan(i, CadAppPick.n_hits) {
            prv = ArrayGet(CadAppPick.hit_t, i)
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CadAppPick.last_t, prv)), 1) ThenBlock: {
                CadAppPick.ins_i = i
                i = CadAppPick.n_hits
            }
            IfCondition LessThan(i, CadAppPick.n_hits) ThenBlock: {
                i = Add(i, 1)
            }
        }
        j = CadAppPick.n_hits
        WhileLoop GreaterThan(j, CadAppPick.ins_i) {
            ArraySet(CadAppPick.hit_t, j, ArrayGet(CadAppPick.hit_t, Subtract(j, 1)))
            ArraySet(CadAppPick.hit_f, j, ArrayGet(CadAppPick.hit_f, Subtract(j, 1)))
            j = Subtract(j, 1)
        }
        ArraySet(CadAppPick.hit_t, CadAppPick.ins_i, CadAppPick.last_t)
        ArraySet(CadAppPick.hit_f, CadAppPick.ins_i, CadAppPick.face)
        CadAppPick.n_hits = Add(CadAppPick.n_hits, 1)
        ReturnValue(1)
    }
}

// Next face along the same ray after cur (wrap). 0 if none.
Function.CA_PickFaceNext {
    Input: px: Integer
    Input: py: Integer
    Input: cur: Integer
    Output: Integer
    Body: {
        CA_PickFaceAt(px, py)
        IfCondition LessThan(CadAppPick.n_hits, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(cur, 0) ThenBlock: {
            ReturnValue(ArrayGet(CadAppPick.hit_f, 0))
        }
        i = 0
        found = -1
        WhileLoop LessThan(i, CadAppPick.n_hits) {
            IfCondition EqualTo(ArrayGet(CadAppPick.hit_f, i), cur) ThenBlock: {
                found = i
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(found, 0) ThenBlock: {
            ReturnValue(ArrayGet(CadAppPick.hit_f, 0))
        }
        nxt = Add(found, 1)
        IfCondition GreaterEqual(nxt, CadAppPick.n_hits) ThenBlock: { nxt = 0 }
        ReturnValue(ArrayGet(CadAppPick.hit_f, nxt))
    }
}
