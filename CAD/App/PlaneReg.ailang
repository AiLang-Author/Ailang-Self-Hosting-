Function.CA_PlaneOnTop {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_Log("cad_app: OnTop needs solid (pad first)\n", 39)
            ReturnValue(-1)
        }
        CadApp.face_pick = 1
        CadApp.mode = 0
        CadApp.nclick = 0
        CadApp.hover_face = 0
        CA_PickBufs()
        CA_Log("cad_app: Sketch on Face - click a solid face\n", 45)
        CA_Log("  (new UV sketch on that face; not Sketch_0)\n", 45)
        ReturnValue(0)
    }
}

// Register plane for 3D overlay (unique, max 16).


// Register plane for 3D overlay (unique, max 16).
// Remember a sketch as a document node (unique, max 16).
Function.CA_SketchRegister {
    Input: sk: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sk, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.sk_list, 0) ThenBlock: {
            CadApp.sk_list = Allocate(512)
            CadApp.sk_n = 0
        }
        i = 0
        WhileLoop LessThan(i, CadApp.sk_n) {
            IfCondition EqualTo(ArrayGet(CadApp.sk_list, i), sk) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(CadApp.sk_n, 64) ThenBlock: {
            ArraySet(CadApp.sk_list, CadApp.sk_n, sk)
            CadApp.sk_n = Add(CadApp.sk_n, 1)
            CA_FeatAdd(0, Subtract(CadApp.sk_n, 1))
        }
        ReturnValue(1)
    }
}

// Add a sketch handle to sk_list without a new feat row (load / replay).
Function.CA_SketchAttach {
    Input: sk: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sk, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.sk_list, 0) ThenBlock: {
            CadApp.sk_list = Allocate(512)
            CadApp.sk_n = 0
        }
        i = 0
        WhileLoop LessThan(i, CadApp.sk_n) {
            IfCondition EqualTo(ArrayGet(CadApp.sk_list, i), sk) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(CadApp.sk_n, 64) ThenBlock: {
            ArraySet(CadApp.sk_list, CadApp.sk_n, sk)
            CadApp.sk_n = Add(CadApp.sk_n, 1)
        }
        ReturnValue(1)
    }
}

// 1 = default Sketch_0 / world XY (not a user construction plane).
Function.CA_PlaneIsImplicitXY {
    Input: pl: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(pl, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(pl, CadApp.sk0_plane) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Plane.GetMode(pl), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Plane.GetRecipe(pl), 0) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.CA_PlaneRegister {
    Input: pl: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(pl, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.plane_list, 0) ThenBlock: {
            CadApp.plane_list = Allocate(512)
            CadApp.plane_n = 0
        }
        // One home XY only. Draw used to CreateWorldXY every 3D frame.
        IfCondition EqualTo(CA_PlaneIsImplicitXY(pl), 1) ThenBlock: {
            IfCondition NotEqual(CadApp.sk0_plane, 0) ThenBlock: {
                IfCondition NotEqual(pl, CadApp.sk0_plane) ThenBlock: {
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(CadApp.sk0_plane, 0) ThenBlock: {
                CadApp.sk0_plane = pl
                CAD_Plane.EnsurePid(pl)
            }
            IfCondition EqualTo(CadApp.plane, 0) ThenBlock: {
                CadApp.plane = CadApp.sk0_plane
            }
        }
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, CadApp.plane_n) {
            IfCondition EqualTo(ArrayGet(CadApp.plane_list, CadAppPick.pi), pl) ThenBlock: {
                ReturnValue(1)
            }
            CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        IfCondition LessThan(CadApp.plane_n, 64) ThenBlock: {
            ArraySet(CadApp.plane_list, CadApp.plane_n, pl)
            CadApp.plane_n = Add(CadApp.plane_n, 1)
        }
        ReturnValue(1)
    }
}

// Drop World-XY clones. Keep Sketch_0 plus user recipes (offset/angle/face/3pt).
Function.CA_PlanePruneImplicit {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.plane_list, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.pi = 0
        CadAppPick.ins_i = 0
        WhileLoop LessThan(CadAppPick.pi, CadApp.plane_n) {
            CadApp.pick_fh = ArrayGet(CadApp.plane_list, CadAppPick.pi)
            CadAppPick.pins = 0
            IfCondition EqualTo(CadApp.pick_fh, CadApp.sk0_plane) ThenBlock: {
                CadAppPick.pins = 1
            }
            IfCondition EqualTo(CA_PlaneIsImplicitXY(CadApp.pick_fh), 0) ThenBlock: {
                CadAppPick.pins = 1
            }
            IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: {
                ArraySet(CadApp.plane_list, CadAppPick.ins_i, CadApp.pick_fh)
                CadAppPick.ins_i = Add(CadAppPick.ins_i, 1)
            }
            CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        CadApp.plane_n = CadAppPick.ins_i
        IfCondition NotEqual(CadApp.plane, 0) ThenBlock: {
            IfCondition EqualTo(CA_PlaneIsImplicitXY(CadApp.plane), 1) ThenBlock: {
                IfCondition NotEqual(CadApp.plane, CadApp.sk0_plane) ThenBlock: {
                    CadApp.plane = CadApp.sk0_plane
                }
            }
        }
        ReturnValue(0)
    }
}

Function.CA_BindSketchPlane {
    Output: Integer
    Body: {
        CA_EnsurePlane()
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Sketch.GetPlaneId(CadApp.sketch), 0) ThenBlock: {
            CAD_Sketch.SetPlaneId(CadApp.sketch, CadApp.plane)
        }
        ReturnValue(0)
    }
}

// Ensure active plane is world XY if none.


// Ensure active plane is world XY if none.
Function.CA_EnsurePlane {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sk0_plane, 0) ThenBlock: {
            CadApp.sk0_plane = CAD_Plane.CreateWorldXY()
            CAD_Plane.EnsurePid(CadApp.sk0_plane)
            CAD_Plane.SetParent(CadApp.sk0_plane, 0)
            CA_PlaneRegister(CadApp.sk0_plane)
            CA_Log("cad_app: created Sketch_0 plane (part root)\n", 44)
        }
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: {
            CadApp.plane = CadApp.sk0_plane
        }
        ReturnValue(CadApp.plane)
    }
}

// Build ProjectPoint frame from solid bounds or default ±50 cube.


// New sketch on active plane (bare plane OK — no solid required).
Function.CA_SketchOnActivePlane {
    Output: Integer
    Body: {
        CA_EnsurePlane()
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: {
            CA_Log("cad_app: no plane\n", 18)
            ReturnValue(-1)
        }
        CA_UndoPush()
        sk = CAD_Sketch.CreateSketch(1)
        IfCondition EqualTo(sk, 0) ThenBlock: {
            CA_Log("cad_app: sketch FAIL\n", 21)
            ReturnValue(-2)
        }
        CAD_Sketch.SetPlaneId(sk, CadApp.plane)
        CadApp.sketch = sk
        CadApp.sk_i = Add(CadApp.sk_i, 1)
        CA_SketchRegister(sk)
        CadApp.nprof = 0
        CadApp.prof_user = 0
        CadApp.prof_mask = 0
        CadApp.prof_sel = 0
        CadApp.mode = 1
        CadApp.dirty = 1
        CA_PlaneRegister(CadApp.plane)
        CA_LookAlongActivePlane()
        PrintMessage("cad_app: sketch on plane pid=")
        PrintNumber(CAD_Plane.GetPid(CadApp.plane))
        PrintMessage(" (UV draw; m=3D to see plane)\n")
        ReturnValue(0)
    }
}

// Offset active plane along normal by dist_mm (integer mm). New plane becomes active.


// Offset active plane along normal by dist_mm (integer mm). New plane becomes active.
Function.CA_PlaneOffsetMm {
    Input: dist_mm: Integer
    Output: Integer
    Body: {
        ReturnValue(CA_PlaneOffsetCenti(Multiply(dist_mm, 100)))
    }
}

// Offset in hundredths of a mm (2045 → 20.45 mm).
Function.CA_PlaneOffsetCenti {
    Input: centi: Integer
    Output: Integer
    Body: {
        CA_EnsurePlane()
        parent = CadApp.plane
        neg = 0
        c = centi
        IfCondition LessThan(c, 0) ThenBlock: {
            neg = 1
            c = Subtract(0, c)
        }
        d = Float_Div(Float_FromInt(c), 0x4059000000000000)
        IfCondition EqualTo(neg, 1) ThenBlock: { d = Float_Sub(0, d) }
        pl = CAD_Plane.CreateOffset(parent, d)
        IfCondition EqualTo(pl, 0) ThenBlock: {
            CA_Log("cad_app: plane offset FAIL\n", 27)
            ReturnValue(-2)
        }
        CadApp.plane = pl
        CA_PlaneRegister(pl)
        CadApp.mode = 0
        CadApp.show_planes = 1
        PrintMessage("cad_app: plane offset ")
        PrintNumber(centi)
        PrintMessage(" cmm pid=")
        PrintNumber(CAD_Plane.GetPid(pl))
        PrintMessage(" (3D: orbit to see)\n")
        CA_Log("  tip: SkPln to draw on it; Flip to face parent\n", 48)
        ReturnValue(0)
    }
}


Function.CA_PlaneFlip {
    Output: Integer
    Body: {
        CA_EnsurePlane()
        IfCondition EqualTo(CAD_Plane.Flip(CadApp.plane), 0) ThenBlock: {
            CA_PlaneRegister(CadApp.plane)
            CadApp.mode = 0
            CadApp.show_planes = 1
            CA_Log("cad_app: plane flipped - 3D view updated\n", 41)
            ReturnValue(0)
        }
        CA_Log("cad_app: plane flip FAIL\n", 25)
        ReturnValue(-1)
    }
}

// Angle about local X in integer degrees.


// Angle about local X in integer degrees.
Function.CA_PlaneAngleXDeg {
    Input: deg: Integer
    Output: Integer
    Body: {
        ReturnValue(CA_PlaneAngleXCenti(Multiply(deg, 100)))
    }
}

// Angle in hundredths of a degree (3745 → 37.45°).
Function.CA_PlaneAngleXCenti {
    Input: centi: Integer
    Output: Integer
    Body: {
        CA_EnsurePlane()
        neg = 0
        c = centi
        IfCondition LessThan(c, 0) ThenBlock: {
            neg = 1
            c = Subtract(0, c)
        }
        degf = Float_Div(Float_FromInt(c), 0x4059000000000000)
        IfCondition EqualTo(neg, 1) ThenBlock: { degf = Float_Sub(0, degf) }
        rpd = 0x3F91DF46A2529D39
        ang = Float_Mul(degf, rpd)
        pl = CAD_Plane.CreateAngleX(CadApp.plane, ang)
        IfCondition EqualTo(pl, 0) ThenBlock: {
            CA_Log("cad_app: plane angle FAIL\n", 26)
            ReturnValue(-2)
        }
        CadApp.plane = pl
        CA_PlaneRegister(pl)
        CadApp.mode = 0
        CadApp.show_planes = 1
        PrintMessage("cad_app: plane angleX ")
        PrintNumber(centi)
        PrintMessage(" cdeg pid=")
        PrintNumber(CAD_Plane.GetPid(pl))
        PrintMessage(" (3D: orbit to see)\n")
        ReturnValue(0)
    }
}


