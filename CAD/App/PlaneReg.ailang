// Create plane from face handle + new sketch. Keeps solid.


// Create plane from face handle + new sketch. Keeps solid.
Function.CA_SketchOnFace {
    Input: face_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_Log("cad_app: sketch-on-face needs solid\n", 36)
            ReturnValue(-1)
        }
        IfCondition EqualTo(face_handle, 0) ThenBlock: {
            CA_Log("cad_app: sketch-on-face needs face\n", 35)
            ReturnValue(-2)
        }
        CA_EnsurePlane()
        CA_UndoPush()
        // Pin parent BEFORE CreateFromFace (nested calls clobber locals).
        CadApp.pick_best_f = CadApp.plane
        IfCondition EqualTo(CadApp.pick_best_f, 0) ThenBlock: {
            CadApp.pick_best_f = CadApp.sk0_plane
        }
        CadApp.last_face = face_handle
        pl = CAD_Plane.CreateFromFace(CadApp.last_face, CadApp.solid)
        IfCondition EqualTo(pl, 0) ThenBlock: {
            CA_Log("cad_app: plane FAIL (need planar face)\n", 39)
            ReturnValue(-2)
        }
        CadApp.plane = pl
        CAD_Plane.SetParent(CadApp.plane, CadApp.pick_best_f)
        CAD_Plane.EnsurePid(CadApp.plane)
        CA_FacePlaneFromVerts(CadApp.last_face)
        fr = Allocate(128)
        CAD_Plane.FrameFromFacePlane(CadAppPick.pl, fr)
        CAD_Plane.WriteCacheFromFrame(CadApp.plane, fr)
        CA_OrientPlaneOutward(CadApp.last_face, CadApp.solid)
        fl = CAD_Store.Read(CadApp.plane, 18)
        CAD_Store.Write(CadApp.plane, 18, BitwiseOr(fl, 4))
        Deallocate(fr, 128)
        sk = CAD_Sketch.CreateSketch(1)
        IfCondition EqualTo(sk, 0) ThenBlock: {
            CA_Log("cad_app: sketch FAIL\n", 21)
            ReturnValue(-2)
        }
        CadApp.sketch = sk
        CAD_Sketch.SetPlaneId(CadApp.sketch, CadApp.plane)
        CadApp.sk_i = Add(CadApp.sk_i, 1)
        CA_SketchRegister(sk)
        CadApp.face_pick = 0
        CadApp.hover_face = 0
        CadApp.nprof = 0
        CadApp.prof_user = 0
        CadApp.prof_mask = 0
        CadApp.prof_sel = 0
        CadApp.mode = 1
        CadApp.tool = 0
        CadApp.nclick = 0
        CadApp.dirty = 1
        CA_PlaneRegister(CadApp.plane)
        CA_ImportFaceRefs(CadApp.last_face)
        PrintMessage("cad_app: NEW sketch ")
        PrintNumber(CadApp.sk_i)
        PrintMessage(" on face sk0=")
        PrintNumber(CAD_Plane.GetPid(CadApp.sk0_plane))
        PrintMessage(" pl=")
        PrintNumber(CAD_Plane.GetPid(CadApp.plane))
        PrintMessage(" par=")
        PrintNumber(CAD_Plane.GetPid(CadApp.pick_best_f))
        PrintMessage(" face=")
        PrintNumber(CadApp.last_face)
        PrintMessage("\n")
        CA_LookAlongActivePlane()
        CA_LogInt("cad_app: NEW sketch on face #", 29, CadApp.sk_i)
        CA_Log("  empty UV on that face (prior sketches stay in the tree)\n", 59)
        ReturnValue(0)
    }
}

// Sit the camera on the outward-normal side of the active face.
// +Z face stays +Z (top). −Z stays bottom. Same for ±X / ±Y.
// Old path used −N and flipped +Z sketches to bottom (orbit inverted).
Function.CA_LookAlongActivePlane {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: { ReturnValue(0) }
        CA_PickBufs()
        IfCondition EqualTo(CadAppPick.pl, 0) ThenBlock: { ReturnValue(0) }
        CAD_Plane.EvalFrame(CadApp.plane, CadAppPick.pl)
        nx = ArrayGet(CadAppPick.pl, 9)
        ny = ArrayGet(CadAppPick.pl, 10)
        nz = ArrayGet(CadAppPick.pl, 11)
        rxy = CAD_Num.Sqrt(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)))
        CAD_View_State.pitch_r = CAD_Geom.Atan2(nz, rxy)
        CAD_View_State.yaw_r = CAD_Geom.Atan2(nx, ny)
        IfCondition EqualTo(CAD_Num.IsZero(rxy, 0), 1) ThenBlock: {
            CAD_View_State.yaw_r = 0
        }
        lim = 0x3FF9000000000000
        IfCondition EqualTo(Float_Le(lim, CAD_View_State.pitch_r), 1) ThenBlock: {
            CAD_View_State.pitch_r = lim
        }
        nlim = Float_Sub(0, lim)
        IfCondition EqualTo(Float_Le(CAD_View_State.pitch_r, nlim), 1) ThenBlock: {
            CAD_View_State.pitch_r = nlim
        }
        CAD_View_State.pitch_sign = 1
        CAD_View_State.view_mode = 3
        CAD_View_State.b_ok = 0
        ReturnValue(1)
    }
}

// Project the host face's vertices into the new sketch as frozen User Points
// (FixX + FixY). Constrainable (Coincident / Dist / DistO) without becoming
// pad profiles. Faces with >12 verts (tess circles) skip verts — type X Y.
// Slot 27 = n_face_ref.
