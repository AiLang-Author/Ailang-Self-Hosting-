Function.CA_PlaneByPid {
    Input: pid: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(pid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.plane_list, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, CadApp.plane_n) {
            pl = ArrayGet(CadApp.plane_list, i)
            IfCondition EqualTo(CAD_Plane.GetPid(pl), pid) ThenBlock: {
                ReturnValue(pl)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Parent-first regen. FACE: live handle, then signature (loud miss). No XY fallback.
Function.CA_RegenPlaneTree {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.plane_list, 0) ThenBlock: { ReturnValue(0) }
        misses = 0
        fr = Allocate(128)
        i = 0
        WhileLoop LessThan(i, CadApp.plane_n) {
            pl = ArrayGet(CadApp.plane_list, i)
            IfCondition EqualTo(CAD_Plane.GetMode(pl), 3) ThenBlock: {
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                    CAD_Store.Write(pl, 16, CadApp.solid)
                }
            }
            rc = CAD_Plane.EvalFrame(pl, fr)
            IfCondition EqualTo(rc, -1) ThenBlock: {
                misses = Add(misses, 1)
                PrintMessage("cad_app: FACE MISS pid=")
                PrintNumber(CAD_Plane.GetPid(pl))
                PrintMessage(" (signature last-resort failed)\n")
                CA_Log("cad_app: FACE MISS - plane face lost after regen\n", 49)
            }
            i = Add(i, 1)
        }
        Deallocate(fr, 128)
        ReturnValue(misses)
    }
}

// plane_tree asset (PT1 text, stored as application/json).
Function.CA_FormatPlaneTree {
    Input: buf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        CA_EnsurePlane()
        sk0p = CAD_Plane.GetPid(CadApp.sk0_plane)
        act = 0
        IfCondition NotEqual(CadApp.plane, 0) ThenBlock: {
            act = CAD_Plane.GetPid(CadApp.plane)
        }
        skpl = act
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            sph = CAD_Sketch.GetPlaneId(CadApp.sketch)
            IfCondition NotEqual(sph, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Plane.GetPid(sph), 0) ThenBlock: {
                    skpl = CAD_Plane.GetPid(sph)
                }
            }
        }
        pos = 0
        pos = CAD_Repo.AppendStr(buf, pos, "{\"v\":1,\"fmt\":\"PT1\",\"sk0\":")
        pos = CAD_Repo.AppendInt(buf, pos, sk0p)
        pos = CAD_Repo.AppendStr(buf, pos, ",\"act\":")
        pos = CAD_Repo.AppendInt(buf, pos, act)
        pos = CAD_Repo.AppendStr(buf, pos, ",\"skpl\":")
        pos = CAD_Repo.AppendInt(buf, pos, skpl)
        pos = CAD_Repo.AppendStr(buf, pos, ",\"n\":")
        pos = CAD_Repo.AppendInt(buf, pos, CadApp.plane_n)
        pos = CAD_Repo.AppendStr(buf, pos, ",\"planes\":[\n")
        i = 0
        WhileLoop LessThan(i, CadApp.plane_n) {
            pl = ArrayGet(CadApp.plane_list, i)
            pos = CAD_Plane.ExportLine(pl, buf, pos)
            i = Add(i, 1)
        }
        pos = CAD_Repo.AppendStr(buf, pos, "]}\n")
        SetByte(buf, pos, 0)
        ReturnValue(pos)
    }
}

Function.CA_ScanKeyInt {
    Input: buf: Address
    Input: key: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        kn = 0
        WhileLoop NotEqual(GetByte(key, kn), 0) {
            kn = Add(kn, 1)
        }
        i = 0
        WhileLoop NotEqual(GetByte(buf, i), 0) {
            m = 1
            k = 0
            WhileLoop LessThan(k, kn) {
                IfCondition NotEqual(GetByte(buf, Add(i, k)), GetByte(key, k)) ThenBlock: {
                    m = 0
                    k = kn
                }
                IfCondition EqualTo(m, 1) ThenBlock: { k = Add(k, 1) }
            }
            IfCondition EqualTo(m, 1) ThenBlock: {
                tmp = Allocate(16)
                j = CAD_Plane.ParseDec(buf, Add(i, kn), tmp)
                v = 0
                IfCondition GreaterThan(j, 0) ThenBlock: { v = ArrayGet(tmp, 0) }
                Deallocate(tmp, 16)
                ReturnValue(v)
            }
            i = Add(i, 1)
            IfCondition GreaterThan(i, 4096) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(0)
    }
}

Function.CA_ParsePlaneTree {
    Input: buf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(-1) }
        CadApp.plane_n = 0
        CadApp.plane = 0
        CadApp.sk0_plane = 0
        IfCondition EqualTo(CadApp.plane_list, 0) ThenBlock: {
            CadApp.plane_list = Allocate(128)
        }
        want = CA_ScanKeyInt(buf, "\"n\":")
        sk0p = CA_ScanKeyInt(buf, "\"sk0\":")
        act = CA_ScanKeyInt(buf, "\"act\":")
        skpl = CA_ScanKeyInt(buf, "\"skpl\":")
        i = 0
        found = 0
        WhileLoop EqualTo(found, 0) {
            IfCondition EqualTo(GetByte(buf, i), 0) ThenBlock: { found = 2 }
            IfCondition EqualTo(GetByte(buf, i), 80) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, Add(i, 1)), 32) ThenBlock: { found = 1 }
            }
            IfCondition EqualTo(found, 0) ThenBlock: { i = Add(i, 1) }
            IfCondition GreaterThan(i, 8192) ThenBlock: { found = 2 }
        }
        IfCondition NotEqual(found, 1) ThenBlock: {
            CA_EnsurePlane()
            ReturnValue(-2)
        }
        ngot = 0
        outh = Allocate(16)
        done = 0
        WhileLoop EqualTo(done, 0) {
            i = CAD_Plane.SkipSp(buf, i)
            IfCondition NotEqual(GetByte(buf, i), 80) ThenBlock: { done = 1 }
            IfCondition EqualTo(done, 0) ThenBlock: {
                ni = CAD_Plane.ParseLine(buf, i, outh)
                IfCondition LessThan(ni, 0) ThenBlock: { done = 1 }
                IfCondition GreaterEqual(ni, 0) ThenBlock: {
                    pl = ArrayGet(outh, 0)
                    CA_PlaneRegister(pl)
                    ngot = Add(ngot, 1)
                    i = ni
                    IfCondition GreaterEqual(ngot, 16) ThenBlock: { done = 1 }
                }
            }
        }
        Deallocate(outh, 16)
        // remap parent pid → handle
        j = 0
        WhileLoop LessThan(j, CadApp.plane_n) {
            pl = ArrayGet(CadApp.plane_list, j)
            ppid = CAD_Store.Read(pl, 17)
            IfCondition NotEqual(ppid, 0) ThenBlock: {
                ph = CA_PlaneByPid(ppid)
                CAD_Plane.SetParent(pl, ph)
            }
            j = Add(j, 1)
        }
        CadApp.sk0_plane = CA_PlaneByPid(sk0p)
        IfCondition EqualTo(CadApp.sk0_plane, 0) ThenBlock: {
            IfCondition GreaterThan(CadApp.plane_n, 0) ThenBlock: {
                CadApp.sk0_plane = ArrayGet(CadApp.plane_list, 0)
            }
        }
        CadApp.plane = CA_PlaneByPid(act)
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: {
            CadApp.plane = CadApp.sk0_plane
        }
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            sph = CA_PlaneByPid(skpl)
            IfCondition EqualTo(sph, 0) ThenBlock: { sph = CadApp.plane }
            CAD_Sketch.SetPlaneId(CadApp.sketch, sph)
        }
        CA_RegenPlaneTree()
        PrintMessage("cad_app: plane_tree n=")
        PrintNumber(ngot)
        PrintMessage(" sk0=")
        PrintNumber(CAD_Plane.GetPid(CadApp.sk0_plane))
        PrintMessage(" pl=")
        PrintNumber(CAD_Plane.GetPid(CadApp.plane))
        PrintMessage("\n")
        ReturnValue(0)
    }
}

Function.CA_FormatFaceMap {
    Input: buf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        nf = 0
        i = 0
        WhileLoop LessThan(i, CadApp.plane_n) {
            pl = ArrayGet(CadApp.plane_list, i)
            IfCondition EqualTo(CAD_Plane.GetMode(pl), 3) ThenBlock: {
                nf = Add(nf, 1)
            }
            i = Add(i, 1)
        }
        pos = 0
        pos = CAD_Repo.AppendStr(buf, pos, "{\"v\":1,\"fmt\":\"FM1\",\"n\":")
        pos = CAD_Repo.AppendInt(buf, pos, nf)
        pos = CAD_Repo.AppendStr(buf, pos, ",\"faces\":[\n")
        i = 0
        WhileLoop LessThan(i, CadApp.plane_n) {
            pl = ArrayGet(CadApp.plane_list, i)
            IfCondition EqualTo(CAD_Plane.GetMode(pl), 3) ThenBlock: {
                SetByte(buf, pos, 70)
                pos = Add(pos, 1)
                SetByte(buf, pos, 32)
                pos = Add(pos, 1)
                pos = CAD_Plane.AppendDec(buf, pos, CAD_Plane.GetPid(pl))
                sl = 20
                WhileLoop LessEqual(sl, 25) {
                    SetByte(buf, pos, 32)
                    pos = Add(pos, 1)
                    pos = CAD_Plane.AppendHex64(buf, pos, CAD_Store.Read(pl, sl))
                    sl = Add(sl, 1)
                }
                SetByte(buf, pos, 10)
                pos = Add(pos, 1)
            }
            i = Add(i, 1)
        }
        pos = CAD_Repo.AppendStr(buf, pos, "]}\n")
        SetByte(buf, pos, 0)
        ReturnValue(pos)
    }
}

Function.CA_ParseFaceMap {
    Input: buf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        found = 0
        WhileLoop EqualTo(found, 0) {
            IfCondition EqualTo(GetByte(buf, i), 0) ThenBlock: { found = 2 }
            IfCondition EqualTo(GetByte(buf, i), 70) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, Add(i, 1)), 32) ThenBlock: { found = 1 }
            }
            IfCondition EqualTo(found, 0) ThenBlock: { i = Add(i, 1) }
            IfCondition GreaterThan(i, 4096) ThenBlock: { found = 2 }
        }
        IfCondition NotEqual(found, 1) ThenBlock: { ReturnValue(0) }
        n = 0
        tmp = Allocate(16)
        done = 0
        WhileLoop EqualTo(done, 0) {
            i = CAD_Plane.SkipSp(buf, i)
            IfCondition NotEqual(GetByte(buf, i), 70) ThenBlock: { done = 1 }
            IfCondition EqualTo(done, 0) ThenBlock: {
                i = Add(i, 1)
                i = CAD_Plane.ParseDec(buf, i, tmp)
                IfCondition LessThan(i, 0) ThenBlock: { done = 1 }
                IfCondition GreaterEqual(i, 0) ThenBlock: {
                    pid = ArrayGet(tmp, 0)
                    pl = CA_PlaneByPid(pid)
                    sl = 20
                    WhileLoop LessEqual(sl, 25) {
                        i = CAD_Plane.ParseHex(buf, i, tmp)
                        IfCondition NotEqual(pl, 0) ThenBlock: {
                            CAD_Store.Write(pl, sl, ArrayGet(tmp, 0))
                        }
                        sl = Add(sl, 1)
                    }
                    IfCondition NotEqual(pl, 0) ThenBlock: {
                        fl = CAD_Store.Read(pl, 18)
                        CAD_Store.Write(pl, 18, BitwiseOr(fl, 1))
                    }
                    n = Add(n, 1)
                }
            }
        }
        Deallocate(tmp, 16)
        ReturnValue(n)
    }
}

// Revolve lives in Solid.ailang (CA_RevolveFromSketch).
// User clicks a sketch line for the axis; lathe stays in the sketch plane.

// -------------------------------------------------------------------------
// Construction-plane picking: face / existing plane / origin / through 3pt
// -------------------------------------------------------------------------

Function.CA_PlaneClearPick {
    Output: Integer
    Body: {
        CadApp.plane_pick = 0
        CadApp.hover_plane = 0
        CadApp.pln_ptn = 0
        ReturnValue(0)
    }
}

Function.CA_PlaneBeginPick {
    Output: Integer
    Body: {
        CA_EnsurePlane()
        CadApp.plane_pick = 1
        CadApp.face_pick = 0
        CadApp.hover_face = 0
        CadApp.hover_plane = 0
        CadApp.mode = 0
        CadApp.nclick = 0
        CadApp.show_planes = 1
        CA_Log("cad_app: Pick Plane - click a construction plane (or tree row)\n", 62)
        ReturnValue(0)
    }
}

Function.CA_PlaneBeginFromFace {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_Log("cad_app: From Face needs a solid (pad first)\n", 45)
            ReturnValue(-1)
        }
        CadApp.plane_pick = 2
        CadApp.face_pick = 0
        CadApp.hover_face = 0
        CadApp.mode = 0
        CadApp.nclick = 0
        CadApp.show_planes = 1
        CA_PickBufs()
        CA_Log("cad_app: From Face - click a planar face (plane only, no sketch)\n", 64)
        ReturnValue(0)
    }
}

Function.CA_PlaneBeginOrigin {
    Output: Integer
    Body: {
        CA_EnsurePlane()
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: {
            CA_Log("cad_app: Origin needs an active plane\n", 38)
            ReturnValue(-1)
        }
        CadApp.plane_pick = 3
        CadApp.face_pick = 0
        CadApp.mode = 0
        CadApp.nclick = 0
        CadApp.show_planes = 1
        CA_Log("cad_app: Origin - click a vertex or point on the plane\n", 55)
        ReturnValue(0)
    }
}

Function.CA_PlaneBegin3Pt {
    Output: Integer
    Body: {
        CA_EnsurePlane()
        CadApp.plane_pick = 4
        CadApp.face_pick = 0
        CadApp.mode = 0
        CadApp.nclick = 0
        CadApp.pln_ptn = 0
        IfCondition EqualTo(CadApp.pln_xyz, 0) ThenBlock: {
            CadApp.pln_xyz = Allocate(96)
        }
        CadApp.show_planes = 1
        CA_Log("cad_app: Through 3 pts - click three points\n", 44)
        ReturnValue(0)
    }
}

Function.CA_PlaneActivateHandle {
    Input: pl: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(pl, 0) ThenBlock: { ReturnValue(-1) }
        CadApp.plane = pl
        CAD_Plane.EnsurePid(pl)
        CA_PlaneRegister(pl)
        CadApp.mode = 0
        CadApp.show_planes = 1
        CA_PlaneClearPick()
        PrintMessage("cad_app: active plane pid=")
        PrintNumber(CAD_Plane.GetPid(pl))
        PrintMessage("\n")
        ReturnValue(0)
    }
}

Function.CA_PlaneActivateIdx {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(idx, CadApp.plane_n) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.plane_list, 0) ThenBlock: { ReturnValue(-1) }
        pl = ArrayGet(CadApp.plane_list, idx)
        ReturnValue(CA_PlaneActivateHandle(pl))
    }
}

// New construction plane from a planar face. Does NOT start a sketch.
Function.CA_PlaneFromFace {
    Input: face_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_Log("cad_app: From Face needs solid\n", 31)
            ReturnValue(-1)
        }
        IfCondition EqualTo(face_handle, 0) ThenBlock: {
            CA_Log("cad_app: From Face needs face\n", 30)
            ReturnValue(-2)
        }
        CA_EnsurePlane()
        CadApp.pick_best_f = CadApp.plane
        IfCondition EqualTo(CadApp.pick_best_f, 0) ThenBlock: {
            CadApp.pick_best_f = CadApp.sk0_plane
        }
        CadApp.last_face = face_handle
        pl = CAD_Plane.CreateFromFace(CadApp.last_face, CadApp.solid)
        IfCondition EqualTo(pl, 0) ThenBlock: {
            CA_Log("cad_app: plane FAIL (need planar face)\n", 39)
            ReturnValue(-2)
        }
        CadApp.plane = pl
        CAD_Plane.SetParent(CadApp.plane, CadApp.pick_best_f)
        CAD_Plane.EnsurePid(CadApp.plane)
        CA_FacePlaneFromVerts(CadApp.last_face)
        fr = Allocate(128)
        CAD_Plane.FrameFromFacePlane(CadAppPick.pl, fr)
        CAD_Plane.WriteCacheFromFrame(CadApp.plane, fr)
        CA_OrientPlaneOutward(CadApp.last_face, CadApp.solid)
        fl = CAD_Store.Read(CadApp.plane, 18)
        CAD_Store.Write(CadApp.plane, 18, BitwiseOr(fl, 4))
        Deallocate(fr, 128)
        CA_PlaneRegister(CadApp.plane)
        CadApp.mode = 0
        CadApp.show_planes = 1
        CA_PlaneClearPick()
        CA_LookAlongActivePlane()
        PrintMessage("cad_app: plane from face pid=")
        PrintNumber(CAD_Plane.GetPid(CadApp.plane))
        PrintMessage(" (Sketch on Plane to draw)\n")
        ReturnValue(0)
    }
}

// View-ray at pixel into CadAppPick.wx/d* (same basis as face pick).
Function.CA_RaySetup {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        CA_PickBufs()
        IfCondition EqualTo(CadAppPick.fr, 0) ThenBlock: { ReturnValue(-1) }
        CA_BuildViewFrame(CadAppPick.fr)
        CA_CamBasis()
        cx = ArrayGet(CadAppPick.fr, 0)
        cy = ArrayGet(CadAppPick.fr, 1)
        cz = ArrayGet(CadAppPick.fr, 2)
        sc = ArrayGet(CadAppPick.fr, 3)
        hw = ArrayGet(CadAppPick.fr, 4)
        hh = ArrayGet(CadAppPick.fr, 5)
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: { ReturnValue(-1) }
        uu = Float_Sub(Float_Div(Float_Sub(Float_FromInt(px), hw), sc), CAD_View_State.pan_u)
        vv = Float_Sub(Float_Div(Float_Sub(hh, Float_FromInt(py)), sc), CAD_View_State.pan_v)
        CadAppPick.wx = Float_Add(cx, Float_Add(Float_Mul(uu, CadAppPick.rx), Float_Mul(vv, CadAppPick.ux)))
        CadAppPick.wy = Float_Add(cy, Float_Add(Float_Mul(uu, CadAppPick.ry), Float_Mul(vv, CadAppPick.uy)))
        CadAppPick.wz = Float_Add(cz, Float_Add(Float_Mul(uu, CadAppPick.rz), Float_Mul(vv, CadAppPick.uz)))
        CadAppPick.dx = Float_Sub(0, CadAppPick.cdx)
        CadAppPick.dy = Float_Sub(0, CadAppPick.cdy)
        CadAppPick.dz = Float_Sub(0, CadAppPick.cdz)
        ReturnValue(0)
    }
}

// Front-most registered construction plane under the pixel (drawn square / face).
Function.CA_PickPlaneAt {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.plane_n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.plane_list, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CA_RaySetup(px, py), 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.best_f = 0
        CadAppPick.best_t = 0x42C1D206A0000000
        CadAppPick.hu = Float_FromInt(40)
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, CadApp.plane_n) {
            CadApp.pick_best_f = ArrayGet(CadApp.plane_list, CadAppPick.pi)
            IfCondition NotEqual(CadApp.pick_best_f, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Plane.EvalFrame(CadApp.pick_best_f, CadAppPick.pl), 0) ThenBlock: {
                    CadAppPick.ox = ArrayGet(CadAppPick.pl, 0)
                    CadAppPick.oy = ArrayGet(CadAppPick.pl, 1)
                    CadAppPick.oz = ArrayGet(CadAppPick.pl, 2)
                    CadAppPick.nx = ArrayGet(CadAppPick.pl, 9)
                    CadAppPick.ny = ArrayGet(CadAppPick.pl, 10)
                    CadAppPick.nz = ArrayGet(CadAppPick.pl, 11)
                    CadAppPick.hv = Float_Add(Float_Add(Float_Mul(CadAppPick.dx, CadAppPick.nx), Float_Mul(CadAppPick.dy, CadAppPick.ny)), Float_Mul(CadAppPick.dz, CadAppPick.nz))
                    IfCondition EqualTo(CAD_Num.IsZero(CadAppPick.hv, 0), 0) ThenBlock: {
                        CadAppPick.last_t = Float_Div(Float_Add(Float_Add(Float_Mul(Float_Sub(CadAppPick.ox, CadAppPick.wx), CadAppPick.nx), Float_Mul(Float_Sub(CadAppPick.oy, CadAppPick.wy), CadAppPick.ny)), Float_Mul(Float_Sub(CadAppPick.oz, CadAppPick.wz), CadAppPick.nz)), CadAppPick.hv)
                        ArraySet(CadAppPick.hit, 0, Float_Add(CadAppPick.wx, Float_Mul(CadAppPick.last_t, CadAppPick.dx)))
                        ArraySet(CadAppPick.hit, 1, Float_Add(CadAppPick.wy, Float_Mul(CadAppPick.last_t, CadAppPick.dy)))
                        ArraySet(CadAppPick.hit, 2, Float_Add(CadAppPick.wz, Float_Mul(CadAppPick.last_t, CadAppPick.dz)))
                        CadAppPick.pins = 0
                        IfCondition EqualTo(CAD_Plane.GetMode(CadApp.pick_best_f), 3) ThenBlock: {
                            CadAppPick.face = CAD_Plane.GetFaceHandle(CadApp.pick_best_f)
                            IfCondition NotEqual(CadAppPick.face, 0) ThenBlock: {
                                CadAppPick.pins = CA_FaceContainsHit(CadAppPick.face)
                            }
                        }
                        IfCondition EqualTo(CadAppPick.pins, 0) ThenBlock: {
                            CadAppPick.ax = Float_Add(Float_Add(Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 0), CadAppPick.ox), ArrayGet(CadAppPick.pl, 3)), Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 1), CadAppPick.oy), ArrayGet(CadAppPick.pl, 4))), Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 2), CadAppPick.oz), ArrayGet(CadAppPick.pl, 5)))
                            CadAppPick.ay = Float_Add(Float_Add(Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 0), CadAppPick.ox), ArrayGet(CadAppPick.pl, 6)), Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 1), CadAppPick.oy), ArrayGet(CadAppPick.pl, 7))), Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 2), CadAppPick.oz), ArrayGet(CadAppPick.pl, 8)))
                            IfCondition EqualTo(CAD_Num.Le(CadAppPick.ax, CadAppPick.hu), 1) ThenBlock: {
                                IfCondition EqualTo(CAD_Num.Le(Float_Sub(0, CadAppPick.ax), CadAppPick.hu), 1) ThenBlock: {
                                    IfCondition EqualTo(CAD_Num.Le(CadAppPick.ay, CadAppPick.hu), 1) ThenBlock: {
                                        IfCondition EqualTo(CAD_Num.Le(Float_Sub(0, CadAppPick.ay), CadAppPick.hu), 1) ThenBlock: {
                                            CadAppPick.pins = 1
                                        }
                                    }
                                }
                            }
                        }
                        IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CadAppPick.last_t, CadAppPick.best_t)), 1) ThenBlock: {
                                CadAppPick.best_t = CadAppPick.last_t
                                CadAppPick.best_f = CadApp.pick_best_f
                            }
                        }
                    }
                }
            }
            CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        ReturnValue(CadAppPick.best_f)
    }
}

// Snap CadAppPick.hit to the nearest vertex of fh if within 4 mm.
Function.CA_SnapHitToVertex {
    Input: fh: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(fh, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.face = fh
        CadAppPick.hd = 0
        lp = CAD_Store.Read(CadAppPick.face, 1)
        IfCondition EqualTo(lp, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.hd = CAD_Store.Read(lp, 0)
        IfCondition EqualTo(CadAppPick.hd, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ce = CadAppPick.hd
        CadAppPick.hv = Float_FromInt(16)
        CadAppPick.pins = 0
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, 256) {
            CadAppPick.ov = CAD_Store.Read(CadAppPick.ce, 5)
            IfCondition NotEqual(CadAppPick.ov, 0) ThenBlock: {
                CadAppPick.ax = Float_Sub(CAD_Store.Read(CadAppPick.ov, 0), ArrayGet(CadAppPick.hit, 0))
                CadAppPick.ay = Float_Sub(CAD_Store.Read(CadAppPick.ov, 1), ArrayGet(CadAppPick.hit, 1))
                CadAppPick.bx = Float_Sub(CAD_Store.Read(CadAppPick.ov, 2), ArrayGet(CadAppPick.hit, 2))
                CadAppPick.last_t = Float_Add(Float_Add(Float_Mul(CadAppPick.ax, CadAppPick.ax), Float_Mul(CadAppPick.ay, CadAppPick.ay)), Float_Mul(CadAppPick.bx, CadAppPick.bx))
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CadAppPick.last_t, CadAppPick.hv)), 1) ThenBlock: {
                    CadAppPick.hv = CadAppPick.last_t
                    CadAppPick.ox = CAD_Store.Read(CadAppPick.ov, 0)
                    CadAppPick.oy = CAD_Store.Read(CadAppPick.ov, 1)
                    CadAppPick.oz = CAD_Store.Read(CadAppPick.ov, 2)
                    CadAppPick.pins = 1
                }
            }
            CadAppPick.ce = CAD_Store.Read(CadAppPick.ce, 2)
            CadAppPick.pi = Add(CadAppPick.pi, 1)
            IfCondition EqualTo(CadAppPick.ce, CadAppPick.hd) ThenBlock: { CadAppPick.pi = 256 }
            IfCondition EqualTo(CadAppPick.ce, 0) ThenBlock: { CadAppPick.pi = 256 }
        }
        IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: {
            ArraySet(CadAppPick.hit, 0, CadAppPick.ox)
            ArraySet(CadAppPick.hit, 1, CadAppPick.oy)
            ArraySet(CadAppPick.hit, 2, CadAppPick.oz)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// World hit at pixel: face (vertex-snapped) else active/world plane. 1 = ok.
Function.CA_PickWorldAt {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
            CadAppPick.quiet = 1
            fh = CA_PickFaceAt(px, py)
            CadAppPick.quiet = 0
            IfCondition NotEqual(fh, 0) ThenBlock: {
                CA_SnapHitToVertex(fh)
                ReturnValue(1)
            }
        }
        IfCondition NotEqual(CA_RaySetup(px, py), 0) ThenBlock: { ReturnValue(0) }
        pl = CadApp.plane
        IfCondition EqualTo(pl, 0) ThenBlock: { pl = CadApp.sk0_plane }
        IfCondition NotEqual(pl, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Plane.EvalFrame(pl, CadAppPick.pl), 0) ThenBlock: {
                CadAppPick.ox = ArrayGet(CadAppPick.pl, 0)
                CadAppPick.oy = ArrayGet(CadAppPick.pl, 1)
                CadAppPick.oz = ArrayGet(CadAppPick.pl, 2)
                CadAppPick.nx = ArrayGet(CadAppPick.pl, 9)
                CadAppPick.ny = ArrayGet(CadAppPick.pl, 10)
                CadAppPick.nz = ArrayGet(CadAppPick.pl, 11)
                den = Float_Add(Float_Add(Float_Mul(CadAppPick.dx, CadAppPick.nx), Float_Mul(CadAppPick.dy, CadAppPick.ny)), Float_Mul(CadAppPick.dz, CadAppPick.nz))
                IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                    CadAppPick.last_t = Float_Div(Float_Add(Float_Add(Float_Mul(Float_Sub(CadAppPick.ox, CadAppPick.wx), CadAppPick.nx), Float_Mul(Float_Sub(CadAppPick.oy, CadAppPick.wy), CadAppPick.ny)), Float_Mul(Float_Sub(CadAppPick.oz, CadAppPick.wz), CadAppPick.nz)), den)
                    ArraySet(CadAppPick.hit, 0, Float_Add(CadAppPick.wx, Float_Mul(CadAppPick.last_t, CadAppPick.dx)))
                    ArraySet(CadAppPick.hit, 1, Float_Add(CadAppPick.wy, Float_Mul(CadAppPick.last_t, CadAppPick.dy)))
                    ArraySet(CadAppPick.hit, 2, Float_Add(CadAppPick.wz, Float_Mul(CadAppPick.last_t, CadAppPick.dz)))
                    ReturnValue(1)
                }
            }
        }
        ReturnValue(0)
    }
}

Function.CA_PlaneSetOriginAtHit {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadAppPick.hit, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(CAD_Plane.EvalFrame(CadApp.plane, CadAppPick.pl), 0) ThenBlock: {
            ReturnValue(-1)
        }
        CadAppPick.ox = ArrayGet(CadAppPick.pl, 0)
        CadAppPick.oy = ArrayGet(CadAppPick.pl, 1)
        CadAppPick.oz = ArrayGet(CadAppPick.pl, 2)
        CadAppPick.ax = Float_Add(Float_Add(Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 0), CadAppPick.ox), ArrayGet(CadAppPick.pl, 3)), Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 1), CadAppPick.oy), ArrayGet(CadAppPick.pl, 4))), Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 2), CadAppPick.oz), ArrayGet(CadAppPick.pl, 5)))
        CadAppPick.ay = Float_Add(Float_Add(Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 0), CadAppPick.ox), ArrayGet(CadAppPick.pl, 6)), Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 1), CadAppPick.oy), ArrayGet(CadAppPick.pl, 7))), Float_Mul(Float_Sub(ArrayGet(CadAppPick.hit, 2), CadAppPick.oz), ArrayGet(CadAppPick.pl, 8)))
        CAD_Plane.TranslateLocal(CadApp.plane, CadAppPick.ax, CadAppPick.ay, 0)
        CadApp.show_planes = 1
        CA_Log("cad_app: plane origin set (projected click / vertex)\n", 53)
        ReturnValue(0)
    }
}

Function.CA_PlaneCommit3Pt {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.pln_xyz, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(CadApp.pln_ptn, 3) ThenBlock: { ReturnValue(-1) }
        CadAppPick.ox = ArrayGet(CadApp.pln_xyz, 0)
        CadAppPick.oy = ArrayGet(CadApp.pln_xyz, 1)
        CadAppPick.oz = ArrayGet(CadApp.pln_xyz, 2)
        CadAppPick.dx = Float_Sub(ArrayGet(CadApp.pln_xyz, 3), CadAppPick.ox)
        CadAppPick.dy = Float_Sub(ArrayGet(CadApp.pln_xyz, 4), CadAppPick.oy)
        CadAppPick.dz = Float_Sub(ArrayGet(CadApp.pln_xyz, 5), CadAppPick.oz)
        CadAppPick.rx = Float_Sub(ArrayGet(CadApp.pln_xyz, 6), CadAppPick.ox)
        CadAppPick.ry = Float_Sub(ArrayGet(CadApp.pln_xyz, 7), CadAppPick.oy)
        CadAppPick.rz = Float_Sub(ArrayGet(CadApp.pln_xyz, 8), CadAppPick.oz)
        CadAppPick.nx = Float_Sub(Float_Mul(CadAppPick.dy, CadAppPick.rz), Float_Mul(CadAppPick.dz, CadAppPick.ry))
        CadAppPick.ny = Float_Sub(Float_Mul(CadAppPick.dz, CadAppPick.rx), Float_Mul(CadAppPick.dx, CadAppPick.rz))
        CadAppPick.nz = Float_Sub(Float_Mul(CadAppPick.dx, CadAppPick.ry), Float_Mul(CadAppPick.dy, CadAppPick.rx))
        CadAppPick.hv = Float_Add(Float_Add(Float_Mul(CadAppPick.nx, CadAppPick.nx), Float_Mul(CadAppPick.ny, CadAppPick.ny)), Float_Mul(CadAppPick.nz, CadAppPick.nz))
        IfCondition EqualTo(CAD_Num.IsZero(CadAppPick.hv, 0), 1) ThenBlock: {
            CA_Log("cad_app: 3pt plane FAIL (colinear)\n", 35)
            CadApp.pln_ptn = 0
            ReturnValue(-2)
        }
        CadAppPick.last_t = CAD_Num.Sqrt(CadAppPick.hv)
        IfCondition EqualTo(CAD_Num.IsZero(CadAppPick.last_t, 0), 1) ThenBlock: {
            CA_Log("cad_app: 3pt plane FAIL (normal)\n", 33)
            CadApp.pln_ptn = 0
            ReturnValue(-2)
        }
        CadAppPick.nx = Float_Div(CadAppPick.nx, CadAppPick.last_t)
        CadAppPick.ny = Float_Div(CadAppPick.ny, CadAppPick.last_t)
        CadAppPick.nz = Float_Div(CadAppPick.nz, CadAppPick.last_t)
        CadAppPick.hv = Float_Add(Float_Add(Float_Mul(CadAppPick.dx, CadAppPick.dx), Float_Mul(CadAppPick.dy, CadAppPick.dy)), Float_Mul(CadAppPick.dz, CadAppPick.dz))
        IfCondition EqualTo(CAD_Num.IsZero(CadAppPick.hv, 0), 1) ThenBlock: {
            CA_Log("cad_app: 3pt plane FAIL (edge)\n", 31)
            CadApp.pln_ptn = 0
            ReturnValue(-2)
        }
        CadAppPick.last_t = CAD_Num.Sqrt(CadAppPick.hv)
        CadAppPick.dx = Float_Div(CadAppPick.dx, CadAppPick.last_t)
        CadAppPick.dy = Float_Div(CadAppPick.dy, CadAppPick.last_t)
        CadAppPick.dz = Float_Div(CadAppPick.dz, CadAppPick.last_t)
        // Y = N × X
        CadAppPick.ux = Float_Sub(Float_Mul(CadAppPick.ny, CadAppPick.dz), Float_Mul(CadAppPick.nz, CadAppPick.dy))
        CadAppPick.uy = Float_Sub(Float_Mul(CadAppPick.nz, CadAppPick.dx), Float_Mul(CadAppPick.nx, CadAppPick.dz))
        CadAppPick.uz = Float_Sub(Float_Mul(CadAppPick.nx, CadAppPick.dy), Float_Mul(CadAppPick.ny, CadAppPick.dx))
        fr = Allocate(128)
        ArraySet(fr, 0, CadAppPick.ox)
        ArraySet(fr, 1, CadAppPick.oy)
        ArraySet(fr, 2, CadAppPick.oz)
        ArraySet(fr, 3, CadAppPick.dx)
        ArraySet(fr, 4, CadAppPick.dy)
        ArraySet(fr, 5, CadAppPick.dz)
        ArraySet(fr, 6, CadAppPick.ux)
        ArraySet(fr, 7, CadAppPick.uy)
        ArraySet(fr, 8, CadAppPick.uz)
        ArraySet(fr, 9, CadAppPick.nx)
        ArraySet(fr, 10, CadAppPick.ny)
        ArraySet(fr, 11, CadAppPick.nz)
        CA_EnsurePlane()
        CadApp.pick_best_f = CadApp.sk0_plane
        pl = CAD_Plane.CreateFromFrame(fr)
        Deallocate(fr, 128)
        IfCondition EqualTo(pl, 0) ThenBlock: {
            CA_Log("cad_app: 3pt plane FAIL (alloc)\n", 32)
            ReturnValue(-2)
        }
        CadApp.plane = pl
        CAD_Plane.SetParent(CadApp.plane, CadApp.pick_best_f)
        CAD_Plane.EnsurePid(CadApp.plane)
        CA_PlaneRegister(CadApp.plane)
        CadApp.mode = 0
        CadApp.show_planes = 1
        CA_PlaneClearPick()
        CA_LookAlongActivePlane()
        PrintMessage("cad_app: plane through 3 pts pid=")
        PrintNumber(CAD_Plane.GetPid(CadApp.plane))
        PrintMessage("\n")
        ReturnValue(0)
    }
}

// Dispatch a 3D click while a construction-plane gesture is armed.
Function.CA_PlanePickClick {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.plane_pick, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.plane_pick, 1) ThenBlock: {
            pl = CA_PickPlaneAt(px, py)
            IfCondition EqualTo(pl, 0) ThenBlock: {
                CA_Log("cad_app: plane miss - click a cyan square or tree Plane row\n", 60)
                ReturnValue(1)
            }
            CA_PlaneActivateHandle(pl)
            CA_LookAlongActivePlane()
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.plane_pick, 2) ThenBlock: {
            IfCondition NotEqual(CadApp.click_shift, 0) ThenBlock: {
                CadApp.hover_face = CA_PickFaceNext(px, py, CadApp.hover_face)
                CadApp.click_shift = 0
                ReturnValue(1)
            }
            fh = CA_PickFaceAt(px, py)
            IfCondition EqualTo(fh, 0) ThenBlock: { fh = CadApp.hover_face }
            IfCondition EqualTo(fh, 0) ThenBlock: {
                CA_Log("cad_app: face miss - orbit and click the solid\n", 47)
                ReturnValue(1)
            }
            CA_PlaneFromFace(fh)
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.plane_pick, 3) ThenBlock: {
            IfCondition EqualTo(CA_PickWorldAt(px, py), 0) ThenBlock: {
                CA_Log("cad_app: origin miss - click a face or the plane\n", 50)
                ReturnValue(1)
            }
            CA_PlaneSetOriginAtHit()
            CA_PlaneClearPick()
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.plane_pick, 4) ThenBlock: {
            IfCondition EqualTo(CadApp.pln_xyz, 0) ThenBlock: {
                CadApp.pln_xyz = Allocate(96)
            }
            IfCondition EqualTo(CA_PickWorldAt(px, py), 0) ThenBlock: {
                CA_Log("cad_app: 3pt miss - click a face, vertex, or plane\n", 51)
                ReturnValue(1)
            }
            b = Multiply(CadApp.pln_ptn, 3)
            ArraySet(CadApp.pln_xyz, b, ArrayGet(CadAppPick.hit, 0))
            ArraySet(CadApp.pln_xyz, Add(b, 1), ArrayGet(CadAppPick.hit, 1))
            ArraySet(CadApp.pln_xyz, Add(b, 2), ArrayGet(CadAppPick.hit, 2))
            CadApp.pln_ptn = Add(CadApp.pln_ptn, 1)
            CA_LogInt("cad_app: 3pt point ", 19, CadApp.pln_ptn)
            IfCondition GreaterEqual(CadApp.pln_ptn, 3) ThenBlock: {
                CA_PlaneCommit3Pt()
            }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
