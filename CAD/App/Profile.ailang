// Mirror all sketch entities across X-axis (axis=0: y→-y) or Y-axis (axis=1: x→-x).
// Adds mirrored copies (keeps originals). Returns count of new entities or -1.
Function.CA_MirrorSketch {
    Input: axis: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: mirror needs sketch\n", 29)
            ReturnValue(-1)
        }
        sk = CadApp.sketch
        added = 0
        // --- lines ---
        nl = CAD_Sketch.GetLineCount(sk)
        lines = CAD_Store.Read(sk, 1)
        // snapshot count so we do not mirror newly added lines
        i = 0
        WhileLoop LessThan(i, nl) {
            b = Multiply(i, 4)
            x0 = ArrayGet(lines, b)
            y0 = ArrayGet(lines, Add(b, 1))
            x1 = ArrayGet(lines, Add(b, 2))
            y1 = ArrayGet(lines, Add(b, 3))
            IfCondition EqualTo(axis, 0) ThenBlock: {
                // across X-axis: y → -y
                y0m = Float_Sub(0, y0)
                y1m = Float_Sub(0, y1)
                CAD_Sketch.AddLine(sk, x0, y0m, x1, y1m)
            }
            IfCondition EqualTo(axis, 1) ThenBlock: {
                // across Y-axis: x → -x
                x0m = Float_Sub(0, x0)
                x1m = Float_Sub(0, x1)
                CAD_Sketch.AddLine(sk, x0m, y0, x1m, y1)
            }
            added = Add(added, 1)
            i = Add(i, 1)
        }
        // --- circles ---
        nc = CAD_Sketch.GetCircleCount(sk)
        circs = CAD_Store.Read(sk, 8)
        i = 0
        WhileLoop LessThan(i, nc) {
            b = Multiply(i, 3)
            cx = ArrayGet(circs, b)
            cy = ArrayGet(circs, Add(b, 1))
            rad = ArrayGet(circs, Add(b, 2))
            IfCondition EqualTo(axis, 0) ThenBlock: {
                CAD_Sketch.AddCircle(sk, cx, Float_Sub(0, cy), rad)
            }
            IfCondition EqualTo(axis, 1) ThenBlock: {
                CAD_Sketch.AddCircle(sk, Float_Sub(0, cx), cy, rad)
            }
            added = Add(added, 1)
            i = Add(i, 1)
        }
        // --- arcs: mirror center + flip angles ---
        na = CAD_Sketch.GetArcCount(sk)
        arcs = CAD_Store.Read(sk, 11)
        i = 0
        WhileLoop LessThan(i, na) {
            b = Multiply(i, 5)
            cx = ArrayGet(arcs, b)
            cy = ArrayGet(arcs, Add(b, 1))
            rad = ArrayGet(arcs, Add(b, 2))
            a0 = ArrayGet(arcs, Add(b, 3))
            a1 = ArrayGet(arcs, Add(b, 4))
            pi = 0x400921FB54442D18
            IfCondition EqualTo(axis, 0) ThenBlock: {
                // y→-y: angles negate and swap for CCW orientation
                CAD_Sketch.AddArc(sk, cx, Float_Sub(0, cy), rad, Float_Sub(0, a1), Float_Sub(0, a0))
            }
            IfCondition EqualTo(axis, 1) ThenBlock: {
                // x→-x: θ → π - θ, swap ends
                na0 = Float_Sub(pi, a1)
                na1 = Float_Sub(pi, a0)
                CAD_Sketch.AddArc(sk, Float_Sub(0, cx), cy, rad, na0, na1)
            }
            added = Add(added, 1)
            i = Add(i, 1)
        }
        // --- user points ---
        nup = CAD_Sketch.GetUserPointCount(sk)
        i = 0
        upxy = Allocate(32)
        WhileLoop LessThan(i, nup) {
            CAD_Sketch.GetUserPoint(sk, i, upxy)
            ux = ArrayGet(upxy, 0)
            uy = ArrayGet(upxy, 1)
            IfCondition EqualTo(axis, 0) ThenBlock: {
                CAD_Sketch.AddUserPoint(sk, ux, Float_Sub(0, uy), 0)
            }
            IfCondition EqualTo(axis, 1) ThenBlock: {
                CAD_Sketch.AddUserPoint(sk, Float_Sub(0, ux), uy, 0)
            }
            added = Add(added, 1)
            i = Add(i, 1)
        }
        Deallocate(upxy, 32)
        CA_InvalidateProfiles()
        CadApp.dirty = 1
        CadApp.mode = 1
        IfCondition EqualTo(axis, 0) ThenBlock: {
            CA_Log("cad_app: mirror across X (y->-y)\n", 33)
        }
        IfCondition EqualTo(axis, 1) ThenBlock: {
            CA_Log("cad_app: mirror across Y (x->-x)\n", 33)
        }
        ReturnValue(added)
    }
}

// Count closed profiles WITHOUT mutating live sketch (no tessellate-on-live).


// Weld all line endpoints that fall within snap radius so BuildClosedLoop can chain.
Function.CA_WeldSketch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
            sc = 0x3FF0000000000000
        }
        // tight weld only — large snap was collapsing inset notches into a triangle
        snap = Float_Div(Float_FromInt(8), sc)
        snap2 = Float_Mul(snap, snap)
        nl = CAD_Sketch.GetLineCount(CadApp.sketch)
        IfCondition LessThan(nl, 2) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(CadApp.sketch, 1)
        npts = Multiply(nl, 2)
        pass = 0
        WhileLoop LessThan(pass, 3) {
            i = 0
            WhileLoop LessThan(i, npts) {
                li = Divide(i, 2)
                ei = Modulo(i, 2)
                bi = Multiply(li, 4)
                IfCondition EqualTo(ei, 0) ThenBlock: {
                    ix = ArrayGet(lines, bi)
                    iy = ArrayGet(lines, Add(bi, 1))
                }
                IfCondition EqualTo(ei, 1) ThenBlock: {
                    ix = ArrayGet(lines, Add(bi, 2))
                    iy = ArrayGet(lines, Add(bi, 3))
                }
                j = Add(i, 1)
                WhileLoop LessThan(j, npts) {
                    lj = Divide(j, 2)
                    // never weld the two ends of the SAME segment
                    IfCondition NotEqual(li, lj) ThenBlock: {
                        ej = Modulo(j, 2)
                        bj = Multiply(lj, 4)
                        IfCondition EqualTo(ej, 0) ThenBlock: {
                            jx = ArrayGet(lines, bj)
                            jy = ArrayGet(lines, Add(bj, 1))
                        }
                        IfCondition EqualTo(ej, 1) ThenBlock: {
                            jx = ArrayGet(lines, Add(bj, 2))
                            jy = ArrayGet(lines, Add(bj, 3))
                        }
                        dx = Float_Sub(ix, jx)
                        dy = Float_Sub(iy, jy)
                        d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                        IfCondition EqualTo(Float_Le(d2, snap2), 1) ThenBlock: {
                            mx = Float_Mul(Float_Add(ix, jx), 0x3FE0000000000000)
                            my = Float_Mul(Float_Add(iy, jy), 0x3FE0000000000000)
                            IfCondition EqualTo(ei, 0) ThenBlock: {
                                ArraySet(lines, bi, mx)
                                ArraySet(lines, Add(bi, 1), my)
                            }
                            IfCondition EqualTo(ei, 1) ThenBlock: {
                                ArraySet(lines, Add(bi, 2), mx)
                                ArraySet(lines, Add(bi, 3), my)
                            }
                            IfCondition EqualTo(ej, 0) ThenBlock: {
                                ArraySet(lines, bj, mx)
                                ArraySet(lines, Add(bj, 1), my)
                            }
                            IfCondition EqualTo(ej, 1) ThenBlock: {
                                ArraySet(lines, Add(bj, 2), mx)
                                ArraySet(lines, Add(bj, 3), my)
                            }
                            ix = mx
                            iy = my
                        }
                    }
                    j = Add(j, 1)
                }
                i = Add(i, 1)
            }
            pass = Add(pass, 1)
        }
        // clear cached loop so rebuild is forced
        CAD_Store.Write(CadApp.sketch, 2, 0)
        CAD_Store.Write(CadApp.sketch, 12, 0)
        ReturnValue(1)
    }
}

// Clear profile cache after geometry edits (must Profiles + select again).
// Does NOT touch lines/arcs/circles — only profile overlay cache.


// Clear profile cache after geometry edits (must Profiles + select again).
// Does NOT touch lines/arcs/circles — only profile overlay cache.
Function.CA_InvalidateProfiles {
    Output: Integer
    Body: {
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            CAD_Store.Write(CadApp.sketch, 2, 0)
            CAD_Store.Write(CadApp.sketch, 12, 0)
        }
        CadApp.nprof = 0
        CadApp.prof_sel = 0
        CadApp.prof_user = 0
        CadApp.prof_mask = 0
        ReturnValue(0)
    }
}

// Copy lines + circles + arcs from src sketch into empty dst (geometry only).


// Copy lines + circles + arcs from src sketch into empty dst (geometry only).
Function.CA_CopySketchGeom {
    Input: src: Integer
    Input: dst: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        // lines
        nl = CAD_Store.Read(src, 0)
        sl = CAD_Store.Read(src, 1)
        i = 0
        WhileLoop LessThan(i, nl) {
            b = Multiply(i, 4)
            CAD_Sketch.AddLine(dst, ArrayGet(sl, b), ArrayGet(sl, Add(b, 1)), ArrayGet(sl, Add(b, 2)), ArrayGet(sl, Add(b, 3)))
            i = Add(i, 1)
        }
        // circles
        nc = CAD_Store.Read(src, 7)
        sc = CAD_Store.Read(src, 8)
        i = 0
        WhileLoop LessThan(i, nc) {
            b = Multiply(i, 3)
            CAD_Sketch.AddCircle(dst, ArrayGet(sc, b), ArrayGet(sc, Add(b, 1)), ArrayGet(sc, Add(b, 2)))
            i = Add(i, 1)
        }
        // arcs (keep as arcs — projection clone will tessellate)
        na = CAD_Store.Read(src, 10)
        sa = CAD_Store.Read(src, 11)
        i = 0
        WhileLoop LessThan(i, na) {
            b = Multiply(i, 5)
            CAD_Sketch.AddArc(dst, ArrayGet(sa, b), ArrayGet(sa, Add(b, 1)), ArrayGet(sa, Add(b, 2)), ArrayGet(sa, Add(b, 3)), ArrayGet(sa, Add(b, 4)))
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Copy projected profile rings from src into dst profile pool only.
// Leaves dst lines/circles/arcs untouched.


// Copy projected profile rings from src into dst profile pool only.
// Leaves dst lines/circles/arcs untouched.
Function.CA_CopyProfilesOnly {
    Input: src: Integer
    Input: dst: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        nprof = CAD_Store.Read(src, 12)
        IfCondition GreaterThan(nprof, 64) ThenBlock: { nprof = 64 }
        IfCondition EqualTo(nprof, 0) ThenBlock: {
            CAD_Store.Write(dst, 12, 0)
            CAD_Store.Write(dst, 2, 0)
            ReturnValue(0)
        }
        pool = CAD_Store.Read(dst, 14)
        pmeta = CAD_Store.Read(dst, 13)
        loop = CAD_Store.Read(dst, 3)
        cap_p = CAD_Store.Read(dst, 15)
        xy = Allocate(65536)
        pool_n = 0
        pi = 0
        n_out = 0
        WhileLoop LessThan(pi, nprof) {
            IfCondition LessThan(n_out, cap_p) ThenBlock: {
                nn = CAD_Sketch.GetProfileXY(src, pi, xy)
                IfCondition GreaterEqual(nn, 3) ThenBlock: {
                    ArraySet(pmeta, Multiply(n_out, 2), nn)
                    ArraySet(pmeta, Add(Multiply(n_out, 2), 1), pool_n)
                    k = 0
                    WhileLoop LessThan(k, nn) {
                        ArraySet(pool, Multiply(Add(pool_n, k), 2), ArrayGet(xy, Multiply(k, 2)))
                        ArraySet(pool, Add(Multiply(Add(pool_n, k), 2), 1), ArrayGet(xy, Add(Multiply(k, 2), 1)))
                        k = Add(k, 1)
                    }
                    pool_n = Add(pool_n, nn)
                    n_out = Add(n_out, 1)
                }
            }
            pi = Add(pi, 1)
        }
        CAD_Store.Write(dst, 12, n_out)
        // primary loop = profile 0
        IfCondition GreaterThan(n_out, 0) ThenBlock: {
            nn0 = ArrayGet(pmeta, 0)
            off0 = ArrayGet(pmeta, 1)
            k = 0
            WhileLoop LessThan(k, nn0) {
                ArraySet(loop, Multiply(k, 2), ArrayGet(pool, Multiply(Add(off0, k), 2)))
                ArraySet(loop, Add(Multiply(k, 2), 1), ArrayGet(pool, Add(Multiply(Add(off0, k), 2), 1)))
                k = Add(k, 1)
            }
            CAD_Store.Write(dst, 2, nn0)
        }
        Deallocate(xy, 65536)
        ReturnValue(n_out)
    }
}

// Weld endpoints on a given sketch handle (projection clone).


// Weld endpoints on a given sketch handle (projection clone).
Function.CA_WeldSketchHandle {
    Input: sk: Integer
    Input: px_tol: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sk, 0) ThenBlock: { ReturnValue(0) }
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
            sc = 0x3FF0000000000000
        }
        snap = Float_Div(Float_FromInt(px_tol), sc)
        snap2 = Float_Mul(snap, snap)
        nl = CAD_Sketch.GetLineCount(sk)
        IfCondition LessThan(nl, 2) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(sk, 1)
        npts = Multiply(nl, 2)
        pass = 0
        WhileLoop LessThan(pass, 4) {
            i = 0
            WhileLoop LessThan(i, npts) {
                li = Divide(i, 2)
                ei = Modulo(i, 2)
                bi = Multiply(li, 4)
                IfCondition EqualTo(ei, 0) ThenBlock: {
                    ix = ArrayGet(lines, bi)
                    iy = ArrayGet(lines, Add(bi, 1))
                }
                IfCondition EqualTo(ei, 1) ThenBlock: {
                    ix = ArrayGet(lines, Add(bi, 2))
                    iy = ArrayGet(lines, Add(bi, 3))
                }
                j = Add(i, 1)
                WhileLoop LessThan(j, npts) {
                    lj = Divide(j, 2)
                    IfCondition NotEqual(li, lj) ThenBlock: {
                        ej = Modulo(j, 2)
                        bj = Multiply(lj, 4)
                        IfCondition EqualTo(ej, 0) ThenBlock: {
                            jx = ArrayGet(lines, bj)
                            jy = ArrayGet(lines, Add(bj, 1))
                        }
                        IfCondition EqualTo(ej, 1) ThenBlock: {
                            jx = ArrayGet(lines, Add(bj, 2))
                            jy = ArrayGet(lines, Add(bj, 3))
                        }
                        dx = Float_Sub(ix, jx)
                        dy = Float_Sub(iy, jy)
                        d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                        IfCondition EqualTo(Float_Le(d2, snap2), 1) ThenBlock: {
                            mx = Float_Mul(Float_Add(ix, jx), 0x3FE0000000000000)
                            my = Float_Mul(Float_Add(iy, jy), 0x3FE0000000000000)
                            IfCondition EqualTo(ei, 0) ThenBlock: {
                                ArraySet(lines, bi, mx)
                                ArraySet(lines, Add(bi, 1), my)
                            }
                            IfCondition EqualTo(ei, 1) ThenBlock: {
                                ArraySet(lines, Add(bi, 2), mx)
                                ArraySet(lines, Add(bi, 3), my)
                            }
                            IfCondition EqualTo(ej, 0) ThenBlock: {
                                ArraySet(lines, bj, mx)
                                ArraySet(lines, Add(bj, 1), my)
                            }
                            IfCondition EqualTo(ej, 1) ThenBlock: {
                                ArraySet(lines, Add(bj, 2), mx)
                                ArraySet(lines, Add(bj, 3), my)
                            }
                            ix = mx
                            iy = my
                        }
                    }
                    j = Add(j, 1)
                }
                i = Add(i, 1)
            }
            pass = Add(pass, 1)
        }
        ReturnValue(1)
    }
}

// Point-in-polygon (ray cast). xy = n pairs. Returns 1 if inside.


// Point-in-polygon (ray cast). xy = n pairs. Returns 1 if inside.
Function.CA_PointInPoly {
    Input: wx: Integer
    Input: wy: Integer
    Input: xy: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        inside = 0
        i = 0
        j = Subtract(n, 1)
        WhileLoop LessThan(i, n) {
            xi = ArrayGet(xy, Multiply(i, 2))
            yi = ArrayGet(xy, Add(Multiply(i, 2), 1))
            xj = ArrayGet(xy, Multiply(j, 2))
            yj = ArrayGet(xy, Add(Multiply(j, 2), 1))
            // (yi > wy) != (yj > wy)  using wy < yi style: Float_Le(wy,yi)==0 means yi > wy
            a = 0
            b = 0
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(wy, yi)), 1) ThenBlock: { a = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(wy, yj)), 1) ThenBlock: { b = 1 }
            IfCondition NotEqual(a, b) ThenBlock: {
                den = Float_Sub(yj, yi)
                IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                    xint = Float_Add(xi, Float_Mul(Float_Sub(xj, xi), Float_Div(Float_Sub(wy, yi), den)))
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(wx, xint)), 1) ThenBlock: {
                        inside = Subtract(1, inside)
                    }
                }
            }
            j = i
            i = Add(i, 1)
        }
        ReturnValue(inside)
    }
}

// 1 if (px,py) lies on an edge of ring xy[n] (eps ≈ 0.05 mm).
Function.CA_PtOnRing {
    Input: px: Integer
    Input: py: Integer
    Input: xy: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 2) ThenBlock: { ReturnValue(0) }
        // 0.05²
        eps2 = 0x3F847AE147AE147B
        one = 0x3FF0000000000000
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n) ThenBlock: { j = 0 }
            ax = ArrayGet(xy, Multiply(i, 2))
            ay = ArrayGet(xy, Add(Multiply(i, 2), 1))
            bx = ArrayGet(xy, Multiply(j, 2))
            by = ArrayGet(xy, Add(Multiply(j, 2), 1))
            abx = Float_Sub(bx, ax)
            aby = Float_Sub(by, ay)
            apx = Float_Sub(px, ax)
            apy = Float_Sub(py, ay)
            ab2 = Float_Add(Float_Mul(abx, abx), Float_Mul(aby, aby))
            d2 = Float_Add(Float_Mul(apx, apx), Float_Mul(apy, apy))
            IfCondition EqualTo(CAD_Num.IsZero(ab2, 0), 0) ThenBlock: {
                t = Float_Div(Float_Add(Float_Mul(apx, abx), Float_Mul(apy, aby)), ab2)
                IfCondition EqualTo(CAD_Num.IsNeg(t), 1) ThenBlock: { t = 0 }
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(one, t)), 1) ThenBlock: { t = one }
                dx = Float_Sub(apx, Float_Mul(t, abx))
                dy = Float_Sub(apy, Float_Mul(t, aby))
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
            }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d2, eps2)), 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(CAD_Num.IsZero(d2, 0), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Replace outer's shared chord with loop's complementary chain (boundary notch).
// Returns new vertex count, or 0 if the loop is not a 2-port notch.
Function.CA_SpliceNotch {
    Input: oxy: Address
    Input: on: Integer
    Input: lxy: Address
    Input: ln: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        IfCondition LessThan(on, 3) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(ln, 3) ThenBlock: { ReturnValue(0) }
        on_n = 0
        j0 = -1
        j1 = -1
        j = 0
        WhileLoop LessThan(j, ln) {
            px = ArrayGet(lxy, Multiply(j, 2))
            py = ArrayGet(lxy, Add(Multiply(j, 2), 1))
            IfCondition EqualTo(CA_PtOnRing(px, py, oxy, on), 1) ThenBlock: {
                IfCondition EqualTo(j0, -1) ThenBlock: { j0 = j }
                j1 = j
                on_n = Add(on_n, 1)
            }
            j = Add(j, 1)
        }
        IfCondition LessThan(on_n, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(j0, j1) ThenBlock: { ReturnValue(0) }
        // nearest outer verts to the two ports
        i0 = 0
        i1 = 0
        best0 = 0x7FF0000000000000
        best1 = 0x7FF0000000000000
        px0 = ArrayGet(lxy, Multiply(j0, 2))
        py0 = ArrayGet(lxy, Add(Multiply(j0, 2), 1))
        px1 = ArrayGet(lxy, Multiply(j1, 2))
        py1 = ArrayGet(lxy, Add(Multiply(j1, 2), 1))
        i = 0
        WhileLoop LessThan(i, on) {
            ox = ArrayGet(oxy, Multiply(i, 2))
            oy = ArrayGet(oxy, Add(Multiply(i, 2), 1))
            d0 = Float_Add(Float_Mul(Float_Sub(ox, px0), Float_Sub(ox, px0)), Float_Mul(Float_Sub(oy, py0), Float_Sub(oy, py0)))
            d1 = Float_Add(Float_Mul(Float_Sub(ox, px1), Float_Sub(ox, px1)), Float_Mul(Float_Sub(oy, py1), Float_Sub(oy, py1)))
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d0, best0)), 1) ThenBlock: {
                best0 = d0
                i0 = i
            }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d1, best1)), 1) ThenBlock: {
                best1 = d1
                i1 = i
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(i0, i1) ThenBlock: { ReturnValue(0) }
        // choose L-path j0→j1 with more off-ring verts (the notch, not the chord)
        fwd_off = 0
        bak_off = 0
        j = Add(j0, 1)
        IfCondition EqualTo(j, ln) ThenBlock: { j = 0 }
        WhileLoop NotEqual(j, j1) {
            IfCondition EqualTo(CA_PtOnRing(ArrayGet(lxy, Multiply(j, 2)), ArrayGet(lxy, Add(Multiply(j, 2), 1)), oxy, on), 0) ThenBlock: {
                fwd_off = Add(fwd_off, 1)
            }
            j = Add(j, 1)
            IfCondition EqualTo(j, ln) ThenBlock: { j = 0 }
        }
        j = Subtract(j0, 1)
        IfCondition LessThan(j, 0) ThenBlock: { j = Subtract(ln, 1) }
        WhileLoop NotEqual(j, j1) {
            IfCondition EqualTo(CA_PtOnRing(ArrayGet(lxy, Multiply(j, 2)), ArrayGet(lxy, Add(Multiply(j, 2), 1)), oxy, on), 0) ThenBlock: {
                bak_off = Add(bak_off, 1)
            }
            j = Subtract(j, 1)
            IfCondition LessThan(j, 0) ThenBlock: { j = Subtract(ln, 1) }
        }
        dir = 1
        max_off = fwd_off
        IfCondition GreaterThan(bak_off, fwd_off) ThenBlock: {
            dir = 0
            max_off = bak_off
        }
        // need a real complementary chain (the D-arc). Chord-only → already a concavity.
        IfCondition LessThan(max_off, 2) ThenBlock: { ReturnValue(0) }
        // replace the SHORTER outer path (the chord), never the long arc already on the ring
        d_fwd = Subtract(i1, i0)
        IfCondition LessThan(d_fwd, 0) ThenBlock: { d_fwd = Add(d_fwd, on) }
        d_bak = Subtract(i0, i1)
        IfCondition LessThan(d_bak, 0) ThenBlock: { d_bak = Add(d_bak, on) }
        IfCondition LessThan(d_fwd, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(d_bak, 1) ThenBlock: { ReturnValue(0) }
        short_fwd = 1
        short_n = d_fwd
        IfCondition GreaterThan(d_fwd, d_bak) ThenBlock: {
            short_fwd = 0
            short_n = d_bak
        }
        // skip if the outer already takes the long way (notch present)
        IfCondition LessEqual(max_off, Subtract(short_n, 1)) ThenBlock: { ReturnValue(0) }
        nn = 0
        IfCondition EqualTo(short_fwd, 1) ThenBlock: {
            // keep i1 → i0 (long); insert loop j0 → j1 exclusive
            i = i1
            keep = 1
            WhileLoop EqualTo(keep, 1) {
                ArraySet(out_xy, Multiply(nn, 2), ArrayGet(oxy, Multiply(i, 2)))
                ArraySet(out_xy, Add(Multiply(nn, 2), 1), ArrayGet(oxy, Add(Multiply(i, 2), 1)))
                nn = Add(nn, 1)
                IfCondition EqualTo(i, i0) ThenBlock: { keep = 0 }
                IfCondition EqualTo(keep, 1) ThenBlock: {
                    i = Add(i, 1)
                    IfCondition EqualTo(i, on) ThenBlock: { i = 0 }
                }
            }
            IfCondition EqualTo(dir, 1) ThenBlock: {
                j = Add(j0, 1)
                IfCondition EqualTo(j, ln) ThenBlock: { j = 0 }
                WhileLoop NotEqual(j, j1) {
                    ArraySet(out_xy, Multiply(nn, 2), ArrayGet(lxy, Multiply(j, 2)))
                    ArraySet(out_xy, Add(Multiply(nn, 2), 1), ArrayGet(lxy, Add(Multiply(j, 2), 1)))
                    nn = Add(nn, 1)
                    j = Add(j, 1)
                    IfCondition EqualTo(j, ln) ThenBlock: { j = 0 }
                }
            }
            IfCondition EqualTo(dir, 0) ThenBlock: {
                j = Subtract(j0, 1)
                IfCondition LessThan(j, 0) ThenBlock: { j = Subtract(ln, 1) }
                WhileLoop NotEqual(j, j1) {
                    ArraySet(out_xy, Multiply(nn, 2), ArrayGet(lxy, Multiply(j, 2)))
                    ArraySet(out_xy, Add(Multiply(nn, 2), 1), ArrayGet(lxy, Add(Multiply(j, 2), 1)))
                    nn = Add(nn, 1)
                    j = Subtract(j, 1)
                    IfCondition LessThan(j, 0) ThenBlock: { j = Subtract(ln, 1) }
                }
            }
        }
        IfCondition EqualTo(short_fwd, 0) ThenBlock: {
            // keep i0 → i1 (long); insert loop j1 → j0 exclusive
            i = i0
            keep = 1
            WhileLoop EqualTo(keep, 1) {
                ArraySet(out_xy, Multiply(nn, 2), ArrayGet(oxy, Multiply(i, 2)))
                ArraySet(out_xy, Add(Multiply(nn, 2), 1), ArrayGet(oxy, Add(Multiply(i, 2), 1)))
                nn = Add(nn, 1)
                IfCondition EqualTo(i, i1) ThenBlock: { keep = 0 }
                IfCondition EqualTo(keep, 1) ThenBlock: {
                    i = Add(i, 1)
                    IfCondition EqualTo(i, on) ThenBlock: { i = 0 }
                }
            }
            rev = Subtract(1, dir)
            IfCondition EqualTo(rev, 1) ThenBlock: {
                j = Add(j1, 1)
                IfCondition EqualTo(j, ln) ThenBlock: { j = 0 }
                WhileLoop NotEqual(j, j0) {
                    ArraySet(out_xy, Multiply(nn, 2), ArrayGet(lxy, Multiply(j, 2)))
                    ArraySet(out_xy, Add(Multiply(nn, 2), 1), ArrayGet(lxy, Add(Multiply(j, 2), 1)))
                    nn = Add(nn, 1)
                    j = Add(j, 1)
                    IfCondition EqualTo(j, ln) ThenBlock: { j = 0 }
                }
            }
            IfCondition EqualTo(rev, 0) ThenBlock: {
                j = Subtract(j1, 1)
                IfCondition LessThan(j, 0) ThenBlock: { j = Subtract(ln, 1) }
                WhileLoop NotEqual(j, j0) {
                    ArraySet(out_xy, Multiply(nn, 2), ArrayGet(lxy, Multiply(j, 2)))
                    ArraySet(out_xy, Add(Multiply(nn, 2), 1), ArrayGet(lxy, Add(Multiply(j, 2), 1)))
                    nn = Add(nn, 1)
                    j = Subtract(j, 1)
                    IfCondition LessThan(j, 0) ThenBlock: { j = Subtract(ln, 1) }
                }
            }
        }
        IfCondition LessThan(nn, 3) ThenBlock: { ReturnValue(0) }
        ReturnValue(nn)
    }
}

// Dump live sketch arcs/lines as integers (mm scaled) for pad/profile debug.
// Spurious long segs show as huge L= values far from arc radius.


// Dump live sketch arcs/lines as integers (mm scaled) for pad/profile debug.
// Spurious long segs show as huge L= values far from arc radius.
Function.CA_DumpSketchGeom {
    Input: sk: Integer
    Input: tag: Address
    Input: tagn: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sk, 0) ThenBlock: { ReturnValue(0) }
        CAD_Sys.Write(2, tag, tagn)
        CAD_Sys.Write(2, "\n", 1)
        nl = CAD_Sketch.GetLineCount(sk)
        na = CAD_Sketch.GetArcCount(sk)
        nc = CAD_Sketch.GetCircleCount(sk)
        PrintMessage("cad_app: geom nl=")
        PrintNumber(nl)
        PrintMessage(" na=")
        PrintNumber(na)
        PrintMessage(" nc=")
        PrintNumber(nc)
        PrintMessage("\n")
        // arcs: cx,cy,rad,a0,a1 as milli-units / milli-rad (ints only)
        arcs = CAD_Store.Read(sk, 11)
        ai = 0
        WhileLoop LessThan(ai, na) {
            b = Multiply(ai, 5)
            cx = ArrayGet(arcs, b)
            cy = ArrayGet(arcs, Add(b, 1))
            rad = ArrayGet(arcs, Add(b, 2))
            a0 = ArrayGet(arcs, Add(b, 3))
            a1 = ArrayGet(arcs, Add(b, 4))
            span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
            // tips
            ex0 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a0)))
            ey0 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a0)))
            ex1 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a1)))
            ey1 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a1)))
            PrintMessage("  arc[")
            PrintNumber(ai)
            PrintMessage("] Rmm=")
            PrintNumber(Float_ToInt(rad))
            PrintMessage(" tip0=(")
            PrintNumber(Float_ToInt(ex0))
            PrintMessage(",")
            PrintNumber(Float_ToInt(ey0))
            PrintMessage(") tip1=(")
            PrintNumber(Float_ToInt(ex1))
            PrintMessage(",")
            PrintNumber(Float_ToInt(ey1))
            PrintMessage(") span_mrad=")
            PrintNumber(Float_ToInt(Float_Mul(span, 0x408F400000000000)))
            PrintMessage("\n")
            ai = Add(ai, 1)
        }
        // lines: flag any segment longer than 50 world as suspicious
        lines = CAD_Store.Read(sk, 1)
        li = 0
        nlong = 0
        WhileLoop LessThan(li, nl) {
            b = Multiply(li, 4)
            x0 = ArrayGet(lines, b)
            y0 = ArrayGet(lines, Add(b, 1))
            x1 = ArrayGet(lines, Add(b, 2))
            y1 = ArrayGet(lines, Add(b, 3))
            len = CAD_Num.Hypot2(Float_Sub(x1, x0), Float_Sub(y1, y0))
            // L > 50
            IfCondition EqualTo(Float_Le(len, 0x4049000000000000), 0) ThenBlock: {
                nlong = Add(nlong, 1)
                PrintMessage("  LONG line[")
                PrintNumber(li)
                PrintMessage("] L=")
                PrintNumber(Float_ToInt(len))
                PrintMessage(" (")
                PrintNumber(Float_ToInt(x0))
                PrintMessage(",")
                PrintNumber(Float_ToInt(y0))
                PrintMessage(")->(")
                PrintNumber(Float_ToInt(x1))
                PrintMessage(",")
                PrintNumber(Float_ToInt(y1))
                PrintMessage(")\n")
            }
            li = Add(li, 1)
        }
        IfCondition EqualTo(nlong, 0) ThenBlock: {
            CA_Log("cad_app: no LONG lines (L>50)\n", 30)
        }
        IfCondition GreaterThan(nlong, 0) ThenBlock: {
            PrintMessage("cad_app: LONG line count=")
            PrintNumber(nlong)
            PrintMessage(" (spurious segs?)\n")
        }
        ReturnValue(0)
    }
}

// Project closed profiles WITHOUT mutating live sketch lines/arcs.
// Clone only for tess/face-walk; live keeps true arcs for display.


// Project closed profiles WITHOUT mutating live sketch lines/arcs.
// Clone only for tess/face-walk; live keeps true arcs for display.
Function.CA_RebuildProfiles {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.nprof = 0
            CadApp.prof_user = 0
            ReturnValue(0)
        }
        CA_Log("cad_app: rebuild-prof enter\n", 28)
        live = CadApp.sketch
        // NEVER SnapArcEnds / SnapNearEndpoints on LIVE — that invented long
        // phantom chords far from the arc (spurious segs in sketchclosed.png).
        CAD_Sketch.RebuildAnchors(live)
        CA_DumpSketchGeom(live, "cad_app: LIVE before profile", 28)
        clone = CAD_Sketch.CreateSketch(1)
        IfCondition EqualTo(clone, 0) ThenBlock: {
            CA_Log("cad_app: profile project FAIL (clone)\n", 38)
            ReturnValue(0)
        }
        CA_CopySketchGeom(live, clone)
        // tight tip weld on CLONE only (0.05 abs) then tess
        IfCondition GreaterThan(CAD_Store.Read(clone, 10), 0) ThenBlock: {
            CAD_Sketch.SnapArcEndsToSketch(clone, 0x3FA999999999999A)
        }
        IfCondition GreaterThan(CAD_Store.Read(clone, 10), 0) ThenBlock: {
            CAD_Sketch.TessellateArcs(clone, 96)
        }
        IfCondition GreaterThan(CAD_Store.Read(clone, 7), 0) ThenBlock: {
            CAD_Sketch.TessellateCircles(clone, 48)
            CAD_Store.Write(clone, 7, 0)
        }
        CA_Log("cad_app: rebuild-prof after tess\n", 33)
        // after tess: dump for phantom segs (was SnapNearEndpoints 1.0/2.0 — KILLED)
        CA_DumpSketchGeom(clone, "cad_app: CLONE after tess", 25)
        // only absolute 0.05 tip glue — no 1.0/2.0 freehand box welds
        CAD_Sketch.SnapNearEndpoints(clone, 0x3FA999999999999A)
        n = CAD_Sketch.BuildAllClosedLoops(clone)
        IfCondition EqualTo(n, 0) ThenBlock: {
            CA_Log("cad_app: face-walk 0; retry snap 0.05 only\n", 43)
            CAD_Sketch.SnapNearEndpoints(clone, 0x3FA999999999999A)
            n = CAD_Sketch.BuildAllClosedLoops(clone)
        }
        CA_LogInt("cad_app: rebuild-prof face-walk n=", 34, n)
        CA_DumpSketchGeom(clone, "cad_app: CLONE after face-walk", 30)
        n = CA_CopyProfilesOnly(clone, live)
        CA_LogInt("cad_app: rebuild-prof copied n=", 31, n)
        CadApp.nprof = n
        CadApp.prof_sel = 0
        CadApp.prof_user = 0
        CadApp.prof_mask = 0
        // live sketch keeps original circles/arcs/lines — anchors are markers only
        CAD_Sketch.RebuildAnchors(live)
        PrintMessage("cad_app: profiles n=")
        PrintNumber(n)
        PrintMessage("\n")
        IfCondition EqualTo(n, 0) ThenBlock: {
            CA_Log("cad_app: no closed profile\n", 27)
            CA_Log("  tip: Trim free overshoots past crosses, then Profiles\n", 56)
            CA_Log("  (stubs can block face-walk; FreeCAD is picky too)\n", 52)
            ReturnValue(0)
        }
        // log each face area so circle-notch / multi-face is visible in terminal
        xy_dbg = Allocate(65536)
        pii = 0
        WhileLoop LessThan(pii, n) {
            nnd = CAD_Sketch.GetProfileXY(live, pii, xy_dbg)
            ard = CAD_Sketch.LoopSignedArea(xy_dbg, nnd)
            IfCondition EqualTo(Float_Le(ard, 0), 1) ThenBlock: { ard = Float_Sub(0, ard) }
            PrintMessage("  face ")
            PrintNumber(pii)
            PrintMessage(" nn=")
            PrintNumber(nnd)
            PrintMessage(" area=")
            PrintNumber(Float_ToInt(ard))
            PrintMessage("\n")
            pii = Add(pii, 1)
        }
        Deallocate(xy_dbg, 65536)
        // NO auto-select. Profiles are available (light red); user must Pick/click.
        CAD_Store.Write(live, 12, n)
        CadApp.nprof = n
        CadApp.prof_sel = 0
        CadApp.prof_user = 0
        CadApp.prof_mask = 0
        CA_LogInt("cad_app: rebuild-prof ok n=", 27, n)
        IfCondition EqualTo(n, 1) ThenBlock: {
            CA_Log("cad_app: 1 profile available (light red) - click to select\n", 59)
            ReturnValue(1)
        }
        CA_Log("cad_app: multi profiles available (light red) - click to pick\n", 62)
        CA_Log("  bright red = selected; Shift+click multi-select\n", 50)
        ReturnValue(n)
    }
}

// Apply selection. add_mode=0 replace; add_mode=1 toggle bit (Shift+click multi).
// Returns 1 on success.


// Apply selection. add_mode=0 replace; add_mode=1 toggle bit (Shift+click multi).
// Returns 1 on success.
Function.CA_ApplyProfileSel {
    Input: idx: Integer
    Input: nprof: Integer
    Input: add_mode: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(idx, nprof) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(idx, 31) ThenBlock: { ReturnValue(0) }
        xy = Allocate(65536)
        nn = CAD_Sketch.GetProfileXY(CadApp.sketch, idx, xy)
        Deallocate(xy, 65536)
        IfCondition LessThan(nn, 3) ThenBlock: {
            CA_Log("cad_app: select FAIL - empty ring\n", 34)
            ReturnValue(0)
        }
        bit = LeftShift(1, idx)
        IfCondition EqualTo(add_mode, 0) ThenBlock: {
            CadApp.prof_mask = bit
            CadApp.prof_sel = idx
        }
        IfCondition EqualTo(add_mode, 1) ThenBlock: {
            CadApp.prof_mask = BitwiseXor(CadApp.prof_mask, bit)
            CadApp.prof_sel = idx
            // if nothing left selected, keep user flag off
            IfCondition EqualTo(CadApp.prof_mask, 0) ThenBlock: {
                CadApp.prof_user = 0
                CAD_Store.Write(CadApp.sketch, 12, nprof)
                CadApp.nprof = nprof
                ReturnValue(1)
            }
        }
        CAD_Sketch.SelectProfile(CadApp.sketch, idx)
        CAD_Store.Write(CadApp.sketch, 12, nprof)
        CadApp.prof_user = 1
        CadApp.nprof = nprof
        ReturnValue(1)
    }
}

// Integer pixel point-in-poly (same space as draw/fill). pxy = n integer x,y pairs.
Function.CA_PointInPolyPx {
    Input: px: Integer
    Input: py: Integer
    Input: pxy: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        inside = 0
        i = 0
        j = Subtract(n, 1)
        WhileLoop LessThan(i, n) {
            xi = ArrayGet(pxy, Multiply(i, 2))
            yi = ArrayGet(pxy, Add(Multiply(i, 2), 1))
            xj = ArrayGet(pxy, Multiply(j, 2))
            yj = ArrayGet(pxy, Add(Multiply(j, 2), 1))
            a = 0
            b = 0
            IfCondition GreaterThan(yi, py) ThenBlock: { a = 1 }
            IfCondition GreaterThan(yj, py) ThenBlock: { b = 1 }
            IfCondition NotEqual(a, b) ThenBlock: {
                den = Subtract(yj, yi)
                IfCondition NotEqual(den, 0) ThenBlock: {
                    num = Multiply(Subtract(py, yi), Subtract(xj, xi))
                    xint = Add(xi, Divide(num, den))
                    IfCondition LessThan(px, xint) ThenBlock: {
                        inside = Subtract(1, inside)
                    }
                }
            }
            j = i
            i = Add(i, 1)
        }
        ReturnValue(inside)
    }
}

// Hit profile by SCREEN PIXEL (matches drawn rings). Nested → smallest area.
// Edge fallback: within 20 px of an edge → smallest near face.
// Returns index or -1 (no auto-pick invent).
Function.CA_HitProfilePx {
    Input: px: Integer
    Input: py: Integer
    Input: nprof: Integer
    Output: Integer
    Body: {
        xy = Allocate(65536)
        pxy = Allocate(65536)
        pt = Allocate(32)
        best_in = -1
        best_in_a = 0
        found_in = 0
        pi = 0
        WhileLoop LessThan(pi, nprof) {
            nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
            IfCondition GreaterEqual(nn, 3) ThenBlock: {
                k = 0
                WhileLoop LessThan(k, nn) {
                    CA_WorldToPix(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), pt)
                    ArraySet(pxy, Multiply(k, 2), ArrayGet(pt, 0))
                    ArraySet(pxy, Add(Multiply(k, 2), 1), ArrayGet(pt, 1))
                    k = Add(k, 1)
                }
                IfCondition EqualTo(CA_PointInPolyPx(px, py, pxy, nn), 1) ThenBlock: {
                    ar = CAD_Sketch.LoopSignedArea(xy, nn)
                    IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                    IfCondition EqualTo(found_in, 0) ThenBlock: {
                        found_in = 1
                        best_in = pi
                        best_in_a = ar
                    }
                    IfCondition EqualTo(Float_Le(ar, best_in_a), 1) ThenBlock: {
                        best_in = pi
                        best_in_a = ar
                    }
                }
            }
            pi = Add(pi, 1)
        }
        IfCondition EqualTo(found_in, 1) ThenBlock: {
            Deallocate(xy, 65536)
            Deallocate(pxy, 65536)
            Deallocate(pt, 32)
            ReturnValue(best_in)
        }
        // edge: nearest segment within 24 px, prefer smallest area among near
        lim2 = Multiply(24, 24)
        best_d2 = lim2
        found_e = 0
        pi = 0
        WhileLoop LessThan(pi, nprof) {
            nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
            IfCondition GreaterEqual(nn, 3) ThenBlock: {
                k = 0
                WhileLoop LessThan(k, nn) {
                    CA_WorldToPix(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), pt)
                    ArraySet(pxy, Multiply(k, 2), ArrayGet(pt, 0))
                    ArraySet(pxy, Add(Multiply(k, 2), 1), ArrayGet(pt, 1))
                    k = Add(k, 1)
                }
                k = 0
                WhileLoop LessThan(k, nn) {
                    k2 = Add(k, 1)
                    IfCondition EqualTo(k2, nn) ThenBlock: { k2 = 0 }
                    x0 = ArrayGet(pxy, Multiply(k, 2))
                    y0 = ArrayGet(pxy, Add(Multiply(k, 2), 1))
                    x1 = ArrayGet(pxy, Multiply(k2, 2))
                    y1 = ArrayGet(pxy, Add(Multiply(k2, 2), 1))
                    dx = Subtract(x1, x0)
                    dy = Subtract(y1, y0)
                    len2 = Add(Multiply(dx, dx), Multiply(dy, dy))
                    d2 = lim2
                    IfCondition EqualTo(len2, 0) ThenBlock: {
                        ddx = Subtract(px, x0)
                        ddy = Subtract(py, y0)
                        d2 = Add(Multiply(ddx, ddx), Multiply(ddy, ddy))
                    }
                    IfCondition NotEqual(len2, 0) ThenBlock: {
                        num = Add(Multiply(Subtract(px, x0), dx), Multiply(Subtract(py, y0), dy))
                        IfCondition LessEqual(num, 0) ThenBlock: {
                            ddx = Subtract(px, x0)
                            ddy = Subtract(py, y0)
                            d2 = Add(Multiply(ddx, ddx), Multiply(ddy, ddy))
                        }
                        IfCondition GreaterEqual(num, len2) ThenBlock: {
                            ddx = Subtract(px, x1)
                            ddy = Subtract(py, y1)
                            d2 = Add(Multiply(ddx, ddx), Multiply(ddy, ddy))
                        }
                        IfCondition GreaterThan(num, 0) ThenBlock: {
                            IfCondition LessThan(num, len2) ThenBlock: {
                                qx = Add(x0, Divide(Multiply(num, dx), len2))
                                qy = Add(y0, Divide(Multiply(num, dy), len2))
                                ddx = Subtract(px, qx)
                                ddy = Subtract(py, qy)
                                d2 = Add(Multiply(ddx, ddx), Multiply(ddy, ddy))
                            }
                        }
                    }
                    IfCondition LessEqual(d2, best_d2) ThenBlock: {
                        best_d2 = d2
                        found_e = 1
                    }
                    k = Add(k, 1)
                }
            }
            pi = Add(pi, 1)
        }
        best_i = -1
        best_ar = 0
        IfCondition EqualTo(found_e, 1) ThenBlock: {
            band = Add(best_d2, Multiply(10, 10))
            IfCondition GreaterThan(band, lim2) ThenBlock: { band = lim2 }
            pi = 0
            WhileLoop LessThan(pi, nprof) {
                nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                IfCondition GreaterEqual(nn, 3) ThenBlock: {
                    k = 0
                    WhileLoop LessThan(k, nn) {
                        CA_WorldToPix(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), pt)
                        ArraySet(pxy, Multiply(k, 2), ArrayGet(pt, 0))
                        ArraySet(pxy, Add(Multiply(k, 2), 1), ArrayGet(pt, 1))
                        k = Add(k, 1)
                    }
                    near = 0
                    k = 0
                    WhileLoop LessThan(k, nn) {
                        k2 = Add(k, 1)
                        IfCondition EqualTo(k2, nn) ThenBlock: { k2 = 0 }
                        x0 = ArrayGet(pxy, Multiply(k, 2))
                        y0 = ArrayGet(pxy, Add(Multiply(k, 2), 1))
                        x1 = ArrayGet(pxy, Multiply(k2, 2))
                        y1 = ArrayGet(pxy, Add(Multiply(k2, 2), 1))
                        dx = Subtract(x1, x0)
                        dy = Subtract(y1, y0)
                        len2 = Add(Multiply(dx, dx), Multiply(dy, dy))
                        d2 = lim2
                        IfCondition EqualTo(len2, 0) ThenBlock: {
                            ddx = Subtract(px, x0)
                            ddy = Subtract(py, y0)
                            d2 = Add(Multiply(ddx, ddx), Multiply(ddy, ddy))
                        }
                        IfCondition NotEqual(len2, 0) ThenBlock: {
                            num = Add(Multiply(Subtract(px, x0), dx), Multiply(Subtract(py, y0), dy))
                            IfCondition LessEqual(num, 0) ThenBlock: {
                                ddx = Subtract(px, x0)
                                ddy = Subtract(py, y0)
                                d2 = Add(Multiply(ddx, ddx), Multiply(ddy, ddy))
                            }
                            IfCondition GreaterEqual(num, len2) ThenBlock: {
                                ddx = Subtract(px, x1)
                                ddy = Subtract(py, y1)
                                d2 = Add(Multiply(ddx, ddx), Multiply(ddy, ddy))
                            }
                            IfCondition GreaterThan(num, 0) ThenBlock: {
                                IfCondition LessThan(num, len2) ThenBlock: {
                                    qx = Add(x0, Divide(Multiply(num, dx), len2))
                                    qy = Add(y0, Divide(Multiply(num, dy), len2))
                                    ddx = Subtract(px, qx)
                                    ddy = Subtract(py, qy)
                                    d2 = Add(Multiply(ddx, ddx), Multiply(ddy, ddy))
                                }
                            }
                        }
                        IfCondition LessEqual(d2, band) ThenBlock: { near = 1 }
                        k = Add(k, 1)
                    }
                    IfCondition EqualTo(near, 1) ThenBlock: {
                        ar = CAD_Sketch.LoopSignedArea(xy, nn)
                        IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                        take = 0
                        IfCondition EqualTo(best_i, -1) ThenBlock: { take = 1 }
                        IfCondition EqualTo(Float_Le(ar, best_ar), 1) ThenBlock: { take = 1 }
                        IfCondition EqualTo(take, 1) ThenBlock: {
                            best_i = pi
                            best_ar = ar
                        }
                    }
                }
                pi = Add(pi, 1)
            }
        }
        Deallocate(xy, 65536)
        Deallocate(pxy, 65536)
        Deallocate(pt, 32)
        IfCondition GreaterEqual(best_i, 0) ThenBlock: {
            ReturnValue(best_i)
        }
        ReturnValue(-1)
    }
}

// World-coord hit (fallback). Prefer CA_HitProfilePx from the pick tool.
Function.CA_HitProfile {
    Input: wx: Integer
    Input: wy: Integer
    Input: nprof: Integer
    Output: Integer
    Body: {
        xy = Allocate(65536)
        best_in = -1
        best_in_a = 0
        found_in = 0
        pi = 0
        WhileLoop LessThan(pi, nprof) {
            nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
            IfCondition GreaterEqual(nn, 3) ThenBlock: {
                IfCondition EqualTo(CA_PointInPoly(wx, wy, xy, nn), 1) ThenBlock: {
                    ar = CAD_Sketch.LoopSignedArea(xy, nn)
                    IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                    IfCondition EqualTo(found_in, 0) ThenBlock: {
                        found_in = 1
                        best_in = pi
                        best_in_a = ar
                    }
                    IfCondition EqualTo(Float_Le(ar, best_in_a), 1) ThenBlock: {
                        best_in = pi
                        best_in_a = ar
                    }
                }
            }
            pi = Add(pi, 1)
        }
        Deallocate(xy, 65536)
        IfCondition EqualTo(found_in, 1) ThenBlock: {
            ReturnValue(best_in)
        }
        ReturnValue(-1)
    }
}

// Pick profile at SCREEN PIXEL. shift=1 → toggle multi-select.
Function.CA_PickProfileAtPx {
    Input: px: Integer
    Input: py: Integer
    Input: shift: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: pick fail - no sketch\n", 31)
            ReturnValue(0)
        }
        CA_Log("cad_app: pick-px enter\n", 23)
        nprof = CAD_Store.Read(CadApp.sketch, 12)
        IfCondition EqualTo(nprof, 0) ThenBlock: {
            nprof = CA_RebuildProfiles()
        }
        IfCondition EqualTo(nprof, 0) ThenBlock: {
            CA_Log("cad_app: pick fail - no projected profile\n", 42)
            ReturnValue(0)
        }
        CadApp.nprof = nprof
        hit = CA_HitProfilePx(px, py, nprof)
        IfCondition LessThan(hit, 0) ThenBlock: {
            wxy = Allocate(32)
            CA_PixToWorld(px, py, wxy)
            hit = CA_HitProfile(ArrayGet(wxy, 0), ArrayGet(wxy, 1), nprof)
            Deallocate(wxy, 32)
        }
        IfCondition LessThan(hit, 0) ThenBlock: {
            CadApp.prof_user = 0
            CadApp.prof_mask = 0
            CadApp.prof_sel = 0
            CA_Log("cad_app: pick miss - selection cleared\n", 39)
            ReturnValue(0)
        }
        addm = 0
        IfCondition NotEqual(shift, 0) ThenBlock: { addm = 1 }
        IfCondition EqualTo(addm, 0) ThenBlock: {
            bit = LeftShift(1, hit)
            IfCondition EqualTo(CadApp.prof_mask, bit) ThenBlock: {
                CadApp.prof_user = 0
                CadApp.prof_mask = 0
                CadApp.prof_sel = 0
                CA_Log("cad_app: profile unselected (click again)\n", 42)
                ReturnValue(1)
            }
        }
        ok = CA_ApplyProfileSel(hit, nprof, addm)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            CA_Log("cad_app: pick apply FAIL\n", 25)
            ReturnValue(0)
        }
        PrintMessage("cad_app: pick hit face ")
        PrintNumber(hit)
        PrintMessage(" mask=")
        PrintNumber(CadApp.prof_mask)
        PrintMessage("\n")
        IfCondition EqualTo(addm, 1) ThenBlock: {
            CA_Log("cad_app: multi-select toggle (Shift+click)\n", 43)
        }
        IfCondition EqualTo(addm, 0) ThenBlock: {
            CA_Log("cad_app: profile selected (bright red fill)\n", 44)
        }
        ReturnValue(1)
    }
}

// Legacy world pick → pixel path
Function.CA_PickProfileAt {
    Input: wx: Integer
    Input: wy: Integer
    Input: shift: Integer
    Output: Integer
    Body: {
        pt = Allocate(32)
        CA_WorldToPix(wx, wy, pt)
        rc = CA_PickProfileAtPx(ArrayGet(pt, 0), ArrayGet(pt, 1), shift)
        Deallocate(pt, 32)
        ReturnValue(rc)
    }
}
