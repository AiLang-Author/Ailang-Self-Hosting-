// Count closed profiles WITHOUT mutating live sketch (no tessellate-on-live).
Function.CA_CountProfiles {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.nprof = 0
            ReturnValue(0)
        }
        // read cache only — projection is CA_RebuildProfiles (clone)
        n = CAD_Store.Read(CadApp.sketch, 12)
        CadApp.nprof = n
        ReturnValue(n)
    }
}

// Build solid from current sketch (+ optional hole sketch).
// Paths: plate+hole DXF pair | multi-loop single sketch | single pad.


// Pixel distance² from (px,py) to segment (x0,y0)-(x1,y1). Integer math.
Function.CA_Dist2PxToSeg {
    Input: px: Integer
    Input: py: Integer
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Output: Integer
    Body: {
        dx = Subtract(x1, x0)
        dy = Subtract(y1, y0)
        len2 = Add(Multiply(dx, dx), Multiply(dy, dy))
        IfCondition EqualTo(len2, 0) ThenBlock: {
            ex = Subtract(px, x0)
            ey = Subtract(py, y0)
            ReturnValue(Add(Multiply(ex, ex), Multiply(ey, ey)))
        }
        // t = clamp(dot((p-a),(b-a))/len2, 0, 1) in 0..1024 fixed
        vx = Subtract(px, x0)
        vy = Subtract(py, y0)
        dot = Add(Multiply(vx, dx), Multiply(vy, dy))
        // t_num/len2 → scale 1024
        t = Divide(Multiply(dot, 1024), len2)
        IfCondition LessThan(t, 0) ThenBlock: { t = 0 }
        IfCondition GreaterThan(t, 1024) ThenBlock: { t = 1024 }
        qx = Add(x0, Divide(Multiply(dx, t), 1024))
        qy = Add(y0, Divide(Multiply(dy, t), 1024))
        ex = Subtract(px, qx)
        ey = Subtract(py, qy)
        ReturnValue(Add(Multiply(ex, ex), Multiply(ey, ey)))
    }
}

// 3D edge ray-pick: nearest solid edge under pixel (screen-space segment dist).
// Corner clicks hit 3 edges; prefer a mid-span hit, then world-horizontal
// (small |dZ|) so top-rim clicks do not steal the vertical.
// Which sketch/pad owns this edge: shell index → nth pad's feat_sk.
Function.CA_EdgeSketchIdx {
    Input: edge_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(CA_CurrentSkIdx()) }
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(CA_CurrentSkIdx()) }
        sh = CAD_Store.Read(CadApp.solid, 0)
        sidx = 0
        sguard = 0
        WhileLoop NotEqual(sh, 0) {
            fc = CAD_Store.Read(sh, 0)
            fguard = 0
            WhileLoop NotEqual(fc, 0) {
                lp = CAD_Store.Read(fc, 1)
                lguard = 0
                WhileLoop NotEqual(lp, 0) {
                    hd = CAD_Store.Read(lp, 0)
                    ce = hd
                    cguard = 0
                    WhileLoop NotEqual(ce, 0) {
                        IfCondition EqualTo(CAD_Store.Read(ce, 0), edge_h) ThenBlock: {
                            p = 0
                            fi = 0
                            WhileLoop LessThan(fi, CadApp.feat_n) {
                                IfCondition EqualTo(ArrayGet(CadApp.feat_kind, fi), 1) ThenBlock: {
                                    IfCondition EqualTo(p, sidx) ThenBlock: {
                                        ReturnValue(ArrayGet(CadApp.feat_sk, fi))
                                    }
                                    p = Add(p, 1)
                                }
                                fi = Add(fi, 1)
                            }
                            ReturnValue(sidx)
                        }
                        ce = CAD_Store.Read(ce, 2)
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(ce, hd) ThenBlock: { ce = 0 }
                        IfCondition GreaterThan(cguard, 4096) ThenBlock: { ce = 0 }
                    }
                    lp = CAD_Store.Read(lp, 2)
                    lguard = Add(lguard, 1)
                    IfCondition GreaterThan(lguard, 16) ThenBlock: { lp = 0 }
                }
                fc = CAD_Store.Read(fc, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 512) ThenBlock: { fc = 0 }
            }
            sh = CAD_Store.Read(sh, 2)
            sidx = Add(sidx, 1)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { sh = 0 }
        }
        ReturnValue(CA_CurrentSkIdx())
    }
}

Function.CA_PickSolidEdgeAtPx {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CadApp.mode, 0) ThenBlock: { ReturnValue(0) }
        fr = Allocate(64)
        CA_BuildViewFrame(fr)
        edges = Allocate(32768)
        ne = CAD_Topo.SolidCollectEdges(CadApp.solid, edges, 4096)
        IfCondition LessEqual(ne, 0) ThenBlock: {
            Deallocate(edges, 32768)
            Deallocate(fr, 64)
            ReturnValue(0)
        }
        // Hole-wall verticals (through-hole generators) are 20mm tall and
        // win the "prefer long" score when you click near a hole. Collect
        // inner-loop XY from the first two faces (bot+top caps) and skip
        // any vertical whose midpoint sits on a hole loop.
        hxy = Allocate(16384)
        nhv = 0
        sh0 = CAD_Store.Read(CadApp.solid, 0)
        IfCondition NotEqual(sh0, 0) ThenBlock: {
            fc = CAD_Store.Read(sh0, 0)
            fg = 0
            WhileLoop NotEqual(fc, 0) {
                IfCondition LessThan(fg, 4) ThenBlock: {
                    lp0 = CAD_Store.Read(fc, 1)
                    IfCondition NotEqual(lp0, 0) ThenBlock: {
                        inn = CAD_Store.Read(lp0, 2)
                        ig = 0
                        WhileLoop NotEqual(inn, 0) {
                            IfCondition LessThan(ig, 8) ThenBlock: {
                                hd = CAD_Store.Read(inn, 0)
                                IfCondition NotEqual(hd, 0) ThenBlock: {
                                    ce = hd
                                    cg = 0
                                    dn = 0
                                    WhileLoop EqualTo(dn, 0) {
                                        ov = CAD_Store.Read(ce, 5)
                                        IfCondition NotEqual(ov, 0) ThenBlock: {
                                            IfCondition LessThan(nhv, 1000) ThenBlock: {
                                                ArraySet(hxy, Multiply(nhv, 2), CAD_Store.Read(ov, 0))
                                                ArraySet(hxy, Add(Multiply(nhv, 2), 1), CAD_Store.Read(ov, 1))
                                                nhv = Add(nhv, 1)
                                            }
                                        }
                                        ce = CAD_Store.Read(ce, 2)
                                        cg = Add(cg, 1)
                                        IfCondition EqualTo(ce, hd) ThenBlock: { dn = 1 }
                                        IfCondition GreaterThan(cg, 2048) ThenBlock: { dn = 1 }
                                    }
                                }
                                inn = CAD_Store.Read(inn, 2)
                            }
                            IfCondition GreaterEqual(ig, 8) ThenBlock: { inn = 0 }
                            ig = Add(ig, 1)
                        }
                    }
                    fc = CAD_Store.Read(fc, 3)
                }
                IfCondition GreaterEqual(fg, 4) ThenBlock: { fc = 0 }
                fg = Add(fg, 1)
            }
        }
        // 0.2 mm²
        hole_eps2 = 0x3F947AE147AE147B
        // 32px — tessellated rims are short on screen
        rad2 = Multiply(32, 32)
        best_mid = 999999
        best_mid_e = 0
        best_mid_len = 0
        best_end = 999999
        best_end_e = 0
        best_end_len = 0
        pr0 = Allocate(32)
        pr1 = Allocate(32)
        i = 0
        WhileLoop LessThan(i, ne) {
            ed = ArrayGet(edges, i)
            IfCondition NotEqual(ed, 0) ThenBlock: {
                v0 = CAD_Store.Read(ed, 0)
                v1 = CAD_Store.Read(ed, 1)
                IfCondition EqualTo(v0, v1) ThenBlock: {
                    crv = CAD_Store.Read(ed, 2)
                    IfCondition NotEqual(crv, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Store.Read(crv, 0), 2) ThenBlock: {
                            IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: {
                                CAD_Tess_State.samp = Allocate(8192)
                            }
                            ns = CAD_Tess.SampleCircleEdge(ed, 48, CAD_Tess_State.samp)
                            samp = CAD_Tess_State.samp
                            si = 0
                            WhileLoop LessThan(si, Subtract(ns, 1)) {
                                CAD_View.ProjectPoint(ArrayGet(samp, Multiply(si, 3)), ArrayGet(samp, Add(Multiply(si, 3), 1)), ArrayGet(samp, Add(Multiply(si, 3), 2)), fr, pr0)
                                CAD_View.ProjectPoint(ArrayGet(samp, Multiply(Add(si, 1), 3)), ArrayGet(samp, Add(Multiply(Add(si, 1), 3), 1)), ArrayGet(samp, Add(Multiply(Add(si, 1), 3), 2)), fr, pr1)
                                x0 = Float_ToInt(ArrayGet(pr0, 0))
                                y0 = Float_ToInt(ArrayGet(pr0, 1))
                                x1 = Float_ToInt(ArrayGet(pr1, 0))
                                y1 = Float_ToInt(ArrayGet(pr1, 1))
                                d2 = CA_Dist2PxToSeg(px, py, x0, y0, x1, y1)
                                IfCondition LessThan(d2, rad2) ThenBlock: {
                                    take = 0
                                    IfCondition EqualTo(best_mid_e, 0) ThenBlock: { take = 1 }
                                    IfCondition LessThan(d2, best_mid) ThenBlock: { take = 1 }
                                    IfCondition EqualTo(take, 1) ThenBlock: {
                                        best_mid = d2
                                        best_mid_e = ed
                                        best_mid_len = 100000
                                    }
                                }
                                si = Add(si, 1)
                            }
                        }
                    }
                }
                IfCondition NotEqual(v0, 0) ThenBlock: {
                    IfCondition NotEqual(v1, 0) ThenBlock: {
                        IfCondition NotEqual(v0, v1) ThenBlock: {
                        CAD_View.ProjectPoint(CAD_Store.Read(v0, 0), CAD_Store.Read(v0, 1), CAD_Store.Read(v0, 2), fr, pr0)
                        CAD_View.ProjectPoint(CAD_Store.Read(v1, 0), CAD_Store.Read(v1, 1), CAD_Store.Read(v1, 2), fr, pr1)
                        x0 = Float_ToInt(ArrayGet(pr0, 0))
                        y0 = Float_ToInt(ArrayGet(pr0, 1))
                        x1 = Float_ToInt(ArrayGet(pr1, 0))
                        y1 = Float_ToInt(ArrayGet(pr1, 1))
                        d2 = CA_Dist2PxToSeg(px, py, x0, y0, x1, y1)
                        IfCondition LessThan(d2, rad2) ThenBlock: {
                            skip_hole = 0
                            dz = Float_Sub(CAD_Store.Read(v1, 2), CAD_Store.Read(v0, 2))
                            IfCondition EqualTo(CAD_Num.IsNeg(dz), 1) ThenBlock: { dz = Float_Sub(0, dz) }
                            IfCondition EqualTo(CAD_Num.IsZero(dz, 0), 0) ThenBlock: {
                                IfCondition GreaterThan(nhv, 0) ThenBlock: {
                                    mx = Float_Div(Float_Add(CAD_Store.Read(v0, 0), CAD_Store.Read(v1, 0)), 0x4000000000000000)
                                    my = Float_Div(Float_Add(CAD_Store.Read(v0, 1), CAD_Store.Read(v1, 1)), 0x4000000000000000)
                                    hi = 0
                                    WhileLoop LessThan(hi, nhv) {
                                        hx = Float_Sub(mx, ArrayGet(hxy, Multiply(hi, 2)))
                                        hy = Float_Sub(my, ArrayGet(hxy, Add(Multiply(hi, 2), 1)))
                                        hd2 = Float_Add(Float_Mul(hx, hx), Float_Mul(hy, hy))
                                        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(hd2, hole_eps2)), 1) ThenBlock: {
                                            skip_hole = 1
                                            hi = nhv
                                        }
                                        hi = Add(hi, 1)
                                    }
                                }
                            }
                            IfCondition EqualTo(skip_hole, 0) ThenBlock: {
                            dx = Subtract(x1, x0)
                            dy = Subtract(y1, y0)
                            len2 = Add(Multiply(dx, dx), Multiply(dy, dy))
                            tmid = 512
                            IfCondition GreaterThan(len2, 0) ThenBlock: {
                                tmid = Divide(Multiply(Add(Multiply(Subtract(px, x0), dx), Multiply(Subtract(py, y0), dy)), 1024), len2)
                            }
                            // interior hit: t in (180, 844) ≈ 0.18..0.82
                            is_mid = 0
                            IfCondition GreaterThan(tmid, 180) ThenBlock: {
                                IfCondition LessThan(tmid, 844) ThenBlock: { is_mid = 1 }
                            }
                            IfCondition EqualTo(is_mid, 1) ThenBlock: {
                                take = 0
                                IfCondition EqualTo(best_mid_e, 0) ThenBlock: { take = 1 }
                                IfCondition LessThan(d2, best_mid) ThenBlock: { take = 1 }
                                IfCondition EqualTo(take, 1) ThenBlock: {
                                    best_mid = d2
                                    best_mid_e = ed
                                    best_mid_len = len2
                                }
                            }
                            IfCondition EqualTo(is_mid, 0) ThenBlock: {
                                take = 0
                                IfCondition EqualTo(best_end_e, 0) ThenBlock: { take = 1 }
                                IfCondition LessThan(d2, Subtract(best_end, 64)) ThenBlock: { take = 1 }
                                IfCondition EqualTo(take, 0) ThenBlock: {
                                    IfCondition LessThan(d2, Add(best_end, 64)) ThenBlock: {
                                        IfCondition GreaterThan(len2, best_end_len) ThenBlock: { take = 1 }
                                    }
                                }
                                IfCondition EqualTo(take, 1) ThenBlock: {
                                    best_end = d2
                                    best_end_e = ed
                                    best_end_len = len2
                                }
                            }
                        }
                    }
                    }
                }
            }
            }
            i = Add(i, 1)
        }
        Deallocate(pr0, 32)
        Deallocate(pr1, 32)
        Deallocate(hxy, 16384)
        hit = best_mid_e
        IfCondition EqualTo(hit, 0) ThenBlock: { hit = best_end_e }
        IfCondition EqualTo(hit, 0) ThenBlock: {
            PrintMessage("cad_app: edge pick miss scanned=")
            PrintNumber(ne)
            PrintMessage("\n")
        }
        IfCondition NotEqual(hit, 0) ThenBlock: {
            CadApp.edge_sk = CA_EdgeSketchIdx(hit)
            CA_LogInt("cad_app: edge pick sk=", 21, CadApp.edge_sk)
        }
        Deallocate(edges, 32768)
        Deallocate(fr, 64)
        ReturnValue(hit)
    }
}

Function.CA_BlendFeatEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.feat_en, 0) ThenBlock: { CadApp.feat_en = Allocate(256) }
        IfCondition EqualTo(CadApp.feat_ps, 0) ThenBlock: { CadApp.feat_ps = Allocate(256) }
        IfCondition EqualTo(CadApp.feat_hi, 0) ThenBlock: { CadApp.feat_hi = Allocate(256) }
        IfCondition EqualTo(CadApp.feat_eb, 0) ThenBlock: { CadApp.feat_eb = Allocate(4096) }
        IfCondition EqualTo(CadApp.last_bl_buf, 0) ThenBlock: { CadApp.last_bl_buf = Allocate(128) }
        IfCondition EqualTo(CadApp.feat_en, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.feat_eb, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

// Snapshot current edge pick + parent solid before the blend mutates the body.
Function.CA_BlendSnapSel {
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_BlendFeatEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        n = CadApp.sel_nedges
        IfCondition LessThan(n, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.sel_edge_id, 0) ThenBlock: {
                ArraySet(CadApp.last_bl_buf, 0, CadApp.sel_edge_id)
                n = 1
            }
        }
        IfCondition GreaterThan(n, 12) ThenBlock: { n = 12 }
        CadApp.last_bl_n = n
        CadApp.last_bl_parent = CadApp.bl_parent
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition GreaterThan(CadApp.sel_nedges, 0) ThenBlock: {
                ArraySet(CadApp.last_bl_buf, i, ArrayGet(CadApp.sel_edge_buf, i))
            }
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

// Bind last snapshot onto feat_sel (call after FeatAdd or on edit update).
Function.CA_BlendBindFeat {
    Input: kind: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_BlendFeatEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        fi = CadApp.feat_sel
        IfCondition LessThan(fi, 0) ThenBlock: { ReturnValue(-1) }
        n = CadApp.last_bl_n
        ArraySet(CadApp.feat_en, fi, n)
        ArraySet(CadApp.feat_ps, fi, CadApp.last_bl_parent)
        ArraySet(CadApp.feat_hi, fi, CadApp.hist_cur)
        b = Multiply(fi, 12)
        i = 0
        WhileLoop LessThan(i, n) {
            ArraySet(CadApp.feat_eb, Add(b, i), ArrayGet(CadApp.last_bl_buf, i))
            i = Add(i, 1)
        }
        CadApp.last_bl_feat = fi
        CadApp.last_bl_kind = kind
        ReturnValue(n)
    }
}

// Put stored edges back in the pick set and roll the body to the pre-blend solid.
Function.CA_BlendLoadFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_BlendFeatEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        CA_EnsureEdgeSelBuf()
        n = 0
        ps = 0
        IfCondition GreaterEqual(feat_i, 0) ThenBlock: {
            n = ArrayGet(CadApp.feat_en, feat_i)
            ps = ArrayGet(CadApp.feat_ps, feat_i)
        }
        IfCondition LessThan(n, 1) ThenBlock: {
            IfCondition EqualTo(CadApp.last_bl_feat, feat_i) ThenBlock: {
                n = CadApp.last_bl_n
                ps = CadApp.last_bl_parent
            }
        }
        IfCondition LessThan(n, 1) ThenBlock: {
            IfCondition GreaterThan(CadApp.last_bl_n, 0) ThenBlock: {
                IfCondition EqualTo(CadApp.last_bl_kind, ArrayGet(CadApp.feat_kind, feat_i)) ThenBlock: {
                    n = CadApp.last_bl_n
                    ps = CadApp.last_bl_parent
                }
            }
        }
        IfCondition EqualTo(ps, 0) ThenBlock: {
            IfCondition GreaterEqual(feat_i, 0) ThenBlock: {
                hi = ArrayGet(CadApp.feat_hi, feat_i)
                IfCondition GreaterThan(hi, 0) ThenBlock: {
                    IfCondition LessThan(hi, CadApp.hist_n) ThenBlock: {
                        ps = ArrayGet(CadApp.hist_solid, Subtract(hi, 1))
                    }
                }
            }
        }
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(ps, 0) ThenBlock: { ReturnValue(-1) }
        i = 0
        WhileLoop LessThan(i, n) {
            eh = 0
            IfCondition GreaterEqual(feat_i, 0) ThenBlock: {
                IfCondition GreaterThan(ArrayGet(CadApp.feat_en, feat_i), 0) ThenBlock: {
                    eh = ArrayGet(CadApp.feat_eb, Add(Multiply(feat_i, 12), i))
                }
            }
            IfCondition EqualTo(eh, 0) ThenBlock: {
                eh = ArrayGet(CadApp.last_bl_buf, i)
            }
            ArraySet(CadApp.sel_edge_buf, i, eh)
            i = Add(i, 1)
        }
        CadApp.sel_nedges = n
        CadApp.sel_edge_id = ArrayGet(CadApp.sel_edge_buf, Subtract(n, 1))
        CadApp.nclick = n
        CadApp.bl_parent = ps
        CadApp.solid = ps
        CAD_View.InvalidateMesh()
        CA_LogInt("cad_app: blend replay nsel=", 26, n)
        ReturnValue(n)
    }
}

// Roll to the solid from before this blend (hist parent). Edges stay empty.
Function.CA_BlendRollbackParent {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        ps = 0
        IfCondition GreaterEqual(feat_i, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.feat_hi, 0) ThenBlock: {
                hi = ArrayGet(CadApp.feat_hi, feat_i)
                IfCondition GreaterThan(hi, 0) ThenBlock: {
                    IfCondition LessThan(hi, CadApp.hist_n) ThenBlock: {
                        ps = ArrayGet(CadApp.hist_solid, Subtract(hi, 1))
                    }
                }
            }
        }
        IfCondition EqualTo(ps, 0) ThenBlock: {
            i = Subtract(CadApp.hist_n, 1)
            WhileLoop GreaterEqual(i, 1) {
                IfCondition EqualTo(ArrayGet(CadApp.hist_kind, i), ArrayGet(CadApp.feat_kind, feat_i)) ThenBlock: {
                    ps = ArrayGet(CadApp.hist_solid, Subtract(i, 1))
                    i = 0
                }
                IfCondition GreaterThan(i, 0) ThenBlock: { i = Subtract(i, 1) }
            }
        }
        IfCondition EqualTo(ps, 0) ThenBlock: { ReturnValue(-1) }
        CadApp.bl_parent = ps
        CadApp.solid = ps
        CAD_View.InvalidateMesh()
        CA_Log("cad_app: blend rolled back to parent body\n", 41)
        ReturnValue(0)
    }
}

Function.CA_BlendUpdateHist {
    Output: Integer
    Body: {
        fi = CadApp.feat_sel
        IfCondition LessThan(fi, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.feat_hi, 0) ThenBlock: { ReturnValue(0) }
        hi = ArrayGet(CadApp.feat_hi, fi)
        IfCondition LessThan(hi, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(hi, CadApp.hist_n) ThenBlock: { ReturnValue(0) }
        ArraySet(CadApp.hist_solid, hi, CadApp.solid)
        CadApp.hist_cur = hi
        CA_WriteHist()
        ReturnValue(1)
    }
}

// Ensure sel_edge_buf exists (12 handles).
Function.CA_EnsureEdgeSelBuf {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sel_edge_buf, 0) ThenBlock: {
            CadApp.sel_edge_buf = Allocate(128)
            CadApp.sel_nedges = 0
        }
        ReturnValue(CadApp.sel_edge_buf)
    }
}

Function.CA_ClearEdgeSel {
    Output: Integer
    Body: {
        CadApp.sel_edge_id = 0
        CadApp.sel_nedges = 0
        CadApp.nclick = 0
        ReturnValue(0)
    }
}

// Toggle/add edge into multi-sel (max 12). Returns new count.
Function.CA_AddEdgeSel {
    Input: edge_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(CadApp.sel_nedges) }
        CA_EnsureEdgeSelBuf()
        buf = CadApp.sel_edge_buf
        n = CadApp.sel_nedges
        // toggle off if already selected
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(ArrayGet(buf, i), edge_h) ThenBlock: {
                k = i
                WhileLoop LessThan(k, Subtract(n, 1)) {
                    ArraySet(buf, k, ArrayGet(buf, Add(k, 1)))
                    k = Add(k, 1)
                }
                n = Subtract(n, 1)
                CadApp.sel_nedges = n
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    CadApp.sel_edge_id = ArrayGet(buf, Subtract(n, 1))
                }
                IfCondition EqualTo(n, 0) ThenBlock: { CadApp.sel_edge_id = 0 }
                ReturnValue(n)
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(n, 12) ThenBlock: {
            ArraySet(buf, n, edge_h)
            n = Add(n, 1)
            CadApp.sel_nedges = n
            CadApp.sel_edge_id = edge_h
        }
        ReturnValue(n)
    }
}

Function.CA_DrawOneEdgeHL {
    Input: ed: Integer
    Input: fr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(ed, 0) ThenBlock: { ReturnValue(0) }
        v0 = CAD_Store.Read(ed, 0)
        v1 = CAD_Store.Read(ed, 1)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        col = FB_RGB(0, 255, 240)
        col2 = FB_RGB(255, 240, 40)
        crv = CAD_Store.Read(ed, 2)
        IfCondition EqualTo(v0, v1) ThenBlock: {
            IfCondition NotEqual(crv, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(crv, 0), 2) ThenBlock: {
                    IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: {
                        CAD_Tess_State.samp = Allocate(8192)
                    }
                    ns = CAD_Tess.SampleCircleEdge(ed, 48, CAD_Tess_State.samp)
                    samp = CAD_Tess_State.samp
                    a = Allocate(32)
                    b = Allocate(32)
                    si = 0
                    WhileLoop LessThan(si, Subtract(ns, 1)) {
                        CA_World3ToPix(ArrayGet(samp, Multiply(si, 3)), ArrayGet(samp, Add(Multiply(si, 3), 1)), ArrayGet(samp, Add(Multiply(si, 3), 2)), fr, a)
                        CA_World3ToPix(ArrayGet(samp, Multiply(Add(si, 1), 3)), ArrayGet(samp, Add(Multiply(Add(si, 1), 3), 1)), ArrayGet(samp, Add(Multiply(Add(si, 1), 3), 2)), fr, b)
                        FB_Line(ArrayGet(a, 0), ArrayGet(a, 1), ArrayGet(b, 0), ArrayGet(b, 1), col)
                        FB_Line(Add(ArrayGet(a, 0), 1), ArrayGet(a, 1), Add(ArrayGet(b, 0), 1), ArrayGet(b, 1), col2)
                        si = Add(si, 1)
                    }
                    Deallocate(a, 32)
                    Deallocate(b, 32)
                    ReturnValue(1)
                }
            }
        }
        a = Allocate(32)
        b = Allocate(32)
        CA_World3ToPix(CAD_Store.Read(v0, 0), CAD_Store.Read(v0, 1), CAD_Store.Read(v0, 2), fr, a)
        CA_World3ToPix(CAD_Store.Read(v1, 0), CAD_Store.Read(v1, 1), CAD_Store.Read(v1, 2), fr, b)
        x0 = ArrayGet(a, 0)
        y0 = ArrayGet(a, 1)
        x1 = ArrayGet(b, 0)
        y1 = ArrayGet(b, 1)
        FB_Line(x0, y0, x1, y1, col)
        FB_Line(Add(x0, 1), y0, Add(x1, 1), y1, col)
        FB_Line(x0, Add(y0, 1), x1, Add(y1, 1), col)
        FB_Line(Subtract(x0, 1), y0, Subtract(x1, 1), y1, col2)
        FB_FillRect(Subtract(x0, 3), Subtract(y0, 3), 7, 7, col2)
        FB_FillRect(Subtract(x1, 3), Subtract(y1, 3), 7, 7, col2)
        Deallocate(a, 32)
        Deallocate(b, 32)
        ReturnValue(1)
    }
}

// Draw all selected solid edges (cyan/yellow overlay after shade).
Function.CA_DrawSelectedEdgeHighlight {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(0) }
        n = CadApp.sel_nedges
        IfCondition EqualTo(n, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.sel_edge_id, 0) ThenBlock: { ReturnValue(0) }
        }
        fr = Allocate(64)
        CA_BuildViewFrame(fr)
        IfCondition GreaterThan(n, 0) ThenBlock: {
            buf = CadApp.sel_edge_buf
            i = 0
            WhileLoop LessThan(i, n) {
                CA_DrawOneEdgeHL(ArrayGet(buf, i), fr)
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(n, 0) ThenBlock: {
            CA_DrawOneEdgeHL(CadApp.sel_edge_id, fr)
        }
        Deallocate(fr, 64)
        ReturnValue(1)
    }
}

// Edge length in world units (0 if bad handle).
Function.CA_SolidEdgeLen {
    Input: edge_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        v0 = CAD_Store.Read(edge_h, 0)
        v1 = CAD_Store.Read(edge_h, 1)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v0, v1) ThenBlock: {
            crv = CAD_Store.Read(edge_h, 2)
            IfCondition NotEqual(crv, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(crv, 0), 2) ThenBlock: {
                    two_pi = 0x401921FB54442D18
                    ReturnValue(Float_Mul(two_pi, CAD_Store.Read(crv, 10)))
                }
            }
        }
        dx = Float_Sub(CAD_Store.Read(v1, 0), CAD_Store.Read(v0, 0))
        dy = Float_Sub(CAD_Store.Read(v1, 1), CAD_Store.Read(v0, 1))
        dz = Float_Sub(CAD_Store.Read(v1, 2), CAD_Store.Read(v0, 2))
        ReturnValue(CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz))))
    }
}

// If 2+ edges selected, add every remaining LINE edge on any incident face.
// Lets Digon rebuild a whole face cycle instead of sequential single fillets.
Function.CA_ExpandEdgeSelFaces {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.sel_nedges, 2) ThenBlock: { ReturnValue(CadApp.sel_nedges) }
        IfCondition EqualTo(CadApp.sel_edge_buf, 0) ThenBlock: { ReturnValue(0) }
        CA_EnsureEdgeSelBuf()
        buf = CadApp.sel_edge_buf
        n0 = CadApp.sel_nedges
        faces = Allocate(32)
        i = 0
        WhileLoop LessThan(i, n0) {
            ed = ArrayGet(buf, i)
            IfCondition NotEqual(ed, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(ed, faces), 0) ThenBlock: {
                    fi = 0
                    WhileLoop LessThan(fi, 2) {
                        fh = ArrayGet(faces, fi)
                        IfCondition NotEqual(fh, 0) ThenBlock: {
                            lp = CAD_Store.Read(fh, 1)
                            IfCondition NotEqual(lp, 0) ThenBlock: {
                                hd = CAD_Store.Read(lp, 0)
                                ce = hd
                                cg = 0
                                dn = 0
                                WhileLoop EqualTo(dn, 0) {
                                    fe = CAD_Store.Read(ce, 0)
                                    // skip already-blend curves (circle/cyl)
                                    crv = 0
                                    IfCondition NotEqual(fe, 0) ThenBlock: {
                                        crv = CAD_Store.Read(fe, 2)
                                    }
                                    ok = 1
                                    IfCondition NotEqual(crv, 0) ThenBlock: {
                                        ck = CAD_Store.Read(crv, 0)
                                        // 2=circle — already a fillet arc
                                        IfCondition EqualTo(ck, 2) ThenBlock: { ok = 0 }
                                    }
                                    IfCondition EqualTo(ok, 1) ThenBlock: {
                                        CA_AddEdgeSel(fe)
                                    }
                                    ce = CAD_Store.Read(ce, 2)
                                    cg = Add(cg, 1)
                                    IfCondition EqualTo(ce, hd) ThenBlock: { dn = 1 }
                                    IfCondition GreaterThan(cg, 64) ThenBlock: { dn = 1 }
                                }
                            }
                        }
                        fi = Add(fi, 1)
                    }
                }
            }
            i = Add(i, 1)
        }
        Deallocate(faces, 32)
        PrintMessage("cad_app: fillet expand n=")
        PrintNumber(CadApp.sel_nedges)
        PrintMessage("\n")
        ReturnValue(CadApp.sel_nedges)
    }
}

// Clamp fillet R: default 2mm; never more than 40% of edge / min AABB extent.
// out_addr[0] = r_val (float bits). Returns r_val.
Function.CA_FilletClampR {
    Input: radius_mm: Integer
    Input: edge_h: Integer
    Input: out_addr: Address
    Output: Integer
    Body: {
        rmm = radius_mm
        IfCondition LessEqual(rmm, 0) ThenBlock: { rmm = 2 }
        r_val = Float_FromInt(rmm)
        cap = 0
        IfCondition NotEqual(edge_h, 0) ThenBlock: {
            el = CA_SolidEdgeLen(edge_h)
            // 0.4 * edge
            cap = Float_Mul(el, 0x3FD999999999999A)
        }
        IfCondition EqualTo(CAD_Num.IsZero(cap, 0), 1) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                mn = Allocate(32)
                mx = Allocate(32)
                IfCondition EqualTo(CAD_Topo.SolidBounds(CadApp.solid, mn, mx), 1) ThenBlock: {
                    dx = Float_Sub(ArrayGet(mx, 0), ArrayGet(mn, 0))
                    dy = Float_Sub(ArrayGet(mx, 1), ArrayGet(mn, 1))
                    dz = Float_Sub(ArrayGet(mx, 2), ArrayGet(mn, 2))
                    m = dx
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(dy, m)), 1) ThenBlock: { m = dy }
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(dz, m)), 1) ThenBlock: { m = dz }
                    cap = Float_Mul(m, 0x3FD999999999999A)
                }
                Deallocate(mn, 32)
                Deallocate(mx, 32)
            }
        }
        IfCondition EqualTo(CAD_Num.IsZero(cap, 0), 0) ThenBlock: {
            // if r_val > cap → use cap (IsNeg(cap - r) == 1)
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(cap, r_val)), 1) ThenBlock: {
                r_val = cap
            }
        }
        // never below 0.5 mm
        rmin = 0x3FE0000000000000
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(r_val, rmin)), 1) ThenBlock: {
            r_val = rmin
        }
        ArraySet(out_addr, 0, r_val)
        ReturnValue(r_val)
    }
}

// Fillet selected edge if CadApp.sel_edge_id set; else all edges (legacy).
// radius_mm is integer mm. 0 → 2mm, then clamp to 0.4*edge (box H/2 fail).
// Always stay in 3D (mode=0); never switch to sketch/pick.
Function.CA_FilletSolid {
    Input: radius_mm: Integer
    Output: Integer
    Body: {
        CadApp.mode = 0
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_Log("cad_app: fillet needs active 3D solid\n", 37)
            ReturnValue(-1)
        }
        CadApp.bl_parent = CadApp.solid
        IfCondition EqualTo(CadApp.fillet_edit, 1) ThenBlock: {
            IfCondition EqualTo(CA_BlendLoadFeat(CadApp.feat_sel), -1) ThenBlock: {
                CA_BlendRollbackParent(CadApp.feat_sel)
                CA_Log("cad_app: fillet edit - click the original edges, Enter\n", 55)
                ReturnValue(-1)
            }
        }
        ns0 = CadApp.sel_nedges
        IfCondition LessThan(ns0, 1) ThenBlock: {
            IfCondition EqualTo(CadApp.sel_edge_id, 0) ThenBlock: {
                CadApp.tool = 8
                CA_Log("cad_app: 3D fillet - pick edges then fillet R\n", 45)
                ReturnValue(-1)
            }
        }
        CA_BlendSnapSel()
        rp = Allocate(16)
        eh = CadApp.sel_edge_id
        r_val = CA_FilletClampR(radius_mm, eh, rp)
        r_val = ArrayGet(rp, 0)
        Deallocate(rp, 16)
        PrintMessage("cad_app: solid fillet Rmm_in=")
        PrintNumber(radius_mm)
        PrintMessage(" R_int=")
        PrintNumber(Float_ToInt(r_val))
        PrintMessage(" nsel=")
        PrintNumber(CadApp.sel_nedges)
        PrintMessage("\n")
        CA_LogInt("cad_app: fillet apply nsel=", 26, ns0)
        fil = 0
        ns = CadApp.sel_nedges
        // Fillet EXACTLY the picked edges. Expand-to-incident-faces added
        // verticals when the user clicked a top rim (select.png → result.png).
        snap = Allocate(128)
        si = 0
        WhileLoop LessThan(si, ns) {
            ArraySet(snap, si, ArrayGet(CadApp.sel_edge_buf, si))
            si = Add(si, 1)
        }
        IfCondition GreaterThan(ns, 1) ThenBlock: {
            PrintMessage("cad_app: solid fillet batch n=")
            PrintNumber(ns)
            PrintMessage("\n")
            nvert = 0
            nhoriz = 0
            zref = 0
            i = 0
            WhileLoop LessThan(i, ns) {
                ed = ArrayGet(snap, i)
                v0 = CAD_Store.Read(ed, 0)
                v1 = CAD_Store.Read(ed, 1)
                dz = Float_Sub(CAD_Store.Read(v1, 2), CAD_Store.Read(v0, 2))
                IfCondition EqualTo(CAD_Num.IsNeg(dz), 1) ThenBlock: { dz = Float_Sub(0, dz) }
                IfCondition EqualTo(CAD_Num.IsZero(dz, 0), 1) ThenBlock: {
                    nhoriz = Add(nhoriz, 1)
                    zref = CAD_Store.Read(v0, 2)
                }
                IfCondition EqualTo(CAD_Num.IsZero(dz, 0), 0) ThenBlock: { nvert = Add(nvert, 1) }
                i = Add(i, 1)
            }
            IfCondition EqualTo(nhoriz, ns) ThenBlock: {
                IfCondition GreaterEqual(ns, 3) ThenBlock: {
                    IfCondition GreaterThan(CAD_Topo.SolidCountShells(CadApp.solid), 1) ThenBlock: {
                        CA_Log("cad_app: fillet skip prism-cap (compound/glue)\n", 47)
                    }
                    IfCondition LessEqual(CAD_Topo.SolidCountShells(CadApp.solid), 1) ThenBlock: {
                    mn = Allocate(32)
                    mx = Allocate(32)
                    on_top = 1
                    IfCondition EqualTo(CAD_Topo.SolidBounds(CadApp.solid, mn, mx), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(zref, ArrayGet(mn, 2), 0), 1) ThenBlock: {
                            on_top = 0
                        }
                    }
                    Deallocate(mn, 32)
                    Deallocate(mx, 32)
                    CA_LogInt("cad_app: fillet path=prism-cap on_top=", 37, on_top)
                    fil = CAD_Topo.FilletPrismCap(CadApp.solid, r_val, on_top)
                    }
                }
            }
            // Mixed / non-prism: FilletEdges (Digon or last-only).
            IfCondition EqualTo(fil, 0) ThenBlock: {
                fil = CAD_Blend.FilletEdges(CadApp.solid, snap, ns, r_val)
            }
            IfCondition EqualTo(fil, 0) ThenBlock: {
                CA_Log("cad_app: 3D fillet batch FAIL - not applying last-only\n", 54)
            }
            CA_ClearEdgeSel()
        }
        // single picked edge only
        IfCondition EqualTo(ns, 1) ThenBlock: {
            IfCondition NotEqual(eh, 0) ThenBlock: {
                PrintMessage("cad_app: solid fillet edge=")
                PrintNumber(eh)
                PrintMessage("\n")
                fil = CAD_Blend.FilletEdge(CadApp.solid, eh, r_val)
                IfCondition EqualTo(fil, 0) ThenBlock: {
                    fil = CAD_Blend.AddFillet(CadApp.solid, eh, r_val)
                }
                CA_ClearEdgeSel()
            }
        }
        Deallocate(snap, 128)
        IfCondition EqualTo(fil, 0) ThenBlock: {
            IfCondition LessThan(ns, 1) ThenBlock: {
                CadApp.mode = 0
                CadApp.tool = 8
                CA_Log("cad_app: 3D fillet - pick edges then fillet R\n", 45)
                ReturnValue(-1)
            }
        }
        CadApp.mode = 0
        CadApp.tool = 8
        IfCondition EqualTo(fil, 0) ThenBlock: {
            CA_Log("cad_app: 3D solid fillet FAIL\n", 28)
            ReturnValue(-1)
        }
        CAD_View.InvalidateMesh()
        CadApp.solid = fil
        CadApp.dirty = 1
        CadApp.wire = 0
        CAD_View.SetWire(0)
        mesh = Allocate(48)
        nt = CAD_Tess.MeshSolid(fil, 0x3FB999999999999A, mesh)
        CA_LogInt("cad_app: fillet mesh nt=", 24, nt)
        CA_LogInt("cad_app: fillet mesh nv=", 24, ArrayGet(mesh, 0))
        CA_LogInt("cad_app: fillet mesh wt=", 24, CAD_Tess.VerifyWatertight(mesh))
        Deallocate(mesh, 48)
        IfCondition EqualTo(CadApp.fillet_edit, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                ArraySet(CadApp.feat_aux, CadApp.feat_sel, Float_ToInt(r_val))
            }
            CA_BlendBindFeat(4)
            CA_BlendUpdateHist()
            CA_ClearEdgeSel()
            CadApp.fillet_edit = 0
            CA_LogS("cad_app: 3D solid fillet EDIT OK\n")
            ReturnValue(0)
        }
        CA_FeatAdd(4, CadApp.edge_sk)
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ArraySet(CadApp.feat_aux, CadApp.feat_sel, Float_ToInt(r_val))
        }
        CA_BlendBindFeat(4)
        CA_ClearEdgeSel()
        CA_LogS("cad_app: 3D solid fillet OK\n")
        ReturnValue(0)
    }
}

// Chamfer picked edges. 2+ same-Z → prism cap (meeting-cut corners).
// Verticals → ChamferEdges. Single → ChamferEdge. Stay in 3D.
Function.CA_ChamferSolid {
    Input: dist_mm: Integer
    Output: Integer
    Body: {
        CadApp.mode = 0
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_Log("cad_app: chamfer needs active 3D solid\n", 38)
            ReturnValue(-1)
        }
        CadApp.bl_parent = CadApp.solid
        IfCondition EqualTo(CadApp.chamfer_edit, 1) ThenBlock: {
            IfCondition EqualTo(CA_BlendLoadFeat(CadApp.feat_sel), -1) ThenBlock: {
                CA_BlendRollbackParent(CadApp.feat_sel)
                CA_Log("cad_app: chamfer edit - click the original edges, Enter\n", 56)
                ReturnValue(-1)
            }
        }
        ns0 = CadApp.sel_nedges
        IfCondition LessThan(ns0, 1) ThenBlock: {
            IfCondition EqualTo(CadApp.sel_edge_id, 0) ThenBlock: {
                CadApp.tool = 10
                CA_Log("cad_app: 3D chamfer - pick edges then chamfer D\n", 47)
                ReturnValue(-1)
            }
        }
        CA_BlendSnapSel()
        dmm = dist_mm
        IfCondition LessEqual(dmm, 0) ThenBlock: { dmm = 2 }
        CadApp.chamfer_d = dmm
        CadApp.pick_best_d = dmm
        d_val = Float_FromInt(dmm)
        ns = CadApp.sel_nedges
        eh = CadApp.sel_edge_id
        PrintMessage("cad_app: solid chamfer D=")
        PrintNumber(dmm)
        PrintMessage(" nsel=")
        PrintNumber(ns)
        PrintMessage("\n")
        CA_LogInt("cad_app: chamfer apply nsel=", 27, ns)
        ch = 0
        IfCondition GreaterThan(ns, 1) ThenBlock: {
            buf = CadApp.sel_edge_buf
            nvert = 0
            nhoriz = 0
            zref = 0
            i = 0
            WhileLoop LessThan(i, ns) {
                ed = ArrayGet(buf, i)
                v0 = CAD_Store.Read(ed, 0)
                v1 = CAD_Store.Read(ed, 1)
                dz = Float_Sub(CAD_Store.Read(v1, 2), CAD_Store.Read(v0, 2))
                IfCondition EqualTo(CAD_Num.IsNeg(dz), 1) ThenBlock: { dz = Float_Sub(0, dz) }
                IfCondition EqualTo(CAD_Num.IsZero(dz, 0), 1) ThenBlock: {
                    nhoriz = Add(nhoriz, 1)
                    zref = CAD_Store.Read(v0, 2)
                }
                IfCondition EqualTo(CAD_Num.IsZero(dz, 0), 0) ThenBlock: { nvert = Add(nvert, 1) }
                i = Add(i, 1)
            }
            IfCondition EqualTo(nhoriz, ns) ThenBlock: {
                IfCondition GreaterThan(CAD_Topo.SolidCountShells(CadApp.solid), 1) ThenBlock: {
                    CA_Log("cad_app: chamfer skip prism-cap (compound/glue)\n", 48)
                }
                IfCondition LessEqual(CAD_Topo.SolidCountShells(CadApp.solid), 1) ThenBlock: {
                mn = Allocate(32)
                mx = Allocate(32)
                on_top = 1
                IfCondition EqualTo(CAD_Topo.SolidBounds(CadApp.solid, mn, mx), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(zref, ArrayGet(mn, 2), 0), 1) ThenBlock: {
                        on_top = 0
                    }
                }
                Deallocate(mn, 32)
                Deallocate(mx, 32)
                PrintMessage("cad_app: chamfer prism cap on_top=")
                PrintNumber(on_top)
                PrintMessage("\n")
                CA_LogInt("cad_app: chamfer path=prism-cap on_top=", 38, on_top)
                ch = CAD_Topo.ChamferPrismCap(CadApp.solid, d_val, on_top)
                }
            }
            IfCondition EqualTo(nvert, ns) ThenBlock: {
                ch = CAD_Blend.ChamferEdges(CadApp.solid, buf, ns, d_val)
            }
            CA_ClearEdgeSel()
        }
        IfCondition EqualTo(ns, 1) ThenBlock: {
            IfCondition NotEqual(eh, 0) ThenBlock: {
                ch = CAD_Blend.ChamferEdge(CadApp.solid, eh, d_val)
                CA_ClearEdgeSel()
            }
        }
        CadApp.mode = 0
        CadApp.tool = 10
        IfCondition EqualTo(ch, 0) ThenBlock: {
            IfCondition LessThan(ns, 1) ThenBlock: {
                CA_Log("cad_app: 3D chamfer - pick edges then chamfer D\n", 47)
                ReturnValue(-1)
            }
            CA_Log("cad_app: 3D solid chamfer FAIL\n", 30)
            ReturnValue(-1)
        }
        CAD_View.InvalidateMesh()
        CadApp.solid = ch
        CadApp.dirty = 1
        CadApp.wire = 0
        CAD_View.SetWire(0)
        mesh = Allocate(48)
        nt = CAD_Tess.MeshSolid(ch, 0x3FB999999999999A, mesh)
        CA_LogInt("cad_app: chamfer mesh nt=", 25, nt)
        CA_LogInt("cad_app: chamfer mesh nv=", 25, ArrayGet(mesh, 0))
        Deallocate(mesh, 48)
        skp = CadApp.edge_sk
        IfCondition EqualTo(CadApp.chamfer_edit, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.pick_best_d)
            }
            CA_BlendBindFeat(5)
            CA_BlendUpdateHist()
            CA_ClearEdgeSel()
            CadApp.chamfer_edit = 0
            CA_LogInt("cad_app: chamfer edit D=", 24, CadApp.pick_best_d)
            CA_LogS("cad_app: 3D solid chamfer EDIT OK\n")
            ReturnValue(0)
        }
        CA_FeatAdd(5, skp)
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.pick_best_d)
        }
        CA_BlendBindFeat(5)
        CA_LogInt("cad_app: chamfer tree sk=", 24, skp)
        CA_LogS("cad_app: 3D solid chamfer OK\n")
        ReturnValue(0)
    }
}


// Build solid from current sketch (+ optional hole sketch).
// Paths: plate+hole DXF pair | multi-loop single sketch | single pad.
Function.CA_BuildSolid {
    Output: Integer
    Body: {
        CAD_View.InvalidateMesh()
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: no sketch\n", 19)
            ReturnValue(-1)
        }
        dh = CadApp.height
        IfCondition EqualTo(dh, 0) ThenBlock: { dh = 10 }
        IfCondition LessThan(dh, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: { CadApp.extrude_op = 1 }
            dh = Subtract(0, dh)
        }
        IfCondition LessThan(dh, 1) ThenBlock: { dh = 1 }
        hgt = Float_FromInt(dh)
        h = 0
        IfCondition NotEqual(CadApp.hole_sk, 0) ThenBlock: {
            h = CAD_Feat.ExtrudePlateThroughHole(CadApp.sketch, CadApp.hole_sk, hgt)
            IfCondition EqualTo(h, 0) ThenBlock: {
                CA_Log("cad_app: plate+hole FAIL\n", 25)
                ReturnValue(-2)
            }
            CadApp.solid = h
            CadApp.dirty = 1
            CA_Log("cad_app: plate+hole ok\n", 23)
            ReturnValue(0)
        }
        // --- pad paths ---
        // Never PrepareExtrude the LIVE sketch (mutates arcs/lines/circles).
        // Circles/rects use the same profile → poly prism path (no analytic cyl/box).
        live = CadApp.sketch

        // Keep user selection across rebuild (rebuild clears mask by design)
        saved_user = CadApp.prof_user
        saved_mask = CadApp.prof_mask
        saved_sel = CadApp.prof_sel
        sk_nprof = CA_RebuildProfiles()
        CadApp.nprof = sk_nprof
        IfCondition EqualTo(sk_nprof, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL (no closed profile)\n", 38)
            CA_Log("  close a loop (RECT/circle), then Pad again\n", 45)
            CA_DumpSketchGeom(live, "cad_app: LIVE pad no profile", 28)
            ReturnValue(-2)
        }

        // File/DXF path (import only — not interactive auto-pick)
        IfCondition EqualTo(CadApp.auto_pad, 1) ThenBlock: {
            clone = CAD_Sketch.CreateSketch(1)
            CA_CopySketchGeom(CadApp.sketch, clone)
            CAD_Sketch.PrepareExtrude(clone)
            h = CAD_Feat.ExtrudeProfile(clone, hgt)
            IfCondition EqualTo(h, 0) ThenBlock: {
                CA_Log("cad_app: pad FAIL (auto extrude)\n", 33)
                ReturnValue(-2)
            }
            CadApp.solid = h
            CadApp.dirty = 1
            CadApp.prof_user = 0
            CA_Log("cad_app: pad OK (file/auto)\n", 28)
            ReturnValue(0)
        }

        // Restore explicit user pick; NEVER invent a selection
        IfCondition EqualTo(saved_user, 1) ThenBlock: {
            IfCondition NotEqual(saved_mask, 0) ThenBlock: {
                CadApp.prof_user = 1
                CadApp.prof_mask = saved_mask
                CadApp.prof_sel = saved_sel
                // clamp sel into range
                IfCondition GreaterEqual(CadApp.prof_sel, sk_nprof) ThenBlock: {
                    CadApp.prof_sel = 0
                }
            }
        }
        IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL - pick a profile first (light red rings)\n", 59)
            CA_Log("  Pick tool / click face; Shift+click multi; then Pad\n", 54)
            ReturnValue(-3)
        }
        IfCondition EqualTo(CadApp.prof_mask, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL - nothing selected (bright red needed)\n", 57)
            ReturnValue(-3)
        }
        // Every selected closed ring is its own planar prism. No "inside = hole".
        // Extra selections CompoundAdd. (Holes were brittle and tess-broke.)
        PrintMessage("cad_app: pad nprof=")
        PrintNumber(sk_nprof)
        PrintMessage(" mask=")
        PrintNumber(CadApp.prof_mask)
        PrintMessage(" sel=")
        PrintNumber(CadApp.prof_sel)
        PrintMessage("\n")
        CA_Log("cad_app: pad after pick restore\n", 31)
        IfCondition NotEqual(CA_PadBufs(), 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL - ring buf\n", 29)
            ReturnValue(-2)
        }
        xy = CadAppPad.xy
        oxy = CadAppPad.oxy
        outer_i = -1
        outer_a = 0
        outer_nn = 0
        pi = 0
        WhileLoop LessThan(pi, sk_nprof) {
            IfCondition LessThan(pi, 32) ThenBlock: {
                bit = LeftShift(1, pi)
                IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: {
                    nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                    IfCondition GreaterEqual(nn, 3) ThenBlock: {
                        ar = CAD_Sketch.LoopSignedArea(xy, nn)
                        IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                        better = 0
                        IfCondition EqualTo(outer_i, -1) ThenBlock: { better = 1 }
                        IfCondition EqualTo(Float_Le(outer_a, ar), 1) ThenBlock: {
                            IfCondition NotEqual(pi, outer_i) ThenBlock: { better = 1 }
                        }
                        IfCondition EqualTo(better, 1) ThenBlock: {
                            outer_i = pi
                            outer_a = ar
                            outer_nn = nn
                            k = 0
                            WhileLoop LessThan(k, nn) {
                                ArraySet(oxy, Multiply(k, 2), ArrayGet(xy, Multiply(k, 2)))
                                ArraySet(oxy, Add(Multiply(k, 2), 1), ArrayGet(xy, Add(Multiply(k, 2), 1)))
                                k = Add(k, 1)
                            }
                        }
                        PrintMessage("cad_app: pad prof=")
                        PrintNumber(pi)
                        PrintMessage(" nn=")
                        PrintNumber(nn)
                        PrintMessage(" area=")
                        PrintNumber(Float_ToInt(ar))
                        PrintMessage("\n")
                    }
                }
            }
            pi = Add(pi, 1)
        }
        IfCondition LessThan(outer_i, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL - no valid ring\n", 34)
            ReturnValue(-2)
        }
        // Primary = largest selected ring (first prism). Others compound later.
        // PIN outer_nn / oxy / height BEFORE CreateSketch/AddProfileXY — nested
        // calls clobber locals and AddProfileXY(n=4 garbage) → MakeBoxSolid cube.
        onn = outer_nn
        oaddr = oxy
        oi = outer_i
        ohgt = hgt
        IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: {
            ohgt = Float_Sub(0, hgt)
        }
        PrintMessage("cad_app: pad outer_i=")
        PrintNumber(oi)
        PrintMessage(" onn=")
        PrintNumber(onn)
        PrintMessage("\n")
        IfCondition LessThan(onn, 3) ThenBlock: {
            CA_Log("cad_app: pad FAIL - outer ring clobbered\n", 41)
            ReturnValue(-2)
        }
        // Pure circle sketch → analytic cylinder (kind 1), then glue.
        IfCondition EqualTo(CAD_Store.Read(live, 0), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(live, 10), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(live, 7), 1) ThenBlock: {
                    IfCondition EqualTo(sk_nprof, 1) ThenBlock: {
                        pln = CAD_Sketch.GetPlaneId(live)
                        IfCondition EqualTo(pln, 0) ThenBlock: { pln = CadApp.plane }
                        IfCondition NotEqual(pln, 0) ThenBlock: {
                            IfCondition NotEqual(pln, CadApp.sk0_plane) ThenBlock: {
                                CadApp.keep_solid = CadApp.solid
                            }
                        }
                        CA_Log("cad_app: pad analytic cylinder\n", 31)
                        cyl_sk = CA_CurrentSkIdx()
                        h = CAD_Feat.ExtrudeOnPlane(live, ohgt, pln)
                        IfCondition EqualTo(h, 0) ThenBlock: {
                            CA_Log("cad_app: pad FAIL (analytic cyl)\n", 33)
                            ReturnValue(-2)
                        }
                        old_solid = CadApp.keep_solid
                        IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: {
                            IfCondition EqualTo(old_solid, 0) ThenBlock: {
                                CA_Log("cad_app: cut FAIL - no body\n", 28)
                                ReturnValue(-2)
                            }
                            cut = CAD_Bool.Difference(old_solid, h)
                            IfCondition EqualTo(cut, 0) ThenBlock: {
                                cut = CAD_Feat.ExtrudeCut(old_solid, live, ohgt)
                            }
                            IfCondition EqualTo(cut, 0) ThenBlock: {
                                CA_Log("cad_app: cut FAIL (bool / alignment)\n", 37)
                                ReturnValue(-2)
                            }
                            h = cut
                        }
                        IfCondition NotEqual(CadApp.extrude_op, 1) ThenBlock: {
                            IfCondition NotEqual(CadApp.extrude_op, 2) ThenBlock: {
                                IfCondition NotEqual(old_solid, 0) ThenBlock: {
                                    IfCondition NotEqual(old_solid, h) ThenBlock: {
                                        CA_Log("cad_app: pad cyl rebuild host\n", 30)
                                        CAD_Topo.RebuildKind0Planes(old_solid)
                                        CA_Log("cad_app: pad cyl rebuild tool\n", 30)
                                        CAD_Topo.RebuildKind0Planes(h)
                                        CA_Log("cad_app: pad cyl before glue\n", 29)
                                        glued = CAD_Bool.GlueOnFace(old_solid, h)
                                        CA_LogInt("cad_app: pad cyl glue h=", 24, glued)
                                        IfCondition NotEqual(glued, 0) ThenBlock: {
                                            h = glued
                                            CAD_Topo.RebuildKind0Planes(h)
                                            CA_Log("cad_app: pad OK (glue analytic cyl)\n", 36)
                                        }
                                        IfCondition EqualTo(glued, 0) ThenBlock: {
                                            h = CAD_Topo.CompoundAdd(old_solid, h)
                                            IfCondition EqualTo(h, 0) ThenBlock: {
                                                CA_Log("cad_app: pad FAIL (compound cyl)\n", 33)
                                                ReturnValue(-2)
                                            }
                                            CA_Log("cad_app: pad WARN compound cyl\n", 31)
                                        }
                                    }
                                }
                            }
                        }
                        CadApp.solid = h
                        CAD_Topo.RebuildKind0Planes(CadApp.solid)
                        CA_RegenPlaneTree()
                        CadApp.dirty = 1
                        CadApp.mode = 0
                        CAD_View.SetViewMode(0)
                        CadApp.keep_solid = 0
                        IfCondition EqualTo(CadApp.pad_edit, 0) ThenBlock: {
                            fk = 1
                            IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: { fk = 3 }
                            CA_LogInt("cad_app: cyl feat sk=", 21, cyl_sk)
                            CA_FeatAdd(fk, cyl_sk)
                            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                                ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.height)
                            }
                            CadApp.last_pad = CadApp.feat_sel
                            IfCondition EqualTo(CadApp.auto_pad, 0) ThenBlock: {
                                IfCondition EqualTo(CadApp.replay, 0) ThenBlock: { CA_HudOpenPad() }
                            }
                        }
                        IfCondition EqualTo(CadApp.replay, 0) ThenBlock: { CA_PublishFrame() }
                        ReturnValue(0)
                    }
                }
            }
        }
        CA_Log("cad_app: pad before CreateSketch\n", 33)
        hsk = CAD_Sketch.CreateSketch(1)
        IfCondition EqualTo(hsk, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL - sketch alloc\n", 33)
            ReturnValue(-2)
        }
        // re-pin after CreateSketch
        onn2 = onn
        oaddr2 = oaddr
        n_holes = 0
        hole_mask = 0
        spliced = CadAppPad.spliced
        // 1) boundary D-notches share the outer — splice into the ring
        pi = 0
        WhileLoop LessThan(pi, sk_nprof) {
            IfCondition NotEqual(pi, oi) ThenBlock: {
                IfCondition LessThan(pi, 32) ThenBlock: {
                    bit = LeftShift(1, pi)
                    IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: {
                        nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                        IfCondition GreaterEqual(nn, 3) ThenBlock: {
                            onb = 0
                            k = 0
                            WhileLoop LessThan(k, nn) {
                                IfCondition EqualTo(CA_PtOnRing(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), oaddr2, onn2), 1) ThenBlock: {
                                    onb = Add(onb, 1)
                                }
                                k = Add(k, 1)
                            }
                            IfCondition GreaterEqual(onb, 2) ThenBlock: {
                                // boundary D-notch: never a through-hole, never an island
                                hole_mask = BitwiseOr(hole_mask, bit)
                                nn2 = CA_SpliceNotch(oaddr2, onn2, xy, nn, spliced)
                                IfCondition GreaterEqual(nn2, 3) ThenBlock: {
                                    k = 0
                                    WhileLoop LessThan(k, nn2) {
                                        ArraySet(oaddr2, Multiply(k, 2), ArrayGet(spliced, Multiply(k, 2)))
                                        ArraySet(oaddr2, Add(Multiply(k, 2), 1), ArrayGet(spliced, Add(Multiply(k, 2), 1)))
                                        k = Add(k, 1)
                                    }
                                    onn2 = nn2
                                    PrintMessage("cad_app: pad splice notch prof=")
                                    PrintNumber(pi)
                                    PrintMessage(" nn=")
                                    PrintNumber(nn2)
                                    PrintMessage("\n")
                                }
                                IfCondition LessThan(nn2, 3) ThenBlock: {
                                    PrintMessage("cad_app: pad skip boundary-loop prof=")
                                    PrintNumber(pi)
                                    PrintMessage(" onb=")
                                    PrintNumber(onb)
                                    PrintMessage("\n")
                                }
                            }
                        }
                    }
                }
            }
            pi = Add(pi, 1)
        }
        CAD_Sketch.AddProfileXY(hsk, oaddr2, onn2)
        pn_chk = CAD_Store.Read(hsk, 2)
        PrintMessage("cad_app: pad extrude primary n=")
        PrintNumber(pn_chk)
        PrintMessage("\n")
        IfCondition LessThan(pn_chk, 3) ThenBlock: {
            CA_Log("cad_app: pad FAIL - AddProfileXY empty\n", 39)
            ReturnValue(-2)
        }
        // Height 0 = THIS sketch's plane (GetPlaneId), not world Z / leftover CadApp.plane.
        CadApp.keep_solid = 0
        pln = CAD_Sketch.GetPlaneId(hsk)
        IfCondition EqualTo(pln, 0) ThenBlock: {
            pln = CadApp.plane
        }
        IfCondition NotEqual(pln, 0) ThenBlock: {
            IfCondition NotEqual(pln, CadApp.sk0_plane) ThenBlock: {
                CadApp.keep_solid = CadApp.solid
            }
        }
        CA_Log("cad_app: pad before extrude\n", 28)
        h = CAD_Feat.ExtrudeOnPlane(hsk, ohgt, pln)
        CA_Log("cad_app: pad after extrude\n", 27)
        // Every other selected ring is another planar prism (compound).
        // hole_mask here is only "already spliced into the primary ring".
        pi = 0
        WhileLoop LessThan(pi, sk_nprof) {
            IfCondition NotEqual(pi, oi) ThenBlock: {
                IfCondition LessThan(pi, 32) ThenBlock: {
                    bit = LeftShift(1, pi)
                    IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: {
                        IfCondition EqualTo(BitwiseAnd(hole_mask, bit), 0) ThenBlock: {
                            nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                            IfCondition GreaterEqual(nn, 3) ThenBlock: {
                                hnn = nn
                                isk = CAD_Sketch.FromClosedXY(xy, hnn)
                                IfCondition NotEqual(isk, 0) ThenBlock: {
                                    hi = CAD_Feat.ExtrudeOnPlane(isk, ohgt, pln)
                                    IfCondition NotEqual(hi, 0) ThenBlock: {
                                        IfCondition EqualTo(h, 0) ThenBlock: { h = hi }
                                        IfCondition NotEqual(h, hi) ThenBlock: {
                                            IfCondition NotEqual(h, 0) ThenBlock: {
                                                h = CAD_Topo.CompoundAdd(h, hi)
                                                PrintMessage("cad_app: pad extra prism prof=")
                                                PrintNumber(pi)
                                                PrintMessage("\n")
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            pi = Add(pi, 1)
        }
        CAD_Store.Write(CadApp.sketch, 12, sk_nprof)
        IfCondition EqualTo(h, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL (extrude)\n", 28)
            CA_Log("  tip: re-Profiles; check LONG lines / arc tips in dump\n", 56)
            CA_DumpSketchGeom(CadApp.sketch, "cad_app: LIVE on pad FAIL", 25)
            ReturnValue(-2)
        }
        CA_Log("cad_app: pad before compound\n", 29)
        old_solid = CadApp.keep_solid
        IfCondition EqualTo(old_solid, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: {
                old_solid = CadApp.solid
            }
        }
        CA_LogInt("cad_app: pad keep_solid=", 24, old_solid)
        CA_LogInt("cad_app: pad tool_h=", 20, h)
        CA_LogInt("cad_app: pad extrude_op=", 24, CadApp.extrude_op)
        IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: {
            IfCondition EqualTo(old_solid, 0) ThenBlock: {
                CA_Log("cad_app: cut FAIL - no body\n", 28)
                ReturnValue(-2)
            }
            IfCondition EqualTo(old_solid, h) ThenBlock: {
                CA_Log("cad_app: cut FAIL - tool is the body\n", 37)
                ReturnValue(-2)
            }
            cut = CAD_Bool.Difference(old_solid, h)
            IfCondition EqualTo(cut, 0) ThenBlock: {
                cut = CAD_Feat.ExtrudeCut(old_solid, hsk, hgt)
            }
            IfCondition EqualTo(cut, 0) ThenBlock: {
                CA_Log("cad_app: cut FAIL (bool / alignment)\n", 37)
                CA_Log("  top-face rect/circle pocket is the supported domain\n", 54)
                ReturnValue(-2)
            }
            h = cut
            CA_Log("cad_app: cut OK (difference)\n", 29)
        }
        IfCondition NotEqual(CadApp.extrude_op, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.extrude_op, 2) ThenBlock: {
                IfCondition NotEqual(old_solid, 0) ThenBlock: {
                    IfCondition NotEqual(old_solid, h) ThenBlock: {
                        CA_Log("cad_app: pad rebuild host\n", 26)
                        CAD_Topo.RebuildKind0Planes(old_solid)
                        CA_Log("cad_app: pad rebuild tool\n", 26)
                        CAD_Topo.RebuildKind0Planes(h)
                        CA_Log("cad_app: pad before glue\n", 25)
                        glued = CAD_Bool.GlueOnFace(old_solid, h)
                        CA_LogInt("cad_app: pad glue h=", 20, glued)
                        IfCondition NotEqual(glued, 0) ThenBlock: {
                            h = glued
                            CA_Log("cad_app: pad rebuild glued\n", 27)
                            CAD_Topo.RebuildKind0Planes(h)
                            CA_LogInt("cad_app: glue shells=", 21, CAD_Topo.SolidCountShells(h))
                            CA_Log("cad_app: pad OK (glue on face)\n", 31)
                        }
                        IfCondition EqualTo(glued, 0) ThenBlock: {
                            CA_Log("cad_app: pad glue miss, compound\n", 33)
                            h = CAD_Topo.CompoundAdd(old_solid, h)
                            IfCondition EqualTo(h, 0) ThenBlock: {
                                CA_Log("cad_app: pad FAIL (compound on plane)\n", 38)
                                ReturnValue(-2)
                            }
                            CA_Log("cad_app: pad WARN compound (glue miss)\n", 39)
                        }
                    }
                }
            }
            IfCondition EqualTo(CadApp.extrude_op, 2) ThenBlock: {
                CA_Log("cad_app: extrude NEW body\n", 26)
            }
        }
        CadApp.solid = h
        CAD_Topo.RebuildKind0Planes(CadApp.solid)
        CA_Log("cad_app: pad before regen\n", 26)
        // parent-first regen; FACE signature is last-resort (loud miss)
        CA_RegenPlaneTree()
        CA_Log("cad_app: pad after regen\n", 25)
        CadApp.dirty = 1
        CadApp.nprof = sk_nprof
        CadApp.mode = 0
        CAD_View.SetViewMode(0)
        CAD_View_State.zoom_r = 0x3FF0000000000000
        // shaded solid default — no GPU stack; CAD_View FillTri + Z into frame.raw
        CadApp.wire = 0
        CAD_View.SetWire(0)
        PrintMessage("cad_app: pad OK solid=")
        PrintNumber(h)
        PrintMessage(" kind=")
        PrintNumber(CAD_Store.Read(h, 3))
        PrintMessage(" n_holes=")
        PrintNumber(n_holes)
        PrintMessage("\n")
        IfCondition EqualTo(CadApp.keep_solid, 0) ThenBlock: {
            IfCondition GreaterThan(n_holes, 0) ThenBlock: {
                CA_Log("cad_app: pad OK (outer + holes) - 3D view\n", 42)
            }
            IfCondition EqualTo(n_holes, 0) ThenBlock: {
                CA_Log("cad_app: pad OK (profile) - switched to 3D\n", 43)
            }
        }
        CadApp.keep_solid = 0
        IfCondition EqualTo(CadApp.pad_edit, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                IfCondition GreaterEqual(CadApp.feat_sel, 0) ThenBlock: {
                    ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.height)
                }
            }
            CadApp.last_pad = CadApp.feat_sel
        }
        IfCondition EqualTo(CadApp.pad_edit, 0) ThenBlock: {
            fk = 1
            IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: { fk = 3 }
            CA_FeatAdd(fk, CA_CurrentSkIdx())
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.height)
            }
            CadApp.last_pad = CadApp.feat_sel
            IfCondition EqualTo(CadApp.auto_pad, 0) ThenBlock: {
                CA_HudOpenPad()
            }
        }
        CA_Log("cad_app: pad before 3d pub\n", 27)
        IfCondition EqualTo(CadApp.replay, 0) ThenBlock: {
            CA_PublishFrame()
        }
        CA_Log("cad_app: pad after 3d pub\n", 26)
        PrintMessage("cad_app: after pad last_nt=")
        PrintNumber(CAD_View_State.last_nt)
        PrintMessage(" last_nv=")
        PrintNumber(CAD_View_State.last_nv)
        PrintMessage("\n")
        ReturnValue(0)
    }
}


Function.CA_PadFromSketch {
    Output: Integer
    Body: {
        CA_UndoPush()
        IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: { CadApp.extrude_op = 0 }
            CA_HudOpenPad()
            CA_Log("cad_app: extrude - type H, Tab JOIN/CUT/NEW, Enter\n", 52)
            ReturnValue(0)
        }
        CadApp.extrude_op = 0
        ReturnValue(CA_BuildSolid())
    }
}

// Enter face-pick: stay in 3D, next short LMB click chooses a real planar face.


// Map a +Z lathe into the sketch plane about the user-picked axis.
// Lathe verts (Xl,Yl,Zl) with Zl = distance along axis, Xl+i Yl = rho.
// World = origin + Xl*n + Yl*k + Zl*u, u = axis dir, n = left normal, k = +Z.
Function.CA_XformLatheInPlace {
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadAppRev.ok, 0) ThenBlock: { ReturnValue(-1) }
        x0 = CadAppRev.x0
        y0 = CadAppRev.y0
        dx = Float_Sub(CadAppRev.x1, x0)
        dy = Float_Sub(CadAppRev.y1, y0)
        ln = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: { ReturnValue(-1) }
        CadAppRev.ux = Float_Div(dx, ln)
        CadAppRev.uy = Float_Div(dy, ln)
        CadAppRev.nx = Float_Sub(0, CadAppRev.uy)
        CadAppRev.ny = CadAppRev.ux
        kind = CAD_Store.Read(solid_handle, 3)
        IfCondition NotEqual(kind, 0) ThenBlock: { ReturnValue(-1) }
        shell = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(shell, 0) ThenBlock: { ReturnValue(-1) }
        sguard = 0
        WhileLoop NotEqual(shell, 0) {
            face = CAD_Store.Read(shell, 0)
            fguard = 0
            WhileLoop NotEqual(face, 0) {
                lp = CAD_Store.Read(face, 1)
                lguard = 0
                WhileLoop NotEqual(lp, 0) {
                    hd = CAD_Store.Read(lp, 0)
                    ce = hd
                    cdone = 0
                    cguard = 0
                    WhileLoop EqualTo(cdone, 0) {
                        ov = CAD_Store.Read(ce, 5)
                        euse = CAD_Store.Read(ov, 3)
                        IfCondition EqualTo(BitwiseAnd(euse, 0x4000000000000000), 0) ThenBlock: {
                            xl = CAD_Store.Read(ov, 0)
                            yl = CAD_Store.Read(ov, 1)
                            zl = CAD_Store.Read(ov, 2)
                            xw = Float_Add(CadAppRev.x0, Float_Add(Float_Mul(xl, CadAppRev.nx), Float_Mul(zl, CadAppRev.ux)))
                            yw = Float_Add(CadAppRev.y0, Float_Add(Float_Mul(xl, CadAppRev.ny), Float_Mul(zl, CadAppRev.uy)))
                            CAD_Store.Write(ov, 0, xw)
                            CAD_Store.Write(ov, 1, yw)
                            CAD_Store.Write(ov, 2, yl)
                            CAD_Store.Write(ov, 3, BitwiseOr(euse, 0x4000000000000000))
                        }
                        ce = CAD_Store.Read(ce, 2)
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                        IfCondition GreaterThan(cguard, 256) ThenBlock: { cdone = 1 }
                    }
                    lp = CAD_Store.Read(lp, 2)
                    lguard = Add(lguard, 1)
                    IfCondition GreaterThan(lguard, 16) ThenBlock: { lp = 0 }
                }
                face = CAD_Store.Read(face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 4096) ThenBlock: { face = 0 }
            }
            shell = CAD_Store.Read(shell, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { shell = 0 }
        }
        // clear mark bits
        shell = CAD_Store.Read(solid_handle, 0)
        sguard = 0
        WhileLoop NotEqual(shell, 0) {
            face = CAD_Store.Read(shell, 0)
            fguard = 0
            WhileLoop NotEqual(face, 0) {
                lp = CAD_Store.Read(face, 1)
                WhileLoop NotEqual(lp, 0) {
                    hd = CAD_Store.Read(lp, 0)
                    ce = hd
                    cdone = 0
                    cguard = 0
                    WhileLoop EqualTo(cdone, 0) {
                        ov = CAD_Store.Read(ce, 5)
                        euse = CAD_Store.Read(ov, 3)
                        CAD_Store.Write(ov, 3, BitwiseAnd(euse, 0xBFFFFFFFFFFFFFFF))
                        ce = CAD_Store.Read(ce, 2)
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                        IfCondition GreaterThan(cguard, 256) ThenBlock: { cdone = 1 }
                    }
                    lp = CAD_Store.Read(lp, 2)
                }
                face = CAD_Store.Read(face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 4096) ThenBlock: { face = 0 }
            }
            shell = CAD_Store.Read(shell, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { shell = 0 }
        }
        ReturnValue(0)
    }
}

// Revolve selected profile about a USER-PICKED sketch line.
// No auto-hinge, no AABB, no |X| fold. Axis must be clicked (tool 11).
// rho = signed distance to the axis; along-axis = projection.
// Lathe is then mapped back so the sketch stays the generating section.
Function.CA_RevolveFromSketch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: revolve needs sketch\n", 30)
            ReturnValue(-1)
        }
        sk_nprof = CAD_Store.Read(CadApp.sketch, 12)
        IfCondition EqualTo(sk_nprof, 0) ThenBlock: {
            sk_nprof = CA_RebuildProfiles()
        }
        CadApp.nprof = sk_nprof
        IfCondition EqualTo(sk_nprof, 0) ThenBlock: {
            CA_Log("cad_app: revolve FAIL - no closed profile\n", 42)
            CA_Log("  draw profile; axis = Y-axis or a vertical line; Profiles then Rev\n", 68)
            ReturnValue(-2)
        }
        IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
            CA_Log("cad_app: revolve FAIL - pick a profile first\n", 45)
            ReturnValue(-3)
        }
        IfCondition EqualTo(CadApp.prof_mask, 0) ThenBlock: {
            CA_Log("cad_app: revolve FAIL - nothing selected\n", 41)
            ReturnValue(-3)
        }
        IfCondition EqualTo(CadAppRev.ok, 0) ThenBlock: {
            CadApp.tool = 11
            CadApp.mode = 1
            CadApp.nclick = 0
            CA_Log("cad_app: revolve - click a sketch LINE for the axis\n", 52)
            CA_Log("  any profile edge or construction line; then it lathes\n", 56)
            ReturnValue(-4)
        }
        // largest selected = revolve profile (true verts, not AABB)
        xy = Allocate(65536)
        oxy = Allocate(65536)
        outer_i = -1
        outer_a = 0
        outer_nn = 0
        pi = 0
        WhileLoop LessThan(pi, sk_nprof) {
            IfCondition LessThan(pi, 32) ThenBlock: {
                bit = LeftShift(1, pi)
                IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: {
                    nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                    IfCondition GreaterEqual(nn, 3) ThenBlock: {
                        ar = CAD_Sketch.LoopSignedArea(xy, nn)
                        IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                        better = 0
                        IfCondition EqualTo(outer_i, -1) ThenBlock: { better = 1 }
                        IfCondition EqualTo(Float_Le(outer_a, ar), 1) ThenBlock: {
                            IfCondition NotEqual(pi, outer_i) ThenBlock: { better = 1 }
                        }
                        IfCondition EqualTo(better, 1) ThenBlock: {
                            outer_i = pi
                            outer_a = ar
                            outer_nn = nn
                            k = 0
                            WhileLoop LessThan(k, nn) {
                                ArraySet(oxy, Multiply(k, 2), ArrayGet(xy, Multiply(k, 2)))
                                ArraySet(oxy, Add(Multiply(k, 2), 1), ArrayGet(xy, Add(Multiply(k, 2), 1)))
                                k = Add(k, 1)
                            }
                        }
                    }
                }
            }
            pi = Add(pi, 1)
        }
        IfCondition LessThan(outer_i, 0) ThenBlock: {
            Deallocate(xy, 65536)
            Deallocate(oxy, 65536)
            CA_Log("cad_app: revolve FAIL - nothing selected\n", 41)
            ReturnValue(-2)
        }
        onn = outer_nn
        oaddr = oxy
        PrintMessage("cad_app: revolve prof=")
        PrintNumber(outer_i)
        PrintMessage(" nn=")
        PrintNumber(onn)
        PrintMessage("\n")
        // picked axis → unit dir u, left normal n
        ax0 = CadAppRev.x0
        ay0 = CadAppRev.y0
        adx = Float_Sub(CadAppRev.x1, ax0)
        ady = Float_Sub(CadAppRev.y1, ay0)
        aln = CAD_Num.Sqrt(Float_Add(Float_Mul(adx, adx), Float_Mul(ady, ady)))
        IfCondition EqualTo(CAD_Num.IsZero(aln, 0), 1) ThenBlock: {
            Deallocate(xy, 65536)
            Deallocate(oxy, 65536)
            CadAppRev.ok = 0
            CA_Log("cad_app: revolve FAIL - zero-length axis\n", 41)
            ReturnValue(-3)
        }
        ux = Float_Div(adx, aln)
        uy = Float_Div(ady, aln)
        nx = Float_Sub(0, uy)
        ny = ux
        CA_LogInt("cad_app: revolve axis x0=", 25, Float_ToInt(ax0))
        CA_LogInt("cad_app: revolve axis y0=", 25, Float_ToInt(ay0))
        CA_LogInt("cad_app: revolve axis x1=", 25, Float_ToInt(CadAppRev.x1))
        CA_LogInt("cad_app: revolve axis y1=", 25, Float_ToInt(CadAppRev.y1))
        // signed side vs axis; all verts one side (on-axis OK)
        nL = 0
        nR = 0
        k = 0
        WhileLoop LessThan(k, onn) {
            vx = Float_Sub(ArrayGet(oaddr, Multiply(k, 2)), ax0)
            vy = Float_Sub(ArrayGet(oaddr, Add(Multiply(k, 2), 1)), ay0)
            side = Float_Add(Float_Mul(vx, nx), Float_Mul(vy, ny))
            IfCondition EqualTo(CAD_Num.IsZero(side, 0), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsNeg(side), 1) ThenBlock: { nL = Add(nL, 1) }
                IfCondition EqualTo(CAD_Num.IsNeg(side), 0) ThenBlock: { nR = Add(nR, 1) }
            }
            k = Add(k, 1)
        }
        IfCondition GreaterThan(nL, 0) ThenBlock: {
            IfCondition GreaterThan(nR, 0) ThenBlock: {
                Deallocate(xy, 65536)
                Deallocate(oxy, 65536)
                CA_Log("cad_app: revolve FAIL - profile crosses axis\n", 45)
                CA_Log("  pick a different line; profile must stay on one side\n", 55)
                ReturnValue(-3)
            }
        }
        flip = 0
        IfCondition GreaterThan(nL, 0) ThenBlock: { flip = 1 }
        // n must point at the profile so θ=0 is the generating sketch section
        IfCondition EqualTo(flip, 1) ThenBlock: {
            nx = Float_Sub(0, nx)
            ny = Float_Sub(0, ny)
        }
        rz = Allocate(16384)
        k = 0
        nout = 0
        rmin = 0
        rmax = 0
        first = 1
        WhileLoop LessThan(k, onn) {
            px = ArrayGet(oaddr, Multiply(k, 2))
            py = ArrayGet(oaddr, Add(Multiply(k, 2), 1))
            vx = Float_Sub(px, ax0)
            vy = Float_Sub(py, ay0)
            along = Float_Add(Float_Mul(vx, ux), Float_Mul(vy, uy))
            side = Float_Add(Float_Mul(vx, nx), Float_Mul(vy, ny))
            IfCondition EqualTo(CAD_Num.IsNeg(side), 1) ThenBlock: { side = 0 }
            keep = 1
            IfCondition GreaterThan(nout, 0) ThenBlock: {
                pr = ArrayGet(rz, Multiply(Subtract(nout, 1), 2))
                pz = ArrayGet(rz, Add(Multiply(Subtract(nout, 1), 2), 1))
                IfCondition EqualTo(CAD_Num.IsEqual(side, pr, 0), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(along, pz, 0), 1) ThenBlock: { keep = 0 }
                }
            }
            IfCondition EqualTo(keep, 1) ThenBlock: {
                ArraySet(rz, Multiply(nout, 2), side)
                ArraySet(rz, Add(Multiply(nout, 2), 1), along)
                nout = Add(nout, 1)
                IfCondition EqualTo(first, 1) ThenBlock: {
                    rmin = side
                    rmax = side
                    first = 0
                }
                IfCondition EqualTo(Float_Le(side, rmin), 1) ThenBlock: { rmin = side }
                IfCondition EqualTo(Float_Le(rmax, side), 1) ThenBlock: { rmax = side }
            }
            k = Add(k, 1)
        }
        IfCondition LessThan(nout, 3) ThenBlock: {
            Deallocate(xy, 65536)
            Deallocate(oxy, 65536)
            Deallocate(rz, 16384)
            CA_Log("cad_app: revolve FAIL - degenerate RZ section\n", 46)
            ReturnValue(-3)
        }
        IfCondition EqualTo(CAD_Num.IsZero(rmax, 0), 1) ThenBlock: {
            Deallocate(xy, 65536)
            Deallocate(oxy, 65536)
            Deallocate(rz, 16384)
            CA_Log("cad_app: revolve FAIL - zero radius (profile on axis)\n", 54)
            CA_Log("  offset profile from axis, or draw vertical axis line\n", 55)
            ReturnValue(-3)
        }
        CA_LogInt("cad_app: revolve lathe n=", 25, nout)
        CA_LogInt("cad_app: revolve rmin=", 22, Float_ToInt(rmin))
        CA_LogInt("cad_app: revolve rmax=", 22, Float_ToInt(rmax))
        outh = Allocate(16)
        CAD_Topo_Lathe.ox = ax0
        CAD_Topo_Lathe.oy = ay0
        CAD_Topo_Lathe.oz = 0
        CAD_Topo_Lathe.ux = ux
        CAD_Topo_Lathe.uy = uy
        CAD_Topo_Lathe.uz = 0
        CAD_Topo_Lathe.nx = nx
        CAD_Topo_Lathe.ny = ny
        CAD_Topo_Lathe.nz = 0
        IfCondition LessThan(CadApp.rev_deg, 1) ThenBlock: { CadApp.rev_deg = 360 }
        IfCondition GreaterThan(CadApp.rev_deg, 360) ThenBlock: { CadApp.rev_deg = 360 }
        CAD_Topo_Lathe.sweep = CadApp.rev_deg
        h = CAD_Topo.MakeLatheRevolution(rz, nout, outh)
        Deallocate(outh, 16)
        Deallocate(xy, 65536)
        Deallocate(oxy, 65536)
        Deallocate(rz, 16384)
        IfCondition EqualTo(h, 0) ThenBlock: {
            CA_Log("cad_app: revolve FAIL (kernel lathe)\n", 37)
            ReturnValue(-2)
        }
        CAD_View.InvalidateMesh()
        CadApp.solid = h
        CadApp.dirty = 1
        CadApp.mode = 0
        CadApp.tool = 0
        CadApp.wire = 0
        CAD_View.SetWire(0)
        CA_LogInt("cad_app: revolve sketch=", 24, CadApp.sketch)
        CA_LogInt("cad_app: revolve nout=", 22, nout)
        IfCondition EqualTo(CadApp.rev_edit, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                IfCondition GreaterEqual(CadApp.feat_sel, 0) ThenBlock: {
                    ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.rev_deg)
                }
            }
            CadApp.last_revf = CadApp.feat_sel
        }
        IfCondition EqualTo(CadApp.rev_edit, 0) ThenBlock: {
            CA_FeatAdd(2, CA_CurrentSkIdx())
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.rev_deg)
            }
            CadApp.last_revf = CadApp.feat_sel
            CA_HudOpenRev()
        }
        CA_Log("cad_app: revolve OK (profile lathe)\n", 36)
        ReturnValue(0)
    }
}

// ExtrudeCut current/hole sketch into existing solid (through height).


// ExtrudeCut current/hole sketch into existing solid (through height).
Function.CA_CutFromSketch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_Log("cad_app: cut needs a solid (extrude first)\n", 43)
            ReturnValue(-1)
        }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: cut needs a sketch\n", 28)
            ReturnValue(-1)
        }
        CadApp.extrude_op = 1
        IfCondition LessThan(CadApp.height, 0) ThenBlock: {
            CadApp.height = Subtract(0, CadApp.height)
        }
        IfCondition LessThan(CadApp.height, 1) ThenBlock: { CadApp.height = 10 }
        CA_HudOpenPad()
        CA_Log("cad_app: cut - type depth, Enter (Tab JOIN/CUT/NEW)\n", 52)
        ReturnValue(0)
    }
}


Function.CA_ImportDxf {
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(0) }
        out = Allocate(16)
        rc = CAD_DXF.ImportFile(path, out)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            Deallocate(out, 16)
            CA_Log("cad_app: DXF import FAIL\n", 25)
            ReturnValue(0)
        }
        h = ArrayGet(out, 0)
        Deallocate(out, 16)
        ReturnValue(h)
    }
}


Function.CA_LoadDxfToSketch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.dxf_path, 0) ThenBlock: { ReturnValue(-1) }
        // drop previous solid so viewport does not keep last pad while loading
        CadApp.solid = 0
        CadApp.sketch = CA_ImportDxf(CadApp.dxf_path)
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        CadApp.hole_sk = 0
        IfCondition NotEqual(CadApp.hole_path, 0) ThenBlock: {
            CadApp.hole_sk = CA_ImportDxf(CadApp.hole_path)
            IfCondition EqualTo(CadApp.hole_sk, 0) ThenBlock: {
                CA_Log("cad_app: hole DXF FAIL\n", 23)
                ReturnValue(-1)
            }
        }
        // file import: auto pad outer (+ holes) — not interactive selection
        CadApp.auto_pad = 1
        CadApp.prof_user = 0
        rc = CA_BuildSolid()
        CadApp.auto_pad = 0
        ReturnValue(rc)
    }
}


Function.CA_ReloadDxf {
    Output: Integer
    Body: {
        CA_Log("cad_app: reload DXF\n", 20)
        ReturnValue(CA_LoadDxfToSketch())
    }
}

// Import DXF from /tmp/cad_app/path.txt (file dialog / agent sets path).


// Import DXF from /tmp/cad_app/path.txt (file dialog / agent sets path).
Function.CA_ImportFromPathFile {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.path_buf, 0) ThenBlock: {
            CadApp.path_buf = Allocate(512)
        }
        fd = SystemCall(2, "/tmp/cad_app/path.txt", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            CA_Log("cad_app: import needs path.txt\n", 31)
            ReturnValue(-1)
        }
        n = SystemCall(0, fd, CadApp.path_buf, 511)
        SystemCall(3, fd, 0, 0)
        IfCondition LessThan(n, 1) ThenBlock: {
            CA_Log("cad_app: path.txt empty\n", 24)
            ReturnValue(-1)
        }
        // strip trailing CR/LF/space
        done = 0
        WhileLoop EqualTo(done, 0) {
            IfCondition LessEqual(n, 0) ThenBlock: { done = 1 }
            IfCondition EqualTo(done, 0) ThenBlock: {
                c = GetByte(CadApp.path_buf, Subtract(n, 1))
                IfCondition EqualTo(c, 10) ThenBlock: { n = Subtract(n, 1) }
                IfCondition EqualTo(c, 13) ThenBlock: { n = Subtract(n, 1) }
                IfCondition EqualTo(c, 32) ThenBlock: { n = Subtract(n, 1) }
                IfCondition NotEqual(c, 10) ThenBlock: {
                    IfCondition NotEqual(c, 13) ThenBlock: {
                        IfCondition NotEqual(c, 32) ThenBlock: { done = 1 }
                    }
                }
            }
        }
        IfCondition LessEqual(n, 0) ThenBlock: {
            CA_Log("cad_app: path.txt empty\n", 24)
            ReturnValue(-1)
        }
        SetByte(CadApp.path_buf, n, 0)
        CadApp.dxf_path = CadApp.path_buf
        CA_Log("cad_app: import path\n", 21)
        ReturnValue(CA_LoadDxfToSketch())
    }
}

// HUD channel for presenter (upper-right). Kernel owns numbers.

