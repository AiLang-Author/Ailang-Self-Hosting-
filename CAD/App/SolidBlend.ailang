Function.CA_BlendFeatEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.feat_en, 0) ThenBlock: { CadApp.feat_en = Allocate(256) }
        IfCondition EqualTo(CadApp.feat_ps, 0) ThenBlock: { CadApp.feat_ps = Allocate(256) }
        IfCondition EqualTo(CadApp.feat_hi, 0) ThenBlock: { CadApp.feat_hi = Allocate(256) }
        IfCondition EqualTo(CadApp.feat_eb, 0) ThenBlock: { CadApp.feat_eb = Allocate(65536) }
        IfCondition EqualTo(CadApp.last_bl_buf, 0) ThenBlock: { CadApp.last_bl_buf = Allocate(512) }
        IfCondition EqualTo(CadApp.feat_en, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.feat_eb, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

// Snapshot current edge pick + parent solid before the blend mutates the body.
Function.CA_BlendSnapSel {
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_BlendFeatEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        n = CadApp.sel_nedges
        IfCondition LessThan(n, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.sel_edge_id, 0) ThenBlock: {
                ArraySet(CadApp.last_bl_buf, 0, CadApp.sel_edge_id)
                n = 1
            }
        }
        IfCondition GreaterThan(n, 64) ThenBlock: { n = 64 }
        CadApp.last_bl_n = n
        CadApp.last_bl_parent = CadApp.bl_parent
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition GreaterThan(CadApp.sel_nedges, 0) ThenBlock: {
                ArraySet(CadApp.last_bl_buf, i, ArrayGet(CadApp.sel_edge_buf, i))
            }
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

// Bind last snapshot onto feat_sel (call after FeatAdd or on edit update).
Function.CA_BlendBindFeat {
    Input: kind: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_BlendFeatEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        fi = CadApp.feat_sel
        IfCondition LessThan(fi, 0) ThenBlock: { ReturnValue(-1) }
        n = CadApp.last_bl_n
        ArraySet(CadApp.feat_en, fi, n)
        ArraySet(CadApp.feat_ps, fi, CadApp.last_bl_parent)
        ArraySet(CadApp.feat_hi, fi, CadApp.hist_cur)
        b = Multiply(fi, 64)
        i = 0
        WhileLoop LessThan(i, n) {
            ArraySet(CadApp.feat_eb, Add(b, i), ArrayGet(CadApp.last_bl_buf, i))
            i = Add(i, 1)
        }
        CadApp.last_bl_feat = fi
        CadApp.last_bl_kind = kind
        ReturnValue(n)
    }
}

// Put stored edges back in the pick set and roll the body to the pre-blend solid.
Function.CA_BlendLoadFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_BlendFeatEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        CA_EnsureEdgeSelBuf()
        n = 0
        ps = 0
        IfCondition GreaterEqual(feat_i, 0) ThenBlock: {
            n = ArrayGet(CadApp.feat_en, feat_i)
            ps = ArrayGet(CadApp.feat_ps, feat_i)
        }
        IfCondition LessThan(n, 1) ThenBlock: {
            IfCondition EqualTo(CadApp.last_bl_feat, feat_i) ThenBlock: {
                n = CadApp.last_bl_n
                ps = CadApp.last_bl_parent
            }
        }
        IfCondition LessThan(n, 1) ThenBlock: {
            IfCondition GreaterThan(CadApp.last_bl_n, 0) ThenBlock: {
                IfCondition EqualTo(CadApp.last_bl_kind, ArrayGet(CadApp.feat_kind, feat_i)) ThenBlock: {
                    n = CadApp.last_bl_n
                    ps = CadApp.last_bl_parent
                }
            }
        }
        IfCondition EqualTo(ps, 0) ThenBlock: {
            IfCondition GreaterEqual(feat_i, 0) ThenBlock: {
                hi = ArrayGet(CadApp.feat_hi, feat_i)
                IfCondition GreaterThan(hi, 0) ThenBlock: {
                    IfCondition LessThan(hi, CadApp.hist_n) ThenBlock: {
                        ps = ArrayGet(CadApp.hist_solid, Subtract(hi, 1))
                    }
                }
            }
        }
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(ps, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Store.IsLive(ps), 0) ThenBlock: {
            CA_Log("cad_app: blend parent not live after load\n", 42)
            ReturnValue(-1)
        }
        i = 0
        WhileLoop LessThan(i, n) {
            eh = 0
            IfCondition GreaterEqual(feat_i, 0) ThenBlock: {
                IfCondition GreaterThan(ArrayGet(CadApp.feat_en, feat_i), 0) ThenBlock: {
                    eh = ArrayGet(CadApp.feat_eb, Add(Multiply(feat_i, 64), i))
                }
            }
            IfCondition EqualTo(eh, 0) ThenBlock: {
                eh = ArrayGet(CadApp.last_bl_buf, i)
            }
            ArraySet(CadApp.sel_edge_buf, i, eh)
            i = Add(i, 1)
        }
        CadApp.sel_nedges = n
        CadApp.sel_edge_id = ArrayGet(CadApp.sel_edge_buf, Subtract(n, 1))
        CadApp.nclick = n
        CadApp.bl_parent = ps
        CadApp.solid = ps
        CAD_View.InvalidateMesh()
        CA_LogInt("cad_app: blend replay nsel=", 26, n)
        ReturnValue(n)
    }
}

// Roll to the solid from before this blend (hist parent). Edges stay empty.
Function.CA_BlendRollbackParent {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        ps = 0
        IfCondition GreaterEqual(feat_i, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.feat_hi, 0) ThenBlock: {
                hi = ArrayGet(CadApp.feat_hi, feat_i)
                IfCondition GreaterThan(hi, 0) ThenBlock: {
                    IfCondition LessThan(hi, CadApp.hist_n) ThenBlock: {
                        ps = ArrayGet(CadApp.hist_solid, Subtract(hi, 1))
                    }
                }
            }
        }
        IfCondition EqualTo(ps, 0) ThenBlock: {
            i = Subtract(CadApp.hist_n, 1)
            WhileLoop GreaterEqual(i, 1) {
                IfCondition EqualTo(ArrayGet(CadApp.hist_kind, i), ArrayGet(CadApp.feat_kind, feat_i)) ThenBlock: {
                    ps = ArrayGet(CadApp.hist_solid, Subtract(i, 1))
                    i = 0
                }
                IfCondition GreaterThan(i, 0) ThenBlock: { i = Subtract(i, 1) }
            }
        }
        IfCondition EqualTo(ps, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Store.IsLive(ps), 0) ThenBlock: { ReturnValue(-1) }
        CadApp.bl_parent = ps
        CadApp.solid = ps
        CAD_View.InvalidateMesh()
        CA_Log("cad_app: blend rolled back to parent body\n", 41)
        ReturnValue(0)
    }
}

Function.CA_BlendUpdateHist {
    Output: Integer
    Body: {
        fi = CadApp.feat_sel
        IfCondition LessThan(fi, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.feat_hi, 0) ThenBlock: { ReturnValue(0) }
        hi = ArrayGet(CadApp.feat_hi, fi)
        IfCondition LessThan(hi, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(hi, CadApp.hist_n) ThenBlock: { ReturnValue(0) }
        ArraySet(CadApp.hist_solid, hi, CadApp.solid)
        CadApp.hist_cur = hi
        CA_WriteHist()
        ReturnValue(1)
    }
}

// Ensure sel_edge_buf exists (64 handles).
Function.CA_EnsureEdgeSelBuf {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sel_edge_buf, 0) ThenBlock: {
            CadApp.sel_edge_buf = Allocate(2048)
            CadApp.sel_nedges = 0
        }
        ReturnValue(CadApp.sel_edge_buf)
    }
}

Function.CA_ClearEdgeSel {
    Output: Integer
    Body: {
        n = CadApp.sel_nedges
        IfCondition GreaterThan(n, 64) ThenBlock: { n = 64 }
        IfCondition NotEqual(CadApp.sel_edge_buf, 0) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, n) {
                ArraySet(CadApp.sel_edge_buf, i, 0)
                i = Add(i, 1)
            }
        }
        CadApp.sel_edge_id = 0
        CadApp.sel_nedges = 0
        CadApp.sel_nfaces = 0
        CadApp.nclick = 0
        CadApp.last_bl_n = 0
        ReturnValue(0)
    }
}

Function.CA_EnsureFaceSelBuf {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sel_face_buf, 0) ThenBlock: {
            CadApp.sel_face_buf = Allocate(128)
            CadApp.sel_nfaces = 0
        }
        ReturnValue(CadApp.sel_face_buf)
    }
}

Function.CA_AddFaceSel {
    Input: face_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(CadApp.sel_nfaces) }
        CA_EnsureFaceSelBuf()
        buf = CadApp.sel_face_buf
        n = CadApp.sel_nfaces
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(ArrayGet(buf, i), face_h) ThenBlock: {
                k = i
                WhileLoop LessThan(k, Subtract(n, 1)) {
                    ArraySet(buf, k, ArrayGet(buf, Add(k, 1)))
                    k = Add(k, 1)
                }
                n = Subtract(n, 1)
                CadApp.sel_nfaces = n
                ReturnValue(n)
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(n, 64) ThenBlock: {
            ArraySet(buf, n, face_h)
            n = Add(n, 1)
            CadApp.sel_nfaces = n
        }
        ReturnValue(n)
    }
}

// Toggle/add edge into multi-sel (max 64). Returns new count.
Function.CA_AddEdgeSel {
    Input: edge_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(CadApp.sel_nedges) }
        CA_EnsureEdgeSelBuf()
        buf = CadApp.sel_edge_buf
        n = CadApp.sel_nedges
        // toggle off if already selected
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(ArrayGet(buf, i), edge_h) ThenBlock: {
                k = i
                WhileLoop LessThan(k, Subtract(n, 1)) {
                    ArraySet(buf, k, ArrayGet(buf, Add(k, 1)))
                    k = Add(k, 1)
                }
                n = Subtract(n, 1)
                CadApp.sel_nedges = n
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    CadApp.sel_edge_id = ArrayGet(buf, Subtract(n, 1))
                }
                IfCondition EqualTo(n, 0) ThenBlock: { CadApp.sel_edge_id = 0 }
                ReturnValue(n)
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(n, 256) ThenBlock: {
            ArraySet(buf, n, edge_h)
            n = Add(n, 1)
            CadApp.sel_nedges = n
            CadApp.sel_edge_id = edge_h
        }
        ReturnValue(n)
    }
}

Function.CA_DrawOneEdgeHL {
    Input: ed: Integer
    Input: fr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(ed, 0) ThenBlock: { ReturnValue(0) }
        ns = CA_SampleEdge(ed, 48)
        IfCondition LessThan(ns, 2) ThenBlock: { ReturnValue(0) }
        col = FB_RGB(0, 255, 240)
        col2 = FB_RGB(255, 240, 40)
        samp = CAD_Tess_State.samp
        a = Allocate(32)
        b = Allocate(32)
        si = 0
        WhileLoop LessThan(si, Subtract(ns, 1)) {
            CA_World3ToPix(ArrayGet(samp, Multiply(si, 3)), ArrayGet(samp, Add(Multiply(si, 3), 1)), ArrayGet(samp, Add(Multiply(si, 3), 2)), fr, a)
            CA_World3ToPix(ArrayGet(samp, Multiply(Add(si, 1), 3)), ArrayGet(samp, Add(Multiply(Add(si, 1), 3), 1)), ArrayGet(samp, Add(Multiply(Add(si, 1), 3), 2)), fr, b)
            FB_Line(ArrayGet(a, 0), ArrayGet(a, 1), ArrayGet(b, 0), ArrayGet(b, 1), col)
            FB_Line(Add(ArrayGet(a, 0), 1), ArrayGet(a, 1), Add(ArrayGet(b, 0), 1), ArrayGet(b, 1), col2)
            si = Add(si, 1)
        }
        CA_World3ToPix(ArrayGet(samp, 0), ArrayGet(samp, 1), ArrayGet(samp, 2), fr, a)
        CA_World3ToPix(ArrayGet(samp, Multiply(Subtract(ns, 1), 3)), ArrayGet(samp, Add(Multiply(Subtract(ns, 1), 3), 1)), ArrayGet(samp, Add(Multiply(Subtract(ns, 1), 3), 2)), fr, b)
        FB_FillRect(Subtract(ArrayGet(a, 0), 3), Subtract(ArrayGet(a, 1), 3), 7, 7, col2)
        FB_FillRect(Subtract(ArrayGet(b, 0), 3), Subtract(ArrayGet(b, 1), 3), 7, 7, col2)
        Deallocate(a, 32)
        Deallocate(b, 32)
        ReturnValue(1)
    }
}

// Draw all selected solid edges (cyan/yellow overlay after shade).
Function.CA_DrawSelectedEdgeHighlight {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(0) }
        n = CadApp.sel_nedges
        IfCondition EqualTo(n, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.sel_edge_id, 0) ThenBlock: { ReturnValue(0) }
        }
        fr = Allocate(64)
        CA_BuildViewFrame(fr)
        IfCondition GreaterThan(n, 0) ThenBlock: {
            buf = CadApp.sel_edge_buf
            i = 0
            WhileLoop LessThan(i, n) {
                CA_DrawOneEdgeHL(ArrayGet(buf, i), fr)
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(n, 0) ThenBlock: {
            CA_DrawOneEdgeHL(CadApp.sel_edge_id, fr)
        }
        Deallocate(fr, 64)
        ReturnValue(1)
    }
}

Function.CA_DrawSelectedFaceHighlight {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(0) }
        n = CadApp.sel_nfaces
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.sel_face_buf, 0) ThenBlock: { ReturnValue(0) }
        col = FB_RGB(255, 160, 40)
        i = 0
        WhileLoop LessThan(i, n) {
            fh = ArrayGet(CadApp.sel_face_buf, i)
            IfCondition NotEqual(fh, 0) ThenBlock: {
                CA_DrawFaceOutline3D(fh, col, 3)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Edge length in world units (0 if bad handle).
Function.CA_SolidEdgeLen {
    Input: edge_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        v0 = CAD_Store.Read(edge_h, 0)
        v1 = CAD_Store.Read(edge_h, 1)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v0, v1) ThenBlock: {
            crv = CAD_Store.Read(edge_h, 2)
            IfCondition NotEqual(crv, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(crv, 0), 2) ThenBlock: {
                    two_pi = 0x401921FB54442D18
                    ReturnValue(Float_Mul(two_pi, CAD_Store.Read(crv, 10)))
                }
            }
        }
        dx = Float_Sub(CAD_Store.Read(v1, 0), CAD_Store.Read(v0, 0))
        dy = Float_Sub(CAD_Store.Read(v1, 1), CAD_Store.Read(v0, 1))
        dz = Float_Sub(CAD_Store.Read(v1, 2), CAD_Store.Read(v0, 2))
        ReturnValue(CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz))))
    }
}

// If 2+ edges selected, add every remaining LINE edge on any incident face.
// Lets Digon rebuild a whole face cycle instead of sequential single fillets.
Function.CA_ExpandEdgeSelFaces {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.sel_nedges, 2) ThenBlock: { ReturnValue(CadApp.sel_nedges) }
        IfCondition EqualTo(CadApp.sel_edge_buf, 0) ThenBlock: { ReturnValue(0) }
        CA_EnsureEdgeSelBuf()
        buf = CadApp.sel_edge_buf
        n0 = CadApp.sel_nedges
        faces = Allocate(32)
        i = 0
        WhileLoop LessThan(i, n0) {
            ed = ArrayGet(buf, i)
            IfCondition NotEqual(ed, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(ed, faces), 0) ThenBlock: {
                    fi = 0
                    WhileLoop LessThan(fi, 2) {
                        fh = ArrayGet(faces, fi)
                        IfCondition NotEqual(fh, 0) ThenBlock: {
                            lp = CAD_Store.Read(fh, 1)
                            IfCondition NotEqual(lp, 0) ThenBlock: {
                                hd = CAD_Store.Read(lp, 0)
                                ce = hd
                                cg = 0
                                dn = 0
                                WhileLoop EqualTo(dn, 0) {
                                    fe = CAD_Store.Read(ce, 0)
                                    // skip already-blend curves (circle/cyl)
                                    crv = 0
                                    IfCondition NotEqual(fe, 0) ThenBlock: {
                                        crv = CAD_Store.Read(fe, 2)
                                    }
                                    ok = 1
                                    IfCondition NotEqual(crv, 0) ThenBlock: {
                                        ck = CAD_Store.Read(crv, 0)
                                        // 2=circle — already a fillet arc
                                        IfCondition EqualTo(ck, 2) ThenBlock: { ok = 0 }
                                    }
                                    IfCondition EqualTo(ok, 1) ThenBlock: {
                                        CA_AddEdgeSel(fe)
                                    }
                                    ce = CAD_Store.Read(ce, 2)
                                    cg = Add(cg, 1)
                                    IfCondition EqualTo(ce, hd) ThenBlock: { dn = 1 }
                                    IfCondition GreaterThan(cg, 64) ThenBlock: { dn = 1 }
                                }
                            }
                        }
                        fi = Add(fi, 1)
                    }
                }
            }
            i = Add(i, 1)
        }
        Deallocate(faces, 32)
        PrintMessage("cad_app: fillet expand n=")
        PrintNumber(CadApp.sel_nedges)
        PrintMessage("\n")
        ReturnValue(CadApp.sel_nedges)
    }
}

// Clamp fillet R: default 2mm; never more than 40% of edge / min AABB extent.
// out_addr[0] = r_val (float bits). Returns r_val.
Function.CA_FilletClampR {
    Input: radius_mm: Integer
    Input: edge_h: Integer
    Input: out_addr: Address
    Output: Integer
    Body: {
        rmm = radius_mm
        IfCondition LessEqual(rmm, 0) ThenBlock: { rmm = 2 }
        r_val = Float_FromInt(rmm)
        cap = 0
        IfCondition NotEqual(edge_h, 0) ThenBlock: {
            el = CA_SolidEdgeLen(edge_h)
            // 0.4 * edge
            cap = Float_Mul(el, 0x3FD999999999999A)
        }
        IfCondition EqualTo(CAD_Num.IsZero(cap, 0), 1) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                mn = Allocate(32)
                mx = Allocate(32)
                IfCondition EqualTo(CAD_Topo.SolidBounds(CadApp.solid, mn, mx), 1) ThenBlock: {
                    dx = Float_Sub(ArrayGet(mx, 0), ArrayGet(mn, 0))
                    dy = Float_Sub(ArrayGet(mx, 1), ArrayGet(mn, 1))
                    dz = Float_Sub(ArrayGet(mx, 2), ArrayGet(mn, 2))
                    m = dx
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(dy, m)), 1) ThenBlock: { m = dy }
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(dz, m)), 1) ThenBlock: { m = dz }
                    cap = Float_Mul(m, 0x3FD999999999999A)
                }
                Deallocate(mn, 32)
                Deallocate(mx, 32)
            }
        }
        IfCondition EqualTo(CAD_Num.IsZero(cap, 0), 0) ThenBlock: {
            // if r_val > cap → use cap (IsNeg(cap - r) == 1)
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(cap, r_val)), 1) ThenBlock: {
                r_val = cap
            }
        }
        // never below 0.5 mm
        rmin = 0x3FE0000000000000
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(r_val, rmin)), 1) ThenBlock: {
            r_val = rmin
        }
        ArraySet(out_addr, 0, r_val)
        ReturnValue(r_val)
    }
}

// Fillet selected edge if CadApp.sel_edge_id set; else all edges (legacy).
// radius_mm is integer mm. 0 → 2mm, then clamp to 0.4*edge (box H/2 fail).
// Always stay in 3D (mode=0); never switch to sketch/pick.
Function.CA_FilletSolid {
    Input: radius_mm: Integer
    Output: Integer
    Body: {
        CadApp.mode = 0
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_NotifyReason(8)
            ReturnValue(-1)
        }
        CadApp.bl_parent = CadApp.solid
        IfCondition EqualTo(CadApp.fillet_edit, 1) ThenBlock: {
            IfCondition EqualTo(CA_BlendLoadFeat(CadApp.feat_sel), -1) ThenBlock: {
                CA_BlendRollbackParent(CadApp.feat_sel)
                CA_Log("cad_app: fillet edit - click the original edges, Enter\n", 55)
                ReturnValue(-1)
            }
        }
        ns0 = CadApp.sel_nedges
        IfCondition LessThan(ns0, 1) ThenBlock: {
            IfCondition EqualTo(CadApp.sel_edge_id, 0) ThenBlock: {
                CadApp.tool = 8
                CA_HudOpenFillet3d()
                CA_NotifyReason(9)
                ReturnValue(-1)
            }
        }
        CA_BlendSnapSel()
        rp = Allocate(16)
        eh = CadApp.sel_edge_id
        r_val = CA_FilletClampR(radius_mm, eh, rp)
        r_val = ArrayGet(rp, 0)
        Deallocate(rp, 16)
        PrintMessage("cad_app: solid fillet Rmm_in=")
        PrintNumber(radius_mm)
        PrintMessage(" R_int=")
        PrintNumber(Float_ToInt(r_val))
        PrintMessage(" nsel=")
        PrintNumber(CadApp.sel_nedges)
        PrintMessage("\n")
        CA_LogInt("cad_app: fillet apply nsel=", 26, ns0)
        CA_LogInt("cad_app: fillet apply R=", 24, radius_mm)
        CAD_Topo_State.fillet_concave = 0
        CAD_Topo_State.fillet_host_f = 0
        CAD_Topo_State.fillet_nin = 0
        // Cove vs fillet from the two support planes: count how many of
        // the four ±N1±N2 probes sit in the solid (3=cove void≤180°,
        // 1=fillet void>180°). Cycle edges share the same dihedral.
        IfCondition GreaterThan(CadApp.sel_nedges, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.EdgeIsCove(CadApp.solid, ArrayGet(CadApp.sel_edge_buf, 0)), 1) ThenBlock: {
                CAD_Topo_State.fillet_concave = 1
            }
            IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.SelHasNonPlaneWall(CadApp.sel_edge_buf, CadApp.sel_nedges), 1) ThenBlock: {
                    CAD_Topo_State.fillet_concave = 0
                    CA_LogS("cad_app: fillet mixed rim not cove\n")
                }
            }
        }
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: {
            CA_LogS("cad_app: fillet COVE void<=180\n")
        }
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 0) ThenBlock: {
            CA_LogS("cad_app: fillet FILLET void>180\n")
        }
        CA_LogInt("cad_app: fillet cove nin=", 26, CAD_Topo_State.fillet_nin)
        fil = 0
        ns = CadApp.sel_nedges
        // Fillet EXACTLY the picked edges. Expand-to-incident-faces added
        // verticals when the user clicked a top rim (select.png → result.png).
        snap = Allocate(2048)
        si = 0
        WhileLoop LessThan(si, ns) {
            ArraySet(snap, si, ArrayGet(CadApp.sel_edge_buf, si))
            si = Add(si, 1)
        }
        IfCondition GreaterThan(ns, 0) ThenBlock: {
            PrintMessage("cad_app: solid fillet n=")
            PrintNumber(ns)
            PrintMessage("\n")
            CA_LogInt("cad_app: fillet path=edges n=", 29, ns)
            fil = CAD_Blend.FilletEdges(CadApp.solid, snap, ns, r_val)
            CA_LogInt("cad_app: fillet class=", 24, CAD_Topo_State.fillet_class)
            CA_LogS("cad_app: fillet math /tmp/cad_app/fillet_math.log\n")
            IfCondition EqualTo(fil, 0) ThenBlock: {
                CA_Log("cad_app: 3D fillet FAIL\n", 24)
                CA_LogInt("cad_app: fillet reason=", 24, CAD_Topo_State.fillet_reason)
                IfCondition NotEqual(CAD_Topo_State.fillet_reason, 0) ThenBlock: {
                    CA_NotifyReason(CAD_Topo_State.fillet_reason)
                }
                IfCondition EqualTo(CAD_Topo_State.fillet_reason, 0) ThenBlock: {
                    CA_NotifyS("fillet: FAIL\n")
                }
            }
            CA_ClearEdgeSel()
            CadApp.hud_field = 0
            CA_LogS("cad_app: fillet pick cleared\n")
        }
        Deallocate(snap, 2048)
        IfCondition EqualTo(fil, 0) ThenBlock: {
            IfCondition LessThan(ns, 1) ThenBlock: {
                CadApp.mode = 0
                CadApp.tool = 8
                CA_NotifyReason(9)
                ReturnValue(-1)
            }
        }
        CadApp.mode = 0
        CadApp.tool = 8
        IfCondition EqualTo(fil, 0) ThenBlock: {
            IfCondition NotEqual(CAD_Topo_State.fillet_reason, 0) ThenBlock: {
                CA_NotifyReason(CAD_Topo_State.fillet_reason)
            }
            IfCondition EqualTo(CAD_Topo_State.fillet_reason, 0) ThenBlock: {
                CA_NotifyReason(7)
            }
            ReturnValue(-1)
        }
        CAD_View.InvalidateMesh()
        CadApp.solid = fil
        CadApp.dirty = 1
        CadApp.wire = 0
        CAD_View.SetWire(0)
        IfCondition EqualTo(CadApp.fillet_edit, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                ArraySet(CadApp.feat_aux, CadApp.feat_sel, Float_ToInt(r_val))
            }
            CA_BlendBindFeat(4)
            CA_BlendUpdateHist()
            CA_ClearEdgeSel()
            CadApp.fillet_edit = 0
            CA_LogS("cad_app: 3D solid fillet EDIT OK\n")
            CA_NotifyClear()
            ReturnValue(0)
        }
        CA_FeatAdd(4, CadApp.edge_sk)
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ArraySet(CadApp.feat_aux, CadApp.feat_sel, Float_ToInt(r_val))
        }
        CA_BlendBindFeat(4)
        CA_ClearEdgeSel()
        CA_LogInt("cad_app: fillet shells=", 22, CAD_Topo.SolidCountShells(fil))
        CA_LogInt("cad_app: fillet faces=", 21, CAD_Topo.SolidCountFaces(fil))
        CA_LogS("cad_app: 3D solid fillet OK\n")
        CA_NotifyClear()
        ReturnValue(0)
    }
}

// Chamfer picked edges. 2+ same-Z → prism cap (meeting-cut corners).
// Verticals → ChamferEdges. Single → ChamferEdge. Stay in 3D.
Function.CA_ChamferSolid {
    Input: dist_mm: Integer
    Output: Integer
    Body: {
        CadApp.mode = 0
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_NotifyS("chamfer: needs an active 3D solid\n")
            ReturnValue(-1)
        }
        CadApp.bl_parent = CadApp.solid
        IfCondition EqualTo(CadApp.chamfer_edit, 1) ThenBlock: {
            IfCondition EqualTo(CA_BlendLoadFeat(CadApp.feat_sel), -1) ThenBlock: {
                CA_BlendRollbackParent(CadApp.feat_sel)
                CA_Log("cad_app: chamfer edit - click the original edges, Enter\n", 56)
                ReturnValue(-1)
            }
        }
        ns0 = CadApp.sel_nedges
        IfCondition LessThan(ns0, 1) ThenBlock: {
            IfCondition EqualTo(CadApp.sel_edge_id, 0) ThenBlock: {
                CadApp.tool = 10
                CA_NotifyS("chamfer: pick edges first\n")
                ReturnValue(-1)
            }
        }
        CA_BlendSnapSel()
        dmm = dist_mm
        IfCondition LessEqual(dmm, 0) ThenBlock: { dmm = 2 }
        CadApp.chamfer_d = dmm
        CadApp.pick_best_d = dmm
        d_val = Float_FromInt(dmm)
        ns = CadApp.sel_nedges
        eh = CadApp.sel_edge_id
        ang = CadApp.chamfer_a
        IfCondition LessThan(ang, 1) ThenBlock: { ang = 45 }
        IfCondition GreaterThan(ang, 89) ThenBlock: { ang = 89 }
        CadApp.chamfer_a = ang
        PrintMessage("cad_app: solid chamfer D=")
        PrintNumber(dmm)
        PrintMessage(" A=")
        PrintNumber(ang)
        PrintMessage(" nsel=")
        PrintNumber(ns)
        PrintMessage("\n")
        CA_LogInt("cad_app: chamfer apply nsel=", 27, ns)
        CA_LogInt("cad_app: chamfer apply D=", 25, dmm)
        CA_LogInt("cad_app: chamfer apply A=", 25, ang)
        CAD_Topo_State.fillet_concave = 0
        IfCondition GreaterThan(ns, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.EdgeIsCove(CadApp.solid, ArrayGet(CadApp.sel_edge_buf, 0)), 1) ThenBlock: {
                CAD_Topo_State.fillet_concave = 1
            }
        }
        ch = 0
        buf = CadApp.sel_edge_buf
        IfCondition LessThan(ns, 1) ThenBlock: {
            CA_LogInt("cad_app: chamfer wait nsel=", 26, ns)
            CA_NotifyS("chamfer: pick edges first\n")
            ReturnValue(-1)
        }
        CA_LogInt("cad_app: chamfer path=ir n=", 27, ns)
        CAD_Topo.FilletCompile(CadApp.solid, buf, ns, d_val)
        ch = CAD_Topo.ChamferEmitChain(CadApp.solid, d_val, ang)
        CA_LogInt("cad_app: chamfer reason=", 24, CAD_Topo_State.fillet_reason)
        CadApp.mode = 0
        CadApp.tool = 10
        IfCondition EqualTo(ch, 0) ThenBlock: {
            CA_NotifyS("chamfer FAIL\n")
            ReturnValue(-1)
        }
        CA_ClearEdgeSel()
        CAD_View.InvalidateMesh()
        CadApp.solid = ch
        CadApp.dirty = 1
        CadApp.wire = 0
        CAD_View.SetWire(0)
        skp = CadApp.edge_sk
        IfCondition EqualTo(CadApp.chamfer_edit, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.pick_best_d)
            }
            CA_BlendBindFeat(5)
            CA_BlendUpdateHist()
            CA_ClearEdgeSel()
            CadApp.chamfer_edit = 0
            CA_LogInt("cad_app: chamfer edit D=", 24, CadApp.pick_best_d)
            CA_LogS("cad_app: 3D solid chamfer EDIT OK\n")
            CA_NotifyClear()
            ReturnValue(0)
        }
        CA_FeatAdd(5, skp)
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.pick_best_d)
        }
        CA_BlendBindFeat(5)
        CA_LogInt("cad_app: chamfer tree sk=", 24, skp)
        CA_LogS("cad_app: 3D solid chamfer OK\n")
        CA_NotifyClear()
        ReturnValue(0)
    }
}


// Build solid from current sketch (+ optional hole sketch).
// Paths: plate+hole DXF pair | multi-loop single sketch | single pad.
