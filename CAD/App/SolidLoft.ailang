// Straight loft between two closed sketches.
// The Loft button leaves the flat sketch, shows the isometric view, and
// waits for a click on each profile. Tab chooses NEW or CUT when a body exists.
// A direct call still uses the two newest. CUT subtracts that loft.
// A pure circle section is that sketch circle, split at the other profile's
// corners. Polygon sections stay degree-1 samples of the ruled surface.
// Unequal polygon rings are split onto one arc-length station count.
// Every corner of both stays, up to 60. Equal counts stay corner to corner.
// A pure circle stays on the circle loft. At most 60 stations.
// Rails are a later curve on that surface. They are not built here.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_BSpline
LibraryImport.Cad.CAD_View

// Drop the loft scratch bag and anything it owns. Restores the caller's sketch.
Function.CA_LoftFree {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppPick.quiet, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.hv = CadAppPick.quiet
        CadApp.sketch = ArrayGet(CadAppPick.hv, 0)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 3)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: { Deallocate(CadAppPick.ax, 2048) }
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 4)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: { Deallocate(CadAppPick.ax, 2048) }
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 9)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: { Deallocate(CadAppPick.ax, 32) }
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 10)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: { Deallocate(CadAppPick.ax, 65536) }
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 23)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: {
            CAD_BSpline.FreeRing(CadAppPick.ax)
            Deallocate(CadAppPick.ax, 64)
        }
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 24)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: {
            CAD_BSpline.FreeRing(CadAppPick.ax)
            Deallocate(CadAppPick.ax, 64)
        }
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 29)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: {
            CAD_BSpline.FreeRuled(CadAppPick.ax)
            Deallocate(CadAppPick.ax, 128)
        }
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 30)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: { Deallocate(CadAppPick.ax, 32) }
        CadAppPick.quiet = 0
        Deallocate(CadAppPick.hv, 256)
        ReturnValue(0)
    }
}

Function.CA_LoftFail {
    Input: msg: Address
    Input: n: Integer
    Output: Integer
    Body: {
        CA_Notify(msg, n)
        CA_LoftFree()
        ReturnValue(-1)
    }
}

// 1 when the sketch parked at bag[7] has any line, circle, or arc.
Function.CA_LoftHasGeom {
    Output: Integer
    Body: {
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 7)
        CadAppPick.ax = CAD_Sketch.GetLineCount(CadAppPick.ax)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 7)
        CadAppPick.ay = CAD_Sketch.GetCircleCount(CadAppPick.ay)
        CadAppPick.ax = Add(CadAppPick.ax, CadAppPick.ay)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 7)
        CadAppPick.ay = CAD_Sketch.GetArcCount(CadAppPick.ay)
        CadAppPick.ax = Add(CadAppPick.ax, CadAppPick.ay)
        IfCondition GreaterThan(CadAppPick.ax, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Largest closed profile on CadApp.sketch. Writes bag[11] and returns its point count.
Function.CA_LoftBest {
    Output: Integer
    Body: {
        CadAppPick.hit_i = CA_RebuildProfiles()
        ArraySet(CadAppPick.quiet, 25, CadAppPick.hit_i)
        ArraySet(CadAppPick.quiet, 26, 0)
        ArraySet(CadAppPick.quiet, 11, 0)
        ArraySet(CadAppPick.quiet, 27, 0)
        CadAppPick.pins = 0
        WhileLoop LessThan(CadAppPick.pins, CadAppPick.hit_i) {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 10)
            CadAppPick.hu = CAD_Sketch.GetProfileXY(CadApp.sketch, CadAppPick.pins, CadAppPick.hv)
            IfCondition GreaterEqual(CadAppPick.hu, 3) ThenBlock: {
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 10)
                CadAppPick.hit_a = CAD_Sketch.LoopSignedArea(CadAppPick.hv, CadAppPick.hu)
                CadAppPick.hit_a = CAD_Num.Abs(CadAppPick.hit_a)
                CadAppPick.found_n = ArrayGet(CadAppPick.quiet, 26)
                CadAppPick.clk_x = 0
                IfCondition EqualTo(CadAppPick.found_n, 0) ThenBlock: { CadAppPick.clk_x = 1 }
                IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                    CadAppPick.clk_y = ArrayGet(CadAppPick.quiet, 12)
                    IfCondition EqualTo(Float_Le(CadAppPick.clk_y, CadAppPick.hit_a), 1) ThenBlock: {
                        CadAppPick.clk_x = 1
                    }
                }
                IfCondition EqualTo(CadAppPick.clk_x, 1) ThenBlock: {
                    ArraySet(CadAppPick.quiet, 11, CadAppPick.pins)
                    ArraySet(CadAppPick.quiet, 12, CadAppPick.hit_a)
                    ArraySet(CadAppPick.quiet, 26, 1)
                    ArraySet(CadAppPick.quiet, 27, CadAppPick.hu)
                }
            }
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.hit_i = ArrayGet(CadAppPick.quiet, 25)
        }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 26)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 27)
        ReturnValue(CadAppPick.ax)
    }
}

// Last two sketches that have a closed profile. Writes skA/skB and profA/profB.
Function.CA_LoftPickTwo {
    Output: Integer
    Body: {
        ArraySet(CadAppPick.quiet, 1, 0)
        ArraySet(CadAppPick.quiet, 2, 0)
        ArraySet(CadAppPick.quiet, 16, 0)
        ArraySet(CadAppPick.quiet, 17, 0)
        ArraySet(CadAppPick.quiet, 18, 0)
        ArraySet(CadAppPick.quiet, 8, 0)
        CadAppPick.bx = CadApp.sk_n
        CadAppPick.by = 0
        WhileLoop LessThan(CadAppPick.by, CadAppPick.bx) {
            CadAppPick.ax = ArrayGet(CadApp.sk_list, CadAppPick.by)
            ArraySet(CadAppPick.quiet, 7, CadAppPick.ax)
            CadAppPick.ax = CA_LoftHasGeom()
            IfCondition EqualTo(CadAppPick.ax, 1) ThenBlock: {
                CadApp.sketch = ArrayGet(CadAppPick.quiet, 7)
                CadAppPick.ax = CA_LoftBest()
                IfCondition GreaterEqual(CadAppPick.ax, 3) ThenBlock: {
                    CadAppPick.ax = ArrayGet(CadAppPick.quiet, 2)
                    ArraySet(CadAppPick.quiet, 1, CadAppPick.ax)
                    CadAppPick.ax = ArrayGet(CadAppPick.quiet, 17)
                    ArraySet(CadAppPick.quiet, 16, CadAppPick.ax)
                    CadAppPick.ax = ArrayGet(CadAppPick.quiet, 7)
                    ArraySet(CadAppPick.quiet, 2, CadAppPick.ax)
                    CadAppPick.ax = ArrayGet(CadAppPick.quiet, 11)
                    ArraySet(CadAppPick.quiet, 17, CadAppPick.ax)
                    CadAppPick.by = ArrayGet(CadAppPick.quiet, 8)
                    ArraySet(CadAppPick.quiet, 18, CadAppPick.by)
                }
            }
            CadAppPick.by = ArrayGet(CadAppPick.quiet, 8)
            CadAppPick.by = Add(CadAppPick.by, 1)
            ArraySet(CadAppPick.quiet, 8, CadAppPick.by)
            CadAppPick.bx = CadApp.sk_n
        }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 1)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 2)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Map profile bag[11] of sketch bag[7] through its plane into xyz bag[13].
// Writes the count at bag[5].
Function.CA_LoftMapRing {
    Output: Integer
    Body: {
        CadApp.sketch = ArrayGet(CadAppPick.quiet, 7)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 11)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 10)
        CadAppPick.prof_nn = CAD_Sketch.GetProfileXY(CadApp.sketch, CadAppPick.ax, CadAppPick.ay)
        ArraySet(CadAppPick.quiet, 5, CadAppPick.prof_nn)
        IfCondition GreaterThan(CadAppPick.prof_nn, 60) ThenBlock: {
            CadAppPick.prof_nn = CA_LoftThinRing()
        }
        IfCondition LessThan(CadAppPick.prof_nn, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(CadAppPick.prof_nn, 60) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 7)
        CadAppPick.ax = CAD_Sketch.GetPlaneId(CadAppPick.ax)
        ArraySet(CadAppPick.quiet, 28, CadAppPick.ax)
        CadAppPick.pins = 0
        WhileLoop LessThan(CadAppPick.pins, CadAppPick.prof_nn) {
            CadAppPick.by = Multiply(CadAppPick.pins, 2)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 10)
            CadAppPick.hu = ArrayGet(CadAppPick.hv, CadAppPick.by)
            CadAppPick.by = Add(CadAppPick.by, 1)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 10)
            CadAppPick.clk_x = ArrayGet(CadAppPick.hv, CadAppPick.by)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 28)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 9)
            CAD_Plane.MapLocal(CadAppPick.ax, CadAppPick.hu, CadAppPick.clk_x, 0, CadAppPick.ay)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 9)
            CadAppPick.clk_y = ArrayGet(CadAppPick.ax, 0)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 9)
            CadAppPick.hit_a = ArrayGet(CadAppPick.ax, 1)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 9)
            CadAppPick.hit_i = ArrayGet(CadAppPick.ax, 2)
            CadAppPick.by = Multiply(CadAppPick.pins, 3)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 13)
            ArraySet(CadAppPick.hv, CadAppPick.by, CadAppPick.clk_y)
            CadAppPick.by = Add(CadAppPick.by, 1)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 13)
            ArraySet(CadAppPick.hv, CadAppPick.by, CadAppPick.hit_a)
            CadAppPick.by = Add(CadAppPick.by, 1)
            ArraySet(CadAppPick.hv, CadAppPick.by, CadAppPick.hit_i)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
        }
        ReturnValue(CadAppPick.prof_nn)
    }
}

// xyz bag[13], index bag[8] → clk_x, clk_y, hit_a.
Function.CA_LoftLoad3 {
    Output: Integer
    Body: {
        CadAppPick.by = ArrayGet(CadAppPick.quiet, 8)
        CadAppPick.by = Multiply(CadAppPick.by, 3)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 13)
        CadAppPick.clk_x = ArrayGet(CadAppPick.hv, CadAppPick.by)
        CadAppPick.by = Add(CadAppPick.by, 1)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 13)
        CadAppPick.clk_y = ArrayGet(CadAppPick.hv, CadAppPick.by)
        CadAppPick.by = Add(CadAppPick.by, 1)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 13)
        CadAppPick.hit_a = ArrayGet(CadAppPick.hv, CadAppPick.by)
        ReturnValue(0)
    }
}

// clk_x, clk_y, hit_a → xyz bag[13] at index bag[8].
Function.CA_LoftStore3 {
    Output: Integer
    Body: {
        CadAppPick.by = ArrayGet(CadAppPick.quiet, 8)
        CadAppPick.by = Multiply(CadAppPick.by, 3)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 13)
        ArraySet(CadAppPick.hv, CadAppPick.by, CadAppPick.clk_x)
        CadAppPick.by = Add(CadAppPick.by, 1)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 13)
        ArraySet(CadAppPick.hv, CadAppPick.by, CadAppPick.clk_y)
        CadAppPick.by = Add(CadAppPick.by, 1)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 13)
        ArraySet(CadAppPick.hv, CadAppPick.by, CadAppPick.hit_a)
        ReturnValue(0)
    }
}

// Centroid of xyz bag[13], count bag[5], into bag 20,21,22.
Function.CA_LoftCentroid {
    Output: Integer
    Body: {
        ArraySet(CadAppPick.quiet, 20, 0)
        ArraySet(CadAppPick.quiet, 21, 0)
        ArraySet(CadAppPick.quiet, 22, 0)
        ArraySet(CadAppPick.quiet, 8, 0)
        CadAppPick.pins = 0
        CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
        WhileLoop LessThan(CadAppPick.pins, CadAppPick.prof_nn) {
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            CA_LoftLoad3()
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 20)
            CadAppPick.ax = Float_Add(CadAppPick.ax, CadAppPick.clk_x)
            ArraySet(CadAppPick.quiet, 20, CadAppPick.ax)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 21)
            CadAppPick.ax = Float_Add(CadAppPick.ax, CadAppPick.clk_y)
            ArraySet(CadAppPick.quiet, 21, CadAppPick.ax)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 22)
            CadAppPick.ax = Float_Add(CadAppPick.ax, CadAppPick.hit_a)
            ArraySet(CadAppPick.quiet, 22, CadAppPick.ax)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 8)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
        }
        CadAppPick.pins = ArrayGet(CadAppPick.quiet, 5)
        CadAppPick.clk_x = Float_FromInt(CadAppPick.pins)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 20)
        CadAppPick.ax = Float_Div(CadAppPick.ax, CadAppPick.clk_x)
        ArraySet(CadAppPick.quiet, 20, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 21)
        CadAppPick.ax = Float_Div(CadAppPick.ax, CadAppPick.clk_x)
        ArraySet(CadAppPick.quiet, 21, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 22)
        CadAppPick.ax = Float_Div(CadAppPick.ax, CadAppPick.clk_x)
        ArraySet(CadAppPick.quiet, 22, CadAppPick.ax)
        ReturnValue(0)
    }
}

// Newell normal of xyz bag[13] into bag 20,21,22. Not unit length.
Function.CA_LoftNewell {
    Output: Integer
    Body: {
        ArraySet(CadAppPick.quiet, 20, 0)
        ArraySet(CadAppPick.quiet, 21, 0)
        ArraySet(CadAppPick.quiet, 22, 0)
        ArraySet(CadAppPick.quiet, 6, 0)
        CadAppPick.pins = 0
        CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
        WhileLoop LessThan(CadAppPick.pins, CadAppPick.prof_nn) {
            ArraySet(CadAppPick.quiet, 6, CadAppPick.pins)
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            CA_LoftLoad3()
            ArraySet(CadAppPick.quiet, 14, CadAppPick.clk_x)
            ArraySet(CadAppPick.quiet, 15, CadAppPick.clk_y)
            ArraySet(CadAppPick.quiet, 19, CadAppPick.hit_a)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
            IfCondition GreaterEqual(CadAppPick.pins, CadAppPick.prof_nn) ThenBlock: {
                CadAppPick.pins = 0
            }
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            CA_LoftLoad3()
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 15)
            CadAppPick.ax = Float_Sub(CadAppPick.ax, CadAppPick.clk_y)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 19)
            CadAppPick.ay = Float_Add(CadAppPick.ay, CadAppPick.hit_a)
            CadAppPick.ax = Float_Mul(CadAppPick.ax, CadAppPick.ay)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 20)
            CadAppPick.ay = Float_Add(CadAppPick.ay, CadAppPick.ax)
            ArraySet(CadAppPick.quiet, 20, CadAppPick.ay)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 19)
            CadAppPick.ax = Float_Sub(CadAppPick.ax, CadAppPick.hit_a)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.ay = Float_Add(CadAppPick.ay, CadAppPick.clk_x)
            CadAppPick.ax = Float_Mul(CadAppPick.ax, CadAppPick.ay)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 21)
            CadAppPick.ay = Float_Add(CadAppPick.ay, CadAppPick.ax)
            ArraySet(CadAppPick.quiet, 21, CadAppPick.ay)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.ax = Float_Sub(CadAppPick.ax, CadAppPick.clk_x)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 15)
            CadAppPick.ay = Float_Add(CadAppPick.ay, CadAppPick.clk_y)
            CadAppPick.ax = Float_Mul(CadAppPick.ax, CadAppPick.ay)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 22)
            CadAppPick.ay = Float_Add(CadAppPick.ay, CadAppPick.ax)
            ArraySet(CadAppPick.quiet, 22, CadAppPick.ay)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
        }
        ReturnValue(0)
    }
}

// Reverse xyz bag[13] in place. Vertex 0 stays put.
Function.CA_LoftReverse {
    Output: Integer
    Body: {
        ArraySet(CadAppPick.quiet, 6, 1)
        CadAppPick.hu = 1
        WhileLoop EqualTo(CadAppPick.hu, 1) {
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
            CadAppPick.by = Subtract(CadAppPick.prof_nn, CadAppPick.pins)
            CadAppPick.found_n = 0
            IfCondition LessThan(CadAppPick.pins, CadAppPick.by) ThenBlock: {
                CadAppPick.found_n = 1
                ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
                CA_LoftLoad3()
                ArraySet(CadAppPick.quiet, 14, CadAppPick.clk_x)
                ArraySet(CadAppPick.quiet, 15, CadAppPick.clk_y)
                ArraySet(CadAppPick.quiet, 19, CadAppPick.hit_a)
                CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
                CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
                CadAppPick.by = Subtract(CadAppPick.prof_nn, CadAppPick.pins)
                ArraySet(CadAppPick.quiet, 8, CadAppPick.by)
                CA_LoftLoad3()
                CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
                ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
                CA_LoftStore3()
                CadAppPick.clk_x = ArrayGet(CadAppPick.quiet, 14)
                CadAppPick.clk_y = ArrayGet(CadAppPick.quiet, 15)
                CadAppPick.hit_a = ArrayGet(CadAppPick.quiet, 19)
                CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
                CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
                CadAppPick.by = Subtract(CadAppPick.prof_nn, CadAppPick.pins)
                ArraySet(CadAppPick.quiet, 8, CadAppPick.by)
                CA_LoftStore3()
                CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
                CadAppPick.pins = Add(CadAppPick.pins, 1)
                ArraySet(CadAppPick.quiet, 6, CadAppPick.pins)
            }
            IfCondition EqualTo(CadAppPick.found_n, 0) ThenBlock: {
                CadAppPick.hu = 0
            }
        }
        ReturnValue(0)
    }
}

// Reverse bag[13] when its Newell dots negative with the delta in 11,12,16.
Function.CA_LoftOrientOne {
    Output: Integer
    Body: {
        CA_LoftNewell()
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 20)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 11)
        CadAppPick.ax = Float_Mul(CadAppPick.ax, CadAppPick.ay)
        CadAppPick.bx = ArrayGet(CadAppPick.quiet, 21)
        CadAppPick.by = ArrayGet(CadAppPick.quiet, 12)
        CadAppPick.bx = Float_Mul(CadAppPick.bx, CadAppPick.by)
        CadAppPick.ax = Float_Add(CadAppPick.ax, CadAppPick.bx)
        CadAppPick.bx = ArrayGet(CadAppPick.quiet, 22)
        CadAppPick.by = ArrayGet(CadAppPick.quiet, 16)
        CadAppPick.bx = Float_Mul(CadAppPick.bx, CadAppPick.by)
        CadAppPick.ax = Float_Add(CadAppPick.ax, CadAppPick.bx)
        CadAppPick.found_n = Float_Le(CadAppPick.ax, 0)
        IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
            CadAppPick.hit_i = CAD_Num.IsZero(CadAppPick.ax, 0)
            IfCondition EqualTo(CadAppPick.hit_i, 0) ThenBlock: {
                CA_LoftReverse()
            }
        }
        ReturnValue(0)
    }
}

// Same winding on both rings. Delta is top centroid minus bottom centroid.
// Counts live in the 32-byte bag[9]: 0 is the bottom, 1 is the top.
Function.CA_LoftOrientPair {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 0)
        ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 3)
        ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
        CA_LoftCentroid()
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 20)
        ArraySet(CadAppPick.quiet, 11, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 21)
        ArraySet(CadAppPick.quiet, 12, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 22)
        ArraySet(CadAppPick.quiet, 16, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 1)
        ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 4)
        ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
        CA_LoftCentroid()
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 20)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 11)
        CadAppPick.ax = Float_Sub(CadAppPick.ax, CadAppPick.ay)
        ArraySet(CadAppPick.quiet, 11, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 21)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 12)
        CadAppPick.ax = Float_Sub(CadAppPick.ax, CadAppPick.ay)
        ArraySet(CadAppPick.quiet, 12, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 22)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 16)
        CadAppPick.ax = Float_Sub(CadAppPick.ax, CadAppPick.ay)
        ArraySet(CadAppPick.quiet, 16, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 0)
        ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 3)
        ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
        CA_LoftOrientOne()
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 1)
        ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 4)
        ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
        CA_LoftOrientOne()
        ReturnValue(0)
    }
}

// Rotate xyz bag[13] one step so old index 1 becomes index 0.
Function.CA_LoftRot1 {
    Output: Integer
    Body: {
        ArraySet(CadAppPick.quiet, 8, 0)
        CA_LoftLoad3()
        ArraySet(CadAppPick.quiet, 14, CadAppPick.clk_x)
        ArraySet(CadAppPick.quiet, 15, CadAppPick.clk_y)
        ArraySet(CadAppPick.quiet, 19, CadAppPick.hit_a)
        CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
        CadAppPick.prof_nn = Subtract(CadAppPick.prof_nn, 1)
        ArraySet(CadAppPick.quiet, 25, CadAppPick.prof_nn)
        ArraySet(CadAppPick.quiet, 6, 0)
        CadAppPick.pins = 0
        WhileLoop LessThan(CadAppPick.pins, CadAppPick.prof_nn) {
            ArraySet(CadAppPick.quiet, 6, CadAppPick.pins)
            CadAppPick.by = Add(CadAppPick.pins, 1)
            ArraySet(CadAppPick.quiet, 8, CadAppPick.by)
            CA_LoftLoad3()
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            CA_LoftStore3()
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 25)
        }
        CadAppPick.clk_x = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.clk_y = ArrayGet(CadAppPick.quiet, 15)
        CadAppPick.hit_a = ArrayGet(CadAppPick.quiet, 19)
        CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 25)
        ArraySet(CadAppPick.quiet, 8, CadAppPick.prof_nn)
        CA_LoftStore3()
        ReturnValue(0)
    }
}

// Rotate the top ring so its vertex nearest bottom vertex 0 is index 0.
// A later index wins a squared-distance tie.
Function.CA_LoftAlign {
    Output: Integer
    Body: {
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 3)
        ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
        ArraySet(CadAppPick.quiet, 8, 0)
        CA_LoftLoad3()
        ArraySet(CadAppPick.quiet, 14, CadAppPick.clk_x)
        ArraySet(CadAppPick.quiet, 15, CadAppPick.clk_y)
        ArraySet(CadAppPick.quiet, 19, CadAppPick.hit_a)
        ArraySet(CadAppPick.quiet, 27, 0)
        ArraySet(CadAppPick.quiet, 26, 0)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 4)
        ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
        ArraySet(CadAppPick.quiet, 6, 0)
        CadAppPick.pins = 0
        CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
        WhileLoop LessThan(CadAppPick.pins, CadAppPick.prof_nn) {
            ArraySet(CadAppPick.quiet, 6, CadAppPick.pins)
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            CA_LoftLoad3()
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.ax = Float_Sub(CadAppPick.clk_x, CadAppPick.ay)
            CadAppPick.ax = Float_Mul(CadAppPick.ax, CadAppPick.ax)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 15)
            CadAppPick.ay = Float_Sub(CadAppPick.clk_y, CadAppPick.ay)
            CadAppPick.ay = Float_Mul(CadAppPick.ay, CadAppPick.ay)
            CadAppPick.ax = Float_Add(CadAppPick.ax, CadAppPick.ay)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 19)
            CadAppPick.ay = Float_Sub(CadAppPick.hit_a, CadAppPick.ay)
            CadAppPick.ay = Float_Mul(CadAppPick.ay, CadAppPick.ay)
            CadAppPick.ax = Float_Add(CadAppPick.ax, CadAppPick.ay)
            CadAppPick.found_n = ArrayGet(CadAppPick.quiet, 27)
            CadAppPick.hu = 0
            IfCondition EqualTo(CadAppPick.found_n, 0) ThenBlock: { CadAppPick.hu = 1 }
            IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                CadAppPick.ay = ArrayGet(CadAppPick.quiet, 12)
                IfCondition EqualTo(Float_Le(CadAppPick.ax, CadAppPick.ay), 1) ThenBlock: {
                    CadAppPick.hu = 1
                }
            }
            IfCondition EqualTo(CadAppPick.hu, 1) ThenBlock: {
                ArraySet(CadAppPick.quiet, 12, CadAppPick.ax)
                CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
                ArraySet(CadAppPick.quiet, 26, CadAppPick.pins)
                ArraySet(CadAppPick.quiet, 27, 1)
            }
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
        }
        CadAppPick.hu = 1
        WhileLoop EqualTo(CadAppPick.hu, 1) {
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 26)
            IfCondition GreaterThan(CadAppPick.pins, 0) ThenBlock: {
                CA_LoftRot1()
                CadAppPick.pins = ArrayGet(CadAppPick.quiet, 26)
                CadAppPick.pins = Subtract(CadAppPick.pins, 1)
                ArraySet(CadAppPick.quiet, 26, CadAppPick.pins)
            }
            IfCondition LessEqual(ArrayGet(CadAppPick.quiet, 26), 0) ThenBlock: {
                CadAppPick.hu = 0
            }
        }
        ReturnValue(0)
    }
}

// 0 when a paired edge has collapsed to one point.
Function.CA_LoftSpan {
    Output: Integer
    Body: {
        ArraySet(CadAppPick.quiet, 6, 0)
        CadAppPick.pins = 0
        CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
        WhileLoop LessThan(CadAppPick.pins, CadAppPick.prof_nn) {
            ArraySet(CadAppPick.quiet, 6, CadAppPick.pins)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 3)
            ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            CA_LoftLoad3()
            ArraySet(CadAppPick.quiet, 14, CadAppPick.clk_x)
            ArraySet(CadAppPick.quiet, 15, CadAppPick.clk_y)
            ArraySet(CadAppPick.quiet, 19, CadAppPick.hit_a)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 4)
            ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            CA_LoftLoad3()
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.ax = Float_Sub(CadAppPick.clk_x, CadAppPick.ay)
            CadAppPick.hit_i = CAD_Num.IsZero(CadAppPick.ax, 0)
            IfCondition EqualTo(CadAppPick.hit_i, 1) ThenBlock: {
                CadAppPick.ay = ArrayGet(CadAppPick.quiet, 15)
                CadAppPick.ax = Float_Sub(CadAppPick.clk_y, CadAppPick.ay)
                CadAppPick.hit_i = CAD_Num.IsZero(CadAppPick.ax, 0)
            }
            IfCondition EqualTo(CadAppPick.hit_i, 1) ThenBlock: {
                CadAppPick.ay = ArrayGet(CadAppPick.quiet, 19)
                CadAppPick.ax = Float_Sub(CadAppPick.hit_a, CadAppPick.ay)
                CadAppPick.hit_i = CAD_Num.IsZero(CadAppPick.ax, 0)
            }
            IfCondition EqualTo(CadAppPick.hit_i, 1) ThenBlock: { ReturnValue(0) }
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
        }
        ReturnValue(1)
    }
}

// Pack sketch A, profile A, sketch B, and profile B into bag[18].
// Bit 32 marks a pack. A bare sketch index has no flag, so the tree
// parent still works and a later replay refuses that row.
Function.CA_LoftSaveEnds {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sk_list, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.by = -1
        CadAppPick.bx = -1
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, CadApp.sk_n) {
            CadAppPick.hv = ArrayGet(CadApp.sk_list, CadAppPick.pi)
            CadAppPick.hit_i = ArrayGet(CadAppPick.quiet, 1)
            IfCondition EqualTo(CadAppPick.hv, CadAppPick.hit_i) ThenBlock: {
                CadAppPick.by = CadAppPick.pi
            }
            CadAppPick.hit_i = ArrayGet(CadAppPick.quiet, 2)
            IfCondition EqualTo(CadAppPick.hv, CadAppPick.hit_i) ThenBlock: {
                CadAppPick.bx = CadAppPick.pi
            }
            CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        IfCondition LessThan(CadAppPick.by, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CadAppPick.bx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(CadAppPick.by, 256) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(CadAppPick.bx, 256) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 16)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 17)
        IfCondition LessThan(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CadAppPick.ay, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(CadAppPick.ax, 256) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(CadAppPick.ay, 256) ThenBlock: { ReturnValue(0) }
        CadAppPick.hit_i = Multiply(CadAppPick.ax, 256)
        CadAppPick.pi = Multiply(CadAppPick.bx, 65536)
        CadAppPick.pj = Multiply(CadAppPick.ay, 16777216)
        CadAppPick.hv = 0x100000000
        CadAppPick.hv = Add(CadAppPick.hv, CadAppPick.by)
        CadAppPick.hv = Add(CadAppPick.hv, CadAppPick.hit_i)
        CadAppPick.hv = Add(CadAppPick.hv, CadAppPick.pi)
        CadAppPick.hv = Add(CadAppPick.hv, CadAppPick.pj)
        CadAppPick.ax = 0
        IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: { CadAppPick.ax = 1 }
        }
        IfCondition EqualTo(CadAppPick.ax, 1) ThenBlock: {
            CadAppPick.hv = Add(CadAppPick.hv, 0x200000000)
        }
        ArraySet(CadAppPick.quiet, 18, CadAppPick.hv)
        ReturnValue(1)
    }
}

// One pure sketch circle into the descriptor at bag[10].
// bag[7] is the sketch. bag[8] is 0 for the bottom ring, 1 for the top.
// Returns 1 when that section is a single circle and nothing else.
Function.CA_LoftCircOne {
    Output: Integer
    Body: {
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 7)
        CadAppPick.ax = CAD_Sketch.GetCircleCount(CadAppPick.ax)
        IfCondition NotEqual(CadAppPick.ax, 1) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 7)
        CadAppPick.ax = CAD_Sketch.GetLineCount(CadAppPick.ax)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 7)
        CadAppPick.ax = CAD_Sketch.GetArcCount(CadAppPick.ax)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 7)
        CadAppPick.hit_a = CAD_Sketch.GetCircleRadius(CadAppPick.ax, 0)
        CadAppPick.ax = CAD_Num.IsZero(CadAppPick.hit_a, 0)
        IfCondition EqualTo(CadAppPick.ax, 1) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 7)
        CadAppPick.ax = CAD_Store.Read(CadAppPick.ax, 8)
        CadAppPick.clk_x = ArrayGet(CadAppPick.ax, 0)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 7)
        CadAppPick.ax = CAD_Store.Read(CadAppPick.ax, 8)
        CadAppPick.clk_y = ArrayGet(CadAppPick.ax, 1)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 7)
        CadAppPick.pins = CAD_Sketch.GetPlaneId(CadAppPick.ax)
        IfCondition LessThan(CadAppPick.pins, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.hv = Allocate(128)
        IfCondition EqualTo(CadAppPick.hv, 0) ThenBlock: { ReturnValue(0) }
        CAD_Plane.EvalFrame(CadAppPick.pins, CadAppPick.hv)
        CadAppPick.hu = Allocate(32)
        IfCondition EqualTo(CadAppPick.hu, 0) ThenBlock: {
            Deallocate(CadAppPick.hv, 128)
            ReturnValue(0)
        }
        CAD_Plane.MapLocal(CadAppPick.pins, CadAppPick.clk_x, CadAppPick.clk_y, 0, CadAppPick.hu)
        CadAppPick.bx = 4
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 8)
        IfCondition EqualTo(CadAppPick.ay, 1) ThenBlock: { CadAppPick.bx = 13 }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 10)
        CadAppPick.ay = ArrayGet(CadAppPick.hu, 0)
        ArraySet(CadAppPick.ax, CadAppPick.bx, CadAppPick.ay)
        CadAppPick.bx = Add(CadAppPick.bx, 1)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 10)
        CadAppPick.ay = ArrayGet(CadAppPick.hu, 1)
        ArraySet(CadAppPick.ax, CadAppPick.bx, CadAppPick.ay)
        CadAppPick.bx = Add(CadAppPick.bx, 1)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 10)
        CadAppPick.ay = ArrayGet(CadAppPick.hu, 2)
        ArraySet(CadAppPick.ax, CadAppPick.bx, CadAppPick.ay)
        CadAppPick.bx = Add(CadAppPick.bx, 1)
        CadAppPick.by = 3
        WhileLoop LessThan(CadAppPick.by, 9) {
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 10)
            CadAppPick.ay = ArrayGet(CadAppPick.hv, CadAppPick.by)
            ArraySet(CadAppPick.ax, CadAppPick.bx, CadAppPick.ay)
            CadAppPick.bx = Add(CadAppPick.bx, 1)
            CadAppPick.by = Add(CadAppPick.by, 1)
        }
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 8)
        CadAppPick.ay = Add(CadAppPick.ay, 2)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 10)
        ArraySet(CadAppPick.ax, CadAppPick.ay, CadAppPick.hit_a)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 8)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 10)
        ArraySet(CadAppPick.ax, CadAppPick.ay, 1)
        Deallocate(CadAppPick.hv, 128)
        Deallocate(CadAppPick.hu, 32)
        ReturnValue(1)
    }
}

// 1 when either section is one sketch circle. Station count lands in bag[5].
// The descriptor overwrites bag[10] after both rings are already mapped.
Function.CA_LoftCircReady {
    Output: Integer
    Body: {
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 10)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CadAppPick.ax, 0, 0)
        ArraySet(CadAppPick.ax, 1, 0)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 1)
        ArraySet(CadAppPick.quiet, 7, CadAppPick.ax)
        ArraySet(CadAppPick.quiet, 8, 0)
        CA_LoftCircOne()
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 2)
        ArraySet(CadAppPick.quiet, 7, CadAppPick.ax)
        ArraySet(CadAppPick.quiet, 8, 1)
        CA_LoftCircOne()
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 10)
        CadAppPick.bx = ArrayGet(CadAppPick.ax, 0)
        CadAppPick.by = ArrayGet(CadAppPick.ax, 1)
        ArraySet(CadAppPick.quiet, 7, 0)
        ArraySet(CadAppPick.quiet, 8, 0)
        CadAppPick.pins = Add(CadAppPick.bx, CadAppPick.by)
        IfCondition EqualTo(CadAppPick.pins, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadAppPick.pins, 2) ThenBlock: {
            ArraySet(CadAppPick.quiet, 5, 4)
            ReturnValue(1)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
        IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: {
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 1)
        }
        IfCondition EqualTo(CadAppPick.bx, 0) ThenBlock: {
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 0)
        }
        IfCondition LessThan(CadAppPick.pins, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(CadAppPick.pins, 60) ThenBlock: { ReturnValue(0) }
        ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
        ReturnValue(1)
    }
}

// Ruled loft of the two newest closed sketches. 0 on success.
Function.CA_LoftSketches {
    Output: Integer
    Body: {
        CadAppPick.hv = CadApp.sketch
        CadAppPick.quiet = Allocate(256)
        IfCondition EqualTo(CadAppPick.quiet, 0) ThenBlock: {
            CA_Notify("cad_app: loft FAIL\n", 19)
            ReturnValue(-1)
        }
        ArraySet(CadAppPick.quiet, 0, CadAppPick.hv)
        ArraySet(CadAppPick.quiet, 3, 0)
        ArraySet(CadAppPick.quiet, 4, 0)
        ArraySet(CadAppPick.quiet, 9, 0)
        ArraySet(CadAppPick.quiet, 10, 0)
        ArraySet(CadAppPick.quiet, 23, 0)
        ArraySet(CadAppPick.quiet, 24, 0)
        ArraySet(CadAppPick.quiet, 29, 0)
        ArraySet(CadAppPick.quiet, 30, 0)
        CadAppPick.ax = Allocate(2048)
        ArraySet(CadAppPick.quiet, 3, CadAppPick.ax)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            ReturnValue(CA_LoftFail("cad_app: loft FAIL\n", 19))
        }
        CadAppPick.ax = Allocate(2048)
        ArraySet(CadAppPick.quiet, 4, CadAppPick.ax)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            ReturnValue(CA_LoftFail("cad_app: loft FAIL\n", 19))
        }
        CadAppPick.ax = Allocate(32)
        ArraySet(CadAppPick.quiet, 9, CadAppPick.ax)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            ReturnValue(CA_LoftFail("cad_app: loft FAIL\n", 19))
        }
        CadAppPick.ax = Allocate(65536)
        ArraySet(CadAppPick.quiet, 10, CadAppPick.ax)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            ReturnValue(CA_LoftFail("cad_app: loft FAIL\n", 19))
        }
        CadAppPick.ax = Allocate(32)
        ArraySet(CadAppPick.quiet, 30, CadAppPick.ax)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            ReturnValue(CA_LoftFail("cad_app: loft FAIL\n", 19))
        }
        CadAppPick.bx = 0
        IfCondition EqualTo(CadApp.tool, 21) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: { CadAppPick.bx = 1 }
        }
        IfCondition EqualTo(CadAppPick.bx, 0) ThenBlock: {
            CadAppPick.ax = CA_LoftPickTwo()
            IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
                ReturnValue(CA_LoftFail("cad_app: loft needs 2 sketches\n", 31))
            }
        }
        IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: {
            CadAppPick.by = CadApp.fillet_li
            CadAppPick.ax = ArrayGet(CadApp.sk_list, CadAppPick.by)
            ArraySet(CadAppPick.quiet, 1, CadAppPick.ax)
            CadAppPick.by = CadApp.fillet_lj
            ArraySet(CadAppPick.quiet, 16, CadAppPick.by)
            CadAppPick.by = CadApp.cstr_ia
            ArraySet(CadAppPick.quiet, 18, CadAppPick.by)
            CadAppPick.ax = ArrayGet(CadApp.sk_list, CadAppPick.by)
            ArraySet(CadAppPick.quiet, 2, CadAppPick.ax)
            CadAppPick.by = CadApp.cstr_ib
            ArraySet(CadAppPick.quiet, 17, CadAppPick.by)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 1)
            IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
                ReturnValue(CA_LoftFail("cad_app: loft needs 2 sketches\n", 31))
            }
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 2)
            IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
                ReturnValue(CA_LoftFail("cad_app: loft needs 2 sketches\n", 31))
            }
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 1)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 2)
            IfCondition EqualTo(CadAppPick.ax, CadAppPick.ay) ThenBlock: {
                ReturnValue(CA_LoftFail("cad_app: loft needs 2 sketches\n", 31))
            }
        }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 1)
        ArraySet(CadAppPick.quiet, 7, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 16)
        ArraySet(CadAppPick.quiet, 11, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 3)
        ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
        CadAppPick.ax = CA_LoftMapRing()
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            ReturnValue(CA_LoftFail("cad_app: loft corner count\n", 27))
        }
        ArraySet(CadAppPick.quiet, 6, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 2)
        ArraySet(CadAppPick.quiet, 7, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 17)
        ArraySet(CadAppPick.quiet, 11, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 4)
        ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
        CadAppPick.ax = CA_LoftMapRing()
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            ReturnValue(CA_LoftFail("cad_app: loft corner count\n", 27))
        }
        ArraySet(CadAppPick.quiet, 12, CadAppPick.ax)
        CA_LoftSaveEnds()
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 6)
        ArraySet(CadAppPick.hv, 0, CadAppPick.ay)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 12)
        ArraySet(CadAppPick.hv, 1, CadAppPick.ay)
        CA_LoftOrientPair()
        CadAppPick.ax = CA_LoftCircReady()
        CadAppPick.hit_i = 0
        IfCondition EqualTo(CadAppPick.ax, 1) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 3)
            CadAppPick.hu = ArrayGet(CadAppPick.quiet, 4)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 5)
            CadAppPick.bx = ArrayGet(CadAppPick.quiet, 10)
            CadAppPick.by = ArrayGet(CadAppPick.quiet, 30)
            CadAppPick.hit_i = CAD_Topo.MakeRuledSolidCircle(CadAppPick.hv, CadAppPick.hu, CadAppPick.pins, CadAppPick.bx, CadAppPick.by)
        }
        IfCondition EqualTo(CadAppPick.hit_i, 0) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, 0)
            CadAppPick.ay = ArrayGet(CadAppPick.hv, 1)
            ArraySet(CadAppPick.quiet, 7, 0)
            IfCondition NotEqual(CadAppPick.ax, CadAppPick.ay) ThenBlock: {
                ArraySet(CadAppPick.quiet, 7, 1)
                CadAppPick.ax = CA_LoftResample()
                IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
                    ReturnValue(CA_LoftFail("cad_app: loft corner count\n", 27))
                }
            }
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 7)
            IfCondition EqualTo(CadAppPick.pins, 0) ThenBlock: {
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
                CadAppPick.ax = ArrayGet(CadAppPick.hv, 0)
                ArraySet(CadAppPick.quiet, 5, CadAppPick.ax)
                CA_LoftAlign()
            }
            CadAppPick.ax = CA_LoftSpan()
            IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
                ReturnValue(CA_LoftFail("cad_app: loft span\n", 19))
            }
            CadAppPick.ax = Allocate(64)
            ArraySet(CadAppPick.quiet, 23, CadAppPick.ax)
            IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
                ReturnValue(CA_LoftFail("cad_app: loft FAIL\n", 19))
            }
            ArraySet(CadAppPick.ax, 2, 0)
            ArraySet(CadAppPick.ax, 3, 0)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 3)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 5)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 23)
            CadAppPick.hit_i = CAD_BSpline.MakeRing(CadAppPick.hv, CadAppPick.pins, CadAppPick.ax)
            IfCondition NotEqual(CadAppPick.hit_i, 0) ThenBlock: {
                ReturnValue(CA_LoftFail("cad_app: loft FAIL\n", 19))
            }
            CadAppPick.ax = Allocate(64)
            ArraySet(CadAppPick.quiet, 24, CadAppPick.ax)
            IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
                ReturnValue(CA_LoftFail("cad_app: loft FAIL\n", 19))
            }
            ArraySet(CadAppPick.ax, 2, 0)
            ArraySet(CadAppPick.ax, 3, 0)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 4)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 5)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 24)
            CadAppPick.hit_i = CAD_BSpline.MakeRing(CadAppPick.hv, CadAppPick.pins, CadAppPick.ax)
            IfCondition NotEqual(CadAppPick.hit_i, 0) ThenBlock: {
                ReturnValue(CA_LoftFail("cad_app: loft FAIL\n", 19))
            }
            CadAppPick.ax = Allocate(128)
            ArraySet(CadAppPick.quiet, 29, CadAppPick.ax)
            IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
                ReturnValue(CA_LoftFail("cad_app: loft FAIL\n", 19))
            }
            ArraySet(CadAppPick.ax, 4, 0)
            ArraySet(CadAppPick.ax, 7, 0)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 23)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 24)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 29)
            CadAppPick.hit_i = CAD_BSpline.MakeRuled(CadAppPick.hv, CadAppPick.pins, CadAppPick.ax)
            IfCondition NotEqual(CadAppPick.hit_i, 0) ThenBlock: {
                ReturnValue(CA_LoftFail("cad_app: loft FAIL\n", 19))
            }
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 29)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 5)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 3)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 4)
            CadAppPick.hit_i = CAD_BSpline.SampleRuled(CadAppPick.hv, CadAppPick.pins, CadAppPick.ax, CadAppPick.ay)
            IfCondition NotEqual(CadAppPick.hit_i, 0) ThenBlock: {
                ReturnValue(CA_LoftFail("cad_app: loft FAIL\n", 19))
            }
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 3)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 4)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 5)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 30)
            CadAppPick.hit_i = CAD_Topo.MakeRuledSolidXYZ(CadAppPick.ax, CadAppPick.ay, CadAppPick.pins, CadAppPick.hv)
            IfCondition EqualTo(CadAppPick.hit_i, 0) ThenBlock: {
                ReturnValue(CA_LoftFail("cad_app: loft FAIL\n", 19))
            }
        }
        CadAppPick.ax = CA_LoftApply()
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            CA_LoftFree()
            ReturnValue(-4)
        }
        CadApp.wire = 0
        CadApp.fillet_li = -1
        CadApp.fillet_lj = -1
        CadApp.face_pick = 0
        CadApp.dirty = 1
        CAD_View.SetWire(0)
        CAD_Topo.RebuildKind0Planes(CadApp.solid)
        // A timeline scrub or a dimension commit sets snap. Rebuild the
        // body. Leave mode, the tool, and the camera on the sketch.
        IfCondition EqualTo(CadAppReplay.snap, 0) ThenBlock: {
            CadApp.mode = 0
            CadApp.tool = 0
            CadApp.nclick = 0
            CadApp.sk_ready = 0
            CadApp.hud_kind = 0
            CAD_View.SetViewMode(0)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 18)
            CadAppPick.by = CadAppPick.pins
            CadAppPick.bx = BitwiseAnd(CadAppPick.pins, 0x100000000)
            IfCondition NotEqual(CadAppPick.bx, 0) ThenBlock: {
                CadAppPick.ax = RightShift(CadAppPick.pins, 16)
                CadAppPick.by = BitwiseAnd(CadAppPick.ax, 255)
            }
            CA_FeatAdd(15, CadAppPick.by)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 18)
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadAppPick.pins)
            }
            CA_Notify("cad_app: loft OK\n", 17)
        }
        CA_LoftFree()
        IfCondition EqualTo(CadApp.replay, 0) ThenBlock: {
            CA_PublishFrame()
        }
        ReturnValue(0)
    }
}

// Leave the face-on sketch. The camera becomes the home isometric view.
Function.CA_LeaveSketchView {
    Output: Integer
    Body: {
        CadApp.mode = 0
        CadApp.sk_ready = 0
        CadApp.face_pick = 0
        CadApp.plane_pick = 0
        IfCondition EqualTo(CadApp.tool, 4) ThenBlock: { CadApp.tool = 0 }
        CadApp.show_sketch = 1
        CadApp.view = 0
        CAD_View.SetViewMode(0)
        ReturnValue(0)
    }
}

// Solid tab. Flat profile-pick stays on the Pick button.
Function.CA_EnterModelView {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.tool, 21) ThenBlock: {
            CadApp.fillet_li = -1
            CadApp.fillet_lj = -1
            CadApp.hud_kind = 0
        }
        CadApp.tool = 0
        CadApp.nclick = 0
        CA_LeaveSketchView()
        CA_Log("cad_app: 3D mode\n", 17)
        IfCondition EqualTo(CadApp.replay, 0) ThenBlock: { CA_PublishFrame() }
        ReturnValue(0)
    }
}

// Loft button. Two later clicks choose the profiles.
Function.CA_LoftArm {
    Output: Integer
    Body: {
        CA_LeaveSketchView()
        CadApp.extrude_op = 2
        CadApp.hud_kind = 11
        CadApp.hud_field = 0
        CadApp.tool = 21
        CadApp.nclick = 0
        CadApp.fillet_li = -1
        CadApp.fillet_lj = -1
        CadApp.cstr_ia = 0
        CadApp.cstr_ib = 0
        CA_LoftCompileFaces()
        CA_Log("cad_app: loft pick\n", 19)
        IfCondition EqualTo(CadApp.replay, 0) ThenBlock: { CA_PublishFrame() }
        ReturnValue(0)
    }
}

// Ray at (px,py) against every sketch plane. 1 and list_sel / cstr_npick
// are the sketch-list index and the profile index. 0 is a miss.
Function.CA_LoftHit {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        CadApp.list_sel = -1
        CadApp.cstr_npick = 0
        IfCondition EqualTo(CadApp.sk_list, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CA_RaySetup(px, py), 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = Allocate(512)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CadAppPick.ax, 40, CadApp.tmp_b)
        CadApp.tmp_b = CadAppPick.ax
        ArraySet(CadApp.tmp_b, 0, CadAppPick.wx)
        ArraySet(CadApp.tmp_b, 1, CadAppPick.wy)
        ArraySet(CadApp.tmp_b, 2, CadAppPick.wz)
        ArraySet(CadApp.tmp_b, 3, CadAppPick.dx)
        ArraySet(CadApp.tmp_b, 4, CadAppPick.dy)
        ArraySet(CadApp.tmp_b, 5, CadAppPick.dz)
        ArraySet(CadApp.tmp_b, 6, 0)
        ArraySet(CadApp.tmp_b, 7, 0x42C1D206A0000000)
        ArraySet(CadApp.tmp_b, 8, -1)
        ArraySet(CadApp.tmp_b, 9, 0)
        ArraySet(CadApp.tmp_b, 34, 0)
        CadAppPick.ax = Allocate(65536)
        ArraySet(CadApp.tmp_b, 10, CadAppPick.ax)
        ArraySet(CadApp.tmp_b, 11, CadApp.sketch)
        IfCondition EqualTo(ArrayGet(CadApp.tmp_b, 10), 0) ThenBlock: {
            CadAppPick.ay = ArrayGet(CadApp.tmp_b, 40)
            CadAppPick.ax = CadApp.tmp_b
            CadApp.tmp_b = CadAppPick.ay
            Deallocate(CadAppPick.ax, 512)
            ReturnValue(0)
        }
        CadAppPick.by = 0
        WhileLoop LessThan(CadAppPick.by, CadApp.sk_n) {
            CadAppPick.found_n = 1
            CadAppPick.ax = ArrayGet(CadApp.tmp_b, 6)
            CadAppPick.ax = ArrayGet(CadApp.sk_list, CadAppPick.ax)
            ArraySet(CadApp.tmp_b, 12, CadAppPick.ax)
            CadAppPick.pins = 0
            CadAppPick.ax = ArrayGet(CadApp.tmp_b, 12)
            CadAppPick.ax = CAD_Sketch.GetLineCount(CadAppPick.ax)
            CadAppPick.pins = CadAppPick.ax
            CadAppPick.ax = ArrayGet(CadApp.tmp_b, 12)
            CadAppPick.ax = CAD_Sketch.GetCircleCount(CadAppPick.ax)
            CadAppPick.pins = Add(CadAppPick.pins, CadAppPick.ax)
            CadAppPick.ax = ArrayGet(CadApp.tmp_b, 12)
            CadAppPick.ax = CAD_Sketch.GetArcCount(CadAppPick.ax)
            CadAppPick.pins = Add(CadAppPick.pins, CadAppPick.ax)
            IfCondition EqualTo(CadAppPick.pins, 0) ThenBlock: { CadAppPick.found_n = 0 }
            IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                CadAppPick.ax = ArrayGet(CadApp.tmp_b, 12)
                CadAppPick.ax = CAD_Sketch.GetPlaneId(CadAppPick.ax)
                IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { CadAppPick.ax = CadApp.plane }
                ArraySet(CadApp.tmp_b, 13, CadAppPick.ax)
                IfCondition EqualTo(ArrayGet(CadApp.tmp_b, 13), 0) ThenBlock: { CadAppPick.found_n = 0 }
            }
            IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                CadAppPick.ax = ArrayGet(CadApp.tmp_b, 13)
                CadAppPick.hit_i = CAD_Plane.EvalFrame(CadAppPick.ax, CadAppPick.pl)
                IfCondition NotEqual(CadAppPick.hit_i, 0) ThenBlock: { CadAppPick.found_n = 0 }
            }
            IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                CadAppPick.pi = 0
                WhileLoop LessThan(CadAppPick.pi, 12) {
                    CadAppPick.hu = ArrayGet(CadAppPick.pl, CadAppPick.pi)
                    CadAppPick.pj = Add(CadAppPick.pi, 14)
                    ArraySet(CadApp.tmp_b, CadAppPick.pj, CadAppPick.hu)
                    CadAppPick.pi = Add(CadAppPick.pi, 1)
                }
                CadAppPick.hu = ArrayGet(CadApp.tmp_b, 3)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 23)
                CadAppPick.hit_a = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hu = ArrayGet(CadApp.tmp_b, 4)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 24)
                CadAppPick.clk_x = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hit_a = Float_Add(CadAppPick.hit_a, CadAppPick.clk_x)
                CadAppPick.hu = ArrayGet(CadApp.tmp_b, 5)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 25)
                CadAppPick.clk_x = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hit_a = Float_Add(CadAppPick.hit_a, CadAppPick.clk_x)
                ArraySet(CadApp.tmp_b, 35, CadAppPick.hit_a)
                IfCondition EqualTo(CAD_Num.IsZero(CadAppPick.hit_a, 0), 1) ThenBlock: { CadAppPick.found_n = 0 }
            }
            IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                CadAppPick.hu = ArrayGet(CadApp.tmp_b, 14)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 0)
                CadAppPick.hu = Float_Sub(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 23)
                CadAppPick.hit_a = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hu = ArrayGet(CadApp.tmp_b, 15)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 1)
                CadAppPick.hu = Float_Sub(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 24)
                CadAppPick.clk_x = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hit_a = Float_Add(CadAppPick.hit_a, CadAppPick.clk_x)
                CadAppPick.hu = ArrayGet(CadApp.tmp_b, 16)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 2)
                CadAppPick.hu = Float_Sub(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 25)
                CadAppPick.clk_x = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hit_a = Float_Add(CadAppPick.hit_a, CadAppPick.clk_x)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 35)
                CadAppPick.hit_a = Float_Div(CadAppPick.hit_a, CadAppPick.hv)
                ArraySet(CadApp.tmp_b, 28, CadAppPick.hit_a)
            }
            IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                CadAppPick.hu = ArrayGet(CadApp.tmp_b, 28)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 3)
                CadAppPick.clk_x = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 0)
                CadAppPick.clk_x = Float_Add(CadAppPick.hv, CadAppPick.clk_x)
                ArraySet(CadApp.tmp_b, 37, CadAppPick.clk_x)
                CadAppPick.hu = ArrayGet(CadApp.tmp_b, 28)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 4)
                CadAppPick.clk_x = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 1)
                CadAppPick.clk_x = Float_Add(CadAppPick.hv, CadAppPick.clk_x)
                ArraySet(CadApp.tmp_b, 38, CadAppPick.clk_x)
                CadAppPick.hu = ArrayGet(CadApp.tmp_b, 28)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 5)
                CadAppPick.clk_x = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 2)
                CadAppPick.clk_x = Float_Add(CadAppPick.hv, CadAppPick.clk_x)
                ArraySet(CadApp.tmp_b, 39, CadAppPick.clk_x)
                CadAppPick.hu = ArrayGet(CadApp.tmp_b, 37)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 14)
                CadAppPick.hu = Float_Sub(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 17)
                CadAppPick.hit_a = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hu = ArrayGet(CadApp.tmp_b, 38)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 15)
                CadAppPick.hu = Float_Sub(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 18)
                CadAppPick.clk_x = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hit_a = Float_Add(CadAppPick.hit_a, CadAppPick.clk_x)
                CadAppPick.hu = ArrayGet(CadApp.tmp_b, 39)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 16)
                CadAppPick.hu = Float_Sub(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 19)
                CadAppPick.clk_x = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hit_a = Float_Add(CadAppPick.hit_a, CadAppPick.clk_x)
                ArraySet(CadApp.tmp_b, 26, CadAppPick.hit_a)
                CadAppPick.hu = ArrayGet(CadApp.tmp_b, 37)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 14)
                CadAppPick.hu = Float_Sub(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 20)
                CadAppPick.hit_a = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hu = ArrayGet(CadApp.tmp_b, 38)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 15)
                CadAppPick.hu = Float_Sub(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 21)
                CadAppPick.clk_x = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hit_a = Float_Add(CadAppPick.hit_a, CadAppPick.clk_x)
                CadAppPick.hu = ArrayGet(CadApp.tmp_b, 39)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 16)
                CadAppPick.hu = Float_Sub(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hv = ArrayGet(CadApp.tmp_b, 22)
                CadAppPick.clk_x = Float_Mul(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hit_a = Float_Add(CadAppPick.hit_a, CadAppPick.clk_x)
                ArraySet(CadApp.tmp_b, 27, CadAppPick.hit_a)
                CadApp.sketch = ArrayGet(CadApp.tmp_b, 12)
                CadAppPick.hit_i = CA_RebuildProfiles()
                ArraySet(CadApp.tmp_b, 29, CadAppPick.hit_i)
                ArraySet(CadApp.tmp_b, 32, 0)
                ArraySet(CadApp.tmp_b, 30, 0)
                CadAppPick.pi = 0
                CadAppPick.pj = ArrayGet(CadApp.tmp_b, 29)
                WhileLoop LessThan(CadAppPick.pi, CadAppPick.pj) {
                    CadAppPick.ax = ArrayGet(CadApp.tmp_b, 12)
                    CadAppPick.ay = ArrayGet(CadApp.tmp_b, 30)
                    CadAppPick.hv = ArrayGet(CadApp.tmp_b, 10)
                    CadAppPick.prof_nn = CAD_Sketch.GetProfileXY(CadAppPick.ax, CadAppPick.ay, CadAppPick.hv)
                    ArraySet(CadApp.tmp_b, 31, CadAppPick.prof_nn)
                    IfCondition GreaterEqual(CadAppPick.prof_nn, 3) ThenBlock: {
                        CadAppPick.hu = ArrayGet(CadApp.tmp_b, 26)
                        CadAppPick.hv = ArrayGet(CadApp.tmp_b, 27)
                        CadAppPick.ax = ArrayGet(CadApp.tmp_b, 10)
                        CadAppPick.pins = ArrayGet(CadApp.tmp_b, 31)
                        CadAppPick.bx = CA_PointInPoly(CadAppPick.hu, CadAppPick.hv, CadAppPick.ax, CadAppPick.pins)
                        IfCondition EqualTo(CadAppPick.bx, 0) ThenBlock: {
                            CadAppPick.hu = ArrayGet(CadApp.tmp_b, 26)
                            CadAppPick.hv = ArrayGet(CadApp.tmp_b, 27)
                            CadAppPick.ax = ArrayGet(CadApp.tmp_b, 10)
                            CadAppPick.pins = ArrayGet(CadApp.tmp_b, 31)
                            CadAppPick.bx = CA_PtOnRing(CadAppPick.hu, CadAppPick.hv, CadAppPick.ax, CadAppPick.pins)
                        }
                        IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: {
                            CadAppPick.ax = ArrayGet(CadApp.tmp_b, 10)
                            CadAppPick.pins = ArrayGet(CadApp.tmp_b, 31)
                            CadAppPick.hit_a = CAD_Sketch.LoopSignedArea(CadAppPick.ax, CadAppPick.pins)
                            CadAppPick.hit_a = CAD_Num.Abs(CadAppPick.hit_a)
                            CadAppPick.clk_x = 0
                            IfCondition EqualTo(ArrayGet(CadApp.tmp_b, 32), 0) ThenBlock: { CadAppPick.clk_x = 1 }
                            IfCondition EqualTo(ArrayGet(CadApp.tmp_b, 32), 1) ThenBlock: {
                                CadAppPick.clk_y = ArrayGet(CadApp.tmp_b, 33)
                                IfCondition EqualTo(Float_Le(CadAppPick.hit_a, CadAppPick.clk_y), 1) ThenBlock: { CadAppPick.clk_x = 1 }
                            }
                            IfCondition EqualTo(CadAppPick.clk_x, 1) ThenBlock: {
                                ArraySet(CadApp.tmp_b, 33, CadAppPick.hit_a)
                                ArraySet(CadApp.tmp_b, 32, 1)
                                CadAppPick.ay = ArrayGet(CadApp.tmp_b, 30)
                                ArraySet(CadApp.tmp_b, 36, CadAppPick.ay)
                            }
                        }
                    }
                    CadAppPick.pi = ArrayGet(CadApp.tmp_b, 30)
                    CadAppPick.pi = Add(CadAppPick.pi, 1)
                    ArraySet(CadApp.tmp_b, 30, CadAppPick.pi)
                    CadAppPick.pj = ArrayGet(CadApp.tmp_b, 29)
                }
                IfCondition EqualTo(ArrayGet(CadApp.tmp_b, 32), 1) ThenBlock: {
                    CadAppPick.clk_x = CA_LoftHitKeep()
                    IfCondition EqualTo(CadAppPick.clk_x, 1) ThenBlock: {
                        CadAppPick.hu = ArrayGet(CadApp.tmp_b, 28)
                        ArraySet(CadApp.tmp_b, 7, CadAppPick.hu)
                        CadAppPick.ax = ArrayGet(CadApp.tmp_b, 6)
                        ArraySet(CadApp.tmp_b, 8, CadAppPick.ax)
                        CadAppPick.ax = ArrayGet(CadApp.tmp_b, 36)
                        ArraySet(CadApp.tmp_b, 9, CadAppPick.ax)
                        CadAppPick.hu = ArrayGet(CadApp.tmp_b, 33)
                        ArraySet(CadApp.tmp_b, 34, CadAppPick.hu)
                    }
                }
            }
            CadAppPick.by = ArrayGet(CadApp.tmp_b, 6)
            CadAppPick.by = Add(CadAppPick.by, 1)
            ArraySet(CadApp.tmp_b, 6, CadAppPick.by)
        }
        CadApp.sketch = ArrayGet(CadApp.tmp_b, 11)
        CadApp.list_sel = ArrayGet(CadApp.tmp_b, 8)
        CadApp.cstr_npick = ArrayGet(CadApp.tmp_b, 9)
        CadAppPick.ax = ArrayGet(CadApp.tmp_b, 10)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: { Deallocate(CadAppPick.ax, 65536) }
        CadAppPick.ay = ArrayGet(CadApp.tmp_b, 40)
        CadAppPick.ax = CadApp.tmp_b
        CadApp.tmp_b = CadAppPick.ay
        Deallocate(CadAppPick.ax, 512)
        IfCondition GreaterEqual(CadApp.list_sel, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// First click arms a profile. A later click on another sketch stores the
// other end. Enter builds. A click does not.
Function.CA_LoftClick {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        CadAppPick.ax = CA_LoftHit(px, py)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            CA_Log("cad_app: loft pick miss\n", 24)
            IfCondition EqualTo(CadApp.replay, 0) ThenBlock: { CA_PublishFrame() }
            ReturnValue(0)
        }
        IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: {
            CadApp.fillet_li = CadApp.list_sel
            CadApp.fillet_lj = CadApp.cstr_npick
            CadApp.nclick = 1
            CA_Log("cad_app: loft pick 1\n", 21)
            IfCondition EqualTo(CadApp.replay, 0) ThenBlock: { CA_PublishFrame() }
            ReturnValue(0)
        }
        IfCondition EqualTo(CadApp.list_sel, CadApp.fillet_li) ThenBlock: {
            CadApp.fillet_lj = CadApp.cstr_npick
            CadApp.nclick = 1
            CA_Log("cad_app: loft pick 1\n", 21)
            IfCondition EqualTo(CadApp.replay, 0) ThenBlock: { CA_PublishFrame() }
            ReturnValue(0)
        }
        CadApp.cstr_ia = CadApp.list_sel
        CadApp.cstr_ib = CadApp.cstr_npick
        CadApp.nclick = 2
        CadApp.tool = 21
        CA_Log("cad_app: loft pick 2\n", 21)
        IfCondition EqualTo(CadApp.replay, 0) ThenBlock: { CA_PublishFrame() }
        ReturnValue(0)
    }
}

// Rebuild one loft from the packed ends on its feature row. 0 if the
// row has no pack. snap is already 1, so this does not push history.
Function.CA_LoftReplay {
    Output: Integer
    Body: {
        CadAppReplay.ok = 0
        CadAppReplay.ax = BitwiseAnd(CadAppReplay.aux, 0x100000000)
        IfCondition EqualTo(CadAppReplay.ax, 0) ThenBlock: { ReturnValue(0) }
        CadAppReplay.tool = BitwiseAnd(CadAppReplay.aux, 255)
        CadAppReplay.ax = RightShift(CadAppReplay.aux, 8)
        CadAppReplay.cut = BitwiseAnd(CadAppReplay.ax, 255)
        CadAppReplay.ax = RightShift(CadAppReplay.aux, 16)
        // skB goes straight into cstr_ia. Replay.sk is the live sketch
        // handle FeatRegen and HistGo restore after this call.
        CadApp.cstr_ia = BitwiseAnd(CadAppReplay.ax, 255)
        CadAppReplay.ax = RightShift(CadAppReplay.aux, 24)
        CadAppReplay.ne = BitwiseAnd(CadAppReplay.ax, 255)
        IfCondition GreaterEqual(CadAppReplay.tool, CadApp.sk_n) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(CadApp.cstr_ia, CadApp.sk_n) ThenBlock: { ReturnValue(0) }
        CadAppPick.n_circ = CadApp.tool
        CadAppPick.col = CadApp.nclick
        CadApp.fillet_li = CadAppReplay.tool
        CadApp.fillet_lj = CadAppReplay.cut
        CadApp.cstr_ib = CadAppReplay.ne
        CadAppReplay.hh = CadApp.extrude_op
        CadApp.extrude_op = 2
        CadAppReplay.ax = BitwiseAnd(CadAppReplay.aux, 0x200000000)
        IfCondition NotEqual(CadAppReplay.ax, 0) ThenBlock: { CadApp.extrude_op = 1 }
        CadApp.tool = 21
        CadApp.nclick = 2
        CadAppReplay.guard = CA_LoftSketches()
        CadApp.extrude_op = CadAppReplay.hh
        IfCondition EqualTo(CadAppReplay.snap, 1) ThenBlock: {
            CadApp.tool = CadAppPick.n_circ
            CadApp.nclick = CadAppPick.col
        }
        IfCondition EqualTo(CadAppReplay.snap, 0) ThenBlock: {
            CadApp.tool = 0
            CadApp.nclick = 0
        }
        CadAppPick.n_circ = 0
        CadAppPick.col = 0
        IfCondition EqualTo(CadAppReplay.guard, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                CadAppReplay.ok = 1
            }
        }
        ReturnValue(CadAppReplay.ok)
    }
}
