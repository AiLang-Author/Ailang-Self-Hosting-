// Vertex match of two closed loft rings.
// Both rings keep every corner, in order. The longer ring is used once.
// The shorter ring repeats corners so the rulings are as short as possible.
// Both rings then have the same station count. No edge is split.
// Equal counts do not come here. Bag 7 is the caller's flag and is not written.
// Bag 14 is 2048 words of rows. Bag 27 is 4096 words of points.
// Bag 28 is 32768 words of predecessors. At most 60 stations.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Num

// Free the unify scratch. Bag 28 must not alias bag 14.
Function.CA_LoftArcFree {
    Output: Integer
    Body: {
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 14)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: {
            Deallocate(CadAppPick.ax, 2048)
            ArraySet(CadAppPick.quiet, 14, 0)
        }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 27)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: {
            Deallocate(CadAppPick.ax, 4096)
            ArraySet(CadAppPick.quiet, 27, 0)
        }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 28)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: {
            Deallocate(CadAppPick.ax, 32768)
            ArraySet(CadAppPick.quiet, 28, 0)
        }
        ReturnValue(0)
    }
}

// Copy ring bag[13], count bag[5], into point bag[27] at word base bag[6].
Function.CA_LoftArcCopy {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        ArraySet(CadAppPick.hv, 244, 0)
        CadAppPick.pins = 0
        CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
        WhileLoop LessThan(CadAppPick.pins, CadAppPick.prof_nn) {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            ArraySet(CadAppPick.hv, 244, CadAppPick.pins)
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            CA_LoftLoad3()
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 244)
            CadAppPick.pins = Multiply(CadAppPick.pins, 3)
            CadAppPick.by = ArrayGet(CadAppPick.quiet, 6)
            CadAppPick.pins = Add(CadAppPick.pins, CadAppPick.by)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 27)
            ArraySet(CadAppPick.hv, CadAppPick.pins, CadAppPick.clk_x)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 27)
            ArraySet(CadAppPick.hv, CadAppPick.pins, CadAppPick.clk_y)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 27)
            ArraySet(CadAppPick.hv, CadAppPick.pins, CadAppPick.hit_a)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 244)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
        }
        ReturnValue(0)
    }
}

// Squared distance. Long index bag[6], short index bag[8].
// Rotations are scratch 252 and 253. Counts are scratch 250 and 251.
// Result is bag[22].
Function.CA_LoftArcD2 {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 252)
        CadAppPick.by = ArrayGet(CadAppPick.quiet, 6)
        CadAppPick.pins = Add(CadAppPick.pins, CadAppPick.by)
        CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 250)
        CadAppPick.found_n = 0
        IfCondition GreaterEqual(CadAppPick.pins, CadAppPick.prof_nn) ThenBlock: {
            CadAppPick.found_n = 1
        }
        IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 250)
            CadAppPick.pins = Subtract(CadAppPick.pins, CadAppPick.prof_nn)
        }
        CadAppPick.pins = Multiply(CadAppPick.pins, 3)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 27)
        CadAppPick.clk_x = ArrayGet(CadAppPick.hv, CadAppPick.pins)
        CadAppPick.pins = Add(CadAppPick.pins, 1)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 27)
        CadAppPick.clk_y = ArrayGet(CadAppPick.hv, CadAppPick.pins)
        CadAppPick.pins = Add(CadAppPick.pins, 1)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 27)
        CadAppPick.hit_a = ArrayGet(CadAppPick.hv, CadAppPick.pins)
        ArraySet(CadAppPick.quiet, 15, CadAppPick.clk_x)
        ArraySet(CadAppPick.quiet, 12, CadAppPick.clk_y)
        ArraySet(CadAppPick.quiet, 21, CadAppPick.hit_a)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 253)
        CadAppPick.by = ArrayGet(CadAppPick.quiet, 8)
        CadAppPick.pins = Add(CadAppPick.pins, CadAppPick.by)
        CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 251)
        CadAppPick.found_n = 0
        IfCondition GreaterEqual(CadAppPick.pins, CadAppPick.prof_nn) ThenBlock: {
            CadAppPick.found_n = 1
        }
        IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 251)
            CadAppPick.pins = Subtract(CadAppPick.pins, CadAppPick.prof_nn)
        }
        CadAppPick.pins = Multiply(CadAppPick.pins, 3)
        CadAppPick.pins = Add(CadAppPick.pins, 256)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 27)
        CadAppPick.clk_x = ArrayGet(CadAppPick.hv, CadAppPick.pins)
        CadAppPick.pins = Add(CadAppPick.pins, 1)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 27)
        CadAppPick.clk_y = ArrayGet(CadAppPick.hv, CadAppPick.pins)
        CadAppPick.pins = Add(CadAppPick.pins, 1)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 27)
        CadAppPick.hit_a = ArrayGet(CadAppPick.hv, CadAppPick.pins)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 15)
        CadAppPick.ax = Float_Sub(CadAppPick.clk_x, CadAppPick.ay)
        CadAppPick.ax = Float_Mul(CadAppPick.ax, CadAppPick.ax)
        CadAppPick.bx = CadAppPick.ax
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 12)
        CadAppPick.ax = Float_Sub(CadAppPick.clk_y, CadAppPick.ay)
        CadAppPick.ax = Float_Mul(CadAppPick.ax, CadAppPick.ax)
        CadAppPick.bx = Float_Add(CadAppPick.bx, CadAppPick.ax)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 21)
        CadAppPick.ax = Float_Sub(CadAppPick.hit_a, CadAppPick.ay)
        CadAppPick.ax = Float_Mul(CadAppPick.ax, CadAppPick.ax)
        CadAppPick.ax = Float_Add(CadAppPick.bx, CadAppPick.ax)
        ArraySet(CadAppPick.quiet, 22, CadAppPick.ax)
        ReturnValue(0)
    }
}

// Zero 61 flags on the scratch row whose base is bag[11].
Function.CA_LoftArcClear {
    Output: Integer
    Body: {
        ArraySet(CadAppPick.quiet, 8, 0)
        CadAppPick.pins = 0
        CadAppPick.prof_nn = 61
        WhileLoop LessThan(CadAppPick.pins, CadAppPick.prof_nn) {
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.by = ArrayGet(CadAppPick.quiet, 11)
            CadAppPick.by = Add(CadAppPick.by, CadAppPick.pins)
            ArraySet(CadAppPick.hv, CadAppPick.by, 0)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 8)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
        }
        ReturnValue(0)
    }
}

// One DP cell. Scratch 244 is i, 245 is k. Both are 1-based.
Function.CA_LoftArcCell {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 245)
        CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 244)
        CadAppPick.found_n = 0
        IfCondition GreaterThan(CadAppPick.pins, CadAppPick.prof_nn) ThenBlock: {
            CadAppPick.found_n = 1
        }
        IfCondition EqualTo(CadAppPick.found_n, 0) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, 250)
            CadAppPick.ay = ArrayGet(CadAppPick.hv, 244)
            CadAppPick.ax = Subtract(CadAppPick.ax, CadAppPick.ay)
            CadAppPick.bx = ArrayGet(CadAppPick.hv, 251)
            CadAppPick.by = ArrayGet(CadAppPick.hv, 245)
            CadAppPick.bx = Subtract(CadAppPick.bx, CadAppPick.by)
            IfCondition LessThan(CadAppPick.ax, CadAppPick.bx) ThenBlock: {
                CadAppPick.found_n = 1
            }
        }
        IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 245)
            CadAppPick.pins = Add(CadAppPick.pins, 183)
            ArraySet(CadAppPick.hv, CadAppPick.pins, 0)
            ReturnValue(0)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 244)
        CadAppPick.pins = Subtract(CadAppPick.pins, 1)
        ArraySet(CadAppPick.quiet, 6, CadAppPick.pins)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 245)
        CadAppPick.pins = Subtract(CadAppPick.pins, 1)
        ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
        CA_LoftArcD2()
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 22)
        ArraySet(CadAppPick.quiet, 15, CadAppPick.ax)
        CadAppPick.found_n = 0
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 245)
        CadAppPick.pins = Add(CadAppPick.pins, 122)
        CadAppPick.hit_i = ArrayGet(CadAppPick.hv, CadAppPick.pins)
        IfCondition EqualTo(CadAppPick.hit_i, 1) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 245)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 244)
            CadAppPick.prof_nn = Subtract(CadAppPick.prof_nn, 1)
            CadAppPick.hu = 0
            IfCondition LessEqual(CadAppPick.pins, CadAppPick.prof_nn) ThenBlock: {
                CadAppPick.hu = 1
            }
            IfCondition EqualTo(CadAppPick.hu, 1) ThenBlock: {
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
                CadAppPick.ax = ArrayGet(CadAppPick.hv, 250)
                CadAppPick.ay = ArrayGet(CadAppPick.hv, 244)
                CadAppPick.ay = Subtract(CadAppPick.ay, 1)
                CadAppPick.ax = Subtract(CadAppPick.ax, CadAppPick.ay)
                CadAppPick.bx = ArrayGet(CadAppPick.hv, 251)
                CadAppPick.by = ArrayGet(CadAppPick.hv, 245)
                CadAppPick.bx = Subtract(CadAppPick.bx, CadAppPick.by)
                IfCondition GreaterEqual(CadAppPick.ax, CadAppPick.bx) ThenBlock: {
                    CadAppPick.found_n = 1
                }
            }
        }
        IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 245)
            CadAppPick.clk_x = ArrayGet(CadAppPick.hv, CadAppPick.pins)
            CadAppPick.clk_y = ArrayGet(CadAppPick.quiet, 15)
            CadAppPick.clk_x = Float_Add(CadAppPick.clk_x, CadAppPick.clk_y)
            ArraySet(CadAppPick.quiet, 12, CadAppPick.clk_x)
        }
        CadAppPick.hit_i = 0
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 245)
        IfCondition GreaterEqual(CadAppPick.pins, 2) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 245)
            CadAppPick.pins = Subtract(CadAppPick.pins, 1)
            CadAppPick.pins = Add(CadAppPick.pins, 122)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, CadAppPick.pins)
            IfCondition EqualTo(CadAppPick.prof_nn, 1) ThenBlock: {
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
                CadAppPick.pins = ArrayGet(CadAppPick.hv, 245)
                CadAppPick.pins = Subtract(CadAppPick.pins, 1)
                CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 244)
                CadAppPick.prof_nn = Subtract(CadAppPick.prof_nn, 1)
                CadAppPick.hu = 0
                IfCondition LessEqual(CadAppPick.pins, CadAppPick.prof_nn) ThenBlock: {
                    CadAppPick.hu = 1
                }
                IfCondition EqualTo(CadAppPick.hu, 1) ThenBlock: {
                    CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
                    CadAppPick.ax = ArrayGet(CadAppPick.hv, 250)
                    CadAppPick.ay = ArrayGet(CadAppPick.hv, 244)
                    CadAppPick.ay = Subtract(CadAppPick.ay, 1)
                    CadAppPick.ax = Subtract(CadAppPick.ax, CadAppPick.ay)
                    CadAppPick.bx = ArrayGet(CadAppPick.hv, 251)
                    CadAppPick.by = ArrayGet(CadAppPick.hv, 245)
                    CadAppPick.by = Subtract(CadAppPick.by, 1)
                    CadAppPick.bx = Subtract(CadAppPick.bx, CadAppPick.by)
                    IfCondition GreaterEqual(CadAppPick.ax, CadAppPick.bx) ThenBlock: {
                        CadAppPick.hit_i = 1
                    }
                }
            }
        }
        IfCondition EqualTo(CadAppPick.hit_i, 1) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 245)
            CadAppPick.pins = Subtract(CadAppPick.pins, 1)
            CadAppPick.clk_x = ArrayGet(CadAppPick.hv, CadAppPick.pins)
            CadAppPick.clk_y = ArrayGet(CadAppPick.quiet, 15)
            CadAppPick.clk_x = Float_Add(CadAppPick.clk_x, CadAppPick.clk_y)
            ArraySet(CadAppPick.quiet, 21, CadAppPick.clk_x)
        }
        CadAppPick.hu = 2
        IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
            CadAppPick.hu = 0
        }
        IfCondition EqualTo(CadAppPick.hit_i, 1) ThenBlock: {
            IfCondition EqualTo(CadAppPick.found_n, 0) ThenBlock: {
                CadAppPick.hu = 1
            }
            IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                CadAppPick.ax = ArrayGet(CadAppPick.quiet, 21)
                CadAppPick.ay = ArrayGet(CadAppPick.quiet, 12)
                CadAppPick.bx = Float_Le(CadAppPick.ax, CadAppPick.ay)
                IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: {
                    CadAppPick.hu = 1
                }
            }
        }
        IfCondition EqualTo(CadAppPick.hu, 2) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 245)
            CadAppPick.pins = Add(CadAppPick.pins, 183)
            ArraySet(CadAppPick.hv, CadAppPick.pins, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(CadAppPick.hu, 0) ThenBlock: {
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 12)
        }
        IfCondition EqualTo(CadAppPick.hu, 1) ThenBlock: {
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 21)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 245)
        CadAppPick.pins = Add(CadAppPick.pins, 61)
        ArraySet(CadAppPick.hv, CadAppPick.pins, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 245)
        CadAppPick.pins = Add(CadAppPick.pins, 183)
        ArraySet(CadAppPick.hv, CadAppPick.pins, 1)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 244)
        CadAppPick.pins = Multiply(CadAppPick.pins, 61)
        CadAppPick.by = ArrayGet(CadAppPick.hv, 245)
        CadAppPick.pins = Add(CadAppPick.pins, CadAppPick.by)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 28)
        ArraySet(CadAppPick.ay, CadAppPick.pins, CadAppPick.hu)
        ReturnValue(0)
    }
}

// Copy the current DP row onto the previous row.
Function.CA_LoftArcFlip {
    Output: Integer
    Body: {
        ArraySet(CadAppPick.quiet, 8, 0)
        CadAppPick.pins = 0
        CadAppPick.prof_nn = 61
        WhileLoop LessThan(CadAppPick.pins, CadAppPick.prof_nn) {
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.by = ArrayGet(CadAppPick.quiet, 8)
            CadAppPick.by = Add(CadAppPick.by, 61)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, CadAppPick.by)
            CadAppPick.by = ArrayGet(CadAppPick.quiet, 8)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            ArraySet(CadAppPick.hv, CadAppPick.by, CadAppPick.ax)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 8)
            CadAppPick.by = Add(CadAppPick.pins, 183)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, CadAppPick.by)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 8)
            CadAppPick.by = Add(CadAppPick.pins, 122)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            ArraySet(CadAppPick.hv, CadAppPick.by, CadAppPick.ax)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 8)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
        }
        ReturnValue(0)
    }
}

// DP for rotations already in scratch 252 and 253.
// Finite flag comes back in bag[11]. Cost comes back in bag[22].
Function.CA_LoftArcDp {
    Output: Integer
    Body: {
        ArraySet(CadAppPick.quiet, 11, 122)
        CA_LoftArcClear()
        ArraySet(CadAppPick.quiet, 6, 0)
        ArraySet(CadAppPick.quiet, 8, 0)
        CA_LoftArcD2()
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 22)
        ArraySet(CadAppPick.hv, 1, CadAppPick.ax)
        ArraySet(CadAppPick.hv, 123, 1)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        ArraySet(CadAppPick.hv, 244, 2)
        CadAppPick.pins = 2
        CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 250)
        WhileLoop LessEqual(CadAppPick.pins, CadAppPick.prof_nn) {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            ArraySet(CadAppPick.hv, 244, CadAppPick.pins)
            ArraySet(CadAppPick.quiet, 11, 183)
            CA_LoftArcClear()
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            ArraySet(CadAppPick.hv, 245, 1)
            CadAppPick.pins = 1
            CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 251)
            WhileLoop LessEqual(CadAppPick.pins, CadAppPick.prof_nn) {
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
                ArraySet(CadAppPick.hv, 245, CadAppPick.pins)
                CA_LoftArcCell()
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
                CadAppPick.pins = ArrayGet(CadAppPick.hv, 245)
                CadAppPick.pins = Add(CadAppPick.pins, 1)
                CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 251)
            }
            CA_LoftArcFlip()
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 244)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 250)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 251)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, CadAppPick.pins)
        ArraySet(CadAppPick.quiet, 22, CadAppPick.ax)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 251)
        CadAppPick.pins = Add(CadAppPick.pins, 122)
        CadAppPick.hit_i = ArrayGet(CadAppPick.hv, CadAppPick.pins)
        ArraySet(CadAppPick.quiet, 11, CadAppPick.hit_i)
        ReturnValue(0)
    }
}

// Walk the winning predecessor table into assign slots 3800 and up.
Function.CA_LoftArcWalk {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 250)
        ArraySet(CadAppPick.hv, 244, CadAppPick.pins)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 251)
        ArraySet(CadAppPick.hv, 245, CadAppPick.pins)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 244)
        WhileLoop GreaterEqual(CadAppPick.pins, 1) {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 244)
            CadAppPick.pins = Subtract(CadAppPick.pins, 1)
            ArraySet(CadAppPick.quiet, 6, CadAppPick.pins)
            CadAppPick.by = ArrayGet(CadAppPick.hv, 245)
            CadAppPick.by = Subtract(CadAppPick.by, 1)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
            CadAppPick.pins = Add(CadAppPick.pins, 3800)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 28)
            ArraySet(CadAppPick.ay, CadAppPick.pins, CadAppPick.by)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 244)
            IfCondition GreaterThan(CadAppPick.pins, 1) ThenBlock: {
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
                CadAppPick.pins = ArrayGet(CadAppPick.hv, 244)
                CadAppPick.pins = Multiply(CadAppPick.pins, 61)
                CadAppPick.by = ArrayGet(CadAppPick.hv, 245)
                CadAppPick.pins = Add(CadAppPick.pins, CadAppPick.by)
                CadAppPick.ay = ArrayGet(CadAppPick.quiet, 28)
                CadAppPick.ax = ArrayGet(CadAppPick.ay, CadAppPick.pins)
                IfCondition EqualTo(CadAppPick.ax, 1) ThenBlock: {
                    CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
                    CadAppPick.pins = ArrayGet(CadAppPick.hv, 245)
                    CadAppPick.pins = Subtract(CadAppPick.pins, 1)
                    ArraySet(CadAppPick.hv, 245, CadAppPick.pins)
                }
            }
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 244)
            CadAppPick.pins = Subtract(CadAppPick.pins, 1)
            ArraySet(CadAppPick.hv, 244, CadAppPick.pins)
        }
        ReturnValue(0)
    }
}

// Copy one stored vertex onto a ring. Source vertex bag[6], word base bag[25].
// Destination ring bag[13], destination vertex bag[11].
Function.CA_LoftArcXfer {
    Output: Integer
    Body: {
        CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
        CadAppPick.pins = Multiply(CadAppPick.pins, 3)
        CadAppPick.by = ArrayGet(CadAppPick.quiet, 25)
        CadAppPick.pins = Add(CadAppPick.pins, CadAppPick.by)
        ArraySet(CadAppPick.quiet, 12, CadAppPick.pins)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 27)
        CadAppPick.clk_x = ArrayGet(CadAppPick.hv, CadAppPick.pins)
        CadAppPick.pins = ArrayGet(CadAppPick.quiet, 12)
        CadAppPick.pins = Add(CadAppPick.pins, 1)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 27)
        CadAppPick.clk_y = ArrayGet(CadAppPick.hv, CadAppPick.pins)
        CadAppPick.pins = ArrayGet(CadAppPick.quiet, 12)
        CadAppPick.pins = Add(CadAppPick.pins, 2)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 27)
        CadAppPick.hit_a = ArrayGet(CadAppPick.hv, CadAppPick.pins)
        CadAppPick.pins = ArrayGet(CadAppPick.quiet, 11)
        ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
        CA_LoftStore3()
        ReturnValue(0)
    }
}

// Spin so station 0 is a real short edge, then write both rings.
Function.CA_LoftArcEmit {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        ArraySet(CadAppPick.hv, 249, 0)
        ArraySet(CadAppPick.quiet, 8, 0)
        CadAppPick.pins = 0
        CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 250)
        WhileLoop LessThan(CadAppPick.pins, CadAppPick.prof_nn) {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            ArraySet(CadAppPick.hv, 244, CadAppPick.pins)
            CadAppPick.by = Add(CadAppPick.pins, 3800)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 28)
            CadAppPick.ax = ArrayGet(CadAppPick.ay, CadAppPick.by)
            ArraySet(CadAppPick.quiet, 15, CadAppPick.ax)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 244)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 250)
            CadAppPick.found_n = 0
            IfCondition GreaterEqual(CadAppPick.pins, CadAppPick.prof_nn) ThenBlock: {
                CadAppPick.found_n = 1
            }
            IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                CadAppPick.pins = 0
            }
            CadAppPick.by = Add(CadAppPick.pins, 3800)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 28)
            CadAppPick.ay = ArrayGet(CadAppPick.ay, CadAppPick.by)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 15)
            CadAppPick.hit_i = ArrayGet(CadAppPick.quiet, 8)
            IfCondition EqualTo(CadAppPick.hit_i, 0) ThenBlock: {
                IfCondition NotEqual(CadAppPick.ax, CadAppPick.ay) ThenBlock: {
                    CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
                    CadAppPick.pins = ArrayGet(CadAppPick.hv, 244)
                    ArraySet(CadAppPick.hv, 249, CadAppPick.pins)
                    ArraySet(CadAppPick.quiet, 8, 1)
                }
            }
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 244)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 250)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 254)
        IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: {
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 3)
            ArraySet(CadAppPick.quiet, 20, CadAppPick.ax)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 4)
            ArraySet(CadAppPick.quiet, 21, CadAppPick.ax)
        }
        IfCondition EqualTo(CadAppPick.pins, 0) ThenBlock: {
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 4)
            ArraySet(CadAppPick.quiet, 20, CadAppPick.ax)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 3)
            ArraySet(CadAppPick.quiet, 21, CadAppPick.ax)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        ArraySet(CadAppPick.hv, 244, 0)
        CadAppPick.pins = 0
        CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 250)
        WhileLoop LessThan(CadAppPick.pins, CadAppPick.prof_nn) {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            ArraySet(CadAppPick.hv, 244, CadAppPick.pins)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 249)
            CadAppPick.by = ArrayGet(CadAppPick.hv, 244)
            CadAppPick.pins = Add(CadAppPick.pins, CadAppPick.by)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 250)
            CadAppPick.found_n = 0
            IfCondition GreaterEqual(CadAppPick.pins, CadAppPick.prof_nn) ThenBlock: {
                CadAppPick.found_n = 1
            }
            IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
                CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 250)
                CadAppPick.pins = Subtract(CadAppPick.pins, CadAppPick.prof_nn)
            }
            ArraySet(CadAppPick.quiet, 19, CadAppPick.pins)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.by = ArrayGet(CadAppPick.hv, 252)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 19)
            CadAppPick.pins = Add(CadAppPick.pins, CadAppPick.by)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 250)
            CadAppPick.found_n = 0
            IfCondition GreaterEqual(CadAppPick.pins, CadAppPick.prof_nn) ThenBlock: {
                CadAppPick.found_n = 1
            }
            IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
                CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 250)
                CadAppPick.pins = Subtract(CadAppPick.pins, CadAppPick.prof_nn)
            }
            ArraySet(CadAppPick.quiet, 6, CadAppPick.pins)
            ArraySet(CadAppPick.quiet, 25, 0)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 244)
            ArraySet(CadAppPick.quiet, 11, CadAppPick.pins)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 20)
            ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
            CA_LoftArcXfer()
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 19)
            CadAppPick.pins = Add(CadAppPick.pins, 3800)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 28)
            CadAppPick.ax = ArrayGet(CadAppPick.ay, CadAppPick.pins)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.by = ArrayGet(CadAppPick.hv, 253)
            CadAppPick.ax = Add(CadAppPick.ax, CadAppPick.by)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 251)
            CadAppPick.found_n = 0
            IfCondition GreaterEqual(CadAppPick.ax, CadAppPick.prof_nn) ThenBlock: {
                CadAppPick.found_n = 1
            }
            IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
                CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 251)
                CadAppPick.ax = Subtract(CadAppPick.ax, CadAppPick.prof_nn)
            }
            ArraySet(CadAppPick.quiet, 6, CadAppPick.ax)
            ArraySet(CadAppPick.quiet, 25, 256)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 244)
            ArraySet(CadAppPick.quiet, 11, CadAppPick.pins)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 21)
            ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
            CA_LoftArcXfer()
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 244)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 250)
        }
        ReturnValue(0)
    }
}

// Match unequal closed rings. 1 on success. Does not write bag 7.
Function.CA_LoftArcUnify {
    Output: Integer
    Body: {
        ArraySet(CadAppPick.quiet, 14, 0)
        ArraySet(CadAppPick.quiet, 27, 0)
        ArraySet(CadAppPick.quiet, 28, 0)
        CadAppPick.ax = Allocate(2048)
        ArraySet(CadAppPick.quiet, 14, CadAppPick.ax)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            CA_LoftArcFree()
            ReturnValue(0)
        }
        CadAppPick.ax = Allocate(4096)
        ArraySet(CadAppPick.quiet, 27, CadAppPick.ax)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            CA_LoftArcFree()
            ReturnValue(0)
        }
        CadAppPick.ax = Allocate(32768)
        ArraySet(CadAppPick.quiet, 28, CadAppPick.ax)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            CA_LoftArcFree()
            ReturnValue(0)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 0)
        CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 1)
        CadAppPick.found_n = 0
        IfCondition LessThan(CadAppPick.pins, 3) ThenBlock: { CadAppPick.found_n = 1 }
        IfCondition GreaterThan(CadAppPick.pins, 60) ThenBlock: { CadAppPick.found_n = 1 }
        IfCondition LessThan(CadAppPick.prof_nn, 3) ThenBlock: { CadAppPick.found_n = 1 }
        IfCondition GreaterThan(CadAppPick.prof_nn, 60) ThenBlock: { CadAppPick.found_n = 1 }
        IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
            CA_LoftArcFree()
            ReturnValue(0)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 0)
        CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 1)
        IfCondition GreaterEqual(CadAppPick.pins, CadAppPick.prof_nn) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 0)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 1)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            ArraySet(CadAppPick.hv, 250, CadAppPick.pins)
            ArraySet(CadAppPick.hv, 251, CadAppPick.prof_nn)
            ArraySet(CadAppPick.hv, 254, 1)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 3)
            ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
            ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
            ArraySet(CadAppPick.quiet, 6, 0)
            CA_LoftArcCopy()
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 251)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 4)
            ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
            ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
            ArraySet(CadAppPick.quiet, 6, 256)
            CA_LoftArcCopy()
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 0)
        CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 1)
        IfCondition LessThan(CadAppPick.pins, CadAppPick.prof_nn) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 0)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 1)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            ArraySet(CadAppPick.hv, 250, CadAppPick.prof_nn)
            ArraySet(CadAppPick.hv, 251, CadAppPick.pins)
            ArraySet(CadAppPick.hv, 254, 0)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 4)
            ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
            ArraySet(CadAppPick.quiet, 5, CadAppPick.prof_nn)
            ArraySet(CadAppPick.quiet, 6, 0)
            CA_LoftArcCopy()
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 251)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 3)
            ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
            ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
            ArraySet(CadAppPick.quiet, 6, 256)
            CA_LoftArcCopy()
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        ArraySet(CadAppPick.hv, 249, 0)
        ArraySet(CadAppPick.quiet, 26, 0)
        CadAppPick.pins = 0
        CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 250)
        WhileLoop LessThan(CadAppPick.pins, CadAppPick.prof_nn) {
            ArraySet(CadAppPick.quiet, 26, CadAppPick.pins)
            ArraySet(CadAppPick.quiet, 19, 0)
            CadAppPick.pins = 0
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 251)
            WhileLoop LessThan(CadAppPick.pins, CadAppPick.prof_nn) {
                ArraySet(CadAppPick.quiet, 19, CadAppPick.pins)
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
                CadAppPick.ax = ArrayGet(CadAppPick.quiet, 26)
                ArraySet(CadAppPick.hv, 252, CadAppPick.ax)
                CadAppPick.ax = ArrayGet(CadAppPick.quiet, 19)
                ArraySet(CadAppPick.hv, 253, CadAppPick.ax)
                CA_LoftArcDp()
                CadAppPick.pins = ArrayGet(CadAppPick.quiet, 11)
                IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: {
                    CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
                    CadAppPick.found_n = ArrayGet(CadAppPick.hv, 249)
                    CadAppPick.hit_i = 0
                    IfCondition EqualTo(CadAppPick.found_n, 0) ThenBlock: {
                        CadAppPick.hit_i = 1
                    }
                    IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 22)
                        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
                        CadAppPick.ay = ArrayGet(CadAppPick.hv, 248)
                        CadAppPick.bx = Float_Le(CadAppPick.ax, CadAppPick.ay)
                        IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: {
                            CadAppPick.hit_i = 1
                        }
                    }
                    IfCondition EqualTo(CadAppPick.hit_i, 1) ThenBlock: {
                        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
                        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 22)
                        ArraySet(CadAppPick.hv, 248, CadAppPick.ax)
                        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 26)
                        ArraySet(CadAppPick.hv, 246, CadAppPick.ax)
                        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 19)
                        ArraySet(CadAppPick.hv, 247, CadAppPick.ax)
                        ArraySet(CadAppPick.hv, 249, 1)
                    }
                }
                CadAppPick.pins = ArrayGet(CadAppPick.quiet, 19)
                CadAppPick.pins = Add(CadAppPick.pins, 1)
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
                CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 251)
            }
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 26)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.hv, 250)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 249)
        IfCondition EqualTo(CadAppPick.pins, 0) ThenBlock: {
            CA_LoftArcFree()
            ReturnValue(0)
        }
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 246)
        ArraySet(CadAppPick.hv, 252, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 247)
        ArraySet(CadAppPick.hv, 253, CadAppPick.ax)
        CA_LoftArcDp()
        CadAppPick.pins = ArrayGet(CadAppPick.quiet, 11)
        IfCondition EqualTo(CadAppPick.pins, 0) ThenBlock: {
            CA_LoftArcFree()
            ReturnValue(0)
        }
        CA_LoftArcWalk()
        CA_LoftArcEmit()
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 250)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 9)
        ArraySet(CadAppPick.ay, 0, CadAppPick.pins)
        ArraySet(CadAppPick.ay, 1, CadAppPick.pins)
        ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
        CA_LoftArcFree()
        ReturnValue(1)
    }
}
