// Loft NEW or CUT. CUT subtracts the loft from the body that is already there.
// The punch is the same Difference the extrude cut uses. A miss keeps the body.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Bool

FixedPool.CAD_LoftCut {
    "host": Initialize=0, CanChange=True
    "tool": Initialize=0, CanChange=True
    "op": Initialize=0, CanChange=True
}

// 1 installs the loft. 0 leaves the host and the caller must not add a row.
Function.CA_LoftApply {
    Output: Integer
    Body: {
        CAD_LoftCut.tool = CadAppPick.hit_i
        CAD_LoftCut.host = CadApp.solid
        CAD_LoftCut.op = 0
        IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: {
            IfCondition NotEqual(CAD_LoftCut.host, 0) ThenBlock: { CAD_LoftCut.op = 1 }
        }
        IfCondition EqualTo(CAD_LoftCut.op, 0) ThenBlock: {
            CadApp.solid = CAD_LoftCut.tool
            CAD_Topo.RebuildKind0Planes(CadApp.solid)
            ReturnValue(1)
        }
        CAD_Topo.RebuildKind0Planes(CAD_LoftCut.tool)
        CAD_LoftCut.host = CAD_Bool.Difference(CAD_LoftCut.host, CAD_LoftCut.tool)
        IfCondition EqualTo(CAD_LoftCut.host, 0) ThenBlock: {
            CA_Log("cad_app: CUT no B-Rep difference — host kept\n", 47)
            CA_Notify("cad_app: CUT refused, host unchanged\n", 37)
            ReturnValue(0)
        }
        CadApp.solid = CAD_LoftCut.host
        CAD_Topo.RebuildKind0Planes(CadApp.solid)
        ReturnValue(1)
    }
}

// Loft pick. No body: stay NEW. A body toggles NEW and CUT.
Function.CA_LoftTab {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CadApp.extrude_op = 2
        }
        IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
            CAD_LoftCut.op = 1
            IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: { CAD_LoftCut.op = 2 }
            CadApp.extrude_op = CAD_LoftCut.op
        }
        CA_LogInt("cad_app: loft op=", 17, CadApp.extrude_op)
        IfCondition EqualTo(CadApp.replay, 0) ThenBlock: { CA_PublishFrame() }
        ReturnValue(0)
    }
}
