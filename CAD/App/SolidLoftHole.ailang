// A smaller closed profile inside a loft end is the hole.
// The outer rings build the body. The inner rings build a second loft,
// and that loft is punched out. One hole on an end. The other end, when
// it has no inner ring, gets that hole scaled about its own centroid.
// A circle hole stays a circle. An ngon hole stays a polygon.
// An island inside the hole stays void.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_BSpline
LibraryImport.Cad.CAD_Bool

// Drop the sampling rings so a second build can allocate them again.
Function.CA_LoftDropRings {
    Output: Integer
    Body: {
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 23)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: {
            CAD_BSpline.FreeRing(CadAppPick.ax)
            Deallocate(CadAppPick.ax, 64)
            ArraySet(CadAppPick.quiet, 23, 0)
        }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 24)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: {
            CAD_BSpline.FreeRing(CadAppPick.ax)
            Deallocate(CadAppPick.ax, 64)
            ArraySet(CadAppPick.quiet, 24, 0)
        }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 29)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: {
            CAD_BSpline.FreeRuled(CadAppPick.ax)
            Deallocate(CadAppPick.ax, 128)
            ArraySet(CadAppPick.quiet, 29, 0)
        }
        ReturnValue(0)
    }
}

// Build the loft whose profile indices are bag[16] and bag[17].
// 0 and bag[8] = 1 corner, 2 span, 3 other. The solid stays in hit_i.
Function.CA_LoftMakeSolid {
    Output: Integer
    Body: {
        CA_LoftDropRings()
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 1)
        ArraySet(CadAppPick.quiet, 7, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 16)
        ArraySet(CadAppPick.quiet, 11, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 3)
        ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
        CadAppPick.ax = CA_LoftMapRing()
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            ArraySet(CadAppPick.quiet, 8, 1)
            ReturnValue(0)
        }
        ArraySet(CadAppPick.quiet, 6, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 2)
        ArraySet(CadAppPick.quiet, 7, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 17)
        ArraySet(CadAppPick.quiet, 11, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 4)
        ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
        CadAppPick.ax = CA_LoftMapRing()
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            ArraySet(CadAppPick.quiet, 8, 1)
            ReturnValue(0)
        }
        ArraySet(CadAppPick.quiet, 12, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 6)
        ArraySet(CadAppPick.hv, 0, CadAppPick.ay)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 12)
        ArraySet(CadAppPick.hv, 1, CadAppPick.ay)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 16)
        ArraySet(CadAppPick.quiet, 28, CadAppPick.ax)
        CA_LoftOrientPair()
        CadAppPick.ax = CA_LoftCircReady()
        CadAppPick.hit_i = 0
        IfCondition EqualTo(CadAppPick.ax, 1) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 3)
            CadAppPick.hu = ArrayGet(CadAppPick.quiet, 4)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 5)
            CadAppPick.bx = ArrayGet(CadAppPick.quiet, 10)
            CadAppPick.by = ArrayGet(CadAppPick.quiet, 30)
            CadAppPick.hit_i = CAD_Topo.MakeRuledSolidCircle(CadAppPick.hv, CadAppPick.hu, CadAppPick.pins, CadAppPick.bx, CadAppPick.by)
        }
        IfCondition EqualTo(CadAppPick.hit_i, 0) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, 0)
            CadAppPick.ay = ArrayGet(CadAppPick.hv, 1)
            ArraySet(CadAppPick.quiet, 7, 0)
            IfCondition NotEqual(CadAppPick.ax, CadAppPick.ay) ThenBlock: {
                ArraySet(CadAppPick.quiet, 7, 1)
                CadAppPick.ax = CA_LoftResample()
                IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
                    ArraySet(CadAppPick.quiet, 8, 1)
                    ReturnValue(0)
                }
            }
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 7)
            IfCondition EqualTo(CadAppPick.pins, 0) ThenBlock: {
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
                CadAppPick.ax = ArrayGet(CadAppPick.hv, 0)
                ArraySet(CadAppPick.quiet, 5, CadAppPick.ax)
                CA_LoftAlign()
            }
            CadAppPick.ax = CA_LoftSpan()
            IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
                ArraySet(CadAppPick.quiet, 8, 2)
                ReturnValue(0)
            }
            CadAppPick.ax = Allocate(64)
            ArraySet(CadAppPick.quiet, 23, CadAppPick.ax)
            IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
                ArraySet(CadAppPick.quiet, 8, 3)
                ReturnValue(0)
            }
            ArraySet(CadAppPick.ax, 2, 0)
            ArraySet(CadAppPick.ax, 3, 0)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 3)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 5)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 23)
            CadAppPick.hit_i = CAD_BSpline.MakeRing(CadAppPick.hv, CadAppPick.pins, CadAppPick.ax)
            IfCondition NotEqual(CadAppPick.hit_i, 0) ThenBlock: {
                ArraySet(CadAppPick.quiet, 8, 3)
                ReturnValue(0)
            }
            CadAppPick.ax = Allocate(64)
            ArraySet(CadAppPick.quiet, 24, CadAppPick.ax)
            IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
                ArraySet(CadAppPick.quiet, 8, 3)
                ReturnValue(0)
            }
            ArraySet(CadAppPick.ax, 2, 0)
            ArraySet(CadAppPick.ax, 3, 0)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 4)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 5)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 24)
            CadAppPick.hit_i = CAD_BSpline.MakeRing(CadAppPick.hv, CadAppPick.pins, CadAppPick.ax)
            IfCondition NotEqual(CadAppPick.hit_i, 0) ThenBlock: {
                ArraySet(CadAppPick.quiet, 8, 3)
                ReturnValue(0)
            }
            CadAppPick.ax = Allocate(128)
            ArraySet(CadAppPick.quiet, 29, CadAppPick.ax)
            IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
                ArraySet(CadAppPick.quiet, 8, 3)
                ReturnValue(0)
            }
            ArraySet(CadAppPick.ax, 4, 0)
            ArraySet(CadAppPick.ax, 7, 0)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 23)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 24)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 29)
            CadAppPick.hit_i = CAD_BSpline.MakeRuled(CadAppPick.hv, CadAppPick.pins, CadAppPick.ax)
            IfCondition NotEqual(CadAppPick.hit_i, 0) ThenBlock: {
                ArraySet(CadAppPick.quiet, 8, 3)
                ReturnValue(0)
            }
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 29)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 5)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 3)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 4)
            CadAppPick.hit_i = CAD_BSpline.SampleRuled(CadAppPick.hv, CadAppPick.pins, CadAppPick.ax, CadAppPick.ay)
            IfCondition NotEqual(CadAppPick.hit_i, 0) ThenBlock: {
                ArraySet(CadAppPick.quiet, 8, 3)
                ReturnValue(0)
            }
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 3)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 4)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 5)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 30)
            CadAppPick.hit_i = CAD_Topo.MakeRuledSolidXYZ(CadAppPick.ax, CadAppPick.ay, CadAppPick.pins, CadAppPick.hv)
            IfCondition EqualTo(CadAppPick.hit_i, 0) ThenBlock: {
                ArraySet(CadAppPick.quiet, 8, 3)
                ReturnValue(0)
            }
        }
        ReturnValue(CadAppPick.hit_i)
    }
}

Function.CA_LoftHoleDrop {
    Output: Integer
    Body: {
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 14)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: {
            Deallocate(CadAppPick.ax, 65536)
            ArraySet(CadAppPick.quiet, 14, 0)
        }
        ReturnValue(0)
    }
}

// Sketch bag[7], outer profile bag[11]. Writes the hole index to bag[8], or -1.
Function.CA_LoftHoleAt {
    Output: Integer
    Body: {
        ArraySet(CadAppPick.quiet, 8, -1)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 7)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        CAD_Sketch.ProfCompile(CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 7)
        CadAppPick.ax = CAD_Sketch.GetProfileCount(CadAppPick.ax)
        ArraySet(CadAppPick.quiet, 25, CadAppPick.ax)
        IfCondition LessThan(CadAppPick.ax, 2) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 11)
        ArraySet(CadAppPick.quiet, 26, CadAppPick.ax)
        CadAppPick.ax = Allocate(65536)
        ArraySet(CadAppPick.quiet, 14, CadAppPick.ax)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 7)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 26)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.ax = CAD_Sketch.GetProfileXY(CadAppPick.ax, CadAppPick.ay, CadAppPick.hv)
        ArraySet(CadAppPick.quiet, 27, CadAppPick.ax)
        IfCondition LessThan(CadAppPick.ax, 3) ThenBlock: {
            CA_LoftHoleDrop()
            ReturnValue(0)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
        CadAppPick.pins = ArrayGet(CadAppPick.quiet, 27)
        CadAppPick.ax = CAD_Sketch.LoopSignedArea(CadAppPick.hv, CadAppPick.pins)
        ArraySet(CadAppPick.quiet, 12, CadAppPick.ax)
        CadAppPick.pins = Float_Le(CadAppPick.ax, 0)
        IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: {
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 12)
            CadAppPick.ax = Float_Sub(0, CadAppPick.ax)
            ArraySet(CadAppPick.quiet, 12, CadAppPick.ax)
        }
        ArraySet(CadAppPick.quiet, 6, 0)
        ArraySet(CadAppPick.quiet, 22, 0)
        WhileLoop LessThan(ArrayGet(CadAppPick.quiet, 6), ArrayGet(CadAppPick.quiet, 25)) {
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
            CadAppPick.bx = ArrayGet(CadAppPick.quiet, 26)
            IfCondition NotEqual(CadAppPick.pins, CadAppPick.bx) ThenBlock: {
                CadAppPick.ax = ArrayGet(CadAppPick.quiet, 7)
                CadAppPick.ay = ArrayGet(CadAppPick.quiet, 6)
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 10)
                CadAppPick.ax = CAD_Sketch.GetProfileXY(CadAppPick.ax, CadAppPick.ay, CadAppPick.hv)
                ArraySet(CadAppPick.quiet, 5, CadAppPick.ax)
                IfCondition GreaterEqual(CadAppPick.ax, 3) ThenBlock: {
                    ArraySet(CadAppPick.quiet, 20, 0)
                    ArraySet(CadAppPick.quiet, 21, 0)
                    ArraySet(CadAppPick.quiet, 28, 0)
                    WhileLoop LessThan(ArrayGet(CadAppPick.quiet, 28), ArrayGet(CadAppPick.quiet, 5)) {
                        CadAppPick.pins = ArrayGet(CadAppPick.quiet, 28)
                        CadAppPick.bx = Multiply(CadAppPick.pins, 2)
                        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 10)
                        CadAppPick.hu = ArrayGet(CadAppPick.hv, CadAppPick.bx)
                        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 20)
                        CadAppPick.ax = Float_Add(CadAppPick.ax, CadAppPick.hu)
                        ArraySet(CadAppPick.quiet, 20, CadAppPick.ax)
                        CadAppPick.pins = ArrayGet(CadAppPick.quiet, 28)
                        CadAppPick.bx = Multiply(CadAppPick.pins, 2)
                        CadAppPick.bx = Add(CadAppPick.bx, 1)
                        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 10)
                        CadAppPick.hu = ArrayGet(CadAppPick.hv, CadAppPick.bx)
                        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 21)
                        CadAppPick.ax = Float_Add(CadAppPick.ax, CadAppPick.hu)
                        ArraySet(CadAppPick.quiet, 21, CadAppPick.ax)
                        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 28)
                        CadAppPick.ax = Add(CadAppPick.ax, 1)
                        ArraySet(CadAppPick.quiet, 28, CadAppPick.ax)
                    }
                    CadAppPick.pins = ArrayGet(CadAppPick.quiet, 5)
                    CadAppPick.clk_x = Float_FromInt(CadAppPick.pins)
                    CadAppPick.ax = ArrayGet(CadAppPick.quiet, 20)
                    CadAppPick.ax = Float_Div(CadAppPick.ax, CadAppPick.clk_x)
                    ArraySet(CadAppPick.quiet, 20, CadAppPick.ax)
                    CadAppPick.ax = ArrayGet(CadAppPick.quiet, 21)
                    CadAppPick.ax = Float_Div(CadAppPick.ax, CadAppPick.clk_x)
                    ArraySet(CadAppPick.quiet, 21, CadAppPick.ax)
                    CadAppPick.hv = ArrayGet(CadAppPick.quiet, 10)
                    CadAppPick.pins = ArrayGet(CadAppPick.quiet, 5)
                    CadAppPick.ax = CAD_Sketch.LoopSignedArea(CadAppPick.hv, CadAppPick.pins)
                    ArraySet(CadAppPick.quiet, 28, CadAppPick.ax)
                    CadAppPick.pins = Float_Le(CadAppPick.ax, 0)
                    IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: {
                        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 28)
                        CadAppPick.ax = Float_Sub(0, CadAppPick.ax)
                        ArraySet(CadAppPick.quiet, 28, CadAppPick.ax)
                    }
                    CadAppPick.ax = ArrayGet(CadAppPick.quiet, 28)
                    CadAppPick.ay = ArrayGet(CadAppPick.quiet, 12)
                    CadAppPick.pins = Float_Le(CadAppPick.ax, CadAppPick.ay)
                    CadAppPick.bx = 0
                    IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: {
                        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 12)
                        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 28)
                        CadAppPick.bx = Float_Le(CadAppPick.ax, CadAppPick.ay)
                        CadAppPick.bx = Subtract(1, CadAppPick.bx)
                    }
                    IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: {
                        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 20)
                        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 21)
                        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 14)
                        CadAppPick.pins = ArrayGet(CadAppPick.quiet, 27)
                        CadAppPick.bx = CA_PointInPoly(CadAppPick.ax, CadAppPick.ay, CadAppPick.hv, CadAppPick.pins)
                    }
                    IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: {
                        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 8)
                        CadAppPick.pins = 0
                        IfCondition LessThan(CadAppPick.ax, 0) ThenBlock: { CadAppPick.pins = 1 }
                        IfCondition EqualTo(CadAppPick.pins, 0) ThenBlock: {
                            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 22)
                            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 28)
                            CadAppPick.pins = Float_Le(CadAppPick.ax, CadAppPick.ay)
                        }
                        IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: {
                            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 6)
                            ArraySet(CadAppPick.quiet, 8, CadAppPick.ax)
                            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 28)
                            ArraySet(CadAppPick.quiet, 22, CadAppPick.ax)
                        }
                    }
                }
            }
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 6)
            CadAppPick.ax = Add(CadAppPick.ax, 1)
            ArraySet(CadAppPick.quiet, 6, CadAppPick.ax)
        }
        CA_LoftHoleDrop()
        ReturnValue(ArrayGet(CadAppPick.quiet, 8))
    }
}

// Scratch pointer is bag[17]. Slots: 0 nA, 1 nB, 2 outer A, 3 outer B,
// 4 inner A, 5 inner B, 6 side, 7 profile, 8 ratio, 9 src, 10 cx, 11 cy,
// 12 cz, 13 i, 14 dst. Restores the outer ring pointers before it frees.
Function.CA_LoftHoleFree {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        IfCondition EqualTo(CadAppPick.hv, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 2)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: {
            ArraySet(CadAppPick.quiet, 3, CadAppPick.ax)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 3)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: {
            ArraySet(CadAppPick.quiet, 4, CadAppPick.ax)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 4)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: {
            Deallocate(CadAppPick.ax, 2048)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 5)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: {
            Deallocate(CadAppPick.ax, 2048)
        }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 0)
        CadApp.sketch = CadAppPick.ax
        ArraySet(CadAppPick.quiet, 13, 0)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        Deallocate(CadAppPick.hv, 128)
        ArraySet(CadAppPick.quiet, 17, 0)
        ReturnValue(0)
    }
}

Function.CA_LoftHoleBail {
    Output: Integer
    Body: {
        CA_LoftHoleFree()
        ReturnValue(0)
    }
}

// Mean distance from the centroid of xyz bag[13], count bag[5], into bag[12].
Function.CA_LoftHoleMean {
    Output: Integer
    Body: {
        CA_LoftCentroid()
        ArraySet(CadAppPick.quiet, 12, 0)
        ArraySet(CadAppPick.quiet, 6, 0)
        CadAppPick.pins = 0
        CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
        WhileLoop LessThan(CadAppPick.pins, CadAppPick.prof_nn) {
            ArraySet(CadAppPick.quiet, 6, CadAppPick.pins)
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            CA_LoftLoad3()
            CadAppPick.ax = CadAppPick.clk_x
            CadAppPick.bx = CadAppPick.clk_y
            CadAppPick.found_n = CadAppPick.hit_a
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 20)
            CadAppPick.ax = Float_Sub(CadAppPick.ax, CadAppPick.ay)
            CadAppPick.ax = Float_Mul(CadAppPick.ax, CadAppPick.ax)
            CadAppPick.by = ArrayGet(CadAppPick.quiet, 21)
            CadAppPick.bx = Float_Sub(CadAppPick.bx, CadAppPick.by)
            CadAppPick.bx = Float_Mul(CadAppPick.bx, CadAppPick.bx)
            CadAppPick.ax = Float_Add(CadAppPick.ax, CadAppPick.bx)
            CadAppPick.by = ArrayGet(CadAppPick.quiet, 22)
            CadAppPick.bx = CadAppPick.found_n
            CadAppPick.bx = Float_Sub(CadAppPick.bx, CadAppPick.by)
            CadAppPick.bx = Float_Mul(CadAppPick.bx, CadAppPick.bx)
            CadAppPick.ax = Float_Add(CadAppPick.ax, CadAppPick.bx)
            CadAppPick.ax = Float_Sqrt(CadAppPick.ax)
            CadAppPick.ay = ArrayGet(CadAppPick.quiet, 12)
            CadAppPick.ax = Float_Add(CadAppPick.ay, CadAppPick.ax)
            ArraySet(CadAppPick.quiet, 12, CadAppPick.ax)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
        }
        CadAppPick.pins = ArrayGet(CadAppPick.quiet, 5)
        CadAppPick.clk_x = Float_FromInt(CadAppPick.pins)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 12)
        CadAppPick.ax = Float_Div(CadAppPick.ax, CadAppPick.clk_x)
        ArraySet(CadAppPick.quiet, 12, CadAppPick.ax)
        ReturnValue(CadAppPick.ax)
    }
}

// One component. Word index bag[6], center bag[12], ratio scratch[8].
Function.CA_LoftHoleScale1 {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.hu = ArrayGet(CadAppPick.hv, 9)
        CadAppPick.by = ArrayGet(CadAppPick.quiet, 6)
        CadAppPick.ax = ArrayGet(CadAppPick.hu, CadAppPick.by)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 12)
        CadAppPick.ax = Float_Sub(CadAppPick.ax, CadAppPick.ay)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.bx = ArrayGet(CadAppPick.hv, 8)
        CadAppPick.ax = Float_Mul(CadAppPick.ax, CadAppPick.bx)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 12)
        CadAppPick.ax = Float_Add(CadAppPick.ay, CadAppPick.ax)
        CadAppPick.hit_a = CadAppPick.ax
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.hu = ArrayGet(CadAppPick.hv, 14)
        CadAppPick.by = ArrayGet(CadAppPick.quiet, 6)
        CadAppPick.ax = CadAppPick.hit_a
        ArraySet(CadAppPick.hu, CadAppPick.by, CadAppPick.ax)
        ReturnValue(0)
    }
}

// Scale scratch[9] about its centroid by scratch[8] into scratch[14].
Function.CA_LoftHoleScale {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 9)
        ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
        CA_LoftCentroid()
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 20)
        ArraySet(CadAppPick.hv, 10, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 21)
        ArraySet(CadAppPick.hv, 11, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 22)
        ArraySet(CadAppPick.hv, 12, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        ArraySet(CadAppPick.hv, 13, 0)
        CadAppPick.pins = 0
        CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
        WhileLoop LessThan(CadAppPick.pins, CadAppPick.prof_nn) {
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.pins = ArrayGet(CadAppPick.quiet, 8)
            ArraySet(CadAppPick.hv, 13, CadAppPick.pins)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 13)
            CadAppPick.by = Multiply(CadAppPick.pins, 3)
            ArraySet(CadAppPick.quiet, 6, CadAppPick.by)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, 10)
            ArraySet(CadAppPick.quiet, 12, CadAppPick.ax)
            CA_LoftHoleScale1()
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 13)
            CadAppPick.by = Multiply(CadAppPick.pins, 3)
            CadAppPick.by = Add(CadAppPick.by, 1)
            ArraySet(CadAppPick.quiet, 6, CadAppPick.by)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, 11)
            ArraySet(CadAppPick.quiet, 12, CadAppPick.ax)
            CA_LoftHoleScale1()
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 13)
            CadAppPick.by = Multiply(CadAppPick.pins, 3)
            CadAppPick.by = Add(CadAppPick.by, 2)
            ArraySet(CadAppPick.quiet, 6, CadAppPick.by)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, 12)
            ArraySet(CadAppPick.quiet, 12, CadAppPick.ax)
            CA_LoftHoleScale1()
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 13)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
        }
        ReturnValue(0)
    }
}

// Wind scratch[14] with scratch[9], then put its seam on that outer's vertex 0.
// Align borrows bag[3] and bag[4]. They are put back before return.
Function.CA_LoftHoleOrient {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 9)
        ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 0)
        ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
        CA_LoftNewell()
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 20)
        ArraySet(CadAppPick.quiet, 11, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 21)
        ArraySet(CadAppPick.quiet, 12, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 22)
        ArraySet(CadAppPick.quiet, 16, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 14)
        ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 0)
        ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
        CA_LoftOrientOne()
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 9)
        ArraySet(CadAppPick.quiet, 3, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 14)
        ArraySet(CadAppPick.quiet, 4, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 0)
        ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
        CA_LoftAlign()
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 2)
        ArraySet(CadAppPick.quiet, 3, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 3)
        ArraySet(CadAppPick.quiet, 4, CadAppPick.ax)
        ReturnValue(0)
    }
}

// Both loft ends are circles. The missing end is the outer circle scaled
// by the hole radius over that end's outer radius. 0 keeps the polygon path.
Function.CA_LoftHoleCirc {
    Output: Integer
    Body: {
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 10)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CadAppPick.ax, 0, 0)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 10)
        ArraySet(CadAppPick.ax, 1, 0)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 1)
        ArraySet(CadAppPick.quiet, 7, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 16)
        ArraySet(CadAppPick.quiet, 11, CadAppPick.ax)
        ArraySet(CadAppPick.quiet, 8, 0)
        CadAppPick.ax = CA_LoftCircOne()
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 10)
        CadAppPick.ay = ArrayGet(CadAppPick.ax, 2)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        ArraySet(CadAppPick.hv, 10, CadAppPick.ay)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 2)
        ArraySet(CadAppPick.quiet, 7, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 18)
        CadAppPick.ax = RightShift(CadAppPick.hv, 24)
        CadAppPick.ax = BitwiseAnd(CadAppPick.ax, 255)
        ArraySet(CadAppPick.quiet, 11, CadAppPick.ax)
        ArraySet(CadAppPick.quiet, 8, 1)
        CadAppPick.ax = CA_LoftCircOne()
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 10)
        CadAppPick.ay = ArrayGet(CadAppPick.ax, 3)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        ArraySet(CadAppPick.hv, 11, CadAppPick.ay)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.bx = ArrayGet(CadAppPick.hv, 6)
        CadAppPick.ay = ArrayGet(CadAppPick.hv, 7)
        IfCondition EqualTo(CadAppPick.bx, 0) ThenBlock: {
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 1)
            ArraySet(CadAppPick.quiet, 7, CadAppPick.ax)
            ArraySet(CadAppPick.quiet, 8, 0)
        }
        IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: {
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 2)
            ArraySet(CadAppPick.quiet, 7, CadAppPick.ax)
            ArraySet(CadAppPick.quiet, 8, 1)
        }
        ArraySet(CadAppPick.quiet, 11, CadAppPick.ay)
        CadAppPick.ax = CA_LoftCircOne()
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.bx = ArrayGet(CadAppPick.hv, 6)
        CadAppPick.by = 2
        IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: { CadAppPick.by = 3 }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 10)
        CadAppPick.ay = ArrayGet(CadAppPick.ax, CadAppPick.by)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        ArraySet(CadAppPick.hv, 12, CadAppPick.ay)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.bx = ArrayGet(CadAppPick.hv, 6)
        CadAppPick.pins = 10
        IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: { CadAppPick.pins = 11 }
        CadAppPick.ax = ArrayGet(CadAppPick.hv, CadAppPick.pins)
        CadAppPick.ax = CAD_Num.IsZero(CadAppPick.ax, 0)
        IfCondition EqualTo(CadAppPick.ax, 1) ThenBlock: { ReturnValue(0) }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ay = ArrayGet(CadAppPick.hv, 12)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.bx = ArrayGet(CadAppPick.hv, 6)
        CadAppPick.pins = 10
        IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: { CadAppPick.pins = 11 }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, CadAppPick.pins)
        CadAppPick.ax = Float_Div(CadAppPick.ay, CadAppPick.ax)
        CadAppPick.bx = Float_Le(CadAppPick.ax, 0)
        IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: { ReturnValue(0) }
        CadAppPick.bx = Float_Le(0x3FF0000000000000, CadAppPick.ax)
        IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: { ReturnValue(0) }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        ArraySet(CadAppPick.hv, 8, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.bx = ArrayGet(CadAppPick.hv, 6)
        CadAppPick.pins = 11
        CadAppPick.by = 3
        IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: {
            CadAppPick.pins = 10
            CadAppPick.by = 2
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        ArraySet(CadAppPick.hv, 13, CadAppPick.by)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, CadAppPick.pins)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ay = ArrayGet(CadAppPick.hv, 8)
        CadAppPick.ax = Float_Mul(CadAppPick.ax, CadAppPick.ay)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.by = ArrayGet(CadAppPick.hv, 13)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 10)
        ArraySet(CadAppPick.hv, CadAppPick.by, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 3)
        CadAppPick.hu = ArrayGet(CadAppPick.quiet, 4)
        CadAppPick.pins = 4
        CadAppPick.bx = ArrayGet(CadAppPick.quiet, 10)
        CadAppPick.by = ArrayGet(CadAppPick.quiet, 30)
        CadAppPick.hit_i = CAD_Topo.MakeRuledSolidCircle(CadAppPick.hv, CadAppPick.hu, CadAppPick.pins, CadAppPick.bx, CadAppPick.by)
        ReturnValue(CadAppPick.hit_i)
    }
}

// One end has the inner profile. The other ring is that outer scaled by
// the mean-radius ratio. A circle pair uses the circle loft. Counts that
// differ keep the solid loft.
// MapRing leaves hit_i as a coordinate, so the outer solid stays in
// CAD_LoftCut.op. The handle comes back in CAD_LoftCut.tool.
Function.CA_LoftHoleOne {
    Output: Integer
    Body: {
        CadAppPick.ax = Allocate(128)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CadAppPick.quiet, 17, CadAppPick.ax)
        ArraySet(CadAppPick.ax, 4, 0)
        ArraySet(CadAppPick.ax, 5, 0)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 3)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        ArraySet(CadAppPick.hv, 2, CadAppPick.ay)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 4)
        ArraySet(CadAppPick.hv, 3, CadAppPick.ay)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 0)
        CadAppPick.hu = ArrayGet(CadAppPick.quiet, 17)
        ArraySet(CadAppPick.hu, 0, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 1)
        CadAppPick.hu = ArrayGet(CadAppPick.quiet, 17)
        ArraySet(CadAppPick.hu, 1, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 0)
        CadAppPick.bx = ArrayGet(CadAppPick.hv, 1)
        IfCondition NotEqual(CadAppPick.ax, CadAppPick.bx) ThenBlock: {
            CA_LoftHoleBail()
            ReturnValue(0)
        }
        IfCondition LessThan(CadAppPick.ax, 3) ThenBlock: {
            CA_LoftHoleBail()
            ReturnValue(0)
        }
        IfCondition GreaterThan(CadAppPick.ax, 60) ThenBlock: {
            CA_LoftHoleBail()
            ReturnValue(0)
        }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 19)
        ArraySet(CadAppPick.quiet, 8, CadAppPick.ax)
        IfCondition LessThan(CadAppPick.ax, 0) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            ArraySet(CadAppPick.hv, 6, 1)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 15)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            ArraySet(CadAppPick.hv, 7, CadAppPick.ax)
        }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 8)
        IfCondition GreaterEqual(CadAppPick.ax, 0) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            ArraySet(CadAppPick.hv, 6, 0)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 8)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            ArraySet(CadAppPick.hv, 7, CadAppPick.ax)
        }
        CadAppPick.ax = CA_LoftHoleCirc()
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: {
            CAD_LoftCut.tool = CadAppPick.ax
            CA_LoftHoleFree()
            ReturnValue(CAD_LoftCut.tool)
        }
        CadAppPick.ax = Allocate(2048)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        ArraySet(CadAppPick.hv, 4, CadAppPick.ax)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            CA_LoftHoleBail()
            ReturnValue(0)
        }
        CadAppPick.ax = Allocate(2048)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        ArraySet(CadAppPick.hv, 5, CadAppPick.ax)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            CA_LoftHoleBail()
            ReturnValue(0)
        }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 1)
        ArraySet(CadAppPick.quiet, 7, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 4)
        ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.bx = ArrayGet(CadAppPick.hv, 6)
        IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: {
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 2)
            ArraySet(CadAppPick.quiet, 7, CadAppPick.ax)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, 5)
            ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 7)
        ArraySet(CadAppPick.quiet, 11, CadAppPick.ax)
        CadAppPick.ax = CA_LoftMapRing()
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            CA_LoftHoleBail()
            ReturnValue(0)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.bx = ArrayGet(CadAppPick.hv, 0)
        IfCondition NotEqual(CadAppPick.ax, CadAppPick.bx) ThenBlock: {
            CA_LoftHoleBail()
            ReturnValue(0)
        }
        CA_LoftHoleMean()
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 12)
        ArraySet(CadAppPick.hv, 8, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.bx = ArrayGet(CadAppPick.hv, 6)
        IfCondition EqualTo(CadAppPick.bx, 0) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, 2)
            ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.bx = ArrayGet(CadAppPick.hv, 6)
        IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, 3)
            ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 0)
        ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
        CA_LoftHoleMean()
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 12)
        CadAppPick.ax = CAD_Num.IsZero(CadAppPick.ax, 0)
        IfCondition EqualTo(CadAppPick.ax, 1) ThenBlock: {
            CA_LoftHoleBail()
            ReturnValue(0)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ay = ArrayGet(CadAppPick.hv, 8)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 12)
        CadAppPick.ax = Float_Div(CadAppPick.ay, CadAppPick.ax)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        ArraySet(CadAppPick.hv, 8, CadAppPick.ax)
        CadAppPick.bx = Float_Le(CadAppPick.ax, 0)
        IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: {
            CA_LoftHoleBail()
            ReturnValue(0)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 8)
        CadAppPick.bx = Float_Le(0x3FF0000000000000, CadAppPick.ax)
        IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: {
            CA_LoftHoleBail()
            ReturnValue(0)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.bx = ArrayGet(CadAppPick.hv, 6)
        IfCondition EqualTo(CadAppPick.bx, 0) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, 3)
            ArraySet(CadAppPick.hv, 9, CadAppPick.ax)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, 5)
            ArraySet(CadAppPick.hv, 14, CadAppPick.ax)
        }
        IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, 2)
            ArraySet(CadAppPick.hv, 9, CadAppPick.ax)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, 4)
            ArraySet(CadAppPick.hv, 14, CadAppPick.ax)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 0)
        ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
        CA_LoftHoleScale()
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.bx = ArrayGet(CadAppPick.hv, 6)
        IfCondition EqualTo(CadAppPick.bx, 0) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, 2)
            ArraySet(CadAppPick.hv, 9, CadAppPick.ax)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, 4)
            ArraySet(CadAppPick.hv, 14, CadAppPick.ax)
        }
        IfCondition EqualTo(CadAppPick.bx, 1) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, 3)
            ArraySet(CadAppPick.hv, 9, CadAppPick.ax)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
            CadAppPick.ax = ArrayGet(CadAppPick.hv, 5)
            ArraySet(CadAppPick.hv, 14, CadAppPick.ax)
        }
        CA_LoftHoleOrient()
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 17)
        CadAppPick.ax = ArrayGet(CadAppPick.hv, 4)
        CadAppPick.ay = ArrayGet(CadAppPick.hv, 5)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 0)
        CadAppPick.hu = ArrayGet(CadAppPick.quiet, 30)
        CadAppPick.hit_i = CAD_Topo.MakeRuledSolidXYZ(CadAppPick.ax, CadAppPick.ay, CadAppPick.pins, CadAppPick.hu)
        CAD_LoftCut.tool = CadAppPick.hit_i
        CA_LoftHoleFree()
        ReturnValue(CAD_LoftCut.tool)
    }
}

// Punch the inner loft. Both ends use their own inner profiles. One end
// scales that hole through the other. The build reuses bag slots, so the
// outer profile indices come back out of the pack. MapLocal writes bag[9]
// as XYZ, including slot 2, so the outer handle stays in CAD_LoftCut.op
// until Apply replaces that word. A miss builds the outer again.
Function.CA_LoftPunchHole {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppPick.hit_i, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 18)
        CadAppPick.bx = BitwiseAnd(CadAppPick.hv, 0x100000000)
        IfCondition EqualTo(CadAppPick.bx, 0) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = RightShift(CadAppPick.hv, 8)
        CadAppPick.ax = BitwiseAnd(CadAppPick.ax, 255)
        ArraySet(CadAppPick.quiet, 16, CadAppPick.ax)
        CadAppPick.ax = RightShift(CadAppPick.hv, 24)
        CadAppPick.ax = BitwiseAnd(CadAppPick.ax, 255)
        ArraySet(CadAppPick.quiet, 17, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 1)
        ArraySet(CadAppPick.quiet, 7, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 16)
        ArraySet(CadAppPick.quiet, 11, CadAppPick.ax)
        CA_LoftHoleAt()
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 8)
        ArraySet(CadAppPick.quiet, 19, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 2)
        ArraySet(CadAppPick.quiet, 7, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 17)
        ArraySet(CadAppPick.quiet, 11, CadAppPick.ax)
        CA_LoftHoleAt()
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 8)
        ArraySet(CadAppPick.quiet, 15, CadAppPick.ax)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 19)
        CadAppPick.ay = ArrayGet(CadAppPick.quiet, 15)
        CAD_LoftCut.host = 0
        IfCondition LessThan(CadAppPick.ax, 0) ThenBlock: {
            CAD_LoftCut.host = Add(CAD_LoftCut.host, 1)
        }
        IfCondition LessThan(CadAppPick.ay, 0) ThenBlock: {
            CAD_LoftCut.host = Add(CAD_LoftCut.host, 1)
        }
        IfCondition EqualTo(CAD_LoftCut.host, 2) ThenBlock: { ReturnValue(0) }
        CAD_LoftCut.op = CadAppPick.hit_i
        IfCondition EqualTo(CAD_LoftCut.host, 0) ThenBlock: {
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 19)
            ArraySet(CadAppPick.quiet, 16, CadAppPick.ax)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 15)
            ArraySet(CadAppPick.quiet, 17, CadAppPick.ax)
            CadAppPick.ax = CA_LoftMakeSolid()
            IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
                CadAppPick.hit_i = CAD_LoftCut.op
                ReturnValue(0)
            }
            CadAppPick.hit_i = CadAppPick.ax
        }
        IfCondition EqualTo(CAD_LoftCut.host, 1) ThenBlock: {
            CadAppPick.ax = CA_LoftHoleOne()
            IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
                CadAppPick.hit_i = CAD_LoftCut.op
                ReturnValue(0)
            }
            CadAppPick.hit_i = CadAppPick.ax
        }
        CAD_LoftCut.tool = CadAppPick.hit_i
        CAD_LoftCut.host = CAD_Bool.Difference(CAD_LoftCut.op, CAD_LoftCut.tool)
        IfCondition EqualTo(CAD_LoftCut.host, 0) ThenBlock: {
            CA_Log("cad_app: loft hole refused\n", 27)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 18)
            CadAppPick.ax = RightShift(CadAppPick.hv, 8)
            CadAppPick.ax = BitwiseAnd(CadAppPick.ax, 255)
            ArraySet(CadAppPick.quiet, 16, CadAppPick.ax)
            CadAppPick.ax = RightShift(CadAppPick.hv, 24)
            CadAppPick.ax = BitwiseAnd(CadAppPick.ax, 255)
            ArraySet(CadAppPick.quiet, 17, CadAppPick.ax)
            CadAppPick.ax = CA_LoftMakeSolid()
            IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
                CadAppPick.hit_i = CAD_LoftCut.op
                ReturnValue(0)
            }
            CadAppPick.hit_i = CadAppPick.ax
            ReturnValue(0)
        }
        CadAppPick.hit_i = CAD_LoftCut.host
        CA_Log("cad_app: loft hole\n", 19)
        ReturnValue(1)
    }
}
