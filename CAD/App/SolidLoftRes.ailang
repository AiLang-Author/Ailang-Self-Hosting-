// Unequal closed loft rings, split to one station count.
// Both profiles keep every corner. A corner's parameter is its arc length
// over the perimeter, in [0, 1). The loft stations are the union of those
// parameters, at most 60. Each ring is sampled on its own edges at those
// parameters, so a station sits on a boundary and a ruling does not repeat
// a corner. Equal counts do not come here. Bag 7 is the caller's flag.
// Bag 20 is this scratch and is freed before return. Bag 5 is the top
// count on entry and the shared count on success. At most 60 stations.
//
// Scratch, Allocate(8192), safe index 0..1022:
//   0..60 cumA, 62 length A. 64..124 cumB, 126 length B.
//   128..247 merged parameters. 248 nA, 249 nB, 250 count.
//   256..435 bottom xyz. 436..615 top xyz. 700..759 temps.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Num

// Drop bag 20. Only call this after bag 20 is a block or 0.
Function.CA_LoftResFree {
    Output: Integer
    Body: {
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 20)
        IfCondition NotEqual(CadAppPick.ax, 0) ThenBlock: {
            Deallocate(CadAppPick.ax, 8192)
            ArraySet(CadAppPick.quiet, 20, 0)
        }
        ReturnValue(0)
    }
}

// Cumulative edge length of ring bag[13], count bag[5].
// Cum base is bag[6]. Word base+62 receives the perimeter. 0 if it is zero.
Function.CA_LoftResCum {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
        CadAppPick.pins = ArrayGet(CadAppPick.quiet, 6)
        ArraySet(CadAppPick.hv, CadAppPick.pins, 0)
        ArraySet(CadAppPick.hv, 700, 0)
        WhileLoop LessThan(ArrayGet(CadAppPick.hv, 700), ArrayGet(CadAppPick.quiet, 5)) {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 700)
            CadAppPick.by = ArrayGet(CadAppPick.quiet, 5)
            CadAppPick.bx = Add(CadAppPick.pins, 1)
            IfCondition EqualTo(CadAppPick.bx, CadAppPick.by) ThenBlock: { CadAppPick.bx = 0 }
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            ArraySet(CadAppPick.hv, 701, CadAppPick.bx)
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            CA_LoftLoad3()
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            ArraySet(CadAppPick.hv, 702, CadAppPick.clk_x)
            ArraySet(CadAppPick.hv, 703, CadAppPick.clk_y)
            ArraySet(CadAppPick.hv, 704, CadAppPick.hit_a)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 701)
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            CA_LoftLoad3()
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            CadAppPick.hu = ArrayGet(CadAppPick.hv, 702)
            CadAppPick.hu = Float_Sub(CadAppPick.clk_x, CadAppPick.hu)
            CadAppPick.clk_y = Float_Sub(CadAppPick.clk_y, ArrayGet(CadAppPick.hv, 703))
            CadAppPick.hit_a = Float_Sub(CadAppPick.hit_a, ArrayGet(CadAppPick.hv, 704))
            CadAppPick.ax = Float_Mul(CadAppPick.hu, CadAppPick.hu)
            CadAppPick.ay = Float_Mul(CadAppPick.clk_y, CadAppPick.clk_y)
            CadAppPick.ax = Float_Add(CadAppPick.ax, CadAppPick.ay)
            CadAppPick.ay = Float_Mul(CadAppPick.hit_a, CadAppPick.hit_a)
            CadAppPick.ax = Float_Add(CadAppPick.ax, CadAppPick.ay)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            ArraySet(CadAppPick.hv, 705, CadAppPick.ax)
            CadAppPick.hu = CAD_Num.Sqrt(CadAppPick.ax)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 700)
            CadAppPick.by = ArrayGet(CadAppPick.quiet, 6)
            CadAppPick.bx = Add(CadAppPick.by, CadAppPick.pins)
            CadAppPick.clk_x = ArrayGet(CadAppPick.hv, CadAppPick.bx)
            CadAppPick.clk_x = Float_Add(CadAppPick.clk_x, CadAppPick.hu)
            CadAppPick.bx = Add(CadAppPick.bx, 1)
            ArraySet(CadAppPick.hv, CadAppPick.bx, CadAppPick.clk_x)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 700)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            ArraySet(CadAppPick.hv, 700, CadAppPick.pins)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
        CadAppPick.pins = ArrayGet(CadAppPick.quiet, 5)
        CadAppPick.by = ArrayGet(CadAppPick.quiet, 6)
        CadAppPick.bx = Add(CadAppPick.by, CadAppPick.pins)
        CadAppPick.hu = ArrayGet(CadAppPick.hv, CadAppPick.bx)
        CadAppPick.hit_i = CAD_Num.IsZero(CadAppPick.hu, 0)
        IfCondition EqualTo(CadAppPick.hit_i, 1) ThenBlock: { ReturnValue(0) }
        CadAppPick.bx = Add(CadAppPick.by, 62)
        ArraySet(CadAppPick.hv, CadAppPick.bx, CadAppPick.hu)
        ReturnValue(1)
    }
}

// Parameter of corner bag[8] on the cum base bag[6]. Result is clk_x.
Function.CA_LoftResT {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
        CadAppPick.pins = ArrayGet(CadAppPick.quiet, 8)
        CadAppPick.by = ArrayGet(CadAppPick.quiet, 6)
        CadAppPick.bx = Add(CadAppPick.by, CadAppPick.pins)
        CadAppPick.hu = ArrayGet(CadAppPick.hv, CadAppPick.bx)
        CadAppPick.bx = Add(CadAppPick.by, 62)
        CadAppPick.clk_y = ArrayGet(CadAppPick.hv, CadAppPick.bx)
        CadAppPick.clk_x = Float_Div(CadAppPick.hu, CadAppPick.clk_y)
        ReturnValue(0)
    }
}

// Next merged parameter from the two corner lists. 0 when both are done.
// Writes t at word 710, and which list advanced at 711 and 712.
Function.CA_LoftResPick {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 706)
        CadAppPick.by = ArrayGet(CadAppPick.hv, 248)
        CadAppPick.ax = 0
        IfCondition LessThan(CadAppPick.pins, CadAppPick.by) ThenBlock: { CadAppPick.ax = 1 }
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 707)
        CadAppPick.by = ArrayGet(CadAppPick.hv, 249)
        CadAppPick.ay = 0
        IfCondition LessThan(CadAppPick.pins, CadAppPick.by) ThenBlock: { CadAppPick.ay = 1 }
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            IfCondition EqualTo(CadAppPick.ay, 0) ThenBlock: { ReturnValue(0) }
        }
        ArraySet(CadAppPick.hv, 713, 0)
        ArraySet(CadAppPick.hv, 714, 0)
        IfCondition EqualTo(CadAppPick.ax, 1) ThenBlock: {
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 706)
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            ArraySet(CadAppPick.quiet, 6, 0)
            CA_LoftResT()
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            ArraySet(CadAppPick.hv, 713, CadAppPick.clk_x)
        }
        IfCondition EqualTo(CadAppPick.ay, 1) ThenBlock: {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 707)
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            ArraySet(CadAppPick.quiet, 6, 64)
            CA_LoftResT()
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            ArraySet(CadAppPick.hv, 714, CadAppPick.clk_x)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
        ArraySet(CadAppPick.hv, 711, 0)
        ArraySet(CadAppPick.hv, 712, 0)
        IfCondition EqualTo(CadAppPick.ax, 1) ThenBlock: {
            IfCondition EqualTo(CadAppPick.ay, 1) ThenBlock: {
                CadAppPick.hu = ArrayGet(CadAppPick.hv, 713)
                CadAppPick.clk_y = ArrayGet(CadAppPick.hv, 714)
                CadAppPick.hit_i = CAD_Num.IsEqual(CadAppPick.hu, CadAppPick.clk_y, 0)
                IfCondition EqualTo(CadAppPick.hit_i, 1) ThenBlock: {
                    ArraySet(CadAppPick.hv, 710, CadAppPick.hu)
                    ArraySet(CadAppPick.hv, 711, 1)
                    ArraySet(CadAppPick.hv, 712, 1)
                }
                IfCondition EqualTo(CadAppPick.hit_i, 0) ThenBlock: {
                    CadAppPick.found_n = Float_Le(CadAppPick.hu, CadAppPick.clk_y)
                    IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                        ArraySet(CadAppPick.hv, 710, CadAppPick.hu)
                        ArraySet(CadAppPick.hv, 711, 1)
                    }
                    IfCondition EqualTo(CadAppPick.found_n, 0) ThenBlock: {
                        ArraySet(CadAppPick.hv, 710, CadAppPick.clk_y)
                        ArraySet(CadAppPick.hv, 712, 1)
                    }
                }
            }
        }
        IfCondition EqualTo(CadAppPick.ax, 1) ThenBlock: {
            IfCondition EqualTo(CadAppPick.ay, 0) ThenBlock: {
                CadAppPick.hu = ArrayGet(CadAppPick.hv, 713)
                ArraySet(CadAppPick.hv, 710, CadAppPick.hu)
                ArraySet(CadAppPick.hv, 711, 1)
            }
        }
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            IfCondition EqualTo(CadAppPick.ay, 1) ThenBlock: {
                CadAppPick.hu = ArrayGet(CadAppPick.hv, 714)
                ArraySet(CadAppPick.hv, 710, CadAppPick.hu)
                ArraySet(CadAppPick.hv, 712, 1)
            }
        }
        ReturnValue(1)
    }
}

// Union of the two corner parameters into words 128.. . Count at word 250.
Function.CA_LoftResMerge {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
        ArraySet(CadAppPick.hv, 706, 0)
        ArraySet(CadAppPick.hv, 707, 0)
        ArraySet(CadAppPick.hv, 250, 0)
        ArraySet(CadAppPick.hv, 708, 0)
        WhileLoop LessThan(ArrayGet(CadAppPick.hv, 708), 200) {
            CadAppPick.ax = CA_LoftResPick()
            IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
                ArraySet(CadAppPick.hv, 708, 200)
            }
            IfCondition EqualTo(CadAppPick.ax, 1) ThenBlock: {
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
                CadAppPick.pins = ArrayGet(CadAppPick.hv, 250)
                CadAppPick.hu = ArrayGet(CadAppPick.hv, 710)
                CadAppPick.found_n = 1
                IfCondition GreaterThan(CadAppPick.pins, 0) ThenBlock: {
                    CadAppPick.bx = Add(CadAppPick.pins, 127)
                    CadAppPick.clk_y = ArrayGet(CadAppPick.hv, CadAppPick.bx)
                    CadAppPick.hit_i = CAD_Num.IsEqual(CadAppPick.hu, CadAppPick.clk_y, 0)
                    IfCondition EqualTo(CadAppPick.hit_i, 1) ThenBlock: { CadAppPick.found_n = 0 }
                }
                IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                    CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
                    CadAppPick.pins = ArrayGet(CadAppPick.hv, 250)
                    CadAppPick.hu = ArrayGet(CadAppPick.hv, 710)
                    IfCondition GreaterThan(CadAppPick.pins, 119) ThenBlock: {
                        ReturnValue(0)
                    }
                    CadAppPick.bx = Add(CadAppPick.pins, 128)
                    ArraySet(CadAppPick.hv, CadAppPick.bx, CadAppPick.hu)
                    CadAppPick.pins = Add(CadAppPick.pins, 1)
                    ArraySet(CadAppPick.hv, 250, CadAppPick.pins)
                }
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
                CadAppPick.pins = ArrayGet(CadAppPick.hv, 706)
                CadAppPick.by = ArrayGet(CadAppPick.hv, 711)
                CadAppPick.pins = Add(CadAppPick.pins, CadAppPick.by)
                ArraySet(CadAppPick.hv, 706, CadAppPick.pins)
                CadAppPick.pins = ArrayGet(CadAppPick.hv, 707)
                CadAppPick.by = ArrayGet(CadAppPick.hv, 712)
                CadAppPick.pins = Add(CadAppPick.pins, CadAppPick.by)
                ArraySet(CadAppPick.hv, 707, CadAppPick.pins)
                CadAppPick.pins = ArrayGet(CadAppPick.hv, 708)
                CadAppPick.pins = Add(CadAppPick.pins, 1)
                ArraySet(CadAppPick.hv, 708, CadAppPick.pins)
            }
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 250)
        IfCondition LessThan(CadAppPick.pins, 3) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Above 60, keep 60 by even index. Index 0 stays, so the seam stays.
Function.CA_LoftResThin {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 250)
        IfCondition LessEqual(CadAppPick.pins, 60) ThenBlock: { ReturnValue(CadAppPick.pins) }
        ArraySet(CadAppPick.hv, 709, 0)
        WhileLoop LessThan(ArrayGet(CadAppPick.hv, 709), 60) {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 709)
            CadAppPick.by = ArrayGet(CadAppPick.hv, 250)
            CadAppPick.bx = Multiply(CadAppPick.pins, CadAppPick.by)
            CadAppPick.bx = Divide(CadAppPick.bx, 60)
            CadAppPick.bx = Add(CadAppPick.bx, 128)
            CadAppPick.hu = ArrayGet(CadAppPick.hv, CadAppPick.bx)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 709)
            CadAppPick.bx = Add(CadAppPick.pins, 256)
            ArraySet(CadAppPick.hv, CadAppPick.bx, CadAppPick.hu)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            ArraySet(CadAppPick.hv, 709, CadAppPick.pins)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
        ArraySet(CadAppPick.hv, 709, 0)
        WhileLoop LessThan(ArrayGet(CadAppPick.hv, 709), 60) {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 709)
            CadAppPick.bx = Add(CadAppPick.pins, 256)
            CadAppPick.hu = ArrayGet(CadAppPick.hv, CadAppPick.bx)
            CadAppPick.bx = Add(CadAppPick.pins, 128)
            ArraySet(CadAppPick.hv, CadAppPick.bx, CadAppPick.hu)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            ArraySet(CadAppPick.hv, 709, CadAppPick.pins)
        }
        ArraySet(CadAppPick.hv, 250, 60)
        ReturnValue(60)
    }
}

// Point on ring bag[13] at parameter word 720. 1 on a hit.
Function.CA_LoftResAt {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
        ArraySet(CadAppPick.hv, 721, 0)
        ArraySet(CadAppPick.hv, 722, 0)
        WhileLoop EqualTo(ArrayGet(CadAppPick.hv, 722), 0) {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 721)
            CadAppPick.by = ArrayGet(CadAppPick.quiet, 5)
            IfCondition GreaterEqual(CadAppPick.pins, CadAppPick.by) ThenBlock: {
                ArraySet(CadAppPick.hv, 722, 2)
            }
            IfCondition LessThan(CadAppPick.pins, CadAppPick.by) ThenBlock: {
                ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
                CA_LoftResT()
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
                ArraySet(CadAppPick.hv, 723, CadAppPick.clk_x)
                CadAppPick.pins = ArrayGet(CadAppPick.hv, 721)
                CadAppPick.pins = Add(CadAppPick.pins, 1)
                ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
                CA_LoftResT()
                CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
                ArraySet(CadAppPick.hv, 734, CadAppPick.clk_x)
                CadAppPick.hu = ArrayGet(CadAppPick.hv, 723)
                CadAppPick.clk_y = Float_Sub(CadAppPick.clk_x, CadAppPick.hu)
                ArraySet(CadAppPick.hv, 735, CadAppPick.clk_y)
                CadAppPick.hit_i = CAD_Num.IsZero(CadAppPick.clk_y, 0)
                CadAppPick.found_n = 0
                IfCondition EqualTo(CadAppPick.hit_i, 0) ThenBlock: {
                    CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
                    CadAppPick.ax = ArrayGet(CadAppPick.hv, 720)
                    CadAppPick.hu = ArrayGet(CadAppPick.hv, 723)
                    CadAppPick.found_n = Float_Le(CadAppPick.hu, CadAppPick.ax)
                }
                IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                    CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
                    CadAppPick.pins = ArrayGet(CadAppPick.hv, 721)
                    CadAppPick.by = ArrayGet(CadAppPick.quiet, 5)
                    CadAppPick.by = Subtract(CadAppPick.by, 1)
                    CadAppPick.ay = 0
                    IfCondition EqualTo(CadAppPick.pins, CadAppPick.by) ThenBlock: { CadAppPick.ay = 1 }
                    IfCondition EqualTo(CadAppPick.ay, 0) ThenBlock: {
                        CadAppPick.clk_x = ArrayGet(CadAppPick.hv, 734)
                        CadAppPick.ax = ArrayGet(CadAppPick.hv, 720)
                        CadAppPick.bx = Float_Le(CadAppPick.clk_x, CadAppPick.ax)
                        IfCondition EqualTo(CadAppPick.bx, 0) ThenBlock: { CadAppPick.ay = 1 }
                    }
                }
                IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: {
                    IfCondition EqualTo(CadAppPick.ay, 1) ThenBlock: {
                        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
                        CadAppPick.ax = ArrayGet(CadAppPick.hv, 720)
                        CadAppPick.hu = ArrayGet(CadAppPick.hv, 723)
                        CadAppPick.clk_y = ArrayGet(CadAppPick.hv, 735)
                        CadAppPick.clk_x = Float_Sub(CadAppPick.ax, CadAppPick.hu)
                        CadAppPick.clk_x = Float_Div(CadAppPick.clk_x, CadAppPick.clk_y)
                        ArraySet(CadAppPick.hv, 724, CadAppPick.clk_x)
                        ArraySet(CadAppPick.hv, 722, 1)
                    }
                }
                IfCondition EqualTo(ArrayGet(CadAppPick.hv, 722), 0) ThenBlock: {
                    CadAppPick.pins = ArrayGet(CadAppPick.hv, 721)
                    CadAppPick.pins = Add(CadAppPick.pins, 1)
                    ArraySet(CadAppPick.hv, 721, CadAppPick.pins)
                }
            }
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 722)
        IfCondition EqualTo(CadAppPick.pins, 2) ThenBlock: { ReturnValue(0) }
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 721)
        ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
        CA_LoftLoad3()
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
        ArraySet(CadAppPick.hv, 725, CadAppPick.clk_x)
        ArraySet(CadAppPick.hv, 726, CadAppPick.clk_y)
        ArraySet(CadAppPick.hv, 727, CadAppPick.hit_a)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 721)
        CadAppPick.pins = Add(CadAppPick.pins, 1)
        CadAppPick.by = ArrayGet(CadAppPick.quiet, 5)
        IfCondition GreaterEqual(CadAppPick.pins, CadAppPick.by) ThenBlock: { CadAppPick.pins = 0 }
        ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
        CA_LoftLoad3()
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
        ArraySet(CadAppPick.hv, 731, CadAppPick.clk_x)
        ArraySet(CadAppPick.hv, 732, CadAppPick.clk_y)
        ArraySet(CadAppPick.hv, 733, CadAppPick.hit_a)
        CadAppPick.hu = ArrayGet(CadAppPick.hv, 724)
        CadAppPick.clk_y = ArrayGet(CadAppPick.hv, 731)
        CadAppPick.clk_x = ArrayGet(CadAppPick.hv, 725)
        CadAppPick.clk_y = Float_Sub(CadAppPick.clk_y, CadAppPick.clk_x)
        CadAppPick.clk_y = Float_Mul(CadAppPick.hu, CadAppPick.clk_y)
        CadAppPick.clk_x = Float_Add(CadAppPick.clk_x, CadAppPick.clk_y)
        ArraySet(CadAppPick.hv, 728, CadAppPick.clk_x)
        CadAppPick.clk_y = ArrayGet(CadAppPick.hv, 732)
        CadAppPick.clk_x = ArrayGet(CadAppPick.hv, 726)
        CadAppPick.clk_y = Float_Sub(CadAppPick.clk_y, CadAppPick.clk_x)
        CadAppPick.clk_y = Float_Mul(CadAppPick.hu, CadAppPick.clk_y)
        CadAppPick.clk_y = Float_Add(CadAppPick.clk_x, CadAppPick.clk_y)
        ArraySet(CadAppPick.hv, 729, CadAppPick.clk_y)
        CadAppPick.clk_y = ArrayGet(CadAppPick.hv, 733)
        CadAppPick.clk_x = ArrayGet(CadAppPick.hv, 727)
        CadAppPick.clk_y = Float_Sub(CadAppPick.clk_y, CadAppPick.clk_x)
        CadAppPick.clk_y = Float_Mul(CadAppPick.hu, CadAppPick.clk_y)
        CadAppPick.hit_a = Float_Add(CadAppPick.clk_x, CadAppPick.clk_y)
        CadAppPick.clk_x = ArrayGet(CadAppPick.hv, 728)
        CadAppPick.clk_y = ArrayGet(CadAppPick.hv, 729)
        ReturnValue(1)
    }
}

// Sample both rings into the xyz blocks.
Function.CA_LoftResFill {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
        ArraySet(CadAppPick.hv, 730, 0)
        WhileLoop LessThan(ArrayGet(CadAppPick.hv, 730), ArrayGet(CadAppPick.hv, 250)) {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 730)
            CadAppPick.bx = Add(CadAppPick.pins, 128)
            CadAppPick.hu = ArrayGet(CadAppPick.hv, CadAppPick.bx)
            ArraySet(CadAppPick.hv, 720, CadAppPick.hu)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 3)
            ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 248)
            ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
            ArraySet(CadAppPick.quiet, 6, 0)
            CadAppPick.ax = CA_LoftResAt()
            IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 730)
            CadAppPick.pins = Multiply(CadAppPick.pins, 3)
            CadAppPick.pins = Add(CadAppPick.pins, 256)
            ArraySet(CadAppPick.hv, CadAppPick.pins, CadAppPick.clk_x)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            ArraySet(CadAppPick.hv, CadAppPick.pins, CadAppPick.clk_y)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            ArraySet(CadAppPick.hv, CadAppPick.pins, CadAppPick.hit_a)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 4)
            ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 249)
            ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
            ArraySet(CadAppPick.quiet, 6, 64)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 730)
            CadAppPick.bx = Add(CadAppPick.pins, 128)
            CadAppPick.hu = ArrayGet(CadAppPick.hv, CadAppPick.bx)
            ArraySet(CadAppPick.hv, 720, CadAppPick.hu)
            CadAppPick.ax = CA_LoftResAt()
            IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 730)
            CadAppPick.pins = Multiply(CadAppPick.pins, 3)
            CadAppPick.pins = Add(CadAppPick.pins, 436)
            ArraySet(CadAppPick.hv, CadAppPick.pins, CadAppPick.clk_x)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            ArraySet(CadAppPick.hv, CadAppPick.pins, CadAppPick.clk_y)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            ArraySet(CadAppPick.hv, CadAppPick.pins, CadAppPick.hit_a)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 730)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            ArraySet(CadAppPick.hv, 730, CadAppPick.pins)
        }
        ReturnValue(1)
    }
}

// Copy the samples back onto the two rings and publish the shared count.
Function.CA_LoftResWrite {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
        ArraySet(CadAppPick.hv, 730, 0)
        WhileLoop LessThan(ArrayGet(CadAppPick.hv, 730), ArrayGet(CadAppPick.hv, 250)) {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 730)
            CadAppPick.bx = Multiply(CadAppPick.pins, 3)
            CadAppPick.bx = Add(CadAppPick.bx, 256)
            CadAppPick.clk_x = ArrayGet(CadAppPick.hv, CadAppPick.bx)
            CadAppPick.bx = Add(CadAppPick.bx, 1)
            CadAppPick.clk_y = ArrayGet(CadAppPick.hv, CadAppPick.bx)
            CadAppPick.bx = Add(CadAppPick.bx, 1)
            CadAppPick.hit_a = ArrayGet(CadAppPick.hv, CadAppPick.bx)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 3)
            ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            CA_LoftStore3()
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 730)
            CadAppPick.bx = Multiply(CadAppPick.pins, 3)
            CadAppPick.bx = Add(CadAppPick.bx, 436)
            CadAppPick.clk_x = ArrayGet(CadAppPick.hv, CadAppPick.bx)
            CadAppPick.bx = Add(CadAppPick.bx, 1)
            CadAppPick.clk_y = ArrayGet(CadAppPick.hv, CadAppPick.bx)
            CadAppPick.bx = Add(CadAppPick.bx, 1)
            CadAppPick.hit_a = ArrayGet(CadAppPick.hv, CadAppPick.bx)
            CadAppPick.ax = ArrayGet(CadAppPick.quiet, 4)
            ArraySet(CadAppPick.quiet, 13, CadAppPick.ax)
            ArraySet(CadAppPick.quiet, 8, CadAppPick.pins)
            CA_LoftStore3()
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
            CadAppPick.pins = ArrayGet(CadAppPick.hv, 730)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
            ArraySet(CadAppPick.hv, 730, CadAppPick.pins)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 20)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 250)
        ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 9)
        ArraySet(CadAppPick.ax, 0, CadAppPick.pins)
        ArraySet(CadAppPick.ax, 1, CadAppPick.pins)
        ReturnValue(1)
    }
}

// Split unequal closed rings onto one station count. 1 on success.
// Does not write bag 7. Bag 5 is the top count on entry.
Function.CA_LoftResample {
    Output: Integer
    Body: {
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 9)
        CadAppPick.pins = ArrayGet(CadAppPick.hv, 0)
        CadAppPick.by = ArrayGet(CadAppPick.hv, 1)
        CadAppPick.found_n = 0
        IfCondition LessThan(CadAppPick.pins, 3) ThenBlock: { CadAppPick.found_n = 1 }
        IfCondition GreaterThan(CadAppPick.pins, 60) ThenBlock: { CadAppPick.found_n = 1 }
        IfCondition LessThan(CadAppPick.by, 3) ThenBlock: { CadAppPick.found_n = 1 }
        IfCondition GreaterThan(CadAppPick.by, 60) ThenBlock: { CadAppPick.found_n = 1 }
        IfCondition EqualTo(CadAppPick.found_n, 1) ThenBlock: { ReturnValue(0) }
        ArraySet(CadAppPick.quiet, 21, CadAppPick.pins)
        ArraySet(CadAppPick.quiet, 22, CadAppPick.by)
        ArraySet(CadAppPick.quiet, 5, CadAppPick.by)
        CA_LoftAlign()
        ArraySet(CadAppPick.quiet, 20, 0)
        CadAppPick.ax = Allocate(8192)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CadAppPick.quiet, 20, CadAppPick.ax)
        CadAppPick.pins = ArrayGet(CadAppPick.quiet, 21)
        CadAppPick.by = ArrayGet(CadAppPick.quiet, 22)
        ArraySet(CadAppPick.ax, 248, CadAppPick.pins)
        ArraySet(CadAppPick.ax, 249, CadAppPick.by)
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 3)
        ArraySet(CadAppPick.quiet, 13, CadAppPick.hv)
        ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
        ArraySet(CadAppPick.quiet, 6, 0)
        CadAppPick.ax = CA_LoftResCum()
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            CA_LoftResFree()
            ReturnValue(0)
        }
        CadAppPick.hv = ArrayGet(CadAppPick.quiet, 4)
        ArraySet(CadAppPick.quiet, 13, CadAppPick.hv)
        CadAppPick.pins = ArrayGet(CadAppPick.quiet, 22)
        ArraySet(CadAppPick.quiet, 5, CadAppPick.pins)
        ArraySet(CadAppPick.quiet, 6, 64)
        CadAppPick.ax = CA_LoftResCum()
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            CA_LoftResFree()
            ReturnValue(0)
        }
        CadAppPick.ax = CA_LoftResMerge()
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            CA_LoftResFree()
            ReturnValue(0)
        }
        CA_LoftResThin()
        CadAppPick.ax = CA_LoftResFill()
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: {
            CA_LoftResFree()
            ReturnValue(0)
        }
        CA_LoftResWrite()
        CA_LoftResFree()
        ReturnValue(1)
    }
}
