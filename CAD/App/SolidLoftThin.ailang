// Loft ring thinning, and which coplanar profile a loft click keeps.
// A 2D fillet expands each corner to at least 24 stations. The ruled
// ring holds 60. Extra stations are resampled evenly. The loop stays closed.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Num

// Compile every sketch so loft can fill each closed face before the click.
Function.CA_LoftCompileFaces {
    Output: Integer
    Body: {
        CadAppPick.ax = Allocate(64)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CadAppPick.ax, 0, CadApp.tmp_b)
        ArraySet(CadAppPick.ax, 1, CadApp.sketch)
        ArraySet(CadAppPick.ax, 2, 0)
        CadApp.tmp_b = CadAppPick.ax
        WhileLoop LessThan(ArrayGet(CadApp.tmp_b, 2), CadApp.sk_n) {
            CadAppPick.ax = ArrayGet(CadApp.tmp_b, 2)
            CadAppPick.ax = ArrayGet(CadApp.sk_list, CadAppPick.ax)
            ArraySet(CadApp.tmp_b, 3, CadAppPick.ax)
            IfCondition NotEqual(ArrayGet(CadApp.tmp_b, 3), 0) ThenBlock: {
                CadApp.sketch = ArrayGet(CadApp.tmp_b, 3)
                CadAppPick.ax = ArrayGet(CadApp.tmp_b, 3)
                CAD_Sketch.RebuildAnchors(CadAppPick.ax)
                CadAppPick.ax = ArrayGet(CadApp.tmp_b, 3)
                CAD_Sketch.ProfCompile(CadAppPick.ax)
            }
            CadAppPick.ax = ArrayGet(CadApp.tmp_b, 2)
            CadAppPick.ax = Add(CadAppPick.ax, 1)
            ArraySet(CadApp.tmp_b, 2, CadAppPick.ax)
        }
        CadApp.sketch = ArrayGet(CadApp.tmp_b, 1)
        CadAppPick.ay = ArrayGet(CadApp.tmp_b, 0)
        CadAppPick.ax = CadApp.tmp_b
        CadApp.tmp_b = CadAppPick.ay
        Deallocate(CadAppPick.ax, 64)
        ReturnValue(0)
    }
}

// Profile XY is bag[10], count bag[5]. Above 60, keep 60 evenly spaced
// stations, including the first. Returns the count the loft will use.
Function.CA_LoftThinRing {
    Output: Integer
    Body: {
        CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
        IfCondition LessThan(CadAppPick.prof_nn, 3) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(CadAppPick.prof_nn, 60) ThenBlock: {
            ReturnValue(CadAppPick.prof_nn)
        }
        IfCondition GreaterThan(CadAppPick.prof_nn, 2048) ThenBlock: { ReturnValue(0) }
        CadAppPick.ax = Allocate(1024)
        IfCondition EqualTo(CadAppPick.ax, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CadAppPick.quiet, 8, CadAppPick.ax)
        CadAppPick.pins = 0
        WhileLoop LessThan(CadAppPick.pins, 60) {
            CadAppPick.prof_nn = ArrayGet(CadAppPick.quiet, 5)
            CadAppPick.by = Multiply(CadAppPick.pins, CadAppPick.prof_nn)
            CadAppPick.by = Divide(CadAppPick.by, 60)
            CadAppPick.bx = Multiply(CadAppPick.by, 2)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 10)
            CadAppPick.hu = ArrayGet(CadAppPick.hv, CadAppPick.bx)
            CadAppPick.bx = Add(CadAppPick.bx, 1)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 10)
            CadAppPick.clk_x = ArrayGet(CadAppPick.hv, CadAppPick.bx)
            CadAppPick.bx = Multiply(CadAppPick.pins, 2)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 8)
            ArraySet(CadAppPick.hv, CadAppPick.bx, CadAppPick.hu)
            CadAppPick.bx = Add(CadAppPick.bx, 1)
            ArraySet(CadAppPick.hv, CadAppPick.bx, CadAppPick.clk_x)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
        }
        CadAppPick.pins = 0
        WhileLoop LessThan(CadAppPick.pins, 120) {
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 8)
            CadAppPick.hu = ArrayGet(CadAppPick.hv, CadAppPick.pins)
            CadAppPick.hv = ArrayGet(CadAppPick.quiet, 10)
            ArraySet(CadAppPick.hv, CadAppPick.pins, CadAppPick.hu)
            CadAppPick.pins = Add(CadAppPick.pins, 1)
        }
        CadAppPick.ax = ArrayGet(CadAppPick.quiet, 8)
        Deallocate(CadAppPick.ax, 1024)
        ArraySet(CadAppPick.quiet, 8, 0)
        ArraySet(CadAppPick.quiet, 5, 60)
        ReturnValue(60)
    }
}

// 1 when this hit replaces the loft pick. Same plane keeps the smaller area.
// A closer plane still wins. tmp_b is the hit scratch CA_LoftHit owns.
Function.CA_LoftHitKeep {
    Output: Integer
    Body: {
        CadAppPick.ax = ArrayGet(CadApp.tmp_b, 8)
        IfCondition EqualTo(CadAppPick.ax, -1) ThenBlock: { ReturnValue(1) }
        CadAppPick.hu = ArrayGet(CadApp.tmp_b, 28)
        CadAppPick.hv = ArrayGet(CadApp.tmp_b, 7)
        CadAppPick.pins = CAD_Num.IsEqual(CadAppPick.hu, CadAppPick.hv, 0)
        IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: {
            CadAppPick.hu = ArrayGet(CadApp.tmp_b, 33)
            CadAppPick.hv = ArrayGet(CadApp.tmp_b, 34)
            CadAppPick.pins = CAD_Num.IsEqual(CadAppPick.hu, CadAppPick.hv, 0)
            IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: { ReturnValue(0) }
            CadAppPick.pins = Float_Le(CadAppPick.hu, CadAppPick.hv)
            IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        CadAppPick.hu = ArrayGet(CadApp.tmp_b, 28)
        CadAppPick.hv = ArrayGet(CadApp.tmp_b, 7)
        CadAppPick.pins = Float_Le(CadAppPick.hu, CadAppPick.hv)
        IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}
