LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Blend
LibraryImport.Display.Render.Framebuffer
LibraryImport.StringUtils

Function.CA_BuildSolid {
    Output: Integer
    Body: {
        CAD_View.InvalidateMesh()
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: no sketch\n", 19)
            ReturnValue(-1)
        }
        dh = CadApp.height
        IfCondition EqualTo(dh, 0) ThenBlock: { dh = 10 }
        IfCondition LessThan(dh, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: { CadApp.extrude_op = 1 }
            dh = Subtract(0, dh)
        }
        IfCondition LessThan(dh, 1) ThenBlock: { dh = 1 }
        hgt = Float_FromInt(dh)
        h = 0
        // --- pad paths ---
        // Never PrepareExtrude the LIVE sketch (mutates arcs/lines/circles).
        // Circles/rects use the same profile → poly prism path (no analytic cyl/box).
        live = CadApp.sketch

        // Keep user selection across rebuild (rebuild clears mask by design)
        saved_user = CadApp.prof_user
        saved_mask = CadApp.prof_mask
        saved_sel = CadApp.prof_sel
        sk_nprof = CA_RebuildProfiles()
        CadApp.nprof = sk_nprof
        IfCondition EqualTo(sk_nprof, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL (no closed profile)\n", 38)
            CA_Log("  close a loop (RECT/circle), then Pad again\n", 45)
            CA_DumpSketchGeom(live, "cad_app: LIVE pad no profile", 28)
            ReturnValue(-2)
        }

        // File/DXF path (import only — not interactive auto-pick)
        IfCondition EqualTo(CadApp.auto_pad, 1) ThenBlock: {
            clone = CAD_Sketch.CreateSketch(1)
            CA_CopySketchGeom(CadApp.sketch, clone)
            CAD_Sketch.PrepareExtrude(clone)
            h = CAD_Feat.ExtrudeProfile(clone, hgt)
            IfCondition EqualTo(h, 0) ThenBlock: {
                CA_Log("cad_app: pad FAIL (auto extrude)\n", 33)
                ReturnValue(-2)
            }
            CadApp.solid = h
            CadApp.dirty = 1
            CadApp.prof_user = 0
            CA_Log("cad_app: pad OK (file/auto)\n", 28)
            ReturnValue(0)
        }

        // Restore explicit user pick; NEVER invent a selection
        IfCondition EqualTo(saved_user, 1) ThenBlock: {
            IfCondition NotEqual(saved_mask, 0) ThenBlock: {
                CadApp.prof_user = 1
                CadApp.prof_mask = saved_mask
                CadApp.prof_sel = saved_sel
                // clamp sel into range
                IfCondition GreaterEqual(CadApp.prof_sel, sk_nprof) ThenBlock: {
                    CadApp.prof_sel = 0
                }
            }
        }
        IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL - pick a profile first (light red rings)\n", 59)
            CA_Log("  Pick tool / click face; Shift+click multi; then Pad\n", 54)
            ReturnValue(-3)
        }
        IfCondition EqualTo(CadApp.prof_mask, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL - nothing selected (bright red needed)\n", 57)
            ReturnValue(-3)
        }
        // Selected outer = that area. Closed children inside it = through holes
        // (own tree IDs). Disjoint selected rings = extra prisms.
        PrintMessage("cad_app: pad nprof=")
        PrintNumber(sk_nprof)
        PrintMessage(" mask=")
        PrintNumber(CadApp.prof_mask)
        PrintMessage(" sel=")
        PrintNumber(CadApp.prof_sel)
        PrintMessage("\n")
        CA_Log("cad_app: pad after pick restore\n", 31)
        IfCondition NotEqual(CA_PadBufs(), 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL - ring buf\n", 29)
            ReturnValue(-2)
        }
        xy = CadAppPad.xy
        oxy = CadAppPad.oxy
        outer_i = -1
        outer_a = 0
        outer_nn = 0
        pi = 0
        WhileLoop LessThan(pi, sk_nprof) {
            IfCondition LessThan(pi, 32) ThenBlock: {
                bit = LeftShift(1, pi)
                IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: {
                    nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                    IfCondition GreaterEqual(nn, 3) ThenBlock: {
                        ar = CAD_Sketch.LoopSignedArea(xy, nn)
                        IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                        better = 0
                        IfCondition EqualTo(outer_i, -1) ThenBlock: { better = 1 }
                        IfCondition EqualTo(Float_Le(outer_a, ar), 1) ThenBlock: {
                            IfCondition NotEqual(pi, outer_i) ThenBlock: { better = 1 }
                        }
                        IfCondition EqualTo(better, 1) ThenBlock: {
                            outer_i = pi
                            outer_a = ar
                            outer_nn = nn
                            k = 0
                            WhileLoop LessThan(k, nn) {
                                ArraySet(oxy, Multiply(k, 2), ArrayGet(xy, Multiply(k, 2)))
                                ArraySet(oxy, Add(Multiply(k, 2), 1), ArrayGet(xy, Add(Multiply(k, 2), 1)))
                                k = Add(k, 1)
                            }
                        }
                        PrintMessage("cad_app: pad prof=")
                        PrintNumber(pi)
                        PrintMessage(" nn=")
                        PrintNumber(nn)
                        PrintMessage(" area=")
                        PrintNumber(Float_ToInt(ar))
                        PrintMessage("\n")
                    }
                }
            }
            pi = Add(pi, 1)
        }
        IfCondition LessThan(outer_i, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL - no valid ring\n", 34)
            ReturnValue(-2)
        }
        // Primary = largest selected ring (first prism). Others compound later.
        // PIN outer_nn / oxy / height BEFORE CreateSketch/AddProfileXY — nested
        // calls clobber locals and AddProfileXY(n=4 garbage) → MakeBoxSolid cube.
        onn = outer_nn
        oaddr = oxy
        oi = outer_i
        ohgt = hgt
        IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: {
            ohgt = Float_Sub(0, hgt)
        }
        PrintMessage("cad_app: pad outer_i=")
        PrintNumber(oi)
        PrintMessage(" onn=")
        PrintNumber(onn)
        PrintMessage("\n")
        IfCondition LessThan(onn, 3) ThenBlock: {
            CA_Log("cad_app: pad FAIL - outer ring clobbered\n", 41)
            ReturnValue(-2)
        }
        CadAppPick.prof_nn = onn
        CadAppPad.hg = ohgt
        CAD_Topo.SweepReset()
        CAD_Topo_Sweep.hz = ohgt
        CA_SweepFromSketch(oi)
        pln = CAD_Sketch.GetPlaneId(live)
        IfCondition EqualTo(pln, 0) ThenBlock: { pln = CadApp.plane }
        CadApp.keep_solid = 0
        IfCondition NotEqual(pln, 0) ThenBlock: {
            IfCondition NotEqual(pln, CadApp.sk0_plane) ThenBlock: {
                CadApp.keep_solid = CadApp.solid
            }
        }
        CA_LogInt("cad_app: sweep ncont=", 21, CAD_Topo_Sweep.ncont)
        h = CAD_Topo.ExtrudeContours()
        IfCondition EqualTo(h, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL (sweep)\n", 26)
            ReturnValue(-2)
        }
        h = CA_ExtrudeSavedIslands(h)
        IfCondition EqualTo(h, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL (island)\n", 27)
            ReturnValue(-2)
        }
        IfCondition NotEqual(pln, 0) ThenBlock: {
            fr = Allocate(128)
            IfCondition NotEqual(fr, 0) ThenBlock: {
                CAD_Plane.EvalFrame(pln, fr)
                CAD_Topo.MapSolidByFrame(h, fr)
                CAD_Topo.SnapSolidToFrame(h, fr)
                Deallocate(fr, 128)
            }
            CAD_Topo.RebuildKind0Planes(h)
        }
        hsk = 0
        // On-face pad: keep_solid is the body we sketched on. Live path used
        // to assign CadApp.solid = h and drop the host — timeline still had
        // it, so scroll-back "fixed" the vanish. Replay already Glue/Compound.
        IfCondition NotEqual(CadApp.keep_solid, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.keep_solid, h) ThenBlock: {
                CadAppPad.oc = h
                IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: {
                    CadAppPad.ok = CAD_Bool.Difference(CadApp.keep_solid, CadAppPad.oc)
                    IfCondition NotEqual(CadAppPad.ok, 0) ThenBlock: { CadAppPad.oc = CadAppPad.ok }
                    IfCondition EqualTo(CadAppPad.ok, 0) ThenBlock: {
                        CA_Log("cad_app: CUT no B-Rep difference — host kept\n", 47)
                        CadAppPad.oc = CadApp.keep_solid
                    }
                }
                IfCondition NotEqual(CadApp.extrude_op, 1) ThenBlock: {
                    CadAppPad.ok = CAD_Bool.GlueOnFace(CadApp.keep_solid, CadAppPad.oc)
                    IfCondition NotEqual(CadAppPad.ok, 0) ThenBlock: {
                        CadAppPad.oc = CadAppPad.ok
                        CA_Log("cad_app: JOIN GlueOnFace\n", 25)
                    }
                    IfCondition EqualTo(CadAppPad.ok, 0) ThenBlock: {
                        CadAppPad.oc = CAD_Topo.CompoundAdd(CadApp.keep_solid, CadAppPad.oc)
                        CA_Log("cad_app: JOIN CompoundAdd (glue miss)\n", 38)
                    }
                }
                h = CadAppPad.oc
            }
        }
        CadApp.solid = h
        CAD_Topo.RebuildKind0Planes(CadApp.solid)
        CA_Log("cad_app: pad before regen\n", 26)
        // parent-first regen; FACE signature is last-resort (loud miss)
        CA_RegenPlaneTree()
        CA_Log("cad_app: pad after regen\n", 25)
        CadApp.dirty = 1
        CadApp.nprof = sk_nprof
        CadApp.mode = 0
        CAD_View.SetViewMode(0)
        CAD_View_State.zoom_r = 0x3FF0000000000000
        // shaded solid default — no GPU stack; CAD_View FillTri + Z into frame.raw
        CadApp.wire = 0
        CAD_View.SetWire(0)
        PrintMessage("cad_app: pad OK solid=")
        PrintNumber(h)
        PrintMessage(" kind=")
        PrintNumber(CAD_Store.Read(h, 3))
        PrintMessage(" n_holes=")
        PrintNumber(CadAppPad.choles)
        PrintMessage("\n")
        IfCondition EqualTo(CadApp.keep_solid, 0) ThenBlock: {
            IfCondition GreaterThan(CadAppPad.choles, 0) ThenBlock: {
                CA_Log("cad_app: pad OK (outer + holes) - 3D view\n", 42)
            }
            IfCondition EqualTo(CadAppPad.choles, 0) ThenBlock: {
                CA_Log("cad_app: pad OK (profile) - switched to 3D\n", 43)
            }
        }
        CadApp.keep_solid = 0
        IfCondition EqualTo(CadApp.pad_edit, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                IfCondition GreaterEqual(CadApp.feat_sel, 0) ThenBlock: {
                    ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.height)
                }
            }
            CadApp.last_pad = CadApp.feat_sel
        }
        IfCondition EqualTo(CadApp.pad_edit, 0) ThenBlock: {
            fk = 1
            IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: { fk = 3 }
            CA_FeatAdd(fk, CA_CurrentSkIdx())
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.height)
            }
            CadApp.last_pad = CadApp.feat_sel
            IfCondition EqualTo(CadApp.auto_pad, 0) ThenBlock: {
                CA_HudOpenPad()
            }
        }
        CA_Log("cad_app: pad before 3d pub\n", 27)
        IfCondition EqualTo(CadApp.replay, 0) ThenBlock: {
            CA_PublishFrame()
        }
        CA_Log("cad_app: pad after 3d pub\n", 26)
        PrintMessage("cad_app: after pad last_nt=")
        PrintNumber(CAD_View_State.last_nt)
        PrintMessage(" last_nv=")
        PrintNumber(CAD_View_State.last_nv)
        PrintMessage("\n")
        ReturnValue(0)
    }
}


Function.CA_PadFromSketch {
    Output: Integer
    Body: {
        CA_UndoPush()
        IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: { CadApp.extrude_op = 0 }
            CA_HudOpenPad()
            CA_Log("cad_app: extrude - type H, Tab JOIN/CUT/NEW, Enter\n", 52)
            ReturnValue(0)
        }
        CadApp.extrude_op = 0
        ReturnValue(CA_BuildSolid())
    }
}

// Enter face-pick: stay in 3D, next short LMB click chooses a real planar face.


// Map a +Z lathe into the sketch plane about the user-picked axis.
// Lathe verts (Xl,Yl,Zl) with Zl = distance along axis, Xl+i Yl = rho.
// World = origin + Xl*n + Yl*k + Zl*u, u = axis dir, n = left normal, k = +Z.
Function.CA_XformLatheInPlace {
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadAppRev.ok, 0) ThenBlock: { ReturnValue(-1) }
        x0 = CadAppRev.x0
        y0 = CadAppRev.y0
        dx = Float_Sub(CadAppRev.x1, x0)
        dy = Float_Sub(CadAppRev.y1, y0)
        ln = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: { ReturnValue(-1) }
        CadAppRev.ux = Float_Div(dx, ln)
        CadAppRev.uy = Float_Div(dy, ln)
        CadAppRev.nx = Float_Sub(0, CadAppRev.uy)
        CadAppRev.ny = CadAppRev.ux
        kind = CAD_Store.Read(solid_handle, 3)
        IfCondition NotEqual(kind, 0) ThenBlock: { ReturnValue(-1) }
        shell = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(shell, 0) ThenBlock: { ReturnValue(-1) }
        sguard = 0
        WhileLoop NotEqual(shell, 0) {
            face = CAD_Store.Read(shell, 0)
            fguard = 0
            WhileLoop NotEqual(face, 0) {
                lp = CAD_Store.Read(face, 1)
                lguard = 0
                WhileLoop NotEqual(lp, 0) {
                    hd = CAD_Store.Read(lp, 0)
                    ce = hd
                    cdone = 0
                    cguard = 0
                    WhileLoop EqualTo(cdone, 0) {
                        ov = CAD_Store.Read(ce, 5)
                        euse = CAD_Store.Read(ov, 3)
                        IfCondition EqualTo(BitwiseAnd(euse, 0x4000000000000000), 0) ThenBlock: {
                            xl = CAD_Store.Read(ov, 0)
                            yl = CAD_Store.Read(ov, 1)
                            zl = CAD_Store.Read(ov, 2)
                            xw = Float_Add(CadAppRev.x0, Float_Add(Float_Mul(xl, CadAppRev.nx), Float_Mul(zl, CadAppRev.ux)))
                            yw = Float_Add(CadAppRev.y0, Float_Add(Float_Mul(xl, CadAppRev.ny), Float_Mul(zl, CadAppRev.uy)))
                            CAD_Store.Write(ov, 0, xw)
                            CAD_Store.Write(ov, 1, yw)
                            CAD_Store.Write(ov, 2, yl)
                            CAD_Store.Write(ov, 3, BitwiseOr(euse, 0x4000000000000000))
                        }
                        ce = CAD_Store.Read(ce, 2)
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                        IfCondition GreaterThan(cguard, 256) ThenBlock: { cdone = 1 }
                    }
                    lp = CAD_Store.Read(lp, 2)
                    lguard = Add(lguard, 1)
                    IfCondition GreaterThan(lguard, 16) ThenBlock: { lp = 0 }
                }
                face = CAD_Store.Read(face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 4096) ThenBlock: { face = 0 }
            }
            shell = CAD_Store.Read(shell, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { shell = 0 }
        }
        // clear mark bits
        shell = CAD_Store.Read(solid_handle, 0)
        sguard = 0
        WhileLoop NotEqual(shell, 0) {
            face = CAD_Store.Read(shell, 0)
            fguard = 0
            WhileLoop NotEqual(face, 0) {
                lp = CAD_Store.Read(face, 1)
                WhileLoop NotEqual(lp, 0) {
                    hd = CAD_Store.Read(lp, 0)
                    ce = hd
                    cdone = 0
                    cguard = 0
                    WhileLoop EqualTo(cdone, 0) {
                        ov = CAD_Store.Read(ce, 5)
                        euse = CAD_Store.Read(ov, 3)
                        CAD_Store.Write(ov, 3, BitwiseAnd(euse, 0xBFFFFFFFFFFFFFFF))
                        ce = CAD_Store.Read(ce, 2)
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                        IfCondition GreaterThan(cguard, 256) ThenBlock: { cdone = 1 }
                    }
                    lp = CAD_Store.Read(lp, 2)
                }
                face = CAD_Store.Read(face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 4096) ThenBlock: { face = 0 }
            }
            shell = CAD_Store.Read(shell, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { shell = 0 }
        }
        ReturnValue(0)
    }
}

// Revolve selected profile about a USER-PICKED sketch line.
// No auto-hinge, no AABB, no |X| fold. Axis must be clicked (tool 11).
// rho = signed distance to the axis; along-axis = projection.
// Lathe is then mapped back so the sketch stays the generating section.
Function.CA_RevolveFromSketch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: revolve needs sketch\n", 30)
            ReturnValue(-1)
        }
        sk_nprof = CAD_Store.Read(CadApp.sketch, 12)
        IfCondition EqualTo(sk_nprof, 0) ThenBlock: {
            sk_nprof = CA_RebuildProfiles()
        }
        CadApp.nprof = sk_nprof
        IfCondition EqualTo(sk_nprof, 0) ThenBlock: {
            CA_Log("cad_app: revolve FAIL - no closed profile\n", 42)
            CA_Log("  draw profile; axis = Y-axis or a vertical line; Profiles then Rev\n", 68)
            ReturnValue(-2)
        }
        IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
            CA_Log("cad_app: revolve FAIL - pick a profile first\n", 45)
            ReturnValue(-3)
        }
        IfCondition EqualTo(CadApp.prof_mask, 0) ThenBlock: {
            CA_Log("cad_app: revolve FAIL - nothing selected\n", 41)
            ReturnValue(-3)
        }
        IfCondition EqualTo(CadAppRev.ok, 0) ThenBlock: {
            CadApp.tool = 11
            CadApp.mode = 1
            CadApp.nclick = 0
            CA_Log("cad_app: revolve - click a sketch LINE for the axis\n", 52)
            CA_Log("  any profile edge or construction line; then it lathes\n", 56)
            ReturnValue(-4)
        }
        // largest selected = revolve profile (true verts, not AABB)
        xy = Allocate(65536)
        oxy = Allocate(65536)
        outer_i = -1
        outer_a = 0
        outer_nn = 0
        pi = 0
        WhileLoop LessThan(pi, sk_nprof) {
            IfCondition LessThan(pi, 32) ThenBlock: {
                bit = LeftShift(1, pi)
                IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: {
                    nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                    IfCondition GreaterEqual(nn, 3) ThenBlock: {
                        ar = CAD_Sketch.LoopSignedArea(xy, nn)
                        IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                        better = 0
                        IfCondition EqualTo(outer_i, -1) ThenBlock: { better = 1 }
                        IfCondition EqualTo(Float_Le(outer_a, ar), 1) ThenBlock: {
                            IfCondition NotEqual(pi, outer_i) ThenBlock: { better = 1 }
                        }
                        IfCondition EqualTo(better, 1) ThenBlock: {
                            outer_i = pi
                            outer_a = ar
                            outer_nn = nn
                            k = 0
                            WhileLoop LessThan(k, nn) {
                                ArraySet(oxy, Multiply(k, 2), ArrayGet(xy, Multiply(k, 2)))
                                ArraySet(oxy, Add(Multiply(k, 2), 1), ArrayGet(xy, Add(Multiply(k, 2), 1)))
                                k = Add(k, 1)
                            }
                        }
                    }
                }
            }
            pi = Add(pi, 1)
        }
        IfCondition LessThan(outer_i, 0) ThenBlock: {
            Deallocate(xy, 65536)
            Deallocate(oxy, 65536)
            CA_Log("cad_app: revolve FAIL - nothing selected\n", 41)
            ReturnValue(-2)
        }
        onn = outer_nn
        oaddr = oxy
        PrintMessage("cad_app: revolve prof=")
        PrintNumber(outer_i)
        PrintMessage(" nn=")
        PrintNumber(onn)
        PrintMessage("\n")
        // picked axis → unit dir u, left normal n
        ax0 = CadAppRev.x0
        ay0 = CadAppRev.y0
        adx = Float_Sub(CadAppRev.x1, ax0)
        ady = Float_Sub(CadAppRev.y1, ay0)
        aln = CAD_Num.Sqrt(Float_Add(Float_Mul(adx, adx), Float_Mul(ady, ady)))
        IfCondition EqualTo(CAD_Num.IsZero(aln, 0), 1) ThenBlock: {
            Deallocate(xy, 65536)
            Deallocate(oxy, 65536)
            CadAppRev.ok = 0
            CA_Log("cad_app: revolve FAIL - zero-length axis\n", 41)
            ReturnValue(-3)
        }
        ux = Float_Div(adx, aln)
        uy = Float_Div(ady, aln)
        nx = Float_Sub(0, uy)
        ny = ux
        CA_LogInt("cad_app: revolve axis x0=", 25, Float_ToInt(ax0))
        CA_LogInt("cad_app: revolve axis y0=", 25, Float_ToInt(ay0))
        CA_LogInt("cad_app: revolve axis x1=", 25, Float_ToInt(CadAppRev.x1))
        CA_LogInt("cad_app: revolve axis y1=", 25, Float_ToInt(CadAppRev.y1))
        // signed side vs axis; all verts one side (on-axis OK)
        nL = 0
        nR = 0
        k = 0
        WhileLoop LessThan(k, onn) {
            vx = Float_Sub(ArrayGet(oaddr, Multiply(k, 2)), ax0)
            vy = Float_Sub(ArrayGet(oaddr, Add(Multiply(k, 2), 1)), ay0)
            side = Float_Add(Float_Mul(vx, nx), Float_Mul(vy, ny))
            IfCondition EqualTo(CAD_Num.IsZero(side, 0), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsNeg(side), 1) ThenBlock: { nL = Add(nL, 1) }
                IfCondition EqualTo(CAD_Num.IsNeg(side), 0) ThenBlock: { nR = Add(nR, 1) }
            }
            k = Add(k, 1)
        }
        IfCondition GreaterThan(nL, 0) ThenBlock: {
            IfCondition GreaterThan(nR, 0) ThenBlock: {
                Deallocate(xy, 65536)
                Deallocate(oxy, 65536)
                CA_Log("cad_app: revolve FAIL - profile crosses axis\n", 45)
                CA_Log("  pick a different line; profile must stay on one side\n", 55)
                ReturnValue(-3)
            }
        }
        flip = 0
        IfCondition GreaterThan(nL, 0) ThenBlock: { flip = 1 }
        // n must point at the profile so θ=0 is the generating sketch section
        IfCondition EqualTo(flip, 1) ThenBlock: {
            nx = Float_Sub(0, nx)
            ny = Float_Sub(0, ny)
        }
        rz = Allocate(16384)
        k = 0
        nout = 0
        rmin = 0
        rmax = 0
        first = 1
        WhileLoop LessThan(k, onn) {
            px = ArrayGet(oaddr, Multiply(k, 2))
            py = ArrayGet(oaddr, Add(Multiply(k, 2), 1))
            vx = Float_Sub(px, ax0)
            vy = Float_Sub(py, ay0)
            along = Float_Add(Float_Mul(vx, ux), Float_Mul(vy, uy))
            side = Float_Add(Float_Mul(vx, nx), Float_Mul(vy, ny))
            IfCondition EqualTo(CAD_Num.IsNeg(side), 1) ThenBlock: { side = 0 }
            keep = 1
            IfCondition GreaterThan(nout, 0) ThenBlock: {
                pr = ArrayGet(rz, Multiply(Subtract(nout, 1), 2))
                pz = ArrayGet(rz, Add(Multiply(Subtract(nout, 1), 2), 1))
                IfCondition EqualTo(CAD_Num.IsEqual(side, pr, 0), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(along, pz, 0), 1) ThenBlock: { keep = 0 }
                }
            }
            IfCondition EqualTo(keep, 1) ThenBlock: {
                ArraySet(rz, Multiply(nout, 2), side)
                ArraySet(rz, Add(Multiply(nout, 2), 1), along)
                nout = Add(nout, 1)
                IfCondition EqualTo(first, 1) ThenBlock: {
                    rmin = side
                    rmax = side
                    first = 0
                }
                IfCondition EqualTo(Float_Le(side, rmin), 1) ThenBlock: { rmin = side }
                IfCondition EqualTo(Float_Le(rmax, side), 1) ThenBlock: { rmax = side }
            }
            k = Add(k, 1)
        }
        IfCondition LessThan(nout, 3) ThenBlock: {
            Deallocate(xy, 65536)
            Deallocate(oxy, 65536)
            Deallocate(rz, 16384)
            CA_Log("cad_app: revolve FAIL - degenerate RZ section\n", 46)
            ReturnValue(-3)
        }
        IfCondition EqualTo(CAD_Num.IsZero(rmax, 0), 1) ThenBlock: {
            Deallocate(xy, 65536)
            Deallocate(oxy, 65536)
            Deallocate(rz, 16384)
            CA_Log("cad_app: revolve FAIL - zero radius (profile on axis)\n", 54)
            CA_Log("  offset profile from axis, or draw vertical axis line\n", 55)
            ReturnValue(-3)
        }
        CA_LogInt("cad_app: revolve lathe n=", 25, nout)
        CA_LogInt("cad_app: revolve rmin=", 22, Float_ToInt(rmin))
        CA_LogInt("cad_app: revolve rmax=", 22, Float_ToInt(rmax))
        outh = Allocate(16)
        CAD_Topo_Lathe.ox = ax0
        CAD_Topo_Lathe.oy = ay0
        CAD_Topo_Lathe.oz = 0
        CAD_Topo_Lathe.ux = ux
        CAD_Topo_Lathe.uy = uy
        CAD_Topo_Lathe.uz = 0
        CAD_Topo_Lathe.nx = nx
        CAD_Topo_Lathe.ny = ny
        CAD_Topo_Lathe.nz = 0
        IfCondition LessThan(CadApp.rev_deg, 1) ThenBlock: { CadApp.rev_deg = 360 }
        IfCondition GreaterThan(CadApp.rev_deg, 360) ThenBlock: { CadApp.rev_deg = 360 }
        CAD_Topo_Lathe.sweep = CadApp.rev_deg
        h = CAD_Topo.MakeLatheRevolution(rz, nout, outh)
        Deallocate(outh, 16)
        Deallocate(xy, 65536)
        Deallocate(oxy, 65536)
        Deallocate(rz, 16384)
        IfCondition EqualTo(h, 0) ThenBlock: {
            CA_Log("cad_app: revolve FAIL (kernel lathe)\n", 37)
            ReturnValue(-2)
        }
        CAD_View.InvalidateMesh()
        CadApp.solid = h
        CadApp.dirty = 1
        CadApp.mode = 0
        CadApp.tool = 0
        CadApp.wire = 0
        CAD_View.SetWire(0)
        CA_LogInt("cad_app: revolve sketch=", 24, CadApp.sketch)
        CA_LogInt("cad_app: revolve nout=", 22, nout)
        IfCondition EqualTo(CadApp.rev_edit, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                IfCondition GreaterEqual(CadApp.feat_sel, 0) ThenBlock: {
                    ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.rev_deg)
                }
            }
            CadApp.last_revf = CadApp.feat_sel
        }
        IfCondition EqualTo(CadApp.rev_edit, 0) ThenBlock: {
            CA_FeatAdd(2, CA_CurrentSkIdx())
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.rev_deg)
            }
            CadApp.last_revf = CadApp.feat_sel
            CA_HudOpenRev()
        }
        CA_Log("cad_app: revolve OK (profile lathe)\n", 36)
        ReturnValue(0)
    }
}

// ExtrudeCut current/hole sketch into existing solid (through height).


// ExtrudeCut current/hole sketch into existing solid (through height).
Function.CA_CutFromSketch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_Log("cad_app: cut needs a solid (extrude first)\n", 43)
            ReturnValue(-1)
        }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: cut needs a sketch\n", 28)
            ReturnValue(-1)
        }
        CadApp.extrude_op = 1
        IfCondition LessThan(CadApp.height, 0) ThenBlock: {
            CadApp.height = Subtract(0, CadApp.height)
        }
        IfCondition LessThan(CadApp.height, 1) ThenBlock: { CadApp.height = 10 }
        CA_HudOpenPad()
        CA_Log("cad_app: cut - type depth, Enter (Tab JOIN/CUT/NEW)\n", 52)
        ReturnValue(0)
    }
}


Function.CA_ImportDxf {
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(0) }
        out = Allocate(16)
        rc = CAD_DXF.ImportFile(path, out)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            Deallocate(out, 16)
            CA_Log("cad_app: DXF import FAIL\n", 25)
            ReturnValue(0)
        }
        h = ArrayGet(out, 0)
        Deallocate(out, 16)
        ReturnValue(h)
    }
}


Function.CA_LoadDxfToSketch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.dxf_path, 0) ThenBlock: { ReturnValue(-1) }
        // drop previous solid so viewport does not keep last pad while loading
        CadApp.solid = 0
        CadApp.sketch = CA_ImportDxf(CadApp.dxf_path)
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        CadApp.hole_sk = 0
        IfCondition NotEqual(CadApp.hole_path, 0) ThenBlock: {
            CadApp.hole_sk = CA_ImportDxf(CadApp.hole_path)
            IfCondition EqualTo(CadApp.hole_sk, 0) ThenBlock: {
                CA_Log("cad_app: hole DXF FAIL\n", 23)
                ReturnValue(-1)
            }
        }
        // file import: auto pad outer (+ holes) — not interactive selection
        CadApp.auto_pad = 1
        CadApp.prof_user = 0
        rc = CA_BuildSolid()
        CadApp.auto_pad = 0
        ReturnValue(rc)
    }
}


Function.CA_ReloadDxf {
    Output: Integer
    Body: {
        CA_Log("cad_app: reload DXF\n", 20)
        ReturnValue(CA_LoadDxfToSketch())
    }
}

// Import DXF from /tmp/cad_app/path.txt (file dialog / agent sets path).


// Import DXF from /tmp/cad_app/path.txt (file dialog / agent sets path).
Function.CA_ImportFromPathFile {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.path_buf, 0) ThenBlock: {
            CadApp.path_buf = Allocate(512)
        }
        fd = SystemCall(2, "/tmp/cad_app/path.txt", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            CA_Log("cad_app: import needs path.txt\n", 31)
            ReturnValue(-1)
        }
        n = SystemCall(0, fd, CadApp.path_buf, 511)
        SystemCall(3, fd, 0, 0)
        IfCondition LessThan(n, 1) ThenBlock: {
            CA_Log("cad_app: path.txt empty\n", 24)
            ReturnValue(-1)
        }
        // strip trailing CR/LF/space
        done = 0
        WhileLoop EqualTo(done, 0) {
            IfCondition LessEqual(n, 0) ThenBlock: { done = 1 }
            IfCondition EqualTo(done, 0) ThenBlock: {
                c = GetByte(CadApp.path_buf, Subtract(n, 1))
                IfCondition EqualTo(c, 10) ThenBlock: { n = Subtract(n, 1) }
                IfCondition EqualTo(c, 13) ThenBlock: { n = Subtract(n, 1) }
                IfCondition EqualTo(c, 32) ThenBlock: { n = Subtract(n, 1) }
                IfCondition NotEqual(c, 10) ThenBlock: {
                    IfCondition NotEqual(c, 13) ThenBlock: {
                        IfCondition NotEqual(c, 32) ThenBlock: { done = 1 }
                    }
                }
            }
        }
        IfCondition LessEqual(n, 0) ThenBlock: {
            CA_Log("cad_app: path.txt empty\n", 24)
            ReturnValue(-1)
        }
        SetByte(CadApp.path_buf, n, 0)
        CadApp.dxf_path = CadApp.path_buf
        CA_Log("cad_app: import path\n", 21)
        ReturnValue(CA_LoadDxfToSketch())
    }
}

// HUD channel for presenter (upper-right). Kernel owns numbers.
