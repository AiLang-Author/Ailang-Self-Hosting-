LibraryImport.Display.Render.Framebuffer
LibraryImport.StringUtils

Function.CA_PromoteOuterHoles {
    Output: Integer
    Body: {
        CadAppPad.choles = 0
        IfCondition LessThan(CAD_Topo_Sweep.ncont, 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CA_WireEnsure(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CA_Wire.remap, 0) ThenBlock: { ReturnValue(0) }
        CA_Wire.outer = Subtract(0, 1)
        CA_LogInt("sol: ncont raw=", 15, CAD_Topo_Sweep.ncont)
        CA_LogInt("sol: ncurve=", 12, CAD_Topo_Sweep.ncurve)
        CA_LogInt("sol: pick nn=", 13, CadAppPick.prof_nn)
        IfCondition GreaterThan(CadAppPick.prof_nn, 0) ThenBlock: {
            CA_Wire.px = ArrayGet(CadAppPad.oxy, 0)
            CA_Wire.py = ArrayGet(CadAppPad.oxy, 1)
            CA_LogF("sol: pick x=", 12, CA_Wire.px)
            CA_LogF("sol: pick y=", 12, CA_Wire.py)
            CA_Wire.w = 0
            WhileLoop LessThan(CA_Wire.w, CAD_Topo_Sweep.ncont) {
                CA_Wire.ok = CA_PtOnWire(CA_Wire.w, CA_Wire.px, CA_Wire.py)
                CA_LogInt("sol: onwire w=", 14, CA_Wire.w)
                CA_LogInt(" hit=", 5, CA_Wire.ok)
                IfCondition EqualTo(CA_Wire.ok, 1) ThenBlock: {
                    CA_Wire.outer = CA_Wire.w
                    CA_Wire.w = CAD_Topo_Sweep.ncont
                }
                IfCondition NotEqual(CA_Wire.outer, CA_Wire.w) ThenBlock: {
                    IfCondition LessThan(CA_Wire.w, CAD_Topo_Sweep.ncont) ThenBlock: {
                        CA_Wire.w = Add(CA_Wire.w, 1)
                    }
                }
            }
        }
        IfCondition LessThan(CA_Wire.outer, 0) ThenBlock: {
            CA_Wire.best = 0
            CA_Wire.w = 0
            WhileLoop LessThan(CA_Wire.w, CAD_Topo_Sweep.ncont) {
                CA_Wire.area = CA_WireArea(CA_Wire.w)
                IfCondition EqualTo(Float_Le(CA_Wire.area, CA_Wire.best), 0) ThenBlock: {
                    CA_Wire.best = CA_Wire.area
                    CA_Wire.outer = CA_Wire.w
                }
                CA_Wire.w = Add(CA_Wire.w, 1)
            }
        }
        IfCondition LessThan(CA_Wire.outer, 0) ThenBlock: {
            // Pick was a fill click — first profile vert missed every wire.
            // Use the smallest live wire that contains that point.
            IfCondition GreaterThan(CadAppPick.prof_nn, 0) ThenBlock: {
                CA_Wire.px = ArrayGet(CadAppPad.oxy, 0)
                CA_Wire.py = ArrayGet(CadAppPad.oxy, 1)
                CA_Wire.best = 0
                CA_Wire.w = 0
                WhileLoop LessThan(CA_Wire.w, CAD_Topo_Sweep.ncont) {
                    IfCondition EqualTo(CA_WireContains(CA_Wire.w, CA_Wire.px, CA_Wire.py), 1) ThenBlock: {
                        CA_Wire.area = CA_WireArea(CA_Wire.w)
                        IfCondition EqualTo(CAD_Num.IsNeg(CA_Wire.area), 1) ThenBlock: { CA_Wire.area = Float_Sub(0, CA_Wire.area) }
                        IfCondition EqualTo(CA_Wire.best, 0) ThenBlock: {
                            CA_Wire.best = CA_Wire.area
                            CA_Wire.outer = CA_Wire.w
                        }
                        IfCondition EqualTo(Float_Le(CA_Wire.area, CA_Wire.best), 1) ThenBlock: {
                            CA_Wire.best = CA_Wire.area
                            CA_Wire.outer = CA_Wire.w
                        }
                    }
                    CA_Wire.w = Add(CA_Wire.w, 1)
                }
                CA_LogInt("cad_app: sweep pick-inside outer=", 32, CA_Wire.outer)
            }
        }
        IfCondition LessThan(CA_Wire.outer, 0) ThenBlock: { ReturnValue(0) }
        CA_LogInt("cad_app: sweep outer wire=", 26, CA_Wire.outer)
        CA_Wire.w = 0
        WhileLoop LessThan(CA_Wire.w, CAD_Topo_Sweep.ncont) {
            ArraySet(CA_Wire.remap, CA_Wire.w, 32)
            CA_Wire.w = Add(CA_Wire.w, 1)
        }
        ArraySet(CA_Wire.remap, CA_Wire.outer, 0)
        CA_Wire.w = 0
        WhileLoop LessThan(CA_Wire.w, CAD_Topo_Sweep.ncont) {
            IfCondition NotEqual(CA_Wire.w, CA_Wire.outer) ThenBlock: {
                CA_WireSample(CA_Wire.w)
                CA_LogInt("sol: holecand w=", 16, CA_Wire.w)
                CA_LogF(" sx=", 4, CA_Wire.px)
                CA_LogF(" sy=", 4, CA_Wire.py)
                CA_Wire.ok = CA_WireContains(CA_Wire.outer, CA_Wire.px, CA_Wire.py)
                CA_LogInt(" in_outer=", 10, CA_Wire.ok)
                IfCondition EqualTo(CA_Wire.ok, 1) ThenBlock: {
                    // Even-odd: a loop inside another hole is an island
                    // (solid), not a hole in the plate. Merging it slashes
                    // across the parent hole. Do not punch it as an inner.
                    CA_Wire.ex = CA_Wire.px
                    CA_Wire.ey = CA_Wire.py
                    CA_Wire.nv = 0
                    CA_Wire.b = 0
                    WhileLoop LessThan(CA_Wire.b, CAD_Topo_Sweep.ncont) {
                        IfCondition NotEqual(CA_Wire.b, CA_Wire.outer) ThenBlock: {
                            IfCondition NotEqual(CA_Wire.b, CA_Wire.w) ThenBlock: {
                                IfCondition EqualTo(CA_WireContains(CA_Wire.b, CA_Wire.ex, CA_Wire.ey), 1) ThenBlock: {
                                    CA_Wire.nv = 1
                                }
                            }
                        }
                        CA_Wire.b = Add(CA_Wire.b, 1)
                    }
                    IfCondition EqualTo(CA_Wire.nv, 0) ThenBlock: {
                        CadAppPad.choles = Add(CadAppPad.choles, 1)
                        ArraySet(CA_Wire.remap, CA_Wire.w, CadAppPad.choles)
                        CA_LogInt("cad_app: sweep hole wire=", 25, CA_Wire.w)
                    }
                    IfCondition EqualTo(CA_Wire.nv, 1) ThenBlock: {
                        // Inside some other inner wire. Plate keeps only the
                        // first hole. Deeper rings are islands or holes in them.
                        ArraySet(CA_Wire.remap, CA_Wire.w, 64)
                        CA_LogInt("cad_app: sweep island wire=", 26, CA_Wire.w)
                    }
                }
            }
            CA_Wire.w = Add(CA_Wire.w, 1)
        }
        // depth = other inner wires that contain this one. Odd = island body.
        // Even and greater than 0 = a hole in that island. Parent = tightest.
        CadAppPad.base = Allocate(256)
        CadAppPad.sp = Allocate(256)
        CA_Wire.w = 0
        WhileLoop LessThan(CA_Wire.w, CAD_Topo_Sweep.ncont) {
            ArraySet(CadAppPad.base, CA_Wire.w, 0)
            ArraySet(CadAppPad.sp, CA_Wire.w, CA_Wire.outer)
            CA_Wire.w = Add(CA_Wire.w, 1)
        }
        CA_Wire.w = 0
        WhileLoop LessThan(CA_Wire.w, CAD_Topo_Sweep.ncont) {
            IfCondition NotEqual(CA_Wire.w, CA_Wire.outer) ThenBlock: {
                IfCondition EqualTo(ArrayGet(CA_Wire.remap, CA_Wire.w), 64) ThenBlock: {
                    CA_WireSample(CA_Wire.w)
                    CadAppPad.cx = CA_Wire.px
                    CadAppPad.cy = CA_Wire.py
                    CadAppPad.dx = 0
                    CadAppPad.dy = CA_Wire.outer
                    CadAppPad.r = 0
                    CA_Wire.b = 0
                    WhileLoop LessThan(CA_Wire.b, CAD_Topo_Sweep.ncont) {
                        IfCondition NotEqual(CA_Wire.b, CA_Wire.outer) ThenBlock: {
                            IfCondition NotEqual(CA_Wire.b, CA_Wire.w) ThenBlock: {
                                IfCondition EqualTo(CA_WireContains(CA_Wire.b, CadAppPad.cx, CadAppPad.cy), 1) ThenBlock: {
                                    CadAppPad.dx = Add(CadAppPad.dx, 1)
                                    CadAppPad.sr = CA_WireArea(CA_Wire.b)
                                    CadAppPad.ok = 0
                                    IfCondition EqualTo(CadAppPad.r, 0) ThenBlock: { CadAppPad.ok = 1 }
                                    IfCondition EqualTo(Float_Le(CadAppPad.sr, CadAppPad.r), 1) ThenBlock: {
                                        IfCondition EqualTo(Float_Le(CadAppPad.r, 0), 0) ThenBlock: { CadAppPad.ok = 1 }
                                    }
                                    IfCondition EqualTo(CadAppPad.ok, 1) ThenBlock: {
                                        CadAppPad.r = CadAppPad.sr
                                        CadAppPad.dy = CA_Wire.b
                                    }
                                }
                            }
                        }
                        CA_Wire.b = Add(CA_Wire.b, 1)
                    }
                    IfCondition EqualTo(BitwiseAnd(CadAppPad.dx, 1), 1) ThenBlock: {
                        ArraySet(CadAppPad.base, CA_Wire.w, 1)
                    }
                    IfCondition EqualTo(BitwiseAnd(CadAppPad.dx, 1), 0) ThenBlock: {
                        IfCondition GreaterThan(CadAppPad.dx, 0) ThenBlock: {
                            ArraySet(CadAppPad.base, CA_Wire.w, 2)
                        }
                    }
                    ArraySet(CadAppPad.sp, CA_Wire.w, CadAppPad.dy)
                    CA_LogInt("cad_app: island depth=", 22, CadAppPad.dx)
                    CA_LogInt(" wire=", 6, CA_Wire.w)
                    CA_LogInt(" role=", 6, ArrayGet(CadAppPad.base, CA_Wire.w))
                }
            }
            CA_Wire.w = Add(CA_Wire.w, 1)
        }
        // Snapshot island curves before compact (remap 64).
        // Word 8 is role (1 body, 2 hole). Word 9 is the parent wire.
        CadAppPad.oc = 0
        IfCondition EqualTo(CadAppPad.spliced, 0) ThenBlock: { CA_PadBufs() }
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CAD_Topo_Sweep.ncurve) {
            CA_Wire.b = ArrayGet(CA_Wire.remap, ArrayGet(CAD_Topo_Sweep.cwire, CA_Wire.i))
            IfCondition EqualTo(CA_Wire.b, 64) ThenBlock: {
                IfCondition LessThan(CadAppPad.oc, 200) ThenBlock: {
                    CA_Wire.off = Multiply(CadAppPad.oc, 10)
                    ArraySet(CadAppPad.spliced, CA_Wire.off, ArrayGet(CAD_Topo_Sweep.ckind, CA_Wire.i))
                    ArraySet(CadAppPad.spliced, Add(CA_Wire.off, 1), ArrayGet(CAD_Topo_Sweep.cx0, CA_Wire.i))
                    ArraySet(CadAppPad.spliced, Add(CA_Wire.off, 2), ArrayGet(CAD_Topo_Sweep.cy0, CA_Wire.i))
                    ArraySet(CadAppPad.spliced, Add(CA_Wire.off, 3), ArrayGet(CAD_Topo_Sweep.cx1, CA_Wire.i))
                    ArraySet(CadAppPad.spliced, Add(CA_Wire.off, 4), ArrayGet(CAD_Topo_Sweep.cy1, CA_Wire.i))
                    ArraySet(CadAppPad.spliced, Add(CA_Wire.off, 5), ArrayGet(CAD_Topo_Sweep.ca0, CA_Wire.i))
                    ArraySet(CadAppPad.spliced, Add(CA_Wire.off, 6), ArrayGet(CAD_Topo_Sweep.ca1, CA_Wire.i))
                    CA_Wire.cur = ArrayGet(CAD_Topo_Sweep.cwire, CA_Wire.i)
                    ArraySet(CadAppPad.spliced, Add(CA_Wire.off, 7), CA_Wire.cur)
                    CA_Wire.nv = ArrayGet(CadAppPad.base, CA_Wire.cur)
                    ArraySet(CadAppPad.spliced, Add(CA_Wire.off, 8), CA_Wire.nv)
                    CA_Wire.v0 = ArrayGet(CadAppPad.sp, CA_Wire.cur)
                    ArraySet(CadAppPad.spliced, Add(CA_Wire.off, 9), CA_Wire.v0)
                    CadAppPad.oc = Add(CadAppPad.oc, 1)
                }
            }
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        Deallocate(CadAppPad.base, 256)
        Deallocate(CadAppPad.sp, 256)
        CadAppPad.base = 0
        CadAppPad.sp = 0
        CA_LogInt("cad_app: sweep island curves=", 28, CadAppPad.oc)
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CAD_Topo_Sweep.ncurve) {
            ArraySet(CAD_Topo_Sweep.cwire, CA_Wire.i, ArrayGet(CA_Wire.remap, ArrayGet(CAD_Topo_Sweep.cwire, CA_Wire.i)))
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        // Drop unused (cwire==32) and islands (64) by compacting the curve list.
        CA_Wire.j = 0
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CAD_Topo_Sweep.ncurve) {
            IfCondition LessThan(ArrayGet(CAD_Topo_Sweep.cwire, CA_Wire.i), 32) ThenBlock: {
                IfCondition NotEqual(CA_Wire.i, CA_Wire.j) ThenBlock: {
                    ArraySet(CAD_Topo_Sweep.ckind, CA_Wire.j, ArrayGet(CAD_Topo_Sweep.ckind, CA_Wire.i))
                    ArraySet(CAD_Topo_Sweep.cwire, CA_Wire.j, ArrayGet(CAD_Topo_Sweep.cwire, CA_Wire.i))
                    ArraySet(CAD_Topo_Sweep.cx0, CA_Wire.j, ArrayGet(CAD_Topo_Sweep.cx0, CA_Wire.i))
                    ArraySet(CAD_Topo_Sweep.cy0, CA_Wire.j, ArrayGet(CAD_Topo_Sweep.cy0, CA_Wire.i))
                    ArraySet(CAD_Topo_Sweep.cx1, CA_Wire.j, ArrayGet(CAD_Topo_Sweep.cx1, CA_Wire.i))
                    ArraySet(CAD_Topo_Sweep.cy1, CA_Wire.j, ArrayGet(CAD_Topo_Sweep.cy1, CA_Wire.i))
                    ArraySet(CAD_Topo_Sweep.ca0, CA_Wire.j, ArrayGet(CAD_Topo_Sweep.ca0, CA_Wire.i))
                    ArraySet(CAD_Topo_Sweep.ca1, CA_Wire.j, ArrayGet(CAD_Topo_Sweep.ca1, CA_Wire.i))
                }
                CA_Wire.j = Add(CA_Wire.j, 1)
            }
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        CAD_Topo_Sweep.ncurve = CA_Wire.j
        CAD_Topo_Sweep.ncont = Add(CadAppPad.choles, 1)
        ReturnValue(CadAppPad.choles)
    }
}

// One saved curve (stride 10) onto the current sweep wire.
Function.CA_IslandReplayCurve {
    Output: Integer
    Body: {
        CA_Wire.ok = ArrayGet(CadAppPad.spliced, CA_Wire.si)
        IfCondition EqualTo(CA_Wire.ok, 0) ThenBlock: {
            CAD_Topo_Sweep.px0 = ArrayGet(CadAppPad.spliced, Add(CA_Wire.si, 1))
            CAD_Topo_Sweep.py0 = ArrayGet(CadAppPad.spliced, Add(CA_Wire.si, 2))
            CAD_Topo_Sweep.px1 = ArrayGet(CadAppPad.spliced, Add(CA_Wire.si, 3))
            CAD_Topo_Sweep.py1 = ArrayGet(CadAppPad.spliced, Add(CA_Wire.si, 4))
            CAD_Topo.SweepAddLinePinned()
        }
        IfCondition EqualTo(CA_Wire.ok, 2) ThenBlock: {
            CAD_Topo_Sweep.px0 = ArrayGet(CadAppPad.spliced, Add(CA_Wire.si, 1))
            CAD_Topo_Sweep.py0 = ArrayGet(CadAppPad.spliced, Add(CA_Wire.si, 2))
            CAD_Topo_Sweep.px1 = ArrayGet(CadAppPad.spliced, Add(CA_Wire.si, 3))
            CAD_Topo_Sweep.pa0 = ArrayGet(CadAppPad.spliced, Add(CA_Wire.si, 5))
            CAD_Topo_Sweep.pa1 = ArrayGet(CadAppPad.spliced, Add(CA_Wire.si, 6))
            CAD_Topo.SweepAddArcPinned()
        }
        ReturnValue(0)
    }
}

// Odd containment depth → its own body. Even depth above 0 → a hole of
// the tightest body that contains it. Any closed profile, any depth.
Function.CA_ExtrudeSavedIslands {
    Input: main_h: Integer
    Output: Integer
    Body: {
        CadAppPad.ok = main_h
        IfCondition EqualTo(main_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CadAppPad.oc, 1) ThenBlock: { ReturnValue(main_h) }
        IfCondition EqualTo(CadAppPad.spliced, 0) ThenBlock: { ReturnValue(main_h) }
        CA_LogInt("cad_app: island extrude ncurve=", 30, CadAppPad.oc)
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CadAppPad.oc) {
            CA_Wire.off = Multiply(CA_Wire.i, 10)
            CA_Wire.w = ArrayGet(CadAppPad.spliced, Add(CA_Wire.off, 7))
            CA_Wire.v0 = ArrayGet(CadAppPad.spliced, Add(CA_Wire.off, 8))
            IfCondition EqualTo(CA_Wire.v0, 1) ThenBlock: {
                IfCondition EqualTo(ArrayGet(CA_Wire.remap, CA_Wire.w), 64) ThenBlock: {
                    ArraySet(CA_Wire.remap, CA_Wire.w, 65)
                    CAD_Topo.SweepReset()
                    CAD_Topo_Sweep.hz = CadAppPad.hg
                    CAD_Topo.SweepBeginWire()
                    CA_Wire.j = 0
                    WhileLoop LessThan(CA_Wire.j, CadAppPad.oc) {
                        CA_Wire.si = Multiply(CA_Wire.j, 10)
                        IfCondition EqualTo(ArrayGet(CadAppPad.spliced, Add(CA_Wire.si, 7)), CA_Wire.w) ThenBlock: {
                            CA_IslandReplayCurve()
                        }
                        CA_Wire.j = Add(CA_Wire.j, 1)
                    }
                    CA_Wire.nv = Subtract(0, 1)
                    CA_Wire.j = 0
                    WhileLoop LessThan(CA_Wire.j, CadAppPad.oc) {
                        CA_Wire.si = Multiply(CA_Wire.j, 10)
                        CA_Wire.cur = ArrayGet(CadAppPad.spliced, Add(CA_Wire.si, 7))
                        CA_Wire.v0 = ArrayGet(CadAppPad.spliced, Add(CA_Wire.si, 8))
                        CA_Wire.v1 = ArrayGet(CadAppPad.spliced, Add(CA_Wire.si, 9))
                        IfCondition EqualTo(CA_Wire.v0, 2) ThenBlock: {
                            IfCondition EqualTo(CA_Wire.v1, CA_Wire.w) ThenBlock: {
                                IfCondition NotEqual(CA_Wire.cur, CA_Wire.nv) ThenBlock: {
                                    CAD_Topo.SweepBeginWire()
                                    CA_Wire.nv = CA_Wire.cur
                                    CA_LogInt("cad_app: island hole of=", 24, CA_Wire.w)
                                    CA_LogInt(" wire=", 6, CA_Wire.cur)
                                }
                                CA_IslandReplayCurve()
                            }
                        }
                        CA_Wire.j = Add(CA_Wire.j, 1)
                    }
                    CA_LogInt("cad_app: island pad wire=", 24, CA_Wire.w)
                    CA_Wire.b = CAD_Topo.ExtrudeContours()
                    IfCondition NotEqual(CA_Wire.b, 0) ThenBlock: {
                        CadAppPad.ok = CAD_Topo.CompoundAdd(CadAppPad.ok, CA_Wire.b)
                        CA_Log("cad_app: island pad OK\n", 22)
                    }
                    IfCondition EqualTo(CA_Wire.b, 0) ThenBlock: {
                        CA_Log("cad_app: island pad FAIL\n", 24)
                    }
                }
            }
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        ReturnValue(CadAppPad.ok)
    }
}

// Append CadAppPad.xy[0..nn) as the next pick-overlay ring on the live sketch.
// Does NOT AddLine — overlay only.
Function.CA_ProfAppendXY {
    Input: nn: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(nn, 3) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadAppPad.xy, 0) ThenBlock: { ReturnValue(0) }
        n_out = CAD_Store.Read(CadApp.sketch, 12)
        cap_p = CAD_Store.Read(CadApp.sketch, 15)
        IfCondition GreaterEqual(n_out, cap_p) ThenBlock: { ReturnValue(n_out) }
        pmeta = CAD_Store.Read(CadApp.sketch, 13)
        pool = CAD_Store.Read(CadApp.sketch, 14)
        IfCondition EqualTo(pmeta, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(pool, 0) ThenBlock: { ReturnValue(0) }
        pool_n = 0
        IfCondition GreaterThan(n_out, 0) ThenBlock: {
            pool_n = Add(ArrayGet(pmeta, Add(Multiply(Subtract(n_out, 1), 2), 1)), ArrayGet(pmeta, Multiply(Subtract(n_out, 1), 2)))
        }
        ArraySet(pmeta, Multiply(n_out, 2), nn)
        ArraySet(pmeta, Add(Multiply(n_out, 2), 1), pool_n)
        CadAppPad.r = 0
        WhileLoop LessThan(CadAppPad.r, nn) {
            ArraySet(pool, Multiply(Add(pool_n, CadAppPad.r), 2), ArrayGet(CadAppPad.xy, Multiply(CadAppPad.r, 2)))
            ArraySet(pool, Add(Multiply(Add(pool_n, CadAppPad.r), 2), 1), ArrayGet(CadAppPad.xy, Add(Multiply(CadAppPad.r, 2), 1)))
            CadAppPad.r = Add(CadAppPad.r, 1)
        }
        n_out = Add(n_out, 1)
        CAD_Store.Write(CadApp.sketch, 12, n_out)
        ReturnValue(n_out)
    }
}

Function.CA_ProfAppendLivePath {
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_PadBufs(), 0) ThenBlock: { ReturnValue(0) }
        CadAppPad.oc = 0
        CA_Wire.si = 0
        WhileLoop LessThan(CA_Wire.si, CA_Wire.npath) {
            CA_Wire.cur = ArrayGet(CA_Wire.path_s, CA_Wire.si)
            CA_Wire.v0 = ArrayGet(CA_Wire.he_a, CA_Wire.cur)
            CA_Wire.v1 = ArrayGet(CA_Wire.he_b, CA_Wire.cur)
            IfCondition EqualTo(ArrayGet(CA_Wire.path_k, CA_Wire.si), 0) ThenBlock: {
                IfCondition LessThan(CadAppPad.oc, 2000) ThenBlock: {
                    ArraySet(CadAppPad.xy, Multiply(CadAppPad.oc, 2), ArrayGet(CA_Wire.vx, CA_Wire.v0))
                    ArraySet(CadAppPad.xy, Add(Multiply(CadAppPad.oc, 2), 1), ArrayGet(CA_Wire.vy, CA_Wire.v0))
                    CadAppPad.oc = Add(CadAppPad.oc, 1)
                }
            }
            IfCondition EqualTo(ArrayGet(CA_Wire.path_k, CA_Wire.si), 2) ThenBlock: {
                CA_WireArcEnds(ArrayGet(CA_Wire.path_i, CA_Wire.si))
                CA_Wire.dang = Float_Sub(CA_Wire.a1, CA_Wire.a0)
                IfCondition EqualTo(Float_Le(CA_Wire.dang, 0), 1) ThenBlock: {
                    CA_Wire.dang = Float_Add(CA_Wire.dang, 0x401921FB54442D18)
                }
                IfCondition NotEqual(ArrayGet(CA_Wire.path_r, CA_Wire.si), 0) ThenBlock: {
                    CA_Wire.dang = Float_Sub(0, CA_Wire.dang)
                }
                CA_Wire.a0 = CAD_Geom.Atan2(Float_Sub(ArrayGet(CA_Wire.vy, CA_Wire.v0), CA_Wire.cy), Float_Sub(ArrayGet(CA_Wire.vx, CA_Wire.v0), CA_Wire.cx))
                CA_Wire.j = 0
                WhileLoop LessThan(CA_Wire.j, 16) {
                    IfCondition LessThan(CadAppPad.oc, 2000) ThenBlock: {
                        CA_Wire.rev = Float_Div(Float_FromInt(CA_Wire.j), 0x4030000000000000)
                        CA_Wire.best = Float_Add(CA_Wire.a0, Float_Mul(CA_Wire.dang, CA_Wire.rev))
                        ArraySet(CadAppPad.xy, Multiply(CadAppPad.oc, 2), Float_Add(CA_Wire.cx, Float_Mul(CA_Wire.r, CAD_Geom.Cos(CA_Wire.best))))
                        ArraySet(CadAppPad.xy, Add(Multiply(CadAppPad.oc, 2), 1), Float_Add(CA_Wire.cy, Float_Mul(CA_Wire.r, CAD_Geom.Sin(CA_Wire.best))))
                        CadAppPad.oc = Add(CadAppPad.oc, 1)
                    }
                    CA_Wire.j = Add(CA_Wire.j, 1)
                }
            }
            CA_Wire.si = Add(CA_Wire.si, 1)
        }
        ReturnValue(CA_ProfAppendXY(CadAppPad.oc))
    }
}

// Profile overlay from ProfIR (PARSE/ANALYZE/CHAIN/SOLVE). Live entities stay.
Function.CA_RebuildProfilesLive {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Sketch.ProfCompile(CadApp.sketch))
    }
}

// Selected profile is one full circle, and the sketch also has lines
// (an on-face outline). Emit that circle as one 2π arc. Do not sweep
// every circle in the sketch. Returns 1 when the arc was added.
Function.CA_SweepOneCircle {
    Input: oi: Integer
    Output: Integer
    Body: {
        CadAppPad.oc = oi
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadAppPad.xy, 0) ThenBlock: {
            IfCondition NotEqual(CA_PadBufs(), 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(CadAppPad.xy, 0) ThenBlock: { ReturnValue(0) }
        CadAppPad.nn = CAD_Sketch.GetProfileXY(CadApp.sketch, CadAppPad.oc, CadAppPad.xy)
        IfCondition LessThan(CadAppPad.nn, 8) ThenBlock: { ReturnValue(0) }
        CadAppPad.cx = 0
        CadAppPad.cy = 0
        CadAppPad.ci = 0
        WhileLoop LessThan(CadAppPad.ci, CadAppPad.nn) {
            CadAppPad.base = Multiply(CadAppPad.ci, 2)
            CadAppPad.dx = ArrayGet(CadAppPad.xy, CadAppPad.base)
            CadAppPad.base = Add(CadAppPad.base, 1)
            CadAppPad.dy = ArrayGet(CadAppPad.xy, CadAppPad.base)
            CadAppPad.cx = Float_Add(CadAppPad.cx, CadAppPad.dx)
            CadAppPad.cy = Float_Add(CadAppPad.cy, CadAppPad.dy)
            CadAppPad.ci = Add(CadAppPad.ci, 1)
        }
        CadAppPad.sr = Float_FromInt(CadAppPad.nn)
        CadAppPad.cx = Float_Div(CadAppPad.cx, CadAppPad.sr)
        CadAppPad.cy = Float_Div(CadAppPad.cy, CadAppPad.sr)
        CadAppPad.dx = ArrayGet(CadAppPad.xy, 0)
        CadAppPad.dy = ArrayGet(CadAppPad.xy, 1)
        CadAppPad.dx = Float_Sub(CadAppPad.dx, CadAppPad.cx)
        CadAppPad.dy = Float_Sub(CadAppPad.dy, CadAppPad.cy)
        CadAppPad.r = CAD_Num.Hypot2(CadAppPad.dx, CadAppPad.dy)
        IfCondition EqualTo(CAD_Num.IsZero(CadAppPad.r, 0), 1) ThenBlock: { ReturnValue(0) }
        CadAppPad.ci = Divide(CadAppPad.nn, 4)
        CadAppPad.base = Multiply(CadAppPad.ci, 2)
        CadAppPad.dx = ArrayGet(CadAppPad.xy, CadAppPad.base)
        CadAppPad.base = Add(CadAppPad.base, 1)
        CadAppPad.dy = ArrayGet(CadAppPad.xy, CadAppPad.base)
        CadAppPad.dx = Float_Sub(CadAppPad.dx, CadAppPad.cx)
        CadAppPad.dy = Float_Sub(CadAppPad.dy, CadAppPad.cy)
        CadAppPad.sr = CAD_Num.Hypot2(CadAppPad.dx, CadAppPad.dy)
        CadAppPad.sr = CAD_Num.Abs(Float_Sub(CadAppPad.sr, CadAppPad.r))
        IfCondition EqualTo(Float_Le(CadAppPad.sr, 0x3FA999999999999A), 0) ThenBlock: { ReturnValue(0) }
        CadAppPad.circs = CAD_Store.Read(CadApp.sketch, 8)
        CadAppPad.nn = CAD_Store.Read(CadApp.sketch, 7)
        IfCondition EqualTo(CadAppPad.circs, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CadAppPad.nn, 1) ThenBlock: { ReturnValue(0) }
        CadAppPad.ci = 0
        WhileLoop LessThan(CadAppPad.ci, CadAppPad.nn) {
            CadAppPad.base = Multiply(CadAppPad.ci, 3)
            CadAppPad.dx = ArrayGet(CadAppPad.circs, CadAppPad.base)
            CadAppPad.base = Add(CadAppPad.base, 1)
            CadAppPad.dy = ArrayGet(CadAppPad.circs, CadAppPad.base)
            CadAppPad.base = Add(CadAppPad.base, 1)
            CadAppPad.sr = ArrayGet(CadAppPad.circs, CadAppPad.base)
            CadAppPad.dx = Float_Sub(CadAppPad.dx, CadAppPad.cx)
            CadAppPad.dy = Float_Sub(CadAppPad.dy, CadAppPad.cy)
            CadAppPad.dx = Float_Add(Float_Mul(CadAppPad.dx, CadAppPad.dx), Float_Mul(CadAppPad.dy, CadAppPad.dy))
            CadAppPad.dy = CAD_Num.Abs(Float_Sub(CadAppPad.sr, CadAppPad.r))
            CadAppPad.base = 0
            IfCondition EqualTo(Float_Le(CadAppPad.dx, 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(CadAppPad.dy, 0x3FA999999999999A), 1) ThenBlock: {
                    CadAppPad.base = 1
                }
            }
            IfCondition EqualTo(CadAppPad.base, 1) ThenBlock: {
                CadAppPad.base = Multiply(CadAppPad.ci, 3)
                CAD_Topo_Sweep.px0 = ArrayGet(CadAppPad.circs, CadAppPad.base)
                CadAppPad.base = Add(CadAppPad.base, 1)
                CAD_Topo_Sweep.py0 = ArrayGet(CadAppPad.circs, CadAppPad.base)
                CadAppPad.base = Add(CadAppPad.base, 1)
                CAD_Topo_Sweep.px1 = ArrayGet(CadAppPad.circs, CadAppPad.base)
                CAD_Topo_Sweep.pa0 = 0
                CAD_Topo_Sweep.pa1 = 0x401921FB54442D18
                CAD_Topo.SweepAddArcPinned()
                CA_LogInt("cad_app: sweep analytic circle n=", 34, 1)
                ReturnValue(1)
            }
            CadAppPad.ci = Add(CadAppPad.ci, 1)
        }
        ReturnValue(0)
    }
}

// Any closed profile whose center sits inside the outer ring is a through
// hole on this same sweep. Same wire as the outer: plex lines and arcs,
// then one full circle, then the ring vertices. Not a per-shape recipe.
// Circles-only sketches already emit every circle (lone=1).
Function.CA_SweepChildWires {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppPad.lone, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CA_PadBufs(), 0) ThenBlock: { ReturnValue(0) }
        CadAppPad.ns = CadAppPad.oc
        CadAppPad.nn = CAD_Sketch.GetProfileXY(CadApp.sketch, CadAppPad.ns, CadAppPad.oxy)
        IfCondition LessThan(CadAppPad.nn, 3) ThenBlock: {
            CadAppPad.ns = 0
            ReturnValue(0)
        }
        CadAppPick.prof_nn = CadAppPad.nn
        CadAppPad.a0 = CAD_Sketch.LoopSignedArea(CadAppPad.oxy, CadAppPad.nn)
        IfCondition EqualTo(Float_Le(CadAppPad.a0, 0), 1) ThenBlock: {
            CadAppPad.a0 = Float_Sub(0, CadAppPad.a0)
        }
        CadAppPad.tk = CAD_Store.Read(CadApp.sketch, 12)
        CadAppPad.k = 0
        WhileLoop LessThan(CadAppPad.k, CadAppPad.tk) {
            IfCondition NotEqual(CadAppPad.k, CadAppPad.ns) ThenBlock: {
                CadAppPad.base = CAD_Sketch.GetProfileXY(CadApp.sketch, CadAppPad.k, CadAppPad.xy)
                IfCondition GreaterEqual(CadAppPad.base, 3) ThenBlock: {
                    CadAppPad.sp = CadAppPad.base
                    CadAppPad.cx = 0
                    CadAppPad.cy = 0
                    CadAppPad.dx = 0
                    WhileLoop LessThan(CadAppPad.dx, CadAppPad.sp) {
                        CadAppPad.cx = Float_Add(CadAppPad.cx, ArrayGet(CadAppPad.xy, Multiply(CadAppPad.dx, 2)))
                        CadAppPad.cy = Float_Add(CadAppPad.cy, ArrayGet(CadAppPad.xy, Add(Multiply(CadAppPad.dx, 2), 1)))
                        CadAppPad.dx = Add(CadAppPad.dx, 1)
                    }
                    CadAppPad.r = Float_FromInt(CadAppPad.sp)
                    CadAppPad.cx = Float_Div(CadAppPad.cx, CadAppPad.r)
                    CadAppPad.cy = Float_Div(CadAppPad.cy, CadAppPad.r)
                    CadAppPad.r = CAD_Sketch.LoopSignedArea(CadAppPad.xy, CadAppPad.sp)
                    IfCondition EqualTo(Float_Le(CadAppPad.r, 0), 1) ThenBlock: {
                        CadAppPad.r = Float_Sub(0, CadAppPad.r)
                    }
                    CadAppPad.ok = 0
                    IfCondition EqualTo(Float_Le(CadAppPad.r, CadAppPad.a0), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CadAppPad.a0, CadAppPad.r), 0) ThenBlock: {
                            CadAppPad.ok = CA_PointInPoly(CadAppPad.cx, CadAppPad.cy, CadAppPad.oxy, CadAppPick.prof_nn)
                        }
                    }
                    IfCondition EqualTo(CadAppPad.ok, 1) ThenBlock: {
                        IfCondition LessThan(CAD_Topo_Sweep.ncont, 32) ThenBlock: {
                            CadAppPad.ey = CAD_Topo_Sweep.ncurve
                            CAD_Topo.SweepBeginWire()
                            CadAppPad.nn = CAD_Sketch.SketchPlexPathCount(CadAppPad.k)
                            CadAppPad.dx = 0
                            WhileLoop LessThan(CadAppPad.dx, CadAppPad.nn) {
                                CadAppPad.base = CAD_Sketch.SketchPlexPathSeg(CadAppPad.k, CadAppPad.dx)
                                IfCondition EqualTo(CadAppPad.base, 0) ThenBlock: {
                                    CadAppPad.cx = CAD_SPlex.x0
                                    CadAppPad.cy = CAD_SPlex.y0
                                    CadAppPad.r = CAD_SPlex.x1
                                    CadAppPad.sr = CAD_SPlex.y1
                                    IfCondition EqualTo(CAD_Sketch.SketchPlexNear(CadAppPad.cx, CadAppPad.cy, CadAppPad.r, CadAppPad.sr), 0) ThenBlock: {
                                        CAD_Topo_Sweep.px0 = CadAppPad.cx
                                        CAD_Topo_Sweep.py0 = CadAppPad.cy
                                        CAD_Topo_Sweep.px1 = CadAppPad.r
                                        CAD_Topo_Sweep.py1 = CadAppPad.sr
                                        CAD_Topo.SweepAddLinePinned()
                                    }
                                }
                                IfCondition EqualTo(CadAppPad.base, 2) ThenBlock: {
                                    CadAppPad.sr = CAD_SPlex.r
                                    CadAppPad.cx = CAD_SPlex.cx
                                    CadAppPad.cy = CAD_SPlex.cy
                                    CAD_Topo_Sweep.pa0 = CAD_SPlex.a0
                                    CAD_Topo_Sweep.pa1 = CAD_SPlex.a1
                                    IfCondition EqualTo(CAD_Num.IsZero(CadAppPad.sr, 0), 0) ThenBlock: {
                                        CAD_Topo_Sweep.px0 = CadAppPad.cx
                                        CAD_Topo_Sweep.py0 = CadAppPad.cy
                                        CAD_Topo_Sweep.px1 = CadAppPad.sr
                                        CAD_Topo.SweepAddArcPinned()
                                    }
                                }
                                CadAppPad.dx = Add(CadAppPad.dx, 1)
                            }
                            IfCondition EqualTo(CAD_Topo_Sweep.ncurve, CadAppPad.ey) ThenBlock: {
                                CadAppPad.ok = 0
                                IfCondition GreaterEqual(CadAppPad.sp, 8) ThenBlock: {
                                    CadAppPad.ok = CA_SweepOneCircle(CadAppPad.k)
                                    CadAppPad.oc = CadAppPad.ns
                                }
                                IfCondition EqualTo(CadAppPad.ok, 0) ThenBlock: {
                                    CadAppPad.dx = 0
                                    WhileLoop LessThan(CadAppPad.dx, CadAppPad.sp) {
                                        CadAppPad.dy = Add(CadAppPad.dx, 1)
                                        IfCondition EqualTo(CadAppPad.dy, CadAppPad.sp) ThenBlock: { CadAppPad.dy = 0 }
                                        CadAppPad.cx = ArrayGet(CadAppPad.xy, Multiply(CadAppPad.dx, 2))
                                        CadAppPad.cy = ArrayGet(CadAppPad.xy, Add(Multiply(CadAppPad.dx, 2), 1))
                                        CadAppPad.r = ArrayGet(CadAppPad.xy, Multiply(CadAppPad.dy, 2))
                                        CadAppPad.sr = ArrayGet(CadAppPad.xy, Add(Multiply(CadAppPad.dy, 2), 1))
                                        IfCondition EqualTo(CAD_Sketch.SketchPlexNear(CadAppPad.cx, CadAppPad.cy, CadAppPad.r, CadAppPad.sr), 0) ThenBlock: {
                                            CAD_Topo_Sweep.px0 = CadAppPad.cx
                                            CAD_Topo_Sweep.py0 = CadAppPad.cy
                                            CAD_Topo_Sweep.px1 = CadAppPad.r
                                            CAD_Topo_Sweep.py1 = CadAppPad.sr
                                            CAD_Topo.SweepAddLinePinned()
                                        }
                                        CadAppPad.dx = Add(CadAppPad.dx, 1)
                                    }
                                }
                            }
                            IfCondition EqualTo(CAD_Topo_Sweep.ncurve, CadAppPad.ey) ThenBlock: {
                                CAD_Topo_Sweep.ncont = Subtract(CAD_Topo_Sweep.ncont, 1)
                            }
                            IfCondition GreaterThan(CAD_Topo_Sweep.ncurve, CadAppPad.ey) ThenBlock: {
                                CA_LogInt("cad_app: sweep child hole pi=", 29, CadAppPad.k)
                                IfCondition LessThan(CadAppPad.k, 32) ThenBlock: {
                                    CadAppPad.base = LeftShift(1, CadAppPad.k)
                                    IfCondition NotEqual(BitwiseAnd(CadAppPad.msk, CadAppPad.base), 0) ThenBlock: {
                                        CadAppPad.msk = BitwiseXor(CadAppPad.msk, CadAppPad.base)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            CadAppPad.k = Add(CadAppPad.k, 1)
        }
        CadAppPad.oc = CadAppPad.ns
        CadAppPad.ns = 0
        CadAppPad.a0 = 0
        CadAppPad.sp = 0
        CadAppPad.tk = 0
        CadAppPad.ey = 0
        ReturnValue(0)
    }
}

// Sweep wire = the SketchPlex path the user picked. Same join/walk as the
// overlay — no second CA_Wire selector, no Atan2 rewrite of stored arc spans.
Function.CA_SweepFromSketch {
    Input: oi: Integer
    Output: Integer
    Body: {
        CadAppPad.choles = 0
        CadAppPad.ok = 0
        CadAppPad.oc = oi
        CadAppPad.lone = 0
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CA_WireEnsure(), 0) ThenBlock: { ReturnValue(0) }
        CA_Wire.eps2 = 0x3FA47AE147AE147B
        CAD_Topo.SweepBeginWire()
        nseg = CAD_Sketch.SketchPlexPathCount(CadAppPad.oc)
        CA_LogInt("cad_app: sweep plex n=", 22, nseg)
        nc = 0
        IfCondition GreaterThan(nseg, 0) ThenBlock: {
            k = 0
            WhileLoop LessThan(k, nseg) {
                kind = CAD_Sketch.SketchPlexPathSeg(oi, k)
                IfCondition EqualTo(kind, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.SketchPlexNear(CAD_SPlex.x0, CAD_SPlex.y0, CAD_SPlex.x1, CAD_SPlex.y1), 0) ThenBlock: {
                        CAD_Topo_Sweep.px0 = CAD_SPlex.x0
                        CAD_Topo_Sweep.py0 = CAD_SPlex.y0
                        CAD_Topo_Sweep.px1 = CAD_SPlex.x1
                        CAD_Topo_Sweep.py1 = CAD_SPlex.y1
                        CAD_Topo.SweepAddLinePinned()
                        nc = Add(nc, 1)
                    }
                }
                IfCondition EqualTo(kind, 2) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsZero(CAD_SPlex.r, 0), 0) ThenBlock: {
                        CAD_Topo_Sweep.px0 = CAD_SPlex.cx
                        CAD_Topo_Sweep.py0 = CAD_SPlex.cy
                        CAD_Topo_Sweep.px1 = CAD_SPlex.r
                        CAD_Topo_Sweep.pa0 = CAD_SPlex.a0
                        CAD_Topo_Sweep.pa1 = CAD_SPlex.a1
                        CAD_Topo.SweepAddArcPinned()
                        nc = Add(nc, 1)
                    }
                }
                k = Add(k, 1)
            }
        }
        // Lone CIRCLE: plex emits no segs (closed v0==v1). Overlay is a 32-gon.
        // Same as CAD_Feat.ExtrudeProfile: 2π SweepAddArc → cylinder, not prism.
        IfCondition EqualTo(nc, 0) ThenBlock: {
            nl0 = CAD_Store.Read(CadApp.sketch, 0)
            na0 = CAD_Store.Read(CadApp.sketch, 10)
            nc0 = CAD_Store.Read(CadApp.sketch, 7)
            CadAppPad.nn = nc0
            CadAppPad.lone = 0
            IfCondition EqualTo(nl0, 0) ThenBlock: {
                IfCondition EqualTo(na0, 0) ThenBlock: {
                    IfCondition GreaterThan(nc0, 0) ThenBlock: {
                        CadAppPad.lone = 1
                        circs = CAD_Store.Read(CadApp.sketch, 8)
                        IfCondition NotEqual(circs, 0) ThenBlock: {
                            two_pi = 0x401921FB54442D18
                            ci = 0
                            WhileLoop LessThan(ci, nc0) {
                                IfCondition GreaterThan(ci, 0) ThenBlock: {
                                    CAD_Topo.SweepBeginWire()
                                }
                                base = Multiply(ci, 3)
                                i1 = Add(base, 1)
                                i2 = Add(base, 2)
                                CAD_Topo_Sweep.px0 = ArrayGet(circs, base)
                                CAD_Topo_Sweep.py0 = ArrayGet(circs, i1)
                                CAD_Topo_Sweep.px1 = ArrayGet(circs, i2)
                                CAD_Topo_Sweep.pa0 = 0
                                CAD_Topo_Sweep.pa1 = two_pi
                                CAD_Topo.SweepAddArcPinned()
                                nc = Add(nc, 1)
                                ci = Add(ci, 1)
                            }
                            CA_LogInt("cad_app: sweep analytic circle n=", 34, nc0)
                        }
                    }
                }
            }
            // Lines or arcs are present. A selected full circle still
            // has path count 0. Sweep that one circle, not the outline.
            IfCondition EqualTo(CadAppPad.lone, 0) ThenBlock: {
                IfCondition GreaterThan(CadAppPad.nn, 0) ThenBlock: {
                    CadAppPad.base = CA_SweepOneCircle(CadAppPad.oc)
                    nc = CadAppPad.base
                }
            }
        }
        IfCondition EqualTo(nc, 0) ThenBlock: {
            IfCondition EqualTo(CadAppPad.oxy, 0) ThenBlock: { ReturnValue(0) }
            nn = CadAppPick.prof_nn
            IfCondition LessThan(nn, 3) ThenBlock: {
                nn = CAD_Sketch.GetProfileXY(CadApp.sketch, CadAppPad.oc, CadAppPad.oxy)
            }
            i = 0
            WhileLoop LessThan(i, nn) {
                j = Add(i, 1)
                IfCondition EqualTo(j, nn) ThenBlock: { j = 0 }
                CAD_Topo_Sweep.px0 = ArrayGet(CadAppPad.oxy, Multiply(i, 2))
                CAD_Topo_Sweep.py0 = ArrayGet(CadAppPad.oxy, Add(Multiply(i, 2), 1))
                CAD_Topo_Sweep.px1 = ArrayGet(CadAppPad.oxy, Multiply(j, 2))
                CAD_Topo_Sweep.py1 = ArrayGet(CadAppPad.oxy, Add(Multiply(j, 2), 1))
                IfCondition EqualTo(CAD_Sketch.SketchPlexNear(CAD_Topo_Sweep.px0, CAD_Topo_Sweep.py0, CAD_Topo_Sweep.px1, CAD_Topo_Sweep.py1), 0) ThenBlock: {
                    CAD_Topo.SweepAddLinePinned()
                    nc = Add(nc, 1)
                }
                i = Add(i, 1)
            }
        }
        CA_LogInt("cad_app: sweep curves n=", 24, nc)
        IfCondition LessThan(nc, 1) ThenBlock: {
            CA_Log("cad_app: pad FAIL - no plex wire\n", 33)
            ReturnValue(0)
        }
        CA_SweepChildWires()
        CA_LogInt("cad_app: raw wires n=", 21, CAD_Topo_Sweep.ncont)
        CA_PromoteOuterHoles()
        CA_LogInt("cad_app: sweep ncont=", 21, CAD_Topo_Sweep.ncont)
        ReturnValue(CadAppPad.choles)
    }
}

// Pixel distance² from (px,py) to segment (x0,y0)-(x1,y1). Integer math.
Function.CA_Dist2PxToSeg {
    Input: px: Integer
    Input: py: Integer
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Output: Integer
    Body: {
        dx = Subtract(x1, x0)
        dy = Subtract(y1, y0)
        len2 = Add(Multiply(dx, dx), Multiply(dy, dy))
        IfCondition EqualTo(len2, 0) ThenBlock: {
            ex = Subtract(px, x0)
            ey = Subtract(py, y0)
            ReturnValue(Add(Multiply(ex, ex), Multiply(ey, ey)))
        }
        // t = clamp(dot((p-a),(b-a))/len2, 0, 1) in 0..1024 fixed
        vx = Subtract(px, x0)
        vy = Subtract(py, y0)
        dot = Add(Multiply(vx, dx), Multiply(vy, dy))
        // t_num/len2 → scale 1024
        t = Divide(Multiply(dot, 1024), len2)
        IfCondition LessThan(t, 0) ThenBlock: { t = 0 }
        IfCondition GreaterThan(t, 1024) ThenBlock: { t = 1024 }
        qx = Add(x0, Divide(Multiply(dx, t), 1024))
        qy = Add(y0, Divide(Multiply(dy, t), 1024))
        ex = Subtract(px, qx)
        ey = Subtract(py, qy)
        ReturnValue(Add(Multiply(ex, ex), Multiply(ey, ey)))
    }
}

// 3D edge ray-pick: nearest solid edge under pixel (screen-space segment dist).
// Corner clicks hit 3 edges; prefer a mid-span hit, then world-horizontal
// (small |dZ|) so top-rim clicks do not steal the vertical.
// Which sketch/pad owns this edge: shell index → nth pad's feat_sk.
Function.CA_EdgeSketchIdx {
    Input: edge_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(CA_CurrentSkIdx()) }
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(CA_CurrentSkIdx()) }
        sh = CAD_Store.Read(CadApp.solid, 0)
        sidx = 0
        sguard = 0
        WhileLoop NotEqual(sh, 0) {
            fc = CAD_Store.Read(sh, 0)
            fguard = 0
            WhileLoop NotEqual(fc, 0) {
                lp = CAD_Store.Read(fc, 1)
                lguard = 0
                WhileLoop NotEqual(lp, 0) {
                    hd = CAD_Store.Read(lp, 0)
                    ce = hd
                    cguard = 0
                    WhileLoop NotEqual(ce, 0) {
                        IfCondition EqualTo(CAD_Store.Read(ce, 0), edge_h) ThenBlock: {
                            p = 0
                            fi = 0
                            WhileLoop LessThan(fi, CadApp.feat_n) {
                                IfCondition EqualTo(ArrayGet(CadApp.feat_kind, fi), 1) ThenBlock: {
                                    IfCondition EqualTo(p, sidx) ThenBlock: {
                                        ReturnValue(ArrayGet(CadApp.feat_sk, fi))
                                    }
                                    p = Add(p, 1)
                                }
                                fi = Add(fi, 1)
                            }
                            ReturnValue(sidx)
                        }
                        ce = CAD_Store.Read(ce, 2)
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(ce, hd) ThenBlock: { ce = 0 }
                        IfCondition GreaterThan(cguard, 4096) ThenBlock: { ce = 0 }
                    }
                    lp = CAD_Store.Read(lp, 2)
                    lguard = Add(lguard, 1)
                    IfCondition GreaterThan(lguard, 16) ThenBlock: { lp = 0 }
                }
                fc = CAD_Store.Read(fc, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 512) ThenBlock: { fc = 0 }
            }
            sh = CAD_Store.Read(sh, 2)
            sidx = Add(sidx, 1)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { sh = 0 }
        }
        ReturnValue(CA_CurrentSkIdx())
    }
}

// Polyline for pick/highlight. LINE=2 pts, CIRCLE/ARC=nseg+1, ellipse=nseg+1.
// One path for every curve kind — no chord special case.
Function.CA_SampleEdge {
    Input: ed: Integer
    Input: nseg: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ed, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Store.IsLive(ed), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { CAD_Tess_State.samp = Allocate(65536) }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nseg, 2) ThenBlock: { nseg = 8 }
        crv = CAD_Store.Read(ed, 2)
        IfCondition NotEqual(crv, 0) ThenBlock: {
            ck = CAD_Store.Read(crv, 0)
            IfCondition EqualTo(ck, 2) ThenBlock: {
                ReturnValue(CAD_Tess.SampleCircleEdge(ed, nseg, CAD_Tess_State.samp))
            }
            IfCondition EqualTo(ck, 3) ThenBlock: {
                ReturnValue(CAD_Tess.SampleEllipseByEnds(ed, nseg, CAD_Tess_State.samp))
            }
            IfCondition EqualTo(ck, 5) ThenBlock: {
                ReturnValue(CAD_Tess.SampleCopeEdge(ed, nseg, CAD_Tess_State.samp))
            }
            IfCondition EqualTo(ck, 6) ThenBlock: {
                ReturnValue(CAD_Tess.SampleArcArcEdge(ed, nseg, CAD_Tess_State.samp))
            }
        }
        v0 = CAD_Store.Read(ed, 0)
        v1 = CAD_Store.Read(ed, 1)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Tess_State.samp, 0, CAD_Store.Read(v0, 0))
        ArraySet(CAD_Tess_State.samp, 1, CAD_Store.Read(v0, 1))
        ArraySet(CAD_Tess_State.samp, 2, CAD_Store.Read(v0, 2))
        ArraySet(CAD_Tess_State.samp, 3, CAD_Store.Read(v1, 0))
        ArraySet(CAD_Tess_State.samp, 4, CAD_Store.Read(v1, 1))
        ArraySet(CAD_Tess_State.samp, 5, CAD_Store.Read(v1, 2))
        ReturnValue(2)
    }
}

Function.CA_PickSolidEdgeAtPx {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CadApp.mode, 0) ThenBlock: { ReturnValue(0) }
        fr = Allocate(64)
        CA_BuildViewFrame(fr)
        edges = Allocate(32768)
        ne = CAD_Topo.SolidCollectEdges(CadApp.solid, edges, 4096)
        IfCondition LessEqual(ne, 0) ThenBlock: {
            Deallocate(edges, 32768)
            Deallocate(fr, 64)
            ReturnValue(0)
        }
        rad2 = Multiply(32, 32)
        best_d = 2000000000
        best_e = 0
        best_endpt = 0
        pr0 = Allocate(32)
        pr1 = Allocate(32)
        i = 0
        WhileLoop LessThan(i, ne) {
            ed = ArrayGet(edges, i)
            IfCondition EqualTo(ed, 0) ThenBlock: { ed = 0 }
            IfCondition NotEqual(ed, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.IsLive(ed), 0) ThenBlock: { ed = 0 }
            }
            ns = 0
            vrt = 0
            IfCondition NotEqual(ed, 0) ThenBlock: {
                ns = CA_SampleEdge(ed, 48)
                ev0 = CAD_Store.Read(ed, 0)
                ev1 = CAD_Store.Read(ed, 1)
                IfCondition NotEqual(ev0, 0) ThenBlock: {
                    IfCondition NotEqual(ev1, 0) ThenBlock: {
                        IfCondition NotEqual(ev0, ev1) ThenBlock: {
                            edx = Float_Sub(CAD_Store.Read(ev1, 0), CAD_Store.Read(ev0, 0))
                            edy = Float_Sub(CAD_Store.Read(ev1, 1), CAD_Store.Read(ev0, 1))
                            edz = Float_Sub(CAD_Store.Read(ev1, 2), CAD_Store.Read(ev0, 2))
                            adx = edx
                            IfCondition EqualTo(Float_Le(adx, 0), 1) ThenBlock: { adx = Float_Sub(0, adx) }
                            ady = edy
                            IfCondition EqualTo(Float_Le(ady, 0), 1) ThenBlock: { ady = Float_Sub(0, ady) }
                            adz = edz
                            IfCondition EqualTo(Float_Le(adz, 0), 1) ThenBlock: { adz = Float_Sub(0, adz) }
                            IfCondition EqualTo(Float_Le(adx, adz), 1) ThenBlock: {
                                IfCondition EqualTo(Float_Le(ady, adz), 1) ThenBlock: { vrt = 1 }
                            }
                        }
                    }
                }
            }
            samp = CAD_Tess_State.samp
            si = 0
            WhileLoop LessThan(si, Subtract(ns, 1)) {
                CAD_View.ProjectPoint(ArrayGet(samp, Multiply(si, 3)), ArrayGet(samp, Add(Multiply(si, 3), 1)), ArrayGet(samp, Add(Multiply(si, 3), 2)), fr, pr0)
                CAD_View.ProjectPoint(ArrayGet(samp, Multiply(Add(si, 1), 3)), ArrayGet(samp, Add(Multiply(Add(si, 1), 3), 1)), ArrayGet(samp, Add(Multiply(Add(si, 1), 3), 2)), fr, pr1)
                x0 = Float_ToInt(ArrayGet(pr0, 0))
                y0 = Float_ToInt(ArrayGet(pr0, 1))
                x1 = Float_ToInt(ArrayGet(pr1, 0))
                y1 = Float_ToInt(ArrayGet(pr1, 1))
                d2 = CA_Dist2PxToSeg(px, py, x0, y0, x1, y1)
                IfCondition LessThan(d2, rad2) ThenBlock: {
                    score = d2
                    endpt = 0
                    sx = Subtract(x1, x0)
                    sy = Subtract(y1, y0)
                    len2 = Add(Multiply(sx, sx), Multiply(sy, sy))
                    tt = 0
                    IfCondition NotEqual(len2, 0) ThenBlock: {
                        tt = Divide(Multiply(Add(Multiply(Subtract(px, x0), sx), Multiply(Subtract(py, y0), sy)), 1024), len2)
                        IfCondition LessThan(tt, 0) ThenBlock: { tt = 0 }
                        IfCondition GreaterThan(tt, 1024) ThenBlock: { tt = 1024 }
                    }
                    nseg = Subtract(ns, 1)
                    frac = Add(Multiply(si, 1024), tt)
                    den = Multiply(nseg, 1024)
                    IfCondition LessThan(Multiply(frac, 20), Multiply(den, 3)) ThenBlock: { endpt = 1 }
                    IfCondition GreaterThan(Multiply(frac, 20), Multiply(den, 17)) ThenBlock: { endpt = 1 }
                    IfCondition EqualTo(endpt, 1) ThenBlock: { score = Add(score, 100000) }
                    IfCondition EqualTo(vrt, 1) ThenBlock: { score = Add(score, 50000) }
                    IfCondition EqualTo(best_e, 0) ThenBlock: {
                        best_d = score
                        best_e = ed
                        best_endpt = endpt
                    }
                    IfCondition LessThan(score, best_d) ThenBlock: {
                        best_d = score
                        best_e = ed
                        best_endpt = endpt
                    }
                }
                si = Add(si, 1)
            }
            i = Add(i, 1)
        }
        Deallocate(pr0, 32)
        Deallocate(pr1, 32)
        hit = best_e
        IfCondition EqualTo(hit, 0) ThenBlock: {
            PrintMessage("cad_app: edge pick miss scanned=")
            PrintNumber(ne)
            PrintMessage("\n")
        }
        IfCondition NotEqual(hit, 0) ThenBlock: {
            IfCondition EqualTo(best_endpt, 1) ThenBlock: {
                IfCondition GreaterThan(CadApp.sel_nedges, 0) ThenBlock: {
                    CA_LogInt("cad_app: edge pick skip corner nsel=", 36, CadApp.sel_nedges)
                    hit = 0
                }
            }
        }
        IfCondition NotEqual(hit, 0) ThenBlock: {
            CadApp.edge_sk = CA_EdgeSketchIdx(hit)
            CA_LogInt("cad_app: edge pick sk=", 21, CadApp.edge_sk)
            CA_LogInt("cad_app: edge pick endpt=", 25, best_endpt)
        }
        Deallocate(edges, 32768)
        Deallocate(fr, 64)
        ReturnValue(hit)
    }
}
