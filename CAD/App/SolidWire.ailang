Function.CA_CountProfiles {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.nprof = 0
            ReturnValue(0)
        }
        // read cache only — projection is CA_RebuildProfiles (clone)
        n = CAD_Store.Read(CadApp.sketch, 12)
        CadApp.nprof = n
        ReturnValue(n)
    }
}

// Live-entity wire join. Profile cache is pick overlay only.
FixedPool.CA_Wire {
    "sk":     Initialize=0, CanChange=True
    "nl":     Initialize=0, CanChange=True
    "na":     Initialize=0, CanChange=True
    "nc":     Initialize=0, CanChange=True
    "i":      Initialize=0, CanChange=True
    "j":      Initialize=0, CanChange=True
    "used_l": Initialize=0, CanChange=True
    "used_a": Initialize=0, CanChange=True
    "path_k": Initialize=0, CanChange=True
    "path_i": Initialize=0, CanChange=True
    "path_r": Initialize=0, CanChange=True
    "path_tx": Initialize=0, CanChange=True
    "path_ty": Initialize=0, CanChange=True
    "path_s": Initialize=0, CanChange=True
    "npath":  Initialize=0, CanChange=True
    "si":     Initialize=0, CanChange=True
    "b":      Initialize=0, CanChange=True
    "w":      Initialize=0, CanChange=True
    "off":    Initialize=0, CanChange=True
    "arcs":   Initialize=0, CanChange=True
    "endxy":  Initialize=0, CanChange=True
    "poly":   Initialize=0, CanChange=True
    "remap":  Initialize=0, CanChange=True
    "ex":     Initialize=0, CanChange=True
    "ey":     Initialize=0, CanChange=True
    "fx":     Initialize=0, CanChange=True
    "fy":     Initialize=0, CanChange=True
    "tipx":   Initialize=0, CanChange=True
    "tipy":   Initialize=0, CanChange=True
    "stx":    Initialize=0, CanChange=True
    "sty":    Initialize=0, CanChange=True
    "cx":     Initialize=0, CanChange=True
    "cy":     Initialize=0, CanChange=True
    "r":      Initialize=0, CanChange=True
    "a0":     Initialize=0, CanChange=True
    "a1":     Initialize=0, CanChange=True
    "cs":     Initialize=0, CanChange=True
    "sn":     Initialize=0, CanChange=True
    "eps2":   Initialize=0, CanChange=True
    "rev":    Initialize=0, CanChange=True
    "ok":     Initialize=0, CanChange=True
    "outer":  Initialize=0, CanChange=True
    "area":   Initialize=0, CanChange=True
    "best":   Initialize=0, CanChange=True
    "px":     Initialize=0, CanChange=True
    "py":     Initialize=0, CanChange=True
    "nn":     Initialize=0, CanChange=True
    "full":   Initialize=0, CanChange=True
    "nv":     Initialize=0, CanChange=True
    "nhe":    Initialize=0, CanChange=True
    "v0":     Initialize=0, CanChange=True
    "v1":     Initialize=0, CanChange=True
    "cur":    Initialize=0, CanChange=True
    "nxt":    Initialize=0, CanChange=True
    "dang":   Initialize=0, CanChange=True
    "vx":     Initialize=0, CanChange=True
    "vy":     Initialize=0, CanChange=True
    "he_a":   Initialize=0, CanChange=True
    "he_b":   Initialize=0, CanChange=True
    "he_k":   Initialize=0, CanChange=True
    "he_e":   Initialize=0, CanChange=True
    "he_r":   Initialize=0, CanChange=True
    "he_ang": Initialize=0, CanChange=True
    "he_twin": Initialize=0, CanChange=True
    "he_used": Initialize=0, CanChange=True
}

Function.CA_WireEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_Wire.used_l, 0) ThenBlock: {
            CA_Wire.used_l = Allocate(2048)
            CA_Wire.used_a = Allocate(2048)
            CA_Wire.path_k = Allocate(2048)
            CA_Wire.path_i = Allocate(2048)
            CA_Wire.path_r = Allocate(2048)
            CA_Wire.path_tx = Allocate(2048)
            CA_Wire.path_ty = Allocate(2048)
            CA_Wire.path_s = Allocate(2048)
            CA_Wire.endxy = Allocate(32)
            CA_Wire.poly = Allocate(4096)
            CA_Wire.remap = Allocate(256)
            CA_Wire.vx = Allocate(4096)
            CA_Wire.vy = Allocate(4096)
            CA_Wire.he_a = Allocate(8192)
            CA_Wire.he_b = Allocate(8192)
            CA_Wire.he_k = Allocate(8192)
            CA_Wire.he_e = Allocate(8192)
            CA_Wire.he_r = Allocate(8192)
            CA_Wire.he_ang = Allocate(8192)
            CA_Wire.he_twin = Allocate(8192)
            CA_Wire.he_used = Allocate(8192)
        }
        IfCondition EqualTo(CA_Wire.used_l, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CA_Wire.poly, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

Function.CA_WireDumpLive {
    Output: Integer
    Body: {
        CA_LogInt("sol: LIVE lines=", 16, CA_Wire.nl)
        CA_LogInt("sol: LIVE arcs=", 15, CA_Wire.na)
        CA_LogInt("sol: LIVE circs=", 16, CAD_Sketch.GetCircleCount(CA_Wire.sk))
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CA_Wire.nl) {
            CA_WireLineEnds(CA_Wire.i)
            CA_LogInt("sol: L[", 7, CA_Wire.i)
            CA_LogF("] x0=", 5, CA_Wire.ex)
            CA_LogF(" y0=", 4, CA_Wire.ey)
            CA_LogF(" x1=", 4, CA_Wire.fx)
            CA_LogF(" y1=", 4, CA_Wire.fy)
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CA_Wire.na) {
            CA_WireArcEnds(CA_Wire.i)
            CA_LogInt("sol: A[", 7, CA_Wire.i)
            CA_LogF("] cx=", 5, CA_Wire.cx)
            CA_LogF(" cy=", 4, CA_Wire.cy)
            CA_LogF(" r=", 3, CA_Wire.r)
            CA_LogF(" a0=", 4, CA_Wire.a0)
            CA_LogF(" a1=", 4, CA_Wire.a1)
            CA_LogF(" x0=", 4, CA_Wire.ex)
            CA_LogF(" y0=", 4, CA_Wire.ey)
            CA_LogF(" x1=", 4, CA_Wire.fx)
            CA_LogF(" y1=", 4, CA_Wire.fy)
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        CA_Wire.nc = CAD_Sketch.GetCircleCount(CA_Wire.sk)
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CA_Wire.nc) {
            CA_Wire.j = CAD_Store.Read(CA_Wire.sk, 8)
            IfCondition NotEqual(CA_Wire.j, 0) ThenBlock: {
                CA_LogInt("sol: C[", 7, CA_Wire.i)
                CA_LogF("] cx=", 5, ArrayGet(CA_Wire.j, Multiply(CA_Wire.i, 3)))
                CA_LogF(" cy=", 4, ArrayGet(CA_Wire.j, Add(Multiply(CA_Wire.i, 3), 1)))
                CA_LogF(" r=", 3, ArrayGet(CA_Wire.j, Add(Multiply(CA_Wire.i, 3), 2)))
            }
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        ReturnValue(0)
    }
}

Function.CA_WireDumpGraph {
    Output: Integer
    Body: {
        CA_LogInt("sol: graph nv=", 14, CA_Wire.nv)
        CA_LogInt("sol: graph nhe=", 15, CA_Wire.nhe)
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CA_Wire.nv) {
            CA_LogInt("sol: V[", 7, CA_Wire.i)
            CA_LogF("] x=", 4, ArrayGet(CA_Wire.vx, CA_Wire.i))
            CA_LogF(" y=", 3, ArrayGet(CA_Wire.vy, CA_Wire.i))
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CA_Wire.nhe) {
            CA_LogInt("sol: HE[", 8, CA_Wire.i)
            CA_LogInt("] a=", 4, ArrayGet(CA_Wire.he_a, CA_Wire.i))
            CA_LogInt(" b=", 3, ArrayGet(CA_Wire.he_b, CA_Wire.i))
            CA_LogInt(" k=", 3, ArrayGet(CA_Wire.he_k, CA_Wire.i))
            CA_LogInt(" e=", 3, ArrayGet(CA_Wire.he_e, CA_Wire.i))
            CA_LogInt(" r=", 3, ArrayGet(CA_Wire.he_r, CA_Wire.i))
            CA_LogInt(" twin=", 6, ArrayGet(CA_Wire.he_twin, CA_Wire.i))
            CA_LogF(" ang=", 5, ArrayGet(CA_Wire.he_ang, CA_Wire.i))
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        ReturnValue(0)
    }
}

Function.CA_WireNear {
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Output: Integer
    Body: {
        CA_Wire.cs = Float_Sub(x0, x1)
        CA_Wire.sn = Float_Sub(y0, y1)
        CA_Wire.cs = Float_Add(Float_Mul(CA_Wire.cs, CA_Wire.cs), Float_Mul(CA_Wire.sn, CA_Wire.sn))
        IfCondition EqualTo(Float_Le(CA_Wire.cs, CA_Wire.eps2), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.CA_WireLineEnds {
    Input: li: Integer
    Output: Integer
    Body: {
        CAD_Sketch.GetLineEnd(CA_Wire.sk, li, 0, CA_Wire.endxy)
        CA_Wire.ex = ArrayGet(CA_Wire.endxy, 0)
        CA_Wire.ey = ArrayGet(CA_Wire.endxy, 1)
        CAD_Sketch.GetLineEnd(CA_Wire.sk, li, 1, CA_Wire.endxy)
        CA_Wire.fx = ArrayGet(CA_Wire.endxy, 0)
        CA_Wire.fy = ArrayGet(CA_Wire.endxy, 1)
        ReturnValue(0)
    }
}

Function.CA_WireArcEnds {
    Input: ai: Integer
    Output: Integer
    Body: {
        CA_Wire.arcs = CAD_Store.Read(CA_Wire.sk, 11)
        IfCondition EqualTo(CA_Wire.arcs, 0) ThenBlock: { ReturnValue(-1) }
        CA_Wire.off = Multiply(ai, 5)
        CA_Wire.cx = ArrayGet(CA_Wire.arcs, CA_Wire.off)
        CA_Wire.cy = ArrayGet(CA_Wire.arcs, Add(CA_Wire.off, 1))
        CA_Wire.r = ArrayGet(CA_Wire.arcs, Add(CA_Wire.off, 2))
        CA_Wire.a0 = ArrayGet(CA_Wire.arcs, Add(CA_Wire.off, 3))
        CA_Wire.a1 = ArrayGet(CA_Wire.arcs, Add(CA_Wire.off, 4))
        CA_Wire.cs = CAD_Geom.Cos(CA_Wire.a0)
        CA_Wire.sn = CAD_Geom.Sin(CA_Wire.a0)
        CA_Wire.ex = Float_Add(CA_Wire.cx, Float_Mul(CA_Wire.r, CA_Wire.cs))
        CA_Wire.ey = Float_Add(CA_Wire.cy, Float_Mul(CA_Wire.r, CA_Wire.sn))
        CA_Wire.cs = CAD_Geom.Cos(CA_Wire.a1)
        CA_Wire.sn = CAD_Geom.Sin(CA_Wire.a1)
        CA_Wire.fx = Float_Add(CA_Wire.cx, Float_Mul(CA_Wire.r, CA_Wire.cs))
        CA_Wire.fy = Float_Add(CA_Wire.cy, Float_Mul(CA_Wire.r, CA_Wire.sn))
        ReturnValue(0)
    }
}

Function.CA_WireEmitPath {
    Output: Integer
    Body: {
        IfCondition LessThan(CA_Wire.npath, 1) ThenBlock: { ReturnValue(-1) }
        CAD_Topo.SweepBeginWire()
        CA_Wire.si = 0
        WhileLoop LessThan(CA_Wire.si, CA_Wire.npath) {
            CA_Wire.cur = ArrayGet(CA_Wire.path_s, CA_Wire.si)
            CA_Wire.rev = ArrayGet(CA_Wire.path_r, CA_Wire.si)
            CA_Wire.v0 = ArrayGet(CA_Wire.he_a, CA_Wire.cur)
            CA_Wire.v1 = ArrayGet(CA_Wire.he_b, CA_Wire.cur)
            IfCondition EqualTo(ArrayGet(CA_Wire.path_k, CA_Wire.si), 0) ThenBlock: {
                // Snapped HE verts — raw sketch ends leave a gap at Pac-Man mouths.
                CAD_Topo_Sweep.px0 = ArrayGet(CA_Wire.vx, CA_Wire.v0)
                CAD_Topo_Sweep.py0 = ArrayGet(CA_Wire.vy, CA_Wire.v0)
                CAD_Topo_Sweep.px1 = ArrayGet(CA_Wire.vx, CA_Wire.v1)
                CAD_Topo_Sweep.py1 = ArrayGet(CA_Wire.vy, CA_Wire.v1)
                CAD_Topo.SweepAddLinePinned()
            }
            IfCondition EqualTo(ArrayGet(CA_Wire.path_k, CA_Wire.si), 2) ThenBlock: {
                CA_WireArcEnds(ArrayGet(CA_Wire.path_i, CA_Wire.si))
                CA_LogInt("pipe emit-arc rev=", 19, CA_Wire.rev)
                CA_LogF(" live-a0=", 9, CA_Wire.a0)
                CA_LogF(" live-a1=", 9, CA_Wire.a1)
                CA_Wire.dang = Float_Sub(CA_Wire.a1, CA_Wire.a0)
                IfCondition EqualTo(Float_Le(CA_Wire.dang, 0), 1) ThenBlock: {
                    CA_Wire.dang = Float_Add(CA_Wire.dang, 0x401921FB54442D18)
                }
                // Start at the HE vertex so the leftover meets the radials.
                CA_Wire.a0 = CAD_Geom.Atan2(Float_Sub(ArrayGet(CA_Wire.vy, CA_Wire.v0), CA_Wire.cy), Float_Sub(ArrayGet(CA_Wire.vx, CA_Wire.v0), CA_Wire.cx))
                IfCondition NotEqual(CA_Wire.rev, 0) ThenBlock: {
                    CA_Wire.dang = Float_Sub(0, CA_Wire.dang)
                }
                CA_LogF(" live-span=", 11, Float_Sub(CA_Wire.a1, CA_Wire.a0))
                CA_LogF(" out-span=", 10, CA_Wire.dang)
                CAD_Topo_Sweep.px0 = CA_Wire.cx
                CAD_Topo_Sweep.py0 = CA_Wire.cy
                CAD_Topo_Sweep.px1 = CA_Wire.r
                CAD_Topo_Sweep.pa0 = CA_Wire.a0
                CAD_Topo_Sweep.pa1 = Float_Add(CA_Wire.a0, CA_Wire.dang)
                CAD_Topo.SweepAddArcPinned()
            }
            CA_Wire.si = Add(CA_Wire.si, 1)
        }
        ReturnValue(0)
    }
}

Function.CA_WireSnapVert {
    Output: Integer
    Body: {
        CA_Wire.w = 0
        WhileLoop LessThan(CA_Wire.w, CA_Wire.nv) {
            IfCondition EqualTo(CA_WireNear(ArrayGet(CA_Wire.vx, CA_Wire.w), ArrayGet(CA_Wire.vy, CA_Wire.w), CA_Wire.px, CA_Wire.py), 1) ThenBlock: {
                ReturnValue(CA_Wire.w)
            }
            CA_Wire.w = Add(CA_Wire.w, 1)
        }
        ArraySet(CA_Wire.vx, CA_Wire.nv, CA_Wire.px)
        ArraySet(CA_Wire.vy, CA_Wire.nv, CA_Wire.py)
        CA_Wire.ok = CA_Wire.nv
        CA_Wire.nv = Add(CA_Wire.nv, 1)
        ReturnValue(CA_Wire.ok)
    }
}

Function.CA_WireAddHE {
    Output: Integer
    Body: {
        ArraySet(CA_Wire.he_a, CA_Wire.nhe, CA_Wire.v0)
        ArraySet(CA_Wire.he_b, CA_Wire.nhe, CA_Wire.v1)
        ArraySet(CA_Wire.he_k, CA_Wire.nhe, CA_Wire.ok)
        ArraySet(CA_Wire.he_e, CA_Wire.nhe, CA_Wire.si)
        ArraySet(CA_Wire.he_r, CA_Wire.nhe, CA_Wire.rev)
        ArraySet(CA_Wire.he_ang, CA_Wire.nhe, CA_Wire.dang)
        ArraySet(CA_Wire.he_used, CA_Wire.nhe, 0)
        CA_Wire.nhe = Add(CA_Wire.nhe, 1)
        ReturnValue(Subtract(CA_Wire.nhe, 1))
    }
}

Function.CA_WireBuildGraph {
    Output: Integer
    Body: {
        CA_Wire.nv = 0
        CA_Wire.nhe = 0
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CA_Wire.nl) {
            CA_WireLineEnds(CA_Wire.i)
            CA_Wire.px = CA_Wire.ex
            CA_Wire.py = CA_Wire.ey
            CA_Wire.v0 = CA_WireSnapVert()
            CA_Wire.px = CA_Wire.fx
            CA_Wire.py = CA_Wire.fy
            CA_Wire.v1 = CA_WireSnapVert()
            CA_Wire.dang = CAD_Geom.Atan2(Float_Sub(CA_Wire.fy, CA_Wire.ey), Float_Sub(CA_Wire.fx, CA_Wire.ex))
            CA_Wire.ok = 0
            CA_Wire.si = CA_Wire.i
            CA_Wire.rev = 0
            CA_WireAddHE()
            CA_Wire.dang = CAD_Geom.Atan2(Float_Sub(CA_Wire.ey, CA_Wire.fy), Float_Sub(CA_Wire.ex, CA_Wire.fx))
            CA_Wire.ok = 0
            CA_Wire.si = CA_Wire.i
            CA_Wire.rev = 1
            CA_Wire.cur = CA_Wire.v0
            CA_Wire.v0 = CA_Wire.v1
            CA_Wire.v1 = CA_Wire.cur
            CA_WireAddHE()
            ArraySet(CA_Wire.he_twin, Subtract(CA_Wire.nhe, 2), Subtract(CA_Wire.nhe, 1))
            ArraySet(CA_Wire.he_twin, Subtract(CA_Wire.nhe, 1), Subtract(CA_Wire.nhe, 2))
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CA_Wire.na) {
            CA_WireArcEnds(CA_Wire.i)
            CA_Wire.px = CA_Wire.ex
            CA_Wire.py = CA_Wire.ey
            CA_Wire.v0 = CA_WireSnapVert()
            CA_Wire.px = CA_Wire.fx
            CA_Wire.py = CA_Wire.fy
            CA_Wire.v1 = CA_WireSnapVert()
            CA_Wire.cs = CAD_Geom.Cos(CA_Wire.a0)
            CA_Wire.sn = CAD_Geom.Sin(CA_Wire.a0)
            CA_Wire.dang = CAD_Geom.Atan2(CA_Wire.cs, Float_Sub(0, CA_Wire.sn))
            CA_Wire.ok = 2
            CA_Wire.si = CA_Wire.i
            CA_Wire.rev = 0
            CA_WireAddHE()
            CA_Wire.cs = CAD_Geom.Cos(CA_Wire.a1)
            CA_Wire.sn = CAD_Geom.Sin(CA_Wire.a1)
            CA_Wire.dang = CAD_Geom.Atan2(Float_Sub(0, CA_Wire.cs), CA_Wire.sn)
            CA_Wire.ok = 2
            CA_Wire.si = CA_Wire.i
            CA_Wire.rev = 1
            CA_Wire.cur = CA_Wire.v0
            CA_Wire.v0 = CA_Wire.v1
            CA_Wire.v1 = CA_Wire.cur
            CA_WireAddHE()
            ArraySet(CA_Wire.he_twin, Subtract(CA_Wire.nhe, 2), Subtract(CA_Wire.nhe, 1))
            ArraySet(CA_Wire.he_twin, Subtract(CA_Wire.nhe, 1), Subtract(CA_Wire.nhe, 2))
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        ReturnValue(CA_Wire.nhe)
    }
}

// Next half-edge on the left face: at dest, take the next outgoing CCW after the reverse.
Function.CA_WireNextHE {
    Input: he: Integer
    Output: Integer
    Body: {
        CA_Wire.cur = he
        CA_Wire.v0 = ArrayGet(CA_Wire.he_b, CA_Wire.cur)
        CA_Wire.v1 = ArrayGet(CA_Wire.he_twin, CA_Wire.cur)
        CA_Wire.a0 = ArrayGet(CA_Wire.he_ang, CA_Wire.v1)
        // Never default to the twin — that U-turns a dangling stub
        // (n7 spur e=16 both ways on the 4-Pac-Man pad).
        CA_Wire.nxt = Subtract(0, 1)
        CA_Wire.best = 0x401921FB54442D18
        CA_Wire.off = 0
        WhileLoop LessThan(CA_Wire.off, CA_Wire.nhe) {
            IfCondition EqualTo(ArrayGet(CA_Wire.he_a, CA_Wire.off), CA_Wire.v0) ThenBlock: {
                IfCondition NotEqual(CA_Wire.off, CA_Wire.v1) ThenBlock: {
                    CA_Wire.dang = Float_Sub(ArrayGet(CA_Wire.he_ang, CA_Wire.off), CA_Wire.a0)
                    IfCondition EqualTo(CAD_Num.IsNeg(CA_Wire.dang), 1) ThenBlock: {
                        CA_Wire.dang = Float_Add(CA_Wire.dang, 0x401921FB54442D18)
                    }
                    IfCondition EqualTo(CAD_Num.IsZero(CA_Wire.dang, 0), 0) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CA_Wire.dang, CA_Wire.best), 1) ThenBlock: {
                            CA_Wire.best = CA_Wire.dang
                            CA_Wire.nxt = CA_Wire.off
                        }
                    }
                }
            }
            CA_Wire.off = Add(CA_Wire.off, 1)
        }
        ReturnValue(CA_Wire.nxt)
    }
}

Function.CA_WirePathArea {
    Output: Integer
    Body: {
        // Shoelace on HE ends. An arc is not a chord — insert the mid-arc
        // along the walked span (not (a0+a1)/2, which lands in a Pac-Man
        // mouth when the leftover is the major arc).
        CA_Wire.area = 0
        CA_Wire.si = 0
        WhileLoop LessThan(CA_Wire.si, CA_Wire.npath) {
            CA_Wire.cur = ArrayGet(CA_Wire.path_s, CA_Wire.si)
            CA_Wire.v0 = ArrayGet(CA_Wire.he_a, CA_Wire.cur)
            CA_Wire.v1 = ArrayGet(CA_Wire.he_b, CA_Wire.cur)
            CA_Wire.ex = ArrayGet(CA_Wire.vx, CA_Wire.v0)
            CA_Wire.ey = ArrayGet(CA_Wire.vy, CA_Wire.v0)
            CA_Wire.fx = ArrayGet(CA_Wire.vx, CA_Wire.v1)
            CA_Wire.fy = ArrayGet(CA_Wire.vy, CA_Wire.v1)
            IfCondition EqualTo(ArrayGet(CA_Wire.path_k, CA_Wire.si), 2) ThenBlock: {
                CA_WireArcEnds(ArrayGet(CA_Wire.path_i, CA_Wire.si))
                CA_Wire.dang = Float_Sub(CA_Wire.a1, CA_Wire.a0)
                IfCondition EqualTo(Float_Le(CA_Wire.dang, 0), 1) ThenBlock: {
                    CA_Wire.dang = Float_Add(CA_Wire.dang, 0x401921FB54442D18)
                }
                IfCondition NotEqual(ArrayGet(CA_Wire.path_r, CA_Wire.si), 0) ThenBlock: {
                    CA_Wire.dang = Float_Sub(0, CA_Wire.dang)
                }
                CA_Wire.a0 = CAD_Geom.Atan2(Float_Sub(CA_Wire.ey, CA_Wire.cy), Float_Sub(CA_Wire.ex, CA_Wire.cx))
                CA_Wire.best = Float_Add(CA_Wire.a0, Float_Mul(CA_Wire.dang, 0x3FE0000000000000))
                CA_Wire.cs = CAD_Geom.Cos(CA_Wire.best)
                CA_Wire.sn = CAD_Geom.Sin(CA_Wire.best)
                CA_Wire.px = Float_Add(CA_Wire.cx, Float_Mul(CA_Wire.r, CA_Wire.cs))
                CA_Wire.py = Float_Add(CA_Wire.cy, Float_Mul(CA_Wire.r, CA_Wire.sn))
                CA_Wire.area = Float_Add(CA_Wire.area, Float_Sub(Float_Mul(CA_Wire.ex, CA_Wire.py), Float_Mul(CA_Wire.px, CA_Wire.ey)))
                CA_Wire.area = Float_Add(CA_Wire.area, Float_Sub(Float_Mul(CA_Wire.px, CA_Wire.fy), Float_Mul(CA_Wire.fx, CA_Wire.py)))
            }
            IfCondition NotEqual(ArrayGet(CA_Wire.path_k, CA_Wire.si), 2) ThenBlock: {
                CA_Wire.area = Float_Add(CA_Wire.area, Float_Sub(Float_Mul(CA_Wire.ex, CA_Wire.fy), Float_Mul(CA_Wire.fx, CA_Wire.ey)))
            }
            CA_Wire.si = Add(CA_Wire.si, 1)
        }
        ReturnValue(CA_Wire.area)
    }
}

// Opposite orientation of the current closed walk (twin HEs, reverse order).
Function.CA_WireReversePath {
    Output: Integer
    Body: {
        CA_Wire.off = 0
        CA_Wire.b = Subtract(CA_Wire.npath, 1)
        WhileLoop LessThan(CA_Wire.off, CA_Wire.b) {
            CA_Wire.w = ArrayGet(CA_Wire.path_s, CA_Wire.off)
            ArraySet(CA_Wire.path_s, CA_Wire.off, ArrayGet(CA_Wire.path_s, CA_Wire.b))
            ArraySet(CA_Wire.path_s, CA_Wire.b, CA_Wire.w)
            CA_Wire.w = ArrayGet(CA_Wire.path_k, CA_Wire.off)
            ArraySet(CA_Wire.path_k, CA_Wire.off, ArrayGet(CA_Wire.path_k, CA_Wire.b))
            ArraySet(CA_Wire.path_k, CA_Wire.b, CA_Wire.w)
            CA_Wire.w = ArrayGet(CA_Wire.path_i, CA_Wire.off)
            ArraySet(CA_Wire.path_i, CA_Wire.off, ArrayGet(CA_Wire.path_i, CA_Wire.b))
            ArraySet(CA_Wire.path_i, CA_Wire.b, CA_Wire.w)
            CA_Wire.w = ArrayGet(CA_Wire.path_r, CA_Wire.off)
            ArraySet(CA_Wire.path_r, CA_Wire.off, ArrayGet(CA_Wire.path_r, CA_Wire.b))
            ArraySet(CA_Wire.path_r, CA_Wire.b, CA_Wire.w)
            CA_Wire.off = Add(CA_Wire.off, 1)
            CA_Wire.b = Subtract(CA_Wire.b, 1)
        }
        CA_Wire.si = 0
        WhileLoop LessThan(CA_Wire.si, CA_Wire.npath) {
            CA_Wire.cur = ArrayGet(CA_Wire.path_s, CA_Wire.si)
            CA_Wire.nxt = ArrayGet(CA_Wire.he_twin, CA_Wire.cur)
            ArraySet(CA_Wire.path_s, CA_Wire.si, CA_Wire.nxt)
            ArraySet(CA_Wire.path_k, CA_Wire.si, ArrayGet(CA_Wire.he_k, CA_Wire.nxt))
            ArraySet(CA_Wire.path_i, CA_Wire.si, ArrayGet(CA_Wire.he_e, CA_Wire.nxt))
            ArraySet(CA_Wire.path_r, CA_Wire.si, ArrayGet(CA_Wire.he_r, CA_Wire.nxt))
            CA_Wire.si = Add(CA_Wire.si, 1)
        }
        ReturnValue(0)
    }
}

Function.CA_WireMarkPathTwins {
    Output: Integer
    Body: {
        CA_Wire.si = 0
        WhileLoop LessThan(CA_Wire.si, CA_Wire.npath) {
            CA_Wire.cur = ArrayGet(CA_Wire.path_s, CA_Wire.si)
            ArraySet(CA_Wire.he_used, CA_Wire.cur, 1)
            CA_Wire.nxt = ArrayGet(CA_Wire.he_twin, CA_Wire.cur)
            ArraySet(CA_Wire.he_used, CA_Wire.nxt, 1)
            CA_Wire.si = Add(CA_Wire.si, 1)
        }
        ReturnValue(0)
    }
}

Function.CA_WalkExtend {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(CA_Wire.npath, 3) ThenBlock: {
            IfCondition EqualTo(CA_WireNear(CA_Wire.tipx, CA_Wire.tipy, CA_Wire.stx, CA_Wire.sty), 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition GreaterEqual(CA_Wire.npath, 64) ThenBlock: { ReturnValue(0) }
        ArraySet(CA_Wire.path_s, CA_Wire.npath, 0)
        WhileLoop LessThan(ArrayGet(CA_Wire.path_s, CA_Wire.npath), Add(CA_Wire.nl, CA_Wire.na)) {
            CA_Wire.si = ArrayGet(CA_Wire.path_s, CA_Wire.npath)
            CA_Wire.rev = Subtract(0, 1)
            IfCondition LessThan(CA_Wire.si, CA_Wire.nl) ThenBlock: {
                IfCondition EqualTo(ArrayGet(CA_Wire.used_l, CA_Wire.si), 0) ThenBlock: {
                    CA_WireLineEnds(CA_Wire.si)
                    IfCondition EqualTo(CA_WireNear(CA_Wire.tipx, CA_Wire.tipy, CA_Wire.ex, CA_Wire.ey), 1) ThenBlock: { CA_Wire.rev = 0 }
                    IfCondition EqualTo(CA_Wire.rev, Subtract(0, 1)) ThenBlock: {
                        IfCondition EqualTo(CA_WireNear(CA_Wire.tipx, CA_Wire.tipy, CA_Wire.fx, CA_Wire.fy), 1) ThenBlock: { CA_Wire.rev = 1 }
                    }
                    IfCondition GreaterEqual(CA_Wire.rev, 0) ThenBlock: {
                        ArraySet(CA_Wire.used_l, CA_Wire.si, 1)
                        ArraySet(CA_Wire.path_k, CA_Wire.npath, 0)
                        ArraySet(CA_Wire.path_i, CA_Wire.npath, CA_Wire.si)
                        ArraySet(CA_Wire.path_r, CA_Wire.npath, CA_Wire.rev)
                        IfCondition EqualTo(CA_Wire.rev, 0) ThenBlock: {
                            CA_Wire.tipx = CA_Wire.fx
                            CA_Wire.tipy = CA_Wire.fy
                        }
                        IfCondition NotEqual(CA_Wire.rev, 0) ThenBlock: {
                            CA_Wire.tipx = CA_Wire.ex
                            CA_Wire.tipy = CA_Wire.ey
                        }
                        ArraySet(CA_Wire.path_tx, CA_Wire.npath, CA_Wire.tipx)
                        ArraySet(CA_Wire.path_ty, CA_Wire.npath, CA_Wire.tipy)
                        CA_Wire.npath = Add(CA_Wire.npath, 1)
                        IfCondition EqualTo(CA_WalkExtend(), 1) ThenBlock: { ReturnValue(1) }
                        CA_Wire.npath = Subtract(CA_Wire.npath, 1)
                        ArraySet(CA_Wire.used_l, ArrayGet(CA_Wire.path_i, CA_Wire.npath), 0)
                        IfCondition GreaterThan(CA_Wire.npath, 0) ThenBlock: {
                            CA_Wire.tipx = ArrayGet(CA_Wire.path_tx, Subtract(CA_Wire.npath, 1))
                            CA_Wire.tipy = ArrayGet(CA_Wire.path_ty, Subtract(CA_Wire.npath, 1))
                        }
                    }
                }
            }
            IfCondition GreaterEqual(CA_Wire.si, CA_Wire.nl) ThenBlock: {
                CA_Wire.b = Subtract(CA_Wire.si, CA_Wire.nl)
                IfCondition EqualTo(ArrayGet(CA_Wire.used_a, CA_Wire.b), 0) ThenBlock: {
                    CA_WireArcEnds(CA_Wire.b)
                    IfCondition EqualTo(CA_WireNear(CA_Wire.tipx, CA_Wire.tipy, CA_Wire.ex, CA_Wire.ey), 1) ThenBlock: { CA_Wire.rev = 0 }
                    IfCondition EqualTo(CA_Wire.rev, Subtract(0, 1)) ThenBlock: {
                        IfCondition EqualTo(CA_WireNear(CA_Wire.tipx, CA_Wire.tipy, CA_Wire.fx, CA_Wire.fy), 1) ThenBlock: { CA_Wire.rev = 1 }
                    }
                    IfCondition GreaterEqual(CA_Wire.rev, 0) ThenBlock: {
                        ArraySet(CA_Wire.used_a, CA_Wire.b, 1)
                        ArraySet(CA_Wire.path_k, CA_Wire.npath, 2)
                        ArraySet(CA_Wire.path_i, CA_Wire.npath, CA_Wire.b)
                        ArraySet(CA_Wire.path_r, CA_Wire.npath, CA_Wire.rev)
                        IfCondition EqualTo(CA_Wire.rev, 0) ThenBlock: {
                            CA_Wire.tipx = CA_Wire.fx
                            CA_Wire.tipy = CA_Wire.fy
                        }
                        IfCondition NotEqual(CA_Wire.rev, 0) ThenBlock: {
                            CA_Wire.tipx = CA_Wire.ex
                            CA_Wire.tipy = CA_Wire.ey
                        }
                        ArraySet(CA_Wire.path_tx, CA_Wire.npath, CA_Wire.tipx)
                        ArraySet(CA_Wire.path_ty, CA_Wire.npath, CA_Wire.tipy)
                        CA_Wire.npath = Add(CA_Wire.npath, 1)
                        IfCondition EqualTo(CA_WalkExtend(), 1) ThenBlock: { ReturnValue(1) }
                        CA_Wire.npath = Subtract(CA_Wire.npath, 1)
                        ArraySet(CA_Wire.used_a, ArrayGet(CA_Wire.path_i, CA_Wire.npath), 0)
                        IfCondition GreaterThan(CA_Wire.npath, 0) ThenBlock: {
                            CA_Wire.tipx = ArrayGet(CA_Wire.path_tx, Subtract(CA_Wire.npath, 1))
                            CA_Wire.tipy = ArrayGet(CA_Wire.path_ty, Subtract(CA_Wire.npath, 1))
                        }
                    }
                }
            }
            ArraySet(CA_Wire.path_s, CA_Wire.npath, Add(ArrayGet(CA_Wire.path_s, CA_Wire.npath), 1))
        }
        ReturnValue(0)
    }
}

// Planar left-face walk. No first-closed-cycle DFS — T-junctions
// keep the fillet on the outer and the trimmed bite as its own wire.
Function.CA_JoinLineArcWires {
    Output: Integer
    Body: {
        CA_WireBuildGraph()
        CA_WireDumpGraph()
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CA_Wire.nhe) {
            IfCondition EqualTo(ArrayGet(CA_Wire.he_used, CA_Wire.i), 0) ThenBlock: {
                CA_Wire.npath = 0
                CA_Wire.cur = CA_Wire.i
                CA_Wire.ok = 0
                CA_Wire.j = 0
                WhileLoop LessThan(CA_Wire.j, 64) {
                    ArraySet(CA_Wire.he_used, CA_Wire.cur, 1)
                    ArraySet(CA_Wire.path_s, CA_Wire.npath, CA_Wire.cur)
                    ArraySet(CA_Wire.path_k, CA_Wire.npath, ArrayGet(CA_Wire.he_k, CA_Wire.cur))
                    ArraySet(CA_Wire.path_i, CA_Wire.npath, ArrayGet(CA_Wire.he_e, CA_Wire.cur))
                    ArraySet(CA_Wire.path_r, CA_Wire.npath, ArrayGet(CA_Wire.he_r, CA_Wire.cur))
                    CA_Wire.npath = Add(CA_Wire.npath, 1)
                    CA_Wire.nxt = CA_WireNextHE(CA_Wire.cur)
                    IfCondition EqualTo(CA_Wire.nxt, CA_Wire.i) ThenBlock: {
                        CA_Wire.ok = 1
                        CA_Wire.j = 64
                    }
                    IfCondition EqualTo(CA_Wire.ok, 0) ThenBlock: {
                        IfCondition LessThan(CA_Wire.nxt, 0) ThenBlock: {
                            CA_Wire.j = 64
                        }
                        IfCondition GreaterEqual(CA_Wire.nxt, 0) ThenBlock: {
                            IfCondition EqualTo(ArrayGet(CA_Wire.he_used, CA_Wire.nxt), 1) ThenBlock: {
                                CA_Wire.j = 64
                            }
                            IfCondition NotEqual(ArrayGet(CA_Wire.he_used, CA_Wire.nxt), 1) ThenBlock: {
                                CA_Wire.cur = CA_Wire.nxt
                            }
                        }
                    }
                    CA_Wire.j = Add(CA_Wire.j, 1)
                }
                CA_LogInt("sol: walk startHE=", 18, CA_Wire.i)
                CA_LogInt(" npath=", 7, CA_Wire.npath)
                CA_LogInt(" closed=", 8, CA_Wire.ok)
                // 90° trim tips sometimes miss by <0.2 mm — dest ≈ start is closed.
                IfCondition EqualTo(CA_Wire.ok, 0) ThenBlock: {
                    IfCondition GreaterEqual(CA_Wire.npath, 3) ThenBlock: {
                        CA_Wire.cur = ArrayGet(CA_Wire.path_s, Subtract(CA_Wire.npath, 1))
                        CA_Wire.v0 = ArrayGet(CA_Wire.he_b, CA_Wire.cur)
                        CA_Wire.cur = ArrayGet(CA_Wire.path_s, 0)
                        CA_Wire.v1 = ArrayGet(CA_Wire.he_a, CA_Wire.cur)
                        IfCondition EqualTo(CA_WireNear(ArrayGet(CA_Wire.vx, CA_Wire.v0), ArrayGet(CA_Wire.vy, CA_Wire.v0), ArrayGet(CA_Wire.vx, CA_Wire.v1), ArrayGet(CA_Wire.vy, CA_Wire.v1)), 1) ThenBlock: {
                            CA_Wire.ok = 1
                            CA_Log("sol: walk almost-close\n", 22)
                        }
                    }
                }
                // Failed walk must not keep the edges. Leave only the start
                // marked so we do not retry the same dead HE.
                IfCondition EqualTo(CA_Wire.ok, 0) ThenBlock: {
                    CA_Wire.si = 1
                    WhileLoop LessThan(CA_Wire.si, CA_Wire.npath) {
                        ArraySet(CA_Wire.he_used, ArrayGet(CA_Wire.path_s, CA_Wire.si), 0)
                        CA_Wire.si = Add(CA_Wire.si, 1)
                    }
                }
                IfCondition EqualTo(CA_Wire.ok, 1) ThenBlock: {
                    // 1- and 2-edge closed wires are valid (full circle,
                    // two-arc leftover). Degenerate out-and-back has area=0.
                    IfCondition GreaterEqual(CA_Wire.npath, 1) ThenBlock: {
                        CA_WirePathArea()
                        CA_LogF("sol: walk area=", 15, CA_Wire.area)
                        // Pac-Man leftovers often compute CW on both
                        // windings (major-arc mid landed in the mouth).
                        // Flip to CCW and still emit — otherwise the bite
                        // is glued into the parent fill and cannot be picked.
                        IfCondition EqualTo(CAD_Num.IsZero(CA_Wire.area, 0), 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsNeg(CA_Wire.area), 1) ThenBlock: {
                                CA_WireReversePath()
                                CA_WirePathArea()
                                CA_LogF("sol: walk reversed area=", 24, CA_Wire.area)
                            }
                        }
                        IfCondition EqualTo(CAD_Num.IsNeg(CA_Wire.area), 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsZero(CA_Wire.area, 0), 0) ThenBlock: {
                                CA_Wire.si = 0
                                WhileLoop LessThan(CA_Wire.si, CA_Wire.npath) {
                                    CA_LogInt("sol:   path k=", 14, ArrayGet(CA_Wire.path_k, CA_Wire.si))
                                    CA_LogInt(" e=", 3, ArrayGet(CA_Wire.path_i, CA_Wire.si))
                                    CA_LogInt(" r=", 3, ArrayGet(CA_Wire.path_r, CA_Wire.si))
                                    CA_Wire.si = Add(CA_Wire.si, 1)
                                }
                                IfCondition EqualTo(CadAppPad.ok, 3) ThenBlock: {
                                    CA_ProfAppendLivePath()
                                }
                                IfCondition NotEqual(CadAppPad.ok, 3) ThenBlock: {
                                    CA_WireEmitPath()
                                }
                                CA_WireMarkPathTwins()
                                CA_LogInt("cad_app: sweep face-walk n=", 26, CA_Wire.npath)
                            }
                        }
                    }
                }
            }
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        ReturnValue(0)
    }
}

Function.CA_AddCircleWires {
    Output: Integer
    Body: {
        CA_Wire.nc = CAD_Sketch.GetCircleCount(CA_Wire.sk)
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CA_Wire.nc) {
            CA_Wire.j = CAD_Store.Read(CA_Wire.sk, 8)
            IfCondition NotEqual(CA_Wire.j, 0) ThenBlock: {
                CA_Wire.cx = ArrayGet(CA_Wire.j, Multiply(CA_Wire.i, 3))
                CA_Wire.cy = ArrayGet(CA_Wire.j, Add(Multiply(CA_Wire.i, 3), 1))
                CA_Wire.r = ArrayGet(CA_Wire.j, Add(Multiply(CA_Wire.i, 3), 2))
                CAD_Topo.SweepBeginWire()
                CAD_Topo_Sweep.px0 = CA_Wire.cx
                CAD_Topo_Sweep.py0 = CA_Wire.cy
                CAD_Topo_Sweep.px1 = CA_Wire.r
                CAD_Topo_Sweep.pa0 = 0
                CAD_Topo_Sweep.pa1 = 0x401921FB54442D18
                CAD_Topo.SweepAddArcPinned()
                CA_Log("cad_app: sweep circle wire\n", 27)
            }
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        ReturnValue(CA_Wire.nc)
    }
}

// Sample a point ON wire w (first-curve midpoint / arc start).
Function.CA_WireSample {
    Input: w: Integer
    Output: Integer
    Body: {
        CA_Wire.ok = 0
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CAD_Topo_Sweep.ncurve) {
            IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.cwire, CA_Wire.i), w) ThenBlock: {
                IfCondition EqualTo(CA_Wire.ok, 0) ThenBlock: {
                    IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.ckind, CA_Wire.i), 0) ThenBlock: {
                        CA_Wire.px = Float_Mul(Float_Add(ArrayGet(CAD_Topo_Sweep.cx0, CA_Wire.i), ArrayGet(CAD_Topo_Sweep.cx1, CA_Wire.i)), 0x3FE0000000000000)
                        CA_Wire.py = Float_Mul(Float_Add(ArrayGet(CAD_Topo_Sweep.cy0, CA_Wire.i), ArrayGet(CAD_Topo_Sweep.cy1, CA_Wire.i)), 0x3FE0000000000000)
                    }
                    IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.ckind, CA_Wire.i), 2) ThenBlock: {
                        CA_Wire.cx = ArrayGet(CAD_Topo_Sweep.cx0, CA_Wire.i)
                        CA_Wire.cy = ArrayGet(CAD_Topo_Sweep.cy0, CA_Wire.i)
                        CA_Wire.r = ArrayGet(CAD_Topo_Sweep.cx1, CA_Wire.i)
                        CA_Wire.cs = CAD_Geom.Cos(ArrayGet(CAD_Topo_Sweep.ca0, CA_Wire.i))
                        CA_Wire.sn = CAD_Geom.Sin(ArrayGet(CAD_Topo_Sweep.ca0, CA_Wire.i))
                        CA_Wire.px = Float_Add(CA_Wire.cx, Float_Mul(CA_Wire.r, CA_Wire.cs))
                        CA_Wire.py = Float_Add(CA_Wire.cy, Float_Mul(CA_Wire.r, CA_Wire.sn))
                    }
                    CA_Wire.ok = 1
                }
            }
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        ReturnValue(CA_Wire.ok)
    }
}

// 1 if (px,py) is inside wire w. Circle wire = disk. Else even-odd of curve starts.
Function.CA_WireContains {
    Input: w: Integer
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        CA_Wire.px = px
        CA_Wire.py = py
        CA_Wire.nn = 0
        CA_Wire.full = 0
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CAD_Topo_Sweep.ncurve) {
            IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.cwire, CA_Wire.i), w) ThenBlock: {
                IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.ckind, CA_Wire.i), 2) ThenBlock: {
                    CA_Wire.cx = ArrayGet(CAD_Topo_Sweep.cx0, CA_Wire.i)
                    CA_Wire.cy = ArrayGet(CAD_Topo_Sweep.cy0, CA_Wire.i)
                    CA_Wire.r = ArrayGet(CAD_Topo_Sweep.cx1, CA_Wire.i)
                    CA_Wire.a0 = Float_Sub(ArrayGet(CAD_Topo_Sweep.ca1, CA_Wire.i), ArrayGet(CAD_Topo_Sweep.ca0, CA_Wire.i))
                    IfCondition EqualTo(Float_Le(CA_Wire.a0, 0x4012D97C7F3321D2), 0) ThenBlock: { CA_Wire.full = 1 }
                    CA_Wire.cs = CAD_Geom.Cos(ArrayGet(CAD_Topo_Sweep.ca0, CA_Wire.i))
                    CA_Wire.sn = CAD_Geom.Sin(ArrayGet(CAD_Topo_Sweep.ca0, CA_Wire.i))
                    ArraySet(CA_Wire.poly, Multiply(CA_Wire.nn, 2), Float_Add(CA_Wire.cx, Float_Mul(CA_Wire.r, CA_Wire.cs)))
                    ArraySet(CA_Wire.poly, Add(Multiply(CA_Wire.nn, 2), 1), Float_Add(CA_Wire.cy, Float_Mul(CA_Wire.r, CA_Wire.sn)))
                }
                IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.ckind, CA_Wire.i), 0) ThenBlock: {
                    ArraySet(CA_Wire.poly, Multiply(CA_Wire.nn, 2), ArrayGet(CAD_Topo_Sweep.cx0, CA_Wire.i))
                    ArraySet(CA_Wire.poly, Add(Multiply(CA_Wire.nn, 2), 1), ArrayGet(CAD_Topo_Sweep.cy0, CA_Wire.i))
                }
                CA_Wire.nn = Add(CA_Wire.nn, 1)
            }
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        IfCondition EqualTo(CA_Wire.nn, 1) ThenBlock: {
            IfCondition EqualTo(CA_Wire.full, 1) ThenBlock: {
                CA_Wire.cs = Float_Sub(CA_Wire.px, CA_Wire.cx)
                CA_Wire.sn = Float_Sub(CA_Wire.py, CA_Wire.cy)
                CA_Wire.cs = Float_Add(Float_Mul(CA_Wire.cs, CA_Wire.cs), Float_Mul(CA_Wire.sn, CA_Wire.sn))
                CA_Wire.sn = Float_Mul(CA_Wire.r, CA_Wire.r)
                IfCondition EqualTo(Float_Le(CA_Wire.cs, CA_Wire.sn), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(CA_Wire.cs, CA_Wire.sn, 0), 0) ThenBlock: { ReturnValue(1) }
                }
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(CA_Wire.nn, 2) ThenBlock: {
            // line + arc: insert mid-arc so the segment is a real triangle
            CA_Wire.i = 0
            WhileLoop LessThan(CA_Wire.i, CAD_Topo_Sweep.ncurve) {
                IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.cwire, CA_Wire.i), w) ThenBlock: {
                    IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.ckind, CA_Wire.i), 2) ThenBlock: {
                        CA_Wire.cx = ArrayGet(CAD_Topo_Sweep.cx0, CA_Wire.i)
                        CA_Wire.cy = ArrayGet(CAD_Topo_Sweep.cy0, CA_Wire.i)
                        CA_Wire.r = ArrayGet(CAD_Topo_Sweep.cx1, CA_Wire.i)
                        CA_Wire.dang = Float_Mul(Float_Add(ArrayGet(CAD_Topo_Sweep.ca0, CA_Wire.i), ArrayGet(CAD_Topo_Sweep.ca1, CA_Wire.i)), 0x3FE0000000000000)
                        CA_Wire.cs = CAD_Geom.Cos(CA_Wire.dang)
                        CA_Wire.sn = CAD_Geom.Sin(CA_Wire.dang)
                        ArraySet(CA_Wire.poly, 4, Float_Add(CA_Wire.cx, Float_Mul(CA_Wire.r, CA_Wire.cs)))
                        ArraySet(CA_Wire.poly, 5, Float_Add(CA_Wire.cy, Float_Mul(CA_Wire.r, CA_Wire.sn)))
                        CA_Wire.nn = 3
                    }
                }
                CA_Wire.i = Add(CA_Wire.i, 1)
            }
        }
        IfCondition LessThan(CA_Wire.nn, 3) ThenBlock: { ReturnValue(0) }
        ReturnValue(CA_PointInPoly(CA_Wire.px, CA_Wire.py, CA_Wire.poly, CA_Wire.nn))
    }
}

Function.CA_PtOnWire {
    Input: w: Integer
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        CA_Wire.px = px
        CA_Wire.py = py
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CAD_Topo_Sweep.ncurve) {
            IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.cwire, CA_Wire.i), w) ThenBlock: {
                IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.ckind, CA_Wire.i), 0) ThenBlock: {
                    IfCondition EqualTo(CA_WireNear(CA_Wire.px, CA_Wire.py, ArrayGet(CAD_Topo_Sweep.cx0, CA_Wire.i), ArrayGet(CAD_Topo_Sweep.cy0, CA_Wire.i)), 1) ThenBlock: { ReturnValue(1) }
                    IfCondition EqualTo(CA_WireNear(CA_Wire.px, CA_Wire.py, ArrayGet(CAD_Topo_Sweep.cx1, CA_Wire.i), ArrayGet(CAD_Topo_Sweep.cy1, CA_Wire.i)), 1) ThenBlock: { ReturnValue(1) }
                }
                IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.ckind, CA_Wire.i), 2) ThenBlock: {
                    CA_Wire.cx = ArrayGet(CAD_Topo_Sweep.cx0, CA_Wire.i)
                    CA_Wire.cy = ArrayGet(CAD_Topo_Sweep.cy0, CA_Wire.i)
                    CA_Wire.r = ArrayGet(CAD_Topo_Sweep.cx1, CA_Wire.i)
                    CA_Wire.cs = Float_Sub(CA_Wire.px, CA_Wire.cx)
                    CA_Wire.sn = Float_Sub(CA_Wire.py, CA_Wire.cy)
                    CA_Wire.cs = CAD_Num.Sqrt(Float_Add(Float_Mul(CA_Wire.cs, CA_Wire.cs), Float_Mul(CA_Wire.sn, CA_Wire.sn)))
                    CA_Wire.cs = Float_Sub(CA_Wire.cs, CA_Wire.r)
                    CA_Wire.cs = Float_Mul(CA_Wire.cs, CA_Wire.cs)
                    IfCondition EqualTo(Float_Le(CA_Wire.cs, CA_Wire.eps2), 1) ThenBlock: { ReturnValue(1) }
                }
            }
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        ReturnValue(0)
    }
}

Function.CA_WireArea {
    Input: w: Integer
    Output: Integer
    Body: {
        CA_Wire.area = 0
        CA_Wire.nn = 0
        CA_Wire.full = 0
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CAD_Topo_Sweep.ncurve) {
            IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.cwire, CA_Wire.i), w) ThenBlock: {
                IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.ckind, CA_Wire.i), 2) ThenBlock: {
                    CA_Wire.r = ArrayGet(CAD_Topo_Sweep.cx1, CA_Wire.i)
                    CA_Wire.a0 = Float_Sub(ArrayGet(CAD_Topo_Sweep.ca1, CA_Wire.i), ArrayGet(CAD_Topo_Sweep.ca0, CA_Wire.i))
                    IfCondition EqualTo(Float_Le(CA_Wire.a0, 0x4012D97C7F3321D2), 0) ThenBlock: { CA_Wire.full = 1 }
                    CA_Wire.cx = ArrayGet(CAD_Topo_Sweep.cx0, CA_Wire.i)
                    CA_Wire.cy = ArrayGet(CAD_Topo_Sweep.cy0, CA_Wire.i)
                    CA_Wire.cs = CAD_Geom.Cos(ArrayGet(CAD_Topo_Sweep.ca0, CA_Wire.i))
                    CA_Wire.sn = CAD_Geom.Sin(ArrayGet(CAD_Topo_Sweep.ca0, CA_Wire.i))
                    ArraySet(CA_Wire.poly, Multiply(CA_Wire.nn, 2), Float_Add(CA_Wire.cx, Float_Mul(CA_Wire.r, CA_Wire.cs)))
                    ArraySet(CA_Wire.poly, Add(Multiply(CA_Wire.nn, 2), 1), Float_Add(CA_Wire.cy, Float_Mul(CA_Wire.r, CA_Wire.sn)))
                }
                IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.ckind, CA_Wire.i), 0) ThenBlock: {
                    ArraySet(CA_Wire.poly, Multiply(CA_Wire.nn, 2), ArrayGet(CAD_Topo_Sweep.cx0, CA_Wire.i))
                    ArraySet(CA_Wire.poly, Add(Multiply(CA_Wire.nn, 2), 1), ArrayGet(CAD_Topo_Sweep.cy0, CA_Wire.i))
                }
                CA_Wire.nn = Add(CA_Wire.nn, 1)
            }
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        IfCondition EqualTo(CA_Wire.nn, 1) ThenBlock: {
            IfCondition EqualTo(CA_Wire.full, 1) ThenBlock: {
                CA_Wire.area = Float_Mul(0x400921FB54442D18, Float_Mul(CA_Wire.r, CA_Wire.r))
                ReturnValue(CA_Wire.area)
            }
        }
        IfCondition EqualTo(CA_Wire.nn, 2) ThenBlock: {
            CA_Wire.i = 0
            WhileLoop LessThan(CA_Wire.i, CAD_Topo_Sweep.ncurve) {
                IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.cwire, CA_Wire.i), w) ThenBlock: {
                    IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.ckind, CA_Wire.i), 2) ThenBlock: {
                        CA_Wire.cx = ArrayGet(CAD_Topo_Sweep.cx0, CA_Wire.i)
                        CA_Wire.cy = ArrayGet(CAD_Topo_Sweep.cy0, CA_Wire.i)
                        CA_Wire.r = ArrayGet(CAD_Topo_Sweep.cx1, CA_Wire.i)
                        CA_Wire.dang = Float_Mul(Float_Add(ArrayGet(CAD_Topo_Sweep.ca0, CA_Wire.i), ArrayGet(CAD_Topo_Sweep.ca1, CA_Wire.i)), 0x3FE0000000000000)
                        CA_Wire.cs = CAD_Geom.Cos(CA_Wire.dang)
                        CA_Wire.sn = CAD_Geom.Sin(CA_Wire.dang)
                        ArraySet(CA_Wire.poly, 4, Float_Add(CA_Wire.cx, Float_Mul(CA_Wire.r, CA_Wire.cs)))
                        ArraySet(CA_Wire.poly, 5, Float_Add(CA_Wire.cy, Float_Mul(CA_Wire.r, CA_Wire.sn)))
                        CA_Wire.nn = 3
                    }
                }
                CA_Wire.i = Add(CA_Wire.i, 1)
            }
        }
        CA_Wire.i = 0
        WhileLoop LessThan(CA_Wire.i, CA_Wire.nn) {
            CA_Wire.j = Add(CA_Wire.i, 1)
            IfCondition EqualTo(CA_Wire.j, CA_Wire.nn) ThenBlock: { CA_Wire.j = 0 }
            CA_Wire.area = Float_Add(CA_Wire.area, Float_Sub(Float_Mul(ArrayGet(CA_Wire.poly, Multiply(CA_Wire.i, 2)), ArrayGet(CA_Wire.poly, Add(Multiply(CA_Wire.j, 2), 1))), Float_Mul(ArrayGet(CA_Wire.poly, Multiply(CA_Wire.j, 2)), ArrayGet(CA_Wire.poly, Add(Multiply(CA_Wire.i, 2), 1)))))
            CA_Wire.i = Add(CA_Wire.i, 1)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(CA_Wire.area), 1) ThenBlock: { CA_Wire.area = Float_Sub(0, CA_Wire.area) }
        ReturnValue(CA_Wire.area)
    }
}

// Reorder wires: chosen outer becomes 0, holes 1.. . Drop disjoint islands.
