    "undo_ok":    Initialize=0, CanChange=True
    "undo_sk":    Initialize=0, CanChange=True
    "undo_pl":    Initialize=0, CanChange=True
    "undo_solid": Initialize=0, CanChange=True
    "undo_mode":  Initialize=0, CanChange=True
    // pinned body across ExtrudeOnPlane (locals clobber) + Pick
    "keep_solid": Initialize=0, CanChange=True
    // sketch-on-face pick walk (FaceCentroid / World3ToPix clobber locals)
    "pick_best_f": Initialize=0, CanChange=True
    "pick_best_d": Initialize=0, CanChange=True
    "pick_shell":  Initialize=0, CanChange=True
    "pick_fh":     Initialize=0, CanChange=True
    "pick_n":      Initialize=0, CanChange=True
    // how many sketches created this part (HUD sk=)
    "sk_i":        Initialize=0, CanChange=True
    // Sketch-on-Face hover highlight (planar face under cursor)
    "hover_face":  Initialize=0, CanChange=True
    // last hover UV (integer mm) for HUD / type-in
    "hover_u":     Initialize=0, CanChange=True
    "hover_v":     Initialize=0, CanChange=True
    // frozen face-vertex user points on the active on-face sketch
    "n_face_ref":  Initialize=0, CanChange=True
    // feature timeline: kind 0=sketch 1=pad 2=revolve 3=cut 4=fillet 5=chamfer
    "feat_n":      Initialize=0, CanChange=True
    "feat_kind":   Initialize=0, CanChange=True
    "feat_sk":     Initialize=0, CanChange=True
    "feat_sel":    Initialize=0, CanChange=True
    // 16 sketch aliases × 32 bytes (Sketch_N id stays; this is the user name)
    "sk_alias":    Initialize=0, CanChange=True
    // 32 feature aliases × 32 bytes (Pad / Fillet / … user names)
    "feat_alias":  Initialize=0, CanChange=True
    // 0=none 1=offset mm 2=angle deg — HUD type-in then Enter
    "plane_kind":  Initialize=0, CanChange=True
    // last committed line index for HUD L/A edit (-1 none)
    "last_line":   Initialize=-1, CanChange=True
    // 0=none 1=poly 2=line 3=circ 4=rect 5=fillet2d 6=cstr 7=pad 8=rev 9=chamfer 10=fillet3d
    "hud_kind":    Initialize=0, CanChange=True
    // poly: 0=N 1=L 2=D   line: 0=L 1=A
    "hud_field":   Initialize=0, CanChange=True
    // circumdiameter mm (0 = unset). Coupled to poly_side via sin(π/N).
    "poly_diam":   Initialize=0, CanChange=True
