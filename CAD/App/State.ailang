    "poly_n":    Initialize=6, CanChange=True
    // 0=center+vertex  1=2-pt edge  2=center+2 verts
    "poly_mode": Initialize=0, CanChange=True
    // 0 = size from click; else side length mm
    "poly_side": Initialize=0, CanChange=True
    "spl_n":     Initialize=0, CanChange=True
    "spl_xy":    Initialize=0, CanChange=True
