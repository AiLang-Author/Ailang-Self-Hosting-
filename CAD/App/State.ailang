    "running":   Initialize=1, CanChange=True
    "dxf_path":  Initialize=0, CanChange=True
    "hole_path": Initialize=0, CanChange=True
    "mode":      Initialize=0, CanChange=True
    "tool":      Initialize=0, CanChange=True
    "nclick":    Initialize=0, CanChange=True
    "cx0":       Initialize=0, CanChange=True
    "cy0":       Initialize=0, CanChange=True
    "scale":     Initialize=0, CanChange=True
    "extent":    Initialize=0, CanChange=True
    "nprof":     Initialize=0, CanChange=True
    "dirty":     Initialize=0, CanChange=True
    "part_name": Initialize=0, CanChange=True
    "repo_ok":   Initialize=0, CanChange=True
    "part_rev":  Initialize=0, CanChange=True
    // 0 part  1 assembly  2 group  3 machine
    "doc_kind":  Initialize=0, CanChange=True
    // 1 = rebuild existing pad (HUD / tree Edit) — do not FeatAdd again
    "pad_edit":  Initialize=0, CanChange=True
    // Extrude boolean: 0=join  1=cut  2=new body
    "extrude_op": Initialize=0, CanChange=True
    "last_pad":  Initialize=-1, CanChange=True
    "rev_deg":   Initialize=360, CanChange=True
    "rev_edit":  Initialize=0, CanChange=True
    "last_revf": Initialize=-1, CanChange=True
    "list_buf":  Initialize=0, CanChange=True
    "list_count":Initialize=0, CanChange=True
    "list_sel":  Initialize=0, CanChange=True
    "list_open": Initialize=0, CanChange=True
    "name_buf":  Initialize=0, CanChange=True
    "hover_px":  Initialize=0, CanChange=True
    "hover_py":  Initialize=0, CanChange=True
    "hover_ok":  Initialize=0, CanChange=True
    "prof_sel":  Initialize=0, CanChange=True
    "prof_user": Initialize=0, CanChange=True
    // bit mask of selected profiles (bit i = profile i); multi Pad via CompoundAdd
    "prof_mask": Initialize=0, CanChange=True
    "click_shift": Initialize=0, CanChange=True
    // PlaneFeature handle for active sketch (0 = world Sketch_0 / XY)
    "plane":     Initialize=0, CanChange=True
    // Immutable part root plane (Sketch_0). Children inherit from this.
    "sk0_plane": Initialize=0, CanChange=True
    // construction plane list: plane_list addr of 16 handles, plane_n count
    "plane_n":   Initialize=0, CanChange=True
    "plane_list":Initialize=0, CanChange=True
    // sketches in document order (max 16). Not FreeCAD dump, not Fusion timeline.
    "sk_n":      Initialize=0, CanChange=True
    "sk_list":   Initialize=0, CanChange=True
    // 1 = OnTop face-pick mode: next 3D click selects planar face → new sketch
    "face_pick": Initialize=0, CanChange=True
    // construction-plane gesture: 0 idle  1 pick plane  2 from face
    // 3 set origin  4 through 3 points
    "plane_pick": Initialize=0, CanChange=True
    // hovered construction-plane handle (plane_pick=1)
    "hover_plane": Initialize=0, CanChange=True
    // through-3pt world points (9 floats) + how many clicked
    "pln_xyz": Initialize=0, CanChange=True
    "pln_ptn": Initialize=0, CanChange=True
    // last picked / bound B-Rep face handle (0 = none). Identity is plane pid.
    "last_face": Initialize=0, CanChange=True
    // show construction planes in 3D (default on)
    "show_planes": Initialize=1, CanChange=True
    // UV grid on construction planes (axes/border stay when grid off)
    "show_grid": Initialize=1, CanChange=True
    // 1 = draw host-face edges in the active sketch (Fusion-style projections)
    "show_proj": Initialize=1, CanChange=True
    "proj_n":    Initialize=0, CanChange=True
    "proj_xy":   Initialize=0, CanChange=True
    // owned buffer for DXF import path (file dialog / IPC path.txt)
    "path_buf":  Initialize=0, CanChange=True
