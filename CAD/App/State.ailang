// Pad scratch — 64KB rings. Allocate-per-pad SEGVd after hex tess.
FixedPool.CadAppPad {
    "xy":      Initialize=0, CanChange=True
    "oxy":     Initialize=0, CanChange=True
    "spliced": Initialize=0, CanChange=True
}

Function.CA_PadBufs {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppPad.xy, 0) ThenBlock: { CadAppPad.xy = Allocate(65536) }
        IfCondition EqualTo(CadAppPad.oxy, 0) ThenBlock: { CadAppPad.oxy = Allocate(65536) }
        IfCondition EqualTo(CadAppPad.spliced, 0) ThenBlock: { CadAppPad.spliced = Allocate(65536) }
        IfCondition EqualTo(CadAppPad.xy, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadAppPad.oxy, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadAppPad.spliced, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

// Pin pick/outline slabs once. Hover Allocate after tess is fatal.
Function.CA_PickBufs {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppPick.fr, 0) ThenBlock: { CadAppPick.fr = Allocate(64) }
        IfCondition EqualTo(CadAppPick.pl, 0) ThenBlock: { CadAppPick.pl = Allocate(128) }
        IfCondition EqualTo(CadAppPick.hit, 0) ThenBlock: { CadAppPick.hit = Allocate(32) }
        IfCondition EqualTo(CadAppPick.uv, 0) ThenBlock: { CadAppPick.uv = Allocate(4096) }
        IfCondition EqualTo(CadAppPick.pr, 0) ThenBlock: { CadAppPick.pr = Allocate(32) }
        IfCondition EqualTo(CadAppPick.pa, 0) ThenBlock: { CadAppPick.pa = Allocate(32) }
        IfCondition EqualTo(CadAppPick.pb, 0) ThenBlock: { CadAppPick.pb = Allocate(32) }
        IfCondition EqualTo(CadAppPick.hit_t, 0) ThenBlock: { CadAppPick.hit_t = Allocate(256) }
        IfCondition EqualTo(CadAppPick.hit_f, 0) ThenBlock: { CadAppPick.hit_f = Allocate(256) }
        ReturnValue(0)
    }
}

Function.CA_IpcOut {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppIpc.parse, 0) ThenBlock: {
            CadAppIpc.parse = Allocate(32)
        }
        ReturnValue(CadAppIpc.parse)
    }
}


Function.CA_LogInit {
    Output: Integer
    Body: {
        // O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0644=420
        fd = SystemCall(2, "/tmp/cad_app/session.log", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            CadApp.log_fd = 0
            ReturnValue(-1)
        }
        CadApp.log_fd = fd
        CA_Log("cad_app: session.log /tmp/cad_app/session.log\n", 45)
        ReturnValue(0)
    }
}

Function.CA_Log {
    Input: msg: Address
    Input: n: Integer
    Output: Integer
    Body: {
        CAD_Sys.Write(2, msg, n)
        fd = CadApp.log_fd
        IfCondition GreaterThan(fd, 0) ThenBlock: {
            SystemCall(1, fd, msg, n)
        }
        ReturnValue(0)
    }
}

Function.CA_LogS {
    Input: msg: Address
    Output: Integer
    Body: {
        n = 0
        WhileLoop NotEqual(GetByte(msg, n), 0) {
            n = Add(n, 1)
        }
        ReturnValue(CA_Log(msg, n))
    }
}

Function.CA_LogInt {
    Input: msg: Address
    Input: nmsg: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        CA_Log(msg, nmsg)
        buf = Allocate(32)
        out = Allocate(32)
        g = val
        neg = 0
        IfCondition LessThan(g, 0) ThenBlock: {
            neg = 1
            g = Subtract(0, g)
        }
        n = 0
        IfCondition EqualTo(g, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            n = 1
        }
        WhileLoop GreaterThan(g, 0) {
            SetByte(buf, n, Add(48, Modulo(g, 10)))
            n = Add(n, 1)
            g = Divide(g, 10)
        }
        p = 0
        IfCondition EqualTo(neg, 1) ThenBlock: {
            SetByte(out, 0, 45)
            p = 1
        }
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(out, Add(p, i), GetByte(buf, Subtract(Subtract(n, 1), i)))
            i = Add(i, 1)
        }
        SetByte(out, Add(p, n), 10)
        CA_Log(out, Add(Add(p, n), 1))
        Deallocate(buf, 32)
        Deallocate(out, 32)
        ReturnValue(0)
    }
}

// Dump CAD_Sketch_TrimDbg after every trim click.
// CRITICAL: CA_Log length must equal string byte count exactly (over-read SEGV).
// why: 0 none | 1 line | 4 arc mid | 5 residual del | 8 restore | 9 legacy


// Dump CAD_Sketch_TrimDbg after every trim click.
// CRITICAL: CA_Log length must equal string byte count exactly (over-read SEGV).
// why: 0 none | 1 line | 4 arc mid | 5 residual del | 8 restore | 9 legacy
Function.CA_LogTrimDbg {
    Output: Integer
    Body: {
        w = CAD_Sketch_TrimDbg.why
        k = CAD_Sketch_TrimDbg.kind
        nt = CAD_Sketch_TrimDbg.nt
        IfCondition EqualTo(k, 0) ThenBlock: {
            CA_Log("cad_app: trim pick=NONE\n", 24)
        }
        IfCondition EqualTo(k, 1) ThenBlock: {
            CA_Log("cad_app: trim pick=LINE\n", 24)
        }
        IfCondition EqualTo(k, 2) ThenBlock: {
            CA_Log("cad_app: trim pick=CIRCLE\n", 26)
        }
        IfCondition EqualTo(k, 3) ThenBlock: {
            CA_Log("cad_app: trim pick=ARC\n", 23)
            IfCondition EqualTo(nt, 2) ThenBlock: {
                CA_Log("cad_app: trim arc joins=ends-only\n", 34)
            }
            IfCondition EqualTo(nt, 3) ThenBlock: {
                CA_Log("cad_app: trim arc joins=1 mid\n", 30)
            }
            IfCondition GreaterThan(nt, 3) ThenBlock: {
                CA_Log("cad_app: trim arc joins=multi mid\n", 34)
            }
        }
        IfCondition EqualTo(w, 0) ThenBlock: {
            CA_Log("cad_app: trim why=no hit\n", 25)
        }
        IfCondition EqualTo(w, 1) ThenBlock: {
            CA_Log("cad_app: trim why=line deleted\n", 31)
        }
        IfCondition EqualTo(w, 4) ThenBlock: {
            CA_Log("cad_app: trim why=arc mid-trim ok\n", 34)
        }
        IfCondition EqualTo(w, 5) ThenBlock: {
            CA_Log("cad_app: trim why=residual arc deleted\n", 39)
        }
        IfCondition EqualTo(w, 8) ThenBlock: {
            CA_Log("cad_app: trim why=arc restore\n", 30)
        }
        ReturnValue(0)
    }
}

// Projection ring color from sketch-pad background: push toward white on dark
// pads, toward black on light pads (readable delta, not neon on noise).


Function.CA_WriteFileStr {
    Input: path: Address
    Input: msg: Address
    Input: n: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        SystemCall(1, fd, msg, n)
        SystemCall(3, fd, 0, 0)
        ReturnValue(0)
    }
}


Function.CA_WriteGen {
    Output: Integer
    Body: {
        fd = SystemCall(2, "/tmp/cad_app/gen.txt", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadAppIpc.genb, 0) ThenBlock: { CadAppIpc.genb = Allocate(32) }
        IfCondition EqualTo(CadAppIpc.geno, 0) ThenBlock: { CadAppIpc.geno = Allocate(32) }
        buf = CadAppIpc.genb
        out = CadAppIpc.geno
        IfCondition EqualTo(buf, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            ReturnValue(-1)
        }
        IfCondition EqualTo(out, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            ReturnValue(-1)
        }
        g = CadApp.gen
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        n = 0
        IfCondition EqualTo(g, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            n = 1
        }
        WhileLoop GreaterThan(g, 0) {
            IfCondition LessThan(n, 20) ThenBlock: {
                SetByte(buf, n, Add(48, Modulo(g, 10)))
                n = Add(n, 1)
            }
            g = Divide(g, 10)
        }
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(out, i, GetByte(buf, Subtract(Subtract(n, 1), i)))
            i = Add(i, 1)
        }
        SetByte(out, n, 10)
        SystemCall(1, fd, out, Add(n, 1))
        SystemCall(3, fd, 0, 0)
        ReturnValue(0)
    }
}

// Ensure sketch camera: extent in mm, scale px/mm


Function.CA_HudStr {
    Input: s: Address
    Output: Integer
    Body: {
        CadAppHud.tn = s
        st = CadAppHud.st
        pos = CadAppHud.pos
        src = CadAppHud.tn
        IfCondition EqualTo(st, 0) ThenBlock: { ReturnValue(pos) }
        np = CAD_Repo.AppendStr(st, pos, src)
        CadAppHud.pos = np
        IfCondition GreaterThan(CadAppHud.pos, 370) ThenBlock: { CadAppHud.pos = 370 }
        ReturnValue(CadAppHud.pos)
    }
}

// No Allocate — AppendInt's 24-byte tmp SEGV'd after hex-pad heap pressure.
Function.CA_HudInt {
    Input: v: Integer
    Output: Integer
    Body: {
        CadAppHud.hv = v
        st = CadAppHud.st
        pos = CadAppHud.pos
        nv = CadAppHud.hv
        IfCondition EqualTo(st, 0) ThenBlock: { ReturnValue(pos) }
        IfCondition LessThan(nv, 0) ThenBlock: {
            SetByte(st, pos, 45)
            pos = Add(pos, 1)
            nv = Subtract(0, nv)
            IfCondition LessThan(nv, 0) ThenBlock: { nv = 0 }
        }
        IfCondition EqualTo(nv, 0) ThenBlock: {
            SetByte(st, pos, 48)
            pos = Add(pos, 1)
            CadAppHud.pos = pos
            ReturnValue(pos)
        }
        // write at most 6 decimal digits, no heap
        d5 = Divide(nv, 100000)
        nv = Subtract(nv, Multiply(d5, 100000))
        d4 = Divide(nv, 10000)
        nv = Subtract(nv, Multiply(d4, 10000))
        d3 = Divide(nv, 1000)
        nv = Subtract(nv, Multiply(d3, 1000))
        d2 = Divide(nv, 100)
        nv = Subtract(nv, Multiply(d2, 100))
        d1 = Divide(nv, 10)
        d0 = Subtract(nv, Multiply(d1, 10))
        started = 0
        IfCondition GreaterThan(d5, 0) ThenBlock: {
            SetByte(st, pos, Add(48, d5))
            pos = Add(pos, 1)
            started = 1
        }
        IfCondition EqualTo(started, 1) ThenBlock: {
            SetByte(st, pos, Add(48, d4))
            pos = Add(pos, 1)
        }
        IfCondition EqualTo(started, 0) ThenBlock: {
            IfCondition GreaterThan(d4, 0) ThenBlock: {
                SetByte(st, pos, Add(48, d4))
                pos = Add(pos, 1)
                started = 1
            }
        }
        IfCondition EqualTo(started, 1) ThenBlock: {
            SetByte(st, pos, Add(48, d3))
            pos = Add(pos, 1)
        }
        IfCondition EqualTo(started, 0) ThenBlock: {
            IfCondition GreaterThan(d3, 0) ThenBlock: {
                SetByte(st, pos, Add(48, d3))
                pos = Add(pos, 1)
                started = 1
            }
        }
        IfCondition EqualTo(started, 1) ThenBlock: {
            SetByte(st, pos, Add(48, d2))
            pos = Add(pos, 1)
        }
        IfCondition EqualTo(started, 0) ThenBlock: {
            IfCondition GreaterThan(d2, 0) ThenBlock: {
                SetByte(st, pos, Add(48, d2))
                pos = Add(pos, 1)
                started = 1
            }
        }
        IfCondition EqualTo(started, 1) ThenBlock: {
            SetByte(st, pos, Add(48, d1))
            pos = Add(pos, 1)
        }
        IfCondition EqualTo(started, 0) ThenBlock: {
            IfCondition GreaterThan(d1, 0) ThenBlock: {
                SetByte(st, pos, Add(48, d1))
                pos = Add(pos, 1)
                started = 1
            }
        }
        SetByte(st, pos, Add(48, d0))
        pos = Add(pos, 1)
        CadAppHud.pos = pos
        IfCondition GreaterThan(CadAppHud.pos, 370) ThenBlock: { CadAppHud.pos = 370 }
        ReturnValue(CadAppHud.pos)
    }
}

// HUD channel for presenter (upper-right). Kernel owns numbers.
// st/pos live on CadAppHud — GetPid/ToolName/Append clobber locals.
Function.CA_WriteHud {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppHud.st, 0) ThenBlock: { CadAppHud.st = Allocate(384) }
        IfCondition EqualTo(CadAppHud.st, 0) ThenBlock: {
            ReturnValue(-1)
        }
        CadAppHud.pos = 0
        CA_HudStr("mode=")
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: { CA_HudStr("sketch") }
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: { CA_HudStr("3d") }
        CA_HudStr(" tool=")
        CadAppHud.tn = CAD_UI.ToolName(CadApp.tool)
        CA_HudStr(CadAppHud.tn)
        CA_HudStr(" phase=")
        st = CadAppHud.st
        pos = CadAppHud.pos
        ch = Add(48, CadApp.nclick)
        IfCondition GreaterThan(pos, 370) ThenBlock: { pos = 0 }
        SetByte(st, pos, ch)
        CadAppHud.pos = Add(pos, 1)
        CA_HudStr(" pad_H=")
        CA_HudInt(CadApp.height)
        IfCondition EqualTo(CadApp.plane_kind, 1) ThenBlock: {
            CA_HudStr("  OFF=type mm Enter")
        }
        IfCondition EqualTo(CadApp.plane_kind, 2) ThenBlock: {
            CA_HudStr("  ANG=type deg Enter")
        }
        IfCondition EqualTo(CadApp.plane_pick, 1) ThenBlock: {
            CA_HudStr("  PICK plane")
        }
        IfCondition EqualTo(CadApp.plane_pick, 2) ThenBlock: {
            CA_HudStr("  FROM face")
        }
        IfCondition EqualTo(CadApp.plane_pick, 3) ThenBlock: {
            CA_HudStr("  ORIGIN click")
        }
        IfCondition EqualTo(CadApp.plane_pick, 4) ThenBlock: {
            CA_HudStr("  3PT ")
            CA_HudInt(CadApp.pln_ptn)
            CA_HudStr("/3")
        }
        CadAppHud.sk0p = 0
        CadAppHud.plp = 0
        CadAppHud.parp = 0
        CadAppHud.faceh = CadApp.last_face
        IfCondition NotEqual(CadApp.sk0_plane, 0) ThenBlock: {
            CadAppHud.sk0p = CAD_Plane.GetPid(CadApp.sk0_plane)
        }
        IfCondition NotEqual(CadApp.plane, 0) ThenBlock: {
            CadAppHud.plp = CAD_Plane.GetPid(CadApp.plane)
            par = CAD_Plane.GetParent(CadApp.plane)
            IfCondition NotEqual(par, 0) ThenBlock: {
                CadAppHud.parp = CAD_Plane.GetPid(par)
            }
            IfCondition EqualTo(CAD_Plane.GetMode(CadApp.plane), 3) ThenBlock: {
                CadAppHud.faceh = CAD_Plane.GetFaceHandle(CadApp.plane)
            }
        }
        // raw B-Rep handles are 64-bit ptrs — do not print as decimal
        IfCondition GreaterThan(CadAppHud.faceh, 999999) ThenBlock: { CadAppHud.faceh = 1 }
        CA_HudStr(" sk=")
        CA_HudInt(CadApp.sk_i)
        CA_HudStr(" sk0=")
        CA_HudInt(CadAppHud.sk0p)
        CA_HudStr(" pl=")
        CA_HudInt(CadAppHud.plp)
        CA_HudStr(" par=")
        CA_HudInt(CadAppHud.parp)
        CA_HudStr(" face=")
        CA_HudInt(CadAppHud.faceh)
        CA_HudStr(" n=")
        CA_HudInt(CadApp.plane_n)
        CA_HudStr(" X=")
        CA_HudInt(CadApp.hover_u)
        CA_HudStr(" Y=")
        CA_HudInt(CadApp.hover_v)
        CA_HudStr(" polyN=")
        CA_HudInt(CadApp.poly_n)
        CA_HudStr(" side=")
        CA_HudInt(CadApp.poly_side)
        CA_HudStr(" pmode=")
        CA_HudInt(CadApp.poly_mode)
        CA_HudStr(" refs=")
        CA_HudInt(CadApp.n_face_ref)
        CA_HudStr(" grid=")
        CA_HudInt(CadApp.show_grid)
        CA_HudStr(" dirty=")
        CA_HudInt(CadApp.dirty)
        SetByte(CadAppHud.st, CadAppHud.pos, 10)
        CadAppHud.pos = Add(CadAppHud.pos, 1)
        SetByte(CadAppHud.st, CadAppHud.pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/hud.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, CadAppHud.st, CadAppHud.pos)
            SystemCall(3, fd, 0, 0)
        }
        CA_WriteDimHud()
        ReturnValue(0)
    }
}

// Overlay prompt for the host type-in box. Kernel owns fields / brackets.
// Empty file = HUD closed. Host only paints this string + typed digits.
Function.CA_WriteDimHud {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppIpc.dhud, 0) ThenBlock: { CadAppIpc.dhud = Allocate(256) }
        IfCondition EqualTo(CadAppIpc.dhud, 0) ThenBlock: { ReturnValue(-1) }
        CadAppIpc.camp = CadAppHud.st
        CadAppHud.st = CadAppIpc.dhud
        CadAppHud.pos = 0
        IfCondition EqualTo(CadApp.hud_kind, 0) ThenBlock: {
            SetByte(CadAppHud.st, 0, 0)
            CadAppHud.pos = 0
        }
        IfCondition EqualTo(CadApp.hud_kind, 1) ThenBlock: {
            CA_HudStr("POLY ")
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("[N=") }
            IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("N=") }
            CA_HudInt(CadApp.poly_n)
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("] ") }
            IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr(" ") }
            IfCondition EqualTo(CadApp.poly_mode, 0) ThenBlock: {
                IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("[L=") }
                IfCondition NotEqual(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("L=") }
                IfCondition GreaterThan(CadApp.poly_side, 0) ThenBlock: { CA_HudInt(CadApp.poly_side) }
                IfCondition LessEqual(CadApp.poly_side, 0) ThenBlock: { CA_HudStr("_") }
                IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("] ") }
                IfCondition NotEqual(CadApp.hud_field, 1) ThenBlock: { CA_HudStr(" ") }
                IfCondition EqualTo(CadApp.hud_field, 2) ThenBlock: { CA_HudStr("[D=") }
                IfCondition NotEqual(CadApp.hud_field, 2) ThenBlock: { CA_HudStr("D=") }
                IfCondition GreaterThan(CadApp.poly_diam, 0) ThenBlock: { CA_HudInt(CadApp.poly_diam) }
                IfCondition LessEqual(CadApp.poly_diam, 0) ThenBlock: { CA_HudStr("_") }
                IfCondition EqualTo(CadApp.hud_field, 2) ThenBlock: { CA_HudStr("]") }
            }
            CA_HudStr("  Tab  Enter")
        }
        IfCondition EqualTo(CadApp.hud_kind, 2) ThenBlock: {
            CA_HudStr("LINE ")
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("[L=") }
            IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("L=") }
            CA_HudInt(CadApp.live_len)
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("] ") }
            IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr(" ") }
            IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("[A=") }
            IfCondition NotEqual(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("A=") }
            CA_HudInt(CadApp.live_ang)
            IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("] deg") }
            IfCondition NotEqual(CadApp.hud_field, 1) ThenBlock: { CA_HudStr(" deg") }
            CA_HudStr("  Tab  Enter")
        }
        IfCondition EqualTo(CadApp.hud_kind, 3) ThenBlock: {
            CA_HudStr("CIRC ")
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("[R=") }
            IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("R=") }
            IfCondition GreaterThan(CadApp.circ_r, 0) ThenBlock: { CA_HudInt(CadApp.circ_r) }
            IfCondition LessEqual(CadApp.circ_r, 0) ThenBlock: { CA_HudStr("_") }
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("] ") }
            IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr(" ") }
            IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("[D=") }
            IfCondition NotEqual(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("D=") }
            IfCondition GreaterThan(CadApp.circ_d, 0) ThenBlock: { CA_HudInt(CadApp.circ_d) }
            IfCondition LessEqual(CadApp.circ_d, 0) ThenBlock: { CA_HudStr("_") }
            IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("]") }
            CA_HudStr("  Tab  Enter")
        }
        IfCondition EqualTo(CadApp.hud_kind, 4) ThenBlock: {
            CA_HudStr("RECT ")
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("[W=") }
            IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("W=") }
            IfCondition GreaterThan(CadApp.rect_w, 0) ThenBlock: { CA_HudInt(CadApp.rect_w) }
            IfCondition LessEqual(CadApp.rect_w, 0) ThenBlock: { CA_HudStr("_") }
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("] ") }
            IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr(" ") }
            IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("[H=") }
            IfCondition NotEqual(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("H=") }
            IfCondition GreaterThan(CadApp.rect_h, 0) ThenBlock: { CA_HudInt(CadApp.rect_h) }
            IfCondition LessEqual(CadApp.rect_h, 0) ThenBlock: { CA_HudStr("_") }
            IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("]") }
            CA_HudStr("  Tab  Enter")
        }
        IfCondition EqualTo(CadApp.hud_kind, 5) ThenBlock: {
            CA_HudStr("FILLET ")
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("[R=") }
            IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("R=") }
            CA_HudInt(Float_ToInt(CadApp.fillet_r))
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("]") }
            CA_HudStr("  Enter applies")
        }
        IfCondition EqualTo(CadApp.hud_kind, 7) ThenBlock: {
            CA_HudStr("EXTRUDE ")
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("[H=") }
            IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("H=") }
            CA_HudInt(CadApp.height)
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("] mm ") }
            IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr(" mm ") }
            IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("[OP=") }
            IfCondition NotEqual(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("OP=") }
            IfCondition EqualTo(CadApp.extrude_op, 0) ThenBlock: { CA_HudStr("JOIN") }
            IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: { CA_HudStr("CUT") }
            IfCondition EqualTo(CadApp.extrude_op, 2) ThenBlock: { CA_HudStr("NEW") }
            IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("]") }
            CA_HudStr("  Tab  Enter")
        }
        IfCondition EqualTo(CadApp.hud_kind, 8) ThenBlock: {
            CA_HudStr("REV ")
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("[A=") }
            IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("A=") }
            CA_HudInt(CadApp.rev_deg)
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("] deg") }
            IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr(" deg") }
            CA_HudStr("  Enter applies")
        }
        IfCondition EqualTo(CadApp.hud_kind, 9) ThenBlock: {
            CA_HudStr("CHAMFER ")
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("[D=") }
            IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("D=") }
            CA_HudInt(CadApp.chamfer_d)
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("] mm") }
            IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr(" mm") }
            CA_HudStr("  Enter applies")
        }
        IfCondition EqualTo(CadApp.hud_kind, 10) ThenBlock: {
            CA_HudStr("FILLET ")
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("[R=") }
            IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("R=") }
            CA_HudInt(Float_ToInt(CadApp.fillet_r))
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("] mm") }
            IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr(" mm") }
            CA_HudStr("  Enter applies")
        }
        IfCondition EqualTo(CadApp.hud_kind, 6) ThenBlock: {
            ct = CadApp.cstr_type
            abs = 0
            IfCondition EqualTo(ct, 1) ThenBlock: { abs = 1 }
            IfCondition EqualTo(ct, 2) ThenBlock: { abs = 1 }
            IfCondition EqualTo(ct, 3) ThenBlock: { abs = 1 }
            IfCondition EqualTo(ct, 6) ThenBlock: { abs = 1 }
            IfCondition EqualTo(ct, 7) ThenBlock: { abs = 1 }
            IfCondition EqualTo(ct, 8) ThenBlock: { abs = 1 }
            IfCondition EqualTo(ct, 11) ThenBlock: { abs = 1 }
            IfCondition EqualTo(ct, 20) ThenBlock: { abs = 1 }
            IfCondition EqualTo(abs, 1) ThenBlock: { CA_HudStr("ABS ") }
            IfCondition EqualTo(abs, 0) ThenBlock: { CA_HudStr("REL ") }
            IfCondition EqualTo(ct, 20) ThenBlock: {
                IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("[U=") }
                IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("U=") }
                CA_HudInt(CadApp.cstr_u)
                IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CA_HudStr("] ") }
                IfCondition NotEqual(CadApp.hud_field, 0) ThenBlock: { CA_HudStr(" ") }
                IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("[V=") }
                IfCondition NotEqual(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("V=") }
                CA_HudInt(CadApp.cstr_v)
                IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: { CA_HudStr("]") }
                CA_HudStr("  origin  Enter")
            }
            IfCondition EqualTo(ct, 2) ThenBlock: {
                IfCondition EqualTo(CadApp.cstr_ready, 1) ThenBlock: {
                    CA_HudStr("FixX [X=")
                    CA_HudInt(CadApp.cstr_val)
                    CA_HudStr("]")
                }
                IfCondition EqualTo(CadApp.cstr_ready, 0) ThenBlock: { CA_HudStr("FixX  click a point") }
            }
            IfCondition EqualTo(ct, 3) ThenBlock: {
                IfCondition EqualTo(CadApp.cstr_ready, 1) ThenBlock: {
                    CA_HudStr("FixY [Y=")
                    CA_HudInt(CadApp.cstr_val)
                    CA_HudStr("]")
                }
                IfCondition EqualTo(CadApp.cstr_ready, 0) ThenBlock: { CA_HudStr("FixY  click a point") }
            }
            IfCondition EqualTo(ct, 6) ThenBlock: {
                IfCondition EqualTo(CadApp.cstr_ready, 1) ThenBlock: {
                    CA_HudStr("DistO [L=")
                    CA_HudInt(CadApp.cstr_val)
                    CA_HudStr("]")
                }
                IfCondition EqualTo(CadApp.cstr_ready, 0) ThenBlock: { CA_HudStr("DistO  click a point") }
            }
            IfCondition EqualTo(ct, 11) ThenBlock: {
                IfCondition EqualTo(CadApp.cstr_ready, 1) ThenBlock: {
                    CA_HudStr("Rad [R=")
                    CA_HudInt(CadApp.cstr_val)
                    CA_HudStr("]")
                }
                IfCondition EqualTo(CadApp.cstr_ready, 0) ThenBlock: { CA_HudStr("Rad  click a circle") }
            }
            IfCondition EqualTo(ct, 15) ThenBlock: {
                IfCondition EqualTo(CadApp.cstr_ready, 1) ThenBlock: {
                    CA_HudStr("Dist [L=")
                    CA_HudInt(CadApp.cstr_val)
                    CA_HudStr("]")
                }
                IfCondition EqualTo(CadApp.cstr_ready, 0) ThenBlock: { CA_HudStr("Dist  click 2 points") }
            }
            IfCondition EqualTo(ct, 1) ThenBlock: { CA_HudStr("FixO  click a point") }
            IfCondition EqualTo(ct, 7) ThenBlock: { CA_HudStr("Horiz  click a line") }
            IfCondition EqualTo(ct, 8) ThenBlock: { CA_HudStr("Vert  click a line") }
            IfCondition EqualTo(ct, 9) ThenBlock: { CA_HudStr("Coin  click 2 points") }
            IfCondition EqualTo(ct, 10) ThenBlock: { CA_HudStr("OnLine  point then line") }
            IfCondition EqualTo(ct, 12) ThenBlock: { CA_HudStr("EqR  click 2 circles") }
            IfCondition EqualTo(ct, 13) ThenBlock: { CA_HudStr("Tang  line+circ") }
            IfCondition EqualTo(CadApp.cstr_npick, 1) ThenBlock: { CA_HudStr("  2/2") }
            IfCondition EqualTo(CadApp.cstr_ready, 1) ThenBlock: { CA_HudStr("  Enter") }
        }
        SetByte(CadAppHud.st, CadAppHud.pos, 10)
        CadAppHud.pos = Add(CadAppHud.pos, 1)
        SetByte(CadAppHud.st, CadAppHud.pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/dimhud.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, CadAppIpc.dhud, CadAppHud.pos)
            SystemCall(3, fd, 0, 0)
        }
        CadAppHud.st = CadAppIpc.camp
        ReturnValue(0)
    }
}

// Camera pose for the host view-cube (handle only). millideg + zoom cents.
Function.CA_WriteCam {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppIpc.cam, 0) ThenBlock: { CadAppIpc.cam = Allocate(80) }
        IfCondition EqualTo(CadAppIpc.cam, 0) ThenBlock: { ReturnValue(-1) }
        CadAppIpc.camp = CadAppHud.st
        CadAppHud.st = CadAppIpc.cam
        CadAppHud.pos = 0
        k = Float_FromInt(57296)
        CA_HudInt(Float_ToInt(Float_Mul(CAD_View_State.yaw_r, k)))
        CA_HudStr(" ")
        CA_HudInt(Float_ToInt(Float_Mul(CAD_View_State.pitch_r, k)))
        CA_HudStr(" ")
        CA_HudInt(Float_ToInt(Float_Mul(CAD_View_State.zoom_r, Float_FromInt(100))))
        SetByte(CadAppHud.st, CadAppHud.pos, 10)
        CadAppHud.pos = Add(CadAppHud.pos, 1)
        SetByte(CadAppHud.st, CadAppHud.pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/cam.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, CadAppIpc.cam, CadAppHud.pos)
            SystemCall(3, fd, 0, 0)
        }
        CadAppHud.st = CadAppIpc.camp
        ReturnValue(0)
    }
}

// Command list for host pie / palette. App owns the verbs; host only draws.
Function.CA_WritePalette {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppIpc.pal, 0) ThenBlock: { CadAppIpc.pal = Allocate(1024) }
        IfCondition EqualTo(CadAppIpc.pal, 0) ThenBlock: { ReturnValue(-1) }
        pos = 0
        buf = CadAppIpc.pal
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
            pos = CAD_Repo.AppendStr(buf, pos, "cancel|Cancel\n")
            pos = CAD_Repo.AppendStr(buf, pos, "tool_line|Line\n")
            pos = CAD_Repo.AppendStr(buf, pos, "tool_circ|Circle\n")
            pos = CAD_Repo.AppendStr(buf, pos, "tool_poly6|Polygon\n")
            pos = CAD_Repo.AppendStr(buf, pos, "tool_trim|Trim\n")
            pos = CAD_Repo.AppendStr(buf, pos, "proj|Project\n")
            pos = CAD_Repo.AppendStr(buf, pos, "repad|Extrude\n")
        }
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
            pos = CAD_Repo.AppendStr(buf, pos, "cancel|Cancel\n")
            pos = CAD_Repo.AppendStr(buf, pos, "tool_pick|Pick\n")
            pos = CAD_Repo.AppendStr(buf, pos, "repad|Extrude\n")
            pos = CAD_Repo.AppendStr(buf, pos, "tool_fillet3d|Fillet\n")
            pos = CAD_Repo.AppendStr(buf, pos, "tool_chamfer|Chamfer\n")
            pos = CAD_Repo.AppendStr(buf, pos, "ontop|Sketch Face\n")
            pos = CAD_Repo.AppendStr(buf, pos, "sketch_pln|Sketch Plane\n")
            pos = CAD_Repo.AppendStr(buf, pos, "plane_pick|Pick Plane\n")
        }
        SetByte(buf, pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/cmds.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, buf, pos)
            SystemCall(3, fd, 0, 0)
        }
        ReturnValue(0)
    }
}

// Active sketch index in sk_list, or 0.
Function.CA_CurrentSkIdx {
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, CadApp.sk_n) {
            IfCondition EqualTo(ArrayGet(CadApp.sk_list, i), CadApp.sketch) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Append a timeline row. kind: 0 sketch / 1 pad / 2 revolve / 3 cut / 4 fillet / 5 chamfer
Function.CA_FeatAdd {
    Input: kind: Integer
    Input: sk_i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: {
            CadApp.feat_kind = Allocate(256)
            CadApp.feat_sk = Allocate(256)
            CadApp.feat_aux = Allocate(256)
        }
        IfCondition EqualTo(CadApp.feat_aux, 0) ThenBlock: { CadApp.feat_aux = Allocate(256) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(CadApp.feat_n, 32) ThenBlock: { ReturnValue(0) }
        ArraySet(CadApp.feat_kind, CadApp.feat_n, kind)
        ArraySet(CadApp.feat_sk, CadApp.feat_n, sk_i)
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ArraySet(CadApp.feat_aux, CadApp.feat_n, 0)
        }
        CadApp.feat_sel = CadApp.feat_n
        CadApp.feat_n = Add(CadApp.feat_n, 1)
        CA_HistPush(kind)
        ReturnValue(1)
    }
}

// Document navigator — history order, indented:
//   Sketch_N            (left)
//     Pad / Revolve     (tab)
//       Fillet / Chamfer
//   Model               (last row = full 3D)
// kind id mark label    mark=* current
Function.CA_WriteTree {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppIpc.tree, 0) ThenBlock: { CadAppIpc.tree = Allocate(4096) }
        IfCondition EqualTo(CadAppIpc.tree, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sk_n, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                CA_SketchRegister(CadApp.sketch)
            }
        }
        buf = CadAppIpc.tree
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(-1) }
        pos = 0
        cur_sk = CA_CurrentSkIdx()
        buf = CadAppIpc.tree
        // P line — part name for the HISTORY header (not a row)
        pos = CAD_Repo.AppendStr(buf, pos, "0 P 0 . ")
        IfCondition EqualTo(CadApp.part_name, 0) ThenBlock: {
            pos = CAD_Repo.AppendStr(buf, pos, "untitled")
        }
        IfCondition NotEqual(CadApp.part_name, 0) ThenBlock: {
            pi = 0
            WhileLoop LessThan(pi, 48) {
                pc = GetByte(CadApp.part_name, pi)
                IfCondition EqualTo(pc, 0) ThenBlock: { pi = 48 }
                IfCondition NotEqual(pc, 0) ThenBlock: {
                    SetByte(buf, pos, pc)
                    pos = Add(pos, 1)
                    pi = Add(pi, 1)
                }
            }
        }
        pos = CAD_Repo.AppendStr(buf, pos, "\n")
        CadAppHud.pos = pos
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, CadApp.sk_n) {
        CadApp.pick_n = 0
        WhileLoop LessThan(CadApp.pick_n, 4) {
        i = 0
        WhileLoop LessThan(i, CadApp.feat_n) {
            buf = CadAppIpc.tree
            fk = ArrayGet(CadApp.feat_kind, i)
            fs = ArrayGet(CadApp.feat_sk, i)
            want = 0
            IfCondition EqualTo(fs, CadAppPick.pi) ThenBlock: {
                IfCondition EqualTo(CadApp.pick_n, 0) ThenBlock: {
                    IfCondition EqualTo(fk, 0) ThenBlock: { want = 1 }
                }
                IfCondition EqualTo(CadApp.pick_n, 1) ThenBlock: {
                    IfCondition GreaterEqual(fk, 8) ThenBlock: { want = 1 }
                }
                IfCondition EqualTo(CadApp.pick_n, 2) ThenBlock: {
                    IfCondition GreaterEqual(fk, 1) ThenBlock: {
                        IfCondition LessEqual(fk, 3) ThenBlock: { want = 1 }
                    }
                }
                IfCondition EqualTo(CadApp.pick_n, 3) ThenBlock: {
                    IfCondition EqualTo(fk, 4) ThenBlock: { want = 1 }
                    IfCondition EqualTo(fk, 5) ThenBlock: { want = 1 }
                }
            }
            IfCondition EqualTo(want, 1) ThenBlock: {
            depth = 0
            letter = 83
            IfCondition EqualTo(fk, 1) ThenBlock: {
                depth = 1
                letter = 66
            }
            IfCondition EqualTo(fk, 2) ThenBlock: {
                depth = 1
                letter = 82
            }
            IfCondition EqualTo(fk, 3) ThenBlock: {
                depth = 1
                letter = 85
            }
            IfCondition EqualTo(fk, 4) ThenBlock: {
                depth = 2
                letter = 70
            }
            IfCondition EqualTo(fk, 5) ThenBlock: {
                depth = 2
                letter = 67
            }
            IfCondition EqualTo(fk, 8) ThenBlock: {
                depth = 1
                letter = 71
            }
            IfCondition EqualTo(fk, 9) ThenBlock: {
                depth = 1
                letter = 76
            }
            IfCondition EqualTo(fk, 10) ThenBlock: {
                depth = 1
                letter = 79
            }
            IfCondition EqualTo(fk, 11) ThenBlock: {
                depth = 1
                letter = 69
            }
            IfCondition EqualTo(fk, 12) ThenBlock: {
                depth = 1
                letter = 74
            }
            IfCondition EqualTo(fk, 13) ThenBlock: {
                depth = 1
                letter = 88
            }
            IfCondition EqualTo(fk, 14) ThenBlock: {
                depth = 1
                letter = 84
            }
            pos = CAD_Repo.AppendInt(buf, pos, depth)
            pos = CAD_Repo.AppendStr(buf, pos, " ")
            SetByte(buf, pos, letter)
            pos = Add(pos, 1)
            pos = CAD_Repo.AppendStr(buf, pos, " ")
            IfCondition EqualTo(fk, 0) ThenBlock: {
                pos = CAD_Repo.AppendInt(buf, pos, fs)
            }
            IfCondition NotEqual(fk, 0) ThenBlock: {
                pos = CAD_Repo.AppendInt(buf, pos, i)
            }
            pos = CAD_Repo.AppendStr(buf, pos, " ")
            star = 0
            IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
                IfCondition EqualTo(fk, 0) ThenBlock: {
                    IfCondition EqualTo(fs, cur_sk) ThenBlock: { star = 1 }
                }
            }
            IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
                IfCondition EqualTo(i, CadApp.feat_sel) ThenBlock: {
                    IfCondition NotEqual(fk, 0) ThenBlock: { star = 1 }
                }
            }
            IfCondition EqualTo(star, 1) ThenBlock: {
                pos = CAD_Repo.AppendStr(buf, pos, "* ")
            }
            IfCondition EqualTo(star, 0) ThenBlock: {
                pos = CAD_Repo.AppendStr(buf, pos, ". ")
            }
            IfCondition EqualTo(fk, 0) ThenBlock: {
                pos = CAD_Repo.AppendStr(buf, pos, "Sketch_")
                pos = CAD_Repo.AppendInt(buf, pos, fs)
                IfCondition NotEqual(CadApp.sk_alias, 0) ThenBlock: {
                    ab = Multiply(fs, 32)
                    IfCondition NotEqual(GetByte(CadApp.sk_alias, ab), 0) ThenBlock: {
                        pos = CAD_Repo.AppendStr(buf, pos, "  ")
                        ai = 0
                        WhileLoop LessThan(ai, 31) {
                            ac = GetByte(CadApp.sk_alias, Add(ab, ai))
                            IfCondition EqualTo(ac, 0) ThenBlock: { ai = 31 }
                            IfCondition NotEqual(ac, 0) ThenBlock: {
                                SetByte(buf, pos, ac)
                                pos = Add(pos, 1)
                                ai = Add(ai, 1)
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(fk, 1) ThenBlock: {
                pos = CAD_Repo.AppendStr(buf, pos, "Extrude")
                hh = CadApp.height
                IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                    ha = ArrayGet(CadApp.feat_aux, i)
                    IfCondition GreaterThan(ha, 0) ThenBlock: { hh = ha }
                    IfCondition LessThan(ha, 0) ThenBlock: { hh = ha }
                }
                pos = CAD_Repo.AppendStr(buf, pos, "  H=")
                pos = CAD_Repo.AppendInt(buf, pos, hh)
            }
            IfCondition EqualTo(fk, 2) ThenBlock: {
                pos = CAD_Repo.AppendStr(buf, pos, "Revolve")
                dd = CadApp.rev_deg
                IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                    da = ArrayGet(CadApp.feat_aux, i)
                    IfCondition GreaterThan(da, 0) ThenBlock: { dd = da }
                }
                pos = CAD_Repo.AppendStr(buf, pos, "  A=")
                pos = CAD_Repo.AppendInt(buf, pos, dd)
            }
            IfCondition EqualTo(fk, 3) ThenBlock: {
                pos = CAD_Repo.AppendStr(buf, pos, "Cut")
                hh = CadApp.height
                IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                    ha = ArrayGet(CadApp.feat_aux, i)
                    IfCondition GreaterThan(ha, 0) ThenBlock: { hh = ha }
                    IfCondition LessThan(ha, 0) ThenBlock: { hh = ha }
                }
                IfCondition LessThan(hh, 0) ThenBlock: { hh = Subtract(0, hh) }
                pos = CAD_Repo.AppendStr(buf, pos, "  H=")
                pos = CAD_Repo.AppendInt(buf, pos, hh)
            }
            IfCondition EqualTo(fk, 4) ThenBlock: {
                pos = CAD_Repo.AppendStr(buf, pos, "Fillet")
                IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                    CadAppHud.plp = ArrayGet(CadApp.feat_aux, i)
                    IfCondition GreaterThan(CadAppHud.plp, 0) ThenBlock: {
                        pos = CAD_Repo.AppendStr(buf, pos, "  R=")
                        pos = CAD_Repo.AppendInt(buf, pos, CadAppHud.plp)
                    }
                }
            }
            IfCondition EqualTo(fk, 5) ThenBlock: {
                pos = CAD_Repo.AppendStr(buf, pos, "Chamfer")
                IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                    CadAppHud.plp = ArrayGet(CadApp.feat_aux, i)
                    IfCondition GreaterThan(CadAppHud.plp, 0) ThenBlock: {
                        pos = CAD_Repo.AppendStr(buf, pos, "  D=")
                        pos = CAD_Repo.AppendInt(buf, pos, CadAppHud.plp)
                    }
                }
            }
            IfCondition EqualTo(fk, 9) ThenBlock: {
                pos = CAD_Repo.AppendStr(buf, pos, "Line")
            }
            IfCondition EqualTo(fk, 10) ThenBlock: {
                pos = CAD_Repo.AppendStr(buf, pos, "Circle")
            }
            IfCondition EqualTo(fk, 11) ThenBlock: {
                pos = CAD_Repo.AppendStr(buf, pos, "Rect")
                CadAppHud.plp = CadApp.rect_w
                CadAppHud.faceh = CadApp.rect_h
                IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                    IfCondition NotEqual(CadApp.rt_tab, 0) ThenBlock: {
                        CadAppHud.sk0p = ArrayGet(CadApp.feat_aux, i)
                        IfCondition GreaterEqual(CadAppHud.sk0p, 0) ThenBlock: {
                            CadAppHud.plp = ArrayGet(CadApp.rt_tab, Add(Multiply(CadAppHud.sk0p, 10), 1))
                            CadAppHud.faceh = ArrayGet(CadApp.rt_tab, Add(Multiply(CadAppHud.sk0p, 10), 2))
                        }
                    }
                }
                pos = CAD_Repo.AppendStr(buf, pos, "  ")
                pos = CAD_Repo.AppendInt(buf, pos, CadAppHud.plp)
                pos = CAD_Repo.AppendStr(buf, pos, "x")
                pos = CAD_Repo.AppendInt(buf, pos, CadAppHud.faceh)
            }
            IfCondition EqualTo(fk, 12) ThenBlock: {
                pos = CAD_Repo.AppendStr(buf, pos, "Fillet2")
            }
            IfCondition EqualTo(fk, 13) ThenBlock: {
                pos = CAD_Repo.AppendStr(buf, pos, "Constr")
            }
            IfCondition EqualTo(fk, 14) ThenBlock: {
                pos = CAD_Repo.AppendStr(buf, pos, "Point")
            }
            IfCondition EqualTo(fk, 8) ThenBlock: {
                nn = 6
                IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                    IfCondition NotEqual(CadApp.pg_tab, 0) ThenBlock: {
                        pi = ArrayGet(CadApp.feat_aux, i)
                        IfCondition GreaterEqual(pi, 0) ThenBlock: {
                            IfCondition LessThan(pi, CadApp.pg_n) ThenBlock: {
                                nn = ArrayGet(CadApp.pg_tab, Multiply(pi, 10))
                            }
                        }
                    }
                }
                IfCondition EqualTo(nn, 3) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Triangle") }
                IfCondition EqualTo(nn, 4) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Square") }
                IfCondition EqualTo(nn, 5) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Pentagon") }
                IfCondition EqualTo(nn, 6) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Hexagon") }
                IfCondition EqualTo(nn, 8) ThenBlock: { pos = CAD_Repo.AppendStr(buf, pos, "Octagon") }
                IfCondition NotEqual(nn, 3) ThenBlock: {
                    IfCondition NotEqual(nn, 4) ThenBlock: {
                        IfCondition NotEqual(nn, 5) ThenBlock: {
                            IfCondition NotEqual(nn, 6) ThenBlock: {
                                IfCondition NotEqual(nn, 8) ThenBlock: {
                                    pos = CAD_Repo.AppendInt(buf, pos, nn)
                                    pos = CAD_Repo.AppendStr(buf, pos, "-gon")
                                }
                            }
                        }
                    }
                }
            }
            IfCondition NotEqual(fk, 0) ThenBlock: {
                IfCondition NotEqual(CadApp.feat_alias, 0) ThenBlock: {
                    ab = Multiply(i, 32)
                    IfCondition NotEqual(GetByte(CadApp.feat_alias, ab), 0) ThenBlock: {
                        pos = CAD_Repo.AppendStr(buf, pos, "  ")
                        ai = 0
                        WhileLoop LessThan(ai, 31) {
                            ac = GetByte(CadApp.feat_alias, Add(ab, ai))
                            IfCondition EqualTo(ac, 0) ThenBlock: { ai = 31 }
                            IfCondition NotEqual(ac, 0) ThenBlock: {
                                SetByte(buf, pos, ac)
                                pos = Add(pos, 1)
                                ai = Add(ai, 1)
                            }
                        }
                    }
                }
            }
            pos = CAD_Repo.AppendStr(buf, pos, "\n")
            }
            i = Add(i, 1)
        }
        CadApp.pick_n = Add(CadApp.pick_n, 1)
        }
        CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, CadApp.plane_n) {
            CadApp.pick_fh = 0
            IfCondition NotEqual(CadApp.plane_list, 0) ThenBlock: {
                CadApp.pick_fh = ArrayGet(CadApp.plane_list, CadAppPick.pi)
            }
            IfCondition EqualTo(CA_PlaneIsImplicitXY(CadApp.pick_fh), 0) ThenBlock: {
                buf = CadAppIpc.tree
                pos = CAD_Repo.AppendInt(buf, pos, 0)
                pos = CAD_Repo.AppendStr(buf, pos, " N ")
                pos = CAD_Repo.AppendInt(buf, pos, CadAppPick.pi)
                pos = CAD_Repo.AppendStr(buf, pos, " ")
                IfCondition EqualTo(CadApp.pick_fh, CadApp.plane) ThenBlock: {
                    pos = CAD_Repo.AppendStr(buf, pos, "* ")
                }
                IfCondition NotEqual(CadApp.pick_fh, CadApp.plane) ThenBlock: {
                    pos = CAD_Repo.AppendStr(buf, pos, ". ")
                }
                pos = CAD_Repo.AppendStr(buf, pos, "Plane")
                CadAppPick.ins_i = pos
                CadAppPick.face = 0
                CadAppPick.col = 0
                CadAppPick.thick = 0
                IfCondition NotEqual(CadApp.pick_fh, 0) ThenBlock: {
                    CadAppPick.face = CAD_Plane.GetPid(CadApp.pick_fh)
                    CadAppPick.col = CAD_Plane.GetRecipe(CadApp.pick_fh)
                    CadAppPick.thick = CAD_Plane.GetMode(CadApp.pick_fh)
                }
                pos = CadAppPick.ins_i
                buf = CadAppIpc.tree
                pos = CAD_Repo.AppendStr(buf, pos, " ")
                pos = CAD_Repo.AppendInt(buf, pos, CadAppPick.face)
                IfCondition EqualTo(CadAppPick.thick, 3) ThenBlock: {
                    pos = CAD_Repo.AppendStr(buf, pos, "  Face")
                }
                IfCondition EqualTo(CadAppPick.col, 1) ThenBlock: {
                    pos = CAD_Repo.AppendStr(buf, pos, "  Offset")
                }
                IfCondition EqualTo(CadAppPick.col, 2) ThenBlock: {
                    pos = CAD_Repo.AppendStr(buf, pos, "  Angle")
                }
                IfCondition EqualTo(CadAppPick.col, 3) ThenBlock: {
                    pos = CAD_Repo.AppendStr(buf, pos, "  Angle")
                }
                pos = CAD_Repo.AppendStr(buf, pos, "\n")
            }
            CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        buf = CadAppIpc.tree
        pos = CAD_Repo.AppendStr(buf, pos, "0 M 0 ")
        mstar = 0
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
            IfCondition GreaterEqual(CadApp.feat_sel, CadApp.feat_n) ThenBlock: { mstar = 1 }
            IfCondition EqualTo(CadApp.feat_n, 0) ThenBlock: { mstar = 1 }
        }
        IfCondition EqualTo(mstar, 1) ThenBlock: {
            pos = CAD_Repo.AppendStr(buf, pos, "* Model")
        }
        IfCondition EqualTo(mstar, 0) ThenBlock: {
            pos = CAD_Repo.AppendStr(buf, pos, ". Model")
        }
        IfCondition NotEqual(CadApp.part_name, 0) ThenBlock: {
            IfCondition NotEqual(GetByte(CadApp.part_name, 0), 0) ThenBlock: {
                pos = CAD_Repo.AppendStr(buf, pos, "  ")
                pi = 0
                WhileLoop LessThan(pi, 48) {
                    pc = GetByte(CadApp.part_name, pi)
                    IfCondition EqualTo(pc, 0) ThenBlock: { pi = 48 }
                    IfCondition NotEqual(pc, 0) ThenBlock: {
                        SetByte(buf, pos, pc)
                        pos = Add(pos, 1)
                        pi = Add(pi, 1)
                    }
                }
            }
        }
        pos = CAD_Repo.AppendStr(buf, pos, "\n")
        SetByte(buf, pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/tree.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, buf, pos)
            SystemCall(3, fd, 0, 0)
        }
        ReturnValue(0)
    }
}

// Ensure PG connection + schema (once).


Function.CA_WriteStatus {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppIpc.stat, 0) ThenBlock: { CadAppIpc.stat = Allocate(160) }
        st = CadAppIpc.stat
        IfCondition EqualTo(st, 0) ThenBlock: { ReturnValue(-1) }
        pos = 0
        IfCondition EqualTo(CadApp.list_open, 1) ThenBlock: {
            // LIST sel/count
            msg = "LIST "
            i = 0
            WhileLoop NotEqual(GetByte(msg, i), 0) {
                SetByte(st, pos, GetByte(msg, i))
                pos = Add(pos, 1)
                i = Add(i, 1)
            }
            // sel+1
            v = Add(CadApp.list_sel, 1)
            IfCondition EqualTo(v, 0) ThenBlock: {
                SetByte(st, pos, 48)
                pos = Add(pos, 1)
            }
            IfCondition GreaterThan(v, 0) ThenBlock: {
                tmp = Allocate(16)
                n = 0
                vv = v
                WhileLoop GreaterThan(vv, 0) {
                    SetByte(tmp, n, Add(48, Modulo(vv, 10)))
                    vv = Divide(vv, 10)
                    n = Add(n, 1)
                }
                ii = Subtract(n, 1)
                WhileLoop GreaterEqual(ii, 0) {
                    SetByte(st, pos, GetByte(tmp, ii))
                    pos = Add(pos, 1)
                    ii = Subtract(ii, 1)
                }
                Deallocate(tmp, 16)
            }
            SetByte(st, pos, 47)
            pos = Add(pos, 1)
            v = CadApp.list_count
            IfCondition EqualTo(v, 0) ThenBlock: {
                SetByte(st, pos, 48)
                pos = Add(pos, 1)
            }
            IfCondition GreaterThan(v, 0) ThenBlock: {
                tmp = Allocate(16)
                n = 0
                vv = v
                WhileLoop GreaterThan(vv, 0) {
                    SetByte(tmp, n, Add(48, Modulo(vv, 10)))
                    vv = Divide(vv, 10)
                    n = Add(n, 1)
                }
                ii = Subtract(n, 1)
                WhileLoop GreaterEqual(ii, 0) {
                    SetByte(st, pos, GetByte(tmp, ii))
                    pos = Add(pos, 1)
                    ii = Subtract(ii, 1)
                }
                Deallocate(tmp, 16)
            }
            SetByte(st, pos, 32)
            pos = Add(pos, 1)
            nm = Allocate(80)
            IfCondition EqualTo(CA_ListNameAt(CadApp.list_sel, nm), 1) ThenBlock: {
                i = 0
                WhileLoop NotEqual(GetByte(nm, i), 0) {
                    IfCondition LessThan(pos, 120) ThenBlock: {
                        SetByte(st, pos, GetByte(nm, i))
                        pos = Add(pos, 1)
                    }
                    i = Add(i, 1)
                }
            }
            Deallocate(nm, 80)
            tail = "  g=open p=save"
            i = 0
            WhileLoop NotEqual(GetByte(tail, i), 0) {
                IfCondition LessThan(pos, 150) ThenBlock: {
                    SetByte(st, pos, GetByte(tail, i))
                    pos = Add(pos, 1)
                }
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(CadApp.list_open, 0) ThenBlock: {
            msg = "DOC "
            i = 0
            WhileLoop NotEqual(GetByte(msg, i), 0) {
                SetByte(st, pos, GetByte(msg, i))
                pos = Add(pos, 1)
                i = Add(i, 1)
            }
            CadAppHud.pos = pos
            CA_EnsureName()
            st = CadAppIpc.stat
            pos = CadAppHud.pos
            i = 0
            WhileLoop NotEqual(GetByte(CadApp.part_name, i), 0) {
                IfCondition LessThan(pos, 100) ThenBlock: {
                    SetByte(st, pos, GetByte(CadApp.part_name, i))
                    pos = Add(pos, 1)
                }
                i = Add(i, 1)
            }
            SetByte(st, pos, 32)
            pos = Add(pos, 1)
            SetByte(st, pos, 114)
            pos = Add(pos, 1)
            v = CadApp.part_rev
            IfCondition EqualTo(v, 0) ThenBlock: {
                SetByte(st, pos, 48)
                pos = Add(pos, 1)
            }
            IfCondition GreaterThan(v, 0) ThenBlock: {
                tmp = Allocate(16)
                n = 0
                vv = v
                WhileLoop GreaterThan(vv, 0) {
                    SetByte(tmp, n, Add(48, Modulo(vv, 10)))
                    vv = Divide(vv, 10)
                    n = Add(n, 1)
                }
                ii = Subtract(n, 1)
                WhileLoop GreaterEqual(ii, 0) {
                    SetByte(st, pos, GetByte(tmp, ii))
                    pos = Add(pos, 1)
                    ii = Subtract(ii, 1)
                }
                Deallocate(tmp, 16)
            }
            // always init tail (tool=3 ARC used to leave garbage → crash)
            tail = " "
            IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
                IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " LINE c1" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " LINE c2" }
                }
                IfCondition EqualTo(CadApp.tool, 1) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " RECT c1" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " RECT c2" }
                }
                IfCondition EqualTo(CadApp.tool, 2) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " CIRC center" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " CIRC radius" }
                }
                IfCondition EqualTo(CadApp.tool, 3) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " ARC center" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " ARC start" }
                    IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: { tail = " ARC end" }
                }
                IfCondition EqualTo(CadApp.tool, 9) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " ARC3 start" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " ARC3 through" }
                    IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: { tail = " ARC3 end" }
                }
                IfCondition EqualTo(CadApp.tool, 12) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " ARC2 P0" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " ARC2 P1" }
                }
                IfCondition EqualTo(CadApp.tool, 13) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " CIRC2 P0" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " CIRC2 P1" }
                }
                IfCondition EqualTo(CadApp.tool, 14) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " CIRC3 start" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " CIRC3 through" }
                    IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: { tail = " CIRC3 end" }
                }
                IfCondition EqualTo(CadApp.tool, 15) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " RECTC center" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " RECTC corner" }
                }
                IfCondition EqualTo(CadApp.tool, 16) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " RECT3 corner" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " RECT3 edge" }
                    IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: { tail = " RECT3 height" }
                }
                IfCondition EqualTo(CadApp.tool, 17) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " POLY center" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " POLY vertex" }
                }
                IfCondition EqualTo(CadApp.tool, 18) ThenBlock: { tail = " SPLINE CVs then done" }
                IfCondition EqualTo(CadApp.tool, 4) ThenBlock: { tail = " PICK profile" }
                IfCondition EqualTo(CadApp.tool, 5) ThenBlock: { tail = " TRIM click" }
                IfCondition EqualTo(CadApp.tool, 6) ThenBlock: { tail = " POINT click" }
                IfCondition EqualTo(CadApp.tool, 8) ThenBlock: {
                    tail = " FILLET pick line"
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " FILLET 2nd line" }
                }
                IfCondition EqualTo(CadApp.tool, 7) ThenBlock: {
                    // keep tool name visible (do not let dirty/* overwrite below)
                    tail = " CSTR?"
                    IfCondition EqualTo(CadApp.cstr_type, 9) ThenBlock: { tail = " COIN 2picks" }
                    IfCondition EqualTo(CadApp.cstr_type, 7) ThenBlock: { tail = " H line" }
                    IfCondition EqualTo(CadApp.cstr_type, 8) ThenBlock: { tail = " V line" }
                    IfCondition EqualTo(CadApp.cstr_type, 1) ThenBlock: { tail = " FixO point" }
                    IfCondition EqualTo(CadApp.cstr_type, 6) ThenBlock: { tail = " DistO point" }
                    IfCondition EqualTo(CadApp.cstr_type, 11) ThenBlock: { tail = " Rad circle" }
                    IfCondition EqualTo(CadApp.cstr_type, 13) ThenBlock: { tail = " TANG 2picks" }
                    IfCondition EqualTo(CadApp.cstr_type, 10) ThenBlock: { tail = " OnLn 2picks" }
                    IfCondition EqualTo(CadApp.cstr_type, 12) ThenBlock: { tail = " EqR 2circs" }
                    IfCondition EqualTo(CadApp.cstr_type, 15) ThenBlock: { tail = " Dist 2pts" }
                    IfCondition EqualTo(CadApp.cstr_npick, 1) ThenBlock: { tail = " need 2nd pick" }
                }
                // dirty tool tag first, then profile selection overwrites for Pick
                IfCondition EqualTo(CadApp.dirty, 1) ThenBlock: {
                    IfCondition EqualTo(CadApp.tool, 0) ThenBlock: { tail = " *LINE" }
                    IfCondition EqualTo(CadApp.tool, 1) ThenBlock: { tail = " *RECT" }
                    IfCondition EqualTo(CadApp.tool, 2) ThenBlock: { tail = " *CIRC" }
                    IfCondition EqualTo(CadApp.tool, 3) ThenBlock: { tail = " *ARC" }
                    IfCondition EqualTo(CadApp.tool, 4) ThenBlock: { tail = " *PICK" }
                    IfCondition EqualTo(CadApp.tool, 5) ThenBlock: { tail = " *TRIM" }
                    IfCondition EqualTo(CadApp.tool, 6) ThenBlock: { tail = " *POINT" }
                    // tool 7: keep COIN/H/V/... name — do not wipe with *CSTR
                }
                // profile selection state wins over *PICK when faces exist
                IfCondition EqualTo(CadApp.tool, 4) ThenBlock: {
                    IfCondition GreaterThan(CadApp.nprof, 0) ThenBlock: {
                        IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
                            tail = " lightRED click face"
                        }
                        IfCondition EqualTo(CadApp.prof_user, 1) ThenBlock: {
                            tail = " brightRED Shift+multi"
                        }
                    }
                }
            }
            IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
                IfCondition EqualTo(CadApp.face_pick, 1) ThenBlock: {
                    tail = " click FACE for sketch"
                }
                IfCondition EqualTo(CadApp.face_pick, 0) ThenBlock: {
                    IfCondition EqualTo(CadApp.dirty, 1) ThenBlock: {
                        tail = " *3D pad/save"
                    }
                    IfCondition EqualTo(CadApp.dirty, 0) ThenBlock: {
                        tail = " 3D"
                    }
                }
            }
            i = 0
            WhileLoop NotEqual(GetByte(tail, i), 0) {
                IfCondition LessThan(pos, 150) ThenBlock: {
                    SetByte(st, pos, GetByte(tail, i))
                    pos = Add(pos, 1)
                }
                i = Add(i, 1)
            }
            // cursor UV — use hover_u/v already computed on click/hover.
            // Do NOT call PixToWorld here (clobbers st/pos → crash on-face).
            IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
                IfCondition EqualTo(CadApp.hover_ok, 1) ThenBlock: {
                    IfCondition LessThan(pos, 140) ThenBlock: {
                        SetByte(st, pos, 32)
                        pos = Add(pos, 1)
                        SetByte(st, pos, 117)
                        pos = Add(pos, 1)
                        SetByte(st, pos, 61)
                        pos = Add(pos, 1)
                    }
                    CadAppIpc.camp = CadAppHud.st
                    CadAppHud.st = CadAppIpc.stat
                    CadAppHud.pos = pos
                    CA_HudInt(CadApp.hover_u)
                    st = CadAppIpc.stat
                    pos = CadAppHud.pos
                    IfCondition LessThan(pos, 145) ThenBlock: {
                        SetByte(st, pos, 32)
                        pos = Add(pos, 1)
                        SetByte(st, pos, 118)
                        pos = Add(pos, 1)
                        SetByte(st, pos, 61)
                        pos = Add(pos, 1)
                    }
                    CadAppHud.pos = pos
                    CA_HudInt(CadApp.hover_v)
                    st = CadAppIpc.stat
                    pos = CadAppHud.pos
                    CadAppHud.st = CadAppIpc.camp
                }
            }
        }
        SetByte(st, pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/status.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, st, pos)
            SystemCall(3, fd, 0, 0)
        }
        ReturnValue(0)
    }
}


// Write tool strip state for host: mode tool nclick dirty cstr_type npick
Function.CA_WriteToolFile {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppIpc.tool, 0) ThenBlock: { CadAppIpc.tool = Allocate(48) }
        sb = CadAppIpc.tool
        IfCondition EqualTo(sb, 0) ThenBlock: { ReturnValue(-1) }
        // "M T N D CT NP\n" — CT is 2-digit constraint type for panel highlight
        pos = 0
        SetByte(sb, pos, Add(48, CadApp.mode))
        pos = Add(pos, 1)
        SetByte(sb, pos, 32)
        pos = Add(pos, 1)
        tt = CadApp.tool
        IfCondition LessThan(tt, 0) ThenBlock: { tt = 0 }
        IfCondition GreaterThan(tt, 99) ThenBlock: { tt = 99 }
        SetByte(sb, pos, Add(48, Divide(tt, 10)))
        pos = Add(pos, 1)
        SetByte(sb, pos, Add(48, Modulo(tt, 10)))
        pos = Add(pos, 1)
        SetByte(sb, pos, 32)
        pos = Add(pos, 1)
        SetByte(sb, pos, Add(48, CadApp.nclick))
        pos = Add(pos, 1)
        SetByte(sb, pos, 32)
        pos = Add(pos, 1)
        SetByte(sb, pos, Add(48, CadApp.dirty))
        pos = Add(pos, 1)
        SetByte(sb, pos, 32)
        pos = Add(pos, 1)
        ct = CadApp.cstr_type
        IfCondition GreaterThan(ct, 99) ThenBlock: { ct = 99 }
        SetByte(sb, pos, Add(48, Divide(ct, 10)))
        pos = Add(pos, 1)
        SetByte(sb, pos, Add(48, Modulo(ct, 10)))
        pos = Add(pos, 1)
        SetByte(sb, pos, 32)
        pos = Add(pos, 1)
        np = CadApp.cstr_npick
        IfCondition GreaterThan(np, 9) ThenBlock: { np = 9 }
        SetByte(sb, pos, Add(48, np))
        pos = Add(pos, 1)
        SetByte(sb, pos, 10)
        pos = Add(pos, 1)
        SetByte(sb, pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/tool.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, sb, pos)
            SystemCall(3, fd, 0, 0)
        }
        ReturnValue(0)
    }
}

// Parse signed int at buf[i], write value to out_addr[0], return new index or -1

