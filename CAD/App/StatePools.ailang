Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

// mode 0=3d 1=sketch
// tool 0=line 1=rect 2=circle 3=arc(center) 4=pick 5=trim 6=point 7=cstr 8=fillet 9=arc3
// solid_ops: pad (extrude sketch), plate+hole, cut (ExtrudeCut into solid)


// mode 0=3d 1=sketch
// tool 0=line 1=rect 2=circle 3=arc(center) 4=pick 5=trim 6=point 7=cstr 8=fillet 9=arc3
// solid_ops: pad (extrude sketch), plate+hole, cut (ExtrudeCut into solid)
FixedPool.CadApp {
    "solid":     Initialize=0, CanChange=True
    "sketch":    Initialize=0, CanChange=True
    "hole_sk":   Initialize=0, CanChange=True
    "height":    Initialize=10, CanChange=True
    "width":     Initialize=800, CanChange=True
    "height_px": Initialize=600, CanChange=True
    "wire":      Initialize=0, CanChange=True
    "view":      Initialize=0, CanChange=True
    "gen":       Initialize=0, CanChange=True
    "running":   Initialize=1, CanChange=True
    "dxf_path":  Initialize=0, CanChange=True
    "hole_path": Initialize=0, CanChange=True
    "mode":      Initialize=0, CanChange=True
    "tool":      Initialize=0, CanChange=True
    "nclick":    Initialize=0, CanChange=True
    "cx0":       Initialize=0, CanChange=True
    "cy0":       Initialize=0, CanChange=True
    "scale":     Initialize=0, CanChange=True
    "extent":    Initialize=0, CanChange=True
    "nprof":     Initialize=0, CanChange=True
    "dirty":     Initialize=0, CanChange=True
    "part_name": Initialize=0, CanChange=True
    "repo_ok":   Initialize=0, CanChange=True
    "part_rev":  Initialize=0, CanChange=True
    // 0 part  1 assembly  2 group  3 machine
    "doc_kind":  Initialize=0, CanChange=True
    // 1 = rebuild existing pad (HUD / tree Edit) — do not FeatAdd again
    "pad_edit":  Initialize=0, CanChange=True
    // Extrude boolean: 0=join  1=cut  2=new body
    "extrude_op": Initialize=0, CanChange=True
    "last_pad":  Initialize=-1, CanChange=True
    "rev_deg":   Initialize=360, CanChange=True
    "rev_edit":  Initialize=0, CanChange=True
    "last_revf": Initialize=-1, CanChange=True
    "list_buf":  Initialize=0, CanChange=True
    "list_count":Initialize=0, CanChange=True
    "list_sel":  Initialize=0, CanChange=True
    "list_open": Initialize=0, CanChange=True
    "name_buf":  Initialize=0, CanChange=True
    "hover_px":  Initialize=0, CanChange=True
    "hover_py":  Initialize=0, CanChange=True
    "hover_ok":  Initialize=0, CanChange=True
    "prof_sel":  Initialize=0, CanChange=True
    "prof_user": Initialize=0, CanChange=True
    // bit mask of selected profiles (bit i = profile i); multi Pad via CompoundAdd
    "prof_mask": Initialize=0, CanChange=True
    "click_shift": Initialize=0, CanChange=True
    // PlaneFeature handle for active sketch (0 = world Sketch_0 / XY)
    "plane":     Initialize=0, CanChange=True
    // Immutable part root plane (Sketch_0). Children inherit from this.
    "sk0_plane": Initialize=0, CanChange=True
    // construction plane list: plane_list addr of 16 handles, plane_n count
    "plane_n":   Initialize=0, CanChange=True
    "plane_list":Initialize=0, CanChange=True
    // sketches in document order (max 16). Not FreeCAD dump, not Fusion timeline.
    "sk_n":      Initialize=0, CanChange=True
    "sk_list":   Initialize=0, CanChange=True
    // 1 = OnTop face-pick mode: next 3D click selects planar face → new sketch
    "face_pick": Initialize=0, CanChange=True
    // construction-plane gesture: 0 idle  1 pick plane  2 from face
    // 3 set origin  4 through 3 points
    "plane_pick": Initialize=0, CanChange=True
    // hovered construction-plane handle (plane_pick=1)
    "hover_plane": Initialize=0, CanChange=True
    // through-3pt world points (9 floats) + how many clicked
    "pln_xyz": Initialize=0, CanChange=True
    "pln_ptn": Initialize=0, CanChange=True
    // last picked / bound B-Rep face handle (0 = none). Identity is plane pid.
    "last_face": Initialize=0, CanChange=True
    // show construction planes in 3D (default on)
    "show_planes": Initialize=1, CanChange=True
    // UV grid on construction planes (axes/border stay when grid off)
    "show_grid": Initialize=1, CanChange=True
    // 20..100 solid fill (View slider). 100 = opaque.
    "opac":      Initialize=100, CanChange=True
    // 1 = replaying saved feats (no HUD, no extra FeatAdd, no mid-load blit)
    "replay":    Initialize=0, CanChange=True
    // pinned Address scratch (ExportSketch / ImportFile clobber locals)
    "tmp_a":     Initialize=0, CanChange=True
    "tmp_b":     Initialize=0, CanChange=True
    // 1 = draw host-face edges in the active sketch (Fusion-style projections)
    "show_proj": Initialize=1, CanChange=True
    "proj_n":    Initialize=0, CanChange=True
    "proj_xy":   Initialize=0, CanChange=True
    // owned buffer for DXF import path (file dialog / IPC path.txt)
    "path_buf":  Initialize=0, CanChange=True
    // sketch view zoom factor (float bits, 1.0 default)
    "sk_zoom":   Initialize=0, CanChange=True
    "sk_pan_x":  Initialize=0, CanChange=True
    "sk_pan_y":  Initialize=0, CanChange=True
    "auto_pad":  Initialize=0, CanChange=True
    "arc_a0":    Initialize=0, CanChange=True
    "arc_rad":   Initialize=0, CanChange=True
    // last user Point index placed (for DistToOrigin / HUD later)
    "last_upt":  Initialize=-1, CanChange=True
    // constraint pick: tool=7, cstr_type = constraint code (see CAD_Sketch)
    "cstr_type": Initialize=0, CanChange=True
    "cstr_npick":Initialize=0, CanChange=True
    "cstr_ka":   Initialize=0, CanChange=True
    "cstr_ia":   Initialize=0, CanChange=True
    "cstr_kb":   Initialize=0, CanChange=True
    "cstr_ib":   Initialize=0, CanChange=True
    // sketch fillet: default R mm, first line index when pick 1/2
    "fillet_r":  Initialize=0, CanChange=True
    "fillet_li": Initialize=-1, CanChange=True
    "fillet_lj": Initialize=-1, CanChange=True
    // 3D chamfer: D = host setback mm, A = angle from host (deg). 45 = equal.
    "chamfer_d": Initialize=2, CanChange=True
    "chamfer_a": Initialize=45, CanChange=True
    // 1 = tree Edit of existing chamfer/fillet — replay, do not FeatAdd
    "chamfer_edit": Initialize=0, CanChange=True
    "fillet_edit": Initialize=0, CanChange=True
    // parent solid + edges for last 3D blend (edit replay)
    "bl_parent": Initialize=0, CanChange=True
    "last_bl_n": Initialize=0, CanChange=True
    "last_bl_parent": Initialize=0, CanChange=True
    "last_bl_feat": Initialize=-1, CanChange=True
    "last_bl_kind": Initialize=0, CanChange=True
    "last_bl_buf": Initialize=0, CanChange=True
    // per-feature blend recipe: n / parent solid / hist slot / 12 edges
    "feat_en": Initialize=0, CanChange=True
    "feat_ps": Initialize=0, CanChange=True
    "feat_hi": Initialize=0, CanChange=True
    "feat_eb": Initialize=0, CanChange=True
    // 3D solid edge selection (B-Rep edge handle; 0 = none)
    "sel_edge_id": Initialize=0, CanChange=True
    // multi-edge fillet set (addr of handles + count). Apply ONCE via FilletEdges.
    "sel_edge_buf": Initialize=0, CanChange=True
    "sel_nedges": Initialize=0, CanChange=True
    // sketch index of the body whose edge was last picked (chamfer/fillet parent)
    "edge_sk": Initialize=0, CanChange=True
    // live line angle (degrees, -1 = none) + length mm for HUD/viewport
    "live_ang":  Initialize=-1, CanChange=True
    "live_len":  Initialize=0, CanChange=True
    // 0=abs from +X, 1=relative to shared line, 2=from origin axes
    "live_aref": Initialize=0, CanChange=True
    "log_fd":    Initialize=0, CanChange=True
    // sketch construction extras (pools are large — keep gesture state here)
    "poly_n":    Initialize=6, CanChange=True
    // 0=center+vertex  1=2-pt edge  2=center+2 verts
    "poly_mode": Initialize=0, CanChange=True
    // 0 = size from click; else side length mm
    "poly_side": Initialize=0, CanChange=True
    "spl_n":     Initialize=0, CanChange=True
    "spl_xy":    Initialize=0, CanChange=True
    // last-action undo (sketch / plane / solid / mode)
    "undo_ok":    Initialize=0, CanChange=True
    "undo_sk":    Initialize=0, CanChange=True
    "undo_pl":    Initialize=0, CanChange=True
    "undo_solid": Initialize=0, CanChange=True
    "undo_mode":  Initialize=0, CanChange=True
    // pinned body across ExtrudeOnPlane (locals clobber) + Pick
    "keep_solid": Initialize=0, CanChange=True
    // sketch-on-face pick walk (FaceCentroid / World3ToPix clobber locals)
    "pick_best_f": Initialize=0, CanChange=True
    "pick_best_d": Initialize=0, CanChange=True
    "pick_shell":  Initialize=0, CanChange=True
    "pick_fh":     Initialize=0, CanChange=True
    "pick_n":      Initialize=0, CanChange=True
    // how many sketches created this part (HUD sk=)
    "sk_i":        Initialize=0, CanChange=True
    // Sketch-on-Face hover highlight (planar face under cursor)
    "hover_face":  Initialize=0, CanChange=True
    // last hover UV (integer mm) for HUD / type-in
    "hover_u":     Initialize=0, CanChange=True
    "hover_v":     Initialize=0, CanChange=True
    // frozen face-vertex user points on the active on-face sketch
    "n_face_ref":  Initialize=0, CanChange=True
    // feature timeline: kind 0=sketch 1=pad 2=revolve 3=cut 4=fillet 5=chamfer
    "feat_n":      Initialize=0, CanChange=True
    "feat_kind":   Initialize=0, CanChange=True
    "feat_sk":     Initialize=0, CanChange=True
    "feat_sel":    Initialize=0, CanChange=True
    // 16 sketch aliases × 32 bytes (Sketch_N id stays; this is the user name)
    "sk_alias":    Initialize=0, CanChange=True
    // 32 feature aliases × 32 bytes (Pad / Fillet / … user names)
    "feat_alias":  Initialize=0, CanChange=True
    // 0=none 1=offset mm 2=angle deg — HUD type-in then Enter
    "plane_kind":  Initialize=0, CanChange=True
    // last committed line index for HUD L/A edit (-1 none)
    "last_line":   Initialize=-1, CanChange=True
    // 0=none 1=poly 2=line 3=circ 4=rect 5=fillet2d 6=cstr 7=pad 8=rev 9=chamfer 10=fillet3d
    "hud_kind":    Initialize=0, CanChange=True
    // poly: 0=N 1=L 2=D   line: 0=L 1=A
    "hud_field":   Initialize=0, CanChange=True
    // circumdiameter mm (0 = unset). Coupled to poly_side via sin(π/N).
    "poly_diam":   Initialize=0, CanChange=True
    // polygon features (16 × 10 ints). last_poly = record being edited (-1 none).
    "pg_n":        Initialize=0, CanChange=True
    "pg_tab":      Initialize=0, CanChange=True
    "last_poly":   Initialize=-1, CanChange=True
    "last_circ":   Initialize=-1, CanChange=True
    "circ_r":      Initialize=0, CanChange=True
    "circ_d":      Initialize=0, CanChange=True
    "last_rect":   Initialize=-1, CanChange=True
    "rect_w":      Initialize=0, CanChange=True
    "rect_h":      Initialize=0, CanChange=True
    "rt_n":        Initialize=0, CanChange=True
    "rt_tab":      Initialize=0, CanChange=True
    "last_fillet": Initialize=-1, CanChange=True
    "fl_n":        Initialize=0, CanChange=True
    "fl_tab":      Initialize=0, CanChange=True
    "last_cstr":   Initialize=-1, CanChange=True
    "cstr_val":    Initialize=0, CanChange=True
    "cstr_rval":   Initialize=0, CanChange=True
    "cstr_ready":  Initialize=0, CanChange=True
    "cstr_u":      Initialize=0, CanChange=True
    "cstr_v":      Initialize=0, CanChange=True
    // per-feature extra (kind 8 poly / 9 line / 10 circ / 11 rect)
    "feat_aux":    Initialize=0, CanChange=True
    // document command log (32 steps). Cloned sketches + solid handles.
    "hist_n":      Initialize=0, CanChange=True
    "hist_cur":    Initialize=0, CanChange=True
    "hist_sk":     Initialize=0, CanChange=True
    "hist_solid":  Initialize=0, CanChange=True
    "hist_kind":   Initialize=0, CanChange=True
    "hist_mode":   Initialize=0, CanChange=True
    // 3D fillet step 2: faces to blend (after edges). Append-only.
    "sel_face_buf": Initialize=0, CanChange=True
    "sel_nfaces":   Initialize=0, CanChange=True
    // 0=EDGE 1=FACE — 3D fillet/chamfer pick. Left/Right toggle when SEL is active.
    "fillet_pick":  Initialize=0, CanChange=True
    // 1 = draw sketch curves in 3D overlay (View tab Sketch)
    "show_sketch": Initialize=1, CanChange=True
}

// Save/load/replay walks. Own pool — NEVER insert into CadApp (shifts hover_face / pick_*).
