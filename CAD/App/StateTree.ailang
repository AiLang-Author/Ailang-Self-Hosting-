Function.CA_CurrentSkIdx {
    Output: Integer
    Body: {
        CadAppRepo.i = 0
        WhileLoop LessThan(CadAppRepo.i, CadApp.sk_n) {
            IfCondition EqualTo(ArrayGet(CadApp.sk_list, CadAppRepo.i), CadApp.sketch) ThenBlock: {
                ReturnValue(CadAppRepo.i)
            }
            CadAppRepo.i = Add(CadAppRepo.i, 1)
        }
        ReturnValue(0)
    }
}

// Append a timeline row. kind: 0 sketch / 1 pad / 2 revolve / 3 cut / 4 fillet / 5 chamfer
Function.CA_FeatAdd {
    Input: kind: Integer
    Input: sk_i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: {
            CadApp.feat_kind = Allocate(1024)
            CadApp.feat_sk = Allocate(1024)
            CadApp.feat_aux = Allocate(1024)
        }
        IfCondition EqualTo(CadApp.feat_aux, 0) ThenBlock: { CadApp.feat_aux = Allocate(1024) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(CadApp.feat_n, 128) ThenBlock: { ReturnValue(0) }
        ArraySet(CadApp.feat_kind, CadApp.feat_n, kind)
        ArraySet(CadApp.feat_sk, CadApp.feat_n, sk_i)
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ArraySet(CadApp.feat_aux, CadApp.feat_n, 0)
        }
        IfCondition EqualTo(CadApp.feat_ord, 0) ThenBlock: {
            CadApp.feat_ord = Allocate(1024)
            IfCondition NotEqual(CadApp.feat_ord, 0) ThenBlock: {
                CA_ZeroSpan(CadApp.feat_ord, 0, 128)
            }
        }
        IfCondition NotEqual(CadApp.feat_ord, 0) ThenBlock: {
            ArraySet(CadApp.feat_ord, CadApp.feat_n, 0)
        }
        CadAppPick.found_n = 0
        IfCondition EqualTo(kind, 1) ThenBlock: { CadAppPick.found_n = CadApp.prof_mask }
        IfCondition EqualTo(kind, 3) ThenBlock: { CadAppPick.found_n = CadApp.prof_mask }
        IfCondition EqualTo(CadAppPad.ois, 0) ThenBlock: {
            CadAppPad.ois = Allocate(1024)
        }
        IfCondition NotEqual(CadAppPad.ois, 0) ThenBlock: {
            ArraySet(CadAppPad.ois, CadApp.feat_n, CadAppPick.found_n)
        }
        CadApp.feat_sel = CadApp.feat_n
        CadApp.feat_n = Add(CadApp.feat_n, 1)
        CA_HistPush(kind)
        ReturnValue(1)
    }
}

// Drop one feature. Fillet/chamfer roll the body to the parent solid.
Function.CA_FeatDelete {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(-1) }
        fk = ArrayGet(CadApp.feat_kind, feat_i)
        CadApp.last_bl_kind = fk
        i = feat_i
        WhileLoop LessThan(i, Subtract(CadApp.feat_n, 1)) {
            ArraySet(CadApp.feat_kind, i, ArrayGet(CadApp.feat_kind, Add(i, 1)))
            ArraySet(CadApp.feat_sk, i, ArrayGet(CadApp.feat_sk, Add(i, 1)))
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                ArraySet(CadApp.feat_aux, i, ArrayGet(CadApp.feat_aux, Add(i, 1)))
            }
            IfCondition NotEqual(CadApp.feat_en, 0) ThenBlock: {
                ArraySet(CadApp.feat_en, i, ArrayGet(CadApp.feat_en, Add(i, 1)))
            }
            IfCondition NotEqual(CadApp.feat_ps, 0) ThenBlock: {
                ArraySet(CadApp.feat_ps, i, ArrayGet(CadApp.feat_ps, Add(i, 1)))
            }
            IfCondition NotEqual(CadApp.feat_hi, 0) ThenBlock: {
                ArraySet(CadApp.feat_hi, i, ArrayGet(CadApp.feat_hi, Add(i, 1)))
            }
            IfCondition NotEqual(CadApp.feat_ord, 0) ThenBlock: {
                ArraySet(CadApp.feat_ord, i, ArrayGet(CadApp.feat_ord, Add(i, 1)))
            }
            IfCondition NotEqual(CadAppPad.ois, 0) ThenBlock: {
                ArraySet(CadAppPad.ois, i, ArrayGet(CadAppPad.ois, Add(i, 1)))
            }
            IfCondition NotEqual(CadApp.feat_eb, 0) ThenBlock: {
                k = 0
                WhileLoop LessThan(k, 64) {
                    ArraySet(CadApp.feat_eb, Add(Multiply(i, 64), k), ArrayGet(CadApp.feat_eb, Add(Multiply(Add(i, 1), 64), k)))
                    IfCondition NotEqual(CadApp.feat_ex, 0) ThenBlock: {
                        ArraySet(CadApp.feat_ex, Add(Multiply(i, 64), k), ArrayGet(CadApp.feat_ex, Add(Multiply(Add(i, 1), 64), k)))
                        ArraySet(CadApp.feat_ey, Add(Multiply(i, 64), k), ArrayGet(CadApp.feat_ey, Add(Multiply(Add(i, 1), 64), k)))
                        ArraySet(CadApp.feat_ez, Add(Multiply(i, 64), k), ArrayGet(CadApp.feat_ez, Add(Multiply(Add(i, 1), 64), k)))
                    }
                    k = Add(k, 1)
                }
            }
            i = Add(i, 1)
        }
        CadApp.feat_n = Subtract(CadApp.feat_n, 1)
        IfCondition GreaterEqual(CadApp.feat_sel, CadApp.feat_n) ThenBlock: {
            CadApp.feat_sel = Subtract(CadApp.feat_n, 1)
        }
        CadApp.fillet_edit = 0
        CadApp.chamfer_edit = 0
        CadApp.dirty = 1
        CA_LogInt("cad_app: feat delete kind=", 26, CadApp.last_bl_kind)
        // Fillet mutates the B-Rep in place — parent handle is the wreck.
        // Rebuild the remaining pads from the sketch.
        regen = 0
        IfCondition EqualTo(CadApp.last_bl_kind, 4) ThenBlock: { regen = 1 }
        IfCondition EqualTo(CadApp.last_bl_kind, 5) ThenBlock: { regen = 1 }
        IfCondition EqualTo(regen, 1) ThenBlock: {
            nr = CA_RepoReplayFeats()
            CA_LogInt("cad_app: feat delete regen pads=", 29, nr)
            CAD_View.InvalidateMesh()
        }
        CA_WriteTree()
        ReturnValue(0)
    }
}

// Timeline Prune. Drop history after the marker. Do not delete the selected feature.
Function.CA_FeatPruneCurrent {
    Output: Integer
    Body: {
        ReturnValue(CA_HistPrune())
    }
}

// 1 = HUD confirm should rebuild the selected Extrude/Cut on THIS sketch.
// 0 = new pad (Extrude button on another sketch must FeatAdd).
Function.CA_PadShouldEdit {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.feat_sel, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(CadApp.feat_sel, CadApp.feat_n) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(0) }
        fk = ArrayGet(CadApp.feat_kind, CadApp.feat_sel)
        IfCondition EqualTo(fk, 1) ThenBlock: { fk = 1 }
        IfCondition NotEqual(fk, 1) ThenBlock: {
            IfCondition NotEqual(fk, 3) ThenBlock: { ReturnValue(0) }
        }
        si = CA_CurrentSkIdx()
        IfCondition NotEqual(ArrayGet(CadApp.feat_sk, CadApp.feat_sel), si) ThenBlock: {
            ReturnValue(0)
        }
        // Prune drops the history row and leaves the feature. Enter must
        // add a new cut, not regen a row that is no longer in the timeline.
        IfCondition EqualTo(CadApp.hist_fi, 0) ThenBlock: { ReturnValue(1) }
        IfCondition LessThan(CadApp.hist_n, 1) ThenBlock: { ReturnValue(0) }
        CadAppRepo.feat_i = Add(CadApp.feat_sel, 1)
        CadAppRepo.i = 0
        CadAppRepo.n = 0
        WhileLoop LessThan(CadAppRepo.i, CadApp.hist_n) {
            IfCondition EqualTo(ArrayGet(CadApp.hist_fi, CadAppRepo.i), CadAppRepo.feat_i) ThenBlock: {
                CadAppRepo.n = 1
            }
            CadAppRepo.i = Add(CadAppRepo.i, 1)
        }
        IfCondition EqualTo(CadAppRepo.n, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Number features whose feat_ord is still 0. A stored number is left alone,
// so deleting Fillet 1 does not rename Fillet 2.
Function.CA_FeatOrdBackfill {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.feat_ord, 0) ThenBlock: {
            CadApp.feat_ord = Allocate(1024)
            IfCondition NotEqual(CadApp.feat_ord, 0) ThenBlock: {
                CA_ZeroSpan(CadApp.feat_ord, 0, 128)
            }
        }
        IfCondition EqualTo(CadApp.feat_ord, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(0) }
        CadAppHud.tn = 1
        WhileLoop LessEqual(CadAppHud.tn, 14) {
            CadAppHud.parp = 0
            CadAppRepo.i = 0
            WhileLoop LessThan(CadAppRepo.i, CadApp.feat_n) {
                IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadAppRepo.i), CadAppHud.tn) ThenBlock: {
                    CadAppHud.faceh = ArrayGet(CadApp.feat_ord, CadAppRepo.i)
                    IfCondition GreaterThan(CadAppHud.faceh, CadAppHud.parp) ThenBlock: {
                        CadAppHud.parp = CadAppHud.faceh
                    }
                }
                CadAppRepo.i = Add(CadAppRepo.i, 1)
            }
            CadAppRepo.i = 0
            WhileLoop LessThan(CadAppRepo.i, CadApp.feat_n) {
                IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadAppRepo.i), CadAppHud.tn) ThenBlock: {
                    IfCondition LessThan(ArrayGet(CadApp.feat_ord, CadAppRepo.i), 1) ThenBlock: {
                        CadAppHud.parp = Add(CadAppHud.parp, 1)
                        ArraySet(CadApp.feat_ord, CadAppRepo.i, CadAppHud.parp)
                    }
                }
                CadAppRepo.i = Add(CadAppRepo.i, 1)
            }
            CadAppHud.tn = Add(CadAppHud.tn, 1)
        }
        ReturnValue(0)
    }
}

// User alias after the type title. Sketch alias is per sketch slot.
Function.CA_AppendFeatAlias {
    Input: buf: Address
    Input: fi: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(CadAppRepo.pos) }
        IfCondition LessThan(fi, 0) ThenBlock: { ReturnValue(CadAppRepo.pos) }
        CadAppHud.faceh = ArrayGet(CadApp.feat_kind, fi)
        IfCondition EqualTo(CadAppHud.faceh, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.sk_alias, 0) ThenBlock: { ReturnValue(CadAppRepo.pos) }
            CadAppHud.plp = Multiply(ArrayGet(CadApp.feat_sk, fi), 32)
            IfCondition EqualTo(GetByte(CadApp.sk_alias, CadAppHud.plp), 0) ThenBlock: { ReturnValue(CadAppRepo.pos) }
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "  ")
            CadAppRepo.i = 0
            WhileLoop LessThan(CadAppRepo.i, 31) {
                CadAppHud.sk0p = GetByte(CadApp.sk_alias, Add(CadAppHud.plp, CadAppRepo.i))
                IfCondition EqualTo(CadAppHud.sk0p, 0) ThenBlock: { CadAppRepo.i = 31 }
                IfCondition NotEqual(CadAppHud.sk0p, 0) ThenBlock: {
                    SetByte(buf, CadAppRepo.pos, CadAppHud.sk0p)
                    CadAppRepo.pos = Add(CadAppRepo.pos, 1)
                    CadAppRepo.i = Add(CadAppRepo.i, 1)
                }
            }
            ReturnValue(CadAppRepo.pos)
        }
        IfCondition EqualTo(CadApp.feat_alias, 0) ThenBlock: { ReturnValue(CadAppRepo.pos) }
        CadAppHud.plp = Multiply(fi, 32)
        IfCondition EqualTo(GetByte(CadApp.feat_alias, CadAppHud.plp), 0) ThenBlock: { ReturnValue(CadAppRepo.pos) }
        CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "  ")
        CadAppRepo.i = 0
        WhileLoop LessThan(CadAppRepo.i, 31) {
            CadAppHud.sk0p = GetByte(CadApp.feat_alias, Add(CadAppHud.plp, CadAppRepo.i))
            IfCondition EqualTo(CadAppHud.sk0p, 0) ThenBlock: { CadAppRepo.i = 31 }
            IfCondition NotEqual(CadAppHud.sk0p, 0) ThenBlock: {
                SetByte(buf, CadAppRepo.pos, CadAppHud.sk0p)
                CadAppRepo.pos = Add(CadAppRepo.pos, 1)
                CadAppRepo.i = Add(CadAppRepo.i, 1)
            }
        }
        ReturnValue(CadAppRepo.pos)
    }
}

// "  N edge" / "  N edges" from feat_en. Nothing when the count was not stored.
Function.CA_AppendEdgeCount {
    Input: buf: Address
    Input: fi: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(CadAppRepo.pos) }
        IfCondition EqualTo(CadApp.feat_en, 0) ThenBlock: { ReturnValue(CadAppRepo.pos) }
        CadAppHud.tn = ArrayGet(CadApp.feat_en, fi)
        IfCondition LessThan(CadAppHud.tn, 1) ThenBlock: { ReturnValue(CadAppRepo.pos) }
        CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "  ")
        CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.tn)
        IfCondition EqualTo(CadAppHud.tn, 1) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, " edge")
        }
        IfCondition NotEqual(CadAppHud.tn, 1) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, " edges")
        }
        ReturnValue(CadAppRepo.pos)
    }
}

// Work-tree and timeline title for one feature. Same words in both places.
// Sketch 1, Body 1  Extrude  H=, Fillet 1  R=  N edges.
Function.CA_AppendFeatTitle {
    Input: buf: Address
    Input: fi: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(CadAppRepo.pos) }
        IfCondition LessThan(fi, 0) ThenBlock: { ReturnValue(CadAppRepo.pos) }
        IfCondition GreaterEqual(fi, CadApp.feat_n) ThenBlock: { ReturnValue(CadAppRepo.pos) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(CadAppRepo.pos) }
        CadAppHud.sk0p = fi
        CadAppHud.faceh = ArrayGet(CadApp.feat_kind, CadAppHud.sk0p)
        CadAppHud.parp = 1
        IfCondition NotEqual(CadApp.feat_ord, 0) ThenBlock: {
            CadAppHud.parp = ArrayGet(CadApp.feat_ord, CadAppHud.sk0p)
        }
        IfCondition LessThan(CadAppHud.parp, 1) ThenBlock: { CadAppHud.parp = 1 }
        CadAppHud.plp = 0
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            CadAppHud.plp = ArrayGet(CadApp.feat_aux, CadAppHud.sk0p)
        }
        IfCondition EqualTo(CadAppHud.faceh, 0) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "Sketch ")
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, Add(ArrayGet(CadApp.feat_sk, CadAppHud.sk0p), 1))
            CA_AppendFeatAlias(buf, CadAppHud.sk0p)
            ReturnValue(CadAppRepo.pos)
        }
        IfCondition EqualTo(CadAppHud.faceh, 1) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "Body ")
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.parp)
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "  Extrude  H=")
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                CadAppHud.plp = ArrayGet(CadApp.feat_aux, CadAppHud.sk0p)
            }
            IfCondition EqualTo(CadApp.feat_aux, 0) ThenBlock: { CadAppHud.plp = CadApp.height }
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.plp)
        }
        IfCondition EqualTo(CadAppHud.faceh, 2) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "Revolve ")
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.parp)
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "  A=")
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                CadAppHud.plp = ArrayGet(CadApp.feat_aux, CadAppHud.sk0p)
            }
            IfCondition LessEqual(CadAppHud.plp, 0) ThenBlock: { CadAppHud.plp = CadApp.rev_deg }
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.plp)
        }
        IfCondition EqualTo(CadAppHud.faceh, 3) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "Cut ")
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.parp)
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "  H=")
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                CadAppHud.plp = ArrayGet(CadApp.feat_aux, CadAppHud.sk0p)
            }
            IfCondition EqualTo(CadApp.feat_aux, 0) ThenBlock: { CadAppHud.plp = CadApp.height }
            IfCondition LessThan(CadAppHud.plp, 0) ThenBlock: { CadAppHud.plp = Subtract(0, CadAppHud.plp) }
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.plp)
        }
        IfCondition EqualTo(CadAppHud.faceh, 4) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "Fillet ")
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.parp)
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                CadAppHud.plp = ArrayGet(CadApp.feat_aux, CadAppHud.sk0p)
            }
            IfCondition GreaterThan(CadAppHud.plp, 0) ThenBlock: {
                CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "  R=")
                CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, Divide(CadAppHud.plp, 1000))
                CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, ".")
                CadAppHud.parp = Subtract(CadAppHud.plp, Multiply(Divide(CadAppHud.plp, 1000), 1000))
                CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, Divide(CadAppHud.parp, 100))
                CadAppHud.parp = Subtract(CadAppHud.parp, Multiply(Divide(CadAppHud.parp, 100), 100))
                CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, Divide(CadAppHud.parp, 10))
                CadAppHud.parp = Subtract(CadAppHud.parp, Multiply(Divide(CadAppHud.parp, 10), 10))
                CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.parp)
            }
            CA_AppendEdgeCount(buf, CadAppHud.sk0p)
        }
        IfCondition EqualTo(CadAppHud.faceh, 5) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "Chamfer ")
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.parp)
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                CadAppHud.plp = ArrayGet(CadApp.feat_aux, CadAppHud.sk0p)
            }
            IfCondition GreaterThan(CadAppHud.plp, 0) ThenBlock: {
                CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "  D=")
                CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.plp)
            }
            CA_AppendEdgeCount(buf, CadAppHud.sk0p)
        }
        IfCondition EqualTo(CadAppHud.faceh, 8) ThenBlock: {
            CadAppHud.plp = 6
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                IfCondition NotEqual(CadApp.pg_tab, 0) ThenBlock: {
                    CadAppRepo.i = ArrayGet(CadApp.feat_aux, CadAppHud.sk0p)
                    IfCondition GreaterEqual(CadAppRepo.i, 0) ThenBlock: {
                        IfCondition LessThan(CadAppRepo.i, CadApp.pg_n) ThenBlock: {
                            CadAppHud.plp = ArrayGet(CadApp.pg_tab, Multiply(CadAppRepo.i, 10))
                        }
                    }
                }
            }
            IfCondition EqualTo(CadAppHud.plp, 3) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "Triangle ") }
            IfCondition EqualTo(CadAppHud.plp, 4) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "Square ") }
            IfCondition EqualTo(CadAppHud.plp, 5) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "Pentagon ") }
            IfCondition EqualTo(CadAppHud.plp, 6) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "Hexagon ") }
            IfCondition EqualTo(CadAppHud.plp, 8) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "Octagon ") }
            IfCondition NotEqual(CadAppHud.plp, 3) ThenBlock: {
                IfCondition NotEqual(CadAppHud.plp, 4) ThenBlock: {
                    IfCondition NotEqual(CadAppHud.plp, 5) ThenBlock: {
                        IfCondition NotEqual(CadAppHud.plp, 6) ThenBlock: {
                            IfCondition NotEqual(CadAppHud.plp, 8) ThenBlock: {
                                CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.plp)
                                CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "-gon ")
                            }
                        }
                    }
                }
            }
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.parp)
        }
        IfCondition EqualTo(CadAppHud.faceh, 9) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "Line ")
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.parp)
        }
        IfCondition EqualTo(CadAppHud.faceh, 10) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "Circle ")
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.parp)
        }
        IfCondition EqualTo(CadAppHud.faceh, 11) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "Rect ")
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.parp)
            CadAppHud.plp = CadApp.rect_w
            CadAppHud.tn = CadApp.rect_h
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                IfCondition NotEqual(CadApp.rt_tab, 0) ThenBlock: {
                    CadAppRepo.i = ArrayGet(CadApp.feat_aux, CadAppHud.sk0p)
                    IfCondition GreaterEqual(CadAppRepo.i, 0) ThenBlock: {
                        CadAppHud.plp = ArrayGet(CadApp.rt_tab, Add(Multiply(CadAppRepo.i, 10), 1))
                        CadAppHud.tn = ArrayGet(CadApp.rt_tab, Add(Multiply(CadAppRepo.i, 10), 2))
                    }
                }
            }
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "  ")
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.plp)
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "x")
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.tn)
        }
        IfCondition EqualTo(CadAppHud.faceh, 12) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "Fillet2 ")
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.parp)
        }
        IfCondition EqualTo(CadAppHud.faceh, 13) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "Constr ")
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.parp)
        }
        IfCondition EqualTo(CadAppHud.faceh, 14) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(buf, CadAppRepo.pos, "Point ")
            CadAppRepo.pos = CAD_Repo.AppendInt(buf, CadAppRepo.pos, CadAppHud.parp)
        }
        CA_AppendFeatAlias(buf, CadAppHud.sk0p)
        ReturnValue(CadAppRepo.pos)
    }
}

// Timeline chip text. Uses the feature title when this step still points at one.
Function.CA_AppendHistName {
    Input: hi: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppIpc.hist, 0) ThenBlock: { ReturnValue(CadAppRepo.pos) }
        IfCondition EqualTo(CadApp.hist_kind, 0) ThenBlock: { ReturnValue(CadAppRepo.pos) }
        CadAppHud.hv = hi
        CadAppHud.faceh = ArrayGet(CadApp.hist_kind, CadAppHud.hv)
        CadAppHud.sk0p = 0
        IfCondition NotEqual(CadApp.hist_fi, 0) ThenBlock: {
            CadAppHud.sk0p = ArrayGet(CadApp.hist_fi, CadAppHud.hv)
        }
        IfCondition GreaterThan(CadAppHud.sk0p, 0) ThenBlock: {
            IfCondition LessEqual(CadAppHud.sk0p, CadApp.feat_n) ThenBlock: {
                IfCondition EqualTo(ArrayGet(CadApp.feat_kind, Subtract(CadAppHud.sk0p, 1)), CadAppHud.faceh) ThenBlock: {
                    CA_AppendFeatTitle(CadAppIpc.hist, Subtract(CadAppHud.sk0p, 1))
                    ReturnValue(CadAppRepo.pos)
                }
            }
        }
        IfCondition EqualTo(CadAppHud.faceh, 0) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "Sketch")
            IfCondition NotEqual(CadApp.hist_ski, 0) ThenBlock: {
                CadAppHud.plp = ArrayGet(CadApp.hist_ski, CadAppHud.hv)
                IfCondition GreaterThan(CadAppHud.plp, 0) ThenBlock: {
                    CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, " ")
                    CadAppRepo.pos = CAD_Repo.AppendInt(CadAppIpc.hist, CadAppRepo.pos, CadAppHud.plp)
                }
            }
            ReturnValue(CadAppRepo.pos)
        }
        IfCondition EqualTo(CadAppHud.faceh, 1) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "Extrude") }
        IfCondition EqualTo(CadAppHud.faceh, 2) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "Revolve") }
        IfCondition EqualTo(CadAppHud.faceh, 3) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "Cut") }
        IfCondition EqualTo(CadAppHud.faceh, 4) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "Fillet") }
        IfCondition EqualTo(CadAppHud.faceh, 5) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "Chamfer") }
        IfCondition EqualTo(CadAppHud.faceh, 6) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "Clear") }
        IfCondition EqualTo(CadAppHud.faceh, 7) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "Trim") }
        IfCondition EqualTo(CadAppHud.faceh, 8) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "Polygon") }
        IfCondition EqualTo(CadAppHud.faceh, 9) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "Line") }
        IfCondition EqualTo(CadAppHud.faceh, 10) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "Circle") }
        IfCondition EqualTo(CadAppHud.faceh, 11) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "Rect") }
        IfCondition EqualTo(CadAppHud.faceh, 12) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "Fillet2") }
        IfCondition EqualTo(CadAppHud.faceh, 13) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "Constr") }
        IfCondition EqualTo(CadAppHud.faceh, 14) ThenBlock: { CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.hist, CadAppRepo.pos, "Point") }
        ReturnValue(CadAppRepo.pos)
    }
}

// Document navigator. The * mark is the selection. Chrome draws that mark.
// It does not decide which row is current.
//   Sketch N
//     Rect / Circle / Line
//     Body N  Extrude
//       Cut / Fillet / Chamfer
//   Model
// depth letter id mark label
Function.CA_WriteTree {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppIpc.tree, 0) ThenBlock: { CadAppIpc.tree = Allocate(8192) }
        IfCondition EqualTo(CadAppIpc.tree, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sk_n, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                CA_SketchRegister(CadApp.sketch)
            }
        }
        IfCondition EqualTo(CadAppIpc.tree, 0) ThenBlock: { ReturnValue(-1) }
        CA_FeatOrdBackfill()
        CadAppRepo.pos = 0
        // P line — part name for the HISTORY header (not a row)
        CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, "0 P 0 . ")
        IfCondition EqualTo(CadApp.part_name, 0) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, "untitled")
        }
        IfCondition NotEqual(CadApp.part_name, 0) ThenBlock: {
            CadAppRepo.i = 0
            WhileLoop LessThan(CadAppRepo.i, 48) {
                pc = GetByte(CadApp.part_name, CadAppRepo.i)
                IfCondition EqualTo(pc, 0) ThenBlock: { CadAppRepo.i = 48 }
                IfCondition NotEqual(pc, 0) ThenBlock: {
                    ok = 0
                    IfCondition GreaterEqual(pc, 32) ThenBlock: {
                        IfCondition LessThan(pc, 127) ThenBlock: { ok = 1 }
                    }
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        SetByte(CadAppIpc.tree, CadAppRepo.pos, pc)
                        CadAppRepo.pos = Add(CadAppRepo.pos, 1)
                    }
                    CadAppRepo.i = Add(CadAppRepo.i, 1)
                }
            }
        }
        CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, "\n")
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, CadApp.sk_n) {
        CadAppRepo.body = 0
        CadAppRepo.i = 0
        WhileLoop LessThan(CadAppRepo.i, CadApp.feat_n) {
            IfCondition EqualTo(ArrayGet(CadApp.feat_sk, CadAppRepo.i), CadAppPick.pi) ThenBlock: {
                IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadAppRepo.i), 1) ThenBlock: { CadAppRepo.body = 1 }
                IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadAppRepo.i), 2) ThenBlock: { CadAppRepo.body = 1 }
            }
            CadAppRepo.i = Add(CadAppRepo.i, 1)
        }
        CadAppRepo.pass = 0
        WhileLoop LessThan(CadAppRepo.pass, 4) {
        CadAppRepo.feat_i = 0
        WhileLoop LessThan(CadAppRepo.feat_i, CadApp.feat_n) {
            fk = ArrayGet(CadApp.feat_kind, CadAppRepo.feat_i)
            fs = ArrayGet(CadApp.feat_sk, CadAppRepo.feat_i)
            want = 0
            IfCondition EqualTo(fs, CadAppPick.pi) ThenBlock: {
                IfCondition EqualTo(CadAppRepo.pass, 0) ThenBlock: {
                    IfCondition EqualTo(fk, 0) ThenBlock: { want = 1 }
                }
                IfCondition EqualTo(CadAppRepo.pass, 1) ThenBlock: {
                    IfCondition GreaterEqual(fk, 8) ThenBlock: { want = 1 }
                }
                IfCondition EqualTo(CadAppRepo.pass, 2) ThenBlock: {
                    IfCondition GreaterEqual(fk, 1) ThenBlock: {
                        IfCondition LessEqual(fk, 2) ThenBlock: { want = 1 }
                    }
                }
                IfCondition EqualTo(CadAppRepo.pass, 3) ThenBlock: {
                    IfCondition EqualTo(fk, 3) ThenBlock: { want = 1 }
                    IfCondition EqualTo(fk, 4) ThenBlock: { want = 1 }
                    IfCondition EqualTo(fk, 5) ThenBlock: { want = 1 }
                }
            }
            IfCondition EqualTo(want, 1) ThenBlock: {
            IfCondition LessThan(CadAppRepo.pos, 8000) ThenBlock: {
            depth = 0
            CadAppPick.ax = 83
            IfCondition EqualTo(fk, 1) ThenBlock: {
                depth = 1
                CadAppPick.ax = 66
            }
            IfCondition EqualTo(fk, 2) ThenBlock: {
                depth = 1
                CadAppPick.ax = 82
            }
            IfCondition EqualTo(fk, 3) ThenBlock: {
                depth = 2
                IfCondition EqualTo(CadAppRepo.body, 0) ThenBlock: { depth = 1 }
                CadAppPick.ax = 85
            }
            IfCondition EqualTo(fk, 4) ThenBlock: {
                depth = 2
                CadAppPick.ax = 70
            }
            IfCondition EqualTo(fk, 5) ThenBlock: {
                depth = 2
                CadAppPick.ax = 67
            }
            IfCondition EqualTo(fk, 8) ThenBlock: {
                depth = 1
                CadAppPick.ax = 71
            }
            IfCondition EqualTo(fk, 9) ThenBlock: {
                depth = 1
                CadAppPick.ax = 76
            }
            IfCondition EqualTo(fk, 10) ThenBlock: {
                depth = 1
                CadAppPick.ax = 79
            }
            IfCondition EqualTo(fk, 11) ThenBlock: {
                depth = 1
                CadAppPick.ax = 69
            }
            IfCondition EqualTo(fk, 12) ThenBlock: {
                depth = 1
                CadAppPick.ax = 74
            }
            IfCondition EqualTo(fk, 13) ThenBlock: {
                depth = 1
                CadAppPick.ax = 88
            }
            IfCondition EqualTo(fk, 14) ThenBlock: {
                depth = 1
                CadAppPick.ax = 84
            }
            CadAppRepo.pos = CAD_Repo.AppendInt(CadAppIpc.tree, CadAppRepo.pos, depth)
            CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, " ")
            SetByte(CadAppIpc.tree, CadAppRepo.pos, CadAppPick.ax)
            CadAppRepo.pos = Add(CadAppRepo.pos, 1)
            CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, " ")
            fk = ArrayGet(CadApp.feat_kind, CadAppRepo.feat_i)
            fs = ArrayGet(CadApp.feat_sk, CadAppRepo.feat_i)
            IfCondition EqualTo(fk, 0) ThenBlock: {
                CadAppRepo.pos = CAD_Repo.AppendInt(CadAppIpc.tree, CadAppRepo.pos, fs)
            }
            IfCondition NotEqual(fk, 0) ThenBlock: {
                CadAppRepo.pos = CAD_Repo.AppendInt(CadAppIpc.tree, CadAppRepo.pos, CadAppRepo.feat_i)
            }
            CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, " ")
            fk = ArrayGet(CadApp.feat_kind, CadAppRepo.feat_i)
            fs = ArrayGet(CadApp.feat_sk, CadAppRepo.feat_i)
            star = 0
            IfCondition EqualTo(CadAppRepo.feat_i, CadApp.feat_sel) ThenBlock: { star = 1 }
            IfCondition EqualTo(star, 1) ThenBlock: {
                CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, "* ")
            }
            IfCondition EqualTo(star, 0) ThenBlock: {
                CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, ". ")
            }
            CadAppRepo.pos = CA_AppendFeatTitle(CadAppIpc.tree, CadAppRepo.feat_i)
            CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, "\n")
            fk = ArrayGet(CadApp.feat_kind, CadAppRepo.feat_i)
            IfCondition EqualTo(fk, 0) ThenBlock: {
                CA_WriteSketchProfs(ArrayGet(CadApp.feat_sk, CadAppRepo.feat_i))
            }
            }
            }
            CadAppRepo.feat_i = Add(CadAppRepo.feat_i, 1)
        }
        CadAppRepo.pass = Add(CadAppRepo.pass, 1)
        }
        CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, CadApp.plane_n) {
            CadApp.pick_fh = 0
            IfCondition NotEqual(CadApp.plane_list, 0) ThenBlock: {
                CadApp.pick_fh = ArrayGet(CadApp.plane_list, CadAppPick.pi)
            }
            IfCondition EqualTo(CA_PlaneIsImplicitXY(CadApp.pick_fh), 0) ThenBlock: {
                CadAppRepo.pos = CAD_Repo.AppendInt(CadAppIpc.tree, CadAppRepo.pos, 0)
                CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, " N ")
                CadAppRepo.pos = CAD_Repo.AppendInt(CadAppIpc.tree, CadAppRepo.pos, CadAppPick.pi)
                CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, " ")
                IfCondition EqualTo(CadApp.pick_fh, CadApp.plane) ThenBlock: {
                    CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, "* ")
                }
                IfCondition NotEqual(CadApp.pick_fh, CadApp.plane) ThenBlock: {
                    CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, ". ")
                }
                CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, "Plane")
                CadAppPick.ins_i = CadAppRepo.pos
                CadAppPick.face = 0
                CadAppPick.col = 0
                CadAppPick.thick = 0
                IfCondition NotEqual(CadApp.pick_fh, 0) ThenBlock: {
                    CadAppPick.face = CAD_Plane.GetPid(CadApp.pick_fh)
                    CadAppPick.col = CAD_Plane.GetRecipe(CadApp.pick_fh)
                    CadAppPick.thick = CAD_Plane.GetMode(CadApp.pick_fh)
                }
                CadAppRepo.pos = CadAppPick.ins_i
                CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, " ")
                CadAppRepo.pos = CAD_Repo.AppendInt(CadAppIpc.tree, CadAppRepo.pos, CadAppPick.face)
                IfCondition EqualTo(CadAppPick.thick, 3) ThenBlock: {
                    CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, "  Face")
                }
                IfCondition EqualTo(CadAppPick.col, 1) ThenBlock: {
                    CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, "  Offset")
                }
                IfCondition EqualTo(CadAppPick.col, 2) ThenBlock: {
                    CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, "  Angle")
                }
                IfCondition EqualTo(CadAppPick.col, 3) ThenBlock: {
                    CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, "  Angle")
                }
                CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, "\n")
            }
            CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, "0 M 0 ")
        mstar = 0
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
            IfCondition GreaterEqual(CadApp.feat_sel, CadApp.feat_n) ThenBlock: { mstar = 1 }
            IfCondition EqualTo(CadApp.feat_n, 0) ThenBlock: { mstar = 1 }
        }
        IfCondition EqualTo(mstar, 1) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, "* Model")
        }
        IfCondition EqualTo(mstar, 0) ThenBlock: {
            CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, ". Model")
        }
        IfCondition NotEqual(CadApp.part_name, 0) ThenBlock: {
            IfCondition NotEqual(GetByte(CadApp.part_name, 0), 0) ThenBlock: {
                CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, "  ")
                CadAppRepo.i = 0
                WhileLoop LessThan(CadAppRepo.i, 48) {
                    pc = GetByte(CadApp.part_name, CadAppRepo.i)
                    IfCondition EqualTo(pc, 0) ThenBlock: { CadAppRepo.i = 48 }
                    IfCondition NotEqual(pc, 0) ThenBlock: {
                        ok = 0
                        IfCondition GreaterEqual(pc, 32) ThenBlock: {
                            IfCondition LessThan(pc, 127) ThenBlock: { ok = 1 }
                        }
                        IfCondition EqualTo(ok, 1) ThenBlock: {
                            SetByte(CadAppIpc.tree, CadAppRepo.pos, pc)
                            CadAppRepo.pos = Add(CadAppRepo.pos, 1)
                        }
                        CadAppRepo.i = Add(CadAppRepo.i, 1)
                    }
                }
            }
        }
        CadAppRepo.pos = CAD_Repo.AppendStr(CadAppIpc.tree, CadAppRepo.pos, "\n")
        SetByte(CadAppIpc.tree, CadAppRepo.pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/tree.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, CadAppIpc.tree, CadAppRepo.pos)
            SystemCall(3, fd, 0, 0)
        }
        ReturnValue(0)
    }
}

// Ensure PG connection + schema (once).


Function.CA_WriteStatus {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppIpc.stat, 0) ThenBlock: { CadAppIpc.stat = Allocate(160) }
        st = CadAppIpc.stat
        IfCondition EqualTo(st, 0) ThenBlock: { ReturnValue(-1) }
        pos = 0
        IfCondition EqualTo(CadApp.list_open, 1) ThenBlock: {
            // LIST sel/count
            msg = "LIST "
            i = 0
            WhileLoop NotEqual(GetByte(msg, i), 0) {
                SetByte(st, pos, GetByte(msg, i))
                pos = Add(pos, 1)
                i = Add(i, 1)
            }
            // sel+1
            v = Add(CadApp.list_sel, 1)
            IfCondition EqualTo(v, 0) ThenBlock: {
                SetByte(st, pos, 48)
                pos = Add(pos, 1)
            }
            IfCondition GreaterThan(v, 0) ThenBlock: {
                tmp = Allocate(16)
                n = 0
                vv = v
                WhileLoop GreaterThan(vv, 0) {
                    SetByte(tmp, n, Add(48, Modulo(vv, 10)))
                    vv = Divide(vv, 10)
                    n = Add(n, 1)
                }
                ii = Subtract(n, 1)
                WhileLoop GreaterEqual(ii, 0) {
                    SetByte(st, pos, GetByte(tmp, ii))
                    pos = Add(pos, 1)
                    ii = Subtract(ii, 1)
                }
                Deallocate(tmp, 16)
            }
            SetByte(st, pos, 47)
            pos = Add(pos, 1)
            v = CadApp.list_count
            IfCondition EqualTo(v, 0) ThenBlock: {
                SetByte(st, pos, 48)
                pos = Add(pos, 1)
            }
            IfCondition GreaterThan(v, 0) ThenBlock: {
                tmp = Allocate(16)
                n = 0
                vv = v
                WhileLoop GreaterThan(vv, 0) {
                    SetByte(tmp, n, Add(48, Modulo(vv, 10)))
                    vv = Divide(vv, 10)
                    n = Add(n, 1)
                }
                ii = Subtract(n, 1)
                WhileLoop GreaterEqual(ii, 0) {
                    SetByte(st, pos, GetByte(tmp, ii))
                    pos = Add(pos, 1)
                    ii = Subtract(ii, 1)
                }
                Deallocate(tmp, 16)
            }
            SetByte(st, pos, 32)
            pos = Add(pos, 1)
            nm = Allocate(80)
            IfCondition EqualTo(CA_ListNameAt(CadApp.list_sel, nm), 1) ThenBlock: {
                i = 0
                WhileLoop NotEqual(GetByte(nm, i), 0) {
                    IfCondition LessThan(pos, 120) ThenBlock: {
                        SetByte(st, pos, GetByte(nm, i))
                        pos = Add(pos, 1)
                    }
                    i = Add(i, 1)
                }
            }
            Deallocate(nm, 80)
            tail = "  g=open p=save"
            i = 0
            WhileLoop NotEqual(GetByte(tail, i), 0) {
                IfCondition LessThan(pos, 150) ThenBlock: {
                    SetByte(st, pos, GetByte(tail, i))
                    pos = Add(pos, 1)
                }
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(CadApp.list_open, 0) ThenBlock: {
            msg = "DOC "
            i = 0
            WhileLoop NotEqual(GetByte(msg, i), 0) {
                SetByte(st, pos, GetByte(msg, i))
                pos = Add(pos, 1)
                i = Add(i, 1)
            }
            CadAppHud.pos = pos
            CA_EnsureName()
            st = CadAppIpc.stat
            pos = CadAppHud.pos
            i = 0
            WhileLoop NotEqual(GetByte(CadApp.part_name, i), 0) {
                IfCondition LessThan(pos, 100) ThenBlock: {
                    pc = GetByte(CadApp.part_name, i)
                    ok = 0
                    IfCondition GreaterEqual(pc, 32) ThenBlock: {
                        IfCondition LessThan(pc, 127) ThenBlock: { ok = 1 }
                    }
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        SetByte(st, pos, pc)
                        pos = Add(pos, 1)
                    }
                }
                i = Add(i, 1)
                IfCondition GreaterThan(i, 62) ThenBlock: { i = 63 }
            }
            SetByte(st, pos, 32)
            pos = Add(pos, 1)
            SetByte(st, pos, 114)
            pos = Add(pos, 1)
            v = CadApp.part_rev
            IfCondition EqualTo(v, 0) ThenBlock: {
                SetByte(st, pos, 48)
                pos = Add(pos, 1)
            }
            IfCondition GreaterThan(v, 0) ThenBlock: {
                tmp = Allocate(16)
                n = 0
                vv = v
                WhileLoop GreaterThan(vv, 0) {
                    SetByte(tmp, n, Add(48, Modulo(vv, 10)))
                    vv = Divide(vv, 10)
                    n = Add(n, 1)
                }
                ii = Subtract(n, 1)
                WhileLoop GreaterEqual(ii, 0) {
                    SetByte(st, pos, GetByte(tmp, ii))
                    pos = Add(pos, 1)
                    ii = Subtract(ii, 1)
                }
                Deallocate(tmp, 16)
            }
            // always init tail (tool=3 ARC used to leave garbage → crash)
            tail = " "
            IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
                IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " LINE c1" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " LINE c2" }
                }
                IfCondition EqualTo(CadApp.tool, 1) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " RECT c1" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " RECT c2" }
                }
                IfCondition EqualTo(CadApp.tool, 2) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " CIRC center" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " CIRC radius" }
                }
                IfCondition EqualTo(CadApp.tool, 3) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " ARC center" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " ARC start" }
                    IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: { tail = " ARC end" }
                }
                IfCondition EqualTo(CadApp.tool, 9) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " ARC3 start" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " ARC3 through" }
                    IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: { tail = " ARC3 end" }
                }
                IfCondition EqualTo(CadApp.tool, 12) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " ARC2 P0" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " ARC2 P1" }
                }
                IfCondition EqualTo(CadApp.tool, 13) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " CIRC2 P0" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " CIRC2 P1" }
                }
                IfCondition EqualTo(CadApp.tool, 14) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " CIRC3 start" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " CIRC3 through" }
                    IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: { tail = " CIRC3 end" }
                }
                IfCondition EqualTo(CadApp.tool, 15) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " RECTC center" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " RECTC corner" }
                }
                IfCondition EqualTo(CadApp.tool, 16) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " RECT3 corner" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " RECT3 edge" }
                    IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: { tail = " RECT3 height" }
                }
                IfCondition EqualTo(CadApp.tool, 17) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " POLY center" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " POLY vertex" }
                }
                IfCondition EqualTo(CadApp.tool, 18) ThenBlock: { tail = " SPLINE CVs then done" }
                IfCondition EqualTo(CadApp.tool, 4) ThenBlock: { tail = " PICK profile" }
                IfCondition EqualTo(CadApp.tool, 5) ThenBlock: { tail = " TRIM click" }
                IfCondition EqualTo(CadApp.tool, 6) ThenBlock: { tail = " POINT click" }
                IfCondition EqualTo(CadApp.tool, 8) ThenBlock: {
                    tail = " FILLET pick line"
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " FILLET 2nd line" }
                }
                IfCondition EqualTo(CadApp.tool, 7) ThenBlock: {
                    // keep tool name visible (do not let dirty/* overwrite below)
                    tail = " CSTR?"
                    IfCondition EqualTo(CadApp.cstr_type, 9) ThenBlock: { tail = " COIN 2picks" }
                    IfCondition EqualTo(CadApp.cstr_type, 7) ThenBlock: { tail = " H line" }
                    IfCondition EqualTo(CadApp.cstr_type, 8) ThenBlock: { tail = " V line" }
                    IfCondition EqualTo(CadApp.cstr_type, 1) ThenBlock: { tail = " FixO point" }
                    IfCondition EqualTo(CadApp.cstr_type, 6) ThenBlock: { tail = " DistO point" }
                    IfCondition EqualTo(CadApp.cstr_type, 11) ThenBlock: { tail = " Rad circle" }
                    IfCondition EqualTo(CadApp.cstr_type, 13) ThenBlock: { tail = " TANG 2picks" }
                    IfCondition EqualTo(CadApp.cstr_type, 10) ThenBlock: { tail = " OnLn 2picks" }
                    IfCondition EqualTo(CadApp.cstr_type, 12) ThenBlock: { tail = " EqR 2circs" }
                    IfCondition EqualTo(CadApp.cstr_type, 15) ThenBlock: { tail = " Dist 2pts" }
                    IfCondition EqualTo(CadApp.cstr_npick, 1) ThenBlock: { tail = " need 2nd pick" }
                }
                // dirty tool tag first, then profile selection overwrites for Pick
                IfCondition EqualTo(CadApp.dirty, 1) ThenBlock: {
                    IfCondition EqualTo(CadApp.tool, 0) ThenBlock: { tail = " *LINE" }
                    IfCondition EqualTo(CadApp.tool, 1) ThenBlock: { tail = " *RECT" }
                    IfCondition EqualTo(CadApp.tool, 2) ThenBlock: { tail = " *CIRC" }
                    IfCondition EqualTo(CadApp.tool, 3) ThenBlock: { tail = " *ARC" }
                    IfCondition EqualTo(CadApp.tool, 4) ThenBlock: { tail = " *PICK" }
                    IfCondition EqualTo(CadApp.tool, 5) ThenBlock: { tail = " *TRIM" }
                    IfCondition EqualTo(CadApp.tool, 6) ThenBlock: { tail = " *POINT" }
                    // tool 7: keep COIN/H/V/... name — do not wipe with *CSTR
                }
                // profile selection state wins over *PICK when faces exist
                IfCondition EqualTo(CadApp.tool, 4) ThenBlock: {
                    IfCondition GreaterThan(CadApp.nprof, 0) ThenBlock: {
                        IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
                            tail = " lightRED click face"
                        }
                        IfCondition EqualTo(CadApp.prof_user, 1) ThenBlock: {
                            tail = " brightRED Ctrl+multi"
                        }
                    }
                }
            }
            IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
                IfCondition EqualTo(CadApp.face_pick, 1) ThenBlock: {
                    tail = " click FACE for sketch"
                }
                IfCondition EqualTo(CadApp.face_pick, 0) ThenBlock: {
                    IfCondition EqualTo(CadApp.dirty, 1) ThenBlock: {
                        tail = " *3D pad/save"
                    }
                    IfCondition EqualTo(CadApp.dirty, 0) ThenBlock: {
                        tail = " 3D"
                    }
                }
            }
            i = 0
            WhileLoop NotEqual(GetByte(tail, i), 0) {
                IfCondition LessThan(pos, 150) ThenBlock: {
                    SetByte(st, pos, GetByte(tail, i))
                    pos = Add(pos, 1)
                }
                i = Add(i, 1)
            }
            // cursor UV — use hover_u/v already computed on click/hover.
            // Do NOT call PixToWorld here (clobbers st/pos → crash on-face).
            IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
                IfCondition EqualTo(CadApp.hover_ok, 1) ThenBlock: {
                    IfCondition LessThan(pos, 140) ThenBlock: {
                        SetByte(st, pos, 32)
                        pos = Add(pos, 1)
                        SetByte(st, pos, 117)
                        pos = Add(pos, 1)
                        SetByte(st, pos, 61)
                        pos = Add(pos, 1)
                    }
                    CadAppIpc.camp = CadAppHud.st
                    CadAppHud.st = CadAppIpc.stat
                    CadAppHud.pos = pos
                    CA_HudInt(CadApp.hover_u)
                    st = CadAppIpc.stat
                    pos = CadAppHud.pos
                    IfCondition LessThan(pos, 145) ThenBlock: {
                        SetByte(st, pos, 32)
                        pos = Add(pos, 1)
                        SetByte(st, pos, 118)
                        pos = Add(pos, 1)
                        SetByte(st, pos, 61)
                        pos = Add(pos, 1)
                    }
                    CadAppHud.pos = pos
                    CA_HudInt(CadApp.hover_v)
                    st = CadAppIpc.stat
                    pos = CadAppHud.pos
                    CadAppHud.st = CadAppIpc.camp
                }
            }
        }
        SetByte(st, pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/status.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, st, pos)
            SystemCall(3, fd, 0, 0)
        }
        ReturnValue(0)
    }
}


// Write tool strip state for host: mode tool nclick dirty cstr_type npick
Function.CA_WriteToolFile {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadAppIpc.tool, 0) ThenBlock: { CadAppIpc.tool = Allocate(48) }
        sb = CadAppIpc.tool
        IfCondition EqualTo(sb, 0) ThenBlock: { ReturnValue(-1) }
        // "M T N D CT NP\n" — CT is 2-digit constraint type for panel highlight
        pos = 0
        SetByte(sb, pos, Add(48, CadApp.mode))
        pos = Add(pos, 1)
        SetByte(sb, pos, 32)
        pos = Add(pos, 1)
        tt = CadApp.tool
        IfCondition LessThan(tt, 0) ThenBlock: { tt = 0 }
        IfCondition GreaterThan(tt, 99) ThenBlock: { tt = 99 }
        SetByte(sb, pos, Add(48, Divide(tt, 10)))
        pos = Add(pos, 1)
        SetByte(sb, pos, Add(48, Modulo(tt, 10)))
        pos = Add(pos, 1)
        SetByte(sb, pos, 32)
        pos = Add(pos, 1)
        SetByte(sb, pos, Add(48, CadApp.nclick))
        pos = Add(pos, 1)
        SetByte(sb, pos, 32)
        pos = Add(pos, 1)
        SetByte(sb, pos, Add(48, CadApp.dirty))
        pos = Add(pos, 1)
        SetByte(sb, pos, 32)
        pos = Add(pos, 1)
        ct = CadApp.cstr_type
        IfCondition GreaterThan(ct, 99) ThenBlock: { ct = 99 }
        SetByte(sb, pos, Add(48, Divide(ct, 10)))
        pos = Add(pos, 1)
        SetByte(sb, pos, Add(48, Modulo(ct, 10)))
        pos = Add(pos, 1)
        SetByte(sb, pos, 32)
        pos = Add(pos, 1)
        np = CadApp.cstr_npick
        IfCondition GreaterThan(np, 9) ThenBlock: { np = 9 }
        SetByte(sb, pos, Add(48, np))
        pos = Add(pos, 1)
        SetByte(sb, pos, 10)
        pos = Add(pos, 1)
        SetByte(sb, pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/tool.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, sb, pos)
            SystemCall(3, fd, 0, 0)
        }
        ReturnValue(0)
    }
}

// Parse signed int at buf[i], write value to out_addr[0], return new index or -1
