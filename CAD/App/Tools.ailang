Function.CA_SketchClick {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
        }
        xy = Allocate(32)
        CA_PixToWorld(px, py, xy)
        wx = ArrayGet(xy, 0)
        wy = ArrayGet(xy, 1)
        Deallocate(xy, 32)
        // line: 2 clicks
        IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: {
                CadApp.cx0 = wx
                CadApp.cy0 = wy
                CadApp.nclick = 1
            }
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                // second click — but nclick already 1 from first; use flag carefully
            }
        }
        // simpler sequential: if nclick==0 store; else complete and reset
        IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                // was already 1 before this click started... re-read logic
            }
        }
        ReturnValue(0)
    }
}

// Snap world (wx,wy): datum (O / axes) first, then line endpoints / circle rim.
// Writes snapped coords to out[0],out[1]. Returns 1 if snapped, 0 if left as-is.


// Snap world (wx,wy): datum (O / axes) first, then line endpoints / circle rim.
// Writes snapped coords to out[0],out[1]. Returns 1 if snapped, 0 if left as-is.
Function.CA_SnapWorld {
    Input: wx: Integer
    Input: wy: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        ArraySet(out_xy, 0, wx)
        ArraySet(out_xy, 1, wy)
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        CAD_Sketch.EnsureDatum(CadApp.sketch)
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: { ReturnValue(0) }
        // snap ≈ 10 px; only to EXISTING endpoints (not current segment start)
        // Closing a poly: click near the first vertex (it is an existing endpoint after ≥1 line).
        snap = Float_Div(Float_FromInt(10), sc)
        snap2 = Float_Mul(snap, snap)
        // min length so we do not snap into a zero-length segment from tip
        minlen2 = Float_Mul(snap2, 0x4010000000000000)
        // --- CS-0: origin / axes beat free geometry (hang from sketch zero) ---
        dsn = Allocate(32)
        dhit = CAD_Sketch.SnapToDatum(CadApp.sketch, wx, wy, snap, dsn)
        IfCondition GreaterThan(dhit, 0) ThenBlock: {
            bx = ArrayGet(dsn, 0)
            by = ArrayGet(dsn, 1)
            // refuse snap that collapses current segment to ~zero
            refuse = 0
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                dx = Float_Sub(bx, CadApp.cx0)
                dy = Float_Sub(by, CadApp.cy0)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, minlen2), 1) ThenBlock: {
                    refuse = 1
                }
            }
            IfCondition EqualTo(refuse, 0) ThenBlock: {
                ArraySet(out_xy, 0, bx)
                ArraySet(out_xy, 1, by)
                Deallocate(dsn, 32)
                ReturnValue(1)
            }
        }
        Deallocate(dsn, 32)
        // user Points (pattern anchors)
        best = snap2
        bx = wx
        by = wy
        hit = 0
        nup = CAD_Sketch.GetUserPointCount(CadApp.sketch)
        IfCondition GreaterThan(nup, 0) ThenBlock: {
            upxy = Allocate(32)
            ui = 0
            WhileLoop LessThan(ui, nup) {
                CAD_Sketch.GetUserPoint(CadApp.sketch, ui, upxy)
                ax = ArrayGet(upxy, 0)
                ay = ArrayGet(upxy, 1)
                dx = Float_Sub(wx, ax)
                dy = Float_Sub(wy, ay)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    bx = ax
                    by = ay
                    hit = 1
                }
                ui = Add(ui, 1)
            }
            Deallocate(upxy, 32)
        }
        nl = CAD_Sketch.GetLineCount(CadApp.sketch)
        IfCondition LessThan(nl, 1) ThenBlock: {
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ArraySet(out_xy, 0, bx)
                ArraySet(out_xy, 1, by)
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        lines = CAD_Store.Read(CadApp.sketch, 1)
        i = 0
        WhileLoop LessThan(i, nl) {
            b = Multiply(i, 4)
            // endpoint A
            ax = ArrayGet(lines, b)
            ay = ArrayGet(lines, Add(b, 1))
            // skip if this is current segment start (would zero-length)
            skip = 0
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(ax, CadApp.cx0, 0), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(ay, CadApp.cy0, 0), 1) ThenBlock: {
                        skip = 1
                    }
                }
            }
            IfCondition EqualTo(skip, 0) ThenBlock: {
                dx = Float_Sub(wx, ax)
                dy = Float_Sub(wy, ay)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    bx = ax
                    by = ay
                    hit = 1
                }
            }
            // endpoint B
            ax = ArrayGet(lines, Add(b, 2))
            ay = ArrayGet(lines, Add(b, 3))
            skip = 0
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(ax, CadApp.cx0, 0), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(ay, CadApp.cy0, 0), 1) ThenBlock: {
                        skip = 1
                    }
                }
            }
            IfCondition EqualTo(skip, 0) ThenBlock: {
                dx = Float_Sub(wx, ax)
                dy = Float_Sub(wy, ay)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    bx = ax
                    by = ay
                    hit = 1
                }
            }
            i = Add(i, 1)
        }
        // snap onto circle rim (so box attaches to circle for pad merge)
        nc = CAD_Sketch.GetCircleCount(CadApp.sketch)
        IfCondition GreaterThan(nc, 0) ThenBlock: {
            circs = CAD_Store.Read(CadApp.sketch, 8)
            ci = 0
            WhileLoop LessThan(ci, nc) {
                base = Multiply(ci, 3)
                cx = ArrayGet(circs, base)
                cy = ArrayGet(circs, Add(base, 1))
                rad = ArrayGet(circs, Add(base, 2))
                dx = Float_Sub(wx, cx)
                dy = Float_Sub(wy, cy)
                d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                IfCondition EqualTo(CAD_Num.IsZero(d, 0), 0) ThenBlock: {
                    // distance to rim
                    dd = Float_Sub(d, rad)
                    IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
                    // within ~14 px of rim
                    IfCondition EqualTo(Float_Le(dd, snap), 1) ThenBlock: {
                        // project onto circle
                        px = Float_Add(cx, Float_Mul(rad, Float_Div(dx, d)))
                        py = Float_Add(cy, Float_Mul(rad, Float_Div(dy, d)))
                        // use if closer than current best endpoint snap
                        dx2 = Float_Sub(wx, px)
                        dy2 = Float_Sub(wy, py)
                        d2 = Float_Add(Float_Mul(dx2, dx2), Float_Mul(dy2, dy2))
                        IfCondition EqualTo(hit, 0) ThenBlock: {
                            best = d2
                            bx = px
                            by = py
                            hit = 1
                        }
                        IfCondition EqualTo(hit, 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                                best = d2
                                bx = px
                                by = py
                            }
                        }
                    }
                }
                ci = Add(ci, 1)
            }
        }
        IfCondition EqualTo(hit, 1) ThenBlock: {
            // refuse snap that collapses current segment to ~zero
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                dx = Float_Sub(bx, CadApp.cx0)
                dy = Float_Sub(by, CadApp.cy0)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, minlen2), 1) ThenBlock: {
                    IfCondition LessThan(nl, 3) ThenBlock: {
                        ReturnValue(0)
                    }
                }
            }
            ArraySet(out_xy, 0, bx)
            ArraySet(out_xy, 1, by)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Weld all line endpoints that fall within snap radius so BuildClosedLoop can chain.


Function.CA_TrimAt {
    Input: wx: Integer
    Input: wy: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: trim no sketch\n", 24)
            ReturnValue(0)
        }
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: { sc = 0x3FF0000000000000 }
        // hit within ~16 screen pixels → world (easier curve pick at crosses)
        hit_lim = Float_Div(Float_FromInt(16), sc)
        // kernel owns join storage + split/delete
        rc = CAD_Sketch.TrimAt(CadApp.sketch, wx, wy, hit_lim)
        // always dump integer dbg (why/kind/nt/…)
        CA_LogTrimDbg()
        IfCondition EqualTo(rc, 0) ThenBlock: {
            CA_Log("cad_app: trim miss\n", 19)
            ReturnValue(0)
        }
        IfCondition EqualTo(rc, 7) ThenBlock: {
            CA_Log("cad_app: trim miss after split\n", 31)
            ReturnValue(0)
        }
        CadApp.dirty = 1
        CA_InvalidateProfiles()
        IfCondition EqualTo(rc, 1) ThenBlock: {
            CA_Log("cad_app: trimmed line stub\n", 27)
        }
        IfCondition EqualTo(rc, 2) ThenBlock: {
            CA_Log("cad_app: trimmed full circle\n", 29)
        }
        IfCondition EqualTo(rc, 3) ThenBlock: {
            CA_Log("cad_app: trimmed circle-arcs\n", 29)
        }
        IfCondition EqualTo(rc, 4) ThenBlock: {
            CA_Log("cad_app: trimmed arc\n", 21)
        }
        IfCondition EqualTo(rc, 5) ThenBlock: {
            CA_Log("cad_app: trimmed whole arc (tip-to-tip)\n", 40)
        }
        IfCondition EqualTo(rc, 6) ThenBlock: {
            CA_Log("cad_app: trimmed line stub (at arc tip)\n", 40)
        }
        IfCondition EqualTo(rc, 8) ThenBlock: {
            CA_Log("cad_app: arc trim restore (no piece)\n", 37)
        }
        CA_HistPush(7)
        ReturnValue(1)
    }
}


// Hit-test sketch entity near (wx,wy). out_ki[0]=kind out_ki[1]=id.
// kind: 0 line-end (line*2+end)  4 circle  2 whole-line  3 user Point
// Phased: (1) points/ends/centers only  (2) circle rims  (3) line body last.
// Returns 1 hit, 0 miss.



// Hit-test sketch entity near (wx,wy). out_ki[0]=kind out_ki[1]=id.
// kind: 0 line-end (line*2+end)  4 circle  2 whole-line  3 user Point
// Phased: (1) points/ends/centers only  (2) circle rims  (3) line body last.
// Returns 1 hit, 0 miss.
Function.CA_HitEntity {
    Input: wx: Integer
    Input: wy: Integer
    Input: out_ki: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
            sc = 0x3FF0000000000000
        }
        // generous for ends/points so FixO works without pixel-perfect clicks
        snap_pt = Float_Div(Float_FromInt(16), sc)
        snap2 = Float_Mul(snap_pt, snap_pt)
        snap_rim = Float_Div(Float_FromInt(14), sc)
        best = snap2
        hit = 0
        bk = 0
        bi = 0
        sk = CadApp.sketch
        nl = CAD_Sketch.GetLineCount(sk)
        nc = CAD_Sketch.GetCircleCount(sk)
        // --- phase 1: discrete points only (no line body) ---
        nup = CAD_Sketch.GetUserPointCount(sk)
        IfCondition GreaterThan(nup, 0) ThenBlock: {
            xy = Allocate(32)
            ui = 0
            WhileLoop LessThan(ui, nup) {
                CAD_Sketch.GetUserPoint(sk, ui, xy)
                dx = Float_Sub(wx, ArrayGet(xy, 0))
                dy = Float_Sub(wy, ArrayGet(xy, 1))
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    hit = 1
                    bk = 3
                    bi = ui
                }
                ui = Add(ui, 1)
            }
            Deallocate(xy, 32)
        }
        IfCondition GreaterThan(nl, 0) ThenBlock: {
            lines = CAD_Store.Read(sk, 1)
            i = 0
            WhileLoop LessThan(i, nl) {
                b = Multiply(i, 4)
                e = 0
                WhileLoop LessThan(e, 2) {
                    IfCondition EqualTo(e, 0) ThenBlock: {
                        ax = ArrayGet(lines, b)
                        ay = ArrayGet(lines, Add(b, 1))
                    }
                    IfCondition EqualTo(e, 1) ThenBlock: {
                        ax = ArrayGet(lines, Add(b, 2))
                        ay = ArrayGet(lines, Add(b, 3))
                    }
                    dx = Float_Sub(wx, ax)
                    dy = Float_Sub(wy, ay)
                    d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                        best = d2
                        hit = 1
                        bk = 0
                        bi = Add(Multiply(i, 2), e)
                    }
                    e = Add(e, 1)
                }
                i = Add(i, 1)
            }
        }
        IfCondition GreaterThan(nc, 0) ThenBlock: {
            circs = CAD_Store.Read(sk, 8)
            ci = 0
            WhileLoop LessThan(ci, nc) {
                base = Multiply(ci, 3)
                cx = ArrayGet(circs, base)
                cy = ArrayGet(circs, Add(base, 1))
                dx = Float_Sub(wx, cx)
                dy = Float_Sub(wy, cy)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    hit = 1
                    bk = 4
                    bi = ci
                }
                ci = Add(ci, 1)
            }
        }
        // --- phase 2: circle rims only if nothing discrete hit ---
        IfCondition EqualTo(hit, 0) ThenBlock: {
            IfCondition GreaterThan(nc, 0) ThenBlock: {
                circs = CAD_Store.Read(sk, 8)
                best = Float_Mul(snap_rim, snap_rim)
                ci = 0
                WhileLoop LessThan(ci, nc) {
                    base = Multiply(ci, 3)
                    cx = ArrayGet(circs, base)
                    cy = ArrayGet(circs, Add(base, 1))
                    rad = ArrayGet(circs, Add(base, 2))
                    dx = Float_Sub(wx, cx)
                    dy = Float_Sub(wy, cy)
                    d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                    dd = Float_Sub(d, rad)
                    IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
                    IfCondition EqualTo(Float_Le(dd, snap_rim), 1) ThenBlock: {
                        d2r = Float_Mul(dd, dd)
                        IfCondition EqualTo(Float_Le(d2r, best), 1) ThenBlock: {
                            best = d2r
                            hit = 1
                            bk = 4
                            bi = ci
                        }
                    }
                    ci = Add(ci, 1)
                }
            }
        }
        // --- phase 3: whole line body (H/V/OnLn only really want this) ---
        IfCondition EqualTo(hit, 0) ThenBlock: {
            IfCondition GreaterThan(nl, 0) ThenBlock: {
                lines = CAD_Store.Read(sk, 1)
                best = Float_Mul(snap_rim, snap_rim)
                i = 0
                WhileLoop LessThan(i, nl) {
                    b = Multiply(i, 4)
                    x0 = ArrayGet(lines, b)
                    y0 = ArrayGet(lines, Add(b, 1))
                    x1 = ArrayGet(lines, Add(b, 2))
                    y1 = ArrayGet(lines, Add(b, 3))
                    dx = Float_Sub(x1, x0)
                    dy = Float_Sub(y1, y0)
                    aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                        t = Float_Div(Float_Add(Float_Mul(Float_Sub(wx, x0), dx), Float_Mul(Float_Sub(wy, y0), dy)), aa)
                        IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: { t = 0 }
                        IfCondition EqualTo(Float_Le(0x3FF0000000000000, t), 1) ThenBlock: { t = 0x3FF0000000000000 }
                        px = Float_Add(x0, Float_Mul(t, dx))
                        py = Float_Add(y0, Float_Mul(t, dy))
                        ddx = Float_Sub(wx, px)
                        ddy = Float_Sub(wy, py)
                        d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                        IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                            best = d2
                            hit = 1
                            bk = 2
                            bi = i
                        }
                    }
                    i = Add(i, 1)
                }
            }
        }
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ArraySet(out_ki, 0, bk)
            ArraySet(out_ki, 1, bi)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Pixel-space pick of a sketch line (works in 3D overlay and sketch view).
Function.CA_PickSketchLineAtPx {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        nl = CAD_Sketch.GetLineCount(CadApp.sketch)
        IfCondition LessThan(nl, 1) ThenBlock: { ReturnValue(-1) }
        lines = CAD_Store.Read(CadApp.sketch, 1)
        vframe = Allocate(64)
        CA_BuildViewFrame(vframe)
        skpl = CAD_Sketch.GetPlaneId(CadApp.sketch)
        IfCondition EqualTo(skpl, 0) ThenBlock: { skpl = CadApp.plane }
        pxyz = Allocate(32)
        a = Allocate(32)
        b = Allocate(32)
        best = 144
        hit = -1
        li = 0
        WhileLoop LessThan(li, nl) {
            base = Multiply(li, 4)
            u0 = ArrayGet(lines, base)
            v0 = ArrayGet(lines, Add(base, 1))
            u1 = ArrayGet(lines, Add(base, 2))
            v1 = ArrayGet(lines, Add(base, 3))
            IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
                CA_WorldToPix(u0, v0, a)
                CA_WorldToPix(u1, v1, b)
            }
            IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
                IfCondition NotEqual(skpl, 0) ThenBlock: {
                    CAD_Plane.MapLocal(skpl, u0, v0, 0, pxyz)
                    CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
                    CAD_Plane.MapLocal(skpl, u1, v1, 0, pxyz)
                    CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
                }
                IfCondition EqualTo(skpl, 0) ThenBlock: {
                    CA_World3ToPix(u0, v0, 0, vframe, a)
                    CA_World3ToPix(u1, v1, 0, vframe, b)
                }
            }
            ax = ArrayGet(a, 0)
            ay = ArrayGet(a, 1)
            bx = ArrayGet(b, 0)
            by = ArrayGet(b, 1)
            dx = Subtract(bx, ax)
            dy = Subtract(by, ay)
            aa = Add(Multiply(dx, dx), Multiply(dy, dy))
            IfCondition GreaterThan(aa, 0) ThenBlock: {
                tnum = Add(Multiply(Subtract(px, ax), dx), Multiply(Subtract(py, ay), dy))
                // t in 0..1 as integer ratio — clamp
                IfCondition LessThan(tnum, 0) ThenBlock: { tnum = 0 }
                IfCondition GreaterThan(tnum, aa) ThenBlock: { tnum = aa }
                qx = Add(ax, Divide(Multiply(tnum, dx), aa))
                qy = Add(ay, Divide(Multiply(tnum, dy), aa))
                ddx = Subtract(px, qx)
                ddy = Subtract(py, qy)
                d2 = Add(Multiply(ddx, ddx), Multiply(ddy, ddy))
                IfCondition LessThan(d2, best) ThenBlock: {
                    best = d2
                    hit = li
                }
            }
            li = Add(li, 1)
        }
        Deallocate(pxyz, 32)
        Deallocate(a, 32)
        Deallocate(b, 32)
        Deallocate(vframe, 64)
        ReturnValue(hit)
    }
}

// If hit is whole-line, retarget to nearest endpoint (for FixO / DistO / Coin).


// If hit is whole-line, retarget to nearest endpoint (for FixO / DistO / Coin).
Function.CA_HitAsPoint {
    Input: wx: Integer
    Input: wy: Integer
    Input: kind: Integer
    Input: id: Integer
    Input: out_ki: Address
    Output: Integer
    Body: {
        ArraySet(out_ki, 0, kind)
        ArraySet(out_ki, 1, id)
        IfCondition NotEqual(kind, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        lines = CAD_Store.Read(CadApp.sketch, 1)
        nl = CAD_Sketch.GetLineCount(CadApp.sketch)
        IfCondition GreaterEqual(id, nl) ThenBlock: { ReturnValue(-1) }
        b = Multiply(id, 4)
        x0 = ArrayGet(lines, b)
        y0 = ArrayGet(lines, Add(b, 1))
        x1 = ArrayGet(lines, Add(b, 2))
        y1 = ArrayGet(lines, Add(b, 3))
        d0 = Float_Add(Float_Mul(Float_Sub(wx, x0), Float_Sub(wx, x0)), Float_Mul(Float_Sub(wy, y0), Float_Sub(wy, y0)))
        d1 = Float_Add(Float_Mul(Float_Sub(wx, x1), Float_Sub(wx, x1)), Float_Mul(Float_Sub(wy, y1), Float_Sub(wy, y1)))
        IfCondition EqualTo(Float_Le(d0, d1), 1) ThenBlock: {
            ArraySet(out_ki, 0, 0)
            ArraySet(out_ki, 1, Multiply(id, 2))
        }
        IfCondition EqualTo(Float_Le(d0, d1), 0) ThenBlock: {
            ArraySet(out_ki, 0, 0)
            ArraySet(out_ki, 1, Add(Multiply(id, 2), 1))
        }
        ReturnValue(1)
    }
}

// Enter constraint tool. ctype = constraint type code (1 FixO, 6 DistO, 7 H, …).


// Enter constraint tool. ctype = constraint type code (1 FixO, 6 DistO, 7 H, …).
Function.CA_BeginConstraint {
    Input: ctype: Integer
    Output: Integer
    Body: {
        CadApp.mode = 1
        CadApp.tool = 7
        CadApp.cstr_type = ctype
        CadApp.cstr_npick = 0
        CadApp.nclick = 0
        CadApp.hover_ok = 0
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
        }
        CA_HudClose()
        CadApp.cstr_val = 0
        CadApp.cstr_rval = 0
        CadApp.cstr_ready = 0
        CadApp.last_cstr = -1
        IfCondition EqualTo(ctype, 20) ThenBlock: {
            CadApp.cstr_ready = 1
            CadApp.cstr_u = 0
            CadApp.cstr_v = 0
            CadApp.hud_field = 0
        }
        CA_HudOpenCstr()
        ReturnValue(0)
    }
}

// Run solve + invalidate after adding a constraint.


// Run solve + invalidate after adding a constraint.
Function.CA_SolveNow {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        napp = CAD_Sketch.SolveConstraints(CadApp.sketch)
        CAD_Sketch.RebuildAnchors(CadApp.sketch)
        CA_InvalidateProfiles()
        CadApp.dirty = 1
        CA_LogInt("cad_app: constraint solve hits=", 31, napp)
        ReturnValue(napp)
    }
}

// Constraint click: pick 1 or 2 entities then add + solve.
// cstr_type: 1 FixO  6 DistO(lock)  7 H  8 V  9 Coin  10 OnLine
//           11 Rad(lock)  12 EqR  13 Tang  15 Dist(lock)


// Constraint click: pick 1 or 2 entities then add + solve.
// cstr_type: 1 FixO  6 DistO(lock)  7 H  8 V  9 Coin  10 OnLine
//           11 Rad(lock)  12 EqR  13 Tang  15 Dist(lock)
Function.CA_ConstraintClick {
    Input: wx: Integer
    Input: wy: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        ki = Allocate(32)
        IfCondition EqualTo(CA_HitEntity(wx, wy, ki), 0) ThenBlock: {
            li = CA_PickSketchLineAtPx(CadApp.hover_px, CadApp.hover_py)
            IfCondition LessThan(li, 0) ThenBlock: {
                CA_Log("cad_app: miss - click point/end/circle/line\n", 44)
                Deallocate(ki, 32)
                ReturnValue(0)
            }
            ArraySet(ki, 0, 2)
            ArraySet(ki, 1, li)
        }
        hk = ArrayGet(ki, 0)
        hi = ArrayGet(ki, 1)
        ct = CadApp.cstr_type
        // Point tools: whole-line hit -> nearest endpoint
        IfCondition EqualTo(ct, 1) ThenBlock: {
            CA_HitAsPoint(wx, wy, hk, hi, ki)
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
        }
        IfCondition EqualTo(ct, 2) ThenBlock: {
            CA_HitAsPoint(wx, wy, hk, hi, ki)
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
        }
        IfCondition EqualTo(ct, 3) ThenBlock: {
            CA_HitAsPoint(wx, wy, hk, hi, ki)
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
        }
        IfCondition EqualTo(ct, 6) ThenBlock: {
            CA_HitAsPoint(wx, wy, hk, hi, ki)
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
        }
        IfCondition EqualTo(ct, 9) ThenBlock: {
            CA_HitAsPoint(wx, wy, hk, hi, ki)
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
        }
        IfCondition EqualTo(ct, 15) ThenBlock: {
            CA_HitAsPoint(wx, wy, hk, hi, ki)
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
        }
        Deallocate(ki, 32)
        // --- single-pick types ---
        // FixOrigin
        IfCondition EqualTo(ct, 1) ThenBlock: {
            IfCondition EqualTo(hk, 2) ThenBlock: {
                CA_Log("cad_app: FixO needs point or line end\n", 38)
                ReturnValue(0)
            }
            IfCondition EqualTo(hk, 4) ThenBlock: {
                // circle center is ok (kind 4 center move)
                CAD_Sketch.AddConstraint(CadApp.sketch, 1, 4, hi, 0)
            }
            IfCondition NotEqual(hk, 4) ThenBlock: {
                CAD_Sketch.AddConstraint(CadApp.sketch, 1, hk, hi, 0)
            }
            CadApp.cstr_npick = 0
            CA_SolveNow()
            CA_CstrRemember()
            CA_HudClose()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // FixX / FixY — lock current X or Y on this sketch plane
        IfCondition EqualTo(ct, 2) ThenBlock: {
            IfCondition EqualTo(hk, 2) ThenBlock: {
                CA_Log("cad_app: FixX needs point or end\n", 33)
                ReturnValue(0)
            }
            xy = Allocate(32)
            tk = hk
            IfCondition EqualTo(hk, 4) ThenBlock: { tk = 4 }
            CAD_Sketch.GetTargetXY(CadApp.sketch, tk, hi, xy)
            uu = ArrayGet(xy, 0)
            Deallocate(xy, 32)
            CadApp.cstr_ka = tk
            CadApp.cstr_ia = hi
            CadApp.cstr_rval = uu
            CadApp.cstr_val = Float_ToInt(uu)
            CadApp.cstr_ready = 1
            CadApp.last_cstr = -1
            CA_HudOpenCstr()
            CA_PublishFrame()
            ReturnValue(1)
        }
        IfCondition EqualTo(ct, 3) ThenBlock: {
            IfCondition EqualTo(hk, 2) ThenBlock: {
                CA_Log("cad_app: FixY needs point or end\n", 33)
                ReturnValue(0)
            }
            xy = Allocate(32)
            tk = hk
            IfCondition EqualTo(hk, 4) ThenBlock: { tk = 4 }
            CAD_Sketch.GetTargetXY(CadApp.sketch, tk, hi, xy)
            vv = ArrayGet(xy, 1)
            Deallocate(xy, 32)
            CadApp.cstr_ka = tk
            CadApp.cstr_ia = hi
            CadApp.cstr_rval = vv
            CadApp.cstr_val = Float_ToInt(vv)
            CadApp.cstr_ready = 1
            CadApp.last_cstr = -1
            CA_HudOpenCstr()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // Horizontal / Vertical on a line
        IfCondition EqualTo(ct, 7) ThenBlock: {
            li = hi
            ok = 0
            IfCondition EqualTo(hk, 0) ThenBlock: {
                li = Divide(hi, 2)
                ok = 1
            }
            IfCondition EqualTo(hk, 2) ThenBlock: {
                li = hi
                ok = 1
            }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                CAD_Sketch.AddConstraint(CadApp.sketch, 7, 2, li, 0)
                CadApp.cstr_npick = 0
                CA_SolveNow()
                CA_CstrRemember()
                CA_HudClose()
                CA_PublishFrame()
                ReturnValue(1)
            }
            CA_Log("cad_app: H needs a line\n", 24)
            ReturnValue(0)
        }
        IfCondition EqualTo(ct, 8) ThenBlock: {
            li = hi
            ok = 0
            IfCondition EqualTo(hk, 0) ThenBlock: {
                li = Divide(hi, 2)
                ok = 1
            }
            IfCondition EqualTo(hk, 2) ThenBlock: {
                li = hi
                ok = 1
            }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                CAD_Sketch.AddConstraint(CadApp.sketch, 8, 2, li, 0)
                CadApp.cstr_npick = 0
                CA_SolveNow()
                CA_CstrRemember()
                CA_HudClose()
                CA_PublishFrame()
                ReturnValue(1)
            }
            CA_Log("cad_app: V needs a line\n", 24)
            ReturnValue(0)
        }
        // DistToOrigin lock current |p|
        IfCondition EqualTo(ct, 6) ThenBlock: {
            IfCondition EqualTo(hk, 2) ThenBlock: {
                CA_Log("cad_app: DistO needs a point or end\n", 36)
                ReturnValue(0)
            }
            xy = Allocate(32)
            tk = hk
            IfCondition EqualTo(hk, 4) ThenBlock: { tk = 4 }
            CAD_Sketch.GetTargetXY(CadApp.sketch, tk, hi, xy)
            px = ArrayGet(xy, 0)
            py = ArrayGet(xy, 1)
            Deallocate(xy, 32)
            d = CAD_Num.Sqrt(Float_Add(Float_Mul(px, px), Float_Mul(py, py)))
            CadApp.cstr_ka = tk
            CadApp.cstr_ia = hi
            CadApp.cstr_rval = d
            CadApp.cstr_val = Float_ToInt(d)
            CadApp.cstr_ready = 1
            CadApp.last_cstr = -1
            CA_HudOpenCstr()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // Radius lock current r - click rim or center
        IfCondition EqualTo(ct, 11) ThenBlock: {
            IfCondition NotEqual(hk, 4) ThenBlock: {
                CA_Log("cad_app: Rad - click circle rim or center\n", 42)
                ReturnValue(0)
            }
            ci = hi
            r = CAD_Sketch.GetCircleRadius(CadApp.sketch, ci)
            CadApp.cstr_ka = 4
            CadApp.cstr_ia = ci
            CadApp.cstr_rval = r
            CadApp.cstr_val = Float_ToInt(r)
            CadApp.cstr_ready = 1
            CadApp.last_cstr = -1
            CA_HudOpenCstr()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // --- two-pick types ---
        IfCondition EqualTo(CadApp.cstr_npick, 0) ThenBlock: {
            CadApp.cstr_ka = hk
            CadApp.cstr_ia = hi
            CadApp.cstr_npick = 1
            CA_Log("cad_app: constraint pick 1/2\n", 29)
            CA_PublishFrame()
            ReturnValue(1)
        }
        // second pick
        CadApp.cstr_kb = hk
        CadApp.cstr_ib = hi
        CadApp.cstr_npick = 0
        ka = CadApp.cstr_ka
        ia = CadApp.cstr_ia
        kb = CadApp.cstr_kb
        ib = CadApp.cstr_ib
        // Coincident
        IfCondition EqualTo(ct, 9) ThenBlock: {
            CAD_Sketch.AddConstraint2(CadApp.sketch, 9, ka, ia, kb, ib)
            CA_SolveNow()
            CA_CstrRemember()
            CA_HudClose()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // PointOnLine — A point, B line
        IfCondition EqualTo(ct, 10) ThenBlock: {
            // ensure B is whole line
            IfCondition EqualTo(kb, 0) ThenBlock: {
                ib = Divide(ib, 2)
                kb = 2
            }
            IfCondition EqualTo(ka, 2) ThenBlock: {
                // swap if first was line
                t = ka
                ka = kb
                kb = t
                t = ia
                ia = ib
                ib = t
                IfCondition EqualTo(kb, 0) ThenBlock: {
                    ib = Divide(ib, 2)
                    kb = 2
                }
            }
            CAD_Sketch.AddConstraint2(CadApp.sketch, 10, ka, ia, kb, ib)
            CA_SolveNow()
            CA_CstrRemember()
            CA_HudClose()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // EqualRadius
        IfCondition EqualTo(ct, 12) ThenBlock: {
            CAD_Sketch.AddConstraint2(CadApp.sketch, 12, 4, ia, 4, ib)
            CA_SolveNow()
            CA_CstrRemember()
            CA_HudClose()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // Tangent line-circle or circle-circle
        IfCondition EqualTo(ct, 13) ThenBlock: {
            // normalize: line as A kind 2, circle as B kind 4 — or two circles type 14
            la = 0
            ca = 0
            lb = 0
            cb = 0
            IfCondition EqualTo(ka, 2) ThenBlock: { la = 1 }
            IfCondition EqualTo(ka, 0) ThenBlock: {
                la = 1
                ia = Divide(ia, 2)
                ka = 2
            }
            IfCondition EqualTo(ka, 4) ThenBlock: { ca = 1 }
            IfCondition EqualTo(ka, 1) ThenBlock: {
                ca = 1
                ka = 4
            }
            IfCondition EqualTo(kb, 2) ThenBlock: { lb = 1 }
            IfCondition EqualTo(kb, 0) ThenBlock: {
                lb = 1
                ib = Divide(ib, 2)
                kb = 2
            }
            IfCondition EqualTo(kb, 4) ThenBlock: { cb = 1 }
            IfCondition EqualTo(kb, 1) ThenBlock: {
                cb = 1
                kb = 4
            }
            IfCondition EqualTo(ca, 1) ThenBlock: {
                IfCondition EqualTo(cb, 1) ThenBlock: {
                    CAD_Sketch.AddConstraint2(CadApp.sketch, 14, 4, ia, 4, ib)
                    CA_SolveNow()
                    CA_CstrRemember()
                    CA_HudClose()
                    CA_PublishFrame()
                    ReturnValue(1)
                }
            }
            // line + circle
            IfCondition EqualTo(la, 1) ThenBlock: {
                IfCondition EqualTo(cb, 1) ThenBlock: {
                    CAD_Sketch.AddConstraint2(CadApp.sketch, 13, 2, ia, 4, ib)
                    CA_SolveNow()
                    CA_CstrRemember()
                    CA_HudClose()
                    CA_PublishFrame()
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(lb, 1) ThenBlock: {
                IfCondition EqualTo(ca, 1) ThenBlock: {
                    CAD_Sketch.AddConstraint2(CadApp.sketch, 13, 2, ib, 4, ia)
                    CA_SolveNow()
                    CA_CstrRemember()
                    CA_HudClose()
                    CA_PublishFrame()
                    ReturnValue(1)
                }
            }
            CA_Log("cad_app: Tang needs line+circle or 2 circles\n", 45)
            ReturnValue(0)
        }
        // DistPoints lock current distance
        IfCondition EqualTo(ct, 15) ThenBlock: {
            xy = Allocate(32)
            xy2 = Allocate(32)
            CAD_Sketch.GetTargetXY(CadApp.sketch, ka, ia, xy)
            CAD_Sketch.GetTargetXY(CadApp.sketch, kb, ib, xy2)
            dx = Float_Sub(ArrayGet(xy2, 0), ArrayGet(xy, 0))
            dy = Float_Sub(ArrayGet(xy2, 1), ArrayGet(xy, 1))
            d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
            Deallocate(xy, 32)
            Deallocate(xy2, 32)
            CadApp.cstr_rval = d
            CadApp.cstr_val = Float_ToInt(d)
            CadApp.cstr_ready = 1
            CadApp.last_cstr = -1
            CA_HudOpenCstr()
            CA_PublishFrame()
            ReturnValue(1)
        }
        CA_Log("cad_app: unknown constraint type\n", 33)
        ReturnValue(0)
    }
}

// Click: sketch tools in sketch mode; nav cube in 3D mode
// Pick/Trim force sketch mode so 3D mode does not swallow selection clicks.


// Click: sketch tools in sketch mode; nav cube in 3D mode
// Pick/Trim force sketch mode so 3D mode does not swallow selection clicks.
Function.CA_OnClick {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        CA_LogInt("cad_app: click tool=", 20, CadApp.tool)
        CA_LogInt("cad_app: click mode=", 20, CadApp.mode)
        CA_LogInt("cad_app: click px=", 18, px)
        CA_LogInt("cad_app: click py=", 18, py)
        // Construction-plane gestures win over sketch tools / On Face.
        IfCondition NotEqual(CadApp.plane_pick, 0) ThenBlock: {
            CA_PlanePickClick(px, py)
            CadApp.click_shift = 0
            CA_PublishFrame()
            ReturnValue(0)
        }
        // Sketch-on-face wins over Pick/Trim/Line — those used to yank us back to Sketch_0.
        IfCondition EqualTo(CadApp.face_pick, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                // Shift+click: next face along the ray (go back down the stack).
                IfCondition NotEqual(CadApp.click_shift, 0) ThenBlock: {
                    CadApp.hover_face = CA_PickFaceNext(px, py, CadApp.hover_face)
                    CadApp.click_shift = 0
                    CA_Log("cad_app: face cycle (shift=deeper along ray)\n", 45)
                    CA_PublishFrame()
                    ReturnValue(0)
                }
                // Commit the highlighted face (what you see), not a re-pick.
                fh = CadApp.hover_face
                IfCondition EqualTo(fh, 0) ThenBlock: {
                    fh = CA_PickFaceAt(px, py)
                }
                IfCondition EqualTo(fh, 0) ThenBlock: {
                    CA_Log("cad_app: face miss - orbit and click the solid\n", 47)
                    CA_PublishFrame()
                    ReturnValue(0)
                }
                CA_SketchOnFace(fh)
                CA_PublishFrame()
                ReturnValue(0)
            }
        }
        // Constraint pick (tool 7) — always sketch
        IfCondition EqualTo(CadApp.tool, 7) ThenBlock: {
            CadApp.mode = 1
            IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                CadApp.sketch = CAD_Sketch.CreateSketch(1)
            }
            xy = Allocate(32)
            CA_PixToWorld(px, py, xy)
            // no snap weld — hit raw for selection
            CA_ConstraintClick(ArrayGet(xy, 0), ArrayGet(xy, 1))
            Deallocate(xy, 32)
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            ReturnValue(0)
        }
        // Chamfer (tool 10): 3D pick set, apply via chamfer D
        IfCondition EqualTo(CadApp.tool, 10) ThenBlock: {
            IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                    eh = CA_PickSolidEdgeAtPx(px, py)
                    IfCondition EqualTo(eh, 0) ThenBlock: {
                        CA_Log("cad_app: 3D chamfer miss - click a vertical or long edge\n", 56)
                        CadApp.mode = 0
                        CA_PublishFrame()
                        ReturnValue(0)
                    }
                    ns = CA_AddEdgeSel(eh)
                    CadApp.nclick = ns
                    CadApp.mode = 0
                    PrintMessage("cad_app: 3D chamfer sel n=")
                    PrintNumber(ns)
                    PrintMessage("\n")
                    CA_HudOpenChamfer()
                    CA_Log("cad_app: 3D chamfer - pick more, type D, Enter\n", 47)
                    CA_PublishFrame()
                    ReturnValue(0)
                }
            }
            CA_Log("cad_app: chamfer is a 3D body tool\n", 35)
            ReturnValue(0)
        }
        // Fillet (tool 8):
        //   3D (mode=0 + solid): click1 pick edge, click2 apply R
        //   sketch: pick two lines, apply CadApp.fillet_r
        IfCondition EqualTo(CadApp.tool, 8) ThenBlock: {
            IfCondition EqualTo(CadApp.fillet_r, 0) ThenBlock: {
                CadApp.fillet_r = 0x4000000000000000
            }
            // --- 3D solid edge fillet ---
            IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                    // Each click ADDS (toggle) an edge. Apply once via fillet R.
                    // Applying adjacent edges one-by-one wrecks corners.
                    eh = CA_PickSolidEdgeAtPx(px, py)
                    IfCondition EqualTo(eh, 0) ThenBlock: {
                        CA_Log("cad_app: 3D fillet miss - click a vertical or long edge\n", 55)
                        CadApp.mode = 0
                        CA_PublishFrame()
                        ReturnValue(0)
                    }
                    ns = CA_AddEdgeSel(eh)
                    CadApp.nclick = ns
                    CadApp.mode = 0
                    PrintMessage("cad_app: 3D fillet sel n=")
                    PrintNumber(ns)
                    PrintMessage(" last=")
                    PrintNumber(eh)
                    el = CA_SolidEdgeLen(eh)
                    dz = 0
                    IfCondition NotEqual(eh, 0) ThenBlock: {
                        va = CAD_Store.Read(eh, 0)
                        vb = CAD_Store.Read(eh, 1)
                        IfCondition NotEqual(va, 0) ThenBlock: {
                            dz = Float_Sub(CAD_Store.Read(vb, 2), CAD_Store.Read(va, 2))
                            IfCondition EqualTo(CAD_Num.IsNeg(dz), 1) ThenBlock: { dz = Float_Sub(0, dz) }
                        }
                    }
                    PrintMessage(" |dZ|=")
                    PrintNumber(Float_ToInt(dz))
                    PrintMessage(" (pick more, type R, Enter)\n")
                    CA_HudOpenFillet3d()
                    CA_Log("cad_app: 3D fillet - pick more, type R, Enter\n", 47)
                    CA_PublishFrame()
                    ReturnValue(0)
                }
            }
            // --- sketch 2D fillet ---
            CadApp.mode = 1
            IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                CadApp.sketch = CAD_Sketch.CreateSketch(1)
            }
            xy = Allocate(32)
            CA_PixToWorld(px, py, xy)
            wx = ArrayGet(xy, 0)
            wy = ArrayGet(xy, 1)
            Deallocate(xy, 32)
            ki = Allocate(32)
            IfCondition EqualTo(CA_HitEntity(wx, wy, ki), 0) ThenBlock: {
                CA_Log("cad_app: fillet miss - click a line\n", 36)
                Deallocate(ki, 32)
                ReturnValue(0)
            }
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
            Deallocate(ki, 32)
            li = hi
            ok = 0
            IfCondition EqualTo(hk, 2) ThenBlock: {
                li = hi
                ok = 1
            }
            IfCondition EqualTo(hk, 0) ThenBlock: {
                li = Divide(hi, 2)
                ok = 1
            }
            IfCondition EqualTo(ok, 0) ThenBlock: {
                CA_Log("cad_app: fillet needs a line\n", 29)
                ReturnValue(0)
            }
            IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: {
                CadApp.fillet_li = li
                CadApp.nclick = 1
                CA_Log("cad_app: fillet pick 1/2\n", 25)
                CA_PublishFrame()
                ReturnValue(0)
            }
            CadApp.fillet_lj = li
            CA_FilletSnap(CadApp.fillet_li, CadApp.fillet_lj)
            CadApp.nclick = 0
            CA_HudOpenFillet()
            CA_Log("cad_app: fillet corner - type R, Enter\n", 39)
            CA_PublishFrame()
            ReturnValue(0)
        }
        // Revolve axis pick (tool 11): click a sketch line in 3D or sketch view
        IfCondition EqualTo(CadApp.tool, 11) ThenBlock: {
            IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                CA_Log("cad_app: revolve axis - need a sketch\n", 38)
                ReturnValue(0)
            }
            li = CA_PickSketchLineAtPx(px, py)
            IfCondition LessThan(li, 0) ThenBlock: {
                xy = Allocate(32)
                CA_PixToWorld(px, py, xy)
                ki = Allocate(32)
                IfCondition EqualTo(CA_HitEntity(ArrayGet(xy, 0), ArrayGet(xy, 1), ki), 1) ThenBlock: {
                    hk = ArrayGet(ki, 0)
                    hi = ArrayGet(ki, 1)
                    IfCondition EqualTo(hk, 2) ThenBlock: { li = hi }
                    IfCondition EqualTo(hk, 0) ThenBlock: { li = Divide(hi, 2) }
                }
                Deallocate(ki, 32)
                Deallocate(xy, 32)
            }
            IfCondition LessThan(li, 0) ThenBlock: {
                CA_Log("cad_app: revolve axis miss - click a cyan sketch line\n", 54)
                CA_PublishFrame()
                ReturnValue(0)
            }
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            IfCondition GreaterEqual(li, nl) ThenBlock: {
                CA_Log("cad_app: revolve axis bad line\n", 31)
                ReturnValue(0)
            }
            lines = CAD_Store.Read(CadApp.sketch, 1)
            b = Multiply(li, 4)
            CadAppRev.x0 = ArrayGet(lines, b)
            CadAppRev.y0 = ArrayGet(lines, Add(b, 1))
            CadAppRev.x1 = ArrayGet(lines, Add(b, 2))
            CadAppRev.y1 = ArrayGet(lines, Add(b, 3))
            CadAppRev.ok = 1
            CA_LogInt("cad_app: revolve axis line=", 27, li)
            CadApp.nclick = 0
            CA_RevolveFromSketch()
            CA_PublishFrame()
            ReturnValue(0)
        }
        // Pick / Trim always work (switch out of 3D first)
        IfCondition EqualTo(CadApp.tool, 4) ThenBlock: {
            CadApp.mode = 1
            IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                CadApp.sketch = CAD_Sketch.CreateSketch(1)
            }
            // pixel-space hit (matches drawn light-red faces)
            CA_PickProfileAtPx(px, py, CadApp.click_shift)
            CadApp.click_shift = 0
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CA_PublishFrame()
            ReturnValue(0)
        }
        IfCondition EqualTo(CadApp.tool, 5) ThenBlock: {
            CadApp.mode = 1
            IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                CadApp.sketch = CAD_Sketch.CreateSketch(1)
            }
            xy = Allocate(32)
            CA_PixToWorld(px, py, xy)
            CA_TrimAt(ArrayGet(xy, 0), ArrayGet(xy, 1))
            Deallocate(xy, 32)
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CA_PublishFrame()
            ReturnValue(0)
        }
        // 3D: view cube is host chrome (sends viewN / orbit). No FB hit steal.
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
            // OnTop face-pick: click solid planar face → sketch on it
            IfCondition EqualTo(CadApp.face_pick, 1) ThenBlock: {
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                    IfCondition NotEqual(CadApp.click_shift, 0) ThenBlock: {
                        CadApp.hover_face = CA_PickFaceNext(px, py, CadApp.hover_face)
                        CadApp.click_shift = 0
                        CA_PublishFrame()
                        ReturnValue(0)
                    }
                    fh = CadApp.hover_face
                    IfCondition EqualTo(fh, 0) ThenBlock: {
                        fh = CA_PickFaceAt(px, py)
                    }
                    IfCondition EqualTo(fh, 0) ThenBlock: {
                        CA_Log("cad_app: face miss - orbit and click the solid\n", 47)
                        CA_PublishFrame()
                        ReturnValue(0)
                    }
                    CA_SketchOnFace(fh)
                    CA_PublishFrame()
                    ReturnValue(0)
                }
            }
            ReturnValue(0)
        }
        // sketch mode
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
        }
        CAD_Sketch.EnsureDatum(CadApp.sketch)
        xy = Allocate(32)
        CA_PixToWorld(px, py, xy)
        wx = ArrayGet(xy, 0)
        wy = ArrayGet(xy, 1)
        // Arc3 / Circ3: no snap on through/end — snap was jumping end off the preview
        // and rebuilding a different (often exterior) circle on commit.
        do_snap = 1
        IfCondition EqualTo(CadApp.tool, 9) ThenBlock: {
            IfCondition GreaterThan(CadApp.nclick, 0) ThenBlock: { do_snap = 0 }
        }
        IfCondition EqualTo(CadApp.tool, 14) ThenBlock: {
            IfCondition GreaterThan(CadApp.nclick, 0) ThenBlock: { do_snap = 0 }
        }
        IfCondition EqualTo(do_snap, 1) ThenBlock: {
            sn = Allocate(32)
            CA_SnapWorld(wx, wy, sn)
            wx = ArrayGet(sn, 0)
            wy = ArrayGet(sn, 1)
            Deallocate(sn, 32)
        }
        Deallocate(xy, 32)
        // spline: every click is a control point; Finish Spline / done commits
        IfCondition EqualTo(CadApp.tool, 18) ThenBlock: {
            CA_SplineClick(wx, wy)
            CA_PublishFrame()
            ReturnValue(0)
        }
        // tool Point: single click places first-class Point in UV
        IfCondition EqualTo(CadApp.tool, 6) ThenBlock: {
            pi = CAD_Sketch.AddUserPoint(CadApp.sketch, wx, wy, 0)
            IfCondition GreaterEqual(pi, 0) ThenBlock: {
                CadApp.last_upt = pi
                CadApp.dirty = 1
                CadApp.cstr_type = 20
                CadApp.cstr_u = Float_ToInt(wx)
                CadApp.cstr_v = Float_ToInt(wy)
                CadApp.cstr_ready = 1
                CadApp.last_cstr = -1
                CA_FeatAdd(14, CA_CurrentSkIdx())
                IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                    ArraySet(CadApp.feat_aux, CadApp.feat_sel, pi)
                }
                CA_HudOpenCstr()
                CA_Log("cad_app: point placed — U V Enter\n", 34)
            }
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CA_PublishFrame()
            ReturnValue(0)
        }
        nc = CadApp.nclick
        IfCondition EqualTo(nc, 0) ThenBlock: {
            CadApp.cx0 = wx
            CadApp.cy0 = wy
            CadApp.nclick = 1
            // seed rubber-band at click (host may not send hover until move)
            CadApp.hover_px = px
            CadApp.hover_py = py
            CadApp.hover_ok = 1
            CadApp.hover_u = Float_ToInt(wx)
            CadApp.hover_v = Float_ToInt(wy)
            IfCondition EqualTo(CadApp.tool, 17) ThenBlock: {
                CadApp.last_poly = -1
                CA_HudOpenPoly()
            }
            IfCondition EqualTo(CadApp.tool, 2) ThenBlock: {
                CadApp.last_circ = -1
                CadApp.circ_r = 0
                CadApp.circ_d = 0
                CA_HudOpenCirc()
            }
            IfCondition EqualTo(CadApp.tool, 15) ThenBlock: {
                CadApp.last_rect = -1
                CadApp.rect_w = 0
                CadApp.rect_h = 0
                CA_HudOpenRect()
            }
            opened = 0
            IfCondition EqualTo(CadApp.tool, 17) ThenBlock: { opened = 1 }
            IfCondition EqualTo(CadApp.tool, 2) ThenBlock: { opened = 1 }
            IfCondition EqualTo(CadApp.tool, 15) ThenBlock: { opened = 1 }
            IfCondition EqualTo(opened, 0) ThenBlock: {
                IfCondition NotEqual(CadApp.hud_kind, 0) ThenBlock: {
                    CA_HudClose()
                }
            }
            CA_PublishFrame()
            ReturnValue(0)
        }
        IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                CadApp.sketch = CAD_Sketch.CreateSketch(1)
            }
            CA_Log("cad_app: sketch line commit\n", 28)
            CAD_Sketch_State.work_sk = CadApp.sketch
            CAD_Sketch.AddLine(CAD_Sketch_State.work_sk, CadApp.cx0, CadApp.cy0, wx, wy)
            // anchors only — keep this path light (no profile rebuild hang)
            CAD_Sketch.RebuildAnchors(CAD_Sketch_State.work_sk)
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            // NO auto-chain: nclick=0 so next line is a clean 2-click gesture.
            // (Chain left nclick stuck and looked like "only one element works".)
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            // length MUST match string including newline (was 28 → truncated "chain o")
            CA_Log("cad_app: line added\n", 20)
            CadApp.last_line = Subtract(CAD_Sketch.GetLineCount(CadApp.sketch), 1)
            CA_LineRemember()
            CA_HudOpenLine()
            CA_PublishFrame()
            ReturnValue(0)
        }
        IfCondition EqualTo(CadApp.tool, 1) ThenBlock: {
            x0 = CadApp.cx0
            y0 = CadApp.cy0
            x1 = wx
            y1 = wy
            CAD_Sketch_State.work_sk = CadApp.sketch
            CAD_Sketch.AddLine(CAD_Sketch_State.work_sk, x0, y0, x1, y0)
            CAD_Sketch.AddLine(CAD_Sketch_State.work_sk, x1, y0, x1, y1)
            CAD_Sketch.AddLine(CAD_Sketch_State.work_sk, x1, y1, x0, y1)
            CAD_Sketch.AddLine(CAD_Sketch_State.work_sk, x0, y1, x0, y0)
            CAD_Sketch.RebuildAnchors(CAD_Sketch_State.work_sk)
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            CA_Log("cad_app: rect added\n", 20)
            dw = Float_Sub(x1, x0)
            dh = Float_Sub(y1, y0)
            IfCondition EqualTo(Float_Le(dw, 0), 1) ThenBlock: { dw = Float_Sub(0, dw) }
            IfCondition EqualTo(Float_Le(dh, 0), 1) ThenBlock: { dh = Float_Sub(0, dh) }
            CadApp.rect_w = Float_ToInt(dw)
            CadApp.rect_h = Float_ToInt(dh)
            mx = Float_Div(Float_Add(x0, x1), 0x4000000000000000)
            my = Float_Div(Float_Add(y0, y1), 0x4000000000000000)
            CA_RectRemember(0, mx, my, x0, y0, 0)
            CA_HudOpenRect()
        }
        IfCondition EqualTo(CadApp.tool, 2) ThenBlock: {
            dx = Float_Sub(wx, CadApp.cx0)
            dy = Float_Sub(wy, CadApp.cy0)
            rad = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
            IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 0) ThenBlock: {
                CA_Log("cad_app: circle commit begin\n", 29)
                CAD_Sketch_State.work_sk = CadApp.sketch
                CAD_Sketch.AddCircle(CAD_Sketch_State.work_sk, CadApp.cx0, CadApp.cy0, rad)
                CA_Log("cad_app: circle AddCircle back\n", 31)
                nls = CAD_Sketch.GetLineCount(CadApp.sketch)
                si = 0
                WhileLoop LessThan(si, nls) {
                    CAD_Sketch.SplitLineAtHits(CadApp.sketch, si)
                    si = Add(si, 1)
                }
                CAD_Sketch.RebuildAnchors(CadApp.sketch)
                CadApp.dirty = 1
                CA_InvalidateProfiles()
                CA_Log("cad_app: circle added\n", 22)
                CA_CircRemember()
                CA_HudOpenCirc()
            }
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CA_PublishFrame()
            ReturnValue(0)
        }
        // arc center-radius: click1 center, click2 start (radius+a0), click3 end (a1)
        IfCondition EqualTo(CadApp.tool, 3) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                // second click = start point on arc
                dx = Float_Sub(wx, CadApp.cx0)
                dy = Float_Sub(wy, CadApp.cy0)
                CadApp.arc_rad = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                CadApp.arc_a0 = CAD_Geom.Atan2(dy, dx)
                CadApp.nclick = 2
                CA_PublishFrame()
                ReturnValue(0)
            }
            IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: {
                dx = Float_Sub(wx, CadApp.cx0)
                dy = Float_Sub(wy, CadApp.cy0)
                a1 = CAD_Geom.Atan2(dy, dx)
                IfCondition EqualTo(CAD_Num.IsZero(CadApp.arc_rad, 0), 0) ThenBlock: {
                    CAD_Sketch.AddArc(CadApp.sketch, CadApp.cx0, CadApp.cy0, CadApp.arc_rad, CadApp.arc_a0, a1)
                    // one split pass so line×arc joins become real ends
                    nls = CAD_Sketch.GetLineCount(CadApp.sketch)
                    si = 0
                    WhileLoop LessThan(si, nls) {
                        CAD_Sketch.SplitLineAtHits(CadApp.sketch, si)
                        si = Add(si, 1)
                    }
                    CAD_Sketch.RebuildAnchors(CadApp.sketch)
                    CadApp.dirty = 1
                    CA_InvalidateProfiles()
                    CA_Log("cad_app: arc added\n", 19)
                    CA_HistPush(0)
                }
                CadApp.nclick = 0
                CadApp.hover_ok = 0
                CA_PublishFrame()
                ReturnValue(0)
            }
        }
        // 3-point arc: start → through → end (uses cx0/cy0, arc_rad/arc_a0 as temp through)
        IfCondition EqualTo(CadApp.tool, 9) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                // second = through point (stash in arc temp + keep start in cx0/cy0)
                CadApp.arc_rad = wx
                CadApp.arc_a0 = wy
                CadApp.nclick = 2
                CadApp.hover_px = px
                CadApp.hover_py = py
                CadApp.hover_ok = 1
                CA_Log("cad_app: arc3 through set\n", 26)
                CA_PublishFrame()
                ReturnValue(0)
            }
            IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: {
                // WYSIWYG: pin 3 points + sketch, then Fit(6) + CommitLast(1).
                // Never one 7-arg call — ABI clobber made wrong arcs / fill under purple.
                p0x = CadApp.cx0
                p0y = CadApp.cy0
                p1x = CadApp.arc_rad
                p1y = CadApp.arc_a0
                p2x = wx
                p2y = wy
                hsk = CadApp.sketch
                fr = CAD_Sketch.Arc3Fit(p0x, p0y, p1x, p1y, p2x, p2y)
                rc = -3
                IfCondition EqualTo(fr, 0) ThenBlock: {
                    rc = CAD_Sketch.Arc3CommitLast(hsk)
                }
                IfCondition EqualTo(rc, 0) ThenBlock: {
                    CadApp.dirty = 1
                    CA_InvalidateProfiles()
                    CA_Log("cad_app: arc3 OK\n", 17)
                    CA_HistPush(0)
                }
                IfCondition EqualTo(rc, -3) ThenBlock: {
                    CA_Log("cad_app: arc3 fail collinear\n", 29)
                }
                IfCondition LessThan(rc, 0) ThenBlock: {
                    IfCondition NotEqual(rc, -3) ThenBlock: {
                        CA_Log("cad_app: arc3 fail\n", 19)
                    }
                }
                CadApp.nclick = 0
                CadApp.hover_ok = 0
                CA_PublishFrame()
                ReturnValue(0)
            }
        }
        // 2-point arc (diameter semicircle) / 2-point circle / center rect / n-gon / slot
        IfCondition EqualTo(CadApp.tool, 12) ThenBlock: {
            CAD_UI.Pend2(CadApp.cx0, CadApp.cy0, wx, wy)
            rc = CAD_UI.AddArc2(CadApp.sketch)
            IfCondition EqualTo(rc, 0) ThenBlock: {
                CadApp.dirty = 1
                CA_InvalidateProfiles()
                CA_Log("cad_app: arc2 OK\n", 17)
                CA_HistPush(0)
            }
            IfCondition NotEqual(rc, 0) ThenBlock: {
                CA_Log("cad_app: arc2 fail\n", 19)
            }
        }
        IfCondition EqualTo(CadApp.tool, 13) ThenBlock: {
            CAD_UI.Pend2(CadApp.cx0, CadApp.cy0, wx, wy)
            rc = CAD_UI.AddCircleDiam(CadApp.sketch)
            IfCondition EqualTo(rc, 0) ThenBlock: {
                CadApp.dirty = 1
                CA_InvalidateProfiles()
                CA_Log("cad_app: circ2 OK\n", 18)
                CA_CircRemember()
                CA_HudOpenCirc()
            }
            IfCondition NotEqual(rc, 0) ThenBlock: {
                CA_Log("cad_app: circ2 fail\n", 20)
            }
        }
        IfCondition EqualTo(CadApp.tool, 15) ThenBlock: {
            CAD_UI.Pend2(CadApp.cx0, CadApp.cy0, wx, wy)
            rc = CAD_UI.AddRectCenter(CadApp.sketch)
            IfCondition EqualTo(rc, 0) ThenBlock: {
                CadApp.dirty = 1
                CA_InvalidateProfiles()
                CA_Log("cad_app: rectC OK\n", 18)
                dw = Float_Sub(wx, CadApp.cx0)
                dh = Float_Sub(wy, CadApp.cy0)
                IfCondition EqualTo(Float_Le(dw, 0), 1) ThenBlock: { dw = Float_Sub(0, dw) }
                IfCondition EqualTo(Float_Le(dh, 0), 1) ThenBlock: { dh = Float_Sub(0, dh) }
                CadApp.rect_w = Float_ToInt(Float_Mul(dw, 0x4000000000000000))
                CadApp.rect_h = Float_ToInt(Float_Mul(dh, 0x4000000000000000))
                CA_RectRemember(1, CadApp.cx0, CadApp.cy0, wx, wy, 0)
                CA_HudOpenRect()
            }
            IfCondition NotEqual(rc, 0) ThenBlock: {
                CA_Log("cad_app: rectC fail\n", 20)
            }
        }
        IfCondition EqualTo(CadApp.tool, 17) ThenBlock: {
            CAD_UI_State.nsides = CadApp.poly_n
            rc = 0
            IfCondition EqualTo(CadApp.poly_mode, 2) ThenBlock: {
                IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                    CadApp.arc_rad = wx
                    CadApp.arc_a0 = wy
                    CadApp.nclick = 2
                    CadApp.hover_ok = 1
                    CA_Log("cad_app: poly3 center vertex set\n", 33)
                    CA_PublishFrame()
                    ReturnValue(0)
                }
                CAD_UI.Pend3(CadApp.cx0, CadApp.cy0, CadApp.arc_rad, CadApp.arc_a0, wx, wy)
                IfCondition LessThan(CadApp.poly_n, 3) ThenBlock: {
                    rc = CAD_UI.AddSlot(CadApp.sketch)
                }
                IfCondition GreaterEqual(CadApp.poly_n, 3) ThenBlock: {
                    rc = CAD_UI.AddNGonCenter3(CadApp.sketch)
                }
            }
            IfCondition NotEqual(CadApp.poly_mode, 2) ThenBlock: {
            CAD_UI.Pend2(CadApp.cx0, CadApp.cy0, wx, wy)
            IfCondition LessThan(CadApp.poly_n, 3) ThenBlock: {
                rc = CAD_UI.AddSlot(CadApp.sketch)
            }
            IfCondition GreaterEqual(CadApp.poly_n, 3) ThenBlock: {
                IfCondition EqualTo(CadApp.poly_mode, 1) ThenBlock: {
                    rc = CAD_UI.AddNGonEdge(CadApp.sketch)
                }
                IfCondition EqualTo(CadApp.poly_mode, 0) ThenBlock: {
                    rc = CAD_UI.AddNGon(CadApp.sketch)
                }
            }
            }
            IfCondition EqualTo(rc, 0) ThenBlock: {
                CadApp.dirty = 1
                CA_InvalidateProfiles()
                CA_Log("cad_app: poly OK\n", 17)
                ang = CAD_Geom.Atan2(Float_Sub(wy, CadApp.cy0), Float_Sub(wx, CadApp.cx0))
                CA_PolyRemember(ang)
                CA_HudClose()
            }
            IfCondition NotEqual(rc, 0) ThenBlock: {
                CA_Log("cad_app: poly fail\n", 19)
            }
        }
        // 3-point circle / 3-point rectangle
        IfCondition EqualTo(CadApp.tool, 14) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                CadApp.arc_rad = wx
                CadApp.arc_a0 = wy
                CadApp.nclick = 2
                CadApp.hover_px = px
                CadApp.hover_py = py
                CadApp.hover_ok = 1
                CA_Log("cad_app: circ3 through set\n", 27)
                CA_PublishFrame()
                ReturnValue(0)
            }
            IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: {
                CAD_UI.Pend3(CadApp.cx0, CadApp.cy0, CadApp.arc_rad, CadApp.arc_a0, wx, wy)
                rc = CAD_UI.AddCircle3(CadApp.sketch)
                IfCondition EqualTo(rc, 0) ThenBlock: {
                    CadApp.dirty = 1
                    CA_InvalidateProfiles()
                    CA_Log("cad_app: circ3 OK\n", 18)
                    CA_CircRemember()
                    CA_HudOpenCirc()
                }
                IfCondition EqualTo(rc, -3) ThenBlock: {
                    CA_Log("cad_app: circ3 fail collinear\n", 30)
                }
                IfCondition LessThan(rc, 0) ThenBlock: {
                    IfCondition NotEqual(rc, -3) ThenBlock: {
                        CA_Log("cad_app: circ3 fail\n", 20)
                    }
                }
            }
        }
        IfCondition EqualTo(CadApp.tool, 16) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                CadApp.arc_rad = wx
                CadApp.arc_a0 = wy
                CadApp.nclick = 2
                CadApp.hover_px = px
                CadApp.hover_py = py
                CadApp.hover_ok = 1
                CA_Log("cad_app: rect3 edge set\n", 24)
                CA_PublishFrame()
                ReturnValue(0)
            }
            IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: {
                CAD_UI.Pend3(CadApp.cx0, CadApp.cy0, CadApp.arc_rad, CadApp.arc_a0, wx, wy)
                rc = CAD_UI.AddRect3(CadApp.sketch)
                IfCondition EqualTo(rc, 0) ThenBlock: {
                    CadApp.dirty = 1
                    CA_InvalidateProfiles()
                    CA_Log("cad_app: rect3 OK\n", 18)
                    edx = Float_Sub(CadApp.arc_rad, CadApp.cx0)
                    edy = Float_Sub(CadApp.arc_a0, CadApp.cy0)
                    elen = CAD_Num.Sqrt(Float_Add(Float_Mul(edx, edx), Float_Mul(edy, edy)))
                    CadApp.rect_w = Float_ToInt(elen)
                    nx = Float_Sub(0, edy)
                    ny = edx
                    IfCondition EqualTo(CAD_Num.IsZero(elen, 0), 0) ThenBlock: {
                        nx = Float_Div(nx, elen)
                        ny = Float_Div(ny, elen)
                    }
                    ht = Float_Add(Float_Mul(Float_Sub(wx, CadApp.cx0), nx), Float_Mul(Float_Sub(wy, CadApp.cy0), ny))
                    hv = ht
                    IfCondition EqualTo(Float_Le(hv, 0), 1) ThenBlock: { hv = Float_Sub(0, hv) }
                    CadApp.rect_h = Float_ToInt(hv)
                    CA_RectRemember(2, CadApp.cx0, CadApp.cy0, CadApp.arc_rad, CadApp.arc_a0, ht)
                    CA_HudOpenRect()
                }
                IfCondition NotEqual(rc, 0) ThenBlock: {
                    CA_Log("cad_app: rect3 fail\n", 20)
                }
            }
        }
        CadApp.nclick = 0
        CadApp.hover_ok = 0
        CA_PublishFrame()
        ReturnValue(0)
    }
}

// Hover for rubber-band (sketch mode only redraws when placing second point).


// Hover for rubber-band (sketch mode only redraws when placing second point).
Function.CA_OnHover {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        CadApp.hover_px = px
        CadApp.hover_py = py
        CadApp.hover_ok = 1
        IfCondition EqualTo(CadAppIpc.hxy, 0) ThenBlock: { CadAppIpc.hxy = Allocate(32) }
        IfCondition NotEqual(CadAppIpc.hxy, 0) ThenBlock: {
            IfCondition EqualTo(CA_PixToWorld(px, py, CadAppIpc.hxy), 0) ThenBlock: {
                CadApp.hover_u = Float_ToInt(ArrayGet(CadAppIpc.hxy, 0))
                CadApp.hover_v = Float_ToInt(ArrayGet(CadAppIpc.hxy, 1))
            }
        }
        CA_WriteHud()
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
            need = 0
            IfCondition GreaterThan(CadApp.nclick, 0) ThenBlock: { need = 1 }
            IfCondition EqualTo(CadApp.tool, 9) ThenBlock: { need = 1 }
            IfCondition GreaterEqual(CadApp.tool, 12) ThenBlock: {
                IfCondition GreaterThan(CadApp.nclick, 0) ThenBlock: { need = 1 }
            }
            IfCondition EqualTo(need, 1) ThenBlock: {
                CadAppIpc.lite = 1
                CA_PublishFrame()
                CadAppIpc.lite = 0
            }
        }
        // Sketch-on-Face / From Face / Origin / 3pt: hover the front-most planar face
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
            want_face = 0
            IfCondition EqualTo(CadApp.face_pick, 1) ThenBlock: { want_face = 1 }
            IfCondition GreaterEqual(CadApp.plane_pick, 2) ThenBlock: { want_face = 1 }
            IfCondition EqualTo(want_face, 1) ThenBlock: {
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                    CadAppPick.quiet = 1
                    fh = CA_PickFaceAt(px, py)
                    CadAppPick.quiet = 0
                    IfCondition NotEqual(fh, CadApp.hover_face) ThenBlock: {
                        CadApp.hover_face = fh
                        CadAppIpc.lite = 1
                        CA_PublishFrame()
                        CadAppIpc.lite = 0
                    }
                }
            }
            IfCondition EqualTo(CadApp.plane_pick, 1) ThenBlock: {
                CadAppPick.quiet = 1
                ph = CA_PickPlaneAt(px, py)
                CadAppPick.quiet = 0
                IfCondition NotEqual(ph, CadApp.hover_plane) ThenBlock: {
                    CadApp.hover_plane = ph
                    CadAppIpc.lite = 1
                    CA_PublishFrame()
                    CadAppIpc.lite = 0
                }
            }
        }
        ReturnValue(0)
    }
}

// Arc3 rubber-band: markers + live arc from CAD_Sketch.Arc3Fit (same as commit).


// Cancel in-progress tool USE only (nclick/hover). Keeps CadApp.tool selected.
Function.CA_CancelTool {
    Output: Integer
    Body: {
        CadApp.nclick = 0
        CadApp.hover_ok = 0
        CadApp.cstr_npick = 0
        CadApp.face_pick = 0
        CadApp.hover_face = 0
        CA_PlaneClearPick()
        CadApp.sel_edge_id = 0
        CadApp.sel_nedges = 0
        CadApp.fillet_li = -1
        CadApp.fillet_lj = -1
        CadApp.live_ang = -1
        CadApp.live_len = 0
        CadApp.spl_n = 0
        CadApp.plane_kind = 0
        CadApp.hud_kind = 0
        CadApp.hud_field = 0
        CadApp.chamfer_edit = 0
        CadApp.fillet_edit = 0
        CA_WriteDimHud()
        // do not clear CadApp.tool — tool stays selected for next use
        CA_Log("cad_app: tool cancel\n", 21)
        ReturnValue(0)
    }
}

Function.CA_SplineClick {
    Input: wx: Integer
    Input: wy: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.spl_xy, 0) ThenBlock: {
            CadApp.spl_xy = Allocate(2048)
        }
        n = CadApp.spl_n
        IfCondition GreaterEqual(n, 64) ThenBlock: {
            CA_Log("cad_app: spline full (64 CVs)\n", 30)
            ReturnValue(-1)
        }
        ArraySet(CadApp.spl_xy, Multiply(n, 2), wx)
        ArraySet(CadApp.spl_xy, Add(Multiply(n, 2), 1), wy)
        CadApp.spl_n = Add(n, 1)
        CadApp.nclick = CadApp.spl_n
        CadApp.hover_ok = 1
        CA_LogInt("cad_app: spline CV n=", 21, CadApp.spl_n)
        ReturnValue(0)
    }
}

Function.CA_FinishSpline {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
        }
        n = CadApp.spl_n
        IfCondition LessThan(n, 2) ThenBlock: {
            CA_Log("cad_app: spline need 2+ CVs\n", 28)
            ReturnValue(-2)
        }
        rc = CAD_UI.AddSplineXY(CadApp.sketch, CadApp.spl_xy, n)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            CA_Log("cad_app: spline OK\n", 19)
            CA_HistPush(0)
        }
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: spline fail\n", 21)
        }
        CadApp.spl_n = 0
        CadApp.nclick = 0
        CadApp.hover_ok = 0
        ReturnValue(rc)
    }
}

// Kernel-owned sketch HUD. Host only types digits / Tab / Enter.

Function.CA_HudClose {
    Output: Integer
    Body: {
        CadApp.hud_kind = 0
        CadApp.hud_field = 0
        CadApp.chamfer_edit = 0
        CadApp.fillet_edit = 0
        CA_WriteDimHud()
        ReturnValue(0)
    }
}

Function.CA_HudApplyFillet {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(CadApp.last_fillet, 0) ThenBlock: {
            rc = CA_FilletRebuild(CadApp.last_fillet)
            ReturnValue(rc)
        }
        IfCondition LessThan(CadApp.fillet_li, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(CadApp.fillet_lj, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.fillet_r, 0) ThenBlock: {
            CadApp.fillet_r = 0x4000000000000000
        }
        CA_FilletSnap(CadApp.fillet_li, CadApp.fillet_lj)
        rc = CAD_Sketch.FilletLines(CadApp.sketch, CadApp.fillet_li, CadApp.fillet_lj, CadApp.fillet_r)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            CA_FilletRemember()
            CA_SolveNow()
            CA_Log("cad_app: fillet OK\n", 19)
        }
        IfCondition EqualTo(rc, -3) ThenBlock: {
            CA_Log("cad_app: fillet fail parallel\n", 30)
        }
        IfCondition EqualTo(rc, -4) ThenBlock: {
            CA_Log("cad_app: fillet fail R too big\n", 31)
        }
        CadApp.fillet_li = -1
        CadApp.fillet_lj = -1
        ReturnValue(rc)
    }
}

Function.CA_HudOk {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.hud_kind, 3) ThenBlock: {
            ReturnValue(CA_CircCommitHud())
        }
        IfCondition EqualTo(CadApp.hud_kind, 4) ThenBlock: {
            ReturnValue(CA_RectCommitHud())
        }
        IfCondition EqualTo(CadApp.hud_kind, 5) ThenBlock: {
            CA_HudApplyFillet()
        }
        IfCondition EqualTo(CadApp.hud_kind, 6) ThenBlock: {
            CA_CstrApplyPending()
            CadApp.cstr_ready = 0
        }
        IfCondition EqualTo(CadApp.hud_kind, 7) ThenBlock: {
            CA_PadApplyHeight()
        }
        IfCondition EqualTo(CadApp.hud_kind, 8) ThenBlock: {
            CA_RevApplyDeg()
        }
        IfCondition EqualTo(CadApp.hud_kind, 9) ThenBlock: {
            rc = CA_HudApplyChamfer()
            IfCondition NotEqual(rc, 0) ThenBlock: {
                CA_WriteDimHud()
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(CadApp.hud_kind, 10) ThenBlock: {
            rc = CA_HudApplyFillet3d()
            IfCondition NotEqual(rc, 0) ThenBlock: {
                CA_WriteDimHud()
                ReturnValue(0)
            }
        }
        CA_HudClose()
        ReturnValue(0)
    }
}

Function.CA_RectCommitHud {
    Output: Integer
    Body: {
        CA_LogInt("cad_app: rect commit W=", 23, CadApp.rect_w)
        CA_LogInt("cad_app: rect commit H=", 23, CadApp.rect_h)
        IfCondition LessThan(CadApp.rect_w, 1) ThenBlock: {
            CadApp.hud_field = 0
            CA_WriteDimHud()
            CA_Log("cad_app: rect needs Width\n", 25)
            ReturnValue(0)
        }
        IfCondition LessThan(CadApp.rect_h, 1) ThenBlock: {
            CadApp.hud_field = 1
            CA_WriteDimHud()
            CA_Log("cad_app: rect needs Height (Tab/type H, Enter)\n", 47)
            ReturnValue(0)
        }
        IfCondition GreaterEqual(CadApp.last_rect, 0) ThenBlock: {
            CA_RectRebuild(CadApp.last_rect)
        }
        IfCondition LessThan(CadApp.last_rect, 0) ThenBlock: {
            IfCondition GreaterThan(CadApp.nclick, 0) ThenBlock: {
                CA_PlaceRectCenter()
            }
        }
        IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
            CA_LookAlongActivePlane()
        }
        CA_HudClose()
        CA_PublishFrame()
        ReturnValue(1)
    }
}

Function.CA_CircCommitHud {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.circ_r, 1) ThenBlock: {
            CA_WriteDimHud()
            CA_Log("cad_app: circ needs R or D\n", 27)
            ReturnValue(0)
        }
        v = Float_FromInt(CadApp.circ_r)
        IfCondition GreaterEqual(CadApp.last_circ, 0) ThenBlock: {
            CAD_Sketch.SetCircleRadius(CadApp.sketch, CadApp.last_circ, v)
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            CA_HistPush(10)
            CA_SolveNow()
            CA_HudClose()
            CA_PublishFrame()
            ReturnValue(1)
        }
        IfCondition GreaterThan(CadApp.nclick, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                CadApp.sketch = CAD_Sketch.CreateSketch(1)
            }
            CAD_Sketch.AddCircle(CadApp.sketch, CadApp.cx0, CadApp.cy0, v)
            CA_CircRemember()
            CadApp.nclick = 0
            CadApp.dirty = 1
            CA_InvalidateProfiles()
        }
        IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
            CA_LookAlongActivePlane()
        }
        CA_HudClose()
        CA_PublishFrame()
        ReturnValue(1)
    }
}

Function.CA_HudOpenPoly {
    Output: Integer
    Body: {
        CadApp.hud_kind = 1
        CadApp.hud_field = 0
        IfCondition EqualTo(CadApp.poly_mode, 0) ThenBlock: {
            CadApp.hud_field = 1
        }
        IfCondition LessThan(CadApp.poly_n, 3) ThenBlock: {
            IfCondition EqualTo(CadApp.poly_mode, 0) ThenBlock: { CadApp.poly_n = 6 }
        }
        CA_PolySyncFromSide()
        CA_Log("cad_app: poly HUD (N/L/D)\n", 26)
        ReturnValue(0)
    }
}

Function.CA_HudOpenLine {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.last_line, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        xy = Allocate(32)
        CAD_Sketch.GetLineEnd(CadApp.sketch, CadApp.last_line, 0, xy)
        x0 = ArrayGet(xy, 0)
        y0 = ArrayGet(xy, 1)
        CAD_Sketch.GetLineEnd(CadApp.sketch, CadApp.last_line, 1, xy)
        dx = Float_Sub(ArrayGet(xy, 0), x0)
        dy = Float_Sub(ArrayGet(xy, 1), y0)
        Deallocate(xy, 32)
        ln = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        CadApp.live_len = Float_ToInt(ln)
        ang = CAD_Geom.Atan2(dy, dx)
        k = Float_Div(0x4066800000000000, 0x400921FB54442D18)
        deg = Float_ToInt(Float_Mul(ang, k))
        IfCondition LessThan(deg, 0) ThenBlock: { deg = Add(deg, 360) }
        CadApp.live_ang = deg
        CadApp.hud_kind = 2
        CadApp.hud_field = 0
        CA_Log("cad_app: line HUD (L/A)\n", 24)
        ReturnValue(0)
    }
}

Function.CA_HudOpenCirc {
    Output: Integer
    Body: {
        CadApp.hud_kind = 3
        CadApp.hud_field = 0
        IfCondition GreaterThan(CadApp.circ_r, 0) ThenBlock: {
            CadApp.circ_d = Multiply(CadApp.circ_r, 2)
        }
        CA_Log("cad_app: circ HUD (R/D)\n", 24)
        ReturnValue(0)
    }
}

Function.CA_HudOpenRect {
    Output: Integer
    Body: {
        CadApp.hud_kind = 4
        CadApp.hud_field = 0
        CA_Log("cad_app: rect HUD (W/H)\n", 24)
        ReturnValue(0)
    }
}

Function.CA_HudOpenFillet {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.fillet_r, 0) ThenBlock: {
            CadApp.fillet_r = 0x4000000000000000
        }
        CadApp.hud_kind = 5
        CadApp.hud_field = 0
        CA_Log("cad_app: fillet HUD (R)\n", 24)
        ReturnValue(0)
    }
}

Function.CA_HudOpenChamfer {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.chamfer_d, 1) ThenBlock: { CadApp.chamfer_d = 2 }
        CadApp.hud_kind = 9
        CadApp.hud_field = 0
        CA_Log("cad_app: chamfer HUD (D mm)\n", 28)
        ReturnValue(0)
    }
}

Function.CA_HudApplyChamfer {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.chamfer_d, 1) ThenBlock: { CadApp.chamfer_d = 2 }
        IfCondition GreaterThan(CadApp.chamfer_d, 10000) ThenBlock: { CadApp.chamfer_d = 10000 }
        ReturnValue(CA_ChamferSolid(CadApp.chamfer_d))
    }
}

Function.CA_HudOpenFillet3d {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.fillet_r, 0) ThenBlock: {
            CadApp.fillet_r = 0x4000000000000000
        }
        CadApp.hud_kind = 10
        CadApp.hud_field = 0
        CA_Log("cad_app: 3D fillet HUD (R mm)\n", 30)
        ReturnValue(0)
    }
}

Function.CA_HudApplyFillet3d {
    Output: Integer
    Body: {
        r = Float_ToInt(CadApp.fillet_r)
        IfCondition LessThan(r, 1) ThenBlock: { r = 2 }
        IfCondition GreaterThan(r, 10000) ThenBlock: { r = 10000 }
        ReturnValue(CA_FilletSolid(r))
    }
}

Function.CA_HudOpenCstr {
    Output: Integer
    Body: {
        CadApp.hud_kind = 6
        CadApp.hud_field = 0
        ReturnValue(0)
    }
}

Function.CA_HudOpenPad {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.height, 0) ThenBlock: { CadApp.height = 10 }
        CadApp.hud_kind = 7
        CadApp.hud_field = 0
        CA_Log("cad_app: extrude HUD (H / JOIN CUT NEW)\n", 40)
        ReturnValue(0)
    }
}

Function.CA_PadApplyHeight {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.height, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(CadApp.height, 10000) ThenBlock: { CadApp.height = 10000 }
        IfCondition LessThan(CadApp.height, -10000) ThenBlock: { CadApp.height = -10000 }
        IfCondition LessThan(CadApp.height, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: { CadApp.extrude_op = 1 }
        }
        IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: {
            IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
                CA_Log("cad_app: cut needs a solid\n", 27)
                ReturnValue(-1)
            }
        }
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            IfCondition GreaterEqual(CadApp.feat_sel, 0) ThenBlock: {
                IfCondition LessThan(CadApp.feat_sel, CadApp.feat_n) ThenBlock: {
                    fk = ArrayGet(CadApp.feat_kind, CadApp.feat_sel)
                    IfCondition EqualTo(fk, 1) ThenBlock: {
                        ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.height)
                    }
                    IfCondition EqualTo(fk, 3) ThenBlock: {
                        ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.height)
                    }
                }
            }
        }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        CadApp.pad_edit = 1
        IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
            CadApp.auto_pad = 1
        }
        rc = CA_BuildSolid()
        CadApp.auto_pad = 0
        CadApp.pad_edit = 0
        CadApp.mode = 0
        ReturnValue(rc)
    }
}

Function.CA_HudOpenRev {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.rev_deg, 1) ThenBlock: { CadApp.rev_deg = 360 }
        CadApp.hud_kind = 8
        CadApp.hud_field = 0
        CA_Log("cad_app: revolve HUD (A deg)\n", 29)
        ReturnValue(0)
    }
}

Function.CA_RevApplyDeg {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.rev_deg, 1) ThenBlock: { CadApp.rev_deg = 1 }
        IfCondition GreaterThan(CadApp.rev_deg, 360) ThenBlock: { CadApp.rev_deg = 360 }
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            IfCondition GreaterEqual(CadApp.feat_sel, 0) ThenBlock: {
                IfCondition LessThan(CadApp.feat_sel, CadApp.feat_n) ThenBlock: {
                    IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadApp.feat_sel), 2) ThenBlock: {
                        ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.rev_deg)
                    }
                }
            }
        }
        IfCondition EqualTo(CadAppRev.ok, 0) ThenBlock: { ReturnValue(-1) }
        CadApp.rev_edit = 1
        rc = CA_RevolveFromSketch()
        CadApp.rev_edit = 0
        CadApp.mode = 0
        ReturnValue(rc)
    }
}

Function.CA_RevEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 2) ThenBlock: { ReturnValue(-1) }
        CadApp.feat_sel = feat_i
        CadApp.last_revf = feat_i
        dd = CadApp.rev_deg
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            da = ArrayGet(CadApp.feat_aux, feat_i)
            IfCondition GreaterThan(da, 0) ThenBlock: { dd = da }
        }
        CadApp.rev_deg = dd
        CadApp.mode = 0
        CA_HudOpenRev()
        ReturnValue(0)
    }
}

// Left-click tree: select only. Right-click Edit / double-click opens HUD.
Function.CA_TreeSelect {
    Input: k: Integer
    Input: id: Integer
    Output: Integer
    Body: {
        CA_HudClose()
        CadApp.nclick = 0
        CadApp.face_pick = 0
        CA_PlaneClearPick()
        // S — sketch
        IfCondition EqualTo(k, 83) ThenBlock: {
            IfCondition GreaterEqual(id, 0) ThenBlock: {
                IfCondition LessThan(id, CadApp.sk_n) ThenBlock: {
                    CadApp.sketch = ArrayGet(CadApp.sk_list, id)
                    CadApp.mode = 1
                    pl = CAD_Sketch.GetPlaneId(CadApp.sketch)
                    IfCondition NotEqual(pl, 0) ThenBlock: { CadApp.plane = pl }
                    fi = 0
                    WhileLoop LessThan(fi, CadApp.feat_n) {
                        IfCondition EqualTo(ArrayGet(CadApp.feat_kind, fi), 0) ThenBlock: {
                            IfCondition EqualTo(ArrayGet(CadApp.feat_sk, fi), id) ThenBlock: {
                                CadApp.feat_sel = fi
                            }
                        }
                        fi = Add(fi, 1)
                    }
                }
            }
            ReturnValue(0)
        }
        // N — construction plane
        IfCondition EqualTo(k, 78) ThenBlock: {
            CA_PlaneActivateIdx(id)
            ReturnValue(0)
        }
        // M — model
        IfCondition EqualTo(k, 77) ThenBlock: {
            CadApp.mode = 0
            CadApp.feat_sel = CadApp.feat_n
            ReturnValue(0)
        }
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        CadApp.feat_sel = id
        si = 0
        IfCondition NotEqual(CadApp.feat_sk, 0) ThenBlock: {
            si = ArrayGet(CadApp.feat_sk, id)
        }
        IfCondition GreaterEqual(si, 0) ThenBlock: {
            IfCondition LessThan(si, CadApp.sk_n) ThenBlock: {
                IfCondition NotEqual(CadApp.sk_list, 0) ThenBlock: {
                    sk = ArrayGet(CadApp.sk_list, si)
                    IfCondition NotEqual(sk, 0) ThenBlock: {
                        CadApp.sketch = sk
                        pl = CAD_Sketch.GetPlaneId(sk)
                        IfCondition NotEqual(pl, 0) ThenBlock: { CadApp.plane = pl }
                    }
                }
            }
        }
        go3 = 0
        IfCondition EqualTo(k, 66) ThenBlock: { go3 = 1 }
        IfCondition EqualTo(k, 82) ThenBlock: { go3 = 1 }
        IfCondition EqualTo(k, 85) ThenBlock: { go3 = 1 }
        IfCondition EqualTo(k, 70) ThenBlock: { go3 = 1 }
        IfCondition EqualTo(k, 67) ThenBlock: { go3 = 1 }
        IfCondition EqualTo(go3, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                CadApp.mode = 0
            }
            IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
                CadApp.mode = 1
            }
            ReturnValue(0)
        }
        CadApp.mode = 1
        ReturnValue(0)
    }
}

Function.CA_PadEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(-1) }
        fk = ArrayGet(CadApp.feat_kind, feat_i)
        okp = 0
        IfCondition EqualTo(fk, 1) ThenBlock: {
            CadApp.extrude_op = 0
            okp = 1
        }
        IfCondition EqualTo(fk, 3) ThenBlock: {
            CadApp.extrude_op = 1
            okp = 1
        }
        IfCondition NotEqual(okp, 1) ThenBlock: { ReturnValue(-1) }
        CadApp.feat_sel = feat_i
        CadApp.last_pad = feat_i
        hh = CadApp.height
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ha = ArrayGet(CadApp.feat_aux, feat_i)
            IfCondition NotEqual(ha, 0) ThenBlock: { hh = ha }
        }
        CadApp.height = hh
        CadApp.mode = 0
        CA_HudOpenPad()
        ReturnValue(0)
    }
}

Function.CA_ChamferEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 5) ThenBlock: { ReturnValue(-1) }
        CadApp.feat_sel = feat_i
        dd = CadApp.chamfer_d
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            da = ArrayGet(CadApp.feat_aux, feat_i)
            IfCondition GreaterThan(da, 0) ThenBlock: { dd = da }
        }
        IfCondition LessThan(dd, 1) ThenBlock: { dd = 2 }
        CadApp.chamfer_d = dd
        CadApp.chamfer_edit = 1
        CadApp.fillet_edit = 0
        CadApp.mode = 0
        CadApp.tool = 10
        CA_LogInt("cad_app: edit chamfer D=", 24, dd)
        CA_HudOpenChamfer()
        ReturnValue(0)
    }
}

Function.CA_Fillet3dEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 4) ThenBlock: { ReturnValue(-1) }
        CadApp.feat_sel = feat_i
        rr = Float_ToInt(CadApp.fillet_r)
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            da = ArrayGet(CadApp.feat_aux, feat_i)
            IfCondition GreaterThan(da, 0) ThenBlock: { rr = da }
        }
        IfCondition LessThan(rr, 1) ThenBlock: { rr = 2 }
        CadApp.fillet_r = Float_FromInt(rr)
        CadApp.fillet_edit = 1
        CadApp.chamfer_edit = 0
        CadApp.mode = 0
        CadApp.tool = 8
        CA_LogInt("cad_app: edit fillet R=", 23, rr)
        CA_HudOpenFillet3d()
        ReturnValue(0)
    }
}

Function.CA_CstrApplyPending {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        ct = CadApp.cstr_type
        v = CadApp.cstr_rval
        IfCondition GreaterEqual(CadApp.last_cstr, 0) ThenBlock: {
            CAD_Sketch.SetConstraintValue(CadApp.sketch, CadApp.last_cstr, v)
            CA_SolveNow()
            ReturnValue(0)
        }
        IfCondition EqualTo(ct, 20) ThenBlock: {
            IfCondition GreaterEqual(CadApp.last_upt, 0) ThenBlock: {
                CAD_Sketch.SetUserPoint(CadApp.sketch, CadApp.last_upt, Float_FromInt(CadApp.cstr_u), Float_FromInt(CadApp.cstr_v))
                CadApp.dirty = 1
                CA_HistPush(14)
                ReturnValue(0)
            }
            pi = CAD_Sketch.AddUserPoint(CadApp.sketch, Float_FromInt(CadApp.cstr_u), Float_FromInt(CadApp.cstr_v), 0)
            CadApp.last_upt = pi
            CadApp.dirty = 1
            CA_FeatAdd(14, CA_CurrentSkIdx())
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                ArraySet(CadApp.feat_aux, CadApp.feat_sel, pi)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(ct, 2) ThenBlock: {
            CAD_Sketch.AddConstraint(CadApp.sketch, 2, CadApp.cstr_ka, CadApp.cstr_ia, v)
            CA_SolveNow()
            CA_CstrRemember()
            ReturnValue(0)
        }
        IfCondition EqualTo(ct, 3) ThenBlock: {
            CAD_Sketch.AddConstraint(CadApp.sketch, 3, CadApp.cstr_ka, CadApp.cstr_ia, v)
            CA_SolveNow()
            CA_CstrRemember()
            ReturnValue(0)
        }
        IfCondition EqualTo(ct, 6) ThenBlock: {
            CAD_Sketch.AddConstraint(CadApp.sketch, 6, CadApp.cstr_ka, CadApp.cstr_ia, v)
            CA_SolveNow()
            CA_CstrRemember()
            ReturnValue(0)
        }
        IfCondition EqualTo(ct, 11) ThenBlock: {
            CAD_Sketch.AddConstraint(CadApp.sketch, 11, 4, CadApp.cstr_ia, v)
            CA_SolveNow()
            CA_CstrRemember()
            ReturnValue(0)
        }
        IfCondition EqualTo(ct, 15) ThenBlock: {
            cid = CAD_Sketch.AddConstraint2(CadApp.sketch, 15, CadApp.cstr_ka, CadApp.cstr_ia, CadApp.cstr_kb, CadApp.cstr_ib)
            CAD_Sketch.SetConstraintValue(CadApp.sketch, cid, v)
            CA_SolveNow()
            CA_CstrRemember()
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.CA_CstrRemember {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(CadApp.sketch, 20)
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(-1) }
        CadApp.last_cstr = Subtract(n, 1)
        CA_FeatAdd(13, CA_CurrentSkIdx())
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.last_cstr)
        }
        ReturnValue(0)
    }
}

Function.CA_FilletEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.fl_tab, 0) ThenBlock: {
            CadApp.fl_tab = Allocate(2048)
            CadApp.fl_n = 0
        }
        IfCondition EqualTo(CadApp.fl_tab, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

Function.CA_FilletSnap {
    Input: li: Integer
    Input: lj: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_FilletEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(CadApp.fl_n, 16) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        b = Multiply(CadApp.fl_n, 16)
        ArraySet(CadApp.fl_tab, b, li)
        ArraySet(CadApp.fl_tab, Add(b, 1), lj)
        ArraySet(CadApp.fl_tab, Add(b, 2), Float_ToInt(CadApp.fillet_r))
        ArraySet(CadApp.fl_tab, Add(b, 4), CadApp.sketch)
        xy = Allocate(32)
        CAD_Sketch.GetLineEnd(CadApp.sketch, li, 0, xy)
        ArraySet(CadApp.fl_tab, Add(b, 5), ArrayGet(xy, 0))
        ArraySet(CadApp.fl_tab, Add(b, 6), ArrayGet(xy, 1))
        CAD_Sketch.GetLineEnd(CadApp.sketch, li, 1, xy)
        ArraySet(CadApp.fl_tab, Add(b, 7), ArrayGet(xy, 0))
        ArraySet(CadApp.fl_tab, Add(b, 8), ArrayGet(xy, 1))
        CAD_Sketch.GetLineEnd(CadApp.sketch, lj, 0, xy)
        ArraySet(CadApp.fl_tab, Add(b, 9), ArrayGet(xy, 0))
        ArraySet(CadApp.fl_tab, Add(b, 10), ArrayGet(xy, 1))
        CAD_Sketch.GetLineEnd(CadApp.sketch, lj, 1, xy)
        ArraySet(CadApp.fl_tab, Add(b, 11), ArrayGet(xy, 0))
        ArraySet(CadApp.fl_tab, Add(b, 12), ArrayGet(xy, 1))
        Deallocate(xy, 32)
        ReturnValue(0)
    }
}

Function.CA_FilletRemember {
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_FilletEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        na = CAD_Sketch.GetArcCount(CadApp.sketch)
        ai = Subtract(na, 1)
        IfCondition LessThan(ai, 0) ThenBlock: { ai = 0 }
        b = Multiply(CadApp.fl_n, 16)
        ArraySet(CadApp.fl_tab, Add(b, 3), ai)
        CadApp.last_fillet = CadApp.fl_n
        CadApp.fl_n = Add(CadApp.fl_n, 1)
        CA_FeatAdd(12, CA_CurrentSkIdx())
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.last_fillet)
        }
        ReturnValue(0)
    }
}

Function.CA_FilletRebuild {
    Input: pi: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_FilletEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(pi, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(pi, CadApp.fl_n) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        b = Multiply(pi, 16)
        li = ArrayGet(CadApp.fl_tab, b)
        lj = ArrayGet(CadApp.fl_tab, Add(b, 1))
        ai = ArrayGet(CadApp.fl_tab, Add(b, 3))
        CAD_Sketch.SetLine(CadApp.sketch, li, ArrayGet(CadApp.fl_tab, Add(b, 5)), ArrayGet(CadApp.fl_tab, Add(b, 6)), ArrayGet(CadApp.fl_tab, Add(b, 7)), ArrayGet(CadApp.fl_tab, Add(b, 8)))
        CAD_Sketch.SetLine(CadApp.sketch, lj, ArrayGet(CadApp.fl_tab, Add(b, 9)), ArrayGet(CadApp.fl_tab, Add(b, 10)), ArrayGet(CadApp.fl_tab, Add(b, 11)), ArrayGet(CadApp.fl_tab, Add(b, 12)))
        IfCondition GreaterEqual(ai, 0) ThenBlock: {
            CAD_Sketch.DeleteArc(CadApp.sketch, ai)
        }
        rc = CAD_Sketch.FilletLines(CadApp.sketch, li, lj, CadApp.fillet_r)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            na = CAD_Sketch.GetArcCount(CadApp.sketch)
            ArraySet(CadApp.fl_tab, Add(b, 3), Subtract(na, 1))
            ArraySet(CadApp.fl_tab, Add(b, 2), Float_ToInt(CadApp.fillet_r))
            CA_HistPush(12)
            CA_SolveNow()
        }
        ReturnValue(rc)
    }
}

Function.CA_FilletEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 12) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(CA_FilletEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        pi = 0
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            pi = ArrayGet(CadApp.feat_aux, feat_i)
        }
        IfCondition LessThan(pi, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(pi, CadApp.fl_n) ThenBlock: { ReturnValue(-1) }
        b = Multiply(pi, 16)
        rm = ArrayGet(CadApp.fl_tab, Add(b, 2))
        IfCondition GreaterThan(rm, 0) ThenBlock: { CadApp.fillet_r = Float_FromInt(rm) }
        CadApp.last_fillet = pi
        CadApp.tool = 8
        CadApp.mode = 1
        CadApp.nclick = 0
        CadApp.feat_sel = feat_i
        CA_HudOpenFillet()
        ReturnValue(0)
    }
}

Function.CA_PointEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 14) ThenBlock: { ReturnValue(-1) }
        pi = 0
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            pi = ArrayGet(CadApp.feat_aux, feat_i)
        }
        CadApp.last_upt = pi
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            xy = Allocate(32)
            IfCondition EqualTo(CAD_Sketch.GetUserPoint(CadApp.sketch, pi, xy), 0) ThenBlock: {
                CadApp.cstr_u = Float_ToInt(ArrayGet(xy, 0))
                CadApp.cstr_v = Float_ToInt(ArrayGet(xy, 1))
            }
            Deallocate(xy, 32)
        }
        CadApp.cstr_type = 20
        CadApp.cstr_ready = 1
        CadApp.last_cstr = -1
        CadApp.tool = 6
        CadApp.mode = 1
        CadApp.nclick = 0
        CadApp.feat_sel = feat_i
        CA_HudOpenCstr()
        ReturnValue(0)
    }
}

Function.CA_CstrEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 13) ThenBlock: { ReturnValue(-1) }
        ci = 0
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ci = ArrayGet(CadApp.feat_aux, feat_i)
        }
        CadApp.last_cstr = ci
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            n = CAD_Store.Read(CadApp.sketch, 20)
            IfCondition LessThan(ci, n) ThenBlock: {
                cstr = CAD_Store.Read(CadApp.sketch, 21)
                CadApp.cstr_type = ArrayGet(cstr, Multiply(ci, 8))
                CadApp.cstr_val = Float_ToInt(ArrayGet(cstr, Add(Multiply(ci, 8), 3)))
            }
        }
        CadApp.tool = 7
        CadApp.mode = 1
        CadApp.nclick = 0
        CadApp.feat_sel = feat_i
        CadApp.cstr_ready = 1
        CA_HudOpenCstr()
        ReturnValue(0)
    }
}

Function.CA_LineRemember {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.last_line, 0) ThenBlock: { ReturnValue(-1) }
        CA_FeatAdd(9, CA_CurrentSkIdx())
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.last_line)
        }
        ReturnValue(0)
    }
}

Function.CA_CircRemember {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        nc = CAD_Sketch.GetCircleCount(CadApp.sketch)
        IfCondition LessThan(nc, 1) ThenBlock: { ReturnValue(-1) }
        CadApp.last_circ = Subtract(nc, 1)
        rr = CAD_Sketch.GetCircleRadius(CadApp.sketch, CadApp.last_circ)
        CadApp.circ_r = Float_ToInt(rr)
        IfCondition LessThan(CadApp.circ_r, 0) ThenBlock: { CadApp.circ_r = Subtract(0, CadApp.circ_r) }
        CadApp.circ_d = Multiply(CadApp.circ_r, 2)
        CA_FeatAdd(10, CA_CurrentSkIdx())
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.last_circ)
        }
        ReturnValue(0)
    }
}

Function.CA_RectEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.rt_tab, 0) ThenBlock: {
            CadApp.rt_tab = Allocate(1280)
            CadApp.rt_n = 0
        }
        IfCondition EqualTo(CadApp.rt_tab, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

Function.CA_RectRemember {
    Input: mode: Integer
    Input: cx: Integer
    Input: cy: Integer
    Input: x1: Integer
    Input: y1: Integer
    Input: ht: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_RectEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(CadApp.rt_n, 16) ThenBlock: { ReturnValue(-1) }
        nl = CAD_Sketch.GetLineCount(CadApp.sketch)
        line0 = Subtract(nl, 4)
        IfCondition LessThan(line0, 0) ThenBlock: { line0 = 0 }
        b = Multiply(CadApp.rt_n, 10)
        ArraySet(CadApp.rt_tab, b, line0)
        ArraySet(CadApp.rt_tab, Add(b, 1), CadApp.rect_w)
        ArraySet(CadApp.rt_tab, Add(b, 2), CadApp.rect_h)
        ArraySet(CadApp.rt_tab, Add(b, 3), mode)
        ArraySet(CadApp.rt_tab, Add(b, 4), CadApp.sketch)
        ArraySet(CadApp.rt_tab, Add(b, 5), cx)
        ArraySet(CadApp.rt_tab, Add(b, 6), cy)
        ArraySet(CadApp.rt_tab, Add(b, 7), x1)
        ArraySet(CadApp.rt_tab, Add(b, 8), y1)
        ArraySet(CadApp.rt_tab, Add(b, 9), ht)
        CadApp.last_rect = CadApp.rt_n
        CadApp.rt_n = Add(CadApp.rt_n, 1)
        CA_FeatAdd(11, CA_CurrentSkIdx())
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.last_rect)
        }
        ReturnValue(CadApp.last_rect)
    }
}

Function.CA_PlaceRectCenter {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
        }
        IfCondition LessThan(CadApp.rect_w, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(CadApp.rect_h, 1) ThenBlock: { CadApp.rect_h = CadApp.rect_w }
        hw = Float_Div(Float_FromInt(CadApp.rect_w), 0x4000000000000000)
        hh = Float_Div(Float_FromInt(CadApp.rect_h), 0x4000000000000000)
        cx = CadApp.cx0
        cy = CadApp.cy0
        x0 = Float_Sub(cx, hw)
        y0 = Float_Sub(cy, hh)
        x1 = Float_Add(cx, hw)
        y1 = Float_Add(cy, hh)
        CAD_Sketch.AddLine(CadApp.sketch, x0, y0, x1, y0)
        CAD_Sketch.AddLine(CadApp.sketch, x1, y0, x1, y1)
        CAD_Sketch.AddLine(CadApp.sketch, x1, y1, x0, y1)
        CAD_Sketch.AddLine(CadApp.sketch, x0, y1, x0, y0)
        CAD_Sketch.RebuildAnchors(CadApp.sketch)
        CadApp.dirty = 1
        CA_InvalidateProfiles()
        CA_RectRemember(1, cx, cy, x1, y1, 0)
        CadApp.nclick = 0
        CA_RectMeasure(CadApp.last_rect)
        ReturnValue(0)
    }
}

Function.CA_RectMeasure {
    Input: pi: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(pi, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.rt_tab, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        b = Multiply(pi, 10)
        CadApp.pick_n = ArrayGet(CadApp.rt_tab, b)
        xy = Allocate(32)
        CAD_Sketch.GetLineEnd(CadApp.sketch, CadApp.pick_n, 0, xy)
        CadAppPick.ox = ArrayGet(xy, 0)
        CadAppPick.oy = ArrayGet(xy, 1)
        CadAppPick.ax = CadAppPick.ox
        CadAppPick.ay = CadAppPick.oy
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, 4) {
            CAD_Sketch.GetLineEnd(CadApp.sketch, Add(CadApp.pick_n, CadAppPick.pi), 0, xy)
            CadAppPick.wx = ArrayGet(xy, 0)
            CadAppPick.wy = ArrayGet(xy, 1)
            IfCondition EqualTo(Float_Le(CadAppPick.wx, CadAppPick.ox), 1) ThenBlock: { CadAppPick.ox = CadAppPick.wx }
            IfCondition EqualTo(Float_Le(CadAppPick.ax, CadAppPick.wx), 1) ThenBlock: { CadAppPick.ax = CadAppPick.wx }
            IfCondition EqualTo(Float_Le(CadAppPick.wy, CadAppPick.oy), 1) ThenBlock: { CadAppPick.oy = CadAppPick.wy }
            IfCondition EqualTo(Float_Le(CadAppPick.ay, CadAppPick.wy), 1) ThenBlock: { CadAppPick.ay = CadAppPick.wy }
            CAD_Sketch.GetLineEnd(CadApp.sketch, Add(CadApp.pick_n, CadAppPick.pi), 1, xy)
            CadAppPick.wx = ArrayGet(xy, 0)
            CadAppPick.wy = ArrayGet(xy, 1)
            IfCondition EqualTo(Float_Le(CadAppPick.wx, CadAppPick.ox), 1) ThenBlock: { CadAppPick.ox = CadAppPick.wx }
            IfCondition EqualTo(Float_Le(CadAppPick.ax, CadAppPick.wx), 1) ThenBlock: { CadAppPick.ax = CadAppPick.wx }
            IfCondition EqualTo(Float_Le(CadAppPick.wy, CadAppPick.oy), 1) ThenBlock: { CadAppPick.oy = CadAppPick.wy }
            IfCondition EqualTo(Float_Le(CadAppPick.ay, CadAppPick.wy), 1) ThenBlock: { CadAppPick.ay = CadAppPick.wy }
            CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        Deallocate(xy, 32)
        wu = Float_ToInt(Float_Add(Float_Sub(CadAppPick.ax, CadAppPick.ox), 0x3FE0000000000000))
        hv = Float_ToInt(Float_Add(Float_Sub(CadAppPick.ay, CadAppPick.oy), 0x3FE0000000000000))
        IfCondition LessThan(wu, 0) ThenBlock: { wu = Subtract(0, wu) }
        IfCondition LessThan(hv, 0) ThenBlock: { hv = Subtract(0, hv) }
        CadApp.rect_w = wu
        CadApp.rect_h = hv
        ArraySet(CadApp.rt_tab, Add(b, 1), wu)
        ArraySet(CadApp.rt_tab, Add(b, 2), hv)
        CA_LogInt("cad_app: rect measured W=", 25, wu)
        CA_LogInt("cad_app: rect measured H=", 25, hv)
        ReturnValue(0)
    }
}

Function.CA_RectRebuild {
    Input: pi: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_RectEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(pi, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(pi, CadApp.rt_n) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        b = Multiply(pi, 10)
        line0 = ArrayGet(CadApp.rt_tab, b)
        mode = ArrayGet(CadApp.rt_tab, Add(b, 3))
        ArraySet(CadApp.rt_tab, Add(b, 1), CadApp.rect_w)
        ArraySet(CadApp.rt_tab, Add(b, 2), CadApp.rect_h)
        w = Float_FromInt(CadApp.rect_w)
        h = Float_FromInt(CadApp.rect_h)
        IfCondition NotEqual(mode, 2) ThenBlock: {
            cx = ArrayGet(CadApp.rt_tab, Add(b, 5))
            cy = ArrayGet(CadApp.rt_tab, Add(b, 6))
            hw = Float_Div(w, 0x4000000000000000)
            hh = Float_Div(h, 0x4000000000000000)
            xa = Float_Sub(cx, hw)
            ya = Float_Sub(cy, hh)
            xb = Float_Add(cx, hw)
            yb = Float_Add(cy, hh)
            CAD_Sketch.SetLine(CadApp.sketch, line0, xa, ya, xb, ya)
            CAD_Sketch.SetLine(CadApp.sketch, Add(line0, 1), xb, ya, xb, yb)
            CAD_Sketch.SetLine(CadApp.sketch, Add(line0, 2), xb, yb, xa, yb)
            CAD_Sketch.SetLine(CadApp.sketch, Add(line0, 3), xa, yb, xa, ya)
        }
        IfCondition EqualTo(mode, 2) ThenBlock: {
            x0 = ArrayGet(CadApp.rt_tab, Add(b, 5))
            y0 = ArrayGet(CadApp.rt_tab, Add(b, 6))
            x1 = ArrayGet(CadApp.rt_tab, Add(b, 7))
            y1 = ArrayGet(CadApp.rt_tab, Add(b, 8))
            edx = Float_Sub(x1, x0)
            edy = Float_Sub(y1, y0)
            elen = CAD_Num.Sqrt(Float_Add(Float_Mul(edx, edx), Float_Mul(edy, edy)))
            IfCondition EqualTo(CAD_Num.IsZero(elen, 0), 1) ThenBlock: { ReturnValue(-3) }
            ux = Float_Div(edx, elen)
            uy = Float_Div(edy, elen)
            nx = Float_Sub(0, uy)
            ny = ux
            x1n = Float_Add(x0, Float_Mul(ux, w))
            y1n = Float_Add(y0, Float_Mul(uy, w))
            oldh = ArrayGet(CadApp.rt_tab, Add(b, 9))
            sgn = 0x3FF0000000000000
            IfCondition EqualTo(Float_Le(oldh, 0), 1) ThenBlock: { sgn = Float_Sub(0, sgn) }
            qx = Float_Mul(nx, Float_Mul(h, sgn))
            qy = Float_Mul(ny, Float_Mul(h, sgn))
            CAD_Sketch.SetLine(CadApp.sketch, line0, x0, y0, x1n, y1n)
            CAD_Sketch.SetLine(CadApp.sketch, Add(line0, 1), x1n, y1n, Float_Add(x1n, qx), Float_Add(y1n, qy))
            CAD_Sketch.SetLine(CadApp.sketch, Add(line0, 2), Float_Add(x1n, qx), Float_Add(y1n, qy), Float_Add(x0, qx), Float_Add(y0, qy))
            CAD_Sketch.SetLine(CadApp.sketch, Add(line0, 3), Float_Add(x0, qx), Float_Add(y0, qy), x0, y0)
            ArraySet(CadApp.rt_tab, Add(b, 7), x1n)
            ArraySet(CadApp.rt_tab, Add(b, 8), y1n)
            ArraySet(CadApp.rt_tab, Add(b, 9), Float_Mul(h, sgn))
        }
        CAD_Sketch.RebuildAnchors(CadApp.sketch)
        CadApp.dirty = 1
        CA_InvalidateProfiles()
        CA_HistPush(11)
        CA_RectMeasure(pi)
        ReturnValue(0)
    }
}

Function.CA_LineEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 9) ThenBlock: { ReturnValue(-1) }
        li = 0
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            li = ArrayGet(CadApp.feat_aux, feat_i)
        }
        CadApp.last_line = li
        CadApp.tool = 0
        CadApp.mode = 1
        CadApp.nclick = 0
        CadApp.feat_sel = feat_i
        CA_HudOpenLine()
        ReturnValue(0)
    }
}

Function.CA_CircEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 10) ThenBlock: { ReturnValue(-1) }
        ci = 0
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ci = ArrayGet(CadApp.feat_aux, feat_i)
        }
        CadApp.last_circ = ci
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            rr = CAD_Sketch.GetCircleRadius(CadApp.sketch, ci)
            CadApp.circ_r = Float_ToInt(rr)
            IfCondition LessThan(CadApp.circ_r, 0) ThenBlock: { CadApp.circ_r = Subtract(0, CadApp.circ_r) }
            CadApp.circ_d = Multiply(CadApp.circ_r, 2)
        }
        CadApp.tool = 2
        CadApp.mode = 1
        CadApp.nclick = 0
        CadApp.feat_sel = feat_i
        CA_HudOpenCirc()
        ReturnValue(0)
    }
}

Function.CA_RectEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 11) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(CA_RectEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        pi = 0
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            pi = ArrayGet(CadApp.feat_aux, feat_i)
        }
        IfCondition LessThan(pi, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(pi, CadApp.rt_n) ThenBlock: { ReturnValue(-1) }
        b = Multiply(pi, 10)
        CadApp.rect_w = ArrayGet(CadApp.rt_tab, Add(b, 1))
        CadApp.rect_h = ArrayGet(CadApp.rt_tab, Add(b, 2))
        CadApp.cx0 = ArrayGet(CadApp.rt_tab, Add(b, 5))
        CadApp.cy0 = ArrayGet(CadApp.rt_tab, Add(b, 6))
        sk = ArrayGet(CadApp.rt_tab, Add(b, 4))
        IfCondition NotEqual(sk, 0) ThenBlock: { CadApp.sketch = sk }
        CadApp.last_rect = pi
        CadApp.tool = 1
        CadApp.mode = 1
        CadApp.nclick = 0
        CadApp.feat_sel = feat_i
        CA_HudOpenRect()
        ReturnValue(0)
    }
}

Function.CA_HudTab {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.hud_kind, 1) ThenBlock: {
            IfCondition EqualTo(CadApp.poly_mode, 0) ThenBlock: {
                CadApp.hud_field = Add(CadApp.hud_field, 1)
                IfCondition GreaterThan(CadApp.hud_field, 2) ThenBlock: { CadApp.hud_field = 0 }
            }
            IfCondition NotEqual(CadApp.poly_mode, 0) ThenBlock: {
                CadApp.hud_field = 0
            }
        }
        IfCondition EqualTo(CadApp.hud_kind, 2) ThenBlock: {
            nf = 0
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { nf = 1 }
            CadApp.hud_field = nf
        }
        IfCondition EqualTo(CadApp.hud_kind, 3) ThenBlock: {
            nf = 0
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { nf = 1 }
            CadApp.hud_field = nf
        }
        IfCondition EqualTo(CadApp.hud_kind, 4) ThenBlock: {
            nf = 0
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { nf = 1 }
            CadApp.hud_field = nf
        }
        IfCondition EqualTo(CadApp.hud_kind, 6) ThenBlock: {
            IfCondition EqualTo(CadApp.cstr_type, 20) ThenBlock: {
                nf = 0
                IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { nf = 1 }
                CadApp.hud_field = nf
            }
        }
        IfCondition EqualTo(CadApp.hud_kind, 7) ThenBlock: {
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: {
                CadApp.extrude_op = Add(CadApp.extrude_op, 1)
                IfCondition GreaterThan(CadApp.extrude_op, 2) ThenBlock: { CadApp.extrude_op = 0 }
                IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
                    IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: { CadApp.extrude_op = 2 }
                }
            }
            IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: {
                CadApp.hud_field = 0
            }
        }
        CA_WriteDimHud()
        ReturnValue(0)
    }
}

// D = L / sin(π/N)   L = D * sin(π/N)
Function.CA_PolySyncFromSide {
    Output: Integer
    Body: {
        n = CadApp.poly_n
        IfCondition LessThan(n, 3) ThenBlock: {
            CadApp.poly_diam = 0
            ReturnValue(0)
        }
        IfCondition LessThan(CadApp.poly_side, 1) ThenBlock: {
            ReturnValue(0)
        }
        pin = Float_Div(0x400921FB54442D18, Float_FromInt(n))
        s = CAD_Geom.Sin(pin)
        IfCondition EqualTo(CAD_Num.IsZero(s, 0), 1) ThenBlock: { ReturnValue(0) }
        d = Float_Div(Float_FromInt(CadApp.poly_side), s)
        CadApp.poly_diam = Float_ToInt(d)
        IfCondition LessThan(CadApp.poly_diam, 0) ThenBlock: { CadApp.poly_diam = Subtract(0, CadApp.poly_diam) }
        ReturnValue(0)
    }
}

Function.CA_PolySyncFromDiam {
    Output: Integer
    Body: {
        n = CadApp.poly_n
        IfCondition LessThan(n, 3) ThenBlock: {
            CadApp.poly_side = 0
            ReturnValue(0)
        }
        IfCondition LessThan(CadApp.poly_diam, 1) ThenBlock: { ReturnValue(0) }
        pin = Float_Div(0x400921FB54442D18, Float_FromInt(n))
        s = CAD_Geom.Sin(pin)
        IfCondition EqualTo(CAD_Num.IsZero(s, 0), 1) ThenBlock: { ReturnValue(0) }
        L = Float_Mul(Float_FromInt(CadApp.poly_diam), s)
        CadApp.poly_side = Float_ToInt(L)
        IfCondition LessThan(CadApp.poly_side, 0) ThenBlock: { CadApp.poly_side = Subtract(0, CadApp.poly_side) }
        ReturnValue(0)
    }
}

// Polygon feature table: 16 records × 10 words
// 0 n  1 side  2 diam  3 line0  4 nl  5 sk  6 cx  7 cy  8 ang  9 pad
Function.CA_PolyEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.pg_tab, 0) ThenBlock: {
            CadApp.pg_tab = Allocate(1280)
            CadApp.pg_n = 0
        }
        IfCondition EqualTo(CadApp.pg_tab, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

Function.CA_PolyRemember {
    Input: ang: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_PolyEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(CadApp.pg_n, 16) ThenBlock: { ReturnValue(-1) }
        n = CadApp.poly_n
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(-1) }
        nl = CAD_Sketch.GetLineCount(CadApp.sketch)
        line0 = Subtract(nl, n)
        IfCondition LessThan(line0, 0) ThenBlock: { line0 = 0 }
        b = Multiply(CadApp.pg_n, 10)
        ArraySet(CadApp.pg_tab, b, n)
        ArraySet(CadApp.pg_tab, Add(b, 1), CadApp.poly_side)
        ArraySet(CadApp.pg_tab, Add(b, 2), CadApp.poly_diam)
        ArraySet(CadApp.pg_tab, Add(b, 3), line0)
        ArraySet(CadApp.pg_tab, Add(b, 4), n)
        ArraySet(CadApp.pg_tab, Add(b, 5), CadApp.sketch)
        ArraySet(CadApp.pg_tab, Add(b, 6), CadApp.cx0)
        ArraySet(CadApp.pg_tab, Add(b, 7), CadApp.cy0)
        ArraySet(CadApp.pg_tab, Add(b, 8), ang)
        ArraySet(CadApp.pg_tab, Add(b, 9), 0)
        CadApp.last_poly = CadApp.pg_n
        CadApp.pg_n = Add(CadApp.pg_n, 1)
        CA_FeatAdd(8, CA_CurrentSkIdx())
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.last_poly)
        }
        CA_Log("cad_app: polygon feature\n", 24)
        ReturnValue(CadApp.last_poly)
    }
}

Function.CA_PolyRebuild {
    Input: pi: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_PolyEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(pi, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(pi, CadApp.pg_n) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        b = Multiply(pi, 10)
        oldn = ArrayGet(CadApp.pg_tab, b)
        line0 = ArrayGet(CadApp.pg_tab, Add(b, 3))
        n = CadApp.poly_n
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(-2) }
        cx = ArrayGet(CadApp.pg_tab, Add(b, 6))
        cy = ArrayGet(CadApp.pg_tab, Add(b, 7))
        ang = ArrayGet(CadApp.pg_tab, Add(b, 8))
        rad = 0
        IfCondition GreaterThan(CadApp.poly_side, 0) ThenBlock: {
            pin = Float_Div(0x400921FB54442D18, Float_FromInt(n))
            s = CAD_Geom.Sin(pin)
            IfCondition EqualTo(CAD_Num.IsZero(s, 0), 0) ThenBlock: {
                rad = Float_Div(Float_FromInt(CadApp.poly_side), Float_Mul(0x4000000000000000, s))
            }
        }
        IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 1) ThenBlock: {
            IfCondition GreaterThan(CadApp.poly_diam, 0) ThenBlock: {
                rad = Float_Div(Float_FromInt(CadApp.poly_diam), 0x4000000000000000)
            }
        }
        IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 1) ThenBlock: { ReturnValue(-3) }
        two_pi = 0x401921FB54442D18
        step = Float_Div(two_pi, Float_FromInt(n))
        IfCondition EqualTo(n, oldn) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, n) {
                a0 = Float_Add(ang, Float_Mul(step, Float_FromInt(i)))
                a1 = Float_Add(ang, Float_Mul(step, Float_FromInt(Add(i, 1))))
                xa = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a0)))
                ya = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a0)))
                xb = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a1)))
                yb = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a1)))
                CAD_Sketch.SetLine(CadApp.sketch, Add(line0, i), xa, ya, xb, yb)
                i = Add(i, 1)
            }
        }
        IfCondition NotEqual(n, oldn) ThenBlock: {
            i = Subtract(Add(line0, oldn), 1)
            WhileLoop GreaterEqual(i, line0) {
                last = Subtract(CAD_Sketch.GetLineCount(CadApp.sketch), 1)
                CAD_Sketch.DeleteLine(CadApp.sketch, i)
                j = 0
                WhileLoop LessThan(j, CadApp.pg_n) {
                    lo = ArrayGet(CadApp.pg_tab, Add(Multiply(j, 10), 3))
                    IfCondition EqualTo(lo, last) ThenBlock: {
                        ArraySet(CadApp.pg_tab, Add(Multiply(j, 10), 3), i)
                    }
                    j = Add(j, 1)
                }
                i = Subtract(i, 1)
            }
            CAD_UI_State.nsides = n
            hx = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang)))
            hy = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang)))
            CAD_UI.Pend2(cx, cy, hx, hy)
            CAD_UI.AddNGon(CadApp.sketch)
            line0 = Subtract(CAD_Sketch.GetLineCount(CadApp.sketch), n)
            ArraySet(CadApp.pg_tab, Add(b, 3), line0)
        }
        ArraySet(CadApp.pg_tab, b, n)
        ArraySet(CadApp.pg_tab, Add(b, 1), CadApp.poly_side)
        ArraySet(CadApp.pg_tab, Add(b, 2), CadApp.poly_diam)
        ArraySet(CadApp.pg_tab, Add(b, 4), n)
        CAD_Sketch.RebuildAnchors(CadApp.sketch)
        CadApp.dirty = 1
        CA_InvalidateProfiles()
        CA_HistPush(8)
        CA_Log("cad_app: polygon rebuilt\n", 24)
        ReturnValue(0)
    }
}

Function.CA_PolyEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 8) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(CA_PolyEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        pi = 0
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            pi = ArrayGet(CadApp.feat_aux, feat_i)
        }
        IfCondition LessThan(pi, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(pi, CadApp.pg_n) ThenBlock: { ReturnValue(-1) }
        b = Multiply(pi, 10)
        CadApp.poly_n = ArrayGet(CadApp.pg_tab, b)
        CadApp.poly_side = ArrayGet(CadApp.pg_tab, Add(b, 1))
        CadApp.poly_diam = ArrayGet(CadApp.pg_tab, Add(b, 2))
        CadApp.cx0 = ArrayGet(CadApp.pg_tab, Add(b, 6))
        CadApp.cy0 = ArrayGet(CadApp.pg_tab, Add(b, 7))
        sk = ArrayGet(CadApp.pg_tab, Add(b, 5))
        IfCondition NotEqual(sk, 0) ThenBlock: { CadApp.sketch = sk }
        CadApp.last_poly = pi
        CadApp.tool = 17
        CadApp.poly_mode = 0
        CadApp.nclick = 1
        CadApp.mode = 1
        CadApp.feat_sel = feat_i
        CA_HudOpenPoly()
        CA_Log("cad_app: edit polygon\n", 22)
        ReturnValue(0)
    }
}

// Regular n-gon about last center click. rad = circumradius (float bits).
Function.CA_PlacePolyR {
    Input: rad: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 1) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
        }
        n = CadApp.poly_n
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(-2) }
        CAD_UI_State.nsides = n
        cx = CadApp.cx0
        cy = CadApp.cy0
        hx = Float_Add(cx, rad)
        hy = cy
        IfCondition EqualTo(CadApp.hover_ok, 1) ThenBlock: {
            IfCondition EqualTo(CadAppIpc.hxy, 0) ThenBlock: { CadAppIpc.hxy = Allocate(32) }
            IfCondition NotEqual(CadAppIpc.hxy, 0) ThenBlock: {
                CA_PixToWorld(CadApp.hover_px, CadApp.hover_py, CadAppIpc.hxy)
                dx = Float_Sub(ArrayGet(CadAppIpc.hxy, 0), cx)
                dy = Float_Sub(ArrayGet(CadAppIpc.hxy, 1), cy)
                ln = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 0) ThenBlock: {
                    hx = Float_Add(cx, Float_Mul(rad, Float_Div(dx, ln)))
                    hy = Float_Add(cy, Float_Mul(rad, Float_Div(dy, ln)))
                }
            }
        }
        CAD_UI.Pend2(cx, cy, hx, hy)
        rc = 0
        IfCondition GreaterEqual(CadApp.last_poly, 0) ThenBlock: {
            ang = CAD_Geom.Atan2(Float_Sub(hy, cy), Float_Sub(hx, cx))
            b = Multiply(CadApp.last_poly, 10)
            IfCondition NotEqual(CadApp.pg_tab, 0) ThenBlock: {
                ArraySet(CadApp.pg_tab, Add(b, 8), ang)
                ArraySet(CadApp.pg_tab, Add(b, 6), cx)
                ArraySet(CadApp.pg_tab, Add(b, 7), cy)
            }
            rc = CA_PolyRebuild(CadApp.last_poly)
        }
        IfCondition LessThan(CadApp.last_poly, 0) ThenBlock: {
            rc = CAD_UI.AddNGon(CadApp.sketch)
            IfCondition EqualTo(rc, 0) ThenBlock: {
                ang = CAD_Geom.Atan2(Float_Sub(hy, cy), Float_Sub(hx, cx))
                CA_PolyRemember(ang)
            }
        }
        IfCondition EqualTo(rc, 0) ThenBlock: {
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            CA_Log("cad_app: poly HUD place\n", 24)
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CA_HudClose()
        }
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: poly HUD place fail\n", 29)
        }
        ReturnValue(rc)
    }
}

Function.CA_PlacePolyCenter {
    Output: Integer
    Body: {
        n = CadApp.poly_n
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(-2) }
        rad = 0
        IfCondition GreaterThan(CadApp.poly_side, 0) ThenBlock: {
            pin = Float_Div(0x400921FB54442D18, Float_FromInt(n))
            s = CAD_Geom.Sin(pin)
            IfCondition EqualTo(CAD_Num.IsZero(s, 0), 0) ThenBlock: {
                rad = Float_Div(Float_FromInt(CadApp.poly_side), Float_Mul(0x4000000000000000, s))
            }
        }
        IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 1) ThenBlock: {
            IfCondition GreaterThan(CadApp.poly_diam, 0) ThenBlock: {
                rad = Float_Div(Float_FromInt(CadApp.poly_diam), 0x4000000000000000)
            }
        }
        rc = CA_PlacePolyR(rad)
        ReturnValue(rc)
    }
}

// hundredths: 2045 → 20.45 mm or deg. Active field from hud_kind/hud_field.
Function.CA_HudEnter {
    Input: centi: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.hud_kind, 0) ThenBlock: { ReturnValue(0) }
        mm = Divide(centi, 100)
        IfCondition LessThan(centi, 0) ThenBlock: {
            mm = Divide(centi, 100)
        }
        v = Float_Div(Float_FromInt(centi), Float_FromInt(100))
        IfCondition EqualTo(CadApp.hud_kind, 1) ThenBlock: {
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: {
                nn = mm
                IfCondition LessThan(nn, 2) ThenBlock: { nn = 2 }
                IfCondition GreaterThan(nn, 64) ThenBlock: { nn = 64 }
                CadApp.poly_n = nn
                CAD_UI_State.nsides = nn
                CA_PolySyncFromSide()
                IfCondition GreaterEqual(CadApp.last_poly, 0) ThenBlock: {
                    CA_PolyRebuild(CadApp.last_poly)
                }
                CA_HudClose()
                CA_PublishFrame()
                ReturnValue(1)
            }
            IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: {
                IfCondition LessThan(mm, 1) ThenBlock: { ReturnValue(0) }
                CadApp.poly_side = mm
                CA_PolySyncFromSide()
                IfCondition GreaterEqual(CadApp.last_poly, 0) ThenBlock: {
                    CA_PolyRebuild(CadApp.last_poly)
                    CA_SolveNow()
                    CA_HudClose()
                    CA_PublishFrame()
                    ReturnValue(1)
                }
                IfCondition EqualTo(CadApp.poly_mode, 0) ThenBlock: {
                    IfCondition GreaterThan(CadApp.nclick, 0) ThenBlock: {
                        pin = Float_Div(0x400921FB54442D18, Float_FromInt(CadApp.poly_n))
                        s = CAD_Geom.Sin(pin)
                        rad = 0
                        IfCondition EqualTo(CAD_Num.IsZero(s, 0), 0) ThenBlock: {
                            rad = Float_Div(v, Float_Mul(0x4000000000000000, s))
                        }
                        CA_PlacePolyR(rad)
                        CA_HudClose()
                        CA_PublishFrame()
                        ReturnValue(1)
                    }
                }
                CA_HudClose()
                ReturnValue(1)
            }
            IfCondition EqualTo(CadApp.hud_field, 2) ThenBlock: {
                IfCondition LessThan(mm, 1) ThenBlock: { ReturnValue(0) }
                CadApp.poly_diam = mm
                CA_PolySyncFromDiam()
                IfCondition GreaterEqual(CadApp.last_poly, 0) ThenBlock: {
                    CA_PolyRebuild(CadApp.last_poly)
                    CA_HudClose()
                    CA_PublishFrame()
                    ReturnValue(1)
                }
                IfCondition EqualTo(CadApp.poly_mode, 0) ThenBlock: {
                    IfCondition GreaterThan(CadApp.nclick, 0) ThenBlock: {
                        rad = Float_Div(v, 0x4000000000000000)
                        CA_PlacePolyR(rad)
                        CA_HudClose()
                        CA_PublishFrame()
                        ReturnValue(1)
                    }
                }
                CA_HudClose()
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(CadApp.hud_kind, 2) ThenBlock: {
            IfCondition LessThan(CadApp.last_line, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
            xy = Allocate(32)
            CAD_Sketch.GetLineEnd(CadApp.sketch, CadApp.last_line, 0, xy)
            x0 = ArrayGet(xy, 0)
            y0 = ArrayGet(xy, 1)
            CAD_Sketch.GetLineEnd(CadApp.sketch, CadApp.last_line, 1, xy)
            dx = Float_Sub(ArrayGet(xy, 0), x0)
            dy = Float_Sub(ArrayGet(xy, 1), y0)
            Deallocate(xy, 32)
            ln = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
            ang = CAD_Geom.Atan2(dy, dx)
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsZero(v, 0), 1) ThenBlock: { ReturnValue(0) }
                CAD_Sketch.SetLinePolar(CadApp.sketch, CadApp.last_line, v, ang)
                CadApp.live_len = mm
            }
            IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: {
                k = Float_Div(0x400921FB54442D18, 0x4066800000000000)
                nang = Float_Mul(v, k)
                IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: { ReturnValue(0) }
                CAD_Sketch.SetLinePolar(CadApp.sketch, CadApp.last_line, ln, nang)
                deg = mm
                IfCondition LessThan(deg, 0) ThenBlock: { deg = Add(deg, 360) }
                CadApp.live_ang = deg
            }
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            CA_HistPush(9)
            CA_SolveNow()
            CA_HudClose()
            CA_PublishFrame()
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.hud_kind, 3) ThenBlock: {
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: {
                IfCondition LessThan(mm, 1) ThenBlock: { ReturnValue(0) }
                CadApp.circ_r = mm
                CadApp.circ_d = Multiply(mm, 2)
            }
            IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: {
                IfCondition LessThan(mm, 1) ThenBlock: { ReturnValue(0) }
                CadApp.circ_d = mm
                CadApp.circ_r = Divide(mm, 2)
                IfCondition LessThan(CadApp.circ_r, 1) ThenBlock: { CadApp.circ_r = 1 }
            }
            CA_LogInt("cad_app: circ field R=", 22, CadApp.circ_r)
            CA_WriteDimHud()
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.hud_kind, 4) ThenBlock: {
            IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: {
                IfCondition LessThan(mm, 1) ThenBlock: { ReturnValue(0) }
                CadApp.rect_w = mm
            }
            IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: {
                IfCondition LessThan(mm, 1) ThenBlock: { ReturnValue(0) }
                CadApp.rect_h = mm
            }
            CA_LogInt("cad_app: rect field W=", 22, CadApp.rect_w)
            CA_LogInt("cad_app: rect field H=", 22, CadApp.rect_h)
            CA_WriteDimHud()
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.hud_kind, 5) ThenBlock: {
            IfCondition LessThan(mm, 1) ThenBlock: { ReturnValue(0) }
            CadApp.fillet_r = v
            CA_HudApplyFillet()
            CA_HudClose()
            CA_PublishFrame()
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.hud_kind, 6) ThenBlock: {
            IfCondition EqualTo(CadApp.cstr_type, 20) ThenBlock: {
                IfCondition EqualTo(CadApp.hud_field, 0) ThenBlock: { CadApp.cstr_u = mm }
                IfCondition EqualTo(CadApp.hud_field, 1) ThenBlock: { CadApp.cstr_v = mm }
            }
            IfCondition NotEqual(CadApp.cstr_type, 20) ThenBlock: {
                CadApp.cstr_rval = v
                CadApp.cstr_val = mm
            }
            CA_CstrApplyPending()
            CadApp.cstr_ready = 0
            CA_HudClose()
            CA_PublishFrame()
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.hud_kind, 7) ThenBlock: {
            IfCondition EqualTo(mm, 0) ThenBlock: { ReturnValue(0) }
            IfCondition GreaterThan(mm, 10000) ThenBlock: { mm = 10000 }
            IfCondition LessThan(mm, -10000) ThenBlock: { mm = -10000 }
            CadApp.height = mm
            IfCondition LessThan(mm, 0) ThenBlock: {
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: { CadApp.extrude_op = 1 }
            }
            CA_PadApplyHeight()
            CA_HudClose()
            CA_PublishFrame()
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.hud_kind, 8) ThenBlock: {
            IfCondition LessThan(mm, 1) ThenBlock: { ReturnValue(0) }
            IfCondition GreaterThan(mm, 360) ThenBlock: { mm = 360 }
            CadApp.rev_deg = mm
            CA_RevApplyDeg()
            CA_HudClose()
            CA_PublishFrame()
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.hud_kind, 9) ThenBlock: {
            IfCondition LessThan(mm, 1) ThenBlock: { ReturnValue(0) }
            IfCondition GreaterThan(mm, 10000) ThenBlock: { mm = 10000 }
            CadApp.chamfer_d = mm
            rc = CA_HudApplyChamfer()
            IfCondition EqualTo(rc, 0) ThenBlock: {
                CA_HudClose()
            }
            CA_PublishFrame()
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.hud_kind, 10) ThenBlock: {
            IfCondition LessThan(mm, 1) ThenBlock: { ReturnValue(0) }
            IfCondition GreaterThan(mm, 10000) ThenBlock: { mm = 10000 }
            CadApp.fillet_r = v
            rc = CA_HudApplyFillet3d()
            IfCondition EqualTo(rc, 0) ThenBlock: {
                CA_HudClose()
            }
            CA_PublishFrame()
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Type-in dimension (mm). Line=L, circle=R, polygon=side (or radius if side=0).
Function.CA_CommitDim {
    Input: mm: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(mm, 1) ThenBlock: { ReturnValue(0) }
        v = Float_FromInt(mm)
        IfCondition EqualTo(CadApp.tool, 17) ThenBlock: {
            CadApp.poly_side = mm
        }
        IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.tool, 8) ThenBlock: {
                CadApp.fillet_r = v
            }
            IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
                CadApp.live_len = mm
                IfCondition GreaterEqual(CadApp.last_line, 0) ThenBlock: {
                    IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                        xy = Allocate(32)
                        CAD_Sketch.GetLineEnd(CadApp.sketch, CadApp.last_line, 0, xy)
                        x0 = ArrayGet(xy, 0)
                        y0 = ArrayGet(xy, 1)
                        CAD_Sketch.GetLineEnd(CadApp.sketch, CadApp.last_line, 1, xy)
                        dx = Float_Sub(ArrayGet(xy, 0), x0)
                        dy = Float_Sub(ArrayGet(xy, 1), y0)
                        Deallocate(xy, 32)
                        ang = CAD_Geom.Atan2(dy, dx)
                        CAD_Sketch.SetLinePolar(CadApp.sketch, CadApp.last_line, v, ang)
                        CAD_Sketch.RebuildAnchors(CadApp.sketch)
                        CadApp.dirty = 1
                        CA_InvalidateProfiles()
                        CA_HistPush(0)
                    }
                }
            }
            CA_PublishFrame()
            ReturnValue(1)
        }
        IfCondition EqualTo(CadApp.tool, 17) ThenBlock: {
            CadApp.poly_side = mm
            IfCondition EqualTo(CadApp.poly_mode, 0) ThenBlock: {
                CA_PlacePolyCenter()
                CadApp.nclick = 0
                CA_PublishFrame()
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
        }
        // direction: hover world if we have it, else +X
        hx = Float_Add(CadApp.cx0, v)
        hy = CadApp.cy0
        IfCondition EqualTo(CadApp.hover_ok, 1) ThenBlock: {
            IfCondition EqualTo(CadAppIpc.hxy, 0) ThenBlock: { CadAppIpc.hxy = Allocate(32) }
            IfCondition NotEqual(CadAppIpc.hxy, 0) ThenBlock: {
                CA_PixToWorld(CadApp.hover_px, CadApp.hover_py, CadAppIpc.hxy)
                dx = Float_Sub(ArrayGet(CadAppIpc.hxy, 0), CadApp.cx0)
                dy = Float_Sub(ArrayGet(CadAppIpc.hxy, 1), CadApp.cy0)
                ln = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 0) ThenBlock: {
                    hx = Float_Add(CadApp.cx0, Float_Mul(v, Float_Div(dx, ln)))
                    hy = Float_Add(CadApp.cy0, Float_Mul(v, Float_Div(dy, ln)))
                }
            }
        }
        IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
            CAD_Sketch.AddLine(CadApp.sketch, CadApp.cx0, CadApp.cy0, hx, hy)
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CadApp.dirty = 1
            CA_InvalidateProfiles()
        }
        IfCondition EqualTo(CadApp.tool, 2) ThenBlock: {
            CAD_Sketch.AddCircle(CadApp.sketch, CadApp.cx0, CadApp.cy0, v)
            CadApp.dirty = 1
            CA_InvalidateProfiles()
        }
        IfCondition EqualTo(CadApp.tool, 17) ThenBlock: {
            // polygon: v is side length
            CadApp.poly_side = mm
            CAD_UI_State.nsides = CadApp.poly_n
            n = CadApp.poly_n
            IfCondition GreaterEqual(n, 3) ThenBlock: {
                pin = Float_Div(0x400921FB54442D18, Float_FromInt(n))
                s = CAD_Geom.Sin(pin)
                IfCondition EqualTo(CAD_Num.IsZero(s, 0), 0) ThenBlock: {
                    rad = Float_Div(v, Float_Mul(0x4000000000000000, s))
                    dx = Float_Sub(hx, CadApp.cx0)
                    dy = Float_Sub(hy, CadApp.cy0)
                    ln = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                    IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: {
                        hx = Float_Add(CadApp.cx0, rad)
                        hy = CadApp.cy0
                    }
                    IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 0) ThenBlock: {
                        hx = Float_Add(CadApp.cx0, Float_Mul(rad, Float_Div(dx, ln)))
                        hy = Float_Add(CadApp.cy0, Float_Mul(rad, Float_Div(dy, ln)))
                    }
                }
            }
            CAD_UI.Pend2(CadApp.cx0, CadApp.cy0, hx, hy)
            IfCondition EqualTo(CadApp.poly_mode, 1) ThenBlock: {
                CAD_UI.AddNGonEdge(CadApp.sketch)
            }
            IfCondition NotEqual(CadApp.poly_mode, 1) ThenBlock: {
                CAD_UI.AddNGon(CadApp.sketch)
            }
            CadApp.dirty = 1
            CA_InvalidateProfiles()
        }
        CadApp.nclick = 0
        CadApp.hover_ok = 0
        CA_PublishFrame()
        ReturnValue(1)
    }
}

// Write tool strip state for host: mode tool nclick dirty cstr_type npick

