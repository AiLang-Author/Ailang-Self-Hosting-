Function.CA_BeginConstraint {
    Input: ctype: Integer
    Output: Integer
    Body: {
        CadApp.mode = 1
        CadApp.tool = 7
        CadApp.cstr_type = ctype
        CadApp.cstr_npick = 0
        CadApp.nclick = 0
        CadApp.hover_ok = 0
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
        }
        CA_HudClose()
        CadApp.cstr_val = 0
        CadApp.cstr_rval = 0
        CadApp.cstr_ready = 0
        CadApp.last_cstr = -1
        IfCondition EqualTo(ctype, 20) ThenBlock: {
            CadApp.cstr_ready = 1
            CadApp.cstr_u = 0
            CadApp.cstr_v = 0
            CadApp.hud_field = 0
        }
        CA_HudOpenCstr()
        ReturnValue(0)
    }
}

// Run solve + invalidate after adding a constraint.


// Run solve + invalidate after adding a constraint.
Function.CA_SolveNow {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        napp = CAD_Sketch.SolveConstraints(CadApp.sketch)
        CAD_Sketch.RebuildAnchors(CadApp.sketch)
        CA_InvalidateProfiles()
        CadApp.dirty = 1
        CA_LogInt("cad_app: constraint solve hits=", 31, napp)
        ReturnValue(napp)
    }
}

// Constraint click: pick 1 or 2 entities then add + solve.
// cstr_type: 1 FixO  6 DistO(lock)  7 H  8 V  9 Coin  10 OnLine
//           11 Rad(lock)  12 EqR  13 Tang  15 Dist(lock)


// Constraint click: pick 1 or 2 entities then add + solve.
// cstr_type: 1 FixO  6 DistO(lock)  7 H  8 V  9 Coin  10 OnLine
//           11 Rad(lock)  12 EqR  13 Tang  15 Dist(lock)
Function.CA_ConstraintClick {
    Input: wx: Integer
    Input: wy: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        ki = Allocate(32)
        IfCondition EqualTo(CA_HitEntity(wx, wy, ki), 0) ThenBlock: {
            li = CA_PickSketchLineAtPx(CadApp.hover_px, CadApp.hover_py)
            IfCondition LessThan(li, 0) ThenBlock: {
                CA_Log("cad_app: miss - click point/end/circle/line\n", 44)
                Deallocate(ki, 32)
                ReturnValue(0)
            }
            ArraySet(ki, 0, 2)
            ArraySet(ki, 1, li)
        }
        hk = ArrayGet(ki, 0)
        hi = ArrayGet(ki, 1)
        ct = CadApp.cstr_type
        // Point tools: whole-line hit -> nearest endpoint
        IfCondition EqualTo(ct, 1) ThenBlock: {
            CA_HitAsPoint(wx, wy, hk, hi, ki)
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
        }
        IfCondition EqualTo(ct, 2) ThenBlock: {
            CA_HitAsPoint(wx, wy, hk, hi, ki)
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
        }
        IfCondition EqualTo(ct, 3) ThenBlock: {
            CA_HitAsPoint(wx, wy, hk, hi, ki)
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
        }
        IfCondition EqualTo(ct, 6) ThenBlock: {
            CA_HitAsPoint(wx, wy, hk, hi, ki)
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
        }
        IfCondition EqualTo(ct, 9) ThenBlock: {
            CA_HitAsPoint(wx, wy, hk, hi, ki)
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
        }
        IfCondition EqualTo(ct, 15) ThenBlock: {
            CA_HitAsPoint(wx, wy, hk, hi, ki)
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
        }
        Deallocate(ki, 32)
        // --- single-pick types ---
        // FixOrigin
        IfCondition EqualTo(ct, 1) ThenBlock: {
            IfCondition EqualTo(hk, 2) ThenBlock: {
                CA_Log("cad_app: FixO needs point or line end\n", 38)
                ReturnValue(0)
            }
            IfCondition EqualTo(hk, 4) ThenBlock: {
                // circle center is ok (kind 4 center move)
                CAD_Sketch.AddConstraint(CadApp.sketch, 1, 4, hi, 0)
            }
            IfCondition NotEqual(hk, 4) ThenBlock: {
                CAD_Sketch.AddConstraint(CadApp.sketch, 1, hk, hi, 0)
            }
            CadApp.cstr_npick = 0
            CA_SolveNow()
            CA_CstrRemember()
            CA_HudClose()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // FixX / FixY — lock current X or Y on this sketch plane
        IfCondition EqualTo(ct, 2) ThenBlock: {
            IfCondition EqualTo(hk, 2) ThenBlock: {
                CA_Log("cad_app: FixX needs point or end\n", 33)
                ReturnValue(0)
            }
            xy = Allocate(32)
            tk = hk
            IfCondition EqualTo(hk, 4) ThenBlock: { tk = 4 }
            CAD_Sketch.GetTargetXY(CadApp.sketch, tk, hi, xy)
            uu = ArrayGet(xy, 0)
            Deallocate(xy, 32)
            CadApp.cstr_ka = tk
            CadApp.cstr_ia = hi
            CadApp.cstr_rval = uu
            CadApp.cstr_val = Float_ToInt(uu)
            CadApp.cstr_ready = 1
            CadApp.last_cstr = -1
            CA_HudOpenCstr()
            CA_PublishFrame()
            ReturnValue(1)
        }
        IfCondition EqualTo(ct, 3) ThenBlock: {
            IfCondition EqualTo(hk, 2) ThenBlock: {
                CA_Log("cad_app: FixY needs point or end\n", 33)
                ReturnValue(0)
            }
            xy = Allocate(32)
            tk = hk
            IfCondition EqualTo(hk, 4) ThenBlock: { tk = 4 }
            CAD_Sketch.GetTargetXY(CadApp.sketch, tk, hi, xy)
            vv = ArrayGet(xy, 1)
            Deallocate(xy, 32)
            CadApp.cstr_ka = tk
            CadApp.cstr_ia = hi
            CadApp.cstr_rval = vv
            CadApp.cstr_val = Float_ToInt(vv)
            CadApp.cstr_ready = 1
            CadApp.last_cstr = -1
            CA_HudOpenCstr()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // Horizontal / Vertical on a line
        IfCondition EqualTo(ct, 7) ThenBlock: {
            li = hi
            ok = 0
            IfCondition EqualTo(hk, 0) ThenBlock: {
                li = Divide(hi, 2)
                ok = 1
            }
            IfCondition EqualTo(hk, 2) ThenBlock: {
                li = hi
                ok = 1
            }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                CAD_Sketch.AddConstraint(CadApp.sketch, 7, 2, li, 0)
                CadApp.cstr_npick = 0
                CA_SolveNow()
                CA_CstrRemember()
                CA_HudClose()
                CA_PublishFrame()
                ReturnValue(1)
            }
            CA_Log("cad_app: H needs a line\n", 24)
            ReturnValue(0)
        }
        IfCondition EqualTo(ct, 8) ThenBlock: {
            li = hi
            ok = 0
            IfCondition EqualTo(hk, 0) ThenBlock: {
                li = Divide(hi, 2)
                ok = 1
            }
            IfCondition EqualTo(hk, 2) ThenBlock: {
                li = hi
                ok = 1
            }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                CAD_Sketch.AddConstraint(CadApp.sketch, 8, 2, li, 0)
                CadApp.cstr_npick = 0
                CA_SolveNow()
                CA_CstrRemember()
                CA_HudClose()
                CA_PublishFrame()
                ReturnValue(1)
            }
            CA_Log("cad_app: V needs a line\n", 24)
            ReturnValue(0)
        }
        // DistToOrigin lock current |p|
        IfCondition EqualTo(ct, 6) ThenBlock: {
            IfCondition EqualTo(hk, 2) ThenBlock: {
                CA_Log("cad_app: DistO needs a point or end\n", 36)
                ReturnValue(0)
            }
            xy = Allocate(32)
            tk = hk
            IfCondition EqualTo(hk, 4) ThenBlock: { tk = 4 }
            CAD_Sketch.GetTargetXY(CadApp.sketch, tk, hi, xy)
            px = ArrayGet(xy, 0)
            py = ArrayGet(xy, 1)
            Deallocate(xy, 32)
            d = CAD_Num.Sqrt(Float_Add(Float_Mul(px, px), Float_Mul(py, py)))
            CadApp.cstr_ka = tk
            CadApp.cstr_ia = hi
            CadApp.cstr_rval = d
            CadApp.cstr_val = Float_ToInt(d)
            CadApp.cstr_ready = 1
            CadApp.last_cstr = -1
            CA_HudOpenCstr()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // Radius lock current r - click rim or center
        IfCondition EqualTo(ct, 11) ThenBlock: {
            IfCondition NotEqual(hk, 4) ThenBlock: {
                CA_Log("cad_app: Rad - click circle rim or center\n", 42)
                ReturnValue(0)
            }
            ci = hi
            r = CAD_Sketch.GetCircleRadius(CadApp.sketch, ci)
            CadApp.cstr_ka = 4
            CadApp.cstr_ia = ci
            CadApp.cstr_rval = r
            CadApp.cstr_val = Float_ToInt(r)
            CadApp.cstr_ready = 1
            CadApp.last_cstr = -1
            CA_HudOpenCstr()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // --- two-pick types ---
        IfCondition EqualTo(CadApp.cstr_npick, 0) ThenBlock: {
            CadApp.cstr_ka = hk
            CadApp.cstr_ia = hi
            CadApp.cstr_npick = 1
            CA_Log("cad_app: constraint pick 1/2\n", 29)
            CA_PublishFrame()
            ReturnValue(1)
        }
        // second pick
        CadApp.cstr_kb = hk
        CadApp.cstr_ib = hi
        CadApp.cstr_npick = 0
        ka = CadApp.cstr_ka
        ia = CadApp.cstr_ia
        kb = CadApp.cstr_kb
        ib = CadApp.cstr_ib
        // Coincident
        IfCondition EqualTo(ct, 9) ThenBlock: {
            CAD_Sketch.AddConstraint2(CadApp.sketch, 9, ka, ia, kb, ib)
            CA_SolveNow()
            CA_CstrRemember()
            CA_HudClose()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // PointOnLine — A point, B line
        IfCondition EqualTo(ct, 10) ThenBlock: {
            // ensure B is whole line
            IfCondition EqualTo(kb, 0) ThenBlock: {
                ib = Divide(ib, 2)
                kb = 2
            }
            IfCondition EqualTo(ka, 2) ThenBlock: {
                // swap if first was line
                t = ka
                ka = kb
                kb = t
                t = ia
                ia = ib
                ib = t
                IfCondition EqualTo(kb, 0) ThenBlock: {
                    ib = Divide(ib, 2)
                    kb = 2
                }
            }
            CAD_Sketch.AddConstraint2(CadApp.sketch, 10, ka, ia, kb, ib)
            CA_SolveNow()
            CA_CstrRemember()
            CA_HudClose()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // EqualRadius
        IfCondition EqualTo(ct, 12) ThenBlock: {
            CAD_Sketch.AddConstraint2(CadApp.sketch, 12, 4, ia, 4, ib)
            CA_SolveNow()
            CA_CstrRemember()
            CA_HudClose()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // Tangent line-circle or circle-circle
        IfCondition EqualTo(ct, 13) ThenBlock: {
            // normalize: line as A kind 2, circle as B kind 4 — or two circles type 14
            la = 0
            ca = 0
            lb = 0
            cb = 0
            IfCondition EqualTo(ka, 2) ThenBlock: { la = 1 }
            IfCondition EqualTo(ka, 0) ThenBlock: {
                la = 1
                ia = Divide(ia, 2)
                ka = 2
            }
            IfCondition EqualTo(ka, 4) ThenBlock: { ca = 1 }
            IfCondition EqualTo(ka, 1) ThenBlock: {
                ca = 1
                ka = 4
            }
            IfCondition EqualTo(kb, 2) ThenBlock: { lb = 1 }
            IfCondition EqualTo(kb, 0) ThenBlock: {
                lb = 1
                ib = Divide(ib, 2)
                kb = 2
            }
            IfCondition EqualTo(kb, 4) ThenBlock: { cb = 1 }
            IfCondition EqualTo(kb, 1) ThenBlock: {
                cb = 1
                kb = 4
            }
            IfCondition EqualTo(ca, 1) ThenBlock: {
                IfCondition EqualTo(cb, 1) ThenBlock: {
                    CAD_Sketch.AddConstraint2(CadApp.sketch, 14, 4, ia, 4, ib)
                    CA_SolveNow()
                    CA_CstrRemember()
                    CA_HudClose()
                    CA_PublishFrame()
                    ReturnValue(1)
                }
            }
            // line + circle
            IfCondition EqualTo(la, 1) ThenBlock: {
                IfCondition EqualTo(cb, 1) ThenBlock: {
                    CAD_Sketch.AddConstraint2(CadApp.sketch, 13, 2, ia, 4, ib)
                    CA_SolveNow()
                    CA_CstrRemember()
                    CA_HudClose()
                    CA_PublishFrame()
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(lb, 1) ThenBlock: {
                IfCondition EqualTo(ca, 1) ThenBlock: {
                    CAD_Sketch.AddConstraint2(CadApp.sketch, 13, 2, ib, 4, ia)
                    CA_SolveNow()
                    CA_CstrRemember()
                    CA_HudClose()
                    CA_PublishFrame()
                    ReturnValue(1)
                }
            }
            CA_Log("cad_app: Tang needs line+circle or 2 circles\n", 45)
            ReturnValue(0)
        }
        // DistPoints lock current distance
        IfCondition EqualTo(ct, 15) ThenBlock: {
            xy = Allocate(32)
            xy2 = Allocate(32)
            CAD_Sketch.GetTargetXY(CadApp.sketch, ka, ia, xy)
            CAD_Sketch.GetTargetXY(CadApp.sketch, kb, ib, xy2)
            dx = Float_Sub(ArrayGet(xy2, 0), ArrayGet(xy, 0))
            dy = Float_Sub(ArrayGet(xy2, 1), ArrayGet(xy, 1))
            d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
            Deallocate(xy, 32)
            Deallocate(xy2, 32)
            CadApp.cstr_rval = d
            CadApp.cstr_val = Float_ToInt(d)
            CadApp.cstr_ready = 1
            CadApp.last_cstr = -1
            CA_HudOpenCstr()
            CA_PublishFrame()
            ReturnValue(1)
        }
        CA_Log("cad_app: unknown constraint type\n", 33)
        ReturnValue(0)
    }
}

// Click: sketch tools in sketch mode; nav cube in 3D mode
// Pick/Trim force sketch mode so 3D mode does not swallow selection clicks.


// Click: sketch tools in sketch mode; nav cube in 3D mode
// Pick/Trim force sketch mode so 3D mode does not swallow selection clicks.
