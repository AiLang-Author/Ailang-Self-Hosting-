Function.CA_TreeSelect {
    Input: k: Integer
    Input: id: Integer
    Output: Integer
    Body: {
        CA_HudClose()
        CadApp.nclick = 0
        CadApp.face_pick = 0
        CA_PlaneClearPick()
        // S — sketch
        IfCondition EqualTo(k, 83) ThenBlock: {
            IfCondition GreaterEqual(id, 0) ThenBlock: {
                IfCondition LessThan(id, CadApp.sk_n) ThenBlock: {
                    CadApp.sketch = ArrayGet(CadApp.sk_list, id)
                    CadApp.mode = 1
                    pl = CAD_Sketch.GetPlaneId(CadApp.sketch)
                    IfCondition NotEqual(pl, 0) ThenBlock: { CadApp.plane = pl }
                    fi = 0
                    WhileLoop LessThan(fi, CadApp.feat_n) {
                        IfCondition EqualTo(ArrayGet(CadApp.feat_kind, fi), 0) ThenBlock: {
                            IfCondition EqualTo(ArrayGet(CadApp.feat_sk, fi), id) ThenBlock: {
                                CadApp.feat_sel = fi
                            }
                        }
                        fi = Add(fi, 1)
                    }
                }
            }
            ReturnValue(0)
        }
        // A — closed profile (area) under the active sketch
        IfCondition EqualTo(k, 65) ThenBlock: {
            IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
            np = CAD_Store.Read(CadApp.sketch, 12)
            IfCondition EqualTo(np, 0) ThenBlock: {
                np = CA_RebuildProfiles()
            }
            IfCondition GreaterThan(np, 0) ThenBlock: {
                CadApp.mode = 1
                CA_ApplyProfileSel(id, np, 0)
            }
            ReturnValue(0)
        }
        // N — construction plane
        IfCondition EqualTo(k, 78) ThenBlock: {
            CA_PlaneActivateIdx(id)
            ReturnValue(0)
        }
        // M — model
        IfCondition EqualTo(k, 77) ThenBlock: {
            CadApp.mode = 0
            CadApp.feat_sel = CadApp.feat_n
            ReturnValue(0)
        }
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        CadApp.feat_sel = id
        si = 0
        IfCondition NotEqual(CadApp.feat_sk, 0) ThenBlock: {
            si = ArrayGet(CadApp.feat_sk, id)
        }
        IfCondition GreaterEqual(si, 0) ThenBlock: {
            IfCondition LessThan(si, CadApp.sk_n) ThenBlock: {
                IfCondition NotEqual(CadApp.sk_list, 0) ThenBlock: {
                    sk = ArrayGet(CadApp.sk_list, si)
                    IfCondition NotEqual(sk, 0) ThenBlock: {
                        CadApp.sketch = sk
                        pl = CAD_Sketch.GetPlaneId(sk)
                        IfCondition NotEqual(pl, 0) ThenBlock: { CadApp.plane = pl }
                    }
                }
            }
        }
        go3 = 0
        IfCondition EqualTo(k, 66) ThenBlock: { go3 = 1 }
        IfCondition EqualTo(k, 82) ThenBlock: { go3 = 1 }
        IfCondition EqualTo(k, 85) ThenBlock: { go3 = 1 }
        IfCondition EqualTo(k, 70) ThenBlock: { go3 = 1 }
        IfCondition EqualTo(k, 67) ThenBlock: { go3 = 1 }
        IfCondition EqualTo(go3, 1) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                CadApp.mode = 0
            }
            IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
                CadApp.mode = 1
            }
            ReturnValue(0)
        }
        CadApp.mode = 1
        ReturnValue(0)
    }
}

Function.CA_PadEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(-1) }
        fk = ArrayGet(CadApp.feat_kind, feat_i)
        okp = 0
        IfCondition EqualTo(fk, 1) ThenBlock: {
            CadApp.extrude_op = 0
            okp = 1
        }
        IfCondition EqualTo(fk, 3) ThenBlock: {
            CadApp.extrude_op = 1
            okp = 1
        }
        IfCondition NotEqual(okp, 1) ThenBlock: { ReturnValue(-1) }
        CadApp.feat_sel = feat_i
        CadApp.last_pad = feat_i
        hh = CadApp.height
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ha = ArrayGet(CadApp.feat_aux, feat_i)
            IfCondition NotEqual(ha, 0) ThenBlock: { hh = ha }
        }
        CadApp.height = hh
        CadApp.mode = 0
        CA_HudOpenPad()
        ReturnValue(0)
    }
}

Function.CA_ChamferEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 5) ThenBlock: { ReturnValue(-1) }
        CadApp.feat_sel = feat_i
        dd = CadApp.chamfer_d
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            da = ArrayGet(CadApp.feat_aux, feat_i)
            IfCondition GreaterThan(da, 0) ThenBlock: { dd = da }
        }
        IfCondition LessThan(dd, 1) ThenBlock: { dd = 2 }
        CadApp.chamfer_d = dd
        CadApp.chamfer_edit = 1
        CadApp.fillet_edit = 0
        CadApp.mode = 0
        CadApp.tool = 10
        CA_LogInt("cad_app: edit chamfer D=", 24, dd)
        CA_HudOpenChamfer()
        ReturnValue(0)
    }
}

Function.CA_Fillet3dEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 4) ThenBlock: { ReturnValue(-1) }
        CadApp.feat_sel = feat_i
        rr = Float_ToInt(CadApp.fillet_r)
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            da = ArrayGet(CadApp.feat_aux, feat_i)
            IfCondition GreaterThan(da, 0) ThenBlock: { rr = da }
        }
        IfCondition LessThan(rr, 1) ThenBlock: { rr = 2 }
        CadApp.fillet_r = Float_FromInt(rr)
        CadApp.fillet_edit = 1
        CadApp.chamfer_edit = 0
        CadApp.mode = 0
        CadApp.tool = 8
        CA_LogInt("cad_app: edit fillet R=", 23, rr)
        CA_HudOpenFillet3d()
        ReturnValue(0)
    }
}

Function.CA_CstrApplyPending {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        ct = CadApp.cstr_type
        v = CadApp.cstr_rval
        IfCondition GreaterEqual(CadApp.last_cstr, 0) ThenBlock: {
            CAD_Sketch.SetConstraintValue(CadApp.sketch, CadApp.last_cstr, v)
            CA_SolveNow()
            ReturnValue(0)
        }
        IfCondition EqualTo(ct, 20) ThenBlock: {
            IfCondition GreaterEqual(CadApp.last_upt, 0) ThenBlock: {
                CAD_Sketch.SetUserPoint(CadApp.sketch, CadApp.last_upt, Float_FromInt(CadApp.cstr_u), Float_FromInt(CadApp.cstr_v))
                CadApp.dirty = 1
                CA_HistPush(14)
                ReturnValue(0)
            }
            pi = CAD_Sketch.AddUserPoint(CadApp.sketch, Float_FromInt(CadApp.cstr_u), Float_FromInt(CadApp.cstr_v), 0)
            CadApp.last_upt = pi
            CadApp.dirty = 1
            CA_FeatAdd(14, CA_CurrentSkIdx())
            IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
                ArraySet(CadApp.feat_aux, CadApp.feat_sel, pi)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(ct, 2) ThenBlock: {
            CAD_Sketch.AddConstraint(CadApp.sketch, 2, CadApp.cstr_ka, CadApp.cstr_ia, v)
            CA_SolveNow()
            CA_CstrRemember()
            ReturnValue(0)
        }
        IfCondition EqualTo(ct, 3) ThenBlock: {
            CAD_Sketch.AddConstraint(CadApp.sketch, 3, CadApp.cstr_ka, CadApp.cstr_ia, v)
            CA_SolveNow()
            CA_CstrRemember()
            ReturnValue(0)
        }
        IfCondition EqualTo(ct, 6) ThenBlock: {
            CAD_Sketch.AddConstraint(CadApp.sketch, 6, CadApp.cstr_ka, CadApp.cstr_ia, v)
            CA_SolveNow()
            CA_CstrRemember()
            ReturnValue(0)
        }
        IfCondition EqualTo(ct, 11) ThenBlock: {
            CAD_Sketch.AddConstraint(CadApp.sketch, 11, 4, CadApp.cstr_ia, v)
            CA_SolveNow()
            CA_CstrRemember()
            ReturnValue(0)
        }
        IfCondition EqualTo(ct, 15) ThenBlock: {
            cid = CAD_Sketch.AddConstraint2(CadApp.sketch, 15, CadApp.cstr_ka, CadApp.cstr_ia, CadApp.cstr_kb, CadApp.cstr_ib)
            CAD_Sketch.SetConstraintValue(CadApp.sketch, cid, v)
            CA_SolveNow()
            CA_CstrRemember()
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.CA_CstrRemember {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(CadApp.sketch, 20)
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(-1) }
        CadApp.last_cstr = Subtract(n, 1)
        CA_FeatAdd(13, CA_CurrentSkIdx())
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.last_cstr)
        }
        ReturnValue(0)
    }
}

Function.CA_FilletEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.fl_tab, 0) ThenBlock: {
            CadApp.fl_tab = Allocate(2048)
            CadApp.fl_n = 0
        }
        IfCondition EqualTo(CadApp.fl_tab, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

Function.CA_FilletSnap {
    Input: li: Integer
    Input: lj: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_FilletEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(CadApp.fl_n, 16) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        b = Multiply(CadApp.fl_n, 16)
        ArraySet(CadApp.fl_tab, b, li)
        ArraySet(CadApp.fl_tab, Add(b, 1), lj)
        ArraySet(CadApp.fl_tab, Add(b, 2), Float_ToInt(CadApp.fillet_r))
        ArraySet(CadApp.fl_tab, Add(b, 4), CadApp.sketch)
        xy = Allocate(32)
        CAD_Sketch.GetLineEnd(CadApp.sketch, li, 0, xy)
        ArraySet(CadApp.fl_tab, Add(b, 5), ArrayGet(xy, 0))
        ArraySet(CadApp.fl_tab, Add(b, 6), ArrayGet(xy, 1))
        CAD_Sketch.GetLineEnd(CadApp.sketch, li, 1, xy)
        ArraySet(CadApp.fl_tab, Add(b, 7), ArrayGet(xy, 0))
        ArraySet(CadApp.fl_tab, Add(b, 8), ArrayGet(xy, 1))
        CAD_Sketch.GetLineEnd(CadApp.sketch, lj, 0, xy)
        ArraySet(CadApp.fl_tab, Add(b, 9), ArrayGet(xy, 0))
        ArraySet(CadApp.fl_tab, Add(b, 10), ArrayGet(xy, 1))
        CAD_Sketch.GetLineEnd(CadApp.sketch, lj, 1, xy)
        ArraySet(CadApp.fl_tab, Add(b, 11), ArrayGet(xy, 0))
        ArraySet(CadApp.fl_tab, Add(b, 12), ArrayGet(xy, 1))
        Deallocate(xy, 32)
        ReturnValue(0)
    }
}

Function.CA_FilletRemember {
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_FilletEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        na = CAD_Sketch.GetArcCount(CadApp.sketch)
        ai = Subtract(na, 1)
        IfCondition LessThan(ai, 0) ThenBlock: { ai = 0 }
        b = Multiply(CadApp.fl_n, 16)
        ArraySet(CadApp.fl_tab, Add(b, 3), ai)
        CadApp.last_fillet = CadApp.fl_n
        CadApp.fl_n = Add(CadApp.fl_n, 1)
        CA_FeatAdd(12, CA_CurrentSkIdx())
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.last_fillet)
        }
        ReturnValue(0)
    }
}

Function.CA_FilletRebuild {
    Input: pi: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_FilletEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(pi, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(pi, CadApp.fl_n) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        b = Multiply(pi, 16)
        li = ArrayGet(CadApp.fl_tab, b)
        lj = ArrayGet(CadApp.fl_tab, Add(b, 1))
        ai = ArrayGet(CadApp.fl_tab, Add(b, 3))
        CAD_Sketch.SetLine(CadApp.sketch, li, ArrayGet(CadApp.fl_tab, Add(b, 5)), ArrayGet(CadApp.fl_tab, Add(b, 6)), ArrayGet(CadApp.fl_tab, Add(b, 7)), ArrayGet(CadApp.fl_tab, Add(b, 8)))
        CAD_Sketch.SetLine(CadApp.sketch, lj, ArrayGet(CadApp.fl_tab, Add(b, 9)), ArrayGet(CadApp.fl_tab, Add(b, 10)), ArrayGet(CadApp.fl_tab, Add(b, 11)), ArrayGet(CadApp.fl_tab, Add(b, 12)))
        IfCondition GreaterEqual(ai, 0) ThenBlock: {
            CAD_Sketch.DeleteArc(CadApp.sketch, ai)
        }
        rc = CAD_Sketch.FilletLines(CadApp.sketch, li, lj, CadApp.fillet_r)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            na = CAD_Sketch.GetArcCount(CadApp.sketch)
            ArraySet(CadApp.fl_tab, Add(b, 3), Subtract(na, 1))
            ArraySet(CadApp.fl_tab, Add(b, 2), Float_ToInt(CadApp.fillet_r))
            CA_HistPush(12)
            CA_SolveNow()
        }
        ReturnValue(rc)
    }
}

Function.CA_FilletEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 12) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(CA_FilletEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        pi = 0
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            pi = ArrayGet(CadApp.feat_aux, feat_i)
        }
        IfCondition LessThan(pi, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(pi, CadApp.fl_n) ThenBlock: { ReturnValue(-1) }
        b = Multiply(pi, 16)
        rm = ArrayGet(CadApp.fl_tab, Add(b, 2))
        IfCondition GreaterThan(rm, 0) ThenBlock: { CadApp.fillet_r = Float_FromInt(rm) }
        CadApp.last_fillet = pi
        CadApp.tool = 8
        CadApp.mode = 1
        CadApp.nclick = 0
        CadApp.feat_sel = feat_i
        CA_HudOpenFillet()
        ReturnValue(0)
    }
}

Function.CA_PointEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 14) ThenBlock: { ReturnValue(-1) }
        pi = 0
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            pi = ArrayGet(CadApp.feat_aux, feat_i)
        }
        CadApp.last_upt = pi
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            xy = Allocate(32)
            IfCondition EqualTo(CAD_Sketch.GetUserPoint(CadApp.sketch, pi, xy), 0) ThenBlock: {
                CadApp.cstr_u = Float_ToInt(ArrayGet(xy, 0))
                CadApp.cstr_v = Float_ToInt(ArrayGet(xy, 1))
            }
            Deallocate(xy, 32)
        }
        CadApp.cstr_type = 20
        CadApp.cstr_ready = 1
        CadApp.last_cstr = -1
        CadApp.tool = 6
        CadApp.mode = 1
        CadApp.nclick = 0
        CadApp.feat_sel = feat_i
        CA_HudOpenCstr()
        ReturnValue(0)
    }
}

Function.CA_CstrEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 13) ThenBlock: { ReturnValue(-1) }
        ci = 0
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ci = ArrayGet(CadApp.feat_aux, feat_i)
        }
        CadApp.last_cstr = ci
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            n = CAD_Store.Read(CadApp.sketch, 20)
            IfCondition LessThan(ci, n) ThenBlock: {
                cstr = CAD_Store.Read(CadApp.sketch, 21)
                CadApp.cstr_type = ArrayGet(cstr, Multiply(ci, 8))
                CadApp.cstr_val = Float_ToInt(ArrayGet(cstr, Add(Multiply(ci, 8), 3)))
            }
        }
        CadApp.tool = 7
        CadApp.mode = 1
        CadApp.nclick = 0
        CadApp.feat_sel = feat_i
        CadApp.cstr_ready = 1
        CA_HudOpenCstr()
        ReturnValue(0)
    }
}

Function.CA_LineRemember {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.last_line, 0) ThenBlock: { ReturnValue(-1) }
        CA_FeatAdd(9, CA_CurrentSkIdx())
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.last_line)
        }
        ReturnValue(0)
    }
}

Function.CA_CircRemember {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        nc = CAD_Sketch.GetCircleCount(CadApp.sketch)
        IfCondition LessThan(nc, 1) ThenBlock: { ReturnValue(-1) }
        CadApp.last_circ = Subtract(nc, 1)
        rr = CAD_Sketch.GetCircleRadius(CadApp.sketch, CadApp.last_circ)
        CadApp.circ_r = Float_ToInt(rr)
        IfCondition LessThan(CadApp.circ_r, 0) ThenBlock: { CadApp.circ_r = Subtract(0, CadApp.circ_r) }
        CadApp.circ_d = Multiply(CadApp.circ_r, 2)
        CA_FeatAdd(10, CA_CurrentSkIdx())
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.last_circ)
        }
        ReturnValue(0)
    }
}

Function.CA_RectEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.rt_tab, 0) ThenBlock: {
            CadApp.rt_tab = Allocate(1280)
            CadApp.rt_n = 0
        }
        IfCondition EqualTo(CadApp.rt_tab, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

Function.CA_RectRemember {
    Input: mode: Integer
    Input: cx: Integer
    Input: cy: Integer
    Input: x1: Integer
    Input: y1: Integer
    Input: ht: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_RectEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(CadApp.rt_n, 16) ThenBlock: { ReturnValue(-1) }
        nl = CAD_Sketch.GetLineCount(CadApp.sketch)
        line0 = Subtract(nl, 4)
        IfCondition LessThan(line0, 0) ThenBlock: { line0 = 0 }
        b = Multiply(CadApp.rt_n, 10)
        ArraySet(CadApp.rt_tab, b, line0)
        ArraySet(CadApp.rt_tab, Add(b, 1), CadApp.rect_w)
        ArraySet(CadApp.rt_tab, Add(b, 2), CadApp.rect_h)
        ArraySet(CadApp.rt_tab, Add(b, 3), mode)
        ArraySet(CadApp.rt_tab, Add(b, 4), CadApp.sketch)
        ArraySet(CadApp.rt_tab, Add(b, 5), cx)
        ArraySet(CadApp.rt_tab, Add(b, 6), cy)
        ArraySet(CadApp.rt_tab, Add(b, 7), x1)
        ArraySet(CadApp.rt_tab, Add(b, 8), y1)
        ArraySet(CadApp.rt_tab, Add(b, 9), ht)
        CadApp.last_rect = CadApp.rt_n
        CadApp.rt_n = Add(CadApp.rt_n, 1)
        CA_FeatAdd(11, CA_CurrentSkIdx())
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.last_rect)
        }
        ReturnValue(CadApp.last_rect)
    }
}

Function.CA_PlaceRectCenter {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
        }
        IfCondition LessThan(CadApp.rect_w, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(CadApp.rect_h, 1) ThenBlock: { CadApp.rect_h = CadApp.rect_w }
        hw = Float_Div(Float_FromInt(CadApp.rect_w), 0x4000000000000000)
        hh = Float_Div(Float_FromInt(CadApp.rect_h), 0x4000000000000000)
        cx = CadApp.cx0
        cy = CadApp.cy0
        x0 = Float_Sub(cx, hw)
        y0 = Float_Sub(cy, hh)
        x1 = Float_Add(cx, hw)
        y1 = Float_Add(cy, hh)
        CAD_Sketch.AddLine(CadApp.sketch, x0, y0, x1, y0)
        CAD_Sketch.AddLine(CadApp.sketch, x1, y0, x1, y1)
        CAD_Sketch.AddLine(CadApp.sketch, x1, y1, x0, y1)
        CAD_Sketch.AddLine(CadApp.sketch, x0, y1, x0, y0)
        CAD_Sketch.RebuildAnchors(CadApp.sketch)
        CadApp.dirty = 1
        CA_InvalidateProfiles()
        CA_RectRemember(1, cx, cy, x1, y1, 0)
        CadApp.nclick = 0
        CA_RectMeasure(CadApp.last_rect)
        ReturnValue(0)
    }
}

Function.CA_RectMeasure {
    Input: pi: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(pi, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.rt_tab, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        b = Multiply(pi, 10)
        CadApp.pick_n = ArrayGet(CadApp.rt_tab, b)
        xy = Allocate(32)
        CAD_Sketch.GetLineEnd(CadApp.sketch, CadApp.pick_n, 0, xy)
        CadAppPick.ox = ArrayGet(xy, 0)
        CadAppPick.oy = ArrayGet(xy, 1)
        CadAppPick.ax = CadAppPick.ox
        CadAppPick.ay = CadAppPick.oy
        CadAppPick.pi = 0
        WhileLoop LessThan(CadAppPick.pi, 4) {
            CAD_Sketch.GetLineEnd(CadApp.sketch, Add(CadApp.pick_n, CadAppPick.pi), 0, xy)
            CadAppPick.wx = ArrayGet(xy, 0)
            CadAppPick.wy = ArrayGet(xy, 1)
            IfCondition EqualTo(Float_Le(CadAppPick.wx, CadAppPick.ox), 1) ThenBlock: { CadAppPick.ox = CadAppPick.wx }
            IfCondition EqualTo(Float_Le(CadAppPick.ax, CadAppPick.wx), 1) ThenBlock: { CadAppPick.ax = CadAppPick.wx }
            IfCondition EqualTo(Float_Le(CadAppPick.wy, CadAppPick.oy), 1) ThenBlock: { CadAppPick.oy = CadAppPick.wy }
            IfCondition EqualTo(Float_Le(CadAppPick.ay, CadAppPick.wy), 1) ThenBlock: { CadAppPick.ay = CadAppPick.wy }
            CAD_Sketch.GetLineEnd(CadApp.sketch, Add(CadApp.pick_n, CadAppPick.pi), 1, xy)
            CadAppPick.wx = ArrayGet(xy, 0)
            CadAppPick.wy = ArrayGet(xy, 1)
            IfCondition EqualTo(Float_Le(CadAppPick.wx, CadAppPick.ox), 1) ThenBlock: { CadAppPick.ox = CadAppPick.wx }
            IfCondition EqualTo(Float_Le(CadAppPick.ax, CadAppPick.wx), 1) ThenBlock: { CadAppPick.ax = CadAppPick.wx }
            IfCondition EqualTo(Float_Le(CadAppPick.wy, CadAppPick.oy), 1) ThenBlock: { CadAppPick.oy = CadAppPick.wy }
            IfCondition EqualTo(Float_Le(CadAppPick.ay, CadAppPick.wy), 1) ThenBlock: { CadAppPick.ay = CadAppPick.wy }
            CadAppPick.pi = Add(CadAppPick.pi, 1)
        }
        Deallocate(xy, 32)
        wu = Float_ToInt(Float_Add(Float_Sub(CadAppPick.ax, CadAppPick.ox), 0x3FE0000000000000))
        hv = Float_ToInt(Float_Add(Float_Sub(CadAppPick.ay, CadAppPick.oy), 0x3FE0000000000000))
        IfCondition LessThan(wu, 0) ThenBlock: { wu = Subtract(0, wu) }
        IfCondition LessThan(hv, 0) ThenBlock: { hv = Subtract(0, hv) }
        CadApp.rect_w = wu
        CadApp.rect_h = hv
        ArraySet(CadApp.rt_tab, Add(b, 1), wu)
        ArraySet(CadApp.rt_tab, Add(b, 2), hv)
        CA_LogInt("cad_app: rect measured W=", 25, wu)
        CA_LogInt("cad_app: rect measured H=", 25, hv)
        ReturnValue(0)
    }
}

Function.CA_RectRebuild {
    Input: pi: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CA_RectEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(pi, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(pi, CadApp.rt_n) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        b = Multiply(pi, 10)
        line0 = ArrayGet(CadApp.rt_tab, b)
        mode = ArrayGet(CadApp.rt_tab, Add(b, 3))
        ArraySet(CadApp.rt_tab, Add(b, 1), CadApp.rect_w)
        ArraySet(CadApp.rt_tab, Add(b, 2), CadApp.rect_h)
        w = Float_FromInt(CadApp.rect_w)
        h = Float_FromInt(CadApp.rect_h)
        IfCondition NotEqual(mode, 2) ThenBlock: {
            cx = ArrayGet(CadApp.rt_tab, Add(b, 5))
            cy = ArrayGet(CadApp.rt_tab, Add(b, 6))
            hw = Float_Div(w, 0x4000000000000000)
            hh = Float_Div(h, 0x4000000000000000)
            xa = Float_Sub(cx, hw)
            ya = Float_Sub(cy, hh)
            xb = Float_Add(cx, hw)
            yb = Float_Add(cy, hh)
            CAD_Sketch.SetLine(CadApp.sketch, line0, xa, ya, xb, ya)
            CAD_Sketch.SetLine(CadApp.sketch, Add(line0, 1), xb, ya, xb, yb)
            CAD_Sketch.SetLine(CadApp.sketch, Add(line0, 2), xb, yb, xa, yb)
            CAD_Sketch.SetLine(CadApp.sketch, Add(line0, 3), xa, yb, xa, ya)
        }
        IfCondition EqualTo(mode, 2) ThenBlock: {
            x0 = ArrayGet(CadApp.rt_tab, Add(b, 5))
            y0 = ArrayGet(CadApp.rt_tab, Add(b, 6))
            x1 = ArrayGet(CadApp.rt_tab, Add(b, 7))
            y1 = ArrayGet(CadApp.rt_tab, Add(b, 8))
            edx = Float_Sub(x1, x0)
            edy = Float_Sub(y1, y0)
            elen = CAD_Num.Sqrt(Float_Add(Float_Mul(edx, edx), Float_Mul(edy, edy)))
            IfCondition EqualTo(CAD_Num.IsZero(elen, 0), 1) ThenBlock: { ReturnValue(-3) }
            ux = Float_Div(edx, elen)
            uy = Float_Div(edy, elen)
            nx = Float_Sub(0, uy)
            ny = ux
            x1n = Float_Add(x0, Float_Mul(ux, w))
            y1n = Float_Add(y0, Float_Mul(uy, w))
            oldh = ArrayGet(CadApp.rt_tab, Add(b, 9))
            sgn = 0x3FF0000000000000
            IfCondition EqualTo(Float_Le(oldh, 0), 1) ThenBlock: { sgn = Float_Sub(0, sgn) }
            qx = Float_Mul(nx, Float_Mul(h, sgn))
            qy = Float_Mul(ny, Float_Mul(h, sgn))
            CAD_Sketch.SetLine(CadApp.sketch, line0, x0, y0, x1n, y1n)
            CAD_Sketch.SetLine(CadApp.sketch, Add(line0, 1), x1n, y1n, Float_Add(x1n, qx), Float_Add(y1n, qy))
            CAD_Sketch.SetLine(CadApp.sketch, Add(line0, 2), Float_Add(x1n, qx), Float_Add(y1n, qy), Float_Add(x0, qx), Float_Add(y0, qy))
            CAD_Sketch.SetLine(CadApp.sketch, Add(line0, 3), Float_Add(x0, qx), Float_Add(y0, qy), x0, y0)
            ArraySet(CadApp.rt_tab, Add(b, 7), x1n)
            ArraySet(CadApp.rt_tab, Add(b, 8), y1n)
            ArraySet(CadApp.rt_tab, Add(b, 9), Float_Mul(h, sgn))
        }
        CAD_Sketch.RebuildAnchors(CadApp.sketch)
        CadApp.dirty = 1
        CA_InvalidateProfiles()
        CA_HistPush(11)
        CA_RectMeasure(pi)
        ReturnValue(0)
    }
}

Function.CA_LineEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 9) ThenBlock: { ReturnValue(-1) }
        li = 0
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            li = ArrayGet(CadApp.feat_aux, feat_i)
        }
        CadApp.last_line = li
        CadApp.tool = 0
        CadApp.mode = 1
        CadApp.nclick = 0
        CadApp.feat_sel = feat_i
        CA_HudOpenLine()
        ReturnValue(0)
    }
}

Function.CA_CircEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 10) ThenBlock: { ReturnValue(-1) }
        ci = 0
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            ci = ArrayGet(CadApp.feat_aux, feat_i)
        }
        CadApp.last_circ = ci
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            rr = CAD_Sketch.GetCircleRadius(CadApp.sketch, ci)
            CadApp.circ_r = Float_ToInt(rr)
            IfCondition LessThan(CadApp.circ_r, 0) ThenBlock: { CadApp.circ_r = Subtract(0, CadApp.circ_r) }
            CadApp.circ_d = Multiply(CadApp.circ_r, 2)
        }
        CadApp.tool = 2
        CadApp.mode = 1
        CadApp.nclick = 0
        CadApp.feat_sel = feat_i
        CA_HudOpenCirc()
        ReturnValue(0)
    }
}

Function.CA_RectEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 11) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(CA_RectEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        pi = 0
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            pi = ArrayGet(CadApp.feat_aux, feat_i)
        }
        IfCondition LessThan(pi, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(pi, CadApp.rt_n) ThenBlock: { ReturnValue(-1) }
        b = Multiply(pi, 10)
        CadApp.rect_w = ArrayGet(CadApp.rt_tab, Add(b, 1))
        CadApp.rect_h = ArrayGet(CadApp.rt_tab, Add(b, 2))
        CadApp.cx0 = ArrayGet(CadApp.rt_tab, Add(b, 5))
        CadApp.cy0 = ArrayGet(CadApp.rt_tab, Add(b, 6))
        sk = ArrayGet(CadApp.rt_tab, Add(b, 4))
        IfCondition NotEqual(sk, 0) ThenBlock: { CadApp.sketch = sk }
        CadApp.last_rect = pi
        CadApp.tool = 1
        CadApp.mode = 1
        CadApp.nclick = 0
        CadApp.feat_sel = feat_i
        CA_HudOpenRect()
        ReturnValue(0)
    }
}
