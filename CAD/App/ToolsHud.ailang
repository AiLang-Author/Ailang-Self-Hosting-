Function.CA_HudClose {
    Output: Integer
    Body: {
        CadApp.hud_kind = 0
        CadApp.hud_field = 0
        CadApp.chamfer_edit = 0
        CadApp.fillet_edit = 0
        CA_WriteDimHud()
        ReturnValue(0)
    }
}

Function.CA_HudApplyFillet {
    Output: Integer
    Body: {
        // A freshly picked pair always applies a NEW fillet.
        // last_fillet rebuild is only for feature-tree edit (no new pair).
        IfCondition GreaterEqual(CadApp.fillet_li, 0) ThenBlock: {
            IfCondition GreaterEqual(CadApp.fillet_lj, 0) ThenBlock: {
                IfCondition EqualTo(CadApp.fillet_r, 0) ThenBlock: {
                    CadApp.fillet_r = 0x4000000000000000
                }
                CA_FilletSnap(CadApp.fillet_li, CadApp.fillet_lj)
                CA_LogInt("cad_app: fillet apply new li=", 29, CadApp.fillet_li)
                CA_LogInt("cad_app: fillet apply new lj=", 29, CadApp.fillet_lj)
                rc = CAD_Sketch.FilletLines(CadApp.sketch, CadApp.fillet_li, CadApp.fillet_lj, CadApp.fillet_r)
                IfCondition EqualTo(rc, 0) ThenBlock: {
                    CadApp.dirty = 1
                    CA_InvalidateProfiles()
                    CA_FilletRemember()
                    CA_SolveNow()
                    CA_Log("cad_app: fillet OK\n", 19)
                }
                IfCondition EqualTo(rc, -3) ThenBlock: {
                    CA_Log("cad_app: fillet fail parallel\n", 30)
                }
                IfCondition EqualTo(rc, -4) ThenBlock: {
                    CA_Log("cad_app: fillet fail R too big\n", 31)
                }
                CadApp.fillet_li = -1
                CadApp.fillet_lj = -1
                ReturnValue(rc)
            }
        }
        IfCondition GreaterEqual(CadApp.last_fillet, 0) ThenBlock: {
            CA_LogInt("cad_app: fillet rebuild i=", 26, CadApp.last_fillet)
            rc = CA_FilletRebuild(CadApp.last_fillet)
            ReturnValue(rc)
        }
        ReturnValue(-1)
    }
}

Function.CA_HudOk {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.hud_kind, 3) ThenBlock: {
            ReturnValue(CA_CircCommitHud())
        }
        IfCondition EqualTo(CadApp.hud_kind, 4) ThenBlock: {
            ReturnValue(CA_RectCommitHud())
        }
        IfCondition EqualTo(CadApp.hud_kind, 5) ThenBlock: {
            CA_HudApplyFillet()
        }
        IfCondition EqualTo(CadApp.hud_kind, 6) ThenBlock: {
            CA_CstrApplyPending()
            CadApp.cstr_ready = 0
        }
        IfCondition EqualTo(CadApp.hud_kind, 7) ThenBlock: {
            CA_PadApplyHeight()
        }
        IfCondition EqualTo(CadApp.hud_kind, 8) ThenBlock: {
            CA_RevApplyDeg()
        }
        IfCondition EqualTo(CadApp.hud_kind, 9) ThenBlock: {
            rc = CA_HudApplyChamfer()
            IfCondition NotEqual(rc, 0) ThenBlock: {
                CA_WriteDimHud()
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(CadApp.hud_kind, 10) ThenBlock: {
            rc = CA_HudApplyFillet3d()
            IfCondition NotEqual(rc, 0) ThenBlock: {
                CadApp.hud_field = 0
                CA_WriteDimHud()
                ReturnValue(0)
            }
        }
        CA_HudClose()
        ReturnValue(0)
    }
}

Function.CA_RectCommitHud {
    Output: Integer
    Body: {
        CA_LogInt("cad_app: rect commit W=", 23, CadApp.rect_w)
        CA_LogInt("cad_app: rect commit H=", 23, CadApp.rect_h)
        IfCondition LessThan(CadApp.rect_w, 1) ThenBlock: {
            CadApp.hud_field = 0
            CA_WriteDimHud()
            CA_Log("cad_app: rect needs Width\n", 25)
            ReturnValue(0)
        }
        IfCondition LessThan(CadApp.rect_h, 1) ThenBlock: {
            CadApp.hud_field = 1
            CA_WriteDimHud()
            CA_Log("cad_app: rect needs Height (Tab/type H, Enter)\n", 47)
            ReturnValue(0)
        }
        IfCondition GreaterEqual(CadApp.last_rect, 0) ThenBlock: {
            CA_RectRebuild(CadApp.last_rect)
        }
        IfCondition LessThan(CadApp.last_rect, 0) ThenBlock: {
            IfCondition GreaterThan(CadApp.nclick, 0) ThenBlock: {
                CA_PlaceRectCenter()
            }
        }
        IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
            CA_LookAlongActivePlane()
        }
        CA_HudClose()
        CA_PublishFrame()
        ReturnValue(1)
    }
}

Function.CA_CircCommitHud {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.circ_r, 1) ThenBlock: {
            CA_WriteDimHud()
            CA_Log("cad_app: circ needs R or D\n", 27)
            ReturnValue(0)
        }
        v = Float_FromInt(CadApp.circ_r)
        IfCondition GreaterEqual(CadApp.last_circ, 0) ThenBlock: {
            CAD_Sketch.SetCircleRadius(CadApp.sketch, CadApp.last_circ, v)
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            CA_HistPush(10)
            CA_SolveNow()
            CA_HudClose()
            CA_PublishFrame()
            ReturnValue(1)
        }
        IfCondition GreaterThan(CadApp.nclick, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                CadApp.sketch = CAD_Sketch.CreateSketch(1)
            }
            CAD_Sketch.AddCircle(CadApp.sketch, CadApp.cx0, CadApp.cy0, v)
            CA_CircRemember()
            CadApp.nclick = 0
            CadApp.dirty = 1
            CA_InvalidateProfiles()
        }
        IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
            CA_LookAlongActivePlane()
        }
        CA_HudClose()
        CA_PublishFrame()
        ReturnValue(1)
    }
}

Function.CA_HudOpenPoly {
    Output: Integer
    Body: {
        CadApp.hud_kind = 1
        CadApp.hud_field = 0
        IfCondition EqualTo(CadApp.poly_mode, 0) ThenBlock: {
            CadApp.hud_field = 1
        }
        IfCondition LessThan(CadApp.poly_n, 3) ThenBlock: {
            IfCondition EqualTo(CadApp.poly_mode, 0) ThenBlock: { CadApp.poly_n = 6 }
        }
        CA_PolySyncFromSide()
        CA_Log("cad_app: poly HUD (N/L/D)\n", 26)
        ReturnValue(0)
    }
}

Function.CA_HudOpenLine {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.last_line, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        xy = Allocate(32)
        CAD_Sketch.GetLineEnd(CadApp.sketch, CadApp.last_line, 0, xy)
        x0 = ArrayGet(xy, 0)
        y0 = ArrayGet(xy, 1)
        CAD_Sketch.GetLineEnd(CadApp.sketch, CadApp.last_line, 1, xy)
        dx = Float_Sub(ArrayGet(xy, 0), x0)
        dy = Float_Sub(ArrayGet(xy, 1), y0)
        Deallocate(xy, 32)
        ln = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        CadApp.live_len = Float_ToInt(ln)
        ang = CAD_Geom.Atan2(dy, dx)
        k = Float_Div(0x4066800000000000, 0x400921FB54442D18)
        deg = Float_ToInt(Float_Mul(ang, k))
        IfCondition LessThan(deg, 0) ThenBlock: { deg = Add(deg, 360) }
        CadApp.live_ang = deg
        CadApp.hud_kind = 2
        CadApp.hud_field = 0
        CA_Log("cad_app: line HUD (L/A)\n", 24)
        ReturnValue(0)
    }
}

Function.CA_HudOpenCirc {
    Output: Integer
    Body: {
        CadApp.hud_kind = 3
        CadApp.hud_field = 0
        IfCondition GreaterThan(CadApp.circ_r, 0) ThenBlock: {
            CadApp.circ_d = Multiply(CadApp.circ_r, 2)
        }
        CA_Log("cad_app: circ HUD (R/D)\n", 24)
        ReturnValue(0)
    }
}

Function.CA_HudOpenRect {
    Output: Integer
    Body: {
        CadApp.hud_kind = 4
        CadApp.hud_field = 0
        CA_Log("cad_app: rect HUD (W/H)\n", 24)
        ReturnValue(0)
    }
}

Function.CA_HudOpenFillet {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.fillet_r, 0) ThenBlock: {
            CadApp.fillet_r = 0x4000000000000000
        }
        CadApp.hud_kind = 5
        CadApp.hud_field = 0
        CA_Log("cad_app: fillet HUD (R)\n", 24)
        ReturnValue(0)
    }
}

Function.CA_HudOpenChamfer {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.chamfer_d, 1) ThenBlock: { CadApp.chamfer_d = 2 }
        IfCondition LessThan(CadApp.chamfer_a, 1) ThenBlock: { CadApp.chamfer_a = 45 }
        IfCondition GreaterThan(CadApp.chamfer_a, 89) ThenBlock: { CadApp.chamfer_a = 89 }
        IfCondition NotEqual(CadApp.hud_kind, 9) ThenBlock: {
            CadApp.hud_field = 0
        }
        CadApp.hud_kind = 9
        CA_Log("cad_app: chamfer HUD (Tab Pick/D/A, arrows change)\n", 51)
        ReturnValue(0)
    }
}

Function.CA_HudApplyChamfer {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.chamfer_d, 1) ThenBlock: { CadApp.chamfer_d = 2 }
        IfCondition GreaterThan(CadApp.chamfer_d, 10000) ThenBlock: { CadApp.chamfer_d = 10000 }
        ReturnValue(CA_ChamferSolid(CadApp.chamfer_d))
    }
}

Function.CA_HudOpenFillet3d {
    Output: Integer
    Body: {
        rr = Float_ToInt(CadApp.fillet_r)
        IfCondition LessThan(rr, 3) ThenBlock: {
            CadApp.fillet_r = 0x4020000000000000
        }
        IfCondition NotEqual(CadApp.hud_kind, 10) ThenBlock: {
            CadApp.hud_field = 1
        }
        CadApp.hud_kind = 10
        CA_Log("cad_app: 3D fillet HUD (Tab Pick/R, arrows change)\n", 51)
        ReturnValue(0)
    }
}

Function.CA_HudApplyFillet3d {
    Output: Integer
    Body: {
        r = Float_ToInt(CadApp.fillet_r)
        IfCondition LessThan(r, 1) ThenBlock: { r = 2 }
        IfCondition GreaterThan(r, 10000) ThenBlock: { r = 10000 }
        ReturnValue(CA_FilletSolid(r))
    }
}

Function.CA_HudOpenCstr {
    Output: Integer
    Body: {
        CadApp.hud_kind = 6
        CadApp.hud_field = 0
        ReturnValue(0)
    }
}

Function.CA_HudOpenPad {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.height, 0) ThenBlock: { CadApp.height = 10 }
        CadApp.hud_kind = 7
        CadApp.hud_field = 0
        CA_Log("cad_app: extrude HUD (H / JOIN CUT NEW)\n", 40)
        ReturnValue(0)
    }
}

Function.CA_PadApplyHeight {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.height, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(CadApp.height, 10000) ThenBlock: { CadApp.height = 10000 }
        IfCondition LessThan(CadApp.height, -10000) ThenBlock: { CadApp.height = -10000 }
        IfCondition LessThan(CadApp.height, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: { CadApp.extrude_op = 1 }
        }
        IfCondition EqualTo(CadApp.extrude_op, 1) ThenBlock: {
            IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
                CA_Log("cad_app: cut needs a solid\n", 27)
                ReturnValue(-1)
            }
        }
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            IfCondition GreaterEqual(CadApp.feat_sel, 0) ThenBlock: {
                IfCondition LessThan(CadApp.feat_sel, CadApp.feat_n) ThenBlock: {
                    fk = ArrayGet(CadApp.feat_kind, CadApp.feat_sel)
                    IfCondition EqualTo(fk, 1) ThenBlock: {
                        ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.height)
                    }
                    IfCondition EqualTo(fk, 3) ThenBlock: {
                        ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.height)
                    }
                }
            }
        }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        CadApp.pad_edit = CA_PadShouldEdit()
        IfCondition EqualTo(CadApp.pad_edit, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
                skn = CadApp.nprof
                IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                    sn = CAD_Store.Read(CadApp.sketch, 12)
                    IfCondition GreaterThan(sn, 0) ThenBlock: { skn = sn }
                }
                IfCondition EqualTo(skn, 1) ThenBlock: {
                    CadApp.prof_user = 1
                    CadApp.prof_mask = 1
                    CadApp.prof_sel = 0
                    CA_Log("cad_app: extrude using the one closed profile\n", 46)
                }
            }
            IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
                CA_Log("cad_app: extrude FAIL - pick a light-red profile first\n", 55)
                ReturnValue(-3)
            }
        }
        rc = CA_BuildSolid()
        CadApp.auto_pad = 0
        CadApp.pad_edit = 0
        CadApp.mode = 0
        ReturnValue(rc)
    }
}

Function.CA_HudOpenRev {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.rev_deg, 1) ThenBlock: { CadApp.rev_deg = 360 }
        CadApp.hud_kind = 8
        CadApp.hud_field = 0
        CA_Log("cad_app: revolve HUD (A deg)\n", 29)
        ReturnValue(0)
    }
}

Function.CA_RevApplyDeg {
    Output: Integer
    Body: {
        IfCondition LessThan(CadApp.rev_deg, 1) ThenBlock: { CadApp.rev_deg = 1 }
        IfCondition GreaterThan(CadApp.rev_deg, 360) ThenBlock: { CadApp.rev_deg = 360 }
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            IfCondition GreaterEqual(CadApp.feat_sel, 0) ThenBlock: {
                IfCondition LessThan(CadApp.feat_sel, CadApp.feat_n) ThenBlock: {
                    IfCondition EqualTo(ArrayGet(CadApp.feat_kind, CadApp.feat_sel), 2) ThenBlock: {
                        ArraySet(CadApp.feat_aux, CadApp.feat_sel, CadApp.rev_deg)
                    }
                }
            }
        }
        IfCondition EqualTo(CadAppRev.ok, 0) ThenBlock: { ReturnValue(-1) }
        CadApp.rev_edit = 1
        rc = CA_RevolveFromSketch()
        CadApp.rev_edit = 0
        CadApp.mode = 0
        ReturnValue(rc)
    }
}

Function.CA_RevEditFeat {
    Input: feat_i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(feat_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(feat_i, CadApp.feat_n) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CadApp.feat_kind, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ArrayGet(CadApp.feat_kind, feat_i), 2) ThenBlock: { ReturnValue(-1) }
        CadApp.feat_sel = feat_i
        CadApp.last_revf = feat_i
        dd = CadApp.rev_deg
        IfCondition NotEqual(CadApp.feat_aux, 0) ThenBlock: {
            da = ArrayGet(CadApp.feat_aux, feat_i)
            IfCondition GreaterThan(da, 0) ThenBlock: { dd = da }
        }
        CadApp.rev_deg = dd
        CadApp.mode = 0
        CA_HudOpenRev()
        ReturnValue(0)
    }
}

// Left-click tree: select only. Right-click Edit / double-click opens HUD.
