// Sketch Move. Drag the point or the line under the cursor.
// No selector. Preview writes geometry. Release calls CAD_Solve2D.MovePoint.
// A refused solve puts the sketch back. Tolerances stay in CAD_Num.
//
// mv_buf slots:
//  0 on  1 kind  2 id  3 kind2 (-1 none)  4 id2
//  5 u0  6 v0  7 ax  8 ay  9 bx  10 by
//  11 lines  12 ln  13 lb  14 upts  15 un  16 ub
//  17 circ  18 cn  19 cb  20 arcs  21 an  22 ab
//  23 rect line0 (-1 none)  24 n  25 src  28 x  29 y  30 rc
//  31 xy  32 ki  33 wx  34 wy  36 dx  37 dy  38 end index
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.UtilArgs
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Solve2D
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_View
LibraryImport.Cad.CAD_Repo
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_UI
LibraryImport.Display.Render.Framebuffer
LibraryImport.StringUtils

Function.CA_MoveBuf {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.mv_buf, 0) ThenBlock: {
            p = Allocate(512)
            CadApp.mv_buf = p
            IfCondition NotEqual(p, 0) ThenBlock: {
                // A freed slab still holds the last owner's words. Slot 0
                // is the drag flag. A miss must not follow those words.
                i = 0
                WhileLoop LessThan(i, 40) {
                    ArraySet(CadApp.mv_buf, i, 0)
                    i = Add(i, 1)
                }
                ArraySet(CadApp.mv_buf, 3, -1)
                ArraySet(CadApp.mv_buf, 23, -1)
                q = Allocate(32)
                ArraySet(CadApp.mv_buf, 31, q)
                q = Allocate(32)
                ArraySet(CadApp.mv_buf, 32, q)
            }
        }
        ReturnValue(CadApp.mv_buf)
    }
}

Function.CA_MoveBlk {
    Input: src: Address
    Input: dst: Address
    Input: n: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, n) {
            v = ArrayGet(src, i)
            ArraySet(dst, i, v)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Copy nwords from src into a new block. Pointer, count, and byte size
// land in mv_buf at slotp / slotn / slotb.
Function.CA_MoveTake {
    Input: src: Address
    Input: nwords: Integer
    Input: slotp: Integer
    Input: slotn: Integer
    Input: slotb: Integer
    Output: Integer
    Body: {
        b = CadApp.mv_buf
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(-1) }
        ArraySet(b, slotn, nwords)
        IfCondition LessEqual(nwords, 0) ThenBlock: {
            ArraySet(b, slotp, 0)
            ArraySet(b, slotb, 0)
            ReturnValue(0)
        }
        bytes = Multiply(Add(nwords, 2), 8)
        ArraySet(b, slotb, bytes)
        ArraySet(b, 25, src)
        p = Allocate(bytes)
        ArraySet(b, slotp, p)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(-1) }
        src = ArrayGet(b, 25)
        nwords = ArrayGet(b, slotn)
        CA_MoveBlk(src, p, nwords)
        ReturnValue(0)
    }
}

Function.CA_MoveFree {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.mv_buf, 0) ThenBlock: { ReturnValue(0) }
        p = ArrayGet(CadApp.mv_buf, 11)
        nb = ArrayGet(CadApp.mv_buf, 13)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, nb) }
        ArraySet(CadApp.mv_buf, 11, 0)
        p = ArrayGet(CadApp.mv_buf, 14)
        nb = ArrayGet(CadApp.mv_buf, 16)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, nb) }
        ArraySet(CadApp.mv_buf, 14, 0)
        p = ArrayGet(CadApp.mv_buf, 17)
        nb = ArrayGet(CadApp.mv_buf, 19)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, nb) }
        ArraySet(CadApp.mv_buf, 17, 0)
        p = ArrayGet(CadApp.mv_buf, 20)
        nb = ArrayGet(CadApp.mv_buf, 22)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, nb) }
        ArraySet(CadApp.mv_buf, 20, 0)
        ReturnValue(0)
    }
}

Function.CA_MoveSave {
    Output: Integer
    Body: {
        b = CadApp.mv_buf
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(-1) }
        CA_MoveFree()
        n = CAD_Sketch.GetLineCount(CadApp.sketch)
        ArraySet(CadApp.mv_buf, 24, n)
        src = CAD_Store.Read(CadApp.sketch, 1)
        n = ArrayGet(CadApp.mv_buf, 24)
        nw = Multiply(n, 4)
        rc = CA_MoveTake(src, nw, 11, 12, 13)
        IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(rc) }
        n = CAD_Sketch.GetUserPointCount(CadApp.sketch)
        ArraySet(CadApp.mv_buf, 24, n)
        src = CAD_Store.Read(CadApp.sketch, 25)
        n = ArrayGet(CadApp.mv_buf, 24)
        nw = Multiply(n, 2)
        rc = CA_MoveTake(src, nw, 14, 15, 16)
        IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(rc) }
        n = CAD_Store.Read(CadApp.sketch, 7)
        ArraySet(CadApp.mv_buf, 24, n)
        src = CAD_Store.Read(CadApp.sketch, 8)
        n = ArrayGet(CadApp.mv_buf, 24)
        nw = Multiply(n, 3)
        rc = CA_MoveTake(src, nw, 17, 18, 19)
        IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(rc) }
        n = CAD_Store.Read(CadApp.sketch, 10)
        ArraySet(CadApp.mv_buf, 24, n)
        src = CAD_Store.Read(CadApp.sketch, 11)
        n = ArrayGet(CadApp.mv_buf, 24)
        nw = Multiply(n, 5)
        rc = CA_MoveTake(src, nw, 20, 21, 22)
        ReturnValue(rc)
    }
}

Function.CA_MovePut {
    Input: slotp: Integer
    Input: slotn: Integer
    Input: store_slot: Integer
    Output: Integer
    Body: {
        b = CadApp.mv_buf
        p = ArrayGet(b, slotp)
        n = ArrayGet(b, slotn)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(b, 25, p)
        ArraySet(b, 24, n)
        dst = CAD_Store.Read(CadApp.sketch, store_slot)
        src = ArrayGet(CadApp.mv_buf, 25)
        n = ArrayGet(CadApp.mv_buf, 24)
        CA_MoveBlk(src, dst, n)
        ReturnValue(0)
    }
}

Function.CA_MoveUndo {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.mv_buf, 0) ThenBlock: { ReturnValue(0) }
        CA_MovePut(11, 12, 1)
        CA_MovePut(14, 15, 25)
        CA_MovePut(17, 18, 8)
        CA_MovePut(20, 21, 11)
        CAD_Sketch.RebuildAnchors(CadApp.sketch)
        ReturnValue(0)
    }
}

Function.CA_MoveCancel {
    Output: Integer
    Body: {
        b = CadApp.mv_buf
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        on = ArrayGet(b, 0)
        IfCondition EqualTo(on, 1) ThenBlock: { CA_MoveUndo() }
        CA_MoveFree()
        ArraySet(CadApp.mv_buf, 0, 0)
        ArraySet(CadApp.mv_buf, 3, -1)
        ArraySet(CadApp.mv_buf, 23, -1)
        ReturnValue(0)
    }
}

// line0 of the rectangle that owns this line, or -1.
Function.CA_MoveRectLine {
    Input: li: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.rt_tab, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(li, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Sketch.GetLineCount(CadApp.sketch)
        ri = 0
        WhileLoop LessThan(ri, CadApp.rt_n) {
            b = Multiply(ri, 10)
            line0 = ArrayGet(CadApp.rt_tab, b)
            sk = ArrayGet(CadApp.rt_tab, Add(b, 4))
            hit = 0
            IfCondition EqualTo(sk, CadApp.sketch) ThenBlock: {
                IfCondition GreaterEqual(li, line0) ThenBlock: {
                    IfCondition LessThan(li, Add(line0, 4)) ThenBlock: {
                        IfCondition LessThan(Add(line0, 3), n) ThenBlock: { hit = 1 }
                    }
                }
            }
            IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(line0) }
            ri = Add(ri, 1)
        }
        ReturnValue(-1)
    }
}

// Translate all four lines from the snapshot by the grab delta.
Function.CA_MoveRectPreview {
    Output: Integer
    Body: {
        b = CadApp.mv_buf
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        dx = Float_Sub(ArrayGet(b, 33), ArrayGet(b, 5))
        dy = Float_Sub(ArrayGet(b, 34), ArrayGet(b, 6))
        ArraySet(b, 36, dx)
        ArraySet(b, 37, dy)
        ArraySet(b, 38, 0)
        WhileLoop LessThan(ArrayGet(CadApp.mv_buf, 38), 8) {
            b = CadApp.mv_buf
            snap = ArrayGet(b, 11)
            line0 = ArrayGet(b, 23)
            dx = ArrayGet(b, 36)
            dy = ArrayGet(b, 37)
            e = ArrayGet(b, 38)
            li = Add(line0, Divide(e, 2))
            en = Modulo(e, 2)
            w = Add(Multiply(li, 4), Multiply(en, 2))
            ox = ArrayGet(snap, w)
            oy = ArrayGet(snap, Add(w, 1))
            ArraySet(b, 28, Float_Add(ox, dx))
            ArraySet(b, 29, Float_Add(oy, dy))
            ArraySet(b, 24, Add(Multiply(li, 2), en))
            sk = CadApp.sketch
            id = ArrayGet(b, 24)
            x = ArrayGet(b, 28)
            y = ArrayGet(b, 29)
            CAD_Sketch.SetTargetXY(sk, 0, id, x, y)
            e = ArrayGet(CadApp.mv_buf, 38)
            ArraySet(CadApp.mv_buf, 38, Add(e, 1))
        }
        ReturnValue(0)
    }
}

Function.CA_MoveRectDrop {
    Output: Integer
    Body: {
        CA_MoveUndo()
        ArraySet(CadApp.mv_buf, 38, 0)
        WhileLoop LessThan(ArrayGet(CadApp.mv_buf, 38), 8) {
            b = CadApp.mv_buf
            snap = ArrayGet(b, 11)
            line0 = ArrayGet(b, 23)
            dx = ArrayGet(b, 36)
            dy = ArrayGet(b, 37)
            e = ArrayGet(b, 38)
            li = Add(line0, Divide(e, 2))
            en = Modulo(e, 2)
            w = Add(Multiply(li, 4), Multiply(en, 2))
            ox = ArrayGet(snap, w)
            oy = ArrayGet(snap, Add(w, 1))
            ArraySet(b, 28, Float_Add(ox, dx))
            ArraySet(b, 29, Float_Add(oy, dy))
            ArraySet(b, 24, Add(Multiply(li, 2), en))
            xy = ArrayGet(b, 31)
            sk = CadApp.sketch
            id = ArrayGet(b, 24)
            CAD_Sketch.GetTargetXY(sk, 0, id, xy)
            xy = ArrayGet(CadApp.mv_buf, 31)
            cx = ArrayGet(xy, 0)
            cy = ArrayGet(xy, 1)
            wantx = ArrayGet(CadApp.mv_buf, 28)
            wanty = ArrayGet(CadApp.mv_buf, 29)
            ArraySet(CadApp.mv_buf, 28, Float_Sub(wantx, cx))
            ArraySet(CadApp.mv_buf, 29, Float_Sub(wanty, cy))
            b = CadApp.mv_buf
            sk = CadApp.sketch
            id = ArrayGet(b, 24)
            dx = ArrayGet(b, 28)
            dy = ArrayGet(b, 29)
            rc = CAD_Solve2D.MovePoint(sk, 0, id, dx, dy)
            ArraySet(CadApp.mv_buf, 30, rc)
            IfCondition NotEqual(rc, 0) ThenBlock: {
                CA_MoveUndo()
                CA_MoveFree()
                ArraySet(CadApp.mv_buf, 0, 0)
                ArraySet(CadApp.mv_buf, 3, -1)
                ArraySet(CadApp.mv_buf, 23, -1)
                CA_Log("cad_app: move refused\n", 22)
                ReturnValue(rc)
            }
            e = ArrayGet(CadApp.mv_buf, 38)
            ArraySet(CadApp.mv_buf, 38, Add(e, 1))
        }
        CA_MoveFree()
        ArraySet(CadApp.mv_buf, 0, 0)
        ArraySet(CadApp.mv_buf, 3, -1)
        ArraySet(CadApp.mv_buf, 23, -1)
        CadApp.dirty = 1
        CA_Log("cad_app: moved\n", 15)
        ReturnValue(0)
    }
}

Function.CA_MovePreview {
    Output: Integer
    Body: {
        b = CadApp.mv_buf
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(b, 0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(ArrayGet(b, 23), 0) ThenBlock: {
            ReturnValue(CA_MoveRectPreview())
        }
        dx = Float_Sub(ArrayGet(b, 33), ArrayGet(b, 5))
        dy = Float_Sub(ArrayGet(b, 34), ArrayGet(b, 6))
        ArraySet(b, 36, dx)
        ArraySet(b, 37, dy)
        nx = Float_Add(ArrayGet(b, 7), ArrayGet(b, 36))
        ny = Float_Add(ArrayGet(b, 8), ArrayGet(b, 37))
        ArraySet(b, 28, nx)
        ArraySet(b, 29, ny)
        sk = CadApp.sketch
        k = ArrayGet(b, 1)
        i = ArrayGet(b, 2)
        x = ArrayGet(b, 28)
        y = ArrayGet(b, 29)
        CAD_Sketch.SetTargetXY(sk, k, i, x, y)
        IfCondition GreaterEqual(ArrayGet(CadApp.mv_buf, 3), 0) ThenBlock: {
            b = CadApp.mv_buf
            nx = Float_Add(ArrayGet(b, 9), ArrayGet(b, 36))
            ny = Float_Add(ArrayGet(b, 10), ArrayGet(b, 37))
            ArraySet(b, 28, nx)
            ArraySet(b, 29, ny)
            sk = CadApp.sketch
            k = ArrayGet(b, 3)
            i = ArrayGet(b, 4)
            x = ArrayGet(b, 28)
            y = ArrayGet(b, 29)
            CAD_Sketch.SetTargetXY(sk, k, i, x, y)
        }
        ReturnValue(0)
    }
}

// wx, wy already sit in slots 33 and 34.
Function.CA_MoveGrab {
    Output: Integer
    Body: {
        b = CadApp.mv_buf
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        ki = ArrayGet(b, 32)
        wx = ArrayGet(b, 33)
        wy = ArrayGet(b, 34)
        hit = CA_HitEntity(wx, wy, ki)
        IfCondition EqualTo(hit, 0) ThenBlock: { ReturnValue(0) }
        ki = ArrayGet(CadApp.mv_buf, 32)
        k = ArrayGet(ki, 0)
        i = ArrayGet(ki, 1)
        // 0 line-end, 2 whole line, 3 user point, 4 circle center.
        // An arc rim is not a point and not a line.
        take = 0
        IfCondition EqualTo(k, 0) ThenBlock: { take = 1 }
        IfCondition EqualTo(k, 2) ThenBlock: { take = 1 }
        IfCondition EqualTo(k, 3) ThenBlock: { take = 1 }
        IfCondition EqualTo(k, 4) ThenBlock: { take = 1 }
        IfCondition EqualTo(take, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CadApp.mv_buf, 26, k)
        ArraySet(CadApp.mv_buf, 27, i)
        rc = CA_MoveSave()
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_MoveFree()
            ReturnValue(0)
        }
        b = CadApp.mv_buf
        k = ArrayGet(b, 26)
        i = ArrayGet(b, 27)
        IfCondition EqualTo(k, 2) ThenBlock: {
            ArraySet(b, 1, 0)
            ArraySet(b, 2, Multiply(i, 2))
            ArraySet(b, 3, 0)
            ArraySet(b, 4, Add(Multiply(i, 2), 1))
        }
        IfCondition NotEqual(k, 2) ThenBlock: {
            ArraySet(b, 1, k)
            ArraySet(b, 2, i)
            ArraySet(b, 3, -1)
            ArraySet(b, 4, 0)
        }
        li = i
        IfCondition EqualTo(k, 0) ThenBlock: { li = Divide(i, 2) }
        ArraySet(CadApp.mv_buf, 23, -1)
        IfCondition EqualTo(k, 0) ThenBlock: {
            line0 = CA_MoveRectLine(li)
            ArraySet(CadApp.mv_buf, 23, line0)
        }
        IfCondition EqualTo(k, 2) ThenBlock: {
            line0 = CA_MoveRectLine(i)
            ArraySet(CadApp.mv_buf, 23, line0)
        }
        b = CadApp.mv_buf
        xy = ArrayGet(b, 31)
        sk = CadApp.sketch
        k = ArrayGet(b, 1)
        i = ArrayGet(b, 2)
        CAD_Sketch.GetTargetXY(sk, k, i, xy)
        xy = ArrayGet(CadApp.mv_buf, 31)
        ArraySet(CadApp.mv_buf, 7, ArrayGet(xy, 0))
        ArraySet(CadApp.mv_buf, 8, ArrayGet(xy, 1))
        IfCondition GreaterEqual(ArrayGet(CadApp.mv_buf, 3), 0) ThenBlock: {
            b = CadApp.mv_buf
            xy = ArrayGet(b, 31)
            sk = CadApp.sketch
            k = ArrayGet(b, 3)
            i = ArrayGet(b, 4)
            CAD_Sketch.GetTargetXY(sk, k, i, xy)
            xy = ArrayGet(CadApp.mv_buf, 31)
            ArraySet(CadApp.mv_buf, 9, ArrayGet(xy, 0))
            ArraySet(CadApp.mv_buf, 10, ArrayGet(xy, 1))
        }
        ArraySet(CadApp.mv_buf, 5, ArrayGet(CadApp.mv_buf, 33))
        ArraySet(CadApp.mv_buf, 6, ArrayGet(CadApp.mv_buf, 34))
        ArraySet(CadApp.mv_buf, 0, 1)
        CA_MovePreview()
        ReturnValue(1)
    }
}

Function.CA_MoveDrag {
    Input: wx: Integer
    Input: wy: Integer
    Output: Integer
    Body: {
        CadApp.mv_x = wx
        CadApp.mv_y = wy
        b = CA_MoveBuf()
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(-1) }
        ArraySet(b, 33, CadApp.mv_x)
        ArraySet(b, 34, CadApp.mv_y)
        IfCondition EqualTo(ArrayGet(b, 0), 0) ThenBlock: {
            ReturnValue(CA_MoveGrab())
        }
        ReturnValue(CA_MovePreview())
    }
}

Function.CA_MoveRelease {
    Input: wx: Integer
    Input: wy: Integer
    Output: Integer
    Body: {
        CadApp.mv_x = wx
        CadApp.mv_y = wy
        b = CA_MoveBuf()
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(1) }
        ArraySet(b, 33, CadApp.mv_x)
        ArraySet(b, 34, CadApp.mv_y)
        IfCondition EqualTo(ArrayGet(b, 0), 0) ThenBlock: { ReturnValue(1) }
        dx = Float_Sub(ArrayGet(b, 33), ArrayGet(b, 5))
        dy = Float_Sub(ArrayGet(b, 34), ArrayGet(b, 6))
        ArraySet(b, 36, dx)
        ArraySet(b, 37, dy)
        IfCondition GreaterEqual(ArrayGet(b, 23), 0) ThenBlock: {
            ReturnValue(CA_MoveRectDrop())
        }
        CA_MoveUndo()
        b = CadApp.mv_buf
        sk = CadApp.sketch
        k = ArrayGet(b, 1)
        i = ArrayGet(b, 2)
        dx = ArrayGet(b, 36)
        dy = ArrayGet(b, 37)
        rc = CAD_Solve2D.MovePoint(sk, k, i, dx, dy)
        ArraySet(CadApp.mv_buf, 30, rc)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_MoveUndo()
            CA_MoveFree()
            ArraySet(CadApp.mv_buf, 0, 0)
            ArraySet(CadApp.mv_buf, 3, -1)
            CA_Log("cad_app: move refused\n", 22)
            ReturnValue(rc)
        }
        IfCondition GreaterEqual(ArrayGet(CadApp.mv_buf, 3), 0) ThenBlock: {
            b = CadApp.mv_buf
            xy = ArrayGet(b, 31)
            sk = CadApp.sketch
            k = ArrayGet(b, 3)
            i = ArrayGet(b, 4)
            CAD_Sketch.GetTargetXY(sk, k, i, xy)
            xy = ArrayGet(CadApp.mv_buf, 31)
            cx = ArrayGet(xy, 0)
            cy = ArrayGet(xy, 1)
            wantx = Float_Add(ArrayGet(CadApp.mv_buf, 9), ArrayGet(CadApp.mv_buf, 36))
            wanty = Float_Add(ArrayGet(CadApp.mv_buf, 10), ArrayGet(CadApp.mv_buf, 37))
            ArraySet(CadApp.mv_buf, 28, Float_Sub(wantx, cx))
            ArraySet(CadApp.mv_buf, 29, Float_Sub(wanty, cy))
            b = CadApp.mv_buf
            sk = CadApp.sketch
            k = ArrayGet(b, 3)
            i = ArrayGet(b, 4)
            dx = ArrayGet(b, 28)
            dy = ArrayGet(b, 29)
            rc = CAD_Solve2D.MovePoint(sk, k, i, dx, dy)
            ArraySet(CadApp.mv_buf, 30, rc)
            IfCondition NotEqual(rc, 0) ThenBlock: {
                CA_MoveUndo()
                CA_MoveFree()
                ArraySet(CadApp.mv_buf, 0, 0)
                ArraySet(CadApp.mv_buf, 3, -1)
                CA_Log("cad_app: move refused\n", 22)
                ReturnValue(rc)
            }
        }
        CA_MoveFree()
        ArraySet(CadApp.mv_buf, 0, 0)
        ArraySet(CadApp.mv_buf, 3, -1)
        CadApp.dirty = 1
        CA_Log("cad_app: moved\n", 15)
        ReturnValue(0)
    }
}
