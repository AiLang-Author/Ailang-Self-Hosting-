Function.CA_SketchClick {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
        }
        xy = Allocate(32)
        CA_PixToWorld(px, py, xy)
        wx = ArrayGet(xy, 0)
        wy = ArrayGet(xy, 1)
        Deallocate(xy, 32)
        // line: 2 clicks
        IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: {
                CadApp.cx0 = wx
                CadApp.cy0 = wy
                CadApp.nclick = 1
            }
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                // second click — but nclick already 1 from first; use flag carefully
            }
        }
        // simpler sequential: if nclick==0 store; else complete and reset
        IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                // was already 1 before this click started... re-read logic
            }
        }
        ReturnValue(0)
    }
}

// Snap world (wx,wy): datum, then endpoints, then the line body, then a circle rim.
// Same ~10 px radius for all of them. A corner inside that radius stays the
// corner. A click on a side, off the corner, lands on the side.
// The query lives in clk_x/clk_y. A face sketch's camera fit kills argument locals,
// and those locals then read as the origin.
// Writes snapped coords to out[0],out[1]. Returns 1 if snapped, 0 if left as-is.

// (ox, oy) replaces the candidate when it is nearer than dx (best squared).
Function.CA_SnapConsider {
    Output: Integer
    Body: {
        CadAppPick.cdx = Float_Sub(CadAppPick.clk_x, CadAppPick.ox)
        CadAppPick.hu = Float_Mul(CadAppPick.cdx, CadAppPick.cdx)
        CadAppPick.cdy = Float_Sub(CadAppPick.clk_y, CadAppPick.oy)
        CadAppPick.hv = Float_Mul(CadAppPick.cdy, CadAppPick.cdy)
        CadAppPick.cdx = Float_Add(CadAppPick.hu, CadAppPick.hv)
        IfCondition EqualTo(Float_Le(CadAppPick.cdx, CadAppPick.dx), 1) ThenBlock: {
            CadAppPick.dx = CadAppPick.cdx
            CadAppPick.bx = CadAppPick.ox
            CadAppPick.by = CadAppPick.oy
            CadAppPick.pins = 1
        }
        ReturnValue(0)
    }
}

// 1 when the candidate would collapse the segment that starts at (cx0, cy0).
Function.CA_SnapTooShort {
    Output: Integer
    Body: {
        CadAppPick.pn = 0
        IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
            CadAppPick.cdx = Float_Sub(CadAppPick.bx, CadApp.cx0)
            CadAppPick.hu = Float_Mul(CadAppPick.cdx, CadAppPick.cdx)
            CadAppPick.cdy = Float_Sub(CadAppPick.by, CadApp.cy0)
            CadAppPick.hv = Float_Mul(CadAppPick.cdy, CadAppPick.cdy)
            CadAppPick.cdx = Float_Add(CadAppPick.hu, CadAppPick.hv)
            IfCondition EqualTo(Float_Le(CadAppPick.cdx, CadAppPick.ay), 1) ThenBlock: {
                CadAppPick.pn = 1
            }
        }
        ReturnValue(CadAppPick.pn)
    }
}

// Skip the endpoint that is the click already stored, then consider the other.
Function.CA_SnapKeepEnd {
    Output: Integer
    Body: {
        CadAppPick.pj = 0
        IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(CadAppPick.ox, CadApp.cx0, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(CadAppPick.oy, CadApp.cy0, 0), 1) ThenBlock: {
                    CadAppPick.pj = 1
                }
            }
        }
        IfCondition EqualTo(CadAppPick.pj, 0) ThenBlock: {
            CA_SnapConsider()
        }
        ReturnValue(0)
    }
}

Function.CA_SnapWorld {
    Input: wx: Integer
    Input: wy: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        ArraySet(out_xy, 0, wx)
        ArraySet(out_xy, 1, wy)
        CadAppPick.clk_x = wx
        CadAppPick.clk_y = wy
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        CAD_Sketch.EnsureDatum(CadApp.sketch)
        CA_UpdateSketchCam()
        IfCondition EqualTo(CAD_Num.IsZero(CadApp.scale, 0), 1) ThenBlock: { ReturnValue(0) }
        // snap ≈ 10 px. last_t is the radius, ax its square, ay the min segment.
        CadAppPick.last_t = Float_Div(Float_FromInt(10), CadApp.scale)
        CadAppPick.ax = Float_Mul(CadAppPick.last_t, CadAppPick.last_t)
        CadAppPick.ay = Float_Mul(CadAppPick.ax, 0x4010000000000000)
        IfCondition EqualTo(CadAppPick.hit, 0) ThenBlock: {
            CadAppPick.hit = Allocate(32)
        }
        IfCondition EqualTo(CadAppPick.hit, 0) ThenBlock: { ReturnValue(0) }
        // Datum beats free geometry. The radius is last_t, not a dead local.
        CadAppPick.pj = CAD_Sketch.SnapToDatum(CadApp.sketch, CadAppPick.clk_x, CadAppPick.clk_y, CadAppPick.last_t, CadAppPick.hit)
        IfCondition GreaterThan(CadAppPick.pj, 0) ThenBlock: {
            CadAppPick.bx = ArrayGet(CadAppPick.hit, 0)
            CadAppPick.by = ArrayGet(CadAppPick.hit, 1)
            CA_SnapTooShort()
            IfCondition EqualTo(CadAppPick.pn, 0) ThenBlock: {
                ArraySet(out_xy, 0, CadAppPick.bx)
                ArraySet(out_xy, 1, CadAppPick.by)
                ReturnValue(1)
            }
        }
        CadAppPick.dx = CadAppPick.ax
        CadAppPick.bx = CadAppPick.clk_x
        CadAppPick.by = CadAppPick.clk_y
        CadAppPick.pins = 0
        CadAppPick.prof_nn = CAD_Sketch.GetUserPointCount(CadApp.sketch)
        IfCondition GreaterThan(CadAppPick.prof_nn, 0) ThenBlock: {
            CadAppPick.hit_i = 0
            WhileLoop LessThan(CadAppPick.hit_i, CadAppPick.prof_nn) {
                CAD_Sketch.GetUserPoint(CadApp.sketch, CadAppPick.hit_i, CadAppPick.hit)
                CadAppPick.ox = ArrayGet(CadAppPick.hit, 0)
                CadAppPick.oy = ArrayGet(CadAppPick.hit, 1)
                CA_SnapConsider()
                CadAppPick.hit_i = Add(CadAppPick.hit_i, 1)
            }
        }
        CadAppPick.ins_i = CAD_Sketch.GetLineCount(CadApp.sketch)
        IfCondition LessThan(CadAppPick.ins_i, 1) ThenBlock: {
            IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: {
                ArraySet(out_xy, 0, CadAppPick.bx)
                ArraySet(out_xy, 1, CadAppPick.by)
                ReturnValue(1)
            }
            IfCondition EqualTo(CA_SnapToGrid(out_xy), 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        CadAppPick.hit_i = 0
        WhileLoop LessThan(CadAppPick.hit_i, CadAppPick.ins_i) {
            CadAppPick.pi = Multiply(CadAppPick.hit_i, 4)
            CadAppPick.dz = CAD_Store.Read(CadApp.sketch, 1)
            CadAppPick.ox = ArrayGet(CadAppPick.dz, CadAppPick.pi)
            CadAppPick.oy = ArrayGet(CadAppPick.dz, Add(CadAppPick.pi, 1))
            CA_SnapKeepEnd()
            CadAppPick.ox = ArrayGet(CadAppPick.dz, Add(CadAppPick.pi, 2))
            CadAppPick.oy = ArrayGet(CadAppPick.dz, Add(CadAppPick.pi, 3))
            CA_SnapKeepEnd()
            CadAppPick.hit_i = Add(CadAppPick.hit_i, 1)
        }
        // Line body uses the same snap radius. Skip when an endpoint (or user
        // point) already hit — that corner is closer to what the user picked.
        IfCondition EqualTo(CadAppPick.pins, 0) ThenBlock: {
            CadAppPick.pj = CAD_Sketch.SnapToLineBody(CadApp.sketch, CadAppPick.clk_x, CadAppPick.clk_y, CadAppPick.dx, CadAppPick.hit)
            IfCondition EqualTo(CadAppPick.pj, 1) ThenBlock: {
                CadAppPick.ox = ArrayGet(CadAppPick.hit, 0)
                CadAppPick.oy = ArrayGet(CadAppPick.hit, 1)
                CA_SnapConsider()
            }
        }
        CadAppPick.found_n = CAD_Sketch.GetCircleCount(CadApp.sketch)
        IfCondition GreaterThan(CadAppPick.found_n, 0) ThenBlock: {
            CadAppPick.hit_i = 0
            WhileLoop LessThan(CadAppPick.hit_i, CadAppPick.found_n) {
                CadAppPick.pi = Multiply(CadAppPick.hit_i, 3)
                CadAppPick.dz = CAD_Store.Read(CadApp.sketch, 8)
                CadAppPick.ox = ArrayGet(CadAppPick.dz, CadAppPick.pi)
                CadAppPick.oy = ArrayGet(CadAppPick.dz, Add(CadAppPick.pi, 1))
                CadAppPick.cdz = ArrayGet(CadAppPick.dz, Add(CadAppPick.pi, 2))
                CadAppPick.cdx = Float_Sub(CadAppPick.clk_x, CadAppPick.ox)
                CadAppPick.cdy = Float_Sub(CadAppPick.clk_y, CadAppPick.oy)
                CadAppPick.hu = Float_Mul(CadAppPick.cdx, CadAppPick.cdx)
                CadAppPick.hv = Float_Mul(CadAppPick.cdy, CadAppPick.cdy)
                CadAppPick.hu = Float_Add(CadAppPick.hu, CadAppPick.hv)
                CadAppPick.hv = CAD_Num.Sqrt(CadAppPick.hu)
                IfCondition EqualTo(CAD_Num.IsZero(CadAppPick.hv, 0), 0) ThenBlock: {
                    CadAppPick.hu = Float_Sub(CadAppPick.hv, CadAppPick.cdz)
                    IfCondition EqualTo(Float_Le(CadAppPick.hu, 0), 1) ThenBlock: {
                        CadAppPick.hu = Float_Sub(0, CadAppPick.hu)
                    }
                    IfCondition EqualTo(Float_Le(CadAppPick.hu, CadAppPick.last_t), 1) ThenBlock: {
                        CadAppPick.nx = Float_Div(CadAppPick.cdx, CadAppPick.hv)
                        CadAppPick.nx = Float_Mul(CadAppPick.cdz, CadAppPick.nx)
                        CadAppPick.nx = Float_Add(CadAppPick.ox, CadAppPick.nx)
                        CadAppPick.ny = Float_Div(CadAppPick.cdy, CadAppPick.hv)
                        CadAppPick.ny = Float_Mul(CadAppPick.cdz, CadAppPick.ny)
                        CadAppPick.ny = Float_Add(CadAppPick.oy, CadAppPick.ny)
                        CadAppPick.ox = CadAppPick.nx
                        CadAppPick.oy = CadAppPick.ny
                        CA_SnapConsider()
                    }
                }
                CadAppPick.hit_i = Add(CadAppPick.hit_i, 1)
            }
        }
        IfCondition EqualTo(CadAppPick.pins, 1) ThenBlock: {
            CA_SnapTooShort()
            IfCondition EqualTo(CadAppPick.pn, 1) ThenBlock: {
                IfCondition LessThan(CadAppPick.ins_i, 3) ThenBlock: {
                    ReturnValue(0)
                }
            }
            ArraySet(out_xy, 0, CadAppPick.bx)
            ArraySet(out_xy, 1, CadAppPick.by)
            ReturnValue(1)
        }
        IfCondition EqualTo(CA_SnapToGrid(out_xy), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Weld all line endpoints that fall within snap radius so BuildClosedLoop can chain.


Function.CA_TrimAt {
    Input: wx: Integer
    Input: wy: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: trim no sketch\n", 24)
            ReturnValue(0)
        }
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: { sc = 0x3FF0000000000000 }
        // hit within ~16 screen pixels → world (easier curve pick at crosses)
        hit_lim = Float_Div(Float_FromInt(16), sc)
        // kernel owns join storage + split/delete
        rc = CAD_Sketch.TrimAt(CadApp.sketch, wx, wy, hit_lim)
        CA_LogTrimDbg()
        // Circle→arcs leaves stacked residual pieces on the same rim.
        // Eat extras only after a real residual delete; log the first pick
        // (re-TrimAt used to overwrite dbg with pick=NONE / why=no hit).
        IfCondition EqualTo(rc, 5) ThenBlock: {
            g = 0
            WhileLoop LessThan(g, 16) {
                rc2 = CAD_Sketch.TrimAt(CadApp.sketch, wx, wy, hit_lim)
                IfCondition EqualTo(rc2, 5) ThenBlock: {
                    g = Add(g, 1)
                }
                IfCondition NotEqual(rc2, 5) ThenBlock: {
                    g = 16
                }
            }
        }
        IfCondition EqualTo(rc, 0) ThenBlock: {
            CA_Log("cad_app: trim miss\n", 19)
            ReturnValue(0)
        }
        IfCondition EqualTo(rc, 7) ThenBlock: {
            CA_Log("cad_app: trim miss after split\n", 31)
            ReturnValue(0)
        }
        CadApp.dirty = 1
        CA_InvalidateProfiles()
        IfCondition EqualTo(rc, 1) ThenBlock: {
            CA_Log("cad_app: trimmed line stub\n", 27)
        }
        IfCondition EqualTo(rc, 2) ThenBlock: {
            CA_Log("cad_app: trimmed full circle\n", 29)
        }
        IfCondition EqualTo(rc, 3) ThenBlock: {
            CA_Log("cad_app: trimmed circle-arcs\n", 29)
        }
        IfCondition EqualTo(rc, 4) ThenBlock: {
            CA_Log("cad_app: trimmed arc\n", 21)
        }
        IfCondition EqualTo(rc, 5) ThenBlock: {
            CA_Log("cad_app: trimmed whole arc (tip-to-tip)\n", 40)
        }
        IfCondition EqualTo(rc, 6) ThenBlock: {
            CA_Log("cad_app: trimmed line stub (at arc tip)\n", 40)
        }
        IfCondition EqualTo(rc, 8) ThenBlock: {
            CA_Log("cad_app: arc trim restore (no piece)\n", 37)
        }
        nm = CAD_Sketch.MergeCollinearLines(CadApp.sketch)
        IfCondition GreaterThan(nm, 0) ThenBlock: {
            CA_LogInt("cad_app: trim merged lines n=", 29, nm)
        }
        CA_HistPush(7)
        ReturnValue(1)
    }
}


// Hit-test sketch entity near (wx,wy). out_ki[0]=kind out_ki[1]=id.
// kind: 0 line-end (line*2+end)  4 circle  2 whole-line  3 user Point
// Phased: (1) points/ends/centers only  (2) circle rims  (3) line body last.
// Returns 1 hit, 0 miss.



// Hit-test sketch entity near (wx,wy). out_ki[0]=kind out_ki[1]=id.
// kind: 0 line-end (line*2+end)  4 circle  2 whole-line  3 user Point
// Phased: (1) points/ends/centers only  (2) circle rims  (3) line body last.
// Returns 1 hit, 0 miss.
Function.CA_HitEntity {
    Input: wx: Integer
    Input: wy: Integer
    Input: out_ki: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
            sc = 0x3FF0000000000000
        }
        // generous for ends/points so FixO works without pixel-perfect clicks
        snap_pt = Float_Div(Float_FromInt(16), sc)
        snap2 = Float_Mul(snap_pt, snap_pt)
        snap_rim = Float_Div(Float_FromInt(14), sc)
        best = snap2
        hit = 0
        bk = 0
        bi = 0
        sk = CadApp.sketch
        nl = CAD_Sketch.GetLineCount(sk)
        nc = CAD_Sketch.GetCircleCount(sk)
        // --- phase 1: discrete points only (no line body) ---
        nup = CAD_Sketch.GetUserPointCount(sk)
        IfCondition GreaterThan(nup, 0) ThenBlock: {
            xy = Allocate(32)
            ui = 0
            WhileLoop LessThan(ui, nup) {
                CAD_Sketch.GetUserPoint(sk, ui, xy)
                dx = Float_Sub(wx, ArrayGet(xy, 0))
                dy = Float_Sub(wy, ArrayGet(xy, 1))
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    hit = 1
                    bk = 3
                    bi = ui
                }
                ui = Add(ui, 1)
            }
            Deallocate(xy, 32)
        }
        IfCondition GreaterThan(nl, 0) ThenBlock: {
            lines = CAD_Store.Read(sk, 1)
            i = 0
            WhileLoop LessThan(i, nl) {
                b = Multiply(i, 4)
                e = 0
                WhileLoop LessThan(e, 2) {
                    IfCondition EqualTo(e, 0) ThenBlock: {
                        ax = ArrayGet(lines, b)
                        ay = ArrayGet(lines, Add(b, 1))
                    }
                    IfCondition EqualTo(e, 1) ThenBlock: {
                        ax = ArrayGet(lines, Add(b, 2))
                        ay = ArrayGet(lines, Add(b, 3))
                    }
                    dx = Float_Sub(wx, ax)
                    dy = Float_Sub(wy, ay)
                    d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                        best = d2
                        hit = 1
                        bk = 0
                        bi = Add(Multiply(i, 2), e)
                    }
                    e = Add(e, 1)
                }
                i = Add(i, 1)
            }
        }
        IfCondition GreaterThan(nc, 0) ThenBlock: {
            circs = CAD_Store.Read(sk, 8)
            ci = 0
            WhileLoop LessThan(ci, nc) {
                base = Multiply(ci, 3)
                cx = ArrayGet(circs, base)
                cy = ArrayGet(circs, Add(base, 1))
                dx = Float_Sub(wx, cx)
                dy = Float_Sub(wy, cy)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    hit = 1
                    bk = 4
                    bi = ci
                }
                ci = Add(ci, 1)
            }
        }
        // --- phase 2: circle rims only if nothing discrete hit ---
        IfCondition EqualTo(hit, 0) ThenBlock: {
            IfCondition GreaterThan(nc, 0) ThenBlock: {
                circs = CAD_Store.Read(sk, 8)
                best = Float_Mul(snap_rim, snap_rim)
                ci = 0
                WhileLoop LessThan(ci, nc) {
                    base = Multiply(ci, 3)
                    cx = ArrayGet(circs, base)
                    cy = ArrayGet(circs, Add(base, 1))
                    rad = ArrayGet(circs, Add(base, 2))
                    dx = Float_Sub(wx, cx)
                    dy = Float_Sub(wy, cy)
                    d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                    dd = Float_Sub(d, rad)
                    IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
                    IfCondition EqualTo(Float_Le(dd, snap_rim), 1) ThenBlock: {
                        d2r = Float_Mul(dd, dd)
                        IfCondition EqualTo(Float_Le(d2r, best), 1) ThenBlock: {
                            best = d2r
                            hit = 1
                            bk = 4
                            bi = ci
                        }
                    }
                    ci = Add(ci, 1)
                }
            }
            // arc rim — same snap as a circle. Misses here were the tangent clicks.
            ai = CAD_Sketch.ArcNear(sk, wx, wy, snap_rim)
            IfCondition GreaterEqual(ai, 0) ThenBlock: {
                hit = 1
                bk = 5
                bi = ai
            }
        }
        // --- phase 3: whole line body (H/V/OnLn only really want this) ---
        IfCondition EqualTo(hit, 0) ThenBlock: {
            IfCondition GreaterThan(nl, 0) ThenBlock: {
                lines = CAD_Store.Read(sk, 1)
                best = Float_Mul(snap_rim, snap_rim)
                i = 0
                WhileLoop LessThan(i, nl) {
                    b = Multiply(i, 4)
                    x0 = ArrayGet(lines, b)
                    y0 = ArrayGet(lines, Add(b, 1))
                    x1 = ArrayGet(lines, Add(b, 2))
                    y1 = ArrayGet(lines, Add(b, 3))
                    dx = Float_Sub(x1, x0)
                    dy = Float_Sub(y1, y0)
                    aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                        t = Float_Div(Float_Add(Float_Mul(Float_Sub(wx, x0), dx), Float_Mul(Float_Sub(wy, y0), dy)), aa)
                        IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: { t = 0 }
                        IfCondition EqualTo(Float_Le(0x3FF0000000000000, t), 1) ThenBlock: { t = 0x3FF0000000000000 }
                        px = Float_Add(x0, Float_Mul(t, dx))
                        py = Float_Add(y0, Float_Mul(t, dy))
                        ddx = Float_Sub(wx, px)
                        ddy = Float_Sub(wy, py)
                        d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                        IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                            best = d2
                            hit = 1
                            bk = 2
                            bi = i
                        }
                    }
                    i = Add(i, 1)
                }
            }
        }
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ArraySet(out_ki, 0, bk)
            ArraySet(out_ki, 1, bi)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Pixel-space pick of a sketch line (works in 3D overlay and sketch view).
Function.CA_PickSketchLineAtPx {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        nl = CAD_Sketch.GetLineCount(CadApp.sketch)
        IfCondition LessThan(nl, 1) ThenBlock: { ReturnValue(-1) }
        lines = CAD_Store.Read(CadApp.sketch, 1)
        vframe = Allocate(64)
        CA_BuildViewFrame(vframe)
        skpl = CAD_Sketch.GetPlaneId(CadApp.sketch)
        IfCondition EqualTo(skpl, 0) ThenBlock: { skpl = CadApp.plane }
        pxyz = Allocate(32)
        a = Allocate(32)
        b = Allocate(32)
        best = 144
        hit = -1
        li = 0
        WhileLoop LessThan(li, nl) {
            base = Multiply(li, 4)
            u0 = ArrayGet(lines, base)
            v0 = ArrayGet(lines, Add(base, 1))
            u1 = ArrayGet(lines, Add(base, 2))
            v1 = ArrayGet(lines, Add(base, 3))
            IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
                CA_WorldToPix(u0, v0, a)
                CA_WorldToPix(u1, v1, b)
            }
            IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
                IfCondition NotEqual(skpl, 0) ThenBlock: {
                    CAD_Plane.MapLocal(skpl, u0, v0, 0, pxyz)
                    CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
                    CAD_Plane.MapLocal(skpl, u1, v1, 0, pxyz)
                    CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
                }
                IfCondition EqualTo(skpl, 0) ThenBlock: {
                    CA_World3ToPix(u0, v0, 0, vframe, a)
                    CA_World3ToPix(u1, v1, 0, vframe, b)
                }
            }
            ax = ArrayGet(a, 0)
            ay = ArrayGet(a, 1)
            bx = ArrayGet(b, 0)
            by = ArrayGet(b, 1)
            dx = Subtract(bx, ax)
            dy = Subtract(by, ay)
            aa = Add(Multiply(dx, dx), Multiply(dy, dy))
            IfCondition GreaterThan(aa, 0) ThenBlock: {
                tnum = Add(Multiply(Subtract(px, ax), dx), Multiply(Subtract(py, ay), dy))
                // t in 0..1 as integer ratio — clamp
                IfCondition LessThan(tnum, 0) ThenBlock: { tnum = 0 }
                IfCondition GreaterThan(tnum, aa) ThenBlock: { tnum = aa }
                qx = Add(ax, Divide(Multiply(tnum, dx), aa))
                qy = Add(ay, Divide(Multiply(tnum, dy), aa))
                ddx = Subtract(px, qx)
                ddy = Subtract(py, qy)
                d2 = Add(Multiply(ddx, ddx), Multiply(ddy, ddy))
                IfCondition LessThan(d2, best) ThenBlock: {
                    take = 1
                    IfCondition EqualTo(CA_SolidCoversPx(qx, qy), 1) ThenBlock: { take = 0 }
                    IfCondition EqualTo(take, 1) ThenBlock: {
                        best = d2
                        hit = li
                    }
                }
            }
            li = Add(li, 1)
        }
        Deallocate(pxyz, 32)
        Deallocate(a, 32)
        Deallocate(b, 32)
        Deallocate(vframe, 64)
        ReturnValue(hit)
    }
}

// If hit is whole-line, retarget to nearest endpoint (for FixO / DistO / Coin).


// If hit is whole-line, retarget to nearest endpoint (for FixO / DistO / Coin).
Function.CA_HitAsPoint {
    Input: wx: Integer
    Input: wy: Integer
    Input: kind: Integer
    Input: id: Integer
    Input: out_ki: Address
    Output: Integer
    Body: {
        ArraySet(out_ki, 0, kind)
        ArraySet(out_ki, 1, id)
        IfCondition NotEqual(kind, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        lines = CAD_Store.Read(CadApp.sketch, 1)
        nl = CAD_Sketch.GetLineCount(CadApp.sketch)
        IfCondition GreaterEqual(id, nl) ThenBlock: { ReturnValue(-1) }
        b = Multiply(id, 4)
        x0 = ArrayGet(lines, b)
        y0 = ArrayGet(lines, Add(b, 1))
        x1 = ArrayGet(lines, Add(b, 2))
        y1 = ArrayGet(lines, Add(b, 3))
        d0 = Float_Add(Float_Mul(Float_Sub(wx, x0), Float_Sub(wx, x0)), Float_Mul(Float_Sub(wy, y0), Float_Sub(wy, y0)))
        d1 = Float_Add(Float_Mul(Float_Sub(wx, x1), Float_Sub(wx, x1)), Float_Mul(Float_Sub(wy, y1), Float_Sub(wy, y1)))
        IfCondition EqualTo(Float_Le(d0, d1), 1) ThenBlock: {
            ArraySet(out_ki, 0, 0)
            ArraySet(out_ki, 1, Multiply(id, 2))
        }
        IfCondition EqualTo(Float_Le(d0, d1), 0) ThenBlock: {
            ArraySet(out_ki, 0, 0)
            ArraySet(out_ki, 1, Add(Multiply(id, 2), 1))
        }
        ReturnValue(1)
    }
}

// Enter constraint tool. ctype = constraint type code (1 FixO, 6 DistO, 7 H, …).


// Enter constraint tool. ctype = constraint type code (1 FixO, 6 DistO, 7 H, …).
