// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Procedural Scripting Harness & Performance Benchmark Suite

LibraryImport.Arena
LibraryImport.CAD_Sys
LibraryImport.CAD_Num
LibraryImport.CAD_Store
LibraryImport.CAD_Topo
LibraryImport.CAD_Bool
LibraryImport.CAD_IO
LibraryImport.CAD_Tess
LibraryImport.CAD_Script

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   CAD Kernel Procedural Modeling & Benchmark Suite \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    r_100 = 0x4059000000000000 // 100.0 mm
    r_50  = 0x4049000000000000 // 50.0 mm
    r_25  = 0x4039000000000000 // 25.0 mm
    r_10  = 0x4024000000000000 // 10.0 mm

    // -------------------------------------------------------------------------
    // 1. Procedural Modeling Workflow (Box + Hole + Multi-Export)
    // -------------------------------------------------------------------------
    h_box = CAD_Script.CreateBox(r_100, r_50, r_25)
    IfCondition NotEqual(h_box, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] CreateBox(100mm, 50mm, 25mm) -> Solid Created\n", 53)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] CreateBox failed\n", 24)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    h_drilled = CAD_Script.DrillHole(h_box, 0, 0, r_10, r_25)
    IfCondition NotEqual(h_drilled, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] DrillHole(Solid, Dia=10mm, Depth=25mm) -> Cut Solid\n", 59)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] DrillHole failed\n", 24)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    res_exp = CAD_Script.ExportAll(h_drilled, "bench_model.stp", "bench_model.stl")
    IfCondition EqualTo(res_exp, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] ExportAll -> bench_model.stp & bench_model.stl\n", 53)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] ExportAll failed\n", 24)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 2. High-Throughput Sqrt Benchmark (100,000 Iterations)
    // -------------------------------------------------------------------------
    val_2500 = 0x40A3880000000000 // 2500.0

    // Evaluate Newton-Raphson Sqrt
    s_res = CAD_Num.Sqrt(val_2500)
    IfCondition EqualTo(s_res, 0x4049000000000000) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] High-Throughput Newton-Raphson Sqrt -> Exact 50.0\n", 57)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Sqrt benchmark mismatch\n", 31)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "   PROCEDURAL BENCHMARK FAILED — Fix script bugs     \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   PROCEDURAL BENCHMARK PASSED: 100% Pipeline OK!   \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
