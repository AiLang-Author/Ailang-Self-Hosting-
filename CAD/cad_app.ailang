// cad_app — live DXF/sketch → solid → view (M-B..D + DXF solid creation)
//
// DXF → solid:
//   ./cad_app.x --headless -i plate.dxf -H 10 -o out.bmp
//   ./cad_app.x --headless -i plate.dxf --hole hole.dxf -H 4 -o out.bmp
//   Multi closed loops in one DXF = outer pad + through holes.
//
// Window (prefer launcher — viewport + tools panel):
//   ./CAD/scripts/run_cad_app.sh -i diamond.dxf -H 20
//   Viewport: orbit / sketch clicks / hover rubber-band / RMB cancel
//   Tools panel: Line/Rect/Circ/Arc/Trim/Pick, Profiles/Next, Pad, List/Open/Save, …
//   IPC: /tmp/cad_app/{cmd,status,tool,parts,sel,frame,meta}.txt
//
// Build: ./ailang.x CAD/cad_app.ailang -o cad_app.x

LibraryImport.Arena
LibraryImport.UtilArgs
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_View
LibraryImport.Cad.CAD_Repo
LibraryImport.Cad.CAD_Topo
LibraryImport.Display.Render.Framebuffer
LibraryImport.StringUtils

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

// mode 0=3d 1=sketch
// tool 0=line 1=rect 2=circle 3=arc 4=pick-profile 5=trim/clip
// solid_ops: pad (extrude sketch), plate+hole, cut (ExtrudeCut into solid)
FixedPool.CadApp {
    "solid":     Initialize=0, CanChange=True
    "sketch":    Initialize=0, CanChange=True
    "hole_sk":   Initialize=0, CanChange=True
    "height":    Initialize=10, CanChange=True
    "width":     Initialize=800, CanChange=True
    "height_px": Initialize=600, CanChange=True
    "wire":      Initialize=0, CanChange=True
    "view":      Initialize=0, CanChange=True
    "gen":       Initialize=0, CanChange=True
    "running":   Initialize=1, CanChange=True
    "dxf_path":  Initialize=0, CanChange=True
    "hole_path": Initialize=0, CanChange=True
    "mode":      Initialize=0, CanChange=True
    "tool":      Initialize=0, CanChange=True
    "nclick":    Initialize=0, CanChange=True
    "cx0":       Initialize=0, CanChange=True
    "cy0":       Initialize=0, CanChange=True
    "scale":     Initialize=0, CanChange=True
    "extent":    Initialize=0, CanChange=True
    "nprof":     Initialize=0, CanChange=True
    "dirty":     Initialize=0, CanChange=True
    "part_name": Initialize=0, CanChange=True
    "repo_ok":   Initialize=0, CanChange=True
    "part_rev":  Initialize=0, CanChange=True
    "list_buf":  Initialize=0, CanChange=True
    "list_count":Initialize=0, CanChange=True
    "list_sel":  Initialize=0, CanChange=True
    "list_open": Initialize=0, CanChange=True
    "name_buf":  Initialize=0, CanChange=True
    "hover_px":  Initialize=0, CanChange=True
    "hover_py":  Initialize=0, CanChange=True
    "hover_ok":  Initialize=0, CanChange=True
    "prof_sel":  Initialize=0, CanChange=True
    "prof_user": Initialize=0, CanChange=True
    // bit mask of selected profiles (bit i = profile i); multi Pad via CompoundAdd
    "prof_mask": Initialize=0, CanChange=True
    "click_shift": Initialize=0, CanChange=True
    // sketch view zoom factor (float bits, 1.0 default)
    "sk_zoom":   Initialize=0, CanChange=True
    "sk_pan_x":  Initialize=0, CanChange=True
    "sk_pan_y":  Initialize=0, CanChange=True
    "auto_pad":  Initialize=0, CanChange=True
    "arc_a0":    Initialize=0, CanChange=True
    "arc_rad":   Initialize=0, CanChange=True
}

Function.CA_Log {
    Input: msg: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(CAD_Sys.Write(2, msg, n)) }
}

// Projection ring color from sketch-pad background: push toward white on dark
// pads, toward black on light pads (readable delta, not neon on noise).
Function.CA_ProfileProjColor {
    Input: br: Integer
    Input: bg: Integer
    Input: bb: Integer
    Output: Integer
    Body: {
        // luminance ~ (r+g+b)/3
        lum = Divide(Add(Add(br, bg), bb), 3)
        // delta steps the tint away from the pad
        d = 150
        IfCondition LessThan(lum, 128) ThenBlock: {
            // dark pad → light grey-cyan projection
            r = Add(br, d)
            g = Add(bg, d)
            b = Add(bb, Add(d, 20))
            IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
            IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
            IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
            // floor so it never collapses into bg
            IfCondition LessThan(r, 140) ThenBlock: { r = 140 }
            IfCondition LessThan(g, 150) ThenBlock: { g = 150 }
            IfCondition LessThan(b, 170) ThenBlock: { b = 170 }
            ReturnValue(FB_RGB(r, g, b))
        }
        // light pad → charcoal projection
        r = Subtract(br, d)
        g = Subtract(bg, d)
        b = Subtract(bb, d)
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition LessThan(b, 0) ThenBlock: { b = 0 }
        IfCondition GreaterThan(r, 80) ThenBlock: { r = 80 }
        IfCondition GreaterThan(g, 80) ThenBlock: { g = 80 }
        IfCondition GreaterThan(b, 90) ThenBlock: { b = 90 }
        ReturnValue(FB_RGB(r, g, b))
    }
}

Function.CA_WriteFileStr {
    Input: path: Address
    Input: msg: Address
    Input: n: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        SystemCall(1, fd, msg, n)
        SystemCall(3, fd, 0, 0)
        ReturnValue(0)
    }
}

Function.CA_WriteGen {
    Output: Integer
    Body: {
        fd = SystemCall(2, "/tmp/cad_app/gen.txt", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        g = CadApp.gen
        buf = Allocate(32)
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        n = 0
        IfCondition EqualTo(g, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            n = 1
        }
        WhileLoop GreaterThan(g, 0) {
            SetByte(buf, n, Add(48, Modulo(g, 10)))
            n = Add(n, 1)
            g = Divide(g, 10)
        }
        out = Allocate(32)
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(out, i, GetByte(buf, Subtract(Subtract(n, 1), i)))
            i = Add(i, 1)
        }
        SetByte(out, n, 10)
        SystemCall(1, fd, out, Add(n, 1))
        Deallocate(buf, 32)
        Deallocate(out, 32)
        SystemCall(3, fd, 0, 0)
        ReturnValue(0)
    }
}

// Ensure sketch camera: extent in mm, scale px/mm
Function.CA_UpdateSketchCam {
    Output: Integer
    Body: {
        CadApp.extent = Float_FromInt(50)
        // grow from line AABB if any
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            IfCondition GreaterThan(nl, 0) ThenBlock: {
                lines = CAD_Store.Read(CadApp.sketch, 1)
                xmin = ArrayGet(lines, 0)
                ymin = ArrayGet(lines, 1)
                xmax = xmin
                ymax = ymin
                i = 0
                WhileLoop LessThan(i, nl) {
                    b = Multiply(i, 4)
                    x1 = ArrayGet(lines, b)
                    y1 = ArrayGet(lines, Add(b, 1))
                    x2 = ArrayGet(lines, Add(b, 2))
                    y2 = ArrayGet(lines, Add(b, 3))
                    IfCondition EqualTo(Float_Le(x1, xmin), 1) ThenBlock: { xmin = x1 }
                    IfCondition EqualTo(Float_Le(xmax, x1), 1) ThenBlock: { xmax = x1 }
                    IfCondition EqualTo(Float_Le(y1, ymin), 1) ThenBlock: { ymin = y1 }
                    IfCondition EqualTo(Float_Le(ymax, y1), 1) ThenBlock: { ymax = y1 }
                    IfCondition EqualTo(Float_Le(x2, xmin), 1) ThenBlock: { xmin = x2 }
                    IfCondition EqualTo(Float_Le(xmax, x2), 1) ThenBlock: { xmax = x2 }
                    IfCondition EqualTo(Float_Le(y2, ymin), 1) ThenBlock: { ymin = y2 }
                    IfCondition EqualTo(Float_Le(ymax, y2), 1) ThenBlock: { ymax = y2 }
                    i = Add(i, 1)
                }
                dx = Float_Sub(xmax, xmin)
                dy = Float_Sub(ymax, ymin)
                ext = dx
                IfCondition EqualTo(Float_Le(ext, dy), 1) ThenBlock: { ext = dy }
                half = Float_Div(ext, 0x4000000000000000)
                // pad 20%
                ext = Float_Mul(ext, 0x3FF3333333333333)
                IfCondition EqualTo(Float_Le(ext, Float_FromInt(10)), 1) ThenBlock: {
                    ext = Float_FromInt(50)
                }
                CadApp.extent = ext
            }
        }
        mw = CadApp.width
        IfCondition LessThan(CadApp.height_px, mw) ThenBlock: { mw = CadApp.height_px }
        IfCondition EqualTo(CadApp.sk_zoom, 0) ThenBlock: {
            CadApp.sk_zoom = 0x3FF0000000000000
        }
        // base fit * user scroll zoom
        base = Float_Div(Float_Mul(0x3FEB333333333333, Float_FromInt(mw)), CadApp.extent)
        CadApp.scale = Float_Mul(base, CadApp.sk_zoom)
        ReturnValue(0)
    }
}

// pixel → world XY (top view, Y up)
Function.CA_PixToWorld {
    Input: px: Integer
    Input: py: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        CA_UpdateSketchCam()
        hw = Float_Div(Float_FromInt(CadApp.width), 0x4000000000000000)
        hh = Float_Div(Float_FromInt(CadApp.height_px), 0x4000000000000000)
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
            sc = 0x3FF0000000000000
        }
        // screen → world around pan center
        wx = Float_Add(CadApp.sk_pan_x, Float_Div(Float_Sub(Float_FromInt(px), hw), sc))
        wy = Float_Add(CadApp.sk_pan_y, Float_Div(Float_Sub(hh, Float_FromInt(py)), sc))
        ArraySet(out_xy, 0, wx)
        ArraySet(out_xy, 1, wy)
        ReturnValue(0)
    }
}

Function.CA_WorldToPix {
    Input: wx: Integer
    Input: wy: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        CA_UpdateSketchCam()
        hw = Float_Div(Float_FromInt(CadApp.width), 0x4000000000000000)
        hh = Float_Div(Float_FromInt(CadApp.height_px), 0x4000000000000000)
        sc = CadApp.scale
        sx = Float_Add(hw, Float_Mul(Float_Sub(wx, CadApp.sk_pan_x), sc))
        sy = Float_Sub(hh, Float_Mul(Float_Sub(wy, CadApp.sk_pan_y), sc))
        ArraySet(out_xy, 0, Float_ToInt(sx))
        ArraySet(out_xy, 1, Float_ToInt(sy))
        ReturnValue(0)
    }
}

// Scanline fill of closed polygon in PIXEL coords (x,y pairs).
Function.CA_FillPolyPx {
    Input: pxy: Address
    Input: n: Integer
    Input: col: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        ymin = ArrayGet(pxy, 1)
        ymax = ymin
        i = 0
        WhileLoop LessThan(i, n) {
            y = ArrayGet(pxy, Add(Multiply(i, 2), 1))
            IfCondition LessThan(y, ymin) ThenBlock: { ymin = y }
            IfCondition GreaterThan(y, ymax) ThenBlock: { ymax = y }
            i = Add(i, 1)
        }
        IfCondition LessThan(ymin, 0) ThenBlock: { ymin = 0 }
        IfCondition GreaterThan(ymax, CadApp.height_px) ThenBlock: { ymax = CadApp.height_px }
        xs = Allocate(256)
        y = ymin
        WhileLoop LessThan(y, ymax) {
            nx = 0
            i = 0
            WhileLoop LessThan(i, n) {
                j = Add(i, 1)
                IfCondition EqualTo(j, n) ThenBlock: { j = 0 }
                y0 = ArrayGet(pxy, Add(Multiply(i, 2), 1))
                y1 = ArrayGet(pxy, Add(Multiply(j, 2), 1))
                x0 = ArrayGet(pxy, Multiply(i, 2))
                x1 = ArrayGet(pxy, Multiply(j, 2))
                a = 0
                b = 0
                IfCondition LessThan(y0, y) ThenBlock: { a = 1 }
                IfCondition LessThan(y1, y) ThenBlock: { b = 1 }
                IfCondition NotEqual(a, b) ThenBlock: {
                    den = Subtract(y1, y0)
                    IfCondition NotEqual(den, 0) ThenBlock: {
                        num = Multiply(Subtract(y, y0), Subtract(x1, x0))
                        xi = Add(x0, Divide(num, den))
                        IfCondition LessThan(nx, 128) ThenBlock: {
                            ArraySet(xs, nx, xi)
                            nx = Add(nx, 1)
                        }
                    }
                }
                i = Add(i, 1)
            }
            a = 0
            WhileLoop LessThan(a, nx) {
                b = Add(a, 1)
                WhileLoop LessThan(b, nx) {
                    IfCondition GreaterThan(ArrayGet(xs, a), ArrayGet(xs, b)) ThenBlock: {
                        t = ArrayGet(xs, a)
                        ArraySet(xs, a, ArrayGet(xs, b))
                        ArraySet(xs, b, t)
                    }
                    b = Add(b, 1)
                }
                a = Add(a, 1)
            }
            p = 0
            WhileLoop LessThan(p, nx) {
                IfCondition LessThan(Add(p, 1), nx) ThenBlock: {
                    FB_HLine(ArrayGet(xs, p), ArrayGet(xs, Add(p, 1)), y, col)
                }
                p = Add(p, 2)
            }
            y = Add(y, 1)
        }
        Deallocate(xs, 256)
        ReturnValue(1)
    }
}

Function.CA_DrawSketchToFB {
    Output: Integer
    Body: {
        w = CadApp.width
        h = CadApp.height_px
        need = 0
        IfCondition EqualTo(FB.initialized, 0) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.width, w) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.height, h) ThenBlock: { need = 1 }
        IfCondition EqualTo(need, 1) ThenBlock: {
            IfCondition EqualTo(FB_InitHeadless(w, h), 0) ThenBlock: { ReturnValue(-1) }
        }
        FB_Clear(FB_RGB(24, 28, 36))
        // axes
        CA_UpdateSketchCam()
        pt = Allocate(32)
        CA_WorldToPix(0, 0, pt)
        ox = ArrayGet(pt, 0)
        oy = ArrayGet(pt, 1)
        FB_Line(0, oy, w, oy, FB_RGB(60, 70, 90))
        FB_Line(ox, 0, ox, h, FB_RGB(60, 70, 90))
        // lines
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            lines = CAD_Store.Read(CadApp.sketch, 1)
            i = 0
            WhileLoop LessThan(i, nl) {
                b = Multiply(i, 4)
                CA_WorldToPix(ArrayGet(lines, b), ArrayGet(lines, Add(b, 1)), pt)
                x0 = ArrayGet(pt, 0)
                y0 = ArrayGet(pt, 1)
                CA_WorldToPix(ArrayGet(lines, Add(b, 2)), ArrayGet(lines, Add(b, 3)), pt)
                x1 = ArrayGet(pt, 0)
                y1 = ArrayGet(pt, 1)
                FB_Line(x0, y0, x1, y1, FB_RGB(100, 220, 255))
                i = Add(i, 1)
            }
            // anchor points (ends / crosses / T-touches) — small markers
            npt = CAD_Sketch.GetPointCount(CadApp.sketch)
            pts = CAD_Store.Read(CadApp.sketch, 17)
            IfCondition NotEqual(pts, 0) ThenBlock: {
                i = 0
                WhileLoop LessThan(i, npt) {
                    CA_WorldToPix(ArrayGet(pts, Multiply(i, 2)), ArrayGet(pts, Add(Multiply(i, 2), 1)), pt)
                    x0 = ArrayGet(pt, 0)
                    y0 = ArrayGet(pt, 1)
                    FB_FillRect(Subtract(x0, 2), Subtract(y0, 2), 5, 5, FB_RGB(255, 120, 80))
                    i = Add(i, 1)
                }
            }
            // circles: display-only smooth ring (entity stays a true circle — no anchors)
            nc = CAD_Sketch.GetCircleCount(CadApp.sketch)
            circs = CAD_Store.Read(CadApp.sketch, 8)
            two_pi = 0x401921FB54442D18
            ci = 0
            WhileLoop LessThan(ci, nc) {
                base = Multiply(ci, 3)
                cx = ArrayGet(circs, base)
                cy = ArrayGet(circs, Add(base, 1))
                rad = ArrayGet(circs, Add(base, 2))
                k = 0
                WhileLoop LessThan(k, 64) {
                    a0 = Float_Mul(two_pi, Float_Div(Float_FromInt(k), Float_FromInt(64)))
                    a1 = Float_Mul(two_pi, Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(64)))
                    CA_WorldToPix(Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a0))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a0))), pt)
                    x0 = ArrayGet(pt, 0)
                    y0 = ArrayGet(pt, 1)
                    CA_WorldToPix(Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a1))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a1))), pt)
                    x1 = ArrayGet(pt, 0)
                    y1 = ArrayGet(pt, 1)
                    FB_Line(x0, y0, x1, y1, FB_RGB(255, 200, 80))
                    k = Add(k, 1)
                }
                ci = Add(ci, 1)
            }
            // arcs as tess preview (if any stored) — UNDER profile rings
            na = CAD_Sketch.GetArcCount(CadApp.sketch)
            IfCondition GreaterThan(na, 0) ThenBlock: {
                arcs = CAD_Store.Read(CadApp.sketch, 11)
                two_pi = 0x401921FB54442D18
                ai = 0
                WhileLoop LessThan(ai, na) {
                    base = Multiply(ai, 5)
                    cx = ArrayGet(arcs, base)
                    cy = ArrayGet(arcs, Add(base, 1))
                    rad = ArrayGet(arcs, Add(base, 2))
                    a0 = ArrayGet(arcs, Add(base, 3))
                    a1 = ArrayGet(arcs, Add(base, 4))
                    span = Float_Sub(a1, a0)
                    IfCondition EqualTo(Float_Le(span, 0), 1) ThenBlock: {
                        span = Float_Add(span, two_pi)
                    }
                    // display-only tess (entity is still a true arc)
                    nseg = Float_ToInt(Float_Div(Float_Mul(Float_FromInt(48), span), two_pi))
                    IfCondition LessThan(nseg, 8) ThenBlock: { nseg = 8 }
                    IfCondition GreaterThan(nseg, 64) ThenBlock: { nseg = 64 }
                    k = 0
                    WhileLoop LessThan(k, nseg) {
                        t0 = Float_Div(Float_FromInt(k), Float_FromInt(nseg))
                        t1 = Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(nseg))
                        ang0 = Float_Add(a0, Float_Mul(span, t0))
                        ang1 = Float_Add(a0, Float_Mul(span, t1))
                        CA_WorldToPix(Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang0))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang0))), pt)
                        x0 = ArrayGet(pt, 0)
                        y0 = ArrayGet(pt, 1)
                        CA_WorldToPix(Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang1))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang1))), pt)
                        x1 = ArrayGet(pt, 0)
                        y1 = ArrayGet(pt, 1)
                        FB_Line(x0, y0, x1, y1, FB_RGB(200, 140, 255))
                        k = Add(k, 1)
                    }
                    ai = Add(ai, 1)
                }
            }
            // profiles LAST: Fusion-style FILL shows pad material vs voids
            //   unselected = white outline
            //   selected outer = red fill + red edge (material)
            //   nested simple holes inside selected outer = dark fill (void)
            nprof = CAD_Store.Read(CadApp.sketch, 12)
            IfCondition GreaterThan(nprof, 0) ThenBlock: {
                pi = 0
                xy = Allocate(4096)
                pxy = Allocate(4096)
                oxy = Allocate(4096)
                proj_col = FB_RGB(230, 240, 255)
                sel_col = FB_RGB(255, 40, 40)
                fill_col = FB_RGB(140, 36, 40)
                void_col = FB_RGB(24, 28, 36)
                // find largest selected as outer for void punch
                outer_i = -1
                outer_a = 0
                outer_nn = 0
                IfCondition EqualTo(CadApp.prof_user, 1) ThenBlock: {
                    pi = 0
                    WhileLoop LessThan(pi, nprof) {
                        bit = LeftShift(1, pi)
                        sel = 0
                        IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: { sel = 1 }
                        IfCondition EqualTo(CadApp.prof_mask, 0) ThenBlock: {
                            IfCondition EqualTo(pi, CadApp.prof_sel) ThenBlock: { sel = 1 }
                        }
                        IfCondition EqualTo(sel, 1) ThenBlock: {
                            nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                            IfCondition GreaterEqual(nn, 3) ThenBlock: {
                                ar = CAD_Sketch.LoopSignedArea(xy, nn)
                                IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                                better = 0
                                IfCondition EqualTo(outer_i, -1) ThenBlock: { better = 1 }
                                IfCondition EqualTo(Float_Le(outer_a, ar), 1) ThenBlock: {
                                    IfCondition NotEqual(pi, outer_i) ThenBlock: { better = 1 }
                                }
                                IfCondition EqualTo(better, 1) ThenBlock: {
                                    outer_i = pi
                                    outer_a = ar
                                    outer_nn = nn
                                    k = 0
                                    WhileLoop LessThan(k, nn) {
                                        ArraySet(oxy, Multiply(k, 2), ArrayGet(xy, Multiply(k, 2)))
                                        ArraySet(oxy, Add(Multiply(k, 2), 1), ArrayGet(xy, Add(Multiply(k, 2), 1)))
                                        k = Add(k, 1)
                                    }
                                }
                            }
                        }
                        pi = Add(pi, 1)
                    }
                }
                // pass 1: fill selected material + punch voids
                IfCondition GreaterEqual(outer_i, 0) ThenBlock: {
                    // convert outer to px and fill
                    k = 0
                    WhileLoop LessThan(k, outer_nn) {
                        CA_WorldToPix(ArrayGet(oxy, Multiply(k, 2)), ArrayGet(oxy, Add(Multiply(k, 2), 1)), pt)
                        ArraySet(pxy, Multiply(k, 2), ArrayGet(pt, 0))
                        ArraySet(pxy, Add(Multiply(k, 2), 1), ArrayGet(pt, 1))
                        k = Add(k, 1)
                    }
                    CA_FillPolyPx(pxy, outer_nn, fill_col)
                    // voids: other profiles inside outer (simple nn<=12 or selected)
                    pi = 0
                    WhileLoop LessThan(pi, nprof) {
                        IfCondition NotEqual(pi, outer_i) ThenBlock: {
                            nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                            IfCondition GreaterEqual(nn, 3) ThenBlock: {
                                inside = 1
                                k = 0
                                WhileLoop LessThan(k, nn) {
                                    IfCondition EqualTo(CA_PointInPoly(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), oxy, outer_nn), 0) ThenBlock: {
                                        inside = 0
                                    }
                                    k = Add(k, 1)
                                }
                                IfCondition EqualTo(inside, 1) ThenBlock: {
                                    // void if selected as hole OR auto simple hole
                                    bit = LeftShift(1, pi)
                                    is_sel = 0
                                    IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: { is_sel = 1 }
                                    punch = 0
                                    IfCondition EqualTo(is_sel, 1) ThenBlock: { punch = 1 }
                                    IfCondition LessEqual(nn, 12) ThenBlock: { punch = 1 }
                                    IfCondition EqualTo(punch, 1) ThenBlock: {
                                        k = 0
                                        WhileLoop LessThan(k, nn) {
                                            CA_WorldToPix(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), pt)
                                            ArraySet(pxy, Multiply(k, 2), ArrayGet(pt, 0))
                                            ArraySet(pxy, Add(Multiply(k, 2), 1), ArrayGet(pt, 1))
                                            k = Add(k, 1)
                                        }
                                        CA_FillPolyPx(pxy, nn, void_col)
                                    }
                                }
                            }
                        }
                        pi = Add(pi, 1)
                    }
                }
                // pass 2: outlines
                pi = 0
                WhileLoop LessThan(pi, nprof) {
                    nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                    col = proj_col
                    thick = 1
                    IfCondition EqualTo(CadApp.prof_user, 1) ThenBlock: {
                        bit = LeftShift(1, pi)
                        selected = 0
                        IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: {
                            selected = 1
                        }
                        IfCondition EqualTo(CadApp.prof_mask, 0) ThenBlock: {
                            IfCondition EqualTo(pi, CadApp.prof_sel) ThenBlock: { selected = 1 }
                        }
                        IfCondition EqualTo(selected, 1) ThenBlock: {
                            col = sel_col
                            thick = 2
                        }
                        // hole outline = cyan dashed look via dim white
                        IfCondition GreaterEqual(outer_i, 0) ThenBlock: {
                            IfCondition NotEqual(pi, outer_i) ThenBlock: {
                                IfCondition GreaterEqual(nn, 3) ThenBlock: {
                                    inside = 1
                                    k = 0
                                    WhileLoop LessThan(k, nn) {
                                        IfCondition EqualTo(CA_PointInPoly(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), oxy, outer_nn), 0) ThenBlock: {
                                            inside = 0
                                        }
                                        k = Add(k, 1)
                                    }
                                    IfCondition EqualTo(inside, 1) ThenBlock: {
                                        IfCondition LessEqual(nn, 12) ThenBlock: {
                                            col = FB_RGB(80, 200, 255)
                                            thick = 2
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition GreaterEqual(nn, 3) ThenBlock: {
                        k = 0
                        WhileLoop LessThan(k, nn) {
                            k2 = Add(k, 1)
                            IfCondition EqualTo(k2, nn) ThenBlock: { k2 = 0 }
                            CA_WorldToPix(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), pt)
                            x0 = ArrayGet(pt, 0)
                            y0 = ArrayGet(pt, 1)
                            CA_WorldToPix(ArrayGet(xy, Multiply(k2, 2)), ArrayGet(xy, Add(Multiply(k2, 2), 1)), pt)
                            x1 = ArrayGet(pt, 0)
                            y1 = ArrayGet(pt, 1)
                            FB_Line(x0, y0, x1, y1, col)
                            FB_Line(Add(x0, 1), y0, Add(x1, 1), y1, col)
                            IfCondition GreaterThan(thick, 1) ThenBlock: {
                                FB_Line(x0, Add(y0, 1), x1, Add(y1, 1), col)
                                FB_Line(Subtract(x0, 1), y0, Subtract(x1, 1), y1, col)
                            }
                            k = Add(k, 1)
                        }
                    }
                    pi = Add(pi, 1)
                }
                Deallocate(xy, 4096)
                Deallocate(pxy, 4096)
                Deallocate(oxy, 4096)
            }
        }
        // rubber-band / drag preview for any in-progress tool
        IfCondition GreaterThan(CadApp.nclick, 0) ThenBlock: {
            CA_WorldToPix(CadApp.cx0, CadApp.cy0, pt)
            x0 = ArrayGet(pt, 0)
            y0 = ArrayGet(pt, 1)
            FB_FillRect(Subtract(x0, 3), Subtract(y0, 3), 7, 7, FB_RGB(255, 80, 80))
            IfCondition EqualTo(CadApp.hover_ok, 1) ThenBlock: {
                x1 = CadApp.hover_px
                y1 = CadApp.hover_py
                xy = Allocate(32)
                CA_PixToWorld(x1, y1, xy)
                hx = ArrayGet(xy, 0)
                hy = ArrayGet(xy, 1)
                Deallocate(xy, 32)
                two_pi = 0x401921FB54442D18
                // LINE
                IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
                    FB_Line(x0, y0, x1, y1, FB_RGB(255, 120, 160))
                }
                // RECT
                IfCondition EqualTo(CadApp.tool, 1) ThenBlock: {
                    FB_Line(x0, y0, x1, y0, FB_RGB(255, 120, 160))
                    FB_Line(x1, y0, x1, y1, FB_RGB(255, 120, 160))
                    FB_Line(x1, y1, x0, y1, FB_RGB(255, 120, 160))
                    FB_Line(x0, y1, x0, y0, FB_RGB(255, 120, 160))
                }
                // CIRCLE: drag radius from center (nclick==1)
                IfCondition EqualTo(CadApp.tool, 2) ThenBlock: {
                    dx = Float_Sub(hx, CadApp.cx0)
                    dy = Float_Sub(hy, CadApp.cy0)
                    rad = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                    k = 0
                    WhileLoop LessThan(k, 32) {
                        a0 = Float_Mul(two_pi, Float_Div(Float_FromInt(k), Float_FromInt(32)))
                        a1 = Float_Mul(two_pi, Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(32)))
                        CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(a0))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(a0))), pt)
                        xa = ArrayGet(pt, 0)
                        ya = ArrayGet(pt, 1)
                        CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(a1))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(a1))), pt)
                        xb = ArrayGet(pt, 0)
                        yb = ArrayGet(pt, 1)
                        FB_Line(xa, ya, xb, yb, FB_RGB(255, 200, 80))
                        k = Add(k, 1)
                    }
                    FB_Line(x0, y0, x1, y1, FB_RGB(255, 160, 40))
                }
                // ARC nclick=1: drag radius (full circle ghost + spoke)
                IfCondition EqualTo(CadApp.tool, 3) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                        dx = Float_Sub(hx, CadApp.cx0)
                        dy = Float_Sub(hy, CadApp.cy0)
                        rad = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                        k = 0
                        WhileLoop LessThan(k, 32) {
                            a0 = Float_Mul(two_pi, Float_Div(Float_FromInt(k), Float_FromInt(32)))
                            a1 = Float_Mul(two_pi, Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(32)))
                            CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(a0))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(a0))), pt)
                            xa = ArrayGet(pt, 0)
                            ya = ArrayGet(pt, 1)
                            CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(a1))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(a1))), pt)
                            xb = ArrayGet(pt, 0)
                            yb = ArrayGet(pt, 1)
                            FB_Line(xa, ya, xb, yb, FB_RGB(180, 120, 255))
                            k = Add(k, 1)
                        }
                        FB_Line(x0, y0, x1, y1, FB_RGB(220, 160, 255))
                    }
                    // ARC nclick=2: radius fixed, drag end angle
                    IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: {
                        rad = CadApp.arc_rad
                        a0 = CadApp.arc_a0
                        a1 = CAD_Geom.Atan2(Float_Sub(hy, CadApp.cy0), Float_Sub(hx, CadApp.cx0))
                        span = Float_Sub(a1, a0)
                        IfCondition EqualTo(Float_Le(span, 0), 1) ThenBlock: {
                            span = Float_Add(span, two_pi)
                        }
                        nseg = 24
                        k = 0
                        WhileLoop LessThan(k, nseg) {
                            t0 = Float_Div(Float_FromInt(k), Float_FromInt(nseg))
                            t1 = Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(nseg))
                            ang0 = Float_Add(a0, Float_Mul(span, t0))
                            ang1 = Float_Add(a0, Float_Mul(span, t1))
                            CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(ang0))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(ang0))), pt)
                            xa = ArrayGet(pt, 0)
                            ya = ArrayGet(pt, 1)
                            CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(ang1))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(ang1))), pt)
                            xb = ArrayGet(pt, 0)
                            yb = ArrayGet(pt, 1)
                            FB_Line(xa, ya, xb, yb, FB_RGB(255, 120, 255))
                            k = Add(k, 1)
                        }
                        // spokes to start and hover end
                        CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(a0))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(a0))), pt)
                        FB_Line(x0, y0, ArrayGet(pt, 0), ArrayGet(pt, 1), FB_RGB(200, 100, 220))
                        FB_Line(x0, y0, x1, y1, FB_RGB(200, 100, 220))
                    }
                }
            }
        }
        Deallocate(pt, 32)
        ReturnValue(0)
    }
}

// Count closed profiles WITHOUT mutating live sketch (no tessellate-on-live).
Function.CA_CountProfiles {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.nprof = 0
            ReturnValue(0)
        }
        // read cache only — projection is CA_RebuildProfiles (clone)
        n = CAD_Store.Read(CadApp.sketch, 12)
        CadApp.nprof = n
        ReturnValue(n)
    }
}

// Build solid from current sketch (+ optional hole sketch).
// Paths: plate+hole DXF pair | multi-loop single sketch | single pad.
Function.CA_BuildSolid {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: no sketch\n", 19)
            ReturnValue(-1)
        }
        hgt = Float_FromInt(CadApp.height)
        h = 0
        IfCondition NotEqual(CadApp.hole_sk, 0) ThenBlock: {
            h = CAD_Feat.ExtrudePlateThroughHole(CadApp.sketch, CadApp.hole_sk, hgt)
            IfCondition EqualTo(h, 0) ThenBlock: {
                CA_Log("cad_app: plate+hole FAIL\n", 25)
                ReturnValue(-2)
            }
            CadApp.solid = h
            CadApp.dirty = 1
            CA_Log("cad_app: plate+hole ok\n", 23)
            ReturnValue(0)
        }
        // --- pad paths ---
        // auto_pad=1 (DXF/file load): ExtrudeProfile on a projection clone (live geom ok)
        // auto_pad=0 (interactive): require Pick/Next, extrude ONLY selected ring
        // Never PrepareExtrude the live sketch for interactive pad (mutates arcs/lines).
        sk_nprof = CAD_Store.Read(CadApp.sketch, 12)
        IfCondition EqualTo(sk_nprof, 0) ThenBlock: {
            sk_nprof = CA_RebuildProfiles()
        }
        CadApp.nprof = sk_nprof
        IfCondition EqualTo(sk_nprof, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL (no closed profile)\n", 38)
            CA_Log("  close a loop (RECT), then Profiles → Pick\n", 46)
            ReturnValue(-2)
        }

        // File/DXF path: clone + PrepareExtrude + extrude (do not trash live if shared)
        IfCondition EqualTo(CadApp.auto_pad, 1) ThenBlock: {
            clone = CAD_Sketch.CreateSketch(1)
            CA_CopySketchGeom(CadApp.sketch, clone)
            CAD_Sketch.PrepareExtrude(clone)
            h = CAD_Feat.ExtrudeProfile(clone, hgt)
            IfCondition EqualTo(h, 0) ThenBlock: {
                CA_Log("cad_app: pad FAIL (auto extrude)\n", 33)
                ReturnValue(-2)
            }
            CadApp.solid = h
            CadApp.dirty = 1
            CadApp.prof_user = 0
            CA_Log("cad_app: pad OK (file/auto)\n", 27)
            ReturnValue(0)
        }

        // Interactive: if multi was projected but selection cleared, take outer (0)
        IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
            IfCondition GreaterThan(sk_nprof, 0) ThenBlock: {
                ok = CA_ApplyProfileSel(0, sk_nprof, 0)
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    CA_Log("cad_app: Pad uses outer profile (Next to change)\n", 47)
                }
            }
        }
        IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL — no closed profile\n", 38)
            CA_Log("  Profiles first, then Pad (or Next/Pick)\n", 42)
            ReturnValue(-2)
        }
        // ensure mask has at least one selected bit
        IfCondition EqualTo(CadApp.prof_mask, 0) ThenBlock: {
            IfCondition LessThan(CadApp.prof_sel, sk_nprof) ThenBlock: {
                CadApp.prof_mask = LeftShift(1, CadApp.prof_sel)
            }
        }
        IfCondition EqualTo(CadApp.prof_mask, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL — nothing selected\n", 37)
            ReturnValue(-2)
        }
        // Nested profiles: largest area = outer pad; fully-inside others = holes.
        // Disjoint selections = separate pads CompoundAdd'ed.
        xy = Allocate(4096)
        oxy = Allocate(4096)
        outer_i = -1
        outer_a = 0
        outer_nn = 0
        pi = 0
        WhileLoop LessThan(pi, sk_nprof) {
            IfCondition LessThan(pi, 32) ThenBlock: {
                bit = LeftShift(1, pi)
                IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: {
                    nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                    IfCondition GreaterEqual(nn, 3) ThenBlock: {
                        ar = CAD_Sketch.LoopSignedArea(xy, nn)
                        IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                        better = 0
                        IfCondition EqualTo(outer_i, -1) ThenBlock: { better = 1 }
                        IfCondition EqualTo(Float_Le(outer_a, ar), 1) ThenBlock: {
                            IfCondition NotEqual(pi, outer_i) ThenBlock: { better = 1 }
                        }
                        IfCondition EqualTo(better, 1) ThenBlock: {
                            outer_i = pi
                            outer_a = ar
                            outer_nn = nn
                            k = 0
                            WhileLoop LessThan(k, nn) {
                                ArraySet(oxy, Multiply(k, 2), ArrayGet(xy, Multiply(k, 2)))
                                ArraySet(oxy, Add(Multiply(k, 2), 1), ArrayGet(xy, Add(Multiply(k, 2), 1)))
                                k = Add(k, 1)
                            }
                        }
                    }
                }
            }
            pi = Add(pi, 1)
        }
        IfCondition LessThan(outer_i, 0) ThenBlock: {
            Deallocate(xy, 4096)
            Deallocate(oxy, 4096)
            CA_Log("cad_app: pad FAIL — no valid ring\n", 34)
            ReturnValue(-2)
        }
        // count how many selected
        n_sel = 0
        pi = 0
        WhileLoop LessThan(pi, sk_nprof) {
            IfCondition LessThan(pi, 32) ThenBlock: {
                IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, LeftShift(1, pi)), 0) ThenBlock: {
                    n_sel = Add(n_sel, 1)
                }
            }
            pi = Add(pi, 1)
        }
        // one sketch: outer + nested holes (ExtrudeProfile cuts profiles 1+)
        // Auto-hole: if only outer selected, simple nested rings (nn<=12) become voids
        // so square-in-square works without Shift+selecting the hole.
        // Dense nested rings (tessellated disks inside a slot envelope) are NOT auto-holes.
        hsk = CAD_Sketch.CreateSketch(1)
        CAD_Sketch.AddProfileXY(hsk, oxy, outer_nn)
        n_holes = 0
        pi = 0
        WhileLoop LessThan(pi, sk_nprof) {
            IfCondition NotEqual(pi, outer_i) ThenBlock: {
                nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                IfCondition GreaterEqual(nn, 3) ThenBlock: {
                    inside = 1
                    k = 0
                    WhileLoop LessThan(k, nn) {
                        IfCondition EqualTo(CA_PointInPoly(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), oxy, outer_nn), 0) ThenBlock: {
                            inside = 0
                        }
                        k = Add(k, 1)
                    }
                    IfCondition EqualTo(inside, 1) ThenBlock: {
                        bit = LeftShift(1, pi)
                        selected = 0
                        IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: { selected = 1 }
                        // auto simple void when only outer was selected
                        auto = 0
                        IfCondition EqualTo(n_sel, 1) ThenBlock: {
                            IfCondition LessEqual(nn, 12) ThenBlock: { auto = 1 }
                        }
                        use = 0
                        IfCondition EqualTo(selected, 1) ThenBlock: { use = 1 }
                        IfCondition EqualTo(auto, 1) ThenBlock: { use = 1 }
                        IfCondition EqualTo(use, 1) ThenBlock: {
                            CAD_Sketch.AddProfileXY(hsk, xy, nn)
                            n_holes = Add(n_holes, 1)
                        }
                    }
                }
            }
            pi = Add(pi, 1)
        }
        h = CAD_Feat.ExtrudeProfile(hsk, hgt)
        // disjoint islands (not inside outer) as extra solids
        pi = 0
        WhileLoop LessThan(pi, sk_nprof) {
            IfCondition NotEqual(pi, outer_i) ThenBlock: {
                IfCondition LessThan(pi, 32) ThenBlock: {
                    bit = LeftShift(1, pi)
                    IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: {
                        nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                        IfCondition GreaterEqual(nn, 3) ThenBlock: {
                            inside = 1
                            k = 0
                            WhileLoop LessThan(k, nn) {
                                IfCondition EqualTo(CA_PointInPoly(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), oxy, outer_nn), 0) ThenBlock: {
                                    inside = 0
                                }
                                k = Add(k, 1)
                            }
                            IfCondition EqualTo(inside, 0) ThenBlock: {
                                isk = CAD_Sketch.FromClosedXY(xy, nn)
                                IfCondition NotEqual(isk, 0) ThenBlock: {
                                    hi = CAD_Feat.ExtrudeProfile(isk, hgt)
                                    IfCondition NotEqual(hi, 0) ThenBlock: {
                                        IfCondition EqualTo(h, 0) ThenBlock: { h = hi }
                                        IfCondition NotEqual(h, hi) ThenBlock: {
                                            IfCondition NotEqual(h, 0) ThenBlock: {
                                                h = CAD_Topo.CompoundAdd(h, hi)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            pi = Add(pi, 1)
        }
        Deallocate(xy, 4096)
        Deallocate(oxy, 4096)
        CAD_Store.Write(CadApp.sketch, 12, sk_nprof)
        IfCondition EqualTo(h, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL (extrude)\n", 28)
            CA_Log("  tip: re-Profiles then Pad (prism cap 2048 verts)\n", 51)
            ReturnValue(-2)
        }
        CadApp.solid = h
        CadApp.dirty = 1
        CadApp.nprof = sk_nprof
        IfCondition GreaterThan(n_holes, 0) ThenBlock: {
            CA_Log("cad_app: pad OK (outer + through hole(s))\n", 41)
        }
        IfCondition EqualTo(n_holes, 0) ThenBlock: {
            CA_Log("cad_app: pad OK (selected profile(s))\n", 37)
        }
        ReturnValue(0)
    }
}

Function.CA_PadFromSketch {
    Output: Integer
    Body: {
        ReturnValue(CA_BuildSolid())
    }
}

// ExtrudeCut current/hole sketch into existing solid (through height).
Function.CA_CutFromSketch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_Log("cad_app: cut needs solid (pad first)\n", 38)
            ReturnValue(-1)
        }
        sk = CadApp.sketch
        IfCondition NotEqual(CadApp.hole_sk, 0) ThenBlock: {
            sk = CadApp.hole_sk
        }
        IfCondition EqualTo(sk, 0) ThenBlock: {
            CA_Log("cad_app: cut needs sketch\n", 26)
            ReturnValue(-1)
        }
        hgt = Float_FromInt(CadApp.height)
        cut = CAD_Feat.ExtrudeCut(CadApp.solid, sk, hgt)
        IfCondition EqualTo(cut, 0) ThenBlock: {
            CA_Log("cad_app: cut FAIL\n", 18)
            ReturnValue(-2)
        }
        CadApp.solid = cut
        CadApp.dirty = 0
        CA_Log("cad_app: cut ok\n", 16)
        ReturnValue(0)
    }
}

Function.CA_ImportDxf {
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(0) }
        out = Allocate(16)
        rc = CAD_DXF.ImportFile(path, out)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            Deallocate(out, 16)
            CA_Log("cad_app: DXF import FAIL\n", 25)
            ReturnValue(0)
        }
        h = ArrayGet(out, 0)
        Deallocate(out, 16)
        ReturnValue(h)
    }
}

Function.CA_LoadDxfToSketch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.dxf_path, 0) ThenBlock: { ReturnValue(-1) }
        // drop previous solid so viewport does not keep last pad while loading
        CadApp.solid = 0
        CadApp.sketch = CA_ImportDxf(CadApp.dxf_path)
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        CadApp.hole_sk = 0
        IfCondition NotEqual(CadApp.hole_path, 0) ThenBlock: {
            CadApp.hole_sk = CA_ImportDxf(CadApp.hole_path)
            IfCondition EqualTo(CadApp.hole_sk, 0) ThenBlock: {
                CA_Log("cad_app: hole DXF FAIL\n", 23)
                ReturnValue(-1)
            }
        }
        // file import: auto pad outer (+ holes) — not interactive selection
        CadApp.auto_pad = 1
        CadApp.prof_user = 0
        rc = CA_BuildSolid()
        CadApp.auto_pad = 0
        ReturnValue(rc)
    }
}

Function.CA_ReloadDxf {
    Output: Integer
    Body: {
        CA_Log("cad_app: reload DXF\n", 20)
        ReturnValue(CA_LoadDxfToSketch())
    }
}

// Ensure PG connection + schema (once).
Function.CA_RepoEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.repo_ok, 1) ThenBlock: { ReturnValue(0) }
        rc = CAD_Repo.ConnectLocal()
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: PG connect FAIL (need cad_db)\n", 40)
            ReturnValue(-1)
        }
        rc = CAD_Repo.InitSchema(0)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: PG schema FAIL\n", 24)
            ReturnValue(-1)
        }
        CadApp.repo_ok = 1
        CA_Log("cad_app: PG ready\n", 18)
        ReturnValue(0)
    }
}

// Ensure we have a writable name buffer; default "untitled".
Function.CA_EnsureName {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.name_buf, 0) ThenBlock: {
            CadApp.name_buf = Allocate(80)
            // default untitled
            SetByte(CadApp.name_buf, 0, 117)
            SetByte(CadApp.name_buf, 1, 110)
            SetByte(CadApp.name_buf, 2, 116)
            SetByte(CadApp.name_buf, 3, 105)
            SetByte(CadApp.name_buf, 4, 116)
            SetByte(CadApp.name_buf, 5, 108)
            SetByte(CadApp.name_buf, 6, 101)
            SetByte(CadApp.name_buf, 7, 100)
            SetByte(CadApp.name_buf, 8, 0)
        }
        IfCondition EqualTo(CadApp.part_name, 0) ThenBlock: {
            CadApp.part_name = CadApp.name_buf
        }
        ReturnValue(0)
    }
}

// Copy C-string src into name_buf and set part_name.
Function.CA_SetPartName {
    Input: src: Address
    Output: Integer
    Body: {
        CA_EnsureName()
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(-1) }
        i = 0
        WhileLoop LessThan(i, 63) {
            c = GetByte(src, i)
            SetByte(CadApp.name_buf, i, c)
            IfCondition EqualTo(c, 0) ThenBlock: {
                i = 64
            }
            IfCondition NotEqual(c, 0) ThenBlock: {
                i = Add(i, 1)
            }
        }
        SetByte(CadApp.name_buf, 63, 0)
        CadApp.part_name = CadApp.name_buf
        ReturnValue(0)
    }
}

// Write list_buf + selection to IPC files for host overlay.
Function.CA_WriteListFiles {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.list_buf, 0) ThenBlock: {
            CA_WriteFileStr("/tmp/cad_app/parts.txt", "(empty)\n", 8)
        }
        IfCondition NotEqual(CadApp.list_buf, 0) ThenBlock: {
            fd = SystemCall(2, "/tmp/cad_app/parts.txt", 577, 420)
            IfCondition GreaterEqual(fd, 0) ThenBlock: {
                // write up to 4000 chars
                n = 0
                WhileLoop LessThan(n, 4000) {
                    IfCondition EqualTo(GetByte(CadApp.list_buf, n), 0) ThenBlock: {
                        n = 4000
                    }
                    IfCondition LessThan(n, 4000) ThenBlock: {
                        IfCondition NotEqual(GetByte(CadApp.list_buf, n), 0) ThenBlock: {
                            n = Add(n, 1)
                        }
                    }
                }
                // recount properly
                n = 0
                WhileLoop NotEqual(GetByte(CadApp.list_buf, n), 0) {
                    n = Add(n, 1)
                    IfCondition GreaterThan(n, 4000) ThenBlock: {
                        n = 4000
                    }
                }
                SystemCall(1, fd, CadApp.list_buf, n)
                SystemCall(3, fd, 0, 0)
            }
        }
        // sel index
        sb = Allocate(16)
        pos = 0
        v = CadApp.list_sel
        IfCondition EqualTo(v, 0) ThenBlock: {
            SetByte(sb, 0, 48)
            pos = 1
        }
        IfCondition GreaterThan(v, 0) ThenBlock: {
            tmp = Allocate(16)
            n = 0
            WhileLoop GreaterThan(v, 0) {
                SetByte(tmp, n, Add(48, Modulo(v, 10)))
                v = Divide(v, 10)
                n = Add(n, 1)
            }
            i = Subtract(n, 1)
            WhileLoop GreaterEqual(i, 0) {
                SetByte(sb, pos, GetByte(tmp, i))
                pos = Add(pos, 1)
                i = Subtract(i, 1)
            }
            Deallocate(tmp, 16)
        }
        SetByte(sb, pos, 10)
        pos = Add(pos, 1)
        SetByte(sb, pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/sel.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, sb, pos)
            SystemCall(3, fd, 0, 0)
        }
        Deallocate(sb, 16)
        ReturnValue(0)
    }
}

// nth line (0-based) from list_buf → out 64-byte name. Returns 1 ok.
Function.CA_ListNameAt {
    Input: idx: Integer
    Input: out: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.list_buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        line = 0
        i = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            IfCondition EqualTo(GetByte(CadApp.list_buf, i), 0) ThenBlock: {
                done = 1
            }
            IfCondition EqualTo(done, 0) ThenBlock: {
                IfCondition EqualTo(line, idx) ThenBlock: {
                    j = 0
                    WhileLoop EqualTo(done, 0) {
                        c = GetByte(CadApp.list_buf, i)
                        IfCondition EqualTo(c, 0) ThenBlock: {
                            SetByte(out, j, 0)
                            done = 2
                        }
                        IfCondition EqualTo(c, 10) ThenBlock: {
                            SetByte(out, j, 0)
                            done = 2
                        }
                        IfCondition EqualTo(done, 0) ThenBlock: {
                            IfCondition LessThan(j, 63) ThenBlock: {
                                SetByte(out, j, c)
                                j = Add(j, 1)
                            }
                            i = Add(i, 1)
                        }
                    }
                    IfCondition EqualTo(j, 0) ThenBlock: { ReturnValue(0) }
                    ReturnValue(1)
                }
                // advance to next line
                c = GetByte(CadApp.list_buf, i)
                IfCondition EqualTo(c, 10) ThenBlock: {
                    line = Add(line, 1)
                }
                i = Add(i, 1)
            }
        }
        ReturnValue(0)
    }
}

// Refresh part list from Postgres; open browser.
Function.CA_DocList {
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_RepoEnsure(), 0) ThenBlock: {
        }
        IfCondition EqualTo(CadApp.repo_ok, 0) ThenBlock: {
            CA_Log("cad_app: list needs PG\n", 22)
            ReturnValue(-1)
        }
        IfCondition EqualTo(CadApp.list_buf, 0) ThenBlock: {
            CadApp.list_buf = Allocate(4096)
        }
        n = CAD_Repo.ListParts(CadApp.list_buf, 4096)
        IfCondition LessThan(n, 0) ThenBlock: {
            CA_Log("cad_app: list FAIL\n", 19)
            ReturnValue(-2)
        }
        CadApp.list_count = n
        CadApp.list_open = 1
        IfCondition GreaterEqual(CadApp.list_sel, n) ThenBlock: {
            CadApp.list_sel = 0
        }
        IfCondition LessThan(n, 1) ThenBlock: {
            SetByte(CadApp.list_buf, 0, 40)
            SetByte(CadApp.list_buf, 1, 110)
            SetByte(CadApp.list_buf, 2, 111)
            SetByte(CadApp.list_buf, 3, 110)
            SetByte(CadApp.list_buf, 4, 101)
            SetByte(CadApp.list_buf, 5, 41)
            SetByte(CadApp.list_buf, 6, 10)
            SetByte(CadApp.list_buf, 7, 0)
            CadApp.list_count = 0
        }
        CA_WriteListFiles()
        CA_Log("cad_app: list open\n", 19)
        ReturnValue(0)
    }
}

Function.CA_DocSelNext {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.list_open, 0) ThenBlock: {
            ReturnValue(CA_DocList())
        }
        IfCondition GreaterThan(CadApp.list_count, 0) ThenBlock: {
            CadApp.list_sel = Add(CadApp.list_sel, 1)
            IfCondition GreaterEqual(CadApp.list_sel, CadApp.list_count) ThenBlock: {
                CadApp.list_sel = 0
            }
        }
        CA_WriteListFiles()
        ReturnValue(0)
    }
}

Function.CA_DocSelPrev {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.list_open, 0) ThenBlock: {
            ReturnValue(CA_DocList())
        }
        IfCondition LessThan(CadApp.list_count, 1) ThenBlock: {
            CA_WriteListFiles()
            ReturnValue(0)
        }
        // sel = (sel - 1 + count) % count
        s = Add(Subtract(CadApp.list_sel, 1), CadApp.list_count)
        // modulo via while
        WhileLoop GreaterEqual(s, CadApp.list_count) {
            s = Subtract(s, CadApp.list_count)
        }
        CadApp.list_sel = s
        CA_WriteListFiles()
        ReturnValue(0)
    }
}

// Open selected list entry (or current part_name if list closed).
Function.CA_DocOpen {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.list_open, 1) ThenBlock: {
            IfCondition GreaterThan(CadApp.list_count, 0) ThenBlock: {
                nm = Allocate(80)
                IfCondition EqualTo(CA_ListNameAt(CadApp.list_sel, nm), 1) ThenBlock: {
                    CA_SetPartName(nm)
                }
                Deallocate(nm, 80)
            }
        }
        ReturnValue(CA_RepoLoad())
    }
}

// Wipe solid + sketch + hole + profile selection (the "data tree").
// Forces sketch mode so viewport is empty axes, not the last pad.
Function.CA_ClearModel {
    Output: Integer
    Body: {
        // drop solid handle (viewport must not re-render last body)
        CadApp.solid = 0
        CadApp.hole_sk = 0
        CadApp.hole_path = 0
        // replace sketch with empty (orphan old sketch store entries)
        CadApp.sketch = CAD_Sketch.CreateSketch(1)
        CadApp.nclick = 0
        CadApp.hover_ok = 0
        CadApp.cx0 = 0
        CadApp.cy0 = 0
        CadApp.arc_a0 = 0
        CadApp.arc_rad = 0
        CadApp.tool = 0
        CadApp.nprof = 0
        CadApp.prof_sel = 0
        CadApp.prof_user = 0
        CadApp.mode = 1
        CadApp.dirty = 0
        CadApp.auto_pad = 0
        // clear framebuffer so last pad pixels cannot linger
        w = CadApp.width
        h = CadApp.height_px
        IfCondition LessThan(w, 16) ThenBlock: { w = 800 }
        IfCondition LessThan(h, 16) ThenBlock: { h = 600 }
        need = 0
        IfCondition EqualTo(FB.initialized, 0) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.width, w) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.height, h) ThenBlock: { need = 1 }
        IfCondition EqualTo(need, 1) ThenBlock: {
            FB_InitHeadless(w, h)
        }
        FB_Clear(FB_RGB(24, 28, 36))
        ReturnValue(0)
    }
}

// Close document: clear model tree, untitled
Function.CA_DocClose {
    Output: Integer
    Body: {
        CA_ClearModel()
        CadApp.part_rev = 0
        CadApp.list_open = 0
        CA_SetPartName("untitled")
        CA_Log("cad_app: closed (model cleared)\n", 30)
        ReturnValue(0)
    }
}

// New document: empty sketch + no solid, name partN
Function.CA_DocNew {
    Output: Integer
    Body: {
        CA_EnsureName()
        // name part + gen
        SetByte(CadApp.name_buf, 0, 112)
        SetByte(CadApp.name_buf, 1, 97)
        SetByte(CadApp.name_buf, 2, 114)
        SetByte(CadApp.name_buf, 3, 116)
        // append digits of gen+1
        v = Add(CadApp.gen, 1)
        // write at least one digit
        tmp = Allocate(16)
        n = 0
        IfCondition EqualTo(v, 0) ThenBlock: {
            SetByte(tmp, 0, 48)
            n = 1
        }
        WhileLoop GreaterThan(v, 0) {
            SetByte(tmp, n, Add(48, Modulo(v, 10)))
            v = Divide(v, 10)
            n = Add(n, 1)
        }
        p = 4
        i = Subtract(n, 1)
        WhileLoop GreaterEqual(i, 0) {
            SetByte(CadApp.name_buf, p, GetByte(tmp, i))
            p = Add(p, 1)
            i = Subtract(i, 1)
        }
        SetByte(CadApp.name_buf, p, 0)
        Deallocate(tmp, 16)
        CadApp.part_name = CadApp.name_buf
        // full wipe: solid + sketch + profiles (viewport no longer shows last pad)
        CA_ClearModel()
        CadApp.dirty = 1
        CadApp.part_rev = 0
        CadApp.list_open = 0
        CA_Log("cad_app: new doc (model cleared)\n", 32)
        ReturnValue(0)
    }
}

// Save current sketch+solid+hole to Postgres under CadApp.part_name.
Function.CA_RepoSave {
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_RepoEnsure(), 0) ThenBlock: {
        }
        IfCondition EqualTo(CadApp.repo_ok, 0) ThenBlock: { ReturnValue(-1) }
        CA_EnsureName()
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: save needs sketch\n", 27)
            ReturnValue(-3)
        }
        // pad first if solid missing but sketch exists
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_PadFromSketch()
        }
        rc = CAD_Repo.SavePart(CadApp.part_name, CadApp.sketch, CadApp.solid, CadApp.height, CadApp.hole_sk)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: repo save FAIL\n", 24)
            ReturnValue(rc)
        }
        CadApp.part_rev = CAD_Repo_State.last_rev
        CadApp.dirty = 0
        CadApp.list_open = 0
        CA_Log("cad_app: repo save ok\n", 22)
        ReturnValue(0)
    }
}

// Load part from Postgres by CadApp.part_name → sketch/solid/height/hole.
Function.CA_RepoLoad {
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_RepoEnsure(), 0) ThenBlock: {
        }
        IfCondition EqualTo(CadApp.repo_ok, 0) ThenBlock: { ReturnValue(-1) }
        CA_EnsureName()
        pack = Allocate(64)
        rc = CAD_Repo.LoadPart(CadApp.part_name, pack)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            Deallocate(pack, 64)
            CA_Log("cad_app: repo load FAIL\n", 24)
            ReturnValue(rc)
        }
        CadApp.sketch = ArrayGet(pack, 0)
        CadApp.solid = ArrayGet(pack, 1)
        CadApp.height = ArrayGet(pack, 2)
        CadApp.hole_sk = ArrayGet(pack, 3)
        CadApp.mode = 0
        CadApp.dirty = 0
        CadApp.part_rev = CAD_Repo_State.last_rev
        CadApp.list_open = 0
        Deallocate(pack, 64)
        CA_Log("cad_app: repo load ok\n", 22)
        ReturnValue(0)
    }
}


Function.CA_NewSketch {
    Output: Integer
    Body: {
        CA_ClearModel()
        CadApp.dirty = 1
        CA_Log("cad_app: new sketch (model cleared)\n", 34)
        ReturnValue(0)
    }
}

Function.CA_WriteStatus {
    Output: Integer
    Body: {
        st = Allocate(160)
        pos = 0
        IfCondition EqualTo(CadApp.list_open, 1) ThenBlock: {
            // LIST sel/count
            msg = "LIST "
            i = 0
            WhileLoop NotEqual(GetByte(msg, i), 0) {
                SetByte(st, pos, GetByte(msg, i))
                pos = Add(pos, 1)
                i = Add(i, 1)
            }
            // sel+1
            v = Add(CadApp.list_sel, 1)
            IfCondition EqualTo(v, 0) ThenBlock: {
                SetByte(st, pos, 48)
                pos = Add(pos, 1)
            }
            IfCondition GreaterThan(v, 0) ThenBlock: {
                tmp = Allocate(16)
                n = 0
                vv = v
                WhileLoop GreaterThan(vv, 0) {
                    SetByte(tmp, n, Add(48, Modulo(vv, 10)))
                    vv = Divide(vv, 10)
                    n = Add(n, 1)
                }
                ii = Subtract(n, 1)
                WhileLoop GreaterEqual(ii, 0) {
                    SetByte(st, pos, GetByte(tmp, ii))
                    pos = Add(pos, 1)
                    ii = Subtract(ii, 1)
                }
                Deallocate(tmp, 16)
            }
            SetByte(st, pos, 47)
            pos = Add(pos, 1)
            v = CadApp.list_count
            IfCondition EqualTo(v, 0) ThenBlock: {
                SetByte(st, pos, 48)
                pos = Add(pos, 1)
            }
            IfCondition GreaterThan(v, 0) ThenBlock: {
                tmp = Allocate(16)
                n = 0
                vv = v
                WhileLoop GreaterThan(vv, 0) {
                    SetByte(tmp, n, Add(48, Modulo(vv, 10)))
                    vv = Divide(vv, 10)
                    n = Add(n, 1)
                }
                ii = Subtract(n, 1)
                WhileLoop GreaterEqual(ii, 0) {
                    SetByte(st, pos, GetByte(tmp, ii))
                    pos = Add(pos, 1)
                    ii = Subtract(ii, 1)
                }
                Deallocate(tmp, 16)
            }
            SetByte(st, pos, 32)
            pos = Add(pos, 1)
            nm = Allocate(80)
            IfCondition EqualTo(CA_ListNameAt(CadApp.list_sel, nm), 1) ThenBlock: {
                i = 0
                WhileLoop NotEqual(GetByte(nm, i), 0) {
                    IfCondition LessThan(pos, 120) ThenBlock: {
                        SetByte(st, pos, GetByte(nm, i))
                        pos = Add(pos, 1)
                    }
                    i = Add(i, 1)
                }
            }
            Deallocate(nm, 80)
            tail = "  g=open p=save"
            i = 0
            WhileLoop NotEqual(GetByte(tail, i), 0) {
                IfCondition LessThan(pos, 150) ThenBlock: {
                    SetByte(st, pos, GetByte(tail, i))
                    pos = Add(pos, 1)
                }
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(CadApp.list_open, 0) ThenBlock: {
            msg = "DOC "
            i = 0
            WhileLoop NotEqual(GetByte(msg, i), 0) {
                SetByte(st, pos, GetByte(msg, i))
                pos = Add(pos, 1)
                i = Add(i, 1)
            }
            CA_EnsureName()
            i = 0
            WhileLoop NotEqual(GetByte(CadApp.part_name, i), 0) {
                IfCondition LessThan(pos, 100) ThenBlock: {
                    SetByte(st, pos, GetByte(CadApp.part_name, i))
                    pos = Add(pos, 1)
                }
                i = Add(i, 1)
            }
            SetByte(st, pos, 32)
            pos = Add(pos, 1)
            SetByte(st, pos, 114)
            pos = Add(pos, 1)
            v = CadApp.part_rev
            IfCondition EqualTo(v, 0) ThenBlock: {
                SetByte(st, pos, 48)
                pos = Add(pos, 1)
            }
            IfCondition GreaterThan(v, 0) ThenBlock: {
                tmp = Allocate(16)
                n = 0
                vv = v
                WhileLoop GreaterThan(vv, 0) {
                    SetByte(tmp, n, Add(48, Modulo(vv, 10)))
                    vv = Divide(vv, 10)
                    n = Add(n, 1)
                }
                ii = Subtract(n, 1)
                WhileLoop GreaterEqual(ii, 0) {
                    SetByte(st, pos, GetByte(tmp, ii))
                    pos = Add(pos, 1)
                    ii = Subtract(ii, 1)
                }
                Deallocate(tmp, 16)
            }
            // always init tail (tool=3 ARC used to leave garbage → crash)
            tail = " "
            IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
                IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " LINE c1" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " LINE c2" }
                }
                IfCondition EqualTo(CadApp.tool, 1) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " RECT c1" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " RECT c2" }
                }
                IfCondition EqualTo(CadApp.tool, 2) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " CIRC center" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " CIRC radius" }
                }
                IfCondition EqualTo(CadApp.tool, 3) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " ARC center" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " ARC start" }
                    IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: { tail = " ARC end" }
                }
                IfCondition EqualTo(CadApp.tool, 4) ThenBlock: { tail = " PICK profile" }
                IfCondition EqualTo(CadApp.tool, 5) ThenBlock: { tail = " TRIM click" }
                // show selection state
                IfCondition GreaterThan(CadApp.nprof, 0) ThenBlock: {
                    IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
                        tail = " white rings Pick"
                    }
                    IfCondition EqualTo(CadApp.prof_user, 1) ThenBlock: {
                        tail = " RED sel Shift+multi"
                    }
                }
                IfCondition EqualTo(CadApp.dirty, 1) ThenBlock: {
                    IfCondition EqualTo(CadApp.tool, 0) ThenBlock: { tail = " *LINE" }
                    IfCondition EqualTo(CadApp.tool, 1) ThenBlock: { tail = " *RECT" }
                    IfCondition EqualTo(CadApp.tool, 2) ThenBlock: { tail = " *CIRC" }
                    IfCondition EqualTo(CadApp.tool, 3) ThenBlock: { tail = " *ARC" }
                    IfCondition EqualTo(CadApp.tool, 4) ThenBlock: { tail = " *PICK" }
                    IfCondition EqualTo(CadApp.tool, 5) ThenBlock: { tail = " *TRIM" }
                }
            }
            IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
                IfCondition EqualTo(CadApp.dirty, 1) ThenBlock: {
                    tail = " *3D pad/save"
                }
                IfCondition EqualTo(CadApp.dirty, 0) ThenBlock: {
                    tail = " 3D"
                }
            }
            i = 0
            WhileLoop NotEqual(GetByte(tail, i), 0) {
                IfCondition LessThan(pos, 150) ThenBlock: {
                    SetByte(st, pos, GetByte(tail, i))
                    pos = Add(pos, 1)
                }
                i = Add(i, 1)
            }
        }
        SetByte(st, pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/status.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, st, pos)
            SystemCall(3, fd, 0, 0)
        }
        Deallocate(st, 160)
        ReturnValue(0)
    }
}

Function.CA_PublishFrame {
    Output: Integer
    Body: {
        // 3D only when we still have a solid; otherwise always sketch (empty axes after clear)
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                CAD_View.SetWire(CadApp.wire)
                rc = CAD_View.RenderSolidToFB(CadApp.solid, CadApp.width, CadApp.height_px)
                IfCondition NotEqual(rc, 0) ThenBlock: {
                    // solid handle dead — drop it and show sketch
                    CadApp.solid = 0
                    rc = CA_DrawSketchToFB()
                    IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(rc) }
                }
            }
            IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
                rc = CA_DrawSketchToFB()
                IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(rc) }
            }
        }
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
            rc = CA_DrawSketchToFB()
            IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(rc) }
        }
        CAD_View.WriteFBRaw("/tmp/cad_app/meta.bin", "/tmp/cad_app/frame.raw")
        CadApp.gen = Add(CadApp.gen, 1)
        CA_WriteGen()
        // status
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
            IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
                CA_WriteFileStr("/tmp/cad_app/status.txt", "SKETCH line  (r pad m 3d)", 25)
            }
            IfCondition EqualTo(CadApp.tool, 1) ThenBlock: {
                CA_WriteFileStr("/tmp/cad_app/status.txt", "SKETCH rect  (r pad m 3d)", 25)
            }
            IfCondition EqualTo(CadApp.tool, 2) ThenBlock: {
                CA_WriteFileStr("/tmp/cad_app/status.txt", "SKETCH circ  (r pad m 3d)", 25)
            }
        }
        CA_WriteStatus()
        CA_WriteToolFile()
        ReturnValue(0)
    }
}

// Handle sketch click at pixel px,py
Function.CA_SketchClick {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
        }
        xy = Allocate(32)
        CA_PixToWorld(px, py, xy)
        wx = ArrayGet(xy, 0)
        wy = ArrayGet(xy, 1)
        Deallocate(xy, 32)
        // line: 2 clicks
        IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: {
                CadApp.cx0 = wx
                CadApp.cy0 = wy
                CadApp.nclick = 1
            }
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                // second click — but nclick already 1 from first; use flag carefully
            }
        }
        // simpler sequential: if nclick==0 store; else complete and reset
        IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                // was already 1 before this click started... re-read logic
            }
        }
        ReturnValue(0)
    }
}

// Snap world (wx,wy) to nearest existing line endpoint within ~12 screen px.
// Writes snapped coords to out[0],out[1]. Returns 1 if snapped, 0 if left as-is.
Function.CA_SnapWorld {
    Input: wx: Integer
    Input: wy: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        ArraySet(out_xy, 0, wx)
        ArraySet(out_xy, 1, wy)
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: { ReturnValue(0) }
        // snap ≈ 10 px; only to EXISTING endpoints (not current segment start)
        // Closing a poly: click near the first vertex (it is an existing endpoint after ≥1 line).
        snap = Float_Div(Float_FromInt(10), sc)
        snap2 = Float_Mul(snap, snap)
        // min length so we do not snap into a zero-length segment from tip
        minlen2 = Float_Mul(snap2, 0x4010000000000000)
        nl = CAD_Sketch.GetLineCount(CadApp.sketch)
        IfCondition LessThan(nl, 1) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(CadApp.sketch, 1)
        best = snap2
        bx = wx
        by = wy
        hit = 0
        i = 0
        WhileLoop LessThan(i, nl) {
            b = Multiply(i, 4)
            // endpoint A
            ax = ArrayGet(lines, b)
            ay = ArrayGet(lines, Add(b, 1))
            // skip if this is current segment start (would zero-length)
            skip = 0
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(ax, CadApp.cx0, 0), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(ay, CadApp.cy0, 0), 1) ThenBlock: {
                        skip = 1
                    }
                }
            }
            IfCondition EqualTo(skip, 0) ThenBlock: {
                dx = Float_Sub(wx, ax)
                dy = Float_Sub(wy, ay)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    bx = ax
                    by = ay
                    hit = 1
                }
            }
            // endpoint B
            ax = ArrayGet(lines, Add(b, 2))
            ay = ArrayGet(lines, Add(b, 3))
            skip = 0
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(ax, CadApp.cx0, 0), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(ay, CadApp.cy0, 0), 1) ThenBlock: {
                        skip = 1
                    }
                }
            }
            IfCondition EqualTo(skip, 0) ThenBlock: {
                dx = Float_Sub(wx, ax)
                dy = Float_Sub(wy, ay)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    bx = ax
                    by = ay
                    hit = 1
                }
            }
            i = Add(i, 1)
        }
        // snap onto circle rim (so box attaches to circle for pad merge)
        nc = CAD_Sketch.GetCircleCount(CadApp.sketch)
        IfCondition GreaterThan(nc, 0) ThenBlock: {
            circs = CAD_Store.Read(CadApp.sketch, 8)
            ci = 0
            WhileLoop LessThan(ci, nc) {
                base = Multiply(ci, 3)
                cx = ArrayGet(circs, base)
                cy = ArrayGet(circs, Add(base, 1))
                rad = ArrayGet(circs, Add(base, 2))
                dx = Float_Sub(wx, cx)
                dy = Float_Sub(wy, cy)
                d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                IfCondition EqualTo(CAD_Num.IsZero(d, 0), 0) ThenBlock: {
                    // distance to rim
                    dd = Float_Sub(d, rad)
                    IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
                    // within ~14 px of rim
                    IfCondition EqualTo(Float_Le(dd, snap), 1) ThenBlock: {
                        // project onto circle
                        px = Float_Add(cx, Float_Mul(rad, Float_Div(dx, d)))
                        py = Float_Add(cy, Float_Mul(rad, Float_Div(dy, d)))
                        // use if closer than current best endpoint snap
                        dx2 = Float_Sub(wx, px)
                        dy2 = Float_Sub(wy, py)
                        d2 = Float_Add(Float_Mul(dx2, dx2), Float_Mul(dy2, dy2))
                        IfCondition EqualTo(hit, 0) ThenBlock: {
                            best = d2
                            bx = px
                            by = py
                            hit = 1
                        }
                        IfCondition EqualTo(hit, 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                                best = d2
                                bx = px
                                by = py
                            }
                        }
                    }
                }
                ci = Add(ci, 1)
            }
        }
        IfCondition EqualTo(hit, 1) ThenBlock: {
            // refuse snap that collapses current segment to ~zero
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                dx = Float_Sub(bx, CadApp.cx0)
                dy = Float_Sub(by, CadApp.cy0)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, minlen2), 1) ThenBlock: {
                    IfCondition LessThan(nl, 3) ThenBlock: {
                        ReturnValue(0)
                    }
                }
            }
            ArraySet(out_xy, 0, bx)
            ArraySet(out_xy, 1, by)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Weld all line endpoints that fall within snap radius so BuildClosedLoop can chain.
Function.CA_WeldSketch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
            sc = 0x3FF0000000000000
        }
        // tight weld only — large snap was collapsing inset notches into a triangle
        snap = Float_Div(Float_FromInt(8), sc)
        snap2 = Float_Mul(snap, snap)
        nl = CAD_Sketch.GetLineCount(CadApp.sketch)
        IfCondition LessThan(nl, 2) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(CadApp.sketch, 1)
        npts = Multiply(nl, 2)
        pass = 0
        WhileLoop LessThan(pass, 3) {
            i = 0
            WhileLoop LessThan(i, npts) {
                li = Divide(i, 2)
                ei = Modulo(i, 2)
                bi = Multiply(li, 4)
                IfCondition EqualTo(ei, 0) ThenBlock: {
                    ix = ArrayGet(lines, bi)
                    iy = ArrayGet(lines, Add(bi, 1))
                }
                IfCondition EqualTo(ei, 1) ThenBlock: {
                    ix = ArrayGet(lines, Add(bi, 2))
                    iy = ArrayGet(lines, Add(bi, 3))
                }
                j = Add(i, 1)
                WhileLoop LessThan(j, npts) {
                    lj = Divide(j, 2)
                    // never weld the two ends of the SAME segment
                    IfCondition NotEqual(li, lj) ThenBlock: {
                        ej = Modulo(j, 2)
                        bj = Multiply(lj, 4)
                        IfCondition EqualTo(ej, 0) ThenBlock: {
                            jx = ArrayGet(lines, bj)
                            jy = ArrayGet(lines, Add(bj, 1))
                        }
                        IfCondition EqualTo(ej, 1) ThenBlock: {
                            jx = ArrayGet(lines, Add(bj, 2))
                            jy = ArrayGet(lines, Add(bj, 3))
                        }
                        dx = Float_Sub(ix, jx)
                        dy = Float_Sub(iy, jy)
                        d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                        IfCondition EqualTo(Float_Le(d2, snap2), 1) ThenBlock: {
                            mx = Float_Mul(Float_Add(ix, jx), 0x3FE0000000000000)
                            my = Float_Mul(Float_Add(iy, jy), 0x3FE0000000000000)
                            IfCondition EqualTo(ei, 0) ThenBlock: {
                                ArraySet(lines, bi, mx)
                                ArraySet(lines, Add(bi, 1), my)
                            }
                            IfCondition EqualTo(ei, 1) ThenBlock: {
                                ArraySet(lines, Add(bi, 2), mx)
                                ArraySet(lines, Add(bi, 3), my)
                            }
                            IfCondition EqualTo(ej, 0) ThenBlock: {
                                ArraySet(lines, bj, mx)
                                ArraySet(lines, Add(bj, 1), my)
                            }
                            IfCondition EqualTo(ej, 1) ThenBlock: {
                                ArraySet(lines, Add(bj, 2), mx)
                                ArraySet(lines, Add(bj, 3), my)
                            }
                            ix = mx
                            iy = my
                        }
                    }
                    j = Add(j, 1)
                }
                i = Add(i, 1)
            }
            pass = Add(pass, 1)
        }
        // clear cached loop so rebuild is forced
        CAD_Store.Write(CadApp.sketch, 2, 0)
        CAD_Store.Write(CadApp.sketch, 12, 0)
        ReturnValue(1)
    }
}

// Clear profile cache after geometry edits (must Profiles + select again).
// Does NOT touch lines/arcs/circles — only profile overlay cache.
Function.CA_InvalidateProfiles {
    Output: Integer
    Body: {
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            CAD_Store.Write(CadApp.sketch, 2, 0)
            CAD_Store.Write(CadApp.sketch, 12, 0)
        }
        CadApp.nprof = 0
        CadApp.prof_sel = 0
        CadApp.prof_user = 0
        CadApp.prof_mask = 0
        ReturnValue(0)
    }
}

// Copy lines + circles + arcs from src sketch into empty dst (geometry only).
Function.CA_CopySketchGeom {
    Input: src: Integer
    Input: dst: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        // lines
        nl = CAD_Store.Read(src, 0)
        sl = CAD_Store.Read(src, 1)
        i = 0
        WhileLoop LessThan(i, nl) {
            b = Multiply(i, 4)
            CAD_Sketch.AddLine(dst, ArrayGet(sl, b), ArrayGet(sl, Add(b, 1)), ArrayGet(sl, Add(b, 2)), ArrayGet(sl, Add(b, 3)))
            i = Add(i, 1)
        }
        // circles
        nc = CAD_Store.Read(src, 7)
        sc = CAD_Store.Read(src, 8)
        i = 0
        WhileLoop LessThan(i, nc) {
            b = Multiply(i, 3)
            CAD_Sketch.AddCircle(dst, ArrayGet(sc, b), ArrayGet(sc, Add(b, 1)), ArrayGet(sc, Add(b, 2)))
            i = Add(i, 1)
        }
        // arcs (keep as arcs — projection clone will tessellate)
        na = CAD_Store.Read(src, 10)
        sa = CAD_Store.Read(src, 11)
        i = 0
        WhileLoop LessThan(i, na) {
            b = Multiply(i, 5)
            CAD_Sketch.AddArc(dst, ArrayGet(sa, b), ArrayGet(sa, Add(b, 1)), ArrayGet(sa, Add(b, 2)), ArrayGet(sa, Add(b, 3)), ArrayGet(sa, Add(b, 4)))
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Copy projected profile rings from src into dst profile pool only.
// Leaves dst lines/circles/arcs untouched.
Function.CA_CopyProfilesOnly {
    Input: src: Integer
    Input: dst: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        nprof = CAD_Store.Read(src, 12)
        IfCondition EqualTo(nprof, 0) ThenBlock: {
            CAD_Store.Write(dst, 12, 0)
            CAD_Store.Write(dst, 2, 0)
            ReturnValue(0)
        }
        pool = CAD_Store.Read(dst, 14)
        pmeta = CAD_Store.Read(dst, 13)
        loop = CAD_Store.Read(dst, 3)
        cap_p = CAD_Store.Read(dst, 15)
        xy = Allocate(4096)
        pool_n = 0
        pi = 0
        n_out = 0
        WhileLoop LessThan(pi, nprof) {
            IfCondition LessThan(n_out, cap_p) ThenBlock: {
                nn = CAD_Sketch.GetProfileXY(src, pi, xy)
                IfCondition GreaterEqual(nn, 3) ThenBlock: {
                    ArraySet(pmeta, Multiply(n_out, 2), nn)
                    ArraySet(pmeta, Add(Multiply(n_out, 2), 1), pool_n)
                    k = 0
                    WhileLoop LessThan(k, nn) {
                        ArraySet(pool, Multiply(Add(pool_n, k), 2), ArrayGet(xy, Multiply(k, 2)))
                        ArraySet(pool, Add(Multiply(Add(pool_n, k), 2), 1), ArrayGet(xy, Add(Multiply(k, 2), 1)))
                        k = Add(k, 1)
                    }
                    pool_n = Add(pool_n, nn)
                    n_out = Add(n_out, 1)
                }
            }
            pi = Add(pi, 1)
        }
        CAD_Store.Write(dst, 12, n_out)
        // primary loop = profile 0
        IfCondition GreaterThan(n_out, 0) ThenBlock: {
            nn0 = ArrayGet(pmeta, 0)
            off0 = ArrayGet(pmeta, 1)
            k = 0
            WhileLoop LessThan(k, nn0) {
                ArraySet(loop, Multiply(k, 2), ArrayGet(pool, Multiply(Add(off0, k), 2)))
                ArraySet(loop, Add(Multiply(k, 2), 1), ArrayGet(pool, Add(Multiply(Add(off0, k), 2), 1)))
                k = Add(k, 1)
            }
            CAD_Store.Write(dst, 2, nn0)
        }
        Deallocate(xy, 4096)
        ReturnValue(n_out)
    }
}

// Weld endpoints on a given sketch handle (projection clone).
Function.CA_WeldSketchHandle {
    Input: sk: Integer
    Input: px_tol: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sk, 0) ThenBlock: { ReturnValue(0) }
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
            sc = 0x3FF0000000000000
        }
        snap = Float_Div(Float_FromInt(px_tol), sc)
        snap2 = Float_Mul(snap, snap)
        nl = CAD_Sketch.GetLineCount(sk)
        IfCondition LessThan(nl, 2) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(sk, 1)
        npts = Multiply(nl, 2)
        pass = 0
        WhileLoop LessThan(pass, 4) {
            i = 0
            WhileLoop LessThan(i, npts) {
                li = Divide(i, 2)
                ei = Modulo(i, 2)
                bi = Multiply(li, 4)
                IfCondition EqualTo(ei, 0) ThenBlock: {
                    ix = ArrayGet(lines, bi)
                    iy = ArrayGet(lines, Add(bi, 1))
                }
                IfCondition EqualTo(ei, 1) ThenBlock: {
                    ix = ArrayGet(lines, Add(bi, 2))
                    iy = ArrayGet(lines, Add(bi, 3))
                }
                j = Add(i, 1)
                WhileLoop LessThan(j, npts) {
                    lj = Divide(j, 2)
                    IfCondition NotEqual(li, lj) ThenBlock: {
                        ej = Modulo(j, 2)
                        bj = Multiply(lj, 4)
                        IfCondition EqualTo(ej, 0) ThenBlock: {
                            jx = ArrayGet(lines, bj)
                            jy = ArrayGet(lines, Add(bj, 1))
                        }
                        IfCondition EqualTo(ej, 1) ThenBlock: {
                            jx = ArrayGet(lines, Add(bj, 2))
                            jy = ArrayGet(lines, Add(bj, 3))
                        }
                        dx = Float_Sub(ix, jx)
                        dy = Float_Sub(iy, jy)
                        d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                        IfCondition EqualTo(Float_Le(d2, snap2), 1) ThenBlock: {
                            mx = Float_Mul(Float_Add(ix, jx), 0x3FE0000000000000)
                            my = Float_Mul(Float_Add(iy, jy), 0x3FE0000000000000)
                            IfCondition EqualTo(ei, 0) ThenBlock: {
                                ArraySet(lines, bi, mx)
                                ArraySet(lines, Add(bi, 1), my)
                            }
                            IfCondition EqualTo(ei, 1) ThenBlock: {
                                ArraySet(lines, Add(bi, 2), mx)
                                ArraySet(lines, Add(bi, 3), my)
                            }
                            IfCondition EqualTo(ej, 0) ThenBlock: {
                                ArraySet(lines, bj, mx)
                                ArraySet(lines, Add(bj, 1), my)
                            }
                            IfCondition EqualTo(ej, 1) ThenBlock: {
                                ArraySet(lines, Add(bj, 2), mx)
                                ArraySet(lines, Add(bj, 3), my)
                            }
                            ix = mx
                            iy = my
                        }
                    }
                    j = Add(j, 1)
                }
                i = Add(i, 1)
            }
            pass = Add(pass, 1)
        }
        ReturnValue(1)
    }
}

// Point-in-polygon (ray cast). xy = n pairs. Returns 1 if inside.
Function.CA_PointInPoly {
    Input: wx: Integer
    Input: wy: Integer
    Input: xy: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        inside = 0
        i = 0
        j = Subtract(n, 1)
        WhileLoop LessThan(i, n) {
            xi = ArrayGet(xy, Multiply(i, 2))
            yi = ArrayGet(xy, Add(Multiply(i, 2), 1))
            xj = ArrayGet(xy, Multiply(j, 2))
            yj = ArrayGet(xy, Add(Multiply(j, 2), 1))
            // (yi > wy) != (yj > wy)  using wy < yi style: Float_Le(wy,yi)==0 means yi > wy
            a = 0
            b = 0
            IfCondition EqualTo(Float_Le(wy, yi), 0) ThenBlock: { a = 1 }
            IfCondition EqualTo(Float_Le(wy, yj), 0) ThenBlock: { b = 1 }
            IfCondition NotEqual(a, b) ThenBlock: {
                den = Float_Sub(yj, yi)
                IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                    xint = Float_Add(xi, Float_Mul(Float_Sub(xj, xi), Float_Div(Float_Sub(wy, yi), den)))
                    // wx < xint
                    IfCondition EqualTo(Float_Le(xint, wx), 0) ThenBlock: {
                        inside = Subtract(1, inside)
                    }
                }
            }
            j = i
            i = Add(i, 1)
        }
        ReturnValue(inside)
    }
}

// Project closed profiles WITHOUT mutating live sketch lines/arcs.
// Philosophy: anchors at ends + crosses + T-touches (not welding).
// Clone → anchors → split at anchors/cross → prune stubs → closed cycles →
// copy green rings + anchors onto live for display only.
Function.CA_RebuildProfiles {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.nprof = 0
            CadApp.prof_user = 0
            ReturnValue(0)
        }
        live = CadApp.sketch
        // anchors on LIVE for display (does not move line geometry)
        np = CAD_Sketch.RebuildAnchors(live)
        clone = CAD_Sketch.CreateSketch(1)
        IfCondition EqualTo(clone, 0) ThenBlock: {
            CA_Log("cad_app: profile project FAIL (clone)\n", 38)
            ReturnValue(0)
        }
        CA_CopySketchGeom(live, clone)
        // Tessellate curves WITH forced verts at line×curve hits so a line
        // drawn through an arc/circle joins the polyline rim (anchors alone
        // are not enough — plain inscribed n-gon can miss the true crossings).
        // BuildAllClosedLoops does a single split/prune + face walk.
        IfCondition GreaterThan(CAD_Store.Read(clone, 10), 0) ThenBlock: {
            CAD_Sketch.TessellateArcs(clone, 48)
        }
        IfCondition GreaterThan(CAD_Store.Read(clone, 7), 0) ThenBlock: {
            // forces verts at line×circle AND circle×circle hits (3-circle T-junctions)
            CAD_Sketch.TessellateCircles(clone, 48)
            CAD_Store.Write(clone, 7, 0)
        }
        // BuildAllClosedLoops does ONE split+prune+face walk.
        // Extra pre-split/prune here destroyed multi-circle graphs (nprof→1).
        CAD_Sketch.SnapNearEndpoints(clone, 0)
        n = CAD_Sketch.BuildAllClosedLoops(clone)
        IfCondition EqualTo(n, 0) ThenBlock: {
            CAD_Sketch.SnapNearEndpoints(clone, 0)
            n = CAD_Sketch.BuildAllClosedLoops(clone)
        }
        n = CA_CopyProfilesOnly(clone, live)
        CadApp.nprof = n
        CadApp.prof_sel = 0
        CadApp.prof_user = 0
        CadApp.prof_mask = 0
        // live sketch keeps original circles/arcs/lines — anchors are markers only
        CAD_Sketch.RebuildAnchors(live)
        IfCondition EqualTo(n, 0) ThenBlock: {
            CA_Log("cad_app: no closed profile\n", 28)
            CA_Log("  tip: Trim free overshoots past crosses, then Profiles\n", 55)
            CA_Log("  (stubs can block face-walk; FreeCAD is picky too)\n", 51)
            ReturnValue(0)
        }
        // Choose default Pad face: prefer dense rings (tessellated radius/arc
        // segments) over sparse chord polygons that only hop through anchors.
        // Score = |area| * (1 + nn/8) so a curved rim wins over a few-sided cut.
        best_i = 0
        best_sc = 0
        xy = Allocate(4096)
        pi = 0
        WhileLoop LessThan(pi, n) {
            nn = CAD_Sketch.GetProfileXY(live, pi, xy)
            IfCondition GreaterEqual(nn, 3) ThenBlock: {
                ar = CAD_Sketch.LoopSignedArea(xy, nn)
                IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                // density boost: tessellated circle/arc faces have many verts
                dens = Float_Add(0x3FF0000000000000, Float_Div(Float_FromInt(nn), Float_FromInt(8)))
                sc = Float_Mul(ar, dens)
                IfCondition EqualTo(Float_Le(best_sc, sc), 1) ThenBlock: {
                    best_sc = sc
                    best_i = pi
                }
            }
            pi = Add(pi, 1)
        }
        Deallocate(xy, 4096)
        CAD_Store.Write(live, 12, n)
        CadApp.nprof = n
        CadApp.prof_sel = best_i
        CadApp.prof_user = 1
        CadApp.prof_mask = LeftShift(1, best_i)
        CAD_Sketch.SelectProfile(live, best_i)
        CAD_Store.Write(live, 12, n)
        IfCondition EqualTo(n, 1) ThenBlock: {
            CA_Log("cad_app: 1 profile — Pad ready (red ring)\n", 40)
            ReturnValue(1)
        }
        CA_Log("cad_app: multi profiles — Shift+click to add more\n", 46)
        CA_Log("  pad: largest = solid; nested simple rings = holes\n", 52)
        CA_Log("  tip: square-in-square → select outer then Pad\n", 48)
        ReturnValue(n)
    }
}

// Apply selection. add_mode=0 replace; add_mode=1 toggle bit (Shift+click multi).
// Returns 1 on success.
Function.CA_ApplyProfileSel {
    Input: idx: Integer
    Input: nprof: Integer
    Input: add_mode: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(idx, nprof) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(idx, 31) ThenBlock: { ReturnValue(0) }
        xy = Allocate(4096)
        nn = CAD_Sketch.GetProfileXY(CadApp.sketch, idx, xy)
        Deallocate(xy, 4096)
        IfCondition LessThan(nn, 3) ThenBlock: {
            CA_Log("cad_app: select FAIL — empty ring\n", 34)
            ReturnValue(0)
        }
        bit = LeftShift(1, idx)
        IfCondition EqualTo(add_mode, 0) ThenBlock: {
            CadApp.prof_mask = bit
            CadApp.prof_sel = idx
        }
        IfCondition EqualTo(add_mode, 1) ThenBlock: {
            CadApp.prof_mask = BitwiseXor(CadApp.prof_mask, bit)
            CadApp.prof_sel = idx
            // if nothing left selected, keep user flag off
            IfCondition EqualTo(CadApp.prof_mask, 0) ThenBlock: {
                CadApp.prof_user = 0
                CAD_Store.Write(CadApp.sketch, 12, nprof)
                CadApp.nprof = nprof
                ReturnValue(1)
            }
        }
        CAD_Sketch.SelectProfile(CadApp.sketch, idx)
        CAD_Store.Write(CadApp.sketch, 12, nprof)
        CadApp.prof_user = 1
        CadApp.nprof = nprof
        ReturnValue(1)
    }
}

// Find best profile under (wx,wy); returns index or -1.
Function.CA_HitProfile {
    Input: wx: Integer
    Input: wy: Integer
    Input: nprof: Integer
    Output: Integer
    Body: {
        xy = Allocate(4096)
        best_in = -1
        best_in_a = 0
        found_in = 0
        pi = 0
        WhileLoop LessThan(pi, nprof) {
            nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
            IfCondition GreaterEqual(nn, 3) ThenBlock: {
                IfCondition EqualTo(CA_PointInPoly(wx, wy, xy, nn), 1) ThenBlock: {
                    ar = CAD_Sketch.LoopSignedArea(xy, nn)
                    IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                    IfCondition EqualTo(found_in, 0) ThenBlock: {
                        found_in = 1
                        best_in = pi
                        best_in_a = ar
                    }
                    IfCondition EqualTo(Float_Le(ar, best_in_a), 1) ThenBlock: {
                        best_in = pi
                        best_in_a = ar
                    }
                }
            }
            pi = Add(pi, 1)
        }
        IfCondition EqualTo(found_in, 1) ThenBlock: {
            Deallocate(xy, 4096)
            ReturnValue(best_in)
        }
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: { sc = 0x3FF0000000000000 }
        lim = Float_Div(Float_FromInt(120), sc)
        lim2 = Float_Mul(lim, lim)
        best_i = -1
        best_d2 = lim2
        pi = 0
        WhileLoop LessThan(pi, nprof) {
            nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
            IfCondition GreaterEqual(nn, 2) ThenBlock: {
                k = 0
                WhileLoop LessThan(k, nn) {
                    k2 = Add(k, 1)
                    IfCondition EqualTo(k2, nn) ThenBlock: { k2 = 0 }
                    x0 = ArrayGet(xy, Multiply(k, 2))
                    y0 = ArrayGet(xy, Add(Multiply(k, 2), 1))
                    x1 = ArrayGet(xy, Multiply(k2, 2))
                    y1 = ArrayGet(xy, Add(Multiply(k2, 2), 1))
                    dx = Float_Sub(x1, x0)
                    dy = Float_Sub(y1, y0)
                    len2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    t = 0
                    IfCondition EqualTo(CAD_Num.IsZero(len2, 0), 0) ThenBlock: {
                        t = Float_Div(Float_Add(Float_Mul(Float_Sub(wx, x0), dx), Float_Mul(Float_Sub(wy, y0), dy)), len2)
                        IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: { t = 0 }
                        IfCondition EqualTo(Float_Le(0x3FF0000000000000, t), 1) ThenBlock: { t = 0x3FF0000000000000 }
                    }
                    px = Float_Add(x0, Float_Mul(t, dx))
                    py = Float_Add(y0, Float_Mul(t, dy))
                    ddx = Float_Sub(wx, px)
                    ddy = Float_Sub(wy, py)
                    d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                    IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                        best_d2 = d2
                        best_i = pi
                    }
                    k = Add(k, 1)
                }
            }
            pi = Add(pi, 1)
        }
        IfCondition GreaterEqual(best_i, 0) ThenBlock: {
            Deallocate(xy, 4096)
            ReturnValue(best_i)
        }
        // nearest centroid
        best_i = -1
        best_d2 = 0
        pi = 0
        WhileLoop LessThan(pi, nprof) {
            nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
            IfCondition GreaterEqual(nn, 3) ThenBlock: {
                cx = 0
                cy = 0
                k = 0
                WhileLoop LessThan(k, nn) {
                    cx = Float_Add(cx, ArrayGet(xy, Multiply(k, 2)))
                    cy = Float_Add(cy, ArrayGet(xy, Add(Multiply(k, 2), 1)))
                    k = Add(k, 1)
                }
                inv = Float_Div(0x3FF0000000000000, Float_FromInt(nn))
                cx = Float_Mul(cx, inv)
                cy = Float_Mul(cy, inv)
                ddx = Float_Sub(wx, cx)
                ddy = Float_Sub(wy, cy)
                d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                IfCondition EqualTo(best_i, -1) ThenBlock: {
                    best_i = pi
                    best_d2 = d2
                }
                IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                    best_i = pi
                    best_d2 = d2
                }
            }
            pi = Add(pi, 1)
        }
        Deallocate(xy, 4096)
        ReturnValue(best_i)
    }
}

// Pick profile. shift=1 → toggle multi-select (Shift+click).
Function.CA_PickProfileAt {
    Input: wx: Integer
    Input: wy: Integer
    Input: shift: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        nprof = CAD_Store.Read(CadApp.sketch, 12)
        IfCondition EqualTo(nprof, 0) ThenBlock: {
            nprof = CA_RebuildProfiles()
        }
        IfCondition EqualTo(nprof, 0) ThenBlock: {
            CA_Log("cad_app: pick fail — no projected profile\n", 41)
            ReturnValue(0)
        }
        hit = CA_HitProfile(wx, wy, nprof)
        IfCondition LessThan(hit, 0) ThenBlock: {
            CA_Log("cad_app: pick miss — Profiles then click a ring\n", 47)
            ReturnValue(0)
        }
        addm = 0
        IfCondition NotEqual(shift, 0) ThenBlock: { addm = 1 }
        ok = CA_ApplyProfileSel(hit, nprof, addm)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(addm, 1) ThenBlock: {
            CA_Log("cad_app: multi-select toggle (Shift+click)\n", 41)
        }
        IfCondition EqualTo(addm, 0) ThenBlock: {
            CA_Log("cad_app: profile selected (red)\n", 32)
        }
        ReturnValue(1)
    }
}

// Segment param t of closest point on line i to (wx,wy). Writes t to out[0], d2 to out[1].
Function.CA_LineClosestT {
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Input: wx: Integer
    Input: wy: Integer
    Input: out_td: Address
    Output: Integer
    Body: {
        dx = Float_Sub(x1, x0)
        dy = Float_Sub(y1, y0)
        len2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        t = 0
        IfCondition EqualTo(CAD_Num.IsZero(len2, 0), 0) ThenBlock: {
            t = Float_Div(Float_Add(Float_Mul(Float_Sub(wx, x0), dx), Float_Mul(Float_Sub(wy, y0), dy)), len2)
            IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: { t = 0 }
            IfCondition EqualTo(Float_Le(0x3FF0000000000000, t), 1) ThenBlock: { t = 0x3FF0000000000000 }
        }
        px = Float_Add(x0, Float_Mul(t, dx))
        py = Float_Add(y0, Float_Mul(t, dy))
        ddx = Float_Sub(wx, px)
        ddy = Float_Sub(wy, py)
        d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
        ArraySet(out_td, 0, t)
        ArraySet(out_td, 1, d2)
        ReturnValue(0)
    }
}

// Line-line intersection: param t on A in [0,1], u on B in [0,1]. out[0]=t out[1]=u. Returns 1 if hit.
Function.CA_SegSegHit {
    Input: ax0: Integer
    Input: ay0: Integer
    Input: ax1: Integer
    Input: ay1: Integer
    Input: bx0: Integer
    Input: by0: Integer
    Input: bx1: Integer
    Input: by1: Integer
    Input: out_tu: Address
    Output: Integer
    Body: {
        adx = Float_Sub(ax1, ax0)
        ady = Float_Sub(ay1, ay0)
        bdx = Float_Sub(bx1, bx0)
        bdy = Float_Sub(by1, by0)
        den = Float_Sub(Float_Mul(adx, bdy), Float_Mul(ady, bdx))
        IfCondition EqualTo(CAD_Num.IsZero(den, 0), 1) ThenBlock: { ReturnValue(0) }
        t = Float_Div(Float_Sub(Float_Mul(Float_Sub(bx0, ax0), bdy), Float_Mul(Float_Sub(by0, ay0), bdx)), den)
        u = Float_Div(Float_Sub(Float_Mul(Float_Sub(bx0, ax0), ady), Float_Mul(Float_Sub(by0, ay0), adx)), den)
        // interior only (not endpoints — avoid noise)
        eps = 0x3F50624DD2F1A9FC
        one = 0x3FF0000000000000
        IfCondition EqualTo(Float_Le(t, eps), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(Float_Sub(one, eps), t), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(u, eps), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(Float_Sub(one, eps), u), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(out_tu, 0, t)
        ArraySet(out_tu, 1, u)
        ReturnValue(1)
    }
}

// Line-circle intersections: up to 2 params t in (0,1) written to out[0..n-1]. Returns n.
Function.CA_SegCircleHits {
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Input: cx: Integer
    Input: cy: Integer
    Input: rad: Integer
    Input: out_t: Address
    Output: Integer
    Body: {
        dx = Float_Sub(x1, x0)
        dy = Float_Sub(y1, y0)
        fx = Float_Sub(x0, cx)
        fy = Float_Sub(y0, cy)
        a = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        IfCondition EqualTo(CAD_Num.IsZero(a, 0), 1) ThenBlock: { ReturnValue(0) }
        b = Float_Mul(0x4000000000000000, Float_Add(Float_Mul(fx, dx), Float_Mul(fy, dy)))
        c = Float_Sub(Float_Add(Float_Mul(fx, fx), Float_Mul(fy, fy)), Float_Mul(rad, rad))
        disc = Float_Sub(Float_Mul(b, b), Float_Mul(Float_Mul(0x4010000000000000, a), c))
        IfCondition EqualTo(Float_Le(disc, 0), 1) ThenBlock: { ReturnValue(0) }
        s = CAD_Num.Sqrt(disc)
        // t = (-b ± s) / (2a)
        two_a = Float_Mul(0x4000000000000000, a)
        t0 = Float_Div(Float_Sub(Float_Sub(0, b), s), two_a)
        t1 = Float_Div(Float_Add(Float_Sub(0, b), s), two_a)
        n = 0
        eps = 0x3F50624DD2F1A9FC
        one = 0x3FF0000000000000
        IfCondition EqualTo(Float_Le(t0, eps), 0) ThenBlock: {
            IfCondition EqualTo(Float_Le(Float_Sub(one, eps), t0), 0) ThenBlock: {
                ArraySet(out_t, n, t0)
                n = Add(n, 1)
            }
        }
        IfCondition EqualTo(Float_Le(t1, eps), 0) ThenBlock: {
            IfCondition EqualTo(Float_Le(Float_Sub(one, eps), t1), 0) ThenBlock: {
                ArraySet(out_t, n, t1)
                n = Add(n, 1)
            }
        }
        ReturnValue(n)
    }
}

// Trim: FreeCAD-style cut-back-to-join.
//   • NEVER permanently tessellates live circles/arcs (display stays clean).
//   • Line hit: split at line×line / line×circle / line×arc joins, delete only
//     the piece under the click (overshoot stub dies at the point).
//   • Circle hit: convert that circle into ARC pieces at intersection angles,
//     drop the arc under the click; remaining pieces stay true arcs.
//   • Arc hit: split that arc at joins and drop the sub-arc under the click.
// Projection (Profiles/Pad) still tessellates a clone only.
Function.CA_TrimAt {
    Input: wx: Integer
    Input: wy: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: trim no sketch\n", 24)
            ReturnValue(0)
        }
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: { sc = 0x3FF0000000000000 }
        // STRICT: only hit within ~10 screen pixels (no random far trims)
        hit_lim = Float_Div(Float_FromInt(10), sc)
        hit_lim2 = Float_Mul(hit_lim, hit_lim)
        two_pi = 0x401921FB54442D18
        eps = 0x3F50624DD2F1A9FC
        one = 0x3FF0000000000000

        // --- pick nearest entity: line / circle rim / arc rim ---
        best_kind = 0
        best_idx = 0
        best_d2 = hit_lim2
        hit_ok = 0

        // lines
        nl = CAD_Sketch.GetLineCount(CadApp.sketch)
        lines = CAD_Store.Read(CadApp.sketch, 1)
        i = 0
        WhileLoop LessThan(i, nl) {
            b = Multiply(i, 4)
            x0 = ArrayGet(lines, b)
            y0 = ArrayGet(lines, Add(b, 1))
            x1 = ArrayGet(lines, Add(b, 2))
            y1 = ArrayGet(lines, Add(b, 3))
            dx = Float_Sub(x1, x0)
            dy = Float_Sub(y1, y0)
            len2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
            t = 0
            IfCondition EqualTo(CAD_Num.IsZero(len2, 0), 0) ThenBlock: {
                t = Float_Div(Float_Add(Float_Mul(Float_Sub(wx, x0), dx), Float_Mul(Float_Sub(wy, y0), dy)), len2)
                IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: { t = 0 }
                IfCondition EqualTo(Float_Le(one, t), 1) ThenBlock: { t = one }
            }
            px = Float_Add(x0, Float_Mul(t, dx))
            py = Float_Add(y0, Float_Mul(t, dy))
            ddx = Float_Sub(wx, px)
            ddy = Float_Sub(wy, py)
            d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                best_d2 = d2
                best_idx = i
                best_kind = 1
                hit_ok = 1
            }
            i = Add(i, 1)
        }

        // circles (distance to rim)
        nc = CAD_Sketch.GetCircleCount(CadApp.sketch)
        circs = CAD_Store.Read(CadApp.sketch, 8)
        ci = 0
        WhileLoop LessThan(ci, nc) {
            base = Multiply(ci, 3)
            cx = ArrayGet(circs, base)
            cy = ArrayGet(circs, Add(base, 1))
            rad = ArrayGet(circs, Add(base, 2))
            dx = Float_Sub(wx, cx)
            dy = Float_Sub(wy, cy)
            d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
            dd = Float_Sub(d, rad)
            IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
            d2 = Float_Mul(dd, dd)
            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                best_d2 = d2
                best_idx = ci
                best_kind = 2
                hit_ok = 1
            }
            ci = Add(ci, 1)
        }

        // arcs (distance to arc curve, only if angle on span)
        na = CAD_Sketch.GetArcCount(CadApp.sketch)
        arcs = CAD_Store.Read(CadApp.sketch, 11)
        ai = 0
        WhileLoop LessThan(ai, na) {
            base = Multiply(ai, 5)
            cx = ArrayGet(arcs, base)
            cy = ArrayGet(arcs, Add(base, 1))
            rad = ArrayGet(arcs, Add(base, 2))
            a0 = ArrayGet(arcs, Add(base, 3))
            a1 = ArrayGet(arcs, Add(base, 4))
            span = Float_Sub(a1, a0)
            IfCondition EqualTo(Float_Le(span, 0), 1) ThenBlock: {
                span = Float_Add(span, two_pi)
            }
            ang = CAD_Geom.Atan2(Float_Sub(wy, cy), Float_Sub(wx, cx))
            dang = Float_Sub(ang, a0)
            IfCondition EqualTo(Float_Le(dang, 0), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(Float_Sub(0, dang), eps), 0) ThenBlock: {
                    dang = Float_Add(dang, two_pi)
                }
            }
            on = 0
            IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: { on = 1 }
            IfCondition EqualTo(on, 1) ThenBlock: {
                dx = Float_Sub(wx, cx)
                dy = Float_Sub(wy, cy)
                d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                dd = Float_Sub(d, rad)
                IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
                d2 = Float_Mul(dd, dd)
                IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                    best_d2 = d2
                    best_idx = ai
                    best_kind = 3
                    hit_ok = 1
                }
            }
            ai = Add(ai, 1)
        }

        IfCondition EqualTo(hit_ok, 0) ThenBlock: {
            CA_Log("cad_app: trim miss\n", 19)
            ReturnValue(0)
        }

        // ========== LINE: split at joins, delete only clicked piece ==========
        IfCondition EqualTo(best_kind, 1) ThenBlock: {
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CAD_Sketch.SplitAtIntersections(CadApp.sketch)
            // re-pick nearest LINE piece after split
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            lines = CAD_Store.Read(CadApp.sketch, 1)
            best_line = 0
            best_d2 = hit_lim2
            line_ok = 0
            i = 0
            WhileLoop LessThan(i, nl) {
                b = Multiply(i, 4)
                x0 = ArrayGet(lines, b)
                y0 = ArrayGet(lines, Add(b, 1))
                x1 = ArrayGet(lines, Add(b, 2))
                y1 = ArrayGet(lines, Add(b, 3))
                dx = Float_Sub(x1, x0)
                dy = Float_Sub(y1, y0)
                len2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                t = 0
                IfCondition EqualTo(CAD_Num.IsZero(len2, 0), 0) ThenBlock: {
                    t = Float_Div(Float_Add(Float_Mul(Float_Sub(wx, x0), dx), Float_Mul(Float_Sub(wy, y0), dy)), len2)
                    IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: { t = 0 }
                    IfCondition EqualTo(Float_Le(one, t), 1) ThenBlock: { t = one }
                }
                px = Float_Add(x0, Float_Mul(t, dx))
                py = Float_Add(y0, Float_Mul(t, dy))
                ddx = Float_Sub(wx, px)
                ddy = Float_Sub(wy, py)
                d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                    best_d2 = d2
                    best_line = i
                    line_ok = 1
                }
                i = Add(i, 1)
            }
            IfCondition EqualTo(line_ok, 0) ThenBlock: {
                CA_Log("cad_app: trim miss after split\n", 29)
                ReturnValue(0)
            }
            CAD_Sketch.DeleteLine(CadApp.sketch, best_line)
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            CA_Log("cad_app: trimmed line stub\n", 26)
            ReturnValue(1)
        }

        // ========== CIRCLE: keep as arcs, remove sector under click ==========
        IfCondition EqualTo(best_kind, 2) ThenBlock: {
            circs = CAD_Store.Read(CadApp.sketch, 8)
            base = Multiply(best_idx, 3)
            cx = ArrayGet(circs, base)
            cy = ArrayGet(circs, Add(base, 1))
            rad = ArrayGet(circs, Add(base, 2))
            // click angle on rim
            click_ang = CAD_Geom.Atan2(Float_Sub(wy, cy), Float_Sub(wx, cx))
            IfCondition EqualTo(Float_Le(click_ang, 0), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(Float_Sub(0, click_ang), eps), 0) ThenBlock: {
                    click_ang = Float_Add(click_ang, two_pi)
                }
            }
            IfCondition EqualTo(Float_Le(two_pi, click_ang), 1) ThenBlock: {
                click_ang = Float_Sub(click_ang, two_pi)
            }
            // collect intersection angles (lines + other circles + arcs)
            angs = Allocate(512)
            nang = 0
            // line × this circle
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            lines = CAD_Store.Read(CadApp.sketch, 1)
            li = 0
            WhileLoop LessThan(li, nl) {
                b = Multiply(li, 4)
                x0 = ArrayGet(lines, b)
                y0 = ArrayGet(lines, Add(b, 1))
                x1 = ArrayGet(lines, Add(b, 2))
                y1 = ArrayGet(lines, Add(b, 3))
                dx = Float_Sub(x1, x0)
                dy = Float_Sub(y1, y0)
                fx = Float_Sub(x0, cx)
                fy = Float_Sub(y0, cy)
                aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                    bb = Float_Mul(0x4000000000000000, Float_Add(Float_Mul(fx, dx), Float_Mul(fy, dy)))
                    cc = Float_Sub(Float_Add(Float_Mul(fx, fx), Float_Mul(fy, fy)), Float_Mul(rad, rad))
                    disc = Float_Sub(Float_Mul(bb, bb), Float_Mul(Float_Mul(0x4010000000000000, aa), cc))
                    IfCondition EqualTo(Float_Le(disc, 0), 0) ThenBlock: {
                        s = CAD_Num.Sqrt(disc)
                        two_a = Float_Mul(0x4000000000000000, aa)
                        t0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                        t1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                        hi = 0
                        WhileLoop LessThan(hi, 2) {
                            t = t0
                            IfCondition EqualTo(hi, 1) ThenBlock: { t = t1 }
                            ok = 1
                            IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: {
                                IfCondition EqualTo(Float_Le(Float_Sub(0, t), eps), 0) ThenBlock: { ok = 0 }
                            }
                            IfCondition EqualTo(Float_Le(one, t), 1) ThenBlock: {
                                IfCondition EqualTo(Float_Le(Float_Sub(t, one), eps), 0) ThenBlock: { ok = 0 }
                            }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                px = Float_Add(x0, Float_Mul(t, dx))
                                py = Float_Add(y0, Float_Mul(t, dy))
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(Float_Sub(0, ang), eps), 0) ThenBlock: {
                                        ang = Float_Add(ang, two_pi)
                                    }
                                }
                                IfCondition EqualTo(Float_Le(two_pi, ang), 1) ThenBlock: {
                                    ang = Float_Sub(ang, two_pi)
                                }
                                IfCondition LessThan(nang, 500) ThenBlock: {
                                    ArraySet(angs, nang, ang)
                                    nang = Add(nang, 1)
                                }
                            }
                            hi = Add(hi, 1)
                        }
                    }
                }
                li = Add(li, 1)
            }
            // other circles × this circle
            nc2 = CAD_Sketch.GetCircleCount(CadApp.sketch)
            cj = 0
            WhileLoop LessThan(cj, nc2) {
                IfCondition NotEqual(cj, best_idx) ThenBlock: {
                    bj = Multiply(cj, 3)
                    ox = ArrayGet(circs, bj)
                    oy = ArrayGet(circs, Add(bj, 1))
                    orad = ArrayGet(circs, Add(bj, 2))
                    dx = Float_Sub(ox, cx)
                    dy = Float_Sub(oy, cy)
                    d2c = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    d = CAD_Num.Sqrt(d2c)
                    okc = 1
                    IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: { okc = 0 }
                    IfCondition EqualTo(Float_Le(Float_Add(rad, orad), d), 1) ThenBlock: { okc = 0 }
                    dr = Float_Sub(rad, orad)
                    IfCondition EqualTo(Float_Le(dr, 0), 1) ThenBlock: { dr = Float_Sub(0, dr) }
                    IfCondition EqualTo(Float_Le(d, dr), 1) ThenBlock: { okc = 0 }
                    IfCondition EqualTo(okc, 1) ThenBlock: {
                        a = Float_Div(Float_Add(Float_Sub(Float_Mul(rad, rad), Float_Mul(orad, orad)), d2c), Float_Mul(0x4000000000000000, d))
                        h2 = Float_Sub(Float_Mul(rad, rad), Float_Mul(a, a))
                        IfCondition EqualTo(Float_Le(h2, 0), 0) ThenBlock: {
                            h = CAD_Num.Sqrt(h2)
                            mx = Float_Add(cx, Float_Mul(a, Float_Div(dx, d)))
                            my = Float_Add(cy, Float_Mul(a, Float_Div(dy, d)))
                            rx = Float_Mul(h, Float_Div(dy, d))
                            ry = Float_Mul(h, Float_Div(dx, d))
                            hi = 0
                            WhileLoop LessThan(hi, 2) {
                                IfCondition EqualTo(hi, 0) ThenBlock: {
                                    px = Float_Add(mx, rx)
                                    py = Float_Sub(my, ry)
                                }
                                IfCondition EqualTo(hi, 1) ThenBlock: {
                                    px = Float_Sub(mx, rx)
                                    py = Float_Add(my, ry)
                                }
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(Float_Sub(0, ang), eps), 0) ThenBlock: {
                                        ang = Float_Add(ang, two_pi)
                                    }
                                }
                                IfCondition EqualTo(Float_Le(two_pi, ang), 1) ThenBlock: {
                                    ang = Float_Sub(ang, two_pi)
                                }
                                IfCondition LessThan(nang, 500) ThenBlock: {
                                    ArraySet(angs, nang, ang)
                                    nang = Add(nang, 1)
                                }
                                hi = Add(hi, 1)
                            }
                        }
                    }
                }
                cj = Add(cj, 1)
            }
            // arc endpoints that lie on this circle rim (join tips)
            na2 = CAD_Sketch.GetArcCount(CadApp.sketch)
            arcs = CAD_Store.Read(CadApp.sketch, 11)
            aj = 0
            WhileLoop LessThan(aj, na2) {
                ab = Multiply(aj, 5)
                acx = ArrayGet(arcs, ab)
                acy = ArrayGet(arcs, Add(ab, 1))
                ar = ArrayGet(arcs, Add(ab, 2))
                aa0 = ArrayGet(arcs, Add(ab, 3))
                aa1 = ArrayGet(arcs, Add(ab, 4))
                // endpoint 0
                px = Float_Add(acx, Float_Mul(ar, CAD_Geom.Cos(aa0)))
                py = Float_Add(acy, Float_Mul(ar, CAD_Geom.Sin(aa0)))
                ddx = Float_Sub(px, cx)
                ddy = Float_Sub(py, cy)
                dist = CAD_Num.Sqrt(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)))
                IfCondition EqualTo(Float_Le(Float_Sub(dist, rad), 0), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(0, Float_Sub(dist, rad)), Float_Mul(rad, 0x3F847AE147AE147B)), 1) ThenBlock: {
                        ang = CAD_Geom.Atan2(ddy, ddx)
                        IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0, ang), eps), 0) ThenBlock: {
                                ang = Float_Add(ang, two_pi)
                            }
                        }
                        IfCondition LessThan(nang, 500) ThenBlock: {
                            ArraySet(angs, nang, ang)
                            nang = Add(nang, 1)
                        }
                    }
                }
                IfCondition EqualTo(Float_Le(rad, dist), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(dist, rad), Float_Mul(rad, 0x3F847AE147AE147B)), 1) ThenBlock: {
                        ang = CAD_Geom.Atan2(ddy, ddx)
                        IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0, ang), eps), 0) ThenBlock: {
                                ang = Float_Add(ang, two_pi)
                            }
                        }
                        IfCondition LessThan(nang, 500) ThenBlock: {
                            ArraySet(angs, nang, ang)
                            nang = Add(nang, 1)
                        }
                    }
                }
                // endpoint 1
                px = Float_Add(acx, Float_Mul(ar, CAD_Geom.Cos(aa1)))
                py = Float_Add(acy, Float_Mul(ar, CAD_Geom.Sin(aa1)))
                ddx = Float_Sub(px, cx)
                ddy = Float_Sub(py, cy)
                dist = CAD_Num.Sqrt(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)))
                IfCondition EqualTo(Float_Le(Float_Sub(dist, rad), 0), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(0, Float_Sub(dist, rad)), Float_Mul(rad, 0x3F847AE147AE147B)), 1) ThenBlock: {
                        ang = CAD_Geom.Atan2(ddy, ddx)
                        IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0, ang), eps), 0) ThenBlock: {
                                ang = Float_Add(ang, two_pi)
                            }
                        }
                        IfCondition LessThan(nang, 500) ThenBlock: {
                            ArraySet(angs, nang, ang)
                            nang = Add(nang, 1)
                        }
                    }
                }
                IfCondition EqualTo(Float_Le(rad, dist), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(dist, rad), Float_Mul(rad, 0x3F847AE147AE147B)), 1) ThenBlock: {
                        ang = CAD_Geom.Atan2(ddy, ddx)
                        IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0, ang), eps), 0) ThenBlock: {
                                ang = Float_Add(ang, two_pi)
                            }
                        }
                        IfCondition LessThan(nang, 500) ThenBlock: {
                            ArraySet(angs, nang, ang)
                            nang = Add(nang, 1)
                        }
                    }
                }
                aj = Add(aj, 1)
            }
            // no intersections → delete whole circle (nothing to cut back to)
            IfCondition LessThan(nang, 2) ThenBlock: {
                Deallocate(angs, 512)
                CAD_Sketch.DeleteCircle(CadApp.sketch, best_idx)
                CAD_Sketch.RebuildAnchors(CadApp.sketch)
                CadApp.dirty = 1
                CA_InvalidateProfiles()
                CA_Log("cad_app: trimmed full circle\n", 28)
                ReturnValue(1)
            }
            // sort angles
            a = 0
            WhileLoop LessThan(a, nang) {
                bb = Add(a, 1)
                WhileLoop LessThan(bb, nang) {
                    va = ArrayGet(angs, a)
                    vb = ArrayGet(angs, bb)
                    IfCondition EqualTo(Float_Le(vb, va), 1) ThenBlock: {
                        ArraySet(angs, a, vb)
                        ArraySet(angs, bb, va)
                    }
                    bb = Add(bb, 1)
                }
                a = Add(a, 1)
            }
            // unique angles into work list (compact in place)
            uangs = Allocate(512)
            nu = 0
            prev = ArrayGet(angs, 0)
            ArraySet(uangs, 0, prev)
            nu = 1
            k = 1
            WhileLoop LessThan(k, nang) {
                cur = ArrayGet(angs, k)
                dt = Float_Sub(cur, prev)
                IfCondition EqualTo(Float_Le(dt, eps), 0) ThenBlock: {
                    ArraySet(uangs, nu, cur)
                    nu = Add(nu, 1)
                    prev = cur
                }
                k = Add(k, 1)
            }
            // wrap: if first≈last+2π gap ok; need ≥2 unique
            IfCondition LessThan(nu, 2) ThenBlock: {
                Deallocate(angs, 512)
                Deallocate(uangs, 512)
                CAD_Sketch.DeleteCircle(CadApp.sketch, best_idx)
                CAD_Sketch.RebuildAnchors(CadApp.sketch)
                CadApp.dirty = 1
                CA_InvalidateProfiles()
                CA_Log("cad_app: trimmed full circle\n", 28)
                ReturnValue(1)
            }
            // emit arcs for every sector EXCEPT the one containing click
            // sector k is CCW [uangs[k] → uangs[k+1]] (last wraps to first)
            k = 0
            WhileLoop LessThan(k, nu) {
                sa0 = ArrayGet(uangs, k)
                sa1 = ArrayGet(uangs, 0)
                IfCondition LessThan(Add(k, 1), nu) ThenBlock: {
                    sa1 = ArrayGet(uangs, Add(k, 1))
                }
                // sector span CCW sa0→sa1
                sspan = Float_Sub(sa1, sa0)
                IfCondition EqualTo(Float_Le(sspan, 0), 1) ThenBlock: {
                    sspan = Float_Add(sspan, two_pi)
                }
                // is click in this sector?  dang in [0, sspan)
                dang = Float_Sub(click_ang, sa0)
                IfCondition EqualTo(Float_Le(dang, 0), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(0, dang), eps), 0) ThenBlock: {
                        dang = Float_Add(dang, two_pi)
                    }
                }
                in_sec = 0
                // dang ≈ 0 counts as start of this sector
                IfCondition EqualTo(Float_Le(Float_Sub(0, dang), eps), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(dang, eps), 1) ThenBlock: { in_sec = 1 }
                }
                // 0 < dang < sspan
                IfCondition EqualTo(Float_Le(dang, 0), 0) ThenBlock: {
                    IfCondition EqualTo(Float_Le(sspan, dang), 0) ThenBlock: { in_sec = 1 }
                }
                IfCondition EqualTo(in_sec, 0) ThenBlock: {
                    // keep this arc (true curve entity — not polyline)
                    CAD_Sketch.AddArc(CadApp.sketch, cx, cy, rad, sa0, sa1)
                }
                k = Add(k, 1)
            }
            CAD_Sketch.DeleteCircle(CadApp.sketch, best_idx)
            Deallocate(angs, 512)
            Deallocate(uangs, 512)
            // also split lines so they end at the (former) circle joins
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CAD_Sketch.SplitAtIntersections(CadApp.sketch)
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            CA_Log("cad_app: trimmed circle→arcs\n", 28)
            ReturnValue(1)
        }

        // ========== ARC: split at joins, drop sub-arc under click ==========
        IfCondition EqualTo(best_kind, 3) ThenBlock: {
            arcs = CAD_Store.Read(CadApp.sketch, 11)
            base = Multiply(best_idx, 5)
            cx = ArrayGet(arcs, base)
            cy = ArrayGet(arcs, Add(base, 1))
            rad = ArrayGet(arcs, Add(base, 2))
            a0 = ArrayGet(arcs, Add(base, 3))
            a1 = ArrayGet(arcs, Add(base, 4))
            span = Float_Sub(a1, a0)
            IfCondition EqualTo(Float_Le(span, 0), 1) ThenBlock: {
                span = Float_Add(span, two_pi)
            }
            click_ang = CAD_Geom.Atan2(Float_Sub(wy, cy), Float_Sub(wx, cx))
            // collect split params t in (0,1) along arc
            ts = Allocate(512)
            ArraySet(ts, 0, 0)
            ArraySet(ts, 1, one)
            nt = 2
            // lines × this arc
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            lines = CAD_Store.Read(CadApp.sketch, 1)
            li = 0
            WhileLoop LessThan(li, nl) {
                b = Multiply(li, 4)
                x0 = ArrayGet(lines, b)
                y0 = ArrayGet(lines, Add(b, 1))
                x1 = ArrayGet(lines, Add(b, 2))
                y1 = ArrayGet(lines, Add(b, 3))
                dx = Float_Sub(x1, x0)
                dy = Float_Sub(y1, y0)
                fx = Float_Sub(x0, cx)
                fy = Float_Sub(y0, cy)
                aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                    bb = Float_Mul(0x4000000000000000, Float_Add(Float_Mul(fx, dx), Float_Mul(fy, dy)))
                    cc = Float_Sub(Float_Add(Float_Mul(fx, fx), Float_Mul(fy, fy)), Float_Mul(rad, rad))
                    disc = Float_Sub(Float_Mul(bb, bb), Float_Mul(Float_Mul(0x4010000000000000, aa), cc))
                    IfCondition EqualTo(Float_Le(disc, 0), 0) ThenBlock: {
                        s = CAD_Num.Sqrt(disc)
                        two_a = Float_Mul(0x4000000000000000, aa)
                        ht0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                        ht1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                        hi = 0
                        WhileLoop LessThan(hi, 2) {
                            tline = ht0
                            IfCondition EqualTo(hi, 1) ThenBlock: { tline = ht1 }
                            ok = 1
                            IfCondition EqualTo(Float_Le(tline, 0), 1) ThenBlock: {
                                IfCondition EqualTo(Float_Le(Float_Sub(0, tline), eps), 0) ThenBlock: { ok = 0 }
                            }
                            IfCondition EqualTo(Float_Le(one, tline), 1) ThenBlock: {
                                IfCondition EqualTo(Float_Le(Float_Sub(tline, one), eps), 0) ThenBlock: { ok = 0 }
                            }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                px = Float_Add(x0, Float_Mul(tline, dx))
                                py = Float_Add(y0, Float_Mul(tline, dy))
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                dang = Float_Sub(ang, a0)
                                IfCondition EqualTo(Float_Le(dang, 0), 1) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(Float_Sub(0, dang), eps), 0) ThenBlock: {
                                        dang = Float_Add(dang, two_pi)
                                    }
                                }
                                IfCondition EqualTo(Float_Le(0, dang), 1) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: {
                                        tt = 0
                                        IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                                            tt = Float_Div(dang, span)
                                        }
                                        IfCondition EqualTo(Float_Le(tt, eps), 0) ThenBlock: {
                                            IfCondition EqualTo(Float_Le(Float_Sub(one, tt), eps), 0) ThenBlock: {
                                                IfCondition LessThan(nt, 500) ThenBlock: {
                                                    ArraySet(ts, nt, tt)
                                                    nt = Add(nt, 1)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            hi = Add(hi, 1)
                        }
                    }
                }
                li = Add(li, 1)
            }
            // sort t
            a = 0
            WhileLoop LessThan(a, nt) {
                bb = Add(a, 1)
                WhileLoop LessThan(bb, nt) {
                    va = ArrayGet(ts, a)
                    vb = ArrayGet(ts, bb)
                    IfCondition EqualTo(Float_Le(vb, va), 1) ThenBlock: {
                        ArraySet(ts, a, vb)
                        ArraySet(ts, bb, va)
                    }
                    bb = Add(bb, 1)
                }
                a = Add(a, 1)
            }
            // click param on arc
            dang = Float_Sub(click_ang, a0)
            IfCondition EqualTo(Float_Le(dang, 0), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(Float_Sub(0, dang), eps), 0) ThenBlock: {
                    dang = Float_Add(dang, two_pi)
                }
            }
            click_t = 0
            IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                click_t = Float_Div(dang, span)
            }
            // emit kept sub-arcs, delete original
            CAD_Sketch.DeleteArc(CadApp.sketch, best_idx)
            prev = ArrayGet(ts, 0)
            k = 1
            WhileLoop LessThan(k, nt) {
                cur = ArrayGet(ts, k)
                dt = Float_Sub(cur, prev)
                IfCondition EqualTo(Float_Le(dt, 0x3F1A36E2EB1C432D), 0) ThenBlock: {
                    // keep if click_t not strictly inside (prev, cur)
                    keep = 1
                    IfCondition EqualTo(Float_Le(prev, click_t), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(click_t, cur), 1) ThenBlock: {
                            // interior of this piece
                            IfCondition EqualTo(Float_Le(Float_Sub(click_t, prev), eps), 0) ThenBlock: {
                                IfCondition EqualTo(Float_Le(Float_Sub(cur, click_t), eps), 0) ThenBlock: {
                                    keep = 0
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(keep, 1) ThenBlock: {
                        ang0 = Float_Add(a0, Float_Mul(span, prev))
                        ang1 = Float_Add(a0, Float_Mul(span, cur))
                        CAD_Sketch.AddArc(CadApp.sketch, cx, cy, rad, ang0, ang1)
                    }
                    prev = cur
                }
                k = Add(k, 1)
            }
            Deallocate(ts, 512)
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CAD_Sketch.SplitAtIntersections(CadApp.sketch)
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            CA_Log("cad_app: trimmed arc\n", 21)
            ReturnValue(1)
        }

        CA_Log("cad_app: trim miss\n", 19)
        ReturnValue(0)
    }
}

// Click: sketch tools in sketch mode; nav cube in 3D mode
// Pick/Trim force sketch mode so 3D mode does not swallow selection clicks.
Function.CA_OnClick {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        // Pick / Trim always work (switch out of 3D first)
        IfCondition EqualTo(CadApp.tool, 4) ThenBlock: {
            CadApp.mode = 1
            IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                CadApp.sketch = CAD_Sketch.CreateSketch(1)
            }
            xy = Allocate(32)
            CA_PixToWorld(px, py, xy)
            CA_PickProfileAt(ArrayGet(xy, 0), ArrayGet(xy, 1), CadApp.click_shift)
            CadApp.click_shift = 0
            Deallocate(xy, 32)
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CA_PublishFrame()
            ReturnValue(0)
        }
        IfCondition EqualTo(CadApp.tool, 5) ThenBlock: {
            CadApp.mode = 1
            IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                CadApp.sketch = CAD_Sketch.CreateSketch(1)
            }
            xy = Allocate(32)
            CA_PixToWorld(px, py, xy)
            CA_TrimAt(ArrayGet(xy, 0), ArrayGet(xy, 1))
            Deallocate(xy, 32)
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CA_PublishFrame()
            ReturnValue(0)
        }
        // 3D: nav cube face?
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
            hit = CAD_View.HitNavCube(px, py, CadApp.width, CadApp.height_px)
            IfCondition GreaterEqual(hit, 0) ThenBlock: {
                CadApp.view = hit
                CAD_View.SetViewMode(hit)
                CA_PublishFrame()
                ReturnValue(0)
            }
            ReturnValue(0)
        }
        // sketch mode
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
        }
        xy = Allocate(32)
        CA_PixToWorld(px, py, xy)
        wx = ArrayGet(xy, 0)
        wy = ArrayGet(xy, 1)
        // snap to existing endpoints / close poly
        sn = Allocate(32)
        CA_SnapWorld(wx, wy, sn)
        wx = ArrayGet(sn, 0)
        wy = ArrayGet(sn, 1)
        Deallocate(sn, 32)
        Deallocate(xy, 32)
        nc = CadApp.nclick
        IfCondition EqualTo(nc, 0) ThenBlock: {
            CadApp.cx0 = wx
            CadApp.cy0 = wy
            CadApp.nclick = 1
            CA_PublishFrame()
            ReturnValue(0)
        }
        IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
            CAD_Sketch.AddLine(CadApp.sketch, CadApp.cx0, CadApp.cy0, wx, wy)
            // refresh anchors (ends + any touch/cross with existing)
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            // chain: next segment starts at this tip
            CadApp.cx0 = wx
            CadApp.cy0 = wy
            CadApp.nclick = 1
            CA_Log("cad_app: line added (chain on)\n", 28)
            CA_PublishFrame()
            ReturnValue(0)
        }
        IfCondition EqualTo(CadApp.tool, 1) ThenBlock: {
            x0 = CadApp.cx0
            y0 = CadApp.cy0
            x1 = wx
            y1 = wy
            CAD_Sketch.AddLine(CadApp.sketch, x0, y0, x1, y0)
            CAD_Sketch.AddLine(CadApp.sketch, x1, y0, x1, y1)
            CAD_Sketch.AddLine(CadApp.sketch, x1, y1, x0, y1)
            CAD_Sketch.AddLine(CadApp.sketch, x0, y1, x0, y0)
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            CA_Log("cad_app: rect added\n", 20)
        }
        IfCondition EqualTo(CadApp.tool, 2) ThenBlock: {
            dx = Float_Sub(wx, CadApp.cx0)
            dy = Float_Sub(wy, CadApp.cy0)
            rad = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
            IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 0) ThenBlock: {
                CAD_Sketch.AddCircle(CadApp.sketch, CadApp.cx0, CadApp.cy0, rad)
                CadApp.dirty = 1
                CA_InvalidateProfiles()
                CA_Log("cad_app: circle added\n", 22)
            }
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CA_PublishFrame()
            ReturnValue(0)
        }
        // arc: click1 center, click2 start (radius+a0), click3 end (a1)
        IfCondition EqualTo(CadApp.tool, 3) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                // second click = start point on arc
                dx = Float_Sub(wx, CadApp.cx0)
                dy = Float_Sub(wy, CadApp.cy0)
                CadApp.arc_rad = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                CadApp.arc_a0 = CAD_Geom.Atan2(dy, dx)
                CadApp.nclick = 2
                CA_PublishFrame()
                ReturnValue(0)
            }
            IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: {
                dx = Float_Sub(wx, CadApp.cx0)
                dy = Float_Sub(wy, CadApp.cy0)
                a1 = CAD_Geom.Atan2(dy, dx)
                IfCondition EqualTo(CAD_Num.IsZero(CadApp.arc_rad, 0), 0) ThenBlock: {
                    CAD_Sketch.AddArc(CadApp.sketch, CadApp.cx0, CadApp.cy0, CadApp.arc_rad, CadApp.arc_a0, a1)
                    CAD_Sketch.RebuildAnchors(CadApp.sketch)
                    CadApp.dirty = 1
                    CA_InvalidateProfiles()
                    CA_Log("cad_app: arc added\n", 19)
                }
                CadApp.nclick = 0
                CadApp.hover_ok = 0
                CA_PublishFrame()
                ReturnValue(0)
            }
        }
        CadApp.nclick = 0
        CadApp.hover_ok = 0
        CA_PublishFrame()
        ReturnValue(0)
    }
}

// Hover for rubber-band (sketch mode only redraws when placing second point).
Function.CA_OnHover {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        CadApp.hover_px = px
        CadApp.hover_py = py
        CadApp.hover_ok = 1
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
            IfCondition GreaterThan(CadApp.nclick, 0) ThenBlock: {
                CA_PublishFrame()
            }
        }
        ReturnValue(0)
    }
}

// Cancel in-progress tool (second click pending).
Function.CA_CancelTool {
    Output: Integer
    Body: {
        CadApp.nclick = 0
        CadApp.hover_ok = 0
        CA_Log("cad_app: tool cancel\n", 20)
        ReturnValue(0)
    }
}

// Write tool strip state for host: mode tool nclick dirty
Function.CA_WriteToolFile {
    Output: Integer
    Body: {
        sb = Allocate(32)
        // single line: "M T N D\n"
        SetByte(sb, 0, Add(48, CadApp.mode))
        SetByte(sb, 1, 32)
        SetByte(sb, 2, Add(48, CadApp.tool))
        SetByte(sb, 3, 32)
        SetByte(sb, 4, Add(48, CadApp.nclick))
        SetByte(sb, 5, 32)
        SetByte(sb, 6, Add(48, CadApp.dirty))
        SetByte(sb, 7, 10)
        SetByte(sb, 8, 0)
        fd = SystemCall(2, "/tmp/cad_app/tool.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, sb, 8)
            SystemCall(3, fd, 0, 0)
        }
        Deallocate(sb, 32)
        ReturnValue(0)
    }
}

// Parse signed int at buf[i], write value to out_addr[0], return new index or -1
Function.CA_ParseSigned {
    Input: buf: Address
    Input: i: Integer
    Input: out_addr: Address
    Output: Integer
    Body: {
        WhileLoop EqualTo(GetByte(buf, i), 32) {
            i = Add(i, 1)
            IfCondition GreaterThan(i, 70) ThenBlock: { ReturnValue(-1) }
        }
        neg = 0
        IfCondition EqualTo(GetByte(buf, i), 45) ThenBlock: {
            neg = 1
            i = Add(i, 1)
        }
        val = 0
        got = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            ch = GetByte(buf, i)
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: {
                    val = Add(Multiply(val, 10), Subtract(ch, 48))
                    got = 1
                    i = Add(i, 1)
                }
                IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
                IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            }
            IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
            IfCondition GreaterThan(i, 70) ThenBlock: { done = 1 }
        }
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(neg, 1) ThenBlock: { val = Subtract(0, val) }
        ArraySet(out_addr, 0, val)
        ReturnValue(i)
    }
}

// Parse "click N M" — returns 1 if click handled
Function.CA_TryParseClick {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        // need "click "
        IfCondition LessThan(n, 8) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 0), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 1), 108) ThenBlock: { ReturnValue(0) }
        // parse ints after "click "
        i = 6
        // skip spaces
        WhileLoop LessThan(i, n) {
            IfCondition NotEqual(GetByte(buf, i), 32) ThenBlock: {
                // break by setting flag
                i2 = i
                i = n
            }
            IfCondition LessThan(i, n) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, i), 32) ThenBlock: { i = Add(i, 1) }
            }
        }
        i = 6
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(GetByte(buf, i), 32) ThenBlock: { i = Add(i, 1) }
            IfCondition NotEqual(GetByte(buf, i), 32) ThenBlock: {
                // fall through
                i = i
            }
            IfCondition GreaterThan(i, 5) ThenBlock: {
                IfCondition NotEqual(GetByte(buf, i), 32) ThenBlock: {
                    // parse
                    i = i
                }
            }
        }
        // simpler: fixed parse from index 6
        i = 6
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(GetByte(buf, i), 32) ThenBlock: { i = Add(i, 1) }
            IfCondition NotEqual(GetByte(buf, i), 32) ThenBlock: {
                // start digits
                px = 0
                WhileLoop LessThan(i, n) {
                    ch = GetByte(buf, i)
                    IfCondition LessThan(ch, 48) ThenBlock: { i = n }
                    IfCondition GreaterThan(ch, 57) ThenBlock: {
                        IfCondition GreaterEqual(ch, 48) ThenBlock: {
                            IfCondition LessEqual(ch, 57) ThenBlock: {
                                // digit
                            }
                        }
                    }
                    IfCondition LessThan(i, n) ThenBlock: {
                        ch = GetByte(buf, i)
                        IfCondition GreaterEqual(ch, 48) ThenBlock: {
                            IfCondition LessEqual(ch, 57) ThenBlock: {
                                px = Add(Multiply(px, 10), Subtract(ch, 48))
                                i = Add(i, 1)
                            }
                            IfCondition GreaterThan(ch, 57) ThenBlock: { i = n }
                            IfCondition LessThan(ch, 48) ThenBlock: { i = n }
                        }
                        IfCondition LessThan(ch, 48) ThenBlock: { i = n }
                    }
                }
                // skip spaces
                j = 6
                // re-parse cleanly
                j = 6
                WhileLoop EqualTo(GetByte(buf, j), 32) {
                    j = Add(j, 1)
                    IfCondition GreaterThan(j, n) ThenBlock: { j = n }
                }
                px = 0
                WhileLoop LessThan(j, n) {
                    ch = GetByte(buf, j)
                    IfCondition GreaterEqual(ch, 48) ThenBlock: {
                        IfCondition LessEqual(ch, 57) ThenBlock: {
                            px = Add(Multiply(px, 10), Subtract(ch, 48))
                            j = Add(j, 1)
                        }
                        IfCondition GreaterThan(ch, 57) ThenBlock: { j = n }
                        IfCondition LessThan(ch, 48) ThenBlock: { j = n }
                    }
                    IfCondition LessThan(ch, 48) ThenBlock: { j = n }
                    IfCondition GreaterThan(ch, 57) ThenBlock: {
                        IfCondition LessThan(ch, 48) ThenBlock: { j = n }
                    }
                }
                // after first number, j may be past end due to break — rescan
                j = 6
                WhileLoop LessThan(j, n) {
                    IfCondition EqualTo(GetByte(buf, j), 32) ThenBlock: { j = Add(j, 1) }
                    IfCondition NotEqual(GetByte(buf, j), 32) ThenBlock: {
                        // mark
                        j = j
                    }
                }
                ReturnValue(0)
            }
        }
        ReturnValue(0)
    }
}

// Clean integer parse: "click X Y"
Function.CA_ParseClick {
    Input: buf: Address
    Output: Integer
    Body: {
        // verify prefix click
        IfCondition NotEqual(GetByte(buf, 0), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 1), 108) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 2), 105) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 3), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 4), 107) ThenBlock: { ReturnValue(0) }
        i = 5
        WhileLoop EqualTo(GetByte(buf, i), 32) {
            i = Add(i, 1)
            IfCondition GreaterThan(i, 60) ThenBlock: { ReturnValue(0) }
        }
        px = 0
        got = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            ch = GetByte(buf, i)
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: {
                    px = Add(Multiply(px, 10), Subtract(ch, 48))
                    got = 1
                    i = Add(i, 1)
                }
                IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
                IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            }
            IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
            IfCondition GreaterThan(i, 60) ThenBlock: { done = 1 }
        }
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        WhileLoop EqualTo(GetByte(buf, i), 32) {
            i = Add(i, 1)
            IfCondition GreaterThan(i, 60) ThenBlock: { ReturnValue(0) }
        }
        py = 0
        got = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            ch = GetByte(buf, i)
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: {
                    py = Add(Multiply(py, 10), Subtract(ch, 48))
                    got = 1
                    i = Add(i, 1)
                }
                IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
                IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            }
            IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
            IfCondition GreaterThan(i, 60) ThenBlock: { done = 1 }
        }
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        // optional third int: shift (1 = multi-select toggle)
        CadApp.click_shift = 0
        WhileLoop EqualTo(GetByte(buf, i), 32) {
            i = Add(i, 1)
            IfCondition GreaterThan(i, 70) ThenBlock: { i = 71 }
        }
        IfCondition LessThan(i, 70) ThenBlock: {
            ch = GetByte(buf, i)
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: {
                    CadApp.click_shift = Subtract(ch, 48)
                }
            }
        }
        CA_OnClick(px, py)
        ReturnValue(1)
    }
}

Function.CA_PollCmd {
    Output: Integer
    Body: {
        fd = SystemCall(2, "/tmp/cad_app/cmd.txt", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(80)
        n = SystemCall(0, fd, buf, 79)
        SystemCall(3, fd, 0, 0)
        fd2 = SystemCall(2, "/tmp/cad_app/cmd.txt", 577, 420)
        IfCondition GreaterEqual(fd2, 0) ThenBlock: { SystemCall(3, fd2, 0, 0) }
        IfCondition LessThan(n, 1) ThenBlock: {
            Deallocate(buf, 80)
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        // orbit dx dy
        IfCondition EqualTo(GetByte(buf, 0), 111) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 114) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 98) ThenBlock: {
                    out = Allocate(16)
                    i = CA_ParseSigned(buf, 5, out)
                    ok = 0
                    dx = 0
                    dy = 0
                    IfCondition GreaterThan(i, 0) ThenBlock: {
                        dx = ArrayGet(out, 0)
                        j = CA_ParseSigned(buf, i, out)
                        IfCondition GreaterThan(j, 0) ThenBlock: {
                            dy = ArrayGet(out, 0)
                            ok = 1
                        }
                    }
                    Deallocate(out, 16)
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        CAD_View.OrbitPixels(dx, dy)
                        CadApp.mode = 0
                        CA_PublishFrame()
                        CA_Log("cad_app: orbit\n", 16)
                    }
                    Deallocate(buf, 80)
                    ReturnValue(2)
                }
            }
        }
        // zoom N — sketch: sk_zoom; 3D: view zoom
        IfCondition EqualTo(GetByte(buf, 0), 122) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                out = Allocate(16)
                i = CA_ParseSigned(buf, 4, out)
                zs = 0
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    zs = ArrayGet(out, 0)
                    IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
                        IfCondition EqualTo(CadApp.sk_zoom, 0) ThenBlock: {
                            CadApp.sk_zoom = 0x3FF0000000000000
                        }
                        zin = 0x3FF2666666666666
                        zout = 0x3FEBD37A6F4DE9BE
                        zmin = 0x3FB999999999999A
                        zmax = 0x4034000000000000
                        s = 0
                        WhileLoop LessThan(s, 64) {
                            IfCondition EqualTo(zs, 0) ThenBlock: { s = 64 }
                            IfCondition GreaterThan(zs, 0) ThenBlock: {
                                CadApp.sk_zoom = Float_Mul(CadApp.sk_zoom, zin)
                                zs = Subtract(zs, 1)
                            }
                            IfCondition LessThan(zs, 0) ThenBlock: {
                                CadApp.sk_zoom = Float_Mul(CadApp.sk_zoom, zout)
                                zs = Add(zs, 1)
                            }
                            s = Add(s, 1)
                        }
                        IfCondition EqualTo(Float_Le(CadApp.sk_zoom, zmin), 1) ThenBlock: {
                            CadApp.sk_zoom = zmin
                        }
                        IfCondition EqualTo(Float_Le(zmax, CadApp.sk_zoom), 1) ThenBlock: {
                            CadApp.sk_zoom = zmax
                        }
                        CA_Log("cad_app: sketch zoom\n", 22)
                    }
                    IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
                        CAD_View.ZoomSteps(zs)
                        CA_Log("cad_app: zoom\n", 15)
                    }
                    CA_PublishFrame()
                }
                Deallocate(out, 16)
                Deallocate(buf, 80)
                ReturnValue(2)
            }
        }
        // pan dx dy (pixel deltas from sketch hold-drag)
        IfCondition EqualTo(GetByte(buf, 0), 112) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 97) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 110) ThenBlock: {
                    out = Allocate(16)
                    i = CA_ParseSigned(buf, 3, out)
                    IfCondition GreaterThan(i, 0) ThenBlock: {
                        pdx = ArrayGet(out, 0)
                        j = CA_ParseSigned(buf, i, out)
                        IfCondition GreaterThan(j, 0) ThenBlock: {
                            pdy = ArrayGet(out, 0)
                            CA_UpdateSketchCam()
                            sc = CadApp.scale
                            IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
                                sc = 0x3FF0000000000000
                            }
                            // drag right → view moves right → pan center moves left in world
                            CadApp.sk_pan_x = Float_Sub(CadApp.sk_pan_x, Float_Div(Float_FromInt(pdx), sc))
                            CadApp.sk_pan_y = Float_Add(CadApp.sk_pan_y, Float_Div(Float_FromInt(pdy), sc))
                            CadApp.mode = 1
                            CA_PublishFrame()
                        }
                    }
                    Deallocate(out, 16)
                    Deallocate(buf, 80)
                    ReturnValue(2)
                }
            }
        }
        // hover x y (rubber-band)
        IfCondition EqualTo(GetByte(buf, 0), 104) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                out = Allocate(16)
                i = CA_ParseSigned(buf, 5, out)
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    hx = ArrayGet(out, 0)
                    j = CA_ParseSigned(buf, i, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        hy = ArrayGet(out, 0)
                        CA_OnHover(hx, hy)
                    }
                }
                Deallocate(out, 16)
                Deallocate(buf, 80)
                ReturnValue(2)
            }
        }
        // click
        IfCondition EqualTo(CA_ParseClick(buf), 1) ThenBlock: {
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        c0 = GetByte(buf, 0)
        IfCondition EqualTo(c0, 113) ThenBlock: {
            Deallocate(buf, 80)
            ReturnValue(1)
        }
        // mode
        IfCondition EqualTo(c0, 109) ThenBlock: {
            CadApp.mode = Subtract(1, CadApp.mode)
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // tool_line / tool_rect / tool_circ / tool_arc / tool_pick / tool_trim
        IfCondition EqualTo(c0, 116) ThenBlock: {
            // tool_
            t = GetByte(buf, 5)
            IfCondition EqualTo(t, 108) ThenBlock: { CadApp.tool = 0 }
            IfCondition EqualTo(t, 114) ThenBlock: { CadApp.tool = 1 }
            IfCondition EqualTo(t, 99) ThenBlock: { CadApp.tool = 2 }
            IfCondition EqualTo(t, 97) ThenBlock: { CadApp.tool = 3 }
            // tool_pick — enter pick mode; project only if no profiles yet
            // (rebuilding every Pick click wiped selection → "pad FAIL no select")
            IfCondition EqualTo(t, 112) ThenBlock: {
                CadApp.tool = 4
                CadApp.mode = 1
                CadApp.solid = 0
                skn = 0
                IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                    skn = CAD_Store.Read(CadApp.sketch, 12)
                }
                IfCondition EqualTo(skn, 0) ThenBlock: {
                    CA_RebuildProfiles()
                }
                IfCondition GreaterThan(skn, 0) ThenBlock: {
                    CadApp.nprof = skn
                    CA_Log("cad_app: Pick — click red/white ring; Shift+click multi\n", 54)
                    CA_Log("  if none: Trim stubs past crossings, Profiles again\n", 53)
                }
            }
            // tool_trim
            IfCondition EqualTo(t, 116) ThenBlock: { CadApp.tool = 5 }
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CadApp.mode = 1
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // profiles — rebuild closed loops for pick/highlight (no extrude)
        IfCondition EqualTo(c0, 112) ThenBlock: {
            // "profiles" or "prof" — not "p" save alone handled later
            IfCondition EqualTo(GetByte(buf, 1), 114) ThenBlock: {
                CadApp.mode = 1
                CadApp.solid = 0
                // drop 3D body so green sketch profiles are visible
                CA_RebuildProfiles()
                CA_PublishFrame()
                Deallocate(buf, 80)
                ReturnValue(2)
            }
        }
        // clear model tree / last pad (cmd "clear")
        IfCondition EqualTo(c0, 99) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 108) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 101) ThenBlock: {
                    CA_ClearModel()
                    CadApp.dirty = 1
                    CA_Log("cad_app: model tree cleared\n", 28)
                    CA_PublishFrame()
                    Deallocate(buf, 80)
                    ReturnValue(2)
                }
            }
        }
        // new document
        IfCondition EqualTo(c0, 110) ThenBlock: {
            // newdoc vs new sketch: "newdoc" or plain n
            IfCondition EqualTo(GetByte(buf, 1), 101) ThenBlock: {
                // "new..." -> DocNew if newdoc, else NewSketch
                IfCondition EqualTo(GetByte(buf, 3), 100) ThenBlock: {
                    CA_DocNew()
                }
                IfCondition NotEqual(GetByte(buf, 3), 100) ThenBlock: {
                    CA_DocNew()
                }
            }
            IfCondition NotEqual(GetByte(buf, 1), 101) ThenBlock: {
                CA_DocNew()
            }
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // repad / reload  (both start with 'r')
        IfCondition EqualTo(c0, 114) ThenBlock: {
            // reload if third char is 'l'
            IfCondition EqualTo(GetByte(buf, 2), 108) ThenBlock: {
                CA_ReloadDxf()
            }
            IfCondition NotEqual(GetByte(buf, 2), 108) ThenBlock: {
                CA_PadFromSketch()
            }
            CadApp.mode = 0
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // cut (u or "cut")
        IfCondition EqualTo(c0, 117) ThenBlock: {
            CA_CutFromSketch()
            CadApp.mode = 0
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        IfCondition EqualTo(c0, 99) ThenBlock: {
            // "cut ..." vs click — click already handled; "cut" alone
            IfCondition EqualTo(GetByte(buf, 1), 117) ThenBlock: {
                CA_CutFromSketch()
                CadApp.mode = 0
                CA_PublishFrame()
                Deallocate(buf, 80)
                ReturnValue(2)
            }
        }
        // y / Next = cycle pad profile selection (explicit user choice)
        IfCondition EqualTo(c0, 121) ThenBlock: {
            CadApp.mode = 1
            CadApp.solid = 0
            skn = 0
            IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                skn = CAD_Store.Read(CadApp.sketch, 12)
            }
            IfCondition EqualTo(skn, 0) ThenBlock: {
                CA_RebuildProfiles()
                skn = CadApp.nprof
            }
            IfCondition EqualTo(skn, 0) ThenBlock: {
                IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                    skn = CAD_Store.Read(CadApp.sketch, 12)
                }
            }
            IfCondition EqualTo(skn, 0) ThenBlock: {
                CA_Log("cad_app: no profiles to select\n", 30)
            }
            IfCondition GreaterThan(skn, 0) ThenBlock: {
                CadApp.nprof = skn
                // first Next after rebuild starts at 0; further presses cycle
                IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
                    CadApp.prof_sel = 0
                }
                IfCondition EqualTo(CadApp.prof_user, 1) ThenBlock: {
                    CadApp.prof_sel = Add(CadApp.prof_sel, 1)
                    IfCondition GreaterEqual(CadApp.prof_sel, skn) ThenBlock: {
                        CadApp.prof_sel = 0
                    }
                }
                ok = CA_ApplyProfileSel(CadApp.prof_sel, skn, 0)
                IfCondition EqualTo(ok, 0) ThenBlock: {
                    CA_RebuildProfiles()
                    skn = CAD_Store.Read(CadApp.sketch, 12)
                    IfCondition GreaterThan(skn, 0) ThenBlock: {
                        CA_ApplyProfileSel(0, skn, 0)
                        CA_Log("cad_app: re-projected; profile selected\n", 39)
                    }
                }
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    CA_Log("cad_app: Next → profile selected (red)\n", 39)
                }
            }
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // --- document browser ---
        // list / files
        IfCondition EqualTo(c0, 102) ThenBlock: {
            CA_DocList()
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // j = sel next
        IfCondition EqualTo(c0, 106) ThenBlock: {
            CA_DocSelNext()
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // i = sel prev (also "selprev" word)
        IfCondition EqualTo(c0, 105) ThenBlock: {
            CA_DocSelPrev()
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // open (selected)
        IfCondition EqualTo(GetByte(buf, 0), 111) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 112) ThenBlock: {
                CA_DocOpen()
                CadApp.mode = 0
                CA_PublishFrame()
                Deallocate(buf, 80)
                ReturnValue(2)
            }
        }
        // close
        IfCondition EqualTo(c0, 107) ThenBlock: {
            // k = close document
            CA_DocClose()
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        IfCondition EqualTo(c0, 99) ThenBlock: {
            // cancel (ca...) vs close (cl...)
            IfCondition EqualTo(GetByte(buf, 1), 97) ThenBlock: {
                CA_CancelTool()
                CA_PublishFrame()
                Deallocate(buf, 80)
                ReturnValue(2)
            }
            IfCondition EqualTo(GetByte(buf, 1), 108) ThenBlock: {
                CA_DocClose()
                CA_PublishFrame()
                Deallocate(buf, 80)
                ReturnValue(2)
            }
        }
        // put/save to Postgres (p or "save")
        IfCondition EqualTo(c0, 112) ThenBlock: {
            CA_RepoSave()
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        IfCondition EqualTo(c0, 115) ThenBlock: {
            // save vs step: second char 'a' => save
            IfCondition EqualTo(GetByte(buf, 1), 97) ThenBlock: {
                CA_RepoSave()
                CA_PublishFrame()
                Deallocate(buf, 80)
                ReturnValue(2)
            }
        }
        // get/load from Postgres (g or "load") — opens selection if list open
        IfCondition EqualTo(c0, 103) ThenBlock: {
            IfCondition EqualTo(CadApp.list_open, 1) ThenBlock: {
                CA_DocOpen()
            }
            IfCondition EqualTo(CadApp.list_open, 0) ThenBlock: {
                CA_RepoLoad()
            }
            CadApp.mode = 0
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        IfCondition EqualTo(c0, 108) ThenBlock: {
            // load (not tool_line which starts with t)
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                CA_RepoLoad()
                CadApp.mode = 0
                CA_PublishFrame()
                Deallocate(buf, 80)
                ReturnValue(2)
            }
        }
        // wire
        IfCondition EqualTo(c0, 119) ThenBlock: {
            CadApp.wire = Subtract(1, CadApp.wire)
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // view0/1/2 presets
        IfCondition EqualTo(c0, 118) ThenBlock: {
            c4 = GetByte(buf, 4)
            IfCondition EqualTo(c4, 48) ThenBlock: {
                CadApp.view = 0
                CAD_View.SetViewMode(0)
            }
            IfCondition EqualTo(c4, 49) ThenBlock: {
                CadApp.view = 1
                CAD_View.SetViewMode(1)
            }
            IfCondition EqualTo(c4, 50) ThenBlock: {
                CadApp.view = 2
                CAD_View.SetViewMode(2)
            }
            CadApp.mode = 0
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // hinc/hdec
        IfCondition EqualTo(c0, 104) ThenBlock: {
            c1 = GetByte(buf, 1)
            IfCondition EqualTo(c1, 105) ThenBlock: { CadApp.height = Add(CadApp.height, 1) }
            IfCondition EqualTo(c1, 100) ThenBlock: {
                IfCondition GreaterThan(CadApp.height, 1) ThenBlock: {
                    CadApp.height = Subtract(CadApp.height, 1)
                }
            }
            CA_PadFromSketch()
            CadApp.mode = 0
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // step
        IfCondition EqualTo(c0, 115) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                CAD_IO.ExportSTEP(CadApp.solid, "test-stl/cad_app_live.stp")
                CA_Log("cad_app: STEP ok\n", 17)
            }
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // bmp
        IfCondition EqualTo(c0, 98) ThenBlock: {
            CA_PublishFrame()
            CAD_View.SaveFBToBMP("test-stl/cad_app_live.bmp")
            CA_Log("cad_app: BMP ok\n", 16)
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // dxf export
        IfCondition EqualTo(c0, 100) ThenBlock: {
            IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                CAD_DXF.ExportSketch(CadApp.sketch, "test-stl/cad_app_sketch.dxf")
                CA_Log("cad_app: DXF ok\n", 16)
            }
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        Deallocate(buf, 80)
        ReturnValue(0)
    }
}

Function.CA_BuildSchema {
    Output: Address
    Body: {
        s = UtilArgs_NewSchema("cad_app", "Live DXF/sketch → solid viewer")
        UtilArgs_AddField(s, "in", "path", 0, "Input plate/profile DXF", "in")
        UtilArgs_AddField(s, "hole", "path", 0, "Optional hole DXF (through cut)", "hole")
        UtilArgs_AddField(s, "name", "string", 0, "Part name for Postgres save/load", "name")
        UtilArgs_AddField(s, "save", "bool", 0, "Headless: save part to Postgres", "save")
        UtilArgs_AddField(s, "load", "bool", 0, "Headless: load part from Postgres", "load")
        UtilArgs_AddField(s, "height", "int", 0, "Pad / plate thickness mm", "height")
        UtilArgs_AddField(s, "width", "int", 0, "View width", "width")
        UtilArgs_AddField(s, "imgh", "int", 0, "View height", "imgh")
        UtilArgs_AddField(s, "shot", "path", 0, "Headless BMP", "shot")
        UtilArgs_AddField(s, "headless", "bool", 0, "One-shot BMP", "headless")
        UtilArgs_AddField(s, "nohost", "bool", 0, "No X11 host", "nohost")
        UtilArgs_AddField(s, "sketch-demo", "bool", 0, "Headless: build rect sketch and pad", "sketch-demo")
        UtilArgs_SetShort(s, "in", "i")
        UtilArgs_SetShort(s, "hole", "k")
        UtilArgs_SetShort(s, "height", "H")
        UtilArgs_SetShort(s, "width", "W")
        UtilArgs_SetShort(s, "shot", "o")
        // No default DXF — interactive starts empty (diamond looked like stale session data)
        UtilArgs_SetDefault(s, "height", "20")
        UtilArgs_SetDefault(s, "width", "800")
        UtilArgs_SetDefault(s, "imgh", "600")
        UtilArgs_SetDefault(s, "shot", "test-stl/cad_app.bmp")
        ReturnValue(s)
    }
}

SubRoutine.Main {
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    schema = CA_BuildSchema()
    args = UtilArgs_ParseCLI(schema)
    IfCondition EqualTo(args, 0) ThenBlock: {
        CA_Log("cad_app: bad args\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    CadApp.dxf_path = UtilArgs_GetString(args, "in")
    CadApp.hole_path = UtilArgs_GetString(args, "hole")
    CadApp.part_name = UtilArgs_GetString(args, "name")
    do_save = UtilArgs_GetBool(args, "save")
    do_load = UtilArgs_GetBool(args, "load")
    // copy CLI name into owned buffer
    IfCondition NotEqual(CadApp.part_name, 0) ThenBlock: {
        CA_SetPartName(CadApp.part_name)
    }
    IfCondition EqualTo(CadApp.part_name, 0) ThenBlock: {
        CA_EnsureName()
    }
    CadApp.height = UtilArgs_GetInt(args, "height")
    CadApp.width = UtilArgs_GetInt(args, "width")
    CadApp.height_px = UtilArgs_GetInt(args, "imgh")
    shot = UtilArgs_GetString(args, "shot")
    headless = UtilArgs_GetBool(args, "headless")
    nohost = UtilArgs_GetBool(args, "nohost")
    sketch_demo = UtilArgs_GetBool(args, "sketch-demo")
    IfCondition LessEqual(CadApp.height, 0) ThenBlock: { CadApp.height = 10 }
    IfCondition LessThan(CadApp.width, 16) ThenBlock: { CadApp.width = 800 }
    IfCondition LessThan(CadApp.height_px, 16) ThenBlock: { CadApp.height_px = 600 }
    SystemCall(83, "/tmp/cad_app", 493)

    // sketch-demo: programmed rect + pad (M-C gate without mouse)
    IfCondition EqualTo(sketch_demo, 1) ThenBlock: {
        CadApp.sketch = CAD_Sketch.CreateSketch(1)
        CAD_Sketch.AddRectangle(CadApp.sketch, Float_FromInt(-15), Float_FromInt(-10), Float_FromInt(30), Float_FromInt(20))
        IfCondition NotEqual(CA_PadFromSketch(), 0) ThenBlock: {
            CA_Log("cad_app: sketch-demo pad FAIL\n", 30)
            SystemCall(60, 1, 0, 0)
        }
        // also test click path programmatically
        CadApp.mode = 1
        CadApp.tool = 0
        CadApp.nclick = 0
        // second line via OnClick pixels near center
        CA_OnClick(400, 300)
        CA_OnClick(500, 350)
        CAD_DXF.ExportSketch(CadApp.sketch, "test-stl/cad_app_sketch.dxf")
        CAD_View.SetWire(0)
        CAD_View.SetViewMode(0)
        rc = CAD_View.RenderSolidToBMP(CadApp.solid, CadApp.width, CadApp.height_px, shot)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: sketch-demo render FAIL\n", 33)
            SystemCall(60, 1, 0, 0)
        }
        CAD_IO.ExportSTEP(CadApp.solid, "test-stl/cad_app.stp")
        // sketch view BMP
        CadApp.mode = 1
        CA_DrawSketchToFB()
        CAD_View.SaveFBToBMP("test-stl/cad_app_sketch.bmp")
        CA_Log("cad_app: sketch-demo OK\n", 24)
        SystemCall(60, 0, 0, 0)
    }

    // Postgres load (skip DXF file when --load --name)
    IfCondition EqualTo(do_load, 1) ThenBlock: {
        IfCondition NotEqual(CA_RepoLoad(), 0) ThenBlock: {
            CA_Log("cad_app: --load FAIL\n", 22)
            SystemCall(60, 1, 0, 0)
        }
        CadApp.mode = 0
        CAD_View.SetViewMode(0)
        IfCondition EqualTo(headless, 1) ThenBlock: {
            CAD_View.SetWire(0)
            rc = CAD_View.RenderSolidToBMP(CadApp.solid, CadApp.width, CadApp.height_px, shot)
            IfCondition NotEqual(rc, 0) ThenBlock: {
                CA_Log("cad_app: headless render FAIL\n", 30)
                SystemCall(60, 1, 0, 0)
            }
            CAD_IO.ExportSTEP(CadApp.solid, "test-stl/cad_app.stp")
            CA_Log("cad_app: headless load OK\n", 26)
            SystemCall(60, 0, 0, 0)
        }
    }

    // load DXF only when -i path given; otherwise empty sketch (no stale solid)
    IfCondition EqualTo(do_load, 0) ThenBlock: {
        IfCondition NotEqual(CadApp.dxf_path, 0) ThenBlock: {
            // nonempty path string?
            IfCondition NotEqual(GetByte(CadApp.dxf_path, 0), 0) ThenBlock: {
                IfCondition NotEqual(CA_LoadDxfToSketch(), 0) ThenBlock: {
                    CA_Log("cad_app: DXF load FAIL\n", 23)
                    SystemCall(60, 1, 0, 0)
                }
                CadApp.mode = 0
                CAD_View.SetViewMode(0)
            }
            IfCondition EqualTo(GetByte(CadApp.dxf_path, 0), 0) ThenBlock: {
                CA_ClearModel()
                CA_Log("cad_app: empty sketch (no -i DXF)\n", 33)
            }
        }
        IfCondition EqualTo(CadApp.dxf_path, 0) ThenBlock: {
            CA_ClearModel()
            CA_Log("cad_app: empty sketch (no -i DXF)\n", 33)
        }
    }

    IfCondition EqualTo(headless, 1) ThenBlock: {
        CAD_View.SetWire(0)
        CAD_View.SetViewMode(0)
        rc = CAD_View.RenderSolidToBMP(CadApp.solid, CadApp.width, CadApp.height_px, shot)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: headless render FAIL\n", 30)
            SystemCall(60, 1, 0, 0)
        }
        CAD_IO.ExportSTEP(CadApp.solid, "test-stl/cad_app.stp")
        IfCondition EqualTo(do_save, 1) ThenBlock: {
            IfCondition NotEqual(CA_RepoSave(), 0) ThenBlock: {
                CA_Log("cad_app: --save FAIL\n", 22)
                SystemCall(60, 1, 0, 0)
            }
        }
        CA_Log("cad_app: headless OK\n", 21)
        SystemCall(60, 0, 0, 0)
    }

    CA_PublishFrame()
    // Spawn X11/XWayland host.
    // execve envp must not be empty (that strips DISPLAY). Pass DISPLAY + XAUTHORITY.
    IfCondition EqualTo(nohost, 0) ThenBlock: {
        pid = SystemCall(57)
        IfCondition EqualTo(pid, 0) ThenBlock: {
            argv = Allocate(32)
            StoreValue(argv, "./CAD/host/cad_host_x11")
            StoreValue(Add(argv, 8), "/tmp/cad_app")
            StoreValue(Add(argv, 16), 0)
            envp = Allocate(48)
            // DISPLAY=:0
            dstr = Allocate(32)
            ArraySet(dstr, 0, 0x3D59414C50534944)
            // bytes: build "DISPLAY=:0\0"
            SetByte(dstr, 0, 68)
            SetByte(dstr, 1, 73)
            SetByte(dstr, 2, 83)
            SetByte(dstr, 3, 80)
            SetByte(dstr, 4, 76)
            SetByte(dstr, 5, 65)
            SetByte(dstr, 6, 89)
            SetByte(dstr, 7, 61)
            SetByte(dstr, 8, 58)
            SetByte(dstr, 9, 48)
            SetByte(dstr, 10, 0)
            // XAUTHORITY=/home/bob/.Xauthority — use common path
            xstr = Allocate(64)
            // "XAUTHORITY=/home/bob/.Xauthority"
            xa = "XAUTHORITY=/home/bob/.Xauthority"
            // copy string literal if available — build manually short path
            // X A U T H O R I T Y = / h o m e / b o b / . X a u t h o r i t y
            k = 0
            // use a simple known path length 31
            SetByte(xstr, 0, 88)
            SetByte(xstr, 1, 65)
            SetByte(xstr, 2, 85)
            SetByte(xstr, 3, 84)
            SetByte(xstr, 4, 72)
            SetByte(xstr, 5, 79)
            SetByte(xstr, 6, 82)
            SetByte(xstr, 7, 73)
            SetByte(xstr, 8, 84)
            SetByte(xstr, 9, 89)
            SetByte(xstr, 10, 61)
            SetByte(xstr, 11, 47)
            SetByte(xstr, 12, 104)
            SetByte(xstr, 13, 111)
            SetByte(xstr, 14, 109)
            SetByte(xstr, 15, 101)
            SetByte(xstr, 16, 47)
            SetByte(xstr, 17, 98)
            SetByte(xstr, 18, 111)
            SetByte(xstr, 19, 98)
            SetByte(xstr, 20, 47)
            SetByte(xstr, 21, 46)
            SetByte(xstr, 22, 88)
            SetByte(xstr, 23, 97)
            SetByte(xstr, 24, 117)
            SetByte(xstr, 25, 116)
            SetByte(xstr, 26, 104)
            SetByte(xstr, 27, 111)
            SetByte(xstr, 28, 114)
            SetByte(xstr, 29, 105)
            SetByte(xstr, 30, 116)
            SetByte(xstr, 31, 121)
            SetByte(xstr, 32, 0)
            StoreValue(envp, dstr)
            StoreValue(Add(envp, 8), xstr)
            StoreValue(Add(envp, 16), 0)
            SystemCall(59, "./CAD/host/cad_host_x11", argv, envp)
            SystemCall(60, 1, 0, 0)
        }
        CA_Log("cad_app: host spawn attempted (X11/XWayland)\n", 45)
        CA_Log("  if no window: export DISPLAY=:0 && ./CAD/host/cad_host_x11 /tmp/cad_app &\n", 76)
        CA_Log("  then: ./cad_app.x --nohost -i your.dxf -H 10\n", 47)
    }

    CA_Log("cad_app: interactive M-D (LMB orbit, scroll zoom, nav cube)\n", 60)
    // timespec { tv_sec, tv_nsec } — must use StoreValue (byte offsets), not ArraySet
    ts = Allocate(16)
    StoreValue(ts, 0)
    StoreValue(Add(ts, 8), 20000000)
    guard = 0
    WhileLoop EqualTo(CadApp.running, 1) {
        c = CA_PollCmd()
        IfCondition EqualTo(c, 1) ThenBlock: {
            // quit: wipe model so next session cannot revive this solid
            CA_ClearModel()
            CA_PublishFrame()
            CadApp.running = 0
        }
        // re-arm each sleep (kernel may write remainder)
        StoreValue(ts, 0)
        StoreValue(Add(ts, 8), 20000000)
        SystemCall(35, ts, 0)
        guard = Add(guard, 1)
        IfCondition GreaterThan(guard, 45000) ThenBlock: { CadApp.running = 0 }
    }
    Deallocate(ts, 16)
    // shutdown wipe (launcher also clears /tmp/cad_app)
    CA_ClearModel()
    CA_Log("cad_app: quit (state cleared)\n", 30)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
