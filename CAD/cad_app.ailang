// cad_app — live DXF/sketch → solid → view (M-B..D + DXF solid creation)
//
// DXF → solid:
//   ./cad_app.x --headless -i plate.dxf -H 10 -o out.bmp
//   ./cad_app.x --headless -i plate.dxf --hole hole.dxf -H 4 -o out.bmp
//   Multi closed loops in one DXF = outer pad + through holes.
//
// Window (prefer launcher — viewport + tools panel):
//   ./CAD/scripts/run_cad_app.sh -i diamond.dxf -H 20
//   Viewport: orbit / sketch clicks / hover rubber-band / RMB cancel
//   Tools panel: Line/Rect/Circ/Arc/Point/Trim/Pick, Profiles/Next/Solve, Pad, …
//   IPC: /tmp/cad_app/{cmd,status,tool,parts,sel,frame,meta}.txt
//
// Build: ./ailang.x CAD/cad_app.ailang -o cad_app.x

LibraryImport.Arena
LibraryImport.UtilArgs
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_View
LibraryImport.Cad.CAD_Repo
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_Bool
LibraryImport.Display.Render.Framebuffer
LibraryImport.StringUtils

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

// mode 0=3d 1=sketch
// tool 0=line 1=rect 2=circle 3=arc(center) 4=pick 5=trim 6=point 7=cstr 8=fillet 9=arc3
// solid_ops: pad (extrude sketch), plate+hole, cut (ExtrudeCut into solid)
FixedPool.CadApp {
    "solid":     Initialize=0, CanChange=True
    "sketch":    Initialize=0, CanChange=True
    "hole_sk":   Initialize=0, CanChange=True
    "height":    Initialize=10, CanChange=True
    "width":     Initialize=800, CanChange=True
    "height_px": Initialize=600, CanChange=True
    "wire":      Initialize=0, CanChange=True
    "view":      Initialize=0, CanChange=True
    "gen":       Initialize=0, CanChange=True
    "running":   Initialize=1, CanChange=True
    "dxf_path":  Initialize=0, CanChange=True
    "hole_path": Initialize=0, CanChange=True
    "mode":      Initialize=0, CanChange=True
    "tool":      Initialize=0, CanChange=True
    "nclick":    Initialize=0, CanChange=True
    "cx0":       Initialize=0, CanChange=True
    "cy0":       Initialize=0, CanChange=True
    "scale":     Initialize=0, CanChange=True
    "extent":    Initialize=0, CanChange=True
    "nprof":     Initialize=0, CanChange=True
    "dirty":     Initialize=0, CanChange=True
    "part_name": Initialize=0, CanChange=True
    "repo_ok":   Initialize=0, CanChange=True
    "part_rev":  Initialize=0, CanChange=True
    "list_buf":  Initialize=0, CanChange=True
    "list_count":Initialize=0, CanChange=True
    "list_sel":  Initialize=0, CanChange=True
    "list_open": Initialize=0, CanChange=True
    "name_buf":  Initialize=0, CanChange=True
    "hover_px":  Initialize=0, CanChange=True
    "hover_py":  Initialize=0, CanChange=True
    "hover_ok":  Initialize=0, CanChange=True
    "prof_sel":  Initialize=0, CanChange=True
    "prof_user": Initialize=0, CanChange=True
    // bit mask of selected profiles (bit i = profile i); multi Pad via CompoundAdd
    "prof_mask": Initialize=0, CanChange=True
    "click_shift": Initialize=0, CanChange=True
    // PlaneFeature handle for active sketch (0 = world Sketch_0 / XY)
    "plane":     Initialize=0, CanChange=True
    // construction plane list: plane_list addr of 16 handles, plane_n count
    "plane_n":   Initialize=0, CanChange=True
    "plane_list":Initialize=0, CanChange=True
    // 1 = OnTop face-pick mode: next 3D click selects planar face → new sketch
    "face_pick": Initialize=0, CanChange=True
    // show construction planes in 3D (default on)
    "show_planes": Initialize=1, CanChange=True
    // sketch view zoom factor (float bits, 1.0 default)
    "sk_zoom":   Initialize=0, CanChange=True
    "sk_pan_x":  Initialize=0, CanChange=True
    "sk_pan_y":  Initialize=0, CanChange=True
    "auto_pad":  Initialize=0, CanChange=True
    "arc_a0":    Initialize=0, CanChange=True
    "arc_rad":   Initialize=0, CanChange=True
    // last user Point index placed (for DistToOrigin / HUD later)
    "last_upt":  Initialize=-1, CanChange=True
    // constraint pick: tool=7, cstr_type = constraint code (see CAD_Sketch)
    "cstr_type": Initialize=0, CanChange=True
    "cstr_npick":Initialize=0, CanChange=True
    "cstr_ka":   Initialize=0, CanChange=True
    "cstr_ia":   Initialize=0, CanChange=True
    "cstr_kb":   Initialize=0, CanChange=True
    "cstr_ib":   Initialize=0, CanChange=True
    // sketch fillet: default R mm, first line index when pick 1/2
    "fillet_r":  Initialize=0, CanChange=True
    "fillet_li": Initialize=-1, CanChange=True
}

Function.CA_Log {
    Input: msg: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(CAD_Sys.Write(2, msg, n)) }
}

// Projection ring color from sketch-pad background: push toward white on dark
// pads, toward black on light pads (readable delta, not neon on noise).
Function.CA_ProfileProjColor {
    Input: br: Integer
    Input: bg: Integer
    Input: bb: Integer
    Output: Integer
    Body: {
        // luminance ~ (r+g+b)/3
        lum = Divide(Add(Add(br, bg), bb), 3)
        // delta steps the tint away from the pad
        d = 150
        IfCondition LessThan(lum, 128) ThenBlock: {
            // dark pad → light grey-cyan projection
            r = Add(br, d)
            g = Add(bg, d)
            b = Add(bb, Add(d, 20))
            IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
            IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
            IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
            // floor so it never collapses into bg
            IfCondition LessThan(r, 140) ThenBlock: { r = 140 }
            IfCondition LessThan(g, 150) ThenBlock: { g = 150 }
            IfCondition LessThan(b, 170) ThenBlock: { b = 170 }
            ReturnValue(FB_RGB(r, g, b))
        }
        // light pad → charcoal projection
        r = Subtract(br, d)
        g = Subtract(bg, d)
        b = Subtract(bb, d)
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition LessThan(b, 0) ThenBlock: { b = 0 }
        IfCondition GreaterThan(r, 80) ThenBlock: { r = 80 }
        IfCondition GreaterThan(g, 80) ThenBlock: { g = 80 }
        IfCondition GreaterThan(b, 90) ThenBlock: { b = 90 }
        ReturnValue(FB_RGB(r, g, b))
    }
}

Function.CA_WriteFileStr {
    Input: path: Address
    Input: msg: Address
    Input: n: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        SystemCall(1, fd, msg, n)
        SystemCall(3, fd, 0, 0)
        ReturnValue(0)
    }
}

Function.CA_WriteGen {
    Output: Integer
    Body: {
        fd = SystemCall(2, "/tmp/cad_app/gen.txt", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        g = CadApp.gen
        buf = Allocate(32)
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        n = 0
        IfCondition EqualTo(g, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            n = 1
        }
        WhileLoop GreaterThan(g, 0) {
            SetByte(buf, n, Add(48, Modulo(g, 10)))
            n = Add(n, 1)
            g = Divide(g, 10)
        }
        out = Allocate(32)
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(out, i, GetByte(buf, Subtract(Subtract(n, 1), i)))
            i = Add(i, 1)
        }
        SetByte(out, n, 10)
        SystemCall(1, fd, out, Add(n, 1))
        Deallocate(buf, 32)
        Deallocate(out, 32)
        SystemCall(3, fd, 0, 0)
        ReturnValue(0)
    }
}

// Ensure sketch camera: extent in mm, scale px/mm
Function.CA_UpdateSketchCam {
    Output: Integer
    Body: {
        CadApp.extent = Float_FromInt(50)
        // grow from line AABB if any
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            IfCondition GreaterThan(nl, 0) ThenBlock: {
                lines = CAD_Store.Read(CadApp.sketch, 1)
                xmin = ArrayGet(lines, 0)
                ymin = ArrayGet(lines, 1)
                xmax = xmin
                ymax = ymin
                i = 0
                WhileLoop LessThan(i, nl) {
                    b = Multiply(i, 4)
                    x1 = ArrayGet(lines, b)
                    y1 = ArrayGet(lines, Add(b, 1))
                    x2 = ArrayGet(lines, Add(b, 2))
                    y2 = ArrayGet(lines, Add(b, 3))
                    IfCondition EqualTo(Float_Le(x1, xmin), 1) ThenBlock: { xmin = x1 }
                    IfCondition EqualTo(Float_Le(xmax, x1), 1) ThenBlock: { xmax = x1 }
                    IfCondition EqualTo(Float_Le(y1, ymin), 1) ThenBlock: { ymin = y1 }
                    IfCondition EqualTo(Float_Le(ymax, y1), 1) ThenBlock: { ymax = y1 }
                    IfCondition EqualTo(Float_Le(x2, xmin), 1) ThenBlock: { xmin = x2 }
                    IfCondition EqualTo(Float_Le(xmax, x2), 1) ThenBlock: { xmax = x2 }
                    IfCondition EqualTo(Float_Le(y2, ymin), 1) ThenBlock: { ymin = y2 }
                    IfCondition EqualTo(Float_Le(ymax, y2), 1) ThenBlock: { ymax = y2 }
                    i = Add(i, 1)
                }
                dx = Float_Sub(xmax, xmin)
                dy = Float_Sub(ymax, ymin)
                ext = dx
                IfCondition EqualTo(Float_Le(ext, dy), 1) ThenBlock: { ext = dy }
                half = Float_Div(ext, 0x4000000000000000)
                // pad 20%
                ext = Float_Mul(ext, 0x3FF3333333333333)
                IfCondition EqualTo(Float_Le(ext, Float_FromInt(10)), 1) ThenBlock: {
                    ext = Float_FromInt(50)
                }
                CadApp.extent = ext
            }
        }
        mw = CadApp.width
        IfCondition LessThan(CadApp.height_px, mw) ThenBlock: { mw = CadApp.height_px }
        IfCondition EqualTo(CadApp.sk_zoom, 0) ThenBlock: {
            CadApp.sk_zoom = 0x3FF0000000000000
        }
        // base fit * user scroll zoom
        base = Float_Div(Float_Mul(0x3FEB333333333333, Float_FromInt(mw)), CadApp.extent)
        CadApp.scale = Float_Mul(base, CadApp.sk_zoom)
        ReturnValue(0)
    }
}

// pixel → world XY (top view, Y up)
Function.CA_PixToWorld {
    Input: px: Integer
    Input: py: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        CA_UpdateSketchCam()
        hw = Float_Div(Float_FromInt(CadApp.width), 0x4000000000000000)
        hh = Float_Div(Float_FromInt(CadApp.height_px), 0x4000000000000000)
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
            sc = 0x3FF0000000000000
        }
        // screen → world around pan center
        wx = Float_Add(CadApp.sk_pan_x, Float_Div(Float_Sub(Float_FromInt(px), hw), sc))
        wy = Float_Add(CadApp.sk_pan_y, Float_Div(Float_Sub(hh, Float_FromInt(py)), sc))
        ArraySet(out_xy, 0, wx)
        ArraySet(out_xy, 1, wy)
        ReturnValue(0)
    }
}

Function.CA_WorldToPix {
    Input: wx: Integer
    Input: wy: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        CA_UpdateSketchCam()
        hw = Float_Div(Float_FromInt(CadApp.width), 0x4000000000000000)
        hh = Float_Div(Float_FromInt(CadApp.height_px), 0x4000000000000000)
        sc = CadApp.scale
        sx = Float_Add(hw, Float_Mul(Float_Sub(wx, CadApp.sk_pan_x), sc))
        sy = Float_Sub(hh, Float_Mul(Float_Sub(wy, CadApp.sk_pan_y), sc))
        ArraySet(out_xy, 0, Float_ToInt(sx))
        ArraySet(out_xy, 1, Float_ToInt(sy))
        ReturnValue(0)
    }
}

// Scanline fill of closed polygon in PIXEL coords (x,y pairs).
Function.CA_FillPolyPx {
    Input: pxy: Address
    Input: n: Integer
    Input: col: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        ymin = ArrayGet(pxy, 1)
        ymax = ymin
        i = 0
        WhileLoop LessThan(i, n) {
            y = ArrayGet(pxy, Add(Multiply(i, 2), 1))
            IfCondition LessThan(y, ymin) ThenBlock: { ymin = y }
            IfCondition GreaterThan(y, ymax) ThenBlock: { ymax = y }
            i = Add(i, 1)
        }
        IfCondition LessThan(ymin, 0) ThenBlock: { ymin = 0 }
        IfCondition GreaterThan(ymax, CadApp.height_px) ThenBlock: { ymax = CadApp.height_px }
        xs = Allocate(256)
        y = ymin
        WhileLoop LessThan(y, ymax) {
            nx = 0
            i = 0
            WhileLoop LessThan(i, n) {
                j = Add(i, 1)
                IfCondition EqualTo(j, n) ThenBlock: { j = 0 }
                y0 = ArrayGet(pxy, Add(Multiply(i, 2), 1))
                y1 = ArrayGet(pxy, Add(Multiply(j, 2), 1))
                x0 = ArrayGet(pxy, Multiply(i, 2))
                x1 = ArrayGet(pxy, Multiply(j, 2))
                a = 0
                b = 0
                IfCondition LessThan(y0, y) ThenBlock: { a = 1 }
                IfCondition LessThan(y1, y) ThenBlock: { b = 1 }
                IfCondition NotEqual(a, b) ThenBlock: {
                    den = Subtract(y1, y0)
                    IfCondition NotEqual(den, 0) ThenBlock: {
                        num = Multiply(Subtract(y, y0), Subtract(x1, x0))
                        xi = Add(x0, Divide(num, den))
                        IfCondition LessThan(nx, 128) ThenBlock: {
                            ArraySet(xs, nx, xi)
                            nx = Add(nx, 1)
                        }
                    }
                }
                i = Add(i, 1)
            }
            a = 0
            WhileLoop LessThan(a, nx) {
                b = Add(a, 1)
                WhileLoop LessThan(b, nx) {
                    IfCondition GreaterThan(ArrayGet(xs, a), ArrayGet(xs, b)) ThenBlock: {
                        t = ArrayGet(xs, a)
                        ArraySet(xs, a, ArrayGet(xs, b))
                        ArraySet(xs, b, t)
                    }
                    b = Add(b, 1)
                }
                a = Add(a, 1)
            }
            p = 0
            WhileLoop LessThan(p, nx) {
                IfCondition LessThan(Add(p, 1), nx) ThenBlock: {
                    FB_HLine(ArrayGet(xs, p), ArrayGet(xs, Add(p, 1)), y, col)
                }
                p = Add(p, 2)
            }
            y = Add(y, 1)
        }
        Deallocate(xs, 256)
        ReturnValue(1)
    }
}

Function.CA_DrawSketchToFB {
    Output: Integer
    Body: {
        w = CadApp.width
        h = CadApp.height_px
        need = 0
        IfCondition EqualTo(FB.initialized, 0) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.width, w) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.height, h) ThenBlock: { need = 1 }
        IfCondition EqualTo(need, 1) ThenBlock: {
            IfCondition EqualTo(FB_InitHeadless(w, h), 0) ThenBlock: { ReturnValue(-1) }
        }
        FB_Clear(FB_RGB(24, 28, 36))
        // Sketch_0 datum: full axes + origin glyph (immutable O / +X / +Y)
        CA_UpdateSketchCam()
        pt = Allocate(32)
        CA_WorldToPix(0, 0, pt)
        ox = ArrayGet(pt, 0)
        oy = ArrayGet(pt, 1)
        // axis lines through origin (construction color)
        FB_Line(0, oy, w, oy, FB_RGB(70, 90, 120))
        FB_Line(ox, 0, ox, h, FB_RGB(70, 90, 120))
        // thicker ticks near O so datum reads as "from zero"
        CA_WorldToPix(0x4024000000000000, 0, pt)
        tx = ArrayGet(pt, 0)
        ty = ArrayGet(pt, 1)
        FB_Line(ox, oy, tx, ty, FB_RGB(120, 180, 255))
        CA_WorldToPix(0, 0x4024000000000000, pt)
        tx = ArrayGet(pt, 0)
        ty = ArrayGet(pt, 1)
        FB_Line(ox, oy, tx, ty, FB_RGB(120, 255, 160))
        // origin marker
        FB_FillRect(Subtract(ox, 4), Subtract(oy, 4), 9, 9, FB_RGB(255, 220, 80))
        FB_FillRect(Subtract(ox, 2), Subtract(oy, 2), 5, 5, FB_RGB(40, 40, 50))
        // lines
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            CAD_Sketch.EnsureDatum(CadApp.sketch)
            // user Points (first-class) — magenta cross, distinct from orange anchors
            nup = CAD_Sketch.GetUserPointCount(CadApp.sketch)
            IfCondition GreaterThan(nup, 0) ThenBlock: {
                upxy = Allocate(32)
                ui = 0
                WhileLoop LessThan(ui, nup) {
                    CAD_Sketch.GetUserPoint(CadApp.sketch, ui, upxy)
                    CA_WorldToPix(ArrayGet(upxy, 0), ArrayGet(upxy, 1), pt)
                    ux = ArrayGet(pt, 0)
                    uy = ArrayGet(pt, 1)
                    FB_Line(Subtract(ux, 5), uy, Add(ux, 5), uy, FB_RGB(255, 80, 220))
                    FB_Line(ux, Subtract(uy, 5), ux, Add(uy, 5), FB_RGB(255, 80, 220))
                    FB_FillRect(Subtract(ux, 2), Subtract(uy, 2), 5, 5, FB_RGB(255, 80, 220))
                    ui = Add(ui, 1)
                }
                Deallocate(upxy, 32)
            }
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            lines = CAD_Store.Read(CadApp.sketch, 1)
            i = 0
            WhileLoop LessThan(i, nl) {
                b = Multiply(i, 4)
                CA_WorldToPix(ArrayGet(lines, b), ArrayGet(lines, Add(b, 1)), pt)
                x0 = ArrayGet(pt, 0)
                y0 = ArrayGet(pt, 1)
                CA_WorldToPix(ArrayGet(lines, Add(b, 2)), ArrayGet(lines, Add(b, 3)), pt)
                x1 = ArrayGet(pt, 0)
                y1 = ArrayGet(pt, 1)
                FB_Line(x0, y0, x1, y1, FB_RGB(100, 220, 255))
                i = Add(i, 1)
            }
            // anchor points (ends / crosses / T-touches) — small markers
            npt = CAD_Sketch.GetPointCount(CadApp.sketch)
            pts = CAD_Store.Read(CadApp.sketch, 17)
            IfCondition NotEqual(pts, 0) ThenBlock: {
                i = 0
                WhileLoop LessThan(i, npt) {
                    CA_WorldToPix(ArrayGet(pts, Multiply(i, 2)), ArrayGet(pts, Add(Multiply(i, 2), 1)), pt)
                    x0 = ArrayGet(pt, 0)
                    y0 = ArrayGet(pt, 1)
                    FB_FillRect(Subtract(x0, 2), Subtract(y0, 2), 5, 5, FB_RGB(255, 120, 80))
                    i = Add(i, 1)
                }
            }
            // circles: display-only smooth ring (entity stays a true circle — no anchors)
            nc = CAD_Sketch.GetCircleCount(CadApp.sketch)
            circs = CAD_Store.Read(CadApp.sketch, 8)
            two_pi = 0x401921FB54442D18
            ci = 0
            WhileLoop LessThan(ci, nc) {
                base = Multiply(ci, 3)
                cx = ArrayGet(circs, base)
                cy = ArrayGet(circs, Add(base, 1))
                rad = ArrayGet(circs, Add(base, 2))
                k = 0
                WhileLoop LessThan(k, 64) {
                    a0 = Float_Mul(two_pi, Float_Div(Float_FromInt(k), Float_FromInt(64)))
                    a1 = Float_Mul(two_pi, Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(64)))
                    CA_WorldToPix(Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a0))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a0))), pt)
                    x0 = ArrayGet(pt, 0)
                    y0 = ArrayGet(pt, 1)
                    CA_WorldToPix(Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a1))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a1))), pt)
                    x1 = ArrayGet(pt, 0)
                    y1 = ArrayGet(pt, 1)
                    FB_Line(x0, y0, x1, y1, FB_RGB(255, 200, 80))
                    k = Add(k, 1)
                }
                ci = Add(ci, 1)
            }
            // arcs as tess preview (if any stored) — UNDER profile rings
            na = CAD_Sketch.GetArcCount(CadApp.sketch)
            IfCondition GreaterThan(na, 0) ThenBlock: {
                arcs = CAD_Store.Read(CadApp.sketch, 11)
                two_pi = 0x401921FB54442D18
                ai = 0
                WhileLoop LessThan(ai, na) {
                    base = Multiply(ai, 5)
                    cx = ArrayGet(arcs, base)
                    cy = ArrayGet(arcs, Add(base, 1))
                    rad = ArrayGet(arcs, Add(base, 2))
                    a0 = ArrayGet(arcs, Add(base, 3))
                    a1 = ArrayGet(arcs, Add(base, 4))
                    span = Float_Sub(a1, a0)
                    IfCondition EqualTo(Float_Le(span, 0), 1) ThenBlock: {
                        span = Float_Add(span, two_pi)
                    }
                    // display-only tess (entity is still a true arc)
                    nseg = Float_ToInt(Float_Div(Float_Mul(Float_FromInt(48), span), two_pi))
                    IfCondition LessThan(nseg, 8) ThenBlock: { nseg = 8 }
                    IfCondition GreaterThan(nseg, 64) ThenBlock: { nseg = 64 }
                    k = 0
                    WhileLoop LessThan(k, nseg) {
                        t0 = Float_Div(Float_FromInt(k), Float_FromInt(nseg))
                        t1 = Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(nseg))
                        ang0 = Float_Add(a0, Float_Mul(span, t0))
                        ang1 = Float_Add(a0, Float_Mul(span, t1))
                        CA_WorldToPix(Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang0))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang0))), pt)
                        x0 = ArrayGet(pt, 0)
                        y0 = ArrayGet(pt, 1)
                        CA_WorldToPix(Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang1))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang1))), pt)
                        x1 = ArrayGet(pt, 0)
                        y1 = ArrayGet(pt, 1)
                        FB_Line(x0, y0, x1, y1, FB_RGB(200, 140, 255))
                        k = Add(k, 1)
                    }
                    ai = Add(ai, 1)
                }
            }
            // profiles LAST: Fusion-style FILL shows pad material vs voids
            //   unselected = white outline
            //   selected outer = red fill + red edge (material)
            //   nested simple holes inside selected outer = dark fill (void)
            nprof = CAD_Store.Read(CadApp.sketch, 12)
            IfCondition GreaterThan(nprof, 0) ThenBlock: {
                pi = 0
                xy = Allocate(65536)
                pxy = Allocate(65536)
                oxy = Allocate(65536)
                proj_col = FB_RGB(230, 240, 255)
                sel_col = FB_RGB(255, 40, 40)
                fill_col = FB_RGB(140, 36, 40)
                void_col = FB_RGB(24, 28, 36)
                // find largest selected as outer for void punch
                outer_i = -1
                outer_a = 0
                outer_nn = 0
                IfCondition EqualTo(CadApp.prof_user, 1) ThenBlock: {
                    pi = 0
                    WhileLoop LessThan(pi, nprof) {
                        bit = LeftShift(1, pi)
                        sel = 0
                        IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: { sel = 1 }
                        IfCondition EqualTo(CadApp.prof_mask, 0) ThenBlock: {
                            IfCondition EqualTo(pi, CadApp.prof_sel) ThenBlock: { sel = 1 }
                        }
                        IfCondition EqualTo(sel, 1) ThenBlock: {
                            nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                            IfCondition GreaterEqual(nn, 3) ThenBlock: {
                                ar = CAD_Sketch.LoopSignedArea(xy, nn)
                                IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                                better = 0
                                IfCondition EqualTo(outer_i, -1) ThenBlock: { better = 1 }
                                IfCondition EqualTo(Float_Le(outer_a, ar), 1) ThenBlock: {
                                    IfCondition NotEqual(pi, outer_i) ThenBlock: { better = 1 }
                                }
                                IfCondition EqualTo(better, 1) ThenBlock: {
                                    outer_i = pi
                                    outer_a = ar
                                    outer_nn = nn
                                    k = 0
                                    WhileLoop LessThan(k, nn) {
                                        ArraySet(oxy, Multiply(k, 2), ArrayGet(xy, Multiply(k, 2)))
                                        ArraySet(oxy, Add(Multiply(k, 2), 1), ArrayGet(xy, Add(Multiply(k, 2), 1)))
                                        k = Add(k, 1)
                                    }
                                }
                            }
                        }
                        pi = Add(pi, 1)
                    }
                }
                // pass 1: fill ALL selected faces as material (red), then punch nested voids.
                // Was: only largest filled → second face (triangle) had red outline only.
                // Adjacent multi-select: both fill. Nested selected-inside-largest: void punch.
                // Mask is 32 bits → at most 32 selected faces can highlight / pad.
                IfCondition EqualTo(CadApp.prof_user, 1) ThenBlock: {
                    pi = 0
                    WhileLoop LessThan(pi, nprof) {
                        IfCondition LessThan(pi, 32) ThenBlock: {
                            bit = LeftShift(1, pi)
                            sel = 0
                            IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: { sel = 1 }
                            IfCondition EqualTo(CadApp.prof_mask, 0) ThenBlock: {
                                IfCondition EqualTo(pi, CadApp.prof_sel) ThenBlock: { sel = 1 }
                            }
                            IfCondition EqualTo(sel, 1) ThenBlock: {
                                nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                                IfCondition GreaterEqual(nn, 3) ThenBlock: {
                                    k = 0
                                    WhileLoop LessThan(k, nn) {
                                        CA_WorldToPix(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), pt)
                                        ArraySet(pxy, Multiply(k, 2), ArrayGet(pt, 0))
                                        ArraySet(pxy, Add(Multiply(k, 2), 1), ArrayGet(pt, 1))
                                        k = Add(k, 1)
                                    }
                                    CA_FillPolyPx(pxy, nn, fill_col)
                                }
                            }
                        }
                        pi = Add(pi, 1)
                    }
                }
                // punch voids: other SELECTED faces with centroid inside outer
                IfCondition GreaterEqual(outer_i, 0) ThenBlock: {
                    pi = 0
                    WhileLoop LessThan(pi, nprof) {
                        IfCondition NotEqual(pi, outer_i) ThenBlock: {
                            bit = LeftShift(1, pi)
                            IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: {
                                nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                                IfCondition GreaterEqual(nn, 3) ThenBlock: {
                                    sx = 0
                                    sy = 0
                                    k = 0
                                    WhileLoop LessThan(k, nn) {
                                        sx = Float_Add(sx, ArrayGet(xy, Multiply(k, 2)))
                                        sy = Float_Add(sy, ArrayGet(xy, Add(Multiply(k, 2), 1)))
                                        k = Add(k, 1)
                                    }
                                    invn = Float_Div(0x3FF0000000000000, Float_FromInt(nn))
                                    IfCondition EqualTo(CA_PointInPoly(Float_Mul(sx, invn), Float_Mul(sy, invn), oxy, outer_nn), 1) ThenBlock: {
                                        k = 0
                                        WhileLoop LessThan(k, nn) {
                                            CA_WorldToPix(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), pt)
                                            ArraySet(pxy, Multiply(k, 2), ArrayGet(pt, 0))
                                            ArraySet(pxy, Add(Multiply(k, 2), 1), ArrayGet(pt, 1))
                                            k = Add(k, 1)
                                        }
                                        CA_FillPolyPx(pxy, nn, void_col)
                                    }
                                }
                            }
                        }
                        pi = Add(pi, 1)
                    }
                }
                // pass 2: outlines — ALL solved faces so user can see multi-face results.
                // Selected = red thick; other faces = dim gray (not bright white) so shared
                // edges do not look like a broken double-white profile (profileerror).
                pi = 0
                WhileLoop LessThan(pi, nprof) {
                    nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                    col = FB_RGB(90, 100, 115)
                    thick = 1
                    IfCondition EqualTo(CadApp.prof_user, 1) ThenBlock: {
                        bit = LeftShift(1, pi)
                        selected = 0
                        IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: {
                            selected = 1
                        }
                        IfCondition EqualTo(CadApp.prof_mask, 0) ThenBlock: {
                            IfCondition EqualTo(pi, CadApp.prof_sel) ThenBlock: { selected = 1 }
                        }
                        IfCondition EqualTo(selected, 1) ThenBlock: {
                            col = sel_col
                            thick = 2
                        }
                        // hole outline = cyan (nested inside selected outer)
                        IfCondition GreaterEqual(outer_i, 0) ThenBlock: {
                            IfCondition NotEqual(pi, outer_i) ThenBlock: {
                                IfCondition GreaterEqual(nn, 3) ThenBlock: {
                                    inside = 1
                                    k = 0
                                    WhileLoop LessThan(k, nn) {
                                        IfCondition EqualTo(CA_PointInPoly(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), oxy, outer_nn), 0) ThenBlock: {
                                            inside = 0
                                        }
                                        k = Add(k, 1)
                                    }
                                    IfCondition EqualTo(inside, 1) ThenBlock: {
                                        IfCondition EqualTo(selected, 0) ThenBlock: {
                                            col = FB_RGB(80, 200, 255)
                                            thick = 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
                        col = proj_col
                    }
                    IfCondition GreaterEqual(nn, 3) ThenBlock: {
                        k = 0
                        WhileLoop LessThan(k, nn) {
                            k2 = Add(k, 1)
                            IfCondition EqualTo(k2, nn) ThenBlock: { k2 = 0 }
                            CA_WorldToPix(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), pt)
                            x0 = ArrayGet(pt, 0)
                            y0 = ArrayGet(pt, 1)
                            CA_WorldToPix(ArrayGet(xy, Multiply(k2, 2)), ArrayGet(xy, Add(Multiply(k2, 2), 1)), pt)
                            x1 = ArrayGet(pt, 0)
                            y1 = ArrayGet(pt, 1)
                            FB_Line(x0, y0, x1, y1, col)
                            IfCondition GreaterThan(thick, 1) ThenBlock: {
                                FB_Line(Add(x0, 1), y0, Add(x1, 1), y1, col)
                                FB_Line(x0, Add(y0, 1), x1, Add(y1, 1), col)
                            }
                            k = Add(k, 1)
                        }
                    }
                    pi = Add(pi, 1)
                }
                Deallocate(xy, 65536)
                Deallocate(pxy, 65536)
                Deallocate(oxy, 65536)
            }
        }
        // rubber-band / drag preview for any in-progress tool
        IfCondition GreaterThan(CadApp.nclick, 0) ThenBlock: {
            CA_WorldToPix(CadApp.cx0, CadApp.cy0, pt)
            x0 = ArrayGet(pt, 0)
            y0 = ArrayGet(pt, 1)
            FB_FillRect(Subtract(x0, 3), Subtract(y0, 3), 7, 7, FB_RGB(255, 80, 80))
            IfCondition EqualTo(CadApp.hover_ok, 1) ThenBlock: {
                x1 = CadApp.hover_px
                y1 = CadApp.hover_py
                xy = Allocate(32)
                CA_PixToWorld(x1, y1, xy)
                hx = ArrayGet(xy, 0)
                hy = ArrayGet(xy, 1)
                Deallocate(xy, 32)
                two_pi = 0x401921FB54442D18
                // LINE
                IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
                    FB_Line(x0, y0, x1, y1, FB_RGB(255, 120, 160))
                }
                // RECT
                IfCondition EqualTo(CadApp.tool, 1) ThenBlock: {
                    FB_Line(x0, y0, x1, y0, FB_RGB(255, 120, 160))
                    FB_Line(x1, y0, x1, y1, FB_RGB(255, 120, 160))
                    FB_Line(x1, y1, x0, y1, FB_RGB(255, 120, 160))
                    FB_Line(x0, y1, x0, y0, FB_RGB(255, 120, 160))
                }
                // CIRCLE: drag radius from center (nclick==1)
                IfCondition EqualTo(CadApp.tool, 2) ThenBlock: {
                    dx = Float_Sub(hx, CadApp.cx0)
                    dy = Float_Sub(hy, CadApp.cy0)
                    rad = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                    k = 0
                    WhileLoop LessThan(k, 32) {
                        a0 = Float_Mul(two_pi, Float_Div(Float_FromInt(k), Float_FromInt(32)))
                        a1 = Float_Mul(two_pi, Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(32)))
                        CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(a0))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(a0))), pt)
                        xa = ArrayGet(pt, 0)
                        ya = ArrayGet(pt, 1)
                        CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(a1))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(a1))), pt)
                        xb = ArrayGet(pt, 0)
                        yb = ArrayGet(pt, 1)
                        FB_Line(xa, ya, xb, yb, FB_RGB(255, 200, 80))
                        k = Add(k, 1)
                    }
                    FB_Line(x0, y0, x1, y1, FB_RGB(255, 160, 40))
                }
                // ARC nclick=1: drag radius (full circle ghost + spoke)
                IfCondition EqualTo(CadApp.tool, 3) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                        dx = Float_Sub(hx, CadApp.cx0)
                        dy = Float_Sub(hy, CadApp.cy0)
                        rad = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                        k = 0
                        WhileLoop LessThan(k, 32) {
                            a0 = Float_Mul(two_pi, Float_Div(Float_FromInt(k), Float_FromInt(32)))
                            a1 = Float_Mul(two_pi, Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(32)))
                            CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(a0))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(a0))), pt)
                            xa = ArrayGet(pt, 0)
                            ya = ArrayGet(pt, 1)
                            CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(a1))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(a1))), pt)
                            xb = ArrayGet(pt, 0)
                            yb = ArrayGet(pt, 1)
                            FB_Line(xa, ya, xb, yb, FB_RGB(180, 120, 255))
                            k = Add(k, 1)
                        }
                        FB_Line(x0, y0, x1, y1, FB_RGB(220, 160, 255))
                    }
                    // ARC nclick=2: radius fixed, drag end angle
                    IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: {
                        rad = CadApp.arc_rad
                        a0 = CadApp.arc_a0
                        a1 = CAD_Geom.Atan2(Float_Sub(hy, CadApp.cy0), Float_Sub(hx, CadApp.cx0))
                        span = Float_Sub(a1, a0)
                        IfCondition EqualTo(Float_Le(span, 0), 1) ThenBlock: {
                            span = Float_Add(span, two_pi)
                        }
                        nseg = 24
                        k = 0
                        WhileLoop LessThan(k, nseg) {
                            t0 = Float_Div(Float_FromInt(k), Float_FromInt(nseg))
                            t1 = Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(nseg))
                            ang0 = Float_Add(a0, Float_Mul(span, t0))
                            ang1 = Float_Add(a0, Float_Mul(span, t1))
                            CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(ang0))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(ang0))), pt)
                            xa = ArrayGet(pt, 0)
                            ya = ArrayGet(pt, 1)
                            CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(ang1))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(ang1))), pt)
                            xb = ArrayGet(pt, 0)
                            yb = ArrayGet(pt, 1)
                            FB_Line(xa, ya, xb, yb, FB_RGB(255, 120, 255))
                            k = Add(k, 1)
                        }
                        // spokes to start and hover end
                        CA_WorldToPix(Float_Add(CadApp.cx0, Float_Mul(rad, CAD_Geom.Cos(a0))), Float_Add(CadApp.cy0, Float_Mul(rad, CAD_Geom.Sin(a0))), pt)
                        FB_Line(x0, y0, ArrayGet(pt, 0), ArrayGet(pt, 1), FB_RGB(200, 100, 220))
                        FB_Line(x0, y0, x1, y1, FB_RGB(200, 100, 220))
                    }
                }
                // ARC3 preview — own function (locals isolation)
                IfCondition EqualTo(CadApp.tool, 9) ThenBlock: {
                    CA_DrawArc3Preview(hx, hy)
                }
            }
            // ARC3: even without host hover yet, show start (and through if pick2)
            IfCondition EqualTo(CadApp.hover_ok, 0) ThenBlock: {
                IfCondition EqualTo(CadApp.tool, 9) ThenBlock: {
                    CA_DrawArc3Preview(CadApp.cx0, CadApp.cy0)
                }
            }
        }
        Deallocate(pt, 32)
        ReturnValue(0)
    }
}

// Count closed profiles WITHOUT mutating live sketch (no tessellate-on-live).
Function.CA_CountProfiles {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.nprof = 0
            ReturnValue(0)
        }
        // read cache only — projection is CA_RebuildProfiles (clone)
        n = CAD_Store.Read(CadApp.sketch, 12)
        CadApp.nprof = n
        ReturnValue(n)
    }
}

// Build solid from current sketch (+ optional hole sketch).
// Paths: plate+hole DXF pair | multi-loop single sketch | single pad.
Function.CA_BuildSolid {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: no sketch\n", 19)
            ReturnValue(-1)
        }
        hgt = Float_FromInt(CadApp.height)
        h = 0
        IfCondition NotEqual(CadApp.hole_sk, 0) ThenBlock: {
            h = CAD_Feat.ExtrudePlateThroughHole(CadApp.sketch, CadApp.hole_sk, hgt)
            IfCondition EqualTo(h, 0) ThenBlock: {
                CA_Log("cad_app: plate+hole FAIL\n", 25)
                ReturnValue(-2)
            }
            CadApp.solid = h
            CadApp.dirty = 1
            CA_Log("cad_app: plate+hole ok\n", 23)
            ReturnValue(0)
        }
        // --- pad paths ---
        // auto_pad=1 (DXF/file load): ExtrudeProfile on a projection clone (live geom ok)
        // auto_pad=0 (interactive): require Pick/Next, extrude ONLY selected ring
        // Never PrepareExtrude the live sketch for interactive pad (mutates arcs/lines).
        sk_nprof = CAD_Store.Read(CadApp.sketch, 12)
        IfCondition EqualTo(sk_nprof, 0) ThenBlock: {
            sk_nprof = CA_RebuildProfiles()
        }
        CadApp.nprof = sk_nprof
        IfCondition EqualTo(sk_nprof, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL (no closed profile)\n", 38)
            CA_Log("  close a loop (RECT), then Profiles → Pick\n", 46)
            ReturnValue(-2)
        }

        // File/DXF path: clone + PrepareExtrude + extrude (do not trash live if shared)
        IfCondition EqualTo(CadApp.auto_pad, 1) ThenBlock: {
            clone = CAD_Sketch.CreateSketch(1)
            CA_CopySketchGeom(CadApp.sketch, clone)
            CAD_Sketch.PrepareExtrude(clone)
            h = CAD_Feat.ExtrudeProfile(clone, hgt)
            IfCondition EqualTo(h, 0) ThenBlock: {
                CA_Log("cad_app: pad FAIL (auto extrude)\n", 33)
                ReturnValue(-2)
            }
            CadApp.solid = h
            CadApp.dirty = 1
            CadApp.prof_user = 0
            CA_Log("cad_app: pad OK (file/auto)\n", 27)
            ReturnValue(0)
        }

        // Interactive: if multi was projected but selection cleared, take outer (0)
        IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
            IfCondition GreaterThan(sk_nprof, 0) ThenBlock: {
                ok = CA_ApplyProfileSel(0, sk_nprof, 0)
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    CA_Log("cad_app: Pad uses outer profile (Next to change)\n", 47)
                }
            }
        }
        IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL — no closed profile\n", 38)
            CA_Log("  Profiles first, then Pad (or Next/Pick)\n", 42)
            ReturnValue(-2)
        }
        // ensure mask has at least one selected bit
        IfCondition EqualTo(CadApp.prof_mask, 0) ThenBlock: {
            IfCondition LessThan(CadApp.prof_sel, sk_nprof) ThenBlock: {
                CadApp.prof_mask = LeftShift(1, CadApp.prof_sel)
            }
        }
        IfCondition EqualTo(CadApp.prof_mask, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL — nothing selected\n", 37)
            ReturnValue(-2)
        }
        // Nested profiles: largest area = outer pad; fully-inside others = holes.
        // Disjoint selections = separate pads CompoundAdd'ed.
        PrintMessage("cad_app: pad nprof=")
        PrintNumber(sk_nprof)
        PrintMessage(" mask=")
        PrintNumber(CadApp.prof_mask)
        PrintMessage(" sel=")
        PrintNumber(CadApp.prof_sel)
        PrintMessage("\n")
        xy = Allocate(65536)
        oxy = Allocate(65536)
        outer_i = -1
        outer_a = 0
        outer_nn = 0
        pi = 0
        WhileLoop LessThan(pi, sk_nprof) {
            IfCondition LessThan(pi, 32) ThenBlock: {
                bit = LeftShift(1, pi)
                IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: {
                    nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                    IfCondition GreaterEqual(nn, 3) ThenBlock: {
                        ar = CAD_Sketch.LoopSignedArea(xy, nn)
                        IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                        better = 0
                        IfCondition EqualTo(outer_i, -1) ThenBlock: { better = 1 }
                        IfCondition EqualTo(Float_Le(outer_a, ar), 1) ThenBlock: {
                            IfCondition NotEqual(pi, outer_i) ThenBlock: { better = 1 }
                        }
                        IfCondition EqualTo(better, 1) ThenBlock: {
                            outer_i = pi
                            outer_a = ar
                            outer_nn = nn
                            k = 0
                            WhileLoop LessThan(k, nn) {
                                ArraySet(oxy, Multiply(k, 2), ArrayGet(xy, Multiply(k, 2)))
                                ArraySet(oxy, Add(Multiply(k, 2), 1), ArrayGet(xy, Add(Multiply(k, 2), 1)))
                                k = Add(k, 1)
                            }
                        }
                        PrintMessage("cad_app: pad prof=")
                        PrintNumber(pi)
                        PrintMessage(" nn=")
                        PrintNumber(nn)
                        PrintMessage(" area=")
                        PrintNumber(Float_ToInt(ar))
                        PrintMessage("\n")
                    }
                }
            }
            pi = Add(pi, 1)
        }
        IfCondition LessThan(outer_i, 0) ThenBlock: {
            Deallocate(xy, 65536)
            Deallocate(oxy, 65536)
            CA_Log("cad_app: pad FAIL — no valid ring\n", 34)
            ReturnValue(-2)
        }
        // Outer = largest selected. Every other SELECTED face whose centroid
        // is inside outer becomes a through hole. Selection only — no auto rules.
        // PIN outer_nn / oxy / height BEFORE CreateSketch/AddProfileXY — nested
        // calls clobber locals and AddProfileXY(n=4 garbage) → MakeBoxSolid cube.
        onn = outer_nn
        oaddr = oxy
        oi = outer_i
        ohgt = hgt
        PrintMessage("cad_app: pad outer_i=")
        PrintNumber(oi)
        PrintMessage(" onn=")
        PrintNumber(onn)
        PrintMessage("\n")
        IfCondition LessThan(onn, 3) ThenBlock: {
            Deallocate(xy, 65536)
            Deallocate(oxy, 65536)
            CA_Log("cad_app: pad FAIL — outer ring clobbered\n", 39)
            ReturnValue(-2)
        }
        hsk = CAD_Sketch.CreateSketch(1)
        IfCondition EqualTo(hsk, 0) ThenBlock: {
            Deallocate(xy, 65536)
            Deallocate(oxy, 65536)
            CA_Log("cad_app: pad FAIL — sketch alloc\n", 33)
            ReturnValue(-2)
        }
        // re-pin after CreateSketch
        onn2 = onn
        oaddr2 = oaddr
        CAD_Sketch.AddProfileXY(hsk, oaddr2, onn2)
        pn_chk = CAD_Store.Read(hsk, 2)
        PrintMessage("cad_app: pad extrude primary n=")
        PrintNumber(pn_chk)
        PrintMessage("\n")
        IfCondition LessThan(pn_chk, 3) ThenBlock: {
            Deallocate(xy, 65536)
            Deallocate(oxy, 65536)
            CA_Log("cad_app: pad FAIL — AddProfileXY empty\n", 38)
            ReturnValue(-2)
        }
        n_holes = 0
        pi = 0
        WhileLoop LessThan(pi, sk_nprof) {
            IfCondition NotEqual(pi, oi) ThenBlock: {
                IfCondition LessThan(pi, 32) ThenBlock: {
                    bit = LeftShift(1, pi)
                    IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: {
                        nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                        IfCondition GreaterEqual(nn, 3) ThenBlock: {
                            // centroid in outer?
                            sx = 0
                            sy = 0
                            k = 0
                            WhileLoop LessThan(k, nn) {
                                sx = Float_Add(sx, ArrayGet(xy, Multiply(k, 2)))
                                sy = Float_Add(sy, ArrayGet(xy, Add(Multiply(k, 2), 1)))
                                k = Add(k, 1)
                            }
                            invn = Float_Div(0x3FF0000000000000, Float_FromInt(nn))
                            cx = Float_Mul(sx, invn)
                            cy = Float_Mul(sy, invn)
                            // pin hole ring into temp then AddProfileXY (nn can clobber)
                            hnn = nn
                            IfCondition EqualTo(CA_PointInPoly(cx, cy, oaddr2, onn2), 1) ThenBlock: {
                                CAD_Sketch.AddProfileXY(hsk, xy, hnn)
                                n_holes = Add(n_holes, 1)
                                PrintMessage("cad_app: pad hole prof=")
                                PrintNumber(pi)
                                PrintMessage(" nn=")
                                PrintNumber(hnn)
                                PrintMessage("\n")
                            }
                        }
                    }
                }
            }
            pi = Add(pi, 1)
        }
        // keep prior solid when padding on a PlaneFeature (boss on top)
        old_solid = 0
        pln = CadApp.plane
        IfCondition NotEqual(pln, 0) ThenBlock: {
            old_solid = CadApp.solid
        }
        h = CAD_Feat.ExtrudeOnPlane(hsk, ohgt, pln)
        // disjoint islands (not inside outer) as extra solids
        pi = 0
        WhileLoop LessThan(pi, sk_nprof) {
            IfCondition NotEqual(pi, outer_i) ThenBlock: {
                IfCondition LessThan(pi, 32) ThenBlock: {
                    bit = LeftShift(1, pi)
                    IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: {
                        nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                        IfCondition GreaterEqual(nn, 3) ThenBlock: {
                            inside = 1
                            k = 0
                            WhileLoop LessThan(k, nn) {
                                IfCondition EqualTo(CA_PointInPoly(ArrayGet(xy, Multiply(k, 2)), ArrayGet(xy, Add(Multiply(k, 2), 1)), oxy, outer_nn), 0) ThenBlock: {
                                    inside = 0
                                }
                                k = Add(k, 1)
                            }
                            IfCondition EqualTo(inside, 0) ThenBlock: {
                                isk = CAD_Sketch.FromClosedXY(xy, nn)
                                IfCondition NotEqual(isk, 0) ThenBlock: {
                                    hi = CAD_Feat.ExtrudeOnPlane(isk, hgt, pln)
                                    IfCondition NotEqual(hi, 0) ThenBlock: {
                                        IfCondition EqualTo(h, 0) ThenBlock: { h = hi }
                                        IfCondition NotEqual(h, hi) ThenBlock: {
                                            IfCondition NotEqual(h, 0) ThenBlock: {
                                                h = CAD_Topo.CompoundAdd(h, hi)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            pi = Add(pi, 1)
        }
        Deallocate(xy, 65536)
        Deallocate(oxy, 65536)
        CAD_Store.Write(CadApp.sketch, 12, sk_nprof)
        IfCondition EqualTo(h, 0) ThenBlock: {
            CA_Log("cad_app: pad FAIL (extrude)\n", 28)
            CA_Log("  tip: re-Profiles then Pad (prism cap 2048 verts)\n", 51)
            ReturnValue(-2)
        }
        IfCondition NotEqual(old_solid, 0) ThenBlock: {
            IfCondition NotEqual(old_solid, h) ThenBlock: {
                h = CAD_Topo.CompoundAdd(old_solid, h)
                IfCondition EqualTo(h, 0) ThenBlock: {
                    CA_Log("cad_app: pad FAIL (compound on plane)\n", 38)
                    ReturnValue(-2)
                }
                CA_Log("cad_app: pad OK (on plane + prior solid)\n", 40)
            }
        }
        CadApp.solid = h
        // rebind face-plane to new solid (signature match; loud miss if lost)
        IfCondition NotEqual(pln, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(pln, 0), 3) ThenBlock: {
                rb = CAD_Plane.RebindFace(pln, h)
                IfCondition EqualTo(rb, 0) ThenBlock: {
                    PrintMessage("cad_app: face rebind ok pid=")
                    PrintNumber(CAD_Plane.GetPid(pln))
                    PrintMessage("\n")
                }
                IfCondition NotEqual(rb, 0) ThenBlock: {
                    CA_Log("cad_app: face rebind FAIL — plane face lost after pad\n", 54)
                }
            }
        }
        CadApp.dirty = 1
        CadApp.nprof = sk_nprof
        IfCondition EqualTo(old_solid, 0) ThenBlock: {
            IfCondition GreaterThan(n_holes, 0) ThenBlock: {
                CA_Log("cad_app: pad OK (outer + through hole(s))\n", 41)
            }
            IfCondition EqualTo(n_holes, 0) ThenBlock: {
                CA_Log("cad_app: pad OK (selected profile(s))\n", 37)
            }
        }
        ReturnValue(0)
    }
}

Function.CA_PadFromSketch {
    Output: Integer
    Body: {
        ReturnValue(CA_BuildSolid())
    }
}

// Enter face-pick: stay in 3D, next short LMB click chooses a real planar face.
Function.CA_PlaneOnTop {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_Log("cad_app: OnTop needs solid (pad first)\n", 40)
            ReturnValue(-1)
        }
        CadApp.face_pick = 1
        CadApp.mode = 0
        CadApp.nclick = 0
        CA_Log("cad_app: OnTop — click a solid face to sketch on it\n", 52)
        CA_Log("  (real B-Rep planar face; orbit then click)\n", 46)
        ReturnValue(0)
    }
}

// Register plane for 3D overlay (unique, max 16).
Function.CA_PlaneRegister {
    Input: pl: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(pl, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.plane_list, 0) ThenBlock: {
            CadApp.plane_list = Allocate(128)
            CadApp.plane_n = 0
        }
        i = 0
        WhileLoop LessThan(i, CadApp.plane_n) {
            IfCondition EqualTo(ArrayGet(CadApp.plane_list, i), pl) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(CadApp.plane_n, 16) ThenBlock: {
            ArraySet(CadApp.plane_list, CadApp.plane_n, pl)
            CadApp.plane_n = Add(CadApp.plane_n, 1)
        }
        ReturnValue(1)
    }
}

// Ensure active plane is world XY if none.
Function.CA_EnsurePlane {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: {
            CadApp.plane = CAD_Plane.CreateWorldXY()
            CAD_Plane.EnsurePid(CadApp.plane)
            CA_PlaneRegister(CadApp.plane)
            CA_Log("cad_app: created Sketch_0 plane (world XY)\n", 42)
        }
        ReturnValue(CadApp.plane)
    }
}

// Build ProjectPoint frame from solid bounds or default ±50 cube.
Function.CA_BuildViewFrame {
    Input: out_frame: Address
    Output: Integer
    Body: {
        aabb = Allocate(64)
        IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
            mn = Allocate(32)
            mx = Allocate(32)
            IfCondition EqualTo(CAD_Topo.SolidBounds(CadApp.solid, mn, mx), 1) ThenBlock: {
                ArraySet(aabb, 0, ArrayGet(mn, 0))
                ArraySet(aabb, 1, ArrayGet(mn, 1))
                ArraySet(aabb, 2, ArrayGet(mn, 2))
                ArraySet(aabb, 3, ArrayGet(mx, 0))
                ArraySet(aabb, 4, ArrayGet(mx, 1))
                ArraySet(aabb, 5, ArrayGet(mx, 2))
            }
            IfCondition EqualTo(CAD_Topo.SolidBounds(CadApp.solid, mn, mx), 0) ThenBlock: {
                ArraySet(aabb, 0, Float_FromInt(-50))
                ArraySet(aabb, 1, Float_FromInt(-50))
                ArraySet(aabb, 2, Float_FromInt(-10))
                ArraySet(aabb, 3, Float_FromInt(50))
                ArraySet(aabb, 4, Float_FromInt(50))
                ArraySet(aabb, 5, Float_FromInt(50))
            }
            Deallocate(mn, 32)
            Deallocate(mx, 32)
        }
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            // include construction planes so framing is not empty
            ArraySet(aabb, 0, Float_FromInt(-50))
            ArraySet(aabb, 1, Float_FromInt(-50))
            ArraySet(aabb, 2, Float_FromInt(-10))
            ArraySet(aabb, 3, Float_FromInt(50))
            ArraySet(aabb, 4, Float_FromInt(50))
            ArraySet(aabb, 5, Float_FromInt(60))
        }
        CAD_View.EnsureCamDefaults()
        CAD_View.BuildFrame(aabb, CadApp.width, CadApp.height_px, out_frame)
        Deallocate(aabb, 64)
        ReturnValue(0)
    }
}

// Project world XYZ to pixel ints via view frame. out_xy [sx,sy] ints.
Function.CA_World3ToPix {
    Input: x_r: Integer
    Input: y_r: Integer
    Input: z_r: Integer
    Input: vframe: Address
    Input: out_xy: Address
    Output: Integer
    Body: {
        pr = Allocate(32)
        CAD_View.ProjectPoint(x_r, y_r, z_r, vframe, pr)
        ArraySet(out_xy, 0, Float_ToInt(ArrayGet(pr, 0)))
        ArraySet(out_xy, 1, Float_ToInt(ArrayGet(pr, 1)))
        Deallocate(pr, 32)
        ReturnValue(0)
    }
}

// Semi-transparent line: draw every other pixel for see-through grid.
Function.CA_LineDash {
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Input: col: Integer
    Output: Integer
    Body: {
        dx = Subtract(x1, x0)
        dy = Subtract(y1, y0)
        IfCondition LessThan(dx, 0) ThenBlock: { adx = Subtract(0, dx) }
        IfCondition GreaterEqual(dx, 0) ThenBlock: { adx = dx }
        IfCondition LessThan(dy, 0) ThenBlock: { ady = Subtract(0, dy) }
        IfCondition GreaterEqual(dy, 0) ThenBlock: { ady = dy }
        n = adx
        IfCondition GreaterThan(ady, n) ThenBlock: { n = ady }
        IfCondition LessThan(n, 1) ThenBlock: {
            FB_SetPixel(x0, y0, col)
            ReturnValue(0)
        }
        i = 0
        WhileLoop LessEqual(i, n) {
            // dash: draw 2 on, 1 off
            m = Modulo(i, 3)
            IfCondition NotEqual(m, 2) ThenBlock: {
                t = Float_Div(Float_FromInt(i), Float_FromInt(n))
                x = Add(x0, Float_ToInt(Float_Mul(t, Float_FromInt(dx))))
                y = Add(y0, Float_ToInt(Float_Mul(t, Float_FromInt(dy))))
                FB_SetPixel(x, y, col)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Draw one construction plane: UV grid + axes + normal (see-through dashes).
// active=1 → brighter border.
Function.CA_DrawOnePlane3D {
    Input: plane_h: Integer
    Input: vframe: Address
    Input: active: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(0) }
        // extent ±40 mm grid step 10
        e = Float_FromInt(40)
        step = Float_FromInt(10)
        pxyz = Allocate(32)
        a = Allocate(32)
        b = Allocate(32)
        // border color
        bc = FB_RGB(80, 200, 220)
        IfCondition EqualTo(active, 1) ThenBlock: {
            bc = FB_RGB(255, 220, 60)
        }
        gc = FB_RGB(50, 110, 130)
        // grid lines parallel to U (const v)
        v = Float_Sub(0, e)
        WhileLoop EqualTo(Float_Le(v, e), 1) {
            CAD_Plane.MapLocal(plane_h, Float_Sub(0, e), v, 0, pxyz)
            CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
            CAD_Plane.MapLocal(plane_h, e, v, 0, pxyz)
            CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
            CA_LineDash(ArrayGet(a, 0), ArrayGet(a, 1), ArrayGet(b, 0), ArrayGet(b, 1), gc)
            v = Float_Add(v, step)
        }
        // grid parallel to V (const u)
        u = Float_Sub(0, e)
        WhileLoop EqualTo(Float_Le(u, e), 1) {
            CAD_Plane.MapLocal(plane_h, u, Float_Sub(0, e), 0, pxyz)
            CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
            CAD_Plane.MapLocal(plane_h, u, e, 0, pxyz)
            CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
            CA_LineDash(ArrayGet(a, 0), ArrayGet(a, 1), ArrayGet(b, 0), ArrayGet(b, 1), gc)
            u = Float_Add(u, step)
        }
        // border solid
        CAD_Plane.MapLocal(plane_h, Float_Sub(0, e), Float_Sub(0, e), 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
        x00 = ArrayGet(a, 0)
        y00 = ArrayGet(a, 1)
        CAD_Plane.MapLocal(plane_h, e, Float_Sub(0, e), 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
        x10 = ArrayGet(a, 0)
        y10 = ArrayGet(a, 1)
        CAD_Plane.MapLocal(plane_h, e, e, 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
        x11 = ArrayGet(a, 0)
        y11 = ArrayGet(a, 1)
        CAD_Plane.MapLocal(plane_h, Float_Sub(0, e), e, 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
        x01 = ArrayGet(a, 0)
        y01 = ArrayGet(a, 1)
        FB_Line(x00, y00, x10, y10, bc)
        FB_Line(x10, y10, x11, y11, bc)
        FB_Line(x11, y11, x01, y01, bc)
        FB_Line(x01, y01, x00, y00, bc)
        // +U red, +V green, +N cyan
        CAD_Plane.MapLocal(plane_h, 0, 0, 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
        ox = ArrayGet(a, 0)
        oy = ArrayGet(a, 1)
        CAD_Plane.MapLocal(plane_h, Float_FromInt(30), 0, 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
        FB_Line(ox, oy, ArrayGet(b, 0), ArrayGet(b, 1), FB_RGB(255, 80, 80))
        CAD_Plane.MapLocal(plane_h, 0, Float_FromInt(30), 0, pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
        FB_Line(ox, oy, ArrayGet(b, 0), ArrayGet(b, 1), FB_RGB(80, 255, 120))
        CAD_Plane.MapLocal(plane_h, 0, 0, Float_FromInt(20), pxyz)
        CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
        FB_Line(ox, oy, ArrayGet(b, 0), ArrayGet(b, 1), FB_RGB(80, 220, 255))
        FB_FillRect(Subtract(ox, 3), Subtract(oy, 3), 7, 7, FB_RGB(255, 220, 80))
        Deallocate(pxyz, 32)
        Deallocate(a, 32)
        Deallocate(b, 32)
        ReturnValue(0)
    }
}

// Draw all registered planes + active; sketch lines mapped through sketch plane.
Function.CA_DrawPlanesAndSketch3D {
    Output: Integer
    Body: {
        w = CadApp.width
        h = CadApp.height_px
        need = 0
        IfCondition EqualTo(FB.initialized, 0) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.width, w) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.height, h) ThenBlock: { need = 1 }
        IfCondition EqualTo(need, 1) ThenBlock: {
            IfCondition EqualTo(FB_InitHeadless(w, h), 0) ThenBlock: { ReturnValue(-1) }
        }
        // if no solid, clear dark; if solid, already rendered into FB
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            FB_Clear(FB_RGB(24, 28, 36))
        }
        vframe = Allocate(64)
        CA_BuildViewFrame(vframe)
        // world XY always as faint reference if list empty
        IfCondition EqualTo(CadApp.plane_n, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.plane, 0) ThenBlock: {
                CA_PlaneRegister(CadApp.plane)
            }
        }
        has_act = 0
        i = 0
        WhileLoop LessThan(i, CadApp.plane_n) {
            pl = ArrayGet(CadApp.plane_list, i)
            act = 0
            IfCondition EqualTo(pl, CadApp.plane) ThenBlock: {
                act = 1
                has_act = 1
            }
            CA_DrawOnePlane3D(pl, vframe, act)
            i = Add(i, 1)
        }
        IfCondition EqualTo(has_act, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.plane, 0) ThenBlock: {
                CA_DrawOnePlane3D(CadApp.plane, vframe, 1)
            }
        }
        // project current sketch onto its plane (see original geometry in 3D)
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            skpl = CAD_Sketch.GetPlaneId(CadApp.sketch)
            IfCondition EqualTo(skpl, 0) ThenBlock: {
                skpl = CadApp.plane
            }
            IfCondition EqualTo(skpl, 0) ThenBlock: {
                // world XY frame plane
                skpl = CAD_Plane.CreateWorldXY()
                CA_PlaneRegister(skpl)
            }
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            lines = CAD_Store.Read(CadApp.sketch, 1)
            pxyz = Allocate(32)
            a = Allocate(32)
            b = Allocate(32)
            li = 0
            WhileLoop LessThan(li, nl) {
                base = Multiply(li, 4)
                u0 = ArrayGet(lines, base)
                v0 = ArrayGet(lines, Add(base, 1))
                u1 = ArrayGet(lines, Add(base, 2))
                v1 = ArrayGet(lines, Add(base, 3))
                CAD_Plane.MapLocal(skpl, u0, v0, 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, a)
                CAD_Plane.MapLocal(skpl, u1, v1, 0, pxyz)
                CA_World3ToPix(ArrayGet(pxyz, 0), ArrayGet(pxyz, 1), ArrayGet(pxyz, 2), vframe, b)
                FB_Line(ArrayGet(a, 0), ArrayGet(a, 1), ArrayGet(b, 0), ArrayGet(b, 1), FB_RGB(100, 220, 255))
                li = Add(li, 1)
            }
            Deallocate(pxyz, 32)
            Deallocate(a, 32)
            Deallocate(b, 32)
        }
        CAD_View.DrawNavCube(w, h)
        Deallocate(vframe, 64)
        ReturnValue(0)
    }
}

// New sketch on active plane (bare plane OK — no solid required).
Function.CA_SketchOnActivePlane {
    Output: Integer
    Body: {
        CA_EnsurePlane()
        IfCondition EqualTo(CadApp.plane, 0) ThenBlock: {
            CA_Log("cad_app: no plane\n", 18)
            ReturnValue(-1)
        }
        sk = CAD_Sketch.CreateSketch(1)
        IfCondition EqualTo(sk, 0) ThenBlock: {
            CA_Log("cad_app: sketch FAIL\n", 21)
            ReturnValue(-2)
        }
        CAD_Sketch.SetPlaneId(sk, CadApp.plane)
        CadApp.sketch = sk
        CadApp.nprof = 0
        CadApp.prof_user = 0
        CadApp.prof_mask = 0
        CadApp.prof_sel = 0
        CadApp.mode = 1
        CadApp.dirty = 1
        CA_PlaneRegister(CadApp.plane)
        PrintMessage("cad_app: sketch on plane pid=")
        PrintNumber(CAD_Plane.GetPid(CadApp.plane))
        PrintMessage(" (UV draw; m=3D to see plane)\n")
        ReturnValue(0)
    }
}

// Offset active plane along normal by dist_mm (integer mm). New plane becomes active.
Function.CA_PlaneOffsetMm {
    Input: dist_mm: Integer
    Output: Integer
    Body: {
        CA_EnsurePlane()
        parent = CadApp.plane
        d = Float_FromInt(dist_mm)
        pl = CAD_Plane.CreateOffset(parent, d)
        IfCondition EqualTo(pl, 0) ThenBlock: {
            CA_Log("cad_app: plane offset FAIL\n", 27)
            ReturnValue(-2)
        }
        CadApp.plane = pl
        CA_PlaneRegister(pl)
        CadApp.mode = 0
        CadApp.show_planes = 1
        PrintMessage("cad_app: plane offset ")
        PrintNumber(dist_mm)
        PrintMessage(" mm pid=")
        PrintNumber(CAD_Plane.GetPid(pl))
        PrintMessage(" (3D: orbit to see)\n")
        CA_Log("  tip: SkPln to draw on it; Flip to face parent\n", 48)
        ReturnValue(0)
    }
}

Function.CA_PlaneFlip {
    Output: Integer
    Body: {
        CA_EnsurePlane()
        IfCondition EqualTo(CAD_Plane.Flip(CadApp.plane), 0) ThenBlock: {
            CA_PlaneRegister(CadApp.plane)
            CadApp.mode = 0
            CadApp.show_planes = 1
            CA_Log("cad_app: plane flipped — 3D view updated\n", 41)
            ReturnValue(0)
        }
        CA_Log("cad_app: plane flip FAIL\n", 25)
        ReturnValue(-1)
    }
}

// Angle about local X in integer degrees.
Function.CA_PlaneAngleXDeg {
    Input: deg: Integer
    Output: Integer
    Body: {
        CA_EnsurePlane()
        // rad = deg * pi/180 ≈ deg * 0.0174533
        rpd = 0x3F91DF46A2529D39
        ang = Float_Mul(Float_FromInt(deg), rpd)
        pl = CAD_Plane.CreateAngleX(CadApp.plane, ang)
        IfCondition EqualTo(pl, 0) ThenBlock: {
            CA_Log("cad_app: plane angle FAIL\n", 26)
            ReturnValue(-2)
        }
        CadApp.plane = pl
        CA_PlaneRegister(pl)
        CadApp.mode = 0
        CadApp.show_planes = 1
        PrintMessage("cad_app: plane angleX ")
        PrintNumber(deg)
        PrintMessage(" deg pid=")
        PrintNumber(CAD_Plane.GetPid(pl))
        PrintMessage(" (3D: orbit to see)\n")
        ReturnValue(0)
    }
}

Function.CA_PlaneDatumXY {
    Output: Integer
    Body: {
        CadApp.plane = CAD_Plane.CreateWorldXY()
        CAD_Plane.EnsurePid(CadApp.plane)
        CA_PlaneRegister(CadApp.plane)
        CadApp.mode = 0
        CadApp.show_planes = 1
        CA_Log("cad_app: datum plane XY — shown in 3D\n", 38)
        ReturnValue(0)
    }
}

Function.CA_PlaneDatumXZ {
    Output: Integer
    Body: {
        CadApp.plane = CAD_Plane.CreateDatumXZ()
        CA_PlaneRegister(CadApp.plane)
        CadApp.mode = 0
        CadApp.show_planes = 1
        CA_Log("cad_app: datum plane XZ — shown in 3D\n", 38)
        ReturnValue(0)
    }
}

Function.CA_PlaneDatumYZ {
    Output: Integer
    Body: {
        CadApp.plane = CAD_Plane.CreateDatumYZ()
        CA_PlaneRegister(CadApp.plane)
        CadApp.mode = 0
        CadApp.show_planes = 1
        CA_Log("cad_app: datum plane YZ — shown in 3D\n", 38)
        ReturnValue(0)
    }
}

// Create plane from face handle + new sketch. Keeps solid.
Function.CA_SketchOnFace {
    Input: face_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_Log("cad_app: sketch-on-face needs solid\n", 36)
            ReturnValue(-1)
        }
        IfCondition EqualTo(face_handle, 0) ThenBlock: {
            CA_Log("cad_app: sketch-on-face needs face\n", 35)
            ReturnValue(-2)
        }
        pl = CAD_Plane.CreateFromFace(face_handle, CadApp.solid)
        IfCondition EqualTo(pl, 0) ThenBlock: {
            CA_Log("cad_app: plane FAIL (need planar face)\n", 39)
            ReturnValue(-2)
        }
        sk = CAD_Sketch.CreateSketch(1)
        IfCondition EqualTo(sk, 0) ThenBlock: {
            CA_Log("cad_app: sketch FAIL\n", 21)
            ReturnValue(-2)
        }
        CAD_Sketch.SetPlaneId(sk, pl)
        CadApp.plane = pl
        CadApp.sketch = sk
        CadApp.face_pick = 0
        CadApp.nprof = 0
        CadApp.prof_user = 0
        CadApp.prof_mask = 0
        CadApp.prof_sel = 0
        CadApp.mode = 1
        CadApp.dirty = 1
        CA_PlaneRegister(pl)
        CA_Log("cad_app: sketch on face (plane from B-Rep)\n", 43)
        CA_Log("  draw in UV; m=3D to see plane + solid\n", 40)
        ReturnValue(0)
    }
}

// Pick planar B-Rep face under pixel in current 3D view. Returns face handle or 0.
Function.CA_PickFaceAt {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: { ReturnValue(0) }
        mn = Allocate(32)
        mx = Allocate(32)
        IfCondition EqualTo(CAD_Topo.SolidBounds(CadApp.solid, mn, mx), 0) ThenBlock: {
            Deallocate(mn, 32)
            Deallocate(mx, 32)
            ReturnValue(0)
        }
        aabb = Allocate(64)
        ArraySet(aabb, 0, ArrayGet(mn, 0))
        ArraySet(aabb, 1, ArrayGet(mn, 1))
        ArraySet(aabb, 2, ArrayGet(mn, 2))
        ArraySet(aabb, 3, ArrayGet(mx, 0))
        ArraySet(aabb, 4, ArrayGet(mx, 1))
        ArraySet(aabb, 5, ArrayGet(mx, 2))
        fr = Allocate(64)
        CAD_View.BuildFrame(aabb, CadApp.width, CadApp.height_px, fr)
        cx = ArrayGet(fr, 0)
        cy = ArrayGet(fr, 1)
        cz = ArrayGet(fr, 2)
        scale = ArrayGet(fr, 3)
        hw = ArrayGet(fr, 4)
        hh = ArrayGet(fr, 5)
        CAD_View.EnsureCamDefaults()
        yaw = CAD_View_State.yaw_r
        pitch = CAD_View_State.pitch_r
        cyaw = CAD_Geom.Cos(yaw)
        syaw = CAD_Geom.Sin(yaw)
        cp = CAD_Geom.Cos(pitch)
        sp = CAD_Geom.Sin(pitch)
        cdx = Float_Mul(cp, syaw)
        cdy = Float_Mul(cp, cyaw)
        cdz = sp
        rx = Float_Sub(0, cdy)
        ry = cdx
        rz = 0
        rl = CAD_Num.Sqrt(Float_Add(Float_Mul(rx, rx), Float_Mul(ry, ry)))
        IfCondition EqualTo(CAD_Num.IsZero(rl, 0), 1) ThenBlock: {
            rx = 0x3FF0000000000000
            ry = 0
            rl = 0x3FF0000000000000
        }
        rx = Float_Div(rx, rl)
        ry = Float_Div(ry, rl)
        ux = Float_Sub(Float_Mul(cdy, rz), Float_Mul(cdz, ry))
        uy = Float_Sub(Float_Mul(cdz, rx), Float_Mul(cdx, rz))
        uz = Float_Sub(Float_Mul(cdx, ry), Float_Mul(cdy, rx))
        ul = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ux, ux), Float_Mul(uy, uy)), Float_Mul(uz, uz)))
        IfCondition EqualTo(CAD_Num.IsZero(ul, 0), 0) ThenBlock: {
            ux = Float_Div(ux, ul)
            uy = Float_Div(uy, ul)
            uz = Float_Div(uz, ul)
        }
        uu = Float_Div(Float_Sub(Float_FromInt(px), hw), scale)
        vv = Float_Div(Float_Sub(hh, Float_FromInt(py)), scale)
        ox = Float_Add(cx, Float_Add(Float_Mul(uu, rx), Float_Mul(vv, ux)))
        oy = Float_Add(cy, Float_Add(Float_Mul(uu, ry), Float_Mul(vv, uy)))
        oz = Float_Add(cz, Float_Add(Float_Mul(uu, rz), Float_Mul(vv, uz)))
        far = 0x40C3880000000000
        ray = Allocate(64)
        ArraySet(ray, 0, Float_Add(ox, Float_Mul(far, cdx)))
        ArraySet(ray, 1, Float_Add(oy, Float_Mul(far, cdy)))
        ArraySet(ray, 2, Float_Add(oz, Float_Mul(far, cdz)))
        ArraySet(ray, 3, Float_Sub(0, cdx))
        ArraySet(ray, 4, Float_Sub(0, cdy))
        ArraySet(ray, 5, Float_Sub(0, cdz))
        outp = Allocate(64)
        ok = CAD_Topo.PickFaceRay(CadApp.solid, ray, outp)
        fh = 0
        IfCondition EqualTo(ok, 1) ThenBlock: {
            fh = ArrayGet(outp, 0)
        }
        Deallocate(ray, 64)
        Deallocate(outp, 64)
        Deallocate(mn, 32)
        Deallocate(mx, 32)
        Deallocate(aabb, 64)
        Deallocate(fr, 64)
        ReturnValue(fh)
    }
}

// Revolve selected profile about a vertical axis -> solid of revolution (+Z).
// Axis (v1, no click-pick yet):
//   1) Optional: nearly-vertical sketch line that is NOT a profile AABB edge
//      (construction / centerline) -- longest wins.
//   2) Else default: sketch Y-axis (X=0).
// Radius = |X - axis_x|; height = Y. Full profile lathe (arcs/notches kept).
Function.CA_RevolveFromSketch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: revolve needs sketch\n", 30)
            ReturnValue(-1)
        }
        sk_nprof = CAD_Store.Read(CadApp.sketch, 12)
        IfCondition EqualTo(sk_nprof, 0) ThenBlock: {
            sk_nprof = CA_RebuildProfiles()
        }
        CadApp.nprof = sk_nprof
        IfCondition EqualTo(sk_nprof, 0) ThenBlock: {
            CA_Log("cad_app: revolve FAIL - no closed profile\n", 42)
            CA_Log("  draw profile; axis = Y-axis or a vertical line; Profiles then Rev\n", 68)
            ReturnValue(-2)
        }
        IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
            CA_ApplyProfileSel(0, sk_nprof, 0)
        }
        IfCondition EqualTo(CadApp.prof_mask, 0) ThenBlock: {
            CadApp.prof_mask = LeftShift(1, CadApp.prof_sel)
        }
        // largest selected = revolve profile (true verts, not AABB)
        xy = Allocate(65536)
        oxy = Allocate(65536)
        outer_i = -1
        outer_a = 0
        outer_nn = 0
        pi = 0
        WhileLoop LessThan(pi, sk_nprof) {
            IfCondition LessThan(pi, 32) ThenBlock: {
                bit = LeftShift(1, pi)
                IfCondition NotEqual(BitwiseAnd(CadApp.prof_mask, bit), 0) ThenBlock: {
                    nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                    IfCondition GreaterEqual(nn, 3) ThenBlock: {
                        ar = CAD_Sketch.LoopSignedArea(xy, nn)
                        IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                        better = 0
                        IfCondition EqualTo(outer_i, -1) ThenBlock: { better = 1 }
                        IfCondition EqualTo(Float_Le(outer_a, ar), 1) ThenBlock: {
                            IfCondition NotEqual(pi, outer_i) ThenBlock: { better = 1 }
                        }
                        IfCondition EqualTo(better, 1) ThenBlock: {
                            outer_i = pi
                            outer_a = ar
                            outer_nn = nn
                            k = 0
                            WhileLoop LessThan(k, nn) {
                                ArraySet(oxy, Multiply(k, 2), ArrayGet(xy, Multiply(k, 2)))
                                ArraySet(oxy, Add(Multiply(k, 2), 1), ArrayGet(xy, Add(Multiply(k, 2), 1)))
                                k = Add(k, 1)
                            }
                        }
                    }
                }
            }
            pi = Add(pi, 1)
        }
        IfCondition LessThan(outer_i, 0) ThenBlock: {
            Deallocate(xy, 65536)
            Deallocate(oxy, 65536)
            CA_Log("cad_app: revolve FAIL - nothing selected\n", 41)
            ReturnValue(-2)
        }
        onn = outer_nn
        oaddr = oxy
        PrintMessage("cad_app: revolve prof=")
        PrintNumber(outer_i)
        PrintMessage(" nn=")
        PrintNumber(onn)
        PrintMessage("\n")
        // profile AABB (axis pick + logs only)
        xmin = ArrayGet(oaddr, 0)
        ymin = ArrayGet(oaddr, 1)
        xmax = xmin
        ymax = ymin
        k = 0
        WhileLoop LessThan(k, onn) {
            x = ArrayGet(oaddr, Multiply(k, 2))
            y = ArrayGet(oaddr, Add(Multiply(k, 2), 1))
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            k = Add(k, 1)
        }
        // --- pick vertical revolve axis ---
        axis_x = 0
        axis_src = 0
        best_len = 0
        ph = Float_Sub(ymax, ymin)
        min_len = Float_Mul(ph, 0x3FD0000000000000)
        IfCondition EqualTo(Float_Le(min_len, Float_FromInt(1)), 1) ThenBlock: {
            min_len = Float_FromInt(1)
        }
        nl = CAD_Sketch.GetLineCount(CadApp.sketch)
        lines = CAD_Store.Read(CadApp.sketch, 1)
        li = 0
        WhileLoop LessThan(li, nl) {
            b = Multiply(li, 4)
            lx0 = ArrayGet(lines, b)
            ly0 = ArrayGet(lines, Add(b, 1))
            lx1 = ArrayGet(lines, Add(b, 2))
            ly1 = ArrayGet(lines, Add(b, 3))
            dx = Float_Sub(lx1, lx0)
            dy = Float_Sub(ly1, ly0)
            IfCondition EqualTo(Float_Le(dx, 0), 1) ThenBlock: { dx = Float_Sub(0, dx) }
            IfCondition EqualTo(Float_Le(dy, 0), 1) ThenBlock: { dy = Float_Sub(0, dy) }
            is_vert = 0
            IfCondition EqualTo(Float_Le(min_len, dy), 1) ThenBlock: {
                lim = Float_Mul(dy, 0x3FA999999999999A)
                IfCondition EqualTo(Float_Le(dx, lim), 1) ThenBlock: { is_vert = 1 }
                IfCondition EqualTo(CAD_Num.IsEqual(lx0, lx1, 0), 1) ThenBlock: { is_vert = 1 }
            }
            IfCondition EqualTo(is_vert, 1) ThenBlock: {
                ax = Float_Mul(Float_Add(lx0, lx1), 0x3FE0000000000000)
                skip = 0
                IfCondition EqualTo(CAD_Num.IsEqual(ax, xmin, 0), 1) ThenBlock: { skip = 1 }
                IfCondition EqualTo(CAD_Num.IsEqual(ax, xmax, 0), 1) ThenBlock: { skip = 1 }
                IfCondition EqualTo(skip, 0) ThenBlock: {
                    IfCondition EqualTo(Float_Le(best_len, dy), 1) ThenBlock: {
                        best_len = dy
                        axis_x = ax
                        axis_src = 1
                    }
                }
            }
            li = Add(li, 1)
        }
        ax0 = axis_x
        asrc = axis_src
        IfCondition EqualTo(asrc, 1) ThenBlock: {
            PrintMessage("cad_app: revolve axis X=")
            PrintNumber(Float_ToInt(ax0))
            PrintMessage(" (vertical line)\n")
        }
        IfCondition EqualTo(asrc, 0) ThenBlock: {
            CA_Log("cad_app: revolve axis X=0 (sketch Y-axis)\n", 42)
            CA_Log("  tip: draw a vertical line for a custom axis\n", 46)
        }
        // map EVERY profile vertex: rho = |x - axis|, z = y  (true lathe section)
        rz = Allocate(16384)
        k = 0
        rmin = 0
        rmax = 0
        first = 1
        WhileLoop LessThan(k, onn) {
            x = ArrayGet(oaddr, Multiply(k, 2))
            y = ArrayGet(oaddr, Add(Multiply(k, 2), 1))
            dr = Float_Sub(x, ax0)
            IfCondition EqualTo(Float_Le(dr, 0), 1) ThenBlock: { dr = Float_Sub(0, dr) }
            ArraySet(rz, Multiply(k, 2), dr)
            ArraySet(rz, Add(Multiply(k, 2), 1), y)
            IfCondition EqualTo(first, 1) ThenBlock: {
                rmin = dr
                rmax = dr
                first = 0
            }
            IfCondition EqualTo(Float_Le(dr, rmin), 1) ThenBlock: { rmin = dr }
            IfCondition EqualTo(Float_Le(rmax, dr), 1) ThenBlock: { rmax = dr }
            k = Add(k, 1)
        }
        IfCondition EqualTo(CAD_Num.IsZero(rmax, 0), 1) ThenBlock: {
            Deallocate(xy, 65536)
            Deallocate(oxy, 65536)
            Deallocate(rz, 16384)
            CA_Log("cad_app: revolve FAIL - zero radius (profile on axis)\n", 54)
            CA_Log("  offset profile from axis, or draw vertical axis line\n", 55)
            ReturnValue(-3)
        }
        // build RZ sketch with real profile edges (not AABB box)
        rsk = CAD_Sketch.CreateSketch(1)
        IfCondition EqualTo(rsk, 0) ThenBlock: {
            Deallocate(xy, 65536)
            Deallocate(oxy, 65536)
            Deallocate(rz, 16384)
            ReturnValue(-1)
        }
        k = 0
        WhileLoop LessThan(k, onn) {
            kn = Add(k, 1)
            IfCondition EqualTo(kn, onn) ThenBlock: { kn = 0 }
            x0 = ArrayGet(rz, Multiply(k, 2))
            y0 = ArrayGet(rz, Add(Multiply(k, 2), 1))
            x1 = ArrayGet(rz, Multiply(kn, 2))
            y1 = ArrayGet(rz, Add(Multiply(kn, 2), 1))
            CAD_Sketch.AddLine(rsk, x0, y0, x1, y1)
            k = Add(k, 1)
        }
        CAD_Sketch.BuildClosedLoop(rsk)
        // also BuildAllClosedLoops so GetProfileXY path works
        CAD_Sketch.BuildAllClosedLoops(rsk)
        PrintMessage("cad_app: revolve lathe n=")
        PrintNumber(onn)
        PrintMessage(" r=")
        PrintNumber(Float_ToInt(rmin))
        PrintMessage("..")
        PrintNumber(Float_ToInt(rmax))
        PrintMessage(" (profile, not AABB)\n")
        h = CAD_Feat.RevolveProfile(rsk, 0)
        Deallocate(xy, 65536)
        Deallocate(oxy, 65536)
        Deallocate(rz, 16384)
        IfCondition EqualTo(h, 0) ThenBlock: {
            CA_Log("cad_app: revolve FAIL (kernel lathe)\n", 37)
            ReturnValue(-2)
        }
        CadApp.solid = h
        CadApp.dirty = 0
        CadApp.mode = 0
        CA_Log("cad_app: revolve OK (profile lathe)\n", 36)
        ReturnValue(0)
    }
}

// ExtrudeCut current/hole sketch into existing solid (through height).
Function.CA_CutFromSketch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_Log("cad_app: cut needs solid (pad first)\n", 38)
            ReturnValue(-1)
        }
        sk = CadApp.sketch
        IfCondition NotEqual(CadApp.hole_sk, 0) ThenBlock: {
            sk = CadApp.hole_sk
        }
        IfCondition EqualTo(sk, 0) ThenBlock: {
            CA_Log("cad_app: cut needs sketch\n", 26)
            ReturnValue(-1)
        }
        hgt = Float_FromInt(CadApp.height)
        cut = CAD_Feat.ExtrudeCut(CadApp.solid, sk, hgt)
        IfCondition EqualTo(cut, 0) ThenBlock: {
            CA_Log("cad_app: cut FAIL\n", 18)
            ReturnValue(-2)
        }
        CadApp.solid = cut
        CadApp.dirty = 0
        CA_Log("cad_app: cut ok\n", 16)
        ReturnValue(0)
    }
}

Function.CA_ImportDxf {
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(0) }
        out = Allocate(16)
        rc = CAD_DXF.ImportFile(path, out)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            Deallocate(out, 16)
            CA_Log("cad_app: DXF import FAIL\n", 25)
            ReturnValue(0)
        }
        h = ArrayGet(out, 0)
        Deallocate(out, 16)
        ReturnValue(h)
    }
}

Function.CA_LoadDxfToSketch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.dxf_path, 0) ThenBlock: { ReturnValue(-1) }
        // drop previous solid so viewport does not keep last pad while loading
        CadApp.solid = 0
        CadApp.sketch = CA_ImportDxf(CadApp.dxf_path)
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        CadApp.hole_sk = 0
        IfCondition NotEqual(CadApp.hole_path, 0) ThenBlock: {
            CadApp.hole_sk = CA_ImportDxf(CadApp.hole_path)
            IfCondition EqualTo(CadApp.hole_sk, 0) ThenBlock: {
                CA_Log("cad_app: hole DXF FAIL\n", 23)
                ReturnValue(-1)
            }
        }
        // file import: auto pad outer (+ holes) — not interactive selection
        CadApp.auto_pad = 1
        CadApp.prof_user = 0
        rc = CA_BuildSolid()
        CadApp.auto_pad = 0
        ReturnValue(rc)
    }
}

Function.CA_ReloadDxf {
    Output: Integer
    Body: {
        CA_Log("cad_app: reload DXF\n", 20)
        ReturnValue(CA_LoadDxfToSketch())
    }
}

// Ensure PG connection + schema (once).
Function.CA_RepoEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.repo_ok, 1) ThenBlock: { ReturnValue(0) }
        rc = CAD_Repo.ConnectLocal()
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: PG connect FAIL (need cad_db)\n", 40)
            ReturnValue(-1)
        }
        rc = CAD_Repo.InitSchema(0)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: PG schema FAIL\n", 24)
            ReturnValue(-1)
        }
        CadApp.repo_ok = 1
        CA_Log("cad_app: PG ready\n", 18)
        ReturnValue(0)
    }
}

// Ensure we have a writable name buffer; default "untitled".
Function.CA_EnsureName {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.name_buf, 0) ThenBlock: {
            CadApp.name_buf = Allocate(80)
            // default untitled
            SetByte(CadApp.name_buf, 0, 117)
            SetByte(CadApp.name_buf, 1, 110)
            SetByte(CadApp.name_buf, 2, 116)
            SetByte(CadApp.name_buf, 3, 105)
            SetByte(CadApp.name_buf, 4, 116)
            SetByte(CadApp.name_buf, 5, 108)
            SetByte(CadApp.name_buf, 6, 101)
            SetByte(CadApp.name_buf, 7, 100)
            SetByte(CadApp.name_buf, 8, 0)
        }
        IfCondition EqualTo(CadApp.part_name, 0) ThenBlock: {
            CadApp.part_name = CadApp.name_buf
        }
        ReturnValue(0)
    }
}

// Copy C-string src into name_buf and set part_name.
Function.CA_SetPartName {
    Input: src: Address
    Output: Integer
    Body: {
        CA_EnsureName()
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(-1) }
        i = 0
        WhileLoop LessThan(i, 63) {
            c = GetByte(src, i)
            SetByte(CadApp.name_buf, i, c)
            IfCondition EqualTo(c, 0) ThenBlock: {
                i = 64
            }
            IfCondition NotEqual(c, 0) ThenBlock: {
                i = Add(i, 1)
            }
        }
        SetByte(CadApp.name_buf, 63, 0)
        CadApp.part_name = CadApp.name_buf
        ReturnValue(0)
    }
}

// Write list_buf + selection to IPC files for host overlay.
Function.CA_WriteListFiles {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.list_buf, 0) ThenBlock: {
            CA_WriteFileStr("/tmp/cad_app/parts.txt", "(empty)\n", 8)
        }
        IfCondition NotEqual(CadApp.list_buf, 0) ThenBlock: {
            fd = SystemCall(2, "/tmp/cad_app/parts.txt", 577, 420)
            IfCondition GreaterEqual(fd, 0) ThenBlock: {
                // write up to 4000 chars
                n = 0
                WhileLoop LessThan(n, 4000) {
                    IfCondition EqualTo(GetByte(CadApp.list_buf, n), 0) ThenBlock: {
                        n = 4000
                    }
                    IfCondition LessThan(n, 4000) ThenBlock: {
                        IfCondition NotEqual(GetByte(CadApp.list_buf, n), 0) ThenBlock: {
                            n = Add(n, 1)
                        }
                    }
                }
                // recount properly
                n = 0
                WhileLoop NotEqual(GetByte(CadApp.list_buf, n), 0) {
                    n = Add(n, 1)
                    IfCondition GreaterThan(n, 4000) ThenBlock: {
                        n = 4000
                    }
                }
                SystemCall(1, fd, CadApp.list_buf, n)
                SystemCall(3, fd, 0, 0)
            }
        }
        // sel index
        sb = Allocate(16)
        pos = 0
        v = CadApp.list_sel
        IfCondition EqualTo(v, 0) ThenBlock: {
            SetByte(sb, 0, 48)
            pos = 1
        }
        IfCondition GreaterThan(v, 0) ThenBlock: {
            tmp = Allocate(16)
            n = 0
            WhileLoop GreaterThan(v, 0) {
                SetByte(tmp, n, Add(48, Modulo(v, 10)))
                v = Divide(v, 10)
                n = Add(n, 1)
            }
            i = Subtract(n, 1)
            WhileLoop GreaterEqual(i, 0) {
                SetByte(sb, pos, GetByte(tmp, i))
                pos = Add(pos, 1)
                i = Subtract(i, 1)
            }
            Deallocate(tmp, 16)
        }
        SetByte(sb, pos, 10)
        pos = Add(pos, 1)
        SetByte(sb, pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/sel.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, sb, pos)
            SystemCall(3, fd, 0, 0)
        }
        Deallocate(sb, 16)
        ReturnValue(0)
    }
}

// nth line (0-based) from list_buf → out 64-byte name. Returns 1 ok.
Function.CA_ListNameAt {
    Input: idx: Integer
    Input: out: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.list_buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        line = 0
        i = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            IfCondition EqualTo(GetByte(CadApp.list_buf, i), 0) ThenBlock: {
                done = 1
            }
            IfCondition EqualTo(done, 0) ThenBlock: {
                IfCondition EqualTo(line, idx) ThenBlock: {
                    j = 0
                    WhileLoop EqualTo(done, 0) {
                        c = GetByte(CadApp.list_buf, i)
                        IfCondition EqualTo(c, 0) ThenBlock: {
                            SetByte(out, j, 0)
                            done = 2
                        }
                        IfCondition EqualTo(c, 10) ThenBlock: {
                            SetByte(out, j, 0)
                            done = 2
                        }
                        IfCondition EqualTo(done, 0) ThenBlock: {
                            IfCondition LessThan(j, 63) ThenBlock: {
                                SetByte(out, j, c)
                                j = Add(j, 1)
                            }
                            i = Add(i, 1)
                        }
                    }
                    IfCondition EqualTo(j, 0) ThenBlock: { ReturnValue(0) }
                    ReturnValue(1)
                }
                // advance to next line
                c = GetByte(CadApp.list_buf, i)
                IfCondition EqualTo(c, 10) ThenBlock: {
                    line = Add(line, 1)
                }
                i = Add(i, 1)
            }
        }
        ReturnValue(0)
    }
}

// Refresh part list from Postgres; open browser.
Function.CA_DocList {
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_RepoEnsure(), 0) ThenBlock: {
        }
        IfCondition EqualTo(CadApp.repo_ok, 0) ThenBlock: {
            CA_Log("cad_app: list needs PG\n", 22)
            ReturnValue(-1)
        }
        IfCondition EqualTo(CadApp.list_buf, 0) ThenBlock: {
            CadApp.list_buf = Allocate(4096)
        }
        n = CAD_Repo.ListParts(CadApp.list_buf, 4096)
        IfCondition LessThan(n, 0) ThenBlock: {
            CA_Log("cad_app: list FAIL\n", 19)
            ReturnValue(-2)
        }
        CadApp.list_count = n
        CadApp.list_open = 1
        IfCondition GreaterEqual(CadApp.list_sel, n) ThenBlock: {
            CadApp.list_sel = 0
        }
        IfCondition LessThan(n, 1) ThenBlock: {
            SetByte(CadApp.list_buf, 0, 40)
            SetByte(CadApp.list_buf, 1, 110)
            SetByte(CadApp.list_buf, 2, 111)
            SetByte(CadApp.list_buf, 3, 110)
            SetByte(CadApp.list_buf, 4, 101)
            SetByte(CadApp.list_buf, 5, 41)
            SetByte(CadApp.list_buf, 6, 10)
            SetByte(CadApp.list_buf, 7, 0)
            CadApp.list_count = 0
        }
        CA_WriteListFiles()
        CA_Log("cad_app: list open\n", 19)
        ReturnValue(0)
    }
}

Function.CA_DocSelNext {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.list_open, 0) ThenBlock: {
            ReturnValue(CA_DocList())
        }
        IfCondition GreaterThan(CadApp.list_count, 0) ThenBlock: {
            CadApp.list_sel = Add(CadApp.list_sel, 1)
            IfCondition GreaterEqual(CadApp.list_sel, CadApp.list_count) ThenBlock: {
                CadApp.list_sel = 0
            }
        }
        CA_WriteListFiles()
        ReturnValue(0)
    }
}

Function.CA_DocSelPrev {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.list_open, 0) ThenBlock: {
            ReturnValue(CA_DocList())
        }
        IfCondition LessThan(CadApp.list_count, 1) ThenBlock: {
            CA_WriteListFiles()
            ReturnValue(0)
        }
        // sel = (sel - 1 + count) % count
        s = Add(Subtract(CadApp.list_sel, 1), CadApp.list_count)
        // modulo via while
        WhileLoop GreaterEqual(s, CadApp.list_count) {
            s = Subtract(s, CadApp.list_count)
        }
        CadApp.list_sel = s
        CA_WriteListFiles()
        ReturnValue(0)
    }
}

// Open selected list entry (or current part_name if list closed).
Function.CA_DocOpen {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.list_open, 1) ThenBlock: {
            IfCondition GreaterThan(CadApp.list_count, 0) ThenBlock: {
                nm = Allocate(80)
                IfCondition EqualTo(CA_ListNameAt(CadApp.list_sel, nm), 1) ThenBlock: {
                    CA_SetPartName(nm)
                }
                Deallocate(nm, 80)
            }
        }
        ReturnValue(CA_RepoLoad())
    }
}

// Wipe solid + sketch + hole + profile selection (the "data tree").
// Forces sketch mode so viewport is empty axes, not the last pad.
Function.CA_ClearModel {
    Output: Integer
    Body: {
        // drop solid handle (viewport must not re-render last body)
        CadApp.solid = 0
        CadApp.hole_sk = 0
        CadApp.hole_path = 0
        // replace sketch with empty (orphan old sketch store entries)
        CadApp.sketch = CAD_Sketch.CreateSketch(1)
        CadApp.nclick = 0
        CadApp.hover_ok = 0
        CadApp.cx0 = 0
        CadApp.cy0 = 0
        CadApp.arc_a0 = 0
        CadApp.arc_rad = 0
        CadApp.tool = 0
        CadApp.nprof = 0
        CadApp.prof_sel = 0
        CadApp.prof_user = 0
        CadApp.mode = 1
        CadApp.dirty = 0
        CadApp.auto_pad = 0
        // clear framebuffer so last pad pixels cannot linger
        w = CadApp.width
        h = CadApp.height_px
        IfCondition LessThan(w, 16) ThenBlock: { w = 800 }
        IfCondition LessThan(h, 16) ThenBlock: { h = 600 }
        need = 0
        IfCondition EqualTo(FB.initialized, 0) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.width, w) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.height, h) ThenBlock: { need = 1 }
        IfCondition EqualTo(need, 1) ThenBlock: {
            FB_InitHeadless(w, h)
        }
        FB_Clear(FB_RGB(24, 28, 36))
        ReturnValue(0)
    }
}

// Close document: clear model tree, untitled
Function.CA_DocClose {
    Output: Integer
    Body: {
        CA_ClearModel()
        CadApp.part_rev = 0
        CadApp.list_open = 0
        CA_SetPartName("untitled")
        CA_Log("cad_app: closed (model cleared)\n", 30)
        ReturnValue(0)
    }
}

// New document: empty sketch + no solid, name partN
Function.CA_DocNew {
    Output: Integer
    Body: {
        CA_EnsureName()
        // name part + gen
        SetByte(CadApp.name_buf, 0, 112)
        SetByte(CadApp.name_buf, 1, 97)
        SetByte(CadApp.name_buf, 2, 114)
        SetByte(CadApp.name_buf, 3, 116)
        // append digits of gen+1
        v = Add(CadApp.gen, 1)
        // write at least one digit
        tmp = Allocate(16)
        n = 0
        IfCondition EqualTo(v, 0) ThenBlock: {
            SetByte(tmp, 0, 48)
            n = 1
        }
        WhileLoop GreaterThan(v, 0) {
            SetByte(tmp, n, Add(48, Modulo(v, 10)))
            v = Divide(v, 10)
            n = Add(n, 1)
        }
        p = 4
        i = Subtract(n, 1)
        WhileLoop GreaterEqual(i, 0) {
            SetByte(CadApp.name_buf, p, GetByte(tmp, i))
            p = Add(p, 1)
            i = Subtract(i, 1)
        }
        SetByte(CadApp.name_buf, p, 0)
        Deallocate(tmp, 16)
        CadApp.part_name = CadApp.name_buf
        // full wipe: solid + sketch + profiles (viewport no longer shows last pad)
        CA_ClearModel()
        CadApp.dirty = 1
        CadApp.part_rev = 0
        CadApp.list_open = 0
        CA_Log("cad_app: new doc (model cleared)\n", 32)
        ReturnValue(0)
    }
}

// Save current sketch+solid+hole to Postgres under CadApp.part_name.
Function.CA_RepoSave {
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_RepoEnsure(), 0) ThenBlock: {
        }
        IfCondition EqualTo(CadApp.repo_ok, 0) ThenBlock: { ReturnValue(-1) }
        CA_EnsureName()
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: save needs sketch\n", 27)
            ReturnValue(-3)
        }
        // pad first if solid missing but sketch exists
        IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
            CA_PadFromSketch()
        }
        rc = CAD_Repo.SavePart(CadApp.part_name, CadApp.sketch, CadApp.solid, CadApp.height, CadApp.hole_sk)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: repo save FAIL\n", 24)
            ReturnValue(rc)
        }
        CadApp.part_rev = CAD_Repo_State.last_rev
        CadApp.dirty = 0
        CadApp.list_open = 0
        CA_Log("cad_app: repo save ok\n", 22)
        ReturnValue(0)
    }
}

// Load part from Postgres by CadApp.part_name → sketch/solid/height/hole.
Function.CA_RepoLoad {
    Output: Integer
    Body: {
        IfCondition EqualTo(CA_RepoEnsure(), 0) ThenBlock: {
        }
        IfCondition EqualTo(CadApp.repo_ok, 0) ThenBlock: { ReturnValue(-1) }
        CA_EnsureName()
        pack = Allocate(64)
        rc = CAD_Repo.LoadPart(CadApp.part_name, pack)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            Deallocate(pack, 64)
            CA_Log("cad_app: repo load FAIL\n", 24)
            ReturnValue(rc)
        }
        CadApp.sketch = ArrayGet(pack, 0)
        CadApp.solid = ArrayGet(pack, 1)
        CadApp.height = ArrayGet(pack, 2)
        CadApp.hole_sk = ArrayGet(pack, 3)
        CadApp.mode = 0
        CadApp.dirty = 0
        CadApp.part_rev = CAD_Repo_State.last_rev
        CadApp.list_open = 0
        Deallocate(pack, 64)
        CA_Log("cad_app: repo load ok\n", 22)
        ReturnValue(0)
    }
}


Function.CA_NewSketch {
    Output: Integer
    Body: {
        CA_ClearModel()
        CadApp.dirty = 1
        CA_Log("cad_app: new sketch (model cleared)\n", 34)
        ReturnValue(0)
    }
}

Function.CA_WriteStatus {
    Output: Integer
    Body: {
        st = Allocate(160)
        pos = 0
        IfCondition EqualTo(CadApp.list_open, 1) ThenBlock: {
            // LIST sel/count
            msg = "LIST "
            i = 0
            WhileLoop NotEqual(GetByte(msg, i), 0) {
                SetByte(st, pos, GetByte(msg, i))
                pos = Add(pos, 1)
                i = Add(i, 1)
            }
            // sel+1
            v = Add(CadApp.list_sel, 1)
            IfCondition EqualTo(v, 0) ThenBlock: {
                SetByte(st, pos, 48)
                pos = Add(pos, 1)
            }
            IfCondition GreaterThan(v, 0) ThenBlock: {
                tmp = Allocate(16)
                n = 0
                vv = v
                WhileLoop GreaterThan(vv, 0) {
                    SetByte(tmp, n, Add(48, Modulo(vv, 10)))
                    vv = Divide(vv, 10)
                    n = Add(n, 1)
                }
                ii = Subtract(n, 1)
                WhileLoop GreaterEqual(ii, 0) {
                    SetByte(st, pos, GetByte(tmp, ii))
                    pos = Add(pos, 1)
                    ii = Subtract(ii, 1)
                }
                Deallocate(tmp, 16)
            }
            SetByte(st, pos, 47)
            pos = Add(pos, 1)
            v = CadApp.list_count
            IfCondition EqualTo(v, 0) ThenBlock: {
                SetByte(st, pos, 48)
                pos = Add(pos, 1)
            }
            IfCondition GreaterThan(v, 0) ThenBlock: {
                tmp = Allocate(16)
                n = 0
                vv = v
                WhileLoop GreaterThan(vv, 0) {
                    SetByte(tmp, n, Add(48, Modulo(vv, 10)))
                    vv = Divide(vv, 10)
                    n = Add(n, 1)
                }
                ii = Subtract(n, 1)
                WhileLoop GreaterEqual(ii, 0) {
                    SetByte(st, pos, GetByte(tmp, ii))
                    pos = Add(pos, 1)
                    ii = Subtract(ii, 1)
                }
                Deallocate(tmp, 16)
            }
            SetByte(st, pos, 32)
            pos = Add(pos, 1)
            nm = Allocate(80)
            IfCondition EqualTo(CA_ListNameAt(CadApp.list_sel, nm), 1) ThenBlock: {
                i = 0
                WhileLoop NotEqual(GetByte(nm, i), 0) {
                    IfCondition LessThan(pos, 120) ThenBlock: {
                        SetByte(st, pos, GetByte(nm, i))
                        pos = Add(pos, 1)
                    }
                    i = Add(i, 1)
                }
            }
            Deallocate(nm, 80)
            tail = "  g=open p=save"
            i = 0
            WhileLoop NotEqual(GetByte(tail, i), 0) {
                IfCondition LessThan(pos, 150) ThenBlock: {
                    SetByte(st, pos, GetByte(tail, i))
                    pos = Add(pos, 1)
                }
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(CadApp.list_open, 0) ThenBlock: {
            msg = "DOC "
            i = 0
            WhileLoop NotEqual(GetByte(msg, i), 0) {
                SetByte(st, pos, GetByte(msg, i))
                pos = Add(pos, 1)
                i = Add(i, 1)
            }
            CA_EnsureName()
            i = 0
            WhileLoop NotEqual(GetByte(CadApp.part_name, i), 0) {
                IfCondition LessThan(pos, 100) ThenBlock: {
                    SetByte(st, pos, GetByte(CadApp.part_name, i))
                    pos = Add(pos, 1)
                }
                i = Add(i, 1)
            }
            SetByte(st, pos, 32)
            pos = Add(pos, 1)
            SetByte(st, pos, 114)
            pos = Add(pos, 1)
            v = CadApp.part_rev
            IfCondition EqualTo(v, 0) ThenBlock: {
                SetByte(st, pos, 48)
                pos = Add(pos, 1)
            }
            IfCondition GreaterThan(v, 0) ThenBlock: {
                tmp = Allocate(16)
                n = 0
                vv = v
                WhileLoop GreaterThan(vv, 0) {
                    SetByte(tmp, n, Add(48, Modulo(vv, 10)))
                    vv = Divide(vv, 10)
                    n = Add(n, 1)
                }
                ii = Subtract(n, 1)
                WhileLoop GreaterEqual(ii, 0) {
                    SetByte(st, pos, GetByte(tmp, ii))
                    pos = Add(pos, 1)
                    ii = Subtract(ii, 1)
                }
                Deallocate(tmp, 16)
            }
            // always init tail (tool=3 ARC used to leave garbage → crash)
            tail = " "
            IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
                IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " LINE c1" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " LINE c2" }
                }
                IfCondition EqualTo(CadApp.tool, 1) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " RECT c1" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " RECT c2" }
                }
                IfCondition EqualTo(CadApp.tool, 2) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " CIRC center" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " CIRC radius" }
                }
                IfCondition EqualTo(CadApp.tool, 3) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " ARC center" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " ARC start" }
                    IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: { tail = " ARC end" }
                }
                IfCondition EqualTo(CadApp.tool, 9) ThenBlock: {
                    IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: { tail = " ARC3 start" }
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " ARC3 through" }
                    IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: { tail = " ARC3 end" }
                }
                IfCondition EqualTo(CadApp.tool, 4) ThenBlock: { tail = " PICK profile" }
                IfCondition EqualTo(CadApp.tool, 5) ThenBlock: { tail = " TRIM click" }
                IfCondition EqualTo(CadApp.tool, 6) ThenBlock: { tail = " POINT click" }
                IfCondition EqualTo(CadApp.tool, 8) ThenBlock: {
                    tail = " FILLET pick line"
                    IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: { tail = " FILLET 2nd line" }
                }
                IfCondition EqualTo(CadApp.tool, 7) ThenBlock: {
                    // keep tool name visible (do not let dirty/* overwrite below)
                    tail = " CSTR?"
                    IfCondition EqualTo(CadApp.cstr_type, 9) ThenBlock: { tail = " COIN 2picks" }
                    IfCondition EqualTo(CadApp.cstr_type, 7) ThenBlock: { tail = " H line" }
                    IfCondition EqualTo(CadApp.cstr_type, 8) ThenBlock: { tail = " V line" }
                    IfCondition EqualTo(CadApp.cstr_type, 1) ThenBlock: { tail = " FixO point" }
                    IfCondition EqualTo(CadApp.cstr_type, 6) ThenBlock: { tail = " DistO point" }
                    IfCondition EqualTo(CadApp.cstr_type, 11) ThenBlock: { tail = " Rad circle" }
                    IfCondition EqualTo(CadApp.cstr_type, 13) ThenBlock: { tail = " TANG 2picks" }
                    IfCondition EqualTo(CadApp.cstr_type, 10) ThenBlock: { tail = " OnLn 2picks" }
                    IfCondition EqualTo(CadApp.cstr_type, 12) ThenBlock: { tail = " EqR 2circs" }
                    IfCondition EqualTo(CadApp.cstr_type, 15) ThenBlock: { tail = " Dist 2pts" }
                    IfCondition EqualTo(CadApp.cstr_npick, 1) ThenBlock: { tail = " need 2nd pick" }
                }
                // show selection state (not while placing constraints)
                IfCondition NotEqual(CadApp.tool, 7) ThenBlock: {
                    IfCondition GreaterThan(CadApp.nprof, 0) ThenBlock: {
                        IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
                            tail = " white rings Pick"
                        }
                        IfCondition EqualTo(CadApp.prof_user, 1) ThenBlock: {
                            tail = " RED sel Shift+multi"
                        }
                    }
                }
                IfCondition EqualTo(CadApp.dirty, 1) ThenBlock: {
                    IfCondition EqualTo(CadApp.tool, 0) ThenBlock: { tail = " *LINE" }
                    IfCondition EqualTo(CadApp.tool, 1) ThenBlock: { tail = " *RECT" }
                    IfCondition EqualTo(CadApp.tool, 2) ThenBlock: { tail = " *CIRC" }
                    IfCondition EqualTo(CadApp.tool, 3) ThenBlock: { tail = " *ARC" }
                    IfCondition EqualTo(CadApp.tool, 4) ThenBlock: { tail = " *PICK" }
                    IfCondition EqualTo(CadApp.tool, 5) ThenBlock: { tail = " *TRIM" }
                    IfCondition EqualTo(CadApp.tool, 6) ThenBlock: { tail = " *POINT" }
                    // tool 7: keep COIN/H/V/... name — do not wipe with *CSTR
                }
            }
            IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
                IfCondition EqualTo(CadApp.face_pick, 1) ThenBlock: {
                    tail = " click FACE for sketch"
                }
                IfCondition EqualTo(CadApp.face_pick, 0) ThenBlock: {
                    IfCondition EqualTo(CadApp.dirty, 1) ThenBlock: {
                        tail = " *3D pad/save"
                    }
                    IfCondition EqualTo(CadApp.dirty, 0) ThenBlock: {
                        tail = " 3D"
                    }
                }
            }
            i = 0
            WhileLoop NotEqual(GetByte(tail, i), 0) {
                IfCondition LessThan(pos, 150) ThenBlock: {
                    SetByte(st, pos, GetByte(tail, i))
                    pos = Add(pos, 1)
                }
                i = Add(i, 1)
            }
            // cursor UV relative to Sketch_0 origin (integer mm)
            IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
                IfCondition EqualTo(CadApp.hover_ok, 1) ThenBlock: {
                    hxy = Allocate(32)
                    CA_PixToWorld(CadApp.hover_px, CadApp.hover_py, hxy)
                    hx = ArrayGet(hxy, 0)
                    hy = ArrayGet(hxy, 1)
                    Deallocate(hxy, 32)
                    // " u=" 
                    IfCondition LessThan(pos, 140) ThenBlock: {
                        SetByte(st, pos, 32)
                        pos = Add(pos, 1)
                        SetByte(st, pos, 117)
                        pos = Add(pos, 1)
                        SetByte(st, pos, 61)
                        pos = Add(pos, 1)
                        // signed int mm
                        neg = 0
                        IfCondition EqualTo(Float_Le(hx, 0), 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsZero(hx, 0), 0) ThenBlock: {
                                neg = 1
                                hx = Float_Sub(0, hx)
                            }
                        }
                        IfCondition EqualTo(neg, 1) ThenBlock: {
                            SetByte(st, pos, 45)
                            pos = Add(pos, 1)
                        }
                        iv = Float_ToInt(hx)
                        ns = NumberToString(iv)
                        si = 0
                        WhileLoop NotEqual(GetByte(ns, si), 0) {
                            IfCondition LessThan(pos, 150) ThenBlock: {
                                SetByte(st, pos, GetByte(ns, si))
                                pos = Add(pos, 1)
                            }
                            si = Add(si, 1)
                        }
                        SetByte(st, pos, 32)
                        pos = Add(pos, 1)
                        SetByte(st, pos, 118)
                        pos = Add(pos, 1)
                        SetByte(st, pos, 61)
                        pos = Add(pos, 1)
                        neg = 0
                        IfCondition EqualTo(Float_Le(hy, 0), 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsZero(hy, 0), 0) ThenBlock: {
                                neg = 1
                                hy = Float_Sub(0, hy)
                            }
                        }
                        IfCondition EqualTo(neg, 1) ThenBlock: {
                            SetByte(st, pos, 45)
                            pos = Add(pos, 1)
                        }
                        iv = Float_ToInt(hy)
                        ns = NumberToString(iv)
                        si = 0
                        WhileLoop NotEqual(GetByte(ns, si), 0) {
                            IfCondition LessThan(pos, 150) ThenBlock: {
                                SetByte(st, pos, GetByte(ns, si))
                                pos = Add(pos, 1)
                            }
                            si = Add(si, 1)
                        }
                    }
                }
            }
        }
        SetByte(st, pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/status.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, st, pos)
            SystemCall(3, fd, 0, 0)
        }
        Deallocate(st, 160)
        ReturnValue(0)
    }
}

Function.CA_PublishFrame {
    Output: Integer
    Body: {
        // mode 0 = 3D: solid (if any) + construction planes + projected sketch
        // mode 1 = 2D UV sketch for drawing on the active plane
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                CAD_View.SetWire(CadApp.wire)
                rc = CAD_View.RenderSolidToFB(CadApp.solid, CadApp.width, CadApp.height_px)
                IfCondition NotEqual(rc, 0) ThenBlock: {
                    CadApp.solid = 0
                }
            }
            // construction planes always drawn in 3D (even without solid)
            IfCondition EqualTo(CadApp.show_planes, 1) ThenBlock: {
                rc = CA_DrawPlanesAndSketch3D()
                IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(rc) }
            }
            IfCondition EqualTo(CadApp.show_planes, 0) ThenBlock: {
                IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
                    rc = CA_DrawSketchToFB()
                    IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(rc) }
                }
            }
        }
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
            rc = CA_DrawSketchToFB()
            IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(rc) }
        }
        CAD_View.WriteFBRaw("/tmp/cad_app/meta.bin", "/tmp/cad_app/frame.raw")
        CadApp.gen = Add(CadApp.gen, 1)
        CA_WriteGen()
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
            IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
                CA_WriteFileStr("/tmp/cad_app/status.txt", "SKETCH line  (r pad m 3d)", 25)
            }
            IfCondition EqualTo(CadApp.tool, 1) ThenBlock: {
                CA_WriteFileStr("/tmp/cad_app/status.txt", "SKETCH rect  (r pad m 3d)", 25)
            }
            IfCondition EqualTo(CadApp.tool, 2) ThenBlock: {
                CA_WriteFileStr("/tmp/cad_app/status.txt", "SKETCH circ  (r pad m 3d)", 25)
            }
        }
        CA_WriteStatus()
        CA_WriteToolFile()
        ReturnValue(0)
    }
}

// Handle sketch click at pixel px,py
Function.CA_SketchClick {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
        }
        xy = Allocate(32)
        CA_PixToWorld(px, py, xy)
        wx = ArrayGet(xy, 0)
        wy = ArrayGet(xy, 1)
        Deallocate(xy, 32)
        // line: 2 clicks
        IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: {
                CadApp.cx0 = wx
                CadApp.cy0 = wy
                CadApp.nclick = 1
            }
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                // second click — but nclick already 1 from first; use flag carefully
            }
        }
        // simpler sequential: if nclick==0 store; else complete and reset
        IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                // was already 1 before this click started... re-read logic
            }
        }
        ReturnValue(0)
    }
}

// Snap world (wx,wy): datum (O / axes) first, then line endpoints / circle rim.
// Writes snapped coords to out[0],out[1]. Returns 1 if snapped, 0 if left as-is.
Function.CA_SnapWorld {
    Input: wx: Integer
    Input: wy: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        ArraySet(out_xy, 0, wx)
        ArraySet(out_xy, 1, wy)
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        CAD_Sketch.EnsureDatum(CadApp.sketch)
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: { ReturnValue(0) }
        // snap ≈ 10 px; only to EXISTING endpoints (not current segment start)
        // Closing a poly: click near the first vertex (it is an existing endpoint after ≥1 line).
        snap = Float_Div(Float_FromInt(10), sc)
        snap2 = Float_Mul(snap, snap)
        // min length so we do not snap into a zero-length segment from tip
        minlen2 = Float_Mul(snap2, 0x4010000000000000)
        // --- CS-0: origin / axes beat free geometry (hang from sketch zero) ---
        dsn = Allocate(32)
        dhit = CAD_Sketch.SnapToDatum(CadApp.sketch, wx, wy, snap, dsn)
        IfCondition GreaterThan(dhit, 0) ThenBlock: {
            bx = ArrayGet(dsn, 0)
            by = ArrayGet(dsn, 1)
            // refuse snap that collapses current segment to ~zero
            refuse = 0
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                dx = Float_Sub(bx, CadApp.cx0)
                dy = Float_Sub(by, CadApp.cy0)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, minlen2), 1) ThenBlock: {
                    refuse = 1
                }
            }
            IfCondition EqualTo(refuse, 0) ThenBlock: {
                ArraySet(out_xy, 0, bx)
                ArraySet(out_xy, 1, by)
                Deallocate(dsn, 32)
                ReturnValue(1)
            }
        }
        Deallocate(dsn, 32)
        // user Points (pattern anchors)
        best = snap2
        bx = wx
        by = wy
        hit = 0
        nup = CAD_Sketch.GetUserPointCount(CadApp.sketch)
        IfCondition GreaterThan(nup, 0) ThenBlock: {
            upxy = Allocate(32)
            ui = 0
            WhileLoop LessThan(ui, nup) {
                CAD_Sketch.GetUserPoint(CadApp.sketch, ui, upxy)
                ax = ArrayGet(upxy, 0)
                ay = ArrayGet(upxy, 1)
                dx = Float_Sub(wx, ax)
                dy = Float_Sub(wy, ay)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    bx = ax
                    by = ay
                    hit = 1
                }
                ui = Add(ui, 1)
            }
            Deallocate(upxy, 32)
        }
        nl = CAD_Sketch.GetLineCount(CadApp.sketch)
        IfCondition LessThan(nl, 1) ThenBlock: {
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ArraySet(out_xy, 0, bx)
                ArraySet(out_xy, 1, by)
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        lines = CAD_Store.Read(CadApp.sketch, 1)
        i = 0
        WhileLoop LessThan(i, nl) {
            b = Multiply(i, 4)
            // endpoint A
            ax = ArrayGet(lines, b)
            ay = ArrayGet(lines, Add(b, 1))
            // skip if this is current segment start (would zero-length)
            skip = 0
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(ax, CadApp.cx0, 0), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(ay, CadApp.cy0, 0), 1) ThenBlock: {
                        skip = 1
                    }
                }
            }
            IfCondition EqualTo(skip, 0) ThenBlock: {
                dx = Float_Sub(wx, ax)
                dy = Float_Sub(wy, ay)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    bx = ax
                    by = ay
                    hit = 1
                }
            }
            // endpoint B
            ax = ArrayGet(lines, Add(b, 2))
            ay = ArrayGet(lines, Add(b, 3))
            skip = 0
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(ax, CadApp.cx0, 0), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(ay, CadApp.cy0, 0), 1) ThenBlock: {
                        skip = 1
                    }
                }
            }
            IfCondition EqualTo(skip, 0) ThenBlock: {
                dx = Float_Sub(wx, ax)
                dy = Float_Sub(wy, ay)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    bx = ax
                    by = ay
                    hit = 1
                }
            }
            i = Add(i, 1)
        }
        // snap onto circle rim (so box attaches to circle for pad merge)
        nc = CAD_Sketch.GetCircleCount(CadApp.sketch)
        IfCondition GreaterThan(nc, 0) ThenBlock: {
            circs = CAD_Store.Read(CadApp.sketch, 8)
            ci = 0
            WhileLoop LessThan(ci, nc) {
                base = Multiply(ci, 3)
                cx = ArrayGet(circs, base)
                cy = ArrayGet(circs, Add(base, 1))
                rad = ArrayGet(circs, Add(base, 2))
                dx = Float_Sub(wx, cx)
                dy = Float_Sub(wy, cy)
                d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                IfCondition EqualTo(CAD_Num.IsZero(d, 0), 0) ThenBlock: {
                    // distance to rim
                    dd = Float_Sub(d, rad)
                    IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
                    // within ~14 px of rim
                    IfCondition EqualTo(Float_Le(dd, snap), 1) ThenBlock: {
                        // project onto circle
                        px = Float_Add(cx, Float_Mul(rad, Float_Div(dx, d)))
                        py = Float_Add(cy, Float_Mul(rad, Float_Div(dy, d)))
                        // use if closer than current best endpoint snap
                        dx2 = Float_Sub(wx, px)
                        dy2 = Float_Sub(wy, py)
                        d2 = Float_Add(Float_Mul(dx2, dx2), Float_Mul(dy2, dy2))
                        IfCondition EqualTo(hit, 0) ThenBlock: {
                            best = d2
                            bx = px
                            by = py
                            hit = 1
                        }
                        IfCondition EqualTo(hit, 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                                best = d2
                                bx = px
                                by = py
                            }
                        }
                    }
                }
                ci = Add(ci, 1)
            }
        }
        IfCondition EqualTo(hit, 1) ThenBlock: {
            // refuse snap that collapses current segment to ~zero
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                dx = Float_Sub(bx, CadApp.cx0)
                dy = Float_Sub(by, CadApp.cy0)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, minlen2), 1) ThenBlock: {
                    IfCondition LessThan(nl, 3) ThenBlock: {
                        ReturnValue(0)
                    }
                }
            }
            ArraySet(out_xy, 0, bx)
            ArraySet(out_xy, 1, by)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Weld all line endpoints that fall within snap radius so BuildClosedLoop can chain.
Function.CA_WeldSketch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
            sc = 0x3FF0000000000000
        }
        // tight weld only — large snap was collapsing inset notches into a triangle
        snap = Float_Div(Float_FromInt(8), sc)
        snap2 = Float_Mul(snap, snap)
        nl = CAD_Sketch.GetLineCount(CadApp.sketch)
        IfCondition LessThan(nl, 2) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(CadApp.sketch, 1)
        npts = Multiply(nl, 2)
        pass = 0
        WhileLoop LessThan(pass, 3) {
            i = 0
            WhileLoop LessThan(i, npts) {
                li = Divide(i, 2)
                ei = Modulo(i, 2)
                bi = Multiply(li, 4)
                IfCondition EqualTo(ei, 0) ThenBlock: {
                    ix = ArrayGet(lines, bi)
                    iy = ArrayGet(lines, Add(bi, 1))
                }
                IfCondition EqualTo(ei, 1) ThenBlock: {
                    ix = ArrayGet(lines, Add(bi, 2))
                    iy = ArrayGet(lines, Add(bi, 3))
                }
                j = Add(i, 1)
                WhileLoop LessThan(j, npts) {
                    lj = Divide(j, 2)
                    // never weld the two ends of the SAME segment
                    IfCondition NotEqual(li, lj) ThenBlock: {
                        ej = Modulo(j, 2)
                        bj = Multiply(lj, 4)
                        IfCondition EqualTo(ej, 0) ThenBlock: {
                            jx = ArrayGet(lines, bj)
                            jy = ArrayGet(lines, Add(bj, 1))
                        }
                        IfCondition EqualTo(ej, 1) ThenBlock: {
                            jx = ArrayGet(lines, Add(bj, 2))
                            jy = ArrayGet(lines, Add(bj, 3))
                        }
                        dx = Float_Sub(ix, jx)
                        dy = Float_Sub(iy, jy)
                        d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                        IfCondition EqualTo(Float_Le(d2, snap2), 1) ThenBlock: {
                            mx = Float_Mul(Float_Add(ix, jx), 0x3FE0000000000000)
                            my = Float_Mul(Float_Add(iy, jy), 0x3FE0000000000000)
                            IfCondition EqualTo(ei, 0) ThenBlock: {
                                ArraySet(lines, bi, mx)
                                ArraySet(lines, Add(bi, 1), my)
                            }
                            IfCondition EqualTo(ei, 1) ThenBlock: {
                                ArraySet(lines, Add(bi, 2), mx)
                                ArraySet(lines, Add(bi, 3), my)
                            }
                            IfCondition EqualTo(ej, 0) ThenBlock: {
                                ArraySet(lines, bj, mx)
                                ArraySet(lines, Add(bj, 1), my)
                            }
                            IfCondition EqualTo(ej, 1) ThenBlock: {
                                ArraySet(lines, Add(bj, 2), mx)
                                ArraySet(lines, Add(bj, 3), my)
                            }
                            ix = mx
                            iy = my
                        }
                    }
                    j = Add(j, 1)
                }
                i = Add(i, 1)
            }
            pass = Add(pass, 1)
        }
        // clear cached loop so rebuild is forced
        CAD_Store.Write(CadApp.sketch, 2, 0)
        CAD_Store.Write(CadApp.sketch, 12, 0)
        ReturnValue(1)
    }
}

// Clear profile cache after geometry edits (must Profiles + select again).
// Does NOT touch lines/arcs/circles — only profile overlay cache.
Function.CA_InvalidateProfiles {
    Output: Integer
    Body: {
        IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
            CAD_Store.Write(CadApp.sketch, 2, 0)
            CAD_Store.Write(CadApp.sketch, 12, 0)
        }
        CadApp.nprof = 0
        CadApp.prof_sel = 0
        CadApp.prof_user = 0
        CadApp.prof_mask = 0
        ReturnValue(0)
    }
}

// Copy lines + circles + arcs from src sketch into empty dst (geometry only).
Function.CA_CopySketchGeom {
    Input: src: Integer
    Input: dst: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        // lines
        nl = CAD_Store.Read(src, 0)
        sl = CAD_Store.Read(src, 1)
        i = 0
        WhileLoop LessThan(i, nl) {
            b = Multiply(i, 4)
            CAD_Sketch.AddLine(dst, ArrayGet(sl, b), ArrayGet(sl, Add(b, 1)), ArrayGet(sl, Add(b, 2)), ArrayGet(sl, Add(b, 3)))
            i = Add(i, 1)
        }
        // circles
        nc = CAD_Store.Read(src, 7)
        sc = CAD_Store.Read(src, 8)
        i = 0
        WhileLoop LessThan(i, nc) {
            b = Multiply(i, 3)
            CAD_Sketch.AddCircle(dst, ArrayGet(sc, b), ArrayGet(sc, Add(b, 1)), ArrayGet(sc, Add(b, 2)))
            i = Add(i, 1)
        }
        // arcs (keep as arcs — projection clone will tessellate)
        na = CAD_Store.Read(src, 10)
        sa = CAD_Store.Read(src, 11)
        i = 0
        WhileLoop LessThan(i, na) {
            b = Multiply(i, 5)
            CAD_Sketch.AddArc(dst, ArrayGet(sa, b), ArrayGet(sa, Add(b, 1)), ArrayGet(sa, Add(b, 2)), ArrayGet(sa, Add(b, 3)), ArrayGet(sa, Add(b, 4)))
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Copy projected profile rings from src into dst profile pool only.
// Leaves dst lines/circles/arcs untouched.
Function.CA_CopyProfilesOnly {
    Input: src: Integer
    Input: dst: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        nprof = CAD_Store.Read(src, 12)
        IfCondition EqualTo(nprof, 0) ThenBlock: {
            CAD_Store.Write(dst, 12, 0)
            CAD_Store.Write(dst, 2, 0)
            ReturnValue(0)
        }
        pool = CAD_Store.Read(dst, 14)
        pmeta = CAD_Store.Read(dst, 13)
        loop = CAD_Store.Read(dst, 3)
        cap_p = CAD_Store.Read(dst, 15)
        xy = Allocate(65536)
        pool_n = 0
        pi = 0
        n_out = 0
        WhileLoop LessThan(pi, nprof) {
            IfCondition LessThan(n_out, cap_p) ThenBlock: {
                nn = CAD_Sketch.GetProfileXY(src, pi, xy)
                IfCondition GreaterEqual(nn, 3) ThenBlock: {
                    ArraySet(pmeta, Multiply(n_out, 2), nn)
                    ArraySet(pmeta, Add(Multiply(n_out, 2), 1), pool_n)
                    k = 0
                    WhileLoop LessThan(k, nn) {
                        ArraySet(pool, Multiply(Add(pool_n, k), 2), ArrayGet(xy, Multiply(k, 2)))
                        ArraySet(pool, Add(Multiply(Add(pool_n, k), 2), 1), ArrayGet(xy, Add(Multiply(k, 2), 1)))
                        k = Add(k, 1)
                    }
                    pool_n = Add(pool_n, nn)
                    n_out = Add(n_out, 1)
                }
            }
            pi = Add(pi, 1)
        }
        CAD_Store.Write(dst, 12, n_out)
        // primary loop = profile 0
        IfCondition GreaterThan(n_out, 0) ThenBlock: {
            nn0 = ArrayGet(pmeta, 0)
            off0 = ArrayGet(pmeta, 1)
            k = 0
            WhileLoop LessThan(k, nn0) {
                ArraySet(loop, Multiply(k, 2), ArrayGet(pool, Multiply(Add(off0, k), 2)))
                ArraySet(loop, Add(Multiply(k, 2), 1), ArrayGet(pool, Add(Multiply(Add(off0, k), 2), 1)))
                k = Add(k, 1)
            }
            CAD_Store.Write(dst, 2, nn0)
        }
        Deallocate(xy, 65536)
        ReturnValue(n_out)
    }
}

// Weld endpoints on a given sketch handle (projection clone).
Function.CA_WeldSketchHandle {
    Input: sk: Integer
    Input: px_tol: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sk, 0) ThenBlock: { ReturnValue(0) }
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
            sc = 0x3FF0000000000000
        }
        snap = Float_Div(Float_FromInt(px_tol), sc)
        snap2 = Float_Mul(snap, snap)
        nl = CAD_Sketch.GetLineCount(sk)
        IfCondition LessThan(nl, 2) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(sk, 1)
        npts = Multiply(nl, 2)
        pass = 0
        WhileLoop LessThan(pass, 4) {
            i = 0
            WhileLoop LessThan(i, npts) {
                li = Divide(i, 2)
                ei = Modulo(i, 2)
                bi = Multiply(li, 4)
                IfCondition EqualTo(ei, 0) ThenBlock: {
                    ix = ArrayGet(lines, bi)
                    iy = ArrayGet(lines, Add(bi, 1))
                }
                IfCondition EqualTo(ei, 1) ThenBlock: {
                    ix = ArrayGet(lines, Add(bi, 2))
                    iy = ArrayGet(lines, Add(bi, 3))
                }
                j = Add(i, 1)
                WhileLoop LessThan(j, npts) {
                    lj = Divide(j, 2)
                    IfCondition NotEqual(li, lj) ThenBlock: {
                        ej = Modulo(j, 2)
                        bj = Multiply(lj, 4)
                        IfCondition EqualTo(ej, 0) ThenBlock: {
                            jx = ArrayGet(lines, bj)
                            jy = ArrayGet(lines, Add(bj, 1))
                        }
                        IfCondition EqualTo(ej, 1) ThenBlock: {
                            jx = ArrayGet(lines, Add(bj, 2))
                            jy = ArrayGet(lines, Add(bj, 3))
                        }
                        dx = Float_Sub(ix, jx)
                        dy = Float_Sub(iy, jy)
                        d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                        IfCondition EqualTo(Float_Le(d2, snap2), 1) ThenBlock: {
                            mx = Float_Mul(Float_Add(ix, jx), 0x3FE0000000000000)
                            my = Float_Mul(Float_Add(iy, jy), 0x3FE0000000000000)
                            IfCondition EqualTo(ei, 0) ThenBlock: {
                                ArraySet(lines, bi, mx)
                                ArraySet(lines, Add(bi, 1), my)
                            }
                            IfCondition EqualTo(ei, 1) ThenBlock: {
                                ArraySet(lines, Add(bi, 2), mx)
                                ArraySet(lines, Add(bi, 3), my)
                            }
                            IfCondition EqualTo(ej, 0) ThenBlock: {
                                ArraySet(lines, bj, mx)
                                ArraySet(lines, Add(bj, 1), my)
                            }
                            IfCondition EqualTo(ej, 1) ThenBlock: {
                                ArraySet(lines, Add(bj, 2), mx)
                                ArraySet(lines, Add(bj, 3), my)
                            }
                            ix = mx
                            iy = my
                        }
                    }
                    j = Add(j, 1)
                }
                i = Add(i, 1)
            }
            pass = Add(pass, 1)
        }
        ReturnValue(1)
    }
}

// Point-in-polygon (ray cast). xy = n pairs. Returns 1 if inside.
Function.CA_PointInPoly {
    Input: wx: Integer
    Input: wy: Integer
    Input: xy: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        inside = 0
        i = 0
        j = Subtract(n, 1)
        WhileLoop LessThan(i, n) {
            xi = ArrayGet(xy, Multiply(i, 2))
            yi = ArrayGet(xy, Add(Multiply(i, 2), 1))
            xj = ArrayGet(xy, Multiply(j, 2))
            yj = ArrayGet(xy, Add(Multiply(j, 2), 1))
            // (yi > wy) != (yj > wy)  using wy < yi style: Float_Le(wy,yi)==0 means yi > wy
            a = 0
            b = 0
            IfCondition EqualTo(Float_Le(wy, yi), 0) ThenBlock: { a = 1 }
            IfCondition EqualTo(Float_Le(wy, yj), 0) ThenBlock: { b = 1 }
            IfCondition NotEqual(a, b) ThenBlock: {
                den = Float_Sub(yj, yi)
                IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                    xint = Float_Add(xi, Float_Mul(Float_Sub(xj, xi), Float_Div(Float_Sub(wy, yi), den)))
                    // wx < xint
                    IfCondition EqualTo(Float_Le(xint, wx), 0) ThenBlock: {
                        inside = Subtract(1, inside)
                    }
                }
            }
            j = i
            i = Add(i, 1)
        }
        ReturnValue(inside)
    }
}

// Project closed profiles WITHOUT mutating live sketch lines/arcs.
// Philosophy: anchors at ends + crosses + T-touches (not welding).
// Clone → anchors → split at anchors/cross → prune stubs → closed cycles →
// copy green rings + anchors onto live for display only.
Function.CA_RebuildProfiles {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.nprof = 0
            CadApp.prof_user = 0
            ReturnValue(0)
        }
        live = CadApp.sketch
        // weld arc tips to line tips on LIVE (display + topology for pad)
        IfCondition GreaterThan(CAD_Store.Read(live, 10), 0) ThenBlock: {
            CAD_Sketch.SnapArcEndsToSketch(live, 0)
        }
        // anchors on LIVE for display (does not move line geometry)
        np = CAD_Sketch.RebuildAnchors(live)
        clone = CAD_Sketch.CreateSketch(1)
        IfCondition EqualTo(clone, 0) ThenBlock: {
            CA_Log("cad_app: profile project FAIL (clone)\n", 38)
            ReturnValue(0)
        }
        CA_CopySketchGeom(live, clone)
        // Weld arc tips to line tips on clone before tess (exact UV joins)
        IfCondition GreaterThan(CAD_Store.Read(clone, 10), 0) ThenBlock: {
            CAD_Sketch.SnapArcEndsToSketch(clone, 0)
        }
        // Tessellate curves WITH forced verts at line×curve hits so a line
        // drawn through an arc/circle joins the polyline rim (anchors alone
        // are not enough — plain inscribed n-gon can miss the true crossings).
        // BuildAllClosedLoops does a single split/prune + face walk.
        IfCondition GreaterThan(CAD_Store.Read(clone, 10), 0) ThenBlock: {
            // 96: shallow Arc3 scoops need dense chords so pad fill matches purple display
            CAD_Sketch.TessellateArcs(clone, 96)
        }
        IfCondition GreaterThan(CAD_Store.Read(clone, 7), 0) ThenBlock: {
            // forces verts at line×circle AND circle×circle hits (3-circle T-junctions)
            CAD_Sketch.TessellateCircles(clone, 48)
            CAD_Store.Write(clone, 7, 0)
        }
        // BuildAllClosedLoops does ONE split+prune+face walk.
        // Extra pre-split/prune here destroyed multi-circle graphs (nprof→1).
        // freehand snap after dense tess (absolute 1.0) so Arc3/V tip near-misses
        // still weld even when min tess chord is short
        CAD_Sketch.SnapNearEndpoints(clone, 0x3FF0000000000000)
        n = CAD_Sketch.BuildAllClosedLoops(clone)
        IfCondition EqualTo(n, 0) ThenBlock: {
            CAD_Sketch.SnapNearEndpoints(clone, 0x4000000000000000)
            n = CAD_Sketch.BuildAllClosedLoops(clone)
        }
        n = CA_CopyProfilesOnly(clone, live)
        CadApp.nprof = n
        CadApp.prof_sel = 0
        CadApp.prof_user = 0
        CadApp.prof_mask = 0
        // live sketch keeps original circles/arcs/lines — anchors are markers only
        CAD_Sketch.RebuildAnchors(live)
        PrintMessage("cad_app: profiles n=")
        PrintNumber(n)
        PrintMessage("\n")
        IfCondition EqualTo(n, 0) ThenBlock: {
            CA_Log("cad_app: no closed profile\n", 28)
            CA_Log("  tip: Trim free overshoots past crosses, then Profiles\n", 55)
            CA_Log("  (stubs can block face-walk; FreeCAD is picky too)\n", 51)
            ReturnValue(0)
        }
        // log each face area so circle-notch / multi-face is visible in terminal
        xy_dbg = Allocate(65536)
        pii = 0
        WhileLoop LessThan(pii, n) {
            nnd = CAD_Sketch.GetProfileXY(live, pii, xy_dbg)
            ard = CAD_Sketch.LoopSignedArea(xy_dbg, nnd)
            IfCondition EqualTo(Float_Le(ard, 0), 1) ThenBlock: { ard = Float_Sub(0, ard) }
            PrintMessage("  face ")
            PrintNumber(pii)
            PrintMessage(" nn=")
            PrintNumber(nnd)
            PrintMessage(" area=")
            PrintNumber(Float_ToInt(ard))
            PrintMessage("\n")
            pii = Add(pii, 1)
        }
        Deallocate(xy_dbg, 65536)
        // Default Pad face: largest |area|, with height tie-break so full V+tip
        // wins over a mid-band between two arcs (profilefail1 red upper-only).
        best_i = 0
        best_ar = 0
        best_nn = 0
        best_h = 0
        xy = Allocate(65536)
        pi = 0
        WhileLoop LessThan(pi, n) {
            nn = CAD_Sketch.GetProfileXY(live, pi, xy)
            IfCondition GreaterEqual(nn, 3) ThenBlock: {
                ar = CAD_Sketch.LoopSignedArea(xy, nn)
                IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                ymin = ArrayGet(xy, 1)
                ymax = ymin
                k = 0
                WhileLoop LessThan(k, nn) {
                    y = ArrayGet(xy, Add(Multiply(k, 2), 1))
                    IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
                    IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
                    k = Add(k, 1)
                }
                ht = Float_Sub(ymax, ymin)
                take = 0
                IfCondition EqualTo(pi, 0) ThenBlock: { take = 1 }
                // strictly larger area
                IfCondition EqualTo(Float_Le(best_ar, ar), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(ar, best_ar, 0), 0) ThenBlock: { take = 1 }
                }
                // within 15% of best area → prefer taller (full cone vs mid band)
                IfCondition EqualTo(take, 0) ThenBlock: {
                    IfCondition EqualTo(Float_Le(0, best_ar), 0) ThenBlock: {
                        // ar >= 0.85 * best_ar
                        IfCondition EqualTo(Float_Le(Float_Mul(best_ar, 0x3FEB333333333333), ar), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(best_h, ht), 1) ThenBlock: {
                                IfCondition EqualTo(CAD_Num.IsEqual(ht, best_h, 0), 0) ThenBlock: { take = 1 }
                            }
                        }
                    }
                }
                // exact area tie: more verts
                IfCondition EqualTo(CAD_Num.IsEqual(ar, best_ar, 0), 1) ThenBlock: {
                    IfCondition GreaterThan(nn, best_nn) ThenBlock: { take = 1 }
                }
                IfCondition EqualTo(take, 1) ThenBlock: {
                    best_ar = ar
                    best_i = pi
                    best_nn = nn
                    best_h = ht
                }
            }
            pi = Add(pi, 1)
        }
        Deallocate(xy, 65536)
        CAD_Store.Write(live, 12, n)
        CadApp.nprof = n
        // Always select the best face so full outer shows red; Next/Pick to change.
        // Dim gray outlines show other solved faces (multi-arc band, holes, …).
        CadApp.prof_sel = best_i
        CadApp.prof_user = 1
        CadApp.prof_mask = LeftShift(1, best_i)
        CAD_Sketch.SelectProfile(live, best_i)
        CAD_Store.Write(live, 12, n)
        IfCondition EqualTo(n, 1) ThenBlock: {
            CA_Log("cad_app: 1 profile — Pad ready (red)\n", 36)
            ReturnValue(1)
        }
        CA_Log("cad_app: multi profiles — largest selected (red); Next/Pick others\n", 60)
        CA_Log("  dim gray = other solved faces; Shift+click multi-select\n", 55)
        ReturnValue(n)
    }
}

// Apply selection. add_mode=0 replace; add_mode=1 toggle bit (Shift+click multi).
// Returns 1 on success.
Function.CA_ApplyProfileSel {
    Input: idx: Integer
    Input: nprof: Integer
    Input: add_mode: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(idx, nprof) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(idx, 31) ThenBlock: { ReturnValue(0) }
        xy = Allocate(65536)
        nn = CAD_Sketch.GetProfileXY(CadApp.sketch, idx, xy)
        Deallocate(xy, 65536)
        IfCondition LessThan(nn, 3) ThenBlock: {
            CA_Log("cad_app: select FAIL — empty ring\n", 34)
            ReturnValue(0)
        }
        bit = LeftShift(1, idx)
        IfCondition EqualTo(add_mode, 0) ThenBlock: {
            CadApp.prof_mask = bit
            CadApp.prof_sel = idx
        }
        IfCondition EqualTo(add_mode, 1) ThenBlock: {
            CadApp.prof_mask = BitwiseXor(CadApp.prof_mask, bit)
            CadApp.prof_sel = idx
            // if nothing left selected, keep user flag off
            IfCondition EqualTo(CadApp.prof_mask, 0) ThenBlock: {
                CadApp.prof_user = 0
                CAD_Store.Write(CadApp.sketch, 12, nprof)
                CadApp.nprof = nprof
                ReturnValue(1)
            }
        }
        CAD_Sketch.SelectProfile(CadApp.sketch, idx)
        CAD_Store.Write(CadApp.sketch, 12, nprof)
        CadApp.prof_user = 1
        CadApp.nprof = nprof
        ReturnValue(1)
    }
}

// Find best profile under (wx,wy); returns index or -1.
//
// POINT IN FACE (primary): any stored face that contains the click is eligible,
// including small real triangles (nn==3). Nested: pick smallest containing
// (hole). Sibling faces (diagonal split): only one contains the click.
//
// EDGE FALLBACK: ignore true micro junk (area < 1% of largest) and prefer
// largest area among near-ties so connector spikes do not steal the outer.
Function.CA_HitProfile {
    Input: wx: Integer
    Input: wy: Integer
    Input: nprof: Integer
    Output: Integer
    Body: {
        xy = Allocate(65536)
        // max area among all profiles (for edge-hit micro ignore only)
        max_ar_all = 0
        pi = 0
        WhileLoop LessThan(pi, nprof) {
            nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
            IfCondition GreaterEqual(nn, 3) ThenBlock: {
                ar = CAD_Sketch.LoopSignedArea(xy, nn)
                IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                IfCondition EqualTo(Float_Le(max_ar_all, ar), 1) ThenBlock: { max_ar_all = ar }
            }
            pi = Add(pi, 1)
        }
        // 1% of max — edge path only (not point-in-poly)
        ar_floor = Float_Mul(max_ar_all, 0x3F847AE147AE147B)

        // --- point-in-poly: ALL faces with nn>=3, pick SMALLEST containing ---
        // Click inside right triangle → only that face contains → select triangle.
        // Click in main body → main body (and outer if both contain → smaller wins
        // only when nested; siblings are mutually exclusive).
        best_in = -1
        best_in_a = 0
        found_in = 0
        pi = 0
        WhileLoop LessThan(pi, nprof) {
            nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
            IfCondition GreaterEqual(nn, 3) ThenBlock: {
                IfCondition EqualTo(CA_PointInPoly(wx, wy, xy, nn), 1) ThenBlock: {
                    ar = CAD_Sketch.LoopSignedArea(xy, nn)
                    IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                    IfCondition EqualTo(found_in, 0) ThenBlock: {
                        found_in = 1
                        best_in = pi
                        best_in_a = ar
                    }
                    // smallest containing (nested hole / the triangle under the big outer)
                    IfCondition EqualTo(Float_Le(ar, best_in_a), 1) ThenBlock: {
                        best_in = pi
                        best_in_a = ar
                    }
                }
            }
            pi = Add(pi, 1)
        }
        IfCondition EqualTo(found_in, 1) ThenBlock: {
            Deallocate(xy, 65536)
            ReturnValue(best_in)
        }

        // --- edge fallback (no interior hit) ---
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: { sc = 0x3FF0000000000000 }
        lim = Float_Div(Float_FromInt(40), sc)
        lim2 = Float_Mul(lim, lim)
        best_d2 = lim2
        found_e = 0
        pi = 0
        WhileLoop LessThan(pi, nprof) {
            nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
            ar = CAD_Sketch.LoopSignedArea(xy, nn)
            IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
            // edge path: skip tiny junk, but keep real triangles (ar >= floor OR nn==3 with ar>=0.5% max)
            ok_ar = 1
            IfCondition GreaterThan(nprof, 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(ar, ar_floor), 1) ThenBlock: {
                    // allow triangle if at least 0.5% of max (real diagonal split)
                    half_pct = Float_Mul(max_ar_all, 0x3F747AE147AE147B)
                    IfCondition EqualTo(Float_Le(ar, half_pct), 1) ThenBlock: { ok_ar = 0 }
                }
            }
            IfCondition EqualTo(ok_ar, 1) ThenBlock: {
                IfCondition GreaterEqual(nn, 3) ThenBlock: {
                    k = 0
                    WhileLoop LessThan(k, nn) {
                        k2 = Add(k, 1)
                        IfCondition EqualTo(k2, nn) ThenBlock: { k2 = 0 }
                        x0 = ArrayGet(xy, Multiply(k, 2))
                        y0 = ArrayGet(xy, Add(Multiply(k, 2), 1))
                        x1 = ArrayGet(xy, Multiply(k2, 2))
                        y1 = ArrayGet(xy, Add(Multiply(k2, 2), 1))
                        dx = Float_Sub(x1, x0)
                        dy = Float_Sub(y1, y0)
                        len2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                        t = 0
                        IfCondition EqualTo(CAD_Num.IsZero(len2, 0), 0) ThenBlock: {
                            t = Float_Div(Float_Add(Float_Mul(Float_Sub(wx, x0), dx), Float_Mul(Float_Sub(wy, y0), dy)), len2)
                            IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: { t = 0 }
                            IfCondition EqualTo(Float_Le(0x3FF0000000000000, t), 1) ThenBlock: { t = 0x3FF0000000000000 }
                        }
                        px = Float_Add(x0, Float_Mul(t, dx))
                        py = Float_Add(y0, Float_Mul(t, dy))
                        ddx = Float_Sub(wx, px)
                        ddy = Float_Sub(wy, py)
                        d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                        IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                            best_d2 = d2
                            found_e = 1
                        }
                        k = Add(k, 1)
                    }
                }
            }
            pi = Add(pi, 1)
        }
        // pass 2: near band → largest area (outer preferred on shared edges)
        best_i = -1
        best_ar = 0
        IfCondition EqualTo(found_e, 1) ThenBlock: {
            band = Float_Mul(best_d2, 0x4002000000000000)
            IfCondition EqualTo(Float_Le(band, lim2), 0) ThenBlock: { band = lim2 }
            pi = 0
            WhileLoop LessThan(pi, nprof) {
                nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
                ar = CAD_Sketch.LoopSignedArea(xy, nn)
                IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                ok_ar = 1
                IfCondition GreaterThan(nprof, 1) ThenBlock: {
                    half_pct = Float_Mul(max_ar_all, 0x3F747AE147AE147B)
                    IfCondition EqualTo(Float_Le(ar, half_pct), 1) ThenBlock: { ok_ar = 0 }
                }
                IfCondition EqualTo(ok_ar, 1) ThenBlock: {
                    near = 0
                    k = 0
                    WhileLoop LessThan(k, nn) {
                        k2 = Add(k, 1)
                        IfCondition EqualTo(k2, nn) ThenBlock: { k2 = 0 }
                        x0 = ArrayGet(xy, Multiply(k, 2))
                        y0 = ArrayGet(xy, Add(Multiply(k, 2), 1))
                        x1 = ArrayGet(xy, Multiply(k2, 2))
                        y1 = ArrayGet(xy, Add(Multiply(k2, 2), 1))
                        dx = Float_Sub(x1, x0)
                        dy = Float_Sub(y1, y0)
                        len2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                        t = 0
                        IfCondition EqualTo(CAD_Num.IsZero(len2, 0), 0) ThenBlock: {
                            t = Float_Div(Float_Add(Float_Mul(Float_Sub(wx, x0), dx), Float_Mul(Float_Sub(wy, y0), dy)), len2)
                            IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: { t = 0 }
                            IfCondition EqualTo(Float_Le(0x3FF0000000000000, t), 1) ThenBlock: { t = 0x3FF0000000000000 }
                        }
                        px = Float_Add(x0, Float_Mul(t, dx))
                        py = Float_Add(y0, Float_Mul(t, dy))
                        ddx = Float_Sub(wx, px)
                        ddy = Float_Sub(wy, py)
                        d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                        IfCondition EqualTo(Float_Le(d2, band), 1) ThenBlock: { near = 1 }
                        k = Add(k, 1)
                    }
                    IfCondition EqualTo(near, 1) ThenBlock: {
                        take = 0
                        IfCondition EqualTo(best_i, -1) ThenBlock: { take = 1 }
                        IfCondition EqualTo(Float_Le(best_ar, ar), 1) ThenBlock: { take = 1 }
                        IfCondition EqualTo(take, 1) ThenBlock: {
                            best_i = pi
                            best_ar = ar
                        }
                    }
                }
                pi = Add(pi, 1)
            }
        }
        IfCondition GreaterEqual(best_i, 0) ThenBlock: {
            Deallocate(xy, 65536)
            ReturnValue(best_i)
        }
        // nearest centroid
        best_i = -1
        best_d2 = 0
        pi = 0
        WhileLoop LessThan(pi, nprof) {
            nn = CAD_Sketch.GetProfileXY(CadApp.sketch, pi, xy)
            IfCondition GreaterEqual(nn, 3) ThenBlock: {
                cx = 0
                cy = 0
                k = 0
                WhileLoop LessThan(k, nn) {
                    cx = Float_Add(cx, ArrayGet(xy, Multiply(k, 2)))
                    cy = Float_Add(cy, ArrayGet(xy, Add(Multiply(k, 2), 1)))
                    k = Add(k, 1)
                }
                inv = Float_Div(0x3FF0000000000000, Float_FromInt(nn))
                cx = Float_Mul(cx, inv)
                cy = Float_Mul(cy, inv)
                ddx = Float_Sub(wx, cx)
                ddy = Float_Sub(wy, cy)
                d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                IfCondition EqualTo(best_i, -1) ThenBlock: {
                    best_i = pi
                    best_d2 = d2
                }
                IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                    best_i = pi
                    best_d2 = d2
                }
            }
            pi = Add(pi, 1)
        }
        Deallocate(xy, 65536)
        ReturnValue(best_i)
    }
}

// Pick profile. shift=1 → toggle multi-select (Shift+click).
Function.CA_PickProfileAt {
    Input: wx: Integer
    Input: wy: Integer
    Input: shift: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        nprof = CAD_Store.Read(CadApp.sketch, 12)
        IfCondition EqualTo(nprof, 0) ThenBlock: {
            nprof = CA_RebuildProfiles()
        }
        IfCondition EqualTo(nprof, 0) ThenBlock: {
            CA_Log("cad_app: pick fail — no projected profile\n", 41)
            ReturnValue(0)
        }
        hit = CA_HitProfile(wx, wy, nprof)
        IfCondition LessThan(hit, 0) ThenBlock: {
            CA_Log("cad_app: pick miss — Profiles then click a ring\n", 47)
            ReturnValue(0)
        }
        addm = 0
        IfCondition NotEqual(shift, 0) ThenBlock: { addm = 1 }
        ok = CA_ApplyProfileSel(hit, nprof, addm)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(addm, 1) ThenBlock: {
            CA_Log("cad_app: multi-select toggle (Shift+click)\n", 41)
        }
        IfCondition EqualTo(addm, 0) ThenBlock: {
            CA_Log("cad_app: profile selected (red)\n", 32)
        }
        ReturnValue(1)
    }
}

// Segment param t of closest point on line i to (wx,wy). Writes t to out[0], d2 to out[1].
Function.CA_LineClosestT {
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Input: wx: Integer
    Input: wy: Integer
    Input: out_td: Address
    Output: Integer
    Body: {
        dx = Float_Sub(x1, x0)
        dy = Float_Sub(y1, y0)
        len2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        t = 0
        IfCondition EqualTo(CAD_Num.IsZero(len2, 0), 0) ThenBlock: {
            t = Float_Div(Float_Add(Float_Mul(Float_Sub(wx, x0), dx), Float_Mul(Float_Sub(wy, y0), dy)), len2)
            IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: { t = 0 }
            IfCondition EqualTo(Float_Le(0x3FF0000000000000, t), 1) ThenBlock: { t = 0x3FF0000000000000 }
        }
        px = Float_Add(x0, Float_Mul(t, dx))
        py = Float_Add(y0, Float_Mul(t, dy))
        ddx = Float_Sub(wx, px)
        ddy = Float_Sub(wy, py)
        d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
        ArraySet(out_td, 0, t)
        ArraySet(out_td, 1, d2)
        ReturnValue(0)
    }
}

// Line-line intersection: param t on A in [0,1], u on B in [0,1]. out[0]=t out[1]=u. Returns 1 if hit.
Function.CA_SegSegHit {
    Input: ax0: Integer
    Input: ay0: Integer
    Input: ax1: Integer
    Input: ay1: Integer
    Input: bx0: Integer
    Input: by0: Integer
    Input: bx1: Integer
    Input: by1: Integer
    Input: out_tu: Address
    Output: Integer
    Body: {
        adx = Float_Sub(ax1, ax0)
        ady = Float_Sub(ay1, ay0)
        bdx = Float_Sub(bx1, bx0)
        bdy = Float_Sub(by1, by0)
        den = Float_Sub(Float_Mul(adx, bdy), Float_Mul(ady, bdx))
        IfCondition EqualTo(CAD_Num.IsZero(den, 0), 1) ThenBlock: { ReturnValue(0) }
        t = Float_Div(Float_Sub(Float_Mul(Float_Sub(bx0, ax0), bdy), Float_Mul(Float_Sub(by0, ay0), bdx)), den)
        u = Float_Div(Float_Sub(Float_Mul(Float_Sub(bx0, ax0), ady), Float_Mul(Float_Sub(by0, ay0), adx)), den)
        // interior only (not endpoints — avoid noise)
        eps = 0x3F50624DD2F1A9FC
        one = 0x3FF0000000000000
        IfCondition EqualTo(Float_Le(t, eps), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(Float_Sub(one, eps), t), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(u, eps), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(Float_Sub(one, eps), u), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(out_tu, 0, t)
        ArraySet(out_tu, 1, u)
        ReturnValue(1)
    }
}

// Line-circle intersections: up to 2 params t in (0,1) written to out[0..n-1]. Returns n.
Function.CA_SegCircleHits {
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Input: cx: Integer
    Input: cy: Integer
    Input: rad: Integer
    Input: out_t: Address
    Output: Integer
    Body: {
        dx = Float_Sub(x1, x0)
        dy = Float_Sub(y1, y0)
        fx = Float_Sub(x0, cx)
        fy = Float_Sub(y0, cy)
        a = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        IfCondition EqualTo(CAD_Num.IsZero(a, 0), 1) ThenBlock: { ReturnValue(0) }
        b = Float_Mul(0x4000000000000000, Float_Add(Float_Mul(fx, dx), Float_Mul(fy, dy)))
        c = Float_Sub(Float_Add(Float_Mul(fx, fx), Float_Mul(fy, fy)), Float_Mul(rad, rad))
        disc = Float_Sub(Float_Mul(b, b), Float_Mul(Float_Mul(0x4010000000000000, a), c))
        IfCondition EqualTo(Float_Le(disc, 0), 1) ThenBlock: { ReturnValue(0) }
        s = CAD_Num.Sqrt(disc)
        // t = (-b ± s) / (2a)
        two_a = Float_Mul(0x4000000000000000, a)
        t0 = Float_Div(Float_Sub(Float_Sub(0, b), s), two_a)
        t1 = Float_Div(Float_Add(Float_Sub(0, b), s), two_a)
        n = 0
        eps = 0x3F50624DD2F1A9FC
        one = 0x3FF0000000000000
        IfCondition EqualTo(Float_Le(t0, eps), 0) ThenBlock: {
            IfCondition EqualTo(Float_Le(Float_Sub(one, eps), t0), 0) ThenBlock: {
                ArraySet(out_t, n, t0)
                n = Add(n, 1)
            }
        }
        IfCondition EqualTo(Float_Le(t1, eps), 0) ThenBlock: {
            IfCondition EqualTo(Float_Le(Float_Sub(one, eps), t1), 0) ThenBlock: {
                ArraySet(out_t, n, t1)
                n = Add(n, 1)
            }
        }
        ReturnValue(n)
    }
}

// Trim: FreeCAD-style cut-back-to-join.
//   • NEVER permanently tessellates live circles/arcs (display stays clean).
//   • Line hit: split at line×line / line×circle / line×arc joins, delete only
//     the piece under the click (overshoot stub dies at the point).
//   • Circle hit: convert that circle into ARC pieces at intersection angles,
//     drop the arc under the click; remaining pieces stay true arcs.
//   • Arc hit: split that arc at joins and drop the sub-arc under the click.
// Projection (Profiles/Pad) still tessellates a clone only.
Function.CA_TrimAt {
    Input: wx: Integer
    Input: wy: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CA_Log("cad_app: trim no sketch\n", 24)
            ReturnValue(0)
        }
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: { sc = 0x3FF0000000000000 }
        // STRICT: only hit within ~10 screen pixels (no random far trims)
        hit_lim = Float_Div(Float_FromInt(10), sc)
        hit_lim2 = Float_Mul(hit_lim, hit_lim)
        two_pi = 0x401921FB54442D18
        eps = 0x3F50624DD2F1A9FC
        one = 0x3FF0000000000000

        // --- pick nearest entity: line / circle rim / arc rim ---
        best_kind = 0
        best_idx = 0
        best_d2 = hit_lim2
        hit_ok = 0

        // lines — prefer stubs near free tips (lens tip overshoots often lose to arc hit)
        nl = CAD_Sketch.GetLineCount(CadApp.sketch)
        lines = CAD_Store.Read(CadApp.sketch, 1)
        i = 0
        WhileLoop LessThan(i, nl) {
            b = Multiply(i, 4)
            x0 = ArrayGet(lines, b)
            y0 = ArrayGet(lines, Add(b, 1))
            x1 = ArrayGet(lines, Add(b, 2))
            y1 = ArrayGet(lines, Add(b, 3))
            dx = Float_Sub(x1, x0)
            dy = Float_Sub(y1, y0)
            len2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
            t = 0
            IfCondition EqualTo(CAD_Num.IsZero(len2, 0), 0) ThenBlock: {
                t = Float_Div(Float_Add(Float_Mul(Float_Sub(wx, x0), dx), Float_Mul(Float_Sub(wy, y0), dy)), len2)
                IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: { t = 0 }
                IfCondition EqualTo(Float_Le(one, t), 1) ThenBlock: { t = one }
            }
            px = Float_Add(x0, Float_Mul(t, dx))
            py = Float_Add(y0, Float_Mul(t, dy))
            ddx = Float_Sub(wx, px)
            ddy = Float_Sub(wy, py)
            d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
            // tip bias: if click near either endpoint, make line easier to hit than arc
            d0 = Float_Add(Float_Mul(Float_Sub(wx, x0), Float_Sub(wx, x0)), Float_Mul(Float_Sub(wy, y0), Float_Sub(wy, y0)))
            d1 = Float_Add(Float_Mul(Float_Sub(wx, x1), Float_Sub(wx, x1)), Float_Mul(Float_Sub(wy, y1), Float_Sub(wy, y1)))
            IfCondition EqualTo(Float_Le(d0, hit_lim2), 1) ThenBlock: {
                d2 = Float_Mul(d2, 0x3FD0000000000000)
            }
            IfCondition EqualTo(Float_Le(d1, hit_lim2), 1) ThenBlock: {
                d2 = Float_Mul(d2, 0x3FD0000000000000)
            }
            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                best_d2 = d2
                best_idx = i
                best_kind = 1
                hit_ok = 1
            }
            i = Add(i, 1)
        }

        // circles (distance to rim)
        nc = CAD_Sketch.GetCircleCount(CadApp.sketch)
        circs = CAD_Store.Read(CadApp.sketch, 8)
        ci = 0
        WhileLoop LessThan(ci, nc) {
            base = Multiply(ci, 3)
            cx = ArrayGet(circs, base)
            cy = ArrayGet(circs, Add(base, 1))
            rad = ArrayGet(circs, Add(base, 2))
            dx = Float_Sub(wx, cx)
            dy = Float_Sub(wy, cy)
            d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
            dd = Float_Sub(d, rad)
            IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
            d2 = Float_Mul(dd, dd)
            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                best_d2 = d2
                best_idx = ci
                best_kind = 2
                hit_ok = 1
            }
            ci = Add(ci, 1)
        }

        // arcs (distance to arc curve, only if angle on span)
        na = CAD_Sketch.GetArcCount(CadApp.sketch)
        arcs = CAD_Store.Read(CadApp.sketch, 11)
        ai = 0
        WhileLoop LessThan(ai, na) {
            base = Multiply(ai, 5)
            cx = ArrayGet(arcs, base)
            cy = ArrayGet(arcs, Add(base, 1))
            rad = ArrayGet(arcs, Add(base, 2))
            a0 = ArrayGet(arcs, Add(base, 3))
            a1 = ArrayGet(arcs, Add(base, 4))
            span = Float_Sub(a1, a0)
            IfCondition EqualTo(Float_Le(span, 0), 1) ThenBlock: {
                span = Float_Add(span, two_pi)
            }
            ang = CAD_Geom.Atan2(Float_Sub(wy, cy), Float_Sub(wx, cx))
            dang = Float_Sub(ang, a0)
            IfCondition EqualTo(Float_Le(dang, 0), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(Float_Sub(0, dang), eps), 0) ThenBlock: {
                    dang = Float_Add(dang, two_pi)
                }
            }
            on = 0
            IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: { on = 1 }
            IfCondition EqualTo(on, 1) ThenBlock: {
                dx = Float_Sub(wx, cx)
                dy = Float_Sub(wy, cy)
                d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                dd = Float_Sub(d, rad)
                IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
                d2 = Float_Mul(dd, dd)
                IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                    best_d2 = d2
                    best_idx = ai
                    best_kind = 3
                    hit_ok = 1
                }
            }
            ai = Add(ai, 1)
        }

        IfCondition EqualTo(hit_ok, 0) ThenBlock: {
            CA_Log("cad_app: trim miss\n", 19)
            ReturnValue(0)
        }

        // ========== LINE: split ONLY the hit segment at joins, delete piece ==========
        // Do NOT re-split the whole sketch every click (was exploding segs + hitting
        // silent 512-cap drops under cat-head + offset-rect trim sessions).
        IfCondition EqualTo(best_kind, 1) ThenBlock: {
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            // split only the line under the cursor
            CAD_Sketch.SplitLineAtHits(CadApp.sketch, best_idx)
            // re-pick nearest LINE piece after that one line was subdivided
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            lines = CAD_Store.Read(CadApp.sketch, 1)
            best_line = 0
            best_d2 = hit_lim2
            line_ok = 0
            i = 0
            WhileLoop LessThan(i, nl) {
                b = Multiply(i, 4)
                x0 = ArrayGet(lines, b)
                y0 = ArrayGet(lines, Add(b, 1))
                x1 = ArrayGet(lines, Add(b, 2))
                y1 = ArrayGet(lines, Add(b, 3))
                dx = Float_Sub(x1, x0)
                dy = Float_Sub(y1, y0)
                len2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                t = 0
                IfCondition EqualTo(CAD_Num.IsZero(len2, 0), 0) ThenBlock: {
                    t = Float_Div(Float_Add(Float_Mul(Float_Sub(wx, x0), dx), Float_Mul(Float_Sub(wy, y0), dy)), len2)
                    IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: { t = 0 }
                    IfCondition EqualTo(Float_Le(one, t), 1) ThenBlock: { t = one }
                }
                px = Float_Add(x0, Float_Mul(t, dx))
                py = Float_Add(y0, Float_Mul(t, dy))
                ddx = Float_Sub(wx, px)
                ddy = Float_Sub(wy, py)
                d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                    best_d2 = d2
                    best_line = i
                    line_ok = 1
                }
                i = Add(i, 1)
            }
            IfCondition EqualTo(line_ok, 0) ThenBlock: {
                CA_Log("cad_app: trim miss after split\n", 29)
                ReturnValue(0)
            }
            CAD_Sketch.DeleteLine(CadApp.sketch, best_line)
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            CA_Log("cad_app: trimmed line stub\n", 26)
            ReturnValue(1)
        }

        // ========== CIRCLE: keep as arcs, remove sector under click ==========
        IfCondition EqualTo(best_kind, 2) ThenBlock: {
            circs = CAD_Store.Read(CadApp.sketch, 8)
            base = Multiply(best_idx, 3)
            cx = ArrayGet(circs, base)
            cy = ArrayGet(circs, Add(base, 1))
            rad = ArrayGet(circs, Add(base, 2))
            // click angle on rim
            click_ang = CAD_Geom.Atan2(Float_Sub(wy, cy), Float_Sub(wx, cx))
            IfCondition EqualTo(Float_Le(click_ang, 0), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(Float_Sub(0, click_ang), eps), 0) ThenBlock: {
                    click_ang = Float_Add(click_ang, two_pi)
                }
            }
            IfCondition EqualTo(Float_Le(two_pi, click_ang), 1) ThenBlock: {
                click_ang = Float_Sub(click_ang, two_pi)
            }
            // collect intersection angles (lines + other circles + arcs)
            angs = Allocate(512)
            nang = 0
            // line × this circle
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            lines = CAD_Store.Read(CadApp.sketch, 1)
            li = 0
            WhileLoop LessThan(li, nl) {
                b = Multiply(li, 4)
                x0 = ArrayGet(lines, b)
                y0 = ArrayGet(lines, Add(b, 1))
                x1 = ArrayGet(lines, Add(b, 2))
                y1 = ArrayGet(lines, Add(b, 3))
                dx = Float_Sub(x1, x0)
                dy = Float_Sub(y1, y0)
                fx = Float_Sub(x0, cx)
                fy = Float_Sub(y0, cy)
                aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                    bb = Float_Mul(0x4000000000000000, Float_Add(Float_Mul(fx, dx), Float_Mul(fy, dy)))
                    cc = Float_Sub(Float_Add(Float_Mul(fx, fx), Float_Mul(fy, fy)), Float_Mul(rad, rad))
                    disc = Float_Sub(Float_Mul(bb, bb), Float_Mul(Float_Mul(0x4010000000000000, aa), cc))
                    IfCondition EqualTo(Float_Le(disc, 0), 0) ThenBlock: {
                        s = CAD_Num.Sqrt(disc)
                        two_a = Float_Mul(0x4000000000000000, aa)
                        t0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                        t1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                        hi = 0
                        WhileLoop LessThan(hi, 2) {
                            t = t0
                            IfCondition EqualTo(hi, 1) ThenBlock: { t = t1 }
                            ok = 1
                            IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: {
                                IfCondition EqualTo(Float_Le(Float_Sub(0, t), eps), 0) ThenBlock: { ok = 0 }
                            }
                            IfCondition EqualTo(Float_Le(one, t), 1) ThenBlock: {
                                IfCondition EqualTo(Float_Le(Float_Sub(t, one), eps), 0) ThenBlock: { ok = 0 }
                            }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                px = Float_Add(x0, Float_Mul(t, dx))
                                py = Float_Add(y0, Float_Mul(t, dy))
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(Float_Sub(0, ang), eps), 0) ThenBlock: {
                                        ang = Float_Add(ang, two_pi)
                                    }
                                }
                                IfCondition EqualTo(Float_Le(two_pi, ang), 1) ThenBlock: {
                                    ang = Float_Sub(ang, two_pi)
                                }
                                IfCondition LessThan(nang, 500) ThenBlock: {
                                    ArraySet(angs, nang, ang)
                                    nang = Add(nang, 1)
                                }
                            }
                            hi = Add(hi, 1)
                        }
                    }
                }
                li = Add(li, 1)
            }
            // other circles × this circle
            nc2 = CAD_Sketch.GetCircleCount(CadApp.sketch)
            cj = 0
            WhileLoop LessThan(cj, nc2) {
                IfCondition NotEqual(cj, best_idx) ThenBlock: {
                    bj = Multiply(cj, 3)
                    ox = ArrayGet(circs, bj)
                    oy = ArrayGet(circs, Add(bj, 1))
                    orad = ArrayGet(circs, Add(bj, 2))
                    dx = Float_Sub(ox, cx)
                    dy = Float_Sub(oy, cy)
                    d2c = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    d = CAD_Num.Sqrt(d2c)
                    okc = 1
                    IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: { okc = 0 }
                    IfCondition EqualTo(Float_Le(Float_Add(rad, orad), d), 1) ThenBlock: { okc = 0 }
                    dr = Float_Sub(rad, orad)
                    IfCondition EqualTo(Float_Le(dr, 0), 1) ThenBlock: { dr = Float_Sub(0, dr) }
                    IfCondition EqualTo(Float_Le(d, dr), 1) ThenBlock: { okc = 0 }
                    IfCondition EqualTo(okc, 1) ThenBlock: {
                        a = Float_Div(Float_Add(Float_Sub(Float_Mul(rad, rad), Float_Mul(orad, orad)), d2c), Float_Mul(0x4000000000000000, d))
                        h2 = Float_Sub(Float_Mul(rad, rad), Float_Mul(a, a))
                        IfCondition EqualTo(Float_Le(h2, 0), 0) ThenBlock: {
                            h = CAD_Num.Sqrt(h2)
                            mx = Float_Add(cx, Float_Mul(a, Float_Div(dx, d)))
                            my = Float_Add(cy, Float_Mul(a, Float_Div(dy, d)))
                            rx = Float_Mul(h, Float_Div(dy, d))
                            ry = Float_Mul(h, Float_Div(dx, d))
                            hi = 0
                            WhileLoop LessThan(hi, 2) {
                                IfCondition EqualTo(hi, 0) ThenBlock: {
                                    px = Float_Add(mx, rx)
                                    py = Float_Sub(my, ry)
                                }
                                IfCondition EqualTo(hi, 1) ThenBlock: {
                                    px = Float_Sub(mx, rx)
                                    py = Float_Add(my, ry)
                                }
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(Float_Sub(0, ang), eps), 0) ThenBlock: {
                                        ang = Float_Add(ang, two_pi)
                                    }
                                }
                                IfCondition EqualTo(Float_Le(two_pi, ang), 1) ThenBlock: {
                                    ang = Float_Sub(ang, two_pi)
                                }
                                IfCondition LessThan(nang, 500) ThenBlock: {
                                    ArraySet(angs, nang, ang)
                                    nang = Add(nang, 1)
                                }
                                hi = Add(hi, 1)
                            }
                        }
                    }
                }
                cj = Add(cj, 1)
            }
            // arc endpoints that lie on this circle rim (join tips)
            na2 = CAD_Sketch.GetArcCount(CadApp.sketch)
            arcs = CAD_Store.Read(CadApp.sketch, 11)
            aj = 0
            WhileLoop LessThan(aj, na2) {
                ab = Multiply(aj, 5)
                acx = ArrayGet(arcs, ab)
                acy = ArrayGet(arcs, Add(ab, 1))
                ar = ArrayGet(arcs, Add(ab, 2))
                aa0 = ArrayGet(arcs, Add(ab, 3))
                aa1 = ArrayGet(arcs, Add(ab, 4))
                // endpoint 0
                px = Float_Add(acx, Float_Mul(ar, CAD_Geom.Cos(aa0)))
                py = Float_Add(acy, Float_Mul(ar, CAD_Geom.Sin(aa0)))
                ddx = Float_Sub(px, cx)
                ddy = Float_Sub(py, cy)
                dist = CAD_Num.Sqrt(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)))
                IfCondition EqualTo(Float_Le(Float_Sub(dist, rad), 0), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(0, Float_Sub(dist, rad)), Float_Mul(rad, 0x3F847AE147AE147B)), 1) ThenBlock: {
                        ang = CAD_Geom.Atan2(ddy, ddx)
                        IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0, ang), eps), 0) ThenBlock: {
                                ang = Float_Add(ang, two_pi)
                            }
                        }
                        IfCondition LessThan(nang, 500) ThenBlock: {
                            ArraySet(angs, nang, ang)
                            nang = Add(nang, 1)
                        }
                    }
                }
                IfCondition EqualTo(Float_Le(rad, dist), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(dist, rad), Float_Mul(rad, 0x3F847AE147AE147B)), 1) ThenBlock: {
                        ang = CAD_Geom.Atan2(ddy, ddx)
                        IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0, ang), eps), 0) ThenBlock: {
                                ang = Float_Add(ang, two_pi)
                            }
                        }
                        IfCondition LessThan(nang, 500) ThenBlock: {
                            ArraySet(angs, nang, ang)
                            nang = Add(nang, 1)
                        }
                    }
                }
                // endpoint 1
                px = Float_Add(acx, Float_Mul(ar, CAD_Geom.Cos(aa1)))
                py = Float_Add(acy, Float_Mul(ar, CAD_Geom.Sin(aa1)))
                ddx = Float_Sub(px, cx)
                ddy = Float_Sub(py, cy)
                dist = CAD_Num.Sqrt(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)))
                IfCondition EqualTo(Float_Le(Float_Sub(dist, rad), 0), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(0, Float_Sub(dist, rad)), Float_Mul(rad, 0x3F847AE147AE147B)), 1) ThenBlock: {
                        ang = CAD_Geom.Atan2(ddy, ddx)
                        IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0, ang), eps), 0) ThenBlock: {
                                ang = Float_Add(ang, two_pi)
                            }
                        }
                        IfCondition LessThan(nang, 500) ThenBlock: {
                            ArraySet(angs, nang, ang)
                            nang = Add(nang, 1)
                        }
                    }
                }
                IfCondition EqualTo(Float_Le(rad, dist), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(dist, rad), Float_Mul(rad, 0x3F847AE147AE147B)), 1) ThenBlock: {
                        ang = CAD_Geom.Atan2(ddy, ddx)
                        IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0, ang), eps), 0) ThenBlock: {
                                ang = Float_Add(ang, two_pi)
                            }
                        }
                        IfCondition LessThan(nang, 500) ThenBlock: {
                            ArraySet(angs, nang, ang)
                            nang = Add(nang, 1)
                        }
                    }
                }
                aj = Add(aj, 1)
            }
            // no intersections → delete whole circle (nothing to cut back to)
            IfCondition LessThan(nang, 2) ThenBlock: {
                Deallocate(angs, 512)
                CAD_Sketch.DeleteCircle(CadApp.sketch, best_idx)
                CAD_Sketch.RebuildAnchors(CadApp.sketch)
                CadApp.dirty = 1
                CA_InvalidateProfiles()
                CA_Log("cad_app: trimmed full circle\n", 28)
                ReturnValue(1)
            }
            // sort angles
            a = 0
            WhileLoop LessThan(a, nang) {
                bb = Add(a, 1)
                WhileLoop LessThan(bb, nang) {
                    va = ArrayGet(angs, a)
                    vb = ArrayGet(angs, bb)
                    IfCondition EqualTo(Float_Le(vb, va), 1) ThenBlock: {
                        ArraySet(angs, a, vb)
                        ArraySet(angs, bb, va)
                    }
                    bb = Add(bb, 1)
                }
                a = Add(a, 1)
            }
            // unique angles into work list (compact in place)
            uangs = Allocate(512)
            nu = 0
            prev = ArrayGet(angs, 0)
            ArraySet(uangs, 0, prev)
            nu = 1
            k = 1
            WhileLoop LessThan(k, nang) {
                cur = ArrayGet(angs, k)
                dt = Float_Sub(cur, prev)
                IfCondition EqualTo(Float_Le(dt, eps), 0) ThenBlock: {
                    ArraySet(uangs, nu, cur)
                    nu = Add(nu, 1)
                    prev = cur
                }
                k = Add(k, 1)
            }
            // wrap: if first≈last+2π gap ok; need ≥2 unique
            IfCondition LessThan(nu, 2) ThenBlock: {
                Deallocate(angs, 512)
                Deallocate(uangs, 512)
                CAD_Sketch.DeleteCircle(CadApp.sketch, best_idx)
                CAD_Sketch.RebuildAnchors(CadApp.sketch)
                CadApp.dirty = 1
                CA_InvalidateProfiles()
                CA_Log("cad_app: trimmed full circle\n", 28)
                ReturnValue(1)
            }
            // emit arcs for every sector EXCEPT the one containing click
            // sector k is CCW [uangs[k] → uangs[k+1]] (last wraps to first)
            k = 0
            WhileLoop LessThan(k, nu) {
                sa0 = ArrayGet(uangs, k)
                sa1 = ArrayGet(uangs, 0)
                IfCondition LessThan(Add(k, 1), nu) ThenBlock: {
                    sa1 = ArrayGet(uangs, Add(k, 1))
                }
                // sector span CCW sa0→sa1
                sspan = Float_Sub(sa1, sa0)
                IfCondition EqualTo(Float_Le(sspan, 0), 1) ThenBlock: {
                    sspan = Float_Add(sspan, two_pi)
                }
                // is click in this sector?  dang in [0, sspan)
                dang = Float_Sub(click_ang, sa0)
                IfCondition EqualTo(Float_Le(dang, 0), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(0, dang), eps), 0) ThenBlock: {
                        dang = Float_Add(dang, two_pi)
                    }
                }
                in_sec = 0
                // dang ≈ 0 counts as start of this sector
                IfCondition EqualTo(Float_Le(Float_Sub(0, dang), eps), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(dang, eps), 1) ThenBlock: { in_sec = 1 }
                }
                // 0 < dang < sspan
                IfCondition EqualTo(Float_Le(dang, 0), 0) ThenBlock: {
                    IfCondition EqualTo(Float_Le(sspan, dang), 0) ThenBlock: { in_sec = 1 }
                }
                IfCondition EqualTo(in_sec, 0) ThenBlock: {
                    // keep this arc (true curve entity — not polyline)
                    CAD_Sketch.AddArc(CadApp.sketch, cx, cy, rad, sa0, sa1)
                }
                k = Add(k, 1)
            }
            CAD_Sketch.DeleteCircle(CadApp.sketch, best_idx)
            Deallocate(angs, 512)
            Deallocate(uangs, 512)
            // also split lines so they end at the (former) circle joins
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CAD_Sketch.SplitAtIntersections(CadApp.sketch)
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            CA_Log("cad_app: trimmed circle→arcs\n", 28)
            ReturnValue(1)
        }

        // ========== ARC: split at joins, drop sub-arc under click ==========
        IfCondition EqualTo(best_kind, 3) ThenBlock: {
            arcs = CAD_Store.Read(CadApp.sketch, 11)
            base = Multiply(best_idx, 5)
            cx = ArrayGet(arcs, base)
            cy = ArrayGet(arcs, Add(base, 1))
            rad = ArrayGet(arcs, Add(base, 2))
            a0 = ArrayGet(arcs, Add(base, 3))
            a1 = ArrayGet(arcs, Add(base, 4))
            span = Float_Sub(a1, a0)
            IfCondition EqualTo(Float_Le(span, 0), 1) ThenBlock: {
                span = Float_Add(span, two_pi)
            }
            click_ang = CAD_Geom.Atan2(Float_Sub(wy, cy), Float_Sub(wx, cx))
            // join tol on rim (world)
            jtol = Float_Mul(rad, 0x3F50624DD2F1A9FC)
            IfCondition EqualTo(Float_Le(jtol, 0x3F1A36E2EB1C432D), 1) ThenBlock: {
                jtol = 0x3F50624DD2F1A9FC
            }
            jtol2 = Float_Mul(jtol, jtol)
            // collect split params t in (0,1) along arc
            ts = Allocate(512)
            ArraySet(ts, 0, 0)
            ArraySet(ts, 1, one)
            nt = 2
            // helper-style: add tt if interior
            // --- lines × this arc (segment isect) ---
            nl = CAD_Sketch.GetLineCount(CadApp.sketch)
            lines = CAD_Store.Read(CadApp.sketch, 1)
            li = 0
            WhileLoop LessThan(li, nl) {
                b = Multiply(li, 4)
                x0 = ArrayGet(lines, b)
                y0 = ArrayGet(lines, Add(b, 1))
                x1 = ArrayGet(lines, Add(b, 2))
                y1 = ArrayGet(lines, Add(b, 3))
                dx = Float_Sub(x1, x0)
                dy = Float_Sub(y1, y0)
                fx = Float_Sub(x0, cx)
                fy = Float_Sub(y0, cy)
                aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                    bb = Float_Mul(0x4000000000000000, Float_Add(Float_Mul(fx, dx), Float_Mul(fy, dy)))
                    cc = Float_Sub(Float_Add(Float_Mul(fx, fx), Float_Mul(fy, fy)), Float_Mul(rad, rad))
                    disc = Float_Sub(Float_Mul(bb, bb), Float_Mul(Float_Mul(0x4010000000000000, aa), cc))
                    IfCondition EqualTo(Float_Le(disc, 0), 0) ThenBlock: {
                        s = CAD_Num.Sqrt(disc)
                        two_a = Float_Mul(0x4000000000000000, aa)
                        ht0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                        ht1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                        hi = 0
                        WhileLoop LessThan(hi, 2) {
                            tline = ht0
                            IfCondition EqualTo(hi, 1) ThenBlock: { tline = ht1 }
                            ok = 1
                            // allow ends of line (junction at tip)
                            IfCondition EqualTo(Float_Le(tline, Float_Sub(0, eps)), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(Float_Le(Float_Add(one, eps), tline), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                px = Float_Add(x0, Float_Mul(tline, dx))
                                py = Float_Add(y0, Float_Mul(tline, dy))
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                dang = Float_Sub(ang, a0)
                                IfCondition EqualTo(Float_Le(dang, 0), 1) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(Float_Sub(0, dang), eps), 0) ThenBlock: {
                                        dang = Float_Add(dang, two_pi)
                                    }
                                }
                                IfCondition EqualTo(Float_Le(0, dang), 1) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: {
                                        tt = 0
                                        IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                                            tt = Float_Div(dang, span)
                                        }
                                        IfCondition EqualTo(Float_Le(tt, eps), 0) ThenBlock: {
                                            IfCondition EqualTo(Float_Le(Float_Sub(one, tt), eps), 0) ThenBlock: {
                                                IfCondition LessThan(nt, 500) ThenBlock: {
                                                    ArraySet(ts, nt, tt)
                                                    nt = Add(nt, 1)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            hi = Add(hi, 1)
                        }
                    }
                }
                // line endpoints on rim (freehand miss / tip join)
                ei = 0
                WhileLoop LessThan(ei, 2) {
                    IfCondition EqualTo(ei, 0) ThenBlock: {
                        px = x0
                        py = y0
                    }
                    IfCondition EqualTo(ei, 1) ThenBlock: {
                        px = x1
                        py = y1
                    }
                    dx = Float_Sub(px, cx)
                    dy = Float_Sub(py, cy)
                    d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                    dd = Float_Sub(d, rad)
                    IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
                    IfCondition EqualTo(Float_Le(dd, jtol), 1) ThenBlock: {
                        ang = CAD_Geom.Atan2(dy, dx)
                        dang = Float_Sub(ang, a0)
                        IfCondition EqualTo(Float_Le(dang, 0), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0, dang), eps), 0) ThenBlock: {
                                dang = Float_Add(dang, two_pi)
                            }
                        }
                        IfCondition EqualTo(Float_Le(0, dang), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: {
                                tt = 0
                                IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                                    tt = Float_Div(dang, span)
                                }
                                IfCondition EqualTo(Float_Le(tt, eps), 0) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(Float_Sub(one, tt), eps), 0) ThenBlock: {
                                        IfCondition LessThan(nt, 500) ThenBlock: {
                                            ArraySet(ts, nt, tt)
                                            nt = Add(nt, 1)
                                        }
                                    }
                                }
                            }
                        }
                    }
                    ei = Add(ei, 1)
                }
                li = Add(li, 1)
            }
            // --- other arcs × this arc (circle-circle isect) ---
            na2 = CAD_Sketch.GetArcCount(CadApp.sketch)
            aj = 0
            WhileLoop LessThan(aj, na2) {
                IfCondition NotEqual(aj, best_idx) ThenBlock: {
                    ab = Multiply(aj, 5)
                    ocx = ArrayGet(arcs, ab)
                    ocy = ArrayGet(arcs, Add(ab, 1))
                    orad = ArrayGet(arcs, Add(ab, 2))
                    oa0 = ArrayGet(arcs, Add(ab, 3))
                    oa1 = ArrayGet(arcs, Add(ab, 4))
                    ospan = Float_Sub(oa1, oa0)
                    IfCondition EqualTo(Float_Le(ospan, 0), 1) ThenBlock: {
                        ospan = Float_Add(ospan, two_pi)
                    }
                    // same center: join if endpoints of other lie on this span
                    dccx = Float_Sub(ocx, cx)
                    dccy = Float_Sub(ocy, cy)
                    dcc = CAD_Num.Sqrt(Float_Add(Float_Mul(dccx, dccx), Float_Mul(dccy, dccy)))
                    IfCondition EqualTo(CAD_Num.IsZero(dcc, 0), 1) ThenBlock: {
                        // endpoint angles of other arc
                        ek = 0
                        WhileLoop LessThan(ek, 2) {
                            oang = oa0
                            IfCondition EqualTo(ek, 1) ThenBlock: { oang = oa1 }
                            dang = Float_Sub(oang, a0)
                            IfCondition EqualTo(Float_Le(dang, 0), 1) ThenBlock: {
                                IfCondition EqualTo(Float_Le(Float_Sub(0, dang), eps), 0) ThenBlock: {
                                    dang = Float_Add(dang, two_pi)
                                }
                            }
                            IfCondition EqualTo(Float_Le(0, dang), 1) ThenBlock: {
                                IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: {
                                    tt = 0
                                    IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                                        tt = Float_Div(dang, span)
                                    }
                                    IfCondition EqualTo(Float_Le(tt, eps), 0) ThenBlock: {
                                        IfCondition EqualTo(Float_Le(Float_Sub(one, tt), eps), 0) ThenBlock: {
                                            IfCondition LessThan(nt, 500) ThenBlock: {
                                                ArraySet(ts, nt, tt)
                                                nt = Add(nt, 1)
                                            }
                                        }
                                    }
                                }
                            }
                            ek = Add(ek, 1)
                        }
                    }
                    // distinct centers: circle-circle isect
                    IfCondition EqualTo(CAD_Num.IsZero(dcc, 0), 0) ThenBlock: {
                        // |r1-r2| < d < r1+r2
                        rsum = Float_Add(rad, orad)
                        rdiff = Float_Sub(rad, orad)
                        IfCondition EqualTo(Float_Le(rdiff, 0), 1) ThenBlock: {
                            rdiff = Float_Sub(0, rdiff)
                        }
                        okcc = 1
                        IfCondition EqualTo(Float_Le(dcc, rdiff), 1) ThenBlock: { okcc = 0 }
                        IfCondition EqualTo(Float_Le(rsum, dcc), 1) ThenBlock: { okcc = 0 }
                        IfCondition EqualTo(okcc, 1) ThenBlock: {
                            // a = (r1^2 - r2^2 + d^2) / (2d)
                            a = Float_Div(Float_Add(Float_Sub(Float_Mul(rad, rad), Float_Mul(orad, orad)), Float_Mul(dcc, dcc)), Float_Mul(0x4000000000000000, dcc))
                            h2 = Float_Sub(Float_Mul(rad, rad), Float_Mul(a, a))
                            IfCondition EqualTo(Float_Le(h2, 0), 0) ThenBlock: {
                                h = CAD_Num.Sqrt(h2)
                                // mid point on line of centres
                                mx = Float_Add(cx, Float_Mul(a, Float_Div(dccx, dcc)))
                                my = Float_Add(cy, Float_Mul(a, Float_Div(dccy, dcc)))
                                // perp unit
                                pxu = Float_Div(Float_Sub(0, dccy), dcc)
                                pyu = Float_Div(dccx, dcc)
                                // two isect points
                                pi = 0
                                WhileLoop LessThan(pi, 2) {
                                    sg = one
                                    IfCondition EqualTo(pi, 1) ThenBlock: { sg = Float_Sub(0, one) }
                                    ix = Float_Add(mx, Float_Mul(Float_Mul(sg, h), pxu))
                                    iy = Float_Add(my, Float_Mul(Float_Mul(sg, h), pyu))
                                    // on this arc span?
                                    ang = CAD_Geom.Atan2(Float_Sub(iy, cy), Float_Sub(ix, cx))
                                    dang = Float_Sub(ang, a0)
                                    IfCondition EqualTo(Float_Le(dang, 0), 1) ThenBlock: {
                                        IfCondition EqualTo(Float_Le(Float_Sub(0, dang), eps), 0) ThenBlock: {
                                            dang = Float_Add(dang, two_pi)
                                        }
                                    }
                                    on1 = 0
                                    IfCondition EqualTo(Float_Le(0, dang), 1) ThenBlock: {
                                        IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: { on1 = 1 }
                                    }
                                    // on other arc span?
                                    oang = CAD_Geom.Atan2(Float_Sub(iy, ocy), Float_Sub(ix, ocx))
                                    odang = Float_Sub(oang, oa0)
                                    IfCondition EqualTo(Float_Le(odang, 0), 1) ThenBlock: {
                                        IfCondition EqualTo(Float_Le(Float_Sub(0, odang), eps), 0) ThenBlock: {
                                            odang = Float_Add(odang, two_pi)
                                        }
                                    }
                                    on2 = 0
                                    IfCondition EqualTo(Float_Le(0, odang), 1) ThenBlock: {
                                        IfCondition EqualTo(Float_Le(odang, Float_Add(ospan, eps)), 1) ThenBlock: { on2 = 1 }
                                    }
                                    IfCondition EqualTo(on1, 1) ThenBlock: {
                                        IfCondition EqualTo(on2, 1) ThenBlock: {
                                            tt = 0
                                            IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                                                tt = Float_Div(dang, span)
                                            }
                                            IfCondition EqualTo(Float_Le(tt, eps), 0) ThenBlock: {
                                                IfCondition EqualTo(Float_Le(Float_Sub(one, tt), eps), 0) ThenBlock: {
                                                    IfCondition LessThan(nt, 500) ThenBlock: {
                                                        ArraySet(ts, nt, tt)
                                                        nt = Add(nt, 1)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    pi = Add(pi, 1)
                                }
                            }
                        }
                    }
                }
                aj = Add(aj, 1)
            }
            // --- full circles × this arc ---
            nc = CAD_Sketch.GetCircleCount(CadApp.sketch)
            circs = CAD_Store.Read(CadApp.sketch, 8)
            ci = 0
            WhileLoop LessThan(ci, nc) {
                cb = Multiply(ci, 3)
                ocx = ArrayGet(circs, cb)
                ocy = ArrayGet(circs, Add(cb, 1))
                orad = ArrayGet(circs, Add(cb, 2))
                dccx = Float_Sub(ocx, cx)
                dccy = Float_Sub(ocy, cy)
                dcc = CAD_Num.Sqrt(Float_Add(Float_Mul(dccx, dccx), Float_Mul(dccy, dccy)))
                IfCondition EqualTo(CAD_Num.IsZero(dcc, 0), 0) ThenBlock: {
                    rsum = Float_Add(rad, orad)
                    rdiff = Float_Sub(rad, orad)
                    IfCondition EqualTo(Float_Le(rdiff, 0), 1) ThenBlock: {
                        rdiff = Float_Sub(0, rdiff)
                    }
                    okcc = 1
                    IfCondition EqualTo(Float_Le(dcc, rdiff), 1) ThenBlock: { okcc = 0 }
                    IfCondition EqualTo(Float_Le(rsum, dcc), 1) ThenBlock: { okcc = 0 }
                    IfCondition EqualTo(okcc, 1) ThenBlock: {
                        a = Float_Div(Float_Add(Float_Sub(Float_Mul(rad, rad), Float_Mul(orad, orad)), Float_Mul(dcc, dcc)), Float_Mul(0x4000000000000000, dcc))
                        h2 = Float_Sub(Float_Mul(rad, rad), Float_Mul(a, a))
                        IfCondition EqualTo(Float_Le(h2, 0), 0) ThenBlock: {
                            h = CAD_Num.Sqrt(h2)
                            mx = Float_Add(cx, Float_Mul(a, Float_Div(dccx, dcc)))
                            my = Float_Add(cy, Float_Mul(a, Float_Div(dccy, dcc)))
                            pxu = Float_Div(Float_Sub(0, dccy), dcc)
                            pyu = Float_Div(dccx, dcc)
                            pi = 0
                            WhileLoop LessThan(pi, 2) {
                                sg = one
                                IfCondition EqualTo(pi, 1) ThenBlock: { sg = Float_Sub(0, one) }
                                ix = Float_Add(mx, Float_Mul(Float_Mul(sg, h), pxu))
                                iy = Float_Add(my, Float_Mul(Float_Mul(sg, h), pyu))
                                ang = CAD_Geom.Atan2(Float_Sub(iy, cy), Float_Sub(ix, cx))
                                dang = Float_Sub(ang, a0)
                                IfCondition EqualTo(Float_Le(dang, 0), 1) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(Float_Sub(0, dang), eps), 0) ThenBlock: {
                                        dang = Float_Add(dang, two_pi)
                                    }
                                }
                                IfCondition EqualTo(Float_Le(0, dang), 1) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: {
                                        tt = 0
                                        IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                                            tt = Float_Div(dang, span)
                                        }
                                        IfCondition EqualTo(Float_Le(tt, eps), 0) ThenBlock: {
                                            IfCondition EqualTo(Float_Le(Float_Sub(one, tt), eps), 0) ThenBlock: {
                                                IfCondition LessThan(nt, 500) ThenBlock: {
                                                    ArraySet(ts, nt, tt)
                                                    nt = Add(nt, 1)
                                                }
                                            }
                                        }
                                    }
                                }
                                pi = Add(pi, 1)
                            }
                        }
                    }
                }
                ci = Add(ci, 1)
            }
            // sort t
            a = 0
            WhileLoop LessThan(a, nt) {
                bb = Add(a, 1)
                WhileLoop LessThan(bb, nt) {
                    va = ArrayGet(ts, a)
                    vb = ArrayGet(ts, bb)
                    IfCondition EqualTo(Float_Le(vb, va), 1) ThenBlock: {
                        ArraySet(ts, a, vb)
                        ArraySet(ts, bb, va)
                    }
                    bb = Add(bb, 1)
                }
                a = Add(a, 1)
            }
            // no interior mid-joins (arc runs tip-to-tip only, e.g. remaining scoop).
            // 1) Prefer delete nearby line stub (overshoot past tip)
            // 2) Else FreeCAD-style: whole arc is one edge between its ends → delete it
            // (Not a trim-count limit — just no place to "cut midway" without a cross.)
            IfCondition LessThan(nt, 3) ThenBlock: {
                Deallocate(ts, 512)
                nl = CAD_Sketch.GetLineCount(CadApp.sketch)
                lines = CAD_Store.Read(CadApp.sketch, 1)
                best_line = -1
                best_ld2 = hit_lim2
                i = 0
                WhileLoop LessThan(i, nl) {
                    b = Multiply(i, 4)
                    x0 = ArrayGet(lines, b)
                    y0 = ArrayGet(lines, Add(b, 1))
                    x1 = ArrayGet(lines, Add(b, 2))
                    y1 = ArrayGet(lines, Add(b, 3))
                    dx = Float_Sub(x1, x0)
                    dy = Float_Sub(y1, y0)
                    len2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    t = 0
                    IfCondition EqualTo(CAD_Num.IsZero(len2, 0), 0) ThenBlock: {
                        t = Float_Div(Float_Add(Float_Mul(Float_Sub(wx, x0), dx), Float_Mul(Float_Sub(wy, y0), dy)), len2)
                        IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: { t = 0 }
                        IfCondition EqualTo(Float_Le(one, t), 1) ThenBlock: { t = one }
                    }
                    px = Float_Add(x0, Float_Mul(t, dx))
                    py = Float_Add(y0, Float_Mul(t, dy))
                    ddx = Float_Sub(wx, px)
                    ddy = Float_Sub(wy, py)
                    d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                    d0 = Float_Add(Float_Mul(Float_Sub(wx, x0), Float_Sub(wx, x0)), Float_Mul(Float_Sub(wy, y0), Float_Sub(wy, y0)))
                    d1 = Float_Add(Float_Mul(Float_Sub(wx, x1), Float_Sub(wx, x1)), Float_Mul(Float_Sub(wy, y1), Float_Sub(wy, y1)))
                    IfCondition EqualTo(Float_Le(d0, hit_lim2), 1) ThenBlock: {
                        d2 = Float_Mul(d2, 0x3FC0000000000000)
                    }
                    IfCondition EqualTo(Float_Le(d1, hit_lim2), 1) ThenBlock: {
                        d2 = Float_Mul(d2, 0x3FC0000000000000)
                    }
                    IfCondition EqualTo(Float_Le(d2, best_ld2), 1) ThenBlock: {
                        best_ld2 = d2
                        best_line = i
                    }
                    i = Add(i, 1)
                }
                IfCondition GreaterEqual(best_line, 0) ThenBlock: {
                    CAD_Sketch.RebuildAnchors(CadApp.sketch)
                    CAD_Sketch.SplitLineAtHits(CadApp.sketch, best_line)
                    nl = CAD_Sketch.GetLineCount(CadApp.sketch)
                    lines = CAD_Store.Read(CadApp.sketch, 1)
                    best_line = -1
                    best_ld2 = hit_lim2
                    i = 0
                    WhileLoop LessThan(i, nl) {
                        b = Multiply(i, 4)
                        x0 = ArrayGet(lines, b)
                        y0 = ArrayGet(lines, Add(b, 1))
                        x1 = ArrayGet(lines, Add(b, 2))
                        y1 = ArrayGet(lines, Add(b, 3))
                        dx = Float_Sub(x1, x0)
                        dy = Float_Sub(y1, y0)
                        len2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                        t = 0
                        IfCondition EqualTo(CAD_Num.IsZero(len2, 0), 0) ThenBlock: {
                            t = Float_Div(Float_Add(Float_Mul(Float_Sub(wx, x0), dx), Float_Mul(Float_Sub(wy, y0), dy)), len2)
                            IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: { t = 0 }
                            IfCondition EqualTo(Float_Le(one, t), 1) ThenBlock: { t = one }
                        }
                        px = Float_Add(x0, Float_Mul(t, dx))
                        py = Float_Add(y0, Float_Mul(t, dy))
                        ddx = Float_Sub(wx, px)
                        ddy = Float_Sub(wy, py)
                        d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                        IfCondition EqualTo(Float_Le(d2, best_ld2), 1) ThenBlock: {
                            best_ld2 = d2
                            best_line = i
                        }
                        i = Add(i, 1)
                    }
                    IfCondition GreaterEqual(best_line, 0) ThenBlock: {
                        CAD_Sketch.DeleteLine(CadApp.sketch, best_line)
                        CAD_Sketch.RebuildAnchors(CadApp.sketch)
                        CadApp.dirty = 1
                        CA_InvalidateProfiles()
                        CA_Log("cad_app: trimmed line stub (at arc tip)\n", 38)
                        ReturnValue(1)
                    }
                }
                // No stub left: click on arc body removes the whole remaining arc
                // (one edge between its two tips — FreeCAD does the same).
                CAD_Sketch.DeleteArc(CadApp.sketch, best_idx)
                CAD_Sketch.RebuildAnchors(CadApp.sketch)
                CadApp.dirty = 1
                CA_InvalidateProfiles()
                CA_Log("cad_app: trimmed whole arc (tip-to-tip)\n", 39)
                ReturnValue(1)
            }
            // click param on arc
            dang = Float_Sub(click_ang, a0)
            IfCondition EqualTo(Float_Le(dang, 0), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(Float_Sub(0, dang), eps), 0) ThenBlock: {
                    dang = Float_Add(dang, two_pi)
                }
            }
            click_t = 0
            IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                click_t = Float_Div(dang, span)
            }
            // emit kept sub-arcs, delete original
            CAD_Sketch.DeleteArc(CadApp.sketch, best_idx)
            prev = ArrayGet(ts, 0)
            k = 1
            nkeep = 0
            WhileLoop LessThan(k, nt) {
                cur = ArrayGet(ts, k)
                dt = Float_Sub(cur, prev)
                IfCondition EqualTo(Float_Le(dt, 0x3F1A36E2EB1C432D), 0) ThenBlock: {
                    keep = 1
                    IfCondition EqualTo(Float_Le(prev, click_t), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(click_t, cur), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(click_t, prev), eps), 0) ThenBlock: {
                                IfCondition EqualTo(Float_Le(Float_Sub(cur, click_t), eps), 0) ThenBlock: {
                                    keep = 0
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(keep, 1) ThenBlock: {
                        ang0 = Float_Add(a0, Float_Mul(span, prev))
                        ang1 = Float_Add(a0, Float_Mul(span, cur))
                        CAD_Sketch.AddArc(CadApp.sketch, cx, cy, rad, ang0, ang1)
                        nkeep = Add(nkeep, 1)
                    }
                    prev = cur
                }
                k = Add(k, 1)
            }
            Deallocate(ts, 512)
            // safety: if nothing kept (bug), restore original
            IfCondition EqualTo(nkeep, 0) ThenBlock: {
                CAD_Sketch.AddArc(CadApp.sketch, cx, cy, rad, a0, a1)
                CA_Log("cad_app: arc trim restore (no piece)\n", 37)
            }
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CAD_Sketch.SplitAtIntersections(CadApp.sketch)
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            CA_Log("cad_app: trimmed arc\n", 21)
            ReturnValue(1)
        }

        CA_Log("cad_app: trim miss\n", 19)
        ReturnValue(0)
    }
}

// Hit-test sketch entity near (wx,wy). out_ki[0]=kind out_ki[1]=id.
// kind: 0 line-end (line*2+end)  4 circle  2 whole-line  3 user Point
// Phased: (1) points/ends/centers only  (2) circle rims  (3) line body last.
// Returns 1 hit, 0 miss.
Function.CA_HitEntity {
    Input: wx: Integer
    Input: wy: Integer
    Input: out_ki: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        CA_UpdateSketchCam()
        sc = CadApp.scale
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
            sc = 0x3FF0000000000000
        }
        // generous for ends/points so FixO works without pixel-perfect clicks
        snap_pt = Float_Div(Float_FromInt(16), sc)
        snap2 = Float_Mul(snap_pt, snap_pt)
        snap_rim = Float_Div(Float_FromInt(14), sc)
        best = snap2
        hit = 0
        bk = 0
        bi = 0
        sk = CadApp.sketch
        nl = CAD_Sketch.GetLineCount(sk)
        nc = CAD_Sketch.GetCircleCount(sk)
        // --- phase 1: discrete points only (no line body) ---
        nup = CAD_Sketch.GetUserPointCount(sk)
        IfCondition GreaterThan(nup, 0) ThenBlock: {
            xy = Allocate(32)
            ui = 0
            WhileLoop LessThan(ui, nup) {
                CAD_Sketch.GetUserPoint(sk, ui, xy)
                dx = Float_Sub(wx, ArrayGet(xy, 0))
                dy = Float_Sub(wy, ArrayGet(xy, 1))
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    hit = 1
                    bk = 3
                    bi = ui
                }
                ui = Add(ui, 1)
            }
            Deallocate(xy, 32)
        }
        IfCondition GreaterThan(nl, 0) ThenBlock: {
            lines = CAD_Store.Read(sk, 1)
            i = 0
            WhileLoop LessThan(i, nl) {
                b = Multiply(i, 4)
                e = 0
                WhileLoop LessThan(e, 2) {
                    IfCondition EqualTo(e, 0) ThenBlock: {
                        ax = ArrayGet(lines, b)
                        ay = ArrayGet(lines, Add(b, 1))
                    }
                    IfCondition EqualTo(e, 1) ThenBlock: {
                        ax = ArrayGet(lines, Add(b, 2))
                        ay = ArrayGet(lines, Add(b, 3))
                    }
                    dx = Float_Sub(wx, ax)
                    dy = Float_Sub(wy, ay)
                    d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                        best = d2
                        hit = 1
                        bk = 0
                        bi = Add(Multiply(i, 2), e)
                    }
                    e = Add(e, 1)
                }
                i = Add(i, 1)
            }
        }
        IfCondition GreaterThan(nc, 0) ThenBlock: {
            circs = CAD_Store.Read(sk, 8)
            ci = 0
            WhileLoop LessThan(ci, nc) {
                base = Multiply(ci, 3)
                cx = ArrayGet(circs, base)
                cy = ArrayGet(circs, Add(base, 1))
                dx = Float_Sub(wx, cx)
                dy = Float_Sub(wy, cy)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    hit = 1
                    bk = 4
                    bi = ci
                }
                ci = Add(ci, 1)
            }
        }
        // --- phase 2: circle rims only if nothing discrete hit ---
        IfCondition EqualTo(hit, 0) ThenBlock: {
            IfCondition GreaterThan(nc, 0) ThenBlock: {
                circs = CAD_Store.Read(sk, 8)
                best = Float_Mul(snap_rim, snap_rim)
                ci = 0
                WhileLoop LessThan(ci, nc) {
                    base = Multiply(ci, 3)
                    cx = ArrayGet(circs, base)
                    cy = ArrayGet(circs, Add(base, 1))
                    rad = ArrayGet(circs, Add(base, 2))
                    dx = Float_Sub(wx, cx)
                    dy = Float_Sub(wy, cy)
                    d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                    dd = Float_Sub(d, rad)
                    IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
                    IfCondition EqualTo(Float_Le(dd, snap_rim), 1) ThenBlock: {
                        d2r = Float_Mul(dd, dd)
                        IfCondition EqualTo(Float_Le(d2r, best), 1) ThenBlock: {
                            best = d2r
                            hit = 1
                            bk = 4
                            bi = ci
                        }
                    }
                    ci = Add(ci, 1)
                }
            }
        }
        // --- phase 3: whole line body (H/V/OnLn only really want this) ---
        IfCondition EqualTo(hit, 0) ThenBlock: {
            IfCondition GreaterThan(nl, 0) ThenBlock: {
                lines = CAD_Store.Read(sk, 1)
                best = Float_Mul(snap_rim, snap_rim)
                i = 0
                WhileLoop LessThan(i, nl) {
                    b = Multiply(i, 4)
                    x0 = ArrayGet(lines, b)
                    y0 = ArrayGet(lines, Add(b, 1))
                    x1 = ArrayGet(lines, Add(b, 2))
                    y1 = ArrayGet(lines, Add(b, 3))
                    dx = Float_Sub(x1, x0)
                    dy = Float_Sub(y1, y0)
                    aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                        t = Float_Div(Float_Add(Float_Mul(Float_Sub(wx, x0), dx), Float_Mul(Float_Sub(wy, y0), dy)), aa)
                        IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: { t = 0 }
                        IfCondition EqualTo(Float_Le(0x3FF0000000000000, t), 1) ThenBlock: { t = 0x3FF0000000000000 }
                        px = Float_Add(x0, Float_Mul(t, dx))
                        py = Float_Add(y0, Float_Mul(t, dy))
                        ddx = Float_Sub(wx, px)
                        ddy = Float_Sub(wy, py)
                        d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                        IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                            best = d2
                            hit = 1
                            bk = 2
                            bi = i
                        }
                    }
                    i = Add(i, 1)
                }
            }
        }
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ArraySet(out_ki, 0, bk)
            ArraySet(out_ki, 1, bi)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// If hit is whole-line, retarget to nearest endpoint (for FixO / DistO / Coin).
Function.CA_HitAsPoint {
    Input: wx: Integer
    Input: wy: Integer
    Input: kind: Integer
    Input: id: Integer
    Input: out_ki: Address
    Output: Integer
    Body: {
        ArraySet(out_ki, 0, kind)
        ArraySet(out_ki, 1, id)
        IfCondition NotEqual(kind, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(-1) }
        lines = CAD_Store.Read(CadApp.sketch, 1)
        nl = CAD_Sketch.GetLineCount(CadApp.sketch)
        IfCondition GreaterEqual(id, nl) ThenBlock: { ReturnValue(-1) }
        b = Multiply(id, 4)
        x0 = ArrayGet(lines, b)
        y0 = ArrayGet(lines, Add(b, 1))
        x1 = ArrayGet(lines, Add(b, 2))
        y1 = ArrayGet(lines, Add(b, 3))
        d0 = Float_Add(Float_Mul(Float_Sub(wx, x0), Float_Sub(wx, x0)), Float_Mul(Float_Sub(wy, y0), Float_Sub(wy, y0)))
        d1 = Float_Add(Float_Mul(Float_Sub(wx, x1), Float_Sub(wx, x1)), Float_Mul(Float_Sub(wy, y1), Float_Sub(wy, y1)))
        IfCondition EqualTo(Float_Le(d0, d1), 1) ThenBlock: {
            ArraySet(out_ki, 0, 0)
            ArraySet(out_ki, 1, Multiply(id, 2))
        }
        IfCondition EqualTo(Float_Le(d0, d1), 0) ThenBlock: {
            ArraySet(out_ki, 0, 0)
            ArraySet(out_ki, 1, Add(Multiply(id, 2), 1))
        }
        ReturnValue(1)
    }
}

// Enter constraint tool. ctype = constraint type code (1 FixO, 6 DistO, 7 H, …).
Function.CA_BeginConstraint {
    Input: ctype: Integer
    Output: Integer
    Body: {
        CadApp.mode = 1
        CadApp.tool = 7
        CadApp.cstr_type = ctype
        CadApp.cstr_npick = 0
        CadApp.nclick = 0
        CadApp.hover_ok = 0
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
        }
        ReturnValue(0)
    }
}

// Run solve + invalidate after adding a constraint.
Function.CA_SolveNow {
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        napp = CAD_Sketch.SolveConstraints(CadApp.sketch)
        CA_InvalidateProfiles()
        CadApp.dirty = 1
        CA_Log("cad_app: constraint applied + solve\n", 34)
        ReturnValue(napp)
    }
}

// Constraint click: pick 1 or 2 entities then add + solve.
// cstr_type: 1 FixO  6 DistO(lock)  7 H  8 V  9 Coin  10 OnLine
//           11 Rad(lock)  12 EqR  13 Tang  15 Dist(lock)
Function.CA_ConstraintClick {
    Input: wx: Integer
    Input: wy: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: { ReturnValue(0) }
        ki = Allocate(32)
        IfCondition EqualTo(CA_HitEntity(wx, wy, ki), 0) ThenBlock: {
            CA_Log("cad_app: miss - click point/end/circle/line\n", 42)
            Deallocate(ki, 32)
            ReturnValue(0)
        }
        hk = ArrayGet(ki, 0)
        hi = ArrayGet(ki, 1)
        ct = CadApp.cstr_type
        // Point tools: whole-line hit -> nearest endpoint
        IfCondition EqualTo(ct, 1) ThenBlock: {
            CA_HitAsPoint(wx, wy, hk, hi, ki)
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
        }
        IfCondition EqualTo(ct, 6) ThenBlock: {
            CA_HitAsPoint(wx, wy, hk, hi, ki)
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
        }
        IfCondition EqualTo(ct, 9) ThenBlock: {
            CA_HitAsPoint(wx, wy, hk, hi, ki)
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
        }
        IfCondition EqualTo(ct, 15) ThenBlock: {
            CA_HitAsPoint(wx, wy, hk, hi, ki)
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
        }
        Deallocate(ki, 32)
        // --- single-pick types ---
        // FixOrigin
        IfCondition EqualTo(ct, 1) ThenBlock: {
            IfCondition EqualTo(hk, 2) ThenBlock: {
                CA_Log("cad_app: FixO needs point or line end\n", 38)
                ReturnValue(0)
            }
            IfCondition EqualTo(hk, 4) ThenBlock: {
                // circle center is ok (kind 4 center move)
                CAD_Sketch.AddConstraint(CadApp.sketch, 1, 4, hi, 0)
            }
            IfCondition NotEqual(hk, 4) ThenBlock: {
                CAD_Sketch.AddConstraint(CadApp.sketch, 1, hk, hi, 0)
            }
            CadApp.cstr_npick = 0
            CA_SolveNow()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // Horizontal / Vertical on a line
        IfCondition EqualTo(ct, 7) ThenBlock: {
            li = hi
            ok = 0
            IfCondition EqualTo(hk, 0) ThenBlock: {
                li = Divide(hi, 2)
                ok = 1
            }
            IfCondition EqualTo(hk, 2) ThenBlock: {
                li = hi
                ok = 1
            }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                CAD_Sketch.AddConstraint(CadApp.sketch, 7, 2, li, 0)
                CadApp.cstr_npick = 0
                CA_SolveNow()
                CA_PublishFrame()
                ReturnValue(1)
            }
            CA_Log("cad_app: H needs a line\n", 24)
            ReturnValue(0)
        }
        IfCondition EqualTo(ct, 8) ThenBlock: {
            li = hi
            ok = 0
            IfCondition EqualTo(hk, 0) ThenBlock: {
                li = Divide(hi, 2)
                ok = 1
            }
            IfCondition EqualTo(hk, 2) ThenBlock: {
                li = hi
                ok = 1
            }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                CAD_Sketch.AddConstraint(CadApp.sketch, 8, 2, li, 0)
                CadApp.cstr_npick = 0
                CA_SolveNow()
                CA_PublishFrame()
                ReturnValue(1)
            }
            CA_Log("cad_app: V needs a line\n", 24)
            ReturnValue(0)
        }
        // DistToOrigin lock current |p|
        IfCondition EqualTo(ct, 6) ThenBlock: {
            IfCondition EqualTo(hk, 2) ThenBlock: {
                CA_Log("cad_app: DistO needs a point or end\n", 36)
                ReturnValue(0)
            }
            xy = Allocate(32)
            tk = hk
            IfCondition EqualTo(hk, 4) ThenBlock: { tk = 4 }
            CAD_Sketch.GetTargetXY(CadApp.sketch, tk, hi, xy)
            px = ArrayGet(xy, 0)
            py = ArrayGet(xy, 1)
            Deallocate(xy, 32)
            d = CAD_Num.Sqrt(Float_Add(Float_Mul(px, px), Float_Mul(py, py)))
            CAD_Sketch.AddConstraint(CadApp.sketch, 6, tk, hi, d)
            CadApp.cstr_npick = 0
            CA_SolveNow()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // Radius lock current r - click rim or center
        IfCondition EqualTo(ct, 11) ThenBlock: {
            IfCondition NotEqual(hk, 4) ThenBlock: {
                CA_Log("cad_app: Rad - click circle rim or center\n", 42)
                ReturnValue(0)
            }
            ci = hi
            r = CAD_Sketch.GetCircleRadius(CadApp.sketch, ci)
            CAD_Sketch.AddConstraint(CadApp.sketch, 11, 4, ci, r)
            CadApp.cstr_npick = 0
            CA_SolveNow()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // --- two-pick types ---
        IfCondition EqualTo(CadApp.cstr_npick, 0) ThenBlock: {
            CadApp.cstr_ka = hk
            CadApp.cstr_ia = hi
            CadApp.cstr_npick = 1
            CA_Log("cad_app: constraint pick 1/2\n", 29)
            CA_PublishFrame()
            ReturnValue(1)
        }
        // second pick
        CadApp.cstr_kb = hk
        CadApp.cstr_ib = hi
        CadApp.cstr_npick = 0
        ka = CadApp.cstr_ka
        ia = CadApp.cstr_ia
        kb = CadApp.cstr_kb
        ib = CadApp.cstr_ib
        // Coincident
        IfCondition EqualTo(ct, 9) ThenBlock: {
            CAD_Sketch.AddConstraint2(CadApp.sketch, 9, ka, ia, kb, ib)
            CA_SolveNow()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // PointOnLine — A point, B line
        IfCondition EqualTo(ct, 10) ThenBlock: {
            // ensure B is whole line
            IfCondition EqualTo(kb, 0) ThenBlock: {
                ib = Divide(ib, 2)
                kb = 2
            }
            IfCondition EqualTo(ka, 2) ThenBlock: {
                // swap if first was line
                t = ka
                ka = kb
                kb = t
                t = ia
                ia = ib
                ib = t
                IfCondition EqualTo(kb, 0) ThenBlock: {
                    ib = Divide(ib, 2)
                    kb = 2
                }
            }
            CAD_Sketch.AddConstraint2(CadApp.sketch, 10, ka, ia, kb, ib)
            CA_SolveNow()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // EqualRadius
        IfCondition EqualTo(ct, 12) ThenBlock: {
            CAD_Sketch.AddConstraint2(CadApp.sketch, 12, 4, ia, 4, ib)
            CA_SolveNow()
            CA_PublishFrame()
            ReturnValue(1)
        }
        // Tangent line-circle or circle-circle
        IfCondition EqualTo(ct, 13) ThenBlock: {
            // normalize: line as A kind 2, circle as B kind 4 — or two circles type 14
            la = 0
            ca = 0
            lb = 0
            cb = 0
            IfCondition EqualTo(ka, 2) ThenBlock: { la = 1 }
            IfCondition EqualTo(ka, 0) ThenBlock: {
                la = 1
                ia = Divide(ia, 2)
                ka = 2
            }
            IfCondition EqualTo(ka, 4) ThenBlock: { ca = 1 }
            IfCondition EqualTo(ka, 1) ThenBlock: {
                ca = 1
                ka = 4
            }
            IfCondition EqualTo(kb, 2) ThenBlock: { lb = 1 }
            IfCondition EqualTo(kb, 0) ThenBlock: {
                lb = 1
                ib = Divide(ib, 2)
                kb = 2
            }
            IfCondition EqualTo(kb, 4) ThenBlock: { cb = 1 }
            IfCondition EqualTo(kb, 1) ThenBlock: {
                cb = 1
                kb = 4
            }
            IfCondition EqualTo(ca, 1) ThenBlock: {
                IfCondition EqualTo(cb, 1) ThenBlock: {
                    CAD_Sketch.AddConstraint2(CadApp.sketch, 14, 4, ia, 4, ib)
                    CA_SolveNow()
                    CA_PublishFrame()
                    ReturnValue(1)
                }
            }
            // line + circle
            IfCondition EqualTo(la, 1) ThenBlock: {
                IfCondition EqualTo(cb, 1) ThenBlock: {
                    CAD_Sketch.AddConstraint2(CadApp.sketch, 13, 2, ia, 4, ib)
                    CA_SolveNow()
                    CA_PublishFrame()
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(lb, 1) ThenBlock: {
                IfCondition EqualTo(ca, 1) ThenBlock: {
                    CAD_Sketch.AddConstraint2(CadApp.sketch, 13, 2, ib, 4, ia)
                    CA_SolveNow()
                    CA_PublishFrame()
                    ReturnValue(1)
                }
            }
            CA_Log("cad_app: Tang needs line+circle or 2 circles\n", 44)
            ReturnValue(0)
        }
        // DistPoints lock current distance
        IfCondition EqualTo(ct, 15) ThenBlock: {
            xy = Allocate(32)
            xy2 = Allocate(32)
            CAD_Sketch.GetTargetXY(CadApp.sketch, ka, ia, xy)
            CAD_Sketch.GetTargetXY(CadApp.sketch, kb, ib, xy2)
            dx = Float_Sub(ArrayGet(xy2, 0), ArrayGet(xy, 0))
            dy = Float_Sub(ArrayGet(xy2, 1), ArrayGet(xy, 1))
            d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
            Deallocate(xy, 32)
            Deallocate(xy2, 32)
            cid = CAD_Sketch.AddConstraint2(CadApp.sketch, 15, ka, ia, kb, ib)
            CAD_Sketch.SetConstraintValue(CadApp.sketch, cid, d)
            CA_SolveNow()
            CA_PublishFrame()
            ReturnValue(1)
        }
        CA_Log("cad_app: unknown constraint type\n", 33)
        ReturnValue(0)
    }
}

// Click: sketch tools in sketch mode; nav cube in 3D mode
// Pick/Trim force sketch mode so 3D mode does not swallow selection clicks.
Function.CA_OnClick {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        // Constraint pick (tool 7) — always sketch
        IfCondition EqualTo(CadApp.tool, 7) ThenBlock: {
            CadApp.mode = 1
            IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                CadApp.sketch = CAD_Sketch.CreateSketch(1)
            }
            xy = Allocate(32)
            CA_PixToWorld(px, py, xy)
            // no snap weld — hit raw for selection
            CA_ConstraintClick(ArrayGet(xy, 0), ArrayGet(xy, 1))
            Deallocate(xy, 32)
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            ReturnValue(0)
        }
        // Fillet (tool 8): pick two lines, apply CadApp.fillet_r
        IfCondition EqualTo(CadApp.tool, 8) ThenBlock: {
            CadApp.mode = 1
            IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                CadApp.sketch = CAD_Sketch.CreateSketch(1)
            }
            IfCondition EqualTo(CadApp.fillet_r, 0) ThenBlock: {
                // default R = 5 mm
                CadApp.fillet_r = 0x4014000000000000
            }
            xy = Allocate(32)
            CA_PixToWorld(px, py, xy)
            wx = ArrayGet(xy, 0)
            wy = ArrayGet(xy, 1)
            Deallocate(xy, 32)
            ki = Allocate(32)
            IfCondition EqualTo(CA_HitEntity(wx, wy, ki), 0) ThenBlock: {
                CA_Log("cad_app: fillet miss - click a line\n", 36)
                Deallocate(ki, 32)
                ReturnValue(0)
            }
            hk = ArrayGet(ki, 0)
            hi = ArrayGet(ki, 1)
            Deallocate(ki, 32)
            li = hi
            ok = 0
            IfCondition EqualTo(hk, 2) ThenBlock: {
                li = hi
                ok = 1
            }
            IfCondition EqualTo(hk, 0) ThenBlock: {
                li = Divide(hi, 2)
                ok = 1
            }
            IfCondition EqualTo(ok, 0) ThenBlock: {
                CA_Log("cad_app: fillet needs a line\n", 29)
                ReturnValue(0)
            }
            IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: {
                CadApp.fillet_li = li
                CadApp.nclick = 1
                CA_Log("cad_app: fillet pick 1/2\n", 25)
                CA_PublishFrame()
                ReturnValue(0)
            }
            // second line
            lj = li
            li = CadApp.fillet_li
            rc = CAD_Sketch.FilletLines(CadApp.sketch, li, lj, CadApp.fillet_r)
            CadApp.nclick = 0
            CadApp.fillet_li = -1
            IfCondition EqualTo(rc, 0) ThenBlock: {
                CadApp.dirty = 1
                CA_InvalidateProfiles()
                CA_Log("cad_app: fillet OK\n", 19)
            }
            IfCondition EqualTo(rc, -3) ThenBlock: {
                CA_Log("cad_app: fillet fail parallel\n", 30)
            }
            IfCondition EqualTo(rc, -4) ThenBlock: {
                CA_Log("cad_app: fillet fail R too big\n", 31)
            }
            IfCondition LessThan(rc, 0) ThenBlock: {
                IfCondition NotEqual(rc, -3) ThenBlock: {
                    IfCondition NotEqual(rc, -4) ThenBlock: {
                        CA_Log("cad_app: fillet fail\n", 21)
                    }
                }
            }
            CA_PublishFrame()
            ReturnValue(0)
        }
        // Pick / Trim always work (switch out of 3D first)
        IfCondition EqualTo(CadApp.tool, 4) ThenBlock: {
            CadApp.mode = 1
            IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                CadApp.sketch = CAD_Sketch.CreateSketch(1)
            }
            xy = Allocate(32)
            CA_PixToWorld(px, py, xy)
            CA_PickProfileAt(ArrayGet(xy, 0), ArrayGet(xy, 1), CadApp.click_shift)
            CadApp.click_shift = 0
            Deallocate(xy, 32)
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CA_PublishFrame()
            ReturnValue(0)
        }
        IfCondition EqualTo(CadApp.tool, 5) ThenBlock: {
            CadApp.mode = 1
            IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                CadApp.sketch = CAD_Sketch.CreateSketch(1)
            }
            xy = Allocate(32)
            CA_PixToWorld(px, py, xy)
            CA_TrimAt(ArrayGet(xy, 0), ArrayGet(xy, 1))
            Deallocate(xy, 32)
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CA_PublishFrame()
            ReturnValue(0)
        }
        // 3D: nav cube face?
        IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
            hit = CAD_View.HitNavCube(px, py, CadApp.width, CadApp.height_px)
            IfCondition GreaterEqual(hit, 0) ThenBlock: {
                CadApp.view = hit
                CAD_View.SetViewMode(hit)
                CA_PublishFrame()
                ReturnValue(0)
            }
            // OnTop face-pick: click solid planar face → sketch on it
            IfCondition EqualTo(CadApp.face_pick, 1) ThenBlock: {
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                    fh = CA_PickFaceAt(px, py)
                    IfCondition EqualTo(fh, 0) ThenBlock: {
                        CA_Log("cad_app: face miss — orbit and click the solid\n", 47)
                        CA_PublishFrame()
                        ReturnValue(0)
                    }
                    CA_SketchOnFace(fh)
                    CA_PublishFrame()
                    ReturnValue(0)
                }
            }
            ReturnValue(0)
        }
        // sketch mode
        IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
            CadApp.sketch = CAD_Sketch.CreateSketch(1)
        }
        CAD_Sketch.EnsureDatum(CadApp.sketch)
        xy = Allocate(32)
        CA_PixToWorld(px, py, xy)
        wx = ArrayGet(xy, 0)
        wy = ArrayGet(xy, 1)
        // Arc3: no snap on through/end — snap was jumping end off the preview
        // and rebuilding a different (often exterior) circle on commit.
        IfCondition NotEqual(CadApp.tool, 9) ThenBlock: {
            sn = Allocate(32)
            CA_SnapWorld(wx, wy, sn)
            wx = ArrayGet(sn, 0)
            wy = ArrayGet(sn, 1)
            Deallocate(sn, 32)
        }
        // Arc3 first click may still snap to start on existing geom
        IfCondition EqualTo(CadApp.tool, 9) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 0) ThenBlock: {
                sn = Allocate(32)
                CA_SnapWorld(wx, wy, sn)
                wx = ArrayGet(sn, 0)
                wy = ArrayGet(sn, 1)
                Deallocate(sn, 32)
            }
        }
        Deallocate(xy, 32)
        // tool Point: single click places first-class Point in UV
        IfCondition EqualTo(CadApp.tool, 6) ThenBlock: {
            pi = CAD_Sketch.AddUserPoint(CadApp.sketch, wx, wy, 0)
            IfCondition GreaterEqual(pi, 0) ThenBlock: {
                CadApp.last_upt = pi
                CadApp.dirty = 1
                CA_Log("cad_app: point placed (snap or free)\n", 36)
            }
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CA_PublishFrame()
            ReturnValue(0)
        }
        nc = CadApp.nclick
        IfCondition EqualTo(nc, 0) ThenBlock: {
            CadApp.cx0 = wx
            CadApp.cy0 = wy
            CadApp.nclick = 1
            // seed rubber-band at click (host may not send hover until move)
            CadApp.hover_px = px
            CadApp.hover_py = py
            CadApp.hover_ok = 1
            CA_PublishFrame()
            ReturnValue(0)
        }
        IfCondition EqualTo(CadApp.tool, 0) ThenBlock: {
            CAD_Sketch.AddLine(CadApp.sketch, CadApp.cx0, CadApp.cy0, wx, wy)
            // refresh anchors (ends + any touch/cross with existing)
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            // chain: next segment starts at this tip
            CadApp.cx0 = wx
            CadApp.cy0 = wy
            CadApp.nclick = 1
            CA_Log("cad_app: line added (chain on)\n", 28)
            CA_PublishFrame()
            ReturnValue(0)
        }
        IfCondition EqualTo(CadApp.tool, 1) ThenBlock: {
            x0 = CadApp.cx0
            y0 = CadApp.cy0
            x1 = wx
            y1 = wy
            CAD_Sketch.AddLine(CadApp.sketch, x0, y0, x1, y0)
            CAD_Sketch.AddLine(CadApp.sketch, x1, y0, x1, y1)
            CAD_Sketch.AddLine(CadApp.sketch, x1, y1, x0, y1)
            CAD_Sketch.AddLine(CadApp.sketch, x0, y1, x0, y0)
            CAD_Sketch.RebuildAnchors(CadApp.sketch)
            CadApp.dirty = 1
            CA_InvalidateProfiles()
            CA_Log("cad_app: rect added\n", 20)
        }
        IfCondition EqualTo(CadApp.tool, 2) ThenBlock: {
            dx = Float_Sub(wx, CadApp.cx0)
            dy = Float_Sub(wy, CadApp.cy0)
            rad = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
            IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 0) ThenBlock: {
                CAD_Sketch.AddCircle(CadApp.sketch, CadApp.cx0, CadApp.cy0, rad)
                CadApp.dirty = 1
                CA_InvalidateProfiles()
                CA_Log("cad_app: circle added\n", 22)
            }
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CA_PublishFrame()
            ReturnValue(0)
        }
        // arc center-radius: click1 center, click2 start (radius+a0), click3 end (a1)
        IfCondition EqualTo(CadApp.tool, 3) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                // second click = start point on arc
                dx = Float_Sub(wx, CadApp.cx0)
                dy = Float_Sub(wy, CadApp.cy0)
                CadApp.arc_rad = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                CadApp.arc_a0 = CAD_Geom.Atan2(dy, dx)
                CadApp.nclick = 2
                CA_PublishFrame()
                ReturnValue(0)
            }
            IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: {
                dx = Float_Sub(wx, CadApp.cx0)
                dy = Float_Sub(wy, CadApp.cy0)
                a1 = CAD_Geom.Atan2(dy, dx)
                IfCondition EqualTo(CAD_Num.IsZero(CadApp.arc_rad, 0), 0) ThenBlock: {
                    CAD_Sketch.AddArc(CadApp.sketch, CadApp.cx0, CadApp.cy0, CadApp.arc_rad, CadApp.arc_a0, a1)
                    CAD_Sketch.RebuildAnchors(CadApp.sketch)
                    CadApp.dirty = 1
                    CA_InvalidateProfiles()
                    CA_Log("cad_app: arc added\n", 19)
                }
                CadApp.nclick = 0
                CadApp.hover_ok = 0
                CA_PublishFrame()
                ReturnValue(0)
            }
        }
        // 3-point arc: start → through → end (uses cx0/cy0, arc_rad/arc_a0 as temp through)
        IfCondition EqualTo(CadApp.tool, 9) ThenBlock: {
            IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
                // second = through point (stash in arc temp + keep start in cx0/cy0)
                CadApp.arc_rad = wx
                CadApp.arc_a0 = wy
                CadApp.nclick = 2
                CadApp.hover_px = px
                CadApp.hover_py = py
                CadApp.hover_ok = 1
                CA_Log("cad_app: arc3 through set\n", 25)
                CA_PublishFrame()
                ReturnValue(0)
            }
            IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: {
                // WYSIWYG: pin 3 points + sketch, then Fit(6) + CommitLast(1).
                // Never one 7-arg call — ABI clobber made wrong arcs / fill under purple.
                p0x = CadApp.cx0
                p0y = CadApp.cy0
                p1x = CadApp.arc_rad
                p1y = CadApp.arc_a0
                p2x = wx
                p2y = wy
                hsk = CadApp.sketch
                fr = CAD_Sketch.Arc3Fit(p0x, p0y, p1x, p1y, p2x, p2y)
                rc = -3
                IfCondition EqualTo(fr, 0) ThenBlock: {
                    rc = CAD_Sketch.Arc3CommitLast(hsk)
                }
                IfCondition EqualTo(rc, 0) ThenBlock: {
                    CadApp.dirty = 1
                    CA_InvalidateProfiles()
                    CA_Log("cad_app: arc3 OK\n", 17)
                }
                IfCondition EqualTo(rc, -3) ThenBlock: {
                    CA_Log("cad_app: arc3 fail collinear\n", 29)
                }
                IfCondition LessThan(rc, 0) ThenBlock: {
                    IfCondition NotEqual(rc, -3) ThenBlock: {
                        CA_Log("cad_app: arc3 fail\n", 19)
                    }
                }
                CadApp.nclick = 0
                CadApp.hover_ok = 0
                CA_PublishFrame()
                ReturnValue(0)
            }
        }
        CadApp.nclick = 0
        CadApp.hover_ok = 0
        CA_PublishFrame()
        ReturnValue(0)
    }
}

// Hover for rubber-band (sketch mode only redraws when placing second point).
Function.CA_OnHover {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        CadApp.hover_px = px
        CadApp.hover_py = py
        CadApp.hover_ok = 1
        IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
            IfCondition GreaterThan(CadApp.nclick, 0) ThenBlock: {
                CA_PublishFrame()
            }
            // arc3 / fillet always refresh on hover in sketch even if nclick race
            IfCondition EqualTo(CadApp.tool, 9) ThenBlock: {
                CA_PublishFrame()
            }
        }
        ReturnValue(0)
    }
}

// Arc3 rubber-band: markers + live arc from CAD_Sketch.Arc3Fit (same as commit).
Function.CA_DrawArc3Preview {
    Input: hx: Integer
    Input: hy: Integer
    Output: Integer
    Body: {
        pt = Allocate(32)
        col = FB_RGB(80, 255, 255)
        col_th = FB_RGB(255, 220, 60)
        col_arc = FB_RGB(0, 255, 180)
        two_pi = 0x401921FB54442D18
        CA_WorldToPix(CadApp.cx0, CadApp.cy0, pt)
        sx = ArrayGet(pt, 0)
        sy = ArrayGet(pt, 1)
        FB_FillRect(Subtract(sx, 4), Subtract(sy, 4), 9, 9, FB_RGB(255, 60, 60))
        FB_FillRect(Subtract(sx, 2), Subtract(sy, 2), 5, 5, col)
        IfCondition EqualTo(CadApp.nclick, 1) ThenBlock: {
            CA_WorldToPix(hx, hy, pt)
            ex = ArrayGet(pt, 0)
            ey = ArrayGet(pt, 1)
            FB_Line(sx, sy, ex, ey, col)
            FB_Line(Add(sx, 1), sy, Add(ex, 1), ey, col)
            FB_FillRect(Subtract(ex, 3), Subtract(ey, 3), 7, 7, col_th)
        }
        IfCondition EqualTo(CadApp.nclick, 2) ThenBlock: {
            p1x = CadApp.arc_rad
            p1y = CadApp.arc_a0
            CA_WorldToPix(p1x, p1y, pt)
            mx = ArrayGet(pt, 0)
            my = ArrayGet(pt, 1)
            CA_WorldToPix(hx, hy, pt)
            ex = ArrayGet(pt, 0)
            ey = ArrayGet(pt, 1)
            FB_Line(sx, sy, mx, my, col_th)
            FB_Line(Add(sx, 1), sy, Add(mx, 1), my, col_th)
            FB_Line(mx, my, ex, ey, col_th)
            FB_Line(Add(mx, 1), my, Add(ex, 1), ey, col_th)
            FB_FillRect(Subtract(mx, 3), Subtract(my, 3), 7, 7, col_th)
            FB_FillRect(Subtract(ex, 3), Subtract(ey, 3), 7, 7, col)
            // Shared fit → CAD_Sketch_Arc3 (commit will use Arc3CommitLast)
            // pin all 6 before Fit (FixedPool field args + hx/hy)
            f0x = CadApp.cx0
            f0y = CadApp.cy0
            f2x = hx
            f2y = hy
            fr = CAD_Sketch.Arc3Fit(f0x, f0y, p1x, p1y, f2x, f2y)
            IfCondition EqualTo(fr, 0) ThenBlock: {
                acx = CAD_Sketch_Arc3.cx
                acy = CAD_Sketch_Arc3.cy
                rad = CAD_Sketch_Arc3.rad
                aa0 = CAD_Sketch_Arc3.a0
                aa1 = CAD_Sketch_Arc3.a1
                span = Float_Sub(aa1, aa0)
                IfCondition EqualTo(Float_Le(span, 0), 1) ThenBlock: {
                    span = Float_Add(span, two_pi)
                }
                nseg = 40
                k = 0
                WhileLoop LessThan(k, nseg) {
                    t0 = Float_Div(Float_FromInt(k), Float_FromInt(nseg))
                    t1 = Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(nseg))
                    ang0 = Float_Add(aa0, Float_Mul(span, t0))
                    ang1 = Float_Add(aa0, Float_Mul(span, t1))
                    CA_WorldToPix(Float_Add(acx, Float_Mul(rad, CAD_Geom.Cos(ang0))), Float_Add(acy, Float_Mul(rad, CAD_Geom.Sin(ang0))), pt)
                    xa = ArrayGet(pt, 0)
                    ya = ArrayGet(pt, 1)
                    CA_WorldToPix(Float_Add(acx, Float_Mul(rad, CAD_Geom.Cos(ang1))), Float_Add(acy, Float_Mul(rad, CAD_Geom.Sin(ang1))), pt)
                    xb = ArrayGet(pt, 0)
                    yb = ArrayGet(pt, 1)
                    FB_Line(xa, ya, xb, yb, col_arc)
                    FB_Line(Add(xa, 1), ya, Add(xb, 1), yb, col_arc)
                    k = Add(k, 1)
                }
                CA_WorldToPix(acx, acy, pt)
                FB_FillRect(Subtract(ArrayGet(pt, 0), 3), Subtract(ArrayGet(pt, 1), 3), 7, 7, FB_RGB(255, 80, 80))
            }
        }
        Deallocate(pt, 32)
        ReturnValue(1)
    }
}

// Cancel in-progress tool (second click pending).
Function.CA_CancelTool {
    Output: Integer
    Body: {
        CadApp.nclick = 0
        CadApp.hover_ok = 0
        CadApp.cstr_npick = 0
        CadApp.face_pick = 0
        CA_Log("cad_app: tool cancel\n", 20)
        ReturnValue(0)
    }
}

// Write tool strip state for host: mode tool nclick dirty cstr_type npick
Function.CA_WriteToolFile {
    Output: Integer
    Body: {
        sb = Allocate(48)
        // "M T N D CT NP\n" — CT is 2-digit constraint type for panel highlight
        pos = 0
        SetByte(sb, pos, Add(48, CadApp.mode))
        pos = Add(pos, 1)
        SetByte(sb, pos, 32)
        pos = Add(pos, 1)
        SetByte(sb, pos, Add(48, CadApp.tool))
        pos = Add(pos, 1)
        SetByte(sb, pos, 32)
        pos = Add(pos, 1)
        SetByte(sb, pos, Add(48, CadApp.nclick))
        pos = Add(pos, 1)
        SetByte(sb, pos, 32)
        pos = Add(pos, 1)
        SetByte(sb, pos, Add(48, CadApp.dirty))
        pos = Add(pos, 1)
        SetByte(sb, pos, 32)
        pos = Add(pos, 1)
        ct = CadApp.cstr_type
        IfCondition GreaterThan(ct, 99) ThenBlock: { ct = 99 }
        SetByte(sb, pos, Add(48, Divide(ct, 10)))
        pos = Add(pos, 1)
        SetByte(sb, pos, Add(48, Modulo(ct, 10)))
        pos = Add(pos, 1)
        SetByte(sb, pos, 32)
        pos = Add(pos, 1)
        np = CadApp.cstr_npick
        IfCondition GreaterThan(np, 9) ThenBlock: { np = 9 }
        SetByte(sb, pos, Add(48, np))
        pos = Add(pos, 1)
        SetByte(sb, pos, 10)
        pos = Add(pos, 1)
        SetByte(sb, pos, 0)
        fd = SystemCall(2, "/tmp/cad_app/tool.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, sb, pos)
            SystemCall(3, fd, 0, 0)
        }
        Deallocate(sb, 48)
        ReturnValue(0)
    }
}

// Parse signed int at buf[i], write value to out_addr[0], return new index or -1
Function.CA_ParseSigned {
    Input: buf: Address
    Input: i: Integer
    Input: out_addr: Address
    Output: Integer
    Body: {
        WhileLoop EqualTo(GetByte(buf, i), 32) {
            i = Add(i, 1)
            IfCondition GreaterThan(i, 70) ThenBlock: { ReturnValue(-1) }
        }
        neg = 0
        IfCondition EqualTo(GetByte(buf, i), 45) ThenBlock: {
            neg = 1
            i = Add(i, 1)
        }
        val = 0
        got = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            ch = GetByte(buf, i)
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: {
                    val = Add(Multiply(val, 10), Subtract(ch, 48))
                    got = 1
                    i = Add(i, 1)
                }
                IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
                IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            }
            IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
            IfCondition GreaterThan(i, 70) ThenBlock: { done = 1 }
        }
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(neg, 1) ThenBlock: { val = Subtract(0, val) }
        ArraySet(out_addr, 0, val)
        ReturnValue(i)
    }
}

// Parse "click N M" — returns 1 if click handled
Function.CA_TryParseClick {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        // need "click "
        IfCondition LessThan(n, 8) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 0), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 1), 108) ThenBlock: { ReturnValue(0) }
        // parse ints after "click "
        i = 6
        // skip spaces
        WhileLoop LessThan(i, n) {
            IfCondition NotEqual(GetByte(buf, i), 32) ThenBlock: {
                // break by setting flag
                i2 = i
                i = n
            }
            IfCondition LessThan(i, n) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, i), 32) ThenBlock: { i = Add(i, 1) }
            }
        }
        i = 6
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(GetByte(buf, i), 32) ThenBlock: { i = Add(i, 1) }
            IfCondition NotEqual(GetByte(buf, i), 32) ThenBlock: {
                // fall through
                i = i
            }
            IfCondition GreaterThan(i, 5) ThenBlock: {
                IfCondition NotEqual(GetByte(buf, i), 32) ThenBlock: {
                    // parse
                    i = i
                }
            }
        }
        // simpler: fixed parse from index 6
        i = 6
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(GetByte(buf, i), 32) ThenBlock: { i = Add(i, 1) }
            IfCondition NotEqual(GetByte(buf, i), 32) ThenBlock: {
                // start digits
                px = 0
                WhileLoop LessThan(i, n) {
                    ch = GetByte(buf, i)
                    IfCondition LessThan(ch, 48) ThenBlock: { i = n }
                    IfCondition GreaterThan(ch, 57) ThenBlock: {
                        IfCondition GreaterEqual(ch, 48) ThenBlock: {
                            IfCondition LessEqual(ch, 57) ThenBlock: {
                                // digit
                            }
                        }
                    }
                    IfCondition LessThan(i, n) ThenBlock: {
                        ch = GetByte(buf, i)
                        IfCondition GreaterEqual(ch, 48) ThenBlock: {
                            IfCondition LessEqual(ch, 57) ThenBlock: {
                                px = Add(Multiply(px, 10), Subtract(ch, 48))
                                i = Add(i, 1)
                            }
                            IfCondition GreaterThan(ch, 57) ThenBlock: { i = n }
                            IfCondition LessThan(ch, 48) ThenBlock: { i = n }
                        }
                        IfCondition LessThan(ch, 48) ThenBlock: { i = n }
                    }
                }
                // skip spaces
                j = 6
                // re-parse cleanly
                j = 6
                WhileLoop EqualTo(GetByte(buf, j), 32) {
                    j = Add(j, 1)
                    IfCondition GreaterThan(j, n) ThenBlock: { j = n }
                }
                px = 0
                WhileLoop LessThan(j, n) {
                    ch = GetByte(buf, j)
                    IfCondition GreaterEqual(ch, 48) ThenBlock: {
                        IfCondition LessEqual(ch, 57) ThenBlock: {
                            px = Add(Multiply(px, 10), Subtract(ch, 48))
                            j = Add(j, 1)
                        }
                        IfCondition GreaterThan(ch, 57) ThenBlock: { j = n }
                        IfCondition LessThan(ch, 48) ThenBlock: { j = n }
                    }
                    IfCondition LessThan(ch, 48) ThenBlock: { j = n }
                    IfCondition GreaterThan(ch, 57) ThenBlock: {
                        IfCondition LessThan(ch, 48) ThenBlock: { j = n }
                    }
                }
                // after first number, j may be past end due to break — rescan
                j = 6
                WhileLoop LessThan(j, n) {
                    IfCondition EqualTo(GetByte(buf, j), 32) ThenBlock: { j = Add(j, 1) }
                    IfCondition NotEqual(GetByte(buf, j), 32) ThenBlock: {
                        // mark
                        j = j
                    }
                }
                ReturnValue(0)
            }
        }
        ReturnValue(0)
    }
}

// Clean integer parse: "click X Y"
Function.CA_ParseClick {
    Input: buf: Address
    Output: Integer
    Body: {
        // verify prefix click
        IfCondition NotEqual(GetByte(buf, 0), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 1), 108) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 2), 105) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 3), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, 4), 107) ThenBlock: { ReturnValue(0) }
        i = 5
        WhileLoop EqualTo(GetByte(buf, i), 32) {
            i = Add(i, 1)
            IfCondition GreaterThan(i, 60) ThenBlock: { ReturnValue(0) }
        }
        px = 0
        got = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            ch = GetByte(buf, i)
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: {
                    px = Add(Multiply(px, 10), Subtract(ch, 48))
                    got = 1
                    i = Add(i, 1)
                }
                IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
                IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            }
            IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
            IfCondition GreaterThan(i, 60) ThenBlock: { done = 1 }
        }
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        WhileLoop EqualTo(GetByte(buf, i), 32) {
            i = Add(i, 1)
            IfCondition GreaterThan(i, 60) ThenBlock: { ReturnValue(0) }
        }
        py = 0
        got = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            ch = GetByte(buf, i)
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: {
                    py = Add(Multiply(py, 10), Subtract(ch, 48))
                    got = 1
                    i = Add(i, 1)
                }
                IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
                IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            }
            IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
            IfCondition GreaterThan(i, 60) ThenBlock: { done = 1 }
        }
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        // optional third int: shift (1 = multi-select toggle)
        CadApp.click_shift = 0
        WhileLoop EqualTo(GetByte(buf, i), 32) {
            i = Add(i, 1)
            IfCondition GreaterThan(i, 70) ThenBlock: { i = 71 }
        }
        IfCondition LessThan(i, 70) ThenBlock: {
            ch = GetByte(buf, i)
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: {
                    CadApp.click_shift = Subtract(ch, 48)
                }
            }
        }
        CA_OnClick(px, py)
        ReturnValue(1)
    }
}

Function.CA_PollCmd {
    Output: Integer
    Body: {
        fd = SystemCall(2, "/tmp/cad_app/cmd.txt", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(80)
        n = SystemCall(0, fd, buf, 79)
        SystemCall(3, fd, 0, 0)
        fd2 = SystemCall(2, "/tmp/cad_app/cmd.txt", 577, 420)
        IfCondition GreaterEqual(fd2, 0) ThenBlock: { SystemCall(3, fd2, 0, 0) }
        IfCondition LessThan(n, 1) ThenBlock: {
            Deallocate(buf, 80)
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        // orbit dx dy
        IfCondition EqualTo(GetByte(buf, 0), 111) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 114) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 98) ThenBlock: {
                    out = Allocate(16)
                    i = CA_ParseSigned(buf, 5, out)
                    ok = 0
                    dx = 0
                    dy = 0
                    IfCondition GreaterThan(i, 0) ThenBlock: {
                        dx = ArrayGet(out, 0)
                        j = CA_ParseSigned(buf, i, out)
                        IfCondition GreaterThan(j, 0) ThenBlock: {
                            dy = ArrayGet(out, 0)
                            ok = 1
                        }
                    }
                    Deallocate(out, 16)
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        CAD_View.OrbitPixels(dx, dy)
                        CadApp.mode = 0
                        CA_PublishFrame()
                        CA_Log("cad_app: orbit\n", 16)
                    }
                    Deallocate(buf, 80)
                    ReturnValue(2)
                }
            }
        }
        // zoom N — sketch: sk_zoom; 3D: view zoom
        IfCondition EqualTo(GetByte(buf, 0), 122) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                out = Allocate(16)
                i = CA_ParseSigned(buf, 4, out)
                zs = 0
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    zs = ArrayGet(out, 0)
                    IfCondition EqualTo(CadApp.mode, 1) ThenBlock: {
                        IfCondition EqualTo(CadApp.sk_zoom, 0) ThenBlock: {
                            CadApp.sk_zoom = 0x3FF0000000000000
                        }
                        zin = 0x3FF2666666666666
                        zout = 0x3FEBD37A6F4DE9BE
                        zmin = 0x3FB999999999999A
                        zmax = 0x4034000000000000
                        s = 0
                        WhileLoop LessThan(s, 64) {
                            IfCondition EqualTo(zs, 0) ThenBlock: { s = 64 }
                            IfCondition GreaterThan(zs, 0) ThenBlock: {
                                CadApp.sk_zoom = Float_Mul(CadApp.sk_zoom, zin)
                                zs = Subtract(zs, 1)
                            }
                            IfCondition LessThan(zs, 0) ThenBlock: {
                                CadApp.sk_zoom = Float_Mul(CadApp.sk_zoom, zout)
                                zs = Add(zs, 1)
                            }
                            s = Add(s, 1)
                        }
                        IfCondition EqualTo(Float_Le(CadApp.sk_zoom, zmin), 1) ThenBlock: {
                            CadApp.sk_zoom = zmin
                        }
                        IfCondition EqualTo(Float_Le(zmax, CadApp.sk_zoom), 1) ThenBlock: {
                            CadApp.sk_zoom = zmax
                        }
                        CA_Log("cad_app: sketch zoom\n", 22)
                    }
                    IfCondition EqualTo(CadApp.mode, 0) ThenBlock: {
                        CAD_View.ZoomSteps(zs)
                        CA_Log("cad_app: zoom\n", 15)
                    }
                    CA_PublishFrame()
                }
                Deallocate(out, 16)
                Deallocate(buf, 80)
                ReturnValue(2)
            }
        }
        // pan dx dy (pixel deltas from sketch hold-drag)
        IfCondition EqualTo(GetByte(buf, 0), 112) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 97) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 110) ThenBlock: {
                    out = Allocate(16)
                    i = CA_ParseSigned(buf, 3, out)
                    IfCondition GreaterThan(i, 0) ThenBlock: {
                        pdx = ArrayGet(out, 0)
                        j = CA_ParseSigned(buf, i, out)
                        IfCondition GreaterThan(j, 0) ThenBlock: {
                            pdy = ArrayGet(out, 0)
                            CA_UpdateSketchCam()
                            sc = CadApp.scale
                            IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
                                sc = 0x3FF0000000000000
                            }
                            // drag right → view moves right → pan center moves left in world
                            CadApp.sk_pan_x = Float_Sub(CadApp.sk_pan_x, Float_Div(Float_FromInt(pdx), sc))
                            CadApp.sk_pan_y = Float_Add(CadApp.sk_pan_y, Float_Div(Float_FromInt(pdy), sc))
                            CadApp.mode = 1
                            CA_PublishFrame()
                        }
                    }
                    Deallocate(out, 16)
                    Deallocate(buf, 80)
                    ReturnValue(2)
                }
            }
        }
        // hover x y (rubber-band)
        IfCondition EqualTo(GetByte(buf, 0), 104) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                out = Allocate(16)
                i = CA_ParseSigned(buf, 5, out)
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    hx = ArrayGet(out, 0)
                    j = CA_ParseSigned(buf, i, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        hy = ArrayGet(out, 0)
                        CA_OnHover(hx, hy)
                    }
                }
                Deallocate(out, 16)
                Deallocate(buf, 80)
                ReturnValue(2)
            }
        }
        // click
        IfCondition EqualTo(CA_ParseClick(buf), 1) ThenBlock: {
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        c0 = GetByte(buf, 0)
        IfCondition EqualTo(c0, 113) ThenBlock: {
            Deallocate(buf, 80)
            ReturnValue(1)
        }
        // mode
        IfCondition EqualTo(c0, 109) ThenBlock: {
            CadApp.mode = Subtract(1, CadApp.mode)
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // tool_line / tool_rect / tool_circ / tool_arc / tool_pick / tool_trim
        IfCondition EqualTo(c0, 116) ThenBlock: {
            // tool_
            t = GetByte(buf, 5)
            IfCondition EqualTo(t, 108) ThenBlock: { CadApp.tool = 0 }
            IfCondition EqualTo(t, 114) ThenBlock: { CadApp.tool = 1 }
            IfCondition EqualTo(t, 99) ThenBlock: { CadApp.tool = 2 }
            // Pin tool_ bytes once (no re-GetByte after nested calls).
            // tool_arc = center arc; tool_arc3 / tool_3pt = three-point arc.
            b8 = GetByte(buf, 8)
            // tool_3pt (preferred panel cmd) — byte5 is '3', unique
            IfCondition EqualTo(t, 51) ThenBlock: {
                CadApp.tool = 9
                CadApp.mode = 1
                CadApp.nclick = 0
            }
            // tool_arc / tool_arc3 — byte5 is 'a'
            IfCondition EqualTo(t, 97) ThenBlock: {
                is3 = 0
                IfCondition EqualTo(b8, 51) ThenBlock: { is3 = 1 }
                IfCondition EqualTo(is3, 1) ThenBlock: {
                    CadApp.tool = 9
                    CadApp.mode = 1
                    CadApp.nclick = 0
                }
                IfCondition EqualTo(is3, 0) ThenBlock: {
                    CadApp.tool = 3
                }
            }
            // tool_pick / tool_point both start "tool_p…" — byte6: i=pick, o=point
            IfCondition EqualTo(t, 112) ThenBlock: {
                t6 = GetByte(buf, 6)
                IfCondition EqualTo(t6, 111) ThenBlock: {
                    // tool_point
                    CadApp.tool = 6
                    CadApp.mode = 1
                    CadApp.nclick = 0
                    CA_Log("cad_app: POINT tool — click to place\n", 36)
                }
                IfCondition NotEqual(t6, 111) ThenBlock: {
                    // tool_pick — project only if no profiles yet
                    CadApp.tool = 4
                    CadApp.mode = 1
                    CadApp.solid = 0
                    skn = 0
                    IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                        skn = CAD_Store.Read(CadApp.sketch, 12)
                    }
                    IfCondition EqualTo(skn, 0) ThenBlock: {
                        CA_RebuildProfiles()
                    }
                    IfCondition GreaterThan(skn, 0) ThenBlock: {
                        CadApp.nprof = skn
                        CA_Log("cad_app: Pick — click red/white ring; Shift+click multi\n", 54)
                        CA_Log("  if none: Trim stubs past crossings, Profiles again\n", 53)
                    }
                }
            }
            // tool_trim
            IfCondition EqualTo(t, 116) ThenBlock: { CadApp.tool = 5 }
            // tool_fillet — byte5 'f'
            IfCondition EqualTo(t, 102) ThenBlock: {
                CadApp.tool = 8
                CadApp.mode = 1
                CadApp.nclick = 0
                CadApp.fillet_li = -1
                IfCondition EqualTo(CadApp.fillet_r, 0) ThenBlock: {
                    CadApp.fillet_r = 0x4014000000000000
                }
            }
            CadApp.nclick = 0
            CadApp.hover_ok = 0
            CadApp.mode = 1
            // log after tool settled (avoid clobber of tool selection)
            IfCondition EqualTo(CadApp.tool, 9) ThenBlock: {
                CA_Log("cad_app: ARC3 - start, through, end\n", 36)
            }
            IfCondition EqualTo(CadApp.tool, 8) ThenBlock: {
                CA_Log("cad_app: FILLET - click 2 lines (R=5 default)\n", 46)
            }
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // plane_* / profiles / pt — all start with 'p'
        IfCondition EqualTo(c0, 112) ThenBlock: {
            // plane_* commands: plane_top plane_off plane_flip plane_ang plane_xy|xz|yz
            IfCondition EqualTo(GetByte(buf, 1), 108) ThenBlock: {
                // "plane..."
                // plane_top
                IfCondition EqualTo(GetByte(buf, 6), 116) ThenBlock: {
                    CA_PlaneOnTop()
                    CA_PublishFrame()
                    Deallocate(buf, 80)
                    ReturnValue(2)
                }
                // plane_off N
                IfCondition EqualTo(GetByte(buf, 6), 111) ThenBlock: {
                    out = Allocate(16)
                    // "plane_off " starts at index 10 for number
                    j = CA_ParseSigned(buf, 10, out)
                    dmm = 50
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        dmm = ArrayGet(out, 0)
                    }
                    Deallocate(out, 16)
                    CA_PlaneOffsetMm(dmm)
                    CA_PublishFrame()
                    Deallocate(buf, 80)
                    ReturnValue(2)
                }
                // plane_flip
                IfCondition EqualTo(GetByte(buf, 6), 102) ThenBlock: {
                    CA_PlaneFlip()
                    CA_PublishFrame()
                    Deallocate(buf, 80)
                    ReturnValue(2)
                }
                // plane_ang N
                IfCondition EqualTo(GetByte(buf, 6), 97) ThenBlock: {
                    out = Allocate(16)
                    j = CA_ParseSigned(buf, 10, out)
                    deg = 90
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        deg = ArrayGet(out, 0)
                    }
                    Deallocate(out, 16)
                    CA_PlaneAngleXDeg(deg)
                    CA_PublishFrame()
                    Deallocate(buf, 80)
                    ReturnValue(2)
                }
                // plane_xy / plane_xz / plane_yz
                IfCondition EqualTo(GetByte(buf, 6), 120) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, 7), 121) ThenBlock: {
                        CA_PlaneDatumXY()
                    }
                    IfCondition EqualTo(GetByte(buf, 7), 122) ThenBlock: {
                        CA_PlaneDatumXZ()
                    }
                    CA_PublishFrame()
                    Deallocate(buf, 80)
                    ReturnValue(2)
                }
                IfCondition EqualTo(GetByte(buf, 6), 121) ThenBlock: {
                    CA_PlaneDatumYZ()
                    CA_PublishFrame()
                    Deallocate(buf, 80)
                    ReturnValue(2)
                }
                // bare "plane" → OnTop if solid else new XY
                IfCondition EqualTo(CadApp.solid, 0) ThenBlock: {
                    CA_PlaneDatumXY()
                }
                IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                    CA_PlaneOnTop()
                }
                CA_PublishFrame()
                Deallocate(buf, 80)
                ReturnValue(2)
            }
            // "profiles" or "prof" — not "p" save alone handled later
            IfCondition EqualTo(GetByte(buf, 1), 114) ThenBlock: {
                CadApp.mode = 1
                // keep solid when sketching on a PlaneFeature (boss on top)
                IfCondition EqualTo(CadApp.plane, 0) ThenBlock: {
                    CadApp.solid = 0
                }
                CA_RebuildProfiles()
                CA_PublishFrame()
                Deallocate(buf, 80)
                ReturnValue(2)
            }
            // pt X Y — place user Point at integer mm UV (HUD-style numeric entry)
            IfCondition EqualTo(GetByte(buf, 1), 116) ThenBlock: {
                IfCondition EqualTo(CadApp.sketch, 0) ThenBlock: {
                    CadApp.sketch = CAD_Sketch.CreateSketch(1)
                }
                out = Allocate(16)
                i = CA_ParseSigned(buf, 2, out)
                ok = 0
                pxm = 0
                pym = 0
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    pxm = ArrayGet(out, 0)
                    j = CA_ParseSigned(buf, i, out)
                    IfCondition GreaterThan(j, 0) ThenBlock: {
                        pym = ArrayGet(out, 0)
                        ok = 1
                    }
                }
                Deallocate(out, 16)
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    CadApp.mode = 1
                    pi = CAD_Sketch.AddUserPoint(CadApp.sketch, Float_FromInt(pxm), Float_FromInt(pym), 0)
                    CadApp.last_upt = pi
                    CadApp.dirty = 1
                    CA_Log("cad_app: point at UV (pt X Y)\n", 30)
                    CA_PublishFrame()
                }
                Deallocate(buf, 80)
                ReturnValue(2)
            }
        }
        // sketch_pln / solve — start with 's'
        IfCondition EqualTo(c0, 115) ThenBlock: {
            // sketch_pln — new sketch on active construction plane
            IfCondition EqualTo(GetByte(buf, 1), 107) ThenBlock: {
                CA_SketchOnActivePlane()
                CA_PublishFrame()
                Deallocate(buf, 80)
                ReturnValue(2)
            }
            // solve — multipass constraint projection
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 108) ThenBlock: {
                    IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                        napp = CAD_Sketch.SolveConstraints(CadApp.sketch)
                        CA_InvalidateProfiles()
                        CadApp.dirty = 1
                        CA_Log("cad_app: SolveConstraints done\n", 30)
                        CA_PublishFrame()
                    }
                    Deallocate(buf, 80)
                    ReturnValue(2)
                }
            }
        }
        // cstr_* — interactive constraint tools (pick geom after)
        // cstr_coinc cstr_h cstr_v cstr_fixo cstr_disto cstr_rad cstr_tang cstr_pon cstr_eqr cstr_dist
        IfCondition EqualTo(c0, 99) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 115) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 116) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, 3), 114) ThenBlock: {
                        IfCondition EqualTo(GetByte(buf, 4), 95) ThenBlock: {
                            // cstr_
                            b5 = GetByte(buf, 5)
                            // coinc
                            IfCondition EqualTo(b5, 99) ThenBlock: {
                                CA_BeginConstraint(9)
                                CA_Log("cad_app: COIN - click point A, then B\n", 38)
                            }
                            // h
                            IfCondition EqualTo(b5, 104) ThenBlock: {
                                CA_BeginConstraint(7)
                                CA_Log("cad_app: H - click a line\n", 26)
                            }
                            // v
                            IfCondition EqualTo(b5, 118) ThenBlock: {
                                CA_BeginConstraint(8)
                                CA_Log("cad_app: V - click a line\n", 26)
                            }
                            // fixo
                            IfCondition EqualTo(b5, 102) ThenBlock: {
                                CA_BeginConstraint(1)
                                CA_Log("cad_app: FixO - click point or end\n", 35)
                            }
                            // disto / dist
                            IfCondition EqualTo(b5, 100) ThenBlock: {
                                // cstr_disto vs cstr_dist
                                IfCondition EqualTo(GetByte(buf, 9), 111) ThenBlock: {
                                    CA_BeginConstraint(6)
                                    CA_Log("cad_app: DistO - click point, lock |O|\n", 38)
                                }
                                IfCondition NotEqual(GetByte(buf, 9), 111) ThenBlock: {
                                    CA_BeginConstraint(15)
                                    CA_Log("cad_app: Dist - click pt A then B\n", 34)
                                }
                            }
                            // rad
                            IfCondition EqualTo(b5, 114) ThenBlock: {
                                CA_BeginConstraint(11)
                                CA_Log("cad_app: Rad - click circle rim/center\n", 39)
                            }
                            // tang
                            IfCondition EqualTo(b5, 116) ThenBlock: {
                                CA_BeginConstraint(13)
                                CA_Log("cad_app: TANG - line+circ or 2 circs\n", 37)
                            }
                            // pon
                            IfCondition EqualTo(b5, 112) ThenBlock: {
                                CA_BeginConstraint(10)
                                CA_Log("cad_app: OnLn - point then line\n", 32)
                            }
                            // eqr
                            IfCondition EqualTo(b5, 101) ThenBlock: {
                                CA_BeginConstraint(12)
                                CA_Log("cad_app: EqR - click 2 circles\n", 31)
                            }
                            CA_PublishFrame()
                            Deallocate(buf, 80)
                            ReturnValue(2)
                        }
                    }
                }
            }
        }
        // clear model tree / last pad (cmd "clear")
        IfCondition EqualTo(c0, 99) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 108) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 101) ThenBlock: {
                    CA_ClearModel()
                    CadApp.dirty = 1
                    CA_Log("cad_app: model tree cleared\n", 28)
                    CA_PublishFrame()
                    Deallocate(buf, 80)
                    ReturnValue(2)
                }
            }
        }
        // new document
        IfCondition EqualTo(c0, 110) ThenBlock: {
            // newdoc vs new sketch: "newdoc" or plain n
            IfCondition EqualTo(GetByte(buf, 1), 101) ThenBlock: {
                // "new..." -> DocNew if newdoc, else NewSketch
                IfCondition EqualTo(GetByte(buf, 3), 100) ThenBlock: {
                    CA_DocNew()
                }
                IfCondition NotEqual(GetByte(buf, 3), 100) ThenBlock: {
                    CA_DocNew()
                }
            }
            IfCondition NotEqual(GetByte(buf, 1), 101) ThenBlock: {
                CA_DocNew()
            }
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // repad / reload / revolve  (all start with 'r')
        IfCondition EqualTo(c0, 114) ThenBlock: {
            // "reload" if third char is 'l'
            IfCondition EqualTo(GetByte(buf, 2), 108) ThenBlock: {
                CA_ReloadDxf()
                CadApp.mode = 0
                CA_PublishFrame()
                Deallocate(buf, 80)
                ReturnValue(2)
            }
            // "revolve" if second char is 'e' and third is 'v'
            IfCondition EqualTo(GetByte(buf, 1), 101) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, 2), 118) ThenBlock: {
                    CA_RevolveFromSketch()
                    CadApp.mode = 0
                    CA_PublishFrame()
                    Deallocate(buf, 80)
                    ReturnValue(2)
                }
            }
            // default: repad
            CA_PadFromSketch()
            CadApp.mode = 0
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // cut (u or "cut")
        IfCondition EqualTo(c0, 117) ThenBlock: {
            CA_CutFromSketch()
            CadApp.mode = 0
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        IfCondition EqualTo(c0, 99) ThenBlock: {
            // "cut ..." vs click — click already handled; "cut" alone
            IfCondition EqualTo(GetByte(buf, 1), 117) ThenBlock: {
                CA_CutFromSketch()
                CadApp.mode = 0
                CA_PublishFrame()
                Deallocate(buf, 80)
                ReturnValue(2)
            }
        }
        // y / Next = cycle pad profile selection (explicit user choice)
        IfCondition EqualTo(c0, 121) ThenBlock: {
            CadApp.mode = 1
            CadApp.solid = 0
            skn = 0
            IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                skn = CAD_Store.Read(CadApp.sketch, 12)
            }
            IfCondition EqualTo(skn, 0) ThenBlock: {
                CA_RebuildProfiles()
                skn = CadApp.nprof
            }
            IfCondition EqualTo(skn, 0) ThenBlock: {
                IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                    skn = CAD_Store.Read(CadApp.sketch, 12)
                }
            }
            IfCondition EqualTo(skn, 0) ThenBlock: {
                CA_Log("cad_app: no profiles to select\n", 30)
            }
            IfCondition GreaterThan(skn, 0) ThenBlock: {
                CadApp.nprof = skn
                // first Next after rebuild starts at 0; further presses cycle
                IfCondition EqualTo(CadApp.prof_user, 0) ThenBlock: {
                    CadApp.prof_sel = 0
                }
                IfCondition EqualTo(CadApp.prof_user, 1) ThenBlock: {
                    CadApp.prof_sel = Add(CadApp.prof_sel, 1)
                    IfCondition GreaterEqual(CadApp.prof_sel, skn) ThenBlock: {
                        CadApp.prof_sel = 0
                    }
                }
                ok = CA_ApplyProfileSel(CadApp.prof_sel, skn, 0)
                IfCondition EqualTo(ok, 0) ThenBlock: {
                    CA_RebuildProfiles()
                    skn = CAD_Store.Read(CadApp.sketch, 12)
                    IfCondition GreaterThan(skn, 0) ThenBlock: {
                        CA_ApplyProfileSel(0, skn, 0)
                        CA_Log("cad_app: re-projected; profile selected\n", 39)
                    }
                }
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    CA_Log("cad_app: Next → profile selected (red)\n", 39)
                }
            }
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // --- document browser ---
        // list / files
        IfCondition EqualTo(c0, 102) ThenBlock: {
            CA_DocList()
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // j = sel next
        IfCondition EqualTo(c0, 106) ThenBlock: {
            CA_DocSelNext()
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // i = sel prev (also "selprev" word)
        IfCondition EqualTo(c0, 105) ThenBlock: {
            CA_DocSelPrev()
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // open (selected)
        IfCondition EqualTo(GetByte(buf, 0), 111) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 1), 112) ThenBlock: {
                CA_DocOpen()
                CadApp.mode = 0
                CA_PublishFrame()
                Deallocate(buf, 80)
                ReturnValue(2)
            }
        }
        // close
        IfCondition EqualTo(c0, 107) ThenBlock: {
            // k = close document
            CA_DocClose()
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        IfCondition EqualTo(c0, 99) ThenBlock: {
            // cancel (ca...) vs close (cl...)
            IfCondition EqualTo(GetByte(buf, 1), 97) ThenBlock: {
                CA_CancelTool()
                CA_PublishFrame()
                Deallocate(buf, 80)
                ReturnValue(2)
            }
            IfCondition EqualTo(GetByte(buf, 1), 108) ThenBlock: {
                CA_DocClose()
                CA_PublishFrame()
                Deallocate(buf, 80)
                ReturnValue(2)
            }
        }
        // put/save to Postgres (p or "save")
        IfCondition EqualTo(c0, 112) ThenBlock: {
            CA_RepoSave()
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        IfCondition EqualTo(c0, 115) ThenBlock: {
            // save vs step: second char 'a' => save
            IfCondition EqualTo(GetByte(buf, 1), 97) ThenBlock: {
                CA_RepoSave()
                CA_PublishFrame()
                Deallocate(buf, 80)
                ReturnValue(2)
            }
        }
        // get/load from Postgres (g or "load") — opens selection if list open
        IfCondition EqualTo(c0, 103) ThenBlock: {
            IfCondition EqualTo(CadApp.list_open, 1) ThenBlock: {
                CA_DocOpen()
            }
            IfCondition EqualTo(CadApp.list_open, 0) ThenBlock: {
                CA_RepoLoad()
            }
            CadApp.mode = 0
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        IfCondition EqualTo(c0, 108) ThenBlock: {
            // load (not tool_line which starts with t)
            IfCondition EqualTo(GetByte(buf, 1), 111) ThenBlock: {
                CA_RepoLoad()
                CadApp.mode = 0
                CA_PublishFrame()
                Deallocate(buf, 80)
                ReturnValue(2)
            }
        }
        // wire
        IfCondition EqualTo(c0, 119) ThenBlock: {
            CadApp.wire = Subtract(1, CadApp.wire)
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // view0/1/2 presets
        IfCondition EqualTo(c0, 118) ThenBlock: {
            c4 = GetByte(buf, 4)
            IfCondition EqualTo(c4, 48) ThenBlock: {
                CadApp.view = 0
                CAD_View.SetViewMode(0)
            }
            IfCondition EqualTo(c4, 49) ThenBlock: {
                CadApp.view = 1
                CAD_View.SetViewMode(1)
            }
            IfCondition EqualTo(c4, 50) ThenBlock: {
                CadApp.view = 2
                CAD_View.SetViewMode(2)
            }
            CadApp.mode = 0
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // hinc/hdec
        IfCondition EqualTo(c0, 104) ThenBlock: {
            c1 = GetByte(buf, 1)
            IfCondition EqualTo(c1, 105) ThenBlock: { CadApp.height = Add(CadApp.height, 1) }
            IfCondition EqualTo(c1, 100) ThenBlock: {
                IfCondition GreaterThan(CadApp.height, 1) ThenBlock: {
                    CadApp.height = Subtract(CadApp.height, 1)
                }
            }
            CA_PadFromSketch()
            CadApp.mode = 0
            CA_PublishFrame()
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // step
        IfCondition EqualTo(c0, 115) ThenBlock: {
            IfCondition NotEqual(CadApp.solid, 0) ThenBlock: {
                CAD_IO.ExportSTEP(CadApp.solid, "test-stl/cad_app_live.stp")
                CA_Log("cad_app: STEP ok\n", 17)
            }
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // bmp
        IfCondition EqualTo(c0, 98) ThenBlock: {
            CA_PublishFrame()
            CAD_View.SaveFBToBMP("test-stl/cad_app_live.bmp")
            CA_Log("cad_app: BMP ok\n", 16)
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        // dxf export
        IfCondition EqualTo(c0, 100) ThenBlock: {
            IfCondition NotEqual(CadApp.sketch, 0) ThenBlock: {
                CAD_DXF.ExportSketch(CadApp.sketch, "test-stl/cad_app_sketch.dxf")
                CA_Log("cad_app: DXF ok\n", 16)
            }
            Deallocate(buf, 80)
            ReturnValue(2)
        }
        Deallocate(buf, 80)
        ReturnValue(0)
    }
}

Function.CA_BuildSchema {
    Output: Address
    Body: {
        s = UtilArgs_NewSchema("cad_app", "Live DXF/sketch → solid viewer")
        UtilArgs_AddField(s, "in", "path", 0, "Input plate/profile DXF", "in")
        UtilArgs_AddField(s, "hole", "path", 0, "Optional hole DXF (through cut)", "hole")
        UtilArgs_AddField(s, "name", "string", 0, "Part name for Postgres save/load", "name")
        UtilArgs_AddField(s, "save", "bool", 0, "Headless: save part to Postgres", "save")
        UtilArgs_AddField(s, "load", "bool", 0, "Headless: load part from Postgres", "load")
        UtilArgs_AddField(s, "height", "int", 0, "Pad / plate thickness mm", "height")
        UtilArgs_AddField(s, "width", "int", 0, "View width", "width")
        UtilArgs_AddField(s, "imgh", "int", 0, "View height", "imgh")
        UtilArgs_AddField(s, "shot", "path", 0, "Headless BMP", "shot")
        UtilArgs_AddField(s, "headless", "bool", 0, "One-shot BMP", "headless")
        UtilArgs_AddField(s, "nohost", "bool", 0, "No X11 host", "nohost")
        UtilArgs_AddField(s, "sketch-demo", "bool", 0, "Headless: build rect sketch and pad", "sketch-demo")
        UtilArgs_SetShort(s, "in", "i")
        UtilArgs_SetShort(s, "hole", "k")
        UtilArgs_SetShort(s, "height", "H")
        UtilArgs_SetShort(s, "width", "W")
        UtilArgs_SetShort(s, "shot", "o")
        // No default DXF — interactive starts empty (diamond looked like stale session data)
        UtilArgs_SetDefault(s, "height", "20")
        UtilArgs_SetDefault(s, "width", "800")
        UtilArgs_SetDefault(s, "imgh", "600")
        UtilArgs_SetDefault(s, "shot", "test-stl/cad_app.bmp")
        ReturnValue(s)
    }
}

SubRoutine.Main {
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    schema = CA_BuildSchema()
    args = UtilArgs_ParseCLI(schema)
    IfCondition EqualTo(args, 0) ThenBlock: {
        CA_Log("cad_app: bad args\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    CadApp.dxf_path = UtilArgs_GetString(args, "in")
    CadApp.hole_path = UtilArgs_GetString(args, "hole")
    CadApp.part_name = UtilArgs_GetString(args, "name")
    do_save = UtilArgs_GetBool(args, "save")
    do_load = UtilArgs_GetBool(args, "load")
    // copy CLI name into owned buffer
    IfCondition NotEqual(CadApp.part_name, 0) ThenBlock: {
        CA_SetPartName(CadApp.part_name)
    }
    IfCondition EqualTo(CadApp.part_name, 0) ThenBlock: {
        CA_EnsureName()
    }
    CadApp.height = UtilArgs_GetInt(args, "height")
    CadApp.width = UtilArgs_GetInt(args, "width")
    CadApp.height_px = UtilArgs_GetInt(args, "imgh")
    shot = UtilArgs_GetString(args, "shot")
    headless = UtilArgs_GetBool(args, "headless")
    nohost = UtilArgs_GetBool(args, "nohost")
    sketch_demo = UtilArgs_GetBool(args, "sketch-demo")
    IfCondition LessEqual(CadApp.height, 0) ThenBlock: { CadApp.height = 10 }
    IfCondition LessThan(CadApp.width, 16) ThenBlock: { CadApp.width = 800 }
    IfCondition LessThan(CadApp.height_px, 16) ThenBlock: { CadApp.height_px = 600 }
    SystemCall(83, "/tmp/cad_app", 493)

    // sketch-demo: programmed rect + pad (M-C gate without mouse)
    IfCondition EqualTo(sketch_demo, 1) ThenBlock: {
        CadApp.sketch = CAD_Sketch.CreateSketch(1)
        CAD_Sketch.AddRectangle(CadApp.sketch, Float_FromInt(-15), Float_FromInt(-10), Float_FromInt(30), Float_FromInt(20))
        IfCondition NotEqual(CA_PadFromSketch(), 0) ThenBlock: {
            CA_Log("cad_app: sketch-demo pad FAIL\n", 30)
            SystemCall(60, 1, 0, 0)
        }
        // also test click path programmatically
        CadApp.mode = 1
        CadApp.tool = 0
        CadApp.nclick = 0
        // second line via OnClick pixels near center
        CA_OnClick(400, 300)
        CA_OnClick(500, 350)
        CAD_DXF.ExportSketch(CadApp.sketch, "test-stl/cad_app_sketch.dxf")
        CAD_View.SetWire(0)
        CAD_View.SetViewMode(0)
        rc = CAD_View.RenderSolidToBMP(CadApp.solid, CadApp.width, CadApp.height_px, shot)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: sketch-demo render FAIL\n", 33)
            SystemCall(60, 1, 0, 0)
        }
        CAD_IO.ExportSTEP(CadApp.solid, "test-stl/cad_app.stp")
        // sketch view BMP
        CadApp.mode = 1
        CA_DrawSketchToFB()
        CAD_View.SaveFBToBMP("test-stl/cad_app_sketch.bmp")
        CA_Log("cad_app: sketch-demo OK\n", 24)
        SystemCall(60, 0, 0, 0)
    }

    // Postgres load (skip DXF file when --load --name)
    IfCondition EqualTo(do_load, 1) ThenBlock: {
        IfCondition NotEqual(CA_RepoLoad(), 0) ThenBlock: {
            CA_Log("cad_app: --load FAIL\n", 22)
            SystemCall(60, 1, 0, 0)
        }
        CadApp.mode = 0
        CAD_View.SetViewMode(0)
        IfCondition EqualTo(headless, 1) ThenBlock: {
            CAD_View.SetWire(0)
            rc = CAD_View.RenderSolidToBMP(CadApp.solid, CadApp.width, CadApp.height_px, shot)
            IfCondition NotEqual(rc, 0) ThenBlock: {
                CA_Log("cad_app: headless render FAIL\n", 30)
                SystemCall(60, 1, 0, 0)
            }
            CAD_IO.ExportSTEP(CadApp.solid, "test-stl/cad_app.stp")
            CA_Log("cad_app: headless load OK\n", 26)
            SystemCall(60, 0, 0, 0)
        }
    }

    // load DXF only when -i path given; otherwise empty sketch (no stale solid)
    IfCondition EqualTo(do_load, 0) ThenBlock: {
        IfCondition NotEqual(CadApp.dxf_path, 0) ThenBlock: {
            // nonempty path string?
            IfCondition NotEqual(GetByte(CadApp.dxf_path, 0), 0) ThenBlock: {
                IfCondition NotEqual(CA_LoadDxfToSketch(), 0) ThenBlock: {
                    CA_Log("cad_app: DXF load FAIL\n", 23)
                    SystemCall(60, 1, 0, 0)
                }
                CadApp.mode = 0
                CAD_View.SetViewMode(0)
            }
            IfCondition EqualTo(GetByte(CadApp.dxf_path, 0), 0) ThenBlock: {
                CA_ClearModel()
                CA_Log("cad_app: empty sketch (no -i DXF)\n", 33)
            }
        }
        IfCondition EqualTo(CadApp.dxf_path, 0) ThenBlock: {
            CA_ClearModel()
            CA_Log("cad_app: empty sketch (no -i DXF)\n", 33)
        }
    }

    IfCondition EqualTo(headless, 1) ThenBlock: {
        CAD_View.SetWire(0)
        CAD_View.SetViewMode(0)
        rc = CAD_View.RenderSolidToBMP(CadApp.solid, CadApp.width, CadApp.height_px, shot)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            CA_Log("cad_app: headless render FAIL\n", 30)
            SystemCall(60, 1, 0, 0)
        }
        CAD_IO.ExportSTEP(CadApp.solid, "test-stl/cad_app.stp")
        IfCondition EqualTo(do_save, 1) ThenBlock: {
            IfCondition NotEqual(CA_RepoSave(), 0) ThenBlock: {
                CA_Log("cad_app: --save FAIL\n", 22)
                SystemCall(60, 1, 0, 0)
            }
        }
        CA_Log("cad_app: headless OK\n", 21)
        SystemCall(60, 0, 0, 0)
    }

    CA_PublishFrame()
    // Spawn X11/XWayland host.
    // execve envp must not be empty (that strips DISPLAY). Pass DISPLAY + XAUTHORITY.
    IfCondition EqualTo(nohost, 0) ThenBlock: {
        pid = SystemCall(57)
        IfCondition EqualTo(pid, 0) ThenBlock: {
            argv = Allocate(32)
            StoreValue(argv, "./CAD/host/cad_host_x11")
            StoreValue(Add(argv, 8), "/tmp/cad_app")
            StoreValue(Add(argv, 16), 0)
            envp = Allocate(48)
            // DISPLAY=:0
            dstr = Allocate(32)
            ArraySet(dstr, 0, 0x3D59414C50534944)
            // bytes: build "DISPLAY=:0\0"
            SetByte(dstr, 0, 68)
            SetByte(dstr, 1, 73)
            SetByte(dstr, 2, 83)
            SetByte(dstr, 3, 80)
            SetByte(dstr, 4, 76)
            SetByte(dstr, 5, 65)
            SetByte(dstr, 6, 89)
            SetByte(dstr, 7, 61)
            SetByte(dstr, 8, 58)
            SetByte(dstr, 9, 48)
            SetByte(dstr, 10, 0)
            // XAUTHORITY=/home/bob/.Xauthority — use common path
            xstr = Allocate(64)
            // "XAUTHORITY=/home/bob/.Xauthority"
            xa = "XAUTHORITY=/home/bob/.Xauthority"
            // copy string literal if available — build manually short path
            // X A U T H O R I T Y = / h o m e / b o b / . X a u t h o r i t y
            k = 0
            // use a simple known path length 31
            SetByte(xstr, 0, 88)
            SetByte(xstr, 1, 65)
            SetByte(xstr, 2, 85)
            SetByte(xstr, 3, 84)
            SetByte(xstr, 4, 72)
            SetByte(xstr, 5, 79)
            SetByte(xstr, 6, 82)
            SetByte(xstr, 7, 73)
            SetByte(xstr, 8, 84)
            SetByte(xstr, 9, 89)
            SetByte(xstr, 10, 61)
            SetByte(xstr, 11, 47)
            SetByte(xstr, 12, 104)
            SetByte(xstr, 13, 111)
            SetByte(xstr, 14, 109)
            SetByte(xstr, 15, 101)
            SetByte(xstr, 16, 47)
            SetByte(xstr, 17, 98)
            SetByte(xstr, 18, 111)
            SetByte(xstr, 19, 98)
            SetByte(xstr, 20, 47)
            SetByte(xstr, 21, 46)
            SetByte(xstr, 22, 88)
            SetByte(xstr, 23, 97)
            SetByte(xstr, 24, 117)
            SetByte(xstr, 25, 116)
            SetByte(xstr, 26, 104)
            SetByte(xstr, 27, 111)
            SetByte(xstr, 28, 114)
            SetByte(xstr, 29, 105)
            SetByte(xstr, 30, 116)
            SetByte(xstr, 31, 121)
            SetByte(xstr, 32, 0)
            StoreValue(envp, dstr)
            StoreValue(Add(envp, 8), xstr)
            StoreValue(Add(envp, 16), 0)
            SystemCall(59, "./CAD/host/cad_host_x11", argv, envp)
            SystemCall(60, 1, 0, 0)
        }
        CA_Log("cad_app: host spawn attempted (X11/XWayland)\n", 45)
        CA_Log("  if no window: export DISPLAY=:0 && ./CAD/host/cad_host_x11 /tmp/cad_app &\n", 76)
        CA_Log("  then: ./cad_app.x --nohost -i your.dxf -H 10\n", 47)
    }

    CA_Log("cad_app: interactive M-D (LMB orbit, scroll zoom, nav cube)\n", 60)
    // timespec { tv_sec, tv_nsec } — must use StoreValue (byte offsets), not ArraySet
    ts = Allocate(16)
    StoreValue(ts, 0)
    StoreValue(Add(ts, 8), 20000000)
    guard = 0
    WhileLoop EqualTo(CadApp.running, 1) {
        c = CA_PollCmd()
        IfCondition EqualTo(c, 1) ThenBlock: {
            // quit: wipe model so next session cannot revive this solid
            CA_ClearModel()
            CA_PublishFrame()
            CadApp.running = 0
        }
        // re-arm each sleep (kernel may write remainder)
        StoreValue(ts, 0)
        StoreValue(Add(ts, 8), 20000000)
        SystemCall(35, ts, 0)
        guard = Add(guard, 1)
        IfCondition GreaterThan(guard, 45000) ThenBlock: { CadApp.running = 0 }
    }
    Deallocate(ts, 16)
    // shutdown wipe (launcher also clears /tmp/cad_app)
    CA_ClearModel()
    CA_Log("cad_app: quit (state cleared)\n", 30)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
