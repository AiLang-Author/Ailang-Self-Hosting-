// cad_load — CLI / pipe: DXF → solid → STEP
//
// File mode:
//   ./cad_load.x --in profile.dxf --out solid.stp [--height 10]
//   ./cad_load.x --in plate.dxf --hole keyhole.dxf --out esc.stp -H 4
//
// Full pipe (stdin DXF → stdout STEP):
//   cat profile.dxf | ./cad_load.x --height 10 > solid.stp
//   ./cad_load.x -H 10 < profile.dxf > solid.stp
//   cat profile.dxf | ./cad_load.x --in - --out - -H 10 | ...
//
//   -i / --in      input DXF path or "-" for stdin  (default: -)
//   -o / --out     output STEP path or "-" for stdout (default: -)
//   -H / --height  extrude / plate thickness mm (int, default 10)
//   -k / --hole    optional hole DXF path (through cut; not from stdin)
//
// Status messages always go to stderr so stdout stays pure STEP.
//
// Build:
//   ./ailang.x CAD/cad_load.ailang -o cad_load.x

LibraryImport.Arena
LibraryImport.UtilArgs
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.StringUtils

Function.CL_BuildSchema {
    Output: Address
    Body: {
        s = UtilArgs_NewSchema("cad_load", "DXF → extrude solid → STEP (files or stdin/stdout pipe)")
        UtilArgs_AddField(s, "in", "path", 0, "Input DXF path, or - for stdin", "in")
        UtilArgs_AddField(s, "out", "path", 0, "Output STEP path, or - for stdout", "out")
        UtilArgs_AddField(s, "height", "int", 0, "Extrude / plate thickness mm (integer)", "height")
        UtilArgs_AddField(s, "hole", "path", 0, "Optional hole DXF path (through cut in plate)", "hole")
        UtilArgs_SetShort(s, "in", "i")
        UtilArgs_SetShort(s, "out", "o")
        UtilArgs_SetShort(s, "height", "H")
        UtilArgs_SetShort(s, "hole", "k")
        UtilArgs_SetDefault(s, "in", "-")
        UtilArgs_SetDefault(s, "out", "-")
        UtilArgs_SetDefault(s, "height", "10")
        ReturnValue(s)
    }
}

// Log to stderr only (never pollute STEP on stdout).
Function.CL_Log {
    Input: msg: Address
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sys.Write(2, msg, n))
    }
}

SubRoutine.Main {
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    schema = CL_BuildSchema()
    args = UtilArgs_ParseCLI(schema)
    IfCondition EqualTo(args, 0) ThenBlock: {
        CL_Log("cad_load: bad args\n", 19)
        SystemCall(60, 1, 0, 0)
    }

    in_path = UtilArgs_GetString(args, "in")
    out_path = UtilArgs_GetString(args, "out")
    height_i = UtilArgs_GetInt(args, "height")
    hole_path = UtilArgs_GetString(args, "hole")

    IfCondition EqualTo(in_path, 0) ThenBlock: { in_path = "-" }
    IfCondition EqualTo(out_path, 0) ThenBlock: { out_path = "-" }

    IfCondition LessEqual(height_i, 0) ThenBlock: {
        CL_Log("cad_load: --height must be > 0\n", 32)
        SystemCall(60, 1, 0, 0)
    }

    in_dash = CAD_IO.IsDashPath(in_path)
    out_dash = CAD_IO.IsDashPath(out_path)

    // File inputs must be .dxf; "-" is stdin
    IfCondition EqualTo(in_dash, 0) ThenBlock: {
        IfCondition EqualTo(CAD_IO.IsDXFPath(in_path), 0) ThenBlock: {
            CL_Log("cad_load: --in must be .dxf or -\n", 33)
            SystemCall(60, 1, 0, 0)
        }
    }
    // --hole cannot be stdin (single stream); must be a .dxf file
    IfCondition NotEqual(hole_path, 0) ThenBlock: {
        IfCondition EqualTo(CAD_IO.IsDashPath(hole_path), 1) ThenBlock: {
            CL_Log("cad_load: --hole cannot be stdin\n", 33)
            SystemCall(60, 1, 0, 0)
        }
        IfCondition EqualTo(CAD_IO.IsDXFPath(hole_path), 0) ThenBlock: {
            CL_Log("cad_load: --hole must be a .dxf file\n", 38)
            SystemCall(60, 1, 0, 0)
        }
        // plate+hole needs a plate file, not stdin-only without plate path
        IfCondition EqualTo(in_dash, 1) ThenBlock: {
            CL_Log("cad_load: --hole needs --in plate.dxf (not stdin)\n", 51)
            SystemCall(60, 1, 0, 0)
        }
    }

    height_r = Float_FromInt(height_i)
    out_slot = Allocate(8)
    h = 0

    IfCondition NotEqual(hole_path, 0) ThenBlock: {
        CL_Log("cad_load: plate + through hole\n", 31)
        h = CAD_IO.LoadDXFPlateHole(in_path, hole_path, height_r, out_slot)
    }
    IfCondition EqualTo(hole_path, 0) ThenBlock: {
        IfCondition EqualTo(in_dash, 1) ThenBlock: {
            CL_Log("cad_load: extrude from stdin\n", 29)
            h = CAD_IO.LoadDXFExtrudeFd(0, height_r, out_slot)
        }
        IfCondition EqualTo(in_dash, 0) ThenBlock: {
            CL_Log("cad_load: extrude profile\n", 26)
            h = CAD_IO.LoadDXFExtrude(in_path, height_r, out_slot)
        }
    }
    Deallocate(out_slot, 8)

    IfCondition EqualTo(h, 0) ThenBlock: {
        CL_Log("cad_load: failed to build solid\n", 33)
        SystemCall(60, 1, 0, 0)
    }

    rc = 0
    IfCondition EqualTo(out_dash, 1) ThenBlock: {
        // pure STEP on stdout
        rc = CAD_IO.ExportSTEPFd(h, 1)
    }
    IfCondition EqualTo(out_dash, 0) ThenBlock: {
        rc = CAD_IO.ExportSTEP(h, out_path)
    }
    IfCondition NotEqual(rc, 0) ThenBlock: {
        CL_Log("cad_load: STEP export failed\n", 30)
        SystemCall(60, 1, 0, 0)
    }

    IfCondition EqualTo(out_dash, 1) ThenBlock: {
        CL_Log("cad_load: wrote STEP on stdout\n", 31)
    }
    IfCondition EqualTo(out_dash, 0) ThenBlock: {
        CL_Log("cad_load: wrote ", 16)
        olen = StringLength(out_path)
        CAD_Sys.Write(2, out_path, olen)
        CL_Log("\n", 1)
    }
    CL_Log("cad_load: OK\n", 13)
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
