// cad_view — DXF → solid → software viewport → BMP
//
// No AOS. Headless FB + BMP. Optional --show opens host eog/xdg-open.
//
//   ./cad_view.x --in profile.dxf --shot out.bmp -H 10
//   cat profile.dxf | ./cad_view.x --shot out.bmp -H 8
//   ./cad_view.x -i keyhole.dxf -o k.bmp -H 8 --view iso --wire 0
//   ./cad_view.x -i plate.dxf -k hole.dxf -o esc.bmp -H 4 --view top
//
// Flags:
//   -i/--in     DXF or - (stdin)          default -
//   -o/--shot   BMP path                  default test-stl/cad_view.bmp
//   -H/--height extrude mm                default 10
//   -k/--hole   plate through-hole DXF
//   -W/--width  image width               default 800
//   --imgh      image height              default 600
//   --view      0=iso 1=top 2=front       default 0
//   --wire      1=edges 0=shaded only     default 0 (cleaner daily view)
//   --defl      mesh defl in 0.01 mm      default 2 (=0.02)
//   --show      open host image viewer
//
// Build: ./ailang.x CAD/cad_view.ailang -o cad_view.x

LibraryImport.Arena
LibraryImport.UtilArgs
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View
LibraryImport.StringUtils

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

Function.CV_BuildSchema {
    Output: Address
    Body: {
        s = UtilArgs_NewSchema("cad_view", "DXF → solid → software FB → BMP (host OS, no AOS)")
        UtilArgs_AddField(s, "in", "path", 0, "Input DXF or - for stdin", "in")
        UtilArgs_AddField(s, "shot", "path", 0, "Output BMP path", "shot")
        UtilArgs_AddField(s, "height", "int", 0, "Extrude thickness mm", "height")
        UtilArgs_AddField(s, "hole", "path", 0, "Optional hole DXF", "hole")
        UtilArgs_AddField(s, "width", "int", 0, "Image width pixels", "width")
        UtilArgs_AddField(s, "imgh", "int", 0, "Image height pixels", "imgh")
        UtilArgs_AddField(s, "view", "int", 0, "0=iso 1=top 2=front", "view")
        UtilArgs_AddField(s, "wire", "int", 0, "1=tri edges 0=shaded only", "wire")
        UtilArgs_AddField(s, "defl", "int", 0, "Mesh deflection in 0.01 mm units", "defl")
        UtilArgs_AddField(s, "show", "bool", 0, "Open host image viewer", "show")
        UtilArgs_SetShort(s, "in", "i")
        UtilArgs_SetShort(s, "shot", "o")
        UtilArgs_SetShort(s, "height", "H")
        UtilArgs_SetShort(s, "hole", "k")
        UtilArgs_SetShort(s, "width", "W")
        UtilArgs_SetDefault(s, "in", "-")
        UtilArgs_SetDefault(s, "shot", "test-stl/cad_view.bmp")
        UtilArgs_SetDefault(s, "height", "10")
        UtilArgs_SetDefault(s, "width", "800")
        UtilArgs_SetDefault(s, "imgh", "600")
        UtilArgs_SetDefault(s, "view", "0")
        UtilArgs_SetDefault(s, "wire", "0")
        UtilArgs_SetDefault(s, "defl", "2")
        ReturnValue(s)
    }
}

Function.CV_Log {
    Input: msg: Address
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sys.Write(2, msg, n))
    }
}

SubRoutine.Main {
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    schema = CV_BuildSchema()
    args = UtilArgs_ParseCLI(schema)
    IfCondition EqualTo(args, 0) ThenBlock: {
        CV_Log("cad_view: bad args\n", 18)
        SystemCall(60, 1, 0, 0)
    }

    in_path = UtilArgs_GetString(args, "in")
    shot_path = UtilArgs_GetString(args, "shot")
    height_i = UtilArgs_GetInt(args, "height")
    hole_path = UtilArgs_GetString(args, "hole")
    width = UtilArgs_GetInt(args, "width")
    imgh = UtilArgs_GetInt(args, "imgh")
    view_m = UtilArgs_GetInt(args, "view")
    wire_i = UtilArgs_GetInt(args, "wire")
    defl_i = UtilArgs_GetInt(args, "defl")
    do_show = UtilArgs_GetBool(args, "show")

    IfCondition EqualTo(in_path, 0) ThenBlock: { in_path = "-" }
    IfCondition EqualTo(shot_path, 0) ThenBlock: { shot_path = "test-stl/cad_view.bmp" }
    IfCondition LessEqual(height_i, 0) ThenBlock: {
        CV_Log("cad_view: --height must be > 0\n", 31)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition LessThan(width, 16) ThenBlock: { width = 800 }
    IfCondition LessThan(imgh, 16) ThenBlock: { imgh = 600 }

    // view options
    CAD_View.SetViewMode(view_m)
    CAD_View.SetWire(wire_i)
    // defl_i in 0.01 mm → float mm
    IfCondition GreaterThan(defl_i, 0) ThenBlock: {
        defl_r = Float_Div(Float_FromInt(defl_i), Float_FromInt(100))
        CAD_View.SetDefl(defl_r)
    }

    height_r = Float_FromInt(height_i)
    out_slot = Allocate(8)
    h = 0
    in_dash = CAD_IO.IsDashPath(in_path)

    IfCondition NotEqual(hole_path, 0) ThenBlock: {
        IfCondition EqualTo(in_dash, 1) ThenBlock: {
            CV_Log("cad_view: --hole needs plate --in file\n", 39)
            SystemCall(60, 1, 0, 0)
        }
        CV_Log("cad_view: plate+hole solid\n", 27)
        h = CAD_IO.LoadDXFPlateHole(in_path, hole_path, height_r, out_slot)
    }
    IfCondition EqualTo(hole_path, 0) ThenBlock: {
        IfCondition EqualTo(in_dash, 1) ThenBlock: {
            CV_Log("cad_view: solid from stdin\n", 27)
            h = CAD_IO.LoadDXFExtrudeFd(0, height_r, out_slot)
        }
        IfCondition EqualTo(in_dash, 0) ThenBlock: {
            IfCondition EqualTo(CAD_IO.IsDXFPath(in_path), 0) ThenBlock: {
                CV_Log("cad_view: --in must be .dxf or -\n", 33)
                SystemCall(60, 1, 0, 0)
            }
            CV_Log("cad_view: solid from file\n", 26)
            h = CAD_IO.LoadDXFExtrude(in_path, height_r, out_slot)
        }
    }
    Deallocate(out_slot, 8)

    IfCondition EqualTo(h, 0) ThenBlock: {
        CV_Log("cad_view: failed to build solid\n", 33)
        SystemCall(60, 1, 0, 0)
    }

    CV_Log("cad_view: rasterize...\n", 23)
    rc = CAD_View.RenderSolidToBMP(h, width, imgh, shot_path)
    IfCondition NotEqual(rc, 0) ThenBlock: {
        CV_Log("cad_view: render failed\n", 25)
        SystemCall(60, 1, 0, 0)
    }

    CV_Log("cad_view: wrote ", 16)
    olen = StringLength(shot_path)
    CAD_Sys.Write(2, shot_path, olen)
    CV_Log("\n", 1)

    IfCondition EqualTo(do_show, 1) ThenBlock: {
        CV_Log("cad_view: opening host viewer\n", 30)
        CAD_View.OpenHostViewer(shot_path)
    }

    CV_Log("cad_view: OK\n", 13)
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
