LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch

SubRoutine.Main {
    CAD_Sys.Write(1, "=== anchors ends+cross+T ===\n", 30)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)
    sk = CAD_Sketch.CreateSketch(1)
    // two lines that cross
    CAD_Sketch.AddLine(sk, 0, 0, 0x4024000000000000, 0x4024000000000000)
    CAD_Sketch.AddLine(sk, 0, 0x4024000000000000, 0x4024000000000000, 0)
    n = CAD_Sketch.RebuildAnchors(sk)
    // expect: 4 ends + 1 cross = 5 (or fewer if merge)
    IfCondition LessThan(n, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL too few anchors\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS cross anchors\n", 19)
    // T-junction: horizontal base + vertical stub ending on it
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk2, 0, 0, 0x4024000000000000, 0)
    CAD_Sketch.AddLine(sk2, 0x4014000000000000, 0, 0x4014000000000000, 0x4024000000000000)
    n2 = CAD_Sketch.RebuildAnchors(sk2)
    IfCondition LessThan(n2, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL T anchors\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS T anchors\n", 15)
    CAD_Sketch.SplitAtIntersections(sk2)
    CAD_Sketch.PruneOpenStubs(sk2, 0)
    nprof = CAD_Sketch.BuildAllClosedLoops(sk2)
    // T alone is not a closed face — just ensure no crash
    CAD_Sys.Write(1, "ANCHORS OK\n", 11)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
