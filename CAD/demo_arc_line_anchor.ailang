// Line crossing an arc must create an anchor at the intersection.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== arc-line crossing anchors ===\n", 34)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    sk = CAD_Sketch.CreateSketch(1)
    // arc: center (0,0) R=10, CCW from 0 to pi (upper semicircle)
    CAD_Sketch.AddArc(sk, 0, 0, 0x4024000000000000, 0, 0x400921FB54442D18)
    // vertical line x=0 from y=-5 to y=15 — crosses at (0,10) and possibly (0,-10) not on arc
    CAD_Sketch.AddLine(sk, 0, 0xC014000000000000, 0, 0x402E000000000000)

    n = CAD_Sketch.RebuildAnchors(sk)
    // ends: arc 2 + line 2 + at least 1 cross (0,10) → >= 5 ideally, but merge may reduce
    // must have a point near (0, 10)
    pts = CAD_Store.Read(sk, 17)
    found = 0
    i = 0
    WhileLoop LessThan(i, n) {
        px = ArrayGet(pts, Multiply(i, 2))
        py = ArrayGet(pts, Add(Multiply(i, 2), 1))
        // near (0, 10)
        dx = px
        dy = Float_Sub(py, 0x4024000000000000)
        d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        IfCondition EqualTo(Float_Le(d2, 0x3F50624DD2F1A9FC), 1) ThenBlock: {
            found = 1
        }
        i = Add(i, 1)
    }
    IfCondition EqualTo(found, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no anchor at arc-line cross\n", 33)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS arc-line cross anchor\n", 27)

    // horizontal chord through circle
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(sk2, 0, 0, 0x4024000000000000)
    CAD_Sketch.AddLine(sk2, 0xC024000000000000, 0, 0x4024000000000000, 0)
    n2 = CAD_Sketch.RebuildAnchors(sk2)
    pts2 = CAD_Store.Read(sk2, 17)
    found = 0
    found2 = 0
    i = 0
    WhileLoop LessThan(i, n2) {
        px = ArrayGet(pts2, Multiply(i, 2))
        py = ArrayGet(pts2, Add(Multiply(i, 2), 1))
        // (-10,0) and (10,0)
        dx = Float_Sub(px, 0xC024000000000000)
        dy = py
        IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), 0x3F50624DD2F1A9FC), 1) ThenBlock: {
            found = 1
        }
        dx = Float_Sub(px, 0x4024000000000000)
        IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), 0x3F50624DD2F1A9FC), 1) ThenBlock: {
            found2 = 1
        }
        i = Add(i, 1)
    }
    IfCondition EqualTo(found, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circle-line left hit\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(found2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circle-line right hit\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS circle-line anchors\n", 25)
    CAD_Sys.Write(1, "ARC LINE ANCHOR OK\n", 19)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
