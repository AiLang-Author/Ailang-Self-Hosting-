// Closed region using an arc as part of the boundary must project a profile.
// Case A: semicircle + diameter chord
// Case B: rectangle with line cutting a full circle (multiple faces)

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== arc boundary profile ===\n", 30)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    // A: semicircle + diameter
    sk = CAD_Sketch.CreateSketch(1)
    // center (5,5) R=5, a0=0 a1=pi upper semicircle
    CAD_Sketch.AddArc(sk, 0x4014000000000000, 0x4014000000000000, 0x4014000000000000, 0, 0x400921FB54442D18)
    // diameter (0,5)-(10,5)
    CAD_Sketch.AddLine(sk, 0, 0x4014000000000000, 0x4024000000000000, 0x4014000000000000)

    // project like CA_RebuildProfiles clone path
    CAD_Sketch.RebuildAnchors(sk)
    CAD_Sketch.TessellateArcs(sk, 16)
    CAD_Sketch.RebuildAnchors(sk)
    CAD_Sketch.SplitAtIntersections(sk)
    CAD_Sketch.PruneOpenStubs(sk, 0)
    n = CAD_Sketch.BuildAllClosedLoops(sk)
    IfCondition LessThan(n, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL semicircle+diameter no profile\n", 36)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS semicircle+diameter profile\n", 32)

    // B: full circle + two diameters (should get several closed faces)
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(sk2, 0, 0, 0x4024000000000000)
    CAD_Sketch.AddLine(sk2, 0xC024000000000000, 0, 0x4024000000000000, 0)
    CAD_Sketch.AddLine(sk2, 0, 0xC024000000000000, 0, 0x4024000000000000)
    // same order as CA_RebuildProfiles (was missing TessellateCircles before)
    CAD_Sketch.TessellateCircles(sk2, 48)
    CAD_Store.Write(sk2, 7, 0)
    CAD_Sketch.RebuildAnchors(sk2)
    CAD_Sketch.SplitAtIntersections(sk2)
    CAD_Sketch.PruneOpenStubs(sk2, 0)
    n2 = CAD_Sketch.BuildAllClosedLoops(sk2)
    IfCondition LessThan(n2, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circle+diameters no profile\n", 34)
        SystemCall(60, 1, 0, 0)
    }
    // expect multiple faces (circle quarters / wedges)
    IfCondition LessThan(n2, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected multi face for circle+X\n", 38)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS circle+diameters multi profiles\n", 37)

    // C: open polyline that looks closed with arc filling a gap
    // square missing bottom: (0,0)-(10,0)-(10,10)-(0,10) and arc bottom outside
    sk3 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk3, 0, 0, 0x4024000000000000, 0)
    CAD_Sketch.AddLine(sk3, 0x4024000000000000, 0, 0x4024000000000000, 0x4024000000000000)
    CAD_Sketch.AddLine(sk3, 0x4024000000000000, 0x4024000000000000, 0, 0x4024000000000000)
    CAD_Sketch.AddLine(sk3, 0, 0x4024000000000000, 0, 0)
    // already closed square - should work
    n3 = CAD_Sketch.BuildAllClosedLoops(sk3)
    IfCondition LessThan(n3, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL square\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS square\n", 12)

    CAD_Sys.Write(1, "ARC PROFILE OK\n", 15)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
