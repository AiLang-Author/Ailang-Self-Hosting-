// Closed region using an arc as part of the boundary must project a profile.
// Case A: semicircle + diameter chord
// Case B: rectangle with line cutting a full circle (multiple faces)
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== arc boundary profile ===\n", 30)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    // A: semicircle + diameter
    sk = CAD_Sketch.CreateSketch(1)
    // center (5,5) R=5, a0=0 a1=pi upper semicircle
    CAD_Sketch.AddArc(sk, 0x4014000000000000, 0x4014000000000000, 0x4014000000000000, 0, 0x400921FB54442D18)
    // diameter (0,5)-(10,5)
    CAD_Sketch.AddLine(sk, 0, 0x4014000000000000, 0x4024000000000000, 0x4014000000000000)

    // project like CA_RebuildProfiles clone path
    CAD_Sketch.RebuildAnchors(sk)
    CAD_Sketch.TessellateArcs(sk, 16)
    CAD_Sketch.RebuildAnchors(sk)
    CAD_Sketch.SplitAtIntersections(sk)
    CAD_Sketch.PruneOpenStubs(sk, 0)
    n = CAD_Sketch.BuildAllClosedLoops(sk)
    IfCondition LessThan(n, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL semicircle+diameter no profile\n", 36)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS semicircle+diameter profile\n", 32)

    // B: full circle + two diameters (should get several closed faces)
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(sk2, 0, 0, 0x4024000000000000)
    CAD_Sketch.AddLine(sk2, 0xC024000000000000, 0, 0x4024000000000000, 0)
    CAD_Sketch.AddLine(sk2, 0, 0xC024000000000000, 0, 0x4024000000000000)
    // same order as CA_RebuildProfiles (was missing TessellateCircles before)
    CAD_Sketch.TessellateCircles(sk2, 48)
    CAD_Store.Write(sk2, 7, 0)
    CAD_Sketch.RebuildAnchors(sk2)
    CAD_Sketch.SplitAtIntersections(sk2)
    CAD_Sketch.PruneOpenStubs(sk2, 0)
    n2 = CAD_Sketch.BuildAllClosedLoops(sk2)
    IfCondition LessThan(n2, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circle+diameters no profile\n", 34)
        SystemCall(60, 1, 0, 0)
    }
    // expect multiple faces (circle quarters / wedges)
    IfCondition LessThan(n2, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected multi face for circle+X\n", 38)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS circle+diameters multi profiles\n", 37)

    // C: open polyline that looks closed with arc filling a gap
    // square missing bottom: (0,0)-(10,0)-(10,10)-(0,10) and arc bottom outside
    sk3 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk3, 0, 0, 0x4024000000000000, 0)
    CAD_Sketch.AddLine(sk3, 0x4024000000000000, 0, 0x4024000000000000, 0x4024000000000000)
    CAD_Sketch.AddLine(sk3, 0x4024000000000000, 0x4024000000000000, 0, 0x4024000000000000)
    CAD_Sketch.AddLine(sk3, 0, 0x4024000000000000, 0, 0)
    // already closed square - should work
    n3 = CAD_Sketch.BuildAllClosedLoops(sk3)
    IfCondition LessThan(n3, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL square\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS square\n", 12)

    // D: ice-cream cone — V + Arc3 scoop (profile must include arc, not chord under it)
    sk4 = CAD_Sketch.CreateSketch(1)
    // left (-10,20)-(0,0) right (10,20)-(0,0)
    CAD_Sketch.AddLine(sk4, 0xC024000000000000, 0x4034000000000000, 0, 0)
    CAD_Sketch.AddLine(sk4, 0x4024000000000000, 0x4034000000000000, 0, 0)
    // arc through top: (-10,20) (0,28) (10,20) — Pend+Point (no 7-arg call)
    CAD_Sketch.Arc3Pend(0xC024000000000000, 0x4034000000000000, 0, 0x403C000000000000, 0x4024000000000000, 0x4034000000000000)
    CAD_Sketch.Arc3Point(sk4)
    CAD_Sketch.SnapArcEndsToSketch(sk4, 0)
    cl = CAD_Sketch.CreateSketch(1)
    // copy geom
    nl = CAD_Sketch.GetLineCount(sk4)
    lines = CAD_Store.Read(sk4, 1)
    i = 0
    WhileLoop LessThan(i, nl) {
        b = Multiply(i, 4)
        CAD_Sketch.AddLine(cl, ArrayGet(lines, b), ArrayGet(lines, Add(b, 1)), ArrayGet(lines, Add(b, 2)), ArrayGet(lines, Add(b, 3)))
        i = Add(i, 1)
    }
    na = CAD_Sketch.GetArcCount(sk4)
    arcs = CAD_Store.Read(sk4, 11)
    i = 0
    WhileLoop LessThan(i, na) {
        b = Multiply(i, 5)
        CAD_Sketch.AddArc(cl, ArrayGet(arcs, b), ArrayGet(arcs, Add(b, 1)), ArrayGet(arcs, Add(b, 2)), ArrayGet(arcs, Add(b, 3)), ArrayGet(arcs, Add(b, 4)))
        i = Add(i, 1)
    }
    CAD_Sketch.SnapArcEndsToSketch(cl, 0)
    CAD_Sketch.TessellateArcs(cl, 96)
    CAD_Sketch.SnapNearEndpoints(cl, 0)
    n4 = CAD_Sketch.BuildAllClosedLoops(cl)
    IfCondition LessThan(n4, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL V+Arc3 scoop no profile\n", 30)
        SystemCall(60, 1, 0, 0)
    }
    // area should be clearly larger than V with flat chord only
    // flat triangle area = 0.5*20*20 = 200; scoop adds positive area
    xy = Allocate(65536)
    nn = CAD_Sketch.GetProfileXY(cl, 0, xy)
    ar = CAD_Sketch.LoopSignedArea(xy, nn)
    IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
    Deallocate(xy, 65536)
    // require area > 220 (chord triangle is 200)
    IfCondition EqualTo(Float_Le(ar, Float_FromInt(220)), 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL scoop profile too small (chord?)\n", 38)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS V+Arc3 scoop profile\n", 26)

    // E: 3-LINE + inward south arc — parked fillet sketch. ProfCompile
    // must emit one face; origin sits in the interior.
    sk5 = CAD_Sketch.CreateSketch(1)
    n25 = 0x4039000000000000
    m25 = Float_Sub(0, n25)
    n55 = Float_FromInt(55)
    cy = Float_Sub(0, Float_FromInt(80))
    rr = CAD_Num.Hypot2(n25, n55)
    aa0 = CAD_Geom.Atan2(n55, m25)
    aa1 = CAD_Geom.Atan2(n55, n25)
    CAD_Sketch.AddArc(sk5, 0, cy, rr, aa1, aa0)
    CAD_Sketch.AddLine(sk5, n25, m25, n25, n25)
    CAD_Sketch.AddLine(sk5, n25, n25, m25, n25)
    CAD_Sketch.AddLine(sk5, m25, n25, m25, m25)
    CAD_Sketch.RebuildAnchors(sk5)
    n5 = CAD_Sketch.ProfCompile(sk5)
    IfCondition LessThan(n5, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL 3LINE+arc no profile\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    xy5 = Allocate(65536)
    nn5 = CAD_Sketch.GetProfileXY(sk5, 0, xy5)
    IfCondition LessThan(nn5, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL 3LINE+arc empty ring\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    // Origin is interior. Same world even-odd the pick tool uses
    // (CA_HitProfilePx / CA_PointInPoly). Pixel even-odd missed this ring.
    inside = 0
    ii = 0
    jj = Subtract(nn5, 1)
    WhileLoop LessThan(ii, nn5) {
        xi = ArrayGet(xy5, Multiply(ii, 2))
        yi = ArrayGet(xy5, Add(Multiply(ii, 2), 1))
        xj = ArrayGet(xy5, Multiply(jj, 2))
        yj = ArrayGet(xy5, Add(Multiply(jj, 2), 1))
        a = 0
        b = 0
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(0, yi)), 1) ThenBlock: { a = 1 }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(0, yj)), 1) ThenBlock: { b = 1 }
        IfCondition NotEqual(a, b) ThenBlock: {
            den = Float_Sub(yj, yi)
            IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                xint = Float_Add(xi, Float_Mul(Float_Sub(xj, xi), Float_Div(Float_Sub(0, yi), den)))
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(0, xint)), 1) ThenBlock: {
                    inside = Subtract(1, inside)
                }
            }
        }
        jj = ii
        ii = Add(ii, 1)
    }
    IfCondition NotEqual(inside, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL 3LINE+arc origin not interior\n", 35)
        SystemCall(60, 1, 0, 0)
    }
    Deallocate(xy5, 65536)
    CAD_Sys.Write(1, "PASS 3LINE+arc nprof=", 21)
    PrintNumber(n5)
    CAD_Sys.Write(1, " nn=", 4)
    PrintNumber(nn5)
    CAD_Sys.Write(1, " nseg=", 6)
    PrintNumber(CAD_Sketch.SketchPlexPathCount(0))
    CAD_Sys.Write(1, "\n", 1)
    IfCondition NotEqual(nn5, 19) ThenBlock: {
        CAD_Sys.Write(1, "FAIL 3LINE+arc nn\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Sketch.SketchPlexPathCount(0), 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL 3LINE+arc nseg\n", 20)
        SystemCall(60, 1, 0, 0)
    }

    // F: same keyhole, each line split in half and the arc split in half.
    // Collapse must sew it back to 3 lines + 1 arc (nn=19) before the fill.
    sk6 = CAD_Sketch.CreateSketch(1)
    amid = Float_Add(aa1, Float_Mul(Float_Sub(aa0, aa1), 0x3FE0000000000000))
    CAD_Sketch.AddLine(sk6, n25, m25, n25, 0)
    CAD_Sketch.AddLine(sk6, n25, 0, n25, n25)
    CAD_Sketch.AddLine(sk6, n25, n25, 0, n25)
    CAD_Sketch.AddLine(sk6, 0, n25, m25, n25)
    CAD_Sketch.AddLine(sk6, m25, n25, m25, 0)
    CAD_Sketch.AddLine(sk6, m25, 0, m25, m25)
    CAD_Sketch.AddArc(sk6, 0, cy, rr, aa1, amid)
    CAD_Sketch.AddArc(sk6, 0, cy, rr, amid, aa0)
    CAD_Sketch.RebuildAnchors(sk6)
    n6 = CAD_Sketch.ProfCompile(sk6)
    xy6 = Allocate(65536)
    nn6 = CAD_Sketch.GetProfileXY(sk6, 0, xy6)
    Deallocate(xy6, 65536)
    np6 = CAD_Sketch.SketchPlexPathCount(0)
    CAD_Sys.Write(1, "PASS split-keyhole nprof=", 25)
    PrintNumber(n6)
    CAD_Sys.Write(1, " nn=", 4)
    PrintNumber(nn6)
    CAD_Sys.Write(1, " nseg=", 6)
    PrintNumber(np6)
    CAD_Sys.Write(1, "\n", 1)
    IfCondition NotEqual(n6, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL split profile\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(nn6, 19) ThenBlock: {
        CAD_Sys.Write(1, "FAIL split profile\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(np6, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL split profile\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    ka = 0
    kl = 0
    k6 = 0
    WhileLoop LessThan(k6, np6) {
        kd6 = CAD_Sketch.SketchPlexPathSeg(0, k6)
        IfCondition EqualTo(kd6, 2) ThenBlock: {
            ka = Add(ka, 1)
            tsp = CAD_Num.Abs(Float_Sub(CAD_SPlex.a1, CAD_SPlex.a0))
            full = CAD_Num.Abs(Float_Sub(aa0, aa1))
            derr = CAD_Num.Abs(Float_Sub(tsp, full))
            IfCondition EqualTo(Float_Le(derr, 0x3FA47AE147AE147B), 0) ThenBlock: {
                CAD_Sys.Write(1, "FAIL split arc span\n", 20)
                SystemCall(60, 1, 0, 0)
            }
        }
        IfCondition EqualTo(kd6, 0) ThenBlock: { kl = Add(kl, 1) }
        k6 = Add(k6, 1)
    }
    IfCondition NotEqual(ka, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL split arc count\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(kl, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL split line count\n", 22)
        SystemCall(60, 1, 0, 0)
    }

    CAD_Sys.Write(1, "ARC PROFILE OK\n", 15)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
