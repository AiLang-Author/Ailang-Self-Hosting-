// Arch (rect + upper semicircle notch) → pad → mesh probes.
// Fan fills notch; earclip must leave notch empty on top cap.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Tess

SubRoutine.Main {
    CAD_Sys.Write(1, "=== arch notch tess ===\n", 24)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    sk = CAD_Sketch.CreateSketch(1)
    // feet + walls + top
    CAD_Sketch.AddLine(sk, 0xC034000000000000, 0, 0xC024000000000000, 0)
    CAD_Sketch.AddLine(sk, 0xC034000000000000, 0, 0xC034000000000000, 0x4034000000000000)
    CAD_Sketch.AddLine(sk, 0xC034000000000000, 0x4034000000000000, 0x4034000000000000, 0x4034000000000000)
    CAD_Sketch.AddLine(sk, 0x4034000000000000, 0x4034000000000000, 0x4034000000000000, 0)
    CAD_Sketch.AddLine(sk, 0x4034000000000000, 0, 0x4024000000000000, 0)
    // arc (10,0)-(0,10)-(-10,0)
    CAD_Sketch.Arc3Pend(0x4024000000000000, 0, 0, 0x4024000000000000, 0xC024000000000000, 0)
    CAD_Sketch.Arc3Point(sk)

    clone = CAD_Sketch.CreateSketch(1)
    nl = CAD_Sketch.GetLineCount(sk)
    lines = CAD_Store.Read(sk, 1)
    i = 0
    WhileLoop LessThan(i, nl) {
        b = Multiply(i, 4)
        CAD_Sketch.AddLine(clone, ArrayGet(lines, b), ArrayGet(lines, Add(b, 1)), ArrayGet(lines, Add(b, 2)), ArrayGet(lines, Add(b, 3)))
        i = Add(i, 1)
    }
    na = CAD_Sketch.GetArcCount(sk)
    arcs = CAD_Store.Read(sk, 11)
    i = 0
    WhileLoop LessThan(i, na) {
        b = Multiply(i, 5)
        CAD_Sketch.AddArc(clone, ArrayGet(arcs, b), ArrayGet(arcs, Add(b, 1)), ArrayGet(arcs, Add(b, 2)), ArrayGet(arcs, Add(b, 3)), ArrayGet(arcs, Add(b, 4)))
        i = Add(i, 1)
    }
    CAD_Sketch.SnapArcEndsToSketch(clone, 0x3FA999999999999A)
    CAD_Sketch.TessellateArcs(clone, 96)
    CAD_Sketch.SnapNearEndpoints(clone, 0x3FA999999999999A)
    n = CAD_Sketch.BuildAllClosedLoops(clone)
    PrintMessage("nprof=")
    PrintNumber(n)
    PrintMessage("\n")

    xy = Allocate(65536)
    nn = 0
    ar = 0
    h = 0
    nt = 0
    hits = -1
    hits2 = -1
    IfCondition GreaterThan(n, 0) ThenBlock: {
        nn = CAD_Sketch.GetProfileXY(clone, 0, xy)
        ar = CAD_Sketch.LoopSignedArea(xy, nn)
        IfCondition EqualTo(CAD_Num.IsNeg(ar), 1) ThenBlock: { ar = Float_Sub(0, ar) }
        PrintMessage("nn=")
        PrintNumber(nn)
        PrintMessage(" area=")
        PrintNumber(Float_ToInt(ar))
        PrintMessage("\n")
        hsk = CAD_Sketch.CreateSketch(1)
        CAD_Sketch.AddProfileXY(hsk, xy, nn)
        h = CAD_Feat.ExtrudeProfile(hsk, 0x4034000000000000)
        PrintMessage("solid=")
        PrintNumber(h)
        PrintMessage("\n")
    }
    IfCondition NotEqual(h, 0) ThenBlock: {
        mesh = Allocate(32)
        nt = CAD_Tess.MeshSolid(h, 0x3FB999999999999A, mesh)
        PrintMessage("mesh nt=")
        PrintNumber(nt)
        PrintMessage(" nv=")
        PrintNumber(ArrayGet(mesh, 0))
        PrintMessage("\n")
        v_base = ArrayGet(mesh, 2)
        i_base = ArrayGet(mesh, 3)
        ztop = 0x4034000000000000
        ztol = 0x3F847AE147AE147B
        // notch void (0,5)
        hits = 0
        t = 0
        WhileLoop LessThan(t, nt) {
            i0 = ArrayGet(i_base, Multiply(t, 3))
            i1 = ArrayGet(i_base, Add(Multiply(t, 3), 1))
            i2 = ArrayGet(i_base, Add(Multiply(t, 3), 2))
            z0 = ArrayGet(v_base, Add(Multiply(i0, 3), 2))
            z1 = ArrayGet(v_base, Add(Multiply(i1, 3), 2))
            z2 = ArrayGet(v_base, Add(Multiply(i2, 3), 2))
            d0 = Float_Sub(z0, ztop)
            IfCondition EqualTo(CAD_Num.IsNeg(d0), 1) ThenBlock: { d0 = Float_Sub(0, d0) }
            d1 = Float_Sub(z1, ztop)
            IfCondition EqualTo(CAD_Num.IsNeg(d1), 1) ThenBlock: { d1 = Float_Sub(0, d1) }
            d2 = Float_Sub(z2, ztop)
            IfCondition EqualTo(CAD_Num.IsNeg(d2), 1) ThenBlock: { d2 = Float_Sub(0, d2) }
            IfCondition EqualTo(Float_Le(d0, ztol), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(d1, ztol), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(d2, ztol), 1) ThenBlock: {
                        pa = Allocate(32)
                        pb = Allocate(32)
                        pc = Allocate(32)
                        pd = Allocate(32)
                        ArraySet(pa, 0, ArrayGet(v_base, Multiply(i0, 3)))
                        ArraySet(pa, 1, ArrayGet(v_base, Add(Multiply(i0, 3), 1)))
                        ArraySet(pb, 0, ArrayGet(v_base, Multiply(i1, 3)))
                        ArraySet(pb, 1, ArrayGet(v_base, Add(Multiply(i1, 3), 1)))
                        ArraySet(pc, 0, ArrayGet(v_base, Multiply(i2, 3)))
                        ArraySet(pc, 1, ArrayGet(v_base, Add(Multiply(i2, 3), 1)))
                        ArraySet(pd, 0, 0)
                        ArraySet(pd, 1, 0x4014000000000000)
                        o1 = CAD_Num.Orient2D(pa, pb, pd)
                        o2 = CAD_Num.Orient2D(pb, pc, pd)
                        o3 = CAD_Num.Orient2D(pc, pa, pd)
                        ok = 0
                        IfCondition EqualTo(o1, o2) ThenBlock: {
                            IfCondition EqualTo(o2, o3) ThenBlock: {
                                IfCondition NotEqual(o1, 0) ThenBlock: { ok = 1 }
                            }
                        }
                        IfCondition EqualTo(ok, 1) ThenBlock: { hits = Add(hits, 1) }
                        Deallocate(pa, 32)
                        Deallocate(pb, 32)
                        Deallocate(pc, 32)
                        Deallocate(pd, 32)
                    }
                }
            }
            t = Add(t, 1)
        }
        // solid body (0,15)
        hits2 = 0
        t = 0
        WhileLoop LessThan(t, nt) {
            i0 = ArrayGet(i_base, Multiply(t, 3))
            i1 = ArrayGet(i_base, Add(Multiply(t, 3), 1))
            i2 = ArrayGet(i_base, Add(Multiply(t, 3), 2))
            z0 = ArrayGet(v_base, Add(Multiply(i0, 3), 2))
            z1 = ArrayGet(v_base, Add(Multiply(i1, 3), 2))
            z2 = ArrayGet(v_base, Add(Multiply(i2, 3), 2))
            d0 = Float_Sub(z0, ztop)
            IfCondition EqualTo(CAD_Num.IsNeg(d0), 1) ThenBlock: { d0 = Float_Sub(0, d0) }
            d1 = Float_Sub(z1, ztop)
            IfCondition EqualTo(CAD_Num.IsNeg(d1), 1) ThenBlock: { d1 = Float_Sub(0, d1) }
            d2 = Float_Sub(z2, ztop)
            IfCondition EqualTo(CAD_Num.IsNeg(d2), 1) ThenBlock: { d2 = Float_Sub(0, d2) }
            IfCondition EqualTo(Float_Le(d0, ztol), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(d1, ztol), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(d2, ztol), 1) ThenBlock: {
                        pa = Allocate(32)
                        pb = Allocate(32)
                        pc = Allocate(32)
                        pd = Allocate(32)
                        ArraySet(pa, 0, ArrayGet(v_base, Multiply(i0, 3)))
                        ArraySet(pa, 1, ArrayGet(v_base, Add(Multiply(i0, 3), 1)))
                        ArraySet(pb, 0, ArrayGet(v_base, Multiply(i1, 3)))
                        ArraySet(pb, 1, ArrayGet(v_base, Add(Multiply(i1, 3), 1)))
                        ArraySet(pc, 0, ArrayGet(v_base, Multiply(i2, 3)))
                        ArraySet(pc, 1, ArrayGet(v_base, Add(Multiply(i2, 3), 1)))
                        ArraySet(pd, 0, 0)
                        ArraySet(pd, 1, 0x402E000000000000)
                        o1 = CAD_Num.Orient2D(pa, pb, pd)
                        o2 = CAD_Num.Orient2D(pb, pc, pd)
                        o3 = CAD_Num.Orient2D(pc, pa, pd)
                        ok = 0
                        IfCondition EqualTo(o1, o2) ThenBlock: {
                            IfCondition EqualTo(o2, o3) ThenBlock: {
                                IfCondition NotEqual(o1, 0) ThenBlock: { ok = 1 }
                            }
                        }
                        IfCondition EqualTo(ok, 1) ThenBlock: { hits2 = Add(hits2, 1) }
                        Deallocate(pa, 32)
                        Deallocate(pb, 32)
                        Deallocate(pc, 32)
                        Deallocate(pd, 32)
                    }
                }
            }
            t = Add(t, 1)
        }
        PrintMessage("notch_probe hits=")
        PrintNumber(hits)
        PrintMessage(" solid_probe hits=")
        PrintNumber(hits2)
        PrintMessage("\n")
        pass = 0
        IfCondition EqualTo(hits, 0) ThenBlock: {
            IfCondition GreaterThan(hits2, 0) ThenBlock: {
                IfCondition GreaterThan(nt, 10) ThenBlock: { pass = 1 }
            }
        }
        IfCondition EqualTo(pass, 1) ThenBlock: {
            CAD_Sys.Write(1, "ARCH NOTCH TESS PASS\n", 22)
        }
        IfCondition EqualTo(pass, 0) ThenBlock: {
            CAD_Sys.Write(1, "ARCH NOTCH TESS FAIL\n", 22)
        }
        Deallocate(mesh, 32)
    }
    Deallocate(xy, 65536)
    CAD_Sys.Write(1, "DONE\n", 5)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
