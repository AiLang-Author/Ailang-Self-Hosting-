// Blind pocket: single CreateHole with depth < plate dz → floor disk shell → STEP walk.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== blind pocket B-Rep STEP ===\n", 32)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    // plate 40 x 40 x 10
    dx = 0x4044000000000000
    dy = 0x4044000000000000
    dz = 0x4024000000000000
    body = CAD_Script.CreateBox(dx, dy, dz)
    pack = Allocate(48)
    tool_out = Allocate(16)
    // blind dia 8 depth 6 at (12, 28) — floor at z=4
    ArraySet(pack, 0, 0x4020000000000000)
    ArraySet(pack, 1, 0x4018000000000000)
    ArraySet(pack, 2, 0x4028000000000000)
    ArraySet(pack, 3, 0x403C000000000000)
    cut = CAD_Feat.CreateHole(body, pack, tool_out)
    IfCondition EqualTo(cut, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL blind cut\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Store.Read(cut, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL blind no shell\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(cut, "test-stl/cad_plate_blind_pocket.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL blind STEP\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote blind-pocket.stp (B-Rep walk)\n", 36)
    Deallocate(pack, 48)
    Deallocate(tool_out, 16)
    CAD_Sys.Write(1, "BLIND BREP OK\n", 14)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
