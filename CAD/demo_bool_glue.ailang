// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Tess

SubRoutine.Main {
    CAD_Sys.Write(1, "B4 glue on face\n", 16)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n0 = 0
    n20 = 0x4034000000000000
    n15 = 0x402E000000000000
    n8 = 0x4020000000000000
    n10 = 0x4024000000000000
    xy = Allocate(64)
    ArraySet(xy, 0, Float_Sub(n0, n20))
    ArraySet(xy, 1, Float_Sub(n0, n15))
    ArraySet(xy, 2, n20)
    ArraySet(xy, 3, Float_Sub(n0, n15))
    ArraySet(xy, 4, n20)
    ArraySet(xy, 5, n15)
    ArraySet(xy, 6, Float_Sub(n0, n20))
    ArraySet(xy, 7, n15)
    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, xy, 4)
    host = CAD_Feat.ExtrudeProfile(hsk, n20)
    ArraySet(xy, 0, Float_Sub(n0, n8))
    ArraySet(xy, 1, Float_Sub(n0, n8))
    ArraySet(xy, 2, n8)
    ArraySet(xy, 3, Float_Sub(n0, n8))
    ArraySet(xy, 4, n8)
    ArraySet(xy, 5, n8)
    ArraySet(xy, 6, Float_Sub(n0, n8))
    ArraySet(xy, 7, n8)
    tsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(tsk, xy, 4)
    tool = CAD_Feat.ExtrudeProfile(tsk, n10)
    dlt = Allocate(32)
    ArraySet(dlt, 0, n0)
    ArraySet(dlt, 1, n0)
    ArraySet(dlt, 2, n20)
    CAD_Topo.TranslateSolid(tool, dlt)
    Deallocate(dlt, 32)
    CAD_Topo.RebuildKind0Planes(host)
    CAD_Topo.RebuildKind0Planes(tool)
    ns0 = CAD_Topo.SolidCountShells(host)
    glued = CAD_Bool.GlueOnFace(host, tool)
    ns1 = 0
    IfCondition NotEqual(glued, 0) ThenBlock: {
        ns1 = CAD_Topo.SolidCountShells(glued)
    }
    uv = Allocate(128)
    nn = Allocate(16)
    nring = 0
    IfCondition NotEqual(glued, 0) ThenBlock: {
        sh = CAD_Store.Read(glued, 0)
        IfCondition NotEqual(sh, 0) ThenBlock: {
            face = CAD_Store.Read(sh, 0)
            nring = CAD_Topo.FaceOuterXY(face, uv, nn)
        }
    }
    mesh = Allocate(48)
    nt = 0
    wt = 0
    IfCondition NotEqual(glued, 0) ThenBlock: {
        nt = CAD_Tess.MeshSolid(glued, 0x3FB999999999999A, mesh)
        wt = CAD_Tess.VerifyWatertight(mesh)
    }
    ninner = 0
    zok = 0
    IfCondition NotEqual(glued, 0) ThenBlock: {
        sh = CAD_Store.Read(glued, 0)
        face = CAD_Store.Read(sh, 0)
        WhileLoop NotEqual(face, 0) {
            lp = CAD_Store.Read(face, 1)
            IfCondition NotEqual(lp, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Store.Read(lp, 2), 0) ThenBlock: {
                    ninner = Add(ninner, 1)
                    hd = CAD_Store.Read(lp, 0)
                    z0 = CAD_Store.Read(CAD_Store.Read(hd, 5), 2)
                    inn = CAD_Store.Read(lp, 2)
                    hi = CAD_Store.Read(inn, 0)
                    z1 = CAD_Store.Read(CAD_Store.Read(hi, 5), 2)
                    IfCondition EqualTo(CAD_Num.IsEqual(z0, z1, 0), 1) ThenBlock: { zok = 1 }
                }
            }
            face = CAD_Store.Read(face, 3)
        }
    }
    PrintMessage("glue=")
    PrintNumber(glued)
    PrintMessage(" shells0=")
    PrintNumber(ns0)
    PrintMessage(" shells1=")
    PrintNumber(ns1)
    PrintMessage(" ring=")
    PrintNumber(nring)
    PrintMessage(" ninner=")
    PrintNumber(ninner)
    PrintMessage(" zok=")
    PrintNumber(zok)
    PrintMessage(" nt=")
    PrintNumber(nt)
    PrintMessage(" wt=")
    PrintNumber(wt)
    PrintMessage("\n")
    pass = 0
    IfCondition NotEqual(glued, 0) ThenBlock: {
        IfCondition EqualTo(ns1, 1) ThenBlock: {
            IfCondition EqualTo(ninner, 1) ThenBlock: {
                IfCondition EqualTo(zok, 1) ThenBlock: {
                    IfCondition GreaterEqual(nt, 32) ThenBlock: { pass = 1 }
                }
            }
        }
    }
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "B4 GLUE PASS\n", 13)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "B4 GLUE FAIL\n", 13)
    }
    Deallocate(mesh, 48)
    Deallocate(uv, 128)
    Deallocate(nn, 16)
    Deallocate(xy, 64)
    SystemCall(60, Subtract(1, pass), 0, 0)
}
RunTask(Main)
