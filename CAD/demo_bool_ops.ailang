// Bool look-ats: Intersection of boxes, side rect notch, ClassifyPoint gate.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== bool ops (isect/notch/classify) ===\n", 40)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    pack = Allocate(48)
    tool_out = Allocate(16)
    out = Allocate(16)
    mn = Allocate(32)
    mx = Allocate(32)
    pt = Allocate(32)

    // --- Intersection: box [0,30]^3 ∩ box [10,40]x[10,40]x[10,40] = [10,30]^3 ---
    a = CAD_Script.CreateBox(0x403E000000000000, 0x403E000000000000, 0x403E000000000000)
    ArraySet(mn, 0, 0x4024000000000000)
    ArraySet(mn, 1, 0x4024000000000000)
    ArraySet(mn, 2, 0x4024000000000000)
    ArraySet(mx, 0, 0x4044000000000000)
    ArraySet(mx, 1, 0x4044000000000000)
    ArraySet(mx, 2, 0x4044000000000000)
    b = CAD_Topo.MakeBoxSolid(mn, mx, out)
    isec = CAD_Bool.Intersection(a, b)
    IfCondition EqualTo(isec, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL Intersection\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(isec, "test-stl/cad_intersect_boxes.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL isect STEP\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote intersect-boxes.stp (20 cube)\n", 36)

    // Classify center of isect should be INSIDE (1)
    ArraySet(pt, 0, 0x4034000000000000)
    ArraySet(pt, 1, 0x4034000000000000)
    ArraySet(pt, 2, 0x4034000000000000)
    cl = CAD_Bool.ClassifyPoint(pt, isec)
    IfCondition NotEqual(cl, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL ClassifyPoint inside\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    ArraySet(pt, 0, 0)
    ArraySet(pt, 1, 0)
    ArraySet(pt, 2, 0)
    cl = CAD_Bool.ClassifyPoint(pt, isec)
    IfCondition NotEqual(cl, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL ClassifyPoint outside\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "ClassifyPoint box OK\n", 21)

    // --- Side rect notch: 50x40x30 plate, notch on -X ---
    body = CAD_Script.CreateBox(0x4049000000000000, 0x4044000000000000, 0x403E000000000000)
    // yz window [10,10]→[30,20], depth 15 along +X
    ArraySet(pack, 0, 0x4024000000000000)
    ArraySet(pack, 1, 0x4024000000000000)
    ArraySet(pack, 2, 0x403E000000000000)
    ArraySet(pack, 3, 0x4034000000000000)
    ArraySet(pack, 4, 0x402E000000000000)
    cut = CAD_Feat.CreateRectNotchX(body, pack, tool_out)
    IfCondition EqualTo(cut, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL side notch\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(cut, "test-stl/cad_rect_notch_x.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL notch STEP\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote rect-notch-x.stp (look at -X face)\n", 41)

    // sphere classify
    sp = CAD_Script.CreateSphere(0x4024000000000000)
    ArraySet(pt, 0, 0)
    ArraySet(pt, 1, 0)
    ArraySet(pt, 2, 0)
    cl = CAD_Bool.ClassifyPoint(pt, sp)
    IfCondition NotEqual(cl, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL sphere center\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    ArraySet(pt, 0, 0x4024000000000000)
    cl = CAD_Bool.ClassifyPoint(pt, sp)
    IfCondition NotEqual(cl, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL sphere surface\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "ClassifyPoint sphere OK\n", 24)

    Deallocate(pack, 48)
    Deallocate(tool_out, 16)
    Deallocate(out, 16)
    Deallocate(mn, 32)
    Deallocate(mx, 32)
    Deallocate(pt, 32)
    CAD_Sys.Write(1, "BOOL OPS OK\n", 12)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
