// brokensolid.png topology: concave outer (top protrusion + 2 D-notches)
// + two strictly interior holes. 2D even-odd is the pad cross-section.
// Caps must leave notches and holes empty; plate and protrusion covered.
// Sequential keyhole used to span a triangle across the two holes.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== broken-solid tess (notch!=hole) ===\n", 40)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    n0 = 0
    n20 = 0x4034000000000000
    n16 = 0x4030000000000000
    n10 = 0x4024000000000000
    n6 = 0x4018000000000000
    n8 = 0x4020000000000000
    n4 = 0x4010000000000000
    n3 = 0x4008000000000000
    n2 = 0x4000000000000000
    pi = 0x400921FB54442D18
    two_pi = 0x401921FB54442D18

    outer = Allocate(8192)
    nout = 0
    // CCW: BL → bottom to left port of bottom notch
    ArraySet(outer, 0, Float_Sub(n0, n20))
    ArraySet(outer, 1, Float_Sub(n0, n16))
    nout = 1
    ArraySet(outer, 2, Float_Sub(n0, n6))
    ArraySet(outer, 3, Float_Sub(n0, n16))
    nout = 2
    // bottom D-notch inward (center 0,-16, r=6): left port → up → right port
    nseg = 12
    k = 1
    WhileLoop LessThan(k, nseg) {
        th = Float_Mul(pi, Float_Div(Float_FromInt(k), Float_FromInt(nseg)))
        ax = Float_Mul(n6, Float_Sub(n0, CAD_Geom.Cos(th)))
        ay = Float_Add(Float_Sub(n0, n16), Float_Mul(n6, CAD_Geom.Sin(th)))
        ArraySet(outer, Multiply(nout, 2), ax)
        ArraySet(outer, Add(Multiply(nout, 2), 1), ay)
        nout = Add(nout, 1)
        k = Add(k, 1)
    }
    ArraySet(outer, Multiply(nout, 2), n6)
    ArraySet(outer, Add(Multiply(nout, 2), 1), Float_Sub(n0, n16))
    nout = Add(nout, 1)
    ArraySet(outer, Multiply(nout, 2), n20)
    ArraySet(outer, Add(Multiply(nout, 2), 1), Float_Sub(n0, n16))
    nout = Add(nout, 1)
    ArraySet(outer, Multiply(nout, 2), n20)
    ArraySet(outer, Add(Multiply(nout, 2), 1), Float_Sub(n0, n6))
    nout = Add(nout, 1)
    // right D-notch inward (center 20,0, r=6): bottom port → left → top port
    k = 1
    WhileLoop LessThan(k, nseg) {
        th = Float_Mul(pi, Float_Div(Float_FromInt(k), Float_FromInt(nseg)))
        ax = Float_Sub(n20, Float_Mul(n6, CAD_Geom.Sin(th)))
        ay = Float_Mul(n6, Float_Sub(n0, CAD_Geom.Cos(th)))
        ArraySet(outer, Multiply(nout, 2), ax)
        ArraySet(outer, Add(Multiply(nout, 2), 1), ay)
        nout = Add(nout, 1)
        k = Add(k, 1)
    }
    ArraySet(outer, Multiply(nout, 2), n20)
    ArraySet(outer, Add(Multiply(nout, 2), 1), n6)
    nout = Add(nout, 1)
    ArraySet(outer, Multiply(nout, 2), n20)
    ArraySet(outer, Add(Multiply(nout, 2), 1), n16)
    nout = Add(nout, 1)
    ArraySet(outer, Multiply(nout, 2), n10)
    ArraySet(outer, Add(Multiply(nout, 2), 1), n16)
    nout = Add(nout, 1)
    // top protrusion (center 0,16, r=10): right port → up → left port
    nseg2 = 16
    k = 1
    WhileLoop LessThan(k, nseg2) {
        th = Float_Mul(pi, Float_Div(Float_FromInt(k), Float_FromInt(nseg2)))
        ax = Float_Mul(n10, CAD_Geom.Cos(th))
        ay = Float_Add(n16, Float_Mul(n10, CAD_Geom.Sin(th)))
        ArraySet(outer, Multiply(nout, 2), ax)
        ArraySet(outer, Add(Multiply(nout, 2), 1), ay)
        nout = Add(nout, 1)
        k = Add(k, 1)
    }
    ArraySet(outer, Multiply(nout, 2), Float_Sub(n0, n10))
    ArraySet(outer, Add(Multiply(nout, 2), 1), n16)
    nout = Add(nout, 1)
    ArraySet(outer, Multiply(nout, 2), Float_Sub(n0, n20))
    ArraySet(outer, Add(Multiply(nout, 2), 1), n16)
    nout = Add(nout, 1)
    ArraySet(outer, Multiply(nout, 2), Float_Sub(n0, n20))
    ArraySet(outer, Add(Multiply(nout, 2), 1), Float_Sub(n0, n16))
    nout = Add(nout, 1)

    // hole 1 at (8, 4) r=3
    hole1 = Allocate(4096)
    nh1 = 24
    i = 0
    WhileLoop LessThan(i, nh1) {
        th = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(nh1)))
        ArraySet(hole1, Multiply(i, 2), Float_Add(n8, Float_Mul(n3, CAD_Geom.Cos(th))))
        ArraySet(hole1, Add(Multiply(i, 2), 1), Float_Add(n4, Float_Mul(n3, CAD_Geom.Sin(th))))
        i = Add(i, 1)
    }
    // hole 2 at (-8, -2) r=2.5
    n25 = 0x4004000000000000
    hole2 = Allocate(4096)
    nh2 = 20
    i = 0
    WhileLoop LessThan(i, nh2) {
        th = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(nh2)))
        ArraySet(hole2, Multiply(i, 2), Float_Add(Float_Sub(n0, n8), Float_Mul(n25, CAD_Geom.Cos(th))))
        ArraySet(hole2, Add(Multiply(i, 2), 1), Float_Add(Float_Sub(n0, n2), Float_Mul(n25, CAD_Geom.Sin(th))))
        i = Add(i, 1)
    }

    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, outer, nout)
    CAD_Sketch.AddProfileXY(hsk, hole1, nh1)
    CAD_Sketch.AddProfileXY(hsk, hole2, nh2)
    PrintMessage("nprof=")
    PrintNumber(CAD_Store.Read(hsk, 12))
    PrintMessage(" nout=")
    PrintNumber(nout)
    PrintMessage("\n")

    h = CAD_Feat.ExtrudeProfile(hsk, n20)
    PrintMessage("solid=")
    PrintNumber(h)
    PrintMessage("\n")
    pass = 0
    nt = 0
    h_plate = 0
    h_protr = 0
    h_rn = 0
    h_bn = 0
    h_h1 = 0
    h_h2 = 0
    IfCondition NotEqual(h, 0) ThenBlock: {
        mesh = Allocate(32)
        nt = CAD_Tess.MeshSolid(h, 0x3FB999999999999A, mesh)
        PrintMessage("mesh nt=")
        PrintNumber(nt)
        PrintMessage(" nv=")
        PrintNumber(ArrayGet(mesh, 0))
        PrintMessage("\n")
        v_base = ArrayGet(mesh, 2)
        i_base = ArrayGet(mesh, 3)
        ztop = n20
        ztol = 0x3F847AE147AE147B
        pa = Allocate(32)
        pb = Allocate(32)
        pc = Allocate(32)
        pd = Allocate(32)
        t = 0
        WhileLoop LessThan(t, nt) {
            i0 = ArrayGet(i_base, Multiply(t, 3))
            i1 = ArrayGet(i_base, Add(Multiply(t, 3), 1))
            i2 = ArrayGet(i_base, Add(Multiply(t, 3), 2))
            z0 = ArrayGet(v_base, Add(Multiply(i0, 3), 2))
            z1 = ArrayGet(v_base, Add(Multiply(i1, 3), 2))
            z2 = ArrayGet(v_base, Add(Multiply(i2, 3), 2))
            d0 = Float_Sub(z0, ztop)
            IfCondition EqualTo(CAD_Num.IsNeg(d0), 1) ThenBlock: { d0 = Float_Sub(n0, d0) }
            d1 = Float_Sub(z1, ztop)
            IfCondition EqualTo(CAD_Num.IsNeg(d1), 1) ThenBlock: { d1 = Float_Sub(n0, d1) }
            d2 = Float_Sub(z2, ztop)
            IfCondition EqualTo(CAD_Num.IsNeg(d2), 1) ThenBlock: { d2 = Float_Sub(n0, d2) }
            IfCondition EqualTo(Float_Le(d0, ztol), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(d1, ztol), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(d2, ztol), 1) ThenBlock: {
                        ArraySet(pa, 0, ArrayGet(v_base, Multiply(i0, 3)))
                        ArraySet(pa, 1, ArrayGet(v_base, Add(Multiply(i0, 3), 1)))
                        ArraySet(pb, 0, ArrayGet(v_base, Multiply(i1, 3)))
                        ArraySet(pb, 1, ArrayGet(v_base, Add(Multiply(i1, 3), 1)))
                        ArraySet(pc, 0, ArrayGet(v_base, Multiply(i2, 3)))
                        ArraySet(pc, 1, ArrayGet(v_base, Add(Multiply(i2, 3), 1)))
                        // plate (0,0)
                        ArraySet(pd, 0, n0)
                        ArraySet(pd, 1, n0)
                        o1 = CAD_Num.Orient2D(pa, pb, pd)
                        o2 = CAD_Num.Orient2D(pb, pc, pd)
                        o3 = CAD_Num.Orient2D(pc, pa, pd)
                        IfCondition EqualTo(o1, o2) ThenBlock: {
                            IfCondition EqualTo(o2, o3) ThenBlock: {
                                IfCondition NotEqual(o1, 0) ThenBlock: { h_plate = Add(h_plate, 1) }
                            }
                        }
                        // protrusion (0, 22)
                        ArraySet(pd, 1, 0x4036000000000000)
                        o1 = CAD_Num.Orient2D(pa, pb, pd)
                        o2 = CAD_Num.Orient2D(pb, pc, pd)
                        o3 = CAD_Num.Orient2D(pc, pa, pd)
                        IfCondition EqualTo(o1, o2) ThenBlock: {
                            IfCondition EqualTo(o2, o3) ThenBlock: {
                                IfCondition NotEqual(o1, 0) ThenBlock: { h_protr = Add(h_protr, 1) }
                            }
                        }
                        // right notch interior (17, 0)
                        ArraySet(pd, 0, 0x4031000000000000)
                        ArraySet(pd, 1, n0)
                        o1 = CAD_Num.Orient2D(pa, pb, pd)
                        o2 = CAD_Num.Orient2D(pb, pc, pd)
                        o3 = CAD_Num.Orient2D(pc, pa, pd)
                        IfCondition EqualTo(o1, o2) ThenBlock: {
                            IfCondition EqualTo(o2, o3) ThenBlock: {
                                IfCondition NotEqual(o1, 0) ThenBlock: { h_rn = Add(h_rn, 1) }
                            }
                        }
                        // bottom notch interior (0, -13)
                        ArraySet(pd, 0, n0)
                        ArraySet(pd, 1, Float_Sub(n0, 0x402A000000000000))
                        o1 = CAD_Num.Orient2D(pa, pb, pd)
                        o2 = CAD_Num.Orient2D(pb, pc, pd)
                        o3 = CAD_Num.Orient2D(pc, pa, pd)
                        IfCondition EqualTo(o1, o2) ThenBlock: {
                            IfCondition EqualTo(o2, o3) ThenBlock: {
                                IfCondition NotEqual(o1, 0) ThenBlock: { h_bn = Add(h_bn, 1) }
                            }
                        }
                        // hole1 (8, 4)
                        ArraySet(pd, 0, n8)
                        ArraySet(pd, 1, n4)
                        o1 = CAD_Num.Orient2D(pa, pb, pd)
                        o2 = CAD_Num.Orient2D(pb, pc, pd)
                        o3 = CAD_Num.Orient2D(pc, pa, pd)
                        IfCondition EqualTo(o1, o2) ThenBlock: {
                            IfCondition EqualTo(o2, o3) ThenBlock: {
                                IfCondition NotEqual(o1, 0) ThenBlock: { h_h1 = Add(h_h1, 1) }
                            }
                        }
                        // hole2 (-8, -2)
                        ArraySet(pd, 0, Float_Sub(n0, n8))
                        ArraySet(pd, 1, Float_Sub(n0, n2))
                        o1 = CAD_Num.Orient2D(pa, pb, pd)
                        o2 = CAD_Num.Orient2D(pb, pc, pd)
                        o3 = CAD_Num.Orient2D(pc, pa, pd)
                        IfCondition EqualTo(o1, o2) ThenBlock: {
                            IfCondition EqualTo(o2, o3) ThenBlock: {
                                IfCondition NotEqual(o1, 0) ThenBlock: { h_h2 = Add(h_h2, 1) }
                            }
                        }
                    }
                }
            }
            t = Add(t, 1)
        }
        Deallocate(pa, 32)
        Deallocate(pb, 32)
        Deallocate(pc, 32)
        Deallocate(pd, 32)
        CAD_Tess.ExportSTL(h, "/tmp/broken_solid.stl")
        PrintMessage("plate=")
        PrintNumber(h_plate)
        PrintMessage(" protr=")
        PrintNumber(h_protr)
        PrintMessage(" rnotch=")
        PrintNumber(h_rn)
        PrintMessage(" bnotch=")
        PrintNumber(h_bn)
        PrintMessage(" hole1=")
        PrintNumber(h_h1)
        PrintMessage(" hole2=")
        PrintNumber(h_h2)
        PrintMessage("\n")
        IfCondition GreaterThan(h_plate, 0) ThenBlock: {
            IfCondition GreaterThan(h_protr, 0) ThenBlock: {
                IfCondition EqualTo(h_rn, 0) ThenBlock: {
                    IfCondition EqualTo(h_bn, 0) ThenBlock: {
                        IfCondition EqualTo(h_h1, 0) ThenBlock: {
                            IfCondition EqualTo(h_h2, 0) ThenBlock: {
                                IfCondition GreaterThan(nt, 40) ThenBlock: { pass = 1 }
                            }
                        }
                    }
                }
            }
        }
        Deallocate(mesh, 32)
    }
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "BROKEN SOLID TESS PASS\n", 23)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "BROKEN SOLID TESS FAIL\n", 23)
    }
    Deallocate(outer, 8192)
    Deallocate(hole1, 4096)
    Deallocate(hole2, 4096)
    CAD_Sys.Write(1, "DONE\n", 5)
    SystemCall(60, Subtract(1, pass), 0, 0)
}
RunTask(Main)
