LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_UI

FixedPool.T {
    "fail": Initialize=0
}

Function.TFail {
    Input: msg: Address
    Input: n: Integer
    Output: Integer
    Body: {
        CAD_Sys.Write(1, msg, n)
        T.fail = Add(T.fail, 1)
        ReturnValue(0)
    }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== CAD_UI ===\n", 15)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    // ParseTool
    IfCondition NotEqual(CAD_UI.ParseTool("tool_arc3"), 9) ThenBlock: {
        TFail("FAIL parse arc3\n", 16)
    }
    IfCondition NotEqual(CAD_UI.ParseTool("tool_arc2"), 12) ThenBlock: {
        TFail("FAIL parse arc2\n", 16)
    }
    IfCondition NotEqual(CAD_UI.ParseTool("tool_circ2"), 13) ThenBlock: {
        TFail("FAIL parse circ2\n", 17)
    }
    IfCondition NotEqual(CAD_UI.ParseTool("tool_circ3"), 14) ThenBlock: {
        TFail("FAIL parse circ3\n", 17)
    }
    IfCondition NotEqual(CAD_UI.ParseTool("tool_rectc"), 15) ThenBlock: {
        TFail("FAIL parse rectc\n", 17)
    }
    IfCondition NotEqual(CAD_UI.ParseTool("tool_rect3"), 16) ThenBlock: {
        TFail("FAIL parse rect3\n", 17)
    }
    IfCondition NotEqual(CAD_UI.ParseTool("tool_poly6"), 17) ThenBlock: {
        TFail("FAIL parse poly6\n", 17)
    }
    IfCondition NotEqual(CAD_UI_State.nsides, 6) ThenBlock: {
        TFail("FAIL poly6 nsides\n", 18)
    }
    IfCondition NotEqual(CAD_UI.ParseTool("tool_poly5"), 17) ThenBlock: {
        TFail("FAIL parse poly5\n", 17)
    }
    IfCondition NotEqual(CAD_UI_State.nsides, 5) ThenBlock: {
        TFail("FAIL poly5 nsides\n", 18)
    }
    IfCondition NotEqual(CAD_UI.ParseTool("tool_poly24"), 17) ThenBlock: {
        TFail("FAIL parse poly24\n", 18)
    }
    IfCondition NotEqual(CAD_UI_State.nsides, 24) ThenBlock: {
        TFail("FAIL poly24 nsides\n", 19)
    }
    IfCondition NotEqual(CAD_UI.ParseTool("tool_spline"), 18) ThenBlock: {
        TFail("FAIL parse spline\n", 18)
    }
    IfCondition NotEqual(CAD_UI.ParseTool("tools"), -1) ThenBlock: {
        TFail("FAIL parse tools\n", 17)
    }

    ten = Float_FromInt(10)
    mten = Float_FromInt(-10)
    five = Float_FromInt(5)
    z = 0

    sk = CAD_Sketch.CreateSketch(1)
    CAD_UI.Pend2(mten, z, ten, z)
    IfCondition NotEqual(CAD_UI.AddArc2(sk), 0) ThenBlock: {
        TFail("FAIL arc2\n", 10)
    }
    IfCondition LessThan(CAD_Sketch.GetArcCount(sk), 1) ThenBlock: {
        TFail("FAIL arc2 count\n", 16)
    }

    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_UI.Pend2(mten, z, ten, z)
    IfCondition NotEqual(CAD_UI.AddCircleDiam(sk2), 0) ThenBlock: {
        TFail("FAIL circ2\n", 11)
    }
    IfCondition LessThan(CAD_Sketch.GetCircleCount(sk2), 1) ThenBlock: {
        TFail("FAIL circ2 count\n", 17)
    }

    sk3 = CAD_Sketch.CreateSketch(1)
    CAD_UI.Pend3(ten, z, z, ten, mten, z)
    IfCondition NotEqual(CAD_UI.AddCircle3(sk3), 0) ThenBlock: {
        TFail("FAIL circ3\n", 11)
    }
    IfCondition LessThan(CAD_Sketch.GetCircleCount(sk3), 1) ThenBlock: {
        TFail("FAIL circ3 count\n", 17)
    }

    sk4 = CAD_Sketch.CreateSketch(1)
    CAD_UI.Pend2(z, z, ten, five)
    IfCondition NotEqual(CAD_UI.AddRectCenter(sk4), 0) ThenBlock: {
        TFail("FAIL rectC\n", 11)
    }
    IfCondition LessThan(CAD_Sketch.GetLineCount(sk4), 4) ThenBlock: {
        TFail("FAIL rectC lines\n", 17)
    }

    sk5 = CAD_Sketch.CreateSketch(1)
    CAD_UI.Pend3(z, z, ten, z, ten, ten)
    IfCondition NotEqual(CAD_UI.AddRect3(sk5), 0) ThenBlock: {
        TFail("FAIL rect3\n", 11)
    }
    IfCondition LessThan(CAD_Sketch.GetLineCount(sk5), 4) ThenBlock: {
        TFail("FAIL rect3 lines\n", 17)
    }

    sk6 = CAD_Sketch.CreateSketch(1)
    CAD_UI_State.nsides = 6
    CAD_UI.Pend2(z, z, ten, z)
    IfCondition NotEqual(CAD_UI.AddNGon(sk6), 0) ThenBlock: {
        TFail("FAIL hex\n", 10)
    }
    IfCondition LessThan(CAD_Sketch.GetLineCount(sk6), 6) ThenBlock: {
        TFail("FAIL hex lines\n", 16)
    }

    sk7 = CAD_Sketch.CreateSketch(1)
    CAD_UI.Pend2(mten, z, ten, z)
    IfCondition NotEqual(CAD_UI.AddSlot(sk7), 0) ThenBlock: {
        TFail("FAIL slot\n", 11)
    }
    IfCondition LessThan(CAD_Sketch.GetLineCount(sk7), 2) ThenBlock: {
        TFail("FAIL slot lines\n", 17)
    }
    IfCondition LessThan(CAD_Sketch.GetArcCount(sk7), 2) ThenBlock: {
        TFail("FAIL slot arcs\n", 16)
    }

    sk8 = CAD_Sketch.CreateSketch(1)
    pts = Allocate(128)
    ArraySet(pts, 0, z)
    ArraySet(pts, 1, z)
    ArraySet(pts, 2, five)
    ArraySet(pts, 3, ten)
    ArraySet(pts, 4, ten)
    ArraySet(pts, 5, ten)
    ArraySet(pts, 6, Float_FromInt(15))
    ArraySet(pts, 7, z)
    IfCondition NotEqual(CAD_UI.AddSplineXY(sk8, pts, 4), 0) ThenBlock: {
        TFail("FAIL spline\n", 13)
    }
    IfCondition LessThan(CAD_Sketch.GetLineCount(sk8), 2) ThenBlock: {
        TFail("FAIL spline segs\n", 18)
    }
    Deallocate(pts, 128)

    IfCondition EqualTo(T.fail, 0) ThenBlock: {
        CAD_Sys.Write(1, "PASS CAD_UI constructions\n", 26)
        SystemCall(60, 0, 0, 0)
    }
    CAD_Sys.Write(1, "FAIL CAD_UI constructions\n", 26)
    SystemCall(60, 1, 0, 0)
}
