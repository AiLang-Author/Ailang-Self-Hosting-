// C4: chamfer one vertical corner of a box (equal setback)

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== Chamfer demo ===\n", 21)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(8192)
    body = CAD_Script.CreateBox(Float_FromInt(40), Float_FromInt(30), Float_FromInt(20))
    edges = Allocate(1024)
    ne = CAD_Topo.SolidCollectEdges(body, edges, 64)
    found = 0
    j = 0
    WhileLoop LessThan(j, ne) {
        ed = ArrayGet(edges, j)
        v0 = CAD_Store.Read(ed, 0)
        v1 = CAD_Store.Read(ed, 1)
        dx = Float_Sub(CAD_Store.Read(v1, 0), CAD_Store.Read(v0, 0))
        dy = Float_Sub(CAD_Store.Read(v1, 1), CAD_Store.Read(v0, 1))
        adx = dx
        IfCondition EqualTo(Float_Le(adx, 0), 1) ThenBlock: { adx = Float_Sub(0, adx) }
        ady = dy
        IfCondition EqualTo(Float_Le(ady, 0), 1) ThenBlock: { ady = Float_Sub(0, ady) }
        IfCondition EqualTo(CAD_Num.IsZero(adx, 0), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(ady, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Store.Read(v0, 0), 0), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsZero(CAD_Store.Read(v0, 1), 0), 1) ThenBlock: {
                        found = ed
                        j = ne
                    }
                }
            }
        }
        j = Add(j, 1)
    }
    IfCondition EqualTo(found, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL edge\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    h = CAD_Blend.ChamferEdge(body, found, Float_FromInt(5))
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL chamfer\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(h, "test-stl/cad_chamfer_edge.stp")
    CAD_View.SetWire(0)
    CAD_View.RenderSolidToBMP(h, 400, 300, "test-stl/cad_view_chamfer.bmp")
    CAD_Sys.Write(1, "CHAMFER OK\n", 11)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
