// Horizontal equal-setback chamfer on box top/bottom edges

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

// Find first edge with same Z, span full width in X or Y, at zmax (top) or zmin.
Function.FindHorizEdge {
    Input: body: Integer
    Input: want_top: Integer
    Input: along_x: Integer
    Output: Integer
    Body: {
        mn = Allocate(32)
        mx = Allocate(32)
        CAD_Topo.SolidBounds(body, mn, mx)
        zmin = ArrayGet(mn, 2)
        zmax = ArrayGet(mx, 2)
        xmin = ArrayGet(mn, 0)
        xmax = ArrayGet(mx, 0)
        ymin = ArrayGet(mn, 1)
        ymax = ArrayGet(mx, 1)
        Deallocate(mn, 32)
        Deallocate(mx, 32)
        zt = zmax
        IfCondition EqualTo(want_top, 0) ThenBlock: { zt = zmin }
        edges = Allocate(1024)
        ne = CAD_Topo.SolidCollectEdges(body, edges, 64)
        found = 0
        j = 0
        WhileLoop LessThan(j, ne) {
            ed = ArrayGet(edges, j)
            v0 = CAD_Store.Read(ed, 0)
            v1 = CAD_Store.Read(ed, 1)
            IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v0, 2), zt, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v1, 2), zt, 0), 1) ThenBlock: {
                    IfCondition EqualTo(along_x, 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v0, 1), CAD_Store.Read(v1, 1), 0), 1) ThenBlock: {
                            xlo = CAD_Store.Read(v0, 0)
                            xhi = CAD_Store.Read(v1, 0)
                            IfCondition EqualTo(Float_Le(xhi, xlo), 1) ThenBlock: {
                                t = xlo
                                xlo = xhi
                                xhi = t
                            }
                            IfCondition EqualTo(CAD_Num.IsEqual(xlo, xmin, 0), 1) ThenBlock: {
                                IfCondition EqualTo(CAD_Num.IsEqual(xhi, xmax, 0), 1) ThenBlock: {
                                    found = ed
                                    j = ne
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(along_x, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v0, 0), CAD_Store.Read(v1, 0), 0), 1) ThenBlock: {
                            ylo = CAD_Store.Read(v0, 1)
                            yhi = CAD_Store.Read(v1, 1)
                            IfCondition EqualTo(Float_Le(yhi, ylo), 1) ThenBlock: {
                                t = ylo
                                ylo = yhi
                                yhi = t
                            }
                            IfCondition EqualTo(CAD_Num.IsEqual(ylo, ymin, 0), 1) ThenBlock: {
                                IfCondition EqualTo(CAD_Num.IsEqual(yhi, ymax, 0), 1) ThenBlock: {
                                    found = ed
                                    j = ne
                                }
                            }
                        }
                    }
                }
            }
            j = Add(j, 1)
        }
        Deallocate(edges, 1024)
        ReturnValue(found)
    }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== Horizontal chamfer ===\n", 27)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    // top edge along X
    b1 = CAD_Script.CreateBox(Float_FromInt(40), Float_FromInt(30), Float_FromInt(20))
    e1 = FindHorizEdge(b1, 1, 1)
    IfCondition EqualTo(e1, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL find top-X edge\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    h1 = CAD_Blend.ChamferEdge(b1, e1, Float_FromInt(5))
    IfCondition EqualTo(h1, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL top-X chamfer\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(h1, "test-stl/cad_chamfer_horiz.stp")
    CAD_View.SetWire(0)
    CAD_View.SetViewMode(0)
    CAD_View.RenderSolidToBMP(h1, 400, 300, "test-stl/cad_view_chamfer_horiz.bmp")
    CAD_Sys.Write(1, "top-X ok\n", 9)

    // top edge along Y
    b2 = CAD_Script.CreateBox(Float_FromInt(40), Float_FromInt(30), Float_FromInt(20))
    e2 = FindHorizEdge(b2, 1, 0)
    IfCondition EqualTo(e2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL find top-Y edge\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    h2 = CAD_Blend.ChamferEdge(b2, e2, Float_FromInt(4))
    IfCondition EqualTo(h2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL top-Y chamfer\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(h2, "test-stl/cad_chamfer_horiz_y.stp")
    CAD_View.RenderSolidToBMP(h2, 400, 300, "test-stl/cad_view_chamfer_horiz_y.bmp")
    CAD_Sys.Write(1, "top-Y ok\n", 9)

    // bottom edge along X
    b3 = CAD_Script.CreateBox(Float_FromInt(30), Float_FromInt(25), Float_FromInt(15))
    e3 = FindHorizEdge(b3, 0, 1)
    IfCondition EqualTo(e3, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL find bot-X edge\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    h3 = CAD_Blend.ChamferEdge(b3, e3, Float_FromInt(3))
    IfCondition EqualTo(h3, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL bot-X chamfer\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(h3, "test-stl/cad_chamfer_horiz_bot.stp")
    CAD_View.RenderSolidToBMP(h3, 400, 300, "test-stl/cad_view_chamfer_horiz_bot.bmp")
    CAD_Sys.Write(1, "bot-X ok\n", 9)

    // negative: D too large
    b4 = CAD_Script.CreateBox(Float_FromInt(20), Float_FromInt(20), Float_FromInt(10))
    e4 = FindHorizEdge(b4, 1, 1)
    IfCondition NotEqual(CAD_Blend.ChamferEdge(b4, e4, Float_FromInt(25)), 0) ThenBlock: {
        CAD_Sys.Write(1, "NEG FAIL huge D\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "neg huge D ok\n", 14)

    CAD_Sys.Write(1, "CHAMFER HORIZ OK\n", 17)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
