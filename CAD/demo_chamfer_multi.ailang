// C4 expand: multi-edge vertical chamfer + diamond + sequential + negatives

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

// Collect full-height vertical edges into out[] (max maxn). Returns count.
Function.CollectVerticalEdges {
    Input: body: Integer
    Input: out: Address
    Input: maxn: Integer
    Output: Integer
    Body: {
        edges = Allocate(1024)
        ne = CAD_Topo.SolidCollectEdges(body, edges, 64)
        n = 0
        j = 0
        WhileLoop LessThan(j, ne) {
            ed = ArrayGet(edges, j)
            v0 = CAD_Store.Read(ed, 0)
            v1 = CAD_Store.Read(ed, 1)
            IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v0, 0), CAD_Store.Read(v1, 0), 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v0, 1), CAD_Store.Read(v1, 1), 0), 1) ThenBlock: {
                    IfCondition LessThan(n, maxn) ThenBlock: {
                        ArraySet(out, n, ed)
                        n = Add(n, 1)
                    }
                }
            }
            j = Add(j, 1)
        }
        Deallocate(edges, 1024)
        ReturnValue(n)
    }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== Chamfer multi / general vertical ===\n", 40)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    fails = 0

    // --- 1) all 4 vertical corners of a box at once ---
    body = CAD_Script.CreateBox(Float_FromInt(40), Float_FromInt(30), Float_FromInt(20))
    verts = Allocate(64)
    nv = CollectVerticalEdges(body, verts, 8)
    IfCondition LessThan(nv, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL need 4 verticals\n", 22)
        SystemCall(60, 1, 0, 0)
    }
    h4 = CAD_Blend.ChamferEdges(body, verts, 4, Float_FromInt(4))
    IfCondition EqualTo(h4, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL chamfer 4 corners\n", 23)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(h4, "test-stl/cad_chamfer_4corners.stp")
    CAD_View.SetWire(0)
    CAD_View.SetViewMode(0)
    CAD_View.RenderSolidToBMP(h4, 400, 300, "test-stl/cad_view_chamfer_4corners.bmp")
    CAD_Sys.Write(1, "4-corner chamfer ok\n", 20)

    // --- 2) sequential two corners (general prism path after first cut) ---
    b2 = CAD_Script.CreateBox(Float_FromInt(30), Float_FromInt(25), Float_FromInt(15))
    verts2 = Allocate(64)
    n2 = CollectVerticalEdges(b2, verts2, 8)
    h1 = CAD_Blend.ChamferEdge(b2, ArrayGet(verts2, 0), Float_FromInt(3))
    IfCondition EqualTo(h1, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL seq first\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    // re-collect verts on 5-gon; chamfer another original-ish corner
    n2b = CollectVerticalEdges(h1, verts2, 8)
    // pick a vertical that is still a sharp corner (not on the chamfer face ends)
    // use second edge if available
    h2 = 0
    k = 0
    WhileLoop LessThan(k, n2b) {
        IfCondition EqualTo(h2, 0) ThenBlock: {
            cand = CAD_Blend.ChamferEdge(h1, ArrayGet(verts2, k), Float_FromInt(3))
            IfCondition NotEqual(cand, 0) ThenBlock: {
                h2 = cand
            }
        }
        k = Add(k, 1)
    }
    IfCondition EqualTo(h2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL seq second\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(h2, "test-stl/cad_chamfer_seq.stp")
    CAD_View.RenderSolidToBMP(h2, 400, 300, "test-stl/cad_view_chamfer_seq.bmp")
    CAD_Sys.Write(1, "sequential chamfer ok\n", 22)

    // --- 3) diamond (non-box poly) single vertex ---
    sk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk, 0, Float_FromInt(15), Float_FromInt(12), 0)
    CAD_Sketch.AddLine(sk, Float_FromInt(12), 0, 0, Float_FromInt(-15))
    CAD_Sketch.AddLine(sk, 0, Float_FromInt(-15), Float_FromInt(-12), 0)
    CAD_Sketch.AddLine(sk, Float_FromInt(-12), 0, 0, Float_FromInt(15))
    CAD_Sketch.BuildClosedLoop(sk)
    diam = CAD_Feat.ExtrudeProfile(sk, Float_FromInt(10))
    IfCondition EqualTo(diam, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL diamond\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    vd = Allocate(64)
    nd = CollectVerticalEdges(diam, vd, 8)
    IfCondition LessThan(nd, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL diamond verts\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    hd = CAD_Blend.ChamferEdge(diam, ArrayGet(vd, 0), Float_FromInt(3))
    IfCondition EqualTo(hd, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL diamond chamfer\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(hd, "test-stl/cad_chamfer_diamond.stp")
    CAD_View.RenderSolidToBMP(hd, 400, 300, "test-stl/cad_view_chamfer_diamond.bmp")
    CAD_Sys.Write(1, "diamond chamfer ok\n", 19)

    // --- 4) negatives ---
    box = CAD_Script.CreateBox(Float_FromInt(20), Float_FromInt(20), Float_FromInt(10))
    // null edge
    IfCondition NotEqual(CAD_Blend.ChamferEdge(box, 0, Float_FromInt(2)), 0) ThenBlock: {
        CAD_Sys.Write(1, "NEG FAIL null edge\n", 19)
        fails = Add(fails, 1)
    }
    // zero D
    nvb = CollectVerticalEdges(box, verts, 8)
    IfCondition NotEqual(CAD_Blend.ChamferEdge(box, ArrayGet(verts, 0), 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "NEG FAIL zero D\n", 16)
        fails = Add(fails, 1)
    }
    // D too large for box 20x20 (edge length 20; need D < 20 for single corner)
    IfCondition NotEqual(CAD_Blend.ChamferEdge(box, ArrayGet(verts, 0), Float_FromInt(25)), 0) ThenBlock: {
        CAD_Sys.Write(1, "NEG FAIL huge D\n", 16)
        fails = Add(fails, 1)
    }
    // kind-1 cylinder
    cyl = CAD_Script.CreateCylinder(Float_FromInt(5), Float_FromInt(10))
    IfCondition NotEqual(CAD_Blend.ChamferEdge(cyl, ArrayGet(verts, 0), Float_FromInt(1)), 0) ThenBlock: {
        CAD_Sys.Write(1, "NEG FAIL kind1\n", 15)
        fails = Add(fails, 1)
    }
    // single-edge path still works (compat with demo_chamfer)
    h1b = CAD_Blend.ChamferEdge(box, ArrayGet(verts, 0), Float_FromInt(2))
    IfCondition EqualTo(h1b, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL single compat\n", 19)
        fails = Add(fails, 1)
    }

    Deallocate(verts, 64)
    Deallocate(verts2, 64)
    Deallocate(vd, 64)

    IfCondition GreaterThan(fails, 0) ThenBlock: {
        CAD_Sys.Write(1, "CHAMFER MULTI FAIL\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "CHAMFER MULTI OK\n", 17)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
