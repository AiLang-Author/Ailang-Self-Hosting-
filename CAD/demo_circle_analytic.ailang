// Pure circle pad must stay kind-1 analytic cylinder (not a 48-gon prism).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess

SubRoutine.Main {
    CAD_Sys.Write(1, "analytic circle pad\n", 20)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    r = 0x4024000000000000
    hgt = 0x4034000000000000
    sk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(sk, 0, 0, r)
    h = CAD_Feat.ExtrudeProfile(sk, hgt)
    k = 0
    IfCondition NotEqual(h, 0) ThenBlock: {
        k = CAD_Store.Read(h, 3)
    }
    mesh = Allocate(48)
    nt = 0
    IfCondition NotEqual(h, 0) ThenBlock: {
        nt = CAD_Tess.MeshSolid(h, 0, mesh)
    }
    PrintMessage("solid=")
    PrintNumber(h)
    PrintMessage(" kind=")
    PrintNumber(k)
    PrintMessage(" nt=")
    PrintNumber(nt)
    PrintMessage("\n")
    pass = 0
    IfCondition EqualTo(k, 1) ThenBlock: {
        IfCondition GreaterEqual(nt, 180) ThenBlock: { pass = 1 }
    }
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "ANALYTIC CYL PASS\n", 18)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "ANALYTIC CYL FAIL\n", 18)
    }
    Deallocate(mesh, 48)
    SystemCall(60, Subtract(1, pass), 0, 0)
}
RunTask(Main)
