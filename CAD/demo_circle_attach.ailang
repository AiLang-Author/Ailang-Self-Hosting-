// Regression: circle + open U-chain must merge (clip arc), not pad pure cylinder.
// Also: circle + orphan open lines that miss the rim must FAIL (not ignore lines).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== circle+chain attach pad ===\n", 33)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    // --- case 1: circle R=10 at origin + U box attached on +X rim ---
    // attach points at angles ~±45° would be freehand; use exact rim points
    // rim at (10,0): U goes right to x=18 then up/down
    sk = CAD_Sketch.CreateSketch(1)
    // circle center 0,0 R=10
    CAD_Sketch.AddCircle(sk, 0, 0, 0x4024000000000000)
    // U open chain both ends on circle:
    // p0 = (10, 4) projected onto circle later; use exact rim
    // exact: at y=±6 on circle x = sqrt(100-36)=8
    // p0=(8,6) p1=(16,6) p2=(16,-6) p3=(8,-6)
    x8 = 0x4020000000000000
    y6 = 0x4018000000000000
    x16 = 0x4030000000000000
    ny6 = 0xC018000000000000
    CAD_Sketch.AddLine(sk, x8, y6, x16, y6)
    CAD_Sketch.AddLine(sk, x16, y6, x16, ny6)
    CAD_Sketch.AddLine(sk, x16, ny6, x8, ny6)

    nprof = CAD_Sketch.PrepareExtrude(sk)
    IfCondition LessThan(nprof, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL attach: no closed profile\n", 32)
        SystemCall(60, 1, 0, 0)
    }
    nloop = CAD_Store.Read(sk, 2)
    // pure circle tess = 32; composite = arc segs + U verts > 32 typically
    // at least must be more than a 4-gon box and not fail
    IfCondition LessThan(nloop, 6) ThenBlock: {
        CAD_Sys.Write(1, "FAIL attach: loop too small (not merged)\n", 42)
        SystemCall(60, 1, 0, 0)
    }
    // pad
    h = CAD_Feat.ExtrudeProfile(sk, 0x4024000000000000)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL attach extrude\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS circle+U attach pad\n", 25)
    IfCondition NotEqual(CAD_IO.ExportSTEP(h, "test-stl/cad_circle_attach.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL STEP attach\n", 17)
        SystemCall(60, 1, 0, 0)
    }

    // --- case 2: freehand-ish ends slightly off rim (should pre-project + attach) ---
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(sk2, 0, 0, 0x4024000000000000)
    // ends at ~1.1 * rim (10% outside) — within 40% tol
    // (8.8, 6.6) roughly outside (8,6)
    x88 = 0x402199999999999A
    y66 = 0x401A666666666666
    ny66 = 0xC01A666666666666
    CAD_Sketch.AddLine(sk2, x88, y66, x16, y6)
    CAD_Sketch.AddLine(sk2, x16, y6, x16, ny6)
    CAD_Sketch.AddLine(sk2, x16, ny6, x88, ny66)
    nprof2 = CAD_Sketch.PrepareExtrude(sk2)
    IfCondition LessThan(nprof2, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL freehand-ish attach\n", 25)
        SystemCall(60, 1, 0, 0)
    }
    h2 = CAD_Feat.ExtrudeProfile(sk2, 0x4024000000000000)
    IfCondition EqualTo(h2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL freehand-ish extrude\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS freehand-ish rim attach\n", 29)

    // --- case 3: orphan open line + circle → still get circle profile (pad ok) ---
    sk3 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(sk3, 0, 0, 0x4024000000000000)
    CAD_Sketch.AddLine(sk3, 0x4049000000000000, 0, 0x4054000000000000, 0x4024000000000000)
    nprof3 = CAD_Sketch.PrepareExtrude(sk3)
    IfCondition LessThan(nprof3, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL orphan+circle should still yield circle profile\n", 53)
        SystemCall(60, 1, 0, 0)
    }
    h3 = CAD_Feat.ExtrudeProfile(sk3, 0x4024000000000000)
    IfCondition EqualTo(h3, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL orphan+circle pad\n", 23)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS orphan+circle still pads circle\n", 37)

    // --- case 4: pure circle alone still pads ---
    sk4 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(sk4, 0, 0, 0x4024000000000000)
    h4 = CAD_Feat.ExtrudeProfile(sk4, 0x4024000000000000)
    IfCondition EqualTo(h4, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL pure circle pad\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS pure circle pad\n", 21)

    CAD_Sys.Write(1, "CIRCLE ATTACH OK\n", 17)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
