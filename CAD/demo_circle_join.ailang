// Line through circle must get anchors at rim + split into pieces.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== circle line join ===\n", 25)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)
    sk = CAD_Sketch.CreateSketch(1)
    // line first (-10,0)-(10,0)
    ten = 0x4024000000000000
    mten = Float_Sub(0, ten)
    CAD_Sketch.AddLine(sk, mten, 0, ten, 0)
    // circle R=5 at origin via AddCircle (rebuilds+splits)
    five = 0x4014000000000000
    CAD_Sketch.AddCircle(sk, 0, 0, five)
    n = CAD_Sketch.GetPointCount(sk)
    // expect ends + 2 rim hits
    IfCondition LessThan(n, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL few anchors after AddCircle\n", 33)
        SystemCall(60, 1, 0, 0)
    }
    nl = CAD_Sketch.GetLineCount(sk)
    IfCondition LessThan(nl, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL line not split at circle\n", 30)
        SystemCall(60, 1, 0, 0)
    }
    // freehand miss: line y=0.2 through circle R=5 (still intersects)
    sk2 = CAD_Sketch.CreateSketch(1)
    y2 = 0x3FC999999999999A
    CAD_Sketch.AddLine(sk2, mten, y2, ten, y2)
    CAD_Sketch.AddCircle(sk2, 0, 0, five)
    nl2 = CAD_Sketch.GetLineCount(sk2)
    IfCondition LessThan(nl2, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL freehandish not split\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    // diagonal through circle
    sk3 = CAD_Sketch.CreateSketch(1)
    six = 0x4018000000000000
    msix = Float_Sub(0, six)
    CAD_Sketch.AddLine(sk3, msix, msix, six, six)
    CAD_Sketch.AddCircle(sk3, 0, 0, five)
    nl3 = CAD_Sketch.GetLineCount(sk3)
    IfCondition LessThan(nl3, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL diagonal not split at circle\n", 34)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "CIRCLE JOIN OK\n", 15)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
