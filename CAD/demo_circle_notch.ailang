// V + Arc3 scoop + circle on left leg → profile must include notch cleanly
// (no double-edge / zero-area digon from Cos≠line-hit gap)
LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    PrintMessage("=== circle notch on scoop ===\n")
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    sk = CAD_Sketch.CreateSketch(1)
    // V (-10,20)-(0,0)-(10,20)
    CAD_Sketch.AddLine(sk, 0xC024000000000000, 0x4034000000000000, 0, 0)
    CAD_Sketch.AddLine(sk, 0x4024000000000000, 0x4034000000000000, 0, 0)
    CAD_Sketch.Arc3Pend(0xC024000000000000, 0x4034000000000000, 0, 0x403C000000000000, 0x4024000000000000, 0x4034000000000000)
    CAD_Sketch.Arc3Point(sk)
    // circle on left leg mid-ish: center ~ (-5,10), R=3 so it bites into the V
    // left line (-10,20)-(0,0): point at t=0.5 is (-5,10)
    CAD_Sketch.AddCircle(sk, 0xC014000000000000, 0x4024000000000000, 0x4008000000000000)

    PrintMessage("live nl=")
    PrintNumber(CAD_Sketch.GetLineCount(sk))
    PrintMessage(" na=")
    PrintNumber(CAD_Sketch.GetArcCount(sk))
    PrintMessage(" nc=")
    PrintNumber(CAD_Sketch.GetCircleCount(sk))
    PrintMessage("\n")

    // project like CA_RebuildProfiles
    cl = CAD_Sketch.CreateSketch(1)
    nl = CAD_Sketch.GetLineCount(sk)
    lines = CAD_Store.Read(sk, 1)
    i = 0
    WhileLoop LessThan(i, nl) {
        b = Multiply(i, 4)
        CAD_Sketch.AddLine(cl, ArrayGet(lines, b), ArrayGet(lines, Add(b, 1)), ArrayGet(lines, Add(b, 2)), ArrayGet(lines, Add(b, 3)))
        i = Add(i, 1)
    }
    na = CAD_Sketch.GetArcCount(sk)
    arcs = CAD_Store.Read(sk, 11)
    i = 0
    WhileLoop LessThan(i, na) {
        b = Multiply(i, 5)
        CAD_Sketch.AddArc(cl, ArrayGet(arcs, b), ArrayGet(arcs, Add(b, 1)), ArrayGet(arcs, Add(b, 2)), ArrayGet(arcs, Add(b, 3)), ArrayGet(arcs, Add(b, 4)))
        i = Add(i, 1)
    }
    nc = CAD_Sketch.GetCircleCount(sk)
    circs = CAD_Store.Read(sk, 8)
    i = 0
    WhileLoop LessThan(i, nc) {
        b = Multiply(i, 3)
        CAD_Sketch.AddCircle(cl, ArrayGet(circs, b), ArrayGet(circs, Add(b, 1)), ArrayGet(circs, Add(b, 2)))
        i = Add(i, 1)
    }
    CAD_Sketch.SnapArcEndsToSketch(cl, 0)
    CAD_Sketch.TessellateArcs(cl, 96)
    CAD_Sketch.TessellateCircles(cl, 48)
    CAD_Store.Write(cl, 7, 0)
    CAD_Sketch.SnapNearEndpoints(cl, 0)
    n = CAD_Sketch.BuildAllClosedLoops(cl)
    PrintMessage("nprof=")
    PrintNumber(n)
    PrintMessage(" final nl=")
    PrintNumber(CAD_Store.Read(cl, 0))
    PrintMessage("\n")

    xy = Allocate(65536)
    pi = 0
    best_a = 0
    best_i = 0
    WhileLoop LessThan(pi, n) {
        nn = CAD_Sketch.GetProfileXY(cl, pi, xy)
        ar = CAD_Sketch.LoopSignedArea(xy, nn)
        IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
        PrintMessage("prof ")
        PrintNumber(pi)
        PrintMessage(" nn=")
        PrintNumber(nn)
        PrintMessage(" area=")
        PrintNumber(Float_ToInt(ar))
        PrintMessage("\n")
        // min edge length + count of very short edges (double-line symptom)
        min_e = 0x47EFFFFFE0000000
        n_short = 0
        k = 0
        WhileLoop LessThan(k, nn) {
            j = Add(k, 1)
            IfCondition EqualTo(j, nn) ThenBlock: { j = 0 }
            dx = Float_Sub(ArrayGet(xy, Multiply(j, 2)), ArrayGet(xy, Multiply(k, 2)))
            dy = Float_Sub(ArrayGet(xy, Add(Multiply(j, 2), 1)), ArrayGet(xy, Add(Multiply(k, 2), 1)))
            el = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
            IfCondition EqualTo(Float_Le(el, min_e), 1) ThenBlock: { min_e = el }
            // short < 0.05
            IfCondition EqualTo(Float_Le(el, 0x3FA999999999999A), 1) ThenBlock: {
                n_short = Add(n_short, 1)
            }
            k = Add(k, 1)
        }
        PrintMessage("  min_edge milli=")
        PrintNumber(Float_ToInt(Float_Mul(min_e, 0x408F400000000000)))
        PrintMessage(" n_short=")
        PrintNumber(n_short)
        PrintMessage("\n")
        IfCondition EqualTo(Float_Le(best_a, ar), 1) ThenBlock: {
            best_a = ar
            best_i = pi
        }
        pi = Add(pi, 1)
    }

    // scoop alone ~319; with circle on leg outer envelope ~333 or notched ~300+
    IfCondition LessThan(n, 1) ThenBlock: {
        PrintMessage("FAIL no profile with circle notch\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(Float_Le(best_a, Float_FromInt(250)), 1) ThenBlock: {
        PrintMessage("FAIL outer area too small (join/tol digon?)\n")
        SystemCall(60, 1, 0, 0)
    }
    // outer must not be a micro digon full of zero-length edges
    nn = CAD_Sketch.GetProfileXY(cl, best_i, xy)
    n_short = 0
    k = 0
    WhileLoop LessThan(k, nn) {
        j = Add(k, 1)
        IfCondition EqualTo(j, nn) ThenBlock: { j = 0 }
        dx = Float_Sub(ArrayGet(xy, Multiply(j, 2)), ArrayGet(xy, Multiply(k, 2)))
        dy = Float_Sub(ArrayGet(xy, Add(Multiply(j, 2), 1)), ArrayGet(xy, Add(Multiply(k, 2), 1)))
        el = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(Float_Le(el, 0x3F847AE147AE147B), 1) ThenBlock: {
            n_short = Add(n_short, 1)
        }
        k = Add(k, 1)
    }
    // allow a few micro edges; digon junk had 20+
    IfCondition GreaterThan(n_short, 5) ThenBlock: {
        PrintMessage("FAIL too many micro edges on outer\n")
        SystemCall(60, 1, 0, 0)
    }
    PrintMessage("PASS circle notch outer area=")
    PrintNumber(Float_ToInt(best_a))
    PrintMessage(" nn=")
    PrintNumber(nn)
    PrintMessage("\n")
    Deallocate(xy, 65536)
    PrintMessage("CIRCLE NOTCH OK\n")
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
