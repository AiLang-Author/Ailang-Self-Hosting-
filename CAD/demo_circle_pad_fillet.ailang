// Sketch circle → extrude must stay CIRCLE (not 32-gon prism).
// Convex top-rim fillet keeps circles + cylinder + torus (not a lathe n-gon).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Blend

SubRoutine.Main {
    CAD_Sys.Write(1, "=== circle pad fillet ===\n", 26)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n15 = 0x402E000000000000
    n20 = 0x4034000000000000
    n2 = 0x4000000000000000
    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(hsk, 0, 0, n15)
    h = CAD_Feat.ExtrudeProfile(hsk, n20)
    PrintMessage("pad=")
    PrintNumber(h)
    PrintMessage("\n")
    pass = 0
    ncirc = 0
    IfCondition NotEqual(h, 0) ThenBlock: {
        edges = Allocate(1024)
        ne = CAD_Topo.SolidCollectEdges(h, edges, 32)
        found = 0
        i = 0
        WhileLoop LessThan(i, ne) {
            ed = ArrayGet(edges, i)
            crv = CAD_Store.Read(ed, 2)
            IfCondition NotEqual(crv, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(crv, 0), 2) ThenBlock: {
                    ncirc = Add(ncirc, 1)
                    va = CAD_Store.Read(ed, 0)
                    IfCondition NotEqual(va, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 1) ThenBlock: {
                            found = ed
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        PrintMessage("ncirc=")
        PrintNumber(ncirc)
        PrintMessage(" top=")
        PrintNumber(found)
        PrintMessage("\n")
        fil = 0
        IfCondition NotEqual(found, 0) ThenBlock: {
            fil = CAD_Blend.FilletEdge(h, found, n2)
        }
        PrintMessage("fillet=")
        PrintNumber(fil)
        PrintMessage("\n")
        IfCondition NotEqual(fil, 0) ThenBlock: {
            ncirc = 0
            nline = 0
            ne = CAD_Topo.SolidCollectEdges(fil, edges, 32)
            i = 0
            WhileLoop LessThan(i, ne) {
                ed = ArrayGet(edges, i)
                crv = CAD_Store.Read(ed, 2)
                IfCondition NotEqual(crv, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(crv, 0), 2) ThenBlock: { ncirc = Add(ncirc, 1) }
                    IfCondition EqualTo(CAD_Store.Read(crv, 0), 1) ThenBlock: { nline = Add(nline, 1) }
                }
                i = Add(i, 1)
            }
            PrintMessage("after ncirc=")
            PrintNumber(ncirc)
            PrintMessage(" nline=")
            PrintNumber(nline)
            PrintMessage(" ne=")
            PrintNumber(ne)
            PrintMessage("\n")
            // Analytic fillet: 3 circles + 1 meridian arc + 1 generator line.
            // Lathe n-gon had dozens of line edges and zero circles.
            IfCondition GreaterEqual(ncirc, 3) ThenBlock: {
                IfCondition LessThan(ne, 10) ThenBlock: { pass = 1 }
            }
        }
        Deallocate(edges, 1024)
    }
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "CIRCLE PAD FILLET PASS\n", 23)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "CIRCLE PAD FILLET FAIL\n", 23)
    }
    SystemCall(60, Subtract(1, pass), 0, 0)
}
RunTask(Main)
