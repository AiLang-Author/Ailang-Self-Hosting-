// Counterbore: pilot through + shallow large coaxial cut → nested shell → STEP walk.
// Topology: annular floor, pilot wall only below floor (no thin wall). No STEP recipe.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== counterbore B-Rep STEP ===\n", 31)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    // plate 40 x 40 x 12
    dx = 0x4044000000000000
    dy = 0x4044000000000000
    dz = 0x4028000000000000
    body = CAD_Script.CreateBox(dx, dy, dz)
    pack = Allocate(48)
    tool_out = Allocate(16)
    // pilot dia 6 depth 12 (through) at (20, 20)
    ArraySet(pack, 0, 0x4018000000000000)
    ArraySet(pack, 1, 0x4028000000000000)
    ArraySet(pack, 2, 0x4034000000000000)
    ArraySet(pack, 3, 0x4034000000000000)
    cut = CAD_Feat.CreateHole(body, pack, tool_out)
    // counterbore dia 12 depth 4 same center
    ArraySet(pack, 0, 0x4028000000000000)
    ArraySet(pack, 1, 0x4010000000000000)
    ArraySet(pack, 2, 0x4034000000000000)
    ArraySet(pack, 3, 0x4034000000000000)
    cut2 = CAD_Feat.CreateHole(cut, pack, tool_out)
    IfCondition EqualTo(cut2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL c'bore cut\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Store.Read(cut2, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL c'bore no shell\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(cut2, "test-stl/cad_counterbore.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL c'bore STEP\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote counterbore.stp (nested B-Rep walk)\n", 42)
    Deallocate(pack, 48)
    Deallocate(tool_out, 16)
    CAD_Sys.Write(1, "CBORE BREP OK\n", 14)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
