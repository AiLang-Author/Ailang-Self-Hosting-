// Crossing overdrawn triangle must project a closed profile after split.
// Mimics freehand X-cross at vertices (no shared endpoints until split).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== cross overshoot close ===\n", 31)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    // exact closed triangle first
    sk0 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk0, 0, 0, 0x4024000000000000, 0)
    CAD_Sketch.AddLine(sk0, 0x4024000000000000, 0, 0x4014000000000000, 0x4020000000000000)
    CAD_Sketch.AddLine(sk0, 0x4014000000000000, 0x4020000000000000, 0, 0)
    n0p = CAD_Sketch.BuildAllClosedLoops(sk0)
    IfCondition LessThan(n0p, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL exact triangle\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS exact triangle\n", 20)

    sk = CAD_Sketch.CreateSketch(1)
    // Overshoot triangle A(0,0) B(10,0) C(5,8)
    // AB: (-1,0)-(11,0)
    CAD_Sketch.AddLine(sk, 0xBFF0000000000000, 0, 0x4026000000000000, 0)
    // BC: (11,-1.6)-(4,9.6)
    CAD_Sketch.AddLine(sk, 0x4026000000000000, 0xBFF999999999999A, 0x4010000000000000, 0x4023333333333333)
    // CA: (6,9.6)-(-1,-1.6)
    CAD_Sketch.AddLine(sk, 0x4018000000000000, 0x4023333333333333, 0xBFF0000000000000, 0xBFF999999999999A)

    n0 = CAD_Sketch.GetLineCount(sk)
    CAD_Sketch.SplitAtIntersections(sk)
    n1 = CAD_Sketch.GetLineCount(sk)
    IfCondition LessEqual(n1, n0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL split did not increase segments\n", 37)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS split at crossings\n", 24)

    CAD_Sketch.PruneOpenStubs(sk, 0)
    n2 = CAD_Sketch.GetLineCount(sk)
    // after prune expect 3 core edges (or a few)
    IfCondition LessThan(n2, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL prune removed too much\n", 28)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS prune kept core\n", 21)

    nprof = CAD_Sketch.BuildAllClosedLoops(sk)
    IfCondition LessThan(nprof, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no closed profile from overshoot tri\n", 42)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS closed profile from overshoot tri\n", 39)

    // arc + line: tessellate arc then close with lines
    sk2 = CAD_Sketch.CreateSketch(1)
    // semicircle center (5,5) R=5 from 0 to pi, then chord
    CAD_Sketch.AddArc(sk2, 0x4014000000000000, 0x4014000000000000, 0x4014000000000000, 0, 0x400921FB54442D18)
    CAD_Sketch.TessellateArcs(sk2, 16)
    // chord from left to right of semicircle: (0,5)-(10,5)
    CAD_Sketch.AddLine(sk2, 0, 0x4014000000000000, 0x4024000000000000, 0x4014000000000000)
    CAD_Sketch.SplitAtIntersections(sk2)
    n2 = CAD_Sketch.BuildAllClosedLoops(sk2)
    IfCondition LessThan(n2, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL arc+chord no profile\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS arc+chord closed profile\n", 30)

    CAD_Sys.Write(1, "CROSS CLOSE OK\n", 15)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
