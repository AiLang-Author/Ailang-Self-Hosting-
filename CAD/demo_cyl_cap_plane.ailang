// After RebuildKind0Planes, cylinder caps must keep a non-zero normal.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "cyl cap plane\n", 14)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    r = Float_FromInt(25)
    hgt = Float_FromInt(20)
    out = Allocate(16)
    h = CAD_Topo.MakeCylinderSolid(r, hgt, out)
    CAD_Topo.RebuildKind0Planes(h)
    pl = Allocate(128)
    sh = CAD_Store.Read(h, 0)
    face = CAD_Store.Read(sh, 0)
    npl = 0
    ndeg = 0
    nf = 0
    WhileLoop NotEqual(face, 0) {
        nf = Add(nf, 1)
        rc = CAD_Topo.FaceGetPlane(face, pl)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            npl = Add(npl, 1)
            nx = ArrayGet(pl, 10)
            ny = ArrayGet(pl, 11)
            nz = ArrayGet(pl, 12)
            ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(nz, nz)))
            IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: {
                ndeg = Add(ndeg, 1)
            }
        }
        face = CAD_Store.Read(face, 3)
    }
    PrintMessage("faces=")
    PrintNumber(nf)
    PrintMessage(" planar=")
    PrintNumber(npl)
    PrintMessage(" degN=")
    PrintNumber(ndeg)
    PrintMessage("\n")
    sk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(sk, 0, 0, r)
    h2 = CAD_Feat.ExtrudeProfile(sk, hgt)
    CAD_Topo.RebuildKind0Planes(h2)
    sh = CAD_Store.Read(h2, 0)
    face = CAD_Store.Read(sh, 0)
    npl2 = 0
    ndeg2 = 0
    WhileLoop NotEqual(face, 0) {
        rc = CAD_Topo.FaceGetPlane(face, pl)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            npl2 = Add(npl2, 1)
            nx = ArrayGet(pl, 10)
            ny = ArrayGet(pl, 11)
            nz = ArrayGet(pl, 12)
            ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(nz, nz)))
            IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: {
                ndeg2 = Add(ndeg2, 1)
            }
        }
        face = CAD_Store.Read(face, 3)
    }
    PrintMessage("extrude planar=")
    PrintNumber(npl2)
    PrintMessage(" degN=")
    PrintNumber(ndeg2)
    PrintMessage("\n")
    // Map onto z=20 plane (box top). Cap origin Z must move off 20.
    fr = Allocate(128)
    zi = 0
    WhileLoop LessThan(zi, 12) {
        ArraySet(fr, zi, 0)
        zi = Add(zi, 1)
    }
    ArraySet(fr, 2, Float_FromInt(20))
    ArraySet(fr, 3, 0x3FF0000000000000)
    ArraySet(fr, 7, 0x3FF0000000000000)
    ArraySet(fr, 11, 0x3FF0000000000000)
    CAD_Topo.MapSolidByFrame(h2, fr)
    sh = CAD_Store.Read(h2, 0)
    face = CAD_Store.Read(sh, 0)
    zmax = 0
    WhileLoop NotEqual(face, 0) {
        rc = CAD_Topo.FaceGetPlane(face, pl)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            oz = ArrayGet(pl, 3)
            IfCondition EqualTo(CAD_Num.Le(zmax, oz), 1) ThenBlock: { zmax = oz }
        }
        face = CAD_Store.Read(face, 3)
    }
    PrintMessage("mapped cap z=")
    PrintNumber(Float_ToInt(zmax))
    PrintMessage("\n")
    pass = 0
    IfCondition EqualTo(ndeg, 0) ThenBlock: {
        IfCondition EqualTo(ndeg2, 0) ThenBlock: {
            IfCondition GreaterEqual(npl, 2) ThenBlock: {
                IfCondition GreaterEqual(Float_ToInt(zmax), 35) ThenBlock: { pass = 1 }
            }
        }
    }
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "CYL CAP PLANE PASS\n", 19)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "CYL CAP PLANE FAIL\n", 19)
    }
    Deallocate(pl, 128)
    Deallocate(out, 16)
    SystemCall(60, Subtract(1, pass), 0, 0)
}
RunTask(Main)
