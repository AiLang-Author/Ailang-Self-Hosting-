// Diagnose circle-pad GlueOnFace vs the interactive JOIN miss.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_Tess

SubRoutine.Main {
    CAD_Sys.Write(1, "=== cyl glue diag ===\n", 22)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n50 = 0x4049000000000000
    n25 = 0x4039000000000000
    n20 = 0x4034000000000000
    n0 = 0
    one = 0x3FF0000000000000
    xy = Allocate(64)
    ArraySet(xy, 0, Float_Sub(n0, n50))
    ArraySet(xy, 1, Float_Sub(n0, n50))
    ArraySet(xy, 2, n50)
    ArraySet(xy, 3, Float_Sub(n0, n50))
    ArraySet(xy, 4, n50)
    ArraySet(xy, 5, n50)
    ArraySet(xy, 6, Float_Sub(n0, n50))
    ArraySet(xy, 7, n50)
    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, xy, 4)
    host = CAD_Feat.ExtrudeProfile(hsk, n20)
    CAD_Topo.RebuildKind0Planes(host)
    tsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(tsk, n0, n0, n25)
    tool = CAD_Feat.ExtrudeProfile(tsk, n20)
    PrintMessage("host=")
    PrintNumber(host)
    PrintMessage(" hkind=")
    PrintNumber(CAD_Store.Read(host, 3))
    PrintMessage(" hfaces=")
    PrintNumber(CAD_Topo.SolidCountFaces(host))
    PrintMessage(" tool=")
    PrintNumber(tool)
    PrintMessage(" tkind=")
    PrintNumber(CAD_Store.Read(tool, 3))
    PrintMessage(" tfaces=")
    PrintNumber(CAD_Topo.SolidCountFaces(tool))
    PrintMessage("\n")
    // Path A: TranslateSolid like demo_glue_cyl
    dlt = Allocate(32)
    ArraySet(dlt, 0, n0)
    ArraySet(dlt, 1, n0)
    ArraySet(dlt, 2, n20)
    CAD_Topo.TranslateSolid(tool, dlt)
    Deallocate(dlt, 32)
    pl = Allocate(128)
    tf = CAD_Store.Read(CAD_Store.Read(tool, 0), 0)
    tfi = 0
    WhileLoop NotEqual(tf, 0) {
        lp = CAD_Store.Read(tf, 1)
        ov = 0
        nce = 0
        IfCondition NotEqual(lp, 0) ThenBlock: {
            hd = CAD_Store.Read(lp, 0)
            IfCondition NotEqual(hd, 0) ThenBlock: {
                ov = CAD_Store.Read(hd, 5)
                nce = CAD_Topo.LoopCountCoedges(lp)
            }
        }
        prc = CAD_Topo.FaceGetPlane(tf, pl)
        PrintMessage(" tface=")
        PrintNumber(tfi)
        PrintMessage(" getpl=")
        PrintNumber(prc)
        PrintMessage(" nce=")
        PrintNumber(nce)
        surf = CAD_Store.Read(tf, 0)
        PrintMessage(" skind=")
        IfCondition NotEqual(surf, 0) ThenBlock: {
            PrintNumber(CAD_Store.Read(surf, 0))
        }
        PrintMessage(" s4=")
        IfCondition NotEqual(surf, 0) ThenBlock: {
            PrintNumber(Float_ToInt(Float_Mul(CAD_Store.Read(surf, 4), 0x4059000000000000)))
        }
        PrintMessage(" s7=")
        IfCondition NotEqual(surf, 0) ThenBlock: {
            PrintNumber(Float_ToInt(Float_Mul(CAD_Store.Read(surf, 7), 0x4059000000000000)))
        }
        PrintMessage(" s8=")
        IfCondition NotEqual(surf, 0) ThenBlock: {
            PrintNumber(Float_ToInt(Float_Mul(CAD_Store.Read(surf, 8), 0x4059000000000000)))
        }
        PrintMessage(" s10=")
        IfCondition NotEqual(surf, 0) ThenBlock: {
            PrintNumber(Float_ToInt(Float_Mul(CAD_Store.Read(surf, 10), 0x4059000000000000)))
        }
        PrintMessage(" s11=")
        IfCondition NotEqual(surf, 0) ThenBlock: {
            PrintNumber(Float_ToInt(Float_Mul(CAD_Store.Read(surf, 11), 0x4059000000000000)))
        }
        PrintMessage(" s12=")
        IfCondition NotEqual(surf, 0) ThenBlock: {
            PrintNumber(Float_ToInt(Float_Mul(CAD_Store.Read(surf, 12), 0x4059000000000000)))
        }
        PrintMessage(" oz=")
        PrintNumber(Float_ToInt(ArrayGet(pl, 3)))
        PrintMessage(" vz=")
        IfCondition NotEqual(ov, 0) ThenBlock: {
            PrintNumber(Float_ToInt(CAD_Store.Read(ov, 2)))
        }
        PrintMessage("\n")
        tf = CAD_Store.Read(tf, 3)
        tfi = Add(tfi, 1)
    }
    hf = CAD_Store.Read(CAD_Store.Read(host, 0), 0)
    hfi = 0
    WhileLoop NotEqual(hf, 0) {
        prc = CAD_Topo.FaceGetPlane(hf, pl)
        PrintMessage(" hface=")
        PrintNumber(hfi)
        PrintMessage(" getpl=")
        PrintNumber(prc)
        PrintMessage(" nz=")
        PrintNumber(Float_ToInt(Float_Mul(ArrayGet(pl, 12), 0x4059000000000000)))
        PrintMessage(" oz=")
        PrintNumber(Float_ToInt(ArrayGet(pl, 3)))
        PrintMessage("\n")
        hf = CAD_Store.Read(hf, 3)
        hfi = Add(hfi, 1)
    }
    hf = CAD_Store.Read(CAD_Store.Read(host, 0), 0)
    hfn = 0
    WhileLoop NotEqual(hf, 0) {
        tf = CAD_Store.Read(CAD_Store.Read(tool, 0), 0)
        tfn = 0
        WhileLoop NotEqual(tf, 0) {
            prc = CAD_Bool.FacesGluePair(hf, tf)
            PrintMessage(" pair h=")
            PrintNumber(hfn)
            PrintMessage(" t=")
            PrintNumber(tfn)
            PrintMessage(" rc=")
            PrintNumber(prc)
            PrintMessage(" why=")
            PrintNumber(CAD_Bool_Glue.why)
            PrintMessage(" nv=")
            PrintNumber(CAD_Bool_Glue.nv)
            PrintMessage(" doti=")
            PrintNumber(CAD_Bool_Glue.doti)
            PrintMessage(" cerr=")
            PrintNumber(Float_ToInt(CAD_Bool_Glue.cerr))
            PrintMessage("\n")
            tf = CAD_Store.Read(tf, 3)
            tfn = Add(tfn, 1)
        }
        hf = CAD_Store.Read(hf, 3)
        hfn = Add(hfn, 1)
    }
    glued = CAD_Bool.GlueOnFace(host, tool)
    PrintMessage("glueA=")
    PrintNumber(glued)
    IfCondition NotEqual(glued, 0) ThenBlock: {
        PrintMessage(" shells=")
        PrintNumber(CAD_Topo.SolidCountShells(glued))
        PrintMessage(" faces=")
        PrintNumber(CAD_Topo.SolidCountFaces(glued))
        PrintMessage(" inner=")
        PrintNumber(CAD_Topo.SolidHasInnerLoop(glued))
    }
    PrintMessage("\n")
    // Path B: MapSolidByFrame like the app (fresh tool, no translate)
    tsk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(tsk2, n0, n0, n25)
    tool2 = CAD_Feat.ExtrudeProfile(tsk2, n20)
    fr = Allocate(128)
    ArraySet(fr, 0, n0)
    ArraySet(fr, 1, n0)
    ArraySet(fr, 2, n20)
    ArraySet(fr, 3, one)
    ArraySet(fr, 4, n0)
    ArraySet(fr, 5, n0)
    ArraySet(fr, 6, n0)
    ArraySet(fr, 7, one)
    ArraySet(fr, 8, n0)
    ArraySet(fr, 9, n0)
    ArraySet(fr, 10, n0)
    ArraySet(fr, 11, one)
    CAD_Topo.MapSolidByFrame(tool2, fr)
    CAD_Topo.SnapSolidToFrame(tool2, fr)
    CAD_Topo.RebuildKind0Planes(tool2)
    Deallocate(fr, 128)
    host2 = CAD_Feat.ExtrudeProfile(hsk, n20)
    CAD_Topo.RebuildKind0Planes(host2)
    hf = CAD_Store.Read(CAD_Store.Read(host2, 0), 0)
    hfn = 0
    WhileLoop NotEqual(hf, 0) {
        tf = CAD_Store.Read(CAD_Store.Read(tool2, 0), 0)
        tfn = 0
        WhileLoop NotEqual(tf, 0) {
            prc = CAD_Bool.FacesGluePair(hf, tf)
            PrintMessage(" map pair h=")
            PrintNumber(hfn)
            PrintMessage(" t=")
            PrintNumber(tfn)
            PrintMessage(" rc=")
            PrintNumber(prc)
            PrintMessage(" why=")
            PrintNumber(CAD_Bool_Glue.why)
            PrintMessage(" nv=")
            PrintNumber(CAD_Bool_Glue.nv)
            PrintMessage(" doti=")
            PrintNumber(CAD_Bool_Glue.doti)
            PrintMessage(" cerr=")
            PrintNumber(Float_ToInt(CAD_Bool_Glue.cerr))
            PrintMessage("\n")
            tf = CAD_Store.Read(tf, 3)
            tfn = Add(tfn, 1)
        }
        hf = CAD_Store.Read(hf, 3)
        hfn = Add(hfn, 1)
    }
    glued2 = CAD_Bool.GlueOnFace(host2, tool2)
    PrintMessage("glueB=")
    PrintNumber(glued2)
    IfCondition NotEqual(glued2, 0) ThenBlock: {
        PrintMessage(" shells=")
        PrintNumber(CAD_Topo.SolidCountShells(glued2))
        PrintMessage(" faces=")
        PrintNumber(CAD_Topo.SolidCountFaces(glued2))
        PrintMessage(" inner=")
        PrintNumber(CAD_Topo.SolidHasInnerLoop(glued2))
    }
    PrintMessage("\n")
    pass = 0
    IfCondition NotEqual(glued, 0) ThenBlock: {
        IfCondition EqualTo(CAD_Topo.SolidCountShells(glued), 1) ThenBlock: { pass = 1 }
    }
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "CYL GLUE DIAG PASS\n", 19)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "CYL GLUE DIAG FAIL\n", 19)
    }
    Deallocate(pl, 128)
    Deallocate(xy, 64)
    SystemCall(60, Subtract(1, pass), 0, 0)
}
RunTask(Main)
