// Circle outer + triangle hole via ExtrudeContours. Prints topology + mesh.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== cyl + triangle hole ===\n", 29)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = 0x4034000000000000
    r = 0x4049000000000000
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddArc(0, 0, r, 0, 0x401921FB54442D18)
    s = 0x4034000000000000
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddLine(0, s, Float_Sub(0, s), Float_Sub(0, s))
    CAD_Topo.SweepAddLine(Float_Sub(0, s), Float_Sub(0, s), s, Float_Sub(0, s))
    CAD_Topo.SweepAddLine(s, Float_Sub(0, s), 0, s)
    PrintMessage("ncont=")
    PrintNumber(CAD_Topo_Sweep.ncont)
    PrintMessage("\n")

    h = CAD_Topo.ExtrudeContours()
    PrintMessage("solid=")
    PrintNumber(h)
    PrintMessage(" kind=")
    IfCondition NotEqual(h, 0) ThenBlock: {
        PrintNumber(CAD_Store.Read(h, 3))
    }
    PrintMessage("\n")
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }

    sh = CAD_Store.Read(h, 0)
    fi = 0
    WhileLoop NotEqual(sh, 0) {
        fc = CAD_Store.Read(sh, 0)
        WhileLoop NotEqual(fc, 0) {
            lp = CAD_Store.Read(fc, 1)
            nce = 0
            inn = 0
            IfCondition NotEqual(lp, 0) ThenBlock: {
                nce = CAD_Topo.LoopCountCoedges(lp)
                inn = CAD_Store.Read(lp, 2)
            }
            ni = 0
            IfCondition NotEqual(inn, 0) ThenBlock: {
                ni = CAD_Topo.LoopCountCoedges(inn)
            }
            PrintMessage("face ")
            PrintNumber(fi)
            PrintMessage(" nce=")
            PrintNumber(nce)
            PrintMessage(" inner_nce=")
            PrintNumber(ni)
            PrintMessage("\n")
            fi = Add(fi, 1)
            fc = CAD_Store.Read(fc, 3)
            IfCondition GreaterThan(fi, 32) ThenBlock: { fc = 0 }
        }
        sh = 0
    }

    mesh = Allocate(32)
    CAD_Tess.MeshSolid(h, 0x3FB999999999999A, mesh)
    PrintMessage("mesh nt=")
    PrintNumber(ArrayGet(mesh, 1))
    PrintMessage(" nv=")
    PrintNumber(ArrayGet(mesh, 0))
    PrintMessage("\n")
    CAD_Sys.Write(1, "DONE\n", 5)
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
