// DXF CIRCLE R=10 → analytic cylinder extrude H=20 → STEP
// Input:  test-stl/test-dxf-files/circle_r10.dxf
// Output: test-stl/cad_dxf_circle.stp
// FreeCAD: cylinder diameter 20, height 20.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== DXF CIRCLE extrude ===\n", 28)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    out_sk = Allocate(8)
    rc = CAD_DXF.ImportFile("test-stl/test-dxf-files/circle_r10.dxf", out_sk)
    IfCondition NotEqual(rc, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL DXF import\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    h_sk = ArrayGet(out_sk, 0)
    nc = CAD_Sketch.GetCircleCount(h_sk)
    IfCondition NotEqual(nc, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected 1 circle\n", 23)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "DXF CIRCLE ok\n", 14)

    // H = 20
    h = CAD_Feat.ExtrudeProfile(h_sk, 0x4034000000000000)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(h, "test-stl/cad_dxf_circle.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL STEP\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote cad_dxf_circle.stp\n", 25)
    CAD_Sys.Write(1, "expect: cyl R=10 H=20 (analytic CIRCLE+CYL)\n", 45)
    CAD_Sys.Write(1, "DXF CIRCLE EXTRUDE OK\n", 22)
    Deallocate(out_sk, 8)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
