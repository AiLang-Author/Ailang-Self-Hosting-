// Step 1 look-at: DXF 10×10 square → extrude 10 mm → 10 mm cube STEP.
// Input:  test-stl/test-dxf-files/square_10.dxf
// Output: test-stl/cad_dxf_cube.stp
// FreeCAD: open STEP, measure edges = 10 mm.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== DXF square -> 10mm cube ===\n", 34)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    out_sk = Allocate(8)
    rc = CAD_DXF.ImportFile("test-stl/test-dxf-files/square_10.dxf", out_sk)
    IfCondition NotEqual(rc, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL DXF import\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    h_sk = ArrayGet(out_sk, 0)
    nl = CAD_Sketch.GetLineCount(h_sk)
    np = CAD_Sketch.GetLoopCount(h_sk)
    IfCondition NotEqual(nl, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected 4 lines\n", 22)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(np, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected 4 loop verts\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "DXF: 4 lines, closed square ok\n", 32)

    // height = 10.0
    h_so = CAD_Feat.ExtrudeProfile(h_sk, 0x4024000000000000)
    IfCondition EqualTo(h_so, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(h_so, "test-stl/cad_dxf_cube.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL STEP\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote test-stl/cad_dxf_cube.stp\n", 32)
    CAD_Sys.Write(1, "expect: 10x10x10 cube, 6 planar faces\n", 39)
    CAD_Sys.Write(1, "DXF CUBE OK\n", 12)
    Deallocate(out_sk, 8)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
