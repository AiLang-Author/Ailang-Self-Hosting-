// DXF elongated diamond (rhombus, NOT a rotated square) → poly prism → STEP
// Profile XY: (0,15)-(30,30)-(60,15)-(30,0)  diags 60×30, rhombus (not a square)
// Extrude H=25 mm — tall enough to not look like a thin plate.
// Look-at: test-stl/cad_dxf_diamond.stp  (top = diamond, not axis-aligned box)
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== DXF elongated diamond extrude ===\n", 39)
    CAD_Sys.Write(1, "profile diags 60x30 rhombus H=25\n", 33)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)
    out_sk = Allocate(8)
    rc = CAD_DXF.ImportFile("test-stl/test-dxf-files/diamond_2d.dxf", out_sk)
    IfCondition NotEqual(rc, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL DXF import\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    h_sk = ArrayGet(out_sk, 0)
    nl = CAD_Sketch.GetLineCount(h_sk)
    np = CAD_Sketch.GetLoopCount(h_sk)
    IfCondition NotEqual(nl, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected 4 lines\n", 22)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(np, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected 4 loop verts\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "DXF loop 4 verts ok\n", 20)
    // height 25.0
    h = CAD_Feat.ExtrudeProfile(h_sk, 0x4039000000000000)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(h, "test-stl/cad_dxf_diamond.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL STEP\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote cad_dxf_diamond.stp\n", 26)
    CAD_Sys.Write(1, "expect: elongated diamond prism H=25, not a box\n", 49)
    CAD_Sys.Write(1, "DXF DIAMOND EXTRUDE OK\n", 23)
    Deallocate(out_sk, 8)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
