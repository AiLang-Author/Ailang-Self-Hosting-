// Old-school door escutcheon: rectangular plate + flared keyhole through-cut.
// Outer:  test-stl/test-dxf-files/escutcheon_plate.dxf  (70×100 mm)
// Hole:   test-stl/test-dxf-files/keyhole_flared.dxf   (~45 LINE tess)
// Output: test-stl/cad_dxf_escutcheon.stp  thickness 4 mm
// FreeCAD: plate with keyhole silhouette cut through (not a solid keyhole).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== DXF door escutcheon ===\n", 29)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    out_pl = Allocate(8)
    out_kh = Allocate(8)
    rc = CAD_DXF.ImportFile("test-stl/test-dxf-files/escutcheon_plate.dxf", out_pl)
    IfCondition NotEqual(rc, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL plate DXF\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    rc = CAD_DXF.ImportFile("test-stl/test-dxf-files/keyhole_flared.dxf", out_kh)
    IfCondition NotEqual(rc, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL keyhole DXF\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    h_pl = ArrayGet(out_pl, 0)
    h_kh = ArrayGet(out_kh, 0)
    np = CAD_Sketch.GetLoopCount(h_pl)
    nk = CAD_Sketch.GetLoopCount(h_kh)
    IfCondition LessThan(np, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL plate loop\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition LessThan(nk, 10) ThenBlock: {
        CAD_Sys.Write(1, "FAIL keyhole loop\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "plate + flared keyhole ok\n", 26)

    // thickness 4.0 mm
    h = CAD_Feat.ExtrudePlateThroughHole(h_pl, h_kh, 0x4010000000000000)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL plate through hole\n", 24)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(h, "test-stl/cad_dxf_escutcheon.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL STEP\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote cad_dxf_escutcheon.stp\n", 29)
    CAD_Sys.Write(1, "ESCUTCHEON OK\n", 14)
    Deallocate(out_pl, 8)
    Deallocate(out_kh, 8)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
