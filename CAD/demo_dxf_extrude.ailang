// DXF → closed profile → extrude → STEP
// Input: test-stl/test-dxf-files/rect_40x30.dxf (4 LINEs, z=0)
// Extrude height 15 mm → box 40×30×15
// Look-at: test-stl/cad_dxf_extrude.stp

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== DXF extrude pipeline ===\n", 30)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    out_sk = Allocate(8)
    rc = CAD_DXF.ImportFile("test-stl/test-dxf-files/rect_40x30.dxf", out_sk)
    IfCondition NotEqual(rc, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL DXF import\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    h_sk = ArrayGet(out_sk, 0)
    nl = CAD_Sketch.GetLineCount(h_sk)
    np = CAD_Sketch.GetLoopCount(h_sk)
    CAD_Sys.Write(1, "DXF lines + loop ok\n", 20)
    IfCondition LessThan(np, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL closed loop\n", 17)
        SystemCall(60, 1, 0, 0)
    }

    // height 15 mm
    h_so = CAD_Feat.ExtrudeProfile(h_sk, 0x402E000000000000)
    IfCondition EqualTo(h_so, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(h_so, "test-stl/cad_dxf_extrude.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL STEP\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote cad_dxf_extrude.stp\n", 26)
    CAD_Sys.Write(1, "expect: 40x30x15 box from DXF rect\n", 36)
    CAD_Sys.Write(1, "DXF EXTRUDE OK\n", 15)
    Deallocate(out_sk, 8)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
