LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF

SubRoutine.Main {
    CAD_Sys.Write(1, "=== DXF keep arcs ===\n", 22)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)
    out_sk = Allocate(8)
    rc = CAD_DXF.ImportFile("/tmp/cad_repo_sk0.dxf", out_sk)
    IfCondition NotEqual(rc, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL import\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    h_sk = ArrayGet(out_sk, 0)
    na = CAD_Sketch.GetArcCount(h_sk)
    nl = CAD_Sketch.GetLineCount(h_sk)
    nc = CAD_Sketch.GetCircleCount(h_sk)
    PrintMessage("arcs=")
    PrintNumber(na)
    PrintMessage(" lines=")
    PrintNumber(nl)
    PrintMessage(" circs=")
    PrintNumber(nc)
    PrintMessage("\n")
    IfCondition LessThan(na, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL arcs tessellated away\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS DXF keep arcs\n", 19)
    SystemCall(60, 0, 0, 0)
}
