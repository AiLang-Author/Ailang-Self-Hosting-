// Keyhole profile DXF → extrude → STEP
// Circle R=12 (LINE tessellation) + slot width 8, depth to y=-10
// Input:  test-stl/test-dxf-files/keyhole.dxf
// Output: test-stl/cad_dxf_keyhole.stp  H=8 mm
// FreeCAD: top view keyhole silhouette; not a box.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== DXF keyhole extrude ===\n", 29)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    out_sk = Allocate(8)
    rc = CAD_DXF.ImportFile("test-stl/test-dxf-files/keyhole.dxf", out_sk)
    IfCondition NotEqual(rc, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL DXF import\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    h_sk = ArrayGet(out_sk, 0)
    nl = CAD_Sketch.GetLineCount(h_sk)
    np = CAD_Sketch.GetLoopCount(h_sk)
    IfCondition LessThan(nl, 10) ThenBlock: {
        CAD_Sys.Write(1, "FAIL too few lines\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition LessThan(np, 10) ThenBlock: {
        CAD_Sys.Write(1, "FAIL loop too small\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "DXF keyhole loop ok\n", 20)

    // height 8.0
    h = CAD_Feat.ExtrudeProfile(h_sk, 0x4020000000000000)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(h, "test-stl/cad_dxf_keyhole.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL STEP\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote cad_dxf_keyhole.stp\n", 26)
    CAD_Sys.Write(1, "KEYHOLE EXTRUDE OK\n", 19)
    Deallocate(out_sk, 8)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
