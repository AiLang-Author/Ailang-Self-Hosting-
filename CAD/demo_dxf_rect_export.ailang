// Rectangle DXF must keep four distinct corners (not all 50,50).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF

SubRoutine.Main {
    CAD_Sys.Write(1, "dxf rect export\n", 16)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n50 = Float_FromInt(50)
    n0 = 0
    nm50 = Float_Sub(n0, n50)
    sk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk, nm50, nm50, n50, nm50)
    CAD_Sketch.AddLine(sk, n50, nm50, n50, n50)
    CAD_Sketch.AddLine(sk, n50, n50, nm50, n50)
    CAD_Sketch.AddLine(sk, nm50, n50, nm50, nm50)
    rc = CAD_DXF.ExportSketch(sk, "/tmp/dxf_rect_test.dxf")
    PrintMessage("export rc=")
    PrintNumber(rc)
    PrintMessage(" nl=")
    PrintNumber(CAD_Sketch.GetLineCount(sk))
    slot = Allocate(16)
    ArraySet(slot, 0, 0)
    irc = CAD_DXF.ImportFile("/tmp/dxf_rect_test.dxf", slot)
    h2 = ArrayGet(slot, 0)
    Deallocate(slot, 16)
    PrintMessage(" import rc=")
    PrintNumber(irc)
    PrintMessage(" nl2=")
    nl2 = 0
    IfCondition NotEqual(h2, 0) ThenBlock: {
        nl2 = CAD_Sketch.GetLineCount(h2)
    }
    PrintNumber(nl2)
    PrintMessage("\n")
    fail = rc
    IfCondition NotEqual(irc, 0) ThenBlock: { fail = 1 }
    IfCondition NotEqual(nl2, 4) ThenBlock: { fail = 1 }
    SystemCall(60, fail, 0, 0)
}
RunTask(Main)
