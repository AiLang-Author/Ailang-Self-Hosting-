// Unit: earclip U-shape (concave). Expect 3 tris, no fill of notch.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Tess

SubRoutine.Main {
    CAD_Sys.Write(1, "=== earclip U ===\n", 17)
    CAD_Num.InitTolerance(0, 0)
    // U: (0,0)(1,0)(1,1)(2,1)(2,0)(3,0)(3,2)(0,2)  — 8 verts, notch open bottom-center
    // simpler: (0,0)(3,0)(3,2)(2,2)(2,1)(1,1)(1,2)(0,2) CCW outer with U notch
    v_base = Allocate(256)
    // 0:(0,0,0) 1:(3,0,0) 2:(3,2,0) 3:(2,2,0) 4:(2,1,0) 5:(1,1,0) 6:(1,2,0) 7:(0,2,0)
    pts = Allocate(64)
    // x,y pairs
    ArraySet(pts, 0, 0)
    ArraySet(pts, 1, 0)
    ArraySet(pts, 2, 0x4008000000000000)
    ArraySet(pts, 3, 0)
    ArraySet(pts, 4, 0x4008000000000000)
    ArraySet(pts, 5, 0x4000000000000000)
    ArraySet(pts, 6, 0x4000000000000000)
    ArraySet(pts, 7, 0x4000000000000000)
    ArraySet(pts, 8, 0x4000000000000000)
    ArraySet(pts, 9, 0x3FF0000000000000)
    ArraySet(pts, 10, 0x3FF0000000000000)
    ArraySet(pts, 11, 0x3FF0000000000000)
    ArraySet(pts, 12, 0x3FF0000000000000)
    ArraySet(pts, 13, 0x4000000000000000)
    ArraySet(pts, 14, 0)
    ArraySet(pts, 15, 0x4000000000000000)
    i = 0
    WhileLoop LessThan(i, 8) {
        ArraySet(v_base, Multiply(i, 3), ArrayGet(pts, Multiply(i, 2)))
        ArraySet(v_base, Add(Multiply(i, 3), 1), ArrayGet(pts, Add(Multiply(i, 2), 1)))
        ArraySet(v_base, Add(Multiply(i, 3), 2), 0)
        i = Add(i, 1)
    }
    poly = Allocate(64)
    i = 0
    WhileLoop LessThan(i, 8) {
        ArraySet(poly, i, i)
        i = Add(i, 1)
    }
    i_base = Allocate(256)
    ep = Allocate(16)
    ArraySet(ep, 0, 8)
    ArraySet(ep, 1, 0)
    ArraySet(ep, 2, 0)
    CAD_Tess.EarClipPoly(poly, v_base, i_base, ep)
    nt = ArrayGet(ep, 1)
    PrintMessage("U earclip nt=")
    PrintNumber(nt)
    PrintMessage(" (want 6)\n")
    // probe notch center (1.5, 0.5) — should NOT be in any tri
    hits = 0
    t = 0
    WhileLoop LessThan(t, nt) {
        i0 = ArrayGet(i_base, Multiply(t, 3))
        i1 = ArrayGet(i_base, Add(Multiply(t, 3), 1))
        i2 = ArrayGet(i_base, Add(Multiply(t, 3), 2))
        pa = Allocate(32)
        pb = Allocate(32)
        pc = Allocate(32)
        pd = Allocate(32)
        ArraySet(pa, 0, ArrayGet(v_base, Multiply(i0, 3)))
        ArraySet(pa, 1, ArrayGet(v_base, Add(Multiply(i0, 3), 1)))
        ArraySet(pb, 0, ArrayGet(v_base, Multiply(i1, 3)))
        ArraySet(pb, 1, ArrayGet(v_base, Add(Multiply(i1, 3), 1)))
        ArraySet(pc, 0, ArrayGet(v_base, Multiply(i2, 3)))
        ArraySet(pc, 1, ArrayGet(v_base, Add(Multiply(i2, 3), 1)))
        ArraySet(pd, 0, 0x3FF8000000000000)
        ArraySet(pd, 1, 0x3FF8000000000000)
        o1 = CAD_Num.Orient2D(pa, pb, pd)
        o2 = CAD_Num.Orient2D(pb, pc, pd)
        o3 = CAD_Num.Orient2D(pc, pa, pd)
        IfCondition EqualTo(o1, o2) ThenBlock: {
            IfCondition EqualTo(o2, o3) ThenBlock: {
                IfCondition NotEqual(o1, 0) ThenBlock: { hits = Add(hits, 1) }
            }
        }
        Deallocate(pa, 32)
        Deallocate(pb, 32)
        Deallocate(pc, 32)
        Deallocate(pd, 32)
        t = Add(t, 1)
    }
    PrintMessage("notch hits=")
    PrintNumber(hits)
    PrintMessage(" (want 0)\n")
    IfCondition EqualTo(nt, 6) ThenBlock: {
        IfCondition EqualTo(hits, 0) ThenBlock: {
            CAD_Sys.Write(1, "EARCLIP U PASS\n", 15)
        }
    }
    IfCondition NotEqual(nt, 6) ThenBlock: {
        CAD_Sys.Write(1, "EARCLIP U FAIL count\n", 21)
    }
    IfCondition GreaterThan(hits, 0) ThenBlock: {
        CAD_Sys.Write(1, "EARCLIP U FAIL notch\n", 21)
    }
    Deallocate(v_base, 256)
    Deallocate(pts, 64)
    Deallocate(poly, 64)
    Deallocate(i_base, 256)
    Deallocate(ep, 16)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
