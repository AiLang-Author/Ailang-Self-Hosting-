// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== edge collect ===\n", 21)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    n = 200
    two_pi = 0x401921FB54442D18
    r = 0x4034000000000000
    xy = Allocate(4096)
    i = 0
    WhileLoop LessThan(i, n) {
        th = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(n)))
        ArraySet(xy, Multiply(i, 2), Float_Mul(r, CAD_Geom.Cos(th)))
        ArraySet(xy, Add(Multiply(i, 2), 1), Float_Mul(r, CAD_Geom.Sin(th)))
        i = Add(i, 1)
    }
    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, xy, n)
    h = CAD_Feat.ExtrudeProfile(hsk, 0x4034000000000000)
    PrintMessage("solid=")
    PrintNumber(h)
    PrintMessage("\n")
    pass = 0
    IfCondition NotEqual(h, 0) ThenBlock: {
        edges = Allocate(32768)
        ne = CAD_Topo.SolidCollectEdges(h, edges, 4096)
        PrintMessage("nedges=")
        PrintNumber(ne)
        PrintMessage("\n")
        // cylinder prism: n bottom + n top + n verticals = 600
        IfCondition GreaterThan(ne, 500) ThenBlock: { pass = 1 }
        Deallocate(edges, 32768)
    }
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "EDGE COLLECT PASS\n", 18)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "EDGE COLLECT FAIL\n", 18)
    }
    Deallocate(xy, 4096)
    SystemCall(60, Subtract(1, pass), 0, 0)
}
RunTask(Main)
