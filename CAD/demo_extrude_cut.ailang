// Phase B2: box pad + rect sketch ExtrudeCut → pocket STEP + optional note
// Body 50×40×20; pocket 20×15×8 from top center.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== ExtrudeCut demo ===\n", 24)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    mn = Allocate(32)
    mx = Allocate(32)
    out = Allocate(16)
    ArraySet(mn, 0, 0)
    ArraySet(mn, 1, 0)
    ArraySet(mn, 2, 0)
    ArraySet(mx, 0, 0x4049000000000000)
    ArraySet(mx, 1, 0x4044000000000000)
    ArraySet(mx, 2, 0x4034000000000000)
    body = CAD_Topo.MakeBoxSolid(mn, mx, out)
    Deallocate(mn, 32)
    Deallocate(mx, 32)
    Deallocate(out, 16)
    IfCondition EqualTo(body, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL body\n", 10)
        SystemCall(60, 1, 0, 0)
    }

    sk = CAD_Sketch.CreateSketch(1)
    // rect pocket 15,12 → 35,28 using Float_FromInt
    x0 = Float_FromInt(15)
    y0 = Float_FromInt(12)
    x1 = Float_FromInt(35)
    y1 = Float_FromInt(28)
    CAD_Sketch.AddLine(sk, x0, y0, x1, y0)
    CAD_Sketch.AddLine(sk, x1, y0, x1, y1)
    CAD_Sketch.AddLine(sk, x1, y1, x0, y1)
    CAD_Sketch.AddLine(sk, x0, y1, x0, y0)
    CAD_Sketch.BuildClosedLoop(sk)

    // depth 8
    cut = CAD_Feat.ExtrudeCut(body, sk, Float_FromInt(8))
    IfCondition EqualTo(cut, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL cut\n", 9)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(cut, "test-stl/cad_extrude_cut.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL step\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote cad_extrude_cut.stp\n", 26)
    CAD_Sys.Write(1, "EXTRUDE CUT OK\n", 15)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
