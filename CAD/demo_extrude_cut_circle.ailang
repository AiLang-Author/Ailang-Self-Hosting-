// B2+: box + pure-circle sketch ExtrudeCut → through/blind hole

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== ExtrudeCut circle ===\n", 26)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    mn = Allocate(32)
    mx = Allocate(32)
    out = Allocate(16)
    ArraySet(mn, 0, 0)
    ArraySet(mn, 1, 0)
    ArraySet(mn, 2, 0)
    ArraySet(mx, 0, Float_FromInt(40))
    ArraySet(mx, 1, Float_FromInt(40))
    ArraySet(mx, 2, Float_FromInt(15))
    body = CAD_Topo.MakeBoxSolid(mn, mx, out)
    Deallocate(mn, 32)
    Deallocate(mx, 32)
    Deallocate(out, 16)
    sk = CAD_Sketch.CreateSketch(1)
    // circle r=6 at (20,20)
    CAD_Sketch.AddCircle(sk, Float_FromInt(20), Float_FromInt(20), Float_FromInt(6))
    cut = CAD_Feat.ExtrudeCut(body, sk, Float_FromInt(15))
    IfCondition EqualTo(cut, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circle cut\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(cut, "test-stl/cad_extrude_cut_circle.stp")
    CAD_View.SetWire(0)
    CAD_View.RenderSolidToBMP(cut, 400, 300, "test-stl/cad_view_extrude_cut_circle.bmp")
    CAD_Sys.Write(1, "CIRCLE CUT OK\n", 14)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
