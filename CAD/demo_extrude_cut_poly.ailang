// B2+: through poly cut (diamond hole) on box via ExtrudeCut depth >= height

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== ExtrudeCut poly through ===\n", 32)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    mn = Allocate(32)
    mx = Allocate(32)
    out = Allocate(16)
    ArraySet(mn, 0, 0)
    ArraySet(mn, 1, 0)
    ArraySet(mn, 2, 0)
    ArraySet(mx, 0, Float_FromInt(60))
    ArraySet(mx, 1, Float_FromInt(40))
    ArraySet(mx, 2, Float_FromInt(10))
    body = CAD_Topo.MakeBoxSolid(mn, mx, out)
    Deallocate(mn, 32)
    Deallocate(mx, 32)
    Deallocate(out, 16)
    // diamond hole center ~30,20
    sk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk, Float_FromInt(30), Float_FromInt(12), Float_FromInt(38), Float_FromInt(20))
    CAD_Sketch.AddLine(sk, Float_FromInt(38), Float_FromInt(20), Float_FromInt(30), Float_FromInt(28))
    CAD_Sketch.AddLine(sk, Float_FromInt(30), Float_FromInt(28), Float_FromInt(22), Float_FromInt(20))
    CAD_Sketch.AddLine(sk, Float_FromInt(22), Float_FromInt(20), Float_FromInt(30), Float_FromInt(12))
    CAD_Sketch.BuildClosedLoop(sk)
    cut = CAD_Feat.ExtrudeCut(body, sk, Float_FromInt(10))
    IfCondition EqualTo(cut, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL poly cut\n", 14)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(cut, "test-stl/cad_extrude_cut_poly.stp")
    CAD_View.SetWire(0)
    CAD_View.RenderSolidToBMP(cut, 500, 350, "test-stl/cad_view_extrude_cut_poly.bmp")
    CAD_Sys.Write(1, "POLY CUT OK\n", 12)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
