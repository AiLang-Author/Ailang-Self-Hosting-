// B6: draft pad — rect 20x15, h=25, draft ~10° outward (Fusion-like)

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== ExtrudeDraft demo ===\n", 26)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    sk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk, 0, 0, Float_FromInt(20), 0)
    CAD_Sketch.AddLine(sk, Float_FromInt(20), 0, Float_FromInt(20), Float_FromInt(15))
    CAD_Sketch.AddLine(sk, Float_FromInt(20), Float_FromInt(15), 0, Float_FromInt(15))
    CAD_Sketch.AddLine(sk, 0, Float_FromInt(15), 0, 0)
    CAD_Sketch.BuildClosedLoop(sk)
    // ~10 degrees in rad ≈ 0.1745 = 0x3FC64A8C154C985F approx use 0x3FC6666666666666 ~0.175
    draft = 0x3FC6666666666666
    h = CAD_Feat.ExtrudeDraft(sk, Float_FromInt(25), draft, 1)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL draft\n", 11)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(h, "test-stl/cad_extrude_draft.stp")
    CAD_View.SetWire(0)
    CAD_View.RenderSolidToBMP(h, 450, 350, "test-stl/cad_view_extrude_draft.bmp")
    // symmetric
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk2, 0, 0, Float_FromInt(10), 0)
    CAD_Sketch.AddLine(sk2, Float_FromInt(10), 0, Float_FromInt(10), Float_FromInt(10))
    CAD_Sketch.AddLine(sk2, Float_FromInt(10), Float_FromInt(10), 0, Float_FromInt(10))
    CAD_Sketch.AddLine(sk2, 0, Float_FromInt(10), 0, 0)
    CAD_Sketch.BuildClosedLoop(sk2)
    h2 = CAD_Feat.ExtrudeSymmetric(sk2, Float_FromInt(20))
    IfCondition EqualTo(h2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL sym\n", 9)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(h2, "test-stl/cad_extrude_sym.stp")
    CAD_View.RenderSolidToBMP(h2, 400, 300, "test-stl/cad_view_extrude_sym.bmp")
    CAD_Sys.Write(1, "DRAFT+SYM OK\n", 13)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
