// Face signature rebind: plane tracks face by centroid+normal, not store handle.
// Pad taller body → old face handle invalid → ResolveFaceBySignature finds top again.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_Topo

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== Face rebind demo ===\n", 25)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    // body h=10
    sk0 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk0, 0, 0, 0x4034000000000000, 0)
    CAD_Sketch.AddLine(sk0, 0x4034000000000000, 0, 0x4034000000000000, 0x4034000000000000)
    CAD_Sketch.AddLine(sk0, 0x4034000000000000, 0x4034000000000000, 0, 0x4034000000000000)
    CAD_Sketch.AddLine(sk0, 0, 0x4034000000000000, 0, 0)
    CAD_Sketch.BuildClosedLoop(sk0)
    body1 = CAD_Feat.ExtrudeProfile(sk0, 0x4024000000000000)
    IfCondition EqualTo(body1, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL body1\n", 11)
        SystemCall(60, 1, 0, 0)
    }

    // pick top face via ray
    ray = Allocate(64)
    ArraySet(ray, 0, 0x4024000000000000)
    ArraySet(ray, 1, 0x4024000000000000)
    ArraySet(ray, 2, 0x4059000000000000)
    ArraySet(ray, 3, 0)
    ArraySet(ray, 4, 0)
    ArraySet(ray, 5, 0xBFF0000000000000)
    outp = Allocate(64)
    ok = CAD_Topo.PickFaceRay(body1, ray, outp)
    Deallocate(ray, 64)
    IfCondition EqualTo(ok, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL pick face1\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    face1 = ArrayGet(outp, 0)
    Deallocate(outp, 64)

    pl = CAD_Plane.CreateFromFace(face1, body1)
    IfCondition EqualTo(pl, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL create plane\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    pid = CAD_Plane.GetPid(pl)
    IfCondition LessThan(pid, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL pid\n", 9)
        SystemCall(60, 1, 0, 0)
    }
    oz1 = CAD_Plane.OriginZ(pl)
    CAD_Sys.Write(1, "plane pid ok z1\n", 16)

    // rebuild: taller body h=25 (new solid — old face handle is orphan)
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk2, 0, 0, 0x4034000000000000, 0)
    CAD_Sketch.AddLine(sk2, 0x4034000000000000, 0, 0x4034000000000000, 0x4034000000000000)
    CAD_Sketch.AddLine(sk2, 0x4034000000000000, 0x4034000000000000, 0, 0x4034000000000000)
    CAD_Sketch.AddLine(sk2, 0, 0x4034000000000000, 0, 0)
    CAD_Sketch.BuildClosedLoop(sk2)
    body2 = CAD_Feat.ExtrudeProfile(sk2, 0x4039000000000000)
    IfCondition EqualTo(body2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL body2\n", 11)
        SystemCall(60, 1, 0, 0)
    }

    // force stale handle
    CAD_Store.Write(pl, 15, 0)
    rb = CAD_Plane.RebindFace(pl, body2)
    IfCondition NotEqual(rb, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL rebind\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    oz2 = CAD_Plane.OriginZ(pl)
    // top of body2 is z=25
    IfCondition EqualTo(CAD_Num.IsEqual(oz2, 0x4039000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL rebind Z\n", 14)
        PrintNumber(Float_ToInt(oz2))
        PrintMessage("\n")
        SystemCall(60, 1, 0, 0)
    }
    // pid stable
    IfCondition NotEqual(CAD_Plane.GetPid(pl), pid) ThenBlock: {
        CAD_Sys.Write(1, "FAIL pid changed\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "FACE REBIND OK\n", 15)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
