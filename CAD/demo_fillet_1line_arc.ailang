// One top LINE into an unselected extruded 2D-arc (junc=5).
// Method 9 EdgeLocal + NotchHostOne: lid CIRCLE far–Th, wall nring=5
// (short top + one plane∩cyl ellipse + split gen). Kind=2 mer skip stays.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== 1-LINE + inward arc fillet ===\n", 35)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    n25 = 0x4039000000000000
    n20 = 0x4034000000000000
    n8 = 0x4020000000000000
    m25 = Float_Sub(0, n25)
    n55 = Float_FromInt(55)
    cy = Float_Sub(0, Float_FromInt(80))
    rr = CAD_Num.Hypot2(n25, n55)
    a0 = CAD_Geom.Atan2(n55, m25)
    a1 = CAD_Geom.Atan2(n55, n25)

    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = n20
    CAD_Topo.SweepBeginWire()
    CAD_Topo_Sweep.px0 = 0
    CAD_Topo_Sweep.py0 = cy
    CAD_Topo_Sweep.px1 = rr
    CAD_Topo_Sweep.pa0 = a0
    CAD_Topo_Sweep.pa1 = a1
    CAD_Topo.SweepAddArcPinned()
    CAD_Topo.SweepAddLine(n25, m25, n25, n25)
    CAD_Topo.SweepAddLine(n25, n25, m25, n25)
    CAD_Topo.SweepAddLine(m25, n25, m25, m25)

    host = CAD_Topo.ExtrudeContours()
    IfCondition EqualTo(host, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo.RebuildKind0Planes(host)

    eds = Allocate(4096)
    top = Allocate(128)
    ne = CAD_Topo.SolidCollectEdges(host, eds, 256)
    east = 0
    best_x = 0
    i = 0
    WhileLoop LessThan(i, ne) {
        e = ArrayGet(eds, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            va = CAD_Store.Read(e, 0)
            vb = CAD_Store.Read(e, 1)
            crv = CAD_Store.Read(e, 2)
            ck = 0
            IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
            IfCondition EqualTo(ck, 1) ThenBlock: {
                IfCondition NotEqual(va, 0) ThenBlock: {
                    IfCondition NotEqual(vb, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vb, 2), n20, 0), 1) ThenBlock: {
                                mx = Float_Div(Float_Add(CAD_Store.Read(va, 0), CAD_Store.Read(vb, 0)), 0x4000000000000000)
                                IfCondition EqualTo(east, 0) ThenBlock: {
                                    east = e
                                    best_x = mx
                                }
                                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(best_x, mx)), 1) ThenBlock: {
                                    east = e
                                    best_x = mx
                                }
                            }
                        }
                    }
                }
            }
        }
        i = Add(i, 1)
    }
    IfCondition EqualTo(east, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no east top LINE\n", 22)
        SystemCall(60, 1, 0, 0)
    }
    ArraySet(top, 0, east)
    CAD_Sys.Write(1, "fillet 1 LINE R=8\n", 18)
    fil = CAD_Blend.FilletEdges(host, top, 1, n8)
    IfCondition EqualTo(fil, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL fillet returned 0\n", 23)
        SystemCall(60, 1, 0, 0)
    }

    pl = Allocate(128)
    lid_one = 0
    lid_zbad = 0
    wall_full = 0
    wall_nring = 0
    sh = CAD_Store.Read(fil, 0)
    face = 0
    IfCondition NotEqual(sh, 0) ThenBlock: { face = CAD_Store.Read(sh, 0) }
    fg = 0
    WhileLoop LessThan(fg, 64) {
        IfCondition EqualTo(face, 0) ThenBlock: { fg = 64 }
        IfCondition NotEqual(face, 0) ThenBlock: {
            surf = CAD_Store.Read(face, 0)
            sk = 0
            IfCondition NotEqual(surf, 0) ThenBlock: { sk = CAD_Store.Read(surf, 0) }
            lp = CAD_Store.Read(face, 1)
            nring = 0
            IfCondition NotEqual(lp, 0) ThenBlock: { nring = CAD_Topo.LoopCountCoedges(lp) }
            IfCondition EqualTo(sk, 2) ThenBlock: {
                sr = 0
                ax = 0
                ay = 0
                az = 0
                IfCondition NotEqual(surf, 0) ThenBlock: {
                    sr = CAD_Store.Read(surf, 13)
                    ax = CAD_Store.Read(surf, 10)
                    ay = CAD_Store.Read(surf, 11)
                    az = CAD_Store.Read(surf, 12)
                }
                IfCondition EqualTo(CAD_Num.Le(n20, sr), 1) ThenBlock: {
                    wall_nring = nring
                    CAD_Sys.Write(1, "wall axis ", 10)
                    PrintNumber(Float_ToInt(Float_Mul(ax, 0x408F400000000000)))
                    CAD_Sys.Write(1, " ", 1)
                    PrintNumber(Float_ToInt(Float_Mul(ay, 0x408F400000000000)))
                    CAD_Sys.Write(1, " ", 1)
                    PrintNumber(Float_ToInt(Float_Mul(az, 0x408F400000000000)))
                    CAD_Sys.Write(1, "\n", 1)
                    IfCondition EqualTo(CAD_Num.IsZero(ax, 0), 0) ThenBlock: {
                        CAD_Sys.Write(1, "FAIL wall axis not +Z\n", 23)
                        SystemCall(60, 1, 0, 0)
                    }
                    IfCondition EqualTo(CAD_Num.IsZero(ay, 0), 0) ThenBlock: {
                        CAD_Sys.Write(1, "FAIL wall axis not +Z\n", 23)
                        SystemCall(60, 1, 0, 0)
                    }
                    IfCondition EqualTo(CAD_Num.IsEqual(az, 0x3FF0000000000000, 0), 0) ThenBlock: {
                        CAD_Sys.Write(1, "FAIL wall axis not +Z\n", 23)
                        SystemCall(60, 1, 0, 0)
                    }
                    hd = 0
                    IfCondition NotEqual(lp, 0) ThenBlock: { hd = CAD_Store.Read(lp, 0) }
                    ce = hd
                    cg = 0
                    WhileLoop LessThan(cg, 16) {
                        IfCondition EqualTo(ce, 0) ThenBlock: { cg = 16 }
                        IfCondition NotEqual(ce, 0) ThenBlock: {
                            e = CAD_Store.Read(ce, 0)
                            IfCondition NotEqual(e, 0) ThenBlock: {
                                va = CAD_Store.Read(e, 0)
                                vb = CAD_Store.Read(e, 1)
                                crv = CAD_Store.Read(e, 2)
                                ck = 0
                                IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
                                IfCondition EqualTo(ck, 2) ThenBlock: {
                                    IfCondition NotEqual(va, 0) ThenBlock: {
                                        IfCondition NotEqual(vb, 0) ThenBlock: {
                                            za = CAD_Store.Read(va, 2)
                                            zb = CAD_Store.Read(vb, 2)
                                            IfCondition EqualTo(CAD_Num.IsEqual(za, n20, 0), 1) ThenBlock: {
                                                IfCondition EqualTo(CAD_Num.IsEqual(zb, n20, 0), 1) ThenBlock: {
                                                    xa = CAD_Store.Read(va, 0)
                                                    xb = CAD_Store.Read(vb, 0)
                                                    IfCondition EqualTo(CAD_Num.IsNeg(xa), 1) ThenBlock: { xa = Float_Sub(0, xa) }
                                                    IfCondition EqualTo(CAD_Num.IsNeg(xb), 1) ThenBlock: { xb = Float_Sub(0, xb) }
                                                    IfCondition EqualTo(CAD_Num.Le(n20, xa), 1) ThenBlock: {
                                                        IfCondition EqualTo(CAD_Num.Le(n20, xb), 1) ThenBlock: {
                                                            wall_full = 1
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            ce = CAD_Store.Read(ce, 2)
                            IfCondition EqualTo(ce, hd) ThenBlock: { cg = 16 }
                        }
                        cg = Add(cg, 1)
                    }
                }
            }
            plane_rc = CAD_Topo.FaceGetPlane(face, pl)
            IfCondition EqualTo(plane_rc, 0) ThenBlock: {
                nz = ArrayGet(pl, 12)
                IfCondition EqualTo(CAD_Num.IsNeg(nz), 1) ThenBlock: { nz = Float_Sub(0, nz) }
                IfCondition EqualTo(CAD_Num.Le(0x3FE0000000000000, nz), 1) ThenBlock: {
                    hd = 0
                    IfCondition NotEqual(lp, 0) ThenBlock: { hd = CAD_Store.Read(lp, 0) }
                    ce = hd
                    cg = 0
                    WhileLoop LessThan(cg, 16) {
                        IfCondition EqualTo(ce, 0) ThenBlock: { cg = 16 }
                        IfCondition NotEqual(ce, 0) ThenBlock: {
                            e = CAD_Store.Read(ce, 0)
                            IfCondition NotEqual(e, 0) ThenBlock: {
                                va = CAD_Store.Read(e, 0)
                                vb = CAD_Store.Read(e, 1)
                                crv = CAD_Store.Read(e, 2)
                                ck = 0
                                IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
                                IfCondition EqualTo(ck, 2) ThenBlock: {
                                    IfCondition NotEqual(va, 0) ThenBlock: {
                                        IfCondition NotEqual(vb, 0) ThenBlock: {
                                            za = CAD_Store.Read(va, 2)
                                            zb = CAD_Store.Read(vb, 2)
                                            IfCondition EqualTo(CAD_Num.IsEqual(za, n20, 0), 1) ThenBlock: {
                                                IfCondition EqualTo(CAD_Num.IsEqual(zb, n20, 0), 1) ThenBlock: {
                                                    sr = 0
                                                    IfCondition NotEqual(crv, 0) ThenBlock: { sr = CAD_Store.Read(crv, 10) }
                                                    IfCondition EqualTo(CAD_Num.Le(n20, sr), 1) ThenBlock: {
                                                        xa = CAD_Store.Read(va, 0)
                                                        xb = CAD_Store.Read(vb, 0)
                                                        IfCondition EqualTo(CAD_Num.IsNeg(xa), 1) ThenBlock: { xa = Float_Sub(0, xa) }
                                                        IfCondition EqualTo(CAD_Num.IsNeg(xb), 1) ThenBlock: { xb = Float_Sub(0, xb) }
                                                        a_in = 0
                                                        b_in = 0
                                                        IfCondition EqualTo(CAD_Num.Le(xa, n20), 1) ThenBlock: { a_in = 1 }
                                                        IfCondition EqualTo(CAD_Num.Le(xb, n20), 1) ThenBlock: { b_in = 1 }
                                                        IfCondition NotEqual(a_in, b_in) ThenBlock: { lid_one = 1 }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                at_lid = 0
                                IfCondition NotEqual(va, 0) ThenBlock: {
                                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 1) ThenBlock: { at_lid = 1 }
                                }
                                IfCondition NotEqual(vb, 0) ThenBlock: {
                                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vb, 2), n20, 0), 1) ThenBlock: { at_lid = 1 }
                                }
                                IfCondition EqualTo(at_lid, 1) ThenBlock: {
                                    IfCondition NotEqual(va, 0) ThenBlock: {
                                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 0) ThenBlock: { lid_zbad = 1 }
                                    }
                                    IfCondition NotEqual(vb, 0) ThenBlock: {
                                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vb, 2), n20, 0), 0) ThenBlock: { lid_zbad = 1 }
                                    }
                                }
                            }
                            ce = CAD_Store.Read(ce, 2)
                            IfCondition EqualTo(ce, hd) ThenBlock: { cg = 16 }
                        }
                        cg = Add(cg, 1)
                    }
                }
            }
            face = CAD_Store.Read(face, 3)
        }
        fg = Add(fg, 1)
    }
    Deallocate(pl, 128)
    CAD_Sys.Write(1, "lid_one=", 8)
    PrintNumber(lid_one)
    CAD_Sys.Write(1, " lid_zbad=", 10)
    PrintNumber(lid_zbad)
    CAD_Sys.Write(1, " wall_full=", 11)
    PrintNumber(wall_full)
    CAD_Sys.Write(1, " wall_nring=", 12)
    PrintNumber(wall_nring)
    CAD_Sys.Write(1, "\n", 1)
    IfCondition EqualTo(lid_one, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL lid CIRCLE not far-Th\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(lid_zbad, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL lid vert not at pad Z\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(wall_full, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL blocker top still full\n", 28)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(wall_nring, 5) ThenBlock: {
        CAD_Sys.Write(1, "FAIL blocker nring want 5\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    mesh = Allocate(32)
    nt = CAD_Tess.MeshSolid(fil, 0x3FB999999999999A, mesh)
    CAD_Sys.Write(1, "mesh nt=", 8)
    PrintNumber(nt)
    CAD_Sys.Write(1, "\n", 1)
    // Wall triangles sit on the host cylinder. A sheared CylLoopUV
    // earclip chords through the pad: verts on the cylinder, centroid off it.
    // Caps are constant-Z and skipped (the lid may chord the arc).
    vb = ArrayGet(mesh, 2)
    ib = ArrayGet(mesh, 3)
    bad = 0
    worst = 0
    ti = 0
    half = 0x3FE0000000000000
    one = 0x3FF0000000000000
    qtr = 0x3FD0000000000000
    WhileLoop LessThan(ti, nt) {
        ia = ArrayGet(ib, Multiply(ti, 3))
        ibb = ArrayGet(ib, Add(Multiply(ti, 3), 1))
        ic = ArrayGet(ib, Add(Multiply(ti, 3), 2))
        ax = ArrayGet(vb, Multiply(ia, 3))
        ay = ArrayGet(vb, Add(Multiply(ia, 3), 1))
        az = ArrayGet(vb, Add(Multiply(ia, 3), 2))
        bx = ArrayGet(vb, Multiply(ibb, 3))
        by = ArrayGet(vb, Add(Multiply(ibb, 3), 1))
        bz = ArrayGet(vb, Add(Multiply(ibb, 3), 2))
        cxv = ArrayGet(vb, Multiply(ic, 3))
        cyv = ArrayGet(vb, Add(Multiply(ic, 3), 1))
        cz = ArrayGet(vb, Add(Multiply(ic, 3), 2))
        zlo = az
        zhi = az
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(bz, zlo)), 1) ThenBlock: { zlo = bz }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(cz, zlo)), 1) ThenBlock: { zlo = cz }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(zhi, bz)), 1) ThenBlock: { zhi = bz }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(zhi, cz)), 1) ThenBlock: { zhi = cz }
        IfCondition EqualTo(CAD_Num.Le(qtr, Float_Sub(zhi, zlo)), 1) ThenBlock: {
            da = CAD_Num.Hypot2(ax, Float_Sub(ay, cy))
            db = CAD_Num.Hypot2(bx, Float_Sub(by, cy))
            dc = CAD_Num.Hypot2(cxv, Float_Sub(cyv, cy))
            ad = Float_Sub(da, rr)
            IfCondition EqualTo(CAD_Num.IsNeg(ad), 1) ThenBlock: { ad = Float_Sub(0, ad) }
            bd = Float_Sub(db, rr)
            IfCondition EqualTo(CAD_Num.IsNeg(bd), 1) ThenBlock: { bd = Float_Sub(0, bd) }
            cd = Float_Sub(dc, rr)
            IfCondition EqualTo(CAD_Num.IsNeg(cd), 1) ThenBlock: { cd = Float_Sub(0, cd) }
            ona = CAD_Num.Le(ad, half)
            onb = CAD_Num.Le(bd, half)
            onc = CAD_Num.Le(cd, half)
            IfCondition EqualTo(ona, 1) ThenBlock: {
                IfCondition EqualTo(onb, 1) ThenBlock: {
                    IfCondition EqualTo(onc, 1) ThenBlock: {
                        mx = Float_Div(Float_Add(Float_Add(ax, bx), cxv), 0x4008000000000000)
                        my = Float_Div(Float_Add(Float_Add(ay, by), cyv), 0x4008000000000000)
                        dm = CAD_Num.Hypot2(mx, Float_Sub(my, cy))
                        dev = Float_Sub(dm, rr)
                        IfCondition EqualTo(CAD_Num.IsNeg(dev), 1) ThenBlock: { dev = Float_Sub(0, dev) }
                        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(worst, dev)), 1) ThenBlock: { worst = dev }
                        IfCondition EqualTo(CAD_Num.Le(one, dev), 1) ThenBlock: {
                            IfCondition LessThan(bad, 4) ThenBlock: {
                                CAD_Sys.Write(1, "chord ", 6)
                                PrintNumber(Float_ToInt(Float_Mul(ax, 0x408F400000000000)))
                                CAD_Sys.Write(1, ",", 1)
                                PrintNumber(Float_ToInt(Float_Mul(ay, 0x408F400000000000)))
                                CAD_Sys.Write(1, ",", 1)
                                PrintNumber(Float_ToInt(Float_Mul(az, 0x408F400000000000)))
                                CAD_Sys.Write(1, " | ", 3)
                                PrintNumber(Float_ToInt(Float_Mul(bx, 0x408F400000000000)))
                                CAD_Sys.Write(1, ",", 1)
                                PrintNumber(Float_ToInt(Float_Mul(by, 0x408F400000000000)))
                                CAD_Sys.Write(1, ",", 1)
                                PrintNumber(Float_ToInt(Float_Mul(bz, 0x408F400000000000)))
                                CAD_Sys.Write(1, " | ", 3)
                                PrintNumber(Float_ToInt(Float_Mul(cxv, 0x408F400000000000)))
                                CAD_Sys.Write(1, ",", 1)
                                PrintNumber(Float_ToInt(Float_Mul(cyv, 0x408F400000000000)))
                                CAD_Sys.Write(1, ",", 1)
                                PrintNumber(Float_ToInt(Float_Mul(cz, 0x408F400000000000)))
                                CAD_Sys.Write(1, " dev_um=", 8)
                                PrintNumber(Float_ToInt(Float_Mul(dev, 0x408F400000000000)))
                                CAD_Sys.Write(1, "\n", 1)
                            }
                            bad = Add(bad, 1)
                        }
                    }
                }
            }
        }
        ti = Add(ti, 1)
    }
    // North end wall y=25 holds the rolling-ball quarter-circle
    // (axis x=17 z=12 R=8). A fan from the far corner ties an
    // interior mer sample to x<0. Boundary edges of the 50 mm
    // wall are not that pattern. The concave lid may still diagonal.
    fan = 0
    mer_n = 0
    nv = ArrayGet(mesh, 0)
    vi = 0
    n17 = Float_FromInt(17)
    n12 = Float_FromInt(12)
    n14 = Float_FromInt(14)
    n19 = Float_FromInt(19)
    n24 = Float_FromInt(24)
    WhileLoop LessThan(vi, nv) {
        ax = ArrayGet(vb, Multiply(vi, 3))
        ay = ArrayGet(vb, Add(Multiply(vi, 3), 1))
        az = ArrayGet(vb, Add(Multiply(vi, 3), 2))
        dy = Float_Sub(ay, n25)
        IfCondition EqualTo(CAD_Num.IsNeg(dy), 1) ThenBlock: { dy = Float_Sub(0, dy) }
        IfCondition EqualTo(CAD_Num.Le(dy, qtr), 1) ThenBlock: {
            dx = Float_Sub(ax, n17)
            dz = Float_Sub(az, n12)
            rad = CAD_Num.Hypot2(dx, dz)
            ad = Float_Sub(rad, n8)
            IfCondition EqualTo(CAD_Num.IsNeg(ad), 1) ThenBlock: { ad = Float_Sub(0, ad) }
            IfCondition EqualTo(CAD_Num.Le(ad, half), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.Le(n19, ax), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.Le(ax, n24), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.Le(n14, az), 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.Le(az, n19), 1) ThenBlock: {
                                mer_n = Add(mer_n, 1)
                            }
                        }
                    }
                }
            }
        }
        vi = Add(vi, 1)
    }
    ti = 0
    WhileLoop LessThan(ti, nt) {
        ia = ArrayGet(ib, Multiply(ti, 3))
        ibb = ArrayGet(ib, Add(Multiply(ti, 3), 1))
        ic = ArrayGet(ib, Add(Multiply(ti, 3), 2))
        ax = ArrayGet(vb, Multiply(ia, 3))
        ay = ArrayGet(vb, Add(Multiply(ia, 3), 1))
        az = ArrayGet(vb, Add(Multiply(ia, 3), 2))
        bx = ArrayGet(vb, Multiply(ibb, 3))
        by = ArrayGet(vb, Add(Multiply(ibb, 3), 1))
        bz = ArrayGet(vb, Add(Multiply(ibb, 3), 2))
        cxv = ArrayGet(vb, Multiply(ic, 3))
        cyv = ArrayGet(vb, Add(Multiply(ic, 3), 1))
        cz = ArrayGet(vb, Add(Multiply(ic, 3), 2))
        ony = 1
        dy = Float_Sub(ay, n25)
        IfCondition EqualTo(CAD_Num.IsNeg(dy), 1) ThenBlock: { dy = Float_Sub(0, dy) }
        IfCondition EqualTo(CAD_Num.Le(dy, qtr), 0) ThenBlock: { ony = 0 }
        dy = Float_Sub(by, n25)
        IfCondition EqualTo(CAD_Num.IsNeg(dy), 1) ThenBlock: { dy = Float_Sub(0, dy) }
        IfCondition EqualTo(CAD_Num.Le(dy, qtr), 0) ThenBlock: { ony = 0 }
        dy = Float_Sub(cyv, n25)
        IfCondition EqualTo(CAD_Num.IsNeg(dy), 1) ThenBlock: { dy = Float_Sub(0, dy) }
        IfCondition EqualTo(CAD_Num.Le(dy, qtr), 0) ThenBlock: { ony = 0 }
        IfCondition EqualTo(ony, 1) ThenBlock: {
            nm = 0
            nf = 0
            ad = Float_Sub(CAD_Num.Hypot2(Float_Sub(ax, n17), Float_Sub(az, n12)), n8)
            IfCondition EqualTo(CAD_Num.IsNeg(ad), 1) ThenBlock: { ad = Float_Sub(0, ad) }
            IfCondition EqualTo(CAD_Num.Le(ad, half), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.Le(n19, ax), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.Le(ax, n24), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.Le(n14, az), 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.Le(az, n19), 1) ThenBlock: { nm = Add(nm, 1) }
                        }
                    }
                }
            }
            IfCondition EqualTo(CAD_Num.IsNeg(ax), 1) ThenBlock: { nf = Add(nf, 1) }
            ad = Float_Sub(CAD_Num.Hypot2(Float_Sub(bx, n17), Float_Sub(bz, n12)), n8)
            IfCondition EqualTo(CAD_Num.IsNeg(ad), 1) ThenBlock: { ad = Float_Sub(0, ad) }
            IfCondition EqualTo(CAD_Num.Le(ad, half), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.Le(n19, bx), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.Le(bx, n24), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.Le(n14, bz), 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.Le(bz, n19), 1) ThenBlock: { nm = Add(nm, 1) }
                        }
                    }
                }
            }
            IfCondition EqualTo(CAD_Num.IsNeg(bx), 1) ThenBlock: { nf = Add(nf, 1) }
            ad = Float_Sub(CAD_Num.Hypot2(Float_Sub(cxv, n17), Float_Sub(cz, n12)), n8)
            IfCondition EqualTo(CAD_Num.IsNeg(ad), 1) ThenBlock: { ad = Float_Sub(0, ad) }
            IfCondition EqualTo(CAD_Num.Le(ad, half), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.Le(n19, cxv), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.Le(cxv, n24), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.Le(n14, cz), 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.Le(cz, n19), 1) ThenBlock: { nm = Add(nm, 1) }
                        }
                    }
                }
            }
            IfCondition EqualTo(CAD_Num.IsNeg(cxv), 1) ThenBlock: { nf = Add(nf, 1) }
            IfCondition GreaterThan(nm, 0) ThenBlock: {
                IfCondition GreaterThan(nf, 0) ThenBlock: { fan = Add(fan, 1) }
            }
        }
        ti = Add(ti, 1)
    }
    CAD_Sys.Write(1, "end mer=", 8)
    PrintNumber(mer_n)
    CAD_Sys.Write(1, " end fan=", 9)
    PrintNumber(fan)
    CAD_Sys.Write(1, "\n", 1)
    // South arc nose. Bisector of the fillet, on the host. A flat
    // chord has no vertex in this window. The north quarter-circle
    // is y=+25. Host check is only the samples at the arc, not the
    // generator running back to the straight end.
    c45 = CAD_Geom.Cos(0x3FE921FB54442D18)
    nx = Float_Add(n17, Float_Mul(n8, c45))
    nz = Float_Add(n12, Float_Mul(n8, c45))
    yn = Float_Add(cy, CAD_Num.Sqrt(Float_Sub(Float_Mul(rr, rr), Float_Mul(nx, nx))))
    one = 0x3FF0000000000000
    nose = 0
    nhost = 0
    vi = 0
    WhileLoop LessThan(vi, nv) {
        ax = ArrayGet(vb, Multiply(vi, 3))
        ay = ArrayGet(vb, Add(Multiply(vi, 3), 1))
        az = ArrayGet(vb, Add(Multiply(vi, 3), 2))
        IfCondition EqualTo(CAD_Num.IsNeg(ay), 1) ThenBlock: {
            dx = Float_Sub(ax, nx)
            IfCondition EqualTo(CAD_Num.IsNeg(dx), 1) ThenBlock: { dx = Float_Sub(0, dx) }
            dz = Float_Sub(az, nz)
            IfCondition EqualTo(CAD_Num.IsNeg(dz), 1) ThenBlock: { dz = Float_Sub(0, dz) }
            dy = Float_Sub(ay, yn)
            IfCondition EqualTo(CAD_Num.IsNeg(dy), 1) ThenBlock: { dy = Float_Sub(0, dy) }
            IfCondition EqualTo(CAD_Num.Le(dx, half), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.Le(dz, half), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.Le(dy, one), 1) ThenBlock: {
                        ad = CAD_Num.Hypot2(Float_Sub(ax, n17), Float_Sub(az, n12))
                        ad = Float_Sub(ad, n8)
                        IfCondition EqualTo(CAD_Num.IsNeg(ad), 1) ThenBlock: { ad = Float_Sub(0, ad) }
                        IfCondition EqualTo(CAD_Num.Le(ad, qtr), 1) ThenBlock: {
                            nose = Add(nose, 1)
                            hd = CAD_Num.Hypot2(ax, Float_Sub(ay, cy))
                            hd = Float_Sub(hd, rr)
                            IfCondition EqualTo(CAD_Num.IsNeg(hd), 1) ThenBlock: { hd = Float_Sub(0, hd) }
                            IfCondition EqualTo(CAD_Num.Le(qtr, hd), 1) ThenBlock: { nhost = Add(nhost, 1) }
                        }
                    }
                }
            }
        }
        vi = Add(vi, 1)
    }
    CAD_Sys.Write(1, "nose n=", 7)
    PrintNumber(nose)
    CAD_Sys.Write(1, " host=", 6)
    PrintNumber(nhost)
    CAD_Sys.Write(1, "\n", 1)
    Deallocate(mesh, 32)
    IfCondition LessThan(nose, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL fillet nose flat\n", 22)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition GreaterThan(nhost, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL fillet nose off host\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition LessThan(mer_n, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL end mer missing\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition GreaterThan(fan, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL end wall fan\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wall chord bad=", 15)
    PrintNumber(bad)
    CAD_Sys.Write(1, " worst_um=", 10)
    PrintNumber(Float_ToInt(Float_Mul(worst, 0x408F400000000000)))
    CAD_Sys.Write(1, "\n", 1)
    IfCondition GreaterThan(bad, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL wall chord off cylinder\n", 29)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition LessThan(nt, 8) ThenBlock: {
        CAD_Sys.Write(1, "FAIL mesh empty\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition GreaterThan(nt, 5000) ThenBlock: {
        CAD_Sys.Write(1, "FAIL mesh funnel\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(fil, "test-stl/cad_fillet_1line_arc.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL STEP\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "FILLET 1LINE ARC OK\n", 20)
    Deallocate(top, 128)
    Deallocate(eds, 4096)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
