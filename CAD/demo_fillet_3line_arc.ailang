// Parked 3-LINE + inward-arc: 50x50 pad, unselected extruded 2D-arc,
// fillet the three remaining top LINEs at R=8. South and north arcs.
// Must not crash in plex classify. NotchHost trims the lid CIRCLE to
// Th–Th and sews the blocker to nring=6 (short top + two plane∩cyl
// ellipses + split generators + full bottom). MeshCylLoopUV.
// Lid verts stay at pad height; RetargetMer must not swap a lid rail
// onto the wall ellipse. MeshSolid must not RuledLoop the nring=6
// wall after CylLoopUV (use_zip clobber starred the lid).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== 3-LINE + inward arc fillet ===\n", 35)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    n25 = 0x4039000000000000
    n20 = 0x4034000000000000
    n8 = 0x4020000000000000
    m25 = Float_Sub(0, n25)

    // Phase A: 4-LINE box first (GUI session did this, then forget).
    // Classify used to call HasGlue on leftover FSeq and GPF.
    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = n20
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddLine(m25, m25, n25, m25)
    CAD_Topo.SweepAddLine(n25, m25, n25, n25)
    CAD_Topo.SweepAddLine(n25, n25, m25, n25)
    CAD_Topo.SweepAddLine(m25, n25, m25, m25)
    box = CAD_Topo.ExtrudeContours()
    IfCondition EqualTo(box, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL box extrude\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo.RebuildKind0Planes(box)
    eds0 = Allocate(4096)
    top0 = Allocate(128)
    ne0 = CAD_Topo.SolidCollectEdges(box, eds0, 256)
    nt0 = 0
    i = 0
    WhileLoop LessThan(i, ne0) {
        e = ArrayGet(eds0, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            va = CAD_Store.Read(e, 0)
            vb = CAD_Store.Read(e, 1)
            IfCondition NotEqual(va, 0) ThenBlock: {
                IfCondition NotEqual(vb, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vb, 2), n20, 0), 1) ThenBlock: {
                            ArraySet(top0, nt0, e)
                            nt0 = Add(nt0, 1)
                        }
                    }
                }
            }
        }
        i = Add(i, 1)
    }
    IfCondition NotEqual(nt0, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL box top n\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    fil0 = CAD_Blend.FilletEdges(box, top0, nt0, n8)
    IfCondition EqualTo(fil0, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL 4-LINE fillet\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "4-LINE ok class=", 16)
    PrintNumber(CAD_Topo_State.fillet_class)
    CAD_Sys.Write(1, "\n", 1)
    Deallocate(top0, 128)
    Deallocate(eds0, 4096)
    n55 = Float_FromInt(55)
    cy = Float_Sub(0, Float_FromInt(80))
    rr = CAD_Num.Hypot2(n25, n55)
    a0 = CAD_Geom.Atan2(n55, m25)
    a1 = CAD_Geom.Atan2(n55, n25)

    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = n20
    CAD_Topo.SweepBeginWire()
    // South inward arc SW -> SE (center (0,-80), clockwise short span)
    CAD_Topo_Sweep.px0 = 0
    CAD_Topo_Sweep.py0 = cy
    CAD_Topo_Sweep.px1 = rr
    CAD_Topo_Sweep.pa0 = a0
    CAD_Topo_Sweep.pa1 = a1
    CAD_Topo.SweepAddArcPinned()
    CAD_Topo.SweepAddLine(n25, m25, n25, n25)
    CAD_Topo.SweepAddLine(n25, n25, m25, n25)
    CAD_Topo.SweepAddLine(m25, n25, m25, m25)

    host = CAD_Topo.ExtrudeContours()
    IfCondition EqualTo(host, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo.RebuildKind0Planes(host)
    CAD_Sys.Write(1, "extrude ok\n", 11)

    eds = Allocate(4096)
    top = Allocate(128)
    ne = CAD_Topo.SolidCollectEdges(host, eds, 256)
    nt = 0
    ncirc = 0
    i = 0
    WhileLoop LessThan(i, ne) {
        e = ArrayGet(eds, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            va = CAD_Store.Read(e, 0)
            vb = CAD_Store.Read(e, 1)
            IfCondition NotEqual(va, 0) ThenBlock: {
                IfCondition NotEqual(vb, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vb, 2), n20, 0), 1) ThenBlock: {
                            crv = CAD_Store.Read(e, 2)
                            ck = 0
                            IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
                            IfCondition EqualTo(ck, 2) ThenBlock: { ncirc = Add(ncirc, 1) }
                            IfCondition EqualTo(ck, 1) ThenBlock: {
                                ArraySet(top, nt, e)
                                nt = Add(nt, 1)
                            }
                        }
                    }
                }
            }
        }
        i = Add(i, 1)
    }
    CAD_Sys.Write(1, "top LINE n=", 11)
    PrintNumber(nt)
    CAD_Sys.Write(1, " CIRCLE n=", 10)
    PrintNumber(ncirc)
    CAD_Sys.Write(1, "\n", 1)
    IfCondition NotEqual(nt, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected 3 top LINEs\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(ncirc, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected top CIRCLE\n", 25)
        SystemCall(60, 1, 0, 0)
    }

    CAD_Sys.Write(1, "fillet 3 LINE R=8\n", 18)
    fil = CAD_Blend.FilletEdges(host, top, nt, n8)
    IfCondition EqualTo(fil, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL fillet returned 0\n", 23)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "fillet class=", 13)
    PrintNumber(CAD_Topo_State.fillet_class)
    CAD_Sys.Write(1, "\n", 1)

    // Lid Th–Th. Blocker nring=6 (short top, two ellipses, split gens).
    pl = Allocate(128)
    lid_short = 0
    lid_zbad = 0
    wall_full = 0
    wall_nring = 0
    sh = CAD_Store.Read(fil, 0)
    face = 0
    IfCondition NotEqual(sh, 0) ThenBlock: { face = CAD_Store.Read(sh, 0) }
    fg = 0
    WhileLoop LessThan(fg, 64) {
        IfCondition EqualTo(face, 0) ThenBlock: { fg = 64 }
        IfCondition NotEqual(face, 0) ThenBlock: {
            surf = CAD_Store.Read(face, 0)
            sk = 0
            IfCondition NotEqual(surf, 0) ThenBlock: { sk = CAD_Store.Read(surf, 0) }
            lp = CAD_Store.Read(face, 1)
            nring = 0
            IfCondition NotEqual(lp, 0) ThenBlock: { nring = CAD_Topo.LoopCountCoedges(lp) }
            IfCondition EqualTo(sk, 2) ThenBlock: {
                sr = 0
                IfCondition NotEqual(surf, 0) ThenBlock: { sr = CAD_Store.Read(surf, 13) }
                IfCondition EqualTo(CAD_Num.Le(n20, sr), 1) ThenBlock: {
                    wall_nring = nring
                    hd = 0
                    IfCondition NotEqual(lp, 0) ThenBlock: { hd = CAD_Store.Read(lp, 0) }
                    ce = hd
                    cg = 0
                    WhileLoop LessThan(cg, 16) {
                        IfCondition EqualTo(ce, 0) ThenBlock: { cg = 16 }
                        IfCondition NotEqual(ce, 0) ThenBlock: {
                            e = CAD_Store.Read(ce, 0)
                            IfCondition NotEqual(e, 0) ThenBlock: {
                                va = CAD_Store.Read(e, 0)
                                vb = CAD_Store.Read(e, 1)
                                crv = CAD_Store.Read(e, 2)
                                ck = 0
                                IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
                                IfCondition EqualTo(ck, 2) ThenBlock: {
                                    IfCondition NotEqual(va, 0) ThenBlock: {
                                        IfCondition NotEqual(vb, 0) ThenBlock: {
                                            za = CAD_Store.Read(va, 2)
                                            zb = CAD_Store.Read(vb, 2)
                                            IfCondition EqualTo(CAD_Num.IsEqual(za, n20, 0), 1) ThenBlock: {
                                                IfCondition EqualTo(CAD_Num.IsEqual(zb, n20, 0), 1) ThenBlock: {
                                                    xa = CAD_Store.Read(va, 0)
                                                    xb = CAD_Store.Read(vb, 0)
                                                    IfCondition EqualTo(CAD_Num.IsNeg(xa), 1) ThenBlock: { xa = Float_Sub(0, xa) }
                                                    IfCondition EqualTo(CAD_Num.IsNeg(xb), 1) ThenBlock: { xb = Float_Sub(0, xb) }
                                                    IfCondition EqualTo(CAD_Num.Le(n20, xa), 1) ThenBlock: {
                                                        IfCondition EqualTo(CAD_Num.Le(n20, xb), 1) ThenBlock: {
                                                            wall_full = 1
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            ce = CAD_Store.Read(ce, 2)
                            IfCondition EqualTo(ce, hd) ThenBlock: { cg = 16 }
                        }
                        cg = Add(cg, 1)
                    }
                }
            }
            plane_rc = CAD_Topo.FaceGetPlane(face, pl)
            IfCondition EqualTo(plane_rc, 0) ThenBlock: {
                nz = ArrayGet(pl, 12)
                IfCondition EqualTo(CAD_Num.IsNeg(nz), 1) ThenBlock: { nz = Float_Sub(0, nz) }
                IfCondition EqualTo(CAD_Num.Le(0x3FE0000000000000, nz), 1) ThenBlock: {
                    hd = 0
                    IfCondition NotEqual(lp, 0) ThenBlock: { hd = CAD_Store.Read(lp, 0) }
                    ce = hd
                    cg = 0
                    WhileLoop LessThan(cg, 16) {
                        IfCondition EqualTo(ce, 0) ThenBlock: { cg = 16 }
                        IfCondition NotEqual(ce, 0) ThenBlock: {
                            e = CAD_Store.Read(ce, 0)
                            IfCondition NotEqual(e, 0) ThenBlock: {
                                va = CAD_Store.Read(e, 0)
                                vb = CAD_Store.Read(e, 1)
                                crv = CAD_Store.Read(e, 2)
                                ck = 0
                                IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
                                IfCondition EqualTo(ck, 2) ThenBlock: {
                                    IfCondition NotEqual(va, 0) ThenBlock: {
                                        IfCondition NotEqual(vb, 0) ThenBlock: {
                                            za = CAD_Store.Read(va, 2)
                                            zb = CAD_Store.Read(vb, 2)
                                            IfCondition EqualTo(CAD_Num.IsEqual(za, n20, 0), 1) ThenBlock: {
                                                IfCondition EqualTo(CAD_Num.IsEqual(zb, n20, 0), 1) ThenBlock: {
                                                    sr = 0
                                                    IfCondition NotEqual(crv, 0) ThenBlock: { sr = CAD_Store.Read(crv, 10) }
                                                    IfCondition EqualTo(CAD_Num.Le(n20, sr), 1) ThenBlock: {
                                                        xa = CAD_Store.Read(va, 0)
                                                        xb = CAD_Store.Read(vb, 0)
                                                        IfCondition EqualTo(CAD_Num.IsNeg(xa), 1) ThenBlock: { xa = Float_Sub(0, xa) }
                                                        IfCondition EqualTo(CAD_Num.IsNeg(xb), 1) ThenBlock: { xb = Float_Sub(0, xb) }
                                                        IfCondition EqualTo(CAD_Num.Le(xa, n20), 1) ThenBlock: {
                                                            IfCondition EqualTo(CAD_Num.Le(xb, n20), 1) ThenBlock: {
                                                                lid_short = 1
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                at_lid = 0
                                IfCondition NotEqual(va, 0) ThenBlock: {
                                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 1) ThenBlock: { at_lid = 1 }
                                }
                                IfCondition NotEqual(vb, 0) ThenBlock: {
                                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vb, 2), n20, 0), 1) ThenBlock: { at_lid = 1 }
                                }
                                IfCondition EqualTo(at_lid, 1) ThenBlock: {
                                    IfCondition NotEqual(va, 0) ThenBlock: {
                                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 0) ThenBlock: { lid_zbad = 1 }
                                    }
                                    IfCondition NotEqual(vb, 0) ThenBlock: {
                                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vb, 2), n20, 0), 0) ThenBlock: { lid_zbad = 1 }
                                    }
                                }
                            }
                            ce = CAD_Store.Read(ce, 2)
                            IfCondition EqualTo(ce, hd) ThenBlock: { cg = 16 }
                        }
                        cg = Add(cg, 1)
                    }
                }
            }
            face = CAD_Store.Read(face, 3)
        }
        fg = Add(fg, 1)
    }
    Deallocate(pl, 128)
    CAD_Sys.Write(1, "lid_short=", 10)
    PrintNumber(lid_short)
    CAD_Sys.Write(1, " lid_zbad=", 10)
    PrintNumber(lid_zbad)
    CAD_Sys.Write(1, " wall_full=", 11)
    PrintNumber(wall_full)
    CAD_Sys.Write(1, " wall_nring=", 12)
    PrintNumber(wall_nring)
    CAD_Sys.Write(1, "\n", 1)
    IfCondition EqualTo(lid_short, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL lid CIRCLE not Th-Th\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(lid_zbad, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL lid vert not at pad Z\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(wall_full, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL blocker top still full\n", 28)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(wall_nring, 6) ThenBlock: {
        CAD_Sys.Write(1, "FAIL blocker nring want 6\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    mesh = Allocate(32)
    nt = CAD_Tess.MeshSolid(fil, 0x3FB999999999999A, mesh)
    CAD_Sys.Write(1, "mesh nt=", 8)
    PrintNumber(nt)
    CAD_Sys.Write(1, "\n", 1)
    // Same chord gate as the 1-line notch. Two-Th wall is nring=6
    // CylLoopUV; an earclip fan from Th chords the host cylinder.
    vbase = ArrayGet(mesh, 2)
    ibase = ArrayGet(mesh, 3)
    bad = 0
    worst = 0
    ti = 0
    half = 0x3FE0000000000000
    one = 0x3FF0000000000000
    qtr = 0x3FD0000000000000
    WhileLoop LessThan(ti, nt) {
        ia = ArrayGet(ibase, Multiply(ti, 3))
        ibb = ArrayGet(ibase, Add(Multiply(ti, 3), 1))
        ic = ArrayGet(ibase, Add(Multiply(ti, 3), 2))
        ax = ArrayGet(vbase, Multiply(ia, 3))
        ay = ArrayGet(vbase, Add(Multiply(ia, 3), 1))
        az = ArrayGet(vbase, Add(Multiply(ia, 3), 2))
        bx = ArrayGet(vbase, Multiply(ibb, 3))
        by = ArrayGet(vbase, Add(Multiply(ibb, 3), 1))
        bz = ArrayGet(vbase, Add(Multiply(ibb, 3), 2))
        cxv = ArrayGet(vbase, Multiply(ic, 3))
        cyv = ArrayGet(vbase, Add(Multiply(ic, 3), 1))
        cz = ArrayGet(vbase, Add(Multiply(ic, 3), 2))
        zlo = az
        zhi = az
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(bz, zlo)), 1) ThenBlock: { zlo = bz }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(cz, zlo)), 1) ThenBlock: { zlo = cz }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(zhi, bz)), 1) ThenBlock: { zhi = bz }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(zhi, cz)), 1) ThenBlock: { zhi = cz }
        IfCondition EqualTo(CAD_Num.Le(qtr, Float_Sub(zhi, zlo)), 1) ThenBlock: {
            da = CAD_Num.Hypot2(ax, Float_Sub(ay, cy))
            db = CAD_Num.Hypot2(bx, Float_Sub(by, cy))
            dc = CAD_Num.Hypot2(cxv, Float_Sub(cyv, cy))
            ad = Float_Sub(da, rr)
            IfCondition EqualTo(CAD_Num.IsNeg(ad), 1) ThenBlock: { ad = Float_Sub(0, ad) }
            bd = Float_Sub(db, rr)
            IfCondition EqualTo(CAD_Num.IsNeg(bd), 1) ThenBlock: { bd = Float_Sub(0, bd) }
            cd = Float_Sub(dc, rr)
            IfCondition EqualTo(CAD_Num.IsNeg(cd), 1) ThenBlock: { cd = Float_Sub(0, cd) }
            ona = CAD_Num.Le(ad, half)
            onb = CAD_Num.Le(bd, half)
            onc = CAD_Num.Le(cd, half)
            IfCondition EqualTo(ona, 1) ThenBlock: {
                IfCondition EqualTo(onb, 1) ThenBlock: {
                    IfCondition EqualTo(onc, 1) ThenBlock: {
                        mx = Float_Div(Float_Add(Float_Add(ax, bx), cxv), 0x4008000000000000)
                        my = Float_Div(Float_Add(Float_Add(ay, by), cyv), 0x4008000000000000)
                        dm = CAD_Num.Hypot2(mx, Float_Sub(my, cy))
                        dev = Float_Sub(dm, rr)
                        IfCondition EqualTo(CAD_Num.IsNeg(dev), 1) ThenBlock: { dev = Float_Sub(0, dev) }
                        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(worst, dev)), 1) ThenBlock: { worst = dev }
                        IfCondition EqualTo(CAD_Num.Le(one, dev), 1) ThenBlock: {
                            IfCondition LessThan(bad, 4) ThenBlock: {
                                CAD_Sys.Write(1, "chord ", 6)
                                PrintNumber(Float_ToInt(Float_Mul(ax, 0x408F400000000000)))
                                CAD_Sys.Write(1, ",", 1)
                                PrintNumber(Float_ToInt(Float_Mul(ay, 0x408F400000000000)))
                                CAD_Sys.Write(1, ",", 1)
                                PrintNumber(Float_ToInt(Float_Mul(az, 0x408F400000000000)))
                                CAD_Sys.Write(1, " | ", 3)
                                PrintNumber(Float_ToInt(Float_Mul(bx, 0x408F400000000000)))
                                CAD_Sys.Write(1, ",", 1)
                                PrintNumber(Float_ToInt(Float_Mul(by, 0x408F400000000000)))
                                CAD_Sys.Write(1, ",", 1)
                                PrintNumber(Float_ToInt(Float_Mul(bz, 0x408F400000000000)))
                                CAD_Sys.Write(1, " | ", 3)
                                PrintNumber(Float_ToInt(Float_Mul(cxv, 0x408F400000000000)))
                                CAD_Sys.Write(1, ",", 1)
                                PrintNumber(Float_ToInt(Float_Mul(cyv, 0x408F400000000000)))
                                CAD_Sys.Write(1, ",", 1)
                                PrintNumber(Float_ToInt(Float_Mul(cz, 0x408F400000000000)))
                                CAD_Sys.Write(1, " dev_um=", 8)
                                PrintNumber(Float_ToInt(Float_Mul(dev, 0x408F400000000000)))
                                CAD_Sys.Write(1, "\n", 1)
                            }
                            bad = Add(bad, 1)
                        }
                    }
                }
            }
        }
        ti = Add(ti, 1)
    }
    Deallocate(mesh, 32)
    CAD_Sys.Write(1, "wall chord bad=", 15)
    PrintNumber(bad)
    CAD_Sys.Write(1, " worst_um=", 10)
    PrintNumber(Float_ToInt(Float_Mul(worst, 0x408F400000000000)))
    CAD_Sys.Write(1, "\n", 1)
    IfCondition GreaterThan(bad, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL wall chord off cylinder\n", 29)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition LessThan(nt, 8) ThenBlock: {
        CAD_Sys.Write(1, "FAIL mesh empty\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition GreaterThan(nt, 5000) ThenBlock: {
        CAD_Sys.Write(1, "FAIL mesh funnel\n", 17)
        SystemCall(60, 1, 0, 0)
    }

    // Phase C: GUI live case — north inward arc, three selected LINEs.
    CAD_Sys.Write(1, "=== north 3-LINE + inward arc ===\n", 34)
    n80 = Float_FromInt(80)
    mn55 = Float_Sub(0, n55)
    // CCW: NE→NW along the inward minor arc, then west, south, east.
    a0n = CAD_Geom.Atan2(mn55, n25)
    a1n = CAD_Geom.Atan2(mn55, m25)
    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = n20
    CAD_Topo.SweepBeginWire()
    CAD_Topo_Sweep.px0 = 0
    CAD_Topo_Sweep.py0 = n80
    CAD_Topo_Sweep.px1 = rr
    CAD_Topo_Sweep.pa0 = a0n
    CAD_Topo_Sweep.pa1 = a1n
    CAD_Topo.SweepAddArcPinned()
    CAD_Topo.SweepAddLine(m25, n25, m25, m25)
    CAD_Topo.SweepAddLine(m25, m25, n25, m25)
    CAD_Topo.SweepAddLine(n25, m25, n25, n25)
    hostn = CAD_Topo.ExtrudeContours()
    IfCondition EqualTo(hostn, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL north extrude\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo.RebuildKind0Planes(hostn)
    nt = 0
    ncirc = 0
    i = 0
    ne = CAD_Topo.SolidCollectEdges(hostn, eds, 256)
    WhileLoop LessThan(i, ne) {
        e = ArrayGet(eds, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            va = CAD_Store.Read(e, 0)
            vb = CAD_Store.Read(e, 1)
            IfCondition NotEqual(va, 0) ThenBlock: {
                IfCondition NotEqual(vb, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vb, 2), n20, 0), 1) ThenBlock: {
                            crv = CAD_Store.Read(e, 2)
                            ck = 0
                            IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
                            IfCondition EqualTo(ck, 2) ThenBlock: { ncirc = Add(ncirc, 1) }
                            IfCondition EqualTo(ck, 1) ThenBlock: {
                                ArraySet(top, nt, e)
                                nt = Add(nt, 1)
                            }
                        }
                    }
                }
            }
        }
        i = Add(i, 1)
    }
    CAD_Sys.Write(1, "north LINE n=", 13)
    PrintNumber(nt)
    CAD_Sys.Write(1, " CIRCLE n=", 10)
    PrintNumber(ncirc)
    CAD_Sys.Write(1, "\n", 1)
    IfCondition NotEqual(nt, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL north expected 3 top LINEs\n", 32)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(ncirc, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL north expected top CIRCLE\n", 31)
        SystemCall(60, 1, 0, 0)
    }
    filn = CAD_Blend.FilletEdges(hostn, top, nt, n8)
    IfCondition EqualTo(filn, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL north fillet returned 0\n", 29)
        SystemCall(60, 1, 0, 0)
    }
    lid_short = 0
    lid_zbad = 0
    wall_full = 0
    wall_nring = 0
    pl = Allocate(128)
    sh = CAD_Store.Read(filn, 0)
    face = 0
    IfCondition NotEqual(sh, 0) ThenBlock: { face = CAD_Store.Read(sh, 0) }
    fg = 0
    WhileLoop LessThan(fg, 64) {
        IfCondition EqualTo(face, 0) ThenBlock: { fg = 64 }
        IfCondition NotEqual(face, 0) ThenBlock: {
            surf = CAD_Store.Read(face, 0)
            sk = 0
            IfCondition NotEqual(surf, 0) ThenBlock: { sk = CAD_Store.Read(surf, 0) }
            lp = CAD_Store.Read(face, 1)
            nring = 0
            IfCondition NotEqual(lp, 0) ThenBlock: { nring = CAD_Topo.LoopCountCoedges(lp) }
            IfCondition EqualTo(sk, 2) ThenBlock: {
                sr = 0
                IfCondition NotEqual(surf, 0) ThenBlock: { sr = CAD_Store.Read(surf, 13) }
                IfCondition EqualTo(CAD_Num.Le(n20, sr), 1) ThenBlock: {
                    wall_nring = nring
                    hd = 0
                    IfCondition NotEqual(lp, 0) ThenBlock: { hd = CAD_Store.Read(lp, 0) }
                    ce = hd
                    cg = 0
                    WhileLoop LessThan(cg, 16) {
                        IfCondition EqualTo(ce, 0) ThenBlock: { cg = 16 }
                        IfCondition NotEqual(ce, 0) ThenBlock: {
                            e = CAD_Store.Read(ce, 0)
                            IfCondition NotEqual(e, 0) ThenBlock: {
                                va = CAD_Store.Read(e, 0)
                                vb = CAD_Store.Read(e, 1)
                                crv = CAD_Store.Read(e, 2)
                                ck = 0
                                IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
                                IfCondition EqualTo(ck, 2) ThenBlock: {
                                    IfCondition NotEqual(va, 0) ThenBlock: {
                                        IfCondition NotEqual(vb, 0) ThenBlock: {
                                            za = CAD_Store.Read(va, 2)
                                            zb = CAD_Store.Read(vb, 2)
                                            IfCondition EqualTo(CAD_Num.IsEqual(za, n20, 0), 1) ThenBlock: {
                                                IfCondition EqualTo(CAD_Num.IsEqual(zb, n20, 0), 1) ThenBlock: {
                                                    xa = CAD_Store.Read(va, 0)
                                                    xb = CAD_Store.Read(vb, 0)
                                                    IfCondition EqualTo(CAD_Num.IsNeg(xa), 1) ThenBlock: { xa = Float_Sub(0, xa) }
                                                    IfCondition EqualTo(CAD_Num.IsNeg(xb), 1) ThenBlock: { xb = Float_Sub(0, xb) }
                                                    IfCondition EqualTo(CAD_Num.Le(n20, xa), 1) ThenBlock: {
                                                        IfCondition EqualTo(CAD_Num.Le(n20, xb), 1) ThenBlock: {
                                                            wall_full = 1
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            ce = CAD_Store.Read(ce, 2)
                            IfCondition EqualTo(ce, hd) ThenBlock: { cg = 16 }
                        }
                        cg = Add(cg, 1)
                    }
                }
            }
            plane_rc = CAD_Topo.FaceGetPlane(face, pl)
            IfCondition EqualTo(plane_rc, 0) ThenBlock: {
                nz = ArrayGet(pl, 12)
                IfCondition EqualTo(CAD_Num.IsNeg(nz), 1) ThenBlock: { nz = Float_Sub(0, nz) }
                IfCondition EqualTo(CAD_Num.Le(0x3FE0000000000000, nz), 1) ThenBlock: {
                    hd = 0
                    IfCondition NotEqual(lp, 0) ThenBlock: { hd = CAD_Store.Read(lp, 0) }
                    ce = hd
                    cg = 0
                    WhileLoop LessThan(cg, 16) {
                        IfCondition EqualTo(ce, 0) ThenBlock: { cg = 16 }
                        IfCondition NotEqual(ce, 0) ThenBlock: {
                            e = CAD_Store.Read(ce, 0)
                            IfCondition NotEqual(e, 0) ThenBlock: {
                                va = CAD_Store.Read(e, 0)
                                vb = CAD_Store.Read(e, 1)
                                crv = CAD_Store.Read(e, 2)
                                ck = 0
                                IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
                                IfCondition EqualTo(ck, 2) ThenBlock: {
                                    IfCondition NotEqual(va, 0) ThenBlock: {
                                        IfCondition NotEqual(vb, 0) ThenBlock: {
                                            za = CAD_Store.Read(va, 2)
                                            zb = CAD_Store.Read(vb, 2)
                                            IfCondition EqualTo(CAD_Num.IsEqual(za, n20, 0), 1) ThenBlock: {
                                                IfCondition EqualTo(CAD_Num.IsEqual(zb, n20, 0), 1) ThenBlock: {
                                                    sr = 0
                                                    IfCondition NotEqual(crv, 0) ThenBlock: { sr = CAD_Store.Read(crv, 10) }
                                                    IfCondition EqualTo(CAD_Num.Le(n20, sr), 1) ThenBlock: {
                                                        xa = CAD_Store.Read(va, 0)
                                                        xb = CAD_Store.Read(vb, 0)
                                                        IfCondition EqualTo(CAD_Num.IsNeg(xa), 1) ThenBlock: { xa = Float_Sub(0, xa) }
                                                        IfCondition EqualTo(CAD_Num.IsNeg(xb), 1) ThenBlock: { xb = Float_Sub(0, xb) }
                                                        IfCondition EqualTo(CAD_Num.Le(xa, n20), 1) ThenBlock: {
                                                            IfCondition EqualTo(CAD_Num.Le(xb, n20), 1) ThenBlock: {
                                                                lid_short = 1
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                at_lid = 0
                                IfCondition NotEqual(va, 0) ThenBlock: {
                                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 1) ThenBlock: { at_lid = 1 }
                                }
                                IfCondition NotEqual(vb, 0) ThenBlock: {
                                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vb, 2), n20, 0), 1) ThenBlock: { at_lid = 1 }
                                }
                                IfCondition EqualTo(at_lid, 1) ThenBlock: {
                                    IfCondition NotEqual(va, 0) ThenBlock: {
                                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 0) ThenBlock: { lid_zbad = 1 }
                                    }
                                    IfCondition NotEqual(vb, 0) ThenBlock: {
                                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vb, 2), n20, 0), 0) ThenBlock: { lid_zbad = 1 }
                                    }
                                }
                            }
                            ce = CAD_Store.Read(ce, 2)
                            IfCondition EqualTo(ce, hd) ThenBlock: { cg = 16 }
                        }
                        cg = Add(cg, 1)
                    }
                }
            }
            face = CAD_Store.Read(face, 3)
        }
        fg = Add(fg, 1)
    }
    CAD_Sys.Write(1, "north lid_short=", 16)
    PrintNumber(lid_short)
    CAD_Sys.Write(1, " lid_zbad=", 10)
    PrintNumber(lid_zbad)
    CAD_Sys.Write(1, " wall_full=", 11)
    PrintNumber(wall_full)
    CAD_Sys.Write(1, " wall_nring=", 12)
    PrintNumber(wall_nring)
    CAD_Sys.Write(1, "\n", 1)
    IfCondition EqualTo(lid_short, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL north lid CIRCLE not Th-Th\n", 32)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(lid_zbad, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL north lid vert not at pad Z\n", 33)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(wall_full, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL north blocker top still full\n", 34)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(wall_nring, 6) ThenBlock: {
        CAD_Sys.Write(1, "FAIL north blocker nring want 6\n", 32)
        SystemCall(60, 1, 0, 0)
    }
    Deallocate(pl, 128)
    // Tess_State.samp sticks after the south MeshSolid; a second
    // MeshSolid in this process SEGV'd in SampleCurve PATH=PARAM.
    // North lid planarity / nring=6 is the degeneration gate.
    CAD_Sys.Write(1, "north topo ok\n", 14)

    IfCondition NotEqual(CAD_IO.ExportSTEP(fil, "test-stl/cad_fillet_3line_arc.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL STEP\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "FILLET 3LINE ARC OK\n", 20)
    Deallocate(top, 128)
    Deallocate(eds, 4096)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
