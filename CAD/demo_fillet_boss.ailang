// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_Tess

SubRoutine.Main {
    CAD_Sys.Write(1, "fillet boss base\n", 17)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n20 = 0x4034000000000000
    n50 = 0x4049000000000000
    n0 = 0
    n10 = 0x4024000000000000
    n8 = 0x4020000000000000
    xy = Allocate(64)
    ArraySet(xy, 0, Float_Sub(n0, n50))
    ArraySet(xy, 1, Float_Sub(n0, n50))
    ArraySet(xy, 2, n50)
    ArraySet(xy, 3, Float_Sub(n0, n50))
    ArraySet(xy, 4, n50)
    ArraySet(xy, 5, n50)
    ArraySet(xy, 6, Float_Sub(n0, n50))
    ArraySet(xy, 7, n50)
    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, xy, 4)
    host = CAD_Feat.ExtrudeProfile(hsk, n20)
    tsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(tsk, n0, n0, n10)
    tool = CAD_Feat.ExtrudeProfile(tsk, n20)
    dlt = Allocate(32)
    ArraySet(dlt, 0, n0)
    ArraySet(dlt, 1, n0)
    ArraySet(dlt, 2, n20)
    CAD_Topo.TranslateSolid(tool, dlt)
    Deallocate(dlt, 32)
    body = CAD_Topo.CompoundAdd(host, tool)
    // first circular edge on the tool/host
    eds = Allocate(4096)
    ne = CAD_Topo.SolidCollectEdges(body, eds, 256)
    eh = 0
    i = 0
    WhileLoop LessThan(i, ne) {
        e = ArrayGet(eds, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            crv = CAD_Store.Read(e, 2)
            IfCondition NotEqual(crv, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(crv, 0), 2) ThenBlock: {
                    IfCondition EqualTo(eh, 0) ThenBlock: { eh = e }
                }
            }
        }
        i = Add(i, 1)
    }
    Deallocate(eds, 4096)
    fil = 0
    IfCondition NotEqual(eh, 0) ThenBlock: {
        fil = CAD_Blend.FilletEdge(body, eh, n8)
    }
    ns = 0
    IfCondition NotEqual(fil, 0) ThenBlock: {
        ns = CAD_Topo.SolidCountShells(fil)
    }
    mesh = Allocate(48)
    nt = 0
    IfCondition NotEqual(fil, 0) ThenBlock: {
        nt = CAD_Tess.MeshSolid(fil, 0, mesh)
    }
    PrintMessage("ne=")
    PrintNumber(ne)
    PrintMessage(" eh=")
    PrintNumber(eh)
    PrintMessage(" fil=")
    PrintNumber(fil)
    PrintMessage(" shells=")
    PrintNumber(ns)
    PrintMessage(" nt=")
    PrintNumber(nt)
    PrintMessage("\n")
    pass = 0
    IfCondition NotEqual(fil, 0) ThenBlock: {
        IfCondition GreaterEqual(ns, 2) ThenBlock: {
            IfCondition GreaterThan(nt, 100) ThenBlock: { pass = 1 }
        }
    }
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "FILLET BOSS PASS\n", 17)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "FILLET BOSS FAIL\n", 17)
    }
    Deallocate(mesh, 48)
    Deallocate(xy, 64)
    SystemCall(60, Subtract(1, pass), 0, 0)
}
RunTask(Main)
