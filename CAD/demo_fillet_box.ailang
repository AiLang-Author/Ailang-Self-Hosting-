// Constant-R vertical edge fillets on a box → B-Rep walk STEP.
// DIM: plate 40x30x15 mm, fillet R=5 mm on all 4 vertical corners.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== vertical edge fillets ===\n", 30)
    CAD_Sys.Write(1, "DIM plate 40x30x15 mm\n", 22)
    CAD_Sys.Write(1, "DIM fillet R=5 mm on 4 vertical edges\n", 39)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    // 40 x 30 x 15 box
    body = CAD_Script.CreateBox(0x4044000000000000, 0x403E000000000000, 0x402E000000000000)
    // R = 5
    r = 0x4014000000000000
    fil = CAD_Blend.FilletBoxVertical(body, r)
    IfCondition EqualTo(fil, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL FilletBoxVertical\n", 23)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Store.Read(fil, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL fillet no shell\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(fil, "test-stl/cad_fillet_box_vert.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL fillet STEP\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote cad_fillet_box_vert.stp\n", 30)
    CAD_Sys.Write(1, "FILLET VERT OK\n", 15)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
