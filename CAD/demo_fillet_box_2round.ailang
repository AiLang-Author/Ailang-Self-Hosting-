// Test: Box with 2 front 15mm rounded corners and 2 rear sharp 90-degree corners.
// Top rim selection has 3 LINE edges and 2 ARC edges.
// Rear 2 sharp corners must cope cleanly without degenerate geometry or vertex spheres.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_Tess

SubRoutine.Main {
    CAD_Sys.Write(1, "=== Box with 2 rounded corners + 2 sharp rear corners ===\n", 58)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n25 = 0x4039000000000000 // 25.0
    n10 = 0x4024000000000000 // 10.0
    n15 = 0x402E000000000000 // 15.0
    n20 = 0x4034000000000000 // 20.0
    n3 = 0x4008000000000000  // 3.0
    n0 = 0
    half_pi = 0x3FF921FB54442D18
    pi = 0x400921FB54442D18

    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = n20
    CAD_Topo.SweepBeginWire()
    // Rear edge (LINE): (-25, -25) to (25, -25)
    CAD_Topo.SweepAddLine(Float_Sub(0, n25), Float_Sub(0, n25), n25, Float_Sub(0, n25))
    // Right edge (LINE): (25, -25) to (25, 10)
    CAD_Topo.SweepAddLine(n25, Float_Sub(0, n25), n25, n10)
    // Front-Right arc (ARC): center (10, 10), r=15, from 0 to half_pi -> (25, 10) to (10, 25)
    CAD_Topo.SweepAddArc(n10, n10, n15, n0, half_pi)
    // Front edge (LINE): (10, 25) to (-10, 25)
    CAD_Topo.SweepAddLine(n10, n25, Float_Sub(0, n10), n25)
    // Front-Left arc (ARC): center (-10, 10), r=15, from half_pi to pi -> (-10, 25) to (-25, 10)
    CAD_Topo.SweepAddArc(Float_Sub(0, n10), n10, n15, half_pi, pi)
    // Left edge (LINE): (-25, 10) to (-25, -25)
    CAD_Topo.SweepAddLine(Float_Sub(0, n25), n10, Float_Sub(0, n25), Float_Sub(0, n25))

    host = CAD_Topo.ExtrudeContours()
    IfCondition EqualTo(host, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo.RebuildKind0Planes(host)

    eds = Allocate(4096)
    top = Allocate(128)
    ne = CAD_Topo.SolidCollectEdges(host, eds, 256)
    nt = 0
    i = 0
    WhileLoop LessThan(i, ne) {
        e = ArrayGet(eds, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            va = CAD_Store.Read(e, 0)
            vb = CAD_Store.Read(e, 1)
            IfCondition NotEqual(va, 0) ThenBlock: {
                IfCondition NotEqual(vb, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vb, 2), n20, 0), 1) ThenBlock: {
                            ArraySet(top, nt, e)
                            nt = Add(nt, 1)
                        }
                    }
                }
            }
        }
        i = Add(i, 1)
    }
    PrintMessage("top outer edges n=")
    PrintNumber(nt)
    PrintMessage("\n")

    fil = CAD_Blend.FilletEdges(host, top, nt, n3)
    IfCondition EqualTo(fil, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL fillet\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    PrintMessage("fillet class=")
    PrintNumber(CAD_Topo_State.fillet_class)
    PrintMessage("\n")

    n_cyl = 0
    n_tor = 0
    n_sph = 0
    sh = CAD_Store.Read(fil, 0)
    WhileLoop NotEqual(sh, 0) {
        fc = CAD_Store.Read(sh, 0)
        WhileLoop NotEqual(fc, 0) {
            surf = CAD_Store.Read(fc, 0)
            IfCondition NotEqual(surf, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 2) ThenBlock: { n_cyl = Add(n_cyl, 1) }
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 3) ThenBlock: { n_sph = Add(n_sph, 1) }
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 4) ThenBlock: { n_tor = Add(n_tor, 1) }
            }
            fc = CAD_Store.Read(fc, 3)
        }
        sh = CAD_Store.Read(sh, 2)
    }
    PrintMessage("cyl=")
    PrintNumber(n_cyl)
    PrintMessage(" tor=")
    PrintNumber(n_tor)
    PrintMessage(" sph=")
    PrintNumber(n_sph)
    mesh = Allocate(48)
    nmesh = CAD_Tess.MeshSolid(fil, 0, mesh)
    PrintMessage("nt=")
    PrintNumber(nmesh)
    PrintMessage("\n")
    IfCondition EqualTo(mesh, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL tessellation\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    PrintMessage("PASS box 2-round + 2-sharp corners fillet\n")
}
RunTask(Main)
