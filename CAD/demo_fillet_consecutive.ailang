// Test: 3 consecutive fillet operations in sequence to verify state isolation:
// Op 1: Cube top sharp fillet (4 straight LINE edges)
// Op 2: Cylinder round fillet / inner cove fillet (setting fillet_concave state)
// Op 3: Box with 2 15mm rounded corners + 2 rear sharp corners (mixed 3 LINEs + 2 ARCs)

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_Tess

SubRoutine.Main {
    CAD_Sys.Write(1, "=== Consecutive Fillet State Isolation Test ===\n", 48)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n25 = 0x4039000000000000 // 25.0
    n10 = 0x4024000000000000 // 10.0
    n15 = 0x402E000000000000 // 15.0
    n20 = 0x4034000000000000 // 20.0
    n3 = 0x4008000000000000  // 3.0
    n0 = 0
    half_pi = 0x3FF921FB54442D18
    pi = 0x400921FB54442D18

    mn = Allocate(24)
    mx = Allocate(24)
    out = Allocate(8)
    ArraySet(mn, 0, 0)
    ArraySet(mn, 1, 0)
    ArraySet(mn, 2, 0)
    ArraySet(mx, 0, n20)
    ArraySet(mx, 1, n20)
    ArraySet(mx, 2, n20)
    box = CAD_Topo.MakeBoxSolid(mn, mx, out)
    eds1 = Allocate(4096)
    top1 = Allocate(128)
    ne1 = CAD_Topo.SolidCollectEdges(box, eds1, 256)
    nt1 = 0
    i = 0
    WhileLoop LessThan(i, ne1) {
        e = ArrayGet(eds1, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            va = CAD_Store.Read(e, 0)
            vb = CAD_Store.Read(e, 1)
            IfCondition NotEqual(va, 0) ThenBlock: {
                IfCondition NotEqual(vb, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vb, 2), n20, 0), 1) ThenBlock: {
                            ArraySet(top1, nt1, e)
                            nt1 = Add(nt1, 1)
                        }
                    }
                }
            }
        }
        i = Add(i, 1)
    }
    fil1 = CAD_Blend.FilletEdges(box, top1, nt1, n3)
    IfCondition EqualTo(fil1, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL Op 1 cube fillet\n", 22)
        SystemCall(60, 1, 0, 0)
    }
    PrintMessage("Op 1 Cube Fillet OK\n")

    // Simulate an inner/cove fillet setting fillet_concave = 1
    CAD_Topo_State.fillet_concave = 1

    // --- OP 2: Box with 2 15mm rounded corners ---
    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = n20
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddLine(Float_Sub(0, n25), Float_Sub(0, n25), n25, Float_Sub(0, n25))
    CAD_Topo.SweepAddLine(n25, Float_Sub(0, n25), n25, n10)
    CAD_Topo.SweepAddArc(n10, n10, n15, n0, half_pi)
    CAD_Topo.SweepAddLine(n10, n25, Float_Sub(0, n10), n25)
    CAD_Topo.SweepAddArc(Float_Sub(0, n10), n10, n15, half_pi, pi)
    CAD_Topo.SweepAddLine(Float_Sub(0, n25), n10, Float_Sub(0, n25), Float_Sub(0, n25))

    host = CAD_Topo.ExtrudeContours()
    CAD_Topo.RebuildKind0Planes(host)

    eds2 = Allocate(4096)
    top2 = Allocate(128)
    ne2 = CAD_Topo.SolidCollectEdges(host, eds2, 256)
    nt2 = 0
    i = 0
    WhileLoop LessThan(i, ne2) {
        e = ArrayGet(eds2, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            va = CAD_Store.Read(e, 0)
            vb = CAD_Store.Read(e, 1)
            IfCondition NotEqual(va, 0) ThenBlock: {
                IfCondition NotEqual(vb, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vb, 2), n20, 0), 1) ThenBlock: {
                            ArraySet(top2, nt2, e)
                            nt2 = Add(nt2, 1)
                        }
                    }
                }
            }
        }
        i = Add(i, 1)
    }

    fil2 = CAD_Blend.FilletEdges(host, top2, nt2, n3)
    IfCondition EqualTo(fil2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL Op 2 mixed fillet after concave state\n", 43)
        SystemCall(60, 1, 0, 0)
    }
    PrintMessage("Op 2 Mixed Fillet class=")
    PrintNumber(CAD_Topo_State.fillet_class)
    PrintMessage("\n")

    mesh = Allocate(48)
    nmesh = CAD_Tess.MeshSolid(fil2, 0, mesh)
    PrintMessage("nmesh=")
    PrintNumber(nmesh)
    PrintMessage("\n")

    IfCondition GreaterThan(nmesh, 50) ThenBlock: {
        PrintMessage("PASS consecutive fillet state isolation test\n")
    }
}
RunTask(Main)
