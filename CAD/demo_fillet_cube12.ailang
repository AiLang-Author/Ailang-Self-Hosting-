// 50x50x50 cube. Fillet every edge at R=8.
// Eight corners are spherical octants. Twelve edges are quarter cylinders.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_Tess

SubRoutine.Main {
    PrintMessage("=== cube 12 edges R=8 ===\n")
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n25 = 0x4039000000000000
    n50 = 0x4049000000000000
    n8 = 0x4020000000000000
    m25 = Float_Sub(0, n25)

    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = n50
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddLine(m25, m25, n25, m25)
    CAD_Topo.SweepAddLine(n25, m25, n25, n25)
    CAD_Topo.SweepAddLine(n25, n25, m25, n25)
    CAD_Topo.SweepAddLine(m25, n25, m25, m25)
    host = CAD_Topo.ExtrudeContours()
    IfCondition EqualTo(host, 0) ThenBlock: {
        PrintMessage("FAIL extrude\n")
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo.RebuildKind0Planes(host)

    eds = Allocate(4096)
    sel = Allocate(128)
    ne = CAD_Topo.SolidCollectEdges(host, eds, 256)
    nt = 0
    i = 0
    WhileLoop LessThan(i, ne) {
        e = ArrayGet(eds, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            crv = CAD_Store.Read(e, 2)
            ck = 0
            IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
            IfCondition EqualTo(ck, 1) ThenBlock: {
                ArraySet(sel, nt, e)
                nt = Add(nt, 1)
            }
        }
        i = Add(i, 1)
    }
    PrintMessage("picked=")
    PrintNumber(nt)
    PrintMessage("\n")
    IfCondition NotEqual(nt, 12) ThenBlock: {
        PrintMessage("FAIL expected 12 edges\n")
        SystemCall(60, 1, 0, 0)
    }
    fil = CAD_Blend.FilletEdges(host, sel, 12, n8)
    PrintMessage("fil=")
    PrintNumber(fil)
    PrintMessage(" class=")
    PrintNumber(CAD_Topo_State.fillet_class)
    PrintMessage(" reason=")
    PrintNumber(CAD_Topo_State.fillet_reason)
    PrintMessage("\n")
    IfCondition EqualTo(fil, 0) ThenBlock: {
        PrintMessage("CUBE12 FAIL fillet\n")
        SystemCall(60, 1, 0, 0)
    }
    nf = CAD_Topo.SolidCountFaces(fil)
    PrintMessage("faces=")
    PrintNumber(nf)
    PrintMessage("\n")

    mesh = Allocate(48)
    nmesh = CAD_Tess.MeshSolid(fil, 0, mesh)
    PrintMessage("nmesh=")
    PrintNumber(nmesh)
    PrintMessage("\n")

    cyl = 0
    tor = 0
    sph = 0
    cope = 0
    sh = CAD_Store.Read(fil, 0)
    WhileLoop NotEqual(sh, 0) {
        fc = CAD_Store.Read(sh, 0)
        WhileLoop NotEqual(fc, 0) {
            surf = CAD_Store.Read(fc, 0)
            sk = 0
            IfCondition NotEqual(surf, 0) ThenBlock: { sk = CAD_Store.Read(surf, 0) }
            IfCondition EqualTo(sk, 2) ThenBlock: { cyl = Add(cyl, 1) }
            IfCondition EqualTo(sk, 3) ThenBlock: { sph = Add(sph, 1) }
            IfCondition EqualTo(sk, 4) ThenBlock: { tor = Add(tor, 1) }
            IfCondition EqualTo(sk, 5) ThenBlock: { cope = Add(cope, 1) }
            fc = CAD_Store.Read(fc, 3)
        }
        sh = CAD_Store.Read(sh, 2)
    }
    PrintMessage("cyl=")
    PrintNumber(cyl)
    PrintMessage(" tor=")
    PrintNumber(tor)
    PrintMessage(" sph=")
    PrintNumber(sph)
    PrintMessage(" cope=")
    PrintNumber(cope)
    PrintMessage("\n")

    ne2 = CAD_Topo.SolidCollectEdges(fil, eds, 256)
    naked = 0
    i = 0
    WhileLoop LessThan(i, ne2) {
        e = ArrayGet(eds, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(e, 3), 0) ThenBlock: { naked = Add(naked, 1) }
            IfCondition NotEqual(CAD_Store.Read(e, 3), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(e, 4), 0) ThenBlock: { naked = Add(naked, 1) }
            }
        }
        i = Add(i, 1)
    }

    gap = 0
    sh = CAD_Store.Read(fil, 0)
    WhileLoop NotEqual(sh, 0) {
        fc = CAD_Store.Read(sh, 0)
        WhileLoop NotEqual(fc, 0) {
            lp = CAD_Store.Read(fc, 1)
            IfCondition NotEqual(lp, 0) ThenBlock: {
                ce = CAD_Store.Read(lp, 0)
                hd = ce
                g = 0
                WhileLoop LessThan(g, 32) {
                    IfCondition EqualTo(ce, 0) ThenBlock: { g = 32 }
                    IfCondition NotEqual(ce, 0) ThenBlock: {
                        e = CAD_Store.Read(ce, 0)
                        org = CAD_Store.Read(ce, 5)
                        nxt = CAD_Store.Read(ce, 2)
                        endv = 0
                        on = 0
                        IfCondition NotEqual(e, 0) ThenBlock: {
                            endv = CAD_Store.Read(e, 0)
                            IfCondition EqualTo(endv, org) ThenBlock: {
                                endv = CAD_Store.Read(e, 1)
                                on = 1
                            }
                            IfCondition EqualTo(CAD_Store.Read(e, 1), org) ThenBlock: { on = 1 }
                        }
                        norg = 0
                        IfCondition NotEqual(nxt, 0) ThenBlock: { norg = CAD_Store.Read(nxt, 5) }
                        IfCondition EqualTo(on, 0) ThenBlock: { gap = Add(gap, 1) }
                        IfCondition EqualTo(on, 1) ThenBlock: {
                            IfCondition NotEqual(endv, norg) ThenBlock: { gap = Add(gap, 1) }
                        }
                        ce = nxt
                        IfCondition EqualTo(ce, hd) ThenBlock: { g = 32 }
                    }
                    g = Add(g, 1)
                }
            }
            fc = CAD_Store.Read(fc, 3)
        }
        sh = CAD_Store.Read(sh, 2)
    }
    PrintMessage("edges=")
    PrintNumber(ne2)
    PrintMessage(" naked=")
    PrintNumber(naked)
    PrintMessage(" gap=")
    PrintNumber(gap)
    PrintMessage("\n")
    IfCondition NotEqual(sph, 8) ThenBlock: {
        PrintMessage("CUBE12 FAIL sph\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(cyl, 12) ThenBlock: {
        PrintMessage("CUBE12 FAIL cyl\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(tor, 0) ThenBlock: {
        PrintMessage("CUBE12 FAIL tor\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(cope, 0) ThenBlock: {
        PrintMessage("CUBE12 FAIL cope\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(naked, 0) ThenBlock: {
        PrintMessage("CUBE12 FAIL naked\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(gap, 0) ThenBlock: {
        PrintMessage("CUBE12 FAIL gap\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition LessThan(nmesh, 1) ThenBlock: {
        PrintMessage("CUBE12 FAIL mesh\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Topo_State.fillet_reason, 0) ThenBlock: {
        PrintMessage("CUBE12 FAIL reason\n")
        SystemCall(60, 1, 0, 0)
    }
    PrintMessage("CUBE12 OK\n")
}
RunTask(Main)
