// C3: plane–cyl fillet — cylinder top circular rim (convex outer)

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== Plane-cyl fillet (cyl top rim) ===\n", 38)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    // cylinder r=15 h=30, fillet R=4 on top rim
    body = CAD_Script.CreateCylinder(Float_FromInt(15), Float_FromInt(30))
    IfCondition EqualTo(body, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL cyl\n", 9)
        SystemCall(60, 1, 0, 0)
    }
    edges = Allocate(1024)
    ne = CAD_Topo.SolidCollectEdges(body, edges, 32)
    // find top circular edge: verts at z=h, closed or circle curve
    found = 0
    j = 0
    WhileLoop LessThan(j, ne) {
        ed = ArrayGet(edges, j)
        v0 = CAD_Store.Read(ed, 0)
        v1 = CAD_Store.Read(ed, 1)
        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v0, 2), Float_FromInt(30), 0), 1) ThenBlock: {
            curv = CAD_Store.Read(ed, 2)
            IfCondition NotEqual(curv, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(curv, 0), 2) ThenBlock: {
                    found = ed
                    j = ne
                }
            }
            IfCondition EqualTo(found, 0) ThenBlock: {
                IfCondition EqualTo(v0, v1) ThenBlock: {
                    found = ed
                    j = ne
                }
            }
        }
        j = Add(j, 1)
    }
    Deallocate(edges, 1024)
    IfCondition EqualTo(found, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL top rim edge\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    h = CAD_Blend.FilletEdge(body, found, Float_FromInt(4))
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL fillet\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(h, "test-stl/cad_fillet_cyl_top.stp")
    CAD_View.SetWire(0)
    CAD_View.SetViewMode(0)
    CAD_View.RenderSolidToBMP(h, 400, 350, "test-stl/cad_view_fillet_cyl_top.bmp")
    CAD_Sys.Write(1, "top rim fillet ok\n", 18)

    // direct builder path
    out = Allocate(16)
    h2 = CAD_Topo.MakeCylinderTopFillet(Float_FromInt(12), Float_FromInt(25), Float_FromInt(3), out)
    Deallocate(out, 16)
    IfCondition EqualTo(h2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL direct builder\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(h2, "test-stl/cad_fillet_cyl_direct.stp")
    CAD_View.RenderSolidToBMP(h2, 400, 350, "test-stl/cad_view_fillet_cyl_direct.bmp")
    CAD_Sys.Write(1, "direct builder ok\n", 18)

    // negatives
    body2 = CAD_Script.CreateCylinder(Float_FromInt(10), Float_FromInt(20))
    edges = Allocate(1024)
    ne = CAD_Topo.SolidCollectEdges(body2, edges, 32)
    found = 0
    j = 0
    WhileLoop LessThan(j, ne) {
        ed = ArrayGet(edges, j)
        v0 = CAD_Store.Read(ed, 0)
        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v0, 2), Float_FromInt(20), 0), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(ed, 0), CAD_Store.Read(ed, 1)) ThenBlock: {
                found = ed
                j = ne
            }
            curv = CAD_Store.Read(ed, 2)
            IfCondition NotEqual(curv, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(curv, 0), 2) ThenBlock: {
                    found = ed
                    j = ne
                }
            }
        }
        j = Add(j, 1)
    }
    Deallocate(edges, 1024)
    // R >= r refuse
    IfCondition NotEqual(CAD_Blend.FilletEdge(body2, found, Float_FromInt(12)), 0) ThenBlock: {
        CAD_Sys.Write(1, "NEG FAIL R>=r\n", 14)
        SystemCall(60, 1, 0, 0)
    }
    // R >= h refuse
    IfCondition NotEqual(CAD_Blend.FilletEdge(body2, found, Float_FromInt(25)), 0) ThenBlock: {
        CAD_Sys.Write(1, "NEG FAIL R>=h\n", 14)
        SystemCall(60, 1, 0, 0)
    }
    // box edge still plane-plane (compat)
    box = CAD_Script.CreateBox(Float_FromInt(20), Float_FromInt(20), Float_FromInt(20))
    edges = Allocate(1024)
    ne = CAD_Topo.SolidCollectEdges(box, edges, 32)
    bed = 0
    j = 0
    WhileLoop LessThan(j, ne) {
        ed = ArrayGet(edges, j)
        v0 = CAD_Store.Read(ed, 0)
        v1 = CAD_Store.Read(ed, 1)
        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v0, 0), CAD_Store.Read(v1, 0), 0), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v0, 1), CAD_Store.Read(v1, 1), 0), 1) ThenBlock: {
                bed = ed
                j = ne
            }
        }
        j = Add(j, 1)
    }
    Deallocate(edges, 1024)
    hb = CAD_Blend.FilletEdge(box, bed, Float_FromInt(3))
    IfCondition EqualTo(hb, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL plane-plane compat\n", 24)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "neg + plane-plane ok\n", 21)

    CAD_Sys.Write(1, "FILLET CYL OK\n", 14)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
