// Circle pad glued on a plate, fillet the inner CIRCLE (class 6 torus cove).
// Gate: glue 1 shell + inner, class=6, 1 TOR, 0 SPH, 1 CYL, tess.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_Tess

SubRoutine.Main {
    CAD_Sys.Write(1, "=== cyl join cove torus ===\n", 28)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n50 = 0x4049000000000000
    n25 = 0x4039000000000000
    n20 = 0x4034000000000000
    n8 = 0x4020000000000000
    n0 = 0
    xy = Allocate(64)
    ArraySet(xy, 0, Float_Sub(n0, n50))
    ArraySet(xy, 1, Float_Sub(n0, n50))
    ArraySet(xy, 2, n50)
    ArraySet(xy, 3, Float_Sub(n0, n50))
    ArraySet(xy, 4, n50)
    ArraySet(xy, 5, n50)
    ArraySet(xy, 6, Float_Sub(n0, n50))
    ArraySet(xy, 7, n50)
    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, xy, 4)
    host = CAD_Feat.ExtrudeProfile(hsk, n20)
    tsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(tsk, n0, n0, n25)
    tool = CAD_Feat.ExtrudeProfile(tsk, n20)
    dlt = Allocate(32)
    ArraySet(dlt, 0, n0)
    ArraySet(dlt, 1, n0)
    ArraySet(dlt, 2, n20)
    CAD_Topo.TranslateSolid(tool, dlt)
    Deallocate(dlt, 32)
    CAD_Topo.RebuildKind0Planes(host)
    body = CAD_Bool.GlueOnFace(host, tool)
    IfCondition EqualTo(body, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL glue\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    ns0 = CAD_Topo.SolidCountShells(body)
    nf0 = CAD_Topo.SolidCountFaces(body)
    PrintMessage("glue shells=")
    PrintNumber(ns0)
    PrintMessage(" faces=")
    PrintNumber(nf0)
    PrintMessage(" inner=")
    PrintNumber(CAD_Topo.SolidHasInnerLoop(body))
    PrintMessage("\n")
    IfCondition NotEqual(ns0, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL shells\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    eds = Allocate(4096)
    ne = CAD_Topo.SolidCollectEdges(body, eds, 256)
    eh = 0
    i = 0
    WhileLoop LessThan(i, ne) {
        e = ArrayGet(eds, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.EdgeIsInnerLoop(e), 1) ThenBlock: {
                cr = CAD_Store.Read(e, 2)
                IfCondition NotEqual(cr, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(cr, 0), 2) ThenBlock: {
                        IfCondition EqualTo(eh, 0) ThenBlock: { eh = e }
                    }
                }
            }
        }
        i = Add(i, 1)
    }
    PrintMessage("inner circ=")
    PrintNumber(eh)
    PrintMessage("\n")
    IfCondition EqualTo(eh, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no inner CIRCLE\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo_State.fillet_concave = 1
    fil = CAD_Blend.FilletEdge(body, eh, n8)
    IfCondition EqualTo(fil, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL fillet\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    PrintMessage("fillet class=")
    PrintNumber(CAD_Topo_State.fillet_class)
    PrintMessage("\n")
    ninner = 0
    ne = CAD_Topo.SolidCollectEdges(fil, eds, 256)
    i = 0
    WhileLoop LessThan(i, ne) {
        e = ArrayGet(eds, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.EdgeIsInnerLoop(e), 1) ThenBlock: {
                cr = CAD_Store.Read(e, 2)
                IfCondition NotEqual(cr, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(cr, 0), 2) ThenBlock: {
                        ce = CAD_Store.Read(e, 3)
                        IfCondition EqualTo(ce, 0) ThenBlock: { ce = CAD_Store.Read(e, 4) }
                        IfCondition NotEqual(ce, 0) ThenBlock: {
                            lp = CAD_Store.Read(ce, 4)
                            IfCondition NotEqual(lp, 0) ThenBlock: {
                                ninner = CAD_Topo.LoopCountCoedges(lp)
                            }
                        }
                    }
                }
            }
        }
        i = Add(i, 1)
    }
    PrintMessage("host inner nce=")
    PrintNumber(ninner)
    PrintMessage("\n")
    IfCondition NotEqual(ninner, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL inner not 1-coedge\n", 24)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Topo_State.fillet_class, 6) ThenBlock: {
        CAD_Sys.Write(1, "FAIL class not 6\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    nf1 = CAD_Topo.SolidCountFaces(fil)
    ns1 = CAD_Topo.SolidCountShells(fil)
    n_cyl = 0
    n_tor = 0
    n_sph = 0
    sh = CAD_Store.Read(fil, 0)
    WhileLoop NotEqual(sh, 0) {
        fc = CAD_Store.Read(sh, 0)
        WhileLoop NotEqual(fc, 0) {
            surf = CAD_Store.Read(fc, 0)
            IfCondition NotEqual(surf, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 2) ThenBlock: { n_cyl = Add(n_cyl, 1) }
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 3) ThenBlock: { n_sph = Add(n_sph, 1) }
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 4) ThenBlock: { n_tor = Add(n_tor, 1) }
            }
            fc = CAD_Store.Read(fc, 3)
        }
        sh = CAD_Store.Read(sh, 2)
    }
    PrintMessage("faces=")
    PrintNumber(nf0)
    PrintMessage("->")
    PrintNumber(nf1)
    PrintMessage(" shells=")
    PrintNumber(ns1)
    PrintMessage(" cyl=")
    PrintNumber(n_cyl)
    PrintMessage(" tor=")
    PrintNumber(n_tor)
    PrintMessage(" sph=")
    PrintNumber(n_sph)
    PrintMessage("\n")
    mesh = Allocate(48)
    nt = CAD_Tess.MeshSolid(fil, 0, mesh)
    PrintMessage("nt=")
    PrintNumber(nt)
    PrintMessage("\n")
    Deallocate(mesh, 48)
    Deallocate(eds, 4096)
    Deallocate(xy, 64)
    pass = 0
    IfCondition EqualTo(ns1, 1) ThenBlock: {
        IfCondition EqualTo(n_tor, 1) ThenBlock: {
            IfCondition EqualTo(n_sph, 0) ThenBlock: {
                IfCondition EqualTo(n_cyl, 1) ThenBlock: {
                    IfCondition GreaterThan(nt, 50) ThenBlock: { pass = 1 }
                }
            }
        }
    }
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "CYL JOIN COVE PASS\n", 19)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "CYL JOIN COVE FAIL\n", 19)
    }
    SystemCall(60, Subtract(1, pass), 0, 0)
}
RunTask(Main)
