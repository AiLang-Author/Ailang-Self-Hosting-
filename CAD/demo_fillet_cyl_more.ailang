// Plane–cyl follow-on: bottom rim + washer hole (inner) top rim

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== Plane-cyl bottom + hole rim ===\n", 36)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    // bottom rim via FilletEdge
    body = CAD_Script.CreateCylinder(Float_FromInt(15), Float_FromInt(30))
    edges = Allocate(1024)
    ne = CAD_Topo.SolidCollectEdges(body, edges, 32)
    found = 0
    j = 0
    WhileLoop LessThan(j, ne) {
        ed = ArrayGet(edges, j)
        v0 = CAD_Store.Read(ed, 0)
        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v0, 2), 0, 0), 1) ThenBlock: {
            curv = CAD_Store.Read(ed, 2)
            IfCondition NotEqual(curv, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(curv, 0), 2) ThenBlock: {
                    found = ed
                    j = ne
                }
            }
            IfCondition EqualTo(found, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(ed, 0), CAD_Store.Read(ed, 1)) ThenBlock: {
                    found = ed
                    j = ne
                }
            }
        }
        j = Add(j, 1)
    }
    Deallocate(edges, 1024)
    IfCondition EqualTo(found, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL bottom edge\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    hb = CAD_Blend.FilletEdge(body, found, Float_FromInt(4))
    IfCondition EqualTo(hb, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL bottom fillet\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(hb, "test-stl/cad_fillet_cyl_bot.stp")
    CAD_View.SetWire(0)
    CAD_View.RenderSolidToBMP(hb, 400, 350, "test-stl/cad_view_fillet_cyl_bot.bmp")
    CAD_Sys.Write(1, "bottom rim ok\n", 14)

    // washer hole top inner (concave)
    hw = CAD_Blend.FilletWasherHoleTop(Float_FromInt(8), Float_FromInt(20), Float_FromInt(6), Float_FromInt(2))
    IfCondition EqualTo(hw, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL washer hole fillet\n", 24)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(hw, "test-stl/cad_fillet_washer_hole.stp")
    CAD_View.RenderSolidToBMP(hw, 400, 350, "test-stl/cad_view_fillet_washer_hole.bmp")
    CAD_Sys.Write(1, "washer hole rim ok\n", 19)

    // direct bottom builder
    out = Allocate(16)
    hd = CAD_Topo.MakeCylinderBottomFillet(Float_FromInt(12), Float_FromInt(20), Float_FromInt(3), out)
    Deallocate(out, 16)
    IfCondition EqualTo(hd, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL direct bottom\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(hd, "test-stl/cad_fillet_cyl_bot_direct.stp")

    // negatives washer
    IfCondition NotEqual(CAD_Blend.FilletWasherHoleTop(Float_FromInt(10), Float_FromInt(12), Float_FromInt(5), Float_FromInt(3)), 0) ThenBlock: {
        CAD_Sys.Write(1, "NEG FAIL tight gap\n", 19)
        SystemCall(60, 1, 0, 0)
    }

    CAD_Sys.Write(1, "FILLET CYL MORE OK\n", 19)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
