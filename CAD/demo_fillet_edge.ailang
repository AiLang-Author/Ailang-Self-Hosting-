// General plane–plane FilletEdge: pick edges from topology, not shape recipes.
// DIM: box 40x30x20 mm; fillet R=4 on one vertical edge; then all 4 verticals.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== FilletEdge plane-plane ===\n", 32)
    CAD_Sys.Write(1, "DIM box 40x30x20 mm  R=4\n", 26)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(8192)

    body = CAD_Script.CreateBox(0x4044000000000000, 0x403E000000000000, 0x4034000000000000)
    edges = Allocate(1024)
    ne = CAD_Topo.SolidCollectEdges(body, edges, 64)
    IfCondition LessThan(ne, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no edges\n", 14)
        SystemCall(60, 1, 0, 0)
    }

    // Fillet every edge that is plane-plane with length // Z (vertical)
    r = 0x4010000000000000
    cur = body
    i = 0
    nf = 0
    WhileLoop LessThan(i, ne) {
        ed = ArrayGet(edges, i)
        v0 = CAD_Store.Read(ed, 0)
        v1 = CAD_Store.Read(ed, 1)
        // re-collect edges after each fillet (topology new)
        // only use edges from original list once — re-collect each time from cur
        i = Add(i, 1)
    }

    // Simpler: repeatedly collect edges, fillet first vertical plane-plane edge
    guard = 0
    WhileLoop LessThan(guard, 4) {
        ne2 = CAD_Topo.SolidCollectEdges(cur, edges, 64)
        found_e = 0
        j = 0
        WhileLoop LessThan(j, ne2) {
            ed = ArrayGet(edges, j)
            v0 = CAD_Store.Read(ed, 0)
            v1 = CAD_Store.Read(ed, 1)
            dx = Float_Sub(CAD_Store.Read(v1, 0), CAD_Store.Read(v0, 0))
            dy = Float_Sub(CAD_Store.Read(v1, 1), CAD_Store.Read(v0, 1))
            dz = Float_Sub(CAD_Store.Read(v1, 2), CAD_Store.Read(v0, 2))
            // vertical: |dx|,|dy| ~ 0, |dz| large
            adx = dx
            IfCondition EqualTo(Float_Le(adx, 0), 1) ThenBlock: { adx = Float_Sub(0, adx) }
            ady = dy
            IfCondition EqualTo(Float_Le(ady, 0), 1) ThenBlock: { ady = Float_Sub(0, ady) }
            adz = dz
            IfCondition EqualTo(Float_Le(adz, 0), 1) ThenBlock: { adz = Float_Sub(0, adz) }
            // adx,ady small vs adz
            IfCondition EqualTo(Float_Le(adx, 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(ady, 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(0x3FF0000000000000, adz), 1) ThenBlock: {
                        faces = Allocate(32)
                        IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(ed, faces), 0) ThenBlock: {
                            found_e = ed
                        }
                        Deallocate(faces, 32)
                    }
                }
            }
            IfCondition NotEqual(found_e, 0) ThenBlock: {
                j = ne2
            }
            j = Add(j, 1)
        }
        IfCondition EqualTo(found_e, 0) ThenBlock: {
            guard = 4
        }
        IfCondition NotEqual(found_e, 0) ThenBlock: {
            nxt = CAD_Blend.FilletEdge(cur, found_e, r)
            IfCondition EqualTo(nxt, 0) ThenBlock: {
                CAD_Sys.Write(1, "FAIL FilletEdge\n", 16)
                SystemCall(60, 1, 0, 0)
            }
            cur = nxt
            nf = Add(nf, 1)
        }
        guard = Add(guard, 1)
    }

    IfCondition EqualTo(nf, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no vertical edge filleted\n", 31)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(cur, "test-stl/cad_fillet_edge.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL STEP\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote cad_fillet_edge.stp (FilletEdge x", 39)
    // print count crudely
    CAD_Sys.Write(1, "N)\n", 3)
    CAD_Sys.Write(1, "FILLET EDGE OK\n", 15)
    Deallocate(edges, 1024)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
