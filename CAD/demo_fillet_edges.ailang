// OCC digon equal-R cycle on top face edges (cylinders + shared ellipses).
// DIM: box 40×30×20 mm; R=4. Look-at: test-stl/cad_fillet_edges.stp

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== FilletEdges OCC digon ===\n", 31)
    CAD_Sys.Write(1, "DIM 40x30x20 R=4 top cycle\n", 28)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    body = CAD_Script.CreateBox(0x4044000000000000, 0x403E000000000000, 0x4034000000000000)
    edges = Allocate(1024)
    sel = Allocate(32)
    faces = Allocate(32)
    pl = Allocate(128)
    ne = CAD_Topo.SolidCollectEdges(body, edges, 128)
    nsel = 0
    j = 0
    WhileLoop LessThan(j, ne) {
        ed = ArrayGet(edges, j)
        IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(ed, faces), 0) ThenBlock: {
            ok1 = CAD_Topo.FaceGetPlane(ArrayGet(faces, 0), pl)
            ok2 = CAD_Topo.FaceGetPlane(ArrayGet(faces, 1), pl)
            IfCondition EqualTo(ok1, 0) ThenBlock: {
                IfCondition EqualTo(ok2, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(CAD_Store.Read(ed, 0), 2), 0x4034000000000000, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(CAD_Store.Read(ed, 1), 2), 0x4034000000000000, 0), 1) ThenBlock: {
                            ArraySet(sel, nsel, ed)
                            nsel = Add(nsel, 1)
                        }
                    }
                }
            }
        }
        j = Add(j, 1)
    }
    IfCondition LessThan(nsel, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL need >=3 edges\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    fil = CAD_Blend.FilletEdges(body, sel, nsel, 0x4010000000000000)
    IfCondition EqualTo(fil, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL FilletEdges digon\n", 23)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(fil, "test-stl/cad_fillet_edges.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL STEP\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote cad_fillet_edges.stp\n", 27)
    CAD_Sys.Write(1, "expect: 4 CYL + 4 ELLIPSE digons + 6 planes\n", 45)
    CAD_Sys.Write(1, "FILLET EDGES OK\n", 16)
    Deallocate(edges, 1024)
    Deallocate(sel, 32)
    Deallocate(faces, 32)
    Deallocate(pl, 128)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
