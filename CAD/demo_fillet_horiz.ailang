// Plane–plane FilletEdge on a HORIZONTAL top edge (same API as vertical).
// DIM: box 40x30x20 mm; R=5 on top front edge (y=0, z=20, along +X).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== FilletEdge horizontal top ===\n", 35)
    CAD_Sys.Write(1, "DIM box 40x30x20 mm\n", 20)
    CAD_Sys.Write(1, "DIM R=5 on top front edge (along X)\n", 37)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(8192)

    body = CAD_Script.CreateBox(0x4044000000000000, 0x403E000000000000, 0x4034000000000000)
    edges = Allocate(1024)
    ne = CAD_Topo.SolidCollectEdges(body, edges, 64)
    r = 0x4014000000000000
    found_e = 0
    j = 0
    WhileLoop LessThan(j, ne) {
        ed = ArrayGet(edges, j)
        v0 = CAD_Store.Read(ed, 0)
        v1 = CAD_Store.Read(ed, 1)
        z0 = CAD_Store.Read(v0, 2)
        z1 = CAD_Store.Read(v1, 2)
        y0 = CAD_Store.Read(v0, 1)
        y1 = CAD_Store.Read(v1, 1)
        dx = Float_Sub(CAD_Store.Read(v1, 0), CAD_Store.Read(v0, 0))
        dy = Float_Sub(y1, y0)
        dz = Float_Sub(z1, z0)
        adx = dx
        IfCondition EqualTo(Float_Le(adx, 0), 1) ThenBlock: { adx = Float_Sub(0, adx) }
        ady = dy
        IfCondition EqualTo(Float_Le(ady, 0), 1) ThenBlock: { ady = Float_Sub(0, ady) }
        adz = dz
        IfCondition EqualTo(Float_Le(adz, 0), 1) ThenBlock: { adz = Float_Sub(0, adz) }
        // top front: both z ~ 20, both y ~ 0, long in X
        IfCondition EqualTo(CAD_Num.IsEqual(z0, 0x4034000000000000, 0), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(z1, 0x4034000000000000, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(y0, 0, 0), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(y1, 0, 0), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(0x3FF0000000000000, adx), 1) ThenBlock: {
                            found_e = ed
                        }
                    }
                }
            }
        }
        IfCondition NotEqual(found_e, 0) ThenBlock: { j = ne }
        j = Add(j, 1)
    }
    IfCondition EqualTo(found_e, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no top front edge\n", 23)
        SystemCall(60, 1, 0, 0)
    }
    fil = CAD_Blend.FilletEdge(body, found_e, r)
    IfCondition EqualTo(fil, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL FilletEdge horiz\n", 22)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(fil, "test-stl/cad_fillet_horiz.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL STEP\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote cad_fillet_horiz.stp\n", 27)
    CAD_Sys.Write(1, "FILLET HORIZ OK\n", 16)
    Deallocate(edges, 1024)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
