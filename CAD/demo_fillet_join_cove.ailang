// Glue rec-on-rec + Construction F' join cove. Stop after class 3.
// Gate: class=3, faces 11→23, pad top nce=4, 4 shortened verticals,
// live 2E=Σ nce, every live edge[3] and [4] ≠0, 4 CYL+4 SPH.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== join cove F' rec-on-rec ===\n", 32)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n80 = 0x4054000000000000
    n20 = 0x4034000000000000
    n10 = 0x4024000000000000
    n8 = 0x4020000000000000
    xy = Allocate(64)
    ArraySet(xy, 0, Float_Sub(0, n80))
    ArraySet(xy, 1, Float_Sub(0, n80))
    ArraySet(xy, 2, n80)
    ArraySet(xy, 3, Float_Sub(0, n80))
    ArraySet(xy, 4, n80)
    ArraySet(xy, 5, n80)
    ArraySet(xy, 6, Float_Sub(0, n80))
    ArraySet(xy, 7, n80)
    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, xy, 4)
    host = CAD_Feat.ExtrudeProfile(hsk, n20)
    IfCondition EqualTo(host, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL host\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    ArraySet(xy, 0, Float_Sub(0, n10))
    ArraySet(xy, 1, Float_Sub(0, n10))
    ArraySet(xy, 2, n10)
    ArraySet(xy, 3, Float_Sub(0, n10))
    ArraySet(xy, 4, n10)
    ArraySet(xy, 5, n10)
    ArraySet(xy, 6, Float_Sub(0, n10))
    ArraySet(xy, 7, n10)
    tsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(tsk, xy, 4)
    tool = CAD_Feat.ExtrudeProfile(tsk, n20)
    IfCondition EqualTo(tool, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL tool\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    dlt = Allocate(32)
    ArraySet(dlt, 0, 0)
    ArraySet(dlt, 1, 0)
    ArraySet(dlt, 2, n20)
    CAD_Topo.TranslateSolid(tool, dlt)
    Deallocate(dlt, 32)
    CAD_Topo.RebuildKind0Planes(host)
    CAD_Topo.RebuildKind0Planes(tool)
    body = CAD_Bool.GlueOnFace(host, tool)
    IfCondition EqualTo(body, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL glue\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    nf0 = CAD_Topo.SolidCountFaces(body)
    PrintMessage("glue faces=")
    PrintNumber(nf0)
    PrintMessage("\n")
    eds = Allocate(4096)
    join = Allocate(64)
    ne = CAD_Topo.SolidCollectEdges(body, eds, 256)
    nj = 0
    i = 0
    WhileLoop LessThan(i, ne) {
        e = ArrayGet(eds, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.EdgeIsInnerLoop(e), 1) ThenBlock: {
                cr = CAD_Store.Read(e, 2)
                IfCondition NotEqual(cr, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(cr, 0), 1) ThenBlock: {
                        IfCondition LessThan(nj, 8) ThenBlock: {
                            ArraySet(join, nj, e)
                            nj = Add(nj, 1)
                        }
                    }
                }
            }
        }
        i = Add(i, 1)
    }
    PrintMessage("join n=")
    PrintNumber(nj)
    PrintMessage("\n")
    IfCondition LessThan(nj, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL join edges\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo_State.fillet_concave = 1
    body = CAD_Blend.FilletEdges(body, join, 4, n8)
    IfCondition EqualTo(body, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL join fillet\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    PrintMessage("fillet class=")
    PrintNumber(CAD_Topo_State.fillet_class)
    PrintMessage("\n")
    IfCondition NotEqual(CAD_Topo_State.fillet_class, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL class not 3\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    nf1 = CAD_Topo.SolidCountFaces(body)
    PrintMessage("faces=")
    PrintNumber(nf0)
    PrintMessage("->")
    PrintNumber(nf1)
    PrintMessage("\n")
    IfCondition NotEqual(nf1, 23) ThenBlock: {
        CAD_Sys.Write(1, "FAIL faces not 23\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    seen = Allocate(4096)
    nlive_e = 0
    sum_nce = 0
    n_open = 0
    n_cyl = 0
    n_sph = 0
    best_n = 0
    best_z = 0xC1E0000000000000
    nshort = 0
    pl = Allocate(128)
    sh = CAD_Store.Read(body, 0)
    sg = 0
    WhileLoop NotEqual(sh, 0) {
        fc = CAD_Store.Read(sh, 0)
        fg = 0
        WhileLoop NotEqual(fc, 0) {
            surf = CAD_Store.Read(fc, 0)
            IfCondition NotEqual(surf, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 2) ThenBlock: { n_cyl = Add(n_cyl, 1) }
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 3) ThenBlock: { n_sph = Add(n_sph, 1) }
            }
            IfCondition EqualTo(CAD_Topo.FaceGetPlane(fc, pl), 0) ThenBlock: {
                z = ArrayGet(pl, 3)
                IfCondition EqualTo(Float_Le(best_z, z), 1) ThenBlock: {
                    best_n = CAD_Topo.LoopCountCoedges(CAD_Store.Read(fc, 1))
                    best_z = z
                }
            }
            lp = CAD_Store.Read(fc, 1)
            lg = 0
            WhileLoop NotEqual(lp, 0) {
                nce = CAD_Topo.LoopCountCoedges(lp)
                IfCondition GreaterThan(nce, 0) ThenBlock: { sum_nce = Add(sum_nce, nce) }
                hd = CAD_Store.Read(lp, 0)
                ce = hd
                cg = 0
                WhileLoop LessThan(cg, 64) {
                    ed = CAD_Store.Read(ce, 0)
                    found = 0
                    j = 0
                    WhileLoop LessThan(j, nlive_e) {
                        IfCondition EqualTo(ArrayGet(seen, j), ed) ThenBlock: { found = 1 }
                        j = Add(j, 1)
                    }
                    IfCondition EqualTo(found, 0) ThenBlock: {
                        IfCondition LessThan(nlive_e, 256) ThenBlock: {
                            ArraySet(seen, nlive_e, ed)
                            nlive_e = Add(nlive_e, 1)
                        }
                        IfCondition EqualTo(CAD_Store.Read(ed, 3), 0) ThenBlock: { n_open = Add(n_open, 1) }
                        IfCondition EqualTo(CAD_Store.Read(ed, 4), 0) ThenBlock: { n_open = Add(n_open, 1) }
                        v0 = CAD_Store.Read(ed, 0)
                        v1 = CAD_Store.Read(ed, 1)
                        IfCondition NotEqual(v0, 0) ThenBlock: {
                            IfCondition NotEqual(v1, 0) ThenBlock: {
                                dx = Float_Sub(CAD_Store.Read(v1, 0), CAD_Store.Read(v0, 0))
                                dy = Float_Sub(CAD_Store.Read(v1, 1), CAD_Store.Read(v0, 1))
                                dz = Float_Sub(CAD_Store.Read(v1, 2), CAD_Store.Read(v0, 2))
                                IfCondition EqualTo(CAD_Num.IsNeg(dx), 1) ThenBlock: { dx = Float_Sub(0, dx) }
                                IfCondition EqualTo(CAD_Num.IsNeg(dy), 1) ThenBlock: { dy = Float_Sub(0, dy) }
                                IfCondition EqualTo(CAD_Num.IsNeg(dz), 1) ThenBlock: { dz = Float_Sub(0, dz) }
                                IfCondition EqualTo(CAD_Num.IsZero(dx, 0), 1) ThenBlock: {
                                    IfCondition EqualTo(CAD_Num.IsZero(dy, 0), 1) ThenBlock: {
                                        IfCondition EqualTo(CAD_Num.IsEqual(dz, 0x4028000000000000, 0), 1) ThenBlock: {
                                            nshort = Add(nshort, 1)
                                        }
                                    }
                                }
                            }
                        }
                    }
                    ce = CAD_Store.Read(ce, 2)
                    IfCondition EqualTo(ce, hd) ThenBlock: { cg = 64 }
                    cg = Add(cg, 1)
                }
                lp = CAD_Store.Read(lp, 2)
                lg = Add(lg, 1)
                IfCondition GreaterThan(lg, 8) ThenBlock: { lp = 0 }
            }
            fc = CAD_Store.Read(fc, 3)
            fg = Add(fg, 1)
            IfCondition GreaterThan(fg, 64) ThenBlock: { fc = 0 }
        }
        sh = CAD_Store.Read(sh, 2)
        sg = Add(sg, 1)
        IfCondition GreaterThan(sg, 8) ThenBlock: { sh = 0 }
    }
    two_e = Multiply(nlive_e, 2)
    PrintMessage("live E=")
    PrintNumber(nlive_e)
    PrintMessage(" sum nce=")
    PrintNumber(sum_nce)
    PrintMessage(" 2E=")
    PrintNumber(two_e)
    PrintMessage("\n")
    PrintMessage("pad top nce=")
    PrintNumber(best_n)
    PrintMessage("\n")
    PrintMessage("shortened verts n=")
    PrintNumber(nshort)
    PrintMessage("\n")
    PrintMessage("CYL=")
    PrintNumber(n_cyl)
    PrintMessage(" SPH=")
    PrintNumber(n_sph)
    PrintMessage(" open=")
    PrintNumber(n_open)
    PrintMessage("\n")
    IfCondition NotEqual(two_e, sum_nce) ThenBlock: {
        CAD_Sys.Write(1, "FAIL 2E != sum nce\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(best_n, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL pad top nce\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition LessThan(nshort, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL shortened verticals\n", 25)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(n_cyl, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL CYL count\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(n_sph, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL SPH count\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(n_open, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL open edge\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(body, "test-stl/cad_fillet_join_cove.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL STEP\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "JOIN COVE OK\n", 13)
    Deallocate(xy, 64)
    Deallocate(eds, 4096)
    Deallocate(join, 64)
    Deallocate(seen, 4096)
    Deallocate(pl, 128)
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
