// Rect plate + circle hole, then fillet the 4 bottom edges.
// Digon used to drop the roof inner loop (circle closed). Expect the
// hole still present after the fillet.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== fillet must keep hole ===\n", 30)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    outer = Allocate(128)
    n40 = 0x4044000000000000
    n25 = 0x4039000000000000
    ArraySet(outer, 0, Float_Sub(0, n40))
    ArraySet(outer, 1, Float_Sub(0, n25))
    ArraySet(outer, 2, n40)
    ArraySet(outer, 3, Float_Sub(0, n25))
    ArraySet(outer, 4, n40)
    ArraySet(outer, 5, n25)
    ArraySet(outer, 6, Float_Sub(0, n40))
    ArraySet(outer, 7, n25)

    hole = Allocate(1024)
    nh = 32
    two_pi = 0x401921FB54442D18
    rad = 0x402E000000000000
    i = 0
    WhileLoop LessThan(i, nh) {
        th = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(nh)))
        ArraySet(hole, Multiply(i, 2), Float_Mul(rad, CAD_Geom.Cos(th)))
        ArraySet(hole, Add(Multiply(i, 2), 1), Float_Mul(rad, CAD_Geom.Sin(th)))
        i = Add(i, 1)
    }

    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, outer, 4)
    CAD_Sketch.AddProfileXY(hsk, hole, nh)
    hz = 0x4034000000000000
    h = CAD_Feat.ExtrudeProfile(hsk, hz)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }

    ebuf = Allocate(64)
    ne = 0
    sh = CAD_Store.Read(h, 0)
    fh = 0
    IfCondition NotEqual(sh, 0) ThenBlock: { fh = CAD_Store.Read(sh, 0) }
    g = 0
    WhileLoop NotEqual(fh, 0) {
        lp = CAD_Store.Read(fh, 1)
        IfCondition NotEqual(lp, 0) ThenBlock: {
            hd = CAD_Store.Read(lp, 0)
            ce = hd
            cg = 0
            dn = 0
            WhileLoop EqualTo(dn, 0) {
                ed = CAD_Store.Read(ce, 0)
                IfCondition NotEqual(ed, 0) ThenBlock: {
                    v0 = CAD_Store.Read(ed, 0)
                    v1 = CAD_Store.Read(ed, 1)
                    IfCondition NotEqual(v0, 0) ThenBlock: {
                        IfCondition NotEqual(v1, 0) ThenBlock: {
                            z0 = CAD_Store.Read(v0, 2)
                            z1 = CAD_Store.Read(v1, 2)
                            az0 = z0
                            IfCondition EqualTo(CAD_Num.IsNeg(az0), 1) ThenBlock: { az0 = Float_Sub(0, az0) }
                            az1 = z1
                            IfCondition EqualTo(CAD_Num.IsNeg(az1), 1) ThenBlock: { az1 = Float_Sub(0, az1) }
                            ztol = 0x3F847AE147AE147B
                            IfCondition EqualTo(Float_Le(az0, ztol), 1) ThenBlock: {
                                IfCondition EqualTo(Float_Le(az1, ztol), 1) ThenBlock: {
                                    IfCondition LessThan(ne, 8) ThenBlock: {
                                        ArraySet(ebuf, ne, ed)
                                        ne = Add(ne, 1)
                                    }
                                }
                            }
                        }
                    }
                }
                ce = CAD_Store.Read(ce, 2)
                cg = Add(cg, 1)
                IfCondition EqualTo(ce, hd) ThenBlock: { dn = 1 }
                IfCondition GreaterThan(cg, 32) ThenBlock: { dn = 1 }
            }
        }
        fh = CAD_Store.Read(fh, 3)
        g = Add(g, 1)
        IfCondition GreaterThan(g, 64) ThenBlock: { fh = 0 }
    }
    PrintMessage("bot edges=")
    PrintNumber(ne)
    PrintMessage("\n")
    IfCondition LessThan(ne, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no bottom edges\n", 21)
        SystemCall(60, 1, 0, 0)
    }

    r = 0x4014000000000000
    fil = CAD_Blend.FilletEdges(h, ebuf, 4, r)
    IfCondition EqualTo(fil, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL fillet\n", 12)
        SystemCall(60, 1, 0, 0)
    }

    nholes = 0
    sh = CAD_Store.Read(fil, 0)
    fh = 0
    IfCondition NotEqual(sh, 0) ThenBlock: { fh = CAD_Store.Read(sh, 0) }
    g = 0
    WhileLoop NotEqual(fh, 0) {
        lp = CAD_Store.Read(fh, 1)
        IfCondition NotEqual(lp, 0) ThenBlock: {
            IfCondition NotEqual(CAD_Store.Read(lp, 2), 0) ThenBlock: {
                nholes = Add(nholes, 1)
            }
        }
        fh = CAD_Store.Read(fh, 3)
        g = Add(g, 1)
        IfCondition GreaterThan(g, 256) ThenBlock: { fh = 0 }
    }
    PrintMessage("faces_with_hole=")
    PrintNumber(nholes)
    PrintMessage("\n")

    mesh = Allocate(32)
    nt = CAD_Tess.MeshSolid(fil, 0x3FB999999999999A, mesh)
    PrintMessage("mesh nt=")
    PrintNumber(nt)
    PrintMessage("\n")
    IfCondition GreaterThan(nholes, 0) ThenBlock: {
        CAD_Sys.Write(1, "PASS fillet kept hole\n", 22)
        SystemCall(60, 0, 0, 0)
    }
    CAD_Sys.Write(1, "FAIL fillet dropped hole\n", 25)
    SystemCall(60, 1, 0, 0)
}
RunTask(Main)
