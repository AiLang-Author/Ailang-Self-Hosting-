// Abuse: 12 mixed edges (hole-wall verticals + outer rim) used to SEGV in Digon.
// Must return (0 or solid) and still mesh.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== fillet mixed batch ===\n", 28)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    n0 = 0
    n20 = 0x4034000000000000
    n15 = 0x402E000000000000
    n6 = 0x4018000000000000
    two_pi = 0x401921FB54442D18

    outer = Allocate(128)
    ArraySet(outer, 0, Float_Sub(n0, n20))
    ArraySet(outer, 1, Float_Sub(n0, n15))
    ArraySet(outer, 2, n20)
    ArraySet(outer, 3, Float_Sub(n0, n15))
    ArraySet(outer, 4, n20)
    ArraySet(outer, 5, n15)
    ArraySet(outer, 6, Float_Sub(n0, n20))
    ArraySet(outer, 7, n15)

    hole = Allocate(4096)
    nh = 24
    i = 0
    WhileLoop LessThan(i, nh) {
        th = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(nh)))
        ArraySet(hole, Multiply(i, 2), Float_Mul(n6, CAD_Geom.Cos(th)))
        ArraySet(hole, Add(Multiply(i, 2), 1), Float_Mul(n6, CAD_Geom.Sin(th)))
        i = Add(i, 1)
    }

    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, outer, 4)
    CAD_Sketch.AddProfileXY(hsk, hole, nh)
    h = CAD_Feat.ExtrudeProfile(hsk, n20)
    PrintMessage("solid=")
    PrintNumber(h)
    PrintMessage("\n")
    pass = 0
    IfCondition NotEqual(h, 0) ThenBlock: {
        edges = Allocate(32768)
        ne = CAD_Topo.SolidCollectEdges(h, edges, 4096)
        PrintMessage("nedges=")
        PrintNumber(ne)
        PrintMessage("\n")
        snap = Allocate(128)
        nH = 0
        nV = 0
        i = 0
        WhileLoop LessThan(i, ne) {
            ed = ArrayGet(edges, i)
            IfCondition NotEqual(ed, 0) ThenBlock: {
                va = CAD_Store.Read(ed, 0)
                vb = CAD_Store.Read(ed, 1)
                dz = Float_Sub(CAD_Store.Read(vb, 2), CAD_Store.Read(va, 2))
                IfCondition EqualTo(CAD_Num.IsNeg(dz), 1) ThenBlock: { dz = Float_Sub(n0, dz) }
                mx = Float_Div(Float_Add(CAD_Store.Read(va, 0), CAD_Store.Read(vb, 0)), 0x4000000000000000)
                my = Float_Div(Float_Add(CAD_Store.Read(va, 1), CAD_Store.Read(vb, 1)), 0x4000000000000000)
                rr = Float_Add(Float_Mul(mx, mx), Float_Mul(my, my))
                // hole disk r=6 → r²=36 = 0x4042000000000000
                IfCondition EqualTo(CAD_Num.IsZero(dz, 0), 0) ThenBlock: {
                    IfCondition EqualTo(Float_Le(rr, 0x4042000000000000), 1) ThenBlock: {
                        IfCondition LessThan(nV, 6) ThenBlock: {
                            ArraySet(snap, nV, ed)
                            nV = Add(nV, 1)
                        }
                    }
                }
                IfCondition EqualTo(CAD_Num.IsZero(dz, 0), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(0x4042000000000000, rr), 1) ThenBlock: {
                        IfCondition LessThan(nH, 6) ThenBlock: {
                            ArraySet(snap, Add(6, nH), ed)
                            nH = Add(nH, 1)
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ns = Add(nV, nH)
        PrintMessage("batch nV=")
        PrintNumber(nV)
        PrintMessage(" nH=")
        PrintNumber(nH)
        PrintMessage("\n")
        out = 0
        IfCondition GreaterThan(ns, 2) ThenBlock: {
            out = CAD_Blend.FilletEdges(h, snap, ns, 0x4000000000000000)
        }
        PrintMessage("fillet=")
        PrintNumber(out)
        PrintMessage("\n")
        body = h
        IfCondition NotEqual(out, 0) ThenBlock: { body = out }
        mesh = Allocate(32)
        nt = CAD_Tess.MeshSolid(body, 0x3FB999999999999A, mesh)
        PrintMessage("mesh nt=")
        PrintNumber(nt)
        PrintMessage("\n")
        IfCondition GreaterThan(nt, 8) ThenBlock: { pass = 1 }
        Deallocate(mesh, 32)
        Deallocate(snap, 128)
        Deallocate(edges, 32768)
    }
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "FILLET MIXED BATCH PASS\n", 24)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "FILLET MIXED BATCH FAIL\n", 24)
    }
    Deallocate(outer, 128)
    Deallocate(hole, 4096)
    SystemCall(60, Subtract(1, pass), 0, 0)
}
RunTask(Main)
