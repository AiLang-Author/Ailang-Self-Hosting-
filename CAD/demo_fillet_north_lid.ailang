// North 3-LINE + inward-arc: dump lid loop + tess path. MeshSolid first
// (samp sticks; do not mesh a second solid). Diagnose the starred lid.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_Tess

SubRoutine.Main {
    CAD_Sys.Write(1, "=== north lid dump ===\n", 23)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    n25 = 0x4039000000000000
    n20 = 0x4034000000000000
    n8 = 0x4020000000000000
    m25 = Float_Sub(0, n25)
    n55 = Float_FromInt(55)
    n80 = Float_FromInt(80)
    mn55 = Float_Sub(0, n55)
    rr = CAD_Num.Hypot2(n25, n55)
    a0n = CAD_Geom.Atan2(mn55, n25)
    a1n = CAD_Geom.Atan2(mn55, m25)

    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = n20
    CAD_Topo.SweepBeginWire()
    CAD_Topo_Sweep.px0 = 0
    CAD_Topo_Sweep.py0 = n80
    CAD_Topo_Sweep.px1 = rr
    CAD_Topo_Sweep.pa0 = a0n
    CAD_Topo_Sweep.pa1 = a1n
    CAD_Topo.SweepAddArcPinned()
    CAD_Topo.SweepAddLine(m25, n25, m25, m25)
    CAD_Topo.SweepAddLine(m25, m25, n25, m25)
    CAD_Topo.SweepAddLine(n25, m25, n25, n25)
    hostn = CAD_Topo.ExtrudeContours()
    IfCondition EqualTo(hostn, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo.RebuildKind0Planes(hostn)

    eds = Allocate(4096)
    top = Allocate(128)
    pl = Allocate(128)
    ne = CAD_Topo.SolidCollectEdges(hostn, eds, 256)
    nt = 0
    ncirc = 0
    i = 0
    WhileLoop LessThan(i, ne) {
        e = ArrayGet(eds, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            va = CAD_Store.Read(e, 0)
            vb = CAD_Store.Read(e, 1)
            za = 0
            zb = 0
            IfCondition NotEqual(va, 0) ThenBlock: { za = CAD_Store.Read(va, 2) }
            IfCondition NotEqual(vb, 0) ThenBlock: { zb = CAD_Store.Read(vb, 2) }
            IfCondition EqualTo(CAD_Num.IsEqual(za, n20, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(zb, n20, 0), 1) ThenBlock: {
                    crv = CAD_Store.Read(e, 2)
                    ck = 0
                    IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
                    IfCondition EqualTo(ck, 2) ThenBlock: { ncirc = Add(ncirc, 1) }
                    IfCondition EqualTo(ck, 1) ThenBlock: {
                        ArraySet(top, nt, e)
                        nt = Add(nt, 1)
                    }
                }
            }
        }
        i = Add(i, 1)
    }
    CAD_Sys.Write(1, "north LINE n=", 13)
    PrintNumber(nt)
    CAD_Sys.Write(1, " CIRCLE n=", 10)
    PrintNumber(ncirc)
    CAD_Sys.Write(1, "\n", 1)
    IfCondition NotEqual(nt, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected 3 top LINEs\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    filn = CAD_Blend.FilletEdges(hostn, top, nt, n8)
    IfCondition EqualTo(filn, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL fillet\n", 12)
        SystemCall(60, 1, 0, 0)
    }

    sh = CAD_Store.Read(filn, 0)
    face = 0
    IfCondition NotEqual(sh, 0) ThenBlock: { face = CAD_Store.Read(sh, 0) }
    fg = 0
    WhileLoop LessThan(fg, 64) {
        IfCondition EqualTo(face, 0) ThenBlock: { fg = 64 }
        IfCondition NotEqual(face, 0) ThenBlock: {
            surf = CAD_Store.Read(face, 0)
            sk = 0
            IfCondition NotEqual(surf, 0) ThenBlock: { sk = CAD_Store.Read(surf, 0) }
            lp = CAD_Store.Read(face, 1)
            nring = 0
            IfCondition NotEqual(lp, 0) ThenBlock: { nring = CAD_Topo.LoopCountCoedges(lp) }
            prc = CAD_Topo.FaceGetPlane(face, pl)
            nzv = 0
            IfCondition EqualTo(prc, 0) ThenBlock: { nzv = ArrayGet(pl, 12) }
            hasc = CAD_Tess.LoopHasCircle(lp)
            CAD_Sys.Write(1, "F sk=", 5)
            PrintNumber(sk)
            CAD_Sys.Write(1, " nring=", 7)
            PrintNumber(nring)
            CAD_Sys.Write(1, " prc=", 5)
            PrintNumber(prc)
            CAD_Sys.Write(1, " nz=", 4)
            PrintNumber(Float_ToInt(Float_Mul(nzv, 0x408F400000000000)))
            CAD_Sys.Write(1, " hasc=", 6)
            PrintNumber(hasc)
            CAD_Sys.Write(1, "\n", 1)
            hd = 0
            IfCondition NotEqual(lp, 0) ThenBlock: { hd = CAD_Store.Read(lp, 0) }
            ce = hd
            cg = 0
            WhileLoop LessThan(cg, 16) {
                IfCondition EqualTo(ce, 0) ThenBlock: { cg = 16 }
                IfCondition NotEqual(ce, 0) ThenBlock: {
                    e = CAD_Store.Read(ce, 0)
                    ck = 0
                    cr = 0
                    xa = 0
                    ya = 0
                    za = 0
                    xb = 0
                    yb = 0
                    zb = 0
                    IfCondition NotEqual(e, 0) ThenBlock: {
                        crv = CAD_Store.Read(e, 2)
                        IfCondition NotEqual(crv, 0) ThenBlock: {
                            ck = CAD_Store.Read(crv, 0)
                            cr = CAD_Store.Read(crv, 10)
                        }
                        va = CAD_Store.Read(e, 0)
                        vb = CAD_Store.Read(e, 1)
                        IfCondition NotEqual(va, 0) ThenBlock: {
                            xa = CAD_Store.Read(va, 0)
                            ya = CAD_Store.Read(va, 1)
                            za = CAD_Store.Read(va, 2)
                        }
                        IfCondition NotEqual(vb, 0) ThenBlock: {
                            xb = CAD_Store.Read(vb, 0)
                            yb = CAD_Store.Read(vb, 1)
                            zb = CAD_Store.Read(vb, 2)
                        }
                    }
                    CAD_Sys.Write(1, "  e k=", 6)
                    PrintNumber(ck)
                    CAD_Sys.Write(1, " R=", 3)
                    PrintNumber(Float_ToInt(cr))
                    CAD_Sys.Write(1, " a=", 3)
                    PrintNumber(Float_ToInt(xa))
                    CAD_Sys.Write(1, ",", 1)
                    PrintNumber(Float_ToInt(ya))
                    CAD_Sys.Write(1, ",", 1)
                    PrintNumber(Float_ToInt(za))
                    CAD_Sys.Write(1, " b=", 3)
                    PrintNumber(Float_ToInt(xb))
                    CAD_Sys.Write(1, ",", 1)
                    PrintNumber(Float_ToInt(yb))
                    CAD_Sys.Write(1, ",", 1)
                    PrintNumber(Float_ToInt(zb))
                    CAD_Sys.Write(1, "\n", 1)
                    ce = CAD_Store.Read(ce, 2)
                    IfCondition EqualTo(ce, hd) ThenBlock: { cg = 16 }
                }
                cg = Add(cg, 1)
            }
            face = CAD_Store.Read(face, 3)
        }
        fg = Add(fg, 1)
    }

    mesh = Allocate(32)
    nt = CAD_Tess.MeshSolid(filn, 0x3FB999999999999A, mesh)
    Deallocate(mesh, 32)
    CAD_Sys.Write(1, "mesh nt=", 8)
    PrintNumber(nt)
    CAD_Sys.Write(1, "\n", 1)
    CAD_Sys.Write(1, "NORTH LID DUMP OK\n", 18)
    Deallocate(pl, 128)
    Deallocate(top, 128)
    Deallocate(eds, 4096)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
