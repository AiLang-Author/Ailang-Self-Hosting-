// Square plate + pacman hole (2 LINE radials + 1 major ARC). Fillet the
// 3 inner top edges at R=8. Compiler class 8; vertex SOLVE is Gram rank
// of the two wall Ns (G1 keeps 2-face, independent walls get 3-face).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Blend

SubRoutine.Main {
    CAD_Sys.Write(1, "=== pacman hole fillet ===\n", 27)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n0 = 0
    n100 = 0x4059000000000000
    n50 = 0x4049000000000000
    n25 = 0x4039000000000000
    n20 = 0x4034000000000000
    n8 = 0x4020000000000000
    a0 = 0x3FE921FB54442D18
    a1 = 0x4015FDBBE9BBA775
    p0x = 0x4050EB5EF004D9AE
    p0y = 0x4050EB5EF004D9AE
    p1x = 0x4050EB5EF004D9AE
    p1y = 0x404029421FF64CA4
    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = n20
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddLine(n0, n0, n100, n0)
    CAD_Topo.SweepAddLine(n100, n0, n100, n100)
    CAD_Topo.SweepAddLine(n100, n100, n0, n100)
    CAD_Topo.SweepAddLine(n0, n100, n0, n0)
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddLine(n50, n50, p0x, p0y)
    CAD_Topo.SweepAddArc(n50, n50, n25, a0, a1)
    CAD_Topo.SweepAddLine(p1x, p1y, n50, n50)
    h = CAD_Topo.ExtrudeContours()
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo.RebuildKind0Planes(h)
    eds = Allocate(4096)
    sel = Allocate(64)
    ne = CAD_Topo.SolidCollectEdges(h, eds, 256)
    nsel = 0
    i = 0
    WhileLoop LessThan(i, ne) {
        e = ArrayGet(eds, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.EdgeIsInnerLoop(e), 1) ThenBlock: {
                v0 = CAD_Store.Read(e, 0)
                v1 = CAD_Store.Read(e, 1)
                IfCondition NotEqual(v0, 0) ThenBlock: {
                    IfCondition NotEqual(v1, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v0, 2), n20, 0), 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v1, 2), n20, 0), 1) ThenBlock: {
                                IfCondition LessThan(nsel, 8) ThenBlock: {
                                    ArraySet(sel, nsel, e)
                                    nsel = Add(nsel, 1)
                                }
                            }
                        }
                    }
                }
            }
        }
        i = Add(i, 1)
    }
    PrintMessage("top inner n=")
    PrintNumber(nsel)
    PrintMessage("\n")
    IfCondition NotEqual(nsel, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected 3 inner top edges\n", 32)
        SystemCall(60, 1, 0, 0)
    }
    fil = CAD_Blend.FilletEdges(h, sel, nsel, n8)
    IfCondition EqualTo(fil, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL fillet\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    PrintMessage("fillet class=")
    PrintNumber(CAD_Topo_State.fillet_class)
    PrintMessage("\n")
    IfCondition NotEqual(CAD_Topo_State.fillet_class, 8) ThenBlock: {
        CAD_Sys.Write(1, "FAIL class not 8\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    n_cyl = 0
    n_tor = 0
    n_sph = 0
    sh = CAD_Store.Read(fil, 0)
    WhileLoop NotEqual(sh, 0) {
        fc = CAD_Store.Read(sh, 0)
        WhileLoop NotEqual(fc, 0) {
            surf = CAD_Store.Read(fc, 0)
            IfCondition NotEqual(surf, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 2) ThenBlock: { n_cyl = Add(n_cyl, 1) }
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 3) ThenBlock: { n_sph = Add(n_sph, 1) }
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 4) ThenBlock: { n_tor = Add(n_tor, 1) }
            }
            fc = CAD_Store.Read(fc, 3)
        }
        sh = CAD_Store.Read(sh, 2)
    }
    PrintMessage("cyl=")
    PrintNumber(n_cyl)
    PrintMessage(" tor=")
    PrintNumber(n_tor)
    PrintMessage(" sph=")
    PrintNumber(n_sph)
    PrintMessage("\n")
    IfCondition LessThan(n_sph, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected 3 vertex spheres\n", 31)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(n_tor, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected torus on arc rail\n", 32)
        SystemCall(60, 1, 0, 0)
    }
    PrintMessage("T_host xy ")
    i = 0
    WhileLoop LessThan(i, 3) {
        tv = CAD_Topo.FCoveGet(432, i)
        PrintNumber(i)
        PrintMessage(":")
        IfCondition NotEqual(tv, 0) ThenBlock: {
            PrintNumber(Float_ToInt(CAD_Store.Read(tv, 0)))
            PrintMessage(",")
            PrintNumber(Float_ToInt(CAD_Store.Read(tv, 1)))
        }
        PrintMessage(" ")
        i = Add(i, 1)
    }
    PrintMessage("\n")
    atv = 0
    sh = CAD_Store.Read(fil, 0)
    fc = 0
    IfCondition NotEqual(sh, 0) ThenBlock: { fc = CAD_Store.Read(sh, 0) }
    pl = Allocate(128)
    WhileLoop NotEqual(fc, 0) {
        IfCondition EqualTo(CAD_Topo.FaceGetPlane(fc, pl), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsNeg(ArrayGet(pl, 12)), 0) ThenBlock: {
                lp = CAD_Store.Read(fc, 1)
                IfCondition NotEqual(lp, 0) ThenBlock: { lp = CAD_Store.Read(lp, 2) }
                IfCondition NotEqual(lp, 0) ThenBlock: {
                    ce = CAD_Store.Read(lp, 0)
                    hd = ce
                    g = 0
                    PrintMessage("host inner xy ")
                    WhileLoop LessThan(g, 8) {
                        IfCondition EqualTo(ce, 0) ThenBlock: { g = 8 }
                        IfCondition NotEqual(ce, 0) ThenBlock: {
                            ov = CAD_Store.Read(ce, 5)
                            IfCondition NotEqual(ov, 0) ThenBlock: {
                                PrintNumber(Float_ToInt(CAD_Store.Read(ov, 0)))
                                PrintMessage(",")
                                PrintNumber(Float_ToInt(CAD_Store.Read(ov, 1)))
                                PrintMessage(" ")
                                dx = Float_Sub(CAD_Store.Read(ov, 0), n50)
                                dy = Float_Sub(CAD_Store.Read(ov, 1), n50)
                                IfCondition EqualTo(CAD_Num.IsZero(dx, 0), 1) ThenBlock: {
                                    IfCondition EqualTo(CAD_Num.IsZero(dy, 0), 1) ThenBlock: { atv = 1 }
                                }
                            }
                            ce = CAD_Store.Read(ce, 2)
                            IfCondition EqualTo(ce, hd) ThenBlock: { g = 8 }
                        }
                        g = Add(g, 1)
                    }
                    PrintMessage("\n")
                    fc = 0
                }
            }
        }
        IfCondition NotEqual(fc, 0) ThenBlock: { fc = CAD_Store.Read(fc, 3) }
    }
    Deallocate(pl, 128)
    IfCondition EqualTo(atv, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL host inner still at V\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    mesh = Allocate(48)
    nt = CAD_Tess.MeshSolid(fil, 0, mesh)
    PrintMessage("mesh nv=")
    PrintNumber(ArrayGet(mesh, 0))
    PrintMessage(" nt=")
    PrintNumber(ArrayGet(mesh, 1))
    PrintMessage(" rc=")
    PrintNumber(nt)
    PrintMessage("\n")
    IfCondition LessThan(ArrayGet(mesh, 1), 8) ThenBlock: {
        CAD_Sys.Write(1, "FAIL mesh\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS pacman hole fillet\n", 24)
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
