// App pad is MakePolyPrism, not CreateBox. Digon of 4 top rims used to
// leave a see-through cap (FanNGon on CW quad). Single-edge fillet on a
// dense prism used to SEGV (64-slot ovlist).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== fillet prism box ===\n", 25)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    n0 = 0
    n20 = 0x4034000000000000
    n15 = 0x402E000000000000
    n2 = 0x4000000000000000
    xy = Allocate(64)
    ArraySet(xy, 0, Float_Sub(n0, n20))
    ArraySet(xy, 1, Float_Sub(n0, n15))
    ArraySet(xy, 2, n20)
    ArraySet(xy, 3, Float_Sub(n0, n15))
    ArraySet(xy, 4, n20)
    ArraySet(xy, 5, n15)
    ArraySet(xy, 6, Float_Sub(n0, n20))
    ArraySet(xy, 7, n15)
    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, xy, 4)
    h = CAD_Feat.ExtrudeProfile(hsk, n20)
    PrintMessage("prism=")
    PrintNumber(h)
    PrintMessage("\n")
    pass = 0
    IfCondition NotEqual(h, 0) ThenBlock: {
        edges = Allocate(1024)
        sel = Allocate(64)
        ne = CAD_Topo.SolidCollectEdges(h, edges, 64)
        nsel = 0
        i = 0
        WhileLoop LessThan(i, ne) {
            ed = ArrayGet(edges, i)
            va = CAD_Store.Read(ed, 0)
            vb = CAD_Store.Read(ed, 1)
            IfCondition NotEqual(va, 0) ThenBlock: {
                z0 = CAD_Store.Read(va, 2)
                z1 = CAD_Store.Read(vb, 2)
                IfCondition EqualTo(CAD_Num.IsEqual(z0, n20, 0), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(z1, n20, 0), 1) ThenBlock: {
                        IfCondition LessThan(nsel, 4) ThenBlock: {
                            ArraySet(sel, nsel, ed)
                            nsel = Add(nsel, 1)
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        PrintMessage("top_n=")
        PrintNumber(nsel)
        PrintMessage("\n")
        fil = 0
        IfCondition GreaterEqual(nsel, 4) ThenBlock: {
            fil = CAD_Blend.FilletEdges(h, sel, 4, n2)
        }
        PrintMessage("fillet=")
        PrintNumber(fil)
        PrintMessage("\n")
        body = h
        IfCondition NotEqual(fil, 0) ThenBlock: { body = fil }
        mesh = Allocate(32)
        nt = CAD_Tess.MeshSolid(body, 0x3FB999999999999A, mesh)
        PrintMessage("mesh nt=")
        PrintNumber(nt)
        PrintMessage(" nv=")
        PrintNumber(ArrayGet(mesh, 0))
        wt = CAD_Tess.VerifyWatertight(mesh)
        PrintMessage(" wt=")
        PrintNumber(wt)
        PrintMessage("\n")
        ndup = 0
        ai = 0
        nvx = ArrayGet(mesh, 0)
        vbx = ArrayGet(mesh, 2)
        WhileLoop LessThan(ai, nvx) {
            bi = Add(ai, 1)
            WhileLoop LessThan(bi, nvx) {
                dx = Float_Sub(ArrayGet(vbx, Multiply(ai, 3)), ArrayGet(vbx, Multiply(bi, 3)))
                dy = Float_Sub(ArrayGet(vbx, Add(Multiply(ai, 3), 1)), ArrayGet(vbx, Add(Multiply(bi, 3), 1)))
                dz = Float_Sub(ArrayGet(vbx, Add(Multiply(ai, 3), 2)), ArrayGet(vbx, Add(Multiply(bi, 3), 2)))
                d2 = Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz))
                IfCondition EqualTo(CAD_Num.IsZero(d2, 0), 1) ThenBlock: { ndup = Add(ndup, 1) }
                bi = Add(bi, 1)
            }
            ai = Add(ai, 1)
        }
        PrintMessage("exact_dups=")
        PrintNumber(ndup)
        PrintMessage("\n")
        ebuf = Allocate(32768)
        ecnt = Allocate(32768)
        nee = 0
        t = 0
        ibx = ArrayGet(mesh, 3)
        WhileLoop LessThan(t, nt) {
            a = ArrayGet(ibx, Multiply(t, 3))
            b = ArrayGet(ibx, Add(Multiply(t, 3), 1))
            c = ArrayGet(ibx, Add(Multiply(t, 3), 2))
            k = 0
            WhileLoop LessThan(k, 3) {
                IfCondition EqualTo(k, 0) ThenBlock: { u = a v = b }
                IfCondition EqualTo(k, 1) ThenBlock: { u = b v = c }
                IfCondition EqualTo(k, 2) ThenBlock: { u = c v = a }
                IfCondition GreaterThan(u, v) ThenBlock: {
                    tmp = u
                    u = v
                    v = tmp
                }
                key = Add(Multiply(u, 65536), v)
                found = 0
                j = 0
                WhileLoop LessThan(j, nee) {
                    IfCondition EqualTo(ArrayGet(ebuf, j), key) ThenBlock: {
                        ArraySet(ecnt, j, Add(ArrayGet(ecnt, j), 1))
                        found = 1
                    }
                    j = Add(j, 1)
                }
                IfCondition EqualTo(found, 0) ThenBlock: {
                    ArraySet(ebuf, nee, key)
                    ArraySet(ecnt, nee, 1)
                    nee = Add(nee, 1)
                }
                k = Add(k, 1)
            }
            t = Add(t, 1)
        }
        n1 = 0
        n2 = 0
        n3 = 0
        j = 0
        WhileLoop LessThan(j, nee) {
            c = ArrayGet(ecnt, j)
            IfCondition EqualTo(c, 1) ThenBlock: { n1 = Add(n1, 1) }
            IfCondition EqualTo(c, 2) ThenBlock: { n2 = Add(n2, 1) }
            IfCondition GreaterThan(c, 2) ThenBlock: { n3 = Add(n3, 1) }
            j = Add(j, 1)
        }
        PrintMessage("edges n1=")
        PrintNumber(n1)
        PrintMessage(" n2=")
        PrintNumber(n2)
        PrintMessage(" n3=")
        PrintNumber(n3)
        PrintMessage("\n")
        Deallocate(ebuf, 32768)
        Deallocate(ecnt, 32768)
        v_base = ArrayGet(mesh, 2)
        nv = ArrayGet(mesh, 0)
        nz20 = 0
        nz18 = 0
        nz0 = 0
        vi = 0
        WhileLoop LessThan(vi, nv) {
            zz = ArrayGet(v_base, Add(Multiply(vi, 3), 2))
            IfCondition EqualTo(CAD_Num.IsEqual(zz, n20, 0), 1) ThenBlock: { nz20 = Add(nz20, 1) }
            IfCondition EqualTo(CAD_Num.IsEqual(zz, 0x4032000000000000, 0), 1) ThenBlock: { nz18 = Add(nz18, 1) }
            IfCondition EqualTo(CAD_Num.IsZero(zz, 0), 1) ThenBlock: { nz0 = Add(nz0, 1) }
            vi = Add(vi, 1)
        }
        PrintMessage("vz20=")
        PrintNumber(nz20)
        PrintMessage(" vz18=")
        PrintNumber(nz18)
        PrintMessage(" vz0=")
        PrintNumber(nz0)
        PrintMessage("\n")
        i_base = ArrayGet(mesh, 3)
        ztop = n20
        ztol = 0x3FE0000000000000
        h_mid = 0
        h_corner = 0
        ntop = 0
        t = 0
        WhileLoop LessThan(t, nt) {
            i0 = ArrayGet(i_base, Multiply(t, 3))
            i1 = ArrayGet(i_base, Add(Multiply(t, 3), 1))
            i2 = ArrayGet(i_base, Add(Multiply(t, 3), 2))
            z0 = ArrayGet(v_base, Add(Multiply(i0, 3), 2))
            z1 = ArrayGet(v_base, Add(Multiply(i1, 3), 2))
            z2 = ArrayGet(v_base, Add(Multiply(i2, 3), 2))
            d0 = Float_Sub(z0, ztop)
            IfCondition EqualTo(CAD_Num.IsNeg(d0), 1) ThenBlock: { d0 = Float_Sub(n0, d0) }
            d1 = Float_Sub(z1, ztop)
            IfCondition EqualTo(CAD_Num.IsNeg(d1), 1) ThenBlock: { d1 = Float_Sub(n0, d1) }
            d2 = Float_Sub(z2, ztop)
            IfCondition EqualTo(CAD_Num.IsNeg(d2), 1) ThenBlock: { d2 = Float_Sub(n0, d2) }
            IfCondition EqualTo(Float_Le(d0, ztol), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(d1, ztol), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(d2, ztol), 1) ThenBlock: {
                        ntop = Add(ntop, 1)
                        PrintMessage(" txy ")
                        PrintNumber(Float_ToInt(ArrayGet(v_base, Multiply(i0, 3))))
                        PrintMessage(",")
                        PrintNumber(Float_ToInt(ArrayGet(v_base, Add(Multiply(i0, 3), 1))))
                        PrintMessage(" / ")
                        PrintNumber(Float_ToInt(ArrayGet(v_base, Multiply(i1, 3))))
                        PrintMessage(",")
                        PrintNumber(Float_ToInt(ArrayGet(v_base, Add(Multiply(i1, 3), 1))))
                        PrintMessage(" / ")
                        PrintNumber(Float_ToInt(ArrayGet(v_base, Multiply(i2, 3))))
                        PrintMessage(",")
                        PrintNumber(Float_ToInt(ArrayGet(v_base, Add(Multiply(i2, 3), 1))))
                        PrintMessage("\n")
                        pa = Allocate(32)
                        pb = Allocate(32)
                        pc = Allocate(32)
                        pd = Allocate(32)
                        ArraySet(pa, 0, ArrayGet(v_base, Multiply(i0, 3)))
                        ArraySet(pa, 1, ArrayGet(v_base, Add(Multiply(i0, 3), 1)))
                        ArraySet(pb, 0, ArrayGet(v_base, Multiply(i1, 3)))
                        ArraySet(pb, 1, ArrayGet(v_base, Add(Multiply(i1, 3), 1)))
                        ArraySet(pc, 0, ArrayGet(v_base, Multiply(i2, 3)))
                        ArraySet(pc, 1, ArrayGet(v_base, Add(Multiply(i2, 3), 1)))
                        ArraySet(pd, 0, n0)
                        ArraySet(pd, 1, n0)
                        o1 = CAD_Num.Orient2D(pa, pb, pd)
                        o2 = CAD_Num.Orient2D(pb, pc, pd)
                        o3 = CAD_Num.Orient2D(pc, pa, pd)
                        IfCondition EqualTo(o1, o2) ThenBlock: {
                            IfCondition EqualTo(o2, o3) ThenBlock: {
                                IfCondition NotEqual(o1, 0) ThenBlock: { h_mid = Add(h_mid, 1) }
                            }
                        }
                        ArraySet(pd, 0, n20)
                        ArraySet(pd, 1, n15)
                        o1 = CAD_Num.Orient2D(pa, pb, pd)
                        o2 = CAD_Num.Orient2D(pb, pc, pd)
                        o3 = CAD_Num.Orient2D(pc, pa, pd)
                        IfCondition EqualTo(o1, o2) ThenBlock: {
                            IfCondition EqualTo(o2, o3) ThenBlock: {
                                IfCondition NotEqual(o1, 0) ThenBlock: { h_corner = Add(h_corner, 1) }
                            }
                        }
                        Deallocate(pa, 32)
                        Deallocate(pb, 32)
                        Deallocate(pc, 32)
                        Deallocate(pd, 32)
                    }
                }
            }
            t = Add(t, 1)
        }
        PrintMessage("top_tris=")
        PrintNumber(ntop)
        PrintMessage(" cap_mid=")
        PrintNumber(h_mid)
        PrintMessage(" corner=")
        PrintNumber(h_corner)
        PrintMessage("\n")
        // cap center covered; original sharp corner empty; more tris than a box
        // (0,0) sits on the cap diagonal → Orient2D==0, so use top_tris
        // 4-rim must also be watertight (no open zipper at ellipse generators)
        IfCondition GreaterThan(ntop, 1) ThenBlock: {
            IfCondition EqualTo(h_corner, 0) ThenBlock: {
                IfCondition GreaterThan(nt, 16) ThenBlock: {
                    IfCondition EqualTo(wt, 1) ThenBlock: {
                        IfCondition EqualTo(n1, 0) ThenBlock: { pass = 1 }
                    }
                }
            }
        }
        Deallocate(mesh, 32)
        Deallocate(sel, 64)
        Deallocate(edges, 1024)
    }

    // dense prism: one top rim edge must not SEGV
    n80 = 80
    two_pi = 0x401921FB54442D18
    circ = Allocate(2048)
    i = 0
    WhileLoop LessThan(i, n80) {
        th = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(n80)))
        ArraySet(circ, Multiply(i, 2), Float_Mul(n15, CAD_Geom.Cos(th)))
        ArraySet(circ, Add(Multiply(i, 2), 1), Float_Mul(n15, CAD_Geom.Sin(th)))
        i = Add(i, 1)
    }
    hsk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk2, circ, n80)
    h2 = CAD_Feat.ExtrudeProfile(hsk2, n20)
    PrintMessage("dense=")
    PrintNumber(h2)
    PrintMessage("\n")
    IfCondition NotEqual(h2, 0) ThenBlock: {
        edges = Allocate(4096)
        ne = CAD_Topo.SolidCollectEdges(h2, edges, 512)
        ed = 0
        i = 0
        WhileLoop LessThan(i, ne) {
            e = ArrayGet(edges, i)
            va = CAD_Store.Read(e, 0)
            vb = CAD_Store.Read(e, 1)
            IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vb, 2), n20, 0), 1) ThenBlock: {
                    ed = e
                    i = ne
                }
            }
            i = Add(i, 1)
        }
        f2 = 0
        IfCondition NotEqual(ed, 0) ThenBlock: {
            f2 = CAD_Blend.FilletEdge(h2, ed, n2)
        }
        PrintMessage("dense_fil=")
        PrintNumber(f2)
        PrintMessage("\n")
        body = h2
        IfCondition NotEqual(f2, 0) ThenBlock: { body = f2 }
        mesh = Allocate(32)
        nt = CAD_Tess.MeshSolid(body, 0x3FB999999999999A, mesh)
        PrintMessage("dense_nt=")
        PrintNumber(nt)
        PrintMessage("\n")
        IfCondition GreaterThan(nt, 20) ThenBlock: {
            IfCondition EqualTo(pass, 1) ThenBlock: { pass = 1 }
            IfCondition EqualTo(pass, 0) ThenBlock: {
                IfCondition NotEqual(f2, 0) ThenBlock: { pass = 1 }
            }
        }
        IfCondition EqualTo(nt, 0) ThenBlock: { pass = 0 }
        Deallocate(mesh, 32)
        Deallocate(edges, 4096)
    }
    Deallocate(circ, 2048)
    Deallocate(xy, 64)
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "FILLET PRISM BOX PASS\n", 22)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "FILLET PRISM BOX FAIL\n", 22)
    }
    SystemCall(60, Subtract(1, pass), 0, 0)
}
RunTask(Main)
