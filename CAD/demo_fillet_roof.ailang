// Shallow dihedral digon: "house roof" style flatish triangle.
// Apex interior 165° → planes meet at 15° (nearly coplanar roof faces).
// Legs 60 mm, height 20 mm, R=2.5 (different radius; inradius ~3.9).
// Expect: 3 CYL + 3 ELLIPSE digon + 5 planes, 0 sphere.
// Look-at: test-stl/cad_fillet_roof.stp
//
// Cross-section (top view of prism triangle):
//   long base between ends of the two legs; apex is the flatish ridge angle.
//   Angle between the two side walls at the apex edge = 165° solid / 15° plane-to-plane.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== FilletEdges digon ROOF 15deg ===\n", 37)
    CAD_Sys.Write(1, "DIM legs=60 H=20 apex=165deg (planes 15deg) R=2.5\n", 50)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    // Apex (0,0) angle 165°: (60,0) and (60*cos165, 60*sin165) ≈ (-57.956, 15.529)
    out = Allocate(16)
    body = CAD_Topo.MakeWedgePrism(0x404E000000000000, 0xC04CFA4F72D43323, 0x402F0EEBCAF3AC57, 0x4034000000000000, out)
    Deallocate(out, 16)
    IfCondition EqualTo(body, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL MakeWedgePrism\n", 20)
        SystemCall(60, 1, 0, 0)
    }

    edges = Allocate(1024)
    sel = Allocate(32)
    faces = Allocate(32)
    pl = Allocate(128)
    ne = CAD_Topo.SolidCollectEdges(body, edges, 128)
    nsel = 0
    j = 0
    // top cycle: both endpoints at z = 20
    WhileLoop LessThan(j, ne) {
        ed = ArrayGet(edges, j)
        IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(ed, faces), 0) ThenBlock: {
            ok1 = CAD_Topo.FaceGetPlane(ArrayGet(faces, 0), pl)
            ok2 = CAD_Topo.FaceGetPlane(ArrayGet(faces, 1), pl)
            IfCondition EqualTo(ok1, 0) ThenBlock: {
                IfCondition EqualTo(ok2, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(CAD_Store.Read(ed, 0), 2), 0x4034000000000000, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(CAD_Store.Read(ed, 1), 2), 0x4034000000000000, 0), 1) ThenBlock: {
                            ArraySet(sel, nsel, ed)
                            nsel = Add(nsel, 1)
                        }
                    }
                }
            }
        }
        j = Add(j, 1)
    }
    IfCondition NotEqual(nsel, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL need exactly 3 top edges\n", 30)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "top edges nsel=3\n", 17)

    // R = 2.5 (different from box R=4 / wedge31 R=3)
    fil = CAD_Blend.FilletEdges(body, sel, nsel, 0x4004000000000000)
    IfCondition EqualTo(fil, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL FilletEdges digon roof\n", 28)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(fil, "test-stl/cad_fillet_roof.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL STEP\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote cad_fillet_roof.stp\n", 26)
    CAD_Sys.Write(1, "expect: 3 CYL + 3 ELLIPSE, shallow 15deg, R=2.5, 0 sphere\n", 58)
    CAD_Sys.Write(1, "FILLET ROOF DIGON OK\n", 21)
    Deallocate(edges, 1024)
    Deallocate(sel, 32)
    Deallocate(faces, 32)
    Deallocate(pl, 128)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
