// Rounded-rect pad glued on a plate, fillet the inner LINE+ARC join.
// Dual of class-8 outer rim: cylinders on flats, quarter-tori on arcs,
// but cove (Rmaj = r+R). R may equal the 2D corner radius.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_Tess

SubRoutine.Main {
    CAD_Sys.Write(1, "=== inner rounded rim cove ===\n", 31)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n80 = 0x4054000000000000
    n25 = 0x4039000000000000
    n17 = 0x4031000000000000
    n20 = 0x4034000000000000
    n8 = 0x4020000000000000
    n5 = 0x4014000000000000
    n0 = 0
    half_pi = 0x3FF921FB54442D18
    pi = 0x400921FB54442D18
    xy = Allocate(64)
    ArraySet(xy, 0, Float_Sub(0, n80))
    ArraySet(xy, 1, Float_Sub(0, n80))
    ArraySet(xy, 2, n80)
    ArraySet(xy, 3, Float_Sub(0, n80))
    ArraySet(xy, 4, n80)
    ArraySet(xy, 5, n80)
    ArraySet(xy, 6, Float_Sub(0, n80))
    ArraySet(xy, 7, n80)
    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, xy, 4)
    host = CAD_Feat.ExtrudeProfile(hsk, n20)
    IfCondition EqualTo(host, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL host\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = n20
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddLine(Float_Sub(0, n17), Float_Sub(0, n25), n17, Float_Sub(0, n25))
    CAD_Topo.SweepAddArc(n17, Float_Sub(0, n17), n8, Float_Sub(0, half_pi), n0)
    CAD_Topo.SweepAddLine(n25, Float_Sub(0, n17), n25, n17)
    CAD_Topo.SweepAddArc(n17, n17, n8, n0, half_pi)
    CAD_Topo.SweepAddLine(n17, n25, Float_Sub(0, n17), n25)
    CAD_Topo.SweepAddArc(Float_Sub(0, n17), n17, n8, half_pi, pi)
    CAD_Topo.SweepAddLine(Float_Sub(0, n25), n17, Float_Sub(0, n25), Float_Sub(0, n17))
    CAD_Topo.SweepAddArc(Float_Sub(0, n17), Float_Sub(0, n17), n8, pi, Float_Sub(0, half_pi))
    tool = CAD_Topo.ExtrudeContours()
    IfCondition EqualTo(tool, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL tool\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    dlt = Allocate(32)
    ArraySet(dlt, 0, n0)
    ArraySet(dlt, 1, n0)
    ArraySet(dlt, 2, n20)
    CAD_Topo.TranslateSolid(tool, dlt)
    Deallocate(dlt, 32)
    CAD_Topo.RebuildKind0Planes(host)
    CAD_Topo.RebuildKind0Planes(tool)
    body = CAD_Bool.GlueOnFace(host, tool)
    IfCondition EqualTo(body, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL glue\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    ns0 = CAD_Topo.SolidCountShells(body)
    nf0 = CAD_Topo.SolidCountFaces(body)
    PrintMessage("glue shells=")
    PrintNumber(ns0)
    PrintMessage(" faces=")
    PrintNumber(nf0)
    PrintMessage(" inner=")
    PrintNumber(CAD_Topo.SolidHasInnerLoop(body))
    PrintMessage("\n")
    IfCondition NotEqual(ns0, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL shells\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    eds = Allocate(4096)
    join = Allocate(64)
    ne = CAD_Topo.SolidCollectEdges(body, eds, 256)
    nj = 0
    i = 0
    WhileLoop LessThan(i, ne) {
        e = ArrayGet(eds, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.EdgeIsInnerLoop(e), 1) ThenBlock: {
                IfCondition LessThan(nj, 8) ThenBlock: {
                    ArraySet(join, nj, e)
                    nj = Add(nj, 1)
                }
            }
        }
        i = Add(i, 1)
    }
    PrintMessage("join n=")
    PrintNumber(nj)
    PrintMessage("\n")
    IfCondition NotEqual(nj, 8) ThenBlock: {
        CAD_Sys.Write(1, "FAIL join n\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo_State.fillet_concave = 1
    fil = CAD_Blend.FilletEdges(body, join, 8, n5)
    PrintMessage("R5 fil=")
    PrintNumber(fil)
    PrintMessage(" class=")
    PrintNumber(CAD_Topo_State.fillet_class)
    PrintMessage("\n")
    IfCondition EqualTo(fil, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL R5 fillet\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Topo_State.fillet_class, 8) ThenBlock: {
        CAD_Sys.Write(1, "FAIL class not 8\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    n_cyl = 0
    n_tor = 0
    n_sph = 0
    sh = CAD_Store.Read(fil, 0)
    WhileLoop NotEqual(sh, 0) {
        fc = CAD_Store.Read(sh, 0)
        WhileLoop NotEqual(fc, 0) {
            surf = CAD_Store.Read(fc, 0)
            IfCondition NotEqual(surf, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 2) ThenBlock: { n_cyl = Add(n_cyl, 1) }
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 3) ThenBlock: { n_sph = Add(n_sph, 1) }
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 4) ThenBlock: { n_tor = Add(n_tor, 1) }
            }
            fc = CAD_Store.Read(fc, 3)
        }
        sh = CAD_Store.Read(sh, 2)
    }
    PrintMessage("cyl=")
    PrintNumber(n_cyl)
    PrintMessage(" tor=")
    PrintNumber(n_tor)
    PrintMessage(" sph=")
    PrintNumber(n_sph)
    PrintMessage(" faces=")
    PrintNumber(CAD_Topo.SolidCountFaces(fil))
    PrintMessage("\n")
    mesh = Allocate(48)
    nmesh = CAD_Tess.MeshSolid(fil, 0, mesh)
    PrintMessage("nt=")
    PrintNumber(nmesh)
    PrintMessage("\n")
    Deallocate(mesh, 48)
    Deallocate(eds, 4096)
    Deallocate(join, 64)
    Deallocate(xy, 64)
    pass = 0
    IfCondition EqualTo(n_tor, 4) ThenBlock: {
        IfCondition GreaterEqual(n_cyl, 8) ThenBlock: {
            IfCondition EqualTo(n_sph, 0) ThenBlock: {
                IfCondition GreaterThan(nmesh, 200) ThenBlock: { pass = 1 }
            }
        }
    }
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "INNER RIM COVE PASS\n", 20)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "INNER RIM COVE FAIL\n", 20)
    }
    SystemCall(60, Subtract(1, pass), 0, 0)
}
RunTask(Main)
