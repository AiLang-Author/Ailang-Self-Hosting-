// Rounded-rect pad (4 LINE + 4 ARC) top-rim outer fillet.
// R=8 on r=8 arcs must NOT crash (R too large). R=3 is class 8.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_Tess

SubRoutine.Main {
    CAD_Sys.Write(1, "=== outer rounded rim ===\n", 26)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n25 = 0x4039000000000000
    n17 = 0x4031000000000000
    n20 = 0x4034000000000000
    n8 = 0x4020000000000000
    n3 = 0x4008000000000000
    n0 = 0
    half_pi = 0x3FF921FB54442D18
    pi = 0x400921FB54442D18
    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = n20
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddLine(Float_Sub(0, n17), Float_Sub(0, n25), n17, Float_Sub(0, n25))
    CAD_Topo.SweepAddArc(n17, Float_Sub(0, n17), n8, Float_Sub(0, half_pi), n0)
    CAD_Topo.SweepAddLine(n25, Float_Sub(0, n17), n25, n17)
    CAD_Topo.SweepAddArc(n17, n17, n8, n0, half_pi)
    CAD_Topo.SweepAddLine(n17, n25, Float_Sub(0, n17), n25)
    CAD_Topo.SweepAddArc(Float_Sub(0, n17), n17, n8, half_pi, pi)
    CAD_Topo.SweepAddLine(Float_Sub(0, n25), n17, Float_Sub(0, n25), Float_Sub(0, n17))
    CAD_Topo.SweepAddArc(Float_Sub(0, n17), Float_Sub(0, n17), n8, pi, Float_Sub(0, half_pi))
    host = CAD_Topo.ExtrudeContours()
    IfCondition EqualTo(host, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo.RebuildKind0Planes(host)
    eds = Allocate(4096)
    top = Allocate(128)
    ne = CAD_Topo.SolidCollectEdges(host, eds, 256)
    nt = 0
    i = 0
    WhileLoop LessThan(i, ne) {
        e = ArrayGet(eds, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            va = CAD_Store.Read(e, 0)
            vb = CAD_Store.Read(e, 1)
            IfCondition NotEqual(va, 0) ThenBlock: {
                IfCondition NotEqual(vb, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vb, 2), n20, 0), 1) ThenBlock: {
                            IfCondition LessThan(nt, 8) ThenBlock: {
                                ArraySet(top, nt, e)
                                nt = Add(nt, 1)
                            }
                        }
                    }
                }
            }
        }
        i = Add(i, 1)
    }
    PrintMessage("top n=")
    PrintNumber(nt)
    PrintMessage("\n")
    i = 0
    WhileLoop LessThan(i, nt) {
        e = ArrayGet(top, i)
        PrintMessage(" e")
        PrintNumber(i)
        PrintMessage(" v0=")
        PrintNumber(CAD_Store.Read(e, 0))
        PrintMessage(" v1=")
        PrintNumber(CAD_Store.Read(e, 1))
        PrintMessage(" k=")
        cr = CAD_Store.Read(e, 2)
        IfCondition NotEqual(cr, 0) ThenBlock: { PrintNumber(CAD_Store.Read(cr, 0)) }
        PrintMessage("\n")
        i = Add(i, 1)
    }
    IfCondition NotEqual(nt, 8) ThenBlock: {
        CAD_Sys.Write(1, "FAIL top n\n", 11)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo_State.fillet_concave = 0
    big = CAD_Blend.FilletEdges(host, top, 8, n8)
    PrintMessage("R8 fil=")
    PrintNumber(big)
    PrintMessage(" class=")
    PrintNumber(CAD_Topo_State.fillet_class)
    PrintMessage(" reason=")
    PrintNumber(CAD_Topo_State.fillet_reason)
    PrintMessage("\n")
    IfCondition NotEqual(big, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL R=r must refuse\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Topo_State.fillet_reason, 6) ThenBlock: {
        CAD_Sys.Write(1, "FAIL reason not 6\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo_State.fillet_concave = 0
    fil = CAD_Blend.FilletEdges(host, top, 8, n3)
    PrintMessage("R3 fil=")
    PrintNumber(fil)
    PrintMessage(" class=")
    PrintNumber(CAD_Topo_State.fillet_class)
    PrintMessage("\n")
    IfCondition EqualTo(fil, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL R3 fillet\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Topo_State.fillet_class, 8) ThenBlock: {
        CAD_Sys.Write(1, "FAIL class not 8\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    n_cyl = 0
    n_tor = 0
    n_sph = 0
    sh = CAD_Store.Read(fil, 0)
    WhileLoop NotEqual(sh, 0) {
        fc = CAD_Store.Read(sh, 0)
        WhileLoop NotEqual(fc, 0) {
            surf = CAD_Store.Read(fc, 0)
            IfCondition NotEqual(surf, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 2) ThenBlock: { n_cyl = Add(n_cyl, 1) }
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 3) ThenBlock: { n_sph = Add(n_sph, 1) }
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 4) ThenBlock: { n_tor = Add(n_tor, 1) }
            }
            fc = CAD_Store.Read(fc, 3)
        }
        sh = CAD_Store.Read(sh, 2)
    }
    PrintMessage("cyl=")
    PrintNumber(n_cyl)
    PrintMessage(" tor=")
    PrintNumber(n_tor)
    PrintMessage(" sph=")
    PrintNumber(n_sph)
    PrintMessage(" faces=")
    PrintNumber(CAD_Topo.SolidCountFaces(fil))
    PrintMessage("\n")
    mesh = Allocate(48)
    nmesh = CAD_Tess.MeshSolid(fil, 0, mesh)
    PrintMessage("nt=")
    PrintNumber(nmesh)
    PrintMessage("\n")
    Deallocate(mesh, 48)
    Deallocate(eds, 4096)
    Deallocate(top, 128)
    pass = 0
    IfCondition EqualTo(n_tor, 4) ThenBlock: {
        IfCondition GreaterEqual(n_cyl, 4) ThenBlock: {
            IfCondition EqualTo(n_sph, 0) ThenBlock: {
                IfCondition GreaterThan(nmesh, 50) ThenBlock: { pass = 1 }
            }
        }
    }
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "OUTER RIM PASS\n", 15)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "OUTER RIM FAIL\n", 15)
    }
    SystemCall(60, Subtract(1, pass), 0, 0)
}
RunTask(Main)
