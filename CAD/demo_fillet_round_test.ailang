// Three questions from notroundedcorner.png:
//  1) Bare box verticals (plane–plane) — sequential.
//  2) Analytic cylinder TOP circular rim (plane–cyl lathe recipe).
//  3) After 4-top Digon, remaining verticals: both supports plane?
//     end-faces at P_ww still plane? FilletEdge on them?
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Script

SubRoutine.Main {
    CAD_Sys.Write(1, "=== fillet round test ===\n", 26)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    n0 = 0
    n20 = 0x4034000000000000
    n15 = 0x402E000000000000
    n2 = 0x4000000000000000
    n8 = 0x4020000000000000
    faces = Allocate(32)
    pl = Allocate(128)
    mesh = Allocate(32)

    // --- A: prism, 4 VERTICALS only ---
    CAD_Sys.Write(1, "-- A bare verticals --\n", 23)
    xy = Allocate(64)
    ArraySet(xy, 0, Float_Sub(n0, n20))
    ArraySet(xy, 1, Float_Sub(n0, n15))
    ArraySet(xy, 2, n20)
    ArraySet(xy, 3, Float_Sub(n0, n15))
    ArraySet(xy, 4, n20)
    ArraySet(xy, 5, n15)
    ArraySet(xy, 6, Float_Sub(n0, n20))
    ArraySet(xy, 7, n15)
    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, xy, 4)
    ha = CAD_Feat.ExtrudeProfile(hsk, n20)
    edges = Allocate(1024)
    ne = CAD_Topo.SolidCollectEdges(ha, edges, 64)
    sel = Allocate(64)
    nsel = 0
    i = 0
    WhileLoop LessThan(i, ne) {
        ed = ArrayGet(edges, i)
        va = CAD_Store.Read(ed, 0)
        vb = CAD_Store.Read(ed, 1)
        dz = Float_Sub(CAD_Store.Read(vb, 2), CAD_Store.Read(va, 2))
        IfCondition EqualTo(CAD_Num.IsNeg(dz), 1) ThenBlock: { dz = Float_Sub(n0, dz) }
        IfCondition EqualTo(CAD_Num.IsZero(dz, 0), 0) ThenBlock: {
            IfCondition LessThan(nsel, 4) ThenBlock: {
                ArraySet(sel, nsel, ed)
                nsel = Add(nsel, 1)
            }
        }
        i = Add(i, 1)
    }
    PrintMessage("A nV=")
    PrintNumber(nsel)
    PrintMessage("\n")
    fa = 0
    IfCondition EqualTo(nsel, 4) ThenBlock: {
        fa = CAD_Blend.FilletEdges(ha, sel, 4, n2)
    }
    PrintMessage("A fillet=")
    PrintNumber(fa)
    PrintMessage("\n")
    body = ha
    IfCondition NotEqual(fa, 0) ThenBlock: { body = fa }
    nt = CAD_Tess.MeshSolid(body, 0x3FB999999999999A, mesh)
    PrintMessage("A mesh nt=")
    PrintNumber(nt)
    PrintMessage(" wt=")
    PrintNumber(CAD_Tess.VerifyWatertight(mesh))
    PrintMessage("\n")

    // --- B: analytic cylinder top rim ---
    CAD_Sys.Write(1, "-- B cyl top rim --\n", 20)
    cyl = CAD_Script.CreateCylinder(n15, n20)
    PrintMessage("B cyl=")
    PrintNumber(cyl)
    PrintMessage(" kind=")
    PrintNumber(CAD_Store.Read(cyl, 3))
    PrintMessage("\n")
    ne = CAD_Topo.SolidCollectEdges(cyl, edges, 32)
    found = 0
    i = 0
    WhileLoop LessThan(i, ne) {
        ed = ArrayGet(edges, i)
        va = CAD_Store.Read(ed, 0)
        IfCondition NotEqual(va, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 1) ThenBlock: {
                crv = CAD_Store.Read(ed, 2)
                IfCondition NotEqual(crv, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(crv, 0), 2) ThenBlock: { found = ed }
                }
                IfCondition EqualTo(found, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(ed, 0), CAD_Store.Read(ed, 1)) ThenBlock: { found = ed }
                }
            }
        }
        i = Add(i, 1)
    }
    PrintMessage("B top_edge=")
    PrintNumber(found)
    PrintMessage("\n")
    fb = 0
    IfCondition NotEqual(found, 0) ThenBlock: {
        fb = CAD_Blend.FilletEdge(cyl, found, n2)
    }
    PrintMessage("B fillet=")
    PrintNumber(fb)
    PrintMessage("\n")
    IfCondition NotEqual(fb, 0) ThenBlock: {
        nt = CAD_Tess.MeshSolid(fb, 0x3FB999999999999A, mesh)
        PrintMessage("B mesh nt=")
        PrintNumber(nt)
        PrintMessage("\n")
    }

    // --- C: 4-top Digon then remaining verticals ---
    CAD_Sys.Write(1, "-- C top then verticals --\n", 26)
    hsk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk2, xy, 4)
    hc = CAD_Feat.ExtrudeProfile(hsk2, n20)
    ne = CAD_Topo.SolidCollectEdges(hc, edges, 64)
    nsel = 0
    i = 0
    WhileLoop LessThan(i, ne) {
        ed = ArrayGet(edges, i)
        va = CAD_Store.Read(ed, 0)
        vb = CAD_Store.Read(ed, 1)
        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vb, 2), n20, 0), 1) ThenBlock: {
                IfCondition LessThan(nsel, 4) ThenBlock: {
                    ArraySet(sel, nsel, ed)
                    nsel = Add(nsel, 1)
                }
            }
        }
        i = Add(i, 1)
    }
    PrintMessage("C top_n=")
    PrintNumber(nsel)
    PrintMessage("\n")
    fc = 0
    IfCondition EqualTo(nsel, 4) ThenBlock: {
        fc = CAD_Blend.FilletEdges(hc, sel, 4, n8)
    }
    PrintMessage("C digon=")
    PrintNumber(fc)
    PrintMessage("\n")
    nV = 0
    n_plane_pair = 0
    n_end_plane = 0
    n_end_cyl = 0
    n_fil = 0
    IfCondition NotEqual(fc, 0) ThenBlock: {
        ne = CAD_Topo.SolidCollectEdges(fc, edges, 128)
        i = 0
        WhileLoop LessThan(i, ne) {
            ed = ArrayGet(edges, i)
            va = CAD_Store.Read(ed, 0)
            vb = CAD_Store.Read(ed, 1)
            IfCondition NotEqual(va, 0) ThenBlock: {
                IfCondition NotEqual(vb, 0) ThenBlock: {
                    IfCondition NotEqual(va, vb) ThenBlock: {
                        dz = Float_Sub(CAD_Store.Read(vb, 2), CAD_Store.Read(va, 2))
                        IfCondition EqualTo(CAD_Num.IsNeg(dz), 1) ThenBlock: { dz = Float_Sub(n0, dz) }
                        IfCondition EqualTo(CAD_Num.IsZero(dz, 0), 0) ThenBlock: {
                            nV = Add(nV, 1)
                            okp = 0
                            fA = 0
                            fB = 0
                            IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(ed, faces), 0) ThenBlock: {
                                fA = ArrayGet(faces, 0)
                                fB = ArrayGet(faces, 1)
                                o1 = CAD_Topo.FaceGetPlane(fA, pl)
                                o2 = CAD_Topo.FaceGetPlane(fB, pl)
                                IfCondition EqualTo(o1, 0) ThenBlock: {
                                    IfCondition EqualTo(o2, 0) ThenBlock: { okp = 1 n_plane_pair = Add(n_plane_pair, 1) }
                                }
                            }
                            // end faces at both verts (skip the two support walls)
                            e0 = CAD_Topo.FindFaceWithVert(fc, va, fA, fB)
                            e1 = CAD_Topo.FindFaceWithVert(fc, vb, fA, fB)
                            IfCondition NotEqual(e0, 0) ThenBlock: {
                                IfCondition EqualTo(CAD_Topo.FaceGetPlane(e0, pl), 0) ThenBlock: { n_end_plane = Add(n_end_plane, 1) }
                                IfCondition NotEqual(CAD_Topo.FaceGetPlane(e0, pl), 0) ThenBlock: { n_end_cyl = Add(n_end_cyl, 1) }
                            }
                            IfCondition NotEqual(e1, 0) ThenBlock: {
                                IfCondition EqualTo(CAD_Topo.FaceGetPlane(e1, pl), 0) ThenBlock: { n_end_plane = Add(n_end_plane, 1) }
                                IfCondition NotEqual(CAD_Topo.FaceGetPlane(e1, pl), 0) ThenBlock: { n_end_cyl = Add(n_end_cyl, 1) }
                            }
                            IfCondition EqualTo(e0, 0) ThenBlock: { n_end_cyl = Add(n_end_cyl, 1) }
                            IfCondition EqualTo(e1, 0) ThenBlock: { n_end_cyl = Add(n_end_cyl, 1) }
                            IfCondition EqualTo(okp, 1) ThenBlock: {
                                IfCondition LessThan(n_fil, 1) ThenBlock: {
                                    // one local on a remaining vertical
                                    fv = CAD_Blend.FilletEdge(fc, ed, n8)
                                    PrintMessage("C one-vert fillet=")
                                    PrintNumber(fv)
                                    PrintMessage("\n")
                                    n_fil = 1
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
    }
    PrintMessage("C remain nV=")
    PrintNumber(nV)
    PrintMessage(" plane_pair=")
    PrintNumber(n_plane_pair)
    PrintMessage(" end_plane=")
    PrintNumber(n_end_plane)
    PrintMessage(" end_nonplane=")
    PrintNumber(n_end_cyl)
    PrintMessage("\n")

    // closed circles / ellipses after Digon (the un-pickable corners)
    ncirc = 0
    nell = 0
    IfCondition NotEqual(fc, 0) ThenBlock: {
        ne = CAD_Topo.SolidCollectEdges(fc, edges, 128)
        i = 0
        WhileLoop LessThan(i, ne) {
            ed = ArrayGet(edges, i)
            crv = CAD_Store.Read(ed, 2)
            IfCondition NotEqual(crv, 0) ThenBlock: {
                knd = CAD_Store.Read(crv, 0)
                IfCondition EqualTo(knd, 2) ThenBlock: { ncirc = Add(ncirc, 1) }
                IfCondition EqualTo(knd, 3) ThenBlock: { nell = Add(nell, 1) }
            }
            i = Add(i, 1)
        }
    }
    PrintMessage("C ncirc=")
    PrintNumber(ncirc)
    PrintMessage(" nell=")
    PrintNumber(nell)
    PrintMessage("\n")

    Deallocate(faces, 32)
    Deallocate(pl, 128)
    Deallocate(mesh, 32)
    Deallocate(edges, 1024)
    Deallocate(sel, 64)
    Deallocate(xy, 64)
    CAD_Sys.Write(1, "=== round test done ===\n", 24)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
