LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== fillet + 3 holes ===\n", 25)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = 0x4034000000000000
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddLine(0xC049000000000000, 0xC049000000000000, 0x4049000000000000, 0xC049000000000000)
    CAD_Topo.SweepAddLine(0x4049000000000000, 0xC049000000000000, 0x4049000000000000, 0x4049000000000000)
    CAD_Topo.SweepAddLine(0x4049000000000000, 0x4049000000000000, 0xC03E000000000000, 0x4049000000000000)
    CAD_Topo.SweepAddArc(0xC03E000000000000, 0x403E000000000000, 0x4034000000000000, 0x3FF921FB54442D18, 0x400921FB54442D18)
    CAD_Topo.SweepAddLine(0xC049000000000000, 0x403E000000000000, 0xC049000000000000, 0xC049000000000000)
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddLine(0xC041000000000000, 0x4040800000000000, 0xC043000000000000, 0x4036000000000000)
    CAD_Topo.SweepAddLine(0xC043000000000000, 0x4036000000000000, 0xC038000000000000, 0x4043000000000000)
    CAD_Topo.SweepAddLine(0xC038000000000000, 0x4043000000000000, 0xC041000000000000, 0x4040800000000000)
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddLine(0, 0xC040000000000000, 0x4037000000000000, 0xC037000000000000)
    CAD_Topo.SweepAddLine(0x4037000000000000, 0xC037000000000000, 0x4040000000000000, 0)
    CAD_Topo.SweepAddLine(0x4040000000000000, 0, 0x4037000000000000, 0x4037000000000000)
    CAD_Topo.SweepAddLine(0x4037000000000000, 0x4037000000000000, 0, 0x4040000000000000)
    CAD_Topo.SweepAddLine(0, 0x4040000000000000, 0xC037000000000000, 0x4037000000000000)
    CAD_Topo.SweepAddLine(0xC037000000000000, 0x4037000000000000, 0xC040000000000000, 0)
    CAD_Topo.SweepAddLine(0xC040000000000000, 0, 0xC037000000000000, 0xC037000000000000)
    CAD_Topo.SweepAddLine(0xC037000000000000, 0xC037000000000000, 0, 0xC040000000000000)
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddArc(0x4041800000000000, 0xC041800000000000, 0x4024000000000000, 0, 0x401921FB54442D18)
    PrintMessage("ncont=")
    PrintNumber(CAD_Topo_Sweep.ncont)
    PrintMessage(" ncurve=")
    PrintNumber(CAD_Topo_Sweep.ncurve)
    PrintMessage("\n")
    h = CAD_Topo.ExtrudeContours()
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo_Sweep.out = CAD_Store.Read(h, 0)
    CAD_Topo_Sweep.lp0 = CAD_Store.Read(CAD_Topo_Sweep.out, 0)
    fi = 0
    WhileLoop NotEqual(CAD_Topo_Sweep.lp0, 0) {
        CAD_Topo_Sweep.lp1 = CAD_Store.Read(CAD_Topo_Sweep.lp0, 1)
        nce = 0
        ni = 0
        IfCondition NotEqual(CAD_Topo_Sweep.lp1, 0) ThenBlock: {
            nce = CAD_Topo.LoopCountCoedges(CAD_Topo_Sweep.lp1)
            CAD_Topo_Sweep.lph = CAD_Store.Read(CAD_Topo_Sweep.lp1, 2)
            WhileLoop NotEqual(CAD_Topo_Sweep.lph, 0) {
                ni = Add(ni, 1)
                CAD_Topo_Sweep.lph = CAD_Store.Read(CAD_Topo_Sweep.lph, 2)
                IfCondition GreaterThan(ni, 8) ThenBlock: { CAD_Topo_Sweep.lph = 0 }
            }
        }
        PrintMessage("face ")
        PrintNumber(fi)
        PrintMessage(" nce=")
        PrintNumber(nce)
        PrintMessage(" ninner=")
        PrintNumber(ni)
        PrintMessage("\n")
        CAD_Topo_Sweep.lp0 = CAD_Store.Read(CAD_Topo_Sweep.lp0, 3)
        fi = Add(fi, 1)
        IfCondition GreaterThan(fi, 32) ThenBlock: { CAD_Topo_Sweep.lp0 = 0 }
    }
    mesh = Allocate(32)
    nt = CAD_Tess.MeshSolid(h, 0x3FB999999999999A, mesh)
    PrintMessage("mesh nt=")
    PrintNumber(nt)
    PrintMessage(" nv=")
    PrintNumber(ArrayGet(mesh, 0))
    PrintMessage("\n")
    IfCondition LessThan(nt, 80) ThenBlock: {
        CAD_Sys.Write(1, "FAIL few tris\n", 14)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "DONE\n", 5)
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
