// Sequential FilletEdge on all 4 vertical plane–plane edges (same general API).
// DIM: box 40x30x20 mm; R=4 each vertical corner.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== FilletEdge 4 verticals ===\n", 32)
    CAD_Sys.Write(1, "DIM box 40x30x20 mm  R=4 x4 verts\n", 35)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(16384)

    cur = CAD_Script.CreateBox(0x4044000000000000, 0x403E000000000000, 0x4034000000000000)
    edges = Allocate(1024)
    faces = Allocate(32)
    r = 0x4010000000000000
    nf = 0
    guard = 0
    WhileLoop LessThan(guard, 8) {
        ne = CAD_Topo.SolidCollectEdges(cur, edges, 128)
        found_e = 0
        j = 0
        WhileLoop LessThan(j, ne) {
            ed = ArrayGet(edges, j)
            v0 = CAD_Store.Read(ed, 0)
            v1 = CAD_Store.Read(ed, 1)
            dx = Float_Sub(CAD_Store.Read(v1, 0), CAD_Store.Read(v0, 0))
            dy = Float_Sub(CAD_Store.Read(v1, 1), CAD_Store.Read(v0, 1))
            dz = Float_Sub(CAD_Store.Read(v1, 2), CAD_Store.Read(v0, 2))
            adx = dx
            IfCondition EqualTo(Float_Le(adx, 0), 1) ThenBlock: { adx = Float_Sub(0, adx) }
            ady = dy
            IfCondition EqualTo(Float_Le(ady, 0), 1) ThenBlock: { ady = Float_Sub(0, ady) }
            adz = dz
            IfCondition EqualTo(Float_Le(adz, 0), 1) ThenBlock: { adz = Float_Sub(0, adz) }
            // sharp vertical: XY nearly fixed, tall in Z (~20)
            IfCondition EqualTo(Float_Le(adx, 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(ady, 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(0x4030000000000000, adz), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(ed, faces), 0) ThenBlock: {
                            // both faces must still be planes
                            pl = Allocate(128)
                            ok1 = CAD_Topo.FaceGetPlane(ArrayGet(faces, 0), pl)
                            ok2 = CAD_Topo.FaceGetPlane(ArrayGet(faces, 1), pl)
                            Deallocate(pl, 128)
                            IfCondition EqualTo(ok1, 0) ThenBlock: {
                                IfCondition EqualTo(ok2, 0) ThenBlock: {
                                    found_e = ed
                                }
                            }
                        }
                    }
                }
            }
            IfCondition NotEqual(found_e, 0) ThenBlock: { j = ne }
            j = Add(j, 1)
        }
        IfCondition EqualTo(found_e, 0) ThenBlock: {
            guard = 8
        }
        IfCondition NotEqual(found_e, 0) ThenBlock: {
            nxt = CAD_Blend.FilletEdge(cur, found_e, r)
            IfCondition EqualTo(nxt, 0) ThenBlock: {
                CAD_Sys.Write(1, "FAIL FilletEdge multi\n", 22)
                SystemCall(60, 1, 0, 0)
            }
            cur = nxt
            nf = Add(nf, 1)
        }
        guard = Add(guard, 1)
    }

    IfCondition LessThan(nf, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected 4 vertical fillets\n", 33)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(cur, "test-stl/cad_fillet_verticals.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL STEP\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote cad_fillet_verticals.stp (4x FilletEdge)\n", 47)
    CAD_Sys.Write(1, "FILLET VERTICALS OK\n", 20)
    Deallocate(edges, 1024)
    Deallocate(faces, 32)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
