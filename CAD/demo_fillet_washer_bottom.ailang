// Washer r=100/50 H=20: fillet BOTTOM inner CIRCLE then BOTTOM outer.
// Same R=8 as top demos. Compiler must use N_host=−Z, not a BottomRim recipe.
// Gate: 1 torus, mesh stays in [0,H] (convex ID/OD), no skirt below 0.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Blend

Function.Demo.WasherSolid {
    Output: Integer
    Body: {
        n100 = 0x4059000000000000
        n50 = 0x4049000000000000
        n20 = 0x4034000000000000
        two_pi = 0x401921FB54442D18
        CAD_Topo.SweepReset()
        CAD_Topo_Sweep.hz = n20
        CAD_Topo.SweepBeginWire()
        CAD_Topo.SweepAddArc(0, 0, n100, 0, two_pi)
        CAD_Topo.SweepBeginWire()
        CAD_Topo.SweepAddArc(0, 0, n50, 0, two_pi)
        h = CAD_Topo.ExtrudeContours()
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.RebuildKind0Planes(h)
        ReturnValue(h)
    }
}

Function.Demo.PickZCirc {
    Input: solid_handle: Integer
    Input: want_inner: Integer
    Input: z_r: Integer
    Output: Integer
    Body: {
        eds = Allocate(4096)
        ne = CAD_Topo.SolidCollectEdges(solid_handle, eds, 256)
        eh = 0
        i = 0
        WhileLoop LessThan(i, ne) {
            e = ArrayGet(eds, i)
            IfCondition NotEqual(e, 0) ThenBlock: {
                inn = CAD_Topo.EdgeIsInnerLoop(e)
                IfCondition EqualTo(inn, want_inner) ThenBlock: {
                    cr = CAD_Store.Read(e, 2)
                    IfCondition NotEqual(cr, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Store.Read(cr, 0), 2) ThenBlock: {
                            v0 = CAD_Store.Read(e, 0)
                            IfCondition NotEqual(v0, 0) ThenBlock: {
                                IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v0, 2), z_r, 0), 1) ThenBlock: {
                                    IfCondition EqualTo(eh, 0) ThenBlock: { eh = e }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        Deallocate(eds, 4096)
        ReturnValue(eh)
    }
}

Function.Demo.PickBottomCirc {
    Input: solid_handle: Integer
    Input: want_inner: Integer
    Output: Integer
    Body: {
        ReturnValue(Demo.PickZCirc(solid_handle, want_inner, 0))
    }
}

Function.Demo.CheckMeshBand {
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        n_tor = 0
        sh = CAD_Store.Read(solid_handle, 0)
        WhileLoop NotEqual(sh, 0) {
            fc = CAD_Store.Read(sh, 0)
            WhileLoop NotEqual(fc, 0) {
                surf = CAD_Store.Read(fc, 0)
                IfCondition NotEqual(surf, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(surf, 0), 4) ThenBlock: { n_tor = Add(n_tor, 1) }
                }
                fc = CAD_Store.Read(fc, 3)
            }
            sh = CAD_Store.Read(sh, 2)
        }
        PrintMessage("tor=")
        PrintNumber(n_tor)
        PrintMessage("\n")
        IfCondition NotEqual(n_tor, 1) ThenBlock: { ReturnValue(0) }
        mesh = Allocate(48)
        nt = CAD_Tess.MeshSolid(solid_handle, 0, mesh)
        vp = ArrayGet(mesh, 2)
        zlo = ArrayGet(vp, 2)
        zhi = zlo
        ti = 0
        WhileLoop LessThan(ti, ArrayGet(mesh, 0)) {
            zz = ArrayGet(vp, Add(Multiply(ti, 3), 2))
            IfCondition EqualTo(Float_Le(zz, zlo), 1) ThenBlock: { zlo = zz }
            IfCondition EqualTo(Float_Le(zhi, zz), 1) ThenBlock: { zhi = zz }
            ti = Add(ti, 1)
        }
        PrintMessage("mesh zlo=")
        PrintNumber(Float_ToInt(zlo))
        PrintMessage(" zhi=")
        PrintNumber(Float_ToInt(zhi))
        PrintMessage(" nt=")
        PrintNumber(nt)
        PrintMessage("\n")
        Deallocate(mesh, 48)
        // Convex bottom stays in [0,H]. Skirt / wrong cove goes below 0.
        IfCondition EqualTo(CAD_Num.IsNeg(zlo), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(zhi, 0x4035000000000000), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nt, 20) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== washer bottom ID+OD fillet ===\n", 35)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n8 = 0x4020000000000000
    pass = 1
    h = Demo.WasherSolid()
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude ID\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    eh = Demo.PickBottomCirc(h, 1)
    PrintMessage("bot inner circ=")
    PrintNumber(eh)
    PrintMessage("\n")
    IfCondition EqualTo(eh, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no bottom inner CIRCLE\n", 28)
        SystemCall(60, 1, 0, 0)
    }
    fil = CAD_Blend.FilletEdge(h, eh, n8)
    IfCondition EqualTo(fil, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL bottom ID fillet\n", 22)
        pass = 0
    }
    IfCondition NotEqual(fil, 0) ThenBlock: {
        IfCondition NotEqual(CAD_Topo.FilletIRGet(0, 21), 1) ThenBlock: {
            CAD_Sys.Write(1, "FAIL bottom ID mode\n", 20)
            pass = 0
        }
        IfCondition EqualTo(Demo.CheckMeshBand(fil), 0) ThenBlock: {
            CAD_Sys.Write(1, "FAIL bottom ID band\n", 20)
            pass = 0
        }
    }
    h2 = Demo.WasherSolid()
    IfCondition EqualTo(h2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude OD\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    eh2 = Demo.PickBottomCirc(h2, 0)
    PrintMessage("bot outer circ=")
    PrintNumber(eh2)
    PrintMessage("\n")
    IfCondition EqualTo(eh2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no bottom outer CIRCLE\n", 28)
        SystemCall(60, 1, 0, 0)
    }
    fil2 = CAD_Blend.FilletEdge(h2, eh2, n8)
    IfCondition EqualTo(fil2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL bottom OD fillet\n", 22)
        pass = 0
    }
    IfCondition NotEqual(fil2, 0) ThenBlock: {
        IfCondition NotEqual(CAD_Topo.FilletIRGet(0, 21), 2) ThenBlock: {
            CAD_Sys.Write(1, "FAIL bottom OD mode\n", 20)
            pass = 0
        }
        IfCondition EqualTo(Demo.CheckMeshBand(fil2), 0) ThenBlock: {
            CAD_Sys.Write(1, "FAIL bottom OD band\n", 20)
            pass = 0
        }
    }
    // gtk order: inner top, inner bot, outer top, then outer bot.
    // Top OD shortens the wall; bottom OD must stay convex OD, not a cove.
    IfCondition EqualTo(pass, 1) ThenBlock: {
        n20 = 0x4034000000000000
        h4 = Demo.WasherSolid()
        eh = Demo.PickZCirc(h4, 1, n20)
        h4 = CAD_Blend.FilletEdge(h4, eh, n8)
        IfCondition EqualTo(h4, 0) ThenBlock: { pass = 0 }
        IfCondition NotEqual(h4, 0) ThenBlock: {
            eh = Demo.PickZCirc(h4, 1, 0)
            h4 = CAD_Blend.FilletEdge(h4, eh, n8)
        }
        IfCondition EqualTo(h4, 0) ThenBlock: { pass = 0 }
        IfCondition NotEqual(h4, 0) ThenBlock: {
            eh = Demo.PickZCirc(h4, 0, n20)
            h4 = CAD_Blend.FilletEdge(h4, eh, n8)
        }
        IfCondition EqualTo(h4, 0) ThenBlock: { pass = 0 }
        IfCondition NotEqual(h4, 0) ThenBlock: {
            eh = Demo.PickZCirc(h4, 0, 0)
            IfCondition EqualTo(eh, 0) ThenBlock: { pass = 0 }
            h4 = CAD_Blend.FilletEdge(h4, eh, n8)
        }
        IfCondition EqualTo(h4, 0) ThenBlock: {
            CAD_Sys.Write(1, "FAIL 4-rim fillet\n", 18)
            pass = 0
        }
        IfCondition NotEqual(h4, 0) ThenBlock: {
            PrintMessage("4-rim last mode=")
            PrintNumber(CAD_Topo.FilletIRGet(0, 21))
            PrintMessage("\n")
            IfCondition NotEqual(CAD_Topo.FilletIRGet(0, 21), 2) ThenBlock: {
                CAD_Sys.Write(1, "FAIL 4-rim bottom OD mode\n", 26)
                pass = 0
            }
            mesh = Allocate(48)
            nt = CAD_Tess.MeshSolid(h4, 0, mesh)
            vp = ArrayGet(mesh, 2)
            zlo = ArrayGet(vp, 2)
            zhi = zlo
            ti = 0
            WhileLoop LessThan(ti, ArrayGet(mesh, 0)) {
                zz = ArrayGet(vp, Add(Multiply(ti, 3), 2))
                IfCondition EqualTo(Float_Le(zz, zlo), 1) ThenBlock: { zlo = zz }
                IfCondition EqualTo(Float_Le(zhi, zz), 1) ThenBlock: { zhi = zz }
                ti = Add(ti, 1)
            }
            PrintMessage("4-rim zlo=")
            PrintNumber(Float_ToInt(zlo))
            PrintMessage(" zhi=")
            PrintNumber(Float_ToInt(zhi))
            PrintMessage(" nt=")
            PrintNumber(nt)
            PrintMessage("\n")
            IfCondition EqualTo(CAD_Num.IsNeg(zlo), 1) ThenBlock: { pass = 0 }
            IfCondition EqualTo(Float_Le(zhi, 0x4035000000000000), 0) ThenBlock: { pass = 0 }
            Deallocate(mesh, 48)
        }
    }
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "WASHER BOTTOM FILLET PASS\n", 26)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "WASHER BOTTOM FILLET FAIL\n", 26)
    }
    SystemCall(60, Subtract(1, pass), 0, 0)
}

RunTask(Main)
