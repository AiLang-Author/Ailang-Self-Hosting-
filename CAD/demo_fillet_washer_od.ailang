// Washer outer top CIRCLE fillet (convex OD). Same R as hole ID.
// Must not refuse on SolidHasInnerLoop. Gate: class=6, zmax=H, 1 torus.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Blend

SubRoutine.Main {
    CAD_Sys.Write(1, "=== washer outer OD fillet ===\n", 31)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n100 = 0x4059000000000000
    n50 = 0x4049000000000000
    n20 = 0x4034000000000000
    n8 = 0x4020000000000000
    two_pi = 0x401921FB54442D18
    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = n20
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddArc(0, 0, n100, 0, two_pi)
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddArc(0, 0, n50, 0, two_pi)
    h = CAD_Topo.ExtrudeContours()
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo.RebuildKind0Planes(h)
    eds = Allocate(4096)
    ne = CAD_Topo.SolidCollectEdges(h, eds, 256)
    eh = 0
    i = 0
    WhileLoop LessThan(i, ne) {
        e = ArrayGet(eds, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.EdgeIsInnerLoop(e), 0) ThenBlock: {
                cr = CAD_Store.Read(e, 2)
                IfCondition NotEqual(cr, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(cr, 0), 2) ThenBlock: {
                        v0 = CAD_Store.Read(e, 0)
                        IfCondition NotEqual(v0, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v0, 2), n20, 0), 1) ThenBlock: {
                                IfCondition EqualTo(eh, 0) ThenBlock: { eh = e }
                            }
                        }
                    }
                }
            }
        }
        i = Add(i, 1)
    }
    PrintMessage("top outer circ=")
    PrintNumber(eh)
    PrintMessage("\n")
    IfCondition EqualTo(eh, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no top outer CIRCLE\n", 25)
        SystemCall(60, 1, 0, 0)
    }
    fil = CAD_Blend.FilletEdge(h, eh, n8)
    IfCondition EqualTo(fil, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL fillet\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    PrintMessage("fillet class=")
    PrintNumber(CAD_Topo_State.fillet_class)
    PrintMessage("\n")
    n_tor = 0
    zmax = 0
    sh = CAD_Store.Read(fil, 0)
    WhileLoop NotEqual(sh, 0) {
        fc = CAD_Store.Read(sh, 0)
        WhileLoop NotEqual(fc, 0) {
            surf = CAD_Store.Read(fc, 0)
            IfCondition NotEqual(surf, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(surf, 0), 4) ThenBlock: { n_tor = Add(n_tor, 1) }
            }
            lp = CAD_Store.Read(fc, 1)
            IfCondition NotEqual(lp, 0) ThenBlock: {
                hd = CAD_Store.Read(lp, 0)
                ce = hd
                cg = 0
                WhileLoop NotEqual(ce, 0) {
                    ed = CAD_Store.Read(ce, 0)
                    IfCondition NotEqual(ed, 0) ThenBlock: {
                        v0 = CAD_Store.Read(ed, 0)
                        IfCondition NotEqual(v0, 0) ThenBlock: {
                            zz = CAD_Store.Read(v0, 2)
                            IfCondition EqualTo(Float_Le(zmax, zz), 1) ThenBlock: { zmax = zz }
                        }
                    }
                    ce = CAD_Store.Read(ce, 2)
                    cg = Add(cg, 1)
                    IfCondition EqualTo(ce, hd) ThenBlock: { ce = 0 }
                    IfCondition GreaterThan(cg, 64) ThenBlock: { ce = 0 }
                }
            }
            fc = CAD_Store.Read(fc, 3)
        }
        sh = CAD_Store.Read(sh, 2)
    }
    PrintMessage("tor=")
    PrintNumber(n_tor)
    PrintMessage(" zmax=")
    PrintNumber(Float_ToInt(zmax))
    PrintMessage("\n")
    over = 0
    IfCondition EqualTo(Float_Le(zmax, 0x4035000000000000), 0) ThenBlock: { over = 1 }
    mesh = Allocate(48)
    nt = CAD_Tess.MeshSolid(fil, 0, mesh)
    zlo = ArrayGet(ArrayGet(mesh, 2), 2)
    zhi = zlo
    ti = 0
    WhileLoop LessThan(ti, ArrayGet(mesh, 0)) {
        zz = ArrayGet(ArrayGet(mesh, 2), Add(Multiply(ti, 3), 2))
        IfCondition EqualTo(Float_Le(zz, zlo), 1) ThenBlock: { zlo = zz }
        IfCondition EqualTo(Float_Le(zhi, zz), 1) ThenBlock: { zhi = zz }
        ti = Add(ti, 1)
    }
    PrintMessage("mesh zlo=")
    PrintNumber(Float_ToInt(zlo))
    PrintMessage(" zhi=")
    PrintNumber(Float_ToInt(zhi))
    PrintMessage(" nt=")
    PrintNumber(nt)
    PrintMessage("\n")
    IfCondition EqualTo(Float_Le(zhi, 0x4035000000000000), 0) ThenBlock: { over = 1 }
    // Sheared wall: a LINE generator whose ends have different radii.
    shear = 0
    ne2 = CAD_Topo.SolidCollectEdges(fil, eds, 256)
    ti = 0
    WhileLoop LessThan(ti, ne2) {
        e = ArrayGet(eds, ti)
        IfCondition NotEqual(e, 0) ThenBlock: {
            cr = CAD_Store.Read(e, 2)
            IfCondition NotEqual(cr, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(cr, 0), 1) ThenBlock: {
                    v0 = CAD_Store.Read(e, 0)
                    v1 = CAD_Store.Read(e, 1)
                    IfCondition NotEqual(v0, 0) ThenBlock: {
                        IfCondition NotEqual(v1, 0) ThenBlock: {
                            ra = CAD_Num.Hypot2(CAD_Store.Read(v0, 0), CAD_Store.Read(v0, 1))
                            rb = CAD_Num.Hypot2(CAD_Store.Read(v1, 0), CAD_Store.Read(v1, 1))
                            IfCondition EqualTo(CAD_Num.Le(0x4024000000000000, CAD_Num.Abs(Float_Sub(ra, rb))), 1) ThenBlock: {
                                shear = 1
                            }
                        }
                    }
                }
            }
        }
        ti = Add(ti, 1)
    }
    PrintMessage("shear=")
    PrintNumber(shear)
    PrintMessage("\n")
    Deallocate(mesh, 48)
    Deallocate(eds, 4096)
    pass = 0
    IfCondition EqualTo(n_tor, 1) ThenBlock: {
        IfCondition EqualTo(over, 0) ThenBlock: {
            IfCondition EqualTo(shear, 0) ThenBlock: {
                IfCondition GreaterThan(nt, 20) ThenBlock: { pass = 1 }
            }
        }
    }
    // gtk path: inner first (OK) then outer (was shearing the wall).
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Topo.SweepReset()
        CAD_Topo_Sweep.hz = n20
        CAD_Topo.SweepBeginWire()
        CAD_Topo.SweepAddArc(0, 0, n100, 0, two_pi)
        CAD_Topo.SweepBeginWire()
        CAD_Topo.SweepAddArc(0, 0, n50, 0, two_pi)
        h2 = CAD_Topo.ExtrudeContours()
        CAD_Topo.RebuildKind0Planes(h2)
        eds = Allocate(4096)
        ne = CAD_Topo.SolidCollectEdges(h2, eds, 256)
        ein = 0
        eout = 0
        i = 0
        WhileLoop LessThan(i, ne) {
            e = ArrayGet(eds, i)
            IfCondition NotEqual(e, 0) ThenBlock: {
                cr = CAD_Store.Read(e, 2)
                IfCondition NotEqual(cr, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(cr, 0), 2) ThenBlock: {
                        v0 = CAD_Store.Read(e, 0)
                        IfCondition NotEqual(v0, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v0, 2), n20, 0), 1) ThenBlock: {
                                IfCondition EqualTo(CAD_Topo.EdgeIsInnerLoop(e), 1) ThenBlock: {
                                    IfCondition EqualTo(ein, 0) ThenBlock: { ein = e }
                                }
                                IfCondition EqualTo(CAD_Topo.EdgeIsInnerLoop(e), 0) ThenBlock: {
                                    IfCondition EqualTo(eout, 0) ThenBlock: { eout = e }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        h2 = CAD_Blend.FilletEdge(h2, ein, n8)
        IfCondition EqualTo(h2, 0) ThenBlock: { pass = 0 }
        IfCondition NotEqual(h2, 0) ThenBlock: {
            ne = CAD_Topo.SolidCollectEdges(h2, eds, 256)
            eout = 0
            i = 0
            WhileLoop LessThan(i, ne) {
                e = ArrayGet(eds, i)
                IfCondition NotEqual(e, 0) ThenBlock: {
                    cr = CAD_Store.Read(e, 2)
                    IfCondition NotEqual(cr, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Store.Read(cr, 0), 2) ThenBlock: {
                            IfCondition EqualTo(CAD_Topo.EdgeIsInnerLoop(e), 0) ThenBlock: {
                                v0 = CAD_Store.Read(e, 0)
                                IfCondition NotEqual(v0, 0) ThenBlock: {
                                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v0, 2), n20, 0), 1) ThenBlock: {
                                        IfCondition EqualTo(eout, 0) ThenBlock: { eout = e }
                                    }
                                }
                            }
                        }
                    }
                }
                i = Add(i, 1)
            }
            h2 = CAD_Blend.FilletEdge(h2, eout, n8)
            IfCondition EqualTo(h2, 0) ThenBlock: { pass = 0 }
            IfCondition NotEqual(h2, 0) ThenBlock: {
                mesh = Allocate(48)
                nt = CAD_Tess.MeshSolid(h2, 0, mesh)
                PrintMessage("combo nt=")
                PrintNumber(nt)
                PrintMessage("\n")
                IfCondition LessThan(nt, 20) ThenBlock: { pass = 0 }
                Deallocate(mesh, 48)
            }
        }
        Deallocate(eds, 4096)
    }
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "WASHER OD FILLET PASS\n", 22)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "WASHER OD FILLET FAIL\n", 22)
    }
    SystemCall(60, Subtract(1, pass), 0, 0)
}

RunTask(Main)
