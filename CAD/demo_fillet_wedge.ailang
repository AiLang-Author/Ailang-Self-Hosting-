// Non-ortho digon: equal-R fillet on top cycle of a 31° wedge prism.
// Apex angle 31°, legs 50 mm, height 20 mm, R=3 (inradius ~10.2).
// Expect: 3 CYL + 3 ELLIPSE digons + 5 planes, NO sphere faces.
// Look-at: test-stl/cad_fillet_wedge.stp
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== FilletEdges digon WEDGE 31deg ===\n", 38)
    CAD_Sys.Write(1, "DIM legs=50 H=20 apex=31deg R=3\n", 32)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    // base: (0,0), (50,0), (50*cos31, 50*sin31) ≈ (42.858, 25.752)
    out = Allocate(16)
    body = CAD_Topo.MakeWedgePrism(0x4049000000000000, 0x40456DDEE7CCE77D, 0x4039C07CC38CAC8E, 0x4034000000000000, out)
    Deallocate(out, 16)
    IfCondition EqualTo(body, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL MakeWedgePrism\n", 20)
        SystemCall(60, 1, 0, 0)
    }

    edges = Allocate(1024)
    sel = Allocate(32)
    faces = Allocate(32)
    pl = Allocate(128)
    ne = CAD_Topo.SolidCollectEdges(body, edges, 128)
    nsel = 0
    j = 0
    // top cycle: both endpoints at z = H = 20
    WhileLoop LessThan(j, ne) {
        ed = ArrayGet(edges, j)
        IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(ed, faces), 0) ThenBlock: {
            ok1 = CAD_Topo.FaceGetPlane(ArrayGet(faces, 0), pl)
            ok2 = CAD_Topo.FaceGetPlane(ArrayGet(faces, 1), pl)
            IfCondition EqualTo(ok1, 0) ThenBlock: {
                IfCondition EqualTo(ok2, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(CAD_Store.Read(ed, 0), 2), 0x4034000000000000, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(CAD_Store.Read(ed, 1), 2), 0x4034000000000000, 0), 1) ThenBlock: {
                            ArraySet(sel, nsel, ed)
                            nsel = Add(nsel, 1)
                        }
                    }
                }
            }
        }
        j = Add(j, 1)
    }
    IfCondition NotEqual(nsel, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL need exactly 3 top edges\n", 30)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "top edges nsel=3\n", 17)

    // R = 3
    fil = CAD_Blend.FilletEdges(body, sel, nsel, 0x4008000000000000)
    IfCondition EqualTo(fil, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL FilletEdges digon wedge\n", 29)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(fil, "test-stl/cad_fillet_wedge.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL STEP\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote cad_fillet_wedge.stp\n", 27)
    CAD_Sys.Write(1, "expect: 3 CYL + 3 ELLIPSE digon + 5 planes, 0 sphere\n", 53)
    CAD_Sys.Write(1, "FILLET WEDGE DIGON OK\n", 22)
    Deallocate(edges, 1024)
    Deallocate(sel, 32)
    Deallocate(faces, 32)
    Deallocate(pl, 128)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
