// 100x100 x H=20, fillet 4 top rims R=10. Dump left XZ hull vs circle/chamfer.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "hull start\n", 11)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(131072)
    n0 = 0
    n50 = 0x4049000000000000
    n20 = 0x4034000000000000
    n10 = 0x4024000000000000
    xy = Allocate(64)
    ArraySet(xy, 0, Float_Sub(n0, n50))
    ArraySet(xy, 1, Float_Sub(n0, n50))
    ArraySet(xy, 2, n50)
    ArraySet(xy, 3, Float_Sub(n0, n50))
    ArraySet(xy, 4, n50)
    ArraySet(xy, 5, n50)
    ArraySet(xy, 6, Float_Sub(n0, n50))
    ArraySet(xy, 7, n50)
    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, xy, 4)
    h = CAD_Feat.ExtrudeProfile(hsk, n20)
    edges = Allocate(1024)
    sel = Allocate(64)
    ne = CAD_Topo.SolidCollectEdges(h, edges, 64)
    nsel = 0
    i = 0
    WhileLoop LessThan(i, ne) {
        ed = ArrayGet(edges, i)
        va = CAD_Store.Read(ed, 0)
        vb = CAD_Store.Read(ed, 1)
        IfCondition NotEqual(va, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), n20, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vb, 2), n20, 0), 1) ThenBlock: {
                    IfCondition LessThan(nsel, 4) ThenBlock: {
                        ArraySet(sel, nsel, ed)
                        nsel = Add(nsel, 1)
                    }
                }
            }
        }
        i = Add(i, 1)
    }
    PrintMessage("top_n=")
    PrintNumber(nsel)
    PrintMessage("\n")
    fil = CAD_Blend.FilletEdges(h, sel, 4, n10)
    PrintMessage("fillet=")
    PrintNumber(fil)
    PrintMessage("\n")
    mesh = Allocate(32)
    nt = CAD_Tess.MeshSolid(fil, 0x3FB999999999999A, mesh)
    PrintMessage("nt=")
    PrintNumber(nt)
    PrintMessage(" nv=")
    PrintNumber(ArrayGet(mesh, 0))
    PrintMessage(" nA=")
    PrintNumber(CAD_Tess_State.ruled_na)
    PrintMessage(" sag=")
    PrintNumber(Float_ToInt(Float_Mul(CAD_Tess_State.ruled_sag, 0x408F400000000000)))
    PrintMessage("\n")
    v_base = ArrayGet(mesh, 2)
    nv = ArrayGet(mesh, 0)
    // buckets z=10..20 step 1mm: min x among verts with |z-zb|<0.6
    zb = 10
    WhileLoop LessEqual(zb, 20) {
        zf = Float_FromInt(zb)
        xmin = 0x4059000000000000
        found = 0
        vi = 0
        WhileLoop LessThan(vi, nv) {
            zz = ArrayGet(v_base, Add(Multiply(vi, 3), 2))
            dz = Float_Sub(zz, zf)
            IfCondition EqualTo(CAD_Num.IsNeg(dz), 1) ThenBlock: { dz = Float_Sub(n0, dz) }
            IfCondition EqualTo(Float_Le(dz, 0x3FE3333333333333), 1) ThenBlock: {
                xx = ArrayGet(v_base, Multiply(vi, 3))
                IfCondition EqualTo(found, 0) ThenBlock: {
                    xmin = xx
                    found = 1
                }
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(xx, xmin)), 1) ThenBlock: { xmin = xx }
            }
            vi = Add(vi, 1)
        }
        PrintMessage("z=")
        PrintNumber(zb)
        PrintMessage(" xmin_c=")
        PrintNumber(Float_ToInt(Float_Mul(xmin, 0x4059000000000000)))
        PrintMessage("\n")
        zb = Add(zb, 1)
    }
    CAD_Sys.Write(1, "done\n", 5)
}
