LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num

SubRoutine.Main {
    one = 0x3FF0000000000000
    neg1 = Float_Sub(0, one)
    PrintMessage("neg1 intbits as print=")
    PrintNumber(neg1)
    PrintMessage("\n")
    PrintMessage("IsNeg(neg1)=")
    PrintNumber(CAD_Num.IsNeg(neg1))
    PrintMessage("\n")
    // (-1)*1
    p = Float_Mul(neg1, one)
    PrintMessage("(-1)*1 IsNeg=")
    PrintNumber(CAD_Num.IsNeg(p))
    PrintMessage(" print=")
    PrintNumber(p)
    PrintMessage("\n")
    // 0 - (-1)
    d = Float_Sub(0, neg1)
    PrintMessage("0-(-1) IsNeg=")
    PrintNumber(CAD_Num.IsNeg(d))
    PrintMessage("\n")
    // (-1)-0
    d2 = Float_Sub(neg1, 0)
    PrintMessage("(-1)-0 IsNeg=")
    PrintNumber(CAD_Num.IsNeg(d2))
    PrintMessage("\n")
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
