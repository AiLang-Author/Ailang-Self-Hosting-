// Regression: padfail — 4 circles + bridges must pick OUTER envelope, not
// a 3-vert junction triangle. Extrude of the junk triangle was a thin wedge.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== four-circle outer pad ===\n", 30)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    sk = CAD_Sketch.CreateSketch(1)
    // four overlapping circles (clover) — pure circles, no bridges
    CAD_Sketch.AddCircle(sk, 0, 0, 0x4014000000000000)
    CAD_Sketch.AddCircle(sk, 0x4018000000000000, 0, 0x4014000000000000)
    CAD_Sketch.AddCircle(sk, 0x4008000000000000, 0x4014000000000000, 0x4010000000000000)
    CAD_Sketch.AddCircle(sk, 0x4008000000000000, 0xC014000000000000, 0x4010000000000000)

    CAD_Sketch.TessellateCircles(sk, 48)
    CAD_Store.Write(sk, 7, 0)
    nprof = CAD_Sketch.BuildAllClosedLoops(sk)
    IfCondition LessThan(nprof, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no profiles\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    // inject a synthetic micro triangle face? rely on filter + score
    // also ensure we never select nn<6 when larger exists

    // pick densest / largest-area like CA_RebuildProfiles
    xy = Allocate(65536)
    best_i = 0
    best_sc = 0
    best_nn = 0
    pi = 0
    WhileLoop LessThan(pi, nprof) {
        nn = CAD_Sketch.GetProfileXY(sk, pi, xy)
        IfCondition GreaterEqual(nn, 3) ThenBlock: {
            ar = CAD_Sketch.LoopSignedArea(xy, nn)
            IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
            dens = Float_Add(0x3FF0000000000000, Float_Div(Float_FromInt(nn), Float_FromInt(32)))
            sc = Float_Mul(ar, dens)
            skip = 0
            IfCondition LessThan(nn, 6) ThenBlock: {
                IfCondition GreaterThan(nprof, 1) ThenBlock: { skip = 1 }
            }
            IfCondition EqualTo(skip, 0) ThenBlock: {
                IfCondition EqualTo(Float_Le(best_sc, sc), 1) ThenBlock: {
                    best_sc = sc
                    best_i = pi
                    best_nn = nn
                }
            }
        }
        pi = Add(pi, 1)
    }
    // must not be a micro triangle
    IfCondition LessThan(best_nn, 12) ThenBlock: {
        CAD_Sys.Write(1, "FAIL selected micro face\n", 25)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS outer ring has many verts\n", 31)

    nn = CAD_Sketch.GetProfileXY(sk, best_i, xy)
    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, xy, nn)
    h = CAD_Feat.ExtrudeProfile(hsk, 0x4024000000000000)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS four-circle pad\n", 21)
    Deallocate(xy, 65536)
    CAD_Sys.Write(1, "FOUR CIRCLE PAD OK\n", 19)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
