// Regression: freehand almost-closed ring must yield a profile (noclosedprofile).
// Old PruneOpenStubs deleted any free tip and ate the whole open chain.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== freehand almost-closed profile ===\n", 39)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    // Open square with a small gap at close: (0,0)→(10,0)→(10,10)→(0,10)→(0,0.2)
    // gap 0.2 at left side — visually closed, must profile after BuildAllClosedLoops
    sk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk, 0, 0, 0x4024000000000000, 0)
    CAD_Sketch.AddLine(sk, 0x4024000000000000, 0, 0x4024000000000000, 0x4024000000000000)
    CAD_Sketch.AddLine(sk, 0x4024000000000000, 0x4024000000000000, 0, 0x4024000000000000)
    CAD_Sketch.AddLine(sk, 0, 0x4024000000000000, 0, 0x3FC999999999999A)

    // prune must NOT eat the chain
    CAD_Sketch.PruneOpenStubs(sk, 0)
    nl = CAD_Sketch.GetLineCount(sk)
    IfCondition LessThan(nl, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL prune ate freehand ring\n", 29)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS prune kept almost-closed chain\n", 36)

    // full project path
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk2, 0, 0, 0x4024000000000000, 0)
    CAD_Sketch.AddLine(sk2, 0x4024000000000000, 0, 0x4024000000000000, 0x4024000000000000)
    CAD_Sketch.AddLine(sk2, 0x4024000000000000, 0x4024000000000000, 0, 0x4024000000000000)
    CAD_Sketch.AddLine(sk2, 0, 0x4024000000000000, 0, 0x3FC999999999999A)
    nprof = CAD_Sketch.BuildAllClosedLoops(sk2)
    IfCondition LessThan(nprof, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no profile on almost-closed freehand\n", 42)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS almost-closed freehand profile\n", 36)

    // open polyline (2 segs) — cannot form a triangle face
    sk3 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk3, 0, 0, 0, 0x4024000000000000)
    CAD_Sketch.AddLine(sk3, 0, 0x4024000000000000, 0x4024000000000000, 0x4024000000000000)
    n3 = CAD_Sketch.BuildAllClosedLoops(sk3)
    IfCondition GreaterThan(n3, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL open poly invented face\n", 29)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS open poly still no face\n", 29)

    // overshoot past T still pruned (cross case)
    sk4 = CAD_Sketch.CreateSketch(1)
    // H: (0,0)-(20,0)  V: (10,-5)-(10,5) → after split, vertical tips free at joint val>=2?
    CAD_Sketch.AddLine(sk4, 0, 0, 0x4034000000000000, 0)
    CAD_Sketch.AddLine(sk4, 0x4024000000000000, 0xC014000000000000, 0x4024000000000000, 0x4014000000000000)
    CAD_Sketch.SplitAtIntersections(sk4)
    CAD_Sketch.PruneOpenStubs(sk4, 0)
    // vertical stubs above/below H should die; keep left-right of H + maybe mid
    // at least should not grow; stubs should shrink
    nl4 = CAD_Sketch.GetLineCount(sk4)
    IfCondition GreaterThan(nl4, 4) ThenBlock: {
        CAD_Sys.Write(1, "WARN prune overshoot left more segs than expected\n", 50)
    }
    CAD_Sys.Write(1, "PASS overshoot path still runs\n", 31)

    CAD_Sys.Write(1, "FREEHAND CLOSE OK\n", 18)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
