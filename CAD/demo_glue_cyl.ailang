// Box + analytic cylinder glue: mesh must stay dense (not a 16-gon tube).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Tess

SubRoutine.Main {
    CAD_Sys.Write(1, "glue analytic cyl\n", 18)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n20 = 0x4034000000000000
    n15 = 0x402E000000000000
    n0 = 0
    n10 = 0x4024000000000000
    n8 = 0x4020000000000000
    xy = Allocate(64)
    ArraySet(xy, 0, Float_Sub(n0, n20))
    ArraySet(xy, 1, Float_Sub(n0, n15))
    ArraySet(xy, 2, n20)
    ArraySet(xy, 3, Float_Sub(n0, n15))
    ArraySet(xy, 4, n20)
    ArraySet(xy, 5, n15)
    ArraySet(xy, 6, Float_Sub(n0, n20))
    ArraySet(xy, 7, n15)
    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, xy, 4)
    host = CAD_Feat.ExtrudeProfile(hsk, n20)
    tsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(tsk, n0, n0, n8)
    tool = CAD_Feat.ExtrudeProfile(tsk, n10)
    tk = 0
    IfCondition NotEqual(tool, 0) ThenBlock: { tk = CAD_Store.Read(tool, 3) }
    dlt = Allocate(32)
    ArraySet(dlt, 0, n0)
    ArraySet(dlt, 1, n0)
    ArraySet(dlt, 2, n20)
    CAD_Topo.TranslateSolid(tool, dlt)
    Deallocate(dlt, 32)
    CAD_Topo.RebuildKind0Planes(host)
    PrintMessage("host=")
    PrintNumber(host)
    PrintMessage(" hkind=")
    PrintNumber(CAD_Store.Read(host, 3))
    PrintMessage(" tkind=")
    PrintNumber(CAD_Store.Read(tool, 3))
    PrintMessage(" hsh=")
    PrintNumber(CAD_Store.Read(host, 0))
    PrintMessage(" tsh=")
    PrintNumber(CAD_Store.Read(tool, 0))
    PrintMessage("\n")
    pl = Allocate(128)
    tf0 = CAD_Store.Read(CAD_Store.Read(tool, 0), 0)
    tfi = 0
    WhileLoop NotEqual(tf0, 0) {
        lp = CAD_Store.Read(tf0, 1)
        ov = 0
        IfCondition NotEqual(lp, 0) ThenBlock: {
            ov = CAD_Store.Read(CAD_Store.Read(lp, 0), 5)
        }
        prc = CAD_Topo.FaceGetPlane(tf0, pl)
        PrintMessage(" tface=")
        PrintNumber(tfi)
        PrintMessage(" getpl=")
        PrintNumber(prc)
        PrintMessage(" nz=")
        PrintNumber(Float_ToInt(Float_Mul(ArrayGet(pl, 12), 0x4059000000000000)))
        PrintMessage(" vz=")
        IfCondition NotEqual(ov, 0) ThenBlock: {
            PrintNumber(Float_ToInt(CAD_Store.Read(ov, 2)))
        }
        PrintMessage("\n")
        tf0 = CAD_Store.Read(tf0, 3)
        tfi = Add(tfi, 1)
    }
    hf0 = CAD_Store.Read(CAD_Store.Read(host, 0), 0)
    hfi = 0
    WhileLoop NotEqual(hf0, 0) {
        prc = CAD_Topo.FaceGetPlane(hf0, pl)
        PrintMessage(" hface=")
        PrintNumber(hfi)
        PrintNumber(prc)
        PrintMessage(" nz=")
        PrintNumber(Float_ToInt(Float_Mul(ArrayGet(pl, 12), 0x4059000000000000)))
        PrintMessage(" oz=")
        PrintNumber(Float_ToInt(ArrayGet(pl, 3)))
        PrintMessage("\n")
        hf0 = CAD_Store.Read(hf0, 3)
        hfi = Add(hfi, 1)
    }
    hf1 = CAD_Store.Read(CAD_Store.Read(host, 0), 0)
    hf1 = CAD_Store.Read(hf1, 3)
    ArraySet(pl, 0, 0)
    ArraySet(pl, 1, 0)
    ArraySet(pl, 2, n20)
    pin = CAD_Topo.PointInFaceUV(hf1, pl)
    PrintMessage(" pin_center=")
    PrintNumber(pin)
    PrintMessage("\n")
    Deallocate(pl, 128)
    hf = CAD_Store.Read(CAD_Store.Read(host, 0), 0)
    hfn = 0
    WhileLoop NotEqual(hf, 0) {
        tf = CAD_Store.Read(CAD_Store.Read(tool, 0), 0)
        tfn = 0
        WhileLoop NotEqual(tf, 0) {
            prc = CAD_Bool.FacesGluePair(hf, tf)
            PrintMessage(" pair h=")
            PrintNumber(hfn)
            PrintMessage(" t=")
            PrintNumber(tfn)
            PrintMessage(" rc=")
            PrintNumber(prc)
            IfCondition EqualTo(hfn, 1) ThenBlock: {
                IfCondition EqualTo(tfn, 0) ThenBlock: {
                    PrintMessage(" cerr_i=")
                    PrintNumber(Float_ToInt(CAD_Bool_Glue.cerr))
                    PrintMessage(" ohz_i=")
                    PrintNumber(Float_ToInt(CAD_Bool_Glue.ohz))
                    PrintMessage(" nhz_i=")
                    PrintNumber(Float_ToInt(Float_Mul(CAD_Bool_Glue.nhz, 0x4059000000000000)))
                    PrintMessage("\n")
                }
            }
            PrintMessage("\n")
            tf = CAD_Store.Read(tf, 3)
            tfn = Add(tfn, 1)
        }
        hf = CAD_Store.Read(hf, 3)
        hfn = Add(hfn, 1)
    }
    pair = Allocate(16)
    fg = CAD_Bool.FindGlueFaces(host, tool, pair)
    PrintMessage("findglue=")
    PrintNumber(fg)
    PrintMessage(" fh=")
    PrintNumber(ArrayGet(pair, 0))
    PrintMessage(" ft=")
    PrintNumber(ArrayGet(pair, 1))
    PrintMessage("\n")
    Deallocate(pair, 16)
    glued = CAD_Bool.GlueOnFace(host, tool)
    mesh = Allocate(48)
    nt = 0
    IfCondition NotEqual(glued, 0) ThenBlock: {
        nt = CAD_Tess.MeshSolid(glued, 0, mesh)
    }
    PrintMessage("toolkind=")
    PrintNumber(tk)
    PrintMessage(" glue=")
    PrintNumber(glued)
    PrintMessage(" nt=")
    PrintNumber(nt)
    PrintMessage("\n")
    pass = 0
    IfCondition EqualTo(tk, 1) ThenBlock: {
        IfCondition NotEqual(glued, 0) ThenBlock: {
            IfCondition GreaterEqual(nt, 200) ThenBlock: { pass = 1 }
        }
    }
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "GLUE CYL PASS\n", 14)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "GLUE CYL FAIL\n", 14)
    }
    Deallocate(mesh, 48)
    Deallocate(xy, 64)
    SystemCall(60, Subtract(1, pass), 0, 0)
}
RunTask(Main)
