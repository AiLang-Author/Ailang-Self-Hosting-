// Hex pad (root) → plane on top face → new sketch + rect → pad boss.
// Isolates: n-gon base is not a geometry bomb; face sketch 1 can draw a rect.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_UI
LibraryImport.Cad.CAD_Geom

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== hex pad + face sketch + rect ===\n", 38)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    sk0 = CAD_Sketch.CreateSketch(1)
    CAD_UI_State.nsides = 6
    CAD_UI_State.x0 = Float_FromInt(20)
    CAD_UI_State.y0 = Float_FromInt(20)
    CAD_UI_State.x1 = Float_FromInt(40)
    CAD_UI_State.y1 = Float_FromInt(20)
    IfCondition NotEqual(CAD_UI.AddNGon(sk0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL hex\n", 9)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sketch.BuildClosedLoop(sk0)
    body = CAD_Feat.ExtrudeProfile(sk0, Float_FromInt(10))
    IfCondition EqualTo(body, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL hex pad\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "hex pad ok\n", 11)

    // top face = highest origin Z
    face = 0
    best_z = 0xC1E0000000000000
    plw = Allocate(128)
    shell = CAD_Store.Read(body, 0)
    fh = 0
    IfCondition NotEqual(shell, 0) ThenBlock: { fh = CAD_Store.Read(shell, 0) }
    g = 0
    WhileLoop NotEqual(fh, 0) {
        IfCondition EqualTo(CAD_Topo.FaceGetPlane(fh, plw), 0) ThenBlock: {
            oz = ArrayGet(plw, 3)
            IfCondition EqualTo(Float_Le(best_z, oz), 1) ThenBlock: {
                best_z = oz
                face = fh
            }
        }
        fh = CAD_Store.Read(fh, 3)
        g = Add(g, 1)
        IfCondition GreaterThan(g, 64) ThenBlock: { fh = 0 }
    }
    Deallocate(plw, 128)
    IfCondition EqualTo(face, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no top face\n", 17)
        SystemCall(60, 1, 0, 0)
    }

    p0 = CAD_Plane.CreateWorldXY()
    CAD_Plane.EnsurePid(p0)
    pl = CAD_Plane.CreateFromFace(face, body)
    IfCondition EqualTo(pl, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL face plane\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Plane.SetParent(pl, p0)
    fr = Allocate(128)
    pfr = Allocate(128)
    CAD_Plane.EvalFrame(p0, pfr)
    CAD_Plane.EvalFrame(pl, fr)
    CAD_Plane.ProjectOriginInFrame(pfr, fr)
    CAD_Plane.WriteCacheFromFrame(pl, fr)
    Deallocate(fr, 128)
    Deallocate(pfr, 128)

    sk1 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.SetPlaneId(sk1, pl)
    CAD_Sketch.AddRectangle(sk1, Float_FromInt(5), Float_FromInt(5), Float_FromInt(10), Float_FromInt(8))
    CAD_Sketch.BuildClosedLoop(sk1)
    boss = CAD_Feat.ExtrudeOnPlane(sk1, Float_FromInt(6), pl)
    IfCondition EqualTo(boss, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL face rect pad\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    part = CAD_Topo.CompoundAdd(body, boss)
    IfCondition EqualTo(part, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL compound\n", 14)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "HEX + FACE RECT OK\n", 19)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
