// Dependency grind: place hole off-center via tool Translate + Difference.
// Plate 40x40x10, hole dia 8 at (12, 28) — not plate center.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== offset hole (placement + cut) ===\n", 39)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    dx = 0x4044000000000000
    dy = 0x4044000000000000
    dz = 0x4024000000000000
    body = CAD_Script.CreateBox(dx, dy, dz)

    // dia 8, depth 10, center (12, 28)
    dia = 0x4020000000000000
    depth = 0x4024000000000000
    cx = 0x4028000000000000
    cy = 0x403C000000000000
    pack = Allocate(48)
    tool_out = Allocate(16)
    ArraySet(pack, 0, dia)
    ArraySet(pack, 1, depth)
    ArraySet(pack, 2, cx)
    ArraySet(pack, 3, cy)
    cut = CAD_Feat.CreateHole(body, pack, tool_out)
    IfCondition EqualTo(cut, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL cut\n", 9)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Tess.ExportSTL(cut, "test-stl/cad_plate_hole_offset.stl")
    CAD_IO.ExportSTEP(cut, "test-stl/cad_plate_hole_offset.stp")
    CAD_Sys.Write(1, "wrote cad_plate_hole_offset (hole at 12,28)\n", 44)

    Deallocate(pack, 48)
    Deallocate(tool_out, 16)
    CAD_Sys.Write(1, "OFFSET HOLE OK\n", 15)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
