// Fusion-shaped hole *intent*: body + cut tool (circle extrude).
// Until Bool.Difference is real we export both solids — honest look-at.
// Later: one solid = Difference(box, tool).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== hole intent (body + cut tool) ===\n", 38)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    // Body: 40 x 40 x 10 mm plate
    dx = 0x4044000000000000
    dy = 0x4044000000000000
    dz = 0x4024000000000000
    body = CAD_Script.CreateBox(dx, dy, dz)
    IfCondition EqualTo(body, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL body\n", 10)
        SystemCall(60, 1, 0, 0)
    }

    // Hole tool: dia 10, depth 10 (through) — Fusion: circle on face + cut extrude
    dia = 0x4024000000000000
    depth = 0x4024000000000000
    tool_out = Allocate(16)
    cut = CAD_Feat.CreateHole(body, dia, depth, tool_out)
    tool = ArrayGet(tool_out, 0)
    IfCondition EqualTo(tool, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL hole tool\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "tool cylinder ok (exact B-Rep)\n", 31)

    // Export body + tool separately (cut not claimed until Bool works)
    CAD_Tess.ExportSTL(body, "test-stl/cad_plate_40x40x10.stl")
    CAD_IO.ExportSTEP(body, "test-stl/cad_plate_40x40x10.stp")
    CAD_Tess.ExportSTL(tool, "test-stl/cad_hole_tool_d10.stl")
    CAD_IO.ExportSTEP(tool, "test-stl/cad_hole_tool_d10.stp")
    CAD_Sys.Write(1, "wrote plate + hole_tool stl/stp\n", 32)

    IfCondition EqualTo(cut, 0) ThenBlock: {
        CAD_Sys.Write(1, "NOTE: Difference not real yet — no single cut solid\n", 52)
    }

    Deallocate(tool_out, 16)
    CAD_Sys.Write(1, "HOLE INTENT OK\n", 15)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
