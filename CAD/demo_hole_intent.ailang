// Through-hole STEP via B-Rep walk (no export recipes).
// Blind/multi/counterbore: demo_blind_hole, demo_multi_hole, demo_counterbore.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== through-hole B-Rep STEP ===\n", 32)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    dx = 0x4044000000000000
    dy = 0x4044000000000000
    dz = 0x4024000000000000
    body = CAD_Script.CreateBox(dx, dy, dz)

    pack = Allocate(48)
    tool_out = Allocate(16)
    // through hole dia 8 at (12,28) depth 10
    ArraySet(pack, 0, 0x4020000000000000)
    ArraySet(pack, 1, 0x4024000000000000)
    ArraySet(pack, 2, 0x4028000000000000)
    ArraySet(pack, 3, 0x403C000000000000)
    cut = CAD_Feat.CreateHole(body, pack, tool_out)
    IfCondition EqualTo(cut, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL through cut\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Store.Read(cut, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no shell on hole solid\n", 28)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(cut, "test-stl/cad_plate_hole_offset.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL STEP walk\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote offset through-hole.stp (B-Rep walk)\n", 43)

    Deallocate(pack, 48)
    Deallocate(tool_out, 16)
    CAD_Sys.Write(1, "HOLE BREP OK\n", 13)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
