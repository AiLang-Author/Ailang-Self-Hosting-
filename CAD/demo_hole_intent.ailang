// Dependency grind: offset through-hole + partial-depth blind pocket.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== offset + blind hole ===\n", 29)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    dx = 0x4044000000000000
    dy = 0x4044000000000000
    dz = 0x4024000000000000
    body = CAD_Script.CreateBox(dx, dy, dz)

    // through hole dia 8 at (12,28) depth 10
    pack = Allocate(48)
    tool_out = Allocate(16)
    ArraySet(pack, 0, 0x4020000000000000)
    ArraySet(pack, 1, 0x4024000000000000)
    ArraySet(pack, 2, 0x4028000000000000)
    ArraySet(pack, 3, 0x403C000000000000)
    cut = CAD_Feat.CreateHole(body, pack, tool_out)
    IfCondition EqualTo(cut, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL through cut\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Tess.ExportSTL(cut, "test-stl/cad_plate_hole_offset.stl")
    CAD_IO.ExportSTEP(cut, "test-stl/cad_plate_hole_offset.stp")
    CAD_Sys.Write(1, "wrote offset through-hole\n", 26)

    // blind pocket: dia 6 depth 4 at (28,12) — does not go through 10mm plate
    body2 = CAD_Script.CreateBox(dx, dy, dz)
    ArraySet(pack, 0, 0x4018000000000000)
    ArraySet(pack, 1, 0x4010000000000000)
    ArraySet(pack, 2, 0x403C000000000000)
    ArraySet(pack, 3, 0x4028000000000000)
    cut2 = CAD_Feat.CreateHole(body2, pack, tool_out)
    IfCondition EqualTo(cut2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL blind cut\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Tess.ExportSTL(cut2, "test-stl/cad_plate_blind_pocket.stl")
    CAD_IO.ExportSTEP(cut2, "test-stl/cad_plate_blind_pocket.stp")
    CAD_Sys.Write(1, "wrote blind pocket depth 4\n", 27)

    Deallocate(pack, 48)
    Deallocate(tool_out, 16)
    CAD_Sys.Write(1, "HOLE DEPS OK\n", 13)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
