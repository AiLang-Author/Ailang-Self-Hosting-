// Fusion hole path: plate − tool cylinder → ONE solid with through hole.
// Restricted Bool.Difference (box kind0 − cyl kind1) → kind3 mesh (visible hole).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== plate with hole (restricted cut) ===\n", 41)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    // Body: 40 x 40 x 10 mm plate
    dx = 0x4044000000000000
    dy = 0x4044000000000000
    dz = 0x4024000000000000
    body = CAD_Script.CreateBox(dx, dy, dz)
    IfCondition EqualTo(body, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL body\n", 10)
        SystemCall(60, 1, 0, 0)
    }

    // Hole dia 10 through depth 10 — circle cut tool
    dia = 0x4024000000000000
    depth = 0x4024000000000000
    tool_out = Allocate(16)
    cut = CAD_Feat.CreateHole(body, dia, depth, tool_out)
    tool = ArrayGet(tool_out, 0)

    IfCondition EqualTo(tool, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL tool\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    // still export tool for reference
    CAD_Tess.ExportSTL(tool, "test-stl/cad_hole_tool_d10.stl")
    CAD_IO.ExportSTEP(tool, "test-stl/cad_hole_tool_d10.stp")

    IfCondition EqualTo(cut, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL cut solid (Difference)\n", 28)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Store.Read(cut, 3), 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL cut kind!=3\n", 17)
        SystemCall(60, 1, 0, 0)
    }

    CAD_Tess.ExportSTL(cut, "test-stl/cad_plate_with_hole.stl")
    CAD_IO.ExportSTEP(cut, "test-stl/cad_plate_with_hole.stp")
    CAD_Sys.Write(1, "wrote cad_plate_with_hole stl+stp (hole in both)\n", 49)

    mesh = Allocate(48)
    ntri = CAD_Tess.MeshSolid(cut, 0, mesh)
    IfCondition GreaterThan(ntri, 50) ThenBlock: {
        CAD_Sys.Write(1, "mesh tris ok\n", 13)
    }

    Deallocate(tool_out, 16)
    Deallocate(mesh, 48)
    CAD_Sys.Write(1, "HOLE CUT OK\n", 12)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
