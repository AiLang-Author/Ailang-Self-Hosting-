LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== isect line circ ===\n", 24)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)
    CAD_Sketch_Join.cx = 0x4069000000000000
    CAD_Sketch_Join.cy = 0x4069000000000000
    CAD_Sketch_Join.r = 0x4049000000000000
    CAD_Sketch_Join.x0 = 0x4064000000000000
    CAD_Sketch_Join.y0 = 0x4000000000000000
    CAD_Sketch_Join.x1 = 0x4068C00000000000
    CAD_Sketch_Join.y1 = 0x406CC00000000000
    n = CAD_Sketch.IsectLineCirc()
    CAD_Sys.Write(1, "nh=", 3)
    PrintNumber(n)
    CAD_Sys.Write(1, " t0milli=", 9)
    PrintNumber(Float_ToInt(Float_Mul(CAD_Sketch_Join.t0, 0x408F400000000000)))
    CAD_Sys.Write(1, " t1milli=", 9)
    PrintNumber(Float_ToInt(Float_Mul(CAD_Sketch_Join.t1, 0x408F400000000000)))
    CAD_Sys.Write(1, " disc=", 6)
    PrintNumber(Float_ToInt(CAD_Sketch_Join.disc))
    CAD_Sys.Write(1, "\n", 1)
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
