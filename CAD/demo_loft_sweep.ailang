// Deeper Part Design: loft, sweep, linear pattern of non-box solid

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== Loft / Sweep / non-box pattern ===\n", 40)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    // --- Loft: square bottom → larger square top (frustum-like) ---
    sk_bot = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddRectangle(sk_bot, Float_FromInt(-5), Float_FromInt(-5), Float_FromInt(10), Float_FromInt(10))
    sk_top = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddRectangle(sk_top, Float_FromInt(-10), Float_FromInt(-10), Float_FromInt(20), Float_FromInt(20))
    zpack = Allocate(32)
    ArraySet(zpack, 0, 0)
    ArraySet(zpack, 1, Float_FromInt(25))
    loft = CAD_Feat.LoftProfiles(sk_bot, sk_top, zpack)
    Deallocate(zpack, 32)
    IfCondition EqualTo(loft, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL loft\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(loft, "test-stl/cad_loft.stp")
    CAD_View.SetWire(0)
    CAD_View.SetViewMode(0)
    CAD_View.RenderSolidToBMP(loft, 450, 350, "test-stl/cad_view_loft.bmp")
    CAD_Sys.Write(1, "loft ok\n", 8)

    // --- Sweep: rect profile along path rising in Z ---
    sk_sw = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddRectangle(sk_sw, Float_FromInt(-3), Float_FromInt(-2), Float_FromInt(6), Float_FromInt(4))
    path = Allocate(64)
    ArraySet(path, 0, 0)
    ArraySet(path, 1, 0)
    ArraySet(path, 2, 0)
    ArraySet(path, 3, Float_FromInt(8))
    ArraySet(path, 4, Float_FromInt(5))
    ArraySet(path, 5, Float_FromInt(20))
    sw = CAD_Feat.SweepProfile(sk_sw, path, 2)
    Deallocate(path, 64)
    IfCondition EqualTo(sw, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL sweep\n", 11)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(sw, "test-stl/cad_sweep.stp")
    CAD_View.RenderSolidToBMP(sw, 450, 350, "test-stl/cad_view_sweep.bmp")
    CAD_Sys.Write(1, "sweep ok\n", 9)

    // --- Linear pattern of diamond (non-box poly prism) ---
    sk_d = CAD_Sketch.CreateSketch(1)
    // diamond: (0,5)(5,0)(0,-5)(-5,0)
    CAD_Sketch.AddLine(sk_d, 0, Float_FromInt(5), Float_FromInt(5), 0)
    CAD_Sketch.AddLine(sk_d, Float_FromInt(5), 0, 0, Float_FromInt(-5))
    CAD_Sketch.AddLine(sk_d, 0, Float_FromInt(-5), Float_FromInt(-5), 0)
    CAD_Sketch.AddLine(sk_d, Float_FromInt(-5), 0, 0, Float_FromInt(5))
    CAD_Sketch.BuildClosedLoop(sk_d)
    diam = CAD_Feat.ExtrudeProfile(sk_d, Float_FromInt(8))
    IfCondition EqualTo(diam, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL diamond extrude\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    pat = CAD_Feat.LinearPattern(diam, Float_FromInt(14), 0, 0, 4)
    IfCondition EqualTo(pat, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL diamond pattern\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(pat, "test-stl/cad_pattern_diamond.stp")
    CAD_View.RenderSolidToBMP(pat, 500, 300, "test-stl/cad_view_pattern_diamond.bmp")
    CAD_Sys.Write(1, "diamond pattern ok\n", 19)

    // --- Circular pattern of diamond ---
    sk_d2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk_d2, 0, Float_FromInt(4), Float_FromInt(4), 0)
    CAD_Sketch.AddLine(sk_d2, Float_FromInt(4), 0, 0, Float_FromInt(-4))
    CAD_Sketch.AddLine(sk_d2, 0, Float_FromInt(-4), Float_FromInt(-4), 0)
    CAD_Sketch.AddLine(sk_d2, Float_FromInt(-4), 0, 0, Float_FromInt(4))
    CAD_Sketch.BuildClosedLoop(sk_d2)
    d2 = CAD_Feat.ExtrudeProfile(sk_d2, Float_FromInt(6))
    dlt = Allocate(32)
    ArraySet(dlt, 0, Float_FromInt(18))
    ArraySet(dlt, 1, 0)
    ArraySet(dlt, 2, 0)
    CAD_Topo.TranslateSolid(d2, dlt)
    Deallocate(dlt, 32)
    cpat = CAD_Feat.CircularPattern(d2, 5)
    IfCondition EqualTo(cpat, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circular diamond\n", 22)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(cpat, "test-stl/cad_pattern_diamond_circ.stp")
    CAD_View.SetViewMode(1)
    CAD_View.RenderSolidToBMP(cpat, 450, 450, "test-stl/cad_view_pattern_diamond_circ.bmp")
    CAD_Sys.Write(1, "circular diamond ok\n", 20)

    CAD_Sys.Write(1, "LOFT SWEEP PATTERN OK\n", 22)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
