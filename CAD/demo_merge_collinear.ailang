// Two collinear segments that share an end must become one line.
// An L corner must stay two lines.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== merge collinear ===\n", 24)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)
    n0 = 0
    n10 = 0x4024000000000000
    n25 = 0x4039000000000000
    sk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk, n0, n0, n10, n0)
    CAD_Sketch.AddLine(sk, n10, n0, n25, n0)
    CAD_Sketch.AddLine(sk, n0, n0, n0, n10)
    nl0 = CAD_Sketch.GetLineCount(sk)
    nm = CAD_Sketch.MergeCollinearLines(sk)
    nl1 = CAD_Sketch.GetLineCount(sk)
    PrintMessage("nl0=")
    PrintNumber(nl0)
    PrintMessage(" merged=")
    PrintNumber(nm)
    PrintMessage(" nl1=")
    PrintNumber(nl1)
    PrintMessage("\n")
    IfCondition NotEqual(nl0, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL start count\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(nl1, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected 2 lines\n", 22)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS merge collinear\n", 21)
    SystemCall(60, 0, 0, 0)
}
