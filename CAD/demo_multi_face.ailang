// Geometry like profilefail1: V + top Arc3 + mid Arc3 + circle on left leg.
// Expect: multiple closed faces including FULL outer (tip→legs→top, with notch).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    PrintMessage("=== multi-face scoop+band+circle ===\n")
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    sk = CAD_Sketch.CreateSketch(1)
    // V: (-12,22)-(0,-5)-(12,22)
    CAD_Sketch.AddLine(sk, 0xC028000000000000, 0x4036000000000000, 0, 0xC014000000000000)
    CAD_Sketch.AddLine(sk, 0x4028000000000000, 0x4036000000000000, 0, 0xC014000000000000)
    // top Arc3: (-12,22) (0,30) (12,22)
    CAD_Sketch.Arc3Pend(0xC028000000000000, 0x4036000000000000, 0, 0x403E000000000000, 0x4028000000000000, 0x4036000000000000)
    CAD_Sketch.Arc3Point(sk)
    // mid Arc3 across V: through points on legs ~ y=12 and mid (0,8) scooping down
    // left on left leg: approx (-6,12), mid (0,6), right (6,12)
    // Better: attach to legs via Arc3 between points on the V
    // P0=(-8,14) on left, P1=(0,8), P2=(8,14) on right
    CAD_Sketch.Arc3Pend(0xC020000000000000, 0x402C000000000000, 0, 0x4020000000000000, 0x4020000000000000, 0x402C000000000000)
    CAD_Sketch.Arc3Point(sk)
    // circle notch on left leg center-ish R=2.5 at (-6,8)
    CAD_Sketch.AddCircle(sk, 0xC018000000000000, 0x4020000000000000, 0x4004000000000000)

    PrintMessage("live na=")
    PrintNumber(CAD_Sketch.GetArcCount(sk))
    PrintMessage(" nc=")
    PrintNumber(CAD_Sketch.GetCircleCount(sk))
    PrintMessage(" nl=")
    PrintNumber(CAD_Sketch.GetLineCount(sk))
    PrintMessage("\n")

    // project like app
    cl = CAD_Sketch.CreateSketch(1)
    nl = CAD_Sketch.GetLineCount(sk)
    lines = CAD_Store.Read(sk, 1)
    i = 0
    WhileLoop LessThan(i, nl) {
        b = Multiply(i, 4)
        CAD_Sketch.AddLine(cl, ArrayGet(lines, b), ArrayGet(lines, Add(b, 1)), ArrayGet(lines, Add(b, 2)), ArrayGet(lines, Add(b, 3)))
        i = Add(i, 1)
    }
    na = CAD_Sketch.GetArcCount(sk)
    arcs = CAD_Store.Read(sk, 11)
    i = 0
    WhileLoop LessThan(i, na) {
        b = Multiply(i, 5)
        CAD_Sketch.AddArc(cl, ArrayGet(arcs, b), ArrayGet(arcs, Add(b, 1)), ArrayGet(arcs, Add(b, 2)), ArrayGet(arcs, Add(b, 3)), ArrayGet(arcs, Add(b, 4)))
        i = Add(i, 1)
    }
    nc = CAD_Sketch.GetCircleCount(sk)
    circs = CAD_Store.Read(sk, 8)
    i = 0
    WhileLoop LessThan(i, nc) {
        b = Multiply(i, 3)
        CAD_Sketch.AddCircle(cl, ArrayGet(circs, b), ArrayGet(circs, Add(b, 1)), ArrayGet(circs, Add(b, 2)))
        i = Add(i, 1)
    }
    CAD_Sketch.SnapArcEndsToSketch(cl, 0)
    CAD_Sketch.TessellateArcs(cl, 96)
    CAD_Sketch.TessellateCircles(cl, 48)
    CAD_Store.Write(cl, 7, 0)
    CAD_Sketch.SnapNearEndpoints(cl, 0)
    n = CAD_Sketch.BuildAllClosedLoops(cl)
    PrintMessage("nprof=")
    PrintNumber(n)
    PrintMessage(" nl=")
    PrintNumber(CAD_Store.Read(cl, 0))
    PrintMessage("\n")

    xy = Allocate(65536)
    best_a = 0
    best_i = 0
    has_tip = 0
    pi = 0
    WhileLoop LessThan(pi, n) {
        nn = CAD_Sketch.GetProfileXY(cl, pi, xy)
        ar = CAD_Sketch.LoopSignedArea(xy, nn)
        IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
        // bbox
        xmin = ArrayGet(xy, 0)
        ymin = ArrayGet(xy, 1)
        xmax = xmin
        ymax = ymin
        k = 0
        WhileLoop LessThan(k, nn) {
            x = ArrayGet(xy, Multiply(k, 2))
            y = ArrayGet(xy, Add(Multiply(k, 2), 1))
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            k = Add(k, 1)
        }
        PrintMessage("face ")
        PrintNumber(pi)
        PrintMessage(" nn=")
        PrintNumber(nn)
        PrintMessage(" area=")
        PrintNumber(Float_ToInt(ar))
        PrintMessage(" y=")
        PrintNumber(Float_ToInt(ymin))
        PrintMessage("..")
        PrintNumber(Float_ToInt(ymax))
        PrintMessage("\n")
        // tip at (0,-5) in face? ymin near -5
        IfCondition EqualTo(Float_Le(ymin, 0xC000000000000000), 1) ThenBlock: {
            has_tip = 1
        }
        IfCondition EqualTo(Float_Le(best_a, ar), 1) ThenBlock: {
            best_a = ar
            best_i = pi
        }
        pi = Add(pi, 1)
    }

    // Must find a face that reaches the V tip (full outer), not only the upper band
    IfCondition EqualTo(has_tip, 0) ThenBlock: {
        PrintMessage("FAIL no profile reaches V tip (upper band only)\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition LessThan(n, 2) ThenBlock: {
        PrintMessage("FAIL expected multi face (band + outer)\n")
        SystemCall(60, 1, 0, 0)
    }
    PrintMessage("PASS multi-face incl tip-reaching outer\n")
    Deallocate(xy, 65536)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
