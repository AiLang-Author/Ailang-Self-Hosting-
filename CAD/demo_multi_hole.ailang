// Multi-hole plate: two independent CreateHole cuts → kind-3 shell → STEP walk.
// No STEP recipes — topology from BuildPlateHoleShell.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== multi-hole B-Rep STEP ===\n", 30)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    // plate 50 x 40 x 8
    dx = 0x4049000000000000
    dy = 0x4044000000000000
    dz = 0x4020000000000000
    body = CAD_Script.CreateBox(dx, dy, dz)
    pack = Allocate(48)
    tool_out = Allocate(16)
    // through hole dia 8 depth 8 at (15, 20)
    ArraySet(pack, 0, 0x4020000000000000)
    ArraySet(pack, 1, 0x4020000000000000)
    ArraySet(pack, 2, 0x402E000000000000)
    ArraySet(pack, 3, 0x4034000000000000)
    cut = CAD_Feat.CreateHole(body, pack, tool_out)
    // blind hole dia 6 depth 4 at (35, 15)
    ArraySet(pack, 0, 0x4018000000000000)
    ArraySet(pack, 1, 0x4010000000000000)
    ArraySet(pack, 2, 0x4041800000000000)
    ArraySet(pack, 3, 0x402E000000000000)
    cut2 = CAD_Feat.CreateHole(cut, pack, tool_out)
    IfCondition EqualTo(cut2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL multi cut\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Store.Read(cut2, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL multi no shell\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(cut2, "test-stl/cad_plate_multi_hole.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL multi STEP\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote multi-hole.stp (B-Rep walk)\n", 34)
    Deallocate(pack, 48)
    Deallocate(tool_out, 16)
    CAD_Sys.Write(1, "MULTI BREP OK\n", 14)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
