// Multi-hole plate: two successive CreateHole cuts (kind3 + cyl append).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== multi-hole plate ===\n", 25)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    // 50x40x8 plate
    dx = 0x4049000000000000
    dy = 0x4044000000000000
    dz = 0x4020000000000000
    body = CAD_Script.CreateBox(dx, dy, dz)

    pack = Allocate(48)
    tool_out = Allocate(16)

    // hole 1: dia 8 depth 8 (through) at (15,20)
    ArraySet(pack, 0, 0x4020000000000000)
    ArraySet(pack, 1, 0x4020000000000000)
    ArraySet(pack, 2, 0x402E000000000000)
    ArraySet(pack, 3, 0x4034000000000000)
    cut = CAD_Feat.CreateHole(body, pack, tool_out)
    IfCondition EqualTo(cut, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL hole1\n", 11)
        SystemCall(60, 1, 0, 0)
    }

    // hole 2: dia 6 depth 4 (blind) at (35,15)
    ArraySet(pack, 0, 0x4018000000000000)
    ArraySet(pack, 1, 0x4010000000000000)
    ArraySet(pack, 2, 0x4041800000000000)
    ArraySet(pack, 3, 0x402E000000000000)
    cut2 = CAD_Feat.CreateHole(cut, pack, tool_out)
    IfCondition EqualTo(cut2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL hole2\n", 11)
        SystemCall(60, 1, 0, 0)
    }

    ph = CAD_Store.Read(cut2, 1)
    nh = CAD_Store.Read(ph, 9)
    IfCondition NotEqual(nh, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL n_holes!=2\n", 16)
        SystemCall(60, 1, 0, 0)
    }

    CAD_Tess.ExportSTL(cut2, "test-stl/cad_plate_multi_hole.stl")
    CAD_IO.ExportSTEP(cut2, "test-stl/cad_plate_multi_hole.stp")
    CAD_Sys.Write(1, "wrote multi-hole (1 through + 1 blind)\n", 39)

    Deallocate(pack, 48)
    Deallocate(tool_out, 16)
    CAD_Sys.Write(1, "MULTI HOLE OK\n", 14)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
