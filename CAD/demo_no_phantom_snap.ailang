// Regression: geometeryfail — open freehand must NOT invent a long phantom edge
// by snapping distant dangling ends (then Profiles fills a red chord face).
// SnapNearEndpoints is capped by segment length; long welds must not occur.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== no phantom long snap ===\n", 30)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    // Two short segments far apart vertically (like left column of geometery.png)
    // Top stub (0,20)-(0,22)  bottom stub (0,0)-(0,2)  gap ~18
    sk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk, 0, 0x4034000000000000, 0, 0x4036000000000000)
    CAD_Sketch.AddLine(sk, 0, 0, 0, 0x4000000000000000)
    // also a horizontal far right so diagonal of AABB is large (old bug used 1% diag)
    CAD_Sketch.AddLine(sk, 0x4059000000000000, 0, 0x4069000000000000, 0)

    nl0 = CAD_Sketch.GetLineCount(sk)
    nsnap = CAD_Sketch.SnapNearEndpoints(sk, 0)
    // must NOT weld the two vertical stubs across gap ~18
    lines = CAD_Store.Read(sk, 1)
    // first line still ends near y=20 and y=22
    y0 = ArrayGet(lines, 1)
    y1 = ArrayGet(lines, 3)
    // second line near 0 and 2
    y2 = ArrayGet(lines, 5)
    y3 = ArrayGet(lines, 7)
    // check no endpoint of line0 equals endpoint of line1 (weld would force meet)
    welded = 0
    // line0 ends vs line1 ends
    i = 0
    WhileLoop LessThan(i, 2) {
        IfCondition EqualTo(i, 0) ThenBlock: {
            ax = ArrayGet(lines, 0)
            ay = ArrayGet(lines, 1)
        }
        IfCondition EqualTo(i, 1) ThenBlock: {
            ax = ArrayGet(lines, 2)
            ay = ArrayGet(lines, 3)
        }
        j = 0
        WhileLoop LessThan(j, 2) {
            IfCondition EqualTo(j, 0) ThenBlock: {
                bx = ArrayGet(lines, 4)
                by = ArrayGet(lines, 5)
            }
            IfCondition EqualTo(j, 1) ThenBlock: {
                bx = ArrayGet(lines, 6)
                by = ArrayGet(lines, 7)
            }
            ddx = Float_Sub(ax, bx)
            ddy = Float_Sub(ay, by)
            d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
            // if distance < 1.0 they welded (gap was 18)
            IfCondition EqualTo(Float_Le(d2, 0x3FF0000000000000), 1) ThenBlock: {
                welded = 1
            }
            j = Add(j, 1)
        }
        i = Add(i, 1)
    }
    IfCondition EqualTo(welded, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL distant stubs welded\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS no long freehand weld\n", 27)

    // Near-miss freehand SHOULD still snap (gap 0.01 on short segs)
    sk2 = CAD_Sketch.CreateSketch(1)
    // (0,0)-(1,0) and (1.01,0)-(2,0)
    CAD_Sketch.AddLine(sk2, 0, 0, 0x3FF0000000000000, 0)
    CAD_Sketch.AddLine(sk2, 0x3FF028F5C28F5C29, 0, 0x4000000000000000, 0)
    CAD_Sketch.SnapNearEndpoints(sk2, 0)
    lines = CAD_Store.Read(sk2, 1)
    // right end of first and left of second should meet
    x1 = ArrayGet(lines, 2)
    x2 = ArrayGet(lines, 4)
    ddx = Float_Sub(x1, x2)
    IfCondition EqualTo(Float_Le(Float_Mul(ddx, ddx), 0x3F50624DD2F1A9FC), 0) ThenBlock: {
        // not closed enough — may still be ok if both moved to mid
        CAD_Sys.Write(1, "WARN near-miss may not have snapped\n", 36)
    }
    IfCondition EqualTo(Float_Le(Float_Mul(ddx, ddx), 0x3F50624DD2F1A9FC), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS near-miss freehand snap\n", 29)
    }

    // Open C-shape must not invent a full closed profile via phantom chord
    sk3 = CAD_Sketch.CreateSketch(1)
    // three sides of a square, open on bottom: (0,0)-(0,10)-(10,10)-(10,0)
    CAD_Sketch.AddLine(sk3, 0, 0, 0, 0x4024000000000000)
    CAD_Sketch.AddLine(sk3, 0, 0x4024000000000000, 0x4024000000000000, 0x4024000000000000)
    CAD_Sketch.AddLine(sk3, 0x4024000000000000, 0x4024000000000000, 0x4024000000000000, 0)
    nprof = CAD_Sketch.BuildAllClosedLoops(sk3)
    IfCondition GreaterThan(nprof, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL open-C invented closed face\n", 33)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS open-C no phantom face\n", 28)

    CAD_Sys.Write(1, "NO PHANTOM SNAP OK\n", 19)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
