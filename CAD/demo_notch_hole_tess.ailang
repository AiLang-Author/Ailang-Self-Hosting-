// Rect + top semicircle notch + center hole → pad → cap probes.
// broken-solid.png: 2D fill was correct, 3D caps shredded (keyhole bridge).
// Expect: hole center empty, notch empty, plate covered.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== notch+hole tess ===\n", 24)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    outer = Allocate(4096)
    n40 = 0x4044000000000000
    n30 = 0x403E000000000000
    n10 = 0x4024000000000000
    n0 = 0
    ArraySet(outer, 0, Float_Sub(n0, n40))
    ArraySet(outer, 1, Float_Sub(n0, n30))
    nout = 1
    ArraySet(outer, 2, n40)
    ArraySet(outer, 3, Float_Sub(n0, n30))
    nout = 2
    ArraySet(outer, 4, n40)
    ArraySet(outer, 5, n30)
    nout = 3
    ArraySet(outer, 6, n10)
    ArraySet(outer, 7, n30)
    nout = 4
    nseg = 16
    k = 1
    WhileLoop LessThan(k, nseg) {
        num = Float_FromInt(k)
        den = Float_FromInt(nseg)
        th = Float_Mul(Float_Sub(0, 0x400921FB54442D18), Float_Div(num, den))
        ax = Float_Mul(n10, CAD_Geom.Cos(th))
        ay = Float_Add(n30, Float_Mul(n10, CAD_Geom.Sin(th)))
        ArraySet(outer, Multiply(nout, 2), ax)
        ArraySet(outer, Add(Multiply(nout, 2), 1), ay)
        nout = Add(nout, 1)
        k = Add(k, 1)
    }
    ArraySet(outer, Multiply(nout, 2), Float_Sub(n0, n10))
    ArraySet(outer, Add(Multiply(nout, 2), 1), n30)
    nout = Add(nout, 1)
    ArraySet(outer, Multiply(nout, 2), Float_Sub(n0, n40))
    ArraySet(outer, Add(Multiply(nout, 2), 1), n30)
    nout = Add(nout, 1)

    hole = Allocate(4096)
    nh = 32
    two_pi = 0x401921FB54442D18
    i = 0
    WhileLoop LessThan(i, nh) {
        th = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(nh)))
        ArraySet(hole, Multiply(i, 2), Float_Mul(0x4020000000000000, CAD_Geom.Cos(th)))
        ArraySet(hole, Add(Multiply(i, 2), 1), Float_Mul(0x4020000000000000, CAD_Geom.Sin(th)))
        i = Add(i, 1)
    }

    PrintMessage("raw0=")
    PrintNumber(ArrayGet(outer, 0))
    PrintMessage(" raw2=")
    PrintNumber(ArrayGet(outer, 2))
    PrintMessage(" raw0neg=")
    PrintNumber(CAD_Num.IsNeg(ArrayGet(outer, 0)))
    PrintMessage("\n")
    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, outer, nout)
    CAD_Sketch.AddProfileXY(hsk, hole, nh)
    PrintMessage("nprof=")
    PrintNumber(CAD_Store.Read(hsk, 12))
    PrintMessage(" nout=")
    PrintNumber(nout)
    PrintMessage("\n")
    xy0 = Allocate(4096)
    nn0 = CAD_Sketch.GetProfileXY(hsk, 0, xy0)
    PrintMessage("prof0 n=")
    PrintNumber(nn0)
    PrintMessage(" p0neg=")
    PrintNumber(CAD_Num.IsNeg(ArrayGet(xy0, 0)))
    PrintMessage(",")
    PrintNumber(CAD_Num.IsNeg(ArrayGet(xy0, 1)))
    PrintMessage("\n")
    Deallocate(xy0, 4096)

    h = CAD_Feat.ExtrudeProfile(hsk, 0x4034000000000000)
    PrintMessage("solid=")
    PrintNumber(h)
    PrintMessage("\n")
    pass = 0
    h_hole = 0
    h_notch = 0
    h_plate = 0
    h_below = 0
    nt = 0
    IfCondition NotEqual(h, 0) ThenBlock: {
        mesh = Allocate(32)
        nt = CAD_Tess.MeshSolid(h, 0x3FB999999999999A, mesh)
        PrintMessage("mesh nt=")
        PrintNumber(nt)
        PrintMessage(" nv=")
        PrintNumber(ArrayGet(mesh, 0))
        PrintMessage("\n")
        v_base = ArrayGet(mesh, 2)
        i_base = ArrayGet(mesh, 3)
        ztop = 0x4034000000000000
        ztol = 0x3F847AE147AE147B
        pa = Allocate(32)
        pb = Allocate(32)
        pc = Allocate(32)
        pd = Allocate(32)
        t = 0
        WhileLoop LessThan(t, nt) {
            i0 = ArrayGet(i_base, Multiply(t, 3))
            i1 = ArrayGet(i_base, Add(Multiply(t, 3), 1))
            i2 = ArrayGet(i_base, Add(Multiply(t, 3), 2))
            IfCondition EqualTo(t, 0) ThenBlock: {
                PrintMessage("tri0 xy ")
                PrintNumber(Float_ToInt(ArrayGet(v_base, Multiply(i0, 3))))
                PrintMessage(",")
                PrintNumber(Float_ToInt(ArrayGet(v_base, Add(Multiply(i0, 3), 1))))
                PrintMessage(" / ")
                PrintNumber(Float_ToInt(ArrayGet(v_base, Multiply(i1, 3))))
                PrintMessage(",")
                PrintNumber(Float_ToInt(ArrayGet(v_base, Add(Multiply(i1, 3), 1))))
                PrintMessage(" / ")
                PrintNumber(Float_ToInt(ArrayGet(v_base, Multiply(i2, 3))))
                PrintMessage(",")
                PrintNumber(Float_ToInt(ArrayGet(v_base, Add(Multiply(i2, 3), 1))))
                PrintMessage("\n")
            }
            z0 = ArrayGet(v_base, Add(Multiply(i0, 3), 2))
            z1 = ArrayGet(v_base, Add(Multiply(i1, 3), 2))
            z2 = ArrayGet(v_base, Add(Multiply(i2, 3), 2))
            d0 = Float_Sub(z0, ztop)
            IfCondition EqualTo(CAD_Num.IsNeg(d0), 1) ThenBlock: { d0 = Float_Sub(0, d0) }
            d1 = Float_Sub(z1, ztop)
            IfCondition EqualTo(CAD_Num.IsNeg(d1), 1) ThenBlock: { d1 = Float_Sub(0, d1) }
            d2 = Float_Sub(z2, ztop)
            IfCondition EqualTo(CAD_Num.IsNeg(d2), 1) ThenBlock: { d2 = Float_Sub(0, d2) }
            // also count bottom-cap hits at (25,0) using |z|~0
            az0 = z0
            IfCondition EqualTo(CAD_Num.IsNeg(az0), 1) ThenBlock: { az0 = Float_Sub(0, az0) }
            az1 = z1
            IfCondition EqualTo(CAD_Num.IsNeg(az1), 1) ThenBlock: { az1 = Float_Sub(0, az1) }
            az2 = z2
            IfCondition EqualTo(CAD_Num.IsNeg(az2), 1) ThenBlock: { az2 = Float_Sub(0, az2) }
            IfCondition EqualTo(Float_Le(az0, ztol), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(az1, ztol), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(az2, ztol), 1) ThenBlock: {
                        ArraySet(pa, 0, ArrayGet(v_base, Multiply(i0, 3)))
                        ArraySet(pa, 1, ArrayGet(v_base, Add(Multiply(i0, 3), 1)))
                        ArraySet(pb, 0, ArrayGet(v_base, Multiply(i1, 3)))
                        ArraySet(pb, 1, ArrayGet(v_base, Add(Multiply(i1, 3), 1)))
                        ArraySet(pc, 0, ArrayGet(v_base, Multiply(i2, 3)))
                        ArraySet(pc, 1, ArrayGet(v_base, Add(Multiply(i2, 3), 1)))
                        ArraySet(pd, 0, 0x4039000000000000)
                        ArraySet(pd, 1, 0)
                        o1 = CAD_Num.Orient2D(pa, pb, pd)
                        o2 = CAD_Num.Orient2D(pb, pc, pd)
                        o3 = CAD_Num.Orient2D(pc, pa, pd)
                        IfCondition EqualTo(o1, o2) ThenBlock: {
                            IfCondition EqualTo(o2, o3) ThenBlock: {
                                IfCondition NotEqual(o1, 0) ThenBlock: { h_below = Add(h_below, 1) }
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(Float_Le(d0, ztol), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(d1, ztol), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(d2, ztol), 1) ThenBlock: {
                        ArraySet(pa, 0, ArrayGet(v_base, Multiply(i0, 3)))
                        ArraySet(pa, 1, ArrayGet(v_base, Add(Multiply(i0, 3), 1)))
                        ArraySet(pb, 0, ArrayGet(v_base, Multiply(i1, 3)))
                        ArraySet(pb, 1, ArrayGet(v_base, Add(Multiply(i1, 3), 1)))
                        ArraySet(pc, 0, ArrayGet(v_base, Multiply(i2, 3)))
                        ArraySet(pc, 1, ArrayGet(v_base, Add(Multiply(i2, 3), 1)))
                        ArraySet(pd, 0, 0)
                        ArraySet(pd, 1, 0)
                        o1 = CAD_Num.Orient2D(pa, pb, pd)
                        o2 = CAD_Num.Orient2D(pb, pc, pd)
                        o3 = CAD_Num.Orient2D(pc, pa, pd)
                        IfCondition EqualTo(o1, o2) ThenBlock: {
                            IfCondition EqualTo(o2, o3) ThenBlock: {
                                IfCondition NotEqual(o1, 0) ThenBlock: { h_hole = Add(h_hole, 1) }
                            }
                        }
                        ArraySet(pd, 1, 0x4039000000000000)
                        o1 = CAD_Num.Orient2D(pa, pb, pd)
                        o2 = CAD_Num.Orient2D(pb, pc, pd)
                        o3 = CAD_Num.Orient2D(pc, pa, pd)
                        IfCondition EqualTo(o1, o2) ThenBlock: {
                            IfCondition EqualTo(o2, o3) ThenBlock: {
                                IfCondition NotEqual(o1, 0) ThenBlock: { h_notch = Add(h_notch, 1) }
                            }
                        }
                        ArraySet(pd, 0, 0x4039000000000000)
                        ArraySet(pd, 1, 0)
                        o1 = CAD_Num.Orient2D(pa, pb, pd)
                        o2 = CAD_Num.Orient2D(pb, pc, pd)
                        o3 = CAD_Num.Orient2D(pc, pa, pd)
                        hp = 0
                        hn = 0
                        IfCondition EqualTo(o1, 1) ThenBlock: { hp = 1 }
                        IfCondition EqualTo(o2, 1) ThenBlock: { hp = 1 }
                        IfCondition EqualTo(o3, 1) ThenBlock: { hp = 1 }
                        IfCondition EqualTo(o1, Subtract(0, 1)) ThenBlock: { hn = 1 }
                        IfCondition EqualTo(o2, Subtract(0, 1)) ThenBlock: { hn = 1 }
                        IfCondition EqualTo(o3, Subtract(0, 1)) ThenBlock: { hn = 1 }
                        IfCondition EqualTo(hp, 1) ThenBlock: {
                            IfCondition EqualTo(hn, 0) ThenBlock: { h_plate = Add(h_plate, 1) }
                        }
                        IfCondition EqualTo(hp, 0) ThenBlock: {
                            IfCondition EqualTo(hn, 1) ThenBlock: { h_plate = Add(h_plate, 1) }
                        }
                        ArraySet(pd, 0, 0)
                        ArraySet(pd, 1, Float_Sub(0, 0x402E000000000000))
                        o1 = CAD_Num.Orient2D(pa, pb, pd)
                        o2 = CAD_Num.Orient2D(pb, pc, pd)
                        o3 = CAD_Num.Orient2D(pc, pa, pd)
                        IfCondition EqualTo(o1, o2) ThenBlock: {
                            IfCondition EqualTo(o2, o3) ThenBlock: {
                                IfCondition NotEqual(o1, 0) ThenBlock: { h_below = Add(h_below, 1) }
                            }
                        }
                    }
                }
            }
            t = Add(t, 1)
        }
        Deallocate(pa, 32)
        Deallocate(pb, 32)
        Deallocate(pc, 32)
        Deallocate(pd, 32)
        CAD_Tess.ExportSTL(h, "/tmp/notch_hole.stl")
        PrintMessage("hole_hits=")
        PrintNumber(h_hole)
        PrintMessage(" notch_hits=")
        PrintNumber(h_notch)
        PrintMessage(" plate_hits=")
        PrintNumber(h_plate)
        PrintMessage(" below_hits=")
        PrintNumber(h_below)
        PrintMessage("\n")
        IfCondition EqualTo(h_hole, 0) ThenBlock: {
            IfCondition EqualTo(h_notch, 0) ThenBlock: {
                IfCondition GreaterThan(h_plate, 0) ThenBlock: {
                    IfCondition GreaterThan(nt, 20) ThenBlock: { pass = 1 }
                }
            }
        }
        Deallocate(mesh, 32)
    }
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "NOTCH HOLE TESS PASS\n", 21)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "NOTCH HOLE TESS FAIL\n", 21)
    }
    Deallocate(outer, 4096)
    Deallocate(hole, 4096)
    CAD_Sys.Write(1, "DONE\n", 5)
    SystemCall(60, Subtract(1, pass), 0, 0)
}
RunTask(Main)
