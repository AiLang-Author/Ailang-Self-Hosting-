// Standalone numeric smoke: Sqrt / Atan2 / Mul / Sq / Hypot2 / PosMod2Pi
// Positive and negative inputs. Exit 0 only if all checks pass.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

// |a-b| <= tol ?
Function.Near {
    Input: a_r: Integer
    Input: b_r: Integer
    Input: tol_r: Integer
    Output: Integer
    Body: {
        d = Float_Sub(a_r, b_r)
        IfCondition EqualTo(CAD_Num.IsNeg(d), 1) ThenBlock: {
            d = Float_Sub(0, d)
        }
        ReturnValue(Float_Le(d, tol_r))
    }
}

Function.Fail {
    Input: msg_addr: Address
    Input: n: Integer
    Output: Integer
    Body: {
        CAD_Sys.Write(1, msg_addr, n)
        SystemCall(60, 1, 0, 0)
        ReturnValue(0)
    }
}

SubRoutine.Main {
    CAD_Num.InitTolerance(0, 0)

    // tolerances
    // compare IEEE bits only (no float printf — values are i64 bit patterns)
    tol_loose = 0x3F50624DD2F1A9FC
    // ~1e-3 — enough for improved Atan / series
    tol_mid = 0x3F1A36E2EB1C432D
    // ~1e-4
    tol_tight = 0x3F1A36E2EB1C432D
    // ~1e-4

    zero = 0
    one = 0x3FF0000000000000
    two = 0x4000000000000000
    four = 0x4010000000000000
    mone = Float_Sub(0, one)
    mtwo = Float_Sub(0, two)
    pi = 0x400921FB54442D18
    pi2 = 0x3FF921FB54442D18
    // π/2
    pi34 = Float_Mul(pi, 0x3FE8000000000000)
    // 3π/4
    mpi = Float_Sub(0, pi)
    mpi2 = Float_Sub(0, pi2)

    CAD_Sys.Write(1, "=== CAD_Num / CAD_Geom numeric tests ===\n", 42)

    // ---------- Sqrt ----------
    CAD_Sys.Write(1, "-- Sqrt --\n", 11)
    // sqrt(0)=0
    IfCondition EqualTo(CAD_Num.Sqrt(zero), zero) ThenBlock: {
        CAD_Sys.Write(1, "PASS sqrt(0)\n", 13)
    }
    IfCondition NotEqual(CAD_Num.Sqrt(zero), zero) ThenBlock: {
        Fail("FAIL sqrt(0)\n", 13)
    }
    // sqrt(1)=1
    IfCondition EqualTo(Near(CAD_Num.Sqrt(one), one, tol_tight), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS sqrt(1)\n", 13)
    }
    IfCondition EqualTo(Near(CAD_Num.Sqrt(one), one, tol_tight), 0) ThenBlock: {
        Fail("FAIL sqrt(1)\n", 13)
    }
    // sqrt(4)=2
    IfCondition EqualTo(Near(CAD_Num.Sqrt(four), two, tol_tight), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS sqrt(4)\n", 13)
    }
    IfCondition EqualTo(Near(CAD_Num.Sqrt(four), two, tol_tight), 0) ThenBlock: {
        Fail("FAIL sqrt(4)\n", 13)
    }
    // sqrt(9)=3
    nine = 0x4022000000000000
    three = 0x4008000000000000
    IfCondition EqualTo(Near(CAD_Num.Sqrt(nine), three, tol_tight), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS sqrt(9)\n", 13)
    }
    IfCondition EqualTo(Near(CAD_Num.Sqrt(nine), three, tol_tight), 0) ThenBlock: {
        Fail("FAIL sqrt(9)\n", 13)
    }
    // sqrt(negative) → 0 by our Newton wrapper
    IfCondition EqualTo(CAD_Num.Sqrt(mone), zero) ThenBlock: {
        CAD_Sys.Write(1, "PASS sqrt(-1)→0\n", 16)
    }
    IfCondition NotEqual(CAD_Num.Sqrt(mone), zero) ThenBlock: {
        Fail("FAIL sqrt(-1) expected 0\n", 25)
    }
    // sqrt(0.25)=0.5
    q = 0x3FD0000000000000
    half = 0x3FE0000000000000
    IfCondition EqualTo(Near(CAD_Num.Sqrt(q), half, tol_mid), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS sqrt(0.25)\n", 16)
    }
    IfCondition EqualTo(Near(CAD_Num.Sqrt(q), half, tol_mid), 0) ThenBlock: {
        Fail("FAIL sqrt(0.25)\n", 16)
    }

    // ---------- Sq / Mul / IsNeg / Abs ----------
    CAD_Sys.Write(1, "-- Sq Mul IsNeg Abs --\n", 23)
    IfCondition EqualTo(Near(CAD_Num.Sq(mtwo), four, tol_tight), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS Sq(-2)=4\n", 14)
    }
    IfCondition EqualTo(Near(CAD_Num.Sq(mtwo), four, tol_tight), 0) ThenBlock: {
        Fail("FAIL Sq(-2)\n", 12)
    }
    // Mul signs
    IfCondition EqualTo(Near(CAD_Num.Mul(mtwo, three), Float_Sub(0, 0x4018000000000000), tol_tight), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS Mul(-2,3)=-6\n", 18)
    }
    IfCondition EqualTo(Near(CAD_Num.Mul(mtwo, three), Float_Sub(0, 0x4018000000000000), tol_tight), 0) ThenBlock: {
        Fail("FAIL Mul(-2,3)\n", 15)
    }
    IfCondition EqualTo(Near(CAD_Num.Mul(mtwo, mtwo), four, tol_tight), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS Mul(-2,-2)=4\n", 18)
    }
    IfCondition EqualTo(Near(CAD_Num.Mul(mtwo, mtwo), four, tol_tight), 0) ThenBlock: {
        Fail("FAIL Mul(-2,-2)\n", 16)
    }
    IfCondition EqualTo(CAD_Num.IsNeg(mone), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS IsNeg(-1)\n", 15)
    }
    IfCondition NotEqual(CAD_Num.IsNeg(mone), 1) ThenBlock: {
        Fail("FAIL IsNeg(-1)\n", 15)
    }
    IfCondition EqualTo(CAD_Num.IsNeg(one), 0) ThenBlock: {
        CAD_Sys.Write(1, "PASS !IsNeg(+1)\n", 16)
    }
    IfCondition NotEqual(CAD_Num.IsNeg(one), 0) ThenBlock: {
        Fail("FAIL !IsNeg(+1)\n", 16)
    }
    IfCondition EqualTo(Near(CAD_Num.Abs(mone), one, tol_tight), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS Abs(-1)\n", 13)
    }
    IfCondition EqualTo(Near(CAD_Num.Abs(mone), one, tol_tight), 0) ThenBlock: {
        Fail("FAIL Abs(-1)\n", 13)
    }
    // Dot2: (-3,4)·(2,-1) = -6-4 = -10
    m3 = Float_Sub(0, three)
    m10 = Float_Sub(0, 0x4024000000000000)
    d = CAD_Num.Dot2(m3, four, two, mone)
    IfCondition EqualTo(Near(d, m10, tol_tight), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS Dot2 signed\n", 17)
    }
    IfCondition EqualTo(Near(d, m10, tol_tight), 0) ThenBlock: {
        Fail("FAIL Dot2 signed\n", 17)
    }
    // Hypot2(3,4)=5
    five = 0x4014000000000000
    IfCondition EqualTo(Near(CAD_Num.Hypot2(three, four), five, tol_mid), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS Hypot2(3,4)\n", 17)
    }
    IfCondition EqualTo(Near(CAD_Num.Hypot2(three, four), five, tol_mid), 0) ThenBlock: {
        Fail("FAIL Hypot2(3,4)\n", 17)
    }
    IfCondition EqualTo(Near(CAD_Num.Hypot2(m3, four), five, tol_mid), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS Hypot2(-3,4)\n", 18)
    }
    IfCondition EqualTo(Near(CAD_Num.Hypot2(m3, four), five, tol_mid), 0) ThenBlock: {
        Fail("FAIL Hypot2(-3,4)\n", 18)
    }

    // ---------- Atan2 all quadrants ----------
    CAD_Sys.Write(1, "-- Atan2 --\n", 12)
    // (+1,+0) → 0
    a = CAD_Geom.Atan2(zero, one)
    IfCondition EqualTo(Near(a, zero, tol_loose), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS Atan2(+0,+1)→0\n", 20)
    }
    IfCondition EqualTo(Near(a, zero, tol_loose), 0) ThenBlock: {
        Fail("FAIL Atan2(+0,+1)\n", 18)
    }
    // (+1,+1) → π/4
    pi4 = Float_Mul(pi, 0x3FD0000000000000)
    a = CAD_Geom.Atan2(one, one)
    IfCondition EqualTo(Near(a, pi4, tol_loose), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS Atan2(+1,+1)→π/4\n", 22)
    }
    IfCondition EqualTo(Near(a, pi4, tol_loose), 0) ThenBlock: {
        Fail("FAIL Atan2(+1,+1)\n", 18)
    }
    // (+1,0) axis → π/2
    a = CAD_Geom.Atan2(one, zero)
    IfCondition EqualTo(Near(a, pi2, tol_loose), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS Atan2(+1,0)→π/2\n", 21)
    }
    IfCondition EqualTo(Near(a, pi2, tol_loose), 0) ThenBlock: {
        Fail("FAIL Atan2(+1,0)\n", 17)
    }
    // (+1,-1) Q2 → 3π/4
    a = CAD_Geom.Atan2(one, mone)
    IfCondition EqualTo(Near(a, pi34, tol_loose), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS Atan2(+1,-1)→3π/4\n", 23)
    }
    IfCondition EqualTo(Near(a, pi34, tol_loose), 0) ThenBlock: {
        Fail("FAIL Atan2(+1,-1) Q2\n", 21)
    }
    // (0,-1) → π (or -π; accept |a|≈π)
    a = CAD_Geom.Atan2(zero, mone)
    aa = CAD_Num.Abs(a)
    IfCondition EqualTo(Near(aa, pi, tol_loose), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS Atan2(0,-1)→±π\n", 20)
    }
    IfCondition EqualTo(Near(aa, pi, tol_loose), 0) ThenBlock: {
        Fail("FAIL Atan2(0,-1)\n", 17)
    }
    // (-1,-1) Q3 → -3π/4
    m34 = Float_Sub(0, pi34)
    a = CAD_Geom.Atan2(mone, mone)
    IfCondition EqualTo(Near(a, m34, tol_loose), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS Atan2(-1,-1)→-3π/4\n", 24)
    }
    IfCondition EqualTo(Near(a, m34, tol_loose), 0) ThenBlock: {
        Fail("FAIL Atan2(-1,-1) Q3\n", 21)
    }
    // (-1,0) → -π/2
    a = CAD_Geom.Atan2(mone, zero)
    IfCondition EqualTo(Near(a, mpi2, tol_loose), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS Atan2(-1,0)→-π/2\n", 22)
    }
    IfCondition EqualTo(Near(a, mpi2, tol_loose), 0) ThenBlock: {
        Fail("FAIL Atan2(-1,0)\n", 17)
    }
    // (-1,+1) Q4 → -π/4
    m4 = Float_Sub(0, pi4)
    a = CAD_Geom.Atan2(mone, one)
    IfCondition EqualTo(Near(a, m4, tol_loose), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS Atan2(-1,+1)→-π/4\n", 23)
    }
    IfCondition EqualTo(Near(a, m4, tol_loose), 0) ThenBlock: {
        Fail("FAIL Atan2(-1,+1) Q4\n", 21)
    }

    // ---------- PosMod2Pi ----------
    CAD_Sys.Write(1, "-- PosMod2Pi --\n", 16)
    two_pi = 0x401921FB54442D18
    // -π/4 → 7π/4
    p = CAD_Num.PosMod2Pi(m4)
    e74 = Float_Sub(two_pi, pi4)
    IfCondition EqualTo(Near(p, e74, tol_loose), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS PosMod2Pi(-π/4)\n", 21)
    }
    IfCondition EqualTo(Near(p, e74, tol_loose), 0) ThenBlock: {
        Fail("FAIL PosMod2Pi(-π/4)\n", 21)
    }
    // +π stays π
    p = CAD_Num.PosMod2Pi(pi)
    IfCondition EqualTo(Near(p, pi, tol_loose), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS PosMod2Pi(π)\n", 18)
    }
    IfCondition EqualTo(Near(p, pi, tol_loose), 0) ThenBlock: {
        Fail("FAIL PosMod2Pi(π)\n", 18)
    }

    // ---------- line×circle disc (the join math) ----------
    CAD_Sys.Write(1, "-- line×circle disc --\n", 23)
    // line (-10,0)-(10,0), circle R=5 at origin → hits at ±5
    // aa=400, bb=0, cc=100-25=75, disc=0-4*400*75 wait
    // P=(-10,0), D=(20,0), C=(0,0), r=5
    // f=(-10,0), aa=400, bb=2*f·D=2*(-200)=-400, cc=100-25=75
    // disc = bb² - 4 aa cc = 160000 - 120000 = 40000, s=200
    // t = (400±200)/800 → t=0.75 and t=0.25 → x=-10+20t = 5 and -5
    ten = 0x4024000000000000
    mten = Float_Sub(0, ten)
    dx = Float_Sub(ten, mten)
    // 20
    dy = zero
    fx = mten
    fy = zero
    rad = five
    aa = Float_Add(CAD_Num.Sq(dx), CAD_Num.Sq(dy))
    bb = CAD_Num.Mul(two, CAD_Num.Dot2(fx, fy, dx, dy))
    cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
    disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(four, aa), cc))
    IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
        Fail("FAIL disc negative for diameter line\n", 37)
    }
    s = CAD_Num.Sqrt(disc)
    two_a = Float_Mul(two, aa)
    t0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
    t1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
    x0 = Float_Add(mten, CAD_Num.Mul(t0, dx))
    x1 = Float_Add(mten, CAD_Num.Mul(t1, dx))
    // expect ±5
    okL = Near(x0, Float_Sub(0, five), tol_loose)
    okR = Near(x0, five, tol_loose)
    // either order
    hit_m5 = 0
    hit_p5 = 0
    IfCondition EqualTo(Near(x0, Float_Sub(0, five), tol_loose), 1) ThenBlock: { hit_m5 = 1 }
    IfCondition EqualTo(Near(x1, Float_Sub(0, five), tol_loose), 1) ThenBlock: { hit_m5 = 1 }
    IfCondition EqualTo(Near(x0, five, tol_loose), 1) ThenBlock: { hit_p5 = 1 }
    IfCondition EqualTo(Near(x1, five, tol_loose), 1) ThenBlock: { hit_p5 = 1 }
    IfCondition EqualTo(hit_m5, 1) ThenBlock: {
        IfCondition EqualTo(hit_p5, 1) ThenBlock: {
            CAD_Sys.Write(1, "PASS disc line×circle ±5\n", 25)
        }
    }
    IfCondition EqualTo(hit_m5, 0) ThenBlock: {
        Fail("FAIL disc missing -5\n", 21)
    }
    IfCondition EqualTo(hit_p5, 0) ThenBlock: {
        Fail("FAIL disc missing +5\n", 21)
    }

    // diagonal through circle (both Q2 and Q4)
    // line (-6,-6)-(6,6), r=5 → hits at ±5/√2 on diagonal
    six = 0x4018000000000000
    msix = Float_Sub(0, six)
    dx = Float_Sub(six, msix)
    dy = dx
    fx = msix
    fy = msix
    aa = Float_Add(CAD_Num.Sq(dx), CAD_Num.Sq(dy))
    bb = CAD_Num.Mul(two, CAD_Num.Dot2(fx, fy, dx, dy))
    cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
    disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(four, aa), cc))
    IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
        Fail("FAIL diagonal disc neg\n", 23)
    }
    s = CAD_Num.Sqrt(disc)
    two_a = Float_Mul(two, aa)
    t0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
    t1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
    // both t in (0,1)
    ok = 1
    IfCondition EqualTo(CAD_Num.IsNeg(t0), 1) ThenBlock: { ok = 0 }
    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(one, t0)), 1) ThenBlock: { ok = 0 }
    IfCondition EqualTo(CAD_Num.IsNeg(t1), 1) ThenBlock: { ok = 0 }
    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(one, t1)), 1) ThenBlock: { ok = 0 }
    IfCondition EqualTo(ok, 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS diagonal both t in (0,1)\n", 30)
    }
    IfCondition EqualTo(ok, 0) ThenBlock: {
        Fail("FAIL diagonal t not both in (0,1)\n", 34)
    }

    CAD_Sys.Write(1, "=== ALL NUMERIC TESTS PASSED ===\n", 34)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
