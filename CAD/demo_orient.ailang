LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num

SubRoutine.Main {
    CAD_Num.InitTolerance(0, 0)
    pa = Allocate(32)
    pb = Allocate(32)
    pc = Allocate(32)
    ArraySet(pa, 0, 0)
    ArraySet(pa, 1, 0)
    // CW: A(0,0) B(0,1) C(1,0)
    ArraySet(pb, 0, 0)
    ArraySet(pb, 1, 0x3FF0000000000000)
    ArraySet(pc, 0, 0x3FF0000000000000)
    ArraySet(pc, 1, 0)
    o = CAD_Num.Orient2D(pa, pb, pc)
    PrintMessage("CW A-B-C orient=")
    PrintNumber(o)
    PrintMessage("\n")
    // CCW: A(0,0) B(1,0) C(0,1)
    ArraySet(pb, 0, 0x3FF0000000000000)
    ArraySet(pb, 1, 0)
    ArraySet(pc, 0, 0)
    ArraySet(pc, 1, 0x3FF0000000000000)
    o2 = CAD_Num.Orient2D(pa, pb, pc)
    PrintMessage("CCW A-B-C orient=")
    PrintNumber(o2)
    PrintMessage("\n")
    // print raw det via checking IsNeg path - also try equal to Subtract(0,1)
    m1 = Subtract(0, 1)
    PrintMessage("minus1=")
    PrintNumber(m1)
    PrintMessage(" eq=")
    PrintNumber(EqualTo(o, m1))
    PrintMessage("\n")
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
