// Square + Pac-Man (major arc + two radials). Line tips are NOT on the circle
// (Cos(a) ≠ line end). ProfCompile must still emit TWO closed faces.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== pacman profile compiler ===\n", 33)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    sk = CAD_Sketch.CreateSketch(1)
    // square (0,0)-(100,100) — avoid passing negative IEEE as AddLine args
    z = 0
    p100 = 0x4059000000000000
    p50 = 0x4049000000000000
    CAD_Sketch.AddLine(sk, z, z, p100, z)
    CAD_Sketch.AddLine(sk, p100, z, p100, p100)
    CAD_Sketch.AddLine(sk, p100, p100, z, p100)
    CAD_Sketch.AddLine(sk, z, p100, z, z)

    // radials from (50,50) overshoot r=25 (Cos(a) ≠ hit)
    p90 = 0x4056800000000000
    p38 = 0x4043000000000000
    CAD_Sketch.AddLine(sk, p50, p50, p90, p90)
    CAD_Sketch.AddLine(sk, p50, p50, p90, p38)
    CAD_Sketch.AddArc(sk, p50, p50, 0x4039000000000000, 0x3FE921FB54442D18, 0x4017F787ADE24228)

    n = CAD_Sketch.ProfCompile(sk)
    CAD_Sys.Write(1, "nprof=", 6)
    PrintNumber(n)
    CAD_Sys.Write(1, "\n", 1)
    IfCondition LessThan(n, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected 2 faces (square + pacman)\n", 40)
        SystemCall(60, 1, 0, 0)
    }

    xy = Allocate(65536)
    pi = 0
    saw_sq = 0
    saw_pm = 0
    WhileLoop LessThan(pi, n) {
        nn = CAD_Sketch.GetProfileXY(sk, pi, xy)
        ar = CAD_Sketch.LoopSignedArea(xy, nn)
        IfCondition EqualTo(CAD_Num.IsNeg(ar), 1) ThenBlock: { ar = Float_Sub(0, ar) }
        CAD_Sys.Write(1, "face ", 5)
        PrintNumber(pi)
        CAD_Sys.Write(1, " nn=", 4)
        PrintNumber(nn)
        CAD_Sys.Write(1, " area=", 6)
        PrintNumber(Float_ToInt(ar))
        CAD_Sys.Write(1, "\n", 1)
        // square 100×100 = 10000; bite is smaller
        IfCondition GreaterThan(Float_ToInt(ar), 8000) ThenBlock: { saw_sq = 1 }
        IfCondition LessThan(Float_ToInt(ar), 8000) ThenBlock: {
            IfCondition GreaterThan(Float_ToInt(ar), 100) ThenBlock: { saw_pm = 1 }
        }
        pi = Add(pi, 1)
    }
    Deallocate(xy, 65536)
    IfCondition EqualTo(saw_sq, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no square face\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(saw_pm, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no pacman face\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS square + pacman\n", 21)
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
