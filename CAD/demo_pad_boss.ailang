// Rectangular boss (pad) on plate top — stepped B-Rep, STEP walk.
// Also gates kind-3 ClassifyPoint: center of hole is OUTSIDE plate solid.
//
// Dimensions (mm, FreeCAD measure):
//   Base plate: 50 x 40 x 10  (origin corner)
//   Boss:       20 x 20 x 12  footprint [15..35] x [10..30] on top face
//   Overall Z:  22  (10 base + 12 boss)
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== pad boss + hole classify ===\n", 34)
    CAD_Sys.Write(1, "DIM plate 50x40x10 mm\n", 22)
    CAD_Sys.Write(1, "DIM boss  20x20x12 mm at XY [15..35]x[10..30]\n", 47)
    CAD_Sys.Write(1, "DIM overall height 22 mm\n", 25)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    pack = Allocate(48)
    tool_out = Allocate(16)
    pt = Allocate(32)

    // plate 50 x 40 x 10 with boss [15,10]→[35,30] height 12
    body = CAD_Script.CreateBox(0x4049000000000000, 0x4044000000000000, 0x4024000000000000)
    ArraySet(pack, 0, 0x402E000000000000)
    ArraySet(pack, 1, 0x4024000000000000)
    ArraySet(pack, 2, 0x4041800000000000)
    ArraySet(pack, 3, 0x403E000000000000)
    ArraySet(pack, 4, 0x4028000000000000)
    boss = CAD_Feat.CreatePadBox(body, pack, tool_out)
    IfCondition EqualTo(boss, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL CreatePadBox\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(boss, "test-stl/cad_pad_boss.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL pad STEP\n", 14)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote test-stl/cad_pad_boss.stp\n", 32)

    // through hole plate — classify point in hole as outside
    body2 = CAD_Script.CreateBox(0x4044000000000000, 0x4044000000000000, 0x4024000000000000)
    ArraySet(pack, 0, 0x4020000000000000)
    ArraySet(pack, 1, 0x4024000000000000)
    ArraySet(pack, 2, 0x4034000000000000)
    ArraySet(pack, 3, 0x4034000000000000)
    cut = CAD_Feat.CreateHole(body2, pack, tool_out)
    IfCondition EqualTo(cut, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL hole for classify\n", 23)
        SystemCall(60, 1, 0, 0)
    }
    // hole center (20,20) mid-height → outside (void)
    ArraySet(pt, 0, 0x4034000000000000)
    ArraySet(pt, 1, 0x4034000000000000)
    ArraySet(pt, 2, 0x4014000000000000)
    cl = CAD_Bool.ClassifyPoint(pt, cut)
    IfCondition NotEqual(cl, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL hole center not outside\n", 29)
        SystemCall(60, 1, 0, 0)
    }
    // plate corner material
    ArraySet(pt, 0, 0x4000000000000000)
    ArraySet(pt, 1, 0x4000000000000000)
    ArraySet(pt, 2, 0x4014000000000000)
    cl = CAD_Bool.ClassifyPoint(pt, cut)
    IfCondition NotEqual(cl, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL plate material not inside\n", 31)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "kind-3 hole ClassifyPoint OK\n", 29)

    Deallocate(pack, 48)
    Deallocate(tool_out, 16)
    Deallocate(pt, 32)
    CAD_Sys.Write(1, "PAD BOSS OK\n", 12)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
