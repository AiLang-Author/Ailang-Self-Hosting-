LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Feat

Function.CopyGeom {
    Input: src: Integer
    Input: dst: Integer
    Output: Integer
    Body: {
        nl = CAD_Store.Read(src, 0)
        sl = CAD_Store.Read(src, 1)
        i = 0
        WhileLoop LessThan(i, nl) {
            b = Multiply(i, 4)
            CAD_Sketch.AddLine(dst, ArrayGet(sl, b), ArrayGet(sl, Add(b, 1)), ArrayGet(sl, Add(b, 2)), ArrayGet(sl, Add(b, 3)))
            i = Add(i, 1)
        }
        nc = CAD_Store.Read(src, 7)
        sc = CAD_Store.Read(src, 8)
        i = 0
        WhileLoop LessThan(i, nc) {
            b = Multiply(i, 3)
            CAD_Sketch.AddCircle(dst, ArrayGet(sc, b), ArrayGet(sc, Add(b, 1)), ArrayGet(sc, Add(b, 2)))
            i = Add(i, 1)
        }
        na = CAD_Store.Read(src, 10)
        sa = CAD_Store.Read(src, 11)
        i = 0
        WhileLoop LessThan(i, na) {
            b = Multiply(i, 5)
            CAD_Sketch.AddArc(dst, ArrayGet(sa, b), ArrayGet(sa, Add(b, 1)), ArrayGet(sa, Add(b, 2)), ArrayGet(sa, Add(b, 3)), ArrayGet(sa, Add(b, 4)))
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.ProjectAndPad {
    Input: live: Integer
    Input: hgt: Integer
    Output: Integer
    Body: {
        CAD_Sketch.RebuildAnchors(live)
        clone = CAD_Sketch.CreateSketch(1)
        CopyGeom(live, clone)
        IfCondition GreaterThan(CAD_Store.Read(clone, 10), 0) ThenBlock: {
            CAD_Sketch.SnapArcEndsToSketch(clone, 0x3FA999999999999A)
            CAD_Sketch.TessellateArcs(clone, 96)
        }
        IfCondition GreaterThan(CAD_Store.Read(clone, 7), 0) ThenBlock: {
            CAD_Sketch.TessellateCircles(clone, 48)
            CAD_Store.Write(clone, 7, 0)
        }
        CAD_Sketch.SnapNearEndpoints(clone, 0x3FA999999999999A)
        n = CAD_Sketch.BuildAllClosedLoops(clone)
        IfCondition EqualTo(n, 0) ThenBlock: {
            CAD_Sys.Write(1, "  face-walk 0\n", 14)
            ReturnValue(0)
        }
        // copy profile 0 to extrude sketch like pad
        xy = Allocate(65536)
        nn = CAD_Sketch.GetProfileXY(clone, 0, xy)
        IfCondition LessThan(nn, 3) ThenBlock: {
            Deallocate(xy, 65536)
            CAD_Sys.Write(1, "  ring empty\n", 13)
            ReturnValue(0)
        }
        hsk = CAD_Sketch.CreateSketch(1)
        CAD_Sketch.AddProfileXY(hsk, xy, nn)
        Deallocate(xy, 65536)
        h = CAD_Feat.ExtrudeOnPlane(hsk, hgt, 0)
        ReturnValue(h)
    }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== interactive pad path ===\n", 30)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    hgt = Float_FromInt(20)

    sk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddRectangle(sk, 0, 0, Float_FromInt(40), Float_FromInt(30))
    h = ProjectAndPad(sk, hgt)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL rect interactive path\n", 28)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS rect interactive path\n", 28)

    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(sk2, 0, 0, Float_FromInt(15))
    h = ProjectAndPad(sk2, hgt)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circle interactive path\n", 30)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS circle interactive path\n", 30)

    CAD_Sys.Write(1, "=== interactive path OK ===\n", 29)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
