// V+Arc3 scoop: dump all profiles (count, nn, area) then extrude
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Topo

SubRoutine.Main {
    PrintMessage("=== pad scoop diag ===\n")
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    sk = CAD_Sketch.CreateSketch(1)
    // V: (-10,20)-(0,0) and (10,20)-(0,0)
    CAD_Sketch.AddLine(sk, 0xC024000000000000, 0x4034000000000000, 0, 0)
    CAD_Sketch.AddLine(sk, 0x4024000000000000, 0x4034000000000000, 0, 0)
    CAD_Sketch.Arc3Pend(0xC024000000000000, 0x4034000000000000, 0, 0x403C000000000000, 0x4024000000000000, 0x4034000000000000)
    rc = CAD_Sketch.Arc3Point(sk)
    PrintMessage("Arc3Point rc=")
    PrintNumber(rc)
    PrintMessage(" na=")
    PrintNumber(CAD_Sketch.GetArcCount(sk))
    PrintMessage(" nl=")
    PrintNumber(CAD_Sketch.GetLineCount(sk))
    PrintMessage("\n")

    // project like CA_RebuildProfiles
    clone = CAD_Sketch.CreateSketch(1)
    nl = CAD_Sketch.GetLineCount(sk)
    lines = CAD_Store.Read(sk, 1)
    i = 0
    WhileLoop LessThan(i, nl) {
        b = Multiply(i, 4)
        CAD_Sketch.AddLine(clone, ArrayGet(lines, b), ArrayGet(lines, Add(b, 1)), ArrayGet(lines, Add(b, 2)), ArrayGet(lines, Add(b, 3)))
        i = Add(i, 1)
    }
    na = CAD_Sketch.GetArcCount(sk)
    arcs = CAD_Store.Read(sk, 11)
    i = 0
    WhileLoop LessThan(i, na) {
        b = Multiply(i, 5)
        CAD_Sketch.AddArc(clone, ArrayGet(arcs, b), ArrayGet(arcs, Add(b, 1)), ArrayGet(arcs, Add(b, 2)), ArrayGet(arcs, Add(b, 3)), ArrayGet(arcs, Add(b, 4)))
        i = Add(i, 1)
    }
    CAD_Sketch.SnapArcEndsToSketch(clone, 0)
    CAD_Sketch.TessellateArcs(clone, 96)
    CAD_Sketch.SnapNearEndpoints(clone, 0)
    n = CAD_Sketch.BuildAllClosedLoops(clone)
    PrintMessage("nprof=")
    PrintNumber(n)
    PrintMessage(" final nl=")
    PrintNumber(CAD_Store.Read(clone, 0))
    PrintMessage("\n")

    xy = Allocate(65536)
    pi = 0
    WhileLoop LessThan(pi, n) {
        nn = CAD_Sketch.GetProfileXY(clone, pi, xy)
        ar = CAD_Sketch.LoopSignedArea(xy, nn)
        aabs = ar
        IfCondition EqualTo(Float_Le(aabs, 0), 1) ThenBlock: { aabs = Float_Sub(0, aabs) }
        PrintMessage("prof ")
        PrintNumber(pi)
        PrintMessage(" nn=")
        PrintNumber(nn)
        PrintMessage(" area=")
        PrintNumber(Float_ToInt(aabs))
        PrintMessage(" signed=")
        PrintNumber(Float_ToInt(ar))
        // bbox
        xmin = ArrayGet(xy, 0)
        ymin = ArrayGet(xy, 1)
        xmax = xmin
        ymax = ymin
        k = 0
        WhileLoop LessThan(k, nn) {
            x = ArrayGet(xy, Multiply(k, 2))
            y = ArrayGet(xy, Add(Multiply(k, 2), 1))
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            k = Add(k, 1)
        }
        PrintMessage(" bbox y ")
        PrintNumber(Float_ToInt(ymin))
        PrintMessage("..")
        PrintNumber(Float_ToInt(ymax))
        PrintMessage(" x ")
        PrintNumber(Float_ToInt(xmin))
        PrintMessage("..")
        PrintNumber(Float_ToInt(xmax))
        PrintMessage("\n  v0=")
        PrintNumber(Float_ToInt(ArrayGet(xy, 0)))
        PrintMessage(",")
        PrintNumber(Float_ToInt(ArrayGet(xy, 1)))
        PrintMessage(" v1=")
        PrintNumber(Float_ToInt(ArrayGet(xy, 2)))
        PrintMessage(",")
        PrintNumber(Float_ToInt(ArrayGet(xy, 3)))
        PrintMessage(" vlast=")
        PrintNumber(Float_ToInt(ArrayGet(xy, Multiply(Subtract(nn, 1), 2))))
        PrintMessage(",")
        PrintNumber(Float_ToInt(ArrayGet(xy, Add(Multiply(Subtract(nn, 1), 2), 1))))
        PrintMessage("\n")
        pi = Add(pi, 1)
    }

    // extrude each profile alone
    pi = 0
    WhileLoop LessThan(pi, n) {
        nn = CAD_Sketch.GetProfileXY(clone, pi, xy)
        hsk = CAD_Sketch.CreateSketch(1)
        CAD_Sketch.AddProfileXY(hsk, xy, nn)
        h = CAD_Feat.ExtrudeProfile(hsk, 0x4024000000000000)
        PrintMessage("extrude prof ")
        PrintNumber(pi)
        PrintMessage(" solid=")
        PrintNumber(h)
        PrintMessage("\n")
        pi = Add(pi, 1)
    }

    // extrude ALL profiles on one sketch
    hsk2 = CAD_Sketch.CreateSketch(1)
    pi = 0
    WhileLoop LessThan(pi, n) {
        nn = CAD_Sketch.GetProfileXY(clone, pi, xy)
        CAD_Sketch.AddProfileXY(hsk2, xy, nn)
        pi = Add(pi, 1)
    }
    h2 = CAD_Feat.ExtrudeProfile(hsk2, 0x4024000000000000)
    PrintMessage("extrude ALL solid=")
    PrintNumber(h2)
    PrintMessage("\n")

    // largest area
    best_i = 0
    best_a = 0
    pi = 0
    WhileLoop LessThan(pi, n) {
        nn = CAD_Sketch.GetProfileXY(clone, pi, xy)
        ar = CAD_Sketch.LoopSignedArea(xy, nn)
        IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
        IfCondition EqualTo(Float_Le(best_a, ar), 1) ThenBlock: {
            best_a = ar
            best_i = pi
        }
        pi = Add(pi, 1)
    }
    PrintMessage("largest prof=")
    PrintNumber(best_i)
    PrintMessage(" area=")
    PrintNumber(Float_ToInt(best_a))
    PrintMessage("\n")

    // mesh largest scoop solid — notch tip (0,15) is IN void of V+arc scoop?
    // scoop is V lines + upper arc: material is BELOW the arc. Point (0,25) is outside.
    // Point (0,10) is inside the solid scoop body (below arc peak at y=30).
    nn = CAD_Sketch.GetProfileXY(clone, best_i, xy)
    hsk3 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk3, xy, nn)
    hs = CAD_Feat.ExtrudeProfile(hsk3, 0x4034000000000000)
    mesh = Allocate(32)
    nt = CAD_Tess.MeshSolid(hs, 0x3FB999999999999A, mesh)
    PrintMessage("scoop mesh nt=")
    PrintNumber(nt)
    PrintMessage(" nv=")
    PrintNumber(ArrayGet(mesh, 0))
    PrintMessage("\n")
    // face nce dump
    sh = CAD_Store.Read(hs, 0)
    face = CAD_Store.Read(sh, 0)
    fi = 0
    WhileLoop NotEqual(face, 0) {
        IfCondition LessThan(fi, 6) ThenBlock: {
            lh = CAD_Store.Read(face, 1)
            nce = 0
            IfCondition NotEqual(lh, 0) ThenBlock: { nce = CAD_Topo.LoopCountCoedges(lh) }
            PrintMessage("face ")
            PrintNumber(fi)
            PrintMessage(" nce=")
            PrintNumber(nce)
            PrintMessage("\n")
        }
        face = CAD_Store.Read(face, 3)
        fi = Add(fi, 1)
        IfCondition GreaterThan(fi, 200) ThenBlock: { face = 0 }
    }
    PrintMessage("nfaces=")
    PrintNumber(fi)
    PrintMessage("\n")
    // Fan from apex would fill across concave; check probe at (0, 25) which is
    // above the V bottom but should be OUTSIDE if arc notch is correct?
    // For V scoop: points of V at (-10,20),(0,0),(10,20), arc through (0,30).
    // Concave at (0,0). Fan from (0,0) fills fine. Fan from other verts may fill outside.
    // Better probe: exterior point just outside reflex at (-1, 5) still inside hull?
    Deallocate(mesh, 32)
    Deallocate(xy, 65536)
    PrintMessage("PAD SCOOP DIAG DONE\n")
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
