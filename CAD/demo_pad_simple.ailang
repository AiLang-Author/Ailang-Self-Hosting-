// Interactive pad path: rect / square / circle must extrude.
// Mirrors CA_PadFromSketch: GetProfileXY → CreateSketch → AddProfileXY → ExtrudeOnPlane.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Topo

Function.PadViaProfileRing {
    Input: sk: Integer
    Input: hgt: Integer
    Output: Integer
    Body: {
        // like CA_RebuildProfiles minimal: closed loops on sketch
        n = CAD_Store.Read(sk, 12)
        IfCondition EqualTo(n, 0) ThenBlock: {
            n = CAD_Sketch.BuildAllClosedLoops(sk)
        }
        IfCondition EqualTo(n, 0) ThenBlock: {
            // circle path: tess + loops
            IfCondition GreaterThan(CAD_Store.Read(sk, 7), 0) ThenBlock: {
                CAD_Sketch.TessellateCircles(sk, 48)
                CAD_Store.Write(sk, 7, 0)
            }
            n = CAD_Sketch.BuildAllClosedLoops(sk)
        }
        IfCondition EqualTo(n, 0) ThenBlock: {
            CAD_Sys.Write(1, "  no profiles\n", 14)
            ReturnValue(0)
        }
        xy = Allocate(65536)
        nn = CAD_Sketch.GetProfileXY(sk, 0, xy)
        IfCondition LessThan(nn, 3) ThenBlock: {
            Deallocate(xy, 65536)
            CAD_Sys.Write(1, "  empty ring\n", 13)
            ReturnValue(0)
        }
        hsk = CAD_Sketch.CreateSketch(1)
        CAD_Sketch.AddProfileXY(hsk, xy, nn)
        pn = CAD_Store.Read(hsk, 2)
        Deallocate(xy, 65536)
        IfCondition LessThan(pn, 3) ThenBlock: {
            CAD_Sys.Write(1, "  AddProfileXY empty\n", 21)
            ReturnValue(0)
        }
        h = CAD_Feat.ExtrudeOnPlane(hsk, hgt, 0)
        ReturnValue(h)
    }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== simple pad rect/square/circle ===\n", 39)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    hgt = Float_FromInt(20)

    // --- rect ---
    sk = CAD_Sketch.CreateSketch(1)
    // AddRectangle(x0,y0,x1,y1)
    CAD_Sketch.AddRectangle(sk, 0, 0, Float_FromInt(40), Float_FromInt(30))
    h = PadViaProfileRing(sk, hgt)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL rect pad\n", 14)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS rect pad\n", 14)

    // --- square ---
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddSquare(sk2, 0, 0, Float_FromInt(25))
    h = PadViaProfileRing(sk2, hgt)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL square pad\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS square pad\n", 16)

    // --- circle only (analytic or tess) ---
    sk3 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(sk3, 0, 0, Float_FromInt(15))
    // interactive pad never leaves pure circle on hsk — always profile ring
    // so tess then ring path:
    CAD_Sketch.TessellateCircles(sk3, 48)
    CAD_Store.Write(sk3, 7, 0)
    h = PadViaProfileRing(sk3, hgt)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circle pad via tess ring\n", 31)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS circle pad via tess ring\n", 31)

    // pure circle ExtrudeProfile analytic
    sk4 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(sk4, Float_FromInt(5), Float_FromInt(5), Float_FromInt(10))
    h = CAD_Feat.ExtrudeProfile(sk4, hgt)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL pure circle ExtrudeProfile\n", 33)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS pure circle ExtrudeProfile\n", 33)

    CAD_Sys.Write(1, "=== ALL SIMPLE PADS OK ===\n", 28)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
