// Part Design parity: linear pattern, mirror, circular pattern, shell

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== Part Design pattern/mirror/shell ===\n", 40)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    // Linear pattern: 10mm cube along X spacing 15, count 4
    b1 = CAD_Script.CreateBox(Float_FromInt(10), Float_FromInt(10), Float_FromInt(10))
    p = CAD_Feat.LinearPattern(b1, Float_FromInt(15), 0, 0, 4)
    IfCondition EqualTo(p, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL linear\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(p, "test-stl/cad_pattern_linear.stp")
    CAD_View.SetWire(0)
    CAD_View.SetViewMode(0)
    CAD_View.RenderSolidToBMP(p, 500, 300, "test-stl/cad_view_pattern_linear.bmp")
    CAD_Sys.Write(1, "linear pattern ok\n", 18)

    // Mirror: box offset, mirror X
    b2 = CAD_Script.CreateBox(Float_FromInt(8), Float_FromInt(12), Float_FromInt(6))
    // shift to +X so mirror makes pair
    dlt = Allocate(32)
    ArraySet(dlt, 0, Float_FromInt(10))
    ArraySet(dlt, 1, 0)
    ArraySet(dlt, 2, 0)
    CAD_Topo.TranslateSolid(b2, dlt)
    Deallocate(dlt, 32)
    m = CAD_Feat.Mirror(b2, 0)
    IfCondition EqualTo(m, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL mirror\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(m, "test-stl/cad_mirror.stp")
    CAD_View.RenderSolidToBMP(m, 400, 300, "test-stl/cad_view_mirror.bmp")
    CAD_Sys.Write(1, "mirror ok\n", 10)

    // Circular pattern: small box away from origin, 6 instances
    b3 = CAD_Script.CreateBox(Float_FromInt(6), Float_FromInt(6), Float_FromInt(5))
    dlt = Allocate(32)
    ArraySet(dlt, 0, Float_FromInt(20))
    ArraySet(dlt, 1, Float_FromInt(-3))
    ArraySet(dlt, 2, 0)
    CAD_Topo.TranslateSolid(b3, dlt)
    Deallocate(dlt, 32)
    c = CAD_Feat.CircularPattern(b3, 6)
    IfCondition EqualTo(c, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circular\n", 14)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(c, "test-stl/cad_pattern_circular.stp")
    CAD_View.SetViewMode(1)
    CAD_View.RenderSolidToBMP(c, 450, 450, "test-stl/cad_view_pattern_circular.bmp")
    CAD_Sys.Write(1, "circular ok\n", 12)

    // Shell: open top pocket thickness 3
    b4 = CAD_Script.CreateBox(Float_FromInt(40), Float_FromInt(30), Float_FromInt(20))
    sh = CAD_Feat.Shell(b4, Float_FromInt(3))
    IfCondition EqualTo(sh, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL shell\n", 11)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(sh, "test-stl/cad_shell.stp")
    CAD_View.SetViewMode(0)
    CAD_View.RenderSolidToBMP(sh, 400, 300, "test-stl/cad_view_shell.bmp")
    CAD_Sys.Write(1, "shell ok\n", 9)
    CAD_Sys.Write(1, "PART DESIGN OK\n", 15)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
