LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

// fail if h != 0 (negative path expected refuse)
Function.ExpectZero {
    Input: h: Integer
    Input: tag: Address
    Input: taglen: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(h, 0) ThenBlock: {
            CAD_Sys.Write(1, "NEG FAIL (wanted 0): ", 21)
            CAD_Sys.Write(1, tag, taglen)
            CAD_Sys.Write(1, "\n", 1)
            ReturnValue(1)
        }
        CAD_Sys.Write(1, "neg ok: ", 8)
        CAD_Sys.Write(1, tag, taglen)
        CAD_Sys.Write(1, "\n", 1)
        ReturnValue(0)
    }
}

// fail if h == 0 (edge success expected)
Function.ExpectSolid {
    Input: h: Integer
    Input: tag: Address
    Input: taglen: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(h, 0) ThenBlock: {
            CAD_Sys.Write(1, "EDGE FAIL (wanted solid): ", 26)
            CAD_Sys.Write(1, tag, taglen)
            CAD_Sys.Write(1, "\n", 1)
            ReturnValue(1)
        }
        CAD_Sys.Write(1, "edge ok: ", 9)
        CAD_Sys.Write(1, tag, taglen)
        CAD_Sys.Write(1, "\n", 1)
        ReturnValue(0)
    }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== Part Design edges / negatives ===\n", 38)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    fails = 0

    // --- shared sketches ---
    sk_sq = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddRectangle(sk_sq, Float_FromInt(-4), Float_FromInt(-4), Float_FromInt(8), Float_FromInt(8))
    sk_sq2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddRectangle(sk_sq2, Float_FromInt(-6), Float_FromInt(-6), Float_FromInt(12), Float_FromInt(12))
    // triangle (3 verts) for unequal-n loft
    sk_tri = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk_tri, 0, Float_FromInt(5), Float_FromInt(5), Float_FromInt(-3))
    CAD_Sketch.AddLine(sk_tri, Float_FromInt(5), Float_FromInt(-3), Float_FromInt(-5), Float_FromInt(-3))
    CAD_Sketch.AddLine(sk_tri, Float_FromInt(-5), Float_FromInt(-3), 0, Float_FromInt(5))
    CAD_Sketch.BuildClosedLoop(sk_tri)

    zpack = Allocate(32)

    // ========== NEGATIVES (must return 0) ==========
    CAD_Sys.Write(1, "-- negatives --\n", 16)

    // loft unequal loop counts (4 vs 3)
    ArraySet(zpack, 0, 0)
    ArraySet(zpack, 1, Float_FromInt(10))
    h = CAD_Feat.LoftProfiles(sk_sq, sk_tri, zpack)
    fails = Add(fails, ExpectZero(h, "loft_unequal_n", 14))

    // loft equal Z
    ArraySet(zpack, 0, Float_FromInt(5))
    ArraySet(zpack, 1, Float_FromInt(5))
    h = CAD_Feat.LoftProfiles(sk_sq, sk_sq2, zpack)
    fails = Add(fails, ExpectZero(h, "loft_equal_z", 12))

    // loft null sketch
    ArraySet(zpack, 0, 0)
    ArraySet(zpack, 1, Float_FromInt(10))
    h = CAD_Feat.LoftProfiles(0, sk_sq2, zpack)
    fails = Add(fails, ExpectZero(h, "loft_null_bot", 13))
    h = CAD_Feat.LoftProfiles(sk_sq, 0, zpack)
    fails = Add(fails, ExpectZero(h, "loft_null_top", 13))

    // sweep npath < 2
    path = Allocate(96)
    ArraySet(path, 0, 0)
    ArraySet(path, 1, 0)
    ArraySet(path, 2, 0)
    h = CAD_Feat.SweepProfile(sk_sq, path, 1)
    fails = Add(fails, ExpectZero(h, "sweep_npath1", 12))
    h = CAD_Feat.SweepProfile(sk_sq, path, 0)
    fails = Add(fails, ExpectZero(h, "sweep_npath0", 12))

    // sweep pure XY path (no Z change)
    ArraySet(path, 0, 0)
    ArraySet(path, 1, 0)
    ArraySet(path, 2, 0)
    ArraySet(path, 3, Float_FromInt(10))
    ArraySet(path, 4, Float_FromInt(5))
    ArraySet(path, 5, 0)
    h = CAD_Feat.SweepProfile(sk_sq, path, 2)
    fails = Add(fails, ExpectZero(h, "sweep_flat_z", 12))

    // sweep null sketch
    ArraySet(path, 5, Float_FromInt(8))
    h = CAD_Feat.SweepProfile(0, path, 2)
    fails = Add(fails, ExpectZero(h, "sweep_null", 10))

    // pattern count < 1
    box = CAD_Script.CreateBox(Float_FromInt(5), Float_FromInt(5), Float_FromInt(5))
    h = CAD_Feat.LinearPattern(box, Float_FromInt(10), 0, 0, 0)
    fails = Add(fails, ExpectZero(h, "linpat_count0", 13))
    h = CAD_Feat.LinearPattern(box, Float_FromInt(10), 0, 0, -1)
    fails = Add(fails, ExpectZero(h, "linpat_count_neg", 16))
    h = CAD_Feat.CircularPattern(box, 0)
    fails = Add(fails, ExpectZero(h, "circpat_count0", 14))

    // pattern null body
    h = CAD_Feat.LinearPattern(0, Float_FromInt(10), 0, 0, 3)
    fails = Add(fails, ExpectZero(h, "linpat_null", 11))
    h = CAD_Feat.CircularPattern(0, 4)
    fails = Add(fails, ExpectZero(h, "circpat_null", 12))
    h = CAD_Feat.Mirror(0, 0)
    fails = Add(fails, ExpectZero(h, "mirror_null", 11))

    // pattern / mirror of non-kind-0 (cylinder kind 1)
    cyl = CAD_Script.CreateCylinder(Float_FromInt(4), Float_FromInt(10))
    h = CAD_Feat.LinearPattern(cyl, Float_FromInt(12), 0, 0, 3)
    fails = Add(fails, ExpectZero(h, "linpat_kind1", 12))
    h = CAD_Feat.CircularPattern(cyl, 4)
    fails = Add(fails, ExpectZero(h, "circpat_kind1", 13))
    h = CAD_Feat.Mirror(cyl, 0)
    fails = Add(fails, ExpectZero(h, "mirror_kind1", 12))

    // CloneKind0 null / kind1
    h = CAD_Topo.CloneKind0(0)
    fails = Add(fails, ExpectZero(h, "clone_null", 10))
    h = CAD_Topo.CloneKind0(cyl)
    fails = Add(fails, ExpectZero(h, "clone_kind1", 11))

    // ========== EDGE SUCCESSES ==========
    CAD_Sys.Write(1, "-- edge successes --\n", 21)

    // pattern count=1 is identity (returns same handle)
    h = CAD_Feat.LinearPattern(box, Float_FromInt(10), 0, 0, 1)
    IfCondition NotEqual(h, box) ThenBlock: {
        CAD_Sys.Write(1, "EDGE FAIL: linpat count1 not identity\n", 38)
        fails = Add(fails, 1)
    }
    IfCondition EqualTo(h, box) ThenBlock: {
        fails = Add(fails, ExpectSolid(h, "linpat_count1", 13))
    }
    h = CAD_Feat.CircularPattern(box, 1)
    IfCondition NotEqual(h, box) ThenBlock: {
        CAD_Sys.Write(1, "EDGE FAIL: circpat count1 not identity\n", 39)
        fails = Add(fails, 1)
    }
    IfCondition EqualTo(h, box) ThenBlock: {
        fails = Add(fails, ExpectSolid(h, "circpat_count1", 14))
    }

    // multi-segment sweep (3 path pts, each step ΔZ)
    ArraySet(path, 0, 0)
    ArraySet(path, 1, 0)
    ArraySet(path, 2, 0)
    ArraySet(path, 3, Float_FromInt(6))
    ArraySet(path, 4, 0)
    ArraySet(path, 5, Float_FromInt(8))
    ArraySet(path, 6, Float_FromInt(12))
    ArraySet(path, 7, Float_FromInt(4))
    ArraySet(path, 8, Float_FromInt(16))
    sk_sw = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddRectangle(sk_sw, Float_FromInt(-2), Float_FromInt(-2), Float_FromInt(4), Float_FromInt(4))
    sw3 = CAD_Feat.SweepProfile(sk_sw, path, 3)
    fails = Add(fails, ExpectSolid(sw3, "sweep_3seg", 10))
    IfCondition NotEqual(sw3, 0) ThenBlock: {
        CAD_IO.ExportSTEP(sw3, "test-stl/cad_sweep_3seg.stp")
        CAD_View.SetWire(0)
        CAD_View.SetViewMode(0)
        CAD_View.RenderSolidToBMP(sw3, 400, 300, "test-stl/cad_view_sweep_3seg.bmp")
    }

    // valid loft still works after negatives
    ArraySet(zpack, 0, 0)
    ArraySet(zpack, 1, Float_FromInt(12))
    loft = CAD_Feat.LoftProfiles(sk_sq, sk_sq2, zpack)
    fails = Add(fails, ExpectSolid(loft, "loft_ok", 7))
    IfCondition NotEqual(loft, 0) ThenBlock: {
        CAD_IO.ExportSTEP(loft, "test-stl/cad_loft_edge.stp")
    }

    // mirror of diamond (non-box ReflectSolid path)
    sk_d = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk_d, 0, Float_FromInt(4), Float_FromInt(4), 0)
    CAD_Sketch.AddLine(sk_d, Float_FromInt(4), 0, 0, Float_FromInt(-4))
    CAD_Sketch.AddLine(sk_d, 0, Float_FromInt(-4), Float_FromInt(-4), 0)
    CAD_Sketch.AddLine(sk_d, Float_FromInt(-4), 0, 0, Float_FromInt(4))
    CAD_Sketch.BuildClosedLoop(sk_d)
    diam = CAD_Feat.ExtrudeProfile(sk_d, Float_FromInt(6))
    fails = Add(fails, ExpectSolid(diam, "diamond_pad", 11))
    dlt = Allocate(32)
    ArraySet(dlt, 0, Float_FromInt(8))
    ArraySet(dlt, 1, 0)
    ArraySet(dlt, 2, 0)
    CAD_Topo.TranslateSolid(diam, dlt)
    Deallocate(dlt, 32)
    md = CAD_Feat.Mirror(diam, 0)
    fails = Add(fails, ExpectSolid(md, "mirror_diamond", 14))
    IfCondition NotEqual(md, 0) ThenBlock: {
        CAD_IO.ExportSTEP(md, "test-stl/cad_mirror_diamond.stp")
        CAD_View.RenderSolidToBMP(md, 400, 300, "test-stl/cad_view_mirror_diamond.bmp")
    }

    // CloneKind0 of kind-0 box then translate
    c0 = CAD_Topo.CloneKind0(box)
    fails = Add(fails, ExpectSolid(c0, "clone_kind0", 11))
    IfCondition NotEqual(c0, 0) ThenBlock: {
        ArraySet(path, 0, Float_FromInt(20))
        ArraySet(path, 1, 0)
        ArraySet(path, 2, 0)
        CAD_Topo.TranslateSolid(c0, path)
        CAD_IO.ExportSTEP(c0, "test-stl/cad_clone_kind0.stp")
    }

    Deallocate(path, 96)
    Deallocate(zpack, 32)

    IfCondition GreaterThan(fails, 0) ThenBlock: {
        CAD_Sys.Write(1, "PD EDGES FAIL count=", 20)
        CAD_Sys.Write(1, NumberToString(fails), 8)
        CAD_Sys.Write(1, "\n", 1)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PD EDGES OK\n", 12)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
