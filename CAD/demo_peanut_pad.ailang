// Regression: dual-circle peanut outer envelope → Pad must succeed.
// Root cause of extrudefail.png: MakePolyPrism hard-failed at n_pts > 64.
// Tessellated two-circle outer rims routinely have 70–100 verts.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== peanut pad (dense poly prism) ===\n", 39)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    // --- 1) synthetic ring with 80 verts (was hard-fail at 64) ---
    xy = Allocate(4096)
    two_pi = 0x401921FB54442D18
    n80 = 80
    // peanut-ish: radius varies with angle (cardioid-lite)
    i = 0
    WhileLoop LessThan(i, n80) {
        ang = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(n80)))
        // r = 8 + 4*cos(2*ang) → two lobes
        c2 = CAD_Geom.Cos(Float_Mul(0x4000000000000000, ang))
        rad = Float_Add(0x4020000000000000, Float_Mul(0x4010000000000000, c2))
        ArraySet(xy, Multiply(i, 2), Float_Mul(rad, CAD_Geom.Cos(ang)))
        ArraySet(xy, Add(Multiply(i, 2), 1), Float_Mul(rad, CAD_Geom.Sin(ang)))
        i = Add(i, 1)
    }
    out = Allocate(16)
    h = CAD_Topo.MakePolyPrism(xy, n80, 0x4024000000000000, out)
    Deallocate(out, 16)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL MakePolyPrism 80 verts\n", 28)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS MakePolyPrism 80 verts\n", 28)

    // --- 2) large dense ring (cap is 2048) ---
    nbig = 512
    i = 0
    WhileLoop LessThan(i, nbig) {
        ang = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(nbig)))
        rad = 0x4024000000000000
        ArraySet(xy, Multiply(i, 2), Float_Mul(rad, CAD_Geom.Cos(ang)))
        ArraySet(xy, Add(Multiply(i, 2), 1), Float_Mul(rad, CAD_Geom.Sin(ang)))
        i = Add(i, 1)
    }
    out = Allocate(16)
    h2 = CAD_Topo.MakePolyPrism(xy, nbig, 0x4014000000000000, out)
    Deallocate(out, 16)
    IfCondition EqualTo(h2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL MakePolyPrism 512 verts\n", 29)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS MakePolyPrism 512 verts\n", 29)

    // --- 3) ExtrudeProfile via AddProfileXY (app pad path) ---
    sk = CAD_Sketch.CreateSketch(1)
    // two overlapping circles → outer envelope after BuildAllClosedLoops
    CAD_Sketch.AddCircle(sk, 0, 0, 0x4014000000000000)
    CAD_Sketch.AddCircle(sk, 0x4018000000000000, 0, 0x4014000000000000)
    // project like CA_RebuildProfiles
    clone = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(clone, 0, 0, 0x4014000000000000)
    CAD_Sketch.AddCircle(clone, 0x4018000000000000, 0, 0x4014000000000000)
    CAD_Sketch.TessellateCircles(clone, 48)
    CAD_Store.Write(clone, 7, 0)
    nprof = CAD_Sketch.BuildAllClosedLoops(clone)
    IfCondition LessThan(nprof, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no peanut profile\n", 23)
        SystemCall(60, 1, 0, 0)
    }
    // pick densest (outer) profile
    best_i = 0
    best_nn = 0
    pi = 0
    WhileLoop LessThan(pi, nprof) {
        nn = CAD_Sketch.GetProfileXY(clone, pi, xy)
        IfCondition GreaterThan(nn, best_nn) ThenBlock: {
            best_nn = nn
            best_i = pi
        }
        pi = Add(pi, 1)
    }
    nn = CAD_Sketch.GetProfileXY(clone, best_i, xy)
    IfCondition LessThan(nn, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL empty outer ring\n", 22)
        SystemCall(60, 1, 0, 0)
    }
    // report size: if >64, old code would fail pad
    IfCondition GreaterThan(nn, 64) ThenBlock: {
        CAD_Sys.Write(1, "outer ring >64 verts (would have failed old pad)\n", 49)
    }
    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, xy, nn)
    h3 = CAD_Feat.ExtrudeProfile(hsk, 0x4024000000000000)
    IfCondition EqualTo(h3, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL ExtrudeProfile peanut\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS ExtrudeProfile peanut pad\n", 31)

    // --- 4) over-cap decimate path: 300-pt circle ---
    n300 = 300
    i = 0
    WhileLoop LessThan(i, n300) {
        ang = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(n300)))
        rad = 0x4014000000000000
        ArraySet(xy, Multiply(i, 2), Float_Mul(rad, CAD_Geom.Cos(ang)))
        ArraySet(xy, Add(Multiply(i, 2), 1), Float_Mul(rad, CAD_Geom.Sin(ang)))
        i = Add(i, 1)
    }
    hsk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk2, xy, n300)
    h4 = CAD_Feat.ExtrudeProfile(hsk2, 0x4014000000000000)
    IfCondition EqualTo(h4, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL ExtrudeProfile 300-pt decimate\n", 36)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS ExtrudeProfile 300-pt decimate\n", 36)

    Deallocate(xy, 4096)
    CAD_Sys.Write(1, "PEANUT PAD OK\n", 14)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
