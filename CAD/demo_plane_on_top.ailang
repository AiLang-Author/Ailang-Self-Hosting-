// Sketch-on-face: pad base → ray-pick top planar face → pad boss on that plane.
// No AABB faces. Plane from live B-Rep FaceGetPlane.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== Plane on face (B-Rep) demo ===\n", 35)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    // base: 40x30 rect pad h=10
    sk0 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk0, 0, 0, 0x4044000000000000, 0)
    CAD_Sketch.AddLine(sk0, 0x4044000000000000, 0, 0x4044000000000000, 0x403E000000000000)
    CAD_Sketch.AddLine(sk0, 0x4044000000000000, 0x403E000000000000, 0, 0x403E000000000000)
    CAD_Sketch.AddLine(sk0, 0, 0x403E000000000000, 0, 0)
    CAD_Sketch.BuildClosedLoop(sk0)
    base = CAD_Feat.ExtrudeProfile(sk0, 0x4024000000000000)
    IfCondition EqualTo(base, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL base pad\n", 14)
        SystemCall(60, 1, 0, 0)
    }

    // ray from above center down -Z → top face
    ray = Allocate(64)
    ArraySet(ray, 0, 0x4034000000000000)
    ArraySet(ray, 1, 0x402E000000000000)
    ArraySet(ray, 2, 0x4059000000000000)
    ArraySet(ray, 3, 0)
    ArraySet(ray, 4, 0)
    ArraySet(ray, 5, 0xBFF0000000000000)
    outp = Allocate(64)
    ok = CAD_Topo.PickFaceRay(base, ray, outp)
    Deallocate(ray, 64)
    IfCondition EqualTo(ok, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL pick top face\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    face = ArrayGet(outp, 0)
    Deallocate(outp, 64)
    pl = CAD_Plane.CreateFromFace(face, base)
    IfCondition EqualTo(pl, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL plane from face\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    oz = CAD_Plane.OriginZ(pl)
    // top face z should be ~10
    IfCondition EqualTo(CAD_Num.IsEqual(oz, 0x4024000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL plane Z not ~10\n", 21)
        PrintNumber(Float_ToInt(oz))
        PrintMessage("\n")
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "plane from face Z ok\n", 21)

    // boss sketch UV (world XY aligned for +Z face of pad)
    sk1 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.SetPlaneId(sk1, pl)
    CAD_Sketch.AddLine(sk1, 0x402E000000000000, 0x4024000000000000, 0x4039000000000000, 0x4024000000000000)
    CAD_Sketch.AddLine(sk1, 0x4039000000000000, 0x4024000000000000, 0x4039000000000000, 0x4034000000000000)
    CAD_Sketch.AddLine(sk1, 0x4039000000000000, 0x4034000000000000, 0x402E000000000000, 0x4034000000000000)
    CAD_Sketch.AddLine(sk1, 0x402E000000000000, 0x4034000000000000, 0x402E000000000000, 0x4024000000000000)
    CAD_Sketch.BuildClosedLoop(sk1)
    boss = CAD_Feat.ExtrudeOnPlane(sk1, 0x4014000000000000, pl)
    IfCondition EqualTo(boss, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL boss on plane\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    mn = Allocate(32)
    mx = Allocate(32)
    CAD_Topo.SolidBounds(boss, mn, mx)
    z0 = ArrayGet(mn, 2)
    z1 = ArrayGet(mx, 2)
    IfCondition EqualTo(CAD_Num.IsEqual(z0, 0x4024000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL boss zmin\n", 15)
        PrintNumber(Float_ToInt(z0))
        PrintMessage("\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(Float_Le(z1, 0x402C000000000000), 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL boss zmax low\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    Deallocate(mn, 32)
    Deallocate(mx, 32)

    part = CAD_Topo.CompoundAdd(base, boss)
    IfCondition EqualTo(part, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL compound\n", 14)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(part, "test-stl/cad_plane_on_top.stp")
    CAD_View.SetWire(0)
    CAD_View.RenderSolidToBMP(part, 450, 350, "test-stl/cad_view_plane_on_top.bmp")
    CAD_Sys.Write(1, "PLANE ON FACE OK\n", 17)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
