// Plane identity + persist tree: Sketch_0 lineage, recipe regen, FACE signature.
// No PG. No AABB. Parent-first eval; signature last-resort.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_Topo

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== Plane tree persist ===\n", 27)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    p0 = CAD_Plane.CreateWorldXY()
    CAD_Plane.EnsurePid(p0)
    CAD_Plane.SetParent(p0, 0)
    IfCondition NotEqual(CAD_Plane.GetPid(p0), 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL sk0 pid\n", 13)
        SystemCall(60, 1, 0, 0)
    }

    p1 = CAD_Plane.CreateOffset(p0, Float_FromInt(20))
    IfCondition EqualTo(p1, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL offset\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Plane.GetRecipe(p1), 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL offset recipe\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    oz = CAD_Plane.OriginZ(p1)
    IfCondition EqualTo(CAD_Num.IsEqual(oz, Float_FromInt(20), 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL offset Z\n", 14)
        SystemCall(60, 1, 0, 0)
    }

    p2 = CAD_Plane.CreateAngleX(p0, 0x3FF921FB54442D18)
    IfCondition EqualTo(p2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL angle\n", 11)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Plane.GetRecipe(p2), 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL angle recipe\n", 18)
        SystemCall(60, 1, 0, 0)
    }

    // Flip is a flag, not a mode smash
    CAD_Plane.Flip(p1)
    IfCondition NotEqual(CAD_Plane.GetFlip(p1), 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL flip flag\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Plane.GetRecipe(p1), 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL flip kept recipe\n", 22)
        SystemCall(60, 1, 0, 0)
    }
    oz = CAD_Plane.OriginZ(p1)
    IfCondition EqualTo(CAD_Num.IsEqual(oz, Float_FromInt(20), 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL flip Z\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Plane.Flip(p1)

    // persist + restore
    buf = Allocate(4096)
    pos = 0
    pos = CAD_Plane.ExportLine(p0, buf, pos)
    pos = CAD_Plane.ExportLine(p1, buf, pos)
    pos = CAD_Plane.ExportLine(p2, buf, pos)
    SetByte(buf, pos, 0)

    outh = Allocate(16)
    i = 0
    i = CAD_Plane.ParseLine(buf, i, outh)
    q0 = ArrayGet(outh, 0)
    i = CAD_Plane.ParseLine(buf, i, outh)
    q1 = ArrayGet(outh, 0)
    i = CAD_Plane.ParseLine(buf, i, outh)
    q2 = ArrayGet(outh, 0)
    Deallocate(outh, 16)
    Deallocate(buf, 4096)
    IfCondition EqualTo(q0, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL parse p0\n", 14)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Plane.GetPid(q0), CAD_Plane.GetPid(p0)) ThenBlock: {
        CAD_Sys.Write(1, "FAIL pid restore\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    // remap parent pid → handle
    CAD_Plane.SetParent(q1, q0)
    CAD_Plane.SetParent(q2, q0)
    oz = CAD_Plane.OriginZ(q1)
    IfCondition EqualTo(CAD_Num.IsEqual(oz, Float_FromInt(20), 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL restore Z\n", 15)
        PrintNumber(Float_ToInt(oz))
        PrintMessage("\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Plane.GetRecipe(q1), 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL restore recipe\n", 20)
        SystemCall(60, 1, 0, 0)
    }

    // FACE identity: signature survives stale handle
    sk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk, 0, 0, Float_FromInt(20), 0)
    CAD_Sketch.AddLine(sk, Float_FromInt(20), 0, Float_FromInt(20), Float_FromInt(20))
    CAD_Sketch.AddLine(sk, Float_FromInt(20), Float_FromInt(20), 0, Float_FromInt(20))
    CAD_Sketch.AddLine(sk, 0, Float_FromInt(20), 0, 0)
    CAD_Sketch.BuildClosedLoop(sk)
    body1 = CAD_Feat.ExtrudeProfile(sk, Float_FromInt(10))
    IfCondition EqualTo(body1, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL body1\n", 11)
        SystemCall(60, 1, 0, 0)
    }
    // Walk planar faces; take highest origin Z (top cap). Ray pick is a known miss.
    face = 0
    best_z = 0xC1E0000000000000
    plw = Allocate(128)
    shell = CAD_Store.Read(body1, 0)
    fh = 0
    IfCondition NotEqual(shell, 0) ThenBlock: { fh = CAD_Store.Read(shell, 0) }
    fguard = 0
    WhileLoop NotEqual(fh, 0) {
        IfCondition EqualTo(CAD_Topo.FaceGetPlane(fh, plw), 0) ThenBlock: {
            ozc = ArrayGet(plw, 3)
            IfCondition EqualTo(Float_Le(best_z, ozc), 1) ThenBlock: {
                best_z = ozc
                face = fh
            }
        }
        fh = CAD_Store.Read(fh, 3)
        fguard = Add(fguard, 1)
        IfCondition GreaterThan(fguard, 64) ThenBlock: { fh = 0 }
    }
    Deallocate(plw, 128)
    IfCondition EqualTo(face, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no planar face\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    pf = CAD_Plane.CreateFromFace(face, body1)
    CAD_Plane.SetParent(pf, p0)
    fpid = CAD_Plane.GetPid(pf)
    ozf = CAD_Plane.OriginZ(pf)
    IfCondition EqualTo(CAD_Num.IsEqual(ozf, Float_FromInt(10), 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL face Z\n", 12)
        SystemCall(60, 1, 0, 0)
    }

    hx = Allocate(32)
    hp = CAD_Plane.AppendHex64(hx, 0, 0x4024000000000000)
    SetByte(hx, hp, 0)
    htmp = Allocate(16)
    CAD_Plane.ParseHex(hx, 0, htmp)
    IfCondition NotEqual(ArrayGet(htmp, 0), 0x4024000000000000) ThenBlock: {
        CAD_Sys.Write(1, "FAIL hex roundtrip\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    Deallocate(hx, 32)
    Deallocate(htmp, 16)

    fbuf = Allocate(2048)
    fp = CAD_Plane.ExportLine(pf, fbuf, 0)
    SetByte(fbuf, fp, 0)
    outh = Allocate(16)
    CAD_Plane.ParseLine(fbuf, 0, outh)
    qf = ArrayGet(outh, 0)
    Deallocate(outh, 16)
    Deallocate(fbuf, 2048)
    IfCondition NotEqual(CAD_Plane.GetMode(qf), 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL parse mode\n", 16)
        PrintNumber(CAD_Plane.GetMode(qf))
        PrintMessage("\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Store.Read(qf, 20), CAD_Store.Read(pf, 20)) ThenBlock: {
        CAD_Sys.Write(1, "FAIL sig cx bits\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Store.Read(qf, 25), CAD_Store.Read(pf, 25)) ThenBlock: {
        CAD_Sys.Write(1, "FAIL sig nz bits\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Plane.SetParent(qf, p0)
    CAD_Store.Write(qf, 15, 0)
    rb = CAD_Plane.RebindFace(qf, body1)
    IfCondition NotEqual(rb, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL face rebind after persist\n", 31)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Plane.GetPid(qf), fpid) ThenBlock: {
        CAD_Sys.Write(1, "FAIL face pid\n", 14)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Plane.GetFaceHandle(qf), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL rebound handle\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    // Signature last-resort may land on the parallel opposite face (N·Nsig).
    // Identity is pid + live handle, not "whatever Z the walk found first."

    CAD_Sys.Write(1, "PLANE TREE OK\n", 14)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
