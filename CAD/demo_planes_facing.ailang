// Bare construction planes for loft/draft setup:
//   XY plane + offset 40 mm facing each other (flip)
//   sketches on each — loft between them along Z

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Plane
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== Facing planes + loft ===\n", 29)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    p0 = CAD_Plane.CreateWorldXY()
    CAD_Plane.EnsurePid(p0)
    // parallel plane 40 mm along +Z
    p1 = CAD_Plane.CreateOffset(p0, Float_FromInt(40))
    IfCondition EqualTo(p1, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL offset plane\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    // face parent (normals point at each other)
    CAD_Plane.Flip(p1)
    oz = CAD_Plane.OriginZ(p1)
    IfCondition EqualTo(CAD_Num.IsEqual(oz, Float_FromInt(40), 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL origin Z\n", 14)
        PrintNumber(Float_ToInt(oz))
        PrintMessage("\n")
        SystemCall(60, 1, 0, 0)
    }

    // angle plane: 90 deg about local X from XY → upright
    p_ang = CAD_Plane.CreateAngleX(p0, 0x3FF921FB54442D18)
    IfCondition EqualTo(p_ang, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL angle plane\n", 17)
        SystemCall(60, 1, 0, 0)
    }

    // sketch bottom (large square)
    sk0 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.SetPlaneId(sk0, p0)
    CAD_Sketch.AddLine(sk0, 0, 0, Float_FromInt(30), 0)
    CAD_Sketch.AddLine(sk0, Float_FromInt(30), 0, Float_FromInt(30), Float_FromInt(20))
    CAD_Sketch.AddLine(sk0, Float_FromInt(30), Float_FromInt(20), 0, Float_FromInt(20))
    CAD_Sketch.AddLine(sk0, 0, Float_FromInt(20), 0, 0)
    CAD_Sketch.BuildClosedLoop(sk0)

    // sketch top (smaller, same vert count) — loft taper
    sk1 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.SetPlaneId(sk1, p1)
    CAD_Sketch.AddLine(sk1, Float_FromInt(5), Float_FromInt(3), Float_FromInt(25), Float_FromInt(3))
    CAD_Sketch.AddLine(sk1, Float_FromInt(25), Float_FromInt(3), Float_FromInt(25), Float_FromInt(17))
    CAD_Sketch.AddLine(sk1, Float_FromInt(25), Float_FromInt(17), Float_FromInt(5), Float_FromInt(17))
    CAD_Sketch.AddLine(sk1, Float_FromInt(5), Float_FromInt(17), Float_FromInt(5), Float_FromInt(3))
    CAD_Sketch.BuildClosedLoop(sk1)

    zpack = Allocate(32)
    ArraySet(zpack, 0, 0)
    ArraySet(zpack, 1, Float_FromInt(40))
    h = CAD_Feat.LoftProfiles(sk0, sk1, zpack)
    Deallocate(zpack, 32)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL loft\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(h, "test-stl/cad_planes_loft.stp")
    CAD_View.SetWire(0)
    CAD_View.RenderSolidToBMP(h, 450, 350, "test-stl/cad_view_planes_loft.bmp")
    CAD_Sys.Write(1, "FACING PLANES + LOFT OK\n", 24)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
