// Look-at demos: box + cylinder + sphere → STEP (FreeCAD). STEP is primary.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== demo_primitives (STEP look-at) ===\n", 39)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    // 10x20x30 box mm
    dx = 0x4024000000000000
    dy = 0x4034000000000000
    dz = 0x403E000000000000
    hb = CAD_Script.CreateBox(dx, dy, dz)
    CAD_IO.ExportSTEP(hb, "test-stl/cad_box_10x20x30.stp")
    CAD_Sys.Write(1, "wrote cad_box_10x20x30.stp\n", 27)

    // cylinder r=10 h=30 — analytic CIRCLE + CYL surface
    r = 0x4024000000000000
    hgt = 0x403E000000000000
    hc = CAD_Script.CreateCylinder(r, hgt)
    IfCondition EqualTo(hc, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL CreateCylinder\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(hc, "test-stl/cad_cylinder_r10_h30.stp")
    CAD_Sys.Write(1, "wrote cad_cylinder_r10_h30.stp\n", 31)

    // unit box
    one = 0x3FF0000000000000
    hu = CAD_Script.CreateBox(one, one, one)
    CAD_IO.ExportSTEP(hu, "test-stl/cad_box_unit.stp")
    CAD_Sys.Write(1, "wrote cad_box_unit.stp\n", 23)

    // sphere r=10 — analytic 8-octant STEP
    rs = 0x4024000000000000
    hs = CAD_Script.CreateSphere(rs)
    CAD_IO.ExportSTEP(hs, "test-stl/cad_sphere_r10.stp")
    CAD_Sys.Write(1, "wrote cad_sphere_r10.stp\n", 25)

    CAD_Sys.Write(1, "DEMO OK open STEP in FreeCAD\n", 29)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
