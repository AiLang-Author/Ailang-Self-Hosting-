// Look-at demos: box + cylinder → STL (FreeCAD). Real topo+geom+tess.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_IO
// TranslateSolid for placement demo

SubRoutine.Main {
    CAD_Sys.Write(1, "=== demo_primitives (look-at files) ===\n", 40)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    // 10x20x30 box mm
    dx = 0x4024000000000000
    dy = 0x4034000000000000
    dz = 0x403E000000000000
    hb = CAD_Script.CreateBox(dx, dy, dz)
    CAD_Tess.ExportSTL(hb, "test-stl/cad_box_10x20x30.stl")
    CAD_IO.ExportSTEP(hb, "test-stl/cad_box_10x20x30.stp")
    CAD_Sys.Write(1, "wrote cad_box_10x20x30 stl+stp\n", 31)

    // cylinder r=10 h=30 — segments from 0.1mm chordal deflection (not fixed n)
    r = 0x4024000000000000
    hgt = 0x403E000000000000
    hc = CAD_Script.CreateCylinder(r, hgt)
    IfCondition EqualTo(hc, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL CreateCylinder\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    mesh = Allocate(48)
    ntri = CAD_Tess.MeshSolid(hc, 0, mesh)
    CAD_Tess.ExportSTL(hc, "test-stl/cad_cylinder_r10_h30.stl")
    CAD_IO.ExportSTEP(hc, "test-stl/cad_cylinder_r10_h30.stp")
    CAD_Sys.Write(1, "wrote cad_cylinder_r10_h30 stl+stp\n", 35)

    // unit box still handy
    one = 0x3FF0000000000000
    hu = CAD_Script.CreateBox(one, one, one)
    CAD_Tess.ExportSTL(hu, "test-stl/cad_box_unit.stl")
    CAD_IO.ExportSTEP(hu, "test-stl/cad_box_unit.stp")
    CAD_Sys.Write(1, "wrote cad_box_unit stl+stp\n", 26)

    // sphere r=10 at origin, then translate +30x and export once
    rs = 0x4024000000000000
    hs = CAD_Script.CreateSphere(rs)
    CAD_IO.ExportSTEP(hs, "test-stl/cad_sphere_r10.stp")
    dlt = Allocate(32)
    ArraySet(dlt, 0, 0x403E000000000000)
    ArraySet(dlt, 1, 0)
    ArraySet(dlt, 2, 0)
    CAD_Topo.TranslateSolid(hs, dlt)
    CAD_Tess.ExportSTL(hs, "test-stl/cad_sphere_r10.stl")
    CAD_IO.ExportSTEP(hs, "test-stl/cad_sphere_r10_tx30.stp")
    CAD_Sys.Write(1, "wrote cad_sphere_r10 (+tx STEP)\n", 32)

    Deallocate(mesh, 48)
    Deallocate(dlt, 32)
    CAD_Sys.Write(1, "DEMO OK open STLs in FreeCAD\n", 29)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
