// Freehand nearly-closed poly must project as a selectable profile.
// Endpoints intentionally off by ~0.05 (would fail exact IsEqual).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat

SubRoutine.Main {
    CAD_Sys.Write(1, "=== freehand profile project ===\n", 34)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    sk = CAD_Sketch.CreateSketch(1)
    // pentagon-ish, last→first gap ~0.08 on unit-ish coords
    // verts: (0,0) (10,0) (12,5) (5,9) (0,4) ~back near (0,0) with gap
    CAD_Sketch.AddLine(sk, 0, 0, 0x4024000000000000, 0)
    CAD_Sketch.AddLine(sk, 0x4024000000000000, 0, 0x4028000000000000, 0x4014000000000000)
    CAD_Sketch.AddLine(sk, 0x4028000000000000, 0x4014000000000000, 0x4014000000000000, 0x4022000000000000)
    CAD_Sketch.AddLine(sk, 0x4014000000000000, 0x4022000000000000, 0, 0x4010000000000000)
    // close with small gap: end at (0.05, 0.04) instead of (0,0)
    CAD_Sketch.AddLine(sk, 0, 0x4010000000000000, 0x3FA999999999999A, 0x3FA47AE147AE147B)

    n = CAD_Sketch.BuildAllClosedLoops(sk)
    IfCondition LessThan(n, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no profile on near-closed freehand\n", 40)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS freehand near-closed projected\n", 36)

    // exact closed rect still works
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk2, 0, 0, 0x4024000000000000, 0)
    CAD_Sketch.AddLine(sk2, 0x4024000000000000, 0, 0x4024000000000000, 0x4024000000000000)
    CAD_Sketch.AddLine(sk2, 0x4024000000000000, 0x4024000000000000, 0, 0x4024000000000000)
    CAD_Sketch.AddLine(sk2, 0, 0x4024000000000000, 0, 0)
    n2 = CAD_Sketch.BuildAllClosedLoops(sk2)
    IfCondition LessThan(n2, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL exact rect\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS exact rect\n", 16)

    CAD_Sys.Write(1, "PROFILE PROJECT OK\n", 19)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
