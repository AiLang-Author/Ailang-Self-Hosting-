// Rectangle outer + circle hole. Caps must exist; hole must stay empty.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== rect + circle hole ===\n", 28)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = 0x4034000000000000
    xy = Allocate(64)
    w = 0x4044000000000000
    ArraySet(xy, 0, Float_Sub(0, w))
    ArraySet(xy, 1, Float_Sub(0, w))
    ArraySet(xy, 2, w)
    ArraySet(xy, 3, Float_Sub(0, w))
    ArraySet(xy, 4, w)
    ArraySet(xy, 5, w)
    ArraySet(xy, 6, Float_Sub(0, w))
    ArraySet(xy, 7, w)
    CAD_Topo.SweepAddPoly(xy, 4)
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddArc(0, 0, 0x4034000000000000, 0, 0x401921FB54442D18)
    PrintMessage("ncont=")
    PrintNumber(CAD_Topo_Sweep.ncont)
    PrintMessage("\n")
    h = CAD_Topo.ExtrudeContours()
    PrintMessage("solid=")
    PrintNumber(h)
    PrintMessage("\n")
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    sh = CAD_Store.Read(h, 0)
    fi = 0
    WhileLoop NotEqual(sh, 0) {
        fc = CAD_Store.Read(sh, 0)
        WhileLoop NotEqual(fc, 0) {
            lp = CAD_Store.Read(fc, 1)
            nce = 0
            ni = 0
            IfCondition NotEqual(lp, 0) ThenBlock: {
                nce = CAD_Topo.LoopCountCoedges(lp)
                inn = CAD_Store.Read(lp, 2)
                IfCondition NotEqual(inn, 0) ThenBlock: {
                    ni = CAD_Topo.LoopCountCoedges(inn)
                }
            }
            PrintMessage("face ")
            PrintNumber(fi)
            PrintMessage(" nce=")
            PrintNumber(nce)
            PrintMessage(" inner_nce=")
            PrintNumber(ni)
            PrintMessage("\n")
            fi = Add(fi, 1)
            fc = CAD_Store.Read(fc, 3)
            IfCondition GreaterThan(fi, 32) ThenBlock: { fc = 0 }
        }
        sh = 0
    }
    mesh = Allocate(32)
    nt = CAD_Tess.MeshSolid(h, 0x3FB999999999999A, mesh)
    PrintMessage("mesh nt=")
    PrintNumber(nt)
    PrintMessage(" nv=")
    PrintNumber(ArrayGet(mesh, 0))
    PrintMessage("\n")
    IfCondition LessThan(nt, 20) ThenBlock: {
        CAD_Sys.Write(1, "FAIL too few tris\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "DONE\n", 5)
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
