// Rect plate + regular octagon hole. Checks cap tess: no triangles
// whose centroid sits inside the hole, some in the plate corners.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== rect+octagon hole tess ===\n", 31)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    outer = Allocate(128)
    n40 = 0x4044000000000000
    n25 = 0x4039000000000000
    n0 = 0
    ArraySet(outer, 0, Float_Sub(n0, n40))
    ArraySet(outer, 1, Float_Sub(n0, n25))
    ArraySet(outer, 2, n40)
    ArraySet(outer, 3, Float_Sub(n0, n25))
    ArraySet(outer, 4, n40)
    ArraySet(outer, 5, n25)
    ArraySet(outer, 6, Float_Sub(n0, n40))
    ArraySet(outer, 7, n25)

    hole = Allocate(1024)
    nh = 8
    two_pi = 0x401921FB54442D18
    rad = 0x402E000000000000
    i = 0
    WhileLoop LessThan(i, nh) {
        th = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(nh)))
        ArraySet(hole, Multiply(i, 2), Float_Mul(rad, CAD_Geom.Cos(th)))
        ArraySet(hole, Add(Multiply(i, 2), 1), Float_Mul(rad, CAD_Geom.Sin(th)))
        i = Add(i, 1)
    }

    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, outer, 4)
    CAD_Sketch.AddProfileXY(hsk, hole, nh)
    PrintMessage("nprof=")
    PrintNumber(CAD_Store.Read(hsk, 12))
    PrintMessage("\n")

    hz = 0x4034000000000000
    h = CAD_Feat.ExtrudeProfile(hsk, hz)
    PrintMessage("solid=")
    PrintNumber(h)
    PrintMessage("\n")
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }

    mesh = Allocate(32)
    nt = CAD_Tess.MeshSolid(h, 0x3FB999999999999A, mesh)
    PrintMessage("mesh nt=")
    PrintNumber(nt)
    PrintMessage(" nv=")
    PrintNumber(ArrayGet(mesh, 0))
    PrintMessage("\n")

    cnt = Allocate(256)
    ArraySet(cnt, 0, 0)
    ArraySet(cnt, 1, 0)
    ArraySet(cnt, 2, 0)
    ArraySet(cnt, 3, nt)
    ArraySet(cnt, 4, ArrayGet(mesh, 2))
    ArraySet(cnt, 5, ArrayGet(mesh, 3))
    ArraySet(cnt, 6, hz)
    ArraySet(cnt, 7, 0x3F847AE147AE147B)
    ArraySet(cnt, 8, 0x4008000000000000)
    ArraySet(cnt, 9, Float_Mul(0x4028000000000000, 0x4028000000000000))
    ArraySet(cnt, 10, 0)
    ArraySet(cnt, 13, 0)
    ArraySet(cnt, 14, outer)
    ArraySet(cnt, 15, hole)
    ArraySet(cnt, 16, mesh)
    ArraySet(cnt, 17, two_pi)
    ArraySet(cnt, 18, rad)
    WhileLoop LessThan(ArrayGet(cnt, 10), ArrayGet(cnt, 3)) {
        t = ArrayGet(cnt, 10)
        v_base = ArrayGet(cnt, 4)
        i_base = ArrayGet(cnt, 5)
        i0 = ArrayGet(i_base, Multiply(t, 3))
        i1 = ArrayGet(i_base, Add(Multiply(t, 3), 1))
        i2 = ArrayGet(i_base, Add(Multiply(t, 3), 2))
        z0 = ArrayGet(v_base, Add(Multiply(i0, 3), 2))
        z1 = ArrayGet(v_base, Add(Multiply(i1, 3), 2))
        z2 = ArrayGet(v_base, Add(Multiply(i2, 3), 2))
        d0 = Float_Sub(z0, ArrayGet(cnt, 6))
        IfCondition EqualTo(CAD_Num.IsNeg(d0), 1) ThenBlock: { d0 = Float_Sub(0, d0) }
        d1 = Float_Sub(z1, ArrayGet(cnt, 6))
        IfCondition EqualTo(CAD_Num.IsNeg(d1), 1) ThenBlock: { d1 = Float_Sub(0, d1) }
        d2 = Float_Sub(z2, ArrayGet(cnt, 6))
        IfCondition EqualTo(CAD_Num.IsNeg(d2), 1) ThenBlock: { d2 = Float_Sub(0, d2) }
        IfCondition EqualTo(Float_Le(d0, ArrayGet(cnt, 7)), 1) ThenBlock: {
            IfCondition EqualTo(Float_Le(d1, ArrayGet(cnt, 7)), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(d2, ArrayGet(cnt, 7)), 1) ThenBlock: {
                    ArraySet(cnt, 0, Add(ArrayGet(cnt, 0), 1))
                    v_base = ArrayGet(cnt, 4)
                    i_base = ArrayGet(cnt, 5)
                    t = ArrayGet(cnt, 10)
                    i0 = ArrayGet(i_base, Multiply(t, 3))
                    i1 = ArrayGet(i_base, Add(Multiply(t, 3), 1))
                    i2 = ArrayGet(i_base, Add(Multiply(t, 3), 2))
                    ArraySet(cnt, 11, Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Multiply(i0, 3)), ArrayGet(v_base, Multiply(i1, 3))), ArrayGet(v_base, Multiply(i2, 3))), ArrayGet(cnt, 8)))
                    ArraySet(cnt, 12, Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Add(Multiply(i0, 3), 1)), ArrayGet(v_base, Add(Multiply(i1, 3), 1))), ArrayGet(v_base, Add(Multiply(i2, 3), 1))), ArrayGet(cnt, 8)))
                    d2p = Float_Add(Float_Mul(ArrayGet(cnt, 11), ArrayGet(cnt, 11)), Float_Mul(ArrayGet(cnt, 12), ArrayGet(cnt, 12)))
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d2p, ArrayGet(cnt, 9))), 1) ThenBlock: {
                        ArraySet(cnt, 1, Add(ArrayGet(cnt, 1), 1))
                    }
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(ArrayGet(cnt, 11), 0x4034000000000000)), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(ArrayGet(cnt, 12), 0x4024000000000000)), 0) ThenBlock: {
                            ArraySet(cnt, 2, Add(ArrayGet(cnt, 2), 1))
                        }
                    }
                }
            }
        }
        ArraySet(cnt, 10, Add(ArrayGet(cnt, 10), 1))
    }
    PrintMessage("top=")
    PrintNumber(ArrayGet(cnt, 0))
    PrintMessage(" in_hole=")
    PrintNumber(ArrayGet(cnt, 1))
    PrintMessage(" corner=")
    PrintNumber(ArrayGet(cnt, 2))
    PrintMessage("\n")
    IfCondition EqualTo(ArrayGet(cnt, 1), 0) ThenBlock: {
        IfCondition GreaterThan(ArrayGet(cnt, 2), 0) ThenBlock: {
            IfCondition GreaterThan(ArrayGet(cnt, 0), 3) ThenBlock: {
                ArraySet(cnt, 13, 1)
            }
        }
    }
    IfCondition EqualTo(ArrayGet(cnt, 13), 1) ThenBlock: {
        CAD_Sys.Write(1, "PASS rect+oct hole\n", 19)
    }
    IfCondition EqualTo(ArrayGet(cnt, 13), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL rect+oct hole\n", 19)
        SystemCall(60, 1, 0, 0)
    }

    // same plate, 32-gon circle hole — same failure mode as octagon
    CAD_Sys.Write(1, "=== rect+circle hole tess ===\n", 30)
    ArraySet(cnt, 19, 0)
    WhileLoop LessThan(ArrayGet(cnt, 19), 32) {
        ArraySet(cnt, 20, Float_Mul(ArrayGet(cnt, 17), Float_Div(Float_FromInt(ArrayGet(cnt, 19)), Float_FromInt(32))))
        ArraySet(ArrayGet(cnt, 15), Multiply(ArrayGet(cnt, 19), 2), Float_Mul(ArrayGet(cnt, 18), CAD_Geom.Cos(ArrayGet(cnt, 20))))
        ArraySet(ArrayGet(cnt, 15), Add(Multiply(ArrayGet(cnt, 19), 2), 1), Float_Mul(ArrayGet(cnt, 18), CAD_Geom.Sin(ArrayGet(cnt, 20))))
        ArraySet(cnt, 19, Add(ArrayGet(cnt, 19), 1))
    }
    hsk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddProfileXY(hsk, ArrayGet(cnt, 14), 4)
    CAD_Sketch.AddProfileXY(hsk, ArrayGet(cnt, 15), 32)
    h = CAD_Feat.ExtrudeProfile(hsk, ArrayGet(cnt, 6))
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circle extrude\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    nt = CAD_Tess.MeshSolid(h, 0x3FB999999999999A, ArrayGet(cnt, 16))
    mesh = ArrayGet(cnt, 16)
    PrintMessage("circ mesh nt=")
    PrintNumber(nt)
    PrintMessage("\n")
    ArraySet(cnt, 0, 0)
    ArraySet(cnt, 1, 0)
    ArraySet(cnt, 2, 0)
    ArraySet(cnt, 3, nt)
    ArraySet(cnt, 4, ArrayGet(mesh, 2))
    ArraySet(cnt, 5, ArrayGet(mesh, 3))
    ArraySet(cnt, 10, 0)
    WhileLoop LessThan(ArrayGet(cnt, 10), ArrayGet(cnt, 3)) {
        t = ArrayGet(cnt, 10)
        v_base = ArrayGet(cnt, 4)
        i_base = ArrayGet(cnt, 5)
        i0 = ArrayGet(i_base, Multiply(t, 3))
        i1 = ArrayGet(i_base, Add(Multiply(t, 3), 1))
        i2 = ArrayGet(i_base, Add(Multiply(t, 3), 2))
        z0 = ArrayGet(v_base, Add(Multiply(i0, 3), 2))
        z1 = ArrayGet(v_base, Add(Multiply(i1, 3), 2))
        z2 = ArrayGet(v_base, Add(Multiply(i2, 3), 2))
        d0 = Float_Sub(z0, ArrayGet(cnt, 6))
        IfCondition EqualTo(CAD_Num.IsNeg(d0), 1) ThenBlock: { d0 = Float_Sub(0, d0) }
        d1 = Float_Sub(z1, ArrayGet(cnt, 6))
        IfCondition EqualTo(CAD_Num.IsNeg(d1), 1) ThenBlock: { d1 = Float_Sub(0, d1) }
        d2 = Float_Sub(z2, ArrayGet(cnt, 6))
        IfCondition EqualTo(CAD_Num.IsNeg(d2), 1) ThenBlock: { d2 = Float_Sub(0, d2) }
        IfCondition EqualTo(Float_Le(d0, ArrayGet(cnt, 7)), 1) ThenBlock: {
            IfCondition EqualTo(Float_Le(d1, ArrayGet(cnt, 7)), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(d2, ArrayGet(cnt, 7)), 1) ThenBlock: {
                    ArraySet(cnt, 0, Add(ArrayGet(cnt, 0), 1))
                    v_base = ArrayGet(cnt, 4)
                    i_base = ArrayGet(cnt, 5)
                    t = ArrayGet(cnt, 10)
                    i0 = ArrayGet(i_base, Multiply(t, 3))
                    i1 = ArrayGet(i_base, Add(Multiply(t, 3), 1))
                    i2 = ArrayGet(i_base, Add(Multiply(t, 3), 2))
                    ArraySet(cnt, 11, Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Multiply(i0, 3)), ArrayGet(v_base, Multiply(i1, 3))), ArrayGet(v_base, Multiply(i2, 3))), ArrayGet(cnt, 8)))
                    ArraySet(cnt, 12, Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Add(Multiply(i0, 3), 1)), ArrayGet(v_base, Add(Multiply(i1, 3), 1))), ArrayGet(v_base, Add(Multiply(i2, 3), 1))), ArrayGet(cnt, 8)))
                    d2p = Float_Add(Float_Mul(ArrayGet(cnt, 11), ArrayGet(cnt, 11)), Float_Mul(ArrayGet(cnt, 12), ArrayGet(cnt, 12)))
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d2p, ArrayGet(cnt, 9))), 1) ThenBlock: {
                        ArraySet(cnt, 1, Add(ArrayGet(cnt, 1), 1))
                    }
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(ArrayGet(cnt, 11), 0x4034000000000000)), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(ArrayGet(cnt, 12), 0x4024000000000000)), 0) ThenBlock: {
                            ArraySet(cnt, 2, Add(ArrayGet(cnt, 2), 1))
                        }
                    }
                }
            }
        }
        ArraySet(cnt, 10, Add(ArrayGet(cnt, 10), 1))
    }
    PrintMessage("circ top=")
    PrintNumber(ArrayGet(cnt, 0))
    PrintMessage(" in_hole=")
    PrintNumber(ArrayGet(cnt, 1))
    PrintMessage(" corner=")
    PrintNumber(ArrayGet(cnt, 2))
    PrintMessage("\n")
    IfCondition EqualTo(ArrayGet(cnt, 1), 0) ThenBlock: {
        IfCondition GreaterThan(ArrayGet(cnt, 2), 0) ThenBlock: {
            IfCondition GreaterThan(ArrayGet(cnt, 0), 3) ThenBlock: {
                CAD_Sys.Write(1, "PASS rect+circ hole\n", 20)
                SystemCall(60, 0, 0, 0)
            }
        }
    }
    CAD_Sys.Write(1, "FAIL rect+circ hole\n", 20)
    SystemCall(60, 1, 0, 0)
}
RunTask(Main)
