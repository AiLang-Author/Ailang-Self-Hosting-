// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== centered rect plex ===\n", 28)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    z = 0
    n25 = 0x4039000000000000
    n50 = 0x4049000000000000
    xy = Allocate(32)

    sk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk, Float_Sub(0, n25), Float_Sub(0, n25), n25, Float_Sub(0, n25))
    CAD_Sketch.AddLine(sk, n25, Float_Sub(0, n25), n25, n25)
    CAD_Sketch.AddLine(sk, n25, n25, Float_Sub(0, n25), n25)
    CAD_Sketch.AddLine(sk, Float_Sub(0, n25), n25, Float_Sub(0, n25), Float_Sub(0, n25))
    CAD_Sketch.RebuildAnchors(sk)
    n = CAD_Sketch.ProfCompile(sk)
    CAD_Sys.Write(1, "A centered nl=", 15)
    PrintNumber(CAD_Sketch.GetLineCount(sk))
    CAD_Sys.Write(1, " nprof=", 7)
    PrintNumber(n)
    CAD_Sys.Write(1, " nseg=", 6)
    PrintNumber(CAD_Sketch.SketchPlexPathCount(0))
    CAD_Sys.Write(1, "\n", 1)
    k = 0
    np = CAD_Sketch.SketchPlexPathCount(0)
    WhileLoop LessThan(k, np) {
        kind = CAD_Sketch.SketchPlexPathSeg(0, k)
        CAD_Sys.Write(1, "  A seg k=", 10)
        PrintNumber(kind)
        CAD_Sys.Write(1, " x0=", 4)
        PrintNumber(Float_ToInt(CAD_SPlex.x0))
        CAD_Sys.Write(1, " y0=", 4)
        PrintNumber(Float_ToInt(CAD_SPlex.y0))
        CAD_Sys.Write(1, " x1=", 4)
        PrintNumber(Float_ToInt(CAD_SPlex.x1))
        CAD_Sys.Write(1, " y1=", 4)
        PrintNumber(Float_ToInt(CAD_SPlex.y1))
        CAD_Sys.Write(1, "\n", 1)
        k = Add(k, 1)
    }
    IfCondition NotEqual(np, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL centered rect split\n", 25)
        SystemCall(60, 1, 0, 0)
    }

    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk2, z, z, n50, z)
    CAD_Sketch.AddLine(sk2, n50, z, n50, n50)
    CAD_Sketch.AddLine(sk2, n50, n50, z, n50)
    CAD_Sketch.AddLine(sk2, z, n50, z, z)
    CAD_Sketch.RebuildAnchors(sk2)
    n = CAD_Sketch.ProfCompile(sk2)
    CAD_Sys.Write(1, "B corner nl=", 13)
    PrintNumber(CAD_Sketch.GetLineCount(sk2))
    CAD_Sys.Write(1, " nprof=", 7)
    PrintNumber(n)
    CAD_Sys.Write(1, " nseg=", 6)
    PrintNumber(CAD_Sketch.SketchPlexPathCount(0))
    CAD_Sys.Write(1, "\n", 1)
    k = 0
    np = CAD_Sketch.SketchPlexPathCount(0)
    WhileLoop LessThan(k, np) {
        kind = CAD_Sketch.SketchPlexPathSeg(0, k)
        CAD_Sys.Write(1, "  B seg k=", 10)
        PrintNumber(kind)
        CAD_Sys.Write(1, " x0=", 4)
        PrintNumber(Float_ToInt(CAD_SPlex.x0))
        CAD_Sys.Write(1, " y0=", 4)
        PrintNumber(Float_ToInt(CAD_SPlex.y0))
        CAD_Sys.Write(1, " x1=", 4)
        PrintNumber(Float_ToInt(CAD_SPlex.x1))
        CAD_Sys.Write(1, " y1=", 4)
        PrintNumber(Float_ToInt(CAD_SPlex.y1))
        CAD_Sys.Write(1, "\n", 1)
        k = Add(k, 1)
    }
    IfCondition NotEqual(np, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL corner rect split\n", 23)
        SystemCall(60, 1, 0, 0)
    }

    Deallocate(xy, 32)
    CAD_Sys.Write(1, "RECT PLEX OK\n", 13)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
