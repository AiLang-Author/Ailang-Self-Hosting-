// Rectangular pocket: box − box tool via CreateRectPocket → B-Rep walk STEP.
// Blind from top + through variant.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== rect pocket B-Rep STEP ===\n", 31)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    // plate 50 x 40 x 12
    dx = 0x4049000000000000
    dy = 0x4044000000000000
    dz = 0x4028000000000000
    body = CAD_Script.CreateBox(dx, dy, dz)
    pack = Allocate(48)
    tool_out = Allocate(16)
    // blind pocket [15,15]→[35,25] depth 6 from top
    ArraySet(pack, 0, 0x402E000000000000)
    ArraySet(pack, 1, 0x402E000000000000)
    ArraySet(pack, 2, 0x4041800000000000)
    ArraySet(pack, 3, 0x4039000000000000)
    ArraySet(pack, 4, 0x4018000000000000)
    cut = CAD_Feat.CreateRectPocket(body, pack, tool_out)
    IfCondition EqualTo(cut, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL rect pocket cut\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Store.Read(cut, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL rect pocket no shell\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(cut, "test-stl/cad_plate_rect_pocket.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL rect pocket STEP\n", 22)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote rect-pocket.stp (blind)\n", 30)

    // through pocket on fresh plate
    body2 = CAD_Script.CreateBox(dx, dy, dz)
    ArraySet(pack, 4, dz)
    cut2 = CAD_Feat.CreateRectPocket(body2, pack, tool_out)
    IfCondition EqualTo(cut2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL through pocket\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(cut2, "test-stl/cad_plate_rect_through.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL through pocket STEP\n", 25)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote rect-through.stp\n", 23)

    Deallocate(pack, 48)
    Deallocate(tool_out, 16)
    CAD_Sys.Write(1, "RECT POCKET BREP OK\n", 20)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
