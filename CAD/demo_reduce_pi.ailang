LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.Near {
    Input: a_r: Integer
    Input: b_r: Integer
    Input: tol_r: Integer
    Output: Integer
    Body: {
        d = Float_Sub(a_r, b_r)
        IfCondition EqualTo(CAD_Num.IsNeg(d), 1) ThenBlock: {
            d = Float_Sub(0, d)
        }
        ReturnValue(Float_Le(d, tol_r))
    }
}

Function.Fail {
    Input: msg_addr: Address
    Input: n: Integer
    Output: Integer
    Body: {
        CAD_Sys.Write(1, msg_addr, n)
        SystemCall(60, 1, 0, 0)
        ReturnValue(0)
    }
}

Function.CheckUnit {
    Input: a_r: Integer
    Input: label: Address
    Input: n: Integer
    Output: Integer
    Body: {
        one = 0x3FF0000000000000
        slop = 0x3F50624DD2F1A9FC
        IfCondition EqualTo(Float_Le(CAD_Num.Abs(a_r), Float_Add(one, slop)), 0) ThenBlock: {
            CAD_Sys.Write(1, label, n)
            Fail(" FAIL |trig|>1\n", 16)
        }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    CAD_Num.InitTolerance(0, 0)
    one = 0x3FF0000000000000
    four = 0x4010000000000000
    ten = 0x4024000000000000
    mfour = Float_Sub(0, four)
    mten = Float_Sub(0, ten)
    pi = 0x400921FB54442D18
    mpi = Float_Sub(0, pi)
    tol = 0x3F50624DD2F1A9FC

    CAD_Sys.Write(1, "=== ReducePi / Cos / Sin orbit range ===\n", 41)

    r = CAD_Geom.ReducePi(mfour)
    IfCondition EqualTo(Float_Le(CAD_Num.Abs(r), pi), 0) ThenBlock: {
        Fail("FAIL ReducePi(-4) not in [-pi,pi]\n", 34)
    }
    CAD_Sys.Write(1, "PASS ReducePi(-4) in [-pi,pi]\n", 30)

    r = CAD_Geom.ReducePi(mten)
    IfCondition EqualTo(Float_Le(CAD_Num.Abs(r), pi), 0) ThenBlock: {
        Fail("FAIL ReducePi(-10) not in [-pi,pi]\n", 35)
    }
    CAD_Sys.Write(1, "PASS ReducePi(-10) in [-pi,pi]\n", 31)

    c = CAD_Geom.Cos(mfour)
    s = CAD_Geom.Sin(mfour)
    CheckUnit(c, "cos(-4)", 7)
    CheckUnit(s, "sin(-4)", 7)
    n2 = Float_Add(Float_Mul(c, c), Float_Mul(s, s))
    IfCondition EqualTo(Near(n2, one, 0x3F847AE147AE147B), 0) ThenBlock: {
        Fail("FAIL cos^2+sin^2 (-4)\n", 22)
    }
    CAD_Sys.Write(1, "PASS Cos/Sin(-4) unit\n", 22)

    c = CAD_Geom.Cos(mten)
    s = CAD_Geom.Sin(mten)
    CheckUnit(c, "cos(-10)", 8)
    CheckUnit(s, "sin(-10)", 8)
    n2 = Float_Add(Float_Mul(c, c), Float_Mul(s, s))
    IfCondition EqualTo(Near(n2, one, 0x3F847AE147AE147B), 0) ThenBlock: {
        Fail("FAIL cos^2+sin^2 (-10)\n", 23)
    }
    CAD_Sys.Write(1, "PASS Cos/Sin(-10) unit\n", 23)

    c = CAD_Geom.Cos(mpi)
    IfCondition EqualTo(Near(c, Float_Sub(0, one), 0x3F847AE147AE147B), 0) ThenBlock: {
        Fail("FAIL Cos(-pi) != -1\n", 20)
    }
    CAD_Sys.Write(1, "PASS Cos(-pi) ~ -1\n", 19)

    CAD_Sys.Write(1, "ALL PASS\n", 9)
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
