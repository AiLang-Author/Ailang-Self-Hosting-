// Regenerate all CAD look-at STEP fixtures under test-stl/.
// Run after deleting old models for a clean FreeCAD pass.
// Note: each child path is inlined (no process spawn) — calls same APIs.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== regen all CAD STEP fixtures ===\n", 37)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(8192)

    pack = Allocate(64)
    tool_out = Allocate(16)
    out = Allocate(16)
    mn = Allocate(32)
    mx = Allocate(32)
    dlt = Allocate(32)

    // primitives
    hb = CAD_Script.CreateBox(0x4024000000000000, 0x4034000000000000, 0x403E000000000000)
    IfCondition NotEqual(CAD_IO.ExportSTEP(hb, "test-stl/cad_box_10x20x30.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL box\n", 9)
        SystemCall(60, 1, 0, 0)
    }
    hc = CAD_Script.CreateCylinder(0x4024000000000000, 0x403E000000000000)
    IfCondition NotEqual(CAD_IO.ExportSTEP(hc, "test-stl/cad_cylinder_r10_h30.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL cyl\n", 9)
        SystemCall(60, 1, 0, 0)
    }
    hu = CAD_Script.CreateBox(0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000)
    CAD_IO.ExportSTEP(hu, "test-stl/cad_box_unit.stp")
    hs = CAD_Script.CreateSphere(0x4024000000000000)
    IfCondition NotEqual(CAD_IO.ExportSTEP(hs, "test-stl/cad_sphere_r10.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL sphere\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "primitives ok\n", 14)

    // through hole Z
    body = CAD_Script.CreateBox(0x4044000000000000, 0x4044000000000000, 0x4024000000000000)
    ArraySet(pack, 0, 0x4020000000000000)
    ArraySet(pack, 1, 0x403C000000000000)
    ArraySet(pack, 2, 0x4028000000000000)
    ArraySet(pack, 3, 0x403C000000000000)
    cut = CAD_Feat.CreateHole(body, pack, tool_out)
    CAD_IO.ExportSTEP(cut, "test-stl/cad_plate_hole_offset.stp")

    // blind Z
    body = CAD_Script.CreateBox(0x4044000000000000, 0x4044000000000000, 0x4024000000000000)
    ArraySet(pack, 0, 0x4020000000000000)
    ArraySet(pack, 1, 0x4018000000000000)
    ArraySet(pack, 2, 0x4028000000000000)
    ArraySet(pack, 3, 0x403C000000000000)
    cut = CAD_Feat.CreateHole(body, pack, tool_out)
    CAD_IO.ExportSTEP(cut, "test-stl/cad_plate_blind_pocket.stp")

    // multi
    body = CAD_Script.CreateBox(0x4049000000000000, 0x4044000000000000, 0x4020000000000000)
    ArraySet(pack, 0, 0x4020000000000000)
    ArraySet(pack, 1, 0x4020000000000000)
    ArraySet(pack, 2, 0x402E000000000000)
    ArraySet(pack, 3, 0x4034000000000000)
    cut = CAD_Feat.CreateHole(body, pack, tool_out)
    ArraySet(pack, 0, 0x4018000000000000)
    ArraySet(pack, 1, 0x4010000000000000)
    ArraySet(pack, 2, 0x4041800000000000)
    ArraySet(pack, 3, 0x402E000000000000)
    cut = CAD_Feat.CreateHole(cut, pack, tool_out)
    CAD_IO.ExportSTEP(cut, "test-stl/cad_plate_multi_hole.stp")

    // counterbore
    body = CAD_Script.CreateBox(0x4044000000000000, 0x4044000000000000, 0x4028000000000000)
    ArraySet(pack, 0, 0x4018000000000000)
    ArraySet(pack, 1, 0x4028000000000000)
    ArraySet(pack, 2, 0x4034000000000000)
    ArraySet(pack, 3, 0x4034000000000000)
    cut = CAD_Feat.CreateHole(body, pack, tool_out)
    ArraySet(pack, 0, 0x4028000000000000)
    ArraySet(pack, 1, 0x4010000000000000)
    ArraySet(pack, 2, 0x4034000000000000)
    ArraySet(pack, 3, 0x4034000000000000)
    cut = CAD_Feat.CreateHole(cut, pack, tool_out)
    CAD_IO.ExportSTEP(cut, "test-stl/cad_counterbore.stp")
    CAD_Sys.Write(1, "holes ok\n", 9)

    // rect pocket blind + through
    body = CAD_Script.CreateBox(0x4049000000000000, 0x4044000000000000, 0x4028000000000000)
    ArraySet(pack, 0, 0x402E000000000000)
    ArraySet(pack, 1, 0x402E000000000000)
    ArraySet(pack, 2, 0x4041800000000000)
    ArraySet(pack, 3, 0x4039000000000000)
    ArraySet(pack, 4, 0x4018000000000000)
    cut = CAD_Feat.CreateRectPocket(body, pack, tool_out)
    CAD_IO.ExportSTEP(cut, "test-stl/cad_plate_rect_pocket.stp")
    body = CAD_Script.CreateBox(0x4049000000000000, 0x4044000000000000, 0x4028000000000000)
    ArraySet(pack, 4, 0x4028000000000000)
    cut = CAD_Feat.CreateRectPocket(body, pack, tool_out)
    CAD_IO.ExportSTEP(cut, "test-stl/cad_plate_rect_through.stp")
    CAD_Sys.Write(1, "rect pocket ok\n", 15)

    // union
    a = CAD_Script.CreateBox(0x4034000000000000, 0x4034000000000000, 0x4024000000000000)
    ArraySet(mn, 0, 0x4034000000000000)
    ArraySet(mn, 1, 0)
    ArraySet(mn, 2, 0)
    ArraySet(mx, 0, 0x4044000000000000)
    ArraySet(mx, 1, 0x4034000000000000)
    ArraySet(mx, 2, 0x4024000000000000)
    b = CAD_Topo.MakeBoxSolid(mn, mx, out)
    u = CAD_Bool.Union(a, b)
    CAD_IO.ExportSTEP(u, "test-stl/cad_union_boxes.stp")
    CAD_Sys.Write(1, "union ok\n", 9)

    // side X/Y
    body = CAD_Script.CreateBox(0x4044000000000000, 0x4044000000000000, 0x4034000000000000)
    ArraySet(pack, 0, 0x4020000000000000)
    ArraySet(pack, 1, 0x4044000000000000)
    ArraySet(pack, 2, 0x4034000000000000)
    ArraySet(pack, 3, 0x4024000000000000)
    cut = CAD_Feat.CreateSideHoleX(body, pack, tool_out)
    CAD_IO.ExportSTEP(cut, "test-stl/cad_side_hole_through.stp")
    body = CAD_Script.CreateBox(0x4044000000000000, 0x4044000000000000, 0x4034000000000000)
    ArraySet(pack, 1, 0x402E000000000000)
    cut = CAD_Feat.CreateSideHoleX(body, pack, tool_out)
    CAD_IO.ExportSTEP(cut, "test-stl/cad_side_hole_blind.stp")
    body = CAD_Script.CreateBox(0x4044000000000000, 0x4044000000000000, 0x4034000000000000)
    ArraySet(pack, 1, 0x4044000000000000)
    cut = CAD_Feat.CreateSideHoleY(body, pack, tool_out)
    CAD_IO.ExportSTEP(cut, "test-stl/cad_side_hole_y_through.stp")
    body = CAD_Script.CreateBox(0x4044000000000000, 0x4044000000000000, 0x4034000000000000)
    ArraySet(pack, 1, 0x402E000000000000)
    cut = CAD_Feat.CreateSideHoleY(body, pack, tool_out)
    CAD_IO.ExportSTEP(cut, "test-stl/cad_side_hole_y_blind.stp")
    CAD_Sys.Write(1, "side holes ok\n", 14)

    Deallocate(pack, 64)
    Deallocate(tool_out, 16)
    Deallocate(out, 16)
    Deallocate(mn, 32)
    Deallocate(mx, 32)
    Deallocate(dlt, 32)
    CAD_Sys.Write(1, "REGEN ALL OK — open test-stl/cad_*.stp\n", 39)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
