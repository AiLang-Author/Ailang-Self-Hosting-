// Phase B3: revolve rectangular profile → cylinder + washer tube
// Profile: X=radius, Y=height (→ solid Z). Full 360° around +Z.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== Revolve demo ===\n", 21)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(262144)

    // solid cylinder: rect x=0..10, y=0..25
    sk1 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk1, 0, 0, 0x4024000000000000, 0)
    CAD_Sketch.AddLine(sk1, 0x4024000000000000, 0, 0x4024000000000000, 0x4039000000000000)
    CAD_Sketch.AddLine(sk1, 0x4024000000000000, 0x4039000000000000, 0, 0x4039000000000000)
    CAD_Sketch.AddLine(sk1, 0, 0x4039000000000000, 0, 0)
    CAD_Sketch.BuildClosedLoop(sk1)
    h1 = CAD_Feat.RevolveProfile(sk1, 0)
    IfCondition EqualTo(h1, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL revolve solid\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(h1, "test-stl/cad_revolve_cyl.stp")
    CAD_View.SetWire(0)
    CAD_View.RenderSolidToBMP(h1, 400, 300, "test-stl/cad_view_revolve_cyl.bmp")
    CAD_Sys.Write(1, "wrote revolve cylinder\n", 23)

    // washer/tube: x=5..12, y=0..20
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk2, 0x4014000000000000, 0, 0x4028000000000000, 0)
    CAD_Sketch.AddLine(sk2, 0x4028000000000000, 0, 0x4028000000000000, 0x4034000000000000)
    CAD_Sketch.AddLine(sk2, 0x4028000000000000, 0x4034000000000000, 0x4014000000000000, 0x4034000000000000)
    CAD_Sketch.AddLine(sk2, 0x4014000000000000, 0x4034000000000000, 0x4014000000000000, 0)
    CAD_Sketch.BuildClosedLoop(sk2)
    h2 = CAD_Feat.RevolveProfile(sk2, 0)
    IfCondition EqualTo(h2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL revolve tube\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(h2, "test-stl/cad_revolve_tube.stp")
    CAD_View.RenderSolidToBMP(h2, 400, 300, "test-stl/cad_view_revolve_tube.bmp")
    CAD_Sys.Write(1, "wrote revolve tube\n", 19)
    CAD_Sys.Write(1, "REVOLVE OK\n", 11)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
