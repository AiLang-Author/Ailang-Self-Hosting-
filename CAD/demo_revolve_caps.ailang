// Tube lathe remapped onto +Y (same xform as CA_XformLatheInPlace).
// Top/bottom annuli must tessellate (not XY-earclip a now-vertical face).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess

SubRoutine.Main {
    CAD_Sys.Write(1, "=== revolve caps ===\n", 21)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(262144)
    n0 = 0
    n6 = 0x4018000000000000
    n15 = 0x402E000000000000
    n20 = 0x4034000000000000
    rz = Allocate(64)
    ArraySet(rz, 0, n6)
    ArraySet(rz, 1, n0)
    ArraySet(rz, 2, n15)
    ArraySet(rz, 3, n0)
    ArraySet(rz, 4, n15)
    ArraySet(rz, 5, n20)
    ArraySet(rz, 6, n6)
    ArraySet(rz, 7, n20)
    sk = CAD_Sketch.FromClosedXY(rz, 4)
    h = CAD_Feat.RevolveProfile(sk, 0)
    pass = 0
    PrintMessage("lathe=")
    PrintNumber(h)
    PrintMessage("\n")
    IfCondition NotEqual(h, 0) ThenBlock: {
        mesh = Allocate(32)
        nt = CAD_Tess.MeshSolid(h, 0x3FB999999999999A, mesh)
        wt = CAD_Tess.VerifyWatertight(mesh)
        PrintMessage("nt=")
        PrintNumber(nt)
        PrintMessage(" wt=")
        PrintNumber(wt)
        PrintMessage("\n")
        // Class A tube: ≥90 segs × 4 rings × 2 tris = 720+
        IfCondition GreaterThan(nt, 700) ThenBlock: {
            IfCondition EqualTo(wt, 1) ThenBlock: { pass = 1 }
        }
        Deallocate(mesh, 32)
    }
    Deallocate(rz, 64)
    IfCondition EqualTo(pass, 1) ThenBlock: {
        CAD_Sys.Write(1, "REVOLVE CAPS PASS\n", 18)
    }
    IfCondition EqualTo(pass, 0) ThenBlock: {
        CAD_Sys.Write(1, "REVOLVE CAPS FAIL\n", 18)
    }
    SystemCall(60, Subtract(1, pass), 0, 0)
}
RunTask(Main)
