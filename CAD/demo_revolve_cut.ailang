LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== RevolveCut demo ===\n", 24)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    // body 50x50x20 box
    mn = Allocate(32)
    mx = Allocate(32)
    out = Allocate(16)
    ArraySet(mn, 0, 0)
    ArraySet(mn, 1, 0)
    ArraySet(mn, 2, 0)
    ArraySet(mx, 0, Float_FromInt(50))
    ArraySet(mx, 1, Float_FromInt(50))
    ArraySet(mx, 2, Float_FromInt(20))
    body = CAD_Topo.MakeBoxSolid(mn, mx, out)
    Deallocate(mn, 32)
    Deallocate(mx, 32)
    Deallocate(out, 16)

    // revolve profile: r=0..8, z=0..20 → cylinder hole through
    // place axis at plate center: revolve is at origin; hole recipe uses cx,cy from cyl
    // Build profile at x=0..8, y=0..20 then we need hole at (25,25).
    // CreateHole uses sketch circle easier — for RevolveCut tool at origin:
    // body should be centered or we translate body. Simpler: body [-25,25]^2 and revolve at 0.
    // Rebuild body centered
    mn = Allocate(32)
    mx = Allocate(32)
    out = Allocate(16)
    ArraySet(mn, 0, Float_FromInt(-25))
    ArraySet(mn, 1, Float_FromInt(-25))
    ArraySet(mn, 2, 0)
    ArraySet(mx, 0, Float_FromInt(25))
    ArraySet(mx, 1, Float_FromInt(25))
    ArraySet(mx, 2, Float_FromInt(20))
    body = CAD_Topo.MakeBoxSolid(mn, mx, out)
    Deallocate(mn, 32)
    Deallocate(mx, 32)
    Deallocate(out, 16)

    sk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk, 0, 0, Float_FromInt(8), 0)
    CAD_Sketch.AddLine(sk, Float_FromInt(8), 0, Float_FromInt(8), Float_FromInt(20))
    CAD_Sketch.AddLine(sk, Float_FromInt(8), Float_FromInt(20), 0, Float_FromInt(20))
    CAD_Sketch.AddLine(sk, 0, Float_FromInt(20), 0, 0)
    CAD_Sketch.BuildClosedLoop(sk)

    cut = CAD_Feat.RevolveCut(body, sk, 0)
    IfCondition EqualTo(cut, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL revolve cut\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(cut, "test-stl/cad_revolve_cut.stp")
    CAD_View.SetWire(0)
    CAD_View.RenderSolidToBMP(cut, 450, 350, "test-stl/cad_view_revolve_cut.bmp")
    CAD_Sys.Write(1, "REVOLVE CUT OK\n", 15)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
