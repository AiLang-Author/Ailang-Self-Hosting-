// Revolve radius = |X - axis|: left half-plane profile works (app maps to RZ).
// Simulates CA_RevolveFromSketch default axis X=0:
//   profile x=-20..-5, y=0..30  ->  r=5..20, y=0..30  -> tube

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== Revolve left-half (r=|X|) ===\n", 35)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    // App would take left rect x=-20..-5 and map r = |x| -> 5..20
    sk = CAD_Sketch.CreateSketch(1)
    // r=5..20, y=0..30  (tube about Y-axis / solid Z)
    CAD_Sketch.AddLine(sk, 0x4014000000000000, 0, 0x4034000000000000, 0)
    CAD_Sketch.AddLine(sk, 0x4034000000000000, 0, 0x4034000000000000, 0x403E000000000000)
    CAD_Sketch.AddLine(sk, 0x4034000000000000, 0x403E000000000000, 0x4014000000000000, 0x403E000000000000)
    CAD_Sketch.AddLine(sk, 0x4014000000000000, 0x403E000000000000, 0x4014000000000000, 0)
    CAD_Sketch.BuildClosedLoop(sk)
    h = CAD_Feat.RevolveProfile(sk, 0)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL revolve left-half tube\n", 28)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(h, "test-stl/cad_revolve_lefthalf.stp")
    CAD_View.SetWire(0)
    CAD_View.RenderSolidToBMP(h, 400, 300, "test-stl/cad_view_revolve_lefthalf.bmp")
    CAD_Sys.Write(1, "wrote revolve left-half tube\n", 29)

    // solid cylinder: left profile touching axis -> r=0..15
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk2, 0, 0, 0x402E000000000000, 0)
    CAD_Sketch.AddLine(sk2, 0x402E000000000000, 0, 0x402E000000000000, 0x4039000000000000)
    CAD_Sketch.AddLine(sk2, 0x402E000000000000, 0x4039000000000000, 0, 0x4039000000000000)
    CAD_Sketch.AddLine(sk2, 0, 0x4039000000000000, 0, 0)
    CAD_Sketch.BuildClosedLoop(sk2)
    h2 = CAD_Feat.RevolveProfile(sk2, 0)
    IfCondition EqualTo(h2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL revolve on-axis solid\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(h2, "test-stl/cad_revolve_axis_cyl.stp")
    CAD_Sys.Write(1, "REVOLVE LEFTHALF OK\n", 20)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
