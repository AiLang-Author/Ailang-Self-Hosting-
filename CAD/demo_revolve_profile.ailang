// True profile lathe: non-rect RZ section (stepped + curved outer) → solid of revolution.
// Must NOT collapse to AABB tube — outer radius varies with height.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View
LibraryImport.Cad.CAD_Geom

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== Revolve profile lathe ===\n", 31)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    // Closed profile in RZ (X=rho, Y=z), left of origin not used:
    //   (8,0)-(20,0)-(20,10)-(14,18)-(8,18)-(8,0)
    // outer wall has a slanted "curve" approx from (20,10) to (14,18)
    sk = CAD_Sketch.CreateSketch(1)
    // bot inner→outer
    CAD_Sketch.AddLine(sk, 0x4020000000000000, 0, 0x4034000000000000, 0)
    // outer wall vertical
    CAD_Sketch.AddLine(sk, 0x4034000000000000, 0, 0x4034000000000000, 0x4024000000000000)
    // slanted top-outer (non-rect!)
    CAD_Sketch.AddLine(sk, 0x4034000000000000, 0x4024000000000000, 0x402C000000000000, 0x4032000000000000)
    // top outer→inner
    CAD_Sketch.AddLine(sk, 0x402C000000000000, 0x4032000000000000, 0x4020000000000000, 0x4032000000000000)
    // inner wall
    CAD_Sketch.AddLine(sk, 0x4020000000000000, 0x4032000000000000, 0x4020000000000000, 0)
    CAD_Sketch.BuildClosedLoop(sk)
    h = CAD_Feat.RevolveProfile(sk, 0)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL revolve profile lathe\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(h, "test-stl/cad_revolve_profile.stp")
    CAD_View.SetWire(0)
    CAD_View.RenderSolidToBMP(h, 450, 350, "test-stl/cad_view_revolve_profile.bmp")
    CAD_Sys.Write(1, "wrote revolve profile lathe\n", 28)

    // also classic cylinder rect still works
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk2, 0, 0, 0x4024000000000000, 0)
    CAD_Sketch.AddLine(sk2, 0x4024000000000000, 0, 0x4024000000000000, 0x4034000000000000)
    CAD_Sketch.AddLine(sk2, 0x4024000000000000, 0x4034000000000000, 0, 0x4034000000000000)
    CAD_Sketch.AddLine(sk2, 0, 0x4034000000000000, 0, 0)
    CAD_Sketch.BuildClosedLoop(sk2)
    h2 = CAD_Feat.RevolveProfile(sk2, 0)
    IfCondition EqualTo(h2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL revolve on-axis rect\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "REVOLVE PROFILE OK\n", 19)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
