// C6: RotateSolidZ 45° on a box, STEP + top view

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_View

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== RotateSolidZ demo ===\n", 26)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(8192)
    body = CAD_Script.CreateBox(Float_FromInt(30), Float_FromInt(20), Float_FromInt(10))
    ang = 0x3FE921FB54442D18
    IfCondition NotEqual(CAD_Topo.RotateSolidZ(body, ang), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL rotate\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(body, "test-stl/cad_rotate_z.stp")
    CAD_View.SetWire(0)
    CAD_View.SetViewMode(1)
    CAD_View.RenderSolidToBMP(body, 400, 300, "test-stl/cad_view_rotate_z.bmp")
    CAD_Sys.Write(1, "ROTATE OK\n", 10)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
