// Placement: TranslateSolid + RotateSolidZ on plate-with-hole → STEP.
// Holes stay circular in plate local frame; origin/hole XY rotate about Z.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== rotate+place STEP ===\n", 26)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    dx = 0x403E000000000000
    dy = 0x4034000000000000
    dz = 0x4020000000000000
    body = CAD_Script.CreateBox(dx, dy, dz)
    pack = Allocate(48)
    tool_out = Allocate(16)
    // hole dia 8 through at (10,10)
    ArraySet(pack, 0, 0x4020000000000000)
    ArraySet(pack, 1, 0x4020000000000000)
    ArraySet(pack, 2, 0x4024000000000000)
    ArraySet(pack, 3, 0x4024000000000000)
    cut = CAD_Feat.CreateHole(body, pack, tool_out)
    IfCondition EqualTo(cut, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL hole\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    // rotate 45° about Z then translate +50 X
    ang = 0x3FE921FB54442D18
    rc = CAD_Topo.RotateSolidZ(cut, ang)
    IfCondition NotEqual(rc, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL rotate\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    dlt = Allocate(32)
    ArraySet(dlt, 0, 0x4049000000000000)
    ArraySet(dlt, 1, 0)
    ArraySet(dlt, 2, 0)
    CAD_Topo.TranslateSolid(cut, dlt)
    Deallocate(dlt, 32)
    // STEP uses plate-local hole params (cx,cy after rotate); still valid solid
    CAD_IO.ExportSTEP(cut, "test-stl/cad_plate_hole_rot45.stp")
    CAD_Sys.Write(1, "wrote cad_plate_hole_rot45.stp\n", 31)
    Deallocate(pack, 48)
    Deallocate(tool_out, 16)
    CAD_Sys.Write(1, "ROTATE PLACE OK\n", 16)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
