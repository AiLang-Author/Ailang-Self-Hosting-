// Side-axis hole (+X): through + blind on box → B-Rep walk STEP.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== side-hole +X B-Rep STEP ===\n", 32)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    // plate 40 x 40 x 20
    dx = 0x4044000000000000
    dy = 0x4044000000000000
    dz = 0x4034000000000000
    body = CAD_Script.CreateBox(dx, dy, dz)
    pack = Allocate(48)
    tool_out = Allocate(16)
    // through dia 8 along +X, center (cy,cz)=(20,10)
    ArraySet(pack, 0, 0x4020000000000000)
    ArraySet(pack, 1, dx)
    ArraySet(pack, 2, 0x4034000000000000)
    ArraySet(pack, 3, 0x4024000000000000)
    cut = CAD_Feat.CreateSideHoleX(body, pack, tool_out)
    IfCondition EqualTo(cut, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL side through\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Store.Read(cut, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL side no shell\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(cut, "test-stl/cad_side_hole_through.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL side through STEP\n", 23)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote side-hole-through.stp\n", 28)

    body2 = CAD_Script.CreateBox(dx, dy, dz)
    // blind depth 15
    ArraySet(pack, 1, 0x402E000000000000)
    cut2 = CAD_Feat.CreateSideHoleX(body2, pack, tool_out)
    IfCondition EqualTo(cut2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL side blind\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(cut2, "test-stl/cad_side_hole_blind.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL side blind STEP\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote side-hole-blind.stp\n", 26)

    Deallocate(pack, 48)
    Deallocate(tool_out, 16)
    CAD_Sys.Write(1, "SIDE HOLE BREP OK\n", 18)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
