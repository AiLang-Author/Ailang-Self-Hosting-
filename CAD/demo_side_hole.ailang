// Side-axis holes +X and +Y (through + blind) → B-Rep walk STEP.
// Regenerates fixtures under test-stl/ (safe after deleting old models).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== side-hole +X/+Y B-Rep STEP ===\n", 36)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    // plate 40 x 40 x 20
    dx = 0x4044000000000000
    dy = 0x4044000000000000
    dz = 0x4034000000000000
    pack = Allocate(48)
    tool_out = Allocate(16)

    // --- +X through dia 8, center (cy,cz)=(20,10) ---
    body = CAD_Script.CreateBox(dx, dy, dz)
    ArraySet(pack, 0, 0x4020000000000000)
    ArraySet(pack, 1, dx)
    ArraySet(pack, 2, 0x4034000000000000)
    ArraySet(pack, 3, 0x4024000000000000)
    cut = CAD_Feat.CreateSideHoleX(body, pack, tool_out)
    IfCondition EqualTo(cut, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL side X through\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(cut, "test-stl/cad_side_hole_through.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL side X through STEP\n", 25)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote side-hole-through +X\n", 27)

    // --- +X blind depth 15 ---
    body2 = CAD_Script.CreateBox(dx, dy, dz)
    ArraySet(pack, 1, 0x402E000000000000)
    cut2 = CAD_Feat.CreateSideHoleX(body2, pack, tool_out)
    IfCondition EqualTo(cut2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL side X blind\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(cut2, "test-stl/cad_side_hole_blind.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL side X blind STEP\n", 23)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote side-hole-blind +X\n", 25)

    // --- +Y through dia 8, center (cx,cz)=(20,10) ---
    body3 = CAD_Script.CreateBox(dx, dy, dz)
    ArraySet(pack, 0, 0x4020000000000000)
    ArraySet(pack, 1, dy)
    ArraySet(pack, 2, 0x4034000000000000)
    ArraySet(pack, 3, 0x4024000000000000)
    cut3 = CAD_Feat.CreateSideHoleY(body3, pack, tool_out)
    IfCondition EqualTo(cut3, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL side Y through\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(cut3, "test-stl/cad_side_hole_y_through.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL side Y through STEP\n", 25)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote side-hole-through +Y\n", 27)

    // --- +Y blind depth 15 ---
    body4 = CAD_Script.CreateBox(dx, dy, dz)
    ArraySet(pack, 1, 0x402E000000000000)
    cut4 = CAD_Feat.CreateSideHoleY(body4, pack, tool_out)
    IfCondition EqualTo(cut4, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL side Y blind\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(cut4, "test-stl/cad_side_hole_y_blind.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL side Y blind STEP\n", 23)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote side-hole-blind +Y\n", 25)

    Deallocate(pack, 48)
    Deallocate(tool_out, 16)
    CAD_Sys.Write(1, "SIDE HOLE BREP OK\n", 18)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
