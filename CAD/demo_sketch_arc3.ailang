// S2: Arc3Point — arc through start / through / end
LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== sketch arc 3-point ===\n", 28)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    sk = CAD_Sketch.CreateSketch(1)
    // unit circle-ish: (1,0), (0,1), (-1,0) on circle center 0 r=1
    // P0=(1,0) P1=(0,1) P2=(-1,0) — Arc3Pend (6 floats) then Arc3Point(handle)
    CAD_Sketch.Arc3Pend(0x3FF0000000000000, 0, 0, 0x3FF0000000000000, 0xBFF0000000000000, 0)
    rc = CAD_Sketch.Arc3Point(sk)
    IfCondition NotEqual(rc, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL Arc3Point\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    na = CAD_Sketch.GetArcCount(sk)
    IfCondition LessThan(na, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no arc\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    arcs = CAD_Store.Read(sk, 11)
    cx = ArrayGet(arcs, 0)
    cy = ArrayGet(arcs, 1)
    rad = ArrayGet(arcs, 2)
    // center ~ (0,0), r ~ 1
    IfCondition EqualTo(CAD_Num.IsZero(cx, 0x3F50624DD2F1A9FC), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL center x\n", 14)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Num.IsZero(cy, 0x3F50624DD2F1A9FC), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL center y\n", 14)
        SystemCall(60, 1, 0, 0)
    }
    dd = Float_Sub(rad, 0x3FF0000000000000)
    IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
    IfCondition EqualTo(Float_Le(dd, 0x3F50624DD2F1A9FC), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL radius\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    // mid of arc should be near (0,1) not (0,-1)
    a0 = ArrayGet(arcs, 3)
    a1 = ArrayGet(arcs, 4)
    two_pi = 0x401921FB54442D18
    sp = Float_Sub(a1, a0)
    IfCondition EqualTo(Float_Le(sp, 0), 1) ThenBlock: {
        sp = Float_Add(sp, two_pi)
    }
    mid = Float_Add(a0, Float_Mul(sp, 0x3FE0000000000000))
    mx = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(mid)))
    my = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(mid)))
    // expect my > 0 (upper semicircle)
    IfCondition EqualTo(Float_Le(my, 0), 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL arc went wrong way\n", 24)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS semicircle via (0,1)\n", 26)

    // collinear should fail
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.Arc3Pend(0, 0, 0x3FF0000000000000, 0, 0x4000000000000000, 0)
    rc2 = CAD_Sketch.Arc3Point(sk2)
    IfCondition EqualTo(rc2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL collinear accepted\n", 24)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS reject collinear\n", 22)

    // Scoop into V: P0=(-2,2) P1=(0,0) P2=(2,2) — through below chord → mid y < 2
    sk3 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.Arc3Pend(0xC000000000000000, 0x4000000000000000, 0, 0, 0x4000000000000000, 0x4000000000000000)
    rc3 = CAD_Sketch.Arc3Point(sk3)
    IfCondition NotEqual(rc3, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL scoop Arc3Point\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    arcs = CAD_Store.Read(sk3, 11)
    cx = ArrayGet(arcs, 0)
    cy = ArrayGet(arcs, 1)
    rad = ArrayGet(arcs, 2)
    a0 = ArrayGet(arcs, 3)
    a1 = ArrayGet(arcs, 4)
    two_pi = 0x401921FB54442D18
    sp = Float_Sub(a1, a0)
    IfCondition EqualTo(Float_Le(sp, 0), 1) ThenBlock: {
        sp = Float_Add(sp, two_pi)
    }
    mid = Float_Add(a0, Float_Mul(sp, 0x3FE0000000000000))
    my = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(mid)))
    // scoop mid must be below the chord y=2 (into the V mouth)
    IfCondition EqualTo(Float_Le(my, 0x4000000000000000), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL scoop went outward\n", 25)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS scoop into V (mid below chord)\n", 36)

    CAD_Sys.Write(1, "SKETCH ARC3 OK\n", 15)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
