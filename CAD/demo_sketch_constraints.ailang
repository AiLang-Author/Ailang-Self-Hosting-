// Constraints P1/P3 core: user Point, coincident, radius, tangent, dist, point-on
// Gate for CAD_SKETCHER_IMPL.md

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch

SubRoutine.Main {
    CAD_Sys.Write(1, "=== sketch constraints (point/coinc/tang/rad) ===\n", 50)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)
    out = Allocate(32)
    o2 = Allocate(32)

    // --- user Point + DistToOrigin ---
    sk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddUserPoint(sk, 0x4000000000000000, 0x4000000000000000, 0)
    CAD_Sketch.AddConstraint(sk, 6, 3, 0, 0x4024000000000000)
    CAD_Sketch.SolveConstraints(sk)
    CAD_Sketch.GetUserPoint(sk, 0, out)
    px = ArrayGet(out, 0)
    py = ArrayGet(out, 1)
    d = CAD_Num.Sqrt(Float_Add(Float_Mul(px, px), Float_Mul(py, py)))
    dd = Float_Sub(d, 0x4024000000000000)
    IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
    IfCondition EqualTo(Float_Le(dd, 0x3F1A36E2EB1C432D), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL DistToOrigin on user Point\n", 32)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS user Point DistToOrigin\n", 29)

    // --- Coincident line end to user Point (B ← A) ---
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddUserPoint(sk2, 0x4014000000000000, 0x4014000000000000, 0)
    CAD_Sketch.AddLine(sk2, 0, 0, 0x3FF0000000000000, 0x3FF0000000000000)
    CAD_Sketch.AddConstraint2(sk2, 9, 3, 0, 0, 1)
    CAD_Sketch.SolveConstraints(sk2)
    CAD_Sketch.GetLineEnd(sk2, 0, 1, out)
    IfCondition EqualTo(CAD_Num.IsEqual(ArrayGet(out, 0), 0x4014000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL coincident x\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Num.IsEqual(ArrayGet(out, 1), 0x4014000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL coincident y\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS coincident line↔point\n", 27)

    // --- Radius ---
    sk3 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(sk3, 0, 0, 0x4000000000000000)
    CAD_Sketch.AddConstraint(sk3, 11, 4, 0, 0x4014000000000000)
    CAD_Sketch.SolveConstraints(sk3)
    r = CAD_Sketch.GetCircleRadius(sk3, 0)
    IfCondition EqualTo(CAD_Num.IsEqual(r, 0x4014000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL radius\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS radius constraint\n", 23)

    // --- Tangent line–circle ---
    sk4 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk4, 0, 0, 0x4034000000000000, 0)
    CAD_Sketch.AddCircle(sk4, 0x4024000000000000, 0x4020000000000000, 0x4014000000000000)
    CAD_Sketch.AddConstraint2(sk4, 13, 2, 0, 4, 0)
    CAD_Sketch.SolveConstraints(sk4)
    CAD_Sketch.GetTargetXY(sk4, 4, 0, out)
    cy = ArrayGet(out, 1)
    IfCondition EqualTo(Float_Le(cy, 0), 1) ThenBlock: { cy = Float_Sub(0, cy) }
    dd = Float_Sub(cy, 0x4014000000000000)
    IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
    IfCondition EqualTo(Float_Le(dd, 0x3F1A36E2EB1C432D), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL tangent L-C\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS tangent line–circle\n", 25)

    // --- Tangent circle–circle ---
    sk5 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(sk5, 0, 0, 0x4000000000000000)
    CAD_Sketch.AddCircle(sk5, 0x4024000000000000, 0, 0x4000000000000000)
    CAD_Sketch.AddConstraint2(sk5, 14, 4, 0, 4, 1)
    CAD_Sketch.SolveConstraints(sk5)
    CAD_Sketch.GetTargetXY(sk5, 4, 0, out)
    CAD_Sketch.GetTargetXY(sk5, 4, 1, o2)
    dx = Float_Sub(ArrayGet(o2, 0), ArrayGet(out, 0))
    dy = Float_Sub(ArrayGet(o2, 1), ArrayGet(out, 1))
    d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
    dd = Float_Sub(d, 0x4010000000000000)
    IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
    IfCondition EqualTo(Float_Le(dd, 0x3F1A36E2EB1C432D), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL tangent C-C\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS tangent circle–circle\n", 27)

    // --- DistPoints between user points (value via SetConstraintValue) ---
    sk6 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddUserPoint(sk6, 0, 0, 0)
    CAD_Sketch.AddUserPoint(sk6, 0x4000000000000000, 0x4000000000000000, 0)
    cid = CAD_Sketch.AddConstraint2(sk6, 15, 3, 0, 3, 1)
    CAD_Sketch.SetConstraintValue(sk6, cid, 0x4024000000000000)
    CAD_Sketch.SolveConstraints(sk6)
    CAD_Sketch.GetUserPoint(sk6, 0, out)
    CAD_Sketch.GetUserPoint(sk6, 1, o2)
    dx = Float_Sub(ArrayGet(o2, 0), ArrayGet(out, 0))
    dy = Float_Sub(ArrayGet(o2, 1), ArrayGet(out, 1))
    d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
    dd = Float_Sub(d, 0x4024000000000000)
    IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
    IfCondition EqualTo(Float_Le(dd, 0x3F1A36E2EB1C432D), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL DistPoints\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS DistPoints user↔user\n", 26)

    // --- PointOnLine ---
    sk7 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk7, 0, 0, 0x4024000000000000, 0)
    CAD_Sketch.AddUserPoint(sk7, 0x4014000000000000, 0x4000000000000000, 0)
    CAD_Sketch.AddConstraint2(sk7, 10, 3, 0, 2, 0)
    CAD_Sketch.SolveConstraints(sk7)
    CAD_Sketch.GetUserPoint(sk7, 0, out)
    IfCondition EqualTo(CAD_Num.IsZero(ArrayGet(out, 1), 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL PointOnLine y\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS PointOnLine\n", 17)

    // --- EqualRadius ---
    sk8 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(sk8, 0, 0, 0x4000000000000000)
    CAD_Sketch.AddCircle(sk8, 0x4034000000000000, 0, 0x4014000000000000)
    CAD_Sketch.AddConstraint2(sk8, 12, 4, 0, 4, 1)
    CAD_Sketch.SolveConstraints(sk8)
    r0 = CAD_Sketch.GetCircleRadius(sk8, 0)
    r1 = CAD_Sketch.GetCircleRadius(sk8, 1)
    IfCondition EqualTo(CAD_Num.IsEqual(r0, r1, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL EqualRadius\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS EqualRadius\n", 17)

    Deallocate(out, 32)
    Deallocate(o2, 32)
    CAD_Sys.Write(1, "SKETCH CONSTRAINTS OK\n", 22)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
