// CS-0 + origin solver: Sketch_0 datum, SnapToDatum, SolveDatum (FixOrigin/H/V/DistToO)
// Gate for Docs/CAD/CAD_SKETCHER_IMPL.md §3.5 / §4 P0 absolute.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch

SubRoutine.Main {
    CAD_Sys.Write(1, "=== sketch datum + origin solver ===\n", 38)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    sk = CAD_Sketch.CreateSketch(1)
    IfCondition EqualTo(sk, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL CreateSketch\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    // EnsureDatum runs from CreateSketch
    IfCondition NotEqual(CAD_Sketch.GetPlaneId(sk), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL plane_id not world 0\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    fl_ok = CAD_Sketch.EnsureDatum(sk)
    IfCondition NotEqual(fl_ok, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL EnsureDatum\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS EnsureDatum + plane_id=0\n", 30)

    // Snap to origin
    out = Allocate(32)
    // (0.2, -0.15) within 0.5 mm → O
    hit = CAD_Sketch.SnapToDatum(sk, 0x3FC999999999999A, 0xBFC3333333333333, 0x3FE0000000000000, out)
    IfCondition NotEqual(hit, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL snap origin kind\n", 22)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Num.IsZero(ArrayGet(out, 0), 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL snap origin x\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Num.IsZero(ArrayGet(out, 1), 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL snap origin y\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS SnapToDatum origin\n", 24)

    // Snap to +X axis (y near 0)
    // (5.0, 0.3) tol 0.5 → (5, 0)
    hit = CAD_Sketch.SnapToDatum(sk, 0x4014000000000000, 0x3FD3333333333333, 0x3FE0000000000000, out)
    IfCondition NotEqual(hit, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL snap axisX kind\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Num.IsEqual(ArrayGet(out, 0), 0x4014000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL snap axisX x\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Num.IsZero(ArrayGet(out, 1), 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL snap axisX y\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS SnapToDatum +X\n", 20)

    // Snap to +Y axis
    // (0.2, 8.0) → (0, 8)
    hit = CAD_Sketch.SnapToDatum(sk, 0x3FC999999999999A, 0x4020000000000000, 0x3FE0000000000000, out)
    IfCondition NotEqual(hit, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL snap axisY kind\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Num.IsZero(ArrayGet(out, 0), 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL snap axisY x\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS SnapToDatum +Y\n", 20)

    // Origin solver: line from messy start to (10, 3)
    // FixOrigin on start; Horizontal; DistToOrigin 10 on end
    CAD_Sketch.AddLine(sk, 0x3FB999999999999A, 0x3FC999999999999A, 0x4024000000000000, 0x4008000000000000)
    // line 0 start = target_id 0, end = 1
    CAD_Sketch.AddConstraint(sk, 1, 0, 0, 0)
    // Horizontal on whole line
    CAD_Sketch.AddConstraint(sk, 7, 2, 0, 0)
    // DistToOrigin 10 on tip (end id=1)
    CAD_Sketch.AddConstraint(sk, 6, 0, 1, 0x4024000000000000)
    IfCondition NotEqual(CAD_Sketch.GetConstraintCount(sk), 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL constraint count\n", 22)
        SystemCall(60, 1, 0, 0)
    }
    napp = CAD_Sketch.SolveDatum(sk)
    IfCondition LessThan(napp, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL SolveDatum applied\n", 24)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sketch.GetLineEnd(sk, 0, 0, out)
    IfCondition EqualTo(CAD_Num.IsZero(ArrayGet(out, 0), 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL FixOrigin x\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Num.IsZero(ArrayGet(out, 1), 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL FixOrigin y\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sketch.GetLineEnd(sk, 0, 1, out)
    // after H + DistToO: tip should be (~10, 0) or (-10,0)
    ey = ArrayGet(out, 1)
    IfCondition EqualTo(CAD_Num.IsZero(ey, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL Horizontal y\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    ex = ArrayGet(out, 0)
    // |ex| should be ~10
    IfCondition EqualTo(Float_Le(ex, 0), 1) ThenBlock: { ex = Float_Sub(0, ex) }
    // |ex - 10| < 1e-6
    dd = Float_Sub(ex, 0x4024000000000000)
    IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
    IfCondition EqualTo(Float_Le(dd, 0x3EB0C6F7A0B5ED8D), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL DistToOrigin length\n", 25)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS SolveDatum FixOrigin+H+DistToO\n", 36)

    // Vertical + FixY on second line
    sk2 = CAD_Sketch.CreateSketch(1)
    // (2, 1) - (5, 8)
    CAD_Sketch.AddLine(sk2, 0x4000000000000000, 0x3FF0000000000000, 0x4014000000000000, 0x4020000000000000)
    CAD_Sketch.AddConstraint(sk2, 8, 2, 0, 0)
    // FixY = 4 on start
    CAD_Sketch.AddConstraint(sk2, 3, 0, 0, 0x4010000000000000)
    CAD_Sketch.SolveDatum(sk2)
    CAD_Sketch.GetLineEnd(sk2, 0, 0, out)
    // start y = 4, and vertical → both x equal to start x after V uses x0...
    // Order: Vert sets x1=x0 first, FixY sets y0=4. y1 not forced.
    IfCondition EqualTo(CAD_Num.IsEqual(ArrayGet(out, 1), 0x4010000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL FixY\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sketch.GetLineEnd(sk2, 0, 1, out)
    // tip x should match start x (vertical)
    sx = Allocate(32)
    CAD_Sketch.GetLineEnd(sk2, 0, 0, sx)
    IfCondition EqualTo(CAD_Num.IsEqual(ArrayGet(out, 0), ArrayGet(sx, 0), 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL Vertical x\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    Deallocate(sx, 32)
    CAD_Sys.Write(1, "PASS SolveDatum FixY+Vertical\n", 30)

    Deallocate(out, 32)
    CAD_Sys.Write(1, "SKETCH DATUM OK\n", 16)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
