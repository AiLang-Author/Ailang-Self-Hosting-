// S1: CAD_Sketch.FilletLines — L-corner + R → tangent arc, truncated legs
LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch

SubRoutine.Main {
    CAD_Sys.Write(1, "=== sketch fillet lines ===\n", 28)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    sk = CAD_Sketch.CreateSketch(1)
    // L: (0,10)-(0,0) and (0,0)-(10,0)
    CAD_Sketch.AddLine(sk, 0, 0x4024000000000000, 0, 0)
    CAD_Sketch.AddLine(sk, 0, 0, 0x4024000000000000, 0)
    // R = 2
    rc = CAD_Sketch.FilletLines(sk, 0, 1, 0x4000000000000000)
    IfCondition NotEqual(rc, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL FilletLines rc\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    na = CAD_Sketch.GetArcCount(sk)
    IfCondition LessThan(na, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no arc\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    // lines should not both end at origin anymore
    out = Allocate(32)
    CAD_Sketch.GetLineEnd(sk, 0, 0, out)
    CAD_Sketch.GetLineEnd(sk, 0, 1, out)
    // one end of each line should be near (0,2) or (2,0)
    // check line0 has an endpoint with x~0 and y~2
    lines = CAD_Store.Read(sk, 1)
    // collect ends
    found_v = 0
    found_h = 0
    i = 0
    WhileLoop LessThan(i, 2) {
        x = ArrayGet(lines, Multiply(i, 2))
        // wait lines are 4 per line: line0 ends at 0,1 and 2,3
        i = Add(i, 1)
    }
    // line 0 ends
    x0 = ArrayGet(lines, 0)
    y0 = ArrayGet(lines, 1)
    x1 = ArrayGet(lines, 2)
    y1 = ArrayGet(lines, 3)
    // tangent on vertical at (0,2)
    // either end y near 2 and x near 0
    e = 0
    WhileLoop LessThan(e, 2) {
        IfCondition EqualTo(e, 0) ThenBlock: {
            xx = x0
            yy = y0
        }
        IfCondition EqualTo(e, 1) ThenBlock: {
            xx = x1
            yy = y1
        }
        IfCondition EqualTo(CAD_Num.IsZero(xx, 0x3F50624DD2F1A9FC), 1) ThenBlock: {
            dy = Float_Sub(yy, 0x4000000000000000)
            IfCondition EqualTo(Float_Le(dy, 0), 1) ThenBlock: { dy = Float_Sub(0, dy) }
            IfCondition EqualTo(Float_Le(dy, 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                found_v = 1
            }
        }
        e = Add(e, 1)
    }
    // line 1 ends at indices 4..7
    x0 = ArrayGet(lines, 4)
    y0 = ArrayGet(lines, 5)
    x1 = ArrayGet(lines, 6)
    y1 = ArrayGet(lines, 7)
    e = 0
    WhileLoop LessThan(e, 2) {
        IfCondition EqualTo(e, 0) ThenBlock: {
            xx = x0
            yy = y0
        }
        IfCondition EqualTo(e, 1) ThenBlock: {
            xx = x1
            yy = y1
        }
        IfCondition EqualTo(CAD_Num.IsZero(yy, 0x3F50624DD2F1A9FC), 1) ThenBlock: {
            dx = Float_Sub(xx, 0x4000000000000000)
            IfCondition EqualTo(Float_Le(dx, 0), 1) ThenBlock: { dx = Float_Sub(0, dx) }
            IfCondition EqualTo(Float_Le(dx, 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                found_h = 1
            }
        }
        e = Add(e, 1)
    }
    IfCondition EqualTo(found_v, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL vertical tangent pt\n", 25)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(found_h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL horizontal tangent pt\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    Deallocate(out, 32)
    CAD_Sys.Write(1, "PASS L-corner fillet R=2\n", 25)

    // too large R should fail
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk2, 0, 0x3FF0000000000000, 0, 0)
    CAD_Sketch.AddLine(sk2, 0, 0, 0x3FF0000000000000, 0)
    rc2 = CAD_Sketch.FilletLines(sk2, 0, 1, 0x4014000000000000)
    IfCondition EqualTo(rc2, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected R too large\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS reject oversized R\n", 24)

    CAD_Sys.Write(1, "SKETCH FILLET OK\n", 17)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
