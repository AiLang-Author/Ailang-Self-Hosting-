// SketchPlex profile compiler: loops follow real endpoints, arcs stay arcs.
// Regression: leftover complementary-arc recipes filled a disk / giant triangle.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== sketch plex profiles ===\n", 30)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    z = 0
    p100 = 0x4059000000000000
    p50 = 0x4049000000000000
    xy = Allocate(65536)

    // A: 100×100 rect → one face, area 10000, not a triangle
    sk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk, z, z, p100, z)
    CAD_Sketch.AddLine(sk, p100, z, p100, p100)
    CAD_Sketch.AddLine(sk, p100, p100, z, p100)
    CAD_Sketch.AddLine(sk, z, p100, z, z)
    n = CAD_Sketch.ProfCompile(sk)
    CAD_Sys.Write(1, "rect nprof=", 11)
    PrintNumber(n)
    CAD_Sys.Write(1, "\n", 1)
    IfCondition LessThan(n, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL rect no profile\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    nn = CAD_Sketch.GetProfileXY(sk, 0, xy)
    ar = CAD_Sketch.LoopSignedArea(xy, nn)
    IfCondition EqualTo(CAD_Num.IsNeg(ar), 1) ThenBlock: { ar = Float_Sub(0, ar) }
    CAD_Sys.Write(1, "rect nn=", 8)
    PrintNumber(nn)
    CAD_Sys.Write(1, " area=", 6)
    PrintNumber(Float_ToInt(ar))
    CAD_Sys.Write(1, "\n", 1)
    IfCondition LessThan(nn, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL rect triangle/degenerate\n", 30)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition LessThan(Float_ToInt(ar), 9000) ThenBlock: {
        CAD_Sys.Write(1, "FAIL rect area\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    np = CAD_Sketch.SketchPlexPathCount(0)
    CAD_Sys.Write(1, "rect plex nseg=", 15)
    PrintNumber(np)
    CAD_Sys.Write(1, "\n", 1)
    IfCondition LessThan(np, 4) ThenBlock: {
        CAD_Sys.Write(1, "FAIL rect plex path\n", 20)
        SystemCall(60, 1, 0, 0)
    }

    // B: same rect + lower semicircle on the bottom diameter.
    // Must keep the rect (or union), never a 3-vertex spanning triangle.
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk2, z, z, p100, z)
    CAD_Sketch.AddLine(sk2, p100, z, p100, p100)
    CAD_Sketch.AddLine(sk2, p100, p100, z, p100)
    CAD_Sketch.AddLine(sk2, z, p100, z, z)
    CAD_Sketch.AddArc(sk2, p50, z, p50, 0x400921FB54442D18, 0x401921FB54442D18)
    n = CAD_Sketch.ProfCompile(sk2)
    CAD_Sys.Write(1, "rect+arc nprof=", 15)
    PrintNumber(n)
    CAD_Sys.Write(1, "\n", 1)
    IfCondition LessThan(n, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL rect+arc no profile\n", 25)
        SystemCall(60, 1, 0, 0)
    }
    pi = 0
    saw_rect = 0
    saw_tri = 0
    WhileLoop LessThan(pi, n) {
        nn = CAD_Sketch.GetProfileXY(sk2, pi, xy)
        ar = CAD_Sketch.LoopSignedArea(xy, nn)
        IfCondition EqualTo(CAD_Num.IsNeg(ar), 1) ThenBlock: { ar = Float_Sub(0, ar) }
        CAD_Sys.Write(1, "face ", 5)
        PrintNumber(pi)
        CAD_Sys.Write(1, " nn=", 4)
        PrintNumber(nn)
        CAD_Sys.Write(1, " area=", 6)
        PrintNumber(Float_ToInt(ar))
        CAD_Sys.Write(1, "\n", 1)
        IfCondition EqualTo(nn, 3) ThenBlock: {
            IfCondition GreaterThan(Float_ToInt(ar), 100) ThenBlock: { saw_tri = 1 }
        }
        IfCondition GreaterThan(nn, 3) ThenBlock: {
            IfCondition GreaterThan(Float_ToInt(ar), 8000) ThenBlock: { saw_rect = 1 }
        }
        pi = Add(pi, 1)
    }
    IfCondition EqualTo(saw_tri, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL giant triangle recipe\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(saw_rect, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no rect-sized face\n", 24)
        SystemCall(60, 1, 0, 0)
    }

    // C: isolated circle is a full ring, not mixed into a chord triangle
    sk3 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(sk3, p50, p50, 0x4039000000000000)
    n = CAD_Sketch.ProfCompile(sk3)
    CAD_Sys.Write(1, "circ nprof=", 11)
    PrintNumber(n)
    CAD_Sys.Write(1, "\n", 1)
    IfCondition NotEqual(n, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL isolated circle\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    nn = CAD_Sketch.GetProfileXY(sk3, 0, xy)
    IfCondition LessThan(nn, 16) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circle not a ring\n", 23)
        SystemCall(60, 1, 0, 0)
    }

    Deallocate(xy, 65536)
    CAD_Sys.Write(1, "PASS sketch plex profiles\n", 26)
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
