// Stadium (2 LINE + 2 half-CIRCLE) + inner hole. MeshSolid + sample every
// edge the way fillet pick does. Must not SEGV.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.CAD_Tess

SubRoutine.Main {
    CAD_Sys.Write(1, "=== stadium tess + pick sample ===\n", 35)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n40 = 0x4044000000000000
    n30 = 0x403E000000000000
    n20 = 0x4034000000000000
    n15 = 0x402E000000000000
    n0 = 0
    half_pi = 0x3FF921FB54442D18
    pi = 0x400921FB54442D18
    two_pi = 0x401921FB54442D18
    three_half = Float_Add(pi, half_pi)
    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = n20
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddLine(Float_Sub(0, n40), n30, n40, n30)
    CAD_Topo.SweepAddArc(n40, n0, n30, half_pi, three_half)
    CAD_Topo.SweepAddLine(n40, Float_Sub(0, n30), Float_Sub(0, n40), Float_Sub(0, n30))
    CAD_Topo.SweepAddArc(Float_Sub(0, n40), n0, n30, Float_Sub(0, half_pi), half_pi)
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddArc(n0, n0, n15, n0, two_pi)
    h = CAD_Topo.ExtrudeContours()
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo.RebuildKind0Planes(h)
    mesh = Allocate(48)
    nt = CAD_Tess.MeshSolid(h, 0, mesh)
    PrintMessage("mesh nv=")
    PrintMessage(" ")
    PrintNumber(ArrayGet(mesh, 0))
    PrintMessage(" nt=")
    PrintNumber(ArrayGet(mesh, 1))
    PrintMessage(" rc=")
    PrintNumber(nt)
    PrintMessage("\n")
    IfCondition LessThan(ArrayGet(mesh, 1), 8) ThenBlock: {
        CAD_Sys.Write(1, "FAIL mesh\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: {
        CAD_Tess_State.samp = Allocate(65536)
    }
    eds = Allocate(32768)
    ne = CAD_Topo.SolidCollectEdges(h, eds, 4096)
    PrintMessage("nedges=")
    PrintNumber(ne)
    PrintMessage("\n")
    ns_sum = 0
    i = 0
    WhileLoop LessThan(i, ne) {
        e = ArrayGet(eds, i)
        IfCondition NotEqual(e, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.IsLive(e), 1) ThenBlock: {
                cr = CAD_Store.Read(e, 2)
                ns = 0
                IfCondition NotEqual(cr, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(cr, 0), 2) ThenBlock: {
                        ns = CAD_Tess.SampleCircleEdge(e, 48, CAD_Tess_State.samp)
                    }
                }
                IfCondition EqualTo(ns, 0) ThenBlock: { ns = 2 }
                IfCondition GreaterThan(ns, 257) ThenBlock: {
                    CAD_Sys.Write(1, "FAIL sample overflow\n", 21)
                    SystemCall(60, 1, 0, 0)
                }
                ns_sum = Add(ns_sum, ns)
            }
        }
        i = Add(i, 1)
    }
    PrintMessage("sample sum=")
    PrintNumber(ns_sum)
    PrintMessage("\n")
    CAD_Sys.Write(1, "PASS stadium tess\n", 18)
    SystemCall(60, 0, 0, 0)
}
