// Regression: line×arc T-junction / crossing must register so arc trim can
// keep residual pieces (not delete the whole tip-to-tip arc).
// Mirrors CA_TrimAt arc join collect: PosMod2Pi span/dang + freehand tip tol.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== arc trim joins (T / cross) ===\n", 34)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    // --- 1) vertical line through upper semicircle (classic cross) ---
    sk = CAD_Sketch.CreateSketch(1)
    // arc center (0,0) R=10, CCW 0 → π (upper)
    CAD_Sketch.AddArc(sk, 0, 0, 0x4024000000000000, 0, 0x400921FB54442D18)
    // line x=0, y=-5..15 crosses at (0,10) — FPU neg (hex 0xC0… broken)
    five = 0x4014000000000000
    mfive = Float_Sub(0, five)
    CAD_Sketch.AddLine(sk, 0, mfive, 0, 0x402E000000000000)

    nanc = CAD_Sketch.RebuildAnchors(sk)
    pts = CAD_Store.Read(sk, 17)
    found = 0
    i = 0
    WhileLoop LessThan(i, nanc) {
        px = ArrayGet(pts, Multiply(i, 2))
        py = ArrayGet(pts, Add(Multiply(i, 2), 1))
        dx = px
        dy = Float_Sub(py, 0x4024000000000000)
        d2 = Float_Add(CAD_Num.Sq(dx), CAD_Num.Sq(dy))
        IfCondition EqualTo(Float_Le(d2, 0x3F50624DD2F1A9FC), 1) ThenBlock: {
            found = 1
        }
        i = Add(i, 1)
    }
    IfCondition EqualTo(found, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no anchor at upper arc cross\n", 34)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS anchor at arc-line cross\n", 30)

    // split the line at the arc hit → expect ≥2 pieces
    CAD_Sketch.SplitLineAtHits(sk, 0)
    nl = CAD_Sketch.GetLineCount(sk)
    IfCondition LessThan(nl, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL line not split at arc\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS line split at arc hit\n", 27)

    // --- 2) freehand-ish T: line tip near mid-arc (not exact rim) ---
    // arc R=10, 0→π; tip near (0,10) but short by ~0.3 world
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddArc(sk2, 0, 0, 0x4024000000000000, 0, 0x400921FB54442D18)
    // line from (0,0) to (0, 9.7) — tip just short of rim at y=10
    CAD_Sketch.AddLine(sk2, 0, 0, 0, 0x4023666666666666)

    // Collect interior arc-param ts the way CA_TrimAt does
    arcs = CAD_Store.Read(sk2, 11)
    cx = ArrayGet(arcs, 0)
    cy = ArrayGet(arcs, 1)
    rad = ArrayGet(arcs, 2)
    a0 = ArrayGet(arcs, 3)
    a1 = ArrayGet(arcs, 4)
    span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
    one = 0x3FF0000000000000
    eps = 0x3F50624DD2F1A9FC
    // freehand jtol = max(0.5, 2% rad) — like hit_lim-ish
    jtol = 0x3FE0000000000000
    jrad = Float_Mul(rad, 0x3F847AE147AE147B)
    IfCondition EqualTo(Float_Le(jtol, jrad), 1) ThenBlock: { jtol = jrad }

    ts = Allocate(64)
    ArraySet(ts, 0, 0)
    ArraySet(ts, 1, one)
    nt = 2

    lines = CAD_Store.Read(sk2, 1)
    x0 = ArrayGet(lines, 0)
    y0 = ArrayGet(lines, 1)
    x1 = ArrayGet(lines, 2)
    y1 = ArrayGet(lines, 3)
    // endpoint on rim within jtol
    ei = 0
    WhileLoop LessThan(ei, 2) {
        IfCondition EqualTo(ei, 0) ThenBlock: {
            px = x0
            py = y0
        }
        IfCondition EqualTo(ei, 1) ThenBlock: {
            px = x1
            py = y1
        }
        d = CAD_Num.Hypot2(Float_Sub(px, cx), Float_Sub(py, cy))
        dd = CAD_Num.Abs(Float_Sub(d, rad))
        IfCondition EqualTo(Float_Le(dd, jtol), 1) ThenBlock: {
            ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
            dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
            IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: {
                tt = Float_Div(dang, span)
                IfCondition EqualTo(Float_Le(tt, eps), 0) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(one, tt), eps), 0) ThenBlock: {
                        ArraySet(ts, nt, tt)
                        nt = Add(nt, 1)
                    }
                }
            }
        }
        ei = Add(ei, 1)
    }
    // geometric isect too
    dx = Float_Sub(x1, x0)
    dy = Float_Sub(y1, y0)
    fx = Float_Sub(x0, cx)
    fy = Float_Sub(y0, cy)
    aa = Float_Add(CAD_Num.Sq(dx), CAD_Num.Sq(dy))
    bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, dx, dy))
    cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
    disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, aa), cc))
    IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
        s = CAD_Num.Sqrt(disc)
        two_a = Float_Mul(0x4000000000000000, aa)
        ht0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
        ht1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
        hi = 0
        WhileLoop LessThan(hi, 2) {
            tline = ht0
            IfCondition EqualTo(hi, 1) ThenBlock: { tline = ht1 }
            ok = 1
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Add(tline, eps)), 1) ThenBlock: { ok = 0 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Add(one, eps), tline)), 1) ThenBlock: { ok = 0 }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                px = Float_Add(x0, Float_Mul(tline, dx))
                py = Float_Add(y0, Float_Mul(tline, dy))
                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: {
                    tt = Float_Div(dang, span)
                    IfCondition EqualTo(Float_Le(tt, eps), 0) ThenBlock: {
                        IfCondition EqualTo(Float_Le(Float_Sub(one, tt), eps), 0) ThenBlock: {
                            ArraySet(ts, nt, tt)
                            nt = Add(nt, 1)
                        }
                    }
                }
            }
            hi = Add(hi, 1)
        }
    }
    Deallocate(ts, 64)
    // need at least one interior join (nt >= 3 with 0 and 1 endpoints)
    IfCondition LessThan(nt, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL T-junction not interior on arc\n", 36)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS T-junction interior join on arc\n", 37)

    // --- 3) diagonal cross (matches user triangle-through-arc case) ---
    // arc center (2,2) R=5, angles spanning SW→NE so dang wrap matters
    sk3 = CAD_Sketch.CreateSketch(1)
    // a0 = -2.5 (approx), a1 = 1.0 — force negative a0 via Atan2 points
    // Use a0=-π/2, a1=π/2 (left→right upper via north) — span=π
    // Actually a0 = 3π/4, a1 = π/4 wrap: PosMod2Pi(π/4 - 3π/4) = PosMod2Pi(-π/2)=3π/2
    // a0 = 3π/4, a1 = π/4 → CCW span 3π/2 (wraps across 0)
    a0w = 0x4002D97C7F3321D2
    a1w = 0x3FE921FB54442D18
    CAD_Sketch.AddArc(sk3, 0, 0, 0x4014000000000000, a0w, a1w)
    // line from (-6,-6) to (6,6) through origin — FPU neg
    six = 0x4018000000000000
    msix = Float_Sub(0, six)
    CAD_Sketch.AddLine(sk3, msix, msix, six, six)

    CAD_Sketch.RebuildAnchors(sk3)
    CAD_Sketch.SplitLineAtHits(sk3, 0)
    nl3 = CAD_Sketch.GetLineCount(sk3)
    IfCondition LessThan(nl3, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL diagonal not split at wrapped arc\n", 39)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS diagonal split on wrapped arc span\n", 40)

    // collect arc interior joins for that wrapped arc (same math as CA_TrimAt)
    arcs = CAD_Store.Read(sk3, 11)
    cx = ArrayGet(arcs, 0)
    cy = ArrayGet(arcs, 1)
    rad = ArrayGet(arcs, 2)
    a0 = ArrayGet(arcs, 3)
    a1 = ArrayGet(arcs, 4)
    span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
    lines = CAD_Store.Read(sk3, 1)
    // use first remaining long-ish segment; re-read original by re-adding
    // re-create clean sketch for collect
    sk4 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddArc(sk4, 0, 0, 0x4014000000000000, a0w, a1w)
    CAD_Sketch.AddLine(sk4, msix, msix, six, six)
    arcs = CAD_Store.Read(sk4, 11)
    cx = ArrayGet(arcs, 0)
    cy = ArrayGet(arcs, 1)
    rad = ArrayGet(arcs, 2)
    a0 = ArrayGet(arcs, 3)
    a1 = ArrayGet(arcs, 4)
    span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
    lines = CAD_Store.Read(sk4, 1)
    x0 = ArrayGet(lines, 0)
    y0 = ArrayGet(lines, 1)
    x1 = ArrayGet(lines, 2)
    y1 = ArrayGet(lines, 3)
    dx = Float_Sub(x1, x0)
    dy = Float_Sub(y1, y0)
    fx = Float_Sub(x0, cx)
    fy = Float_Sub(y0, cy)
    aa = Float_Add(CAD_Num.Sq(dx), CAD_Num.Sq(dy))
    bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, dx, dy))
    cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
    disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, aa), cc))
    njoin = 0
    IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
        s = CAD_Num.Sqrt(disc)
        two_a = Float_Mul(0x4000000000000000, aa)
        ht0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
        ht1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
        hi = 0
        WhileLoop LessThan(hi, 2) {
            tline = ht0
            IfCondition EqualTo(hi, 1) ThenBlock: { tline = ht1 }
            ok = 1
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Add(tline, eps)), 1) ThenBlock: { ok = 0 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Add(one, eps), tline)), 1) ThenBlock: { ok = 0 }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                px = Float_Add(x0, Float_Mul(tline, dx))
                py = Float_Add(y0, Float_Mul(tline, dy))
                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: {
                    tt = Float_Div(dang, span)
                    IfCondition EqualTo(Float_Le(tt, eps), 0) ThenBlock: {
                        IfCondition EqualTo(Float_Le(Float_Sub(one, tt), eps), 0) ThenBlock: {
                            njoin = Add(njoin, 1)
                        }
                    }
                }
            }
            hi = Add(hi, 1)
        }
    }
    // expect 1 interior join on the wrapped arc (the NE crossing; SW may be off-span)
    IfCondition LessThan(njoin, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no interior join on wrapped arc\n", 38)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS interior join on wrapped arc\n", 34)

    CAD_Sys.Write(1, "ARC TRIM JOINS OK\n", 18)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
