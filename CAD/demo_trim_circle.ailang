// Regression: trim must NOT explode live circles into polylines.
// Line through circle → SplitAtIntersections cuts at rim; DeleteLine removes stub.
// Circle with crossings → trim becomes arcs (n_circles drops, n_arcs grows).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== trim keeps circles clean ===\n", 33)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    // --- 1) single line through circle: split at 2 rim hits ---
    sk = CAD_Sketch.CreateSketch(1)
    // circle R=5 at origin
    CAD_Sketch.AddCircle(sk, 0, 0, 0x4014000000000000)
    // horizontal line (-10,0)-(10,0) through circle
    CAD_Sketch.AddLine(sk, 0xC024000000000000, 0, 0x4024000000000000, 0)
    nl0 = CAD_Sketch.GetLineCount(sk)
    nc0 = CAD_Sketch.GetCircleCount(sk)
    IfCondition NotEqual(nl0, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL setup line count\n", 22)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(nc0, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL setup circle count\n", 24)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sketch.RebuildAnchors(sk)
    nsplit = CAD_Sketch.SplitAtIntersections(sk)
    // expect 3 pieces: left overshoot, chord, right overshoot
    IfCondition LessThan(nsplit, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL split line@circle expected >=3 segs\n", 41)
        SystemCall(60, 1, 0, 0)
    }
    // circle must still be a circle entity (not tessellated)
    IfCondition NotEqual(CAD_Sketch.GetCircleCount(sk), 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circle exploded by split\n", 30)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS line split at circle rim\n", 30)

    // delete right overshoot: piece with both x > 0 roughly
    // find segment with midpoint x > 5
    lines = CAD_Store.Read(sk, 1)
    nl = CAD_Sketch.GetLineCount(sk)
    found = 0
    fi = 0
    i = 0
    WhileLoop LessThan(i, nl) {
        b = Multiply(i, 4)
        x0 = ArrayGet(lines, b)
        x1 = ArrayGet(lines, Add(b, 2))
        mx = Float_Mul(0x3FE0000000000000, Float_Add(x0, x1))
        // mx > 5
        IfCondition EqualTo(Float_Le(0x4014000000000000, mx), 1) ThenBlock: {
            found = 1
            fi = i
        }
        i = Add(i, 1)
    }
    IfCondition EqualTo(found, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no right stub to trim\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sketch.DeleteLine(sk, fi)
    // still a clean circle
    IfCondition NotEqual(CAD_Sketch.GetCircleCount(sk), 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circle lost after line trim\n", 33)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS line stub trim keeps circle\n", 33)

    // --- 2) two circles overlap: intersection angles exist ---
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(sk2, 0, 0, 0x4014000000000000)
    // second circle center (6,0) R=5 — crosses first
    CAD_Sketch.AddCircle(sk2, 0x4018000000000000, 0, 0x4014000000000000)
    CAD_Sketch.RebuildAnchors(sk2)
    npt = CAD_Sketch.GetPointCount(sk2)
    // circle×circle should produce 2 anchors
    IfCondition LessThan(npt, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circle×circle anchors\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    // both still circles (no tessellation)
    IfCondition NotEqual(CAD_Sketch.GetCircleCount(sk2), 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circles not intact\n", 24)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS multi-circle anchors keep entities\n", 40)

    // --- 3) convert circle to arcs at 2 angles (simulate circle trim keep) ---
    sk3 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(sk3, 0, 0, 0x4014000000000000)
    // force two split angles via a diameter line
    CAD_Sketch.AddLine(sk3, 0xC024000000000000, 0, 0x4024000000000000, 0)
    CAD_Sketch.RebuildAnchors(sk3)
    CAD_Sketch.SplitAtIntersections(sk3)
    // replace circle with two semicircle arcs (keep both — not deleting sector)
    two_pi = 0x401921FB54442D18
    pi = 0x400921FB54442D18
    CAD_Sketch.DeleteCircle(sk3, 0)
    CAD_Sketch.AddArc(sk3, 0, 0, 0x4014000000000000, 0, pi)
    CAD_Sketch.AddArc(sk3, 0, 0, 0x4014000000000000, pi, two_pi)
    IfCondition NotEqual(CAD_Sketch.GetCircleCount(sk3), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circle not deleted\n", 24)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Sketch.GetArcCount(sk3), 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected 2 arcs\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sketch.DeleteArc(sk3, 0)
    IfCondition NotEqual(CAD_Sketch.GetArcCount(sk3), 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL DeleteArc\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS circle→arcs + DeleteArc\n", 29)

    CAD_Sys.Write(1, "TRIM CIRCLE OK\n", 15)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
