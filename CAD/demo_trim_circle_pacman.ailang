// Circle + 2 overshooting radials. Trim the mouth → remaining arc + lines.
// Old path: Sqrt clobber → 0 cuts → "trimmed full circle".
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== trim circle pacman ===\n", 27)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)

    sk = CAD_Sketch.CreateSketch(1)
    z = 0
    p50 = 0x4049000000000000
    p25 = 0x4039000000000000
    p90 = 0x4056800000000000
    p38 = 0x4043000000000000
    p75 = 0x4052C00000000000
    CAD_Sketch.AddCircle(sk, p50, p50, p25)
    CAD_Sketch.AddLine(sk, p50, p50, p90, p90)
    CAD_Sketch.AddLine(sk, p50, p50, p90, p38)

    rc = CAD_Sketch.TrimAt(sk, p75, p50, 0x4024000000000000)
    CAD_Sys.Write(1, "center-radials rc=", 18)
    PrintNumber(rc)
    CAD_Sys.Write(1, "\n", 1)
    IfCondition NotEqual(rc, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL center radials rc!=3\n", 26)
        SystemCall(60, 1, 0, 0)
    }

    // chords that do NOT start at the center (live user case)
    sk2 = CAD_Sketch.CreateSketch(1)
    p200 = 0x4069000000000000
    CAD_Sketch.AddCircle(sk2, p200, p200, p50)
    CAD_Sketch.AddLine(sk2, 0x4064000000000000, 0x4000000000000000, 0x4068C00000000000, 0x406CC00000000000)
    CAD_Sketch.AddLine(sk2, 0x4065A00000000000, 0x4068800000000000, 0x4073D00000000000, 0x4071900000000000)
    rc = CAD_Sketch.TrimAt(sk2, 0x406F400000000000, p200, 0x4024000000000000)
    CAD_Sys.Write(1, "chords rc=", 10)
    PrintNumber(rc)
    CAD_Sys.Write(1, " na=", 4)
    PrintNumber(CAD_Sketch.GetArcCount(sk2))
    CAD_Sys.Write(1, " nc=", 4)
    PrintNumber(CAD_Sketch.GetCircleCount(sk2))
    CAD_Sys.Write(1, " nang=", 6)
    PrintNumber(CAD_Sketch_TrimDbg.nang)
    CAD_Sys.Write(1, "\n", 1)
    IfCondition NotEqual(rc, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected circle->arcs (rc=3)\n", 34)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Sketch.GetCircleCount(sk2), 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circle still whole\n", 24)
        SystemCall(60, 1, 0, 0)
    }
    n = CAD_Sketch.ProfCompile(sk)
    CAD_Sys.Write(1, "nprof=", 6)
    PrintNumber(n)
    CAD_Sys.Write(1, "\n", 1)
    IfCondition LessThan(n, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL no profile after trim\n", 27)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS trim circle pacman\n", 24)
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
