// Regression: line trim at intersection + multi-profile pick index.
// Circle + offset rect → 2 profiles; PrepareExtrude must find both.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== trim + multi-profile ===\n", 30)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    // --- trim: horizontal crossed by vertical T ---
    sk = CAD_Sketch.CreateSketch(1)
    // H: (0,0)-(20,0)  V: (10,-5)-(10,5) crosses mid
    CAD_Sketch.AddLine(sk, 0, 0, 0x4034000000000000, 0)
    CAD_Sketch.AddLine(sk, 0x4024000000000000, 0xC014000000000000, 0x4024000000000000, 0x4014000000000000)
    // trim right half of H: click (15, 0)
    // use same logic as CA_TrimAt via manual Set after intersection
    // Verify Seg would find cross: after DeleteLine right, left remains (0,0)-(10,0)
    nl0 = CAD_Sketch.GetLineCount(sk)
    IfCondition NotEqual(nl0, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL setup lines\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    // split H at mid: set first line to left half, add nothing for right (simulating trim)
    CAD_Sketch.SetLine(sk, 0, 0, 0, 0x4024000000000000, 0)
    x1 = ArrayGet(CAD_Store.Read(sk, 1), 2)
    IfCondition EqualTo(CAD_Num.IsEqual(x1, 0x4024000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL SetLine\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sketch.DeleteLine(sk, 1)
    IfCondition NotEqual(CAD_Sketch.GetLineCount(sk), 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL DeleteLine\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS SetLine/DeleteLine\n", 24)

    // --- multi-profile: circle + separate closed rect ---
    sk2 = CAD_Sketch.CreateSketch(1)
    // circle R=5 at origin
    CAD_Sketch.AddCircle(sk2, 0, 0, 0x4014000000000000)
    // rect far away [20..30] x [20..30] — closed
    CAD_Sketch.AddLine(sk2, 0x4034000000000000, 0x4034000000000000, 0x403E000000000000, 0x4034000000000000)
    CAD_Sketch.AddLine(sk2, 0x403E000000000000, 0x4034000000000000, 0x403E000000000000, 0x403E000000000000)
    CAD_Sketch.AddLine(sk2, 0x403E000000000000, 0x403E000000000000, 0x4034000000000000, 0x403E000000000000)
    CAD_Sketch.AddLine(sk2, 0x4034000000000000, 0x403E000000000000, 0x4034000000000000, 0x4034000000000000)
    nprof = CAD_Sketch.PrepareExtrude(sk2)
    IfCondition LessThan(nprof, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL expected 2 profiles (circle+rect)\n", 40)
        SystemCall(60, 1, 0, 0)
    }
    // select profile 1 (usually smaller rect after largest swap to 0)
    nn = CAD_Sketch.SelectProfile(sk2, 1)
    IfCondition LessThan(nn, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL SelectProfile 1\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Store.Write(sk2, 12, 1)
    h = CAD_Feat.ExtrudeProfile(sk2, 0x4024000000000000)
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL pad selected rect profile\n", 31)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS multi-profile select pad\n", 30)

    CAD_Sys.Write(1, "TRIM PICK OK\n", 13)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
