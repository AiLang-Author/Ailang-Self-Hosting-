// Rectangle + two holes (circle and triangle). Both inners must stay on the cap.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Blend

SubRoutine.Main {
    CAD_Sys.Write(1, "=== rect + two holes ===\n", 25)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = 0x4034000000000000
    w = 0x4044000000000000
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddLine(Float_Sub(0, w), Float_Sub(0, w), w, Float_Sub(0, w))
    CAD_Topo.SweepAddLine(w, Float_Sub(0, w), w, w)
    CAD_Topo.SweepAddLine(w, w, Float_Sub(0, w), w)
    CAD_Topo.SweepAddLine(Float_Sub(0, w), w, Float_Sub(0, w), Float_Sub(0, w))
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddArc(0xC034000000000000, 0xC034000000000000, 0x4024000000000000, 0, 0x401921FB54442D18)
    s = 0x4024000000000000
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddLine(0x4024000000000000, 0x4034000000000000, 0x4000000000000000, 0x4000000000000000)
    CAD_Topo.SweepAddLine(0x4000000000000000, 0x4000000000000000, 0x4044000000000000, 0x4000000000000000)
    CAD_Topo.SweepAddLine(0x4044000000000000, 0x4000000000000000, 0x4024000000000000, 0x4034000000000000)
    PrintMessage("ncont=")
    PrintNumber(CAD_Topo_Sweep.ncont)
    PrintMessage("\n")
    h = CAD_Topo.ExtrudeContours()
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    PrintMessage("nf=")
    PrintNumber(CAD_Topo_Sweep.nf)
    PrintMessage("\n")
    CAD_Topo_Sweep.out = CAD_Store.Read(h, 0)
    CAD_Topo_Sweep.lp0 = CAD_Store.Read(CAD_Topo_Sweep.out, 0)
    fi = 0
    ninn = 0
    WhileLoop NotEqual(CAD_Topo_Sweep.lp0, 0) {
        CAD_Topo_Sweep.lp1 = CAD_Store.Read(CAD_Topo_Sweep.lp0, 1)
        nce = 0
        ni = 0
        IfCondition NotEqual(CAD_Topo_Sweep.lp1, 0) ThenBlock: {
            nce = CAD_Topo.LoopCountCoedges(CAD_Topo_Sweep.lp1)
            CAD_Topo_Sweep.lph = CAD_Store.Read(CAD_Topo_Sweep.lp1, 2)
            WhileLoop NotEqual(CAD_Topo_Sweep.lph, 0) {
                ni = Add(ni, 1)
                CAD_Topo_Sweep.lph = CAD_Store.Read(CAD_Topo_Sweep.lph, 2)
                IfCondition GreaterThan(ni, 8) ThenBlock: { CAD_Topo_Sweep.lph = 0 }
            }
        }
        IfCondition EqualTo(fi, 0) ThenBlock: { ninn = ni }
        PrintMessage("face ")
        PrintNumber(fi)
        PrintMessage(" nce=")
        PrintNumber(nce)
        PrintMessage(" ninner=")
        PrintNumber(ni)
        PrintMessage(" next=")
        PrintNumber(CAD_Store.Read(CAD_Topo_Sweep.lp0, 3))
        PrintMessage("\n")
        CAD_Topo_Sweep.lp0 = CAD_Store.Read(CAD_Topo_Sweep.lp0, 3)
        fi = Add(fi, 1)
        IfCondition GreaterThan(fi, 32) ThenBlock: { CAD_Topo_Sweep.lp0 = 0 }
    }
    IfCondition LessThan(ninn, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL cap missing second inner\n", 30)
        SystemCall(60, 1, 0, 0)
    }
    mesh = Allocate(32)
    nt = CAD_Tess.MeshSolid(h, 0x3FB999999999999A, mesh)
    PrintMessage("mesh nt=")
    PrintNumber(nt)
    PrintMessage(" nv=")
    PrintNumber(ArrayGet(mesh, 0))
    PrintMessage("\n")
    IfCondition LessThan(nt, 120) ThenBlock: {
        CAD_Sys.Write(1, "FAIL too few tris\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "DONE\n", 5)
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
