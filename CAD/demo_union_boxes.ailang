// Union fuse of two face-adjacent boxes → compound multi-body → STEP walk.

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=== box Union fuse STEP ===\n", 28)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    // A: 20x20x10 at origin
    a = CAD_Script.CreateBox(0x4034000000000000, 0x4034000000000000, 0x4024000000000000)
    // B: 20x20x10 adjacent on +X (share face x=20)
    mn = Allocate(32)
    mx = Allocate(32)
    out = Allocate(16)
    ArraySet(mn, 0, 0x4034000000000000)
    ArraySet(mn, 1, 0)
    ArraySet(mn, 2, 0)
    ArraySet(mx, 0, 0x4044000000000000)
    ArraySet(mx, 1, 0x4034000000000000)
    ArraySet(mx, 2, 0x4024000000000000)
    b = CAD_Topo.MakeBoxSolid(mn, mx, out)
    Deallocate(mn, 32)
    Deallocate(mx, 32)
    Deallocate(out, 16)
    IfCondition EqualTo(b, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL box B\n", 11)
        SystemCall(60, 1, 0, 0)
    }
    u = CAD_Bool.Union(a, b)
    IfCondition EqualTo(u, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL Union fuse\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Store.Read(u, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL Union no shell\n", 20)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_IO.ExportSTEP(u, "test-stl/cad_union_boxes.stp"), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL Union STEP\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "wrote union-boxes.stp (40x20x10)\n", 33)
    CAD_Sys.Write(1, "UNION BREP OK\n", 14)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
