// Exact plane isects: V (left + right) × circle and × arc must BOTH get joins.
// No freehand invent — coords only.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    CAD_Sys.Write(1, "=== V arms exact join (circle + arc) ===\n", 42)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    // --- 1) full circle R=10 at origin; V of two secants ---
    // left arm:  (-8,12) → (0,-4)  crosses circle twice ideally, at least once upper
    // right arm: ( 8,12) → (0,-4)
    sk = CAD_Sketch.CreateSketch(1)
    ten = 0x4024000000000000
    CAD_Sketch.AddCircle(sk, 0, 0, ten)

    eight = 0x4020000000000000
    twelve = 0x4028000000000000
    four = 0x4010000000000000
    m8 = Float_Sub(0, eight)
    m4 = Float_Sub(0, four)
    CAD_Sketch.AddLine(sk, m8, twelve, 0, m4)
    CAD_Sketch.AddLine(sk, eight, twelve, 0, m4)

    nanc = CAD_Sketch.RebuildAnchors(sk)
    // count anchors on circle rim |d-r| < 0.05 that are not the V apex
    pts = CAD_Store.Read(sk, 17)
    left_join = 0
    right_join = 0
    i = 0
    WhileLoop LessThan(i, nanc) {
        px = ArrayGet(pts, Multiply(i, 2))
        py = ArrayGet(pts, Add(Multiply(i, 2), 1))
        d = CAD_Num.Hypot2(px, py)
        dd = CAD_Num.Abs(Float_Sub(d, ten))
        IfCondition EqualTo(Float_Le(dd, 0x3FB999999999999A), 1) ThenBlock: {
            // left half-plane join
            IfCondition EqualTo(CAD_Num.IsNeg(px), 1) ThenBlock: {
                left_join = Add(left_join, 1)
            }
            // right half-plane join (px > +eps)
            IfCondition EqualTo(CAD_Num.IsNeg(px), 0) ThenBlock: {
                IfCondition EqualTo(Float_Le(px, 0x3F50624DD2F1A9FC), 0) ThenBlock: {
                    right_join = Add(right_join, 1)
                }
            }
        }
        i = Add(i, 1)
    }
    IfCondition LessThan(left_join, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circle: no left-arm join\n", 31)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition LessThan(right_join, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circle: no right-arm join\n", 32)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS circle V both arms join\n", 30)

    // --- 2) upper semicircle arc 0→π; same V ---
    sk2 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddArc(sk2, 0, 0, ten, 0, 0x400921FB54442D18)
    CAD_Sketch.AddLine(sk2, m8, twelve, 0, m4)
    CAD_Sketch.AddLine(sk2, eight, twelve, 0, m4)
    CAD_Sketch.RebuildAnchors(sk2)
    nanc = CAD_Sketch.GetPointCount(sk2)
    pts = CAD_Store.Read(sk2, 17)
    left_join = 0
    right_join = 0
    i = 0
    // rim tol 0.5 world — exact isect should land |d-r|~0
    rimm = 0x3FE0000000000000
    WhileLoop LessThan(i, nanc) {
        px = ArrayGet(pts, Multiply(i, 2))
        py = ArrayGet(pts, Add(Multiply(i, 2), 1))
        d = CAD_Num.Hypot2(px, py)
        dd = CAD_Num.Abs(Float_Sub(d, ten))
        IfCondition EqualTo(Float_Le(dd, rimm), 1) ThenBlock: {
            // left half (px < -0.5)
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Add(px, rimm)), 1) ThenBlock: {
                left_join = Add(left_join, 1)
            }
            // right half (px > +0.5)
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(px, rimm)), 0) ThenBlock: {
                IfCondition EqualTo(Float_Le(px, rimm), 0) ThenBlock: {
                    right_join = Add(right_join, 1)
                }
            }
        }
        i = Add(i, 1)
    }
    // also prove left arm splits at the arc hit
    CAD_Sketch.SplitLineAtHits(sk2, 0)
    nl_left = CAD_Sketch.GetLineCount(sk2)
    IfCondition LessThan(left_join, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL arc: no left-arm join\n", 28)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition LessThan(right_join, 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL arc: no right-arm join\n", 29)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition LessThan(nl_left, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL arc: left line not split\n", 31)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS arc V both arms join\n", 27)

    // --- 3) trim must never nuke a line when joins missing (no status-6 fallback) ---
    sk3 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddArc(sk3, 0, 0, ten, 0, 0x400921FB54442D18)
    five = 0x4014000000000000
    mfive = Float_Sub(0, five)
    CAD_Sketch.AddLine(sk3, 0, mfive, 0, 0x402E000000000000)
    CAD_Sketch.RebuildAnchors(sk3)
    nl0 = CAD_Sketch.GetLineCount(sk3)
    // click mid upper arc at (0,10)
    rc = CAD_Sketch.TrimAt(sk3, 0, ten, 0x3FF0000000000000)
    nl1 = CAD_Sketch.GetLineCount(sk3)
    IfCondition NotEqual(nl0, nl1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL trim deleted/changed lines\n", 33)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(rc, 6) ThenBlock: {
        CAD_Sys.Write(1, "FAIL trim nuked line stub (status 6)\n", 38)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "PASS trim did not cut unrelated lines\n", 39)

    CAD_Sys.Write(1, "=== all V exact-join checks passed ===\n", 41)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
