// 7-line V-notch plate matching the live sketch (100x100, tip at origin).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Blend

SubRoutine.Main {
    CAD_Sys.Write(1, "=== v-notch pad ===\n", 19)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    n50 = 0x4049000000000000
    n12 = 0x4028000000000000
    n15 = 0x402E000000000000
    n20 = 0x4034000000000000
    CAD_Topo.SweepReset()
    CAD_Topo_Sweep.hz = n20
    CAD_Topo.SweepBeginWire()
    CAD_Topo.SweepAddLine(Float_Sub(0, n50), Float_Sub(0, n50), n50, Float_Sub(0, n50))
    CAD_Topo.SweepAddLine(n50, Float_Sub(0, n50), n50, n50)
    CAD_Topo.SweepAddLine(n50, n50, n12, n50)
    CAD_Topo.SweepAddLine(n12, n50, 0, 0)
    CAD_Topo.SweepAddLine(0, 0, Float_Sub(0, n15), n50)
    CAD_Topo.SweepAddLine(Float_Sub(0, n15), n50, Float_Sub(0, n50), n50)
    CAD_Topo.SweepAddLine(Float_Sub(0, n50), n50, Float_Sub(0, n50), Float_Sub(0, n50))
    PrintMessage("ncurve=")
    PrintNumber(CAD_Topo_Sweep.ncurve)
    PrintMessage("\n")
    h = CAD_Topo.ExtrudeContours()
    IfCondition EqualTo(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Topo.RebuildKind0Planes(h)
    sh = CAD_Store.Read(h, 0)
    fi = 0
    WhileLoop NotEqual(sh, 0) {
        fc = CAD_Store.Read(sh, 0)
        WhileLoop NotEqual(fc, 0) {
            lp = CAD_Store.Read(fc, 1)
            nce = 0
            IfCondition NotEqual(lp, 0) ThenBlock: {
                nce = CAD_Topo.LoopCountCoedges(lp)
            }
            sk = 0
            sf = CAD_Store.Read(fc, 0)
            IfCondition NotEqual(sf, 0) ThenBlock: { sk = CAD_Store.Read(sf, 0) }
            PrintMessage("face ")
            PrintNumber(fi)
            PrintMessage(" nce=")
            PrintNumber(nce)
            PrintMessage(" kind=")
            PrintNumber(sk)
            PrintMessage("\n")
            fi = Add(fi, 1)
            fc = CAD_Store.Read(fc, 3)
            IfCondition GreaterThan(fi, 20) ThenBlock: { fc = 0 }
        }
        sh = 0
    }
    mesh = Allocate(32)
    CAD_Tess.MeshSolid(h, 0x3FB999999999999A, mesh)
    PrintMessage("mesh nt=")
    PrintNumber(ArrayGet(mesh, 1))
    PrintMessage(" nv=")
    PrintNumber(ArrayGet(mesh, 0))
    PrintMessage("\n")
    vb = ArrayGet(mesh, 2)
    ib = ArrayGet(mesh, 3)
    ti = 0
    WhileLoop LessThan(ti, ArrayGet(mesh, 1)) {
        i0 = ArrayGet(ib, Multiply(ti, 3))
        i1 = ArrayGet(ib, Add(Multiply(ti, 3), 1))
        i2 = ArrayGet(ib, Add(Multiply(ti, 3), 2))
        PrintMessage("tri ")
        PrintNumber(ti)
        PrintMessage(" z=")
        PrintNumber(Float_ToInt(ArrayGet(vb, Add(Multiply(i0, 3), 2))))
        PrintMessage(" x0=")
        PrintNumber(Float_ToInt(ArrayGet(vb, Multiply(i0, 3))))
        PrintMessage(",")
        PrintNumber(Float_ToInt(ArrayGet(vb, Add(Multiply(i0, 3), 1))))
        PrintMessage(" x1=")
        PrintNumber(Float_ToInt(ArrayGet(vb, Multiply(i1, 3))))
        PrintMessage(",")
        PrintNumber(Float_ToInt(ArrayGet(vb, Add(Multiply(i1, 3), 1))))
        PrintMessage(" x2=")
        PrintNumber(Float_ToInt(ArrayGet(vb, Multiply(i2, 3))))
        PrintMessage(",")
        PrintNumber(Float_ToInt(ArrayGet(vb, Add(Multiply(i2, 3), 1))))
        PrintMessage("\n")
        ti = Add(ti, 1)
    }
    CAD_Sys.Write(1, "DONE\n", 5)
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
