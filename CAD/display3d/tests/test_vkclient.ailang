// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.VulkanClient

FixedPool.T {
    "failed": Initialize=0, CanChange=True
}

Function.T_Write {
    Input: msg: Address
    Input: n: Integer
    Output: Integer
    Body: {
        PrintMessage(msg)
        ReturnValue(0)
    }
}

SubRoutine.Main {
    h = VulkanClient.Open("CAD/display3d/vk_worker")
    IfCondition EqualTo(h, 0) ThenBlock: {
        T_Write("[FAIL] Open\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    T_Write("[PASS] Open\n", 12)

    st = VulkanClient.Init(h, "VulkanClient gate")
    IfCondition NotEqual(st, 0) ThenBlock: {
        T_Write("[FAIL] Init\n", 12)
        T.failed = Add(T.failed, 1)
    }
    IfCondition EqualTo(st, 0) ThenBlock: {
        T_Write("[PASS] Init\n", 12)
    }

    rd = VulkanClient.Ready(h)
    IfCondition EqualTo(rd, 0) ThenBlock: {
        T_Write("[FAIL] Ready\n", 13)
        T.failed = Add(T.failed, 1)
    }
    IfCondition NotEqual(rd, 0) ThenBlock: {
        T_Write("[PASS] Ready\n", 13)
    }

    st = VulkanClient.CreateTarget(h, 64, 48)
    IfCondition NotEqual(st, 0) ThenBlock: {
        T_Write("[FAIL] CreateTarget\n", 20)
        T.failed = Add(T.failed, 1)
    }
    IfCondition EqualTo(st, 0) ThenBlock: {
        T_Write("[PASS] CreateTarget\n", 20)
    }

    st = VulkanClient.BeginFrame(h, 255, 0, 128)
    IfCondition NotEqual(st, 0) ThenBlock: {
        T_Write("[FAIL] BeginFrame\n", 18)
        T.failed = Add(T.failed, 1)
    }
    IfCondition EqualTo(st, 0) ThenBlock: {
        T_Write("[PASS] BeginFrame\n", 18)
    }

    st = VulkanClient.EndFrame(h)
    IfCondition NotEqual(st, 0) ThenBlock: {
        T_Write("[FAIL] EndFrame\n", 16)
        T.failed = Add(T.failed, 1)
    }
    IfCondition EqualTo(st, 0) ThenBlock: {
        T_Write("[PASS] EndFrame\n", 16)
    }

    fb = Allocate(12288)
    st = VulkanClient.Readback(h, fb, 12288)
    IfCondition NotEqual(st, 0) ThenBlock: {
        T_Write("[FAIL] Readback\n", 16)
        T.failed = Add(T.failed, 1)
    }
    IfCondition EqualTo(st, 0) ThenBlock: {
        bb = GetByte(fb, 0)
        gg = GetByte(fb, 1)
        rr = GetByte(fb, 2)
        IfCondition LessThan(rr, 250) ThenBlock: {
            T_Write("[FAIL] pixel R\n", 15)
            T.failed = Add(T.failed, 1)
        }
        IfCondition NotEqual(gg, 0) ThenBlock: {
            T_Write("[FAIL] pixel G\n", 15)
            T.failed = Add(T.failed, 1)
        }
        IfCondition LessThan(bb, 120) ThenBlock: {
            T_Write("[FAIL] pixel B\n", 15)
            T.failed = Add(T.failed, 1)
        }
        IfCondition GreaterThan(bb, 136) ThenBlock: {
            T_Write("[FAIL] pixel B\n", 15)
            T.failed = Add(T.failed, 1)
        }
        IfCondition EqualTo(T.failed, 0) ThenBlock: {
            T_Write("[PASS] magenta clear pixel\n", 27)
        }
    }
    Deallocate(fb, 12288)

    VulkanClient.Close(h)

    IfCondition GreaterThan(T.failed, 0) ThenBlock: {
        T_Write("VKCLIENT FAILED\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    T_Write("VKCLIENT PASSED\n", 16)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
