// CAD Kernel — Fusion 360 / Inventor DXF Sketch-Driven Pipeline Engine (§7.3, §11 Phase 8)
// 1. Import 2D Sketch Geometry from Fusion 360 / Inventor ASCII DXF File
// 2. Extrude 2D Sketch Profile with Inner Hole Loop into 3D Solid Model
// 3. Export Watertight STEP AP214 & STL 3D Geometry
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Script

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   AILang CAD Kernel — DXF Sketch-Driven Engine v1.0 \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    // Allocate memory for DXF imported sketch handle
    h_sketch_addr = Allocate(8)

    // 1. Import 2D DXF Sketch from Fusion 360 / Inventor
    CAD_Sys.Write(1, "[DXF PIPELINE] Importing sample_fusion_sketch.dxf...\n", 53)
    ret_imp = CAD_IO.ImportDXF("sample_fusion_sketch.dxf", h_sketch_addr)
    h_dxf_sketch = ArrayGet(h_sketch_addr, 0)
    CAD_Sys.Write(1, "[DXF PIPELINE] 2D Sketch Geometry Loaded from DXF OK!\n", 54)

    // 2. Extrude 2D Sketch Profile (Outer Rectangle 120x60mm + Inner Circle R=15mm)
    CAD_Sys.Write(1, "[DXF PIPELINE] Extruding 2D Profile (Depth = 30mm)...\n", 53)
    h_solid_dxf = CAD_Feat.ExtrudeProfile(h_dxf_sketch, 0x403E000000000000) // 30.0 mm

    // 3. Export STEP & STL
    CAD_Script.ExportAll(h_solid_dxf, "dxf_extruded_solid.stp", "dxf_extruded_solid.stl")
    CAD_Sys.Write(1, "[DXF PIPELINE] Exported dxf_extruded_solid.stp & .stl OK!\n", 57)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   DXF SKETCH-DRIVEN PIPELINE COMPLETED CLEANLY!    \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)
}
