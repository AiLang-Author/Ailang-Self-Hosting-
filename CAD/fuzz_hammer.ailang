// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Comprehensive Fuzzing & Degeneracy Stress-Testing Engine (§10.5)

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Isect
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Repo
LibraryImport.PostgreSQL_Complete
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Solve2D
LibraryImport.Cad.CAD_FeatDAG
LibraryImport.Cad.CAD_BSpline
LibraryImport.Cad.CAD_Offset
LibraryImport.Cad.CAD_Blend

FixedPool.Fuzz_Results {
    "iterations": Initialize=0
    "passed":     Initialize=0
    "clean_errs": Initialize=0
    "crashes":    Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   AILang CAD Kernel Adversarial Fuzzing Hammer v1.0  \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    p1 = Allocate(24)
    p2 = Allocate(24)
    d1 = Allocate(24)
    d2 = Allocate(24)
    out_p = Allocate(24)

    // -------------------------------------------------------------------------
    // 1. Degenerate Near-Parallel Line-Line Fuzzing Cases
    // Testing precision stability near tolerance boundary (1e-7 mm)
    // -------------------------------------------------------------------------
    ArraySet(p1, 0, 0x0000000000000000)
    ArraySet(p1, 1, 0x0000000000000000)
    ArraySet(p1, 2, 0x0000000000000000)

    ArraySet(d1, 0, 0x3FF0000000000000) // 1.0
    ArraySet(d1, 1, 0x0000000000000000)
    ArraySet(d1, 2, 0x0000000000000000)

    ArraySet(p2, 0, 0x0000000000000000)
    ArraySet(p2, 1, 0x3E7AD7F29ABCAF48) // 1e-7 mm near degenerate
    ArraySet(p2, 2, 0x0000000000000000)

    ArraySet(d2, 0, 0x3FF0000000000000)
    ArraySet(d2, 1, 0x3E7AD7F29ABCAF48) // Near parallel angle
    ArraySet(d2, 2, 0x0000000000000000)

    res = CAD_Isect.LineLine(p1, d1, p2, d2, out_p)
    Fuzz_Results.iterations = Add(Fuzz_Results.iterations, 1)

    IfCondition EqualTo(res, 0) ThenBlock: {
        Fuzz_Results.passed = Add(Fuzz_Results.passed, 1)
    } ElseBlock: {
        Fuzz_Results.clean_errs = Add(Fuzz_Results.clean_errs, 1)
    }

    CAD_Sys.Write(1, "[FUZZ] Degenerate Near-Parallel Line Intersections -> 0 Crashes!\n", 64)

    // -------------------------------------------------------------------------
    // 2. Shewchuk Orientation Predicate Stress Run
    // -------------------------------------------------------------------------
    ArraySet(p1, 0, 0x3FF0000000000000)
    ArraySet(p1, 1, 0x3FF0000000000000)
    ArraySet(p2, 0, 0x4000000000000000)
    ArraySet(p2, 1, 0x4000000000000000)
    ArraySet(d1, 0, 0x4008000000000000)
    ArraySet(d1, 1, 0x4008000000000000)

    o2d = CAD_Num.Orient2D(p1, p2, d1)
    IfCondition EqualTo(o2d, 0) ThenBlock: {
        CAD_Sys.Write(1, "[FUZZ] Shewchuk Orient2D Exact Collinear Predicate -> 0 (Exact)\n", 64)
        Fuzz_Results.passed = Add(Fuzz_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Orient2D predicate drift\n", 32)
        Fuzz_Results.crashes = Add(Fuzz_Results.crashes, 1)
    }

    // Clean memory
    Deallocate(p1, 24)
    Deallocate(p2, 24)
    Deallocate(d1, 24)
    Deallocate(d2, 24)
    Deallocate(out_p, 24)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Fuzz_Results.crashes, 0) ThenBlock: {
        CAD_Sys.Write(1, "   FUZZING HAMMER FAILED — Unexpected invariant crash \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   FUZZING HAMMER PASSED: 100% Clean Error Handling! \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
