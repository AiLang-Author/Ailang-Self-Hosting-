LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Repo
LibraryImport.PostgreSQL_Complete

FixedPool.Bench_Results {
    "db_connected":    Initialize=0
    "schema_ok":       Initialize=0
    "tables_created":  Initialize=0
    "revisions_saved": Initialize=0
    "sqrt_iterations": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   Live PostgreSQL Server Deployment & Benchmark     \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    host_str = "127.0.0.1\0"
    db_str   = "cad_db\0"
    user_str = "postgres\0"
    pass_str = "\0"

    // -------------------------------------------------------------------------
    // 1. Live PostgreSQL TCP Connection over Raw Wire Protocol (Port 5432)
    // -------------------------------------------------------------------------
    res_conn = CAD_Repo.Connect("127.0.0.1", 5432, "cad_db", "postgres", "")
    IfCondition EqualTo(res_conn, 0) ThenBlock: {
        CAD_Sys.Write(1, "[LIVE DB] Connected to postgresql://127.0.0.1:5432/cad_db!\n", 59)
        Bench_Results.db_connected = 1
    } ElseBlock: {
        CAD_Sys.Write(1, "[LIVE DB] Connection fallback mode\n", 35)
    }

    // -------------------------------------------------------------------------
    // 2. Master Schema DDL Generation (Auth, Plugins, Workbenches, CAD PDM)
    // -------------------------------------------------------------------------
    res_schema = CAD_Repo.InitSchema(0)
    IfCondition EqualTo(res_schema, 0) ThenBlock: {
        CAD_Sys.Write(1, "[LIVE DB] 12 Master Application Tables Generated OK!\n", 52)
        Bench_Results.schema_ok = 1
    } ElseBlock: {
        CAD_Sys.Write(1, "[LIVE DB] Schema generation failed\n", 35)
    }

    // -------------------------------------------------------------------------
    // 3. Dynamic Workbench & Toolbar Seeding
    // -------------------------------------------------------------------------
    CAD_Repo.CreateWorkbench("PartDesign", "icon_pd.svg")
    CAD_Repo.CreateWorkbench("CAM_5Axis", "icon_cam.svg")
    CAD_Repo.AddToolbarItem(1, "Pad / Extrude", "Feat_CreatePad", 1)
    CAD_Repo.AddToolbarItem(1, "Pocket / Cut", "Feat_CreatePocket", 2)
    CAD_Sys.Write(1, "[LIVE DB] Workbenches & Toolbars Seeded in PostgreSQL!\n", 55)

    // -------------------------------------------------------------------------
    // 4. Live Solid B-Rep Revision Storage Benchmark
    // -------------------------------------------------------------------------
    p0 = Allocate(24)
    out_v = Allocate(24)
    out_f = Allocate(24)
    out_s = Allocate(24)
    out_solid = Allocate(24)
    part_id = Allocate(24)
    rev_id = Allocate(24)

    CAD_Topo.MVFS(p0, out_v, out_f, out_s)
    h_solid = CAD_Store.Alloc(7, 4)

    res_save = CAD_Repo.SaveRevision(part_id, rev_id, h_solid)
    IfCondition EqualTo(res_save, 0) ThenBlock: {
        CAD_Sys.Write(1, "[LIVE DB] B-Rep Model Blob Saved to PostgreSQL!\n", 48)
        Bench_Results.revisions_saved = 1
    } ElseBlock: {
        CAD_Sys.Write(1, "[LIVE DB] SaveRevision failed\n", 30)
    }

    res_fetch = CAD_Repo.FetchRevision(part_id, 1, out_solid)
    h_fetched = ArrayGet(out_solid, 0)
    IfCondition NotEqual(h_fetched, 0) ThenBlock: {
        CAD_Sys.Write(1, "[LIVE DB] B-Rep Model Blob Fetched from PostgreSQL to RAM!\n", 59)
    } ElseBlock: {
        CAD_Sys.Write(1, "[LIVE DB] FetchRevision failed\n", 31)
    }

    // -------------------------------------------------------------------------
    // 5. Compiler Native Float_Sqrt vs Newton-Raphson Sqrt Comparison
    // -------------------------------------------------------------------------
    val_2500 = 0x40A3880000000000 // 2500.0

    // Compiler hardware SQRTSD primitive
    native_sqrt = Float_Sqrt(val_2500)
    // Pure-AILang Newton-Raphson Sqrt
    nr_sqrt = CAD_Num.Sqrt(val_2500)

    IfCondition EqualTo(native_sqrt, 0x4049000000000000) ThenBlock: {
        CAD_Sys.Write(1, "[COMPILER SQRTSD] Native Float_Sqrt(2500.0) -> EXACT 50.0 (0x4049000000000000)!\n", 75)
    } ElseBlock: {
        CAD_Sys.Write(1, "[COMPILER SQRTSD] Native Float_Sqrt returned non-exact float\n", 60)
    }

    IfCondition EqualTo(nr_sqrt, native_sqrt) ThenBlock: {
        CAD_Sys.Write(1, "[BENCHMARK MATCH] Compiler SQRTSD == Newton-Raphson Sqrt (100% Identical)!\n", 73)
    } ElseBlock: {
        CAD_Sys.Write(1, "[BENCHMARK DIFF] Mantissa difference between SQRTSD and NR\n", 58)
    }

    // Clean memory
    Deallocate(p0, 24)
    Deallocate(out_v, 24)
    Deallocate(out_f, 24)
    Deallocate(out_s, 24)
    Deallocate(out_solid, 24)
    Deallocate(part_id, 24)
    Deallocate(rev_id, 24)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   LIVE POSTGRESQL DEPLOYMENT & BENCHMARK COMPLETE!  \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
