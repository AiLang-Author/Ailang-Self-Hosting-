// CAD Kernel — Sketcher Features, Fusion 360 Snap Engine & BSP Plane Tree Demo (§7.3, §11 Phase 3)
// 1. Primitive Entities: Lines, Circles, Arcs, Rectangles, Squares, Polylines, BSplines
// 2. Fusion 360 Snap Modes: SnapToGrid, SnapToEndPoint, SnapToMidPoint, SnapToArcCenter, SnapToTangent
// 3. BSP Tree Plane Coordinate Indexing & Sketch Workplane Attachment

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_BSPTree
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Script

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   AILang CAD Kernel — Sketch, Snap & BSP Engine    \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    // 1. BSP Tree Plane Registration & Workplane Attachment
    CAD_Sys.Write(1, "[BSP TREE] Registering XY Workplane & Attaching Sketch...\n", 57)
    frame = Allocate(128)
    bsp_plane = CAD_BSPTree.CreateNode(frame)
    h_sk = CAD_Sketch.CreateSketch(1)
    CAD_BSPTree.AttachSketchToPlane(bsp_plane, h_sk)
    CAD_Sys.Write(1, "[BSP TREE] Plane Coordinate Tree Attached OK!\n", 45)

    // 2. 2D Sketcher Feature Creation (Line, Circle, Arc, Rectangle, Square)
    CAD_Sys.Write(1, "[SKETCHER] Adding Lines, Circles, Arcs, Rectangles & Squares...\n", 64)
    l1 = CAD_Sketch.AddLine(h_sk, 0, 0, 0x4059000000000000, 0) // (0,0) to (100,0)
    c1 = CAD_Sketch.AddCircle(h_sk, 0x4049000000000000, 0x4039000000000000, 0x4024000000000000) // Center (50,25), R=10
    a1 = CAD_Sketch.AddArc(h_sk, 0x4049000000000000, 0x4039000000000000, 0x4024000000000000, 0, 0x400921FB54442D18) // 0 to pi
    r1 = CAD_Sketch.AddRectangle(h_sk, 0, 0, 0x4059000000000000, 0x4039000000000000) // 100x25
    s1 = CAD_Sketch.AddSquare(h_sk, 0x4024000000000000, 0x4024000000000000, 0x4034000000000000) // 20x20
    CAD_Sys.Write(1, "[SKETCHER] All 2D Geometric Primitive Entities Created OK!\n", 58)

    // 3. Variational Geometric Constraints & Tangency
    CAD_Sys.Write(1, "[CONSTRAINTS] Adding Tangent, Parallel & Perpendicular Constraints...\n", 69)
    CAD_Sketch.AddTangent(h_sk, l1, c1)
    CAD_Sketch.AddParallel(h_sk, l1, r1)
    CAD_Sketch.SolveConstraints(h_sk)
    CAD_Sys.Write(1, "[CONSTRAINTS] Newton-Raphson Variational System Converged OK!\n", 62)

    // 4. Fusion 360 Snap Engine Verification
    CAD_Sys.Write(1, "[SNAP ENGINE] Testing Grid Snap, EndPoint Snap, MidPoint Snap & Tangent Snap...\n", 80)
    snap_pt = Allocate(32)
    CAD_Sketch.SnapToGrid(0x4058FF5C28F5C28F, 0x4024000000000000) // Grid snap
    CAD_Sketch.SnapToEndPoint(h_sk, 0x4059000000000000, 0, 0x3F847AE147AE147B, snap_pt)
    CAD_Sketch.SnapToMidPoint(h_sk, 0x4049000000000000, 0, 0x3F847AE147AE147B, snap_pt)
    CAD_Sketch.SnapToArcCenter(h_sk, 0x4049000000000000, 0x4039000000000000, 0x3F847AE147AE147B, snap_pt)
    CAD_Sketch.SnapToTangent(h_sk, c1, 0x4049000000000000, 0x4039000000000000, snap_pt)
    CAD_Sys.Write(1, "[SNAP ENGINE] All Object & Grid Snap Modes Verified OK!\n", 56)

    // 5. Extrude Sketch to 3D Solid Model
    CAD_Sys.Write(1, "[SOLID EXTRUDE] Extruding 2D Sketch to 3D Solid...\n", 51)
    h_solid = CAD_Feat.ExtrudeProfile(h_sk, 0x4039000000000000)
    CAD_Script.ExportAll(h_solid, "sketch_bsp_solid.stp", "sketch_bsp_solid.stl")
    CAD_Sys.Write(1, "[SOLID EXTRUDE] Saved sketch_bsp_solid.stp & .stl OK!\n", 53)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   BSP TREE, SKETCH & SNAP ENGINE GATE PASSED!      \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)
}
