// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Blend

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   Phase 13: CAD_Blend Apex Edge Fillet & Chamfer   \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    f1 = Allocate(128)
    f2 = Allocate(128)
    out_blend = Allocate(128)
    p0 = Allocate(24)
    out_v = Allocate(24)
    out_f = Allocate(24)
    out_s = Allocate(24)

    // Build solid A
    CAD_Topo.MVFS(p0, out_v, out_f, out_s)
    h_solid = CAD_Store.Alloc(7, 4)

    r_5 = 0x4014000000000000 // 5.0 mm

    // -------------------------------------------------------------------------
    // 1. Rolling Ball Blend Surface Test
    // -------------------------------------------------------------------------
    res_rb = CAD_Blend.ComputeRollingBall(f1, f2, r_5, out_blend)
    IfCondition EqualTo(res_rb, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] ComputeRollingBall(F1, F2, R=5.0mm) -> Blend Frame\n", 58)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] ComputeRollingBall failed\n", 33)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 2. Solid Edge Fillet Rounding Test
    // -------------------------------------------------------------------------
    h_fillet = CAD_Blend.AddFillet(h_solid, 1, r_5)
    IfCondition NotEqual(h_fillet, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] AddFillet(Solid, Edge1, R=5.0mm) -> Filleted Solid\n", 58)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] AddFillet failed\n", 24)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 3. Variable Radius Fillet Test
    // -------------------------------------------------------------------------
    r_2  = 0x4000000000000000 // 2.0 mm
    r_10 = 0x4024000000000000 // 10.0 mm
    h_vfillet = CAD_Blend.AddVariableFillet(h_solid, 1, r_2, r_10)
    IfCondition NotEqual(h_vfillet, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] AddVariableFillet(Solid, Edge1, 2mm -> 10mm) -> OK\n", 57)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] AddVariableFillet failed\n", 32)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 4. Edge Chamfer Bevel Test
    // -------------------------------------------------------------------------
    r_3 = 0x4008000000000000 // 3.0 mm
    r_45deg = 0x3FE921FB54442D18 // 0.785398 rad (45 deg)
    h_chamfer = CAD_Blend.AddChamfer(h_solid, 1, r_3, r_45deg)
    IfCondition NotEqual(h_chamfer, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] AddChamfer(Solid, Edge1, 3mm, 45deg) -> Chamfered\n", 57)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] AddChamfer failed\n", 25)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Clean memory
    Deallocate(f1, 128)
    Deallocate(f2, 128)
    Deallocate(out_blend, 128)
    Deallocate(p0, 24)
    Deallocate(out_v, 24)
    Deallocate(out_f, 24)
    Deallocate(out_s, 24)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "   PHASE 13 GATE FAILED — Fix Blend/Fillet bugs      \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   PHASE 13 GATE PASSED: 100% Apex Blending OK!     \n", 53)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
