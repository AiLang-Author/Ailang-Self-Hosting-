// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Phase 5 Gate Verification: Comprehensive CAD_Bool Solid Boolean & Stitching Test Suite (§12.3)

LibraryImport.Arena
LibraryImport.CAD_Sys
LibraryImport.CAD_Num
LibraryImport.CAD_Store
LibraryImport.CAD_Topo
LibraryImport.CAD_Isect
LibraryImport.CAD_Bool

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   Phase 5: CAD_Bool Solid Boolean & Stitching Suite\n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    p0 = Allocate(24)
    out_v = Allocate(24)
    out_f = Allocate(24)
    out_s = Allocate(24)

    ArraySet(p0, 0, 0x0000000000000000)
    ArraySet(p0, 1, 0x0000000000000000)
    ArraySet(p0, 2, 0x0000000000000000)

    // Build solid A
    CAD_Topo.MVFS(p0, out_v, out_f, out_s)
    h_solid_a = CAD_Store.Alloc(7, 4) // Tag=7 (Solid A)
    h_face_a = ArrayGet(out_f, 0)

    // Build solid B
    CAD_Topo.MVFS(p0, out_v, out_f, out_s)
    h_solid_b = CAD_Store.Alloc(7, 4) // Tag=7 (Solid B)

    // -------------------------------------------------------------------------
    // 1. Classification Tests (ClassifyPoint, ClassifyFace)
    // -------------------------------------------------------------------------
    cls_p = CAD_Bool.ClassifyPoint(p0, h_solid_a)
    IfCondition EqualTo(cls_p, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] ClassifyPoint(P0, SolidA) -> 1 (INSIDE)\n", 46)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] ClassifyPoint mismatch\n", 30)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    cls_f = CAD_Bool.ClassifyFace(h_face_a, h_solid_b)
    IfCondition EqualTo(cls_f, 2) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] ClassifyFace(FaceA, SolidB) -> 2 (OUTSIDE)\n", 50)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] ClassifyFace mismatch\n", 29)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 2. Solid Union Test: A u B
    // -------------------------------------------------------------------------
    h_union = CAD_Bool.Union(h_solid_a, h_solid_b)
    IfCondition NotEqual(h_union, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Union(SolidA, SolidB) -> Valid Solid Handle\n", 52)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Union returned null handle\n", 34)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Null solid passthrough check: Union(0, SolidB) -> SolidB
    h_u_null = CAD_Bool.Union(0, h_solid_b)
    IfCondition EqualTo(h_u_null, h_solid_b) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Union(0, SolidB) -> SolidB (Passthrough)\n", 48)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Union null passthrough failed\n", 37)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 3. Solid Difference Test: A \ B
    // -------------------------------------------------------------------------
    h_diff = CAD_Bool.Difference(h_solid_a, h_solid_b)
    IfCondition NotEqual(h_diff, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Difference(SolidA, SolidB) -> Valid Solid Handle\n", 57)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Difference returned null handle\n", 39)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 4. Solid Intersection Test: A n B
    // -------------------------------------------------------------------------
    h_isect = CAD_Bool.Intersection(h_solid_a, h_solid_b)
    IfCondition NotEqual(h_isect, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Intersection(SolidA, SolidB) -> Valid Solid Handle\n", 59)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Intersection returned null handle\n", 41)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Clean memory
    Deallocate(p0, 24)
    Deallocate(out_v, 24)
    Deallocate(out_f, 24)
    Deallocate(out_s, 24)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "   PHASE 5 GATE FAILED — Fix solid boolean bugs     \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   PHASE 5 GATE PASSED: 100% Solid Booleans Verified!\n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
