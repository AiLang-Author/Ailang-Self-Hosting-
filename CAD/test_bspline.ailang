LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_BSpline

FixedPool.T {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== CAD_BSpline tests ===\n", 26)
    CAD_Num.InitTolerance(0, 0)

    // Degree 1: P0=(0,0,0) P1=(10,0,0), knots {0,0,1,1}, u=0.5 → (5,0,0)
    // ArrayGet/Set use +8 header: need room for 12 ctrl words + 8 knot words
    ctrl = Allocate(128)
    knots = Allocate(96)
    out = Allocate(32)
    ref = Allocate(32)

    ArraySet(ctrl, 0, 0)
    ArraySet(ctrl, 1, 0)
    ArraySet(ctrl, 2, 0)
    ArraySet(ctrl, 3, 0x4024000000000000) // 10
    ArraySet(ctrl, 4, 0)
    ArraySet(ctrl, 5, 0)

    ArraySet(knots, 0, 0)
    ArraySet(knots, 1, 0)
    ArraySet(knots, 2, 0x3FF0000000000000) // 1
    ArraySet(knots, 3, 0x3FF0000000000000)

    half = 0x3FE0000000000000
    curve = Allocate(48)
    ArraySet(curve, 0, 1)
    ArraySet(curve, 1, 2)
    ArraySet(curve, 2, ctrl)
    ArraySet(curve, 3, knots)
    CAD_BSpline.EvalCurve(curve, half, out)
    ArraySet(ref, 0, 0x4014000000000000) // 5
    ArraySet(ref, 1, 0)
    ArraySet(ref, 2, 0)
    tol = 0x3EB0C6F7A0B5ED8D // 1e-6
    IfCondition EqualTo(CAD_Num.PointsEqual(out, ref, tol), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] deg1 u=0.5 midpoint\n", 27)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] deg1 midpoint\n", 21)
        T.failed = Add(T.failed, 1)
    }

    CAD_BSpline.EvalCurve(curve, 0, out)
    ArraySet(ref, 0, 0)
    IfCondition EqualTo(CAD_Num.PointsEqual(out, ref, tol), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] deg1 u=0 start\n", 22)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] deg1 start\n", 18)
        T.failed = Add(T.failed, 1)
    }

    CAD_BSpline.EvalCurve(curve, 0x3FF0000000000000, out)
    ArraySet(ref, 0, 0x4024000000000000)
    IfCondition EqualTo(CAD_Num.PointsEqual(out, ref, tol), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] deg1 u=1 end\n", 20)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] deg1 end\n", 16)
        T.failed = Add(T.failed, 1)
    }

    // Degree 3 cubic Bézier-as-B-spline: 4 pts, knots 0,0,0,0,1,1,1,1
    // P0=(0,0,0) P1=(1,1,0) P2=(2,1,0) P3=(3,0,0)
    // At u=0 → P0; u=1 → P3
    ArraySet(ctrl, 0, 0)
    ArraySet(ctrl, 1, 0)
    ArraySet(ctrl, 2, 0)
    ArraySet(ctrl, 3, 0x3FF0000000000000)
    ArraySet(ctrl, 4, 0x3FF0000000000000)
    ArraySet(ctrl, 5, 0)
    ArraySet(ctrl, 6, 0x4000000000000000) // 2
    ArraySet(ctrl, 7, 0x3FF0000000000000)
    ArraySet(ctrl, 8, 0)
    ArraySet(ctrl, 9, 0x4008000000000000) // 3
    ArraySet(ctrl, 10, 0)
    ArraySet(ctrl, 11, 0)

    ArraySet(knots, 0, 0)
    ArraySet(knots, 1, 0)
    ArraySet(knots, 2, 0)
    ArraySet(knots, 3, 0)
    ArraySet(knots, 4, 0x3FF0000000000000)
    ArraySet(knots, 5, 0x3FF0000000000000)
    ArraySet(knots, 6, 0x3FF0000000000000)
    ArraySet(knots, 7, 0x3FF0000000000000)

    ArraySet(curve, 0, 3)
    ArraySet(curve, 1, 4)
    CAD_BSpline.EvalCurve(curve, 0, out)
    ArraySet(ref, 0, 0)
    ArraySet(ref, 1, 0)
    ArraySet(ref, 2, 0)
    IfCondition EqualTo(CAD_Num.PointsEqual(out, ref, tol), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] cubic u=0 → P0\n", 22)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] cubic start\n", 19)
        T.failed = Add(T.failed, 1)
    }

    CAD_BSpline.EvalCurve(curve, 0x3FF0000000000000, out)
    ArraySet(ref, 0, 0x4008000000000000)
    ArraySet(ref, 1, 0)
    ArraySet(ref, 2, 0)
    IfCondition EqualTo(CAD_Num.PointsEqual(out, ref, tol), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] cubic u=1 → P3\n", 22)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] cubic end\n", 17)
        T.failed = Add(T.failed, 1)
    }

    // u=0.5 cubic Bézier midpoint is average with Bezier weights
    // C(0.5) = (P0+3P1+3P2+P3)/8 = (0+3+6+3, 0+3+3+0, 0)/8 = (12,6,0)/8 = (1.5, 0.75, 0)
    CAD_BSpline.EvalCurve(curve, half, out)
    ArraySet(ref, 0, 0x3FF8000000000000) // 1.5
    ArraySet(ref, 1, 0x3FE8000000000000) // 0.75
    ArraySet(ref, 2, 0)
    IfCondition EqualTo(CAD_Num.PointsEqual(out, ref, tol), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] cubic u=0.5 Bezier mid\n", 30)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] cubic mid\n", 17)
        T.failed = Add(T.failed, 1)
    }

    Deallocate(ctrl, 128)
    Deallocate(knots, 96)
    Deallocate(curve, 48)
    Deallocate(out, 32)
    Deallocate(ref, 32)

    IfCondition GreaterThan(T.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "BSPLINE FAILED\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "BSPLINE PASSED\n", 15)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
