// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Phase 11 Gate Verification: NURBS Curves & Freeform Surface Test Suite (§12.3)

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_BSpline

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   Phase 11: CAD_BSpline NURBS & Freeform Suite     \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    ctrl_pts = Allocate(128)
    knots    = Allocate(64)
    uv_param = Allocate(24) // Packed [u=0.0, v=0.0]
    out_p    = Allocate(24)
    ref_p    = Allocate(24)

    // Control point 0: (10, 20, 30)
    ArraySet(ctrl_pts, 0, 0x4024000000000000) // 10.0
    ArraySet(ctrl_pts, 1, 0x4034000000000000) // 20.0
    ArraySet(ctrl_pts, 2, 0x403E000000000000) // 30.0

    ArraySet(uv_param, 0, 0x0000000000000000) // u = 0.0
    ArraySet(uv_param, 1, 0x0000000000000000) // v = 0.0

    // -------------------------------------------------------------------------
    // 1. Cox-de Boor Basis Function Test
    // -------------------------------------------------------------------------
    basis_r = CAD_BSpline.EvalBasis(0, 0, 0, knots)
    IfCondition NotEqual(basis_r, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalBasis(i=0, p=0) -> Basis Evaluated\n", 46)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalBasis failed\n", 23)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 2. B-Spline Curve Point Evaluation Test
    // -------------------------------------------------------------------------
    res_crv = CAD_BSpline.EvalCurve(3, ctrl_pts, knots, 0, out_p)
    ArraySet(ref_p, 0, 0x4024000000000000)
    ArraySet(ref_p, 1, 0x4034000000000000)
    ArraySet(ref_p, 2, 0x403E000000000000)

    eq_crv = CAD_Num.PointsEqual(out_p, ref_p, 0)
    IfCondition EqualTo(eq_crv, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalCurve(Degree=3, u=0.0) -> Point (10, 20, 30)\n", 56)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalCurve point mismatch\n", 31)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 3. Rational NURBS Surface Evaluation Test (6 System V ABI Parameters)
    // -------------------------------------------------------------------------
    res_srf = CAD_BSpline.EvalSurface(3, 3, ctrl_pts, knots, uv_param, out_p)
    eq_srf = CAD_Num.PointsEqual(out_p, ref_p, 0)
    IfCondition EqualTo(eq_srf, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalSurface(NURBS 3x3, u=0, v=0) -> (10, 20, 30)\n", 56)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalSurface point mismatch\n", 33)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Clean memory
    Deallocate(ctrl_pts, 128)
    Deallocate(knots, 64)
    Deallocate(uv_param, 24)
    Deallocate(out_p, 24)
    Deallocate(ref_p, 24)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "   PHASE 11 GATE FAILED — Fix BSpline bugs           \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   PHASE 11 GATE PASSED: 100% NURBS Freeform OK!    \n", 53)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
