// Gate: exact cylinder B-Rep + prism fallback + surface-sampled mesh

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Script

FixedPool.T {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== CAD cylinder gate ===\n", 26)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(4096)

    out = Allocate(16)
    counts = Allocate(64)
    r = 0x3FF0000000000000
    h = 0x4000000000000000

    // --- Exact analytic solid ---
    hs = CAD_Topo.MakeCylinderSolid(r, h, out)
    IfCondition NotEqual(hs, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] MakeCylinderSolid exact\n", 31)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] MakeCylinderSolid\n", 25)
        T.failed = Add(T.failed, 1)
    }

    // kind=1, r/h stored
    IfCondition EqualTo(CAD_Store.Read(hs, 3), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] solid kind=1 cylinder\n", 29)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] solid kind\n", 18)
        T.failed = Add(T.failed, 1)
    }

    // F=3 faces
    sh = CAD_Store.Read(hs, 0)
    f0 = CAD_Store.Read(sh, 0)
    nf = 1
    fx = CAD_Store.Read(f0, 3)
    WhileLoop NotEqual(fx, 0) {
        nf = Add(nf, 1)
        fx = CAD_Store.Read(fx, 3)
    }
    IfCondition EqualTo(nf, 3) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] exact cyl 3 faces\n", 25)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] face count\n", 18)
        T.failed = Add(T.failed, 1)
    }

    // side face: 4 coedges + live surface
    // faces: bot, top, side — side is last
    f_side = f0
    f_side = CAD_Store.Read(f_side, 3)
    f_side = CAD_Store.Read(f_side, 3)
    lp = CAD_Store.Read(f_side, 1)
    nce = CAD_Topo.LoopCountCoedges(lp)
    IfCondition EqualTo(nce, 4) ThenBlock: {
        IfCondition EqualTo(CAD_Store.IsLive(CAD_Store.Read(f_side, 0)), 1) ThenBlock: {
            CAD_Sys.Write(1, "[PASS] side 4-loop + surface\n", 29)
            T.passed = Add(T.passed, 1)
        } ElseBlock: {
            CAD_Sys.Write(1, "[FAIL] side surface\n", 20)
            T.failed = Add(T.failed, 1)
        }
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] side loop\n", 17)
        T.failed = Add(T.failed, 1)
    }

    // Euler V=2 E=3 F=3 → 2
    ArraySet(counts, 0, 2)
    ArraySet(counts, 1, 3)
    ArraySet(counts, 2, 3)
    ArraySet(counts, 3, 1)
    ArraySet(counts, 4, 0)
    ArraySet(counts, 5, 0)
    IfCondition EqualTo(CAD_Topo.VerifyEulerInvariants(counts), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Euler 2-3+3=2\n", 21)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Euler exact\n", 19)
        T.failed = Add(T.failed, 1)
    }

    // mesh from surface sample (not face walk of n-gon)
    mesh = Allocate(48)
    ntri = CAD_Tess.MeshSolid(hs, 0, mesh)
    IfCondition GreaterThan(ntri, 100) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] analytic mesh dense\n", 27)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] analytic mesh\n", 21)
        T.failed = Add(T.failed, 1)
    }

    // --- Prism stress path still works ---
    hp = CAD_Topo.MakeCylinderPrismSolid(r, h, 8, out)
    sh2 = CAD_Store.Read(hp, 0)
    f2 = CAD_Store.Read(sh2, 0)
    nf2 = 1
    fx = CAD_Store.Read(f2, 3)
    WhileLoop NotEqual(fx, 0) {
        nf2 = Add(nf2, 1)
        fx = CAD_Store.Read(fx, 3)
    }
    IfCondition EqualTo(nf2, 10) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] prism 8-gon 10 faces\n", 28)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] prism faces\n", 19)
        T.failed = Add(T.failed, 1)
    }

    hc = CAD_Script.CreateCylinder(r, h)
    IfCondition NotEqual(hc, 0) ThenBlock: {
        IfCondition EqualTo(CAD_Store.Read(hc, 3), 1) ThenBlock: {
            CAD_Sys.Write(1, "[PASS] CreateCylinder exact\n", 28)
            T.passed = Add(T.passed, 1)
        } ElseBlock: {
            CAD_Sys.Write(1, "[FAIL] CreateCylinder kind\n", 27)
            T.failed = Add(T.failed, 1)
        }
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] CreateCylinder\n", 22)
        T.failed = Add(T.failed, 1)
    }

    Deallocate(out, 16)
    Deallocate(counts, 64)
    Deallocate(mesh, 48)

    IfCondition GreaterThan(T.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "CYLINDER FAILED\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "CYLINDER PASSED\n", 16)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
