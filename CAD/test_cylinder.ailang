// Gate: MakeCylinderSolid topology + mesh

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Script

FixedPool.T {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== CAD cylinder gate ===\n", 26)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(2048)

    out = Allocate(16)
    counts = Allocate(64)
    r = 0x3FF0000000000000
    h = 0x4000000000000000
    // n=8 smaller
    hs = CAD_Topo.MakeCylinderSolid(r, h, 8, out)
    IfCondition NotEqual(hs, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] MakeCylinderSolid\n", 25)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] MakeCylinderSolid\n", 25)
        T.failed = Add(T.failed, 1)
    }

    // n=8 → F = 8 sides + 2 caps = 10
    sh = CAD_Store.Read(hs, 0)
    f0 = CAD_Store.Read(sh, 0)
    nf = 1
    fx = CAD_Store.Read(f0, 3)
    WhileLoop NotEqual(fx, 0) {
        nf = Add(nf, 1)
        fx = CAD_Store.Read(fx, 3)
    }
    IfCondition EqualTo(nf, 10) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] 8-gon cyl 10 faces\n", 26)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] face count\n", 18)
        T.failed = Add(T.failed, 1)
    }

    // side faces have live cylinder surface; find a 4-edge loop face
    fx = f0
    found_cyl = 0
    guard = 0
    WhileLoop NotEqual(fx, 0) {
        lp = CAD_Store.Read(fx, 1)
        nce = CAD_Topo.LoopCountCoedges(lp)
        IfCondition EqualTo(nce, 4) ThenBlock: {
            s = CAD_Store.Read(fx, 0)
            IfCondition EqualTo(CAD_Store.IsLive(s), 1) ThenBlock: {
                found_cyl = 1
            }
        }
        fx = CAD_Store.Read(fx, 3)
        guard = Add(guard, 1)
        IfCondition GreaterThan(guard, 32) ThenBlock: { fx = 0 }
    }
    IfCondition EqualTo(found_cyl, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] side face has surface\n", 29)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] side surface\n", 20)
        T.failed = Add(T.failed, 1)
    }

    // Euler V=16 E=24 F=10 → 16-24+10=2
    ArraySet(counts, 0, 16)
    ArraySet(counts, 1, 24)
    ArraySet(counts, 2, 10)
    ArraySet(counts, 3, 1)
    ArraySet(counts, 4, 0)
    ArraySet(counts, 5, 0)
    IfCondition EqualTo(CAD_Topo.VerifyEulerInvariants(counts), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Euler 16-24+10=2\n", 24)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Euler\n", 13)
        T.failed = Add(T.failed, 1)
    }

    mesh = Allocate(48)
    ntri = CAD_Tess.MeshSolid(hs, 0, mesh)
    // 8 quads * 2 = 16 + 2 caps * (8-2) = 16+12 = 28
    IfCondition EqualTo(ntri, 28) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] mesh 28 tris\n", 20)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] mesh tris\n", 17)
        T.failed = Add(T.failed, 1)
    }

    hc = CAD_Script.CreateCylinder(r, h)
    IfCondition NotEqual(hc, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] CreateCylinder\n", 22)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] CreateCylinder\n", 22)
        T.failed = Add(T.failed, 1)
    }

    Deallocate(out, 16)
    Deallocate(counts, 64)
    Deallocate(mesh, 48)

    IfCondition GreaterThan(T.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "CYLINDER FAILED\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "CYLINDER PASSED\n", 16)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
