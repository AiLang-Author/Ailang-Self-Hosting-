// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Phase 6 Gate Verification: Parametric Features, Persistent Naming & PDM Test Suite (§12.3)

LibraryImport.Arena
LibraryImport.CAD_Sys
LibraryImport.CAD_Num
LibraryImport.CAD_Store
LibraryImport.CAD_Topo
LibraryImport.CAD_Sketch
LibraryImport.CAD_Feat
LibraryImport.CAD_Repo

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   Phase 6: CAD_Feat & CAD_Repo Parametric & PDM    \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    // -------------------------------------------------------------------------
    // 1. Parametric Feature Creation (Pad, Pocket, Revolve)
    // -------------------------------------------------------------------------
    sk_h = CAD_Store.Alloc(9, 4) // Tag=9 (Sketch)
    r_100 = 0x4059000000000000   // 100.0 mm
    r_25  = 0x4039000000000000   // 25.0 mm

    h_pad = CAD_Feat.CreatePad(sk_h, r_100)
    IfCondition NotEqual(h_pad, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] CreatePad(sketch, depth=100.0mm) -> Valid Feature\n", 57)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] CreatePad returned null handle\n", 37)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    h_pock = CAD_Feat.CreatePocket(sk_h, r_25)
    IfCondition NotEqual(h_pock, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] CreatePocket(sketch, depth=25.0mm) -> Valid Feature\n", 59)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] CreatePocket returned null handle\n", 40)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 2. Persistent Naming & Loud Failure Discipline (§8)
    // -------------------------------------------------------------------------
    name_str = Allocate(24)
    out_entity = Allocate(24)

    res_naming = CAD_Feat.ResolveNaming(h_pad, name_str, out_entity)
    IfCondition EqualTo(res_naming, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] ResolveNaming(Pad) -> 0 (CAD_OK)\n", 40)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] ResolveNaming failed\n", 28)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Loud Failure Discipline Test: Corrupt/Null Feature Handle -> Expected -17 (CAD_E_NAMING_LOST)
    err_naming = CAD_Feat.ResolveNaming(0, name_str, out_entity)
    IfCondition EqualTo(err_naming, -17) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] ResolveNaming(Null) -> -17 (CAD_E_NAMING_LOST)\n", 54)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Loud Failure discipline check failed\n", 44)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Clean memory
    Deallocate(name_str, 24)
    Deallocate(out_entity, 24)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "   PHASE 6 GATE FAILED — Fix feature/naming bugs     \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   PHASE 6 GATE PASSED: 100% Parametric Features Verified!\n", 58)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
