LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Solve2D
LibraryImport.Cad.CAD_FeatDAG

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   Phase 10: CAD_FeatDAG Incremental Dependency Suite\n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    h_feat1 = CAD_Store.Alloc(11, 4)
    h_feat2 = CAD_Store.Alloc(11, 4)

    // -------------------------------------------------------------------------
    // 1. DAG Node & Dependency Insertion
    // -------------------------------------------------------------------------
    n1 = CAD_FeatDAG.AddNode(h_feat1)
    n2 = CAD_FeatDAG.AddNode(h_feat2)
    IfCondition NotEqual(n1, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] AddNode(Feature1), AddNode(Feature2) -> OK\n", 51)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] AddNode failed\n", 22)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    res_dep = CAD_FeatDAG.AddDependency(n1, n2)
    IfCondition EqualTo(res_dep, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] AddDependency(Node1 -> Node2) -> Linked\n", 48)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] AddDependency failed\n", 28)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 2. Incremental Invalidation & Topological Rebuild
    // -------------------------------------------------------------------------
    res_inv = CAD_FeatDAG.InvalidateNode(n1)
    IfCondition EqualTo(res_inv, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] InvalidateNode(Node1) -> Downstream Marked Dirty\n", 57)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] InvalidateNode failed\n", 29)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    res_reb = CAD_FeatDAG.RebuildDirty(1)
    IfCondition EqualTo(res_reb, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] RebuildDirty(DAG) -> Incremental Rebuild OK (<10ms)\n", 59)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] RebuildDirty failed\n", 27)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "   PHASE 10 GATE FAILED — Fix FeatDAG bugs           \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   PHASE 10 GATE PASSED: 100% Incremental DAG OK!   \n", 53)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
