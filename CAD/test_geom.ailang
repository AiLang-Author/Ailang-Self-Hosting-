// CAD Kernel — Phase 1 Gate: CAD.Geom analytic eval, trig, derivatives, project

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Geom

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   Phase 1: CAD_Geom Deep Gate\n", 32)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    p0 = Allocate(32)
    dir = Allocate(32)
    out_p = Allocate(32)
    ref_p = Allocate(32)
    out_d = Allocate(32)
    frame = Allocate(128)
    center = Allocate(32)
    xaxis = Allocate(32)
    yaxis = Allocate(32)
    uv = Allocate(16)
    tbuf = Allocate(16)
    q = Allocate(32)
    p_query = Allocate(32)

    // --- Trig ---
    c0 = CAD_Geom.Cos(0x0000000000000000)
    s0 = CAD_Geom.Sin(0x0000000000000000)
    IfCondition EqualTo(CAD_Num.IsEqual(c0, 0x3FF0000000000000, 0), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Cos(0)=1\n", 16)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Cos(0)\n", 14)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }
    IfCondition EqualTo(CAD_Num.IsEqual(s0, 0x0000000000000000, 0), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Sin(0)=0\n", 16)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Sin(0)\n", 14)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Cos(pi) ~ -1, Sin(pi) ~ 0
    pi_r = 0x400921FB54442D18
    c_pi = CAD_Geom.Cos(pi_r)
    s_pi = CAD_Geom.Sin(pi_r)
    // looser tol for poly trig: 1e-6
    tol_soft = 0x3EB0C6F7A0B5ED8D
    IfCondition EqualTo(CAD_Num.IsEqual(c_pi, 0xBFF0000000000000, tol_soft), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Cos(pi)~-1\n", 18)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Cos(pi)\n", 15)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }
    IfCondition EqualTo(CAD_Num.IsZero(s_pi, tol_soft), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Sin(pi)~0\n", 17)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Sin(pi)\n", 15)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // --- Line ---
    ArraySet(p0, 0, 0x4024000000000000)
    ArraySet(p0, 1, 0x4034000000000000)
    ArraySet(p0, 2, 0x403E000000000000)
    ArraySet(dir, 0, 0x0000000000000000)
    ArraySet(dir, 1, 0x3FF0000000000000)
    ArraySet(dir, 2, 0x0000000000000000)

    CAD_Geom.EvalLine(p0, dir, 0x0000000000000000, out_p)
    IfCondition EqualTo(CAD_Num.PointsEqual(out_p, p0, 0), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalLine(t=0)\n", 21)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalLine(t=0)\n", 21)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    t_neg = Float_Sub(0x0000000000000000, 0x4024000000000000)
    CAD_Geom.EvalLine(p0, dir, t_neg, out_p)
    ArraySet(ref_p, 0, 0x4024000000000000)
    ArraySet(ref_p, 1, 0x4024000000000000)
    ArraySet(ref_p, 2, 0x403E000000000000)
    IfCondition EqualTo(CAD_Num.PointsEqual(out_p, ref_p, 0), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalLine(t=-10)\n", 23)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalLine(t=-10)\n", 23)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    CAD_Geom.DerivLine(dir, out_d)
    IfCondition EqualTo(CAD_Num.PointsEqual(out_d, dir, 0), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] DerivLine == Dir\n", 24)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] DerivLine\n", 17)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Project (10, 50, 30) onto line -> t=30, Q=(10,50,30)
    ArraySet(p_query, 0, 0x4024000000000000)
    ArraySet(p_query, 1, 0x4049000000000000)
    ArraySet(p_query, 2, 0x403E000000000000)
    CAD_Geom.ProjectPointLine(p_query, p0, dir, q, tbuf)
    // expected t = 30.0
    IfCondition EqualTo(CAD_Num.IsEqual(ArrayGet(tbuf, 0), 0x403E000000000000, 0), 1) ThenBlock: {
        IfCondition EqualTo(CAD_Num.PointsEqual(q, p_query, 0), 1) ThenBlock: {
            CAD_Sys.Write(1, "[PASS] ProjectPointLine t=30\n", 29)
            Test_Results.passed = Add(Test_Results.passed, 1)
        } ElseBlock: {
            CAD_Sys.Write(1, "[FAIL] ProjectPointLine Q\n", 26)
            Test_Results.failed = Add(Test_Results.failed, 1)
        }
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] ProjectPointLine t\n", 26)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // --- Circle ---
    ArraySet(center, 0, 0)
    ArraySet(center, 1, 0)
    ArraySet(center, 2, 0)
    ArraySet(xaxis, 0, 0x3FF0000000000000)
    ArraySet(xaxis, 1, 0)
    ArraySet(xaxis, 2, 0)
    ArraySet(yaxis, 0, 0)
    ArraySet(yaxis, 1, 0x3FF0000000000000)
    ArraySet(yaxis, 2, 0)
    r_50 = 0x4049000000000000

    CAD_Geom.EvalCircle(center, xaxis, yaxis, r_50, 0, out_p)
    ArraySet(ref_p, 0, r_50)
    ArraySet(ref_p, 1, 0)
    ArraySet(ref_p, 2, 0)
    IfCondition EqualTo(CAD_Num.PointsEqual(out_p, ref_p, 0), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalCircle(u=0)\n", 23)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalCircle(u=0)\n", 23)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    CAD_Geom.EvalCircle(center, xaxis, yaxis, r_50, 0x3FF921FB54442D18, out_p)
    ArraySet(ref_p, 0, 0)
    ArraySet(ref_p, 1, r_50)
    ArraySet(ref_p, 2, 0)
    IfCondition EqualTo(CAD_Num.PointsEqual(out_p, ref_p, tol_soft), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalCircle(u=pi/2)\n", 26)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalCircle(u=pi/2)\n", 26)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // u=pi -> (-50,0,0)
    CAD_Geom.EvalCircle(center, xaxis, yaxis, r_50, pi_r, out_p)
    ArraySet(ref_p, 0, 0xC049000000000000)
    ArraySet(ref_p, 1, 0)
    ArraySet(ref_p, 2, 0)
    IfCondition EqualTo(CAD_Num.PointsEqual(out_p, ref_p, tol_soft), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalCircle(u=pi)\n", 24)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalCircle(u=pi)\n", 24)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Deriv at u=0: (0, 50, 0)
    CAD_Geom.DerivCircle(xaxis, yaxis, r_50, 0, out_d)
    ArraySet(ref_p, 0, 0)
    ArraySet(ref_p, 1, r_50)
    ArraySet(ref_p, 2, 0)
    IfCondition EqualTo(CAD_Num.PointsEqual(out_d, ref_p, tol_soft), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] DerivCircle(u=0)=(0,50,0)\n", 33)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] DerivCircle(u=0)\n", 24)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // --- Frame for plane/cyl/sphere ---
    ArraySet(frame, 0, 0)
    ArraySet(frame, 1, 0)
    ArraySet(frame, 2, 0)
    ArraySet(frame, 3, 0x3FF0000000000000)
    ArraySet(frame, 4, 0)
    ArraySet(frame, 5, 0)
    ArraySet(frame, 6, 0)
    ArraySet(frame, 7, 0x3FF0000000000000)
    ArraySet(frame, 8, 0)
    ArraySet(frame, 9, 0)
    ArraySet(frame, 10, 0)
    ArraySet(frame, 11, 0x3FF0000000000000)

    // Plane (3,4) -> (3,4,0)
    CAD_Geom.EvalPlane(frame, 0x4008000000000000, 0x4010000000000000, out_p)
    ArraySet(ref_p, 0, 0x4008000000000000)
    ArraySet(ref_p, 1, 0x4010000000000000)
    ArraySet(ref_p, 2, 0)
    IfCondition EqualTo(CAD_Num.PointsEqual(out_p, ref_p, 0), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalPlane(3,4)\n", 22)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalPlane\n", 17)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Project (5,7,9) onto XY plane -> (5,7,0)
    ArraySet(p_query, 0, 0x4014000000000000)
    ArraySet(p_query, 1, 0x401C000000000000)
    ArraySet(p_query, 2, 0x4022000000000000)
    CAD_Geom.ProjectPointPlane(p_query, frame, q, uv)
    ArraySet(ref_p, 0, 0x4014000000000000)
    ArraySet(ref_p, 1, 0x401C000000000000)
    ArraySet(ref_p, 2, 0)
    IfCondition EqualTo(CAD_Num.PointsEqual(q, ref_p, 0), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] ProjectPointPlane\n", 25)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] ProjectPointPlane\n", 25)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Cylinder
    CAD_Geom.EvalCylinder(frame, r_50, 0x3FF921FB54442D18, 0x4059000000000000, out_p)
    ArraySet(ref_p, 0, 0)
    ArraySet(ref_p, 1, r_50)
    ArraySet(ref_p, 2, 0x4059000000000000)
    IfCondition EqualTo(CAD_Num.PointsEqual(out_p, ref_p, tol_soft), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalCylinder(pi/2,100)\n", 30)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalCylinder\n", 20)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Sphere north pole
    CAD_Geom.EvalSphere(frame, r_50, 0, 0x3FF921FB54442D18, out_p)
    ArraySet(ref_p, 0, 0)
    ArraySet(ref_p, 1, 0)
    ArraySet(ref_p, 2, r_50)
    IfCondition EqualTo(CAD_Num.PointsEqual(out_p, ref_p, tol_soft), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalSphere north pole\n", 29)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalSphere\n", 18)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Store-backed point: write eval result into CAD_Store
    h_pt = CAD_Store.Alloc(8, 3)
    CAD_Geom.EvalLine(p0, dir, 0x3FF0000000000000, out_p)
    CAD_Store.Write(h_pt, 0, ArrayGet(out_p, 0))
    CAD_Store.Write(h_pt, 1, ArrayGet(out_p, 1))
    CAD_Store.Write(h_pt, 2, ArrayGet(out_p, 2))
    ArraySet(ref_p, 0, CAD_Store.Read(h_pt, 0))
    ArraySet(ref_p, 1, CAD_Store.Read(h_pt, 1))
    ArraySet(ref_p, 2, CAD_Store.Read(h_pt, 2))
    // t=1: (10,21,30)
    ArraySet(out_p, 0, 0x4024000000000000)
    ArraySet(out_p, 1, 0x4035000000000000)
    ArraySet(out_p, 2, 0x403E000000000000)
    IfCondition EqualTo(CAD_Num.PointsEqual(ref_p, out_p, 0), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Store-backed EvalLine point\n", 35)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Store-backed point\n", 26)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }
    CAD_Store.Free(h_pt)

    Deallocate(p0, 32)
    Deallocate(dir, 32)
    Deallocate(out_p, 32)
    Deallocate(ref_p, 32)
    Deallocate(out_d, 32)
    Deallocate(frame, 128)
    Deallocate(center, 32)
    Deallocate(xaxis, 32)
    Deallocate(yaxis, 32)
    Deallocate(uv, 16)
    Deallocate(tbuf, 16)
    Deallocate(q, 32)
    Deallocate(p_query, 32)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "   PHASE 1 GATE FAILED\n", 24)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   PHASE 1 GATE PASSED\n", 24)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
