// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Phase 1 Gate Verification: Comprehensive CAD.Geom Deep Test Suite (§12.3)

LibraryImport.Arena
LibraryImport.CAD_Sys
LibraryImport.CAD_Num
LibraryImport.CAD_Store
LibraryImport.CAD_Geom

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   Phase 1: CAD_Geom Comprehensive Deep Test Suite   \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    p0 = Allocate(24)
    dir = Allocate(24)
    out_p = Allocate(24)
    ref_p = Allocate(24)

    // -------------------------------------------------------------------------
    // 0. Trigonometric Polynomial Sanity Checks
    // -------------------------------------------------------------------------
    c_0 = CAD_Geom.Cos(0x0000000000000000)
    s_0 = CAD_Geom.Sin(0x0000000000000000)

    eq_c0 = CAD_Num.IsEqual(c_0, 0x3FF0000000000000, 0) // 1.0
    IfCondition EqualTo(eq_c0, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Cos(0.0) -> 1.0\n", 23)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Cos(0.0) mismatch\n", 25)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    eq_s0 = CAD_Num.IsEqual(s_0, 0x0000000000000000, 0) // 0.0
    IfCondition EqualTo(eq_s0, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Sin(0.0) -> 0.0\n", 23)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Sin(0.0) mismatch\n", 25)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 1. Line Evaluation: Nominal, Zero, Negative Bounds
    // P0 = (10.0, 20.0, 30.0), Dir = (0.0, 1.0, 0.0)
    // -------------------------------------------------------------------------
    ArraySet(p0, 0, 0x4024000000000000)   // 10.0
    ArraySet(p0, 1, 0x4034000000000000)   // 20.0
    ArraySet(p0, 2, 0x403E000000000000)   // 30.0

    ArraySet(dir, 0, 0x0000000000000000)  // 0.0
    ArraySet(dir, 1, 0x3FF0000000000000)  // 1.0
    ArraySet(dir, 2, 0x0000000000000000)  // 0.0

    // Test t = 0.0 -> P(0) = (10.0, 20.0, 30.0)
    CAD_Geom.EvalLine(p0, dir, 0x0000000000000000, out_p)
    eq_line_0 = CAD_Num.PointsEqual(out_p, p0, 0)
    IfCondition EqualTo(eq_line_0, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalLine(t=0) -> P0 origin\n", 34)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalLine(t=0) origin mismatch\n", 37)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Test t = -10.0 -> P(-10) = (10.0, 10.0, 30.0)
    ArraySet(ref_p, 0, 0x4024000000000000) // 10.0
    ArraySet(ref_p, 1, 0x4024000000000000) // 10.0
    ArraySet(ref_p, 2, 0x403E000000000000) // 30.0

    t_neg = Float_Sub(0x0000000000000000, 0x4024000000000000) // -10.0
    CAD_Geom.EvalLine(p0, dir, t_neg, out_p)
    eq_line_neg = CAD_Num.PointsEqual(out_p, ref_p, 0)
    IfCondition EqualTo(eq_line_neg, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalLine(t=-10.0) -> (10.0, 10.0, 30.0)\n", 46)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalLine(t=-10.0) point mismatch\n", 40)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 2. Circle Quadrant Evaluation: u=0, u=pi/2
    // Center = (0, 0, 0), X = (1, 0, 0), Y = (0, 1, 0), Radius = 50.0
    // -------------------------------------------------------------------------
    center = Allocate(24)
    xaxis = Allocate(24)
    yaxis = Allocate(24)
    frame = Allocate(128) // 16 doubles for surface frame [Base, X, Y, Z]

    ArraySet(center, 0, 0x0000000000000000)
    ArraySet(center, 1, 0x0000000000000000)
    ArraySet(center, 2, 0x0000000000000000)

    ArraySet(xaxis, 0, 0x3FF0000000000000) // 1.0
    ArraySet(xaxis, 1, 0x0000000000000000)
    ArraySet(xaxis, 2, 0x0000000000000000)

    ArraySet(yaxis, 0, 0x0000000000000000)
    ArraySet(yaxis, 1, 0x3FF0000000000000) // 1.0
    ArraySet(yaxis, 2, 0x0000000000000000)

    // Build frame [Base=0..2, X=3..5, Y=6..8, Z=9..11]
    ArraySet(frame, 0, 0x0000000000000000)
    ArraySet(frame, 1, 0x0000000000000000)
    ArraySet(frame, 2, 0x0000000000000000)

    ArraySet(frame, 3, 0x3FF0000000000000) // X=1.0
    ArraySet(frame, 4, 0x0000000000000000)
    ArraySet(frame, 5, 0x0000000000000000)

    ArraySet(frame, 6, 0x0000000000000000)
    ArraySet(frame, 7, 0x3FF0000000000000) // Y=1.0
    ArraySet(frame, 8, 0x0000000000000000)

    ArraySet(frame, 9, 0x0000000000000000)
    ArraySet(frame, 10, 0x0000000000000000)
    ArraySet(frame, 11, 0x3FF0000000000000) // Z=1.0

    r_50 = 0x4049000000000000 // 50.0

    // u = 0.0 -> P(0) = (50.0, 0.0, 0.0)
    CAD_Geom.EvalCircle(center, xaxis, yaxis, r_50, 0x0000000000000000, out_p)
    ArraySet(ref_p, 0, 0x4049000000000000) // 50.0
    ArraySet(ref_p, 1, 0x0000000000000000) // 0.0
    ArraySet(ref_p, 2, 0x0000000000000000) // 0.0

    eq_circ_0 = CAD_Num.PointsEqual(out_p, ref_p, 0)
    IfCondition EqualTo(eq_circ_0, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalCircle(u=0) -> (50.0, 0.0, 0.0)\n", 43)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalCircle(u=0) point mismatch\n", 38)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // u = pi/2 -> P(pi/2) = (0.0, 50.0, 0.0)
    CAD_Geom.EvalCircle(center, xaxis, yaxis, r_50, 0x3FF921FB54442D18, out_p)
    ArraySet(ref_p, 0, 0x0000000000000000) // 0.0
    ArraySet(ref_p, 1, 0x4049000000000000) // 50.0
    ArraySet(ref_p, 2, 0x0000000000000000) // 0.0

    eq_circ_pi2 = CAD_Num.PointsEqual(out_p, ref_p, 0)
    IfCondition EqualTo(eq_circ_pi2, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalCircle(u=pi/2) -> (0.0, 50.0, 0.0)\n", 46)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalCircle(u=pi/2) point mismatch\n", 41)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 3. Cylinder Surface Evaluation: Base = (0,0,0), R = 50.0, u=pi/2, v=100.0
    // Expected P(pi/2, 100) = (0.0, 50.0, 100.0)
    // -------------------------------------------------------------------------
    v_100 = 0x4059000000000000 // 100.0
    CAD_Geom.EvalCylinder(frame, r_50, 0x3FF921FB54442D18, v_100, out_p)

    ArraySet(ref_p, 0, 0x0000000000000000) // 0.0
    ArraySet(ref_p, 1, 0x4049000000000000) // 50.0
    ArraySet(ref_p, 2, 0x4059000000000000) // 100.0

    eq_cyl = CAD_Num.PointsEqual(out_p, ref_p, 0)
    IfCondition EqualTo(eq_cyl, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalCylinder(u=pi/2, v=100) -> (0, 50, 100)\n", 50)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalCylinder point mismatch\n", 35)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 4. Sphere Surface Evaluation: Center = (0,0,0), R = 50.0, North Pole v=pi/2
    // Expected P(u=0, v=pi/2) = (0.0, 0.0, 50.0)
    // -------------------------------------------------------------------------
    CAD_Geom.EvalSphere(frame, r_50, 0x0000000000000000, 0x3FF921FB54442D18, out_p)

    ArraySet(ref_p, 0, 0x0000000000000000) // 0.0
    ArraySet(ref_p, 1, 0x0000000000000000) // 0.0
    ArraySet(ref_p, 2, 0x4049000000000000) // 50.0

    eq_sph_pole = CAD_Num.PointsEqual(out_p, ref_p, 0)
    IfCondition EqualTo(eq_sph_pole, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalSphere(North Pole v=pi/2) -> (0, 0, 50)\n", 51)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalSphere North pole point mismatch\n", 44)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Clean memory
    Deallocate(p0, 24)
    Deallocate(dir, 24)
    Deallocate(out_p, 24)
    Deallocate(ref_p, 24)
    Deallocate(center, 24)
    Deallocate(xaxis, 24)
    Deallocate(yaxis, 24)
    Deallocate(frame, 128)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "   PHASE 1 GATE FAILED — Fix geometry evaluation bugs\n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   PHASE 1 GATE PASSED: Deep Test Suite 100% Verified!\n", 55)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
