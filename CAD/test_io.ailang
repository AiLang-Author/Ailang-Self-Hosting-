// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Phase 8 Gate Verification: ISO 10303-21 STEP Neutral Exchange Test Suite (§12.3)

LibraryImport.Arena
LibraryImport.CAD_Sys
LibraryImport.CAD_Num
LibraryImport.CAD_Store
LibraryImport.CAD_Topo
LibraryImport.CAD_IO

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   Phase 8: CAD_IO STEP ISO 10303-21 Test Suite     \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    p0 = Allocate(24)
    out_v = Allocate(24)
    out_f = Allocate(24)
    out_s = Allocate(24)
    out_solid = Allocate(24)

    // Build solid A
    CAD_Topo.MVFS(p0, out_v, out_f, out_s)
    h_solid = CAD_Store.Alloc(7, 4)

    // Pass string literal "model.stp"
    res_exp = CAD_IO.ExportSTEP(h_solid, "model.stp")
    IfCondition EqualTo(res_exp, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] ExportSTEP(Solid) -> model.stp Written\n", 46)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] ExportSTEP failed\n", 25)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    res_imp = CAD_IO.ImportSTEP("model.stp", out_solid)
    h_imported = ArrayGet(out_solid, 0)
    IfCondition NotEqual(h_imported, 0) ThenBlock: {
        IfCondition EqualTo(res_imp, 0) ThenBlock: {
            CAD_Sys.Write(1, "[PASS] ImportSTEP(model.stp) -> Solid Restored\n", 46)
            Test_Results.passed = Add(Test_Results.passed, 1)
        } ElseBlock: {
            CAD_Sys.Write(1, "[FAIL] ImportSTEP returned error code\n", 38)
            Test_Results.failed = Add(Test_Results.failed, 1)
        }
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] ImportSTEP returned null handle\n", 38)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Clean memory
    Deallocate(p0, 24)
    Deallocate(out_v, 24)
    Deallocate(out_f, 24)
    Deallocate(out_s, 24)
    Deallocate(out_solid, 24)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "   PHASE 8 GATE FAILED — Fix STEP IO bugs            \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   PHASE 8 GATE PASSED: 100% STEP ISO 10303-21 OK!   \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
