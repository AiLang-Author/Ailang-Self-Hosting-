LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Script
LibraryImport.Cad.CAD_IO

FixedPool.T {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== CAD_IO STEP tests ===\n", 26)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(1024)

    // 10 x 20 x 30 box (mm)
    dx = 0x4024000000000000 // 10
    dy = 0x4034000000000000 // 20
    dz = 0x403E000000000000 // 30
    h = CAD_Script.CreateBox(dx, dy, dz)
    IfCondition NotEqual(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] CreateBox 10x20x30\n", 26)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] CreateBox\n", 17)
        T.failed = Add(T.failed, 1)
    }

    res = CAD_IO.ExportSTEP(h, "test-stl/cad_box_10x20x30.stp")
    IfCondition EqualTo(res, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] ExportSTEP wrote file\n", 29)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] ExportSTEP\n", 18)
        T.failed = Add(T.failed, 1)
    }

    // also unit box for FreeCAD
    one = 0x3FF0000000000000
    h2 = CAD_Script.CreateBox(one, one, one)
    CAD_IO.ExportSTEP(h2, "test-stl/cad_box_unit.stp")
    CAD_Sys.Write(1, "[PASS] ExportSTEP unit box\n", 27)
    T.passed = Add(T.passed, 1)

    IfCondition GreaterThan(T.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "IO FAILED\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "IO PASSED\n", 10)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
