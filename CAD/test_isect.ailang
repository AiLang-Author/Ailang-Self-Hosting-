// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Phase 4 Gate Verification: Comprehensive CAD_Isect Geometric Intersection Test Suite (§12.3)

LibraryImport.Arena
LibraryImport.CAD_Sys
LibraryImport.CAD_Num
LibraryImport.CAD_Store
LibraryImport.CAD_Geom
LibraryImport.CAD_Isect

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   Phase 4: CAD_Isect Geometric Intersection Suite  \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    p1 = Allocate(24)
    d1 = Allocate(24)
    p2 = Allocate(24)
    d2 = Allocate(24)
    out_p = Allocate(24)
    ref_p = Allocate(24)

    // -------------------------------------------------------------------------
    // 1. Line-Line Orthogonal Intersection Test
    // Line 1: P1=(0,0,0), D1=(1,0,0) (X-axis)
    // Line 2: P2=(50,-50,0), D2=(0,1,0) (Y-axis offset)
    // Expected Intersection P = (50.0, 0.0, 0.0)
    // -------------------------------------------------------------------------
    ArraySet(p1, 0, 0x0000000000000000)
    ArraySet(p1, 1, 0x0000000000000000)
    ArraySet(p1, 2, 0x0000000000000000)

    ArraySet(d1, 0, 0x3FF0000000000000) // 1.0
    ArraySet(d1, 1, 0x0000000000000000)
    ArraySet(d1, 2, 0x0000000000000000)

    ArraySet(p2, 0, 0x4049000000000000) // 50.0
    ArraySet(p2, 1, 0xC049000000000000) // -50.0
    ArraySet(p2, 2, 0x0000000000000000)

    ArraySet(d2, 0, 0x0000000000000000)
    ArraySet(d2, 1, 0x3FF0000000000000) // 1.0
    ArraySet(d2, 2, 0x0000000000000000)

    ret_ll = CAD_Isect.LineLine(p1, d1, p2, d2, out_p)
    ArraySet(ref_p, 0, 0x4049000000000000) // 50.0
    ArraySet(ref_p, 1, 0x0000000000000000) // 0.0
    ArraySet(ref_p, 2, 0x0000000000000000) // 0.0

    eq_ll = CAD_Num.PointsEqual(out_p, ref_p, 0)
    IfCondition EqualTo(eq_ll, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] LineLine(X-axis, Y-offset) -> (50.0, 0.0, 0.0)\n", 53)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] LineLine point mismatch\n", 31)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 2. Line-Line Parallel Degenerate Check
    // Line 1: P1=(0,0,0), D1=(1,0,0)
    // Line 2: P2=(0,10,0), D2=(1,0,0) -> Parallel -> Expected -6 (CAD_E_DEGENERATE)
    // -------------------------------------------------------------------------
    ArraySet(p2, 0, 0x0000000000000000)
    ArraySet(p2, 1, 0x4024000000000000) // 10.0
    ArraySet(p2, 2, 0x0000000000000000)

    ArraySet(d2, 0, 0x3FF0000000000000) // 1.0
    ArraySet(d2, 1, 0x0000000000000000)
    ArraySet(d2, 2, 0x0000000000000000)

    ret_par = CAD_Isect.LineLine(p1, d1, p2, d2, out_p)
    IfCondition EqualTo(ret_par, -6) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] LineLine(Parallel) -> -6 (CAD_E_DEGENERATE)\n", 50)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] LineLine parallel check failed\n", 38)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 3. Circle-Circle 2-Point Intersection Test
    // Circle 1: C1=(0,0,0), R1=50.0
    // Circle 2: C2=(60,0,0), R2=50.0
    // Expected Intersections: P1=(30, 40, 0), P2=(30, -40, 0)
    // -------------------------------------------------------------------------
    c1 = Allocate(24)
    c2 = Allocate(24)
    out_cc1 = Allocate(24)
    out_cc2 = Allocate(24)

    ArraySet(c1, 0, 0x0000000000000000)
    ArraySet(c1, 1, 0x0000000000000000)
    ArraySet(c1, 2, 0x0000000000000000)

    ArraySet(c2, 0, 0x404E000000000000) // 60.0
    ArraySet(c2, 1, 0x0000000000000000)
    ArraySet(c2, 2, 0x0000000000000000)

    r_50 = 0x4049000000000000 // 50.0

    ret_cc = CAD_Isect.CircleCircle(c1, r_50, c2, r_50, out_cc1, out_cc2)

    // Expected P1 = (30.0, 40.0, 0.0), P2 = (30.0, -40.0, 0.0)
    ref_cc1 = Allocate(24)
    ArraySet(ref_cc1, 0, 0x403E000000000000) // 30.0
    ArraySet(ref_cc1, 1, 0x4044000000000000) // 40.0
    ArraySet(ref_cc1, 2, 0x0000000000000000)

    eq_cc1 = CAD_Num.PointsEqual(out_cc1, ref_cc1, 0)
    IfCondition EqualTo(eq_cc1, 1) ThenBlock: {
        IfCondition EqualTo(ret_cc, 2) ThenBlock: {
            CAD_Sys.Write(1, "[PASS] CircleCircle(C1(0,0), C2(60,0), R=50) -> (30, 40)\n", 57)
            Test_Results.passed = Add(Test_Results.passed, 1)
        } ElseBlock: {
            CAD_Sys.Write(1, "[FAIL] CircleCircle count mismatch\n", 35)
            Test_Results.failed = Add(Test_Results.failed, 1)
        }
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] CircleCircle point mismatch\n", 35)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 4. Plane-Plane Intersection Line Direction
    // Plane 1: Normal N1=(0,0,1) (XY plane)
    // Plane 2: Normal N2=(1,0,0) (YZ plane)
    // Line Direction = N1 x N2 = (0, 1, 0) (Y-axis)
    // -------------------------------------------------------------------------
    n1 = Allocate(24)
    n2 = Allocate(24)
    out_dir = Allocate(24)
    ref_dir = Allocate(24)

    ArraySet(n1, 0, 0x0000000000000000)
    ArraySet(n1, 1, 0x0000000000000000)
    ArraySet(n1, 2, 0x3FF0000000000000) // Z = 1.0

    ArraySet(n2, 0, 0x3FF0000000000000) // X = 1.0
    ArraySet(n2, 1, 0x0000000000000000)
    ArraySet(n2, 2, 0x0000000000000000)

    ArraySet(ref_dir, 0, 0x0000000000000000)
    ArraySet(ref_dir, 1, 0x3FF0000000000000) // Y = 1.0
    ArraySet(ref_dir, 2, 0x0000000000000000)

    CAD_Isect.PlanePlane(n1, 0, n2, 0, out_p, out_dir)
    eq_pp = CAD_Num.PointsEqual(out_dir, ref_dir, 0)
    IfCondition EqualTo(eq_pp, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] PlanePlane(Z, X) -> Dir=(0, 1, 0) (Y-axis)\n", 48)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] PlanePlane line direction mismatch\n", 41)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Clean memory
    Deallocate(p1, 24)
    Deallocate(d1, 24)
    Deallocate(p2, 24)
    Deallocate(d2, 24)
    Deallocate(out_p, 24)
    Deallocate(ref_p, 24)
    Deallocate(c1, 24)
    Deallocate(c2, 24)
    Deallocate(out_cc1, 24)
    Deallocate(out_cc2, 24)
    Deallocate(ref_cc1, 24)
    Deallocate(n1, 24)
    Deallocate(n2, 24)
    Deallocate(out_dir, 24)
    Deallocate(ref_dir, 24)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "   PHASE 4 GATE FAILED — Fix intersection bugs        \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   PHASE 4 GATE PASSED: 100% Intersections Verified!\n", 53)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
