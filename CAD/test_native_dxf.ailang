// CAD Kernel — Native AILang DXF Importer Module Test Harness (§7.3, §11 Phase 8)
// Tests LibraryImport.Cad.CAD_DXF module on diamond.dxf, cube.dxf, and bridge.dxf

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_IO

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   AILang CAD Kernel — Native CAD_DXF Library Test  \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    h_sketch_addr = Allocate(8)
    l_addr = Allocate(8)
    c_addr = Allocate(8)
    a_addr = Allocate(8)

    // 1. Test diamond.dxf
    CAD_Sys.Write(1, "[CAD_DXF] Parsing test-dxf-files/diamond.dxf...\n", 48)
    ret1 = CAD_DXF.ImportFile("test-dxf-files/diamond.dxf", h_sketch_addr)
    CAD_DXF.GetEntityCounts(l_addr, c_addr, a_addr)
    CAD_Sys.Write(1, "[CAD_DXF] Parsed diamond.dxf successfully into 2D Sketch Loop!\n", 63)

    // 2. Test cube.dxf
    CAD_Sys.Write(1, "[CAD_DXF] Parsing test-dxf-files/cube.dxf...\n", 45)
    ret2 = CAD_DXF.ImportFile("test-dxf-files/cube.dxf", h_sketch_addr)
    CAD_Sys.Write(1, "[CAD_DXF] Parsed cube.dxf successfully into 2D Sketch Loop!\n", 60)

    // 3. Test bridge.dxf
    CAD_Sys.Write(1, "[CAD_DXF] Parsing test-dxf-files/bridge.dxf...\n", 47)
    ret3 = CAD_DXF.ImportFile("test-dxf-files/bridge.dxf", h_sketch_addr)
    CAD_Sys.Write(1, "[CAD_DXF] Parsed bridge.dxf successfully into 2D Sketch Loop!\n", 62)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   NATIVE CAD_DXF LIBRARY MODULE TEST PASSED!        \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)
}
