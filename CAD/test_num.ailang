// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Phase 0 Gate Verification: Comprehensive CAD_Num & CAD_Store Deep Test Suite (§12.3)

LibraryImport.Arena
LibraryImport.CAD_Sys
LibraryImport.CAD_Num
LibraryImport.CAD_Store

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   Phase 0: CAD_Num & CAD_Store Deep Verification   \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)
    minus_1_hex = 0xFFFFFFFFFFFFFFFF

    // -------------------------------------------------------------------------
    // 1. Point Equality & Tolerance Authority (§6.4)
    // -------------------------------------------------------------------------
    p_a = Allocate(24)
    p_b = Allocate(24)
    p_c = Allocate(24)

    // p_a = (100.0, 200.0, 300.0)
    ArraySet(p_a, 0, 0x4059000000000000)
    ArraySet(p_a, 1, 0x4069000000000000)
    ArraySet(p_a, 2, 0x4072C00000000000)

    // p_b = (100.0, 200.0, 300.0)
    ArraySet(p_b, 0, 0x4059000000000000)
    ArraySet(p_b, 1, 0x4069000000000000)
    ArraySet(p_b, 2, 0x4072C00000000000)

    // p_c = (100.0001, 200.0, 300.0) -> Outside tolerance
    ArraySet(p_c, 0, 0x405900068DB8BAC7)
    ArraySet(p_c, 1, 0x4069000000000000)
    ArraySet(p_c, 2, 0x4072C00000000000)

    eq_ab = CAD_Num.PointsEqual(p_a, p_b, 0)
    IfCondition EqualTo(eq_ab, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] PointsEqual(a, b) -> 1 (Identical points)\n", 50)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] PointsEqual(a, b) -> Expected 1\n", 39)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    eq_ac = CAD_Num.PointsEqual(p_a, p_c, 0)
    IfCondition EqualTo(eq_ac, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] PointsEqual(a, c) -> 0 (Outside 1e-7 mm tol)\n", 53)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] PointsEqual(a, c) -> Expected 0\n", 39)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 2. Vector Algebra: V3Dot, V3Cross, V3Normalize
    // -------------------------------------------------------------------------
    v_x = Allocate(24)
    v_y = Allocate(24)
    v_out = Allocate(24)
    v_zero = Allocate(24)

    // v_x = (1.0, 0.0, 0.0)
    ArraySet(v_x, 0, 0x3FF0000000000000)
    ArraySet(v_x, 1, 0x0000000000000000)
    ArraySet(v_x, 2, 0x0000000000000000)

    // v_y = (0.0, 1.0, 0.0)
    ArraySet(v_y, 0, 0x0000000000000000)
    ArraySet(v_y, 1, 0x3FF0000000000000)
    ArraySet(v_y, 2, 0x0000000000000000)

    // v_zero = (0.0, 0.0, 0.0)
    ArraySet(v_zero, 0, 0x0000000000000000)
    ArraySet(v_zero, 1, 0x0000000000000000)
    ArraySet(v_zero, 2, 0x0000000000000000)

    // Test Orthogonal Dot Product: X . Y = 0.0
    dot_xy = CAD_Num.V3Dot(v_x, v_y)
    eq_dot = CAD_Num.IsZero(dot_xy, 0)
    IfCondition EqualTo(eq_dot, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] V3Dot(X, Y) -> 0.0 (Orthogonal)\n", 39)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] V3Dot(X, Y) orthogonal mismatch\n", 40)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Test Basis Cross Product: X x Y = Z (0.0, 0.0, 1.0)
    CAD_Num.V3Cross(v_x, v_y, v_out)
    v_z = Allocate(24)
    ArraySet(v_z, 0, 0x0000000000000000)
    ArraySet(v_z, 1, 0x0000000000000000)
    ArraySet(v_z, 2, 0x3FF0000000000000) // 1.0

    eq_cross = CAD_Num.PointsEqual(v_out, v_z, 0)
    IfCondition EqualTo(eq_cross, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] V3Cross(X, Y) -> Z (0, 0, 1)\n", 36)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] V3Cross(X, Y) cross mismatch\n", 37)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Test Degenerate Zero Vector Normalization: V3Normalize(0, 0, 0) -> Returns -6 (CAD_E_DEGENERATE)
    norm_err = CAD_Num.V3Normalize(v_zero, v_out)
    IfCondition EqualTo(norm_err, -6) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] V3Normalize(0, 0, 0) -> -6 (CAD_E_DEGENERATE)\n", 54)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] V3Normalize degenerate error code mismatch\n", 51)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 3. Store Handle Tagging & Index Unpacking
    // Handle format: Tag (16-bit) | Gen (16-bit) | Index (32-bit)
    // -------------------------------------------------------------------------
    h_test = CAD_Store.MakeHandle(5, 1, 42) // Tag=5, Gen=1, Index=42
    h_tag = CAD_Store.Tag(h_test)
    h_gen = CAD_Store.Gen(h_test)
    h_idx = CAD_Store.Index(h_test)

    IfCondition EqualTo(h_tag, 5) ThenBlock: {
        IfCondition EqualTo(h_gen, 1) ThenBlock: {
            IfCondition EqualTo(h_idx, 42) ThenBlock: {
                CAD_Sys.Write(1, "[PASS] Store_MakeHandle -> Tag=5, Gen=1, Index=42\n", 51)
                Test_Results.passed = Add(Test_Results.passed, 1)
            } ElseBlock: {
                CAD_Sys.Write(1, "[FAIL] Store index mismatch\n", 28)
                Test_Results.failed = Add(Test_Results.failed, 1)
            }
        } ElseBlock: {
            CAD_Sys.Write(1, "[FAIL] Store gen mismatch\n", 26)
            Test_Results.failed = Add(Test_Results.failed, 1)
        }
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Store tag mismatch\n", 26)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 4. Shewchuk Orient2D Orientation Reference Values (§6.5)
    // -------------------------------------------------------------------------
    p1 = Allocate(16) // (0.0, 0.0)
    p2 = Allocate(16) // (12.0, 0.0)
    p3 = Allocate(16) // (6.0, 6.0) -> CCW (+1)
    p4 = Allocate(16) // (6.0, -6.0) -> CW (-1)
    p5 = Allocate(16) // (6.0, 0.0) -> Collinear (0)

    ArraySet(p1, 0, 0x0000000000000000)
    ArraySet(p1, 1, 0x0000000000000000)

    ArraySet(p2, 0, 0x4028000000000000) // 12.0
    ArraySet(p2, 1, 0x0000000000000000)

    ArraySet(p3, 0, 0x4018000000000000) // 6.0
    ArraySet(p3, 1, 0x4018000000000000) // 6.0

    ArraySet(p4, 0, 0x4018000000000000) // 6.0
    ArraySet(p4, 1, 0xC018000000000000) // -6.0

    ArraySet(p5, 0, 0x4018000000000000) // 6.0
    ArraySet(p5, 1, 0x0000000000000000) // 0.0

    o_ccw = CAD_Num.Orient2D(p1, p2, p3)
    IfCondition EqualTo(o_ccw, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Orient2D(CCW) -> +1\n", 27)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Orient2D(CCW) -> Expected +1\n", 36)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    o_cw = CAD_Num.Orient2D(p1, p2, p4)
    IfCondition EqualTo(o_cw, minus_1_hex) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Orient2D(CW) -> -1\n", 26)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Orient2D(CW) -> Expected -1\n", 35)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    o_coll = CAD_Num.Orient2D(p1, p2, p5)
    IfCondition EqualTo(o_coll, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Orient2D(Collinear) -> 0\n", 32)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Orient2D(Collinear) -> Expected 0\n", 41)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 5. Shewchuk Orient3D Orientation Reference Values (§6.5)
    // -------------------------------------------------------------------------
    p3d_1 = Allocate(24) // (0, 0, 0)
    p3d_2 = Allocate(24) // (10, 0, 0)
    p3d_3 = Allocate(24) // (0, 10, 0)
    p3d_top = Allocate(24) // (0, 0, 10) -> Positive side (+1)
    p3d_bot = Allocate(24) // (0, 0, -10) -> Negative side (-1)
    p3d_cop = Allocate(24) // (5, 5, 0) -> Coplanar (0)

    ArraySet(p3d_1, 0, 0x0000000000000000)
    ArraySet(p3d_1, 1, 0x0000000000000000)
    ArraySet(p3d_1, 2, 0x0000000000000000)

    ArraySet(p3d_2, 0, 0x4024000000000000) // 10.0
    ArraySet(p3d_2, 1, 0x0000000000000000)
    ArraySet(p3d_2, 2, 0x0000000000000000)

    ArraySet(p3d_3, 0, 0x0000000000000000)
    ArraySet(p3d_3, 1, 0x4024000000000000) // 10.0
    ArraySet(p3d_3, 2, 0x0000000000000000)

    ArraySet(p3d_top, 0, 0x0000000000000000)
    ArraySet(p3d_top, 1, 0x0000000000000000)
    ArraySet(p3d_top, 2, 0x4024000000000000) // 10.0

    ArraySet(p3d_bot, 0, 0x0000000000000000)
    ArraySet(p3d_bot, 1, 0x0000000000000000)
    ArraySet(p3d_bot, 2, 0xC024000000000000) // -10.0

    ArraySet(p3d_cop, 0, 0x4014000000000000) // 5.0
    ArraySet(p3d_cop, 1, 0x4014000000000000) // 5.0
    ArraySet(p3d_cop, 2, 0x0000000000000000)

    o3d_top = CAD_Num.Orient3D(p3d_1, p3d_2, p3d_3, p3d_top)
    IfCondition EqualTo(o3d_top, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Orient3D(Above) -> +1\n", 29)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Orient3D(Above) -> Expected +1\n", 38)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    o3d_bot = CAD_Num.Orient3D(p3d_1, p3d_2, p3d_3, p3d_bot)
    IfCondition EqualTo(o3d_bot, minus_1_hex) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Orient3D(Below) -> -1\n", 29)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Orient3D(Below) -> Expected -1\n", 38)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    o3d_cop = CAD_Num.Orient3D(p3d_1, p3d_2, p3d_3, p3d_cop)
    IfCondition EqualTo(o3d_cop, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Orient3D(Coplanar) -> 0\n", 31)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Orient3D(Coplanar) -> Expected 0\n", 40)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Clean memory
    Deallocate(p_a, 24)
    Deallocate(p_b, 24)
    Deallocate(p_c, 24)
    Deallocate(v_x, 24)
    Deallocate(v_y, 24)
    Deallocate(v_out, 24)
    Deallocate(v_zero, 24)
    Deallocate(v_z, 24)
    Deallocate(p1, 24)
    Deallocate(p2, 24)
    Deallocate(p3, 24)
    Deallocate(p4, 24)
    Deallocate(p5, 24)
    Deallocate(p3d_1, 24)
    Deallocate(p3d_2, 24)
    Deallocate(p3d_3, 24)
    Deallocate(p3d_top, 24)
    Deallocate(p3d_bot, 24)
    Deallocate(p3d_cop, 24)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "   PHASE 0 GATE FAILED — Fix predicate/vector bugs\n", 51)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   PHASE 0 GATE PASSED: Deep Test Suite 100% Verified!\n", 55)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
