// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Phase 12 Gate Verification: Surface Offsetting & Thin-Wall Shell Test Suite (§12.3)

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Offset

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   Phase 12: CAD_Offset Surface & Shelling Suite    \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    in_frame  = Allocate(128)
    out_frame = Allocate(128)
    out_solid = Allocate(24)
    pull_dir  = Allocate(24)
    p0        = Allocate(24)
    out_v     = Allocate(24)
    out_f     = Allocate(24)
    out_s     = Allocate(24)

    // Setup origin (0,0,0) and Normal (0,0,1)
    ArraySet(in_frame, 0, 0x0000000000000000)
    ArraySet(in_frame, 1, 0x0000000000000000)
    ArraySet(in_frame, 2, 0x0000000000000000)
    ArraySet(in_frame, 8, 0x0000000000000000)
    ArraySet(in_frame, 9, 0x0000000000000000)
    ArraySet(in_frame, 10, 0x3FF0000000000000) // NZ = 1.0

    // Build solid A
    CAD_Topo.MVFS(p0, out_v, out_f, out_s)
    h_solid = CAD_Store.Alloc(7, 4)

    // -------------------------------------------------------------------------
    // 1. Surface Normal Offset Test (Offset Plane +25.0mm along Normal Z)
    // -------------------------------------------------------------------------
    r_25 = 0x4039000000000000 // 25.0 mm
    res_off = CAD_Offset.Surface(in_frame, r_25, out_frame)
    pz_off = ArrayGet(out_frame, 2)
    IfCondition EqualTo(pz_off, r_25) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Surface(Plane, +25.0mm Normal) -> Z=25.0mm\n", 51)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Surface offset mismatch\n", 31)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 2. Thin-Wall Shell Solid Test (Hollow enclosure)
    // -------------------------------------------------------------------------
    r_2 = 0x4000000000000000 // 2.0 mm wall
    res_sh = CAD_Offset.ShellSolid(h_solid, r_2, 0, out_solid)
    h_shelled = ArrayGet(out_solid, 0)
    IfCondition NotEqual(h_shelled, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] ShellSolid(Solid, Wall=2.0mm) -> Hollow Enclosure\n", 58)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] ShellSolid returned null handle\n", 39)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 3. Draft Angle Evaluation Test
    // -------------------------------------------------------------------------
    res_draft = CAD_Offset.EvalDraftAngle(1, pull_dir)
    IfCondition NotEqual(res_draft, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalDraftAngle(Face, PullDir) -> Draft Angle Calculated\n", 63)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalDraftAngle failed\n", 29)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Clean memory
    Deallocate(in_frame, 128)
    Deallocate(out_frame, 128)
    Deallocate(out_solid, 24)
    Deallocate(pull_dir, 24)
    Deallocate(p0, 24)
    Deallocate(out_v, 24)
    Deallocate(out_f, 24)
    Deallocate(out_s, 24)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "   PHASE 12 GATE FAILED — Fix Offset/Shell bugs       \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   PHASE 12 GATE PASSED: 100% Surface Offset OK!    \n", 53)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
