// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Master PostgreSQL Application Schema & UI Workbench Verification Test Suite (§11)

LibraryImport.Arena
LibraryImport.CAD_Sys
LibraryImport.CAD_Num
LibraryImport.CAD_Store
LibraryImport.CAD_Repo
LibraryImport.PostgreSQL_Complete

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   Master PostgreSQL Schema & Workbench Suite       \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    wb_name = Allocate(24)
    wb_icon = Allocate(24)
    item_lbl = Allocate(24)
    item_cmd = Allocate(24)

    // -------------------------------------------------------------------------
    // 1. Master Application Schema DDL Generation
    // -------------------------------------------------------------------------
    res_schema = CAD_Repo.InitSchema(0)
    IfCondition EqualTo(res_schema, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] InitSchema (Auth + Workbenches + Toolbars + CAD) -> 0 (CAD_OK)\n", 71)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] InitSchema failed\n", 25)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 2. Dynamic UI Workbench Registration (PartDesign, Sketcher, CAM)
    // -------------------------------------------------------------------------
    res_wb = CAD_Repo.CreateWorkbench(wb_name, wb_icon)
    IfCondition EqualTo(res_wb, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] CreateWorkbench('PartDesign') -> Registered in PostgreSQL\n", 65)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] CreateWorkbench failed\n", 30)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 3. Dynamic Toolbar Item Insertion
    // -------------------------------------------------------------------------
    res_tb = CAD_Repo.AddToolbarItem(1, item_lbl, item_cmd, 1)
    IfCondition EqualTo(res_tb, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] AddToolbarItem('Pad / Extrude', 'Feat_CreatePad') -> OK\n", 61)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] AddToolbarItem failed\n", 29)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Clean memory
    Deallocate(wb_name, 24)
    Deallocate(wb_icon, 24)
    Deallocate(item_lbl, 24)
    Deallocate(item_cmd, 24)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "   WORKBENCH SCHEMA FAILED — Fix database driver bugs\n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   WORKBENCH SCHEMA PASSED: 100% Dynamic UI OK!      \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
