// Live PostgreSQL CAD_Repo: orthogonal document/revision/asset round-trip
// Uses Library.PostgreSQL_Complete via CAD_Repo.
//   createdb cad_db
//   ./ailang.x CAD/test_repo_live.ailang -o test_repo_live.x && ./test_repo_live.x
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_Repo
LibraryImport.PostgreSQL_Complete

Function.TRL_Log {
    Input: msg: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(CAD_Sys.Write(1, msg, n)) }
}

SubRoutine.Main {
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(65536)
    TRL_Log("=== CAD_Repo orthogonal PG ===\n", 32)

    IfCondition NotEqual(CAD_Repo.ConnectLocal(), 0) ThenBlock: {
        TRL_Log("FAIL ConnectLocal (PostgreSQL_Complete)\n", 40)
        SystemCall(60, 1, 0, 0)
    }
    TRL_Log("connected via PostgreSQL_Complete\n", 34)

    IfCondition NotEqual(CAD_Repo.InitSchema(0), 0) ThenBlock: {
        TRL_Log("FAIL InitSchema\n", 16)
        SystemCall(60, 1, 0, 0)
    }
    TRL_Log("schema ok\n", 10)

    CAD_Repo.BeginSession("bob")

    out = Allocate(16)
    IfCondition NotEqual(CAD_DXF.ImportFile("test-stl/test-dxf-files/diamond.dxf", out), 0) ThenBlock: {
        TRL_Log("FAIL DXF\n", 9)
        SystemCall(60, 1, 0, 0)
    }
    sk = ArrayGet(out, 0)
    h = CAD_Feat.ExtrudeProfile(sk, Float_FromInt(12))
    IfCondition EqualTo(h, 0) ThenBlock: {
        TRL_Log("FAIL extrude\n", 13)
        SystemCall(60, 1, 0, 0)
    }
    Deallocate(out, 16)

    // unique name so migration/old rows do not collide with rev numbering
    IfCondition NotEqual(CAD_Repo.SavePart("ortho_diamond", sk, h, 12, 0), 0) ThenBlock: {
        TRL_Log("FAIL SavePart r1\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Repo.SetLastMessage("ortho_diamond", "initial pad H=12")
    TRL_Log("saved rev1\n", 11)

    // second save → rev 2
    h2s = CAD_Feat.ExtrudeProfile(sk, Float_FromInt(20))
    IfCondition NotEqual(CAD_Repo.SavePart("ortho_diamond", sk, h2s, 20, 0), 0) ThenBlock: {
        TRL_Log("FAIL SavePart r2\n", 17)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Repo.SetLastMessage("ortho_diamond", "taller H=20")
    TRL_Log("saved rev2\n", 11)

    pack = Allocate(64)
    IfCondition NotEqual(CAD_Repo.LoadPart("ortho_diamond", pack), 0) ThenBlock: {
        TRL_Log("FAIL LoadPart latest\n", 21)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(ArrayGet(pack, 2), 20) ThenBlock: {
        TRL_Log("FAIL latest height not 20\n", 26)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(ArrayGet(pack, 1), "test-stl/cad_repo_load.stp")

    // load rev 1 explicitly — height from revision.params
    IfCondition NotEqual(CAD_Repo.LoadPartRev("ortho_diamond", 1, pack), 0) ThenBlock: {
        TRL_Log("FAIL LoadPartRev 1\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(ArrayGet(pack, 2), 12) ThenBlock: {
        TRL_Log("FAIL rev1 height not 12\n", 24)
        SystemCall(60, 1, 0, 0)
    }
    Deallocate(pack, 64)

    // escutcheon plate+hole
    out = Allocate(16)
    CAD_DXF.ImportFile("test-stl/test-dxf-files/escutcheon_plate.dxf", out)
    skp = ArrayGet(out, 0)
    CAD_DXF.ImportFile("test-stl/test-dxf-files/keyhole_flared.dxf", out)
    skh = ArrayGet(out, 0)
    Deallocate(out, 16)
    hs = CAD_Feat.ExtrudePlateThroughHole(skp, skh, Float_FromInt(4))
    IfCondition EqualTo(hs, 0) ThenBlock: {
        TRL_Log("FAIL escutcheon solid\n", 22)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Repo.SavePart("ortho_esc", skp, hs, 4, skh), 0) ThenBlock: {
        TRL_Log("FAIL SavePart esc\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    pack = Allocate(64)
    IfCondition NotEqual(CAD_Repo.LoadPart("ortho_esc", pack), 0) ThenBlock: {
        TRL_Log("FAIL LoadPart esc\n", 18)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(ArrayGet(pack, 1), 0) ThenBlock: {
        TRL_Log("FAIL esc solid\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    CAD_IO.ExportSTEP(ArrayGet(pack, 1), "test-stl/cad_repo_escutcheon.stp")
    Deallocate(pack, 64)
    TRL_Log("escutcheon ok\n", 14)

    names = Allocate(4096)
    n = CAD_Repo.ListParts(names, 4096)
    IfCondition LessThan(n, 2) ThenBlock: {
        TRL_Log("FAIL ListParts\n", 15)
        SystemCall(60, 1, 0, 0)
    }
    revs = Allocate(4096)
    nr = CAD_Repo.ListRevisions("ortho_diamond", revs, 4096)
    IfCondition LessThan(nr, 2) ThenBlock: {
        TRL_Log("FAIL ListRevisions\n", 19)
        SystemCall(60, 1, 0, 0)
    }
    Deallocate(names, 4096)
    Deallocate(revs, 4096)
    TRL_Log("list+revs ok\n", 13)

    CAD_Repo.EndSession()
    CAD_Repo.Disconnect()
    TRL_Log("CAD_REPO LIVE OK\n", 17)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
