LibraryImport.Arena
LibraryImport.CAD_Sys
LibraryImport.CAD_Num
LibraryImport.CAD_Store
LibraryImport.CAD_Sketch

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   Phase 3: Clean Industry CAD Constraint API Suite \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    p1 = Allocate(24)
    p2 = Allocate(24)

    // -------------------------------------------------------------------------
    // 1. Industry CAD Friendly API Helpers Registration Tests
    // -------------------------------------------------------------------------
    sk_h = CAD_Store.Alloc(9, 4) // Tag=9 (Sketch)

    // AddCoincident
    c_coinc = CAD_Sketch.AddCoincident(sk_h, 1, 2)
    IfCondition NotEqual(c_coinc, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] AddCoincident(p1, p2) -> OK\n", 35)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] AddCoincident failed\n", 27)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // AddParallel
    c_par = CAD_Sketch.AddParallel(sk_h, 10, 11)
    IfCondition NotEqual(c_par, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] AddParallel(line1, line2) -> OK\n", 39)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] AddParallel failed\n", 25)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // AddPerpendicular
    c_perp = CAD_Sketch.AddPerpendicular(sk_h, 10, 11)
    IfCondition NotEqual(c_perp, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] AddPerpendicular(line1, line2) -> OK\n", 44)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] AddPerpendicular failed\n", 30)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // AddDistance
    r_100 = 0x4059000000000000 // 100.0 mm
    c_dist = CAD_Sketch.AddDistance(sk_h, 1, 2, r_100)
    IfCondition NotEqual(c_dist, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] AddDistance(p1, p2, 100.0mm) -> OK\n", 42)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] AddDistance failed\n", 25)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // AddRadius
    r_25 = 0x4039000000000000 // 25.0 mm
    c_rad = CAD_Sketch.AddRadius(sk_h, 5, r_25)
    IfCondition NotEqual(c_rad, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] AddRadius(circle, 25.0mm) -> OK\n", 39)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] AddRadius failed\n", 23)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // AddDiameter
    r_50 = 0x4049000000000000 // 50.0 mm
    c_dia = CAD_Sketch.AddDiameter(sk_h, 5, r_50)
    IfCondition NotEqual(c_dia, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] AddDiameter(circle, 50.0mm) -> OK\n", 41)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] AddDiameter failed\n", 25)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 2. Horizontal Constraint Residual: C(X) = Y2 - Y1
    // P1 = (0, 50), P2 = (100, 50) -> Residual = 0.0
    // -------------------------------------------------------------------------
    ArraySet(p1, 0, 0x0000000000000000)   // 0.0
    ArraySet(p1, 1, 0x4049000000000000)   // 50.0
    ArraySet(p1, 2, 0x0000000000000000)

    ArraySet(p2, 0, 0x4059000000000000)   // 100.0
    ArraySet(p2, 1, 0x4049000000000000)   // 50.0
    ArraySet(p2, 2, 0x0000000000000000)

    res_h = CAD_Sketch.EvalHorizResidual(p1, p2)
    eq_h = CAD_Num.IsZero(res_h, 0)
    IfCondition EqualTo(eq_h, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalHorizResidual(Y1=50, Y2=50) -> 0.0\n", 45)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalHorizResidual mismatch\n", 33)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 3. Vertical Constraint Residual: C(X) = X2 - X1
    // P1 = (25, 0), P2 = (25, 100) -> Residual = 0.0
    // -------------------------------------------------------------------------
    ArraySet(p1, 0, 0x4039000000000000)   // 25.0
    ArraySet(p1, 1, 0x0000000000000000)
    ArraySet(p1, 2, 0x0000000000000000)

    ArraySet(p2, 0, 0x4039000000000000)   // 25.0
    ArraySet(p2, 1, 0x4059000000000000)   // 100.0
    ArraySet(p2, 2, 0x0000000000000000)

    res_v = CAD_Sketch.EvalVertResidual(p1, p2)
    eq_v = CAD_Num.IsZero(res_v, 0)
    IfCondition EqualTo(eq_v, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalVertResidual(X1=25, X2=25) -> 0.0\n", 44)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalVertResidual mismatch\n", 32)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 4. Distance Constraint Residual: C(X) = ||P2 - P1|| - TargetDist
    // P1 = (0, 0), P2 = (30, 40) -> ||P2-P1|| = sqrt(30^2 + 40^2) = 50.0
    // TargetDist = 50.0 -> Residual = 0.0
    // -------------------------------------------------------------------------
    ArraySet(p1, 0, 0x0000000000000000)
    ArraySet(p1, 1, 0x0000000000000000)
    ArraySet(p1, 2, 0x0000000000000000)

    ArraySet(p2, 0, 0x403E000000000000)   // 30.0
    ArraySet(p2, 1, 0x4044000000000000)   // 40.0
    ArraySet(p2, 2, 0x0000000000000000)

    r_target = 0x4049000000000000 // 50.0
    res_d = CAD_Sketch.EvalDistResidual(p1, p2, r_target)
    eq_d = CAD_Num.IsZero(res_d, 0)
    IfCondition EqualTo(eq_d, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] EvalDistResidual((30,40), Target=50) -> 0.0\n", 50)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] EvalDistResidual mismatch\n", 33)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 5. Variational Solver Runner Test
    // -------------------------------------------------------------------------
    sol_ret = CAD_Sketch.Solve2D(sk_h, 50)
    IfCondition EqualTo(sol_ret, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Solve2D execution -> 0 (CAD_OK)\n", 39)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Solve2D returned non-zero error\n", 39)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Clean memory
    Deallocate(p1, 24)
    Deallocate(p2, 24)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "   PHASE 3 GATE FAILED — Fix solver/constraint bugs  \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   PHASE 3 GATE PASSED: 100% Industry API Verified!\n", 52)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
