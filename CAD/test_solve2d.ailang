// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Phase 9 Gate Verification: Jacobian Matrix & LU Decomposition Solver Test Suite (§12.3)

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Solve2D

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   Phase 9: CAD_Solve2D Jacobian & LU Solver Suite  \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    a_mat = Allocate(32)
    l_mat = Allocate(32)
    u_mat = Allocate(32)
    b_vec = Allocate(16)
    x_vec = Allocate(16)

    // Setup 2x2 Matrix A = [[4, 3], [6, 3]]
    ArraySet(a_mat, 0, 0x4010000000000000) // 4.0
    ArraySet(a_mat, 1, 0x4008000000000000) // 3.0
    ArraySet(a_mat, 2, 0x4018000000000000) // 6.0
    ArraySet(a_mat, 3, 0x4008000000000000) // 3.0

    // Setup b = [10.0, 12.0]
    ArraySet(b_vec, 0, 0x4024000000000000) // 10.0
    ArraySet(b_vec, 1, 0x4028000000000000) // 12.0

    // -------------------------------------------------------------------------
    // 1. LU Decomposition Test
    // -------------------------------------------------------------------------
    res_lu = CAD_Solve2D.LUDecompose(a_mat, 2, l_mat, u_mat)
    IfCondition EqualTo(res_lu, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] LUDecompose(2x2 Matrix) -> 0 (CAD_OK)\n", 45)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] LUDecompose failed\n", 25)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 2. LU Linear Forward & Backward Substitution Test
    // -------------------------------------------------------------------------
    res_sol = CAD_Solve2D.LUSolve(l_mat, u_mat, b_vec, 2, x_vec)
    IfCondition EqualTo(res_sol, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] LUSolve(L, U, b) -> Vector X Solved\n", 43)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] LUSolve failed\n", 21)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 3. Jacobian Matrix Assembly Test
    // -------------------------------------------------------------------------
    sk_h = CAD_Store.Alloc(9, 4)
    j_mat = Allocate(128)
    c_vec = Allocate(32)

    res_j = CAD_Solve2D.AssembleJacobian(sk_h, 2, 2, j_mat, c_vec)
    IfCondition EqualTo(res_j, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] AssembleJacobian(Sketch, 2 Constraints) -> Matrix J\n", 59)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] AssembleJacobian failed\n", 31)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 4. Newton-Raphson Constraint Iteration Test
    // -------------------------------------------------------------------------
    res_nr = CAD_Solve2D.SolveNewtonRaphson(sk_h, 2, 50, 0x3E7AD7F29ABCAF48)
    IfCondition EqualTo(res_nr, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] SolveNewtonRaphson(Sketch) -> Converged (0.0000mm)\n", 58)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] SolveNewtonRaphson failed\n", 33)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Clean memory
    Deallocate(a_mat, 32)
    Deallocate(l_mat, 32)
    Deallocate(u_mat, 32)
    Deallocate(b_vec, 16)
    Deallocate(x_vec, 16)
    Deallocate(j_mat, 128)
    Deallocate(c_vec, 32)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "   PHASE 9 GATE FAILED — Fix Solve2D Jacobian bugs   \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   PHASE 9 GATE PASSED: 100% Jacobian Matrix OK!     \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
