// Solve2D: real LU, a 3-4-5 triangle, a point on two circles, a move.
// Pass/fail uses CAD_Num.IsEqual / IsZero. tol 0 means Num_Tol.linear.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Solve2D

SubRoutine.Main {
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(32768)

    a_mat = Allocate(64)
    l_mat = Allocate(64)
    u_mat = Allocate(64)
    b_vec = Allocate(32)
    x_vec = Allocate(32)
    ArraySet(a_mat, 0, 0x4010000000000000)
    ArraySet(a_mat, 1, 0x4008000000000000)
    ArraySet(a_mat, 2, 0x4018000000000000)
    ArraySet(a_mat, 3, 0x4008000000000000)
    ArraySet(b_vec, 0, 0x4024000000000000)
    ArraySet(b_vec, 1, 0x4028000000000000)
    res_lu = CAD_Solve2D.LUDecompose(a_mat, 2, l_mat, u_mat)
    res_sol = CAD_Solve2D.LUSolve(l_mat, u_mat, b_vec, 2, x_vec)
    IfCondition NotEqual(res_lu, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL lu\n", 8)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(res_sol, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL lu\n", 8)
        SystemCall(60, 1, 0, 0)
    }
    x0 = ArrayGet(x_vec, 0)
    x1 = ArrayGet(x_vec, 1)
    IfCondition EqualTo(CAD_Num.IsEqual(x0, 0x3FF0000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL lu x\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Num.IsEqual(x1, 0x4000000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL lu x\n", 10)
        SystemCall(60, 1, 0, 0)
    }

    sk0 = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddLine(sk0, 0, 0, 0x4059000000000000, 0)
    res_empty = CAD_Solve2D.SolveNewtonRaphson(sk0, 4, 50, 0)
    IfCondition NotEqual(res_empty, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL empty\n", 11)
        SystemCall(60, 1, 0, 0)
    }

    xy = Allocate(32)
    j_mat = Allocate(8192)
    c_vec = Allocate(512)
    sk = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddUserPoint(sk, 0, 0, 0)
    CAD_Sketch.AddUserPoint(sk, 0x4018000000000000, 0, 0)
    CAD_Sketch.AddUserPoint(sk, 0x3FF0000000000000, 0x3FF0000000000000, 0)
    CAD_Sketch.PendConstraintValue(0x4008000000000000)
    CAD_Sketch.AddConstraint2(sk, 15, 3, 0, 3, 1)
    CAD_Sketch.PendConstraintValue(0x4010000000000000)
    CAD_Sketch.AddConstraint2(sk, 15, 3, 0, 3, 2)
    CAD_Sketch.PendConstraintValue(0x4014000000000000)
    CAD_Sketch.AddConstraint2(sk, 15, 3, 1, 3, 2)

    res_j = CAD_Solve2D.AssembleJacobian(sk, 0, 0, j_mat, c_vec)
    IfCondition NotEqual(res_j, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL jac\n", 9)
        SystemCall(60, 1, 0, 0)
    }
    c0 = ArrayGet(c_vec, 0)
    IfCondition EqualTo(CAD_Num.IsEqual(c0, 0x4008000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL jac\n", 9)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Solve2D_State.jacobian_size, 18) ThenBlock: {
        CAD_Sys.Write(1, "FAIL jac\n", 9)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Solve2D_State.nvar, 6) ThenBlock: {
        CAD_Sys.Write(1, "FAIL ring\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Solve2D_State.ring_n, 6) ThenBlock: {
        CAD_Sys.Write(1, "FAIL ring\n", 10)
        SystemCall(60, 1, 0, 0)
    }

    res_tri = CAD_Solve2D.SolveNewtonRaphson(sk, 0, 80, 0)
    IfCondition NotEqual(res_tri, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL tri\n", 9)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Sketch_State.solved_dof, 3) ThenBlock: {
        CAD_Sys.Write(1, "FAIL dof\n", 9)
        SystemCall(60, 1, 0, 0)
    }

    CAD_Sketch.GetUserPoint(sk, 0, xy)
    ax = ArrayGet(xy, 0)
    ay = ArrayGet(xy, 1)
    CAD_Sketch.GetUserPoint(sk, 1, xy)
    bx = ArrayGet(xy, 0)
    by = ArrayGet(xy, 1)
    dx = Float_Sub(bx, ax)
    dy = Float_Sub(by, ay)
    d = CAD_Num.Hypot2(dx, dy)
    IfCondition EqualTo(CAD_Num.IsEqual(d, 0x4008000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL dist\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sketch.GetUserPoint(sk, 2, xy)
    cx = ArrayGet(xy, 0)
    cy = ArrayGet(xy, 1)
    dx = Float_Sub(cx, ax)
    dy = Float_Sub(cy, ay)
    d = CAD_Num.Hypot2(dx, dy)
    IfCondition EqualTo(CAD_Num.IsEqual(d, 0x4010000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL dist\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    dx = Float_Sub(cx, bx)
    dy = Float_Sub(cy, by)
    d = CAD_Num.Hypot2(dx, dy)
    IfCondition EqualTo(CAD_Num.IsEqual(d, 0x4014000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL dist\n", 10)
        SystemCall(60, 1, 0, 0)
    }

    ox = cx
    oy = cy
    res_mv = CAD_Solve2D.MovePoint(sk, 3, 2, 0x3FF0000000000000, 0)
    IfCondition NotEqual(res_mv, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL move\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sketch.GetUserPoint(sk, 2, xy)
    cx = ArrayGet(xy, 0)
    cy = ArrayGet(xy, 1)
    want = Float_Add(ox, 0x3FF0000000000000)
    IfCondition EqualTo(CAD_Num.IsEqual(cx, want, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL move\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(CAD_Num.IsEqual(cy, oy, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL move\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sketch.GetUserPoint(sk, 0, xy)
    ax = ArrayGet(xy, 0)
    ay = ArrayGet(xy, 1)
    CAD_Sketch.GetUserPoint(sk, 1, xy)
    bx = ArrayGet(xy, 0)
    by = ArrayGet(xy, 1)
    CAD_Sketch.GetUserPoint(sk, 2, xy)
    cx = ArrayGet(xy, 0)
    cy = ArrayGet(xy, 1)
    dx = Float_Sub(bx, ax)
    dy = Float_Sub(by, ay)
    d = CAD_Num.Hypot2(dx, dy)
    IfCondition EqualTo(CAD_Num.IsEqual(d, 0x4008000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL dist\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    dx = Float_Sub(cx, ax)
    dy = Float_Sub(cy, ay)
    d = CAD_Num.Hypot2(dx, dy)
    IfCondition EqualTo(CAD_Num.IsEqual(d, 0x4010000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL dist\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    dx = Float_Sub(cx, bx)
    dy = Float_Sub(cy, by)
    d = CAD_Num.Hypot2(dx, dy)
    IfCondition EqualTo(CAD_Num.IsEqual(d, 0x4014000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL dist\n", 10)
        SystemCall(60, 1, 0, 0)
    }

    skc = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddCircle(skc, 0, 0, 0x4014000000000000)
    CAD_Sketch.AddCircle(skc, 0x4018000000000000, 0, 0x4014000000000000)
    CAD_Sketch.AddUserPoint(skc, 0x4008000000000000, 0x3FF0000000000000, 0)
    CAD_Sketch.AddConstraint2(skc, 16, 3, 0, 4, 0)
    CAD_Sketch.AddConstraint2(skc, 16, 3, 0, 4, 1)
    res_c = CAD_Solve2D.SolveNewtonRaphson(skc, 0, 80, 0)
    IfCondition NotEqual(res_c, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circ\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Sketch_State.solved_dof, 2) ThenBlock: {
        CAD_Sys.Write(1, "FAIL dof\n", 9)
        SystemCall(60, 1, 0, 0)
    }
    IfCondition NotEqual(CAD_Solve2D_State.ring_n, CAD_Solve2D_State.nvar) ThenBlock: {
        CAD_Sys.Write(1, "FAIL ring\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sketch.GetUserPoint(skc, 0, xy)
    px = ArrayGet(xy, 0)
    py = ArrayGet(xy, 1)
    IfCondition EqualTo(Float_Le(py, 0), 1) ThenBlock: {
        CAD_Sys.Write(1, "FAIL y\n", 7)
        SystemCall(60, 1, 0, 0)
    }
    d = CAD_Num.Hypot2(px, py)
    IfCondition EqualTo(CAD_Num.IsEqual(d, 0x4014000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circ\n", 10)
        SystemCall(60, 1, 0, 0)
    }
    dx = Float_Sub(px, 0x4018000000000000)
    d = CAD_Num.Hypot2(dx, py)
    IfCondition EqualTo(CAD_Num.IsEqual(d, 0x4014000000000000, 0), 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL circ\n", 10)
        SystemCall(60, 1, 0, 0)
    }

    skb = CAD_Sketch.CreateSketch(1)
    CAD_Sketch.AddUserPoint(skb, 0, 0, 0)
    CAD_Sketch.AddUserPoint(skb, 0x4018000000000000, 0, 0)
    CAD_Sketch.AddUserPoint(skb, 0x3FF0000000000000, 0x3FF0000000000000, 0)
    CAD_Sketch.PendConstraintValue(0x4008000000000000)
    CAD_Sketch.AddConstraint2(skb, 15, 3, 0, 3, 1)
    CAD_Sketch.PendConstraintValue(0x4010000000000000)
    CAD_Sketch.AddConstraint2(skb, 15, 3, 0, 3, 2)
    CAD_Sketch.PendConstraintValue(0x4024000000000000)
    CAD_Sketch.AddConstraint2(skb, 15, 3, 1, 3, 2)
    res_bad = CAD_Solve2D.SolveNewtonRaphson(skb, 0, 40, 0)
    IfCondition EqualTo(res_bad, 0) ThenBlock: {
        CAD_Sys.Write(1, "FAIL bad\n", 9)
        SystemCall(60, 1, 0, 0)
    }

    CAD_Sys.Write(1, "SOLVE2D_OK\n", 11)
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
