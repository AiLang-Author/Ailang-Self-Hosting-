// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Phase 7 Gate Verification: B-Rep Tessellation, Watertight Mesh & STL Export Test Suite (§12.3)

LibraryImport.Arena
LibraryImport.CAD_Sys
LibraryImport.CAD_Num
LibraryImport.CAD_Store
LibraryImport.CAD_Topo
LibraryImport.CAD_Tess

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   Phase 7: CAD_Tess Mesh & STL Export Test Suite   \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    p0 = Allocate(24)
    out_v = Allocate(24)
    out_f = Allocate(24)
    out_s = Allocate(24)

    v_array = Allocate(256)
    i_array = Allocate(256)

    // Build solid A
    CAD_Topo.MVFS(p0, out_v, out_f, out_s)
    h_solid = CAD_Store.Alloc(7, 4)

    // -------------------------------------------------------------------------
    // 1. Mesh Generation Test (B-Rep Solid -> Triangles)
    // -------------------------------------------------------------------------
    num_tri = CAD_Tess.MeshSolid(h_solid, 0, v_array, i_array)
    IfCondition GreaterThan(num_tri, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] MeshSolid(Solid, 0.01mm) -> Triangles Generated\n", 55)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] MeshSolid failed\n", 24)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 2. Watertight Manifold Mesh Verification
    // -------------------------------------------------------------------------
    res_wt = CAD_Tess.VerifyWatertight(v_array, i_array, num_tri)
    IfCondition EqualTo(res_wt, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] VerifyWatertight(Mesh) -> 1 (Watertight Manifold)\n", 57)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] VerifyWatertight failed\n", 31)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 3. STL Mesh Export Test (model.stl)
    // -------------------------------------------------------------------------
    res_stl = CAD_Tess.ExportSTL(h_solid, 0, "model.stl")
    IfCondition EqualTo(res_stl, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] ExportSTL(Solid) -> model.stl Written\n", 45)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] ExportSTL failed\n", 24)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Clean memory
    Deallocate(p0, 24)
    Deallocate(out_v, 24)
    Deallocate(out_f, 24)
    Deallocate(out_s, 24)
    Deallocate(v_array, 256)
    Deallocate(i_array, 256)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "   PHASE 7 GATE FAILED — Fix Tessellation bugs       \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   PHASE 7 GATE PASSED: 100% Tessellation & STL OK!  \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
