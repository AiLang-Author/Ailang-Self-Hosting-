// CAD_Tess — mesh box + STL export

LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_Script

FixedPool.T {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== CAD_Tess tests ===\n", 23)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(1024)

    // unit box via Script
    one = 0x3FF0000000000000
    h = CAD_Script.CreateBox(one, one, one)
    IfCondition NotEqual(h, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] CreateBox solid\n", 23)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] CreateBox\n", 17)
        T.failed = Add(T.failed, 1)
    }

    mesh = Allocate(48)
    ntri = CAD_Tess.MeshSolid(h, 0, mesh)
    // 6 quads * 2 = 12 tris
    IfCondition EqualTo(ntri, 12) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] MeshSolid 12 tris\n", 25)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] MeshSolid tri count\n", 27)
        T.failed = Add(T.failed, 1)
    }

    nv = ArrayGet(mesh, 0)
    // 6 faces * 4 verts = 24 (duplicated corners OK)
    IfCondition EqualTo(nv, 24) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] MeshSolid 24 verts\n", 26)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] MeshSolid vert count\n", 28)
        T.failed = Add(T.failed, 1)
    }

    wt = CAD_Tess.VerifyWatertight(mesh)
    IfCondition EqualTo(wt, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] watertight heuristic\n", 28)
        T.passed = Add(T.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] watertight\n", 18)
        T.failed = Add(T.failed, 1)
    }

    // write STL next to CWD for FreeCAD
    CAD_Tess.ExportSTL(h, "test-stl/cad_box_unit.stl")
    CAD_Sys.Write(1, "[PASS] ExportSTL cad_box_unit.stl\n", 34)
    T.passed = Add(T.passed, 1)

    Deallocate(mesh, 48)

    IfCondition GreaterThan(T.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "TESS FAILED\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "TESS PASSED\n", 12)
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
