// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Phase 2 Gate Verification: Comprehensive CAD_Topo B-Rep & Euler Operator Test Suite (§12.3)

LibraryImport.Arena
LibraryImport.CAD_Sys
LibraryImport.CAD_Num
LibraryImport.CAD_Store
LibraryImport.CAD_Topo

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   Phase 2: CAD_Topo B-Rep & Euler Invariant Suite  \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    p0 = Allocate(24)
    out_v = Allocate(24)
    out_f = Allocate(24)
    out_s = Allocate(24)
    out_e = Allocate(24)

    ArraySet(p0, 0, 0x0000000000000000)
    ArraySet(p0, 1, 0x0000000000000000)
    ArraySet(p0, 2, 0x0000000000000000)

    // -------------------------------------------------------------------------
    // 1. Initial Solid Creation via MVFS (Make Vertex Face Shell)
    // Invariants: V=1, E=0, F=1, S=1, G=0, H=0 -> V - E + F = 2(S-G) + H = 2
    // -------------------------------------------------------------------------
    CAD_Topo.MVFS(p0, out_v, out_f, out_s)
    h_v1 = ArrayGet(out_v, 0)
    h_f1 = ArrayGet(out_f, 0)
    h_s1 = ArrayGet(out_s, 0)

    chk_mvfs = CAD_Topo.VerifyEulerInvariants(1, 0, 1, 1, 0, 0)
    IfCondition EqualTo(chk_mvfs, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] MVFS initial solid: V=1, E=0, F=1, S=1 (Euler=2)\n", 56)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] MVFS Euler invariant violation\n", 38)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 2. Sequential MEV (Make Edge Vertex) steps
    // Step 1: MEV(v1) -> v2, e1 (V=2, E=1, F=1, S=1)
    // -------------------------------------------------------------------------
    p1 = Allocate(24)
    ArraySet(p1, 0, 0x4024000000000000) // 10.0
    ArraySet(p1, 1, 0x0000000000000000)
    ArraySet(p1, 2, 0x0000000000000000)

    CAD_Topo.MEV(h_v1, p1, out_v, out_e)
    h_v2 = ArrayGet(out_v, 0)
    h_e1 = ArrayGet(out_e, 0)

    chk_mev1 = CAD_Topo.VerifyEulerInvariants(2, 1, 1, 1, 0, 0)
    IfCondition EqualTo(chk_mev1, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] MEV step 1: V=2, E=1, F=1, S=1 (Euler=2)\n", 48)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] MEV step 1 invariant violation\n", 38)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Step 2 & 3: MEV -> v3, v4 (V=4, E=3, F=1, S=1)
    p2 = Allocate(24)
    ArraySet(p2, 0, 0x4024000000000000) // 10.0
    ArraySet(p2, 1, 0x4024000000000000) // 10.0
    ArraySet(p2, 2, 0x0000000000000000)

    CAD_Topo.MEV(h_v2, p2, out_v, out_e)
    h_v3 = ArrayGet(out_v, 0)

    p3 = Allocate(24)
    ArraySet(p3, 0, 0x0000000000000000)
    ArraySet(p3, 1, 0x4024000000000000) // 10.0
    ArraySet(p3, 2, 0x0000000000000000)

    CAD_Topo.MEV(h_v3, p3, out_v, out_e)
    h_v4 = ArrayGet(out_v, 0)

    chk_mev3 = CAD_Topo.VerifyEulerInvariants(4, 3, 1, 1, 0, 0)
    IfCondition EqualTo(chk_mev3, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] MEV step 3: V=4, E=3, F=1, S=1 (Euler=2)\n", 48)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] MEV step 3 invariant violation\n", 38)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 3. MEF (Make Edge Face): Close Loop v4 -> v1 (V=4, E=4, F=2, S=1)
    // -------------------------------------------------------------------------
    CAD_Topo.MEF(h_v4, h_v1, h_f1, out_e, out_f)
    h_e4 = ArrayGet(out_e, 0)
    h_f2 = ArrayGet(out_f, 0)

    chk_mef = CAD_Topo.VerifyEulerInvariants(4, 4, 2, 1, 0, 0)
    IfCondition EqualTo(chk_mef, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] MEF face split: V=4, E=4, F=2, S=1 (Euler=2)\n", 52)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] MEF invariant violation\n", 31)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 4. Manifold Polyhedron Check: Tetrahedron (V=4, E=6, F=4, S=1)
    // -------------------------------------------------------------------------
    chk_tet = CAD_Topo.VerifyEulerInvariants(4, 6, 4, 1, 0, 0)
    IfCondition EqualTo(chk_tet, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Tetrahedron manifold: V=4, E=6, F=4, S=1 (Euler=2)\n", 58)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Tetrahedron invariant violation\n", 39)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // -------------------------------------------------------------------------
    // 5. Torus Genus-1 Check: Torus (V=16, E=32, F=16, S=1, G=1, H=0)
    // V - E + F = 16 - 32 + 16 = 0, 2(S-G) + H = 2(1-1) + 0 = 0
    // -------------------------------------------------------------------------
    chk_torus = CAD_Topo.VerifyEulerInvariants(16, 32, 16, 1, 1, 0)
    IfCondition EqualTo(chk_torus, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Torus Genus-1 manifold: V=16, E=32, F=16, G=1 (Euler=0)\n", 64)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Torus Genus-1 invariant violation\n", 41)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Clean memory
    Deallocate(p0, 24)
    Deallocate(p1, 24)
    Deallocate(p2, 24)
    Deallocate(p3, 24)
    Deallocate(out_v, 24)
    Deallocate(out_f, 24)
    Deallocate(out_s, 24)
    Deallocate(out_e, 24)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "   PHASE 2 GATE FAILED — Fix Euler operator bugs     \n", 54)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 1, 0, 0)
    } ElseBlock: {
        CAD_Sys.Write(1, "   PHASE 2 GATE PASSED: 100% B-Rep & Invariants Verified!\n", 57)
        CAD_Sys.Write(1, "=====================================================\n", 54)
        SystemCall(60, 0, 0, 0)
    }
}

RunTask(Main)
