LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo

FixedPool.Test_Results {
    "passed": Initialize=0
    "failed": Initialize=0
}

SubRoutine.Main {
    CAD_Sys.Write(1, "=== CAD_Topo tests ===\n", 23)
    CAD_Num.InitTolerance(0, 0)
    CAD_Store.Init(1024)

    pt = Allocate(32)
    outv = Allocate(16)
    oute = Allocate(16)
    outf = Allocate(16)
    outs = Allocate(16)
    solid = Allocate(16)
    counts = Allocate(64)
    pback = Allocate(32)
    pts = Allocate(80)

    // --- MVFS ---
    ArraySet(pt, 0, 0)
    ArraySet(pt, 1, 0)
    ArraySet(pt, 2, 0)
    h_so = CAD_Topo.MVFS(pt, outv, outf, outs)
    h_v = ArrayGet(outv, 0)
    IfCondition NotEqual(h_so, 0) ThenBlock: {
        IfCondition EqualTo(CAD_Store.IsLive(h_v), 1) ThenBlock: {
            CAD_Sys.Write(1, "[PASS] MVFS solid+vertex live\n", 30)
            Test_Results.passed = Add(Test_Results.passed, 1)
        } ElseBlock: {
            CAD_Sys.Write(1, "[FAIL] MVFS vertex dead\n", 24)
            Test_Results.failed = Add(Test_Results.failed, 1)
        }
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] MVFS null solid\n", 23)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    CAD_Topo.VertexGetPoint(h_v, pback)
    IfCondition EqualTo(CAD_Num.PointsEqual(pt, pback, 0), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] VertexGetPoint round-trip\n", 33)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] VertexGetPoint\n", 22)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // --- MEV ---
    ArraySet(pt, 0, 0x3FF0000000000000)
    ArraySet(pt, 1, 0)
    ArraySet(pt, 2, 0)
    CAD_Topo.MEV(h_v, pt, outv, oute)
    h_v2 = ArrayGet(outv, 0)
    h_e = ArrayGet(oute, 0)
    IfCondition EqualTo(CAD_Topo.EdgeGetV0(h_e), h_v) ThenBlock: {
        IfCondition EqualTo(CAD_Topo.EdgeGetV1(h_e), h_v2) ThenBlock: {
            CAD_Sys.Write(1, "[PASS] MEV edge endpoints\n", 26)
            Test_Results.passed = Add(Test_Results.passed, 1)
        } ElseBlock: {
            CAD_Sys.Write(1, "[FAIL] MEV v1\n", 14)
            Test_Results.failed = Add(Test_Results.failed, 1)
        }
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] MEV v0\n", 14)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // twins on MEV coedges
    ce0 = CAD_Store.Read(h_e, 3)
    ce1 = CAD_Store.Read(h_e, 4)
    IfCondition EqualTo(CAD_Topo.CoedgeTwin(ce0), ce1) ThenBlock: {
        IfCondition EqualTo(CAD_Topo.CoedgeTwin(ce1), ce0) ThenBlock: {
            CAD_Sys.Write(1, "[PASS] MEV coedge twins\n", 24)
            Test_Results.passed = Add(Test_Results.passed, 1)
        } ElseBlock: {
            CAD_Sys.Write(1, "[FAIL] twin reverse\n", 20)
            Test_Results.failed = Add(Test_Results.failed, 1)
        }
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] twin forward\n", 20)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // --- Triangle solid ---
    // (0,0,0) (1,0,0) (0,1,0)
    ArraySet(pts, 0, 0)
    ArraySet(pts, 1, 0)
    ArraySet(pts, 2, 0)
    ArraySet(pts, 3, 0x3FF0000000000000)
    ArraySet(pts, 4, 0)
    ArraySet(pts, 5, 0)
    ArraySet(pts, 6, 0)
    ArraySet(pts, 7, 0x3FF0000000000000)
    ArraySet(pts, 8, 0)

    // reset counts by noting delta — use fresh store capacity still same
    // MakeTriangleSolid adds V=3 E=3 F=1 S=1 solid=1, loop=1, coedge=6
    before_v = CAD_Topo_State.vertex_count
    h_tri = CAD_Topo.MakeTriangleSolid(pts, solid)
    IfCondition NotEqual(h_tri, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] MakeTriangleSolid non-null\n", 34)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] MakeTriangleSolid\n", 25)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Loop has 3 coedges
    // solid -> shell -> face -> loop
    sh = CAD_Store.Read(h_tri, 0)
    fa = CAD_Store.Read(sh, 0)
    lp = CAD_Store.Read(fa, 1)
    nce = CAD_Topo.LoopCountCoedges(lp)
    IfCondition EqualTo(nce, 3) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] triangle loop 3 coedges\n", 31)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] loop coedge count\n", 25)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // walk next closed
    head = CAD_Store.Read(lp, 0)
    n1 = CAD_Topo.CoedgeNext(head)
    n2 = CAD_Topo.CoedgeNext(n1)
    n3 = CAD_Topo.CoedgeNext(n2)
    IfCondition EqualTo(n3, head) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] coedge ring closes\n", 26)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] coedge ring\n", 19)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Euler for single triangle face as disk: V-E+F = 3-3+1 = 1
    // full closed sphere genus 0: V-E+F=2; open face-shell use G=0 H=0 S=1 → RHS=2
    // For triangle patch: V=3 E=3 F=1 → LHS=1; not a closed solid
    // Use VerifyEuler with numbers for closed tetra later; for now check formula helper
    // counts_addr: V E F S G H
    ArraySet(counts, 0, 4)
    ArraySet(counts, 1, 6)
    ArraySet(counts, 2, 4)
    ArraySet(counts, 3, 1)
    ArraySet(counts, 4, 0)
    ArraySet(counts, 5, 0)
    ok = CAD_Topo.VerifyEulerInvariants(counts)
    IfCondition EqualTo(ok, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Euler tetra 4-6+4=2\n", 27)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Euler tetra\n", 19)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    ArraySet(counts, 0, 3)
    ArraySet(counts, 1, 3)
    ArraySet(counts, 2, 1)
    ArraySet(counts, 3, 1)
    ArraySet(counts, 4, 0)
    ArraySet(counts, 5, 0)
    ok2 = CAD_Topo.VerifyEulerInvariants(counts)
    IfCondition EqualTo(ok2, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Euler rejects open triangle as closed\n", 45)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Euler should reject\n", 27)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // --- Box solid: V=8 E=12 F=6 → Euler 2 ---
    mn = Allocate(32)
    mx = Allocate(32)
    ArraySet(mn, 0, 0)
    ArraySet(mn, 1, 0)
    ArraySet(mn, 2, 0)
    ArraySet(mx, 0, 0x3FF0000000000000)
    ArraySet(mx, 1, 0x3FF0000000000000)
    ArraySet(mx, 2, 0x3FF0000000000000)
    h_box = CAD_Topo.MakeBoxSolid(mn, mx, solid)
    IfCondition NotEqual(h_box, 0) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] MakeBoxSolid non-null\n", 29)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] MakeBoxSolid\n", 20)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }
    // 6 faces, each 4 coedges
    shb = CAD_Store.Read(h_box, 0)
    fb0 = CAD_Store.Read(shb, 0)
    nface = 1
    fx = CAD_Store.Read(fb0, 3)
    WhileLoop NotEqual(fx, 0) {
        nface = Add(nface, 1)
        fx = CAD_Store.Read(fx, 3)
    }
    IfCondition EqualTo(nface, 6) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] box has 6 faces\n", 23)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] box face count\n", 22)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }
    lp0 = CAD_Store.Read(fb0, 1)
    nce_box = CAD_Topo.LoopCountCoedges(lp0)
    IfCondition EqualTo(nce_box, 4) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] box face loop 4 coedges\n", 31)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] box loop size\n", 21)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }
    ArraySet(counts, 0, 8)
    ArraySet(counts, 1, 12)
    ArraySet(counts, 2, 6)
    ArraySet(counts, 3, 1)
    ArraySet(counts, 4, 0)
    ArraySet(counts, 5, 0)
    okb = CAD_Topo.VerifyEulerInvariants(counts)
    IfCondition EqualTo(okb, 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] Euler box 8-12+6=2\n", 26)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] Euler box\n", 17)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    // Box faces carry real plane surfaces; first edge carries a line curve
    surf0 = CAD_Store.Read(fb0, 0)
    IfCondition EqualTo(CAD_Store.IsLive(surf0), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] box face has live plane surface\n", 39)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] box face surface missing\n", 32)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }
    // walk face0 loop → edge → curve
    ce_b = CAD_Store.Read(lp0, 0)
    ed_b = CAD_Store.Read(ce_b, 0)
    crv_b = CAD_Store.Read(ed_b, 2)
    IfCondition EqualTo(CAD_Store.IsLive(crv_b), 1) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] box edge has live line curve\n", 36)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] box edge curve missing\n", 30)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }
    // all 6 faces have surfaces
    nsurf = 0
    fx2 = fb0
    WhileLoop NotEqual(fx2, 0) {
        sfx = CAD_Store.Read(fx2, 0)
        IfCondition EqualTo(CAD_Store.IsLive(sfx), 1) ThenBlock: {
            nsurf = Add(nsurf, 1)
        }
        fx2 = CAD_Store.Read(fx2, 3)
    }
    IfCondition EqualTo(nsurf, 6) ThenBlock: {
        CAD_Sys.Write(1, "[PASS] all 6 box faces have surfaces\n", 37)
        Test_Results.passed = Add(Test_Results.passed, 1)
    } ElseBlock: {
        CAD_Sys.Write(1, "[FAIL] face surface count\n", 26)
        Test_Results.failed = Add(Test_Results.failed, 1)
    }

    Deallocate(mn, 32)
    Deallocate(mx, 32)

    Deallocate(pt, 32)
    Deallocate(outv, 16)
    Deallocate(oute, 16)
    Deallocate(outf, 16)
    Deallocate(outs, 16)
    Deallocate(solid, 16)
    Deallocate(counts, 64)
    Deallocate(pback, 32)
    Deallocate(pts, 80)

    CAD_Sys.Write(1, "========================\n", 25)
    IfCondition GreaterThan(Test_Results.failed, 0) ThenBlock: {
        CAD_Sys.Write(1, "TOPO FAILED\n", 12)
        SystemCall(60, 1, 0, 0)
    }
    CAD_Sys.Write(1, "TOPO PASSED\n", 12)
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
