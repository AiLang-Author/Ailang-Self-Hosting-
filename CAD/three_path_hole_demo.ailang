// CAD Kernel — Three-Path Hole Generation Engine Demo in AILang (§8, §11 Phase 6)
// Path 1: 2D Sketch Profile Extrusion (Extrude with inner hole loop)
// Path 2: Solid Feature Hole Modification (CSG Boolean Subtraction)
// Path 3: Subtractive Extrusion / Pocket Cut Extrude (Top Face Sketch Cut)

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Script

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   AILang CAD Kernel — Three-Path Hole Engine v1.0  \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    // -----------------------------------------------------------------
    // PATH 1: 2D Sketch Profile Extrusion (Outer Rectangle + Inner Hole)
    // -----------------------------------------------------------------
    CAD_Sys.Write(1, "[PATH 1] 2D Sketch Profile Extrusion Engine...\n", 47)
    h_sketch1 = CAD_Sketch.CreateSketch(1) // Workplane 1 = XY Plane
    CAD_Sketch.AddLine(h_sketch1, 0, 0, 0x4059000000000000, 0) // 0 to 100
    CAD_Sketch.AddCircle(h_sketch1, 0x4049000000000000, 0x4039000000000000, 0x4024000000000000) // Center (50,25), R=10

    h_solid_path1 = CAD_Feat.ExtrudeProfile(h_sketch1, 0x4039000000000000) // Depth = 25mm
    CAD_Script.ExportAll(h_solid_path1, "path1_extrude_sketch.stp", "path1_extrude_sketch.stl")
    CAD_Sys.Write(1, "[PATH 1] Saved path1_extrude_sketch.stp & .stl OK!\n", 50)

    // -----------------------------------------------------------------
    // PATH 2: Solid Feature Hole Modification (CSG Boolean Subtraction)
    // -----------------------------------------------------------------
    CAD_Sys.Write(1, "[PATH 2] CSG Feature Hole Modification Engine...\n", 49)
    h_base_box = CAD_Store.Alloc(7, 4) // Tag 7=Solid Box (100x50x25mm)
    h_solid_path2 = CAD_Feat.DrillHole(h_base_box, 0x4049000000000000, 0x4039000000000000, 0x4034000000000000, 0x4039000000000000) // Dia=20, Depth=25
    CAD_Script.ExportAll(h_solid_path2, "path2_csg_drill_hole.stp", "path2_csg_drill_hole.stl")
    CAD_Sys.Write(1, "[PATH 2] Saved path2_csg_drill_hole.stp & .stl OK!\n", 50)

    // -----------------------------------------------------------------
    // PATH 3: Subtractive Extrusion / Pocket Cut Extrude (Top Face Sketch Cut)
    // -----------------------------------------------------------------
    CAD_Sys.Write(1, "[PATH 3] Subtractive Extrusion / Pocket Cut Engine...\n", 54)
    h_sketch_top = CAD_Sketch.CreateSketch(2) // Workplane 2 = Top Face Plane (Z=25)
    CAD_Sketch.AddCircle(h_sketch_top, 0x4049000000000000, 0x4039000000000000, 0x4024000000000000) // Circle at (50,25), R=10

    h_solid_path3 = CAD_Feat.CreatePocket(h_sketch_top, 0x4039000000000000) // Cut depth = 25mm
    CAD_Script.ExportAll(h_solid_path3, "path3_subtractive_pocket.stp", "path3_subtractive_pocket.stl")
    CAD_Sys.Write(1, "[PATH 3] Saved path3_subtractive_pocket.stp & .stl OK!\n", 54)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   THREE-PATH HOLE GENERATION COMPLETED CLEANLY!    \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)
}
