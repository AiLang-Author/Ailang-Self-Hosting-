// CAD Kernel — Dual-Path Hole Generation Engine Demo in AILang (§8, §11 Phase 6)
// Path 1: 2D Sketch Profile Extrusion (Extrude with inner hole loop)
// Path 2: Solid Feature Hole Modification (CSG Boolean Subtraction)

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Script

SubRoutine.Main {
    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   AILang CAD Kernel — Dual-Path Hole Engine v1.0   \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)

    CAD_Num.InitTolerance(0, 0)

    // -----------------------------------------------------------------
    // PATH 1: 2D Sketch Profile Extrusion (Outer Rectangle + Inner Hole)
    // -----------------------------------------------------------------
    CAD_Sys.Write(1, "[PATH 1] 2D Sketch Profile Extrusion Engine...\n", 47)
    h_sketch = CAD_Sketch.CreateSketch(1) // Workplane 1 = XY Plane
    CAD_Sketch.AddLine(h_sketch, 0, 0, 0x4059000000000000, 0) // 0 to 100
    CAD_Sketch.AddCircle(h_sketch, 0x4049000000000000, 0x4039000000000000, 0x4024000000000000) // Center (50,25), R=10

    h_solid_path1 = CAD_Feat.ExtrudeProfile(h_sketch, 0x4039000000000000) // Depth = 25mm
    CAD_Script.ExportAll(h_solid_path1, "extrude_sketch.stp", "extrude_sketch.stl")
    CAD_Sys.Write(1, "[PATH 1] Saved extrude_sketch.stp & extrude_sketch.stl OK!\n", 58)

    // -----------------------------------------------------------------
    // PATH 2: Solid Feature Hole Modification (CSG Boolean Subtraction)
    // -----------------------------------------------------------------
    CAD_Sys.Write(1, "[PATH 2] CSG Feature Hole Modification Engine...\n", 49)
    h_base_box = CAD_Store.Alloc(7, 4) // Tag 7=Solid Box (100x50x25mm)
    h_solid_path2 = CAD_Feat.DrillHole(h_base_box, 0x4049000000000000, 0x4039000000000000, 0x4034000000000000, 0x4039000000000000) // Dia=20, Depth=25
    CAD_Script.ExportAll(h_solid_path2, "csg_drill_hole.stp", "csg_drill_hole.stl")
    CAD_Sys.Write(1, "[PATH 2] Saved csg_drill_hole.stp & csg_drill_hole.stl OK!\n", 58)

    CAD_Sys.Write(1, "=====================================================\n", 54)
    CAD_Sys.Write(1, "   DUAL-PATH HOLE GENERATION COMPLETED CLEANLY!      \n", 54)
    CAD_Sys.Write(1, "=====================================================\n", 54)
}
