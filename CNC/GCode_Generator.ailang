// GCode_Generator.ailang
// Procedural Generation of Stress Test Data for G-Code Parser

PrintMessage("==============================================\n")
PrintMessage("G-CODE STRESS DATA GENERATOR\n")
PrintMessage("==============================================\n\n")

FixedPool.GenConfig {
    "LINE_COUNT": Initialize=10000
    "FILENAME": Initialize=0 
}

// Helper to write string to file
Function.File.WriteString {
    Input: fd: Integer
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, fd, str, len)
    }
}

// Helper to write integer as string to file
Function.File.WriteInt {
    Input: fd: Integer
    Input: val: Integer
    Body: {
        // Convert number to string using the standard library function
        num_str = NumberToString(val)
        File.WriteString(fd, num_str)
    }
}

SubRoutine.GenerateSpiral {
    filename = "/tmp/stress_test.ngc"
    
    PrintMessage("Generating ")
    PrintNumber(GenConfig.LINE_COUNT)
    PrintMessage(" lines to ")
    PrintMessage(filename)
    PrintMessage("...\n")
    
    // Open File (Create/Truncate/Write)
    // Flags: O_CREAT|O_TRUNC|O_WRONLY = 577 (approx, depends on arch, using 577 from your prev examples)
    // Mode: 0644 = 420
    fd = SystemCall(2, filename, 577, 420)
    
    IfCondition LessThan(fd, 0) ThenBlock: {
        PrintMessage("ERROR: Cannot create file.\n")
        ReturnValue(0)
    }
    
    // Write Header
    File.WriteString(fd, "%\n")
    File.WriteString(fd, "G21 G90 (Metric, Absolute)\n")
    File.WriteString(fd, "G64 P0.01 (Blending)\n")
    File.WriteString(fd, "F500 (Feedrate)\n")
    File.WriteString(fd, "S1000 M3 (Spindle CW)\n")
    
    // Generate Square Spiral Toolpath
    x = 0
    y = 0
    z = 10
    step = 1
    limit = 100
    dir = 0 // 0=Right, 1=Up, 2=Left, 3=Down
    run_length = 1
    segment_count = 0
    lines_written = 0
    
    // Move to Start
    File.WriteString(fd, "G0 Z10\n")
    File.WriteString(fd, "G0 X0 Y0\n")
    File.WriteString(fd, "G1 Z0\n")
    
    WhileLoop LessThan(lines_written, GenConfig.LINE_COUNT) {
        
        i = 0
        WhileLoop LessThan(i, 2) { // Run length repeats twice (Right 1, Up 1, Left 2, Down 2...)
            j = 0
            WhileLoop LessThan(j, run_length) {
                
                // Update Coords based on Direction
                Branch dir {
                    Case 0: { x = Add(x, step) } 
                    Case 1: { y = Add(y, step) } 
                    Case 2: { x = Subtract(x, step) } 
                    Case 3: { y = Subtract(y, step) } 
                }
                
                // Write Line: "G1 X[x] Y[y]"
                File.WriteString(fd, "G1 X")
                File.WriteInt(fd, x)
                File.WriteString(fd, " Y")
                File.WriteInt(fd, y)
                File.WriteString(fd, "\n")
                
                lines_written = Add(lines_written, 1)
                
                // Safety break if we hit limit inside inner loop
                IfCondition GreaterEqual(lines_written, GenConfig.LINE_COUNT) ThenBlock: {
                    j = run_length // Break inner
                    i = 2          // Break middle
                }
                
                j = Add(j, 1)
            }
            
            dir = Modulo(Add(dir, 1), 4) // Rotate 90 degrees
            i = Add(i, 1)
        }
        
        run_length = Add(run_length, 1)
    }
    
    // Write Footer
    File.WriteString(fd, "G0 Z10\n")
    File.WriteString(fd, "M5\n")
    File.WriteString(fd, "M2\n")
    File.WriteString(fd, "%\n")
    
    SystemCall(3, fd) // Close
    
    PrintMessage("Generation Complete.\n")
}

RunTask(GenerateSpiral)