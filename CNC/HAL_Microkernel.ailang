// HAL_Microkernel.ailang
// Config-driven microkernel - reads pins and programs from config file
// Isolates userspace programs from realtime HAL

PrintMessage("HAL Microkernel v4.0 - Config Based\n")

FixedPool.Config {
    "MAX_PINS": Initialize=256
    "MAX_PROGRAMS": Initialize=32
    "SHM_SIZE": Initialize=8192
    "POLL_INTERVAL_US": Initialize=10000
    "CONFIG_PATH_LEN": Initialize=256
}

FixedPool.ShmLayout {
    "PIN_COUNT": Initialize=0
    "LOOKUP_REQUEST": Initialize=8
    "LOOKUP_RESPONSE": Initialize=16
    "LOOKUP_NAME": Initialize=24
    "PIN_DATA_START": Initialize=512
}

FixedPool.State {
    "shm_addr": Initialize=0
    "pin_count": Initialize=0
    "program_count": Initialize=0
    "running": Initialize=1
}

FixedPool.PinRegistry {
    "names": Initialize=0
}

FixedPool.ProgramRegistry {
    "paths": Initialize=0
    "pids": Initialize=0
}

// ============================================================================
// CONFIG FILE PARSER
// ============================================================================

Function.Config.ReadFile {
    Input: path: Address
    Output: Address
    Body: {
        fd = SystemCall(2, path, 0, 0)
        Fork LessThan(fd, 0) TrueBlock: {
            PrintMessage("[CONFIG] Cannot open: ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        buffer = Allocate(4096)
        bytes = SystemCall(0, fd, buffer, 4095)
        SystemCall(3, fd)
        Fork LessEqual(bytes, 0) TrueBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        } FalseBlock: {
        }
        SetByte(buffer, bytes, 0)
        PrintMessage("[CONFIG] Read ")
        PrintNumber(bytes)
        PrintMessage(" bytes from ")
        PrintMessage(path)
        PrintMessage("\n")
        ReturnValue(buffer)
    }
}

Function.Config.ParseLine {
    Input: line: Address
    Input: section: Integer
    Body: {
        // Skip empty lines and comments
        first_char = GetByte(line, 0)
        Fork Or(EqualTo(first_char, 0), EqualTo(first_char, 35)) TrueBlock: {
            ReturnValue(0)
        } FalseBlock: {
        }
        Fork Or(EqualTo(first_char, 10), EqualTo(first_char, 13)) TrueBlock: {
            ReturnValue(0)
        } FalseBlock: {
        }
        
        // Check for section header [pins] or [programs]
        Fork EqualTo(first_char, 91) TrueBlock: {
            // [ character - section header
            Fork EqualTo(GetByte(line, 1), 112) TrueBlock: {
                // 'p'
                Fork EqualTo(GetByte(line, 2), 105) TrueBlock: {
                    // 'i' = pins
                    ReturnValue(1)
                } FalseBlock: {
                    // 'r' = programs
                    ReturnValue(2)
                }
            } FalseBlock: {
            }
            ReturnValue(0)
        } FalseBlock: {
        }
        
        // Parse based on current section
        Fork EqualTo(section, 1) TrueBlock: {
            // [pins] section - extract pin name before '='
            name_buf = Allocate(128)
            i = 0
            WhileLoop LessThan(i, 127) {
                ch = GetByte(line, i)
                Fork Or(EqualTo(ch, 32), Or(EqualTo(ch, 61), EqualTo(ch, 0))) TrueBlock: {
                    BreakLoop
                } FalseBlock: {
                }
                SetByte(name_buf, i, ch)
                i = Add(i, 1)
            }
            SetByte(name_buf, i, 0)
            Fork GreaterThan(i, 0) TrueBlock: {
                Registry.AddPin(name_buf)
            } FalseBlock: {
                Deallocate(name_buf, 128)
            }
        } FalseBlock: {
        }
        
        Fork EqualTo(section, 2) TrueBlock: {
            // [programs] section - extract path after '='
            i = 0
            WhileLoop And(LessThan(i, 256), NotEqual(GetByte(line, i), 61)) {
                i = Add(i, 1)
            }
            i = Add(i, 1)
            // Skip whitespace
            WhileLoop EqualTo(GetByte(line, i), 32) {
                i = Add(i, 1)
            }
            path_buf = Allocate(256)
            j = 0
            WhileLoop LessThan(j, 255) {
                ch = GetByte(line, i)
                Fork Or(EqualTo(ch, 0), Or(EqualTo(ch, 10), EqualTo(ch, 13))) TrueBlock: {
                    BreakLoop
                } FalseBlock: {
                }
                SetByte(path_buf, j, ch)
                i = Add(i, 1)
                j = Add(j, 1)
            }
            SetByte(path_buf, j, 0)
            Fork GreaterThan(j, 0) TrueBlock: {
                Registry.AddProgram(path_buf)
            } FalseBlock: {
                Deallocate(path_buf, 256)
            }
        } FalseBlock: {
        }
        
        ReturnValue(section)
    }
}

Function.Config.Parse {
    Input: buffer: Address
    Body: {
        PrintMessage("[CONFIG] Parsing configuration...\n")
        section = 0
        line_start = 0
        line_buf = Allocate(512)
        i = 0
        WhileLoop LessThan(i, 4096) {
            ch = GetByte(buffer, i)
            Fork Or(EqualTo(ch, 10), EqualTo(ch, 0)) TrueBlock: {
                // End of line
                line_len = Subtract(i, line_start)
                Fork GreaterThan(line_len, 0) TrueBlock: {
                    j = 0
                    WhileLoop LessThan(j, line_len) {
                        SetByte(line_buf, j, GetByte(buffer, Add(line_start, j)))
                        j = Add(j, 1)
                    }
                    SetByte(line_buf, line_len, 0)
                    result = Config.ParseLine(line_buf, section)
                    Fork GreaterThan(result, 0) TrueBlock: {
                        section = result
                    } FalseBlock: {
                    }
                } FalseBlock: {
                }
                line_start = Add(i, 1)
                Fork EqualTo(ch, 0) TrueBlock: {
                    BreakLoop
                } FalseBlock: {
                }
            } FalseBlock: {
            }
            i = Add(i, 1)
        }
        Deallocate(line_buf, 512)
        PrintMessage("[CONFIG] Parsed ")
        PrintNumber(State.pin_count)
        PrintMessage(" pins, ")
        PrintNumber(State.program_count)
        PrintMessage(" programs\n")
    }
}

// ============================================================================
// PIN REGISTRY
// ============================================================================

Function.Registry.Init {
    Body: {
        PinRegistry.names = Allocate(Multiply(Config.MAX_PINS, 8))
        ProgramRegistry.paths = Allocate(Multiply(Config.MAX_PROGRAMS, 8))
        ProgramRegistry.pids = Allocate(Multiply(Config.MAX_PROGRAMS, 8))
        i = 0
        WhileLoop LessThan(i, Config.MAX_PINS) {
            StoreValue(Add(PinRegistry.names, Multiply(i, 8)), 0)
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, Config.MAX_PROGRAMS) {
            StoreValue(Add(ProgramRegistry.paths, Multiply(i, 8)), 0)
            StoreValue(Add(ProgramRegistry.pids, Multiply(i, 8)), 0)
            i = Add(i, 1)
        }
    }
}

Function.Registry.AddPin {
    Input: name: Address
    Output: Integer
    Body: {
        pin_id = State.pin_count
        Fork GreaterEqual(pin_id, Config.MAX_PINS) TrueBlock: {
            PrintMessage("[REG] ERROR: Pin registry full\n")
            ReturnValue(-1)
        } FalseBlock: {
        }
        StoreValue(Add(PinRegistry.names, Multiply(pin_id, 8)), name)
        State.pin_count = Add(pin_id, 1)
        // Initialize pin value in shared memory
        shm_offset = Add(ShmLayout.PIN_DATA_START, Multiply(pin_id, 8))
        StoreValue(Add(State.shm_addr, shm_offset), 0)
        StoreValue(State.shm_addr, State.pin_count)
        PrintMessage("[REG] Pin ")
        PrintNumber(pin_id)
        PrintMessage(": ")
        PrintMessage(name)
        PrintMessage("\n")
        ReturnValue(pin_id)
    }
}

Function.Registry.AddProgram {
    Input: path: Address
    Output: Integer
    Body: {
        prog_id = State.program_count
        Fork GreaterEqual(prog_id, Config.MAX_PROGRAMS) TrueBlock: {
            PrintMessage("[REG] ERROR: Program registry full\n")
            ReturnValue(-1)
        } FalseBlock: {
        }
        StoreValue(Add(ProgramRegistry.paths, Multiply(prog_id, 8)), path)
        State.program_count = Add(prog_id, 1)
        PrintMessage("[REG] Program ")
        PrintNumber(prog_id)
        PrintMessage(": ")
        PrintMessage(path)
        PrintMessage("\n")
        ReturnValue(prog_id)
    }
}

Function.Registry.LookupPin {
    Input: name: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, State.pin_count) {
            stored = Dereference(Add(PinRegistry.names, Multiply(i, 8)))
            Fork NotEqual(stored, 0) TrueBlock: {
                match = StringCompare(name, stored)
                Fork EqualTo(match, 0) TrueBlock: {
                    ReturnValue(i)
                } FalseBlock: {
                }
            } FalseBlock: {
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

Function.Registry.DumpPins {
    Body: {
        PrintMessage("\n[REG] ===== PIN REGISTRY =====\n")
        i = 0
        WhileLoop LessThan(i, State.pin_count) {
            name = Dereference(Add(PinRegistry.names, Multiply(i, 8)))
            shm_offset = Add(ShmLayout.PIN_DATA_START, Multiply(i, 8))
            value = Dereference(Add(State.shm_addr, shm_offset))
            PrintMessage("  ")
            PrintNumber(i)
            PrintMessage(": ")
            PrintMessage(name)
            PrintMessage(" = ")
            PrintNumber(value)
            PrintMessage("\n")
            i = Add(i, 1)
        }
        PrintMessage("[REG] ==========================\n\n")
    }
}

// ============================================================================
// SHARED MEMORY
// ============================================================================

Function.SHM.Create {
    Output: Integer
    Body: {
        PrintMessage("[SHM] Creating /tmp/hal_pins.shm...\n")
        shm_path = StringConcat("/tmp/", "hal_pins.shm")
        shm_fd = SystemCall(2, shm_path, 578, 438)
        Fork LessThan(shm_fd, 0) TrueBlock: {
            PrintMessage("[SHM] ERROR: Failed to create\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        SystemCall(77, shm_fd, Config.SHM_SIZE)
        State.shm_addr = SystemCall(9, 0, Config.SHM_SIZE, 3, 1, shm_fd, 0)
        SystemCall(3, shm_fd)
        Fork EqualTo(State.shm_addr, 0) TrueBlock: {
            PrintMessage("[SHM] ERROR: Failed to map\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        // Zero out shared memory
        i = 0
        WhileLoop LessThan(i, Config.SHM_SIZE) {
            SetByte(State.shm_addr, i, 0)
            i = Add(i, 1)
        }
        PrintMessage("[SHM] Created, addr=")
        PrintNumber(State.shm_addr)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// ============================================================================
// LOOKUP SERVICE
// ============================================================================

Function.Lookup.Process {
    Output: Integer
    Body: {
        request = Dereference(Add(State.shm_addr, ShmLayout.LOOKUP_REQUEST))
        Fork EqualTo(request, 0) TrueBlock: {
            ReturnValue(0)
        } FalseBlock: {
        }
        // Copy name from shared memory
        name_src = Add(State.shm_addr, ShmLayout.LOOKUP_NAME)
        name_buf = Allocate(128)
        i = 0
        WhileLoop LessThan(i, 127) {
            ch = GetByte(name_src, i)
            SetByte(name_buf, i, ch)
            Fork EqualTo(ch, 0) TrueBlock: {
                BreakLoop
            } FalseBlock: {
            }
            i = Add(i, 1)
        }
        SetByte(name_buf, i, 0)
        // Lookup
        pin_id = Registry.LookupPin(name_buf)
        PrintMessage("[LOOKUP] '")
        PrintMessage(name_buf)
        PrintMessage("' -> ")
        PrintNumber(pin_id)
        PrintMessage("\n")
        // Write response and clear request
        StoreValue(Add(State.shm_addr, ShmLayout.LOOKUP_RESPONSE), pin_id)
        StoreValue(Add(State.shm_addr, ShmLayout.LOOKUP_REQUEST), 0)
        Deallocate(name_buf, 128)
        ReturnValue(1)
    }
}

// ============================================================================
// PROGRAM MANAGEMENT
// ============================================================================

Function.Programs.StartAll {
    Body: {
        PrintMessage("[PROG] Starting programs...\n")
        i = 0
        WhileLoop LessThan(i, State.program_count) {
            path = Dereference(Add(ProgramRegistry.paths, Multiply(i, 8)))
            Fork NotEqual(path, 0) TrueBlock: {
                pid = ProcessFork()
                Fork EqualTo(pid, 0) TrueBlock: {
                    // Child - exec the program
                    PrintMessage("[PROG] Launching: ")
                    PrintMessage(path)
                    PrintMessage("\n")
                    // Build argv array: [path, NULL]
                    argv = Allocate(16)
                    StoreValue(argv, path)
                    StoreValue(Add(argv, 8), 0)
                    ProcessExec(path, argv)
                    // If exec fails
                    PrintMessage("[PROG] ERROR: exec failed for ")
                    PrintMessage(path)
                    PrintMessage("\n")
                    Deallocate(argv, 16)
                    ProcessExit(1)
                } FalseBlock: {
                    // Parent - store PID
                    StoreValue(Add(ProgramRegistry.pids, Multiply(i, 8)), pid)
                    PrintMessage("[PROG] Started ")
                    PrintMessage(path)
                    PrintMessage(" (PID ")
                    PrintNumber(pid)
                    PrintMessage(")\n")
                }
            } FalseBlock: {
            }
            i = Add(i, 1)
        }
    }
}

Function.Programs.StopAll {
    Body: {
        PrintMessage("[PROG] Stopping programs...\n")
        i = 0
        WhileLoop LessThan(i, State.program_count) {
            pid = Dereference(Add(ProgramRegistry.pids, Multiply(i, 8)))
            Fork GreaterThan(pid, 0) TrueBlock: {
                PrintMessage("[PROG] Killing PID ")
                PrintNumber(pid)
                PrintMessage("\n")
                ProcessKill(pid, 15)
            } FalseBlock: {
            }
            i = Add(i, 1)
        }
        // Wait for all
        i = 0
        WhileLoop LessThan(i, State.program_count) {
            pid = Dereference(Add(ProgramRegistry.pids, Multiply(i, 8)))
            Fork GreaterThan(pid, 0) TrueBlock: {
                ProcessWait(pid, 0)
            } FalseBlock: {
            }
            i = Add(i, 1)
        }
    }
}

// ============================================================================
// MAIN LOOP
// ============================================================================

Function.Kernel.MainLoop {
    Body: {
        PrintMessage("[KERNEL] Entering main loop...\n")
        timespec = Allocate(16)
        poll_ns = Multiply(Config.POLL_INTERVAL_US, 1000)
        loop_count = 0
        WhileLoop EqualTo(State.running, 1) {
            Lookup.Process()
            loop_count = Add(loop_count, 1)
            Fork EqualTo(Modulo(loop_count, 1000), 0) TrueBlock: {
                PrintMessage("[KERNEL] Heartbeat ")
                PrintNumber(loop_count)
                PrintMessage("\n")
            } FalseBlock: {
            }
            Fork EqualTo(Modulo(loop_count, 10000), 0) TrueBlock: {
                Registry.DumpPins()
            } FalseBlock: {
            }
            StoreValue(timespec, 0)
            StoreValue(Add(timespec, 8), poll_ns)
            SystemCall(35, timespec, 0)
        }
        Deallocate(timespec, 16)
    }
}

// ============================================================================
// MAIN
// ============================================================================

SubRoutine.Main {
    PrintMessage("==========================================\n")
    PrintMessage("HAL Microkernel v4.0 - Config Based\n")
    PrintMessage("==========================================\n\n")
    
    // Create shared memory first (so registry can write to it)
    result = SHM.Create()
    Fork EqualTo(result, 0) TrueBlock: {
        PrintMessage("FATAL: Shared memory failed\n")
        ProcessExit(1)
    } FalseBlock: {
    }
    
    // Initialize registries
    Registry.Init()
    
    // Read and parse config file
    config_path = StringConcat("/etc/", "hal_microkernel.conf")
    config_data = Config.ReadFile(config_path)
    Fork EqualTo(config_data, 0) TrueBlock: {
        // Try local path
        PrintMessage("[CONFIG] Trying local path...\n")
        config_path = StringConcat("./", "hal_microkernel.conf")
        config_data = Config.ReadFile(config_path)
        Fork EqualTo(config_data, 0) TrueBlock: {
            PrintMessage("FATAL: Cannot read config file\n")
            ProcessExit(1)
        } FalseBlock: {
        }
    } FalseBlock: {
    }
    
    Config.Parse(config_data)
    Deallocate(config_data, 4096)
    
    Registry.DumpPins()
    
    // Daemonize
    daemon_pid = ProcessFork()
    Fork GreaterThan(daemon_pid, 0) TrueBlock: {
        PrintMessage("\n[MAIN] Daemon PID: ")
        PrintNumber(daemon_pid)
        PrintMessage("\n[MAIN] Config: ")
        PrintMessage(config_path)
        PrintMessage("\n[MAIN] Shared memory: /tmp/hal_pins.shm\n")
        PrintMessage("[MAIN] To stop: kill -TERM ")
        PrintNumber(daemon_pid)
        PrintMessage("\n\n")
        ProcessExit(0)
    } FalseBlock: {
    }
    
    PrintMessage("\n[DAEMON] PID: ")
    PrintNumber(ProcessGetPID())
    PrintMessage("\n")
    
    // Start all programs from config
    Programs.StartAll()
    
    // Run main loop
    Kernel.MainLoop()
    
    // Cleanup
    Programs.StopAll()
    shm_path = StringConcat("/tmp/", "hal_pins.shm")
    SystemCall(87, shm_path)
    PrintMessage("[DAEMON] Stopped\n")
    ProcessExit(0)
}

RunTask(Main)