        TUI_MoveTo(13, 4)
        TUI_Bold()
        TUI_Print("UNITS (x1000 fixed-point)")
        TUI_ResetColor()
        TUI_MoveTo(14, 4)
        TUI_Print("Mass: mg*1000  Angle: deg*1000  Radius/Z: mm*1000")

        TUI_MoveTo(16, 4)
        TUI_Bold()
        TUI_Print("SLOTS")
        TUI_ResetColor()
        TUI_MoveTo(17, 4)
        TUI_Print("0=base  1=+45deg  2=+90deg  3=+180deg from journal base angle")

        TUI_MoveTo(19, 4)
        TUI_Bold()
        TUI_Print("KEYS")
        TUI_ResetColor()
        TUI_MoveTo(20, 4)
        TUI_Print("[A]dd [D]el [W]ts [M]ain [C]static [V]dynamic [P]lanes [Q]uit")

        UI_NavBar("[Any key] Return to main")
        ReturnValue(0)
    }
}

// =============================================================================
// INPUT HANDLERS
// =============================================================================

Function.Handle_AddWeightKey {
    Input: key: Integer
    Body: {
        // Number shortcuts 1-6
        IfCondition EqualTo(key, 49) ThenBlock: { AddWt.field = 0 Input_Clear() ReturnValue(0) }
        IfCondition EqualTo(key, 50) ThenBlock: { AddWt.field = 1 Input_Clear() ReturnValue(0) }
        IfCondition EqualTo(key, 51) ThenBlock: { AddWt.field = 2 Input_Clear() ReturnValue(0) }
        IfCondition EqualTo(key, 52) ThenBlock: { AddWt.field = 3 Input_Clear() ReturnValue(0) }
        IfCondition EqualTo(key, 53) ThenBlock: { AddWt.field = 4 Input_Clear() ReturnValue(0) }
        IfCondition EqualTo(key, 54) ThenBlock: { AddWt.field = 5 Input_Clear() ReturnValue(0) }

        // Tab: commit and advance
        IfCondition EqualTo(key, 9) ThenBlock: {
            IfCondition GreaterEqual(AddWt.field, 2) ThenBlock: {
                val = Input_ParseInt()
                IfCondition EqualTo(AddWt.field, 2) ThenBlock: { IfCondition GreaterThan(val, 0) ThenBlock: { AddWt.mass_mg   = val } }
                IfCondition EqualTo(AddWt.field, 3) ThenBlock: { AddWt.angle_deg = val }
                IfCondition EqualTo(AddWt.field, 4) ThenBlock: { IfCondition GreaterThan(val, 0) ThenBlock: { AddWt.radius_mm = val } }
                IfCondition EqualTo(AddWt.field, 5) ThenBlock: { AddWt.axial_z   = val }
                Input_Clear()
            }
            AddWt.field = Modulo(Add(AddWt.field, 1), 6)
            ReturnValue(0)
        }

        // Enter: save
        IfCondition EqualTo(key, 13) ThenBlock: {
            IfCondition GreaterEqual(AddWt.field, 2) ThenBlock: {
                val = Input_ParseInt()
                IfCondition EqualTo(AddWt.field, 2) ThenBlock: { IfCondition GreaterThan(val, 0) ThenBlock: { AddWt.mass_mg   = val } }
                IfCondition EqualTo(AddWt.field, 3) ThenBlock: { AddWt.angle_deg = val }
                IfCondition EqualTo(AddWt.field, 4) ThenBlock: { IfCondition GreaterThan(val, 0) ThenBlock: { AddWt.radius_mm = val } }
                IfCondition EqualTo(AddWt.field, 5) ThenBlock: { AddWt.axial_z   = val }
            }
            Weight_Add(AddWt.journal, AddWt.slot, AddWt.mass_mg, AddWt.angle_deg, AddWt.radius_mm, AddWt.axial_z)
            App.screen = 0
            Input_Clear()
            ReturnValue(0)
        }

        IfCondition EqualTo(key, TUI_Keys.KEY_ESC) ThenBlock: {
            App.screen = 0
            Input_Clear()
            ReturnValue(0)
        }

        // Journal / slot nav
        IfCondition EqualTo(AddWt.field, 0) ThenBlock: {
            IfCondition EqualTo(key, TUI_Keys.KEY_RIGHT) ThenBlock: { AddWt.journal = Modulo(Add(AddWt.journal, 1), 8) }
            IfCondition EqualTo(key, TUI_Keys.KEY_LEFT)  ThenBlock: { AddWt.journal = Modulo(Add(AddWt.journal, 7), 8) }
            ReturnValue(0)
        }
        IfCondition EqualTo(AddWt.field, 1) ThenBlock: {
            IfCondition EqualTo(key, TUI_Keys.KEY_RIGHT) ThenBlock: { AddWt.slot = Modulo(Add(AddWt.slot, 1), 4) }
            IfCondition EqualTo(key, TUI_Keys.KEY_LEFT)  ThenBlock: { AddWt.slot = Modulo(Add(AddWt.slot, 3), 4) }
            ReturnValue(0)
        }

        // Text input
        IfCondition And(GreaterEqual(key, 48), LessEqual(key, 57)) ThenBlock: { Input_AddChar(key) ReturnValue(0) }
        IfCondition EqualTo(key, TUI_Keys.KEY_BACKSPACE) ThenBlock: { Input_Backspace() ReturnValue(0) }
        IfCondition And(EqualTo(key, 45), EqualTo(AddWt.field, 3)) ThenBlock: {
            IfCondition EqualTo(InputState.len, 0) ThenBlock: { Input_AddChar(key) }
        }
        ReturnValue(0)
    }
}

Function.Handle_PlaneKey {
    Input: key: Integer
    Body: {
        IfCondition EqualTo(key, 49) ThenBlock: { PlaneEdit.field = 0 Input_Clear() ReturnValue(0) }
        IfCondition EqualTo(key, 50) ThenBlock: { PlaneEdit.field = 1 Input_Clear() ReturnValue(0) }

        IfCondition EqualTo(key, 9) ThenBlock: {
            val = Input_ParseInt()
            IfCondition And(GreaterThan(val, 0), EqualTo(PlaneEdit.field, 0)) ThenBlock: { CorrPlane.front_z = val }
            IfCondition And(GreaterThan(val, 0), EqualTo(PlaneEdit.field, 1)) ThenBlock: { CorrPlane.rear_z  = val }
            Input_Clear()
            PlaneEdit.field = Modulo(Add(PlaneEdit.field, 1), 2)
            ReturnValue(0)
        }

        IfCondition EqualTo(key, 13) ThenBlock: {
            val = Input_ParseInt()
            IfCondition And(GreaterThan(val, 0), EqualTo(PlaneEdit.field, 0)) ThenBlock: { CorrPlane.front_z = val }
            IfCondition And(GreaterThan(val, 0), EqualTo(PlaneEdit.field, 1)) ThenBlock: { CorrPlane.rear_z  = val }
            Input_Clear()
            ReturnValue(0)
        }

        IfCondition Or(EqualTo(key, TUI_Keys.KEY_ESC), Or(EqualTo(key, 109), EqualTo(key, 77))) ThenBlock: {
            App.screen = 0
            Input_Clear()
            ReturnValue(0)
        }

        IfCondition And(GreaterEqual(key, 48), LessEqual(key, 57)) ThenBlock: { Input_AddChar(key) ReturnValue(0) }
        IfCondition EqualTo(key, TUI_Keys.KEY_BACKSPACE) ThenBlock: { Input_Backspace() ReturnValue(0) }
        ReturnValue(0)
    }
}

Function.Handle_GlobalKey {
    Input: key: Integer
    Body: {
        IfCondition Or(EqualTo(key, 113), EqualTo(key, 81)) ThenBlock: { App.running = 0 ReturnValue(0) }

        IfCondition Or(EqualTo(key, 97), EqualTo(key, 65)) ThenBlock: {
            AddWt.field = 0 AddWt.journal = App.selected_journal
            AddWt.slot = 0 AddWt.mass_mg = 1000 AddWt.angle_deg = 0
            AddWt.radius_mm = 50000 AddWt.axial_z = 0
            Input_Clear()
            App.screen = 2
            ReturnValue(0)
        }
        IfCondition Or(EqualTo(key, 109), EqualTo(key, 77)) ThenBlock: { App.screen = 0 ReturnValue(0) }
        IfCondition Or(EqualTo(key, 119), EqualTo(key, 87)) ThenBlock: { App.screen = 1 ReturnValue(0) }
        IfCondition Or(EqualTo(key, 99),  EqualTo(key, 67)) ThenBlock: { App.screen = 3 ReturnValue(0) }
        IfCondition Or(EqualTo(key, 118), EqualTo(key, 86)) ThenBlock: { App.screen = 4 ReturnValue(0) }
        IfCondition Or(EqualTo(key, 112), EqualTo(key, 80)) ThenBlock: {
            PlaneEdit.field = 0
            Input_Clear()
            App.screen = 5
            ReturnValue(0)
        }
        IfCondition EqualTo(key, 63) ThenBlock: { App.screen = 6 ReturnValue(0) }
        IfCondition Or(EqualTo(key, 100), EqualTo(key, 68)) ThenBlock: {
            IfCondition GreaterThan(WeightStore.count, 0) ThenBlock: {
                Weight_Delete(Subtract(WeightStore.count, 1))
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(App.screen, 0) ThenBlock: {
            IfCondition EqualTo(key, TUI_Keys.KEY_UP)   ThenBlock: { App.selected_journal = Modulo(Add(App.selected_journal, 7), 8) }
            IfCondition EqualTo(key, TUI_Keys.KEY_DOWN) ThenBlock: { App.selected_journal = Modulo(Add(App.selected_journal, 1), 8) }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// ENTRY POINT
// =============================================================================

SubRoutine.App_Run {
    TUI_Init()
    App_Init()

    WhileLoop EqualTo(App.running, 1) {
        IfCondition EqualTo(App.screen, 0) ThenBlock: { Draw_Main() }
        IfCondition EqualTo(App.screen, 1) ThenBlock: { Draw_WeightList() }
        IfCondition EqualTo(App.screen, 2) ThenBlock: { Draw_AddWeight() }
        IfCondition EqualTo(App.screen, 3) ThenBlock: { Draw_StaticResults() }
        IfCondition EqualTo(App.screen, 4) ThenBlock: { Draw_DynamicResults() }
        IfCondition EqualTo(App.screen, 5) ThenBlock: { Draw_Planes() }
        IfCondition EqualTo(App.screen, 6) ThenBlock: { Draw_Help() }

        TUI_Refresh()
        key = TUI_GetKey()

        IfCondition EqualTo(App.screen, 2) ThenBlock: {
            Handle_AddWeightKey(key)
        } ElseBlock: {
            IfCondition EqualTo(App.screen, 5) ThenBlock: {
                Handle_PlaneKey(key)
            } ElseBlock: {
                IfCondition EqualTo(App.screen, 6) ThenBlock: {
                    App.screen = 0
                } ElseBlock: {
                    Handle_GlobalKey(key)
                }
            }
        }
    }

    TUI_Shutdown()
}

RunTask(App_Run)