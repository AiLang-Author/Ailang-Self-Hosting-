        TUI_MoveTo(8, 4)
        TUI_Bold()
        TUI_Print("DYNAMIC BALANCE [V]")
        TUI_ResetColor()
        TUI_MoveTo(9, 4)
        TUI_Print("Couple imbalance: sum of mass*radius*(z-z_ref) vectors = 0.")
        TUI_MoveTo(10, 4)
        TUI_Print("Resolved into TWO correction planes (front + rear).")
