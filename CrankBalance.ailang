// V8CrankBalancer.ailang
// TUI Application for V8 Crankshaft Counterweight Balancing
// Static AND Dynamic (couple) balance with two correction planes
//
// STATIC BALANCE:
//   Sum of all mass*radius vectors = 0
//   Corrected with a single weight at the right angle
//
// DYNAMIC BALANCE:
//   Sum of all mass*radius*axial_position (couple) vectors = 0
//   Requires two correction planes (front/rear)
//   Each plane gets its own correction weight + angle
//   This is what the spin balance machine measures
//
// All arithmetic: fixed-point x1000 (no floats)

LibraryImport.TUI
LibraryImport.FixedPointTrig
LibraryImport.XArrays
LibraryImport.Arena

// =============================================================================
// CONSTANTS
// =============================================================================

FixedPool.V8Config {
    "NUM_JOURNALS":      Initialize=8
    "NUM_WEIGHT_SLOTS":  Initialize=4
    "MAX_WEIGHTS":       Initialize=64    // more room for dynamic correction weights
    "SCALE":             Initialize=1000
    "BALANCE_THRESHOLD": Initialize=500   // mg-mm static tolerance
    "COUPLE_THRESHOLD":  Initialize=5000  // mg-mm^2 dynamic tolerance
}

// 90-deg V8 pin angles (degrees * 1000)
FixedPool.CrankAngles {
    "PIN1": Initialize=0
    "PIN2": Initialize=90000
    "PIN3": Initialize=270000
    "PIN4": Initialize=180000
    "PIN5": Initialize=180000
    "PIN6": Initialize=270000
    "PIN7": Initialize=90000
    "PIN8": Initialize=0
}

// Default axial positions for each journal (mm * 1000 from front datum)
// Typical small-block V8 spacing — user can override per weight
FixedPool.JournalZ {
    "J1": Initialize=0
    "J2": Initialize=57000
    "J3": Initialize=114000
    "J4": Initialize=171000
    "J5": Initialize=228000
    "J6": Initialize=285000
    "J7": Initialize=342000
    "J8": Initialize=399000
}

// Two correction planes defined by the user (axial positions)
FixedPool.CorrPlane {
    "front_z":   Initialize=20000    // default: 20mm from front datum
    "rear_z":    Initialize=380000   // default: 380mm from front datum
}

// Weight entry: 56 bytes
// [0]  journal    (8)
// [8]  slot       (8)
// [16] mass_mg    (8) - mg * 1000
// [24] angle      (8) - deg * 1000 (0 = auto)
// [32] radius     (8) - mm * 1000
// [40] axial_z    (8) - mm * 1000 from front datum (0 = use journal default)
// [48] is_correction (8) - 1 if this is a computed correction weight
FixedPool.WeightField {
    "JOURNAL":        Initialize=0
    "SLOT":           Initialize=8
    "MASS":           Initialize=16
    "ANGLE":          Initialize=24
    "RADIUS":         Initialize=32
    "AXIAL_Z":        Initialize=40
    "IS_CORRECTION":  Initialize=48
    "SIZE":           Initialize=56
}

// =============================================================================
// APPLICATION STATE
// =============================================================================

FixedPool.App {
    "running":          Initialize=1
    "screen":           Initialize=0   // 0=main 1=weightlist 2=add 3=results 4=dynresults 5=planes 6=help
    "selected_journal": Initialize=0
    "status_msg":       Initialize=0
    // Static balance
    "bal_x":            Initialize=0
    "bal_y":            Initialize=0
    "total_mass":       Initialize=0
    // Dynamic (couple) balance
    "couple_x":         Initialize=0   // sum of mass*radius*z*cos
    "couple_y":         Initialize=0   // sum of mass*radius*z*sin
    // Correction plane results
    "front_mass":       Initialize=0
    "front_angle":      Initialize=0
    "rear_mass":        Initialize=0
    "rear_angle":       Initialize=0
}

FixedPool.WeightStore {
    "data_ptr": Initialize=0
    "count":    Initialize=0
}

FixedPool.InputState {
    "buf":   Initialize=0
    "len":   Initialize=0
    "value": Initialize=0
}

// Add weight form state
FixedPool.AddWt {
    "field":      Initialize=0   // 0=journal 1=slot 2=mass 3=angle 4=radius 5=axial_z
    "journal":    Initialize=0
    "slot":       Initialize=0
    "mass_mg":    Initialize=1000
    "angle_deg":  Initialize=0
    "radius_mm":  Initialize=50000
    "axial_z":    Initialize=0   // 0 = use journal default
}

// =============================================================================
// INIT
// =============================================================================

Function.App_Init {
    Body: {
        Arena_Init()
        WeightStore.data_ptr = Allocate(Multiply(V8Config.MAX_WEIGHTS, WeightField.SIZE))
        WeightStore.count    = 0
        InputState.buf       = Allocate(32)
        InputState.len       = 0
        App.status_msg       = "Ready"
        ReturnValue(0)
    }
}

// =============================================================================
// WEIGHT MANAGEMENT
// =============================================================================

Function.Weight_GetPtr {
    Input: idx: Integer
    Output: Address
    Body: {
        ReturnValue(Add(WeightStore.data_ptr, Multiply(idx, WeightField.SIZE)))
    }
}

Function.Weight_Add {
    Input: journal:   Integer
    Input: slot:      Integer
    Input: mass_mg:   Integer
    Input: angle_deg: Integer
    Input: radius_mm: Integer
    Input: axial_z:   Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(WeightStore.count, V8Config.MAX_WEIGHTS) ThenBlock: {
            ReturnValue(-1)
        }
        ptr = Weight_GetPtr(WeightStore.count)
        StoreValue(Add(ptr, WeightField.JOURNAL),       journal)
        StoreValue(Add(ptr, WeightField.SLOT),          slot)
        StoreValue(Add(ptr, WeightField.MASS),          mass_mg)
        StoreValue(Add(ptr, WeightField.ANGLE),         angle_deg)
        StoreValue(Add(ptr, WeightField.RADIUS),        radius_mm)
        StoreValue(Add(ptr, WeightField.AXIAL_Z),       axial_z)
        StoreValue(Add(ptr, WeightField.IS_CORRECTION), 0)
        WeightStore.count = Add(WeightStore.count, 1)
        ReturnValue(WeightStore.count)
    }
}

Function.Weight_Delete {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, WeightStore.count)) ThenBlock: {
            ReturnValue(-1)
        }
        i = idx
        WhileLoop LessThan(i, Subtract(WeightStore.count, 1)) {
            src = Weight_GetPtr(Add(i, 1))
            dst = Weight_GetPtr(i)
            MemoryCopy(dst, src, WeightField.SIZE)
            i = Add(i, 1)
        }
        WeightStore.count = Subtract(WeightStore.count, 1)
        ReturnValue(0)
    }
}

Function.Journal_BaseAngle {
    Input: journal: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(journal, 0) ThenBlock: { ReturnValue(CrankAngles.PIN1) }
        IfCondition EqualTo(journal, 1) ThenBlock: { ReturnValue(CrankAngles.PIN2) }
        IfCondition EqualTo(journal, 2) ThenBlock: { ReturnValue(CrankAngles.PIN3) }
        IfCondition EqualTo(journal, 3) ThenBlock: { ReturnValue(CrankAngles.PIN4) }
        IfCondition EqualTo(journal, 4) ThenBlock: { ReturnValue(CrankAngles.PIN5) }
        IfCondition EqualTo(journal, 5) ThenBlock: { ReturnValue(CrankAngles.PIN6) }
        IfCondition EqualTo(journal, 6) ThenBlock: { ReturnValue(CrankAngles.PIN7) }
        IfCondition EqualTo(journal, 7) ThenBlock: { ReturnValue(CrankAngles.PIN8) }
        ReturnValue(0)
    }
}

Function.Journal_DefaultZ {
    Input: journal: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(journal, 0) ThenBlock: { ReturnValue(JournalZ.J1) }
        IfCondition EqualTo(journal, 1) ThenBlock: { ReturnValue(JournalZ.J2) }
        IfCondition EqualTo(journal, 2) ThenBlock: { ReturnValue(JournalZ.J3) }
        IfCondition EqualTo(journal, 3) ThenBlock: { ReturnValue(JournalZ.J4) }
        IfCondition EqualTo(journal, 4) ThenBlock: { ReturnValue(JournalZ.J5) }
        IfCondition EqualTo(journal, 5) ThenBlock: { ReturnValue(JournalZ.J6) }
        IfCondition EqualTo(journal, 6) ThenBlock: { ReturnValue(JournalZ.J7) }
        IfCondition EqualTo(journal, 7) ThenBlock: { ReturnValue(JournalZ.J8) }
        ReturnValue(0)
    }
}

// Effective angle for a weight
Function.Weight_EffAngle {
    Input: ptr: Address
    Output: Integer
    Body: {
        angle_ov = Dereference(Add(ptr, WeightField.ANGLE))
        journal  = Dereference(Add(ptr, WeightField.JOURNAL))
        slot     = Dereference(Add(ptr, WeightField.SLOT))
        IfCondition NotEqual(angle_ov, 0) ThenBlock: {
            ReturnValue(angle_ov)
        }
        base = Journal_BaseAngle(journal)
        ReturnValue(Modulo(Add(base, Multiply(slot, 45000)), 360000))
    }
}

// Effective axial Z for a weight
Function.Weight_EffZ {
    Input: ptr: Address
    Output: Integer
    Body: {
        z       = Dereference(Add(ptr, WeightField.AXIAL_Z))
        journal = Dereference(Add(ptr, WeightField.JOURNAL))
        IfCondition NotEqual(z, 0) ThenBlock: {
            ReturnValue(z)
        }
        ReturnValue(Journal_DefaultZ(journal))
    }
}

// =============================================================================
// STATIC BALANCE CALCULATION
// =============================================================================

Function.Calc_Static {
    Body: {
        sum_x = 0
        sum_y = 0
        total = 0
        i = 0
        WhileLoop LessThan(i, WeightStore.count) {
            ptr    = Weight_GetPtr(i)
            mass   = Dereference(Add(ptr, WeightField.MASS))
            radius = Dereference(Add(ptr, WeightField.RADIUS))

            eff_angle     = Weight_EffAngle(ptr)
            angle_deg_int = Divide(eff_angle, 1000)
            cos_val       = Trig.Cos(Multiply(angle_deg_int, V8Config.SCALE))
            sin_val       = Trig.Sin(Multiply(angle_deg_int, V8Config.SCALE))
            mr            = Divide(Multiply(mass, radius), V8Config.SCALE)

            sum_x = Add(sum_x, Divide(Multiply(mr, cos_val), 10000))
            sum_y = Add(sum_y, Divide(Multiply(mr, sin_val), 10000))
            total = Add(total, mass)
            i     = Add(i, 1)
        }
        App.bal_x      = sum_x
        App.bal_y      = sum_y
        App.total_mass = total
        ReturnValue(0)
    }
}

Function.Calc_StaticImbalance {
    Output: Integer
    Body: {
        bx  = App.bal_x
        by  = App.bal_y
        bx2 = Divide(Multiply(bx, bx), V8Config.SCALE)
        by2 = Divide(Multiply(by, by), V8Config.SCALE)
        ReturnValue(Math.ISqrt(Add(bx2, by2)))
    }
}

// =============================================================================
// DYNAMIC (COUPLE) BALANCE CALCULATION
//
// Each weight creates a couple moment about the reference plane:
//   couple = mass * radius * (z - z_ref)
//   direction = same as the radial vector (crank angle)
//
// We use the midpoint between the two correction planes as z_ref
// to distribute the correction evenly.
//
// To resolve into two correction planes (front at z_f, rear at z_r):
//   The total couple vector C must equal:
//     m_f * r_f * (z_ref - z_f)  +  m_r * r_r * (z_ref - z_r) = 0
//
// With a fixed correction radius R on both planes:
//   Front correction:  m_f = -C_rear_lever / (R * plane_span)
//   Rear  correction:  m_r = -C_front_lever / (R * plane_span)
//
// Full 2D vector form — X and Y independently give angle and magnitude.
// =============================================================================

Function.Calc_Dynamic {
    Body: {
        front_z    = CorrPlane.front_z
        rear_z     = CorrPlane.rear_z
        span       = Subtract(rear_z, front_z)   // mm * 1000

        // Accumulate couple vectors relative to front plane
        couple_x = 0
        couple_y = 0

        i = 0
        WhileLoop LessThan(i, WeightStore.count) {
            ptr    = Weight_GetPtr(i)
            mass   = Dereference(Add(ptr, WeightField.MASS))
            radius = Dereference(Add(ptr, WeightField.RADIUS))
            z      = Weight_EffZ(ptr)

            eff_angle     = Weight_EffAngle(ptr)
            angle_deg_int = Divide(eff_angle, 1000)
            cos_val       = Trig.Cos(Multiply(angle_deg_int, V8Config.SCALE))
            sin_val       = Trig.Sin(Multiply(angle_deg_int, V8Config.SCALE))

            // lever arm from front plane (mm*1000)
            lever = Subtract(z, front_z)

            // mr = mass * radius / SCALE
            mr = Divide(Multiply(mass, radius), V8Config.SCALE)

            // couple contribution: mr * lever / SCALE (to keep numbers sane)
            mrl_x = Divide(Multiply(Divide(Multiply(mr, cos_val), 10000), lever), V8Config.SCALE)
            mrl_y = Divide(Multiply(Divide(Multiply(mr, sin_val), 10000), lever), V8Config.SCALE)

            couple_x = Add(couple_x, mrl_x)
            couple_y = Add(couple_y, mrl_y)

            i = Add(i, 1)
        }

        App.couple_x = couple_x
        App.couple_y = couple_y

                    // Resolve into front and rear correction planes
        // Correction radius = 50mm = 50000
        corr_radius = 50000

        // span in mm (integer) for division
        span_mm = Divide(span, 1000)

        IfCondition NotEqual(span_mm, 0) ThenBlock: {
            // Magnitudes
            front_cx2 = Divide(Multiply(couple_x, couple_x), V8Config.SCALE)
            front_cy2 = Divide(Multiply(couple_y, couple_y), V8Config.SCALE)
            couple_mag = Math.ISqrt(Add(front_cx2, front_cy2))

            corr_r_mm = Divide(corr_radius, 1000)   // 50
            denom     = Multiply(corr_r_mm, span_mm)

            IfCondition NotEqual(denom, 0) ThenBlock: {
                App.front_mass = Divide(Multiply(couple_mag, V8Config.SCALE), denom)
                App.rear_mass  = App.front_mass
            }

            // Exact couple direction via Trig.Atan2 (returns integer degrees)
            // couple_x and couple_y are already scaled — pass directly
            // Atan2 returns 0-359 degrees as integer
            couple_angle_deg = Trig.Atan2(couple_y, couple_x)

            // Convert to our x1000 format
            couple_angle = Multiply(couple_angle_deg, 1000)

            // Correction angles: front opposes couple, rear is with couple
            App.front_angle = Modulo(Add(couple_angle, 180000), 360000)
            App.rear_angle  = couple_angle
        }

        ReturnValue(0)
    }
}

Function.Calc_CoupleImbalance {
    Output: Integer
    Body: {
        cx  = App.couple_x
        cy  = App.couple_y
        cx2 = Divide(Multiply(cx, cx), V8Config.SCALE)
        cy2 = Divide(Multiply(cy, cy), V8Config.SCALE)
        ReturnValue(Math.ISqrt(Add(cx2, cy2)))
    }
}

// =============================================================================
// INPUT HELPERS
// =============================================================================

Function.Input_Clear {
    Body: {
        InputState.len = 0
        SetByte(InputState.buf, 0, 0)
        InputState.value = 0
        ReturnValue(0)
    }
}

Function.Input_AddChar {
    Input: ch: Integer
    Body: {
        IfCondition LessThan(InputState.len, 15) ThenBlock: {
            SetByte(InputState.buf, InputState.len, ch)
            InputState.len = Add(InputState.len, 1)
            SetByte(InputState.buf, InputState.len, 0)
        }
        ReturnValue(0)
    }
}

Function.Input_Backspace {
    Body: {
        IfCondition GreaterThan(InputState.len, 0) ThenBlock: {
            InputState.len = Subtract(InputState.len, 1)
            SetByte(InputState.buf, InputState.len, 0)
        }
        ReturnValue(0)
    }
}

Function.Input_ParseInt {
    Output: Integer
    Body: {
        result   = 0
        i        = 0
        negative = 0
        IfCondition And(GreaterThan(InputState.len, 0), EqualTo(GetByte(InputState.buf, 0), 45)) ThenBlock: {
            negative = 1
            i = 1
        }
        WhileLoop LessThan(i, InputState.len) {
            ch = GetByte(InputState.buf, i)
            IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                result = Add(Multiply(result, 10), Subtract(ch, 48))
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(negative, 1) ThenBlock: { result = Subtract(0, result) }
        InputState.value = result
        ReturnValue(result)
    }
}

// =============================================================================
// DISPLAY HELPERS
// =============================================================================

Function.UI_TitleBar {
    Input: subtitle: Address
    Body: {
        TUI_SetColor(0, 6)
        TUI_MoveTo(1, 1)
        TUI_Print("  V8 CRANK BALANCE v1.0  ")
        TUI_ResetColor()
        TUI_SetColor(0, 4)
        TUI_MoveTo(1, 27)
        TUI_Print(" ")
        TUI_Print(subtitle)
        TUI_Print(" ")
        TUI_ResetColor()
        ReturnValue(0)
    }
}

Function.UI_NavBar {
    Input: keys: Address
    Body: {
        TUI_SetColor(0, 7)
        TUI_MoveTo(TUI_State.screen_height, 1)
        TUI_Print(keys)
        i = 0
        WhileLoop LessThan(i, 30) {
            TUI_BufferChar(32)
            i = Add(i, 1)
        }
        TUI_ResetColor()
        ReturnValue(0)
    }
}

Function.UI_PrintFixed {
    Input: row: Integer
    Input: col: Integer
    Input: val: Integer    // value * 1000
    Input: unit: Address
    Body: {
        whole = Divide(val, 1000)
        frac  = Modulo(val, 1000)
        TUI_MoveTo(row, col)
        TUI_WriteNum(whole)
        TUI_BufferChar(46)
        IfCondition LessThan(frac, 100) ThenBlock: { TUI_BufferChar(48) }
        IfCondition LessThan(frac, 10)  ThenBlock: { TUI_BufferChar(48) }
        TUI_WriteNum(frac)
        TUI_Print(unit)
        ReturnValue(0)
    }
}

Function.UI_BalanceBar {
    Input: row: Integer
    Input: col_center: Integer
    Input: half: Integer
    Input: value: Integer
    Body: {
        bar_start = Subtract(col_center, half)
        i = 0
        WhileLoop LessThan(i, Multiply(half, 2)) {
            TUI_MoveTo(row, Add(bar_start, i))
            IfCondition EqualTo(i, half) ThenBlock: {
                TUI_SetFG(7)
                TUI_BufferChar(124)
            } ElseBlock: {
                TUI_SetFG(8)
                TUI_BufferChar(45)
            }
            i = Add(i, 1)
        }
        clamped = value
        IfCondition GreaterThan(value, half)            ThenBlock: { clamped = half }
        IfCondition LessThan(value, Subtract(0, half))  ThenBlock: { clamped = Subtract(0, half) }
        TUI_MoveTo(row, Add(col_center, clamped))
        IfCondition EqualTo(value, 0) ThenBlock: { TUI_SetFG(2) TUI_BufferChar(79) }
                                      ElseBlock: { TUI_SetFG(1) TUI_BufferChar(88) }
        TUI_ResetColor()
        ReturnValue(0)
    }
}

// Print OK/FAIL badge
Function.UI_Badge {
    Input: row: Integer
    Input: col: Integer
    Input: ok: Integer
    Body: {
        TUI_MoveTo(row, col)
        IfCondition EqualTo(ok, 1) ThenBlock: {
            TUI_SetColor(0, 2)
            TUI_Print(" OK ")
        } ElseBlock: {
            TUI_SetColor(7, 1)
            TUI_Print("FAIL")
        }
        TUI_ResetColor()
        ReturnValue(0)
    }
}

// =============================================================================
// SCREEN 0: MAIN — SPLIT (journals left, weights right)
// =============================================================================

Function.Draw_Main {
    Body: {
        TUI_Clear()
        UI_TitleBar("JOURNALS | WEIGHTS")

        // Left header
        TUI_MoveTo(3, 2)
        TUI_Bold()
        TUI_SetFG(3)
        TUI_Print("JNL PIN  ANG   S0    S1    S2    S3   Z-pos")
        TUI_ResetColor()
        TUI_HLine(4, 1, 51)

        j = 0
        WhileLoop LessThan(j, 8) {
            row = Add(5, j)
            IfCondition EqualTo(j, App.selected_journal) ThenBlock: {
                TUI_SetFG(0)
                TUI_SetBG(3)
            } ElseBlock: {
                TUI_SetFG(7)
            }

            base     = Journal_BaseAngle(j)
            base_deg = Divide(base, 1000)
            def_z    = Journal_DefaultZ(j)
            def_z_mm = Divide(def_z, 1000)

            TUI_MoveTo(row, 2)
            TUI_Print("J")
            TUI_WriteNum(Add(j, 1))

            pin = 0
            IfCondition Or(EqualTo(j, 0), EqualTo(j, 7)) ThenBlock: { pin = 1 }
            IfCondition Or(EqualTo(j, 1), EqualTo(j, 6)) ThenBlock: { pin = 2 }
            IfCondition Or(EqualTo(j, 2), EqualTo(j, 5)) ThenBlock: { pin = 3 }
            IfCondition Or(EqualTo(j, 3), EqualTo(j, 4)) ThenBlock: { pin = 4 }
            TUI_MoveTo(row, 5)
            TUI_WriteNum(pin)

            TUI_MoveTo(row, 8)
            TUI_WriteNum(base_deg)
            TUI_BufferChar(176)

            // Slot totals
            s = 0
            WhileLoop LessThan(s, 4) {
                slot_col  = Add(14, Multiply(s, 6))
                slot_mass = 0
                k = 0
                WhileLoop LessThan(k, WeightStore.count) {
                    wp = Weight_GetPtr(k)
                    wj = Dereference(Add(wp, WeightField.JOURNAL))
                    ws = Dereference(Add(wp, WeightField.SLOT))
                    wm = Dereference(Add(wp, WeightField.MASS))
                    IfCondition And(EqualTo(wj, j), EqualTo(ws, s)) ThenBlock: {
                        slot_mass = Add(slot_mass, wm)
                    }
                    k = Add(k, 1)
                }
                TUI_MoveTo(row, slot_col)
                IfCondition GreaterThan(slot_mass, 0) ThenBlock: {
                    TUI_SetFG(2)
                    TUI_WriteNum(Divide(slot_mass, 1000))
                    TUI_SetFG(7)
                } ElseBlock: {
                    TUI_SetFG(8)
                    TUI_Print(" ---")
                    TUI_SetFG(7)
                }
                s = Add(s, 1)
            }

            // Z position
            TUI_MoveTo(row, 39)
            TUI_WriteNum(def_z_mm)
            TUI_Print("mm")

            TUI_ResetColor()
            j = Add(j, 1)
        }

        // Correction plane indicators
        TUI_MoveTo(14, 2)
        TUI_SetFG(6)
        TUI_Print("Front plane Z: ")
        TUI_WriteNum(Divide(CorrPlane.front_z, 1000))
        TUI_Print("mm   Rear plane Z: ")
        TUI_WriteNum(Divide(CorrPlane.rear_z, 1000))
        TUI_Print("mm   [P]=edit")
        TUI_ResetColor()

        // Vertical divider
        TUI_VLine(3, 51, 17)

        // Right: weight list header
        TUI_MoveTo(3, 53)
        TUI_Bold()
        TUI_SetFG(6)
        TUI_Print("# JNL SL  MASS      ANG   Z")
        TUI_ResetColor()

        i = 0
        WhileLoop And(LessThan(i, WeightStore.count), LessThan(i, 15)) {
            row = Add(5, i)
            ptr     = Weight_GetPtr(i)
            wj      = Dereference(Add(ptr, WeightField.JOURNAL))
            ws      = Dereference(Add(ptr, WeightField.SLOT))
            wm      = Dereference(Add(ptr, WeightField.MASS))
            is_corr = Dereference(Add(ptr, WeightField.IS_CORRECTION))
            eff_a   = Weight_EffAngle(ptr)
            eff_z   = Weight_EffZ(ptr)

            TUI_MoveTo(row, 53)
            IfCondition EqualTo(is_corr, 1) ThenBlock: { TUI_SetFG(3) } ElseBlock: { TUI_SetFG(8) }
            TUI_WriteNum(Add(i, 1))
            TUI_ResetColor()
            TUI_Print(" J")
            TUI_WriteNum(Add(wj, 1))
            TUI_Print(" S")
            TUI_WriteNum(ws)
            TUI_Print(" ")
            UI_PrintFixed(row, 63, wm, "")
            TUI_MoveTo(row, 71)
            TUI_WriteNum(Divide(eff_a, 1000))
            TUI_BufferChar(176)
            TUI_MoveTo(row, 76)
            TUI_WriteNum(Divide(eff_z, 1000))
            i = Add(i, 1)
        }

        IfCondition EqualTo(WeightStore.count, 0) ThenBlock: {
            TUI_MoveTo(6, 53)
            TUI_SetFG(8)
            TUI_Print("(none)")
            TUI_ResetColor()
        }

        // Balance summary
        TUI_HLine(21, 1, 80)
        Calc_Static()
        Calc_Dynamic()
        s_imbal = Calc_StaticImbalance()
        d_imbal = Calc_CoupleImbalance()

        TUI_MoveTo(22, 2)
        TUI_Bold()
        TUI_SetFG(6)
        TUI_Print("STATIC  |imb|:")
        TUI_ResetColor()
        IfCondition LessThan(s_imbal, V8Config.BALANCE_THRESHOLD) ThenBlock: { TUI_SetFG(2) } ElseBlock: { TUI_SetFG(1) }
        TUI_WriteNum(s_imbal)
        TUI_Print(" mg-mm")
        TUI_ResetColor()
        UI_Badge(22, 30, LessThan(s_imbal, V8Config.BALANCE_THRESHOLD))

        TUI_MoveTo(22, 36)
        TUI_Bold()
        TUI_SetFG(6)
        TUI_Print("DYNAMIC  |couple|:")
        TUI_ResetColor()
        IfCondition LessThan(d_imbal, V8Config.COUPLE_THRESHOLD) ThenBlock: { TUI_SetFG(2) } ElseBlock: { TUI_SetFG(1) }
        TUI_WriteNum(d_imbal)
        TUI_Print(" mg-mm^2")
        TUI_ResetColor()
        UI_Badge(22, 68, LessThan(d_imbal, V8Config.COUPLE_THRESHOLD))

        UI_BalanceBar(23, 25, 20, Divide(App.bal_x, 1000))
        TUI_MoveTo(23, 2)
        TUI_SetFG(8)
        TUI_Print("Stat-X")
        TUI_ResetColor()

        UI_BalanceBar(23, 65, 10, Divide(App.couple_x, 100))
        TUI_MoveTo(23, 48)
        TUI_SetFG(8)
        TUI_Print("Dyn-X")
        TUI_ResetColor()

        UI_BalanceBar(24, 25, 20, Divide(App.bal_y, 1000))
        TUI_MoveTo(24, 2)
        TUI_SetFG(8)
        TUI_Print("Stat-Y")
        TUI_ResetColor()

        UI_BalanceBar(24, 65, 10, Divide(App.couple_y, 100))
        TUI_MoveTo(24, 48)
        TUI_SetFG(8)
        TUI_Print("Dyn-Y")
        TUI_ResetColor()

        UI_NavBar("[A]dd [W]ts [C]stat [V]dyn [P]lanes [?]Help [Q]uit  UP/DN=journal")
        ReturnValue(0)
    }
}

// =============================================================================
// SCREEN 1: WEIGHT LIST
// =============================================================================

Function.Draw_WeightList {
    Body: {
        TUI_Clear()
        UI_TitleBar("WEIGHT LIST")

        TUI_MoveTo(3, 2)
        TUI_Bold()
        TUI_SetFG(3)
        TUI_Print("  #   JNL  SL   MASS (mg)      ANG (eff)    RADIUS       Z (mm)")
        TUI_ResetColor()
        TUI_HLine(4, 1, 76)

        IfCondition EqualTo(WeightStore.count, 0) ThenBlock: {
            TUI_MoveTo(6, 4)
            TUI_SetFG(8)
            TUI_Print("No weights entered yet. Press [A] to add.")
            TUI_ResetColor()
        } ElseBlock: {
            i = 0
            WhileLoop LessThan(i, WeightStore.count) {
                row     = Add(5, i)
                ptr     = Weight_GetPtr(i)
                wj      = Dereference(Add(ptr, WeightField.JOURNAL))
                ws      = Dereference(Add(ptr, WeightField.SLOT))
                wm      = Dereference(Add(ptr, WeightField.MASS))
                wr      = Dereference(Add(ptr, WeightField.RADIUS))
                is_corr = Dereference(Add(ptr, WeightField.IS_CORRECTION))
                eff_a   = Weight_EffAngle(ptr)
                eff_z   = Weight_EffZ(ptr)

                TUI_MoveTo(row, 2)
                IfCondition EqualTo(is_corr, 1) ThenBlock: { TUI_SetFG(3) } ElseBlock: { TUI_SetFG(8) }
                TUI_WriteNum(Add(i, 1))
                IfCondition EqualTo(is_corr, 1) ThenBlock: { TUI_Print("*") } ElseBlock: { TUI_Print(" ") }
                TUI_ResetColor()

                TUI_MoveTo(row, 6)
                TUI_Print("J")
                TUI_WriteNum(Add(wj, 1))
                TUI_MoveTo(row, 10)
                TUI_WriteNum(ws)
                TUI_MoveTo(row, 14)
                UI_PrintFixed(row, 14, wm, "mg")
                TUI_MoveTo(row, 30)
                TUI_WriteNum(Divide(eff_a, 1000))
                TUI_BufferChar(176)
                TUI_MoveTo(row, 43)
                UI_PrintFixed(row, 43, wr, "mm")
                TUI_MoveTo(row, 57)
                UI_PrintFixed(row, 57, eff_z, "mm")

                i = Add(i, 1)
            }
        }

        TUI_HLine(21, 1, 76)
        TUI_MoveTo(22, 2)
        TUI_SetFG(8)
        TUI_Print("Total: ")
        TUI_ResetColor()
        TUI_WriteNum(WeightStore.count)
        TUI_Print(" weights   Total mass: ")
        Calc_Static()
        UI_PrintFixed(22, 42, App.total_mass, "mg")
        TUI_Print("  (* = computed correction)")

        UI_NavBar("[A]dd  [D]elete last  [M]ain  [C]stat  [V]dyn  [Q]uit")
        ReturnValue(0)
    }
}

// =============================================================================
// SCREEN 2: ADD WEIGHT FORM (6 fields, full screen)
// =============================================================================

Function.Draw_AddWeight {
    Body: {
        TUI_Clear()
        UI_TitleBar("ADD COUNTERWEIGHT")

        base    = Journal_BaseAngle(AddWt.journal)
        base_deg = Divide(base, 1000)
        slot_eff = Modulo(Add(base, Multiply(AddWt.slot, 45000)), 360000)
        eff_deg  = Divide(slot_eff, 1000)
        def_z    = Journal_DefaultZ(AddWt.journal)
        eff_z    = AddWt.axial_z
        IfCondition EqualTo(eff_z, 0) ThenBlock: { eff_z = def_z }

        TUI_MoveTo(3, 4)
        TUI_SetFG(6)
        TUI_Print("J")
        TUI_WriteNum(Add(AddWt.journal, 1))
        TUI_Print("  pin angle:")
        TUI_WriteNum(base_deg)
        TUI_BufferChar(176)
        TUI_Print("  slot ")
        TUI_WriteNum(AddWt.slot)
        TUI_Print(" eff angle:")
        TUI_SetFG(3)
        TUI_WriteNum(eff_deg)
        TUI_BufferChar(176)
        TUI_ResetColor()
        TUI_Print("  Z:")
        TUI_SetFG(3)
        TUI_WriteNum(Divide(eff_z, 1000))
        TUI_Print("mm")
        TUI_ResetColor()

        TUI_HLine(4, 1, 76)

        // Field 0: Journal
        TUI_MoveTo(6, 4)
        IfCondition EqualTo(AddWt.field, 0) ThenBlock: { TUI_SetFG(3) TUI_Bold() } ElseBlock: { TUI_SetFG(7) }
        TUI_Print("  [1] Journal          : J")
        TUI_WriteNum(Add(AddWt.journal, 1))
        TUI_Print("  (Left/Right)")
        TUI_ResetColor()

        // Field 1: Slot
        TUI_MoveTo(8, 4)
        IfCondition EqualTo(AddWt.field, 1) ThenBlock: { TUI_SetFG(3) TUI_Bold() } ElseBlock: { TUI_SetFG(7) }
        TUI_Print("  [2] Slot             : ")
        TUI_WriteNum(AddWt.slot)
        TUI_Print("  0=base +1=+45 +2=+90 +3=+180  (Left/Right)")
        TUI_ResetColor()

        // Field 2: Mass
        TUI_MoveTo(10, 4)
        IfCondition EqualTo(AddWt.field, 2) ThenBlock: { TUI_SetFG(3) TUI_Bold() } ElseBlock: { TUI_SetFG(7) }
        TUI_Print("  [3] Mass (mg*1000)    : ")
        IfCondition EqualTo(AddWt.field, 2) ThenBlock: {
            TUI_Print(InputState.buf)
            TUI_BufferChar(95)
        } ElseBlock: {
            UI_PrintFixed(10, 29, AddWt.mass_mg, "mg")
        }
        TUI_ResetColor()

        // Field 3: Angle override
        TUI_MoveTo(12, 4)
        IfCondition EqualTo(AddWt.field, 3) ThenBlock: { TUI_SetFG(3) TUI_Bold() } ElseBlock: { TUI_SetFG(7) }
        TUI_Print("  [4] Angle (deg*1000)  : ")
        IfCondition EqualTo(AddWt.field, 3) ThenBlock: {
            TUI_Print(InputState.buf)
            TUI_BufferChar(95)
        } ElseBlock: {
            IfCondition EqualTo(AddWt.angle_deg, 0) ThenBlock: {
                TUI_SetFG(8)
                TUI_Print("auto (")
                TUI_WriteNum(eff_deg)
                TUI_BufferChar(176)
                TUI_Print(")")
            } ElseBlock: {
                TUI_WriteNum(Divide(AddWt.angle_deg, 1000))
                TUI_BufferChar(176)
            }
        }
        TUI_ResetColor()

        // Field 4: Radius
        TUI_MoveTo(14, 4)
        IfCondition EqualTo(AddWt.field, 4) ThenBlock: { TUI_SetFG(3) TUI_Bold() } ElseBlock: { TUI_SetFG(7) }
        TUI_Print("  [5] Radius (mm*1000)  : ")
        IfCondition EqualTo(AddWt.field, 4) ThenBlock: {
            TUI_Print(InputState.buf)
            TUI_BufferChar(95)
        } ElseBlock: {
            UI_PrintFixed(14, 29, AddWt.radius_mm, "mm")
        }
        TUI_ResetColor()

        // Field 5: Axial Z
        TUI_MoveTo(16, 4)
        IfCondition EqualTo(AddWt.field, 5) ThenBlock: { TUI_SetFG(3) TUI_Bold() } ElseBlock: { TUI_SetFG(7) }
        TUI_Print("  [6] Axial Z (mm*1000) : ")
        IfCondition EqualTo(AddWt.field, 5) ThenBlock: {
            TUI_Print(InputState.buf)
            TUI_BufferChar(95)
        } ElseBlock: {
            IfCondition EqualTo(AddWt.axial_z, 0) ThenBlock: {
                TUI_SetFG(8)
                TUI_Print("auto (J")
                TUI_WriteNum(Add(AddWt.journal, 1))
                TUI_Print(" default = ")
                TUI_WriteNum(Divide(def_z, 1000))
                TUI_Print("mm)")
            } ElseBlock: {
                UI_PrintFixed(16, 29, AddWt.axial_z, "mm")
            }
        }
        TUI_ResetColor()

        TUI_HLine(18, 1, 76)

        // Preview
        TUI_MoveTo(19, 4)
        TUI_SetFG(6)
        TUI_Print("Preview: J")
        TUI_WriteNum(Add(AddWt.journal, 1))
        TUI_Print(" Slot")
        TUI_WriteNum(AddWt.slot)
        TUI_Print(" @ ")
        TUI_WriteNum(eff_deg)
        TUI_BufferChar(176)
        TUI_Print("  mass=")
        UI_PrintFixed(19, 42, AddWt.mass_mg, "mg")
        TUI_Print("  r=")
        UI_PrintFixed(19, 57, AddWt.radius_mm, "mm")
        TUI_Print("  z=")
        TUI_WriteNum(Divide(eff_z, 1000))
        TUI_Print("mm")
        TUI_ResetColor()

        UI_NavBar("[Tab/1-6]=field  [Enter]=Add  [Esc]=Cancel")
        ReturnValue(0)
    }
}

// =============================================================================
// SCREEN 3: STATIC BALANCE RESULTS
// =============================================================================

Function.Draw_StaticResults {
    Body: {
        Calc_Static()
        s_imbal = Calc_StaticImbalance()
        corr_mass = Divide(Multiply(s_imbal, V8Config.SCALE), 50000)

        TUI_Clear()
        UI_TitleBar("STATIC BALANCE RESULTS")

        TUI_HLine(3, 1, 76)
        TUI_MoveTo(4, 4)
        TUI_Print("Weights: ")
        TUI_WriteNum(WeightStore.count)
        TUI_Print("   Total mass: ")
        UI_PrintFixed(4, 28, App.total_mass, "mg")

        TUI_HLine(6, 1, 76)
        TUI_MoveTo(7, 4)
        TUI_Bold()
        TUI_Print("Balance vector:")
        TUI_ResetColor()
        TUI_MoveTo(8, 6)
        TUI_Print("X = ")
        TUI_WriteNum(App.bal_x)
        TUI_Print(" mg-mm")
        TUI_MoveTo(9, 6)
        TUI_Print("Y = ")
        TUI_WriteNum(App.bal_y)
        TUI_Print(" mg-mm")

        TUI_MoveTo(11, 6)
        TUI_Bold()
        TUI_Print("|Imbalance| = ")
        ok = LessThan(s_imbal, V8Config.BALANCE_THRESHOLD)
        IfCondition EqualTo(ok, 1) ThenBlock: { TUI_SetFG(2) } ElseBlock: { TUI_SetFG(1) }
        TUI_WriteNum(s_imbal)
        TUI_Print(" mg-mm")
        TUI_ResetColor()
        UI_Badge(11, 30, ok)

        UI_BalanceBar(13, 38, 28, Divide(App.bal_x, 1000))
        TUI_MoveTo(13, 2)
        TUI_SetFG(8)
        TUI_Print("X-axis")
        TUI_ResetColor()
        UI_BalanceBar(14, 38, 28, Divide(App.bal_y, 1000))
        TUI_MoveTo(14, 2)
        TUI_SetFG(8)
        TUI_Print("Y-axis")
        TUI_ResetColor()

        TUI_HLine(16, 1, 76)

        IfCondition GreaterThan(s_imbal, V8Config.BALANCE_THRESHOLD) ThenBlock: {
            TUI_MoveTo(17, 4)
            TUI_Bold()
            TUI_SetFG(3)
            TUI_Print("STATIC CORRECTION (R=50mm):")
            TUI_ResetColor()
            TUI_MoveTo(18, 6)
            TUI_Print("Add ")
            UI_PrintFixed(18, 10, corr_mass, "mg")
            TUI_Print(" opposite imbalance vector")
            TUI_MoveTo(19, 6)
            TUI_Print("Direction: ")
            IfCondition GreaterThan(App.bal_x, 0) ThenBlock: { TUI_SetFG(1) TUI_Print("+X") } ElseBlock: { TUI_SetFG(4) TUI_Print("-X") }
            TUI_ResetColor()
            TUI_Print(" / ")
            IfCondition GreaterThan(App.bal_y, 0) ThenBlock: { TUI_SetFG(1) TUI_Print("+Y") } ElseBlock: { TUI_SetFG(4) TUI_Print("-Y") }
            TUI_ResetColor()
            TUI_MoveTo(20, 6)
            TUI_Print("Split option: ")
            UI_PrintFixed(20, 20, Divide(corr_mass, 2), "mg")
            TUI_Print(" at correction+45 AND correction-45 deg")
        } ElseBlock: {
            TUI_MoveTo(17, 4)
            TUI_SetFG(2)
            TUI_Bold()
            TUI_Print("Within static tolerance. No correction needed.")
            TUI_ResetColor()
        }

        UI_NavBar("[V]dyn results  [M]ain  [W]ts  [Q]uit")
        ReturnValue(0)
    }
}

// =============================================================================
// SCREEN 4: DYNAMIC BALANCE RESULTS
// =============================================================================

Function.Draw_DynamicResults {
    Body: {
        Calc_Static()
        Calc_Dynamic()
        s_imbal = Calc_StaticImbalance()
        d_imbal = Calc_CoupleImbalance()

        TUI_Clear()
        UI_TitleBar("DYNAMIC BALANCE RESULTS")

        TUI_MoveTo(3, 4)
        TUI_SetFG(8)
        TUI_Print("Front correction plane Z: ")
        TUI_WriteNum(Divide(CorrPlane.front_z, 1000))
        TUI_Print("mm    Rear correction plane Z: ")
        TUI_WriteNum(Divide(CorrPlane.rear_z, 1000))
        TUI_Print("mm")
        TUI_ResetColor()

        TUI_HLine(4, 1, 76)

        // Static summary line
        TUI_MoveTo(5, 4)
        TUI_Print("Static  |imb| = ")
        ok_s = LessThan(s_imbal, V8Config.BALANCE_THRESHOLD)
        IfCondition EqualTo(ok_s, 1) ThenBlock: { TUI_SetFG(2) } ElseBlock: { TUI_SetFG(1) }
        TUI_WriteNum(s_imbal)
        TUI_Print(" mg-mm")
        TUI_ResetColor()
        UI_Badge(5, 32, ok_s)
        TUI_MoveTo(5, 38)
        TUI_SetFG(8)
        TUI_Print("(use [C] for static correction detail)")
        TUI_ResetColor()

        TUI_HLine(6, 1, 76)

        // Dynamic couple
        TUI_MoveTo(7, 4)
        TUI_Bold()
        TUI_Print("Couple vector (about front plane):")
        TUI_ResetColor()
        TUI_MoveTo(8, 6)
        TUI_Print("X = ")
        TUI_WriteNum(App.couple_x)
        TUI_Print(" mg-mm^2")
        TUI_MoveTo(9, 6)
        TUI_Print("Y = ")
        TUI_WriteNum(App.couple_y)
        TUI_Print(" mg-mm^2")
        TUI_MoveTo(11, 6)
        TUI_Bold()
        TUI_Print("|Couple| = ")
        ok_d = LessThan(d_imbal, V8Config.COUPLE_THRESHOLD)
        IfCondition EqualTo(ok_d, 1) ThenBlock: { TUI_SetFG(2) } ElseBlock: { TUI_SetFG(1) }
        TUI_WriteNum(d_imbal)
        TUI_Print(" mg-mm^2")
        TUI_ResetColor()
        UI_Badge(11, 30, ok_d)

        UI_BalanceBar(13, 38, 28, Divide(App.couple_x, 100))
        TUI_MoveTo(13, 2)
        TUI_SetFG(8)
        TUI_Print("CpX")
        TUI_ResetColor()
        UI_BalanceBar(14, 38, 28, Divide(App.couple_y, 100))
        TUI_MoveTo(14, 2)
        TUI_SetFG(8)
        TUI_Print("CpY")
        TUI_ResetColor()

        TUI_HLine(16, 1, 76)

        // Two-plane correction
        IfCondition GreaterThan(d_imbal, V8Config.COUPLE_THRESHOLD) ThenBlock: {
            TUI_MoveTo(17, 4)
            TUI_Bold()
            TUI_SetFG(3)
            TUI_Print("TWO-PLANE DYNAMIC CORRECTION (R=50mm each plane):")
            TUI_ResetColor()

            TUI_MoveTo(18, 6)
            TUI_SetFG(6)
            TUI_Print("FRONT plane (Z=")
            TUI_WriteNum(Divide(CorrPlane.front_z, 1000))
            TUI_Print("mm):")
            TUI_ResetColor()
            TUI_Print("  Add ")
            UI_PrintFixed(18, 38, App.front_mass, "mg")
            TUI_Print(" @ ")
            TUI_WriteNum(Divide(App.front_angle, 1000))
            TUI_BufferChar(176)

            TUI_MoveTo(19, 6)
            TUI_SetFG(6)
            TUI_Print("REAR  plane (Z=")
            TUI_WriteNum(Divide(CorrPlane.rear_z, 1000))
            TUI_Print("mm):")
            TUI_ResetColor()
            TUI_Print("  Add ")
            UI_PrintFixed(19, 38, App.rear_mass, "mg")
            TUI_Print(" @ ")
            TUI_WriteNum(Divide(App.rear_angle, 1000))
            TUI_BufferChar(176)

            TUI_MoveTo(21, 6)
            TUI_SetFG(8)
            TUI_Print("Note: angles are approximate quadrant estimates.")
            TUI_Print(" Verify on the spin balancer.")
            TUI_ResetColor()
        } ElseBlock: {
            TUI_MoveTo(17, 4)
            TUI_SetFG(2)
            TUI_Bold()
            TUI_Print("Within dynamic tolerance. No couple correction needed.")
            TUI_ResetColor()
        }

        UI_NavBar("[C]stat results  [P]lanes  [M]ain  [W]ts  [Q]uit")
        ReturnValue(0)
    }
}

// =============================================================================
// SCREEN 5: CORRECTION PLANE SETUP
// =============================================================================

FixedPool.PlaneEdit {
    "field": Initialize=0   // 0=front_z 1=rear_z
}

Function.Draw_Planes {
    Body: {
        TUI_Clear()
        UI_TitleBar("CORRECTION PLANES")

        TUI_MoveTo(3, 4)
        TUI_SetFG(8)
        TUI_Print("Set the axial Z positions of your two correction planes.")
        TUI_MoveTo(4, 4)
        TUI_Print("These should match the balancing machine's measurement planes,")
        TUI_MoveTo(5, 4)
        TUI_Print("or the physical locations where you will add/remove material.")
        TUI_ResetColor()

        TUI_HLine(6, 1, 76)

        // Journal Z reference table
        TUI_MoveTo(7, 4)
        TUI_Bold()
        TUI_SetFG(3)
        TUI_Print("Journal Z positions (default, mm from front datum):")
        TUI_ResetColor()

        j = 0
        WhileLoop LessThan(j, 8) {
            col = Add(4, Multiply(j, 9))
            TUI_MoveTo(8, col)
            TUI_SetFG(8)
            TUI_Print("J")
            TUI_WriteNum(Add(j, 1))
            TUI_Print("=")
            TUI_WriteNum(Divide(Journal_DefaultZ(j), 1000))
            TUI_ResetColor()
            j = Add(j, 1)
        }

        TUI_HLine(10, 1, 76)

        // Field 0: Front plane
        TUI_MoveTo(12, 4)
        IfCondition EqualTo(PlaneEdit.field, 0) ThenBlock: { TUI_SetFG(3) TUI_Bold() } ElseBlock: { TUI_SetFG(7) }
        TUI_Print("  [1] Front correction plane Z (mm*1000): ")
        IfCondition EqualTo(PlaneEdit.field, 0) ThenBlock: {
            TUI_Print(InputState.buf)
            TUI_BufferChar(95)
        } ElseBlock: {
            UI_PrintFixed(12, 47, CorrPlane.front_z, "mm")
        }
        TUI_ResetColor()

        // Field 1: Rear plane
        TUI_MoveTo(14, 4)
        IfCondition EqualTo(PlaneEdit.field, 1) ThenBlock: { TUI_SetFG(3) TUI_Bold() } ElseBlock: { TUI_SetFG(7) }
        TUI_Print("  [2] Rear  correction plane Z (mm*1000): ")
        IfCondition EqualTo(PlaneEdit.field, 1) ThenBlock: {
            TUI_Print(InputState.buf)
            TUI_BufferChar(95)
        } ElseBlock: {
            UI_PrintFixed(14, 47, CorrPlane.rear_z, "mm")
        }
        TUI_ResetColor()

        TUI_HLine(16, 1, 76)

        TUI_MoveTo(17, 4)
        TUI_SetFG(6)
        TUI_Print("Plane span: ")
        span = Subtract(CorrPlane.rear_z, CorrPlane.front_z)
        UI_PrintFixed(17, 17, span, "mm")
        TUI_ResetColor()

        UI_NavBar("[Tab/1-2]=field  [Enter]=Set  [Esc/M]=Main")
        ReturnValue(0)
    }
}

// =============================================================================
// SCREEN 6: HELP
// =============================================================================

Function.Draw_Help {
    Body: {
        TUI_Clear()
        UI_TitleBar("HELP")

        TUI_MoveTo(3, 4)
        TUI_Bold()
        TUI_SetFG(6)
        TUI_Print("V8 CRANKSHAFT BALANCE TOOL — STATIC + DYNAMIC")
        TUI_ResetColor()
