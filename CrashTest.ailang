// =============================================================================
// TEST: Simple SubRoutine with loop and pool access
// File: subtest.ailang
// =============================================================================

FixedPool.Config {
    "limit": Initialize=5
    "marker": Initialize=999
}

SubRoutine.Main {
    PrintMessage("Test: SubRoutine with pool\n")
    
    PrintMessage("Config.limit = ")
    PrintNumber(Config.limit)
    PrintMessage("\n")
    
    PrintMessage("Config.marker = ")
    PrintNumber(Config.marker)
    PrintMessage("\n")
    
    i = 0
    WhileLoop LessThan(i, Config.limit) {
        PrintMessage("i = ")
        PrintNumber(i)
        PrintMessage("\n")
        i = Add(i, 1)
    }
    
    PrintMessage("After loop, i = ")
    PrintNumber(i)
    PrintMessage("\n")
    
    PrintMessage("Done\n")
}

RunTask(Main)