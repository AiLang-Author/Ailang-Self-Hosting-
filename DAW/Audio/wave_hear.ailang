// Play a pcm ring on /dev/snd/pcmC0D0p.
// The period is 256 frames and the buffer is 1024. The card asks for
// one period. A ring deeper than 1024 frames is cut back to the last
// 1024. A short ring is silence.
//
//   wave_hear /dev/shm/daw/wplay/pcm.bin
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Arena
LibraryImport.Display.Render.AudioEngine

FixedPool.Wh {
    "cmd":    Initialize=0, CanChange=True
    "path":   Initialize=0, CanChange=True
    "ring":   Initialize=0, CanChange=True
    "out":    Initialize=0, CanChange=True
    "stat":   Initialize=0, CanChange=True
    "nap":    Initialize=0, CanChange=True
    "frames": Initialize=256, CanChange=True
}

Function.Wh.Args {
    Output: Integer
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(4096)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            ReturnValue(0)
        }
        MemorySet(buf, 0, 4096)
        n = SystemCall(0, fd, buf, 4095)
        SystemCall(3, fd, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        Wh.cmd = buf
        i = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            IfCondition GreaterEqual(i, n) ThenBlock: { state = 0 }
            ElseBlock: {
                ch = GetByte(buf, i)
                i = Add(i, 1)
                IfCondition EqualTo(ch, 0) ThenBlock: { state = 0 }
            }
        }
        IfCondition GreaterEqual(i, n) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(buf, i), 0) ThenBlock: { ReturnValue(0) }
        Wh.path = Add(buf, i)
        ReturnValue(1)
    }
}

Function.Wh.Map {
    Output: Address
    Body: {
        fd = SystemCall(2, Wh.path, 66, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        total = 32832
        SystemCall(77, fd, total)
        ptr = SystemCall(9, 0, total, 3, 1, fd, 0)
        IfCondition LessEqual(ptr, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            ReturnValue(0)
        }
        cap = Dereference(Add(ptr, 8))
        IfCondition EqualTo(cap, 0) ThenBlock: {
            StoreValue(Add(ptr, 8), 8192)
            StoreValue(Add(ptr, 16), 0)
            StoreValue(Add(ptr, 24), 0)
            StoreValue(Add(ptr, 32), 48000)
        }
        ReturnValue(ptr)
    }
}

Function.Wh.Room {
    Output: Integer
    Body: {
        fd = AudioState.fd
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(16, fd, 16674, 0, 0, 0)
        MemorySet(Wh.stat, 0, 152)
        r = SystemCall(16, fd, 2157461792, Wh.stat, 0, 0)
        IfCondition LessThan(r, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(Wh.stat, 64)))
    }
}

Function.Wh.Wait {
    Body: {
        state = 1
        WhileLoop EqualTo(state, 1) {
            room = Wh.Room()
            IfCondition GreaterEqual(room, Wh.frames) ThenBlock: { state = 0 }
            ElseBlock: { SystemCall(35, Wh.nap, 0, 0) }
        }
    }
}

Function.Wh.Fill {
    Body: {
        MemorySet(Wh.out, 0, Multiply(Wh.frames, 4))
        pcm = Wh.ring
        w = Dereference(Add(pcm, 16))
        r = Dereference(Add(pcm, 24))
        cap = Dereference(Add(pcm, 8))
        IfCondition EqualTo(cap, 0) ThenBlock: { cap = 8192 }
        u = Subtract(w, r)
        IfCondition LessThan(u, 0) ThenBlock: { u = 0 }
        IfCondition GreaterThan(u, cap) ThenBlock: { u = cap }
        IfCondition GreaterThan(u, 1024) ThenBlock: {
            r = Subtract(w, 1024)
            StoreValue(Add(pcm, 24), r)
            u = 1024
        }
        n = Wh.frames
        IfCondition GreaterThan(n, u) ThenBlock: { n = u }
        i = 0
        WhileLoop LessThan(i, n) {
            slot = Modulo(Add(r, i), cap)
            src = Add(pcm, Add(64, Multiply(slot, 4)))
            dst = Add(Wh.out, Multiply(i, 4))
            SetByte(dst, 0, GetByte(src, 0))
            SetByte(dst, 1, GetByte(src, 1))
            SetByte(dst, 2, GetByte(src, 2))
            SetByte(dst, 3, GetByte(src, 3))
            i = Add(i, 1)
        }
        StoreValue(Add(pcm, 24), Add(r, n))
    }
}

SubRoutine.Main {
    Arena_Init()
    ok = Wh.Args()
    IfCondition EqualTo(ok, 0) ThenBlock: {
        PrintMessage("usage: wave_hear ring.pcm.bin\n")
        SystemCall(60, 1, 0, 0)
    }
    ring = Wh.Map()
    IfCondition EqualTo(ring, 0) ThenBlock: {
        PrintMessage("wave_hear: cannot open ring\n")
        SystemCall(60, 1, 0, 0)
    }
    Wh.ring = ring
    AudioWant.per_min = 256
    AudioWant.per_max = 256
    AudioWant.buf_min = 1024
    AudioWant.buf_max = 1024
    AudioWant.nper_min = 4
    AudioWant.nper_max = 4
    r = Audio_Init()
    IfCondition LessThan(r, 0) ThenBlock: {
        PrintMessage("wave_hear: card open failed\n")
        SystemCall(60, 1, 0, 0)
    }
    per = AudioState.period_size
    IfCondition LessThan(per, 1) ThenBlock: { per = 256 }
    IfCondition GreaterThan(per, 1024) ThenBlock: { per = 256 }
    Wh.frames = per
    Wh.out = Allocate(Multiply(per, 4))
    Wh.stat = Allocate(152)
    Wh.nap = Allocate(16)
    MemorySet(Wh.nap, 0, 16)
    StoreValue(Add(Wh.nap, 8), 2000000)
    PrintMessage("wave_hear card period ")
    PrintNumber(per)
    PrintMessage(" frames, 48000 Hz, /dev/snd/pcmC0D0p\n")
    state = 1
    WhileLoop EqualTo(state, 1) {
        Wh.Wait()
        Wh.Fill()
        spinning = 1
        WhileLoop EqualTo(spinning, 1) {
            wr = Audio_WriteFrames(Wh.out, Wh.frames)
            IfCondition LessThan(wr, 0) ThenBlock: {
                PrintMessage("wave_hear: write failed\n")
                spinning = 0
                state = 0
            } ElseBlock: {
                IfCondition LessThan(wr, 1) ThenBlock: {
                    SystemCall(35, Wh.nap, 0, 0)
                } ElseBlock: {
                    spinning = 0
                }
            }
        }
    }
    Audio_Shutdown()
    SystemCall(60, 1, 0, 0)
}

RunTask(Main)
