// Play one 16-bit WAV.
// Opens /dev/snd/pcmC0D0p when the card is free.
// If that open fails, writes the pcm ring and stops at 1024 frames.
//
//   wave_play /dev/shm/daw/wplay/pcm.bin take.wav
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Arena
LibraryImport.Display.Render.AudioEngine

FixedPool.Wp {
    "cmd":     Initialize=0, CanChange=True
    "ring":    Initialize=0, CanChange=True
    "wav":     Initialize=0, CanChange=True
    "pcm":     Initialize=0, CanChange=True
    "stereo":  Initialize=0, CanChange=True
    "nframes": Initialize=0, CanChange=True
    "rate":    Initialize=0, CanChange=True
    "nap":     Initialize=0, CanChange=True
    "card":    Initialize=0, CanChange=True
    "period":  Initialize=256, CanChange=True
    "cardbuf": Initialize=0, CanChange=True
    "stat":    Initialize=0, CanChange=True
}

Function.Wp.U16 {
    Input: p: Address
    Input: off: Integer
    Output: Integer
    Body: {
        lo = GetByte(p, off)
        hi = GetByte(p, Add(off, 1))
        ReturnValue(Add(lo, Multiply(hi, 256)))
    }
}

Function.Wp.U32 {
    Input: p: Address
    Input: off: Integer
    Output: Integer
    Body: {
        b0 = GetByte(p, off)
        b1 = GetByte(p, Add(off, 1))
        b2 = GetByte(p, Add(off, 2))
        b3 = GetByte(p, Add(off, 3))
        v = Add(b0, Multiply(b1, 256))
        v = Add(v, Multiply(b2, 65536))
        v = Add(v, Multiply(b3, 16777216))
        ReturnValue(v)
    }
}

Function.Wp.Args {
    Output: Integer
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(4096)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            ReturnValue(0)
        }
        MemorySet(buf, 0, 4096)
        n = SystemCall(0, fd, buf, 4095)
        SystemCall(3, fd, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        Wp.cmd = buf
        i = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            IfCondition GreaterEqual(i, n) ThenBlock: { state = 0 }
            ElseBlock: {
                ch = GetByte(buf, i)
                i = Add(i, 1)
                IfCondition EqualTo(ch, 0) ThenBlock: { state = 0 }
            }
        }
        IfCondition GreaterEqual(i, n) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(buf, i), 0) ThenBlock: { ReturnValue(0) }
        Wp.ring = Add(buf, i)
        state = 1
        WhileLoop EqualTo(state, 1) {
            IfCondition GreaterEqual(i, n) ThenBlock: { state = 0 }
            ElseBlock: {
                ch = GetByte(buf, i)
                i = Add(i, 1)
                IfCondition EqualTo(ch, 0) ThenBlock: { state = 0 }
            }
        }
        IfCondition GreaterEqual(i, n) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(buf, i), 0) ThenBlock: { ReturnValue(0) }
        Wp.wav = Add(buf, i)
        ReturnValue(1)
    }
}

Function.Wp.Load {
    Output: Integer
    Body: {
        fd = SystemCall(2, Wp.wav, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("wave_play: cannot open wav\n")
            ReturnValue(0)
        }
        sz = SystemCall(8, fd, 0, 2)
        SystemCall(8, fd, 0, 0)
        IfCondition LessThan(sz, 44) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            PrintMessage("wave_play: not a wav\n")
            ReturnValue(0)
        }
        buf = Allocate(sz)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            PrintMessage("wave_play: not a wav\n")
            ReturnValue(0)
        }
        got = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            IfCondition GreaterEqual(got, sz) ThenBlock: { state = 0 }
            ElseBlock: {
                n = SystemCall(0, fd, Add(buf, got), Subtract(sz, got))
                IfCondition LessEqual(n, 0) ThenBlock: { state = 0 }
                ElseBlock: { got = Add(got, n) }
            }
        }
        SystemCall(3, fd, 0, 0)
        IfCondition LessThan(got, 44) ThenBlock: {
            PrintMessage("wave_play: not a wav\n")
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(buf, 0), 82) ThenBlock: {
            PrintMessage("wave_play: not a wav\n")
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(buf, 8), 87) ThenBlock: {
            PrintMessage("wave_play: not a wav\n")
            ReturnValue(0)
        }
        ch = 0
        rate = 0
        bits = 0
        data_off = 0
        data_n = 0
        pos = 12
        state = 1
        WhileLoop EqualTo(state, 1) {
            IfCondition GreaterThan(pos, Subtract(got, 8)) ThenBlock: { state = 0 }
            ElseBlock: {
                id0 = GetByte(buf, pos)
                id1 = GetByte(buf, Add(pos, 1))
                id2 = GetByte(buf, Add(pos, 2))
                clen = Wp.U32(buf, Add(pos, 4))
                IfCondition EqualTo(id0, 102) ThenBlock: {
                    IfCondition EqualTo(id2, 116) ThenBlock: {
                        ch = Wp.U16(buf, Add(pos, 10))
                        rate = Wp.U32(buf, Add(pos, 12))
                        bits = Wp.U16(buf, Add(pos, 22))
                    }
                }
                IfCondition EqualTo(id0, 100) ThenBlock: {
                    IfCondition EqualTo(id1, 97) ThenBlock: {
                        data_off = Add(pos, 8)
                        data_n = clen
                    }
                }
                pos = Add(Add(pos, 8), clen)
                IfCondition EqualTo(Modulo(clen, 2), 1) ThenBlock: { pos = Add(pos, 1) }
            }
        }
        IfCondition NotEqual(bits, 16) ThenBlock: {
            PrintMessage("wave_play: need 16-bit mono or stereo\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(ch, 1) ThenBlock: { ch = 1 }
        ElseBlock: {
            IfCondition NotEqual(ch, 2) ThenBlock: {
                PrintMessage("wave_play: need 16-bit mono or stereo\n")
                ReturnValue(0)
            }
        }
        IfCondition LessThan(data_n, 4) ThenBlock: {
            PrintMessage("wave_play: need 16-bit mono or stereo\n")
            ReturnValue(0)
        }
        IfCondition GreaterThan(Add(data_off, data_n), got) ThenBlock: {
            data_n = Subtract(got, data_off)
        }
        IfCondition NotEqual(rate, 48000) ThenBlock: {
            PrintMessage("wave_play: file is ")
            PrintNumber(rate)
            PrintMessage(" Hz, card is 48000\n")
        }
        bpf = Multiply(2, ch)
        nframes = Divide(data_n, bpf)
        IfCondition LessThan(nframes, 1) ThenBlock: {
            PrintMessage("wave_play: need 16-bit mono or stereo\n")
            ReturnValue(0)
        }
        stereo = Allocate(Multiply(nframes, 4))
        IfCondition EqualTo(stereo, 0) ThenBlock: {
            PrintMessage("wave_play: need 16-bit mono or stereo\n")
            ReturnValue(0)
        }
        MemorySet(stereo, 0, Multiply(nframes, 4))
        i = 0
        WhileLoop LessThan(i, nframes) {
            src = Add(buf, Add(data_off, Multiply(i, bpf)))
            dst = Add(stereo, Multiply(i, 4))
            SetByte(dst, 0, GetByte(src, 0))
            SetByte(dst, 1, GetByte(src, 1))
            IfCondition EqualTo(ch, 2) ThenBlock: {
                SetByte(dst, 2, GetByte(src, 2))
                SetByte(dst, 3, GetByte(src, 3))
            } ElseBlock: {
                SetByte(dst, 2, GetByte(src, 0))
                SetByte(dst, 3, GetByte(src, 1))
            }
            i = Add(i, 1)
        }
        Wp.stereo = stereo
        Wp.nframes = nframes
        Wp.rate = rate
        ReturnValue(1)
    }
}

Function.Wp.Map {
    Output: Address
    Body: {
        SystemCall(83, "/dev/shm/daw", 493)
        SystemCall(83, "/dev/shm/daw/wplay", 493)
        fd = SystemCall(2, Wp.ring, 66, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        total = 32832
        SystemCall(77, fd, total)
        ptr = SystemCall(9, 0, total, 3, 1, fd, 0)
        IfCondition LessEqual(ptr, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            ReturnValue(0)
        }
        StoreValue(Add(ptr, 8), 8192)
        StoreValue(Add(ptr, 16), 0)
        StoreValue(Add(ptr, 24), 0)
        StoreValue(Add(ptr, 32), 48000)
        ReturnValue(ptr)
    }
}

Function.Wp.Push {
    Input: pcm: Address
    Input: src: Address
    Input: frames: Integer
    Output: Integer
    Body: {
        w = Dereference(Add(pcm, 16))
        r = Dereference(Add(pcm, 24))
        u = Subtract(w, r)
        IfCondition LessThan(u, 0) ThenBlock: { u = 0 }
        IfCondition GreaterThan(Add(u, frames), 1024) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, frames) {
            slot = Modulo(Add(w, i), 8192)
            dst = Add(pcm, Add(64, Multiply(slot, 4)))
            s = Add(src, Multiply(i, 4))
            SetByte(dst, 0, GetByte(s, 0))
            SetByte(dst, 1, GetByte(s, 1))
            SetByte(dst, 2, GetByte(s, 2))
            SetByte(dst, 3, GetByte(s, 3))
            i = Add(i, 1)
        }
        StoreValue(Add(pcm, 16), Add(w, frames))
        ReturnValue(1)
    }
}

Function.Wp.Nap {
    Body: {
        IfCondition EqualTo(Wp.nap, 0) ThenBlock: {
            Wp.nap = Allocate(16)
            MemorySet(Wp.nap, 0, 16)
            StoreValue(Add(Wp.nap, 8), 2000000)
        }
        SystemCall(35, Wp.nap, 0, 0)
    }
}

Function.Wp.Room {
    Output: Integer
    Body: {
        fd = AudioState.fd
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(16, fd, 16674, 0, 0, 0)
        MemorySet(Wp.stat, 0, 152)
        r = SystemCall(16, fd, 2157461792, Wp.stat, 0, 0)
        IfCondition LessThan(r, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(Wp.stat, 64)))
    }
}

Function.Wp.Wait {
    Body: {
        state = 1
        WhileLoop EqualTo(state, 1) {
            room = Wp.Room()
            IfCondition GreaterEqual(room, Wp.period) ThenBlock: { state = 0 }
            ElseBlock: { SystemCall(35, Wp.nap, 0, 0) }
        }
    }
}

Function.Wp.OpenCard {
    Output: Integer
    Body: {
        AudioWant.per_min = 256
        AudioWant.per_max = 256
        AudioWant.buf_min = 1024
        AudioWant.buf_max = 1024
        AudioWant.nper_min = 4
        AudioWant.nper_max = 4
        r = Audio_Init()
        IfCondition LessThan(r, 0) ThenBlock: {
            PrintMessage("wave_play: card busy, ring only\n")
            ReturnValue(0)
        }
        per = AudioState.period_size
        IfCondition LessThan(per, 1) ThenBlock: { per = 256 }
        IfCondition GreaterThan(per, 1024) ThenBlock: { per = 256 }
        Wp.period = per
        Wp.cardbuf = Allocate(Multiply(per, 4))
        Wp.stat = Allocate(152)
        IfCondition EqualTo(Wp.nap, 0) ThenBlock: {
            Wp.nap = Allocate(16)
            MemorySet(Wp.nap, 0, 16)
            StoreValue(Add(Wp.nap, 8), 2000000)
        }
        Wp.card = 1
        PrintMessage("wave_play card period ")
        PrintNumber(per)
        PrintMessage(" frames, 48000 Hz, /dev/snd/pcmC0D0p\n")
        ReturnValue(1)
    }
}

Function.Wp.PlayCard {
    Body: {
        at = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            IfCondition GreaterEqual(at, Wp.nframes) ThenBlock: { state = 0 }
            ElseBlock: {
                Wp.Wait()
                MemorySet(Wp.cardbuf, 0, Multiply(Wp.period, 4))
                n = Wp.period
                left = Subtract(Wp.nframes, at)
                IfCondition LessThan(left, n) ThenBlock: { n = left }
                i = 0
                WhileLoop LessThan(i, n) {
                    src = Add(Wp.stereo, Multiply(Add(at, i), 4))
                    dst = Add(Wp.cardbuf, Multiply(i, 4))
                    SetByte(dst, 0, GetByte(src, 0))
                    SetByte(dst, 1, GetByte(src, 1))
                    SetByte(dst, 2, GetByte(src, 2))
                    SetByte(dst, 3, GetByte(src, 3))
                    i = Add(i, 1)
                }
                spinning = 1
                WhileLoop EqualTo(spinning, 1) {
                    wr = Audio_WriteFrames(Wp.cardbuf, Wp.period)
                    IfCondition LessThan(wr, 0) ThenBlock: {
                        PrintMessage("wave_play: write failed\n")
                        spinning = 0
                        state = 0
                    } ElseBlock: {
                        IfCondition LessThan(wr, 1) ThenBlock: {
                            SystemCall(35, Wp.nap, 0, 0)
                        } ElseBlock: {
                            spinning = 0
                        }
                    }
                }
                at = Add(at, n)
            }
        }
        Audio_Shutdown()
    }
}

SubRoutine.Main {
    Arena_Init()
    ok = Wp.Args()
    IfCondition EqualTo(ok, 0) ThenBlock: {
        PrintMessage("usage: wave_play ring.pcm.bin file.wav\n")
        SystemCall(60, 1, 0, 0)
    }
    ok = Wp.Load()
    IfCondition EqualTo(ok, 0) ThenBlock: { SystemCall(60, 1, 0, 0) }
    pcm = Wp.Map()
    IfCondition EqualTo(pcm, 0) ThenBlock: {
        PrintMessage("wave_play: cannot open ring\n")
        SystemCall(60, 1, 0, 0)
    }
    opened = Wp.OpenCard()
    IfCondition EqualTo(opened, 1) ThenBlock: {
        Wp.PlayCard()
        PrintMessage("wave_play: ")
        PrintNumber(Wp.nframes)
        PrintMessage(" frames\n")
        SystemCall(60, 0, 0, 0)
    }
    at = 0
    WhileLoop LessThan(at, Wp.nframes) {
        n = 256
        left = Subtract(Wp.nframes, at)
        IfCondition LessThan(left, n) ThenBlock: { n = left }
        src = Add(Wp.stereo, Multiply(at, 4))
        put = Wp.Push(pcm, src, n)
        IfCondition EqualTo(put, 1) ThenBlock: {
            at = Add(at, n)
        } ElseBlock: {
            Wp.Nap()
        }
    }
    PrintMessage("wave_play: ")
    PrintNumber(Wp.nframes)
    PrintMessage(" frames\n")
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
