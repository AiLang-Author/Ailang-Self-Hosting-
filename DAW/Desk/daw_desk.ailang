Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

FixedPool.DawDesk {
    "run":  Initialize=1, CanChange=True
    "win":  Initialize=-1, CanChange=True
    "px":   Initialize=0, CanChange=True
    "py":   Initialize=0, CanChange=True
    "pb":   Initialize=0, CanChange=True
    "seq":   Initialize=0, CanChange=True
    "nap":   Initialize=0, CanChange=True
    "front": Initialize=0, CanChange=True
    "back":  Initialize=0, CanChange=True
    "grab":  Initialize=0, CanChange=True
    "goff":  Initialize=0, CanChange=True
    "fadr":  Initialize=0, CanChange=True
    "play":  Initialize=0, CanChange=True
    "mode":  Initialize=0, CanChange=True
    "ptr":   Initialize=0, CanChange=True
    "kseq":  Initialize=0, CanChange=True
    "lv":    Initialize=0, CanChange=True
    "lseq":  Initialize=0, CanChange=True
    "rv":    Initialize=0, CanChange=True
    "rseq":  Initialize=0, CanChange=True
    "eqp":   Initialize=0, CanChange=True
    "eqt":   Initialize=0, CanChange=True
    "recpid": Initialize=0, CanChange=True
    "playpid": Initialize=0, CanChange=True
    "hearpid": Initialize=0, CanChange=True
    "wav":   Initialize=0, CanChange=True
    "wavbuf": Initialize=0, CanChange=True
}

Function.DawDesk.Put {
    Input: buf: Address
    Input: off: Integer
    Input: v: Integer
    Output: Integer
    Body: {
        SetByte(buf, off, BitwiseAnd(v, 255))
        SetByte(buf, Add(off, 1), BitwiseAnd(ShiftRight(v, 8), 255))
        SetByte(buf, Add(off, 2), BitwiseAnd(ShiftRight(v, 16), 255))
        SetByte(buf, Add(off, 3), BitwiseAnd(ShiftRight(v, 24), 255))
        ReturnValue(0)
    }
}

Function.DawDesk.Levels {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawDesk.lv, 0) ThenBlock: { ReturnValue(0) }
        DawDesk.lseq = Add(DawDesk.lseq, 1)
        buf = DawDesk.lv
        DawDesk.Put(buf, 0, 827019852)
        DawDesk.Put(buf, 4, DawDesk.lseq)
        DawDesk.Put(buf, 8, DawTracks.n)
        DawDesk.Put(buf, 12, DawLevel.Gain(DawCon.ml))
        DawDesk.Put(buf, 16, DawLevel.Gain(DawCon.mr))
        noff = PoolFieldOffset(LinkagePool.DawTrack, "next")
        fat = PoolFieldOffset(LinkagePool.DawTrack, "fader")
        mat = PoolFieldOffset(LinkagePool.DawTrack, "mute")
        sat = PoolFieldOffset(LinkagePool.DawTrack, "solo")
        cur = DawTracks.head
        off = 20
        WhileLoop NotEqual(cur, 0) {
            fp = Dereference(Add(cur, fat))
            DawDesk.Put(buf, off, DawLevel.Gain(fp))
            DawDesk.Put(buf, Add(off, 4), Dereference(Add(cur, mat)))
            DawDesk.Put(buf, Add(off, 8), Dereference(Add(cur, sat)))
            off = Add(off, 12)
            cur = Dereference(Add(cur, noff))
        }
        DawDesk.Put(buf, off, DawDesk.lseq)
        fd = SystemCall(2, "/dev/shm/daw/levels.bin", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(1, fd, buf, Add(off, 4))
        SystemCall(3, fd, 0, 0)
        ReturnValue(1)
    }
}

Function.DawDesk.TrackOut {
    Input: track: Address
    Output: Address
    Body: {
        off = PoolFieldOffset(LinkagePool.DawPort, "next")
        tat = PoolFieldOffset(LinkagePool.DawPort, "track")
        dat = PoolFieldOffset(LinkagePool.DawPort, "dir")
        cur = DawRoute.ports
        found = 0
        WhileLoop NotEqual(cur, 0) {
            IfCondition EqualTo(found, 0) ThenBlock: {
                tr = Dereference(Add(cur, tat))
                dir = Dereference(Add(cur, dat))
                IfCondition EqualTo(tr, track) ThenBlock: {
                    IfCondition EqualTo(dir, 1) ThenBlock: { found = cur }
                }
            }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(found)
    }
}

Function.DawDesk.Hears {
    Input: track: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(DawRoute.mst_in, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(DawRoute.conns, 0) ThenBlock: { ReturnValue(1) }
        outp = DawDesk.TrackOut(track)
        IfCondition EqualTo(outp, 0) ThenBlock: { ReturnValue(1) }
        hit = DawRoute.Reaches(outp, DawRoute.mst_in, 32)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        soff = PoolFieldOffset(LinkagePool.DawConn, "src")
        doff = PoolFieldOffset(LinkagePool.DawConn, "dst")
        koff = PoolFieldOffset(LinkagePool.DawConn, "kind")
        toff = PoolFieldOffset(LinkagePool.DawPort, "track")
        ooff = PoolFieldOffset(LinkagePool.DawPort, "owner")
        cur = DawRoute.conns
        WhileLoop NotEqual(cur, 0) {
            kk = Dereference(Add(cur, koff))
            IfCondition EqualTo(kk, 2) ThenBlock: {
                sp = Dereference(Add(cur, soff))
                dp = Dereference(Add(cur, doff))
                IfCondition NotEqual(sp, 0) ThenBlock: {
                    IfCondition EqualTo(Dereference(Add(sp, toff)), track) ThenBlock: {
                        IfCondition NotEqual(dp, 0) ThenBlock: {
                            IfCondition EqualTo(Dereference(Add(dp, ooff)), 3) ThenBlock: {
                                ReturnValue(1)
                            }
                        }
                    }
                }
            }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawDesk.Route {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawDesk.rv, 0) ThenBlock: { ReturnValue(0) }
        DawDesk.rseq = Add(DawDesk.rseq, 1)
        buf = DawDesk.rv
        DawDesk.Put(buf, 0, 827019853)
        DawDesk.Put(buf, 4, DawDesk.rseq)
        DawDesk.Put(buf, 8, DawTracks.n)
        noff = PoolFieldOffset(LinkagePool.DawTrack, "next")
        fat = PoolFieldOffset(LinkagePool.DawTrack, "fx")
        cur = DawTracks.head
        off = 12
        WhileLoop NotEqual(cur, 0) {
            hear = DawDesk.Hears(cur)
            wet = 0
            fx = Dereference(Add(cur, fat))
            IfCondition EqualTo(fx, 1) ThenBlock: { wet = 1 }
            DawDesk.Put(buf, off, hear)
            DawDesk.Put(buf, Add(off, 4), wet)
            off = Add(off, 8)
            cur = Dereference(Add(cur, noff))
        }
        DawDesk.Put(buf, off, DawDesk.rseq)
        fd = SystemCall(2, "/dev/shm/daw/route.bin", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(1, fd, buf, Add(off, 4))
        SystemCall(3, fd, 0, 0)
        ReturnValue(1)
    }
}

Function.DawDesk.EqStop {
    Input: slot: Integer
    Body: {
        at = Multiply(slot, 8)
        pid = Dereference(Add(DawDesk.eqp, at))
        IfCondition GreaterThan(pid, 0) ThenBlock: { DawDesk.Stop(pid) }
        StoreValue(Add(DawDesk.eqp, at), 0)
        StoreValue(Add(DawDesk.eqt, at), 0)
    }
}

Function.DawDesk.EqSync {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawDesk.eqp, 0) ThenBlock: { ReturnValue(0) }
        noff = PoolFieldOffset(LinkagePool.DawTrack, "next")
        fat = PoolFieldOffset(LinkagePool.DawTrack, "fx")
        s = 0
        WhileLoop LessThan(s, 16) {
            at = Multiply(s, 8)
            tr = Dereference(Add(DawDesk.eqt, at))
            IfCondition NotEqual(tr, 0) ThenBlock: {
                still = 0
                cur = DawTracks.head
                WhileLoop NotEqual(cur, 0) {
                    IfCondition EqualTo(cur, tr) ThenBlock: {
                        IfCondition EqualTo(Dereference(Add(cur, fat)), 1) ThenBlock: { still = 1 }
                    }
                    cur = Dereference(Add(cur, noff))
                }
                IfCondition EqualTo(still, 0) ThenBlock: { DawDesk.EqStop(s) }
                ElseBlock: {
                    pid = Dereference(Add(DawDesk.eqp, at))
                    IfCondition GreaterThan(pid, 0) ThenBlock: {
                        alive = SystemCall(62, pid, 0, 0, 0, 0)
                        IfCondition LessThan(alive, 0) ThenBlock: { DawDesk.EqStop(s) }
                    }
                }
            }
            s = Add(s, 1)
        }
        cur = DawTracks.head
        WhileLoop NotEqual(cur, 0) {
            IfCondition EqualTo(Dereference(Add(cur, fat)), 1) ThenBlock: {
                have = 0
                s = 0
                WhileLoop LessThan(s, 16) {
                    at = Multiply(s, 8)
                    IfCondition EqualTo(Dereference(Add(DawDesk.eqt, at)), cur) ThenBlock: { have = 1 }
                    s = Add(s, 1)
                }
                IfCondition EqualTo(have, 0) ThenBlock: {
                    s = 0
                    slot = -1
                    WhileLoop LessThan(s, 16) {
                        at = Multiply(s, 8)
                        IfCondition EqualTo(slot, -1) ThenBlock: {
                            IfCondition EqualTo(Dereference(Add(DawDesk.eqt, at)), 0) ThenBlock: { slot = s }
                        }
                        s = Add(s, 1)
                    }
                    IfCondition GreaterEqual(slot, 0) ThenBlock: {
                        DawEq.tr = cur
                        DawEq.Dirs()
                        dirp = DawEq.Dir("fx/0")
                        IfCondition NotEqual(dirp, 0) ThenBlock: {
                            pid = DawDesk.Spawn("/home/bob/Ailang-Self-Hosting-/DAW/Effects/eq", dirp, 0)
                            Deallocate(dirp, 160)
                            IfCondition GreaterThan(pid, 0) ThenBlock: {
                                at = Multiply(slot, 8)
                                StoreValue(Add(DawDesk.eqp, at), pid)
                                StoreValue(Add(DawDesk.eqt, at), cur)
                            }
                        }
                    }
                }
            }
            cur = Dereference(Add(cur, noff))
        }
        ReturnValue(1)
    }
}

Function.DawDesk.Stop {
    Input: pid: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(pid, 0) ThenBlock: {
            SystemCall(62, pid, 15, 0, 0, 0)
        }
        ReturnValue(0)
    }
}

Function.DawDesk.Spawn {
    Input: bin: Address
    Input: a1: Address
    Input: a2: Address
    Output: Integer
    Body: {
        argv = Allocate(32)
        StoreValue(argv, bin)
        StoreValue(Add(argv, 8), a1)
        slot = 16
        IfCondition NotEqual(a2, 0) ThenBlock: {
            StoreValue(Add(argv, 16), a2)
            slot = 24
        }
        StoreValue(Add(argv, slot), 0)
        envp = Allocate(8)
        StoreValue(envp, 0)
        pid = SystemCall(57, 0, 0, 0, 0, 0)
        IfCondition EqualTo(pid, 0) ThenBlock: {
            SystemCall(59, bin, argv, envp, 0, 0)
            SystemCall(60, 127, 0, 0, 0, 0)
        }
        Deallocate(argv, 32)
        Deallocate(envp, 8)
        IfCondition LessThan(pid, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(pid)
    }
}

Function.DawDesk.TakeDrop {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawDesk.wavbuf, 0) ThenBlock: { ReturnValue(0) }
        fd = SystemCall(2, "/dev/shm/daw/drop.txt", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        n = SystemCall(0, fd, DawDesk.wavbuf, 500)
        SystemCall(3, fd, 0, 0)
        IfCondition LessThan(n, 4) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(DawDesk.wavbuf, Subtract(n, 1)), 10) ThenBlock: {
            n = Subtract(n, 1)
        }
        SetByte(DawDesk.wavbuf, n, 0)
        DawDesk.wav = DawDesk.wavbuf
        fd = SystemCall(2, "/dev/shm/daw/drop.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: { SystemCall(3, fd, 0, 0) }
        ReturnValue(1)
    }
}

Function.DawDesk.U32 {
    Input: buf: Address
    Input: off: Integer
    Output: Integer
    Body: {
        b0 = GetByte(buf, off)
        b1 = GetByte(buf, Add(off, 1))
        b2 = GetByte(buf, Add(off, 2))
        b3 = GetByte(buf, Add(off, 3))
        v = BitwiseOr(b0, ShiftLeft(b1, 8))
        v = BitwiseOr(v, ShiftLeft(b2, 16))
        v = BitwiseOr(v, ShiftLeft(b3, 24))
        ReturnValue(v)
    }
}

Function.DawDesk.InWin {
    Input: idx: Integer
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        live = AppDesk.Get(idx, AppDeskWin.LIVE)
        IfCondition NotEqual(live, 1) ThenBlock: { ReturnValue(0) }
        wx = AppDesk.Get(idx, AppDeskWin.X)
        wy = AppDesk.Get(idx, AppDeskWin.Y)
        ww = AppDesk.Get(idx, AppDeskWin.W)
        wh = AppDesk.Get(idx, AppDeskWin.H)
        IfCondition LessThan(px, wx) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(py, wy) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, Add(wx, ww)) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(py, Add(wy, wh)) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.DawDesk.Floating {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        hit = DawDesk.InWin(DawLay.routew, px, py)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = DawDesk.InWin(DawLay.editw, px, py)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = DawDesk.InWin(DawLay.mixw, px, py)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = DawDesk.InWin(DawLay.insw, px, py)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = DawDesk.InWin(DawDock.syw, px, py)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = DawDesk.InWin(DawDock.saw, px, py)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = DawDesk.InWin(DawDock.eqw, px, py)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        hit = DawDesk.InWin(DawDock.cpw, px, py)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.DawDesk.Poll {
    Output: Integer
    Body: {
        fd = SystemCall(2, "/dev/shm/daw/pointer.bin", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = DawDesk.ptr
        IfCondition EqualTo(buf, 0) ThenBlock: {
            buf = Allocate(24)
            DawDesk.ptr = buf
        }
        n = SystemCall(0, fd, buf, 24)
        SystemCall(3, fd, 0, 0)
        IfCondition LessThan(n, 16) ThenBlock: { ReturnValue(0) }
        x = DawDesk.U32(buf, 0)
        y = DawDesk.U32(buf, 4)
        b = DawDesk.U32(buf, 8)
        seq = DawDesk.U32(buf, 12)
        cmd = 0
        ks = 0
        IfCondition GreaterEqual(n, 24) ThenBlock: {
            cmd = DawDesk.U32(buf, 16)
            ks = DawDesk.U32(buf, 20)
        }
        IfCondition EqualTo(seq, DawDesk.seq) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ks, DawDesk.kseq) ThenBlock: {
            DawDesk.kseq = ks
            IfCondition NotEqual(cmd, 0) ThenBlock: {
                DawClip.Command(cmd)
            }
        }
        over_route = DawDesk.InWin(DawLay.routew, x, y)
        IfCondition EqualTo(over_route, 1) ThenBlock: {
            DawEdit.hp = -1
        }
        ElseBlock: {
            DawEditor.Hover(x, y)
        }
        DawDock.Watch(x, y)
        DawMenu.Hover(x, y)
        DawFile.Hover(x, y)
        DawRoute.Hover(x, y)
        DawAsk.Hover(x, y)
        DawSong.Hover(x, y)
        DawPick.Hover(x, y)
        IfCondition EqualTo(b, 2) ThenBlock: {
            songm = DawSong.Up()
            IfCondition EqualTo(songm, 1) ThenBlock: {
                DawSong.Cancel()
                DawDesk.px = x
                DawDesk.py = y
                DawDesk.pb = b
                DawDesk.seq = seq
                ReturnValue(1)
            }
            IfCondition EqualTo(DawFile.on, 1) ThenBlock: {
                DawFile.on = 0
                DawDesk.px = x
                DawDesk.py = y
                DawDesk.pb = b
                DawDesk.seq = seq
                ReturnValue(1)
            }
            IfCondition EqualTo(DawPick.on, 1) ThenBlock: {
                DawPick.on = 0
                DawDesk.px = x
                DawDesk.py = y
                DawDesk.pb = b
                DawDesk.seq = seq
                ReturnValue(1)
            }
            IfCondition EqualTo(DawAsk.on, 1) ThenBlock: {
                DawAsk.on = 0
                DawDesk.px = x
                DawDesk.py = y
                DawDesk.pb = b
                DawDesk.seq = seq
                ReturnValue(1)
            }
            IfCondition NotEqual(DawDesk.pb, 2) ThenBlock: {
                route_eat = 0
                IfCondition GreaterEqual(DawLay.routew, 0) ThenBlock: {
                    rlive = AppDesk.Get(DawLay.routew, AppDeskWin.LIVE)
                    IfCondition EqualTo(rlive, 1) ThenBlock: {
                        rx = AppDesk.Get(DawLay.routew, AppDeskWin.X)
                        ry = AppDesk.Get(DawLay.routew, AppDeskWin.Y)
                        rw = AppDesk.Get(DawLay.routew, AppDeskWin.W)
                        rh = AppDesk.Get(DawLay.routew, AppDeskWin.H)
                        IfCondition GreaterEqual(x, rx) ThenBlock: {
                            IfCondition GreaterEqual(y, ry) ThenBlock: {
                                IfCondition LessThan(x, Add(rx, rw)) ThenBlock: {
                                    IfCondition LessThan(y, Add(ry, rh)) ThenBlock: {
                                        DawRoute.Right(x, y)
                                        route_eat = 1
                                    }
                                }
                            }
                        }
                    }
                }
                IfCondition EqualTo(route_eat, 1) ThenBlock: {
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
                hit = DawArrange.Pick(x, y)
                IfCondition NotEqual(hit, 0) ThenBlock: {
                    DawBoard.sel = hit
                    lane = DawArrange.PickTrack(x, y)
                    IfCondition NotEqual(lane, 0) ThenBlock: {
                        DawTracks.sel = lane
                    }
                }
                DawMenu.Open(x, y)
                DawMenu.Hover(x, y)
            }
            DawDesk.px = x
            DawDesk.py = y
            DawDesk.pb = b
            DawDesk.seq = seq
            ReturnValue(1)
        }
        IfCondition EqualTo(b, 1) ThenBlock: {
            IfCondition EqualTo(DawDesk.pb, 0) ThenBlock: {
                IfCondition EqualTo(DawRoute.menu, 1) ThenBlock: {
                    inn = DawRoute.Inside(x, y)
                    IfCondition EqualTo(inn, 0) ThenBlock: { DawRoute.Cancel() }
                }
                ElseBlock: {
                    IfCondition GreaterEqual(DawRoute.gkind, 0) ThenBlock: {
                        inn = DawRoute.Inside(x, y)
                        IfCondition EqualTo(inn, 0) ThenBlock: { DawRoute.Cancel() }
                    }
                }
                IfCondition EqualTo(DawPick.on, 1) ThenBlock: {
                    pick = DawPick.Hit(x, y)
                    mode = DawPick.mode
                    who = DawPick.tr
                    DawPick.on = 0
                    IfCondition NotEqual(pick, 0) ThenBlock: {
                        IfCondition EqualTo(mode, 1) ThenBlock: {
                            DawTrack.Use(who, pick)
                            DawTracks.sel = who
                            DawEditor.Show(who)
                        }
                        IfCondition EqualTo(mode, 2) ThenBlock: {
                            IfCondition EqualTo(pick, 1) ThenBlock: {
                                DawTrack.SetFx(who, 1)
                                DawTracks.sel = who
                                DawDock.Show(3)
                            }
                            IfCondition EqualTo(pick, 2) ThenBlock: {
                                DawTrack.SetFx(who, 2)
                                DawTracks.sel = who
                                DawDock.Show(4)
                            }
                            IfCondition EqualTo(pick, 3) ThenBlock: {
                                DawTrack.SetFx(who, 0)
                            }
                        }
                    }
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
                songm = DawSong.Up()
                IfCondition EqualTo(songm, 1) ThenBlock: {
                    DawSong.Hit(x, y)
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
                IfCondition EqualTo(DawFile.on, 1) ThenBlock: {
                    item = DawFile.Hit(x, y)
                    DawFile.on = 0
                    IfCondition EqualTo(item, 1) ThenBlock: { DawSong.NewAsk() }
                    IfCondition EqualTo(item, 2) ThenBlock: { DawSong.OpenAsk() }
                    IfCondition EqualTo(item, 3) ThenBlock: { DawSong.Save() }
                    IfCondition EqualTo(item, 4) ThenBlock: { DawSong.Close() }
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
                IfCondition EqualTo(DawAsk.on, 1) ThenBlock: {
                    pick = DawAsk.Hit(x, y)
                    DawAsk.on = 0
                    IfCondition NotEqual(pick, 0) ThenBlock: {
                        DawDesk.AddKind(pick)
                    }
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
                IfCondition EqualTo(DawMenu.on, 1) ThenBlock: {
                    item = DawMenu.Hit(x, y)
                    DawMenu.on = 0
                    IfCondition NotEqual(item, 0) ThenBlock: {
                        DawClip.Command(item)
                    }
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(b, 0) ThenBlock: {
            IfCondition EqualTo(DawDesk.mode, 4) ThenBlock: {
                DawArrange.Scrub(x)
            }
            IfCondition EqualTo(DawDesk.mode, 11) ThenBlock: {
                DawEditor.Release(x, y)
            }
            IfCondition EqualTo(DawDesk.mode, 7) ThenBlock: { AppDesk.Up() }
            IfCondition EqualTo(DawDesk.mode, 14) ThenBlock: {
                DawRoute.Release(x, y)
            }
            IfCondition EqualTo(DawDesk.mode, 15) ThenBlock: {
                DawRoute.sdrag = 0
            }
            IfCondition EqualTo(DawDesk.mode, 16) ThenBlock: { DawEq.Up() }
            DawDesk.grab = 0
            DawDesk.fadr = 0
            DawDesk.mode = 0
        }
        IfCondition EqualTo(DawDock.on, 1) ThenBlock: {
            IfCondition GreaterEqual(x, DawDock.Left()) ThenBlock: {
                IfCondition EqualTo(b, 1) ThenBlock: {
                    IfCondition EqualTo(DawDesk.pb, 0) ThenBlock: {
                        dk = DawDock.Hit(x, y)
                        IfCondition NotEqual(dk, 0) ThenBlock: { DawDock.Toggle(dk) }
                        DawDesk.px = x
                        DawDesk.py = y
                        DawDesk.pb = b
                        DawDesk.seq = seq
                        ReturnValue(1)
                    }
                }
                IfCondition EqualTo(DawDesk.mode, 0) ThenBlock: {
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(b, 1) ThenBlock: {
            IfCondition EqualTo(DawDesk.pb, 0) ThenBlock: {
                lay = 0
                covered = DawDesk.Floating(x, y)
                IfCondition EqualTo(covered, 0) ThenBlock: {
                    lay = DawLayout.Hit(x, y)
                }
                IfCondition EqualTo(lay, 1) ThenBlock: {
                    IfCondition EqualTo(DawLay.edit, 1) ThenBlock: { DawLay.edit = 0 }
                    ElseBlock: { DawLay.edit = 1 }
                }
                IfCondition EqualTo(lay, 2) ThenBlock: {
                    IfCondition EqualTo(DawLay.mix, 1) ThenBlock: { DawLay.mix = 0 }
                    ElseBlock: { DawLay.mix = 1 }
                }
                IfCondition EqualTo(lay, 3) ThenBlock: {
                    IfCondition EqualTo(DawLay.ins, 1) ThenBlock: { DawLay.ins = 0 }
                    ElseBlock: { DawLay.ins = 1 }
                }
                IfCondition EqualTo(lay, 4) ThenBlock: {
                    IfCondition EqualTo(DawLay.route, 1) ThenBlock: { DawLay.route = 0 }
                    ElseBlock: { DawLay.route = 1 }
                }
                IfCondition EqualTo(lay, 5) ThenBlock: { DawLayout.Restore() }
                IfCondition NotEqual(lay, 0) ThenBlock: {
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
                chrome = AppDesk.Down(x, y)
                IfCondition EqualTo(chrome, 1) ThenBlock: {
                    IfCondition NotEqual(AppDesk.hit_idx, DawDesk.win) ThenBlock: {
                        DawDesk.mode = 13
                        IfCondition EqualTo(AppDesk.hit_idx, DawLay.insw) ThenBlock: {
                            ih = DawInspect.Hit(x, y)
                            IfCondition EqualTo(ih, 1) ThenBlock: {
                                IfCondition NotEqual(DawTracks.sel, 0) ThenBlock: {
                                    kind_at = PoolFieldOffset(LinkagePool.DawTrack, "kind")
                                    kindv = Dereference(Add(DawTracks.sel, kind_at))
                                    IfCondition EqualTo(kindv, 1) ThenBlock: { DawDock.Show(1) }
                                    ElseBlock: { DawDock.Show(2) }
                                }
                            }
                            IfCondition EqualTo(ih, 2) ThenBlock: { DawDock.Show(3) }
                            DawDesk.px = x
                            DawDesk.py = y
                            DawDesk.pb = b
                            DawDesk.seq = seq
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(AppDesk.hit_idx, DawLay.editw) ThenBlock: {
                            DawEditor.Press(x, y)
                            DawDesk.mode = 11
                            DawDesk.px = x
                            DawDesk.py = y
                            DawDesk.pb = b
                            DawDesk.seq = seq
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(AppDesk.hit_idx, DawLay.mixw) ThenBlock: {
                            fad = DawConsole.Pick(x, y)
                            IfCondition EqualTo(DawCon.part, 5) ThenBlock: {
                                DawDesk.mode = 12
                                DawConsole.DragH(x)
                                DawDesk.px = x
                                DawDesk.py = y
                                DawDesk.pb = b
                                DawDesk.seq = seq
                                ReturnValue(1)
                            }
                            IfCondition EqualTo(DawCon.part, 6) ThenBlock: { DawTrack.Flip(fad, 1) }
                            IfCondition EqualTo(DawCon.part, 7) ThenBlock: { DawTrack.Flip(fad, 2) }
                            IfCondition EqualTo(DawCon.part, 8) ThenBlock: { DawTrack.Flip(fad, 3) }
                            IfCondition EqualTo(DawCon.part, 9) ThenBlock: {
                                DawTracks.sel = fad
                                DawEditor.Show(fad)
                                kind_at = PoolFieldOffset(LinkagePool.DawTrack, "kind")
                                kindv = Dereference(Add(fad, kind_at))
                                IfCondition EqualTo(kindv, 1) ThenBlock: { DawDock.Show(1) }
                                ElseBlock: { DawDock.Show(2) }
                            }
                            IfCondition EqualTo(DawCon.part, 10) ThenBlock: {
                                DawTracks.sel = fad
                                DawPick.Open(x, y, 2, fad)
                            }
                            IfCondition GreaterEqual(DawCon.part, 6) ThenBlock: {
                                DawDesk.px = x
                                DawDesk.py = y
                                DawDesk.pb = b
                                DawDesk.seq = seq
                                ReturnValue(1)
                            }
                            IfCondition NotEqual(fad, 0) ThenBlock: {
                                DawDesk.fadr = fad
                                DawDesk.mode = 5
                                IfCondition EqualTo(DawCon.part, 2) ThenBlock: {
                                    DawDesk.mode = 10
                                }
                                IfCondition EqualTo(DawCon.part, 3) ThenBlock: {
                                    DawDesk.mode = 8
                                    DawConsole.SetMaster(3, y)
                                }
                                IfCondition EqualTo(DawCon.part, 4) ThenBlock: {
                                    DawDesk.mode = 8
                                    DawConsole.SetMaster(4, y)
                                }
                                IfCondition EqualTo(DawCon.part, 1) ThenBlock: {
                                    DawConsole.SetFader(fad, y)
                                }
                            }
                        }
                        IfCondition EqualTo(AppDesk.hit_idx, DawLay.routew) ThenBlock: {
                            DawRoute.Press(x, y)
                            IfCondition EqualTo(DawRoute.arm, 1) ThenBlock: {
                                DawDesk.mode = 14
                            }
                            IfCondition EqualTo(DawRoute.sdrag, 1) ThenBlock: {
                                DawDesk.mode = 15
                            }
                            DawDesk.px = x
                            DawDesk.py = y
                            DawDesk.pb = b
                            DawDesk.seq = seq
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(AppDesk.hit_idx, DawDock.eqw) ThenBlock: {
                            grabbed = DawEq.Press(x, y)
                            IfCondition EqualTo(grabbed, 1) ThenBlock: { DawDesk.mode = 16 }
                            DawDesk.px = x
                            DawDesk.py = y
                            DawDesk.pb = b
                            DawDesk.seq = seq
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(DawDesk.mode, 0) ThenBlock: {
                            DawDesk.mode = 13
                        }
                        DawDesk.px = x
                        DawDesk.py = y
                        DawDesk.pb = b
                        DawDesk.seq = seq
                        ReturnValue(1)
                    }
                }
                IfCondition GreaterEqual(chrome, 2) ThenBlock: {
                    IfCondition EqualTo(chrome, 3) ThenBlock: {
                        IfCondition EqualTo(AppDesk.hit_idx, DawLay.editw) ThenBlock: { DawLay.edit = 0 }
                        IfCondition EqualTo(AppDesk.hit_idx, DawLay.mixw) ThenBlock: { DawLay.mix = 0 }
                        IfCondition EqualTo(AppDesk.hit_idx, DawLay.insw) ThenBlock: { DawLay.ins = 0 }
                        IfCondition EqualTo(AppDesk.hit_idx, DawLay.routew) ThenBlock: { DawLay.route = 0 }
                        DawDock.NoteClosed(AppDesk.hit_idx)
                    }
                    DawDesk.mode = 7
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
                cmd = DawTransport.Hit(x, y)
                IfCondition EqualTo(cmd, 1) ThenBlock: {
                    DawTracks.play = Subtract(DawTracks.play, 80)
                    DawTransport.Clamp()
                }
                IfCondition EqualTo(cmd, 2) ThenBlock: {
                    DawDesk.play = 0
                    DawDesk.Stop(DawDesk.playpid)
                    DawDesk.Stop(DawDesk.hearpid)
                    DawDesk.playpid = 0
                    DawDesk.hearpid = 0
                }
                IfCondition EqualTo(cmd, 3) ThenBlock: {
                    DawDesk.play = 1
                    view_at = PoolFieldOffset(LinkagePool.DawTrack, "view")
                    is_wave = 0
                    IfCondition NotEqual(DawTracks.sel, 0) ThenBlock: {
                        vv = Dereference(Add(DawTracks.sel, view_at))
                        IfCondition EqualTo(vv, 0) ThenBlock: { is_wave = 1 }
                    }
                    IfCondition EqualTo(is_wave, 1) ThenBlock: {
                        IfCondition NotEqual(DawDesk.wav, 0) ThenBlock: {
                            DawDesk.Stop(DawDesk.playpid)
                            DawDesk.Stop(DawDesk.hearpid)
                            DawDesk.playpid = DawDesk.Spawn("/home/bob/Ailang-Self-Hosting-/DAW/Mixer/wave_play", "/dev/shm/daw/wplay/pcm.bin", DawDesk.wav)
                            DawDesk.hearpid = 0
                        }
                    }
                }
                IfCondition EqualTo(cmd, 4) ThenBlock: {
                    DawTracks.play = Add(DawTracks.play, 80)
                    DawTransport.Clamp()
                }
                IfCondition EqualTo(cmd, 5) ThenBlock: {
                    IfCondition EqualTo(DawTrans.rec, 1) ThenBlock: {
                        DawTrans.rec = 0
                        DawDesk.Stop(DawDesk.recpid)
                        DawDesk.recpid = 0
                        DawDesk.wav = "/home/bob/Ailang-Self-Hosting-/DAW/Takes/rec.wav"
                    }
                    ElseBlock: {
                        DawTrans.rec = 1
                        IfCondition EqualTo(DawTrack.AnyArm(), 0) ThenBlock: {
                            IfCondition NotEqual(DawTracks.sel, 0) ThenBlock: {
                                DawTrack.Flip(DawTracks.sel, 1)
                            }
                        }
                        DawDesk.Stop(DawDesk.recpid)
                        DawDesk.recpid = 0
                    }
                }
                IfCondition NotEqual(cmd, 0) ThenBlock: {
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
                kind = DawArrange.Hit(x, y)
                IfCondition EqualTo(kind, 1) ThenBlock: {
                    DawDesk.mode = 2
                    DawArrange.DragH(x)
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
                IfCondition EqualTo(kind, 2) ThenBlock: {
                    DawDesk.mode = 3
                    DawArrange.DragV(y)
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
                IfCondition EqualTo(kind, 7) ThenBlock: {
                    DawAsk.Open()
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
                IfCondition EqualTo(kind, 8) ThenBlock: {
                    DawTrack.Remove(DawTracks.sel)
                    DawBoard.sel = 0
                    DawArrange.Clamp()
                    DawConsole.Clamp()
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
                IfCondition EqualTo(kind, 13) ThenBlock: {
                    drop = Add(DawFile.by, 16)
                    DawFile.Open(DawFile.bx, drop)
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
                IfCondition EqualTo(kind, 6) ThenBlock: {
                    DawDesk.mode = 6
                    DawArrange.ZoomAt(x)
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
                IfCondition EqualTo(kind, 3) ThenBlock: {
                    DawDesk.mode = 4
                    DawArrange.Scrub(x)
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
                mixb = DawArrange.HitMix(x, y)
                IfCondition NotEqual(mixb, 0) ThenBlock: {
                    DawTrack.Flip(DawArr.htr, mixb)
                    DawDesk.mode = 9
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
                named = DawArrange.HitName(x, y)
                IfCondition NotEqual(named, 0) ThenBlock: {
                    DawTracks.sel = named
                    DawEditor.Show(named)
                    DawPick.Open(x, y, 1, named)
                    DawDesk.px = x
                    DawDesk.py = y
                    DawDesk.pb = b
                    DawDesk.seq = seq
                    ReturnValue(1)
                }
                lane = DawArrange.PickTrack(x, y)
                IfCondition NotEqual(lane, 0) ThenBlock: {
                    IfCondition NotEqual(lane, DawTracks.sel) ThenBlock: {
                        DawTracks.sel = lane
                        DawEditor.Show(lane)
                    }
                    IfCondition LessThan(x, DawArr.ox) ThenBlock: {
                        DawDesk.mode = 9
                        DawDesk.px = x
                        DawDesk.py = y
                        DawDesk.pb = b
                        DawDesk.seq = seq
                        ReturnValue(1)
                    }
                }
                hit = DawArrange.Pick(x, y)
                IfCondition NotEqual(hit, 0) ThenBlock: {
                    st_at = PoolFieldOffset(LinkagePool.DawClip, "start")
                    st = Dereference(Add(hit, st_at))
                    mouse_t = DawArrange.Time(x)
                    DawDesk.grab = hit
                    DawBoard.sel = hit
                    DawDesk.goff = Subtract(mouse_t, st)
                    DawDesk.mode = 1
                }
            }
        }
        IfCondition EqualTo(DawDesk.pb, 1) ThenBlock: {
            IfCondition EqualTo(b, 1) ThenBlock: {
                IfCondition EqualTo(DawDesk.mode, 5) ThenBlock: {
                    DawConsole.SetFader(DawDesk.fadr, y)
                }
                IfCondition EqualTo(DawDesk.mode, 8) ThenBlock: {
                    DawConsole.SetMaster(DawCon.part, y)
                }
                IfCondition EqualTo(DawDesk.mode, 10) ThenBlock: {
                    DawConsole.SetPan(DawDesk.fadr, x, y)
                }
                IfCondition EqualTo(DawDesk.mode, 1) ThenBlock: {
                    mouse_t = DawArrange.Time(x)
                    ns = Subtract(mouse_t, DawDesk.goff)
                    DawClip.SetStart(DawDesk.grab, ns)
                }
                IfCondition EqualTo(DawDesk.mode, 2) ThenBlock: {
                    DawArrange.DragH(x)
                }
                IfCondition EqualTo(DawDesk.mode, 3) ThenBlock: {
                    DawArrange.DragV(y)
                }
                IfCondition EqualTo(DawDesk.mode, 6) ThenBlock: {
                    DawArrange.ZoomAt(x)
                }
                IfCondition EqualTo(DawDesk.mode, 7) ThenBlock: {
                    AppDesk.Move(x, y)
                }
                IfCondition EqualTo(DawDesk.mode, 11) ThenBlock: {
                    DawEditor.Drag(x, y)
                }
                IfCondition EqualTo(DawDesk.mode, 12) ThenBlock: {
                    DawConsole.DragH(x)
                }
                IfCondition EqualTo(DawDesk.mode, 14) ThenBlock: {
                    DawRoute.Move(x, y)
                }
                IfCondition EqualTo(DawDesk.mode, 15) ThenBlock: {
                    DawRoute.DragScroll(x)
                }
                IfCondition EqualTo(DawDesk.mode, 16) ThenBlock: {
                    DawEq.Drag(x, y)
                }
                IfCondition EqualTo(DawDesk.mode, 0) ThenBlock: {
                    dx = Subtract(DawDesk.px, x)
                    dy = Subtract(DawDesk.py, y)
                    IfCondition GreaterThan(y, 430) ThenBlock: {
                        DawConsole.Nudge(dx)
                    }
                    ElseBlock: {
                        DawArrange.Nudge(dx, dy)
                    }
                }
            }
        }
        DawDesk.px = x
        DawDesk.py = y
        DawDesk.pb = b
        DawDesk.seq = seq
        ReturnValue(1)
    }
}

Function.DawDesk.AddKind {
    Input: which: Integer
    Output: Integer
    Body: {
        neu = 0
        IfCondition EqualTo(which, 1) ThenBlock: {
            neu = DawTrack.Add("midi", 1, 1, "synth")
            IfCondition NotEqual(neu, 0) ThenBlock: {
                DawClip.Add(neu, 40, 160, 1, "midi")
            }
        }
        IfCondition EqualTo(which, 2) ThenBlock: {
            neu = DawTrack.Add("sample", 0, 1, "sample")
            IfCondition NotEqual(neu, 0) ThenBlock: {
                DawClip.Add(neu, 40, 160, 1, "sample")
            }
        }
        IfCondition EqualTo(which, 3) ThenBlock: {
            neu = DawTrack.Add("wave", 0, 0, "wave")
            IfCondition NotEqual(neu, 0) ThenBlock: {
                DawClip.Add(neu, 40, 200, 0, "wave")
            }
        }
        IfCondition EqualTo(neu, 0) ThenBlock: { ReturnValue(0) }
        DawTracks.sel = neu
        DawTracks.arr_y = DawTracks.n
        DawArrange.Clamp()
        DawEditor.Show(neu)
        DawTracks.con_y = 99999
        DawConsole.Clamp()
        ReturnValue(1)
    }
}

Function.DawDesk.Alsa {
    Output: Integer
    Body: {
        pid = DawDesk.Spawn("/home/bob/Ailang-Self-Hosting-/DAW/Desk/alsa_names", "/dev/shm/daw/alsa_io.txt", 0)
        IfCondition GreaterThan(pid, 0) ThenBlock: {
            SystemCall(61, pid, 0, 0, 0, 0)
        }
        ReturnValue(DawRoute.ApplyAlsa())
    }
}

Function.DawDesk.Seed {
    Output: Integer
    Body: {
        a = DawTrack.Add("syn1", 1, 1, "Megasynth 1")
        DawClip.Add(a, 40, 220, 1, "lead")
        DawClip.Add(a, 700, 180, 1, "lead")
        DawEditor.Seed(a, 0)
        b = DawTrack.Add("syn2", 1, 1, "Megasynth 1")
        DawClip.Add(b, 280, 160, 1, "echo")
        c = DawTrack.Add("bass", 1, 1, "Dirty Hole")
        DawClip.Add(c, 120, 400, 1, "bass")
        DawEditor.Seed(c, 1)
        d = DawTrack.Add("xylo1", 0, 1, "xylophone")
        DawClip.Add(d, 80, 260, 1, "mallet")
        DawEditor.Seed(d, 2)
        e = DawTrack.Add("xylo2", 0, 1, "xylophone")
        DawClip.Add(e, 360, 200, 1, "mallet")
        f = DawTrack.Add("glass", 0, 1, "glass")
        DawClip.Add(f, 900, 140, 1, "glass")
        g = DawTrack.Add("drums", 0, 1, "kit")
        DawClip.Add(g, 0, 640, 1, "kit")
        tw = DawTrack.Add("take", 0, 0, "wave")
        DawClip.Add(tw, 200, 300, 0, "wav")
        DawTrack.Add("pad", 1, 1, "pad")
        DawTrack.Add("guitar", 0, 0, "nylon")
        DawTrack.Add("hat", 0, 0, "kit")
        DawTrack.Add("perc", 0, 0, "kit")
        DawTrack.Add("vox", 0, 0, "vox")
        DawTrack.Add("fx", 1, 1, "fx")
        DawTrack.Add("room", 0, 0, "room")
        DawTrack.Add("sub", 1, 1, "sub")
        DawTrack.Add("lead2", 1, 1, "lead")
        DawTrack.Add("arp", 1, 1, "arp")
        DawTrack.Add("string", 0, 0, "string")
        DawTrack.Add("brass", 1, 1, "brass")
        DawRoute.Monitor()
        DawDesk.Alsa()
        DawRoute.Report()
        DawEditor.Show(a)
        ReturnValue(DawTracks.n)
    }
}

Function.DawDesk.Paint {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AppDesk.Get(idx, AppDeskWin.LIVE), 0) ThenBlock: { ReturnValue(0) }
        AppDesk.DrawChrome(idx)
        x = AppDesk.Get(idx, AppDeskWin.X)
        y = AppDesk.Get(idx, AppDeskWin.Y)
        w = AppDesk.Get(idx, AppDeskWin.W)
        h = AppDesk.Get(idx, AppDeskWin.H)
        cx = Add(x, 2)
        cy = Add(y, 26)
        cw = Subtract(w, 4)
        ch = Subtract(h, 30)
        IfCondition EqualTo(idx, DawDesk.win) ThenBlock: {
            trans = 40
            body = Subtract(ch, trans)
            DawArrange.Draw(cx, cy, cw, body)
            DawLayout.DrawTools(Add(cx, 78), Add(cy, 4))
            DawTransport.Draw(cx, Add(cy, body), cw, trans, DawDesk.play)
        }
        IfCondition EqualTo(idx, DawLay.editw) ThenBlock: {
            DawEditor.Draw(cx, cy, cw, ch)
        }
        IfCondition EqualTo(idx, DawLay.mixw) ThenBlock: {
            DawConsole.Draw(cx, cy, cw, ch)
        }
        IfCondition EqualTo(idx, DawLay.insw) ThenBlock: {
            DawInspect.Draw(cx, cy, cw, ch)
        }
        IfCondition EqualTo(idx, DawLay.routew) ThenBlock: {
            DawRoute.Draw(cx, cy, cw, ch)
        }
        IfCondition EqualTo(idx, DawDock.syw) ThenBlock: {
            DawDock.DrawSynth(cx, cy, cw, ch)
        }
        IfCondition EqualTo(idx, DawDock.saw) ThenBlock: {
            DawDock.DrawSample(cx, cy, cw, ch)
        }
        IfCondition EqualTo(idx, DawDock.eqw) ThenBlock: {
            DawDock.DrawEQ(cx, cy, cw, ch)
        }
        IfCondition EqualTo(idx, DawDock.cpw) ThenBlock: {
            DawDock.DrawComp(cx, cy, cw, ch)
        }
        ReturnValue(0)
    }
}

Function.DawDesk.Frame {
    Output: Integer
    Body: {
        FB_Clear(FB_RGB(12, 12, 14))
        DawLayout.Sync()
        zi = 0
        WhileLoop LessThan(zi, AppDesk.n) {
            DawDesk.Paint(AppDesk.AtZ(zi))
            zi = Add(zi, 1)
        }
        DawDock.Draw()
        DawMenu.Draw()
        DawFile.Draw()
        DawAsk.Draw()
        DawSong.Draw()
        DawPick.Draw()
        MemoryCopy(DawDesk.front, DawDesk.back, FB.size)
        ReturnValue(0)
    }
}

SubRoutine.Main {
    Arena_Init()
    ok = FB_InitShared(1280, 720, "/dev/shm/daw/desk.fb")
    IfCondition EqualTo(ok, 0) ThenBlock: {
        PrintMessage("desk fb failed\n")
        SystemCall(60, 1, 0, 0)
    }
    DawDesk.front = FB.fb_ptr
    DawDesk.back = Allocate(FB.size)
    FB.fb_ptr = DawDesk.back
    FB_FontInit()
    AppDesk.Init()
    DawDesk.win = AppDesk.Open(1, "Arranger", 0)
    AppDesk.Set(DawDesk.win, AppDeskWin.KIND, 4)
    AppDesk.Set(DawDesk.win, AppDeskWin.X, 8)
    AppDesk.Set(DawDesk.win, AppDeskWin.Y, 8)
    AppDesk.Set(DawDesk.win, AppDeskWin.W, 760)
    AppDesk.Set(DawDesk.win, AppDeskWin.H, 410)
    n = DawDesk.Seed()
    PrintMessage("desk tracks ")
    PrintNumber(n)
    PrintMessage("\n")
    DawDesk.ptr = Allocate(24)
    DawDesk.lv = Allocate(2048)
    DawDesk.rv = Allocate(2048)
    DawDesk.eqp = Allocate(128)
    DawDesk.eqt = Allocate(128)
    MemorySet(DawDesk.eqp, 0, 128)
    MemorySet(DawDesk.eqt, 0, 128)
    DawDesk.wavbuf = Allocate(512)
    DawDesk.nap = Allocate(16)
    StoreValue(DawDesk.nap, 0)
    StoreValue(Add(DawDesk.nap, 8), 33000000)
    DawDesk.run = 1
    DawHost.live = 1
    WhileLoop EqualTo(DawDesk.run, 1) {
        IfCondition EqualTo(DawSong.kick, 1) ThenBlock: {
            DawHost.Sync()
            DawSong.kick = 0
        }
        DawHost.Reap()
        DawDesk.Poll()
        IfCondition EqualTo(DawDesk.mode, 4) ThenBlock: {
            DawArrange.Scrub(DawDesk.px)
        }
        ElseBlock: {
        IfCondition EqualTo(DawDesk.play, 1) ThenBlock: {
            DawTracks.play = Add(DawTracks.play, 3)
            DawTransport.Clamp()
        }
        }
        hold = 0
        IfCondition EqualTo(DawDesk.mode, 2) ThenBlock: { hold = 1 }
        IfCondition EqualTo(DawDesk.mode, 4) ThenBlock: { hold = 1 }
        IfCondition EqualTo(DawDesk.mode, 11) ThenBlock: { hold = 1 }
        IfCondition EqualTo(hold, 0) ThenBlock: { DawArrange.Follow() }
        DawDesk.TakeDrop()
        DawDesk.Levels()
        DawDesk.Route()
        DawDesk.EqSync()
        DawDesk.Frame()
        SystemCall(35, DawDesk.nap, 0, 0)
    }
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
