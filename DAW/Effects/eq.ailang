// Four-band EQ worker. Integer samples. Does not draw.
// Does not open the sound card.
//
//   eq check
//   eq /dev/shm/daw/<track>/fx/0
//
// param.txt: low gain, low freq, low-mid gain, low-mid freq,
// high-mid gain, high-mid freq, high gain, high freq.
// Gain is tenths of a dB. Freq is Hz.
// Gain 0 keeps the sample. The four bands sum back to the input.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Arena

FixedPool.Eq {
    "st":    Initialize=0, CanChange=True
    "g0":    Initialize=0, CanChange=True
    "g1":    Initialize=0, CanChange=True
    "g2":    Initialize=0, CanChange=True
    "g3":    Initialize=0, CanChange=True
    "byp":   Initialize=0, CanChange=True
    "par":   Initialize=0, CanChange=True
    "f0":    Initialize=120, CanChange=True
    "f1":    Initialize=800, CanChange=True
    "f2":    Initialize=2500, CanChange=True
    "f3":    Initialize=8000, CanChange=True
    "dry":   Initialize=0, CanChange=True
    "wet":   Initialize=0, CanChange=True
    "nap":   Initialize=0, CanChange=True
    "run":   Initialize=1, CanChange=True
    "tok":   Initialize=0, CanChange=True
    "num":   Initialize=0, CanChange=True
    "any":   Initialize=0, CanChange=True
}

Function.Eq.ClampG {
    Input: g: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(g, -120) ThenBlock: { ReturnValue(-120) }
        IfCondition GreaterThan(g, 120) ThenBlock: { ReturnValue(120) }
        ReturnValue(g)
    }
}

Function.Eq.ClampF {
    Input: f: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(f, 20) ThenBlock: { ReturnValue(20) }
        IfCondition GreaterThan(f, 20000) ThenBlock: { ReturnValue(20000) }
        ReturnValue(f)
    }
}

Function.Eq.Lin {
    Input: g: Integer
    Output: Integer
    Body: {
        g = Eq.ClampG(g)
        neg = 0
        IfCondition LessThan(g, 0) ThenBlock: {
            neg = 1
            g = Subtract(0, g)
        }
        steps = Divide(g, 10)
        lin = 256
        i = 0
        WhileLoop LessThan(i, steps) {
            IfCondition EqualTo(neg, 1) ThenBlock: {
                lin = Divide(Multiply(lin, 256), 287)
            }
            ElseBlock: {
                lin = Divide(Multiply(lin, 287), 256)
            }
            IfCondition LessThan(lin, 1) ThenBlock: { lin = 1 }
            i = Add(i, 1)
        }
        ReturnValue(lin)
    }
}

Function.Eq.K {
    Input: f: Integer
    Output: Integer
    Body: {
        f = Eq.ClampF(f)
        k = Divide(Multiply(f, 858), 100)
        IfCondition LessThan(k, 64) ThenBlock: { k = 64 }
        IfCondition GreaterThan(k, 60000) ThenBlock: { k = 60000 }
        ReturnValue(k)
    }
}

Function.Eq.Pole {
    Input: idx: Integer
    Input: x: Integer
    Input: k: Integer
    Output: Integer
    Body: {
        at = Multiply(idx, 8)
        s = Dereference(Add(Eq.st, at))
        d = Subtract(x, s)
        s = Add(s, Divide(Multiply(d, k), 65536))
        StoreValue(Add(Eq.st, at), s)
        ReturnValue(s)
    }
}

Function.Eq.Tick {
    Input: x: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        base = Multiply(ch, 3)
        l0 = Eq.Pole(base, x, Eq.K(Eq.f0))
        l1 = Eq.Pole(Add(base, 1), x, Eq.K(Eq.f1))
        l2 = Eq.Pole(Add(base, 2), x, Eq.K(Eq.f2))
        low = l0
        midlo = Subtract(l1, l0)
        midhi = Subtract(l2, l1)
        high = Subtract(x, l2)
        y = Divide(Multiply(low, Eq.g0), 256)
        y = Add(y, Divide(Multiply(midlo, Eq.g1), 256))
        y = Add(y, Divide(Multiply(midhi, Eq.g2), 256))
        y = Add(y, Divide(Multiply(high, Eq.g3), 256))
        IfCondition GreaterThan(y, 32767) ThenBlock: { ReturnValue(32767) }
        IfCondition LessThan(y, -32768) ThenBlock: { ReturnValue(-32768) }
        ReturnValue(y)
    }
}

Function.Eq.Reset {
    Body: {
        MemorySet(Eq.st, 0, 64)
        Eq.g0 = 0
        Eq.g1 = 0
        Eq.g2 = 0
        Eq.g3 = 0
        Eq.f0 = 120
        Eq.f1 = 800
        Eq.f2 = 2500
        Eq.f3 = 8000
    }
}

Function.Eq.ApplyGains {
    Body: {
        Eq.g0 = Eq.Lin(Eq.g0)
        Eq.g1 = Eq.Lin(Eq.g1)
        Eq.g2 = Eq.Lin(Eq.g2)
        Eq.g3 = Eq.Lin(Eq.g3)
    }
}

Function.Eq.Check {
    Output: Integer
    Body: {
        Eq.Reset()
        Eq.ApplyGains()
        y = 0
        i = 0
        WhileLoop LessThan(i, 64) {
            y = Eq.Tick(1000, 0)
            i = Add(i, 1)
        }
        d = Subtract(y, 1000)
        IfCondition LessThan(d, 0) ThenBlock: { d = Subtract(0, d) }
        IfCondition GreaterThan(d, 2) ThenBlock: {
            PrintMessage("eq check unity ")
            PrintNumber(y)
            PrintMessage("\n")
            ReturnValue(0)
        }
        Eq.Reset()
        Eq.g0 = 120
        Eq.f0 = 4000
        Eq.ApplyGains()
        y = 0
        i = 0
        WhileLoop LessThan(i, 64) {
            y = Eq.Tick(1000, 0)
            i = Add(i, 1)
        }
        IfCondition LessThan(y, 3000) ThenBlock: {
            PrintMessage("eq check shelf ")
            PrintNumber(y)
            PrintMessage("\n")
            ReturnValue(0)
        }
        PrintMessage("eq check ok\n")
        ReturnValue(1)
    }
}

Function.Eq.Cmd {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buffer = Allocate(4096)
        IfCondition EqualTo(buffer, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            ReturnValue(0)
        }
        MemorySet(buffer, 0, 4096)
        n = SystemCall(0, fd, buffer, 4095)
        SystemCall(3, fd, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            IfCondition GreaterEqual(i, n) ThenBlock: { state = 0 }
            ElseBlock: {
                ch = GetByte(buffer, i)
                i = Add(i, 1)
                IfCondition EqualTo(ch, 0) ThenBlock: { state = 0 }
            }
        }
        IfCondition GreaterEqual(i, n) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(buffer, i), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Add(buffer, i))
    }
}

Function.Eq.IsCheck {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(s, 0), 45) ThenBlock: {
            IfCondition EqualTo(GetByte(s, 1), 45) ThenBlock: { s = Add(s, 2) }
        }
        IfCondition NotEqual(GetByte(s, 0), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 1), 104) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 2), 101) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 3), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 4), 107) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 5), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Eq.Len {
    Input: s: Address
    Output: Integer
    Body: {
        n = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            IfCondition GreaterThan(n, 240) ThenBlock: { state = 0 }
            ElseBlock: {
                ch = GetByte(s, n)
                IfCondition EqualTo(ch, 0) ThenBlock: { state = 0 }
                ElseBlock: { n = Add(n, 1) }
            }
        }
        ReturnValue(n)
    }
}

Function.Eq.CopyTo {
    Input: dst: Address
    Input: at: Integer
    Input: src: Address
    Output: Integer
    Body: {
        i = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            ch = GetByte(src, i)
            IfCondition EqualTo(ch, 0) ThenBlock: { state = 0 }
            ElseBlock: {
                SetByte(dst, at, ch)
                at = Add(at, 1)
                i = Add(i, 1)
            }
        }
        SetByte(dst, at, 0)
        ReturnValue(at)
    }
}

Function.Eq.DryPath {
    Input: slot: Address
    Output: Address
    Body: {
        n = Eq.Len(slot)
        IfCondition LessThan(n, 5) ThenBlock: { ReturnValue(0) }
        buf = Allocate(256)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(buf, i, GetByte(slot, i))
            i = Add(i, 1)
        }
        cut = n
        IfCondition EqualTo(GetByte(slot, Subtract(n, 4)), 102) ThenBlock: {
            IfCondition EqualTo(GetByte(slot, Subtract(n, 3)), 120) ThenBlock: {
                IfCondition EqualTo(GetByte(slot, Subtract(n, 2)), 47) ThenBlock: {
                    IfCondition EqualTo(GetByte(slot, Subtract(n, 1)), 48) ThenBlock: {
                        cut = Subtract(n, 4)
                    }
                }
            }
        }
        SetByte(buf, cut, 0)
        Eq.CopyTo(buf, cut, "pcm.bin")
        ReturnValue(buf)
    }
}

Function.Eq.Join {
    Input: dirp: Address
    Input: leaf: Address
    Output: Address
    Body: {
        buf = Allocate(256)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        at = Eq.CopyTo(buf, 0, dirp)
        n = Eq.Len(dirp)
        IfCondition GreaterThan(n, 0) ThenBlock: {
            last = GetByte(dirp, Subtract(n, 1))
            IfCondition NotEqual(last, 47) ThenBlock: {
                SetByte(buf, at, 47)
                at = Add(at, 1)
            }
        }
        Eq.CopyTo(buf, at, leaf)
        ReturnValue(buf)
    }
}

Function.Eq.DecAt {
    Input: buf: Address
    Input: i: Integer
    Output: Integer
    Body: {
        v = 0
        any = 0
        sign = 1
        state = 1
        WhileLoop EqualTo(state, 1) {
            ch = GetByte(buf, i)
            IfCondition EqualTo(ch, 45) ThenBlock: {
                IfCondition EqualTo(any, 0) ThenBlock: { sign = -1 }
                i = Add(i, 1)
            }
            ElseBlock: {
                IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                    state = 0
                }
                ElseBlock: {
                    any = 1
                    v = Add(Multiply(v, 10), Subtract(ch, 48))
                    i = Add(i, 1)
                }
            }
        }
        IfCondition EqualTo(sign, -1) ThenBlock: { v = Subtract(0, v) }
        Eq.num = v
        Eq.any = any
        ReturnValue(i)
    }
}

Function.Eq.LoadParam {
    Input: path: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(256)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            ReturnValue(0)
        }
        MemorySet(buf, 0, 256)
        n = SystemCall(0, fd, buf, 255)
        SystemCall(3, fd, 0, 0)
        IfCondition LessThan(n, 1) ThenBlock: {
            Deallocate(buf, 256)
            ReturnValue(0)
        }
        i = 0
        k = 0
        WhileLoop LessThan(k, 8) {
            WhileLoop EqualTo(GetByte(buf, i), 10) { i = Add(i, 1) }
            WhileLoop EqualTo(GetByte(buf, i), 13) { i = Add(i, 1) }
            WhileLoop EqualTo(GetByte(buf, i), 32) { i = Add(i, 1) }
            i = Eq.DecAt(buf, i)
            IfCondition EqualTo(Eq.any, 1) ThenBlock: {
                IfCondition EqualTo(k, 0) ThenBlock: { Eq.g0 = Eq.num }
                IfCondition EqualTo(k, 1) ThenBlock: { Eq.f0 = Eq.num }
                IfCondition EqualTo(k, 2) ThenBlock: { Eq.g1 = Eq.num }
                IfCondition EqualTo(k, 3) ThenBlock: { Eq.f1 = Eq.num }
                IfCondition EqualTo(k, 4) ThenBlock: { Eq.g2 = Eq.num }
                IfCondition EqualTo(k, 5) ThenBlock: { Eq.f2 = Eq.num }
                IfCondition EqualTo(k, 6) ThenBlock: { Eq.g3 = Eq.num }
                IfCondition EqualTo(k, 7) ThenBlock: { Eq.f3 = Eq.num }
            }
            state = 1
            WhileLoop EqualTo(state, 1) {
                ch = GetByte(buf, i)
                IfCondition EqualTo(ch, 0) ThenBlock: { state = 0 }
                ElseBlock: {
                    IfCondition EqualTo(ch, 10) ThenBlock: { state = 0 }
                    ElseBlock: { i = Add(i, 1) }
                }
            }
            k = Add(k, 1)
        }
        Deallocate(buf, 256)
        ReturnValue(1)
    }
}

Function.Eq.Bypass {
    Input: path: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(8)
        MemorySet(buf, 0, 8)
        SystemCall(0, fd, buf, 7)
        SystemCall(3, fd, 0, 0)
        ch = GetByte(buf, 0)
        Deallocate(buf, 8)
        IfCondition EqualTo(ch, 49) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Eq.I16 {
    Input: p: Address
    Input: off: Integer
    Output: Integer
    Body: {
        lo = GetByte(p, off)
        hi = GetByte(p, Add(off, 1))
        u = Add(lo, Multiply(hi, 256))
        IfCondition GreaterEqual(u, 32768) ThenBlock: {
            ReturnValue(Subtract(u, 65536))
        }
        ReturnValue(u)
    }
}

Function.Eq.Put16 {
    Input: p: Address
    Input: off: Integer
    Input: s: Integer
    Body: {
        v = s
        IfCondition LessThan(v, 0) ThenBlock: { v = Add(v, 65536) }
        SetByte(p, off, BitwiseAnd(v, 255))
        SetByte(p, Add(off, 1), BitwiseAnd(Divide(v, 256), 255))
    }
}

Function.Eq.Map {
    Input: path: Address
    Input: create: Integer
    Output: Address
    Body: {
        flags = 2
        IfCondition EqualTo(create, 1) ThenBlock: { flags = 66 }
        fd = SystemCall(2, path, flags, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(create, 1) ThenBlock: { SystemCall(77, fd, 32832) }
        p = SystemCall(9, 0, 32832, 3, 1, fd, 0)
        SystemCall(3, fd, 0, 0)
        IfCondition LessThan(p, 4096) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(create, 1) ThenBlock: {
            IfCondition EqualTo(Dereference(Add(p, 8)), 0) ThenBlock: {
                StoreValue(Add(p, 8), 8192)
                StoreValue(Add(p, 16), 0)
                StoreValue(Add(p, 24), 0)
                StoreValue(Add(p, 32), 48000)
            }
        }
        ReturnValue(p)
    }
}

Function.Eq.Used {
    Input: p: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        w = Dereference(Add(p, 16))
        r = Dereference(Add(p, 24))
        cap = Dereference(Add(p, 8))
        IfCondition EqualTo(cap, 0) ThenBlock: { cap = 8192 }
        u = Subtract(w, r)
        IfCondition GreaterThan(u, cap) ThenBlock: { ReturnValue(cap) }
        IfCondition LessThan(u, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(u)
    }
}

Function.Eq.Block {
    Output: Integer
    Body: {
        IfCondition EqualTo(Eq.Bypass(Eq.byp), 1) ThenBlock: {
            ReturnValue(0)
        }
        Eq.LoadParam(Eq.par)
        raw0 = Eq.g0
        raw1 = Eq.g1
        raw2 = Eq.g2
        raw3 = Eq.g3
        Eq.ApplyGains()
        n = Eq.Used(Eq.dry)
        room = Subtract(1024, Eq.Used(Eq.wet))
        IfCondition GreaterThan(n, 256) ThenBlock: { n = 256 }
        IfCondition GreaterThan(n, room) ThenBlock: { n = room }
        IfCondition LessThan(n, 1) ThenBlock: {
            Eq.g0 = raw0
            Eq.g1 = raw1
            Eq.g2 = raw2
            Eq.g3 = raw3
            ReturnValue(0)
        }
        capd = Dereference(Add(Eq.dry, 8))
        IfCondition EqualTo(capd, 0) ThenBlock: { capd = 8192 }
        capw = Dereference(Add(Eq.wet, 8))
        IfCondition EqualTo(capw, 0) ThenBlock: { capw = 8192 }
        rd = Dereference(Add(Eq.dry, 24))
        wr = Dereference(Add(Eq.wet, 16))
        i = 0
        WhileLoop LessThan(i, n) {
            sd = Modulo(Add(rd, i), capd)
            off = Add(64, Multiply(sd, 4))
            l = Eq.Tick(Eq.I16(Eq.dry, off), 0)
            r = Eq.Tick(Eq.I16(Eq.dry, Add(off, 2)), 1)
            sw = Modulo(Add(wr, i), capw)
            wo = Add(64, Multiply(sw, 4))
            Eq.Put16(Eq.wet, wo, l)
            Eq.Put16(Eq.wet, Add(wo, 2), r)
            i = Add(i, 1)
        }
        StoreValue(Add(Eq.dry, 24), Add(rd, n))
        StoreValue(Add(Eq.wet, 16), Add(wr, n))
        Eq.g0 = raw0
        Eq.g1 = raw1
        Eq.g2 = raw2
        Eq.g3 = raw3
        ReturnValue(n)
    }
}

Function.Eq.Live {
    Input: slot: Address
    Output: Integer
    Body: {
        Eq.tok = slot
        Eq.byp = Eq.Join(slot, "bypass.txt")
        Eq.par = Eq.Join(slot, "param.txt")
        dry = Eq.DryPath(slot)
        wetp = Eq.Join(slot, "out")
        IfCondition EqualTo(dry, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(wetp, 0) ThenBlock: { ReturnValue(1) }
        Eq.dry = Eq.Map(dry, 0)
        Eq.wet = Eq.Map(wetp, 1)
        IfCondition EqualTo(Eq.dry, 0) ThenBlock: {
            PrintMessage("eq: no dry ring\n")
            ReturnValue(1)
        }
        IfCondition EqualTo(Eq.wet, 0) ThenBlock: {
            PrintMessage("eq: no wet ring\n")
            ReturnValue(1)
        }
        Eq.nap = Allocate(16)
        MemorySet(Eq.nap, 0, 16)
        StoreValue(Add(Eq.nap, 8), 2000000)
        WhileLoop EqualTo(Eq.run, 1) {
            Eq.Block()
            SystemCall(35, Eq.nap, 0, 0)
        }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    Arena_Init()
    Eq.st = Allocate(64)
    IfCondition EqualTo(Eq.st, 0) ThenBlock: {
        SystemCall(60, 1, 0, 0)
    }
    MemorySet(Eq.st, 0, 64)
    arg = Eq.Cmd()
    IfCondition EqualTo(Eq.IsCheck(arg), 1) ThenBlock: {
        ok = Eq.Check()
        IfCondition EqualTo(ok, 1) ThenBlock: { SystemCall(60, 0, 0, 0) }
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(arg, 0) ThenBlock: {
        PrintMessage("usage: eq check | eq /dev/shm/daw/<track>/fx/0\n")
        SystemCall(60, 1, 0, 0)
    }
    code = Eq.Live(arg)
    SystemCall(60, code, 0, 0)
}

RunTask(Main)
