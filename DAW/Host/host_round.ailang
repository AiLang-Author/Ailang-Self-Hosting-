// Round-trip a junk song: instance id, plugin path, VST chunk path.
// Does not open step1 for writing and does not open the sound card.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Arena
LibraryImport.DAW.DawTrack
LibraryImport.DAW.DawSong
LibraryImport.DAW.DawHost

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

Function.HostRound.Die {
    Input: msg: Address
    Output: Integer
    Body: {
        PrintMessage(msg)
        SystemCall(60, 1, 0, 0)
        ReturnValue(0)
    }
}

Function.HostRound.Need {
    Input: got: Address
    Input: want: Address
    Input: label: Address
    Output: Integer
    Body: {
        PrintMessage(label)
        blank = DawSong.Blank(got)
        IfCondition EqualTo(blank, 1) ThenBlock: {
            PrintMessage("empty\n")
        }
        ElseBlock: {
            PrintMessage(got)
            PrintMessage("\n")
        }
        cmp = 1
        IfCondition EqualTo(blank, 0) ThenBlock: {
            cmp = StringCompare(got, want)
        }
        IfCondition NotEqual(cmp, 0) ThenBlock: {
            PrintMessage("round miss\n")
            SystemCall(60, 1, 0, 0)
        }
        ReturnValue(1)
    }
}

Function.HostRound.Empty {
    Input: got: Address
    Input: label: Address
    Output: Integer
    Body: {
        PrintMessage(label)
        blank = DawSong.Blank(got)
        IfCondition EqualTo(blank, 1) ThenBlock: {
            PrintMessage("empty\n")
            ReturnValue(1)
        }
        PrintMessage(got)
        PrintMessage("\n")
        PrintMessage("round miss\n")
        SystemCall(60, 1, 0, 0)
        ReturnValue(0)
    }
}

Function.HostRound.Track {
    Input: index: Integer
    Input: id: Address
    Input: plug: Address
    Input: rel: Address
    Output: Integer
    Body: {
        t = DawTrack.At(index)
        IfCondition EqualTo(t, 0) ThenBlock: {
            HostRound.Die("round no track\n")
            ReturnValue(0)
        }
        h = DawSong.HostOf(t)
        HostRound.Need(h, id, "id ")
        p = DawSong.PluginOf(t)
        HostRound.Need(p, plug, "plug ")
        v = DawSong.VstOf(t)
        HostRound.Need(v, rel, "vst ")
        ReturnValue(1)
    }
}

Function.HostRound.Bare {
    Input: index: Integer
    Output: Integer
    Body: {
        t = DawTrack.At(index)
        IfCondition EqualTo(t, 0) ThenBlock: {
            HostRound.Die("round no track\n")
            ReturnValue(0)
        }
        h = DawSong.HostOf(t)
        HostRound.Empty(h, "id ")
        p = DawSong.PluginOf(t)
        HostRound.Empty(p, "plug ")
        v = DawSong.VstOf(t)
        HostRound.Empty(v, "vst ")
        ReturnValue(1)
    }
}

Function.HostRound.BinSize {
    Input: leaf: Address
    Output: Integer
    Body: {
        dirp = DawSong.Join(DawSong.path, "patches")
        full = DawSong.Join(dirp, leaf)
        DawSong.FreeStr(dirp)
        IfCondition EqualTo(full, 0) ThenBlock: { ReturnValue(-1) }
        sz = DawSong.RegSize(full)
        DawSong.FreeStr(full)
        ReturnValue(sz)
    }
}

Function.HostRound.Reject {
    Input: folder: Address
    Input: keep: Integer
    Output: Integer
    Body: {
        ok = DawSong.Load(folder)
        IfCondition EqualTo(ok, 1) ThenBlock: {
            HostRound.Die("round accepted\n")
            ReturnValue(0)
        }
        cmp = StringCompare(DawSong.err, "bad json")
        IfCondition NotEqual(cmp, 0) ThenBlock: {
            HostRound.Die("round not bad\n")
            ReturnValue(0)
        }
        IfCondition NotEqual(DawTracks.n, keep) ThenBlock: {
            HostRound.Die("round chain\n")
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

SubRoutine.Main {
    Arena_Init()
    DawSong.Boot()
    dirp = DawSong.Join(DawSong.root, "hostq")
    made = DawSong.MkdirSong(dirp)
    IfCondition EqualTo(made, 0) ThenBlock: {
        HostRound.Die("round mkdir\n")
    }
    DawSong.path = dirp
    t1 = DawTrack.Add("lead", 1, 1, "vst")
    t2 = DawTrack.Add("dry", 0, 1, "sample")
    t3 = DawTrack.Add("pad", 1, 1, "pad")
    IfCondition EqualTo(t1, 0) ThenBlock: { HostRound.Die("round add\n") }
    IfCondition EqualTo(t2, 0) ThenBlock: { HostRound.Die("round add\n") }
    IfCondition EqualTo(t3, 0) ThenBlock: { HostRound.Die("round add\n") }
    plug1 = "/home/bob/Plugins/Dexed.so"
    plug2 = "/opt/Vital.vst3"
    ok = DawHost.Bind(t1, plug1)
    IfCondition EqualTo(ok, 0) ThenBlock: { HostRound.Die("round bind\n") }
    ok = DawHost.Bind(t2, plug2)
    IfCondition EqualTo(ok, 0) ThenBlock: { HostRound.Die("round bind\n") }
    ok = DawHost.Bind(t1, plug1)
    IfCondition EqualTo(ok, 0) ThenBlock: { HostRound.Die("round rebind\n") }
    refused = DawHost.Bind(t3, "patches/../secret")
    IfCondition EqualTo(refused, 1) ThenBlock: {
        HostRound.Die("round dotdot\n")
    }
    IfCondition NotEqual(DawSong.hseq, 2) ThenBlock: {
        HostRound.Die("round seq\n")
    }
    PrintMessage("seq ")
    PrintNumber(DawSong.hseq)
    PrintMessage("\n")
    HostRound.Track(0, "c1", plug1, "patches/c1.bin")
    HostRound.Track(1, "c2", plug2, "patches/c2.bin")
    HostRound.Bare(2)
    DawSong.Mkdir("/dev/shm/daw")
    d1 = DawSong.Join("/dev/shm/daw", "c1")
    DawSong.Mkdir(d1)
    st = DawSong.Join(d1, "state.bin")
    ok = DawSong.WriteText(st, "CHUNK")
    DawSong.FreeStr(d1)
    DawSong.FreeStr(st)
    IfCondition EqualTo(ok, 0) ThenBlock: { HostRound.Die("round chunk\n") }
    ok = DawSong.Save()
    IfCondition EqualTo(ok, 0) ThenBlock: { HostRound.Die("round save\n") }
    sz1 = HostRound.BinSize("c1.bin")
    sz2 = HostRound.BinSize("c2.bin")
    PrintMessage("bin ")
    PrintNumber(sz1)
    PrintMessage(" ")
    PrintNumber(sz2)
    PrintMessage("\n")
    IfCondition NotEqual(sz1, 5) ThenBlock: { HostRound.Die("round c1\n") }
    IfCondition GreaterEqual(sz2, 1) ThenBlock: { HostRound.Die("round c2\n") }
    DawSong.ClearChain()
    ok = DawSong.Load("hostq")
    IfCondition EqualTo(ok, 0) ThenBlock: { HostRound.Die("round load\n") }
    IfCondition NotEqual(DawSong.hseq, 2) ThenBlock: {
        HostRound.Die("round seq back\n")
    }
    PrintMessage("back seq ")
    PrintNumber(DawSong.hseq)
    PrintMessage("\n")
    HostRound.Track(0, "c1", plug1, "patches/c1.bin")
    HostRound.Track(1, "c2", plug2, "patches/c2.bin")
    HostRound.Bare(2)
    HostRound.Reject("hostbad", 3)
    HostRound.Reject("hostdot", 3)
    HostRound.Reject("hostneg", 3)
    ok = DawSong.Load("step1")
    IfCondition EqualTo(ok, 0) ThenBlock: { HostRound.Die("round step1\n") }
    IfCondition NotEqual(DawTracks.n, 7) ThenBlock: {
        HostRound.Die("round step n\n")
    }
    IfCondition NotEqual(DawSong.hseq, 0) ThenBlock: {
        HostRound.Die("round step seq\n")
    }
    PrintMessage("step seq ")
    PrintNumber(DawSong.hseq)
    PrintMessage("\n")
    PrintMessage("round ok\n")
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
