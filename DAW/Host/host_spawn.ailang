// The desk starts carla-ring for a track that already has a host id.
// This check does that without the framebuffer. It does not open the
// sound card and it does not write step1 or untitled.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Arena
LibraryImport.DAW.DawTrack
LibraryImport.DAW.DawSong
LibraryImport.DAW.DawHost

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

Function.HostSpawn.Die {
    Input: msg: Address
    Output: Integer
    Body: {
        PrintMessage(msg)
        SystemCall(60, 1, 0, 0)
        ReturnValue(0)
    }
}

Function.HostSpawn.Nap {
    Input: ns: Integer
    Output: Integer
    Body: {
        buf = Allocate(16)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(buf, 0)
        StoreValue(Add(buf, 8), ns)
        SystemCall(35, buf, 0, 0)
        Deallocate(buf, 16)
        ReturnValue(1)
    }
}

Function.HostSpawn.Exists {
    Input: path: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(3, fd, 0, 0)
        ReturnValue(1)
    }
}

SubRoutine.Main {
    Arena_Init()
    DawSong.Boot()
    DawHost.live = 1
    t = DawTrack.Add("lead", 1, 1, "vst")
    IfCondition EqualTo(t, 0) ThenBlock: { HostSpawn.Die("spawn add\n") }
    ok = DawTrack.SetHost(t, "c4")
    IfCondition EqualTo(ok, 0) ThenBlock: { HostSpawn.Die("spawn host\n") }
    n = DawHost.Sync()
    IfCondition NotEqual(n, 1) ThenBlock: { HostSpawn.Die("spawn count\n") }
    HostSpawn.Nap(300000000)
    go = HostSpawn.Exists("/dev/shm/daw/c4/go")
    IfCondition EqualTo(go, 0) ThenBlock: { HostSpawn.Die("spawn go\n") }
    out = DawSong.FileSize("/dev/shm/daw/c4/out")
    IfCondition LessThan(out, 1) ThenBlock: { HostSpawn.Die("spawn out\n") }
    at = DawHost.At(DawHost.pids, 0)
    pid = Dereference(at)
    alive = SystemCall(62, pid, 0, 0, 0, 0)
    IfCondition NotEqual(alive, 0) ThenBlock: { HostSpawn.Die("spawn dead\n") }
    DawHost.StopAll()
    gone = SystemCall(62, pid, 0, 0, 0, 0)
    IfCondition EqualTo(gone, 0) ThenBlock: { HostSpawn.Die("spawn stay\n") }
    DawSong.Unlink("/dev/shm/daw/c4/go")
    DawSong.Unlink("/dev/shm/daw/c4/id.txt")
    DawSong.Unlink("/dev/shm/daw/c4/out")
    DawSong.Unlink("/dev/shm/daw/c4/midi.bin")
    DawSong.Unlink("/dev/shm/daw/c4/state.bin")
    SystemCall(84, "/dev/shm/daw/c4", 0, 0)
    PrintMessage("spawn ok\n")
    SystemCall(60, 0, 0, 0)
}

RunTask(Main)
