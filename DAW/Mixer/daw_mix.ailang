// DAW mixer. One sound card, N rings named by the graph.
// Each ring is already a 16-bit mix from its instrument. This sum is
// sample * fader / 256, then master / 256, then one clamp. It does not
// clip a track before the bus. The card asks for one 256-frame period.
// The mix runs only when that room is free. A short ring is silence.
// A ring deeper than 1024 frames is cut back to the last 1024.
// A desktop window only blits the framebuffer.
// route.bin may drop a track or point it at fx/0/out.
// A missing route file keeps every dry ring in the sum.
//
// argv "check" parses the graph and the event list and does not open
// the card. Any other argv is the graph path. The default graph is step1.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Arena
LibraryImport.Display.Render.AudioEngine

FixedPool.Mix {
    "n":          Initialize=0, CanChange=True
    "masterL":    Initialize=80, CanChange=True
    "masterR":    Initialize=80, CanChange=True
    "any_solo":   Initialize=0, CanChange=True
    "played":     Initialize=0, CanChange=True
    "length":     Initialize=0, CanChange=True
    "transport":  Initialize=0, CanChange=True
    "ei":         Initialize=0, CanChange=True
    "nev":        Initialize=0, CanChange=True
    "ev":         Initialize=0, CanChange=True
    "pcm":        Initialize=0, CanChange=True
    "midi":       Initialize=0, CanChange=True
    "fader":      Initialize=0, CanChange=True
    "mute":       Initialize=0, CanChange=True
    "solo":       Initialize=0, CanChange=True
    "hold":       Initialize=0, CanChange=True
    "check":      Initialize=0, CanChange=True
    "frames":     Initialize=1024, CanChange=True
    "out":        Initialize=0, CanChange=True
    "tok":        Initialize=0, CanChange=True
    "evpath":     Initialize=0, CanChange=True
    "levels":     Initialize=0, CanChange=True
    "nap":        Initialize=0, CanChange=True
    "got":        Initialize=0, CanChange=True
    "num":        Initialize=0, CanChange=True
    "any":        Initialize=0, CanChange=True
    "haveev":     Initialize=0, CanChange=True
    "bad":        Initialize=0, CanChange=True
    "capped":     Initialize=0, CanChange=True
    "stat":       Initialize=0, CanChange=True
    "sum":        Initialize=0, CanChange=True
    "arg2":       Initialize=0, CanChange=True
    "hear":       Initialize=0, CanChange=True
    "wetf":       Initialize=0, CanChange=True
    "use":        Initialize=0, CanChange=True
    "wpcm":       Initialize=0, CanChange=True
    "route":      Initialize=0, CanChange=True
    "rpath":      Initialize=0, CanChange=True
    "rseq":       Initialize=-1, CanChange=True
}

FixedPool.Samp {
    "l": Initialize=0, CanChange=True
    "r": Initialize=0, CanChange=True
}

Function.Mix.Boot {
    Output: Integer
    Body: {
        Mix.pcm = Allocate(128)
        Mix.midi = Allocate(128)
        Mix.fader = Allocate(128)
        Mix.mute = Allocate(128)
        Mix.solo = Allocate(128)
        Mix.hold = Allocate(128)
        Mix.ev = Allocate(131072)
        Mix.tok = Allocate(700)
        Mix.evpath = Allocate(700)
        Mix.levels = Allocate(2048)
        Mix.out = Allocate(16384)
        Mix.nap = Allocate(16)
        Mix.stat = Allocate(152)
        Mix.hear = Allocate(128)
        Mix.wetf = Allocate(128)
        Mix.use = Allocate(128)
        Mix.wpcm = Allocate(128)
        Mix.route = Allocate(2048)
        Mix.rpath = Allocate(4096)
        IfCondition EqualTo(Mix.pcm, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.midi, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.fader, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.mute, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.solo, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.hold, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.ev, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.tok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.evpath, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.levels, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.out, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.nap, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.stat, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.hear, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.wetf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.use, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.wpcm, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.route, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.rpath, 0) ThenBlock: { ReturnValue(0) }
        MemorySet(Mix.pcm, 0, 128)
        MemorySet(Mix.midi, 0, 128)
        MemorySet(Mix.fader, 0, 128)
        MemorySet(Mix.mute, 0, 128)
        MemorySet(Mix.solo, 0, 128)
        MemorySet(Mix.hold, 0, 128)
        MemorySet(Mix.ev, 0, 131072)
        MemorySet(Mix.tok, 0, 700)
        MemorySet(Mix.evpath, 0, 700)
        MemorySet(Mix.nap, 0, 16)
        MemorySet(Mix.hear, 0, 128)
        MemorySet(Mix.wetf, 0, 128)
        MemorySet(Mix.use, 0, 128)
        MemorySet(Mix.wpcm, 0, 128)
        MemorySet(Mix.rpath, 0, 4096)
        StoreValue(Add(Mix.nap, 8), 2000000)
        ti = 0
        WhileLoop LessThan(ti, 16) {
            StoreValue(Add(Mix.hear, Multiply(ti, 8)), 1)
            ti = Add(ti, 1)
        }
        ReturnValue(1)
    }
}

Function.Mix.Read {
    Input: path: Address
    Output: Address
    Body: {
        st = Allocate(144)
        IfCondition EqualTo(st, 0) ThenBlock: { ReturnValue(0) }
        r = SystemCall(4, path, st)
        IfCondition LessThan(r, 0) ThenBlock: {
            Deallocate(st, 144)
            PrintMessage("mixer: open ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        sz = Dereference(Add(st, 48))
        Deallocate(st, 144)
        IfCondition LessThan(sz, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(sz, 1048576) ThenBlock: {
            PrintMessage("mixer: huge\n")
            ReturnValue(0)
        }
        cap = Add(sz, 1)
        buf = Allocate(cap)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        MemorySet(buf, 0, cap)
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            Deallocate(buf, cap)
            ReturnValue(0)
        }
        got = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            IfCondition GreaterEqual(got, sz) ThenBlock: { state = 2 }
            ElseBlock: {
                dstp = Add(buf, got)
                need = Subtract(sz, got)
                nr = SystemCall(0, fd, dstp, need)
                IfCondition LessThan(nr, 1) ThenBlock: { state = 0 }
                ElseBlock: { got = Add(got, nr) }
            }
        }
        SystemCall(3, fd, 0, 0)
        IfCondition NotEqual(state, 2) ThenBlock: {
            Deallocate(buf, cap)
            ReturnValue(0)
        }
        Mix.got = sz
        ReturnValue(buf)
    }
}

Function.Mix.Map {
    Input: path: Address
    Input: need: Integer
    Output: Address
    Body: {
        fd = SystemCall(2, path, 2, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        p = SystemCall(9, 0, need, 3, 1, fd, 0)
        SystemCall(3, fd, 0, 0)
        IfCondition LessThan(p, 4096) ThenBlock: { ReturnValue(0) }
        ReturnValue(p)
    }
}

Function.Mix.SkipSp {
    Input: buf: Address
    Input: i: Integer
    Output: Integer
    Body: {
        state = 1
        WhileLoop EqualTo(state, 1) {
            ch = GetByte(buf, i)
            IfCondition EqualTo(ch, 32) ThenBlock: { i = Add(i, 1) }
            ElseBlock: {
                IfCondition EqualTo(ch, 9) ThenBlock: { i = Add(i, 1) }
                ElseBlock: { state = 0 }
            }
        }
        ReturnValue(i)
    }
}

Function.Mix.EOL {
    Input: buf: Address
    Input: i: Integer
    Input: sz: Integer
    Output: Integer
    Body: {
        state = 1
        WhileLoop EqualTo(state, 1) {
            IfCondition GreaterEqual(i, sz) ThenBlock: { state = 0 }
            ElseBlock: {
                ch = GetByte(buf, i)
                i = Add(i, 1)
                IfCondition EqualTo(ch, 10) ThenBlock: { state = 0 }
            }
        }
        ReturnValue(i)
    }
}

Function.Mix.DecAt {
    Input: buf: Address
    Input: i: Integer
    Output: Integer
    Body: {
        v = 0
        any = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            ch = GetByte(buf, i)
            IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                state = 0
            }
            ElseBlock: {
                any = 1
                digit = Subtract(ch, 48)
                v = Add(Multiply(v, 10), digit)
                i = Add(i, 1)
            }
        }
        Mix.num = v
        Mix.any = any
        ReturnValue(i)
    }
}

Function.Mix.HexVal {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
            ReturnValue(Subtract(ch, 48))
        }
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 102)) ThenBlock: {
            ReturnValue(Subtract(ch, 87))
        }
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 70)) ThenBlock: {
            ReturnValue(Subtract(ch, 55))
        }
        ReturnValue(-1)
    }
}

Function.Mix.HexAt {
    Input: buf: Address
    Input: i: Integer
    Output: Integer
    Body: {
        v = 0
        any = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            ch = GetByte(buf, i)
            d = Mix.HexVal(ch)
            IfCondition LessThan(d, 0) ThenBlock: { state = 0 }
            ElseBlock: {
                any = 1
                v = Add(Multiply(v, 16), d)
                i = Add(i, 1)
            }
        }
        Mix.num = v
        Mix.any = any
        ReturnValue(i)
    }
}

Function.Mix.CopyTok {
    Input: buf: Address
    Input: i: Integer
    Input: dst: Address
    Output: Integer
    Body: {
        n = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            ch = GetByte(buf, i)
            stop = 0
            IfCondition EqualTo(ch, 0) ThenBlock: { stop = 1 }
            IfCondition EqualTo(ch, 10) ThenBlock: { stop = 1 }
            IfCondition EqualTo(ch, 13) ThenBlock: { stop = 1 }
            IfCondition EqualTo(ch, 32) ThenBlock: { stop = 1 }
            IfCondition EqualTo(ch, 9) ThenBlock: { stop = 1 }
            IfCondition EqualTo(stop, 1) ThenBlock: { state = 0 }
            ElseBlock: {
                IfCondition LessThan(n, 698) ThenBlock: { SetByte(dst, n, ch) }
                n = Add(n, 1)
                i = Add(i, 1)
            }
        }
        IfCondition GreaterThan(n, 698) ThenBlock: { n = 698 }
        SetByte(dst, n, 0)
        ReturnValue(i)
    }
}

Function.Mix.IsMaster {
    Input: buf: Address
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(GetByte(buf, i), 109) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 1)), 97) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 2)), 115) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 3)), 116) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 4)), 101) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 5)), 114) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 6)), 32) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Mix.IsEvents {
    Input: buf: Address
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(GetByte(buf, i), 101) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 1)), 118) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 2)), 101) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 3)), 110) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 4)), 116) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 5)), 115) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 6)), 32) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Mix.IsTrack {
    Input: buf: Address
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(GetByte(buf, i), 116) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 1)), 114) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 2)), 97) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 3)), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 4)), 107) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(i, 5)), 32) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Mix.TrackLine {
    Input: buf: Address
    Input: i: Integer
    Input: sz: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(Mix.n, 16) ThenBlock: {
            ReturnValue(Mix.EOL(buf, i, sz))
        }
        i = Add(i, 6)
        i = Mix.SkipSp(buf, i)
        i = Mix.CopyTok(buf, i, Mix.tok)
        Mix.KeepPath(Mix.n)
        pcm = Mix.Map(Mix.tok, 32832)
        IfCondition EqualTo(pcm, 0) ThenBlock: {
            PrintMessage("mixer: map miss ")
            PrintMessage(Mix.tok)
            PrintMessage("\n")
            IfCondition EqualTo(Mix.check, 0) ThenBlock: { Mix.bad = 1 }
        }
        i = Mix.SkipSp(buf, i)
        i = Mix.CopyTok(buf, i, Mix.tok)
        midi = Mix.Map(Mix.tok, 4128)
        IfCondition EqualTo(midi, 0) ThenBlock: {
            PrintMessage("mixer: map miss ")
            PrintMessage(Mix.tok)
            PrintMessage("\n")
            IfCondition EqualTo(Mix.check, 0) ThenBlock: { Mix.bad = 1 }
        }
        i = Mix.SkipSp(buf, i)
        i = Mix.DecAt(buf, i)
        fad = 256
        IfCondition EqualTo(Mix.any, 1) ThenBlock: { fad = Mix.num }
        slot = Multiply(Mix.n, 8)
        StoreValue(Add(Mix.pcm, slot), pcm)
        StoreValue(Add(Mix.midi, slot), midi)
        StoreValue(Add(Mix.fader, slot), fad)
        PrintMessage("mixer: track ")
        PrintNumber(Mix.n)
        PrintMessage(" fader ")
        PrintNumber(fad)
        PrintMessage("\n")
        Mix.n = Add(Mix.n, 1)
        ReturnValue(Mix.EOL(buf, i, sz))
    }
}

Function.Mix.OneLine {
    Input: buf: Address
    Input: i: Integer
    Input: sz: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(i, sz) ThenBlock: { ReturnValue(sz) }
        ch = GetByte(buf, i)
        IfCondition EqualTo(ch, 10) ThenBlock: { ReturnValue(Add(i, 1)) }
        IfCondition EqualTo(ch, 13) ThenBlock: { ReturnValue(Add(i, 1)) }
        room = Subtract(sz, i)
        IfCondition GreaterEqual(room, 7) ThenBlock: {
            ism = Mix.IsMaster(buf, i)
            IfCondition EqualTo(ism, 1) ThenBlock: {
                i = Add(i, 7)
                i = Mix.SkipSp(buf, i)
                i = Mix.DecAt(buf, i)
                Mix.masterL = Mix.num
                Mix.masterR = Mix.num
                ReturnValue(Mix.EOL(buf, i, sz))
            }
            ise = Mix.IsEvents(buf, i)
            IfCondition EqualTo(ise, 1) ThenBlock: {
                i = Add(i, 7)
                i = Mix.SkipSp(buf, i)
                i = Mix.CopyTok(buf, i, Mix.evpath)
                Mix.haveev = 1
                ReturnValue(Mix.EOL(buf, i, sz))
            }
        }
        IfCondition GreaterEqual(room, 6) ThenBlock: {
            ist = Mix.IsTrack(buf, i)
            IfCondition EqualTo(ist, 1) ThenBlock: {
                ReturnValue(Mix.TrackLine(buf, i, sz))
            }
        }
        ReturnValue(Mix.EOL(buf, i, sz))
    }
}

Function.Mix.EvLine {
    Input: buf: Address
    Input: i: Integer
    Input: sz: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(i, sz) ThenBlock: { ReturnValue(sz) }
        ch = GetByte(buf, i)
        IfCondition EqualTo(ch, 10) ThenBlock: { ReturnValue(Add(i, 1)) }
        IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
            ReturnValue(Mix.EOL(buf, i, sz))
        }
        i = Mix.DecAt(buf, i)
        frame = Mix.num
        i = Mix.SkipSp(buf, i)
        i = Mix.DecAt(buf, i)
        IfCondition EqualTo(Mix.any, 0) ThenBlock: { ReturnValue(Mix.EOL(buf, i, sz)) }
        tr = Mix.num
        i = Mix.SkipSp(buf, i)
        i = Mix.DecAt(buf, i)
        IfCondition EqualTo(Mix.any, 0) ThenBlock: { ReturnValue(Mix.EOL(buf, i, sz)) }
        nb = Mix.num
        i = Mix.SkipSp(buf, i)
        i = Mix.HexAt(buf, i)
        IfCondition EqualTo(Mix.any, 0) ThenBlock: { ReturnValue(Mix.EOL(buf, i, sz)) }
        b0 = Mix.num
        b1 = 0
        b2 = 0
        i = Mix.SkipSp(buf, i)
        i = Mix.HexAt(buf, i)
        IfCondition EqualTo(Mix.any, 1) ThenBlock: { b1 = Mix.num }
        i = Mix.SkipSp(buf, i)
        i = Mix.HexAt(buf, i)
        IfCondition EqualTo(Mix.any, 1) ThenBlock: { b2 = Mix.num }
        IfCondition Or(LessThan(nb, 1), GreaterThan(nb, 3)) ThenBlock: {
            ReturnValue(Mix.EOL(buf, i, sz))
        }
        IfCondition GreaterThan(frame, Mix.length) ThenBlock: { Mix.length = frame }
        IfCondition LessThan(Mix.nev, 8192) ThenBlock: {
            slot = Add(Mix.ev, Multiply(Mix.nev, 16))
            StoreValue(slot, frame)
            pack = BitwiseAnd(tr, 65535)
            pack = Add(pack, Multiply(BitwiseAnd(nb, 255), 65536))
            pack = Add(pack, Multiply(BitwiseAnd(b0, 255), 16777216))
            pack = Add(pack, Multiply(BitwiseAnd(b1, 255), 4294967296))
            pack = Add(pack, Multiply(BitwiseAnd(b2, 255), 1099511627776))
            StoreValue(Add(slot, 8), pack)
            Mix.nev = Add(Mix.nev, 1)
        }
        ElseBlock: {
            IfCondition EqualTo(Mix.capped, 0) ThenBlock: {
                PrintMessage("mixer: event cap\n")
                Mix.capped = 1
            }
        }
        ReturnValue(Mix.EOL(buf, i, sz))
    }
}

Function.Mix.LoadEvents {
    Input: path: Address
    Output: Integer
    Body: {
        buf = Mix.Read(path)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        sz = Mix.got
        i = 0
        WhileLoop LessThan(i, sz) {
            i = Mix.EvLine(buf, i, sz)
        }
        Deallocate(buf, Add(sz, 1))
        PrintMessage("mixer: ")
        PrintNumber(Mix.nev)
        PrintMessage(" events\n")
        ReturnValue(1)
    }
}

Function.Mix.LoadGraph {
    Input: path: Address
    Output: Integer
    Body: {
        buf = Mix.Read(path)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        sz = Mix.got
        i = 0
        WhileLoop LessThan(i, sz) {
            i = Mix.OneLine(buf, i, sz)
        }
        Deallocate(buf, Add(sz, 1))
        IfCondition EqualTo(Mix.bad, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Mix.haveev, 0) ThenBlock: {
            PrintMessage("mixer: no events\n")
            ReturnValue(0)
        }
        ok = Mix.LoadEvents(Mix.evpath)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(Mix.n, 1) ThenBlock: {
            PrintMessage("mixer: no tracks\n")
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.Mix.U32 {
    Input: buf: Address
    Input: off: Integer
    Output: Integer
    Body: {
        b0 = GetByte(buf, off)
        b1 = GetByte(buf, Add(off, 1))
        b2 = GetByte(buf, Add(off, 2))
        b3 = GetByte(buf, Add(off, 3))
        v = Add(b0, Multiply(b1, 256))
        v = Add(v, Multiply(b2, 65536))
        v = Add(v, Multiply(b3, 16777216))
        ReturnValue(v)
    }
}

Function.Mix.Levels {
    Output: Integer
    Body: {
        fd = SystemCall(2, "/dev/shm/daw/levels.bin", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        n = SystemCall(0, fd, Mix.levels, 2048)
        SystemCall(3, fd, 0, 0)
        IfCondition LessThan(n, 24) ThenBlock: { ReturnValue(0) }
        magic = Mix.U32(Mix.levels, 0)
        IfCondition NotEqual(magic, 827019852) ThenBlock: { ReturnValue(0) }
        seq = Mix.U32(Mix.levels, 4)
        count = Mix.U32(Mix.levels, 8)
        mL = Mix.U32(Mix.levels, 12)
        mR = Mix.U32(Mix.levels, 16)
        IfCondition GreaterThan(count, 64) ThenBlock: { ReturnValue(0) }
        need = Add(24, Multiply(count, 12))
        IfCondition LessThan(n, need) ThenBlock: { ReturnValue(0) }
        endat = Add(20, Multiply(count, 12))
        end = Mix.U32(Mix.levels, endat)
        IfCondition NotEqual(end, seq) ThenBlock: { ReturnValue(0) }
        use = count
        IfCondition GreaterThan(use, Mix.n) ThenBlock: { use = Mix.n }
        solo = 0
        t = 0
        WhileLoop LessThan(t, use) {
            off = Add(20, Multiply(t, 12))
            gain = Mix.U32(Mix.levels, off)
            mute = Mix.U32(Mix.levels, Add(off, 4))
            s = Mix.U32(Mix.levels, Add(off, 8))
            IfCondition GreaterThan(gain, 1024) ThenBlock: { gain = 1024 }
            IfCondition NotEqual(mute, 0) ThenBlock: { mute = 1 }
            IfCondition NotEqual(s, 0) ThenBlock: {
                s = 1
                solo = 1
            }
            slot = Multiply(t, 8)
            StoreValue(Add(Mix.fader, slot), gain)
            StoreValue(Add(Mix.mute, slot), mute)
            StoreValue(Add(Mix.solo, slot), s)
            t = Add(t, 1)
        }
        Mix.any_solo = solo
        IfCondition GreaterThan(mL, 1024) ThenBlock: { mL = 1024 }
        IfCondition GreaterThan(mR, 1024) ThenBlock: { mR = 1024 }
        Mix.masterL = mL
        Mix.masterR = mR
        ReturnValue(1)
    }
}

Function.Mix.Avail {
    Input: pcm: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(pcm, 0) ThenBlock: { ReturnValue(0) }
        w = Dereference(Add(pcm, 16))
        r = Dereference(Add(pcm, 24))
        cap = Dereference(Add(pcm, 8))
        IfCondition EqualTo(cap, 0) ThenBlock: { cap = 8192 }
        u = Subtract(w, r)
        IfCondition GreaterThan(u, cap) ThenBlock: { ReturnValue(cap) }
        IfCondition LessThan(u, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(u)
    }
}

Function.Mix.Trim {
    Input: pcm: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(pcm, 0) ThenBlock: { ReturnValue(0) }
        w = Dereference(Add(pcm, 16))
        r = Dereference(Add(pcm, 24))
        cap = Dereference(Add(pcm, 8))
        IfCondition EqualTo(cap, 0) ThenBlock: { cap = 8192 }
        u = Subtract(w, r)
        IfCondition GreaterThan(u, cap) ThenBlock: { u = cap }
        IfCondition GreaterThan(u, 1024) ThenBlock: {
            StoreValue(Add(pcm, 24), Subtract(w, 1024))
        }
        ReturnValue(0)
    }
}

Function.Mix.I16 {
    Input: p: Address
    Input: off: Integer
    Output: Integer
    Body: {
        lo = GetByte(p, off)
        hi = GetByte(p, Add(off, 1))
        u = Add(lo, Multiply(hi, 256))
        IfCondition GreaterEqual(u, 32768) ThenBlock: {
            ReturnValue(Subtract(u, 65536))
        }
        ReturnValue(u)
    }
}

Function.Mix.Frame {
    Input: pcm: Address
    Input: i: Integer
    Body: {
        rd = Dereference(Add(pcm, 24))
        cap = Dereference(Add(pcm, 8))
        IfCondition EqualTo(cap, 0) ThenBlock: { cap = 8192 }
        slot = Modulo(Add(rd, i), cap)
        off = Add(64, Multiply(slot, 4))
        Samp.l = Mix.I16(pcm, off)
        Samp.r = Mix.I16(pcm, Add(off, 2))
    }
}

Function.Mix.Clamp {
    Input: s: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(s, 32767) ThenBlock: { ReturnValue(32767) }
        IfCondition LessThan(s, -32768) ThenBlock: { ReturnValue(-32768) }
        ReturnValue(s)
    }
}

Function.Mix.Put {
    Input: off: Integer
    Input: s: Integer
    Body: {
        v = s
        IfCondition LessThan(v, 0) ThenBlock: { v = Add(v, 65536) }
        lo = BitwiseAnd(v, 255)
        hi = BitwiseAnd(Divide(v, 256), 255)
        SetByte(Mix.out, off, lo)
        SetByte(Mix.out, Add(off, 1), hi)
    }
}

Function.Mix.SumFrame {
    Input: i: Integer
    Body: {
        accL = 0
        accR = 0
        t = 0
        WhileLoop LessThan(t, Mix.n) {
            at = Multiply(t, 8)
            h = Dereference(Add(Mix.hold, at))
            IfCondition GreaterThan(h, i) ThenBlock: {
                pcm = Dereference(Add(Mix.use, at))
                Mix.Frame(pcm, i)
                fad = Dereference(Add(Mix.fader, at))
                mute = Dereference(Add(Mix.mute, at))
                sol = Dereference(Add(Mix.solo, at))
                IfCondition NotEqual(mute, 0) ThenBlock: { fad = 0 }
                IfCondition NotEqual(Mix.any_solo, 0) ThenBlock: {
                    IfCondition EqualTo(sol, 0) ThenBlock: { fad = 0 }
                }
                partL = Divide(Multiply(Samp.l, fad), 256)
                partR = Divide(Multiply(Samp.r, fad), 256)
                accL = Add(accL, partL)
                accR = Add(accR, partR)
            }
            t = Add(t, 1)
        }
        accL = Divide(Multiply(accL, Mix.masterL), 256)
        accR = Divide(Multiply(accR, Mix.masterR), 256)
        accL = Mix.Clamp(accL)
        accR = Mix.Clamp(accR)
        base = Multiply(i, 4)
        Mix.Put(base, accL)
        Mix.Put(Add(base, 2), accR)
    }
}

Function.Mix.MidiByte {
    Input: midi: Address
    Input: b: Integer
    Output: Integer
    Body: {
        w = Dereference(midi)
        r = Dereference(Add(midi, 8))
        cap = Dereference(Add(midi, 16))
        IfCondition EqualTo(cap, 0) ThenBlock: { cap = 4096 }
        used = Subtract(w, r)
        IfCondition GreaterEqual(used, cap) ThenBlock: { ReturnValue(0) }
        idx = Modulo(w, cap)
        SetByte(midi, Add(32, idx), BitwiseAnd(b, 255))
        StoreValue(midi, Add(w, 1))
        ReturnValue(1)
    }
}

Function.Mix.Push {
    Input: track: Integer
    Input: nb: Integer
    Input: b0: Integer
    Input: b1: Integer
    Input: b2: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(track, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(track, Mix.n) ThenBlock: { ReturnValue(0) }
        midi = Dereference(Add(Mix.midi, Multiply(track, 8)))
        IfCondition EqualTo(midi, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(nb, 0) ThenBlock: { Mix.MidiByte(midi, b0) }
        IfCondition GreaterThan(nb, 1) ThenBlock: { Mix.MidiByte(midi, b1) }
        IfCondition GreaterThan(nb, 2) ThenBlock: { Mix.MidiByte(midi, b2) }
        ReturnValue(1)
    }
}

Function.Mix.Emit {
    Input: until: Integer
    Body: {
        state = 1
        WhileLoop EqualTo(state, 1) {
            IfCondition GreaterEqual(Mix.ei, Mix.nev) ThenBlock: { state = 0 }
            ElseBlock: {
                ev = Add(Mix.ev, Multiply(Mix.ei, 16))
                frame = Dereference(ev)
                IfCondition GreaterThan(frame, until) ThenBlock: { state = 0 }
                ElseBlock: {
                    pack = Dereference(Add(ev, 8))
                    track = BitwiseAnd(pack, 65535)
                    nb = BitwiseAnd(Divide(pack, 65536), 255)
                    b0 = BitwiseAnd(Divide(pack, 16777216), 255)
                    b1 = BitwiseAnd(Divide(pack, 4294967296), 255)
                    b2 = BitwiseAnd(Divide(pack, 1099511627776), 255)
                    Mix.Push(track, nb, b0, b1, b2)
                    Mix.ei = Add(Mix.ei, 1)
                }
            }
        }
    }
}

Function.Mix.KeepPath {
    Input: slot: Integer
    Body: {
        dst = Add(Mix.rpath, Multiply(slot, 256))
        i = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            ch = GetByte(Mix.tok, i)
            SetByte(dst, i, ch)
            IfCondition EqualTo(ch, 0) ThenBlock: { state = 0 }
            ElseBlock: {
                i = Add(i, 1)
                IfCondition GreaterThan(i, 250) ThenBlock: {
                    SetByte(dst, 250, 0)
                    state = 0
                }
            }
        }
    }
}

Function.Mix.WetPath {
    Input: slot: Integer
    Output: Integer
    Body: {
        src = Add(Mix.rpath, Multiply(slot, 256))
        n = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            ch = GetByte(src, n)
            IfCondition EqualTo(ch, 0) ThenBlock: { state = 0 }
            ElseBlock: { n = Add(n, 1) }
        }
        IfCondition LessThan(n, 7) ThenBlock: { ReturnValue(0) }
        base = Subtract(n, 7)
        IfCondition NotEqual(GetByte(src, base), 112) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(src, Add(base, 1)), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(src, Add(base, 2)), 109) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(src, Add(base, 3)), 46) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(src, Add(base, 4)), 98) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(src, Add(base, 5)), 105) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(src, Add(base, 6)), 110) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, base) {
            SetByte(Mix.tok, i, GetByte(src, i))
            i = Add(i, 1)
        }
        SetByte(Mix.tok, i, 102)
        SetByte(Mix.tok, Add(i, 1), 120)
        SetByte(Mix.tok, Add(i, 2), 47)
        SetByte(Mix.tok, Add(i, 3), 48)
        SetByte(Mix.tok, Add(i, 4), 47)
        SetByte(Mix.tok, Add(i, 5), 111)
        SetByte(Mix.tok, Add(i, 6), 117)
        SetByte(Mix.tok, Add(i, 7), 116)
        SetByte(Mix.tok, Add(i, 8), 0)
        ReturnValue(1)
    }
}

Function.Mix.Bypass {
    Input: slot: Integer
    Output: Integer
    Body: {
        ok = Mix.WetPath(slot)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            ch = GetByte(Mix.tok, n)
            IfCondition EqualTo(ch, 0) ThenBlock: { state = 0 }
            ElseBlock: { n = Add(n, 1) }
        }
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        base = Subtract(n, 3)
        SetByte(Mix.tok, base, 98)
        SetByte(Mix.tok, Add(base, 1), 121)
        SetByte(Mix.tok, Add(base, 2), 112)
        SetByte(Mix.tok, Add(base, 3), 97)
        SetByte(Mix.tok, Add(base, 4), 115)
        SetByte(Mix.tok, Add(base, 5), 115)
        SetByte(Mix.tok, Add(base, 6), 46)
        SetByte(Mix.tok, Add(base, 7), 116)
        SetByte(Mix.tok, Add(base, 8), 120)
        SetByte(Mix.tok, Add(base, 9), 116)
        SetByte(Mix.tok, Add(base, 10), 0)
        fd = SystemCall(2, Mix.tok, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Add(Mix.route, 2000)
        MemorySet(buf, 0, 8)
        SystemCall(0, fd, buf, 4)
        SystemCall(3, fd, 0, 0)
        ch = GetByte(buf, 0)
        IfCondition EqualTo(ch, 49) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Mix.Route {
    Output: Integer
    Body: {
        t = 0
        WhileLoop LessThan(t, Mix.n) {
            at = Multiply(t, 8)
            StoreValue(Add(Mix.hear, at), 1)
            StoreValue(Add(Mix.wetf, at), 0)
            t = Add(t, 1)
        }
        fd = SystemCall(2, "/dev/shm/daw/route.bin", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        n = SystemCall(0, fd, Mix.route, 2048)
        SystemCall(3, fd, 0, 0)
        IfCondition LessThan(n, 16) ThenBlock: { ReturnValue(0) }
        magic = Mix.U32(Mix.route, 0)
        IfCondition NotEqual(magic, 827019853) ThenBlock: { ReturnValue(0) }
        seq = Mix.U32(Mix.route, 4)
        count = Mix.U32(Mix.route, 8)
        IfCondition GreaterThan(count, 64) ThenBlock: { ReturnValue(0) }
        need = Add(16, Multiply(count, 8))
        IfCondition LessThan(n, need) ThenBlock: { ReturnValue(0) }
        endat = Add(12, Multiply(count, 8))
        end = Mix.U32(Mix.route, endat)
        IfCondition NotEqual(end, seq) ThenBlock: { ReturnValue(0) }
        use = count
        IfCondition GreaterThan(use, Mix.n) ThenBlock: { use = Mix.n }
        t = 0
        WhileLoop LessThan(t, use) {
            off = Add(12, Multiply(t, 8))
            h = Mix.U32(Mix.route, off)
            w = Mix.U32(Mix.route, Add(off, 4))
            IfCondition NotEqual(h, 0) ThenBlock: { h = 1 }
            IfCondition NotEqual(w, 0) ThenBlock: { w = 1 }
            at = Multiply(t, 8)
            StoreValue(Add(Mix.hear, at), h)
            StoreValue(Add(Mix.wetf, at), w)
            t = Add(t, 1)
        }
        IfCondition NotEqual(seq, Mix.rseq) ThenBlock: {
            Mix.rseq = seq
            PrintMessage("mixer route ")
            PrintNumber(use)
            PrintMessage("\n")
        }
        ReturnValue(1)
    }
}

Function.Mix.Build {
    Body: {
        frames = AudioState.period_size
        IfCondition EqualTo(Mix.sum, 1) ThenBlock: { frames = 256 }
        IfCondition LessThan(frames, 1) ThenBlock: { frames = 1024 }
        IfCondition GreaterThan(frames, 4096) ThenBlock: { frames = 4096 }
        Mix.frames = frames
        MemorySet(Mix.out, 0, Multiply(frames, 4))
        Mix.Route()
        t = 0
        WhileLoop LessThan(t, Mix.n) {
            at = Multiply(t, 8)
            dry = Dereference(Add(Mix.pcm, at))
            src = dry
            hear = Dereference(Add(Mix.hear, at))
            IfCondition EqualTo(hear, 0) ThenBlock: { src = 0 }
            ElseBlock: {
                wf = Dereference(Add(Mix.wetf, at))
                IfCondition EqualTo(wf, 1) ThenBlock: {
                    wp = Dereference(Add(Mix.wpcm, at))
                    IfCondition EqualTo(wp, 0) ThenBlock: {
                        got = Mix.WetPath(t)
                        IfCondition EqualTo(got, 1) ThenBlock: {
                            wp = Mix.Map(Mix.tok, 32832)
                            StoreValue(Add(Mix.wpcm, at), wp)
                        }
                    }
                    byp = Mix.Bypass(t)
                    IfCondition EqualTo(byp, 0) ThenBlock: {
                        IfCondition NotEqual(wp, 0) ThenBlock: {
                            IfCondition GreaterThan(Mix.Avail(wp), 0) ThenBlock: { src = wp }
                        }
                    }
                }
            }
            StoreValue(Add(Mix.use, at), src)
            IfCondition EqualTo(src, 0) ThenBlock: {
                StoreValue(Add(Mix.hold, at), 0)
            }
            ElseBlock: {
                Mix.Trim(src)
                a = Mix.Avail(src)
                StoreValue(Add(Mix.hold, at), a)
            }
            t = Add(t, 1)
        }
        until = Add(Mix.played, frames)
        Mix.Emit(until)
        i = 0
        WhileLoop LessThan(i, frames) {
            Mix.SumFrame(i)
            i = Add(i, 1)
        }
    }
}

Function.Mix.Commit {
    Body: {
        t = 0
        WhileLoop LessThan(t, Mix.n) {
            at = Multiply(t, 8)
            a = Dereference(Add(Mix.hold, at))
            IfCondition GreaterThan(a, Mix.frames) ThenBlock: { a = Mix.frames }
            IfCondition GreaterThan(a, 0) ThenBlock: {
                pcm = Dereference(Add(Mix.use, at))
                IfCondition NotEqual(pcm, 0) ThenBlock: {
                    rd = Dereference(Add(pcm, 24))
                    StoreValue(Add(pcm, 24), Add(rd, a))
                }
            }
            t = Add(t, 1)
        }
        Mix.played = Add(Mix.played, Mix.frames)
        IfCondition NotEqual(Mix.transport, 0) ThenBlock: {
            StoreValue(Mix.transport, Mix.played)
        }
    }
}

Function.Mix.OpenTransport {
    Output: Integer
    Body: {
        fd = SystemCall(2, "/dev/shm/daw/transport.bin", 66, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(77, fd, 16)
        p = SystemCall(9, 0, 16, 3, 1, fd, 0)
        IfCondition LessThan(p, 4096) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            ReturnValue(0)
        }
        Mix.transport = p
        StoreValue(p, 0)
        StoreValue(Add(p, 8), Mix.length)
        ReturnValue(1)
    }
}

Function.Mix.CardRoom {
    Output: Integer
    Body: {
        fd = AudioState.fd
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(16, fd, 16674, 0, 0, 0)
        MemorySet(Mix.stat, 0, 152)
        r = SystemCall(16, fd, 2157461792, Mix.stat, 0, 0)
        IfCondition LessThan(r, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(Mix.stat, 64)))
    }
}

Function.Mix.WaitRoom {
    Body: {
        state = 1
        WhileLoop EqualTo(state, 1) {
            room = Mix.CardRoom()
            IfCondition GreaterEqual(room, Mix.frames) ThenBlock: { state = 0 }
            ElseBlock: {
                SystemCall(35, Mix.nap, 0, 0)
            }
        }
    }
}

Function.Mix.Run {
    Output: Integer
    Body: {
        AudioWant.per_min = 256
        AudioWant.per_max = 256
        AudioWant.buf_min = 1024
        AudioWant.buf_max = 1024
        AudioWant.nper_min = 4
        AudioWant.nper_max = 4
        r = Audio_Init()
        IfCondition LessThan(r, 0) ThenBlock: {
            AudioWant.per_max = 1024
            AudioWant.buf_min = 1024
            AudioWant.buf_max = 1024
            r = Audio_Init()
        }
        IfCondition LessThan(r, 0) ThenBlock: {
            PrintMessage("mixer: audio init failed\n")
            ReturnValue(1)
        }
        Mix.OpenTransport()
        PrintMessage("mixer: ")
        PrintNumber(Mix.n)
        PrintMessage(" tracks master ")
        PrintNumber(Mix.masterL)
        PrintMessage("\n")
        Mix.frames = AudioState.period_size
        IfCondition LessThan(Mix.frames, 1) ThenBlock: { Mix.frames = 256 }
        IfCondition GreaterThan(Mix.frames, 1024) ThenBlock: { Mix.frames = 256 }
        state = 1
        WhileLoop EqualTo(state, 1) {
            Mix.WaitRoom()
            Mix.Levels()
            Mix.Build()
            spinning = 1
            WhileLoop EqualTo(spinning, 1) {
                wr = Audio_WriteFrames(Mix.out, Mix.frames)
                IfCondition LessThan(wr, 0) ThenBlock: {
                    PrintMessage("mixer: write failed\n")
                    spinning = 0
                    state = 0
                }
                ElseBlock: {
                    IfCondition LessThan(wr, 1) ThenBlock: {
                        SystemCall(35, Mix.nap, 0, 0)
                    }
                    ElseBlock: {
                        Mix.Commit()
                        spinning = 0
                    }
                }
            }
        }
        Audio_Shutdown()
        ReturnValue(1)
    }
}

Function.Mix.Cmd {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buffer = Allocate(4096)
        IfCondition EqualTo(buffer, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            ReturnValue(0)
        }
        MemorySet(buffer, 0, 4096)
        n = SystemCall(0, fd, buffer, 4095)
        SystemCall(3, fd, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            IfCondition GreaterEqual(i, n) ThenBlock: { state = 0 }
            ElseBlock: {
                ch = GetByte(buffer, i)
                i = Add(i, 1)
                IfCondition EqualTo(ch, 0) ThenBlock: { state = 0 }
            }
        }
        IfCondition GreaterEqual(i, n) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(buffer, i), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Add(buffer, i))
    }
}

Function.Mix.IsSum {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 0), 115) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 1), 117) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 2), 109) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 3), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Mix.Arg2 {
    Output: Address
    Body: {
        fd = SystemCall(257, -100, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buffer = Allocate(4096)
        IfCondition EqualTo(buffer, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            ReturnValue(0)
        }
        MemorySet(buffer, 0, 4096)
        n = SystemCall(0, fd, buffer, 4095)
        SystemCall(3, fd, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        seen = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            IfCondition GreaterEqual(i, n) ThenBlock: { state = 0 }
            ElseBlock: {
                ch = GetByte(buffer, i)
                IfCondition EqualTo(ch, 0) ThenBlock: {
                    seen = Add(seen, 1)
                    IfCondition EqualTo(seen, 2) ThenBlock: { state = 0 }
                }
                i = Add(i, 1)
            }
        }
        IfCondition GreaterEqual(i, n) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(buffer, i), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Add(buffer, i))
    }
}

Function.Mix.Peak {
    Output: Integer
    Body: {
        peak = 0
        rails = 0
        i = 0
        n = Multiply(Mix.frames, 2)
        WhileLoop LessThan(i, n) {
            s = Mix.I16(Mix.out, Multiply(i, 2))
            a = s
            IfCondition LessThan(a, 0) ThenBlock: { a = Subtract(0, a) }
            IfCondition GreaterThan(a, peak) ThenBlock: { peak = a }
            IfCondition GreaterEqual(a, 32767) ThenBlock: { rails = Add(rails, 1) }
            i = Add(i, 1)
        }
        PrintMessage("mixer sum peak ")
        PrintNumber(peak)
        PrintMessage(" rails ")
        PrintNumber(rails)
        PrintMessage("\n")
        ReturnValue(peak)
    }
}

Function.Mix.IsCheck {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 0), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 1), 104) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 2), 101) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 3), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 4), 107) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 5), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

SubRoutine.Main {
    Arena_Init()
    booted = Mix.Boot()
    IfCondition EqualTo(booted, 0) ThenBlock: {
        PrintMessage("mixer: boot\n")
        SystemCall(60, 1, 0, 0)
    }
    arg = Mix.Cmd()
    graph = "/home/bob/Ailang-Self-Hosting-/DAW/Sessions/step1.graph"
    chk = Mix.IsCheck(arg)
    sm = Mix.IsSum(arg)
    IfCondition EqualTo(chk, 1) ThenBlock: { Mix.check = 1 }
    IfCondition EqualTo(sm, 1) ThenBlock: {
        Mix.sum = 1
        arg2 = Mix.Arg2()
        IfCondition NotEqual(arg2, 0) ThenBlock: { graph = arg2 }
    }
    IfCondition EqualTo(sm, 0) ThenBlock: {
        IfCondition EqualTo(chk, 0) ThenBlock: {
            IfCondition NotEqual(arg, 0) ThenBlock: { graph = arg }
        }
    }
    ok = Mix.LoadGraph(graph)
    IfCondition EqualTo(ok, 0) ThenBlock: {
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(Mix.sum, 1) ThenBlock: {
        PrintMessage("mixer: ")
        PrintNumber(Mix.n)
        PrintMessage(" tracks master ")
        PrintNumber(Mix.masterL)
        PrintMessage("\n")
        Mix.Build()
        Mix.Peak()
        SystemCall(60, 0, 0, 0)
    }
    IfCondition EqualTo(Mix.check, 1) ThenBlock: {
        PrintMessage("mixer: ")
        PrintNumber(Mix.n)
        PrintMessage(" tracks master ")
        PrintNumber(Mix.masterL)
        PrintMessage(" length ")
        PrintNumber(Mix.length)
        PrintMessage("\n")
        PrintMessage("mixer check\n")
        SystemCall(60, 0, 0, 0)
    }
    code = Mix.Run()
    SystemCall(60, code, 0, 0)
}

RunTask(Main)
