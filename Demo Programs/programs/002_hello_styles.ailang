// 002 — Hello, World in several styles
// Same output through different shapes. PrintMessage takes a string;
// PrintChar takes one byte; PrintNumber takes an integer. Compose them
// and you have everything you need for line-oriented output.
SubRoutine.Main {
    // Style A — one string, one call.
    PrintMessage("Hello, World!\n")

    // Style B — three calls, builds the same line piecewise.
    PrintMessage("Hello, ")
    PrintMessage("World")
    PrintMessage("!\n")

    // Style C — char by char with PrintChar.
    PrintChar(72)   // 'H'
    PrintChar(105)  // 'i'
    PrintChar(33)   // '!'
    PrintChar(10)   // '\n'

    // Style D — Number-flavored greeting.
    PrintMessage("year ")
    PrintNumber(2026)
    PrintMessage(": still saying hello\n")
}
RunTask(Main)
