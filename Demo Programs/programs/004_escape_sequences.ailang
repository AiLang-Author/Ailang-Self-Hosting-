// 004 — Escape sequences
// \n newline, \t tab, \\ backslash, \" double-quote.
// Each is a single byte after the lexer processes the string literal.
SubRoutine.Main {
    PrintMessage("tab\there\n")
    PrintMessage("quote\"inside\n")
    PrintMessage("backslash\\once\n")
    PrintMessage("two lines\nin one string\n")
}
RunTask(Main)
