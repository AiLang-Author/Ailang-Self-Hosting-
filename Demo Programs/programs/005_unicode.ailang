// 005 — Print Unicode characters
// AiLang string literals are UTF-8 byte sequences; terminals that
// understand UTF-8 render them correctly. No special language support
// needed — the bytes go straight out.
SubRoutine.Main {
    PrintMessage("English: Hello\n")
    PrintMessage("Greek:   Γειά σου\n")
    PrintMessage("Japanese: こんにちは\n")
    PrintMessage("Emoji:   🚀 🌍 ✨\n")
}
RunTask(Main)
