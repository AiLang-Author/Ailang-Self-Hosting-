// 006 — Padded / aligned columns
// AiLang doesn't have printf-style format specifiers; we pad by hand
// with spaces in the string literal. Good enough for fixed-column output.
SubRoutine.Main {
    PrintMessage("Name       Score\n")
    PrintMessage("----       -----\n")
    PrintMessage("Alice       100\n")
    PrintMessage("Bob          87\n")
    PrintMessage("Carol         9\n")
}
RunTask(Main)
