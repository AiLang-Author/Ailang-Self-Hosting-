// 007 — Print to stderr
// Linux write syscall (1) with fd=2 sends bytes to stderr instead of
// stdout. Useful for diagnostics that shouldn't show up in a pipe.
// Verify with:  ./007_stderr.x > /dev/null    (stderr message remains)
SubRoutine.Main {
    msg = "this goes to stderr\n"
    len = StringLength(msg)
    SystemCall(1, 2, msg, len)
}
RunTask(Main)
