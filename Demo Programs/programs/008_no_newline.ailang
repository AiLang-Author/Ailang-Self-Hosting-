// 008 — Print without newline
// PrintMessage doesn't auto-newline; leaving \n off produces bare bytes.
// Three PrintMessage calls with no \n render as one contiguous line.
SubRoutine.Main {
    PrintMessage("a")
    PrintMessage("b")
    PrintMessage("c")
    PrintMessage("\n")  // final newline so the shell prompt returns cleanly
}
RunTask(Main)
