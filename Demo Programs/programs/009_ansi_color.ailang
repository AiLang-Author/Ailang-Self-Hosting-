// 009 — Colorized terminal output (ANSI)
// ANSI escape codes: ESC (0x1B, "\e" in some langs but AiLang strings use
// explicit bytes). \033 is ESC in octal. [31m = red, [32m = green, [0m = reset.
// Modern terminals honor these sequences inline.
SubRoutine.Main {
    PrintMessage("\033[31mRed text\033[0m\n")
    PrintMessage("\033[32mGreen text\033[0m\n")
    PrintMessage("\033[1;34mBold blue\033[0m\n")
    PrintMessage("Plain again\n")
}
RunTask(Main)
