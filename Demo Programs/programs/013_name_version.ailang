// 013 — Print program name and version
// In AiLang there's no compile-time macro for this; we hardcode a string
// constant. A more sophisticated program would load a VERSION file or
// accept a build-time variable.
SubRoutine.Main {
    PrintMessage("demo v0.1 — reference program #013\n")
    PrintMessage("built with AiLang\n")
}
RunTask(Main)
