// 014 — Banner / ASCII art
// Just a sequence of PrintMessage calls with carefully-aligned strings.
// The shape is preserved because each string is emitted literally.
SubRoutine.Main {
    PrintMessage("   _     _                       \n")
    PrintMessage("  / \\   (_)  |                   \n")
    PrintMessage(" / _ \\   _   |     __ _  _ __   __ _ \n")
    PrintMessage("/ ___ \\ | |  |    / _` || '_ \\ / _` |\n")
    PrintMessage("\\_/ \\_\\|_|  |___|\\__,_||_| |_|\\__, |\n")
    PrintMessage("                                |___/ \n")
}
RunTask(Main)
