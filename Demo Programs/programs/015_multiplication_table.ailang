// 015 — Multiplication table
// Two nested WhileLoops walk rows 1..5 and columns 1..5, printing
// the product each time. PrintNumber emits the integer without a newline;
// PrintMessage supplies the separators.
SubRoutine.Main {
    i = 1
    WhileLoop LessEqual(i, 5) {
        j = 1
        WhileLoop LessEqual(j, 5) {
            product = Multiply(i, j)
            PrintNumber(product)
            PrintMessage("\t")
            j = Add(j, 1)
        }
        PrintMessage("\n")
        i = Add(i, 1)
    }
}
RunTask(Main)
