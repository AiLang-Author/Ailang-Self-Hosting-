// 016 — Integer variables
// AiLang Integer is a 64-bit signed value. Assignment is `name = value`;
// arithmetic primitives operate on two Integers and produce one.
SubRoutine.Main {
    a = 10
    b = 20
    sum = Add(a, b)
    PrintMessage("a = ")
    PrintNumber(a)
    PrintMessage("\nb = ")
    PrintNumber(b)
    PrintMessage("\na + b = ")
    PrintNumber(sum)
    PrintMessage("\n")
}
RunTask(Main)
