// 018 — Boolean variables
// AiLang uses Integer 0/1 as truthy/falsy rather than a distinct Boolean
// type. Comparison primitives (EqualTo, GreaterThan, …) return 0 or 1.
// IfCondition dispatches on non-zero = true.
SubRoutine.Main {
    t = 1
    f = 0
    IfCondition EqualTo(t, 1) ThenBlock: { PrintMessage("t is true\n") }
    IfCondition EqualTo(f, 0) ThenBlock: { PrintMessage("f is false\n") }

    // Derived boolean from a comparison
    bigger = GreaterThan(5, 3)
    IfCondition EqualTo(bigger, 1) ThenBlock: { PrintMessage("5 > 3\n") }
}
RunTask(Main)
