// 019 — Character variables
// AiLang doesn't distinguish char from Integer — a character is just
// its byte value. Use GetByte to fetch a specific byte from a string,
// compare as integer, print as integer (or as a 1-byte string).
SubRoutine.Main {
    s = "ABC"
    first = GetByte(s, 0)   // 65 = 'A'
    second = GetByte(s, 1)  // 66 = 'B'

    PrintMessage("first byte value: ")
    PrintNumber(first)
    PrintMessage("\nsecond byte value: ")
    PrintNumber(second)
    PrintMessage("\ndifference (B - A): ")
    PrintNumber(Subtract(second, first))
    PrintMessage("\n")
}
RunTask(Main)
