// 020 — String variables
// AiLang strings are Address values pointing to null-terminated byte
// sequences. Assigning a string literal stores a pointer into the
// compiled program's data section.
SubRoutine.Main {
    name = "Zeus"
    greeting = "Hail, "

    PrintMessage(greeting)
    PrintMessage(name)
    PrintMessage("!\n")

    // String length queries the bytes, not characters (byte != rune)
    PrintMessage("length of name: ")
    PrintNumber(StringLength(name))
    PrintMessage("\n")
}
RunTask(Main)
