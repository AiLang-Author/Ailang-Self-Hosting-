// 021 — Constants / immutable variables
// AiLang doesn't ship a `const` keyword — every assignment is mutable.
// The convention for "this value should never change" is ALL_CAPS
// naming and a comment saying so. Same convention Python uses, same
// honor-system enforcement.
//
// The real "this is immutable" primitive lives at the pool level:
// FixedPool declares a value with CanChange=False, and the compiler
// will reject a write to it. For application code with plain values,
// the naming convention is usually enough.
SubRoutine.Main {
    // Constants by convention.
    MAX_RETRIES = 3
    PI_MILLIS = 3141    // PI × 1000, since we have no floats yet
    APP_NAME = "AiLang Demo 021"

    PrintMessage(APP_NAME)
    PrintMessage("\nMAX_RETRIES = ")
    PrintNumber(MAX_RETRIES)
    PrintMessage("\nPI×1000     = ")
    PrintNumber(PI_MILLIS)
    PrintMessage("\n")
}
RunTask(Main)
