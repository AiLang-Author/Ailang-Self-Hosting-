// 022 — Type inference
// In AiLang, plain `x = 5` infers `x` as Integer. `s = "text"` infers
// `s` as Address (pointer to a byte string). The type is settled at
// first assignment and the compiler checks subsequent uses for
// consistency.
//
// This is the same "declaration is an assignment" style Go, Rust
// (with `let`), and Python use. Function parameters DO need explicit
// Input: <name>: <type> declarations — inference doesn't cross
// function boundaries, because a function's signature is a contract
// the reader should be able to see without chasing call sites.
SubRoutine.Main {
    n = 42           // inferred Integer
    flag = 1         // inferred Integer (AiLang has no dedicated Bool)
    greeting = "hi"  // inferred Address

    PrintMessage("n = ")
    PrintNumber(n)
    PrintMessage("\nflag = ")
    PrintNumber(flag)
    PrintMessage("\ngreeting = ")
    PrintMessage(greeting)
    PrintMessage("\n")
}
RunTask(Main)
