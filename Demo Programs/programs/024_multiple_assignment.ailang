// 024 — Multiple assignment
// AiLang doesn't have tuple unpacking (no `a, b = 1, 2`). Do them
// one at a time. This is deliberate — the verbose form keeps the
// assignment order explicit and easy for a reader to parse.
SubRoutine.Main {
    x = 1
    y = 2
    z = 3
    PrintMessage("x=")
    PrintNumber(x)
    PrintMessage(" y=")
    PrintNumber(y)
    PrintMessage(" z=")
    PrintNumber(z)
    PrintMessage("\n")
}
RunTask(Main)
