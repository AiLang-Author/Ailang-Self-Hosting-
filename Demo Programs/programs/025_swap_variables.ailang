// 025 — Swap two variables
// Classic three-assignment swap via temporary. Without an atomic-swap
// primitive this is the clearest idiom; the temporary names the
// intermediate value.
SubRoutine.Main {
    a = 100
    b = 200

    PrintMessage("before: a=")
    PrintNumber(a)
    PrintMessage(" b=")
    PrintNumber(b)
    PrintMessage("\n")

    tmp = a
    a = b
    b = tmp

    PrintMessage("after:  a=")
    PrintNumber(a)
    PrintMessage(" b=")
    PrintNumber(b)
    PrintMessage("\n")
}
RunTask(Main)
