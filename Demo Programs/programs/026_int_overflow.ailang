// 026 — Integer overflow demonstration
// AiLang Integers are 64-bit signed. The largest positive value is
// 2^63 - 1 = 9_223_372_036_854_775_807. Add 1 and it wraps to the
// most negative value. Wrapping (not trapping) matches C behavior on
// two's-complement hardware — fast, predictable, and occasionally
// the source of a great debugging story.
//
// If you need overflow DETECTION, compare inputs against the max
// before the operation and decide explicitly. If you need arbitrary
// precision, that's what bigint libraries are for (Cat 2 entry 31).
SubRoutine.Main {
    max_pos = 9223372036854775807
    PrintMessage("max positive signed 64-bit: ")
    PrintNumber(max_pos)
    PrintMessage("\nmax + 1                   : ")
    PrintNumber(Add(max_pos, 1))   // wraps to most negative
    PrintMessage("\n")

    // Smaller-scale wrap — easier to spot in the output.
    // (2^31 + 1 is still comfortably inside 64-bit range, just shown
    // here to illustrate what wrapping would look like at 32 bits.)
    PrintMessage("2^31 + 1 (fits fine in 64-bit): ")
    PrintNumber(Add(2147483648, 1))
    PrintMessage("\n")
}
RunTask(Main)
