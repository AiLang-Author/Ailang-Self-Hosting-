// 028 — Scientific notation — DESIGN NOTE
// `1.5e10` literal syntax is a Float literal. AiLang, being Integer-
// first for now, doesn't parse it. If you want "fifteen billion" you
// write it as a plain Integer:
//
//     15000000000
//
// Readable for humans? Marginally — but the underscore separator
// convention (if/when AiLang adopts it, like Rust/Python) turns that
// into `15_000_000_000` with no information loss and no Float baggage.
//
// Exponential input is really three concerns that scientific notation
// bundles: a readable literal, a value large enough to overflow i32,
// and a decimal mantissa. i64 covers the first two with no magic;
// the mantissa (real decimals) waits on Float support (see 017).
SubRoutine.Main {
    // 1.5e10 as a plain Integer.
    fifteen_billion = 15000000000
    PrintMessage("fifteen billion = ")
    PrintNumber(fifteen_billion)
    PrintMessage("\n")

    // 6.022e23 would overflow i64 (max ~9.22e18). Requires bigint;
    // see 031_long_big_integers.ailang.
    PrintMessage("(6.022e23 needs bigint, not sci-notation syntax)\n")
}
RunTask(Main)
