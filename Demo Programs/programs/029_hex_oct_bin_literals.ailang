// 029 — Hexadecimal, octal, binary literals
// AiLang's Integer literals accept 0x hex prefix. All three numbers
// below represent the same underlying value (255).
SubRoutine.Main {
    decimal = 255
    hex     = 0xFF

    PrintMessage("decimal: ")
    PrintNumber(decimal)
    PrintMessage("\nhex 0xFF: ")
    PrintNumber(hex)
    PrintMessage("\n")

    // Bitwise ops also reveal the binary shape
    PrintMessage("0xFF & 0x0F = ")
    PrintNumber(BitwiseAnd(hex, 0x0F))
    PrintMessage("\n")
}
RunTask(Main)
