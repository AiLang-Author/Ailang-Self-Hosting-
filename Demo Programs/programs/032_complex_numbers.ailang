// 032 — Complex numbers — DESIGN NOTE
// A complex number is a pair (real, imag). Multiplication is the one
// non-obvious operation:
//
//   (a + bi)(c + di) = (ac - bd) + (ad + bc)i
//
// No language primitive is needed — a FixedPool holding the two
// parts + a handful of Functions is a complete complex-arithmetic
// library. The structural point: "complex" is a derived representation,
// not a fundamental type. Most languages that ship a builtin Complex
// type added it because they also had operator overloading and wanted
// `a + b` to do the right thing on them. AiLang doesn't overload, so
// there's no payoff to a builtin — a library is exactly as ergonomic.
//
// Real complex arithmetic wants Float for the components (see 017);
// this integer-only sketch shows the shape without the precision.
FixedPool.C1 {
    "re": Initialize=3
    "im": Initialize=2
}
FixedPool.C2 {
    "re": Initialize=1
    "im": Initialize=4
}
FixedPool.CResult {
    "re": Initialize=0
    "im": Initialize=0
}

SubRoutine.ComplexMul {
    // (C1.re + C1.im*i) * (C2.re + C2.im*i)
    ac = Multiply(C1.re, C2.re)
    bd = Multiply(C1.im, C2.im)
    ad = Multiply(C1.re, C2.im)
    bc = Multiply(C1.im, C2.re)
    CResult.re = Subtract(ac, bd)
    CResult.im = Add(ad, bc)
}

SubRoutine.Main {
    RunTask(ComplexMul)
    PrintMessage("(3 + 2i) * (1 + 4i) = ")
    PrintNumber(CResult.re)
    PrintMessage(" + ")
    PrintNumber(CResult.im)
    PrintMessage("i\n")
}
RunTask(Main)
