// 033 — Byte / raw byte values
// Allocate raw memory, poke bytes in, read them back. The Arena library
// provides Allocate; GetByte / SetByte operate on byte offsets directly.
LibraryImport.Arena

SubRoutine.Main {
    buf = Allocate(4)
    SetByte(buf, 0, 72)   // 'H'
    SetByte(buf, 1, 73)   // 'I'
    SetByte(buf, 2, 33)   // '!'
    SetByte(buf, 3, 0)    // null terminator

    PrintMessage("buffer contents as string: ")
    PrintMessage(buf)
    PrintMessage("\nbyte[0] = ")
    PrintNumber(GetByte(buf, 0))
    PrintMessage("\n")
}
RunTask(Main)
