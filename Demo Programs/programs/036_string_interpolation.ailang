// 036 — String interpolation — DESIGN NOTE
// Python: `f"hi {name}, you have {n} messages"`. JavaScript: template
// literals with ${...}. Swift: `\(expr)`. All three let you embed
// expressions inline in a string literal; the compiler rewrites them
// into concatenation or sprintf under the hood.
//
// AiLang's PrintMessage + PrintNumber + PrintChar cover the same
// ground without a new literal syntax: emit the static parts as
// strings, the dynamic parts as numbers or chars, in order. It reads
// slightly longer; it's also completely orthogonal — no parsing
// surprise about what counts as "inside the expression", no
// format-string escape rules to memorize, no injection class when
// the format string itself came from user input.
//
// StringConcat covers the case where you need a single String value
// (e.g. to pass to another function) rather than a stream of output.
LibraryImport.Arena

SubRoutine.Main {
    name = "Claude"
    count = 7

    // Interpolation-equivalent by composition:
    PrintMessage("hi ")
    PrintMessage(name)
    PrintMessage(", you have ")
    PrintNumber(count)
    PrintMessage(" messages\n")

    // Same in StringConcat form — builds one string.
    greeting = StringConcat(StringConcat("hi ", name), ", welcome")
    PrintMessage(greeting)
    PrintMessage("\n")
}
RunTask(Main)
