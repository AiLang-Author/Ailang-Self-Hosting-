// 037 — Multiline strings
// Two strategies in AiLang today: explicit \n escapes inside a normal
// string literal, or successive PrintMessage calls. Both produce the
// same bytes on stdout; the choice is usually about whether you need
// a single String value (use \n form) or are just emitting output
// (either works; sequential calls read more line-oriented).
//
// True triple-quoted / heredoc multi-line literals aren't in the
// grammar. If they land, they'd be pure sugar over \n — same bytes,
// nicer visual block for long licenses / help text / SQL.
SubRoutine.Main {
    // Style A — explicit \n inside one literal, one call.
    poem = "Roses are red,\nviolets are blue,\nAiLang is integer,\nand that's fine too.\n"
    PrintMessage(poem)

    PrintMessage("\n---\n\n")

    // Style B — one call per line, no escapes.
    PrintMessage("Roses are red,\n")
    PrintMessage("violets are blue,\n")
    PrintMessage("AiLang is integer,\n")
    PrintMessage("and that's fine too.\n")
}
RunTask(Main)
