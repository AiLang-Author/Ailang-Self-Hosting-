// 038 — Raw strings — DESIGN NOTE
// Python: `r"C:\Users\new"`. Go: backtick-quoted literals. Rust:
// `r"..."`, `r#"..."#`. The shared idea: a string where backslashes
// (and sometimes quotes) are taken literally, useful for regexes,
// file paths, and anywhere the escape machinery gets in the way.
//
// AiLang currently has one string-literal form — the familiar
// double-quoted one with `\n`, `\t`, `\"`, `\\` escapes. A regex
// pattern that looks like `\d+\.\d+` reads as `\\d+\\.\\d+` in
// source, doubling every backslash. It's ugly but unambiguous.
//
// A raw-string form is additive (doesn't break any existing
// literal), cheap to parse (new prefix, different lexer state),
// and a reasonable future add when regex work picks up. For now,
// the escape-heavy alternative is what's available.
SubRoutine.Main {
    // Windows-style path written with doubled backslashes.
    path = "C:\\Users\\sean\\new.txt"
    PrintMessage("path = ")
    PrintMessage(path)
    PrintMessage("\n")

    // Regex fragment matching an IPv4 dotted quad.
    ipv4_pattern = "\\d+\\.\\d+\\.\\d+\\.\\d+"
    PrintMessage("ipv4 regex = ")
    PrintMessage(ipv4_pattern)
    PrintMessage("\n")
}
RunTask(Main)
