// 039 — String to number conversion
// AiLang's core primitives DON'T include StringToInt — parsing routines
// live in libraries. This is the thin-language, thick-libraries principle:
// digit parsing is a small library function, not a compiler intrinsic.
// StringUtils.StringToInt stops at the first non-digit byte.
LibraryImport.Arena
LibraryImport.StringUtils

SubRoutine.Main {
    s = "12345"
    n = StringToInt(s)

    PrintMessage("string: ")
    PrintMessage(s)
    PrintMessage("\ninteger: ")
    PrintNumber(n)
    PrintMessage("\nx2: ")
    PrintNumber(Multiply(n, 2))
    PrintMessage("\n")
}
RunTask(Main)
