// 040 — Number to string conversion
// NumberToString returns a heap-allocated ASCII string (caller shouldn't
// free; lifetime is tied to the arena). Useful when you want to concat
// numeric output with other strings via StringConcat.
LibraryImport.Arena

SubRoutine.Main {
    n = 42
    s = NumberToString(n)

    PrintMessage("as string: ")
    PrintMessage(s)
    PrintMessage("\nstringified length: ")
    PrintNumber(StringLength(s))
    PrintMessage("\n")

    // Typical use: include a number inside a larger message
    msg = StringConcat("n is ", s)
    PrintMessage(msg)
    PrintMessage("\n")
}
RunTask(Main)
