// 041 — Arithmetic operators
// AiLang uses named primitives rather than symbol operators: Add,
// Subtract, Multiply, Divide, Modulo. Every arithmetic operation is a
// function call on two Integers, returning an Integer.
SubRoutine.Main {
    a = 20
    b = 6

    PrintMessage("a + b = ")
    PrintNumber(Add(a, b))
    PrintMessage("\na - b = ")
    PrintNumber(Subtract(a, b))
    PrintMessage("\na * b = ")
    PrintNumber(Multiply(a, b))
    PrintMessage("\na / b = ")
    PrintNumber(Divide(a, b))
    PrintMessage("\na mod b = ")
    PrintNumber(Modulo(a, b))
    PrintMessage("\n")
}
RunTask(Main)
