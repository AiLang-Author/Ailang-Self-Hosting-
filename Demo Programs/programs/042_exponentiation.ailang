// 043 — Exponentiation / power operator
// AiLang has no `**` or `^` operator for exponentiation (and never
// will — that's a library concern, see 055 for the design stance on
// operators). IntPow lives in Library.IntMath and uses repeated
// squaring: O(log exp) multiplications instead of O(exp).
LibraryImport.IntMath

SubRoutine.Main {
    PrintMessage("2^10 = ")
    PrintNumber(IntPow(2, 10))
    PrintMessage("\n3^5  = ")
    PrintNumber(IntPow(3, 5))
    PrintMessage("\n10^6 = ")
    PrintNumber(IntPow(10, 6))
    PrintMessage("\n")
}
RunTask(Main)
