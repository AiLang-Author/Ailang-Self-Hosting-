// 042 — Integer division vs float division
// Integer Divide truncates toward zero. For floating-point division use
// Float_Div from the FPU library (Float_* requires FPUCompileX86SSE);
// this example shows only the integer case since floats are a separate
// demonstration track.
SubRoutine.Main {
    a = 7
    b = 2
    PrintMessage("integer 7 / 2 = ")
    PrintNumber(Divide(a, b))         // 3, not 3.5 — integer truncation
    PrintMessage(" (truncated)\n")

    PrintMessage("integer 7 mod 2 = ")
    PrintNumber(Modulo(a, b))          // 1
    PrintMessage("\n")
}
RunTask(Main)
