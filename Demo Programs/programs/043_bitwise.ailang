// 044 — Bitwise operators
// BitwiseAnd, BitwiseOr, BitwiseXor, BitwiseNot. Operate on the full
// 64-bit Integer representation. Useful for flag packing, masking,
// and low-level byte manipulation.
SubRoutine.Main {
    a = 0x0F   // binary 00001111
    b = 0x33   // binary 00110011

    PrintMessage("a & b = ")
    PrintNumber(BitwiseAnd(a, b))   // 0x03 = 3
    PrintMessage("\na | b = ")
    PrintNumber(BitwiseOr(a, b))    // 0x3F = 63
    PrintMessage("\na ^ b = ")
    PrintNumber(BitwiseXor(a, b))   // 0x3C = 60
    PrintMessage("\n")
}
RunTask(Main)
