// 045 — Bit shift left / right
// LeftShift doubles per step (for positive values), RightShift halves.
// Shifting by N is equivalent to multiplying/dividing by 2^N, but much
// cheaper on the hardware — a single instruction vs a multiply.
SubRoutine.Main {
    n = 1
    PrintMessage("1 << 0..7:")
    i = 0
    WhileLoop LessEqual(i, 7) {
        PrintMessage(" ")
        PrintNumber(LeftShift(n, i))
        i = Add(i, 1)
    }
    PrintMessage("\n")

    big = 256
    PrintMessage("256 >> 0..4:")
    j = 0
    WhileLoop LessEqual(j, 4) {
        PrintMessage(" ")
        PrintNumber(RightShift(big, j))
        j = Add(j, 1)
    }
    PrintMessage("\n")
}
RunTask(Main)
