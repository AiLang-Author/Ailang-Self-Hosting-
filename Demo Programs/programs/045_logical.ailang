// 046 — Logical AND / OR / NOT
// And, Or, Not operate on 0/1 boolean values derived from comparisons.
// All three short-circuit is not guaranteed — they're function calls,
// both arguments are evaluated before the call.
SubRoutine.Main {
    a = 1
    b = 0

    PrintMessage("a AND b = ")
    PrintNumber(And(a, b))          // 0
    PrintMessage("\na OR b = ")
    PrintNumber(Or(a, b))           // 1
    PrintMessage("\nNOT a = ")
    PrintNumber(Not(a))             // 0
    PrintMessage("\nNOT b = ")
    PrintNumber(Not(b))             // 1
    PrintMessage("\n")

    // Combine with comparisons for predicates
    x = 10
    in_range = And(GreaterEqual(x, 0), LessEqual(x, 100))
    IfCondition EqualTo(in_range, 1) ThenBlock: {
        PrintMessage("x is in [0, 100]\n")
    }
}
RunTask(Main)
