// 047 — Comparison operators
// EqualTo, NotEqual, LessThan, GreaterThan, LessEqual, GreaterEqual.
// Each takes two Integers and returns 1 (true) or 0 (false).
//
// Note: AiLang doesn't use `;` as a statement separator — each statement
// goes on its own line. The extra vertical space is deliberate; reads
// well even when the logic chain is long.
SubRoutine.Main {
    a = 5
    b = 10

    PrintMessage("a == b: ")
    PrintNumber(EqualTo(a, b))
    PrintMessage("\n")

    PrintMessage("a != b: ")
    PrintNumber(NotEqual(a, b))
    PrintMessage("\n")

    PrintMessage("a <  b: ")
    PrintNumber(LessThan(a, b))
    PrintMessage("\n")

    PrintMessage("a >  b: ")
    PrintNumber(GreaterThan(a, b))
    PrintMessage("\n")

    PrintMessage("a <= b: ")
    PrintNumber(LessEqual(a, b))
    PrintMessage("\n")

    PrintMessage("a >= b: ")
    PrintNumber(GreaterEqual(a, b))
    PrintMessage("\n")
}
RunTask(Main)
