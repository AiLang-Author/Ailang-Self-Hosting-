// 048 — Ternary / conditional expression — DESIGN NOTE, what not to do
//
// C's `cond ? a : b` and Python's `a if cond else b` let you put a
// branch inside an expression. Compact. Also: the flow of control
// now happens inside the value you're computing, which means you're
// reading two things at once (what this returns, and when).
//
// AiLang has no ternary and no conditional-expression syntax.
// Assign inside an IfCondition, or refactor into a small function
// that returns one side or the other. Flow control stays flow
// control, value construction stays value construction.
SubRoutine.Main {
    score = 72
    label = "?"

    IfCondition GreaterEqual(score, 70) ThenBlock: {
        label = "pass"
    } ElseBlock: {
        label = "fail"
    }

    PrintMessage("score ")
    PrintNumber(score)
    PrintMessage(" -> ")
    PrintMessage(label)
    PrintMessage("\n")
}
RunTask(Main)
