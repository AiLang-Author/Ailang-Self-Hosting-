// 049 — Compound assignment operators
// C, Python, Rust, Go all give you `x += 1`, `x *= 2`, etc. — sugar for
// `x = x + 1`, `x = x * 2`. The desugaring is mechanical and the read
// is shorter. AiLang doesn't carry the sugar; you write the
// long form every time.
//
// The trade is consistency: every mutation reads the same way. A scan
// for `x =` finds every write to x — no second pattern (`x +=`, `x *=`,
// `x **=`, `x ??=`, `x ||=` …) to also grep. Worth more in a corpus
// you'll re-read than the keystrokes saved.
SubRoutine.Main {
    x = 10

    // Long form add — what += would have desugared to.
    x = Add(x, 5)
    PrintMessage("after Add(x, 5):      x = ")
    PrintNumber(x)

    x = Subtract(x, 3)
    PrintMessage("\nafter Subtract(x, 3): x = ")
    PrintNumber(x)

    x = Multiply(x, 2)
    PrintMessage("\nafter Multiply(x, 2): x = ")
    PrintNumber(x)

    x = Divide(x, 4)
    PrintMessage("\nafter Divide(x, 4):   x = ")
    PrintNumber(x)
    PrintMessage("\n")
}
RunTask(Main)
