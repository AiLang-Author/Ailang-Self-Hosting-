// 050 — Increment and decrement
// Increment(n) returns n+1; Decrement(n) returns n-1. These are standalone
// primitives — AiLang doesn't have ++/-- operators. Reassign to update:
//     n = Increment(n)
SubRoutine.Main {
    n = 10
    PrintMessage("start: ")
    PrintNumber(n)
    PrintMessage("\n")

    n = Increment(n)
    n = Increment(n)
    n = Increment(n)
    PrintMessage("after three Increment: ")
    PrintNumber(n)
    PrintMessage("\n")

    n = Decrement(n)
    PrintMessage("after one Decrement:   ")
    PrintNumber(n)
    PrintMessage("\n")
}
RunTask(Main)
