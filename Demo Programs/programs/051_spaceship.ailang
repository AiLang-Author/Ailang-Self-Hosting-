// 051 — Three-way / spaceship comparison
// AiLang doesn't ship a <=> operator, but the 3-way result is one tiny
// function. Returns -1 if a<b, 0 if equal, 1 if a>b — same semantics
// as Perl/Ruby <=>, C's strcmp, or Go's cmp.Compare.
Function.Spaceship {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(a, b) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(a, b) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    PrintMessage("cmp(3,5)  = ")
    PrintNumber(Spaceship(3, 5))
    PrintMessage("\ncmp(5,5)  = ")
    PrintNumber(Spaceship(5, 5))
    PrintMessage("\ncmp(9,5)  = ")
    PrintNumber(Spaceship(9, 5))
    PrintMessage("\n")
}
RunTask(Main)
