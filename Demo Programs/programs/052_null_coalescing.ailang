// 052 — Null coalescing (a ?? fallback)
// Languages like JS, Swift, C# ship a `??` operator that returns the
// left side if non-null, otherwise the right. AiLang has no `??` and
// never will — but the semantics live in Library.Option.OptOrDefault.
// Callers get the same behavior, spelled as a named function instead
// of a symbol that means something different in every language.
LibraryImport.Arena
LibraryImport.Option

Function.LookupAge {
    Input: id: Integer
    Output: Address
    Body: {
        // Returns Some(age) for id 1, None otherwise — simulating a
        // database lookup that may or may not have a row.
        IfCondition EqualTo(id, 1) ThenBlock: { ReturnValue(OptSome(42)) }
        ReturnValue(OptNone())
    }
}

SubRoutine.Main {
    PrintMessage("id=1, default 0:  ")
    PrintNumber(OptOrDefault(LookupAge(1), 0))
    PrintMessage("\nid=99, default 0: ")
    PrintNumber(OptOrDefault(LookupAge(99), 0))
    PrintMessage("\n")
}
RunTask(Main)
