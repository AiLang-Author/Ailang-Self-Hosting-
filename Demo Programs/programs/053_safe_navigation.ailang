// 053 — Safe navigation (a?.b?.c pattern)
// Swift/Kotlin/C#/Ruby all have some flavor of `?.` — "if the left is
// non-null, access the field, else short-circuit to null." AiLang has
// no such operator. Instead, chain Option-returning lookups and check
// OptIsSome at each step. Explicit, greppable, no hidden control flow.
LibraryImport.Arena
LibraryImport.Option

// Simulates user-by-id lookup: 1 → Some(100), else None.
Function.GetUser {
    Input: id: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(id, 1) ThenBlock: { ReturnValue(OptSome(100)) }
        ReturnValue(OptNone())
    }
}

// Simulates profile-by-user lookup: user 100 → Some(2026), else None.
Function.GetProfileYear {
    Input: user: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(user, 100) ThenBlock: { ReturnValue(OptSome(2026)) }
        ReturnValue(OptNone())
    }
}

// Chain: GetUser(id)?.GetProfileYear — return Some(year) or None.
Function.LookupYear {
    Input: id: Integer
    Output: Address
    Body: {
        user_opt = GetUser(id)
        IfCondition OptIsNone(user_opt) ThenBlock: { ReturnValue(OptNone()) }
        ReturnValue(GetProfileYear(OptValue(user_opt)))
    }
}

SubRoutine.Main {
    PrintMessage("LookupYear(1):  ")
    PrintNumber(OptOrDefault(LookupYear(1), -1))
    PrintMessage("\nLookupYear(99): ")
    PrintNumber(OptOrDefault(LookupYear(99), -1))
    PrintMessage("\n")
}
RunTask(Main)
