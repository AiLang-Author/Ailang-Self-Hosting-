// 054 — Walrus / assignment expression — DESIGN NOTE, what not to do
//
// Python's walrus (`:=`) lets you assign inside an expression:
//     if (n := len(data)) > 10: ...
// which binds `n` AND tests it in the same line. Readable for the
// author, surprising for the reader — now you're parsing "where did
// n come from" in the middle of a conditional.
//
// AiLang assignments are statements only. If you want to bind and
// test, do it on two lines. One intent per line:
//     n = Length(data)
//     IfCondition GreaterThan(n, 10) ThenBlock: { ... }
//
// This costs one extra line. In exchange, any reader can scan down
// the file and see "variables get introduced in assignments, period"
// — no hunting for sneaky bindings inside expressions. 50-year code
// needs to be readable by people who weren't there when it was
// written.

SubRoutine.Main {
    // The AiLang way — assign, then branch.
    data_len = 42
    IfCondition GreaterThan(data_len, 10) ThenBlock: {
        PrintMessage("length ")
        PrintNumber(data_len)
        PrintMessage(" exceeds threshold\n")
    }
}
RunTask(Main)
