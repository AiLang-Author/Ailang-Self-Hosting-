// 055 — Operator precedence — DESIGN NOTE, what not to do
//
// In C, `a + b * c - d / e % f` resolves via a precedence table that
// takes a reference card to get right. Add to that right-associative
// assignment, ternary, bitwise ops, pointer deref, and you've got a
// language where reading an expression means running a mental parser.
//
// AiLang has PEMDAS + left-to-right, and that's it. No per-operator
// precedence table, no user-configurable precedence, no operator
// overloading. Instead: nest function calls. The AST IS the
// precedence — there's nothing left to memorize.
//
// Verbose? Yes. Unambiguous? Also yes. The tree is visible in the
// source, which is the whole point.
SubRoutine.Main {
    a = 2
    b = 3
    c = 4
    d = 10
    e = 2
    f = 3

    // The C expression `a + b * c - d / e % f` reads with 3 different
    // precedence levels. In AiLang you spell out the tree:
    //   (a) + ((b * c) - ((d / e) % f))
    result = Add(a, Subtract(Multiply(b, c), Modulo(Divide(d, e), f)))

    PrintMessage("a+b*c-d/e%f = ")
    PrintNumber(result)   // 2 + (12 - (5 % 3)) = 2 + (12 - 2) = 12
    PrintMessage("\n")
}
RunTask(Main)
