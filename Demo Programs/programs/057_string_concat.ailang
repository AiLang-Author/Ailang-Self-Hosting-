// 057 — String concatenation
// No `+` operator for strings — StringConcat is the primitive. Result is
// heap-allocated from the arena; repeated concat in a tight loop allocates
// each step (use a buffer if you care about throughput).
LibraryImport.Arena

SubRoutine.Main {
    greeting = StringConcat("Hello, ", "AiLang!")
    PrintMessage(greeting)
    PrintMessage("\n")

    // Three-way concat is two calls
    name = "Sean"
    line = StringConcat(StringConcat("Welcome back, ", name), ".")
    PrintMessage(line)
    PrintMessage("\n")
}
RunTask(Main)
