// 058 — Membership test ("in" / contains)
// AiLang has no generic `in` operator. For strings, StringUtils provides
// StringContains which returns 1/0. Category 6+ will cover array/set
// membership once we hit the array demos.
LibraryImport.Arena
LibraryImport.StringUtils

SubRoutine.Main {
    sentence = "the quick brown fox"

    PrintMessage("'fox' in sentence: ")
    PrintNumber(StringContains(sentence, "fox"))
    PrintMessage("\n'cat' in sentence: ")
    PrintNumber(StringContains(sentence, "cat"))
    PrintMessage("\n")
}
RunTask(Main)
