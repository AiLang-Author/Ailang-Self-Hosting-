// 061 — if / else if / else
// AiLang has no dedicated `elif`. Chain by nesting an IfCondition inside
// an ElseBlock. The indentation pyramids slightly but the control flow is
// identical to languages that provide `elif`/`else if`.
SubRoutine.Main {
    score = 72

    IfCondition GreaterEqual(score, 90) ThenBlock: {
        PrintMessage("grade: A\n")
    } ElseBlock: {
        IfCondition GreaterEqual(score, 80) ThenBlock: {
            PrintMessage("grade: B\n")
        } ElseBlock: {
            IfCondition GreaterEqual(score, 70) ThenBlock: {
                PrintMessage("grade: C\n")
            } ElseBlock: {
                IfCondition GreaterEqual(score, 60) ThenBlock: {
                    PrintMessage("grade: D\n")
                } ElseBlock: {
                    PrintMessage("grade: F\n")
                }
            }
        }
    }
}
RunTask(Main)
