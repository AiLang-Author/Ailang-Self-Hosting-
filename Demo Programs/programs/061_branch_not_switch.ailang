// 062 — Branch (AiLang's N-way value dispatch, NOT a switch)
//
// Looks like a switch statement at first glance. It isn't — or more
// precisely, it's what switch should have been all along, minus the
// C baggage:
//
//   * No fallthrough. Each Case is its own block. Control leaves the
//     Branch when the arm finishes. No `break` keyword, no bug class
//     for "I forgot the break."
//   * No integer-only restriction. The tested expression is a plain
//     AiLang value; the Case keys are compile-time constants.
//   * No default-required warning. Default is optional when the
//     Cases genuinely cover every value you care about.
//   * No coercion. Branch doesn't do C's "promote small enum to int,
//     then match against implicit ints" guessing.
//
// In short: Branch answers the question "WHICH VALUE is this?" When
// the question you're asking is instead "IS THIS TRUE?" (a yes/no
// dispatch), reach for Fork — see fork_not_switch.ailang. The two
// constructs are orthogonal, not redundant.
SubRoutine.Main {
    day = 3
    name = "?"

    Branch day {
        Case 1: { name = "Monday" }
        Case 2: { name = "Tuesday" }
        Case 3: { name = "Wednesday" }
        Case 4: { name = "Thursday" }
        Case 5: { name = "Friday" }
        Case 6: { name = "Saturday" }
        Case 7: { name = "Sunday" }
        Default: { name = "invalid day" }
    }

    PrintMessage("day ")
    PrintNumber(day)
    PrintMessage(" is ")
    PrintMessage(name)
    PrintMessage("\n")
}
RunTask(Main)
