// 062 — Switch / match / case (Branch statement)
// AiLang spells this `Branch <expr> { Case K: { ... } Default: { ... } }`.
// Cases do NOT fall through — each arm is its own block.
SubRoutine.Main {
    day = 3

    Branch day {
        Case 1: { PrintMessage("Monday\n") }
        Case 2: { PrintMessage("Tuesday\n") }
        Case 3: { PrintMessage("Wednesday\n") }
        Case 4: { PrintMessage("Thursday\n") }
        Case 5: { PrintMessage("Friday\n") }
        Default: { PrintMessage("Weekend\n") }
    }
}
RunTask(Main)
