// 063 — Switch with fallthrough — DESIGN NOTE, what not to do
//
// C inherited from assembly: a `case` without a `break` falls through
// to the next case. Decades of "missing break" bugs later, most modern
// C-derived languages flipped the default to no-fallthrough (Swift,
// Rust, Go with an explicit `fallthrough` keyword). Even with the
// explicit keyword, it's a feature most users never reach for.
//
// AiLang's Branch/Case never falls through. Each Case is an isolated
// arm; control leaves the Branch as soon as the arm finishes. No
// keyword needed, no bug class to memorize. If you really need two
// values to share behavior, put the shared work in a SubRoutine and
// call it from both arms.
SubRoutine.Main {
    day = 6
    kind = "?"

    Branch day {
        Case 1: { kind = "weekday" }
        Case 2: { kind = "weekday" }
        Case 3: { kind = "weekday" }
        Case 4: { kind = "weekday" }
        Case 5: { kind = "weekday" }
        Case 6: { kind = "weekend" }
        Case 7: { kind = "weekend" }
        Default: { kind = "invalid" }
    }

    PrintMessage("day ")
    PrintNumber(day)
    PrintMessage(" is a ")
    PrintMessage(kind)
    PrintMessage("\n")
}
RunTask(Main)
