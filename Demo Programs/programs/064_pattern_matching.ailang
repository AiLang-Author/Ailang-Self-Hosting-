// 064 — Pattern matching (via Branch)
// Many languages bundle "match this value against shapes, optionally
// destructuring on success" into one keyword (Rust `match`, OCaml
// `match`, Scala `match`). AiLang takes the same idea apart:
//
//   * Branch handles "WHICH VALUE is this?" (see 062).
//   * Destructuring is a separate concern — pull fields out of a
//     FixedPool by name when you need them.
//
// The pieces stay independent. There is no destructuring `match` arm
// because there is no value-shape system to destructure against —
// FixedPool field access is already as direct as it gets.
FixedPool.Token {
    "kind": Initialize=0       // 0=Number, 1=Op, 2=Eof
    "value": Initialize=0
}

SubRoutine.Main {
    Token.kind = 1
    Token.value = 43           // '+'

    Branch Token.kind {
        Case 0: {
            PrintMessage("number ")
            PrintNumber(Token.value)
            PrintMessage("\n")
        }
        Case 1: {
            PrintMessage("operator ")
            PrintChar(Token.value)
            PrintMessage("\n")
        }
        Case 2: { PrintMessage("end of input\n") }
        Default: { PrintMessage("unknown token kind\n") }
    }
}
RunTask(Main)
