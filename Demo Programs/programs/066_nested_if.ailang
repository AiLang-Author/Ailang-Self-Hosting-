// 066 — Nested if statements
// Two-variable decision tree: outer check narrows, inner check refines.
// Readable but — see 065 — prefer guard clauses when the nesting gets
// deeper than this.
SubRoutine.Main {
    age = 25
    has_license = 1

    IfCondition GreaterEqual(age, 18) ThenBlock: {
        IfCondition EqualTo(has_license, 1) ThenBlock: {
            PrintMessage("allowed to drive\n")
        } ElseBlock: {
            PrintMessage("old enough, no license\n")
        }
    } ElseBlock: {
        PrintMessage("too young\n")
    }
}
RunTask(Main)
