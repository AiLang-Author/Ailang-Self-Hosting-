// Fork — AiLang's binary condition dispatch (companion to 061/062)
//
// Now numbered 067 in the clean 001-132 teaching sequence.
// This slots beside 061_branch_not_switch.ailang and 062_switch_case.ailang
// as the other half of AiLang's decision-construct story. The 500-list
// only asked for "switch," but AiLang has TWO specialized constructs
// where C has one overloaded one.
//
// Fork asks: "IS THIS TRUE?"  Two outcomes, TrueBlock and FalseBlock.
// No Case keys, no fallthrough question, no coercing a boolean into
// `switch(flag)` with `case 0:` / `case 1:` ceremony. Reading the
// source, "Fork flag" telegraphs binary-choice at first glance in a
// way that IfCondition can't — IfCondition might be followed by an
// ElseBlock or it might not, so you scan further. Fork advertises
// its two-arm-ness in its name.
//
// The real power shows up in COMPOSITION. Branch outer + Fork inner
// reads top-to-bottom as "first the what, then the whether" — see
// the second example below. Nested IfConditions to do the same work
// would bury the intent.

// ── Example 1: plain Fork ───────────────────────────────────────────
SubRoutine.DemoFork {
    has_license = 1

    Fork has_license TrueBlock: {
        PrintMessage("licensed — good to drive\n")
    } FalseBlock: {
        PrintMessage("not licensed — no driving\n")
    }
}

// ── Example 2: Branch + Fork composed ───────────────────────────────
// "First dispatch on the transport MODE (Branch — which value?),
// then within each mode dispatch on WHETHER it's rush hour (Fork —
// is this true?)." Flat, greppable, intent-revealing.
SubRoutine.DemoComposed {
    mode = 2      // 1=walk, 2=drive, 3=train
    rush_hour = 1

    Branch mode {
        Case 1: {
            Fork rush_hour TrueBlock: {
                PrintMessage("walking, rush hour — sidewalks crowded\n")
            } FalseBlock: {
                PrintMessage("walking, off-peak — pleasant stroll\n")
            }
        }
        Case 2: {
            Fork rush_hour TrueBlock: {
                PrintMessage("driving, rush hour — traffic jam\n")
            } FalseBlock: {
                PrintMessage("driving, off-peak — clear roads\n")
            }
        }
        Case 3: {
            Fork rush_hour TrueBlock: {
                PrintMessage("train, rush hour — standing room only\n")
            } FalseBlock: {
                PrintMessage("train, off-peak — seat with a view\n")
            }
        }
        Default: { PrintMessage("unknown mode\n") }
    }
}

RunTask(DemoFork)
PrintMessage("---\n")
RunTask(DemoComposed)
