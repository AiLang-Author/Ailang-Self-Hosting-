// Fork + Branch — combinatorial use (off-list companion demo)
//
// Companion to 061_branch_not_switch.ailang, 062_switch_case.ailang,
// and 067_fork_not_switch.ailang (now in the clean 001-132 sequence).
// Those showed the constructs in isolation; this one is the part
// where people go "oh, now I see it." A multi-axis decision tree
// where Fork and Branch alternate based on what question each level
// is actually asking.
//
// Scenario: combat-action resolver for a text adventure. A single
// player turn dispatches over six axes — six is the AiLang
// function-parameter limit, and it's plenty for a real decision tree:
//
//     action        : attack | defend | cast | item | flee  (Branch 5)
//     in_combat?    : yes/no                                 (Fork)
//     target_alive? : yes/no                                 (Fork)
//     spell_school  : 0=none | 1=offensive | 2=heal | 3=util (Branch)
//     item_kind     : 0=none | 1=weapon | 2=potion | 3=scroll(Branch)
//     hp_low?       : yes/no                                 (Fork)
//
// Shared scenario state lives in a FixedPool so the Show subroutine
// can read it and the driver code can write it — the canonical
// AiLang pattern for "this data is visible across call sites."
// Plain top-level variables don't reliably cross the SubRoutine
// boundary for mutable state; FixedPool gives them a named home.
//
// In C you'd write the dispatcher as a switch-over-action containing
// if-else chains containing nested switches — three kinds of syntax
// for three kinds of dispatch, plus `break` ceremony everywhere. In
// AiLang each level uses the construct whose NAME matches the
// question being asked: Branch for "which value," Fork for "is this
// true." Reading top-to-bottom, the intent is visible without
// decoding.
Function.ResolveAction {
    Input: action: Integer        // 1=attack 2=defend 3=cast 4=item 5=flee
    Input: in_combat: Integer     // 0/1
    Input: target_alive: Integer  // 0/1
    Input: spell_school: Integer  // 1=offensive 2=heal 3=util (0 = n/a)
    Input: item_kind: Integer     // 1=weapon 2=potion 3=scroll (0 = n/a)
    Input: hp_low: Integer        // 0/1
    Output: Integer
    Body: {
        outcome = 99

        Branch action {
            Case 1: {               // ─── ATTACK ────────────────────
                Fork in_combat TrueBlock: {
                    Fork target_alive TrueBlock: {
                        outcome = 10               // strike lands
                    } FalseBlock: {
                        outcome = 11               // target already dead
                    }
                } FalseBlock: {
                    outcome = 12                   // not in combat
                }
            }
            Case 2: {               // ─── DEFEND ────────────────────
                Fork in_combat TrueBlock: {
                    outcome = 20                   // shield up
                } FalseBlock: {
                    outcome = 21                   // defending nothing
                }
            }
            Case 3: {               // ─── CAST ──────────────────────
                Branch spell_school {
                    Case 1: {                       // offensive
                        Fork in_combat TrueBlock: {
                            Fork target_alive TrueBlock: {
                                outcome = 30       // fireball lands
                            } FalseBlock: {
                                outcome = 31       // wasted on corpse
                            }
                        } FalseBlock: {
                            outcome = 32           // combat spell OOC
                        }
                    }
                    Case 2: {                       // healing
                        Fork hp_low TrueBlock: {
                            outcome = 33           // heal meaningful
                        } FalseBlock: {
                            outcome = 34           // heal wasted
                        }
                    }
                    Case 3: {                       // utility
                        outcome = 35               // light / detect
                    }
                    Default: { outcome = 36 }      // unknown school
                }
            }
            Case 4: {               // ─── USE ITEM ─────────────────
                Branch item_kind {
                    Case 1: {                       // weapon
                        Fork in_combat TrueBlock: {
                            outcome = 40           // draw mid-fight
                        } FalseBlock: {
                            outcome = 41           // calm equip
                        }
                    }
                    Case 2: {                       // potion
                        Fork hp_low TrueBlock: {
                            outcome = 42           // saves life
                        } FalseBlock: {
                            outcome = 43           // wasted
                        }
                    }
                    Case 3: {                       // scroll
                        Fork in_combat TrueBlock: {
                            outcome = 44           // scroll in fight
                        } FalseBlock: {
                            outcome = 45           // utility scroll
                        }
                    }
                    Default: { outcome = 46 }      // no such item
                }
            }
            Case 5: {               // ─── FLEE ──────────────────────
                Fork in_combat TrueBlock: {
                    outcome = 50                   // flee attempt
                } FalseBlock: {
                    outcome = 51                   // nothing to flee
                }
            }
            Default: { outcome = 99 }              // unknown action
        }

        ReturnValue(outcome)
    }
}

// Pretty-print the outcome code.
Function.OutcomeMessage {
    Input: code: Integer
    Output: Address
    Body: {
        Branch code {
            Case 10: { ReturnValue("weapon strike connects") }
            Case 11: { ReturnValue("target is already dead") }
            Case 12: { ReturnValue("nothing to attack") }
            Case 20: { ReturnValue("you raise your shield") }
            Case 21: { ReturnValue("defending against nothing") }
            Case 30: { ReturnValue("fireball engulfs the enemy") }
            Case 31: { ReturnValue("offensive spell wasted on corpse") }
            Case 32: { ReturnValue("offensive spell fizzles OOC") }
            Case 33: { ReturnValue("healing light restores you") }
            Case 34: { ReturnValue("healing wasted — full HP") }
            Case 35: { ReturnValue("utility spell takes effect") }
            Case 36: { ReturnValue("unknown spell school") }
            Case 40: { ReturnValue("draw weapon mid-fight") }
            Case 41: { ReturnValue("equip weapon calmly") }
            Case 42: { ReturnValue("potion saves your life") }
            Case 43: { ReturnValue("potion wasted at full HP") }
            Case 44: { ReturnValue("scroll blasts the enemy") }
            Case 45: { ReturnValue("utility scroll triggers") }
            Case 46: { ReturnValue("you don't have that item") }
            Case 50: { ReturnValue("you flee!") }
            Case 51: { ReturnValue("nothing to flee from") }
            Default: { ReturnValue("invalid outcome") }
        }
        ReturnValue("??")
    }
}

// Shared scenario state — declared right next to the SubRoutine that
// reads it. FixedPool fields are addressed as Pool.field; assignments
// from top-level driver code and reads from inside Show both work.
FixedPool.Scenario {
    "label": Initialize=""
    "action": Initialize=0
    "in_combat": Initialize=0
    "target_alive": Initialize=0
    "spell_school": Initialize=0
    "item_kind": Initialize=0
    "hp_low": Initialize=0
}

SubRoutine.Show {
    PrintMessage(Scenario.label)
    PrintMessage(" -> ")
    code = ResolveAction(Scenario.action, Scenario.in_combat,
                         Scenario.target_alive, Scenario.spell_school,
                         Scenario.item_kind, Scenario.hp_low)
    PrintNumber(code)
    PrintMessage(" : ")
    PrintMessage(OutcomeMessage(code))
    PrintMessage("\n")
}

PrintMessage("=== combat action resolver ===\n")

// Attack paths
Scenario.label = "swing sword at orc    "
Scenario.action = 1
Scenario.in_combat = 1
Scenario.target_alive = 1
RunTask(Show)

Scenario.label = "attack dead rat       "
Scenario.target_alive = 0
RunTask(Show)

Scenario.label = "attack while OOC      "
Scenario.in_combat = 0
RunTask(Show)

// Defend paths
Scenario.label = "defend vs goblin      "
Scenario.action = 2
Scenario.in_combat = 1
RunTask(Show)

Scenario.label = "defend in peaceful    "
Scenario.in_combat = 0
RunTask(Show)

// Cast paths
Scenario.label = "fireball at orc       "
Scenario.action = 3
Scenario.in_combat = 1
Scenario.target_alive = 1
Scenario.spell_school = 1
RunTask(Show)

Scenario.label = "fireball at corpse    "
Scenario.target_alive = 0
RunTask(Show)

Scenario.label = "heal at low HP        "
Scenario.in_combat = 0
Scenario.spell_school = 2
Scenario.hp_low = 1
RunTask(Show)

Scenario.label = "heal at full HP       "
Scenario.hp_low = 0
RunTask(Show)

Scenario.label = "utility spell         "
Scenario.spell_school = 3
RunTask(Show)

// Item paths
Scenario.label = "equip sword mid-fight "
Scenario.action = 4
Scenario.in_combat = 1
Scenario.spell_school = 0
Scenario.item_kind = 1
RunTask(Show)

Scenario.label = "potion at low HP      "
Scenario.in_combat = 0
Scenario.item_kind = 2
Scenario.hp_low = 1
RunTask(Show)

Scenario.label = "potion at full HP     "
Scenario.hp_low = 0
RunTask(Show)

Scenario.label = "scroll in combat      "
Scenario.in_combat = 1
Scenario.item_kind = 3
RunTask(Show)

// Flee paths
Scenario.label = "flee from combat      "
Scenario.action = 5
Scenario.item_kind = 0
RunTask(Show)

Scenario.label = "flee from nothing     "
Scenario.in_combat = 0
RunTask(Show)
