// 067 — Index-based for loop
// AiLang's WhileLoop is the canonical counted loop. A traditional `for`
// is just init + cond + step, all written out:
//    i = 0                  // init
//    WhileLoop LessThan(i, N)  // cond
//        ...body...
//        i = Add(i, 1)      // step
SubRoutine.Main {
    i = 0
    WhileLoop LessThan(i, 5) {
        PrintMessage("i = ")
        PrintNumber(i)
        PrintMessage("\n")
        i = Add(i, 1)
    }
}
RunTask(Main)
