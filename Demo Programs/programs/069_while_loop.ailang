// 069 — while loop
// WhileLoop evaluates its condition before each iteration; loop body
// runs zero-or-more times. Classic "consume a counter" pattern:
SubRoutine.Main {
    remaining = 5
    WhileLoop GreaterThan(remaining, 0) {
        PrintMessage("remaining = ")
        PrintNumber(remaining)
        PrintMessage("\n")
        remaining = Subtract(remaining, 1)
    }
    PrintMessage("done\n")
}
RunTask(Main)
