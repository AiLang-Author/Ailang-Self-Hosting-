// 070 — do-while / repeat-until
// UntilCondition is reserved in the grammar but not yet parsed. The
// idiomatic workaround is `WhileLoop 1 { ... BreakLoop }` — a truly
// infinite loop that exits on a condition checked inside. Body always
// runs at least once, which is the do-while contract.
SubRoutine.Main {
    count = 0
    WhileLoop 1 {
        PrintMessage("count = ")
        PrintNumber(count)
        PrintMessage("\n")
        count = Add(count, 1)
        IfCondition GreaterEqual(count, 3) ThenBlock: { BreakLoop }
    }
    PrintMessage("final: ")
    PrintNumber(count)
    PrintMessage("\n")
}
RunTask(Main)
