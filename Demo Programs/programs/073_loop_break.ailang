// 071 — loop with break
// BreakLoop exits the innermost enclosing loop. Useful to stop scanning
// once a target is found.
SubRoutine.Main {
    target = 7
    i = 0
    found_at = -1

    WhileLoop LessThan(i, 100) {
        IfCondition EqualTo(i, target) ThenBlock: {
            found_at = i
            BreakLoop
        }
        i = Add(i, 1)
    }

    PrintMessage("found at: ")
    PrintNumber(found_at)
    PrintMessage("\n")
}
RunTask(Main)
