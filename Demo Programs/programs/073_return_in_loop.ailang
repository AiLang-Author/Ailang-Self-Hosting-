// 073 — return inside a loop
// ReturnValue from inside a loop body unwinds both the loop and the
// enclosing function in one step. Common in search functions: found it,
// return the index, don't bother running the rest.
Function.FirstDivisibleBy {
    Input: start: Integer
    Input: end: Integer
    Input: divisor: Integer
    Output: Integer
    Body: {
        i = start
        WhileLoop LessThan(i, end) {
            IfCondition EqualTo(Modulo(i, divisor), 0) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

SubRoutine.Main {
    PrintMessage("first mult of 7 in [10,50): ")
    PrintNumber(FirstDivisibleBy(10, 50, 7))
    PrintMessage("\n")

    PrintMessage("first mult of 99 in [1,50): ")
    PrintNumber(FirstDivisibleBy(1, 50, 99))
    PrintMessage("\n")
}
RunTask(Main)
