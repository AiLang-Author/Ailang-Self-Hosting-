// 074 — loop with continue
// ContinueLoop skips the rest of the body and jumps back to the next
// iteration. Note: you must still advance your counter BEFORE continuing
// or you'll get an infinite loop (AiLang WhileLoop has no implicit step).
SubRoutine.Main {
    i = 0
    sum_odd = 0

    WhileLoop LessThan(i, 10) {
        i = Add(i, 1)
        // Skip evens before doing the main-body work.
        IfCondition EqualTo(Modulo(i, 2), 0) ThenBlock: { ContinueLoop }
        sum_odd = Add(sum_odd, i)
    }

    PrintMessage("sum of odd 1..10: ")
    PrintNumber(sum_odd)   // 1+3+5+7+9 = 25
    PrintMessage("\n")
}
RunTask(Main)
