// 075 — Infinite loop with an exit condition
// `WhileLoop 1` is the canonical infinite loop. Exit via BreakLoop or
// ReturnValue when the termination condition becomes true. Useful when
// the exit condition is awkward to check at the top of the loop (e.g.
// depends on a side-effect from inside the body).
SubRoutine.Main {
    n = 1
    WhileLoop 1 {
        PrintMessage("n = ")
        PrintNumber(n)
        PrintMessage("\n")
        IfCondition GreaterThan(n, 4) ThenBlock: { BreakLoop }
        n = Multiply(n, 2)
    }
    PrintMessage("escaped\n")
}
RunTask(Main)
