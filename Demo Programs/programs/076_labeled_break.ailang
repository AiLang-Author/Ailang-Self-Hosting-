// 074 — Labeled break / continue — DESIGN NOTE, what not to do
//
// Java, Perl, Rust, and others let you label loops and break out of a
// specific one: `break outer;`. Solves the nested-break problem
// elegantly — and introduces a new identifier namespace, plus control
// flow that jumps to a label defined many lines above. Readers
// scanning a loop body now have to look up where `outer` is defined.
//
// AiLang keeps BreakLoop scoped to the innermost loop and uses a
// plain variable as the "should I keep going" flag for outer loops
// (see 077_nested_break.ailang for the idiom). One fewer concept,
// one fewer thing to grep for.
SubRoutine.Main {
    found = 0
    i = 0
    WhileLoop LessThan(i, 5) {
        j = 0
        WhileLoop LessThan(j, 5) {
            IfCondition EqualTo(Add(Multiply(i, 10), j), 23) ThenBlock: {
                found = 1
                BreakLoop
            }
            j = Add(j, 1)
        }
        IfCondition EqualTo(found, 1) ThenBlock: { BreakLoop }
        i = Add(i, 1)
    }

    PrintMessage("found 23 at i=")
    PrintNumber(i)
    PrintMessage(" j=")
    PrintNumber(j)
    PrintMessage("\n")
}
RunTask(Main)
