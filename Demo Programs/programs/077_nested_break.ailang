// 077 — Breaking out of nested loops
// AiLang's BreakLoop only exits the innermost loop. To bail out of the
// outer loop too, set a "found" sentinel and check it after the inner
// loop returns. (The labeled-break convention some languages offer would
// collapse this to one break.)
SubRoutine.Main {
    target = 23
    found = 0

    i = 0
    WhileLoop LessThan(i, 10) {
        j = 0
        WhileLoop LessThan(j, 10) {
            candidate = Add(Multiply(i, 10), j)
            IfCondition EqualTo(candidate, target) ThenBlock: {
                PrintMessage("match at i=")
                PrintNumber(i)
                PrintMessage(" j=")
                PrintNumber(j)
                PrintMessage("\n")
                found = 1
                BreakLoop
            }
            j = Add(j, 1)
        }
        IfCondition EqualTo(found, 1) ThenBlock: { BreakLoop }
        i = Add(i, 1)
    }
}
RunTask(Main)
