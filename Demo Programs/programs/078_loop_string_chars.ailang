// 078 — Loop over string characters
// A string is a null-terminated byte buffer. Walk it with GetByte and
// stop when you hit the 0 byte (or use StringLength if you prefer a
// counted loop). Shown here: count vowels.
SubRoutine.Main {
    s = "the quick brown fox"
    i = 0
    vowels = 0

    WhileLoop 1 {
        c = GetByte(s, i)
        IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
        is_vowel = Or(Or(EqualTo(c, 97), EqualTo(c, 101)),
                      Or(EqualTo(c, 105), Or(EqualTo(c, 111), EqualTo(c, 117))))
        IfCondition EqualTo(is_vowel, 1) ThenBlock: {
            vowels = Add(vowels, 1)
        }
        i = Add(i, 1)
    }

    PrintMessage("vowels in '")
    PrintMessage(s)
    PrintMessage("' = ")
    PrintNumber(vowels)
    PrintMessage("\n")
}
RunTask(Main)
