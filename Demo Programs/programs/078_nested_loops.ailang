// 076 — Nested loops
// The classic multiplication-table shape: outer loop walks rows, inner
// loop walks columns. Total iterations = outer_count × inner_count.
SubRoutine.Main {
    i = 1
    WhileLoop LessEqual(i, 3) {
        j = 1
        WhileLoop LessEqual(j, 3) {
            PrintMessage("(")
            PrintNumber(i)
            PrintMessage(",")
            PrintNumber(j)
            PrintMessage(") ")
            j = Add(j, 1)
        }
        PrintMessage("\n")
        i = Add(i, 1)
    }
}
RunTask(Main)
