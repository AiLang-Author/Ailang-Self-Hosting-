// 080 — Loop over map keys and values — DESIGN NOTE
// Most languages ship a hash-map / dictionary type with a defined
// iteration order (or none — Go famously randomizes). AiLang doesn't
// have a built-in map type today; the canonical key→value structure
// is a FixedPool, where field names are the keys and field values
// are the values.
//
// Pool fields are static — declared at compile time, not added at
// runtime — so a "loop over keys" reads as a sequence of named
// accesses, not a runtime traversal. When dynamic key sets are
// genuinely needed, two parallel arrays (keys[], values[]) walked
// with a WhileLoop is the pattern.
FixedPool.Inventory {
    "potions": Initialize=12
    "swords":  Initialize=3
    "shields": Initialize=2
    "gold":    Initialize=487
}

SubRoutine.Main {
    PrintMessage("inventory:\n")

    PrintMessage("  potions = ")
    PrintNumber(Inventory.potions)
    PrintMessage("\n  swords  = ")
    PrintNumber(Inventory.swords)
    PrintMessage("\n  shields = ")
    PrintNumber(Inventory.shields)
    PrintMessage("\n  gold    = ")
    PrintNumber(Inventory.gold)
    PrintMessage("\n")
}
RunTask(Main)
