// 081 — Reverse loop
// Same counted-loop shape as 067, just decrement the counter instead of
// incrementing. Exit when you cross the lower bound.
SubRoutine.Main {
    i = 5
    WhileLoop GreaterEqual(i, 1) {
        PrintMessage("i = ")
        PrintNumber(i)
        PrintMessage("\n")
        i = Subtract(i, 1)
    }
}
RunTask(Main)
