// 082 — Step loop (every N)
// Languages with a `step` clause (Python's range(a,b,step), BASIC's
// FOR…STEP) compress this to one line. In AiLang, just change the
// increment. Shown: evens from 0..20.
SubRoutine.Main {
    i = 0
    WhileLoop LessEqual(i, 20) {
        PrintNumber(i)
        PrintMessage(" ")
        i = Add(i, 2)
    }
    PrintMessage("\n")
}
RunTask(Main)
