// 083 — Zip two collections in a loop
// "Walk two sequences in lockstep" without materializing a list of
// pairs. AiLang spelling: one WhileLoop, one shared index, two
// indexed reads per iteration.
//
// When the two collections live in parallel FixedPools (the AiLang
// equivalent of "two arrays"), the pattern is exactly:
//
//     i = 0
//     WhileLoop LessThan(i, N) {
//         use A[i] and B[i]
//         i = Add(i, 1)
//     }
//
// FixedPools don't support indexed access by a runtime variable, so
// the loop body needs a Branch on i to pick the right field. This
// is verbose enough that XArrays (when needed at scale) are usually
// the right answer for genuinely indexed data.
FixedPool.Names {
    "v0": Initialize="alice"
    "v1": Initialize="bob"
    "v2": Initialize="carol"
}
FixedPool.Scores {
    "v0": Initialize=92
    "v1": Initialize=78
    "v2": Initialize=85
}

SubRoutine.Main {
    i = 0
    WhileLoop LessThan(i, 3) {
        Branch i {
            Case 0: {
                PrintMessage(Names.v0)
                PrintMessage(" -> ")
                PrintNumber(Scores.v0)
            }
            Case 1: {
                PrintMessage(Names.v1)
                PrintMessage(" -> ")
                PrintNumber(Scores.v1)
            }
            Case 2: {
                PrintMessage(Names.v2)
                PrintMessage(" -> ")
                PrintNumber(Scores.v2)
            }
        }
        PrintMessage("\n")
        i = Add(i, 1)
    }
}
RunTask(Main)
