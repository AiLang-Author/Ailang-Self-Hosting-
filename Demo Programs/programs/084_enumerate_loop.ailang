// 084 — Enumerate (index + value) loop
// Python's `enumerate(xs)` yields (index, value) pairs. AiLang: just
// carry the index alongside the iteration. Demonstrated on a string,
// so "value" is the byte at each position.
SubRoutine.Main {
    s = "ailang"
    i = 0
    WhileLoop 1 {
        c = GetByte(s, i)
        IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
        PrintMessage("[")
        PrintNumber(i)
        PrintMessage("] = ")
        PrintNumber(c)
        PrintMessage("\n")
        i = Add(i, 1)
    }
}
RunTask(Main)
