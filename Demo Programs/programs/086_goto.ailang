// 086 — Goto — DESIGN NOTE, what not to do
//
// Dijkstra, 1968: "Go To Statement Considered Harmful." The argument
// has only gotten stronger since. Modern C and Go retain `goto` for
// resource-cleanup shortcuts in the kernel / stdlib, but in
// application code it is a way to build flow charts nobody can
// review.
//
// AiLang has no goto. The tools you actually need — early return,
// break, continue, exception unwind via TryBlock — are all here, and
// each one has bounded scope you can read from the call site. No
// jumping to a label defined 400 lines below the call.
//
// Below: the "clean up on failure" pattern that goto often handles
// in C. In AiLang, a TryBlock with FinallyBlock achieves the same
// guarantee without naming a jump target.
SubRoutine.Main {
    resource_open = 0

    TryBlock: {
        PrintMessage("acquiring resource\n")
        resource_open = 1

        PrintMessage("doing work\n")
        // (on error, control jumps to CatchError; cleanup is guaranteed
        // by FinallyBlock regardless of success or failure)
    } CatchError: {
        PrintMessage("error occurred\n")
    } FinallyBlock: {
        IfCondition EqualTo(resource_open, 1) ThenBlock: {
            PrintMessage("releasing resource\n")
            resource_open = 0
        }
    }

    PrintMessage("done\n")
}
RunTask(Main)
