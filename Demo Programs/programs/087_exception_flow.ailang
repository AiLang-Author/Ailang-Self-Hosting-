// 087 — Exception-style flow (TryBlock / CatchError / FinallyBlock)
// AiLang ships a three-piece exception construct. FinallyBlock always
// runs (success or failure). This demo just shows the shape — the body
// here doesn't raise, so the catch arm stays cold.
SubRoutine.Main {
    result = 0

    TryBlock: {
        PrintMessage("try: doing work\n")
        result = 42
    } CatchError: {
        PrintMessage("catch: something went wrong\n")
        result = -1
    } FinallyBlock: {
        PrintMessage("finally: always runs\n")
    }

    PrintMessage("result = ")
    PrintNumber(result)
    PrintMessage("\n")
}
RunTask(Main)
