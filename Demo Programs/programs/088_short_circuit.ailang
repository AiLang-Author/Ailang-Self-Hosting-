// 088 — Short-circuit evaluation
// And/Or in AiLang are function calls, so both operands are evaluated
// (no lazy short-circuit). For short-circuit semantics, use nested
// IfCondition: the inner check only runs when the outer one permits.
SubRoutine.Main {
    n = 42

    // "n != 0 AND (100 / n) > 2" — with real short-circuit we skip the
    // divide when n is zero. Here we guard manually:
    IfCondition NotEqual(n, 0) ThenBlock: {
        IfCondition GreaterThan(Divide(100, n), 2) ThenBlock: {
            PrintMessage("yes, 100/n > 2\n")
        } ElseBlock: {
            PrintMessage("no, 100/n <= 2\n")
        }
    } ElseBlock: {
        PrintMessage("n is zero, skipped divide\n")
    }
}
RunTask(Main)
