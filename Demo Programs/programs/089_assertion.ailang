// 089 — Assertion statements
// DebugAssert(condition, message) halts the program with an error if
// `condition` is 0/false. Asserts are for *invariants* the code assumes
// are true — things a caller should never violate. Leave input
// validation (where bad input is expected) to normal IfCondition checks.
Function.HalfOf {
    Input: n: Integer
    Output: Integer
    Body: {
        DebugAssert(EqualTo(Modulo(n, 2), 0), "HalfOf requires an even number")
        ReturnValue(Divide(n, 2))
    }
}

SubRoutine.Main {
    PrintMessage("half of 10 = ")
    PrintNumber(HalfOf(10))
    PrintMessage("\nhalf of 8 = ")
    PrintNumber(HalfOf(8))
    PrintMessage("\n")
    // HalfOf(7) here would trip the assert and halt.
}
RunTask(Main)
