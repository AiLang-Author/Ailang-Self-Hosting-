// 091 — Basic function definition and call
// Function.Name { Input: ... Output: ... Body: { ... ReturnValue(x) } }
// is AiLang's standard function shape. Call it like any built-in.
Function.Square {
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(Multiply(n, n))
    }
}

SubRoutine.Main {
    PrintMessage("Square(7) = ")
    PrintNumber(Square(7))
    PrintMessage("\n")
}
RunTask(Main)
