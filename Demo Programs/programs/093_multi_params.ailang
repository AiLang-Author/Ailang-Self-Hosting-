// 092 — Function with multiple parameters
// Each Input line declares one parameter. Order of Input lines is the
// argument order at the call site. There's no comma-separated param
// list — the verbosity is intentional (grep-friendly, scan-friendly).
Function.Hypotenuse2 {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(Multiply(a, a), Multiply(b, b)))
    }
}

SubRoutine.Main {
    PrintMessage("3² + 4² = ")
    PrintNumber(Hypotenuse2(3, 4))
    PrintMessage("\n5² + 12² = ")
    PrintNumber(Hypotenuse2(5, 12))
    PrintMessage("\n")
}
RunTask(Main)
