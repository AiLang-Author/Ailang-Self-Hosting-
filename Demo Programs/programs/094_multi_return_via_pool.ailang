// 094 — "Multiple return values" via FixedPool
// Some languages let a function return a tuple: `return (q, r)` for
// quotient + remainder. AiLang functions return one Integer; for two
// or more outputs the canonical pattern is a named FixedPool the
// caller reads after the call.
//
// This keeps the calling convention simple (six register args, one
// return register) while still letting one logical operation produce
// multiple results. The pool name documents what's coming back.
FixedPool.DivResult {
    "q": Initialize=0
    "r": Initialize=0
}

Function.DivMod {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        DivResult.q = Divide(a, b)
        DivResult.r = Modulo(a, b)
        ReturnValue(0)
    }
}

SubRoutine.Main {
    DivMod(47, 5)
    PrintMessage("47 / 5 = ")
    PrintNumber(DivResult.q)
    PrintMessage("  remainder ")
    PrintNumber(DivResult.r)
    PrintMessage("\n")
}
RunTask(Main)
