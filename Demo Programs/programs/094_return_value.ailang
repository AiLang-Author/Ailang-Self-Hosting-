// 093 — Function with a return value
// ReturnValue(x) exits the function and yields `x` to the caller. You
// can return from multiple positions in the body; the first one reached
// wins (see 065, 073 for early-return patterns).
Function.Max3 {
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Output: Integer
    Body: {
        m = a
        IfCondition GreaterThan(b, m) ThenBlock: { m = b }
        IfCondition GreaterThan(c, m) ThenBlock: { m = c }
        ReturnValue(m)
    }
}

SubRoutine.Main {
    PrintMessage("max(3, 7, 2) = ")
    PrintNumber(Max3(3, 7, 2))
    PrintMessage("\nmax(9, 1, 5) = ")
    PrintNumber(Max3(9, 1, 5))
    PrintMessage("\n")
}
RunTask(Main)
