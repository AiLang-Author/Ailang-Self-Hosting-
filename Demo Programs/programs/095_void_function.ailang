// 095 — Void function / procedure
// SubRoutine.Name { ... } declares a void function — no Input/Output,
// no ReturnValue, just side effects. Invoke with RunTask(Name).
// SubRoutines have their own scope; use top-level code for driver logic
// and SubRoutines for reusable chunks of output or side-effect work.
SubRoutine.PrintBanner {
    PrintMessage("=====================\n")
    PrintMessage("  AiLang Demo 095\n")
    PrintMessage("=====================\n")
}

SubRoutine.PrintFooter {
    PrintMessage("---------------------\n")
    PrintMessage("  end of demo\n")
}

RunTask(PrintBanner)
PrintMessage("body between calls\n")
RunTask(PrintFooter)
