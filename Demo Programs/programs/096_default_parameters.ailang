// 096 — Default parameter values — DESIGN NOTE
// Python: `def greet(name="world")`. C++: `void f(int n = 10)`.
// Convenient at the call site; ambiguous at the read site, where
// "what does f() do?" requires looking up the declaration to know
// what defaults filled in.
//
// AiLang functions take exactly the inputs declared, no more, no
// less. If you want a "default" call form, write a thin wrapper:
//
//     Function.GreetDefault { ... calls Greet("world") }
//     Function.Greet        { Input: name: Address ... }
//
// Two functions, two clear names; the cost is one extra Function
// declaration per default arity. The benefit is that every call site
// names every value being passed. No silent defaults to look up.
Function.PrintIndented {
    Input: msg: Address
    Input: level: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, level) {
            PrintMessage("  ")
            i = Add(i, 1)
        }
        PrintMessage(msg)
        PrintMessage("\n")
    }
}

// Wrapper providing the "default" indent of 0.
SubRoutine.PrintLine {
    PrintIndented(Line.text, 0)
}

FixedPool.Line {
    "text": Initialize=""
}

SubRoutine.Main {
    Line.text = "no indent"
    RunTask(PrintLine)

    PrintIndented("level 1", 1)
    PrintIndented("level 2", 2)
}
RunTask(Main)
