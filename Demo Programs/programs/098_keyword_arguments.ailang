// 097 — Named / keyword arguments — DESIGN NOTE
// Python and Kotlin let you write `connect(host="localhost", port=5432)`,
// reordering or partially specifying for clarity. The cost is a more
// complex calling convention: the compiler has to match arg names to
// parameter slots, defaults fill in the gaps, and the same call site
// can shape itself differently depending on which kwargs are present.
//
// AiLang call sites are positional. To get the readability of named
// arguments without the calling-convention complexity, the canonical
// pattern is a FixedPool that documents the call by field name:
//
//     ConnectOpts.host = "localhost"
//     ConnectOpts.port = 5432
//     Connect()                        // reads from ConnectOpts.*
//
// Same readability gain at the call site, no kwarg-matching in the
// compiler, and the defaults are the FixedPool Initialize= clauses.
FixedPool.ConnectOpts {
    "host": Initialize="localhost"
    "port": Initialize=5432
    "timeout_ms": Initialize=2000
}

SubRoutine.Connect {
    PrintMessage("connecting to ")
    PrintMessage(ConnectOpts.host)
    PrintMessage(":")
    PrintNumber(ConnectOpts.port)
    PrintMessage(" (timeout ")
    PrintNumber(ConnectOpts.timeout_ms)
    PrintMessage("ms)\n")
}

SubRoutine.Main {
    // Default call — relies entirely on Initialize= values.
    RunTask(Connect)

    // "Override" by setting fields before the call.
    ConnectOpts.host = "db.example.com"
    ConnectOpts.timeout_ms = 5000
    RunTask(Connect)
}
RunTask(Main)
