// 098 — Variadic functions — DESIGN NOTE
// `printf(fmt, ...)`, Python `*args`, Java varargs. Useful for the
// genuine N-of-the-same-type case (sum of M numbers, log message
// with K substitutions). At the cost of a second calling convention:
// the compiler now has both fixed-arity calls and variadic ones.
//
// AiLang has the 6-input ceiling for stack-spilling reasons (see the
// "demo gotchas" note). For more inputs OR a variable count, the
// canonical pattern is the same: a FixedPool acting as the input
// vector. The function reads .count + .items[0..count-1] explicitly.
//
// This trades the implicit `va_arg` machinery for an explicit pool —
// you can see the storage at the source level. No mismatch between
// what the compiler thinks the args are and what the function reads.
FixedPool.Args {
    "count": Initialize=0
    "v0": Initialize=0
    "v1": Initialize=0
    "v2": Initialize=0
    "v3": Initialize=0
}

SubRoutine.SumArgs {
    Args.count = 4
    Args.v0 = 10
    Args.v1 = 20
    Args.v2 = 30
    Args.v3 = 40

    total = 0
    i = 0
    WhileLoop LessThan(i, Args.count) {
        Branch i {
            Case 0: { total = Add(total, Args.v0) }
            Case 1: { total = Add(total, Args.v1) }
            Case 2: { total = Add(total, Args.v2) }
            Case 3: { total = Add(total, Args.v3) }
        }
        i = Add(i, 1)
    }

    PrintMessage("sum of ")
    PrintNumber(Args.count)
    PrintMessage(" values = ")
    PrintNumber(total)
    PrintMessage("\n")
}

SubRoutine.Main {
    RunTask(SumArgs)
}
RunTask(Main)
