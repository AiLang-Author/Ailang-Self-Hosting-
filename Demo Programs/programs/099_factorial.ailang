// 099 — Recursive factorial
// The canonical recursion demo. Base case n<=1 returns 1; inductive
// case multiplies n by factorial(n-1). Stack-safe for small n; large
// n will overflow both the integer and the stack (see Cat 18 for the
// iterative and big-integer variants).
Function.Factorial {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(n, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(Multiply(n, Factorial(Subtract(n, 1))))
    }
}

SubRoutine.Main {
    i = 0
    WhileLoop LessEqual(i, 10) {
        PrintNumber(i)
        PrintMessage("! = ")
        PrintNumber(Factorial(i))
        PrintMessage("\n")
        i = Add(i, 1)
    }
}
RunTask(Main)
