// 100 — Recursive Fibonacci
// Naive tree recursion: fib(n) = fib(n-1) + fib(n-2), base cases
// fib(0)=0, fib(1)=1. Exponential blowup in call count — acceptable
// here because we only go up to fib(15). Cat 18 has the memoized and
// matrix-exponentiation versions.
Function.Fib {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(n, 1) ThenBlock: { ReturnValue(n) }
        ReturnValue(Add(Fib(Subtract(n, 1)), Fib(Subtract(n, 2))))
    }
}

SubRoutine.Main {
    i = 0
    WhileLoop LessEqual(i, 15) {
        PrintMessage("fib(")
        PrintNumber(i)
        PrintMessage(") = ")
        PrintNumber(Fib(i))
        PrintMessage("\n")
        i = Add(i, 1)
    }
}
RunTask(Main)
