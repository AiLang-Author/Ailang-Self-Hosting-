// 102 — Mutual recursion
// Two (or more) functions that call each other. Classic example:
// IsEven and IsOdd each delegate the smaller case to the other.
// AiLang resolves function references at link time, so the order you
// declare them in doesn't matter — IsEven can reference IsOdd even
// if IsOdd is declared further down the file.
Function.IsEven {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(IsOdd(Subtract(n, 1)))
    }
}

Function.IsOdd {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(IsEven(Subtract(n, 1)))
    }
}

SubRoutine.Main {
    PrintMessage("IsEven(8):  ")
    PrintNumber(IsEven(8))
    PrintMessage("\nIsOdd(8):   ")
    PrintNumber(IsOdd(8))
    PrintMessage("\nIsEven(15): ")
    PrintNumber(IsEven(15))
    PrintMessage("\nIsOdd(15):  ")
    PrintNumber(IsOdd(15))
    PrintMessage("\n")
}
RunTask(Main)
