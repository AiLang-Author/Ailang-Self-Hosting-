// 101 — Tail recursion
// A tail-recursive function has its recursive call as the LAST thing
// it does — no work happens after the call returns. Functional
// languages (Scheme, Haskell, Erlang) detect this and rewrite the
// call as a jump, giving O(1) stack space. AiLang's compiler does
// not currently tail-call-optimize; a deeply tail-recursive function
// still grows the stack linearly.
//
// Idiomatic rewrite: when you need unbounded iteration, use a
// WhileLoop. The "accumulator argument" trick below is still a
// useful shape — it shows how to refactor a naive recursive function
// into the tail form a TCO'd compiler would optimize.
Function.FactIter {
    Input: n: Integer
    Input: acc: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(n, 1) ThenBlock: { ReturnValue(acc) }
        // Recursive call is the LAST expression — this is the tail
        // position. With TCO this would run in constant stack space.
        ReturnValue(FactIter(Subtract(n, 1), Multiply(acc, n)))
    }
}

SubRoutine.Main {
    PrintMessage("10! via tail-form = ")
    PrintNumber(FactIter(10, 1))
    PrintMessage("\n")
}
RunTask(Main)
