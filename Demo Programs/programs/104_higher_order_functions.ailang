// 104 — Higher-order functions — DESIGN NOTE
// "Functions that take functions as arguments" — `array.map(f)`,
// `sort(cmp)`, `qsort(base, n, sz, cmp)`. The runtime story is a
// function pointer (or a fat pointer for closures). The benefit is
// composition: the data-walk and the per-element op live in
// separate, reusable pieces.
//
// AiLang doesn't have first-class function values today (see 103).
// The composition still lives in the source, just not as a parameter:
// you write the loop and call the named function inside it. The
// callback sits at the call site, not as a passed value.
//
// When/if function pointers land, the natural form would be
// `Input: f: FuncPtr<Integer, Integer>` — but until the calling
// convention is settled, the explicit loop is the canonical idiom.
Function.Square {
    Input: x: Integer
    Output: Integer
    Body: { ReturnValue(Multiply(x, x)) }
}

Function.Negate {
    Input: x: Integer
    Output: Integer
    Body: { ReturnValue(Subtract(0, x)) }
}

SubRoutine.Main {
    // "map Square over [1..5]" — written as the loop directly.
    i = 1
    WhileLoop LessEqual(i, 5) {
        PrintMessage("Square(")
        PrintNumber(i)
        PrintMessage(") = ")
        PrintNumber(Square(i))
        PrintMessage("\n")
        i = Add(i, 1)
    }

    // Different function, same shape — copy/paste, swap one name.
    i = 1
    WhileLoop LessEqual(i, 3) {
        PrintMessage("Negate(")
        PrintNumber(i)
        PrintMessage(") = ")
        PrintNumber(Negate(i))
        PrintMessage("\n")
        i = Add(i, 1)
    }
}
RunTask(Main)
