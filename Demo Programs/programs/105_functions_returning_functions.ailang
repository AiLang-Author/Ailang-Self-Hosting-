// 105 — Functions returning functions — DESIGN NOTE
// `def make_adder(n): return lambda x: x + n` — a closure factory.
// The returned value is a function paired with captured state.
// Useful for currying (108), partial application (109), and event
// handlers configured by the surrounding code.
//
// AiLang functions return one Integer; closures (captured state in
// a function value) aren't in the language. The same shape lives in
// FixedPool form: the "factory" sets pool fields, the "returned
// function" is a regular Function that reads them.
FixedPool.AdderState {
    "n": Initialize=0
}

Function.AddN {
    Input: x: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(x, AdderState.n))
    }
}

SubRoutine.MakeAdder5 {
    AdderState.n = 5    // "captured" value
}

SubRoutine.MakeAdder100 {
    AdderState.n = 100
}

SubRoutine.Main {
    RunTask(MakeAdder5)
    PrintMessage("AddN(10) when n=5  : ")
    PrintNumber(AddN(10))      // 15

    RunTask(MakeAdder100)
    PrintMessage("\nAddN(10) when n=100: ")
    PrintNumber(AddN(10))      // 110
    PrintMessage("\n")
}
RunTask(Main)
