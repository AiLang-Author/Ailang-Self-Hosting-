// 114 — Pure function demonstration
// A pure function: (1) same inputs always produce same outputs,
// (2) no side effects — doesn't touch global state, doesn't do I/O,
// doesn't modify its arguments. Pure functions are trivial to test,
// safe to memoize, and safe to call concurrently.
//
// AiLang doesn't enforce purity — there's no `pure` keyword. It's a
// property you maintain by DISCIPLINE: functions that take inputs,
// compute a result, and return it (no PrintMessage, no global
// mutation, no Allocate that escapes) are pure by construction.
Function.Clamp {
    Input: n: Integer
    Input: lo: Integer
    Input: hi: Integer
    Output: Integer
    Body: {
        // Pure: no I/O, no globals, output depends only on inputs.
        IfCondition LessThan(n, lo) ThenBlock: { ReturnValue(lo) }
        IfCondition GreaterThan(n, hi) ThenBlock: { ReturnValue(hi) }
        ReturnValue(n)
    }
}

SubRoutine.Main {
    PrintMessage("Clamp(5, 0, 10)  = ")
    PrintNumber(Clamp(5, 0, 10))
    PrintMessage("\nClamp(-3, 0, 10) = ")
    PrintNumber(Clamp(-3, 0, 10))
    PrintMessage("\nClamp(42, 0, 10) = ")
    PrintNumber(Clamp(42, 0, 10))
    PrintMessage("\n")

    // Purity property: calling Clamp twice with the same inputs gives
    // the same result — no hidden state was read or updated.
    PrintMessage("same-inputs test: ")
    PrintNumber(EqualTo(Clamp(5, 0, 10), Clamp(5, 0, 10)))
    PrintMessage("\n")
}
RunTask(Main)
