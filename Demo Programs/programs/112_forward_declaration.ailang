// 118 — Forward declaration of functions — DESIGN NOTE
// C requires that every called function be at least *declared* before
// use, hence the prototype-in-header convention. This was a 1970s
// concession to one-pass compilation on machines with very little RAM.
//
// AiLang does not require forward declarations. The parser sees the
// entire compilation unit before codegen, so a Function defined later
// in the file is callable from a Function defined earlier — including
// for mutual recursion (see 102_mutual_recursion.ailang).
//
// In practice this means file ordering can follow readability rather
// than dependency: put the top-level entry point at the top, helpers
// below. The reader scans the high-level shape first; the details
// land in order of decreasing importance.
Function.AskHelper {
    Output: Integer
    Body: {
        // Calls Helper before its declaration. Compiler is fine with it.
        ReturnValue(Helper(7))
    }
}

Function.Helper {
    Input: x: Integer
    Output: Integer
    Body: {
        ReturnValue(Multiply(x, x))
    }
}

SubRoutine.Main {
    PrintMessage("AskHelper() returned ")
    PrintNumber(AskHelper())
    PrintMessage("\n")
}
RunTask(Main)
