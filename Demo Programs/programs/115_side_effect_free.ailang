// 115 — Side-effect-free function
// Closely related to "pure" (demo 114) — a side-effect-free function
// doesn't modify any state the caller can observe. No writes to
// global variables, no I/O, no mutations through passed-in pointers.
//
// Contrast: "pure" additionally requires that output depends ONLY on
// inputs (no reading of global state either). All pure functions are
// side-effect-free, but not vice versa — a function that reads a
// global but doesn't write one is side-effect-free but not pure.
Function.Sum1ToN {
    Input: n: Integer
    Output: Integer
    Body: {
        total = 0  // local, not observable by caller — side-effect-free
        i = 1
        WhileLoop LessEqual(i, n) {
            total = Add(total, i)
            i = Add(i, 1)
        }
        ReturnValue(total)
    }
}

SubRoutine.Main {
    PrintMessage("Sum1ToN(100) = ")
    PrintNumber(Sum1ToN(100))   // 5050
    PrintMessage("\nSum1ToN(10)  = ")
    PrintNumber(Sum1ToN(10))    // 55
    PrintMessage("\n")
}
RunTask(Main)
