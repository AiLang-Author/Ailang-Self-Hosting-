// 117 — "Nested" functions via composition
// Some languages allow `def Inner` to live lexically inside `def Outer`,
// invisible from the outside. AiLang functions are flat — every Function
// declaration is module-level, and naming is the only access control.
//
// "Nesting" in practice means: define small private helpers next to the
// public function that uses them, and pick names that signal they're
// internal (a leading underscore, an `_Impl` suffix, or simply a
// scope-prefixed name). Composition still works fine — the helpers just
// aren't lexically hidden.
Function._SquarePlusOne {
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(Multiply(n, n), 1))
    }
}

Function.SumSquaresPlusOne {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        // Calls the "private" helper; reader knows by the underscore
        // that this is an implementation detail of SumSquaresPlusOne.
        ReturnValue(Add(_SquarePlusOne(a), _SquarePlusOne(b)))
    }
}

SubRoutine.Main {
    PrintMessage("(3^2+1) + (4^2+1) = ")
    PrintNumber(SumSquaresPlusOne(3, 4))
    PrintMessage("\n")
}
RunTask(Main)
