// 124 — reduce() / fold() pattern — DESIGN NOTE
// `reduce(f, xs, init)` collapses an iterable into a single value
// by repeatedly combining the accumulator with the next element.
// `fold` in Haskell/Scala/Rust is the same idea, sometimes split
// into foldl (left fold) and foldr (right fold).
//
// Without higher-order functions, AiLang's reduce is a WhileLoop
// with one accumulator variable. The "f" is the inline body of the
// loop; the "init" is the variable's initial value.
FixedPool.In {
    "v0": Initialize=10
    "v1": Initialize=20
    "v2": Initialize=30
    "v3": Initialize=40
}

SubRoutine.Main {
    // reduce(+, [10,20,30,40], 0) — sum.
    sum = 0
    sum = Add(sum, In.v0)
    sum = Add(sum, In.v1)
    sum = Add(sum, In.v2)
    sum = Add(sum, In.v3)
    PrintMessage("sum    = ")
    PrintNumber(sum)

    // reduce(*, [10,20,30,40], 1) — product.
    prod = 1
    prod = Multiply(prod, In.v0)
    prod = Multiply(prod, In.v1)
    prod = Multiply(prod, In.v2)
    prod = Multiply(prod, In.v3)
    PrintMessage("\nprod   = ")
    PrintNumber(prod)

    // reduce(max, [10,20,30,40], -1) — max.
    best = Subtract(0, 1)
    IfCondition GreaterThan(In.v0, best) ThenBlock: { best = In.v0 }
    IfCondition GreaterThan(In.v1, best) ThenBlock: { best = In.v1 }
    IfCondition GreaterThan(In.v2, best) ThenBlock: { best = In.v2 }
    IfCondition GreaterThan(In.v3, best) ThenBlock: { best = In.v3 }
    PrintMessage("\nmax    = ")
    PrintNumber(best)
    PrintMessage("\n")
}
RunTask(Main)
