// 122 — map() pattern — DESIGN NOTE
// `map(f, [a,b,c]) → [f(a), f(b), f(c)]`. Every element transformed
// by the same operation, output array same length as input.
//
// Without first-class functions, AiLang's idiom is: a WhileLoop over
// the input, calling the per-element function inline, writing into
// a parallel output. No "map" wrapper needed — the loop *is* the
// map.
//
// Worked example below uses a tiny FixedPool as the input/output
// vector; in real code the storage would be an XArray or a larger
// pool. The shape is identical.
FixedPool.In {
    "v0": Initialize=1
    "v1": Initialize=2
    "v2": Initialize=3
    "v3": Initialize=4
}
FixedPool.Out {
    "v0": Initialize=0
    "v1": Initialize=0
    "v2": Initialize=0
    "v3": Initialize=0
}

Function.Square {
    Input: x: Integer
    Output: Integer
    Body: { ReturnValue(Multiply(x, x)) }
}

SubRoutine.Main {
    // map(Square, In) -> Out
    Out.v0 = Square(In.v0)
    Out.v1 = Square(In.v1)
    Out.v2 = Square(In.v2)
    Out.v3 = Square(In.v3)

    PrintMessage("squared: ")
    PrintNumber(Out.v0)
    PrintMessage(" ")
    PrintNumber(Out.v1)
    PrintMessage(" ")
    PrintNumber(Out.v2)
    PrintMessage(" ")
    PrintNumber(Out.v3)
    PrintMessage("\n")
}
RunTask(Main)
