// 282 — Option / Maybe type — DESIGN NOTE
// Rust `Option<T>`, Haskell `Maybe a`, Swift `T?`. A value that's
// either Some(x) or None — distinct from Result in that there's no
// reason payload, just "value present or absent."
//
// AiLang's Address-returning convention uses 0 (NULL) for absent and
// any non-zero pointer for present. Integer-returning lookup
// functions typically use a sentinel like -1 for "not found."
//
// Same caveat as 281 — no type-system check that the caller tests
// for the sentinel. The convention is universal in the standard
// libraries (StringFind, HashLookup, ArrayIndexOf all use -1 for
// "not found"), so it's idiomatic to recognize and check for.
Function.FindInList {
    Input: needle: Integer
    Output: Integer        // index of match, or -1 for "not found"
    Body: {
        // Toy "list" inlined for the demo: 10, 20, 30, 40, 50
        IfCondition EqualTo(needle, 10) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(needle, 20) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(needle, 30) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(needle, 40) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(needle, 50) ThenBlock: { ReturnValue(4) }
        ReturnValue(Subtract(0, 1))         // not found sentinel
    }
}

SubRoutine.Lookup {
    idx = FindInList(LookupInput.needle)
    PrintMessage("find(")
    PrintNumber(LookupInput.needle)
    PrintMessage(") -> ")
    IfCondition LessThan(idx, 0) ThenBlock: {
        PrintMessage("None\n")
    } ElseBlock: {
        PrintMessage("Some(index=")
        PrintNumber(idx)
        PrintMessage(")\n")
    }
}

FixedPool.LookupInput {
    "needle": Initialize=0
}

SubRoutine.Main {
    LookupInput.needle = 30
    RunTask(Lookup)
    LookupInput.needle = 99
    RunTask(Lookup)
    LookupInput.needle = 10
    RunTask(Lookup)
}
RunTask(Main)
