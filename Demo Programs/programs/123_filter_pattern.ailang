// 123 — filter() pattern — DESIGN NOTE
// `filter(p, xs)` → keep elements for which `p(x)` is truthy.
// Output length ≤ input length, so a "where do I write the next
// kept element?" cursor is the loop's only state.
//
// AiLang's idiom: a WhileLoop, an IfCondition guarding the keep,
// a write cursor advanced only when the predicate held. The
// predicate inlines into the loop body; no callback handoff.
FixedPool.In {
    "v0": Initialize=3
    "v1": Initialize=8
    "v2": Initialize=1
    "v3": Initialize=12
    "v4": Initialize=5
}
FixedPool.Out {
    "count": Initialize=0
    "v0": Initialize=0
    "v1": Initialize=0
    "v2": Initialize=0
    "v3": Initialize=0
    "v4": Initialize=0
}

SubRoutine.AppendOut {
    Branch Out.count {
        Case 0: { Out.v0 = AppendValue.x }
        Case 1: { Out.v1 = AppendValue.x }
        Case 2: { Out.v2 = AppendValue.x }
        Case 3: { Out.v3 = AppendValue.x }
        Case 4: { Out.v4 = AppendValue.x }
    }
    Out.count = Add(Out.count, 1)
}

FixedPool.AppendValue {
    "x": Initialize=0
}

SubRoutine.Main {
    // Filter: keep values > 4.
    AppendValue.x = In.v0
    IfCondition GreaterThan(In.v0, 4) ThenBlock: { RunTask(AppendOut) }
    AppendValue.x = In.v1
    IfCondition GreaterThan(In.v1, 4) ThenBlock: { RunTask(AppendOut) }
    AppendValue.x = In.v2
    IfCondition GreaterThan(In.v2, 4) ThenBlock: { RunTask(AppendOut) }
    AppendValue.x = In.v3
    IfCondition GreaterThan(In.v3, 4) ThenBlock: { RunTask(AppendOut) }
    AppendValue.x = In.v4
    IfCondition GreaterThan(In.v4, 4) ThenBlock: { RunTask(AppendOut) }

    PrintMessage("kept ")
    PrintNumber(Out.count)
    PrintMessage(" values: ")
    PrintNumber(Out.v0)
    PrintMessage(" ")
    PrintNumber(Out.v1)
    PrintMessage(" ")
    PrintNumber(Out.v2)
    PrintMessage("\n")
}
RunTask(Main)
