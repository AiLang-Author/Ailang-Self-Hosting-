// 284 — Error wrapping and unwrapping — DESIGN NOTE
// Go: `fmt.Errorf("loading config: %w", err)` wraps an inner error
// inside a contextual outer one. `errors.Unwrap` and `errors.Is`
// peel the layers to identify the original cause.
//
// Useful when an error crosses several abstraction boundaries —
// the lower layer says "ENOENT", the middle says "config: ENOENT",
// the top says "startup failed: config: ENOENT" — and the user
// sees a chain of context.
//
// AiLang's negative-sentinel convention has no built-in wrapping —
// the Integer code is the whole story. To get layered context, the
// pattern is to log the chain at each `IfCondition LessThan(x,0)`
// guard, with the layer name as a prefix:
//
//     [config] failed: ENOENT
//     [startup] failed: config-load returned -1
//
// The "wrapping" lives in the printed log lines, not in the data.
// Less expressive than wrapped error values; visible at every
// boundary the program crossed without a structured-error type.
Function.LoadConfig {
    Output: Integer
    Body: {
        // Pretend the file doesn't exist: return ENOENT-shaped sentinel.
        ReturnValue(Subtract(0, 2))
    }
}

Function.Startup {
    Output: Integer
    Body: {
        cfg = LoadConfig()
        IfCondition LessThan(cfg, 0) ThenBlock: {
            PrintMessage("[startup] config load failed, code ")
            PrintNumber(cfg)
            PrintMessage("\n")
            ReturnValue(Subtract(0, 1))
        }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    rc = Startup()
    PrintMessage("startup returned ")
    PrintNumber(rc)
    PrintMessage("\n")
}
RunTask(Main)
