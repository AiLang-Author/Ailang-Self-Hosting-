// 125 — zip() / unzip() pattern — DESIGN NOTE
// `zip([a,b,c], [x,y,z])` → `[(a,x),(b,y),(c,z)]`. Pair up two
// sequences element-wise. The shorter sequence determines the
// length. `unzip` is the reverse.
//
// AiLang has no tuple type, so there's no `(a,x)` literal to put
// into a result list. The pattern is to walk both inputs in lock-
// step and process each pair inline — no intermediate "list of
// pairs" representation needed.
//
// Most uses of zip are "iterate two arrays together"; that's what
// this demo shows. When you really need the materialized pairs,
// two parallel output FixedPools (one per "tuple" slot) is the
// canonical shape.
FixedPool.A {
    "v0": Initialize=1
    "v1": Initialize=2
    "v2": Initialize=3
}
FixedPool.B {
    "v0": Initialize=10
    "v1": Initialize=20
    "v2": Initialize=30
}

SubRoutine.Main {
    // "zip A and B into the inline body": process each pair.
    PrintMessage("(1,10) -> sum ")
    PrintNumber(Add(A.v0, B.v0))
    PrintMessage(", prod ")
    PrintNumber(Multiply(A.v0, B.v0))

    PrintMessage("\n(2,20) -> sum ")
    PrintNumber(Add(A.v1, B.v1))
    PrintMessage(", prod ")
    PrintNumber(Multiply(A.v1, B.v1))

    PrintMessage("\n(3,30) -> sum ")
    PrintNumber(Add(A.v2, B.v2))
    PrintMessage(", prod ")
    PrintNumber(Multiply(A.v2, B.v2))
    PrintMessage("\n")
}
RunTask(Main)
