// 434 — Tower of Hanoi
// The classic recursive puzzle: move N disks from peg A to peg C using
// peg B as scratch, never placing a larger disk on a smaller one.
// Three rules, one recursive shape: move N-1 disks aside, move the
// bottom disk, move the N-1 back on top. 2^N - 1 moves total — no
// shortcut exists.
//
// Pegs are encoded as character codes 65/66/67 ("A"/"B"/"C") so we can
// PrintChar them without a string-of-chars lookup.
Function.Hanoi {
    Input: n: Integer
    Input: from: Integer
    Input: via: Integer
    Input: to: Integer
    Body: {
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        Hanoi(Subtract(n, 1), from, to, via)
        PrintMessage("move disk ")
        PrintNumber(n)
        PrintMessage(" from ")
        PrintChar(from)
        PrintMessage(" to ")
        PrintChar(to)
        PrintMessage("\n")
        Hanoi(Subtract(n, 1), via, from, to)
    }
}

SubRoutine.Main {
    Hanoi(3, 65, 66, 67)
}
RunTask(Main)
