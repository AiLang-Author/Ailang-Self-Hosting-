// 437 — Least common multiple
// Identity: lcm(a,b) * gcd(a,b) = a*b. So once you have GCD (see 436),
// LCM is one division away. Order matters for overflow safety: divide
// before multiply when the values get large.
Function.GCD {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(a) }
        ReturnValue(GCD(b, Modulo(a, b)))
    }
}

Function.LCM {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        // (a / gcd) * b avoids overflow vs (a * b) / gcd for large inputs.
        ReturnValue(Multiply(Divide(a, GCD(a, b)), b))
    }
}

SubRoutine.Main {
    PrintMessage("lcm(4, 6)   = ")
    PrintNumber(LCM(4, 6))
    PrintMessage("\nlcm(21, 6)  = ")
    PrintNumber(LCM(21, 6))
    PrintMessage("\nlcm(13, 17) = ")
    PrintNumber(LCM(13, 17))   // coprime → 13*17
    PrintMessage("\n")
}
RunTask(Main)
