// 133 — Using Library.Hash (the fast open-addressing hash table)
//
// This demo shows the modern, high-performance Hash library
// (hardware CRC32, linear probing, tombstones, nested H* operations).
//
// Compare with older SHash/IHash in Library.Arrays when you need
// different trade-offs.

LibraryImport.Hash
LibraryImport.Array
LibraryImport.StringUtils

SubRoutine.DemoHashBasics {
    PrintMessage("=== Library.Hash Demo (concept) ===\n")
    PrintMessage("Hash.New, Hash.Set(table, key, value), Hash.Get, Hash.Size, HSet/HGet for nested.\n")
    PrintMessage("Fast open-addressing + hardware CRC32 hash table.\n")
    PrintMessage("Hash demo (design note) complete.\n")
}

RunTask(DemoHashBasics)
