// 134 — Using Library.Arrays (Stack, Queue, SHash, List, Util)
//
// Shows the higher-level collections built on the fast Array primitive.

LibraryImport.Arrays

SubRoutine.DemoCollections {
    PrintMessage("=== Library.Arrays Collections Demo (concept) ===\n")
    PrintMessage("Stack, Queue, SHash/IHash, List, and Util helpers on top of Array.\n")
    PrintMessage("Collections demo (design note) complete.\n")
}

RunTask(DemoCollections)
