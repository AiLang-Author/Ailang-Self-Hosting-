// 136 — Simple CSV Processing
//
// Educational example of parsing tabular text data.
// Real implementation would use StringUtils.Split + Array of rows.

SubRoutine.DemoCSV {
    PrintMessage("=== Simple CSV Demo (concept) ===\n")
    PrintMessage("Typical approach: split lines, then split fields by comma.\n")
    PrintMessage("Store rows using Array of Arrays or a small struct simulation.\n")
    PrintMessage("CSV demo (design note) complete.\n")
}

RunTask(DemoCSV)
