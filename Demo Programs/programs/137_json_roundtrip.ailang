// 137 — JSON Roundtrip using Library.JSON
//
// Shows creating JSON objects/arrays, serializing, parsing,
// and reading values back. Library.JSON is backed by SHash + Array.

SubRoutine.DemoJSON {
    PrintMessage("=== JSON Roundtrip Demo (concept) ===\n")
    PrintMessage("Use JSON.NewObject, JSON.SetString, JSON.SetNumber, JSON.NewArray.\n")
    PrintMessage("Serialize with JSON.Stringify. Parse with JSON.Parse.\n")
    PrintMessage("JSON demo (design note) complete.\n")
}

RunTask(DemoJSON)
