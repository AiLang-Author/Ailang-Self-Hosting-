// 138 — Manual Memory Management
//
// Deep dive into Allocate / Deallocate, Arena usage,
// and why you must track sizes exactly.

LibraryImport.Arena

SubRoutine.DemoManualMemory {
    PrintMessage("=== Manual Memory Demo ===\n")

    ptr = Allocate(128)
    PrintMessage("Allocated 128 bytes.\n")

    // Write some data
    SetByte(ptr, 0, 72)   // 'H'
    SetByte(ptr, 1, 105)  // 'i'

    PrintMessage("Wrote data. First two bytes: ")
    b0 = GetByte(ptr, 0)
    b1 = GetByte(ptr, 1)
    PrintNumber(b0)
    PrintMessage(" ")
    PrintNumber(b1)
    PrintMessage("\n")

    Deallocate(ptr, 128)   // Must match allocation size!
    PrintMessage("Deallocated successfully.\n")

    // Warning demo: wrong size would corrupt the slab
    PrintMessage("Remember: size passed to Deallocate must match Allocate exactly.\n")
}

RunTask(DemoManualMemory)
