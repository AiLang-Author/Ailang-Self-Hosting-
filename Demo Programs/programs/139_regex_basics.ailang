// 139 — Regular Expressions with Library.Regex_Thompson
//
// Shows compiling a regex and matching against strings.

SubRoutine.DemoRegex {
    PrintMessage("=== Regex Basics Demo (concept) ===\n")
    PrintMessage("Regex.Compile(pattern) then Regex.Match(re, str).\n")
    PrintMessage("See Library.Regex_Thompson for the Thompson NFA implementation.\n")
    PrintMessage("Regex demo (design note) complete.\n")
}

RunTask(DemoRegex)
