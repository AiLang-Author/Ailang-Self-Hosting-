// 140 — Random Numbers & Simple Monte Carlo
//
// Introduces Library.RNG and a tiny probabilistic demo.

SubRoutine.DemoRandom {
    PrintMessage("=== Random & Monte Carlo Demo (concept) ===\n")
    PrintMessage("RNG.Seed(seed); x = RNG.NextFloat() or RNG.NextInt()\n")
    PrintMessage("Useful for Monte Carlo, games, testing.\n")
    PrintMessage("Random demo (design note) complete.\n")
}

RunTask(DemoRandom)
