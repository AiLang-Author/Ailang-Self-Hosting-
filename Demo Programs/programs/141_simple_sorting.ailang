// 141 — Sorting with Array.Sort and Binary Search
//
// Demonstrates in-place sort + binary search on the result.

LibraryImport.Array
LibraryImport.Arena

SubRoutine.DemoSorting {
    PrintMessage("=== Sorting + Binary Search Demo ===\n")

    arr = Array.Create(8)
    Array.Push(arr, 42)
    Array.Push(arr, 7)
    Array.Push(arr, 19)
    Array.Push(arr, 3)
    Array.Push(arr, 99)

    PrintMessage("Before sort: 42 7 19 3 99\n")

    Array.Sort(arr)

    PrintMessage("After sort:  ")
    i = 0
    WhileLoop LessThan(i, Array.Size(arr)) {
        v = Array.Get(arr, i)
        PrintNumber(v)
        PrintMessage(" ")
        i = Add(i, 1)
    }
    PrintMessage("\n")

    idx = Array.BinarySearch(arr, 19)
    PrintMessage("Binary search for 19 found at index: ")
    PrintNumber(idx)
    PrintMessage("\n")

    Array.Destroy(arr)
}

RunTask(DemoSorting)
