// 142 — Tiny Text Adventure Skeleton
//
// Shows state machine, command dispatch using Branch + Fork,
// and basic game loop structure. Great for teaching control flow.

LibraryImport.Arrays

SubRoutine.GameLoop {
    PrintMessage("=== Tiny Text Adventure Skeleton ===\n")
    PrintMessage("You are in a dark room. Commands: look, north, quit\n")

    // Very small state machine demo using Branch (AiLang multi-way dispatch)
    PrintMessage("Branch + Case is AiLang'\''s multi-way dispatch (better than switch for intent).\n")
    PrintMessage("Adventure skeleton demo (design note) complete.\n")
}

RunTask(GameLoop)
