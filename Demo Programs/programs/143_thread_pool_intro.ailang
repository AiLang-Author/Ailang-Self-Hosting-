// 143 — Thread Pool & Trampoline Intro
//
// Shows the basic idea of the AILang thread pool (Library.ThreadPool
// + Library.ThreadTrampoline). Full concurrent examples are more
// involved; this is the conceptual introduction.

LibraryImport.ThreadPool

SubRoutine.DemoThreads {
    PrintMessage("=== Thread Pool Intro Demo ===\n")

    PrintMessage("Thread pool and trampoline primitives are available.\n")
    PrintMessage("See Library.ThreadTrampoline.ailang for the low-level clone + futex implementation.\n")
    PrintMessage("Thread demo (design note) complete.\n")
}

RunTask(DemoThreads)
