// 144 — Advanced String Processing
//
// Uses Library.StringUtils for common operations: split, join,
// find, replace, trim, etc.

LibraryImport.StringUtils

SubRoutine.DemoAdvancedStrings {
    PrintMessage("=== Advanced Strings Demo ===\n")

    PrintMessage("StringUtils provides Trim, Split, Join, Replace, Find, etc.\n")
    PrintMessage("Advanced strings demo (design note) complete.\n")
}

RunTask(DemoAdvancedStrings)
