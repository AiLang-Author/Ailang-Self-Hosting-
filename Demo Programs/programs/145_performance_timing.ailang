// 145 — Simple Performance Timing
//
// Shows how to measure elapsed time for a piece of code
// using the TimeDate library or raw clock primitives.

SubRoutine.DemoTiming {
    PrintMessage("=== Performance Timing Demo (concept) ===\n")
    PrintMessage("Use TimeDate or direct clock primitives for millis.\n")
    PrintMessage("Performance timing demo (design note) complete.\n")
}

RunTask(DemoTiming)
