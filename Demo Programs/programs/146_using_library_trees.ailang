// 146 — Using Library.Trees (B-tree)
//
// Demonstrates creating a B-tree, inserting, finding,
// and range queries.

SubRoutine.DemoTrees {
    PrintMessage("=== B-Tree Demo (concept) ===\n")
    PrintMessage("Trees.new, Trees.insert(tree, key, value), Trees.find, Trees.free.\n")
    PrintMessage("B-Tree demo (design note) complete.\n")
}

RunTask(DemoTrees)
