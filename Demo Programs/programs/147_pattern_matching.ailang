// demo_pattern_match — tag-based pattern matching via FixedPool enum + Branch dispatch.
//
// Compare with the C-style "pattern" proposal from r/Compilers (2025):
//
//     pattern P { N; T(int, int); S { int x; int y; }; }
//     MS fits P(self) {
//         N if (self->x == 0);
//         T(self->x, -self->x) if (self->x < 10);
//         S { x: self->x; y: 0; } if (self->x < 20);
//         default N;
//     }
//     match (ms) { P.S {x, y} => `qout("Worked"); ... }
//
// That design needs new keywords (pattern, fits, match), backtick-prefixed
// output, semicolons inside pattern bodies, and a dual arrow/brace syntax
// for extraction. The reader has to hold several grammar rules at once.
//
// In AILang the same idea falls out of constructs already in the language:
//   FixedPool  = enum tags        (no new keyword)
//   Function   = matcher/extractor (just returns a tag)
//   Fork       = guard clauses    (reads like a decision tree)
//   Branch     = dispatch          (clean case/default)
//
// Zero new grammar. Same expressive power. Read it top-down.
//
// This demo goes further: linked-list head/tail decomposition, a
// trampoline-driven merge sort, and a pattern-matched state machine.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena

// ========================================================================
//  TAGS
// ========================================================================

FixedPool.Pat {
    "None":     Initialize=0
    "Small":    Initialize=1
    "Medium":   Initialize=2
    "Large":    Initialize=3
    "Negative": Initialize=4
}

FixedPool.Shape {
    "Circle":  Initialize=0
    "Rect":    Initialize=1
    "Unknown": Initialize=2
}

// List decomposition tags
FixedPool.List {
    "Empty":   Initialize=0
    "One":     Initialize=1
    "Cons":    Initialize=2
}

// Trampoline continuation tags
FixedPool.Tramp {
    "Done":    Initialize=0
    "Split":   Initialize=1
    "Merge":   Initialize=2
    "Sort":    Initialize=3
}

// State-machine phases
FixedPool.Phase {
    "Idle":    Initialize=0
    "Parse":   Initialize=1
    "Eval":    Initialize=2
    "Emit":    Initialize=3
    "Error":   Initialize=4
    "Halt":    Initialize=5
}

FixedPool.Run {
    "pass": Initialize=0, CanChange=True
    "fail": Initialize=0, CanChange=True
}

// ========================================================================
//  PART 1 — Basic value + struct classification
// ========================================================================

Function.ClassifyValue {
    Input: val: Integer
    Output: Integer
    Body: {
        Fork LessThan(val, 0) TrueBlock: {
            ReturnValue(Pat.Negative)
        } FalseBlock: {
            Fork EqualTo(val, 0) TrueBlock: {
                ReturnValue(Pat.None)
            } FalseBlock: {
                Fork LessThan(val, 10) TrueBlock: {
                    ReturnValue(Pat.Small)
                } FalseBlock: {
                    Fork LessThan(val, 100) TrueBlock: {
                        ReturnValue(Pat.Medium)
                    } FalseBlock: {
                        ReturnValue(Pat.Large)
                    }
                }
            }
        }
    }
}

Function.ClassifyPoint {
    Input: ptr: Address
    Output: Integer
    Body: {
        x = Dereference(ptr)
        y = Dereference(Add(ptr, 8))
        Fork EqualTo(Add(x, y), 0) TrueBlock: {
            ReturnValue(Pat.None)
        } FalseBlock: {
            Fork EqualTo(Multiply(x, y), 0) TrueBlock: {
                ReturnValue(Pat.Small)
            } FalseBlock: {
                Fork EqualTo(x, y) TrueBlock: {
                    ReturnValue(Pat.Medium)
                } FalseBlock: {
                    ReturnValue(Pat.Large)
                }
            }
        }
    }
}

// ========================================================================
//  PART 2 — Tagged-union shape dispatch
// ========================================================================

Function.ShapeArea {
    Input: ptr: Address
    Output: Integer
    Body: {
        tag = Dereference(ptr)
        Branch tag {
            Case Shape.Circle: {
                r = Dereference(Add(ptr, 8))
                ReturnValue(Multiply(Multiply(r, r), 3))
            }
            Case Shape.Rect: {
                w = Dereference(Add(ptr, 8))
                h = Dereference(Add(ptr, 16))
                ReturnValue(Multiply(w, h))
            }
            Default: {
                ReturnValue(-1)
            }
        }
    }
}

// ========================================================================
//  PART 3 — Nested match with guard clauses
// ========================================================================

Function.DetailedClassify {
    Input: val: Integer
    Output: Integer
    Body: {
        tag = ClassifyValue(val)
        Branch tag {
            Case Pat.Small: {
                Fork EqualTo(Modulo(val, 2), 0) TrueBlock: {
                    ReturnValue(100)
                } FalseBlock: {
                    ReturnValue(101)
                }
            }
            Case Pat.Medium: {
                Fork EqualTo(Modulo(val, 10), 0) TrueBlock: {
                    ReturnValue(200)
                } FalseBlock: {
                    ReturnValue(201)
                }
            }
            Default: {
                ReturnValue(0)
            }
        }
    }
}

// ========================================================================
//  PART 4 — Head / Tail linked-list pattern decomposition
//
//  Node layout: [next_ptr (8 bytes) | value (8 bytes)]
//  Empty list = 0 (null pointer)
// ========================================================================

Function.ListPush {
    Input: head: Address
    Input: val: Integer
    Output: Address
    Body: {
        node = Allocate(16)
        StoreValue(node, head)
        StoreValue(Add(node, 8), val)
        ReturnValue(node)
    }
}

Function.ListMatch {
    Input: head: Address
    Output: Integer
    Body: {
        Fork EqualTo(head, 0) TrueBlock: {
            ReturnValue(List.Empty)
        } FalseBlock: {
            next = Dereference(head)
            Fork EqualTo(next, 0) TrueBlock: {
                ReturnValue(List.One)
            } FalseBlock: {
                ReturnValue(List.Cons)
            }
        }
    }
}

Function.ListHead {
    Input: node: Address
    Output: Integer
    Body: { ReturnValue(Dereference(Add(node, 8))) }
}

Function.ListTail {
    Input: node: Address
    Output: Address
    Body: { ReturnValue(Dereference(node)) }
}

Function.ListLen {
    Input: head: Address
    Output: Integer
    Body: {
        n = 0
        cur = head
        WhileLoop GreaterThan(cur, 0) {
            n = Add(n, 1)
            cur = Dereference(cur)
        }
        ReturnValue(n)
    }
}

// Sum a list via head/tail decomposition — recursive style
Function.ListSum {
    Input: head: Address
    Output: Integer
    Body: {
        tag = ListMatch(head)
        Branch tag {
            Case List.Empty: {
                ReturnValue(0)
            }
            Case List.One: {
                ReturnValue(ListHead(head))
            }
            Default: {
                ReturnValue(Add(ListHead(head), ListSum(ListTail(head))))
            }
        }
    }
}

// Reverse a list via head/tail pattern + accumulator
Function.ListReverse {
    Input: head: Address
    Output: Address
    Body: {
        acc = 0
        cur = head
        WhileLoop GreaterThan(cur, 0) {
            next = Dereference(cur)
            StoreValue(cur, acc)
            acc = cur
            cur = next
        }
        ReturnValue(acc)
    }
}

// Map: apply a transformation tag to every element
// Transform tags: 0=double, 1=negate, 2=square
FixedPool.Xform {
    "Double":  Initialize=0
    "Negate":  Initialize=1
    "Square":  Initialize=2
}

Function.ApplyXform {
    Input: val: Integer
    Input: xf: Integer
    Output: Integer
    Body: {
        Branch xf {
            Case Xform.Double: { ReturnValue(Multiply(val, 2)) }
            Case Xform.Negate: { ReturnValue(Subtract(0, val)) }
            Case Xform.Square: { ReturnValue(Multiply(val, val)) }
            Default:           { ReturnValue(val) }
        }
    }
}

Function.ListMap {
    Input: head: Address
    Input: xf: Integer
    Output: Address
    Body: {
        result = 0
        cur = head
        WhileLoop GreaterThan(cur, 0) {
            val = Dereference(Add(cur, 8))
            result = ListPush(result, ApplyXform(val, xf))
            cur = Dereference(cur)
        }
        ReturnValue(ListReverse(result))
    }
}

// ========================================================================
//  PART 5 — Trampoline merge sort
//
//  Instead of deep recursion, the sort loop bounces through a
//  continuation struct:  [tag | left | right | result]
//  Each iteration pattern-matches the tag and does one step.
// ========================================================================

// Continuation frame: 4 slots * 8 bytes = 32 bytes
// [0]=tag  [8]=left  [16]=right  [24]=result

Function.TrSplit {
    Input: head: Address
    Input: left_out: Address
    Input: right_out: Address
    Body: {
        l = 0
        r = 0
        flip = 0
        cur = head
        WhileLoop GreaterThan(cur, 0) {
            next = Dereference(cur)
            Fork EqualTo(flip, 0) TrueBlock: {
                StoreValue(cur, l)
                l = cur
                flip = 1
            } FalseBlock: {
                StoreValue(cur, r)
                r = cur
                flip = 0
            }
            cur = next
        }
        StoreValue(left_out, l)
        StoreValue(right_out, r)
    }
}

Function.TrMerge {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        result = 0
        tail_ptr = AddressOf(result)
        ca = a
        cb = b
        WhileLoop GreaterThan(Add(ca, cb), 0) {
            Fork EqualTo(ca, 0) TrueBlock: {
                StoreValue(tail_ptr, cb)
                cb = 0
            } FalseBlock: {
                Fork EqualTo(cb, 0) TrueBlock: {
                    StoreValue(tail_ptr, ca)
                    ca = 0
                } FalseBlock: {
                    va = Dereference(Add(ca, 8))
                    vb = Dereference(Add(cb, 8))
                    Fork LessThan(va, vb) TrueBlock: {
                        next_a = Dereference(ca)
                        StoreValue(tail_ptr, ca)
                        tail_ptr = ca
                        StoreValue(ca, 0)
                        ca = next_a
                    } FalseBlock: {
                        next_b = Dereference(cb)
                        StoreValue(tail_ptr, cb)
                        tail_ptr = cb
                        StoreValue(cb, 0)
                        cb = next_b
                    }
                }
            }
        }
        ReturnValue(result)
    }
}

// Iterative bottom-up merge sort using the trampoline pattern:
// keep doubling the run width, merge adjacent pairs each pass.
Function.TrSort {
    Input: head: Address
    Input: len: Integer
    Output: Address
    Body: {
        Fork LessThan(len, 2) TrueBlock: {
            ReturnValue(head)
        } FalseBlock: {
            cont = Allocate(32)
            StoreValue(cont, Tramp.Sort)
            StoreValue(Add(cont, 8), head)
            StoreValue(Add(cont, 16), 0)
            StoreValue(Add(cont, 24), 0)

            width = 1
            WhileLoop LessThan(width, len) {
                src = Dereference(Add(cont, 8))
                merged = 0
                merge_tail = AddressOf(merged)

                WhileLoop GreaterThan(src, 0) {
                    // Peel off 'width' nodes for left run
                    left = src
                    i = 0
                    prev = 0
                    WhileLoop LessThan(i, width) {
                        Fork EqualTo(src, 0) TrueBlock: {
                            i = width
                        } FalseBlock: {
                            prev = src
                            src = Dereference(src)
                            i = Add(i, 1)
                        }
                    }
                    Fork GreaterThan(prev, 0) TrueBlock: {
                        StoreValue(prev, 0)
                    } FalseBlock: { }

                    // Peel off 'width' nodes for right run
                    right = src
                    i = 0
                    prev = 0
                    WhileLoop LessThan(i, width) {
                        Fork EqualTo(src, 0) TrueBlock: {
                            i = width
                        } FalseBlock: {
                            prev = src
                            src = Dereference(src)
                            i = Add(i, 1)
                        }
                    }
                    Fork GreaterThan(prev, 0) TrueBlock: {
                        StoreValue(prev, 0)
                    } FalseBlock: { }

                    // Merge the two runs
                    m = TrMerge(left, right)
                    StoreValue(merge_tail, m)
                    // Walk to end of merged segment
                    WhileLoop GreaterThan(m, 0) {
                        merge_tail = m
                        m = Dereference(m)
                    }
                }

                StoreValue(Add(cont, 8), merged)
                width = Multiply(width, 2)
            }

            result = Dereference(Add(cont, 8))
            Deallocate(cont, 32)
            ReturnValue(result)
        }
    }
}

// ========================================================================
//  PART 6 — Pattern-matched state machine
//
//  A mini pipeline: Idle → Parse → Eval → Emit → Halt
//  Errors from any state jump to Error → Halt.
//  Each transition is a Branch on the current phase tag.
// ========================================================================

// Machine state: [phase (8) | input (8) | accum (8) | steps (8)]
Function.SM_Init {
    Input: m: Address
    Input: input_val: Integer
    Body: {
        StoreValue(m, Phase.Idle)
        StoreValue(Add(m, 8), input_val)
        StoreValue(Add(m, 16), 0)
        StoreValue(Add(m, 24), 0)
    }
}

Function.SM_Step {
    Input: m: Address
    Body: {
        phase = Dereference(m)
        input_val = Dereference(Add(m, 8))
        accum = Dereference(Add(m, 16))
        steps = Dereference(Add(m, 24))
        StoreValue(Add(m, 24), Add(steps, 1))

        Branch phase {
            Case Phase.Idle: {
                StoreValue(m, Phase.Parse)
            }
            Case Phase.Parse: {
                // "Parse" = validate input is positive
                Fork LessThan(input_val, 0) TrueBlock: {
                    StoreValue(m, Phase.Error)
                } FalseBlock: {
                    StoreValue(Add(m, 16), input_val)
                    StoreValue(m, Phase.Eval)
                }
            }
            Case Phase.Eval: {
                // "Eval" = triangular number: n*(n+1)/2
                n = Dereference(Add(m, 16))
                result = Divide(Multiply(n, Add(n, 1)), 2)
                StoreValue(Add(m, 16), result)
                StoreValue(m, Phase.Emit)
            }
            Case Phase.Emit: {
                StoreValue(m, Phase.Halt)
            }
            Case Phase.Error: {
                StoreValue(Add(m, 16), -1)
                StoreValue(m, Phase.Halt)
            }
            Default: { }
        }
    }
}

Function.SM_Run {
    Input: m: Address
    Body: {
        phase = Dereference(m)
        WhileLoop LessThan(phase, Phase.Halt) {
            SM_Step(m)
            phase = Dereference(m)
        }
    }
}

// ========================================================================
//  Test harness
// ========================================================================

Function.Check {
    Input: got: Integer
    Input: want: Integer
    Input: label: Address
    Body: {
        PrintMessage("  ")
        PrintMessage(label)
        Fork EqualTo(got, want) TrueBlock: {
            PrintMessage(" PASS\n")
            Run.pass = Add(Run.pass, 1)
        } FalseBlock: {
            PrintMessage(" FAIL (got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage(")\n")
            Run.fail = Add(Run.fail, 1)
        }
    }
}

Function.PrintList {
    Input: head: Address
    Body: {
        PrintMessage("[")
        cur = head
        first = 1
        WhileLoop GreaterThan(cur, 0) {
            Fork EqualTo(first, 0) TrueBlock: {
                PrintMessage(" ")
            } FalseBlock: {
                first = 0
            }
            PrintNumber(Dereference(Add(cur, 8)))
            cur = Dereference(cur)
        }
        PrintMessage("]")
    }
}

// ========================================================================
//  Test subroutines
// ========================================================================

SubRoutine.TestBasicClassify {
    PrintMessage("--- 1. Basic value classification ---\n")
    Check(ClassifyValue(-5),  Pat.Negative, "negative")
    Check(ClassifyValue(0),   Pat.None,     "zero")
    Check(ClassifyValue(7),   Pat.Small,    "small")
    Check(ClassifyValue(42),  Pat.Medium,   "medium")
    Check(ClassifyValue(999), Pat.Large,    "large")
}

SubRoutine.TestPointClassify {
    PrintMessage("--- 2. Point struct classification ---\n")
    pt = Allocate(16)
    StoreValue(pt, 0)
    StoreValue(Add(pt, 8), 0)
    Check(ClassifyPoint(pt), Pat.None, "origin(0,0)")
    StoreValue(pt, 5)
    StoreValue(Add(pt, 8), 0)
    Check(ClassifyPoint(pt), Pat.Small, "axis(5,0)")
    StoreValue(pt, 3)
    StoreValue(Add(pt, 8), 3)
    Check(ClassifyPoint(pt), Pat.Medium, "diag(3,3)")
    StoreValue(pt, 2)
    StoreValue(Add(pt, 8), 7)
    Check(ClassifyPoint(pt), Pat.Large, "general(2,7)")
    Deallocate(pt, 16)
}

SubRoutine.TestShapeArea {
    PrintMessage("--- 3. Shape tagged-union dispatch ---\n")
    s = Allocate(24)
    StoreValue(s, Shape.Circle)
    StoreValue(Add(s, 8), 5)
    Check(ShapeArea(s), 75, "circle r=5")
    StoreValue(s, Shape.Rect)
    StoreValue(Add(s, 8), 4)
    StoreValue(Add(s, 16), 7)
    Check(ShapeArea(s), 28, "rect 4x7")
    StoreValue(s, Shape.Unknown)
    Check(ShapeArea(s), -1, "unknown shape")
    Deallocate(s, 24)
}

SubRoutine.TestNestedMatch {
    PrintMessage("--- 4. Nested match + guard clauses ---\n")
    Check(DetailedClassify(4),  100, "small even(4)")
    Check(DetailedClassify(7),  101, "small odd(7)")
    Check(DetailedClassify(30), 200, "medium round(30)")
    Check(DetailedClassify(42), 201, "medium odd(42)")
    Check(DetailedClassify(0),  0,   "fallthrough(0)")
}

SubRoutine.TestListPatterns {
    PrintMessage("--- 5. Head/tail list decomposition ---\n")

    // Build list [10, 20, 30, 40, 50]
    lst = 0
    lst = ListPush(lst, 50)
    lst = ListPush(lst, 40)
    lst = ListPush(lst, 30)
    lst = ListPush(lst, 20)
    lst = ListPush(lst, 10)

    Check(ListMatch(0), List.Empty, "match empty")
    one = ListPush(0, 99)
    Check(ListMatch(one), List.One, "match singleton")
    Check(ListMatch(lst), List.Cons, "match cons")
    Check(ListHead(lst), 10, "head [10..]")
    Check(ListHead(ListTail(lst)), 20, "head(tail) [20..]")
    Check(ListLen(lst), 5, "length=5")
    Check(ListSum(lst), 150, "sum=150")

    // Map: double every element, sum should be 300
    doubled = ListMap(lst, Xform.Double)
    PrintMessage("  doubled: ")
    PrintList(doubled)
    PrintMessage("\n")
    Check(ListSum(doubled), 300, "doubled sum=300")

    // Map: negate, sum should be -150
    negated = ListMap(lst, Xform.Negate)
    PrintMessage("  negated: ")
    PrintList(negated)
    PrintMessage("\n")
    Check(ListSum(negated), -150, "negated sum=-150")

    // Map: square [10,20,30,40,50] → [100,400,900,1600,2500]
    squared = ListMap(lst, Xform.Square)
    PrintMessage("  squared: ")
    PrintList(squared)
    PrintMessage("\n")
    Check(ListSum(squared), 5500, "squared sum=5500")
}

SubRoutine.TestTrampolineSort {
    PrintMessage("--- 6. Trampoline merge sort ---\n")

    // Build unsorted list [38, 27, 43, 3, 9, 82, 10]
    s = 0
    s = ListPush(s, 10)
    s = ListPush(s, 82)
    s = ListPush(s, 9)
    s = ListPush(s, 3)
    s = ListPush(s, 43)
    s = ListPush(s, 27)
    s = ListPush(s, 38)

    PrintMessage("  before: ")
    PrintList(s)
    PrintMessage("\n")

    sorted = TrSort(s, 7)

    PrintMessage("  after:  ")
    PrintList(sorted)
    PrintMessage("\n")

    // Verify sorted order by checking each adjacent pair
    ok = 1
    cur = sorted
    WhileLoop GreaterThan(cur, 0) {
        next = Dereference(cur)
        Fork GreaterThan(next, 0) TrueBlock: {
            a = Dereference(Add(cur, 8))
            b = Dereference(Add(next, 8))
            Fork GreaterThan(a, b) TrueBlock: {
                ok = 0
            } FalseBlock: { }
        } FalseBlock: { }
        cur = next
    }
    Check(ok, 1, "sorted order")
    Check(ListSum(sorted), 212, "sum preserved=212")

    // Sort an already-sorted single element
    solo = ListPush(0, 42)
    solo_s = TrSort(solo, 1)
    Check(ListHead(solo_s), 42, "sort singleton=42")

    // Sort two elements in wrong order
    pair = ListPush(ListPush(0, 1), 99)
    pair_s = TrSort(pair, 2)
    Check(ListHead(pair_s), 1, "sort pair head=1")
    Check(ListHead(ListTail(pair_s)), 99, "sort pair tail=99")

    // Sort 15 elements: descending 15..1
    big = 0
    i = 1
    WhileLoop LessThan(i, 16) {
        big = ListPush(big, i)
        i = Add(i, 1)
    }
    PrintMessage("  desc15: ")
    PrintList(big)
    PrintMessage("\n")
    big_s = TrSort(big, 15)
    PrintMessage("  sorted: ")
    PrintList(big_s)
    PrintMessage("\n")
    Check(ListSum(big_s), 120, "desc15 sum=120")
    // First element should be 1
    Check(ListHead(big_s), 1, "desc15 head=1")
}

SubRoutine.TestStateMachine {
    PrintMessage("--- 7. Pattern-matched state machine ---\n")
    m = Allocate(32)

    // Normal path: Idle→Parse→Eval→Emit→Halt, input=10 → tri(10)=55
    SM_Init(m, 10)
    SM_Run(m)
    Check(Dereference(m), Phase.Halt, "sm halted")
    Check(Dereference(Add(m, 16)), 55, "tri(10)=55")
    Check(Dereference(Add(m, 24)), 4, "4 steps")

    // Error path: negative input → accum=-1
    SM_Init(m, -5)
    SM_Run(m)
    Check(Dereference(m), Phase.Halt, "sm error halted")
    Check(Dereference(Add(m, 16)), -1, "error accum=-1")

    // Edge: input=0 → tri(0)=0
    SM_Init(m, 0)
    SM_Run(m)
    Check(Dereference(Add(m, 16)), 0, "tri(0)=0")

    // Edge: input=1 → tri(1)=1
    SM_Init(m, 1)
    SM_Run(m)
    Check(Dereference(Add(m, 16)), 1, "tri(1)=1")

    Deallocate(m, 32)
}

// ========================================================================
//  Main
// ========================================================================

SubRoutine.Main {
    PrintMessage("=== AILang Pattern Matching Demo ===\n\n")

    RunTask(TestBasicClassify)
    PrintMessage("\n")
    RunTask(TestPointClassify)
    PrintMessage("\n")
    RunTask(TestShapeArea)
    PrintMessage("\n")
    RunTask(TestNestedMatch)
    PrintMessage("\n")
    RunTask(TestListPatterns)
    PrintMessage("\n")
    RunTask(TestTrampolineSort)
    PrintMessage("\n")
    RunTask(TestStateMachine)

    PrintMessage("\n--- Results: ")
    PrintNumber(Run.pass)
    PrintMessage(" passed, ")
    PrintNumber(Run.fail)
    PrintMessage(" failed ---\n")

    ProcessExit(Run.fail)
}

RunTask(Main)
