// 272 — catch / except an exception — DESIGN NOTE
// Without a `throw` mechanism (271), there is no `catch`. The
// equivalent in AiLang is "check the return value and branch on it"
// — the caller is in charge, with no runtime unwinding magic.
//
// Worked example: caller invokes WithdrawCash from 286, branches on
// the negative sentinels to give the user a clean error message
// (see 290 for the explanation table).
Function.WithdrawCash {
    Input: balance: Integer
    Input: amount: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(amount, 0) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        IfCondition GreaterThan(amount, balance) ThenBlock: { ReturnValue(Subtract(0, 2)) }
        ReturnValue(Subtract(balance, amount))
    }
}

SubRoutine.Main {
    result = WithdrawCash(100, 250)

    // The "catch": branch on the sentinel.
    IfCondition LessThan(result, 0) ThenBlock: {
        PrintMessage("withdrawal rejected, code ")
        PrintNumber(result)
        PrintMessage("\n")
    } ElseBlock: {
        PrintMessage("ok, new balance = ")
        PrintNumber(result)
        PrintMessage("\n")
    }
}
RunTask(Main)
