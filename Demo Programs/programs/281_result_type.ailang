// 281 — Result type / Either type — DESIGN NOTE
// Rust `Result<T, E>`, Haskell `Either a b`, OCaml `result`. A value
// that's either Ok(payload) or Err(reason). The type system forces
// the caller to handle both arms before reaching the payload.
//
// AiLang has no sum types, so there's no `Result<T, E>` to return.
// The functional equivalent — "this call either succeeded or it
// failed; tell me which" — is the negative-sentinel convention:
//
//   * Non-negative return value = success, value is the payload.
//   * Negative return value     = failure, code identifies the reason.
//
// Two information channels (success/failure flag + payload/code) in
// one Integer, decoded by sign. No type-system enforcement that the
// caller checks the sign — that's the trade for one return register.
Function.ParseDigit {
    Input: c: Integer
    Output: Integer
    Body: {
        // Success: returns 0..9. Failure: returns -1 (not a digit).
        IfCondition LessThan(c, 48) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        IfCondition GreaterThan(c, 57) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        ReturnValue(Subtract(c, 48))
    }
}

SubRoutine.TryDigit {
    r = ParseDigit(TryDigitInput.c)
    IfCondition LessThan(r, 0) ThenBlock: {
        PrintChar(TryDigitInput.c)
        PrintMessage(" -> ERR (not a digit)\n")
    } ElseBlock: {
        PrintChar(TryDigitInput.c)
        PrintMessage(" -> OK ")
        PrintNumber(r)
        PrintMessage("\n")
    }
}

FixedPool.TryDigitInput {
    "c": Initialize=0
}

SubRoutine.Main {
    TryDigitInput.c = 51       // '3'
    RunTask(TryDigit)
    TryDigitInput.c = 65       // 'A'
    RunTask(TryDigit)
    TryDigitInput.c = 57       // '9'
    RunTask(TryDigit)
}
RunTask(Main)
