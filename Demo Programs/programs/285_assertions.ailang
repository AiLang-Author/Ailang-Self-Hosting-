// 285 — assert() and preconditions
// An assertion is a runtime check that something the code believes
// to be true is, in fact, true. Failure usually halts the program
// — assertions document invariants in executable form: a mistake
// reveals itself the first time the invariant breaks, instead of
// silently propagating to wrong output far away.
//
// AiLang doesn't ship an `assert` keyword. The pattern is a small
// SubRoutine that prints + halts on a false condition, called from
// any spot that wants to enforce an invariant.
FixedPool.AssertCtx {
    "label": Initialize=""
}

SubRoutine.AssertHere {
    PrintMessage("ASSERTION FAILED: ")
    PrintMessage(AssertCtx.label)
    PrintMessage("\n")
    HaltProgram(1)
}

Function.SafeDivide {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(b, 0) ThenBlock: {
            AssertCtx.label = "SafeDivide: divisor must be non-zero"
            RunTask(AssertHere)
        }
        ReturnValue(Divide(a, b))
    }
}

SubRoutine.Main {
    PrintMessage("100 / 4 = ")
    PrintNumber(SafeDivide(100, 4))
    PrintMessage("\n")

    // Uncomment to see the assertion fire and halt the program:
    // PrintNumber(SafeDivide(100, 0))

    PrintMessage("(uncomment line 32 to trip the assertion)\n")
}
RunTask(Main)
