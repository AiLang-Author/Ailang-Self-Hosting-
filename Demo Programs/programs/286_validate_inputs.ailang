// 286 — Validate function inputs
// "Defensive programming" of one specific shape: every public
// function checks its inputs against documented preconditions
// before doing real work, returning an error sentinel (or halting,
// depending on severity) when a violation is found.
//
// In AiLang, the natural place is an IfCondition ladder at the top
// of the function — each guard returns a distinct negative sentinel
// on a violation, falling through to the body when all checks pass.
// Distinct negatives let the caller distinguish *which* invariant
// failed without parsing strings.
Function.WithdrawCash {
    Input: balance: Integer
    Input: amount: Integer
    Output: Integer        // returns new balance, or negative error code
    Body: {
        // -1: amount must be positive
        IfCondition LessEqual(amount, 0) ThenBlock: {
            ReturnValue(Subtract(0, 1))
        }
        // -2: insufficient funds
        IfCondition GreaterThan(amount, balance) ThenBlock: {
            ReturnValue(Subtract(0, 2))
        }
        // -3: regulatory cap (just an example value)
        IfCondition GreaterThan(amount, 1000) ThenBlock: {
            ReturnValue(Subtract(0, 3))
        }
        ReturnValue(Subtract(balance, amount))
    }
}

SubRoutine.Main {
    PrintMessage("Withdraw 100 from 500   -> ")
    PrintNumber(WithdrawCash(500, 100))      // 400
    PrintMessage("\nWithdraw 0 from 500     -> ")
    PrintNumber(WithdrawCash(500, 0))        // -1
    PrintMessage("\nWithdraw 600 from 500   -> ")
    PrintNumber(WithdrawCash(500, 600))      // -2
    PrintMessage("\nWithdraw 2000 from 5000 -> ")
    PrintNumber(WithdrawCash(5000, 2000))    // -3
    PrintMessage("\n")
}
RunTask(Main)
