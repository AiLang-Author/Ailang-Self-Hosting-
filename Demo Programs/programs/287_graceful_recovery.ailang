// 287 — Graceful error recovery
// "Don't die on the first failure if there's something useful you
// could still do." A typical example: read a list of work items,
// process each, and if one fails, log and continue with the rest
// rather than abort the whole batch.
//
// AiLang's flavor: the per-item function returns a sentinel; the
// dispatching loop checks it, logs the failure, increments an
// error counter, and continues to the next item. At the end you
// know how many succeeded vs failed.
Function.ProcessItem {
    Input: id: Integer
    Output: Integer        // 0 = ok, negative = failed
    Body: {
        // Pretend item 3 always fails.
        IfCondition EqualTo(id, 3) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    succeeded = 0
    failed = 0

    i = 1
    WhileLoop LessEqual(i, 5) {
        rc = ProcessItem(i)
        IfCondition LessThan(rc, 0) ThenBlock: {
            PrintMessage("  item ")
            PrintNumber(i)
            PrintMessage(" FAILED, continuing\n")
            failed = Add(failed, 1)
        } ElseBlock: {
            PrintMessage("  item ")
            PrintNumber(i)
            PrintMessage(" ok\n")
            succeeded = Add(succeeded, 1)
        }
        i = Add(i, 1)
    }

    PrintMessage("\nbatch summary: ")
    PrintNumber(succeeded)
    PrintMessage(" succeeded, ")
    PrintNumber(failed)
    PrintMessage(" failed\n")
}
RunTask(Main)
