// 290 — User-friendly error messages
// Compare:
//
//   "Error 17"                                — fast, useless
//   "EINVAL"                                  — needs the manual
//   "invalid argument: timeout must be > 0"   — actionable
//
// The third form names the violated invariant, gives the bad value
// when relevant, and points at how to fix it. The cost is a string
// per error path — usually a rounding error in source size, much
// less in mental load on whoever reads the message at 3am.
//
// The Branch dispatch below is the canonical AiLang shape for
// translating an error code into the human-readable form.
Function.ExplainError {
    Input: code: Integer
    Body: {
        Branch code {
            Case 0:  { PrintMessage("ok\n") }
            Case 1:  { PrintMessage("amount must be > 0 (was 0 or negative)\n") }
            Case 2:  { PrintMessage("insufficient funds: requested more than available balance\n") }
            Case 3:  { PrintMessage("amount exceeds withdrawal cap of 1000\n") }
            Default: {
                PrintMessage("unknown error code: ")
                PrintNumber(code)
                PrintMessage(" (please report)\n")
            }
        }
    }
}

SubRoutine.Main {
    ExplainError(0)
    ExplainError(1)
    ExplainError(2)
    ExplainError(3)
    ExplainError(99)
}
RunTask(Main)
