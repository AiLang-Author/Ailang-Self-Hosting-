// 436 — Greatest common divisor (Euclidean algorithm)
// Euclid, ~300 BC: gcd(a, b) = gcd(b, a mod b), terminating when b is
// zero. Logarithmic in the smaller input, no array, no allocation —
// arguably the cleanest non-trivial recursive function in CS.
Function.GCD {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(a) }
        ReturnValue(GCD(b, Modulo(a, b)))
    }
}

SubRoutine.Main {
    PrintMessage("gcd(48, 18)  = ")
    PrintNumber(GCD(48, 18))
    PrintMessage("\ngcd(270, 192) = ")
    PrintNumber(GCD(270, 192))
    PrintMessage("\ngcd(17, 13)   = ")
    PrintNumber(GCD(17, 13))    // coprime → 1
    PrintMessage("\n")
}
RunTask(Main)
