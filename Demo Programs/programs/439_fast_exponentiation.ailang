// 439 — Fast (binary) exponentiation
// Naive a^n is N multiplications. Binary exponentiation is log2(N) by
// observing a^n = (a^(n/2))^2 when n is even, a*(a^(n-1)) when n is
// odd. Iterative form below — no recursion, no stack growth.
//
// For modular variants, sprinkle a `mod m` into each Multiply step;
// the structure is identical (used in RSA, DH, hash chains, etc.).
Function.Pow {
    Input: base: Integer
    Input: exp: Integer
    Output: Integer
    Body: {
        result = 1
        b = base
        e = exp
        WhileLoop GreaterThan(e, 0) {
            IfCondition EqualTo(Modulo(e, 2), 1) ThenBlock: {
                result = Multiply(result, b)
            }
            b = Multiply(b, b)
            e = Divide(e, 2)
        }
        ReturnValue(result)
    }
}

SubRoutine.Main {
    PrintMessage("2^10 = ")
    PrintNumber(Pow(2, 10))     // 1024
    PrintMessage("\n3^7  = ")
    PrintNumber(Pow(3, 7))      // 2187
    PrintMessage("\n5^0  = ")
    PrintNumber(Pow(5, 0))      // 1
    PrintMessage("\n7^11 = ")
    PrintNumber(Pow(7, 11))     // 1977326743
    PrintMessage("\n")
}
RunTask(Main)
