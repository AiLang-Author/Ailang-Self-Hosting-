// Attention.ailang
// Q/K/V projections, RoPE, KV caching, dot-product attention scoring.
// All arithmetic is native float64.

Import.Config
Import.ModelLoader

// ============================================================================
// Q PROJECTION  (hidden_dim x hidden_dim)
// Reads LayerInput.x_ptr, writes to LayerOutput.x_ptr
// ============================================================================

SubRoutine.ProjectToQuery {
    wq     = Model_GetWq(State.current_layer)
    hidden = Config.hidden_dim

    out_dim = 0
    WhileLoop LessThan(out_dim, hidden) {
        sum = 0.0
        in_dim = 0
        WhileLoop LessThan(in_dim, hidden) {
            x_ptr = Add(LayerInput.x_ptr, Multiply(in_dim, 8))
            x_val = Dereference(x_ptr)
            w_off = Multiply(Add(Multiply(out_dim, hidden), in_dim), 8)
            w_val = Dereference(Add(wq, w_off))
            sum   = Add(sum, Multiply(x_val, w_val))
            in_dim = Add(in_dim, 1)
        }
        StoreValue(Add(LayerOutput.x_ptr, Multiply(out_dim, 8)), sum)
        out_dim = Add(out_dim, 1)
    }

    ControlMailbox.slot0 = Commands.CMD_PROJECT_K
    ReturnValue(0)
}

// ============================================================================
// K PROJECTION  (kv_heads * head_dim  x  hidden_dim)
// ============================================================================

SubRoutine.ProjectToKey {
    wk     = Model_GetWk(State.current_layer)
    hidden = Config.hidden_dim
    kv_dim = Multiply(Config.kv_heads, Config.head_dim)

    out_dim = 0
    WhileLoop LessThan(out_dim, kv_dim) {
        sum = 0.0
        in_dim = 0
        WhileLoop LessThan(in_dim, hidden) {
            x_ptr = Add(LayerInput.x_ptr, Multiply(in_dim, 8))
            x_val = Dereference(x_ptr)
            w_off = Multiply(Add(Multiply(out_dim, hidden), in_dim), 8)
            w_val = Dereference(Add(wk, w_off))
            sum   = Add(sum, Multiply(x_val, w_val))
            in_dim = Add(in_dim, 1)
        }
        StoreValue(Add(LayerOutput.x_ptr, Multiply(out_dim, 8)), sum)
        out_dim = Add(out_dim, 1)
    }

    ControlMailbox.slot0 = Commands.CMD_PROJECT_V
    ReturnValue(0)
}

// ============================================================================
// V PROJECTION  (kv_heads * head_dim  x  hidden_dim)
// ============================================================================

SubRoutine.ProjectToValue {
    wv     = Model_GetWv(State.current_layer)
    hidden = Config.hidden_dim
    kv_dim = Multiply(Config.kv_heads, Config.head_dim)

    out_dim = 0
    WhileLoop LessThan(out_dim, kv_dim) {
        sum = 0.0
        in_dim = 0
        WhileLoop LessThan(in_dim, hidden) {
            x_ptr = Add(LayerInput.x_ptr, Multiply(in_dim, 8))
            x_val = Dereference(x_ptr)
            w_off = Multiply(Add(Multiply(out_dim, hidden), in_dim), 8)
            w_val = Dereference(Add(wv, w_off))
            sum   = Add(sum, Multiply(x_val, w_val))
            in_dim = Add(in_dim, 1)
        }
        StoreValue(Add(LayerOutput.x_ptr, Multiply(out_dim, 8)), sum)
        out_dim = Add(out_dim, 1)
    }

    ControlMailbox.slot0 = Commands.CMD_APPLY_ROPE
    ReturnValue(0)
}

// ============================================================================
// ROPE  (Rotary Position Embedding)
// Applied in-place on LayerInput.x_ptr.
// Rotates every (real, imag) pair by theta = pos / (rope_base ^ (2i/head_dim)).
// ============================================================================

SubRoutine.ApplyRoPE {
    pos       = State.seq_pos
    head_dim  = Config.head_dim
    num_heads = Config.num_heads

    head = 0
    WhileLoop LessThan(head, num_heads) {
        head_off = Multiply(head, head_dim)

        pair = 0
        WhileLoop LessThan(pair, Divide(head_dim, 2)) {
            dim_real = Add(head_off, Multiply(pair, 2))
            dim_imag = Add(dim_real, 1)

            // theta = pos / (rope_base ^ (2*pair / head_dim))
            exp_arg = Divide(Multiply(2.0, pair), head_dim)
            denom   = Power(Config.rope_base, exp_arg)
            theta   = Divide(pos, denom)

            cos_t = Math.Cos(theta)
            sin_t = Math.Sin(theta)

            ptr_real = Add(LayerInput.x_ptr, Multiply(dim_real, 8))
            ptr_imag = Add(LayerInput.x_ptr, Multiply(dim_imag, 8))

            r = Dereference(ptr_real)
            im = Dereference(ptr_imag)

            new_r  = Subtract(Multiply(r, cos_t), Multiply(im, sin_t))
            new_im = Add(Multiply(r, sin_t), Multiply(im, cos_t))

            StoreValue(ptr_real, new_r)
            StoreValue(ptr_imag, new_im)

            pair = Add(pair, 1)
        }

        head = Add(head, 1)
    }

    ControlMailbox.slot0 = Commands.CMD_CACHE_KV
    ReturnValue(0)
}

// ============================================================================
// CACHE KV
// Writes current K and V vectors into the circular KV cache at seq_pos % cache_slots.
// ============================================================================

SubRoutine.CacheKV {
    slot       = Modulo(State.seq_pos, Config.cache_slots)
    slot_bytes = Multiply(Config.hidden_dim, 8)
    slot_off   = Multiply(slot, slot_bytes)

    kv_dim      = Multiply(Config.kv_heads, Config.head_dim)
    kv_bytes    = Multiply(kv_dim, 8)

    // Key comes from Workspace.x_buf_B (output of ProjectToKey written there by Layer)
    key_src  = Workspace.x_buf_B
    key_dest = Add(Pointers.KeyCache, Multiply(slot, kv_bytes))
    MemoryCopy(key_dest, key_src, kv_bytes)

    // Value comes from Workspace.x_buf_A (output of ProjectToValue)
    // Layer.ailang swaps buffers; caller is responsible for setting LayerInput.x_ptr
    // to the correct buffer before RunTask(CacheKV). See Layer.ailang CMD_CACHE_KV.
    val_src  = LayerInput.x_ptr
    val_dest = Add(Pointers.ValueCache, Multiply(slot, kv_bytes))
    MemoryCopy(val_dest, val_src, kv_bytes)

    ControlMailbox.slot0 = Commands.CMD_COMPUTE_ATTENTION
    ReturnValue(0)
}

// ============================================================================
// COMPUTE SINGLE HEAD ATTENTION
// Scores current Q head against all cached K vectors.
// Stores raw (unscaled) scores into AttentionScores.
// Called once per head — caller loops via CMD_COMPUTE_ATTENTION.
// ============================================================================

SubRoutine.ComputeSingleHeadAttention {
    head     = State.current_head
    kv_head  = Divide(head, Config.group_size)
    head_dim = Config.head_dim

    num_cached = State.seq_pos
    IfCondition GreaterThan(num_cached, Config.cache_slots) ThenBlock: {
        num_cached = Config.cache_slots
    }

    kv_bytes = Multiply(Multiply(Config.kv_heads, head_dim), 8)

    cache_idx = 0
    WhileLoop LessThan(cache_idx, num_cached) {
        score = 0.0
        dim = 0
        WhileLoop LessThan(dim, head_dim) {
            // Q dimension index
            q_dim = Add(Multiply(head, head_dim), dim)
            q_ptr = Add(LayerInput.x_ptr, Multiply(q_dim, 8))
            q_val = Dereference(q_ptr)

            // K dimension index (GQA: kv_head selects the right KV head)
            k_dim    = Add(Multiply(kv_head, head_dim), dim)
            k_off    = Multiply(k_dim, 8)
            k_slot   = Multiply(cache_idx, kv_bytes)
            k_ptr    = Add(Add(Pointers.KeyCache, k_slot), k_off)
            k_val    = Dereference(k_ptr)

            score = Add(score, Multiply(q_val, k_val))
            dim   = Add(dim, 1)
        }

        // Scale by 1/sqrt(head_dim)
        scale        = Divide(1.0, SquareRoot(head_dim))
        scaled_score = Multiply(score, scale)

        score_idx = Add(Multiply(head, Config.cache_slots), cache_idx)
        score_ptr = Add(Pointers.AttentionScores, Multiply(score_idx, 8))
        StoreValue(score_ptr, scaled_score)

        cache_idx = Add(cache_idx, 1)
    }

    // Control flow handled in Layer.ailang after RunTask returns
    ReturnValue(0)
}