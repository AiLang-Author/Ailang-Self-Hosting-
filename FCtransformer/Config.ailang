// Config.ailang
// All FixedPool definitions for the SmolLM-135M transformer.
// Imported by all other transformer modules.

// ============================================================================
// SYSTEM STATE
// ============================================================================

FixedPool.SystemState {
    "initialized": Initialize=0, CanChange=True
}

// ============================================================================
// CONSOLE
// ============================================================================

FixedPool.ConsoleState {
    "running": Initialize=1, CanChange=True
    "generation_length": Initialize=5, CanChange=True
    "user_input_ptr": Initialize=0, CanChange=True
    "prompt_token": Initialize=0, CanChange=True
}

// ============================================================================
// COMMAND CONSTANTS
// ============================================================================

FixedPool.Commands {
    "CMD_NONE": Initialize=0
    "CMD_RMS_NORM_PRE": Initialize=1
    "CMD_PROJECT_Q": Initialize=2
    "CMD_PROJECT_K": Initialize=3
    "CMD_PROJECT_V": Initialize=4
    "CMD_APPLY_ROPE": Initialize=5
    "CMD_CACHE_KV": Initialize=6
    "CMD_COMPUTE_ATTENTION": Initialize=7
    "CMD_APPLY_SOFTMAX": Initialize=8
    "CMD_ATTEND_TO_VALUES": Initialize=9
    "CMD_RESIDUAL_1": Initialize=10
    "CMD_STASH_PRE_FFN": Initialize=11
    "CMD_RMS_NORM_FFN": Initialize=12
    "CMD_FFN": Initialize=13
    "CMD_RESIDUAL_2": Initialize=14
    "CMD_DONE": Initialize=99
}

// ============================================================================
// CONTROL MAILBOX
// ============================================================================

FixedPool.ControlMailbox {
    "slot0": Initialize=0, CanChange=True
}

// ============================================================================
// LAYER I/O
// ============================================================================

FixedPool.LayerInput {
    "x_ptr": Initialize=0, CanChange=True
}

FixedPool.LayerOutput {
    "x_ptr": Initialize=0, CanChange=True
}

// ============================================================================
// MODEL HYPERPARAMETERS
// These match SmolLM-135M architecture.
// vocab_size and num_layers may differ from model.bin at runtime — Model_Load
// overrides them from the file header after loading.
// ============================================================================

FixedPool.Config {
    "vocab_size": Initialize=49152, CanChange=True
    "hidden_dim": Initialize=576, CanChange=True
    "num_heads": Initialize=9, CanChange=True
    "head_dim": Initialize=64, CanChange=True
    "intermediate_size": Initialize=1536, CanChange=True
    "num_layers": Initialize=30, CanChange=True
    "cache_slots": Initialize=4, CanChange=True
    "rope_base": Initialize=10000, CanChange=True
    "kv_heads": Initialize=3, CanChange=True
    "group_size": Initialize=3, CanChange=True
}

// ============================================================================
// ATTENTION STATE
// ============================================================================

FixedPool.AttentionState {
    "num_cached": Initialize=0, CanChange=True
    "head": Initialize=0, CanChange=True
    "kv_head": Initialize=0, CanChange=True
    "cache_idx": Initialize=0, CanChange=True
    "score": Initialize=0, CanChange=True
    "dim": Initialize=0, CanChange=True
    "global_dim": Initialize=0, CanChange=True
    "offset": Initialize=0, CanChange=True
    "q_ptr": Initialize=0, CanChange=True
    "q_val": Initialize=0, CanChange=True
    "kv_dim": Initialize=0, CanChange=True
    "kv_offset": Initialize=0, CanChange=True
    "cache_slot_offset": Initialize=0, CanChange=True
    "k_ptr": Initialize=0, CanChange=True
    "k_val": Initialize=0, CanChange=True
    "score_idx": Initialize=0, CanChange=True
    "score_ptr": Initialize=0, CanChange=True
}

FixedPool.CacheKVState {
    "cache_slot": Initialize=0, CanChange=True
    "cache_offset": Initialize=0, CanChange=True
    "key_dest": Initialize=0, CanChange=True
    "value_dest": Initialize=0, CanChange=True
    "dim": Initialize=0, CanChange=True
    "element_offset": Initialize=0, CanChange=True
    "src_ptr": Initialize=0, CanChange=True
    "value": Initialize=0, CanChange=True
    "dest_ptr": Initialize=0, CanChange=True
}

// ============================================================================
// RUNTIME STATE
// ============================================================================

FixedPool.State {
    "tokens_processed": Initialize=0, CanChange=True
    "current_layer": Initialize=0, CanChange=True
    "seq_pos": Initialize=0, CanChange=True
    "attention_score": Initialize=0, CanChange=True
    "max_score": Initialize=0, CanChange=True
    "token_id": Initialize=0, CanChange=True
    "counter": Initialize=0, CanChange=True
    "current_head": Initialize=0, CanChange=True
    "gen_count": Initialize=0, CanChange=True
    "current_command": Initialize=0, CanChange=True
}

// ============================================================================
// POINTERS — workspace and cache only
// Weight pointers live in Model pool (see ModelLoader.ailang)
// ============================================================================

FixedPool.Pointers {
    "KeyCache": Initialize=0, CanChange=True
    "ValueCache": Initialize=0, CanChange=True
    "AttentionScores": Initialize=0, CanChange=True
    "TempBuffer": Initialize=0, CanChange=True
}

// ============================================================================
// WORKSPACE BUFFERS
// ============================================================================

FixedPool.Workspace {
    "x_buf_A": Initialize=0, CanChange=True
    "x_buf_B": Initialize=0, CanChange=True
}

// ============================================================================
// OUTPUT BUFFERS
// ============================================================================

FixedPool.FinalLogits {
    "ptr": Initialize=0, CanChange=True
}

// ============================================================================
// RMSNORM WEIGHT PASSTHROUGH
// Set by Layer.ailang before RunTask(RMSNorm) so RMSNorm knows which learned
// weight vector to apply. Also set by Generate.ailang for the final norm.
// ============================================================================

FixedPool.RMSNormState {
    "weight_ptr": Initialize=0, CanChange=True
}