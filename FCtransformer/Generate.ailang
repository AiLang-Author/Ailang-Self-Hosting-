// Generate.ailang
// Token processing pipeline: embedding -> layers -> logits -> next token.
// User input, generation loop.

Import.Config
Import.ModelLoader
Import.Layer
Import.Output

// ============================================================================
// PROCESS TOKEN
// Full forward pass for one token.
// ============================================================================

SubRoutine.ProcessToken {
    // Load embedding into buf_A
    LayerInput.x_ptr = Workspace.x_buf_A
    RunTask(Model_GetEmbedding)

    // Run all layers
    State.current_layer = 0
    WhileLoop LessThan(State.current_layer, Config.num_layers) {
        // Even layers: A -> B,  Odd layers: B -> A
        IfCondition EqualTo(Modulo(State.current_layer, 2), 0) ThenBlock: {
            LayerInput.x_ptr  = Workspace.x_buf_A
            LayerOutput.x_ptr = Workspace.x_buf_B
        } ElseBlock: {
            LayerInput.x_ptr  = Workspace.x_buf_B
            LayerOutput.x_ptr = Workspace.x_buf_A
        }

        RunTask(TransformerLayer)
        State.current_layer = Add(State.current_layer, 1)
    }

    // Final RMSNorm before output projection
    // Norm weight is the global final_norm vector from the model
    RMSNormState.weight_ptr = Model.final_norm
    LayerInput.x_ptr = LayerOutput.x_ptr

    // Reuse the other buffer for the normed result
    IfCondition EqualTo(LayerOutput.x_ptr, Workspace.x_buf_B) ThenBlock: {
        LayerOutput.x_ptr = Workspace.x_buf_A
    } ElseBlock: {
        LayerOutput.x_ptr = Workspace.x_buf_B
    }

    RunTask(RMSNorm)

    // Logit projection reads from the normed buffer
    LayerInput.x_ptr = LayerOutput.x_ptr
    RunTask(ProjectToLogits)

    State.tokens_processed = Add(State.tokens_processed, 1)
    State.seq_pos          = Add(State.seq_pos, 1)
}

// ============================================================================
// GENERATE SEQUENCE
// Runs ProcessToken -> ProjectToLogits -> SelectNextToken in a loop.
// Prints each generated token word via GetWordFromID (from vocabulary library).
// ============================================================================

SubRoutine.GenerateSequence {
    State.token_id  = ConsoleState.prompt_token
    State.gen_count = 0

    WhileLoop LessThan(State.gen_count, ConsoleState.generation_length) {
        RunTask(ProcessToken)
        RunTask(SelectNextToken)

        // Vocabulary lookup — GetWordFromID sets generated_word_ptr
        RunTask(GetWordFromID)
        PrintString(generated_word_ptr)
        PrintMessage(" ")

        State.gen_count = Add(State.gen_count, 1)
    }

    PrintMessage("\n")
}

// ============================================================================
// GET USER INPUT
// ============================================================================

SubRoutine.GetUserInput {
    PrintMessage("\n> ")
    temp_input = ReadInput()
    ConsoleState.user_input_ptr = temp_input
}

// ============================================================================
// PARSE USER INPUT
// Extracts prompt token (first character's ASCII value) from the input string.
// A real tokeniser would replace this.
// ============================================================================

SubRoutine.ParseUserInput {
    input_ptr = ConsoleState.user_input_ptr

    IfCondition EqualTo(input_ptr, 0) ThenBlock: {
        ConsoleState.prompt_token = 0
        ReturnValue(0)
    }

    input_len = StringLength(input_ptr)
    IfCondition EqualTo(input_len, 0) ThenBlock: {
        ConsoleState.prompt_token = 0
        ReturnValue(0)
    }

    ConsoleState.prompt_token = StringCharAt(input_ptr, 0)
}