// Layer.ailang
// Single transformer layer: command dispatch loop.
// Owns buffer routing and residual connections.
// Case values are integer literals matching Commands pool (Branch only accepts literals).
//   1=CMD_RMS_NORM_PRE  2=CMD_PROJECT_Q    3=CMD_PROJECT_K   4=CMD_PROJECT_V
//   5=CMD_APPLY_ROPE    6=CMD_CACHE_KV     7=CMD_COMPUTE_ATTENTION
//   8=CMD_APPLY_SOFTMAX 9=CMD_ATTEND_TO_VALUES 10=CMD_RESIDUAL_1
//  11=CMD_STASH_PRE_FFN 12=CMD_RMS_NORM_FFN  13=CMD_FFN  14=CMD_RESIDUAL_2

Import.Config
Import.Attention
Import.Softmax
Import.FFN
Import.ModelLoader

// RMSNormState is declared in Config.ailang — set weight_ptr before each RMSNorm call.

// ============================================================================
// TRANSFORMER LAYER
// ============================================================================

SubRoutine.TransformerLayer {
    ControlMailbox.slot0  = 1   // CMD_RMS_NORM_PRE
    State.current_command = 0

    WhileLoop GreaterThan(99, State.current_command) {   // 99 = CMD_DONE

        // Wait for a command
        WhileLoop EqualTo(ControlMailbox.slot0, 0) {}

        State.current_command = ControlMailbox.slot0
        ControlMailbox.slot0  = 0

        Branch State.current_command {

            Case 1: {  // CMD_RMS_NORM_PRE
                // Stash x before attention (for residual 1)
                i = 0
                WhileLoop LessThan(i, Config.hidden_dim) {
                    off = Multiply(i, 8)
                    val = Dereference(Add(LayerInput.x_ptr, off))
                    StoreValue(Add(Pointers.TempBuffer, off), val)
                    i = Add(i, 1)
                }
                RMSNormState.weight_ptr = Model_GetInputNorm(State.current_layer)
                LayerOutput.x_ptr = Workspace.x_buf_B
                RunTask(RMSNorm)
            }

            Case 2: {  // CMD_PROJECT_Q
                LayerInput.x_ptr  = Workspace.x_buf_B
                LayerOutput.x_ptr = Workspace.x_buf_A
                RunTask(ProjectToQuery)
            }

            Case 3: {  // CMD_PROJECT_K
                LayerInput.x_ptr  = Workspace.x_buf_A
                LayerOutput.x_ptr = Workspace.x_buf_B
                RunTask(ProjectToKey)
            }

            Case 4: {  // CMD_PROJECT_V
                LayerInput.x_ptr  = Workspace.x_buf_B
                LayerOutput.x_ptr = Workspace.x_buf_A
                RunTask(ProjectToValue)
            }

            Case 5: {  // CMD_APPLY_ROPE
                LayerInput.x_ptr = Workspace.x_buf_A
                RunTask(ApplyRoPE)
            }

            Case 6: {  // CMD_CACHE_KV
                LayerInput.x_ptr = Workspace.x_buf_A
                RunTask(CacheKV)
            }

            Case 7: {  // CMD_COMPUTE_ATTENTION
                LayerInput.x_ptr = Workspace.x_buf_A
                RunTask(ComputeSingleHeadAttention)

                IfCondition LessThan(State.current_head, Config.num_heads) ThenBlock: {
                    ControlMailbox.slot0 = 7   // CMD_COMPUTE_ATTENTION
                } ElseBlock: {
                    State.current_head   = 0
                    ControlMailbox.slot0 = 8   // CMD_APPLY_SOFTMAX
                }
            }

            Case 8: {  // CMD_APPLY_SOFTMAX
                RunTask(ApplySingleHeadSoftmax)
            }

            Case 9: {  // CMD_ATTEND_TO_VALUES
                LayerOutput.x_ptr = Workspace.x_buf_B

                IfCondition EqualTo(State.current_head, 0) ThenBlock: {
                    dim = 0
                    WhileLoop LessThan(dim, Config.hidden_dim) {
                        StoreValue(Add(LayerOutput.x_ptr, Multiply(dim, 8)), 0.0)
                        dim = Add(dim, 1)
                    }
                }

                RunTask(AttendSingleHeadValues)
            }

            Case 10: {  // CMD_RESIDUAL_1
                dim = 0
                WhileLoop LessThan(dim, Config.hidden_dim) {
                    off       = Multiply(dim, 8)
                    stash_val = Dereference(Add(Pointers.TempBuffer, off))
                    attn_ptr  = Add(Workspace.x_buf_B, off)
                    attn_val  = Dereference(attn_ptr)
                    StoreValue(attn_ptr, Add(stash_val, attn_val))
                    dim = Add(dim, 1)
                }
                State.current_head   = 0
                ControlMailbox.slot0 = 11  // CMD_STASH_PRE_FFN
            }

            Case 11: {  // CMD_STASH_PRE_FFN
                i = 0
                WhileLoop LessThan(i, Config.hidden_dim) {
                    off = Multiply(i, 8)
                    val = Dereference(Add(Workspace.x_buf_B, off))
                    StoreValue(Add(Pointers.TempBuffer, off), val)
                    i = Add(i, 1)
                }
                ControlMailbox.slot0 = 12  // CMD_RMS_NORM_FFN
            }

            Case 12: {  // CMD_RMS_NORM_FFN
                RMSNormState.weight_ptr = Model_GetPostAttnNorm(State.current_layer)
                LayerInput.x_ptr  = Workspace.x_buf_B
                LayerOutput.x_ptr = Workspace.x_buf_A
                RunTask(RMSNorm)
            }

            Case 13: {  // CMD_FFN
                LayerInput.x_ptr  = Workspace.x_buf_A
                LayerOutput.x_ptr = Workspace.x_buf_B
                RunTask(FFN)
            }

            Case 14: {  // CMD_RESIDUAL_2
                dim = 0
                WhileLoop LessThan(dim, Config.hidden_dim) {
                    off       = Multiply(dim, 8)
                    stash_val = Dereference(Add(Pointers.TempBuffer, off))
                    ffn_ptr   = Add(Workspace.x_buf_B, off)
                    ffn_val   = Dereference(ffn_ptr)
                    StoreValue(ffn_ptr, Add(stash_val, ffn_val))
                    dim = Add(dim, 1)
                }
                ControlMailbox.slot0 = 99  // CMD_DONE
            }
        }
    }

    // Live hidden state is in buf_B after the layer completes.
    LayerOutput.x_ptr = Workspace.x_buf_B
}