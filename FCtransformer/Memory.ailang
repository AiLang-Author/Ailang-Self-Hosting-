// Memory.ailang
// Workspace and cache allocation / cleanup.
// Does NOT allocate weight matrices — those live in the Model arena (ModelLoader.ailang).

Import.Config

// ============================================================================
// INITIALIZE MEMORY
// Allocates workspace ping-pong buffers, KV cache, attention scores, temp buffer,
// and the final logits buffer. Sizes derived from Config at runtime so they
// automatically match whatever model.bin reported.
// ============================================================================

SubRoutine.InitializeMemory {
    PrintMessage("[Init] Allocating workspace...\n")

    hidden_bytes = Multiply(Config.hidden_dim, 8)

    // Ping-pong workspace buffers (one hidden vector each)
    Workspace.x_buf_A = Allocate(hidden_bytes)
    Workspace.x_buf_B = Allocate(hidden_bytes)
    PrintMessage("  Workspace A/B: ")
    PrintNumber(Multiply(hidden_bytes, 2))
    PrintMessage(" bytes\n")

    // KV cache: cache_slots x hidden_dim x 8
    kv_slot_bytes = hidden_bytes
    kv_cache_bytes = Multiply(Config.cache_slots, kv_slot_bytes)
    Pointers.KeyCache   = Allocate(kv_cache_bytes)
    Pointers.ValueCache = Allocate(kv_cache_bytes)
    PrintMessage("  KV cache: ")
    PrintNumber(Multiply(kv_cache_bytes, 2))
    PrintMessage(" bytes\n")

    // Attention scores: cache_slots x num_heads x 8
    scores_bytes = Multiply(Multiply(Config.cache_slots, Config.num_heads), 8)
    Pointers.AttentionScores = Allocate(scores_bytes)
    PrintMessage("  Attention scores: ")
    PrintNumber(scores_bytes)
    PrintMessage(" bytes\n")

    // Temp stash buffer (one hidden vector)
    Pointers.TempBuffer = Allocate(hidden_bytes)

    // Logits buffer (one float64 per vocab token)
    logits_bytes = Multiply(Config.vocab_size, 8)
    FinalLogits.ptr = Allocate(logits_bytes)
    PrintMessage("  Logits: ")
    PrintNumber(logits_bytes)
    PrintMessage(" bytes\n")

    PrintMessage("[Init] Done.\n")
}

// ============================================================================
// CLEANUP MEMORY
// Mirrors InitializeMemory exactly so sizes match on free.
// Model arena is freed separately by Model_Unload.
// ============================================================================

SubRoutine.CleanupMemory {
    hidden_bytes = Multiply(Config.hidden_dim, 8)
    kv_cache_bytes = Multiply(Config.cache_slots, hidden_bytes)
    scores_bytes = Multiply(Multiply(Config.cache_slots, Config.num_heads), 8)
    logits_bytes = Multiply(Config.vocab_size, 8)

    Deallocate(Workspace.x_buf_A, hidden_bytes)
    Deallocate(Workspace.x_buf_B, hidden_bytes)
    Deallocate(Pointers.KeyCache, kv_cache_bytes)
    Deallocate(Pointers.ValueCache, kv_cache_bytes)
    Deallocate(Pointers.AttentionScores, scores_bytes)
    Deallocate(Pointers.TempBuffer, hidden_bytes)
    Deallocate(FinalLogits.ptr, logits_bytes)

    PrintMessage("[Cleanup] Workspace freed.\n")
}