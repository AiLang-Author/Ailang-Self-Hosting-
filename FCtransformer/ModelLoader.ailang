// ModelLoader.ailang
// Arena-based model loader for SmolLM-135M.
// Reads model.bin into a single allocation and sets pointers into it.
// Replaces all PostgreSQL weight loading.

Import.Config
LibraryImport.XArrays

// ============================================================================
// MODEL ARENA STATE
// All weight pointers are offsets into a single arena allocation.
// ============================================================================

FixedPool.Model {
    "arena_ptr": Initialize=0, CanChange=True
    "arena_size": Initialize=0, CanChange=True
    "embeddings": Initialize=0, CanChange=True
    "output_weights": Initialize=0, CanChange=True
    "final_norm": Initialize=0, CanChange=True
    "layer_wq": Initialize=0, CanChange=True
    "layer_wk": Initialize=0, CanChange=True
    "layer_wv": Initialize=0, CanChange=True
    "layer_wo": Initialize=0, CanChange=True
    "layer_w_gate": Initialize=0, CanChange=True
    "layer_w_up": Initialize=0, CanChange=True
    "layer_w_down": Initialize=0, CanChange=True
    "layer_input_norm": Initialize=0, CanChange=True
    "layer_post_attn_norm": Initialize=0, CanChange=True
    "embedding_stride": Initialize=0, CanChange=True
    "loaded": Initialize=0, CanChange=True
}

// ============================================================================
// MODEL_LOAD
// Reads model.bin, allocates one arena block, parses header, sets pointers.
// Updates Config.vocab_size / num_layers / hidden_dim from the header.
// Returns 1 on success, 0 on failure.
// ============================================================================

Function.Model_Load {
    Input: filepath: Address
    Output: Integer
    Body: {
        PrintMessage("[Model] Loading ")
        PrintString(filepath)
        PrintMessage("\n")

        file_size = GetFileSize(filepath)
        IfCondition LessEqual(file_size, 64) ThenBlock: {
            PrintMessage("[Model] ERROR: file too small or not found\n")
            ReturnValue(0)
        }

        // Single arena allocation
        arena = Allocate(file_size)
        IfCondition EqualTo(arena, 0) ThenBlock: {
            PrintMessage("[Model] ERROR: allocation failed\n")
            ReturnValue(0)
        }

        bytes_read = ReadBinaryFile(filepath, arena, file_size)
        IfCondition NotEqual(bytes_read, file_size) ThenBlock: {
            PrintMessage("[Model] ERROR: read incomplete\n")
            Deallocate(arena, file_size)
            ReturnValue(0)
        }

        Model.arena_ptr = arena
        Model.arena_size = file_size

        // --- Parse header (8 fields x 8 bytes = 64 bytes) ---
        // [0]  magic
        // [8]  version
        // [16] vocab_size
        // [24] hidden_dim
        // [32] num_heads
        // [40] num_layers
        // [48] intermediate_size
        // [56] reserved

        magic = Dereference(arena)
        IfCondition NotEqual(magic, 0x414D4C53) ThenBlock: {
            PrintMessage("[Model] ERROR: bad magic\n")
            Deallocate(arena, file_size)
            ReturnValue(0)
        }

        Config.vocab_size      = Dereference(Add(arena, 16))
        Config.hidden_dim      = Dereference(Add(arena, 24))
        Config.num_heads       = Dereference(Add(arena, 32))
        Config.num_layers      = Dereference(Add(arena, 40))
        Config.intermediate_size = Dereference(Add(arena, 48))

        PrintMessage("[Model] vocab=")
        PrintNumber(Config.vocab_size)
        PrintMessage(" hidden=")
        PrintNumber(Config.hidden_dim)
        PrintMessage(" heads=")
        PrintNumber(Config.num_heads)
        PrintMessage(" layers=")
        PrintNumber(Config.num_layers)
        PrintMessage("\n")

        // Precompute stride (bytes per embedding row)
        Model.embedding_stride = Multiply(Config.hidden_dim, 8)

        // --- Set section pointers into the arena ---
        // Layout (v2, float64):
        //   embeddings:      vocab_size x hidden_dim x 8
        //   output_weights:  vocab_size x hidden_dim x 8
        //   final_norm:      hidden_dim x 8
        //   per layer:       wq, wk, wv, wo, w_gate, w_up, w_down, input_norm, post_attn_norm

        data_base = Add(arena, 64)

        embed_size  = Multiply(Config.vocab_size, Model.embedding_stride)
        output_size = embed_size
        norm_size   = Multiply(Config.hidden_dim, 8)

        Model.embeddings     = data_base
        Model.output_weights = Add(Model.embeddings, embed_size)
        Model.final_norm     = Add(Model.output_weights, output_size)

        // Per-layer sizes (all float64)
        wq_size   = Multiply(Multiply(Config.hidden_dim, Config.hidden_dim), 8)
        wk_size   = Multiply(Multiply(Config.kv_heads, Multiply(Config.head_dim, Config.hidden_dim)), 8)
        wv_size   = wk_size
        wo_size   = wq_size
        wgate_size = Multiply(Multiply(Config.intermediate_size, Config.hidden_dim), 8)
        wup_size   = wgate_size
        wdown_size = Multiply(Multiply(Config.hidden_dim, Config.intermediate_size), 8)
        inorm_size = norm_size
        panorm_size = norm_size

        layer_block = Add(Add(Add(Add(Add(Add(Add(Add(
            wq_size, wk_size), wv_size), wo_size),
            wgate_size), wup_size), wdown_size),
            inorm_size), panorm_size)

        // Build per-layer pointer XArrays
        Model.layer_wq        = XArray.XCreate(Config.num_layers)
        Model.layer_wk        = XArray.XCreate(Config.num_layers)
        Model.layer_wv        = XArray.XCreate(Config.num_layers)
        Model.layer_wo        = XArray.XCreate(Config.num_layers)
        Model.layer_w_gate    = XArray.XCreate(Config.num_layers)
        Model.layer_w_up      = XArray.XCreate(Config.num_layers)
        Model.layer_w_down    = XArray.XCreate(Config.num_layers)
        Model.layer_input_norm    = XArray.XCreate(Config.num_layers)
        Model.layer_post_attn_norm = XArray.XCreate(Config.num_layers)

        layer_base = Add(Model.final_norm, norm_size)

        i = 0
        WhileLoop LessThan(i, Config.num_layers) {
            ls = Add(layer_base, Multiply(i, layer_block))

            off_wq    = ls
            off_wk    = Add(off_wq, wq_size)
            off_wv    = Add(off_wk, wk_size)
            off_wo    = Add(off_wv, wv_size)
            off_wgate = Add(off_wo, wo_size)
            off_wup   = Add(off_wgate, wgate_size)
            off_wdown = Add(off_wup, wup_size)
            off_inorm = Add(off_wdown, wdown_size)
            off_panorm = Add(off_inorm, inorm_size)

            XArray.XPush(Model.layer_wq, off_wq)
            XArray.XPush(Model.layer_wk, off_wk)
            XArray.XPush(Model.layer_wv, off_wv)
            XArray.XPush(Model.layer_wo, off_wo)
            XArray.XPush(Model.layer_w_gate, off_wgate)
            XArray.XPush(Model.layer_w_up, off_wup)
            XArray.XPush(Model.layer_w_down, off_wdown)
            XArray.XPush(Model.layer_input_norm, off_inorm)
            XArray.XPush(Model.layer_post_attn_norm, off_panorm)

            i = Add(i, 1)
        }

        Model.loaded = 1
        PrintMessage("[Model] Loaded OK\n")
        ReturnValue(1)
    }
}

// ============================================================================
// MODEL_UNLOAD
// Frees the arena. Called at shutdown.
// ============================================================================

SubRoutine.Model_Unload {
    IfCondition NotEqual(Model.arena_ptr, 0) ThenBlock: {
        Deallocate(Model.arena_ptr, Model.arena_size)
        Model.arena_ptr = 0
        Model.loaded = 0
    }
}

// ============================================================================
// EMBEDDING LOOKUP
// Copies one embedding row into dest_ptr.
// Replaces LoadEmbeddingFromDB.
// ============================================================================

SubRoutine.Model_GetEmbedding {
    // Caller sets State.token_id and LayerInput.x_ptr before calling.
    src = Add(Model.embeddings, Multiply(State.token_id, Model.embedding_stride))
    MemoryCopy(LayerInput.x_ptr, src, Model.embedding_stride)
}

// ============================================================================
// WEIGHT ACCESSORS — return pointer into the arena for a given layer
// ============================================================================

Function.Model_GetWq {
    Input: layer: Integer
    Output: Address
    Body: {
        ReturnValue(XArray.XGet(Model.layer_wq, layer))
    }
}

Function.Model_GetWk {
    Input: layer: Integer
    Output: Address
    Body: {
        ReturnValue(XArray.XGet(Model.layer_wk, layer))
    }
}

Function.Model_GetWv {
    Input: layer: Integer
    Output: Address
    Body: {
        ReturnValue(XArray.XGet(Model.layer_wv, layer))
    }
}

Function.Model_GetWo {
    Input: layer: Integer
    Output: Address
    Body: {
        ReturnValue(XArray.XGet(Model.layer_wo, layer))
    }
}

Function.Model_GetWGate {
    Input: layer: Integer
    Output: Address
    Body: {
        ReturnValue(XArray.XGet(Model.layer_w_gate, layer))
    }
}

Function.Model_GetWUp {
    Input: layer: Integer
    Output: Address
    Body: {
        ReturnValue(XArray.XGet(Model.layer_w_up, layer))
    }
}

Function.Model_GetWDown {
    Input: layer: Integer
    Output: Address
    Body: {
        ReturnValue(XArray.XGet(Model.layer_w_down, layer))
    }
}

Function.Model_GetInputNorm {
    Input: layer: Integer
    Output: Address
    Body: {
        ReturnValue(XArray.XGet(Model.layer_input_norm, layer))
    }
}

Function.Model_GetPostAttnNorm {
    Input: layer: Integer
    Output: Address
    Body: {
        ReturnValue(XArray.XGet(Model.layer_post_attn_norm, layer))
    }
}