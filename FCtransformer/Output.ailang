// Output.ailang
// Final layer-norm, output projection (logits), and argmax token selection.
// Reads from Model.output_weights — no OutputMatrix pool needed.

Import.Config
Import.ModelLoader

// ============================================================================
// PROJECT TO LOGITS
// logits[v] = dot(hidden_state, output_weights[v])
// Reads LayerInput.x_ptr (the post-norm hidden state).
// Writes float64 logit per vocab token into FinalLogits.ptr.
// ============================================================================

SubRoutine.ProjectToLogits {
    hidden = Config.hidden_dim
    vocab  = Config.vocab_size

    vocab_idx = 0
    WhileLoop LessThan(vocab_idx, vocab) {
        dot = 0.0
        dim = 0
        WhileLoop LessThan(dim, hidden) {
            byte_off = Multiply(dim, 8)
            x_val    = Dereference(Add(LayerInput.x_ptr, byte_off))
            // output_weights row-major: row = vocab_idx, col = dim
            w_off    = Multiply(Add(Multiply(vocab_idx, hidden), dim), 8)
            w_val    = Dereference(Add(Model.output_weights, w_off))
            dot      = Add(dot, Multiply(x_val, w_val))
            dim      = Add(dim, 1)
        }
        StoreValue(Add(FinalLogits.ptr, Multiply(vocab_idx, 8)), dot)
        vocab_idx = Add(vocab_idx, 1)
    }
}

// ============================================================================
// SELECT NEXT TOKEN (argmax)
// Scans FinalLogits.ptr and sets State.token_id to the highest-scoring index.
// ============================================================================

SubRoutine.SelectNextToken {
    max_logit    = -1e18
    best_token   = 0

    vocab_idx = 0
    WhileLoop LessThan(vocab_idx, Config.vocab_size) {
        logit_ptr = Add(FinalLogits.ptr, Multiply(vocab_idx, 8))
        logit     = Dereference(logit_ptr)
        IfCondition GreaterThan(logit, max_logit) ThenBlock: {
            max_logit  = logit
            best_token = vocab_idx
        }
        vocab_idx = Add(vocab_idx, 1)
    }

    State.token_id = best_token
}