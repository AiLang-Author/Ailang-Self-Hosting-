// Softmax.ailang
// Softmax over attention scores and weighted value accumulation.
// All arithmetic is native float64.

Import.Config

// ============================================================================
// APPLY SINGLE HEAD SOFTMAX
// Numerically stable softmax: subtract max before exp.
// Operates on AttentionScores for State.current_head.
// Advances current_head and signals next command.
// ============================================================================

SubRoutine.ApplySingleHeadSoftmax {
    head = State.current_head

    num_cached = State.seq_pos
    IfCondition GreaterThan(num_cached, Config.cache_slots) ThenBlock: {
        num_cached = Config.cache_slots
    }

    IfCondition GreaterThan(num_cached, 0) ThenBlock: {

        // --- find max for numerical stability ---
        max_score = -1e18
        cache_idx = 0
        WhileLoop LessThan(cache_idx, num_cached) {
            score_idx = Add(Multiply(head, Config.cache_slots), cache_idx)
            score_ptr = Add(Pointers.AttentionScores, Multiply(score_idx, 8))
            s = Dereference(score_ptr)
            IfCondition GreaterThan(s, max_score) ThenBlock: {
                max_score = s
            }
            cache_idx = Add(cache_idx, 1)
        }

        // --- exp(score - max) and accumulate sum ---
        exp_sum = 0.0
        cache_idx = 0
        WhileLoop LessThan(cache_idx, num_cached) {
            score_idx = Add(Multiply(head, Config.cache_slots), cache_idx)
            score_ptr = Add(Pointers.AttentionScores, Multiply(score_idx, 8))
            s         = Dereference(score_ptr)
            e         = Math.Exp(Subtract(s, max_score))
            StoreValue(score_ptr, e)
            exp_sum   = Add(exp_sum, e)
            cache_idx = Add(cache_idx, 1)
        }

        // --- normalise ---
        cache_idx = 0
        WhileLoop LessThan(cache_idx, num_cached) {
            score_idx = Add(Multiply(head, Config.cache_slots), cache_idx)
            score_ptr = Add(Pointers.AttentionScores, Multiply(score_idx, 8))
            e = Dereference(score_ptr)
            IfCondition GreaterThan(exp_sum, 0.0) ThenBlock: {
                StoreValue(score_ptr, Divide(e, exp_sum))
            } ElseBlock: {
                StoreValue(score_ptr, 0.0)
            }
            cache_idx = Add(cache_idx, 1)
        }
    }

    // --- advance head, signal next command ---
    State.current_head = Add(State.current_head, 1)

    IfCondition LessThan(State.current_head, Config.num_heads) ThenBlock: {
        ControlMailbox.slot0 = Commands.CMD_APPLY_SOFTMAX
    } ElseBlock: {
        State.current_head   = 0
        ControlMailbox.slot0 = Commands.CMD_ATTEND_TO_VALUES
    }

    ReturnValue(0)
}

// ============================================================================
// ATTEND SINGLE HEAD VALUES
// Weighted sum of cached V vectors using softmax probabilities.
// Accumulates into LayerOutput.x_ptr (zeroed by Layer before head 0).
// Uses GQA: maps Q head -> KV head via group_size.
// ============================================================================

SubRoutine.AttendSingleHeadValues {
    head     = State.current_head
    kv_head  = Divide(head, Config.group_size)
    head_dim = Config.head_dim
    kv_bytes = Multiply(Multiply(Config.kv_heads, head_dim), 8)

    num_cached = State.seq_pos
    IfCondition GreaterThan(num_cached, Config.cache_slots) ThenBlock: {
        num_cached = Config.cache_slots
    }

    IfCondition GreaterThan(num_cached, 0) ThenBlock: {
        d = 0
        WhileLoop LessThan(d, head_dim) {
            accum = 0.0

            cache_idx = 0
            WhileLoop LessThan(cache_idx, num_cached) {
                // attention weight
                score_idx  = Add(Multiply(head, Config.cache_slots), cache_idx)
                weight_ptr = Add(Pointers.AttentionScores, Multiply(score_idx, 8))
                weight     = Dereference(weight_ptr)

                // value dimension (GQA-aware)
                v_dim  = Add(Multiply(kv_head, head_dim), d)
                v_slot = Multiply(cache_idx, kv_bytes)
                v_ptr  = Add(Add(Pointers.ValueCache, v_slot), Multiply(v_dim, 8))
                v_val  = Dereference(v_ptr)

                accum     = Add(accum, Multiply(weight, v_val))
                cache_idx = Add(cache_idx, 1)
            }

            // Write into the correct slice of the output buffer
            global_dim = Add(Multiply(head, head_dim), d)
            out_ptr    = Add(LayerOutput.x_ptr, Multiply(global_dim, 8))
            cur        = Dereference(out_ptr)
            StoreValue(out_ptr, Add(cur, accum))

            d = Add(d, 1)
        }
    }

    // --- advance head, signal next command ---
    State.current_head = Add(State.current_head, 1)

    IfCondition LessThan(State.current_head, Config.num_heads) ThenBlock: {
        ControlMailbox.slot0 = Commands.CMD_ATTEND_TO_VALUES
    } ElseBlock: {
        State.current_head   = 0
        ControlMailbox.slot0 = Commands.CMD_RESIDUAL_1
    }

    ReturnValue(0)
}