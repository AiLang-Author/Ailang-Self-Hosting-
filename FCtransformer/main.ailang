// main.ailang
// SmolLM-135M transformer — entry point.
// Startup, console loop, shutdown.

Import.Config
Import.ModelLoader
Import.Memory
Import.Generate
LibraryImport.Arena
LibraryImport.XArrays
LibraryImport.smollm_vocabulary_static

PrintMessage("========================================\n")
PrintMessage("SMOLLM-135M TRANSFORMER\n")
PrintMessage("Arena loader, native float64\n")
PrintMessage("========================================\n\n")

// ============================================================================
// STARTUP — runs once
// ============================================================================

IfCondition EqualTo(SystemState.initialized, 0) ThenBlock: {
    // Load model weights into arena
    ok = Model_Load("model.bin")
    IfCondition EqualTo(ok, 0) ThenBlock: {
        PrintMessage("[FATAL] Could not load model.bin\n")
        SystemCall(60, 1, 0, 0)
    }

    // Allocate workspace (sizes come from Config, now set by Model_Load)
    RunTask(InitializeMemory)

    SystemState.initialized = 1
}

// ============================================================================
// CONSOLE LOOP
// ============================================================================

PrintMessage("SmolLM Interactive Console\n")
PrintMessage("Type text to generate, 'exit' to quit.\n")
PrintMessage("========================================\n")

WhileLoop EqualTo(ConsoleState.running, 1) {
    RunTask(GetUserInput)

    input_ptr = ConsoleState.user_input_ptr

    IfCondition EqualTo(StringCompare(input_ptr, "exit"), 0) ThenBlock: {
        ConsoleState.running = 0
        PrintMessage("\nGoodbye!\n")
    } ElseBlock: {
        IfCondition EqualTo(StringCompare(input_ptr, "quit"), 0) ThenBlock: {
            ConsoleState.running = 0
            PrintMessage("\nGoodbye!\n")
        } ElseBlock: {
            input_len = StringLength(input_ptr)
            IfCondition GreaterThan(input_len, 0) ThenBlock: {
                RunTask(ParseUserInput)
                DebugPerf.Start("inference")
                RunTask(GenerateSequence)
                DebugPerf.End("inference")
            } ElseBlock: {
                PrintMessage("Empty input — try again.\n")
            }
        }
    }
}

// ============================================================================
// SHUTDOWN
// ============================================================================

RunTask(CleanupMemory)
RunTask(Model_Unload)

PrintMessage("\n========================================\n")
PrintMessage("Session complete.\n")
PrintMessage("  Tokens processed: ")
PrintNumber(State.tokens_processed)
PrintMessage("\n  Final seq pos:    ")
PrintNumber(State.seq_pos)
PrintMessage("\n========================================\n\n")