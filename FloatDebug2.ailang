// FloatDebug2.ailang
// Test: same var reassignment vs different vars

LibraryImport.Arena

SubRoutine.Main {
    PrintMessage("Float Reassignment Debug\n\n")

    // Test A: Different vars (should work)
    PrintMessage("=== A: Different variables ===\n")
    inc = Float_Div(Float_FromInt(1), Float_FromInt(10))
    v0 = Float_FromInt(0)
    v1 = Float_Add(v0, inc)
    v2 = Float_Add(v1, inc)
    v3 = Float_Add(v2, inc)
    v4 = Float_Add(v3, inc)
    v5 = Float_Add(v4, inc)
    v6 = Float_Add(v5, inc)
    v7 = Float_Add(v6, inc)
    v8 = Float_Add(v7, inc)
    v9 = Float_Add(v8, inc)
    v10 = Float_Add(v9, inc)
    PrintMessage("Result with different vars: ")
    PrintNumber(Float_ToInt(v10))
    PrintMessage("  (should be 1)\n")

    // Test B: Same var reassignment (likely fails)
    PrintMessage("\n=== B: Same variable reassigned ===\n")
    inc2 = Float_Div(Float_FromInt(1), Float_FromInt(10))
    s = Float_FromInt(0)
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    PrintMessage("Result with same var: ")
    PrintNumber(Float_ToInt(s))
    PrintMessage("  (should be 1)\n")

    // Test C: Print intermediate values with same var
    PrintMessage("\n=== C: Same var with prints ===\n")
    inc3 = Float_Div(Float_FromInt(1), Float_FromInt(10))
    x = Float_FromInt(0)
    x = Float_Add(x, inc3)
    PrintMessage("After 1: ")
    PrintNumber(Float_ToInt(Float_Mul(x, Float_FromInt(1000))))
    x = Float_Add(x, inc3)
    PrintMessage(" After 2: ")
    PrintNumber(Float_ToInt(Float_Mul(x, Float_FromInt(1000))))
    x = Float_Add(x, inc3)
    PrintMessage(" After 3: ")
    PrintNumber(Float_ToInt(Float_Mul(x, Float_FromInt(1000))))
    PrintMessage("\n")

    PrintMessage("\nDone.\n")
}

RunTask(Main)
