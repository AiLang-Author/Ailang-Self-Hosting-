// FloatDebug3.ailang
// Check actual values with scaling

LibraryImport.Arena

SubRoutine.Main {
    PrintMessage("Float Value Debug\n\n")

    inc = Float_Div(Float_FromInt(1), Float_FromInt(10))

    // Check inc value
    PrintMessage("inc * 1000 = ")
    PrintNumber(Float_ToInt(Float_Mul(inc, Float_FromInt(1000))))
    PrintMessage("  (should be 100)\n")

    v0 = Float_FromInt(0)
    v1 = Float_Add(v0, inc)
    v2 = Float_Add(v1, inc)
    v3 = Float_Add(v2, inc)
    v4 = Float_Add(v3, inc)
    v5 = Float_Add(v4, inc)
    v6 = Float_Add(v5, inc)
    v7 = Float_Add(v6, inc)
    v8 = Float_Add(v7, inc)
    v9 = Float_Add(v8, inc)
    v10 = Float_Add(v9, inc)

    // Check each value scaled
    PrintMessage("\nScaled values (*1000):\n")
    PrintMessage("v1  = ")
    PrintNumber(Float_ToInt(Float_Mul(v1, Float_FromInt(1000))))
    PrintMessage("\n")
    PrintMessage("v5  = ")
    PrintNumber(Float_ToInt(Float_Mul(v5, Float_FromInt(1000))))
    PrintMessage("\n")
    PrintMessage("v10 = ")
    PrintNumber(Float_ToInt(Float_Mul(v10, Float_FromInt(1000))))
    PrintMessage("  (should be 1000)\n")

    // Direct conversion
    PrintMessage("\nDirect Float_ToInt:\n")
    PrintMessage("v10 direct = ")
    PrintNumber(Float_ToInt(v10))
    PrintMessage("  (should be 1)\n")

    // What about 1.0 directly?
    PrintMessage("\nFloat_FromInt(1) check:\n")
    one = Float_FromInt(1)
    PrintMessage("Float_ToInt(Float_FromInt(1)) = ")
    PrintNumber(Float_ToInt(one))
    PrintMessage("  (should be 1)\n")

    PrintMessage("\nDone.\n")
}

RunTask(Main)
