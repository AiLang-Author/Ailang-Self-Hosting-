// FloatDebug4.ailang
// Test with exact binary fractions (0.5, 0.25, 0.125)

LibraryImport.Arena

SubRoutine.Main {
    PrintMessage("Float Exact Binary Fractions Test\n\n")

    // 0.5 is exactly representable (1/2)
    PrintMessage("=== Using 0.5 (exact) ===\n")
    half = Float_Div(Float_FromInt(1), Float_FromInt(2))
    sum = Float_FromInt(0)
    sum = Float_Add(sum, half)
    sum = Float_Add(sum, half)  // 1.0
    PrintMessage("0.5 + 0.5 = ")
    PrintNumber(Float_ToInt(sum))
    PrintMessage("  (should be 1)\n")

    // 0.25 is exactly representable (1/4)
    PrintMessage("\n=== Using 0.25 (exact) ===\n")
    quarter = Float_Div(Float_FromInt(1), Float_FromInt(4))
    sum2 = Float_FromInt(0)
    sum2 = Float_Add(sum2, quarter)
    sum2 = Float_Add(sum2, quarter)
    sum2 = Float_Add(sum2, quarter)
    sum2 = Float_Add(sum2, quarter)  // 1.0
    PrintMessage("0.25 * 4 = ")
    PrintNumber(Float_ToInt(sum2))
    PrintMessage("  (should be 1)\n")

    // 0.125 is exactly representable (1/8)
    PrintMessage("\n=== Using 0.125 (exact) ===\n")
    eighth = Float_Div(Float_FromInt(1), Float_FromInt(8))
    sum3 = Float_FromInt(0)
    i = 0
    WhileLoop LessThan(i, 8) {
        sum3 = Float_Add(sum3, eighth)
        i = Add(i, 1)
    }
    PrintMessage("0.125 * 8 (loop) = ")
    PrintNumber(Float_ToInt(sum3))
    PrintMessage("  (should be 1)\n")

    // Verify scaled
    PrintMessage("\nVerify (scaled * 1000):\n")
    PrintMessage("sum3 * 1000 = ")
    PrintNumber(Float_ToInt(Float_Mul(sum3, Float_FromInt(1000))))
    PrintMessage("  (should be 1000)\n")

    PrintMessage("\nDone.\n")
}

RunTask(Main)
