// FloatTest.ailang
// Test floating point with proper conversions

LibraryImport.Arena

SubRoutine.Main {
    PrintMessage("AILang Float Precision Test\n\n")

    // Test 1: Raw float operations
    PrintMessage("=== Test 1: Direct Float ops ===\n")
    a = Float_FromInt(100)
    b = Float_FromInt(3)
    div_result = Float_Div(a, b)
    back_to_int = Float_ToInt(div_result)
    PrintMessage("Float_Div(100, 3) as int = ")
    PrintNumber(back_to_int)
    PrintMessage("  (should be 33)\n")

    // Test 2: Keep in float domain, multiply to check precision
    PrintMessage("\n=== Test 2: Float precision check ===\n")
    third = Float_Div(Float_FromInt(1), Float_FromInt(3))  // 0.333...
    times_three = Float_Mul(third, Float_FromInt(3))        // should be ~1.0
    result = Float_ToInt(times_three)
    PrintMessage("(1/3) * 3 = ")
    PrintNumber(result)
    PrintMessage("  (should be ~1)\n")

    // Test 3: Gradient-scale operations with float
    PrintMessage("\n=== Test 3: Gradient operations ===\n")
    grad = Float_FromInt(6)
    lr = Float_FromInt(2)
    scale = Float_FromInt(100)

    // (grad * lr) / scale = (6 * 2) / 100 = 0.12
    numerator = Float_Mul(grad, lr)
    update = Float_Div(numerator, scale)

    // Multiply by 1000 to see the precision
    scaled_up = Float_Mul(update, Float_FromInt(1000))
    as_int = Float_ToInt(scaled_up)
    PrintMessage("((6 * 2) / 100) * 1000 = ")
    PrintNumber(as_int)
    PrintMessage("  (should be 120)\n")

    // Test 4: Accumulate small updates
    PrintMessage("\n=== Test 4: Accumulating small updates ===\n")
    weight = Float_FromInt(0)
    small_update = Float_Div(Float_FromInt(1), Float_FromInt(100))  // 0.01

    i = 0
    WhileLoop LessThan(i, 100) {
        weight = Float_Add(weight, small_update)
        i = Add(i, 1)
    }
    final_weight = Float_ToInt(weight)
    PrintMessage("Accumulated 100 updates of 0.01 = ")
    PrintNumber(final_weight)
    PrintMessage("  (should be ~1)\n")

    // Test 5: Weight update simulation
    PrintMessage("\n=== Test 5: SGD-like update ===\n")
    w = Float_FromInt(5)       // weight = 5.0
    g = Float_FromInt(10)      // gradient = 10
    learning_rate = Float_Div(Float_FromInt(1), Float_FromInt(10))  // 0.1

    // w = w - lr * g = 5 - 0.1 * 10 = 5 - 1 = 4
    delta = Float_Mul(learning_rate, g)
    w = Float_Sub(w, delta)
    w_int = Float_ToInt(w)
    PrintMessage("5 - (0.1 * 10) = ")
    PrintNumber(w_int)
    PrintMessage("  (should be 4)\n")

    PrintMessage("\nDone.\n")
}

RunTask(Main)
