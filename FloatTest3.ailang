// FloatTest3.ailang
// Test theory: intermediate floats < 1.0 break, >= 1.0 work

LibraryImport.Arena

SubRoutine.Main {
    PrintMessage("Float Intermediate Value Tests\n\n")

    // Test A: Intermediate >= 1 (should work)
    PrintMessage("=== A: 100/10 * 3 (intermediate=10) ===\n")
    part = Float_Div(100, 10)  // 10.0
    result = Float_Mul(part, 3)  // 30.0
    PrintMessage("100/10 * 3 = ")
    PrintNumber(Float_ToInt(result))
    PrintMessage("  (should be 30)\n")

    // Test B: Intermediate < 1 (likely fails)
    PrintMessage("\n=== B: 1/3 * 3 (intermediate=0.33) ===\n")
    part2 = Float_Div(1, 3)  // 0.333...
    result2 = Float_Mul(part2, 3)  // should be ~1.0
    PrintMessage("1/3 * 3 = ")
    PrintNumber(Float_ToInt(result2))
    PrintMessage("  (should be ~1)\n")

    // Test C: Intermediate slightly > 1
    PrintMessage("\n=== C: 10/3 * 3 (intermediate=3.33) ===\n")
    part3 = Float_Div(10, 3)  // 3.333...
    result3 = Float_Mul(part3, 3)  // should be ~10.0
    PrintMessage("10/3 * 3 = ")
    PrintNumber(Float_ToInt(result3))
    PrintMessage("  (should be ~10)\n")

    // Test D: Try adding to bring above 1 before multiply
    PrintMessage("\n=== D: (1 + 1/3) * 3 ===\n")
    third = Float_Div(1, 3)  // 0.333
    one_third = Float_Add(1, third)  // 1.333
    result4 = Float_Mul(one_third, 3)  // should be ~4.0
    PrintMessage("(1 + 1/3) * 3 = ")
    PrintNumber(Float_ToInt(result4))
    PrintMessage("  (should be ~4)\n")

    // Test E: Scale up first, then scale down
    PrintMessage("\n=== E: (1*1000)/3/1000*3 (scaled) ===\n")
    scaled = Float_Div(Float_Mul(1, 1000), 3)  // 333.33...
    back = Float_Div(scaled, 1000)  // 0.333...
    result5 = Float_Mul(back, 3)  // should be ~1.0
    PrintMessage("(1000/3)/1000*3 = ")
    PrintNumber(Float_ToInt(result5))
    PrintMessage("  (should be ~1 but likely 0)\n")

    // Test F: Fully nested to avoid intermediate storage
    PrintMessage("\n=== F: Nested Float_Mul(Float_Div(10,3),3) ===\n")
    result6 = Float_Mul(Float_Div(10, 3), 3)
    PrintMessage("Nested 10/3*3 = ")
    PrintNumber(Float_ToInt(result6))
    PrintMessage("  (should be ~10)\n")

    // Test G: Different comparison - store vs nested
    PrintMessage("\n=== G: Compare store vs nested ===\n")
    // Stored version
    stored_half = Float_Div(7, 2)  // 3.5
    stored_result = Float_Mul(stored_half, 2)  // 7.0
    PrintMessage("Stored: (7/2)*2 = ")
    PrintNumber(Float_ToInt(stored_result))
    PrintMessage("\n")

    // Nested version
    nested_result = Float_Mul(Float_Div(7, 2), 2)
    PrintMessage("Nested: (7/2)*2 = ")
    PrintNumber(Float_ToInt(nested_result))
    PrintMessage("\n(both should be 7)\n")

    PrintMessage("\nDone.\n")
}

RunTask(Main)
