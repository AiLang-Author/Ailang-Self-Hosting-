// test262_harness_batch.ailang — Batch harness for tc39/test262 conformance tests
// Reads tests from stdin in a loop: [4-byte LE length][JS source bytes]
// Writes 1 byte result per test to stdout: '0' = pass, '1' = fail, '2' = error
// Terminates when stdin gives 0 bytes or length=0.
//
// Build: ./ailang.x TestCode/test262_harness_batch.ailang test262_harness_batch.x
// Run:   (called by tools/test262_runner.py in batch mode)
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Browser.HTMLTokenizer
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.JSLexer
LibraryImport.Browser.JSValidate
LibraryImport.Browser.JSParser
LibraryImport.Browser.JSCompiler
LibraryImport.Browser.JSRuntime
LibraryImport.Browser.JSVM
LibraryImport.Browser.JSBridge
LibraryImport.Browser.JSEngine

FixedPool.BatchSys {
    "SYS_READ":  Initialize=0
    "SYS_WRITE": Initialize=1
    "SYS_EXIT":  Initialize=60
}

FixedPool.BatchState {
    "src_buf":   Initialize=0
    "src_cap":   Initialize=0
    "len_buf":   Initialize=0
    "out_buf":   Initialize=0
}

FixedPool.BatchFD {
    "SYS_DUP2": Initialize=33
}

SubRoutine.Main {
    // Save original stdout to fd 4, then redirect stdout to stderr
    // so PrintMessage debug output goes to stderr.
    // Results are written to fd 4 (original stdout).
    SystemCall(BatchFD.SYS_DUP2, 1, 4, 0, 0, 0)
    SystemCall(BatchFD.SYS_DUP2, 2, 1, 0, 0, 0)

    Arena_Init()
    JSEngine_Init()
    JSVM_SetMaxSteps(9999999999)

    // Allocate source buffer (2 MB should cover any test)
    BatchState.src_cap = 2097152
    BatchState.src_buf = Allocate(BatchState.src_cap)
    // 4-byte length buffer
    BatchState.len_buf = Allocate(8)
    // 1-byte output buffer
    BatchState.out_buf = Allocate(4)

    IfCondition EqualTo(BatchState.src_buf, 0) ThenBlock: {
        SystemCall(BatchSys.SYS_EXIT, 99, 0, 0, 0, 0)
    }

    // Main loop: read [4-byte LE length][source]
    running = 1
    WhileLoop EqualTo(running, 1) {

        // Read 4-byte length prefix from stdin (fd=0)
        MemorySet(BatchState.len_buf, 0, 4)
        bytes_read = SystemCall(BatchSys.SYS_READ, 0, BatchState.len_buf, 4)

        // EOF or error — stop
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            running = 0
        }

        IfCondition EqualTo(running, 1) ThenBlock: {
            // Decode little-endian 32-bit length
            b0 = GetByte(BatchState.len_buf, 0)
            b1 = GetByte(BatchState.len_buf, 1)
            b2 = GetByte(BatchState.len_buf, 2)
            b3 = GetByte(BatchState.len_buf, 3)
            src_len = Add(b0, Add(Multiply(b1, 256), Add(Multiply(b2, 65536), Multiply(b3, 16777216))))

            // length=0 means "done"
            IfCondition EqualTo(src_len, 0) ThenBlock: {
                running = 0
            }
        }

        IfCondition EqualTo(running, 1) ThenBlock: {
            skipped = 0

            // Cap at buffer size
            IfCondition GreaterThan(src_len, BatchState.src_cap) ThenBlock: {
                // Source too large — write '2' (error) and drain
                SetByte(BatchState.out_buf, 0, 50)
                SystemCall(BatchSys.SYS_WRITE, 4, BatchState.out_buf, 1)

                // Drain the remaining bytes from stdin
                drain_left = src_len
                WhileLoop GreaterThan(drain_left, 0) {
                    drain_chunk = drain_left
                    IfCondition GreaterThan(drain_chunk, BatchState.src_cap) ThenBlock: {
                        drain_chunk = BatchState.src_cap
                    }
                    SystemCall(BatchSys.SYS_READ, 0, BatchState.src_buf, drain_chunk)
                    drain_left = Subtract(drain_left, drain_chunk)
                }
                skipped = 1
            }

            IfCondition EqualTo(skipped, 0) ThenBlock: {
                // Read source bytes from stdin
                total_read = 0
                WhileLoop LessThan(total_read, src_len) {
                    remaining = Subtract(src_len, total_read)
                    n = SystemCall(BatchSys.SYS_READ, 0, Add(BatchState.src_buf, total_read), remaining)
                    IfCondition LessEqual(n, 0) ThenBlock: {
                        running = 0
                        total_read = src_len
                    }
                    IfCondition GreaterThan(n, 0) ThenBlock: {
                        total_read = Add(total_read, n)
                    }
                }

                IfCondition EqualTo(running, 1) ThenBlock: {
                    // Null-terminate
                    SetByte(BatchState.src_buf, src_len, 0)

                    // Run the test
                    JSEngine_EvalString(BatchState.src_buf, src_len)
                    err = JSEngine_GetError()

                    // Write result: '0' (48) = pass, '1' (49) = fail
                    IfCondition EqualTo(err, 0) ThenBlock: {
                        SetByte(BatchState.out_buf, 0, 48)
                    } ElseBlock: {
                        SetByte(BatchState.out_buf, 0, 49)
                    }
                    // Write to fd 3 (result pipe) to avoid mixing with PrintMessage output
                    SystemCall(BatchSys.SYS_WRITE, 4, BatchState.out_buf, 1)

                    // Reset engine for next test
                    JSEngine_Reset()
                    JSVM_SetMaxSteps(9999999999)
                }
            }
        }
    }

    JSEngine_Shutdown()
    SystemCall(BatchSys.SYS_EXIT, 0, 0, 0, 0, 0)
}

RunTask(Main)
