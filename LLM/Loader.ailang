// LLM/Loader.ailang
// Orchestrates GGUF model loading: open file, parse header/metadata/tensors, print config.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

// Note: LLM.GGUF is imported by the entry point (LLM.ailang).
// Subfolder files don't need their own LibraryImport declarations.

// =============================================================================
// LLM_LoadModel — load a GGUF model file
// Returns 0 on success, negative on error.
// =============================================================================
Function.LLM_LoadModel {
    Input: path: Address
    Output: Integer
    Body: {
        // Open model file
        fd = SystemCall(LLMSys.SYS_OPEN, path, LLMSys.O_RDONLY, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[LLM] ERROR: cannot open model file (fd=")
            PrintNumber(fd)
            PrintMessage(")\n")
            ReturnValue(-1)
        }

        // Stash fd in GGUFParse so it survives deep call chains
        GGUFParse.fd = fd

        // Parse GGUF header (reads from GGUFParse.fd)
        rc = GGUF_ParseHeader()
        IfCondition LessThan(rc, 0) ThenBlock: {
            PrintMessage("[LLM] ERROR: header parse failed\n")
            SystemCall(LLMSys.SYS_CLOSE, GGUFParse.fd, 0, 0, 0, 0)
            ReturnValue(-2)
        }

        // Parse metadata KV pairs → populates LLMConfig
        rc = GGUF_ParseMetadata()
        IfCondition LessThan(rc, 0) ThenBlock: {
            PrintMessage("[LLM] ERROR: metadata parse failed\n")
            SystemCall(LLMSys.SYS_CLOSE, GGUFParse.fd, 0, 0, 0, 0)
            ReturnValue(-3)
        }

        // Parse tensor directory
        rc = GGUF_ParseTensors()
        IfCondition LessThan(rc, 0) ThenBlock: {
            PrintMessage("[LLM] ERROR: tensor directory parse failed\n")
            SystemCall(LLMSys.SYS_CLOSE, GGUFParse.fd, 0, 0, 0, 0)
            ReturnValue(-4)
        }

        // Close file (we'll mmap for tensor data later)
        SystemCall(LLMSys.SYS_CLOSE, GGUFParse.fd, 0, 0, 0, 0)

        PrintMessage("[LLM] Model loaded successfully.\n")
        ReturnValue(0)
    }
}

// =============================================================================
// LLM_PrintConfig — print model configuration
// =============================================================================
Function.LLM_PrintConfig {
    Body: {
        PrintMessage("[LLM] Model Configuration:\n")

        PrintMessage("[LLM]   Architecture: ")
        IfCondition NotEqual(LLMConfig.arch, 0) ThenBlock: {
            PrintString(LLMConfig.arch)
        }
        IfCondition EqualTo(LLMConfig.arch, 0) ThenBlock: {
            PrintMessage("(unknown)")
        }
        PrintMessage("\n")

        PrintMessage("[LLM]   Layers:       ")
        PrintNumber(LLMConfig.n_layers)
        PrintMessage("\n")

        PrintMessage("[LLM]   D_Model:      ")
        PrintNumber(LLMConfig.d_model)
        PrintMessage("\n")

        PrintMessage("[LLM]   D_FF:         ")
        PrintNumber(LLMConfig.d_ff)
        PrintMessage("\n")

        PrintMessage("[LLM]   Heads:        ")
        PrintNumber(LLMConfig.n_heads)
        PrintMessage("\n")

        PrintMessage("[LLM]   KV Heads:     ")
        PrintNumber(LLMConfig.n_kv_heads)
        PrintMessage("\n")

        PrintMessage("[LLM]   Head Dim:     ")
        PrintNumber(LLMConfig.head_dim)
        PrintMessage("\n")

        PrintMessage("[LLM]   Vocab:        ")
        PrintNumber(LLMConfig.vocab_size)
        PrintMessage("\n")

        PrintMessage("[LLM]   Context:      ")
        PrintNumber(LLMConfig.context_length)
        PrintMessage("\n")

        PrintMessage("[LLM]   RoPE Dim:     ")
        PrintNumber(LLMConfig.rope_dim)
        PrintMessage("\n")

        PrintMessage("[LLM]   Tensors:      ")
        PrintNumber(LLMConfig.n_tensors)
        PrintMessage("\n")
    }
}

// =============================================================================
// LLM_PrintTensors — print tensor directory summary
// =============================================================================
Function.LLM_PrintTensors {
    Body: {
        PrintMessage("[LLM] Tensor Directory (")
        PrintNumber(TensorDir.count)
        PrintMessage(" tensors):\n")

        i = 0
        WhileLoop LessThan(i, TensorDir.count) {
            entry = Add(TensorDir.entries, Multiply(i, TensorDir.ENTRY_SIZE))
            name_ptr = Dereference(Add(entry, TensorField.NAME_PTR))
            n_dims = Dereference(Add(entry, TensorField.N_DIMS))
            dim0 = Dereference(Add(entry, TensorField.DIM0))
            dim1 = Dereference(Add(entry, TensorField.DIM1))
            ttype = Dereference(Add(entry, TensorField.TYPE))
            data_size = Dereference(Add(entry, TensorField.DATA_SIZE))

            PrintMessage("  [")
            PrintNumber(i)
            PrintMessage("] ")
            PrintString(name_ptr)
            PrintMessage("  [")
            PrintNumber(dim0)
            IfCondition GreaterThan(n_dims, 1) ThenBlock: {
                PrintMessage(" x ")
                PrintNumber(dim1)
            }
            PrintMessage("]  type=")
            PrintNumber(ttype)
            PrintMessage("  size=")
            PrintNumber(Divide(data_size, 1024))
            PrintMessage("KB\n")

            i = Add(i, 1)
        }
    }
}

// =============================================================================
// GGUF_TypeName — return a human-readable type name string
// =============================================================================
Function.GGUF_TypeName {
    Input: qtype: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(qtype, GGMLType.F32)   ThenBlock: { ReturnValue("F32") }
        IfCondition EqualTo(qtype, GGMLType.F16)   ThenBlock: { ReturnValue("F16") }
        IfCondition EqualTo(qtype, GGMLType.Q4_0)  ThenBlock: { ReturnValue("Q4_0") }
        IfCondition EqualTo(qtype, GGMLType.Q4_1)  ThenBlock: { ReturnValue("Q4_1") }
        IfCondition EqualTo(qtype, GGMLType.Q5_0)  ThenBlock: { ReturnValue("Q5_0") }
        IfCondition EqualTo(qtype, GGMLType.Q5_1)  ThenBlock: { ReturnValue("Q5_1") }
        IfCondition EqualTo(qtype, GGMLType.Q8_0)  ThenBlock: { ReturnValue("Q8_0") }
        IfCondition EqualTo(qtype, GGMLType.Q8_1)  ThenBlock: { ReturnValue("Q8_1") }
        IfCondition EqualTo(qtype, GGMLType.Q2_K)  ThenBlock: { ReturnValue("Q2_K") }
        IfCondition EqualTo(qtype, GGMLType.Q3_K)  ThenBlock: { ReturnValue("Q3_K") }
        IfCondition EqualTo(qtype, GGMLType.Q4_K)  ThenBlock: { ReturnValue("Q4_K") }
        IfCondition EqualTo(qtype, GGMLType.Q5_K)  ThenBlock: { ReturnValue("Q5_K") }
        IfCondition EqualTo(qtype, GGMLType.Q6_K)  ThenBlock: { ReturnValue("Q6_K") }
        IfCondition EqualTo(qtype, GGMLType.Q8_K)  ThenBlock: { ReturnValue("Q8_K") }
        IfCondition EqualTo(qtype, GGMLType.BF16)  ThenBlock: { ReturnValue("BF16") }
        ReturnValue("???")
    }
}
