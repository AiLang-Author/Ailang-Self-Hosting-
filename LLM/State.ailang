// LLM/State.ailang
// Runtime-only FixedPool declarations for the LLM inference runtime.
// FixedPools shared with the GGUF library (LLMConfig, GGUFType, GGMLType,
// TensorDir, TensorField, LLMTokenizer, LLMSys, etc.) live in
// Librarys/LLM/Library.GGUF.ailang — the canonical owner.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

// =============================================================================
// RUNTIME MODE — int32 fast inference vs int64 Q20 precision
// =============================================================================
FixedPool.LLMMode {
    "precision":        Initialize=0, CanChange=True   // 0=int32 (fast), 1=int64 Q20 (tuning)
    "elem_size":        Initialize=4, CanChange=True   // 4 for int32, 8 for int64
    "use_gpu":          Initialize=0, CanChange=True   // 0=CPU, 1=GPU via HAL
    "max_seq":          Initialize=512, CanChange=True  // max generation length
    "temperature":      Initialize=100, CanChange=True  // T * 100 (100 = 1.0)
    "top_k":            Initialize=40, CanChange=True
    "top_p":            Initialize=90, CanChange=True   // * 100 (90 = 0.9)
    "greedy":           Initialize=1, CanChange=True    // 1=argmax, 0=sample
}

// =============================================================================
// PER-LAYER WEIGHT POINTERS — populated after dequant
// Each layer has: Wq, Wk, Wv, Wo, W_gate, W_up, W_down, attn_norm, ffn_norm
// =============================================================================
FixedPool.LLMLayerConst {
    "MAX_LAYERS":   Initialize=64, CanChange=False
    "ENTRY_SIZE":   Initialize=72, CanChange=False  // 9 pointers * 8 bytes
}

FixedPool.LLMLayerField {
    "WQ":           Initialize=0    // attention query weights
    "WK":           Initialize=8    // attention key weights
    "WV":           Initialize=16   // attention value weights
    "WO":           Initialize=24   // attention output projection
    "W_GATE":       Initialize=32   // FFN gate projection (SwiGLU)
    "W_UP":         Initialize=40   // FFN up projection
    "W_DOWN":       Initialize=48   // FFN down projection
    "ATTN_NORM":    Initialize=56   // RMSNorm weights (pre-attention)
    "FFN_NORM":     Initialize=64   // RMSNorm weights (pre-FFN)
}

FixedPool.LLMWeights {
    "layers":       Initialize=0, CanChange=True   // ptr to layer array
    "tok_embd":     Initialize=0, CanChange=True   // token embedding table
    "output_norm":  Initialize=0, CanChange=True   // final RMSNorm
    "output":       Initialize=0, CanChange=True   // output projection (lm_head)
    "n_loaded":     Initialize=0, CanChange=True   // layers loaded so far
}

// =============================================================================
// FORWARD PASS SCRATCH BUFFERS
// =============================================================================
FixedPool.LLMBuf {
    // Per-token working buffers (sized to d_model or d_ff)
    "x":            Initialize=0, CanChange=True   // current hidden state [d_model]
    "xb":           Initialize=0, CanChange=True   // scratch after norm [d_model]
    "xb2":          Initialize=0, CanChange=True   // scratch after FFN norm [d_model]
    "q":            Initialize=0, CanChange=True   // query vector [d_model]
    "k":            Initialize=0, CanChange=True   // key vector [d_model]
    "v":            Initialize=0, CanChange=True   // value vector [d_model]
    "att":          Initialize=0, CanChange=True   // attention scores [n_heads * seq_len]
    "ffn_gate":     Initialize=0, CanChange=True   // gate projection [d_ff]
    "ffn_up":       Initialize=0, CanChange=True   // up projection [d_ff]
    "ffn_down":     Initialize=0, CanChange=True   // down projection result [d_model]
    "logits":       Initialize=0, CanChange=True   // output logits [vocab_size]
}

// =============================================================================
// KV CACHE STATE
// =============================================================================
FixedPool.KVCache {
    "key":          Initialize=0, CanChange=True   // [n_layers * max_seq * d_model]
    "value":        Initialize=0, CanChange=True   // [n_layers * max_seq * d_model]
    "pos":          Initialize=0, CanChange=True   // current position in sequence
    "allocated":    Initialize=0, CanChange=True   // 1 after allocation
}
