// =============================================================================
// LLM_InitTokenizer — initialize the BPE tokenizer from GGUF-loaded data
// Must be called after LLM_LoadModel has populated LLMTokenizer.
// Returns 0 on success.
// =============================================================================
Function.LLM_InitTokenizer {
    Output: Integer
    Body: {
        IfCondition EqualTo(LLMTokenizer.vocab, 0) ThenBlock: {
            PrintMessage("[Tokenizer] ERROR: vocab not loaded from GGUF\n")
            ReturnValue(-1)
        }
        IfCondition EqualTo(LLMTokenizer.merges, 0) ThenBlock: {
            PrintMessage("[Tokenizer] ERROR: merges not loaded from GGUF\n")
            ReturnValue(-1)
        }

        BPE_Init()

        PrintMessage("[Tokenizer] Vocab size: ")
        PrintNumber(LLMTokenizer.vocab_size)
        PrintMessage(", BOS=")
        PrintNumber(LLMTokenizer.bos_id)
        PrintMessage(", EOS=")
        PrintNumber(LLMTokenizer.eos_id)
        PrintMessage(", UNK=")
        PrintNumber(LLMTokenizer.unk_id)
        PrintMessage("\n")

        LLMTokenizer.initialized = 1
        ReturnValue(0)
    }
}

// =============================================================================
// LLM_Tokenize — encode text to token IDs
// Input:  text (null-terminated string), text_len, out_ids (pre-allocated), max_ids
// Output: number of tokens
// =============================================================================
Function.LLM_Tokenize {
    Input: text: Address
    Input: text_len: Integer
    Input: out_ids: Address
    Input: max_ids: Integer
    Output: Integer
    Body: {
        ReturnValue(BPE_Encode(text, text_len, out_ids, max_ids))
    }
}

// =============================================================================
// LLM_TokenToString — decode a single token ID, print it
// =============================================================================
Function.LLM_TokenToString {
    Input: token_id: Integer
    Body: {
        BPE_Decode(token_id)
    }
}

// =============================================================================
// LLM_PrintTokens — print decoded token sequence
// =============================================================================
Function.LLM_PrintTokens {
    Input: ids: Address
    Input: n_ids: Integer
    Body: {
        BPE_DecodeSequence(ids, n_ids)
    }
}
