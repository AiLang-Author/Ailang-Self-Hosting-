Function.AIMacro.Math.Sqrt {
    Input: value: Integer
    Output: Address
    Body: {
        ReturnValue(AIMacro.FloatBox(Float_Sqrt(AIMacro.ToFloatBits(value))))
    }
}

Function.AIMacro.Math.Sin {
    Input: angle: Integer
    Output: Address
    Body: {
        ReturnValue(AIMacro.FloatBox(Float_Sin(AIMacro.ToFloatBits(angle))))
    }
}

Function.AIMacro.Math.Cos {
    Input: angle: Integer
    Output: Address
    Body: {
        ReturnValue(AIMacro.FloatBox(Float_Cos(AIMacro.ToFloatBits(angle))))
    }
}

Function.AIMacro.Math.Pi {
    Output: Address
    Body: {
        ReturnValue(AIMacro.FloatBox(0x400921FB54442D18))
    }
}

// =============================================================================
// SYSTEM FUNCTIONS
// =============================================================================

Function.AIMacro.Exit {
    Input: code: Integer
    Body: {
        HaltProgram()
    }
}

Function.AIMacro.GetCommandLineArgs {
    Output: Address
    Body: {
        ReturnValue(AIMacro.Argv())
    }
}

Function.AIMacro.Argv {
    Output: Address
    Body: {
        args = Array.Create(8)
        fd = SystemCall(2, "/proc/self/cmdline", 0, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(args)
        }
        buf = Allocate(8192)
        total = SystemCall(0, fd, buf, 8192)
        SystemCall(3, fd)
        IfCondition LessThan(total, 0) ThenBlock: {
            ReturnValue(args)
        }
        off = 0
        WhileLoop LessThan(off, total) {
            start = off
            WhileLoop LessThan(off, total) {
                ch = GetByte(buf, off)
                IfCondition EqualTo(ch, 0) ThenBlock: {
                    BreakLoop
                }
                off = Add(off, 1)
            }
            alen = Subtract(off, start)
            IfCondition GreaterThan(alen, 0) ThenBlock: {
                s = Allocate(Add(alen, 1))
                j = 0
                WhileLoop LessThan(j, alen) {
                    SetByte(s, j, GetByte(buf, Add(start, j)))
                    j = Add(j, 1)
                }
                SetByte(s, alen, 0)
                Array.Push(args, s)
            }
            off = Add(off, 1)
        }
        ReturnValue(args)
    }
}

Function.AIMacro.StdHandle {
    Input: fd: Integer
    Input: kind: Integer
    Output: Address
    Body: {
        h = Allocate(24)
        StoreValue(h, 1095518534)
        StoreValue(Add(h, 8), fd)
        StoreValue(Add(h, 16), kind)
        ReturnValue(h)
    }
}

Function.AIMacro.OsJoin {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: {
            ReturnValue(b)
        }
        IfCondition EqualTo(b, 0) ThenBlock: {
            ReturnValue(a)
        }
        alen = StringLength(a)
        IfCondition EqualTo(alen, 0) ThenBlock: {
            ReturnValue(b)
        }
        last = GetByte(a, Subtract(alen, 1))
        IfCondition EqualTo(last, 47) ThenBlock: {
            ReturnValue(String.Concat(a, b))
        }
        ReturnValue(String.Concat(String.Concat(a, "/"), b))
    }
}

Function.AIMacro.OsExists {
    Input: path: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        SystemCall(3, fd)
        ReturnValue(1)
    }
}

Function.AIMacro.OsBasename {
    Input: path: Address
    Output: Address
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: {
            ReturnValue("")
        }
        n = StringLength(path)
        IfCondition EqualTo(n, 0) ThenBlock: {
            ReturnValue("")
        }
        last = Subtract(n, 1)
        WhileLoop GreaterThan(last, 0) {
            IfCondition EqualTo(GetByte(path, last), 47) ThenBlock: {
                BreakLoop
            }
            last = Subtract(last, 1)
        }
        start = 0
        IfCondition EqualTo(GetByte(path, last), 47) ThenBlock: {
            start = Add(last, 1)
        }
        slen = Subtract(n, start)
        out = Allocate(Add(slen, 1))
        j = 0
        WhileLoop LessThan(j, slen) {
            SetByte(out, j, GetByte(path, Add(start, j)))
            j = Add(j, 1)
        }
        SetByte(out, slen, 0)
        ReturnValue(out)
    }
}

Function.AIMacro.OsDirname {
    Input: path: Address
    Output: Address
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: {
            ReturnValue(".")
        }
        n = StringLength(path)
        last = Subtract(n, 1)
        WhileLoop GreaterThan(last, 0) {
            IfCondition EqualTo(GetByte(path, last), 47) ThenBlock: {
                BreakLoop
            }
            last = Subtract(last, 1)
        }
        IfCondition EqualTo(last, 0) ThenBlock: {
            ReturnValue(".")
        }
        out = Allocate(Add(last, 1))
        j = 0
        WhileLoop LessThan(j, last) {
            SetByte(out, j, GetByte(path, j))
            j = Add(j, 1)
        }
        SetByte(out, last, 0)
        ReturnValue(out)
    }
}

Function.AIMacro.OsListdir {
    Input: path: Address
    Output: Address
    Body: {
        names = Array.Create(16)
        fd = SystemCall(2, path, 65536, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            fd = SystemCall(2, path, 0, 0)
        }
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(names)
        }
        buf = Allocate(4096)
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            nread = SystemCall(217, fd, buf, 4096)
            IfCondition LessEqual(nread, 0) ThenBlock: {
                looping = 0
            } ElseBlock: {
                off = 0
                WhileLoop LessThan(off, nread) {
                    reclen = Add(GetByte(buf, Add(off, 16)), Multiply(GetByte(buf, Add(off, 17)), 256))
                    IfCondition LessEqual(reclen, 0) ThenBlock: {
                        BreakLoop
                    }
                    nstart = Add(off, 19)
                    nl = 0
                    WhileLoop LessThan(Add(nstart, nl), Add(off, reclen)) {
                        IfCondition EqualTo(GetByte(buf, Add(nstart, nl)), 0) ThenBlock: {
                            BreakLoop
                        }
                        nl = Add(nl, 1)
                    }
                    skip = 0
                    IfCondition EqualTo(nl, 1) ThenBlock: {
                        IfCondition EqualTo(GetByte(buf, nstart), 46) ThenBlock: {
                            skip = 1
                        }
                    }
                    IfCondition EqualTo(nl, 2) ThenBlock: {
                        IfCondition And(EqualTo(GetByte(buf, nstart), 46), EqualTo(GetByte(buf, Add(nstart, 1)), 46)) ThenBlock: {
                            skip = 1
                        }
                    }
                    IfCondition EqualTo(skip, 0) ThenBlock: {
                        s = Allocate(Add(nl, 1))
                        j = 0
                        WhileLoop LessThan(j, nl) {
                            SetByte(s, j, GetByte(buf, Add(nstart, j)))
                            j = Add(j, 1)
                        }
                        SetByte(s, nl, 0)
                        Array.Push(names, s)
                    }
                    off = Add(off, reclen)
                }
            }
        }
        SystemCall(3, fd)
        ReturnValue(names)
    }
}

Function.AIMacro.TimeTime {
    Output: Integer
    Body: {
        ts = Allocate(16)
        SystemCall(228, 0, ts)
        ReturnValue(Dereference(ts))
    }
}

Function.AIMacro.TimeSleep {
    Input: seconds: Integer
    Body: {
        IfCondition LessThan(seconds, 0) ThenBlock: {
            ReturnValue(0)
        }
        ts = Allocate(16)
        StoreValue(ts, seconds)
        StoreValue(Add(ts, 8), 0)
        SystemCall(35, ts, 0)
    }
}

Function.AIMacro.JsonToNative {
    Input: tagged: Address
    Output: Address
    Body: {
        IfCondition EqualTo(tagged, 0) ThenBlock: {
            ReturnValue(Types.GetNone())
        }
        vtype = Dereference(tagged)
        IfCondition EqualTo(vtype, 0) ThenBlock: {
            ReturnValue(Types.GetNone())
        }
        IfCondition EqualTo(vtype, 1) ThenBlock: {
            ReturnValue(JSON.AsString(tagged))
        }
        IfCondition EqualTo(vtype, 2) ThenBlock: {
            ReturnValue(JSON.AsNumber(tagged))
        }
        IfCondition EqualTo(vtype, 3) ThenBlock: {
            ReturnValue(AIMacro.Bool(JSON.AsBool(tagged)))
        }
        IfCondition EqualTo(vtype, 5) ThenBlock: {
            arr = JSON.AsArray(tagged)
            n = Array.Size(arr)
            out = Array.Create(n)
            i = 0
            WhileLoop LessThan(i, n) {
                Array.Push(out, AIMacro.JsonToNative(Array.Get(arr, i)))
                i = Add(i, 1)
            }
            ReturnValue(out)
        }
        IfCondition EqualTo(vtype, 4) ThenBlock: {
            obj = JSON.AsObject(tagged)
            h = Hash.Create(16)
            keys = SHash.Keys(obj)
            n = Array.Size(keys)
            i = 0
            WhileLoop LessThan(i, n) {
                k = Array.Get(keys, i)
                Hash.Set(h, k, AIMacro.JsonToNative(SHash.Lookup(obj, k)))
                i = Add(i, 1)
            }
            ReturnValue(h)
        }
        ReturnValue(Types.GetNone())
    }
}

Function.AIMacro.NativeToJSON {
    Input: value: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.IsNone(value), 1) ThenBlock: {
            ReturnValue(JSON.Tag(0, 0))
        }
        IfCondition EqualTo(Types.IsBool(value), 1) ThenBlock: {
            ReturnValue(JSON.Tag(3, AIMacro.BoolVal(value)))
        }
        IfCondition EqualTo(value, 0) ThenBlock: {
            ReturnValue(JSON.Tag(2, 0))
        }
        IfCondition EqualTo(Types.IsFloat(value), 1) ThenBlock: {
            ReturnValue(JSON.Tag(2, Float_ToInt(AIMacro.FloatBits(value))))
        }
        IfCondition GreaterEqual(value, TypeMagic.PTR_MIN) ThenBlock: {
            is_arr = Array.IsArray(value)
            IfCondition EqualTo(is_arr, 1) ThenBlock: {
                ja = JSON.NewArray()
                n = Array.Size(value)
                i = 0
                WhileLoop LessThan(i, n) {
                    Array.Push(ja, AIMacro.NativeToJSON(Array.Get(value, i)))
                    i = Add(i, 1)
                }
                ReturnValue(JSON.Tag(5, ja))
            }
            is_hash = Hash.IsHash(value)
            IfCondition EqualTo(is_hash, 1) ThenBlock: {
                jo = JSON.NewObject()
                keys = Hash.Keys(value)
                n = Array.Size(keys)
                i = 0
                WhileLoop LessThan(i, n) {
                    k = Array.Get(keys, i)
                    SHash.Insert(jo, k, AIMacro.NativeToJSON(Hash.Get(value, k)))
                    i = Add(i, 1)
                }
                ReturnValue(JSON.Tag(4, jo))
            }
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(value), 1) ThenBlock: {
            ReturnValue(JSON.Tag(1, value))
        }
        ReturnValue(JSON.Tag(2, value))
    }
}

Function.AIMacro.JsonLoads {
    Input: s: Address
    Output: Address
    Body: {
        tagged = ParseJSON(s)
        IfCondition EqualTo(tagged, 0) ThenBlock: {
            AIMacro.RaiseKind(2, "json.loads failed")
            ReturnValue(Types.GetNone())
        }
        ReturnValue(AIMacro.JsonToNative(tagged))
    }
}

Function.AIMacro.JsonDumpQuote {
    Input: s: Address
    Output: Address
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: {
            ReturnValue("\"\"")
        }
        escaped = JSON.EscapeString(s)
        ReturnValue(String.Concat("\"", String.Concat(escaped, "\"")))
    }
}

Function.AIMacro.JsonDumpNative {
    Input: value: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.IsNone(value), 1) ThenBlock: {
            ReturnValue("null")
        }
        IfCondition EqualTo(Types.IsBool(value), 1) ThenBlock: {
            IfCondition EqualTo(AIMacro.BoolVal(value), 1) ThenBlock: {
                ReturnValue("true")
            }
            ReturnValue("false")
        }
        IfCondition EqualTo(Types.IsFloat(value), 1) ThenBlock: {
            ReturnValue(AIMacro.FloatStr(value))
        }
        IfCondition GreaterEqual(value, TypeMagic.PTR_MIN) ThenBlock: {
            IfCondition EqualTo(Array.IsArray(value), 1) ThenBlock: {
                n = Array.Size(value)
                IfCondition EqualTo(n, 0) ThenBlock: {
                    ReturnValue("[]")
                }
                s = "["
                i = 0
                WhileLoop LessThan(i, n) {
                    IfCondition GreaterThan(i, 0) ThenBlock: {
                        s = String.Concat(s, ", ")
                    }
                    s = String.Concat(s, AIMacro.JsonDumpNative(Array.Get(value, i)))
                    i = Add(i, 1)
                }
                ReturnValue(String.Concat(s, "]"))
            }
            IfCondition EqualTo(Hash.IsHash(value), 1) ThenBlock: {
                keys = Hash.Keys(value)
                n = Array.Size(keys)
                IfCondition EqualTo(n, 0) ThenBlock: {
                    ReturnValue("{}")
                }
                s = "{"
                i = 0
                WhileLoop LessThan(i, n) {
                    IfCondition GreaterThan(i, 0) ThenBlock: {
                        s = String.Concat(s, ", ")
                    }
                    k = Array.Get(keys, i)
                    IfCondition EqualTo(AIMacro.LooksLikeString(k), 1) ThenBlock: {
                        s = String.Concat(s, AIMacro.JsonDumpQuote(k))
                    } ElseBlock: {
                        s = String.Concat(s, AIMacro.JsonDumpQuote(AIMacro.Str(k)))
                    }
                    s = String.Concat(s, ": ")
                    s = String.Concat(s, AIMacro.JsonDumpNative(Hash.Get(value, k)))
                    i = Add(i, 1)
                }
                ReturnValue(String.Concat(s, "}"))
            }
        }
        IfCondition EqualTo(AIMacro.LooksLikeString(value), 1) ThenBlock: {
            ReturnValue(AIMacro.JsonDumpQuote(value))
        }
        ReturnValue(NumberToString(value))
    }
}

Function.AIMacro.JsonDumps {
    Input: value: Address
    Output: Address
    Body: {
        ReturnValue(AIMacro.JsonDumpNative(value))
    }
}

// =============================================================================
// FLOAT BOX — IEEE binary64 bits tagged with TypeMagic.FLOAT
// =============================================================================
Function.AIMacro.FloatBox {
    Input: bits: Integer
    Output: Address
    Body: {
        h = Allocate(16)
        StoreValue(h, TypeMagic.FLOAT)
        StoreValue(Add(h, 8), bits)
        ReturnValue(h)
    }
}

Function.AIMacro.FloatBits {
    Input: boxed: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Types.IsFloat(boxed), 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Dereference(Add(boxed, 8)))
    }
}

Function.AIMacro.ToFloatBits {
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Types.IsFloat(value), 1) ThenBlock: {
            ReturnValue(AIMacro.FloatBits(value))
        }
        IfCondition EqualTo(AIMacro.IsNone(value), 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Float_FromInt(value))
    }
}

Function.AIMacro.Float {
    Input: value: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Types.IsFloat(value), 1) ThenBlock: {
            ReturnValue(value)
        }
        IfCondition EqualTo(Types.IsString(value), 1) ThenBlock: {
            ReturnValue(AIMacro.FloatParse(value))
        }
        ReturnValue(AIMacro.FloatBox(Float_FromInt(value)))
    }
}

Function.AIMacro.FloatParse {
    Input: s: Address
    Output: Address
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: {
            ReturnValue(AIMacro.FloatBox(0))
        }
        n = StringLength(s)
        i = 0
        sign = 0
        IfCondition GreaterThan(n, 0) ThenBlock: {
            c0 = GetByte(s, 0)
            IfCondition EqualTo(c0, 45) ThenBlock: {
                sign = 1
                i = 1
            }
            IfCondition EqualTo(c0, 43) ThenBlock: {
                i = 1
            }
        }
        ip = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(s, i)
            IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                BreakLoop
            }
            ip = Add(Multiply(ip, 10), Subtract(ch, 48))
            i = Add(i, 1)
        }
        fp = 0
        scale = 1
        IfCondition LessThan(i, n) ThenBlock: {
            IfCondition EqualTo(GetByte(s, i), 46) ThenBlock: {
                i = Add(i, 1)
                WhileLoop LessThan(i, n) {
                    ch = GetByte(s, i)
                    IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                        BreakLoop
                    }
                    fp = Add(Multiply(fp, 10), Subtract(ch, 48))
                    scale = Multiply(scale, 10)
                    i = Add(i, 1)
                }
            }
        }
        bits = Float_FromInt(ip)
        IfCondition GreaterThan(scale, 1) ThenBlock: {
            bits = Float_Add(bits, Float_Div(Float_FromInt(fp), Float_FromInt(scale)))
        }
        IfCondition LessThan(i, n) ThenBlock: {
            ech = GetByte(s, i)
            IfCondition Or(EqualTo(ech, 101), EqualTo(ech, 69)) ThenBlock: {
                i = Add(i, 1)
                esign = 0
                IfCondition LessThan(i, n) ThenBlock: {
                    IfCondition EqualTo(GetByte(s, i), 45) ThenBlock: {
                        esign = 1
                        i = Add(i, 1)
                    }
                    IfCondition EqualTo(GetByte(s, i), 43) ThenBlock: {
                        i = Add(i, 1)
                    }
                }
                ev = 0
                WhileLoop LessThan(i, n) {
                    ch = GetByte(s, i)
                    IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                        BreakLoop
                    }
                    ev = Add(Multiply(ev, 10), Subtract(ch, 48))
                    i = Add(i, 1)
                }
                ten = Float_FromInt(10)
                ei = 0
                WhileLoop LessThan(ei, ev) {
                    IfCondition EqualTo(esign, 1) ThenBlock: {
                        bits = Float_Div(bits, ten)
                    } ElseBlock: {
                        bits = Float_Mul(bits, ten)
                    }
                    ei = Add(ei, 1)
                }
            }
        }
        IfCondition EqualTo(sign, 1) ThenBlock: {
            bits = Float_Sub(0, bits)
        }
        ReturnValue(AIMacro.FloatBox(bits))
    }
}

Function.AIMacro.FloatStr {
    Input: value: Address
    Output: Address
    Body: {
        bits = AIMacro.ToFloatBits(value)
        mag = BitwiseAnd(bits, 0x7FFFFFFFFFFFFFFF)
        IfCondition EqualTo(mag, 0) ThenBlock: {
            ReturnValue("0.0")
        }
        sign = 0
        IfCondition NotEqual(bits, mag) ThenBlock: {
            sign = 1
            bits = mag
        }
        ip = Float_ToInt(bits)
        frac = Float_Sub(bits, Float_FromInt(ip))
        s = NumberToString(ip)
        IfCondition EqualTo(sign, 1) ThenBlock: {
            s = String.Concat("-", s)
        }
        s = String.Concat(s, ".")
        IfCondition EqualTo(Float_Eq(frac, 0), 1) ThenBlock: {
            ReturnValue(String.Concat(s, "0"))
        }
        i = 0
        WhileLoop LessThan(i, 6) {
            frac = Float_Mul(frac, Float_FromInt(10))
            d = Float_ToInt(frac)
            IfCondition LessThan(d, 0) ThenBlock: {
                d = 0
            }
            IfCondition GreaterThan(d, 9) ThenBlock: {
                d = 9
            }
            s = String.Concat(s, NumberToString(d))
            frac = Float_Sub(frac, Float_FromInt(d))
            i = Add(i, 1)
        }
        ReturnValue(s)
    }
}

Function.AIMacro.NumAdd {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        a = AIMacro.BoolVal(a)
        b = AIMacro.BoolVal(b)
        IfCondition Or(EqualTo(Types.IsFloat(a), 1), EqualTo(Types.IsFloat(b), 1)) ThenBlock: {
            ReturnValue(AIMacro.FloatBox(Float_Add(AIMacro.ToFloatBits(a), AIMacro.ToFloatBits(b))))
        }
        ReturnValue(Add(a, b))
    }
}

Function.AIMacro.NumSub {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        a = AIMacro.BoolVal(a)
        b = AIMacro.BoolVal(b)
        IfCondition Or(EqualTo(Types.IsFloat(a), 1), EqualTo(Types.IsFloat(b), 1)) ThenBlock: {
            ReturnValue(AIMacro.FloatBox(Float_Sub(AIMacro.ToFloatBits(a), AIMacro.ToFloatBits(b))))
        }
        ReturnValue(Subtract(a, b))
    }
}

Function.AIMacro.NumMul {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        a = AIMacro.BoolVal(a)
        b = AIMacro.BoolVal(b)
        IfCondition Or(EqualTo(Types.IsFloat(a), 1), EqualTo(Types.IsFloat(b), 1)) ThenBlock: {
            ReturnValue(AIMacro.FloatBox(Float_Mul(AIMacro.ToFloatBits(a), AIMacro.ToFloatBits(b))))
        }
        ReturnValue(Multiply(a, b))
    }
}

Function.AIMacro.NumPow {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        a = AIMacro.BoolVal(a)
        b = AIMacro.BoolVal(b)
        IfCondition And(EqualTo(Types.IsFloat(a), 0), EqualTo(Types.IsFloat(b), 0)) ThenBlock: {
            ReturnValue(Math.Power(a, b))
        }
        bits = AIMacro.ToFloatBits(a)
        e = b
        IfCondition EqualTo(Types.IsFloat(b), 1) ThenBlock: {
            e = Float_ToInt(AIMacro.FloatBits(b))
        }
        IfCondition EqualTo(e, 0) ThenBlock: {
            ReturnValue(AIMacro.FloatBox(Float_FromInt(1)))
        }
        neg = 0
        IfCondition LessThan(e, 0) ThenBlock: {
            neg = 1
            e = Subtract(0, e)
        }
        acc = Float_FromInt(1)
        i = 0
        WhileLoop LessThan(i, e) {
            acc = Float_Mul(acc, bits)
            i = Add(i, 1)
        }
        IfCondition EqualTo(neg, 1) ThenBlock: {
            acc = Float_Div(Float_FromInt(1), acc)
        }
        ReturnValue(AIMacro.FloatBox(acc))
    }
}

Function.AIMacro.TrueDiv {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        a = AIMacro.BoolVal(a)
        b = AIMacro.BoolVal(b)
        ReturnValue(AIMacro.FloatBox(Float_Div(AIMacro.ToFloatBits(a), AIMacro.ToFloatBits(b))))
    }
}

Function.AIMacro.FloorDiv {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        a = AIMacro.BoolVal(a)
        b = AIMacro.BoolVal(b)
        ia = a
        ib = b
        IfCondition EqualTo(Types.IsFloat(a), 1) ThenBlock: {
            ia = Float_ToInt(AIMacro.FloatBits(a))
        }
        IfCondition EqualTo(Types.IsFloat(b), 1) ThenBlock: {
            ib = Float_ToInt(AIMacro.FloatBits(b))
        }
        ReturnValue(Math.FloorDiv(ia, ib))
    }
}

Function.AIMacro.NumMod {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        a = AIMacro.BoolVal(a)
        b = AIMacro.BoolVal(b)
        ia = a
        ib = b
        IfCondition EqualTo(Types.IsFloat(a), 1) ThenBlock: {
            ia = Float_ToInt(AIMacro.FloatBits(a))
        }
        IfCondition EqualTo(Types.IsFloat(b), 1) ThenBlock: {
            ib = Float_ToInt(AIMacro.FloatBits(b))
        }
        ReturnValue(Modulo(ia, ib))
    }
}

Function.AIMacro.NumNeg {
    Input: a: Address
    Output: Address
    Body: {
        a = AIMacro.BoolVal(a)
        IfCondition EqualTo(Types.IsFloat(a), 1) ThenBlock: {
            ReturnValue(AIMacro.FloatBox(Float_Sub(0, AIMacro.FloatBits(a))))
        }
        ReturnValue(Subtract(0, a))
    }
}

Function.AIMacro.NumEq {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        a = AIMacro.BoolVal(a)
        b = AIMacro.BoolVal(b)
        IfCondition Or(EqualTo(Types.IsFloat(a), 1), EqualTo(Types.IsFloat(b), 1)) ThenBlock: {
            ReturnValue(AIMacro.Bool(Float_Eq(AIMacro.ToFloatBits(a), AIMacro.ToFloatBits(b))))
        }
        ReturnValue(AIMacro.Bool(EqualTo(a, b)))
    }
}

Function.AIMacro.NumNe {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacro.SmartBool(AIMacro.NumEq(a, b)), 1) ThenBlock: {
            ReturnValue(AIMacro.FalseVal())
        }
        ReturnValue(AIMacro.TrueVal())
    }
}

Function.AIMacro.NumLt {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        a = AIMacro.BoolVal(a)
        b = AIMacro.BoolVal(b)
        IfCondition Or(EqualTo(Types.IsFloat(a), 1), EqualTo(Types.IsFloat(b), 1)) ThenBlock: {
            ReturnValue(AIMacro.Bool(Float_Lt(AIMacro.ToFloatBits(a), AIMacro.ToFloatBits(b))))
        }
        ReturnValue(AIMacro.Bool(LessThan(a, b)))
    }
}

Function.AIMacro.NumLe {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        a = AIMacro.BoolVal(a)
        b = AIMacro.BoolVal(b)
        IfCondition Or(EqualTo(Types.IsFloat(a), 1), EqualTo(Types.IsFloat(b), 1)) ThenBlock: {
            ReturnValue(AIMacro.Bool(Float_Le(AIMacro.ToFloatBits(a), AIMacro.ToFloatBits(b))))
        }
        ReturnValue(AIMacro.Bool(LessEqual(a, b)))
    }
}

Function.AIMacro.NumGt {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        a = AIMacro.BoolVal(a)
        b = AIMacro.BoolVal(b)
        IfCondition Or(EqualTo(Types.IsFloat(a), 1), EqualTo(Types.IsFloat(b), 1)) ThenBlock: {
            ReturnValue(AIMacro.Bool(Float_Gt(AIMacro.ToFloatBits(a), AIMacro.ToFloatBits(b))))
        }
        ReturnValue(AIMacro.Bool(GreaterThan(a, b)))
    }
}

Function.AIMacro.NumGe {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        a = AIMacro.BoolVal(a)
        b = AIMacro.BoolVal(b)
        IfCondition Or(EqualTo(Types.IsFloat(a), 1), EqualTo(Types.IsFloat(b), 1)) ThenBlock: {
            ReturnValue(AIMacro.Bool(Float_Ge(AIMacro.ToFloatBits(a), AIMacro.ToFloatBits(b))))
        }
        ReturnValue(AIMacro.Bool(GreaterEqual(a, b)))
    }
}

// =============================================================================
// EXCEPTIONS — software pending flag + Plex object; Fork/Branch dispatch
// Kind: 1=Exception 2=ValueError 3=OSError 4=FileNotFoundError
//       5=TypeError 6=RuntimeError 7=ZeroDivisionError 8=AssertionError
// Plex type_tag = 20000 + kind; slot 0 = message
// =============================================================================
FixedPool.AIMacroExc {
    "pending": Initialize=0, CanChange=True
    "kind": Initialize=0, CanChange=True
    "msg": Initialize=0, CanChange=True
    "value": Initialize=0, CanChange=True
    "depth": Initialize=0, CanChange=True
}

Function.AIMacro.ExcEnter {
    Body: {
        AIMacroExc.depth = Add(AIMacroExc.depth, 1)
    }
}

Function.AIMacro.ExcLeave {
    Body: {
        IfCondition GreaterThan(AIMacroExc.depth, 0) ThenBlock: {
            AIMacroExc.depth = Subtract(AIMacroExc.depth, 1)
        }
        IfCondition And(EqualTo(AIMacroExc.pending, 1), EqualTo(AIMacroExc.depth, 0)) ThenBlock: {
            AIMacro.ExcAbort()
        }
    }
}

Function.AIMacro.ExcPending {
    Output: Integer
    Body: {
        ReturnValue(AIMacroExc.pending)
    }
}

Function.AIMacro.ExcKind {
    Output: Integer
    Body: {
        ReturnValue(AIMacroExc.kind)
    }
}

Function.AIMacro.ExcMsg {
    Output: Address
    Body: {
        IfCondition EqualTo(AIMacroExc.msg, 0) ThenBlock: {
            ReturnValue("")
        }
        ReturnValue(AIMacroExc.msg)
    }
}

Function.AIMacro.ExcValue {
    Output: Integer
    Body: {
        ReturnValue(AIMacroExc.value)
    }
}

Function.AIMacro.ExcClear {
    Body: {
        AIMacroExc.pending = 0
    }
}

Function.AIMacro.ExcAbort {
    Body: {
        PrintMessage("Exception: ")
        IfCondition NotEqual(AIMacroExc.msg, 0) ThenBlock: {
            PrintString(AIMacroExc.msg)
        }
        PrintMessage("\n")
        ProcessExit(1)
    }
}

Function.AIMacro.RaiseKind {
    Input: kind: Integer
    Input: msg: Address
    Body: {
        Plex.Init()
        node = Plex.Alloc(Add(20000, kind))
        Plex.Set(node, 0, msg)
        Plex.Set(node, 1, kind)
        Plex.RingSingleton(node, 0)
        IfCondition And(NotEqual(AIMacroExc.value, 0), EqualTo(Plex.IsLive(AIMacroExc.value), 1)) ThenBlock: {
            Plex.RingInsertAfter(AIMacroExc.value, node, 0)
        }
        AIMacroExc.pending = 1
        AIMacroExc.kind = kind
        AIMacroExc.msg = msg
        AIMacroExc.value = node
        IfCondition EqualTo(AIMacroExc.depth, 0) ThenBlock: {
            AIMacro.ExcAbort()
        }
    }
}

Function.AIMacro.Raise {
    Input: msg: Address
    Body: {
        AIMacro.RaiseKind(6, msg)
    }
}





