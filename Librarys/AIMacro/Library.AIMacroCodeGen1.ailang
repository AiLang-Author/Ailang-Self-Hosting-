LibraryImport.Array
LibraryImport.AIMacro.AIMacroCore
LibraryImport.AIMacro.AIMacroParserCore

// =============================================================================
// CODE GENERATOR STATE
// =============================================================================
FixedPool.Gen {
    "output": Initialize=0, CanChange=True   
    "indent": Initialize=0, CanChange=True    
    "temp_counter": Initialize=0, CanChange=True
    "param_names": Initialize=0, CanChange=True
    "string_vars": Initialize=0, CanChange=True 
    "list_vars": Initialize=0, CanChange=True
    "dict_vars": Initialize=0, CanChange=True
    "packed_funcs": Initialize=0, CanChange=True

    "deferred_functions": Initialize=0
    "deferred_stmts": Initialize=0
    "collect_mode": Initialize=0
    "func_names": Initialize=0, CanChange=True
    "func_defaults": Initialize=0, CanChange=True
    "func_varargs": Initialize=0, CanChange=True
    "func_params": Initialize=0, CanChange=True
    "try_depth": Initialize=0, CanChange=True
    "loop_depth": Initialize=0, CanChange=True
    "lambda_counter": Initialize=0, CanChange=True
    "callable_vars": Initialize=0, CanChange=True

}

// =============================================================================
// INITIALIZATION
// =============================================================================
Function.Gen_Init {
    Body: {
        Gen.output = Array.Create(256)
        Gen.indent = 0
        Gen.temp_counter = 0
        Gen.param_names = Array.Create(16)
        Gen.string_vars = Array.Create(32)
        Gen.list_vars = Array.Create(32)
        Gen.dict_vars = Array.Create(32)
        Gen.packed_funcs = Array.Create(16)

        Gen.deferred_functions = Array.Create(64)
        Gen.deferred_stmts = Array.Create(128)
        Gen.collect_mode = 0
        Gen.func_names = Array.Create(32)
        Gen.func_defaults = Array.Create(32)
        Gen.func_varargs = Array.Create(32)
        Gen.func_params = Array.Create(32)
        Gen.try_depth = 0
        Gen.loop_depth = 0
        Gen.lambda_counter = 0
        Gen.callable_vars = Array.Create(32)

    }
}

Function.Gen_Free {
    Body: {
        IfCondition NotEqual(Gen.output, 0) ThenBlock: {
            n = Array.Size(Gen.output)
            i = 0
            WhileLoop LessThan(i, n) {
                s = Array.Get(Gen.output, i)
                IfCondition NotEqual(s, 0) ThenBlock: {
                }
                i = Add(i, 1)
            }
            Array.Destroy(Gen.output)
        }
        IfCondition NotEqual(Gen.param_names, 0) ThenBlock: {
            Array.Destroy(Gen.param_names)
        }
        IfCondition NotEqual(Gen.string_vars, 0) ThenBlock: {
            Array.Destroy(Gen.string_vars)
        }
        IfCondition NotEqual(Gen.list_vars, 0) ThenBlock: {
            Array.Destroy(Gen.list_vars)
        }
        IfCondition NotEqual(Gen.dict_vars, 0) ThenBlock: {
            Array.Destroy(Gen.dict_vars)
        }
        IfCondition NotEqual(Gen.callable_vars, 0) ThenBlock: {
            Array.Destroy(Gen.callable_vars)
        }
        IfCondition NotEqual(Gen.packed_funcs, 0) ThenBlock: {
            Array.Destroy(Gen.packed_funcs)
        }
    }
}


// =============================================================================
// CHECK IF FUNCTION REQUIRES PACKED ARGUMENTS (>6 params)
// =============================================================================
Function.Gen_LookupDefaults {
    Input: name: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(name, 0), EqualTo(Gen.func_names, 0)) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(Gen.func_names)
        i = 0
        WhileLoop LessThan(i, n) {
            fn = Array.Get(Gen.func_names, i)
            cmp = StringCompare(fn, name)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(Array.Get(Gen.func_defaults, i))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_LookupParams {
    Input: name: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(name, 0), EqualTo(Gen.func_names, 0)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Gen.func_params, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(Gen.func_names)
        i = 0
        WhileLoop LessThan(i, n) {
            fn = Array.Get(Gen.func_names, i)
            cmp = StringCompare(fn, name)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                IfCondition LessThan(i, Array.Size(Gen.func_params)) ThenBlock: {
                    ReturnValue(Array.Get(Gen.func_params, i))
                }
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_LookupVarargs {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(name, 0), EqualTo(Gen.func_names, 0)) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(Gen.func_names)
        i = 0
        WhileLoop LessThan(i, n) {
            fn = Array.Get(Gen.func_names, i)
            cmp = StringCompare(fn, name)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                IfCondition EqualTo(Gen.func_varargs, 0) ThenBlock: {
                    ReturnValue(0)
                }
                ReturnValue(Array.Get(Gen.func_varargs, i))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_IsPackedFunc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        sz = Array.Size(Gen.packed_funcs)
        
        idx = 0
        WhileLoop LessThan(idx, sz) {
            fname = Array.Get(Gen.packed_funcs, idx)
            cmp = StringCompare(name, fname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// TEMP NAME GENERATION - Clean names, reset per function
// =============================================================================
Function.Gen_IsStringVar {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        sz = Array.Size(Gen.string_vars)
        idx = 0
        WhileLoop LessThan(idx, sz) {
            varname = Array.Get(Gen.string_vars, idx)
            cmp = StringCompare(name, varname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_MarkStringVar {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        already = Gen_IsStringVar(name)
        IfCondition EqualTo(already, 1) ThenBlock: {
            ReturnValue(0)
        }
        
        // Copy the name and add to list
        len = StringLength(name)
        copy = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(name, i)
            SetByte(copy, i, c)
            i = Add(i, 1)
        }
        SetByte(copy, len, 0)
        
        Array.Push(Gen.string_vars, copy)
    }
}

// =============================================================================
// LIST VARIABLE TRACKING
// =============================================================================
Function.Gen_IsListVar {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        sz = Array.Size(Gen.list_vars)
        idx = 0
        WhileLoop LessThan(idx, sz) {
            varname = Array.Get(Gen.list_vars, idx)
            cmp = StringCompare(name, varname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_MarkListVar {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Check if already tracked
        already = Gen_IsListVar(name)
        IfCondition EqualTo(already, 1) ThenBlock: {
            ReturnValue(0)
        }
        
        // Copy the name and add to list
        len = StringLength(name)
        copy = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(name, i)
            SetByte(copy, i, c)
            i = Add(i, 1)
        }
        SetByte(copy, len, 0)
        
        Array.Push(Gen.list_vars, copy)
    }
}

Function.Gen_IsDictVar {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        sz = Array.Size(Gen.dict_vars)
        idx = 0
        WhileLoop LessThan(idx, sz) {
            varname = Array.Get(Gen.dict_vars, idx)
            cmp = StringCompare(name, varname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_IsCallableVar {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(name, 0), EqualTo(Gen.callable_vars, 0)) ThenBlock: {
            ReturnValue(0)
        }
        sz = Array.Size(Gen.callable_vars)
        idx = 0
        WhileLoop LessThan(idx, sz) {
            varname = Array.Get(Gen.callable_vars, idx)
            cmp = StringCompare(name, varname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_MarkCallableVar {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        already = Gen_IsCallableVar(name)
        IfCondition EqualTo(already, 1) ThenBlock: {
            ReturnValue(0)
        }
        len = StringLength(name)
        copy = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            SetByte(copy, i, GetByte(name, i))
            i = Add(i, 1)
        }
        SetByte(copy, len, 0)
        Array.Push(Gen.callable_vars, copy)
    }
}

Function.Gen_MarkDictVar {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        already = Gen_IsDictVar(name)
        IfCondition EqualTo(already, 1) ThenBlock: {
            ReturnValue(0)
        }
        
        len = StringLength(name)
        copy = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(name, i)
            SetByte(copy, i, c)
            i = Add(i, 1)
        }
        SetByte(copy, len, 0)
        
        Array.Push(Gen.dict_vars, copy)
    }
}


Function.Gen_TempName {
    Output: Address
    Body: {
        num_str = NumberToString(Gen.temp_counter)
        num_len = StringLength(num_str)
        Gen.temp_counter = Add(Gen.temp_counter, 1)

        total_len = Add(1, num_len)
        result = Allocate(Add(total_len, 1))

        SetByte(result, 0, 116)  // 't'

        j = 0
        WhileLoop LessThan(j, num_len) {
            c = GetByte(num_str, j)
            SetByte(result, Add(1, j), c)
            j = Add(j, 1)
        }

        SetByte(result, total_len, 0)

        ReturnValue(result)
    }
}

// =============================================================================
// PARAMETER NAME HELPERS
// =============================================================================
Function.Gen_IsParam {
    Input: name: Address
    Output: Integer
    Body: {
        sz = Array.Size(Gen.param_names)
        idx = 0
        WhileLoop LessThan(idx, sz) {
            pname = Array.Get(Gen.param_names, idx)
            cmp = StringCompare(name, pname)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

Function.Gen_EmitIdent {
    Input: name: Address
    Body: {
        is_param = Gen_IsParam(name)
        IfCondition EqualTo(is_param, 1) ThenBlock: {
            Gen_Emit("p_")
        }
        Gen_Emit(name)
    }
}

// =============================================================================
// OUTPUT HELPERS
// =============================================================================
Function.Gen_Emit {
    Input: str: Address
    Body: {
        len = StringLength(str)
        size = Add(len, 1)
        copy = Allocate(size)
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(str, i)
            SetByte(copy, i, c)
            i = Add(i, 1)
        }
        SetByte(copy, len, 0)
        Array.Push(Gen.output, copy)
    }
}

Function.Gen_EmitIndent {
    Body: {
        i = 0
        WhileLoop LessThan(i, Gen.indent) {
            Gen_Emit("    ")
            i = Add(i, 1)
        }
    }
}

Function.Gen_EmitLine {
    Input: str: Address
    Body: {
        Gen_EmitIndent()
        Gen_Emit(str)
        Gen_Emit("\n")
    }
}

Function.Gen_EmitNumber {
    Input: num: Integer
    Body: {
        str = NumberToString(num)
        Gen_Emit(str)
        
    }
}

// =============================================================================
// GET OPERATOR NAME
// =============================================================================

Function.Gen_OpName {
    Input: op: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(op, Token.PLUS) ThenBlock: { ReturnValue("AIMacro.NumAdd") }
        IfCondition EqualTo(op, Token.MINUS) ThenBlock: { ReturnValue("AIMacro.NumSub") }
        IfCondition EqualTo(op, Token.STAR) ThenBlock: { ReturnValue("AIMacro.NumMul") }
        IfCondition EqualTo(op, Token.SLASH) ThenBlock: { ReturnValue("AIMacro.TrueDiv") }
        IfCondition EqualTo(op, Token.PERCENT) ThenBlock: { ReturnValue("AIMacro.NumMod") }
        IfCondition EqualTo(op, Token.POWER) ThenBlock: { ReturnValue("AIMacro.NumPow") }
        IfCondition EqualTo(op, Token.FLOOR_DIV) ThenBlock: { ReturnValue("AIMacro.FloorDiv") }
        IfCondition EqualTo(op, Token.EQ) ThenBlock: { ReturnValue("AIMacro.NumEq") }
        IfCondition EqualTo(op, Token.NE) ThenBlock: { ReturnValue("AIMacro.NumNe") }
        IfCondition EqualTo(op, Token.LT) ThenBlock: { ReturnValue("AIMacro.NumLt") }
        IfCondition EqualTo(op, Token.LE) ThenBlock: { ReturnValue("AIMacro.NumLe") }
        IfCondition EqualTo(op, Token.GT) ThenBlock: { ReturnValue("AIMacro.NumGt") }
        IfCondition EqualTo(op, Token.GE) ThenBlock: { ReturnValue("AIMacro.NumGe") }
        IfCondition EqualTo(op, Token.AND) ThenBlock: { ReturnValue("AIMacro.AndVal") }
        IfCondition EqualTo(op, Token.OR) ThenBlock: { ReturnValue("AIMacro.OrVal") }
        IfCondition EqualTo(op, Token.BIT_OR) ThenBlock: { ReturnValue("AIMacro.NumBitOr") }
        IfCondition EqualTo(op, Token.LSHIFT) ThenBlock: { ReturnValue("AIMacro.NumBitShl") }
        IfCondition EqualTo(op, Token.RSHIFT) ThenBlock: { ReturnValue("AIMacro.NumBitShr") }
        IfCondition EqualTo(op, Token.NOT) ThenBlock: { ReturnValue("AIMacro.NotVal") }
        IfCondition EqualTo(op, Token.IS) ThenBlock: { ReturnValue("AIMacro.Is") }
        ReturnValue("Unknown")
    }
}

// =============================================================================
// CHECK IF EXPRESSION CONTAINS A FUNCTION CALL
// INDEX_ACCESS counts because it generates Array.Get() which is a call
// =============================================================================
Function.Gen_HasCall {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        t = AST_Type(node)
        
        IfCondition EqualTo(t, Node.CALL) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.LIST_COMP) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.CHAIN_COMPARE) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.FLOAT_LIT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.BOOL_LIT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.LIST_LIT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.DICT_LIT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.LAMBDA) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.INDIRECT_CALL) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.TERNARY) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.NAMED_EXPR) ThenBlock: {
            ReturnValue(Gen_HasCall(ArrayGet(node, 4)))
        }
        IfCondition EqualTo(t, Node.KW_ARG) ThenBlock: {
            ReturnValue(Gen_HasCall(ArrayGet(node, 4)))
        }
        IfCondition EqualTo(t, Node.METHOD_CALL) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, 11) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, 104) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(t, Node.ATTRIBUTE) ThenBlock: {
            ReturnValue(Gen_HasCall(ArrayGet(node, 3)))
        }
        IfCondition EqualTo(t, Node.INDEX_ACCESS) ThenBlock: {
            ReturnValue(1)
        }
        
        IfCondition EqualTo(t, Node.BINARY_OP) ThenBlock: {
            op = ArrayGet(node, 4)
            
            // EQ and NE now emit SmartEqual/SmartNotEqual function calls
            // They MUST be extracted to temp vars before use in IfCondition
            IfCondition EqualTo(op, Token.EQ) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(op, Token.NE) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(op, Token.AND) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(op, Token.OR) ThenBlock: {
                ReturnValue(1)
            }
            
            // For other operators, check children recursively
            left = ArrayGet(node, 3)
            right = ArrayGet(node, 5)
            left_has = Gen_HasCall(left)
            IfCondition EqualTo(left_has, 1) ThenBlock: {
                ReturnValue(1)
            }
            right_has = Gen_HasCall(right)
            ReturnValue(right_has)
        }
        
        IfCondition EqualTo(t, Node.UNARY_OP) ThenBlock: {
            operand = ArrayGet(node, 4)
            ReturnValue(Gen_HasCall(operand))
        }
        
        IfCondition EqualTo(t, Node.INDEX_ACCESS) ThenBlock: {
            expr = ArrayGet(node, 3)
            index = ArrayGet(node, 4)
            expr_has = Gen_HasCall(expr)
            IfCondition EqualTo(expr_has, 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(Gen_HasCall(index))
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// CREATE IDENTIFIER NODE
// =============================================================================
Function.Gen_MakeIdent {
    Input: name: Address
    Output: Address
    Body: {
        node = ArrayCreate(4)
        ArraySet(node, 0, Node.IDENT)
        ArraySet(node, 1, 0)
        ArraySet(node, 2, 0)
        ArraySet(node, 3, name)
        ReturnValue(node)
    }
}

// =============================================================================
// EMIT ESCAPED STRING
// =============================================================================
Function.Gen_EmitEscaped {
    Input: str: Address
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        len = StringLength(str)
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(str, i)
            
            IfCondition EqualTo(c, 10) ThenBlock: {
                Gen_Emit("\\n")
            } ElseBlock: {
                IfCondition EqualTo(c, 9) ThenBlock: {
                    Gen_Emit("\\t")
                } ElseBlock: {
                    IfCondition EqualTo(c, 34) ThenBlock: {
                        Gen_Emit("\\\"")
                    } ElseBlock: {
                        IfCondition EqualTo(c, 92) ThenBlock: {
                            Gen_Emit("\\\\")
                        } ElseBlock: {
                            buf = Allocate(2)
                            SetByte(buf, 0, c)
                            SetByte(buf, 1, 0)
                            Gen_Emit(buf)
                            Deallocate(buf, 2)
                        }
                    }
                }
            }
            
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// CHECK IF ARGUMENT LIST HAS CALLS
// =============================================================================
Function.Gen_ArgsHaveCalls {
    Input: args: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(args, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        n = Array.Size(args)
        i = 0
        WhileLoop LessThan(i, n) {
            arg = Array.Get(args, i)
            has = Gen_HasCall(arg)
            IfCondition EqualTo(has, 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// GET OUTPUT AS STRING
// =============================================================================
Function.Gen_GetOutput {
    Output: Address
    Body: {
        total = 0
        n = Array.Size(Gen.output)
        i = 0
        WhileLoop LessThan(i, n) {
            s = Array.Get(Gen.output, i)
            IfCondition NotEqual(s, 0) ThenBlock: {
                total = Add(total, StringLength(s))
            }
            i = Add(i, 1)
        }
        
        result = Allocate(Add(total, 1))
        pos = 0
        
        i = 0
        WhileLoop LessThan(i, n) {
            s = Array.Get(Gen.output, i)
            IfCondition NotEqual(s, 0) ThenBlock: {
                len = StringLength(s)
                j = 0
                WhileLoop LessThan(j, len) {
                    c = GetByte(s, j)
                    SetByte(result, pos, c)
                    pos = Add(pos, 1)
                    j = Add(j, 1)
                }
            }
            i = Add(i, 1)
        }
        
        SetByte(result, pos, 0)
        ReturnValue(result)
    }
}

// =============================================================================
// STDLIB SHIMS — import skip + method/attr recognition
// =============================================================================
Function.Gen_IsShimModule {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(name, "sys")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "os")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "json")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "math")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "time")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Gen_IsOsPath {
    Input: obj: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_Type(obj), Node.ATTRIBUTE) ThenBlock: {
            ReturnValue(0)
        }
        inner = ArrayGet(obj, 3)
        attr = ArrayGet(obj, 4)
        IfCondition NotEqual(AST_Type(inner), Node.IDENT) ThenBlock: {
            ReturnValue(0)
        }
        iname = ArrayGet(inner, 3)
        cmp = StringCompare(iname, "os")
        IfCondition NotEqual(cmp, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(attr, "path")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Gen_IsPathMethod {
    Input: method: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(method, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(method, "join")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "exists")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "basename")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(method, "dirname")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Gen_IsStdlibMethod {
    Input: obj: Address
    Input: method: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(obj, 0), EqualTo(method, 0)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Gen_IsOsPath(obj), 1) ThenBlock: {
            ReturnValue(Gen_IsPathMethod(method))
        }
        IfCondition NotEqual(AST_Type(obj), Node.IDENT) ThenBlock: {
            ReturnValue(0)
        }
        name = ArrayGet(obj, 3)
        cmp = StringCompare(name, "os")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            IfCondition EqualTo(Gen_IsPathMethod(method), 1) ThenBlock: {
                ReturnValue(1)
            }
            cmp = StringCompare(method, "listdir")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        cmp = StringCompare(name, "json")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "loads")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "dumps")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        cmp = StringCompare(name, "math")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "sqrt")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "sin")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "cos")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "pi")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        cmp = StringCompare(name, "time")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "time")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(method, "sleep")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        cmp = StringCompare(name, "sys")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(method, "exit")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.Gen_IsStdlibAttr {
    Input: obj: Address
    Input: attr: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(obj, 0), EqualTo(attr, 0)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_Type(obj), Node.IDENT) ThenBlock: {
            ReturnValue(0)
        }
        name = ArrayGet(obj, 3)
        cmp = StringCompare(name, "sys")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(attr, "argv")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(attr, "stdin")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            cmp = StringCompare(attr, "stdout")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        cmp = StringCompare(name, "math")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(attr, "pi")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.Gen_MapExcKind {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(1)
        }
        cmp = StringCompare(name, "Exception")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ValueError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(2) }
        cmp = StringCompare(name, "OSError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(3) }
        cmp = StringCompare(name, "IOError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(3) }
        cmp = StringCompare(name, "FileNotFoundError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(4) }
        cmp = StringCompare(name, "TypeError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(5) }
        cmp = StringCompare(name, "RuntimeError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(6) }
        cmp = StringCompare(name, "ZeroDivisionError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(7) }
        cmp = StringCompare(name, "AssertionError")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(8) }
        ReturnValue(1)
    }
}

Function.Gen_EmitStdlibAttr {
    Input: obj: Address
    Input: attr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Gen_IsStdlibAttr(obj, attr), 0) ThenBlock: {
            ReturnValue(0)
        }
        name = ArrayGet(obj, 3)
        cmp = StringCompare(name, "sys")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(attr, "argv")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.Argv()")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "stdin")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.StdHandle(0, 0)")
                ReturnValue(1)
            }
            cmp = StringCompare(attr, "stdout")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.StdHandle(1, 1)")
                ReturnValue(1)
            }
        }
        cmp = StringCompare(name, "math")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp = StringCompare(attr, "pi")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                Gen_Emit("AIMacro.Math.Pi()")
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}