FixedPool.Token {
    "NUMBER": Initialize=1
    "STRING": Initialize=2
    "IDENTIFIER": Initialize=3
    "DEF": Initialize=10
    "END": Initialize=11
    "IF": Initialize=12
    "ELIF": Initialize=13
    "ELSE": Initialize=14
    "WHILE": Initialize=15
    "FOR": Initialize=16
    "IN": Initialize=17
    "RETURN": Initialize=18
    "PASS": Initialize=19
    "BREAK": Initialize=20
    "CONTINUE": Initialize=21
    "CLASS": Initialize=22
    "WITH": Initialize=23
    "AS": Initialize=24
    "EXCEPT": Initialize=25
    "FINALLY": Initialize=26
    "TRY": Initialize=27
    "RAISE": Initialize=28
    "TRUE": Initialize=30
    "FALSE": Initialize=31
    "NONE": Initialize=32
    "AND": Initialize=40
    "OR": Initialize=41
