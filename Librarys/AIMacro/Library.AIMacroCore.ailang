    "EOF": Initialize=101
    "COMMENT": Initialize=102
    "ERROR": Initialize=199
     "IMPORT": Initialize=200
    "FROM": Initialize=201
    "FSTRING": Initialize=202
    "FLOAT": Initialize=203
    "LAMBDA": Initialize=204
    "ASSERT": Initialize=205
      
}

