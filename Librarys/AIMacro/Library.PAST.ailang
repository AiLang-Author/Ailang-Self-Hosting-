LibraryImport.XArrays
LibraryImport.HashMap
LibraryImport.AIMacro.AIMacroString

PrintMessage("PAST Library Loaded (Python AST for AILANG)\n")

// ============================================================================
// NODE TYPE CONSTANTS - Match Python's ast module exactly
// ============================================================================

FixedPool.PAST {
    // Module level (1-4)
    "Module": Initialize=1
    "Interactive": Initialize=2
    "Expression": Initialize=3
    "FunctionType": Initialize=4
    
    // Statements (10-39)
    "FunctionDef": Initialize=10
    "AsyncFunctionDef": Initialize=11
    "ClassDef": Initialize=12
    "Return": Initialize=13
    "Delete": Initialize=14
    "Assign": Initialize=15
    "AugAssign": Initialize=16
    "AnnAssign": Initialize=17
    "For": Initialize=18
    "AsyncFor": Initialize=19
    "While": Initialize=20
    "If": Initialize=21
    "With": Initialize=22
    "AsyncWith": Initialize=23
    "Match": Initialize=24
    "Raise": Initialize=25
    "Try": Initialize=26
    "TryStar": Initialize=27
    "Assert": Initialize=28
    "Import": Initialize=29
    "ImportFrom": Initialize=30
    "Global": Initialize=31
    "Nonlocal": Initialize=32
    "Expr": Initialize=33
    "Pass": Initialize=34
    "Break": Initialize=35
    "Continue": Initialize=36
    
    // Expressions (40-69)
    "BoolOp": Initialize=40
    "NamedExpr": Initialize=41
    "BinOp": Initialize=42
    "UnaryOp": Initialize=43
    "Lambda": Initialize=44
    "IfExp": Initialize=45
    "Dict": Initialize=46
    "Set": Initialize=47
    "ListComp": Initialize=48
    "SetComp": Initialize=49
    "DictComp": Initialize=50
    "GeneratorExp": Initialize=51
    "Await": Initialize=52
    "Yield": Initialize=53
    "YieldFrom": Initialize=54
    "Compare": Initialize=55
    "Call": Initialize=56
    "FormattedValue": Initialize=57
    "JoinedStr": Initialize=58
    "Constant": Initialize=59
    "Attribute": Initialize=60
    "Subscript": Initialize=61
    "Starred": Initialize=62
    "Name": Initialize=63
    "List": Initialize=64
    "Tuple": Initialize=65
    "Slice": Initialize=66
    
    // Context (70-72)
    "Load": Initialize=70
    "Store": Initialize=71
    "Del": Initialize=72
    
    // Boolean operators (75-76)
    "And": Initialize=75
    "Or": Initialize=76
    
    // Binary operators (80-92)
    "Add": Initialize=80
    "Sub": Initialize=81
    "Mult": Initialize=82
    "MatMult": Initialize=83
    "Div": Initialize=84
    "Mod": Initialize=85
    "Pow": Initialize=86
    "LShift": Initialize=87
    "RShift": Initialize=88
    "BitOr": Initialize=89
    "BitXor": Initialize=90
    "BitAnd": Initialize=91
    "FloorDiv": Initialize=92
    
    // Unary operators (95-98)
    "Invert": Initialize=95
    "Not": Initialize=96
    "UAdd": Initialize=97
    "USub": Initialize=98
    
    // Comparison operators (100-109)
    "Eq": Initialize=100
    "NotEq": Initialize=101
    "Lt": Initialize=102
    "LtE": Initialize=103
    "Gt": Initialize=104
    "GtE": Initialize=105
    "Is": Initialize=106
    "IsNot": Initialize=107
    "In": Initialize=108
    "NotIn": Initialize=109
    
    // Other (115-131)
    "comprehension": Initialize=115
    "ExceptHandler": Initialize=120
    "arguments": Initialize=125
    "arg": Initialize=126
    "keyword": Initialize=127
    "alias": Initialize=130
    "withitem": Initialize=131
    
    // Constant types (160-165)
    "CONST_INT": Initialize=160
    "CONST_FLOAT": Initialize=161
    "CONST_STR": Initialize=162
    "CONST_BYTES": Initialize=163
    "CONST_BOOL": Initialize=164
    "CONST_NONE": Initialize=165
}

// ============================================================================
// CORE NODE FUNCTIONS
// ============================================================================

// Create a new AST node
Function.PAST.Node {
    Input: node_type: Integer
    Output: Address
    Body: {
        node = HashCreate(16)
        HashSet(node, "_type", node_type)
        HashSet(node, "_lineno", 0)
        HashSet(node, "_col", 0)
        HashSet(node, "_end_lineno", 0)
        HashSet(node, "_end_col", 0)
        ReturnValue(node)
    }
}

// Create node with location
Function.PAST.NodeAt {
    Input: node_type: Integer
    Input: line: Integer
    Input: col: Integer
    Output: Address
    Body: {
        node = PAST.Node(node_type)
        HashSet(node, "_lineno", line)
        HashSet(node, "_col", col)
        ReturnValue(node)
    }
}

// Get node type
Function.PAST.Type {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(HashGet(node, "_type"))
    }
}

// Get line number
Function.PAST.LineNo {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(HashGet(node, "_lineno"))
    }
}

// Get column
Function.PAST.ColOffset {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(HashGet(node, "_col"))
    }
}

// Set field
Function.PAST.SetField {
    Input: node: Address
    Input: field: Address
    Input: value: Address
    Body: {
        IfCondition NotEqual(node, 0) ThenBlock: {
            HashSet(node, field, value)
        }
    }
}

// Get field
Function.PAST.GetField {
    Input: node: Address
    Input: field: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(HashGet(node, field))
    }
}

// ============================================================================
// TYPE NAME LOOKUP
// ============================================================================

Function.PAST.TypeName {
    Input: node_type: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(node_type, PAST.Module) ThenBlock: { ReturnValue("Module") }
        IfCondition EqualTo(node_type, PAST.FunctionDef) ThenBlock: { ReturnValue("FunctionDef") }
        IfCondition EqualTo(node_type, PAST.AsyncFunctionDef) ThenBlock: { ReturnValue("AsyncFunctionDef") }
        IfCondition EqualTo(node_type, PAST.ClassDef) ThenBlock: { ReturnValue("ClassDef") }
        IfCondition EqualTo(node_type, PAST.Return) ThenBlock: { ReturnValue("Return") }
        IfCondition EqualTo(node_type, PAST.Delete) ThenBlock: { ReturnValue("Delete") }
        IfCondition EqualTo(node_type, PAST.Assign) ThenBlock: { ReturnValue("Assign") }
        IfCondition EqualTo(node_type, PAST.AugAssign) ThenBlock: { ReturnValue("AugAssign") }
        IfCondition EqualTo(node_type, PAST.For) ThenBlock: { ReturnValue("For") }
        IfCondition EqualTo(node_type, PAST.While) ThenBlock: { ReturnValue("While") }
        IfCondition EqualTo(node_type, PAST.If) ThenBlock: { ReturnValue("If") }
        IfCondition EqualTo(node_type, PAST.With) ThenBlock: { ReturnValue("With") }
        IfCondition EqualTo(node_type, PAST.Raise) ThenBlock: { ReturnValue("Raise") }
        IfCondition EqualTo(node_type, PAST.Try) ThenBlock: { ReturnValue("Try") }
        IfCondition EqualTo(node_type, PAST.Assert) ThenBlock: { ReturnValue("Assert") }
        IfCondition EqualTo(node_type, PAST.Import) ThenBlock: { ReturnValue("Import") }
        IfCondition EqualTo(node_type, PAST.ImportFrom) ThenBlock: { ReturnValue("ImportFrom") }
        IfCondition EqualTo(node_type, PAST.Global) ThenBlock: { ReturnValue("Global") }
        IfCondition EqualTo(node_type, PAST.Nonlocal) ThenBlock: { ReturnValue("Nonlocal") }
        IfCondition EqualTo(node_type, PAST.Expr) ThenBlock: { ReturnValue("Expr") }
        IfCondition EqualTo(node_type, PAST.Pass) ThenBlock: { ReturnValue("Pass") }
        IfCondition EqualTo(node_type, PAST.Break) ThenBlock: { ReturnValue("Break") }
        IfCondition EqualTo(node_type, PAST.Continue) ThenBlock: { ReturnValue("Continue") }
        IfCondition EqualTo(node_type, PAST.BoolOp) ThenBlock: { ReturnValue("BoolOp") }
        IfCondition EqualTo(node_type, PAST.BinOp) ThenBlock: { ReturnValue("BinOp") }
        IfCondition EqualTo(node_type, PAST.UnaryOp) ThenBlock: { ReturnValue("UnaryOp") }
        IfCondition EqualTo(node_type, PAST.Lambda) ThenBlock: { ReturnValue("Lambda") }
        IfCondition EqualTo(node_type, PAST.IfExp) ThenBlock: { ReturnValue("IfExp") }
        IfCondition EqualTo(node_type, PAST.Dict) ThenBlock: { ReturnValue("Dict") }
        IfCondition EqualTo(node_type, PAST.Set) ThenBlock: { ReturnValue("Set") }
        IfCondition EqualTo(node_type, PAST.ListComp) ThenBlock: { ReturnValue("ListComp") }
        IfCondition EqualTo(node_type, PAST.Compare) ThenBlock: { ReturnValue("Compare") }
        IfCondition EqualTo(node_type, PAST.Call) ThenBlock: { ReturnValue("Call") }
        IfCondition EqualTo(node_type, PAST.Constant) ThenBlock: { ReturnValue("Constant") }
        IfCondition EqualTo(node_type, PAST.Attribute) ThenBlock: { ReturnValue("Attribute") }
        IfCondition EqualTo(node_type, PAST.Subscript) ThenBlock: { ReturnValue("Subscript") }
        IfCondition EqualTo(node_type, PAST.Starred) ThenBlock: { ReturnValue("Starred") }
        IfCondition EqualTo(node_type, PAST.Name) ThenBlock: { ReturnValue("Name") }
        IfCondition EqualTo(node_type, PAST.List) ThenBlock: { ReturnValue("List") }
        IfCondition EqualTo(node_type, PAST.Tuple) ThenBlock: { ReturnValue("Tuple") }
        IfCondition EqualTo(node_type, PAST.Slice) ThenBlock: { ReturnValue("Slice") }
        IfCondition EqualTo(node_type, PAST.Add) ThenBlock: { ReturnValue("Add") }
        IfCondition EqualTo(node_type, PAST.Sub) ThenBlock: { ReturnValue("Sub") }
        IfCondition EqualTo(node_type, PAST.Mult) ThenBlock: { ReturnValue("Mult") }
        IfCondition EqualTo(node_type, PAST.Div) ThenBlock: { ReturnValue("Div") }
        IfCondition EqualTo(node_type, PAST.Mod) ThenBlock: { ReturnValue("Mod") }
        IfCondition EqualTo(node_type, PAST.Pow) ThenBlock: { ReturnValue("Pow") }
        IfCondition EqualTo(node_type, PAST.FloorDiv) ThenBlock: { ReturnValue("FloorDiv") }
        IfCondition EqualTo(node_type, PAST.And) ThenBlock: { ReturnValue("And") }
        IfCondition EqualTo(node_type, PAST.Or) ThenBlock: { ReturnValue("Or") }
        IfCondition EqualTo(node_type, PAST.Not) ThenBlock: { ReturnValue("Not") }
        IfCondition EqualTo(node_type, PAST.Eq) ThenBlock: { ReturnValue("Eq") }
        IfCondition EqualTo(node_type, PAST.NotEq) ThenBlock: { ReturnValue("NotEq") }
        IfCondition EqualTo(node_type, PAST.Lt) ThenBlock: { ReturnValue("Lt") }
        IfCondition EqualTo(node_type, PAST.LtE) ThenBlock: { ReturnValue("LtE") }
        IfCondition EqualTo(node_type, PAST.Gt) ThenBlock: { ReturnValue("Gt") }
        IfCondition EqualTo(node_type, PAST.GtE) ThenBlock: { ReturnValue("GtE") }
        IfCondition EqualTo(node_type, PAST.Is) ThenBlock: { ReturnValue("Is") }
        IfCondition EqualTo(node_type, PAST.IsNot) ThenBlock: { ReturnValue("IsNot") }
        IfCondition EqualTo(node_type, PAST.In) ThenBlock: { ReturnValue("In") }
        IfCondition EqualTo(node_type, PAST.NotIn) ThenBlock: { ReturnValue("NotIn") }
        IfCondition EqualTo(node_type, PAST.Load) ThenBlock: { ReturnValue("Load") }
        IfCondition EqualTo(node_type, PAST.Store) ThenBlock: { ReturnValue("Store") }
        IfCondition EqualTo(node_type, PAST.Del) ThenBlock: { ReturnValue("Del") }
        IfCondition EqualTo(node_type, PAST.arguments) ThenBlock: { ReturnValue("arguments") }
        IfCondition EqualTo(node_type, PAST.arg) ThenBlock: { ReturnValue("arg") }
        IfCondition EqualTo(node_type, PAST.keyword) ThenBlock: { ReturnValue("keyword") }
        IfCondition EqualTo(node_type, PAST.alias) ThenBlock: { ReturnValue("alias") }
        IfCondition EqualTo(node_type, PAST.ExceptHandler) ThenBlock: { ReturnValue("ExceptHandler") }
        ReturnValue("Unknown")
    }
}