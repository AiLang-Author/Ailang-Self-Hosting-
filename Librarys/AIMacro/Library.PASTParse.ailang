LibraryImport.XArrays
LibraryImport.HashMap
LibraryImport.AIMacro.AIMacroString
LibraryImport.AIMacro.AIMacroLexer
LibraryImport.AIMacro.PAST
LibraryImport.AIMacro.PASTNodes

// ============================================================================
// PARSER STATE
// ============================================================================

FixedPool.PASTParse {
    "pos": Initialize=0
    "count": Initialize=0
    "error": Initialize=0
    "error_line": Initialize=0
}

// ============================================================================
// TOKEN HELPERS
// ============================================================================

Function.PAST._Type {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(PASTParse.pos, PASTParse.count) ThenBlock: {
            ReturnValue(TokType.EOF)
        }
        ReturnValue(Lexer_GetTokenType(PASTParse.pos))
    }
}

Function.PAST._Val {
    Output: Address
    Body: {
        IfCondition GreaterEqual(PASTParse.pos, PASTParse.count) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Lexer_GetTokenValue(PASTParse.pos))
    }
}

Function.PAST._Line {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(PASTParse.pos, PASTParse.count) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Lexer_GetTokenLine(PASTParse.pos))
    }
}

Function.PAST._Adv {
    Body: {
        IfCondition LessThan(PASTParse.pos, PASTParse.count) ThenBlock: {
            PASTParse.pos = Add(PASTParse.pos, 1)
        }
    }
}

Function.PAST._Check {
    Input: tok: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(PAST._Type(), tok) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.PAST._Match {
    Input: tok: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(PAST._Check(tok), 1) ThenBlock: {
            PAST._Adv()
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.PAST._Skip {
    Body: {
        WhileLoop EqualTo(1, 1) {
            t = PAST._Type()
            IfCondition Or(EqualTo(t, TokType.NEWLINE), EqualTo(t, TokType.COMMENT)) ThenBlock: {
                PAST._Adv()
            } ElseBlock: {
                BreakLoop
            }
        }
    }
}

Function.PAST._Error {
    Input: msg: Address
    Body: {
        PASTParse.error = 1
        PASTParse.error_line = PAST._Line()
        PrintMessage("PAST Parse Error line ")
        PrintNumber(PASTParse.error_line)
        PrintMessage(": ")
        PrintMessage(msg)
        PrintMessage("\n")
    }
}

Function.PAST._CopyStr {
    Input: str: Address
    Output: Address
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: {
            ReturnValue(0)
        }
        len = StringLength(str)
        copy = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            SetByte(copy, i, GetByte(str, i))
            i = Add(i, 1)
        }
        SetByte(copy, len, 0)
        ReturnValue(copy)
    }
}

// ============================================================================
// MAIN PARSE ENTRY
// ============================================================================

Function.PAST.Parse {
    Input: source: Address
    Output: Address
    Body: {
        // Tokenize using AIMacroLexer
        len = StringLength(source)
        Lexer_Init(source, len)
        count = Lexer_Tokenize()
        
        IfCondition EqualTo(count, 0) ThenBlock: {
            Lexer_Cleanup()
            ReturnValue(0)
        }
        
        // Init parser state
        PASTParse.pos = 0
        PASTParse.count = count
        PASTParse.error = 0
        
        // Parse module
        module = PAST._ParseModule()
        
        Lexer_Cleanup()
        
        IfCondition EqualTo(PASTParse.error, 1) ThenBlock: {
            ReturnValue(0)
        }
        
        ReturnValue(module)
    }
}

// ============================================================================
// GRAMMAR RULES
// ============================================================================

Function.PAST._ParseModule {
    Output: Address
    Body: {
        body = XArray.XCreate(32)
        PAST._Skip()
        
        WhileLoop NotEqual(PAST._Type(), TokType.EOF) {
            stmt = PAST._ParseStmt()
            IfCondition NotEqual(stmt, 0) ThenBlock: {
                XArray.XPush(body, stmt)
            }
            IfCondition EqualTo(PASTParse.error, 1) ThenBlock: {
                BreakLoop
            }
            PAST._Skip()
        }
        
        ReturnValue(PAST.Module(body))
    }
}

Function.PAST._ParseStmt {
    Output: Address
    Body: {
        PAST._Skip()
        t = PAST._Type()
        line = PAST._Line()
        
        // def
        IfCondition EqualTo(t, TokType.DEF) ThenBlock: {
            ReturnValue(PAST._ParseFuncDef())
        }
        
        // class (check identifier == "class")
        IfCondition EqualTo(t, TokType.IDENTIFIER) ThenBlock: {
            val = PAST._Val()
            cmp = StringCompare(val, "class")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(PAST._ParseClassDef())
            }
        }
        
        // if
        IfCondition EqualTo(t, TokType.IF) ThenBlock: {
            ReturnValue(PAST._ParseIf())
        }
        
        // while
        IfCondition EqualTo(t, TokType.WHILE) ThenBlock: {
            ReturnValue(PAST._ParseWhile())
        }
        
        // for
        IfCondition EqualTo(t, TokType.FOR) ThenBlock: {
            ReturnValue(PAST._ParseFor())
        }
        
        // return
        IfCondition EqualTo(t, TokType.RETURN) ThenBlock: {
            PAST._Adv()
            value = 0
            nt = PAST._Type()
            IfCondition And(NotEqual(nt, TokType.NEWLINE), NotEqual(nt, TokType.EOF)) ThenBlock: {
                value = PAST._ParseExpr()
            }
            node = PAST.Return(value)
            HashMap.HSet(node, "_lineno", line)
            ReturnValue(node)
        }
        
        // pass
        IfCondition EqualTo(t, TokType.PASS) ThenBlock: {
            PAST._Adv()
            node = PAST.PassNode()
            HashMap.HSet(node, "_lineno", line)
            ReturnValue(node)
        }
        
        // break
        IfCondition EqualTo(t, TokType.BREAK) ThenBlock: {
            PAST._Adv()
            node = PAST.BreakNode()
            HashMap.HSet(node, "_lineno", line)
            ReturnValue(node)
        }
        
        // continue
        IfCondition EqualTo(t, TokType.CONTINUE) ThenBlock: {
            PAST._Adv()
            node = PAST.ContinueNode()
            HashMap.HSet(node, "_lineno", line)
            ReturnValue(node)
        }
        
        // end (skip for AIMacro compat)
        IfCondition EqualTo(t, TokType.END) ThenBlock: {
            PAST._Adv()
            ReturnValue(0)
        }
        
        // try
        IfCondition EqualTo(t, TokType.TRY) ThenBlock: {
            ReturnValue(PAST._ParseTry())
        }
        
        // Expression or assignment
        ReturnValue(PAST._ParseExprOrAssign())
    }
}

Function.PAST._ParseFuncDef {
    Output: Address
    Body: {
        line = PAST._Line()
        PAST._Adv()  // consume 'def'
        
        // Function name
        name = PAST._CopyStr(PAST._Val())
        PAST._Adv()
        
        // Parameters
        PAST._Match(TokType.LPAREN)
        args = PAST._ParseParams()
        PAST._Match(TokType.RPAREN)
        
        // Colon
        PAST._Match(TokType.COLON)
        PAST._Skip()
        
        // Body
        body = PAST._ParseBlock()
        
        node = PAST.FunctionDef(name, args, body)
        HashMap.HSet(node, "_lineno", line)
        ReturnValue(node)
    }
}

Function.PAST._ParseClassDef {
    Output: Address
    Body: {
        line = PAST._Line()
        PAST._Adv()  // consume 'class'
        
        name = PAST._CopyStr(PAST._Val())
        PAST._Adv()
        
        // Optional bases
        bases = XArray.XCreate(4)
        IfCondition EqualTo(PAST._Check(TokType.LPAREN), 1) ThenBlock: {
            PAST._Adv()
            WhileLoop NotEqual(PAST._Check(TokType.RPAREN), 1) {
                base = PAST._ParseExpr()
                XArray.XPush(bases, base)
                PAST._Match(TokType.COMMA)
            }
            PAST._Match(TokType.RPAREN)
        }
        
        PAST._Match(TokType.COLON)
        PAST._Skip()
        
        body = PAST._ParseBlock()
        
        node = PAST.ClassDef(name, bases, body)
        HashMap.HSet(node, "_lineno", line)
        ReturnValue(node)
    }
}

Function.PAST._ParseParams {
    Output: Address
    Body: {
        args_node = PAST.Arguments()
        args_list = HashMap.HGet(args_node, "args")
        
        WhileLoop NotEqual(PAST._Check(TokType.RPAREN), 1)