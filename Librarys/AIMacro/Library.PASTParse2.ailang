LibraryImport.Arrays
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroLexer
LibraryImport.AIMacro.PAST
LibraryImport.AIMacro.PASTNodes

// ============================================================================
// CONTROL FLOW PARSING
// ============================================================================

Function.PAST._ParseIf {
    Output: Address
    Body: {
        line = PAST._Line()
        PAST._Adv()  // consume 'if'
        
        test = PAST._ParseExpr()
        PAST._Match(TokType.COLON)
        PAST._Skip()
        
        body = PAST._ParseBlock()
        orelse = Array.Create(4)
        
        PAST._Skip()
        
        // elif chains
        WhileLoop EqualTo(PAST._Check(TokType.ELIF), 1) {
            elif_node = PAST._ParseElif()
            Array.Push(orelse, elif_node)
            orelse = Array.Create(4)  // New orelse for next level
            Hash.HSet(elif_node, "orelse", orelse)
        }
        
        // else
        IfCondition EqualTo(PAST._Check(TokType.ELSE), 1) ThenBlock: {
            PAST._Adv()
            PAST._Match(TokType.COLON)
            PAST._Skip()
            else_body = PAST._ParseBlock()
            // Add else body to current orelse
            n = Array.Size(else_body)
            i = 0
            WhileLoop LessThan(i, n) {
                stmt = Array.Get(else_body, i)
                Array.Push(orelse, stmt)
                i = Add(i, 1)
            }
        }
        
        node = PAST.If(test, body, orelse)
        Hash.HSet(node, "_lineno", line)
        ReturnValue(node)
    }
}

Function.PAST._ParseElif {
    Output: Address
    Body: {
        line = PAST._Line()
        PAST._Adv()  // consume 'elif'
        
        test = PAST._ParseExpr()
        PAST._Match(TokType.COLON)
        PAST._Skip()
        
        body = PAST._ParseBlock()
        orelse = Array.Create(4)
        
        node = PAST.If(test, body, orelse)
        Hash.HSet(node, "_lineno", line)
        ReturnValue(node)
    }
}

Function.PAST._ParseWhile {
    Output: Address
    Body: {
        line = PAST._Line()
        PAST._Adv()
        
        test = PAST._ParseExpr()
        PAST._Match(TokType.COLON)
        PAST._Skip()
        
        body = PAST._ParseBlock()
        orelse = Array.Create(2)
        
        node = PAST.While(test, body, orelse)
        Hash.HSet(node, "_lineno", line)
        ReturnValue(node)
    }
}

Function.PAST._ParseFor {
    Output: Address
    Body: {
        line = PAST._Line()
        PAST._Adv()
        
        // Target
        target = PAST._ParsePrimary()
        
        // 'in'
        PAST._Match(TokType.IN)
        
        // Iterator
        iter = PAST._ParseExpr()
        
        PAST._Match(TokType.COLON)
        PAST._Skip()
        
        body = PAST._ParseBlock()
        orelse = Array.Create(2)
        
        node = PAST.For(target, iter, body, orelse)
        Hash.HSet(node, "_lineno", line)
        ReturnValue(node)
    }
}

Function.PAST._ParseTry {
    Output: Address
    Body: {
        line = PAST._Line()
        PAST._Adv()  // consume 'try'
        
        PAST._Match(TokType.COLON)
        PAST._Skip()
        
        body = PAST._ParseBlock()
        handlers = Array.Create(4)
        orelse = Array.Create(2)
        finalbody = Array.Create(2)
        
        PAST._Skip()
        
        // except handlers
        WhileLoop EqualTo(PAST._Check(TokType.EXCEPT), 1) {
            handler = PAST._ParseExceptHandler()
            Array.Push(handlers, handler)
            PAST._Skip()
        }
        
        // else
        IfCondition EqualTo(PAST._Check(TokType.ELSE), 1) ThenBlock: {
            PAST._Adv()
            PAST._Match(TokType.COLON)
            PAST._Skip()
            orelse = PAST._ParseBlock()
        }
        
        // finally
        IfCondition EqualTo(PAST._Check(TokType.FINALLY), 1) ThenBlock: {
            PAST._Adv()
            PAST._Match(TokType.COLON)
            PAST._Skip()
            finalbody = PAST._ParseBlock()
        }
        
        node = PAST.Try(body, handlers, orelse, finalbody)
        Hash.HSet(node, "_lineno", line)
        ReturnValue(node)
    }
}

Function.PAST._ParseExceptHandler {
    Output: Address
    Body: {
        line = PAST._Line()
        PAST._Adv()  // consume 'except'
        
        exc_type = 0
        name = 0
        
        // Optional exception type
        IfCondition NotEqual(PAST._Check(TokType.COLON), 1) ThenBlock: {
            exc_type = PAST._ParseExpr()
            
            // Optional 'as name'
            IfCondition EqualTo(PAST._Check(TokType.IDENTIFIER), 1) ThenBlock: {
                val = PAST._Val()
                cmp = StringCompare(val, "as")
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    PAST._Adv()
                    name = PAST._CopyStr(PAST._Val())
                    PAST._Adv()
                }
            }
        }
        
        PAST._Match(TokType.COLON)
        PAST._Skip()
        
        body = PAST._ParseBlock()
        
        node = PAST.ExceptHandler(exc_type, name, body)
        Hash.HSet(node, "_lineno", line)
        ReturnValue(node)
    }
}

Function.PAST._ParseBlock {
    Output: Address
    Body: {
        stmts = Array.Create(16)
        
        WhileLoop EqualTo(1, 1) {
            PAST._Skip()
            t = PAST._Type()
            
            // End of block markers
            IfCondition EqualTo(t, TokType.EOF) ThenBlock: { BreakLoop }
            IfCondition EqualTo(t, TokType.END) ThenBlock: { 
                PAST._Adv()
                BreakLoop 
            }
            IfCondition EqualTo(t, TokType.ELIF) ThenBlock: { BreakLoop }
            IfCondition EqualTo(t, TokType.ELSE) ThenBlock: { BreakLoop }
            IfCondition EqualTo(t, TokType.EXCEPT) ThenBlock: { BreakLoop }
            IfCondition EqualTo(t, TokType.FINALLY) ThenBlock: { BreakLoop }
            
            stmt = PAST._ParseStmt()
            IfCondition NotEqual(stmt, 0) ThenBlock: {
                Array.Push(stmts, stmt)
            }
            
            IfCondition EqualTo(PASTParse.error, 1) ThenBlock: {
                BreakLoop
            }
        }
        
        ReturnValue(stmts)
    }
}

// ============================================================================
// EXPRESSION / ASSIGNMENT PARSING
// ============================================================================

Function.PAST._ParseExprOrAssign {
    Output: Address
    Body: {
        line = PAST._Line()
        left = PAST._ParseExpr()
        
        // Check for assignment
        IfCondition EqualTo(PAST._Check(TokType.ASSIGN), 1) ThenBlock: {
            PAST._Adv()
            value = PAST._ParseExpr()
            targets = Array.Create(2)
            Array.Push(targets, left)
            node = PAST.Assign(targets, value)
            Hash.HSet(node, "_lineno", line)
            ReturnValue(node)
        }
        
        // Augmented assignment
        t = PAST._Type()
        IfCondition EqualTo(t, TokType.PLUS_ASSIGN) ThenBlock: {
            PAST._Adv()
            value = PAST._ParseExpr()
            node = PAST.AugAssign(left, PAST.Add, value)
            Hash.HSet(node, "_lineno", line)
            ReturnValue(node)
        }
        IfCondition EqualTo(t, TokType.MINUS_ASSIGN) ThenBlock: {
            PAST._Adv()
            value = PAST._ParseExpr()
            node = PAST.AugAssign(left, PAST.Sub, value)
            Hash.HSet(node, "_lineno", line)
            ReturnValue(node)
        }
        IfCondition EqualTo(t, TokType.MUL_ASSIGN) ThenBlock: {
            PAST._Adv()
            value = PAST._ParseExpr()
            node = PAST.AugAssign(left, PAST.Mult, value)
            Hash.HSet(node, "_lineno", line)
            ReturnValue(node)
        }
        IfCondition EqualTo(t, TokType.DIV_ASSIGN) ThenBlock: {
            PAST._Adv()
            value = PAST._ParseExpr()
            node = PAST.AugAssign(left, PAST.Div, value)
            Hash.HSet(node, "_lineno", line)
            ReturnValue(node)
        }
        
        // Expression statement
        node = PAST.ExprStmt(left)
        Hash.HSet(node, "_lineno", line)
        ReturnValue(node)
    }
}

Function.PAST._ParseExpr {
    Output: Address
    Body: {
        ReturnValue(PAST._ParseOr())
    }
}

Function.PAST._ParseOr {
    Output: Address
    Body: {
        left = PAST._ParseAnd()
        
        WhileLoop EqualTo(PAST._Check(TokType.OR), 1) {
            PAST._Adv()
            right = PAST._ParseAnd()
            values = Array.Create(2)
            Array.Push(values, left)
            Array.Push(values, right)
            left = PAST.BoolOp(PAST.Or, values)
        }
        
        ReturnValue(left)
    }
}

Function.PAST._ParseAnd {
    Output: Address
    Body: {
        left = PAST._ParseNot()
        
        WhileLoop EqualTo(PAST._Check(TokType.AND), 1) {
            PAST._Adv()
            right = PAST._ParseNot()
            values = Array.Create(2)
            Array.Push(values, left)
            Array.Push(values, right)
            left = PAST.BoolOp(PAST.And, values)
        }
        
        ReturnValue(left)
    }
}

Function.PAST._ParseNot {
    Output: Address
    Body: {
        IfCondition EqualTo(PAST._Check(TokType.NOT), 1) ThenBlock: {
            PAST._Adv()
            operand = PAST._ParseNot()
            ReturnValue(PAST.UnaryOp(PAST.Not, operand))
        }
        ReturnValue(PAST._ParseComparison())
    }
}

Function.PAST._ParseComparison {
    Output: Address
    Body: {
        left = PAST._ParseAddition()
        
        ops = Array.Create(4)
        comparators = Array.Create(4)
        
        WhileLoop EqualTo(1, 1) {
            t = PAST._Type()
            op = 0
            
            IfCondition EqualTo(t, TokType.EQUAL) ThenBlock: { op = PAST.Eq }
            IfCondition EqualTo(t, TokType.NOT_EQUAL) ThenBlock: { op = PAST.NotEq }
            IfCondition EqualTo(t, TokType.LESS) ThenBlock: { op = PAST.Lt }
            IfCondition EqualTo(t, TokType.LESS_EQ) ThenBlock: { op = PAST.LtE }
            IfCondition EqualTo(t, TokType.GREATER) ThenBlock: { op = PAST.Gt }
            IfCondition EqualTo(t, TokType.GREATER_EQ) ThenBlock: { op = PAST.GtE }
            IfCondition EqualTo(t, TokType.IN) ThenBlock: { op = PAST.In }
            IfCondition EqualTo(t, TokType.IS) ThenBlock: { op = PAST.Is }
            
            IfCondition EqualTo(op, 0) ThenBlock: {
                BreakLoop
            }
            
            PAST._Adv()
            
            // Check for 'not' after 'is'
            IfCondition EqualTo(op, PAST.Is) ThenBlock: {
                IfCondition EqualTo(PAST._Check(TokType.NOT), 1) ThenBlock: {
                    PAST._Adv()
                    op = PAST.IsNot
                }
            }
            
            // Check for 'in' after 'not'
            IfCondition EqualTo(op, PAST.Not) ThenBlock: {
                IfCondition EqualTo(PAST._Check(TokType.IN), 1) ThenBlock: {
                    PAST._Adv()
                    op = PAST.NotIn
                }
            }
            
            right = PAST._ParseAddition()
            Array.Push(ops, op)
            Array.Push(comparators, right)
        }
        
        // If no comparisons, return left
        IfCondition EqualTo(Array.Size(ops), 0) ThenBlock: {
            Array.Destroy(ops)
            Array.Destroy(comparators)
            ReturnValue(left)
        }
        
        ReturnValue(PAST.Compare(left, ops, comparators))
    }
}

Function.PAST._ParseAddition {
    Output: Address
    Body: {
        left = PAST._ParseMultiplication()
        
        WhileLoop EqualTo(1, 1) {
            t = PAST._Type()
            op = 0
            
            IfCondition EqualTo(t, TokType.PLUS) ThenBlock: { op = PAST.Add }
            IfCondition EqualTo(t, TokType.MINUS) ThenBlock: { op = PAST.Sub }
            
            IfCondition EqualTo(op, 0) ThenBlock: {
                BreakLoop
            }
            
            PAST._Adv()
            right = PAST._ParseMultiplication()
            left = PAST.BinOp(left, op, right)
        }
        
        ReturnValue(left)
    }
}

Function.PAST._ParseMultiplication {
    Output: Address
    Body: {
        left = PAST._ParseUnary()
        
        WhileLoop EqualTo(1, 1) {
            t = PAST._Type()
            op = 0
            
            IfCondition EqualTo(t, TokType.MULTIPLY) ThenBlock: { op = PAST.Mult }
            IfCondition EqualTo(t, TokType.DIVIDE) ThenBlock: { op = PAST.Div }
            IfCondition EqualTo(t, TokType.MODULO) ThenBlock: { op = PAST.Mod }
            IfCondition EqualTo(t, TokType.FLOOR_DIV) ThenBlock: { op = PAST.FloorDiv }
            
            IfCondition EqualTo(op, 0) ThenBlock: {
                BreakLoop
            }
            
            PAST._Adv()
            right = PAST._ParseUnary()
            left = PAST.BinOp(left, op, right)
        }
        
        ReturnValue(left)
    }
}

Function.PAST._ParseUnary {
    Output: Address
    Body: {
        t = PAST._Type()
        
        IfCondition EqualTo(t, TokType.MINUS) ThenBlock: {
            PAST._Adv()
            operand = PAST._ParseUnary()
            ReturnValue(PAST.UnaryOp(PAST.USub, operand))
        }
        
        IfCondition EqualTo(t, TokType.PLUS) ThenBlock: {
            PAST._Adv()
            operand = PAST._ParseUnary()
            ReturnValue(PAST.UnaryOp(PAST.UAdd, operand))
        }
        
        ReturnValue(PAST._ParsePower())
    }
}

Function.PAST._ParsePower {
    Output: Address
    Body: {
        left = PAST._ParsePostfix()
        
        IfCondition EqualTo(PAST._Check(TokType.POWER), 1) ThenBlock: {
            PAST._Adv()
            right = PAST._ParseUnary()
            ReturnValue(PAST.BinOp(left, PAST.Pow, right))
        }
        
        ReturnValue(left)
    }
}