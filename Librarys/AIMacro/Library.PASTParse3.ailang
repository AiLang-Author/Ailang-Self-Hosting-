LibraryImport.XArrays
LibraryImport.HashMap
LibraryImport.AIMacro.AIMacroLexer
LibraryImport.AIMacro.PAST
LibraryImport.AIMacro.PASTNodes

// ============================================================================
// POSTFIX EXPRESSIONS (calls, subscripts, attributes)
// ============================================================================

Function.PAST._ParsePostfix {
    Output: Address
    Body: {
        left = PAST._ParsePrimary()
        
        WhileLoop EqualTo(1, 1) {
            // Function call
            IfCondition EqualTo(PAST._Check(TokType.LPAREN), 1) ThenBlock: {
                PAST._Adv()
                args = PAST._ParseArgs()
                PAST._Match(TokType.RPAREN)
                left = PAST.Call(left, args, XArray.XCreate(2))
            } ElseBlock: {
                // Subscript
                IfCondition EqualTo(PAST._Check(TokType.LBRACKET), 1) ThenBlock: {
                    PAST._Adv()
                    slice = PAST._ParseSlice()
                    PAST._Match(TokType.RBRACKET)
                    left = PAST.Subscript(left, slice, PAST.Load)
                } ElseBlock: {
                    // Attribute
                    IfCondition EqualTo(PAST._Check(TokType.DOT), 1) ThenBlock: {
                        PAST._Adv()
                        attr = PAST._CopyStr(PAST._Val())
                        PAST._Adv()
                        left = PAST.Attribute(left, attr, PAST.Load)
                    } ElseBlock: {
                        BreakLoop
                    }
                }
            }
        }
        
        ReturnValue(left)
    }
}

Function.PAST._ParseArgs {
    Output: Address
    Body: {
        args = XArray.XCreate(8)
        
        IfCondition EqualTo(PAST._Check(TokType.RPAREN), 1) ThenBlock: {
            ReturnValue(args)
        }
        
        // First arg
        arg = PAST._ParseExpr()
        XArray.XPush(args, arg)
        
        // Rest of args
        WhileLoop EqualTo(PAST._Match(TokType.COMMA), 1) {
            IfCondition EqualTo(PAST._Check(TokType.RPAREN), 1) ThenBlock: {
                BreakLoop
            }
            arg = PAST._ParseExpr()
            XArray.XPush(args, arg)
        }
        
        ReturnValue(args)
    }
}

Function.PAST._ParseSlice {
    Output: Address
    Body: {
        lower = 0
        upper = 0
        step = 0
        is_slice = 0
        
        // Check if starts with colon
        IfCondition NotEqual(PAST._Check(TokType.COLON), 1) ThenBlock: {
            lower = PAST._ParseExpr()
        }
        
        // First colon
        IfCondition EqualTo(PAST._Check(TokType.COLON), 1) ThenBlock: {
            PAST._Adv()
            is_slice = 1
            
            // Upper bound
            IfCondition And(NotEqual(PAST._Check(TokType.COLON), 1), NotEqual(PAST._Check(TokType.RBRACKET), 1)) ThenBlock: {
                upper = PAST._ParseExpr()
            }
            
            // Second colon (step)
            IfCondition EqualTo(PAST._Check(TokType.COLON), 1) ThenBlock: {
                PAST._Adv()
                IfCondition NotEqual(PAST._Check(TokType.RBRACKET), 1) ThenBlock: {
                    step = PAST._ParseExpr()
                }
            }
        }
        
        IfCondition EqualTo(is_slice, 1) ThenBlock: {
            ReturnValue(PAST.Slice(lower, upper, step))
        }
        
        // Simple index
        ReturnValue(lower)
    }
}

// ============================================================================
// PRIMARY EXPRESSIONS
// ============================================================================

Function.PAST._ParsePrimary {
    Output: Address
    Body: {
        t = PAST._Type()
        line = PAST._Line()
        
        // Number
        IfCondition EqualTo(t, TokType.NUMBER) ThenBlock: {
            val = PAST._Val()
            num = StringToNumber(val)
            PAST._Adv()
            node = PAST.Constant(num, PAST.CONST_INT)
            HashSet(node, "_lineno", line)
            ReturnValue(node)
        }
        
        // String
        IfCondition EqualTo(t, TokType.STRING) ThenBlock: {
            val = PAST._CopyStr(PAST._Val())
            PAST._Adv()
            node = PAST.Constant(val, PAST.CONST_STR)
            HashSet(node, "_lineno", line)
            ReturnValue(node)
        }
        
        // True
        IfCondition EqualTo(t, TokType.TRUE) ThenBlock: {
            PAST._Adv()
            node = PAST.Constant(1, PAST.CONST_BOOL)
            HashSet(node, "_lineno", line)
            ReturnValue(node)
        }
        
        // False
        IfCondition EqualTo(t, TokType.FALSE) ThenBlock: {
            PAST._Adv()
            node = PAST.Constant(0, PAST.CONST_BOOL)
            HashSet(node, "_lineno", line)
            ReturnValue(node)
        }
        
        // None
        IfCondition EqualTo(t, TokType.NONE) ThenBlock: {
            PAST._Adv()
            node = PAST.Constant(0, PAST.CONST_NONE)
            HashSet(node, "_lineno", line)
            ReturnValue(node)
        }
        
        // Identifier
        IfCondition EqualTo(t, TokType.IDENTIFIER) ThenBlock: {
            name = PAST._CopyStr(PAST._Val())
            PAST._Adv()
            node = PAST.Name(name, PAST.Load)
            HashSet(node, "_lineno", line)
            ReturnValue(node)
        }
        
        // Parenthesized expression or tuple
        IfCondition EqualTo(t, TokType.LPAREN) ThenBlock: {
            PAST._Adv()
            
            // Empty tuple
            IfCondition EqualTo(PAST._Check(TokType.RPAREN), 1) ThenBlock: {
                PAST._Adv()
                ReturnValue(PAST.TupleNode(XArray.XCreate(1), PAST.Load))
            }
            
            first = PAST._ParseExpr()
            
            // Tuple with comma
            IfCondition EqualTo(PAST._Check(TokType.COMMA), 1) ThenBlock: {
                elts = XArray.XCreate(4)
                XArray.XPush(elts, first)
                
                WhileLoop EqualTo(PAST._Match(TokType.COMMA), 1) {
                    IfCondition EqualTo(PAST._Check(TokType.RPAREN), 1) ThenBlock: {
                        BreakLoop
                    }
                    elt = PAST._ParseExpr()
                    XArray.XPush(elts, elt)
                }
                
                PAST._Match(TokType.RPAREN)
                ReturnValue(PAST.TupleNode(elts, PAST.Load))
            }
            
            // Just parenthesized
            PAST._Match(TokType.RPAREN)
            ReturnValue(first)
        }
        
        // List
        IfCondition EqualTo(t, TokType.LBRACKET) ThenBlock: {
            PAST._Adv()
            elts = XArray.XCreate(8)
            
            IfCondition NotEqual(PAST._Check(TokType.RBRACKET), 1) ThenBlock: {
                elt = PAST._ParseExpr()
                XArray.XPush(elts, elt)
                
                WhileLoop EqualTo(PAST._Match(TokType.COMMA), 1) {
                    IfCondition EqualTo(PAST._Check(TokType.RBRACKET), 1) ThenBlock: {
                        BreakLoop
                    }
                    elt = PAST._ParseExpr()
                    XArray.XPush(elts, elt)
                }
            }
            
            PAST._Match(TokType.RBRACKET)
            node = PAST.ListNode(elts, PAST.Load)
            HashSet(node, "_lineno", line)
            ReturnValue(node)
        }
        
        // Dict
        IfCondition EqualTo(t, TokType.LBRACE) ThenBlock: {
            PAST._Adv()
            keys = XArray.XCreate(8)
            values = XArray.XCreate(8)
            
            IfCondition NotEqual(PAST._Check(TokType.RBRACE), 1) ThenBlock: {
                key = PAST._ParseExpr()
                PAST._Match(TokType.COLON)
                val = PAST._ParseExpr()
                XArray.XPush(keys, key)
                XArray.XPush(values, val)
                
                WhileLoop EqualTo(PAST._Match(TokType.COMMA), 1) {
                    IfCondition EqualTo(PAST._Check(TokType.RBRACE), 1) ThenBlock: {
                        BreakLoop
                    }
                    key = PAST._ParseExpr()
                    PAST._Match(TokType.COLON)
                    val = PAST._ParseExpr()
                    XArray.XPush(keys, key)
                    XArray.XPush(values, val)
                }
            }
            
            PAST._Match(TokType.RBRACE)
            node = PAST.DictNode(keys, values)
            HashSet(node, "_lineno", line)
            ReturnValue(node)
        }
        
        // Error
        PAST._Error("Unexpected token in expression")
        ReturnValue(0)
    }
}