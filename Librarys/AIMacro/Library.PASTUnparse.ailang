LibraryImport.Arrays
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroString
LibraryImport.AIMacro.PAST
LibraryImport.AIMacro.PASTNodes

// ============================================================================
// UNPARSER STATE
// ============================================================================

FixedPool.PASTUnp {
    "buf": Initialize=0
    "pos": Initialize=0
    "cap": Initialize=0
    "indent": Initialize=0
}

// ============================================================================
// MAIN ENTRY
// ============================================================================

Function.PAST.Unparse {
    Input: node: Address
    Output: Address
    Body: {
        // Allocate buffer
        PASTUnp.cap = 8192
        PASTUnp.buf = Allocate(PASTUnp.cap)
        PASTUnp.pos = 0
        PASTUnp.indent = 0
        
        PAST._UnparseNode(node)
        
        // Null terminate
        SetByte(PASTUnp.buf, PASTUnp.pos, 0)
        
        ReturnValue(PASTUnp.buf)
    }
}

// ============================================================================
// OUTPUT HELPERS
// ============================================================================

Function.PAST._Emit {
    Input: str: Address
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: {
            ReturnValue(0)
        }
        len = StringLength(str)
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(str, i)
            SetByte(PASTUnp.buf, PASTUnp.pos, c)
            PASTUnp.pos = Add(PASTUnp.pos, 1)
            i = Add(i, 1)
        }
    }
}

Function.PAST._EmitChar {
    Input: c: Integer
    Body: {
        SetByte(PASTUnp.buf, PASTUnp.pos, c)
        PASTUnp.pos = Add(PASTUnp.pos, 1)
    }
}

Function.PAST._EmitNum {
    Input: n: Integer
    Body: {
        str = NumberToString(n)
        PAST._Emit(str)
        Deallocate(str, 0)
    }
}

Function.PAST._EmitIndent {
    Body: {
        i = 0
        WhileLoop LessThan(i, PASTUnp.indent) {
            PAST._Emit("    ")
            i = Add(i, 1)
        }
    }
}

Function.PAST._EmitLine {
    Input: str: Address
    Body: {
        PAST._EmitIndent()
        PAST._Emit(str)
        PAST._EmitChar(10)
    }
}

// ============================================================================
// NODE UNPARSING
// ============================================================================

Function.PAST._UnparseNode {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        t = PAST.Type(node)
        
        // Module
        IfCondition EqualTo(t, PAST.Module) ThenBlock: {
            body = Hash.HGet(node, "body")
            PAST._UnparseBody(body)
            ReturnValue(0)
        }
        
        // FunctionDef
        IfCondition EqualTo(t, PAST.FunctionDef) ThenBlock: {
            PAST._UnparseFuncDef(node)
            ReturnValue(0)
        }
        
        // ClassDef
        IfCondition EqualTo(t, PAST.ClassDef) ThenBlock: {
            PAST._UnparseClassDef(node)
            ReturnValue(0)
        }
        
        // If
        IfCondition EqualTo(t, PAST.If) ThenBlock: {
            PAST._UnparseIf(node)
            ReturnValue(0)
        }
        
        // While
        IfCondition EqualTo(t, PAST.While) ThenBlock: {
            PAST._UnparseWhile(node)
            ReturnValue(0)
        }
        
        // For
        IfCondition EqualTo(t, PAST.For) ThenBlock: {
            PAST._UnparseFor(node)
            ReturnValue(0)
        }
        
        // Return
        IfCondition EqualTo(t, PAST.Return) ThenBlock: {
            PAST._EmitIndent()
            PAST._Emit("return")
            value = Hash.HGet(node, "value")
            IfCondition NotEqual(value, 0) ThenBlock: {
                PAST._Emit(" ")
                PAST._UnparseExpr(value)
            }
            PAST._EmitChar(10)
            ReturnValue(0)
        }
        
        // Assign
        IfCondition EqualTo(t, PAST.Assign) ThenBlock: {
            PAST._EmitIndent()
            targets = Hash.HGet(node, "targets")
            n = Array.Size(targets)
            i = 0
            WhileLoop LessThan(i, n) {
                target = Array.Get(targets, i)
                PAST._UnparseExpr(target)
                PAST._Emit(" = ")
                i = Add(i, 1)
            }
            PAST._UnparseExpr(Hash.HGet(node, "value"))
            PAST._EmitChar(10)
            ReturnValue(0)
        }
        
        // AugAssign
        IfCondition EqualTo(t, PAST.AugAssign) ThenBlock: {
            PAST._EmitIndent()
            PAST._UnparseExpr(Hash.HGet(node, "target"))
            op = Hash.HGet(node, "op")
            IfCondition EqualTo(op, PAST.Add) ThenBlock: { PAST._Emit(" += ") }
            IfCondition EqualTo(op, PAST.Sub) ThenBlock: { PAST._Emit(" -= ") }
            IfCondition EqualTo(op, PAST.Mult) ThenBlock: { PAST._Emit(" *= ") }
            IfCondition EqualTo(op, PAST.Div) ThenBlock: { PAST._Emit(" /= ") }
            PAST._UnparseExpr(Hash.HGet(node, "value"))
            PAST._EmitChar(10)
            ReturnValue(0)
        }
        
        // Expr (expression statement)
        IfCondition EqualTo(t, PAST.Expr) ThenBlock: {
            PAST._EmitIndent()
            PAST._UnparseExpr(Hash.HGet(node, "value"))
            PAST._EmitChar(10)
            ReturnValue(0)
        }
        
        // Pass
        IfCondition EqualTo(t, PAST.Pass) ThenBlock: {
            PAST._EmitLine("pass")
            ReturnValue(0)
        }
        
        // Break
        IfCondition EqualTo(t, PAST.Break) ThenBlock: {
            PAST._EmitLine("break")
            ReturnValue(0)
        }
        
        // Continue
        IfCondition EqualTo(t, PAST.Continue) ThenBlock: {
            PAST._EmitLine("continue")
            ReturnValue(0)
        }
        
        // Try
        IfCondition EqualTo(t, PAST.Try) ThenBlock: {
            PAST._UnparseTry(node)
            ReturnValue(0)
        }
    }
}

Function.PAST._UnparseBody {
    Input: body: Address
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Array.Size(body)
        i = 0
        WhileLoop LessThan(i, n) {
            stmt = Array.Get(body, i)
            PAST._UnparseNode(stmt)
            i = Add(i, 1)
        }
    }
}

Function.PAST._UnparseFuncDef {
    Input: node: Address
    Body: {
        PAST._EmitIndent()
        PAST._Emit("def ")
        PAST._Emit(Hash.HGet(node, "name"))
        PAST._Emit("(")
        
        // Args
        args = Hash.HGet(node, "args")
        IfCondition NotEqual(args, 0) ThenBlock: {
            arg_list = Hash.HGet(args, "args")
            n = Array.Size(arg_list)
            i = 0
            WhileLoop LessThan(i, n) {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    PAST._Emit(", ")
                }
                arg = Array.Get(arg_list, i)
                PAST._Emit(Hash.HGet(arg, "arg"))
                i = Add(i, 1)
            }
        }
        
        PAST._Emit("):\n")
        
        PASTUnp.indent = Add(PASTUnp.indent, 1)
        PAST._UnparseBody(Hash.HGet(node, "body"))
        PASTUnp.indent = Subtract(PASTUnp.indent, 1)
        
        PAST._EmitLine("end")
        PAST._EmitChar(10)
    }
}

Function.PAST._UnparseClassDef {
    Input: node: Address
    Body: {
        PAST._EmitIndent()
        PAST._Emit("class ")
        PAST._Emit(Hash.HGet(node, "name"))
        
        bases = Hash.HGet(node, "bases")
        IfCondition GreaterThan(Array.Size(bases), 0) ThenBlock: {
            PAST._Emit("(")
            n = Array.Size(bases)
            i = 0
            WhileLoop LessThan(i, n) {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    PAST._Emit(", ")
                }
                PAST._UnparseExpr(Array.Get(bases, i))
                i = Add(i, 1)
            }
            PAST._Emit(")")
        }
        
        PAST._Emit(":\n")
        
        PASTUnp.indent = Add(PASTUnp.indent, 1)
        PAST._UnparseBody(Hash.HGet(node, "body"))
        PASTUnp.indent = Subtract(PASTUnp.indent, 1)
        
        PAST._EmitLine("end")
        PAST._EmitChar(10)
    }
}

Function.PAST._UnparseIf {
    Input: node: Address
    Body: {
        PAST._EmitIndent()
        PAST._Emit("if ")
        PAST._UnparseExpr(Hash.HGet(node, "test"))
        PAST._Emit(":\n")
        
        PASTUnp.indent = Add(PASTUnp.indent, 1)
        PAST._UnparseBody(Hash.HGet(node, "body"))
        PASTUnp.indent = Subtract(PASTUnp.indent, 1)
        
        orelse = Hash.HGet(node, "orelse")
        IfCondition GreaterThan(Array.Size(orelse), 0) ThenBlock: {
            // Check if it's elif
            first = Array.Get(orelse, 0)
            IfCondition EqualTo(PAST.Type(first), PAST.If) ThenBlock: {
                PAST._EmitIndent()
                PAST._Emit("el")
                PAST._UnparseIf(first)
            } ElseBlock: {
                PAST._EmitIndent()
                PAST._Emit("else:\n")
                PASTUnp.indent = Add(PASTUnp.indent, 1)
                PAST._UnparseBody(orelse)
                PASTUnp.indent = Subtract(PASTUnp.indent, 1)
                PAST._EmitLine("end")
            }
        } ElseBlock: {
            PAST._EmitLine("end")
        }
    }
}

Function.PAST._UnparseWhile {
    Input: node: Address
    Body: {
        PAST._EmitIndent()
        PAST._Emit("while ")
        PAST._UnparseExpr(Hash.HGet(node, "test"))
        PAST._Emit(":\n")
        
        PASTUnp.indent = Add(PASTUnp.indent, 1)
        PAST._UnparseBody(Hash.HGet(node, "body"))
        PASTUnp.indent = Subtract(PASTUnp.indent, 1)
        
        PAST._EmitLine("end")
    }
}

Function.PAST._UnparseFor {
    Input: node: Address
    Body: {
        PAST._EmitIndent()
        PAST._Emit("for ")
        PAST._UnparseExpr(Hash.HGet(node, "target"))
        PAST._Emit(" in ")
        PAST._UnparseExpr(Hash.HGet(node, "iter"))
        PAST._Emit(":\n")
        
        PASTUnp.indent = Add(PASTUnp.indent, 1)
        PAST._UnparseBody(Hash.HGet(node, "body"))
        PASTUnp.indent = Subtract(PASTUnp.indent, 1)
        
        PAST._EmitLine("end")
    }
}

Function.PAST._UnparseTry {
    Input: node: Address
    Body: {
        PAST._EmitLine("try:")
        
        PASTUnp.indent = Add(PASTUnp.indent, 1)
        PAST._UnparseBody(Hash.HGet(node, "body"))
        PASTUnp.indent = Subtract(PASTUnp.indent, 1)
        
        handlers = Hash.HGet(node, "handlers")
        n = Array.Size(handlers)
        i = 0
        WhileLoop LessThan(i, n) {
            handler = Array.Get(handlers, i)
            PAST._EmitIndent()
            PAST._Emit("except")
            
            exc_type = Hash.HGet(handler, "type")
            IfCondition NotEqual(exc_type, 0) ThenBlock: {
                PAST._Emit(" ")
                PAST._UnparseExpr(exc_type)
                name = Hash.HGet(handler, "name")
                IfCondition NotEqual(name, 0) ThenBlock: {
                    PAST._Emit(" as ")
                    PAST._Emit(name)
                }
            }
            
            PAST._Emit(":\n")
            PASTUnp.indent = Add(PASTUnp.indent, 1)
            PAST._UnparseBody(Hash.HGet(handler, "body"))
            PASTUnp.indent = Subtract(PASTUnp.indent, 1)
            
            i = Add(i, 1)
        }
        
        finalbody = Hash.HGet(node, "finalbody")
        IfCondition GreaterThan(Array.Size(finalbody), 0) ThenBlock: {
            PAST._EmitLine("finally:")
            PASTUnp.indent = Add(PASTUnp.indent, 1)
            PAST._UnparseBody(finalbody)
            PASTUnp.indent = Subtract(PASTUnp.indent, 1)
        }
        
        PAST._EmitLine("end")
    }
}