LibraryImport.XArrays
LibraryImport.HashMap
LibraryImport.AIMacro.AIMacroString
LibraryImport.AIMacro.PAST
LibraryImport.AIMacro.PASTNodes

// ============================================================================
// EXPRESSION UNPARSING
// ============================================================================

Function.PAST._UnparseExpr {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        t = PAST.Type(node)
        
        // Name
        IfCondition EqualTo(t, PAST.Name) ThenBlock: {
            PAST._Emit(HashMap.HGet(node, "id"))
            ReturnValue(0)
        }
        
        // Constant
        IfCondition EqualTo(t, PAST.Constant) ThenBlock: {
            kind = HashMap.HGet(node, "kind")
            value = HashMap.HGet(node, "value")
            
            IfCondition EqualTo(kind, PAST.CONST_INT) ThenBlock: {
                PAST._EmitNum(value)
            }
            IfCondition EqualTo(kind, PAST.CONST_STR) ThenBlock: {
                PAST._EmitChar(34)  // "
                PAST._Emit(value)
                PAST._EmitChar(34)
            }
            IfCondition EqualTo(kind, PAST.CONST_BOOL) ThenBlock: {
                IfCondition EqualTo(value, 1) ThenBlock: {
                    PAST._Emit("True")
                } ElseBlock: {
                    PAST._Emit("False")
                }
            }
            IfCondition EqualTo(kind, PAST.CONST_NONE) ThenBlock: {
                PAST._Emit("None")
            }
            ReturnValue(0)
        }
        
        // BinOp
        IfCondition EqualTo(t, PAST.BinOp) ThenBlock: {
            PAST._EmitChar(40)  // (
            PAST._UnparseExpr(HashMap.HGet(node, "left"))
            PAST._UnparseBinOp(HashMap.HGet(node, "op"))
            PAST._UnparseExpr(HashMap.HGet(node, "right"))
            PAST._EmitChar(41)  // )
            ReturnValue(0)
        }
        
        // UnaryOp
        IfCondition EqualTo(t, PAST.UnaryOp) ThenBlock: {
            op = HashMap.HGet(node, "op")
            IfCondition EqualTo(op, PAST.USub) ThenBlock: { PAST._Emit("-") }
            IfCondition EqualTo(op, PAST.UAdd) ThenBlock: { PAST._Emit("+") }
            IfCondition EqualTo(op, PAST.Not) ThenBlock: { PAST._Emit("not ") }
            IfCondition EqualTo(op, PAST.Invert) ThenBlock: { PAST._Emit("~") }
            PAST._UnparseExpr(HashMap.HGet(node, "operand"))
            ReturnValue(0)
        }
        
        // BoolOp
        IfCondition EqualTo(t, PAST.BoolOp) ThenBlock: {
            op = HashMap.HGet(node, "op")
            values = HashMap.HGet(node, "values")
            n = XArray.XSize(values)
            
            PAST._EmitChar(40)
            i = 0
            WhileLoop LessThan(i, n) {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    IfCondition EqualTo(op, PAST.And) ThenBlock: {
                        PAST._Emit(" and ")
                    } ElseBlock: {
                        PAST._Emit(" or ")
                    }
                }
                PAST._UnparseExpr(XArray.XGet(values, i))
                i = Add(i, 1)
            }
            PAST._EmitChar(41)
            ReturnValue(0)
        }
        
        // Compare
        IfCondition EqualTo(t, PAST.Compare) ThenBlock: {
            PAST._EmitChar(40)
            PAST._UnparseExpr(HashMap.HGet(node, "left"))
            
            ops = HashMap.HGet(node, "ops")
            comparators = HashMap.HGet(node, "comparators")
            n = XArray.XSize(ops)
            i = 0
            WhileLoop LessThan(i, n) {
                PAST._UnparseCmpOp(XArray.XGet(ops, i))
                PAST._UnparseExpr(XArray.XGet(comparators, i))
                i = Add(i, 1)
            }
            PAST._EmitChar(41)
            ReturnValue(0)
        }
        
        // Call
        IfCondition EqualTo(t, PAST.Call) ThenBlock: {
            PAST._UnparseExpr(HashMap.HGet(node, "func"))
            PAST._EmitChar(40)
            
            args = HashMap.HGet(node, "args")
            n = XArray.XSize(args)
            i = 0
            WhileLoop LessThan(i, n) {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    PAST._Emit(", ")
                }
                PAST._UnparseExpr(XArray.XGet(args, i))
                i = Add(i, 1)
            }
            
            PAST._EmitChar(41)
            ReturnValue(0)
        }
        
        // Attribute
        IfCondition EqualTo(t, PAST.Attribute) ThenBlock: {
            PAST._UnparseExpr(HashMap.HGet(node, "value"))
            PAST._EmitChar(46)  // .
            PAST._Emit(HashMap.HGet(node, "attr"))
            ReturnValue(0)
        }
        
        // Subscript
        IfCondition EqualTo(t, PAST.Subscript) ThenBlock: {
            PAST._UnparseExpr(HashMap.HGet(node, "value"))
            PAST._EmitChar(91)  // [
            PAST._UnparseSlice(HashMap.HGet(node, "slice"))
            PAST._EmitChar(93)  // ]
            ReturnValue(0)
        }
        
        // List
        IfCondition EqualTo(t, PAST.List) ThenBlock: {
            PAST._EmitChar(91)
            elts = HashMap.HGet(node, "elts")
            n = XArray.XSize(elts)
            i = 0
            WhileLoop LessThan(i, n) {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    PAST._Emit(", ")
                }
                PAST._UnparseExpr(XArray.XGet(elts, i))
                i = Add(i, 1)
            }
            PAST._EmitChar(93)
            ReturnValue(0)
        }
        
        // Tuple
        IfCondition EqualTo(t, PAST.Tuple) ThenBlock: {
            PAST._EmitChar(40)
            elts = HashMap.HGet(node, "elts")
            n = XArray.XSize(elts)
            i = 0
            WhileLoop LessThan(i, n) {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    PAST._Emit(", ")
                }
                PAST._UnparseExpr(XArray.XGet(elts, i))
                i = Add(i, 1)
            }
            IfCondition EqualTo(n, 1) ThenBlock: {
                PAST._EmitChar(44)  // trailing comma for single-element tuple
            }
            PAST._EmitChar(41)
            ReturnValue(0)
        }
        
        // Dict
        IfCondition EqualTo(t, PAST.Dict) ThenBlock: {
            PAST._EmitChar(123)
            keys = HashMap.HGet(node, "keys")
            values = HashMap.HGet(node, "values")
            n = XArray.XSize(keys)
            i = 0
            WhileLoop LessThan(i, n) {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    PAST._Emit(", ")
                }
                PAST._UnparseExpr(XArray.XGet(keys, i))
                PAST._Emit(": ")
                PAST._UnparseExpr(XArray.XGet(values, i))
                i = Add(i, 1)
            }
            PAST._EmitChar(125)
            ReturnValue(0)
        }
        
        // IfExp (ternary)
        IfCondition EqualTo(t, PAST.IfExp) ThenBlock: {
            PAST._UnparseExpr(HashMap.HGet(node, "body"))
            PAST._Emit(" if ")
            PAST._UnparseExpr(HashMap.HGet(node, "test"))
            PAST._Emit(" else ")
            PAST._UnparseExpr(HashMap.HGet(node, "orelse"))
            ReturnValue(0)
        }
        
        // Lambda
        IfCondition EqualTo(t, PAST.Lambda) ThenBlock: {
            PAST._Emit("lambda ")
            args = HashMap.HGet(node, "args")
            IfCondition NotEqual(args, 0) ThenBlock: {
                arg_list = HashMap.HGet(args, "args")
                n = XArray.XSize(arg_list)
                i = 0
                WhileLoop LessThan(i, n) {
                    IfCondition GreaterThan(i, 0) ThenBlock: {
                        PAST._Emit(", ")
                    }
                    PAST._Emit(HashMap.HGet(XArray.XGet(arg_list, i), "arg"))
                    i = Add(i, 1)
                }
            }
            PAST._Emit(": ")
            PAST._UnparseExpr(HashMap.HGet(node, "body"))
            ReturnValue(0)
        }
    }
}

Function.PAST._UnparseBinOp {
    Input: op: Integer
    Body: {
        IfCondition EqualTo(op, PAST.Add) ThenBlock: { PAST._Emit(" + ") }
        IfCondition EqualTo(op, PAST.Sub) ThenBlock: { PAST._Emit(" - ") }
        IfCondition EqualTo(op, PAST.Mult) ThenBlock: { PAST._Emit(" * ") }
        IfCondition EqualTo(op, PAST.Div) ThenBlock: { PAST._Emit(" / ") }
        IfCondition EqualTo(op, PAST.FloorDiv) ThenBlock: { PAST._Emit(" // ") }
        IfCondition EqualTo(op, PAST.Mod) ThenBlock: { PAST._Emit(" % ") }
        IfCondition EqualTo(op, PAST.Pow) ThenBlock: { PAST._Emit(" ** ") }
        IfCondition EqualTo(op, PAST.LShift) ThenBlock: { PAST._Emit(" << ") }
        IfCondition EqualTo(op, PAST.RShift) ThenBlock: { PAST._Emit(" >> ") }
        IfCondition EqualTo(op, PAST.BitOr) ThenBlock: { PAST._Emit(" | ") }
        IfCondition EqualTo(op, PAST.BitXor) ThenBlock: { PAST._Emit(" ^ ") }
        IfCondition EqualTo(op, PAST.BitAnd) ThenBlock: { PAST._Emit(" & ") }
        IfCondition EqualTo(op, PAST.MatMult) ThenBlock: { PAST._Emit(" @ ") }
    }
}

Function.PAST._UnparseCmpOp {
    Input: op: Integer
    Body: {
        IfCondition EqualTo(op, PAST.Eq) ThenBlock: { PAST._Emit(" == ") }
        IfCondition EqualTo(op, PAST.NotEq) ThenBlock: { PAST._Emit(" != ") }
        IfCondition EqualTo(op, PAST.Lt) ThenBlock: { PAST._Emit(" < ") }
        IfCondition EqualTo(op, PAST.LtE) ThenBlock: { PAST._Emit(" <= ") }
        IfCondition EqualTo(op, PAST.Gt) ThenBlock: { PAST._Emit(" > ") }
        IfCondition EqualTo(op, PAST.GtE) ThenBlock: { PAST._Emit(" >= ") }
        IfCondition EqualTo(op, PAST.Is) ThenBlock: { PAST._Emit(" is ") }
        IfCondition EqualTo(op, PAST.IsNot) ThenBlock: { PAST._Emit(" is not ") }
        IfCondition EqualTo(op, PAST.In) ThenBlock: { PAST._Emit(" in ") }
        IfCondition EqualTo(op, PAST.NotIn) ThenBlock: { PAST._Emit(" not in ") }
    }
}

Function.PAST._UnparseSlice {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        t = PAST.Type(node)
        
        // Slice node
        IfCondition EqualTo(t, PAST.Slice) ThenBlock: {
            lower = HashMap.HGet(node, "lower")
            upper = HashMap.HGet(node, "upper")
            step = HashMap.HGet(node, "step")
            
            IfCondition NotEqual(lower, 0) ThenBlock: {
                PAST._UnparseExpr(lower)
            }
            PAST._EmitChar(58)  // :
            IfCondition NotEqual(upper, 0) ThenBlock: {
                PAST._UnparseExpr(upper)
            }
            IfCondition NotEqual(step, 0) ThenBlock: {
                PAST._EmitChar(58)
                PAST._UnparseExpr(step)
            }
            ReturnValue(0)
        }
        
        // Simple index
        PAST._UnparseExpr(node)
    }
}