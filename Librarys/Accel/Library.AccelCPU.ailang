//
// Library.AccelCPU.ailang
//
// Backend 0: CPU thread pool wrapper.
// Thin layer — delegates to existing ThrPool infrastructure.
// In normal operation, backend 0 is never routed through HAL_Submit
// because Mat.ailang's ThrPool.initialized check handles it directly.
// This exists as a fallback and for completeness.
//
// USAGE
//   LibraryImport.Accel.AccelCPU

LibraryImport.TF.ThreadPool

// =============================================================================
// AccelCPU_Init — ensure thread pool is running
// =============================================================================
Function.AccelCPU_Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(ThrPool.initialized, 0) ThenBlock: {
            nw = ThrPool_Init()
            IfCondition EqualTo(ThrPool.initialized, 0) ThenBlock: {
                PrintMessage("[AccelCPU] thread pool init failed\n")
                ReturnValue(-1)
            }
        }
        PrintMessage("[AccelCPU] ready (")
        PrintNumber(ThrPool.num_workers)
        PrintMessage(" workers)\n")
        ReturnValue(0)
    }
}

// =============================================================================
// AccelCPU_Shutdown — no-op (ThrPool_Shutdown managed separately in ATTN_Shutdown)
// =============================================================================
Function.AccelCPU_Shutdown {
    Output: Integer
    Body: {
        PrintMessage("[AccelCPU] shutdown\n")
        ReturnValue(0)
    }
}

// =============================================================================
// AccelCPU_Submit — read HALOp, dispatch to thread pool via ThrPool fields
// This path is only used if backend=0 is routed through HAL_Submit directly
// (which the normal Mat.ailang hot path avoids).
// =============================================================================
Function.AccelCPU_Submit {
    Output: Integer
    Body: {
        cpu_op   = HALOp.op
        cpu_dst  = HALOp.dst
        cpu_mat  = HALOp.mat
        cpu_vec  = HALOp.vec
        cpu_rows = HALOp.rows
        cpu_cols = HALOp.cols

        IfCondition EqualTo(cpu_op, 1) ThenBlock: {
            ThrPool.op   = 1
            ThrPool.dst  = cpu_dst
            ThrPool.mat  = cpu_mat
            ThrPool.vec  = cpu_vec
            ThrPool.rows = cpu_rows
            ThrPool.cols = cpu_cols
            ThrPool.total_items = cpu_rows
            tp_discard = ThrPool_Dispatch()
            HALOp.status = 2
            ReturnValue(0)
        }
        IfCondition EqualTo(cpu_op, 2) ThenBlock: {
            ThrPool.op   = 2
            ThrPool.dst  = cpu_dst
            ThrPool.mat  = cpu_mat
            ThrPool.vec  = cpu_vec
            ThrPool.rows = cpu_rows
            ThrPool.cols = cpu_cols
            ThrPool.total_items = cpu_cols
            tp_discard = ThrPool_Dispatch()
            HALOp.status = 2
            ReturnValue(0)
        }
        IfCondition EqualTo(cpu_op, 3) ThenBlock: {
            cpu_vec2 = HALOp.vec2
            ThrPool.op   = 3
            ThrPool.dst  = cpu_dst
            ThrPool.mat  = cpu_mat
            ThrPool.vec  = cpu_vec
            ThrPool.vec2 = cpu_vec2
            ThrPool.rows = cpu_rows
            ThrPool.cols = cpu_cols
            ThrPool.total_items = cpu_rows
            tp_discard = ThrPool_Dispatch()
            HALOp.status = 2
            ReturnValue(0)
        }

        PrintMessage("[AccelCPU] unknown op\n")
        HALOp.status = -1
        ReturnValue(-1)
    }
}
