//
// Library.AccelGCN.ailang
//
// Backend 2: GCN 1.0 (Southern Islands) compute accelerator.
// Bridges the Compute IR layer to the AMDGPU driver stack.
//
// Lifecycle:
//   AccelGCN_Init  — discover GPU, map BARs, set up PM4 ring, init CIR
//   AccelGCN_Submit — build CIR program, lower to GCN, upload to VRAM, dispatch
//   AccelGCN_Shutdown — release resources
//
// The workflow for dispatching a compute kernel:
//   1. Frontend fills CIR program (CIR_Begin, CIR_Op_*, CIR_End)
//   2. CIR_Lower_GCN produces machine code in CIRProg.mc_buf
//   3. AccelGCN_Upload copies machine code to VRAM at a known offset
//   4. AccelGCN_SetupBufferResource writes V# descriptors into USER_DATA SGPRs
//   5. PM4_SubmitCompute dispatches the kernel
//   6. PM4_WaitFence waits for completion
//
// USAGE
//   LibraryImport.Accel.AccelGCN

LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUGART
LibraryImport.Drivers.AMDGPU.AMDGPUAtomBIOS
LibraryImport.Drivers.AMDGPU.AMDGPUPM4
LibraryImport.Drivers.AMDGPU.AMDGPUPowerPlay
LibraryImport.Drivers.AMDGPU.AMDGPUVoltage
LibraryImport.Drivers.AMDGPU.AMDGPUSMCRegs
LibraryImport.Drivers.AMDGPU.AMDGPUSMC_SI
LibraryImport.Drivers.AMDGPU.AMDGPUSMC
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExec
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecIO
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecDecode
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecOps
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecRun
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs
LibraryImport.Drivers.AMDGPU.AMDGPUDPM_SI
LibraryImport.Drivers.AMDGPU.AMDGPUDPM
LibraryImport.Drivers.AMDGPU.AMDGPUMC_SI
LibraryImport.Accel.ComputeIR
LibraryImport.Accel.ComputeIR_GCN
LibraryImport.Drivers.AMDGPU.AMDGPUDisplay

// =============================================================================
// ACCELGCN STATE
// =============================================================================
FixedPool.AccelGCNCfg {
    "prefer_bus":     Initialize=-1, CanChange=True  // preferred PCI bus (-1 = auto: bus 2)
    "gpu_idx":        Initialize=0, CanChange=True   // which GPU (0 = first)
    "ring_idx":       Initialize=0, CanChange=True   // which ring (0 = GFX)
    "initialized":    Initialize=0, CanChange=True   // 1 after init
    "shader_vram":    Initialize=0, CanChange=True   // VRAM offset for shader code
    "buf_desc_vram":  Initialize=0, CanChange=True   // VRAM offset for buffer descriptors
    "data_vram":      Initialize=0, CanChange=True   // VRAM offset for data buffers
    "dispatch_count": Initialize=0, CanChange=True   // dispatches on current ring (for rotation)
    "ib_vram":        Initialize=0, CanChange=True   // VRAM offset for IB scratch buffer
    "skip_hw_init":   Initialize=0, CanChange=True   // 1 = warm boot: skip SPLL, soft reset, MC_SI_GpuInit
}

// =============================================================================
// KERNEL CACHE — avoid per-dispatch CIR rebuild + GCN lowering
//
// For a given (op, rows, cols) the generated machine code is identical.
// We cache up to 3 kernels (one per op type: MatVecMul, MatTVecMul, OuterAccum).
// On cache hit we skip CIR_Begin/End/Lower_GCN entirely and restore the
// machine code + metadata from cache, going straight to upload + dispatch.
//
// Each slot stores a copy of the machine code bytes plus CIR/GCN metadata
// needed by AccelGCN_Dispatch.
// =============================================================================
FixedPool.KCache {
    "NUM_SLOTS":    Initialize=3,  CanChange=False
    "SLOT_SIZE":    Initialize=80, CanChange=False  // bytes of metadata per slot
    // Metadata offsets within each slot (8 bytes each):
    "OFF_VALID":    Initialize=0,  CanChange=False  // 1 if slot is populated
    "OFF_OP":       Initialize=8,  CanChange=False  // HALOp.op
    "OFF_ROWS":     Initialize=16, CanChange=False  // HALOp.rows
    "OFF_COLS":     Initialize=24, CanChange=False  // HALOp.cols
    "OFF_MC_SIZE":  Initialize=32, CanChange=False  // CIRProg.mc_size
    "OFF_VGPRS":    Initialize=40, CanChange=False  // CIRGcn.num_vgprs
    "OFF_SGPRS":    Initialize=48, CanChange=False  // CIRGcn.num_sgprs
    "OFF_GRP_SZ":   Initialize=56, CanChange=False  // CIRProg.group_size_x
    "OFF_GRID_X":   Initialize=64, CanChange=False  // CIRProg.grid_x
    "OFF_MC_PTR":   Initialize=72, CanChange=False  // pointer to cached mc bytes
}

FixedPool.KCacheState {
    "meta_buf":     Initialize=0,  CanChange=True   // mmap'd metadata array (3*80=240 bytes)
    "initialized":  Initialize=0,  CanChange=True
}

// VRAM layout — all offsets from 96MB base (0x6000000).
// First 90MB (0x0-0x59FFFFF) reserved for GART page table.
// IH ring, WPTR writeback, and dummy page are in system RAM (mapped via GART).
// Regions are packed with NO overlap.
//
//   [0x0000000 .. 0x59FFFFF]  GART page table (90MB)
//   [0x5A00000 .. 0x5FFFFFF]  Padding (6MB alignment)
//   +0x000000  Ring 0       68KB     0x6000000 .. 0x6010FFF
//   +0x011000  Ring 1       68KB     0x6011000 .. 0x6021FFF
//   +0x022000  Ring 2       68KB     0x6022000 .. 0x6032FFF
//   +0x034000  RLC SR       16KB     0x6034000 .. 0x6037FFF
//   +0x038000  RLC CS       16KB     0x6038000 .. 0x603BFFF
//   +0x03C000  Shader       256KB    0x603C000 .. 0x607BFFF
//   +0x07C000  Buf desc       4KB    0x607C000 .. 0x607CFFF
//   +0x07D000  IB scratch     4KB    0x607D000 .. 0x607DFFF
//   +0x07E000  DATA         (rest)   0x607E000 .. end
//
FixedPool.AccelGCNLayout {
    // All offsets are absolute VRAM BAR offsets (96MB base + region offset).
    "RING1_OFFSET":     Initialize=100732928, CanChange=False   // 0x6011000
    "RING2_OFFSET":     Initialize=100802560, CanChange=False   // 0x6022000
    "RLC_SR_OFFSET":    Initialize=100876288, CanChange=False   // 0x6034000
    "RLC_CS_OFFSET":    Initialize=100892672, CanChange=False   // 0x6038000
    "SHADER_OFFSET":    Initialize=100909056, CanChange=False   // 0x603C000
    "SHADER_SIZE":      Initialize=262144,    CanChange=False   // 256KB for shader code
    "BUF_DESC_OFFSET":  Initialize=101171200, CanChange=False   // 0x607C000
    "BUF_DESC_SIZE":    Initialize=4096,      CanChange=False   // 4KB for V# entries
    "IB_OFFSET":        Initialize=101175296, CanChange=False   // 0x607D000
    "DATA_OFFSET":      Initialize=101179392, CanChange=False   // 0x607E000
}

// =============================================================================
// AccelGCN_Init — discover GPU, map BARs, set up ring, init CIR
// =============================================================================
Function.AccelGCN_Init {
    Output: Integer
    Body: {
        //PrintMessage("[AccelGCN] initializing...\n")

        // Discover AMD GPUs
        n_gpus = GPU_Discover()
        IfCondition EqualTo(n_gpus, 0) ThenBlock: {
            PrintMessage("[AccelGCN] no AMD GPU found\n")
            ReturnValue(-1)
        }

        // Select GPU by PCI bus.
        // If prefer_bus is set (>= 0), use that bus. Otherwise default to bus 2
        // (compute GPU on dual-GPU FX-8320 / RD990 systems).
        target_bus = AccelGCNCfg.prefer_bus
        IfCondition LessThan(target_bus, 0) ThenBlock: {
            target_bus = 2
        }
        gpu = 0
        IfCondition GreaterThan(n_gpus, 1) ThenBlock: {
            gi = 0
            gpu = -1
            WhileLoop LessThan(gi, n_gpus) {
                bus = GPU_GetDeviceField(gi, GPUDevField.PCI_BUS)
                IfCondition EqualTo(bus, target_bus) ThenBlock: {
                    gpu = gi
                }
                gi = Add(gi, 1)
            }
            IfCondition LessThan(gpu, 0) ThenBlock: {
                PrintMessage("[AccelGCN] preferred bus not found, using GPU 0\n")
                gpu = 0
            }
        }
        AccelGCNCfg.gpu_idx = gpu
        PrintMessage("[AccelGCN] using GPU ")
        PrintNumber(gpu)
        PrintMessage(" (bus ")
        PrintNumber(GPU_GetDeviceField(gpu, GPUDevField.PCI_BUS))
        PrintMessage(")\n")

        // If targeting the display GPU, allow BAR mapping (lockout override)
        IfCondition EqualTo(GPU_GetDeviceField(gpu, GPUDevField.PCI_BUS), GPUBarLockout.DISPLAY_BUS) ThenBlock: {
            // SAFETY GUARD: only touch the display GPU if EXPLICITLY requested.
            // If selection fell back here (bus 2 not discovered), abort BEFORE any
            // mapping/DPM — DPM_SI sends NoDisplay which blanks the monitor and
            // hangs the RD990 fabric.
            IfCondition NotEqual(AccelGCNCfg.prefer_bus, GPUBarLockout.DISPLAY_BUS) ThenBlock: {
                PrintMessage("[AccelGCN] ABORT: selection fell back to DISPLAY GPU (bus 1) but prefer_bus is not the display bus — refusing to init display GPU\n")
                ReturnValue(-99)
            }
            GPUBarLockout.allow_display = 1
            PrintMessage("[AccelGCN] display GPU selected — BAR lockout overridden for mapping\n")
        }

        // Map MMIO and VRAM BARs
        GPU_BAR_Init()
        rc = GPU_BAR_MapMMIO(gpu)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] MMIO map failed\n")
            ReturnValue(-2)
        }
        rc = GPU_BAR_MapVRAM(gpu)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] VRAM map failed\n")
            ReturnValue(-3)
        }

        // ---------------------------------------------------------------
        // SPLL / DPM init — MUST happen BEFORE any GRBM-domain writes.
        // GRBM-routed registers (CP_ME_CNTL, GRBM_SOFT_RESET, firmware
        // load regs, etc.) require the engine clock to complete PCI
        // transactions.  On fresh boot with radeon unbound the SPLL is
        // in reset/bypass — writing GRBM regs without clocks stalls
        // the PCI bus and hard-locks the shared RD990 root complex.
        //
        // skip_hw_init=1: card already initialized (e.g. by amdgpu), skip
        // SPLL, soft reset, and golden regs — just set up VM, CP, and rings.
        // ---------------------------------------------------------------
        warm_boot = AccelGCNCfg.skip_hw_init

        IfCondition EqualTo(warm_boot, 0) ThenBlock: {
            rom = AtomBIOS_LoadROM(gpu)
            IfCondition NotEqual(rom, 0) ThenBlock: {
                ap_rc = AtomBIOS_Parse(gpu)
            }
            PP_Parse(gpu)
            Volt_Parse(gpu)

            // Very early init (kernel Phase 1, seq 15-16; Phase 3, seq 145)
            // Clock gating control — must happen before SPLL and MC training
            GPU_Wr32(gpu, 5932, 0)                                // 0x172C = 0 (CG clock gating)
            GPU_Wr32(gpu, 5948, 536870912)                        // 0x173C = 0x20000000 (CG control)
            GPU_Wr32(gpu, 23580, 2051)                            // 0x5C1C = 0x00000803 (HDP_MISC_CNTL, seq 145)

            // Zero MC_VM_FB_LOCATION before AtomBIOS ASIC_INIT.
            // On a truly unposted card (kernel cold boot), this register is 0.
            // Our card may retain a stale value from a previous run, which causes
            // AtomBIOS to produce a different MC program 3-step sequence.
            GPU_Wr32(gpu, SIReg.MC_VM_FB_LOCATION, 0)

            spll_rc = DPM_SI_InitSPLL(gpu)

            // HDP + DMIF init (kernel Phase 3, seq 130-145)
            // AtomBIOS ASIC_INIT writes HDP_HOST_PATH_CNTL=0x0F200029 and
            // HDP_MISC_CNTL=0x00121FE0 internally.  Do NOT duplicate here —
            // the kernel trace shows exactly one occurrence from AtomBIOS.

            // Golden regs + GPU init (kernel si_gpu_init, seq 3641-3760)
            // The kernel writes these IMMEDIATELY after ASIC_INIT returns
            // (BIF_FB_EN=3 is the last thing AtomBIOS does). Must happen
            // BEFORE MC firmware load (which is kernel Phase 7, seq 4119+).
            // DISPLAY SAFETY: skip on display GPU — screen would blank.
            is_display = GPU_BAR_IsDisplayGPU(gpu)
            IfCondition EqualTo(is_display, 0) ThenBlock: {
                mc_gpu_rc = MC_SI_GpuInit(gpu)
            }

            // Load MC sequencer firmware (kernel Phase 7)
            // This uploads verde_mc.bin, trains VRAM, and starts the MC sequencer.
            // Must happen AFTER AtomBIOS ASIC_INIT (which sets up SPLL/clocks)
            // and golden regs (kernel si_gpu_init), BEFORE VM aperture setup.
            mc_rc = MC_SI_LoadMicrocode(gpu)
            PrintMessage("[AccelGCN] MC_SI_LoadMicrocode rc=")
            PrintNumber(mc_rc)
            PrintMessage("\n")
        }
        IfCondition EqualTo(warm_boot, 1) ThenBlock: {
            PrintMessage("[AccelGCN] warm boot — skipping SPLL/ASIC_INIT\n")
        }

        // MC aperture — AtomBIOS ASIC_INIT already programs MC_VM_FB_LOCATION
        // with the 3-step sequence during its internal blackout.
        // System aperture + AGP writes happen later in PM4_ConfigureVM (Phase 7).
        // No separate MC_SI_Program blackout needed — kernel doesn't do one either.
        is_display = GPU_BAR_IsDisplayGPU(gpu)

        // Set up PM4 ring (ring 0 = GFX)
        ring = AccelGCNCfg.ring_idx
        PM4_HaltCP(gpu)

        // Read MC base address — GPU sees VRAM at this address, not at 0
        PM4_InitMCBase(gpu)

        // NOTE: GFX pipeline reset now done above (before MC_SI_GpuInit) to clear
        // stuck TA/DB/CB from power-on state. PM4_SoftResetCP later does RLC-only reset.

        // ---------------------------------------------------------------
        // Cold boot init — remaining phases after golden regs + MC FW:
        //   Phase 7:  gmc_v6_0_mc_program  (VM/MC aperture)
        //   Phase 8:  gmc_v6_0_gart_enable (VM/TLB setup)
        //   Phase 10: si_ih_hw_init        (IH ring)
        //   Phase 13: gfx_v6_0_rlc_resume  (RLC halt + RLC-only reset + RLC FW)
        //   Phase 14: RLC start
        //   Phase 15: gfx_v6_0_cp_resume   (CP halt + CP FW)
        //   Phase 16: ring setup + CP start
        //
        // NOTE: Golden regs (si_gpu_init) are now done earlier, right after
        // ASIC_INIT returns (matching kernel seq 3641-3760 position).
        // The RLC reset (phase 13) only does SOFT_RESET_RLC (bit 2 = 0x4),
        // NOT GFX or CP reset, so golden regs survive.
        // ---------------------------------------------------------------

        IfCondition EqualTo(warm_boot, 0) ThenBlock: {
            // Step 0: GART page table setup (must precede VM enable)
            // Allocates system RAM for IH ring/writeback/dummy, writes PTEs into VRAM
            gart_rc = GART_Init(gpu)
            IfCondition LessThan(gart_rc, 0) ThenBlock: {
                PrintMessage("[AccelGCN] GART_Init failed rc=")
                PrintNumber(gart_rc)
                PrintMessage("\n")
                ReturnValue(-20)
            }

            // Step 1: VM/MC aperture + TLB (phases 7-9)
            PM4_ConfigureVM(gpu)

            // Step 2: GRBM_CNTL + SRBM_INT + BIF_FB_EN (phase 10, seq 329273-329276)
            // Kernel writes these at gfx_v6_0_gpu_init late path.
            GPU_Wr32(gpu, SIReg.GRBM_CNTL, 255)           // 0xFF = GRBM_READ_TIMEOUT
            GPU_Wr32(gpu, SIReg.SRBM_INT_CNTL, 1)
            GPU_Wr32(gpu, SIReg.SRBM_INT_ACK, 1)
            GPU_Wr32(gpu, SIReg.BIF_FB_EN, 3)              // FB_READ_EN | FB_WRITE_EN

            // IH ring (phase 10)
            rc = PM4_SetupIHRing(gpu)
            IfCondition LessThan(rc, 0) ThenBlock: {
                PrintMessage("[AccelGCN] IH ring setup failed\n")
                ReturnValue(-15)
            }

            // Step 3: RLC halt + RLC-only reset (phase 13)
            // GRBM_SOFT_RESET = 0x4 (RLC only). Golden regs survive.
            PM4_SoftResetCP(gpu)

            // Step 5: RLC firmware load + start (phases 13-14)
            rc = PM4_LoadRLCFirmware(gpu)
            IfCondition LessThan(rc, 0) ThenBlock: {
                PrintMessage("[AccelGCN] RLC firmware load failed\n")
                ReturnValue(-11)
            }
        }
        IfCondition EqualTo(warm_boot, 1) ThenBlock: {
            PrintMessage("[AccelGCN] warm boot — skipping init phases 7-14\n")
        }

        // Step 6: CP halt (phase 15 — re-assert halt before firmware load)
        PM4_HaltCP(gpu)

        // Step 8: Load CP microcode firmware (PFP, ME, CE)
        // Must happen AFTER RLC is running (mmiotrace: RLC start at seq 333499,
        // CP firmware at seq 433505)
        PrintMessage("[AccelGCN] Pre-CP-FW: GRBM_STATUS=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.GRBM_STATUS))
        PrintMessage(" CP_ME_CNTL=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CP_ME_CNTL))
        PrintMessage(" SRBM_STATUS=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.SRBM_STATUS))
        PrintMessage("\n")

        // enable_gui_idle_interrupt(false) — matches kernel cp_resume
        gi_int = GPU_Rd32(gpu, SIReg.CP_INT_CNTL_RING0)
        GPU_Wr32(gpu, SIReg.CP_INT_CNTL_RING0, BitwiseAnd(gi_int, 4293394431))  // ~0x180000 = 0xFFE7FFFF

        rc = PM4_LoadCPFirmware(gpu)
        IfCondition LessThan(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] CP firmware load failed\n")
            ReturnValue(-10)
        }

        PrintMessage("[AccelGCN] Post-CP-FW: GRBM_STATUS=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.GRBM_STATUS))
        PrintMessage(" CP_ME_CNTL=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CP_ME_CNTL))
        PrintMessage("\n")

        // CP misc registers the kernel sets after reset, before ring setup
        GPU_Wr32(gpu, SIReg.CP_SEM_WAIT_TIMER, 0)
        GPU_Wr32(gpu, SIReg.CP_SEM_INCOMPLETE_TIMER, 0)
        GPU_Wr32(gpu, SIReg.CP_RB_WPTR_DELAY, 0)
        GPU_Wr32(gpu, SIReg.CP_DEBUG, 0)
        GPU_Wr32(gpu, SIReg.SCRATCH_ADDR, 0)
        // SCRATCH_UMSK moved to after PM4_CPStart — CLEAR_STATE resets it to 0

        // --- All 3 rings configured BEFORE CP unhalt (kernel si_cp_resume order) ---
        // The CP firmware latches ring configs at unhalt time. All ring BASE,
        // CNTL, RPTR_ADDR registers must be programmed before CP_ME_CNTL=0.
        rc = PM4_SetupRing(gpu, 0, RingConf.VRAM_RING_OFFSET)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] ring 0 setup failed\n")
            ReturnValue(-4)
        }

        rc = PM4_SetupRing(gpu, 1, AccelGCNLayout.RING1_OFFSET)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] ring 1 setup failed\n")
            ReturnValue(-11)
        }

        rc = PM4_SetupRing(gpu, 2, AccelGCNLayout.RING2_OFFSET)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] ring 2 setup failed\n")
            ReturnValue(-13)
        }

        // --- CPStart: ME_INITIALIZE + unhalt + CLEAR_STATE on all 3 rings ---
        rc = PM4_CPStart(gpu, 0)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] CP start failed\n")
            ReturnValue(-6)
        }

        // --- Ring tests (sequential, all rings already configured and CP running) ---
        rc = PM4_RingTest(0)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] ring 0 test failed\n")
            ReturnValue(-5)
        }

        rc = PM4_RingTest(1)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] ring 1 test failed\n")
            // ReturnValue(-12)  -- non-fatal: SI CP services RB0 only; ring1 fail expected, continue init
        }

        rc = PM4_RingTest(2)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] ring 2 test failed\n")
            // ReturnValue(-14)  -- non-fatal: SI CP services RB0 only; ring2 fail expected, continue init
        }

        // enable_gui_idle_interrupt(true) — matches kernel cp_resume end
        gi_int2 = GPU_Rd32(gpu, SIReg.CP_INT_CNTL_RING0)
        GPU_Wr32(gpu, SIReg.CP_INT_CNTL_RING0, BitwiseOr(gi_int2, 1572864))

        // ---------------------------------------------------------------
        // DMA engine init (kernel Phase 9 — cayman_dma_resume)
        // Both DMA0 and DMA1 ring buffers in GART-mapped system RAM.
        // Kernel does this immediately after CP ring tests.
        // ---------------------------------------------------------------
        rc = PM4_DMAResume(gpu)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] DMA engine init failed\n")
        }

        // Use compute ring 1 for dispatches (ring 0 = GFX has limited dispatch FIFO)
        AccelGCNCfg.ring_idx = 1
        AccelGCNCfg.dispatch_count = 0

        // Re-enable scratch regs via MMIO AFTER ring test.
        // CLEAR_STATE resets SCRATCH_UMSK to 0.  Ring test does PM4_WaitIdle,
        // guaranteeing ME has finished processing CLEAR_STATE.
        // SET_CONFIG_REG cannot write SCRATCH_UMSK on SI (outside writable range),
        // so MMIO is the only option.
        GPU_Wr32(gpu, SIReg.SCRATCH_UMSK, 255)

        // MMIO roundtrip sanity check
        GPU_Wr32(gpu, SIReg.SCRATCH_REG0, 3405691582)
        GPU_Wr32(gpu, SIReg.SCRATCH_REG0, 0)

        // Store VRAM layout offsets
        AccelGCNCfg.shader_vram = AccelGCNLayout.SHADER_OFFSET
        AccelGCNCfg.buf_desc_vram = AccelGCNLayout.BUF_DESC_OFFSET
        AccelGCNCfg.data_vram = AccelGCNLayout.DATA_OFFSET

        // IB scratch area: 4KB at 0x4081000, between buf desc and data area.
        // Used by PM4_SubmitCompute to build Indirect Buffers containing
        // DISPATCH_DIRECT + CS_PARTIAL_FLUSH. The ME frees its dispatch
        // tracking FIFO entry when it returns from the IB to the ring.
        AccelGCNCfg.ib_vram = AccelGCNLayout.IB_OFFSET

        // Initialize Compute IR
        rc = CIR_Init()
        IfCondition LessThan(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] CIR init failed\n")
            ReturnValue(-6)
        }

        // Initialize kernel cache
        discard_kc = KCache_Init()

        smc_rc = SMC_LoadFirmware(gpu)
        IfCondition EqualTo(smc_rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] SMC firmware load failed, continuing at boot clocks\n")
        }
        ElseBlock: {
            DPM_Init()
            dpm_rc = DPM_Enable(gpu)
            IfCondition EqualTo(dpm_rc, 1) ThenBlock: {
                DPM_SI_UploadDriverState(gpu)
                // Force HIGH for compute workload
                dpm = DPM_SI_GetEntry(gpu)
                num_levels = Dereference(Add(dpm, DPMField.NUM_LEVELS))
                DPM_SetLevel(gpu, Subtract(num_levels, 1))
                PrintMessage("[AccelGCN] DPM enabled, forced HIGH (")
                PrintNumber(num_levels)
                PrintMessage(" levels)\n")
            }
            ElseBlock: {
                PrintMessage("[AccelGCN] DPM enable failed, continuing at boot clocks\n")
            }
        }

        // ---------------------------------------------------------------
        // DCE / Display controller full init (kernel Phase 14 — dce6_resume)
        // Kernel initializes ALL 6 CRTCs, HPD, AFMT even on headless cards.
        // Must happen AFTER DPM is enabled (kernel order).
        // ---------------------------------------------------------------
        DCE6_FullInit(gpu)

        // Re-prime BAR0 pages after init.  BIF_FB_EN toggles during MC training
        // invalidate the kernel's page-fault-installed PTEs.  Without re-priming,
        // the first write to each 4KB page is silently lost.
        GPU_BAR_PrimeVRAM(gpu)

        AccelGCNCfg.initialized = 1
        ReturnValue(0)
    }
}



// =============================================================================
// AccelGCN_Shutdown — release all resources
// =============================================================================
Function.AccelGCN_Shutdown {
    Output: Integer
    Body: {
        IfCondition EqualTo(AccelGCNCfg.initialized, 0) ThenBlock: {
            ReturnValue(0)
        }

        ring = AccelGCNCfg.ring_idx
        PM4_Destroy(ring)

        gpu = AccelGCNCfg.gpu_idx

        DPM_Disable(gpu)
        DPM_Shutdown(gpu)

        GPU_BAR_Unmap(gpu)

        discard_cir = CIR_Shutdown()

        // Restore lockout
        GPUBarLockout.allow_display = 0

        AccelGCNCfg.initialized = 0
        //PrintMessage("[AccelGCN] shutdown\n")
        ReturnValue(0)
    }
}

// =============================================================================
// AccelGCN_ComputeReset — full CP soft reset + firmware reload + ring setup
//
// HD 7770 (Cape Verde) has a silicon bug: the compute dispatch path leaks
// internal event engine slots that cannot be reclaimed by software.  After
// ~36 dispatches the EVENT_WRITE_EOP fence silently fails.  The GFX event
// engine is NOT affected (proven by test_gfx_fence: 100/100 PASS).
//
// Workaround: every N dispatches, replay the exact cold-boot init sequence:
//   1. CP halt
//   2. GRBM soft reset (clears CP microcode + internal FIFOs)
//   3. Reload CP firmware (PFP/ME/CE)
//   4. Reload RLC firmware
//   5. Re-setup IH ring
//   6. Re-setup all 3 rings
//   7. CPStart (ME_INITIALIZE + CLEAR_STATE)
//   8. Re-program SH_MEM, SCRATCH_UMSK, GB_ADDR_CONFIG
//
// This is expensive (~50-100ms) but only happens every 30 dispatches.
// =============================================================================
Function.AccelGCN_ComputeReset {
    Output: Integer
    Body: {
        gpu = AccelGCNCfg.gpu_idx

        // 1. Halt CP
        PM4_HaltCP(gpu)

        // 2. Soft reset — wipes CP microcode, clears ALL internal FIFOs/state
        PM4_SoftResetCP(gpu)

        // 3. Re-halt after soft reset (reset clears CP_ME_CNTL)
        PM4_HaltCP(gpu)

        // 4. Reload CP firmware (PFP, ME, CE)
        rc = PM4_LoadCPFirmware(gpu)
        IfCondition LessThan(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] RESET: CP firmware reload failed\n")
            ReturnValue(-1)
        }

        // 5. Reload RLC firmware
        rc = PM4_LoadRLCFirmware(gpu)
        IfCondition LessThan(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] RESET: RLC firmware reload failed\n")
            ReturnValue(-2)
        }

        // 6. Re-setup IH ring
        rc = PM4_SetupIHRing(gpu)
        IfCondition LessThan(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] RESET: IH ring setup failed\n")
            ReturnValue(-3)
        }

        // 7. CP misc registers
        GPU_Wr32(gpu, SIReg.CP_SEM_WAIT_TIMER, 0)
        GPU_Wr32(gpu, SIReg.CP_SEM_INCOMPLETE_TIMER, 0)
        GPU_Wr32(gpu, SIReg.CP_RB_WPTR_DELAY, 0)
        GPU_Wr32(gpu, SIReg.CP_DEBUG, 0)

        // 8. Re-setup ALL 3 rings BEFORE CP unhalt (kernel si_cp_resume order)
        rc = PM4_SetupRing(gpu, 0, RingConf.VRAM_RING_OFFSET)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] RESET: ring 0 setup failed\n")
            ReturnValue(-4)
        }
        rc = PM4_SetupRing(gpu, 1, AccelGCNLayout.RING1_OFFSET)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] RESET: ring 1 setup failed\n")
            ReturnValue(-7)
        }
        rc = PM4_SetupRing(gpu, 2, AccelGCNLayout.RING2_OFFSET)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] RESET: ring 2 setup failed\n")
            ReturnValue(-9)
        }

        // CP control registers
        GPU_Wr32(gpu, SIReg.CP_MAX_CONTEXT, 7)
        GPU_Wr32(gpu, SIReg.CP_ENDIAN_SWAP, 0)
        GPU_Wr32(gpu, SIReg.CP_DEVICE_ID, 1)

        // 9. CPStart — ME_INITIALIZE + unhalt + CLEAR_STATE on all 3 rings
        rc = PM4_CPStart(gpu, 0)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] RESET: CPStart failed\n")
            ReturnValue(-5)
        }

        // 10. Ring tests (sequential, all rings already configured and CP running)
        rc = PM4_RingTest(0)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] RESET: ring 0 test failed\n")
            ReturnValue(-6)
        }
        rc = PM4_RingTest(1)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] RESET: ring 1 test failed\n")
            ReturnValue(-8)
        }
        rc = PM4_RingTest(2)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] RESET: ring 2 test failed\n")
            ReturnValue(-10)
        }

        // 11. Re-program SH_MEM for VMID 0 (CLEAR_STATE zeros these)
        GPU_Wr32(gpu, SIReg.SRBM_GFX_CNTL, 0)
        GPU_Wr32(gpu, SIReg.SH_MEM_CONFIG, 0)
        GPU_Wr32(gpu, SIReg.SH_MEM_APE1_BASE, 1)
        GPU_Wr32(gpu, SIReg.SH_MEM_APE1_LIMIT, 0)
        GPU_Wr32(gpu, SIReg.SH_MEM_BASES, 0)

        // 12. SCRATCH_UMSK (CLEAR_STATE resets to 0)
        GPU_Wr32(gpu, SIReg.SCRATCH_UMSK, 255)

        // 13. GB_ADDR_CONFIG — Cape Verde golden value
        GPU_Wr32(gpu, SIReg.GB_ADDR_CONFIG, 302186498)

        // Reset dispatch counter
        AccelGCNCfg.dispatch_count = 0

        ReturnValue(1)
    }
}

// =============================================================================
// AccelGCN_Upload — copy machine code from CIRProg.mc_buf to VRAM
// Returns GPU address of the uploaded shader (VRAM offset, 256-byte aligned).
// =============================================================================
Function.AccelGCN_Upload {
    Output: Integer
    Body: {
        mc_size = CIRProg.mc_size
        IfCondition EqualTo(mc_size, 0) ThenBlock: {
            PrintMessage("[AccelGCN] no machine code to upload\n")
            ReturnValue(0)
        }
        IfCondition GreaterThan(mc_size, AccelGCNLayout.SHADER_SIZE) ThenBlock: {
            PrintMessage("[AccelGCN] shader too large: ")
            PrintNumber(mc_size)
            PrintMessage(" > ")
            PrintNumber(AccelGCNLayout.SHADER_SIZE)
            PrintMessage("\n")
            ReturnValue(0)
        }

        gpu = AccelGCNCfg.gpu_idx
        shader_off = AccelGCNCfg.shader_vram

        // Align to 256 bytes (SI requires 256-byte aligned shader addresses)
        aligned_off = BitwiseAnd(Add(shader_off, 255), -256)

        // Get host-side pointer to VRAM location
        vram_state = GPU_BAR_GetState(gpu)
        vram_ptr = Dereference(Add(vram_state, GPUBarField.VRAM_PTR))
        dst_ptr = Add(vram_ptr, aligned_off)

        // Copy machine code bytes from CIRProg.mc_buf to VRAM
        src_ptr = CIRProg.mc_buf
        i = 0
        WhileLoop LessThan(i, mc_size) {
            b = GetByte(src_ptr, i)
            SetByte(dst_ptr, i, b)
            i = Add(i, 1)
        }

        // Flush CPU WC buffer to ensure shader code is visible in VRAM
        InlineAsm["0f ae f8"]

        // Flush HDP write cache so GPU fetches actual shader bytes from VRAM
        GPU_Wr32(gpu, SIReg.HDP_MEM_COHERENCY_FLUSH_CNTL, 1)
        // PCIe barrier — read back a register to ensure flush completes
        discard_barrier = GPU_Rd32(gpu, SIReg.SCRATCH_REG0)

        // Return GPU-side VRAM address (same as offset for aperture-mapped VRAM)
        ReturnValue(aligned_off)
    }
}

// =============================================================================
// AccelGCN_SetupBufferV — write a buffer resource V# (128-bit descriptor)
//   to VRAM at buf_desc area for use by USER_DATA SGPRs.
//
// SI V# (T# for textures) format — 128 bits for buffer resources:
//   DWORD0: base_address[31:0]
//   DWORD1: base_address[47:32] | stride[29:16] | ...
//   DWORD2: num_records (number of elements, NOT bytes for typed buffers)
//   DWORD3: dst_sel | num_format | data_format | element_size | ...
//
// For raw buffers (untyped): data_format=0, num_records=byte_count
// For typed buffers: data_format specifies element type
//
// slot: which descriptor slot (0-15, matching CIR buffer binding)
// gpu_addr: GPU virtual address of the buffer data in VRAM
// num_bytes: size of buffer in bytes
// stride: bytes per element (0 for raw)
// =============================================================================
Function.AccelGCN_SetupBufferV {
    Input: slot: Integer
    Input: gpu_addr: Integer
    Input: num_bytes: Integer
    Input: stride: Integer
    Output: Integer
    Body: {
        gpu = AccelGCNCfg.gpu_idx
        vram_state = GPU_BAR_GetState(gpu)
        vram_ptr = Dereference(Add(vram_state, GPUBarField.VRAM_PTR))

        // V# location: buf_desc_vram + slot * 16
        desc_off = Add(AccelGCNCfg.buf_desc_vram, Multiply(slot, 16))
        desc_ptr = Add(vram_ptr, desc_off)

        // DWORD0: base_address[31:0]
        dw0 = BitwiseAnd(gpu_addr, 4294967295)

        // DWORD1: base_address[47:32] (bits [15:0]) | stride (bits [29:16])
        addr_hi = BitwiseAnd(RightShift(gpu_addr, 32), 65535)
        dw1 = BitwiseOr(addr_hi, LeftShift(BitwiseAnd(stride, 16383), 16))

        // DWORD2: num_records
        dw2 = num_bytes

        // DWORD3: For raw buffer (BUF_DATA_FORMAT_32, BUF_NUM_FORMAT_UINT):
        //   data_format = 4 (32-bit) at bits [25:22]
        //   num_format = 1 (UINT) at bits [28:26]
        //   dst_sel_x = 4 (SEL_X) at bits [9:7]  → actually [11:9]
        //   For simple typed 32-bit buffer:
        dw3 = 0
        // data_format=4 at [25:22]: 4 << 22 = 16777216
        dw3 = Add(dw3, Multiply(4, 4194304))
        // num_format=1 at [28:26]: 1 << 26 = 67108864
        dw3 = Add(dw3, 67108864)

        // Write 4 DWORDs as bytes (little-endian)
        SetByte(desc_ptr, 0, BitwiseAnd(dw0, 255))
        SetByte(desc_ptr, 1, BitwiseAnd(RightShift(dw0, 8), 255))
        SetByte(desc_ptr, 2, BitwiseAnd(RightShift(dw0, 16), 255))
        SetByte(desc_ptr, 3, BitwiseAnd(RightShift(dw0, 24), 255))

        SetByte(desc_ptr, 4, BitwiseAnd(dw1, 255))
        SetByte(desc_ptr, 5, BitwiseAnd(RightShift(dw1, 8), 255))
        SetByte(desc_ptr, 6, BitwiseAnd(RightShift(dw1, 16), 255))
        SetByte(desc_ptr, 7, BitwiseAnd(RightShift(dw1, 24), 255))

        SetByte(desc_ptr, 8, BitwiseAnd(dw2, 255))
        SetByte(desc_ptr, 9, BitwiseAnd(RightShift(dw2, 8), 255))
        SetByte(desc_ptr, 10, BitwiseAnd(RightShift(dw2, 16), 255))
        SetByte(desc_ptr, 11, BitwiseAnd(RightShift(dw2, 24), 255))

        SetByte(desc_ptr, 12, BitwiseAnd(dw3, 255))
        SetByte(desc_ptr, 13, BitwiseAnd(RightShift(dw3, 8), 255))
        SetByte(desc_ptr, 14, BitwiseAnd(RightShift(dw3, 16), 255))
        SetByte(desc_ptr, 15, BitwiseAnd(RightShift(dw3, 24), 255))

        // Readback verify V# DWORDs
        rb0 = BitwiseOr(GetByte(desc_ptr, 0), BitwiseOr(LeftShift(GetByte(desc_ptr, 1), 8), BitwiseOr(LeftShift(GetByte(desc_ptr, 2), 16), LeftShift(GetByte(desc_ptr, 3), 24))))
        rb1 = BitwiseOr(GetByte(desc_ptr, 4), BitwiseOr(LeftShift(GetByte(desc_ptr, 5), 8), BitwiseOr(LeftShift(GetByte(desc_ptr, 6), 16), LeftShift(GetByte(desc_ptr, 7), 24))))
        rb2 = BitwiseOr(GetByte(desc_ptr, 8), BitwiseOr(LeftShift(GetByte(desc_ptr, 9), 8), BitwiseOr(LeftShift(GetByte(desc_ptr, 10), 16), LeftShift(GetByte(desc_ptr, 11), 24))))
        rb3 = BitwiseOr(GetByte(desc_ptr, 12), BitwiseOr(LeftShift(GetByte(desc_ptr, 13), 8), BitwiseOr(LeftShift(GetByte(desc_ptr, 14), 16), LeftShift(GetByte(desc_ptr, 15), 24))))
        ReturnValue(0)
    }
}

// =============================================================================
// AccelGCN_Dispatch — dispatch the current CIR program on the GPU
//
// Assumes CIR program has been built (CIR_Begin...CIR_End) and lowered
// (CIR_Lower_GCN). This function:
//   1. Uploads shader to VRAM
//   2. Sets up buffer V# descriptors
//   3. Programs USER_DATA SGPRs with descriptor address
//   4. Dispatches via PM4
//   5. Waits for completion
//
// Returns 0 on success, negative on error.
// =============================================================================
Function.AccelGCN_Dispatch {
    Output: Integer
    Body: {
        IfCondition EqualTo(AccelGCNCfg.initialized, 0) ThenBlock: {
            PrintMessage("[AccelGCN] not initialized\n")
            ReturnValue(-1)
        }
        IfCondition EqualTo(CIRProg.lowered, 0) ThenBlock: {
            PrintMessage("[AccelGCN] program not lowered\n")
            ReturnValue(-2)
        }

        // 1. Upload machine code to VRAM
        pgm_vram = AccelGCN_Upload()
        IfCondition EqualTo(pgm_vram, 0) ThenBlock: {
            PrintMessage("[AccelGCN] upload failed\n")
            ReturnValue(-3)
        }
        // Convert VRAM offset to GPU MC address
        pgm_addr = PM4_VramToGPU(pgm_vram)
        // 2. Build a single V# descriptor covering the entire data area
        //    The shader uses s[0:3] as the buffer resource descriptor directly.
        //    Both LOAD_BUF and STORE_BUF use srsrc=0 (s[0:3]) with offen mode,
        //    where the VGPR index provides the byte offset into the buffer.
        //    So we create one V# that spans the whole data region.
        ring = AccelGCNCfg.ring_idx
        gpu_data_base = PM4_VramToGPU(AccelGCNCfg.data_vram)

        // Calculate total data area size from CIR buffer bindings
        // Find the max (buf_addr + buf_size) across all buffers
        nbufs = CIRProg.num_bufs
        total_data_size = 0
        slot = 0
        WhileLoop LessThan(slot, nbufs) {
            bd_ptr = Add(CIRBufs.base, Multiply(slot, 32))
            buf_addr = Dereference(Add(bd_ptr, 0))
            buf_size = Dereference(Add(bd_ptr, 8))
            buf_end = Add(buf_addr, buf_size)
            IfCondition GreaterThan(buf_end, total_data_size) ThenBlock: {
                total_data_size = buf_end
            }
            slot = Add(slot, 1)
        }

        // Build 128-bit V# descriptor (4 DWORDs)
        // DWORD0: base_address[31:0]
        vdesc_dw0 = BitwiseAnd(gpu_data_base, 4294967295)
        // DWORD1: base_address[47:32] (bits [15:0]) | stride (bits [29:16])
        //         stride=0 for raw/OFFEN buffer access (GCN requires stride=0 for raw buffers)
        vdesc_dw1 = BitwiseAnd(RightShift(gpu_data_base, 32), 65535)
        // DWORD2: num_records (byte count for raw/offen mode)
        vdesc_dw2 = total_data_size
        // DWORD3 (SQ_BUF_RSRC_WORD3):
        //   DST_SEL_X[2:0]=4(X), DST_SEL_Y[5:3]=5(Y), DST_SEL_Z[8:6]=6(Z), DST_SEL_W[11:9]=7(W)
        //   NUM_FORMAT[14:12]=1(UINT), DATA_FORMAT[18:15]=4(BUF_DATA_FORMAT_32)
        //   = 4 + 40 + 384 + 3584 + 4096 + 131072 = 139180 (0x21FAC)
        vdesc_dw3 = 139180

        // --- Periodic full reset (HD 7770 compute event engine bug) ---
        // Cape Verde may leak internal compute dispatch slots after many uses.
        // Full soft reset + firmware reload reclaims them.  GFX ring unaffected.
        // MUST happen BEFORE any PM4 packets are emitted to the ring,
        // because the reset reinitializes the ring and wipes pending packets.
        // NOTE: confirmed still required even after SOPC fix — GPU hangs at ~37 dispatches.
        IfCondition GreaterEqual(AccelGCNCfg.dispatch_count, 30) ThenBlock: {
            rst_rc = AccelGCN_ComputeReset()
            IfCondition LessThan(rst_rc, 0) ThenBlock: {
                PrintMessage("[AccelGCN] FATAL: compute reset failed rc=")
                PrintNumber(rst_rc)
                PrintMessage("\n")
                ReturnValue(-10)
            }
        }

        // 3a. Breadcrumb — first packet in the dispatch stream.
        //     WRITE_DATA to fence_off+16, carrying the upcoming fence_val.
        //     If the CP fetches iter N's packets, breadcrumb updates to N's fence_val;
        //     if the CP is idle and never fetches, it stays at N-1's value.
        bc_ring = PM4_GetRing(ring)
        bc_fence_off = Dereference(Add(bc_ring, RingField.FENCE_WB_OFF))
        bc_fence_val = Add(Dereference(Add(bc_ring, RingField.FENCE_VAL)), 1)
        GPU_VramWr32(AccelGCNCfg.gpu_idx, Add(bc_fence_off, 16), 0)
        GPU_VramWr32(AccelGCNCfg.gpu_idx, Add(bc_fence_off, 20), 0)
        GPU_VramWr32(AccelGCNCfg.gpu_idx, Add(bc_fence_off, 24), 0)
        GPU_VramWr32(AccelGCNCfg.gpu_idx, Add(bc_fence_off, 28), 0)
        GPU_VramWr32(AccelGCNCfg.gpu_idx, Add(bc_fence_off, 32), 0)
        PM4_EmitWriteDataVRAM(ring, Add(bc_fence_off, 16), bc_fence_val)

        // 3b. Load V# directly into USER_DATA SGPRs s[0:3]
        //     The shader does BUFFER_LOAD/STORE with srsrc=0 → reads s[0:3] as V#.
        //     We use 4 USER_DATA registers, so TGID_X lands at s[4].
        PM4_EmitSetSHReg(ring, SICompute.USER_DATA_0, vdesc_dw0, PM4.SHADER_TYPE_COMPUTE)
        PM4_EmitSetSHReg(ring, SICompute.USER_DATA_1, vdesc_dw1, PM4.SHADER_TYPE_COMPUTE)
        PM4_EmitSetSHReg(ring, SICompute.USER_DATA_2, vdesc_dw2, PM4.SHADER_TYPE_COMPUTE)
        PM4_EmitSetSHReg(ring, SICompute.USER_DATA_3, vdesc_dw3, PM4.SHADER_TYPE_COMPUTE)

        // 4. Dispatch
        dbg_gpu = AccelGCNCfg.gpu_idx
        num_vgprs = CIRGcn.num_vgprs
        num_sgprs = CIRGcn.num_sgprs

        // Ensure minimums for register granularity
        IfCondition LessThan(num_vgprs, 4) ThenBlock: { num_vgprs = 4 }
        IfCondition LessThan(num_sgprs, 8) ThenBlock: { num_sgprs = 8 }

        // Round up to granularity
        num_vgprs = Multiply(Divide(Add(num_vgprs, 3), 4), 4)
        num_sgprs = Multiply(Divide(Add(num_sgprs, 7), 8), 8)

        // Fill PM4Dispatch carrier (avoids >6 arg ABI violation)
        PM4Dispatch.pgm_addr = pgm_addr
        PM4Dispatch.num_vgprs = num_vgprs
        PM4Dispatch.num_sgprs = num_sgprs
        PM4Dispatch.tg_size_x = CIRProg.group_size_x
        PM4Dispatch.tg_size_y = CIRProg.group_size_y
        PM4Dispatch.tg_size_z = CIRProg.group_size_z
        PM4Dispatch.grid_x = CIRProg.grid_x
        PM4Dispatch.grid_y = CIRProg.grid_y
        PM4Dispatch.grid_z = CIRProg.grid_z
        PM4Dispatch.buf_vram_off = AccelGCNCfg.data_vram
        PM4Dispatch.buf_total_size = total_data_size
        PM4Dispatch.ib_vram_off = AccelGCNCfg.ib_vram

        PrintMessage("\n=== [DISPATCH DRYRUN] ring=")
        PrintNumber(ring)
        PrintMessage(" ===\n")
        PrintMessage("[DBG] pgm_vram=0x")
        PrintHex(pgm_vram)
        PrintMessage(" pgm_addr_GPU=0x")
        PrintHex(pgm_addr)
        PrintMessage("\n")
        PrintMessage("[DBG] gpu_data_base=0x")
        PrintHex(gpu_data_base)
        PrintMessage(" total_data_size=")
        PrintNumber(total_data_size)
        PrintMessage("\n")
        PrintMessage("[DBG] vdesc dw0=0x")
        PrintHex(vdesc_dw0)
        PrintMessage(" dw1=0x")
        PrintHex(vdesc_dw1)
        PrintMessage(" dw2=0x")
        PrintHex(vdesc_dw2)
        PrintMessage(" dw3=0x")
        PrintHex(vdesc_dw3)
        PrintMessage("\n")
        PrintMessage("[DBG] num_vgprs=")
        PrintNumber(num_vgprs)
        PrintMessage(" num_sgprs=")
        PrintNumber(num_sgprs)
        PrintMessage("\n")
        PrintMessage("[DBG] grid=")
        PrintNumber(PM4Dispatch.grid_x)
        PrintMessage("x")
        PrintNumber(PM4Dispatch.grid_y)
        PrintMessage("x")
        PrintNumber(PM4Dispatch.grid_z)
        PrintMessage(" tg=")
        PrintNumber(PM4Dispatch.tg_size_x)
        PrintMessage("x")
        PrintNumber(PM4Dispatch.tg_size_y)
        PrintMessage("x")
        PrintNumber(PM4Dispatch.tg_size_z)
        PrintMessage("\n")
        PrintMessage("[DBG] data_vram=0x")
        PrintHex(AccelGCNCfg.data_vram)
        PrintMessage(" ib_vram=0x")
        PrintHex(AccelGCNCfg.ib_vram)
        PrintMessage("\n")
        rc = PM4_SubmitCompute(ring)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] PM4 submit failed\n")
            ReturnValue(-4)
        }

        // 5. Wait for completion — poll VRAM fence (authoritative path)
        fence = Dereference(Add(PM4_GetRing(ring), RingField.FENCE_VAL))
        rc = PM4_WaitFenceVRAM(ring, fence)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[AccelGCN] fence timeout\n")
            ReturnValue(-5)
        }

        // Drain the IH ring — advance RPTR to WPTR so the ring doesn't overflow.
        PM4_DrainIH(dbg_gpu)

        // Post-fence drain: emit NOP + WaitIdle to ensure the event engine
        // has fully retired the EOP before we submit the next dispatch.
        // SI docs state "only one EOP event may be present in the pipeline
        // at a time" — if we start the next dispatch before the event engine
        // finishes internal cleanup, EOP slots accumulate and eventually
        // the event engine silently drops fence writes (~36 dispatches).
        PM4_EmitNOP(ring, 2)
        PM4_Commit(ring)
        discard_idle = PM4_WaitIdle(ring)

        // HDP coherency is now handled GPU-side: PM4_SubmitCompute emits
        // WRITE_DATA to HDP_MEM_COHERENCY_FLUSH_CNTL + HDP_HOST_PATH_CNTL
        // after SURFACE_SYNC and before the EOP fence.  By the time we see
        // the fence here, both HDP write and read caches are already clean.
        // Redundant CPU-side write-cache flush (safe, cheap, belt-and-suspenders):
        GPU_Wr32(dbg_gpu, 21632, 1)    // HDP_MEM_COHERENCY_FLUSH_CNTL = 0x5480

        // Dispatch tracking
        AccelGCNCfg.dispatch_count = Add(AccelGCNCfg.dispatch_count, 1)

        ReturnValue(0)
    }
}

// =============================================================================
// KCache_Init — allocate cache metadata + per-slot mc buffers
// Called once from AccelGCN_Init.
// =============================================================================
Function.KCache_Init {
    Output: Integer
    Body: {
        // Allocate metadata array: 3 slots * 80 bytes = 240 bytes
        meta_sz = Multiply(KCache.NUM_SLOTS, KCache.SLOT_SIZE)
        meta = Allocate(meta_sz)
        MemorySet(meta, 0, meta_sz)
        KCacheState.meta_buf = meta

        // Allocate per-slot mc buffers (64KB each — generous for any kernel)
        s = 0
        WhileLoop LessThan(s, KCache.NUM_SLOTS) {
            mc = Allocate(65536)
            slot_ptr = Add(meta, Multiply(s, KCache.SLOT_SIZE))
            StoreValue(Add(slot_ptr, KCache.OFF_MC_PTR), mc)
            StoreValue(Add(slot_ptr, KCache.OFF_VALID), 0)
            s = Add(s, 1)
        }

        KCacheState.initialized = 1
        ReturnValue(0)
    }
}

// =============================================================================
// KCache_Lookup — check if a kernel for (op, rows, cols) is cached
// Returns slot index (0-2) on hit, -1 on miss.
// =============================================================================
Function.KCache_Lookup {
    Input: kc_op: Integer
    Input: kc_rows: Integer
    Input: kc_cols: Integer
    Output: Integer
    Body: {
        meta = KCacheState.meta_buf
        s = 0
        WhileLoop LessThan(s, KCache.NUM_SLOTS) {
            slot_ptr = Add(meta, Multiply(s, KCache.SLOT_SIZE))
            valid = Dereference(Add(slot_ptr, KCache.OFF_VALID))
            IfCondition EqualTo(valid, 1) ThenBlock: {
                s_op   = Dereference(Add(slot_ptr, KCache.OFF_OP))
                s_rows = Dereference(Add(slot_ptr, KCache.OFF_ROWS))
                s_cols = Dereference(Add(slot_ptr, KCache.OFF_COLS))
                IfCondition EqualTo(s_op, kc_op) ThenBlock: {
                    IfCondition EqualTo(s_rows, kc_rows) ThenBlock: {
                        IfCondition EqualTo(s_cols, kc_cols) ThenBlock: {
                            ReturnValue(s)
                        }
                    }
                }
            }
            s = Add(s, 1)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// KCache_Store — save current CIR/GCN state to cache slot (op-1) index
// Called after CIR_Lower_GCN produces machine code for the first time.
// =============================================================================
Function.KCache_Store {
    Input: ks_op: Integer
    Input: ks_rows: Integer
    Input: ks_cols: Integer
    Output: Integer
    Body: {
        // Use op-1 as slot index (op 1,2,3 → slot 0,1,2)
        slot_idx = Subtract(ks_op, 1)
        IfCondition GreaterEqual(slot_idx, KCache.NUM_SLOTS) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(slot_idx, 0) ThenBlock: { ReturnValue(-1) }

        meta = KCacheState.meta_buf
        slot_ptr = Add(meta, Multiply(slot_idx, KCache.SLOT_SIZE))

        // Check size BEFORE writing metadata — if mc exceeds the 64KB slot
        // buffer we must NOT mark the slot valid, otherwise a future lookup
        // would hit, restore the stale mc_size, and MemoryCopy past the
        // 64KB allocation (heap overflow + garbage shader).
        mc_sz = CIRProg.mc_size
        IfCondition GreaterThan(mc_sz, 65536) ThenBlock: {
            // Invalidate the slot so no stale hit can occur
            StoreValue(Add(slot_ptr, KCache.OFF_VALID), 0)
            ReturnValue(-2)
        }

        // Store metadata
        StoreValue(Add(slot_ptr, KCache.OFF_VALID), 1)
        StoreValue(Add(slot_ptr, KCache.OFF_OP), ks_op)
        StoreValue(Add(slot_ptr, KCache.OFF_ROWS), ks_rows)
        StoreValue(Add(slot_ptr, KCache.OFF_COLS), ks_cols)
        StoreValue(Add(slot_ptr, KCache.OFF_MC_SIZE), CIRProg.mc_size)
        StoreValue(Add(slot_ptr, KCache.OFF_VGPRS), CIRGcn.num_vgprs)
        StoreValue(Add(slot_ptr, KCache.OFF_SGPRS), CIRGcn.num_sgprs)
        StoreValue(Add(slot_ptr, KCache.OFF_GRP_SZ), CIRProg.group_size_x)
        StoreValue(Add(slot_ptr, KCache.OFF_GRID_X), CIRProg.grid_x)

        // Copy machine code bytes to cache
        mc_ptr = Dereference(Add(slot_ptr, KCache.OFF_MC_PTR))
        MemoryCopy(mc_ptr, CIRProg.mc_buf, mc_sz)

        ReturnValue(0)
    }
}

// =============================================================================
// KCache_Restore — restore cached kernel to CIRProg/CIRGcn state
// After this, AccelGCN_Dispatch can proceed as if CIR_Lower_GCN just ran.
// Also rebuilds the CIR buffer descriptors for the given op layout.
// =============================================================================
Function.KCache_Restore {
    Input: kr_slot: Integer
    Output: Integer
    Body: {
        meta = KCacheState.meta_buf
        slot_ptr = Add(meta, Multiply(kr_slot, KCache.SLOT_SIZE))

        // Restore CIRProg fields
        CIRProg.mc_size      = Dereference(Add(slot_ptr, KCache.OFF_MC_SIZE))
        CIRProg.group_size_x = Dereference(Add(slot_ptr, KCache.OFF_GRP_SZ))
        CIRProg.group_size_y = 1
        CIRProg.group_size_z = 1
        CIRProg.grid_x       = Dereference(Add(slot_ptr, KCache.OFF_GRID_X))
        CIRProg.grid_y       = 1
        CIRProg.grid_z        = 1
        CIRProg.lowered      = 1

        // Restore CIRGcn fields
        CIRGcn.num_vgprs = Dereference(Add(slot_ptr, KCache.OFF_VGPRS))
        CIRGcn.num_sgprs = Dereference(Add(slot_ptr, KCache.OFF_SGPRS))

        // Copy cached machine code bytes back to CIRProg.mc_buf
        mc_ptr = Dereference(Add(slot_ptr, KCache.OFF_MC_PTR))
        mc_sz  = CIRProg.mc_size
        MemoryCopy(CIRProg.mc_buf, mc_ptr, mc_sz)

        ReturnValue(0)
    }
}

// =============================================================================
// AccelGCN_Submit — HAL-compatible submit interface
// Reads HALOp fields and translates to CIR+GCN dispatch.
// This bridges the existing Mat.ailang hot path to GPU compute.
// =============================================================================
Function.AccelGCN_Submit {
    Output: Integer
    Body: {
        gcn_op   = HALOp.op
        gcn_dst  = HALOp.dst
        gcn_mat  = HALOp.mat
        gcn_vec  = HALOp.vec
        gcn_rows = HALOp.rows
        gcn_cols = HALOp.cols

        // MatVecMul: dst[i] = sum_j(mat[i,j] * vec[j])
        // This is the core inference operation.
        IfCondition EqualTo(gcn_op, 1) ThenBlock: {
            // Step 1: Compute sizes and VRAM offsets
            // 8 bytes per element (TFElem.Size = 8, 64-bit AILang integers)
            mat_bytes = Multiply(Multiply(gcn_rows, gcn_cols), 8)
            vec_bytes = Multiply(gcn_cols, 8)
            dst_bytes = Multiply(gcn_rows, 8)
            mat_vram = 0
            vec_vram = mat_bytes
            dst_vram = Add(mat_bytes, vec_bytes)

            // Padded dst for safe GPU writes (excess threads in last WG)
            wg_count = Divide(Add(gcn_rows, 63), 64)
            dst_bytes_padded = Multiply(Multiply(wg_count, 64), 8)

            // Check total data fits in VRAM data region
            // BAR=256MB (268435456) - DATA_OFFSET (101179392) = 167256064 bytes
            total_data_size = Add(Add(mat_bytes, vec_bytes), dst_bytes_padded)
            IfCondition GreaterThan(total_data_size, 167256064) ThenBlock: {
                // Too large for single dispatch — tile across multiple dispatches.
                // Each tile processes a chunk of rows. Pick tile_rows so that
                // tile_mat + vec + tile_dst < 150 MB (safe margin).
                // tile_mat = tile_rows * cols * 8
                // Solve: tile_rows * cols * 8 + cols * 8 + tile_rows * 8 < 150_000_000
                //   ≈ tile_rows * cols * 8 < 150_000_000
                //   tile_rows < 150_000_000 / (cols * 8)
                tile_rows = Divide(150000000, Multiply(gcn_cols, 8))
                // Align to workgroup size (64)
                tile_rows = Multiply(Divide(tile_rows, 64), 64)
                IfCondition LessThan(tile_rows, 64) ThenBlock: { tile_rows = 64 }

                tile_start = 0
                WhileLoop LessThan(tile_start, gcn_rows) {
                    tile_end = Add(tile_start, tile_rows)
                    IfCondition GreaterThan(tile_end, gcn_rows) ThenBlock: {
                        tile_end = gcn_rows
                    }
                    tile_n = Subtract(tile_end, tile_start)

                    // Recompute sizes for this tile
                    tile_mat_bytes = Multiply(Multiply(tile_n, gcn_cols), 8)
                    tile_dst_bytes = Multiply(tile_n, 8)
                    tile_wg = Divide(Add(tile_n, 63), 64)
                    tile_dst_pad = Multiply(Multiply(tile_wg, 64), 8)

                    tile_mat_vram = 0
                    tile_vec_vram = tile_mat_bytes
                    tile_dst_vram = Add(tile_mat_bytes, vec_bytes)

                    // Upload tile matrix (rows [tile_start..tile_end) of original mat)
                    tile_mat_src = Add(gcn_mat, Multiply(Multiply(tile_start, gcn_cols), 8))
                    discard = AccelGCN_VramWrite(tile_mat_vram, tile_mat_src, tile_mat_bytes)
                    discard = AccelGCN_VramWrite(tile_vec_vram, gcn_vec, vec_bytes)
                    tmp_zero = Allocate(tile_dst_pad)
                    MemorySet(tmp_zero, 0, tile_dst_pad)
                    discard = AccelGCN_VramWrite(tile_dst_vram, tmp_zero, tile_dst_pad)
                    Deallocate(tmp_zero, tile_dst_pad)

                    // Build kernel for tile dimensions (uses cache)
                    cache_slot = KCache_Lookup(1, tile_n, gcn_cols)
                    IfCondition GreaterEqual(cache_slot, 0) ThenBlock: {
                        discard_kr = KCache_Restore(cache_slot)
                        rc = CIR_BindBuffer(0, tile_mat_vram, tile_mat_bytes, 4, 1)
                        rc = CIR_BindBuffer(1, tile_vec_vram, vec_bytes, 4, 1)
                        rc = CIR_BindBuffer(2, tile_dst_vram, tile_dst_pad, 4, 2)
                        CIRProg.num_bufs = 3
                    }
                    IfCondition LessThan(cache_slot, 0) ThenBlock: {
                        // Emit kernel — reuse the same looped GCN kernel builder
                        // by recursing through HALOp with tile dimensions
                        rc = CIR_Begin()
                        rc = CIR_SetGroupSize(64, 1, 1)
                        rc = CIR_SetGrid(tile_wg, 1, 1)
                        rc = CIR_BindBuffer(0, tile_mat_vram, tile_mat_bytes, 4, 1)
                        rc = CIR_BindBuffer(1, tile_vec_vram, vec_bytes, 4, 1)
                        rc = CIR_BindBuffer(2, tile_dst_vram, tile_dst_pad, 4, 2)

                        // Emit the same looped GCN kernel (copy of the cache-miss path)
                        CIRGcn.mc_pos = 0
                        GCNEnc_Emit_SOP2(38, 8, 4, 255)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        discard = CIRGcn_McEmit32(64)
                        GCNEnc_Emit_VOP2(37, 1, 8, 0)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP1(1, 2, 128)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP1(1, 3, 128)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP1(1, 16, 255)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        discard = CIRGcn_McEmit32(gcn_cols)
                        GCNEnc_Emit_VOP3(361, 4, 257, 272, 0, 0)
                        discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)
                        GCNEnc_Emit_SOP1(3, 9, 128)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_SOP1(3, 10, 255)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        discard = CIRGcn_McEmit32(gcn_cols)
                        loop_start = CIRGcn.mc_pos
                        GCNEnc_Emit_VOP1(1, 16, 9)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP2(37, 5, 260, 16)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP2(26, 6, 129, 5)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP2(37, 7, 129, 6)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP2(26, 14, 129, 16)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP2(37, 15, 129, 14)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP2(26, 17, 130, 6)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_MUBUF(12, 8, 17, 0, 128, 20480)
                        discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)
                        GCNEnc_Emit_VOP2(26, 17, 130, 7)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_MUBUF(12, 9, 17, 0, 128, 20480)
                        discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)
                        GCNEnc_Emit_VOP2(26, 17, 130, 14)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP2(37, 17, 255, 17)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        discard = CIRGcn_McEmit32(tile_vec_vram)
                        GCNEnc_Emit_MUBUF(12, 10, 17, 0, 128, 20480)
                        discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)
                        GCNEnc_Emit_VOP2(26, 17, 130, 15)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP2(37, 17, 255, 17)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        discard = CIRGcn_McEmit32(tile_vec_vram)
                        GCNEnc_Emit_MUBUF(12, 11, 17, 0, 128, 20480)
                        discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)
                        GCNEnc_Emit_S_WAITCNT(0, 0, 0)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP3(361, 12, 264, 266, 0, 0)
                        discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)
                        GCNEnc_Emit_VOP3(362, 13, 264, 266, 0, 0)
                        discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)
                        GCNEnc_Emit_VOP3(361, 14, 264, 267, 0, 0)
                        discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)
                        GCNEnc_Emit_VOP2(37, 13, 269, 14)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP3(361, 15, 265, 266, 0, 0)
                        discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)
                        GCNEnc_Emit_VOP2(37, 13, 269, 15)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP2(37, 2, 258, 12)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP2(40, 3, 259, 13)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_SOP2(0, 9, 9, 129)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_SOPC(10, 9, 10)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        loop_off = Divide(Subtract(loop_start, Add(CIRGcn.mc_pos, 4)), 4)
                        GCNEnc_Emit_SOPP(5, loop_off)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP2(26, 6, 129, 1)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP2(37, 7, 129, 6)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP2(26, 17, 130, 6)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP2(37, 17, 255, 17)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        discard = CIRGcn_McEmit32(tile_dst_vram)
                        GCNEnc_Emit_MUBUF(28, 2, 17, 0, 128, 20480)
                        discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)
                        GCNEnc_Emit_VOP2(26, 17, 130, 7)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_VOP2(37, 17, 255, 17)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        discard = CIRGcn_McEmit32(tile_dst_vram)
                        GCNEnc_Emit_MUBUF(28, 3, 17, 0, 128, 20480)
                        discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)
                        GCNEnc_Emit_S_WAITCNT(0, 0, 0)
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        GCNEnc_Emit_S_ENDPGM()
                        discard = CIRGcn_McEmit32(GCNEncState.word0)
                        CIRProg.mc_size = CIRGcn.mc_pos
                        CIRProg.lowered = 1
                        CIRGcn.num_vgprs = 18
                        CIRGcn.num_sgprs = 11
                        discard_ks = KCache_Store(1, tile_n, gcn_cols)
                    }

                    // Dispatch tile
                    rc = AccelGCN_Dispatch()
                    IfCondition LessThan(rc, 0) ThenBlock: {
                        HALOp.status = -1
                        ReturnValue(-1)
                    }

                    // Read back tile results into correct offset of dst
                    tile_dst_host = Add(gcn_dst, Multiply(tile_start, 8))
                    discard = AccelGCN_VramRead(tile_dst_vram, tile_dst_host, tile_dst_bytes)

                    tile_start = tile_end
                }

                HALOp.status = 1
                ReturnValue(0)
            }

            // Step 2: Upload mat and vec to VRAM, zero dst area (single dispatch path)
            discard = AccelGCN_VramWrite(mat_vram, gcn_mat, mat_bytes)
            discard = AccelGCN_VramWrite(vec_vram, gcn_vec, vec_bytes)
            // Zero dst area in VRAM (so upper 4 bytes of each 8-byte slot stay 0)
            tmp_zero = Allocate(dst_bytes_padded)
            MemorySet(tmp_zero, 0, dst_bytes_padded)
            discard = AccelGCN_VramWrite(dst_vram, tmp_zero, dst_bytes_padded)
            Deallocate(tmp_zero, dst_bytes_padded)

            // Step 3: Build CIR kernel (with cache)
            cache_slot = KCache_Lookup(1, gcn_rows, gcn_cols)
            IfCondition GreaterEqual(cache_slot, 0) ThenBlock: {
                // Cache hit — restore mc + metadata, rebuild buffer descriptors
                discard_kr = KCache_Restore(cache_slot)
                // Rebind with stride=4 (DWORD addressing for 64-bit kernels)
                rc = CIR_BindBuffer(0, mat_vram, mat_bytes, 4, 1)
                rc = CIR_BindBuffer(1, vec_vram, vec_bytes, 4, 1)
                rc = CIR_BindBuffer(2, dst_vram, dst_bytes_padded, 4, 2)
                CIRProg.num_bufs = 3
            }
            IfCondition LessThan(cache_slot, 0) ThenBlock: {
                // Cache miss — emit GCN directly with scalar loop
                // (CIR has no branch/loop ops, so we bypass CIR for the kernel
                //  and emit GCN machine code directly. CIR is still used for
                //  buffer descriptors and dispatch metadata.)
                rc = CIR_Begin()
                rc = CIR_SetGroupSize(64, 1, 1)
                rc = CIR_SetGrid(wg_count, 1, 1)
                rc = CIR_BindBuffer(0, mat_vram, mat_bytes, 4, 1)
                rc = CIR_BindBuffer(1, vec_vram, vec_bytes, 4, 1)
                rc = CIR_BindBuffer(2, dst_vram, dst_bytes_padded, 4, 2)

                // Register plan (all physical):
                //   v0  = thread_id_x (HW preload)
                //   v1  = global_id (row)
                //   v2  = acc_lo
                //   v3  = acc_hi
                //   v4  = row_base = gid * cols  (precomputed)
                //   v5  = a_idx
                //   v6  = a_dw (a_idx*2)
                //   v7  = a_dw+1
                //   v8  = a_lo
                //   v9  = a_hi
                //   v10 = b_lo
                //   v11 = b_hi
                //   v12 = prod_lo
                //   v13 = prod_hi
                //   v14 = temp
                //   v15 = temp2
                //   v16 = k_vreg (copy of s9 for vector add)
                //   v17 = scratch (byte offset calc in MUBUF)
                //   s0-s3 = V# (buffer descriptor, HW)
                //   s4  = group_id_x (HW preload)
                //   s8  = scratch SGPR
                //   s9  = k (loop counter)
                //   s10 = cols (loop bound)
                CIRGcn.mc_pos = 0

                // ── Prologue ──
                // global_id = group_id_x * 64 + thread_id_x
                // S_MUL_I32 s8, s4, 64  (SOP2 op=38)
                GCNEnc_Emit_SOP2(38, 8, 4, 255)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                discard = CIRGcn_McEmit32(64)
                // V_ADD_I32 v1, s8, v0  (VOP2 op=37)
                GCNEnc_Emit_VOP2(37, 1, 8, 0)
                discard = CIRGcn_McEmit32(GCNEncState.word0)

                // acc_lo=0, acc_hi=0
                // V_MOV_B32 v2, 0  (VOP1 op=1, src=128 = inline 0)
                GCNEnc_Emit_VOP1(1, 2, 128)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                // V_MOV_B32 v3, 0
                GCNEnc_Emit_VOP1(1, 3, 128)
                discard = CIRGcn_McEmit32(GCNEncState.word0)

                // row_base = gid * cols → v4
                // V_MOV_B32 v16, literal(cols) — need cols in vreg for MUL
                GCNEnc_Emit_VOP1(1, 16, 255)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                discard = CIRGcn_McEmit32(gcn_cols)
                // V_MUL_LO_U32 v4, v1, v16  (VOP3 op=361)
                GCNEnc_Emit_VOP3(361, 4, 257, 272, 0, 0)
                discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)

                // S_MOV_B32 s9, 0  — loop counter k = 0
                GCNEnc_Emit_SOP1(3, 9, 128)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                // S_MOV_B32 s10, literal(cols)  — loop bound
                GCNEnc_Emit_SOP1(3, 10, 255)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                discard = CIRGcn_McEmit32(gcn_cols)

                // ── Record loop start position ──
                loop_start = CIRGcn.mc_pos

                // ── Loop body ──
                // Copy k to VGPR: V_MOV_B32 v16, s9
                GCNEnc_Emit_VOP1(1, 16, 9)
                discard = CIRGcn_McEmit32(GCNEncState.word0)

                // a_idx = row_base + k → v5
                // V_ADD_I32 v5, v4, v16
                GCNEnc_Emit_VOP2(37, 5, 260, 16)
                discard = CIRGcn_McEmit32(GCNEncState.word0)

                // a_dw = a_idx * 2 → v6: V_LSHLREV_B32 v6, 1, v5
                GCNEnc_Emit_VOP2(26, 6, 129, 5)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                // a_dw+1 → v7: V_ADD_I32 v7, v6, 1
                GCNEnc_Emit_VOP2(37, 7, 129, 6)
                discard = CIRGcn_McEmit32(GCNEncState.word0)

                // k_dw = k * 2 → reuse v14: V_LSHLREV_B32 v14, 1, v16
                GCNEnc_Emit_VOP2(26, 14, 129, 16)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                // k_dw+1 → v15: V_ADD_I32 v15, v14, 1
                GCNEnc_Emit_VOP2(37, 15, 129, 14)
                discard = CIRGcn_McEmit32(GCNEncState.word0)

                // Load mat[a_dw] → v8 (needs byte offset for MUBUF offen)
                // v17 = v6 << 2 (DWORD to byte)
                GCNEnc_Emit_VOP2(26, 17, 130, 6)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                // BUFFER_LOAD_DWORD v8, v17, s[0:3], off offen offset=0
                GCNEnc_Emit_MUBUF(12, 8, 17, 0, 128, 20480)
                discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)

                // Load mat[a_dw+1] → v9
                GCNEnc_Emit_VOP2(26, 17, 130, 7)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                GCNEnc_Emit_MUBUF(12, 9, 17, 0, 128, 20480)
                discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)

                // Load vec[k_dw] → v10: byte offset = buf1_off + v14*4
                // v17 = v14 << 2
                GCNEnc_Emit_VOP2(26, 17, 130, 14)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                // Add buf1 byte offset (vec_vram)
                GCNEnc_Emit_VOP2(37, 17, 255, 17)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                discard = CIRGcn_McEmit32(vec_vram)
                GCNEnc_Emit_MUBUF(12, 10, 17, 0, 128, 20480)
                discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)

                // Load vec[k_dw+1] → v11
                GCNEnc_Emit_VOP2(26, 17, 130, 15)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                GCNEnc_Emit_VOP2(37, 17, 255, 17)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                discard = CIRGcn_McEmit32(vec_vram)
                GCNEnc_Emit_MUBUF(12, 11, 17, 0, 128, 20480)
                discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)

                // S_WAITCNT vmcnt(0) — wait for all loads
                GCNEnc_Emit_S_WAITCNT(0, 0, 0)
                discard = CIRGcn_McEmit32(GCNEncState.word0)

                // 64-bit multiply: prod = a * b
                // prod_lo = MUL_LO(a_lo, b_lo)
                GCNEnc_Emit_VOP3(361, 12, 264, 266, 0, 0)
                discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)
                // prod_hi = MUL_HI(a_lo, b_lo)
                GCNEnc_Emit_VOP3(362, 13, 264, 266, 0, 0)
                discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)
                // t1 = MUL_LO(a_lo, b_hi)
                GCNEnc_Emit_VOP3(361, 14, 264, 267, 0, 0)
                discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)
                // prod_hi += t1
                GCNEnc_Emit_VOP2(37, 13, 269, 14)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                // t2 = MUL_LO(a_hi, b_lo)
                GCNEnc_Emit_VOP3(361, 15, 265, 266, 0, 0)
                discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)
                // prod_hi += t2
                GCNEnc_Emit_VOP2(37, 13, 269, 15)
                discard = CIRGcn_McEmit32(GCNEncState.word0)

                // 64-bit accumulate: acc += prod
                // V_ADD_I32 v2, v2, v12 (sets VCC carry)
                GCNEnc_Emit_VOP2(37, 2, 258, 12)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                // V_ADDC_U32 v3, v3, v13 (reads VCC carry)
                GCNEnc_Emit_VOP2(40, 3, 259, 13)
                discard = CIRGcn_McEmit32(GCNEncState.word0)

                // ── Loop control ──
                // S_ADD_U32 s9, s9, 1  (SOP2 op=0)
                GCNEnc_Emit_SOP2(0, 9, 9, 129)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                // S_CMP_LT_U32 s9, s10  (SOPC op=10) — sets SCC=1 if s9 < s10
                GCNEnc_Emit_SOPC(10, 9, 10)
                discard = CIRGcn_McEmit32(GCNEncState.word0)

                // S_CBRANCH_SCC1 offset (SOPP op=5)
                // offset = (loop_start - (mc_pos + 4)) / 4  (signed DWORDs from next PC)
                loop_off = Divide(Subtract(loop_start, Add(CIRGcn.mc_pos, 4)), 4)
                GCNEnc_Emit_SOPP(5, loop_off)
                discard = CIRGcn_McEmit32(GCNEncState.word0)

                // ── Epilogue: store result ──
                // dst_dw = gid * 2 → v6: V_LSHLREV_B32 v6, 1, v1
                GCNEnc_Emit_VOP2(26, 6, 129, 1)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                // dst_dw+1 → v7: V_ADD_I32 v7, v6, 1
                GCNEnc_Emit_VOP2(37, 7, 129, 6)
                discard = CIRGcn_McEmit32(GCNEncState.word0)

                // byte offset for store: v17 = v6 << 2 + dst_vram
                GCNEnc_Emit_VOP2(26, 17, 130, 6)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                GCNEnc_Emit_VOP2(37, 17, 255, 17)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                discard = CIRGcn_McEmit32(dst_vram)
                // BUFFER_STORE_DWORD v2, v17, s[0:3], off offen
                GCNEnc_Emit_MUBUF(28, 2, 17, 0, 128, 20480)
                discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)

                // byte offset for hi: v17 = v7 << 2 + dst_vram
                GCNEnc_Emit_VOP2(26, 17, 130, 7)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                GCNEnc_Emit_VOP2(37, 17, 255, 17)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                discard = CIRGcn_McEmit32(dst_vram)
                GCNEnc_Emit_MUBUF(28, 3, 17, 0, 128, 20480)
                discard = CIRGcn_McEmit64(GCNEncState.word0, GCNEncState.word1)

                // S_WAITCNT vmcnt(0)
                GCNEnc_Emit_S_WAITCNT(0, 0, 0)
                discard = CIRGcn_McEmit32(GCNEncState.word0)
                // S_ENDPGM
                GCNEnc_Emit_S_ENDPGM()
                discard = CIRGcn_McEmit32(GCNEncState.word0)

                // Set CIRProg metadata for dispatch
                CIRProg.mc_size = CIRGcn.mc_pos
                CIRProg.lowered = 1
                CIRGcn.num_vgprs = 18
                CIRGcn.num_sgprs = 11

                // Store to cache for next time
                discard_ks = KCache_Store(1, gcn_rows, gcn_cols)
            }

            // Step 4: Dispatch
            rc = AccelGCN_Dispatch()
            IfCondition LessThan(rc, 0) ThenBlock: {
                PrintMessage("[AccelGCN] MatVecMul dispatch failed rc=")
                PrintNumber(rc)
                PrintMessage("\n")
                HALOp.status = -1
                ReturnValue(-1)
            }
            // Step 5: Read back full 64-bit results (GPU wrote both lo and hi DWORDs)
            discard = AccelGCN_VramRead(dst_vram, gcn_dst, dst_bytes)

            // Step 6: Return success
            HALOp.status = 1
            ReturnValue(0)
        }

        // MatTVecMul: dst[j] = sum_i(mat[i,j] * vec[i])
        // Transposed matrix-vector multiply. Matrix is row-major [rows x cols].
        // Each output element dst[j] is the dot product of column j with vec.
        IfCondition EqualTo(gcn_op, 2) ThenBlock: {

            // Step 1: Compute sizes and VRAM offsets
            // 8 bytes per element (TFElem.Size = 8, 64-bit AILang integers)
            mat_bytes = Multiply(Multiply(gcn_rows, gcn_cols), 8)
            vec_bytes = Multiply(gcn_rows, 8)
            dst_bytes = Multiply(gcn_cols, 8)
            mat_vram = 0
            vec_vram = mat_bytes
            dst_vram = Add(mat_bytes, vec_bytes)

            // Padded dst for safe GPU writes (excess threads in last WG)
            wg_count = Divide(Add(gcn_cols, 63), 64)
            dst_bytes_padded = Multiply(Multiply(wg_count, 64), 8)

            // Step 2: Upload mat and vec to VRAM, zero dst area
            discard = AccelGCN_VramWrite(mat_vram, gcn_mat, mat_bytes)
            discard = AccelGCN_VramWrite(vec_vram, gcn_vec, vec_bytes)
            // Zero dst area in VRAM (so upper 4 bytes of each 8-byte slot stay 0)
            tmp_zero = Allocate(dst_bytes_padded)
            MemorySet(tmp_zero, 0, dst_bytes_padded)
            discard = AccelGCN_VramWrite(dst_vram, tmp_zero, dst_bytes_padded)
            Deallocate(tmp_zero, dst_bytes_padded)

            // Step 3: Build CIR kernel (with cache)
            cache_slot = KCache_Lookup(2, gcn_rows, gcn_cols)
            IfCondition GreaterEqual(cache_slot, 0) ThenBlock: {
                // Cache hit — restore mc + metadata, rebuild buffer descriptors
                discard_kr = KCache_Restore(cache_slot)
                // Rebind with stride=4 (DWORD addressing for 64-bit kernels)
                rc = CIR_BindBuffer(0, mat_vram, mat_bytes, 4, 1)
                rc = CIR_BindBuffer(1, vec_vram, vec_bytes, 4, 1)
                rc = CIR_BindBuffer(2, dst_vram, dst_bytes_padded, 4, 2)
                CIRProg.num_bufs = 3
            }
            IfCondition LessThan(cache_slot, 0) ThenBlock: {
                // Cache miss — full CIR build + lower
                // 64-bit math: DWORD-indexed buffers (stride=4)
                rc = CIR_Begin()
                rc = CIR_SetGroupSize(64, 1, 1)
                rc = CIR_SetGrid(wg_count, 1, 1)
                rc = CIR_BindBuffer(0, mat_vram, mat_bytes, 4, 1)
                rc = CIR_BindBuffer(1, vec_vram, vec_bytes, 4, 1)
                rc = CIR_BindBuffer(2, dst_vram, dst_bytes_padded, 4, 2)

                v_gid     = CIR_AllocVReg()
                v_acc_lo  = CIR_AllocVReg()
                v_acc_hi  = CIR_AllocVReg()
                v_cols    = CIR_AllocVReg()
                v_two     = CIR_AllocVReg()
                v_one     = CIR_AllocVReg()
                v_i       = CIR_AllocVReg()
                v_i2      = CIR_AllocVReg()
                v_i2p1    = CIR_AllocVReg()
                v_a_idx   = CIR_AllocVReg()
                v_a_idx2  = CIR_AllocVReg()
                v_a_idx2p1 = CIR_AllocVReg()
                v_a_lo    = CIR_AllocVReg()
                v_a_hi    = CIR_AllocVReg()
                v_b_lo    = CIR_AllocVReg()
                v_b_hi    = CIR_AllocVReg()
                v_p_lo    = CIR_AllocVReg()
                v_p_hi    = CIR_AllocVReg()
                v_t1      = CIR_AllocVReg()
                v_t2      = CIR_AllocVReg()
                v_dst_idx2 = CIR_AllocVReg()
                v_dst_idx2p1 = CIR_AllocVReg()

                rc = CIR_Op_GlobalIdX(v_gid)
                rc = CIR_Op_LoadConst(v_cols, gcn_cols)
                rc = CIR_Op_LoadConst(v_two, 2)
                rc = CIR_Op_LoadConst(v_one, 1)
                rc = CIR_Op_LoadConst(v_acc_lo, 0)
                rc = CIR_Op_LoadConst(v_acc_hi, 0)

                i = 0
                WhileLoop LessThan(i, gcn_rows) {
                    // mat element index: a_idx = i * cols + gid (column gid of row i)
                    rc = CIR_Op_LoadConst(v_i, i)
                    rc = CIR_Op_MulLoU32(v_a_idx, v_i, v_cols)
                    rc = CIR_Op_AddU32(v_a_idx, v_a_idx, v_gid)

                    // DWORD indices for mat element
                    rc = CIR_Op_MulLoU32(v_a_idx2, v_a_idx, v_two)
                    rc = CIR_Op_AddU32(v_a_idx2p1, v_a_idx2, v_one)

                    // DWORD indices for vec[i]
                    rc = CIR_Op_MulLoU32(v_i2, v_i, v_two)
                    rc = CIR_Op_AddU32(v_i2p1, v_i2, v_one)

                    // Load 64-bit mat element
                    rc = CIR_Op_LoadBuf(v_a_lo, 0, v_a_idx2)
                    rc = CIR_Op_LoadBuf(v_a_hi, 0, v_a_idx2p1)
                    // Load 64-bit vec element
                    rc = CIR_Op_LoadBuf(v_b_lo, 1, v_i2)
                    rc = CIR_Op_LoadBuf(v_b_hi, 1, v_i2p1)
                    rc = CIR_Op_WaitCnt(0, 0, 0)

                    // 64-bit multiply: prod = a * b (low 64 bits)
                    rc = CIR_Op_MulLoU32(v_p_lo, v_a_lo, v_b_lo)
                    rc = CIR_Op_MulHiU32(v_p_hi, v_a_lo, v_b_lo)
                    rc = CIR_Op_MulLoU32(v_t1, v_a_lo, v_b_hi)
                    rc = CIR_Op_AddU32(v_p_hi, v_p_hi, v_t1)
                    rc = CIR_Op_MulLoU32(v_t2, v_a_hi, v_b_lo)
                    rc = CIR_Op_AddU32(v_p_hi, v_p_hi, v_t2)

                    // 64-bit accumulate: acc += prod
                    rc = CIR_Op_AddU32(v_acc_lo, v_acc_lo, v_p_lo)
                    rc = CIR_Op_AddcU32(v_acc_hi, v_acc_hi, v_p_hi)

                    i = Add(i, 1)
                }

                // Store 64-bit result: dst[gid] = acc
                rc = CIR_Op_MulLoU32(v_dst_idx2, v_gid, v_two)
                rc = CIR_Op_AddU32(v_dst_idx2p1, v_dst_idx2, v_one)
                rc = CIR_Op_StoreBuf(v_acc_lo, 2, v_dst_idx2)
                rc = CIR_Op_StoreBuf(v_acc_hi, 2, v_dst_idx2p1)
                rc = CIR_Op_WaitCnt(0, 0, 0)
                rc = CIR_Op_EndPgm()

                n_insns = CIR_End()
                mc_bytes = CIR_Lower_GCN()

                // Store to cache for next time
                discard_ks = KCache_Store(2, gcn_rows, gcn_cols)
            }

            // Step 4: Dispatch
            rc = AccelGCN_Dispatch()
            IfCondition LessThan(rc, 0) ThenBlock: {
                PrintMessage("[AccelGCN] MatTVecMul dispatch failed rc=")
                PrintNumber(rc)
                PrintMessage("\n")
                HALOp.status = -1
                ReturnValue(-1)
            }

            // Step 5: Read back full 64-bit results (GPU wrote both lo and hi DWORDs)
            discard = AccelGCN_VramRead(dst_vram, gcn_dst, dst_bytes)

            // Step 6: Return success
            HALOp.status = 1
            ReturnValue(0)
        }

        // OuterAccum: mat[i,j] += avec[i] * bvec[j]
        // Outer product accumulation — result is ADDED to the existing matrix.
        IfCondition EqualTo(gcn_op, 3) ThenBlock: {
            gcn_vec2 = HALOp.vec2

            // Step 1: Compute sizes and VRAM offsets
            // 8 bytes per element (64-bit AILang integers)
            mat_bytes  = Multiply(Multiply(gcn_rows, gcn_cols), 8)
            avec_bytes = Multiply(gcn_rows, 8)
            bvec_bytes = Multiply(gcn_cols, 8)

            mat_vram   = 0
            avec_vram  = mat_bytes
            bvec_vram  = Add(mat_bytes, avec_bytes)
            out_vram   = Add(Add(mat_bytes, avec_bytes), bvec_bytes)

            // Padded output for safe GPU writes (excess threads in last WG)
            wg_count = Divide(Add(gcn_rows, 63), 64)
            out_bytes_padded = Multiply(Multiply(Multiply(wg_count, 64), gcn_cols), 8)

            // Step 2: Upload existing mat, avec, bvec to VRAM; zero output area
            discard = AccelGCN_VramWrite(mat_vram, gcn_mat, mat_bytes)
            discard = AccelGCN_VramWrite(avec_vram, gcn_vec, avec_bytes)
            discard = AccelGCN_VramWrite(bvec_vram, gcn_vec2, bvec_bytes)
            // Zero output area so upper 4 bytes of each 8-byte slot stay 0
            tmp_zero = Allocate(out_bytes_padded)
            MemorySet(tmp_zero, 0, out_bytes_padded)
            discard = AccelGCN_VramWrite(out_vram, tmp_zero, out_bytes_padded)
            Deallocate(tmp_zero, out_bytes_padded)

            // Step 3: Build CIR kernel (with cache)
            cache_slot = KCache_Lookup(3, gcn_rows, gcn_cols)
            IfCondition GreaterEqual(cache_slot, 0) ThenBlock: {
                // Cache hit — restore mc + metadata, rebuild buffer descriptors
                discard_kr = KCache_Restore(cache_slot)
                // Rebind with stride=4 (DWORD addressing for 64-bit kernels)
                rc = CIR_BindBuffer(0, mat_vram,  mat_bytes,        4, 1)
                rc = CIR_BindBuffer(1, avec_vram, avec_bytes,       4, 1)
                rc = CIR_BindBuffer(2, bvec_vram, bvec_bytes,       4, 1)
                rc = CIR_BindBuffer(3, out_vram,  out_bytes_padded, 4, 2)
                CIRProg.num_bufs = 4
            }
            IfCondition LessThan(cache_slot, 0) ThenBlock: {
                // Cache miss — full CIR build + lower
                // 64-bit math: DWORD-indexed buffers (stride=4)
                rc = CIR_Begin()
                rc = CIR_SetGroupSize(64, 1, 1)
                rc = CIR_SetGrid(wg_count, 1, 1)
                rc = CIR_BindBuffer(0, mat_vram,  mat_bytes,        4, 1)
                rc = CIR_BindBuffer(1, avec_vram, avec_bytes,       4, 1)
                rc = CIR_BindBuffer(2, bvec_vram, bvec_bytes,       4, 1)
                rc = CIR_BindBuffer(3, out_vram,  out_bytes_padded, 4, 2)

                v_gid       = CIR_AllocVReg()
                v_cols      = CIR_AllocVReg()
                v_two       = CIR_AllocVReg()
                v_one       = CIR_AllocVReg()
                v_gid2      = CIR_AllocVReg()
                v_gid2p1    = CIR_AllocVReg()
                v_avec_lo   = CIR_AllocVReg()
                v_avec_hi   = CIR_AllocVReg()
                v_mat_idx   = CIR_AllocVReg()
                v_mat_idx2  = CIR_AllocVReg()
                v_mat_idx2p1 = CIR_AllocVReg()
                v_k         = CIR_AllocVReg()
                v_k2        = CIR_AllocVReg()
                v_k2p1      = CIR_AllocVReg()
                v_cur_lo    = CIR_AllocVReg()
                v_cur_hi    = CIR_AllocVReg()
                v_bval_lo   = CIR_AllocVReg()
                v_bval_hi   = CIR_AllocVReg()
                v_p_lo      = CIR_AllocVReg()
                v_p_hi      = CIR_AllocVReg()
                v_t1        = CIR_AllocVReg()
                v_t2        = CIR_AllocVReg()
                v_new_lo    = CIR_AllocVReg()
                v_new_hi    = CIR_AllocVReg()

                rc = CIR_Op_GlobalIdX(v_gid)
                rc = CIR_Op_LoadConst(v_cols, gcn_cols)
                rc = CIR_Op_LoadConst(v_two, 2)
                rc = CIR_Op_LoadConst(v_one, 1)

                // Load 64-bit avec[gid]
                rc = CIR_Op_MulLoU32(v_gid2, v_gid, v_two)
                rc = CIR_Op_AddU32(v_gid2p1, v_gid2, v_one)
                rc = CIR_Op_LoadBuf(v_avec_lo, 1, v_gid2)
                rc = CIR_Op_LoadBuf(v_avec_hi, 1, v_gid2p1)
                rc = CIR_Op_WaitCnt(0, 0, 0)

                j = 0
                WhileLoop LessThan(j, gcn_cols) {
                    rc = CIR_Op_LoadConst(v_k, j)

                    // mat element index: mat_idx = gid * cols + j
                    rc = CIR_Op_MulLoU32(v_mat_idx, v_gid, v_cols)
                    rc = CIR_Op_AddU32(v_mat_idx, v_mat_idx, v_k)
                    rc = CIR_Op_MulLoU32(v_mat_idx2, v_mat_idx, v_two)
                    rc = CIR_Op_AddU32(v_mat_idx2p1, v_mat_idx2, v_one)

                    // DWORD indices for bvec[j]
                    rc = CIR_Op_MulLoU32(v_k2, v_k, v_two)
                    rc = CIR_Op_AddU32(v_k2p1, v_k2, v_one)

                    // Load 64-bit existing mat value and bvec value
                    rc = CIR_Op_LoadBuf(v_cur_lo, 0, v_mat_idx2)
                    rc = CIR_Op_LoadBuf(v_cur_hi, 0, v_mat_idx2p1)
                    rc = CIR_Op_LoadBuf(v_bval_lo, 2, v_k2)
                    rc = CIR_Op_LoadBuf(v_bval_hi, 2, v_k2p1)
                    rc = CIR_Op_WaitCnt(0, 0, 0)

                    // 64-bit multiply: prod = avec[gid] * bvec[j]
                    rc = CIR_Op_MulLoU32(v_p_lo, v_avec_lo, v_bval_lo)
                    rc = CIR_Op_MulHiU32(v_p_hi, v_avec_lo, v_bval_lo)
                    rc = CIR_Op_MulLoU32(v_t1, v_avec_lo, v_bval_hi)
                    rc = CIR_Op_AddU32(v_p_hi, v_p_hi, v_t1)
                    rc = CIR_Op_MulLoU32(v_t2, v_avec_hi, v_bval_lo)
                    rc = CIR_Op_AddU32(v_p_hi, v_p_hi, v_t2)

                    // 64-bit add: new = cur + prod
                    rc = CIR_Op_AddU32(v_new_lo, v_cur_lo, v_p_lo)
                    rc = CIR_Op_AddcU32(v_new_hi, v_cur_hi, v_p_hi)

                    // Store 64-bit result
                    rc = CIR_Op_StoreBuf(v_new_lo, 3, v_mat_idx2)
                    rc = CIR_Op_StoreBuf(v_new_hi, 3, v_mat_idx2p1)
                    rc = CIR_Op_WaitCnt(0, 0, 0)

                    j = Add(j, 1)
                }

                rc = CIR_Op_EndPgm()

                n_insns = CIR_End()
                mc_bytes = CIR_Lower_GCN()

                // Store to cache for next time
                discard_ks = KCache_Store(3, gcn_rows, gcn_cols)
            }

            // Step 4: Dispatch
            rc = AccelGCN_Dispatch()
            IfCondition LessThan(rc, 0) ThenBlock: {
                PrintMessage("[AccelGCN] OuterAccum dispatch failed rc=")
                PrintNumber(rc)
                PrintMessage("\n")
                HALOp.status = -1
                ReturnValue(-1)
            }

            // Step 5: Read back full 64-bit results (GPU wrote both lo and hi DWORDs)
            discard = AccelGCN_VramRead(out_vram, gcn_dst, mat_bytes)

            // Step 6: Return success
            HALOp.status = 1
            ReturnValue(0)
        }

        // MatMul: C[i,j] = sum_k(A[i,k] * B[k,j])
        // A is [rows x inner], B is [inner x cols], C is [rows x cols]
        // vec2 carries 'inner' dimension.
        // 1D grid: one thread per output element, gid → (row, col) via divmod.
        IfCondition EqualTo(gcn_op, 4) ThenBlock: {
            gcn_inner = HALOp.vec2

            // Step 1: Sizes and VRAM layout
            a_bytes = Multiply(Multiply(gcn_rows, gcn_inner), 8)
            b_bytes = Multiply(Multiply(gcn_inner, gcn_cols), 8)
            c_elems = Multiply(gcn_rows, gcn_cols)
            c_bytes = Multiply(c_elems, 8)
            a_vram = 0
            b_vram = a_bytes
            c_vram = Add(a_bytes, b_bytes)

            // Padded C for safe GPU writes
            mm_wg_count = Divide(Add(c_elems, 63), 64)
            c_bytes_padded = Multiply(Multiply(mm_wg_count, 64), 8)

            // Step 2: Upload A and B, zero C
            discard = AccelGCN_VramWrite(a_vram, gcn_mat, a_bytes)
            discard = AccelGCN_VramWrite(b_vram, gcn_vec, b_bytes)
            mm_tmp_zero = Allocate(c_bytes_padded)
            MemorySet(mm_tmp_zero, 0, c_bytes_padded)
            discard = AccelGCN_VramWrite(c_vram, mm_tmp_zero, c_bytes_padded)
            Deallocate(mm_tmp_zero, c_bytes_padded)

            // Step 3: Build CIR kernel (with cache)
            cache_slot = KCache_Lookup(4, gcn_rows, gcn_cols)
            IfCondition GreaterEqual(cache_slot, 0) ThenBlock: {
                discard_kr = KCache_Restore(cache_slot)
                rc = CIR_BindBuffer(0, a_vram, a_bytes, 4, 1)
                rc = CIR_BindBuffer(1, b_vram, b_bytes, 4, 1)
                rc = CIR_BindBuffer(2, c_vram, c_bytes_padded, 4, 2)
                CIRProg.num_bufs = 3
            }
            IfCondition LessThan(cache_slot, 0) ThenBlock: {
                // Cache miss — full CIR build
                // Kernel: thread gid computes C[row][col] where
                //   row = gid / cols,  col = gid % cols
                //   C[row,col] = sum_{k=0..inner-1}( A[row*inner+k] * B[k*cols+col] )
                rc = CIR_Begin()
                rc = CIR_SetGroupSize(64, 1, 1)
                rc = CIR_SetGrid(mm_wg_count, 1, 1)
                rc = CIR_BindBuffer(0, a_vram, a_bytes, 4, 1)
                rc = CIR_BindBuffer(1, b_vram, b_bytes, 4, 1)
                rc = CIR_BindBuffer(2, c_vram, c_bytes_padded, 4, 2)

                v_gid     = CIR_AllocVReg()
                v_acc_lo  = CIR_AllocVReg()
                v_acc_hi  = CIR_AllocVReg()
                v_inner   = CIR_AllocVReg()
                v_cols    = CIR_AllocVReg()
                v_two     = CIR_AllocVReg()
                v_one     = CIR_AllocVReg()
                v_row     = CIR_AllocVReg()
                v_col     = CIR_AllocVReg()
                v_row_x_inner = CIR_AllocVReg()
                v_k       = CIR_AllocVReg()
                v_a_idx   = CIR_AllocVReg()
                v_a_idx2  = CIR_AllocVReg()
                v_a_idx2p1 = CIR_AllocVReg()
                v_b_idx   = CIR_AllocVReg()
                v_b_idx2  = CIR_AllocVReg()
                v_b_idx2p1 = CIR_AllocVReg()
                v_a_lo    = CIR_AllocVReg()
                v_a_hi    = CIR_AllocVReg()
                v_b_lo    = CIR_AllocVReg()
                v_b_hi    = CIR_AllocVReg()
                v_p_lo    = CIR_AllocVReg()
                v_p_hi    = CIR_AllocVReg()
                v_t1      = CIR_AllocVReg()
                v_t2      = CIR_AllocVReg()
                v_dst_idx2 = CIR_AllocVReg()
                v_dst_idx2p1 = CIR_AllocVReg()
                v_k_x_cols = CIR_AllocVReg()

                rc = CIR_Op_GlobalIdX(v_gid)
                rc = CIR_Op_LoadConst(v_inner, gcn_inner)
                rc = CIR_Op_LoadConst(v_cols, gcn_cols)
                rc = CIR_Op_LoadConst(v_two, 2)
                rc = CIR_Op_LoadConst(v_one, 1)
                rc = CIR_Op_LoadConst(v_acc_lo, 0)
                rc = CIR_Op_LoadConst(v_acc_hi, 0)

                // Compute row = gid / cols, col = gid % cols
                // For power-of-2 cols: row = gid >> log2, col = gid & (cols-1)
                // For non-power-of-2: fall back to CPU.
                mm_cols_is_p2 = 0
                mm_log2 = 0
                mm_test = gcn_cols
                IfCondition EqualTo(BitwiseAnd(mm_test, Subtract(mm_test, 1)), 0) ThenBlock: {
                    mm_cols_is_p2 = 1
                    mm_shift_test = mm_test
                    WhileLoop GreaterThan(mm_shift_test, 1) {
                        mm_shift_test = Divide(mm_shift_test, 2)
                        mm_log2 = Add(mm_log2, 1)
                    }
                }

                IfCondition EqualTo(mm_cols_is_p2, 0) ThenBlock: {
                    PrintMessage("[AccelGCN] MatMul: cols must be power-of-2 for GPU, got ")
                    PrintNumber(gcn_cols)
                    PrintMessage(" — falling back to CPU\n")
                    HALOp.status = -1
                    ReturnValue(-1)
                }

                // row = gid >> log2(cols), col = gid & (cols - 1)
                v_shift = CIR_AllocVReg()
                v_mask  = CIR_AllocVReg()
                rc = CIR_Op_LoadConst(v_shift, mm_log2)
                rc = CIR_Op_LoadConst(v_mask, Subtract(gcn_cols, 1))
                rc = CIR_Op_ShrU32(v_row, v_gid, v_shift)
                rc = CIR_Op_AndB32(v_col, v_gid, v_mask)

                // Now v_row and v_col hold the output position
                // Compute row * inner (for indexing into A)
                rc = CIR_Op_MulLoU32(v_row_x_inner, v_row, v_inner)

                // Inner loop: unrolled at CIR level (k known at compile time)
                mm_k = 0
                WhileLoop LessThan(mm_k, gcn_inner) {
                    rc = CIR_Op_LoadConst(v_k, mm_k)

                    // A index: row * inner + k → element in A
                    rc = CIR_Op_AddU32(v_a_idx, v_row_x_inner, v_k)
                    rc = CIR_Op_MulLoU32(v_a_idx2, v_a_idx, v_two)
                    rc = CIR_Op_AddU32(v_a_idx2p1, v_a_idx2, v_one)

                    // B index: k * cols + col → element in B
                    rc = CIR_Op_LoadConst(v_k_x_cols, Multiply(mm_k, gcn_cols))
                    rc = CIR_Op_AddU32(v_b_idx, v_k_x_cols, v_col)
                    rc = CIR_Op_MulLoU32(v_b_idx2, v_b_idx, v_two)
                    rc = CIR_Op_AddU32(v_b_idx2p1, v_b_idx2, v_one)

                    // Load A[row, k] (64-bit as 2 DWORDs)
                    rc = CIR_Op_LoadBuf(v_a_lo, 0, v_a_idx2)
                    rc = CIR_Op_LoadBuf(v_a_hi, 0, v_a_idx2p1)
                    // Load B[k, col] (64-bit as 2 DWORDs)
                    rc = CIR_Op_LoadBuf(v_b_lo, 1, v_b_idx2)
                    rc = CIR_Op_LoadBuf(v_b_hi, 1, v_b_idx2p1)
                    rc = CIR_Op_WaitCnt(0, 0, 0)

                    // 64-bit multiply: prod = a * b (low 64 bits)
                    rc = CIR_Op_MulLoU32(v_p_lo, v_a_lo, v_b_lo)
                    rc = CIR_Op_MulHiU32(v_p_hi, v_a_lo, v_b_lo)
                    rc = CIR_Op_MulLoU32(v_t1, v_a_lo, v_b_hi)
                    rc = CIR_Op_AddU32(v_p_hi, v_p_hi, v_t1)
                    rc = CIR_Op_MulLoU32(v_t2, v_a_hi, v_b_lo)
                    rc = CIR_Op_AddU32(v_p_hi, v_p_hi, v_t2)

                    // 64-bit accumulate
                    rc = CIR_Op_AddU32(v_acc_lo, v_acc_lo, v_p_lo)
                    rc = CIR_Op_AddcU32(v_acc_hi, v_acc_hi, v_p_hi)

                    mm_k = Add(mm_k, 1)
                }

                // Store 64-bit result: C[gid] = acc
                rc = CIR_Op_MulLoU32(v_dst_idx2, v_gid, v_two)
                rc = CIR_Op_AddU32(v_dst_idx2p1, v_dst_idx2, v_one)
                rc = CIR_Op_StoreBuf(v_acc_lo, 2, v_dst_idx2)
                rc = CIR_Op_StoreBuf(v_acc_hi, 2, v_dst_idx2p1)
                rc = CIR_Op_WaitCnt(0, 0, 0)
                rc = CIR_Op_EndPgm()

                n_insns = CIR_End()
                mc_bytes = CIR_Lower_GCN()

                discard_ks = KCache_Store(4, gcn_rows, gcn_cols)
            }

            // Step 4: Dispatch
            rc = AccelGCN_Dispatch()
            IfCondition LessThan(rc, 0) ThenBlock: {
                PrintMessage("[AccelGCN] MatMul dispatch failed rc=")
                PrintNumber(rc)
                PrintMessage("\n")
                HALOp.status = -1
                ReturnValue(-1)
            }

            // Step 5: Read back C
            discard = AccelGCN_VramRead(c_vram, gcn_dst, c_bytes)

            // Step 6: Return success
            HALOp.status = 1
            ReturnValue(0)
        }

        PrintMessage("[AccelGCN] unknown op: ")
        PrintNumber(gcn_op)
        PrintMessage("\n")
        HALOp.status = -1
        ReturnValue(-1)
    }
}

// =============================================================================
// AccelGCN_VramWrite — write host data to VRAM data area
// offset: byte offset within the data area
// src: host memory address
// nbytes: number of bytes to copy
// =============================================================================
Function.AccelGCN_VramWrite {
    Input: offset: Integer
    Input: src: Integer
    Input: nbytes: Integer
    Output: Integer
    Body: {
        gpu = AccelGCNCfg.gpu_idx
        vram_state = GPU_BAR_GetState(gpu)
        vram_ptr = Dereference(Add(vram_state, GPUBarField.VRAM_PTR))
        dst = Add(vram_ptr, Add(AccelGCNCfg.data_vram, offset))

        MemoryCopy(dst, src, nbytes)
        // sfence: drain write-combine buffer
        InlineAsm["0f ae f8"]

        // Flush HDP write cache so GPU sees our data in actual VRAM.
        GPU_Wr32(gpu, SIReg.HDP_MEM_COHERENCY_FLUSH_CNTL, 1)

        // PCIe write-posting barrier: MMIO read forces pending posted writes.
        discard_barrier = GPU_Rd32(gpu, SIReg.SCRATCH_REG0)

        ReturnValue(nbytes)
    }
}

// =============================================================================
// AccelGCN_VramRead — read VRAM data area to host memory
// offset: byte offset within the data area
// dst: host memory address
// nbytes: number of bytes to copy
// =============================================================================
Function.AccelGCN_VramRead {
    Input: offset: Integer
    Input: dst: Integer
    Input: nbytes: Integer
    Output: Integer
    Body: {
        gpu = AccelGCNCfg.gpu_idx
        vram_state = GPU_BAR_GetState(gpu)
        vram_ptr = Dereference(Add(vram_state, GPUBarField.VRAM_PTR))
        src = Add(vram_ptr, Add(AccelGCNCfg.data_vram, offset))

        // Flush HDP so CPU reads see GPU-written VRAM, not stale HDP cache
        GPU_Wr32(gpu, SIReg.HDP_MEM_COHERENCY_FLUSH_CNTL, 1)

        // Page-fault priming is now done once at BAR0 map time in
        // GPU_BAR_MapVRAM — no per-call sweep needed here.

        MemoryCopy(dst, src, nbytes)
        ReturnValue(nbytes)
    }
}
