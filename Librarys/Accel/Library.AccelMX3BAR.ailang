//
// Library.AccelMX3BAR.ailang
//
// Userspace BAR mmap + register I/O for the Memryx MX3.
// Opens /sys/bus/pci/devices/0000:02:00.0/resource{0,2,4} and mmap's them
// with O_SYNC + MAP_SHARED for correct MMIO ordering.
// Provides StoreValue/Dereference wrappers that replace ail_writel/ail_readl.
//
// USAGE
//   LibraryImport.Accel.AccelMX3BAR

LibraryImport.ThreadTrampoline
LibraryImport.Drivers.Memryx.MX3Constants

// =============================================================================
// SYSFS RESOURCE PATHS + MMAP CONSTANTS
// =============================================================================
FixedPool.MX3SysFS {
    "res0_path":  Initialize="/sys/bus/pci/devices/0000:02:00.0/resource0"
    "res2_path":  Initialize="/sys/bus/pci/devices/0000:02:00.0/resource2"
    "res4_path":  Initialize="/sys/bus/pci/devices/0000:02:00.0/resource4"
    "MAP_SHARED": Initialize=1
    "O_RDWR":     Initialize=2
    "O_SYNC":     Initialize=1052672    // 0x101000
}

// =============================================================================
// USERSPACE DEVICE STATE
// =============================================================================
FixedPool.MX3User {
    // mmap'd BAR base addresses (userspace virtual)
    "bar0_mmap":       Initialize=0, CanChange=True
    "bar2_mmap":       Initialize=0, CanChange=True
    "bar4_mmap":       Initialize=0, CanChange=True
    "bar0_size":       Initialize=16777216             // 16MB
    "bar2_size":       Initialize=16777216             // 16MB
    "bar4_size":       Initialize=1048576              // 1MB

    // fd's for sysfs resource files (kept open for lifetime)
    "bar0_fd":         Initialize=0, CanChange=True
    "bar2_fd":         Initialize=0, CanChange=True
    "bar4_fd":         Initialize=0, CanChange=True

    // Derived pointers (set after mmap based on BAR mode)
    "xflow_conf":     Initialize=0, CanChange=True    // XFLOW config BAR base
    "xflow_vbuf":     Initialize=0, CanChange=True    // XFLOW vbuf BAR base
    "sram":           Initialize=0, CanChange=True    // SRAM BAR base

    // Device state
    "initialized":    Initialize=0, CanChange=True
    "fw_loaded":      Initialize=0, CanChange=True
    "num_chips":      Initialize=4, CanChange=True
    "bar_mode":       Initialize=3, CanChange=True    // THREE_BAR_16MB

    // Scratch for register polling barrier
    "poll_scratch":   Initialize=0, CanChange=True
}

// =============================================================================
// MX3BAR_MapAll — open + mmap all three BAR resource files
// Returns 0 on success, negative on failure.
// =============================================================================
Function.MX3BAR_MapAll {
    Output: Integer
    Body: {
        // O_RDWR | O_SYNC — O_SYNC is critical for MMIO (prevents write combining)
        open_flags = BitwiseOr(MX3SysFS.O_RDWR, MX3SysFS.O_SYNC)
        prot = BitwiseOr(MmapProt.READ, MmapProt.WRITE)

        // --- BAR0 (resource0): 16MB ---
        fd0 = SystemCall(2, MX3SysFS.res0_path, open_flags, 0)
        IfCondition LessThan(fd0, 0) ThenBlock: {
            PrintMessage("[MX3BAR] open resource0 failed: ")
            PrintNumber(fd0)
            PrintMessage("\n")
            ReturnValue(-1)
        }
        MX3User.bar0_fd = fd0
        base0 = SystemCall(SysNr.MMAP, 0, MX3User.bar0_size, prot, MX3SysFS.MAP_SHARED, fd0, 0)
        IfCondition LessThan(base0, 0) ThenBlock: {
            PrintMessage("[MX3BAR] mmap resource0 failed\n")
            SystemCall(3, fd0)
            ReturnValue(-1)
        }
        MX3User.bar0_mmap = base0
        PrintMessage("[MX3BAR] BAR0 mapped at ")
        PrintNumber(base0)
        PrintMessage("\n")

        // --- BAR2 (resource2): 16MB ---
        fd2 = SystemCall(2, MX3SysFS.res2_path, open_flags, 0)
        IfCondition LessThan(fd2, 0) ThenBlock: {
            PrintMessage("[MX3BAR] open resource2 failed: ")
            PrintNumber(fd2)
            PrintMessage("\n")
            SystemCall(SysNr.MUNMAP, base0, MX3User.bar0_size)
            SystemCall(3, fd0)
            ReturnValue(-1)
        }
        MX3User.bar2_fd = fd2
        base2 = SystemCall(SysNr.MMAP, 0, MX3User.bar2_size, prot, MX3SysFS.MAP_SHARED, fd2, 0)
        IfCondition LessThan(base2, 0) ThenBlock: {
            PrintMessage("[MX3BAR] mmap resource2 failed\n")
            SystemCall(3, fd2)
            SystemCall(SysNr.MUNMAP, base0, MX3User.bar0_size)
            SystemCall(3, fd0)
            ReturnValue(-1)
        }
        MX3User.bar2_mmap = base2
        PrintMessage("[MX3BAR] BAR2 mapped at ")
        PrintNumber(base2)
        PrintMessage("\n")

        // --- BAR4 (resource4): 1MB ---
        fd4 = SystemCall(2, MX3SysFS.res4_path, open_flags, 0)
        IfCondition LessThan(fd4, 0) ThenBlock: {
            PrintMessage("[MX3BAR] open resource4 failed: ")
            PrintNumber(fd4)
            PrintMessage("\n")
            SystemCall(SysNr.MUNMAP, base2, MX3User.bar2_size)
            SystemCall(3, fd2)
            SystemCall(SysNr.MUNMAP, base0, MX3User.bar0_size)
            SystemCall(3, fd0)
            ReturnValue(-1)
        }
        MX3User.bar4_fd = fd4
        base4 = SystemCall(SysNr.MMAP, 0, MX3User.bar4_size, prot, MX3SysFS.MAP_SHARED, fd4, 0)
        IfCondition LessThan(base4, 0) ThenBlock: {
            PrintMessage("[MX3BAR] mmap resource4 failed\n")
            SystemCall(3, fd4)
            SystemCall(SysNr.MUNMAP, base2, MX3User.bar2_size)
            SystemCall(3, fd2)
            SystemCall(SysNr.MUNMAP, base0, MX3User.bar0_size)
            SystemCall(3, fd0)
            ReturnValue(-1)
        }
        MX3User.bar4_mmap = base4
        PrintMessage("[MX3BAR] BAR4 mapped at ")
        PrintNumber(base4)
        PrintMessage("\n")

        ReturnValue(0)
    }
}

// =============================================================================
// MX3BAR_UnmapAll — unmap and close all BAR resource files
// =============================================================================
Function.MX3BAR_UnmapAll {
    Output: Integer
    Body: {
        IfCondition NotEqual(MX3User.bar4_mmap, 0) ThenBlock: {
            SystemCall(SysNr.MUNMAP, MX3User.bar4_mmap, MX3User.bar4_size)
            MX3User.bar4_mmap = 0
        }
        IfCondition NotEqual(MX3User.bar4_fd, 0) ThenBlock: {
            SystemCall(3, MX3User.bar4_fd)
            MX3User.bar4_fd = 0
        }
        IfCondition NotEqual(MX3User.bar2_mmap, 0) ThenBlock: {
            SystemCall(SysNr.MUNMAP, MX3User.bar2_mmap, MX3User.bar2_size)
            MX3User.bar2_mmap = 0
        }
        IfCondition NotEqual(MX3User.bar2_fd, 0) ThenBlock: {
            SystemCall(3, MX3User.bar2_fd)
            MX3User.bar2_fd = 0
        }
        IfCondition NotEqual(MX3User.bar0_mmap, 0) ThenBlock: {
            SystemCall(SysNr.MUNMAP, MX3User.bar0_mmap, MX3User.bar0_size)
            MX3User.bar0_mmap = 0
        }
        IfCondition NotEqual(MX3User.bar0_fd, 0) ThenBlock: {
            SystemCall(3, MX3User.bar0_fd)
            MX3User.bar0_fd = 0
        }
        PrintMessage("[MX3BAR] all BARs unmapped\n")
        ReturnValue(0)
    }
}

// =============================================================================
// REGISTER I/O — replaces ail_writel / ail_readl with pure memory ops
//
// AILang note: Dereference reads 8 bytes, StoreValue writes 8 bytes.
// SRAM registers are 32-bit. For reads, we mask to 32 bits (0xFFFFFFFF).
// For writes, the upper 32 bits (normally 0 for small values) write to the
// adjacent SRAM address. This is safe for SRAM data but must be considered
// for control register sequences.
// =============================================================================

// Read 32-bit from SRAM at MPU address-space addr.
// Translates: addr -> (addr - SRAM_BASE) -> sram mmap + offset
// Masks result to 32 bits (lower DWORD of 8-byte read).
Function.MX3BAR_SramRead32 {
    Input: addr: Integer
    Output: Integer
    Body: {
        sr_offset = Subtract(addr, MX3_ADDR.SRAM_BASE)
        sr_io = Add(MX3User.sram, sr_offset)
        sr_raw = Dereference(sr_io)
        ReturnValue(BitwiseAnd(sr_raw, 4294967295))
    }
}

// Write 32-bit to SRAM at MPU address-space addr.
// Note: StoreValue writes 8 bytes. Upper 32 bits of val are written to addr+4.
// Caller should ensure val fits in 32 bits (upper bits are 0).
Function.MX3BAR_SramWrite32 {
    Input: addr: Integer
    Input: val: Integer
    Body: {
        sw_offset = Subtract(addr, MX3_ADDR.SRAM_BASE)
        sw_io = Add(MX3User.sram, sw_offset)
        // Mask to 32 bits so upper DWORD writes 0 (safe for adjacent SRAM)
        sw_val32 = BitwiseAnd(val, 4294967295)
        StoreValue(sw_io, sw_val32)
    }
}

// Write a block of 8-byte words from host memory to SRAM BAR.
// sram_offset: byte offset from SRAM BAR base (not MPU address)
// src: host memory pointer
// size: bytes to write (should be 8-byte aligned)
Function.MX3BAR_WriteBlock {
    Input: sram_offset: Integer
    Input: src: Integer
    Input: size: Integer
    Body: {
        wb_base = Add(MX3User.sram, sram_offset)
        wb_i = 0
        WhileLoop LessThan(wb_i, size) {
            wb_word = Dereference(Add(src, wb_i))
            StoreValue(Add(wb_base, wb_i), wb_word)
            wb_i = Add(wb_i, 8)
        }
    }
}

// Read a block of 8-byte words from SRAM BAR to host memory.
Function.MX3BAR_ReadBlock {
    Input: sram_offset: Integer
    Input: dst: Integer
    Input: size: Integer
    Body: {
        rb_base = Add(MX3User.sram, sram_offset)
        rb_i = 0
        WhileLoop LessThan(rb_i, size) {
            rb_word = Dereference(Add(rb_base, rb_i))
            StoreValue(Add(dst, rb_i), rb_word)
            rb_i = Add(rb_i, 8)
        }
    }
}

// Trigger a software IRQ on a chip.
// Userspace version of MX3.TriggerDeviceIRQ — writes 1 to IRQ register.
// IRQ offset = (((15 - chip_id) * DEVICE_IRQ_COUNT) + irq_idx) * 4 + 0x200
Function.MX3BAR_TriggerIRQ {
    Input: chip_id: Integer
    Input: sw_irq_idx: Integer
    Body: {
        ti_slot = Subtract(15, chip_id)
        ti_base = Multiply(ti_slot, MX3_IRQ.DEVICE_IRQ_COUNT)
        ti_index = Add(ti_base, sw_irq_idx)
        ti_offset = Add(Multiply(ti_index, 4), MX3_IRQ.OFFSET_BASE)
        ti_addr = Add(MX3User.xflow_vbuf, ti_offset)
        StoreValue(ti_addr, 1)
    }
}

// =============================================================================
// XFLOW REGISTER ACCESS (chip 0 direct — sufficient for single-chip ops)
// =============================================================================

// Write via XFLOW: set base register, set access mode, write through vbuf.
Function.MX3BAR_XflowWrite {
    Input: base_addr: Integer
    Input: offset: Integer
    Input: value: Integer
    Body: {
        // XFLOW config prefix for chip 0 (no chip_id shift needed)
        xw_cfg = Add(MX3User.xflow_conf, MX3_XFLOW.CFG_PREFIX)

        // Set base address register
        StoreValue(Add(xw_cfg, MX3_XFLOW.BASE_REG_OFS), base_addr)

        // Set access mode: 1=SRAM, 0=MPU
        IfCondition GreaterEqual(base_addr, MX3_ADDR.SRAM_BASE) ThenBlock: {
            StoreValue(Add(xw_cfg, MX3_XFLOW.CTRL_REG_OFS), 1)
        } ElseBlock: {
            StoreValue(Add(xw_cfg, MX3_XFLOW.CTRL_REG_OFS), 0)
        }

        // Write value through virtual buffer
        xw_vbuf = Add(MX3User.xflow_vbuf, MX3_XFLOW.VBUF_PREFIX)
        StoreValue(Add(xw_vbuf, offset), value)
    }
}

// Read via XFLOW: set base, set mode, read from vbuf.
Function.MX3BAR_XflowRead {
    Input: base_addr: Integer
    Input: offset: Integer
    Output: Integer
    Body: {
        xr_cfg = Add(MX3User.xflow_conf, MX3_XFLOW.CFG_PREFIX)
        StoreValue(Add(xr_cfg, MX3_XFLOW.BASE_REG_OFS), base_addr)

        IfCondition GreaterEqual(base_addr, MX3_ADDR.SRAM_BASE) ThenBlock: {
            StoreValue(Add(xr_cfg, MX3_XFLOW.CTRL_REG_OFS), 1)
        } ElseBlock: {
            StoreValue(Add(xr_cfg, MX3_XFLOW.CTRL_REG_OFS), 0)
        }

        xr_vbuf = Add(MX3User.xflow_vbuf, MX3_XFLOW.VBUF_PREFIX)
        ReturnValue(Dereference(Add(xr_vbuf, offset)))
    }
}
