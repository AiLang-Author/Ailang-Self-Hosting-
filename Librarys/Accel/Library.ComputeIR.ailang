Function.CIR_Op_SMulI32 {
    Input: dst: Integer
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: { ReturnValue(CIR_Emit(CIR.S_MUL_I32, dst, a, b, 0)) }
}

Function.CIR_Op_SMov {
    Input: dst: Integer
    Input: src: Integer
    Output: Integer
    Body: { ReturnValue(CIR_Emit(CIR.S_MOV, dst, src, 0, 0)) }
}

