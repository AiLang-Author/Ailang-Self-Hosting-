// =============================================================================
// CIR_Dump — print human-readable IR listing (for debugging)
// =============================================================================
Function.CIR_Dump {
    Output: Integer
    Body: {
        n = CIRProg.num_insns
        PrintMessage("[CIR] program: ")
        PrintNumber(n)
        PrintMessage(" instructions, ")
        PrintNumber(CIRProg.next_vreg)
        PrintMessage(" vregs, ")
        PrintNumber(CIRProg.next_sreg)
        PrintMessage(" sregs, ")
        PrintNumber(CIRProg.num_bufs)
        PrintMessage(" buffers\n")
        PrintMessage("[CIR] grid=(")
        PrintNumber(CIRProg.grid_x)
        PrintMessage(",")
        PrintNumber(CIRProg.grid_y)
        PrintMessage(",")
        PrintNumber(CIRProg.grid_z)
        PrintMessage(") group=(")
        PrintNumber(CIRProg.group_size_x)
        PrintMessage(",")
        PrintNumber(CIRProg.group_size_y)
        PrintMessage(",")
        PrintNumber(CIRProg.group_size_z)
        PrintMessage(")\n")

        i = 0
        WhileLoop LessThan(i, n) {
            discard_read = CIR_ReadInsn(i)
            PrintMessage("  ")
            PrintNumber(i)
            PrintMessage(": op=")
            PrintNumber(CIRScratch.op)
            PrintMessage(" dst=")
            PrintNumber(CIRScratch.dst)
            PrintMessage(" src0=")
            PrintNumber(CIRScratch.src0)
            PrintMessage(" src1=")
            PrintNumber(CIRScratch.src1)
            PrintMessage(" src2=")
            PrintNumber(CIRScratch.src2)
            PrintMessage("\n")
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}
