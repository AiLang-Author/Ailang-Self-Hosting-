//
// Library.HAL.ailang
//
// Hardware Abstraction Layer for matrix operation dispatch.
// Routes ops to the active backend: CPU thread pool, MX3, or future accelerators.
// Backend 0 (CPU) is never routed through HAL_Submit — the existing ThrPool
// check in Mat.ailang handles it directly for zero overhead.
//
// USAGE
//   LibraryImport.Accel.HAL

LibraryImport.Accel.AccelCPU
LibraryImport.Accel.AccelMX3
LibraryImport.Accel.AccelGCN

// =============================================================================
// HAL GLOBAL CONFIG
// =============================================================================
FixedPool.HALCfg {
    "backend":     Initialize=0, CanChange=True   // 0=CPU, 1=MX3, 2+=future
    "initialized": Initialize=0, CanChange=True   // 1 after HAL_Init
    "fallback":    Initialize=1, CanChange=True   // 1=fall back to CPU on accel error
    "min_accel":   Initialize=64, CanChange=True  // min dimension for accelerator dispatch
}

// =============================================================================
// HAL SUBMIT CARRIER
// Filled by the HAL dispatch path in Mat.ailang before calling HAL_Submit.
// Same pattern as ThrPool.op/dst/mat/vec/rows/cols.
// =============================================================================
FixedPool.HALOp {
    "op":      Initialize=0, CanChange=True   // 1=MatVecMul, 2=MatTVecMul, 3=OuterAccum
    "dst":     Initialize=0, CanChange=True
    "mat":     Initialize=0, CanChange=True
    "vec":     Initialize=0, CanChange=True
    "vec2":    Initialize=0, CanChange=True   // bvec for OuterAccum
    "rows":    Initialize=0, CanChange=True
    "cols":    Initialize=0, CanChange=True
    "status":  Initialize=0, CanChange=True   // 0=idle, 1=submitted, 2=done, -1=error
}

// =============================================================================
// HAL_Init — initialize the selected backend
// Call once at startup after ThrPool_Init (so CPU backend has working pool).
// Falls back to CPU if accelerator init fails and fallback==1.
// =============================================================================
Function.HAL_Init {
    Output: Integer
    Body: {
        PrintMessage("[HAL] init backend=")
        PrintNumber(HALCfg.backend)
        PrintMessage("\n")

        IfCondition EqualTo(HALCfg.backend, 0) ThenBlock: {
            rc = AccelCPU_Init()
            IfCondition EqualTo(rc, 0) ThenBlock: {
                HALCfg.initialized = 1
            }
            ReturnValue(rc)
        }

        IfCondition EqualTo(HALCfg.backend, 1) ThenBlock: {
            rc = AccelMX3_Init()
            IfCondition EqualTo(rc, 0) ThenBlock: {
                HALCfg.initialized = 1
                PrintMessage("[HAL] MX3 backend ready\n")
                ReturnValue(0)
            }
            // Fallback to CPU if MX3 fails
            IfCondition EqualTo(HALCfg.fallback, 1) ThenBlock: {
                PrintMessage("[HAL] MX3 init failed, falling back to CPU\n")
                HALCfg.backend = 0
                rc = AccelCPU_Init()
                IfCondition EqualTo(rc, 0) ThenBlock: {
                    HALCfg.initialized = 1
                }
                ReturnValue(rc)
            }
            ReturnValue(rc)
        }

        IfCondition EqualTo(HALCfg.backend, 2) ThenBlock: {
            rc = AccelGCN_Init()
            IfCondition EqualTo(rc, 0) ThenBlock: {
                HALCfg.initialized = 1
                PrintMessage("[HAL] GCN backend ready\n")
                ReturnValue(0)
            }
            // Fallback to CPU if GCN fails
            IfCondition EqualTo(HALCfg.fallback, 1) ThenBlock: {
                PrintMessage("[HAL] GCN init failed, falling back to CPU\n")
                HALCfg.backend = 0
                rc = AccelCPU_Init()
                IfCondition EqualTo(rc, 0) ThenBlock: {
                    HALCfg.initialized = 1
                }
                ReturnValue(rc)
            }
            ReturnValue(rc)
        }

        PrintMessage("[HAL] unknown backend\n")
        ReturnValue(-1)
    }
}

// =============================================================================
// HAL_Shutdown — shut down the active backend
// =============================================================================
Function.HAL_Shutdown {
    Output: Integer
    Body: {
        IfCondition EqualTo(HALCfg.initialized, 0) ThenBlock: {
            ReturnValue(0)
        }

        IfCondition EqualTo(HALCfg.backend, 0) ThenBlock: {
            HALCfg.initialized = 0
            ReturnValue(AccelCPU_Shutdown())
        }
        IfCondition EqualTo(HALCfg.backend, 1) ThenBlock: {
            HALCfg.initialized = 0
            ReturnValue(AccelMX3_Shutdown())
        }
        IfCondition EqualTo(HALCfg.backend, 2) ThenBlock: {
            HALCfg.initialized = 0
            ReturnValue(AccelGCN_Shutdown())
        }

        HALCfg.initialized = 0
        ReturnValue(0)
    }
}

// =============================================================================
// HAL_Submit — submit a matrix op to the active backend
// Caller fills HALOp fields first. Synchronous: returns when op is complete.
// Returns 0=success, negative=error.
// =============================================================================
Function.HAL_Submit {
    Output: Integer
    Body: {
        // Backend 0 should never reach here (short-circuited in Mat.ailang)
        IfCondition EqualTo(HALCfg.backend, 0) ThenBlock: {
            ReturnValue(AccelCPU_Submit())
        }
        IfCondition EqualTo(HALCfg.backend, 1) ThenBlock: {
            ReturnValue(AccelMX3_Submit())
        }
        IfCondition EqualTo(HALCfg.backend, 2) ThenBlock: {
            ReturnValue(AccelGCN_Submit())
        }

        ReturnValue(-1)
    }
}
