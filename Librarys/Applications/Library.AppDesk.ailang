// AppDesk — in-app document windows (MDI). Stays inside the host blit.
// Orthogonal to the OS deskbar: no compositor, no GTK child windows.
// Cap is 42. Same number the windowing system now uses.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Display.Render.Framebuffer

FixedPool.AppDeskConst {
    "MAX":        Initialize=42
    "ENTRY":      Initialize=96
    "BAR":        Initialize=24
    "GRIP":       Initialize=14
    "MIN_W":      Initialize=280
    "MIN_H":      Initialize=180
    "HIT_MISS":   Initialize=0
    "HIT_CONTENT": Initialize=1
    "HIT_DRAG":   Initialize=2
    "HIT_CLOSE":  Initialize=3
    "HIT_GRAPH":  Initialize=4
    "HIT_TABLE":  Initialize=5
    "HIT_BOTH":   Initialize=6
    "HIT_RESIZE": Initialize=7
}

FixedPool.AppDeskWin {
    "LIVE":  Initialize=0
    "X":     Initialize=8
    "Y":     Initialize=16
    "W":     Initialize=24
    "H":     Initialize=32
    "OBJ":   Initialize=40
    "MODE":  Initialize=48
    "TITLE": Initialize=56
    "KIND":  Initialize=64
    "YAW":   Initialize=72
    "PITCH": Initialize=80
}

FixedPool.AppDesk {
    "data":      Initialize=0, CanChange=True
    "z":         Initialize=0, CanChange=True
    "n":         Initialize=0, CanChange=True
    "focus":     Initialize=-1, CanChange=True
    "drag":      Initialize=-1, CanChange=True
    "dx":        Initialize=0, CanChange=True
    "dy":        Initialize=0, CanChange=True
    "resize":    Initialize=-1, CanChange=True
    "rw":        Initialize=0, CanChange=True
    "rh":        Initialize=0, CanChange=True
    "hit":       Initialize=0, CanChange=True
    "hit_idx":   Initialize=-1, CanChange=True
}

Function.AppDesk.Ptr {
    Input: idx: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(AppDesk.data, Multiply(idx, AppDeskConst.ENTRY)))
    }
}

Function.AppDesk.Get {
    Input: idx: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(AppDesk.Ptr(idx), field)))
    }
}

Function.AppDesk.Set {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        StoreValue(Add(AppDesk.Ptr(idx), field), val)
        ReturnValue(0)
    }
}

Function.AppDesk.Init {
    Output: Integer
    Body: {
        IfCondition NotEqual(AppDesk.data, 0) ThenBlock: { ReturnValue(1) }
        sz = Multiply(AppDeskConst.MAX, AppDeskConst.ENTRY)
        AppDesk.data = Allocate(sz)
        i = 0
        WhileLoop LessThan(i, sz) {
            SetByte(AppDesk.data, i, 0)
            i = Add(i, 1)
        }
        zb = Multiply(AppDeskConst.MAX, 8)
        AppDesk.z = Allocate(zb)
        zi = 0
        WhileLoop LessThan(zi, AppDeskConst.MAX) {
            StoreValue(Add(AppDesk.z, Multiply(zi, 8)), -1)
            zi = Add(zi, 1)
        }
        AppDesk.n = 0
        AppDesk.focus = -1
        AppDesk.drag = -1
        AppDesk.resize = -1
        ReturnValue(1)
    }
}

Function.AppDesk.Count {
    Output: Integer
    Body: {
        ReturnValue(AppDesk.n)
    }
}

Function.AppDesk.Focus {
    Output: Integer
    Body: {
        ReturnValue(AppDesk.focus)
    }
}

Function.AppDesk.HitKind {
    Output: Integer
    Body: {
        ReturnValue(AppDesk.hit)
    }
}

Function.AppDesk.AtZ {
    Input: zi: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(zi, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(zi, AppDesk.n) ThenBlock: { ReturnValue(-1) }
        ReturnValue(Dereference(Add(AppDesk.z, Multiply(zi, 8))))
    }
}

Function.AppDesk.Raise {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(-1) }
        src = -1
        i = 0
        WhileLoop LessThan(i, AppDesk.n) {
            IfCondition EqualTo(AppDesk.AtZ(i), idx) ThenBlock: { src = i }
            i = Add(i, 1)
        }
        IfCondition LessThan(src, 0) ThenBlock: { ReturnValue(-1) }
        WhileLoop LessThan(src, Subtract(AppDesk.n, 1)) {
            nxt = AppDesk.AtZ(Add(src, 1))
            StoreValue(Add(AppDesk.z, Multiply(src, 8)), nxt)
            src = Add(src, 1)
        }
        StoreValue(Add(AppDesk.z, Multiply(Subtract(AppDesk.n, 1), 8)), idx)
        AppDesk.focus = idx
        ReturnValue(idx)
    }
}

Function.AppDesk.Open {
    Input: obj: Integer
    Input: title: Address
    Input: mode: Integer
    Output: Integer
    Body: {
        AppDesk.Init()
        idx = -1
        i = 0
        WhileLoop LessThan(i, AppDeskConst.MAX) {
            IfCondition EqualTo(AppDesk.Get(i, AppDeskWin.LIVE), 1) ThenBlock: {
                IfCondition EqualTo(AppDesk.Get(i, AppDeskWin.OBJ), obj) ThenBlock: {
                    ReturnValue(AppDesk.Raise(i))
                }
            }
            IfCondition EqualTo(AppDesk.Get(i, AppDeskWin.LIVE), 0) ThenBlock: {
                IfCondition LessThan(idx, 0) ThenBlock: { idx = i }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(-1) }
        k = Modulo(AppDesk.n, 10)
        x = Add(24, Multiply(k, 28))
        y = Add(24, Multiply(k, 24))
        AppDesk.Set(idx, AppDeskWin.LIVE, 1)
        AppDesk.Set(idx, AppDeskWin.X, x)
        AppDesk.Set(idx, AppDeskWin.Y, y)
        AppDesk.Set(idx, AppDeskWin.W, 720)
        AppDesk.Set(idx, AppDeskWin.H, 520)
        AppDesk.Set(idx, AppDeskWin.OBJ, obj)
        AppDesk.Set(idx, AppDeskWin.MODE, mode)
        AppDesk.Set(idx, AppDeskWin.TITLE, title)
        AppDesk.Set(idx, AppDeskWin.YAW, 0x3FEB333333333333)
        AppDesk.Set(idx, AppDeskWin.PITCH, 0x3FE199999999999A)
        StoreValue(Add(AppDesk.z, Multiply(AppDesk.n, 8)), idx)
        AppDesk.n = Add(AppDesk.n, 1)
        AppDesk.focus = idx
        ReturnValue(idx)
    }
}

Function.AppDesk.Close {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(AppDesk.Get(idx, AppDeskWin.LIVE), 0) ThenBlock: { ReturnValue(-1) }
        AppDesk.Set(idx, AppDeskWin.LIVE, 0)
        src = 0
        dst = 0
        WhileLoop LessThan(src, AppDesk.n) {
            w = AppDesk.AtZ(src)
            IfCondition NotEqual(w, idx) ThenBlock: {
                StoreValue(Add(AppDesk.z, Multiply(dst, 8)), w)
                dst = Add(dst, 1)
            }
            src = Add(src, 1)
        }
        AppDesk.n = dst
        IfCondition EqualTo(AppDesk.focus, idx) ThenBlock: {
            AppDesk.focus = -1
            IfCondition GreaterThan(AppDesk.n, 0) ThenBlock: {
                AppDesk.focus = AppDesk.AtZ(Subtract(AppDesk.n, 1))
            }
        }
        ReturnValue(0)
    }
}

Function.AppDesk.CX {
    Input: idx: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(AppDesk.Get(idx, AppDeskWin.X), 2))
    }
}

Function.AppDesk.CY {
    Input: idx: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(AppDesk.Get(idx, AppDeskWin.Y), AppDeskConst.BAR))
    }
}

Function.AppDesk.CW {
    Input: idx: Integer
    Output: Integer
    Body: {
        ReturnValue(Subtract(AppDesk.Get(idx, AppDeskWin.W), 4))
    }
}

Function.AppDesk.CH {
    Input: idx: Integer
    Output: Integer
    Body: {
        ReturnValue(Subtract(Subtract(AppDesk.Get(idx, AppDeskWin.H), AppDeskConst.BAR), 2))
    }
}

Function.AppDesk.DrawChrome {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(AppDesk.Get(idx, AppDeskWin.LIVE), 0) ThenBlock: { ReturnValue(0) }
        x = AppDesk.Get(idx, AppDeskWin.X)
        y = AppDesk.Get(idx, AppDeskWin.Y)
        w = AppDesk.Get(idx, AppDeskWin.W)
        h = AppDesk.Get(idx, AppDeskWin.H)
        blk = FB_RGB(0, 0, 0)
        wht = FB_RGB(255, 255, 255)
        bar = FB_RGB(0, 196, 196)
        IfCondition EqualTo(idx, AppDesk.focus) ThenBlock: { bar = FB_RGB(0, 160, 220) }
        FB_FillRect(x, y, w, h, wht)
        FB_Rect(x, y, w, h, blk)
        FB_FillRect(x, y, w, AppDeskConst.BAR, bar)
        FB_Rect(x, y, w, AppDeskConst.BAR, blk)
        t = AppDesk.Get(idx, AppDeskWin.TITLE)
        IfCondition EqualTo(t, 0) ThenBlock: { t = "Map" }
        FB_DrawString(Add(x, 8), Add(y, 6), t, blk, -1)
        bx = Subtract(Add(x, w), 22)
        FB_FillRect(bx, Add(y, 4), 16, 16, wht)
        FB_Rect(bx, Add(y, 4), 16, 16, blk)
        FB_DrawString(Add(bx, 4), Add(y, 6), "X", blk, -1)
        IfCondition EqualTo(AppDesk.Get(idx, AppDeskWin.KIND), 3) ThenBlock: {
            mx = Subtract(bx, 150)
            IfCondition LessThan(mx, Add(x, 80)) ThenBlock: { mx = Add(x, 80) }
            mode = AppDesk.Get(idx, AppDeskWin.MODE)
            on_g = 0
            on_t = 0
            on_b = 0
            IfCondition EqualTo(mode, 1) ThenBlock: { on_g = 1 }
            IfCondition EqualTo(mode, 2) ThenBlock: { on_t = 1 }
            IfCondition EqualTo(mode, 0) ThenBlock: { on_b = 1 }
            AppDesk.DrawModeBtn(mx, Add(y, 3), "Graph", on_g)
            AppDesk.DrawModeBtn(Add(mx, 48), Add(y, 3), "Table", on_t)
            AppDesk.DrawModeBtn(Add(mx, 96), Add(y, 3), "Both", on_b)
        }
        IfCondition EqualTo(AppDesk.Get(idx, AppDeskWin.KIND), 0) ThenBlock: {
            mx = Subtract(bx, 150)
            IfCondition LessThan(mx, Add(x, 80)) ThenBlock: { mx = Add(x, 80) }
            mode = AppDesk.Get(idx, AppDeskWin.MODE)
            on_g = 0
            on_t = 0
            on_b = 0
            IfCondition EqualTo(mode, 1) ThenBlock: { on_g = 1 }
            IfCondition EqualTo(mode, 2) ThenBlock: { on_t = 1 }
            IfCondition EqualTo(mode, 0) ThenBlock: { on_b = 1 }
            AppDesk.DrawModeBtn(mx, Add(y, 3), "Graph", on_g)
            AppDesk.DrawModeBtn(Add(mx, 48), Add(y, 3), "Table", on_t)
            AppDesk.DrawModeBtn(Add(mx, 96), Add(y, 3), "Both", on_b)
        }
        gx = Subtract(Add(x, w), AppDeskConst.GRIP)
        gy = Subtract(Add(y, h), AppDeskConst.GRIP)
        FB_FillRect(gx, gy, AppDeskConst.GRIP, AppDeskConst.GRIP, FB_RGB(200, 200, 200))
        FB_Rect(gx, gy, AppDeskConst.GRIP, AppDeskConst.GRIP, blk)
        ReturnValue(0)
    }
}

Function.AppDesk.DrawModeBtn {
    Input: x: Integer
    Input: y: Integer
    Input: lab: Address
    Input: on: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(on, 1) ThenBlock: {
            FB_FillRect(x, y, 46, 18, FB_RGB(0, 0, 0))
            FB_DrawString(Add(x, 4), Add(y, 3), lab, FB_RGB(255, 255, 255), -1)
        }
        IfCondition EqualTo(on, 0) ThenBlock: {
            FB_FillRect(x, y, 46, 18, FB_RGB(255, 255, 255))
            FB_Rect(x, y, 46, 18, FB_RGB(0, 0, 0))
            FB_DrawString(Add(x, 4), Add(y, 3), lab, FB_RGB(0, 0, 0), -1)
        }
        ReturnValue(0)
    }
}

Function.AppDesk.HitOne {
    Input: idx: Integer
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        x = AppDesk.Get(idx, AppDeskWin.X)
        y = AppDesk.Get(idx, AppDeskWin.Y)
        w = AppDesk.Get(idx, AppDeskWin.W)
        h = AppDesk.Get(idx, AppDeskWin.H)
        IfCondition LessThan(px, x) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(py, y) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, Add(x, w)) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(py, Add(y, h)) ThenBlock: { ReturnValue(0) }
        gx = Subtract(Add(x, w), AppDeskConst.GRIP)
        gy = Subtract(Add(y, h), AppDeskConst.GRIP)
        IfCondition GreaterEqual(px, gx) ThenBlock: {
            IfCondition GreaterEqual(py, gy) ThenBlock: { ReturnValue(AppDeskConst.HIT_RESIZE) }
        }
        IfCondition LessThan(py, Add(y, AppDeskConst.BAR)) ThenBlock: {
            bx = Subtract(Add(x, w), 22)
            IfCondition GreaterEqual(px, bx) ThenBlock: {
                IfCondition LessThan(px, Add(bx, 16)) ThenBlock: { ReturnValue(AppDeskConst.HIT_CLOSE) }
            }
            wk = AppDesk.Get(idx, AppDeskWin.KIND)
            IfCondition EqualTo(wk, 3) ThenBlock: {
                mx = Subtract(bx, 150)
                IfCondition LessThan(mx, Add(x, 80)) ThenBlock: { mx = Add(x, 80) }
                IfCondition GreaterEqual(px, mx) ThenBlock: {
                    IfCondition LessThan(px, Add(mx, 48)) ThenBlock: { ReturnValue(AppDeskConst.HIT_GRAPH) }
                }
                IfCondition GreaterEqual(px, Add(mx, 48)) ThenBlock: {
                    IfCondition LessThan(px, Add(mx, 96)) ThenBlock: { ReturnValue(AppDeskConst.HIT_TABLE) }
                }
                IfCondition GreaterEqual(px, Add(mx, 96)) ThenBlock: {
                    IfCondition LessThan(px, Add(mx, 144)) ThenBlock: { ReturnValue(AppDeskConst.HIT_BOTH) }
                }
            }
            IfCondition EqualTo(wk, 0) ThenBlock: {
                mx = Subtract(bx, 150)
                IfCondition LessThan(mx, Add(x, 80)) ThenBlock: { mx = Add(x, 80) }
                IfCondition GreaterEqual(px, mx) ThenBlock: {
                    IfCondition LessThan(px, Add(mx, 48)) ThenBlock: { ReturnValue(AppDeskConst.HIT_GRAPH) }
                }
                IfCondition GreaterEqual(px, Add(mx, 48)) ThenBlock: {
                    IfCondition LessThan(px, Add(mx, 96)) ThenBlock: { ReturnValue(AppDeskConst.HIT_TABLE) }
                }
                IfCondition GreaterEqual(px, Add(mx, 96)) ThenBlock: {
                    IfCondition LessThan(px, Add(mx, 144)) ThenBlock: { ReturnValue(AppDeskConst.HIT_BOTH) }
                }
            }
            ReturnValue(AppDeskConst.HIT_DRAG)
        }
        ReturnValue(AppDeskConst.HIT_CONTENT)
    }
}

Function.AppDesk.Down {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        AppDesk.hit = 0
        AppDesk.hit_idx = -1
        AppDesk.drag = -1
        AppDesk.resize = -1
        zi = Subtract(AppDesk.n, 1)
        WhileLoop GreaterEqual(zi, 0) {
            idx = AppDesk.AtZ(zi)
            k = AppDesk.HitOne(idx, px, py)
            IfCondition GreaterThan(k, 0) ThenBlock: {
                AppDesk.Raise(idx)
                AppDesk.hit = k
                AppDesk.hit_idx = idx
                IfCondition EqualTo(k, AppDeskConst.HIT_CLOSE) ThenBlock: {
                    AppDesk.Close(idx)
                    ReturnValue(k)
                }
                IfCondition EqualTo(k, AppDeskConst.HIT_GRAPH) ThenBlock: {
                    AppDesk.Set(idx, AppDeskWin.MODE, 1)
                    ReturnValue(k)
                }
                IfCondition EqualTo(k, AppDeskConst.HIT_TABLE) ThenBlock: {
                    AppDesk.Set(idx, AppDeskWin.MODE, 2)
                    ReturnValue(k)
                }
                IfCondition EqualTo(k, AppDeskConst.HIT_BOTH) ThenBlock: {
                    AppDesk.Set(idx, AppDeskWin.MODE, 0)
                    ReturnValue(k)
                }
                IfCondition EqualTo(k, AppDeskConst.HIT_DRAG) ThenBlock: {
                    AppDesk.drag = idx
                    AppDesk.dx = Subtract(px, AppDesk.Get(idx, AppDeskWin.X))
                    AppDesk.dy = Subtract(py, AppDesk.Get(idx, AppDeskWin.Y))
                    ReturnValue(k)
                }
                IfCondition EqualTo(k, AppDeskConst.HIT_RESIZE) ThenBlock: {
                    AppDesk.resize = idx
                    AppDesk.rw = AppDesk.Get(idx, AppDeskWin.W)
                    AppDesk.rh = AppDesk.Get(idx, AppDeskWin.H)
                    AppDesk.dx = px
                    AppDesk.dy = py
                    ReturnValue(k)
                }
                ReturnValue(k)
            }
            zi = Subtract(zi, 1)
        }
        ReturnValue(0)
    }
}

Function.AppDesk.Move {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(AppDesk.drag, 0) ThenBlock: {
            idx = AppDesk.drag
            nx = Subtract(px, AppDesk.dx)
            ny = Subtract(py, AppDesk.dy)
            IfCondition LessThan(nx, 0) ThenBlock: { nx = 0 }
            IfCondition LessThan(ny, 0) ThenBlock: { ny = 0 }
            AppDesk.Set(idx, AppDeskWin.X, nx)
            AppDesk.Set(idx, AppDeskWin.Y, ny)
            ReturnValue(1)
        }
        IfCondition GreaterEqual(AppDesk.resize, 0) ThenBlock: {
            idx = AppDesk.resize
            nw = Add(AppDesk.rw, Subtract(px, AppDesk.dx))
            nh = Add(AppDesk.rh, Subtract(py, AppDesk.dy))
            IfCondition LessThan(nw, AppDeskConst.MIN_W) ThenBlock: { nw = AppDeskConst.MIN_W }
            IfCondition LessThan(nh, AppDeskConst.MIN_H) ThenBlock: { nh = AppDeskConst.MIN_H }
            AppDesk.Set(idx, AppDeskWin.W, nw)
            AppDesk.Set(idx, AppDeskWin.H, nh)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.AppDesk.Up {
    Output: Integer
    Body: {
        AppDesk.drag = -1
        AppDesk.resize = -1
        ReturnValue(0)
    }
}
