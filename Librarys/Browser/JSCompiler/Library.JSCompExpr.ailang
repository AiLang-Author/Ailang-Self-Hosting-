// M26a: load parent constructor (__super__ local or global)
Function.JSComp__EmitLoadSuperCtor {
    Output: Integer
    Body: {
        sp_name = Add(JSCompState.str_buf, JSCompState.str_pos)
        SetByte(sp_name, 0, 95)
        SetByte(sp_name, 1, 95)
        SetByte(sp_name, 2, 115)
        SetByte(sp_name, 3, 117)
        SetByte(sp_name, 4, 112)
        SetByte(sp_name, 5, 101)
        SetByte(sp_name, 6, 114)
        SetByte(sp_name, 7, 95)
        SetByte(sp_name, 8, 95)
        SetByte(sp_name, 9, 0)
        sl2 = JSComp__FindLocal(sp_name, 9)
        IfCondition GreaterEqual(sl2, 0) ThenBlock: {
            JSComp__EmitOp16(JSOp.GET_LOCAL, sl2)
        } ElseBlock: {
            ci2 = JSComp__AddString(sp_name, 9)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            JSComp__EmitOp16(JSOp.GET_GLOBAL, ci2)
        }
        ReturnValue(0)
    }
}

// M26a/g: SuperBase — instance: parentCtor.prototype; static: parentCtor
// Static: load this (the constructor) then .__super__ (set at class link).
Function.JSComp__EmitLoadSuperBase {
    Output: Integer
    Body: {
        IfCondition EqualTo(JSCompState.in_static_method, 1) ThenBlock: {
            // SuperBase = this.__super__ (static method receiver is the class)
            this_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(this_nm, 0, 116)
            SetByte(this_nm, 1, 104)
            SetByte(this_nm, 2, 105)
            SetByte(this_nm, 3, 115)
            SetByte(this_nm, 4, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 5)
            tci = JSComp__AddString(this_nm, 4)
            JSComp__EmitOp16(JSOp.GET_GLOBAL, tci)
            // "__super__"
            sp_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(sp_nm, 0, 95)
            SetByte(sp_nm, 1, 95)
            SetByte(sp_nm, 2, 115)
            SetByte(sp_nm, 3, 117)
            SetByte(sp_nm, 4, 112)
            SetByte(sp_nm, 5, 101)
            SetByte(sp_nm, 6, 114)
            SetByte(sp_nm, 7, 95)
            SetByte(sp_nm, 8, 95)
            SetByte(sp_nm, 9, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            sci = JSComp__AddString(sp_nm, 9)
            JSComp__EmitOp16(JSOp.GET_PROP, sci)
            ReturnValue(0)
        }
        JSComp__EmitLoadSuperCtor()
        // GET_PROP "prototype"
        proto_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
        SetByte(proto_nm, 0, 112)
        SetByte(proto_nm, 1, 114)
        SetByte(proto_nm, 2, 111)
        SetByte(proto_nm, 3, 116)
        SetByte(proto_nm, 4, 111)
        SetByte(proto_nm, 5, 116)
        SetByte(proto_nm, 6, 121)
        SetByte(proto_nm, 7, 112)
        SetByte(proto_nm, 8, 101)
        SetByte(proto_nm, 9, 0)
        JSCompState.str_pos = Add(JSCompState.str_pos, 10)
        pci = JSComp__AddString(proto_nm, 9)
        JSComp__EmitOp16(JSOp.GET_PROP, pci)
        ReturnValue(0)
    }
}

// ---------------------------------------------------------------------------
// Compile expression — leaves one value on the VM stack
// ---------------------------------------------------------------------------
Function.JSComp__CompileExpr {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node
        IfCondition EqualTo(JSCompState.error, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(save_node, 0) ThenBlock: { ReturnValue(-1) }

        ntype = JSParse_GetType(save_node)

        // --- NUMBER_LIT --- (N_VALUE contains IEEE 754 double bits from parser)
        IfCondition EqualTo(ntype, ASTType.NUMBER_LIT) ThenBlock: {
            nval = JSParse_GetValue(save_node)
            ci = JSComp__AddFloat(nval)
            JSComp__EmitOp16(JSOp.PUSH_CONST, ci)
            ReturnValue(0)
        }

        // --- STRING_LIT ---
        IfCondition EqualTo(ntype, ASTType.STRING_LIT) ThenBlock: {
            sp = JSParse_GetNamePtr(save_node)
            sl = JSParse_GetNameLen(save_node)
            ci = JSComp__AddString(sp, sl)
            JSComp__EmitOp16(JSOp.PUSH_CONST, ci)
            ReturnValue(0)
        }

        // --- BOOL_LIT ---
        IfCondition EqualTo(ntype, ASTType.BOOL_LIT) ThenBlock: {
            bval = JSParse_GetValue(save_node)
            IfCondition EqualTo(bval, 1) ThenBlock: {
                JSComp__Emit1(JSOp.PUSH_TRUE)
            } ElseBlock: {
                JSComp__Emit1(JSOp.PUSH_FALSE)
            }
            ReturnValue(0)
        }

        // --- NULL_LIT ---
        IfCondition EqualTo(ntype, ASTType.NULL_LIT) ThenBlock: {
            JSComp__Emit1(JSOp.PUSH_NULL)
            ReturnValue(0)
        }

        // --- UNDEF_LIT ---
        IfCondition EqualTo(ntype, ASTType.UNDEF_LIT) ThenBlock: {
            JSComp__Emit1(JSOp.PUSH_UNDEF)
            ReturnValue(0)
        }

        // --- REGEX_LIT ---
        // Compiles /pattern/flags as: new RegExp("pattern", "flags")
        IfCondition EqualTo(ntype, ASTType.REGEX_LIT) ThenBlock: {
            // GET_GLOBAL "RegExp"
            rg_ci = JSComp__AddString("RegExp", 6)
            JSComp__EmitOp16(JSOp.GET_GLOBAL, rg_ci)
            // PUSH_CONST pattern
            rp_ptr = JSParse_GetNamePtr(save_node)
            rp_len = JSParse_GetNameLen(save_node)
            rp_ci = JSComp__AddString(rp_ptr, rp_len)
            JSComp__EmitOp16(JSOp.PUSH_CONST, rp_ci)
            // PUSH_CONST flags (stored at N_VALUE)
            rf_ptr = JSParse_GetValue(save_node)
            rf_len = StringLength(rf_ptr)
            rf_ci = JSComp__AddString(rf_ptr, rf_len)
            JSComp__EmitOp16(JSOp.PUSH_CONST, rf_ci)
            // CONSTRUCT 2
            JSComp__Emit1(JSOp.CONSTRUCT)
            JSComp__Emit1(2)
            ReturnValue(0)
        }

        // --- THIS_EXPR ---
        IfCondition EqualTo(ntype, ASTType.THIS_EXPR) ThenBlock: {
            // Emit GET_GLOBAL("this")
            ci = JSComp__AddString("this", 4)
            JSComp__EmitOp16(JSOp.GET_GLOBAL, ci)
            ReturnValue(0)
        }

        // --- IDENT ---
        IfCondition EqualTo(ntype, ASTType.IDENT) ThenBlock: {
            np = JSParse_GetNamePtr(save_node)
            nl = JSParse_GetNameLen(save_node)
            JSComp__EmitVarGet(np, nl)
            ReturnValue(0)
        }

        // --- BINARY_OP ---
        IfCondition EqualTo(ntype, ASTType.BINARY_OP) ThenBlock: {
            bop = JSParse_GetOp(save_node)

            // Comma operator — evaluate left, discard, evaluate right
            IfCondition EqualTo(bop, JSTokType.COMMA) ThenBlock: {
                bl = JSParse_GetLeft(save_node)

                // CLOBBER GUARD: push save_node before CompileExpr
                JSComp__Push(save_node)

                JSComp__CompileExpr(bl)
                JSComp__Emit1(JSOp.POP)

                save_node = JSComp__Pop()

                br = JSParse_GetRight(save_node)
                JSComp__CompileExpr(br)
                ReturnValue(0)
            }

            // Short-circuit AND
            IfCondition EqualTo(bop, JSTokType.AND) ThenBlock: {
                bl = JSParse_GetLeft(save_node)
                JSComp__CompileExpr(bl)
                JSComp__Emit1(JSOp.DUP)
                sc_addr = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                JSComp__Emit1(JSOp.POP)
                br = JSParse_GetRight(save_node)
                JSComp__CompileExpr(br)
                JSComp__PatchJump(sc_addr)
                ReturnValue(0)
            }

            // Short-circuit OR
            IfCondition EqualTo(bop, JSTokType.OR) ThenBlock: {
                bl = JSParse_GetLeft(save_node)
                JSComp__CompileExpr(bl)
                JSComp__Emit1(JSOp.DUP)
                sc_addr = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP_TRUE, 0)
                JSComp__Emit1(JSOp.POP)
                br = JSParse_GetRight(save_node)
                JSComp__CompileExpr(br)
                JSComp__PatchJump(sc_addr)
                ReturnValue(0)
            }

            // Short-circuit nullish coalescing (??)
            IfCondition EqualTo(bop, JSTokType.NULLISH) ThenBlock: {
                bl = JSParse_GetLeft(save_node)
                JSComp__CompileExpr(bl)
                JSComp__Emit1(JSOp.DUP)
                sc_addr = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP_NULLISH, 0)
                JSComp__Emit1(JSOp.POP)
                br = JSParse_GetRight(save_node)
                JSComp__CompileExpr(br)
                JSComp__PatchJump(sc_addr)
                ReturnValue(0)
            }

            // Normal binary ops
            bl = JSParse_GetLeft(save_node)

            // CLOBBER GUARD: push save_node and bop before recursive compile
            JSComp__Push(save_node)
            JSComp__Push(bop)

            JSComp__CompileExpr(bl)

            bop = JSComp__Pop()
            save_node = JSComp__Pop()

            br = JSParse_GetRight(save_node)

            JSComp__Push(bop)

            JSComp__CompileExpr(br)

            bop = JSComp__Pop()

            vm_op = JSComp__MapBinOp(bop)
            JSComp__Emit1(vm_op)
            ReturnValue(0)
        }

        // --- UNARY_OP ---
        IfCondition EqualTo(ntype, ASTType.UNARY_OP) ThenBlock: {
            uop = JSParse_GetOp(save_node)
            ul = JSParse_GetLeft(save_node)

            // delete obj.prop / delete obj[key] — must not evaluate to the value
            IfCondition EqualTo(uop, JSTokType.KW_DELETE) ThenBlock: {
                ul_type = JSParse_GetType(ul)
                // delete o.x → compile o, push "x", DELETE_PROP
                IfCondition EqualTo(ul_type, ASTType.MEMBER_DOT) ThenBlock: {
                    obj = JSParse_GetLeft(ul)
                    JSComp__Push(ul)
                    JSComp__CompileExpr(obj)
                    ul = JSComp__Pop()
                    pnp = JSParse_GetNamePtr(ul)
                    pnl = JSParse_GetNameLen(ul)
                    ci = JSComp__AddString(pnp, pnl)
                    JSComp__EmitOp16(JSOp.PUSH_CONST, ci)
                    JSComp__Emit1(JSOp.DELETE_PROP)
                    ReturnValue(0)
                }
                // delete o[k] → compile o, compile k, DELETE_PROP
                IfCondition EqualTo(ul_type, ASTType.MEMBER_BRACKET) ThenBlock: {
                    obj = JSParse_GetLeft(ul)
                    key = JSParse_GetRight(ul)
                    JSComp__Push(ul)
                    JSComp__CompileExpr(obj)
                    ul = JSComp__Pop()
                    key = JSParse_GetRight(ul)
                    JSComp__CompileExpr(key)
                    JSComp__Emit1(JSOp.DELETE_PROP)
                    ReturnValue(0)
                }
                // delete ident / other — eval for side effects, push true
                // (strict ReferenceError not implemented; non-strict returns true)
                JSComp__CompileExpr(ul)
                JSComp__Emit1(JSOp.POP)
                JSComp__Emit1(JSOp.PUSH_TRUE)
                ReturnValue(0)
            }

            JSComp__CompileExpr(ul)
            IfCondition EqualTo(uop, JSTokType.MINUS) ThenBlock: {
                JSComp__Emit1(JSOp.NEG)
            }
            IfCondition EqualTo(uop, JSTokType.NOT) ThenBlock: {
                JSComp__Emit1(JSOp.NOT)
            }
            IfCondition EqualTo(uop, JSTokType.TILDE) ThenBlock: {
                JSComp__Emit1(JSOp.BIT_NOT)
            }
            IfCondition EqualTo(uop, JSTokType.KW_VOID) ThenBlock: {
                // void expr: evaluate for side effects, discard, push undefined
                JSComp__Emit1(JSOp.POP)
                JSComp__Emit1(JSOp.PUSH_UNDEF)
            }
            IfCondition EqualTo(uop, JSTokType.PLUS) ThenBlock: {
                // unary +: ToNumber coercion (for now, identity on numbers)
                // Just leave value on stack - handles most cases
            }
            ReturnValue(0)
        }

        // --- TYPEOF_EXPR ---
        // typeof undeclaredIdentifier → "undefined" (no ReferenceError).
        // Use GET_GLOBAL_SOFT for bare IDENT; normal GET_GLOBAL throws.
        IfCondition EqualTo(ntype, ASTType.TYPEOF_EXPR) ThenBlock: {
            tl = JSParse_GetLeft(save_node)
            tl_type = JSParse_GetType(tl)
            IfCondition EqualTo(tl_type, ASTType.IDENT) ThenBlock: {
                // Prefer local if bound, else soft global
                np = JSParse_GetNamePtr(tl)
                nl = JSParse_GetNameLen(tl)
                slot = JSComp__FindLocal(np, nl)
                IfCondition GreaterEqual(slot, 0) ThenBlock: {
                    // TDZ still applies for let/const
                    IfCondition And(LessThan(slot, 256), EqualTo(GetByte(JSCompState.tdz_map, slot), 1)) ThenBlock: {
                        ci = JSComp__AddString(np, nl)
                        JSComp__EmitOp16(JSOp.THROW_TDZ, ci)
                    } ElseBlock: {
                        IfCondition EqualTo(JSCompState.func_nesting, 0) ThenBlock: {
                            ci = JSComp__AddString(np, nl)
                            JSComp__EmitOp16(JSOp.GET_GLOBAL_SOFT, ci)
                        } ElseBlock: {
                            JSComp__EmitOp16(JSOp.GET_LOCAL, slot)
                        }
                    }
                } ElseBlock: {
                    ci = JSComp__AddString(np, nl)
                    JSComp__EmitOp16(JSOp.GET_GLOBAL_SOFT, ci)
                }
            } ElseBlock: {
                JSComp__CompileExpr(tl)
            }
            JSComp__Emit1(JSOp.TYPEOF)
            ReturnValue(0)
        }

        // --- ASSIGN ---
        IfCondition EqualTo(ntype, ASTType.ASSIGN) ThenBlock: {
            // Save assign node + left child in JSCompDot BEFORE any calls
            // so they survive the chain of JSParse_Get* function calls.
            JSCompDot.assign_node = save_node
            JSCompDot.member_node = JSParse_GetLeft(JSCompDot.assign_node)
            aop = JSParse_GetOp(JSCompDot.assign_node)
            JSComp__Push(aop)
            al_type = JSParse_GetType(JSCompDot.member_node)
            aop = JSComp__Pop()

            // Now: JSCompDot.assign_node = ASSIGN node
            //      JSCompDot.member_node = left child (target)
            //      aop = operator token type
            //      al_type = type of left child

            // Compound assignment (+=, -=, *=, /=)
            IfCondition NotEqual(aop, JSTokType.ASSIGN) ThenBlock: {
                // Save member_node before recursive calls can clobber it
                saved_ca_member = JSCompDot.member_node
                saved_ca_assign = JSCompDot.assign_node
                al_type = JSParse_GetType(saved_ca_member)

                // M19d: base[prop] op= rhs — evaluate base+key once (S11.13.2 A7 T4)
                // Use SET_GLOBAL temps (not SET_LOCAL): top-level only reserves
                // CountVars slots; extra AddLocal would overflow the local frame.
                IfCondition EqualTo(al_type, ASTType.MEMBER_BRACKET) ThenBlock: {
                    // const pool ids for "__cb__" / "__ck__"
                    cb_ci = JSComp__AddString("__cb__", 6)
                    ck_ci = JSComp__AddString("__ck__", 6)

                    // ES5 MemberExpression order:
                    //   base, property, CheckObjectCoercible(base), ToPropertyKey(prop)
                    // compile base → SET_GLOBAL __cb__
                    JSComp__Push(aop)
                    JSComp__Push(cb_ci)
                    JSComp__Push(ck_ci)
                    JSCompDot.member_node = saved_ca_member
                    JSComp__CompileExpr(JSParse_GetLeft(saved_ca_member))
                    ck_ci = JSComp__Pop()
                    cb_ci = JSComp__Pop()
                    aop = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, cb_ci)

                    // compile key (raw) — before coercible check so prop() can throw first
                    JSComp__Push(aop)
                    JSComp__Push(cb_ci)
                    JSComp__Push(ck_ci)
                    JSCompDot.member_node = saved_ca_member
                    JSComp__CompileExpr(JSParse_GetRight(saved_ca_member))
                    ck_ci = JSComp__Pop()
                    cb_ci = JSComp__Pop()
                    aop = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, ck_ci)

                    // CheckObjectCoercible(base) then ToPropertyKey once → string __ck__
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, cb_ci)
                    JSComp__Emit1(JSOp.CHECK_COERCIBLE)
                    JSComp__Emit1(JSOp.POP)
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, ck_ci)
                    JSComp__Emit1(JSOp.TO_PROP_KEY)
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, ck_ci)

                    // GET_GLOBAL base, GET_GLOBAL key, GET_ELEM → LHS value
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, cb_ci)
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, ck_ci)
                    JSComp__Emit1(JSOp.GET_ELEM)

                    // RHS
                    JSComp__Push(aop)
                    JSComp__Push(cb_ci)
                    JSComp__Push(ck_ci)
                    JSCompDot.member_node = saved_ca_member
                    JSCompDot.assign_node = saved_ca_assign
                    JSComp__CompileExpr(JSParse_GetRight(saved_ca_assign))
                    ck_ci = JSComp__Pop()
                    cb_ci = JSComp__Pop()
                    aop = JSComp__Pop()

                    // emit op
                    IfCondition EqualTo(aop, JSTokType.PLUS_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.ADD) }
                    IfCondition EqualTo(aop, JSTokType.MINUS_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.SUB) }
                    IfCondition EqualTo(aop, JSTokType.STAR_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.MUL) }
                    IfCondition EqualTo(aop, JSTokType.SLASH_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.DIV) }
                    IfCondition EqualTo(aop, JSTokType.PERCENT_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.MOD) }
                    IfCondition EqualTo(aop, JSTokType.AMP_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.BIT_AND) }
                    IfCondition EqualTo(aop, JSTokType.PIPE_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.BIT_OR) }
                    IfCondition EqualTo(aop, JSTokType.CARET_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.BIT_XOR) }
                    IfCondition EqualTo(aop, JSTokType.SHL_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.SHL) }
                    IfCondition EqualTo(aop, JSTokType.SHR_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.SHR) }
                    IfCondition EqualTo(aop, JSTokType.USHR_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.USHR) }
                    IfCondition EqualTo(aop, JSTokType.STAR_STAR_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.EXP) }
                    IfCondition EqualTo(aop, JSTokType.AND_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.POP) }
                    IfCondition EqualTo(aop, JSTokType.OR_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.POP) }
                    IfCondition EqualTo(aop, JSTokType.NULLISH_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.POP) }

                    // SET_ELEM with saved base/key — stack [result, base, key]
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, cb_ci)
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, ck_ci)
                    JSComp__Emit1(JSOp.SET_ELEM)
                    JSComp__Emit1(JSOp.PUSH_UNDEF)
                    ReturnValue(0)
                }

                // Load current value — use JSCompDot.member_node (survives calls)
                JSComp__Push(aop)
                JSCompDot.member_node = saved_ca_member
                JSComp__CompileExpr(JSCompDot.member_node)
                aop = JSComp__Pop()

                // Load RHS
                JSComp__Push(aop)
                JSCompDot.member_node = saved_ca_member
                JSCompDot.assign_node = saved_ca_assign
                JSComp__CompileExpr(JSParse_GetRight(JSCompDot.assign_node))
                aop = JSComp__Pop()

                // Emit compound op
                IfCondition EqualTo(aop, JSTokType.PLUS_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.ADD)
                }
                IfCondition EqualTo(aop, JSTokType.MINUS_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.SUB)
                }
                IfCondition EqualTo(aop, JSTokType.STAR_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.MUL)
                }
                IfCondition EqualTo(aop, JSTokType.SLASH_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.DIV)
                }
                IfCondition EqualTo(aop, JSTokType.PERCENT_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.MOD)
                }
                IfCondition EqualTo(aop, JSTokType.AMP_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.BIT_AND)
                }
                IfCondition EqualTo(aop, JSTokType.PIPE_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.BIT_OR)
                }
                IfCondition EqualTo(aop, JSTokType.CARET_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.BIT_XOR)
                }
                IfCondition EqualTo(aop, JSTokType.SHL_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.SHL)
                }
                IfCondition EqualTo(aop, JSTokType.SHR_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.SHR)
                }
                IfCondition EqualTo(aop, JSTokType.USHR_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.USHR)
                }
                IfCondition EqualTo(aop, JSTokType.STAR_STAR_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.EXP)
                }
                // Logical assignment: &&= evaluates as x && (x = y),
                // ||= as x || (x = y). For now, simplified to load+eval+store.
                // TODO: proper short-circuit requires restructured emission.
                IfCondition EqualTo(aop, JSTokType.AND_ASSIGN) ThenBlock: {
                    // drop LHS, keep RHS (simplified: always assign)
                    JSComp__Emit1(JSOp.POP)
                }
                IfCondition EqualTo(aop, JSTokType.OR_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.POP)
                }
                IfCondition EqualTo(aop, JSTokType.NULLISH_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.POP)
                }

                // Store result — MEMBER_DOT / IDENT (bracket handled above)
                al_type = JSParse_GetType(saved_ca_member)

                // obj.prop op= expr → stack has [result], emit obj, SET_PROP
                IfCondition EqualTo(al_type, ASTType.MEMBER_DOT) ThenBlock: {
                    ca_pnp = JSParse_GetNamePtr(saved_ca_member)
                    ca_pnl = JSParse_GetNameLen(saved_ca_member)
                    JSComp__Push(ca_pnp)
                    JSComp__Push(ca_pnl)
                    JSCompDot.member_node = saved_ca_member
                    JSComp__CompileExpr(JSParse_GetLeft(saved_ca_member))
                    ca_pnl = JSComp__Pop()
                    ca_pnp = JSComp__Pop()
                    // SWAP so stack is [obj, result] for SET_PROP
                    JSComp__Emit1(JSOp.SWAP)
                    ci = JSComp__AddString(ca_pnp, ca_pnl)
                    JSComp__EmitOp16(JSOp.SET_PROP, ci)
                    JSComp__Emit1(JSOp.PUSH_UNDEF)
                    ReturnValue(0)
                }

                // Restore for IDENT fallthrough (compound += etc.)
                JSCompDot.member_node = saved_ca_member
                id_np = 0
                id_nl = 0
                IfCondition EqualTo(al_type, ASTType.IDENT) ThenBlock: {
                    id_np = JSParse_GetNamePtr(saved_ca_member)
                    id_nl = JSParse_GetNameLen(saved_ca_member)
                }
            } ElseBlock: {
                                // Simple assignment — handle destructuring patterns first
                IfCondition Or(EqualTo(al_type, ASTType.ARRAY_PATTERN),
                              EqualTo(al_type, ASTType.OBJECT_PATTERN)) ThenBlock: {
                    // Destructuring assignment: compile RHS, store in __dt__, dispatch.
                    // Stash RHS in global so expression result is correct if pattern
                    // leaves stack noise (rest loop / temps) — M20b.
                    JSComp__CompileExpr(JSParse_GetRight(JSCompDot.assign_node))
                    dstr_ci = JSComp__AddString("__dstr_rhs__", 11)
                    JSComp__Emit1(JSOp.DUP)
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, dstr_ci)

                    // Store in __dt__ temp local for pattern
                    da_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                    SetByte(da_nm, 0, 95)
                    SetByte(da_nm, 1, 95)
                    SetByte(da_nm, 2, 100)
                    SetByte(da_nm, 3, 116)
                    SetByte(da_nm, 4, 95)
                    SetByte(da_nm, 5, 95)
                    SetByte(da_nm, 6, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 7)

                    da_slot = JSComp__AddLocal(da_nm, 6)
                    JSComp__EmitOp16(JSOp.SET_LOCAL, da_slot)

                    // Dispatch on pattern type
                    IfCondition EqualTo(al_type, ASTType.ARRAY_PATTERN) ThenBlock: {
                        JSComp__CompileArrayPattern(JSCompDot.member_node, da_slot)
                    } ElseBlock: {
                        JSComp__CompileObjPattern(JSCompDot.member_node, da_slot)
                    }
                    // Assignment expression value is always the RHS
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, dstr_ci)
                    ReturnValue(0)
                }// Handle MEMBER_DOT/BRACKET separately
                // because SET_PROP expects [obj, val] stack order
                IfCondition EqualTo(al_type, ASTType.MEMBER_DOT) ThenBlock: {
                    // Compile: object, value, SET_PROP
                    // Stack: [obj, val] → SET_PROP pops val then obj → correct
                    //
                    // Save JSCompDot fields before recursive compilation.
                    // Inner assignments (e.g. this.x = v inside function body)
                    // can clobber JSCompDot.member_node and .assign_node.
                    saved_member = JSCompDot.member_node
                    saved_assign = JSCompDot.assign_node

                    // Capture name ptr/len BEFORE any recursive calls
                    dot_pnp = JSParse_GetNamePtr(saved_member)
                    dot_pnl = JSParse_GetNameLen(saved_member)

                    // Compile the object expression (LHS of the dot)
                    dot_obj_node = JSParse_GetLeft(saved_member)
                    dot_rhs_node = JSParse_GetRight(saved_assign)

                    JSComp__Push(dot_pnp)
                    JSComp__Push(dot_pnl)
                    JSComp__Push(dot_rhs_node)
                    JSComp__CompileExpr(dot_obj_node)
                    dot_rhs_node = JSComp__Pop()
                    dot_pnl = JSComp__Pop()
                    dot_pnp = JSComp__Pop()

                    // Compile the value expression (RHS of =)
                    JSComp__Push(dot_pnp)
                    JSComp__Push(dot_pnl)
                    JSComp__CompileExpr(dot_rhs_node)
                    dot_pnl = JSComp__Pop()
                    dot_pnp = JSComp__Pop()

                    // Assignment result is RHS: stash, SET_PROP, restore
                    // Stack [obj, val] → DUP → SET_GLOBAL temp → SET_PROP → GET_GLOBAL temp
                    asv_ci = JSComp__AddString("__asv__", 6)
                    JSComp__Emit1(JSOp.DUP)
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, asv_ci)
                    ci = JSComp__AddString(dot_pnp, dot_pnl)
                    JSComp__EmitOp16(JSOp.SET_PROP, ci)
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, asv_ci)
                    ReturnValue(0)
                }
                IfCondition EqualTo(al_type, ASTType.MEMBER_BRACKET) ThenBlock: {
                    // M20: evaluate LHS (base, key) before RHS (spec order).
                    // Key left raw — SET_ELEM ToPropertyKey once (no double convert).
                    // Temps on globals (__cb__/__ck__).
                    saved_member_b = JSCompDot.member_node
                    saved_assign_b = JSCompDot.assign_node
                    br_rhs = JSParse_GetRight(saved_assign_b)
                    br_obj = JSParse_GetLeft(saved_member_b)
                    br_key = JSParse_GetRight(saved_member_b)
                    cb_ci = JSComp__AddString("__cb__", 6)
                    ck_ci = JSComp__AddString("__ck__", 6)

                    // base → __cb__
                    JSComp__Push(br_rhs)
                    JSComp__Push(cb_ci)
                    JSComp__Push(ck_ci)
                    JSComp__CompileExpr(br_obj)
                    ck_ci = JSComp__Pop()
                    cb_ci = JSComp__Pop()
                    br_rhs = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, cb_ci)

                    // key (raw) → __ck__
                    JSComp__Push(br_rhs)
                    JSComp__Push(cb_ci)
                    JSComp__Push(ck_ci)
                    JSComp__CompileExpr(br_key)
                    ck_ci = JSComp__Pop()
                    cb_ci = JSComp__Pop()
                    br_rhs = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, ck_ci)

                    // RHS, then base, key, SET_ELEM — stack [value, array, index]
                    JSComp__Push(cb_ci)
                    JSComp__Push(ck_ci)
                    JSComp__CompileExpr(br_rhs)
                    ck_ci = JSComp__Pop()
                    cb_ci = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, cb_ci)
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, ck_ci)
                    JSComp__Emit1(JSOp.SET_ELEM)
                    JSComp__Emit1(JSOp.PUSH_UNDEF)
                    ReturnValue(0)
                }

                // IDENT and other targets: compile RHS, DUP, store.
                // MUST save LHS before CompileExpr — nested function bodies
                // with free-var assigns clobber JSCompDot.member_node (same
                // class as MEMBER_DOT fix). Without this, `var n=0; var f;
                // f = function(){ n=1 }` stores the function into n, not f.
                saved_id_member = JSCompDot.member_node
                saved_id_assign = JSCompDot.assign_node
                saved_id_altype = al_type
                id_np = 0
                id_nl = 0
                IfCondition EqualTo(al_type, ASTType.IDENT) ThenBlock: {
                    id_np = JSParse_GetNamePtr(saved_id_member)
                    id_nl = JSParse_GetNameLen(saved_id_member)
                }
                JSComp__Push(id_np)
                JSComp__Push(id_nl)
                JSComp__Push(saved_id_altype)
                JSComp__CompileExpr(JSParse_GetRight(saved_id_assign))
                al_type = JSComp__Pop()
                id_nl = JSComp__Pop()
                id_np = JSComp__Pop()
            }

            // DUP so assignment leaves value on stack (for expr result)
            JSComp__Emit1(JSOp.DUP)

            // Emit store based on target type
            IfCondition EqualTo(al_type, ASTType.IDENT) ThenBlock: {
                JSComp__EmitVarSet(id_np, id_nl)
            }
            ReturnValue(0)
        }

        // --- CALL ---
        IfCondition EqualTo(ntype, ASTType.CALL) ThenBlock: {
            callee = JSParse_GetLeft(save_node)
            argc = JSParse_GetValue(save_node)

            // Check if any arg is SPREAD_ELEMENT
            has_spread = 0
            scan_arg = JSParse_GetRight(save_node)
            WhileLoop GreaterEqual(scan_arg, 0) {
                IfCondition EqualTo(JSParse_GetType(scan_arg), ASTType.SPREAD_ELEMENT) ThenBlock: {
                    has_spread = 1
                }
                scan_arg = JSParse_GetNext(scan_arg)
            }

            // Detect method call: callee is MEMBER_DOT or MEMBER_BRACKET
            // In that case, we need to keep the receiver on the stack for this binding
            callee_type = JSParse_GetType(callee)
            is_method = 0
            IfCondition EqualTo(callee_type, ASTType.MEMBER_DOT) ThenBlock: {
                is_method = 1
            }
            IfCondition EqualTo(callee_type, ASTType.MEMBER_BRACKET) ThenBlock: {
                is_method = 2
            }

            IfCondition GreaterThan(is_method, 0) ThenBlock: {
                // Method call path: compile receiver, DUP, then GET_PROP/GET_ELEM
                // Stack result: [..., receiver, func]
                // M26a: super.m() — receiver for this is current this, prop from SuperBase
                member_obj = JSParse_GetLeft(callee)
                is_super_m = 0
                IfCondition EqualTo(JSParse_GetType(member_obj), ASTType.SUPER_EXPR) ThenBlock: {
                    is_super_m = 1
                }

                IfCondition EqualTo(is_super_m, 1) ThenBlock: {
                    // Push current this as CALL_METHOD receiver
                    this_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                    SetByte(this_nm, 0, 116)
                    SetByte(this_nm, 1, 104)
                    SetByte(this_nm, 2, 105)
                    SetByte(this_nm, 3, 115)
                    SetByte(this_nm, 4, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                    JSComp__Push(save_node)
                    JSComp__Push(argc)
                    JSComp__Push(has_spread)
                    JSComp__Push(is_method)
                    JSComp__Push(callee)
                    tci = JSComp__AddString(this_nm, 4)
                    callee = JSComp__Pop()
                    is_method = JSComp__Pop()
                    has_spread = JSComp__Pop()
                    argc = JSComp__Pop()
                    save_node = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, tci)
                    // SuperBase for property lookup
                    JSComp__EmitLoadSuperBase()
                    IfCondition EqualTo(is_method, 1) ThenBlock: {
                        pnp = JSParse_GetNamePtr(callee)
                        pnl = JSParse_GetNameLen(callee)
                        ci = JSComp__AddString(pnp, pnl)
                        JSComp__EmitOp16(JSOp.GET_PROP, ci)
                    } ElseBlock: {
                        member_key = JSParse_GetRight(callee)
                        JSComp__Push(save_node)
                        JSComp__Push(argc)
                        JSComp__Push(has_spread)
                        JSComp__CompileExpr(member_key)
                        has_spread = JSComp__Pop()
                        argc = JSComp__Pop()
                        save_node = JSComp__Pop()
                        JSComp__Emit1(JSOp.GET_ELEM)
                    }
                    // Stack: [this, func]
                } ElseBlock: {
                JSComp__Push(save_node)
                JSComp__Push(argc)
                JSComp__Push(has_spread)
                JSComp__Push(is_method)
                JSComp__Push(callee)
                JSComp__CompileExpr(member_obj)
                callee = JSComp__Pop()
                is_method = JSComp__Pop()
                has_spread = JSComp__Pop()
                argc = JSComp__Pop()
                save_node = JSComp__Pop()

                // DUP receiver so it stays on stack below the function
                JSComp__Emit1(JSOp.DUP)

                // Emit property access (consumes top copy of receiver, pushes func)
                IfCondition EqualTo(is_method, 1) ThenBlock: {
                    // MEMBER_DOT: GET_PROP
                    pnp = JSParse_GetNamePtr(callee)
                    pnl = JSParse_GetNameLen(callee)
                    ci = JSComp__AddString(pnp, pnl)
                    JSComp__EmitOp16(JSOp.GET_PROP, ci)
                } ElseBlock: {
                    // MEMBER_BRACKET: compile key expr, GET_ELEM
                    member_key = JSParse_GetRight(callee)
                    JSComp__Push(save_node)
                    JSComp__Push(argc)
                    JSComp__Push(has_spread)
                    JSComp__CompileExpr(member_key)
                    has_spread = JSComp__Pop()
                    argc = JSComp__Pop()
                    save_node = JSComp__Pop()
                    JSComp__Emit1(JSOp.GET_ELEM)
                }
                // Stack: [..., receiver, func]
                }
            } ElseBlock: {
                // Non-method call: compile callee normally
                JSComp__Push(save_node)
                JSComp__Push(argc)
                JSComp__Push(has_spread)
                JSComp__Push(is_method)
                JSComp__CompileExpr(callee)
                is_method = JSComp__Pop()
                has_spread = JSComp__Pop()
                argc = JSComp__Pop()
                save_node = JSComp__Pop()
            }

            IfCondition EqualTo(has_spread, 1) ThenBlock: {
                // Spread path: build args array then CALL_SPREAD
                // Emit NEW_ARRAY(0) — empty accumulator array
                JSComp__EmitOp16(JSOp.NEW_ARRAY, 0)

                // For each arg: normal → ARR_APPEND; spread → compile inner + ARR_EXTEND
                arg = JSParse_GetRight(save_node)
                WhileLoop GreaterEqual(arg, 0) {
                    JSComp__Push(arg)
                    atype = JSParse_GetType(arg)
                    IfCondition EqualTo(atype, ASTType.SPREAD_ELEMENT) ThenBlock: {
                        inner = JSParse_GetLeft(arg)
                        JSComp__CompileExpr(inner)
                        JSComp__Emit1(JSOp.ARR_EXTEND)
                    } ElseBlock: {
                        JSComp__CompileExpr(arg)
                        JSComp__Emit1(JSOp.ARR_APPEND)
                    }
                    arg = JSComp__Pop()
                    arg = JSParse_GetNext(arg)
                }

                // Emit CALL_SPREAD (no operand — argc from array length)
                JSComp__Emit1(JSOp.CALL_SPREAD)
                ReturnValue(0)
            }

            // Normal path (no spread)
            arg = JSParse_GetRight(save_node)
            JSComp__Push(argc)
            JSComp__Push(is_method)
            WhileLoop GreaterEqual(arg, 0) {
                JSComp__Push(arg)
                JSComp__CompileExpr(arg)
                arg = JSComp__Pop()
                arg = JSParse_GetNext(arg)
            }
            is_method = JSComp__Pop()
            argc = JSComp__Pop()

            // Emit CALL_METHOD or CALL based on whether this is a method call
            IfCondition GreaterThan(is_method, 0) ThenBlock: {
                JSComp__Emit1(JSOp.CALL_METHOD)
                JSComp__Emit1(argc)
            } ElseBlock: {
                JSComp__Emit1(JSOp.CALL)
                JSComp__Emit1(argc)
            }
            ReturnValue(0)
        }

        // --- NEW_EXPR ---
        IfCondition EqualTo(ntype, ASTType.NEW_EXPR) ThenBlock: {
            // Emit CONSTRUCT opcode — creates object, binds this, calls constructor
            callee = JSParse_GetLeft(save_node)
            argc = JSParse_GetValue(save_node)

            JSComp__Push(save_node)
            JSComp__Push(argc)
            JSComp__CompileExpr(callee)
            argc = JSComp__Pop()
            save_node = JSComp__Pop()

            arg = JSParse_GetRight(save_node)
            JSComp__Push(argc)
            WhileLoop GreaterEqual(arg, 0) {
                JSComp__Push(arg)
                JSComp__CompileExpr(arg)
                arg = JSComp__Pop()
                arg = JSParse_GetNext(arg)
            }
            argc = JSComp__Pop()

            JSComp__Emit1(JSOp.CONSTRUCT)
            JSComp__Emit1(argc)
            ReturnValue(0)
        }

        // --- MEMBER_DOT ---
        IfCondition EqualTo(ntype, ASTType.MEMBER_DOT) ThenBlock: {
            obj = JSParse_GetLeft(save_node)
            // M26a: super.prop → GetSuperBase() = parent.prototype, then prop
            // M26e: SuperProperty requires initialized this (TDZ before super())
            IfCondition EqualTo(JSParse_GetType(obj), ASTType.SUPER_EXPR) ThenBlock: {
                this_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(this_nm, 0, 116)
                SetByte(this_nm, 1, 104)
                SetByte(this_nm, 2, 105)
                SetByte(this_nm, 3, 115)
                SetByte(this_nm, 4, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                JSComp__Push(save_node)
                tci = JSComp__AddString(this_nm, 4)
                save_node = JSComp__Pop()
                JSComp__EmitOp16(JSOp.GET_GLOBAL, tci)
                JSComp__Emit1(JSOp.POP)
                JSComp__EmitLoadSuperBase()
            } ElseBlock: {
                JSComp__Push(save_node)
                JSComp__CompileExpr(obj)
                save_node = JSComp__Pop()
            }

            pnp = JSParse_GetNamePtr(save_node)
            pnl = JSParse_GetNameLen(save_node)
            ci = JSComp__AddString(pnp, pnl)
            JSComp__EmitOp16(JSOp.GET_PROP, ci)
            ReturnValue(0)
        }

        // --- MEMBER_BRACKET ---
        IfCondition EqualTo(ntype, ASTType.MEMBER_BRACKET) ThenBlock: {
            obj = JSParse_GetLeft(save_node)
            key = JSParse_GetRight(save_node)

            IfCondition EqualTo(JSParse_GetType(obj), ASTType.SUPER_EXPR) ThenBlock: {
                // M26e: SuperProperty this TDZ
                this_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(this_nm, 0, 116)
                SetByte(this_nm, 1, 104)
                SetByte(this_nm, 2, 105)
                SetByte(this_nm, 3, 115)
                SetByte(this_nm, 4, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                JSComp__Push(save_node)
                tci = JSComp__AddString(this_nm, 4)
                save_node = JSComp__Pop()
                JSComp__EmitOp16(JSOp.GET_GLOBAL, tci)
                JSComp__Emit1(JSOp.POP)
                JSComp__EmitLoadSuperBase()
            } ElseBlock: {
                JSComp__Push(save_node)
                JSComp__CompileExpr(obj)
                save_node = JSComp__Pop()
            }

            key = JSParse_GetRight(save_node)
            JSComp__CompileExpr(key)
            JSComp__Emit1(JSOp.GET_ELEM)
            ReturnValue(0)
        }

        // --- OPT_MEMBER (obj?.prop) ---
        IfCondition EqualTo(ntype, ASTType.OPT_MEMBER) ThenBlock: {
            obj = JSParse_GetLeft(save_node)
            JSComp__Push(save_node)
            JSComp__CompileExpr(obj)
            save_node = JSComp__Pop()

            // If nullish, pop obj and push undefined, jump to end
            end_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP_IF_NULLISH, 0)

            // Normal path: GET_PROP
            pnp = JSParse_GetNamePtr(save_node)
            pnl = JSParse_GetNameLen(save_node)
            ci = JSComp__AddString(pnp, pnl)
            JSComp__EmitOp16(JSOp.GET_PROP, ci)
            JSComp__PatchJump(end_jmp)
            ReturnValue(0)
        }

        // --- OPT_BRACKET (obj?.[expr]) ---
        IfCondition EqualTo(ntype, ASTType.OPT_BRACKET) ThenBlock: {
            obj = JSParse_GetLeft(save_node)
            JSComp__Push(save_node)
            JSComp__CompileExpr(obj)
            save_node = JSComp__Pop()

            end_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP_IF_NULLISH, 0)

            key = JSParse_GetRight(save_node)
            JSComp__CompileExpr(key)
            JSComp__Emit1(JSOp.GET_ELEM)
            JSComp__PatchJump(end_jmp)
            ReturnValue(0)
        }

        // --- OPT_CALL (obj?.(args)) ---
        IfCondition EqualTo(ntype, ASTType.OPT_CALL) ThenBlock: {
            // Same structure as CALL node but with nullish short-circuit on callee
            callee = JSParse_GetLeft(save_node)
            argc = JSParse_GetValue(save_node)

            JSComp__Push(save_node)
            JSComp__Push(argc)
            JSComp__CompileExpr(callee)
            argc = JSComp__Pop()
            save_node = JSComp__Pop()

            // If callee is nullish, skip the call and produce undefined
            end_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP_IF_NULLISH, 0)

            // Compile arguments (linked list via N_RIGHT / N_NEXT)
            arg = JSParse_GetRight(save_node)
            JSComp__Push(argc)
            WhileLoop GreaterEqual(arg, 0) {
                JSComp__Push(arg)
                JSComp__CompileExpr(arg)
                arg = JSComp__Pop()
                arg = JSParse_GetNext(arg)
            }
            argc = JSComp__Pop()

            JSComp__Emit1(JSOp.CALL)
            JSComp__Emit1(argc)
            JSComp__PatchJump(end_jmp)
            ReturnValue(0)
        }

        // --- TERNARY ---
        IfCondition EqualTo(ntype, ASTType.TERNARY) ThenBlock: {
            cond_n = JSParse_GetCond(save_node)

            JSComp__Push(save_node)
            JSComp__CompileExpr(cond_n)
            save_node = JSComp__Pop()

            false_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP_FALSE, 0)

            // Consequent (N_LEFT)
            tl = JSParse_GetLeft(save_node)

            JSComp__Push(save_node)
            JSComp__CompileExpr(tl)
            save_node = JSComp__Pop()

            end_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP, 0)

            JSComp__PatchJump(false_jmp)

            // Alternate (N_RIGHT)
            tr = JSParse_GetRight(save_node)
            JSComp__CompileExpr(tr)

            JSComp__PatchJump(end_jmp)
            ReturnValue(0)
        }

        // --- UPDATE_EXPR (++/--) ---
        IfCondition EqualTo(ntype, ASTType.UPDATE_EXPR) ThenBlock: {
            uop = JSParse_GetOp(save_node)
            is_prefix = JSParse_GetValue(save_node)
            operand = JSParse_GetLeft(save_node)
            op_type = JSParse_GetType(operand)

            IfCondition EqualTo(op_type, ASTType.IDENT) ThenBlock: {
                np = JSParse_GetNamePtr(operand)
                nl = JSParse_GetNameLen(operand)

                // Postfix: push original value first
                IfCondition EqualTo(is_prefix, 0) ThenBlock: {
                    JSComp__EmitVarGet(np, nl)
                }

                // Load, add/sub 1, store
                JSComp__Push(is_prefix)
                JSComp__Push(uop)
                JSComp__EmitVarGet(np, nl)
                uop = JSComp__Pop()
                is_prefix = JSComp__Pop()

                one_ci = JSComp__AddNumber(1)

                JSComp__Push(is_prefix)
                JSComp__Push(uop)
                JSComp__Push(operand)
                JSComp__EmitOp16(JSOp.PUSH_CONST, one_ci)
                operand = JSComp__Pop()
                uop = JSComp__Pop()
                is_prefix = JSComp__Pop()

                IfCondition EqualTo(uop, JSTokType.PLUS_PLUS) ThenBlock: {
                    JSComp__Emit1(JSOp.ADD)
                } ElseBlock: {
                    JSComp__Emit1(JSOp.SUB)
                }

                // Store updated value
                np = JSParse_GetNamePtr(operand)
                nl = JSParse_GetNameLen(operand)
                JSComp__EmitVarSet(np, nl)

                // Prefix: push the new value (it's already stored, re-get it)
                IfCondition EqualTo(is_prefix, 1) ThenBlock: {
                    JSComp__EmitVarGet(np, nl)
                }
            }

            // ── MEMBER_DOT: o.x++ / ++o.x ──
            IfCondition EqualTo(op_type, ASTType.MEMBER_DOT) ThenBlock: {
                // Postfix o.x++:
                //   compile(o), DUP, GET_PROP "x" → [obj, old]
                //   SWAP → [old, obj], DUP → [old, obj, obj]
                //   GET_PROP "x" → [old, obj, old], PUSH 1, ADD → [old, obj, new]
                //   SET_PROP "x" → [old]
                // Prefix ++o.x:
                //   compile(o), DUP, GET_PROP "x" → [obj, old]
                //   PUSH 1, ADD → [obj, new]
                //   SET_PROP "x" → []
                //   compile(o), GET_PROP "x" → [new]

                up_pnp = JSParse_GetNamePtr(operand)
                up_pnl = JSParse_GetNameLen(operand)

                IfCondition EqualTo(is_prefix, 0) ThenBlock: {
                    // ── Postfix ──
                    JSComp__Push(uop)
                    JSComp__Push(up_pnp)
                    JSComp__Push(up_pnl)
                    JSComp__CompileExpr(JSParse_GetLeft(operand))
                    up_pnl = JSComp__Pop()
                    up_pnp = JSComp__Pop()
                    uop = JSComp__Pop()

                    JSComp__Emit1(JSOp.DUP)
                    up_ci = JSComp__AddString(up_pnp, up_pnl)
                    JSComp__EmitOp16(JSOp.GET_PROP, up_ci)
                    JSComp__Emit1(JSOp.SWAP)
                    JSComp__Emit1(JSOp.DUP)
                    JSComp__EmitOp16(JSOp.GET_PROP, up_ci)
                    up_one = JSComp__AddNumber(1)
                    JSComp__EmitOp16(JSOp.PUSH_CONST, up_one)
                    IfCondition EqualTo(uop, JSTokType.PLUS_PLUS) ThenBlock: {
                        JSComp__Emit1(JSOp.ADD)
                    } ElseBlock: {
                        JSComp__Emit1(JSOp.SUB)
                    }
                    JSComp__EmitOp16(JSOp.SET_PROP, up_ci)
                } ElseBlock: {
                    // ── Prefix ──
                    JSComp__Push(uop)
                    JSComp__Push(up_pnp)
                    JSComp__Push(up_pnl)
                    JSComp__Push(operand)
                    JSComp__CompileExpr(JSParse_GetLeft(operand))
                    operand = JSComp__Pop()
                    up_pnl = JSComp__Pop()
                    up_pnp = JSComp__Pop()
                    uop = JSComp__Pop()

                    JSComp__Emit1(JSOp.DUP)
                    up_ci = JSComp__AddString(up_pnp, up_pnl)
                    JSComp__EmitOp16(JSOp.GET_PROP, up_ci)
                    up_one = JSComp__AddNumber(1)
                    JSComp__EmitOp16(JSOp.PUSH_CONST, up_one)
                    IfCondition EqualTo(uop, JSTokType.PLUS_PLUS) ThenBlock: {
                        JSComp__Emit1(JSOp.ADD)
                    } ElseBlock: {
                        JSComp__Emit1(JSOp.SUB)
                    }
                    JSComp__EmitOp16(JSOp.SET_PROP, up_ci)
                    // Re-read the new value
                    JSComp__Push(up_pnp)
                    JSComp__Push(up_pnl)
                    JSComp__CompileExpr(JSParse_GetLeft(operand))
                    up_pnl = JSComp__Pop()
                    up_pnp = JSComp__Pop()
                    up_ci = JSComp__AddString(up_pnp, up_pnl)
                    JSComp__EmitOp16(JSOp.GET_PROP, up_ci)
                }
            }

            // ── MEMBER_BRACKET: o[k]++ / ++o[k] ──
            // Re-eval approach: compile obj+key twice (once to read, once to write).
            // Correct for identifier-based obj/key; may double side-effects for complex exprs.
            IfCondition EqualTo(op_type, ASTType.MEMBER_BRACKET) ThenBlock: {
                // Read current value: compile(obj), compile(key), GET_ELEM → [old_val]
                JSComp__Push(uop)
                JSComp__Push(is_prefix)
                JSComp__Push(operand)
                JSComp__CompileExpr(JSParse_GetLeft(operand))
                operand = JSComp__Pop()
                JSComp__Push(operand)
                JSComp__CompileExpr(JSParse_GetRight(operand))
                operand = JSComp__Pop()
                is_prefix = JSComp__Pop()
                uop = JSComp__Pop()
                JSComp__Emit1(JSOp.GET_ELEM)
                // stack: [old_val]
                // Compute new value
                up_one = JSComp__AddNumber(1)
                JSComp__EmitOp16(JSOp.PUSH_CONST, up_one)
                IfCondition EqualTo(uop, JSTokType.PLUS_PLUS) ThenBlock: {
                    JSComp__Emit1(JSOp.ADD)
                } ElseBlock: {
                    JSComp__Emit1(JSOp.SUB)
                }
                // stack: [new_val]. Write it back: new_val, compile(obj), compile(key), SET_ELEM
                JSComp__Push(operand)
                JSComp__CompileExpr(JSParse_GetLeft(operand))
                operand = JSComp__Pop()
                JSComp__CompileExpr(JSParse_GetRight(operand))
                JSComp__Emit1(JSOp.SET_ELEM)
                // SET_ELEM leaves nothing useful. Push undefined as expression result.
                JSComp__Emit1(JSOp.PUSH_UNDEF)
            }

            ReturnValue(0)
        }

        // --- OBJECT_LIT ---
        IfCondition EqualTo(ntype, ASTType.OBJECT_LIT) ThenBlock: {
            JSComp__Emit1(JSOp.NEW_OBJECT)
            // Properties are linked via N_LEFT -> N_NEXT chain
            prop = JSParse_GetLeft(save_node)
            WhileLoop GreaterEqual(prop, 0) {
                ptype = JSParse_GetType(prop)

                // --- SPREAD_ELEMENT: ...src  →  CopyDataProperties(obj, src)
                // Stack: [obj, src] → OBJ_SPREAD → [obj]
                IfCondition EqualTo(ptype, ASTType.SPREAD_ELEMENT) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    pval = JSParse_GetLeft(prop)
                    JSComp__Push(prop)
                    JSComp__CompileExpr(pval)
                    prop = JSComp__Pop()
                    JSComp__Emit1(JSOp.OBJ_SPREAD)
                } ElseBlock: {

                // --- COMPUTED_PROP: [expr]: value ---
                // Stack: obj, key, value → SET_PROP_COMPUTED
                IfCondition EqualTo(ptype, ASTType.COMPUTED_PROP) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    // Compile key expression (N_RIGHT of COMPUTED_PROP)
                    key_expr = JSParse_GetRight(prop)
                    JSComp__Push(prop)
                    JSComp__CompileExpr(key_expr)
                    prop = JSComp__Pop()
                    // Compile value expression (N_LEFT of COMPUTED_PROP)
                    pval = JSParse_GetLeft(prop)
                    JSComp__Push(prop)
                    JSComp__CompileExpr(pval)
                    prop = JSComp__Pop()
                    JSComp__Emit1(JSOp.SET_PROP_COMPUTED)
                } ElseBlock: {

                // --- GETTER_PROP: get name() { ... } ---
                // Stack: obj → DEF_GETTER(name_ci) with func on stack
                IfCondition EqualTo(ptype, ASTType.GETTER_PROP) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    // Compile function expression (N_LEFT)
                    pval = JSParse_GetLeft(prop)
                    JSComp__Push(prop)
                    JSComp__CompileExpr(pval)
                    prop = JSComp__Pop()
                    // Property key name
                    kp = JSParse_GetNamePtr(prop)
                    kl = JSParse_GetNameLen(prop)
                    ci = JSComp__AddString(kp, kl)
                    JSComp__EmitOp16(JSOp.DEF_GETTER, ci)
                } ElseBlock: {

                // --- SETTER_PROP: set name(v) { ... } ---
                IfCondition EqualTo(ptype, ASTType.SETTER_PROP) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    pval = JSParse_GetLeft(prop)
                    JSComp__Push(prop)
                    JSComp__CompileExpr(pval)
                    prop = JSComp__Pop()
                    kp = JSParse_GetNamePtr(prop)
                    kl = JSParse_GetNameLen(prop)
                    ci = JSComp__AddString(kp, kl)
                    JSComp__EmitOp16(JSOp.DEF_SETTER, ci)
                } ElseBlock: {

                // --- PROPERTY: normal key: value ---
                JSComp__Emit1(JSOp.DUP)
                // Property value is in N_LEFT of PROPERTY node
                pval = JSParse_GetLeft(prop)

                JSComp__Push(prop)
                JSComp__CompileExpr(pval)
                prop = JSComp__Pop()

                // Property key name
                kp = JSParse_GetNamePtr(prop)
                kl = JSParse_GetNameLen(prop)
                ci = JSComp__AddString(kp, kl)
                JSComp__EmitOp16(JSOp.SET_PROP, ci)

                }
                }
                }
                } // end SPREAD_ELEMENT else

                prop = JSParse_GetNext(prop)
            }
            ReturnValue(0)
        }

        // --- ARRAY_LIT ---
        IfCondition EqualTo(ntype, ASTType.ARRAY_LIT) ThenBlock: {
            // Check if any element is SPREAD_ELEMENT
            has_spread = 0
            scan_elem = JSParse_GetLeft(save_node)
            WhileLoop GreaterEqual(scan_elem, 0) {
                IfCondition EqualTo(JSParse_GetType(scan_elem), ASTType.SPREAD_ELEMENT) ThenBlock: {
                    has_spread = 1
                }
                scan_elem = JSParse_GetNext(scan_elem)
            }

            IfCondition EqualTo(has_spread, 1) ThenBlock: {
                // Spread path: NEW_ARRAY(0) then ARR_APPEND/ARR_EXTEND
                JSComp__EmitOp16(JSOp.NEW_ARRAY, 0)
                elem = JSParse_GetLeft(save_node)
                WhileLoop GreaterEqual(elem, 0) {
                    JSComp__Push(elem)
                    etype = JSParse_GetType(elem)
                    IfCondition EqualTo(etype, ASTType.SPREAD_ELEMENT) ThenBlock: {
                        inner = JSParse_GetLeft(elem)
                        JSComp__CompileExpr(inner)
                        JSComp__Emit1(JSOp.ARR_EXTEND)
                    } ElseBlock: {
                        JSComp__CompileExpr(elem)
                        JSComp__Emit1(JSOp.ARR_APPEND)
                    }
                    elem = JSComp__Pop()
                    elem = JSParse_GetNext(elem)
                }
                ReturnValue(0)
            }

            // Normal path: count and compile elements (linked via N_LEFT -> N_NEXT chain)
            elem = JSParse_GetLeft(save_node)
            elem_count = 0
            WhileLoop GreaterEqual(elem, 0) {
                JSComp__Push(elem)
                JSComp__CompileExpr(elem)
                elem = JSComp__Pop()
                elem_count = Add(elem_count, 1)
                elem = JSParse_GetNext(elem)
            }
            JSComp__EmitOp16(JSOp.NEW_ARRAY, elem_count)
            ReturnValue(0)
        }

        // --- FUNC_EXPR ---
        IfCondition EqualTo(ntype, ASTType.FUNC_EXPR) ThenBlock: {
            JSComp__CompileFunc(save_node)
            ReturnValue(0)
        }

        // --- ARROW_EXPR --- (same structure as FUNC_EXPR)
        IfCondition EqualTo(ntype, ASTType.ARROW_EXPR) ThenBlock: {
            JSComp__CompileFunc(save_node)
            ReturnValue(0)
        }

        // --- GEN_FUNC_EXPR --- (generator function expression)
        IfCondition EqualTo(ntype, ASTType.GEN_FUNC_EXPR) ThenBlock: {
            JSComp__CompileFunc(save_node)
            ReturnValue(0)
        }

        // --- ASYNC_FUNC_EXPR --- (async function expression or async arrow)
        IfCondition EqualTo(ntype, ASTType.ASYNC_FUNC_EXPR) ThenBlock: {
            JSComp__CompileFunc(save_node)
            ReturnValue(0)
        }

        // --- CLASS_EXPR ---
        IfCondition EqualTo(ntype, ASTType.CLASS_EXPR) ThenBlock: {
            JSComp__CompileClass(save_node)
            ReturnValue(0)
        }

        // --- SUPER_EXPR ---
        // Bare super (super(...args)) → parent constructor via __super__.
        IfCondition EqualTo(ntype, ASTType.SUPER_EXPR) ThenBlock: {
            JSComp__EmitLoadSuperCtor()
            ReturnValue(0)
        }

        // --- NEW_TARGET (M26h) --- meta property new.target
        IfCondition EqualTo(ntype, ASTType.NEW_TARGET) ThenBlock: {
            nt_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            // "__new_target__"
            SetByte(nt_nm, 0, 95)
            SetByte(nt_nm, 1, 95)
            SetByte(nt_nm, 2, 110)
            SetByte(nt_nm, 3, 101)
            SetByte(nt_nm, 4, 119)
            SetByte(nt_nm, 5, 95)
            SetByte(nt_nm, 6, 116)
            SetByte(nt_nm, 7, 97)
            SetByte(nt_nm, 8, 114)
            SetByte(nt_nm, 9, 103)
            SetByte(nt_nm, 10, 101)
            SetByte(nt_nm, 11, 116)
            SetByte(nt_nm, 12, 95)
            SetByte(nt_nm, 13, 95)
            SetByte(nt_nm, 14, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 15)
            nt_ci = JSComp__AddString(nt_nm, 14)
            JSComp__EmitOp16(JSOp.GET_GLOBAL, nt_ci)
            ReturnValue(0)
        }

        // --- YIELD_EXPR ---
        IfCondition EqualTo(ntype, ASTType.YIELD_EXPR) ThenBlock: {
            yield_arg = JSParse_GetLeft(save_node)
            IfCondition GreaterEqual(yield_arg, 0) ThenBlock: {
                JSComp__CompileExpr(yield_arg)
            } ElseBlock: {
                JSComp__Emit1(JSOp.PUSH_UNDEF)
            }
            JSComp__Emit1(JSOp.YIELD)
            ReturnValue(0)
        }

        // --- AWAIT_EXPR ---
        IfCondition EqualTo(ntype, ASTType.AWAIT_EXPR) ThenBlock: {
            await_arg = JSParse_GetLeft(save_node)
            IfCondition GreaterEqual(await_arg, 0) ThenBlock: {
                JSComp__CompileExpr(await_arg)
            } ElseBlock: {
                JSComp__Emit1(JSOp.PUSH_UNDEF)
            }
            JSComp__Emit1(JSOp.AWAIT)
            ReturnValue(0)
        }

        // Fallback — unknown expression type
        PrintMessage("[COMP] unknown expr type=")
        PrintNumber(ntype)
        PrintMessage("\n")
        JSCompState.error = 1
        ReturnValue(-1)
    }
}
