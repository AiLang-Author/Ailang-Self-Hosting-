// Library.JSCompExprPart1.ailang — expression compilers
// Bodies of JSComp__CompileExpr branches.
// Split from the JS engine so one function fits in context.
// FixedPools stay in the parent library. Function names are unchanged
// except for the new helpers this split adds.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

Function.JSComp__ExprArrayLit {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node

            // M128e7bg: TemplateObject (N_OP=1) — cooked array + .raw array
            is_tmpl_obj = JSParse_GetOp(save_node)
            IfCondition EqualTo(is_tmpl_obj, 1) ThenBlock: {
                // Count elements
                elem = JSParse_GetLeft(save_node)
                elem_count = 0
                WhileLoop GreaterEqual(elem, 0) {
                    elem_count = Add(elem_count, 1)
                    elem = JSParse_GetNext(elem)
                }
                // Push cooked strings (left-to-right) then NEW_ARRAY
                elem = JSParse_GetLeft(save_node)
                WhileLoop GreaterEqual(elem, 0) {
                    JSComp__Push(elem)
                    JSComp__CompileExpr(elem)
                    elem = JSComp__Pop()
                    elem = JSParse_GetNext(elem)
                }
                JSComp__EmitOp16(JSOp.NEW_ARRAY, elem_count)
                // DUP cooked array for SET_PROP later
                JSComp__Emit1(JSOp.DUP)
                // Push raw strings for each element (packed after cooked\0)
                elem = JSParse_GetLeft(save_node)
                WhileLoop GreaterEqual(elem, 0) {
                    JSComp__Push(elem)
                    sp_r = JSParse_GetNamePtr(elem)
                    sl_r = JSParse_GetNameLen(elem)
                    // raw starts after cooked + NUL
                    raw_p = Add(sp_r, Add(sl_r, 1))
                    raw_l = 0
                    IfCondition NotEqual(raw_p, 0) ThenBlock: {
                        WhileLoop And(NotEqual(RDMEM_8(raw_p, raw_l), 0), LessThan(raw_l, 65536)) {
                            raw_l = Add(raw_l, 1)
                        }
                    }
                    rci = JSComp__AddStringRaw(raw_p, raw_l)
                    JSComp__EmitOp16(JSOp.PUSH_CONST, rci)
                    elem = JSComp__Pop()
                    elem = JSParse_GetNext(elem)
                }
                JSComp__EmitOp16(JSOp.NEW_ARRAY, elem_count)
                // stack: [cooked, raw] — SET_PROP "raw"
                raw_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                WRMEM_8(raw_nm, 0, 114)
                WRMEM_8(raw_nm, 1, 97)
                WRMEM_8(raw_nm, 2, 119)
                WRMEM_8(raw_nm, 3, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 4)
                raw_ci = JSComp__AddString(raw_nm, 3)
                JSComp__EmitOp16(JSOp.SET_PROP, raw_ci)
                // stack: [cooked] with .raw set
                ReturnValue(0)
            }

            // Check if any element is SPREAD_ELEMENT
            has_spread = 0
            scan_elem = JSParse_GetLeft(save_node)
            WhileLoop GreaterEqual(scan_elem, 0) {
                IfCondition EqualTo(JSParse_GetType(scan_elem), ASTType.SPREAD_ELEMENT) ThenBlock: {
                    has_spread = 1
                }
                scan_elem = JSParse_GetNext(scan_elem)
            }

            IfCondition EqualTo(has_spread, 1) ThenBlock: {
                // Spread path: NEW_ARRAY(0) then ARR_APPEND/ARR_EXTEND
                JSComp__EmitOp16(JSOp.NEW_ARRAY, 0)
                elem = JSParse_GetLeft(save_node)
                WhileLoop GreaterEqual(elem, 0) {
                    JSComp__Push(elem)
                    etype = JSParse_GetType(elem)
                    IfCondition EqualTo(etype, ASTType.SPREAD_ELEMENT) ThenBlock: {
                        inner = JSParse_GetLeft(elem)
                        JSComp__CompileExpr(inner)
                        JSComp__Emit1(JSOp.ARR_EXTEND)
                    } ElseBlock: {
                        // M52: elision with spread still creates a hole element
                        IfCondition EqualTo(etype, ASTType.ELISION) ThenBlock: {
                            JSComp__Emit1(JSOp.PUSH_HOLE)
                            JSComp__Emit1(JSOp.ARR_APPEND)
                        } ElseBlock: {
                            JSComp__CompileExpr(elem)
                            JSComp__Emit1(JSOp.ARR_APPEND)
                        }
                    }
                    elem = JSComp__Pop()
                    elem = JSParse_GetNext(elem)
                }
                ReturnValue(0)
            }

            // Normal path: count and compile elements (linked via N_LEFT -> N_NEXT chain)
            // M52: ELISION → PUSH_HOLE; NULL_LIT is real null (CompileExpr → PUSH_NULL)
            elem = JSParse_GetLeft(save_node)
            elem_count = 0
            WhileLoop GreaterEqual(elem, 0) {
                JSComp__Push(elem)
                etype_al = JSParse_GetType(elem)
                IfCondition EqualTo(etype_al, ASTType.ELISION) ThenBlock: {
                    JSComp__Emit1(JSOp.PUSH_HOLE)
                } ElseBlock: {
                    JSComp__CompileExpr(elem)
                }
                elem = JSComp__Pop()
                elem_count = Add(elem_count, 1)
                elem = JSParse_GetNext(elem)
            }
            JSComp__EmitOp16(JSOp.NEW_ARRAY, elem_count)
            ReturnValue(0)
        
    }
}

Function.JSComp__ExprObjectLit {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node

            JSComp__Emit1(JSOp.NEW_OBJECT)
            // Properties are linked via N_LEFT -> N_NEXT chain
            prop = JSParse_GetLeft(save_node)
            WhileLoop GreaterEqual(prop, 0) {
                ptype = JSParse_GetType(prop)

                // --- SPREAD_ELEMENT: ...src  →  CopyDataProperties(obj, src)
                // Stack: [obj, src] → OBJ_SPREAD → [obj]
                IfCondition EqualTo(ptype, ASTType.SPREAD_ELEMENT) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    pval = JSParse_GetLeft(prop)
                    JSComp__Push(prop)
                    JSComp__CompileExpr(pval)
                    prop = JSComp__Pop()
                    JSComp__Emit1(JSOp.OBJ_SPREAD)
                } ElseBlock: {

                // --- COMPUTED_PROP: [expr]: value ---
                // Stack: obj, key, value → SET_PROP_COMPUTED
                // M68: ToPropertyKey(key) BEFORE evaluating value (ES PropertyDefinition)
                IfCondition EqualTo(ptype, ASTType.COMPUTED_PROP) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    // Compile key expression (N_RIGHT of COMPUTED_PROP)
                    key_expr = JSParse_GetRight(prop)
                    JSComp__Push(prop)
                    JSComp__CompileExpr(key_expr)
                    prop = JSComp__Pop()
                    // ToPropertyKey before value (toString side effects)
                    JSComp__Emit1(JSOp.TO_PROP_KEY)
                    // Compile value expression (N_LEFT of COMPUTED_PROP)
                    pval = JSParse_GetLeft(prop)
                    JSComp__Push(prop)
                    JSComp__CompileExpr(pval)
                    prop = JSComp__Pop()
                    // CreateDataPropertyOrThrow. Computed "__proto__" is data.
                    JSComp__Emit1(JSOp.DEF_DATA_COMPUTED)
                } ElseBlock: {

                // --- GETTER_PROP: get name() { ... } or get [expr]() ---
                // Named: stack [obj, func] → DEF_GETTER(ci)
                // Computed (N_RIGHT = key expr): [obj, key, func] → DEF_GETTER_COMPUTED
                IfCondition EqualTo(ptype, ASTType.GETTER_PROP) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    gkey = JSParse_GetRight(prop)
                    IfCondition GreaterEqual(gkey, 0) ThenBlock: {
                        // M66/M88: computed accessor name — ToPropertyKey before value
                        // (ES PropertyDefinition; TypeError if key not coercible)
                        JSComp__Push(prop)
                        JSComp__CompileExpr(gkey)
                        prop = JSComp__Pop()
                        JSComp__Emit1(JSOp.TO_PROP_KEY)
                        pval = JSParse_GetLeft(prop)
                        JSComp__Push(prop)
                        JSComp__CompileExpr(pval)
                        prop = JSComp__Pop()
                        JSComp__Emit1(JSOp.DEF_GETTER_COMPUTED)
                    } ElseBlock: {
                        pval = JSParse_GetLeft(prop)
                        JSComp__Push(prop)
                        JSComp__CompileExpr(pval)
                        prop = JSComp__Pop()
                        kp = JSParse_GetNamePtr(prop)
                        kl = JSParse_GetNameLen(prop)
                        ci = JSComp__AddPropName(kp, kl)
                        JSComp__EmitOp16(JSOp.DEF_GETTER, ci)
                    }
                } ElseBlock: {

                // --- SETTER_PROP: set name(v) { ... } or set [expr](v) ---
                IfCondition EqualTo(ptype, ASTType.SETTER_PROP) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    skey = JSParse_GetRight(prop)
                    IfCondition GreaterEqual(skey, 0) ThenBlock: {
                        // M66/M88: computed accessor name — ToPropertyKey before value
                        JSComp__Push(prop)
                        JSComp__CompileExpr(skey)
                        prop = JSComp__Pop()
                        JSComp__Emit1(JSOp.TO_PROP_KEY)
                        pval = JSParse_GetLeft(prop)
                        JSComp__Push(prop)
                        JSComp__CompileExpr(pval)
                        prop = JSComp__Pop()
                        JSComp__Emit1(JSOp.DEF_SETTER_COMPUTED)
                    } ElseBlock: {
                        pval = JSParse_GetLeft(prop)
                        JSComp__Push(prop)
                        JSComp__CompileExpr(pval)
                        prop = JSComp__Pop()
                        kp = JSParse_GetNamePtr(prop)
                        kl = JSParse_GetNameLen(prop)
                        ci = JSComp__AddPropName(kp, kl)
                        JSComp__EmitOp16(JSOp.DEF_SETTER, ci)
                    }
                } ElseBlock: {

                // --- PROPERTY: normal key: value ---
                JSComp__Emit1(JSOp.DUP)
                // Property value is in N_LEFT of PROPERTY node
                pval = JSParse_GetLeft(prop)

                JSComp__Push(prop)
                JSComp__CompileExpr(pval)
                prop = JSComp__Pop()

                // Property key name
                kp = JSParse_GetNamePtr(prop)
                kl = JSParse_GetNameLen(prop)
                // Quoted keys are strings. A leading digit must not ToNumber
                // the key: "123" + U+FFFD would become "123".
                hi = 0
                bi = 0
                WhileLoop LessThan(bi, kl) {
                    IfCondition GreaterThan(RDMEM_8(kp, bi), 127) ThenBlock: { hi = 1 }
                    bi = Add(bi, 1)
                }
                // "__proto__": value is [[SetPrototypeOf]], not a data property.
                is_pp = 0
                IfCondition EqualTo(kl, 9) ThenBlock: {
                    is_pp = 1
                    IfCondition NotEqual(RDMEM_8(kp, 0), 95) ThenBlock: { is_pp = 0 }
                    IfCondition NotEqual(RDMEM_8(kp, 1), 95) ThenBlock: { is_pp = 0 }
                    IfCondition NotEqual(RDMEM_8(kp, 2), 112) ThenBlock: { is_pp = 0 }
                    IfCondition NotEqual(RDMEM_8(kp, 3), 114) ThenBlock: { is_pp = 0 }
                    IfCondition NotEqual(RDMEM_8(kp, 4), 111) ThenBlock: { is_pp = 0 }
                    IfCondition NotEqual(RDMEM_8(kp, 5), 116) ThenBlock: { is_pp = 0 }
                    IfCondition NotEqual(RDMEM_8(kp, 6), 111) ThenBlock: { is_pp = 0 }
                    IfCondition NotEqual(RDMEM_8(kp, 7), 95) ThenBlock: { is_pp = 0 }
                    IfCondition NotEqual(RDMEM_8(kp, 8), 95) ThenBlock: { is_pp = 0 }
                }
                JSComp__Push(is_pp)
                JSComp__Push(prop)
                IfCondition EqualTo(hi, 1) ThenBlock: {
                    ci = JSComp__AddString(kp, kl)
                } ElseBlock: {
                    ci = JSComp__AddPropName(kp, kl)
                }
                prop = JSComp__Pop()
                JSComp__Push(ci)
                // M48: SetFunctionName for { bar: function(){} }
                // stack: [obj, val] - if anon function, set .name = key BEFORE prop SET_PROP
                // Must leave [obj, fn] on stack for the property write.
                pvt = -1
                IfCondition GreaterEqual(pval, 0) ThenBlock: {
                    pvt = JSParse_GetType(pval)
                }
                pvl = 0
                IfCondition Or(EqualTo(pvt, ASTType.FUNC_EXPR), Or(EqualTo(pvt, ASTType.ARROW_EXPR), Or(EqualTo(pvt, ASTType.GEN_FUNC_EXPR), EqualTo(pvt, ASTType.CLASS_EXPR)))) ThenBlock: {
                    pvl = JSParse_GetNameLen(pval)
                }
                IfCondition And(EqualTo(pvl, 0), GreaterThan(kl, 0)) ThenBlock: {
                    IfCondition Or(EqualTo(pvt, ASTType.FUNC_EXPR), Or(EqualTo(pvt, ASTType.ARROW_EXPR), Or(EqualTo(pvt, ASTType.GEN_FUNC_EXPR), EqualTo(pvt, ASTType.CLASS_EXPR)))) ThenBlock: {
                        // [obj, fn] -> check name; leave [obj, fn]
                        JSComp__Emit1(JSOp.DUP)
                        nm_k = Add(JSCompState.str_buf, JSCompState.str_pos)
                        WRMEM_8(nm_k, 0, 110)
                        WRMEM_8(nm_k, 1, 97)
                        WRMEM_8(nm_k, 2, 109)
                        WRMEM_8(nm_k, 3, 101)
                        WRMEM_8(nm_k, 4, 0)
                        JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                        JSComp__Push(prop)
                        JSComp__Push(ci)
                        nk = JSComp__AddString(nm_k, 4)
                        ci = JSComp__Pop()
                        prop = JSComp__Pop()
                        JSComp__EmitOp16(JSOp.GET_PROP, nk)
                        JSComp__Emit1(JSOp.DUP)
                        emp = Add(JSCompState.str_buf, JSCompState.str_pos)
                        WRMEM_8(emp, 0, 0)
                        JSCompState.str_pos = Add(JSCompState.str_pos, 1)
                        JSComp__Push(prop)
                        JSComp__Push(ci)
                        JSComp__Push(nk)
                        eci = JSComp__AddString(emp, 0)
                        nk = JSComp__Pop()
                        ci = JSComp__Pop()
                        prop = JSComp__Pop()
                        JSComp__EmitOp16(JSOp.PUSH_CONST, eci)
                        JSComp__Emit1(JSOp.STRICT_EQ)
                        skp = JSCompState.code_pos
                        JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                        // empty name: [obj, fn, name] -> POP name, DUP fn, PUSH key, SET_PROP name
                        JSComp__Emit1(JSOp.POP)
                        JSComp__Emit1(JSOp.DUP)
                        JSComp__EmitOp16(JSOp.PUSH_CONST, ci)
                        JSComp__EmitOp16(JSOp.SET_FUNC_NAME, nk)
                        skp_end = JSCompState.code_pos
                        JSComp__EmitOp16(JSOp.JMP, 0)
                        JSComp__PatchJump(skp)
                        // non-empty: [obj, fn, name] -> discard name only
                        JSComp__Emit1(JSOp.POP)
                        JSComp__PatchJump(skp_end)
                    }
                }
                ci = JSComp__Pop()
                is_pp = JSComp__Pop()
                IfCondition EqualTo(is_pp, 1) ThenBlock: {
                    JSComp__EmitOp16(JSOp.SET_PROP, ci)
                } ElseBlock: {
                    JSComp__EmitOp16(JSOp.DEF_DATA_PROP, ci)
                }

                }
                }
                }
                } // end SPREAD_ELEMENT else

                prop = JSParse_GetNext(prop)
            }
            ReturnValue(0)
        
    }
}

Function.JSComp__ExprUpdateExpr {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node

            uop = JSParse_GetOp(save_node)
            is_prefix = JSParse_GetValue(save_node)
            operand = JSParse_GetLeft(save_node)
            // Unwrap (id) / ((id)) cover parentheses → assignable target
            unwrap_i = 0
            WhileLoop And(LessThan(unwrap_i, 8), EqualTo(JSParse_GetType(operand), ASTType.PAREN_EXPR)) {
                operand = JSParse_GetLeft(operand)
                unwrap_i = Add(unwrap_i, 1)
            }
            op_type = JSParse_GetType(operand)

            IfCondition EqualTo(op_type, ASTType.IDENT) ThenBlock: {
                np = JSParse_GetNamePtr(operand)
                nl = JSParse_GetNameLen(operand)

                // Postfix: GET; TO_NUMERIC; DUP; INC; SET → leaves numeric old
                // Prefix:  GET; INC; DUP; SET → leaves new
                JSComp__Push(is_prefix)
                JSComp__Push(uop)
                JSComp__EmitVarGet(np, nl)
                uop = JSComp__Pop()
                is_prefix = JSComp__Pop()

                IfCondition EqualTo(is_prefix, 0) ThenBlock: {
                    // ES: return ToNumeric(oldValue), not raw object/bool
                    JSComp__Emit1(JSOp.TO_NUMERIC)
                    JSComp__Emit1(JSOp.DUP)
                }

                // M128e7aj: INC/DEC preserve BigInt (not +1 Number → mix TypeError)
                IfCondition EqualTo(uop, JSTokType.PLUS_PLUS) ThenBlock: {
                    JSComp__Emit1(JSOp.INC)
                } ElseBlock: {
                    JSComp__Emit1(JSOp.DEC)
                }

                // Prefix: keep new value under SET (SET pops the written value)
                IfCondition EqualTo(is_prefix, 1) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                }

                // Store updated value (uses WithRef from the single GET under with)
                np = JSParse_GetNamePtr(operand)
                nl = JSParse_GetNameLen(operand)
                JSComp__EmitVarSet(np, nl)
            }

            // ── MEMBER_DOT: o.x++ / ++o.x ──
            IfCondition EqualTo(op_type, ASTType.MEMBER_DOT) ThenBlock: {
                // Postfix o.x++:
                //   compile(o), DUP, GET_PROP "x" → [obj, old]
                //   SWAP → [old, obj], DUP → [old, obj, obj]
                //   GET_PROP "x" → [old, obj, old], PUSH 1, ADD → [old, obj, new]
                //   SET_PROP "x" → [old]
                // Prefix ++o.x:
                //   compile(o), DUP, GET_PROP "x" → [obj, old]
                //   PUSH 1, ADD → [obj, new]
                //   SET_PROP "x" → []
                //   compile(o), GET_PROP "x" → [new]

                up_pnp = JSParse_GetNamePtr(operand)
                up_pnl = JSParse_GetNameLen(operand)

                IfCondition EqualTo(is_prefix, 0) ThenBlock: {
                    // ── Postfix ──
                    JSComp__Push(uop)
                    JSComp__Push(up_pnp)
                    JSComp__Push(up_pnl)
                    JSComp__CompileExpr(JSParse_GetLeft(operand))
                    up_pnl = JSComp__Pop()
                    up_pnp = JSComp__Pop()
                    uop = JSComp__Pop()

                    JSComp__Emit1(JSOp.DUP)
                    up_ci = JSComp__AddString(up_pnp, up_pnl)
                    JSComp__EmitOp16(JSOp.GET_PROP, up_ci)
                    JSComp__Emit1(JSOp.SWAP)
                    JSComp__Emit1(JSOp.DUP)
                    JSComp__EmitOp16(JSOp.GET_PROP, up_ci)
                    IfCondition EqualTo(uop, JSTokType.PLUS_PLUS) ThenBlock: {
                        JSComp__Emit1(JSOp.INC)
                    } ElseBlock: {
                        JSComp__Emit1(JSOp.DEC)
                    }
                    JSComp__EmitOp16(JSOp.SET_PROP, up_ci)
                    // Postfix result must be ToNumeric(old), not raw object
                    JSComp__Emit1(JSOp.TO_NUMERIC)
                } ElseBlock: {
                    // ── Prefix ──
                    JSComp__Push(uop)
                    JSComp__Push(up_pnp)
                    JSComp__Push(up_pnl)
                    JSComp__Push(operand)
                    JSComp__CompileExpr(JSParse_GetLeft(operand))
                    operand = JSComp__Pop()
                    up_pnl = JSComp__Pop()
                    up_pnp = JSComp__Pop()
                    uop = JSComp__Pop()

                    JSComp__Emit1(JSOp.DUP)
                    up_ci = JSComp__AddString(up_pnp, up_pnl)
                    JSComp__EmitOp16(JSOp.GET_PROP, up_ci)
                    IfCondition EqualTo(uop, JSTokType.PLUS_PLUS) ThenBlock: {
                        JSComp__Emit1(JSOp.INC)
                    } ElseBlock: {
                        JSComp__Emit1(JSOp.DEC)
                    }
                    JSComp__EmitOp16(JSOp.SET_PROP, up_ci)
                    // Re-read the new value
                    JSComp__Push(up_pnp)
                    JSComp__Push(up_pnl)
                    JSComp__CompileExpr(JSParse_GetLeft(operand))
                    up_pnl = JSComp__Pop()
                    up_pnp = JSComp__Pop()
                    up_ci = JSComp__AddString(up_pnp, up_pnl)
                    JSComp__EmitOp16(JSOp.GET_PROP, up_ci)
                }
            }

            // ── MEMBER_BRACKET: o[k]++ / ++o[k] ──
            // Single key eval (A6). UPDATE_ELEM: stack [obj, key] + imm flags.
            // imm byte: bit0=prefix, bit1=dec (0=inc)
            IfCondition EqualTo(op_type, ASTType.MEMBER_BRACKET) ThenBlock: {
                JSComp__Push(uop)
                JSComp__Push(is_prefix)
                JSComp__Push(operand)
                JSComp__CompileExpr(JSParse_GetLeft(operand))
                operand = JSComp__Pop()
                JSComp__Push(operand)
                JSComp__CompileExpr(JSParse_GetRight(operand))
                operand = JSComp__Pop()
                is_prefix = JSComp__Pop()
                uop = JSComp__Pop()
                // flags
                fl = 0
                IfCondition EqualTo(is_prefix, 1) ThenBlock: { fl = 1 }
                IfCondition NotEqual(uop, JSTokType.PLUS_PLUS) ThenBlock: {
                    fl = Add(fl, 2)
                }
                JSComp__Emit1(JSOp.UPDATE_ELEM)
                JSComp__Emit1(fl)
            }

            ReturnValue(0)
        
    }
}

Function.JSComp__ExprOptCall {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node

            callee = JSParse_GetLeft(save_node)
            argc = JSParse_GetValue(save_node)
            // unwrap (a.b)?.()
            pe_i = 0
            WhileLoop And(LessThan(pe_i, 4), EqualTo(JSParse_GetType(callee), ASTType.PAREN_EXPR)) {
                callee = JSParse_GetLeft(callee)
                pe_i = Add(pe_i, 1)
            }
            callee_type = JSParse_GetType(callee)
            // M128e7bb: a.b?.() / a?.b?.() preserve this via CALL_METHOD
            is_opt_meth = 0
            IfCondition Or(EqualTo(callee_type, ASTType.MEMBER_DOT), EqualTo(callee_type, ASTType.OPT_MEMBER)) ThenBlock: {
                is_opt_meth = 1
            }
            IfCondition Or(EqualTo(callee_type, ASTType.MEMBER_BRACKET), EqualTo(callee_type, ASTType.OPT_BRACKET)) ThenBlock: {
                is_opt_meth = 2
            }

            IfCondition GreaterThan(is_opt_meth, 0) ThenBlock: {
                member_obj = JSParse_GetLeft(callee)
                // M128e7bd: super.method?.() — this as receiver, SuperBase for lookup
                is_super_oc = 0
                IfCondition EqualTo(JSParse_GetType(member_obj), ASTType.SUPER_EXPR) ThenBlock: {
                    is_super_oc = 1
                }
                IfCondition EqualTo(is_super_oc, 1) ThenBlock: {
                    this_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                    WRMEM_8(this_nm, 0, 116)
                    WRMEM_8(this_nm, 1, 104)
                    WRMEM_8(this_nm, 2, 105)
                    WRMEM_8(this_nm, 3, 115)
                    WRMEM_8(this_nm, 4, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                    JSComp__Push(save_node)
                    JSComp__Push(argc)
                    JSComp__Push(callee)
                    JSComp__Push(is_opt_meth)
                    tci = JSComp__AddString(this_nm, 4)
                    is_opt_meth = JSComp__Pop()
                    callee = JSComp__Pop()
                    argc = JSComp__Pop()
                    save_node = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, tci)
                    JSComp__EmitLoadSuperBase()
                    IfCondition EqualTo(is_opt_meth, 1) ThenBlock: {
                        pnp = JSParse_GetNamePtr(callee)
                        pnl = JSParse_GetNameLen(callee)
                        ci = JSComp__AddString(pnp, pnl)
                        JSComp__EmitOp16(JSOp.GET_PROP, ci)
                    } ElseBlock: {
                        member_key = JSParse_GetRight(callee)
                        JSComp__Push(save_node)
                        JSComp__Push(argc)
                        JSComp__CompileExpr(member_key)
                        argc = JSComp__Pop()
                        save_node = JSComp__Pop()
                        JSComp__Emit1(JSOp.GET_ELEM)
                    }
                    // stack: [this, func] — no nullish base (super always object)
                    end_jmp_recv = 0
                } ElseBlock: {
                JSComp__Push(save_node)
                JSComp__Push(argc)
                JSComp__Push(callee)
                JSComp__Push(is_opt_meth)
                JSComp__CompileExpr(member_obj)
                is_opt_meth = JSComp__Pop()
                callee = JSComp__Pop()
                argc = JSComp__Pop()
                save_node = JSComp__Pop()
                // Optional receiver: a?.b?.() — short-circuit before method lookup
                opt_recv = 0
                walk_n = callee
                walk_i = 0
                WhileLoop And(GreaterEqual(walk_n, 0), LessThan(walk_i, 32)) {
                    walk_t = JSParse_GetType(walk_n)
                    IfCondition Or(Or(EqualTo(walk_t, ASTType.OPT_MEMBER), EqualTo(walk_t, ASTType.OPT_BRACKET)),
                                  EqualTo(walk_t, ASTType.OPT_CALL)) ThenBlock: {
                        opt_recv = 1
                        walk_n = -1
                    } ElseBlock: {
                        IfCondition Or(EqualTo(walk_t, ASTType.MEMBER_DOT), EqualTo(walk_t, ASTType.MEMBER_BRACKET)) ThenBlock: {
                            walk_n = JSParse_GetLeft(walk_n)
                        } ElseBlock: {
                            walk_n = -1
                        }
                    }
                    walk_i = Add(walk_i, 1)
                }
                end_jmp_recv = 0
                IfCondition EqualTo(opt_recv, 1) ThenBlock: {
                    end_jmp_recv = JSCompState.code_pos
                    JSComp__EmitOp16(JSOp.JMP_IF_NULLISH, 0)
                }
                JSComp__Emit1(JSOp.DUP)
                IfCondition EqualTo(is_opt_meth, 1) ThenBlock: {
                    pnp = JSParse_GetNamePtr(callee)
                    pnl = JSParse_GetNameLen(callee)
                    ci = JSComp__AddString(pnp, pnl)
                    JSComp__EmitOp16(JSOp.GET_PROP, ci)
                } ElseBlock: {
                    member_key = JSParse_GetRight(callee)
                    JSComp__Push(save_node)
                    JSComp__Push(argc)
                    JSComp__Push(end_jmp_recv)
                    JSComp__CompileExpr(member_key)
                    end_jmp_recv = JSComp__Pop()
                    argc = JSComp__Pop()
                    save_node = JSComp__Pop()
                    JSComp__Emit1(JSOp.GET_ELEM)
                }
                }
                // stack: [recv, func] — short-circuit if func nullish
                end_jmp_fn = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP_IF_NULLISH, 0)
                arg = JSParse_GetRight(save_node)
                JSComp__Push(argc)
                JSComp__Push(end_jmp_fn)
                JSComp__Push(end_jmp_recv)
                WhileLoop GreaterEqual(arg, 0) {
                    JSComp__Push(arg)
                    JSComp__CompileExpr(arg)
                    arg = JSComp__Pop()
                    arg = JSParse_GetNext(arg)
                }
                end_jmp_recv = JSComp__Pop()
                end_jmp_fn = JSComp__Pop()
                argc = JSComp__Pop()
                JSComp__Emit1(JSOp.CALL_METHOD)
                JSComp__Emit1(argc)
                done_jmp = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP, 0)
                // nullish func: [recv, undef] → just undef
                JSComp__PatchJump(end_jmp_fn)
                JSComp__Emit1(JSOp.POP)
                JSComp__Emit1(JSOp.POP)
                JSComp__Emit1(JSOp.PUSH_UNDEF)
                IfCondition GreaterThan(end_jmp_recv, 0) ThenBlock: {
                    JSComp__PatchJump(end_jmp_recv)
                }
                JSComp__PatchJump(done_jmp)
                ReturnValue(0)
            }

            // Non-method: f?.() / f?.(...spread)
            // M128e7bd: detect SPREAD_ELEMENT args (optional-chain-prod-arguments)
            has_spread_oc = 0
            scan_arg_oc = JSParse_GetRight(save_node)
            WhileLoop GreaterEqual(scan_arg_oc, 0) {
                IfCondition EqualTo(JSParse_GetType(scan_arg_oc), ASTType.SPREAD_ELEMENT) ThenBlock: {
                    has_spread_oc = 1
                }
                scan_arg_oc = JSParse_GetNext(scan_arg_oc)
            }

            JSComp__Push(save_node)
            JSComp__Push(argc)
            JSComp__Push(has_spread_oc)
            JSComp__CompileExpr(callee)
            has_spread_oc = JSComp__Pop()
            argc = JSComp__Pop()
            save_node = JSComp__Pop()

            end_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP_IF_NULLISH, 0)

            IfCondition EqualTo(has_spread_oc, 1) ThenBlock: {
                JSComp__EmitOp16(JSOp.NEW_ARRAY, 0)
                arg = JSParse_GetRight(save_node)
                WhileLoop GreaterEqual(arg, 0) {
                    JSComp__Push(arg)
                    atype = JSParse_GetType(arg)
                    IfCondition EqualTo(atype, ASTType.SPREAD_ELEMENT) ThenBlock: {
                        inner = JSParse_GetLeft(arg)
                        JSComp__CompileExpr(inner)
                        JSComp__Emit1(JSOp.ARR_EXTEND)
                    } ElseBlock: {
                        JSComp__CompileExpr(arg)
                        JSComp__Emit1(JSOp.ARR_APPEND)
                    }
                    arg = JSComp__Pop()
                    arg = JSParse_GetNext(arg)
                }
                JSComp__Emit1(JSOp.CALL_SPREAD)
                JSComp__PatchJump(end_jmp)
                ReturnValue(0)
            }

            arg = JSParse_GetRight(save_node)
            JSComp__Push(argc)
            WhileLoop GreaterEqual(arg, 0) {
                JSComp__Push(arg)
                JSComp__CompileExpr(arg)
                arg = JSComp__Pop()
                arg = JSParse_GetNext(arg)
            }
            argc = JSComp__Pop()

            JSComp__Emit1(JSOp.CALL)
            JSComp__Emit1(argc)
            JSComp__PatchJump(end_jmp)
            ReturnValue(0)
        
    }
}

Function.JSComp__ExprMemberBracket {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node

            obj = JSParse_GetLeft(save_node)
            key = JSParse_GetRight(save_node)

            IfCondition EqualTo(JSParse_GetType(obj), ASTType.SUPER_EXPR) ThenBlock: {
                // M26e: SuperProperty this TDZ
                this_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                WRMEM_8(this_nm, 0, 116)
                WRMEM_8(this_nm, 1, 104)
                WRMEM_8(this_nm, 2, 105)
                WRMEM_8(this_nm, 3, 115)
                WRMEM_8(this_nm, 4, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                JSComp__Push(save_node)
                tci = JSComp__AddString(this_nm, 4)
                save_node = JSComp__Pop()
                JSComp__EmitOp16(JSOp.GET_GLOBAL, tci)
                JSComp__Emit1(JSOp.POP)
                JSComp__EmitLoadSuperBase()
            } ElseBlock: {
                JSComp__Push(save_node)
                JSComp__CompileExpr(obj)
                save_node = JSComp__Pop()
            }

            // M128e7e: optional-chain continuation (skip key eval + GET_ELEM if nullish)
            opt_cont_b = 0
            walk_n = JSParse_GetLeft(save_node)
            walk_i = 0
            WhileLoop And(GreaterEqual(walk_n, 0), LessThan(walk_i, 32)) {
                walk_t = JSParse_GetType(walk_n)
                IfCondition Or(Or(EqualTo(walk_t, ASTType.OPT_MEMBER), EqualTo(walk_t, ASTType.OPT_BRACKET)),
                              EqualTo(walk_t, ASTType.OPT_CALL)) ThenBlock: {
                    opt_cont_b = 1
                    walk_n = -1
                } ElseBlock: {
                    walked = 0
                    IfCondition Or(EqualTo(walk_t, ASTType.MEMBER_DOT), EqualTo(walk_t, ASTType.MEMBER_BRACKET)) ThenBlock: {
                        walk_n = JSParse_GetLeft(walk_n)
                        walked = 1
                    }
                    IfCondition Or(EqualTo(walk_t, ASTType.CALL), EqualTo(walk_t, ASTType.OPT_CALL)) ThenBlock: {
                        walk_n = JSParse_GetLeft(walk_n)
                        walked = 1
                    }
                    IfCondition EqualTo(walked, 0) ThenBlock: {
                        walk_n = -1
                    }
                }
                walk_i = Add(walk_i, 1)
            }
            end_jmp_ob = 0
            IfCondition EqualTo(opt_cont_b, 1) ThenBlock: {
                end_jmp_ob = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP_IF_NULLISH, 0)
            }

            key = JSParse_GetRight(save_node)
            JSComp__CompileExpr(key)
            JSComp__Emit1(JSOp.GET_ELEM)
            IfCondition EqualTo(opt_cont_b, 1) ThenBlock: {
                JSComp__PatchJump(end_jmp_ob)
            }
            ReturnValue(0)
        
    }
}

Function.JSComp__ExprMemberDot {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node

            obj = JSParse_GetLeft(save_node)
            // M26a/M128e6d: super.prop → [Receiver=this, SuperBase]; GET_PROP_SUPER
            // so accessors get thisValue = actualThis (not SuperBase).
            // M26e: SuperProperty requires initialized this (TDZ before super())
            IfCondition EqualTo(JSParse_GetType(obj), ASTType.SUPER_EXPR) ThenBlock: {
                this_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                WRMEM_8(this_nm, 0, 116)
                WRMEM_8(this_nm, 1, 104)
                WRMEM_8(this_nm, 2, 105)
                WRMEM_8(this_nm, 3, 115)
                WRMEM_8(this_nm, 4, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                JSComp__Push(save_node)
                tci = JSComp__AddString(this_nm, 4)
                save_node = JSComp__Pop()
                JSComp__EmitOp16(JSOp.GET_GLOBAL, tci)
                // keep this as Receiver under SuperBase
                JSComp__EmitLoadSuperBase()
                pnp = JSParse_GetNamePtr(save_node)
                pnl = JSParse_GetNameLen(save_node)
                ci = JSComp__AddString(pnp, pnl)
                JSComp__EmitOp16(JSOp.GET_PROP_SUPER, ci)
                ReturnValue(0)
            } ElseBlock: {
                JSComp__Push(save_node)
                JSComp__CompileExpr(obj)
                save_node = JSComp__Pop()
            }

            // M128e7e: continue optional chain short-circuit (o?.a.b.#f).
            // Walk left spine: if any OPT_* ancestor, JMP_IF_NULLISH before GET.
            opt_cont = 0
            walk_n = JSParse_GetLeft(save_node)
            walk_i = 0
            WhileLoop And(GreaterEqual(walk_n, 0), LessThan(walk_i, 32)) {
                walk_t = JSParse_GetType(walk_n)
                IfCondition Or(Or(EqualTo(walk_t, ASTType.OPT_MEMBER), EqualTo(walk_t, ASTType.OPT_BRACKET)),
                              EqualTo(walk_t, ASTType.OPT_CALL)) ThenBlock: {
                    opt_cont = 1
                    walk_n = -1
                } ElseBlock: {
                    walked = 0
                    IfCondition Or(EqualTo(walk_t, ASTType.MEMBER_DOT), EqualTo(walk_t, ASTType.MEMBER_BRACKET)) ThenBlock: {
                        walk_n = JSParse_GetLeft(walk_n)
                        walked = 1
                    }
                    IfCondition Or(EqualTo(walk_t, ASTType.CALL), EqualTo(walk_t, ASTType.OPT_CALL)) ThenBlock: {
                        walk_n = JSParse_GetLeft(walk_n)
                        walked = 1
                    }
                    IfCondition EqualTo(walked, 0) ThenBlock: {
                        walk_n = -1
                    }
                }
                walk_i = Add(walk_i, 1)
            }
            end_jmp_opt = 0
            IfCondition EqualTo(opt_cont, 1) ThenBlock: {
                end_jmp_opt = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP_IF_NULLISH, 0)
            }

            pnp = JSParse_GetNamePtr(save_node)
            pnl = JSParse_GetNameLen(save_node)
            ci = JSComp__AddString(pnp, pnl)
            JSComp__EmitOp16(JSOp.GET_PROP, ci)
            IfCondition EqualTo(opt_cont, 1) ThenBlock: {
                JSComp__PatchJump(end_jmp_opt)
            }
            ReturnValue(0)
        
    }
}
