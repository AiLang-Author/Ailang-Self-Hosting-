// Library.JSCompExprPart2.ailang — expression compilers
// Bodies of JSComp__CompileExpr branches.
// Split from the JS engine so one function fits in context.
// FixedPools stay in the parent library. Function names are unchanged
// except for the new helpers this split adds.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// Const index of "__brbN" / "__brkN" for this bracket-assign nesting level.
Function.JSComp__BracketSlot {
    Input: kind: Integer
    Input: depth: Integer
    Output: Integer
    Body: {
        save_k = kind
        save_d = depth
        nm = Add(JSCompState.str_buf, JSCompState.str_pos)
        WRMEM_8(nm, 0, 95)
        WRMEM_8(nm, 1, 95)
        WRMEM_8(nm, 2, 98)
        WRMEM_8(nm, 3, 114)
        WRMEM_8(nm, 4, save_k)
        WRMEM_8(nm, 5, Add(48, save_d))
        WRMEM_8(nm, 6, 0)
        JSCompState.str_pos = Add(JSCompState.str_pos, 7)
        ReturnValue(JSComp__AddString(nm, 6))
    }
}

// Stash __cb__/__ck__ under a depth-unique global, then bump depth.
Function.JSComp__EmitBracketSave {
    Input: cb_ci: Integer
    Input: ck_ci: Integer
    Output: Integer
    Body: {
        JSCompTmp.idx = cb_ci
        JSCompTmp.len = ck_ci
        JSCompTmp.slot = JSComp__BracketSlot(98, JSCompState.bracket_depth)
        JSCompTmp.count = JSComp__BracketSlot(107, JSCompState.bracket_depth)
        JSComp__EmitOp16(JSOp.GET_GLOBAL, JSCompTmp.idx)
        JSComp__EmitOp16(JSOp.SET_GLOBAL, JSCompTmp.slot)
        JSComp__EmitOp16(JSOp.GET_GLOBAL, JSCompTmp.len)
        JSComp__EmitOp16(JSOp.SET_GLOBAL, JSCompTmp.count)
        JSCompState.bracket_depth = Add(JSCompState.bracket_depth, 1)
        ReturnValue(0)
    }
}

// Pop depth and write the saved base/key back over __cb__/__ck__.
Function.JSComp__EmitBracketRestore {
    Input: cb_ci: Integer
    Input: ck_ci: Integer
    Output: Integer
    Body: {
        JSCompTmp.idx = cb_ci
        JSCompTmp.len = ck_ci
        JSCompState.bracket_depth = Subtract(JSCompState.bracket_depth, 1)
        JSCompTmp.slot = JSComp__BracketSlot(98, JSCompState.bracket_depth)
        JSCompTmp.count = JSComp__BracketSlot(107, JSCompState.bracket_depth)
        JSComp__EmitOp16(JSOp.GET_GLOBAL, JSCompTmp.slot)
        JSComp__EmitOp16(JSOp.SET_GLOBAL, JSCompTmp.idx)
        JSComp__EmitOp16(JSOp.GET_GLOBAL, JSCompTmp.count)
        JSComp__EmitOp16(JSOp.SET_GLOBAL, JSCompTmp.len)
        ReturnValue(0)
    }
}

Function.JSComp__ExprCall {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node

            callee = JSParse_GetLeft(save_node)
            argc = JSParse_GetValue(save_node)

            // Check if any arg is SPREAD_ELEMENT
            has_spread = 0
            scan_arg = JSParse_GetRight(save_node)
            WhileLoop GreaterEqual(scan_arg, 0) {
                IfCondition EqualTo(JSParse_GetType(scan_arg), ASTType.SPREAD_ELEMENT) ThenBlock: {
                    has_spread = 1
                }
                scan_arg = JSParse_GetNext(scan_arg)
            }

            // Detect method call: callee is MEMBER_DOT/BRACKET or OPT_MEMBER/BRACKET
            // In that case, we need to keep the receiver on the stack for this binding
            // M128e7bb: unwrap PAREN_EXPR — (a.b)() / (a?.b)() preserve Reference/this (ES)
            pe_i = 0
            WhileLoop And(LessThan(pe_i, 4), EqualTo(JSParse_GetType(callee), ASTType.PAREN_EXPR)) {
                callee = JSParse_GetLeft(callee)
                pe_i = Add(pe_i, 1)
            }
            callee_type = JSParse_GetType(callee)
            is_method = 0
            IfCondition EqualTo(callee_type, ASTType.MEMBER_DOT) ThenBlock: {
                is_method = 1
            }
            IfCondition EqualTo(callee_type, ASTType.MEMBER_BRACKET) ThenBlock: {
                is_method = 2
            }
            // M128e7bb: o?.f() is CALL(OPT_MEMBER) — method this + optional short-circuit
            IfCondition EqualTo(callee_type, ASTType.OPT_MEMBER) ThenBlock: {
                is_method = 1
            }
            IfCondition EqualTo(callee_type, ASTType.OPT_BRACKET) ThenBlock: {
                is_method = 2
            }
            // Walk callee spine for optional-chain continuation (null?.a.b())
            opt_call_cont = 0
            walk_n = callee
            walk_i = 0
            WhileLoop And(GreaterEqual(walk_n, 0), LessThan(walk_i, 32)) {
                walk_t = JSParse_GetType(walk_n)
                IfCondition Or(Or(EqualTo(walk_t, ASTType.OPT_MEMBER), EqualTo(walk_t, ASTType.OPT_BRACKET)),
                              EqualTo(walk_t, ASTType.OPT_CALL)) ThenBlock: {
                    opt_call_cont = 1
                    walk_n = -1
                } ElseBlock: {
                    walked = 0
                    IfCondition Or(EqualTo(walk_t, ASTType.MEMBER_DOT), EqualTo(walk_t, ASTType.MEMBER_BRACKET)) ThenBlock: {
                        walk_n = JSParse_GetLeft(walk_n)
                        walked = 1
                    }
                    IfCondition Or(EqualTo(walk_t, ASTType.CALL), EqualTo(walk_t, ASTType.OPT_CALL)) ThenBlock: {
                        walk_n = JSParse_GetLeft(walk_n)
                        walked = 1
                    }
                    IfCondition EqualTo(walked, 0) ThenBlock: {
                        walk_n = -1
                    }
                }
                walk_i = Add(walk_i, 1)
            }

            // M128b: bare eval(...) → DIRECT_EVAL (not (0,eval) or obj.eval)
            is_direct_eval = 0
            IfCondition And(EqualTo(is_method, 0), EqualTo(has_spread, 0)) ThenBlock: {
                IfCondition EqualTo(callee_type, ASTType.IDENT) ThenBlock: {
                    enp = JSParse_GetNamePtr(callee)
                    enl = JSParse_GetNameLen(callee)
                    IfCondition EqualTo(enl, 4) ThenBlock: {
                        IfCondition EqualTo(RDMEM_8(enp, 0), 101) ThenBlock: {
                            IfCondition EqualTo(RDMEM_8(enp, 1), 118) ThenBlock: {
                                IfCondition EqualTo(RDMEM_8(enp, 2), 97) ThenBlock: {
                                    IfCondition EqualTo(RDMEM_8(enp, 3), 108) ThenBlock: {
                                        is_direct_eval = 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(is_direct_eval, 1) ThenBlock: {
                // Compile args only, then DIRECT_EVAL argc
                arg = JSParse_GetRight(save_node)
                JSComp__Push(argc)
                WhileLoop GreaterEqual(arg, 0) {
                    JSComp__Push(arg)
                    JSComp__CompileExpr(arg)
                    arg = JSComp__Pop()
                    arg = JSParse_GetNext(arg)
                }
                argc = JSComp__Pop()
                JSComp__Emit1(JSOp.DIRECT_EVAL)
                JSComp__Emit1(argc)
                ReturnValue(0)
            }

            end_jmp_oc = 0
            IfCondition GreaterThan(is_method, 0) ThenBlock: {
                // Method call path: compile receiver, DUP, then GET_PROP/GET_ELEM
                // Stack result: [..., receiver, func]
                // M26a: super.m() — receiver for this is current this, prop from SuperBase
                member_obj = JSParse_GetLeft(callee)
                is_super_m = 0
                IfCondition EqualTo(JSParse_GetType(member_obj), ASTType.SUPER_EXPR) ThenBlock: {
                    is_super_m = 1
                }

                IfCondition EqualTo(is_super_m, 1) ThenBlock: {
                    // Push current this as CALL_METHOD receiver
                    this_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                    WRMEM_8(this_nm, 0, 116)
                    WRMEM_8(this_nm, 1, 104)
                    WRMEM_8(this_nm, 2, 105)
                    WRMEM_8(this_nm, 3, 115)
                    WRMEM_8(this_nm, 4, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                    JSComp__Push(save_node)
                    JSComp__Push(argc)
                    JSComp__Push(has_spread)
                    JSComp__Push(is_method)
                    JSComp__Push(callee)
                    tci = JSComp__AddString(this_nm, 4)
                    callee = JSComp__Pop()
                    is_method = JSComp__Pop()
                    has_spread = JSComp__Pop()
                    argc = JSComp__Pop()
                    save_node = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, tci)
                    // SuperBase for property lookup
                    JSComp__EmitLoadSuperBase()
                    IfCondition EqualTo(is_method, 1) ThenBlock: {
                        pnp = JSParse_GetNamePtr(callee)
                        pnl = JSParse_GetNameLen(callee)
                        ci = JSComp__AddString(pnp, pnl)
                        JSComp__EmitOp16(JSOp.GET_PROP, ci)
                    } ElseBlock: {
                        member_key = JSParse_GetRight(callee)
                        JSComp__Push(save_node)
                        JSComp__Push(argc)
                        JSComp__Push(has_spread)
                        JSComp__CompileExpr(member_key)
                        has_spread = JSComp__Pop()
                        argc = JSComp__Pop()
                        save_node = JSComp__Pop()
                        JSComp__Emit1(JSOp.GET_ELEM)
                    }
                    // Stack: [this, func]
                } ElseBlock: {
                JSComp__Push(save_node)
                JSComp__Push(argc)
                JSComp__Push(has_spread)
                JSComp__Push(is_method)
                JSComp__Push(callee)
                JSComp__Push(opt_call_cont)
                JSComp__CompileExpr(member_obj)
                opt_call_cont = JSComp__Pop()
                callee = JSComp__Pop()
                is_method = JSComp__Pop()
                has_spread = JSComp__Pop()
                argc = JSComp__Pop()
                save_node = JSComp__Pop()

                // M128e7bb: optional-chain method call — short-circuit before DUP/args
                // (null?.f() / null?.a.b(): skip prop get + call, leave undefined)
                end_jmp_oc = 0
                IfCondition EqualTo(opt_call_cont, 1) ThenBlock: {
                    end_jmp_oc = JSCompState.code_pos
                    JSComp__EmitOp16(JSOp.JMP_IF_NULLISH, 0)
                }

                // DUP receiver so it stays on stack below the function
                JSComp__Emit1(JSOp.DUP)

                // Emit property access (consumes top copy of receiver, pushes func)
                IfCondition EqualTo(is_method, 1) ThenBlock: {
                    // MEMBER_DOT / OPT_MEMBER: GET_PROP
                    pnp = JSParse_GetNamePtr(callee)
                    pnl = JSParse_GetNameLen(callee)
                    ci = JSComp__AddString(pnp, pnl)
                    JSComp__EmitOp16(JSOp.GET_PROP, ci)
                } ElseBlock: {
                    // MEMBER_BRACKET / OPT_BRACKET: compile key expr, GET_ELEM
                    member_key = JSParse_GetRight(callee)
                    JSComp__Push(save_node)
                    JSComp__Push(argc)
                    JSComp__Push(has_spread)
                    JSComp__Push(end_jmp_oc)
                    JSComp__CompileExpr(member_key)
                    end_jmp_oc = JSComp__Pop()
                    has_spread = JSComp__Pop()
                    argc = JSComp__Pop()
                    save_node = JSComp__Pop()
                    JSComp__Emit1(JSOp.GET_ELEM)
                }
                // Stack: [..., receiver, func]
                }
            } ElseBlock: {
                // Non-method call: compile callee normally
                JSComp__Push(save_node)
                JSComp__Push(argc)
                JSComp__Push(has_spread)
                JSComp__Push(is_method)
                JSComp__Push(opt_call_cont)
                JSComp__CompileExpr(callee)
                opt_call_cont = JSComp__Pop()
                is_method = JSComp__Pop()
                has_spread = JSComp__Pop()
                argc = JSComp__Pop()
                save_node = JSComp__Pop()
                // M128e7bf: bare IDENT under with — WithBaseObject as this (with-base-obj)
                // Stack after GET_WITH: [func]; push base then SWAP → [recv, func]
                IfCondition And(GreaterThan(JSCompState.with_depth, 0), EqualTo(callee_type, ASTType.IDENT)) ThenBlock: {
                    JSComp__Emit1(JSOp.PUSH_WITH_CALL_THIS)
                    JSComp__Emit1(JSOp.SWAP)
                    is_method = 3
                }
            }

            IfCondition EqualTo(has_spread, 1) ThenBlock: {
                // Spread path: build args array then CALL_SPREAD
                // Emit NEW_ARRAY(0) — empty accumulator array
                JSComp__EmitOp16(JSOp.NEW_ARRAY, 0)

                // For each arg: normal → ARR_APPEND; spread → compile inner + ARR_EXTEND
                arg = JSParse_GetRight(save_node)
                WhileLoop GreaterEqual(arg, 0) {
                    JSComp__Push(arg)
                    atype = JSParse_GetType(arg)
                    IfCondition EqualTo(atype, ASTType.SPREAD_ELEMENT) ThenBlock: {
                        inner = JSParse_GetLeft(arg)
                        JSComp__CompileExpr(inner)
                        JSComp__Emit1(JSOp.ARR_EXTEND)
                    } ElseBlock: {
                        JSComp__CompileExpr(arg)
                        JSComp__Emit1(JSOp.ARR_APPEND)
                    }
                    arg = JSComp__Pop()
                    arg = JSParse_GetNext(arg)
                }

                // Emit CALL_SPREAD (no operand — argc from array length)
                // Note: with-base this not wired for spread bare IDENT yet
                JSComp__Emit1(JSOp.CALL_SPREAD)
                IfCondition GreaterThan(end_jmp_oc, 0) ThenBlock: {
                    JSComp__PatchJump(end_jmp_oc)
                }
                ReturnValue(0)
            }

            // Normal path (no spread)
            arg = JSParse_GetRight(save_node)
            JSComp__Push(argc)
            JSComp__Push(is_method)
            JSComp__Push(end_jmp_oc)
            WhileLoop GreaterEqual(arg, 0) {
                JSComp__Push(arg)
                JSComp__CompileExpr(arg)
                arg = JSComp__Pop()
                arg = JSParse_GetNext(arg)
            }
            end_jmp_oc = JSComp__Pop()
            is_method = JSComp__Pop()
            argc = JSComp__Pop()

            // Emit CALL_METHOD or CALL based on whether this is a method call
            IfCondition GreaterThan(is_method, 0) ThenBlock: {
                JSComp__Emit1(JSOp.CALL_METHOD)
                JSComp__Emit1(argc)
            } ElseBlock: {
                JSComp__Emit1(JSOp.CALL)
                JSComp__Emit1(argc)
            }
            // M128e7bb: patch optional-chain short-circuit (null?.f())
            IfCondition GreaterThan(end_jmp_oc, 0) ThenBlock: {
                JSComp__PatchJump(end_jmp_oc)
            }
            ReturnValue(0)
        
    }
}

Function.JSComp__ExprAssign {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node

            // Save assign node + left child in JSCompDot BEFORE any calls
            // so they survive the chain of JSParse_Get* function calls.
            JSCompDot.assign_node = save_node
            JSCompDot.member_node = JSParse_GetLeft(JSCompDot.assign_node)
            aop = JSParse_GetOp(JSCompDot.assign_node)
            JSComp__Push(aop)
            al_type = JSParse_GetType(JSCompDot.member_node)
            aop = JSComp__Pop()
            // M128e6w: CoverParenthesizedExpression (id) — unwrap for store but
            // remember cover so SetFunctionName is skipped (fn-name-lhs-cover).
            is_cover_lhs = 0
            IfCondition EqualTo(al_type, ASTType.PAREN_EXPR) ThenBlock: {
                is_cover_lhs = 1
                JSCompDot.member_node = JSParse_GetLeft(JSCompDot.member_node)
                al_type = JSParse_GetType(JSCompDot.member_node)
            }

            // Now: JSCompDot.assign_node = ASSIGN node
            //      JSCompDot.member_node = left child (target)
            //      aop = operator token type
            //      al_type = type of left child

            // Compound assignment (+=, -=, *=, /=)
            IfCondition NotEqual(aop, JSTokType.ASSIGN) ThenBlock: {
                // Save member_node before recursive calls can clobber it
                saved_ca_member = JSCompDot.member_node
                saved_ca_assign = JSCompDot.assign_node
                al_type = JSParse_GetType(saved_ca_member)
                IfCondition EqualTo(al_type, ASTType.PAREN_EXPR) ThenBlock: {
                    saved_ca_member = JSParse_GetLeft(saved_ca_member)
                    JSCompDot.member_node = saved_ca_member
                    al_type = JSParse_GetType(saved_ca_member)
                }

                // M19d: base[prop] op= rhs — evaluate base+key once (S11.13.2 A7 T4)
                // Use SET_GLOBAL temps (not SET_LOCAL): top-level only reserves
                // CountVars slots; extra AddLocal would overflow the local frame.
                IfCondition EqualTo(al_type, ASTType.MEMBER_BRACKET) ThenBlock: {
                    // const pool ids for "__cb__" / "__ck__"
                    cb_ci = JSComp__AddString("__cb__", 6)
                    ck_ci = JSComp__AddString("__ck__", 6)

                    // ES5 MemberExpression order:
                    //   base, property, CheckObjectCoercible(base), ToPropertyKey(prop)
                    // compile base → SET_GLOBAL __cb__
                    JSComp__Push(aop)
                    JSComp__Push(cb_ci)
                    JSComp__Push(ck_ci)
                    JSCompDot.member_node = saved_ca_member
                    JSComp__CompileExpr(JSParse_GetLeft(saved_ca_member))
                    ck_ci = JSComp__Pop()
                    cb_ci = JSComp__Pop()
                    aop = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, cb_ci)

                    // compile key (raw) — before coercible check so prop() can throw first
                    JSComp__Push(aop)
                    JSComp__Push(cb_ci)
                    JSComp__Push(ck_ci)
                    JSCompDot.member_node = saved_ca_member
                    JSComp__CompileExpr(JSParse_GetRight(saved_ca_member))
                    ck_ci = JSComp__Pop()
                    cb_ci = JSComp__Pop()
                    aop = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, ck_ci)

                    // CheckObjectCoercible(base) then ToPropertyKey once → string __ck__
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, cb_ci)
                    JSComp__Emit1(JSOp.CHECK_COERCIBLE)
                    JSComp__Emit1(JSOp.POP)
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, ck_ci)
                    JSComp__Emit1(JSOp.TO_PROP_KEY)
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, ck_ci)

                    // GET_GLOBAL base, GET_GLOBAL key, GET_ELEM → LHS value
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, cb_ci)
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, ck_ci)
                    JSComp__Emit1(JSOp.GET_ELEM)

                    // M68: logical assignment short-circuit for base[key] op=
                    // &&= / ||= / ??= — do not eval RHS or write when short-circuited
                    is_logical_b = 0
                    IfCondition EqualTo(aop, JSTokType.AND_ASSIGN) ThenBlock: {
                        is_logical_b = 1
                    }
                    IfCondition EqualTo(aop, JSTokType.OR_ASSIGN) ThenBlock: {
                        is_logical_b = 1
                    }
                    IfCondition EqualTo(aop, JSTokType.NULLISH_ASSIGN) ThenBlock: {
                        is_logical_b = 1
                    }
                    IfCondition EqualTo(is_logical_b, 1) ThenBlock: {
                        // stack [lhs]; keep lhs on short-circuit
                        JSComp__Emit1(JSOp.DUP)
                        sc_addr_b = JSCompState.code_pos
                        IfCondition EqualTo(aop, JSTokType.AND_ASSIGN) ThenBlock: {
                            JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                        }
                        IfCondition EqualTo(aop, JSTokType.OR_ASSIGN) ThenBlock: {
                            JSComp__EmitOp16(JSOp.JMP_TRUE, 0)
                        }
                        IfCondition EqualTo(aop, JSTokType.NULLISH_ASSIGN) ThenBlock: {
                            // JMP_NULLISH jumps when NOT nullish (keep lhs)
                            JSComp__EmitOp16(JSOp.JMP_NULLISH, 0)
                        }
                        JSComp__Emit1(JSOp.POP)
                        // RHS then store; leave assigned value
                        JSComp__Push(cb_ci)
                        JSComp__Push(ck_ci)
                        JSCompDot.member_node = saved_ca_member
                        JSCompDot.assign_node = saved_ca_assign
                        JSComp__CompileExpr(JSParse_GetRight(saved_ca_assign))
                        ck_ci = JSComp__Pop()
                        cb_ci = JSComp__Pop()
                        asv_ci = JSComp__AddString("__asv__", 6)
                        JSComp__Emit1(JSOp.DUP)
                        JSComp__EmitOp16(JSOp.SET_GLOBAL, asv_ci)
                        JSComp__EmitOp16(JSOp.GET_GLOBAL, cb_ci)
                        JSComp__EmitOp16(JSOp.GET_GLOBAL, ck_ci)
                        JSComp__Emit1(JSOp.SET_ELEM)
                        JSComp__EmitOp16(JSOp.GET_GLOBAL, asv_ci)
                        JSComp__PatchJump(sc_addr_b)
                        ReturnValue(0)
                    }

                    // RHS
                    JSComp__Push(aop)
                    JSComp__Push(cb_ci)
                    JSComp__Push(ck_ci)
                    JSCompDot.member_node = saved_ca_member
                    JSCompDot.assign_node = saved_ca_assign
                    JSComp__CompileExpr(JSParse_GetRight(saved_ca_assign))
                    ck_ci = JSComp__Pop()
                    cb_ci = JSComp__Pop()
                    aop = JSComp__Pop()

                    // emit op
                    IfCondition EqualTo(aop, JSTokType.PLUS_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.ADD) }
                    IfCondition EqualTo(aop, JSTokType.MINUS_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.SUB) }
                    IfCondition EqualTo(aop, JSTokType.STAR_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.MUL) }
                    IfCondition EqualTo(aop, JSTokType.SLASH_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.DIV) }
                    IfCondition EqualTo(aop, JSTokType.PERCENT_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.MOD) }
                    IfCondition EqualTo(aop, JSTokType.AMP_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.BIT_AND) }
                    IfCondition EqualTo(aop, JSTokType.PIPE_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.BIT_OR) }
                    IfCondition EqualTo(aop, JSTokType.CARET_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.BIT_XOR) }
                    IfCondition EqualTo(aop, JSTokType.SHL_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.SHL) }
                    IfCondition EqualTo(aop, JSTokType.SHR_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.SHR) }
                    IfCondition EqualTo(aop, JSTokType.USHR_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.USHR) }
                    IfCondition EqualTo(aop, JSTokType.STAR_STAR_ASSIGN) ThenBlock: { JSComp__Emit1(JSOp.EXP) }

                    // SET_ELEM with saved base/key — stack [result, base, key]
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, cb_ci)
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, ck_ci)
                    JSComp__Emit1(JSOp.SET_ELEM)
                    JSComp__Emit1(JSOp.PUSH_UNDEF)
                    ReturnValue(0)
                }

                // M68: logical assignment short-circuit (IDENT / MEMBER_DOT)
                // x &&= y → if !x leave x; else x = y
                // x ||= y → if  x leave x; else x = y
                // x ??= y → if not-nullish leave x; else x = y
                is_logical = 0
                IfCondition EqualTo(aop, JSTokType.AND_ASSIGN) ThenBlock: {
                    is_logical = 1
                }
                IfCondition EqualTo(aop, JSTokType.OR_ASSIGN) ThenBlock: {
                    is_logical = 1
                }
                IfCondition EqualTo(aop, JSTokType.NULLISH_ASSIGN) ThenBlock: {
                    is_logical = 1
                }
                IfCondition EqualTo(is_logical, 1) ThenBlock: {
                    al_type = JSParse_GetType(saved_ca_member)

                    // Load LHS once
                    JSComp__Push(aop)
                    JSCompDot.member_node = saved_ca_member
                    JSComp__CompileExpr(JSCompDot.member_node)
                    aop = JSComp__Pop()

                    JSComp__Emit1(JSOp.DUP)
                    sc_addr = JSCompState.code_pos
                    IfCondition EqualTo(aop, JSTokType.AND_ASSIGN) ThenBlock: {
                        JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                    }
                    IfCondition EqualTo(aop, JSTokType.OR_ASSIGN) ThenBlock: {
                        JSComp__EmitOp16(JSOp.JMP_TRUE, 0)
                    }
                    IfCondition EqualTo(aop, JSTokType.NULLISH_ASSIGN) ThenBlock: {
                        JSComp__EmitOp16(JSOp.JMP_NULLISH, 0)
                    }
                    JSComp__Emit1(JSOp.POP)

                    // RHS
                    JSComp__Push(aop)
                    JSCompDot.member_node = saved_ca_member
                    JSCompDot.assign_node = saved_ca_assign
                    JSComp__CompileExpr(JSParse_GetRight(JSCompDot.assign_node))
                    aop = JSComp__Pop()

                    // Store result, leave value on stack
                    IfCondition EqualTo(al_type, ASTType.MEMBER_DOT) ThenBlock: {
                        ca_pnp = JSParse_GetNamePtr(saved_ca_member)
                        ca_pnl = JSParse_GetNameLen(saved_ca_member)
                        asv_ci = JSComp__AddString("__asv__", 6)
                        JSComp__Emit1(JSOp.DUP)
                        JSComp__EmitOp16(JSOp.SET_GLOBAL, asv_ci)
                        JSComp__Push(ca_pnp)
                        JSComp__Push(ca_pnl)
                        JSCompDot.member_node = saved_ca_member
                        JSComp__CompileExpr(JSParse_GetLeft(saved_ca_member))
                        ca_pnl = JSComp__Pop()
                        ca_pnp = JSComp__Pop()
                        JSComp__Emit1(JSOp.SWAP)
                        ci = JSComp__AddString(ca_pnp, ca_pnl)
                        JSComp__EmitOp16(JSOp.SET_PROP, ci)
                        JSComp__EmitOp16(JSOp.GET_GLOBAL, asv_ci)
                        JSComp__PatchJump(sc_addr)
                        ReturnValue(0)
                    }

                    // IDENT (and fallthrough targets)
                    id_np = 0
                    id_nl = 0
                    IfCondition EqualTo(al_type, ASTType.IDENT) ThenBlock: {
                        id_np = JSParse_GetNamePtr(saved_ca_member)
                        id_nl = JSParse_GetNameLen(saved_ca_member)
                        JSComp__Emit1(JSOp.DUP)
                        JSComp__EmitVarSet(id_np, id_nl)
                    }
                    JSComp__PatchJump(sc_addr)
                    ReturnValue(0)
                }

                // M128e6ad A6: free-var RESOLVE_FREE before GetValue/RHS so PutValue
                // keeps outer binding when eval introduces a closer var.
                al_type_rf = JSParse_GetType(saved_ca_member)
                IfCondition EqualTo(al_type_rf, ASTType.IDENT) ThenBlock: {
                    IfCondition EqualTo(JSCompState.with_depth, 0) ThenBlock: {
                        id_np_rf = JSParse_GetNamePtr(saved_ca_member)
                        id_nl_rf = JSParse_GetNameLen(saved_ca_member)
                        slot_rf = JSComp__FindLocal(id_np_rf, id_nl_rf)
                        IfCondition LessThan(slot_rf, 0) ThenBlock: {
                            is_args_rf = JSComp__IsArgumentsName(id_np_rf, id_nl_rf)
                            owner_rf = -1
                            IfCondition EqualTo(is_args_rf, 0) ThenBlock: {
                                owner_rf = JSComp__FindEnclosing(id_np_rf, id_nl_rf)
                            }
                            is_sv_rf = JSComp__IsScriptVar(id_np_rf, id_nl_rf)
                            IfCondition Or(GreaterEqual(owner_rf, 0), EqualTo(is_sv_rf, 1)) ThenBlock: {
                                JSComp__Push(aop)
                                JSComp__Push(saved_ca_member)
                                ci_rf = JSComp__AddString(id_np_rf, id_nl_rf)
                                JSComp__EmitOp16(JSOp.RESOLVE_FREE, ci_rf)
                                saved_ca_member = JSComp__Pop()
                                aop = JSComp__Pop()
                            }
                        }
                    }
                }

                // Load current value — use JSCompDot.member_node (survives calls)
                JSComp__Push(aop)
                JSCompDot.member_node = saved_ca_member
                JSComp__CompileExpr(JSCompDot.member_node)
                aop = JSComp__Pop()

                // Load RHS
                JSComp__Push(aop)
                JSCompDot.member_node = saved_ca_member
                JSCompDot.assign_node = saved_ca_assign
                JSComp__CompileExpr(JSParse_GetRight(JSCompDot.assign_node))
                aop = JSComp__Pop()

                // Emit compound arithmetic/bitwise op
                IfCondition EqualTo(aop, JSTokType.PLUS_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.ADD)
                }
                IfCondition EqualTo(aop, JSTokType.MINUS_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.SUB)
                }
                IfCondition EqualTo(aop, JSTokType.STAR_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.MUL)
                }
                IfCondition EqualTo(aop, JSTokType.SLASH_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.DIV)
                }
                IfCondition EqualTo(aop, JSTokType.PERCENT_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.MOD)
                }
                IfCondition EqualTo(aop, JSTokType.AMP_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.BIT_AND)
                }
                IfCondition EqualTo(aop, JSTokType.PIPE_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.BIT_OR)
                }
                IfCondition EqualTo(aop, JSTokType.CARET_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.BIT_XOR)
                }
                IfCondition EqualTo(aop, JSTokType.SHL_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.SHL)
                }
                IfCondition EqualTo(aop, JSTokType.SHR_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.SHR)
                }
                IfCondition EqualTo(aop, JSTokType.USHR_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.USHR)
                }
                IfCondition EqualTo(aop, JSTokType.STAR_STAR_ASSIGN) ThenBlock: {
                    JSComp__Emit1(JSOp.EXP)
                }

                // Store result — MEMBER_DOT / IDENT (bracket handled above)
                al_type = JSParse_GetType(saved_ca_member)

                // obj.prop op= expr → stack has [result], emit obj, SET_PROP
                IfCondition EqualTo(al_type, ASTType.MEMBER_DOT) ThenBlock: {
                    ca_pnp = JSParse_GetNamePtr(saved_ca_member)
                    ca_pnl = JSParse_GetNameLen(saved_ca_member)
                    JSComp__Push(ca_pnp)
                    JSComp__Push(ca_pnl)
                    JSCompDot.member_node = saved_ca_member
                    JSComp__CompileExpr(JSParse_GetLeft(saved_ca_member))
                    ca_pnl = JSComp__Pop()
                    ca_pnp = JSComp__Pop()
                    // SWAP so stack is [obj, result] for SET_PROP
                    // M101: leave compound-assign result (RHS computation) on stack
                    asv_ci = JSComp__AddString("__asv__", 6)
                    JSComp__Emit1(JSOp.DUP)
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, asv_ci)
                    JSComp__Emit1(JSOp.SWAP)
                    ci = JSComp__AddString(ca_pnp, ca_pnl)
                    JSComp__EmitOp16(JSOp.SET_PROP, ci)
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, asv_ci)
                    ReturnValue(0)
                }

                // Restore for IDENT fallthrough (compound += etc.)
                JSCompDot.member_node = saved_ca_member
                id_np = 0
                id_nl = 0
                IfCondition EqualTo(al_type, ASTType.IDENT) ThenBlock: {
                    id_np = JSParse_GetNamePtr(saved_ca_member)
                    id_nl = JSParse_GetNameLen(saved_ca_member)
                }
            } ElseBlock: {
                                // Simple assignment — handle destructuring patterns first
                IfCondition Or(EqualTo(al_type, ASTType.ARRAY_PATTERN),
                              EqualTo(al_type, ASTType.OBJECT_PATTERN)) ThenBlock: {
                    // Destructuring assignment: compile RHS, store in __dt__, dispatch.
                    // Stash RHS in global so expression result is correct if pattern
                    // leaves stack noise (rest loop / temps) — M20b.
                    JSComp__CompileExpr(JSParse_GetRight(JSCompDot.assign_node))
                    dstr_ci = JSComp__AddString("__dstr_rhs__", 11)
                    JSComp__Emit1(JSOp.DUP)
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, dstr_ci)

                    // Store in __dt__ temp local for pattern
                    da_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                    WRMEM_8(da_nm, 0, 95)
                    WRMEM_8(da_nm, 1, 95)
                    WRMEM_8(da_nm, 2, 100)
                    WRMEM_8(da_nm, 3, 116)
                    WRMEM_8(da_nm, 4, 95)
                    WRMEM_8(da_nm, 5, 95)
                    WRMEM_8(da_nm, 6, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 7)

                    da_slot = JSComp__AddLocal(da_nm, 6)
                    JSComp__EmitOp16(JSOp.SET_LOCAL, da_slot)

                    // Dispatch on pattern type
                    IfCondition EqualTo(al_type, ASTType.ARRAY_PATTERN) ThenBlock: {
                        JSComp__CompileArrayPattern(JSCompDot.member_node, da_slot)
                    } ElseBlock: {
                        JSComp__CompileObjPattern(JSCompDot.member_node, da_slot)
                    }
                    // Assignment expression value is always the RHS
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, dstr_ci)
                    ReturnValue(0)
                }// Handle MEMBER_DOT/BRACKET separately
                // because SET_PROP expects [obj, val] stack order
                IfCondition EqualTo(al_type, ASTType.MEMBER_DOT) ThenBlock: {
                    // Compile: object, value, SET_PROP
                    // Stack: [obj, val] → SET_PROP pops val then obj → correct
                    //
                    // Save JSCompDot fields before recursive compilation.
                    // Inner assignments (e.g. this.x = v inside function body)
                    // can clobber JSCompDot.member_node and .assign_node.
                    saved_member = JSCompDot.member_node
                    saved_assign = JSCompDot.assign_node

                    // Capture name ptr/len BEFORE any recursive calls
                    dot_pnp = JSParse_GetNamePtr(saved_member)
                    dot_pnl = JSParse_GetNameLen(saved_member)

                    // Compile the object expression (LHS of the dot)
                    dot_obj_node = JSParse_GetLeft(saved_member)
                    dot_rhs_node = JSParse_GetRight(saved_assign)

                    // M69: super.prop = val → SET_PROP_SUPER (SuperBase + this Receiver)
                    IfCondition EqualTo(JSParse_GetType(dot_obj_node), ASTType.SUPER_EXPR) ThenBlock: {
                        JSComp__Push(dot_pnp)
                        JSComp__Push(dot_pnl)
                        JSComp__CompileExpr(dot_rhs_node)
                        dot_pnl = JSComp__Pop()
                        dot_pnp = JSComp__Pop()
                        asv_ci = JSComp__AddString("__asv__", 6)
                        JSComp__Emit1(JSOp.DUP)
                        JSComp__EmitOp16(JSOp.SET_GLOBAL, asv_ci)
                        ci = JSComp__AddString(dot_pnp, dot_pnl)
                        JSComp__EmitOp16(JSOp.SET_PROP_SUPER, ci)
                        JSComp__EmitOp16(JSOp.GET_GLOBAL, asv_ci)
                        ReturnValue(0)
                    }

                    JSComp__Push(dot_pnp)
                    JSComp__Push(dot_pnl)
                    JSComp__Push(dot_rhs_node)
                    JSComp__CompileExpr(dot_obj_node)
                    dot_rhs_node = JSComp__Pop()
                    dot_pnl = JSComp__Pop()
                    dot_pnp = JSComp__Pop()

                    // Compile the value expression (RHS of =)
                    JSComp__Push(dot_pnp)
                    JSComp__Push(dot_pnl)
                    JSComp__CompileExpr(dot_rhs_node)
                    dot_pnl = JSComp__Pop()
                    dot_pnp = JSComp__Pop()

                    // Assignment result is RHS: stash, SET_PROP, restore
                    // Stack [obj, val] → DUP → SET_GLOBAL temp → SET_PROP → GET_GLOBAL temp
                    asv_ci = JSComp__AddString("__asv__", 6)
                    JSComp__Emit1(JSOp.DUP)
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, asv_ci)
                    ci = JSComp__AddString(dot_pnp, dot_pnl)
                    JSComp__EmitOp16(JSOp.SET_PROP, ci)
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, asv_ci)
                    ReturnValue(0)
                }
                IfCondition EqualTo(al_type, ASTType.MEMBER_BRACKET) ThenBlock: {
                    // M20: evaluate LHS (base, key) before RHS (spec order).
                    // Key left raw — SET_ELEM ToPropertyKey once (no double convert).
                    // Temps on globals (__cb__/__ck__).
                    saved_member_b = JSCompDot.member_node
                    saved_assign_b = JSCompDot.assign_node
                    br_rhs = JSParse_GetRight(saved_assign_b)
                    br_obj = JSParse_GetLeft(saved_member_b)
                    br_key = JSParse_GetRight(saved_member_b)
                    cb_ci = JSComp__AddString("__cb__", 6)
                    ck_ci = JSComp__AddString("__ck__", 6)

                    // M128e7bo: super[key] = val — SuperBase (not SuperCtor), then
                    // SET_ELEM_SUPER so RHS runs before PutValue TypeError on null base
                    // (target-super-computed-reference-null).
                    IfCondition EqualTo(JSParse_GetType(br_obj), ASTType.SUPER_EXPR) ThenBlock: {
                        // this TDZ (SuperProperty requires initialized this)
                        this_nm_sb = Add(JSCompState.str_buf, JSCompState.str_pos)
                        WRMEM_8(this_nm_sb, 0, 116)
                        WRMEM_8(this_nm_sb, 1, 104)
                        WRMEM_8(this_nm_sb, 2, 105)
                        WRMEM_8(this_nm_sb, 3, 115)
                        WRMEM_8(this_nm_sb, 4, 0)
                        JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                        JSComp__Push(br_rhs)
                        JSComp__Push(ck_ci)
                        tci_sb = JSComp__AddString(this_nm_sb, 4)
                        ck_ci = JSComp__Pop()
                        br_rhs = JSComp__Pop()
                        JSComp__EmitOp16(JSOp.GET_GLOBAL, tci_sb)
                        JSComp__Emit1(JSOp.POP)
                        // SuperBase → __cb__
                        JSComp__Push(br_rhs)
                        JSComp__Push(ck_ci)
                        JSComp__EmitLoadSuperBase()
                        ck_ci = JSComp__Pop()
                        br_rhs = JSComp__Pop()
                        JSComp__EmitOp16(JSOp.SET_GLOBAL, cb_ci)
                        // key → __ck__
                        JSComp__Push(br_rhs)
                        JSComp__Push(cb_ci)
                        JSComp__Push(ck_ci)
                        JSComp__CompileExpr(br_key)
                        ck_ci = JSComp__Pop()
                        cb_ci = JSComp__Pop()
                        br_rhs = JSComp__Pop()
                        JSComp__EmitOp16(JSOp.SET_GLOBAL, ck_ci)
                        // RHS then SET_ELEM_SUPER (stack [val, base, key])
                        asv_ci = JSComp__AddString("__asv__", 6)
                        JSCompTmp.op = asv_ci
                        JSCompTmp.val = cb_ci
                        JSCompTmp.addr = ck_ci
                        JSComp__EmitBracketSave(JSCompTmp.val, JSCompTmp.addr)
                        JSComp__Push(JSCompTmp.val)
                        JSComp__Push(JSCompTmp.addr)
                        JSComp__Push(JSCompTmp.op)
                        JSComp__CompileExpr(br_rhs)
                        JSCompTmp.op = JSComp__Pop()
                        JSCompTmp.addr = JSComp__Pop()
                        JSCompTmp.val = JSComp__Pop()
                        JSComp__EmitBracketRestore(JSCompTmp.val, JSCompTmp.addr)
                        JSComp__Emit1(JSOp.DUP)
                        JSComp__EmitOp16(JSOp.SET_GLOBAL, JSCompTmp.op)
                        JSComp__EmitOp16(JSOp.GET_GLOBAL, JSCompTmp.val)
                        JSComp__EmitOp16(JSOp.GET_GLOBAL, JSCompTmp.addr)
                        JSComp__Emit1(JSOp.SET_ELEM_SUPER)
                        JSComp__EmitOp16(JSOp.GET_GLOBAL, JSCompTmp.op)
                        ReturnValue(0)
                    }

                    // base → __cb__
                    JSComp__Push(br_rhs)
                    JSComp__Push(cb_ci)
                    JSComp__Push(ck_ci)
                    JSComp__CompileExpr(br_obj)
                    ck_ci = JSComp__Pop()
                    cb_ci = JSComp__Pop()
                    br_rhs = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, cb_ci)

                    // key (raw) → __ck__
                    JSComp__Push(br_rhs)
                    JSComp__Push(cb_ci)
                    JSComp__Push(ck_ci)
                    JSComp__CompileExpr(br_key)
                    ck_ci = JSComp__Pop()
                    cb_ci = JSComp__Pop()
                    br_rhs = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, ck_ci)

                    // RHS, then base, key, SET_ELEM — stack [value, array, index]
                    // M101: assignment result is RHS (not undef) — stash across SET_ELEM
                    asv_ci = JSComp__AddString("__asv__", 6)
                    JSCompTmp.op = asv_ci
                    JSCompTmp.val = cb_ci
                    JSCompTmp.addr = ck_ci
                    JSComp__EmitBracketSave(JSCompTmp.val, JSCompTmp.addr)
                    JSComp__Push(JSCompTmp.val)
                    JSComp__Push(JSCompTmp.addr)
                    JSComp__Push(JSCompTmp.op)
                    JSComp__CompileExpr(br_rhs)
                    JSCompTmp.op = JSComp__Pop()
                    JSCompTmp.addr = JSComp__Pop()
                    JSCompTmp.val = JSComp__Pop()
                    JSComp__EmitBracketRestore(JSCompTmp.val, JSCompTmp.addr)
                    JSComp__Emit1(JSOp.DUP)
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, JSCompTmp.op)
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, JSCompTmp.val)
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, JSCompTmp.addr)
                    JSComp__Emit1(JSOp.SET_ELEM)
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, JSCompTmp.op)
                    ReturnValue(0)
                }

                // IDENT and other targets: compile RHS, DUP, store.
                // MUST save LHS before CompileExpr — nested function bodies
                // with free-var assigns clobber JSCompDot.member_node (same
                // class as MEMBER_DOT fix). Without this, `var n=0; var f;
                // f = function(){ n=1 }` stores the function into n, not f.
                saved_id_member = JSCompDot.member_node
                saved_id_assign = JSCompDot.assign_node
                saved_id_altype = al_type
                id_np = 0
                id_nl = 0
                IfCondition EqualTo(al_type, ASTType.IDENT) ThenBlock: {
                    id_np = JSParse_GetNamePtr(saved_id_member)
                    id_nl = JSParse_GetNameLen(saved_id_member)
                }
                // M128e6r: under with, resolve IdentReference BEFORE RHS (no GetValue).
                // Uses GET_WITH with slot 0xFFFFFE = resolve-only (never throw unresolvable).
                // Sets WithRef for PutValue after delete (S11.13.1_A5); POP dummy.
                // M128e6v A6: free-var RESOLVE_FREE before RHS (eval may introduce closer binding).
                IfCondition EqualTo(al_type, ASTType.IDENT) ThenBlock: {
                    IfCondition GreaterThan(JSCompState.with_depth, 0) ThenBlock: {
                        JSComp__Push(id_np)
                        JSComp__Push(id_nl)
                        JSComp__Push(saved_id_altype)
                        ci_r = JSComp__AddString(id_np, id_nl)
                        JSComp__EmitOp16(JSOp.GET_WITH, ci_r)
                        // trailing 24-bit slot 0xFFFFFE = resolve-only (M128e6r)
                        // (JSVM__Read16 actually consumes 3 big-endian bytes)
                        JSComp__Emit1(255)
                        JSComp__Emit1(255)
                        JSComp__Emit1(254)
                        JSComp__Emit1(JSOp.POP)
                        saved_id_altype = JSComp__Pop()
                        id_nl = JSComp__Pop()
                        id_np = JSComp__Pop()
                    }
                    IfCondition EqualTo(JSCompState.with_depth, 0) ThenBlock: {
                        // M128e6aj: always RESOLVE_FREE for non-local idents so free-var
                        // PutValue can hit captured with ObjectEnv (__cenv) even when the
                        // name is not a compile-time enclosing/script binding.
                        slot_rf = JSComp__FindLocal(id_np, id_nl)
                        IfCondition LessThan(slot_rf, 0) ThenBlock: {
                            is_args_rf = JSComp__IsArgumentsName(id_np, id_nl)
                            IfCondition EqualTo(is_args_rf, 0) ThenBlock: {
                                JSComp__Push(id_np)
                                JSComp__Push(id_nl)
                                JSComp__Push(saved_id_altype)
                                ci_rf = JSComp__AddString(id_np, id_nl)
                                JSComp__EmitOp16(JSOp.RESOLVE_FREE, ci_rf)
                                saved_id_altype = JSComp__Pop()
                                id_nl = JSComp__Pop()
                                id_np = JSComp__Pop()
                            }
                        }
                    }
                }
                JSComp__Push(is_cover_lhs)
                JSComp__Push(id_np)
                JSComp__Push(id_nl)
                JSComp__Push(saved_id_altype)
                JSComp__CompileExpr(JSParse_GetRight(saved_id_assign))
                al_type = JSComp__Pop()
                id_nl = JSComp__Pop()
                id_np = JSComp__Pop()
                is_cover_lhs = JSComp__Pop()
            }

            // DUP so assignment leaves value on stack (for expr result)
            JSComp__Emit1(JSOp.DUP)

            // Emit store based on target type
            IfCondition EqualTo(al_type, ASTType.IDENT) ThenBlock: {
                JSComp__EmitVarSet(id_np, id_nl)
                // M128e6s/z: SetFunctionName when Ident = anonymous function/class/arrow/gen
                // M128e6w: NOT for CoverParenthesized LHS (fn-name-lhs-cover)
                // M128e6aa: IsAnonFuncDef unwraps PAREN on RHS so cover = (function(){})
                // names and xCover = (0, function(){}) does not (fn-name-cover).
                rhs_sf = JSParse_GetRight(JSCompDot.assign_node)
                is_anon_sf = 0
                IfCondition EqualTo(is_cover_lhs, 0) ThenBlock: {
                    is_anon_sf = JSComp__IsAnonFuncDef(rhs_sf)
                }
                IfCondition And(EqualTo(is_anon_sf, 1), GreaterThan(id_nl, 0)) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    nm_key_sf = Add(JSCompState.str_buf, JSCompState.str_pos)
                    WRMEM_8(nm_key_sf, 0, 110)
                    WRMEM_8(nm_key_sf, 1, 97)
                    WRMEM_8(nm_key_sf, 2, 109)
                    WRMEM_8(nm_key_sf, 3, 101)
                    WRMEM_8(nm_key_sf, 4, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                    JSComp__Push(id_np)
                    JSComp__Push(id_nl)
                    nkci_sf = JSComp__AddString(nm_key_sf, 4)
                    id_nl = JSComp__Pop()
                    id_np = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.GET_PROP, nkci_sf)
                    JSComp__Emit1(JSOp.DUP)
                    emp_sf = Add(JSCompState.str_buf, JSCompState.str_pos)
                    WRMEM_8(emp_sf, 0, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 1)
                    JSComp__Push(nkci_sf)
                    JSComp__Push(id_np)
                    JSComp__Push(id_nl)
                    emp_ci_sf = JSComp__AddString(emp_sf, 0)
                    id_nl = JSComp__Pop()
                    id_np = JSComp__Pop()
                    nkci_sf = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.PUSH_CONST, emp_ci_sf)
                    JSComp__Emit1(JSOp.STRICT_EQ)
                    skip_sn_sf = JSCompState.code_pos
                    JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                    JSComp__Emit1(JSOp.POP)
                    JSComp__Push(nkci_sf)
                    JSComp__Push(id_np)
                    JSComp__Push(id_nl)
                    nci_sf = JSComp__AddString(id_np, id_nl)
                    id_nl = JSComp__Pop()
                    id_np = JSComp__Pop()
                    nkci_sf = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.PUSH_CONST, nci_sf)
                    JSComp__EmitOp16(JSOp.SET_FUNC_NAME, nkci_sf)
                    skip_end_sf = JSCompState.code_pos
                    JSComp__EmitOp16(JSOp.JMP, 0)
                    JSComp__PatchJump(skip_sn_sf)
                    JSComp__Emit1(JSOp.POP)
                    JSComp__Emit1(JSOp.POP)
                    JSComp__PatchJump(skip_end_sf)
                }
            }
            ReturnValue(0)
        
    }
}

Function.JSComp__ExprUnaryOp {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node

            uop = JSParse_GetOp(save_node)
            ul = JSParse_GetLeft(save_node)

            // Template ${expr} wrapper (parser N_OP 200) → ToString
            IfCondition EqualTo(uop, 200) ThenBlock: {
                JSComp__CompileExpr(ul)
                JSComp__Emit1(JSOp.TO_STRING)
                ReturnValue(0)
            }

            // delete obj.prop / delete obj[key] — must not evaluate to the value
            IfCondition EqualTo(uop, JSTokType.KW_DELETE) ThenBlock: {
                ul_type = JSParse_GetType(ul)
                // M128e7ag: delete super.x / delete super[k] → ReferenceError
                // (IsSuperReference may not be deleted — ES 13.5.1.2)
                IfCondition EqualTo(ul_type, ASTType.MEMBER_DOT) ThenBlock: {
                    obj = JSParse_GetLeft(ul)
                    IfCondition EqualTo(JSParse_GetType(obj), ASTType.SUPER_EXPR) ThenBlock: {
                        JSComp__Emit1(JSOp.THROW_SUPER_DEL)
                        ReturnValue(0)
                    }
                    JSComp__Push(ul)
                    JSComp__CompileExpr(obj)
                    ul = JSComp__Pop()
                    pnp = JSParse_GetNamePtr(ul)
                    pnl = JSParse_GetNameLen(ul)
                    ci = JSComp__AddString(pnp, pnl)
                    JSComp__EmitOp16(JSOp.PUSH_CONST, ci)
                    JSComp__Emit1(JSOp.DELETE_PROP)
                    ReturnValue(0)
                }
                // delete o[k] → compile o, compile k, DELETE_PROP
                IfCondition EqualTo(ul_type, ASTType.MEMBER_BRACKET) ThenBlock: {
                    obj = JSParse_GetLeft(ul)
                    IfCondition EqualTo(JSParse_GetType(obj), ASTType.SUPER_EXPR) ThenBlock: {
                        // still evaluate key for side effects? Spec: GetValue of SuperReference
                        // throws before Delete — key not evaluated. ES: evaluate SuperProperty
                        // MemberExpression then throw on delete.
                        JSComp__Emit1(JSOp.THROW_SUPER_DEL)
                        ReturnValue(0)
                    }
                    key = JSParse_GetRight(ul)
                    JSComp__Push(ul)
                    JSComp__CompileExpr(obj)
                    ul = JSComp__Pop()
                    key = JSParse_GetRight(ul)
                    JSComp__CompileExpr(key)
                    JSComp__Emit1(JSOp.DELETE_PROP)
                    ReturnValue(0)
                }
                // M105: delete ident — arguments/var/func bindings are DontDelete
                // (ES non-configurable). Was always PUSH_TRUE.
                IfCondition EqualTo(ul_type, ASTType.IDENT) ThenBlock: {
                    dnp = JSParse_GetNamePtr(ul)
                    dnl = JSParse_GetNameLen(ul)
                    // delete arguments → false
                    is_args_del = 0
                    IfCondition EqualTo(JSRT_StrEq(dnp, "arguments"), 1) ThenBlock: {
                        is_args_del = 1
                    }
                    IfCondition EqualTo(dnl, 9) ThenBlock: {
                        IfCondition EqualTo(RDMEM_8(dnp, 0), 97) ThenBlock: {
                            IfCondition EqualTo(RDMEM_8(dnp, 1), 114) ThenBlock: {
                                IfCondition EqualTo(RDMEM_8(dnp, 8), 115) ThenBlock: {
                                    is_args_del = 1
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(is_args_del, 1) ThenBlock: {
                        JSComp__Emit1(JSOp.PUSH_FALSE)
                        ReturnValue(0)
                    }
                    // M128e: under with, runtime DELETE_GLOBAL walks ObjectEnv first
                    // (delete may target with-object even when outer var exists).
                    IfCondition GreaterThan(JSCompState.with_depth, 0) ThenBlock: {
                        ci_dn = JSComp__AddString(dnp, dnl)
                        JSComp__EmitOp16(JSOp.DELETE_GLOBAL, ci_dn)
                        ReturnValue(0)
                    }
                    // Local binding (function-scoped var/func/param) → false
                    // M128h: eval_mode locals may be configurable (eval CreateMutableBinding D=true)
                    dslot = JSComp__FindLocal(dnp, dnl)
                    IfCondition GreaterEqual(dslot, 0) ThenBlock: {
                        IfCondition EqualTo(JSCompState.eval_mode, 0) ThenBlock: {
                            JSComp__Emit1(JSOp.PUSH_FALSE)
                            ReturnValue(0)
                        }
                    }
                    // Existing global/dyn binding — DELETE_GLOBAL (respects configurable)
                    // Undeclared → true (non-strict delete of unresolvable)
                    ci_dn = JSComp__AddString(dnp, dnl)
                    JSComp__EmitOp16(JSOp.DELETE_GLOBAL, ci_dn)
                    ReturnValue(0)
                }
                // delete other — eval for side effects, push true
                JSComp__CompileExpr(ul)
                JSComp__Emit1(JSOp.POP)
                JSComp__Emit1(JSOp.PUSH_TRUE)
                ReturnValue(0)
            }

            JSComp__CompileExpr(ul)
            IfCondition EqualTo(uop, JSTokType.MINUS) ThenBlock: {
                JSComp__Emit1(JSOp.NEG)
            }
            IfCondition EqualTo(uop, JSTokType.NOT) ThenBlock: {
                JSComp__Emit1(JSOp.NOT)
            }
            IfCondition EqualTo(uop, JSTokType.TILDE) ThenBlock: {
                JSComp__Emit1(JSOp.BIT_NOT)
            }
            IfCondition EqualTo(uop, JSTokType.KW_VOID) ThenBlock: {
                // void expr: evaluate for side effects, discard, push undefined
                JSComp__Emit1(JSOp.POP)
                JSComp__Emit1(JSOp.PUSH_UNDEF)
            }
            IfCondition EqualTo(uop, JSTokType.PLUS) ThenBlock: {
                // unary +: ToNumber (BigInt → TypeError)
                JSComp__Emit1(JSOp.TO_NUMBER)
            }
            ReturnValue(0)
        
    }
}
