// Library.JSCompStmt.ailang — Statement/declaration compilation
// Split from Library.JSCompiler.ailang. FixedPools declared in root file.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// =============================================================================
// FINALLY ON ABRUPT EXIT — continue / break / return
// Walks the finally stack from innermost to outermost:
//   - if still in try body → TRY_POP (clear handler)
//   - PopFinally BEFORE inlining so return/throw inside finally does not
//     re-enter the same frame (was infinite compile recursion → Compile fail)
//   - inline finally body so it runs before the jump/return
// =============================================================================
Function.JSComp__EmitPendingFinally {
    Output: Integer
    Body: {
        // Pop one frame at a time (innermost first) until empty
        WhileLoop GreaterThan(JSCompState.finally_depth, 0) {
            depth_idx = Subtract(JSCompState.finally_depth, 1)
            base = Add(JSCompState.finally_stack, Multiply(depth_idx, JSCompConst.FINALLY_SIZE))
            fin_body = Dereference(base)
            in_try = Dereference(Add(base, 8))
            // Leaving try body abruptly: drop the exception handler
            IfCondition EqualTo(in_try, 1) ThenBlock: {
                JSComp__Emit1(JSOp.TRY_POP)
            }
            // Remove frame before CompileNode so nested return only sees outers
            JSComp__PopFinally()
            IfCondition GreaterEqual(fin_body, 0) ThenBlock: {
                JSComp__CompileNode(fin_body)
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// AST WALKING — COMPILE STATEMENTS
// =============================================================================

// ---------------------------------------------------------------------------
// Compile a single AST node (statement or declaration)
// ---------------------------------------------------------------------------
// M128e6k: Do NOT recurse into N_NEXT VAR_DECL here. Program/block walkers
// already visit every N_NEXT node (multi-var `let a,b` and consecutive
// `let a; let b` share the same chain). Recursing double-ran initializers
// (async IIFE / new Promise → iterationCount 2, free-var += doubles).
// Single-node sites (for-init, export) walk the chain via CompileVarChain.
// ---------------------------------------------------------------------------
Function.JSComp__CompileVarChain {
    Input: node: Integer
    Output: Integer
    Body: {
        cur = node
        WhileLoop GreaterEqual(cur, 0) {
            JSComp__Push(cur)
            JSComp__CompileNode(cur)
            cur = JSComp__Pop()
            // Only continue for multi-var / consecutive VAR_DECL chain
            IfCondition NotEqual(JSParse_GetType(cur), ASTType.VAR_DECL) ThenBlock: {
                ReturnValue(0)
            }
            cur = JSParse_GetNext(cur)
            IfCondition GreaterEqual(cur, 0) ThenBlock: {
                IfCondition NotEqual(JSParse_GetType(cur), ASTType.VAR_DECL) ThenBlock: {
                    ReturnValue(0)
                }
            }
        }
        ReturnValue(0)
    }
}

Function.JSComp__CompileNode {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node
        IfCondition EqualTo(JSCompState.error, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(save_node, 0) ThenBlock: { ReturnValue(-1) }

        ntype = JSParse_GetType(save_node)

        // --- PROGRAM ---
        IfCondition EqualTo(ntype, ASTType.PROGRAM) ThenBlock: {
            JSComp__CompileProgram(save_node)
            ReturnValue(0)
        }

        // M112: EXPORT_STMT / IMPORT_STMT — compile inner decl; import is no-op until linker
        IfCondition EqualTo(ntype, ASTType.EXPORT_STMT) ThenBlock: {
            inner = JSParse_GetLeft(save_node)
            IfCondition GreaterEqual(inner, 0) ThenBlock: {
                // M128e6k: export let a=1, b=2 — walk multi-var chain
                IfCondition EqualTo(JSParse_GetType(inner), ASTType.VAR_DECL) ThenBlock: {
                    JSComp__CompileVarChain(inner)
                } ElseBlock: {
                    JSComp__CompileNode(inner)
                }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(ntype, ASTType.IMPORT_STMT) ThenBlock: {
            // Multi-module link not yet wired; parse-accepted no-op
            ReturnValue(0)
        }

        // --- BLOCK ---
        IfCondition EqualTo(ntype, ASTType.BLOCK) ThenBlock: {
            JSComp__CompileBlock(save_node)
            ReturnValue(0)
        }

        // --- VAR_DECL ---
        IfCondition EqualTo(ntype, ASTType.VAR_DECL) ThenBlock: {
            // Check for destructuring pattern in N_RIGHT
            pat = JSParse_GetRight(save_node)
            IfCondition GreaterEqual(pat, 0) ThenBlock: {
                // Destructuring: compile RHS, store in temp, then compile pattern
                init = JSParse_GetLeft(save_node)

                JSComp__Push(save_node)
                JSComp__Push(pat)
                JSComp__CompileExpr(init)
                pat = JSComp__Pop()
                save_node = JSComp__Pop()

                // Store RHS in a temporary local
                dt_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                // __dt__ = 6 bytes: 95,95,100,116,95,95
                SetByte(dt_nm, 0, 95)
                SetByte(dt_nm, 1, 95)
                SetByte(dt_nm, 2, 100)
                SetByte(dt_nm, 3, 116)
                SetByte(dt_nm, 4, 95)
                SetByte(dt_nm, 5, 95)
                SetByte(dt_nm, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)

                JSComp__Push(save_node)
                JSComp__Push(pat)
                dt_slot = JSComp__AddLocal(dt_nm, 6)
                pat = JSComp__Pop()
                save_node = JSComp__Pop()

                JSComp__EmitOp16(JSOp.SET_LOCAL, dt_slot)

                // Dispatch on pattern type
                pat_type = JSParse_GetType(pat)
                IfCondition EqualTo(pat_type, ASTType.ARRAY_PATTERN) ThenBlock: {
                    JSComp__CompileArrayPattern(pat, dt_slot)
                } ElseBlock: {
                    IfCondition EqualTo(pat_type, ASTType.OBJECT_PATTERN) ThenBlock: {
                        JSComp__CompileObjPattern(pat, dt_slot)
                    }
                }
                // M128e6k: next VAR_DECL is compiled by the statement walker
                ReturnValue(0)
            }

            np = JSParse_GetNamePtr(save_node)
            nl = JSParse_GetNameLen(save_node)

            // Get var kind from N_OP (70=var, 71=let, 72=const)
            vkind = JSParse_GetOp(save_node)

            // M128e: var is function-scoped (survives with/block PopScope).
            // let/const stay block-scoped via FindLocalInScope + AddLocal.
            slot = -1
            IfCondition EqualTo(vkind, 70) ThenBlock: {
                slot = JSComp__AddVarLocal(np, nl)
            } ElseBlock: {
                // Check if already pre-declared (TDZ hoisting for let/const)
                slot = JSComp__FindLocalInScope(np, nl)
                IfCondition LessThan(slot, 0) ThenBlock: {
                    slot = JSComp__AddLocal(np, nl)
                }
            }

            // Check for initializer (N_LEFT)
            init = JSParse_GetLeft(save_node)
            IfCondition GreaterEqual(init, 0) ThenBlock: {
                JSComp__Push(slot)
                JSComp__Push(np)
                JSComp__Push(nl)
                JSComp__CompileExpr(init)
                nl = JSComp__Pop()
                np = JSComp__Pop()
                slot = JSComp__Pop()
                // M128e: var init under with is Assignment to IdentReference —
                // PutValue uses with ObjectEnv when binding present (A1.x value).
                // Outer function-scoped slot (AddVarLocal) gets value only when
                // the with object has no binding (SET_WITH path 3).
                IfCondition EqualTo(vkind, 70) ThenBlock: {
                    IfCondition GreaterThan(JSCompState.with_depth, 0) ThenBlock: {
                        JSComp__EmitVarSet(np, nl)
                        ReturnValue(0)
                    }
                }
                // Top-level: dual-write GlobalHash + frame/script env (Mole 7 / M59).
                // M128e6g: eval let/const also SET_GLOBAL as free-var mirror so
                // GET_FREE from async gen/fn can resolve via HasGlobal fallback.
                do_glob = 1
                IfCondition And(EqualTo(JSCompState.func_nesting, 0), EqualTo(do_glob, 1)) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    ci_vd = JSComp__AddString(np, nl)
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_vd)
                }
                // M128s: in eval_mode always SET_FRAME_ENV (incl. arguments) so
                // arrow param-init `var arguments` is visible via GET_FREE/own env.
                skip_cap = JSComp__IsArgumentsName(np, nl)
                do_fe = 0
                IfCondition EqualTo(skip_cap, 0) ThenBlock: { do_fe = 1 }
                IfCondition EqualTo(JSCompState.eval_mode, 1) ThenBlock: { do_fe = 1 }
                IfCondition EqualTo(do_fe, 1) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    ci_vd = JSComp__AddString(np, nl)
                    JSComp__EmitOp16(JSOp.SET_FRAME_ENV, ci_vd)
                    // 24-bit BE slot (JSVM__Read16 is 3 bytes)
                    JSComp__Emit1(0)
                    JSComp__Emit1(BitwiseAnd(ShiftRight(slot, 8), 255))
                    JSComp__Emit1(BitwiseAnd(slot, 255))
                }
                JSComp__EmitOp16(JSOp.SET_LOCAL, slot)
                // M128e6f: clear TDZ / mark const before return (was fallthrough)
                IfCondition And(GreaterEqual(vkind, 71), LessThan(slot, 256)) ThenBlock: {
                    SetByte(JSCompState.tdz_map, slot, 0)
                }
                IfCondition EqualTo(vkind, 72) ThenBlock: {
                    IfCondition LessThan(slot, 256) ThenBlock: {
                        SetByte(JSCompState.const_map, slot, 1)
                    }
                    JSComp__RegisterConstName(np, nl)
                }
                // M128e6k: multi-var / next let chain handled by statement walker
                // (was CompileNode(next) — double-ran initializers with walker)
                ReturnValue(0)
            } ElseBlock: {
                // const without initializer is a SyntaxError
                IfCondition EqualTo(vkind, 72) ThenBlock: {
                    JSCompState.error = 1
                    ReturnValue(-1)
                }
                // var without initializer: ES is empty for value, but we still
                // need the same dual-write as `var x = undefined` so free-var
                // SET_FREE can update stack via __sl_ (super.fromA → outer).
                // M128h: in eval_mode do NOT re-SET_GLOBAL (eval 'delete x; var x'
                // must leave the binding deleted). Still SET_FRAME_ENV + SET_LOCAL
                // so __sl_ exists for free-var stack sync (test262 uses EvalString).
                // M128e6: only chain multi-var declarators (same VAR_DECL type),
                // not next program statements (N_NEXT also links statements).
                IfCondition EqualTo(vkind, 70) ThenBlock: {
                    JSComp__Emit1(JSOp.PUSH_UNDEF)
                    // Program scripts: dual-write GlobalHash. Eval: skip global.
                    IfCondition EqualTo(JSCompState.eval_mode, 0) ThenBlock: {
                        IfCondition EqualTo(JSCompState.func_nesting, 0) ThenBlock: {
                            JSComp__Emit1(JSOp.DUP)
                            ci_vd = JSComp__AddString(np, nl)
                            JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_vd)
                        }
                    }
                    skip_cap = JSComp__IsArgumentsName(np, nl)
                    IfCondition EqualTo(skip_cap, 0) ThenBlock: {
                        JSComp__Emit1(JSOp.DUP)
                        ci_vd = JSComp__AddString(np, nl)
                        JSComp__EmitOp16(JSOp.SET_FRAME_ENV, ci_vd)
                        JSComp__Emit1(0)
                        JSComp__Emit1(BitwiseAnd(ShiftRight(slot, 8), 255))
                        JSComp__Emit1(BitwiseAnd(slot, 255))
                    }
                    JSComp__EmitOp16(JSOp.SET_LOCAL, slot)
                    // M128e6k: next VAR_DECL compiled by statement walker
                    ReturnValue(0)
                }
                // let without initializer still needs TDZ clear via SET_LOCAL
                JSComp__Emit1(JSOp.PUSH_UNDEF)
                // M128e6g: always dual-write top-level let/const to GlobalHash so
                // free-var GET_FREE from async gen/fn can resolve via HasGlobal
                // fallback (cenv often misses eval_var_env). Stack/env stay source
                // of truth for TDZ; GlobalHash is a free-var mirror only.
                do_glob2 = 1
                IfCondition And(EqualTo(JSCompState.func_nesting, 0), EqualTo(do_glob2, 1)) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    ci_vd = JSComp__AddString(np, nl)
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_vd)
                }
                skip_cap2 = JSComp__IsArgumentsName(np, nl)
                do_fe2 = 0
                IfCondition EqualTo(do_glob2, 1) ThenBlock: {
                    IfCondition EqualTo(skip_cap2, 0) ThenBlock: { do_fe2 = 1 }
                    IfCondition EqualTo(JSCompState.eval_mode, 1) ThenBlock: { do_fe2 = 1 }
                }
                IfCondition EqualTo(do_fe2, 1) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    ci_vd = JSComp__AddString(np, nl)
                    JSComp__EmitOp16(JSOp.SET_FRAME_ENV, ci_vd)
                    JSComp__Emit1(0)
                    JSComp__Emit1(BitwiseAnd(ShiftRight(slot, 8), 255))
                    JSComp__Emit1(BitwiseAnd(slot, 255))
                }
                JSComp__EmitOp16(JSOp.SET_LOCAL, slot)
            }
            // Clear TDZ mark for let/const after initialization
            IfCondition And(GreaterEqual(vkind, 71), LessThan(slot, 256)) ThenBlock: {
                SetByte(JSCompState.tdz_map, slot, 0)
            }
            // M20c: mark const for reassignment TypeError
            IfCondition EqualTo(vkind, 72) ThenBlock: {
                IfCondition LessThan(slot, 256) ThenBlock: {
                    SetByte(JSCompState.const_map, slot, 1)
                }
                JSComp__RegisterConstName(np, nl)
            }
            ReturnValue(0)
        }

        // --- FUNC_DECL ---
        IfCondition EqualTo(ntype, ASTType.FUNC_DECL) ThenBlock: {
            // Add function name as local
            np = JSParse_GetNamePtr(save_node)
            nl = JSParse_GetNameLen(save_node)

            slot = JSComp__AddLocal(np, nl)

            // Compile function body into func_pool
            JSComp__Push(slot)
            JSComp__Push(np)
            JSComp__Push(nl)
            JSComp__CompileFunc(save_node)
            nl = JSComp__Pop()
            np = JSComp__Pop()
            slot = JSComp__Pop()

            // Global + frame/script env (M59 free-var capture of func decls)
            IfCondition GreaterEqual(JSCompState.func_nesting, 0) ThenBlock: {
                JSComp__Emit1(JSOp.DUP)
                ci_fd = JSComp__AddString(np, nl)
                JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_fd)
            }
            JSComp__Emit1(JSOp.DUP)
            ci_fe = JSComp__AddString(np, nl)
            JSComp__EmitOp16(JSOp.SET_FRAME_ENV, ci_fe)
            JSComp__Emit1(0)
            JSComp__Emit1(BitwiseAnd(ShiftRight(slot, 8), 255))
            JSComp__Emit1(BitwiseAnd(slot, 255))
            JSComp__EmitOp16(JSOp.SET_LOCAL, slot)
            ReturnValue(0)
        }

        // --- GEN_FUNC_DECL (function* name) ---
        IfCondition EqualTo(ntype, ASTType.GEN_FUNC_DECL) ThenBlock: {
            np = JSParse_GetNamePtr(save_node)
            nl = JSParse_GetNameLen(save_node)

            slot = JSComp__AddLocal(np, nl)
            JSComp__Push(slot)
            JSComp__Push(np)
            JSComp__Push(nl)
            JSComp__CompileFunc(save_node)
            nl = JSComp__Pop()
            np = JSComp__Pop()
            slot = JSComp__Pop()
            IfCondition GreaterEqual(JSCompState.func_nesting, 0) ThenBlock: {
                JSComp__Emit1(JSOp.DUP)
                ci_fd = JSComp__AddString(np, nl)
                JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_fd)
            }
            JSComp__Emit1(JSOp.DUP)
            ci_fe = JSComp__AddString(np, nl)
            JSComp__EmitOp16(JSOp.SET_FRAME_ENV, ci_fe)
            JSComp__Emit1(0)
            JSComp__Emit1(BitwiseAnd(ShiftRight(slot, 8), 255))
            JSComp__Emit1(BitwiseAnd(slot, 255))
            JSComp__EmitOp16(JSOp.SET_LOCAL, slot)
            ReturnValue(0)
        }

        // --- ASYNC_FUNC_DECL (async function name) ---
        IfCondition EqualTo(ntype, ASTType.ASYNC_FUNC_DECL) ThenBlock: {
            np = JSParse_GetNamePtr(save_node)
            nl = JSParse_GetNameLen(save_node)

            slot = JSComp__AddLocal(np, nl)
            JSComp__Push(slot)
            JSComp__Push(np)
            JSComp__Push(nl)
            JSComp__CompileFunc(save_node)
            nl = JSComp__Pop()
            np = JSComp__Pop()
            slot = JSComp__Pop()
            IfCondition GreaterEqual(JSCompState.func_nesting, 0) ThenBlock: {
                JSComp__Emit1(JSOp.DUP)
                ci_fd = JSComp__AddString(np, nl)
                JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_fd)
            }
            JSComp__Emit1(JSOp.DUP)
            ci_fe = JSComp__AddString(np, nl)
            JSComp__EmitOp16(JSOp.SET_FRAME_ENV, ci_fe)
            JSComp__Emit1(0)
            JSComp__Emit1(BitwiseAnd(ShiftRight(slot, 8), 255))
            JSComp__Emit1(BitwiseAnd(slot, 255))
            JSComp__EmitOp16(JSOp.SET_LOCAL, slot)
            ReturnValue(0)
        }

        // --- CLASS_DECL ---
        IfCondition EqualTo(ntype, ASTType.CLASS_DECL) ThenBlock: {
            np = JSParse_GetNamePtr(save_node)
            nl = JSParse_GetNameLen(save_node)

            // Reuse TDZ pre-decl slot (AddLocal always appends — duplicate name
            // would leave tdz_map[old]=1 while SET_LOCAL writes a new slot).
            slot = JSComp__FindLocalInScope(np, nl)
            IfCondition LessThan(slot, 0) ThenBlock: {
                slot = JSComp__AddLocal(np, nl)
            }
            JSComp__Push(slot)
            JSComp__Push(np)
            JSComp__Push(nl)
            JSComp__CompileClass(save_node)
            nl = JSComp__Pop()
            np = JSComp__Pop()
            slot = JSComp__Pop()
            // Clear compile-time TDZ so later refs use the class binding
            IfCondition And(GreaterEqual(slot, 0), LessThan(slot, 256)) ThenBlock: {
                SetByte(JSCompState.tdz_map, slot, 0)
            }
            // Dual-write env (non-eval: script_env/global; eval: SET_FRAME_ENV → eval_var_env)
            // Skip SET_GLOBAL only in eval_mode so class stays lexical/ephemeral.
            IfCondition EqualTo(JSCompState.eval_mode, 0) ThenBlock: {
                IfCondition GreaterEqual(JSCompState.func_nesting, 0) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    ci_fd = JSComp__AddString(np, nl)
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_fd)
                }
            }
            JSComp__Emit1(JSOp.DUP)
            ci_fe = JSComp__AddString(np, nl)
            JSComp__EmitOp16(JSOp.SET_FRAME_ENV, ci_fe)
            JSComp__Emit1(0)
            JSComp__Emit1(BitwiseAnd(ShiftRight(slot, 8), 255))
            JSComp__Emit1(BitwiseAnd(slot, 255))
            JSComp__EmitOp16(JSOp.SET_LOCAL, slot)
            ReturnValue(0)
        }

        // --- WITH_STMT ---
        // M128d: with (obj) body — Object Environment Record
        IfCondition EqualTo(ntype, ASTType.WITH_STMT) ThenBlock: {
            // Strict mode: with is SyntaxError
            IfCondition EqualTo(JSCompState.is_strict, 1) ThenBlock: {
                JSCompState.error = 1
                ReturnValue(-1)
            }
            obj_n = JSParse_GetLeft(save_node)
            body_n = JSParse_GetBody(save_node)
            JSComp__Push(save_node)
            JSComp__Push(body_n)
            JSComp__CompileExpr(obj_n)
            body_n = JSComp__Pop()
            save_node = JSComp__Pop()
            JSComp__Emit1(JSOp.WITH_PUSH)
            JSCompState.with_depth = Add(JSCompState.with_depth, 1)
            JSComp__Push(save_node)
            JSComp__CompileNode(body_n)
            save_node = JSComp__Pop()
            JSCompState.with_depth = Subtract(JSCompState.with_depth, 1)
            JSComp__Emit1(JSOp.WITH_POP)
            ReturnValue(0)
        }

        // --- RETURN_STMT ---
        IfCondition EqualTo(ntype, ASTType.RETURN_STMT) ThenBlock: {
            // M128h: return only legal in function code (script/eval top-level → SyntaxError)
            IfCondition EqualTo(JSCompState.func_nesting, 0) ThenBlock: {
                JSCompState.error = 1
                ReturnValue(-1)
            }
            ret_expr = JSParse_GetLeft(save_node)
            IfCondition GreaterEqual(ret_expr, 0) ThenBlock: {
                JSComp__CompileExpr(ret_expr)
            } ElseBlock: {
                JSComp__Emit1(JSOp.PUSH_UNDEF)
            }
            // Run enclosing finally blocks before leaving the function
            JSComp__EmitPendingFinally()
            // M55: IteratorClose all open for-of (return interrupts iteration)
            JSComp__EmitPendingIterClose(0, 1, 0)
            JSComp__Emit1(JSOp.RETURN)
            ReturnValue(0)
        }

        // THROW: do NOT EmitPendingIterClose here — catch may handle the throw.
        // Uncaught throws from for-of body are closed by for-of's try handler.

        // --- EXPR_STMT ---
        IfCondition EqualTo(ntype, ASTType.EXPR_STMT) ThenBlock: {
            es = JSParse_GetLeft(save_node)
            JSComp__CompileExpr(es)
            // M65: for-of eval completion — store body value into loop V slot
            IfCondition GreaterEqual(JSCompState.loop_cptn_slot, 0) ThenBlock: {
                JSComp__EmitOp16(JSOp.SET_LOCAL, JSCompState.loop_cptn_slot)
            } ElseBlock: {
                // In eval mode, skip POP for the last expression — leave result on stack
                IfCondition And(EqualTo(JSCompState.eval_mode, 1), EqualTo(JSCompState.is_last_stmt, 1)) ThenBlock: {
                    // Keep value on stack for JSVM_Run to return
                } ElseBlock: {
                    JSComp__Emit1(JSOp.POP)
                }
            }
            ReturnValue(0)
        }

        // --- IF_STMT ---
        IfCondition EqualTo(ntype, ASTType.IF_STMT) ThenBlock: {
            // Compile condition
            cond_n = JSParse_GetCond(save_node)

            JSComp__Push(save_node)
            JSComp__CompileExpr(cond_n)
            save_node = JSComp__Pop()

            // JMP_FALSE to else/end
            false_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP_FALSE, 0)

            // Compile then-body
            body_n = JSParse_GetBody(save_node)

            JSComp__Push(save_node)
            JSComp__Push(false_jmp)
            JSComp__CompileNode(body_n)
            false_jmp = JSComp__Pop()
            save_node = JSComp__Pop()

            // Check for else branch (N_RIGHT)
            else_n = JSParse_GetRight(save_node)
            IfCondition GreaterEqual(else_n, 0) ThenBlock: {
                // JMP over else
                end_jmp = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP, 0)

                // Patch false_jmp to here (start of else)
                JSComp__PatchJump(false_jmp)

                // Compile else body
                JSComp__CompileNode(else_n)

                // Patch end_jmp
                JSComp__PatchJump(end_jmp)
            } ElseBlock: {
                // No else — patch false_jmp to here
                JSComp__PatchJump(false_jmp)
            }
            ReturnValue(0)
        }

        // --- WHILE_STMT ---
        IfCondition EqualTo(ntype, ASTType.WHILE_STMT) ThenBlock: {
            loop_start = JSCompState.code_pos
            JSComp__PushLoop(loop_start)

            // Compile condition
            cond_n = JSParse_GetCond(save_node)

            JSComp__Push(save_node)
            JSComp__Push(loop_start)
            JSComp__CompileExpr(cond_n)
            loop_start = JSComp__Pop()
            save_node = JSComp__Pop()

            // JMP_FALSE to end
            exit_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
            JSComp__RecordBreak(exit_jmp)

            // Compile body
            body_n = JSParse_GetBody(save_node)

            JSComp__Push(loop_start)
            JSComp__CompileNode(body_n)
            loop_start = JSComp__Pop()

            // JMP back to condition
            JSComp__EmitOp16(JSOp.JMP, loop_start)

            // Patch exit and pop loop
            JSComp__PopLoop()
            ReturnValue(0)
        }

        // --- DO_WHILE ---
        // M55: continue must target the condition, not the body (ECMA-262).
        IfCondition EqualTo(ntype, ASTType.DO_WHILE) ThenBlock: {
            body_start = JSCompState.code_pos
            // Placeholder continue target (-1); patch after body to condition
            JSComp__PushLoop(-1)

            // Compile body first
            body_n = JSParse_GetBody(save_node)

            JSComp__Push(save_node)
            JSComp__Push(body_start)
            JSComp__CompileNode(body_n)
            body_start = JSComp__Pop()
            save_node = JSComp__Pop()

            // Continue lands here (before condition)
            JSComp__PatchContinues()
            // Also fix loop frame continue_target for labeled continue (GetContinueTarget)
            IfCondition GreaterThan(JSCompState.loop_depth, 0) ThenBlock: {
                ld = Subtract(JSCompState.loop_depth, 1)
                lbase = Add(JSCompState.loop_stack, Multiply(ld, JSCompConst.LOOP_SIZE))
                StoreValue(Add(lbase, 8), JSCompState.code_pos)
            }

            // Compile condition
            cond_n = JSParse_GetCond(save_node)

            JSComp__Push(body_start)
            JSComp__CompileExpr(cond_n)
            body_start = JSComp__Pop()

            // JMP_TRUE back to body start
            JSComp__EmitOp16(JSOp.JMP_TRUE, body_start)

            JSComp__PopLoop()
            ReturnValue(0)
        }

        // --- FOR_STMT ---
        IfCondition EqualTo(ntype, ASTType.FOR_STMT) ThenBlock: {
            // Push a scope for for-loop variables
            JSComp__PushScope()

            // Compile init (N_LEFT) — M128e6k: multi-var for (let a=1, b=2; …)
            // uses CompileVarChain (VAR_DECL no longer recurses into N_NEXT).
            init_n = JSParse_GetLeft(save_node)
            IfCondition GreaterEqual(init_n, 0) ThenBlock: {
                JSComp__Push(save_node)
                IfCondition EqualTo(JSParse_GetType(init_n), ASTType.VAR_DECL) ThenBlock: {
                    JSComp__CompileVarChain(init_n)
                } ElseBlock: {
                    JSComp__CompileNode(init_n)
                }
                save_node = JSComp__Pop()
            }

            // Record loop start (at condition)
            loop_start = JSCompState.code_pos

            // For-loop continue goes to the update expr, not the condition.
            // We don't know the update address yet, so use -1 as sentinel.
            // CONTINUE_STMT will emit forward JMPs and record them.
            // After the update, we patch all continues to point there.
            JSComp__PushLoop(-1)

            // Compile condition (N_COND)
            cond_n = JSParse_GetCond(save_node)
            IfCondition GreaterEqual(cond_n, 0) ThenBlock: {
                JSComp__Push(save_node)
                JSComp__Push(loop_start)
                JSComp__CompileExpr(cond_n)
                loop_start = JSComp__Pop()
                save_node = JSComp__Pop()

                // JMP_FALSE to end
                exit_jmp = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                JSComp__RecordBreak(exit_jmp)
            }

            // Compile body (N_BODY)
            body_n = JSParse_GetBody(save_node)
            IfCondition GreaterEqual(body_n, 0) ThenBlock: {
                JSComp__Push(save_node)
                JSComp__Push(loop_start)
                JSComp__CompileNode(body_n)
                loop_start = JSComp__Pop()
                save_node = JSComp__Pop()
            }

            // Patch all forward continue JMPs to point here (before update expr)
            JSComp__PatchContinues()

            // Compile update (N_RIGHT)
            update_n = JSParse_GetRight(save_node)
            IfCondition GreaterEqual(update_n, 0) ThenBlock: {
                JSComp__Push(loop_start)
                JSComp__CompileExpr(update_n)
                JSComp__Emit1(JSOp.POP)
                loop_start = JSComp__Pop()
            }

            // JMP back to condition
            JSComp__EmitOp16(JSOp.JMP, loop_start)

            // Pop loop (patches break jumps)
            JSComp__PopLoop()
            JSComp__PopScope()
            ReturnValue(0)
        }

        // --- FOR_IN_STMT ---
        // AST layout: N_LEFT = lhs (VAR_DECL or expr), N_COND = rhs object, N_BODY = body
        // Strategy:
        //   compile(rhs) → OBJ_KEYS → store in __keys__ local
        //   __idx__ = 0
        //   loop: if __idx__ >= __keys__.length → break
        //   lhs_var = __keys__[__idx__]
        //   body
        //   __idx__++
        //   goto loop
        IfCondition EqualTo(ntype, ASTType.FOR_IN_STMT) ThenBlock: {
            JSComp__PushScope()

            // --- Compile LHS variable declaration if VAR_DECL ---
            lhs_n = JSParse_GetLeft(save_node)
            lhs_type = JSParse_GetType(lhs_n)
            IfCondition EqualTo(lhs_type, ASTType.VAR_DECL) ThenBlock: {
                // Add the declared variable as a local but don't initialize yet
                np = JSParse_GetNamePtr(lhs_n)
                nl = JSParse_GetNameLen(lhs_n)
                JSComp__Push(save_node)
                JSComp__Push(lhs_n)
                JSComp__AddLocal(np, nl)
                lhs_n = JSComp__Pop()
                save_node = JSComp__Pop()
            }

            // Allocate hidden locals __keys__ and __idx__ first
            keys_name_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
            // __keys__ = 8 bytes: 95,95,107,101,121,115,95,95
            SetByte(keys_name_ptr, 0, 95)
            SetByte(keys_name_ptr, 1, 95)
            SetByte(keys_name_ptr, 2, 107)
            SetByte(keys_name_ptr, 3, 101)
            SetByte(keys_name_ptr, 4, 121)
            SetByte(keys_name_ptr, 5, 115)
            SetByte(keys_name_ptr, 6, 95)
            SetByte(keys_name_ptr, 7, 95)
            SetByte(keys_name_ptr, 8, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 9)

            JSComp__Push(save_node)
            JSComp__Push(lhs_n)
            keys_slot = JSComp__AddLocal(keys_name_ptr, 8)
            lhs_n = JSComp__Pop()
            save_node = JSComp__Pop()

            idx_name_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
            // __idx__ = 7 bytes: 95,95,105,100,120,95,95
            SetByte(idx_name_ptr, 0, 95)
            SetByte(idx_name_ptr, 1, 95)
            SetByte(idx_name_ptr, 2, 105)
            SetByte(idx_name_ptr, 3, 100)
            SetByte(idx_name_ptr, 4, 120)
            SetByte(idx_name_ptr, 5, 95)
            SetByte(idx_name_ptr, 6, 95)
            SetByte(idx_name_ptr, 7, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 8)

            JSComp__Push(save_node)
            JSComp__Push(lhs_n)
            JSComp__Push(keys_slot)
            idx_slot = JSComp__AddLocal(idx_name_ptr, 7)
            keys_slot = JSComp__Pop()
            lhs_n = JSComp__Pop()
            save_node = JSComp__Pop()

            // Reserve stack space for hidden locals BEFORE computing RHS
            JSComp__Emit1(JSOp.PUSH_UNDEF)
            JSComp__Emit1(JSOp.PUSH_UNDEF)

            // --- Compile RHS object expression, emit OBJ_KEYS ---
            rhs_n = JSParse_GetCond(save_node)

            JSComp__Push(save_node)
            JSComp__Push(lhs_n)
            JSComp__Push(keys_slot)
            JSComp__Push(idx_slot)
            JSComp__CompileExpr(rhs_n)
            idx_slot = JSComp__Pop()
            keys_slot = JSComp__Pop()
            lhs_n = JSComp__Pop()
            save_node = JSComp__Pop()

            JSComp__Emit1(JSOp.OBJ_KEYS)

            // Store keys array into __keys__ slot
            JSComp__EmitOp16(JSOp.SET_LOCAL, keys_slot)

            // __idx__ = 0
            zero_ci = JSComp__AddNumber(0)
            JSComp__EmitOp16(JSOp.PUSH_CONST, zero_ci)
            JSComp__EmitOp16(JSOp.SET_LOCAL, idx_slot)

            // --- Loop start ---
            loop_start = JSCompState.code_pos

            // For-in continue: jump to increment (forward patch like for-loop)
            JSComp__PushLoop(-1)

            // Condition: __idx__ < __keys__.length
            JSComp__EmitOp16(JSOp.GET_LOCAL, idx_slot)

            // Get keys.length: GET_LOCAL(keys_slot) → GET_PROP("length")
            JSComp__Push(save_node)
            JSComp__Push(lhs_n)
            JSComp__Push(keys_slot)
            JSComp__Push(idx_slot)
            JSComp__Push(loop_start)
            JSComp__EmitOp16(JSOp.GET_LOCAL, keys_slot)
            // Add "length" to const pool
            len_name_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(len_name_ptr, 0, 108)
            SetByte(len_name_ptr, 1, 101)
            SetByte(len_name_ptr, 2, 110)
            SetByte(len_name_ptr, 3, 103)
            SetByte(len_name_ptr, 4, 116)
            SetByte(len_name_ptr, 5, 104)
            SetByte(len_name_ptr, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)
            len_ci = JSComp__AddString(len_name_ptr, 6)
            JSComp__EmitOp16(JSOp.GET_PROP, len_ci)
            loop_start = JSComp__Pop()
            idx_slot = JSComp__Pop()
            keys_slot = JSComp__Pop()
            lhs_n = JSComp__Pop()
            save_node = JSComp__Pop()

            // LT comparison
            JSComp__Emit1(JSOp.LT)

            // JMP_FALSE to end (break target)
            exit_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
            JSComp__RecordBreak(exit_jmp)

            // --- Assign current key to LHS variable ---
            // keys[idx]: GET_LOCAL(keys) → GET_LOCAL(idx) → GET_ELEM
            JSComp__EmitOp16(JSOp.GET_LOCAL, keys_slot)
            JSComp__EmitOp16(JSOp.GET_LOCAL, idx_slot)
            JSComp__Emit1(JSOp.GET_ELEM)

            // Set to LHS variable
            lhs_type2 = JSParse_GetType(lhs_n)
            IfCondition EqualTo(lhs_type2, ASTType.VAR_DECL) ThenBlock: {
                // VAR_DECL: find the variable slot by name
                np2 = JSParse_GetNamePtr(lhs_n)
                nl2 = JSParse_GetNameLen(lhs_n)
                forin_vkind = JSParse_GetOp(lhs_n)
                JSComp__Push(save_node)
                JSComp__Push(lhs_n)
                JSComp__Push(keys_slot)
                JSComp__Push(idx_slot)
                JSComp__Push(loop_start)
                // M59: let/const ForDeclaration → fresh binding per iteration
                IfCondition GreaterEqual(forin_vkind, 71) ThenBlock: {
                    JSComp__RegisterLetName(np2, nl2)
                    JSComp__Emit1(JSOp.DUP)
                    ci_fi = JSComp__AddString(np2, nl2)
                    JSComp__EmitOp16(JSOp.FRESH_LET_ENV, ci_fi)
                    JSComp__Emit1(JSOp.DUP)
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_fi)
                    slot_fi = JSComp__FindLocal(np2, nl2)
                    IfCondition GreaterEqual(slot_fi, 0) ThenBlock: {
                        JSComp__EmitOp16(JSOp.SET_LOCAL, slot_fi)
                        IfCondition LessThan(slot_fi, 256) ThenBlock: {
                            SetByte(JSCompState.tdz_map, slot_fi, 0)
                        }
                    } ElseBlock: {
                        JSComp__Emit1(JSOp.POP)
                    }
                } ElseBlock: {
                    JSComp__EmitVarSet(np2, nl2)
                }
                loop_start = JSComp__Pop()
                idx_slot = JSComp__Pop()
                keys_slot = JSComp__Pop()
                lhs_n = JSComp__Pop()
                save_node = JSComp__Pop()
            } ElseBlock: {
                // M26k.5: member LHS (this.#field / obj.prop) → SET_PROP
                IfCondition EqualTo(lhs_type2, ASTType.MEMBER_DOT) ThenBlock: {
                    np2 = JSParse_GetNamePtr(lhs_n)
                    nl2 = JSParse_GetNameLen(lhs_n)
                    JSComp__Push(save_node)
                    JSComp__Push(lhs_n)
                    JSComp__Push(keys_slot)
                    JSComp__Push(idx_slot)
                    JSComp__Push(loop_start)
                    JSComp__Push(np2)
                    JSComp__Push(nl2)
                    JSComp__CompileExpr(JSParse_GetLeft(lhs_n))
                    nl2 = JSComp__Pop()
                    np2 = JSComp__Pop()
                    loop_start = JSComp__Pop()
                    idx_slot = JSComp__Pop()
                    keys_slot = JSComp__Pop()
                    lhs_n = JSComp__Pop()
                    save_node = JSComp__Pop()
                    // stack [value, obj] → [obj, value]
                    JSComp__Emit1(JSOp.SWAP)
                    mci = JSComp__AddString(np2, nl2)
                    JSComp__EmitOp16(JSOp.SET_PROP, mci)
                } ElseBlock: {
                    // Expression LHS (e.g. bare identifier): resolve and set
                    np2 = JSParse_GetNamePtr(lhs_n)
                    nl2 = JSParse_GetNameLen(lhs_n)
                    JSComp__Push(save_node)
                    JSComp__Push(lhs_n)
                    JSComp__Push(keys_slot)
                    JSComp__Push(idx_slot)
                    JSComp__Push(loop_start)
                    JSComp__EmitVarSet(np2, nl2)
                    loop_start = JSComp__Pop()
                    idx_slot = JSComp__Pop()
                    keys_slot = JSComp__Pop()
                    lhs_n = JSComp__Pop()
                    save_node = JSComp__Pop()
                }
            }

            // --- Compile body ---
            body_n = JSParse_GetBody(save_node)
            IfCondition GreaterEqual(body_n, 0) ThenBlock: {
                JSComp__Push(save_node)
                JSComp__Push(keys_slot)
                JSComp__Push(idx_slot)
                JSComp__Push(loop_start)
                JSComp__CompileNode(body_n)
                loop_start = JSComp__Pop()
                idx_slot = JSComp__Pop()
                keys_slot = JSComp__Pop()
                save_node = JSComp__Pop()
            }

            // Patch continues to point here (before increment)
            JSComp__PatchContinues()

            // --- Increment __idx__ ---
            JSComp__EmitOp16(JSOp.GET_LOCAL, idx_slot)
            one_ci = JSComp__AddNumber(1)
            JSComp__EmitOp16(JSOp.PUSH_CONST, one_ci)
            JSComp__Emit1(JSOp.ADD)
            JSComp__EmitOp16(JSOp.SET_LOCAL, idx_slot)

            // JMP back to loop start
            JSComp__EmitOp16(JSOp.JMP, loop_start)

            // Pop loop (patches break jumps to here)
            JSComp__PopLoop()
            JSComp__PopScope()
            ReturnValue(0)
        }

        // --- FOR_OF_STMT ---
        // AST layout: N_LEFT = lhs (VAR_DECL or expr), N_COND = rhs iterable, N_BODY = body
        // M54: iterator protocol (GET_ITER / ITER_NEXT / ITER_CLOSE) — not eager TO_ARRAY.
        //   compile(rhs) → GET_ITER → __irec__
        //   loop: ITER_NEXT → [value, done]; if done → exit (no close)
        //   assign value; body; goto loop
        //   break → ITER_CLOSE then exit
        IfCondition EqualTo(ntype, ASTType.FOR_OF_STMT) ThenBlock: {
            JSComp__PushScope()

            // --- Compile LHS variable declaration if VAR_DECL ---
            lhs_n = JSParse_GetLeft(save_node)
            lhs_type = JSParse_GetType(lhs_n)
            forof_dstr_pat = -1
            // M62/M64: for-of let/const — head TDZ env nest count for RHS
            forof_vkind_h = 0
            forof_head_nenv = 0
            // Per-iteration FRESH_LET_ENV nest count (RESTORE after body)
            forof_iter_nenv = 0
            // M65: eval completion value V for for-of as last statement
            forof_cpt_slot = -1
            forof_cpt_on = 0
            forof_leave_cpt = 0
            // Track V in any eval (nested for-of under last do/while)
            IfCondition EqualTo(JSCompState.eval_mode, 1) ThenBlock: {
                forof_cpt_on = 1
                IfCondition EqualTo(JSCompState.is_last_stmt, 1) ThenBlock: {
                    forof_leave_cpt = 1
                }
            }
            IfCondition EqualTo(lhs_type, ASTType.VAR_DECL) ThenBlock: {
                forof_vkind_h = JSParse_GetOp(lhs_n)
                forof_dstr_pat = JSParse_GetRight(lhs_n)
                IfCondition LessThan(forof_dstr_pat, 0) ThenBlock: {
                    np = JSParse_GetNamePtr(lhs_n)
                    nl = JSParse_GetNameLen(lhs_n)
                    JSComp__Push(save_node)
                    JSComp__Push(lhs_n)
                    tdz_slot_h = JSComp__AddLocal(np, nl)
                    lhs_n = JSComp__Pop()
                    save_node = JSComp__Pop()
                    IfCondition GreaterEqual(forof_vkind_h, 71) ThenBlock: {
                        IfCondition And(GreaterEqual(tdz_slot_h, 0), LessThan(tdz_slot_h, 256)) ThenBlock: {
                            SetByte(JSCompState.tdz_map, tdz_slot_h, 1)
                        }
                        // Fresh env with TDZ binding — do not clobber outer let
                        IfCondition GreaterThan(nl, 0) ThenBlock: {
                            JSComp__RegisterLetName(np, nl)
                            JSComp__Emit1(JSOp.PUSH_TDZ_UNINIT)
                            ci_h = JSComp__AddString(np, nl)
                            JSComp__EmitOp16(JSOp.FRESH_LET_ENV, ci_h)
                            forof_head_nenv = 1
                        }
                    }
                } ElseBlock: {
                    // M64: let/const destructuring — head TDZ for all pattern names
                    IfCondition GreaterEqual(forof_vkind_h, 71) ThenBlock: {
                        JSComp__Push(save_node)
                        JSComp__Push(lhs_n)
                        JSComp__Push(forof_dstr_pat)
                        forof_head_nenv = JSComp__LexPatternFreshEnv(forof_dstr_pat)
                        forof_dstr_pat = JSComp__Pop()
                        lhs_n = JSComp__Pop()
                        save_node = JSComp__Pop()
                    }
                }
            }
            IfCondition Or(EqualTo(lhs_type, ASTType.ARRAY_PATTERN),
                          EqualTo(lhs_type, ASTType.OBJECT_PATTERN)) ThenBlock: {
                forof_dstr_pat = lhs_n
            }

            // Hidden local __irec__ (iterator record)
            irec_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(irec_nm, 0, 95)
            SetByte(irec_nm, 1, 95)
            SetByte(irec_nm, 2, 105)
            SetByte(irec_nm, 3, 114)
            SetByte(irec_nm, 4, 95)
            SetByte(irec_nm, 5, 95)
            SetByte(irec_nm, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)

            JSComp__Push(save_node)
            JSComp__Push(lhs_n)
            JSComp__Push(forof_head_nenv)
            irec_slot = JSComp__AddLocal(irec_nm, 6)
            forof_head_nenv = JSComp__Pop()
            lhs_n = JSComp__Pop()
            save_node = JSComp__Pop()

            // --- RHS → GET_ITER → store ---
            rhs_n = JSParse_GetCond(save_node)
            JSComp__Push(save_node)
            JSComp__Push(lhs_n)
            JSComp__Push(irec_slot)
            JSComp__Push(forof_head_nenv)
            JSComp__CompileExpr(rhs_n)
            forof_head_nenv = JSComp__Pop()
            irec_slot = JSComp__Pop()
            lhs_n = JSComp__Pop()
            save_node = JSComp__Pop()

            // M128e6h: for-await-of (N_OP=1) → async GetIterator
            forof_async = JSParse_GetOp(save_node)
            IfCondition EqualTo(forof_async, 1) ThenBlock: {
                JSComp__Emit1(JSOp.GET_ASYNC_ITER)
            } ElseBlock: {
                JSComp__Emit1(JSOp.GET_ITER)
            }
            JSComp__EmitOp16(JSOp.SET_LOCAL, irec_slot)
            // Restore parent env after head TDZ (closures keep TDZ env via __cenv)
            IfCondition GreaterThan(forof_head_nenv, 0) ThenBlock: {
                JSComp__EmitRestoreEnvN(forof_head_nenv)
            }

            // M65: V = undefined once before loop (must not re-init each iter)
            IfCondition EqualTo(forof_cpt_on, 1) ThenBlock: {
                cpt_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(cpt_nm, 0, 95)
                SetByte(cpt_nm, 1, 95)
                SetByte(cpt_nm, 2, 118)
                SetByte(cpt_nm, 3, 95)
                SetByte(cpt_nm, 4, 95)
                SetByte(cpt_nm, 5, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 6)
                JSComp__Push(save_node)
                JSComp__Push(lhs_n)
                JSComp__Push(irec_slot)
                JSComp__Push(forof_iter_nenv)
                forof_cpt_slot = JSComp__AddLocal(cpt_nm, 5)
                forof_iter_nenv = JSComp__Pop()
                irec_slot = JSComp__Pop()
                lhs_n = JSComp__Pop()
                save_node = JSComp__Pop()
                JSComp__Emit1(JSOp.PUSH_UNDEF)
                JSComp__EmitOp16(JSOp.SET_LOCAL, forof_cpt_slot)
                JSCompState.loop_cptn_slot = forof_cpt_slot
            }

            // --- Loop start: continue lands here ---
            loop_start = JSCompState.code_pos
            JSComp__PushLoop(loop_start)
            // M55: track open iterator for return/throw/outer continue-break
            forof_loop_d = Subtract(JSCompState.loop_depth, 1)
            JSComp__PushIterClose(irec_slot, forof_loop_d)

            // ITER_NEXT → [value, done]
            JSComp__EmitOp16(JSOp.GET_LOCAL, irec_slot)
            JSComp__Emit1(JSOp.ITER_NEXT)

            // JMP_TRUE pops done: if done → done_path (value still on stack)
            done_path_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP_TRUE, 0)

            // not-done: value on stack → assign to LHS
            // M61: MEMBER_DOT put errors need IteratorClose
            // M64: dstr assign errors also need IteratorClose (body-dstr-assign-error)
            IfCondition GreaterEqual(forof_dstr_pat, 0) ThenBlock: {
                dt_nm2 = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(dt_nm2, 0, 95)
                SetByte(dt_nm2, 1, 95)
                SetByte(dt_nm2, 2, 100)
                SetByte(dt_nm2, 3, 116)
                SetByte(dt_nm2, 4, 95)
                SetByte(dt_nm2, 5, 95)
                SetByte(dt_nm2, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)

                JSComp__Push(save_node)
                JSComp__Push(lhs_n)
                JSComp__Push(irec_slot)
                JSComp__Push(loop_start)
                JSComp__Push(forof_dstr_pat)
                JSComp__Push(done_path_jmp)
                JSComp__Push(forof_vkind_h)
                JSComp__Push(forof_iter_nenv)
                dt_slot2 = JSComp__AddLocal(dt_nm2, 6)
                forof_iter_nenv = JSComp__Pop()
                forof_vkind_h = JSComp__Pop()
                done_path_jmp = JSComp__Pop()
                forof_dstr_pat = JSComp__Pop()
                loop_start = JSComp__Pop()
                irec_slot = JSComp__Pop()
                lhs_n = JSComp__Pop()
                save_node = JSComp__Pop()

                JSComp__EmitOp16(JSOp.SET_LOCAL, dt_slot2)

                // M64: per-iter let env for pattern bindings (block scope + shadow)
                IfCondition GreaterEqual(forof_vkind_h, 71) ThenBlock: {
                    JSComp__Push(save_node)
                    JSComp__Push(lhs_n)
                    JSComp__Push(irec_slot)
                    JSComp__Push(loop_start)
                    JSComp__Push(done_path_jmp)
                    JSComp__Push(forof_dstr_pat)
                    JSComp__Push(dt_slot2)
                    forof_iter_nenv = JSComp__LexPatternFreshEnv(forof_dstr_pat)
                    dt_slot2 = JSComp__Pop()
                    forof_dstr_pat = JSComp__Pop()
                    done_path_jmp = JSComp__Pop()
                    loop_start = JSComp__Pop()
                    irec_slot = JSComp__Pop()
                    lhs_n = JSComp__Pop()
                    save_node = JSComp__Pop()
                    JSCompState.skip_let_global = 1
                }

                // M64: wrap dstr assign for IteratorClose on PutValue errors.
                // Skip in generators (yield/return dstr) — try broke rtrn-close.
                // Only assignment patterns (vkind 0); decl bindings use pattern's own try.
                forof_dstr_try = 0
                IfCondition And(EqualTo(forof_vkind_h, 0), EqualTo(JSCompState.in_sync_gen, 0)) ThenBlock: {
                    forof_dstr_try = 1
                }
                try_dstr_addr = 0
                IfCondition EqualTo(forof_dstr_try, 1) ThenBlock: {
                    JSComp__PushFinally(-1)
                    try_dstr_addr = JSCompState.code_pos
                    JSComp__EmitOp16(JSOp.TRY_PUSH, 0)
                }

                dstr_pt = JSParse_GetType(forof_dstr_pat)
                IfCondition EqualTo(dstr_pt, ASTType.ARRAY_PATTERN) ThenBlock: {
                    JSComp__Push(save_node)
                    JSComp__Push(lhs_n)
                    JSComp__Push(irec_slot)
                    JSComp__Push(loop_start)
                    JSComp__Push(done_path_jmp)
                    JSComp__Push(try_dstr_addr)
                    JSComp__Push(forof_iter_nenv)
                    JSComp__CompileArrayPattern(forof_dstr_pat, dt_slot2)
                    forof_iter_nenv = JSComp__Pop()
                    try_dstr_addr = JSComp__Pop()
                    done_path_jmp = JSComp__Pop()
                    loop_start = JSComp__Pop()
                    irec_slot = JSComp__Pop()
                    lhs_n = JSComp__Pop()
                    save_node = JSComp__Pop()
                } ElseBlock: {
                    IfCondition EqualTo(dstr_pt, ASTType.OBJECT_PATTERN) ThenBlock: {
                        JSComp__Push(save_node)
                        JSComp__Push(lhs_n)
                        JSComp__Push(irec_slot)
                        JSComp__Push(loop_start)
                        JSComp__Push(done_path_jmp)
                        JSComp__Push(try_dstr_addr)
                        JSComp__Push(forof_iter_nenv)
                        JSComp__CompileObjPattern(forof_dstr_pat, dt_slot2)
                        forof_iter_nenv = JSComp__Pop()
                        try_dstr_addr = JSComp__Pop()
                        done_path_jmp = JSComp__Pop()
                        loop_start = JSComp__Pop()
                        irec_slot = JSComp__Pop()
                        lhs_n = JSComp__Pop()
                        save_node = JSComp__Pop()
                    }
                }
                JSCompState.skip_let_global = 0
                IfCondition GreaterThan(forof_iter_nenv, 0) ThenBlock: {
                    JSComp__ClearPatternTdz(forof_dstr_pat)
                }
                IfCondition EqualTo(forof_dstr_try, 1) ThenBlock: {
                    JSComp__SetFinallyInTry(0)
                    JSComp__Emit1(JSOp.TRY_POP)
                    JSComp__PopFinally()
                    skip_dstr_jmp = JSCompState.code_pos
                    JSComp__EmitOp16(JSOp.JMP, 0)
                    JSComp__PatchJump(try_dstr_addr, JSCompState.code_pos)
                    // On dstr error: restore iter envs then close for-of iterator
                    IfCondition GreaterThan(forof_iter_nenv, 0) ThenBlock: {
                        JSComp__EmitRestoreEnvN(forof_iter_nenv)
                    }
                    JSComp__EmitOp16(JSOp.GET_LOCAL, irec_slot)
                    JSComp__EmitOp16(JSOp.ITER_CLOSE, 1)
                    JSComp__Emit1(JSOp.THROW)
                    JSComp__PatchJump(skip_dstr_jmp, JSCompState.code_pos)
                }
            } ElseBlock: {
                lhs_type2 = JSParse_GetType(lhs_n)
                IfCondition EqualTo(lhs_type2, ASTType.VAR_DECL) ThenBlock: {
                    np2 = JSParse_GetNamePtr(lhs_n)
                    nl2 = JSParse_GetNameLen(lhs_n)
                    // M59/M64: let/const ForDeclaration → fresh binding per iteration
                    // No SET_GLOBAL — block-scoped (typeof outside stays undefined)
                    forof_vkind = JSParse_GetOp(lhs_n)
                    JSComp__Push(save_node)
                    JSComp__Push(lhs_n)
                    JSComp__Push(irec_slot)
                    JSComp__Push(loop_start)
                    JSComp__Push(done_path_jmp)
                    IfCondition GreaterEqual(forof_vkind, 71) ThenBlock: {
                        // stack [value]:
                        //   DUP; FRESH_LET_ENV — per-iter env for closure GET_FREE
                        //   SET_LOCAL — body GET_LOCAL (top-level let path)
                        JSComp__RegisterLetName(np2, nl2)
                        JSComp__Emit1(JSOp.DUP)
                        ci_fo = JSComp__AddString(np2, nl2)
                        JSComp__EmitOp16(JSOp.FRESH_LET_ENV, ci_fo)
                        forof_iter_nenv = 1
                        slot_fo = JSComp__FindLocal(np2, nl2)
                        IfCondition GreaterEqual(slot_fo, 0) ThenBlock: {
                            JSComp__EmitOp16(JSOp.SET_LOCAL, slot_fo)
                            IfCondition LessThan(slot_fo, 256) ThenBlock: {
                                SetByte(JSCompState.tdz_map, slot_fo, 0)
                            }
                        } ElseBlock: {
                            JSComp__Emit1(JSOp.POP)
                        }
                    } ElseBlock: {
                        // M128e6j: SET_LOCAL only (not EmitVarSet). Dual-write left
                        // stack residue so body-try rethrow surfaced the iteration
                        // value to outer catch (throw 42 became catch 99).
                        slot_fv = JSComp__FindLocal(np2, nl2)
                        IfCondition GreaterEqual(slot_fv, 0) ThenBlock: {
                            JSComp__EmitOp16(JSOp.SET_LOCAL, slot_fv)
                        } ElseBlock: {
                            JSComp__EmitVarSet(np2, nl2)
                        }
                    }
                    done_path_jmp = JSComp__Pop()
                    loop_start = JSComp__Pop()
                    irec_slot = JSComp__Pop()
                    lhs_n = JSComp__Pop()
                    save_node = JSComp__Pop()
                } ElseBlock: {
                    IfCondition EqualTo(lhs_type2, ASTType.MEMBER_DOT) ThenBlock: {
                        np2 = JSParse_GetNamePtr(lhs_n)
                        nl2 = JSParse_GetNameLen(lhs_n)
                        // M61: put-error on member → IteratorClose
                        JSComp__PushFinally(-1)
                        try_put_addr = JSCompState.code_pos
                        JSComp__EmitOp16(JSOp.TRY_PUSH, 0)
                        JSComp__Push(try_put_addr)
                        JSComp__Push(save_node)
                        JSComp__Push(lhs_n)
                        JSComp__Push(irec_slot)
                        JSComp__Push(loop_start)
                        JSComp__Push(done_path_jmp)
                        JSComp__Push(np2)
                        JSComp__Push(nl2)
                        JSComp__CompileExpr(JSParse_GetLeft(lhs_n))
                        nl2 = JSComp__Pop()
                        np2 = JSComp__Pop()
                        done_path_jmp = JSComp__Pop()
                        loop_start = JSComp__Pop()
                        irec_slot = JSComp__Pop()
                        lhs_n = JSComp__Pop()
                        save_node = JSComp__Pop()
                        try_put_addr = JSComp__Pop()
                        JSComp__Emit1(JSOp.SWAP)
                        mci = JSComp__AddString(np2, nl2)
                        JSComp__EmitOp16(JSOp.SET_PROP, mci)
                        JSComp__SetFinallyInTry(0)
                        JSComp__Emit1(JSOp.TRY_POP)
                        JSComp__PopFinally()
                        skip_put_jmp = JSCompState.code_pos
                        JSComp__EmitOp16(JSOp.JMP, 0)
                        JSComp__PatchJump(try_put_addr, JSCompState.code_pos)
                        JSComp__EmitOp16(JSOp.GET_LOCAL, irec_slot)
                        JSComp__EmitOp16(JSOp.ITER_CLOSE, 1)
                        JSComp__Emit1(JSOp.THROW)
                        JSComp__PatchJump(skip_put_jmp, JSCompState.code_pos)
                    } ElseBlock: {
                        np2 = JSParse_GetNamePtr(lhs_n)
                        nl2 = JSParse_GetNameLen(lhs_n)
                        JSComp__Push(save_node)
                        JSComp__Push(lhs_n)
                        JSComp__Push(irec_slot)
                        JSComp__Push(loop_start)
                        JSComp__Push(done_path_jmp)
                        JSComp__EmitVarSet(np2, nl2)
                        done_path_jmp = JSComp__Pop()
                        loop_start = JSComp__Pop()
                        irec_slot = JSComp__Pop()
                        lhs_n = JSComp__Pop()
                        save_node = JSComp__Pop()
                    }
                }
            }

            // --- Body with try: uncaught throw → IteratorClose ---
            body_n = JSParse_GetBody(save_node)
            JSComp__PushFinally(-1)
            try_body_addr = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.TRY_PUSH, 0)
            IfCondition GreaterEqual(body_n, 0) ThenBlock: {
                // M65: walk N_NEXT — multi-var `var a=1, b=2` as body is a chain
                // M128e6k: VAR_DECL no longer recurses; walker visits each once.
                body_walk = body_n
                WhileLoop GreaterEqual(body_walk, 0) {
                    JSComp__Push(save_node)
                    JSComp__Push(irec_slot)
                    JSComp__Push(loop_start)
                    JSComp__Push(done_path_jmp)
                    JSComp__Push(try_body_addr)
                    JSComp__Push(forof_iter_nenv)
                    JSComp__Push(body_walk)
                    JSComp__CompileNode(body_walk)
                    body_walk = JSComp__Pop()
                    forof_iter_nenv = JSComp__Pop()
                    try_body_addr = JSComp__Pop()
                    done_path_jmp = JSComp__Pop()
                    loop_start = JSComp__Pop()
                    irec_slot = JSComp__Pop()
                    save_node = JSComp__Pop()
                    body_walk = JSParse_GetNext(body_walk)
                }
            }
            JSComp__SetFinallyInTry(0)
            JSComp__Emit1(JSOp.TRY_POP)
            JSComp__PopFinally()

            // M64: pop per-iteration let env before next iter / exit
            IfCondition GreaterThan(forof_iter_nenv, 0) ThenBlock: {
                JSComp__EmitRestoreEnvN(forof_iter_nenv)
            }

            // Next iteration
            JSComp__EmitOp16(JSOp.JMP, loop_start)

            // --- uncaught throw from body: close (kind=1) and rethrow ---
            JSComp__PatchJump(try_body_addr, JSCompState.code_pos)
            // stack: [thrown]
            IfCondition GreaterThan(forof_iter_nenv, 0) ThenBlock: {
                JSComp__EmitRestoreEnvN(forof_iter_nenv)
            }
            JSComp__EmitOp16(JSOp.GET_LOCAL, irec_slot)
            // stack: [thrown, irec]
            JSComp__EmitOp16(JSOp.ITER_CLOSE, 1)
            // stack: [thrown]
            JSComp__Emit1(JSOp.THROW)

            // --- done path: pop unused value; no runtime close (iterator exhausted) ---
            JSComp__PatchJump(done_path_jmp, JSCompState.code_pos)
            JSComp__Emit1(JSOp.POP)
            skip_close_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP, 0)

            // --- break path: IteratorClose then join end ---
            JSComp__PopLoop()
            // break may leave iter env nested — restore before close
            IfCondition GreaterThan(forof_iter_nenv, 0) ThenBlock: {
                JSComp__EmitRestoreEnvN(forof_iter_nenv)
            }
            JSComp__EmitOp16(JSOp.GET_LOCAL, irec_slot)
            JSComp__EmitOp16(JSOp.ITER_CLOSE, 0)

            JSComp__PatchJump(skip_close_jmp, JSCompState.code_pos)
            JSComp__PopIterClose()
            // M65: leave completion V on stack when for-of is eval last stmt
            JSCompState.loop_cptn_slot = -1
            IfCondition And(EqualTo(forof_leave_cpt, 1), GreaterEqual(forof_cpt_slot, 0)) ThenBlock: {
                JSComp__EmitOp16(JSOp.GET_LOCAL, forof_cpt_slot)
            }
JSComp__PopScope()
            ReturnValue(0)
        }

        // --- BREAK_STMT --- (M53: optional label → label break chain)
        IfCondition EqualTo(ntype, ASTType.BREAK_STMT) ThenBlock: {
            // M128h: unlabeled break outside loop/switch → SyntaxError
            // (labeled break handled below; RecordBreak also errors if no target)
            IfCondition LessThan(JSCompState.loop_depth, 1) ThenBlock: {
                bl_np0 = JSParse_GetNamePtr(save_node)
                bl_nl0 = JSParse_GetNameLen(save_node)
                IfCondition Or(EqualTo(bl_np0, 0), LessEqual(bl_nl0, 0)) ThenBlock: {
                    JSCompState.error = 1
                    ReturnValue(-1)
                }
            }
            JSComp__EmitPendingFinally()
            bl_np = JSParse_GetNamePtr(save_node)
            bl_nl = JSParse_GetNameLen(save_node)
            // M55: IteratorClose for-of being exited
            // unlabeled: close current loop depth (inclusive) — for-of break path also closes (safe via __c__)
            // labeled with loop: close for-of at/above that loop depth
            brk_loop_d = Subtract(JSCompState.loop_depth, 1)
            IfCondition And(NotEqual(bl_np, 0), GreaterThan(bl_nl, 0)) ThenBlock: {
                bl_idx = JSComp__FindLabel(bl_np, bl_nl)
                IfCondition GreaterEqual(bl_idx, 0) ThenBlock: {
                    bl_base = Add(JSCompState.label_stack, Multiply(bl_idx, JSCompConst.LABEL_SIZE))
                    bl_ld = Dereference(Add(bl_base, 24))
                    IfCondition GreaterEqual(bl_ld, 0) ThenBlock: {
                        brk_loop_d = bl_ld
                    }
                }
            }
            IfCondition GreaterEqual(brk_loop_d, 0) ThenBlock: {
                JSComp__EmitPendingIterClose(brk_loop_d, 1, 0)
            }
            brk_addr = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP, 0)
            IfCondition And(NotEqual(bl_np, 0), GreaterThan(bl_nl, 0)) ThenBlock: {
                bl_idx = JSComp__FindLabel(bl_np, bl_nl)
                IfCondition GreaterEqual(bl_idx, 0) ThenBlock: {
                    JSComp__RecordLabelBreak(bl_idx, brk_addr)
                } ElseBlock: {
                    JSComp__RecordBreak(brk_addr)
                }
            } ElseBlock: {
                JSComp__RecordBreak(brk_addr)
            }
            ReturnValue(0)
        }

        // --- CONTINUE_STMT --- (M53: optional label → that loop's continue)
        IfCondition EqualTo(ntype, ASTType.CONTINUE_STMT) ThenBlock: {
            // M128h: continue outside iteration → SyntaxError (eval body loop_depth=0)
            IfCondition LessThan(JSCompState.loop_depth, 1) ThenBlock: {
                JSCompState.error = 1
                ReturnValue(-1)
            }
            JSComp__EmitPendingFinally()
            cl_np = JSParse_GetNamePtr(save_node)
            cl_nl = JSParse_GetNameLen(save_node)
            cont_loop_idx = -1
            IfCondition And(NotEqual(cl_np, 0), GreaterThan(cl_nl, 0)) ThenBlock: {
                cl_idx = JSComp__FindLabel(cl_np, cl_nl)
                IfCondition GreaterEqual(cl_idx, 0) ThenBlock: {
                    cl_base = Add(JSCompState.label_stack, Multiply(cl_idx, JSCompConst.LABEL_SIZE))
                    cont_loop_idx = Dereference(Add(cl_base, 24))
                }
            }
            // M55: close for-of nested inside the continue target (not the target itself)
            cont_tgt_d = Subtract(JSCompState.loop_depth, 1)
            IfCondition GreaterEqual(cont_loop_idx, 0) ThenBlock: {
                cont_tgt_d = cont_loop_idx
            }
            IfCondition GreaterEqual(cont_tgt_d, 0) ThenBlock: {
                JSComp__EmitPendingIterClose(cont_tgt_d, 0, 0)
            }
            // M65: leave for-of completion V when continue exits for-of (eval)
            IfCondition GreaterEqual(JSCompState.loop_cptn_slot, 0) ThenBlock: {
                JSComp__EmitOp16(JSOp.GET_LOCAL, JSCompState.loop_cptn_slot)
            }
            IfCondition GreaterEqual(cont_loop_idx, 0) ThenBlock: {
                // Labeled continue: use bound loop frame
                lbase = Add(JSCompState.loop_stack, Multiply(cont_loop_idx, JSCompConst.LOOP_SIZE))
                ct = Dereference(Add(lbase, 8))
                IfCondition LessThan(ct, 0) ThenBlock: {
                    cont_jmp = JSCompState.code_pos
                    JSComp__EmitOp16(JSOp.JMP, 0)
                    old_head = Dereference(Add(lbase, 24))
                    IfCondition LessThan(old_head, 0) ThenBlock: {
                        SetByte(JSCompState.code, Add(cont_jmp, 1), 255)
                        SetByte(JSCompState.code, Add(cont_jmp, 2), 255)
                        SetByte(JSCompState.code, Add(cont_jmp, 3), 255)
                    } ElseBlock: {
                        b2 = BitwiseAnd(ShiftRight(old_head, 16), 255)
                        b1 = BitwiseAnd(ShiftRight(old_head, 8), 255)
                        b0 = BitwiseAnd(old_head, 255)
                        SetByte(JSCompState.code, Add(cont_jmp, 1), b2)
                        SetByte(JSCompState.code, Add(cont_jmp, 2), b1)
                        SetByte(JSCompState.code, Add(cont_jmp, 3), b0)
                    }
                    StoreValue(Add(lbase, 24), cont_jmp)
                } ElseBlock: {
                    JSComp__EmitOp16(JSOp.JMP, ct)
                }
            } ElseBlock: {
                ct = JSComp__GetContinueTarget()
                IfCondition LessThan(ct, 0) ThenBlock: {
                    cont_jmp = JSCompState.code_pos
                    JSComp__EmitOp16(JSOp.JMP, 0)
                    JSComp__RecordContinue(cont_jmp)
                } ElseBlock: {
                    JSComp__EmitOp16(JSOp.JMP, ct)
                }
            }
            ReturnValue(0)
        }

        // --- LABELED_STMT --- (M53)
        IfCondition EqualTo(ntype, ASTType.LABELED_STMT) ThenBlock: {
            lab_np = JSParse_GetNamePtr(save_node)
            lab_nl = JSParse_GetNameLen(save_node)
            body_n = JSParse_GetBody(save_node)
            // can_bind if body is a loop or another labeled stmt (multi-label)
            can_bind = 0
            IfCondition GreaterEqual(body_n, 0) ThenBlock: {
                bt = JSParse_GetType(body_n)
                IfCondition Or(EqualTo(bt, ASTType.WHILE_STMT),
                    Or(EqualTo(bt, ASTType.DO_WHILE),
                    Or(EqualTo(bt, ASTType.FOR_STMT),
                    Or(EqualTo(bt, ASTType.FOR_IN_STMT),
                    Or(EqualTo(bt, ASTType.FOR_OF_STMT),
                        EqualTo(bt, ASTType.LABELED_STMT)))))) ThenBlock: {
                    can_bind = 1
                }
                // switch is a break target but not continue — bind loop_depth unused
            }
            JSComp__PushLabel(lab_np, lab_nl, can_bind)
            IfCondition GreaterEqual(body_n, 0) ThenBlock: {
                JSComp__CompileNode(body_n)
            }
            JSComp__PopLabel()
            ReturnValue(0)
        }

        // --- SWITCH_STMT ---
        IfCondition EqualTo(ntype, ASTType.SWITCH_STMT) ThenBlock: {
            // Compile discriminant (N_LEFT)
            disc = JSParse_GetLeft(save_node)

            JSComp__Push(save_node)
            JSComp__CompileExpr(disc)
            save_node = JSComp__Pop()

            // Push a lexical scope for the switch body (ES2015 13.12.11)
            JSComp__PushScope()

            // Store discriminant in hidden global __sw__ to avoid top-level
            // stack/local collision. Bytes: 95,95,115,119,95,95 = "__sw__"
            sw_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(sw_nm, 0, 95)
            SetByte(sw_nm, 1, 95)
            SetByte(sw_nm, 2, 115)
            SetByte(sw_nm, 3, 119)
            SetByte(sw_nm, 4, 95)
            SetByte(sw_nm, 5, 95)
            SetByte(sw_nm, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)

            JSComp__Push(save_node)
            sw_ci = JSComp__AddString(sw_nm, 6)
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.SET_GLOBAL, sw_ci)

            // Push a "loop" for break support (no continue target)
            JSComp__PushLoop(-1)

            // Cases are linked via N_BODY -> N_NEXT (parser stores case list in N_BODY)
            // Two-pass compilation for correct fallthrough semantics:
            //   Pass 1: emit case test chain (GET_GLOBAL + test + STRICT_EQ + JMP_TRUE body_N)
            //   Pass 2: emit case bodies sequentially (natural fallthrough)

            // ---- Pass 1: Case test chain ----
            case_n = JSParse_GetBody(save_node)
            case_idx = 0
            default_idx = -1

            WhileLoop GreaterEqual(case_n, 0) {
                case_type = JSParse_GetType(case_n)
                IfCondition EqualTo(case_type, ASTType.CASE_CLAUSE) ThenBlock: {
                    test_n = JSParse_GetLeft(case_n)
                    IfCondition GreaterEqual(test_n, 0) ThenBlock: {
                        // Non-default case: load disc from global, compile test, STRICT_EQ, JMP_TRUE
                        JSComp__EmitOp16(JSOp.GET_GLOBAL, sw_ci)

                        JSComp__Push(save_node)
                        JSComp__Push(case_n)
                        JSComp__Push(case_idx)
                        JSComp__Push(default_idx)
                        JSComp__Push(sw_ci)
                        JSComp__CompileExpr(test_n)
                        sw_ci = JSComp__Pop()
                        default_idx = JSComp__Pop()
                        case_idx = JSComp__Pop()
                        case_n = JSComp__Pop()
                        save_node = JSComp__Pop()

                        JSComp__Emit1(JSOp.STRICT_EQ)
                        // Store JMP_TRUE address in switch_jmps[case_idx]
                        StoreValue(Add(JSCompState.switch_jmps, Multiply(case_idx, 8)), JSCompState.code_pos)
                        JSComp__EmitOp16(JSOp.JMP_TRUE, 0)
                    } ElseBlock: {
                        // Default case: record index, no test emitted
                        default_idx = case_idx
                        // Store -1 as marker (no JMP_TRUE to patch)
                        StoreValue(Add(JSCompState.switch_jmps, Multiply(case_idx, 8)), -1)
                    }
                    case_idx = Add(case_idx, 1)
                }
                case_n = JSParse_GetNext(case_n)
            }

            // After all tests: JMP to default body or end
            default_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP, 0)

            // ---- Pass 2: Case bodies (sequential, fallthrough) ----
            case_n = JSParse_GetBody(save_node)
            case_idx = 0

            WhileLoop GreaterEqual(case_n, 0) {
                case_type = JSParse_GetType(case_n)
                IfCondition EqualTo(case_type, ASTType.CASE_CLAUSE) ThenBlock: {
                    // Patch the JMP_TRUE from pass 1 to point here
                    jmp_addr = Dereference(Add(JSCompState.switch_jmps, Multiply(case_idx, 8)))
                    IfCondition GreaterEqual(jmp_addr, 0) ThenBlock: {
                        // Patch JMP_TRUE operand
                        JSComp__PatchJump(jmp_addr)
                    } ElseBlock: {
                        // Default case: patch the default JMP to point here
                        JSComp__PatchJump(default_jmp)
                    }

                    // Compile case body statements (N_BODY -> N_NEXT chain)
                    cbody = JSParse_GetBody(case_n)
                    WhileLoop GreaterEqual(cbody, 0) {
                        JSComp__Push(save_node)
                        JSComp__Push(case_n)
                        JSComp__Push(case_idx)
                        JSComp__Push(default_jmp)
                        JSComp__Push(sw_ci)
                        JSComp__Push(cbody)
                        JSComp__CompileNode(cbody)
                        cbody = JSComp__Pop()
                        sw_ci = JSComp__Pop()
                        default_jmp = JSComp__Pop()
                        case_idx = JSComp__Pop()
                        case_n = JSComp__Pop()
                        save_node = JSComp__Pop()
                        cbody = JSParse_GetNext(cbody)
                    }

                    case_idx = Add(case_idx, 1)
                }
                case_n = JSParse_GetNext(case_n)
            }

            // If no default was found, patch default_jmp to here (skip all bodies)
            IfCondition EqualTo(default_idx, -1) ThenBlock: {
                JSComp__PatchJump(default_jmp)
            }

            // Pop loop frame (patches break jumps)
            JSComp__PopLoop()

            // Pop the lexical scope for the switch body
            JSComp__PopScope()
            ReturnValue(0)
        }

        // --- TRY_STMT ---
        IfCondition EqualTo(ntype, ASTType.TRY_STMT) ThenBlock: {
            // Layout:
            //   TRY_PUSH catch_or_rethrow
            //   try body
            //   TRY_POP
            //   JMP after_catch
            //   catch_or_rethrow:
            //     [catch bind+body] OR [rethrow path via finally]
            //   after_catch:
            //   finally (shared normal path)
            //
            // continue/break/return inside try/catch run finally via
            // JSComp__EmitPendingFinally (inline fin bodies + TRY_POP).

            fin_body = JSParse_GetRight(save_node)
            catch_body = JSParse_GetLeft(save_node)
            has_fin = 0
            IfCondition GreaterEqual(fin_body, 0) ThenBlock: { has_fin = 1 }
            has_catch = 0
            IfCondition GreaterEqual(catch_body, 0) ThenBlock: { has_catch = 1 }
            // M58: set when no-catch exception path already PopFinally'd
            fin_frame_popped = 0

            // Track finally for abrupt exits (even try/finally without catch)
            IfCondition EqualTo(has_fin, 1) ThenBlock: {
                JSComp__PushFinally(fin_body)
            }

            // Emit TRY_PUSH with placeholder handler address
            try_push_addr = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.TRY_PUSH, 0)

            // Compile try body (in_try=1 so continue emits TRY_POP)
            try_body = JSParse_GetBody(save_node)
            JSComp__Push(save_node)
            JSComp__Push(try_push_addr)
            JSComp__Push(has_fin)
            JSComp__Push(has_catch)
            JSComp__CompileNode(try_body)
            has_catch = JSComp__Pop()
            has_fin = JSComp__Pop()
            try_push_addr = JSComp__Pop()
            save_node = JSComp__Pop()

            // Leaving try body on normal path
            IfCondition EqualTo(has_fin, 1) ThenBlock: {
                JSComp__SetFinallyInTry(0)
            }

            // TRY_POP (normal completion — remove handler)
            JSComp__Emit1(JSOp.TRY_POP)

            // JMP past catch / rethrow stub
            skip_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP, 0)

            // Patch TRY_PUSH → exception landing
            JSComp__PatchJump(try_push_addr)

            // ── Exception landing ──
            IfCondition EqualTo(has_catch, 1) ThenBlock: {
                // catch (e) / catch { } / catch pattern
                catch_body = JSParse_GetLeft(save_node)
                cv_len = JSParse_GetNameLen(save_node)
                catch_has_scope = 0
                IfCondition GreaterThan(cv_len, 0) ThenBlock: {
                    JSComp__PushScope()
                    catch_has_scope = 1
                    cv_ptr = JSParse_GetNamePtr(save_node)
                    JSComp__Push(save_node)
                    JSComp__Push(skip_jmp)
                    JSComp__Push(has_fin)
                    JSComp__Push(has_catch)
                    cv_slot = JSComp__AddLocal(cv_ptr, cv_len)
                    JSComp__Emit1(JSOp.DUP)
                    JSComp__EmitOp16(JSOp.SET_LOCAL, cv_slot)
                    has_catch = JSComp__Pop()
                    has_fin = JSComp__Pop()
                    skip_jmp = JSComp__Pop()
                    save_node = JSComp__Pop()
                    cv_ptr = JSParse_GetNamePtr(save_node)
                    cv_len = JSParse_GetNameLen(save_node)
                    JSComp__Push(save_node)
                    JSComp__Push(skip_jmp)
                    JSComp__Push(has_fin)
                    JSComp__Push(has_catch)
                    ci = JSComp__AddString(cv_ptr, cv_len)
                    JSComp__Emit1(JSOp.DUP)
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, ci)
                    has_catch = JSComp__Pop()
                    has_fin = JSComp__Pop()
                    skip_jmp = JSComp__Pop()
                    save_node = JSComp__Pop()
                }
                IfCondition EqualTo(cv_len, 0) ThenBlock: {
                    catch_pat = JSParse_GetCond(save_node)
                    IfCondition GreaterEqual(catch_pat, 0) ThenBlock: {
                        cdt_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                        SetByte(cdt_nm, 0, 95)
                        SetByte(cdt_nm, 1, 95)
                        SetByte(cdt_nm, 2, 100)
                        SetByte(cdt_nm, 3, 116)
                        SetByte(cdt_nm, 4, 95)
                        SetByte(cdt_nm, 5, 95)
                        SetByte(cdt_nm, 6, 0)
                        JSCompState.str_pos = Add(JSCompState.str_pos, 7)

                        JSComp__Push(save_node)
                        JSComp__Push(skip_jmp)
                        JSComp__Push(has_fin)
                        JSComp__Push(has_catch)
                        JSComp__Push(catch_pat)
                        cdt_slot = JSComp__AddLocal(cdt_nm, 6)
                        JSComp__EmitOp16(JSOp.SET_LOCAL, cdt_slot)
                        catch_pat = JSComp__Pop()
                        has_catch = JSComp__Pop()
                        has_fin = JSComp__Pop()
                        skip_jmp = JSComp__Pop()
                        save_node = JSComp__Pop()

                        pat_type = JSParse_GetType(catch_pat)
                        IfCondition EqualTo(pat_type, ASTType.ARRAY_PATTERN) ThenBlock: {
                            JSComp__Push(save_node)
                            JSComp__Push(skip_jmp)
                            JSComp__Push(has_fin)
                            JSComp__Push(has_catch)
                            JSComp__CompileArrayPattern(catch_pat, cdt_slot)
                            has_catch = JSComp__Pop()
                            has_fin = JSComp__Pop()
                            skip_jmp = JSComp__Pop()
                            save_node = JSComp__Pop()
                        }
                        IfCondition EqualTo(pat_type, ASTType.OBJECT_PATTERN) ThenBlock: {
                            JSComp__Push(save_node)
                            JSComp__Push(skip_jmp)
                            JSComp__Push(has_fin)
                            JSComp__Push(has_catch)
                            JSComp__CompileObjPattern(catch_pat, cdt_slot)
                            has_catch = JSComp__Pop()
                            has_fin = JSComp__Pop()
                            skip_jmp = JSComp__Pop()
                            save_node = JSComp__Pop()
                        }
                    }
                    IfCondition LessThan(catch_pat, 0) ThenBlock: {
                        // Parameterless catch — discard thrown value
                        JSComp__Emit1(JSOp.POP)
                    }
                }

                // Catch body (in_try already 0 — handler was popped by THROW)
                IfCondition GreaterEqual(catch_body, 0) ThenBlock: {
                    JSComp__Push(skip_jmp)
                    JSComp__Push(catch_has_scope)
                    JSComp__Push(has_fin)
                    JSComp__Push(has_catch)
                    JSComp__CompileNode(catch_body)
                    has_catch = JSComp__Pop()
                    has_fin = JSComp__Pop()
                    catch_has_scope = JSComp__Pop()
                    skip_jmp = JSComp__Pop()
                }

                IfCondition EqualTo(catch_has_scope, 1) ThenBlock: {
                    JSComp__Emit1(JSOp.POP)
                    JSComp__PopScope()
                }
            } ElseBlock: {
                // No catch — exception must propagate after finally
                // Thrown value is on stack. Run finally then rethrow.
                IfCondition EqualTo(has_fin, 1) ThenBlock: {
                    // Stack: [exc]
                    fin_body = JSParse_GetRight(save_node)
                    // Pop finally frame before inlining so nested continue/break OK
                    JSComp__PopFinally()
                    // M58: do NOT clear has_fin — normal path still needs shared finally
                    fin_frame_popped = 1
                    JSComp__Push(skip_jmp)
                    JSComp__Push(save_node)
                    JSComp__Push(fin_frame_popped)
                    JSComp__Emit1(JSOp.DUP)
                    JSComp__CompileNode(fin_body)
                    JSComp__Emit1(JSOp.THROW)
                    fin_frame_popped = JSComp__Pop()
                    save_node = JSComp__Pop()
                    skip_jmp = JSComp__Pop()
                } ElseBlock: {
                    // No catch, no finally — just rethrow
                    JSComp__Emit1(JSOp.THROW)
                }
            }

            // Patch skip JMP to shared after-catch (normal + after successful catch)
            JSComp__PatchJump(skip_jmp)

            // Shared finally for normal completion + after catch
            // M58: also for try/finally without catch (was skipped when has_fin cleared)
            IfCondition EqualTo(has_fin, 1) ThenBlock: {
                fin_body = JSParse_GetRight(save_node)
                // Pop frame only if exception path did not already pop it
                IfCondition EqualTo(fin_frame_popped, 0) ThenBlock: {
                    JSComp__PopFinally()
                }
                JSComp__CompileNode(fin_body)
            }

            ReturnValue(0)
        }

        // --- THROW_STMT ---
        IfCondition EqualTo(ntype, ASTType.THROW_STMT) ThenBlock: {
            // Compile the expression to throw
            throw_expr = JSParse_GetLeft(save_node)
            JSComp__CompileExpr(throw_expr)
            // Leave for-of open: inner catch may handle. Uncaught → for-of try handler.
            JSComp__Emit1(JSOp.THROW)
            ReturnValue(0)
        }

        // If we get here with an expression-type node, treat it as EXPR_STMT
        // This handles edge cases where expression nodes appear at statement level
        IfCondition GreaterEqual(ntype, ASTType.ASSIGN) ThenBlock: {
            JSComp__CompileExpr(save_node)
            JSComp__Emit1(JSOp.POP)
            ReturnValue(0)
        }

        // Unknown node type
        PrintMessage("[COMP] unknown node type=")
        PrintNumber(ntype)
        PrintMessage("\n")
        JSCompState.error = 1
        ReturnValue(-1)
    }
}

// ---------------------------------------------------------------------------
// Compile block — iterate body chain via N_BODY -> N_NEXT
// ---------------------------------------------------------------------------
Function.JSComp__CompileBlock {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node
        IfCondition EqualTo(JSCompState.error, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(save_node, 0) ThenBlock: { ReturnValue(-1) }

        JSComp__PushScope()

        // TDZ pre-declaration: scan immediate children for let/const VAR_DECL
        // and CLASS_DECL; pre-allocate slots marked as TDZ
        // M128v: use FRESH_LET_ENV so block lets nest under parent (indirect
        // eval must not see block lexical bindings — lex-env-heritage).
        block_lex_envs = 0
        stmt = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(stmt, 0) {
            st_tdz = JSParse_GetType(stmt)
            IfCondition EqualTo(st_tdz, ASTType.VAR_DECL) ThenBlock: {
                tdz_op = JSParse_GetOp(stmt)
                IfCondition GreaterEqual(tdz_op, 71) ThenBlock: {
                    // let or const: check for simple name (not destructuring)
                    tdz_pat = JSParse_GetRight(stmt)
                    IfCondition LessThan(tdz_pat, 0) ThenBlock: {
                        tdz_np = JSParse_GetNamePtr(stmt)
                        tdz_nl = JSParse_GetNameLen(stmt)
                        tdz_slot = JSComp__AddLocal(tdz_np, tdz_nl)
                        IfCondition And(GreaterEqual(tdz_slot, 0), LessThan(tdz_slot, 256)) ThenBlock: {
                            SetByte(JSCompState.tdz_map, tdz_slot, 1)
                        }
                        // M60/M128v: nested env + TDZ + __lex_ (via FRESH) + __sl_
                        IfCondition GreaterEqual(tdz_slot, 0) ThenBlock: {
                            JSComp__Push(stmt)
                            JSComp__RegisterLetName(tdz_np, tdz_nl)
                            JSComp__Emit1(JSOp.PUSH_TDZ_UNINIT)
                            JSComp__Emit1(JSOp.DUP)
                            tdz_ci = JSComp__AddString(tdz_np, tdz_nl)
                            JSComp__EmitOp16(JSOp.FRESH_LET_ENV, tdz_ci)
                            JSComp__EmitOp16(JSOp.SET_FRAME_ENV, tdz_ci)
                            JSComp__Emit1(0)
                            JSComp__Emit1(BitwiseAnd(ShiftRight(tdz_slot, 8), 255))
                            JSComp__Emit1(BitwiseAnd(tdz_slot, 255))
                            block_lex_envs = Add(block_lex_envs, 1)
                            stmt = JSComp__Pop()
                        }
                    }
                }
            }
            IfCondition EqualTo(st_tdz, ASTType.CLASS_DECL) ThenBlock: {
                tdz_np = JSParse_GetNamePtr(stmt)
                tdz_nl = JSParse_GetNameLen(stmt)
                IfCondition And(NotEqual(tdz_np, 0), GreaterThan(tdz_nl, 0)) ThenBlock: {
                    tdz_slot = JSComp__AddLocal(tdz_np, tdz_nl)
                    IfCondition And(GreaterEqual(tdz_slot, 0), LessThan(tdz_slot, 256)) ThenBlock: {
                        SetByte(JSCompState.tdz_map, tdz_slot, 1)
                    }
                    IfCondition GreaterEqual(tdz_slot, 0) ThenBlock: {
                        JSComp__Push(stmt)
                        JSComp__RegisterLetName(tdz_np, tdz_nl)
                        JSComp__Emit1(JSOp.PUSH_TDZ_UNINIT)
                        JSComp__Emit1(JSOp.DUP)
                        tdz_ci = JSComp__AddString(tdz_np, tdz_nl)
                        JSComp__EmitOp16(JSOp.FRESH_LET_ENV, tdz_ci)
                        JSComp__EmitOp16(JSOp.SET_FRAME_ENV, tdz_ci)
                        JSComp__Emit1(0)
                        JSComp__Emit1(BitwiseAnd(ShiftRight(tdz_slot, 8), 255))
                        JSComp__Emit1(BitwiseAnd(tdz_slot, 255))
                        block_lex_envs = Add(block_lex_envs, 1)
                        stmt = JSComp__Pop()
                    }
                }
            }
            stmt = JSParse_GetNext(stmt)
        }

        // Body chain starts at N_BODY
        // Save and clear is_last_stmt — inner blocks must not inherit the
        // "last top-level statement" flag from eval mode. Otherwise EXPR_STMT
        // inside loops/if/etc skips POP and leaks a value every iteration.
        saved_is_last = JSCompState.is_last_stmt
        JSCompState.is_last_stmt = 0

        // Protect block_lex_envs across recursive CompileNode (shared locals)
        JSComp__Push(block_lex_envs)
        stmt = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(stmt, 0) {
            JSComp__Push(stmt)
            JSComp__CompileNode(stmt)
            stmt = JSComp__Pop()
            stmt = JSParse_GetNext(stmt)
        }
        block_lex_envs = JSComp__Pop()

        JSCompState.is_last_stmt = saved_is_last
        // M128v: pop block let envs so outer script_env is restored
        IfCondition GreaterThan(block_lex_envs, 0) ThenBlock: {
            JSComp__EmitRestoreEnvN(block_lex_envs)
        }
        JSComp__PopScope()
        ReturnValue(0)
    }
}

// ---------------------------------------------------------------------------
// Recursive var/func declaration counter.
// Walks the AST rooted at `node`, counting VAR_DECL and FUNC_DECL nodes.
// Stops recursion at function boundaries (FUNC_DECL/FUNC_EXPR bodies)
// because `var` is function-scoped.  Follows N_LEFT, N_RIGHT, N_COND,
// N_BODY, and N_NEXT pointers.
// ---------------------------------------------------------------------------
Function.JSComp__CountVars {
    Input: node: Integer
    Output: Integer
    Body: {
        save_n = node
        IfCondition LessThan(save_n, 0) ThenBlock: { ReturnValue(0) }
        ntype = JSParse_GetType(save_n)

        // Don't recurse into function bodies — they have their own scope
        IfCondition EqualTo(ntype, ASTType.FUNC_EXPR) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ntype, ASTType.ARROW_EXPR) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ntype, ASTType.GEN_FUNC_EXPR) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ntype, ASTType.ASYNC_FUNC_EXPR) ThenBlock: { ReturnValue(0) }

        count = 0

        // Count this node if it's a var or func declaration
        IfCondition EqualTo(ntype, ASTType.VAR_DECL) ThenBlock: {
            count = 1
        }
        IfCondition EqualTo(ntype, ASTType.FUNC_DECL) ThenBlock: {
            // Count the declaration but don't recurse into the body
            // Still need to follow N_NEXT for sibling statements
            JSComp__Push(1)
            c = JSComp__CountVars(JSParse_GetNext(save_n))
            count = JSComp__Pop()
            ReturnValue(Add(count, c))
        }
        IfCondition EqualTo(ntype, ASTType.GEN_FUNC_DECL) ThenBlock: {
            JSComp__Push(1)
            c = JSComp__CountVars(JSParse_GetNext(save_n))
            count = JSComp__Pop()
            ReturnValue(Add(count, c))
        }
        IfCondition EqualTo(ntype, ASTType.ASYNC_FUNC_DECL) ThenBlock: {
            JSComp__Push(1)
            c = JSComp__CountVars(JSParse_GetNext(save_n))
            count = JSComp__Pop()
            ReturnValue(Add(count, c))
        }
        IfCondition EqualTo(ntype, ASTType.CLASS_DECL) ThenBlock: {
            // Count the class name binding but don't recurse into methods
            JSComp__Push(1)
            c = JSComp__CountVars(JSParse_GetNext(save_n))
            count = JSComp__Pop()
            ReturnValue(Add(count, c))
        }

        // Recurse into children
        JSComp__Push(count)
        c = JSComp__CountVars(JSParse_GetLeft(save_n))
        count = JSComp__Pop()
        count = Add(count, c)

        JSComp__Push(count)
        c = JSComp__CountVars(JSParse_GetRight(save_n))
        count = JSComp__Pop()
        count = Add(count, c)

        JSComp__Push(count)
        c = JSComp__CountVars(JSParse_GetCond(save_n))
        count = JSComp__Pop()
        count = Add(count, c)

        JSComp__Push(count)
        c = JSComp__CountVars(JSParse_GetBody(save_n))
        count = JSComp__Pop()
        count = Add(count, c)

        JSComp__Push(count)
        c = JSComp__CountVars(JSParse_GetNext(save_n))
        count = JSComp__Pop()
        count = Add(count, c)

        ReturnValue(count)
    }
}

// ---------------------------------------------------------------------------
// Hoist `var` bindings to the global object as undefined before program body.
// Without this, GET_GLOBAL throwing on missing names breaks `console.log(x);
// var x = 1` (binding must exist, value undefined).
// Walks like CountVars — skips nested function bodies.
// ---------------------------------------------------------------------------
Function.JSComp__HoistVars {
    Input: node: Integer
    Output: Integer
    Body: {
        save_n = node
        IfCondition LessThan(save_n, 0) ThenBlock: { ReturnValue(0) }
        ntype = JSParse_GetType(save_n)

        // Function boundaries — var inside is local to that function
        IfCondition EqualTo(ntype, ASTType.FUNC_EXPR) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ntype, ASTType.ARROW_EXPR) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ntype, ASTType.GEN_FUNC_EXPR) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ntype, ASTType.ASYNC_FUNC_EXPR) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ntype, ASTType.FUNC_DECL) ThenBlock: {
            // Hoist function *name* as binding (body not walked)
            np = JSParse_GetNamePtr(save_n)
            nl = JSParse_GetNameLen(save_n)
            IfCondition GreaterThan(nl, 0) ThenBlock: {
                // M128v: RegisterScriptVar always; SET_GLOBAL_VAR for program only
                JSComp__Push(save_n)
                IfCondition EqualTo(JSCompState.eval_mode, 0) ThenBlock: {
                    ci = JSComp__AddString(np, nl)
                    JSComp__Emit1(JSOp.PUSH_UNDEF)
                    JSComp__EmitOp16(JSOp.SET_GLOBAL_VAR, ci)
                }
                IfCondition EqualTo(JSCompState.func_nesting, 0) ThenBlock: {
                    JSComp__RegisterScriptVar(np, nl)
                }
                save_n = JSComp__Pop()
            }
            ReturnValue(JSComp__HoistVars(JSParse_GetNext(save_n)))
        }
        IfCondition EqualTo(ntype, ASTType.GEN_FUNC_DECL) ThenBlock: {
            ReturnValue(JSComp__HoistVars(JSParse_GetNext(save_n)))
        }
        IfCondition EqualTo(ntype, ASTType.ASYNC_FUNC_DECL) ThenBlock: {
            ReturnValue(JSComp__HoistVars(JSParse_GetNext(save_n)))
        }
        IfCondition EqualTo(ntype, ASTType.CLASS_DECL) ThenBlock: {
            ReturnValue(JSComp__HoistVars(JSParse_GetNext(save_n)))
        }

        // var (op 70), not let/const
        IfCondition EqualTo(ntype, ASTType.VAR_DECL) ThenBlock: {
            vkind = JSParse_GetOp(save_n)
            IfCondition EqualTo(vkind, 70) ThenBlock: {
                // Simple name only (skip destructuring for now)
                pat = JSParse_GetRight(save_n)
                IfCondition LessThan(pat, 0) ThenBlock: {
                    np = JSParse_GetNamePtr(save_n)
                    nl = JSParse_GetNameLen(save_n)
                    IfCondition GreaterThan(nl, 0) ThenBlock: {
                        // M128v: RegisterScriptVar always so free-var IsScriptVar→SET_GLOBAL
                        // even under eval_mode (EvalString/test262). SET_GLOBAL_VAR only
                        // for true program scripts (eval_mode==0).
                        JSComp__Push(save_n)
                        IfCondition EqualTo(JSCompState.eval_mode, 0) ThenBlock: {
                            ci = JSComp__AddString(np, nl)
                            JSComp__Emit1(JSOp.PUSH_UNDEF)
                            JSComp__EmitOp16(JSOp.SET_GLOBAL_VAR, ci)
                        }
                        IfCondition EqualTo(JSCompState.func_nesting, 0) ThenBlock: {
                            JSComp__RegisterScriptVar(np, nl)
                        }
                        save_n = JSComp__Pop()
                    }
                }
            }
        }

        JSComp__Push(save_n)
        JSComp__HoistVars(JSParse_GetLeft(save_n))
        save_n = JSComp__Pop()
        JSComp__Push(save_n)
        JSComp__HoistVars(JSParse_GetRight(save_n))
        save_n = JSComp__Pop()
        JSComp__Push(save_n)
        JSComp__HoistVars(JSParse_GetCond(save_n))
        save_n = JSComp__Pop()
        JSComp__Push(save_n)
        JSComp__HoistVars(JSParse_GetBody(save_n))
        save_n = JSComp__Pop()
        ReturnValue(JSComp__HoistVars(JSParse_GetNext(save_n)))
    }
}

// ---------------------------------------------------------------------------
// Compile program root — iterate body chain via N_BODY -> N_NEXT, emit HALT
// ---------------------------------------------------------------------------
Function.JSComp__CompileProgram {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node
        IfCondition EqualTo(JSCompState.error, 1) ThenBlock: { ReturnValue(-1) }

        JSComp__PushScope()

        // Pre-scan: recursively count ALL var/func declarations in the
        // program tree (except inside nested functions).  `var` is
        // function-scoped so `for (var i ...)` hoists to program level.
        pre_count = JSComp__CountVars(JSParse_GetBody(save_node))
        // M20b: dstr-assign / compound temps (__dt__, __ir__, __cb__, …) are
        // AddLocal'd during body compile but must sit in the reserved frame —
        // otherwise SET_LOCAL clobbers the operand stack (e.g. assignment
        // expression result `r = [] = vals` lost identity).
        pre_count = Add(pre_count, 64)

        // Reserve local slots on the value stack (mirrors what CALL does for
        // function frames).  Each PUSH_UNDEF advances sp past the slot so
        // subsequent operand pushes land above all locals.
        JSCompTmp.idx = 0
        WhileLoop LessThan(JSCompTmp.idx, pre_count) {
            JSComp__Emit1(JSOp.PUSH_UNDEF)
            JSCompTmp.idx = Add(JSCompTmp.idx, 1)
        }

        // Create global bindings for all program-level `var` / func names
        // so unresolvable ReferenceError does not fire on hoisted names.
        // Var names → undefined; function *names* also get undef here (values
        // installed in pass 1 below).
        // M128j: HoistVars skips SET_GLOBAL in eval_mode (BindNameUndef handles
        // CreateGlobalVarBinding; must not re-init existing globals to undefined).
        JSComp__HoistVars(JSParse_GetBody(save_node))

        // TDZ pre-declaration: scan top-level for let/const VAR_DECL + CLASS_DECL
        // (lex-env-no-init-cls: typeof C; class C {} must TDZ before body eval)
        stmt = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(stmt, 0) {
            st_tdz = JSParse_GetType(stmt)
            IfCondition EqualTo(st_tdz, ASTType.VAR_DECL) ThenBlock: {
                tdz_op = JSParse_GetOp(stmt)
                IfCondition GreaterEqual(tdz_op, 71) ThenBlock: {
                    tdz_pat = JSParse_GetRight(stmt)
                    IfCondition LessThan(tdz_pat, 0) ThenBlock: {
                        tdz_np = JSParse_GetNamePtr(stmt)
                        tdz_nl = JSParse_GetNameLen(stmt)
                        tdz_slot = JSComp__AddLocal(tdz_np, tdz_nl)
                        IfCondition And(GreaterEqual(tdz_slot, 0), LessThan(tdz_slot, 256)) ThenBlock: {
                            SetByte(JSCompState.tdz_map, tdz_slot, 1)
                        }
                        // M60: env TDZ mark for free-var capture
                        IfCondition GreaterEqual(tdz_slot, 0) ThenBlock: {
                            JSComp__Push(stmt)
                            JSComp__EmitTdzEnvMark(tdz_np, tdz_nl, tdz_slot)
                            stmt = JSComp__Pop()
                        }
                        // M128d: register const name during pre-scan so pass-1
                        // function bodies see IsConstName (THROW_CONST) for free-var
                        // writes to outer const — before pass-2 VAR_DECL runs.
                        IfCondition EqualTo(tdz_op, 72) ThenBlock: {
                            IfCondition And(GreaterEqual(tdz_slot, 0), LessThan(tdz_slot, 256)) ThenBlock: {
                                SetByte(JSCompState.const_map, tdz_slot, 1)
                            }
                            JSComp__RegisterConstName(tdz_np, tdz_nl)
                        }
                    }
                }
            }
            IfCondition EqualTo(st_tdz, ASTType.CLASS_DECL) ThenBlock: {
                tdz_np = JSParse_GetNamePtr(stmt)
                tdz_nl = JSParse_GetNameLen(stmt)
                IfCondition And(NotEqual(tdz_np, 0), GreaterThan(tdz_nl, 0)) ThenBlock: {
                    tdz_slot = JSComp__AddLocal(tdz_np, tdz_nl)
                    IfCondition And(GreaterEqual(tdz_slot, 0), LessThan(tdz_slot, 256)) ThenBlock: {
                        SetByte(JSCompState.tdz_map, tdz_slot, 1)
                    }
                    IfCondition GreaterEqual(tdz_slot, 0) ThenBlock: {
                        JSComp__Push(stmt)
                        JSComp__EmitTdzEnvMark(tdz_np, tdz_nl, tdz_slot)
                        stmt = JSComp__Pop()
                    }
                }
            }
            stmt = JSParse_GetNext(stmt)
        }

        // M128c/M128f: Instantiate function declarations before other statements
        // (ES script/eval Instantiation). Always pass-1 so eval sees
        // `function f` before later statements in the same eval body.
        stmt = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(stmt, 0) {
            st_nt = JSParse_GetType(stmt)
            is_fdecl = 0
            IfCondition EqualTo(st_nt, ASTType.FUNC_DECL) ThenBlock: { is_fdecl = 1 }
            IfCondition EqualTo(st_nt, ASTType.GEN_FUNC_DECL) ThenBlock: { is_fdecl = 1 }
            IfCondition EqualTo(st_nt, ASTType.ASYNC_FUNC_DECL) ThenBlock: { is_fdecl = 1 }
            IfCondition EqualTo(is_fdecl, 1) ThenBlock: {
                JSComp__Push(stmt)
                JSComp__CompileNode(stmt)
                stmt = JSComp__Pop()
            }
            stmt = JSParse_GetNext(stmt)
        }

        // Pass 2: statements (skip function decls already emitted in pass 1)
        stmt = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(stmt, 0) {
            st_nt = JSParse_GetType(stmt)
            is_fdecl = 0
            IfCondition EqualTo(st_nt, ASTType.FUNC_DECL) ThenBlock: { is_fdecl = 1 }
            IfCondition EqualTo(st_nt, ASTType.GEN_FUNC_DECL) ThenBlock: { is_fdecl = 1 }
            IfCondition EqualTo(st_nt, ASTType.ASYNC_FUNC_DECL) ThenBlock: { is_fdecl = 1 }
            IfCondition EqualTo(is_fdecl, 0) ThenBlock: {
                next_stmt = JSParse_GetNext(stmt)
                IfCondition And(EqualTo(JSCompState.eval_mode, 1), LessThan(next_stmt, 0)) ThenBlock: {
                    JSCompState.is_last_stmt = 1
                } ElseBlock: {
                    JSCompState.is_last_stmt = 0
                }
                JSComp__Push(stmt)
                JSComp__CompileNode(stmt)
                stmt = JSComp__Pop()
            }
            stmt = JSParse_GetNext(stmt)
        }
        JSCompState.is_last_stmt = 0

        JSComp__Emit1(JSOp.HALT)
        JSComp__PopScope()
        ReturnValue(0)
    }
}

// ---------------------------------------------------------------------------
// Compile class declaration or expression.
// Emits bytecode that leaves the constructor function on the stack.
// Layout:
//   1. Compile constructor method (or default ctor) -> CLOSURE on stack
//   2. DUP constructor, create prototype object, SET_PROP "prototype"
//   3. For each method: compile CLOSURE, SET_PROP on prototype
//   4. For each static: compile CLOSURE, SET_PROP on constructor
//   5. For getters/setters: DEF_GETTER/DEF_SETTER on prototype/constructor
//   6. If extends: set __proto__ on prototype to parent.prototype
//   7. Result: constructor function with .prototype set up
// ---------------------------------------------------------------------------
Function.JSComp__CompileClass {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node
        IfCondition EqualTo(JSCompState.error, 1) ThenBlock: { ReturnValue(-1) }

        // M74: class name lexical binding (immutable) for methods/heritage free-vars
        cnp = JSParse_GetNamePtr(save_node)
        cnl = JSParse_GetNameLen(save_node)
        has_cname = 0
        IfCondition And(NotEqual(cnp, 0), GreaterThan(cnl, 0)) ThenBlock: {
            has_cname = 1
            JSCompState.class_name_ptr = cnp
            JSCompState.class_name_len = cnl
            // Immutable binding enforced in EmitVarSet free-var path (not global
            // RegisterConstName — that blocked outer class-decl reassignment).
            // Runtime classScope: NewDeclarativeEnvironment + immutable name (TDZ first)
            JSComp__Emit1(JSOp.PUSH_TDZ_UNINIT)
            JSComp__Push(save_node)
            JSComp__Push(has_cname)
            cn_ci0 = JSComp__AddString(cnp, cnl)
            has_cname = JSComp__Pop()
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.FRESH_LET_ENV, cn_ci0)
        } ElseBlock: {
            JSCompState.class_name_ptr = 0
            JSCompState.class_name_len = 0
        }

        // If extends, compile parent expression first (before private brand mint)
        // Heritage runs under classScope so nested free-vars see class name.
        parent_n = JSParse_GetLeft(save_node)
        has_parent = 0
        IfCondition GreaterEqual(parent_n, 0) ThenBlock: {
            has_parent = 1
            JSComp__Push(save_node)
            JSComp__Push(has_cname)
            JSComp__CompileExpr(parent_n)
            has_cname = JSComp__Pop()
            save_node = JSComp__Pop()
            // M100: IsConstructor(superclass) before .prototype lookup
            JSComp__Emit1(JSOp.CHECK_CTOR)
            // Parent constructor is now on stack. DUP and store as __super__
            // so child constructor can call super() via GET_GLOBAL.
            JSComp__Emit1(JSOp.DUP)
            sp_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            // "__super__" = 95 95 115 117 112 101 114 95 95
            SetByte(sp_nm, 0, 95)
            SetByte(sp_nm, 1, 95)
            SetByte(sp_nm, 2, 115)
            SetByte(sp_nm, 3, 117)
            SetByte(sp_nm, 4, 112)
            SetByte(sp_nm, 5, 101)
            SetByte(sp_nm, 6, 114)
            SetByte(sp_nm, 7, 95)
            SetByte(sp_nm, 8, 95)
            SetByte(sp_nm, 9, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            JSComp__Push(save_node)
            JSComp__Push(has_cname)
            sp_ci = JSComp__AddString(sp_nm, 9)
            has_cname = JSComp__Pop()
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.SET_GLOBAL, sp_ci)
        }

        // M26k.5/7: push private brand frame + collect declared private names
        prev_priv = JSCompState.priv_class_id
        JSCompState.priv_class_id = JSCompState.next_priv_class_id
        JSCompState.next_priv_class_id = Add(JSCompState.next_priv_class_id, 1)
        JSCompState.priv_depth = Add(JSCompState.priv_depth, 1)
        cur_pd = JSCompState.priv_depth
        IfCondition LessThan(cur_pd, 16) ThenBlock: {
            StoreValue(Add(JSCompState.priv_stack_ids, Multiply(cur_pd, 8)), JSCompState.priv_class_id)
        }
        // Collect private names from methods/fields of this class
        method = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(method, 0) {
            mnp = JSParse_GetNamePtr(method)
            mnl = JSParse_GetNameLen(method)
            IfCondition And(NotEqual(mnp, 0), GreaterThan(mnl, 0)) ThenBlock: {
                IfCondition EqualTo(GetByte(mnp, 0), 35) ThenBlock: {
                    IfCondition LessThan(JSCompState.priv_name_count, 64) ThenBlock: {
                        ni = JSCompState.priv_name_count
                        StoreValue(Add(JSCompState.priv_name_ptrs, Multiply(ni, 8)), mnp)
                        StoreValue(Add(JSCompState.priv_name_lens, Multiply(ni, 8)), mnl)
                        StoreValue(Add(JSCompState.priv_name_depths, Multiply(ni, 8)), cur_pd)
                        JSCompState.priv_name_count = Add(ni, 1)
                    }
                }
            }
            method = JSParse_GetNext(method)
        }

        // Walk methods to find constructor
        method = JSParse_GetBody(save_node)
        ctor_node = -1
        WhileLoop GreaterEqual(method, 0) {
            mflags = JSParse_GetValue(method)
            // bit 3 (8) = constructor
            IfCondition NotEqual(BitwiseAnd(mflags, 8), 0) ThenBlock: {
                ctor_node = method
            }
            method = JSParse_GetNext(method)
        }

        // Compile constructor
        ctor_fidx = -1
        IfCondition GreaterEqual(ctor_node, 0) ThenBlock: {
            // User-defined constructor — flag it as derived if extends
            IfCondition EqualTo(has_parent, 1) ThenBlock: {
                JSCompState.is_derived_ctor = 1
            }
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            JSComp__CompileFunc(ctor_node)
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()
            JSCompState.is_derived_ctor = 0
            ctor_fidx = Subtract(JSCompState.func_count, 1)
        } ElseBlock: {
            // Default constructor:
            //   base: function() {}
            //   derived: function(...args) { super(...args); return this; }
            dfidx = JSCompState.func_count
            IfCondition GreaterEqual(dfidx, JSCompConst.MAX_FUNCS) ThenBlock: {
                JSCompState.error = 1
                // pop private frame
                JSCompState.priv_class_id = prev_priv
                JSCompState.priv_depth = Subtract(JSCompState.priv_depth, 1)
                ReturnValue(-1)
            }
            JSCompState.func_count = Add(dfidx, 1)

            dskip = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP, 0)
            dfstart = JSCompState.code_pos

            IfCondition EqualTo(has_parent, 1) ThenBlock: {
                // super(...args): stack [super_ctor, args_array] → CALL_SPREAD
                JSComp__EmitLoadSuperCtor()
                // GET_LOCAL 0 = rest array (only formal)
                JSComp__EmitOp16(JSOp.GET_LOCAL, 0)
                JSComp__Emit1(JSOp.CALL_SPREAD)
                JSComp__Emit1(JSOp.POP)
                // return this
                this_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(this_nm, 0, 116)
                SetByte(this_nm, 1, 104)
                SetByte(this_nm, 2, 105)
                SetByte(this_nm, 3, 115)
                SetByte(this_nm, 4, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                JSComp__Push(save_node)
                JSComp__Push(has_parent)
                tci = JSComp__AddString(this_nm, 4)
                has_parent = JSComp__Pop()
                save_node = JSComp__Pop()
                JSComp__EmitOp16(JSOp.GET_GLOBAL, tci)
                JSComp__Emit1(JSOp.RETURN)
            } ElseBlock: {
                JSComp__Emit1(JSOp.PUSH_UNDEF)
                JSComp__Emit1(JSOp.RETURN)
            }

            JSComp__PatchJump(dskip)

            dfbase = Add(JSCompState.func_pool, Multiply(dfidx, JSCompConst.FUNC_SIZE))
            StoreValue(dfbase, dfstart)
            // derived default: 1 rest formal (bit 31) + 1 local; base: 0
            IfCondition EqualTo(has_parent, 1) ThenBlock: {
                // params = 1 | rest_bit | unmapped (bit 30)
                StoreValue(Add(dfbase, 8), BitwiseOr(BitwiseOr(1, 2147483648), 1073741824))
                StoreValue(Add(dfbase, 16), 1)
                StoreValue(Add(dfbase, 48), 0)
            } ElseBlock: {
                StoreValue(Add(dfbase, 8), 0)
                StoreValue(Add(dfbase, 16), 0)
            }

            cnp = JSParse_GetNamePtr(save_node)
            cnl = JSParse_GetNameLen(save_node)
            StoreValue(Add(dfbase, 24), cnp)
            StoreValue(Add(dfbase, 32), cnl)

            dci = JSCompState.const_count
            JSCompState.const_count = Add(dci, 1)
            dcbase = Add(JSCompState.const_pool, Multiply(dci, JSCompConst.CONST_SIZE))
            StoreValue(dcbase, 3)
            StoreValue(Add(dcbase, 8), dfbase)

            JSComp__EmitOp16(JSOp.CLOSURE, dci)
            ctor_fidx = dfidx
        }

        // Stack: [parent_ctor?] [constructor]
        // M26b/d: class mark at compiler desc+40 → LoadConst → fdesc+88
        //   1 = base class ctor, 2 = derived (return non-object non-undef → TypeError)
        IfCondition GreaterEqual(ctor_fidx, 0) ThenBlock: {
            cfbase = Add(JSCompState.func_pool, Multiply(ctor_fidx, JSCompConst.FUNC_SIZE))
            IfCondition EqualTo(has_parent, 1) ThenBlock: {
                StoreValue(Add(cfbase, 40), 2)
            } ElseBlock: {
                StoreValue(Add(cfbase, 40), 1)
            }
        }

        // Now DUP constructor, create prototype, set it up

        // Create prototype object
        JSComp__Emit1(JSOp.NEW_OBJECT)
        // Stack: [parent?] [ctor] [proto]

        // If extends: set proto.__proto__ = parent.prototype
        IfCondition EqualTo(has_parent, 1) ThenBlock: {
            // Stack: [parent] [ctor] [proto]
            // Store proto and ctor as globals to avoid local slot corruption.

            // Build "__cp__" string for proto global
            proto_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(proto_nm, 0, 95)
            SetByte(proto_nm, 1, 95)
            SetByte(proto_nm, 2, 99)
            SetByte(proto_nm, 3, 112)
            SetByte(proto_nm, 4, 95)
            SetByte(proto_nm, 5, 95)
            SetByte(proto_nm, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            proto_slot = JSComp__AddString(proto_nm, 6)
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.SET_GLOBAL, proto_slot)
            // Stack: [parent] [ctor]

            // Build "__cc__" string for ctor global
            ctor_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(ctor_nm, 0, 95)
            SetByte(ctor_nm, 1, 95)
            SetByte(ctor_nm, 2, 99)
            SetByte(ctor_nm, 3, 99)
            SetByte(ctor_nm, 4, 95)
            SetByte(ctor_nm, 5, 95)
            SetByte(ctor_nm, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            JSComp__Push(proto_slot)
            ctor_slot = JSComp__AddString(ctor_nm, 6)
            proto_slot = JSComp__Pop()
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.SET_GLOBAL, ctor_slot)
            // Stack: [parent]

            // Get parent.prototype
            pp_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            // "prototype" = 112 114 111 116 111 116 121 112 101
            SetByte(pp_nm, 0, 112)
            SetByte(pp_nm, 1, 114)
            SetByte(pp_nm, 2, 111)
            SetByte(pp_nm, 3, 116)
            SetByte(pp_nm, 4, 111)
            SetByte(pp_nm, 5, 116)
            SetByte(pp_nm, 6, 121)
            SetByte(pp_nm, 7, 112)
            SetByte(pp_nm, 8, 101)
            SetByte(pp_nm, 9, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            JSComp__Push(proto_slot)
            JSComp__Push(ctor_slot)
            pp_ci = JSComp__AddString(pp_nm, 9)
            ctor_slot = JSComp__Pop()
            proto_slot = JSComp__Pop()
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()
            // Stack: [parent] — GET_PROP "prototype"
            JSComp__EmitOp16(JSOp.GET_PROP, pp_ci)
            // Stack: [parent_proto]

            // Build "__pp__" string for parent proto global
            pp_tmp = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(pp_tmp, 0, 95)
            SetByte(pp_tmp, 1, 95)
            SetByte(pp_tmp, 2, 112)
            SetByte(pp_tmp, 3, 112)
            SetByte(pp_tmp, 4, 95)
            SetByte(pp_tmp, 5, 95)
            SetByte(pp_tmp, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            JSComp__Push(proto_slot)
            JSComp__Push(ctor_slot)
            pp_slot = JSComp__AddString(pp_tmp, 6)
            ctor_slot = JSComp__Pop()
            proto_slot = JSComp__Pop()
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()

            JSComp__EmitOp16(JSOp.SET_GLOBAL, pp_slot)
            // Stack: empty

            // Now: push proto (obj), push parent_proto (value), SET_PROP "__proto__"
            JSComp__EmitOp16(JSOp.GET_GLOBAL, proto_slot)
            JSComp__EmitOp16(JSOp.GET_GLOBAL, pp_slot)

            // "__proto__" string constant
            dpp_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(dpp_nm, 0, 95)
            SetByte(dpp_nm, 1, 95)
            SetByte(dpp_nm, 2, 112)
            SetByte(dpp_nm, 3, 114)
            SetByte(dpp_nm, 4, 111)
            SetByte(dpp_nm, 5, 116)
            SetByte(dpp_nm, 6, 111)
            SetByte(dpp_nm, 7, 95)
            SetByte(dpp_nm, 8, 95)
            SetByte(dpp_nm, 9, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            JSComp__Push(proto_slot)
            JSComp__Push(ctor_slot)
            dpp_ci = JSComp__AddString(dpp_nm, 9)
            ctor_slot = JSComp__Pop()
            proto_slot = JSComp__Pop()
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()

            JSComp__EmitOp16(JSOp.SET_PROP, dpp_ci)
            // Stack: empty
        } ElseBlock: {
            // No extends. Stack: [ctor] [proto]
            // Store proto and ctor as globals (not locals) to avoid slot corruption
            // at top-level where CountVars can't account for hidden locals.

            // Build "__cp__" string and add to const pool
            proto_nm2 = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(proto_nm2, 0, 95)
            SetByte(proto_nm2, 1, 95)
            SetByte(proto_nm2, 2, 99)
            SetByte(proto_nm2, 3, 112)
            SetByte(proto_nm2, 4, 95)
            SetByte(proto_nm2, 5, 95)
            SetByte(proto_nm2, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            proto_slot = JSComp__AddString(proto_nm2, 6)
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()

            // Build "__cc__" string and add to const pool
            ctor_nm2 = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(ctor_nm2, 0, 95)
            SetByte(ctor_nm2, 1, 95)
            SetByte(ctor_nm2, 2, 99)
            SetByte(ctor_nm2, 3, 99)
            SetByte(ctor_nm2, 4, 95)
            SetByte(ctor_nm2, 5, 95)
            SetByte(ctor_nm2, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            JSComp__Push(proto_slot)
            ctor_slot = JSComp__AddString(ctor_nm2, 6)
            proto_slot = JSComp__Pop()
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()

            // Stack: [ctor] [proto]. Store proto as global, then ctor as global.
            JSComp__EmitOp16(JSOp.SET_GLOBAL, proto_slot)
            JSComp__EmitOp16(JSOp.SET_GLOBAL, ctor_slot)
            // Stack: empty
        }

        // M74: InitializeBinding(className, constructor) on classScope env
        // Methods/heritage closures already capture this env via CLOSURE.
        IfCondition EqualTo(has_cname, 1) ThenBlock: {
            JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
            JSComp__Push(save_node)
            JSComp__Push(has_cname)
            JSComp__Push(proto_slot)
            JSComp__Push(ctor_slot)
            cn_ci1 = JSComp__AddString(cnp, cnl)
            ctor_slot = JSComp__Pop()
            proto_slot = JSComp__Pop()
            has_cname = JSComp__Pop()
            save_node = JSComp__Pop()
            // SET_FRAME_ENV writes current (classScope) only — init name binding.
            // Trailing slot 0xFFFFFF = no stack sync. Slot 0 would clobber the
            // first top-level local (often a prior class A) via M128e5 stamp.
            JSComp__EmitOp16(JSOp.SET_FRAME_ENV, cn_ci1)
            JSComp__Emit1(255)
            JSComp__Emit1(255)
            JSComp__Emit1(255)
        }

        // Set ctor.prototype = proto
        JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
        JSComp__EmitOp16(JSOp.GET_GLOBAL, proto_slot)
        prot_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
        // "prototype" = 112 114 111 116 111 116 121 112 101
        SetByte(prot_nm, 0, 112)
        SetByte(prot_nm, 1, 114)
        SetByte(prot_nm, 2, 111)
        SetByte(prot_nm, 3, 116)
        SetByte(prot_nm, 4, 111)
        SetByte(prot_nm, 5, 116)
        SetByte(prot_nm, 6, 121)
        SetByte(prot_nm, 7, 112)
        SetByte(prot_nm, 8, 101)
        SetByte(prot_nm, 9, 0)
        JSCompState.str_pos = Add(JSCompState.str_pos, 10)
        JSComp__Push(save_node)
        JSComp__Push(proto_slot)
        JSComp__Push(ctor_slot)
        prot_ci = JSComp__AddString(prot_nm, 9)
        ctor_slot = JSComp__Pop()
        proto_slot = JSComp__Pop()
        save_node = JSComp__Pop()
        JSComp__EmitOp16(JSOp.SET_PROP, prot_ci)

        // Set proto.constructor = ctor
        JSComp__EmitOp16(JSOp.GET_GLOBAL, proto_slot)
        JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
        con_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
        // "constructor" = 99 111 110 115 116 114 117 99 116 111 114
        SetByte(con_nm, 0, 99)
        SetByte(con_nm, 1, 111)
        SetByte(con_nm, 2, 110)
        SetByte(con_nm, 3, 115)
        SetByte(con_nm, 4, 116)
        SetByte(con_nm, 5, 114)
        SetByte(con_nm, 6, 117)
        SetByte(con_nm, 7, 99)
        SetByte(con_nm, 8, 116)
        SetByte(con_nm, 9, 111)
        SetByte(con_nm, 10, 114)
        SetByte(con_nm, 11, 0)
        JSCompState.str_pos = Add(JSCompState.str_pos, 12)
        JSComp__Push(save_node)
        JSComp__Push(proto_slot)
        JSComp__Push(ctor_slot)
        con_ci = JSComp__AddString(con_nm, 11)
        ctor_slot = JSComp__Pop()
        proto_slot = JSComp__Pop()
        save_node = JSComp__Pop()
        JSComp__EmitOp16(JSOp.SET_PROP, con_ci)

        // Now compile each method and set it on prototype or constructor
        method = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(method, 0) {
            mflags = JSParse_GetValue(method)
            // M26k: skip CLASS_FIELD — fields go through __field_init__, not method install
            // (was installing #x as a bogus method during class eval)
            is_cfield = EqualTo(JSParse_GetType(method), ASTType.CLASS_FIELD)
            // Skip constructor — already compiled
            IfCondition And(EqualTo(BitwiseAnd(mflags, 8), 0), EqualTo(is_cfield, 0)) ThenBlock: {
                is_static = BitwiseAnd(mflags, 1)
                is_getter = BitwiseAnd(mflags, 2)
                is_setter = BitwiseAnd(mflags, 4)

                // Push target object: prototype for instance, constructor for static
                IfCondition NotEqual(is_static, 0) ThenBlock: {
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
                } ElseBlock: {
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, proto_slot)
                }

                // Check if method has computed key (N_COND != -1)
                comp_key = JSParse_GetCond(method)

                // For computed methods: compile key expression BEFORE closure
                // Stack order for SET_PROP_COMPUTED: [obj, key, value]
                IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                    JSComp__Push(method)
                    JSComp__Push(proto_slot)
                    JSComp__Push(ctor_slot)
                    JSComp__CompileExpr(comp_key)
                    JSComp__Emit1(JSOp.TO_PROP_KEY)
                    ctor_slot = JSComp__Pop()
                    proto_slot = JSComp__Pop()
                    method = JSComp__Pop()
                }

                // Compile method closure (M26g: static SuperBase uses parent ctor)
                JSComp__Push(method)
                JSComp__Push(proto_slot)
                JSComp__Push(ctor_slot)
                JSComp__Push(is_static)
                // Class methods are always strict-mode code
                IfCondition NotEqual(is_static, 0) ThenBlock: {
                    JSCompState.in_static_method = 1
                } ElseBlock: {
                    JSCompState.in_static_method = 0
                }
                // Mark non-gen MethodDefinition (strict via N_OP bit2; gens keep N_OP for async*)
                m_nt_pre = JSParse_GetType(method)
                is_gen_pre = 0
                IfCondition Or(EqualTo(m_nt_pre, ASTType.GEN_FUNC_EXPR), EqualTo(m_nt_pre, ASTType.GEN_FUNC_DECL)) ThenBlock: {
                    is_gen_pre = 1
                }
                IfCondition Or(EqualTo(m_nt_pre, ASTType.ASYNC_FUNC_EXPR), EqualTo(m_nt_pre, ASTType.ASYNC_FUNC_DECL)) ThenBlock: {
                    IfCondition EqualTo(JSParse_GetOp(method), 1) ThenBlock: { is_gen_pre = 1 }
                }
                IfCondition EqualTo(is_gen_pre, 0) ThenBlock: {
                    mop_c = JSParse_GetOp(method)
                    JSParse__NodeSet(method, ASTConst.N_OP, BitwiseOr(mop_c, 4))
                }
                JSComp__CompileFunc(method)
                // Force strict bit for all class methods (including gens)
                cm_fidx = Subtract(JSCompState.func_count, 1)
                cm_fbase = Add(JSCompState.func_pool, Multiply(cm_fidx, JSCompConst.FUNC_SIZE))
                cm_params = Dereference(Add(cm_fbase, 8))
                // 536870912 = 1<<29 strict
                StoreValue(Add(cm_fbase, 8), BitwiseOr(cm_params, 536870912))
                JSCompState.in_static_method = 0
                // M26i: non-generator methods — no .prototype (flag 4 at +40).
                // Overwrites body_start which gens need; skip GEN_* and async-gen methods.
                m_fidx = Subtract(JSCompState.func_count, 1)
                m_fbase = Add(JSCompState.func_pool, Multiply(m_fidx, JSCompConst.FUNC_SIZE))
                m_nt = JSParse_GetType(method)
                is_gen_m = 0
                IfCondition EqualTo(m_nt, ASTType.GEN_FUNC_EXPR) ThenBlock: { is_gen_m = 1 }
                IfCondition EqualTo(m_nt, ASTType.GEN_FUNC_DECL) ThenBlock: { is_gen_m = 1 }
                // M26k.11: async * methods store gen flag in N_OP — preserve body_start
                IfCondition Or(EqualTo(m_nt, ASTType.ASYNC_FUNC_EXPR), EqualTo(m_nt, ASTType.ASYNC_FUNC_DECL)) ThenBlock: {
                    IfCondition EqualTo(BitwiseAnd(JSParse_GetOp(method), 1), 1) ThenBlock: { is_gen_m = 1 }
                }
                IfCondition EqualTo(is_gen_m, 0) ThenBlock: {
                    StoreValue(Add(m_fbase, 40), 4)
                }
                is_static = JSComp__Pop()
                ctor_slot = JSComp__Pop()
                proto_slot = JSComp__Pop()
                method = JSComp__Pop()

                // Emit property set — computed vs named
                comp_key = JSParse_GetCond(method)
                IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                    // Computed: stack is [obj, key, func]
                    IfCondition NotEqual(is_getter, 0) ThenBlock: {
                        JSComp__Emit1(JSOp.DEF_GETTER_COMPUTED)
                    } ElseBlock: {
                        IfCondition NotEqual(is_setter, 0) ThenBlock: {
                            JSComp__Emit1(JSOp.DEF_SETTER_COMPUTED)
                        } ElseBlock: {
                            JSComp__Emit1(JSOp.SET_PROP_COMPUTED)
                        }
                    }
                } ElseBlock: {
                    // Named: ToPropertyKey (M97)
                    mnp = JSParse_GetNamePtr(method)
                    mnl = JSParse_GetNameLen(method)
                    JSComp__Push(method)
                    JSComp__Push(proto_slot)
                    JSComp__Push(ctor_slot)
                    mci = JSComp__AddPropName(mnp, mnl)
                    ctor_slot = JSComp__Pop()
                    proto_slot = JSComp__Pop()
                    method = JSComp__Pop()

                    // SET_PROP, DEF_GETTER, or DEF_SETTER
                    IfCondition NotEqual(is_getter, 0) ThenBlock: {
                        JSComp__EmitOp16(JSOp.DEF_GETTER, mci)
                    } ElseBlock: {
                        IfCondition NotEqual(is_setter, 0) ThenBlock: {
                            JSComp__EmitOp16(JSOp.DEF_SETTER, mci)
                        } ElseBlock: {
                            JSComp__EmitOp16(JSOp.SET_PROP, mci)
                        }
                    }
                }
            }
            method = JSParse_GetNext(method)
        }

        // --- Compile static fields and static blocks ---
        method = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(method, 0) {
            IfCondition EqualTo(JSParse_GetType(method), ASTType.CLASS_FIELD) ThenBlock: {
                mflags = JSParse_GetValue(method)

                // Static block: mflags bit 4 (value 16) + bit 0 (static)
                sb_flag = BitwiseAnd(mflags, 16)
                IfCondition NotEqual(sb_flag, 0) ThenBlock: {
                    // Compile the static block body inline
                    sb_body = JSParse_GetBody(method)
                    IfCondition GreaterEqual(sb_body, 0) ThenBlock: {
                        // Set 'this' = constructor for static block
                        JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
                        // Build "this" string: 116 104 105 115
                        sb_this_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                        SetByte(sb_this_nm, 0, 116)
                        SetByte(sb_this_nm, 1, 104)
                        SetByte(sb_this_nm, 2, 105)
                        SetByte(sb_this_nm, 3, 115)
                        SetByte(sb_this_nm, 4, 0)
                        JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                        JSComp__Push(method)
                        JSComp__Push(proto_slot)
                        JSComp__Push(ctor_slot)
                        ci_this = JSComp__AddString(sb_this_nm, 4)
                        ctor_slot = JSComp__Pop()
                        proto_slot = JSComp__Pop()
                        method = JSComp__Pop()
                        JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_this)
                        // Compile the block
                        JSComp__Push(method)
                        JSComp__Push(proto_slot)
                        JSComp__Push(ctor_slot)
                        JSComp__CompileBlock(sb_body)
                        ctor_slot = JSComp__Pop()
                        proto_slot = JSComp__Pop()
                        method = JSComp__Pop()
                    }
                }

                is_static = BitwiseAnd(mflags, 1)
                IfCondition And(NotEqual(is_static, 0), EqualTo(sb_flag, 0)) ThenBlock: {
                    // Static field: ctor.field = init
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
                    comp_key = JSParse_GetCond(method)
                    IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                        // Computed key: compile expression
                        JSComp__Push(method)
                        JSComp__Push(proto_slot)
                        JSComp__Push(ctor_slot)
                        JSComp__CompileExpr(comp_key)
                        ctor_slot = JSComp__Pop()
                        proto_slot = JSComp__Pop()
                        method = JSComp__Pop()
                    }
                    // Compile initializer or push undefined
                    field_init = JSParse_GetLeft(method)
                    IfCondition GreaterEqual(field_init, 0) ThenBlock: {
                        JSComp__Push(method)
                        JSComp__Push(proto_slot)
                        JSComp__Push(ctor_slot)
                        JSComp__CompileExpr(field_init)
                        ctor_slot = JSComp__Pop()
                        proto_slot = JSComp__Pop()
                        method = JSComp__Pop()
                    } ElseBlock: {
                        JSComp__Emit1(JSOp.PUSH_UNDEF)
                    }
                    // M26k.5: pulse for static private field define
                    mnp = JSParse_GetNamePtr(method)
                    IfCondition NotEqual(mnp, 0) ThenBlock: {
                        IfCondition EqualTo(GetByte(mnp, 0), 35) ThenBlock: {
                            JSComp__Emit1(JSOp.PRIVATE_INIT_PULSE)
                        }
                    }
                    // Set property
                    comp_key = JSParse_GetCond(method)
                    IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                        JSComp__Emit1(JSOp.SET_PROP_COMPUTED)
                    } ElseBlock: {
                        mnp = JSParse_GetNamePtr(method)
                        mnl = JSParse_GetNameLen(method)
                        JSComp__Push(method)
                        JSComp__Push(proto_slot)
                        JSComp__Push(ctor_slot)
                        mci = JSComp__AddString(mnp, mnl)
                        ctor_slot = JSComp__Pop()
                        proto_slot = JSComp__Pop()
                        method = JSComp__Pop()
                        JSComp__EmitOp16(JSOp.SET_PROP, mci)
                    }
                }
            }
            method = JSParse_GetNext(method)
        }

        // --- Compile instance fields as __field_init__ closure ---
        // Instance fields must be own properties set during construction,
        // not on the prototype. We compile a hidden closure that takes
        // this_obj as parameter and sets each field on it, then store it
        // on the prototype as "__field_init__". The VM's CONSTRUCT RETURN
        // path calls this after the constructor runs.
        has_inst_fields = 0
        method = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(method, 0) {
            IfCondition EqualTo(JSParse_GetType(method), ASTType.CLASS_FIELD) ThenBlock: {
                IfCondition EqualTo(BitwiseAnd(JSParse_GetValue(method), 1), 0) ThenBlock: {
                    has_inst_fields = 1
                }
            }
            method = JSParse_GetNext(method)
        }

        IfCondition EqualTo(has_inst_fields, 1) ThenBlock: {
            // Allocate function descriptor slot
            fi_idx = JSCompState.func_count
            IfCondition GreaterEqual(fi_idx, JSCompConst.MAX_FUNCS) ThenBlock: {
                JSCompState.error = 1
                JSCompState.priv_class_id = prev_priv
                JSCompState.priv_depth = Subtract(JSCompState.priv_depth, 1)
                ReturnValue(-1)
            }
            JSCompState.func_count = Add(fi_idx, 1)

            // JMP to skip the __field_init__ function body
            fi_skip = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP, 0)
            fi_start = JSCompState.code_pos

            // Function body: for each instance field, GET_LOCAL 0 (this_obj param),
            // compile initializer, SET_PROP.
            // M26k.10: computed keys loaded from proto.__fk_N (fixed at class eval).
            fk_idx = 0
            method = JSParse_GetBody(save_node)
            WhileLoop GreaterEqual(method, 0) {
                IfCondition EqualTo(JSParse_GetType(method), ASTType.CLASS_FIELD) ThenBlock: {
                    mflags = JSParse_GetValue(method)
                    IfCondition EqualTo(BitwiseAnd(mflags, 1), 0) ThenBlock: {
                        // Instance field: this_obj.field = init
                        JSComp__EmitOp16(JSOp.GET_LOCAL, 0)

                        comp_key = JSParse_GetCond(method)
                        IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                            // key = this.__proto__["__fk_N"]
                            JSComp__EmitOp16(JSOp.GET_LOCAL, 0)
                            ppk = Add(JSCompState.str_buf, JSCompState.str_pos)
                            SetByte(ppk, 0, 95)
                            SetByte(ppk, 1, 95)
                            SetByte(ppk, 2, 112)
                            SetByte(ppk, 3, 114)
                            SetByte(ppk, 4, 111)
                            SetByte(ppk, 5, 116)
                            SetByte(ppk, 6, 111)
                            SetByte(ppk, 7, 95)
                            SetByte(ppk, 8, 95)
                            SetByte(ppk, 9, 0)
                            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
                            JSComp__Push(method)
                            JSComp__Push(proto_slot)
                            JSComp__Push(ctor_slot)
                            JSComp__Push(fk_idx)
                            ppk_ci = JSComp__AddString(ppk, 9)
                            fk_idx = JSComp__Pop()
                            ctor_slot = JSComp__Pop()
                            proto_slot = JSComp__Pop()
                            method = JSComp__Pop()
                            JSComp__EmitOp16(JSOp.GET_PROP, ppk_ci)
                            // "__fk_" + decimal(fk_idx)
                            fkn = Add(JSCompState.str_buf, JSCompState.str_pos)
                            SetByte(fkn, 0, 95)
                            SetByte(fkn, 1, 95)
                            SetByte(fkn, 2, 102)
                            SetByte(fkn, 3, 107)
                            SetByte(fkn, 4, 95)
                            fktmp = fk_idx
                            fkdigs = 1
                            WhileLoop GreaterEqual(fktmp, 10) {
                                fkdigs = Add(fkdigs, 1)
                                fktmp = Divide(fktmp, 10)
                            }
                            fktmp = fk_idx
                            fkd = Subtract(fkdigs, 1)
                            WhileLoop GreaterEqual(fkd, 0) {
                                fkd10 = Divide(fktmp, 10)
                                fkdigit = Subtract(fktmp, Multiply(fkd10, 10))
                                SetByte(fkn, Add(5, fkd), Add(48, fkdigit))
                                fktmp = fkd10
                                fkd = Subtract(fkd, 1)
                            }
                            SetByte(fkn, Add(5, fkdigs), 0)
                            JSCompState.str_pos = Add(JSCompState.str_pos, Add(6, fkdigs))
                            JSComp__Push(method)
                            JSComp__Push(proto_slot)
                            JSComp__Push(ctor_slot)
                            JSComp__Push(fk_idx)
                            fkn_ci = JSComp__AddString(fkn, Add(5, fkdigs))
                            fk_idx = JSComp__Pop()
                            ctor_slot = JSComp__Pop()
                            proto_slot = JSComp__Pop()
                            method = JSComp__Pop()
                            JSComp__EmitOp16(JSOp.GET_PROP, fkn_ci)
                            fk_idx = Add(fk_idx, 1)
                        }

                        field_init = JSParse_GetLeft(method)
                        IfCondition GreaterEqual(field_init, 0) ThenBlock: {
                            JSComp__Push(method)
                            JSComp__Push(proto_slot)
                            JSComp__Push(ctor_slot)
                            JSComp__Push(fk_idx)
                            JSComp__CompileExpr(field_init)
                            fk_idx = JSComp__Pop()
                            ctor_slot = JSComp__Pop()
                            proto_slot = JSComp__Pop()
                            method = JSComp__Pop()
                        } ElseBlock: {
                            JSComp__Emit1(JSOp.PUSH_UNDEF)
                        }

                        // M26k.5: PrivateFieldAdd only for this field's define SET
                        mnp = JSParse_GetNamePtr(method)
                        IfCondition NotEqual(mnp, 0) ThenBlock: {
                            IfCondition EqualTo(GetByte(mnp, 0), 35) ThenBlock: {
                                JSComp__Emit1(JSOp.PRIVATE_INIT_PULSE)
                            }
                        }

                        comp_key = JSParse_GetCond(method)
                        IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                            JSComp__Emit1(JSOp.SET_PROP_COMPUTED)
                        } ElseBlock: {
                            mnp = JSParse_GetNamePtr(method)
                            mnl = JSParse_GetNameLen(method)
                            JSComp__Push(method)
                            JSComp__Push(proto_slot)
                            JSComp__Push(ctor_slot)
                            JSComp__Push(fk_idx)
                            mci = JSComp__AddString(mnp, mnl)
                            fk_idx = JSComp__Pop()
                            ctor_slot = JSComp__Pop()
                            proto_slot = JSComp__Pop()
                            method = JSComp__Pop()
                            JSComp__EmitOp16(JSOp.SET_PROP, mci)
                        }
                    }
                }
                method = JSParse_GetNext(method)
            }

            JSComp__Emit1(JSOp.PUSH_UNDEF)
            JSComp__Emit1(JSOp.RETURN)

            // Patch JMP target
            JSComp__PatchJump(fi_skip)

            // Build func descriptor: 1 param (this_obj), 1 local
            fi_base = Add(JSCompState.func_pool, Multiply(fi_idx, JSCompConst.FUNC_SIZE))
            StoreValue(fi_base, fi_start)
            StoreValue(Add(fi_base, 8), 1)
            StoreValue(Add(fi_base, 16), 1)
            StoreValue(Add(fi_base, 24), 0)
            StoreValue(Add(fi_base, 32), 0)

            // Add to const pool as type 3 (FUNCTION)
            fi_ci = JSCompState.const_count
            IfCondition GreaterEqual(fi_ci, JSCompConst.MAX_CONSTS) ThenBlock: {
                JSCompState.error = 1
                JSCompState.priv_class_id = prev_priv
                JSCompState.priv_depth = Subtract(JSCompState.priv_depth, 1)
                ReturnValue(-1)
            }
            JSCompState.const_count = Add(fi_ci, 1)
            fi_cbase = Add(JSCompState.const_pool, Multiply(fi_ci, JSCompConst.CONST_SIZE))
            StoreValue(fi_cbase, 3)
            StoreValue(Add(fi_cbase, 8), fi_base)

            // Emit: GET_GLOBAL proto_slot; CLOSURE fi_ci; SET_PROP "__field_init__"
            JSComp__EmitOp16(JSOp.GET_GLOBAL, proto_slot)
            JSComp__EmitOp16(JSOp.CLOSURE, fi_ci)
            // Build "__field_init__" string constant
            fini_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            // "__field_init__" = 95 95 102 105 101 108 100 95 105 110 105 116 95 95
            SetByte(fini_nm, 0, 95)
            SetByte(fini_nm, 1, 95)
            SetByte(fini_nm, 2, 102)
            SetByte(fini_nm, 3, 105)
            SetByte(fini_nm, 4, 101)
            SetByte(fini_nm, 5, 108)
            SetByte(fini_nm, 6, 100)
            SetByte(fini_nm, 7, 95)
            SetByte(fini_nm, 8, 105)
            SetByte(fini_nm, 9, 110)
            SetByte(fini_nm, 10, 105)
            SetByte(fini_nm, 11, 116)
            SetByte(fini_nm, 12, 95)
            SetByte(fini_nm, 13, 95)
            SetByte(fini_nm, 14, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 15)
            JSComp__Push(proto_slot)
            JSComp__Push(ctor_slot)
            fini_ci = JSComp__AddString(fini_nm, 14)
            ctor_slot = JSComp__Pop()
            proto_slot = JSComp__Pop()
            JSComp__EmitOp16(JSOp.SET_PROP, fini_ci)

            // M26k.10: evaluate computed instance field keys once at class eval;
            // store on prototype as __fk_0, __fk_1, ... for field_init to load.
            fk_idx = 0
            method = JSParse_GetBody(save_node)
            WhileLoop GreaterEqual(method, 0) {
                IfCondition EqualTo(JSParse_GetType(method), ASTType.CLASS_FIELD) ThenBlock: {
                    mflags = JSParse_GetValue(method)
                    IfCondition EqualTo(BitwiseAnd(mflags, 1), 0) ThenBlock: {
                        comp_key = JSParse_GetCond(method)
                        IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                            // proto.__fk_N = ToPropertyKey(eval key expr)
                            JSComp__EmitOp16(JSOp.GET_GLOBAL, proto_slot)
                            JSComp__Push(method)
                            JSComp__Push(proto_slot)
                            JSComp__Push(ctor_slot)
                            JSComp__Push(fk_idx)
                            JSComp__CompileExpr(comp_key)
                            fk_idx = JSComp__Pop()
                            ctor_slot = JSComp__Pop()
                            proto_slot = JSComp__Pop()
                            method = JSComp__Pop()
                            // optional: TO_PROP_KEY if available
                            JSComp__Emit1(JSOp.TO_PROP_KEY)
                            fkn = Add(JSCompState.str_buf, JSCompState.str_pos)
                            SetByte(fkn, 0, 95)
                            SetByte(fkn, 1, 95)
                            SetByte(fkn, 2, 102)
                            SetByte(fkn, 3, 107)
                            SetByte(fkn, 4, 95)
                            fktmp = fk_idx
                            fkdigs = 1
                            WhileLoop GreaterEqual(fktmp, 10) {
                                fkdigs = Add(fkdigs, 1)
                                fktmp = Divide(fktmp, 10)
                            }
                            fktmp = fk_idx
                            fkd = Subtract(fkdigs, 1)
                            WhileLoop GreaterEqual(fkd, 0) {
                                fkd10 = Divide(fktmp, 10)
                                fkdigit = Subtract(fktmp, Multiply(fkd10, 10))
                                SetByte(fkn, Add(5, fkd), Add(48, fkdigit))
                                fktmp = fkd10
                                fkd = Subtract(fkd, 1)
                            }
                            SetByte(fkn, Add(5, fkdigs), 0)
                            JSCompState.str_pos = Add(JSCompState.str_pos, Add(6, fkdigs))
                            JSComp__Push(method)
                            JSComp__Push(proto_slot)
                            JSComp__Push(ctor_slot)
                            JSComp__Push(fk_idx)
                            fkn_ci = JSComp__AddString(fkn, Add(5, fkdigs))
                            fk_idx = JSComp__Pop()
                            ctor_slot = JSComp__Pop()
                            proto_slot = JSComp__Pop()
                            method = JSComp__Pop()
                            JSComp__EmitOp16(JSOp.SET_PROP, fkn_ci)
                            fk_idx = Add(fk_idx, 1)
                        }
                    }
                }
                method = JSParse_GetNext(method)
            }
        }

        // If extends: store parent constructor as __super__ property on child ctor.
        // This allows the VM's CONSTRUCT handler to set __super__ at call time,
        // fixing multi-level inheritance where the global gets overwritten.
        IfCondition EqualTo(has_parent, 1) ThenBlock: {
            JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
            // Build "__super__" constant
            sp2_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(sp2_nm, 0, 95)
            SetByte(sp2_nm, 1, 95)
            SetByte(sp2_nm, 2, 115)
            SetByte(sp2_nm, 3, 117)
            SetByte(sp2_nm, 4, 112)
            SetByte(sp2_nm, 5, 101)
            SetByte(sp2_nm, 6, 114)
            SetByte(sp2_nm, 7, 95)
            SetByte(sp2_nm, 8, 95)
            SetByte(sp2_nm, 9, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            JSComp__Push(save_node)
            JSComp__Push(ctor_slot)
            sp2_ci = JSComp__AddString(sp2_nm, 9)
            ctor_slot = JSComp__Pop()
            save_node = JSComp__Pop()
            // Stack: [ctor]. Now push the parent and SET_PROP.
            // __super__ global still holds the parent from class decl time.
            // Reuse the same constant for GET_GLOBAL and SET_PROP.
            JSComp__EmitOp16(JSOp.GET_GLOBAL, sp2_ci)
            // Stack: [ctor, parent_ctor]. Now SET_PROP "__super__" on ctor.
            // SET_PROP pops [obj, val] — but we need [obj] [val] with prop name.
            // Actually SET_PROP takes stack [obj, val] and const idx for name.
            JSComp__EmitOp16(JSOp.SET_PROP, sp2_ci)

            // M26i: ctor.[[Prototype]] = parent (static inheritance / getPrototypeOf)
            JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
            JSComp__EmitOp16(JSOp.GET_GLOBAL, sp2_ci)
            // "__proto__"
            dpp2 = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(dpp2, 0, 95)
            SetByte(dpp2, 1, 95)
            SetByte(dpp2, 2, 112)
            SetByte(dpp2, 3, 114)
            SetByte(dpp2, 4, 111)
            SetByte(dpp2, 5, 116)
            SetByte(dpp2, 6, 111)
            SetByte(dpp2, 7, 95)
            SetByte(dpp2, 8, 95)
            SetByte(dpp2, 9, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            JSComp__Push(save_node)
            JSComp__Push(ctor_slot)
            dpp2_ci = JSComp__AddString(dpp2, 9)
            ctor_slot = JSComp__Pop()
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.SET_PROP, dpp2_ci)
        }

        // Push constructor as the class value (result of class expression)
        JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
        // M74: pop classScope — outer LexEnv restored; methods keep class env in __cenv
        IfCondition EqualTo(has_cname, 1) ThenBlock: {
            JSComp__Emit1(JSOp.RESTORE_ENV)
        }
        JSCompState.class_name_ptr = 0
        JSCompState.class_name_len = 0
        // Pop private brand frame: keep only names from outer depths
        new_nc = 0
        pn = 0
        WhileLoop LessThan(pn, JSCompState.priv_name_count) {
            od = Dereference(Add(JSCompState.priv_name_depths, Multiply(pn, 8)))
            IfCondition NotEqual(od, cur_pd) ThenBlock: {
                StoreValue(Add(JSCompState.priv_name_ptrs, Multiply(new_nc, 8)), Dereference(Add(JSCompState.priv_name_ptrs, Multiply(pn, 8))))
                StoreValue(Add(JSCompState.priv_name_lens, Multiply(new_nc, 8)), Dereference(Add(JSCompState.priv_name_lens, Multiply(pn, 8))))
                StoreValue(Add(JSCompState.priv_name_depths, Multiply(new_nc, 8)), od)
                new_nc = Add(new_nc, 1)
            }
            pn = Add(pn, 1)
        }
        JSCompState.priv_name_count = new_nc
        JSCompState.priv_depth = Subtract(JSCompState.priv_depth, 1)
        JSCompState.priv_class_id = prev_priv
        ReturnValue(0)
    }
}

// ---------------------------------------------------------------------------
// Compile function — emit into separate code region, add to func_pool
// Leaves CLOSURE on stack.
// ---------------------------------------------------------------------------
Function.JSComp__CompileFunc {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node
        IfCondition EqualTo(JSCompState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Record function index
        fidx = JSCompState.func_count
        IfCondition GreaterEqual(fidx, JSCompConst.MAX_FUNCS) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        JSCompState.func_count = Add(fidx, 1)
        JSCompState.func_nesting = Add(JSCompState.func_nesting, 1)
        // Track arrow body for lexical `arguments` free-var capture
        // M108: async arrows are ASYNC_FUNC_EXPR with N_OP=2
        saved_in_arrow = JSCompState.in_arrow
        IfCondition EqualTo(JSParse_GetType(save_node), ASTType.ARROW_EXPR) ThenBlock: {
            JSCompState.in_arrow = 1
        } ElseBlock: {
            IfCondition EqualTo(JSParse_GetType(save_node), ASTType.ASYNC_FUNC_EXPR) ThenBlock: {
                IfCondition EqualTo(JSParse_GetOp(save_node), 2) ThenBlock: {
                    JSCompState.in_arrow = 1
                } ElseBlock: {
                    JSCompState.in_arrow = 0
                }
            } ElseBlock: {
                JSCompState.in_arrow = 0
            }
        }

        // Emit JMP to skip over function body in main code stream
        skip_jmp = JSCompState.code_pos
        JSComp__EmitOp16(JSOp.JMP, 0)

        // Save current code_pos — function code starts here
        func_start = JSCompState.code_pos

        // Snapshot enclosing locals for free-var resolution (before scope clear).
        // Keep grandparent captures, then add parent function's current locals.
        // M59: also capture top-level (script) locals when nesting becomes 1 so
        // nested funcs can GET_FREE for-of/for-in let bindings.
        saved_encl_count = JSCompState.encl_count
        parent_fidx = JSCompState.current_fidx
        IfCondition GreaterThan(JSCompState.func_nesting, 0) ThenBlock: {
            // encl_buf already has grandparent entries [0..saved_encl_count)
            // Append parent locals with owner = parent_fidx
            d = 0
            WhileLoop LessThan(d, JSCompState.scope_depth) {
                lc_addr = Add(JSCompState.scope_locals, Multiply(d, 8))
                lc = Dereference(lc_addr)
                sbase = Add(JSCompState.scope_stack, Multiply(d, JSCompConst.SCOPE_SIZE))
                j = 0
                WhileLoop LessThan(j, lc) {
                    IfCondition LessThan(JSCompState.encl_count, JSCompConst.MAX_ENCL) ThenBlock: {
                        entry = Add(sbase, Multiply(j, 24))
                        ep = Dereference(entry)
                        el = Dereference(Add(entry, 8))
                        ebase = Add(JSCompState.encl_buf, Multiply(JSCompState.encl_count, JSCompConst.ENCL_ENTRY))
                        StoreValue(ebase, ep)
                        StoreValue(Add(ebase, 8), el)
                        StoreValue(Add(ebase, 16), parent_fidx)
                        JSCompState.encl_count = Add(JSCompState.encl_count, 1)
                    }
                    j = Add(j, 1)
                }
                d = Add(d, 1)
            }
        }

        // This function's fidx for capture cells written while compiling its body
        JSCompState.current_fidx = fidx

        // Save entire outer scope state — function locals must start at slot 0
        saved_scope_depth = JSCompState.scope_depth
        saved_scope_bytes = Multiply(saved_scope_depth, JSCompConst.SCOPE_SIZE)
        saved_locals_bytes = Multiply(saved_scope_depth, 8)
        saved_scope_stack = Allocate(Add(saved_scope_bytes, saved_locals_bytes))
        IfCondition GreaterThan(saved_scope_bytes, 0) ThenBlock: {
            MemoryCopy(saved_scope_stack, JSCompState.scope_stack, saved_scope_bytes)
        }
        IfCondition GreaterThan(saved_locals_bytes, 0) ThenBlock: {
            MemoryCopy(Add(saved_scope_stack, saved_scope_bytes), JSCompState.scope_locals, saved_locals_bytes)
        }
        JSCompState.scope_depth = 0

        // Save and clear TDZ map — outer scope's let/const marks must not
        // leak into the inner function (where slot 0 is a parameter, not
        // the outer scope's let/const variable).
        saved_tdz = Allocate(256)
        MemoryCopy(saved_tdz, JSCompState.tdz_map, 256)
        MemorySet(JSCompState.tdz_map, 0, 256)

        // M71: body let/const names for this function only (nested restores)
        saved_let_count = JSCompState.let_name_count

        // Push scope for function body
        JSComp__PushScope()

        // Add parameters as locals
        // For pattern params (ARRAY_PATTERN, OBJECT_PATTERN), add synthetic temp name
        // Track rest (...r) so VM can pack trailing args into an array.
        // Mole 14: rest / default / dstr formals ⇒ unmapped arguments (bit 30).
        param = JSParse_GetLeft(save_node)
        param_count = 0
        has_rest_param = 0
        unmapped_args = 0
        // Function.length = formals before first default or rest
        es_length = 0
        es_length_done = 0
        WhileLoop GreaterEqual(param, 0) {
            pt = JSParse_GetType(param)
            IfCondition EqualTo(es_length_done, 0) ThenBlock: {
                IfCondition EqualTo(pt, ASTType.REST_ELEMENT) ThenBlock: {
                    es_length_done = 1
                } ElseBlock: {
                    IfCondition EqualTo(pt, ASTType.ASSIGN) ThenBlock: {
                        es_length_done = 1
                    } ElseBlock: {
                        es_length = Add(es_length, 1)
                    }
                }
            }
            IfCondition Or(EqualTo(pt, ASTType.ARRAY_PATTERN), EqualTo(pt, ASTType.OBJECT_PATTERN)) ThenBlock: {
                unmapped_args = 1
                // Synthetic name: __pN__ where N is param_count digit
                synth_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(synth_ptr, 0, 95)
                SetByte(synth_ptr, 1, 95)
                SetByte(synth_ptr, 2, 112)
                SetByte(synth_ptr, 3, Add(48, param_count))
                SetByte(synth_ptr, 4, 95)
                SetByte(synth_ptr, 5, 95)
                SetByte(synth_ptr, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                JSComp__AddLocal(synth_ptr, 6)
                // Mole 13: also register nested binding names as locals
                JSComp__Push(param)
                JSComp__Push(param_count)
                JSComp__AddPatternBindings(param)
                param_count = JSComp__Pop()
                param = JSComp__Pop()
            } ElseBlock: {
                IfCondition EqualTo(pt, ASTType.ASSIGN) ThenBlock: {
                    // Default param (any) ⇒ unmapped arguments
                    unmapped_args = 1
                    // ASSIGN wrapping a pattern or ident
                    inner = JSParse_GetRight(param)
                    inner_t = -1
                    IfCondition GreaterEqual(inner, 0) ThenBlock: {
                        inner_t = JSParse_GetType(inner)
                    }
                    IfCondition Or(EqualTo(inner_t, ASTType.ARRAY_PATTERN), EqualTo(inner_t, ASTType.OBJECT_PATTERN)) ThenBlock: {
                        synth_ptr2 = Add(JSCompState.str_buf, JSCompState.str_pos)
                        SetByte(synth_ptr2, 0, 95)
                        SetByte(synth_ptr2, 1, 95)
                        SetByte(synth_ptr2, 2, 112)
                        SetByte(synth_ptr2, 3, Add(48, param_count))
                        SetByte(synth_ptr2, 4, 95)
                        SetByte(synth_ptr2, 5, 95)
                        SetByte(synth_ptr2, 6, 0)
                        JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                        JSComp__AddLocal(synth_ptr2, 6)
                        JSComp__Push(param)
                        JSComp__Push(param_count)
                        JSComp__AddPatternBindings(inner)
                        param_count = JSComp__Pop()
                        param = JSComp__Pop()
                    } ElseBlock: {
                        // ASSIGN wrapping IDENT with default
                        pp = JSParse_GetNamePtr(param)
                        pl = JSParse_GetNameLen(param)
                        JSComp__AddLocal(pp, pl)
                    }
                } ElseBlock: {
                    IfCondition EqualTo(pt, ASTType.REST_ELEMENT) ThenBlock: {
                        // Rest parameter: add the binding name; mark for VM packing
                        has_rest_param = 1
                        unmapped_args = 1
                        rest_bind = JSParse_GetLeft(param)
                        // Rest may be ident OR pattern (...[a,b] / ...{x})
                        rbt = JSParse_GetType(rest_bind)
                        IfCondition Or(EqualTo(rbt, ASTType.ARRAY_PATTERN), EqualTo(rbt, ASTType.OBJECT_PATTERN)) ThenBlock: {
                            JSComp__Push(param)
                            JSComp__Push(param_count)
                            JSComp__AddPatternBindings(rest_bind)
                            param_count = JSComp__Pop()
                            param = JSComp__Pop()
                        } ElseBlock: {
                            pp = JSParse_GetNamePtr(rest_bind)
                            pl = JSParse_GetNameLen(rest_bind)
                            JSComp__AddLocal(pp, pl)
                        }
                    } ElseBlock: {
                        pp = JSParse_GetNamePtr(param)
                        pl = JSParse_GetNameLen(param)
                        JSComp__AddLocal(pp, pl)
                    }
                }
            }
            param_count = Add(param_count, 1)
            param = JSParse_GetNext(param)
        }

        // M108: named FunctionExpression BindingIdentifier after formals.
        // Encoded as name_slot+1 in func_name_slots (0 = none). CALL inits local.
        name_bind_enc = 0
        fn_bind_nl = JSParse_GetNameLen(save_node)
        fn_bind_nt = JSParse_GetType(save_node)
        is_named_expr = 0
        IfCondition GreaterThan(fn_bind_nl, 0) ThenBlock: {
            IfCondition EqualTo(fn_bind_nt, ASTType.FUNC_EXPR) ThenBlock: { is_named_expr = 1 }
            IfCondition EqualTo(fn_bind_nt, ASTType.GEN_FUNC_EXPR) ThenBlock: { is_named_expr = 1 }
            IfCondition EqualTo(fn_bind_nt, ASTType.ASYNC_FUNC_EXPR) ThenBlock: { is_named_expr = 1 }
        }
        IfCondition EqualTo(is_named_expr, 1) ThenBlock: {
            fn_bind_np = JSParse_GetNamePtr(save_node)
            name_bind_slot = JSComp__AddLocal(fn_bind_np, fn_bind_nl)
            IfCondition GreaterEqual(name_bind_slot, 0) ThenBlock: {
                name_bind_enc = Add(name_bind_slot, 1)
                // const_map=2: immutable name — strict TypeError, sloppy no-op
                IfCondition LessThan(name_bind_slot, 256) ThenBlock: {
                    SetByte(JSCompState.const_map, name_bind_slot, 2)
                }
            }
        }
        IfCondition NotEqual(JSCompState.func_name_slots, 0) ThenBlock: {
            StoreValue(Add(JSCompState.func_name_slots, Multiply(fidx, 8)), name_bind_enc)
        }

        // Persist es_length early (locals clobbered by body compile)
        fbase_el = Add(JSCompState.func_pool, Multiply(JSCompState.current_fidx, JSCompConst.FUNC_SIZE))
        StoreValue(Add(fbase_el, 48), es_length)

        // M22b: non-simple formals — TDZ until initialized in order so
        // (x=x) and (a=b,b=1) throw ReferenceError (dflt-params-ref-*).
        // Only mark main formal slots 0..param_count-1 (not nested pattern ids).
        IfCondition EqualTo(unmapped_args, 1) ThenBlock: {
            tdz_i = 0
            WhileLoop LessThan(tdz_i, param_count) {
                IfCondition LessThan(tdz_i, 256) ThenBlock: {
                    SetByte(JSCompState.tdz_map, tdz_i, 1)
                }
                tdz_i = Add(tdz_i, 1)
            }
        }

        // Emit default parameter initialization + destructuring
        param = JSParse_GetLeft(save_node)
        def_slot = 0
        WhileLoop GreaterEqual(param, 0) {
            pt = JSParse_GetType(param)

            // Pattern param — destructure from the slot
            IfCondition EqualTo(pt, ASTType.ARRAY_PATTERN) ThenBlock: {
                JSComp__CompileArrayPattern(param, def_slot)
            }
            IfCondition EqualTo(pt, ASTType.OBJECT_PATTERN) ThenBlock: {
                JSComp__CompileObjPattern(param, def_slot)
            }

            // ASSIGN: default value or pattern+default
            IfCondition EqualTo(pt, ASTType.ASSIGN) ThenBlock: {
                inner2 = JSParse_GetRight(param)
                inner2_t = -1
                IfCondition GreaterEqual(inner2, 0) ThenBlock: {
                    inner2_t = JSParse_GetType(inner2)
                }

                // Check if the param is undefined → apply default
                // Raw GET_LOCAL (not EmitVarGet) — must not TDZ-throw here
                JSComp__EmitOp16(JSOp.GET_LOCAL, def_slot)
                JSComp__Emit1(JSOp.PUSH_UNDEF)
                JSComp__Emit1(JSOp.STRICT_EQ)
                def_skip = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                // Compile default expression (N_LEFT of ASSIGN)
                // EmitVarGet of this/later formals still TDZ → THROW_TDZ
                def_expr = JSParse_GetLeft(param)
                JSComp__Push(param)
                JSComp__Push(def_slot)
                JSComp__Push(def_skip)
                JSComp__CompileExpr(def_expr)
                def_skip = JSComp__Pop()
                def_slot = JSComp__Pop()
                param = JSComp__Pop()
                JSComp__EmitOp16(JSOp.SET_LOCAL, def_slot)
                // M48: SetFunctionName for anonymous default param (fn = function(){})
                // only IDENT defaults (not pattern+default — handled in dstr)
                dft_p = JSParse_GetType(def_expr)
                dfnl_p = 0
                IfCondition Or(EqualTo(dft_p, ASTType.FUNC_EXPR), Or(EqualTo(dft_p, ASTType.ARROW_EXPR), Or(EqualTo(dft_p, ASTType.GEN_FUNC_EXPR), EqualTo(dft_p, ASTType.CLASS_EXPR)))) ThenBlock: {
                    dfnl_p = JSParse_GetNameLen(def_expr)
                }
                IfCondition EqualTo(dfnl_p, 0) ThenBlock: {
                    IfCondition Or(EqualTo(dft_p, ASTType.FUNC_EXPR), Or(EqualTo(dft_p, ASTType.ARROW_EXPR), Or(EqualTo(dft_p, ASTType.GEN_FUNC_EXPR), EqualTo(dft_p, ASTType.CLASS_EXPR)))) ThenBlock: {
                        // ASSIGN layout may put name on ASSIGN node itself
                        pnp = JSParse_GetNamePtr(param)
                        pnl = JSParse_GetNameLen(param)
                        IfCondition GreaterThan(pnl, 0) ThenBlock: {
                            // stack after: empty (name define cleans up)
                            JSComp__EmitOp16(JSOp.GET_LOCAL, def_slot)
                            JSComp__Emit1(JSOp.DUP)
                            nm_key = Add(JSCompState.str_buf, JSCompState.str_pos)
                            SetByte(nm_key, 0, 110)
                            SetByte(nm_key, 1, 97)
                            SetByte(nm_key, 2, 109)
                            SetByte(nm_key, 3, 101)
                            SetByte(nm_key, 4, 0)
                            JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                            JSComp__Push(param)
                            JSComp__Push(def_slot)
                            JSComp__Push(def_skip)
                            nkci_p = JSComp__AddString(nm_key, 4)
                            def_skip = JSComp__Pop()
                            def_slot = JSComp__Pop()
                            param = JSComp__Pop()
                            JSComp__EmitOp16(JSOp.GET_PROP, nkci_p)
                            JSComp__Emit1(JSOp.DUP)
                            emp = Add(JSCompState.str_buf, JSCompState.str_pos)
                            SetByte(emp, 0, 0)
                            JSCompState.str_pos = Add(JSCompState.str_pos, 1)
                            JSComp__Push(nkci_p)
                            emp_ci = JSComp__AddString(emp, 0)
                            nkci_p = JSComp__Pop()
                            JSComp__EmitOp16(JSOp.PUSH_CONST, emp_ci)
                            JSComp__Emit1(JSOp.STRICT_EQ)
                            skip_sn = JSCompState.code_pos
                            JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                            // empty name → set
                            JSComp__Emit1(JSOp.POP)
                            JSComp__Push(param)
                            JSComp__Push(def_slot)
                            JSComp__Push(def_skip)
                            JSComp__Push(skip_sn)
                            JSComp__Push(nkci_p)
                            nci_p = JSComp__AddString(pnp, pnl)
                            nkci_p = JSComp__Pop()
                            skip_sn = JSComp__Pop()
                            def_skip = JSComp__Pop()
                            def_slot = JSComp__Pop()
                            param = JSComp__Pop()
                            JSComp__EmitOp16(JSOp.PUSH_CONST, nci_p)
                            JSComp__EmitOp16(JSOp.SET_PROP, nkci_p)
                            skip_sn_end = JSCompState.code_pos
                            JSComp__EmitOp16(JSOp.JMP, 0)
                            JSComp__PatchJump(skip_sn)
                            // already named — discard fn + name
                            JSComp__Emit1(JSOp.POP)
                            JSComp__Emit1(JSOp.POP)
                            JSComp__PatchJump(skip_sn_end)
                        }
                    }
                }
                JSComp__PatchJump(def_skip)

                // If inner is a pattern, destructure after default application
                IfCondition GreaterEqual(inner2, 0) ThenBlock: {
                    IfCondition EqualTo(inner2_t, ASTType.ARRAY_PATTERN) ThenBlock: {
                        JSComp__CompileArrayPattern(inner2, def_slot)
                    }
                    IfCondition EqualTo(inner2_t, ASTType.OBJECT_PATTERN) ThenBlock: {
                        JSComp__CompileObjPattern(inner2, def_slot)
                    }
                }
            }

            // Formal initialized — clear TDZ for subsequent defaults / body
            IfCondition LessThan(def_slot, 256) ThenBlock: {
                SetByte(JSCompState.tdz_map, def_slot, 0)
            }

            def_slot = Add(def_slot, 1)
            param = JSParse_GetNext(param)
        }

        // If this is a derived class constructor, add __super__ as hidden local
        // and capture the current __super__ global value into it.
        // This prevents multi-level inheritance from clobbering __super__.
        hidden_super_slot = -1
        IfCondition EqualTo(JSCompState.is_derived_ctor, 1) ThenBlock: {
            sup_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            // "__super__" = 95 95 115 117 112 101 114 95 95
            SetByte(sup_nm, 0, 95)
            SetByte(sup_nm, 1, 95)
            SetByte(sup_nm, 2, 115)
            SetByte(sup_nm, 3, 117)
            SetByte(sup_nm, 4, 112)
            SetByte(sup_nm, 5, 101)
            SetByte(sup_nm, 6, 114)
            SetByte(sup_nm, 7, 95)
            SetByte(sup_nm, 8, 95)
            SetByte(sup_nm, 9, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            hidden_super_slot = JSComp__AddLocal(sup_nm, 9)
            // Emit GET_GLOBAL "__super__" to read the current value
            JSComp__Push(save_node)
            sup_ci = JSComp__AddString(sup_nm, 9)
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.GET_GLOBAL, sup_ci)
            JSComp__EmitOp16(JSOp.SET_LOCAL, hidden_super_slot)
        }

        // Mirror simple params into capture cells so nested free-var reads work.
        // Covers IDENT, VAR_DECL, default (ASSIGN), and rest (...r).
        param = JSParse_GetLeft(save_node)
        gslot = 0
        WhileLoop GreaterEqual(param, 0) {
            pt = JSParse_GetType(param)
            pp = 0
            pl = 0
            IfCondition Or(EqualTo(pt, ASTType.IDENT), EqualTo(pt, ASTType.VAR_DECL)) ThenBlock: {
                pp = JSParse_GetNamePtr(param)
                pl = JSParse_GetNameLen(param)
            }
            IfCondition EqualTo(pt, ASTType.ASSIGN) ThenBlock: {
                // default param: name on ASSIGN or on right IDENT
                pp = JSParse_GetNamePtr(param)
                pl = JSParse_GetNameLen(param)
            }
            IfCondition EqualTo(pt, ASTType.REST_ELEMENT) ThenBlock: {
                rest_bind2 = JSParse_GetLeft(param)
                pp = JSParse_GetNamePtr(rest_bind2)
                pl = JSParse_GetNameLen(rest_bind2)
            }
            IfCondition GreaterThan(pl, 0) ThenBlock: {
                // Mirror param into frame env (Mole 7 per-activation)
                JSComp__EmitOp16(JSOp.GET_LOCAL, gslot)
                JSComp__Push(param)
                JSComp__Push(gslot)
                ci_pg = JSComp__AddString(pp, pl)
                gslot = JSComp__Pop()
                param = JSComp__Pop()
                JSComp__EmitOp16(JSOp.SET_FRAME_ENV, ci_pg)
                JSComp__Emit1(0)
                JSComp__Emit1(BitwiseAnd(ShiftRight(gslot, 8), 255))
                JSComp__Emit1(BitwiseAnd(gslot, 255))
            }
            gslot = Add(gslot, 1)
            param = JSParse_GetNext(param)
        }

        // M73: hasParameterExpressions → separate body var env so default-param
        // closures (captured on param env) cannot see body var bindings (ES FDI).
        // unmapped_args covers defaults / rest / destructuring formals.
        IfCondition EqualTo(unmapped_args, 1) ThenBlock: {
            JSComp__Emit1(JSOp.PUSH_UNDEF)
            pe_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(pe_nm, 0, 95)
            SetByte(pe_nm, 1, 95)
            SetByte(pe_nm, 2, 112)
            SetByte(pe_nm, 3, 101)
            SetByte(pe_nm, 4, 95)
            SetByte(pe_nm, 5, 95)
            SetByte(pe_nm, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)
            JSComp__Push(save_node)
            pe_ci = JSComp__AddString(pe_nm, 6)
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.FRESH_LET_ENV, pe_ci)
        }

        // Mole 16: detect function-body "use strict" directive
        // N_OP bit2 = MethodDefinition (no .prototype only — NOT auto-strict for object methods)
        // Class methods get strict forced after CompileFunc in CompileClass.
        func_is_strict = 0
        body = JSParse_GetBody(save_node)
        IfCondition GreaterEqual(body, 0) ThenBlock: {
            first_bstmt = JSParse_GetBody(body)
            IfCondition GreaterEqual(first_bstmt, 0) ThenBlock: {
                // EXPR_STMT (11) + STRING_LIT (20) "use strict"
                IfCondition EqualTo(JSParse_GetType(first_bstmt), 11) ThenBlock: {
                    us_expr = JSParse_GetLeft(first_bstmt)
                    IfCondition GreaterEqual(us_expr, 0) ThenBlock: {
                        IfCondition EqualTo(JSParse_GetType(us_expr), 20) ThenBlock: {
                            us_ptr = JSParse_GetNamePtr(us_expr)
                            us_len = JSParse_GetNameLen(us_expr)
                            // M31: string may be UTF-16; also accept C "use strict" len 10
                            is_us = 0
                            IfCondition EqualTo(us_len, 10) ThenBlock: {
                                IfCondition EqualTo(GetByte(us_ptr, 0), 117) ThenBlock: {
                                    IfCondition EqualTo(GetByte(us_ptr, 1), 115) ThenBlock: {
                                        IfCondition EqualTo(GetByte(us_ptr, 2), 101) ThenBlock: {
                                            IfCondition EqualTo(GetByte(us_ptr, 3), 32) ThenBlock: {
                                                IfCondition EqualTo(GetByte(us_ptr, 4), 115) ThenBlock: {
                                                    IfCondition EqualTo(GetByte(us_ptr, 5), 116) ThenBlock: {
                                                        IfCondition EqualTo(GetByte(us_ptr, 6), 114) ThenBlock: {
                                                            IfCondition EqualTo(GetByte(us_ptr, 7), 105) ThenBlock: {
                                                                IfCondition EqualTo(GetByte(us_ptr, 8), 99) ThenBlock: {
                                                                    IfCondition EqualTo(GetByte(us_ptr, 9), 116) ThenBlock: {
                                                                        is_us = 1
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            // UTF-16 JS string: "use strict" as 10 units
                            IfCondition EqualTo(is_us, 0) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrEq(us_ptr, "use strict"), 1) ThenBlock: {
                                    is_us = 1
                                }
                            }
                            IfCondition EqualTo(is_us, 1) ThenBlock: {
                                func_is_strict = 1
                            }
                        }
                    }
                }
            }
        }

        // Bytecode offset where statements begin (after param defaults/dstr).
        // Generators: FDI runs at call up to body_start; body on first .next().
        // Store immediately into func_pool — locals are clobbered by CompileNode.
        // Use current_fidx (FixedPool) not fidx local — more clobber-safe.
        body_start_pc = JSCompState.code_pos
        fbase_early = Add(JSCompState.func_pool, Multiply(JSCompState.current_fidx, JSCompConst.FUNC_SIZE))
        StoreValue(Add(fbase_early, 40), body_start_pc)

        // M26k.11: yield* → YIELD_STAR only inside sync generators
        saved_comp_strict = JSCompState.is_strict
        IfCondition EqualTo(func_is_strict, 1) ThenBlock: {
            JSCompState.is_strict = 1
        }
        saved_sync_gen = JSCompState.in_sync_gen
        func_ntype_b = JSParse_GetType(save_node)
        IfCondition Or(EqualTo(func_ntype_b, ASTType.GEN_FUNC_DECL), EqualTo(func_ntype_b, ASTType.GEN_FUNC_EXPR)) ThenBlock: {
            JSCompState.in_sync_gen = 1
        } ElseBlock: {
            // Nested non-gen (or async gen) must not inherit outer sync-gen flag
            JSCompState.in_sync_gen = 0

            IfCondition EqualTo(func_ntype_b, ASTType.ASYNC_FUNC_EXPR) ThenBlock: {
                IfCondition EqualTo(JSParse_GetOp(save_node), 1) ThenBlock: {
                    JSCompState.in_sync_gen = 2
                }
            }
            IfCondition EqualTo(func_ntype_b, ASTType.ASYNC_FUNC_DECL) ThenBlock: {
                IfCondition EqualTo(JSParse_GetOp(save_node), 1) ThenBlock: {
                    JSCompState.in_sync_gen = 2
                }
            }
        }

        // Compile function body
        body = JSParse_GetBody(save_node)
        IfCondition GreaterEqual(body, 0) ThenBlock: {
            // Body is a BLOCK node — M58: TDZ-hoist let/const before statements
            // (was skipped by unwrapping BLOCK without CompileNode BLOCK path)
            bstmt = JSParse_GetBody(body)
            WhileLoop GreaterEqual(bstmt, 0) {
                IfCondition EqualTo(JSParse_GetType(bstmt), ASTType.VAR_DECL) ThenBlock: {
                    tdz_op = JSParse_GetOp(bstmt)
                    IfCondition GreaterEqual(tdz_op, 71) ThenBlock: {
                        tdz_pat = JSParse_GetRight(bstmt)
                        IfCondition LessThan(tdz_pat, 0) ThenBlock: {
                            tdz_np = JSParse_GetNamePtr(bstmt)
                            tdz_nl = JSParse_GetNameLen(bstmt)
                            tdz_slot = JSComp__AddLocal(tdz_np, tdz_nl)
                            IfCondition And(GreaterEqual(tdz_slot, 0), LessThan(tdz_slot, 256)) ThenBlock: {
                                SetByte(JSCompState.tdz_map, tdz_slot, 1)
                            }
                            // M60: env TDZ mark for free-var capture
                            IfCondition GreaterEqual(tdz_slot, 0) ThenBlock: {
                                JSComp__Push(bstmt)
                                JSComp__Push(body)
                                JSComp__EmitTdzEnvMark(tdz_np, tdz_nl, tdz_slot)
                                body = JSComp__Pop()
                                bstmt = JSComp__Pop()
                            }
                            // M128d: const name early for nested free-var THROW_CONST
                            IfCondition EqualTo(tdz_op, 72) ThenBlock: {
                                IfCondition And(GreaterEqual(tdz_slot, 0), LessThan(tdz_slot, 256)) ThenBlock: {
                                    SetByte(JSCompState.const_map, tdz_slot, 1)
                                }
                                JSComp__RegisterConstName(tdz_np, tdz_nl)
                            }
                        }
                    }
                }
                bstmt = JSParse_GetNext(bstmt)
            }
            // Compile statements
            bstmt = JSParse_GetBody(body)
            WhileLoop GreaterEqual(bstmt, 0) {
                JSComp__Push(bstmt)
                JSComp__CompileNode(bstmt)
                bstmt = JSComp__Pop()
                bstmt = JSParse_GetNext(bstmt)
            }
        }

        JSCompState.in_sync_gen = saved_sync_gen
        JSCompState.is_strict = saved_comp_strict

        // Implicit return undefined at end of function
        JSComp__Emit1(JSOp.PUSH_UNDEF)
        JSComp__Emit1(JSOp.RETURN)

        // Patch JMP to skip over function body — target is current code_pos
        JSComp__PatchJump(skip_jmp)

        // Mole 13: local_count = actual scope local count after params, pattern
        // bindings, dstr temps, body vars. CountVars(body)+param_count under-counts
        // nested dstr temps (__aN__, __ri__, …) and was missing pattern bindings.
        depth_idx = Subtract(JSCompState.scope_depth, 1)
        local_count = 0
        IfCondition GreaterEqual(depth_idx, 0) ThenBlock: {
            lc_addr = Add(JSCompState.scope_locals, Multiply(depth_idx, 8))
            local_count = Dereference(lc_addr)
        }
        // Safety: at least CountVars(body)+params
        JSComp__Push(save_node)
        JSComp__Push(param_count)
        JSComp__Push(local_count)
        body_vars = JSComp__CountVars(JSParse_GetBody(save_node))
        local_count = JSComp__Pop()
        param_count = JSComp__Pop()
        save_node = JSComp__Pop()
        min_lc = Add(body_vars, param_count)
        IfCondition GreaterThan(min_lc, local_count) ThenBlock: {
            local_count = min_lc
        }
        // Headroom for dstr temps (__ir__, __ra__, nested __aN__, …)
        local_count = Add(local_count, 64)

        JSComp__PopScope()

        // Restore outer scope state
        JSCompState.scope_depth = saved_scope_depth
        IfCondition GreaterThan(saved_scope_bytes, 0) ThenBlock: {
            MemoryCopy(JSCompState.scope_stack, saved_scope_stack, saved_scope_bytes)
        }
        IfCondition GreaterThan(saved_locals_bytes, 0) ThenBlock: {
            MemoryCopy(JSCompState.scope_locals, Add(saved_scope_stack, saved_scope_bytes), saved_locals_bytes)
        }
        Deallocate(saved_scope_stack, Add(saved_scope_bytes, saved_locals_bytes))

        // Restore outer TDZ map
        MemoryCopy(JSCompState.tdz_map, saved_tdz, 256)
        Deallocate(saved_tdz, 256)

        // Build function descriptor in func_pool
        fbase = Add(JSCompState.func_pool, Multiply(fidx, JSCompConst.FUNC_SIZE))
        StoreValue(fbase, func_start)
        // Bit 31 of param_count = has rest formal (VM packs trailing args)
        // Bit 30 = unmapped arguments (rest/default/dstr formals) — Mole 14
        stored_params = param_count
        IfCondition EqualTo(has_rest_param, 1) ThenBlock: {
            stored_params = BitwiseOr(param_count, 2147483648)
        }
        IfCondition EqualTo(unmapped_args, 1) ThenBlock: {
            // 1073741824 = 1<<30
            stored_params = BitwiseOr(stored_params, 1073741824)
        }
        IfCondition EqualTo(func_is_strict, 1) ThenBlock: {
            // 536870912 = 1<<29 — per-function strict (Mole 16)
            stored_params = BitwiseOr(stored_params, 536870912)
        }
        // M103: inherit outer strict script/function (onlyStrict / nested)
        IfCondition EqualTo(JSCompState.is_strict, 1) ThenBlock: {
            stored_params = BitwiseOr(stored_params, 536870912)
        }
        // Emit CLOSURE, GEN_CLOSURE, ASYNC_CLOSURE, or ASYNC_GEN_CLOSURE
        func_ntype = JSParse_GetType(save_node)
        // Bit 28 = arrow function — no own `arguments` (Mole 16 residual)
        IfCondition EqualTo(func_ntype, ASTType.ARROW_EXPR) ThenBlock: {
            // 268435456 = 1<<28
            stored_params = BitwiseOr(stored_params, 268435456)
        }
        // M108: async arrow (ASYNC_FUNC_EXPR N_OP=2) also bit 28 — no own arguments
        IfCondition EqualTo(func_ntype, ASTType.ASYNC_FUNC_EXPR) ThenBlock: {
            IfCondition EqualTo(JSParse_GetOp(save_node), 2) ThenBlock: {
                stored_params = BitwiseOr(stored_params, 268435456)
            }
        }
        StoreValue(Add(fbase, 8), stored_params)
        StoreValue(Add(fbase, 16), local_count)

        // Function name (if any)
        fnp = JSParse_GetNamePtr(save_node)
        fnl = JSParse_GetNameLen(save_node)
        StoreValue(Add(fbase, 24), fnp)
        StoreValue(Add(fbase, 32), fnl)
        // body_start at +40 and es_length at +48 stored earlier (clobber-safe)
        // M71: also stash body_start where method-flag overwrite of +40 cannot kill it
        IfCondition NotEqual(JSCompState.func_body_starts, 0) ThenBlock: {
            StoreValue(Add(JSCompState.func_body_starts, Multiply(fidx, 8)), body_start_pc)
        }

        // M71: pack body-level let/const names for direct-eval SyntaxError
        body_let_n = Subtract(JSCompState.let_name_count, saved_let_count)
        IfCondition And(GreaterThan(body_let_n, 0), NotEqual(JSCompState.func_lex_names, 0)) ThenBlock: {
            blob_sz = 8
            bi = 0
            WhileLoop LessThan(bi, body_let_n) {
                bbase = Add(JSCompState.let_names, Multiply(Add(saved_let_count, bi), 16))
                bl = Dereference(Add(bbase, 8))
                blob_sz = Add(blob_sz, Add(8, Add(bl, 1)))
                blob_sz = Multiply(Divide(Add(blob_sz, 7), 8), 8)
                bi = Add(bi, 1)
            }
            blob = Allocate(blob_sz)
            MemorySet(blob, 0, blob_sz)
            StoreValue(blob, body_let_n)
            bpos = 8
            bi = 0
            WhileLoop LessThan(bi, body_let_n) {
                bbase = Add(JSCompState.let_names, Multiply(Add(saved_let_count, bi), 16))
                bp = Dereference(bbase)
                bl = Dereference(Add(bbase, 8))
                StoreValue(Add(blob, bpos), bl)
                bpos = Add(bpos, 8)
                IfCondition And(NotEqual(bp, 0), GreaterThan(bl, 0)) ThenBlock: {
                    MemoryCopy(Add(blob, bpos), bp, bl)
                }
                bpos = Add(bpos, Add(bl, 1))
                bpos = Multiply(Divide(Add(bpos, 7), 8), 8)
                bi = Add(bi, 1)
            }
            StoreValue(Add(JSCompState.func_lex_names, Multiply(fidx, 8)), blob)
        }

        // M71: pack formal parameter names (default-param direct eval vs formals)
        // M128u: also set bit 27 (134217728) if any formal is named "arguments"
        has_args_formal = 0
        IfCondition NotEqual(JSCompState.func_param_names, 0) ThenBlock: {
            // First pass: count simple formal names + total blob size
            pcnt = 0
            pblob_sz = 8
            pwalk = JSParse_GetLeft(save_node)
            WhileLoop GreaterEqual(pwalk, 0) {
                pwt = JSParse_GetType(pwalk)
                pnp = 0
                pnl = 0
                IfCondition Or(EqualTo(pwt, ASTType.IDENT), EqualTo(pwt, ASTType.VAR_DECL)) ThenBlock: {
                    pnp = JSParse_GetNamePtr(pwalk)
                    pnl = JSParse_GetNameLen(pwalk)
                } ElseBlock: {
                    IfCondition EqualTo(pwt, ASTType.ASSIGN) ThenBlock: {
                        pnp = JSParse_GetNamePtr(pwalk)
                        pnl = JSParse_GetNameLen(pwalk)
                    } ElseBlock: {
                        IfCondition EqualTo(pwt, ASTType.REST_ELEMENT) ThenBlock: {
                            rbind = JSParse_GetLeft(pwalk)
                            IfCondition GreaterEqual(rbind, 0) ThenBlock: {
                                rbt2 = JSParse_GetType(rbind)
                                IfCondition Or(EqualTo(rbt2, ASTType.IDENT), EqualTo(rbt2, ASTType.VAR_DECL)) ThenBlock: {
                                    pnp = JSParse_GetNamePtr(rbind)
                                    pnl = JSParse_GetNameLen(rbind)
                                }
                            }
                        }
                    }
                }
                IfCondition GreaterThan(pnl, 0) ThenBlock: {
                    pcnt = Add(pcnt, 1)
                    pblob_sz = Add(pblob_sz, Add(8, Add(pnl, 1)))
                    pblob_sz = Multiply(Divide(Add(pblob_sz, 7), 8), 8)
                    // "arguments" formal (9 chars)
                    IfCondition And(EqualTo(pnl, 9), NotEqual(pnp, 0)) ThenBlock: {
                        IfCondition And(EqualTo(GetByte(pnp, 0), 97), And(EqualTo(GetByte(pnp, 1), 114), And(EqualTo(GetByte(pnp, 2), 103), And(EqualTo(GetByte(pnp, 3), 117), And(EqualTo(GetByte(pnp, 4), 109), And(EqualTo(GetByte(pnp, 5), 101), And(EqualTo(GetByte(pnp, 6), 110), And(EqualTo(GetByte(pnp, 7), 116), EqualTo(GetByte(pnp, 8), 115))))))))) ThenBlock: {
                            has_args_formal = 1
                        }
                    }
                }
                pwalk = JSParse_GetNext(pwalk)
            }
            IfCondition GreaterThan(pcnt, 0) ThenBlock: {
                pblob = Allocate(pblob_sz)
                MemorySet(pblob, 0, pblob_sz)
                StoreValue(pblob, pcnt)
                ppos = 8
                pwalk = JSParse_GetLeft(save_node)
                WhileLoop GreaterEqual(pwalk, 0) {
                    pwt = JSParse_GetType(pwalk)
                    pnp = 0
                    pnl = 0
                    IfCondition Or(EqualTo(pwt, ASTType.IDENT), EqualTo(pwt, ASTType.VAR_DECL)) ThenBlock: {
                        pnp = JSParse_GetNamePtr(pwalk)
                        pnl = JSParse_GetNameLen(pwalk)
                    } ElseBlock: {
                        IfCondition EqualTo(pwt, ASTType.ASSIGN) ThenBlock: {
                            pnp = JSParse_GetNamePtr(pwalk)
                            pnl = JSParse_GetNameLen(pwalk)
                        } ElseBlock: {
                            IfCondition EqualTo(pwt, ASTType.REST_ELEMENT) ThenBlock: {
                                rbind = JSParse_GetLeft(pwalk)
                                IfCondition GreaterEqual(rbind, 0) ThenBlock: {
                                    rbt2 = JSParse_GetType(rbind)
                                    IfCondition Or(EqualTo(rbt2, ASTType.IDENT), EqualTo(rbt2, ASTType.VAR_DECL)) ThenBlock: {
                                        pnp = JSParse_GetNamePtr(rbind)
                                        pnl = JSParse_GetNameLen(rbind)
                                    }
                                }
                            }
                        }
                    }
                    IfCondition GreaterThan(pnl, 0) ThenBlock: {
                        StoreValue(Add(pblob, ppos), pnl)
                        ppos = Add(ppos, 8)
                        IfCondition NotEqual(pnp, 0) ThenBlock: {
                            MemoryCopy(Add(pblob, ppos), pnp, pnl)
                        }
                        ppos = Add(ppos, Add(pnl, 1))
                        ppos = Multiply(Divide(Add(ppos, 7), 8), 8)
                    }
                    pwalk = JSParse_GetNext(pwalk)
                }
                StoreValue(Add(JSCompState.func_param_names, Multiply(fidx, 8)), pblob)
            }
        }
        // M128u: bit 27 = has formal named "arguments" (eval param-init SyntaxError)
        IfCondition EqualTo(has_args_formal, 1) ThenBlock: {
            // 134217728 = 1<<27
            cur_sp = Dereference(Add(fbase, 8))
            StoreValue(Add(fbase, 8), BitwiseOr(cur_sp, 134217728))
        }

        // Add function descriptor to const pool as type 3 = FUNCTION
        ci = JSCompState.const_count
        IfCondition GreaterEqual(ci, JSCompConst.MAX_CONSTS) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        JSCompState.const_count = Add(ci, 1)
        cbase = Add(JSCompState.const_pool, Multiply(ci, JSCompConst.CONST_SIZE))
        StoreValue(cbase, 3)
        StoreValue(Add(cbase, 8), fbase)

        IfCondition Or(EqualTo(func_ntype, ASTType.GEN_FUNC_DECL), EqualTo(func_ntype, ASTType.GEN_FUNC_EXPR)) ThenBlock: {
            JSComp__EmitOp16(JSOp.GEN_CLOSURE, ci)
        } ElseBlock: {
            IfCondition Or(EqualTo(func_ntype, ASTType.ASYNC_FUNC_DECL), EqualTo(func_ntype, ASTType.ASYNC_FUNC_EXPR)) ThenBlock: {
                // N_OP: 0=async fn, 1=async gen, 2=async arrow
                func_nop = JSParse_GetOp(save_node)
                IfCondition EqualTo(func_nop, 1) ThenBlock: {
                    JSComp__EmitOp16(JSOp.ASYNC_GEN_CLOSURE, ci)
                } ElseBlock: {
                    JSComp__EmitOp16(JSOp.ASYNC_CLOSURE, ci)
                }
            } ElseBlock: {
                JSComp__EmitOp16(JSOp.CLOSURE, ci)
            }
        }

        // M71: drop this function's let names so parent list stays clean
        JSCompState.let_name_count = saved_let_count

        // Restore enclosing free-var table and parent fidx
        JSCompState.encl_count = saved_encl_count
        JSCompState.current_fidx = parent_fidx
        JSCompState.func_nesting = Subtract(JSCompState.func_nesting, 1)
        JSCompState.in_arrow = saved_in_arrow
        ReturnValue(0)
    }
}

// =============================================================================
// PUBLIC API
// =============================================================================

// Compile AST from root node. Returns 1 on success, 0 on error.
Function.JSComp_Compile {
    Input: root: Integer
    Output: Integer
    Body: {
        save_root = root
        JSCompState.error = 0
        JSCompState.code_pos = 0
        JSCompState.const_count = 0
        JSCompState.scope_depth = 0
        JSCompState.func_count = 0
        JSCompState.loop_depth = 0
        JSCompState.str_pos = 0
        JSCompState.is_strict = 0
        JSCompStack.sp = 0

        // Wave 3 D3: detect top-level "use strict" directive
        // M104: also accept UTF-16 via JSRT_StrEq (same as function-body path)
        IfCondition GreaterEqual(save_root, 0) ThenBlock: {
            first_stmt = JSParse_GetBody(save_root)
            IfCondition GreaterEqual(first_stmt, 0) ThenBlock: {
                // EXPR_STMT (type 11) containing STRING_LIT "use strict"
                IfCondition EqualTo(JSParse_GetType(first_stmt), 11) ThenBlock: {
                    us_expr = JSParse_GetLeft(first_stmt)
                    IfCondition GreaterEqual(us_expr, 0) ThenBlock: {
                        IfCondition EqualTo(JSParse_GetType(us_expr), 20) ThenBlock: {
                            us_ptr = JSParse_GetNamePtr(us_expr)
                            us_len = JSParse_GetNameLen(us_expr)
                            is_us_tl = 0
                            IfCondition EqualTo(us_len, 10) ThenBlock: {
                                IfCondition EqualTo(GetByte(us_ptr, 0), 117) ThenBlock: {
                                    IfCondition EqualTo(GetByte(us_ptr, 1), 115) ThenBlock: {
                                        IfCondition EqualTo(GetByte(us_ptr, 2), 101) ThenBlock: {
                                            IfCondition EqualTo(GetByte(us_ptr, 3), 32) ThenBlock: {
                                                IfCondition EqualTo(GetByte(us_ptr, 4), 115) ThenBlock: {
                                                    IfCondition EqualTo(GetByte(us_ptr, 5), 116) ThenBlock: {
                                                        IfCondition EqualTo(GetByte(us_ptr, 6), 114) ThenBlock: {
                                                            IfCondition EqualTo(GetByte(us_ptr, 7), 105) ThenBlock: {
                                                                IfCondition EqualTo(GetByte(us_ptr, 8), 99) ThenBlock: {
                                                                    IfCondition EqualTo(GetByte(us_ptr, 9), 116) ThenBlock: {
                                                                        is_us_tl = 1
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            IfCondition EqualTo(is_us_tl, 0) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrEq(us_ptr, "use strict"), 1) ThenBlock: {
                                    is_us_tl = 1
                                }
                            }
                            IfCondition EqualTo(is_us_tl, 1) ThenBlock: {
                                JSCompState.is_strict = 1
                            }
                        }
                    }
                }
            }
        }

        JSComp__CompileNode(save_root)

        IfCondition EqualTo(JSCompState.error, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// Return pointer to bytecode buffer
Function.JSComp_GetCode {
    Output: Address
    Body: {
        ReturnValue(JSCompState.code)
    }
}

// Return bytecode length
Function.JSComp_GetCodeLen {
    Output: Integer
    Body: {
        ReturnValue(JSCompState.code_pos)
    }
}

// Return pointer to constant pool entry at index
Function.JSComp_GetConst {
    Input: idx: Integer
    Output: Address
    Body: {
        save_idx = idx
        ReturnValue(Add(JSCompState.const_pool, Multiply(save_idx, JSCompConst.CONST_SIZE)))
    }
}

// Return constant pool count
Function.JSComp_GetConstCount {
    Output: Integer
    Body: {
        ReturnValue(JSCompState.const_count)
    }
}

// Return pointer to function descriptor at index
Function.JSComp_GetFunc {
    Input: idx: Integer
    Output: Address
    Body: {
        save_idx = idx
        ReturnValue(Add(JSCompState.func_pool, Multiply(save_idx, JSCompConst.FUNC_SIZE)))
    }
}

// Return function descriptor count
Function.JSComp_GetFuncCount {
    Output: Integer
    Body: {
        ReturnValue(JSCompState.func_count)
    }
}

// Return error flag
Function.JSComp_HasError {
    Output: Integer
    Body: {
        ReturnValue(JSCompState.error)
    }
}

// =============================================================================
// DESTRUCTURING PATTERN COMPILATION
// =============================================================================

// M64: for each binding name in a let/const for-of pattern, install a fresh
// env frame with TDZ sentinel so SET_FRAME_ENV updates the shadow (not outer)
// and closures capture per-iteration bindings. Returns env nest count.
Function.JSComp__LexPatternFreshEnv {
    Input: pat_node: Integer
    Output: Integer
    Body: {
        save_p = pat_node
        IfCondition LessThan(save_p, 0) ThenBlock: {
            ReturnValue(0)
        }
        pt = JSParse_GetType(save_p)
        nenv = 0

        IfCondition EqualTo(pt, ASTType.IDENT) ThenBlock: {
            np = JSParse_GetNamePtr(save_p)
            nl = JSParse_GetNameLen(save_p)
            IfCondition GreaterThan(nl, 0) ThenBlock: {
                JSComp__RegisterLetName(np, nl)
                existing = JSComp__FindLocalInScope(np, nl)
                IfCondition LessThan(existing, 0) ThenBlock: {
                    // Do not mark tdz_map: pattern init must SET_LOCAL; runtime
                    // TDZ uses env sentinel (PUSH_TDZ_UNINIT) for free-var reads.
                    JSComp__AddLocal(np, nl)
                }
                JSComp__Emit1(JSOp.PUSH_TDZ_UNINIT)
                ci = JSComp__AddString(np, nl)
                JSComp__EmitOp16(JSOp.FRESH_LET_ENV, ci)
                nenv = 1
            }
            ReturnValue(nenv)
        }

        IfCondition EqualTo(pt, ASTType.ARRAY_PATTERN) ThenBlock: {
            el = JSParse_GetLeft(save_p)
            WhileLoop GreaterEqual(el, 0) {
                JSComp__Push(nenv)
                n = JSComp__LexPatternFreshEnv(el)
                nenv = JSComp__Pop()
                nenv = Add(nenv, n)
                el = JSParse_GetNext(el)
            }
            ReturnValue(nenv)
        }

        IfCondition EqualTo(pt, ASTType.OBJECT_PATTERN) ThenBlock: {
            pr = JSParse_GetLeft(save_p)
            WhileLoop GreaterEqual(pr, 0) {
                JSComp__Push(nenv)
                n = JSComp__LexPatternFreshEnv(pr)
                nenv = JSComp__Pop()
                nenv = Add(nenv, n)
                pr = JSParse_GetNext(pr)
            }
            ReturnValue(nenv)
        }

        IfCondition EqualTo(pt, ASTType.PROPERTY) ThenBlock: {
            bind = JSParse_GetLeft(save_p)
            ReturnValue(JSComp__LexPatternFreshEnv(bind))
        }

        IfCondition EqualTo(pt, ASTType.REST_ELEMENT) ThenBlock: {
            tgt = JSParse_GetLeft(save_p)
            ReturnValue(JSComp__LexPatternFreshEnv(tgt))
        }

        // Default: target in N_RIGHT
        IfCondition EqualTo(pt, ASTType.ASSIGN) ThenBlock: {
            tgt2 = JSParse_GetRight(save_p)
            ReturnValue(JSComp__LexPatternFreshEnv(tgt2))
        }

        IfCondition EqualTo(pt, ASTType.VAR_DECL) ThenBlock: {
            np2 = JSParse_GetNamePtr(save_p)
            nl2 = JSParse_GetNameLen(save_p)
            IfCondition GreaterThan(nl2, 0) ThenBlock: {
                JSComp__RegisterLetName(np2, nl2)
                existing2 = JSComp__FindLocalInScope(np2, nl2)
                IfCondition LessThan(existing2, 0) ThenBlock: {
                    JSComp__AddLocal(np2, nl2)
                }
                JSComp__Emit1(JSOp.PUSH_TDZ_UNINIT)
                ci2 = JSComp__AddString(np2, nl2)
                JSComp__EmitOp16(JSOp.FRESH_LET_ENV, ci2)
                ReturnValue(1)
            }
            ReturnValue(0)
        }

        ReturnValue(0)
    }
}

// Emit n RESTORE_ENV ops (pop for-of lex env nest).
Function.JSComp__EmitRestoreEnvN {
    Input: n: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, n) {
            JSComp__Emit1(JSOp.RESTORE_ENV)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Clear compile-time TDZ bits for pattern binding slots (body may read them).
Function.JSComp__ClearPatternTdz {
    Input: pat_node: Integer
    Output: Integer
    Body: {
        save_p = pat_node
        IfCondition LessThan(save_p, 0) ThenBlock: {
            ReturnValue(0)
        }
        pt = JSParse_GetType(save_p)
        IfCondition EqualTo(pt, ASTType.IDENT) ThenBlock: {
            np = JSParse_GetNamePtr(save_p)
            nl = JSParse_GetNameLen(save_p)
            slot = JSComp__FindLocal(np, nl)
            IfCondition And(GreaterEqual(slot, 0), LessThan(slot, 256)) ThenBlock: {
                SetByte(JSCompState.tdz_map, slot, 0)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(pt, ASTType.ARRAY_PATTERN) ThenBlock: {
            el = JSParse_GetLeft(save_p)
            WhileLoop GreaterEqual(el, 0) {
                JSComp__ClearPatternTdz(el)
                el = JSParse_GetNext(el)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(pt, ASTType.OBJECT_PATTERN) ThenBlock: {
            pr = JSParse_GetLeft(save_p)
            WhileLoop GreaterEqual(pr, 0) {
                JSComp__ClearPatternTdz(pr)
                pr = JSParse_GetNext(pr)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(pt, ASTType.PROPERTY) ThenBlock: {
            ReturnValue(JSComp__ClearPatternTdz(JSParse_GetLeft(save_p)))
        }
        IfCondition EqualTo(pt, ASTType.REST_ELEMENT) ThenBlock: {
            ReturnValue(JSComp__ClearPatternTdz(JSParse_GetLeft(save_p)))
        }
        IfCondition EqualTo(pt, ASTType.ASSIGN) ThenBlock: {
            ReturnValue(JSComp__ClearPatternTdz(JSParse_GetRight(save_p)))
        }
        IfCondition EqualTo(pt, ASTType.VAR_DECL) ThenBlock: {
            np2 = JSParse_GetNamePtr(save_p)
            nl2 = JSParse_GetNameLen(save_p)
            slot2 = JSComp__FindLocal(np2, nl2)
            IfCondition And(GreaterEqual(slot2, 0), LessThan(slot2, 256)) ThenBlock: {
                SetByte(JSCompState.tdz_map, slot2, 0)
            }
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

// Mole 13: register every binding name in a pattern as a local BEFORE
// CompileArrayPattern/CompileObjPattern run. Without this, EmitVarSet falls
// through to SET_GLOBAL and nested multi-bindings corrupt the call stack
// (func local_count also under-counted temps).
// Returns number of names added.
Function.JSComp__AddPatternBindings {
    Input: pat_node: Integer
    Output: Integer
    Body: {
        save_p = pat_node
        IfCondition LessThan(save_p, 0) ThenBlock: {
            ReturnValue(0)
        }
        pt = JSParse_GetType(save_p)
        added = 0

        // IDENT — add if not already a local
        IfCondition EqualTo(pt, ASTType.IDENT) ThenBlock: {
            np = JSParse_GetNamePtr(save_p)
            nl = JSParse_GetNameLen(save_p)
            IfCondition GreaterThan(nl, 0) ThenBlock: {
                existing = JSComp__FindLocalInScope(np, nl)
                IfCondition LessThan(existing, 0) ThenBlock: {
                    JSComp__AddLocal(np, nl)
                    added = 1
                }
            }
            ReturnValue(added)
        }

        // ARRAY_PATTERN — walk elements
        IfCondition EqualTo(pt, ASTType.ARRAY_PATTERN) ThenBlock: {
            el = JSParse_GetLeft(save_p)
            WhileLoop GreaterEqual(el, 0) {
                JSComp__Push(added)
                n = JSComp__AddPatternBindings(el)
                added = JSComp__Pop()
                added = Add(added, n)
                el = JSParse_GetNext(el)
            }
            ReturnValue(added)
        }

        // OBJECT_PATTERN — walk properties
        IfCondition EqualTo(pt, ASTType.OBJECT_PATTERN) ThenBlock: {
            pr = JSParse_GetLeft(save_p)
            WhileLoop GreaterEqual(pr, 0) {
                JSComp__Push(added)
                n = JSComp__AddPatternBindings(pr)
                added = JSComp__Pop()
                added = Add(added, n)
                pr = JSParse_GetNext(pr)
            }
            ReturnValue(added)
        }

        // PROPERTY — binding in N_LEFT; optional default in N_RIGHT is expr not pattern
        IfCondition EqualTo(pt, ASTType.PROPERTY) ThenBlock: {
            bind = JSParse_GetLeft(save_p)
            ReturnValue(JSComp__AddPatternBindings(bind))
        }

        // REST_ELEMENT — target in N_LEFT
        IfCondition EqualTo(pt, ASTType.REST_ELEMENT) ThenBlock: {
            tgt = JSParse_GetLeft(save_p)
            ReturnValue(JSComp__AddPatternBindings(tgt))
        }

        // ASSIGN — target in N_RIGHT (pattern or ident), default expr in N_LEFT
        IfCondition EqualTo(pt, ASTType.ASSIGN) ThenBlock: {
            tgt2 = JSParse_GetRight(save_p)
            ReturnValue(JSComp__AddPatternBindings(tgt2))
        }

        // VAR_DECL used as binding sometimes
        IfCondition EqualTo(pt, ASTType.VAR_DECL) ThenBlock: {
            np2 = JSParse_GetNamePtr(save_p)
            nl2 = JSParse_GetNameLen(save_p)
            IfCondition GreaterThan(nl2, 0) ThenBlock: {
                existing2 = JSComp__FindLocalInScope(np2, nl2)
                IfCondition LessThan(existing2, 0) ThenBlock: {
                    JSComp__AddLocal(np2, nl2)
                    ReturnValue(1)
                }
            }
            ReturnValue(0)
        }

        ReturnValue(0)
    }
}

// Compile array destructuring pattern: [a, b, ...rest] = src
// src_slot = local slot holding the RHS value (an array or iterable)
// pat_node = ARRAY_PATTERN node whose N_LEFT is the first element
// Mole 15: uses GET_ITER/ITER_NEXT/ITER_CLOSE so elision steps once and
// generators / custom iterators work (not only array index access).
Function.JSComp__CompileArrayPattern {
    Input: pat_node: Integer
    Input: src_slot: Integer
    Output: Integer
    Body: {
        save_pat = pat_node
        save_src = src_slot

        // Temp for iterator record
        irec_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
        SetByte(irec_nm, 0, 95)
        SetByte(irec_nm, 1, 95)
        SetByte(irec_nm, 2, 105)
        SetByte(irec_nm, 3, 114)
        SetByte(irec_nm, 4, 95)
        SetByte(irec_nm, 5, 95)
        SetByte(irec_nm, 6, 0)
        JSCompState.str_pos = Add(JSCompState.str_pos, 7)
        JSComp__Push(save_src)
        irec_slot = JSComp__AddLocal(irec_nm, 6)
        save_src = JSComp__Pop()
        // Do not PUSH_UNDEF here — that orphans a stack slot (SET_LOCAL only
        // consumes the iterator). Locals are already reserved in the prologue.

        // irec = GET_ITER(src)
        JSComp__EmitOp16(JSOp.GET_LOCAL, save_src)
        JSComp__Emit1(JSOp.GET_ITER)
        JSComp__EmitOp16(JSOp.SET_LOCAL, irec_slot)

        // Track whether rest drains the iterator (no close needed after)
        has_rest = 0
        scan = JSParse_GetLeft(save_pat)
        WhileLoop GreaterEqual(scan, 0) {
            IfCondition EqualTo(JSParse_GetType(scan), ASTType.REST_ELEMENT) ThenBlock: {
                has_rest = 1
            }
            scan = JSParse_GetNext(scan)
        }

        // M20d: try around pattern body so throw → IteratorClose (thrw-close)
        exc_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
        SetByte(exc_nm, 0, 95)
        SetByte(exc_nm, 1, 95)
        SetByte(exc_nm, 2, 101)
        SetByte(exc_nm, 3, 120)
        SetByte(exc_nm, 4, 95)
        SetByte(exc_nm, 5, 95)
        SetByte(exc_nm, 6, 0)
        JSCompState.str_pos = Add(JSCompState.str_pos, 7)
        JSComp__Push(save_src)
        JSComp__Push(irec_slot)
        JSComp__Push(has_rest)
        exc_slot = JSComp__AddLocal(exc_nm, 6)
        has_rest = JSComp__Pop()
        irec_slot = JSComp__Pop()
        save_src = JSComp__Pop()
        try_push = JSCompState.code_pos
        JSComp__EmitOp16(JSOp.TRY_PUSH, 0)

        // Walk elements linked by N_NEXT
        elem = JSParse_GetLeft(save_pat)
        elem_idx = 0

        WhileLoop GreaterEqual(elem, 0) {
            etyp = JSParse_GetType(elem)

            // Elision hole: step iterator once, discard value (M52: ELISION; legacy NULL_LIT)
            IfCondition Or(EqualTo(etyp, ASTType.ELISION), EqualTo(etyp, ASTType.NULL_LIT)) ThenBlock: {
                JSComp__EmitOp16(JSOp.GET_LOCAL, irec_slot)
                JSComp__Emit1(JSOp.ITER_NEXT)
                JSComp__Emit1(JSOp.POP)
                JSComp__Emit1(JSOp.POP)
                elem_idx = Add(elem_idx, 1)
                elem = JSParse_GetNext(elem)
            }

            // REST_ELEMENT: ...rest — drain remaining iterator into array
            IfCondition EqualTo(etyp, ASTType.REST_ELEMENT) ThenBlock: {
                rest_target = JSParse_GetLeft(elem)
                rest_type = JSParse_GetType(rest_target)

                ra_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(ra_ptr, 0, 95)
                SetByte(ra_ptr, 1, 95)
                SetByte(ra_ptr, 2, 114)
                SetByte(ra_ptr, 3, 97)
                SetByte(ra_ptr, 4, 95)
                SetByte(ra_ptr, 5, 95)
                SetByte(ra_ptr, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)

                JSComp__Push(save_src)
                JSComp__Push(elem)
                JSComp__Push(elem_idx)
                JSComp__Push(irec_slot)
                ra_slot = JSComp__AddLocal(ra_ptr, 6)
                irec_slot = JSComp__Pop()
                elem_idx = JSComp__Pop()
                elem = JSComp__Pop()
                save_src = JSComp__Pop()

                // M20d rest: evaluate member LRef before drain (nextCount=0 on thrw)
                rest_base_slot = -1
                rest_key_slot = -1
                IfCondition EqualTo(rest_type, ASTType.MEMBER_BRACKET) ThenBlock: {
                    JSComp__Push(save_src)
                    JSComp__Push(elem)
                    JSComp__Push(elem_idx)
                    JSComp__Push(irec_slot)
                    JSComp__Push(exc_slot)
                    JSComp__Push(has_rest)
                    JSComp__Push(try_push)
                    JSComp__Push(ra_slot)
                    JSComp__CompileExpr(JSParse_GetLeft(rest_target))
                    ra_slot = JSComp__Pop()
                    try_push = JSComp__Pop()
                    has_rest = JSComp__Pop()
                    exc_slot = JSComp__Pop()
                    irec_slot = JSComp__Pop()
                    elem_idx = JSComp__Pop()
                    elem = JSComp__Pop()
                    save_src = JSComp__Pop()
                    rb_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
                    SetByte(rb_ptr, 0, 95)
                    SetByte(rb_ptr, 1, 95)
                    SetByte(rb_ptr, 2, 114)
                    SetByte(rb_ptr, 3, 98)
                    SetByte(rb_ptr, 4, 95)
                    SetByte(rb_ptr, 5, 95)
                    SetByte(rb_ptr, 6, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                    JSComp__Push(save_src)
                    JSComp__Push(elem)
                    JSComp__Push(elem_idx)
                    JSComp__Push(irec_slot)
                    JSComp__Push(exc_slot)
                    JSComp__Push(has_rest)
                    JSComp__Push(try_push)
                    JSComp__Push(ra_slot)
                    rest_base_slot = JSComp__AddLocal(rb_ptr, 6)
                    ra_slot = JSComp__Pop()
                    try_push = JSComp__Pop()
                    has_rest = JSComp__Pop()
                    exc_slot = JSComp__Pop()
                    irec_slot = JSComp__Pop()
                    elem_idx = JSComp__Pop()
                    elem = JSComp__Pop()
                    save_src = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_LOCAL, rest_base_slot)
                    JSComp__Push(save_src)
                    JSComp__Push(elem)
                    JSComp__Push(elem_idx)
                    JSComp__Push(irec_slot)
                    JSComp__Push(exc_slot)
                    JSComp__Push(has_rest)
                    JSComp__Push(try_push)
                    JSComp__Push(ra_slot)
                    JSComp__Push(rest_base_slot)
                    JSComp__CompileExpr(JSParse_GetRight(rest_target))
                    rest_base_slot = JSComp__Pop()
                    ra_slot = JSComp__Pop()
                    try_push = JSComp__Pop()
                    has_rest = JSComp__Pop()
                    exc_slot = JSComp__Pop()
                    irec_slot = JSComp__Pop()
                    elem_idx = JSComp__Pop()
                    elem = JSComp__Pop()
                    save_src = JSComp__Pop()
                    rk_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
                    SetByte(rk_ptr, 0, 95)
                    SetByte(rk_ptr, 1, 95)
                    SetByte(rk_ptr, 2, 114)
                    SetByte(rk_ptr, 3, 107)
                    SetByte(rk_ptr, 4, 95)
                    SetByte(rk_ptr, 5, 95)
                    SetByte(rk_ptr, 6, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                    JSComp__Push(save_src)
                    JSComp__Push(elem)
                    JSComp__Push(elem_idx)
                    JSComp__Push(irec_slot)
                    JSComp__Push(exc_slot)
                    JSComp__Push(has_rest)
                    JSComp__Push(try_push)
                    JSComp__Push(ra_slot)
                    JSComp__Push(rest_base_slot)
                    rest_key_slot = JSComp__AddLocal(rk_ptr, 6)
                    rest_base_slot = JSComp__Pop()
                    ra_slot = JSComp__Pop()
                    try_push = JSComp__Pop()
                    has_rest = JSComp__Pop()
                    exc_slot = JSComp__Pop()
                    irec_slot = JSComp__Pop()
                    elem_idx = JSComp__Pop()
                    elem = JSComp__Pop()
                    save_src = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_LOCAL, rest_key_slot)
                }
                IfCondition EqualTo(rest_type, ASTType.MEMBER_DOT) ThenBlock: {
                    JSComp__Push(save_src)
                    JSComp__Push(elem)
                    JSComp__Push(elem_idx)
                    JSComp__Push(irec_slot)
                    JSComp__Push(exc_slot)
                    JSComp__Push(has_rest)
                    JSComp__Push(try_push)
                    JSComp__Push(ra_slot)
                    JSComp__CompileExpr(JSParse_GetLeft(rest_target))
                    ra_slot = JSComp__Pop()
                    try_push = JSComp__Pop()
                    has_rest = JSComp__Pop()
                    exc_slot = JSComp__Pop()
                    irec_slot = JSComp__Pop()
                    elem_idx = JSComp__Pop()
                    elem = JSComp__Pop()
                    save_src = JSComp__Pop()
                    rb2 = Add(JSCompState.str_buf, JSCompState.str_pos)
                    SetByte(rb2, 0, 95)
                    SetByte(rb2, 1, 95)
                    SetByte(rb2, 2, 114)
                    SetByte(rb2, 3, 100)
                    SetByte(rb2, 4, 95)
                    SetByte(rb2, 5, 95)
                    SetByte(rb2, 6, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                    JSComp__Push(save_src)
                    JSComp__Push(elem)
                    JSComp__Push(elem_idx)
                    JSComp__Push(irec_slot)
                    JSComp__Push(exc_slot)
                    JSComp__Push(has_rest)
                    JSComp__Push(try_push)
                    JSComp__Push(ra_slot)
                    rest_base_slot = JSComp__AddLocal(rb2, 6)
                    ra_slot = JSComp__Pop()
                    try_push = JSComp__Pop()
                    has_rest = JSComp__Pop()
                    exc_slot = JSComp__Pop()
                    irec_slot = JSComp__Pop()
                    elem_idx = JSComp__Pop()
                    elem = JSComp__Pop()
                    save_src = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_LOCAL, rest_base_slot)
                }

                // NEW_ARRAY then SET_LOCAL — no orphan PUSH_UNDEF
                JSComp__EmitOp16(JSOp.NEW_ARRAY, 0)
                JSComp__EmitOp16(JSOp.SET_LOCAL, ra_slot)

                // Loop: while !done, next and append
                loop_top = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.GET_LOCAL, irec_slot)
                JSComp__Emit1(JSOp.ITER_NEXT)
                // stack: [value, done]
                loop_exit = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP_TRUE, 0)
                JSComp__EmitOp16(JSOp.GET_LOCAL, ra_slot)
                JSComp__Emit1(JSOp.SWAP)
                JSComp__Emit1(JSOp.ARR_APPEND)
                JSComp__Emit1(JSOp.POP)
                JSComp__EmitOp16(JSOp.JMP, loop_top)
                JSComp__PatchJump(loop_exit, JSCompState.code_pos)
                JSComp__Emit1(JSOp.POP)

                // Bind rest array
                IfCondition EqualTo(rest_type, ASTType.MEMBER_BRACKET) ThenBlock: {
                    JSComp__EmitOp16(JSOp.GET_LOCAL, ra_slot)
                    JSComp__EmitOp16(JSOp.GET_LOCAL, rest_base_slot)
                    JSComp__EmitOp16(JSOp.GET_LOCAL, rest_key_slot)
                    JSComp__Emit1(JSOp.SET_ELEM)
                }
                IfCondition EqualTo(rest_type, ASTType.MEMBER_DOT) ThenBlock: {
                    JSComp__EmitOp16(JSOp.GET_LOCAL, ra_slot)
                    JSComp__EmitOp16(JSOp.GET_LOCAL, rest_base_slot)
                    JSComp__Emit1(JSOp.SWAP)
                    rnp = JSParse_GetNamePtr(rest_target)
                    rnl = JSParse_GetNameLen(rest_target)
                    JSComp__Push(save_src)
                    JSComp__Push(elem)
                    JSComp__Push(irec_slot)
                    JSComp__Push(exc_slot)
                    JSComp__Push(has_rest)
                    JSComp__Push(try_push)
                    rci = JSComp__AddString(rnp, rnl)
                    try_push = JSComp__Pop()
                    has_rest = JSComp__Pop()
                    exc_slot = JSComp__Pop()
                    irec_slot = JSComp__Pop()
                    elem = JSComp__Pop()
                    save_src = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_PROP, rci)
                }
                IfCondition EqualTo(rest_type, ASTType.IDENT) ThenBlock: {
                    JSComp__EmitOp16(JSOp.GET_LOCAL, ra_slot)
                    JSComp__Push(save_src)
                    JSComp__Push(elem)
                    JSComp__Push(irec_slot)
                    JSComp__Push(exc_slot)
                    JSComp__Push(has_rest)
                    JSComp__Push(try_push)
                    JSComp__EmitDstrBind(rest_target)
                    try_push = JSComp__Pop()
                    has_rest = JSComp__Pop()
                    exc_slot = JSComp__Pop()
                    irec_slot = JSComp__Pop()
                    elem = JSComp__Pop()
                    save_src = JSComp__Pop()
                }

                IfCondition EqualTo(rest_type, ASTType.ARRAY_PATTERN) ThenBlock: {
                    JSComp__Push(save_src)
                    JSComp__Push(elem)
                    JSComp__Push(irec_slot)
                    JSComp__CompileArrayPattern(rest_target, ra_slot)
                    irec_slot = JSComp__Pop()
                    elem = JSComp__Pop()
                    save_src = JSComp__Pop()
                }
                IfCondition EqualTo(rest_type, ASTType.OBJECT_PATTERN) ThenBlock: {
                    JSComp__Push(save_src)
                    JSComp__Push(elem)
                    JSComp__Push(irec_slot)
                    JSComp__CompileObjPattern(rest_target, ra_slot)
                    irec_slot = JSComp__Pop()
                    elem = JSComp__Pop()
                    save_src = JSComp__Pop()
                }

                elem = -1
            }

            // ASSIGN: element with default value (N_RIGHT = target, N_LEFT = default)
            IfCondition EqualTo(etyp, ASTType.ASSIGN) ThenBlock: {
                target_nd = JSParse_GetRight(elem)
                def_nd = JSParse_GetLeft(elem)
                target_type = JSParse_GetType(target_nd)

                // One iterator step
                JSComp__EmitOp16(JSOp.GET_LOCAL, irec_slot)
                JSComp__Emit1(JSOp.ITER_NEXT)
                JSComp__Emit1(JSOp.POP)

                // Check if undefined, apply default
                JSComp__Emit1(JSOp.DUP)
                JSComp__Emit1(JSOp.PUSH_UNDEF)
                JSComp__Emit1(JSOp.STRICT_EQ)
                skip_def = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                JSComp__Emit1(JSOp.POP)
                JSComp__Push(save_src)
                JSComp__Push(elem)
                JSComp__Push(elem_idx)
                JSComp__Push(irec_slot)
                JSComp__CompileExpr(def_nd)
                irec_slot = JSComp__Pop()
                elem_idx = JSComp__Pop()
                elem = JSComp__Pop()
                save_src = JSComp__Pop()
                JSComp__PatchJump(skip_def, JSCompState.code_pos)

                // Bind to target
                IfCondition Or(EqualTo(target_type, ASTType.IDENT), Or(EqualTo(target_type, ASTType.MEMBER_DOT), EqualTo(target_type, ASTType.MEMBER_BRACKET))) ThenBlock: {
                    tnp = JSParse_GetNamePtr(target_nd)
                    tnl = JSParse_GetNameLen(target_nd)
                    JSComp__Push(save_src)
                    JSComp__Push(elem)
                    JSComp__Push(elem_idx)
                    JSComp__Push(irec_slot)
                    JSComp__EmitDstrBind(target_nd)
                    irec_slot = JSComp__Pop()
                    elem_idx = JSComp__Pop()
                    elem = JSComp__Pop()
                    save_src = JSComp__Pop()
                    // SetFunctionName for anonymous defaults
                    def_is_anon = 0
                    dft = JSParse_GetType(def_nd)
                    // Mole 15: also anonymous class expressions (class {})
                    IfCondition Or(EqualTo(dft, ASTType.FUNC_EXPR), Or(EqualTo(dft, ASTType.ARROW_EXPR), Or(EqualTo(dft, ASTType.GEN_FUNC_EXPR), EqualTo(dft, ASTType.CLASS_EXPR)))) ThenBlock: {
                        dfnl = JSParse_GetNameLen(def_nd)
                        IfCondition LessEqual(dfnl, 0) ThenBlock: {
                            def_is_anon = 1
                        }
                    }
                    IfCondition EqualTo(def_is_anon, 1) ThenBlock: {
                        bslot = JSComp__FindLocal(tnp, tnl)
                        // M48: local or global binding (var [fn=function(){}]=…)
                        IfCondition GreaterEqual(bslot, 0) ThenBlock: {
                            JSComp__EmitOp16(JSOp.GET_LOCAL, bslot)
                        } ElseBlock: {
                            JSComp__Push(save_src)
                            JSComp__Push(elem)
                            JSComp__Push(elem_idx)
                            JSComp__Push(irec_slot)
                            gci = JSComp__AddString(tnp, tnl)
                            irec_slot = JSComp__Pop()
                            elem_idx = JSComp__Pop()
                            elem = JSComp__Pop()
                            save_src = JSComp__Pop()
                            JSComp__EmitOp16(JSOp.GET_GLOBAL, gci)
                        }
                        // SetFunctionName only if .name is empty (don't clobber class static name)
                        JSComp__Emit1(JSOp.DUP)
                        name_key = Add(JSCompState.str_buf, JSCompState.str_pos)
                        SetByte(name_key, 0, 110)
                        SetByte(name_key, 1, 97)
                        SetByte(name_key, 2, 109)
                        SetByte(name_key, 3, 101)
                        SetByte(name_key, 4, 0)
                        JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                        JSComp__Push(save_src)
                        JSComp__Push(elem)
                        JSComp__Push(elem_idx)
                        JSComp__Push(irec_slot)
                        nkci = JSComp__AddString(name_key, 4)
                        irec_slot = JSComp__Pop()
                        elem_idx = JSComp__Pop()
                        elem = JSComp__Pop()
                        save_src = JSComp__Pop()
                        JSComp__EmitOp16(JSOp.GET_PROP, nkci)
                        JSComp__Emit1(JSOp.DUP)
                        empty_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                        SetByte(empty_nm, 0, 0)
                        JSCompState.str_pos = Add(JSCompState.str_pos, 1)
                        JSComp__Push(nkci)
                        empty_ci = JSComp__AddString(empty_nm, 0)
                        nkci = JSComp__Pop()
                        JSComp__EmitOp16(JSOp.PUSH_CONST, empty_ci)
                        JSComp__Emit1(JSOp.STRICT_EQ)
                        skip_nm = JSCompState.code_pos
                        JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                        // name empty → define binding name
                        JSComp__Emit1(JSOp.POP)
                        JSComp__Push(save_src)
                        JSComp__Push(elem)
                        JSComp__Push(elem_idx)
                        JSComp__Push(irec_slot)
                        JSComp__Push(skip_nm)
                        nci = JSComp__AddString(tnp, tnl)
                        skip_nm = JSComp__Pop()
                        irec_slot = JSComp__Pop()
                        elem_idx = JSComp__Pop()
                        elem = JSComp__Pop()
                        save_src = JSComp__Pop()
                        JSComp__EmitOp16(JSOp.PUSH_CONST, nci)
                        JSComp__EmitOp16(JSOp.SET_PROP, nkci)
                        skip_nm_end = JSCompState.code_pos
                        JSComp__EmitOp16(JSOp.JMP, 0)
                        JSComp__PatchJump(skip_nm)
                        // name already set — discard func and name value
                        JSComp__Emit1(JSOp.POP)
                        JSComp__Emit1(JSOp.POP)
                        JSComp__PatchJump(skip_nm_end)
                    }
                } ElseBlock: {
                    IfCondition EqualTo(target_type, ASTType.ARRAY_PATTERN) ThenBlock: {
                        tmp_nm_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
                        SetByte(tmp_nm_ptr, 0, 95)
                        SetByte(tmp_nm_ptr, 1, 95)
                        SetByte(tmp_nm_ptr, 2, 100)
                        SetByte(tmp_nm_ptr, 3, Add(48, elem_idx))
                        SetByte(tmp_nm_ptr, 4, 95)
                        SetByte(tmp_nm_ptr, 5, 95)
                        SetByte(tmp_nm_ptr, 6, 0)
                        JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                        JSComp__Push(save_src)
                        JSComp__Push(elem)
                        JSComp__Push(elem_idx)
                        JSComp__Push(irec_slot)
                        nsub_slot = JSComp__AddLocal(tmp_nm_ptr, 6)
                        JSComp__Emit1(JSOp.PUSH_UNDEF)
                        JSComp__Emit1(JSOp.SWAP)
                        JSComp__EmitOp16(JSOp.SET_LOCAL, nsub_slot)
                        JSComp__Emit1(JSOp.POP)
                        JSComp__CompileArrayPattern(target_nd, nsub_slot)
                        irec_slot = JSComp__Pop()
                        elem_idx = JSComp__Pop()
                        elem = JSComp__Pop()
                        save_src = JSComp__Pop()
                    } ElseBlock: {
                        IfCondition EqualTo(target_type, ASTType.OBJECT_PATTERN) ThenBlock: {
                            tmp_nm_ptr2 = Add(JSCompState.str_buf, JSCompState.str_pos)
                            SetByte(tmp_nm_ptr2, 0, 95)
                            SetByte(tmp_nm_ptr2, 1, 95)
                            SetByte(tmp_nm_ptr2, 2, 111)
                            SetByte(tmp_nm_ptr2, 3, Add(48, elem_idx))
                            SetByte(tmp_nm_ptr2, 4, 95)
                            SetByte(tmp_nm_ptr2, 5, 95)
                            SetByte(tmp_nm_ptr2, 6, 0)
                            JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                            JSComp__Push(save_src)
                            JSComp__Push(elem)
                            JSComp__Push(elem_idx)
                            JSComp__Push(irec_slot)
                            osub_slot = JSComp__AddLocal(tmp_nm_ptr2, 6)
                            JSComp__Emit1(JSOp.PUSH_UNDEF)
                            JSComp__Emit1(JSOp.SWAP)
                            JSComp__EmitOp16(JSOp.SET_LOCAL, osub_slot)
                            JSComp__Emit1(JSOp.POP)
                            JSComp__CompileObjPattern(target_nd, osub_slot)
                            irec_slot = JSComp__Pop()
                            elem_idx = JSComp__Pop()
                            elem = JSComp__Pop()
                            save_src = JSComp__Pop()
                        }
                    }
                }

                elem_idx = Add(elem_idx, 1)
                elem = JSParse_GetNext(elem)
            }

            // IDENT or member target — Spec: evaluate LRef before IteratorStep
            // so {}[thrower()] throws before next() and IteratorClose runs.
            IfCondition EqualTo(etyp, ASTType.IDENT) ThenBlock: {
                JSComp__EmitOp16(JSOp.GET_LOCAL, irec_slot)
                JSComp__Emit1(JSOp.ITER_NEXT)
                JSComp__Emit1(JSOp.POP)
                JSComp__Push(save_src)
                JSComp__Push(elem)
                JSComp__Push(elem_idx)
                JSComp__Push(irec_slot)
                JSComp__Push(exc_slot)
                JSComp__Push(has_rest)
                JSComp__Push(try_push)
                JSComp__EmitDstrBind(elem)
                try_push = JSComp__Pop()
                has_rest = JSComp__Pop()
                exc_slot = JSComp__Pop()
                irec_slot = JSComp__Pop()
                elem_idx = JSComp__Pop()
                elem = JSComp__Pop()
                save_src = JSComp__Pop()
                elem_idx = Add(elem_idx, 1)
                elem = JSParse_GetNext(elem)
            }

            IfCondition EqualTo(etyp, ASTType.MEMBER_BRACKET) ThenBlock: {
                // LRef first: obj, key (thrower runs here, nextCount stays 0)
                JSComp__Push(save_src)
                JSComp__Push(elem)
                JSComp__Push(elem_idx)
                JSComp__Push(irec_slot)
                JSComp__Push(exc_slot)
                JSComp__Push(has_rest)
                JSComp__Push(try_push)
                JSComp__CompileExpr(JSParse_GetLeft(elem))
                try_push = JSComp__Pop()
                has_rest = JSComp__Pop()
                exc_slot = JSComp__Pop()
                irec_slot = JSComp__Pop()
                elem_idx = JSComp__Pop()
                elem = JSComp__Pop()
                save_src = JSComp__Pop()
                mb_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(mb_ptr, 0, 95)
                SetByte(mb_ptr, 1, 95)
                SetByte(mb_ptr, 2, 109)
                SetByte(mb_ptr, 3, 98)
                SetByte(mb_ptr, 4, Add(48, elem_idx))
                SetByte(mb_ptr, 5, 95)
                SetByte(mb_ptr, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                JSComp__Push(save_src)
                JSComp__Push(elem)
                JSComp__Push(elem_idx)
                JSComp__Push(irec_slot)
                JSComp__Push(exc_slot)
                JSComp__Push(has_rest)
                JSComp__Push(try_push)
                mb_slot = JSComp__AddLocal(mb_ptr, 6)
                try_push = JSComp__Pop()
                has_rest = JSComp__Pop()
                exc_slot = JSComp__Pop()
                irec_slot = JSComp__Pop()
                elem_idx = JSComp__Pop()
                elem = JSComp__Pop()
                save_src = JSComp__Pop()
                JSComp__EmitOp16(JSOp.SET_LOCAL, mb_slot)
                JSComp__Push(save_src)
                JSComp__Push(elem)
                JSComp__Push(elem_idx)
                JSComp__Push(irec_slot)
                JSComp__Push(exc_slot)
                JSComp__Push(has_rest)
                JSComp__Push(try_push)
                JSComp__Push(mb_slot)
                JSComp__CompileExpr(JSParse_GetRight(elem))
                mb_slot = JSComp__Pop()
                try_push = JSComp__Pop()
                has_rest = JSComp__Pop()
                exc_slot = JSComp__Pop()
                irec_slot = JSComp__Pop()
                elem_idx = JSComp__Pop()
                elem = JSComp__Pop()
                save_src = JSComp__Pop()
                mk_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(mk_ptr, 0, 95)
                SetByte(mk_ptr, 1, 95)
                SetByte(mk_ptr, 2, 109)
                SetByte(mk_ptr, 3, 107)
                SetByte(mk_ptr, 4, Add(48, elem_idx))
                SetByte(mk_ptr, 5, 95)
                SetByte(mk_ptr, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                JSComp__Push(save_src)
                JSComp__Push(elem)
                JSComp__Push(elem_idx)
                JSComp__Push(irec_slot)
                JSComp__Push(exc_slot)
                JSComp__Push(has_rest)
                JSComp__Push(try_push)
                JSComp__Push(mb_slot)
                mk_slot = JSComp__AddLocal(mk_ptr, 6)
                mb_slot = JSComp__Pop()
                try_push = JSComp__Pop()
                has_rest = JSComp__Pop()
                exc_slot = JSComp__Pop()
                irec_slot = JSComp__Pop()
                elem_idx = JSComp__Pop()
                elem = JSComp__Pop()
                save_src = JSComp__Pop()
                JSComp__EmitOp16(JSOp.SET_LOCAL, mk_slot)
                // IteratorStep
                JSComp__EmitOp16(JSOp.GET_LOCAL, irec_slot)
                JSComp__Emit1(JSOp.ITER_NEXT)
                JSComp__Emit1(JSOp.POP)
                // SET_ELEM wants [value, obj, key]
                JSComp__EmitOp16(JSOp.GET_LOCAL, mb_slot)
                JSComp__EmitOp16(JSOp.GET_LOCAL, mk_slot)
                JSComp__Emit1(JSOp.SET_ELEM)
                elem_idx = Add(elem_idx, 1)
                elem = JSParse_GetNext(elem)
            }

            IfCondition EqualTo(etyp, ASTType.MEMBER_DOT) ThenBlock: {
                JSComp__Push(save_src)
                JSComp__Push(elem)
                JSComp__Push(elem_idx)
                JSComp__Push(irec_slot)
                JSComp__Push(exc_slot)
                JSComp__Push(has_rest)
                JSComp__Push(try_push)
                JSComp__CompileExpr(JSParse_GetLeft(elem))
                try_push = JSComp__Pop()
                has_rest = JSComp__Pop()
                exc_slot = JSComp__Pop()
                irec_slot = JSComp__Pop()
                elem_idx = JSComp__Pop()
                elem = JSComp__Pop()
                save_src = JSComp__Pop()
                md_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(md_ptr, 0, 95)
                SetByte(md_ptr, 1, 95)
                SetByte(md_ptr, 2, 109)
                SetByte(md_ptr, 3, 100)
                SetByte(md_ptr, 4, Add(48, elem_idx))
                SetByte(md_ptr, 5, 95)
                SetByte(md_ptr, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                JSComp__Push(save_src)
                JSComp__Push(elem)
                JSComp__Push(elem_idx)
                JSComp__Push(irec_slot)
                JSComp__Push(exc_slot)
                JSComp__Push(has_rest)
                JSComp__Push(try_push)
                md_slot = JSComp__AddLocal(md_ptr, 6)
                try_push = JSComp__Pop()
                has_rest = JSComp__Pop()
                exc_slot = JSComp__Pop()
                irec_slot = JSComp__Pop()
                elem_idx = JSComp__Pop()
                elem = JSComp__Pop()
                save_src = JSComp__Pop()
                JSComp__EmitOp16(JSOp.SET_LOCAL, md_slot)
                JSComp__EmitOp16(JSOp.GET_LOCAL, irec_slot)
                JSComp__Emit1(JSOp.ITER_NEXT)
                JSComp__Emit1(JSOp.POP)
                // SET_PROP wants [obj, value]
                JSComp__EmitOp16(JSOp.GET_LOCAL, md_slot)
                JSComp__Emit1(JSOp.SWAP)
                mnp = JSParse_GetNamePtr(elem)
                mnl = JSParse_GetNameLen(elem)
                JSComp__Push(save_src)
                JSComp__Push(elem)
                JSComp__Push(elem_idx)
                JSComp__Push(irec_slot)
                JSComp__Push(exc_slot)
                JSComp__Push(has_rest)
                JSComp__Push(try_push)
                mci = JSComp__AddString(mnp, mnl)
                try_push = JSComp__Pop()
                has_rest = JSComp__Pop()
                exc_slot = JSComp__Pop()
                irec_slot = JSComp__Pop()
                elem_idx = JSComp__Pop()
                elem = JSComp__Pop()
                save_src = JSComp__Pop()
                JSComp__EmitOp16(JSOp.SET_PROP, mci)
                elem_idx = Add(elem_idx, 1)
                elem = JSParse_GetNext(elem)
            }

            // Nested ARRAY_PATTERN
            IfCondition EqualTo(etyp, ASTType.ARRAY_PATTERN) ThenBlock: {
                JSComp__EmitOp16(JSOp.GET_LOCAL, irec_slot)
                JSComp__Emit1(JSOp.ITER_NEXT)
                JSComp__Emit1(JSOp.POP)

                tmp_nm3 = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(tmp_nm3, 0, 95)
                SetByte(tmp_nm3, 1, 95)
                SetByte(tmp_nm3, 2, 97)
                SetByte(tmp_nm3, 3, Add(48, elem_idx))
                SetByte(tmp_nm3, 4, 95)
                SetByte(tmp_nm3, 5, 95)
                SetByte(tmp_nm3, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                JSComp__Push(save_src)
                JSComp__Push(elem)
                JSComp__Push(elem_idx)
                JSComp__Push(irec_slot)
                sub_slot = JSComp__AddLocal(tmp_nm3, 6)
                JSComp__Emit1(JSOp.PUSH_UNDEF)
                JSComp__Emit1(JSOp.SWAP)
                JSComp__EmitOp16(JSOp.SET_LOCAL, sub_slot)
                JSComp__Emit1(JSOp.POP)
                JSComp__CompileArrayPattern(elem, sub_slot)
                irec_slot = JSComp__Pop()
                elem_idx = JSComp__Pop()
                elem = JSComp__Pop()
                save_src = JSComp__Pop()

                elem_idx = Add(elem_idx, 1)
                elem = JSParse_GetNext(elem)
            }

            // Nested OBJECT_PATTERN
            IfCondition EqualTo(etyp, ASTType.OBJECT_PATTERN) ThenBlock: {
                JSComp__EmitOp16(JSOp.GET_LOCAL, irec_slot)
                JSComp__Emit1(JSOp.ITER_NEXT)
                JSComp__Emit1(JSOp.POP)

                tmp_nm4 = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(tmp_nm4, 0, 95)
                SetByte(tmp_nm4, 1, 95)
                SetByte(tmp_nm4, 2, 111)
                SetByte(tmp_nm4, 3, Add(48, elem_idx))
                SetByte(tmp_nm4, 4, 95)
                SetByte(tmp_nm4, 5, 95)
                SetByte(tmp_nm4, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                JSComp__Push(save_src)
                JSComp__Push(elem)
                JSComp__Push(elem_idx)
                JSComp__Push(irec_slot)
                osub_slot2 = JSComp__AddLocal(tmp_nm4, 6)
                JSComp__Emit1(JSOp.PUSH_UNDEF)
                JSComp__Emit1(JSOp.SWAP)
                JSComp__EmitOp16(JSOp.SET_LOCAL, osub_slot2)
                JSComp__Emit1(JSOp.POP)
                JSComp__CompileObjPattern(elem, osub_slot2)
                irec_slot = JSComp__Pop()
                elem_idx = JSComp__Pop()
                elem = JSComp__Pop()
                save_src = JSComp__Pop()

                elem_idx = Add(elem_idx, 1)
                elem = JSParse_GetNext(elem)
            }
        }

        // Normal path: pop try handler, close if rest did not drain
        JSComp__Emit1(JSOp.TRY_POP)
        IfCondition EqualTo(has_rest, 0) ThenBlock: {
            JSComp__EmitOp16(JSOp.GET_LOCAL, irec_slot)
            JSComp__EmitOp16(JSOp.ITER_CLOSE, 0)
        }
        jmp_dstr_end = JSCompState.code_pos
        JSComp__EmitOp16(JSOp.JMP, 0)

        // Catch: IteratorClose with throw completion, rethrow original
        JSComp__PatchJump(try_push)
        // stack: [exc]
        JSComp__EmitOp16(JSOp.SET_LOCAL, exc_slot)
        JSComp__EmitOp16(JSOp.GET_LOCAL, irec_slot)
        JSComp__EmitOp16(JSOp.ITER_CLOSE, 1)
        JSComp__EmitOp16(JSOp.GET_LOCAL, exc_slot)
        JSComp__Emit1(JSOp.THROW)
        JSComp__PatchJump(jmp_dstr_end)
        ReturnValue(0)
    }
}

// Compile object destructuring pattern: {a, b: c} = src
// src_slot = local slot holding the RHS value (an object)
// pat_node = OBJECT_PATTERN node whose N_LEFT is the first PROPERTY
Function.JSComp__CompileObjPattern {
    Input: pat_node: Integer
    Input: src_slot: Integer
    Output: Integer
    Body: {
        save_pat = pat_node
        save_src = src_slot

        // Mole 13: null/undefined → TypeError (RequireObjectCoercible)
        JSComp__EmitOp16(JSOp.GET_LOCAL, save_src)
        JSComp__Emit1(JSOp.DUP)
        JSComp__Emit1(JSOp.PUSH_NULL)
        JSComp__Emit1(JSOp.STRICT_EQ)
        not_null = JSCompState.code_pos
        JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
        JSComp__Emit1(JSOp.POP)
        // throw TypeError — reuse THROW_TDZ-style typed error via null.x pattern:
        // emit PUSH_NULL; GET_PROP "x" which throws TypeError for null base
        JSComp__Emit1(JSOp.PUSH_NULL)
        bad_key = Add(JSCompState.str_buf, JSCompState.str_pos)
        SetByte(bad_key, 0, 120)
        SetByte(bad_key, 1, 0)
        JSCompState.str_pos = Add(JSCompState.str_pos, 2)
        JSComp__Push(save_src)
        bkci = JSComp__AddString(bad_key, 1)
        save_src = JSComp__Pop()
        JSComp__EmitOp16(JSOp.GET_PROP, bkci)
        JSComp__Emit1(JSOp.POP)
        JSComp__PatchJump(not_null, JSCompState.code_pos)
        // also reject undefined
        JSComp__Emit1(JSOp.DUP)
        JSComp__Emit1(JSOp.PUSH_UNDEF)
        JSComp__Emit1(JSOp.STRICT_EQ)
        not_undef = JSCompState.code_pos
        JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
        JSComp__Emit1(JSOp.POP)
        JSComp__Emit1(JSOp.PUSH_NULL)
        JSComp__Push(save_src)
        bkci2 = JSComp__AddString(bad_key, 1)
        save_src = JSComp__Pop()
        JSComp__EmitOp16(JSOp.GET_PROP, bkci2)
        JSComp__Emit1(JSOp.POP)
        JSComp__PatchJump(not_undef, JSCompState.code_pos)
        JSComp__Emit1(JSOp.POP)

        // Walk properties linked by N_NEXT
        prop = JSParse_GetLeft(save_pat)

        WhileLoop GreaterEqual(prop, 0) {
            ptyp = JSParse_GetType(prop)

            // REST_ELEMENT: ...rest — CopyDataProperties excluding already-bound keys
            // Mole 13: build rest object = { ...src } then delete each prior key.
            IfCondition EqualTo(ptyp, ASTType.REST_ELEMENT) ThenBlock: {
                rest_tgt = JSParse_GetLeft(prop)
                rest_tt = JSParse_GetType(rest_tgt)

                // rest = {}
                JSComp__Emit1(JSOp.NEW_OBJECT)
                // Copy all enumerable from src via OBJ_SPREAD: stack [rest, src] → rest mutated
                JSComp__Emit1(JSOp.DUP)
                JSComp__EmitOp16(JSOp.GET_LOCAL, save_src)
                JSComp__Emit1(JSOp.OBJ_SPREAD)

                // Delete each already-extracted property name from rest.
                // Walk props from pattern start until this REST node.
                excl = JSParse_GetLeft(save_pat)
                WhileLoop And(GreaterEqual(excl, 0), NotEqual(excl, prop)) {
                    et = JSParse_GetType(excl)
                    IfCondition EqualTo(et, ASTType.PROPERTY) ThenBlock: {
                        enp = JSParse_GetNamePtr(excl)
                        enl = JSParse_GetNameLen(excl)
                        IfCondition GreaterThan(enl, 0) ThenBlock: {
                            // rest already on stack; DUP, push key string, DELETE_PROP, POP bool
                            JSComp__Emit1(JSOp.DUP)
                            JSComp__Push(save_src)
                            JSComp__Push(prop)
                            JSComp__Push(excl)
                            eci = JSComp__AddString(enp, enl)
                            excl = JSComp__Pop()
                            prop = JSComp__Pop()
                            save_src = JSComp__Pop()
                            JSComp__EmitOp16(JSOp.PUSH_CONST, eci)
                            JSComp__Emit1(JSOp.DELETE_PROP)
                            JSComp__Emit1(JSOp.POP)
                        }
                    }
                    excl = JSParse_GetNext(excl)
                }

                // Bind rest object to IDENT / member / nested pattern
                IfCondition Or(EqualTo(rest_tt, ASTType.IDENT), Or(EqualTo(rest_tt, ASTType.MEMBER_DOT), EqualTo(rest_tt, ASTType.MEMBER_BRACKET))) ThenBlock: {
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    JSComp__EmitDstrBind(rest_tgt)
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                } ElseBlock: {
                    // Pattern rest target rare; store temp and recurse
                    rtmp = Add(JSCompState.str_buf, JSCompState.str_pos)
                    SetByte(rtmp, 0, 95)
                    SetByte(rtmp, 1, 95)
                    SetByte(rtmp, 2, 114)
                    SetByte(rtmp, 3, 115)
                    SetByte(rtmp, 4, 95)
                    SetByte(rtmp, 5, 95)
                    SetByte(rtmp, 6, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    rs = JSComp__AddLocal(rtmp, 6)
                    JSComp__Emit1(JSOp.PUSH_UNDEF)
                    JSComp__Emit1(JSOp.SWAP)
                    JSComp__EmitOp16(JSOp.SET_LOCAL, rs)
                    JSComp__Emit1(JSOp.POP)
                    IfCondition EqualTo(rest_tt, ASTType.OBJECT_PATTERN) ThenBlock: {
                        JSComp__CompileObjPattern(rest_tgt, rs)
                    }
                    IfCondition EqualTo(rest_tt, ASTType.ARRAY_PATTERN) ThenBlock: {
                        JSComp__CompileArrayPattern(rest_tgt, rs)
                    }
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                }
                prop = -1
            }

            // PROPERTY: {key: binding} or {key} (shorthand) or {[expr]: binding}
            IfCondition EqualTo(ptyp, ASTType.PROPERTY) ThenBlock: {
                // Get property from source: src.key
                // Numeric keys (e.g. {0: v} on arrays) must use GET_ELEM —
                // arrays store elements in XArray, not as string props.
                // Computed keys: evaluate expr first (may throw — Mole 15).
                JSComp__EmitOp16(JSOp.GET_LOCAL, save_src)
                comp_k = JSParse_GetCond(prop)
                IfCondition GreaterEqual(comp_k, 0) ThenBlock: {
                    // src already on stack; compile key; GET_ELEM
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    JSComp__CompileExpr(comp_k)
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                    JSComp__Emit1(JSOp.GET_ELEM)
                } ElseBlock: {
                pnp = JSParse_GetNamePtr(prop)
                pnl = JSParse_GetNameLen(prop)
                is_num_key = 0
                num_key_val = 0
                IfCondition GreaterThan(pnl, 0) ThenBlock: {
                    is_num_key = 1
                    ni = 0
                    WhileLoop LessThan(ni, pnl) {
                        ch = GetByte(pnp, ni)
                        IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                            is_num_key = 0
                        }
                        IfCondition EqualTo(is_num_key, 1) ThenBlock: {
                            num_key_val = Add(Multiply(num_key_val, 10), Subtract(ch, 48))
                        }
                        ni = Add(ni, 1)
                    }
                }
                IfCondition EqualTo(is_num_key, 1) ThenBlock: {
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    nki = JSComp__AddNumber(num_key_val)
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.PUSH_CONST, nki)
                    JSComp__Emit1(JSOp.GET_ELEM)
                } ElseBlock: {
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    pci = JSComp__AddString(pnp, pnl)
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.GET_PROP, pci)
                }
                } // end non-computed key

                // Check for default value (N_RIGHT of PROPERTY)
                def_nd2 = JSParse_GetRight(prop)
                IfCondition GreaterEqual(def_nd2, 0) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    JSComp__Emit1(JSOp.PUSH_UNDEF)
                    JSComp__Emit1(JSOp.STRICT_EQ)
                    skip_def2 = JSCompState.code_pos
                    JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                    JSComp__Emit1(JSOp.POP)
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    JSComp__CompileExpr(def_nd2)
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                    JSComp__PatchJump(skip_def2, JSCompState.code_pos)
                }

                // Get the binding target from N_LEFT
                binding_nd = JSParse_GetLeft(prop)
                btype = JSParse_GetType(binding_nd)

                IfCondition Or(EqualTo(btype, ASTType.IDENT), Or(EqualTo(btype, ASTType.MEMBER_DOT), EqualTo(btype, ASTType.MEMBER_BRACKET))) ThenBlock: {
                    bnp = JSParse_GetNamePtr(binding_nd)
                    bnl = JSParse_GetNameLen(binding_nd)
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    JSComp__EmitDstrBind(binding_nd)
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                    // Mole 13: SetFunctionName for {fn = function(){}}
                    IfCondition And(EqualTo(btype, ASTType.IDENT), GreaterEqual(def_nd2, 0)) ThenBlock: {
                        dft2 = JSParse_GetType(def_nd2)
                        dfnl2 = 0
                        IfCondition Or(EqualTo(dft2, ASTType.FUNC_EXPR), Or(EqualTo(dft2, ASTType.ARROW_EXPR), Or(EqualTo(dft2, ASTType.GEN_FUNC_EXPR), EqualTo(dft2, ASTType.CLASS_EXPR)))) ThenBlock: {
                            dfnl2 = JSParse_GetNameLen(def_nd2)
                        }
                        IfCondition EqualTo(dfnl2, 0) ThenBlock: {
                            IfCondition Or(EqualTo(dft2, ASTType.FUNC_EXPR), Or(EqualTo(dft2, ASTType.ARROW_EXPR), Or(EqualTo(dft2, ASTType.GEN_FUNC_EXPR), EqualTo(dft2, ASTType.CLASS_EXPR)))) ThenBlock: {
                                bslot2 = JSComp__FindLocal(bnp, bnl)
                                // M48: local or global {fn = function(){}}
                                IfCondition GreaterEqual(bslot2, 0) ThenBlock: {
                                    JSComp__EmitOp16(JSOp.GET_LOCAL, bslot2)
                                } ElseBlock: {
                                    JSComp__Push(save_src)
                                    JSComp__Push(prop)
                                    gci2 = JSComp__AddString(bnp, bnl)
                                    prop = JSComp__Pop()
                                    save_src = JSComp__Pop()
                                    JSComp__EmitOp16(JSOp.GET_GLOBAL, gci2)
                                }
                                // Only set .name if currently empty
                                JSComp__Emit1(JSOp.DUP)
                                name_key2 = Add(JSCompState.str_buf, JSCompState.str_pos)
                                SetByte(name_key2, 0, 110)
                                SetByte(name_key2, 1, 97)
                                SetByte(name_key2, 2, 109)
                                SetByte(name_key2, 3, 101)
                                SetByte(name_key2, 4, 0)
                                JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                                JSComp__Push(save_src)
                                JSComp__Push(prop)
                                nkci2 = JSComp__AddString(name_key2, 4)
                                prop = JSComp__Pop()
                                save_src = JSComp__Pop()
                                JSComp__EmitOp16(JSOp.GET_PROP, nkci2)
                                JSComp__Emit1(JSOp.DUP)
                                empty_nm2 = Add(JSCompState.str_buf, JSCompState.str_pos)
                                SetByte(empty_nm2, 0, 0)
                                JSCompState.str_pos = Add(JSCompState.str_pos, 1)
                                JSComp__Push(nkci2)
                                empty_ci2 = JSComp__AddString(empty_nm2, 0)
                                nkci2 = JSComp__Pop()
                                JSComp__EmitOp16(JSOp.PUSH_CONST, empty_ci2)
                                JSComp__Emit1(JSOp.STRICT_EQ)
                                skip_nm2 = JSCompState.code_pos
                                JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                                JSComp__Emit1(JSOp.POP)
                                JSComp__Push(save_src)
                                JSComp__Push(prop)
                                JSComp__Push(skip_nm2)
                                nci2 = JSComp__AddString(bnp, bnl)
                                skip_nm2 = JSComp__Pop()
                                prop = JSComp__Pop()
                                save_src = JSComp__Pop()
                                JSComp__EmitOp16(JSOp.PUSH_CONST, nci2)
                                JSComp__EmitOp16(JSOp.SET_PROP, nkci2)
                                skip_nm2_end = JSCompState.code_pos
                                JSComp__EmitOp16(JSOp.JMP, 0)
                                JSComp__PatchJump(skip_nm2)
                                JSComp__Emit1(JSOp.POP)
                                JSComp__Emit1(JSOp.POP)
                                JSComp__PatchJump(skip_nm2_end)
                            }
                        }
                    }
                } ElseBlock: {
                    IfCondition EqualTo(btype, ASTType.ARRAY_PATTERN) ThenBlock: {
                        tmp_nm5 = Add(JSCompState.str_buf, JSCompState.str_pos)
                        SetByte(tmp_nm5, 0, 95)
                        SetByte(tmp_nm5, 1, 95)
                        SetByte(tmp_nm5, 2, 112)
                        SetByte(tmp_nm5, 3, 95)
                        SetByte(tmp_nm5, 4, 95)
                        SetByte(tmp_nm5, 5, 0)
                        JSCompState.str_pos = Add(JSCompState.str_pos, 6)
                        JSComp__Push(save_src)
                        JSComp__Push(prop)
                        asub_slot = JSComp__AddLocal(tmp_nm5, 5)
                        JSComp__Emit1(JSOp.PUSH_UNDEF)
                        JSComp__Emit1(JSOp.SWAP)
                        JSComp__EmitOp16(JSOp.SET_LOCAL, asub_slot)
                        JSComp__Emit1(JSOp.POP)
                        JSComp__CompileArrayPattern(binding_nd, asub_slot)
                        prop = JSComp__Pop()
                        save_src = JSComp__Pop()
                    } ElseBlock: {
                        IfCondition EqualTo(btype, ASTType.OBJECT_PATTERN) ThenBlock: {
                            tmp_nm6 = Add(JSCompState.str_buf, JSCompState.str_pos)
                            SetByte(tmp_nm6, 0, 95)
                            SetByte(tmp_nm6, 1, 95)
                            SetByte(tmp_nm6, 2, 113)
                            SetByte(tmp_nm6, 3, 95)
                            SetByte(tmp_nm6, 4, 95)
                            SetByte(tmp_nm6, 5, 0)
                            JSCompState.str_pos = Add(JSCompState.str_pos, 6)
                            JSComp__Push(save_src)
                            JSComp__Push(prop)
                            osub_slot3 = JSComp__AddLocal(tmp_nm6, 5)
                            JSComp__Emit1(JSOp.PUSH_UNDEF)
                            JSComp__Emit1(JSOp.SWAP)
                            JSComp__EmitOp16(JSOp.SET_LOCAL, osub_slot3)
                            JSComp__Emit1(JSOp.POP)
                            JSComp__CompileObjPattern(binding_nd, osub_slot3)
                            prop = JSComp__Pop()
                            save_src = JSComp__Pop()
                        }
                    }
                }

                prop = JSParse_GetNext(prop)
            }
        }
        ReturnValue(0)
    }
}
