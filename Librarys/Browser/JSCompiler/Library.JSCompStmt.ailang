// Library.JSCompStmt.ailang — Statement/declaration compilation
// Split from Library.JSCompiler.ailang. FixedPools declared in root file.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// =============================================================================
// AST WALKING — COMPILE STATEMENTS
// =============================================================================

// ---------------------------------------------------------------------------
// Compile a single AST node (statement or declaration)
// ---------------------------------------------------------------------------
Function.JSComp__CompileNode {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node
        IfCondition EqualTo(JSCompState.error, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(save_node, 0) ThenBlock: { ReturnValue(-1) }

        ntype = JSParse_GetType(save_node)

        // --- PROGRAM ---
        IfCondition EqualTo(ntype, ASTType.PROGRAM) ThenBlock: {
            JSComp__CompileProgram(save_node)
            ReturnValue(0)
        }

        // --- BLOCK ---
        IfCondition EqualTo(ntype, ASTType.BLOCK) ThenBlock: {
            JSComp__CompileBlock(save_node)
            ReturnValue(0)
        }

        // --- VAR_DECL ---
        IfCondition EqualTo(ntype, ASTType.VAR_DECL) ThenBlock: {
            // Check for destructuring pattern in N_RIGHT
            pat = JSParse_GetRight(save_node)
            IfCondition GreaterEqual(pat, 0) ThenBlock: {
                // Destructuring: compile RHS, store in temp, then compile pattern
                init = JSParse_GetLeft(save_node)

                JSComp__Push(save_node)
                JSComp__Push(pat)
                JSComp__CompileExpr(init)
                pat = JSComp__Pop()
                save_node = JSComp__Pop()

                // Store RHS in a temporary local
                dt_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                // __dt__ = 6 bytes: 95,95,100,116,95,95
                SetByte(dt_nm, 0, 95)
                SetByte(dt_nm, 1, 95)
                SetByte(dt_nm, 2, 100)
                SetByte(dt_nm, 3, 116)
                SetByte(dt_nm, 4, 95)
                SetByte(dt_nm, 5, 95)
                SetByte(dt_nm, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)

                JSComp__Push(save_node)
                JSComp__Push(pat)
                dt_slot = JSComp__AddLocal(dt_nm, 6)
                pat = JSComp__Pop()
                save_node = JSComp__Pop()

                JSComp__EmitOp16(JSOp.SET_LOCAL, dt_slot)

                // Dispatch on pattern type
                pat_type = JSParse_GetType(pat)
                IfCondition EqualTo(pat_type, ASTType.ARRAY_PATTERN) ThenBlock: {
                    JSComp__CompileArrayPattern(pat, dt_slot)
                } ElseBlock: {
                    IfCondition EqualTo(pat_type, ASTType.OBJECT_PATTERN) ThenBlock: {
                        JSComp__CompileObjPattern(pat, dt_slot)
                    }
                }
                ReturnValue(0)
            }

            np = JSParse_GetNamePtr(save_node)
            nl = JSParse_GetNameLen(save_node)

            // Check if already pre-declared (TDZ hoisting for let/const)
            slot = JSComp__FindLocalInScope(np, nl)
            IfCondition LessThan(slot, 0) ThenBlock: {
                slot = JSComp__AddLocal(np, nl)
            }

            // Get var kind from N_OP (70=var, 71=let, 72=const)
            vkind = JSParse_GetOp(save_node)

            // Check for initializer (N_LEFT)
            init = JSParse_GetLeft(save_node)
            IfCondition GreaterEqual(init, 0) ThenBlock: {
                JSComp__Push(slot)
                JSComp__Push(np)
                JSComp__Push(nl)
                JSComp__CompileExpr(init)
                nl = JSComp__Pop()
                np = JSComp__Pop()
                slot = JSComp__Pop()
                // At top-level, also store as global so functions can access
                IfCondition GreaterEqual(JSCompState.func_nesting, 0) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    ci_vd = JSComp__AddString(np, nl)
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_vd)
                }
                JSComp__EmitOp16(JSOp.SET_LOCAL, slot)
            } ElseBlock: {
                // const without initializer is a SyntaxError
                IfCondition EqualTo(vkind, 72) ThenBlock: {
                    JSCompState.error = 1
                    ReturnValue(-1)
                }
                // Initialize to undefined
                JSComp__Emit1(JSOp.PUSH_UNDEF)
                // At top-level, also store as global
                IfCondition GreaterEqual(JSCompState.func_nesting, 0) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    ci_vd = JSComp__AddString(np, nl)
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_vd)
                }
                JSComp__EmitOp16(JSOp.SET_LOCAL, slot)
            }
            // Clear TDZ mark for let/const after initialization
            IfCondition And(GreaterEqual(vkind, 71), LessThan(slot, 256)) ThenBlock: {
                SetByte(JSCompState.tdz_map, slot, 0)
            }
            ReturnValue(0)
        }

        // --- FUNC_DECL ---
        IfCondition EqualTo(ntype, ASTType.FUNC_DECL) ThenBlock: {
            // Add function name as local
            np = JSParse_GetNamePtr(save_node)
            nl = JSParse_GetNameLen(save_node)

            slot = JSComp__AddLocal(np, nl)

            // Compile function body into func_pool
            JSComp__Push(slot)
            JSComp__Push(np)
            JSComp__Push(nl)
            JSComp__CompileFunc(save_node)
            nl = JSComp__Pop()
            np = JSComp__Pop()
            slot = JSComp__Pop()

            // At top-level, also store as global so functions can access each other
            IfCondition GreaterEqual(JSCompState.func_nesting, 0) ThenBlock: {
                JSComp__Emit1(JSOp.DUP)
                ci_fd = JSComp__AddString(np, nl)
                JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_fd)
            }
            JSComp__EmitOp16(JSOp.SET_LOCAL, slot)
            ReturnValue(0)
        }

        // --- GEN_FUNC_DECL (function* name) ---
        IfCondition EqualTo(ntype, ASTType.GEN_FUNC_DECL) ThenBlock: {
            np = JSParse_GetNamePtr(save_node)
            nl = JSParse_GetNameLen(save_node)

            slot = JSComp__AddLocal(np, nl)
            JSComp__Push(slot)
            JSComp__Push(np)
            JSComp__Push(nl)
            JSComp__CompileFunc(save_node)
            nl = JSComp__Pop()
            np = JSComp__Pop()
            slot = JSComp__Pop()
            IfCondition GreaterEqual(JSCompState.func_nesting, 0) ThenBlock: {
                JSComp__Emit1(JSOp.DUP)
                ci_fd = JSComp__AddString(np, nl)
                JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_fd)
            }
            JSComp__EmitOp16(JSOp.SET_LOCAL, slot)
            ReturnValue(0)
        }

        // --- ASYNC_FUNC_DECL (async function name) ---
        IfCondition EqualTo(ntype, ASTType.ASYNC_FUNC_DECL) ThenBlock: {
            np = JSParse_GetNamePtr(save_node)
            nl = JSParse_GetNameLen(save_node)

            slot = JSComp__AddLocal(np, nl)
            JSComp__Push(slot)
            JSComp__Push(np)
            JSComp__Push(nl)
            JSComp__CompileFunc(save_node)
            nl = JSComp__Pop()
            np = JSComp__Pop()
            slot = JSComp__Pop()
            IfCondition GreaterEqual(JSCompState.func_nesting, 0) ThenBlock: {
                JSComp__Emit1(JSOp.DUP)
                ci_fd = JSComp__AddString(np, nl)
                JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_fd)
            }
            JSComp__EmitOp16(JSOp.SET_LOCAL, slot)
            ReturnValue(0)
        }

        // --- CLASS_DECL ---
        IfCondition EqualTo(ntype, ASTType.CLASS_DECL) ThenBlock: {
            np = JSParse_GetNamePtr(save_node)
            nl = JSParse_GetNameLen(save_node)

            slot = JSComp__AddLocal(np, nl)
            JSComp__Push(slot)
            JSComp__Push(np)
            JSComp__Push(nl)
            JSComp__CompileClass(save_node)
            nl = JSComp__Pop()
            np = JSComp__Pop()
            slot = JSComp__Pop()
            IfCondition GreaterEqual(JSCompState.func_nesting, 0) ThenBlock: {
                JSComp__Emit1(JSOp.DUP)
                ci_fd = JSComp__AddString(np, nl)
                JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_fd)
            }
            JSComp__EmitOp16(JSOp.SET_LOCAL, slot)
            ReturnValue(0)
        }

        // --- RETURN_STMT ---
        IfCondition EqualTo(ntype, ASTType.RETURN_STMT) ThenBlock: {
            ret_expr = JSParse_GetLeft(save_node)
            IfCondition GreaterEqual(ret_expr, 0) ThenBlock: {
                JSComp__CompileExpr(ret_expr)
            } ElseBlock: {
                JSComp__Emit1(JSOp.PUSH_UNDEF)
            }
            JSComp__Emit1(JSOp.RETURN)
            ReturnValue(0)
        }

        // --- EXPR_STMT ---
        IfCondition EqualTo(ntype, ASTType.EXPR_STMT) ThenBlock: {
            es = JSParse_GetLeft(save_node)
            JSComp__CompileExpr(es)
            // In eval mode, skip POP for the last expression — leave result on stack
            IfCondition And(EqualTo(JSCompState.eval_mode, 1), EqualTo(JSCompState.is_last_stmt, 1)) ThenBlock: {
                // Keep value on stack for JSVM_Run to return
            } ElseBlock: {
                JSComp__Emit1(JSOp.POP)
            }
            ReturnValue(0)
        }

        // --- IF_STMT ---
        IfCondition EqualTo(ntype, ASTType.IF_STMT) ThenBlock: {
            // Compile condition
            cond_n = JSParse_GetCond(save_node)

            JSComp__Push(save_node)
            JSComp__CompileExpr(cond_n)
            save_node = JSComp__Pop()

            // JMP_FALSE to else/end
            false_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP_FALSE, 0)

            // Compile then-body
            body_n = JSParse_GetBody(save_node)

            JSComp__Push(save_node)
            JSComp__Push(false_jmp)
            JSComp__CompileNode(body_n)
            false_jmp = JSComp__Pop()
            save_node = JSComp__Pop()

            // Check for else branch (N_RIGHT)
            else_n = JSParse_GetRight(save_node)
            IfCondition GreaterEqual(else_n, 0) ThenBlock: {
                // JMP over else
                end_jmp = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP, 0)

                // Patch false_jmp to here (start of else)
                JSComp__PatchJump(false_jmp)

                // Compile else body
                JSComp__CompileNode(else_n)

                // Patch end_jmp
                JSComp__PatchJump(end_jmp)
            } ElseBlock: {
                // No else — patch false_jmp to here
                JSComp__PatchJump(false_jmp)
            }
            ReturnValue(0)
        }

        // --- WHILE_STMT ---
        IfCondition EqualTo(ntype, ASTType.WHILE_STMT) ThenBlock: {
            loop_start = JSCompState.code_pos
            JSComp__PushLoop(loop_start)

            // Compile condition
            cond_n = JSParse_GetCond(save_node)

            JSComp__Push(save_node)
            JSComp__Push(loop_start)
            JSComp__CompileExpr(cond_n)
            loop_start = JSComp__Pop()
            save_node = JSComp__Pop()

            // JMP_FALSE to end
            exit_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
            JSComp__RecordBreak(exit_jmp)

            // Compile body
            body_n = JSParse_GetBody(save_node)

            JSComp__Push(loop_start)
            JSComp__CompileNode(body_n)
            loop_start = JSComp__Pop()

            // JMP back to condition
            JSComp__EmitOp16(JSOp.JMP, loop_start)

            // Patch exit and pop loop
            JSComp__PopLoop()
            ReturnValue(0)
        }

        // --- DO_WHILE ---
        IfCondition EqualTo(ntype, ASTType.DO_WHILE) ThenBlock: {
            loop_start = JSCompState.code_pos
            JSComp__PushLoop(loop_start)

            // Compile body first
            body_n = JSParse_GetBody(save_node)

            JSComp__Push(save_node)
            JSComp__Push(loop_start)
            JSComp__CompileNode(body_n)
            loop_start = JSComp__Pop()
            save_node = JSComp__Pop()

            // Compile condition
            cond_n = JSParse_GetCond(save_node)

            JSComp__Push(loop_start)
            JSComp__CompileExpr(cond_n)
            loop_start = JSComp__Pop()

            // JMP_TRUE back to start
            JSComp__EmitOp16(JSOp.JMP_TRUE, loop_start)

            JSComp__PopLoop()
            ReturnValue(0)
        }

        // --- FOR_STMT ---
        IfCondition EqualTo(ntype, ASTType.FOR_STMT) ThenBlock: {
            // Push a scope for for-loop variables
            JSComp__PushScope()

            // Compile init (N_LEFT)
            init_n = JSParse_GetLeft(save_node)
            IfCondition GreaterEqual(init_n, 0) ThenBlock: {
                JSComp__Push(save_node)
                JSComp__CompileNode(init_n)
                save_node = JSComp__Pop()
            }

            // Record loop start (at condition)
            loop_start = JSCompState.code_pos

            // For-loop continue goes to the update expr, not the condition.
            // We don't know the update address yet, so use -1 as sentinel.
            // CONTINUE_STMT will emit forward JMPs and record them.
            // After the update, we patch all continues to point there.
            JSComp__PushLoop(-1)

            // Compile condition (N_COND)
            cond_n = JSParse_GetCond(save_node)
            IfCondition GreaterEqual(cond_n, 0) ThenBlock: {
                JSComp__Push(save_node)
                JSComp__Push(loop_start)
                JSComp__CompileExpr(cond_n)
                loop_start = JSComp__Pop()
                save_node = JSComp__Pop()

                // JMP_FALSE to end
                exit_jmp = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                JSComp__RecordBreak(exit_jmp)
            }

            // Compile body (N_BODY)
            body_n = JSParse_GetBody(save_node)
            IfCondition GreaterEqual(body_n, 0) ThenBlock: {
                JSComp__Push(save_node)
                JSComp__Push(loop_start)
                JSComp__CompileNode(body_n)
                loop_start = JSComp__Pop()
                save_node = JSComp__Pop()
            }

            // Patch all forward continue JMPs to point here (before update expr)
            JSComp__PatchContinues()

            // Compile update (N_RIGHT)
            update_n = JSParse_GetRight(save_node)
            IfCondition GreaterEqual(update_n, 0) ThenBlock: {
                JSComp__Push(loop_start)
                JSComp__CompileExpr(update_n)
                JSComp__Emit1(JSOp.POP)
                loop_start = JSComp__Pop()
            }

            // JMP back to condition
            JSComp__EmitOp16(JSOp.JMP, loop_start)

            // Pop loop (patches break jumps)
            JSComp__PopLoop()
            JSComp__PopScope()
            ReturnValue(0)
        }

        // --- FOR_IN_STMT ---
        // AST layout: N_LEFT = lhs (VAR_DECL or expr), N_COND = rhs object, N_BODY = body
        // Strategy:
        //   compile(rhs) → OBJ_KEYS → store in __keys__ local
        //   __idx__ = 0
        //   loop: if __idx__ >= __keys__.length → break
        //   lhs_var = __keys__[__idx__]
        //   body
        //   __idx__++
        //   goto loop
        IfCondition EqualTo(ntype, ASTType.FOR_IN_STMT) ThenBlock: {
            JSComp__PushScope()

            // --- Compile LHS variable declaration if VAR_DECL ---
            lhs_n = JSParse_GetLeft(save_node)
            lhs_type = JSParse_GetType(lhs_n)
            IfCondition EqualTo(lhs_type, ASTType.VAR_DECL) ThenBlock: {
                // Add the declared variable as a local but don't initialize yet
                np = JSParse_GetNamePtr(lhs_n)
                nl = JSParse_GetNameLen(lhs_n)
                JSComp__Push(save_node)
                JSComp__Push(lhs_n)
                JSComp__AddLocal(np, nl)
                lhs_n = JSComp__Pop()
                save_node = JSComp__Pop()
            }

            // Allocate hidden locals __keys__ and __idx__ first
            keys_name_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
            // __keys__ = 8 bytes: 95,95,107,101,121,115,95,95
            SetByte(keys_name_ptr, 0, 95)
            SetByte(keys_name_ptr, 1, 95)
            SetByte(keys_name_ptr, 2, 107)
            SetByte(keys_name_ptr, 3, 101)
            SetByte(keys_name_ptr, 4, 121)
            SetByte(keys_name_ptr, 5, 115)
            SetByte(keys_name_ptr, 6, 95)
            SetByte(keys_name_ptr, 7, 95)
            SetByte(keys_name_ptr, 8, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 9)

            JSComp__Push(save_node)
            JSComp__Push(lhs_n)
            keys_slot = JSComp__AddLocal(keys_name_ptr, 8)
            lhs_n = JSComp__Pop()
            save_node = JSComp__Pop()

            idx_name_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
            // __idx__ = 7 bytes: 95,95,105,100,120,95,95
            SetByte(idx_name_ptr, 0, 95)
            SetByte(idx_name_ptr, 1, 95)
            SetByte(idx_name_ptr, 2, 105)
            SetByte(idx_name_ptr, 3, 100)
            SetByte(idx_name_ptr, 4, 120)
            SetByte(idx_name_ptr, 5, 95)
            SetByte(idx_name_ptr, 6, 95)
            SetByte(idx_name_ptr, 7, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 8)

            JSComp__Push(save_node)
            JSComp__Push(lhs_n)
            JSComp__Push(keys_slot)
            idx_slot = JSComp__AddLocal(idx_name_ptr, 7)
            keys_slot = JSComp__Pop()
            lhs_n = JSComp__Pop()
            save_node = JSComp__Pop()

            // Reserve stack space for hidden locals BEFORE computing RHS
            JSComp__Emit1(JSOp.PUSH_UNDEF)
            JSComp__Emit1(JSOp.PUSH_UNDEF)

            // --- Compile RHS object expression, emit OBJ_KEYS ---
            rhs_n = JSParse_GetCond(save_node)

            JSComp__Push(save_node)
            JSComp__Push(lhs_n)
            JSComp__Push(keys_slot)
            JSComp__Push(idx_slot)
            JSComp__CompileExpr(rhs_n)
            idx_slot = JSComp__Pop()
            keys_slot = JSComp__Pop()
            lhs_n = JSComp__Pop()
            save_node = JSComp__Pop()

            JSComp__Emit1(JSOp.OBJ_KEYS)

            // Store keys array into __keys__ slot
            JSComp__EmitOp16(JSOp.SET_LOCAL, keys_slot)

            // __idx__ = 0
            zero_ci = JSComp__AddNumber(0)
            JSComp__EmitOp16(JSOp.PUSH_CONST, zero_ci)
            JSComp__EmitOp16(JSOp.SET_LOCAL, idx_slot)

            // --- Loop start ---
            loop_start = JSCompState.code_pos

            // For-in continue: jump to increment (forward patch like for-loop)
            JSComp__PushLoop(-1)

            // Condition: __idx__ < __keys__.length
            JSComp__EmitOp16(JSOp.GET_LOCAL, idx_slot)

            // Get keys.length: GET_LOCAL(keys_slot) → GET_PROP("length")
            JSComp__Push(save_node)
            JSComp__Push(lhs_n)
            JSComp__Push(keys_slot)
            JSComp__Push(idx_slot)
            JSComp__Push(loop_start)
            JSComp__EmitOp16(JSOp.GET_LOCAL, keys_slot)
            // Add "length" to const pool
            len_name_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(len_name_ptr, 0, 108)
            SetByte(len_name_ptr, 1, 101)
            SetByte(len_name_ptr, 2, 110)
            SetByte(len_name_ptr, 3, 103)
            SetByte(len_name_ptr, 4, 116)
            SetByte(len_name_ptr, 5, 104)
            SetByte(len_name_ptr, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)
            len_ci = JSComp__AddString(len_name_ptr, 6)
            JSComp__EmitOp16(JSOp.GET_PROP, len_ci)
            loop_start = JSComp__Pop()
            idx_slot = JSComp__Pop()
            keys_slot = JSComp__Pop()
            lhs_n = JSComp__Pop()
            save_node = JSComp__Pop()

            // LT comparison
            JSComp__Emit1(JSOp.LT)

            // JMP_FALSE to end (break target)
            exit_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
            JSComp__RecordBreak(exit_jmp)

            // --- Assign current key to LHS variable ---
            // keys[idx]: GET_LOCAL(keys) → GET_LOCAL(idx) → GET_ELEM
            JSComp__EmitOp16(JSOp.GET_LOCAL, keys_slot)
            JSComp__EmitOp16(JSOp.GET_LOCAL, idx_slot)
            JSComp__Emit1(JSOp.GET_ELEM)

            // Set to LHS variable
            lhs_type2 = JSParse_GetType(lhs_n)
            IfCondition EqualTo(lhs_type2, ASTType.VAR_DECL) ThenBlock: {
                // VAR_DECL: find the variable slot by name
                np2 = JSParse_GetNamePtr(lhs_n)
                nl2 = JSParse_GetNameLen(lhs_n)
                JSComp__Push(save_node)
                JSComp__Push(lhs_n)
                JSComp__Push(keys_slot)
                JSComp__Push(idx_slot)
                JSComp__Push(loop_start)
                JSComp__EmitVarSet(np2, nl2)
                loop_start = JSComp__Pop()
                idx_slot = JSComp__Pop()
                keys_slot = JSComp__Pop()
                lhs_n = JSComp__Pop()
                save_node = JSComp__Pop()
            } ElseBlock: {
                // Expression LHS (e.g. bare identifier): resolve and set
                np2 = JSParse_GetNamePtr(lhs_n)
                nl2 = JSParse_GetNameLen(lhs_n)
                JSComp__Push(save_node)
                JSComp__Push(lhs_n)
                JSComp__Push(keys_slot)
                JSComp__Push(idx_slot)
                JSComp__Push(loop_start)
                JSComp__EmitVarSet(np2, nl2)
                loop_start = JSComp__Pop()
                idx_slot = JSComp__Pop()
                keys_slot = JSComp__Pop()
                lhs_n = JSComp__Pop()
                save_node = JSComp__Pop()
            }

            // --- Compile body ---
            body_n = JSParse_GetBody(save_node)
            IfCondition GreaterEqual(body_n, 0) ThenBlock: {
                JSComp__Push(save_node)
                JSComp__Push(keys_slot)
                JSComp__Push(idx_slot)
                JSComp__Push(loop_start)
                JSComp__CompileNode(body_n)
                loop_start = JSComp__Pop()
                idx_slot = JSComp__Pop()
                keys_slot = JSComp__Pop()
                save_node = JSComp__Pop()
            }

            // Patch continues to point here (before increment)
            JSComp__PatchContinues()

            // --- Increment __idx__ ---
            JSComp__EmitOp16(JSOp.GET_LOCAL, idx_slot)
            one_ci = JSComp__AddNumber(1)
            JSComp__EmitOp16(JSOp.PUSH_CONST, one_ci)
            JSComp__Emit1(JSOp.ADD)
            JSComp__EmitOp16(JSOp.SET_LOCAL, idx_slot)

            // JMP back to loop start
            JSComp__EmitOp16(JSOp.JMP, loop_start)

            // Pop loop (patches break jumps to here)
            JSComp__PopLoop()
            JSComp__PopScope()
            ReturnValue(0)
        }

        // --- FOR_OF_STMT ---
        // AST layout: N_LEFT = lhs (VAR_DECL or expr), N_COND = rhs iterable, N_BODY = body
        // Strategy: like for-in but with TO_ARRAY instead of OBJ_KEYS
        //   compile(rhs) → TO_ARRAY → store in __vals__ local
        //   __idx__ = 0
        //   loop: if __idx__ >= __vals__.length → break
        //   lhs_var = __vals__[__idx__]
        //   body
        //   __idx__++
        //   goto loop
        IfCondition EqualTo(ntype, ASTType.FOR_OF_STMT) ThenBlock: {
            JSComp__PushScope()

            // --- Compile LHS variable declaration if VAR_DECL ---
            lhs_n = JSParse_GetLeft(save_node)
            lhs_type = JSParse_GetType(lhs_n)
            forof_dstr_pat = -1
            IfCondition EqualTo(lhs_type, ASTType.VAR_DECL) ThenBlock: {
                // Check for destructuring pattern (N_RIGHT holds pattern node)
                forof_dstr_pat = JSParse_GetRight(lhs_n)
                IfCondition LessThan(forof_dstr_pat, 0) ThenBlock: {
                    // Simple identifier — add local as before
                    np = JSParse_GetNamePtr(lhs_n)
                    nl = JSParse_GetNameLen(lhs_n)
                    JSComp__Push(save_node)
                    JSComp__Push(lhs_n)
                    JSComp__AddLocal(np, nl)
                    lhs_n = JSComp__Pop()
                    save_node = JSComp__Pop()
                }
                // If pattern: locals will be added by CompileArrayPattern/CompileObjPattern later
            }
            // Expression-init with cover grammar pattern: for ({x} of ...) or for ([a,b] of ...)
            IfCondition Or(EqualTo(lhs_type, ASTType.ARRAY_PATTERN),
                          EqualTo(lhs_type, ASTType.OBJECT_PATTERN)) ThenBlock: {
                forof_dstr_pat = lhs_n
            }

            // Allocate hidden locals __vals__ and __idx__ BEFORE computing RHS
            vals_name_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
            // __vals__ = 8 bytes: 95,95,118,97,108,115,95,95
            SetByte(vals_name_ptr, 0, 95)
            SetByte(vals_name_ptr, 1, 95)
            SetByte(vals_name_ptr, 2, 118)
            SetByte(vals_name_ptr, 3, 97)
            SetByte(vals_name_ptr, 4, 108)
            SetByte(vals_name_ptr, 5, 115)
            SetByte(vals_name_ptr, 6, 95)
            SetByte(vals_name_ptr, 7, 95)
            SetByte(vals_name_ptr, 8, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 9)

            JSComp__Push(save_node)
            JSComp__Push(lhs_n)
            vals_slot = JSComp__AddLocal(vals_name_ptr, 8)
            lhs_n = JSComp__Pop()
            save_node = JSComp__Pop()

            idx_name_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
            // __idx__ = 7 bytes: 95,95,105,100,120,95,95
            SetByte(idx_name_ptr, 0, 95)
            SetByte(idx_name_ptr, 1, 95)
            SetByte(idx_name_ptr, 2, 105)
            SetByte(idx_name_ptr, 3, 100)
            SetByte(idx_name_ptr, 4, 120)
            SetByte(idx_name_ptr, 5, 95)
            SetByte(idx_name_ptr, 6, 95)
            SetByte(idx_name_ptr, 7, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 8)

            JSComp__Push(save_node)
            JSComp__Push(lhs_n)
            JSComp__Push(vals_slot)
            idx_slot = JSComp__AddLocal(idx_name_ptr, 7)
            vals_slot = JSComp__Pop()
            lhs_n = JSComp__Pop()
            save_node = JSComp__Pop()

            // Reserve stack space for hidden locals BEFORE computing RHS
            JSComp__Emit1(JSOp.PUSH_UNDEF)
            JSComp__Emit1(JSOp.PUSH_UNDEF)

            // --- Compile RHS iterable expression, emit TO_ARRAY ---
            rhs_n = JSParse_GetCond(save_node)

            JSComp__Push(save_node)
            JSComp__Push(lhs_n)
            JSComp__Push(vals_slot)
            JSComp__Push(idx_slot)
            JSComp__CompileExpr(rhs_n)
            idx_slot = JSComp__Pop()
            vals_slot = JSComp__Pop()
            lhs_n = JSComp__Pop()
            save_node = JSComp__Pop()

            JSComp__Emit1(JSOp.TO_ARRAY)

            // Store values array into __vals__ slot
            JSComp__EmitOp16(JSOp.SET_LOCAL, vals_slot)

            // __idx__ = 0
            zero_ci = JSComp__AddNumber(0)
            JSComp__EmitOp16(JSOp.PUSH_CONST, zero_ci)
            JSComp__EmitOp16(JSOp.SET_LOCAL, idx_slot)

            // --- Loop start ---
            loop_start = JSCompState.code_pos

            // For-of continue: jump to increment (forward patch like for-loop)
            JSComp__PushLoop(-1)

            // Condition: __idx__ < __vals__.length
            JSComp__EmitOp16(JSOp.GET_LOCAL, idx_slot)

            // Get vals.length: GET_LOCAL(vals_slot) → GET_PROP("length")
            JSComp__Push(save_node)
            JSComp__Push(lhs_n)
            JSComp__Push(vals_slot)
            JSComp__Push(idx_slot)
            JSComp__Push(loop_start)
            JSComp__EmitOp16(JSOp.GET_LOCAL, vals_slot)
            // Add "length" to const pool
            len_name_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(len_name_ptr, 0, 108)
            SetByte(len_name_ptr, 1, 101)
            SetByte(len_name_ptr, 2, 110)
            SetByte(len_name_ptr, 3, 103)
            SetByte(len_name_ptr, 4, 116)
            SetByte(len_name_ptr, 5, 104)
            SetByte(len_name_ptr, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)
            len_ci = JSComp__AddString(len_name_ptr, 6)
            JSComp__EmitOp16(JSOp.GET_PROP, len_ci)
            loop_start = JSComp__Pop()
            idx_slot = JSComp__Pop()
            vals_slot = JSComp__Pop()
            lhs_n = JSComp__Pop()
            save_node = JSComp__Pop()

            // LT comparison
            JSComp__Emit1(JSOp.LT)

            // JMP_FALSE to end (break target)
            exit_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
            JSComp__RecordBreak(exit_jmp)

            // --- Assign current value to LHS variable ---
            // vals[idx]: GET_LOCAL(vals) → GET_LOCAL(idx) → GET_ELEM
            JSComp__EmitOp16(JSOp.GET_LOCAL, vals_slot)
            JSComp__EmitOp16(JSOp.GET_LOCAL, idx_slot)
            JSComp__Emit1(JSOp.GET_ELEM)

            // Check for destructuring pattern in for-of LHS
            IfCondition GreaterEqual(forof_dstr_pat, 0) ThenBlock: {
                // Store current element in __dt__ temp, dispatch to pattern compiler
                dt_nm2 = Add(JSCompState.str_buf, JSCompState.str_pos)
                // __dt__ = 6 bytes: 95,95,100,116,95,95
                SetByte(dt_nm2, 0, 95)
                SetByte(dt_nm2, 1, 95)
                SetByte(dt_nm2, 2, 100)
                SetByte(dt_nm2, 3, 116)
                SetByte(dt_nm2, 4, 95)
                SetByte(dt_nm2, 5, 95)
                SetByte(dt_nm2, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)

                JSComp__Push(save_node)
                JSComp__Push(lhs_n)
                JSComp__Push(vals_slot)
                JSComp__Push(idx_slot)
                JSComp__Push(loop_start)
                JSComp__Push(forof_dstr_pat)
                dt_slot2 = JSComp__AddLocal(dt_nm2, 6)
                forof_dstr_pat = JSComp__Pop()
                loop_start = JSComp__Pop()
                idx_slot = JSComp__Pop()
                vals_slot = JSComp__Pop()
                lhs_n = JSComp__Pop()
                save_node = JSComp__Pop()

                JSComp__EmitOp16(JSOp.SET_LOCAL, dt_slot2)

                // Dispatch on pattern type
                dstr_pt = JSParse_GetType(forof_dstr_pat)
                IfCondition EqualTo(dstr_pt, ASTType.ARRAY_PATTERN) ThenBlock: {
                    JSComp__Push(save_node)
                    JSComp__Push(lhs_n)
                    JSComp__Push(vals_slot)
                    JSComp__Push(idx_slot)
                    JSComp__Push(loop_start)
                    JSComp__CompileArrayPattern(forof_dstr_pat, dt_slot2)
                    loop_start = JSComp__Pop()
                    idx_slot = JSComp__Pop()
                    vals_slot = JSComp__Pop()
                    lhs_n = JSComp__Pop()
                    save_node = JSComp__Pop()
                } ElseBlock: {
                    IfCondition EqualTo(dstr_pt, ASTType.OBJECT_PATTERN) ThenBlock: {
                        JSComp__Push(save_node)
                        JSComp__Push(lhs_n)
                        JSComp__Push(vals_slot)
                        JSComp__Push(idx_slot)
                        JSComp__Push(loop_start)
                        JSComp__CompileObjPattern(forof_dstr_pat, dt_slot2)
                        loop_start = JSComp__Pop()
                        idx_slot = JSComp__Pop()
                        vals_slot = JSComp__Pop()
                        lhs_n = JSComp__Pop()
                        save_node = JSComp__Pop()
                    }
                }
            } ElseBlock: {
                // Simple variable: set LHS directly
                lhs_type2 = JSParse_GetType(lhs_n)
                IfCondition EqualTo(lhs_type2, ASTType.VAR_DECL) ThenBlock: {
                    np2 = JSParse_GetNamePtr(lhs_n)
                    nl2 = JSParse_GetNameLen(lhs_n)
                    JSComp__Push(save_node)
                    JSComp__Push(lhs_n)
                    JSComp__Push(vals_slot)
                    JSComp__Push(idx_slot)
                    JSComp__Push(loop_start)
                    JSComp__EmitVarSet(np2, nl2)
                    loop_start = JSComp__Pop()
                    idx_slot = JSComp__Pop()
                    vals_slot = JSComp__Pop()
                    lhs_n = JSComp__Pop()
                    save_node = JSComp__Pop()
                } ElseBlock: {
                    np2 = JSParse_GetNamePtr(lhs_n)
                    nl2 = JSParse_GetNameLen(lhs_n)
                    JSComp__Push(save_node)
                    JSComp__Push(lhs_n)
                    JSComp__Push(vals_slot)
                    JSComp__Push(idx_slot)
                    JSComp__Push(loop_start)
                    JSComp__EmitVarSet(np2, nl2)
                    loop_start = JSComp__Pop()
                    idx_slot = JSComp__Pop()
                    vals_slot = JSComp__Pop()
                    lhs_n = JSComp__Pop()
                    save_node = JSComp__Pop()
                }
            }

            // --- Compile body ---
            body_n = JSParse_GetBody(save_node)
            IfCondition GreaterEqual(body_n, 0) ThenBlock: {
                JSComp__Push(save_node)
                JSComp__Push(vals_slot)
                JSComp__Push(idx_slot)
                JSComp__Push(loop_start)
                JSComp__CompileNode(body_n)
                loop_start = JSComp__Pop()
                idx_slot = JSComp__Pop()
                vals_slot = JSComp__Pop()
                save_node = JSComp__Pop()
            }

            // Patch continues to point here (before increment)
            JSComp__PatchContinues()

            // --- Increment __idx__ ---
            JSComp__EmitOp16(JSOp.GET_LOCAL, idx_slot)
            one_ci = JSComp__AddNumber(1)
            JSComp__EmitOp16(JSOp.PUSH_CONST, one_ci)
            JSComp__Emit1(JSOp.ADD)
            JSComp__EmitOp16(JSOp.SET_LOCAL, idx_slot)

            // JMP back to loop start
            JSComp__EmitOp16(JSOp.JMP, loop_start)

            // Pop loop (patches break jumps to here)
            JSComp__PopLoop()
            JSComp__PopScope()
            ReturnValue(0)
        }

        // --- BREAK_STMT ---
        IfCondition EqualTo(ntype, ASTType.BREAK_STMT) ThenBlock: {
            brk_addr = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP, 0)
            JSComp__RecordBreak(brk_addr)
            ReturnValue(0)
        }

        // --- CONTINUE_STMT ---
        IfCondition EqualTo(ntype, ASTType.CONTINUE_STMT) ThenBlock: {
            ct = JSComp__GetContinueTarget()
            IfCondition LessThan(ct, 0) ThenBlock: {
                // Forward continue (for-loop): record for later patching
                cont_jmp = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP, 0)
                JSComp__RecordContinue(cont_jmp)
            } ElseBlock: {
                // Backward continue (while/do-while): direct jump
                JSComp__EmitOp16(JSOp.JMP, ct)
            }
            ReturnValue(0)
        }

        // --- SWITCH_STMT ---
        IfCondition EqualTo(ntype, ASTType.SWITCH_STMT) ThenBlock: {
            // Compile discriminant (N_LEFT)
            disc = JSParse_GetLeft(save_node)

            JSComp__Push(save_node)
            JSComp__CompileExpr(disc)
            save_node = JSComp__Pop()

            // Push a lexical scope for the switch body (ES2015 13.12.11)
            JSComp__PushScope()

            // Store discriminant in hidden global __sw__ to avoid top-level
            // stack/local collision. Bytes: 95,95,115,119,95,95 = "__sw__"
            sw_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(sw_nm, 0, 95)
            SetByte(sw_nm, 1, 95)
            SetByte(sw_nm, 2, 115)
            SetByte(sw_nm, 3, 119)
            SetByte(sw_nm, 4, 95)
            SetByte(sw_nm, 5, 95)
            SetByte(sw_nm, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)

            JSComp__Push(save_node)
            sw_ci = JSComp__AddString(sw_nm, 6)
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.SET_GLOBAL, sw_ci)

            // Push a "loop" for break support (no continue target)
            JSComp__PushLoop(-1)

            // Cases are linked via N_BODY -> N_NEXT (parser stores case list in N_BODY)
            // Two-pass compilation for correct fallthrough semantics:
            //   Pass 1: emit case test chain (GET_GLOBAL + test + STRICT_EQ + JMP_TRUE body_N)
            //   Pass 2: emit case bodies sequentially (natural fallthrough)

            // ---- Pass 1: Case test chain ----
            case_n = JSParse_GetBody(save_node)
            case_idx = 0
            default_idx = -1

            WhileLoop GreaterEqual(case_n, 0) {
                case_type = JSParse_GetType(case_n)
                IfCondition EqualTo(case_type, ASTType.CASE_CLAUSE) ThenBlock: {
                    test_n = JSParse_GetLeft(case_n)
                    IfCondition GreaterEqual(test_n, 0) ThenBlock: {
                        // Non-default case: load disc from global, compile test, STRICT_EQ, JMP_TRUE
                        JSComp__EmitOp16(JSOp.GET_GLOBAL, sw_ci)

                        JSComp__Push(save_node)
                        JSComp__Push(case_n)
                        JSComp__Push(case_idx)
                        JSComp__Push(default_idx)
                        JSComp__Push(sw_ci)
                        JSComp__CompileExpr(test_n)
                        sw_ci = JSComp__Pop()
                        default_idx = JSComp__Pop()
                        case_idx = JSComp__Pop()
                        case_n = JSComp__Pop()
                        save_node = JSComp__Pop()

                        JSComp__Emit1(JSOp.STRICT_EQ)
                        // Store JMP_TRUE address in switch_jmps[case_idx]
                        StoreValue(Add(JSCompState.switch_jmps, Multiply(case_idx, 8)), JSCompState.code_pos)
                        JSComp__EmitOp16(JSOp.JMP_TRUE, 0)
                    } ElseBlock: {
                        // Default case: record index, no test emitted
                        default_idx = case_idx
                        // Store -1 as marker (no JMP_TRUE to patch)
                        StoreValue(Add(JSCompState.switch_jmps, Multiply(case_idx, 8)), -1)
                    }
                    case_idx = Add(case_idx, 1)
                }
                case_n = JSParse_GetNext(case_n)
            }

            // After all tests: JMP to default body or end
            default_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP, 0)

            // ---- Pass 2: Case bodies (sequential, fallthrough) ----
            case_n = JSParse_GetBody(save_node)
            case_idx = 0

            WhileLoop GreaterEqual(case_n, 0) {
                case_type = JSParse_GetType(case_n)
                IfCondition EqualTo(case_type, ASTType.CASE_CLAUSE) ThenBlock: {
                    // Patch the JMP_TRUE from pass 1 to point here
                    jmp_addr = Dereference(Add(JSCompState.switch_jmps, Multiply(case_idx, 8)))
                    IfCondition GreaterEqual(jmp_addr, 0) ThenBlock: {
                        // Patch JMP_TRUE operand
                        JSComp__PatchJump(jmp_addr)
                    } ElseBlock: {
                        // Default case: patch the default JMP to point here
                        JSComp__PatchJump(default_jmp)
                    }

                    // Compile case body statements (N_BODY -> N_NEXT chain)
                    cbody = JSParse_GetBody(case_n)
                    WhileLoop GreaterEqual(cbody, 0) {
                        JSComp__Push(save_node)
                        JSComp__Push(case_n)
                        JSComp__Push(case_idx)
                        JSComp__Push(default_jmp)
                        JSComp__Push(sw_ci)
                        JSComp__Push(cbody)
                        JSComp__CompileNode(cbody)
                        cbody = JSComp__Pop()
                        sw_ci = JSComp__Pop()
                        default_jmp = JSComp__Pop()
                        case_idx = JSComp__Pop()
                        case_n = JSComp__Pop()
                        save_node = JSComp__Pop()
                        cbody = JSParse_GetNext(cbody)
                    }

                    case_idx = Add(case_idx, 1)
                }
                case_n = JSParse_GetNext(case_n)
            }

            // If no default was found, patch default_jmp to here (skip all bodies)
            IfCondition EqualTo(default_idx, -1) ThenBlock: {
                JSComp__PatchJump(default_jmp)
            }

            // Pop loop frame (patches break jumps)
            JSComp__PopLoop()

            // Pop the lexical scope for the switch body
            JSComp__PopScope()
            ReturnValue(0)
        }

        // --- TRY_STMT ---
        IfCondition EqualTo(ntype, ASTType.TRY_STMT) ThenBlock: {
            // TRY_PUSH <catch_addr>   ; register handler
            // [try body]
            // TRY_POP                 ; normal completion
            // JMP <end>               ; skip catch
            // <catch_addr>:
            // SET_GLOBAL <catch_var>  ; bind thrown value
            // [catch body]
            // <end>:

            // Emit TRY_PUSH with placeholder catch address
            try_push_addr = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.TRY_PUSH, 0)

            // Compile try body
            try_body = JSParse_GetBody(save_node)
            JSComp__Push(save_node)
            JSComp__Push(try_push_addr)
            JSComp__CompileNode(try_body)
            try_push_addr = JSComp__Pop()
            save_node = JSComp__Pop()

            // TRY_POP (normal completion — remove handler)
            JSComp__Emit1(JSOp.TRY_POP)

            // JMP past catch body
            skip_jmp = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP, 0)

            // Patch TRY_PUSH to point here (catch handler address)
            JSComp__PatchJump(try_push_addr)

            // Bind catch variable: thrown value is on stack after exception
            // Strategy: push a catch scope, add the catch var as a local,
            // store thrown value with SET_LOCAL, then emit PUSH_UNDEF to
            // keep the stack pointer above the catch local slot so operand
            // pushes don't overwrite it. Pop the placeholder at the end.
            catch_body = JSParse_GetLeft(save_node)
            cv_len = JSParse_GetNameLen(save_node)
            catch_has_scope = 0
            IfCondition GreaterThan(cv_len, 0) ThenBlock: {
                // Simple binding: catch (e) — create scoped local
                JSComp__PushScope()
                catch_has_scope = 1
                cv_ptr = JSParse_GetNamePtr(save_node)
                JSComp__Push(save_node)
                JSComp__Push(skip_jmp)
                cv_slot = JSComp__AddLocal(cv_ptr, cv_len)
                // DUP so thrown value stays on stack as placeholder,
                // then SET_LOCAL stores a copy into the catch slot.
                JSComp__Emit1(JSOp.DUP)
                JSComp__EmitOp16(JSOp.SET_LOCAL, cv_slot)
                // Stack: [thrown_placeholder] — keeps sp above local slot
                skip_jmp = JSComp__Pop()
                save_node = JSComp__Pop()
            }
            // Check for destructuring pattern in catch binding
            IfCondition EqualTo(cv_len, 0) ThenBlock: {
                catch_pat = JSParse_GetCond(save_node)
                IfCondition GreaterEqual(catch_pat, 0) ThenBlock: {
                    // Destructuring catch: store thrown value in __dt__ temp local,
                    // then dispatch to array/object pattern compilers
                    // Build __dt__ name: bytes 95,95,100,116,95,95
                    cdt_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                    SetByte(cdt_nm, 0, 95)
                    SetByte(cdt_nm, 1, 95)
                    SetByte(cdt_nm, 2, 100)
                    SetByte(cdt_nm, 3, 116)
                    SetByte(cdt_nm, 4, 95)
                    SetByte(cdt_nm, 5, 95)
                    SetByte(cdt_nm, 6, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 7)

                    JSComp__Push(save_node)
                    JSComp__Push(skip_jmp)
                    JSComp__Push(catch_pat)
                    cdt_slot = JSComp__AddLocal(cdt_nm, 6)
                    JSComp__EmitOp16(JSOp.SET_LOCAL, cdt_slot)
                    catch_pat = JSComp__Pop()
                    skip_jmp = JSComp__Pop()
                    save_node = JSComp__Pop()

                    pat_type = JSParse_GetType(catch_pat)
                    IfCondition EqualTo(pat_type, ASTType.ARRAY_PATTERN) ThenBlock: {
                        JSComp__Push(save_node)
                        JSComp__Push(skip_jmp)
                        JSComp__CompileArrayPattern(catch_pat, cdt_slot)
                        skip_jmp = JSComp__Pop()
                        save_node = JSComp__Pop()
                    }
                    IfCondition EqualTo(pat_type, ASTType.OBJECT_PATTERN) ThenBlock: {
                        JSComp__Push(save_node)
                        JSComp__Push(skip_jmp)
                        JSComp__CompileObjPattern(catch_pat, cdt_slot)
                        skip_jmp = JSComp__Pop()
                        save_node = JSComp__Pop()
                    }
                }
                // If no pattern and no name, parameterless catch — just pop the value
                IfCondition LessThan(catch_pat, 0) ThenBlock: {
                    JSComp__Emit1(JSOp.POP)
                }
            }

            // Compile catch body
            IfCondition GreaterEqual(catch_body, 0) ThenBlock: {
                JSComp__Push(skip_jmp)
                JSComp__Push(catch_has_scope)
                JSComp__CompileNode(catch_body)
                catch_has_scope = JSComp__Pop()
                skip_jmp = JSComp__Pop()
            }

            // Pop catch scope and the placeholder value if we created one
            IfCondition EqualTo(catch_has_scope, 1) ThenBlock: {
                JSComp__Emit1(JSOp.POP)
                JSComp__PopScope()
            }

            // Patch skip JMP to here (end of try/catch)
            JSComp__PatchJump(skip_jmp)

            // Compile finally body if present
            fin_body = JSParse_GetRight(save_node)
            IfCondition GreaterEqual(fin_body, 0) ThenBlock: {
                JSComp__CompileNode(fin_body)
            }

            ReturnValue(0)
        }

        // --- THROW_STMT ---
        IfCondition EqualTo(ntype, ASTType.THROW_STMT) ThenBlock: {
            // Compile the expression to throw
            throw_expr = JSParse_GetLeft(save_node)
            JSComp__CompileExpr(throw_expr)
            // Emit THROW opcode
            JSComp__Emit1(JSOp.THROW)
            ReturnValue(0)
        }

        // If we get here with an expression-type node, treat it as EXPR_STMT
        // This handles edge cases where expression nodes appear at statement level
        IfCondition GreaterEqual(ntype, ASTType.ASSIGN) ThenBlock: {
            JSComp__CompileExpr(save_node)
            JSComp__Emit1(JSOp.POP)
            ReturnValue(0)
        }

        // Unknown node type
        PrintMessage("[COMP] unknown node type=")
        PrintNumber(ntype)
        PrintMessage("\n")
        JSCompState.error = 1
        ReturnValue(-1)
    }
}

// ---------------------------------------------------------------------------
// Compile block — iterate body chain via N_BODY -> N_NEXT
// ---------------------------------------------------------------------------
Function.JSComp__CompileBlock {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node
        IfCondition EqualTo(JSCompState.error, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(save_node, 0) ThenBlock: { ReturnValue(-1) }

        JSComp__PushScope()

        // TDZ pre-declaration: scan immediate children for let/const VAR_DECL
        // and pre-allocate their slots marked as TDZ
        stmt = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(stmt, 0) {
            IfCondition EqualTo(JSParse_GetType(stmt), ASTType.VAR_DECL) ThenBlock: {
                tdz_op = JSParse_GetOp(stmt)
                IfCondition GreaterEqual(tdz_op, 71) ThenBlock: {
                    // let or const: check for simple name (not destructuring)
                    tdz_pat = JSParse_GetRight(stmt)
                    IfCondition LessThan(tdz_pat, 0) ThenBlock: {
                        tdz_np = JSParse_GetNamePtr(stmt)
                        tdz_nl = JSParse_GetNameLen(stmt)
                        tdz_slot = JSComp__AddLocal(tdz_np, tdz_nl)
                        IfCondition And(GreaterEqual(tdz_slot, 0), LessThan(tdz_slot, 256)) ThenBlock: {
                            SetByte(JSCompState.tdz_map, tdz_slot, 1)
                        }
                    }
                }
            }
            stmt = JSParse_GetNext(stmt)
        }

        // Body chain starts at N_BODY
        // Save and clear is_last_stmt — inner blocks must not inherit the
        // "last top-level statement" flag from eval mode. Otherwise EXPR_STMT
        // inside loops/if/etc skips POP and leaks a value every iteration.
        saved_is_last = JSCompState.is_last_stmt
        JSCompState.is_last_stmt = 0

        stmt = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(stmt, 0) {
            JSComp__Push(stmt)
            JSComp__CompileNode(stmt)
            stmt = JSComp__Pop()
            stmt = JSParse_GetNext(stmt)
        }

        JSCompState.is_last_stmt = saved_is_last
        JSComp__PopScope()
        ReturnValue(0)
    }
}

// ---------------------------------------------------------------------------
// Recursive var/func declaration counter.
// Walks the AST rooted at `node`, counting VAR_DECL and FUNC_DECL nodes.
// Stops recursion at function boundaries (FUNC_DECL/FUNC_EXPR bodies)
// because `var` is function-scoped.  Follows N_LEFT, N_RIGHT, N_COND,
// N_BODY, and N_NEXT pointers.
// ---------------------------------------------------------------------------
Function.JSComp__CountVars {
    Input: node: Integer
    Output: Integer
    Body: {
        save_n = node
        IfCondition LessThan(save_n, 0) ThenBlock: { ReturnValue(0) }
        ntype = JSParse_GetType(save_n)

        // Don't recurse into function bodies — they have their own scope
        IfCondition EqualTo(ntype, ASTType.FUNC_EXPR) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ntype, ASTType.ARROW_EXPR) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ntype, ASTType.GEN_FUNC_EXPR) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ntype, ASTType.ASYNC_FUNC_EXPR) ThenBlock: { ReturnValue(0) }

        count = 0

        // Count this node if it's a var or func declaration
        IfCondition EqualTo(ntype, ASTType.VAR_DECL) ThenBlock: {
            count = 1
        }
        IfCondition EqualTo(ntype, ASTType.FUNC_DECL) ThenBlock: {
            // Count the declaration but don't recurse into the body
            // Still need to follow N_NEXT for sibling statements
            JSComp__Push(1)
            c = JSComp__CountVars(JSParse_GetNext(save_n))
            count = JSComp__Pop()
            ReturnValue(Add(count, c))
        }
        IfCondition EqualTo(ntype, ASTType.GEN_FUNC_DECL) ThenBlock: {
            JSComp__Push(1)
            c = JSComp__CountVars(JSParse_GetNext(save_n))
            count = JSComp__Pop()
            ReturnValue(Add(count, c))
        }
        IfCondition EqualTo(ntype, ASTType.ASYNC_FUNC_DECL) ThenBlock: {
            JSComp__Push(1)
            c = JSComp__CountVars(JSParse_GetNext(save_n))
            count = JSComp__Pop()
            ReturnValue(Add(count, c))
        }
        IfCondition EqualTo(ntype, ASTType.CLASS_DECL) ThenBlock: {
            // Count the class name binding but don't recurse into methods
            JSComp__Push(1)
            c = JSComp__CountVars(JSParse_GetNext(save_n))
            count = JSComp__Pop()
            ReturnValue(Add(count, c))
        }

        // Recurse into children
        JSComp__Push(count)
        c = JSComp__CountVars(JSParse_GetLeft(save_n))
        count = JSComp__Pop()
        count = Add(count, c)

        JSComp__Push(count)
        c = JSComp__CountVars(JSParse_GetRight(save_n))
        count = JSComp__Pop()
        count = Add(count, c)

        JSComp__Push(count)
        c = JSComp__CountVars(JSParse_GetCond(save_n))
        count = JSComp__Pop()
        count = Add(count, c)

        JSComp__Push(count)
        c = JSComp__CountVars(JSParse_GetBody(save_n))
        count = JSComp__Pop()
        count = Add(count, c)

        JSComp__Push(count)
        c = JSComp__CountVars(JSParse_GetNext(save_n))
        count = JSComp__Pop()
        count = Add(count, c)

        ReturnValue(count)
    }
}

// ---------------------------------------------------------------------------
// Compile program root — iterate body chain via N_BODY -> N_NEXT, emit HALT
// ---------------------------------------------------------------------------
Function.JSComp__CompileProgram {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node
        IfCondition EqualTo(JSCompState.error, 1) ThenBlock: { ReturnValue(-1) }

        JSComp__PushScope()

        // Pre-scan: recursively count ALL var/func declarations in the
        // program tree (except inside nested functions).  `var` is
        // function-scoped so `for (var i ...)` hoists to program level.
        pre_count = JSComp__CountVars(JSParse_GetBody(save_node))

        // Reserve local slots on the value stack (mirrors what CALL does for
        // function frames).  Each PUSH_UNDEF advances sp past the slot so
        // subsequent operand pushes land above all locals.
        JSCompTmp.idx = 0
        WhileLoop LessThan(JSCompTmp.idx, pre_count) {
            JSComp__Emit1(JSOp.PUSH_UNDEF)
            JSCompTmp.idx = Add(JSCompTmp.idx, 1)
        }

        // TDZ pre-declaration: scan top-level for let/const VAR_DECL
        stmt = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(stmt, 0) {
            IfCondition EqualTo(JSParse_GetType(stmt), ASTType.VAR_DECL) ThenBlock: {
                tdz_op = JSParse_GetOp(stmt)
                IfCondition GreaterEqual(tdz_op, 71) ThenBlock: {
                    tdz_pat = JSParse_GetRight(stmt)
                    IfCondition LessThan(tdz_pat, 0) ThenBlock: {
                        tdz_np = JSParse_GetNamePtr(stmt)
                        tdz_nl = JSParse_GetNameLen(stmt)
                        tdz_slot = JSComp__AddLocal(tdz_np, tdz_nl)
                        IfCondition And(GreaterEqual(tdz_slot, 0), LessThan(tdz_slot, 256)) ThenBlock: {
                            SetByte(JSCompState.tdz_map, tdz_slot, 1)
                        }
                    }
                }
            }
            stmt = JSParse_GetNext(stmt)
        }

        stmt = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(stmt, 0) {
            // In eval mode, mark the last statement so EXPR_STMT preserves its value
            next_stmt = JSParse_GetNext(stmt)
            IfCondition And(EqualTo(JSCompState.eval_mode, 1), LessThan(next_stmt, 0)) ThenBlock: {
                JSCompState.is_last_stmt = 1
            } ElseBlock: {
                JSCompState.is_last_stmt = 0
            }
            JSComp__Push(stmt)
            JSComp__CompileNode(stmt)
            stmt = JSComp__Pop()
            stmt = JSParse_GetNext(stmt)
        }
        JSCompState.is_last_stmt = 0

        JSComp__Emit1(JSOp.HALT)
        JSComp__PopScope()
        ReturnValue(0)
    }
}

// ---------------------------------------------------------------------------
// Compile class declaration or expression.
// Emits bytecode that leaves the constructor function on the stack.
// Layout:
//   1. Compile constructor method (or default ctor) -> CLOSURE on stack
//   2. DUP constructor, create prototype object, SET_PROP "prototype"
//   3. For each method: compile CLOSURE, SET_PROP on prototype
//   4. For each static: compile CLOSURE, SET_PROP on constructor
//   5. For getters/setters: DEF_GETTER/DEF_SETTER on prototype/constructor
//   6. If extends: set __proto__ on prototype to parent.prototype
//   7. Result: constructor function with .prototype set up
// ---------------------------------------------------------------------------
Function.JSComp__CompileClass {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node
        IfCondition EqualTo(JSCompState.error, 1) ThenBlock: { ReturnValue(-1) }

        // If extends, compile parent expression first
        parent_n = JSParse_GetLeft(save_node)
        has_parent = 0
        IfCondition GreaterEqual(parent_n, 0) ThenBlock: {
            has_parent = 1
            JSComp__Push(save_node)
            JSComp__CompileExpr(parent_n)
            save_node = JSComp__Pop()
            // Parent constructor is now on stack. DUP and store as __super__
            // so child constructor can call super() via GET_GLOBAL.
            JSComp__Emit1(JSOp.DUP)
            sp_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            // "__super__" = 95 95 115 117 112 101 114 95 95
            SetByte(sp_nm, 0, 95)
            SetByte(sp_nm, 1, 95)
            SetByte(sp_nm, 2, 115)
            SetByte(sp_nm, 3, 117)
            SetByte(sp_nm, 4, 112)
            SetByte(sp_nm, 5, 101)
            SetByte(sp_nm, 6, 114)
            SetByte(sp_nm, 7, 95)
            SetByte(sp_nm, 8, 95)
            SetByte(sp_nm, 9, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            JSComp__Push(save_node)
            sp_ci = JSComp__AddString(sp_nm, 9)
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.SET_GLOBAL, sp_ci)
        }

        // Walk methods to find constructor
        method = JSParse_GetBody(save_node)
        ctor_node = -1
        WhileLoop GreaterEqual(method, 0) {
            mflags = JSParse_GetValue(method)
            // bit 3 (8) = constructor
            IfCondition NotEqual(BitwiseAnd(mflags, 8), 0) ThenBlock: {
                ctor_node = method
            }
            method = JSParse_GetNext(method)
        }

        // Compile constructor
        IfCondition GreaterEqual(ctor_node, 0) ThenBlock: {
            // User-defined constructor — flag it as derived if extends
            IfCondition EqualTo(has_parent, 1) ThenBlock: {
                JSCompState.is_derived_ctor = 1
            }
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            JSComp__CompileFunc(ctor_node)
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()
            JSCompState.is_derived_ctor = 0
        } ElseBlock: {
            // Default constructor: function() {} or function(...args) { super(...args) }
            // Emit a simple empty function
            dfidx = JSCompState.func_count
            IfCondition GreaterEqual(dfidx, JSCompConst.MAX_FUNCS) ThenBlock: {
                JSCompState.error = 1
                ReturnValue(-1)
            }
            JSCompState.func_count = Add(dfidx, 1)

            // JMP to skip function body
            dskip = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP, 0)
            dfstart = JSCompState.code_pos

            // Empty body: just return undefined
            JSComp__Emit1(JSOp.PUSH_UNDEF)
            JSComp__Emit1(JSOp.RETURN)

            // Patch JMP
            JSComp__PatchJump(dskip)

            // Build func descriptor
            dfbase = Add(JSCompState.func_pool, Multiply(dfidx, JSCompConst.FUNC_SIZE))
            StoreValue(dfbase, dfstart)
            StoreValue(Add(dfbase, 8), 0)
            StoreValue(Add(dfbase, 16), 0)

            // Class name as function name
            cnp = JSParse_GetNamePtr(save_node)
            cnl = JSParse_GetNameLen(save_node)
            StoreValue(Add(dfbase, 24), cnp)
            StoreValue(Add(dfbase, 32), cnl)

            // Add to const pool as FUNCTION
            dci = JSCompState.const_count
            JSCompState.const_count = Add(dci, 1)
            dcbase = Add(JSCompState.const_pool, Multiply(dci, JSCompConst.CONST_SIZE))
            StoreValue(dcbase, 3)
            StoreValue(Add(dcbase, 8), dfbase)

            // Emit CLOSURE
            JSComp__EmitOp16(JSOp.CLOSURE, dci)
        }

        // Stack: [parent_ctor?] [constructor]
        // Now DUP constructor, create prototype, set it up

        // Create prototype object
        JSComp__Emit1(JSOp.NEW_OBJECT)
        // Stack: [parent?] [ctor] [proto]

        // If extends: set proto.__proto__ = parent.prototype
        IfCondition EqualTo(has_parent, 1) ThenBlock: {
            // Stack: [parent] [ctor] [proto]
            // Store proto and ctor as globals to avoid local slot corruption.

            // Build "__cp__" string for proto global
            proto_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(proto_nm, 0, 95)
            SetByte(proto_nm, 1, 95)
            SetByte(proto_nm, 2, 99)
            SetByte(proto_nm, 3, 112)
            SetByte(proto_nm, 4, 95)
            SetByte(proto_nm, 5, 95)
            SetByte(proto_nm, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            proto_slot = JSComp__AddString(proto_nm, 6)
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.SET_GLOBAL, proto_slot)
            // Stack: [parent] [ctor]

            // Build "__cc__" string for ctor global
            ctor_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(ctor_nm, 0, 95)
            SetByte(ctor_nm, 1, 95)
            SetByte(ctor_nm, 2, 99)
            SetByte(ctor_nm, 3, 99)
            SetByte(ctor_nm, 4, 95)
            SetByte(ctor_nm, 5, 95)
            SetByte(ctor_nm, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            JSComp__Push(proto_slot)
            ctor_slot = JSComp__AddString(ctor_nm, 6)
            proto_slot = JSComp__Pop()
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.SET_GLOBAL, ctor_slot)
            // Stack: [parent]

            // Get parent.prototype
            pp_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            // "prototype" = 112 114 111 116 111 116 121 112 101
            SetByte(pp_nm, 0, 112)
            SetByte(pp_nm, 1, 114)
            SetByte(pp_nm, 2, 111)
            SetByte(pp_nm, 3, 116)
            SetByte(pp_nm, 4, 111)
            SetByte(pp_nm, 5, 116)
            SetByte(pp_nm, 6, 121)
            SetByte(pp_nm, 7, 112)
            SetByte(pp_nm, 8, 101)
            SetByte(pp_nm, 9, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            JSComp__Push(proto_slot)
            JSComp__Push(ctor_slot)
            pp_ci = JSComp__AddString(pp_nm, 9)
            ctor_slot = JSComp__Pop()
            proto_slot = JSComp__Pop()
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()
            // Stack: [parent] — GET_PROP "prototype"
            JSComp__EmitOp16(JSOp.GET_PROP, pp_ci)
            // Stack: [parent_proto]

            // Build "__pp__" string for parent proto global
            pp_tmp = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(pp_tmp, 0, 95)
            SetByte(pp_tmp, 1, 95)
            SetByte(pp_tmp, 2, 112)
            SetByte(pp_tmp, 3, 112)
            SetByte(pp_tmp, 4, 95)
            SetByte(pp_tmp, 5, 95)
            SetByte(pp_tmp, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            JSComp__Push(proto_slot)
            JSComp__Push(ctor_slot)
            pp_slot = JSComp__AddString(pp_tmp, 6)
            ctor_slot = JSComp__Pop()
            proto_slot = JSComp__Pop()
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()

            JSComp__EmitOp16(JSOp.SET_GLOBAL, pp_slot)
            // Stack: empty

            // Now: push proto (obj), push parent_proto (value), SET_PROP "__proto__"
            JSComp__EmitOp16(JSOp.GET_GLOBAL, proto_slot)
            JSComp__EmitOp16(JSOp.GET_GLOBAL, pp_slot)

            // "__proto__" string constant
            dpp_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(dpp_nm, 0, 95)
            SetByte(dpp_nm, 1, 95)
            SetByte(dpp_nm, 2, 112)
            SetByte(dpp_nm, 3, 114)
            SetByte(dpp_nm, 4, 111)
            SetByte(dpp_nm, 5, 116)
            SetByte(dpp_nm, 6, 111)
            SetByte(dpp_nm, 7, 95)
            SetByte(dpp_nm, 8, 95)
            SetByte(dpp_nm, 9, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            JSComp__Push(proto_slot)
            JSComp__Push(ctor_slot)
            dpp_ci = JSComp__AddString(dpp_nm, 9)
            ctor_slot = JSComp__Pop()
            proto_slot = JSComp__Pop()
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()

            JSComp__EmitOp16(JSOp.SET_PROP, dpp_ci)
            // Stack: empty
        } ElseBlock: {
            // No extends. Stack: [ctor] [proto]
            // Store proto and ctor as globals (not locals) to avoid slot corruption
            // at top-level where CountVars can't account for hidden locals.

            // Build "__cp__" string and add to const pool
            proto_nm2 = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(proto_nm2, 0, 95)
            SetByte(proto_nm2, 1, 95)
            SetByte(proto_nm2, 2, 99)
            SetByte(proto_nm2, 3, 112)
            SetByte(proto_nm2, 4, 95)
            SetByte(proto_nm2, 5, 95)
            SetByte(proto_nm2, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            proto_slot = JSComp__AddString(proto_nm2, 6)
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()

            // Build "__cc__" string and add to const pool
            ctor_nm2 = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(ctor_nm2, 0, 95)
            SetByte(ctor_nm2, 1, 95)
            SetByte(ctor_nm2, 2, 99)
            SetByte(ctor_nm2, 3, 99)
            SetByte(ctor_nm2, 4, 95)
            SetByte(ctor_nm2, 5, 95)
            SetByte(ctor_nm2, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            JSComp__Push(proto_slot)
            ctor_slot = JSComp__AddString(ctor_nm2, 6)
            proto_slot = JSComp__Pop()
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()

            // Stack: [ctor] [proto]. Store proto as global, then ctor as global.
            JSComp__EmitOp16(JSOp.SET_GLOBAL, proto_slot)
            JSComp__EmitOp16(JSOp.SET_GLOBAL, ctor_slot)
            // Stack: empty
        }

        // Now compile each method and set it on prototype or constructor
        method = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(method, 0) {
            mflags = JSParse_GetValue(method)
            // Skip constructor — already compiled
            IfCondition EqualTo(BitwiseAnd(mflags, 8), 0) ThenBlock: {
                is_static = BitwiseAnd(mflags, 1)
                is_getter = BitwiseAnd(mflags, 2)
                is_setter = BitwiseAnd(mflags, 4)

                // Push target object: prototype for instance, constructor for static
                IfCondition NotEqual(is_static, 0) ThenBlock: {
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
                } ElseBlock: {
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, proto_slot)
                }

                // Check if method has computed key (N_COND != -1)
                comp_key = JSParse_GetCond(method)

                // For computed methods: compile key expression BEFORE closure
                // Stack order for SET_PROP_COMPUTED: [obj, key, value]
                IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                    JSComp__Push(method)
                    JSComp__Push(proto_slot)
                    JSComp__Push(ctor_slot)
                    JSComp__CompileExpr(comp_key)
                    ctor_slot = JSComp__Pop()
                    proto_slot = JSComp__Pop()
                    method = JSComp__Pop()
                }

                // Compile method closure
                JSComp__Push(method)
                JSComp__Push(proto_slot)
                JSComp__Push(ctor_slot)
                JSComp__CompileFunc(method)
                ctor_slot = JSComp__Pop()
                proto_slot = JSComp__Pop()
                method = JSComp__Pop()

                // Emit property set — computed vs named
                comp_key = JSParse_GetCond(method)
                IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                    // Computed: stack is [obj, key, func]
                    IfCondition NotEqual(is_getter, 0) ThenBlock: {
                        JSComp__Emit1(JSOp.DEF_GETTER_COMPUTED)
                    } ElseBlock: {
                        IfCondition NotEqual(is_setter, 0) ThenBlock: {
                            JSComp__Emit1(JSOp.DEF_SETTER_COMPUTED)
                        } ElseBlock: {
                            JSComp__Emit1(JSOp.SET_PROP_COMPUTED)
                        }
                    }
                } ElseBlock: {
                    // Named: use string constant index
                    mnp = JSParse_GetNamePtr(method)
                    mnl = JSParse_GetNameLen(method)
                    JSComp__Push(method)
                    JSComp__Push(proto_slot)
                    JSComp__Push(ctor_slot)
                    mci = JSComp__AddString(mnp, mnl)
                    ctor_slot = JSComp__Pop()
                    proto_slot = JSComp__Pop()
                    method = JSComp__Pop()

                    // SET_PROP, DEF_GETTER, or DEF_SETTER
                    IfCondition NotEqual(is_getter, 0) ThenBlock: {
                        JSComp__EmitOp16(JSOp.DEF_GETTER, mci)
                    } ElseBlock: {
                        IfCondition NotEqual(is_setter, 0) ThenBlock: {
                            JSComp__EmitOp16(JSOp.DEF_SETTER, mci)
                        } ElseBlock: {
                            JSComp__EmitOp16(JSOp.SET_PROP, mci)
                        }
                    }
                }
            }
            method = JSParse_GetNext(method)
        }

        // Set ctor.prototype = proto
        JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
        JSComp__EmitOp16(JSOp.GET_GLOBAL, proto_slot)
        prot_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
        // "prototype" = 112 114 111 116 111 116 121 112 101
        SetByte(prot_nm, 0, 112)
        SetByte(prot_nm, 1, 114)
        SetByte(prot_nm, 2, 111)
        SetByte(prot_nm, 3, 116)
        SetByte(prot_nm, 4, 111)
        SetByte(prot_nm, 5, 116)
        SetByte(prot_nm, 6, 121)
        SetByte(prot_nm, 7, 112)
        SetByte(prot_nm, 8, 101)
        SetByte(prot_nm, 9, 0)
        JSCompState.str_pos = Add(JSCompState.str_pos, 10)
        JSComp__Push(save_node)
        JSComp__Push(proto_slot)
        JSComp__Push(ctor_slot)
        prot_ci = JSComp__AddString(prot_nm, 9)
        ctor_slot = JSComp__Pop()
        proto_slot = JSComp__Pop()
        save_node = JSComp__Pop()
        JSComp__EmitOp16(JSOp.SET_PROP, prot_ci)

        // Set proto.constructor = ctor
        JSComp__EmitOp16(JSOp.GET_GLOBAL, proto_slot)
        JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
        con_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
        // "constructor" = 99 111 110 115 116 114 117 99 116 111 114
        SetByte(con_nm, 0, 99)
        SetByte(con_nm, 1, 111)
        SetByte(con_nm, 2, 110)
        SetByte(con_nm, 3, 115)
        SetByte(con_nm, 4, 116)
        SetByte(con_nm, 5, 114)
        SetByte(con_nm, 6, 117)
        SetByte(con_nm, 7, 99)
        SetByte(con_nm, 8, 116)
        SetByte(con_nm, 9, 111)
        SetByte(con_nm, 10, 114)
        SetByte(con_nm, 11, 0)
        JSCompState.str_pos = Add(JSCompState.str_pos, 12)
        JSComp__Push(save_node)
        JSComp__Push(proto_slot)
        JSComp__Push(ctor_slot)
        con_ci = JSComp__AddString(con_nm, 11)
        ctor_slot = JSComp__Pop()
        proto_slot = JSComp__Pop()
        save_node = JSComp__Pop()
        JSComp__EmitOp16(JSOp.SET_PROP, con_ci)

        // --- Compile static fields and static blocks ---
        method = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(method, 0) {
            IfCondition EqualTo(JSParse_GetType(method), ASTType.CLASS_FIELD) ThenBlock: {
                mflags = JSParse_GetValue(method)

                // Static block: mflags bit 4 (value 16) + bit 0 (static)
                sb_flag = BitwiseAnd(mflags, 16)
                IfCondition NotEqual(sb_flag, 0) ThenBlock: {
                    // Compile the static block body inline
                    sb_body = JSParse_GetBody(method)
                    IfCondition GreaterEqual(sb_body, 0) ThenBlock: {
                        // Set 'this' = constructor for static block
                        JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
                        // Build "this" string: 116 104 105 115
                        sb_this_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                        SetByte(sb_this_nm, 0, 116)
                        SetByte(sb_this_nm, 1, 104)
                        SetByte(sb_this_nm, 2, 105)
                        SetByte(sb_this_nm, 3, 115)
                        SetByte(sb_this_nm, 4, 0)
                        JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                        JSComp__Push(method)
                        JSComp__Push(proto_slot)
                        JSComp__Push(ctor_slot)
                        ci_this = JSComp__AddString(sb_this_nm, 4)
                        ctor_slot = JSComp__Pop()
                        proto_slot = JSComp__Pop()
                        method = JSComp__Pop()
                        JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_this)
                        // Compile the block
                        JSComp__Push(method)
                        JSComp__Push(proto_slot)
                        JSComp__Push(ctor_slot)
                        JSComp__CompileBlock(sb_body)
                        ctor_slot = JSComp__Pop()
                        proto_slot = JSComp__Pop()
                        method = JSComp__Pop()
                    }
                }

                is_static = BitwiseAnd(mflags, 1)
                IfCondition And(NotEqual(is_static, 0), EqualTo(sb_flag, 0)) ThenBlock: {
                    // Static field: ctor.field = init
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
                    comp_key = JSParse_GetCond(method)
                    IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                        // Computed key: compile expression
                        JSComp__Push(method)
                        JSComp__Push(proto_slot)
                        JSComp__Push(ctor_slot)
                        JSComp__CompileExpr(comp_key)
                        ctor_slot = JSComp__Pop()
                        proto_slot = JSComp__Pop()
                        method = JSComp__Pop()
                    }
                    // Compile initializer or push undefined
                    field_init = JSParse_GetLeft(method)
                    IfCondition GreaterEqual(field_init, 0) ThenBlock: {
                        JSComp__Push(method)
                        JSComp__Push(proto_slot)
                        JSComp__Push(ctor_slot)
                        JSComp__CompileExpr(field_init)
                        ctor_slot = JSComp__Pop()
                        proto_slot = JSComp__Pop()
                        method = JSComp__Pop()
                    } ElseBlock: {
                        JSComp__Emit1(JSOp.PUSH_UNDEF)
                    }
                    // Set property
                    comp_key = JSParse_GetCond(method)
                    IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                        JSComp__Emit1(JSOp.SET_PROP_COMPUTED)
                    } ElseBlock: {
                        mnp = JSParse_GetNamePtr(method)
                        mnl = JSParse_GetNameLen(method)
                        JSComp__Push(method)
                        JSComp__Push(proto_slot)
                        JSComp__Push(ctor_slot)
                        mci = JSComp__AddString(mnp, mnl)
                        ctor_slot = JSComp__Pop()
                        proto_slot = JSComp__Pop()
                        method = JSComp__Pop()
                        JSComp__EmitOp16(JSOp.SET_PROP, mci)
                    }
                }
            }
            method = JSParse_GetNext(method)
        }

        // --- Compile instance fields as __field_init__ closure ---
        // Instance fields must be own properties set during construction,
        // not on the prototype. We compile a hidden closure that takes
        // this_obj as parameter and sets each field on it, then store it
        // on the prototype as "__field_init__". The VM's CONSTRUCT RETURN
        // path calls this after the constructor runs.
        has_inst_fields = 0
        method = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(method, 0) {
            IfCondition EqualTo(JSParse_GetType(method), ASTType.CLASS_FIELD) ThenBlock: {
                IfCondition EqualTo(BitwiseAnd(JSParse_GetValue(method), 1), 0) ThenBlock: {
                    has_inst_fields = 1
                }
            }
            method = JSParse_GetNext(method)
        }

        IfCondition EqualTo(has_inst_fields, 1) ThenBlock: {
            // Allocate function descriptor slot
            fi_idx = JSCompState.func_count
            IfCondition GreaterEqual(fi_idx, JSCompConst.MAX_FUNCS) ThenBlock: {
                JSCompState.error = 1
                ReturnValue(-1)
            }
            JSCompState.func_count = Add(fi_idx, 1)

            // JMP to skip the __field_init__ function body
            fi_skip = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP, 0)
            fi_start = JSCompState.code_pos

            // Function body: for each instance field, GET_LOCAL 0 (this_obj param),
            // compile initializer, SET_PROP
            method = JSParse_GetBody(save_node)
            WhileLoop GreaterEqual(method, 0) {
                IfCondition EqualTo(JSParse_GetType(method), ASTType.CLASS_FIELD) ThenBlock: {
                    mflags = JSParse_GetValue(method)
                    IfCondition EqualTo(BitwiseAnd(mflags, 1), 0) ThenBlock: {
                        // Instance field: this_obj.field = init
                        JSComp__EmitOp16(JSOp.GET_LOCAL, 0)

                        comp_key = JSParse_GetCond(method)
                        IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                            JSComp__Push(method)
                            JSComp__Push(proto_slot)
                            JSComp__Push(ctor_slot)
                            JSComp__CompileExpr(comp_key)
                            ctor_slot = JSComp__Pop()
                            proto_slot = JSComp__Pop()
                            method = JSComp__Pop()
                        }

                        field_init = JSParse_GetLeft(method)
                        IfCondition GreaterEqual(field_init, 0) ThenBlock: {
                            JSComp__Push(method)
                            JSComp__Push(proto_slot)
                            JSComp__Push(ctor_slot)
                            JSComp__CompileExpr(field_init)
                            ctor_slot = JSComp__Pop()
                            proto_slot = JSComp__Pop()
                            method = JSComp__Pop()
                        } ElseBlock: {
                            JSComp__Emit1(JSOp.PUSH_UNDEF)
                        }

                        comp_key = JSParse_GetCond(method)
                        IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                            JSComp__Emit1(JSOp.SET_PROP_COMPUTED)
                        } ElseBlock: {
                            mnp = JSParse_GetNamePtr(method)
                            mnl = JSParse_GetNameLen(method)
                            JSComp__Push(method)
                            JSComp__Push(proto_slot)
                            JSComp__Push(ctor_slot)
                            mci = JSComp__AddString(mnp, mnl)
                            ctor_slot = JSComp__Pop()
                            proto_slot = JSComp__Pop()
                            method = JSComp__Pop()
                            JSComp__EmitOp16(JSOp.SET_PROP, mci)
                        }
                    }
                }
                method = JSParse_GetNext(method)
            }

            JSComp__Emit1(JSOp.PUSH_UNDEF)
            JSComp__Emit1(JSOp.RETURN)

            // Patch JMP target
            JSComp__PatchJump(fi_skip)

            // Build func descriptor: 1 param (this_obj), 1 local
            fi_base = Add(JSCompState.func_pool, Multiply(fi_idx, JSCompConst.FUNC_SIZE))
            StoreValue(fi_base, fi_start)
            StoreValue(Add(fi_base, 8), 1)
            StoreValue(Add(fi_base, 16), 1)
            StoreValue(Add(fi_base, 24), 0)
            StoreValue(Add(fi_base, 32), 0)

            // Add to const pool as type 3 (FUNCTION)
            fi_ci = JSCompState.const_count
            IfCondition GreaterEqual(fi_ci, JSCompConst.MAX_CONSTS) ThenBlock: {
                JSCompState.error = 1
                ReturnValue(-1)
            }
            JSCompState.const_count = Add(fi_ci, 1)
            fi_cbase = Add(JSCompState.const_pool, Multiply(fi_ci, JSCompConst.CONST_SIZE))
            StoreValue(fi_cbase, 3)
            StoreValue(Add(fi_cbase, 8), fi_base)

            // Emit: GET_GLOBAL proto_slot; CLOSURE fi_ci; SET_PROP "__field_init__"
            JSComp__EmitOp16(JSOp.GET_GLOBAL, proto_slot)
            JSComp__EmitOp16(JSOp.CLOSURE, fi_ci)
            // Build "__field_init__" string constant
            fini_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            // "__field_init__" = 95 95 102 105 101 108 100 95 105 110 105 116 95 95
            SetByte(fini_nm, 0, 95)
            SetByte(fini_nm, 1, 95)
            SetByte(fini_nm, 2, 102)
            SetByte(fini_nm, 3, 105)
            SetByte(fini_nm, 4, 101)
            SetByte(fini_nm, 5, 108)
            SetByte(fini_nm, 6, 100)
            SetByte(fini_nm, 7, 95)
            SetByte(fini_nm, 8, 105)
            SetByte(fini_nm, 9, 110)
            SetByte(fini_nm, 10, 105)
            SetByte(fini_nm, 11, 116)
            SetByte(fini_nm, 12, 95)
            SetByte(fini_nm, 13, 95)
            SetByte(fini_nm, 14, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 15)
            JSComp__Push(proto_slot)
            JSComp__Push(ctor_slot)
            fini_ci = JSComp__AddString(fini_nm, 14)
            ctor_slot = JSComp__Pop()
            proto_slot = JSComp__Pop()
            JSComp__EmitOp16(JSOp.SET_PROP, fini_ci)
        }

        // If extends: store parent constructor as __super__ property on child ctor.
        // This allows the VM's CONSTRUCT handler to set __super__ at call time,
        // fixing multi-level inheritance where the global gets overwritten.
        IfCondition EqualTo(has_parent, 1) ThenBlock: {
            JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
            // Build "__super__" constant
            sp2_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            SetByte(sp2_nm, 0, 95)
            SetByte(sp2_nm, 1, 95)
            SetByte(sp2_nm, 2, 115)
            SetByte(sp2_nm, 3, 117)
            SetByte(sp2_nm, 4, 112)
            SetByte(sp2_nm, 5, 101)
            SetByte(sp2_nm, 6, 114)
            SetByte(sp2_nm, 7, 95)
            SetByte(sp2_nm, 8, 95)
            SetByte(sp2_nm, 9, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            JSComp__Push(save_node)
            JSComp__Push(ctor_slot)
            sp2_ci = JSComp__AddString(sp2_nm, 9)
            ctor_slot = JSComp__Pop()
            save_node = JSComp__Pop()
            // Stack: [ctor]. Now push the parent and SET_PROP.
            // __super__ global still holds the parent from class decl time.
            // Reuse the same constant for GET_GLOBAL and SET_PROP.
            JSComp__EmitOp16(JSOp.GET_GLOBAL, sp2_ci)
            // Stack: [ctor, parent_ctor]. Now SET_PROP "__super__" on ctor.
            // SET_PROP pops [obj, val] — but we need [obj] [val] with prop name.
            // Actually SET_PROP takes stack [obj, val] and const idx for name.
            JSComp__EmitOp16(JSOp.SET_PROP, sp2_ci)
        }

        // Push constructor as the class value (result of class expression)
        JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)

        ReturnValue(0)
    }
}

// ---------------------------------------------------------------------------
// Compile function — emit into separate code region, add to func_pool
// Leaves CLOSURE on stack.
// ---------------------------------------------------------------------------
Function.JSComp__CompileFunc {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node
        IfCondition EqualTo(JSCompState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Record function index
        fidx = JSCompState.func_count
        IfCondition GreaterEqual(fidx, JSCompConst.MAX_FUNCS) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        JSCompState.func_count = Add(fidx, 1)
        JSCompState.func_nesting = Add(JSCompState.func_nesting, 1)

        // Emit JMP to skip over function body in main code stream
        skip_jmp = JSCompState.code_pos
        JSComp__EmitOp16(JSOp.JMP, 0)

        // Save current code_pos — function code starts here
        func_start = JSCompState.code_pos

        // Save entire outer scope state — function locals must start at slot 0
        saved_scope_depth = JSCompState.scope_depth
        saved_scope_bytes = Multiply(saved_scope_depth, JSCompConst.SCOPE_SIZE)
        saved_locals_bytes = Multiply(saved_scope_depth, 8)
        saved_scope_stack = Allocate(Add(saved_scope_bytes, saved_locals_bytes))
        IfCondition GreaterThan(saved_scope_bytes, 0) ThenBlock: {
            MemoryCopy(saved_scope_stack, JSCompState.scope_stack, saved_scope_bytes)
        }
        IfCondition GreaterThan(saved_locals_bytes, 0) ThenBlock: {
            MemoryCopy(Add(saved_scope_stack, saved_scope_bytes), JSCompState.scope_locals, saved_locals_bytes)
        }
        JSCompState.scope_depth = 0

        // Save and clear TDZ map — outer scope's let/const marks must not
        // leak into the inner function (where slot 0 is a parameter, not
        // the outer scope's let/const variable).
        saved_tdz = Allocate(256)
        MemoryCopy(saved_tdz, JSCompState.tdz_map, 256)
        MemorySet(JSCompState.tdz_map, 0, 256)

        // Push scope for function body
        JSComp__PushScope()

        // Add parameters as locals
        // For pattern params (ARRAY_PATTERN, OBJECT_PATTERN), add synthetic temp name
        param = JSParse_GetLeft(save_node)
        param_count = 0
        WhileLoop GreaterEqual(param, 0) {
            pt = JSParse_GetType(param)
            IfCondition Or(EqualTo(pt, ASTType.ARRAY_PATTERN), EqualTo(pt, ASTType.OBJECT_PATTERN)) ThenBlock: {
                // Synthetic name: __pN__ where N is param_count digit
                synth_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(synth_ptr, 0, 95)
                SetByte(synth_ptr, 1, 95)
                SetByte(synth_ptr, 2, 112)
                SetByte(synth_ptr, 3, Add(48, param_count))
                SetByte(synth_ptr, 4, 95)
                SetByte(synth_ptr, 5, 95)
                SetByte(synth_ptr, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                JSComp__AddLocal(synth_ptr, 6)
            } ElseBlock: {
                IfCondition EqualTo(pt, ASTType.ASSIGN) ThenBlock: {
                    // ASSIGN wrapping a pattern or ident
                    inner = JSParse_GetRight(param)
                    inner_t = -1
                    IfCondition GreaterEqual(inner, 0) ThenBlock: {
                        inner_t = JSParse_GetType(inner)
                    }
                    IfCondition Or(EqualTo(inner_t, ASTType.ARRAY_PATTERN), EqualTo(inner_t, ASTType.OBJECT_PATTERN)) ThenBlock: {
                        synth_ptr2 = Add(JSCompState.str_buf, JSCompState.str_pos)
                        SetByte(synth_ptr2, 0, 95)
                        SetByte(synth_ptr2, 1, 95)
                        SetByte(synth_ptr2, 2, 112)
                        SetByte(synth_ptr2, 3, Add(48, param_count))
                        SetByte(synth_ptr2, 4, 95)
                        SetByte(synth_ptr2, 5, 95)
                        SetByte(synth_ptr2, 6, 0)
                        JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                        JSComp__AddLocal(synth_ptr2, 6)
                    } ElseBlock: {
                        // ASSIGN wrapping IDENT with default
                        pp = JSParse_GetNamePtr(param)
                        pl = JSParse_GetNameLen(param)
                        JSComp__AddLocal(pp, pl)
                    }
                } ElseBlock: {
                    IfCondition EqualTo(pt, ASTType.REST_ELEMENT) ThenBlock: {
                        // Rest parameter: add the binding name
                        rest_bind = JSParse_GetLeft(param)
                        pp = JSParse_GetNamePtr(rest_bind)
                        pl = JSParse_GetNameLen(rest_bind)
                        JSComp__AddLocal(pp, pl)
                    } ElseBlock: {
                        pp = JSParse_GetNamePtr(param)
                        pl = JSParse_GetNameLen(param)
                        JSComp__AddLocal(pp, pl)
                    }
                }
            }
            param_count = Add(param_count, 1)
            param = JSParse_GetNext(param)
        }

        // Emit default parameter initialization + destructuring
        param = JSParse_GetLeft(save_node)
        def_slot = 0
        WhileLoop GreaterEqual(param, 0) {
            pt = JSParse_GetType(param)

            // Pattern param — destructure from the slot
            IfCondition EqualTo(pt, ASTType.ARRAY_PATTERN) ThenBlock: {
                JSComp__CompileArrayPattern(param, def_slot)
            }
            IfCondition EqualTo(pt, ASTType.OBJECT_PATTERN) ThenBlock: {
                JSComp__CompileObjPattern(param, def_slot)
            }

            // ASSIGN: default value or pattern+default
            IfCondition EqualTo(pt, ASTType.ASSIGN) ThenBlock: {
                inner2 = JSParse_GetRight(param)
                inner2_t = -1
                IfCondition GreaterEqual(inner2, 0) ThenBlock: {
                    inner2_t = JSParse_GetType(inner2)
                }

                // Check if the param is undefined → apply default
                JSComp__EmitOp16(JSOp.GET_LOCAL, def_slot)
                JSComp__Emit1(JSOp.PUSH_UNDEF)
                JSComp__Emit1(JSOp.STRICT_EQ)
                def_skip = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                // Compile default expression (N_LEFT of ASSIGN)
                def_expr = JSParse_GetLeft(param)
                JSComp__Push(param)
                JSComp__Push(def_slot)
                JSComp__Push(def_skip)
                JSComp__CompileExpr(def_expr)
                def_skip = JSComp__Pop()
                def_slot = JSComp__Pop()
                param = JSComp__Pop()
                JSComp__EmitOp16(JSOp.SET_LOCAL, def_slot)
                JSComp__PatchJump(def_skip)

                // If inner is a pattern, destructure after default application
                IfCondition GreaterEqual(inner2, 0) ThenBlock: {
                    IfCondition EqualTo(inner2_t, ASTType.ARRAY_PATTERN) ThenBlock: {
                        JSComp__CompileArrayPattern(inner2, def_slot)
                    }
                    IfCondition EqualTo(inner2_t, ASTType.OBJECT_PATTERN) ThenBlock: {
                        JSComp__CompileObjPattern(inner2, def_slot)
                    }
                }
            }

            def_slot = Add(def_slot, 1)
            param = JSParse_GetNext(param)
        }

        // If this is a derived class constructor, add __super__ as hidden local
        // and capture the current __super__ global value into it.
        // This prevents multi-level inheritance from clobbering __super__.
        hidden_super_slot = -1
        IfCondition EqualTo(JSCompState.is_derived_ctor, 1) ThenBlock: {
            sup_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            // "__super__" = 95 95 115 117 112 101 114 95 95
            SetByte(sup_nm, 0, 95)
            SetByte(sup_nm, 1, 95)
            SetByte(sup_nm, 2, 115)
            SetByte(sup_nm, 3, 117)
            SetByte(sup_nm, 4, 112)
            SetByte(sup_nm, 5, 101)
            SetByte(sup_nm, 6, 114)
            SetByte(sup_nm, 7, 95)
            SetByte(sup_nm, 8, 95)
            SetByte(sup_nm, 9, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            hidden_super_slot = JSComp__AddLocal(sup_nm, 9)
            // Emit GET_GLOBAL "__super__" to read the current value
            JSComp__Push(save_node)
            sup_ci = JSComp__AddString(sup_nm, 9)
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.GET_GLOBAL, sup_ci)
            JSComp__EmitOp16(JSOp.SET_LOCAL, hidden_super_slot)
        }

        // Emit GET_LOCAL + SET_GLOBAL for each simple parameter so closures work
        param = JSParse_GetLeft(save_node)
        gslot = 0
        WhileLoop GreaterEqual(param, 0) {
            pt = JSParse_GetType(param)
            IfCondition Or(EqualTo(pt, ASTType.IDENT), EqualTo(pt, ASTType.VAR_DECL)) ThenBlock: {
                pp = JSParse_GetNamePtr(param)
                pl = JSParse_GetNameLen(param)
                IfCondition GreaterThan(pl, 0) ThenBlock: {
                    JSComp__EmitOp16(JSOp.GET_LOCAL, gslot)
                    JSComp__Push(param)
                    ci_pg = JSComp__AddString(pp, pl)
                    param = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_pg)
                }
            }
            gslot = Add(gslot, 1)
            param = JSParse_GetNext(param)
        }

        // Compile function body
        body = JSParse_GetBody(save_node)
        IfCondition GreaterEqual(body, 0) ThenBlock: {
            // Body is a BLOCK node — compile its statements
            bstmt = JSParse_GetBody(body)
            WhileLoop GreaterEqual(bstmt, 0) {
                JSComp__Push(bstmt)
                JSComp__CompileNode(bstmt)
                bstmt = JSComp__Pop()
                bstmt = JSParse_GetNext(bstmt)
            }
        }

        // Implicit return undefined at end of function
        JSComp__Emit1(JSOp.PUSH_UNDEF)
        JSComp__Emit1(JSOp.RETURN)

        // Patch JMP to skip over function body — target is current code_pos
        JSComp__PatchJump(skip_jmp)

        // Count ALL locals (including nested scopes like for-loop vars)
        // var is function-scoped, so nested vars need slots too
        JSComp__Push(save_node)
        JSComp__Push(param_count)
        local_count = JSComp__CountVars(JSParse_GetBody(save_node))
        param_count = JSComp__Pop()
        save_node = JSComp__Pop()
        // Include parameters in the count
        local_count = Add(local_count, param_count)
        // Add 1 for hidden __super__ local if this is a derived constructor
        IfCondition GreaterEqual(hidden_super_slot, 0) ThenBlock: {
            local_count = Add(local_count, 1)
        }

        JSComp__PopScope()

        // Restore outer scope state
        JSCompState.scope_depth = saved_scope_depth
        IfCondition GreaterThan(saved_scope_bytes, 0) ThenBlock: {
            MemoryCopy(JSCompState.scope_stack, saved_scope_stack, saved_scope_bytes)
        }
        IfCondition GreaterThan(saved_locals_bytes, 0) ThenBlock: {
            MemoryCopy(JSCompState.scope_locals, Add(saved_scope_stack, saved_scope_bytes), saved_locals_bytes)
        }
        Deallocate(saved_scope_stack, Add(saved_scope_bytes, saved_locals_bytes))

        // Restore outer TDZ map
        MemoryCopy(JSCompState.tdz_map, saved_tdz, 256)
        Deallocate(saved_tdz, 256)

        // Build function descriptor in func_pool
        fbase = Add(JSCompState.func_pool, Multiply(fidx, JSCompConst.FUNC_SIZE))
        StoreValue(fbase, func_start)
        StoreValue(Add(fbase, 8), param_count)
        StoreValue(Add(fbase, 16), local_count)

        // Function name (if any)
        fnp = JSParse_GetNamePtr(save_node)
        fnl = JSParse_GetNameLen(save_node)
        StoreValue(Add(fbase, 24), fnp)
        StoreValue(Add(fbase, 32), fnl)

        // Add function descriptor to const pool as type 3 = FUNCTION
        ci = JSCompState.const_count
        IfCondition GreaterEqual(ci, JSCompConst.MAX_CONSTS) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        JSCompState.const_count = Add(ci, 1)
        cbase = Add(JSCompState.const_pool, Multiply(ci, JSCompConst.CONST_SIZE))
        StoreValue(cbase, 3)
        StoreValue(Add(cbase, 8), fbase)

        // Emit CLOSURE, GEN_CLOSURE, ASYNC_CLOSURE, or ASYNC_GEN_CLOSURE
        func_ntype = JSParse_GetType(save_node)
        IfCondition Or(EqualTo(func_ntype, ASTType.GEN_FUNC_DECL), EqualTo(func_ntype, ASTType.GEN_FUNC_EXPR)) ThenBlock: {
            JSComp__EmitOp16(JSOp.GEN_CLOSURE, ci)
        } ElseBlock: {
            IfCondition Or(EqualTo(func_ntype, ASTType.ASYNC_FUNC_DECL), EqualTo(func_ntype, ASTType.ASYNC_FUNC_EXPR)) ThenBlock: {
                // Check N_OP: 0=async, 1=async generator
                func_nop = JSParse_GetOp(save_node)
                IfCondition EqualTo(func_nop, 1) ThenBlock: {
                    JSComp__EmitOp16(JSOp.ASYNC_GEN_CLOSURE, ci)
                } ElseBlock: {
                    JSComp__EmitOp16(JSOp.ASYNC_CLOSURE, ci)
                }
            } ElseBlock: {
                JSComp__EmitOp16(JSOp.CLOSURE, ci)
            }
        }

        JSCompState.func_nesting = Subtract(JSCompState.func_nesting, 1)
        ReturnValue(0)
    }
}

// =============================================================================
// PUBLIC API
// =============================================================================

// Compile AST from root node. Returns 1 on success, 0 on error.
Function.JSComp_Compile {
    Input: root: Integer
    Output: Integer
    Body: {
        save_root = root
        JSCompState.error = 0
        JSCompState.code_pos = 0
        JSCompState.const_count = 0
        JSCompState.scope_depth = 0
        JSCompState.func_count = 0
        JSCompState.loop_depth = 0
        JSCompState.str_pos = 0
        JSCompStack.sp = 0

        JSComp__CompileNode(save_root)

        IfCondition EqualTo(JSCompState.error, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// Return pointer to bytecode buffer
Function.JSComp_GetCode {
    Output: Address
    Body: {
        ReturnValue(JSCompState.code)
    }
}

// Return bytecode length
Function.JSComp_GetCodeLen {
    Output: Integer
    Body: {
        ReturnValue(JSCompState.code_pos)
    }
}

// Return pointer to constant pool entry at index
Function.JSComp_GetConst {
    Input: idx: Integer
    Output: Address
    Body: {
        save_idx = idx
        ReturnValue(Add(JSCompState.const_pool, Multiply(save_idx, JSCompConst.CONST_SIZE)))
    }
}

// Return constant pool count
Function.JSComp_GetConstCount {
    Output: Integer
    Body: {
        ReturnValue(JSCompState.const_count)
    }
}

// Return pointer to function descriptor at index
Function.JSComp_GetFunc {
    Input: idx: Integer
    Output: Address
    Body: {
        save_idx = idx
        ReturnValue(Add(JSCompState.func_pool, Multiply(save_idx, JSCompConst.FUNC_SIZE)))
    }
}

// Return function descriptor count
Function.JSComp_GetFuncCount {
    Output: Integer
    Body: {
        ReturnValue(JSCompState.func_count)
    }
}

// Return error flag
Function.JSComp_HasError {
    Output: Integer
    Body: {
        ReturnValue(JSCompState.error)
    }
}

// =============================================================================
// DESTRUCTURING PATTERN COMPILATION
// =============================================================================

// Compile array destructuring pattern: [a, b, ...rest] = src
// src_slot = local slot holding the RHS value (an array or iterable)
// pat_node = ARRAY_PATTERN node whose N_LEFT is the first element
Function.JSComp__CompileArrayPattern {
    Input: pat_node: Integer
    Input: src_slot: Integer
    Output: Integer
    Body: {
        save_pat = pat_node
        save_src = src_slot
        // Walk elements linked by N_NEXT
        elem = JSParse_GetLeft(save_pat)
        elem_idx = 0

        WhileLoop GreaterEqual(elem, 0) {
            etyp = JSParse_GetType(elem)

            // Skip holes (NULL_LIT) — just increment index
            IfCondition EqualTo(etyp, ASTType.NULL_LIT) ThenBlock: {
                elem_idx = Add(elem_idx, 1)
                elem = JSParse_GetNext(elem)
            }

            // REST_ELEMENT: ...rest — collect remaining elements into new array
            IfCondition EqualTo(etyp, ASTType.REST_ELEMENT) ThenBlock: {
                rest_target = JSParse_GetLeft(elem)
                rest_type = JSParse_GetType(rest_target)

                // Allocate temp locals for loop: __ri__ (index), __rl__ (length)
                ri_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(ri_ptr, 0, 95)
                SetByte(ri_ptr, 1, 95)
                SetByte(ri_ptr, 2, 114)
                SetByte(ri_ptr, 3, 105)
                SetByte(ri_ptr, 4, 95)
                SetByte(ri_ptr, 5, 95)
                SetByte(ri_ptr, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)

                rl_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(rl_ptr, 0, 95)
                SetByte(rl_ptr, 1, 95)
                SetByte(rl_ptr, 2, 114)
                SetByte(rl_ptr, 3, 108)
                SetByte(rl_ptr, 4, 95)
                SetByte(rl_ptr, 5, 95)
                SetByte(rl_ptr, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)

                ra_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(ra_ptr, 0, 95)
                SetByte(ra_ptr, 1, 95)
                SetByte(ra_ptr, 2, 114)
                SetByte(ra_ptr, 3, 97)
                SetByte(ra_ptr, 4, 95)
                SetByte(ra_ptr, 5, 95)
                SetByte(ra_ptr, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)

                JSComp__Push(save_src)
                JSComp__Push(elem)
                JSComp__Push(elem_idx)

                ri_slot = JSComp__AddLocal(ri_ptr, 6)
                rl_slot = JSComp__AddLocal(rl_ptr, 6)
                ra_slot = JSComp__AddLocal(ra_ptr, 6)

                elem_idx = JSComp__Pop()
                elem = JSComp__Pop()
                save_src = JSComp__Pop()

                // __ri__ = elem_idx
                ri_ci = JSComp__AddNumber(elem_idx)
                JSComp__EmitOp16(JSOp.PUSH_CONST, ri_ci)
                JSComp__EmitOp16(JSOp.SET_LOCAL, ri_slot)

                // __rl__ = src.length (use GET_PROP "length")
                JSComp__EmitOp16(JSOp.GET_LOCAL, save_src)
                len_str_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(len_str_ptr, 0, 108)
                SetByte(len_str_ptr, 1, 101)
                SetByte(len_str_ptr, 2, 110)
                SetByte(len_str_ptr, 3, 103)
                SetByte(len_str_ptr, 4, 116)
                SetByte(len_str_ptr, 5, 104)
                SetByte(len_str_ptr, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                len_ci = JSComp__AddString(len_str_ptr, 6)
                JSComp__EmitOp16(JSOp.GET_PROP, len_ci)
                JSComp__EmitOp16(JSOp.SET_LOCAL, rl_slot)

                // __ra__ = new array
                JSComp__EmitOp16(JSOp.NEW_ARRAY, 0)
                JSComp__EmitOp16(JSOp.SET_LOCAL, ra_slot)

                // Loop: while (__ri__ < __rl__)
                loop_top = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.GET_LOCAL, ri_slot)
                JSComp__EmitOp16(JSOp.GET_LOCAL, rl_slot)
                JSComp__Emit1(JSOp.LT)
                loop_exit = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP_FALSE, 0)

                // __ra__.push(src[__ri__])
                JSComp__EmitOp16(JSOp.GET_LOCAL, ra_slot)
                JSComp__EmitOp16(JSOp.GET_LOCAL, save_src)
                JSComp__EmitOp16(JSOp.GET_LOCAL, ri_slot)
                JSComp__Emit1(JSOp.GET_ELEM)
                JSComp__Emit1(JSOp.ARR_APPEND)
                JSComp__Emit1(JSOp.POP)

                // __ri__ = __ri__ + 1
                JSComp__EmitOp16(JSOp.GET_LOCAL, ri_slot)
                one_ci = JSComp__AddNumber(1)
                JSComp__EmitOp16(JSOp.PUSH_CONST, one_ci)
                JSComp__Emit1(JSOp.ADD)
                JSComp__EmitOp16(JSOp.SET_LOCAL, ri_slot)

                // Jump back to top
                JSComp__EmitOp16(JSOp.JMP, loop_top)
                // Patch exit
                JSComp__PatchJump(loop_exit, JSCompState.code_pos)

                // Bind rest array to target variable or pattern
                IfCondition EqualTo(rest_type, ASTType.IDENT) ThenBlock: {
                    JSComp__EmitOp16(JSOp.GET_LOCAL, ra_slot)
                    rnp = JSParse_GetNamePtr(rest_target)
                    rnl = JSParse_GetNameLen(rest_target)
                    JSComp__Push(save_src)
                    JSComp__Push(elem)
                    JSComp__EmitVarSet(rnp, rnl)
                    elem = JSComp__Pop()
                    save_src = JSComp__Pop()
                }
                IfCondition EqualTo(rest_type, ASTType.ARRAY_PATTERN) ThenBlock: {
                    // ...[ a, b ] — destructure rest array with array pattern
                    JSComp__Push(save_src)
                    JSComp__Push(elem)
                    JSComp__CompileArrayPattern(rest_target, ra_slot)
                    elem = JSComp__Pop()
                    save_src = JSComp__Pop()
                }
                IfCondition EqualTo(rest_type, ASTType.OBJECT_PATTERN) ThenBlock: {
                    // ...{ 0: v, length: z } — destructure rest array with object pattern
                    JSComp__Push(save_src)
                    JSComp__Push(elem)
                    JSComp__CompileObjPattern(rest_target, ra_slot)
                    elem = JSComp__Pop()
                    save_src = JSComp__Pop()
                }

                elem = -1
            }

            // ASSIGN: element with default value (N_RIGHT = target, N_LEFT = default)
            IfCondition EqualTo(etyp, ASTType.ASSIGN) ThenBlock: {
                target_nd = JSParse_GetRight(elem)
                def_nd = JSParse_GetLeft(elem)
                target_type = JSParse_GetType(target_nd)

                // Get the element: src[idx]
                JSComp__EmitOp16(JSOp.GET_LOCAL, save_src)
                idx_ci = JSComp__AddNumber(elem_idx)
                JSComp__EmitOp16(JSOp.PUSH_CONST, idx_ci)
                JSComp__Emit1(JSOp.GET_ELEM)

                // Check if undefined, apply default
                JSComp__Emit1(JSOp.DUP)
                JSComp__Emit1(JSOp.PUSH_UNDEF)
                JSComp__Emit1(JSOp.STRICT_EQ)
                skip_def = JSCompState.code_pos
                JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                // Pop the undefined, compile default
                JSComp__Emit1(JSOp.POP)
                JSComp__Push(save_src)
                JSComp__Push(elem)
                JSComp__Push(elem_idx)
                JSComp__CompileExpr(def_nd)
                elem_idx = JSComp__Pop()
                elem = JSComp__Pop()
                save_src = JSComp__Pop()
                // Patch skip
                JSComp__PatchJump(skip_def, JSCompState.code_pos)

                // Bind to target
                IfCondition EqualTo(target_type, ASTType.IDENT) ThenBlock: {
                    tnp = JSParse_GetNamePtr(target_nd)
                    tnl = JSParse_GetNameLen(target_nd)
                    JSComp__Push(save_src)
                    JSComp__Push(elem)
                    JSComp__Push(elem_idx)
                    JSComp__EmitVarSet(tnp, tnl)
                    elem_idx = JSComp__Pop()
                    elem = JSComp__Pop()
                    save_src = JSComp__Pop()
                } ElseBlock: {
                    IfCondition EqualTo(target_type, ASTType.ARRAY_PATTERN) ThenBlock: {
                        // Nested array destructuring
                        tmp_nm_ptr = Add(JSCompState.str_buf, JSCompState.str_pos)
                        SetByte(tmp_nm_ptr, 0, 95)
                        SetByte(tmp_nm_ptr, 1, 95)
                        SetByte(tmp_nm_ptr, 2, 100)
                        SetByte(tmp_nm_ptr, 3, Add(48, elem_idx))
                        SetByte(tmp_nm_ptr, 4, 95)
                        SetByte(tmp_nm_ptr, 5, 95)
                        SetByte(tmp_nm_ptr, 6, 0)
                        JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                        JSComp__Push(save_src)
                        JSComp__Push(elem)
                        JSComp__Push(elem_idx)
                        nsub_slot = JSComp__AddLocal(tmp_nm_ptr, 6)
                        JSComp__EmitOp16(JSOp.SET_LOCAL, nsub_slot)
                        JSComp__CompileArrayPattern(target_nd, nsub_slot)
                        elem_idx = JSComp__Pop()
                        elem = JSComp__Pop()
                        save_src = JSComp__Pop()
                    } ElseBlock: {
                        IfCondition EqualTo(target_type, ASTType.OBJECT_PATTERN) ThenBlock: {
                            tmp_nm_ptr2 = Add(JSCompState.str_buf, JSCompState.str_pos)
                            SetByte(tmp_nm_ptr2, 0, 95)
                            SetByte(tmp_nm_ptr2, 1, 95)
                            SetByte(tmp_nm_ptr2, 2, 111)
                            SetByte(tmp_nm_ptr2, 3, Add(48, elem_idx))
                            SetByte(tmp_nm_ptr2, 4, 95)
                            SetByte(tmp_nm_ptr2, 5, 95)
                            SetByte(tmp_nm_ptr2, 6, 0)
                            JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                            JSComp__Push(save_src)
                            JSComp__Push(elem)
                            JSComp__Push(elem_idx)
                            osub_slot = JSComp__AddLocal(tmp_nm_ptr2, 6)
                            JSComp__EmitOp16(JSOp.SET_LOCAL, osub_slot)
                            JSComp__CompileObjPattern(target_nd, osub_slot)
                            elem_idx = JSComp__Pop()
                            elem = JSComp__Pop()
                            save_src = JSComp__Pop()
                        }
                    }
                }

                elem_idx = Add(elem_idx, 1)
                elem = JSParse_GetNext(elem)
            }

            // IDENT: simple binding
            IfCondition EqualTo(etyp, ASTType.IDENT) ThenBlock: {
                // Get element: src[idx]
                JSComp__EmitOp16(JSOp.GET_LOCAL, save_src)
                idx_ci2 = JSComp__AddNumber(elem_idx)
                JSComp__EmitOp16(JSOp.PUSH_CONST, idx_ci2)
                JSComp__Emit1(JSOp.GET_ELEM)

                // Set local for the binding
                enp = JSParse_GetNamePtr(elem)
                enl = JSParse_GetNameLen(elem)
                JSComp__Push(save_src)
                JSComp__Push(elem)
                JSComp__Push(elem_idx)
                JSComp__EmitVarSet(enp, enl)
                elem_idx = JSComp__Pop()
                elem = JSComp__Pop()
                save_src = JSComp__Pop()

                elem_idx = Add(elem_idx, 1)
                elem = JSParse_GetNext(elem)
            }

            // Nested ARRAY_PATTERN
            IfCondition EqualTo(etyp, ASTType.ARRAY_PATTERN) ThenBlock: {
                JSComp__EmitOp16(JSOp.GET_LOCAL, save_src)
                idx_ci3 = JSComp__AddNumber(elem_idx)
                JSComp__EmitOp16(JSOp.PUSH_CONST, idx_ci3)
                JSComp__Emit1(JSOp.GET_ELEM)

                // Store in temp, recurse
                tmp_nm3 = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(tmp_nm3, 0, 95)
                SetByte(tmp_nm3, 1, 95)
                SetByte(tmp_nm3, 2, 97)
                SetByte(tmp_nm3, 3, Add(48, elem_idx))
                SetByte(tmp_nm3, 4, 95)
                SetByte(tmp_nm3, 5, 95)
                SetByte(tmp_nm3, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                JSComp__Push(save_src)
                JSComp__Push(elem)
                JSComp__Push(elem_idx)
                sub_slot = JSComp__AddLocal(tmp_nm3, 6)
                JSComp__EmitOp16(JSOp.SET_LOCAL, sub_slot)
                JSComp__CompileArrayPattern(elem, sub_slot)
                elem_idx = JSComp__Pop()
                elem = JSComp__Pop()
                save_src = JSComp__Pop()

                elem_idx = Add(elem_idx, 1)
                elem = JSParse_GetNext(elem)
            }

            // Nested OBJECT_PATTERN
            IfCondition EqualTo(etyp, ASTType.OBJECT_PATTERN) ThenBlock: {
                JSComp__EmitOp16(JSOp.GET_LOCAL, save_src)
                idx_ci4 = JSComp__AddNumber(elem_idx)
                JSComp__EmitOp16(JSOp.PUSH_CONST, idx_ci4)
                JSComp__Emit1(JSOp.GET_ELEM)

                tmp_nm4 = Add(JSCompState.str_buf, JSCompState.str_pos)
                SetByte(tmp_nm4, 0, 95)
                SetByte(tmp_nm4, 1, 95)
                SetByte(tmp_nm4, 2, 111)
                SetByte(tmp_nm4, 3, Add(48, elem_idx))
                SetByte(tmp_nm4, 4, 95)
                SetByte(tmp_nm4, 5, 95)
                SetByte(tmp_nm4, 6, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                JSComp__Push(save_src)
                JSComp__Push(elem)
                JSComp__Push(elem_idx)
                osub_slot2 = JSComp__AddLocal(tmp_nm4, 6)
                JSComp__EmitOp16(JSOp.SET_LOCAL, osub_slot2)
                JSComp__CompileObjPattern(elem, osub_slot2)
                elem_idx = JSComp__Pop()
                elem = JSComp__Pop()
                save_src = JSComp__Pop()

                elem_idx = Add(elem_idx, 1)
                elem = JSParse_GetNext(elem)
            }
        }
        ReturnValue(0)
    }
}

// Compile object destructuring pattern: {a, b: c} = src
// src_slot = local slot holding the RHS value (an object)
// pat_node = OBJECT_PATTERN node whose N_LEFT is the first PROPERTY
Function.JSComp__CompileObjPattern {
    Input: pat_node: Integer
    Input: src_slot: Integer
    Output: Integer
    Body: {
        save_pat = pat_node
        save_src = src_slot
        // Walk properties linked by N_NEXT
        prop = JSParse_GetLeft(save_pat)

        WhileLoop GreaterEqual(prop, 0) {
            ptyp = JSParse_GetType(prop)

            // REST_ELEMENT: ...rest — collect remaining props
            IfCondition EqualTo(ptyp, ASTType.REST_ELEMENT) ThenBlock: {
                // Skip for now
                prop = -1
            }

            // PROPERTY: {key: binding} or {key} (shorthand)
            IfCondition EqualTo(ptyp, ASTType.PROPERTY) ThenBlock: {
                // Get property from source object: src.key
                JSComp__EmitOp16(JSOp.GET_LOCAL, save_src)
                pnp = JSParse_GetNamePtr(prop)
                pnl = JSParse_GetNameLen(prop)
                JSComp__Push(save_src)
                JSComp__Push(prop)
                pci = JSComp__AddString(pnp, pnl)
                prop = JSComp__Pop()
                save_src = JSComp__Pop()
                JSComp__EmitOp16(JSOp.GET_PROP, pci)

                // Check for default value (N_RIGHT of PROPERTY)
                def_nd2 = JSParse_GetRight(prop)
                IfCondition GreaterEqual(def_nd2, 0) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    JSComp__Emit1(JSOp.PUSH_UNDEF)
                    JSComp__Emit1(JSOp.STRICT_EQ)
                    skip_def2 = JSCompState.code_pos
                    JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                    JSComp__Emit1(JSOp.POP)
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    JSComp__CompileExpr(def_nd2)
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                    JSComp__PatchJump(skip_def2, JSCompState.code_pos)
                }

                // Get the binding target from N_LEFT
                binding_nd = JSParse_GetLeft(prop)
                btype = JSParse_GetType(binding_nd)

                IfCondition EqualTo(btype, ASTType.IDENT) ThenBlock: {
                    bnp = JSParse_GetNamePtr(binding_nd)
                    bnl = JSParse_GetNameLen(binding_nd)
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    JSComp__EmitVarSet(bnp, bnl)
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                } ElseBlock: {
                    IfCondition EqualTo(btype, ASTType.ARRAY_PATTERN) ThenBlock: {
                        tmp_nm5 = Add(JSCompState.str_buf, JSCompState.str_pos)
                        SetByte(tmp_nm5, 0, 95)
                        SetByte(tmp_nm5, 1, 95)
                        SetByte(tmp_nm5, 2, 112)
                        SetByte(tmp_nm5, 3, 95)
                        SetByte(tmp_nm5, 4, 95)
                        SetByte(tmp_nm5, 5, 0)
                        JSCompState.str_pos = Add(JSCompState.str_pos, 6)
                        JSComp__Push(save_src)
                        JSComp__Push(prop)
                        asub_slot = JSComp__AddLocal(tmp_nm5, 5)
                        JSComp__EmitOp16(JSOp.SET_LOCAL, asub_slot)
                        JSComp__CompileArrayPattern(binding_nd, asub_slot)
                        prop = JSComp__Pop()
                        save_src = JSComp__Pop()
                    } ElseBlock: {
                        IfCondition EqualTo(btype, ASTType.OBJECT_PATTERN) ThenBlock: {
                            tmp_nm6 = Add(JSCompState.str_buf, JSCompState.str_pos)
                            SetByte(tmp_nm6, 0, 95)
                            SetByte(tmp_nm6, 1, 95)
                            SetByte(tmp_nm6, 2, 113)
                            SetByte(tmp_nm6, 3, 95)
                            SetByte(tmp_nm6, 4, 95)
                            SetByte(tmp_nm6, 5, 0)
                            JSCompState.str_pos = Add(JSCompState.str_pos, 6)
                            JSComp__Push(save_src)
                            JSComp__Push(prop)
                            osub_slot3 = JSComp__AddLocal(tmp_nm6, 5)
                            JSComp__EmitOp16(JSOp.SET_LOCAL, osub_slot3)
                            JSComp__CompileObjPattern(binding_nd, osub_slot3)
                            prop = JSComp__Pop()
                            save_src = JSComp__Pop()
                        }
                    }
                }

                prop = JSParse_GetNext(prop)
            }
        }
        ReturnValue(0)
    }
}
