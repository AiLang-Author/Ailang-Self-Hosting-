// Library.JSCompStmtPart3.ailang
// Functions moved out of Library.JSCompStmt.ailang.
// Split from the JS engine so one function fits in context.
// FixedPools stay in the parent library. Function names are unchanged
// except for the new helpers this split adds.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.


// ---------------------------------------------------------------------------
// Compile class declaration or expression.
// Emits bytecode that leaves the constructor function on the stack.
// Layout:
//   1. Compile constructor method (or default ctor) -> CLOSURE on stack
//   2. DUP constructor, create prototype object, SET_PROP "prototype"
//   3. For each method: compile CLOSURE, SET_PROP on prototype
//   4. For each static: compile CLOSURE, SET_PROP on constructor
//   5. For getters/setters: DEF_GETTER/DEF_SETTER on prototype/constructor
//   6. If extends: set __proto__ on prototype to parent.prototype
//   7. Result: constructor function with .prototype set up
// ---------------------------------------------------------------------------
Function.JSComp__CompileClass {
    Input: node: Integer
    Output: Integer
    Body: {
        save_node = node
        IfCondition EqualTo(JSCompState.error, 1) ThenBlock: { ReturnValue(-1) }

        // M74: class name lexical binding (immutable) for methods/heritage free-vars
        cnp = JSParse_GetNamePtr(save_node)
        cnl = JSParse_GetNameLen(save_node)
        has_cname = 0
        IfCondition And(NotEqual(cnp, 0), GreaterThan(cnl, 0)) ThenBlock: {
            has_cname = 1
            JSCompState.class_name_ptr = cnp
            JSCompState.class_name_len = cnl
            // Immutable binding enforced in EmitVarSet free-var path (not global
            // RegisterConstName — that blocked outer class-decl reassignment).
            // Runtime classScope: NewDeclarativeEnvironment + immutable name (TDZ first)
            JSComp__Emit1(JSOp.PUSH_TDZ_UNINIT)
            JSComp__Push(save_node)
            JSComp__Push(has_cname)
            cn_ci0 = JSComp__AddString(cnp, cnl)
            has_cname = JSComp__Pop()
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.FRESH_LET_ENV, cn_ci0)
        } ElseBlock: {
            JSCompState.class_name_ptr = 0
            JSCompState.class_name_len = 0
        }

        // If extends, compile parent expression first (before private brand mint)
        // Heritage runs under classScope so nested free-vars see class name.
        parent_n = JSParse_GetLeft(save_node)
        has_parent = 0
        IfCondition GreaterEqual(parent_n, 0) ThenBlock: {
            has_parent = 1
            JSComp__Push(save_node)
            JSComp__Push(has_cname)
            JSComp__CompileExpr(parent_n)
            has_cname = JSComp__Pop()
            save_node = JSComp__Pop()
            // M100: IsConstructor(superclass) before .prototype lookup
            JSComp__Emit1(JSOp.CHECK_CTOR)
            // Parent constructor is now on stack. DUP and store as __super__
            // so child constructor can call super() via GET_GLOBAL.
            JSComp__Emit1(JSOp.DUP)
            sp_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            // "__super__" = 95 95 115 117 112 101 114 95 95
            WRMEM_8(sp_nm, 0, 95)
            WRMEM_8(sp_nm, 1, 95)
            WRMEM_8(sp_nm, 2, 115)
            WRMEM_8(sp_nm, 3, 117)
            WRMEM_8(sp_nm, 4, 112)
            WRMEM_8(sp_nm, 5, 101)
            WRMEM_8(sp_nm, 6, 114)
            WRMEM_8(sp_nm, 7, 95)
            WRMEM_8(sp_nm, 8, 95)
            WRMEM_8(sp_nm, 9, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            JSComp__Push(save_node)
            JSComp__Push(has_cname)
            sp_ci = JSComp__AddString(sp_nm, 9)
            has_cname = JSComp__Pop()
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.SET_GLOBAL, sp_ci)
        }

        // M26k.5/7: push private brand frame + collect declared private names
        prev_priv = JSCompState.priv_class_id
        JSCompState.priv_class_id = JSCompState.next_priv_class_id
        JSCompState.next_priv_class_id = Add(JSCompState.next_priv_class_id, 1)
        JSCompState.priv_depth = Add(JSCompState.priv_depth, 1)
        cur_pd = JSCompState.priv_depth
        IfCondition LessThan(cur_pd, 16) ThenBlock: {
            WRMEM_64(JSCompState.priv_stack_ids, Multiply(cur_pd, 8), JSCompState.priv_class_id)
        }
        // Collect private names from methods/fields of this class
        method = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(method, 0) {
            mnp = JSParse_GetNamePtr(method)
            mnl = JSParse_GetNameLen(method)
            IfCondition And(NotEqual(mnp, 0), GreaterThan(mnl, 0)) ThenBlock: {
                IfCondition EqualTo(RDMEM_8(mnp, 0), 35) ThenBlock: {
                    IfCondition LessThan(JSCompState.priv_name_count, 64) ThenBlock: {
                        ni = JSCompState.priv_name_count
                        WRMEM_64(JSCompState.priv_name_ptrs, Multiply(ni, 8), mnp)
                        WRMEM_64(JSCompState.priv_name_lens, Multiply(ni, 8), mnl)
                        WRMEM_64(JSCompState.priv_name_depths, Multiply(ni, 8), cur_pd)
                        JSCompState.priv_name_count = Add(ni, 1)
                    }
                }
            }
            method = JSParse_GetNext(method)
        }

        // M128e7x: ClassBody is always strict (nested functions, undeclared assigns).
        // Heritage already evaluated above under outer mode.
        saved_class_strict = JSCompState.is_strict
        JSCompState.is_strict = 1

        // Walk methods to find constructor
        method = JSParse_GetBody(save_node)
        ctor_node = -1
        WhileLoop GreaterEqual(method, 0) {
            mflags = JSParse_GetValue(method)
            // bit 3 (8) = constructor
            IfCondition NotEqual(BitwiseAnd(mflags, 8), 0) ThenBlock: {
                ctor_node = method
            }
            method = JSParse_GetNext(method)
        }

        // Compile constructor
        ctor_fidx = -1
        IfCondition GreaterEqual(ctor_node, 0) ThenBlock: {
            // User-defined constructor — flag it as derived if extends
            IfCondition EqualTo(has_parent, 1) ThenBlock: {
                JSCompState.is_derived_ctor = 1
            }
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            // M128e7x: mark MethodDefinition so CompileFunc is_strict for nested fns
            ctor_mop = JSParse_GetOp(ctor_node)
            JSParse__NodeSet(ctor_node, ASTConst.N_OP, BitwiseOr(ctor_mop, 4))
            ctor_fidx_pre = JSCompState.func_count
            JSComp__CompileFunc(ctor_node)
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()
            JSCompState.is_derived_ctor = 0
            // M128e7br: ctor is first fidx; nested fns take later slots
            ctor_fidx = ctor_fidx_pre
            // Class constructor toString is the whole class, not the method.
            JSComp__Push(save_node)
            JSComp__Push(ctor_fidx)
            JSComp__AttachSource(ctor_fidx, save_node)
            JSCompTmp.val = JSComp__Pop()
            JSCompTmp.node = JSComp__Pop()
            ctor_fidx = JSCompTmp.val
            save_node = JSCompTmp.node
            // M128e7x: class constructors are always strict-mode code
            ct_fbase = Add(JSCompState.func_pool, Multiply(ctor_fidx, JSCompConst.FUNC_SIZE))
            ct_params = RDMEM_64(ct_fbase, 8)
            WRMEM_64(ct_fbase, 8, BitwiseOr(ct_params, 536870912))
        } ElseBlock: {
            // Default constructor:
            //   base: function() {}
            //   derived: function(...args) { super(...args); return this; }
            dfidx = JSCompState.func_count
            IfCondition GreaterEqual(dfidx, JSCompConst.MAX_FUNCS) ThenBlock: {
                JSCompState.error = 1
                // pop private frame
                JSCompState.priv_class_id = prev_priv
                JSCompState.priv_depth = Subtract(JSCompState.priv_depth, 1)
                ReturnValue(-1)
            }
            JSCompState.func_count = Add(dfidx, 1)

            dskip = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP, 0)
            dfstart = JSCompState.code_pos

            IfCondition EqualTo(has_parent, 1) ThenBlock: {
                // super(...args): stack [super_ctor, args_array] → CALL_SPREAD
                JSComp__EmitLoadSuperCtor()
                // GET_LOCAL 0 = rest array (only formal)
                JSComp__EmitOp16(JSOp.GET_LOCAL, 0)
                JSComp__Emit1(JSOp.CALL_SPREAD)
                JSComp__Emit1(JSOp.POP)
                // return this
                this_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                WRMEM_8(this_nm, 0, 116)
                WRMEM_8(this_nm, 1, 104)
                WRMEM_8(this_nm, 2, 105)
                WRMEM_8(this_nm, 3, 115)
                WRMEM_8(this_nm, 4, 0)
                JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                JSComp__Push(save_node)
                JSComp__Push(has_parent)
                tci = JSComp__AddString(this_nm, 4)
                has_parent = JSComp__Pop()
                save_node = JSComp__Pop()
                JSComp__EmitOp16(JSOp.GET_GLOBAL, tci)
                JSComp__Emit1(JSOp.RETURN)
            } ElseBlock: {
                JSComp__Emit1(JSOp.PUSH_UNDEF)
                JSComp__Emit1(JSOp.RETURN)
            }

            JSComp__PatchJump(dskip)

            dfbase = Add(JSCompState.func_pool, Multiply(dfidx, JSCompConst.FUNC_SIZE))
            WRMEM_64(dfbase, dfstart)
            // derived default: 1 rest formal (bit 31) + 1 local; base: 0
            IfCondition EqualTo(has_parent, 1) ThenBlock: {
                // params = 1 | rest_bit | unmapped (bit 30)
                WRMEM_64(dfbase, 8, BitwiseOr(BitwiseOr(1, 2147483648), 1073741824))
                WRMEM_64(dfbase, 16, 1)
                WRMEM_64(dfbase, 48, 0)
            } ElseBlock: {
                WRMEM_64(dfbase, 8, 0)
                WRMEM_64(dfbase, 16, 0)
            }

            // M128e7t: anonymous class → name_ptr 0 (not dangling); named → BindingIdentifier
            cnp = JSParse_GetNamePtr(save_node)
            cnl = JSParse_GetNameLen(save_node)
            IfCondition GreaterThan(cnl, 0) ThenBlock: {
                WRMEM_64(dfbase, 24, cnp)
                WRMEM_64(dfbase, 32, cnl)
            } ElseBlock: {
                WRMEM_64(dfbase, 24, 0)
                WRMEM_64(dfbase, 32, 0)
            }

            dci = JSCompState.const_count
            JSCompState.const_count = Add(dci, 1)
            dcbase = Add(JSCompState.const_pool, Multiply(dci, JSCompConst.CONST_SIZE))
            WRMEM_64(dcbase, 3)
            WRMEM_64(dcbase, 8, dfbase)

            JSComp__EmitOp16(JSOp.CLOSURE, dci)
            ctor_fidx = dfidx
            // Default constructor toString is the whole class source.
            JSComp__Push(save_node)
            JSComp__Push(ctor_fidx)
            JSComp__AttachSource(ctor_fidx, save_node)
            JSCompTmp.val = JSComp__Pop()
            JSCompTmp.node = JSComp__Pop()
            ctor_fidx = JSCompTmp.val
            save_node = JSCompTmp.node
            // M128e7x: default class constructors are strict
            ct_fbase2 = Add(JSCompState.func_pool, Multiply(ctor_fidx, JSCompConst.FUNC_SIZE))
            ct_params2 = RDMEM_64(ct_fbase2, 8)
            WRMEM_64(ct_fbase2, 8, BitwiseOr(ct_params2, 536870912))
        }

        // Stack: [parent_ctor?] [constructor]
        // M26b/d: class mark at compiler desc+40 → LoadConst → fdesc+88
        //   1 = base class ctor, 2 = derived (return non-object non-undef → TypeError)
        IfCondition GreaterEqual(ctor_fidx, 0) ThenBlock: {
            cfbase = Add(JSCompState.func_pool, Multiply(ctor_fidx, JSCompConst.FUNC_SIZE))
            IfCondition EqualTo(has_parent, 1) ThenBlock: {
                WRMEM_64(cfbase, 40, 1073741826)
            } ElseBlock: {
                WRMEM_64(cfbase, 40, 1073741825)
            }
        }

        // Now DUP constructor, create prototype, set it up

        // Create prototype object
        JSComp__Emit1(JSOp.NEW_OBJECT)
        // Stack: [parent?] [ctor] [proto]

        // M128e7l: unique __cc_N / __cp_N per class brand so nested class
        // evaluation (e.g. static B = class {}) does not clobber outer slots.
        cc_id = JSCompState.priv_class_id
        cc_digs = 1
        cc_tmp = cc_id
        WhileLoop GreaterEqual(cc_tmp, 10) {
            cc_digs = Add(cc_digs, 1)
            cc_tmp = Divide(cc_tmp, 10)
        }
        // "__cp_" + digits
        proto_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
        WRMEM_8(proto_nm, 0, 95)
        WRMEM_8(proto_nm, 1, 95)
        WRMEM_8(proto_nm, 2, 99)
        WRMEM_8(proto_nm, 3, 112)
        WRMEM_8(proto_nm, 4, 95)
        cc_tmp = cc_id
        cc_di = Subtract(cc_digs, 1)
        WhileLoop GreaterEqual(cc_di, 0) {
            cc_d10 = Divide(cc_tmp, 10)
            WRMEM_8(proto_nm, Add(5, cc_di), Add(48, Subtract(cc_tmp, Multiply(cc_d10, 10))))
            cc_tmp = cc_d10
            cc_di = Subtract(cc_di, 1)
        }
        WRMEM_8(proto_nm, Add(5, cc_digs), 0)
        JSCompState.str_pos = Add(JSCompState.str_pos, Add(6, cc_digs))
        JSComp__Push(save_node)
        JSComp__Push(has_parent)
        proto_slot = JSComp__AddString(proto_nm, Add(5, cc_digs))
        has_parent = JSComp__Pop()
        save_node = JSComp__Pop()
        // "__cc_" + digits
        ctor_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
        WRMEM_8(ctor_nm, 0, 95)
        WRMEM_8(ctor_nm, 1, 95)
        WRMEM_8(ctor_nm, 2, 99)
        WRMEM_8(ctor_nm, 3, 99)
        WRMEM_8(ctor_nm, 4, 95)
        cc_tmp = cc_id
        cc_di = Subtract(cc_digs, 1)
        WhileLoop GreaterEqual(cc_di, 0) {
            cc_d10 = Divide(cc_tmp, 10)
            WRMEM_8(ctor_nm, Add(5, cc_di), Add(48, Subtract(cc_tmp, Multiply(cc_d10, 10))))
            cc_tmp = cc_d10
            cc_di = Subtract(cc_di, 1)
        }
        WRMEM_8(ctor_nm, Add(5, cc_digs), 0)
        JSCompState.str_pos = Add(JSCompState.str_pos, Add(6, cc_digs))
        JSComp__Push(save_node)
        JSComp__Push(has_parent)
        JSComp__Push(proto_slot)
        ctor_slot = JSComp__AddString(ctor_nm, Add(5, cc_digs))
        proto_slot = JSComp__Pop()
        has_parent = JSComp__Pop()
        save_node = JSComp__Pop()

        // If extends: set proto.__proto__ = parent.prototype
        IfCondition EqualTo(has_parent, 1) ThenBlock: {
            // Stack: [parent] [ctor] [proto]
            // Store proto and ctor as globals to avoid local slot corruption.
            JSComp__EmitOp16(JSOp.SET_GLOBAL, proto_slot)
            // Stack: [parent] [ctor]
            JSComp__EmitOp16(JSOp.SET_GLOBAL, ctor_slot)
            // Stack: [parent]

            // Get parent.prototype
            pp_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            // "prototype" = 112 114 111 116 111 116 121 112 101
            WRMEM_8(pp_nm, 0, 112)
            WRMEM_8(pp_nm, 1, 114)
            WRMEM_8(pp_nm, 2, 111)
            WRMEM_8(pp_nm, 3, 116)
            WRMEM_8(pp_nm, 4, 111)
            WRMEM_8(pp_nm, 5, 116)
            WRMEM_8(pp_nm, 6, 121)
            WRMEM_8(pp_nm, 7, 112)
            WRMEM_8(pp_nm, 8, 101)
            WRMEM_8(pp_nm, 9, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            JSComp__Push(proto_slot)
            JSComp__Push(ctor_slot)
            pp_ci = JSComp__AddString(pp_nm, 9)
            ctor_slot = JSComp__Pop()
            proto_slot = JSComp__Pop()
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()
            // Stack: [parent] — GET_PROP "prototype"
            JSComp__EmitOp16(JSOp.GET_PROP, pp_ci)
            // Stack: [parent_proto]

            // Build "__pp__" string for parent proto global
            pp_tmp = Add(JSCompState.str_buf, JSCompState.str_pos)
            WRMEM_8(pp_tmp, 0, 95)
            WRMEM_8(pp_tmp, 1, 95)
            WRMEM_8(pp_tmp, 2, 112)
            WRMEM_8(pp_tmp, 3, 112)
            WRMEM_8(pp_tmp, 4, 95)
            WRMEM_8(pp_tmp, 5, 95)
            WRMEM_8(pp_tmp, 6, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 7)
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            JSComp__Push(proto_slot)
            JSComp__Push(ctor_slot)
            pp_slot = JSComp__AddString(pp_tmp, 6)
            ctor_slot = JSComp__Pop()
            proto_slot = JSComp__Pop()
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()

            JSComp__EmitOp16(JSOp.SET_GLOBAL, pp_slot)
            // Stack: empty

            // Now: push proto (obj), push parent_proto (value), SET_PROP "__proto__"
            JSComp__EmitOp16(JSOp.GET_GLOBAL, proto_slot)
            JSComp__EmitOp16(JSOp.GET_GLOBAL, pp_slot)

            // "__proto__" string constant
            dpp_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            WRMEM_8(dpp_nm, 0, 95)
            WRMEM_8(dpp_nm, 1, 95)
            WRMEM_8(dpp_nm, 2, 112)
            WRMEM_8(dpp_nm, 3, 114)
            WRMEM_8(dpp_nm, 4, 111)
            WRMEM_8(dpp_nm, 5, 116)
            WRMEM_8(dpp_nm, 6, 111)
            WRMEM_8(dpp_nm, 7, 95)
            WRMEM_8(dpp_nm, 8, 95)
            WRMEM_8(dpp_nm, 9, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            JSComp__Push(save_node)
            JSComp__Push(has_parent)
            JSComp__Push(proto_slot)
            JSComp__Push(ctor_slot)
            dpp_ci = JSComp__AddString(dpp_nm, 9)
            ctor_slot = JSComp__Pop()
            proto_slot = JSComp__Pop()
            has_parent = JSComp__Pop()
            save_node = JSComp__Pop()

            JSComp__EmitOp16(JSOp.SET_PROP, dpp_ci)
            // Stack: empty
        } ElseBlock: {
            // No extends. Stack: [ctor] [proto] — unique __cp_N/__cc_N already built
            JSComp__EmitOp16(JSOp.SET_GLOBAL, proto_slot)
            JSComp__EmitOp16(JSOp.SET_GLOBAL, ctor_slot)
            // Stack: empty
        }

        // M74: InitializeBinding(className, constructor) on classScope env
        // Methods/heritage closures already capture this env via CLOSURE.
        IfCondition EqualTo(has_cname, 1) ThenBlock: {
            JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
            JSComp__Push(save_node)
            JSComp__Push(has_cname)
            JSComp__Push(proto_slot)
            JSComp__Push(ctor_slot)
            cn_ci1 = JSComp__AddString(cnp, cnl)
            ctor_slot = JSComp__Pop()
            proto_slot = JSComp__Pop()
            has_cname = JSComp__Pop()
            save_node = JSComp__Pop()
            // SET_FRAME_ENV writes current (classScope) only — init name binding.
            // Trailing slot 0xFFFFFF = no stack sync. Slot 0 would clobber the
            // first top-level local (often a prior class A) via M128e5 stamp.
            JSComp__EmitOp16(JSOp.SET_FRAME_ENV, cn_ci1)
            JSComp__Emit1(255)
            JSComp__Emit1(255)
            JSComp__Emit1(255)
        }

        // Set ctor.prototype = proto
        JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
        JSComp__EmitOp16(JSOp.GET_GLOBAL, proto_slot)
        prot_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
        // "prototype" = 112 114 111 116 111 116 121 112 101
        WRMEM_8(prot_nm, 0, 112)
        WRMEM_8(prot_nm, 1, 114)
        WRMEM_8(prot_nm, 2, 111)
        WRMEM_8(prot_nm, 3, 116)
        WRMEM_8(prot_nm, 4, 111)
        WRMEM_8(prot_nm, 5, 116)
        WRMEM_8(prot_nm, 6, 121)
        WRMEM_8(prot_nm, 7, 112)
        WRMEM_8(prot_nm, 8, 101)
        WRMEM_8(prot_nm, 9, 0)
        JSCompState.str_pos = Add(JSCompState.str_pos, 10)
        JSComp__Push(save_node)
        JSComp__Push(proto_slot)
        JSComp__Push(ctor_slot)
        prot_ci = JSComp__AddString(prot_nm, 9)
        ctor_slot = JSComp__Pop()
        proto_slot = JSComp__Pop()
        save_node = JSComp__Pop()
        JSComp__EmitOp16(JSOp.SET_PROP, prot_ci)

        // Set proto.constructor = ctor
        JSComp__EmitOp16(JSOp.GET_GLOBAL, proto_slot)
        JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
        con_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
        // "constructor" = 99 111 110 115 116 114 117 99 116 111 114
        WRMEM_8(con_nm, 0, 99)
        WRMEM_8(con_nm, 1, 111)
        WRMEM_8(con_nm, 2, 110)
        WRMEM_8(con_nm, 3, 115)
        WRMEM_8(con_nm, 4, 116)
        WRMEM_8(con_nm, 5, 114)
        WRMEM_8(con_nm, 6, 117)
        WRMEM_8(con_nm, 7, 99)
        WRMEM_8(con_nm, 8, 116)
        WRMEM_8(con_nm, 9, 111)
        WRMEM_8(con_nm, 10, 114)
        WRMEM_8(con_nm, 11, 0)
        JSCompState.str_pos = Add(JSCompState.str_pos, 12)
        JSComp__Push(save_node)
        JSComp__Push(proto_slot)
        JSComp__Push(ctor_slot)
        con_ci = JSComp__AddString(con_nm, 11)
        ctor_slot = JSComp__Pop()
        proto_slot = JSComp__Pop()
        save_node = JSComp__Pop()
        JSComp__EmitOp16(JSOp.SET_PROP, con_ci)

        // Now compile each method and set it on prototype or constructor
        method = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(method, 0) {
            mflags = JSParse_GetValue(method)
            // M26k: skip CLASS_FIELD — fields go through __field_init__, not method install
            // (was installing #x as a bogus method during class eval)
            is_cfield = EqualTo(JSParse_GetType(method), ASTType.CLASS_FIELD)
            // Skip constructor — already compiled
            IfCondition And(EqualTo(BitwiseAnd(mflags, 8), 0), EqualTo(is_cfield, 0)) ThenBlock: {
                is_static = BitwiseAnd(mflags, 1)
                is_getter = BitwiseAnd(mflags, 2)
                is_setter = BitwiseAnd(mflags, 4)

                // Push target object: prototype for instance, constructor for static
                IfCondition NotEqual(is_static, 0) ThenBlock: {
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
                } ElseBlock: {
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, proto_slot)
                }

                // Check if method has computed key (N_COND != -1)
                comp_key = JSParse_GetCond(method)

                // For computed methods: compile key expression BEFORE closure
                // Stack order for SET_PROP_COMPUTED: [obj, key, value]
                IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                    JSComp__Push(method)
                    JSComp__Push(proto_slot)
                    JSComp__Push(ctor_slot)
                    JSComp__CompileExpr(comp_key)
                    JSComp__Emit1(JSOp.TO_PROP_KEY)
                    ctor_slot = JSComp__Pop()
                    proto_slot = JSComp__Pop()
                    method = JSComp__Pop()
                }

                // Compile method closure (M26g: static SuperBase uses parent ctor)
                JSComp__Push(method)
                JSComp__Push(proto_slot)
                JSComp__Push(ctor_slot)
                JSComp__Push(is_static)
                // Class methods are always strict-mode code
                IfCondition NotEqual(is_static, 0) ThenBlock: {
                    JSCompState.in_static_method = 1
                } ElseBlock: {
                    JSCompState.in_static_method = 0
                }
                // Mark non-gen MethodDefinition (strict via N_OP bit2; gens keep N_OP for async*)
                m_nt_pre = JSParse_GetType(method)
                is_gen_pre = 0
                IfCondition Or(EqualTo(m_nt_pre, ASTType.GEN_FUNC_EXPR), EqualTo(m_nt_pre, ASTType.GEN_FUNC_DECL)) ThenBlock: {
                    is_gen_pre = 1
                }
                IfCondition Or(EqualTo(m_nt_pre, ASTType.ASYNC_FUNC_EXPR), EqualTo(m_nt_pre, ASTType.ASYNC_FUNC_DECL)) ThenBlock: {
                    IfCondition EqualTo(JSParse_GetOp(method), 1) ThenBlock: { is_gen_pre = 1 }
                }
                IfCondition EqualTo(is_gen_pre, 0) ThenBlock: {
                    mop_c = JSParse_GetOp(method)
                    JSParse__NodeSet(method, ASTConst.N_OP, BitwiseOr(mop_c, 4))
                }
                m_fidx_pre = JSCompState.func_count
                JSComp__CompileFunc(method)
                // Force strict bit for all class methods (including gens)
                cm_fidx = m_fidx_pre
                cm_fbase = Add(JSCompState.func_pool, Multiply(cm_fidx, JSCompConst.FUNC_SIZE))
                cm_params = RDMEM_64(cm_fbase, 8)
                // 536870912 = 1<<29 strict
                WRMEM_64(cm_fbase, 8, BitwiseOr(cm_params, 536870912))
                JSCompState.in_static_method = 0
                // M26i: non-generator methods — no .prototype (high-bit flag at +40).
                // M128e7br: method fidx is first; nested arrows take later slots
                m_fidx = m_fidx_pre
                m_fbase = Add(JSCompState.func_pool, Multiply(m_fidx, JSCompConst.FUNC_SIZE))
                m_nt = JSParse_GetType(method)
                is_gen_m = 0
                IfCondition EqualTo(m_nt, ASTType.GEN_FUNC_EXPR) ThenBlock: { is_gen_m = 1 }
                IfCondition EqualTo(m_nt, ASTType.GEN_FUNC_DECL) ThenBlock: { is_gen_m = 1 }
                // M26k.11: async * methods store gen flag in N_OP — preserve body_start
                IfCondition Or(EqualTo(m_nt, ASTType.ASYNC_FUNC_EXPR), EqualTo(m_nt, ASTType.ASYNC_FUNC_DECL)) ThenBlock: {
                    IfCondition EqualTo(BitwiseAnd(JSParse_GetOp(method), 1), 1) ThenBlock: { is_gen_m = 1 }
                }
                IfCondition EqualTo(is_gen_m, 0) ThenBlock: {
                    WRMEM_64(m_fbase, 40, 1073741828)
                }
                is_static = JSComp__Pop()
                ctor_slot = JSComp__Pop()
                proto_slot = JSComp__Pop()
                method = JSComp__Pop()

                // Emit property set — computed vs named
                comp_key = JSParse_GetCond(method)
                IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                    // Computed: stack is [obj, key, func]
                    IfCondition NotEqual(is_getter, 0) ThenBlock: {
                        JSComp__Emit1(JSOp.DEF_GETTER_COMPUTED)
                    } ElseBlock: {
                        IfCondition NotEqual(is_setter, 0) ThenBlock: {
                            JSComp__Emit1(JSOp.DEF_SETTER_COMPUTED)
                        } ElseBlock: {
                            JSComp__Emit1(JSOp.SET_PROP_COMPUTED)
                        }
                    }
                } ElseBlock: {
                    // Named: ToPropertyKey (M97)
                    mnp = JSParse_GetNamePtr(method)
                    mnl = JSParse_GetNameLen(method)
                    JSComp__Push(method)
                    JSComp__Push(proto_slot)
                    JSComp__Push(ctor_slot)
                    mci = JSComp__AddPropName(mnp, mnl)
                    ctor_slot = JSComp__Pop()
                    proto_slot = JSComp__Pop()
                    method = JSComp__Pop()

                    // SET_PROP, DEF_GETTER, or DEF_SETTER.
                    // function.name is !W. Ordinary SET_PROP drops static name()
                    // (strict class methods then throw). DefineProperty via
                    // SET_FUNC_NAME so the method stays and the binding name does not.
                    IfCondition NotEqual(is_getter, 0) ThenBlock: {
                        JSComp__EmitOp16(JSOp.DEF_GETTER, mci)
                    } ElseBlock: {
                        IfCondition NotEqual(is_setter, 0) ThenBlock: {
                            JSComp__EmitOp16(JSOp.DEF_SETTER, mci)
                        } ElseBlock: {
                            is_name_key = 0
                            IfCondition And(EqualTo(mnl, 4), NotEqual(mnp, 0)) ThenBlock: {
                                IfCondition And(EqualTo(RDMEM_8(mnp, 0), 110), And(EqualTo(RDMEM_8(mnp, 1), 97), And(EqualTo(RDMEM_8(mnp, 2), 109), EqualTo(RDMEM_8(mnp, 3), 101)))) ThenBlock: {
                                    is_name_key = 1
                                }
                            }
                            IfCondition EqualTo(is_name_key, 1) ThenBlock: {
                                JSComp__EmitOp16(JSOp.SET_FUNC_NAME, mci)
                            } ElseBlock: {
                                JSComp__EmitOp16(JSOp.SET_PROP, mci)
                            }
                        }
                    }
                }
            }
            method = JSParse_GetNext(method)
        }

        // --- M128e7s: ClassElementEvaluation for field names (all computed keys) ---
        // Spec: evaluate every ClassElementName in source order first (static and
        // instance intercalated), collect FieldRecords, THEN DefineField static
        // initializers, THEN instance initializers on construct.
        // Store keys: instance → proto.__fk_N ; static → ctor.__sk_N
        fk_idx = 0
        sk_idx = 0
        method = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(method, 0) {
            IfCondition EqualTo(JSParse_GetType(method), ASTType.CLASS_FIELD) ThenBlock: {
                mflags = JSParse_GetValue(method)
                sb_flag = BitwiseAnd(mflags, 16)
                IfCondition EqualTo(sb_flag, 0) ThenBlock: {
                    comp_key = JSParse_GetCond(method)
                    IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                        is_static = BitwiseAnd(mflags, 1)
                        IfCondition NotEqual(is_static, 0) ThenBlock: {
                            // ctor.__sk_N = ToPropertyKey(eval key expr)
                            JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
                            JSComp__Push(method)
                            JSComp__Push(proto_slot)
                            JSComp__Push(ctor_slot)
                            JSComp__Push(fk_idx)
                            JSComp__Push(sk_idx)
                            JSComp__CompileExpr(comp_key)
                            sk_idx = JSComp__Pop()
                            fk_idx = JSComp__Pop()
                            ctor_slot = JSComp__Pop()
                            proto_slot = JSComp__Pop()
                            method = JSComp__Pop()
                            JSComp__Emit1(JSOp.TO_PROP_KEY)
                            fkn = Add(JSCompState.str_buf, JSCompState.str_pos)
                            WRMEM_8(fkn, 0, 95)
                            WRMEM_8(fkn, 1, 95)
                            WRMEM_8(fkn, 2, 115)
                            WRMEM_8(fkn, 3, 107)
                            WRMEM_8(fkn, 4, 95)
                            fktmp = sk_idx
                            fkdigs = 1
                            WhileLoop GreaterEqual(fktmp, 10) {
                                fkdigs = Add(fkdigs, 1)
                                fktmp = Divide(fktmp, 10)
                            }
                            fktmp = sk_idx
                            fkd = Subtract(fkdigs, 1)
                            WhileLoop GreaterEqual(fkd, 0) {
                                fkd10 = Divide(fktmp, 10)
                                fkdigit = Subtract(fktmp, Multiply(fkd10, 10))
                                WRMEM_8(fkn, Add(5, fkd), Add(48, fkdigit))
                                fktmp = fkd10
                                fkd = Subtract(fkd, 1)
                            }
                            WRMEM_8(fkn, Add(5, fkdigs), 0)
                            JSCompState.str_pos = Add(JSCompState.str_pos, Add(6, fkdigs))
                            JSComp__Push(method)
                            JSComp__Push(proto_slot)
                            JSComp__Push(ctor_slot)
                            JSComp__Push(fk_idx)
                            JSComp__Push(sk_idx)
                            fkn_ci = JSComp__AddString(fkn, Add(5, fkdigs))
                            sk_idx = JSComp__Pop()
                            fk_idx = JSComp__Pop()
                            ctor_slot = JSComp__Pop()
                            proto_slot = JSComp__Pop()
                            method = JSComp__Pop()
                            JSComp__EmitOp16(JSOp.SET_PROP, fkn_ci)
                            sk_idx = Add(sk_idx, 1)
                        } ElseBlock: {
                            // proto.__fk_N = ToPropertyKey(eval key expr)
                            JSComp__EmitOp16(JSOp.GET_GLOBAL, proto_slot)
                            JSComp__Push(method)
                            JSComp__Push(proto_slot)
                            JSComp__Push(ctor_slot)
                            JSComp__Push(fk_idx)
                            JSComp__Push(sk_idx)
                            JSComp__CompileExpr(comp_key)
                            sk_idx = JSComp__Pop()
                            fk_idx = JSComp__Pop()
                            ctor_slot = JSComp__Pop()
                            proto_slot = JSComp__Pop()
                            method = JSComp__Pop()
                            JSComp__Emit1(JSOp.TO_PROP_KEY)
                            fkn = Add(JSCompState.str_buf, JSCompState.str_pos)
                            WRMEM_8(fkn, 0, 95)
                            WRMEM_8(fkn, 1, 95)
                            WRMEM_8(fkn, 2, 102)
                            WRMEM_8(fkn, 3, 107)
                            WRMEM_8(fkn, 4, 95)
                            fktmp = fk_idx
                            fkdigs = 1
                            WhileLoop GreaterEqual(fktmp, 10) {
                                fkdigs = Add(fkdigs, 1)
                                fktmp = Divide(fktmp, 10)
                            }
                            fktmp = fk_idx
                            fkd = Subtract(fkdigs, 1)
                            WhileLoop GreaterEqual(fkd, 0) {
                                fkd10 = Divide(fktmp, 10)
                                fkdigit = Subtract(fktmp, Multiply(fkd10, 10))
                                WRMEM_8(fkn, Add(5, fkd), Add(48, fkdigit))
                                fktmp = fkd10
                                fkd = Subtract(fkd, 1)
                            }
                            WRMEM_8(fkn, Add(5, fkdigs), 0)
                            JSCompState.str_pos = Add(JSCompState.str_pos, Add(6, fkdigs))
                            JSComp__Push(method)
                            JSComp__Push(proto_slot)
                            JSComp__Push(ctor_slot)
                            JSComp__Push(fk_idx)
                            JSComp__Push(sk_idx)
                            fkn_ci = JSComp__AddString(fkn, Add(5, fkdigs))
                            sk_idx = JSComp__Pop()
                            fk_idx = JSComp__Pop()
                            ctor_slot = JSComp__Pop()
                            proto_slot = JSComp__Pop()
                            method = JSComp__Pop()
                            JSComp__EmitOp16(JSOp.SET_PROP, fkn_ci)
                            fk_idx = Add(fk_idx, 1)
                        }
                    }
                }
            }
            method = JSParse_GetNext(method)
        }

        // --- Compile static fields and static blocks ---
        // (M128e7s: computed keys already evaluated; load __sk_N for DefineField)
        sk_idx = 0
        method = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(method, 0) {
            IfCondition EqualTo(JSParse_GetType(method), ASTType.CLASS_FIELD) ThenBlock: {
                mflags = JSParse_GetValue(method)

                // Static block: mflags bit 4 (value 16) + bit 0 (static)
                sb_flag = BitwiseAnd(mflags, 16)
                IfCondition NotEqual(sb_flag, 0) ThenBlock: {
                    // Compile the static block body inline
                    sb_body = JSParse_GetBody(method)
                    IfCondition GreaterEqual(sb_body, 0) ThenBlock: {
                        // Set 'this' = constructor for static block
                        JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
                        // Build "this" string: 116 104 105 115
                        sb_this_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                        WRMEM_8(sb_this_nm, 0, 116)
                        WRMEM_8(sb_this_nm, 1, 104)
                        WRMEM_8(sb_this_nm, 2, 105)
                        WRMEM_8(sb_this_nm, 3, 115)
                        WRMEM_8(sb_this_nm, 4, 0)
                        JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                        JSComp__Push(method)
                        JSComp__Push(proto_slot)
                        JSComp__Push(ctor_slot)
                        JSComp__Push(sk_idx)
                        ci_this = JSComp__AddString(sb_this_nm, 4)
                        sk_idx = JSComp__Pop()
                        ctor_slot = JSComp__Pop()
                        proto_slot = JSComp__Pop()
                        method = JSComp__Pop()
                        JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_this)
                        // Compile the block
                        JSComp__Push(method)
                        JSComp__Push(proto_slot)
                        JSComp__Push(ctor_slot)
                        JSComp__Push(sk_idx)
                        JSComp__CompileBlock(sb_body)
                        sk_idx = JSComp__Pop()
                        ctor_slot = JSComp__Pop()
                        proto_slot = JSComp__Pop()
                        method = JSComp__Pop()
                    }
                }

                is_static = BitwiseAnd(mflags, 1)
                IfCondition And(NotEqual(is_static, 0), EqualTo(sb_flag, 0)) ThenBlock: {
                    // Static field: ctor.field = init
                    // M128e7b: DefineField(F, field) calls initializer with this=F
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
                    // Build "this" string: 116 104 105 115
                    sf_this_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
                    WRMEM_8(sf_this_nm, 0, 116)
                    WRMEM_8(sf_this_nm, 1, 104)
                    WRMEM_8(sf_this_nm, 2, 105)
                    WRMEM_8(sf_this_nm, 3, 115)
                    WRMEM_8(sf_this_nm, 4, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                    JSComp__Push(method)
                    JSComp__Push(proto_slot)
                    JSComp__Push(ctor_slot)
                    JSComp__Push(sk_idx)
                    ci_sf_this = JSComp__AddString(sf_this_nm, 4)
                    sk_idx = JSComp__Pop()
                    ctor_slot = JSComp__Pop()
                    proto_slot = JSComp__Pop()
                    method = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, ci_sf_this)

                    JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
                    comp_key = JSParse_GetCond(method)
                    IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                        // M128e7s: load pre-evaluated key from ctor.__sk_N
                        JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
                        fkn = Add(JSCompState.str_buf, JSCompState.str_pos)
                        WRMEM_8(fkn, 0, 95)
                        WRMEM_8(fkn, 1, 95)
                        WRMEM_8(fkn, 2, 115)
                        WRMEM_8(fkn, 3, 107)
                        WRMEM_8(fkn, 4, 95)
                        fktmp = sk_idx
                        fkdigs = 1
                        WhileLoop GreaterEqual(fktmp, 10) {
                            fkdigs = Add(fkdigs, 1)
                            fktmp = Divide(fktmp, 10)
                        }
                        fktmp = sk_idx
                        fkd = Subtract(fkdigs, 1)
                        WhileLoop GreaterEqual(fkd, 0) {
                            fkd10 = Divide(fktmp, 10)
                            fkdigit = Subtract(fktmp, Multiply(fkd10, 10))
                            WRMEM_8(fkn, Add(5, fkd), Add(48, fkdigit))
                            fktmp = fkd10
                            fkd = Subtract(fkd, 1)
                        }
                        WRMEM_8(fkn, Add(5, fkdigs), 0)
                        JSCompState.str_pos = Add(JSCompState.str_pos, Add(6, fkdigs))
                        JSComp__Push(method)
                        JSComp__Push(proto_slot)
                        JSComp__Push(ctor_slot)
                        JSComp__Push(sk_idx)
                        fkn_ci = JSComp__AddString(fkn, Add(5, fkdigs))
                        sk_idx = JSComp__Pop()
                        ctor_slot = JSComp__Pop()
                        proto_slot = JSComp__Pop()
                        method = JSComp__Pop()
                        JSComp__EmitOp16(JSOp.GET_PROP, fkn_ci)
                        sk_idx = Add(sk_idx, 1)
                    }
                    // Compile initializer or push undefined
                    field_init = JSParse_GetLeft(method)
                    IfCondition GreaterEqual(field_init, 0) ThenBlock: {
                        JSComp__Push(method)
                        JSComp__Push(proto_slot)
                        JSComp__Push(ctor_slot)
                        JSComp__Push(sk_idx)
                        JSComp__CompileExpr(field_init)
                        sk_idx = JSComp__Pop()
                        ctor_slot = JSComp__Pop()
                        proto_slot = JSComp__Pop()
                        method = JSComp__Pop()
                    } ElseBlock: {
                        JSComp__Emit1(JSOp.PUSH_UNDEF)
                    }
                    // M26k.5: pulse for static private field define
                    mnp = JSParse_GetNamePtr(method)
                    IfCondition NotEqual(mnp, 0) ThenBlock: {
                        IfCondition EqualTo(RDMEM_8(mnp, 0), 35) ThenBlock: {
                            JSComp__Emit1(JSOp.PRIVATE_INIT_PULSE)
                        }
                    }
                    // Set property
                    comp_key = JSParse_GetCond(method)
                    IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                        JSComp__Emit1(JSOp.SET_PROP_COMPUTED)
                    } ElseBlock: {
                        mnp = JSParse_GetNamePtr(method)
                        mnl = JSParse_GetNameLen(method)
                        JSComp__Push(method)
                        JSComp__Push(proto_slot)
                        JSComp__Push(ctor_slot)
                        JSComp__Push(sk_idx)
                        mci = JSComp__AddString(mnp, mnl)
                        sk_idx = JSComp__Pop()
                        ctor_slot = JSComp__Pop()
                        proto_slot = JSComp__Pop()
                        method = JSComp__Pop()
                        JSComp__EmitOp16(JSOp.SET_PROP, mci)
                    }
                }
            }
            method = JSParse_GetNext(method)
        }

        // --- Compile instance fields as __field_init__ closure ---
        // Instance fields must be own properties set during construction,
        // not on the prototype. We compile a hidden closure that takes
        // this_obj as parameter and sets each field on it, then store it
        // on the prototype as "__field_init__". The VM's CONSTRUCT RETURN
        // path calls this after the constructor runs.
        has_inst_fields = 0
        method = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(method, 0) {
            IfCondition EqualTo(JSParse_GetType(method), ASTType.CLASS_FIELD) ThenBlock: {
                IfCondition EqualTo(BitwiseAnd(JSParse_GetValue(method), 1), 0) ThenBlock: {
                    has_inst_fields = 1
                }
            }
            method = JSParse_GetNext(method)
        }

        IfCondition EqualTo(has_inst_fields, 1) ThenBlock: {
            // Allocate function descriptor slot
            fi_idx = JSCompState.func_count
            IfCondition GreaterEqual(fi_idx, JSCompConst.MAX_FUNCS) ThenBlock: {
                JSCompState.error = 1
                JSCompState.priv_class_id = prev_priv
                JSCompState.priv_depth = Subtract(JSCompState.priv_depth, 1)
                ReturnValue(-1)
            }
            JSCompState.func_count = Add(fi_idx, 1)

            // JMP to skip the __field_init__ function body
            fi_skip = JSCompState.code_pos
            JSComp__EmitOp16(JSOp.JMP, 0)
            fi_start = JSCompState.code_pos

            // M128e7: free-vars in initializers must GET_FREE (not outer script slots)
            JSCompState.in_field_init = 1

            // Function body: for each instance field, GET_LOCAL 0 (this_obj param),
            // compile initializer, SET_PROP.
            // M26k.10: computed keys loaded from proto.__fk_N (fixed at class eval).
            fk_idx = 0
            method = JSParse_GetBody(save_node)
            WhileLoop GreaterEqual(method, 0) {
                IfCondition EqualTo(JSParse_GetType(method), ASTType.CLASS_FIELD) ThenBlock: {
                    mflags = JSParse_GetValue(method)
                    IfCondition EqualTo(BitwiseAnd(mflags, 1), 0) ThenBlock: {
                        // Instance field: this_obj.field = init
                        JSComp__EmitOp16(JSOp.GET_LOCAL, 0)

                        comp_key = JSParse_GetCond(method)
                        IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                            // key = this.__proto__["__fk_N"]
                            JSComp__EmitOp16(JSOp.GET_LOCAL, 0)
                            ppk = Add(JSCompState.str_buf, JSCompState.str_pos)
                            WRMEM_8(ppk, 0, 95)
                            WRMEM_8(ppk, 1, 95)
                            WRMEM_8(ppk, 2, 112)
                            WRMEM_8(ppk, 3, 114)
                            WRMEM_8(ppk, 4, 111)
                            WRMEM_8(ppk, 5, 116)
                            WRMEM_8(ppk, 6, 111)
                            WRMEM_8(ppk, 7, 95)
                            WRMEM_8(ppk, 8, 95)
                            WRMEM_8(ppk, 9, 0)
                            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
                            JSComp__Push(method)
                            JSComp__Push(proto_slot)
                            JSComp__Push(ctor_slot)
                            JSComp__Push(fk_idx)
                            ppk_ci = JSComp__AddString(ppk, 9)
                            fk_idx = JSComp__Pop()
                            ctor_slot = JSComp__Pop()
                            proto_slot = JSComp__Pop()
                            method = JSComp__Pop()
                            JSComp__EmitOp16(JSOp.GET_PROP, ppk_ci)
                            // "__fk_" + decimal(fk_idx)
                            fkn = Add(JSCompState.str_buf, JSCompState.str_pos)
                            WRMEM_8(fkn, 0, 95)
                            WRMEM_8(fkn, 1, 95)
                            WRMEM_8(fkn, 2, 102)
                            WRMEM_8(fkn, 3, 107)
                            WRMEM_8(fkn, 4, 95)
                            fktmp = fk_idx
                            fkdigs = 1
                            WhileLoop GreaterEqual(fktmp, 10) {
                                fkdigs = Add(fkdigs, 1)
                                fktmp = Divide(fktmp, 10)
                            }
                            fktmp = fk_idx
                            fkd = Subtract(fkdigs, 1)
                            WhileLoop GreaterEqual(fkd, 0) {
                                fkd10 = Divide(fktmp, 10)
                                fkdigit = Subtract(fktmp, Multiply(fkd10, 10))
                                WRMEM_8(fkn, Add(5, fkd), Add(48, fkdigit))
                                fktmp = fkd10
                                fkd = Subtract(fkd, 1)
                            }
                            WRMEM_8(fkn, Add(5, fkdigs), 0)
                            JSCompState.str_pos = Add(JSCompState.str_pos, Add(6, fkdigs))
                            JSComp__Push(method)
                            JSComp__Push(proto_slot)
                            JSComp__Push(ctor_slot)
                            JSComp__Push(fk_idx)
                            fkn_ci = JSComp__AddString(fkn, Add(5, fkdigs))
                            fk_idx = JSComp__Pop()
                            ctor_slot = JSComp__Pop()
                            proto_slot = JSComp__Pop()
                            method = JSComp__Pop()
                            JSComp__EmitOp16(JSOp.GET_PROP, fkn_ci)
                            fk_idx = Add(fk_idx, 1)
                        }

                        field_init = JSParse_GetLeft(method)
                        IfCondition GreaterEqual(field_init, 0) ThenBlock: {
                            JSComp__Push(method)
                            JSComp__Push(proto_slot)
                            JSComp__Push(ctor_slot)
                            JSComp__Push(fk_idx)
                            JSComp__CompileExpr(field_init)
                            fk_idx = JSComp__Pop()
                            ctor_slot = JSComp__Pop()
                            proto_slot = JSComp__Pop()
                            method = JSComp__Pop()
                        } ElseBlock: {
                            JSComp__Emit1(JSOp.PUSH_UNDEF)
                        }

                        // M26k.5: PrivateFieldAdd only for this field's define SET
                        mnp = JSParse_GetNamePtr(method)
                        IfCondition NotEqual(mnp, 0) ThenBlock: {
                            IfCondition EqualTo(RDMEM_8(mnp, 0), 35) ThenBlock: {
                                JSComp__Emit1(JSOp.PRIVATE_INIT_PULSE)
                            }
                        }

                        comp_key = JSParse_GetCond(method)
                        IfCondition GreaterEqual(comp_key, 0) ThenBlock: {
                            JSComp__Emit1(JSOp.SET_PROP_COMPUTED)
                        } ElseBlock: {
                            mnp = JSParse_GetNamePtr(method)
                            mnl = JSParse_GetNameLen(method)
                            JSComp__Push(method)
                            JSComp__Push(proto_slot)
                            JSComp__Push(ctor_slot)
                            JSComp__Push(fk_idx)
                            mci = JSComp__AddString(mnp, mnl)
                            fk_idx = JSComp__Pop()
                            ctor_slot = JSComp__Pop()
                            proto_slot = JSComp__Pop()
                            method = JSComp__Pop()
                            JSComp__EmitOp16(JSOp.SET_PROP, mci)
                        }
                    }
                }
                method = JSParse_GetNext(method)
            }

            JSComp__Emit1(JSOp.PUSH_UNDEF)
            JSComp__Emit1(JSOp.RETURN)
            JSCompState.in_field_init = 0

            // Patch JMP target
            JSComp__PatchJump(fi_skip)

            // Build func descriptor: 1 param (this_obj), 1 local
            // M128e7o: bit 26 (67108864) = class field initializer function
            // M128e7bq: name "__field_init__" so eval can detect field-init caller
            // (bit26 collides with formal count mask; name is reliable).
            fi_base = Add(JSCompState.func_pool, Multiply(fi_idx, JSCompConst.FUNC_SIZE))
            WRMEM_64(fi_base, fi_start)
            WRMEM_64(fi_base, 8, BitwiseOr(1, 67108864))
            WRMEM_64(fi_base, 16, 1)
            // stable name string for FuncPropGet(name)
            fi_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            WRMEM_8(fi_nm, 0, 95)
            WRMEM_8(fi_nm, 1, 95)
            WRMEM_8(fi_nm, 2, 102)
            WRMEM_8(fi_nm, 3, 105)
            WRMEM_8(fi_nm, 4, 101)
            WRMEM_8(fi_nm, 5, 108)
            WRMEM_8(fi_nm, 6, 100)
            WRMEM_8(fi_nm, 7, 95)
            WRMEM_8(fi_nm, 8, 105)
            WRMEM_8(fi_nm, 9, 110)
            WRMEM_8(fi_nm, 10, 105)
            WRMEM_8(fi_nm, 11, 116)
            WRMEM_8(fi_nm, 12, 95)
            WRMEM_8(fi_nm, 13, 95)
            WRMEM_8(fi_nm, 14, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 15)
            WRMEM_64(fi_base, 24, fi_nm)
            WRMEM_64(fi_base, 32, 14)

            // Add to const pool as type 3 (FUNCTION)
            fi_ci = JSCompState.const_count
            IfCondition GreaterEqual(fi_ci, JSCompConst.MAX_CONSTS) ThenBlock: {
                JSCompState.error = 1
                JSCompState.priv_class_id = prev_priv
                JSCompState.priv_depth = Subtract(JSCompState.priv_depth, 1)
                ReturnValue(-1)
            }
            JSCompState.const_count = Add(fi_ci, 1)
            fi_cbase = Add(JSCompState.const_pool, Multiply(fi_ci, JSCompConst.CONST_SIZE))
            WRMEM_64(fi_cbase, 3)
            WRMEM_64(fi_cbase, 8, fi_base)

            // Emit: GET_GLOBAL proto_slot; CLOSURE fi_ci; SET_PROP "__field_init__"
            JSComp__EmitOp16(JSOp.GET_GLOBAL, proto_slot)
            JSComp__EmitOp16(JSOp.CLOSURE, fi_ci)
            // Build "__field_init__" string constant
            fini_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            // "__field_init__" = 95 95 102 105 101 108 100 95 105 110 105 116 95 95
            WRMEM_8(fini_nm, 0, 95)
            WRMEM_8(fini_nm, 1, 95)
            WRMEM_8(fini_nm, 2, 102)
            WRMEM_8(fini_nm, 3, 105)
            WRMEM_8(fini_nm, 4, 101)
            WRMEM_8(fini_nm, 5, 108)
            WRMEM_8(fini_nm, 6, 100)
            WRMEM_8(fini_nm, 7, 95)
            WRMEM_8(fini_nm, 8, 105)
            WRMEM_8(fini_nm, 9, 110)
            WRMEM_8(fini_nm, 10, 105)
            WRMEM_8(fini_nm, 11, 116)
            WRMEM_8(fini_nm, 12, 95)
            WRMEM_8(fini_nm, 13, 95)
            WRMEM_8(fini_nm, 14, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 15)
            JSComp__Push(proto_slot)
            JSComp__Push(ctor_slot)
            fini_ci = JSComp__AddString(fini_nm, 14)
            ctor_slot = JSComp__Pop()
            proto_slot = JSComp__Pop()
            JSComp__EmitOp16(JSOp.SET_PROP, fini_ci)
            // M128e7s: computed instance keys already stored as proto.__fk_N above
        }

        // If extends: store parent constructor as __super__ property on child ctor.
        // This allows the VM's CONSTRUCT handler to set __super__ at call time,
        // fixing multi-level inheritance where the global gets overwritten.
        IfCondition EqualTo(has_parent, 1) ThenBlock: {
            JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
            // Build "__super__" constant
            sp2_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            WRMEM_8(sp2_nm, 0, 95)
            WRMEM_8(sp2_nm, 1, 95)
            WRMEM_8(sp2_nm, 2, 115)
            WRMEM_8(sp2_nm, 3, 117)
            WRMEM_8(sp2_nm, 4, 112)
            WRMEM_8(sp2_nm, 5, 101)
            WRMEM_8(sp2_nm, 6, 114)
            WRMEM_8(sp2_nm, 7, 95)
            WRMEM_8(sp2_nm, 8, 95)
            WRMEM_8(sp2_nm, 9, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            JSComp__Push(save_node)
            JSComp__Push(ctor_slot)
            sp2_ci = JSComp__AddString(sp2_nm, 9)
            ctor_slot = JSComp__Pop()
            save_node = JSComp__Pop()
            // Stack: [ctor]. Now push the parent and SET_PROP.
            // __super__ global still holds the parent from class decl time.
            // Reuse the same constant for GET_GLOBAL and SET_PROP.
            JSComp__EmitOp16(JSOp.GET_GLOBAL, sp2_ci)
            // Stack: [ctor, parent_ctor]. Now SET_PROP "__super__" on ctor.
            // SET_PROP pops [obj, val] — but we need [obj] [val] with prop name.
            // Actually SET_PROP takes stack [obj, val] and const idx for name.
            JSComp__EmitOp16(JSOp.SET_PROP, sp2_ci)

            // M26i: ctor.[[Prototype]] = parent (static inheritance / getPrototypeOf)
            JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
            JSComp__EmitOp16(JSOp.GET_GLOBAL, sp2_ci)
            // "__proto__"
            dpp2 = Add(JSCompState.str_buf, JSCompState.str_pos)
            WRMEM_8(dpp2, 0, 95)
            WRMEM_8(dpp2, 1, 95)
            WRMEM_8(dpp2, 2, 112)
            WRMEM_8(dpp2, 3, 114)
            WRMEM_8(dpp2, 4, 111)
            WRMEM_8(dpp2, 5, 116)
            WRMEM_8(dpp2, 6, 111)
            WRMEM_8(dpp2, 7, 95)
            WRMEM_8(dpp2, 8, 95)
            WRMEM_8(dpp2, 9, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 10)
            JSComp__Push(save_node)
            JSComp__Push(ctor_slot)
            dpp2_ci = JSComp__AddString(dpp2, 9)
            ctor_slot = JSComp__Pop()
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.SET_PROP, dpp2_ci)
        }

        // M128e7t: ClassDefinitionEvaluation className → constructor .name
        // User `constructor()` methods were named "constructor"; stamp fdesc.
        // Also SET_PROP at runtime: proto.constructor = ctor runs SetFunctionName
        // with key "constructor" when name is empty — must re-apply className after.
        cnp = JSParse_GetNamePtr(save_node)
        cnl = JSParse_GetNameLen(save_node)
        IfCondition GreaterEqual(ctor_fidx, 0) ThenBlock: {
            cfbase_nm = Add(JSCompState.func_pool, Multiply(ctor_fidx, JSCompConst.FUNC_SIZE))
            IfCondition GreaterThan(cnl, 0) ThenBlock: {
                WRMEM_64(cfbase_nm, 24, cnp)
                WRMEM_64(cfbase_nm, 32, cnl)
            } ElseBlock: {
                WRMEM_64(cfbase_nm, 24, 0)
                WRMEM_64(cfbase_nm, 32, 0)
            }
        }
        // Runtime define ctor.name only when needed:
        // - Named class: fdesc stamp is enough (static `name` keeps PropTable override).
        // - Anonymous: proto.constructor = ctor SetFunctionName → "constructor"; reset to "".
        // - Skip if static name method/field/accessor (must not clobber).
        has_static_name = 0
        method = JSParse_GetBody(save_node)
        WhileLoop GreaterEqual(method, 0) {
            mflags = JSParse_GetValue(method)
            IfCondition NotEqual(BitwiseAnd(mflags, 1), 0) ThenBlock: {
                mnp = JSParse_GetNamePtr(method)
                mnl = JSParse_GetNameLen(method)
                IfCondition And(EqualTo(mnl, 4), NotEqual(mnp, 0)) ThenBlock: {
                    IfCondition And(EqualTo(RDMEM_8(mnp, 0), 110), And(EqualTo(RDMEM_8(mnp, 1), 97), And(EqualTo(RDMEM_8(mnp, 2), 109), EqualTo(RDMEM_8(mnp, 3), 101)))) ThenBlock: {
                        has_static_name = 1
                    }
                }
            }
            method = JSParse_GetNext(method)
        }
        IfCondition And(EqualTo(has_static_name, 0), LessEqual(cnl, 0)) ThenBlock: {
            JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
            emp_cls = Add(JSCompState.str_buf, JSCompState.str_pos)
            WRMEM_8(emp_cls, 0, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 1)
            JSComp__Push(save_node)
            JSComp__Push(ctor_slot)
            emp_cls_ci = JSComp__AddString(emp_cls, 0)
            ctor_slot = JSComp__Pop()
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.PUSH_CONST, emp_cls_ci)
            nm_key_cls = Add(JSCompState.str_buf, JSCompState.str_pos)
            WRMEM_8(nm_key_cls, 0, 110)
            WRMEM_8(nm_key_cls, 1, 97)
            WRMEM_8(nm_key_cls, 2, 109)
            WRMEM_8(nm_key_cls, 3, 101)
            WRMEM_8(nm_key_cls, 4, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 5)
            JSComp__Push(save_node)
            JSComp__Push(ctor_slot)
            nm_key_cls_ci = JSComp__AddString(nm_key_cls, 4)
            ctor_slot = JSComp__Pop()
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.SET_FUNC_NAME, nm_key_cls_ci)
        }

        // Push constructor as the class value (result of class expression)
        JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
        // M74: pop classScope — outer LexEnv restored; methods keep class env in __cenv
        IfCondition EqualTo(has_cname, 1) ThenBlock: {
            JSComp__Emit1(JSOp.RESTORE_ENV)
        }
        JSCompState.class_name_ptr = 0
        JSCompState.class_name_len = 0
        JSCompState.is_strict = saved_class_strict
        // M128e7m: stamp ctor.__priv_env__ / __priv_brand__ for direct-eval seed.
        pe_count = 0
        pe_total = 0
        pn = 0
        WhileLoop LessThan(pn, JSCompState.priv_name_count) {
            od = RDMEM_64(JSCompState.priv_name_depths, Multiply(pn, 8))
            IfCondition EqualTo(od, cur_pd) ThenBlock: {
                nlen = RDMEM_64(JSCompState.priv_name_lens, Multiply(pn, 8))
                IfCondition EqualTo(pe_count, 0) ThenBlock: {
                    pe_total = nlen
                } ElseBlock: {
                    pe_total = Add(pe_total, Add(1, nlen))
                }
                pe_count = Add(pe_count, 1)
            }
            pn = Add(pn, 1)
        }
        IfCondition GreaterThan(pe_count, 0) ThenBlock: {
            pe_buf = Add(JSCompState.str_buf, JSCompState.str_pos)
            pe_pos = 0
            pe_first = 1
            pn = 0
            WhileLoop LessThan(pn, JSCompState.priv_name_count) {
                od = RDMEM_64(JSCompState.priv_name_depths, Multiply(pn, 8))
                IfCondition EqualTo(od, cur_pd) ThenBlock: {
                    nptr = RDMEM_64(JSCompState.priv_name_ptrs, Multiply(pn, 8))
                    nlen = RDMEM_64(JSCompState.priv_name_lens, Multiply(pn, 8))
                    IfCondition EqualTo(pe_first, 0) ThenBlock: {
                        WRMEM_8(pe_buf, pe_pos, 44)
                        pe_pos = Add(pe_pos, 1)
                    }
                    pe_first = 0
                    IfCondition And(NotEqual(nptr, 0), GreaterThan(nlen, 0)) ThenBlock: {
                        MemoryCopy(Add(pe_buf, pe_pos), nptr, nlen)
                        pe_pos = Add(pe_pos, nlen)
                    }
                }
                pn = Add(pn, 1)
            }
            WRMEM_8(pe_buf, pe_pos, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, Add(pe_pos, 1))
            JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
            JSComp__Push(save_node)
            JSComp__Push(ctor_slot)
            pe_ci = JSComp__AddStringRaw(pe_buf, pe_pos)
            ctor_slot = JSComp__Pop()
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.PUSH_CONST, pe_ci)
            pe_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            WRMEM_8(pe_nm, 0, 95)
            WRMEM_8(pe_nm, 1, 95)
            WRMEM_8(pe_nm, 2, 112)
            WRMEM_8(pe_nm, 3, 114)
            WRMEM_8(pe_nm, 4, 105)
            WRMEM_8(pe_nm, 5, 118)
            WRMEM_8(pe_nm, 6, 95)
            WRMEM_8(pe_nm, 7, 101)
            WRMEM_8(pe_nm, 8, 110)
            WRMEM_8(pe_nm, 9, 118)
            WRMEM_8(pe_nm, 10, 95)
            WRMEM_8(pe_nm, 11, 95)
            WRMEM_8(pe_nm, 12, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 13)
            JSComp__Push(save_node)
            JSComp__Push(ctor_slot)
            pe_nci = JSComp__AddStringRaw(pe_nm, 12)
            ctor_slot = JSComp__Pop()
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.SET_PROP, pe_nci)
            JSComp__EmitOp16(JSOp.GET_GLOBAL, ctor_slot)
            JSComp__Push(save_node)
            JSComp__Push(ctor_slot)
            pb_ci = JSComp__AddNumber(JSCompState.priv_class_id)
            ctor_slot = JSComp__Pop()
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.PUSH_CONST, pb_ci)
            pb_nm = Add(JSCompState.str_buf, JSCompState.str_pos)
            WRMEM_8(pb_nm, 0, 95)
            WRMEM_8(pb_nm, 1, 95)
            WRMEM_8(pb_nm, 2, 112)
            WRMEM_8(pb_nm, 3, 114)
            WRMEM_8(pb_nm, 4, 105)
            WRMEM_8(pb_nm, 5, 118)
            WRMEM_8(pb_nm, 6, 95)
            WRMEM_8(pb_nm, 7, 98)
            WRMEM_8(pb_nm, 8, 114)
            WRMEM_8(pb_nm, 9, 97)
            WRMEM_8(pb_nm, 10, 110)
            WRMEM_8(pb_nm, 11, 100)
            WRMEM_8(pb_nm, 12, 95)
            WRMEM_8(pb_nm, 13, 95)
            WRMEM_8(pb_nm, 14, 0)
            JSCompState.str_pos = Add(JSCompState.str_pos, 15)
            JSComp__Push(save_node)
            JSComp__Push(ctor_slot)
            pb_nci = JSComp__AddStringRaw(pb_nm, 14)
            ctor_slot = JSComp__Pop()
            save_node = JSComp__Pop()
            JSComp__EmitOp16(JSOp.SET_PROP, pb_nci)
        }

        // Pop private brand frame: keep only names from outer depths
        new_nc = 0
        pn = 0
        WhileLoop LessThan(pn, JSCompState.priv_name_count) {
            od = RDMEM_64(JSCompState.priv_name_depths, Multiply(pn, 8))
            IfCondition NotEqual(od, cur_pd) ThenBlock: {
                WRMEM_64(JSCompState.priv_name_ptrs, Multiply(new_nc, 8), RDMEM_64(JSCompState.priv_name_ptrs, Multiply(pn, 8)))
                WRMEM_64(JSCompState.priv_name_lens, Multiply(new_nc, 8), RDMEM_64(JSCompState.priv_name_lens, Multiply(pn, 8)))
                WRMEM_64(JSCompState.priv_name_depths, Multiply(new_nc, 8), od)
                new_nc = Add(new_nc, 1)
            }
            pn = Add(pn, 1)
        }
        JSCompState.priv_name_count = new_nc
        JSCompState.priv_depth = Subtract(JSCompState.priv_depth, 1)
        JSCompState.priv_class_id = prev_priv
        ReturnValue(0)
    }
}
