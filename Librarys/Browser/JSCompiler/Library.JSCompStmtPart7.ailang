// Library.JSCompStmtPart7.ailang
// Functions moved out of Library.JSCompStmt.ailang.
// Split from the JS engine so one function fits in context.
// FixedPools stay in the parent library. Function names are unchanged
// except for the new helpers this split adds.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.


// Compile object destructuring pattern: {a, b: c} = src
// src_slot = local slot holding the RHS value (an object)
// pat_node = OBJECT_PATTERN node whose N_LEFT is the first PROPERTY
Function.JSComp__CompileObjPattern {
    Input: pat_node: Integer
    Input: src_slot: Integer
    Output: Integer
    Body: {
        save_pat = pat_node
        save_src = src_slot

        // Mole 13: null/undefined → TypeError (RequireObjectCoercible)
        JSComp__EmitOp16(JSOp.GET_LOCAL, save_src)
        JSComp__Emit1(JSOp.DUP)
        JSComp__Emit1(JSOp.PUSH_NULL)
        JSComp__Emit1(JSOp.STRICT_EQ)
        not_null = JSCompState.code_pos
        JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
        JSComp__Emit1(JSOp.POP)
        // throw TypeError — reuse THROW_TDZ-style typed error via null.x pattern:
        // emit PUSH_NULL; GET_PROP "x" which throws TypeError for null base
        JSComp__Emit1(JSOp.PUSH_NULL)
        bad_key = Add(JSCompState.str_buf, JSCompState.str_pos)
        WRMEM_8(bad_key, 0, 120)
        WRMEM_8(bad_key, 1, 0)
        JSCompState.str_pos = Add(JSCompState.str_pos, 2)
        JSComp__Push(save_src)
        bkci = JSComp__AddString(bad_key, 1)
        save_src = JSComp__Pop()
        JSComp__EmitOp16(JSOp.GET_PROP, bkci)
        JSComp__Emit1(JSOp.POP)
        JSComp__PatchJump(not_null)
        // also reject undefined
        JSComp__Emit1(JSOp.DUP)
        JSComp__Emit1(JSOp.PUSH_UNDEF)
        JSComp__Emit1(JSOp.STRICT_EQ)
        not_undef = JSCompState.code_pos
        JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
        JSComp__Emit1(JSOp.POP)
        JSComp__Emit1(JSOp.PUSH_NULL)
        JSComp__Push(save_src)
        bkci2 = JSComp__AddString(bad_key, 1)
        save_src = JSComp__Pop()
        JSComp__EmitOp16(JSOp.GET_PROP, bkci2)
        JSComp__Emit1(JSOp.POP)
        JSComp__PatchJump(not_undef)
        JSComp__Emit1(JSOp.POP)

        // Walk properties linked by N_NEXT
        prop = JSParse_GetLeft(save_pat)

        WhileLoop GreaterEqual(prop, 0) {
            ptyp = JSParse_GetType(prop)

            // REST_ELEMENT: ...rest — CopyDataProperties excluding already-bound keys
            // Mole 13: build rest object = { ...src } then delete each prior key.
            IfCondition EqualTo(ptyp, ASTType.REST_ELEMENT) ThenBlock: {
                rest_tgt = JSParse_GetLeft(prop)
                rest_tt = JSParse_GetType(rest_tgt)

                // rest = {}
                JSComp__Emit1(JSOp.NEW_OBJECT)
                // Copy all enumerable from src via OBJ_SPREAD: stack [rest, src] → rest mutated
                JSComp__Emit1(JSOp.DUP)
                JSComp__EmitOp16(JSOp.GET_LOCAL, save_src)
                JSComp__Emit1(JSOp.OBJ_SPREAD)

                // Delete each already-extracted property name from rest.
                // Walk props from pattern start until this REST node.
                // M128e6x: include computed keys (N_COND) — re-eval key expr for DELETE.
                excl = JSParse_GetLeft(save_pat)
                WhileLoop And(GreaterEqual(excl, 0), NotEqual(excl, prop)) {
                    et = JSParse_GetType(excl)
                    IfCondition EqualTo(et, ASTType.PROPERTY) ThenBlock: {
                        comp_ex = JSParse_GetCond(excl)
                        IfCondition GreaterEqual(comp_ex, 0) ThenBlock: {
                            // rest on stack; DUP; eval computed key; DELETE_PROP; POP
                            JSComp__Emit1(JSOp.DUP)
                            JSComp__Push(save_src)
                            JSComp__Push(prop)
                            JSComp__Push(excl)
                            JSComp__CompileExpr(comp_ex)
                            excl = JSComp__Pop()
                            prop = JSComp__Pop()
                            save_src = JSComp__Pop()
                            JSComp__Emit1(JSOp.DELETE_PROP)
                            JSComp__Emit1(JSOp.POP)
                        }
                        IfCondition LessThan(comp_ex, 0) ThenBlock: {
                            enp = JSParse_GetNamePtr(excl)
                            enl = JSParse_GetNameLen(excl)
                            IfCondition GreaterThan(enl, 0) ThenBlock: {
                                // rest already on stack; DUP, push key string, DELETE_PROP, POP bool
                                JSComp__Emit1(JSOp.DUP)
                                JSComp__Push(save_src)
                                JSComp__Push(prop)
                                JSComp__Push(excl)
                                eci = JSComp__AddString(enp, enl)
                                excl = JSComp__Pop()
                                prop = JSComp__Pop()
                                save_src = JSComp__Pop()
                                JSComp__EmitOp16(JSOp.PUSH_CONST, eci)
                                JSComp__Emit1(JSOp.DELETE_PROP)
                                JSComp__Emit1(JSOp.POP)
                            }
                        }
                    }
                    excl = JSParse_GetNext(excl)
                }

                // Bind rest object to IDENT / member / nested pattern
                IfCondition Or(EqualTo(rest_tt, ASTType.IDENT), Or(EqualTo(rest_tt, ASTType.MEMBER_DOT), EqualTo(rest_tt, ASTType.MEMBER_BRACKET))) ThenBlock: {
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    JSComp__EmitDstrBind(rest_tgt)
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                } ElseBlock: {
                    // Pattern rest target rare; store temp and recurse
                    rtmp = Add(JSCompState.str_buf, JSCompState.str_pos)
                    WRMEM_8(rtmp, 0, 95)
                    WRMEM_8(rtmp, 1, 95)
                    WRMEM_8(rtmp, 2, 114)
                    WRMEM_8(rtmp, 3, 115)
                    WRMEM_8(rtmp, 4, 95)
                    WRMEM_8(rtmp, 5, 95)
                    WRMEM_8(rtmp, 6, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    rs = JSComp__AddLocal(rtmp, 6)
                    JSComp__Emit1(JSOp.PUSH_UNDEF)
                    JSComp__Emit1(JSOp.SWAP)
                    JSComp__EmitOp16(JSOp.SET_LOCAL, rs)
                    JSComp__Emit1(JSOp.POP)
                    IfCondition EqualTo(rest_tt, ASTType.OBJECT_PATTERN) ThenBlock: {
                        JSComp__CompileObjPattern(rest_tgt, rs)
                    }
                    IfCondition EqualTo(rest_tt, ASTType.ARRAY_PATTERN) ThenBlock: {
                        JSComp__CompileArrayPattern(rest_tgt, rs)
                    }
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                }
                prop = -1
            }

            // PROPERTY: {key: binding} or {key} (shorthand) or {[expr]: binding}
            // M128e6aa KeyedDestructuringAssignmentEvaluation order:
            //   PropertyName → lref (member base+key expr) → GetV → Initializer → PutValue
            // PutValue's ToPropertyKey(target key) runs at SET_ELEM (after get).
            IfCondition EqualTo(ptyp, ASTType.PROPERTY) ThenBlock: {
                binding_nd = JSParse_GetLeft(prop)
                btype = JSParse_GetType(binding_nd)
                def_nd2 = JSParse_GetRight(prop)
                comp_k = JSParse_GetCond(prop)

                // --- Phase 1: evaluate source PropertyName into sk temp / const ---
                sk_mode = 0
                // 0 = GET_PROP string const; 1 = GET_ELEM from sk_slot
                sk_slot = -1
                sk_pci = -1
                IfCondition GreaterEqual(comp_k, 0) ThenBlock: {
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    JSComp__Push(binding_nd)
                    JSComp__CompileExpr(comp_k)
                    binding_nd = JSComp__Pop()
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                    // PropertyName includes ToPropertyKey before lref / GetV
                    JSComp__Emit1(JSOp.TO_PROP_KEY)
                    sknm = Add(JSCompState.str_buf, JSCompState.str_pos)
                    WRMEM_8(sknm, 0, 95)
                    WRMEM_8(sknm, 1, 95)
                    WRMEM_8(sknm, 2, 115)
                    WRMEM_8(sknm, 3, 107)
                    WRMEM_8(sknm, 4, 95)
                    WRMEM_8(sknm, 5, 95)
                    WRMEM_8(sknm, 6, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    JSComp__Push(binding_nd)
                    sk_slot = JSComp__AddLocal(sknm, 6)
                    binding_nd = JSComp__Pop()
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_LOCAL, sk_slot)
                    sk_mode = 1
                } ElseBlock: {
                    pnp = JSParse_GetNamePtr(prop)
                    pnl = JSParse_GetNameLen(prop)
                    is_num_key = 0
                    num_key_val = 0
                    IfCondition GreaterThan(pnl, 0) ThenBlock: {
                        is_num_key = 1
                        ni = 0
                        WhileLoop LessThan(ni, pnl) {
                            ch = RDMEM_8(pnp, ni)
                            IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                                is_num_key = 0
                            }
                            IfCondition EqualTo(is_num_key, 1) ThenBlock: {
                                num_key_val = Add(Multiply(num_key_val, 10), Subtract(ch, 48))
                            }
                            ni = Add(ni, 1)
                        }
                    }
                    IfCondition EqualTo(is_num_key, 1) ThenBlock: {
                        JSComp__Push(save_src)
                        JSComp__Push(prop)
                        JSComp__Push(binding_nd)
                        nki = JSComp__AddNumber(num_key_val)
                        binding_nd = JSComp__Pop()
                        prop = JSComp__Pop()
                        save_src = JSComp__Pop()
                        JSComp__EmitOp16(JSOp.PUSH_CONST, nki)
                        sknm2 = Add(JSCompState.str_buf, JSCompState.str_pos)
                        WRMEM_8(sknm2, 0, 95)
                        WRMEM_8(sknm2, 1, 95)
                        WRMEM_8(sknm2, 2, 115)
                        WRMEM_8(sknm2, 3, 110)
                        WRMEM_8(sknm2, 4, 95)
                        WRMEM_8(sknm2, 5, 95)
                        WRMEM_8(sknm2, 6, 0)
                        JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                        JSComp__Push(save_src)
                        JSComp__Push(prop)
                        JSComp__Push(binding_nd)
                        sk_slot = JSComp__AddLocal(sknm2, 6)
                        binding_nd = JSComp__Pop()
                        prop = JSComp__Pop()
                        save_src = JSComp__Pop()
                        JSComp__EmitOp16(JSOp.SET_LOCAL, sk_slot)
                        sk_mode = 1
                    } ElseBlock: {
                        JSComp__Push(save_src)
                        JSComp__Push(prop)
                        JSComp__Push(binding_nd)
                        sk_pci = JSComp__AddString(pnp, pnl)
                        binding_nd = JSComp__Pop()
                        prop = JSComp__Pop()
                        save_src = JSComp__Pop()
                        sk_mode = 0
                    }
                }

                // --- Phase 2: evaluate member lref BEFORE GetV ---
                lref_base_slot = -1
                lref_key_slot = -1
                IfCondition EqualTo(btype, ASTType.MEMBER_BRACKET) ThenBlock: {
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    JSComp__Push(binding_nd)
                    JSComp__Push(sk_slot)
                    JSComp__Push(sk_pci)
                    JSComp__Push(sk_mode)
                    JSComp__CompileExpr(JSParse_GetLeft(binding_nd))
                    sk_mode = JSComp__Pop()
                    sk_pci = JSComp__Pop()
                    sk_slot = JSComp__Pop()
                    binding_nd = JSComp__Pop()
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                    lbnm = Add(JSCompState.str_buf, JSCompState.str_pos)
                    WRMEM_8(lbnm, 0, 95)
                    WRMEM_8(lbnm, 1, 95)
                    WRMEM_8(lbnm, 2, 108)
                    WRMEM_8(lbnm, 3, 98)
                    WRMEM_8(lbnm, 4, 95)
                    WRMEM_8(lbnm, 5, 95)
                    WRMEM_8(lbnm, 6, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    JSComp__Push(binding_nd)
                    JSComp__Push(sk_slot)
                    JSComp__Push(sk_pci)
                    JSComp__Push(sk_mode)
                    lref_base_slot = JSComp__AddLocal(lbnm, 6)
                    sk_mode = JSComp__Pop()
                    sk_pci = JSComp__Pop()
                    sk_slot = JSComp__Pop()
                    binding_nd = JSComp__Pop()
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_LOCAL, lref_base_slot)
                    // Key expr only — ToPropertyKey deferred to SET_ELEM (after get)
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    JSComp__Push(binding_nd)
                    JSComp__Push(sk_slot)
                    JSComp__Push(sk_pci)
                    JSComp__Push(sk_mode)
                    JSComp__Push(lref_base_slot)
                    JSComp__CompileExpr(JSParse_GetRight(binding_nd))
                    lref_base_slot = JSComp__Pop()
                    sk_mode = JSComp__Pop()
                    sk_pci = JSComp__Pop()
                    sk_slot = JSComp__Pop()
                    binding_nd = JSComp__Pop()
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                    lknm = Add(JSCompState.str_buf, JSCompState.str_pos)
                    WRMEM_8(lknm, 0, 95)
                    WRMEM_8(lknm, 1, 95)
                    WRMEM_8(lknm, 2, 108)
                    WRMEM_8(lknm, 3, 107)
                    WRMEM_8(lknm, 4, 95)
                    WRMEM_8(lknm, 5, 95)
                    WRMEM_8(lknm, 6, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    JSComp__Push(binding_nd)
                    JSComp__Push(sk_slot)
                    JSComp__Push(sk_pci)
                    JSComp__Push(sk_mode)
                    JSComp__Push(lref_base_slot)
                    lref_key_slot = JSComp__AddLocal(lknm, 6)
                    lref_base_slot = JSComp__Pop()
                    sk_mode = JSComp__Pop()
                    sk_pci = JSComp__Pop()
                    sk_slot = JSComp__Pop()
                    binding_nd = JSComp__Pop()
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_LOCAL, lref_key_slot)
                }
                IfCondition EqualTo(btype, ASTType.MEMBER_DOT) ThenBlock: {
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    JSComp__Push(binding_nd)
                    JSComp__Push(sk_slot)
                    JSComp__Push(sk_pci)
                    JSComp__Push(sk_mode)
                    JSComp__CompileExpr(JSParse_GetLeft(binding_nd))
                    sk_mode = JSComp__Pop()
                    sk_pci = JSComp__Pop()
                    sk_slot = JSComp__Pop()
                    binding_nd = JSComp__Pop()
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                    ldnm = Add(JSCompState.str_buf, JSCompState.str_pos)
                    WRMEM_8(ldnm, 0, 95)
                    WRMEM_8(ldnm, 1, 95)
                    WRMEM_8(ldnm, 2, 108)
                    WRMEM_8(ldnm, 3, 100)
                    WRMEM_8(ldnm, 4, 95)
                    WRMEM_8(ldnm, 5, 95)
                    WRMEM_8(ldnm, 6, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 7)
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    JSComp__Push(binding_nd)
                    JSComp__Push(sk_slot)
                    JSComp__Push(sk_pci)
                    JSComp__Push(sk_mode)
                    lref_base_slot = JSComp__AddLocal(ldnm, 6)
                    sk_mode = JSComp__Pop()
                    sk_pci = JSComp__Pop()
                    sk_slot = JSComp__Pop()
                    binding_nd = JSComp__Pop()
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_LOCAL, lref_base_slot)
                }

                // --- Phase 3: GetV(source, propertyName) ---
                JSComp__EmitOp16(JSOp.GET_LOCAL, save_src)
                IfCondition EqualTo(sk_mode, 1) ThenBlock: {
                    JSComp__EmitOp16(JSOp.GET_LOCAL, sk_slot)
                    JSComp__Emit1(JSOp.GET_ELEM)
                } ElseBlock: {
                    JSComp__EmitOp16(JSOp.GET_PROP, sk_pci)
                }

                // --- Phase 4: default Initializer ---
                IfCondition GreaterEqual(def_nd2, 0) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    JSComp__Emit1(JSOp.PUSH_UNDEF)
                    JSComp__Emit1(JSOp.STRICT_EQ)
                    skip_def2 = JSCompState.code_pos
                    JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                    JSComp__Emit1(JSOp.POP)
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    JSComp__Push(binding_nd)
                    JSComp__Push(lref_base_slot)
                    JSComp__Push(lref_key_slot)
                    JSComp__CompileExpr(def_nd2)
                    lref_key_slot = JSComp__Pop()
                    lref_base_slot = JSComp__Pop()
                    binding_nd = JSComp__Pop()
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                    JSComp__PatchJump(skip_def2)
                }

                // --- Phase 5: PutValue / nested patterns ---
                IfCondition EqualTo(btype, ASTType.MEMBER_BRACKET) ThenBlock: {
                    // stack [value]; SET_ELEM wants [value, obj, key]
                    JSComp__EmitOp16(JSOp.GET_LOCAL, lref_base_slot)
                    JSComp__EmitOp16(JSOp.GET_LOCAL, lref_key_slot)
                    JSComp__Emit1(JSOp.SET_ELEM)
                }
                IfCondition EqualTo(btype, ASTType.MEMBER_DOT) ThenBlock: {
                    // stack [value]; SET_PROP wants [obj, value]
                    JSComp__EmitOp16(JSOp.GET_LOCAL, lref_base_slot)
                    JSComp__Emit1(JSOp.SWAP)
                    bnp = JSParse_GetNamePtr(binding_nd)
                    bnl = JSParse_GetNameLen(binding_nd)
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    mci_ob = JSComp__AddString(bnp, bnl)
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                    JSComp__EmitOp16(JSOp.SET_PROP, mci_ob)
                }
                IfCondition EqualTo(btype, ASTType.IDENT) ThenBlock: {
                    bnp = JSParse_GetNamePtr(binding_nd)
                    bnl = JSParse_GetNameLen(binding_nd)
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    JSComp__EmitDstrBind(binding_nd)
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                    // Mole 13 / M128e6z: SetFunctionName for {fn = function(){}} (unwrap PAREN)
                    IfCondition GreaterEqual(def_nd2, 0) ThenBlock: {
                        IfCondition EqualTo(JSComp__IsAnonFuncDef(def_nd2), 1) ThenBlock: {
                                bslot2 = JSComp__FindLocal(bnp, bnl)
                                // M48: local or global {fn = function(){}}
                                IfCondition GreaterEqual(bslot2, 0) ThenBlock: {
                                    JSComp__EmitOp16(JSOp.GET_LOCAL, bslot2)
                                } ElseBlock: {
                                    JSComp__Push(save_src)
                                    JSComp__Push(prop)
                                    gci2 = JSComp__AddString(bnp, bnl)
                                    prop = JSComp__Pop()
                                    save_src = JSComp__Pop()
                                    JSComp__EmitOp16(JSOp.GET_GLOBAL, gci2)
                                }
                                // Only set .name if currently empty
                                JSComp__Emit1(JSOp.DUP)
                                name_key2 = Add(JSCompState.str_buf, JSCompState.str_pos)
                                WRMEM_8(name_key2, 0, 110)
                                WRMEM_8(name_key2, 1, 97)
                                WRMEM_8(name_key2, 2, 109)
                                WRMEM_8(name_key2, 3, 101)
                                WRMEM_8(name_key2, 4, 0)
                                JSCompState.str_pos = Add(JSCompState.str_pos, 5)
                                JSComp__Push(save_src)
                                JSComp__Push(prop)
                                nkci2 = JSComp__AddString(name_key2, 4)
                                prop = JSComp__Pop()
                                save_src = JSComp__Pop()
                                JSComp__EmitOp16(JSOp.GET_PROP, nkci2)
                                JSComp__Emit1(JSOp.DUP)
                                empty_nm2 = Add(JSCompState.str_buf, JSCompState.str_pos)
                                WRMEM_8(empty_nm2, 0, 0)
                                JSCompState.str_pos = Add(JSCompState.str_pos, 1)
                                JSComp__Push(nkci2)
                                empty_ci2 = JSComp__AddString(empty_nm2, 0)
                                nkci2 = JSComp__Pop()
                                JSComp__EmitOp16(JSOp.PUSH_CONST, empty_ci2)
                                JSComp__Emit1(JSOp.STRICT_EQ)
                                skip_nm2 = JSCompState.code_pos
                                JSComp__EmitOp16(JSOp.JMP_FALSE, 0)
                                JSComp__Emit1(JSOp.POP)
                                JSComp__Push(save_src)
                                JSComp__Push(prop)
                                JSComp__Push(skip_nm2)
                                nci2 = JSComp__AddString(bnp, bnl)
                                skip_nm2 = JSComp__Pop()
                                prop = JSComp__Pop()
                                save_src = JSComp__Pop()
                                JSComp__EmitOp16(JSOp.PUSH_CONST, nci2)
                                JSComp__EmitOp16(JSOp.SET_FUNC_NAME, nkci2)
                                skip_nm2_end = JSCompState.code_pos
                                JSComp__EmitOp16(JSOp.JMP, 0)
                                JSComp__PatchJump(skip_nm2)
                                JSComp__Emit1(JSOp.POP)
                                JSComp__Emit1(JSOp.POP)
                                JSComp__PatchJump(skip_nm2_end)
                        }
                    }
                }
                IfCondition EqualTo(btype, ASTType.ARRAY_PATTERN) ThenBlock: {
                    tmp_nm5 = Add(JSCompState.str_buf, JSCompState.str_pos)
                    WRMEM_8(tmp_nm5, 0, 95)
                    WRMEM_8(tmp_nm5, 1, 95)
                    WRMEM_8(tmp_nm5, 2, 112)
                    WRMEM_8(tmp_nm5, 3, 95)
                    WRMEM_8(tmp_nm5, 4, 95)
                    WRMEM_8(tmp_nm5, 5, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 6)
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    asub_slot = JSComp__AddLocal(tmp_nm5, 5)
                    JSComp__Emit1(JSOp.PUSH_UNDEF)
                    JSComp__Emit1(JSOp.SWAP)
                    JSComp__EmitOp16(JSOp.SET_LOCAL, asub_slot)
                    JSComp__Emit1(JSOp.POP)
                    JSComp__CompileArrayPattern(binding_nd, asub_slot)
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                }
                IfCondition EqualTo(btype, ASTType.OBJECT_PATTERN) ThenBlock: {
                    tmp_nm6 = Add(JSCompState.str_buf, JSCompState.str_pos)
                    WRMEM_8(tmp_nm6, 0, 95)
                    WRMEM_8(tmp_nm6, 1, 95)
                    WRMEM_8(tmp_nm6, 2, 113)
                    WRMEM_8(tmp_nm6, 3, 95)
                    WRMEM_8(tmp_nm6, 4, 95)
                    WRMEM_8(tmp_nm6, 5, 0)
                    JSCompState.str_pos = Add(JSCompState.str_pos, 6)
                    JSComp__Push(save_src)
                    JSComp__Push(prop)
                    osub_slot3 = JSComp__AddLocal(tmp_nm6, 5)
                    JSComp__Emit1(JSOp.PUSH_UNDEF)
                    JSComp__Emit1(JSOp.SWAP)
                    JSComp__EmitOp16(JSOp.SET_LOCAL, osub_slot3)
                    JSComp__Emit1(JSOp.POP)
                    JSComp__CompileObjPattern(binding_nd, osub_slot3)
                    prop = JSComp__Pop()
                    save_src = JSComp__Pop()
                }

                prop = JSParse_GetNext(prop)
            } ElseBlock: {
                // M128e6p: unknown node types (e.g. unconverted COMPUTED_PROP)
                // must still advance — else compile infinite-loops.
                prop = JSParse_GetNext(prop)
            }
        }
        ReturnValue(0)
    }
}
