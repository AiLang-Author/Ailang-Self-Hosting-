// =============================================================================
// STATEMENT PARSING — recursive descent
// =============================================================================

// ---------------------------------------------------------------------------
// Block — { statement* }
// CLOBBER FIX: push node, first, last before JSParse__Statement()
// ---------------------------------------------------------------------------
Function.JSParse__Block {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        JSParse__Expect(JSTokType.LBRACE)
        // Inline PushScope: zero count for new level, then increment depth
        StoreValue(Add(JSValidState.scope_counts, Multiply(JSValidState.scope_depth, 8)), 0)
        JSValidState.scope_depth = Add(JSValidState.scope_depth, 1)
        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.BLOCK)
        ASTTmp.first = -1
        ASTTmp.last = -1

        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.RBRACE) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                // CLOBBER GUARD: push node, first, last, done before Statement
                AST__Push(ASTTmp.node)
                AST__Push(ASTTmp.first)
                AST__Push(ASTTmp.last)
                AST__Push(ASTTmp.done)

                stmt = JSParse__Statement()

                // RESTORE
                ASTTmp.done = AST__Pop()
                ASTTmp.last = AST__Pop()
                ASTTmp.first = AST__Pop()
                ASTTmp.node = AST__Pop()

                IfCondition EqualTo(ASTTmp.first, -1) ThenBlock: {
                    ASTTmp.first = stmt
                    ASTTmp.last = stmt
                } ElseBlock: {
                    JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, stmt)
                    ASTTmp.last = stmt
                }

                // Walk to end of multi-var chain (var x=1, y=2 creates linked VAR_DECLs)
                ASTTmp.idx = JSParse_GetNext(ASTTmp.last)
                WhileLoop GreaterEqual(ASTTmp.idx, 0) {
                    ASTTmp.last = ASTTmp.idx
                    ASTTmp.idx = JSParse_GetNext(ASTTmp.last)
                }
            }
        }

        JSParse__Expect(JSTokType.RBRACE)
        // Inline PopScope: decrement depth, zero count for popped level
        JSValidState.scope_depth = Subtract(JSValidState.scope_depth, 1)
        StoreValue(Add(JSValidState.scope_counts, Multiply(JSValidState.scope_depth, 8)), 0)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.first)
        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// CoverToPattern — convert array/object literal to destructuring pattern
// Cover grammar: [a, b] parsed as ARRAY_LIT, then reinterpreted as ARRAY_PATTERN
// when = follows. Recursively converts element nodes.
// ---------------------------------------------------------------------------
Function.JSParse__CoverToPattern {
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(node) }

        cvt_type = JSParse_GetType(node)

        // ARRAY_LIT → ARRAY_PATTERN
        IfCondition EqualTo(cvt_type, ASTType.ARRAY_LIT) ThenBlock: {
            JSParse__NodeSet(node, ASTConst.N_TYPE, ASTType.ARRAY_PATTERN)
            // Walk elements (linked via N_NEXT on children of N_LEFT)
            cvt_elem = JSParse_GetLeft(node)
            WhileLoop GreaterEqual(cvt_elem, 0) {
                cvt_et = JSParse_GetType(cvt_elem)
                // Elision hole: UNDEF_LIT (legacy) or keep ELISION as-is
                IfCondition EqualTo(cvt_et, ASTType.UNDEF_LIT) ThenBlock: {
                    JSParse__NodeSet(cvt_elem, ASTConst.N_TYPE, ASTType.ELISION)
                }
                // SPREAD_ELEMENT → REST_ELEMENT
                IfCondition EqualTo(cvt_et, ASTType.SPREAD_ELEMENT) ThenBlock: {
                    JSParse__NodeSet(cvt_elem, ASTConst.N_TYPE, ASTType.REST_ELEMENT)
                    // Recurse into spread target
                    cvt_inner = JSParse_GetLeft(cvt_elem)
                    JSParse__CoverToPattern(cvt_inner)
                }
                // Nested ARRAY_LIT or OBJECT_LIT → recurse
                IfCondition EqualTo(cvt_et, ASTType.ARRAY_LIT) ThenBlock: {
                    JSParse__CoverToPattern(cvt_elem)
                }
                IfCondition EqualTo(cvt_et, ASTType.OBJECT_LIT) ThenBlock: {
                    JSParse__CoverToPattern(cvt_elem)
                }
                // ASSIGN node (default value): cover grammar builds
                //   ASSIGN(LEFT=target, RIGHT=default)  [expr form]
                // Pattern compilers expect
                //   ASSIGN(LEFT=default, RIGHT=target)  [ParseArrayPattern form]
                // Swap and recurse into the binding target.
                IfCondition EqualTo(cvt_et, ASTType.ASSIGN) ThenBlock: {
                    cvt_atarget = JSParse_GetLeft(cvt_elem)
                    cvt_adef = JSParse_GetRight(cvt_elem)
                    IfCondition GreaterEqual(cvt_atarget, 0) ThenBlock: {
                        JSParse__CoverToPattern(cvt_atarget)
                    }
                    JSParse__NodeSet(cvt_elem, ASTConst.N_LEFT, cvt_adef)
                    JSParse__NodeSet(cvt_elem, ASTConst.N_RIGHT, cvt_atarget)
                }
                // IDENT stays as-is
                // MEMBER_DOT, MEMBER_BRACKET stay as-is (valid assignment targets)
                cvt_elem = JSParse_GetNext(cvt_elem)
            }
            ReturnValue(node)
        }

        // OBJECT_LIT → OBJECT_PATTERN
        IfCondition EqualTo(cvt_type, ASTType.OBJECT_LIT) ThenBlock: {
            JSParse__NodeSet(node, ASTConst.N_TYPE, ASTType.OBJECT_PATTERN)
            // Walk properties (linked via N_NEXT, stored in N_LEFT for obj lit)
            cvt_prop = JSParse_GetLeft(node)
            WhileLoop GreaterEqual(cvt_prop, 0) {
                cvt_pt = JSParse_GetType(cvt_prop)
                // SPREAD_ELEMENT → REST_ELEMENT
                IfCondition EqualTo(cvt_pt, ASTType.SPREAD_ELEMENT) ThenBlock: {
                    JSParse__NodeSet(cvt_prop, ASTConst.N_TYPE, ASTType.REST_ELEMENT)
                }
                // PROPERTY node: convert value (N_LEFT) if it's a nested literal
                IfCondition EqualTo(cvt_pt, ASTType.PROPERTY) ThenBlock: {
                    cvt_pval = JSParse_GetLeft(cvt_prop)
                    IfCondition GreaterEqual(cvt_pval, 0) ThenBlock: {
                        cvt_pvt = JSParse_GetType(cvt_pval)
                        IfCondition EqualTo(cvt_pvt, ASTType.ARRAY_LIT) ThenBlock: {
                            JSParse__CoverToPattern(cvt_pval)
                        }
                        IfCondition EqualTo(cvt_pvt, ASTType.OBJECT_LIT) ThenBlock: {
                            JSParse__CoverToPattern(cvt_pval)
                        }
                        // ASSIGN in property value: normalize to PROPERTY.N_LEFT=binding, PROPERTY.N_RIGHT=default
                        // Cover grammar produces PROPERTY(value=ASSIGN(IDENT, default))
                        // Compiler expects PROPERTY(N_LEFT=binding, N_RIGHT=default)
                        IfCondition EqualTo(cvt_pvt, ASTType.ASSIGN) ThenBlock: {
                            cvt_palhs = JSParse_GetLeft(cvt_pval)
                            cvt_pdefault = JSParse_GetRight(cvt_pval)
                            // Recurse on binding target
                            IfCondition GreaterEqual(cvt_palhs, 0) ThenBlock: {
                                JSParse__CoverToPattern(cvt_palhs)
                            }
                            // Move binding to PROPERTY.N_LEFT, default to PROPERTY.N_RIGHT
                            JSParse__NodeSet(cvt_prop, ASTConst.N_LEFT, cvt_palhs)
                            JSParse__NodeSet(cvt_prop, ASTConst.N_RIGHT, cvt_pdefault)
                        }
                    }
                }
                cvt_prop = JSParse_GetNext(cvt_prop)
            }
            ReturnValue(node)
        }

        ReturnValue(node)
    }
}

// ---------------------------------------------------------------------------
// ParseArrayPattern — [ elem, elem, ...rest ]
// Returns ARRAY_PATTERN node. Elements linked via N_NEXT.
// Each element: IDENT node, nested pattern, or REST_ELEMENT.
// Holes (elision) represented as ELISION nodes (M52; was NULL_LIT).
// ---------------------------------------------------------------------------
Function.JSParse__ArrayPattern {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }
        // Consume '['
        JSParse__Expect(JSTokType.LBRACKET)
        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.ARRAY_PATTERN)

        pat_first = -1
        pat_last = -1

        WhileLoop NotEqual(JSParse__PeekType(), JSTokType.RBRACKET) {
            IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }
            IfCondition EqualTo(JSParse__PeekType(), JSTokType.EOF) ThenBlock: { ReturnValue(-1) }

            // Check for elision (consecutive commas)
            IfCondition EqualTo(JSParse__PeekType(), JSTokType.COMMA) ThenBlock: {
                JSParse__Advance()
                // Add a hole (ELISION) element
                hole_node = JSParse__AllocNode()
                JSParse__NodeSet(hole_node, ASTConst.N_TYPE, ASTType.ELISION)
                IfCondition LessThan(pat_first, 0) ThenBlock: {
                    pat_first = hole_node
                    pat_last = hole_node
                } ElseBlock: {
                    JSParse__NodeSet(pat_last, ASTConst.N_NEXT, hole_node)
                    pat_last = hole_node
                }
            } ElseBlock: {
                // Check for rest element: ...
                IfCondition EqualTo(JSParse__PeekType(), JSTokType.DOT3) ThenBlock: {
                    JSParse__Advance()
                    rest_nd = JSParse__AllocNode()
                    JSParse__NodeSet(rest_nd, ASTConst.N_TYPE, ASTType.REST_ELEMENT)

                    // The binding after ...
                    AST__Push(ASTTmp.node)
                    AST__Push(pat_first)
                    AST__Push(pat_last)
                    AST__Push(rest_nd)
                    rest_target = JSParse__ParseBindTarget()
                    rest_nd = AST__Pop()
                    pat_last = AST__Pop()
                    pat_first = AST__Pop()
                    ASTTmp.node = AST__Pop()

                    JSParse__NodeSet(rest_nd, ASTConst.N_LEFT, rest_target)
                    IfCondition LessThan(pat_first, 0) ThenBlock: {
                        pat_first = rest_nd
                        pat_last = rest_nd
                    } ElseBlock: {
                        JSParse__NodeSet(pat_last, ASTConst.N_NEXT, rest_nd)
                        pat_last = rest_nd
                    }
                    // Rest must be last — consume optional trailing comma, then reject if not ]
                    IfCondition EqualTo(JSParse__PeekType(), JSTokType.COMMA) ThenBlock: {
                        JSParse__Advance()
                    }
                    IfCondition NotEqual(JSParse__PeekType(), JSTokType.RBRACKET) ThenBlock: {
                        // Elements after rest — SyntaxError
                        ASTState.error = 1
                        ReturnValue(-1)
                    }
                } ElseBlock: {
                    // Regular element: identifier or nested pattern
                    AST__Push(ASTTmp.node)
                    AST__Push(pat_first)
                    AST__Push(pat_last)
                    elem = JSParse__ParseBindTarget()
                    pat_last = AST__Pop()
                    pat_first = AST__Pop()
                    ASTTmp.node = AST__Pop()

                    // Check for default value: = expr
                    IfCondition EqualTo(JSParse__PeekType(), JSTokType.ASSIGN) ThenBlock: {
                        JSParse__Advance()
                        wrap_nd = JSParse__AllocNode()
                        JSParse__NodeSet(wrap_nd, ASTConst.N_TYPE, ASTType.ASSIGN)
                        JSParse__NodeSet(wrap_nd, ASTConst.N_RIGHT, elem)

                        AST__Push(ASTTmp.node)
                        AST__Push(pat_first)
                        AST__Push(pat_last)
                        AST__Push(wrap_nd)
                        def_val = JSParse__Assign()
                        wrap_nd = AST__Pop()
                        pat_last = AST__Pop()
                        pat_first = AST__Pop()
                        ASTTmp.node = AST__Pop()

                        JSParse__NodeSet(wrap_nd, ASTConst.N_LEFT, def_val)
                        elem = wrap_nd
                    }

                    IfCondition LessThan(pat_first, 0) ThenBlock: {
                        pat_first = elem
                        pat_last = elem
                    } ElseBlock: {
                        JSParse__NodeSet(pat_last, ASTConst.N_NEXT, elem)
                        pat_last = elem
                    }

                    // Consume comma if present
                    IfCondition EqualTo(JSParse__PeekType(), JSTokType.COMMA) ThenBlock: {
                        JSParse__Advance()
                    }
                }
            }
        }
        // Consume ']'
        JSParse__Expect(JSTokType.RBRACKET)

        JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, pat_first)
        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// ParseObjectPattern — { key, key: binding, ...rest }
// Returns OBJECT_PATTERN node. Properties linked via N_NEXT.
// ---------------------------------------------------------------------------
Function.JSParse__ObjectPattern {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }
        // Consume '{'
        JSParse__Expect(JSTokType.LBRACE)
        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.OBJECT_PATTERN)

        pat_first = -1
        pat_last = -1

        WhileLoop NotEqual(JSParse__PeekType(), JSTokType.RBRACE) {
            IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }
            IfCondition EqualTo(JSParse__PeekType(), JSTokType.EOF) ThenBlock: { ReturnValue(-1) }

            // Check for rest element: ...
            IfCondition EqualTo(JSParse__PeekType(), JSTokType.DOT3) ThenBlock: {
                JSParse__Advance()
                rest_nd = JSParse__AllocNode()
                JSParse__NodeSet(rest_nd, ASTConst.N_TYPE, ASTType.REST_ELEMENT)

                AST__Push(ASTTmp.node)
                AST__Push(pat_first)
                AST__Push(pat_last)
                AST__Push(rest_nd)
                rest_target = JSParse__ParseBindTarget()
                rest_nd = AST__Pop()
                pat_last = AST__Pop()
                pat_first = AST__Pop()
                ASTTmp.node = AST__Pop()

                JSParse__NodeSet(rest_nd, ASTConst.N_LEFT, rest_target)
                IfCondition LessThan(pat_first, 0) ThenBlock: {
                    pat_first = rest_nd
                    pat_last = rest_nd
                } ElseBlock: {
                    JSParse__NodeSet(pat_last, ASTConst.N_NEXT, rest_nd)
                    pat_last = rest_nd
                }
                // Rest must be last — consume optional trailing comma, then reject if not }
                IfCondition EqualTo(JSParse__PeekType(), JSTokType.COMMA) ThenBlock: {
                    JSParse__Advance()
                }
                IfCondition NotEqual(JSParse__PeekType(), JSTokType.RBRACE) ThenBlock: {
                    // Elements after rest — SyntaxError
                    ASTState.error = 1
                    ReturnValue(-1)
                }
            } ElseBlock: {
                // Property: key (: binding)? (= default)?
                // Key may be IDENT, STRING, NUMBER, or [computed]
                prop_nd = JSParse__AllocNode()
                JSParse__NodeSet(prop_nd, ASTConst.N_TYPE, ASTType.PROPERTY)

                key_tok = JSParse__PeekType()
                // Mole 15: computed property name [expr]
                IfCondition EqualTo(key_tok, JSTokType.LBRACKET) ThenBlock: {
                    JSParse__Advance()
                    AST__Push(ASTTmp.node)
                    AST__Push(pat_first)
                    AST__Push(pat_last)
                    AST__Push(prop_nd)
                    comp_key = JSParse__Assign()
                    prop_nd = AST__Pop()
                    pat_last = AST__Pop()
                    pat_first = AST__Pop()
                    ASTTmp.node = AST__Pop()
                    // Store computed key expr in N_COND
                    JSParse__NodeSet(prop_nd, ASTConst.N_COND, comp_key)
                    JSParse__NodeSet(prop_nd, ASTConst.N_NAME_LEN, 0)
                    JSParse__Expect(JSTokType.RBRACKET)
                } ElseBlock: {
                    IfCondition Or(EqualTo(key_tok, JSTokType.IDENT), Or(EqualTo(key_tok, JSTokType.STRING), EqualTo(key_tok, JSTokType.NUMBER))) ThenBlock: {
                        key_idx = JSParse__Advance()
                    } ElseBlock: {
                        key_idx = JSParse__Expect(JSTokType.IDENT)
                    }
                    key_ptr = JSLex_GetPtr(key_idx)
                    key_len = JSLex_GetLen(key_idx)
                    // M70: BigInt dstr key `1n` → "1"
                    IfCondition GreaterThan(key_len, 1) ThenBlock: {
                        IfCondition EqualTo(GetByte(key_ptr, Subtract(key_len, 1)), 110) ThenBlock: {
                            IfCondition And(GreaterEqual(GetByte(key_ptr, 0), 48), LessEqual(GetByte(key_ptr, 0), 57)) ThenBlock: {
                                key_len = Subtract(key_len, 1)
                            }
                        }
                    }
                    JSParse__NodeSet(prop_nd, ASTConst.N_NAME_PTR, key_ptr)
                    JSParse__NodeSet(prop_nd, ASTConst.N_NAME_LEN, key_len)
                }

                // Check for : binding
                IfCondition EqualTo(JSParse__PeekType(), JSTokType.COLON) ThenBlock: {
                    JSParse__Advance()

                    AST__Push(ASTTmp.node)
                    AST__Push(pat_first)
                    AST__Push(pat_last)
                    AST__Push(prop_nd)
                    binding = JSParse__ParseBindTarget()
                    prop_nd = AST__Pop()
                    pat_last = AST__Pop()
                    pat_first = AST__Pop()
                    ASTTmp.node = AST__Pop()

                    JSParse__NodeSet(prop_nd, ASTConst.N_LEFT, binding)
                } ElseBlock: {
                    // Shorthand: {a} means {a: a}
                    short_nd = JSParse__AllocNode()
                    JSParse__NodeSet(short_nd, ASTConst.N_TYPE, ASTType.IDENT)
                    JSParse__NodeSet(short_nd, ASTConst.N_NAME_PTR, key_ptr)
                    JSParse__NodeSet(short_nd, ASTConst.N_NAME_LEN, key_len)
                    JSParse__NodeSet(prop_nd, ASTConst.N_LEFT, short_nd)
                }

                // Check for default: = expr
                IfCondition EqualTo(JSParse__PeekType(), JSTokType.ASSIGN) ThenBlock: {
                    JSParse__Advance()

                    AST__Push(ASTTmp.node)
                    AST__Push(pat_first)
                    AST__Push(pat_last)
                    AST__Push(prop_nd)
                    def_val2 = JSParse__Assign()
                    prop_nd = AST__Pop()
                    pat_last = AST__Pop()
                    pat_first = AST__Pop()
                    ASTTmp.node = AST__Pop()

                    JSParse__NodeSet(prop_nd, ASTConst.N_RIGHT, def_val2)
                }

                IfCondition LessThan(pat_first, 0) ThenBlock: {
                    pat_first = prop_nd
                    pat_last = prop_nd
                } ElseBlock: {
                    JSParse__NodeSet(pat_last, ASTConst.N_NEXT, prop_nd)
                    pat_last = prop_nd
                }

                // Consume comma if present
                IfCondition EqualTo(JSParse__PeekType(), JSTokType.COMMA) ThenBlock: {
                    JSParse__Advance()
                }
            }
        }
        // Consume '}'
        JSParse__Expect(JSTokType.RBRACE)

        JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, pat_first)
        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// ParseBindTarget — parse a binding target (IDENT, [pattern], {pattern})
// ---------------------------------------------------------------------------
Function.JSParse__ParseBindTarget {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }
        pt = JSParse__PeekType()
        IfCondition EqualTo(pt, JSTokType.LBRACKET) ThenBlock: {
            ReturnValue(JSParse__ArrayPattern())
        }
        IfCondition EqualTo(pt, JSTokType.LBRACE) ThenBlock: {
            ReturnValue(JSParse__ObjectPattern())
        }
        // Default: identifier
        id_idx = JSParse__Expect(JSTokType.IDENT)
        id_nd = JSParse__AllocNode()
        JSParse__NodeSet(id_nd, ASTConst.N_TYPE, ASTType.IDENT)
        JSParse__NodeSet(id_nd, ASTConst.N_NAME_PTR, JSLex_GetPtr(id_idx))
        JSParse__NodeSet(id_nd, ASTConst.N_NAME_LEN, JSLex_GetLen(id_idx))
        ReturnValue(id_nd)
    }
}

// ---------------------------------------------------------------------------
// VarDecl — var/let/const IDENT [= expr] ;
// When called from ForStmt with skip_semi=1, does not consume trailing SEMI
// CLOBBER FIX: push node before JSParse__Expr()
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// VarDeclSingle — parse one declarator: IDENT (= expr)? | pattern = expr
// Used by VarDecl for comma-separated multi-var: var x=1, y=2;
// kw_type: the var/let/const keyword type, skip_semi: 1 to skip trailing ;
// Chains additional declarators via N_NEXT on COMMA.
// ---------------------------------------------------------------------------
Function.JSParse__VarDeclSingle {
    Input: kw_type: Integer
    Input: skip_semi: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Save inputs to FixedPool — registers won't survive calls
        ASTTmp.op = kw_type
        ASTTmp.done = skip_semi
        // Push kw_type to the AST stack — most reliable preservation method
        AST__Push(ASTState.err_msg)

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.VAR_DECL)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, ASTTmp.op)

        // Check for destructuring pattern: [ or {
        ASTTmp.type = JSParse__PeekType()
        IfCondition Or(EqualTo(ASTTmp.type, JSTokType.LBRACKET), EqualTo(ASTTmp.type, JSTokType.LBRACE)) ThenBlock: {
            // Pop the kw_type pushed on line 475 — destructuring path doesn't use it
            AST__Pop()

            // Destructuring: parse pattern, store in N_RIGHT
            AST__Push(ASTTmp.node)
            AST__Push(ASTTmp.op)
            AST__Push(ASTTmp.done)

            ASTTmp.right = JSParse__ParseBindTarget()

            ASTTmp.done = AST__Pop()
            ASTTmp.op = AST__Pop()
            ASTTmp.node = AST__Pop()

            JSParse__NodeSet(ASTTmp.node, ASTConst.N_RIGHT, ASTTmp.right)

            // In for-loop context (skip_semi=1), allow omitting = when next is 'in' or 'of'
            dstr_has_init = 1
            IfCondition EqualTo(ASTTmp.done, 1) ThenBlock: {
                ASTTmp.type = JSParse__PeekType()
                // Check for 'in' keyword
                IfCondition EqualTo(ASTTmp.type, JSTokType.KW_IN) ThenBlock: {
                    dstr_has_init = 0
                }
                // Check for 'of' (contextual keyword: IDENT "of")
                IfCondition And(EqualTo(ASTTmp.type, JSTokType.IDENT),
                               And(EqualTo(JSLex_GetLen(ASTState.tok_pos), 2),
                                   And(EqualTo(GetByte(JSLex_GetPtr(ASTState.tok_pos), 0), 111),
                                       EqualTo(GetByte(JSLex_GetPtr(ASTState.tok_pos), 1), 102)))) ThenBlock: {
                    dstr_has_init = 0
                }
            }

            IfCondition EqualTo(dstr_has_init, 1) ThenBlock: {
                // Expect = initializer (required for destructuring outside for-in/of)
                JSParse__Expect(JSTokType.ASSIGN)

                AST__Push(ASTTmp.node)
                AST__Push(ASTTmp.op)
                AST__Push(ASTTmp.done)

                ASTTmp.left = JSParse__Assign()

                ASTTmp.done = AST__Pop()
                ASTTmp.op = AST__Pop()
                ASTTmp.node = AST__Pop()

                JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            }
        } ElseBlock: {
            // Regular: identifier name
            // Non-strict: `var let` / `var yield` legal bindings outside reserved contexts
            ASTTmp.type = JSParse__PeekType()
            IfCondition And(EqualTo(ASTTmp.op, JSTokType.KW_VAR), EqualTo(ASTTmp.type, JSTokType.KW_LET)) ThenBlock: {
                ASTTmp.idx = ASTState.tok_pos
                JSParse__Advance()
            } ElseBlock: {
                // M72: yield as BindingIdentifier when not in Yield production
                IfCondition And(EqualTo(ASTTmp.type, JSTokType.KW_YIELD), EqualTo(ASTState.in_yield, 0)) ThenBlock: {
                    ASTTmp.idx = ASTState.tok_pos
                    JSParse__Advance()
                } ElseBlock: {
                    ASTTmp.idx = JSParse__Expect(JSTokType.IDENT)
                }
            }
            ASTTmp.name_ptr = JSLex_GetPtr(ASTTmp.idx)
            ASTTmp.name_len = JSLex_GetLen(ASTTmp.idx)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_PTR, ASTTmp.name_ptr)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, ASTTmp.name_len)

            // Redeclaration check: pop saved kw_type from stack
            ASTTmp.prec = AST__Pop()
            // Inline DeclareBinding: check redeclaration in current scope
            IfCondition GreaterThan(JSValidState.scope_depth, 0) ThenBlock: {
                // Determine kind: prec >= 71 means let/const = lexical
                JSValidTmp.ek = 1
                IfCondition LessThan(ASTTmp.prec, 71) ThenBlock: {
                    JSValidTmp.ek = 0
                }
                // Get current scope index and count — use FixedPool for count
                JSValidTmp.base = Subtract(JSValidState.scope_depth, 1)
                JSValidTmp.i = Dereference(Add(JSValidState.scope_counts, Multiply(JSValidTmp.base, 8)))
                // Search existing names in this scope
                JSValidTmp.addr = Add(JSValidState.scope_names, Multiply(JSValidTmp.base, 1536))
                JSValidTmp.j = 0
                JSValidTmp.match = 0
                WhileLoop And(LessThan(JSValidTmp.j, JSValidTmp.i), EqualTo(JSValidTmp.match, 0)) {
                    JSValidTmp.ep = Dereference(Add(JSValidTmp.addr, Multiply(JSValidTmp.j, 24)))
                    JSValidTmp.el = Dereference(Add(Add(JSValidTmp.addr, Multiply(JSValidTmp.j, 24)), 8))
                    IfCondition EqualTo(JSValidTmp.el, ASTTmp.name_len) ThenBlock: {
                        // Inline string comparison using MemCompare (SSE2, 0=equal)
                        IfCondition EqualTo(MemCompare(ASTTmp.name_ptr, JSValidTmp.ep, ASTTmp.name_len), 0) ThenBlock: {
                            // Found match — check redeclaration rules
                            // lexical binding: always error on duplicate
                            IfCondition EqualTo(JSValidTmp.ek, 1) ThenBlock: {
                                ASTState.error = 1
                                ReturnValue(-1)
                            }
                            // var: error if existing is lexical
                            IfCondition EqualTo(Dereference(Add(Add(JSValidTmp.addr, Multiply(JSValidTmp.j, 24)), 16)), 1) ThenBlock: {
                                ASTState.error = 1
                                ReturnValue(-1)
                            }
                            // var redeclaring var: allowed
                            JSValidTmp.match = 1
                        }
                    }
                    JSValidTmp.j = Add(JSValidTmp.j, 1)
                }
                // No duplicate — add the binding if space available
                IfCondition And(EqualTo(JSValidTmp.match, 0), LessThan(JSValidTmp.i, 64)) ThenBlock: {
                    // Store [ptr, len, kind] at entry index i
                    JSValidTmp.ep = Add(JSValidTmp.addr, Multiply(JSValidTmp.i, 24))
                    StoreValue(JSValidTmp.ep, ASTTmp.name_ptr)
                    StoreValue(Add(JSValidTmp.ep, 8), ASTTmp.name_len)
                    StoreValue(Add(JSValidTmp.ep, 16), JSValidTmp.ek)
                    // Increment count in arena
                    StoreValue(Add(JSValidState.scope_counts, Multiply(JSValidTmp.base, 8)), Add(JSValidTmp.i, 1))
                }
            }

            // Optional initializer
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.ASSIGN) ThenBlock: {
                JSParse__Advance()

                // CLOBBER GUARD: push node, op, skip_semi before Assign
                // NOTE: use Assign, not Expr — Expr consumes comma operator,
                // but var initializer commas separate declarators
                AST__Push(ASTTmp.node)
                AST__Push(ASTTmp.op)
                AST__Push(ASTTmp.done)

                ASTTmp.left = JSParse__Assign()

                // RESTORE
                ASTTmp.done = AST__Pop()
                ASTTmp.op = AST__Pop()
                ASTTmp.node = AST__Pop()

                JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            }
        }

        // Multi-variable: check for COMMA -> chain another declarator
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.COMMA) ThenBlock: {
            JSParse__Advance()

            // CLOBBER GUARD: push node, done before recursive call
            AST__Push(ASTTmp.node)
            AST__Push(ASTTmp.done)

            ASTTmp.left = JSParse__VarDeclSingle(ASTTmp.op, ASTTmp.done)

            // RESTORE
            ASTTmp.done = AST__Pop()
            ASTTmp.node = AST__Pop()

            JSParse__NodeSet(ASTTmp.node, ASTConst.N_NEXT, ASTTmp.left)
            ReturnValue(ASTTmp.node)
        }

        // Consume semicolon unless skip_semi is set (for-loop init)
        // Tolerate missing semicolons (ASI) — same pattern as expression statements
        IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
                JSParse__Advance()
            }
        }

        ReturnValue(ASTTmp.node)
    }
}

Function.JSParse__VarDecl {
    Input: skip_semi: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume var/let/const keyword and save its type
        ASTTmp.op = JSParse__PeekType()
        // Save kw_type to JSValidState.scope_depth+100 trick: use err_msg field
        ASTState.err_msg = ASTTmp.op
        JSParse__Advance()

        // Delegate to VarDeclSingle for the first (and possibly only) declarator
        ReturnValue(JSParse__VarDeclSingle(ASTTmp.op, skip_semi))
    }
}

// ---------------------------------------------------------------------------
// FuncDecl — function IDENT ( params ) block
// CLOBBER FIX: push node, first, last, count before AllocNode for params;
//              push node before JSParse__Block()
// ---------------------------------------------------------------------------
Function.JSParse__FuncDecl {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'function' keyword
        JSParse__Advance()

        ASTTmp.node = JSParse__AllocNode()

        // Check for generator: function* name() { ... }
        is_gen = 0
        IfCondition EqualTo(JSParse__PeekType(), JSTokType.STAR) ThenBlock: {
            JSParse__Advance()
            is_gen = 1
        }
        IfCondition EqualTo(is_gen, 1) ThenBlock: {
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.GEN_FUNC_DECL)
        } ElseBlock: {
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.FUNC_DECL)
        }

        // Function name (required for declarations)
        ASTTmp.idx = JSParse__Expect(JSTokType.IDENT)
        ASTTmp.name_ptr = JSLex_GetPtr(ASTTmp.idx)
        ASTTmp.name_len = JSLex_GetLen(ASTTmp.idx)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_PTR, ASTTmp.name_ptr)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, ASTTmp.name_len)

        // Redeclaration check: function decls are lexical inside block scopes
        IfCondition GreaterThan(JSValidState.scope_depth, 0) ThenBlock: {
            IfCondition EqualTo(JSValidate_DeclareBinding(ASTTmp.name_ptr, ASTTmp.name_len, JSValidConst.KIND_LEXICAL), 0) ThenBlock: {
                ASTState.error = 1
                ReturnValue(-1)
            }
        }

        // M72: Yield production context for params+body
        fd_saved_yield = ASTState.in_yield
        IfCondition EqualTo(is_gen, 1) ThenBlock: {
            ASTState.in_yield = Add(fd_saved_yield, 1)
        } ElseBlock: {
            ASTState.in_yield = 0
        }

        // Parameters
        JSParse__Expect(JSTokType.LPAREN)
        ASTTmp.first = -1
        ASTTmp.last = -1
        ASTTmp.count = 0
        ASTState.params_simple = 1
        ASTState.had_rest = 0

        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.RPAREN) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                // Check for destructuring pattern param: [ or {
                ASTTmp.type = JSParse__PeekType()
                IfCondition Or(EqualTo(ASTTmp.type, JSTokType.LBRACKET), EqualTo(ASTTmp.type, JSTokType.LBRACE)) ThenBlock: {
                    // Parse destructuring pattern as param
                    ASTState.params_simple = 0
                    AST__Push(ASTTmp.node)
                    AST__Push(ASTTmp.first)
                    AST__Push(ASTTmp.last)
                    AST__Push(ASTTmp.count)
                    param = JSParse__ParseBindTarget()
                    ASTTmp.count = AST__Pop()
                    ASTTmp.last = AST__Pop()
                    ASTTmp.first = AST__Pop()
                    ASTTmp.node = AST__Pop()

                    // Check for default: = expr
                    IfCondition EqualTo(JSParse__PeekType(), JSTokType.ASSIGN) ThenBlock: {
                        JSParse__Advance()
                        wrap = JSParse__AllocNode()
                        JSParse__NodeSet(wrap, ASTConst.N_TYPE, ASTType.ASSIGN)
                        JSParse__NodeSet(wrap, ASTConst.N_RIGHT, param)
                        AST__Push(ASTTmp.node)
                        AST__Push(ASTTmp.first)
                        AST__Push(ASTTmp.last)
                        AST__Push(ASTTmp.count)
                        AST__Push(ASTTmp.done)
                        AST__Push(wrap)
                        def_val3 = JSParse__Assign()
                        wrap = AST__Pop()
                        ASTTmp.done = AST__Pop()
                        ASTTmp.count = AST__Pop()
                        ASTTmp.last = AST__Pop()
                        ASTTmp.first = AST__Pop()
                        ASTTmp.node = AST__Pop()
                        JSParse__NodeSet(wrap, ASTConst.N_LEFT, def_val3)
                        param = wrap
                    }
                } ElseBlock: {
                    // Check for rest parameter: ...ident
                    IfCondition EqualTo(ASTTmp.type, JSTokType.DOT3) ThenBlock: {
                        JSParse__Advance()
                        ASTState.params_simple = 0
                        ASTState.had_rest = 1
                        AST__Push(ASTTmp.node)
                        AST__Push(ASTTmp.first)
                        AST__Push(ASTTmp.last)
                        AST__Push(ASTTmp.count)
                        param = JSParse__AllocNode()
                        ASTTmp.count = AST__Pop()
                        ASTTmp.last = AST__Pop()
                        ASTTmp.first = AST__Pop()
                        ASTTmp.node = AST__Pop()
                        JSParse__NodeSet(param, ASTConst.N_TYPE, ASTType.REST_ELEMENT)
                        ASTTmp.idx = JSParse__Expect(JSTokType.IDENT)
                        // Store rest binding in N_LEFT as IDENT
                        AST__Push(ASTTmp.node)
                        AST__Push(ASTTmp.first)
                        AST__Push(ASTTmp.last)
                        AST__Push(ASTTmp.count)
                        AST__Push(param)
                        rest_id = JSParse__AllocNode()
                        param = AST__Pop()
                        ASTTmp.count = AST__Pop()
                        ASTTmp.last = AST__Pop()
                        ASTTmp.first = AST__Pop()
                        ASTTmp.node = AST__Pop()
                        JSParse__NodeSet(rest_id, ASTConst.N_TYPE, ASTType.IDENT)
                        JSParse__NodeSet(rest_id, ASTConst.N_NAME_PTR, JSLex_GetPtr(ASTTmp.idx))
                        JSParse__NodeSet(rest_id, ASTConst.N_NAME_LEN, JSLex_GetLen(ASTTmp.idx))
                        JSParse__NodeSet(param, ASTConst.N_LEFT, rest_id)
                    } ElseBlock: {
                        // Regular: identifier
                        ASTTmp.idx = JSParse__Expect(JSTokType.IDENT)

                        AST__Push(ASTTmp.node)
                        AST__Push(ASTTmp.first)
                        AST__Push(ASTTmp.last)
                        AST__Push(ASTTmp.count)

                        param = JSParse__AllocNode()

                        ASTTmp.count = AST__Pop()
                        ASTTmp.last = AST__Pop()
                        ASTTmp.first = AST__Pop()
                        ASTTmp.node = AST__Pop()

                        JSParse__NodeSet(param, ASTConst.N_TYPE, ASTType.IDENT)
                        ASTTmp.name_ptr = JSLex_GetPtr(ASTTmp.idx)
                        ASTTmp.name_len = JSLex_GetLen(ASTTmp.idx)
                        JSParse__NodeSet(param, ASTConst.N_NAME_PTR, ASTTmp.name_ptr)
                        JSParse__NodeSet(param, ASTConst.N_NAME_LEN, ASTTmp.name_len)

                        // Default parameter: check for = expr
                        ASTTmp.type = JSParse__PeekType()
                        IfCondition EqualTo(ASTTmp.type, JSTokType.ASSIGN) ThenBlock: {
                            JSParse__Advance()
                            ASTState.params_simple = 0
                            JSParse__NodeSet(param, ASTConst.N_TYPE, ASTType.ASSIGN)
                            AST__Push(ASTTmp.node)
                            AST__Push(ASTTmp.first)
                            AST__Push(ASTTmp.last)
                            AST__Push(ASTTmp.count)
                            AST__Push(ASTTmp.done)
                            AST__Push(param)
                            ASTTmp.left = JSParse__Assign()
                            param = AST__Pop()
                            ASTTmp.done = AST__Pop()
                            ASTTmp.count = AST__Pop()
                            ASTTmp.last = AST__Pop()
                            ASTTmp.first = AST__Pop()
                            ASTTmp.node = AST__Pop()
                            JSParse__NodeSet(param, ASTConst.N_LEFT, ASTTmp.left)
                        }
                    }
                }

                ASTTmp.count = Add(ASTTmp.count, 1)

                IfCondition EqualTo(ASTTmp.first, -1) ThenBlock: {
                    ASTTmp.first = param
                    ASTTmp.last = param
                } ElseBlock: {
                    JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, param)
                    ASTTmp.last = param
                }

                ASTTmp.type = JSParse__PeekType()
                IfCondition EqualTo(ASTTmp.type, JSTokType.COMMA) ThenBlock: {
                    // Trailing comma after rest parameter is a syntax error
                    IfCondition EqualTo(ASTState.had_rest, 1) ThenBlock: {
                        ASTState.error = 1
                        ReturnValue(-1)
                    }
                    JSParse__Advance()
                }
            }
        }

        JSParse__Expect(JSTokType.RPAREN)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.first)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_VALUE, ASTTmp.count)

        // Save params_simple and param list head before body parse
        fd_params_simple = ASTState.params_simple
        fd_param_first = ASTTmp.first

        // CLOBBER GUARD: push node before Block parse
        AST__Push(ASTTmp.node)
        AST__Push(fd_saved_yield)

        // Body
        ASTTmp.body = JSParse__Block()

        // RESTORE
        fd_saved_yield = AST__Pop()
        ASTTmp.node = AST__Pop()
        ASTState.in_yield = fd_saved_yield

        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.body)

        // Early error: "use strict" in body checks
        IfCondition EqualTo(JSValidate_BodyHasUseStrict(ASTTmp.body), 1) ThenBlock: {
            // Non-simple params + "use strict" is a syntax error
            IfCondition EqualTo(fd_params_simple, 0) ThenBlock: {
                ASTState.error = 1
                ReturnValue(-1)
            }
            // Duplicate params in strict mode is a syntax error
            IfCondition EqualTo(JSValidate_CheckDupParams(fd_param_first), 1) ThenBlock: {
                ASTState.error = 1
                ReturnValue(-1)
            }
        }

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// AsyncFuncDecl — async function IDENT ( params ) block
// Reuses FuncDecl machinery, sets ASYNC_FUNC_DECL type
// ---------------------------------------------------------------------------
Function.JSParse__AsyncFuncDecl {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'async'
        JSParse__Advance()

        // If next is not 'function', treat as expression statement (async arrow etc)
        IfCondition NotEqual(JSParse__PeekType(), JSTokType.KW_FUNCTION) ThenBlock: {
            // async arrow: parse as expression statement
            ASTTmp.node = JSParse__AsyncExpr()
            // Wrap in EXPR_STMT
            es = JSParse__AllocNode()
            JSParse__NodeSet(es, ASTConst.N_TYPE, ASTType.EXPR_STMT)
            JSParse__NodeSet(es, ASTConst.N_LEFT, ASTTmp.node)
            // Consume optional semicolon
            IfCondition EqualTo(JSParse__PeekType(), JSTokType.SEMI) ThenBlock: {
                JSParse__Advance()
            }
            ReturnValue(es)
        }

        // Consume 'function'
        JSParse__Advance()

        ASTTmp.node = JSParse__AllocNode()

        // Check for async generator: async function* name() { ... }
        is_gen = 0
        IfCondition EqualTo(JSParse__PeekType(), JSTokType.STAR) ThenBlock: {
            JSParse__Advance()
            is_gen = 1
        }
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.ASYNC_FUNC_DECL)
        // Store generator flag in N_OP (0=async, 1=async generator)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, is_gen)

        // Function name (required for declarations)
        ASTTmp.idx = JSParse__Expect(JSTokType.IDENT)
        ASTTmp.name_ptr = JSLex_GetPtr(ASTTmp.idx)
        ASTTmp.name_len = JSLex_GetLen(ASTTmp.idx)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_PTR, ASTTmp.name_ptr)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, ASTTmp.name_len)

        // Redeclaration check: async function/generator decls are lexical in block scopes
        IfCondition GreaterThan(JSValidState.scope_depth, 0) ThenBlock: {
            IfCondition EqualTo(JSValidate_DeclareBinding(ASTTmp.name_ptr, ASTTmp.name_len, JSValidConst.KIND_LEXICAL), 0) ThenBlock: {
                ASTState.error = 1
                ReturnValue(-1)
            }
        }

        // Parameters
        JSParse__Expect(JSTokType.LPAREN)
        ASTTmp.first = -1
        ASTTmp.last = -1
        ASTTmp.count = 0
        ASTState.params_simple = 1
        ASTState.had_rest = 0

        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.RPAREN) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                IfCondition GreaterThan(ASTTmp.count, 0) ThenBlock: {
                    // Trailing comma after rest parameter is a syntax error
                    IfCondition EqualTo(ASTState.had_rest, 1) ThenBlock: {
                        ASTState.error = 1
                        ReturnValue(-1)
                    }
                    JSParse__Expect(JSTokType.COMMA)
                    // Trailing comma: if next is RPAREN, break out
                    IfCondition EqualTo(JSParse__PeekType(), JSTokType.RPAREN) ThenBlock: {
                        ASTTmp.done = 1
                    }
                }
            }
            IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                // Check for rest parameter: ...ident
                ASTTmp.type = JSParse__PeekType()
                IfCondition EqualTo(ASTTmp.type, JSTokType.DOT3) ThenBlock: {
                    JSParse__Advance()
                    ASTState.params_simple = 0
                    ASTState.had_rest = 1
                    AST__Push(ASTTmp.node)
                    AST__Push(ASTTmp.first)
                    AST__Push(ASTTmp.last)
                    AST__Push(ASTTmp.count)
                    param = JSParse__AllocNode()
                    ASTTmp.count = AST__Pop()
                    ASTTmp.last = AST__Pop()
                    ASTTmp.first = AST__Pop()
                    ASTTmp.node = AST__Pop()
                    JSParse__NodeSet(param, ASTConst.N_TYPE, ASTType.REST_ELEMENT)
                    AST__Push(ASTTmp.node)
                    AST__Push(ASTTmp.first)
                    AST__Push(ASTTmp.last)
                    AST__Push(ASTTmp.count)
                    AST__Push(param)
                    rest_bind = JSParse__ParseBindTarget()
                    param = AST__Pop()
                    ASTTmp.count = AST__Pop()
                    ASTTmp.last = AST__Pop()
                    ASTTmp.first = AST__Pop()
                    ASTTmp.node = AST__Pop()
                    JSParse__NodeSet(param, ASTConst.N_LEFT, rest_bind)
                } ElseBlock: {
                    // Parse parameter (supports destructuring, rest, defaults)
                    AST__Push(ASTTmp.node)
                    AST__Push(ASTTmp.first)
                    AST__Push(ASTTmp.last)
                    AST__Push(ASTTmp.count)
                    param = JSParse__ParseBindTarget()
                    ASTTmp.count = AST__Pop()
                    ASTTmp.last = AST__Pop()
                    ASTTmp.first = AST__Pop()
                    ASTTmp.node = AST__Pop()

                    // Mark non-simple if pattern param
                    IfCondition NotEqual(JSParse_GetType(param), ASTType.IDENT) ThenBlock: {
                        ASTState.params_simple = 0
                    }

                    // Default parameter: check for = expr
                    IfCondition EqualTo(JSParse__PeekType(), JSTokType.ASSIGN) ThenBlock: {
                        JSParse__Advance()
                        ASTState.params_simple = 0
                        // Wrap IDENT/pattern in ASSIGN node with default value
                        AST__Push(ASTTmp.node)
                        AST__Push(ASTTmp.first)
                        AST__Push(ASTTmp.last)
                        AST__Push(ASTTmp.count)
                        AST__Push(ASTTmp.done)
                        AST__Push(param)
                        def_wrap = JSParse__AllocNode()
                        param = AST__Pop()
                        ASTTmp.done = AST__Pop()
                        ASTTmp.count = AST__Pop()
                        ASTTmp.last = AST__Pop()
                        ASTTmp.first = AST__Pop()
                        ASTTmp.node = AST__Pop()
                        JSParse__NodeSet(def_wrap, ASTConst.N_TYPE, ASTType.ASSIGN)
                        // Store param name info on the ASSIGN wrapper
                        pt2 = JSParse_GetType(param)
                        IfCondition EqualTo(pt2, ASTType.IDENT) ThenBlock: {
                            JSParse__NodeSet(def_wrap, ASTConst.N_NAME_PTR, JSParse_GetNamePtr(param))
                            JSParse__NodeSet(def_wrap, ASTConst.N_NAME_LEN, JSParse_GetNameLen(param))
                        }
                        JSParse__NodeSet(def_wrap, ASTConst.N_RIGHT, param)
                        // Parse default value expression
                        AST__Push(ASTTmp.node)
                        AST__Push(ASTTmp.first)
                        AST__Push(ASTTmp.last)
                        AST__Push(ASTTmp.count)
                        AST__Push(ASTTmp.done)
                        AST__Push(def_wrap)
                        def_val_a = JSParse__Assign()
                        def_wrap = AST__Pop()
                        ASTTmp.done = AST__Pop()
                        ASTTmp.count = AST__Pop()
                        ASTTmp.last = AST__Pop()
                        ASTTmp.first = AST__Pop()
                        ASTTmp.node = AST__Pop()
                        JSParse__NodeSet(def_wrap, ASTConst.N_LEFT, def_val_a)
                        param = def_wrap
                    }
                }
                // Link into param list
                IfCondition LessThan(ASTTmp.first, 0) ThenBlock: {
                    ASTTmp.first = param
                    ASTTmp.last = param
                } ElseBlock: {
                    JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, param)
                    ASTTmp.last = param
                }
                ASTTmp.count = Add(ASTTmp.count, 1)
            }
        }
        JSParse__Expect(JSTokType.RPAREN)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.first)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_RIGHT, ASTTmp.count)

        // Save params_simple before body parse
        afd_params_simple = ASTState.params_simple

        // Body
        AST__Push(ASTTmp.node)
        ASTTmp.body = JSParse__Block()
        ASTTmp.node = AST__Pop()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.body)

        // Early error: non-simple params + "use strict" directive
        IfCondition EqualTo(afd_params_simple, 0) ThenBlock: {
            IfCondition EqualTo(JSValidate_BodyHasUseStrict(ASTTmp.body), 1) ThenBlock: {
                ASTState.error = 1
                ReturnValue(-1)
            }
        }

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// AsyncExpr — async function expression or async arrow function
// Called when 'async' already peeked in expression context
// ---------------------------------------------------------------------------
Function.JSParse__AsyncExpr {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // 'async' was already consumed by caller? No — we need to consume it
        // Check: if next is 'function', parse async function expression
        // If next is IDENT or LPAREN, parse async arrow
        next_type = JSParse__PeekType()

        IfCondition EqualTo(next_type, JSTokType.KW_FUNCTION) ThenBlock: {
            // async function expression (may be async generator: async function* ...)
            JSParse__Advance()
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.ASYNC_FUNC_EXPR)

            // Check for async generator: async function* (...)
            ae_is_gen = 0
            IfCondition EqualTo(JSParse__PeekType(), JSTokType.STAR) ThenBlock: {
                JSParse__Advance()
                ae_is_gen = 1
            }
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, ae_is_gen)

            // Optional name
            IfCondition EqualTo(JSParse__PeekType(), JSTokType.IDENT) ThenBlock: {
                ASTTmp.idx = JSParse__Advance()
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_PTR, JSLex_GetPtr(ASTTmp.idx))
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, JSLex_GetLen(ASTTmp.idx))
            }

            // Parameters
            JSParse__Expect(JSTokType.LPAREN)
            ASTTmp.first = -1
            ASTTmp.last = -1
            ASTTmp.count = 0
            ASTTmp.done = 0
            WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
                ASTTmp.type = JSParse__PeekType()
                IfCondition EqualTo(ASTTmp.type, JSTokType.RPAREN) ThenBlock: { ASTTmp.done = 1 }
                IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: { ASTTmp.done = 1 }
                IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                    IfCondition GreaterThan(ASTTmp.count, 0) ThenBlock: {
                        JSParse__Expect(JSTokType.COMMA)
                    }
                    AST__Push(ASTTmp.node)
                    AST__Push(ASTTmp.first)
                    AST__Push(ASTTmp.last)
                    AST__Push(ASTTmp.count)
                    param = JSParse__ParseBindTarget()
                    ASTTmp.count = AST__Pop()
                    ASTTmp.last = AST__Pop()
                    ASTTmp.first = AST__Pop()
                    ASTTmp.node = AST__Pop()
                    IfCondition LessThan(ASTTmp.first, 0) ThenBlock: {
                        ASTTmp.first = param
                        ASTTmp.last = param
                    } ElseBlock: {
                        JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, param)
                        ASTTmp.last = param
                    }
                    ASTTmp.count = Add(ASTTmp.count, 1)
                }
            }
            JSParse__Expect(JSTokType.RPAREN)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.first)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_RIGHT, ASTTmp.count)

            // Body
            AST__Push(ASTTmp.node)
            ASTTmp.body = JSParse__Block()
            ASTTmp.node = AST__Pop()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.body)
            ReturnValue(ASTTmp.node)
        }

        // async arrow: async (params) => body  OR  async ident => body
        // Parse as arrow function but mark as ASYNC_FUNC_EXPR
        IfCondition EqualTo(next_type, JSTokType.LPAREN) ThenBlock: {
            // async (...) => body — reuse ArrowFunc logic
            ASTTmp.node = JSParse__ArrowFunc()
            // Convert ARROW_EXPR to ASYNC_FUNC_EXPR
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.ASYNC_FUNC_EXPR)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, 0)
            ReturnValue(ASTTmp.node)
        }

        IfCondition EqualTo(next_type, JSTokType.IDENT) ThenBlock: {
            // async x => body — single param async arrow
            ASTTmp.node = JSParse__ArrowFunc()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.ASYNC_FUNC_EXPR)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, 0)
            ReturnValue(ASTTmp.node)
        }

        // Fallback: treat 'async' as identifier
        prev_idx = Subtract(ASTState.tok_pos, 1)
        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.IDENT)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_PTR, JSLex_GetPtr(prev_idx))
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, JSLex_GetLen(prev_idx))
        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// ReturnStmt — return [expr] ;
// CLOBBER FIX: push node before JSParse__Expr()
// ---------------------------------------------------------------------------
Function.JSParse__ReturnStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'return'
        JSParse__Advance()

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.RETURN_STMT)

        // Check if there's an expression before SEMI or RBRACE
        ASTTmp.type = JSParse__PeekType()
        IfCondition And(NotEqual(ASTTmp.type, JSTokType.SEMI), NotEqual(ASTTmp.type, JSTokType.RBRACE)) ThenBlock: {
            IfCondition NotEqual(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                // CLOBBER GUARD: push node before Expr
                AST__Push(ASTTmp.node)

                ASTTmp.left = JSParse__Expr()

                // RESTORE
                ASTTmp.node = AST__Pop()

                JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            }
        }

        // Consume semicolon (optional — tolerate missing for robustness)
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
            JSParse__Advance()
        }

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// CheckNotDecl — error if next token starts a declaration (const/let/class)
// JS spec: Statement context (if/while/for/do body) forbids declarations.
// Does NOT touch ASTTmp fields — safe to call anywhere.
// Returns 1 if declaration detected (and sets error), 0 otherwise.
// ---------------------------------------------------------------------------
Function.JSParse__CheckNotDecl {
    Output: Integer
    Body: {
        peek_t = JSParse__PeekType()
        // const — always a declaration
        IfCondition EqualTo(peek_t, JSTokType.KW_CONST) ThenBlock: {
            ASTState.error = 1
            ReturnValue(1)
        }
        // let — declaration if followed by IDENT, LBRACKET, or same-line LBRACE
        // (let + LineTerminator + `{` is expr + block, not a declaration)
        IfCondition EqualTo(peek_t, JSTokType.KW_LET) ThenBlock: {
            next_pos2 = Add(ASTState.tok_pos, 1)
            IfCondition LessThan(next_pos2, ASTState.tok_total) ThenBlock: {
                next_t2 = JSLex_GetType(next_pos2)
                IfCondition EqualTo(next_t2, JSTokType.LBRACKET) ThenBlock: {
                    ASTState.error = 1
                    ReturnValue(1)
                }
                IfCondition EqualTo(next_t2, JSTokType.IDENT) ThenBlock: {
                    // Same line: `let x` declaration. Newline: ASI → expr `let`
                    IfCondition EqualTo(JSLex_GetLine(ASTState.tok_pos), JSLex_GetLine(next_pos2)) ThenBlock: {
                        ASTState.error = 1
                        ReturnValue(1)
                    }
                }
                IfCondition EqualTo(next_t2, JSTokType.LBRACE) ThenBlock: {
                    IfCondition EqualTo(JSLex_GetLine(ASTState.tok_pos), JSLex_GetLine(next_pos2)) ThenBlock: {
                        ASTState.error = 1
                        ReturnValue(1)
                    }
                }
            }
        }
        // class — keyword token, always a declaration in stmt position
        IfCondition EqualTo(peek_t, JSTokType.KW_CLASS) ThenBlock: {
            ASTState.error = 1
            ReturnValue(1)
        }
        // async function — KW_ASYNC followed by KW_FUNCTION (with or without *)
        IfCondition EqualTo(peek_t, JSTokType.KW_ASYNC) ThenBlock: {
            next_pos3 = Add(ASTState.tok_pos, 1)
            IfCondition LessThan(next_pos3, ASTState.tok_total) ThenBlock: {
                next_t3 = JSLex_GetType(next_pos3)
                IfCondition EqualTo(next_t3, JSTokType.KW_FUNCTION) ThenBlock: {
                    ASTState.error = 1
                    ReturnValue(1)
                }
            }
        }
        // function* (generator) — KW_FUNCTION followed by STAR
        IfCondition EqualTo(peek_t, JSTokType.KW_FUNCTION) ThenBlock: {
            next_pos4 = Add(ASTState.tok_pos, 1)
            IfCondition LessThan(next_pos4, ASTState.tok_total) ThenBlock: {
                next_t4 = JSLex_GetType(next_pos4)
                IfCondition EqualTo(next_t4, JSTokType.STAR) ThenBlock: {
                    ASTState.error = 1
                    ReturnValue(1)
                }
            }
        }
        ReturnValue(0)
    }
}

// ---------------------------------------------------------------------------
// IfStmt — if ( cond ) body [else body]
// CLOBBER FIX: push node before Expr (cond), Statement (body), Statement (else)
// ---------------------------------------------------------------------------
Function.JSParse__IfStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'if'
        JSParse__Advance()

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.IF_STMT)

        // Condition
        JSParse__Expect(JSTokType.LPAREN)

        // CLOBBER GUARD: push node before Expr (condition)
        AST__Push(ASTTmp.node)

        ASTTmp.cond = JSParse__Expr()

        // RESTORE
        ASTTmp.node = AST__Pop()

        JSParse__Expect(JSTokType.RPAREN)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_COND, ASTTmp.cond)

        // Reject declarations in if-body (const/let)
        JSParse__CheckNotDecl()
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // CLOBBER GUARD: push node before Statement (consequent body)
        AST__Push(ASTTmp.node)

        // Consequent body
        ASTTmp.body = JSParse__Statement()

        // RESTORE
        ASTTmp.node = AST__Pop()

        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.body)

        // Optional else
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_ELSE) ThenBlock: {
            JSParse__Advance()

            // Reject declarations in else-body
            JSParse__CheckNotDecl()
            IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

            // CLOBBER GUARD: push node before Statement (else body)
            AST__Push(ASTTmp.node)

            ASTTmp.right = JSParse__Statement()

            // RESTORE
            ASTTmp.node = AST__Pop()

            JSParse__NodeSet(ASTTmp.node, ASTConst.N_RIGHT, ASTTmp.right)
        }

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// WhileStmt — while ( cond ) body
// CLOBBER FIX: push node before Expr (cond) and Statement (body)
// ---------------------------------------------------------------------------
Function.JSParse__WhileStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'while'
        JSParse__Advance()

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.WHILE_STMT)

        JSParse__Expect(JSTokType.LPAREN)

        // CLOBBER GUARD: push node before Expr (condition)
        AST__Push(ASTTmp.node)

        ASTTmp.cond = JSParse__Expr()

        // RESTORE
        ASTTmp.node = AST__Pop()

        JSParse__Expect(JSTokType.RPAREN)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_COND, ASTTmp.cond)

        // Reject declarations in while-body
        JSParse__CheckNotDecl()
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // CLOBBER GUARD: push node before Statement (body)
        AST__Push(ASTTmp.node)

        ASTTmp.body = JSParse__Statement()

        // RESTORE
        ASTTmp.node = AST__Pop()

        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.body)

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// ForStmt — for ( init ; cond ; update ) body
// init can be: var/let/const decl, expression, or empty (bare ;)
// CLOBBER FIX: push node before each VarDecl/Expr/Statement call
// ---------------------------------------------------------------------------
Function.JSParse__ForStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'for'
        JSParse__Advance()

        // Check for 'for await (' — skip the 'await' keyword
        // for-await-of compiles the same as for-of in eager mode
        IfCondition EqualTo(JSParse__PeekType(), JSTokType.KW_AWAIT) ThenBlock: {
            JSParse__Advance()
        }

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.FOR_STMT)

        JSParse__Expect(JSTokType.LPAREN)

        // --- INIT clause ---
        ASTTmp.type = JSParse__PeekType()
        for_is_in = 0
        for_lex_scope = 0

        // Empty init: bare semicolon
        IfCondition EqualTo(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
            JSParse__Advance()
            // left stays -1 (already initialized by AllocNode)
        }

        // Var decl init: var/let/const
        // M65: let/const ForDeclaration lives in its own validation scope
        // so outer `let x` + `for (let x of …)` is not a redeclaration error.
        IfCondition Or(EqualTo(ASTTmp.type, JSTokType.KW_VAR),
                      Or(EqualTo(ASTTmp.type, JSTokType.KW_LET), EqualTo(ASTTmp.type, JSTokType.KW_CONST))) ThenBlock: {
            IfCondition Or(EqualTo(ASTTmp.type, JSTokType.KW_LET), EqualTo(ASTTmp.type, JSTokType.KW_CONST)) ThenBlock: {
                StoreValue(Add(JSValidState.scope_counts, Multiply(JSValidState.scope_depth, 8)), 0)
                JSValidState.scope_depth = Add(JSValidState.scope_depth, 1)
                for_lex_scope = 1
            }
            // CLOBBER GUARD: push node before VarDecl
            AST__Push(ASTTmp.node)
            AST__Push(for_lex_scope)

            // Suppress 'in' as binary operator so for(var x in obj) works
            ASTState.no_in = 1
            // Parse var decl without trailing semi (skip_semi=1)
            ASTTmp.left = JSParse__VarDecl(1)
            ASTState.no_in = 0

            // RESTORE
            for_lex_scope = AST__Pop()
            ASTTmp.node = AST__Pop()

            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)

            // Check for 'in' keyword → for-in, or 'of' identifier → for-of
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.KW_IN) ThenBlock: {
                JSParse__Advance()
                for_is_in = 1
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.FOR_IN_STMT)
                // Parse RHS object expression (Expr to allow comma operator)
                AST__Push(ASTTmp.node)
                ASTTmp.cond = JSParse__Expr()
                ASTTmp.node = AST__Pop()
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_COND, ASTTmp.cond)
            } ElseBlock: {
                // Check for 'of' (contextual keyword: IDENT with text "of")
                IfCondition And(EqualTo(ASTTmp.type, JSTokType.IDENT),
                               And(EqualTo(JSLex_GetLen(ASTState.tok_pos), 2),
                                   And(EqualTo(GetByte(JSLex_GetPtr(ASTState.tok_pos), 0), 111),
                                       EqualTo(GetByte(JSLex_GetPtr(ASTState.tok_pos), 1), 102)))) ThenBlock: {
                    JSParse__Advance()
                    for_is_in = 1
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.FOR_OF_STMT)
                    AST__Push(ASTTmp.node)
                    ASTTmp.cond = JSParse__Expr()
                    ASTTmp.node = AST__Pop()
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_COND, ASTTmp.cond)
                } ElseBlock: {
                    JSParse__Expect(JSTokType.SEMI)
                }
            }
        }

        // Expression init: anything else (not SEMI and not var/let/const)
        IfCondition And(EqualTo(for_is_in, 0), And(NotEqual(ASTTmp.type, JSTokType.SEMI),
                       And(NotEqual(ASTTmp.type, JSTokType.KW_VAR),
                           And(NotEqual(ASTTmp.type, JSTokType.KW_LET), NotEqual(ASTTmp.type, JSTokType.KW_CONST))))) ThenBlock: {
            // CLOBBER GUARD: push node before Expr
            AST__Push(ASTTmp.node)

            // Suppress 'in' as binary operator so for(x in obj) works
            ASTState.no_in = 1
            ASTTmp.left = JSParse__Expr()
            ASTState.no_in = 0

            // RESTORE
            ASTTmp.node = AST__Pop()

            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)

            // Check for 'in' keyword → for-in, or 'of' identifier → for-of
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.KW_IN) ThenBlock: {
                // Cover grammar: convert ARRAY_LIT/OBJECT_LIT LHS to pattern
                forei_lhs_type = JSParse_GetType(ASTTmp.left)
                IfCondition Or(EqualTo(forei_lhs_type, ASTType.ARRAY_LIT),
                              EqualTo(forei_lhs_type, ASTType.OBJECT_LIT)) ThenBlock: {
                    JSParse__CoverToPattern(ASTTmp.left)
                }
                JSParse__Advance()
                for_is_in = 1
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.FOR_IN_STMT)
                AST__Push(ASTTmp.node)
                ASTTmp.cond = JSParse__Expr()
                ASTTmp.node = AST__Pop()
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_COND, ASTTmp.cond)
            } ElseBlock: {
                // Check for 'of' (contextual keyword: IDENT with text "of")
                IfCondition And(EqualTo(ASTTmp.type, JSTokType.IDENT),
                               And(EqualTo(JSLex_GetLen(ASTState.tok_pos), 2),
                                   And(EqualTo(GetByte(JSLex_GetPtr(ASTState.tok_pos), 0), 111),
                                       EqualTo(GetByte(JSLex_GetPtr(ASTState.tok_pos), 1), 102)))) ThenBlock: {
                    // Cover grammar: convert ARRAY_LIT/OBJECT_LIT LHS to pattern
                    forei_lhs_type2 = JSParse_GetType(ASTTmp.left)
                    IfCondition Or(EqualTo(forei_lhs_type2, ASTType.ARRAY_LIT),
                                  EqualTo(forei_lhs_type2, ASTType.OBJECT_LIT)) ThenBlock: {
                        JSParse__CoverToPattern(ASTTmp.left)
                    }
                    JSParse__Advance()
                    for_is_in = 1
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.FOR_OF_STMT)
                    AST__Push(ASTTmp.node)
                    ASTTmp.cond = JSParse__Expr()
                    ASTTmp.node = AST__Pop()
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_COND, ASTTmp.cond)
                } ElseBlock: {
                    JSParse__Expect(JSTokType.SEMI)
                }
            }
        }

        // --- If for-in, skip condition and update, go straight to RPAREN + body ---
        IfCondition EqualTo(for_is_in, 1) ThenBlock: {
            JSParse__Expect(JSTokType.RPAREN)
            // Reject declarations in for-in body
            JSParse__CheckNotDecl()
            IfCondition EqualTo(ASTState.error, 1) ThenBlock: {
                IfCondition EqualTo(for_lex_scope, 1) ThenBlock: {
                    JSValidState.scope_depth = Subtract(JSValidState.scope_depth, 1)
                    StoreValue(Add(JSValidState.scope_counts, Multiply(JSValidState.scope_depth, 8)), 0)
                }
                ReturnValue(-1)
            }
            AST__Push(ASTTmp.node)
            AST__Push(for_lex_scope)
            ASTTmp.body = JSParse__Statement()
            for_lex_scope = AST__Pop()
            ASTTmp.node = AST__Pop()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.body)
            IfCondition EqualTo(for_lex_scope, 1) ThenBlock: {
                JSValidState.scope_depth = Subtract(JSValidState.scope_depth, 1)
                StoreValue(Add(JSValidState.scope_counts, Multiply(JSValidState.scope_depth, 8)), 0)
            }
            ReturnValue(ASTTmp.node)
        }

        // --- CONDITION clause ---
        ASTTmp.type = JSParse__PeekType()
        IfCondition NotEqual(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
            // CLOBBER GUARD: push node before Expr (condition)
            AST__Push(ASTTmp.node)

            ASTTmp.cond = JSParse__Expr()

            // RESTORE
            ASTTmp.node = AST__Pop()

            JSParse__NodeSet(ASTTmp.node, ASTConst.N_COND, ASTTmp.cond)
        }
        JSParse__Expect(JSTokType.SEMI)

        // --- UPDATE clause ---
        ASTTmp.type = JSParse__PeekType()
        IfCondition NotEqual(ASTTmp.type, JSTokType.RPAREN) ThenBlock: {
            // CLOBBER GUARD: push node before Expr (update)
            AST__Push(ASTTmp.node)

            ASTTmp.right = JSParse__Expr()

            // RESTORE
            ASTTmp.node = AST__Pop()

            JSParse__NodeSet(ASTTmp.node, ASTConst.N_RIGHT, ASTTmp.right)
        }
        JSParse__Expect(JSTokType.RPAREN)

        // Reject declarations in for-body
        JSParse__CheckNotDecl()
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: {
            IfCondition EqualTo(for_lex_scope, 1) ThenBlock: {
                JSValidState.scope_depth = Subtract(JSValidState.scope_depth, 1)
                StoreValue(Add(JSValidState.scope_counts, Multiply(JSValidState.scope_depth, 8)), 0)
            }
            ReturnValue(-1)
        }

        // --- BODY ---
        // CLOBBER GUARD: push node before Statement (body)
        AST__Push(ASTTmp.node)
        AST__Push(for_lex_scope)

        ASTTmp.body = JSParse__Statement()

        // RESTORE
        for_lex_scope = AST__Pop()
        ASTTmp.node = AST__Pop()

        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.body)

        IfCondition EqualTo(for_lex_scope, 1) ThenBlock: {
            JSValidState.scope_depth = Subtract(JSValidState.scope_depth, 1)
            StoreValue(Add(JSValidState.scope_counts, Multiply(JSValidState.scope_depth, 8)), 0)
        }
        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// DoWhile — do body while ( cond ) ;
// CLOBBER FIX: push node before Statement (body) and Expr (cond)
// ---------------------------------------------------------------------------
Function.JSParse__DoWhile {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'do'
        JSParse__Advance()

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.DO_WHILE)

        // Reject declarations in do-body
        JSParse__CheckNotDecl()
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // CLOBBER GUARD: push node before Statement (body)
        AST__Push(ASTTmp.node)

        // Body
        ASTTmp.body = JSParse__Statement()

        // RESTORE
        ASTTmp.node = AST__Pop()

        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.body)

        // Expect 'while'
        JSParse__Expect(JSTokType.KW_WHILE)

        // Condition
        JSParse__Expect(JSTokType.LPAREN)

        // CLOBBER GUARD: push node before Expr (condition)
        AST__Push(ASTTmp.node)

        ASTTmp.cond = JSParse__Expr()

        // RESTORE
        ASTTmp.node = AST__Pop()

        JSParse__Expect(JSTokType.RPAREN)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_COND, ASTTmp.cond)

        // Semicolon (tolerate missing — ASI)
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
            JSParse__Advance()
        }

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// SwitchStmt — switch ( expr ) { case/default clauses }
// CLOBBER FIX: push node, first, last before Expr and CaseClause calls
// ---------------------------------------------------------------------------
Function.JSParse__SwitchStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'switch'
        JSParse__Advance()

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.SWITCH_STMT)

        // Discriminant
        JSParse__Expect(JSTokType.LPAREN)

        // CLOBBER GUARD: push node before Expr (discriminant)
        AST__Push(ASTTmp.node)

        ASTTmp.left = JSParse__Expr()

        // RESTORE
        ASTTmp.node = AST__Pop()

        JSParse__Expect(JSTokType.RPAREN)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)

        // Case clauses — switch body is a single scope for let/const
        JSParse__Expect(JSTokType.LBRACE)
        // Inline PushScope: zero count for new level, then increment depth
        StoreValue(Add(JSValidState.scope_counts, Multiply(JSValidState.scope_depth, 8)), 0)
        JSValidState.scope_depth = Add(JSValidState.scope_depth, 1)
        ASTTmp.first = -1
        ASTTmp.last = -1

        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.RBRACE) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                // CLOBBER GUARD: push node, first, last, done before CaseClause
                AST__Push(ASTTmp.node)
                AST__Push(ASTTmp.first)
                AST__Push(ASTTmp.last)
                AST__Push(ASTTmp.done)

                clause = JSParse__CaseClause()

                // RESTORE
                ASTTmp.done = AST__Pop()
                ASTTmp.last = AST__Pop()
                ASTTmp.first = AST__Pop()
                ASTTmp.node = AST__Pop()

                IfCondition EqualTo(ASTTmp.first, -1) ThenBlock: {
                    ASTTmp.first = clause
                    ASTTmp.last = clause
                } ElseBlock: {
                    JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, clause)
                    ASTTmp.last = clause
                }
            }
        }

        JSParse__Expect(JSTokType.RBRACE)
        // Inline PopScope: decrement depth, zero count for popped level
        JSValidState.scope_depth = Subtract(JSValidState.scope_depth, 1)
        StoreValue(Add(JSValidState.scope_counts, Multiply(JSValidState.scope_depth, 8)), 0)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.first)

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// CaseClause — case expr : stmts  |  default : stmts
// Statements run until next case/default/}
// CLOBBER FIX: push node, first, last before Expr and Statement calls
// ---------------------------------------------------------------------------
Function.JSParse__CaseClause {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.CASE_CLAUSE)

        ASTTmp.type = JSParse__PeekType()

        // --- case expr : ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_CASE) ThenBlock: {
            JSParse__Advance()

            // CLOBBER GUARD: push node before Expr (case test)
            AST__Push(ASTTmp.node)

            ASTTmp.left = JSParse__Expr()

            // RESTORE
            ASTTmp.node = AST__Pop()

            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            JSParse__Expect(JSTokType.COLON)
        } ElseBlock: {
            // --- default : ---
            IfCondition EqualTo(ASTTmp.type, JSTokType.KW_DEFAULT) ThenBlock: {
                JSParse__Advance()
                // left stays -1 (signals default clause)
                JSParse__Expect(JSTokType.COLON)
            } ElseBlock: {
                // Neither case nor default — error
                ASTState.error = 1
                ReturnValue(-1)
            }
        }

        // Parse body statements until case/default/}
        ASTTmp.first = -1
        ASTTmp.last = -1
        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.KW_CASE) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.KW_DEFAULT) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.RBRACE) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                // CLOBBER GUARD: push node, first, last, done before Statement
                AST__Push(ASTTmp.node)
                AST__Push(ASTTmp.first)
                AST__Push(ASTTmp.last)
                AST__Push(ASTTmp.done)

                stmt = JSParse__Statement()

                // RESTORE
                ASTTmp.done = AST__Pop()
                ASTTmp.last = AST__Pop()
                ASTTmp.first = AST__Pop()
                ASTTmp.node = AST__Pop()

                IfCondition EqualTo(ASTTmp.first, -1) ThenBlock: {
                    ASTTmp.first = stmt
                    ASTTmp.last = stmt
                } ElseBlock: {
                    JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, stmt)
                    ASTTmp.last = stmt
                }
            }
        }

        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.first)
        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// BreakStmt — break [label] ;
// M53: optional label stored on N_NAME_PTR / N_NAME_LEN
// ---------------------------------------------------------------------------
Function.JSParse__BreakStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }
        JSParse__Advance()
        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.BREAK_STMT)
        // Optional label identifier
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.IDENT) ThenBlock: {
            ASTTmp.idx = ASTState.tok_pos
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_PTR, JSLex_GetPtr(ASTTmp.idx))
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, JSLex_GetLen(ASTTmp.idx))
            JSParse__Advance()
        }
        // Consume optional semicolon
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
            JSParse__Advance()
        }
        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// ContStmt — continue [label] ;
// M53: optional label stored on N_NAME_PTR / N_NAME_LEN
// ---------------------------------------------------------------------------
Function.JSParse__ContStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }
        JSParse__Advance()
        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.CONTINUE_STMT)
        // Optional label identifier
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.IDENT) ThenBlock: {
            ASTTmp.idx = ASTState.tok_pos
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_PTR, JSLex_GetPtr(ASTTmp.idx))
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, JSLex_GetLen(ASTTmp.idx))
            JSParse__Advance()
        }
        // Consume optional semicolon
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
            JSParse__Advance()
        }
        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// ThrowStmt — throw expr ;
// ---------------------------------------------------------------------------
Function.JSParse__ThrowStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }
        JSParse__Advance()
        expr = JSParse__Expr()
        // Save expr across AllocNode (clobber protection)
        AST__Push(expr)
        ASTTmp.node = JSParse__AllocNode()
        expr = AST__Pop()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.THROW_STMT)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, expr)
        // Consume optional semicolon
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
            JSParse__Advance()
        }
        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// TryStmt — try { body } catch (ident) { handler } [finally { finbody }]
// ---------------------------------------------------------------------------
Function.JSParse__TryStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }
        // Consume 'try'
        JSParse__Advance()

        // Parse try body block
        try_body = JSParse__Block()

        // Save try_body across AllocNode
        AST__Push(try_body)
        ASTTmp.node = JSParse__AllocNode()
        try_body = AST__Pop()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.TRY_STMT)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, try_body)

        // Parse optional catch clause
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_CATCH) ThenBlock: {
            JSParse__Advance()

            // Check for optional catch binding: catch { ... } vs catch (x) { ... }
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.LPAREN) ThenBlock: {
                AST__Push(ASTTmp.node)
                JSParse__Expect(JSTokType.LPAREN)
                ASTTmp.node = AST__Pop()

                // Check for destructuring pattern in catch binding
                ASTTmp.type = JSParse__PeekType()
                IfCondition Or(EqualTo(ASTTmp.type, JSTokType.LBRACE), EqualTo(ASTTmp.type, JSTokType.LBRACKET)) ThenBlock: {
                    // Destructuring pattern: catch ({a, b}) or catch ([x, y])
                    AST__Push(ASTTmp.node)
                    catch_pat = JSParse__ParseBindTarget()
                    ASTTmp.node = AST__Pop()
                    // Store pattern node in N_COND slot (reusing for destructuring)
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_COND, catch_pat)
                    // Set name len to 0 so compiler knows it's a pattern, not simple binding
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, 0)
                } ElseBlock: {
                    // Simple identifier binding: catch (e)
                    cv_idx = JSParse__Advance()
                    cv_ptr = JSLex_GetPtr(cv_idx)
                    cv_len = JSLex_GetLen(cv_idx)
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_PTR, cv_ptr)
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, cv_len)
                }

                AST__Push(ASTTmp.node)
                JSParse__Expect(JSTokType.RPAREN)
                catch_body = JSParse__Block()
                ASTTmp.node = AST__Pop()
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, catch_body)
            } ElseBlock: {
                // Optional catch binding: catch { ... } (no parameter)
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, 0)
                AST__Push(ASTTmp.node)
                catch_body = JSParse__Block()
                ASTTmp.node = AST__Pop()
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, catch_body)
            }
        }

        // Parse optional finally clause
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_FINALLY) ThenBlock: {
            JSParse__Advance()
            AST__Push(ASTTmp.node)
            fin_body = JSParse__Block()
            ASTTmp.node = AST__Pop()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_RIGHT, fin_body)
        }

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// Class body — parse methods inside { ... }
// Returns first method node index (linked list via N_NEXT)
// Each method is a FUNC_EXPR node. N_VALUE stores flags:
//   bit 0 (1) = static, bit 1 (2) = getter, bit 2 (4) = setter,
//   bit 3 (8) = constructor
// LBRACE already consumed.
// ---------------------------------------------------------------------------
Function.JSParse__ClassBody {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        ASTState.in_class_depth = Add(ASTState.in_class_depth, 1)
        JSValidate_PrivPush()

        ASTTmp.first = -1
        ASTTmp.last = -1
        ASTTmp.done = 0
        cb_ctor_count = 0

        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.RBRACE) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                ASTTmp.done = 1
            }
            // Skip semicolons in class body
            IfCondition EqualTo(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
                JSParse__Advance()
            }
            IfCondition And(EqualTo(ASTTmp.done, 0), NotEqual(ASTTmp.type, JSTokType.SEMI)) ThenBlock: {
                // Parse one class element (method/getter/setter/constructor)
                mflags = 0

                // Check for 'static' keyword
                IfCondition EqualTo(JSParse__PeekType(), JSTokType.KW_STATIC) ThenBlock: {
                    JSParse__Advance()
                    mflags = 1

                    // Static block: static { ... }
                    IfCondition EqualTo(JSParse__PeekType(), JSTokType.LBRACE) ThenBlock: {
                        AST__Push(ASTTmp.first)
                        AST__Push(ASTTmp.last)
                        AST__Push(ASTTmp.done)
                        method = JSParse__AllocNode()
                        ASTTmp.done = AST__Pop()
                        ASTTmp.last = AST__Pop()
                        ASTTmp.first = AST__Pop()
                        JSParse__NodeSet(method, ASTConst.N_TYPE, ASTType.CLASS_FIELD)
                        // mflags = 17: bit 0 = static, bit 4 = static block
                        JSParse__NodeSet(method, ASTConst.N_VALUE, 17)
                        // Parse the block body
                        AST__Push(ASTTmp.first)
                        AST__Push(ASTTmp.last)
                        AST__Push(ASTTmp.done)
                        AST__Push(method)
                        sb_body = JSParse__Block()
                        method = AST__Pop()
                        ASTTmp.done = AST__Pop()
                        ASTTmp.last = AST__Pop()
                        ASTTmp.first = AST__Pop()
                        JSParse__NodeSet(method, ASTConst.N_BODY, sb_body)
                        // Link into class body list
                        IfCondition LessThan(ASTTmp.first, 0) ThenBlock: {
                            ASTTmp.first = method
                            ASTTmp.last = method
                        } ElseBlock: {
                            JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, method)
                            ASTTmp.last = method
                        }
                        mflags = -1
                    }
                }

                IfCondition GreaterEqual(mflags, 0) ThenBlock: {
                // Check for 'async' method prefix
                is_async_m = 0
                IfCondition EqualTo(JSParse__PeekType(), JSTokType.KW_ASYNC) ThenBlock: {
                    // Look ahead: if next-next is LPAREN, "async" is the method name
                    async_next = Add(ASTState.tok_pos, 1)
                    async_next_t = 0
                    IfCondition LessThan(async_next, ASTState.tok_total) ThenBlock: {
                        async_next_t = JSLex_GetType(async_next)
                    }
                    IfCondition NotEqual(async_next_t, JSTokType.LPAREN) ThenBlock: {
                        JSParse__Advance()
                        is_async_m = 1
                    }
                }

                // Check for generator: *
                is_gen_m = 0
                IfCondition EqualTo(JSParse__PeekType(), JSTokType.STAR) ThenBlock: {
                    JSParse__Advance()
                    is_gen_m = 1
                }

                // Check for get/set accessor
                ASTTmp.type = JSParse__PeekType()
                IfCondition EqualTo(ASTTmp.type, JSTokType.IDENT) ThenBlock: {
                    // Peek at name — might be "get", "set", or "constructor"
                    peek_ptr = JSLex_GetPtr(ASTState.tok_pos)
                    peek_len = JSLex_GetLen(ASTState.tok_pos)

                    // Check if next-next token is LPAREN — if so, this IS the method name
                    // If next-next is IDENT/STRING/NUMBER/LBRACKET, this is get/set prefix
                    next2_pos = Add(ASTState.tok_pos, 1)
                    next2_type = 0
                    IfCondition LessThan(next2_pos, ASTState.tok_total) ThenBlock: {
                        next2_type = JSLex_GetType(next2_pos)
                    }

                    // "get" = 103 101 116
                    IfCondition And(EqualTo(peek_len, 3), And(EqualTo(GetByte(peek_ptr, 0), 103), And(EqualTo(GetByte(peek_ptr, 1), 101), EqualTo(GetByte(peek_ptr, 2), 116)))) ThenBlock: {
                        IfCondition NotEqual(next2_type, JSTokType.LPAREN) ThenBlock: {
                            JSParse__Advance()
                            mflags = Add(mflags, 2)
                        }
                    }

                    // "set" = 115 101 116
                    IfCondition And(EqualTo(peek_len, 3), And(EqualTo(GetByte(peek_ptr, 0), 115), And(EqualTo(GetByte(peek_ptr, 1), 101), EqualTo(GetByte(peek_ptr, 2), 116)))) ThenBlock: {
                        IfCondition NotEqual(next2_type, JSTokType.LPAREN) ThenBlock: {
                            JSParse__Advance()
                            mflags = Add(mflags, 4)
                        }
                    }
                }

                // Now parse the method name
                AST__Push(ASTTmp.first)
                AST__Push(ASTTmp.last)
                AST__Push(ASTTmp.done)
                AST__Push(mflags)
                AST__Push(is_gen_m)
                AST__Push(is_async_m)

                method = JSParse__AllocNode()

                is_async_m = AST__Pop()
                is_gen_m = AST__Pop()
                mflags = AST__Pop()
                ASTTmp.done = AST__Pop()
                ASTTmp.last = AST__Pop()
                ASTTmp.first = AST__Pop()

                // Set method type based on async/generator flags
                IfCondition EqualTo(is_async_m, 1) ThenBlock: {
                    // async method — use ASYNC_FUNC_EXPR, store gen flag in N_OP
                    JSParse__NodeSet(method, ASTConst.N_TYPE, ASTType.ASYNC_FUNC_EXPR)
                    JSParse__NodeSet(method, ASTConst.N_OP, is_gen_m)
                } ElseBlock: {
                    IfCondition EqualTo(is_gen_m, 1) ThenBlock: {
                        JSParse__NodeSet(method, ASTConst.N_TYPE, ASTType.GEN_FUNC_EXPR)
                    } ElseBlock: {
                        JSParse__NodeSet(method, ASTConst.N_TYPE, ASTType.FUNC_EXPR)
                    }
                }

                // Get method name
                ASTTmp.type = JSParse__PeekType()

                // Computed method name: [expr]
                IfCondition EqualTo(ASTTmp.type, JSTokType.LBRACKET) ThenBlock: {
                    JSParse__Advance()
                    AST__Push(ASTTmp.first)
                    AST__Push(ASTTmp.last)
                    AST__Push(ASTTmp.done)
                    AST__Push(mflags)
                    AST__Push(method)
                    comp_key = JSParse__Assign()
                    method = AST__Pop()
                    mflags = AST__Pop()
                    ASTTmp.done = AST__Pop()
                    ASTTmp.last = AST__Pop()
                    ASTTmp.first = AST__Pop()
                    // Store computed key in N_COND (name_ptr/name_len used for string names)
                    JSParse__NodeSet(method, ASTConst.N_COND, comp_key)
                    JSParse__Expect(JSTokType.RBRACKET)
                } ElseBlock: {
                    // Regular name: identifier, string, or number
                    ASTTmp.idx = JSParse__Advance()
                    ASTTmp.name_ptr = JSLex_GetPtr(ASTTmp.idx)
                    ASTTmp.name_len = JSLex_GetLen(ASTTmp.idx)
                    // M70: BigInt method name `1n` → "1"
                    IfCondition GreaterThan(ASTTmp.name_len, 1) ThenBlock: {
                        IfCondition EqualTo(GetByte(ASTTmp.name_ptr, Subtract(ASTTmp.name_len, 1)), 110) ThenBlock: {
                            // only strip if token was numeric (digit start)
                            IfCondition And(GreaterEqual(GetByte(ASTTmp.name_ptr, 0), 48), LessEqual(GetByte(ASTTmp.name_ptr, 0), 57)) ThenBlock: {
                                ASTTmp.name_len = Subtract(ASTTmp.name_len, 1)
                            }
                        }
                    }
                    JSParse__NodeSet(method, ASTConst.N_NAME_PTR, ASTTmp.name_ptr)
                    JSParse__NodeSet(method, ASTConst.N_NAME_LEN, ASTTmp.name_len)

                    // Check if this is "constructor"
                    // "constructor" = 99 111 110 115 116 114 117 99 116 111 114 (11 chars)
                    cb_is_ctor = 0
                    IfCondition EqualTo(ASTTmp.name_len, 11) ThenBlock: {
                        IfCondition And(EqualTo(GetByte(ASTTmp.name_ptr, 0), 99), EqualTo(GetByte(ASTTmp.name_ptr, 1), 111)) ThenBlock: {
                            IfCondition And(EqualTo(GetByte(ASTTmp.name_ptr, 2), 110), EqualTo(GetByte(ASTTmp.name_ptr, 3), 115)) ThenBlock: {
                                mflags = Add(mflags, 8)
                                cb_is_ctor = 1
                            }
                        }
                    }

                    // ---- EARLY ERROR: #constructor private name ----
                    // ClassElementName : PrivateName — SyntaxError if StringValue is "#constructor"
                    IfCondition EqualTo(GetByte(ASTTmp.name_ptr, 0), 35) ThenBlock: {
                        // Name starts with '#' — check if it's "#constructor" (12 chars)
                        IfCondition EqualTo(ASTTmp.name_len, 12) ThenBlock: {
                            // Check bytes 1..11 = "constructor" (99 111 110 115 116 114 117 99 116 111 114)
                            IfCondition And(EqualTo(GetByte(ASTTmp.name_ptr, 1), 99), EqualTo(GetByte(ASTTmp.name_ptr, 2), 111)) ThenBlock: {
                                IfCondition And(EqualTo(GetByte(ASTTmp.name_ptr, 3), 110), EqualTo(GetByte(ASTTmp.name_ptr, 4), 115)) ThenBlock: {
                                    ASTState.error = 1
                                    ReturnValue(-1)
                                }
                            }
                        }
                    }

                    // ---- EARLY ERROR: static prototype() ----
                    // ClassElement : static MethodDefinition — SyntaxError if PropName is "prototype"
                    // bit 0 of mflags = static. Use BitwiseAnd for bit extraction.
                    IfCondition And(EqualTo(BitwiseAnd(mflags, 1), 1), EqualTo(cb_is_ctor, 0)) ThenBlock: {
                        // "prototype" = 112 114 111 116 111 116 121 112 101 (9 chars)
                        IfCondition EqualTo(ASTTmp.name_len, 9) ThenBlock: {
                            IfCondition And(EqualTo(GetByte(ASTTmp.name_ptr, 0), 112), EqualTo(GetByte(ASTTmp.name_ptr, 1), 114)) ThenBlock: {
                                IfCondition And(EqualTo(GetByte(ASTTmp.name_ptr, 2), 111), EqualTo(GetByte(ASTTmp.name_ptr, 3), 116)) ThenBlock: {
                                    IfCondition And(EqualTo(GetByte(ASTTmp.name_ptr, 4), 111), EqualTo(GetByte(ASTTmp.name_ptr, 5), 116)) ThenBlock: {
                                        IfCondition And(EqualTo(GetByte(ASTTmp.name_ptr, 6), 121), EqualTo(GetByte(ASTTmp.name_ptr, 7), 112)) ThenBlock: {
                                            IfCondition EqualTo(GetByte(ASTTmp.name_ptr, 8), 101) ThenBlock: {
                                                ASTState.error = 1
                                                ReturnValue(-1)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---- EARLY ERROR: special constructor (get/set/generator/async) ----
                    // ClassElement : MethodDefinition — SyntaxError if PropName is "constructor"
                    // and SpecialMethod is true (getter, setter, generator, or async)
                    // Only applies to non-static constructor (static constructor is just a method named "constructor")
                    IfCondition And(EqualTo(cb_is_ctor, 1), EqualTo(BitwiseAnd(mflags, 1), 0)) ThenBlock: {
                        // Non-static constructor — check if get(2), set(4), generator, or async
                        IfCondition Or(Or(NotEqual(BitwiseAnd(mflags, 2), 0), NotEqual(BitwiseAnd(mflags, 4), 0)),
                                      Or(EqualTo(is_gen_m, 1), EqualTo(is_async_m, 1))) ThenBlock: {
                            ASTState.error = 1
                            ReturnValue(-1)
                        }
                        // Duplicate constructor check
                        IfCondition GreaterEqual(cb_ctor_count, 1) ThenBlock: {
                            ASTState.error = 1
                            ReturnValue(-1)
                        }
                        cb_ctor_count = Add(cb_ctor_count, 1)
                    }
                }

                // ---- Register private name for AllPrivateNamesValid ----
                IfCondition And(GreaterThan(ASTTmp.name_ptr, 0), EqualTo(GetByte(ASTTmp.name_ptr, 0), 35)) ThenBlock: {
                    JSValidate_PrivAdd(ASTTmp.name_ptr, ASTTmp.name_len)
                }

                // ---- EARLY ERROR: duplicate private names ----
                // PrivateBoundNames must not contain duplicates, except get+set pair
                // Only check when name starts with '#' (byte 35)
                IfCondition And(GreaterThan(ASTTmp.name_ptr, 0), EqualTo(GetByte(ASTTmp.name_ptr, 0), 35)) ThenBlock: {
                    // Walk previously-linked elements to check for duplicate
                    // Note: N_NEXT of last element is 0 (unset), so we stop at cb_scan <= 0
                    cb_scan = ASTTmp.first
                    cb_dup_err = 0
                    WhileLoop And(GreaterThan(cb_scan, 0), EqualTo(cb_dup_err, 0)) {
                        cb_sn_ptr = JSParse_GetNamePtr(cb_scan)
                        cb_sn_len = JSParse_GetNameLen(cb_scan)
                        // Check if lengths match and first byte is '#'
                        IfCondition And(EqualTo(cb_sn_len, ASTTmp.name_len), GreaterThan(cb_sn_ptr, 0)) ThenBlock: {
                            IfCondition EqualTo(GetByte(cb_sn_ptr, 0), 35) ThenBlock: {
                                // Compare all bytes
                                cb_bi = 0
                                cb_match = 1
                                WhileLoop And(LessThan(cb_bi, ASTTmp.name_len), EqualTo(cb_match, 1)) {
                                    IfCondition NotEqual(GetByte(cb_sn_ptr, cb_bi), GetByte(ASTTmp.name_ptr, cb_bi)) ThenBlock: {
                                        cb_match = 0
                                    }
                                    cb_bi = Add(cb_bi, 1)
                                }
                                IfCondition EqualTo(cb_match, 1) ThenBlock: {
                                    // Same private name found — check get/set pair exception
                                    cb_prev_flags = JSParse_GetValue(cb_scan)
                                    // Extract accessor bits: get=2, set=4
                                    cb_prev_gs = BitwiseAnd(cb_prev_flags, 6)
                                    cb_curr_gs = BitwiseAnd(mflags, 6)
                                    // Allow exactly: one is pure get(2) and other is pure set(4)
                                    IfCondition Or(EqualTo(Add(cb_prev_gs, cb_curr_gs), 6),
                                                  EqualTo(0, 1)) ThenBlock: {
                                        // get+set pair — allowed, but check no third occurrence
                                        // (handled by subsequent iterations finding a third match)
                                    } ElseBlock: {
                                        cb_dup_err = 1
                                    }
                                }
                            }
                        }
                        cb_scan = JSParse_GetNext(cb_scan)
                    }
                    IfCondition EqualTo(cb_dup_err, 1) ThenBlock: {
                        ASTState.error = 1
                        ReturnValue(-1)
                    }
                }

                // Store flags
                JSParse__NodeSet(method, ASTConst.N_VALUE, mflags)

                // Check if this is a field (no LPAREN) or method (LPAREN)
                IfCondition NotEqual(JSParse__PeekType(), JSTokType.LPAREN) ThenBlock: {
                    // CLASS FIELD DECLARATION: name [= expr] [;]
                    JSParse__NodeSet(method, ASTConst.N_TYPE, ASTType.CLASS_FIELD)

                    // ---- EARLY ERROR: field named "constructor" ----
                    // ES spec 15.7.1: non-static FieldDefinition with PropName "constructor" → SyntaxError
                    // ES spec 15.7.1: static FieldDefinition with PropName "constructor" → SyntaxError
                    // cb_is_ctor=1 means name is "constructor"
                    IfCondition EqualTo(cb_is_ctor, 1) ThenBlock: {
                        ASTState.error = 1
                        ReturnValue(-1)
                    }

                    // Parse optional initializer
                    IfCondition EqualTo(JSParse__PeekType(), JSTokType.ASSIGN) ThenBlock: {
                        JSParse__Advance()
                        AST__Push(ASTTmp.first)
                        AST__Push(ASTTmp.last)
                        AST__Push(ASTTmp.done)
                        AST__Push(mflags)
                        AST__Push(method)
                        field_init = JSParse__Assign()
                        method = AST__Pop()
                        mflags = AST__Pop()
                        ASTTmp.done = AST__Pop()
                        ASTTmp.last = AST__Pop()
                        ASTTmp.first = AST__Pop()
                        JSParse__NodeSet(method, ASTConst.N_LEFT, field_init)

                        // ---- EARLY ERROR: arguments/super() in field initializer ----
                        // ES spec 15.7.1: ContainsArguments / Contains SuperCall
                        AST__Push(ASTTmp.first)
                        AST__Push(ASTTmp.last)
                        AST__Push(ASTTmp.done)
                        AST__Push(method)
                        fi_check = JSValidate_CheckFieldInit(field_init)
                        method = AST__Pop()
                        ASTTmp.done = AST__Pop()
                        ASTTmp.last = AST__Pop()
                        ASTTmp.first = AST__Pop()
                        IfCondition NotEqual(fi_check, 0) ThenBlock: {
                            ASTState.error = 1
                            ReturnValue(-1)
                        }
                    }

                    // Consume optional semicolon
                    IfCondition EqualTo(JSParse__PeekType(), JSTokType.SEMI) ThenBlock: {
                        JSParse__Advance()
                    }

                    // Link field to list
                    IfCondition EqualTo(ASTTmp.first, -1) ThenBlock: {
                        ASTTmp.first = method
                        ASTTmp.last = method
                    } ElseBlock: {
                        JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, method)
                        ASTTmp.last = method
                    }
                } ElseBlock: {

                // Parse parameters: ( params )
                JSParse__Expect(JSTokType.LPAREN)
                ASTTmp.count = 0
                param_first = -1
                param_last = -1
                ASTState.params_simple = 1
                ASTState.had_rest = 0

                p_done = 0
                WhileLoop And(EqualTo(p_done, 0), EqualTo(ASTState.error, 0)) {
                    ASTTmp.type = JSParse__PeekType()
                    IfCondition EqualTo(ASTTmp.type, JSTokType.RPAREN) ThenBlock: {
                        p_done = 1
                    }
                    IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                        p_done = 1
                    }
                    IfCondition EqualTo(p_done, 0) ThenBlock: {
                        // Full destructuring-aware parameter parsing (matches FuncExpr path)
                        ASTTmp.type = JSParse__PeekType()
                        IfCondition Or(EqualTo(ASTTmp.type, JSTokType.LBRACKET), EqualTo(ASTTmp.type, JSTokType.LBRACE)) ThenBlock: {
                            // Destructuring pattern param: { x, y } or [ a, b ]
                            ASTState.params_simple = 0
                            AST__Push(ASTTmp.first)
                            AST__Push(ASTTmp.last)
                            AST__Push(ASTTmp.done)
                            AST__Push(mflags)
                            AST__Push(method)
                            AST__Push(param_first)
                            AST__Push(param_last)
                            AST__Push(p_done)
                            param = JSParse__ParseBindTarget()
                            p_done = AST__Pop()
                            param_last = AST__Pop()
                            param_first = AST__Pop()
                            method = AST__Pop()
                            mflags = AST__Pop()
                            ASTTmp.done = AST__Pop()
                            ASTTmp.last = AST__Pop()
                            ASTTmp.first = AST__Pop()

                            // Check for default value after pattern
                            IfCondition EqualTo(JSParse__PeekType(), JSTokType.ASSIGN) ThenBlock: {
                                JSParse__Advance()
                                AST__Push(ASTTmp.first)
                                AST__Push(ASTTmp.last)
                                AST__Push(ASTTmp.done)
                                AST__Push(mflags)
                                AST__Push(method)
                                AST__Push(param_first)
                                AST__Push(param_last)
                                AST__Push(p_done)
                                AST__Push(param)
                                wrap_cm = JSParse__AllocNode()
                                param = AST__Pop()
                                p_done = AST__Pop()
                                param_last = AST__Pop()
                                param_first = AST__Pop()
                                method = AST__Pop()
                                mflags = AST__Pop()
                                ASTTmp.done = AST__Pop()
                                ASTTmp.last = AST__Pop()
                                ASTTmp.first = AST__Pop()
                                JSParse__NodeSet(wrap_cm, ASTConst.N_TYPE, ASTType.ASSIGN)
                                JSParse__NodeSet(wrap_cm, ASTConst.N_RIGHT, param)
                                AST__Push(ASTTmp.first)
                                AST__Push(ASTTmp.last)
                                AST__Push(ASTTmp.done)
                                AST__Push(mflags)
                                AST__Push(method)
                                AST__Push(param_first)
                                AST__Push(param_last)
                                AST__Push(p_done)
                                AST__Push(wrap_cm)
                                dv_cm = JSParse__Assign()
                                wrap_cm = AST__Pop()
                                p_done = AST__Pop()
                                param_last = AST__Pop()
                                param_first = AST__Pop()
                                method = AST__Pop()
                                mflags = AST__Pop()
                                ASTTmp.done = AST__Pop()
                                ASTTmp.last = AST__Pop()
                                ASTTmp.first = AST__Pop()
                                JSParse__NodeSet(wrap_cm, ASTConst.N_LEFT, dv_cm)
                                param = wrap_cm
                            }
                        } ElseBlock: {
                            IfCondition EqualTo(ASTTmp.type, JSTokType.DOT3) ThenBlock: {
                                // Rest parameter: ...x
                                JSParse__Advance()
                                ASTState.params_simple = 0
                                ASTState.had_rest = 1
                                AST__Push(ASTTmp.first)
                                AST__Push(ASTTmp.last)
                                AST__Push(ASTTmp.done)
                                AST__Push(mflags)
                                AST__Push(method)
                                AST__Push(param_first)
                                AST__Push(param_last)
                                AST__Push(p_done)
                                param = JSParse__AllocNode()
                                p_done = AST__Pop()
                                param_last = AST__Pop()
                                param_first = AST__Pop()
                                method = AST__Pop()
                                mflags = AST__Pop()
                                ASTTmp.done = AST__Pop()
                                ASTTmp.last = AST__Pop()
                                ASTTmp.first = AST__Pop()
                                JSParse__NodeSet(param, ASTConst.N_TYPE, ASTType.REST_ELEMENT)
                                ASTTmp.idx = JSParse__Expect(JSTokType.IDENT)
                                AST__Push(ASTTmp.first)
                                AST__Push(ASTTmp.last)
                                AST__Push(ASTTmp.done)
                                AST__Push(mflags)
                                AST__Push(method)
                                AST__Push(param_first)
                                AST__Push(param_last)
                                AST__Push(p_done)
                                AST__Push(param)
                                rest_id_cm = JSParse__AllocNode()
                                param = AST__Pop()
                                p_done = AST__Pop()
                                param_last = AST__Pop()
                                param_first = AST__Pop()
                                method = AST__Pop()
                                mflags = AST__Pop()
                                ASTTmp.done = AST__Pop()
                                ASTTmp.last = AST__Pop()
                                ASTTmp.first = AST__Pop()
                                JSParse__NodeSet(rest_id_cm, ASTConst.N_TYPE, ASTType.IDENT)
                                JSParse__NodeSet(rest_id_cm, ASTConst.N_NAME_PTR, JSLex_GetPtr(ASTTmp.idx))
                                JSParse__NodeSet(rest_id_cm, ASTConst.N_NAME_LEN, JSLex_GetLen(ASTTmp.idx))
                                JSParse__NodeSet(param, ASTConst.N_LEFT, rest_id_cm)
                            } ElseBlock: {
                                // Simple IDENT param (possibly with default)
                                ASTTmp.idx = JSParse__Expect(JSTokType.IDENT)
                                AST__Push(ASTTmp.first)
                                AST__Push(ASTTmp.last)
                                AST__Push(ASTTmp.done)
                                AST__Push(mflags)
                                AST__Push(method)
                                AST__Push(param_first)
                                AST__Push(param_last)
                                AST__Push(p_done)
                                param = JSParse__AllocNode()
                                p_done = AST__Pop()
                                param_last = AST__Pop()
                                param_first = AST__Pop()
                                method = AST__Pop()
                                mflags = AST__Pop()
                                ASTTmp.done = AST__Pop()
                                ASTTmp.last = AST__Pop()
                                ASTTmp.first = AST__Pop()
                                JSParse__NodeSet(param, ASTConst.N_TYPE, ASTType.IDENT)
                                JSParse__NodeSet(param, ASTConst.N_NAME_PTR, JSLex_GetPtr(ASTTmp.idx))
                                JSParse__NodeSet(param, ASTConst.N_NAME_LEN, JSLex_GetLen(ASTTmp.idx))

                                // Check for default value: = expr
                                IfCondition EqualTo(JSParse__PeekType(), JSTokType.ASSIGN) ThenBlock: {
                                    JSParse__Advance()
                                    ASTState.params_simple = 0
                                    JSParse__NodeSet(param, ASTConst.N_TYPE, ASTType.ASSIGN)
                                    AST__Push(ASTTmp.first)
                                    AST__Push(ASTTmp.last)
                                    AST__Push(ASTTmp.done)
                                    AST__Push(mflags)
                                    AST__Push(method)
                                    AST__Push(param_first)
                                    AST__Push(param_last)
                                    AST__Push(p_done)
                                    AST__Push(param)
                                    def_cm = JSParse__Assign()
                                    param = AST__Pop()
                                    p_done = AST__Pop()
                                    param_last = AST__Pop()
                                    param_first = AST__Pop()
                                    method = AST__Pop()
                                    mflags = AST__Pop()
                                    ASTTmp.done = AST__Pop()
                                    ASTTmp.last = AST__Pop()
                                    ASTTmp.first = AST__Pop()
                                    JSParse__NodeSet(param, ASTConst.N_LEFT, def_cm)
                                }
                            }
                        }

                        IfCondition EqualTo(param_first, -1) ThenBlock: {
                            param_first = param
                            param_last = param
                        } ElseBlock: {
                            JSParse__NodeSet(param_last, ASTConst.N_NEXT, param)
                            param_last = param
                        }
                        ASTTmp.count = Add(ASTTmp.count, 1)

                        IfCondition EqualTo(JSParse__PeekType(), JSTokType.COMMA) ThenBlock: {
                            // Trailing comma after rest parameter is a syntax error
                            IfCondition EqualTo(ASTState.had_rest, 1) ThenBlock: {
                                ASTState.error = 1
                                ReturnValue(-1)
                            }
                            JSParse__Advance()
                        }
                    }
                }
                JSParse__Expect(JSTokType.RPAREN)

                // Store param list in N_LEFT, param count in N_OP
                JSParse__NodeSet(method, ASTConst.N_LEFT, param_first)
                JSParse__NodeSet(method, ASTConst.N_OP, ASTTmp.count)

                // Early error: duplicate parameter names (class methods are always strict)
                IfCondition EqualTo(JSValidate_CheckDupParams(param_first), 1) ThenBlock: {
                    ASTState.error = 1
                    ReturnValue(-1)
                }

                // Save params_simple before body parse
                cm_params_simple = ASTState.params_simple

                // Parse body: { ... } — Block() consumes LBRACE and RBRACE
                AST__Push(ASTTmp.first)
                AST__Push(ASTTmp.last)
                AST__Push(ASTTmp.done)
                AST__Push(mflags)
                AST__Push(method)
                mbody = JSParse__Block()
                method = AST__Pop()
                mflags = AST__Pop()
                ASTTmp.done = AST__Pop()
                ASTTmp.last = AST__Pop()
                ASTTmp.first = AST__Pop()

                JSParse__NodeSet(method, ASTConst.N_BODY, mbody)

                // Early error: non-simple params + "use strict" directive
                IfCondition EqualTo(cm_params_simple, 0) ThenBlock: {
                    IfCondition EqualTo(JSValidate_BodyHasUseStrict(mbody), 1) ThenBlock: {
                        ASTState.error = 1
                        ReturnValue(-1)
                    }
                }

                // ---- EARLY ERROR: super() in non-constructor methods ----
                // ES spec 15.4.1: HasDirectSuper — super() only valid in derived constructors
                // Check non-constructor methods AND constructors without extends
                // mflags bit 3 = constructor
                ds_need_check = 0
                IfCondition EqualTo(BitwiseAnd(mflags, 8), 0) ThenBlock: {
                    // Not a constructor — super() is always illegal
                    ds_need_check = 1
                }
                // Constructor without extends — super() is also illegal
                IfCondition And(NotEqual(BitwiseAnd(mflags, 8), 0), LessEqual(ASTState.has_extends, 0)) ThenBlock: {
                    ds_need_check = 1
                }
                IfCondition EqualTo(ds_need_check, 1) ThenBlock: {
                    AST__Push(ASTTmp.first)
                    AST__Push(ASTTmp.last)
                    AST__Push(ASTTmp.done)
                    AST__Push(mflags)
                    AST__Push(method)
                    ds_check = JSValidate_HasDirectSuper(mbody)
                    method = AST__Pop()
                    mflags = AST__Pop()
                    ASTTmp.done = AST__Pop()
                    ASTTmp.last = AST__Pop()
                    ASTTmp.first = AST__Pop()
                    IfCondition EqualTo(ds_check, 1) ThenBlock: {
                        ASTState.error = 1
                        ReturnValue(-1)
                    }
                }

                // Link method to list
                IfCondition EqualTo(ASTTmp.first, -1) ThenBlock: {
                    ASTTmp.first = method
                    ASTTmp.last = method
                } ElseBlock: {
                    JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, method)
                    ASTTmp.last = method
                }

                } // end ElseBlock for field vs method
            } // end IfCondition GreaterEqual(mflags, 0) — skip if static block handled
            }
        }

        // ---- EARLY ERROR: AllPrivateNamesValid ----
        // ES spec 15.7.1: every #name reference must refer to a declared private name
        IfCondition And(GreaterThan(ASTTmp.first, 0), EqualTo(ASTState.error, 0)) ThenBlock: {
            AST__Push(ASTTmp.first)
            AST__Push(ASTTmp.last)
            AST__Push(ASTTmp.done)
            pnv_check = JSValidate_AllPrivateNamesValid(ASTTmp.first)
            ASTTmp.done = AST__Pop()
            ASTTmp.last = AST__Pop()
            ASTTmp.first = AST__Pop()
            IfCondition EqualTo(pnv_check, 1) ThenBlock: {
                ASTState.error = 1
                ReturnValue(-1)
            }
        }

        JSValidate_PrivPop()
        ASTState.in_class_depth = Subtract(ASTState.in_class_depth, 1)
        JSParse__Expect(JSTokType.RBRACE)
        ReturnValue(ASTTmp.first)
    }
}

// ---------------------------------------------------------------------------
// Class declaration: class Name [extends Expr] { body }
// Returns CLASS_DECL node.
// ---------------------------------------------------------------------------
Function.JSParse__ClassDecl {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'class'
        JSParse__Advance()

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.CLASS_DECL)

        // Class name (required for declarations)
        ASTTmp.idx = JSParse__Expect(JSTokType.IDENT)
        ASTTmp.name_ptr = JSLex_GetPtr(ASTTmp.idx)
        ASTTmp.name_len = JSLex_GetLen(ASTTmp.idx)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_PTR, ASTTmp.name_ptr)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, ASTTmp.name_len)

        // Redeclaration check: class declarations are always lexical
        IfCondition EqualTo(JSValidate_DeclareBinding(ASTTmp.name_ptr, ASTTmp.name_len, JSValidConst.KIND_LEXICAL), 0) ThenBlock: {
            ASTState.error = 1
            ReturnValue(-1)
        }

        // Optional: extends
        IfCondition EqualTo(JSParse__PeekType(), JSTokType.KW_EXTENDS) ThenBlock: {
            JSParse__Advance()
            AST__Push(ASTTmp.node)
            parent_expr = JSParse__Assign()
            ASTTmp.node = AST__Pop()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, parent_expr)
        }

        // Class body: { methods }
        // Set has_extends flag for ClassBody to use in super() validation
        // N_LEFT is set if extends clause exists, 0 otherwise
        ASTState.has_extends = JSParse_GetLeft(ASTTmp.node)
        JSParse__Expect(JSTokType.LBRACE)
        AST__Push(ASTTmp.node)
        body = JSParse__ClassBody()
        ASTTmp.node = AST__Pop()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, body)

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// Class expression: class [Name] [extends Expr] { body }
// Returns CLASS_EXPR node.
// ---------------------------------------------------------------------------
Function.JSParse__ClassExpr {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'class'
        JSParse__Advance()

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.CLASS_EXPR)

        // Optional class name
        IfCondition EqualTo(JSParse__PeekType(), JSTokType.IDENT) ThenBlock: {
            // Only consume if next-next is NOT LBRACE (avoid consuming extends keyword as name)
            next2_pos2 = Add(ASTState.tok_pos, 1)
            can_be_name = 1
            IfCondition LessThan(next2_pos2, ASTState.tok_total) ThenBlock: {
                // If next token after ident is 'extends' or '{', it's a name
                // If it's something else entirely, still treat as name
                can_be_name = 1
            }
            // Check if current IDENT is actually "extends" keyword (shouldn't happen, lexer handles it)
            IfCondition EqualTo(can_be_name, 1) ThenBlock: {
                // Peek — if it's not 'extends' keyword token, it's the class name
                IfCondition NotEqual(JSParse__PeekType(), JSTokType.KW_EXTENDS) ThenBlock: {
                    ASTTmp.idx = JSParse__Advance()
                    ASTTmp.name_ptr = JSLex_GetPtr(ASTTmp.idx)
                    ASTTmp.name_len = JSLex_GetLen(ASTTmp.idx)
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_PTR, ASTTmp.name_ptr)
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, ASTTmp.name_len)
                }
            }
        }

        // Optional: extends
        IfCondition EqualTo(JSParse__PeekType(), JSTokType.KW_EXTENDS) ThenBlock: {
            JSParse__Advance()
            AST__Push(ASTTmp.node)
            parent_expr2 = JSParse__Assign()
            ASTTmp.node = AST__Pop()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, parent_expr2)
        }

        // Class body: { methods }
        // Set has_extends flag for ClassBody to use in super() validation
        ASTState.has_extends = JSParse_GetLeft(ASTTmp.node)
        JSParse__Expect(JSTokType.LBRACE)
        AST__Push(ASTTmp.node)
        body2 = JSParse__ClassBody()
        ASTTmp.node = AST__Pop()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, body2)

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// Statement — dispatch on current token type
// ---------------------------------------------------------------------------
Function.JSParse__Statement {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        ASTTmp.type = JSParse__PeekType()

        // --- var / let / const ---
        // M64b: bare `let` (or `let` + LineTerminator + `{`) is Identifier
        // ExpressionStatement (let-block-with-newline / let-identifier-with-newline).
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_LET) ThenBlock: {
            let_is_decl = 0
            next_pos_let = Add(ASTState.tok_pos, 1)
            IfCondition LessThan(next_pos_let, ASTState.tok_total) ThenBlock: {
                next_t_let = JSLex_GetType(next_pos_let)
                IfCondition Or(EqualTo(next_t_let, JSTokType.IDENT), EqualTo(next_t_let, JSTokType.LBRACKET)) ThenBlock: {
                    let_is_decl = 1
                }
                IfCondition EqualTo(next_t_let, JSTokType.LBRACE) ThenBlock: {
                    let_line = JSLex_GetLine(ASTState.tok_pos)
                    next_line = JSLex_GetLine(next_pos_let)
                    IfCondition EqualTo(let_line, next_line) ThenBlock: {
                        let_is_decl = 1
                    }
                }
            }
            IfCondition EqualTo(let_is_decl, 1) ThenBlock: {
                ReturnValue(JSParse__VarDecl(0))
            }
            // Identifier expression `let`
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.EXPR_STMT)
            idn = JSParse__AllocNode()
            JSParse__NodeSet(idn, ASTConst.N_TYPE, ASTType.IDENT)
            JSParse__NodeSet(idn, ASTConst.N_NAME_PTR, JSLex_GetPtr(ASTState.tok_pos))
            JSParse__NodeSet(idn, ASTConst.N_NAME_LEN, JSLex_GetLen(ASTState.tok_pos))
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, idn)
            JSParse__Advance()
            IfCondition EqualTo(JSParse__PeekType(), JSTokType.SEMI) ThenBlock: {
                JSParse__Advance()
            }
            ReturnValue(ASTTmp.node)
        }
        IfCondition Or(EqualTo(ASTTmp.type, JSTokType.KW_VAR), EqualTo(ASTTmp.type, JSTokType.KW_CONST)) ThenBlock: {
            ReturnValue(JSParse__VarDecl(0))
        }

        // --- function ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_FUNCTION) ThenBlock: {
            ReturnValue(JSParse__FuncDecl())
        }

        // --- async function ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_ASYNC) ThenBlock: {
            ReturnValue(JSParse__AsyncFuncDecl())
        }

        // --- class ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_CLASS) ThenBlock: {
            ReturnValue(JSParse__ClassDecl())
        }

        // --- return ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_RETURN) ThenBlock: {
            ReturnValue(JSParse__ReturnStmt())
        }

        // --- if ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_IF) ThenBlock: {
            ReturnValue(JSParse__IfStmt())
        }

        // --- while ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_WHILE) ThenBlock: {
            ReturnValue(JSParse__WhileStmt())
        }

        // --- for ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_FOR) ThenBlock: {
            ReturnValue(JSParse__ForStmt())
        }

        // --- do ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_DO) ThenBlock: {
            ReturnValue(JSParse__DoWhile())
        }

        // --- switch ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_SWITCH) ThenBlock: {
            ReturnValue(JSParse__SwitchStmt())
        }

        // --- try ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_TRY) ThenBlock: {
            ReturnValue(JSParse__TryStmt())
        }

        // --- throw ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_THROW) ThenBlock: {
            ReturnValue(JSParse__ThrowStmt())
        }

        // --- break ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_BREAK) ThenBlock: {
            ReturnValue(JSParse__BreakStmt())
        }

        // --- continue ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_CONTINUE) ThenBlock: {
            ReturnValue(JSParse__ContStmt())
        }

        // --- block ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.LBRACE) ThenBlock: {
            ReturnValue(JSParse__Block())
        }

        // --- empty statement (bare semicolon) ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
            JSParse__Advance()
            // Allocate an empty BLOCK node for empty statements
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.BLOCK)
            ReturnValue(ASTTmp.node)
        }

        // --- labeled statement: label : Statement (M53: keep LABELED_STMT node) ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.IDENT) ThenBlock: {
            next_pos = Add(ASTState.tok_pos, 1)
            IfCondition LessThan(next_pos, ASTState.tok_total) ThenBlock: {
                next_type = JSLex_GetType(next_pos)
                IfCondition EqualTo(next_type, JSTokType.COLON) ThenBlock: {
                    // Capture label name before advance
                    lab_ptr = JSLex_GetPtr(ASTState.tok_pos)
                    lab_len = JSLex_GetLen(ASTState.tok_pos)
                    JSParse__Advance()
                    JSParse__Advance()
                    // Parse body (may itself be labeled)
                    AST__Push(lab_ptr)
                    AST__Push(lab_len)
                    body_lab = JSParse__Statement()
                    lab_len = AST__Pop()
                    lab_ptr = AST__Pop()
                    lab_node = JSParse__AllocNode()
                    JSParse__NodeSet(lab_node, ASTConst.N_TYPE, ASTType.LABELED_STMT)
                    JSParse__NodeSet(lab_node, ASTConst.N_NAME_PTR, lab_ptr)
                    JSParse__NodeSet(lab_node, ASTConst.N_NAME_LEN, lab_len)
                    JSParse__NodeSet(lab_node, ASTConst.N_BODY, body_lab)
                    ReturnValue(lab_node)
                }
            }
        }

        // --- expression statement ---
        ASTTmp.left = JSParse__Expr()
        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.EXPR_STMT)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)

        // Consume semicolon (tolerate missing for robustness)
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
            JSParse__Advance()
        }

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// Program — top-level: parse statements until EOF, link via N_NEXT
// CLOBBER FIX: push node, first, last before JSParse__Statement()
// ---------------------------------------------------------------------------
Function.JSParse__Program {
    Output: Integer
    Body: {
        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.PROGRAM)
        ASTTmp.first = -1
        ASTTmp.last = -1

        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                // CLOBBER GUARD: push node, first, last, done before Statement
                AST__Push(ASTTmp.node)
                AST__Push(ASTTmp.first)
                AST__Push(ASTTmp.last)
                AST__Push(ASTTmp.done)

                stmt = JSParse__Statement()

                // RESTORE
                ASTTmp.done = AST__Pop()
                ASTTmp.last = AST__Pop()
                ASTTmp.first = AST__Pop()
                ASTTmp.node = AST__Pop()

                IfCondition EqualTo(ASTTmp.first, -1) ThenBlock: {
                    ASTTmp.first = stmt
                    ASTTmp.last = stmt
                } ElseBlock: {
                    JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, stmt)
                    ASTTmp.last = stmt
                }

                // Walk to end of multi-var chain (var x=1, y=2 creates linked VAR_DECLs)
                ASTTmp.idx = JSParse_GetNext(ASTTmp.last)
                WhileLoop GreaterEqual(ASTTmp.idx, 0) {
                    ASTTmp.last = ASTTmp.idx
                    ASTTmp.idx = JSParse_GetNext(ASTTmp.last)
                }
            }
        }

        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.first)
        ReturnValue(ASTTmp.node)
    }
}
