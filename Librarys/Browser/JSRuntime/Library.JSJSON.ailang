    }
}

Function.JSJSON_Context {
    Input: holder: Address
    Input: name: Address
    Output: Address
    Body: {
        save_h = holder
        save_n = name
        ctx = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(ctx, "__proto__", JSRTState.object_proto)
        }
        box = JSRT_ObjGet(save_h, "__jsrc__")
        IfCondition NotEqual(JSRT_GetType(box), JSType.OBJECT) ThenBlock: {
            ReturnValue(ctx)
        }
        sp = save_n
        IfCondition EqualTo(JSRT_GetType(save_n), JSType.STRING) ThenBlock: {
            sp = JSRT_GetPayload(save_n)
        }
        srcv = JSRT_ObjGet(box, sp)
        IfCondition EqualTo(JSRT_GetType(srcv), JSType.STRING) ThenBlock: {
            JSRT_ObjSet(ctx, "source", srcv)
        }
        ReturnValue(ctx)
    }
}

Function.JSJSON_Revive {
    Input: holder: Address
    Input: name: Address
    Output: Address
    Body: {
        save_h = holder
        save_n = name
        sp = save_n
        IfCondition EqualTo(JSRT_GetType(save_n), JSType.STRING) ThenBlock: {
            sp = JSRT_GetPayload(save_n)
        }
        val = JSVM__GetProperty(save_h, sp)
        IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
        vt = JSRT_GetType(val)
        is_ctr = 0
        IfCondition EqualTo(vt, JSType.OBJECT) ThenBlock: { is_ctr = 1 }
        IfCondition EqualTo(vt, JSType.ARRAY) ThenBlock: { is_ctr = 1 }
        IfCondition EqualTo(is_ctr, 1) ThenBlock: {
            IfCondition EqualTo(vt, JSType.ARRAY) ThenBlock: {
                alen = JSRT_ArrLen(val)
                ai = 0
                WhileLoop LessThan(ai, alen) {
                    JSRT__Push(save_h)
                    JSRT__Push(save_n)
                    JSRT__Push(val)
                    cs = JSRT__IntToStr(ai)
                    nm = JSRT_CreateString(cs)
                    val = JSRT__Pop()
                    save_n = JSRT__Pop()
                    save_h = JSRT__Pop()
                    JSRT__Push(save_h)
                    JSRT__Push(save_n)
                    JSRT__Push(val)
                    nv = JSJSON_Revive(val, nm)
                    val = JSRT__Pop()
                    save_n = JSRT__Pop()
                    save_h = JSRT__Pop()
                    IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
                    IfCondition EqualTo(JSJSON_IsUndef(nv), 1) ThenBlock: {
                        // OrdinaryDelete: a non-configurable index stays.
                        JSRT__Push(val)
                        JSRT__Push(nm)
                        bits_del = JSBridge__GetAttrBits(val, JSRT_GetPayload(nm))
                        JSRTStack.hold = bits_del
                        nm = JSRT__Pop()
                        val = JSRT__Pop()
                        bits_del = JSRTStack.hold
                        JSRTStack.hold = 0
                        IfCondition NotEqual(BitwiseAnd(bits_del, 4), 0) ThenBlock: {
                            JSRT_ObjDelete(val, JSRT_GetPayload(nm))
                        }
                    } ElseBlock: {
                        JSRT_ArrSet(val, ai, nv)
                    }
                    ai = Add(ai, 1)
                }
            } ElseBlock: {
                JSRT__Push(save_h)
                JSRT__Push(save_n)
                JSRT__Push(val)
                keys = JSJSON_OrderKeys(JSRT_ObjKeys(val))
                val = JSRT__Pop()
                save_n = JSRT__Pop()
                save_h = JSRT__Pop()
                kn = JSRT_ArrLen(keys)
                ki = 0
                WhileLoop LessThan(ki, kn) {
                    JSRT__Push(save_h)
                    JSRT__Push(save_n)
                    JSRT__Push(val)
                    JSRT__Push(keys)
                    km = JSRT_ArrGet(keys, ki)
                    keys = JSRT__Pop()
                    val = JSRT__Pop()
                    save_n = JSRT__Pop()
                    save_h = JSRT__Pop()
                    JSRT__Push(save_h)
                    JSRT__Push(save_n)
                    JSRT__Push(val)
                    JSRT__Push(keys)
                    JSRT__Push(km)
                    nv = JSJSON_Revive(val, km)
                    km = JSRT__Pop()
                    keys = JSRT__Pop()
                    val = JSRT__Pop()
                    save_n = JSRT__Pop()
                    save_h = JSRT__Pop()
                    IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
                    ksp = JSRT_GetPayload(km)
                    IfCondition EqualTo(JSJSON_IsUndef(nv), 1) ThenBlock: {
                        JSRT_ObjDelete(val, ksp)
                    } ElseBlock: {
                        JSRT_ObjSet(val, ksp, nv)
                    }
                    ki = Add(ki, 1)
                }
            }
        }
        JSRT__Push(save_h)
        JSRT__Push(save_n)
        JSRT__Push(val)
        ctx = JSJSON_Context(save_h, save_n)
        val = JSRT__Pop()
        save_n = JSRT__Pop()
        save_h = JSRT__Pop()
        rev = JSJSONPos.reviver
        rv = JSJSON_Call3(rev, save_h, save_n, val, ctx)
        IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(rv)
    }
}

Function.JSJSON_Parse {
    Input: js_str_val: Address
    Output: Address
    Body: {
        save_val = js_str_val
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(JSJSON_ThrowSyntax()) }
        str_val = save_val
        IfCondition NotEqual(JSRT_GetType(save_val), JSType.STRING) ThenBlock: {
            str_val = JSRT_ToString(save_val)
            IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
        }
        src = JSRT_GetPayload(str_val)
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(JSJSON_ThrowSyntax()) }
        JSJSONPos.src = src
        JSJSONPos.pos = 0
        JSJSONPos.len = JSRT_StrLen(src)
        JSJSONPos.err = 0
        JSJSONPos.last_src = 0
        val = JSJSON_ParseValue()
        IfCondition EqualTo(JSJSONPos.err, 1) ThenBlock: {
            ReturnValue(JSJSON_ThrowSyntax())
        }
        JSJSON_SkipWS()
        IfCondition LessThan(JSJSONPos.pos, JSJSONPos.len) ThenBlock: {
            ReturnValue(JSJSON_ThrowSyntax())
        }
        root_src = JSJSONPos.last_src
        rev = JSJSONPos.reviver
        IfCondition NotEqual(JSRT_GetType(rev), JSType.FUNCTION) ThenBlock: {
            ReturnValue(val)
        }
        root = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(root, "__proto__", JSRTState.object_proto)
        }
        JSRT_ObjSet(root, "", val)
        // CreateDataProperty: writable, enumerable, configurable.
        JSBridge__SetAttrBits(root, "", 7)
        IfCondition NotEqual(root_src, 0) ThenBlock: {
            JSJSONPos.last_src = root_src
            JSJSON_KeepSrc(root, "")
        }
        empty = JSRT_CreateString("")
        rv = JSJSON_Revive(root, empty)
        IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        ReturnValue(rv)
    }
}

Function.JSJSON_ParseNative {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        JSJSONPos.reviver = 0
        JSJSONPos.keep_src = 0
        JSJSONPos.err = 0
        text = JSRTState.undef_val
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            text = RDMEM_64(save_args)
        }
        IfCondition GreaterThan(save_argc, 1) ThenBlock: {
            rev = RDMEM_64(save_args, 8)
            IfCondition EqualTo(JSRT_GetType(rev), JSType.FUNCTION) ThenBlock: {
                JSJSONPos.reviver = rev
                JSJSONPos.keep_src = 1
            }
        }
        ReturnValue(JSJSON_Parse(text))
    }
}

