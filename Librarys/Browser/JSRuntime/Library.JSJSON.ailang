        save_a = a0
        JSJSON_PushState()
        prev = JSVM__GetGlobal("this")
        JSVM__SetGlobal("this", save_r)
        WRMEM_64(JSVMCallBuf.buf, save_a)
        rv = JSVM__CallFunc(save_fn, JSVMCallBuf.buf, 1)
        JSVM__SetGlobal("this", prev)
        JSJSON_PopState()
        ReturnValue(rv)
    }
}

Function.JSJSON_Call2 {
