// Library.JSJSON.ailang — Native JSON.parse / JSON.stringify for the JS engine
//
// Fork of the engine's JSON path (was inlined in Library.JSBridge). Uses
// JSRT UTF-16 string APIs (JSRT_StrLen / JSRT_StrUnit) — JS string payloads
// are magic-headered UTF-16, NOT C strings. The old RDMEM_8/StringLength
// path always returned undefined.
//
// Outputs JSRT values (JSType.NUMBER/STRING/OBJECT/ARRAY/BOOLEAN/NULL).
// Does not use Library.JSON.ailang's JType tagged model (Ailang-native IPC).
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Arrays
LibraryImport.StringUtils
LibraryImport.Browser.JSRuntime

// Parse cursor over a JS string payload (UTF-16 code units)
FixedPool.JSJSONPos {
    "pos": Initialize=0
    "src": Initialize=0
    "len": Initialize=0
    "err": Initialize=0
    "last_src": Initialize=0
    "reviver": Initialize=0
    "keep_src": Initialize=0
    "gap": Initialize=0
    "replacer": Initialize=0
    "prop_list": Initialize=0
    "stack": Initialize=0
    "indent": Initialize=0
}

// ─── Cursor helpers ────────────────────────────────────────────────────────

Function.JSJSON_SkipWS {
    Output: Integer
    Body: {
        WhileLoop LessThan(JSJSONPos.pos, JSJSONPos.len) {
            ch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
            is_ws = 0
            IfCondition EqualTo(ch, 32) ThenBlock: { is_ws = 1 }
            IfCondition EqualTo(ch, 9) ThenBlock: { is_ws = 1 }
            IfCondition EqualTo(ch, 10) ThenBlock: { is_ws = 1 }
            IfCondition EqualTo(ch, 13) ThenBlock: { is_ws = 1 }
            IfCondition EqualTo(is_ws, 0) ThenBlock: { ReturnValue(ch) }
            JSJSONPos.pos = Add(JSJSONPos.pos, 1)
        }
        ReturnValue(0)
    }
}

// Hex digit → 0-15, or -1 if invalid
Function.JSJSON_HexVal {
    Input: ch: Integer
    Output: Integer
    Body: {
        save_ch = ch
        IfCondition And(GreaterEqual(save_ch, 48), LessEqual(save_ch, 57)) ThenBlock: {
            ReturnValue(Subtract(save_ch, 48))
        }
        IfCondition And(GreaterEqual(save_ch, 65), LessEqual(save_ch, 70)) ThenBlock: {
            ReturnValue(Add(Subtract(save_ch, 65), 10))
        }
        IfCondition And(GreaterEqual(save_ch, 97), LessEqual(save_ch, 102)) ThenBlock: {
            ReturnValue(Add(Subtract(save_ch, 97), 10))
        }
        ReturnValue(Subtract(0, 1))
    }
}

// ─── Parse string (pos at opening quote) ───────────────────────────────────

Function.JSJSON_SetErr {
    Output: Integer
    Body: {
        JSJSONPos.err = 1
        ReturnValue(0)
    }
}

Function.JSJSON_NoteSrc {
    Input: start: Integer
    Output: Integer
    Body: {
        save_st = start
        IfCondition EqualTo(JSJSONPos.keep_src, 0) ThenBlock: {
            JSJSONPos.last_src = 0
            ReturnValue(0)
        }
        n = Subtract(JSJSONPos.pos, save_st)
        IfCondition LessThan(n, 0) ThenBlock: { n = 0 }
        JSJSONPos.last_src = JSRT_CreateStringSlice(JSJSONPos.src, save_st, n)
        ReturnValue(1)
    }
}

Function.JSJSON_KeepSrc {
    Input: parent: Address
    Input: key: Address
    Output: Integer
    Body: {
        save_p = parent
        save_k = key
        srcv = JSJSONPos.last_src
        IfCondition EqualTo(srcv, 0) ThenBlock: { ReturnValue(0) }
        box = JSRT_ObjGet(save_p, "__jsrc__")
        IfCondition NotEqual(JSRT_GetType(box), JSType.OBJECT) ThenBlock: {
            JSRT__Push(save_p)
            JSRT__Push(save_k)
            JSRT__Push(srcv)
            box = JSRT_CreateObject()
            srcv = JSRT__Pop()
            save_k = JSRT__Pop()
            save_p = JSRT__Pop()
            IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                JSRT_ObjSet(box, "__proto__", JSRTState.object_proto)
            }
            JSRT_ObjSet(save_p, "__jsrc__", box)
        }
        JSRT_ObjSet(box, save_k, srcv)
        ReturnValue(1)
    }
}

Function.JSJSON_ParseString {
    Output: Address
    Body: {
        start = JSJSONPos.pos
        JSJSONPos.pos = Add(JSJSONPos.pos, 1)
        rem = Subtract(JSJSONPos.len, JSJSONPos.pos)
        IfCondition LessThan(rem, 0) ThenBlock: { rem = 0 }
        buf = JSRT_StrAlloc(rem)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(JSJSON_SetErr()) }
        oi = 0
        WhileLoop LessThan(JSJSONPos.pos, JSJSONPos.len) {
            ch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
            JSJSONPos.pos = Add(JSJSONPos.pos, 1)
            IfCondition EqualTo(ch, 34) ThenBlock: {
                WRMEM_64(buf, 8, oi)
                JSRT_StrSetUnit(buf, oi, 0)
                val = JSRT__AllocValue()
                IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(JSJSON_SetErr()) }
                WRMEM_64(val, JSType.STRING)
                WRMEM_64(val, 8, buf)
                JSJSON_NoteSrc(start)
                ReturnValue(val)
            }
            IfCondition LessThan(ch, 32) ThenBlock: {
                ReturnValue(JSJSON_SetErr())
            }
            IfCondition EqualTo(ch, 92) ThenBlock: {
                IfCondition GreaterEqual(JSJSONPos.pos, JSJSONPos.len) ThenBlock: {
                    ReturnValue(JSJSON_SetErr())
                }
                esc = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
                JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                known = 0
                IfCondition EqualTo(esc, 110) ThenBlock: { ch = 10 known = 1 }
                IfCondition EqualTo(esc, 116) ThenBlock: { ch = 9 known = 1 }
                IfCondition EqualTo(esc, 114) ThenBlock: { ch = 13 known = 1 }
                IfCondition EqualTo(esc, 98) ThenBlock: { ch = 8 known = 1 }
                IfCondition EqualTo(esc, 102) ThenBlock: { ch = 12 known = 1 }
                IfCondition EqualTo(esc, 34) ThenBlock: { ch = 34 known = 1 }
                IfCondition EqualTo(esc, 92) ThenBlock: { ch = 92 known = 1 }
                IfCondition EqualTo(esc, 47) ThenBlock: { ch = 47 known = 1 }
                IfCondition EqualTo(esc, 117) ThenBlock: {
                    cp = 0
                    hi = 0
                    bad_u = 0
                    WhileLoop LessThan(hi, 4) {
                        IfCondition GreaterEqual(JSJSONPos.pos, JSJSONPos.len) ThenBlock: {
                            bad_u = 1
                            hi = 4
                        }
                        IfCondition EqualTo(bad_u, 0) ThenBlock: {
                            hx = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
                            JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                            hv = JSJSON_HexVal(hx)
                            IfCondition LessThan(hv, 0) ThenBlock: {
                                bad_u = 1
                            }
                            cp = Add(Multiply(cp, 16), hv)
                        }
                        hi = Add(hi, 1)
                    }
                    IfCondition EqualTo(bad_u, 1) ThenBlock: {
                        ReturnValue(JSJSON_SetErr())
                    }
                    ch = cp
                    known = 1
                }
                IfCondition EqualTo(known, 0) ThenBlock: {
                    ReturnValue(JSJSON_SetErr())
                }
            }
            JSRT_StrSetUnit(buf, oi, ch)
            oi = Add(oi, 1)
        }
        ReturnValue(JSJSON_SetErr())
    }
}

Function.JSJSON_ParseNumber {
    Output: Address
    Body: {
        start = JSJSONPos.pos
        IfCondition GreaterEqual(JSJSONPos.pos, JSJSONPos.len) ThenBlock: {
            ReturnValue(JSJSON_SetErr())
        }
        ch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
        IfCondition EqualTo(ch, 45) ThenBlock: {
            JSJSONPos.pos = Add(JSJSONPos.pos, 1)
        }
        IfCondition GreaterEqual(JSJSONPos.pos, JSJSONPos.len) ThenBlock: {
            ReturnValue(JSJSON_SetErr())
        }
        ch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
        IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
            ReturnValue(JSJSON_SetErr())
        }
        IfCondition EqualTo(ch, 48) ThenBlock: {
            JSJSONPos.pos = Add(JSJSONPos.pos, 1)
            IfCondition LessThan(JSJSONPos.pos, JSJSONPos.len) ThenBlock: {
                nch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
                IfCondition And(GreaterEqual(nch, 48), LessEqual(nch, 57)) ThenBlock: {
                    ReturnValue(JSJSON_SetErr())
                }
            }
        } ElseBlock: {
            WhileLoop LessThan(JSJSONPos.pos, JSJSONPos.len) {
                ch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
                IfCondition LessThan(ch, 48) ThenBlock: { BreakLoop }
                IfCondition GreaterThan(ch, 57) ThenBlock: { BreakLoop }
                JSJSONPos.pos = Add(JSJSONPos.pos, 1)
            }
        }
        IfCondition LessThan(JSJSONPos.pos, JSJSONPos.len) ThenBlock: {
            ch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
            IfCondition EqualTo(ch, 46) ThenBlock: {
                JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                fd = 0
                WhileLoop LessThan(JSJSONPos.pos, JSJSONPos.len) {
                    ch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
                    IfCondition LessThan(ch, 48) ThenBlock: { BreakLoop }
                    IfCondition GreaterThan(ch, 57) ThenBlock: { BreakLoop }
                    JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                    fd = Add(fd, 1)
                }
                IfCondition EqualTo(fd, 0) ThenBlock: {
                    ReturnValue(JSJSON_SetErr())
                }
            }
        }
        IfCondition LessThan(JSJSONPos.pos, JSJSONPos.len) ThenBlock: {
            ch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
            IfCondition Or(EqualTo(ch, 101), EqualTo(ch, 69)) ThenBlock: {
                JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                IfCondition LessThan(JSJSONPos.pos, JSJSONPos.len) ThenBlock: {
                    sch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
                    IfCondition Or(EqualTo(sch, 45), EqualTo(sch, 43)) ThenBlock: {
                        JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                    }
                }
                ed = 0
                WhileLoop LessThan(JSJSONPos.pos, JSJSONPos.len) {
                    ch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
                    IfCondition LessThan(ch, 48) ThenBlock: { BreakLoop }
                    IfCondition GreaterThan(ch, 57) ThenBlock: { BreakLoop }
                    JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                    ed = Add(ed, 1)
                }
                IfCondition EqualTo(ed, 0) ThenBlock: {
                    ReturnValue(JSJSON_SetErr())
                }
            }
        }
        nlen = Subtract(JSJSONPos.pos, start)
        cbuf = JSRT__StrSlabAlloc(Add(nlen, 1))
        IfCondition EqualTo(cbuf, 0) ThenBlock: { ReturnValue(JSJSON_SetErr()) }
        i = 0
        WhileLoop LessThan(i, nlen) {
            u = JSRT_StrUnit(JSJSONPos.src, Add(start, i))
            IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
            WRMEM_8(cbuf, i, u)
            i = Add(i, 1)
        }
        WRMEM_8(cbuf, nlen, 0)
        jsv = JSRT_CreateString(cbuf)
        bits = JSRT_ToNumber(jsv)
        JSJSON_NoteSrc(start)
        ReturnValue(JSRT_CreateFloat(bits))
    }
}

Function.JSJSON_Eat {
    Input: kind: Integer
    Output: Integer
    Body: {
        save_k = kind
        n = 4
        IfCondition EqualTo(save_k, 2) ThenBlock: { n = 5 }
        IfCondition GreaterThan(Add(JSJSONPos.pos, n), JSJSONPos.len) ThenBlock: {
            ReturnValue(0)
        }
        c0 = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
        c1 = JSRT_StrUnit(JSJSONPos.src, Add(JSJSONPos.pos, 1))
        c2 = JSRT_StrUnit(JSJSONPos.src, Add(JSJSONPos.pos, 2))
        c3 = JSRT_StrUnit(JSJSONPos.src, Add(JSJSONPos.pos, 3))
        c4 = 0
        IfCondition EqualTo(n, 5) ThenBlock: {
            c4 = JSRT_StrUnit(JSJSONPos.src, Add(JSJSONPos.pos, 4))
        }
        ok = 0
        IfCondition EqualTo(save_k, 1) ThenBlock: {
            IfCondition And(EqualTo(c0, 116), And(EqualTo(c1, 114), And(EqualTo(c2, 117), EqualTo(c3, 101)))) ThenBlock: {
                ok = 1
            }
        }
        IfCondition EqualTo(save_k, 2) ThenBlock: {
            IfCondition And(EqualTo(c0, 102), And(EqualTo(c1, 97), And(EqualTo(c2, 108), And(EqualTo(c3, 115), EqualTo(c4, 101))))) ThenBlock: {
                ok = 1
            }
        }
        IfCondition EqualTo(save_k, 3) ThenBlock: {
            IfCondition And(EqualTo(c0, 110), And(EqualTo(c1, 117), And(EqualTo(c2, 108), EqualTo(c3, 108)))) ThenBlock: {
                ok = 1
            }
        }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        JSJSONPos.pos = Add(JSJSONPos.pos, n)
        ReturnValue(1)
    }
}

Function.JSJSON_ParseObject {
    Output: Address
    Body: {
        JSJSONPos.pos = Add(JSJSONPos.pos, 1)
        obj = JSRT_CreateObject()
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(JSJSON_SetErr()) }
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(obj, "__proto__", JSRTState.object_proto)
        }
        ch = JSJSON_SkipWS()
        IfCondition EqualTo(ch, 125) ThenBlock: {
            JSJSONPos.pos = Add(JSJSONPos.pos, 1)
            JSJSONPos.last_src = 0
            ReturnValue(obj)
        }
        WhileLoop LessThan(JSJSONPos.pos, JSJSONPos.len) {
            ch = JSJSON_SkipWS()
            IfCondition NotEqual(ch, 34) ThenBlock: {
                ReturnValue(JSJSON_SetErr())
            }
            JSRT__Push(obj)
            key_val = JSJSON_ParseString()
            obj = JSRT__Pop()
            IfCondition EqualTo(JSJSONPos.err, 1) ThenBlock: { ReturnValue(0) }
            key_ptr = JSRT_GetPayload(key_val)
            ch = JSJSON_SkipWS()
            IfCondition NotEqual(ch, 58) ThenBlock: {
                ReturnValue(JSJSON_SetErr())
            }
            JSJSONPos.pos = Add(JSJSONPos.pos, 1)
            JSRT__Push(obj)
            JSRT__Push(key_ptr)
            val = JSJSON_ParseValue()
            key_ptr = JSRT__Pop()
            obj = JSRT__Pop()
            IfCondition EqualTo(JSJSONPos.err, 1) ThenBlock: { ReturnValue(0) }
            key_c = JSRT_StrToC(key_ptr)
            IfCondition EqualTo(key_c, 0) ThenBlock: { key_c = key_ptr }
            JSRT_ObjSet(obj, key_c, val)
            JSJSON_KeepSrc(obj, key_c)
            ch = JSJSON_SkipWS()
            IfCondition EqualTo(ch, 125) ThenBlock: {
                JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                JSJSONPos.last_src = 0
                ReturnValue(obj)
            }
            IfCondition NotEqual(ch, 44) ThenBlock: {
                ReturnValue(JSJSON_SetErr())
            }
            JSJSONPos.pos = Add(JSJSONPos.pos, 1)
            ch = JSJSON_SkipWS()
            IfCondition EqualTo(ch, 125) ThenBlock: {
                ReturnValue(JSJSON_SetErr())
            }
        }
        ReturnValue(JSJSON_SetErr())
    }
}

Function.JSJSON_ParseArray {
    Output: Address
    Body: {
        JSJSONPos.pos = Add(JSJSONPos.pos, 1)
        arr = JSRT_CreateArray()
        IfCondition EqualTo(arr, 0) ThenBlock: { ReturnValue(JSJSON_SetErr()) }
        ch = JSJSON_SkipWS()
        IfCondition EqualTo(ch, 93) ThenBlock: {
            JSJSONPos.pos = Add(JSJSONPos.pos, 1)
            JSJSONPos.last_src = 0
            ReturnValue(arr)
        }
        idx = 0
        WhileLoop LessThan(JSJSONPos.pos, JSJSONPos.len) {
            JSRT__Push(arr)
            elem = JSJSON_ParseValue()
            arr = JSRT__Pop()
            IfCondition EqualTo(JSJSONPos.err, 1) ThenBlock: { ReturnValue(0) }
            JSRT_ArrPush(arr, elem)
            JSRT__Push(arr)
            // IntToStr's buffer is static. Copy it before the next index clobbers the key.
            cs = JSRT__IntToStr(idx)
            ks = JSRT_CreateString(cs)
            ck = JSRT_StrToC(JSRT_GetPayload(ks))
            arr = JSRT__Pop()
            JSJSON_KeepSrc(arr, ck)
            idx = Add(idx, 1)
            ch = JSJSON_SkipWS()
            IfCondition EqualTo(ch, 93) ThenBlock: {
                JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                JSJSONPos.last_src = 0
                ReturnValue(arr)
            }
            IfCondition NotEqual(ch, 44) ThenBlock: {
                ReturnValue(JSJSON_SetErr())
            }
            JSJSONPos.pos = Add(JSJSONPos.pos, 1)
            ch = JSJSON_SkipWS()
            IfCondition EqualTo(ch, 93) ThenBlock: {
                ReturnValue(JSJSON_SetErr())
            }
        }
        ReturnValue(JSJSON_SetErr())
    }
}

Function.JSJSON_ParseValue {
    Output: Address
    Body: {
        ch = JSJSON_SkipWS()
        start = JSJSONPos.pos
        IfCondition EqualTo(ch, 34) ThenBlock: {
            ReturnValue(JSJSON_ParseString())
        }
        IfCondition EqualTo(ch, 45) ThenBlock: { ReturnValue(JSJSON_ParseNumber()) }
        IfCondition GreaterEqual(ch, 48) ThenBlock: {
            IfCondition LessEqual(ch, 57) ThenBlock: { ReturnValue(JSJSON_ParseNumber()) }
        }
        IfCondition EqualTo(ch, 123) ThenBlock: { ReturnValue(JSJSON_ParseObject()) }
        IfCondition EqualTo(ch, 91) ThenBlock: { ReturnValue(JSJSON_ParseArray()) }
        IfCondition EqualTo(ch, 116) ThenBlock: {
            IfCondition EqualTo(JSJSON_Eat(1), 0) ThenBlock: {
                ReturnValue(JSJSON_SetErr())
            }
            JSJSON_NoteSrc(start)
            ReturnValue(JSRTState.true_val)
        }
        IfCondition EqualTo(ch, 102) ThenBlock: {
            IfCondition EqualTo(JSJSON_Eat(2), 0) ThenBlock: {
                ReturnValue(JSJSON_SetErr())
            }
            JSJSON_NoteSrc(start)
            ReturnValue(JSRTState.false_val)
        }
        IfCondition EqualTo(ch, 110) ThenBlock: {
            IfCondition EqualTo(JSJSON_Eat(3), 0) ThenBlock: {
                ReturnValue(JSJSON_SetErr())
            }
            JSJSON_NoteSrc(start)
            ReturnValue(JSRTState.null_val)
        }
        ReturnValue(JSJSON_SetErr())
    }
}

Function.JSJSON_ThrowSyntax {
    Output: Address
    Body: {
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        terr = JSVM_CreateTypedError("SyntaxError", "JSON.parse")
        JSVM__SetGlobal("__pend_exc__", terr)
        JSVMCall.exc_prop = 1
        JSVMCall.thrown_val = terr
        ReturnValue(JSRTState.undef_val)
    }
}

Function.JSJSON_ThrowType {
    Input: msg: Address
    Output: Address
    Body: {
        save_m = msg
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(0)
        }
        terr = JSVM_CreateTypedError("TypeError", save_m)
        JSVM__SetGlobal("__pend_exc__", terr)
        JSVMCall.exc_prop = 1
        JSVMCall.thrown_val = terr
        ReturnValue(0)
    }
}

Function.JSJSON_Abrupt {
    Output: Integer
    Body: {
        IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.JSJSON_PushState {
    Output: Integer
    Body: {
        JSRT__Push(JSJSONPos.pos)
        JSRT__Push(JSJSONPos.src)
        JSRT__Push(JSJSONPos.len)
        JSRT__Push(JSJSONPos.err)
        JSRT__Push(JSJSONPos.last_src)
        JSRT__Push(JSJSONPos.reviver)
        JSRT__Push(JSJSONPos.keep_src)
        JSRT__Push(JSJSONPos.gap)
        JSRT__Push(JSJSONPos.replacer)
        JSRT__Push(JSJSONPos.prop_list)
        JSRT__Push(JSJSONPos.stack)
        JSRT__Push(JSJSONPos.indent)
        ReturnValue(0)
    }
}

Function.JSJSON_PopState {
    Output: Integer
    Body: {
        JSJSONPos.indent = JSRT__Pop()
        JSJSONPos.stack = JSRT__Pop()
        JSJSONPos.prop_list = JSRT__Pop()
        JSJSONPos.replacer = JSRT__Pop()
        JSJSONPos.gap = JSRT__Pop()
        JSJSONPos.keep_src = JSRT__Pop()
        JSJSONPos.reviver = JSRT__Pop()
        JSJSONPos.last_src = JSRT__Pop()
        JSJSONPos.err = JSRT__Pop()
        JSJSONPos.len = JSRT__Pop()
        JSJSONPos.src = JSRT__Pop()
        JSJSONPos.pos = JSRT__Pop()
        ReturnValue(0)
    }
}

// Canonical integer index, or -1.
Function.JSJSON_IndexOf {
    Input: key: Address
    Output: Integer
    Body: {
        save_k = key
        sp = save_k
        IfCondition EqualTo(JSRT_GetType(save_k), JSType.STRING) ThenBlock: {
            sp = JSRT_GetPayload(save_k)
        }
        n = JSRT_StrLen(sp)
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        IfCondition GreaterThan(n, 10) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        IfCondition And(GreaterThan(n, 1), EqualTo(JSRT_StrUnit(sp, 0), 48)) ThenBlock: {
            ReturnValue(Subtract(0, 1))
        }
        acc = 0
        i = 0
        WhileLoop LessThan(i, n) {
            ch = JSRT_StrUnit(sp, i)
            IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                ReturnValue(Subtract(0, 1))
            }
            acc = Add(Multiply(acc, 10), Subtract(ch, 48))
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(acc, 4294967295) ThenBlock: {
            ReturnValue(Subtract(0, 1))
        }
        ReturnValue(acc)
    }
}

Function.JSJSON_OrderKeys {
    Input: keys: Address
    Output: Address
    Body: {
        save_ks = keys
        idxs = JSRT_CreateArray()
        strs = JSRT_CreateArray()
        n = JSRT_ArrLen(save_ks)
        i = 0
        WhileLoop LessThan(i, n) {
            JSRT__Push(idxs)
            JSRT__Push(strs)
            k = JSRT_ArrGet(save_ks, i)
            ix = JSJSON_IndexOf(k)
            strs = JSRT__Pop()
            idxs = JSRT__Pop()
            IfCondition GreaterEqual(ix, 0) ThenBlock: {
                JSRT__Push(strs)
                JSRT__Push(k)
                nv = JSRT_CreateNumber(ix)
                k = JSRT__Pop()
                strs = JSRT__Pop()
                JSRT_ArrPush(idxs, nv)
            } ElseBlock: {
                JSRT_ArrPush(strs, k)
            }
            i = Add(i, 1)
        }
        ni = JSRT_ArrLen(idxs)
        a = 1
        WhileLoop LessThan(a, ni) {
            v = JSRT_ArrGet(idxs, a)
            vn = JSRT_ToNumber(v)
            j = a
            WhileLoop GreaterThan(j, 0) {
                prev = JSRT_ArrGet(idxs, Subtract(j, 1))
                pn = JSRT_ToNumber(prev)
                IfCondition EqualTo(Float_Lt(pn, vn), 1) ThenBlock: { BreakLoop }
                IfCondition EqualTo(Float_Eq(pn, vn), 1) ThenBlock: { BreakLoop }
                JSRT_ArrSet(idxs, j, prev)
                j = Subtract(j, 1)
            }
            JSRT_ArrSet(idxs, j, v)
            a = Add(a, 1)
        }
        out = JSRT_CreateArray()
        a = 0
        WhileLoop LessThan(a, ni) {
            JSRT__Push(out)
            JSRT__Push(strs)
            v = JSRT_ArrGet(idxs, a)
            bits = JSRT_ToNumber(v)
            iv = Float_ToInt(bits)
            cs = JSRT__IntToStr(iv)
            sv = JSRT_CreateString(cs)
            strs = JSRT__Pop()
            out = JSRT__Pop()
            JSRT_ArrPush(out, sv)
            a = Add(a, 1)
        }
        ns = JSRT_ArrLen(strs)
        a = 0
        WhileLoop LessThan(a, ns) {
            JSRT__Push(out)
            sv = JSRT_ArrGet(strs, a)
            out = JSRT__Pop()
            JSRT_ArrPush(out, sv)
            a = Add(a, 1)
        }
        ReturnValue(out)
    }
}

Function.JSJSON_IsUndef {
    Input: v: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(v, JSRTState.undef_val) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(JSRT_GetType(v), JSType.UNDEFINED) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.JSJSON_ClassIs {
    Input: obj: Address
    Input: name: Address
    Output: Integer
    Body: {
        save_o = obj
        save_n = name
        cls = JSRT_ObjGet(save_o, "__class__")
        IfCondition NotEqual(JSRT_GetType(cls), JSType.STRING) ThenBlock: { ReturnValue(0) }
        sp = JSRT_GetPayload(cls)
        ReturnValue(JSRT_StrEq(sp, save_n))
    }
}

Function.JSJSON_Call0 {
    Input: fn: Address
    Input: recv: Address
    Output: Address
    Body: {
        save_fn = fn
        save_r = recv
        JSJSON_PushState()
        prev = JSVM__GetGlobal("this")
        JSVM__SetGlobal("this", save_r)
        rv = JSVM__CallFunc(save_fn, JSVMCallBuf.buf, 0)
        JSVM__SetGlobal("this", prev)
        JSJSON_PopState()
        ReturnValue(rv)
    }
}

Function.JSJSON_GetMeth {
    Input: obj: Address
    Input: name: Address
    Output: Address
    Body: {
        save_o = obj
        save_n = name
        m = JSVM__GetProperty(save_o, save_n)
        IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRT_GetType(m), JSType.FUNCTION) ThenBlock: { ReturnValue(m) }
        ReturnValue(0)
    }
}

Function.JSJSON_IsPrim {
    Input: v: Address
    Output: Integer
    Body: {
        t = JSRT_GetType(v)
        IfCondition EqualTo(t, JSType.OBJECT) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, JSType.ARRAY) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// hint 0: valueOf then toString. hint 1: toString then valueOf.
// Does not use JSRT_ToPrimitive, which returns a box's __value__ first.
Function.JSJSON_ToPrimBox {
    Input: obj: Address
    Input: hint: Integer
    Output: Address
    Body: {
        save_o = obj
        save_h = hint
        n1 = "toString"
        IfCondition EqualTo(save_h, 0) ThenBlock: { n1 = "valueOf" }
        m = JSJSON_GetMeth(save_o, n1)
        IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(m, 0) ThenBlock: {
            r = JSJSON_Call0(m, save_o)
            IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(JSJSON_IsPrim(r), 1) ThenBlock: { ReturnValue(r) }
        }
        n2 = "valueOf"
        IfCondition EqualTo(save_h, 0) ThenBlock: { n2 = "toString" }
        m = JSJSON_GetMeth(save_o, n2)
        IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(m, 0) ThenBlock: {
            r = JSJSON_Call0(m, save_o)
            IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(JSJSON_IsPrim(r), 1) ThenBlock: { ReturnValue(r) }
        }
        ReturnValue(JSJSON_ThrowType("Cannot convert object to primitive"))
    }
}

// BigInt.prototype.toJSON, invoking a getter with the bigint as this.
Function.JSJSON_BigIntToJSON {
    Input: bi: Address
    Output: Address
    Body: {
        save_b = bi
        ctor = JSVM__GetGlobal("BigInt")
        IfCondition NotEqual(JSRT_GetType(ctor), JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        proto = JSVM__GetProperty(ctor, "prototype")
        IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
        gk = JSBridge__MakeAccKey("toJSON", 0)
        IfCondition NotEqual(gk, 0) ThenBlock: {
            IfCondition EqualTo(JSRT_ObjHas(proto, gk), 1) ThenBlock: {
                g = JSRT_ObjGet(proto, gk)
                IfCondition EqualTo(JSRT_GetType(g), JSType.FUNCTION) ThenBlock: {
                    ReturnValue(JSJSON_Call0(g, save_b))
                }
            }
        }
        m = JSVM__GetProperty(proto, "toJSON")
        IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRT_GetType(m), JSType.FUNCTION) ThenBlock: { ReturnValue(m) }
        ReturnValue(0)
    }
}

Function.JSJSON_Call1 {
