// Library.JSJSON.ailang — Native JSON.parse / JSON.stringify for the JS engine
//
// Fork of the engine's JSON path (was inlined in Library.JSBridge). Uses
// JSRT UTF-16 string APIs (JSRT_StrLen / JSRT_StrUnit) — JS string payloads
// are magic-headered UTF-16, NOT C strings. The old GetByte/StringLength
// path always returned undefined.
//
// Outputs JSRT values (JSType.NUMBER/STRING/OBJECT/ARRAY/BOOLEAN/NULL).
// Does not use Library.JSON.ailang's JType tagged model (Ailang-native IPC).
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Arrays
LibraryImport.StringUtils
LibraryImport.Browser.JSRuntime

// Parse cursor over a JS string payload (UTF-16 code units)
FixedPool.JSJSONPos {
    "pos": Initialize=0
    "src": Initialize=0
    "len": Initialize=0
}

// ─── Cursor helpers ────────────────────────────────────────────────────────

Function.JSJSON_SkipWS {
    Output: Integer
    Body: {
        WhileLoop LessThan(JSJSONPos.pos, JSJSONPos.len) {
            ch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
            is_ws = 0
            IfCondition EqualTo(ch, 32) ThenBlock: { is_ws = 1 }
            IfCondition EqualTo(ch, 9) ThenBlock: { is_ws = 1 }
            IfCondition EqualTo(ch, 10) ThenBlock: { is_ws = 1 }
            IfCondition EqualTo(ch, 13) ThenBlock: { is_ws = 1 }
            IfCondition EqualTo(is_ws, 0) ThenBlock: { ReturnValue(ch) }
            JSJSONPos.pos = Add(JSJSONPos.pos, 1)
        }
        ReturnValue(0)
    }
}

// Hex digit → 0-15, or -1 if invalid
Function.JSJSON_HexVal {
    Input: ch: Integer
    Output: Integer
    Body: {
        save_ch = ch
        IfCondition And(GreaterEqual(save_ch, 48), LessEqual(save_ch, 57)) ThenBlock: {
            ReturnValue(Subtract(save_ch, 48))
        }
        IfCondition And(GreaterEqual(save_ch, 65), LessEqual(save_ch, 70)) ThenBlock: {
            ReturnValue(Add(Subtract(save_ch, 65), 10))
        }
        IfCondition And(GreaterEqual(save_ch, 97), LessEqual(save_ch, 102)) ThenBlock: {
            ReturnValue(Add(Subtract(save_ch, 97), 10))
        }
        ReturnValue(Subtract(0, 1))
    }
}

// ─── Parse string (pos at opening quote) ───────────────────────────────────

Function.JSJSON_ParseString {
    Output: Address
    Body: {
        // skip opening "
        JSJSONPos.pos = Add(JSJSONPos.pos, 1)
        // upper bound: remaining units
        rem = Subtract(JSJSONPos.len, JSJSONPos.pos)
        IfCondition LessThan(rem, 0) ThenBlock: { rem = 0 }
        buf = JSRT_StrAlloc(rem)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(JSRTState.undef_val) }
        oi = 0
        WhileLoop LessThan(JSJSONPos.pos, JSJSONPos.len) {
            ch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
            JSJSONPos.pos = Add(JSJSONPos.pos, 1)
            // closing quote
            IfCondition EqualTo(ch, 34) ThenBlock: {
                // shrink length to oi
                StoreValue(Add(buf, 8), oi)
                // trailing 0 unit
                JSRT_StrSetUnit(buf, oi, 0)
                val = JSRT__AllocValue()
                IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(JSRTState.undef_val) }
                StoreValue(val, JSType.STRING)
                StoreValue(Add(val, 8), buf)
                ReturnValue(val)
            }
            // escape
            IfCondition EqualTo(ch, 92) ThenBlock: {
                IfCondition GreaterEqual(JSJSONPos.pos, JSJSONPos.len) ThenBlock: {
                    ReturnValue(JSRTState.undef_val)
                }
                esc = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
                JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                IfCondition EqualTo(esc, 110) ThenBlock: { ch = 10 }
                IfCondition EqualTo(esc, 116) ThenBlock: { ch = 9 }
                IfCondition EqualTo(esc, 114) ThenBlock: { ch = 13 }
                IfCondition EqualTo(esc, 98) ThenBlock: { ch = 8 }
                IfCondition EqualTo(esc, 102) ThenBlock: { ch = 12 }
                IfCondition EqualTo(esc, 34) ThenBlock: { ch = 34 }
                IfCondition EqualTo(esc, 92) ThenBlock: { ch = 92 }
                IfCondition EqualTo(esc, 47) ThenBlock: { ch = 47 }
                // \uXXXX
                IfCondition EqualTo(esc, 117) ThenBlock: {
                    cp = 0
                    hi = 0
                    WhileLoop LessThan(hi, 4) {
                        IfCondition GreaterEqual(JSJSONPos.pos, JSJSONPos.len) ThenBlock: {
                            ReturnValue(JSRTState.undef_val)
                        }
                        hx = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
                        JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                        hv = JSJSON_HexVal(hx)
                        IfCondition LessThan(hv, 0) ThenBlock: {
                            ReturnValue(JSRTState.undef_val)
                        }
                        cp = Add(Multiply(cp, 16), hv)
                        hi = Add(hi, 1)
                    }
                    ch = cp
                }
            }
            JSRT_StrSetUnit(buf, oi, ch)
            oi = Add(oi, 1)
        }
        // unclosed string
        ReturnValue(JSRTState.undef_val)
    }
}

// ─── Parse number (pos at first digit or minus) ────────────────────────────
// Collect the number lexeme as a C string and use JSRT_ToNumber for correct
// IEEE-754 results (scientific notation must match engine number literals).

Function.JSJSON_ParseNumber {
    Output: Address
    Body: {
        start = JSJSONPos.pos
        ch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
        IfCondition EqualTo(ch, 45) ThenBlock: {
            JSJSONPos.pos = Add(JSJSONPos.pos, 1)
        }
        // integer digits
        digs = 0
        WhileLoop LessThan(JSJSONPos.pos, JSJSONPos.len) {
            ch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
            IfCondition LessThan(ch, 48) ThenBlock: { BreakLoop }
            IfCondition GreaterThan(ch, 57) ThenBlock: { BreakLoop }
            JSJSONPos.pos = Add(JSJSONPos.pos, 1)
            digs = Add(digs, 1)
        }
        IfCondition EqualTo(digs, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        // fraction
        IfCondition LessThan(JSJSONPos.pos, JSJSONPos.len) ThenBlock: {
            ch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
            IfCondition EqualTo(ch, 46) ThenBlock: {
                JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                WhileLoop LessThan(JSJSONPos.pos, JSJSONPos.len) {
                    ch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
                    IfCondition LessThan(ch, 48) ThenBlock: { BreakLoop }
                    IfCondition GreaterThan(ch, 57) ThenBlock: { BreakLoop }
                    JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                }
            }
        }
        // exponent
        IfCondition LessThan(JSJSONPos.pos, JSJSONPos.len) ThenBlock: {
            ch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
            IfCondition Or(EqualTo(ch, 101), EqualTo(ch, 69)) ThenBlock: {
                JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                IfCondition LessThan(JSJSONPos.pos, JSJSONPos.len) ThenBlock: {
                    sch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
                    IfCondition Or(EqualTo(sch, 45), EqualTo(sch, 43)) ThenBlock: {
                        JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                    }
                }
                WhileLoop LessThan(JSJSONPos.pos, JSJSONPos.len) {
                    ch = JSRT_StrUnit(JSJSONPos.src, JSJSONPos.pos)
                    IfCondition LessThan(ch, 48) ThenBlock: { BreakLoop }
                    IfCondition GreaterThan(ch, 57) ThenBlock: { BreakLoop }
                    JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                }
            }
        }
        // Build C string of the lexeme [start, pos)
        nlen = Subtract(JSJSONPos.pos, start)
        cbuf = JSRT__StrSlabAlloc(Add(nlen, 1))
        IfCondition EqualTo(cbuf, 0) ThenBlock: { ReturnValue(JSRTState.undef_val) }
        i = 0
        WhileLoop LessThan(i, nlen) {
            u = JSRT_StrUnit(JSJSONPos.src, Add(start, i))
            IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
            SetByte(cbuf, i, u)
            i = Add(i, 1)
        }
        SetByte(cbuf, nlen, 0)
        // Convert via engine ToNumber (IEEE-754 bits) then box as NUMBER
        jsv = JSRT_CreateString(cbuf)
        bits = JSRT_ToNumber(jsv)
        ReturnValue(JSRT_CreateFloat(bits))
    }
}

// ─── Parse object / array / value ──────────────────────────────────────────

Function.JSJSON_ParseObject {
    Output: Address
    Body: {
        // skip '{'
        JSJSONPos.pos = Add(JSJSONPos.pos, 1)
        obj = JSRT_CreateObject()
        // Ordinary objects from JSON.parse get [[Prototype]] = Object.prototype
        // (JSRT_CreateObject intentionally does not — Object.prototype is itself
        // created that way and must not self-link.)
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(obj, "__proto__", JSRTState.object_proto)
        }
        ch = JSJSON_SkipWS()
        IfCondition EqualTo(ch, 125) ThenBlock: {
            JSJSONPos.pos = Add(JSJSONPos.pos, 1)
            ReturnValue(obj)
        }
        WhileLoop LessThan(JSJSONPos.pos, JSJSONPos.len) {
            JSJSON_SkipWS()
            // key must be string
            JSRT__Push(obj)
            key_val = JSJSON_ParseString()
            obj = JSRT__Pop()
            IfCondition EqualTo(JSRT_GetType(key_val), JSType.UNDEFINED) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            key_ptr = JSRT_GetPayload(key_val)
            // colon
            JSJSON_SkipWS()
            JSJSONPos.pos = Add(JSJSONPos.pos, 1)
            JSRT__Push(obj)
            JSRT__Push(key_ptr)
            val = JSJSON_ParseValue()
            key_ptr = JSRT__Pop()
            obj = JSRT__Pop()
            // ObjSet needs C key for property table — convert JS string key
            key_c = JSRT_StrToC(key_ptr)
            IfCondition EqualTo(key_c, 0) ThenBlock: {
                // fallback: try payload as C if not JS string
                key_c = key_ptr
            }
            JSRT_ObjSet(obj, key_c, val)
            ch = JSJSON_SkipWS()
            IfCondition EqualTo(ch, 125) ThenBlock: {
                JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                ReturnValue(obj)
            }
            IfCondition EqualTo(ch, 44) ThenBlock: {
                JSJSONPos.pos = Add(JSJSONPos.pos, 1)
            } ElseBlock: {
                ReturnValue(obj)
            }
        }
        ReturnValue(obj)
    }
}

Function.JSJSON_ParseArray {
    Output: Address
    Body: {
        JSJSONPos.pos = Add(JSJSONPos.pos, 1)
        arr = JSRT_CreateArray()
        ch = JSJSON_SkipWS()
        IfCondition EqualTo(ch, 93) ThenBlock: {
            JSJSONPos.pos = Add(JSJSONPos.pos, 1)
            ReturnValue(arr)
        }
        WhileLoop LessThan(JSJSONPos.pos, JSJSONPos.len) {
            JSRT__Push(arr)
            elem = JSJSON_ParseValue()
            arr = JSRT__Pop()
            JSRT_ArrPush(arr, elem)
            ch = JSJSON_SkipWS()
            IfCondition EqualTo(ch, 93) ThenBlock: {
                JSJSONPos.pos = Add(JSJSONPos.pos, 1)
                ReturnValue(arr)
            }
            IfCondition EqualTo(ch, 44) ThenBlock: {
                JSJSONPos.pos = Add(JSJSONPos.pos, 1)
            } ElseBlock: {
                ReturnValue(arr)
            }
        }
        ReturnValue(arr)
    }
}

Function.JSJSON_ParseValue {
    Output: Address
    Body: {
        ch = JSJSON_SkipWS()
        // string
        IfCondition EqualTo(ch, 34) ThenBlock: {
            ReturnValue(JSJSON_ParseString())
        }
        // number
        IfCondition EqualTo(ch, 45) ThenBlock: { ReturnValue(JSJSON_ParseNumber()) }
        IfCondition GreaterEqual(ch, 48) ThenBlock: {
            IfCondition LessEqual(ch, 57) ThenBlock: { ReturnValue(JSJSON_ParseNumber()) }
        }
        // object
        IfCondition EqualTo(ch, 123) ThenBlock: { ReturnValue(JSJSON_ParseObject()) }
        // array
        IfCondition EqualTo(ch, 91) ThenBlock: { ReturnValue(JSJSON_ParseArray()) }
        // true
        IfCondition EqualTo(ch, 116) ThenBlock: {
            // verify t-r-u-e
            JSJSONPos.pos = Add(JSJSONPos.pos, 4)
            ReturnValue(JSRTState.true_val)
        }
        // false
        IfCondition EqualTo(ch, 102) ThenBlock: {
            JSJSONPos.pos = Add(JSJSONPos.pos, 5)
            ReturnValue(JSRTState.false_val)
        }
        // null
        IfCondition EqualTo(ch, 110) ThenBlock: {
            JSJSONPos.pos = Add(JSJSONPos.pos, 4)
            ReturnValue(JSRTState.null_val)
        }
        ReturnValue(JSRTState.undef_val)
    }
}

// Public: parse a JS string value (or anything ToString-able) → JS value
Function.JSJSON_Parse {
    Input: js_str_val: Address
    Output: Address
    Body: {
        save_val = js_str_val
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(JSRTState.undef_val) }
        // Ensure string
        str_val = save_val
        IfCondition NotEqual(JSRT_GetType(save_val), JSType.STRING) ThenBlock: {
            str_val = JSRT_ToString(save_val)
        }
        src = JSRT_GetPayload(str_val)
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(JSRTState.undef_val) }
        JSJSONPos.src = src
        JSJSONPos.pos = 0
        JSJSONPos.len = JSRT_StrLen(src)
        ReturnValue(JSJSON_ParseValue())
    }
}

// Stringify stays in Library.JSBridge (already correct for JSRT values).
// Callers use JSBridge__JSONStringify until a full move is needed.
