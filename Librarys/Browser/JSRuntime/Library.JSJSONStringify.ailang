// Library.JSJSONStringify.ailang
// Stringify half of JSON. Pool JSJSONPos stays on Library.JSJSON.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Arrays
LibraryImport.StringUtils
LibraryImport.Browser.JSRuntime

// ─── Stringify ─────────────────────────────────────────────────────────────

Function.JSJSON_HexChar {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        IfCondition LessThan(save_n, 10) ThenBlock: {
            ReturnValue(Add(48, save_n))
        }
        ReturnValue(Add(87, save_n))
    }
}

Function.JSJSON_EmitU {
    Input: buf: Address
    Input: oi: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        save_b = buf
        save_o = oi
        save_c = ch
        JSRT_StrSetUnit(save_b, save_o, 92)
        save_o = Add(save_o, 1)
        JSRT_StrSetUnit(save_b, save_o, 117)
        save_o = Add(save_o, 1)
        h3 = Divide(save_c, 4096)
        save_c = Subtract(save_c, Multiply(h3, 4096))
        h2 = Divide(save_c, 256)
        save_c = Subtract(save_c, Multiply(h2, 256))
        h1 = Divide(save_c, 16)
        h0 = Subtract(save_c, Multiply(h1, 16))
        JSRT_StrSetUnit(save_b, save_o, JSJSON_HexChar(h3))
        save_o = Add(save_o, 1)
        JSRT_StrSetUnit(save_b, save_o, JSJSON_HexChar(h2))
        save_o = Add(save_o, 1)
        JSRT_StrSetUnit(save_b, save_o, JSJSON_HexChar(h1))
        save_o = Add(save_o, 1)
        JSRT_StrSetUnit(save_b, save_o, JSJSON_HexChar(h0))
        save_o = Add(save_o, 1)
        ReturnValue(save_o)
    }
}

Function.JSJSON_Quote {
    Input: sv: Address
    Output: Address
    Body: {
        save_sv = sv
        sp = JSRT_GetPayload(save_sv)
        n = JSRT_StrLen(sp)
        cap = Add(2, Multiply(n, 6))
        buf = JSRT_StrAlloc(cap)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(JSRT_CreateString("\"\"")) }
        oi = 0
        JSRT_StrSetUnit(buf, oi, 34)
        oi = Add(oi, 1)
        i = 0
        WhileLoop LessThan(i, n) {
            ch = JSRT_StrUnit(sp, i)
            IfCondition EqualTo(ch, 34) ThenBlock: {
                JSRT_StrSetUnit(buf, oi, 92)
                oi = Add(oi, 1)
                JSRT_StrSetUnit(buf, oi, 34)
                oi = Add(oi, 1)
            } ElseBlock: {
                IfCondition EqualTo(ch, 92) ThenBlock: {
                    JSRT_StrSetUnit(buf, oi, 92)
                    oi = Add(oi, 1)
                    JSRT_StrSetUnit(buf, oi, 92)
                    oi = Add(oi, 1)
                } ElseBlock: {
                    IfCondition EqualTo(ch, 8) ThenBlock: {
                        JSRT_StrSetUnit(buf, oi, 92)
                        oi = Add(oi, 1)
                        JSRT_StrSetUnit(buf, oi, 98)
                        oi = Add(oi, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(ch, 9) ThenBlock: {
                            JSRT_StrSetUnit(buf, oi, 92)
                            oi = Add(oi, 1)
                            JSRT_StrSetUnit(buf, oi, 116)
                            oi = Add(oi, 1)
                        } ElseBlock: {
                            IfCondition EqualTo(ch, 10) ThenBlock: {
                                JSRT_StrSetUnit(buf, oi, 92)
                                oi = Add(oi, 1)
                                JSRT_StrSetUnit(buf, oi, 110)
                                oi = Add(oi, 1)
                            } ElseBlock: {
                                IfCondition EqualTo(ch, 12) ThenBlock: {
                                    JSRT_StrSetUnit(buf, oi, 92)
                                    oi = Add(oi, 1)
                                    JSRT_StrSetUnit(buf, oi, 102)
                                    oi = Add(oi, 1)
                                } ElseBlock: {
                                    IfCondition EqualTo(ch, 13) ThenBlock: {
                                        JSRT_StrSetUnit(buf, oi, 92)
                                        oi = Add(oi, 1)
                                        JSRT_StrSetUnit(buf, oi, 114)
                                        oi = Add(oi, 1)
                                    } ElseBlock: {
                                        IfCondition LessThan(ch, 32) ThenBlock: {
                                            JSRT_StrSetUnit(buf, oi, 92)
                                            oi = Add(oi, 1)
                                            JSRT_StrSetUnit(buf, oi, 117)
                                            oi = Add(oi, 1)
                                            JSRT_StrSetUnit(buf, oi, 48)
                                            oi = Add(oi, 1)
                                            JSRT_StrSetUnit(buf, oi, 48)
                                            oi = Add(oi, 1)
                                            hi = Divide(ch, 16)
                                            lo = Subtract(ch, Multiply(hi, 16))
                                            JSRT_StrSetUnit(buf, oi, JSJSON_HexChar(hi))
                                            oi = Add(oi, 1)
                                            JSRT_StrSetUnit(buf, oi, JSJSON_HexChar(lo))
                                            oi = Add(oi, 1)
                                        } ElseBlock: {
                                            paired = 0
                                            IfCondition And(GreaterEqual(ch, 55296), LessEqual(ch, 56319)) ThenBlock: {
                                                IfCondition LessThan(Add(i, 1), n) ThenBlock: {
                                                    nx = JSRT_StrUnit(sp, Add(i, 1))
                                                    IfCondition And(GreaterEqual(nx, 56320), LessEqual(nx, 57343)) ThenBlock: {
                                                        paired = 1
                                                    }
                                                }
                                            }
                                            lone = 0
                                            IfCondition EqualTo(paired, 0) ThenBlock: {
                                                IfCondition And(GreaterEqual(ch, 55296), LessEqual(ch, 57343)) ThenBlock: {
                                                    lone = 1
                                                }
                                            }
                                            IfCondition EqualTo(paired, 1) ThenBlock: {
                                                JSRT_StrSetUnit(buf, oi, ch)
                                                oi = Add(oi, 1)
                                                i = Add(i, 1)
                                                ch = JSRT_StrUnit(sp, i)
                                                JSRT_StrSetUnit(buf, oi, ch)
                                                oi = Add(oi, 1)
                                            } ElseBlock: {
                                                IfCondition EqualTo(lone, 1) ThenBlock: {
                                                    oi = JSJSON_EmitU(buf, oi, ch)
                                                } ElseBlock: {
                                                    JSRT_StrSetUnit(buf, oi, ch)
                                                    oi = Add(oi, 1)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        JSRT_StrSetUnit(buf, oi, 34)
        oi = Add(oi, 1)
        WRMEM_64(buf, 8, oi)
        JSRT_StrSetUnit(buf, oi, 0)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(JSRT_CreateString("\"\"")) }
        WRMEM_64(val, JSType.STRING)
        WRMEM_64(val, 8, buf)
        ReturnValue(val)
    }
}

Function.JSJSON_GapJoin {
    Input: left: Address
    Input: right: Address
    Output: Address
    Body: {
        lp = JSRT_GetPayload(left)
        rp = right
        IfCondition EqualTo(JSRT_GetType(right), JSType.STRING) ThenBlock: {
            rp = JSRT_GetPayload(right)
        }
        ReturnValue(JSRT__StrConcat(lp, rp))
    }
}

Function.JSJSON_Seen {
    Input: obj: Address
    Output: Integer
    Body: {
        save_o = obj
        st = JSJSONPos.stack
        IfCondition NotEqual(JSRT_GetType(st), JSType.ARRAY) ThenBlock: { ReturnValue(0) }
        n = JSRT_ArrLen(st)
        op = 0
        IfCondition NotEqual(save_o, 0) ThenBlock: {
            op = RDMEM_64(save_o, 8)
        }
        IfCondition EqualTo(op, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n) {
            got = JSRT_ArrGet(st, i)
            gp = 0
            IfCondition NotEqual(got, 0) ThenBlock: {
                IfCondition NotEqual(got, JSRTState.undef_val) ThenBlock: {
                    gp = RDMEM_64(got, 8)
                }
            }
            // ArrPush copies the value header. The payload pointer is the identity.
            IfCondition EqualTo(gp, op) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.JSJSON_PushSeen {
    Input: obj: Address
    Output: Integer
    Body: {
        st = JSJSONPos.stack
        IfCondition NotEqual(JSRT_GetType(st), JSType.ARRAY) ThenBlock: {
            st = JSRT_CreateArray()
            JSJSONPos.stack = st
        }
        JSRT_ArrPush(st, obj)
        ReturnValue(JSRT_ArrLen(st))
    }
}

Function.JSJSON_PopSeen {
    Input: n: Integer
    Output: Integer
    Body: {
        st = JSJSONPos.stack
        IfCondition EqualTo(JSRT_GetType(st), JSType.ARRAY) ThenBlock: {
            JSRT_ArrSetLen(st, n)
        }
        ReturnValue(0)
    }
}

Function.JSJSON_IsFiniteNum {
    Input: sv: Address
    Output: Integer
    Body: {
        sp = JSRT_GetPayload(sv)
        IfCondition EqualTo(JSRT_StrEq(sp, "NaN"), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRT_StrEq(sp, "Infinity"), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRT_StrEq(sp, "-Infinity"), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.JSJSON_ListHas {
    Input: list: Address
    Input: item: Address
    Output: Integer
    Body: {
        save_l = list
        save_i = item
        ip = JSRT_GetPayload(save_i)
        n = JSRT_ArrLen(save_l)
        i = 0
        WhileLoop LessThan(i, n) {
            e = JSRT_ArrGet(save_l, i)
            IfCondition EqualTo(JSRT_StrEq(JSRT_GetPayload(e), ip), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.JSJSON_BuildList {
    Input: arr: Address
    Output: Address
    Body: {
        save_a = arr
        list = JSRT_CreateArray()
        n = JSRT_ArrLen(save_a)
        i = 0
        WhileLoop LessThan(i, n) {
            JSRT__Push(list)
            v = JSRT_ArrGet(save_a, i)
            list = JSRT__Pop()
            item = 0
            t = JSRT_GetType(v)
            IfCondition EqualTo(t, JSType.STRING) ThenBlock: { item = v }
            IfCondition EqualTo(t, JSType.NUMBER) ThenBlock: { item = JSRT_ToString(v) }
            IfCondition EqualTo(t, JSType.OBJECT) ThenBlock: {
                boxed = 0
                IfCondition EqualTo(JSJSON_ClassIs(v, "Number"), 1) ThenBlock: { boxed = 1 }
                IfCondition EqualTo(JSJSON_ClassIs(v, "String"), 1) ThenBlock: { boxed = 1 }
                IfCondition EqualTo(boxed, 1) ThenBlock: {
                    JSRT__Push(list)
                    prim = JSJSON_ToPrimBox(v, 1)
                    list = JSRT__Pop()
                    IfCondition EqualTo(JSJSON_Abrupt(), 0) ThenBlock: {
                        item = JSRT_ToString(prim)
                    }
                }
            }
            IfCondition NotEqual(item, 0) ThenBlock: {
                IfCondition EqualTo(JSJSON_ListHas(list, item), 0) ThenBlock: {
                    JSRT_ArrPush(list, item)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(list)
    }
}

Function.JSJSON_MakeGap {
    Input: space: Address
    Output: Address
    Body: {
        save_s = space
        t = JSRT_GetType(save_s)
        IfCondition EqualTo(t, JSType.OBJECT) ThenBlock: {
            IfCondition EqualTo(JSJSON_ClassIs(save_s, "Number"), 1) ThenBlock: {
                prim = JSJSON_ToPrimBox(save_s, 0)
                IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
                bits = JSRT_ToNumber(prim)
                IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
                save_s = JSRT_CreateFloat(bits)
                t = JSType.NUMBER
            } ElseBlock: {
                IfCondition EqualTo(JSJSON_ClassIs(save_s, "String"), 1) ThenBlock: {
                    prim = JSJSON_ToPrimBox(save_s, 1)
                    IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
                    save_s = JSRT_ToString(prim)
                    IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
                    t = JSType.STRING
                }
            }
        }
        IfCondition EqualTo(t, JSType.NUMBER) ThenBlock: {
            ns = JSRT_ToString(save_s)
            IfCondition EqualTo(JSJSON_IsFiniteNum(ns), 0) ThenBlock: {
                IfCondition EqualTo(JSRT_StrEq(JSRT_GetPayload(ns), "Infinity"), 1) ThenBlock: {
                    save_s = JSRT_CreateNumber(10)
                } ElseBlock: {
                    ReturnValue(JSRT_CreateString(""))
                }
            }
            bits = JSRT_ToNumber(save_s)
            nsp = Float_ToInt(bits)
            IfCondition GreaterThan(nsp, 10) ThenBlock: { nsp = 10 }
            IfCondition LessThan(nsp, 1) ThenBlock: {
                ReturnValue(JSRT_CreateString(""))
            }
            buf = JSRT_StrAlloc(nsp)
            i = 0
            WhileLoop LessThan(i, nsp) {
                JSRT_StrSetUnit(buf, i, 32)
                i = Add(i, 1)
            }
            val = JSRT__AllocValue()
            WRMEM_64(val, JSType.STRING)
            WRMEM_64(val, 8, buf)
            ReturnValue(val)
        }
        IfCondition EqualTo(t, JSType.STRING) ThenBlock: {
            sp = JSRT_GetPayload(save_s)
            n = JSRT_StrLen(sp)
            IfCondition GreaterThan(n, 10) ThenBlock: { n = 10 }
            IfCondition EqualTo(n, 0) ThenBlock: {
                ReturnValue(JSRT_CreateString(""))
            }
            ReturnValue(JSRT_CreateStringSlice(sp, 0, n))
        }
        ReturnValue(JSRT_CreateString(""))
    }
}

Function.JSJSON_Serialize {
    Input: key: Address
    Input: holder: Address
    Output: Address
    Body: {
        save_k = key
        save_h = holder
        sp = save_k
        IfCondition EqualTo(JSRT_GetType(save_k), JSType.STRING) ThenBlock: {
            sp = JSRT_GetPayload(save_k)
        }
        val = JSVM__GetProperty(save_h, sp)
        IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
        vt = JSRT_GetType(val)
        is_obj = 0
        IfCondition EqualTo(vt, JSType.OBJECT) ThenBlock: { is_obj = 1 }
        IfCondition EqualTo(vt, JSType.ARRAY) ThenBlock: { is_obj = 1 }
        IfCondition EqualTo(vt, JSType.BIGINT) ThenBlock: { is_obj = 1 }
        IfCondition EqualTo(is_obj, 1) ThenBlock: {
            IfCondition EqualTo(vt, JSType.BIGINT) ThenBlock: {
                JSRT__Push(save_h)
                JSRT__Push(save_k)
                JSRT__Push(val)
                tj = JSJSON_BigIntToJSON(val)
                val = JSRT__Pop()
                save_k = JSRT__Pop()
                save_h = JSRT__Pop()
            } ElseBlock: {
                tj = JSVM__GetProperty(val, "toJSON")
            }
            IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(JSRT_GetType(tj), JSType.FUNCTION) ThenBlock: {
                JSRT__Push(save_h)
                JSRT__Push(save_k)
                val = JSJSON_Call1(tj, val, save_k)
                save_k = JSRT__Pop()
                save_h = JSRT__Pop()
                IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
            }
        }
        rep = JSJSONPos.replacer
        IfCondition EqualTo(JSRT_GetType(rep), JSType.FUNCTION) ThenBlock: {
            JSRT__Push(save_h)
            JSRT__Push(save_k)
            val = JSJSON_Call2(rep, save_h, save_k, val)
            save_k = JSRT__Pop()
            save_h = JSRT__Pop()
            IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
        }
        vt = JSRT_GetType(val)
        IfCondition EqualTo(vt, JSType.OBJECT) ThenBlock: {
            IfCondition EqualTo(JSJSON_ClassIs(val, "Number"), 1) ThenBlock: {
                JSRT__Push(save_h)
                JSRT__Push(save_k)
                prim = JSJSON_ToPrimBox(val, 0)
                save_k = JSRT__Pop()
                save_h = JSRT__Pop()
                IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
                bits = JSRT_ToNumber(prim)
                IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
                val = JSRT_CreateFloat(bits)
                vt = JSType.NUMBER
            } ElseBlock: {
                IfCondition EqualTo(JSJSON_ClassIs(val, "String"), 1) ThenBlock: {
                    JSRT__Push(save_h)
                    JSRT__Push(save_k)
                    prim = JSJSON_ToPrimBox(val, 1)
                    save_k = JSRT__Pop()
                    save_h = JSRT__Pop()
                    IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
                    val = JSRT_ToString(prim)
                    IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: { ReturnValue(0) }
                    vt = JSType.STRING
                } ElseBlock: {
                    IfCondition EqualTo(JSJSON_ClassIs(val, "Boolean"), 1) ThenBlock: {
                        val = JSRT_ObjGet(val, "__value__")
                        vt = JSRT_GetType(val)
                    } ElseBlock: {
                        IfCondition EqualTo(JSJSON_ClassIs(val, "BigInt"), 1) ThenBlock: {
                            ReturnValue(JSJSON_ThrowType("Do not know how to serialize a BigInt"))
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(JSJSON_IsUndef(val), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRT_GetType(val), JSType.NULL) ThenBlock: {
            ReturnValue(JSRT_CreateString("null"))
        }
        IfCondition EqualTo(JSRT_GetType(val), JSType.BOOLEAN) ThenBlock: {
            IfCondition EqualTo(RDMEM_64(val, 8), 0) ThenBlock: {
                ReturnValue(JSRT_CreateString("false"))
            }
            ReturnValue(JSRT_CreateString("true"))
        }
        IfCondition EqualTo(JSRT_GetType(val), JSType.STRING) ThenBlock: {
            ReturnValue(JSJSON_Quote(val))
        }
        IfCondition EqualTo(JSRT_GetType(val), JSType.NUMBER) ThenBlock: {
            ns = JSRT_ToString(val)
            IfCondition EqualTo(JSJSON_IsFiniteNum(ns), 0) ThenBlock: {
                ReturnValue(JSRT_CreateString("null"))
            }
            ReturnValue(ns)
        }
        IfCondition EqualTo(JSRT_GetType(val), JSType.BIGINT) ThenBlock: {
            ReturnValue(JSJSON_ThrowType("Do not know how to serialize a BigInt"))
        }
        IfCondition EqualTo(JSVM_IsPrimSymbol(val), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRT_GetType(val), JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        vt = JSRT_GetType(val)
        IfCondition GreaterThan(JSRT_ArrLen(JSJSONPos.stack), 64) ThenBlock: {
            ReturnValue(JSJSON_ThrowType("Converting circular structure to JSON"))
        }
        IfCondition EqualTo(JSJSON_Seen(val), 1) ThenBlock: {
            ReturnValue(JSJSON_ThrowType("Converting circular structure to JSON"))
        }
        depth = JSJSON_PushSeen(val)
        step = JSJSONPos.indent
        gapv = JSJSONPos.gap
        gap_n = 0
        IfCondition EqualTo(JSRT_GetType(gapv), JSType.STRING) ThenBlock: {
            gap_n = JSRT_StrLen(JSRT_GetPayload(gapv))
        }
        IfCondition GreaterThan(gap_n, 0) ThenBlock: {
            JSRT__Push(val)
            JSRT__Push(step)
            ind = JSJSON_GapJoin(step, gapv)
            step = JSRT__Pop()
            val = JSRT__Pop()
            JSJSONPos.indent = ind
        }
        IfCondition EqualTo(vt, JSType.ARRAY) ThenBlock: {
            alen = JSRT_ArrLen(val)
            parts = JSRT_CreateString("")
            ai = 0
            any = 0
            WhileLoop LessThan(ai, alen) {
                JSRT__Push(val)
                JSRT__Push(parts)
                JSRT__Push(step)
                cs = JSRT__IntToStr(ai)
                nm = JSRT_CreateString(cs)
                step = JSRT__Pop()
                parts = JSRT__Pop()
                val = JSRT__Pop()
                JSRT__Push(val)
                JSRT__Push(parts)
                JSRT__Push(step)
                piece = JSJSON_Serialize(nm, val)
                step = JSRT__Pop()
                parts = JSRT__Pop()
                val = JSRT__Pop()
                IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: {
                    JSJSON_PopSeen(Subtract(depth, 1))
                    JSJSONPos.indent = step
                    ReturnValue(0)
                }
                IfCondition EqualTo(piece, 0) ThenBlock: {
                    piece = JSRT_CreateString("null")
                }
                IfCondition EqualTo(any, 1) ThenBlock: {
                    parts = JSJSON_GapJoin(parts, ",")
                }
                IfCondition GreaterThan(gap_n, 0) ThenBlock: {
                    parts = JSJSON_GapJoin(parts, "\n")
                    parts = JSJSON_GapJoin(parts, JSJSONPos.indent)
                }
                parts = JSJSON_GapJoin(parts, piece)
                any = 1
                ai = Add(ai, 1)
            }
            JSJSON_PopSeen(Subtract(depth, 1))
            JSJSONPos.indent = step
            IfCondition EqualTo(any, 0) ThenBlock: {
                ReturnValue(JSRT_CreateString("[]"))
            }
            IfCondition GreaterThan(gap_n, 0) ThenBlock: {
                parts = JSJSON_GapJoin(parts, "\n")
                parts = JSJSON_GapJoin(parts, step)
            }
            openb = JSRT_CreateString("[")
            parts = JSJSON_GapJoin(openb, parts)
            ReturnValue(JSJSON_GapJoin(parts, "]"))
        }
        keys = 0
        plist = JSJSONPos.prop_list
        IfCondition EqualTo(JSRT_GetType(plist), JSType.ARRAY) ThenBlock: {
            keys = plist
        } ElseBlock: {
            JSRT__Push(val)
            JSRT__Push(step)
            keys = JSJSON_OrderKeys(JSRT_ObjKeys(val))
            step = JSRT__Pop()
            val = JSRT__Pop()
        }
        kn = JSRT_ArrLen(keys)
        parts = JSRT_CreateString("")
        ki = 0
        any = 0
        WhileLoop LessThan(ki, kn) {
            JSRT__Push(val)
            JSRT__Push(parts)
            JSRT__Push(step)
            JSRT__Push(keys)
            km = JSRT_ArrGet(keys, ki)
            keys = JSRT__Pop()
            step = JSRT__Pop()
            parts = JSRT__Pop()
            val = JSRT__Pop()
            JSRT__Push(val)
            JSRT__Push(parts)
            JSRT__Push(step)
            JSRT__Push(keys)
            JSRT__Push(km)
            piece = JSJSON_Serialize(km, val)
            km = JSRT__Pop()
            keys = JSRT__Pop()
            step = JSRT__Pop()
            parts = JSRT__Pop()
            val = JSRT__Pop()
            IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: {
                JSJSON_PopSeen(Subtract(depth, 1))
                JSJSONPos.indent = step
                ReturnValue(0)
            }
            IfCondition NotEqual(piece, 0) ThenBlock: {
                qk = JSJSON_Quote(km)
                IfCondition EqualTo(any, 1) ThenBlock: {
                    parts = JSJSON_GapJoin(parts, ",")
                }
                IfCondition GreaterThan(gap_n, 0) ThenBlock: {
                    parts = JSJSON_GapJoin(parts, "\n")
                    parts = JSJSON_GapJoin(parts, JSJSONPos.indent)
                    qk = JSJSON_GapJoin(qk, ": ")
                } ElseBlock: {
                    qk = JSJSON_GapJoin(qk, ":")
                }
                parts = JSJSON_GapJoin(parts, qk)
                parts = JSJSON_GapJoin(parts, piece)
                any = 1
            }
            ki = Add(ki, 1)
        }
        JSJSON_PopSeen(Subtract(depth, 1))
        JSJSONPos.indent = step
        IfCondition EqualTo(any, 0) ThenBlock: {
            ReturnValue(JSRT_CreateString("{}"))
        }
        IfCondition GreaterThan(gap_n, 0) ThenBlock: {
            parts = JSJSON_GapJoin(parts, "\n")
            parts = JSJSON_GapJoin(parts, step)
        }
        openb = JSRT_CreateString("{")
        parts = JSJSON_GapJoin(openb, parts)
        ReturnValue(JSJSON_GapJoin(parts, "}"))
    }
}

Function.JSJSON_StringifyNative {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        val = JSRTState.undef_val
        rep = JSRTState.undef_val
        space = JSRTState.undef_val
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            val = RDMEM_64(save_args)
        }
        IfCondition GreaterThan(save_argc, 1) ThenBlock: {
            rep = RDMEM_64(save_args, 8)
        }
        IfCondition GreaterThan(save_argc, 2) ThenBlock: {
            space = RDMEM_64(save_args, 16)
        }
        JSJSONPos.replacer = 0
        JSJSONPos.prop_list = 0
        JSJSONPos.stack = JSRT_CreateArray()
        JSJSONPos.indent = JSRT_CreateString("")
        JSJSONPos.gap = JSRT_CreateString("")
        rt = JSRT_GetType(rep)
        IfCondition EqualTo(rt, JSType.FUNCTION) ThenBlock: {
            JSJSONPos.replacer = rep
        }
        IfCondition EqualTo(rt, JSType.ARRAY) ThenBlock: {
            JSJSONPos.prop_list = JSJSON_BuildList(rep)
            IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
        }
        gapv = JSJSON_MakeGap(space)
        IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        JSJSONPos.gap = gapv
        root = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(root, "__proto__", JSRTState.object_proto)
        }
        JSRT_ObjSet(root, "", val)
        // CreateDataProperty: writable, enumerable, configurable.
        JSBridge__SetAttrBits(root, "", 7)
        empty = JSRT_CreateString("")
        rv = JSJSON_Serialize(empty, root)
        IfCondition EqualTo(JSJSON_Abrupt(), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(rv, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        ReturnValue(rv)
    }
}
