LibraryImport.Arena
LibraryImport.Arrays
LibraryImport.StringUtils
LibraryImport.Browser.JSRuntime

// Cursor and scratch that must survive calls.
FixedPool.JSParseSt {
    "src": Initialize=0
    "len": Initialize=0
    "i": Initialize=0
    "buf": Initialize=0
    "oi": Initialize=0
    "err": Initialize=0
    "mode": Initialize=0
    "sign": Initialize=0
    "radix": Initialize=0
    "acc": Initialize=0
    "tmp": Initialize=0
    "tmp2": Initialize=0
    "k": Initialize=0
    "start": Initialize=0
}

Function.JSParse_NaN {
    Output: Address
    Body: {
        ReturnValue(JSRT_CreateFloat(9221120237041090560))
    }
}

Function.JSParse_Inf {
    Input: neg: Integer
    Output: Address
    Body: {
        save_n = neg
        bits = 9218868437227405312
        IfCondition EqualTo(save_n, 1) ThenBlock: {
            bits = BitwiseOr(bits, -9223372036854775808)
        }
        ReturnValue(JSRT_CreateFloat(bits))
    }
}

Function.JSParse_ThrowURI {
    Output: Integer
    Body: {
        JSParseSt.tmp = JSVM_CreateTypedError("URIError", "URI malformed")
        JSVM__SetGlobal("__pend_exc__", JSParseSt.tmp)
        JSVMCall.exc_prop = 1
        JSVMCall.thrown_val = JSParseSt.tmp
        JSParseSt.err = 1
        ReturnValue(0)
    }
}

// 1 when ch is StrWhiteSpaceChar (ES WhiteSpace + LineTerminator). U+180E is not.
Function.JSParse_IsWS {
    Input: ch: Integer
    Output: Integer
    Body: {
        save_c = ch
        IfCondition EqualTo(save_c, 9) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 10) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 11) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 12) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 13) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 32) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 160) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 5760) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(save_c, 8192), LessEqual(save_c, 8202)) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 8232) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 8233) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 8239) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 8287) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 12288) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 65279) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.JSParse_HexVal {
    Input: ch: Integer
    Output: Integer
    Body: {
        save_c = ch
        IfCondition And(GreaterEqual(save_c, 48), LessEqual(save_c, 57)) ThenBlock: {
            ReturnValue(Subtract(save_c, 48))
        }
        IfCondition And(GreaterEqual(save_c, 65), LessEqual(save_c, 70)) ThenBlock: {
            ReturnValue(Subtract(save_c, 55))
        }
        IfCondition And(GreaterEqual(save_c, 97), LessEqual(save_c, 102)) ThenBlock: {
            ReturnValue(Subtract(save_c, 87))
        }
        ReturnValue(-1)
    }
}

Function.JSParse_HexChar {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        IfCondition LessThan(save_n, 10) ThenBlock: {
            ReturnValue(Add(48, save_n))
        }
        ReturnValue(Add(55, save_n))
    }
}

// Radix digit, or -1.
Function.JSParse_RadixDigit {
    Input: ch: Integer
    Input: radix: Integer
    Output: Integer
    Body: {
        save_c = ch
        save_r = radix
        v = -1
        IfCondition And(GreaterEqual(save_c, 48), LessEqual(save_c, 57)) ThenBlock: {
            v = Subtract(save_c, 48)
        }
        IfCondition And(GreaterEqual(save_c, 65), LessEqual(save_c, 90)) ThenBlock: {
            v = Subtract(save_c, 55)
        }
        IfCondition And(GreaterEqual(save_c, 97), LessEqual(save_c, 122)) ThenBlock: {
            v = Subtract(save_c, 87)
        }
        IfCondition LessThan(v, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(v, save_r) ThenBlock: { ReturnValue(-1) }
        ReturnValue(v)
    }
}

Function.JSParse_Trim {
    Output: Integer
    Body: {
        go = 1
        WhileLoop EqualTo(go, 1) {
            IfCondition GreaterEqual(JSParseSt.i, JSParseSt.len) ThenBlock: {
                go = 0
            } ElseBlock: {
                JSParseSt.tmp = JSRT_StrUnit(JSParseSt.src, JSParseSt.i)
                IfCondition EqualTo(JSParse_IsWS(JSParseSt.tmp), 1) ThenBlock: {
                    JSParseSt.i = Add(JSParseSt.i, 1)
                    go = 1
                } ElseBlock: {
                    go = 0
                }
            }
        }
        ReturnValue(0)
    }
}

// ToString(arg) into JSParseSt.src/len. err=1 on abrupt.
Function.JSParse_Load {
    Input: args: Address
    Input: argc: Integer
    Output: Integer
    Body: {
        save_args = args
        save_argc = argc
        arg0 = JSRTState.undef_val
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            arg0 = RDMEM_64(save_args)
        }
        JSParseSt.src = JSRT_ToString(arg0)
        IfCondition EqualTo(JSVM_ErrorSawAbrupt(), 1) ThenBlock: {
            JSParseSt.err = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(JSParseSt.src, 0) ThenBlock: {
            JSParseSt.err = 1
            ReturnValue(0)
        }
        JSParseSt.tmp = JSRT_GetType(JSParseSt.src)
        IfCondition NotEqual(JSParseSt.tmp, JSType.STRING) ThenBlock: {
            JSParseSt.err = 2
            ReturnValue(0)
        }
        JSParseSt.src = JSRT_GetPayload(JSParseSt.src)
        JSParseSt.len = JSRT_StrLen(JSParseSt.src)
        JSParseSt.i = 0
        JSParseSt.err = 0
        ReturnValue(1)
    }
}

// ToInt32. Sets err on abrupt. NaN/Inf → 0.
Function.JSParse_ToInt32 {
    Input: val: Address
    Output: Integer
    Body: {
        save_v = val
        JSParseSt.acc = JSRT_ToNumber(save_v)
        IfCondition EqualTo(JSVM_ErrorSawAbrupt(), 1) ThenBlock: {
            JSParseSt.err = 1
            ReturnValue(0)
        }
        JSParseSt.tmp = BitwiseAnd(JSParseSt.acc, 9218868437227405312)
        IfCondition EqualTo(JSParseSt.tmp, 9218868437227405312) ThenBlock: {
            ReturnValue(0)
        }
        iv = Float_ToInt(JSParseSt.acc)
        IfCondition GreaterEqual(iv, 4294967296) ThenBlock: {
            q = Divide(iv, 4294967296)
            iv = Subtract(iv, Multiply(q, 4294967296))
        }
        IfCondition LessThan(iv, 0) ThenBlock: {
            q2 = Divide(iv, 4294967296)
            iv = Subtract(iv, Multiply(q2, 4294967296))
            IfCondition LessThan(iv, 0) ThenBlock: {
                iv = Add(iv, 4294967296)
            }
        }
        IfCondition GreaterEqual(iv, 2147483648) ThenBlock: {
            iv = Subtract(iv, 4294967296)
        }
        ReturnValue(iv)
    }
}

Function.JSParse_ParseInt {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        JSParseSt.err = 0
        JSParseSt.sign = 1
        IfCondition EqualTo(JSParse_Load(save_args, save_argc), 0) ThenBlock: {
            IfCondition EqualTo(JSParseSt.err, 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            ReturnValue(JSParse_NaN())
        }
        JSParse_Trim()
        IfCondition LessThan(JSParseSt.i, JSParseSt.len) ThenBlock: {
            JSParseSt.tmp = JSRT_StrUnit(JSParseSt.src, JSParseSt.i)
            IfCondition EqualTo(JSParseSt.tmp, 45) ThenBlock: {
                JSParseSt.sign = -1
                JSParseSt.i = Add(JSParseSt.i, 1)
            }
            IfCondition EqualTo(JSParseSt.tmp, 43) ThenBlock: {
                JSParseSt.i = Add(JSParseSt.i, 1)
            }
        }
        rad = 0
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            rad = JSParse_ToInt32(RDMEM_64(save_args, 8))
            IfCondition EqualTo(JSParseSt.err, 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
        }
        // mode 1 = strip 0x prefix
        JSParseSt.mode = 0
        IfCondition EqualTo(rad, 0) ThenBlock: {
            rad = 10
            JSParseSt.mode = 1
        } ElseBlock: {
            IfCondition Or(LessThan(rad, 2), GreaterThan(rad, 36)) ThenBlock: {
                ReturnValue(JSParse_NaN())
            }
            IfCondition EqualTo(rad, 16) ThenBlock: {
                JSParseSt.mode = 1
            }
        }
        JSParseSt.radix = rad
        IfCondition EqualTo(JSParseSt.mode, 1) ThenBlock: {
            IfCondition LessThan(Add(JSParseSt.i, 1), JSParseSt.len) ThenBlock: {
                JSParseSt.tmp = JSRT_StrUnit(JSParseSt.src, JSParseSt.i)
                JSParseSt.tmp2 = JSRT_StrUnit(JSParseSt.src, Add(JSParseSt.i, 1))
                IfCondition EqualTo(JSParseSt.tmp, 48) ThenBlock: {
                    IfCondition Or(EqualTo(JSParseSt.tmp2, 120), EqualTo(JSParseSt.tmp2, 88)) ThenBlock: {
                        JSParseSt.i = Add(JSParseSt.i, 2)
                        JSParseSt.radix = 16
                    }
                }
            }
        }
        // k = saw a digit. acc = host int while it fits in 2^53. mode 1 = float bits in tmp.
        JSParseSt.k = 0
        JSParseSt.acc = 0
        JSParseSt.mode = 0
        go = 1
        WhileLoop EqualTo(go, 1) {
            IfCondition GreaterEqual(JSParseSt.i, JSParseSt.len) ThenBlock: {
                go = 0
            } ElseBlock: {
                JSParseSt.tmp = JSRT_StrUnit(JSParseSt.src, JSParseSt.i)
                dig = -1
                IfCondition And(GreaterEqual(JSParseSt.tmp, 48), LessEqual(JSParseSt.tmp, 57)) ThenBlock: {
                    dig = Subtract(JSParseSt.tmp, 48)
                }
                IfCondition And(GreaterEqual(JSParseSt.tmp, 65), LessEqual(JSParseSt.tmp, 90)) ThenBlock: {
                    dig = Subtract(JSParseSt.tmp, 55)
                }
                IfCondition And(GreaterEqual(JSParseSt.tmp, 97), LessEqual(JSParseSt.tmp, 122)) ThenBlock: {
                    dig = Subtract(JSParseSt.tmp, 87)
                }
                IfCondition Or(LessThan(dig, 0), GreaterEqual(dig, JSParseSt.radix)) ThenBlock: {
                    go = 0
                } ElseBlock: {
                    JSParseSt.k = 1
                    JSParseSt.err = dig
                    IfCondition EqualTo(JSParseSt.mode, 0) ThenBlock: {
                        IfCondition GreaterThan(JSParseSt.acc, Divide(9007199254740991, JSParseSt.radix)) ThenBlock: {
                            JSParseSt.tmp2 = Float_FromInt(JSParseSt.acc)
                            JSParseSt.tmp2 = Float_Mul(JSParseSt.tmp2, Float_FromInt(JSParseSt.radix))
                            JSParseSt.tmp2 = Float_Add(JSParseSt.tmp2, Float_FromInt(JSParseSt.err))
                            JSParseSt.mode = 1
                        } ElseBlock: {
                            JSParseSt.acc = Add(Multiply(JSParseSt.acc, JSParseSt.radix), JSParseSt.err)
                        }
                    } ElseBlock: {
                        JSParseSt.tmp2 = Float_Mul(JSParseSt.tmp2, Float_FromInt(JSParseSt.radix))
                        JSParseSt.tmp2 = Float_Add(JSParseSt.tmp2, Float_FromInt(JSParseSt.err))
                    }
                    JSParseSt.i = Add(JSParseSt.i, 1)
                    go = 1
                }
            }
        }
        IfCondition EqualTo(JSParseSt.k, 0) ThenBlock: {
            ReturnValue(JSParse_NaN())
        }
        IfCondition EqualTo(JSParseSt.mode, 0) ThenBlock: {
            JSParseSt.tmp2 = Float_FromInt(JSParseSt.acc)
        }
        IfCondition EqualTo(JSParseSt.sign, -1) ThenBlock: {
            IfCondition EqualTo(JSParseSt.tmp2, 0) ThenBlock: {
                JSParseSt.tmp2 = -9223372036854775808
            } ElseBlock: {
                JSParseSt.tmp2 = Float_Mul(JSParseSt.tmp2, Float_FromInt(-1))
            }
        }
        ReturnValue(JSRT_CreateFloat(JSParseSt.tmp2))
    }
}

// 1 if "Infinity" sits at i. Advances i by 8 on success.
Function.JSParse_MatchInf {
    Output: Integer
    Body: {
        IfCondition GreaterThan(Add(JSParseSt.i, 8), JSParseSt.len) ThenBlock: {
            ReturnValue(0)
        }
        JSParseSt.tmp = JSParseSt.i
        IfCondition NotEqual(JSRT_StrUnit(JSParseSt.src, JSParseSt.tmp), 73) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_StrUnit(JSParseSt.src, Add(JSParseSt.tmp, 1)), 110) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_StrUnit(JSParseSt.src, Add(JSParseSt.tmp, 2)), 102) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_StrUnit(JSParseSt.src, Add(JSParseSt.tmp, 3)), 105) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_StrUnit(JSParseSt.src, Add(JSParseSt.tmp, 4)), 110) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_StrUnit(JSParseSt.src, Add(JSParseSt.tmp, 5)), 105) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_StrUnit(JSParseSt.src, Add(JSParseSt.tmp, 6)), 116) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_StrUnit(JSParseSt.src, Add(JSParseSt.tmp, 7)), 121) ThenBlock: { ReturnValue(0) }
        JSParseSt.i = Add(JSParseSt.tmp, 8)
        ReturnValue(1)
    }
}

// IEEE bits of 10^n for |n|<=400. n is a host int.
Function.JSParse_Pow10 {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        JSParseSt.k = 0
        IfCondition LessThan(save_n, 0) ThenBlock: {
            JSParseSt.k = 1
            save_n = Subtract(0, save_n)
        }
        IfCondition GreaterThan(save_n, 400) ThenBlock: { save_n = 400 }
        JSParseSt.radix = save_n
        JSParseSt.tmp = Float_FromInt(1)
        JSParseSt.tmp2 = 0
        WhileLoop LessThan(JSParseSt.tmp2, JSParseSt.radix) {
            JSParseSt.tmp = Float_Mul(JSParseSt.tmp, Float_FromInt(10))
            JSParseSt.tmp2 = Add(JSParseSt.tmp2, 1)
        }
        IfCondition EqualTo(JSParseSt.k, 1) ThenBlock: {
            JSParseSt.tmp = Float_Div(Float_FromInt(1), JSParseSt.tmp)
        }
        ReturnValue(JSParseSt.tmp)
    }
}

Function.JSParse_ParseFloat {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        JSParseSt.err = 0
        JSParseSt.sign = 1
        IfCondition EqualTo(JSParse_Load(save_args, save_argc), 0) ThenBlock: {
            IfCondition EqualTo(JSParseSt.err, 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            ReturnValue(JSParse_NaN())
        }
        JSParse_Trim()
        IfCondition LessThan(JSParseSt.i, JSParseSt.len) ThenBlock: {
            JSParseSt.tmp = JSRT_StrUnit(JSParseSt.src, JSParseSt.i)
            IfCondition EqualTo(JSParseSt.tmp, 45) ThenBlock: {
                JSParseSt.sign = -1
                JSParseSt.i = Add(JSParseSt.i, 1)
            }
            IfCondition EqualTo(JSParseSt.tmp, 43) ThenBlock: {
                JSParseSt.i = Add(JSParseSt.i, 1)
            }
        }
        IfCondition EqualTo(JSParse_MatchInf(), 1) ThenBlock: {
            neg = 0
            IfCondition EqualTo(JSParseSt.sign, -1) ThenBlock: { neg = 1 }
            ReturnValue(JSParse_Inf(neg))
        }
        // k = saw digit. acc = integer digits (host, max 15). radix = extra int digits.
        JSParseSt.k = 0
        JSParseSt.acc = 0
        JSParseSt.radix = 0
        go = 1
        WhileLoop EqualTo(go, 1) {
            IfCondition GreaterEqual(JSParseSt.i, JSParseSt.len) ThenBlock: {
                go = 0
            } ElseBlock: {
                JSParseSt.tmp = JSRT_StrUnit(JSParseSt.src, JSParseSt.i)
                IfCondition And(GreaterEqual(JSParseSt.tmp, 48), LessEqual(JSParseSt.tmp, 57)) ThenBlock: {
                    JSParseSt.k = 1
                    IfCondition LessThan(JSParseSt.radix, 1) ThenBlock: {
                        IfCondition LessThan(JSParseSt.acc, 100000000000000) ThenBlock: {
                            JSParseSt.acc = Add(Multiply(JSParseSt.acc, 10), Subtract(JSParseSt.tmp, 48))
                        } ElseBlock: {
                            JSParseSt.radix = Add(JSParseSt.radix, 1)
                        }
                    } ElseBlock: {
                        JSParseSt.radix = Add(JSParseSt.radix, 1)
                    }
                    JSParseSt.i = Add(JSParseSt.i, 1)
                    go = 1
                } ElseBlock: {
                    go = 0
                }
            }
        }
        // tmp2 = frac value, start = frac places
        JSParseSt.tmp2 = 0
        JSParseSt.start = 0
        IfCondition LessThan(JSParseSt.i, JSParseSt.len) ThenBlock: {
            JSParseSt.tmp = JSRT_StrUnit(JSParseSt.src, JSParseSt.i)
            IfCondition EqualTo(JSParseSt.tmp, 46) ThenBlock: {
                JSParseSt.i = Add(JSParseSt.i, 1)
                go = 1
                WhileLoop EqualTo(go, 1) {
                    IfCondition GreaterEqual(JSParseSt.i, JSParseSt.len) ThenBlock: {
                        go = 0
                    } ElseBlock: {
                        JSParseSt.tmp = JSRT_StrUnit(JSParseSt.src, JSParseSt.i)
                        IfCondition And(GreaterEqual(JSParseSt.tmp, 48), LessEqual(JSParseSt.tmp, 57)) ThenBlock: {
                            JSParseSt.k = 1
                            IfCondition LessThan(JSParseSt.start, 15) ThenBlock: {
                                JSParseSt.tmp2 = Add(Multiply(JSParseSt.tmp2, 10), Subtract(JSParseSt.tmp, 48))
                                JSParseSt.start = Add(JSParseSt.start, 1)
                            }
                            JSParseSt.i = Add(JSParseSt.i, 1)
                            go = 1
                        } ElseBlock: {
                            go = 0
                        }
                    }
                }
            }
        }
        // mode = exponent (signed). Rewind if 'e' has no digits.
        JSParseSt.mode = 0
        IfCondition LessThan(JSParseSt.i, JSParseSt.len) ThenBlock: {
            JSParseSt.tmp = JSRT_StrUnit(JSParseSt.src, JSParseSt.i)
            IfCondition Or(EqualTo(JSParseSt.tmp, 101), EqualTo(JSParseSt.tmp, 69)) ThenBlock: {
                JSParseSt.k = JSParseSt.k
                epos = JSParseSt.i
                JSParseSt.i = Add(JSParseSt.i, 1)
                esign = 1
                IfCondition LessThan(JSParseSt.i, JSParseSt.len) ThenBlock: {
                    JSParseSt.tmp = JSRT_StrUnit(JSParseSt.src, JSParseSt.i)
                    IfCondition EqualTo(JSParseSt.tmp, 45) ThenBlock: {
                        esign = -1
                        JSParseSt.i = Add(JSParseSt.i, 1)
                    }
                    IfCondition EqualTo(JSParseSt.tmp, 43) ThenBlock: {
                        JSParseSt.i = Add(JSParseSt.i, 1)
                    }
                }
                saw_e = 0
                ev = 0
                go = 1
                WhileLoop EqualTo(go, 1) {
                    IfCondition GreaterEqual(JSParseSt.i, JSParseSt.len) ThenBlock: {
                        go = 0
                    } ElseBlock: {
                        JSParseSt.tmp = JSRT_StrUnit(JSParseSt.src, JSParseSt.i)
                        IfCondition And(GreaterEqual(JSParseSt.tmp, 48), LessEqual(JSParseSt.tmp, 57)) ThenBlock: {
                            saw_e = 1
                            IfCondition LessThan(ev, 100000) ThenBlock: {
                                ev = Add(Multiply(ev, 10), Subtract(JSParseSt.tmp, 48))
                            }
                            JSParseSt.i = Add(JSParseSt.i, 1)
                            go = 1
                        } ElseBlock: {
                            go = 0
                        }
                    }
                }
                IfCondition EqualTo(saw_e, 0) ThenBlock: {
                    JSParseSt.i = epos
                    ev = 0
                    esign = 1
                }
                IfCondition EqualTo(esign, -1) ThenBlock: {
                    ev = Subtract(0, ev)
                }
                JSParseSt.mode = ev
            }
        }
        IfCondition EqualTo(JSParseSt.k, 0) ThenBlock: {
            ReturnValue(JSParse_NaN())
        }
        // sig = int*10^places + frac, then * 10^(exp + extra - places).
        // Host int, no calls, so the fraction is not clobbered by Pow10.
        sig = JSParseSt.acc
        frac = JSParseSt.tmp2
        places = JSParseSt.start
        expv = Add(JSParseSt.mode, JSParseSt.radix)
        p10 = 1
        fi = 0
        WhileLoop LessThan(fi, places) {
            p10 = Multiply(p10, 10)
            fi = Add(fi, 1)
        }
        use_f = 0
        IfCondition GreaterThan(places, 0) ThenBlock: {
            IfCondition GreaterThan(sig, 0) ThenBlock: {
                IfCondition Or(GreaterThan(places, 8), GreaterThan(sig, 1000000000)) ThenBlock: {
                    use_f = 1
                } ElseBlock: {
                    sig = Add(Multiply(sig, p10), frac)
                    expv = Subtract(expv, places)
                }
            } ElseBlock: {
                sig = frac
                expv = Subtract(expv, places)
            }
        }
        IfCondition GreaterThan(expv, 350) ThenBlock: {
            neg2 = 0
            IfCondition EqualTo(JSParseSt.sign, -1) ThenBlock: { neg2 = 1 }
            ReturnValue(JSParse_Inf(neg2))
        }
        IfCondition LessThan(expv, -350) ThenBlock: {
            IfCondition EqualTo(JSParseSt.sign, -1) ThenBlock: {
                ReturnValue(JSRT_CreateFloat(-9223372036854775808))
            }
            ReturnValue(JSRT_CreateFloat(0))
        }
        JSParseSt.acc = sig
        JSParseSt.tmp2 = frac
        JSParseSt.start = places
        JSParseSt.mode = expv
        JSParseSt.k = use_f
        JSParseSt.oi = Float_FromInt(10)
        IfCondition EqualTo(JSParseSt.k, 1) ThenBlock: {
            JSParseSt.tmp = Float_FromInt(JSParseSt.acc)
            JSParseSt.buf = Float_FromInt(1)
            JSParseSt.err = 0
            WhileLoop LessThan(JSParseSt.err, JSParseSt.start) {
                JSParseSt.buf = Float_Mul(JSParseSt.buf, JSParseSt.oi)
                JSParseSt.err = Add(JSParseSt.err, 1)
            }
            JSParseSt.tmp = Float_Mul(JSParseSt.tmp, JSParseSt.buf)
            JSParseSt.tmp = Float_Add(JSParseSt.tmp, Float_FromInt(JSParseSt.tmp2))
            JSParseSt.mode = Subtract(JSParseSt.mode, JSParseSt.start)
        } ElseBlock: {
            JSParseSt.tmp = Float_FromInt(JSParseSt.acc)
        }
        IfCondition NotEqual(JSParseSt.mode, 0) ThenBlock: {
            ae = JSParseSt.mode
            IfCondition LessThan(ae, 0) ThenBlock: { ae = Subtract(0, ae) }
            IfCondition GreaterThan(ae, 400) ThenBlock: { ae = 400 }
            JSParseSt.buf = ae
            JSParseSt.radix = Float_FromInt(1)
            JSParseSt.err = 0
            WhileLoop LessThan(JSParseSt.err, JSParseSt.buf) {
                JSParseSt.radix = Float_Mul(JSParseSt.radix, JSParseSt.oi)
                JSParseSt.err = Add(JSParseSt.err, 1)
            }
            IfCondition GreaterThan(JSParseSt.mode, 0) ThenBlock: {
                JSParseSt.tmp = Float_Mul(JSParseSt.tmp, JSParseSt.radix)
            } ElseBlock: {
                JSParseSt.tmp = Float_Div(JSParseSt.tmp, JSParseSt.radix)
            }
        }
        IfCondition EqualTo(JSParseSt.sign, -1) ThenBlock: {
            IfCondition EqualTo(JSParseSt.tmp, 0) ThenBlock: {
                JSParseSt.tmp = -9223372036854775808
            } ElseBlock: {
                JSParseSt.tmp = Float_Mul(JSParseSt.tmp, Float_FromInt(-1))
            }
        }
        ReturnValue(JSRT_CreateFloat(JSParseSt.tmp))
    }
}

Function.JSParse_Put {
    Input: u: Integer
    Output: Integer
    Body: {
        save_u = u
        JSRT_StrSetUnit(JSParseSt.buf, JSParseSt.oi, save_u)
        JSParseSt.oi = Add(JSParseSt.oi, 1)
        ReturnValue(0)
    }
}

Function.JSParse_PutPct {
    Input: b: Integer
    Output: Integer
    Body: {
        JSParseSt.tmp = BitwiseAnd(b, 255)
        JSParse_Put(37)
        JSParse_Put(JSParse_HexChar(Divide(JSParseSt.tmp, 16)))
        JSParse_Put(JSParse_HexChar(BitwiseAnd(JSParseSt.tmp, 15)))
        ReturnValue(0)
    }
}

Function.JSParse_EmitCP {
    Input: cp: Integer
    Output: Integer
    Body: {
        JSParseSt.k = cp
        IfCondition LessThan(JSParseSt.k, 128) ThenBlock: {
            JSParse_PutPct(JSParseSt.k)
            ReturnValue(0)
        }
        IfCondition LessThan(JSParseSt.k, 2048) ThenBlock: {
            JSParseSt.tmp2 = Add(128, BitwiseAnd(JSParseSt.k, 63))
            JSParse_PutPct(Add(192, ShiftRight(JSParseSt.k, 6)))
            JSParse_PutPct(JSParseSt.tmp2)
            ReturnValue(0)
        }
        IfCondition LessThan(JSParseSt.k, 65536) ThenBlock: {
            // PutPct writes tmp, so the other two bytes live in tmp2 and radix.
            JSParseSt.tmp2 = Add(128, BitwiseAnd(ShiftRight(JSParseSt.k, 6), 63))
            JSParseSt.radix = Add(128, BitwiseAnd(JSParseSt.k, 63))
            JSParse_PutPct(Add(224, ShiftRight(JSParseSt.k, 12)))
            JSParse_PutPct(JSParseSt.tmp2)
            JSParse_PutPct(JSParseSt.radix)
            ReturnValue(0)
        }
        JSParseSt.radix = Add(128, BitwiseAnd(ShiftRight(JSParseSt.k, 12), 63))
        JSParseSt.tmp2 = Add(128, BitwiseAnd(ShiftRight(JSParseSt.k, 6), 63))
        JSParseSt.start = Add(128, BitwiseAnd(JSParseSt.k, 63))
        JSParse_PutPct(Add(240, ShiftRight(JSParseSt.k, 18)))
        JSParse_PutPct(JSParseSt.radix)
        JSParse_PutPct(JSParseSt.tmp2)
        JSParse_PutPct(JSParseSt.start)
        ReturnValue(0)
    }
}

// 1 if this code unit is left unescaped. component=1 is encodeURIComponent.
Function.JSParse_Keep {
    Input: ch: Integer
    Input: component: Integer
    Output: Integer
    Body: {
        save_c = ch
        save_m = component
        IfCondition And(GreaterEqual(save_c, 48), LessEqual(save_c, 57)) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(save_c, 65), LessEqual(save_c, 90)) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(save_c, 97), LessEqual(save_c, 122)) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 45) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 95) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 46) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 33) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 126) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 42) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 39) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 40) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 41) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_m, 0) ThenBlock: {
            IfCondition EqualTo(save_c, 59) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(save_c, 47) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(save_c, 63) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(save_c, 58) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(save_c, 64) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(save_c, 38) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(save_c, 61) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(save_c, 43) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(save_c, 36) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(save_c, 44) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(save_c, 35) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

Function.JSParse_Finish {
    Output: Address
    Body: {
        WRMEM_64(JSParseSt.buf, 8, JSParseSt.oi)
        WRMEM_8(JSParseSt.buf, Add(16, Multiply(JSParseSt.oi, 2)), 0)
        WRMEM_8(JSParseSt.buf, Add(17, Multiply(JSParseSt.oi, 2)), 0)
        JSParseSt.tmp = JSRT__AllocValue()
        IfCondition EqualTo(JSParseSt.tmp, 0) ThenBlock: {
            ReturnValue(JSRT_CreateString(""))
        }
        WRMEM_64(JSParseSt.tmp, JSType.STRING)
        WRMEM_64(JSParseSt.tmp, 8, JSParseSt.buf)
        ReturnValue(JSParseSt.tmp)
    }
}

Function.JSParse_Encode {
    Input: args: Address
    Input: argc: Integer
    Input: component: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        save_m = component
        JSParseSt.err = 0
        JSParseSt.mode = save_m
        IfCondition EqualTo(JSParse_Load(save_args, save_argc), 0) ThenBlock: {
            IfCondition EqualTo(JSParseSt.err, 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            ReturnValue(JSRT_CreateString(""))
        }
        IfCondition EqualTo(JSParseSt.len, 0) ThenBlock: {
            ReturnValue(JSRT_CreateString(""))
        }
        JSParseSt.buf = JSRT_StrAlloc(Multiply(JSParseSt.len, 12))
        IfCondition EqualTo(JSParseSt.buf, 0) ThenBlock: {
            ReturnValue(JSRT_CreateString(""))
        }
        JSParseSt.oi = 0
        JSParseSt.i = 0
        go = 1
        WhileLoop EqualTo(go, 1) {
            IfCondition GreaterEqual(JSParseSt.i, JSParseSt.len) ThenBlock: {
                go = 0
            } ElseBlock: {
                JSParseSt.tmp = JSRT_StrUnit(JSParseSt.src, JSParseSt.i)
                IfCondition And(GreaterEqual(JSParseSt.tmp, 55296), LessEqual(JSParseSt.tmp, 56319)) ThenBlock: {
                    IfCondition LessThan(Add(JSParseSt.i, 1), JSParseSt.len) ThenBlock: {
                        JSParseSt.tmp2 = JSRT_StrUnit(JSParseSt.src, Add(JSParseSt.i, 1))
                        IfCondition And(GreaterEqual(JSParseSt.tmp2, 56320), LessEqual(JSParseSt.tmp2, 57343)) ThenBlock: {
                            cp = Subtract(JSParseSt.tmp, 55296)
                            cp = ShiftLeft(cp, 10)
                            cp = Add(cp, Subtract(JSParseSt.tmp2, 56320))
                            cp = Add(cp, 65536)
                            JSParse_EmitCP(cp)
                            JSParseSt.i = Add(JSParseSt.i, 2)
                            go = 1
                        } ElseBlock: {
                            JSParse_ThrowURI()
                            ReturnValue(JSRTState.undef_val)
                        }
                    } ElseBlock: {
                        JSParse_ThrowURI()
                        ReturnValue(JSRTState.undef_val)
                    }
                } ElseBlock: {
                    IfCondition And(GreaterEqual(JSParseSt.tmp, 56320), LessEqual(JSParseSt.tmp, 57343)) ThenBlock: {
                        JSParse_ThrowURI()
                        ReturnValue(JSRTState.undef_val)
                    } ElseBlock: {
                        IfCondition EqualTo(JSParse_Keep(JSParseSt.tmp, JSParseSt.mode), 1) ThenBlock: {
                            JSParse_Put(JSParseSt.tmp)
                        } ElseBlock: {
                            JSParse_EmitCP(JSParseSt.tmp)
                        }
                        JSParseSt.i = Add(JSParseSt.i, 1)
                        go = 1
                    }
                }
            }
        }
        ReturnValue(JSParse_Finish())
    }
}

// 1 if decodeURI should keep this ASCII byte percent-encoded.
Function.JSParse_Reserved {
    Input: ch: Integer
    Output: Integer
    Body: {
        save_c = ch
        IfCondition EqualTo(JSParseSt.mode, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(save_c, 59) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 47) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 63) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 58) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 64) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 38) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 61) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 43) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 36) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 44) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(save_c, 35) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// i points at '%'. Returns the byte, or -1 and sets err.
Function.JSParse_PctByte {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(Add(JSParseSt.i, 2), JSParseSt.len) ThenBlock: {
            JSParseSt.err = 1
            ReturnValue(-1)
        }
        JSParseSt.tmp = JSRT_StrUnit(JSParseSt.src, Add(JSParseSt.i, 1))
        JSParseSt.tmp2 = JSRT_StrUnit(JSParseSt.src, Add(JSParseSt.i, 2))
        JSParseSt.tmp = JSParse_HexVal(JSParseSt.tmp)
        JSParseSt.tmp2 = JSParse_HexVal(JSParseSt.tmp2)
        IfCondition Or(LessThan(JSParseSt.tmp, 0), LessThan(JSParseSt.tmp2, 0)) ThenBlock: {
            JSParseSt.err = 1
            ReturnValue(-1)
        }
        b = Add(Multiply(JSParseSt.tmp, 16), JSParseSt.tmp2)
        JSParseSt.i = Add(JSParseSt.i, 3)
        ReturnValue(b)
    }
}

Function.JSParse_LeadOnes {
    Input: b: Integer
    Output: Integer
    Body: {
        save_b = b
        n = 0
        t = BitwiseAnd(save_b, 255)
        go = 1
        WhileLoop EqualTo(go, 1) {
            IfCondition EqualTo(BitwiseAnd(t, 128), 0) ThenBlock: {
                go = 0
            } ElseBlock: {
                n = Add(n, 1)
                t = BitwiseAnd(ShiftLeft(t, 1), 255)
                IfCondition GreaterThan(n, 6) ThenBlock: { go = 0 }
            }
        }
        ReturnValue(n)
    }
}

Function.JSParse_CopyRange {
    Output: Integer
    Body: {
        WhileLoop LessThan(JSParseSt.start, JSParseSt.i) {
            JSParseSt.tmp = JSRT_StrUnit(JSParseSt.src, JSParseSt.start)
            JSParseSt.start = Add(JSParseSt.start, 1)
            JSParse_Put(JSParseSt.tmp)
        }
        ReturnValue(0)
    }
}

Function.JSParse_PutCP {
    Input: cp: Integer
    Output: Integer
    Body: {
        JSParseSt.k = cp
        IfCondition LessThan(JSParseSt.k, 65536) ThenBlock: {
            JSParse_Put(JSParseSt.k)
            ReturnValue(0)
        }
        adj = Subtract(JSParseSt.k, 65536)
        JSParseSt.tmp = Add(56320, BitwiseAnd(adj, 1023))
        JSParse_Put(Add(55296, ShiftRight(adj, 10)))
        JSParse_Put(JSParseSt.tmp)
        ReturnValue(0)
    }
}

Function.JSParse_Decode {
    Input: args: Address
    Input: argc: Integer
    Input: component: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        save_m = component
        JSParseSt.err = 0
        JSParseSt.mode = save_m
        IfCondition EqualTo(JSParse_Load(save_args, save_argc), 0) ThenBlock: {
            IfCondition EqualTo(JSParseSt.err, 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            ReturnValue(JSRT_CreateString(""))
        }
        IfCondition EqualTo(JSParseSt.len, 0) ThenBlock: {
            ReturnValue(JSRT_CreateString(""))
        }
        JSParseSt.buf = JSRT_StrAlloc(JSParseSt.len)
        IfCondition EqualTo(JSParseSt.buf, 0) ThenBlock: {
            ReturnValue(JSRT_CreateString(""))
        }
        JSParseSt.oi = 0
        JSParseSt.i = 0
        go = 1
        WhileLoop EqualTo(go, 1) {
            IfCondition GreaterEqual(JSParseSt.i, JSParseSt.len) ThenBlock: {
                go = 0
            } ElseBlock: {
                JSParseSt.tmp = JSRT_StrUnit(JSParseSt.src, JSParseSt.i)
                IfCondition NotEqual(JSParseSt.tmp, 37) ThenBlock: {
                    JSParse_Put(JSParseSt.tmp)
                    JSParseSt.i = Add(JSParseSt.i, 1)
                    go = 1
                } ElseBlock: {
                    JSParseSt.start = JSParseSt.i
                    JSParseSt.k = JSParse_PctByte()
                    IfCondition EqualTo(JSParseSt.err, 1) ThenBlock: {
                        JSParse_ThrowURI()
                        ReturnValue(JSRTState.undef_val)
                    }
                    JSParseSt.radix = JSParse_LeadOnes(JSParseSt.k)
                    IfCondition Or(EqualTo(JSParseSt.radix, 1), GreaterThan(JSParseSt.radix, 4)) ThenBlock: {
                        JSParse_ThrowURI()
                        ReturnValue(JSRTState.undef_val)
                    }
                    IfCondition EqualTo(JSParseSt.radix, 0) ThenBlock: {
                        IfCondition EqualTo(JSParse_Reserved(JSParseSt.k), 1) ThenBlock: {
                            JSParse_CopyRange()
                        } ElseBlock: {
                            JSParse_Put(JSParseSt.k)
                        }
                        go = 1
                    } ElseBlock: {
                        IfCondition EqualTo(JSParseSt.radix, 2) ThenBlock: {
                            JSParseSt.acc = BitwiseAnd(JSParseSt.k, 31)
                        }
                        IfCondition EqualTo(JSParseSt.radix, 3) ThenBlock: {
                            JSParseSt.acc = BitwiseAnd(JSParseSt.k, 15)
                        }
                        IfCondition EqualTo(JSParseSt.radix, 4) ThenBlock: {
                            JSParseSt.acc = BitwiseAnd(JSParseSt.k, 7)
                        }
                        JSParseSt.k = 1
                        bad = 0
                        WhileLoop And(EqualTo(bad, 0), LessThan(JSParseSt.k, JSParseSt.radix)) {
                            IfCondition GreaterEqual(JSParseSt.i, JSParseSt.len) ThenBlock: {
                                bad = 1
                            } ElseBlock: {
                                JSParseSt.tmp = JSRT_StrUnit(JSParseSt.src, JSParseSt.i)
                                IfCondition NotEqual(JSParseSt.tmp, 37) ThenBlock: {
                                    bad = 1
                                } ElseBlock: {
                                    JSParseSt.tmp2 = JSParse_PctByte()
                                    IfCondition EqualTo(JSParseSt.err, 1) ThenBlock: {
                                        bad = 1
                                    } ElseBlock: {
                                        IfCondition NotEqual(BitwiseAnd(JSParseSt.tmp2, 192), 128) ThenBlock: {
                                            bad = 1
                                        } ElseBlock: {
                                            JSParseSt.acc = ShiftLeft(JSParseSt.acc, 6)
                                            JSParseSt.acc = BitwiseOr(JSParseSt.acc, BitwiseAnd(JSParseSt.tmp2, 63))
                                            JSParseSt.k = Add(JSParseSt.k, 1)
                                        }
                                    }
                                }
                            }
                        }
                        IfCondition EqualTo(bad, 1) ThenBlock: {
                            JSParse_ThrowURI()
                            ReturnValue(JSRTState.undef_val)
                        }
                        okv = 1
                        IfCondition EqualTo(JSParseSt.radix, 2) ThenBlock: {
                            IfCondition LessThan(JSParseSt.acc, 128) ThenBlock: { okv = 0 }
                        }
                        IfCondition EqualTo(JSParseSt.radix, 3) ThenBlock: {
                            IfCondition LessThan(JSParseSt.acc, 2048) ThenBlock: { okv = 0 }
                            IfCondition And(GreaterEqual(JSParseSt.acc, 55296), LessEqual(JSParseSt.acc, 57343)) ThenBlock: { okv = 0 }
                        }
                        IfCondition EqualTo(JSParseSt.radix, 4) ThenBlock: {
                            IfCondition LessThan(JSParseSt.acc, 65536) ThenBlock: { okv = 0 }
                            IfCondition GreaterThan(JSParseSt.acc, 1114111) ThenBlock: { okv = 0 }
                        }
                        IfCondition EqualTo(okv, 0) ThenBlock: {
                            JSParse_ThrowURI()
                            ReturnValue(JSRTState.undef_val)
                        }
                        JSParse_PutCP(JSParseSt.acc)
                        go = 1
                    }
                }
            }
        }
        ReturnValue(JSParse_Finish())
    }
}
