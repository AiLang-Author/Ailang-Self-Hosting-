// Library.JSRTBigInt.ailang — Arbitrary-precision BigInt for the JS engine
//
// Heap layout (payload of JSType.BIGINT points here):
//   +0:  sign   (0 = non-negative, 1 = negative)
//   +8:  nlimbs (used limbs, >= 1; zero is nlimbs=1 limb0=0 sign=0)
//   +16: cap    (allocated limb capacity)
//   +24: limbs  (little-endian base-2^32 digits, each in an 8-byte slot)
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.BIConst {
    "HDR":       Initialize=24
    "LIMB_BITS": Initialize=32
    "BASE":      Initialize=4294967296
    "MASK":      Initialize=4294967295
    "MAX_LIMBS": Initialize=4096
}

// =============================================================================
// ALLOCATION
// =============================================================================

Function.BI__Alloc {
    Input: nlimbs: Integer
    Output: Address
    Body: {
        n = nlimbs
        IfCondition LessThan(n, 1) ThenBlock: { n = 1 }
        IfCondition GreaterThan(n, BIConst.MAX_LIMBS) ThenBlock: {
            n = BIConst.MAX_LIMBS
        }
        sz = Add(BIConst.HDR, Multiply(n, 8))
        p = Allocate(sz)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        MemorySet(p, 0, sz)
        StoreValue(p, 0)
        StoreValue(Add(p, 8), 1)
        StoreValue(Add(p, 16), n)
        ReturnValue(p)
    }
}

Function.BI__Ensure {
    Input: bi: Address
    Input: need: Integer
    Output: Address
    Body: {
        save = bi
        nneed = need
        IfCondition EqualTo(save, 0) ThenBlock: { ReturnValue(0) }
        cap = Dereference(Add(save, 16))
        IfCondition GreaterEqual(cap, nneed) ThenBlock: { ReturnValue(save) }
        ncap = cap
        WhileLoop LessThan(ncap, nneed) {
            ncap = Multiply(ncap, 2)
            IfCondition GreaterThan(ncap, BIConst.MAX_LIMBS) ThenBlock: {
                ncap = BIConst.MAX_LIMBS
            }
        }
        IfCondition LessThan(ncap, nneed) ThenBlock: { ReturnValue(0) }
        nbi = BI__Alloc(ncap)
        IfCondition EqualTo(nbi, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(nbi, Dereference(save))
        nl = Dereference(Add(save, 8))
        StoreValue(Add(nbi, 8), nl)
        i = 0
        WhileLoop LessThan(i, nl) {
            StoreValue(Add(nbi, Add(BIConst.HDR, Multiply(i, 8))),
                       Dereference(Add(save, Add(BIConst.HDR, Multiply(i, 8)))))
            i = Add(i, 1)
        }
        ReturnValue(nbi)
    }
}

Function.BI__Normalize {
    Input: bi: Address
    Output: Integer
    Body: {
        save = bi
        IfCondition EqualTo(save, 0) ThenBlock: { ReturnValue(0) }
        nl = Dereference(Add(save, 8))
        WhileLoop GreaterThan(nl, 1) {
            top = Dereference(Add(save, Add(BIConst.HDR, Multiply(Subtract(nl, 1), 8))))
            IfCondition NotEqual(top, 0) ThenBlock: {
                // done
                nl = 0
            } ElseBlock: {
                nl = Subtract(nl, 1)
                StoreValue(Add(save, 8), nl)
            }
        }
        // zero is non-negative
        nl = Dereference(Add(save, 8))
        IfCondition EqualTo(nl, 1) ThenBlock: {
            IfCondition EqualTo(Dereference(Add(save, BIConst.HDR)), 0) ThenBlock: {
                StoreValue(save, 0)
            }
        }
        ReturnValue(1)
    }
}

Function.BI__Limb {
    Input: bi: Address
    Input: i: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseAnd(Dereference(Add(bi, Add(BIConst.HDR, Multiply(i, 8)))), BIConst.MASK))
    }
}

Function.BI__SetLimb {
    Input: bi: Address
    Input: i: Integer
    Input: v: Integer
    Output: Integer
    Body: {
        StoreValue(Add(bi, Add(BIConst.HDR, Multiply(i, 8))), BitwiseAnd(v, BIConst.MASK))
        ReturnValue(1)
    }
}

// =============================================================================
// CONSTRUCTORS
// =============================================================================

Function.JSRT_CreateBigIntZero {
    Output: Address
    Body: {
        bi = BI__Alloc(1)
        IfCondition EqualTo(bi, 0) ThenBlock: { ReturnValue(0) }
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.BIGINT)
        StoreValue(Add(val, 8), bi)
        ReturnValue(val)
    }
}

// Create BigInt from signed host integer (fits in i64 range used carefully)
Function.JSRT_CreateBigIntFromInt {
    Input: n: Integer
    Output: Address
    Body: {
        save_n = n
        sign = 0
        mag = save_n
        IfCondition LessThan(save_n, 0) ThenBlock: {
            sign = 1
            // avoid overflow on MIN_INT: use two's complement carefully
            mag = Subtract(0, save_n)
            IfCondition EqualTo(mag, save_n) ThenBlock: {
                // MIN_INT64: 2^63
                bi = BI__Alloc(3)
                IfCondition EqualTo(bi, 0) ThenBlock: { ReturnValue(0) }
                StoreValue(bi, 1)
                StoreValue(Add(bi, 8), 2)
                BI__SetLimb(bi, 0, 0)
                BI__SetLimb(bi, 1, 2147483648)
                val = JSRT__AllocValue()
                IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
                StoreValue(val, JSType.BIGINT)
                StoreValue(Add(val, 8), bi)
                ReturnValue(val)
            }
        }
        bi = BI__Alloc(3)
        IfCondition EqualTo(bi, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(bi, sign)
        // split mag into up to 2 limbs (unsigned 64-bit view)
        lo = BitwiseAnd(mag, BIConst.MASK)
        hi = BitwiseAnd(ShiftRight(mag, 32), BIConst.MASK)
        IfCondition EqualTo(hi, 0) ThenBlock: {
            StoreValue(Add(bi, 8), 1)
            BI__SetLimb(bi, 0, lo)
        } ElseBlock: {
            StoreValue(Add(bi, 8), 2)
            BI__SetLimb(bi, 0, lo)
            BI__SetLimb(bi, 1, hi)
        }
        BI__Normalize(bi)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.BIGINT)
        StoreValue(Add(val, 8), bi)
        ReturnValue(val)
    }
}

// Parse decimal/hex/octal/binary integer string (no trailing n). Returns heap bi or 0.
// Read one code unit from digit source: JS UTF-16 string or C-string (const pool)
Function.BI__DigitCh {
    Input: sptr: Address
    Input: idx: Integer
    Input: is_js: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(is_js, 1) ThenBlock: {
            ReturnValue(JSRT_StrUnit(sptr, idx))
        }
        ReturnValue(GetByte(sptr, idx))
    }
}

Function.BI__ParseDigits {
    Input: sptr: Address
    Input: slen: Integer
    Output: Address
    Body: {
        save_p = sptr
        save_len = slen
        IfCondition EqualTo(save_p, 0) ThenBlock: { ReturnValue(0) }
        // JS string payload (UTF-16) vs C digit string from const pool
        is_js = JSRT_StrIsJS(save_p)
        IfCondition EqualTo(is_js, 1) ThenBlock: {
            save_len = JSRT_StrLen(save_p)
        }
        IfCondition LessThan(save_len, 0) ThenBlock: { ReturnValue(0) }
        // trim leading whitespace
        i = 0
        go = 1
        WhileLoop And(EqualTo(go, 1), LessThan(i, save_len)) {
            ch = BI__DigitCh(save_p, i, is_js)
            IfCondition Or(Or(EqualTo(ch, 32), EqualTo(ch, 9)), Or(EqualTo(ch, 10), EqualTo(ch, 13))) ThenBlock: {
                i = Add(i, 1)
            } ElseBlock: {
                go = 0
            }
        }
        // trim trailing
        end = save_len
        go2 = 1
        WhileLoop And(EqualTo(go2, 1), GreaterThan(end, i)) {
            ch = BI__DigitCh(save_p, Subtract(end, 1), is_js)
            IfCondition Or(Or(EqualTo(ch, 32), EqualTo(ch, 9)), Or(EqualTo(ch, 10), EqualTo(ch, 13))) ThenBlock: {
                end = Subtract(end, 1)
            } ElseBlock: {
                go2 = 0
            }
        }
        IfCondition GreaterEqual(i, end) ThenBlock: {
            // empty → 0n
            z = BI__Alloc(1)
            IfCondition EqualTo(z, 0) ThenBlock: { ReturnValue(0) }
            StoreValue(z, 0)
            StoreValue(Add(z, 8), 1)
            BI__SetLimb(z, 0, 0)
            ReturnValue(z)
        }
        sign = 0
        ch = BI__DigitCh(save_p, i, is_js)
        IfCondition EqualTo(ch, 45) ThenBlock: {
            sign = 1
            i = Add(i, 1)
        }
        IfCondition EqualTo(ch, 43) ThenBlock: {
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(i, end) ThenBlock: {
            z = BI__Alloc(1)
            StoreValue(z, 0)
            StoreValue(Add(z, 8), 1)
            BI__SetLimb(z, 0, 0)
            ReturnValue(z)
        }
        base = 10
        IfCondition And(LessThan(Add(i, 1), end), EqualTo(BI__DigitCh(save_p, i, is_js), 48)) ThenBlock: {
            b1 = BI__DigitCh(save_p, Add(i, 1), is_js)
            IfCondition Or(EqualTo(b1, 120), EqualTo(b1, 88)) ThenBlock: {
                base = 16
                i = Add(i, 2)
            }
            IfCondition Or(EqualTo(b1, 111), EqualTo(b1, 79)) ThenBlock: {
                base = 8
                i = Add(i, 2)
            }
            IfCondition Or(EqualTo(b1, 98), EqualTo(b1, 66)) ThenBlock: {
                base = 2
                i = Add(i, 2)
            }
        }
        bi = BI__Alloc(4)
        IfCondition EqualTo(bi, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(bi, 0)
        StoreValue(Add(bi, 8), 1)
        BI__SetLimb(bi, 0, 0)
        has_digit = 0
        WhileLoop LessThan(i, end) {
            ch = BI__DigitCh(save_p, i, is_js)
            IfCondition EqualTo(ch, 95) ThenBlock: {
                i = Add(i, 1)
            } ElseBlock: {
                dig = -1
                IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                    dig = Subtract(ch, 48)
                }
                IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 102)) ThenBlock: {
                    dig = Subtract(ch, 87)
                }
                IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 70)) ThenBlock: {
                    dig = Subtract(ch, 55)
                }
                IfCondition Or(LessThan(dig, 0), GreaterEqual(dig, base)) ThenBlock: {
                    ReturnValue(0)
                }
                has_digit = 1
                bi = BI__MulAddSmall(bi, base, dig)
                IfCondition EqualTo(bi, 0) ThenBlock: { ReturnValue(0) }
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(has_digit, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(bi, sign)
        BI__Normalize(bi)
        ReturnValue(bi)
    }
}

// bi = bi * mul + add  (mul, add small)
Function.BI__MulAddSmall {
    Input: bi: Address
    Input: mul: Integer
    Input: add: Integer
    Output: Address
    Body: {
        save = bi
        m = mul
        a = add
        nl = Dereference(Add(save, 8))
        carry = a
        i = 0
        WhileLoop LessThan(i, nl) {
            prod = Add(Multiply(BI__Limb(save, i), m), carry)
            BI__SetLimb(save, i, BitwiseAnd(prod, BIConst.MASK))
            carry = ShiftRight(prod, 32)
            i = Add(i, 1)
        }
        WhileLoop NotEqual(carry, 0) {
            nbi = BI__Ensure(save, Add(nl, 1))
            IfCondition EqualTo(nbi, 0) ThenBlock: { ReturnValue(0) }
            save = nbi
            BI__SetLimb(save, nl, BitwiseAnd(carry, BIConst.MASK))
            nl = Add(nl, 1)
            StoreValue(Add(save, 8), nl)
            carry = ShiftRight(carry, 32)
        }
        ReturnValue(save)
    }
}

Function.JSRT_CreateBigIntFromStr {
    Input: sptr: Address
    Input: slen: Integer
    Output: Address
    Body: {
        bi = BI__ParseDigits(sptr, slen)
        IfCondition EqualTo(bi, 0) ThenBlock: { ReturnValue(0) }
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.BIGINT)
        StoreValue(Add(val, 8), bi)
        ReturnValue(val)
    }
}

// Clone heap + JSValue
Function.JSRT_BigIntClone {
    Input: v: Address
    Output: Address
    Body: {
        save = v
        IfCondition EqualTo(save, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Dereference(save), JSType.BIGINT) ThenBlock: { ReturnValue(0) }
        src = Dereference(Add(save, 8))
        nl = Dereference(Add(src, 8))
        bi = BI__Alloc(nl)
        IfCondition EqualTo(bi, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(bi, Dereference(src))
        StoreValue(Add(bi, 8), nl)
        i = 0
        WhileLoop LessThan(i, nl) {
            BI__SetLimb(bi, i, BI__Limb(src, i))
            i = Add(i, 1)
        }
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.BIGINT)
        StoreValue(Add(val, 8), bi)
        ReturnValue(val)
    }
}

// =============================================================================
// COMPARE / MAGNITUDE
// =============================================================================

// Compare absolute values: -1 if |a|<|b|, 0 equal, 1 if |a|>|b|
Function.BI__CmpAbs {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        na = Dereference(Add(a, 8))
        nb = Dereference(Add(b, 8))
        IfCondition LessThan(na, nb) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(na, nb) ThenBlock: { ReturnValue(1) }
        i = Subtract(na, 1)
        WhileLoop GreaterEqual(i, 0) {
            la = BI__Limb(a, i)
            lb = BI__Limb(b, i)
            IfCondition LessThan(la, lb) ThenBlock: { ReturnValue(-1) }
            IfCondition GreaterThan(la, lb) ThenBlock: { ReturnValue(1) }
            i = Subtract(i, 1)
        }
        ReturnValue(0)
    }
}

// Mathematical compare of two bigint heap objects: -1, 0, 1
Function.BI__Cmp {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        sa = Dereference(a)
        sb = Dereference(b)
        // zeros
        IfCondition And(EqualTo(Dereference(Add(a, 8)), 1), EqualTo(BI__Limb(a, 0), 0)) ThenBlock: {
            IfCondition And(EqualTo(Dereference(Add(b, 8)), 1), EqualTo(BI__Limb(b, 0), 0)) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition NotEqual(sa, sb) ThenBlock: {
            IfCondition EqualTo(sa, 1) ThenBlock: { ReturnValue(-1) }
            ReturnValue(1)
        }
        c = BI__CmpAbs(a, b)
        IfCondition EqualTo(sa, 1) ThenBlock: {
            // both negative: reverse
            ReturnValue(Subtract(0, c))
        }
        ReturnValue(c)
    }
}

Function.JSRT_BigIntCompare {
    Input: av: Address
    Input: bv: Address
    Output: Integer
    Body: {
        a = Dereference(Add(av, 8))
        b = Dereference(Add(bv, 8))
        ReturnValue(BI__Cmp(a, b))
    }
}

// =============================================================================
// ARITHMETIC
// =============================================================================

Function.BI__AddAbs {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        na = Dereference(Add(a, 8))
        nb = Dereference(Add(b, 8))
        n = na
        IfCondition GreaterThan(nb, n) ThenBlock: { n = nb }
        r = BI__Alloc(Add(n, 1))
        IfCondition EqualTo(r, 0) ThenBlock: { ReturnValue(0) }
        carry = 0
        i = 0
        WhileLoop LessThan(i, n) {
            la = 0
            lb = 0
            IfCondition LessThan(i, na) ThenBlock: { la = BI__Limb(a, i) }
            IfCondition LessThan(i, nb) ThenBlock: { lb = BI__Limb(b, i) }
            sum = Add(Add(la, lb), carry)
            BI__SetLimb(r, i, BitwiseAnd(sum, BIConst.MASK))
            carry = ShiftRight(sum, 32)
            i = Add(i, 1)
        }
        IfCondition NotEqual(carry, 0) ThenBlock: {
            BI__SetLimb(r, n, carry)
            StoreValue(Add(r, 8), Add(n, 1))
        } ElseBlock: {
            StoreValue(Add(r, 8), n)
        }
        BI__Normalize(r)
        ReturnValue(r)
    }
}

Function.BI__SubAbs {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        // assume |a| >= |b|
        na = Dereference(Add(a, 8))
        nb = Dereference(Add(b, 8))
        r = BI__Alloc(na)
        IfCondition EqualTo(r, 0) ThenBlock: { ReturnValue(0) }
        borrow = 0
        i = 0
        WhileLoop LessThan(i, na) {
            la = BI__Limb(a, i)
            lb = 0
            IfCondition LessThan(i, nb) ThenBlock: { lb = BI__Limb(b, i) }
            // la - lb - borrow
            diff = Subtract(Subtract(la, lb), borrow)
            IfCondition LessThan(diff, 0) ThenBlock: {
                // borrow from higher
                diff = Add(diff, BIConst.BASE)
                borrow = 1
            } ElseBlock: {
                borrow = 0
            }
            BI__SetLimb(r, i, BitwiseAnd(diff, BIConst.MASK))
            i = Add(i, 1)
        }
        StoreValue(Add(r, 8), na)
        BI__Normalize(r)
        ReturnValue(r)
    }
}

Function.JSRT_BigIntAdd {
    Input: av: Address
    Input: bv: Address
    Output: Address
    Body: {
        a = Dereference(Add(av, 8))
        b = Dereference(Add(bv, 8))
        sa = Dereference(a)
        sb = Dereference(b)
        IfCondition EqualTo(sa, sb) ThenBlock: {
            r = BI__AddAbs(a, b)
            IfCondition EqualTo(r, 0) ThenBlock: { ReturnValue(0) }
            StoreValue(r, sa)
        } ElseBlock: {
            c = BI__CmpAbs(a, b)
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(JSRT_CreateBigIntZero())
            }
            IfCondition GreaterThan(c, 0) ThenBlock: {
                r = BI__SubAbs(a, b)
                IfCondition EqualTo(r, 0) ThenBlock: { ReturnValue(0) }
                StoreValue(r, sa)
            } ElseBlock: {
                r = BI__SubAbs(b, a)
                IfCondition EqualTo(r, 0) ThenBlock: { ReturnValue(0) }
                StoreValue(r, sb)
            }
        }
        BI__Normalize(r)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.BIGINT)
        StoreValue(Add(val, 8), r)
        ReturnValue(val)
    }
}

Function.JSRT_BigIntSub {
    Input: av: Address
    Input: bv: Address
    Output: Address
    Body: {
        // a - b = a + (-b)
        b = Dereference(Add(bv, 8))
        nb = JSRT_BigIntClone(bv)
        IfCondition EqualTo(nb, 0) ThenBlock: { ReturnValue(0) }
        hb = Dereference(Add(nb, 8))
        // flip sign unless zero
        IfCondition NotEqual(And(EqualTo(Dereference(Add(hb, 8)), 1), EqualTo(BI__Limb(hb, 0), 0)), 1) ThenBlock: {
            StoreValue(hb, BitwiseXor(Dereference(hb), 1))
        }
        ReturnValue(JSRT_BigIntAdd(av, nb))
    }
}

Function.JSRT_BigIntMul {
    Input: av: Address
    Input: bv: Address
    Output: Address
    Body: {
        a = Dereference(Add(av, 8))
        b = Dereference(Add(bv, 8))
        na = Dereference(Add(a, 8))
        nb = Dereference(Add(b, 8))
        r = BI__Alloc(Add(na, nb))
        IfCondition EqualTo(r, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(r, 8), Add(na, nb))
        i = 0
        WhileLoop LessThan(i, na) {
            carry = 0
            la = BI__Limb(a, i)
            j = 0
            WhileLoop LessThan(j, nb) {
                // r[i+j] + la*lb + carry
                idx = Add(i, j)
                prod = Add(Add(Multiply(la, BI__Limb(b, j)), BI__Limb(r, idx)), carry)
                BI__SetLimb(r, idx, BitwiseAnd(prod, BIConst.MASK))
                carry = ShiftRight(prod, 32)
                j = Add(j, 1)
            }
            IfCondition NotEqual(carry, 0) ThenBlock: {
                BI__SetLimb(r, Add(i, nb), carry)
            }
            i = Add(i, 1)
        }
        // sign
        sa = Dereference(a)
        sb = Dereference(b)
        IfCondition EqualTo(sa, sb) ThenBlock: {
            StoreValue(r, 0)
        } ElseBlock: {
            StoreValue(r, 1)
        }
        BI__Normalize(r)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.BIGINT)
        StoreValue(Add(val, 8), r)
        ReturnValue(val)
    }
}

// Division: returns quotient; if rem_out != 0, stores remainder heap there via pointer
// Simplified long division
Function.BI__DivModAbs {
    Input: num: Address
    Input: den: Address
    Input: want_rem: Integer
    Output: Address
    Body: {
        // returns quotient heap; remainder in BITmp if want_rem
        c = BI__CmpAbs(num, den)
        IfCondition LessThan(c, 0) ThenBlock: {
            // q=0, rem=num
            q = BI__Alloc(1)
            BI__SetLimb(q, 0, 0)
            StoreValue(Add(q, 8), 1)
            IfCondition EqualTo(want_rem, 1) ThenBlock: {
                // clone num as rem into global temp — use return pair via BIRem
                BIState.rem = 0
                // store rem clone
                nl = Dereference(Add(num, 8))
                rem = BI__Alloc(nl)
                i = 0
                WhileLoop LessThan(i, nl) {
                    BI__SetLimb(rem, i, BI__Limb(num, i))
                    i = Add(i, 1)
                }
                StoreValue(Add(rem, 8), nl)
                StoreValue(rem, 0)
                BIState.rem = rem
            }
            ReturnValue(q)
        }
        IfCondition EqualTo(c, 0) ThenBlock: {
            q = BI__Alloc(1)
            BI__SetLimb(q, 0, 1)
            StoreValue(Add(q, 8), 1)
            IfCondition EqualTo(want_rem, 1) ThenBlock: {
                rem = BI__Alloc(1)
                BI__SetLimb(rem, 0, 0)
                BIState.rem = rem
            }
            ReturnValue(q)
        }
        // Binary long division via bit-by-bit for correctness (simpler than Knuth)
        // Convert to bit length and do restoring division
        na = Dereference(Add(num, 8))
        // Work clones
        u = BI__Alloc(Add(na, 1))
        i = 0
        WhileLoop LessThan(i, na) {
            BI__SetLimb(u, i, BI__Limb(num, i))
            i = Add(i, 1)
        }
        StoreValue(Add(u, 8), na)
        StoreValue(u, 0)
        q = BI__Alloc(na)
        StoreValue(Add(q, 8), na)
        // bit length of num
        top = BI__Limb(num, Subtract(na, 1))
        bits = Multiply(Subtract(na, 1), 32)
        b = 31
        WhileLoop GreaterThan(b, 0) {
            IfCondition NotEqual(BitwiseAnd(top, ShiftLeft(1, b)), 0) ThenBlock: {
                bits = Add(bits, b)
                b = 0
            } ElseBlock: {
                b = Subtract(b, 1)
            }
        }
        bits = Add(bits, 1)
        // rem starts 0
        rem = BI__Alloc(Add(na, 1))
        StoreValue(Add(rem, 8), 1)
        BI__SetLimb(rem, 0, 0)
        k = Subtract(bits, 1)
        WhileLoop GreaterEqual(k, 0) {
            // rem = rem*2 + bit(num,k)
            rem = BI__MulAddSmall(rem, 2, BI__GetBit(num, k))
            IfCondition GreaterEqual(BI__CmpAbs(rem, den), 0) ThenBlock: {
                rem2 = BI__SubAbs(rem, den)
                rem = rem2
                BI__SetBit(q, k)
            }
            k = Subtract(k, 1)
        }
        BI__Normalize(q)
        IfCondition EqualTo(want_rem, 1) ThenBlock: {
            BI__Normalize(rem)
            BIState.rem = rem
        }
        ReturnValue(q)
    }
}

Function.BI__GetBit {
    Input: bi: Address
    Input: bit: Integer
    Output: Integer
    Body: {
        li = ShiftRight(bit, 5)
        nl = Dereference(Add(bi, 8))
        IfCondition GreaterEqual(li, nl) ThenBlock: { ReturnValue(0) }
        off = BitwiseAnd(bit, 31)
        ReturnValue(BitwiseAnd(ShiftRight(BI__Limb(bi, li), off), 1))
    }
}

Function.BI__SetBit {
    Input: bi: Address
    Input: bit: Integer
    Output: Integer
    Body: {
        li = ShiftRight(bit, 5)
        nl = Dereference(Add(bi, 8))
        IfCondition GreaterEqual(li, nl) ThenBlock: {
            nbi = BI__Ensure(bi, Add(li, 1))
            IfCondition EqualTo(nbi, 0) ThenBlock: { ReturnValue(0) }
            // if reallocated, caller must use return — for q we allocated enough
            bi = nbi
            WhileLoop LessEqual(nl, li) {
                BI__SetLimb(bi, nl, 0)
                nl = Add(nl, 1)
            }
            StoreValue(Add(bi, 8), nl)
        }
        off = BitwiseAnd(bit, 31)
        v = BitwiseOr(BI__Limb(bi, li), ShiftLeft(1, off))
        BI__SetLimb(bi, li, v)
        ReturnValue(1)
    }
}

FixedPool.BIState {
    "rem": Initialize=0
}

Function.JSRT_BigIntDiv {
    Input: av: Address
    Input: bv: Address
    Output: Address
    Body: {
        a = Dereference(Add(av, 8))
        b = Dereference(Add(bv, 8))
        // div by zero
        IfCondition And(EqualTo(Dereference(Add(b, 8)), 1), EqualTo(BI__Limb(b, 0), 0)) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Division by zero")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        q = BI__DivModAbs(a, b, 0)
        IfCondition EqualTo(q, 0) ThenBlock: { ReturnValue(0) }
        sa = Dereference(a)
        sb = Dereference(b)
        IfCondition EqualTo(sa, sb) ThenBlock: {
            StoreValue(q, 0)
        } ElseBlock: {
            StoreValue(q, 1)
        }
        BI__Normalize(q)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.BIGINT)
        StoreValue(Add(val, 8), q)
        ReturnValue(val)
    }
}

Function.JSRT_BigIntMod {
    Input: av: Address
    Input: bv: Address
    Output: Address
    Body: {
        a = Dereference(Add(av, 8))
        b = Dereference(Add(bv, 8))
        IfCondition And(EqualTo(Dereference(Add(b, 8)), 1), EqualTo(BI__Limb(b, 0), 0)) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Division by zero")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        q = BI__DivModAbs(a, b, 1)
        IfCondition EqualTo(q, 0) ThenBlock: { ReturnValue(0) }
        rem = BIState.rem
        // remainder sign follows dividend (ES)
        StoreValue(rem, Dereference(a))
        BI__Normalize(rem)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.BIGINT)
        StoreValue(Add(val, 8), rem)
        ReturnValue(val)
    }
}

Function.JSRT_BigIntNeg {
    Input: av: Address
    Output: Address
    Body: {
        r = JSRT_BigIntClone(av)
        IfCondition EqualTo(r, 0) ThenBlock: { ReturnValue(0) }
        h = Dereference(Add(r, 8))
        IfCondition NotEqual(And(EqualTo(Dereference(Add(h, 8)), 1), EqualTo(BI__Limb(h, 0), 0)), 1) ThenBlock: {
            StoreValue(h, BitwiseXor(Dereference(h), 1))
        }
        ReturnValue(r)
    }
}

// =============================================================================
// BITWISE (two's complement infinite sign extension semantics)
// =============================================================================

// Convert signed bigint to two's complement limb array with at least n limbs
Function.BI__ToTwos {
    Input: bi: Address
    Input: nlimbs: Integer
    Output: Address
    Body: {
        n = nlimbs
        r = BI__Alloc(n)
        IfCondition EqualTo(r, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(r, 8), n)
        nl = Dereference(Add(bi, 8))
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition LessThan(i, nl) ThenBlock: {
                BI__SetLimb(r, i, BI__Limb(bi, i))
            } ElseBlock: {
                BI__SetLimb(r, i, 0)
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(Dereference(bi), 1) ThenBlock: {
            // negate: ~x + 1
            i = 0
            WhileLoop LessThan(i, n) {
                BI__SetLimb(r, i, BitwiseXor(BI__Limb(r, i), BIConst.MASK))
                i = Add(i, 1)
            }
            // add 1
            carry = 1
            i = 0
            WhileLoop And(LessThan(i, n), NotEqual(carry, 0)) {
                sum = Add(BI__Limb(r, i), carry)
                BI__SetLimb(r, i, BitwiseAnd(sum, BIConst.MASK))
                carry = ShiftRight(sum, 32)
                i = Add(i, 1)
            }
        }
        StoreValue(r, 0)
        ReturnValue(r)
    }
}

Function.BI__FromTwos {
    Input: tw: Address
    Output: Address
    Body: {
        n = Dereference(Add(tw, 8))
        // negative if high bit of top limb set
        top = BI__Limb(tw, Subtract(n, 1))
        neg = 0
        IfCondition NotEqual(BitwiseAnd(top, 2147483648), 0) ThenBlock: {
            neg = 1
        }
        r = BI__Alloc(n)
        IfCondition EqualTo(r, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n) {
            BI__SetLimb(r, i, BI__Limb(tw, i))
            i = Add(i, 1)
        }
        StoreValue(Add(r, 8), n)
        IfCondition EqualTo(neg, 1) ThenBlock: {
            // convert back: ~(x-1) = -x absolute
            // subtract 1 then invert
            borrow = 1
            i = 0
            WhileLoop LessThan(i, n) {
                la = BI__Limb(r, i)
                IfCondition EqualTo(borrow, 1) ThenBlock: {
                    IfCondition EqualTo(la, 0) ThenBlock: {
                        BI__SetLimb(r, i, BIConst.MASK)
                        borrow = 1
                    } ElseBlock: {
                        BI__SetLimb(r, i, Subtract(la, 1))
                        borrow = 0
                    }
                }
                i = Add(i, 1)
            }
            i = 0
            WhileLoop LessThan(i, n) {
                BI__SetLimb(r, i, BitwiseXor(BI__Limb(r, i), BIConst.MASK))
                i = Add(i, 1)
            }
            StoreValue(r, 1)
        } ElseBlock: {
            StoreValue(r, 0)
        }
        BI__Normalize(r)
        ReturnValue(r)
    }
}

Function.JSRT_BigIntBitAnd {
    Input: av: Address
    Input: bv: Address
    Output: Address
    Body: {
        a = Dereference(Add(av, 8))
        b = Dereference(Add(bv, 8))
        na = Dereference(Add(a, 8))
        nb = Dereference(Add(b, 8))
        n = na
        IfCondition GreaterThan(nb, n) ThenBlock: { n = nb }
        n = Add(n, 1)
        ta = BI__ToTwos(a, n)
        tb = BI__ToTwos(b, n)
        i = 0
        WhileLoop LessThan(i, n) {
            BI__SetLimb(ta, i, BitwiseAnd(BI__Limb(ta, i), BI__Limb(tb, i)))
            i = Add(i, 1)
        }
        r = BI__FromTwos(ta)
        val = JSRT__AllocValue()
        StoreValue(val, JSType.BIGINT)
        StoreValue(Add(val, 8), r)
        ReturnValue(val)
    }
}

Function.JSRT_BigIntBitOr {
    Input: av: Address
    Input: bv: Address
    Output: Address
    Body: {
        a = Dereference(Add(av, 8))
        b = Dereference(Add(bv, 8))
        na = Dereference(Add(a, 8))
        nb = Dereference(Add(b, 8))
        n = na
        IfCondition GreaterThan(nb, n) ThenBlock: { n = nb }
        n = Add(n, 1)
        ta = BI__ToTwos(a, n)
        tb = BI__ToTwos(b, n)
        i = 0
        WhileLoop LessThan(i, n) {
            BI__SetLimb(ta, i, BitwiseOr(BI__Limb(ta, i), BI__Limb(tb, i)))
            i = Add(i, 1)
        }
        r = BI__FromTwos(ta)
        val = JSRT__AllocValue()
        StoreValue(val, JSType.BIGINT)
        StoreValue(Add(val, 8), r)
        ReturnValue(val)
    }
}

Function.JSRT_BigIntBitXor {
    Input: av: Address
    Input: bv: Address
    Output: Address
    Body: {
        a = Dereference(Add(av, 8))
        b = Dereference(Add(bv, 8))
        na = Dereference(Add(a, 8))
        nb = Dereference(Add(b, 8))
        n = na
        IfCondition GreaterThan(nb, n) ThenBlock: { n = nb }
        n = Add(n, 1)
        ta = BI__ToTwos(a, n)
        tb = BI__ToTwos(b, n)
        i = 0
        WhileLoop LessThan(i, n) {
            BI__SetLimb(ta, i, BitwiseXor(BI__Limb(ta, i), BI__Limb(tb, i)))
            i = Add(i, 1)
        }
        r = BI__FromTwos(ta)
        val = JSRT__AllocValue()
        StoreValue(val, JSType.BIGINT)
        StoreValue(Add(val, 8), r)
        ReturnValue(val)
    }
}

Function.JSRT_BigIntBitNot {
    Input: av: Address
    Output: Address
    Body: {
        // ~x = -x - 1
        neg = JSRT_BigIntNeg(av)
        one = JSRT_CreateBigIntFromInt(1)
        ReturnValue(JSRT_BigIntSub(neg, one))
    }
}

Function.JSRT_BigIntShl {
    Input: av: Address
    Input: bv: Address
    Output: Address
    Body: {
        // shift amount must fit; if negative shift, do shr
        b = Dereference(Add(bv, 8))
        IfCondition EqualTo(Dereference(b), 1) ThenBlock: {
            // negative count → right shift by abs
            pos = JSRT_BigIntNeg(bv)
            ReturnValue(JSRT_BigIntShr(av, pos))
        }
        // get shift as host int if small
        sh = BI__ToHostInt(b)
        IfCondition LessThan(sh, 0) ThenBlock: { sh = 0 }
        IfCondition GreaterThan(sh, 1048576) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Maximum BigInt size exceeded")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        a = Dereference(Add(av, 8))
        na = Dereference(Add(a, 8))
        limb_shift = ShiftRight(sh, 5)
        bit_shift = BitwiseAnd(sh, 31)
        r = BI__Alloc(Add(Add(na, limb_shift), 2))
        StoreValue(r, Dereference(a))
        // zero low limbs
        i = 0
        WhileLoop LessThan(i, limb_shift) {
            BI__SetLimb(r, i, 0)
            i = Add(i, 1)
        }
        carry = 0
        i = 0
        WhileLoop LessThan(i, na) {
            la = BI__Limb(a, i)
            IfCondition EqualTo(bit_shift, 0) ThenBlock: {
                BI__SetLimb(r, Add(i, limb_shift), la)
            } ElseBlock: {
                out = BitwiseOr(ShiftLeft(la, bit_shift), carry)
                BI__SetLimb(r, Add(i, limb_shift), BitwiseAnd(out, BIConst.MASK))
                carry = ShiftRight(la, Subtract(32, bit_shift))
            }
            i = Add(i, 1)
        }
        nout = Add(na, limb_shift)
        IfCondition NotEqual(carry, 0) ThenBlock: {
            BI__SetLimb(r, nout, carry)
            nout = Add(nout, 1)
        }
        StoreValue(Add(r, 8), nout)
        BI__Normalize(r)
        val = JSRT__AllocValue()
        StoreValue(val, JSType.BIGINT)
        StoreValue(Add(val, 8), r)
        ReturnValue(val)
    }
}

Function.BI__ToHostInt {
    Input: bi: Address
    Output: Integer
    Body: {
        nl = Dereference(Add(bi, 8))
        IfCondition GreaterThan(nl, 2) ThenBlock: { ReturnValue(2147483647) }
        lo = BI__Limb(bi, 0)
        hi = 0
        IfCondition GreaterThan(nl, 1) ThenBlock: { hi = BI__Limb(bi, 1) }
        // combine
        v = BitwiseOr(lo, ShiftLeft(hi, 32))
        IfCondition EqualTo(Dereference(bi), 1) ThenBlock: {
            v = Subtract(0, v)
        }
        ReturnValue(v)
    }
}

Function.JSRT_BigIntShr {
    Input: av: Address
    Input: bv: Address
    Output: Address
    Body: {
        b = Dereference(Add(bv, 8))
        IfCondition EqualTo(Dereference(b), 1) ThenBlock: {
            pos = JSRT_BigIntNeg(bv)
            ReturnValue(JSRT_BigIntShl(av, pos))
        }
        sh = BI__ToHostInt(b)
        IfCondition LessThan(sh, 0) ThenBlock: { sh = 0 }
        a = Dereference(Add(av, 8))
        // arithmetic shift for negative
        na = Dereference(Add(a, 8))
        ntw = Add(na, 1)
        tw = BI__ToTwos(a, ntw)
        limb_shift = ShiftRight(sh, 5)
        bit_shift = BitwiseAnd(sh, 31)
        r = BI__Alloc(ntw)
        StoreValue(Add(r, 8), ntw)
        // sign fill
        fill = 0
        IfCondition EqualTo(Dereference(a), 1) ThenBlock: {
            fill = BIConst.MASK
        }
        i = 0
        WhileLoop LessThan(i, ntw) {
            src = Add(i, limb_shift)
            IfCondition GreaterEqual(src, ntw) ThenBlock: {
                BI__SetLimb(r, i, fill)
            } ElseBlock: {
                la = BI__Limb(tw, src)
                IfCondition EqualTo(bit_shift, 0) ThenBlock: {
                    BI__SetLimb(r, i, la)
                } ElseBlock: {
                    hb = fill
                    IfCondition LessThan(Add(src, 1), ntw) ThenBlock: {
                        hb = BI__Limb(tw, Add(src, 1))
                    }
                    out = BitwiseOr(ShiftRight(la, bit_shift), ShiftLeft(hb, Subtract(32, bit_shift)))
                    BI__SetLimb(r, i, BitwiseAnd(out, BIConst.MASK))
                }
            }
            i = Add(i, 1)
        }
        res = BI__FromTwos(r)
        val = JSRT__AllocValue()
        StoreValue(val, JSType.BIGINT)
        StoreValue(Add(val, 8), res)
        ReturnValue(val)
    }
}

// =============================================================================
// POWER
// =============================================================================

Function.JSRT_BigIntPow {
    Input: av: Address
    Input: bv: Address
    Output: Address
    Body: {
        b = Dereference(Add(bv, 8))
        IfCondition EqualTo(Dereference(b), 1) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Exponent must be positive")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        // exp 0 → 1
        IfCondition And(EqualTo(Dereference(Add(b, 8)), 1), EqualTo(BI__Limb(b, 0), 0)) ThenBlock: {
            ReturnValue(JSRT_CreateBigIntFromInt(1))
        }
        // binary exponentiation
        result = JSRT_CreateBigIntFromInt(1)
        base = JSRT_BigIntClone(av)
        exp = JSRT_BigIntClone(bv)
        one = JSRT_CreateBigIntFromInt(1)
        two = JSRT_CreateBigIntFromInt(2)
        zero = JSRT_CreateBigIntZero()
        // while exp > 0
        WhileLoop GreaterThan(JSRT_BigIntCompare(exp, zero), 0) {
            // if exp odd
            eh = Dereference(Add(exp, 8))
            IfCondition EqualTo(BitwiseAnd(BI__Limb(eh, 0), 1), 1) ThenBlock: {
                result = JSRT_BigIntMul(result, base)
            }
            base = JSRT_BigIntMul(base, base)
            exp = JSRT_BigIntShr(exp, one)
        }
        ReturnValue(result)
    }
}

// =============================================================================
// TO STRING
// =============================================================================

Function.JSRT_BigIntToString {
    Input: av: Address
    Input: radix: Integer
    Output: Address
    Body: {
        save = av
        rdx = radix
        IfCondition Or(LessThan(rdx, 2), GreaterThan(rdx, 36)) ThenBlock: {
            rdx = 10
        }
        h = Dereference(Add(save, 8))
        IfCondition And(EqualTo(Dereference(Add(h, 8)), 1), EqualTo(BI__Limb(h, 0), 0)) ThenBlock: {
            ReturnValue(JSRT_CreateString("0"))
        }
        // clone for destructive div
        tmp = JSRT_BigIntClone(save)
        th = Dereference(Add(tmp, 8))
        StoreValue(th, 0)
        // digits reverse
        digs = Allocate(8192)
        MemorySet(digs, 0, 8192)
        nd = 0
        zero_h = BI__Alloc(1)
        BI__SetLimb(zero_h, 0, 0)
        WhileLoop GreaterThan(BI__CmpAbs(th, zero_h), 0) {
            // divmod by radix
            q = BI__DivModAbs(th, BI__Small(rdx), 1)
            rem = BIState.rem
            d = BI__Limb(rem, 0)
            IfCondition LessThan(d, 10) ThenBlock: {
                SetByte(digs, nd, Add(48, d))
            } ElseBlock: {
                SetByte(digs, nd, Add(87, d))
            }
            nd = Add(nd, 1)
            th = q
            StoreValue(Add(tmp, 8), th)
            IfCondition GreaterThan(nd, 8000) ThenBlock: {
                // safety
                th = zero_h
            }
        }
        // reverse into result
        sign = Dereference(h)
        out_len = nd
        IfCondition EqualTo(sign, 1) ThenBlock: { out_len = Add(out_len, 1) }
        out = JSRT__StrSlabAlloc(Add(out_len, 1))
        pos = 0
        IfCondition EqualTo(sign, 1) ThenBlock: {
            SetByte(out, 0, 45)
            pos = 1
        }
        i = Subtract(nd, 1)
        WhileLoop GreaterEqual(i, 0) {
            SetByte(out, pos, GetByte(digs, i))
            pos = Add(pos, 1)
            i = Subtract(i, 1)
        }
        SetByte(out, pos, 0)
        ReturnValue(JSRT_CreateString(out))
    }
}

Function.BI__Small {
    Input: n: Integer
    Output: Address
    Body: {
        bi = BI__Alloc(1)
        BI__SetLimb(bi, 0, BitwiseAnd(n, BIConst.MASK))
        StoreValue(Add(bi, 8), 1)
        StoreValue(bi, 0)
        ReturnValue(bi)
    }
}

// =============================================================================
// CONVERSIONS
// =============================================================================

// ToBigInt from Number: must be integral finite.
// Decompose IEEE-754 double bits so values beyond 2^53 (incl. MAX_VALUE) work.
Function.JSRT_NumberToBigInt {
    Input: nv: Address
    Output: Address
    Body: {
        bits = Dereference(Add(nv, 8))
        // exp field bits 62..52 = 0x7FF0000000000000
        exp_field = BitwiseAnd(bits, 9218868437227405312)
        IfCondition EqualTo(exp_field, 9218868437227405312) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Number is not a safe integer for BigInt")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        // sign: bit 63 (bits < 0 in signed interpretation)
        sign = 0
        IfCondition LessThan(bits, 0) ThenBlock: { sign = 1 }
        // unbiased raw exp 0..2046 (shift of masked field is non-negative)
        raw_exp = ShiftRight(exp_field, 52)
        // 52-bit fraction
        frac = BitwiseAnd(bits, 4503599627370495)
        // ±0
        IfCondition And(EqualTo(raw_exp, 0), EqualTo(frac, 0)) ThenBlock: {
            ReturnValue(JSRT_CreateBigIntZero())
        }
        // subnormals: |x| < 1 → not an integer (except 0 handled above)
        IfCondition EqualTo(raw_exp, 0) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "The number is not an integer")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        // significand = 2^52 + frac ; value = significand * 2^(raw_exp - 1075)
        // 2^52 = 4503599627370496; sig in [2^52, 2^53) fits signed i64
        sig_lo = Add(frac, 4503599627370496)
        sh = JSRT_CreateBigIntFromInt(sig_lo)
        IfCondition EqualTo(sh, 0) ThenBlock: { ReturnValue(0) }
        // e = raw_exp - 1075
        e = Subtract(raw_exp, 1075)
        IfCondition GreaterEqual(e, 0) ThenBlock: {
            // significand << e
            IfCondition GreaterThan(e, 0) ThenBlock: {
                e_bi = JSRT_CreateBigIntFromInt(e)
                sh = JSRT_BigIntShl(sh, e_bi)
                IfCondition EqualTo(sh, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(0) }
            }
        }
        IfCondition LessThan(e, 0) ThenBlock: {
            // must be divisible by 2^(-e); else not an integer
            ne = Subtract(0, e)
            // check low ne bits of significand are zero via mod 2^ne
            // for ne < 53, check frac/sig bits
            IfCondition GreaterThan(ne, 53) ThenBlock: {
                // |x| < 1 for ne > 53 with normal form? actually raw_exp - 1075 < -53
                // means value < 1 → not integer
                terr = JSVM_CreateTypedError("RangeError", "The number is not an integer")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                ReturnValue(0)
            }
            // mask = (1 << ne) - 1; if (sig_lo & mask) != 0 → fractional
            one_shift = ShiftLeft(1, ne)
            mask = Subtract(one_shift, 1)
            IfCondition NotEqual(BitwiseAnd(sig_lo, mask), 0) ThenBlock: {
                terr = JSVM_CreateTypedError("RangeError", "The number is not an integer")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                ReturnValue(0)
            }
            // arithmetic shr of bigint
            e_bi = JSRT_CreateBigIntFromInt(ne)
            sh = JSRT_BigIntShr(sh, e_bi)
            IfCondition EqualTo(sh, 0) ThenBlock: { ReturnValue(0) }
        }
        // apply sign
        IfCondition EqualTo(sign, 1) ThenBlock: {
            sh = JSRT_BigIntNeg(sh)
        }
        ReturnValue(sh)
    }
}

// ToBigInt abstract (from any)
Function.JSRT_ToBigInt {
    Input: val: Address
    Output: Address
    Body: {
        save = val
        IfCondition EqualTo(save, 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined to BigInt")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        t = Dereference(save)
        IfCondition EqualTo(t, JSType.BIGINT) ThenBlock: { ReturnValue(save) }
        IfCondition EqualTo(t, JSType.BOOLEAN) ThenBlock: {
            IfCondition EqualTo(Dereference(Add(save, 8)), 1) ThenBlock: {
                ReturnValue(JSRT_CreateBigIntFromInt(1))
            }
            ReturnValue(JSRT_CreateBigIntZero())
        }
        IfCondition EqualTo(t, JSType.STRING) ThenBlock: {
            sp = Dereference(Add(save, 8))
            sl = JSRT_StrLen(sp)
            // trim whitespace
            bi = BI__ParseDigits(sp, sl)
            IfCondition EqualTo(bi, 0) ThenBlock: {
                // try trim
                // SyntaxError for invalid
                terr = JSVM_CreateTypedError("SyntaxError", "Cannot convert string to BigInt")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                ReturnValue(0)
            }
            val2 = JSRT__AllocValue()
            StoreValue(val2, JSType.BIGINT)
            StoreValue(Add(val2, 8), bi)
            ReturnValue(val2)
        }
        IfCondition EqualTo(t, JSType.NUMBER) ThenBlock: {
            ReturnValue(JSRT_NumberToBigInt(save))
        }
        IfCondition EqualTo(JSVM_IsSymbol(save), 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot convert Symbol to BigInt")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        IfCondition Or(EqualTo(t, JSType.UNDEFINED), EqualTo(t, JSType.NULL)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to BigInt")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        // Object: ToPrimitive then retry
        prim = JSRT_ToPrimitive(save, 0)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(prim, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(JSRT_ToBigInt(prim))
    }
}

// BigInt.asIntN / asUintN
Function.JSRT_BigIntAsIntN {
    Input: bits: Integer
    Input: av: Address
    Output: Address
    Body: {
        // bits must be non-neg; mod 2^bits in two's complement
        IfCondition LessEqual(bits, 0) ThenBlock: {
            ReturnValue(JSRT_CreateBigIntZero())
        }
        // v mod 2^bits
        two = JSRT_CreateBigIntFromInt(2)
        bts = JSRT_CreateBigIntFromInt(bits)
        mod = JSRT_BigIntPow(two, bts)
        // use bitwise: and with (2^n - 1) then sign extend if asIntN
        // simplified: mod abs then adjust
        m = Dereference(Add(mod, 8))
        // 2^bits - 1 mask
        one = JSRT_CreateBigIntFromInt(1)
        maskv = JSRT_BigIntSub(mod, one)
        // for asIntN: 
        r = JSRT_BigIntBitAnd(av, maskv)
        // if r >= 2^(bits-1), r -= 2^bits
        half_bits = Subtract(bits, 1)
        IfCondition GreaterThan(half_bits, 0) ThenBlock: {
            hb = JSRT_CreateBigIntFromInt(half_bits)
            half = JSRT_BigIntPow(two, hb)
            IfCondition GreaterEqual(JSRT_BigIntCompare(r, half), 0) ThenBlock: {
                r = JSRT_BigIntSub(r, mod)
            }
        }
        ReturnValue(r)
    }
}

Function.JSRT_BigIntAsUintN {
    Input: bits: Integer
    Input: av: Address
    Output: Address
    Body: {
        IfCondition LessEqual(bits, 0) ThenBlock: {
            ReturnValue(JSRT_CreateBigIntZero())
        }
        two = JSRT_CreateBigIntFromInt(2)
        bts = JSRT_CreateBigIntFromInt(bits)
        mod = JSRT_BigIntPow(two, bts)
        one = JSRT_CreateBigIntFromInt(1)
        maskv = JSRT_BigIntSub(mod, one)
        ReturnValue(JSRT_BigIntBitAnd(av, maskv))
    }
}
