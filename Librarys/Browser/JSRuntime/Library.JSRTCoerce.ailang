// =============================================================================
// TYPE COERCION — ToPrimitive (OrdinaryToPrimitive + wrapper unbox)
// hint: 0 = default/number (valueOf then toString), 1 = string (toString then valueOf)
// Returns a primitive JSValue, or 0 if CallFunc threw (exc_prop already set).
// =============================================================================
Function.JSRT_ToPrimitive {
    Input: val: Address
    Input: hint: Integer
    Output: Address
    Body: {
        save_val = val
        save_hint = hint
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        vt = JSRT_GetType(save_val)
        // Already primitive
        IfCondition EqualTo(vt, JSType.UNDEFINED) ThenBlock: { ReturnValue(save_val) }
        IfCondition EqualTo(vt, JSType.NULL) ThenBlock: { ReturnValue(save_val) }
        IfCondition EqualTo(vt, JSType.BOOLEAN) ThenBlock: { ReturnValue(save_val) }
        IfCondition EqualTo(vt, JSType.NUMBER) ThenBlock: { ReturnValue(save_val) }
        IfCondition EqualTo(vt, JSType.STRING) ThenBlock: { ReturnValue(save_val) }

        // OBJECT wrappers: prefer __value__
        IfCondition EqualTo(vt, JSType.OBJECT) ThenBlock: {
            prim = JSRT_ObjGet(save_val, "__value__")
            IfCondition NotEqual(prim, 0) ThenBlock: {
                IfCondition NotEqual(prim, JSRTState.undef_val) ThenBlock: {
                    pt = JSRT_GetType(prim)
                    IfCondition Or(EqualTo(pt, JSType.STRING), Or(EqualTo(pt, JSType.NUMBER), EqualTo(pt, JSType.BOOLEAN))) ThenBlock: {
                        ReturnValue(prim)
                    }
                }
            }
        }

        // Only objects/arrays/functions have methods
        is_objlike = 0
        IfCondition EqualTo(vt, JSType.OBJECT) ThenBlock: { is_objlike = 1 }
        IfCondition EqualTo(vt, JSType.ARRAY) ThenBlock: { is_objlike = 1 }
        IfCondition EqualTo(vt, JSType.FUNCTION) ThenBlock: { is_objlike = 1 }
        IfCondition EqualTo(is_objlike, 0) ThenBlock: {
            ReturnValue(save_val)
        }

        // Method order by hint
        empty_buf = JSVMCallBuf.buf
        try_i = 0
        WhileLoop LessThan(try_i, 2) {
            mname = 0
            IfCondition EqualTo(save_hint, 1) ThenBlock: {
                // string: toString, valueOf
                IfCondition EqualTo(try_i, 0) ThenBlock: { mname = "toString" }
                IfCondition EqualTo(try_i, 1) ThenBlock: { mname = "valueOf" }
            } ElseBlock: {
                // number/default: valueOf, toString
                IfCondition EqualTo(try_i, 0) ThenBlock: { mname = "valueOf" }
                IfCondition EqualTo(try_i, 1) ThenBlock: { mname = "toString" }
            }
            JSRT__Push(save_val)
            JSRT__Push(save_hint)
            JSRT__Push(try_i)
            meth = JSRT_ObjGet(save_val, mname)
            try_i = JSRT__Pop()
            save_hint = JSRT__Pop()
            save_val = JSRT__Pop()
            IfCondition EqualTo(JSRT_GetType(meth), JSType.FUNCTION) ThenBlock: {
                JSVM__SetGlobal("this", save_val)
                JSRT__Push(save_val)
                JSRT__Push(save_hint)
                JSRT__Push(try_i)
                res = JSVM__CallFunc(meth, empty_buf, 0)
                try_i = JSRT__Pop()
                save_hint = JSRT__Pop()
                save_val = JSRT__Pop()
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    // Propagate throw to caller — leave exc_prop set
                    ReturnValue(0)
                }
                IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                    ReturnValue(0)
                }
                rt = JSRT_GetType(res)
                is_prim = 0
                IfCondition EqualTo(rt, JSType.UNDEFINED) ThenBlock: { is_prim = 1 }
                IfCondition EqualTo(rt, JSType.NULL) ThenBlock: { is_prim = 1 }
                IfCondition EqualTo(rt, JSType.BOOLEAN) ThenBlock: { is_prim = 1 }
                IfCondition EqualTo(rt, JSType.NUMBER) ThenBlock: { is_prim = 1 }
                IfCondition EqualTo(rt, JSType.STRING) ThenBlock: { is_prim = 1 }
                IfCondition EqualTo(is_prim, 1) ThenBlock: {
                    ReturnValue(res)
                }
            }
            try_i = Add(try_i, 1)
        }
        // Cannot convert
        ReturnValue(JSRTState.undef_val)
    }
}

// =============================================================================
// TYPE COERCION — ToNumber
// Returns IEEE 754 double bits (not raw integers).
// undefined -> NaN, null -> +0.0, boolean -> 0.0/1.0, number -> identity,
// string -> parsed float (NaN on failure), object/array/func -> NaN
// =============================================================================
// Parse JS string to IEEE float bits. Empty/whitespace → +0. Invalid → NaN.
// Handles optional leading sign and integer digits; non-numeric → NaN.
Function.JSRT__ParseNumberStr {
    Input: sptr: Address
    Output: Integer
    Body: {
        save_p = sptr
        IfCondition EqualTo(save_p, 0) ThenBlock: {
            ReturnValue(9221120237041090560)
        }
        i = 0
        // skip spaces/tabs
        ch = GetByte(save_p, i)
        WhileLoop Or(EqualTo(ch, 32), EqualTo(ch, 9)) {
            i = Add(i, 1)
            ch = GetByte(save_p, i)
        }
        // empty → +0
        IfCondition EqualTo(ch, 0) ThenBlock: {
            ReturnValue(Float_FromInt(0))
        }
        sign = 1
        IfCondition EqualTo(ch, 45) ThenBlock: {
            sign = -1
            i = Add(i, 1)
            ch = GetByte(save_p, i)
        }
        IfCondition EqualTo(ch, 43) ThenBlock: {
            i = Add(i, 1)
            ch = GetByte(save_p, i)
        }
        // must have digit or dot
        has_digit = 0
        acc = 0
        // integer part
        WhileLoop And(GreaterEqual(ch, 48), LessEqual(ch, 57)) {
            has_digit = 1
            acc = Add(Multiply(acc, 10), Subtract(ch, 48))
            i = Add(i, 1)
            ch = GetByte(save_p, i)
        }
        // fraction
        frac = Float_FromInt(0)
        place = Float_FromInt(1)
        ten = Float_FromInt(10)
        IfCondition EqualTo(ch, 46) ThenBlock: {
            i = Add(i, 1)
            ch = GetByte(save_p, i)
            WhileLoop And(GreaterEqual(ch, 48), LessEqual(ch, 57)) {
                has_digit = 1
                place = Float_Div(place, ten)
                d = Float_FromInt(Subtract(ch, 48))
                frac = Float_Add(frac, Float_Mul(d, place))
                i = Add(i, 1)
                ch = GetByte(save_p, i)
            }
        }
        IfCondition EqualTo(has_digit, 0) ThenBlock: {
            ReturnValue(9221120237041090560)
        }
        // trailing non-ws → NaN (e.g. "1x")
        WhileLoop Or(EqualTo(ch, 32), EqualTo(ch, 9)) {
            i = Add(i, 1)
            ch = GetByte(save_p, i)
        }
        IfCondition NotEqual(ch, 0) ThenBlock: {
            ReturnValue(9221120237041090560)
        }
        result = Float_Add(Float_FromInt(acc), frac)
        IfCondition EqualTo(sign, -1) ThenBlock: {
            result = Float_Mul(result, Float_FromInt(-1))
        }
        ReturnValue(result)
    }
}

Function.JSRT_ToNumber {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            // null pointer -> NaN bits
            ReturnValue(9221120237041090560)
        }
        vtype = Dereference(save_val)
        // undefined -> NaN (0x7FF8000000000000 = 9221120237041090560)
        IfCondition EqualTo(vtype, JSType.UNDEFINED) ThenBlock: {
            ReturnValue(9221120237041090560)
        }
        // null -> +0.0
        IfCondition EqualTo(vtype, JSType.NULL) ThenBlock: {
            ReturnValue(Float_FromInt(0))
        }
        // boolean -> 0.0 or 1.0
        IfCondition EqualTo(vtype, JSType.BOOLEAN) ThenBlock: {
            bval = Dereference(Add(save_val, 8))
            ReturnValue(Float_FromInt(bval))
        }
        // number -> identity (already double bits)
        IfCondition EqualTo(vtype, JSType.NUMBER) ThenBlock: {
            ReturnValue(Dereference(Add(save_val, 8)))
        }
        // string -> parse to float (invalid → NaN, not 0)
        IfCondition EqualTo(vtype, JSType.STRING) ThenBlock: {
            sptr = Dereference(Add(save_val, 8))
            IfCondition EqualTo(sptr, 0) ThenBlock: {
                ReturnValue(9221120237041090560)
            }
            ReturnValue(JSRT__ParseNumberStr(sptr))
        }
        // object/array/function: ToPrimitive (number) then ToNumber
        IfCondition Or(EqualTo(vtype, JSType.OBJECT), Or(EqualTo(vtype, JSType.ARRAY), EqualTo(vtype, JSType.FUNCTION))) ThenBlock: {
            prim = JSRT_ToPrimitive(save_val, 0)
            IfCondition EqualTo(prim, 0) ThenBlock: {
                // throw pending from toString/valueOf
                ReturnValue(9221120237041090560)
            }
            pt = JSRT_GetType(prim)
            // Avoid infinite recursion: only re-enter if primitive
            IfCondition EqualTo(pt, JSType.NUMBER) ThenBlock: {
                ReturnValue(Dereference(Add(prim, 8)))
            }
            IfCondition EqualTo(pt, JSType.BOOLEAN) ThenBlock: {
                ReturnValue(Float_FromInt(Dereference(Add(prim, 8))))
            }
            IfCondition EqualTo(pt, JSType.STRING) ThenBlock: {
                ReturnValue(JSRT_ToNumber(prim))
            }
            IfCondition EqualTo(pt, JSType.NULL) ThenBlock: {
                ReturnValue(Float_FromInt(0))
            }
            IfCondition EqualTo(pt, JSType.UNDEFINED) ThenBlock: {
                ReturnValue(9221120237041090560)
            }
        }
        // other -> NaN
        ReturnValue(9221120237041090560)
    }
}

// =============================================================================
// TYPE COERCION — ToBool
// Returns a JSValue pointer (singleton true_val or false_val)
// =============================================================================
Function.JSRT_ToBool {
    Input: val: Address
    Output: Address
    Body: {
        save_val = val
        truthy = JSRT_IsTruthy(save_val)
        IfCondition NotEqual(truthy, 0) ThenBlock: {
            ReturnValue(JSRTState.true_val)
        }
        ReturnValue(JSRTState.false_val)
    }
}

// =============================================================================
// INTERNAL: Integer to decimal string
// Builds decimal string from a 64-bit signed integer.
// Uses JSRT str_buf for scratch space. Returns pointer to null-terminated string.
// =============================================================================
Function.JSRT__IntToStr {
    Input: n: Integer
    Output: Address
    Body: {
        save_n = n
        // Use static buffers (no per-call Allocate)
        buf = JSRTState.int_buf
        MemorySet(buf, 0, 24)

        // Handle zero
        IfCondition EqualTo(save_n, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            SetByte(buf, 1, 0)
            ReturnValue(buf)
        }

        // Handle negative
        is_neg = 0
        work_n = save_n
        IfCondition LessThan(save_n, 0) ThenBlock: {
            is_neg = 1
            work_n = Subtract(0, save_n)
        }

        // Build digits in reverse into static temp buffer
        tmp = JSRTState.int_tmp
        MemorySet(tmp, 0, 24)
        di = 0
        WhileLoop GreaterThan(work_n, 0) {
            remainder = Modulo(work_n, 10)
            digit_ch = Add(remainder, 48)
            SetByte(tmp, di, digit_ch)
            di = Add(di, 1)
            work_n = Divide(work_n, 10)
        }

        // Now reverse into buf
        out_pos = 0
        IfCondition EqualTo(is_neg, 1) ThenBlock: {
            SetByte(buf, 0, 45)
            out_pos = 1
        }

        // Copy digits in reverse order
        ri = Subtract(di, 1)
        WhileLoop GreaterEqual(ri, 0) {
            ch = GetByte(tmp, ri)
            SetByte(buf, out_pos, ch)
            out_pos = Add(out_pos, 1)
            ri = Subtract(ri, 1)
        }
        SetByte(buf, out_pos, 0)
        ReturnValue(buf)
    }
}

// =============================================================================
// INTERNAL: Float to decimal string
// Converts IEEE 754 double bits to a decimal string.
// Handles: NaN, ±Infinity, ±0, integers, and fractional decimals.
// =============================================================================
Function.JSRT__FloatToStr {
    Input: bits: Integer
    Output: Address
    Body: {
        save_bits = bits

        // Use static buffer for all conversions (no per-call Allocate)
        buf = JSRTState.float_buf

        // Check for +0 and -0
        // +0 = 0x0000000000000000, -0 = 0x8000000000000000
        IfCondition EqualTo(save_bits, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            SetByte(buf, 1, 0)
            ReturnValue(buf)
        }
        // -0: high bit set, rest zero (= -9223372036854775808 as signed)
        IfCondition EqualTo(save_bits, -9223372036854775808) ThenBlock: {
            SetByte(buf, 0, 48)
            SetByte(buf, 1, 0)
            ReturnValue(buf)
        }

        // Extract exponent field: bits[62:52]
        // Mask: 0x7FF0000000000000 = 9218868437227405312
        exp_field = BitwiseAnd(save_bits, 9218868437227405312)

        // Check for NaN and Infinity (exponent = all 1s)
        IfCondition EqualTo(exp_field, 9218868437227405312) ThenBlock: {
            // Mantissa mask: 0x000FFFFFFFFFFFFF = 4503599627370495
            mantissa = BitwiseAnd(save_bits, 4503599627370495)
            IfCondition NotEqual(mantissa, 0) ThenBlock: {
                // NaN
                SetByte(buf, 0, 78)
                SetByte(buf, 1, 97)
                SetByte(buf, 2, 78)
                SetByte(buf, 3, 0)
                ReturnValue(buf)
            }
            // Infinity — check sign bit
            // Sign mask: 0x8000000000000000 (bit 63)
            sign = BitwiseAnd(save_bits, -9223372036854775808)
            IfCondition NotEqual(sign, 0) ThenBlock: {
                // -Infinity
                SetByte(buf, 0, 45)
                SetByte(buf, 1, 73)
                SetByte(buf, 2, 110)
                SetByte(buf, 3, 102)
                SetByte(buf, 4, 105)
                SetByte(buf, 5, 110)
                SetByte(buf, 6, 105)
                SetByte(buf, 7, 116)
                SetByte(buf, 8, 121)
                SetByte(buf, 9, 0)
                ReturnValue(buf)
            }
            // +Infinity
            SetByte(buf, 0, 73)
            SetByte(buf, 1, 110)
            SetByte(buf, 2, 102)
            SetByte(buf, 3, 105)
            SetByte(buf, 4, 110)
            SetByte(buf, 5, 105)
            SetByte(buf, 6, 116)
            SetByte(buf, 7, 121)
            SetByte(buf, 8, 0)
            ReturnValue(buf)
        }

        // Check if value is an exact integer: Float_FromInt(Float_ToInt(bits)) == bits
        int_val = Float_ToInt(save_bits)
        roundtrip = Float_FromInt(int_val)
        is_int = Float_Eq(roundtrip, save_bits)
        IfCondition EqualTo(is_int, 1) ThenBlock: {
            // Use existing integer-to-string
            ReturnValue(JSRT__IntToStr(int_val))
        }

        // Fractional number: build string manually
        MemorySet(buf, 0, 48)
        pos = 0

        // Check sign
        sign = BitwiseAnd(save_bits, -9223372036854775808)
        work_bits = save_bits
        IfCondition NotEqual(sign, 0) ThenBlock: {
            SetByte(buf, pos, 45)
            pos = Add(pos, 1)
            // Clear sign bit to get absolute value
            work_bits = BitwiseAnd(save_bits, 9223372036854775807)
        }

        // Get integer part
        int_part = Float_ToInt(work_bits)
        frac_bits = Float_Sub(work_bits, Float_FromInt(int_part))

        // Write integer part
        int_str = JSRT__IntToStr(int_part)
        int_len = StringLength(int_str)
        MemoryCopy(Add(buf, pos), int_str, int_len)
        pos = Add(pos, int_len)

        // Write decimal point
        SetByte(buf, pos, 46)
        pos = Add(pos, 1)

        // Write fractional digits (up to 17 digits, trim trailing zeros)
        ten_bits = Float_FromInt(10)
        frac_start = pos
        d_count = 0
        last_nonzero = pos
        WhileLoop LessThan(d_count, 17) {
            frac_bits = Float_Mul(frac_bits, ten_bits)
            digit = Float_ToInt(frac_bits)
            // Clamp digit to 0-9
            IfCondition LessThan(digit, 0) ThenBlock: { digit = 0 }
            IfCondition GreaterThan(digit, 9) ThenBlock: { digit = 9 }
            SetByte(buf, pos, Add(digit, 48))
            IfCondition NotEqual(digit, 0) ThenBlock: {
                last_nonzero = Add(pos, 1)
            }
            pos = Add(pos, 1)
            frac_bits = Float_Sub(frac_bits, Float_FromInt(digit))
            d_count = Add(d_count, 1)
            // Stop if remaining fraction is zero
            is_frac_zero = Float_Eq(frac_bits, Float_FromInt(0))
            IfCondition EqualTo(is_frac_zero, 1) ThenBlock: {
                last_nonzero = pos
                d_count = 17
            }
        }

        // Trim trailing zeros (but keep at least one digit after '.')
        IfCondition LessEqual(last_nonzero, frac_start) ThenBlock: {
            last_nonzero = Add(frac_start, 1)
        }
        SetByte(buf, last_nonzero, 0)
        ReturnValue(buf)
    }
}

// =============================================================================
// TYPE COERCION — ToString
// Returns a new STRING JSValue.
// undefined -> "undefined", null -> "null", boolean -> "true"/"false",
// number -> decimal string, string -> identity, object -> "[object Object]",
// array -> joined elements, function -> "[function]"
// =============================================================================
Function.JSRT_ToString {
    Input: val: Address
    Output: Address
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            ReturnValue(JSRTState.str_undefined)
        }
        vtype = Dereference(save_val)

        // ─── UNDEFINED ───
        IfCondition EqualTo(vtype, JSType.UNDEFINED) ThenBlock: {
            ReturnValue(JSRTState.str_undefined)
        }

        // ─── NULL ───
        IfCondition EqualTo(vtype, JSType.NULL) ThenBlock: {
            ReturnValue(JSRTState.str_null)
        }

        // ─── BOOLEAN ───
        IfCondition EqualTo(vtype, JSType.BOOLEAN) ThenBlock: {
            bval = Dereference(Add(save_val, 8))
            IfCondition NotEqual(bval, 0) ThenBlock: {
                ReturnValue(JSRTState.str_true)
            }
            ReturnValue(JSRTState.str_false)
        }

        // ─── NUMBER ───
        IfCondition EqualTo(vtype, JSType.NUMBER) ThenBlock: {
            nbits = Dereference(Add(save_val, 8))
            str_ptr = JSRT__FloatToStr(nbits)
            ReturnValue(JSRT_CreateString(str_ptr))
        }

        // ─── STRING ───
        IfCondition EqualTo(vtype, JSType.STRING) ThenBlock: {
            // Already a string — return as-is (no copy needed)
            ReturnValue(save_val)
        }

        // ─── OBJECT — ToPrimitive(string): custom toString/valueOf / wrappers ───
        IfCondition EqualTo(vtype, JSType.OBJECT) ThenBlock: {
            prim = JSRT_ToPrimitive(save_val, 1)
            IfCondition EqualTo(prim, 0) ThenBlock: {
                // CallFunc threw from toString/valueOf — leave exc pending; return placeholder
                ReturnValue(JSRTState.str_objobj)
            }
            pt = JSRT_GetType(prim)
            IfCondition EqualTo(pt, JSType.STRING) ThenBlock: {
                ReturnValue(prim)
            }
            IfCondition EqualTo(pt, JSType.NUMBER) ThenBlock: {
                ReturnValue(JSRT_ToString(prim))
            }
            IfCondition EqualTo(pt, JSType.BOOLEAN) ThenBlock: {
                ReturnValue(JSRT_ToString(prim))
            }
            IfCondition EqualTo(pt, JSType.NULL) ThenBlock: {
                ReturnValue(JSRTState.str_null)
            }
            ReturnValue(JSRTState.str_objobj)
        }

        // ─── ARRAY ───  (JS spec: Array.toString() == .join(","))
        IfCondition EqualTo(vtype, JSType.ARRAY) ThenBlock: {
            arr_len = JSRT_ArrLen(save_val)
            IfCondition EqualTo(arr_len, 0) ThenBlock: {
                ReturnValue(JSRT_CreateString(""))
            }
            // Build comma-joined string via StrConcat (recursion-safe)
            result_str = JSRT_CreateString("")
            ts_i = 0
            WhileLoop LessThan(ts_i, arr_len) {
                // Append comma separator after first element
                IfCondition GreaterThan(ts_i, 0) ThenBlock: {
                    JSRT__Push(save_val)
                    prev_ptr = Dereference(Add(result_str, 8))
                    result_str = JSRT__StrConcat(prev_ptr, ",")
                    save_val = JSRT__Pop()
                }
                // Get element
                JSRT__Push(save_val)
                JSRT__Push(result_str)
                elem = JSRT_ArrGet(save_val, ts_i)
                elem_type = Dereference(elem)
                // null/undefined → empty string (JS spec: skip)
                do_append = 0
                IfCondition NotEqual(elem_type, JSType.NULL) ThenBlock: {
                    IfCondition NotEqual(elem_type, JSType.UNDEFINED) ThenBlock: {
                        do_append = 1
                    }
                }
                IfCondition EqualTo(do_append, 1) ThenBlock: {
                    elem_str = JSRT_ToString(elem)
                    e_ptr = Dereference(Add(elem_str, 8))
                    result_str = JSRT__Pop()
                    save_val = JSRT__Pop()
                    JSRT__Push(save_val)
                    res_ptr = Dereference(Add(result_str, 8))
                    JSRT__Push(res_ptr)
                    result_str = JSRT__StrConcat(res_ptr, e_ptr)
                    JSRT__Pop()
                    save_val = JSRT__Pop()
                }
                IfCondition EqualTo(do_append, 0) ThenBlock: {
                    result_str = JSRT__Pop()
                    save_val = JSRT__Pop()
                }
                ts_i = Add(ts_i, 1)
            }
            ReturnValue(result_str)
        }

        // ─── FUNCTION ───
        IfCondition EqualTo(vtype, JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSRTState.str_function)
        }

        // Fallback: "undefined"
        ReturnValue(JSRTState.str_undefined)
    }
}

// =============================================================================
// STRING CONCATENATION HELPER
// Concatenates two null-terminated strings, returns new JSValue STRING.
// =============================================================================
// Uses native StringConcat — Arena-backed allocation with SSE2 copy.
// Arena strings survive scope rollback (outside str_slab range).
Function.JSRT__StrConcat {
    Input: a_ptr: Address
    Input: b_ptr: Address
    Output: Address
    Body: {
        buf = StringConcat(a_ptr, b_ptr)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.STRING)
        StoreValue(Add(val, 8), buf)
        ReturnValue(val)
    }
}

// =============================================================================
// JSRT_Add — + operator
// If either operand is STRING type, concatenate; otherwise numeric add.
// Returns a new JSValue.
// =============================================================================
Function.JSRT_Add {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, 0) ThenBlock: {
            save_a = JSRTState.undef_val
        }
        IfCondition EqualTo(save_b, 0) ThenBlock: {
            save_b = JSRTState.undef_val
        }
        a_type = Dereference(save_a)
        b_type = Dereference(save_b)

        // M19d: unbox String/Number/Boolean wrappers for + (ToPrimitive default)
        IfCondition EqualTo(a_type, JSType.OBJECT) ThenBlock: {
            prim_a = JSRT_ObjGet(save_a, "__value__")
            IfCondition NotEqual(prim_a, 0) ThenBlock: {
                IfCondition NotEqual(prim_a, JSRTState.undef_val) ThenBlock: {
                    save_a = prim_a
                    a_type = Dereference(save_a)
                }
            }
        }
        IfCondition EqualTo(b_type, JSType.OBJECT) ThenBlock: {
            prim_b = JSRT_ObjGet(save_b, "__value__")
            IfCondition NotEqual(prim_b, 0) ThenBlock: {
                IfCondition NotEqual(prim_b, JSRTState.undef_val) ThenBlock: {
                    save_b = prim_b
                    b_type = Dereference(save_b)
                }
            }
        }

        // FAST PATH: both NUMBER — skip ToNumber, no Push/Pop
        IfCondition EqualTo(a_type, JSType.NUMBER) ThenBlock: {
            IfCondition EqualTo(b_type, JSType.NUMBER) ThenBlock: {
                sum = Float_Add(Dereference(Add(save_a, 8)), Dereference(Add(save_b, 8)))
                ReturnValue(JSRT_CreateFloat(sum))
            }
        }

        // If either is STRING, do string concatenation
        is_str = 0
        IfCondition EqualTo(a_type, JSType.STRING) ThenBlock: {
            is_str = 1
        }
        IfCondition EqualTo(b_type, JSType.STRING) ThenBlock: {
            is_str = 1
        }

        IfCondition EqualTo(is_str, 1) ThenBlock: {
            // Convert both to string and concatenate
            JSRT__Push(save_b)
            str_a = JSRT_ToString(save_a)
            save_b = JSRT__Pop()
            IfCondition EqualTo(str_a, 0) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            a_sptr = Dereference(Add(str_a, 8))

            JSRT__Push(a_sptr)
            str_b = JSRT_ToString(save_b)
            a_sptr = JSRT__Pop()
            IfCondition EqualTo(str_b, 0) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            b_sptr = Dereference(Add(str_b, 8))

            result = JSRT__StrConcat(a_sptr, b_sptr)
            ReturnValue(result)
        }

        // Numeric addition (IEEE 754 double)
        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        sum = Float_Add(n_a, n_b)
        result = JSRT_CreateFloat(sum)
        ReturnValue(result)
    }
}

// =============================================================================
// JSRT_Sub — - operator (numeric subtraction)
// =============================================================================
Function.JSRT_Sub {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, 0) ThenBlock: { save_a = JSRTState.undef_val }
        IfCondition EqualTo(save_b, 0) ThenBlock: { save_b = JSRTState.undef_val }

        // FAST PATH: both NUMBER
        IfCondition EqualTo(Dereference(save_a), JSType.NUMBER) ThenBlock: {
            IfCondition EqualTo(Dereference(save_b), JSType.NUMBER) ThenBlock: {
                diff = Float_Sub(Dereference(Add(save_a, 8)), Dereference(Add(save_b, 8)))
                ReturnValue(JSRT_CreateFloat(diff))
            }
        }

        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        diff = Float_Sub(n_a, n_b)
        result = JSRT_CreateFloat(diff)
        ReturnValue(result)
    }
}

// =============================================================================
// JSRT_Mul — * operator (numeric multiplication)
// =============================================================================
Function.JSRT_Mul {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, 0) ThenBlock: { save_a = JSRTState.undef_val }
        IfCondition EqualTo(save_b, 0) ThenBlock: { save_b = JSRTState.undef_val }

        // FAST PATH: both NUMBER
        IfCondition EqualTo(Dereference(save_a), JSType.NUMBER) ThenBlock: {
            IfCondition EqualTo(Dereference(save_b), JSType.NUMBER) ThenBlock: {
                prod = Float_Mul(Dereference(Add(save_a, 8)), Dereference(Add(save_b, 8)))
                ReturnValue(JSRT_CreateFloat(prod))
            }
        }

        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
