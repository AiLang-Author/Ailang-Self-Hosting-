// =============================================================================
// TYPE COERCION — ToNumber
// Returns IEEE 754 double bits (not raw integers).
// undefined -> NaN, null -> +0.0, boolean -> 0.0/1.0, number -> identity,
// string -> parsed float (NaN on failure), object/array/func -> NaN
// =============================================================================
Function.JSRT_ToNumber {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            // null pointer -> NaN bits
            ReturnValue(9221120237041090560)
        }
        vtype = Dereference(save_val)
        // undefined -> NaN (0x7FF8000000000000 = 9221120237041090560)
        IfCondition EqualTo(vtype, JSType.UNDEFINED) ThenBlock: {
            ReturnValue(9221120237041090560)
        }
        // null -> +0.0
        IfCondition EqualTo(vtype, JSType.NULL) ThenBlock: {
            ReturnValue(Float_FromInt(0))
        }
        // boolean -> 0.0 or 1.0
        IfCondition EqualTo(vtype, JSType.BOOLEAN) ThenBlock: {
            bval = Dereference(Add(save_val, 8))
            ReturnValue(Float_FromInt(bval))
        }
        // number -> identity (already double bits)
        IfCondition EqualTo(vtype, JSType.NUMBER) ThenBlock: {
            ReturnValue(Dereference(Add(save_val, 8)))
        }
        // string -> parse to float
        IfCondition EqualTo(vtype, JSType.STRING) ThenBlock: {
            sptr = Dereference(Add(save_val, 8))
            IfCondition EqualTo(sptr, 0) ThenBlock: {
                ReturnValue(9221120237041090560)
            }
            // Try integer parse then convert to float
            result = StringToInt(sptr)
            ReturnValue(Float_FromInt(result))
        }
        // object, array, function -> NaN
        ReturnValue(9221120237041090560)
    }
}

// =============================================================================
// TYPE COERCION — ToBool
// Returns a JSValue pointer (singleton true_val or false_val)
// =============================================================================
Function.JSRT_ToBool {
    Input: val: Address
    Output: Address
    Body: {
        save_val = val
        truthy = JSRT_IsTruthy(save_val)
        IfCondition NotEqual(truthy, 0) ThenBlock: {
            ReturnValue(JSRTState.true_val)
        }
        ReturnValue(JSRTState.false_val)
    }
}

// =============================================================================
// INTERNAL: Integer to decimal string
// Builds decimal string from a 64-bit signed integer.
// Uses JSRT str_buf for scratch space. Returns pointer to null-terminated string.
// =============================================================================
Function.JSRT__IntToStr {
    Input: n: Integer
    Output: Address
    Body: {
        save_n = n
        // Use static buffers (no per-call Allocate)
        buf = JSRTState.int_buf
        MemorySet(buf, 0, 24)

        // Handle zero
        IfCondition EqualTo(save_n, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            SetByte(buf, 1, 0)
            ReturnValue(buf)
        }

        // Handle negative
        is_neg = 0
        work_n = save_n
        IfCondition LessThan(save_n, 0) ThenBlock: {
            is_neg = 1
            work_n = Subtract(0, save_n)
        }

        // Build digits in reverse into static temp buffer
        tmp = JSRTState.int_tmp
        MemorySet(tmp, 0, 24)
        di = 0
        WhileLoop GreaterThan(work_n, 0) {
            remainder = Modulo(work_n, 10)
            digit_ch = Add(remainder, 48)
            SetByte(tmp, di, digit_ch)
            di = Add(di, 1)
            work_n = Divide(work_n, 10)
        }

        // Now reverse into buf
        out_pos = 0
        IfCondition EqualTo(is_neg, 1) ThenBlock: {
            SetByte(buf, 0, 45)
            out_pos = 1
        }

        // Copy digits in reverse order
        ri = Subtract(di, 1)
        WhileLoop GreaterEqual(ri, 0) {
            ch = GetByte(tmp, ri)
            SetByte(buf, out_pos, ch)
            out_pos = Add(out_pos, 1)
            ri = Subtract(ri, 1)
        }
        SetByte(buf, out_pos, 0)
        ReturnValue(buf)
    }
}

// =============================================================================
// INTERNAL: Float to decimal string
// Converts IEEE 754 double bits to a decimal string.
// Handles: NaN, ±Infinity, ±0, integers, and fractional decimals.
// =============================================================================
Function.JSRT__FloatToStr {
    Input: bits: Integer
    Output: Address
    Body: {
        save_bits = bits

        // Use static buffer for all conversions (no per-call Allocate)
        buf = JSRTState.float_buf

        // Check for +0 and -0
        // +0 = 0x0000000000000000, -0 = 0x8000000000000000
        IfCondition EqualTo(save_bits, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            SetByte(buf, 1, 0)
            ReturnValue(buf)
        }
        // -0: high bit set, rest zero (= -9223372036854775808 as signed)
        IfCondition EqualTo(save_bits, -9223372036854775808) ThenBlock: {
            SetByte(buf, 0, 48)
            SetByte(buf, 1, 0)
            ReturnValue(buf)
        }

        // Extract exponent field: bits[62:52]
        // Mask: 0x7FF0000000000000 = 9218868437227405312
        exp_field = BitwiseAnd(save_bits, 9218868437227405312)

        // Check for NaN and Infinity (exponent = all 1s)
        IfCondition EqualTo(exp_field, 9218868437227405312) ThenBlock: {
            // Mantissa mask: 0x000FFFFFFFFFFFFF = 4503599627370495
            mantissa = BitwiseAnd(save_bits, 4503599627370495)
            IfCondition NotEqual(mantissa, 0) ThenBlock: {
                // NaN
                SetByte(buf, 0, 78)
                SetByte(buf, 1, 97)
                SetByte(buf, 2, 78)
                SetByte(buf, 3, 0)
                ReturnValue(buf)
            }
            // Infinity — check sign bit
            // Sign mask: 0x8000000000000000 (bit 63)
            sign = BitwiseAnd(save_bits, -9223372036854775808)
            IfCondition NotEqual(sign, 0) ThenBlock: {
                // -Infinity
                SetByte(buf, 0, 45)
                SetByte(buf, 1, 73)
                SetByte(buf, 2, 110)
                SetByte(buf, 3, 102)
                SetByte(buf, 4, 105)
                SetByte(buf, 5, 110)
                SetByte(buf, 6, 105)
                SetByte(buf, 7, 116)
                SetByte(buf, 8, 121)
                SetByte(buf, 9, 0)
                ReturnValue(buf)
            }
            // +Infinity
            SetByte(buf, 0, 73)
            SetByte(buf, 1, 110)
            SetByte(buf, 2, 102)
            SetByte(buf, 3, 105)
            SetByte(buf, 4, 110)
            SetByte(buf, 5, 105)
            SetByte(buf, 6, 116)
            SetByte(buf, 7, 121)
            SetByte(buf, 8, 0)
            ReturnValue(buf)
        }

        // Check if value is an exact integer: Float_FromInt(Float_ToInt(bits)) == bits
        int_val = Float_ToInt(save_bits)
        roundtrip = Float_FromInt(int_val)
        is_int = Float_Eq(roundtrip, save_bits)
        IfCondition EqualTo(is_int, 1) ThenBlock: {
            // Use existing integer-to-string
            ReturnValue(JSRT__IntToStr(int_val))
        }

        // Fractional number: build string manually
        MemorySet(buf, 0, 48)
        pos = 0

        // Check sign
        sign = BitwiseAnd(save_bits, -9223372036854775808)
        work_bits = save_bits
        IfCondition NotEqual(sign, 0) ThenBlock: {
            SetByte(buf, pos, 45)
            pos = Add(pos, 1)
            // Clear sign bit to get absolute value
            work_bits = BitwiseAnd(save_bits, 9223372036854775807)
        }

        // Get integer part
        int_part = Float_ToInt(work_bits)
        frac_bits = Float_Sub(work_bits, Float_FromInt(int_part))

        // Write integer part
        int_str = JSRT__IntToStr(int_part)
        int_len = StringLength(int_str)
        MemoryCopy(Add(buf, pos), int_str, int_len)
        pos = Add(pos, int_len)

        // Write decimal point
        SetByte(buf, pos, 46)
        pos = Add(pos, 1)

        // Write fractional digits (up to 17 digits, trim trailing zeros)
        ten_bits = Float_FromInt(10)
        frac_start = pos
        d_count = 0
        last_nonzero = pos
        WhileLoop LessThan(d_count, 17) {
            frac_bits = Float_Mul(frac_bits, ten_bits)
            digit = Float_ToInt(frac_bits)
            // Clamp digit to 0-9
            IfCondition LessThan(digit, 0) ThenBlock: { digit = 0 }
            IfCondition GreaterThan(digit, 9) ThenBlock: { digit = 9 }
            SetByte(buf, pos, Add(digit, 48))
            IfCondition NotEqual(digit, 0) ThenBlock: {
                last_nonzero = Add(pos, 1)
            }
            pos = Add(pos, 1)
            frac_bits = Float_Sub(frac_bits, Float_FromInt(digit))
            d_count = Add(d_count, 1)
            // Stop if remaining fraction is zero
            is_frac_zero = Float_Eq(frac_bits, Float_FromInt(0))
            IfCondition EqualTo(is_frac_zero, 1) ThenBlock: {
                last_nonzero = pos
                d_count = 17
            }
        }

        // Trim trailing zeros (but keep at least one digit after '.')
        IfCondition LessEqual(last_nonzero, frac_start) ThenBlock: {
            last_nonzero = Add(frac_start, 1)
        }
        SetByte(buf, last_nonzero, 0)
        ReturnValue(buf)
    }
}

// =============================================================================
// TYPE COERCION — ToString
// Returns a new STRING JSValue.
// undefined -> "undefined", null -> "null", boolean -> "true"/"false",
// number -> decimal string, string -> identity, object -> "[object Object]",
// array -> joined elements, function -> "[function]"
// =============================================================================
Function.JSRT_ToString {
    Input: val: Address
    Output: Address
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            ReturnValue(JSRTState.str_undefined)
        }
        vtype = Dereference(save_val)

        // ─── UNDEFINED ───
        IfCondition EqualTo(vtype, JSType.UNDEFINED) ThenBlock: {
            ReturnValue(JSRTState.str_undefined)
        }

        // ─── NULL ───
        IfCondition EqualTo(vtype, JSType.NULL) ThenBlock: {
            ReturnValue(JSRTState.str_null)
        }

        // ─── BOOLEAN ───
        IfCondition EqualTo(vtype, JSType.BOOLEAN) ThenBlock: {
            bval = Dereference(Add(save_val, 8))
            IfCondition NotEqual(bval, 0) ThenBlock: {
                ReturnValue(JSRTState.str_true)
            }
            ReturnValue(JSRTState.str_false)
        }

        // ─── NUMBER ───
        IfCondition EqualTo(vtype, JSType.NUMBER) ThenBlock: {
            nbits = Dereference(Add(save_val, 8))
            str_ptr = JSRT__FloatToStr(nbits)
            ReturnValue(JSRT_CreateString(str_ptr))
        }

        // ─── STRING ───
        IfCondition EqualTo(vtype, JSType.STRING) ThenBlock: {
            // Already a string — return as-is (no copy needed)
            ReturnValue(save_val)
        }

        // ─── OBJECT ───
        IfCondition EqualTo(vtype, JSType.OBJECT) ThenBlock: {
            ReturnValue(JSRTState.str_objobj)
        }

        // ─── ARRAY ───
        IfCondition EqualTo(vtype, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSRT_CreateString(""))
        }

        // ─── FUNCTION ───
        IfCondition EqualTo(vtype, JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSRTState.str_function)
        }

        // Fallback: "undefined"
        ReturnValue(JSRTState.str_undefined)
    }
}

// =============================================================================
// STRING CONCATENATION HELPER
// Concatenates two null-terminated strings, returns new JSValue STRING.
// =============================================================================
// Uses str_slab bump allocator — no per-call Allocate.
Function.JSRT__StrConcat {
    Input: a_ptr: Address
    Input: b_ptr: Address
    Output: Address
    Body: {
        save_a = a_ptr
        save_b = b_ptr
        len_a = StringLength(save_a)
        len_b = StringLength(save_b)
        total = Add(len_a, len_b)
        buf_sz = Add(total, 1)
        buf = JSRT__StrSlabAlloc(buf_sz)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        // Copy first string
        IfCondition GreaterThan(len_a, 0) ThenBlock: {
            MemoryCopy(buf, save_a, len_a)
        }
        // Copy second string
        IfCondition GreaterThan(len_b, 0) ThenBlock: {
            dest = Add(buf, len_a)
            MemoryCopy(dest, save_b, len_b)
        }
        SetByte(buf, total, 0)
        // Build JSValue directly — buf is already in the slab
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.STRING)
        StoreValue(Add(val, 8), buf)
        ReturnValue(val)
    }
}

// =============================================================================
// JSRT_Add — + operator
// If either operand is STRING type, concatenate; otherwise numeric add.
// Returns a new JSValue.
// =============================================================================
Function.JSRT_Add {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, 0) ThenBlock: {
            save_a = JSRTState.undef_val
        }
        IfCondition EqualTo(save_b, 0) ThenBlock: {
            save_b = JSRTState.undef_val
        }
        a_type = Dereference(save_a)
        b_type = Dereference(save_b)

        // FAST PATH: both NUMBER — skip ToNumber, no Push/Pop
        IfCondition EqualTo(a_type, JSType.NUMBER) ThenBlock: {
            IfCondition EqualTo(b_type, JSType.NUMBER) ThenBlock: {
                sum = Float_Add(Dereference(Add(save_a, 8)), Dereference(Add(save_b, 8)))
                ReturnValue(JSRT_CreateFloat(sum))
            }
        }

        // If either is STRING, do string concatenation
        is_str = 0
        IfCondition EqualTo(a_type, JSType.STRING) ThenBlock: {
            is_str = 1
        }
        IfCondition EqualTo(b_type, JSType.STRING) ThenBlock: {
            is_str = 1
        }

        IfCondition EqualTo(is_str, 1) ThenBlock: {
            // Convert both to string and concatenate
            JSRT__Push(save_b)
            str_a = JSRT_ToString(save_a)
            save_b = JSRT__Pop()
            IfCondition EqualTo(str_a, 0) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            a_sptr = Dereference(Add(str_a, 8))

            JSRT__Push(a_sptr)
            str_b = JSRT_ToString(save_b)
            a_sptr = JSRT__Pop()
            IfCondition EqualTo(str_b, 0) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            b_sptr = Dereference(Add(str_b, 8))

            result = JSRT__StrConcat(a_sptr, b_sptr)
            ReturnValue(result)
        }

        // Numeric addition (IEEE 754 double)
        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        sum = Float_Add(n_a, n_b)
        result = JSRT_CreateFloat(sum)
        ReturnValue(result)
    }
}

// =============================================================================
// JSRT_Sub — - operator (numeric subtraction)
// =============================================================================
Function.JSRT_Sub {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, 0) ThenBlock: { save_a = JSRTState.undef_val }
        IfCondition EqualTo(save_b, 0) ThenBlock: { save_b = JSRTState.undef_val }

        // FAST PATH: both NUMBER
        IfCondition EqualTo(Dereference(save_a), JSType.NUMBER) ThenBlock: {
            IfCondition EqualTo(Dereference(save_b), JSType.NUMBER) ThenBlock: {
                diff = Float_Sub(Dereference(Add(save_a, 8)), Dereference(Add(save_b, 8)))
                ReturnValue(JSRT_CreateFloat(diff))
            }
        }

        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        diff = Float_Sub(n_a, n_b)
        result = JSRT_CreateFloat(diff)
        ReturnValue(result)
    }
}

// =============================================================================
// JSRT_Mul — * operator (numeric multiplication)
// =============================================================================
Function.JSRT_Mul {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, 0) ThenBlock: { save_a = JSRTState.undef_val }
        IfCondition EqualTo(save_b, 0) ThenBlock: { save_b = JSRTState.undef_val }

        // FAST PATH: both NUMBER
        IfCondition EqualTo(Dereference(save_a), JSType.NUMBER) ThenBlock: {
            IfCondition EqualTo(Dereference(save_b), JSType.NUMBER) ThenBlock: {
                prod = Float_Mul(Dereference(Add(save_a, 8)), Dereference(Add(save_b, 8)))
                ReturnValue(JSRT_CreateFloat(prod))
            }
        }

        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        prod = Float_Mul(n_a, n_b)
        result = JSRT_CreateFloat(prod)
        ReturnValue(result)
    }
}

// =============================================================================
// JSRT_Div — / operator (IEEE 754 double division)
// =============================================================================
Function.JSRT_Div {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, 0) ThenBlock: { save_a = JSRTState.undef_val }
        IfCondition EqualTo(save_b, 0) ThenBlock: { save_b = JSRTState.undef_val }

        // FAST PATH: both NUMBER
        IfCondition EqualTo(Dereference(save_a), JSType.NUMBER) ThenBlock: {
            IfCondition EqualTo(Dereference(save_b), JSType.NUMBER) ThenBlock: {
                quot = Float_Div(Dereference(Add(save_a, 8)), Dereference(Add(save_b, 8)))
                ReturnValue(JSRT_CreateFloat(quot))
            }
        }

        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        // SSE2 handles div-by-zero: n/0 -> ±Infinity, 0/0 -> NaN
        quot = Float_Div(n_a, n_b)
        result = JSRT_CreateFloat(quot)
        ReturnValue(result)
    }
}

// =============================================================================
// JSRT_Mod — % operator (IEEE 754 fmod)
// =============================================================================
Function.JSRT_Mod {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, 0) ThenBlock: { save_a = JSRTState.undef_val }
        IfCondition EqualTo(save_b, 0) ThenBlock: { save_b = JSRTState.undef_val }

        // FAST PATH: both NUMBER
        IfCondition EqualTo(Dereference(save_a), JSType.NUMBER) ThenBlock: {
            IfCondition EqualTo(Dereference(save_b), JSType.NUMBER) ThenBlock: {
                n_a = Dereference(Add(save_a, 8))
                n_b = Dereference(Add(save_b, 8))
                q = Float_Div(n_a, n_b)
                tq = Float_FromInt(Float_ToInt(q))
                rem = Float_Sub(n_a, Float_Mul(tq, n_b))
                ReturnValue(JSRT_CreateFloat(rem))
            }
        }

        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        // fmod: a - trunc(a/b) * b
        // div-by-zero produces NaN via SSE2
        q = Float_Div(n_a, n_b)
        tq = Float_FromInt(Float_ToInt(q))
        rem = Float_Sub(n_a, Float_Mul(tq, n_b))
        result = JSRT_CreateFloat(rem)
        ReturnValue(result)
    }
}

// =============================================================================
// JSRT_Exp — ** exponentiation operator (IEEE 754 double)
// =============================================================================
Function.JSRT_Exp {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b

        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        // exp == 0 -> 1.0 (JS spec: anything ** 0 = 1)
        zero_bits = Float_FromInt(0)
        one_bits = Float_FromInt(1)
        is_exp_zero = Float_Eq(n_b, zero_bits)
        IfCondition EqualTo(is_exp_zero, 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(one_bits))
        }

        // Convert exponent to integer for iteration
        exp_int = Float_ToInt(n_b)
        is_neg_exp = 0
        IfCondition LessThan(exp_int, 0) ThenBlock: {
            is_neg_exp = 1
            exp_int = Subtract(0, exp_int)
        }

        // Iterative exponentiation by squaring (float)
        result_f = one_bits
        base_f = n_a
        exp_i = exp_int
        WhileLoop GreaterThan(exp_i, 0) {
            rem2 = Modulo(exp_i, 2)
            IfCondition EqualTo(rem2, 1) ThenBlock: {
                result_f = Float_Mul(result_f, base_f)
            }
            base_f = Float_Mul(base_f, base_f)
            exp_i = Divide(exp_i, 2)
        }

        // Negative exponent: result = 1.0 / result
        IfCondition EqualTo(is_neg_exp, 1) ThenBlock: {
            result_f = Float_Div(one_bits, result_f)
        }
        ReturnValue(JSRT_CreateFloat(result_f))
    }
}

// =============================================================================
// JSRT_Neg — unary negation
// =============================================================================
Function.JSRT_Neg {
    Input: a: Address
    Output: Address
    Body: {
        save_a = a
        n_a = JSRT_ToNumber(save_a)
        neg_val = Float_Sub(Float_FromInt(0), n_a)
        result = JSRT_CreateFloat(neg_val)
        ReturnValue(result)
    }
}

// =============================================================================
// JSRT_BitAnd — & operator (ES spec: ToInt32 both operands)
// =============================================================================
Function.JSRT_BitAnd {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b

        JSRT__Push(save_b)
        n_a = Float_ToInt(JSRT_ToNumber(save_a))
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = Float_ToInt(JSRT_ToNumber(save_b))
        n_a = JSRT__Pop()

        // ToInt32: mask to 32 bits, sign-extend
        n_a = BitwiseAnd(n_a, 4294967295)
        IfCondition GreaterEqual(n_a, 2147483648) ThenBlock: { n_a = Subtract(n_a, 4294967296) }
        n_b = BitwiseAnd(n_b, 4294967295)
        IfCondition GreaterEqual(n_b, 2147483648) ThenBlock: { n_b = Subtract(n_b, 4294967296) }

        r = BitwiseAnd(n_a, n_b)
        ReturnValue(JSRT_CreateNumber(r))
    }
}

// =============================================================================
// JSRT_BitOr — | operator (ES spec: ToInt32 both operands)
// =============================================================================
Function.JSRT_BitOr {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b

        JSRT__Push(save_b)
        n_a = Float_ToInt(JSRT_ToNumber(save_a))
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = Float_ToInt(JSRT_ToNumber(save_b))
        n_a = JSRT__Pop()

        // ToInt32: mask to 32 bits, sign-extend
        n_a = BitwiseAnd(n_a, 4294967295)
        IfCondition GreaterEqual(n_a, 2147483648) ThenBlock: { n_a = Subtract(n_a, 4294967296) }
        n_b = BitwiseAnd(n_b, 4294967295)
        IfCondition GreaterEqual(n_b, 2147483648) ThenBlock: { n_b = Subtract(n_b, 4294967296) }

        r = BitwiseOr(n_a, n_b)
        ReturnValue(JSRT_CreateNumber(r))
    }
}

// =============================================================================
// JSRT_BitXor — ^ operator (ES spec: ToInt32 both operands)
// =============================================================================
Function.JSRT_BitXor {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b

        JSRT__Push(save_b)
        n_a = Float_ToInt(JSRT_ToNumber(save_a))
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = Float_ToInt(JSRT_ToNumber(save_b))
        n_a = JSRT__Pop()

        // ToInt32: mask to 32 bits, sign-extend
        n_a = BitwiseAnd(n_a, 4294967295)
        IfCondition GreaterEqual(n_a, 2147483648) ThenBlock: { n_a = Subtract(n_a, 4294967296) }
        n_b = BitwiseAnd(n_b, 4294967295)
        IfCondition GreaterEqual(n_b, 2147483648) ThenBlock: { n_b = Subtract(n_b, 4294967296) }

        r = BitwiseXor(n_a, n_b)
        ReturnValue(JSRT_CreateNumber(r))
    }
}

// =============================================================================
// JSRT_BitNot — ~ operator (ES spec: ToInt32, then XOR with 0xFFFFFFFF)
// =============================================================================
Function.JSRT_BitNot {
    Input: a: Address
    Output: Address
    Body: {
        save_a = a
        n_a = Float_ToInt(JSRT_ToNumber(save_a))

        // ToInt32: mask to 32 bits, sign-extend
        n_a = BitwiseAnd(n_a, 4294967295)
        IfCondition GreaterEqual(n_a, 2147483648) ThenBlock: { n_a = Subtract(n_a, 4294967296) }

        // ~x = XOR with all 1s (0xFFFFFFFF), then sign-extend result
        r = BitwiseXor(n_a, 4294967295)
        r = BitwiseAnd(r, 4294967295)
        IfCondition GreaterEqual(r, 2147483648) ThenBlock: { r = Subtract(r, 4294967296) }
        ReturnValue(JSRT_CreateNumber(r))
    }
}

// =============================================================================
// JSRT_Shl — << operator (ES spec: ToInt32 lhs, ToUint32 shift & 31)
// =============================================================================
Function.JSRT_Shl {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b

        JSRT__Push(save_b)
        n_a = Float_ToInt(JSRT_ToNumber(save_a))
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = Float_ToInt(JSRT_ToNumber(save_b))
        n_a = JSRT__Pop()

        // ToInt32 lhs
        n_a = BitwiseAnd(n_a, 4294967295)
        IfCondition GreaterEqual(n_a, 2147483648) ThenBlock: { n_a = Subtract(n_a, 4294967296) }
        // Shift amount: & 31
        n_b = BitwiseAnd(n_b, 31)

        r = ShiftLeft(n_a, n_b)
        // ToInt32 result (shift can overflow 32 bits on 64-bit machine)
        r = BitwiseAnd(r, 4294967295)
        IfCondition GreaterEqual(r, 2147483648) ThenBlock: { r = Subtract(r, 4294967296) }
        ReturnValue(JSRT_CreateNumber(r))
    }
}

// =============================================================================
// JSRT_Shr — >> operator (ES spec: ToInt32 lhs, shift & 31, sign-preserving)
// =============================================================================
Function.JSRT_Shr {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b

        JSRT__Push(save_b)
        n_a = Float_ToInt(JSRT_ToNumber(save_a))
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = Float_ToInt(JSRT_ToNumber(save_b))
        n_a = JSRT__Pop()

        // ToInt32 lhs
        n_a = BitwiseAnd(n_a, 4294967295)
        IfCondition GreaterEqual(n_a, 2147483648) ThenBlock: { n_a = Subtract(n_a, 4294967296) }
        // Shift amount: & 31
        n_b = BitwiseAnd(n_b, 31)

        r = ShiftRight(n_a, n_b)
        // ToInt32 result
        r = BitwiseAnd(r, 4294967295)
        IfCondition GreaterEqual(r, 2147483648) ThenBlock: { r = Subtract(r, 4294967296) }
        ReturnValue(JSRT_CreateNumber(r))
    }
}

// =============================================================================
// JSRT_Ushr — >>> operator (unsigned right shift)
// ES spec: ToUint32 lhs, shift & 31, result is unsigned 32-bit.
// =============================================================================
Function.JSRT_Ushr {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b

        JSRT__Push(save_b)
        n_a = Float_ToInt(JSRT_ToNumber(save_a))
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = Float_ToInt(JSRT_ToNumber(save_b))
        n_a = JSRT__Pop()

        // ToUint32: mask to 32 bits (no sign-extend — unsigned)
        masked = BitwiseAnd(n_a, 4294967295)
        shift = BitwiseAnd(n_b, 31)
        r = ShiftRight(masked, shift)
        // Result is unsigned 32-bit (no sign-extend)
        r = BitwiseAnd(r, 4294967295)
        ReturnValue(JSRT_CreateNumber(r))
    }
}

// =============================================================================
// JSRT_Instanceof — instanceof operator
// Returns boolean. In our engine, always false (no constructor/prototype chain).
// =============================================================================
Function.JSRT_Instanceof {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b
        // a instanceof b: walk a's __proto__ chain, compare with b.prototype
        IfCondition EqualTo(save_a, 0) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        IfCondition EqualTo(save_b, 0) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        atype = JSRT_GetType(save_a)
        IfCondition NotEqual(atype, JSType.OBJECT) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        btype = JSRT_GetType(save_b)
        IfCondition NotEqual(btype, JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        // Get b.prototype
        JSRT__Push(save_a)
        b_proto = JSRT_ObjGet(save_b, "prototype")
        save_a = JSRT__Pop()
        bp_type = JSRT_GetType(b_proto)
        IfCondition NotEqual(bp_type, JSType.OBJECT) ThenBlock: {
            // Also check __class__ fallback for Error constructors
            JSRT__Push(save_b)
            cls_val = JSRT_ObjGet(save_a, "__class__")
            save_b = JSRT__Pop()
            ct = JSRT_GetType(cls_val)
            IfCondition NotEqual(ct, JSType.STRING) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            b_desc = JSRT_GetPayload(save_b)
            IfCondition EqualTo(b_desc, 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            b_name = Dereference(Add(b_desc, 24))
            IfCondition EqualTo(b_name, 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            cmp = StringCompare(JSRT_GetPayload(cls_val), b_name)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(1))
            }
            ReturnValue(JSRT_CreateBool(0))
        }
        // Walk a's __proto__ chain, compare each with b.prototype
        cur = save_a
        JSRTTmp.count = 0
        WhileLoop LessThan(JSRTTmp.count, 64) {
            JSRTTmp.count = Add(JSRTTmp.count, 1)
            JSRT__Push(b_proto)
            cur_proto = JSRT_ObjGet(cur, "__proto__")
            b_proto = JSRT__Pop()
            cp_type = JSRT_GetType(cur_proto)
            IfCondition NotEqual(cp_type, JSType.OBJECT) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            // Compare pointers
            IfCondition EqualTo(cur_proto, b_proto) ThenBlock: {
                ReturnValue(JSRT_CreateBool(1))
            }
            cur = cur_proto
        }
        ReturnValue(JSRT_CreateBool(0))
    }
}

// =============================================================================
// JSRT_Not — ! operator (logical NOT)
// Returns boolean JSValue: true_val or false_val
// =============================================================================
Function.JSRT_Not {
    Input: a: Address
    Output: Address
    Body: {
        save_a = a
        truthy = JSRT_IsTruthy(save_a)
        IfCondition NotEqual(truthy, 0) ThenBlock: {
            ReturnValue(JSRTState.false_val)
        }
        ReturnValue(JSRTState.true_val)
    }
}

// =============================================================================
// COMPARISON — Strict Equality (===)
// Same type AND same value required.
// Returns 1 (equal) or 0 (not equal).
// =============================================================================
Function.JSRT_StrictEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        save_a = a
        save_b = b
        // Either null pointer -> not equal
        IfCondition EqualTo(save_a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(save_b, 0) ThenBlock: { ReturnValue(0) }
        // Same pointer -> equal, UNLESS it's a NUMBER (NaN !== NaN)
        IfCondition EqualTo(save_a, save_b) ThenBlock: {
            ptr_type = Dereference(save_a)
            IfCondition EqualTo(ptr_type, JSType.NUMBER) ThenBlock: {
                nbits = Dereference(Add(save_a, 8))
                // NaN check: NaN != NaN
                is_nan = Float_Ne(nbits, nbits)
                IfCondition EqualTo(is_nan, 1) ThenBlock: {
                    ReturnValue(0)
                }
            }
            ReturnValue(1)
        }

        a_type = Dereference(save_a)
        b_type = Dereference(save_b)

        // Types must match
        IfCondition NotEqual(a_type, b_type) ThenBlock: {
            ReturnValue(0)
        }

        // UNDEFINED === UNDEFINED
        IfCondition EqualTo(a_type, JSType.UNDEFINED) ThenBlock: {
            ReturnValue(1)
        }
        // NULL === NULL
        IfCondition EqualTo(a_type, JSType.NULL) ThenBlock: {
            ReturnValue(1)
        }

        a_pay = Dereference(Add(save_a, 8))
        b_pay = Dereference(Add(save_b, 8))

        // BOOLEAN: compare payload
        IfCondition EqualTo(a_type, JSType.BOOLEAN) ThenBlock: {
            IfCondition EqualTo(a_pay, b_pay) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }

        // NUMBER: compare as IEEE 754 doubles (NaN !== NaN handled by Float_Eq)
        IfCondition EqualTo(a_type, JSType.NUMBER) ThenBlock: {
            feq = Float_Eq(a_pay, b_pay)
            IfCondition EqualTo(feq, 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }

        // STRING: compare string contents
        IfCondition EqualTo(a_type, JSType.STRING) ThenBlock: {
            cmp = StringCompare(a_pay, b_pay)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }

        // OBJECT, ARRAY, FUNCTION: reference equality (same pointer)
        IfCondition EqualTo(a_pay, b_pay) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// COMPARISON — Abstract Equality (==)
// null == undefined -> true
// If same type, delegate to strict equality
// If one is number and other is string, convert string to number
// If one is boolean, convert to number and retry
// =============================================================================
Function.JSRT_AbstractEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, save_b) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(save_a, 0) ThenBlock: { save_a = JSRTState.undef_val }
        IfCondition EqualTo(save_b, 0) ThenBlock: { save_b = JSRTState.undef_val }

        a_type = Dereference(save_a)
        b_type = Dereference(save_b)

        // Same type -> strict equal
        IfCondition EqualTo(a_type, b_type) ThenBlock: {
            result = JSRT_StrictEqual(save_a, save_b)
            ReturnValue(result)
        }

        // null == undefined and undefined == null
        IfCondition And(EqualTo(a_type, JSType.NULL), EqualTo(b_type, JSType.UNDEFINED)) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition And(EqualTo(a_type, JSType.UNDEFINED), EqualTo(b_type, JSType.NULL)) ThenBlock: {
            ReturnValue(1)
        }

        // number vs string: convert string to number, compare as float
        IfCondition And(EqualTo(a_type, JSType.NUMBER), EqualTo(b_type, JSType.STRING)) ThenBlock: {
            JSRT__Push(save_a)
            n_b = JSRT_ToNumber(save_b)
            save_a = JSRT__Pop()
            a_pay = Dereference(Add(save_a, 8))
            feq = Float_Eq(a_pay, n_b)
            IfCondition EqualTo(feq, 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition And(EqualTo(a_type, JSType.STRING), EqualTo(b_type, JSType.NUMBER)) ThenBlock: {
            JSRT__Push(save_b)
            n_a = JSRT_ToNumber(save_a)
            save_b = JSRT__Pop()
            b_pay = Dereference(Add(save_b, 8))
            feq = Float_Eq(n_a, b_pay)
            IfCondition EqualTo(feq, 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }

        // boolean vs anything: convert boolean to number, then compare
        IfCondition EqualTo(a_type, JSType.BOOLEAN) ThenBlock: {
            a_num_val = Dereference(Add(save_a, 8))
            JSRT__Push(save_b)
            a_as_num = JSRT_CreateNumber(a_num_val)
            save_b = JSRT__Pop()
            result = JSRT_AbstractEqual(a_as_num, save_b)
            ReturnValue(result)
        }
        IfCondition EqualTo(b_type, JSType.BOOLEAN) ThenBlock: {
            b_num_val = Dereference(Add(save_b, 8))
            JSRT__Push(save_a)
            b_as_num = JSRT_CreateNumber(b_num_val)
            save_a = JSRT__Pop()
            result = JSRT_AbstractEqual(save_a, b_as_num)
            ReturnValue(result)
        }

        // All other cases: not equal
        ReturnValue(0)
    }
}

// =============================================================================
// COMPARISON — Less Than (<)
// Numeric comparison after coercion. String comparison if both are strings.
// Returns 1 or 0.
// =============================================================================
Function.JSRT_LessThan {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, 0) ThenBlock: { save_a = JSRTState.undef_val }
        IfCondition EqualTo(save_b, 0) ThenBlock: { save_b = JSRTState.undef_val }

        a_type = Dereference(save_a)
        b_type = Dereference(save_b)

        // FAST PATH: both NUMBER — skip ToNumber, no Push/Pop
        IfCondition EqualTo(a_type, JSType.NUMBER) ThenBlock: {
            IfCondition EqualTo(b_type, JSType.NUMBER) ThenBlock: {
                ReturnValue(Float_Lt(Dereference(Add(save_a, 8)), Dereference(Add(save_b, 8))))
            }
        }

        // Both strings: lexicographic comparison
        IfCondition And(EqualTo(a_type, JSType.STRING), EqualTo(b_type, JSType.STRING)) ThenBlock: {
            a_sptr = Dereference(Add(save_a, 8))
            b_sptr = Dereference(Add(save_b, 8))
            cmp = StringCompare(a_sptr, b_sptr)
            IfCondition LessThan(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }

        // Numeric comparison (IEEE 754 double)
        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        flt = Float_Lt(n_a, n_b)
        IfCondition EqualTo(flt, 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// COMPARISON — Greater Than (>)
// =============================================================================
Function.JSRT_GreaterThan {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        save_a = a
        save_b = b
        // a > b is equivalent to b < a
        result = JSRT_LessThan(save_b, save_a)
        ReturnValue(result)
    }
}

// =============================================================================
// COMPARISON — Less Than or Equal (<=)
// =============================================================================
Function.JSRT_LessEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, 0) ThenBlock: { save_a = JSRTState.undef_val }
        IfCondition EqualTo(save_b, 0) ThenBlock: { save_b = JSRTState.undef_val }

        a_type = Dereference(save_a)
        b_type = Dereference(save_b)

        // FAST PATH: both NUMBER — skip ToNumber, no Push/Pop
        IfCondition EqualTo(a_type, JSType.NUMBER) ThenBlock: {
            IfCondition EqualTo(b_type, JSType.NUMBER) ThenBlock: {
                ReturnValue(Float_Le(Dereference(Add(save_a, 8)), Dereference(Add(save_b, 8))))
            }
        }

        // Both strings: lexicographic comparison
        IfCondition And(EqualTo(a_type, JSType.STRING), EqualTo(b_type, JSType.STRING)) ThenBlock: {
            a_sptr = Dereference(Add(save_a, 8))
            b_sptr = Dereference(Add(save_b, 8))
            cmp = StringCompare(a_sptr, b_sptr)
            IfCondition LessThan(cmp, 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }

        // Numeric comparison — Float_Le handles NaN correctly (returns 0)
        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        fle = Float_Le(n_a, n_b)
        IfCondition EqualTo(fle, 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// COMPARISON — Greater Than or Equal (>=)
// =============================================================================
Function.JSRT_GreaterEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, 0) ThenBlock: { save_a = JSRTState.undef_val }
        IfCondition EqualTo(save_b, 0) ThenBlock: { save_b = JSRTState.undef_val }

        a_type = Dereference(save_a)
        b_type = Dereference(save_b)

        // FAST PATH: both NUMBER — skip ToNumber, no Push/Pop
        IfCondition EqualTo(a_type, JSType.NUMBER) ThenBlock: {
            IfCondition EqualTo(b_type, JSType.NUMBER) ThenBlock: {
                ReturnValue(Float_Ge(Dereference(Add(save_a, 8)), Dereference(Add(save_b, 8))))
            }
        }

        // Both strings: lexicographic comparison
        IfCondition And(EqualTo(a_type, JSType.STRING), EqualTo(b_type, JSType.STRING)) ThenBlock: {
            a_sptr = Dereference(Add(save_a, 8))
            b_sptr = Dereference(Add(save_b, 8))
            cmp = StringCompare(a_sptr, b_sptr)
            IfCondition GreaterThan(cmp, 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }

        // Numeric comparison — Float_Ge handles NaN correctly (returns 0)
        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        fge = Float_Ge(n_a, n_b)
        IfCondition EqualTo(fge, 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// TYPEOF — returns a STRING JSValue with the type name
// =============================================================================
Function.JSRT_TypeOf {
    Input: val: Address
    Output: Address
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            ReturnValue(JSRTState.str_typeof_undefined)
        }
        vtype = Dereference(save_val)
        IfCondition EqualTo(vtype, JSType.UNDEFINED) ThenBlock: {
            ReturnValue(JSRTState.str_typeof_undefined)
        }
        IfCondition EqualTo(vtype, JSType.NULL) ThenBlock: {
            ReturnValue(JSRTState.str_typeof_object)
        }
        IfCondition EqualTo(vtype, JSType.BOOLEAN) ThenBlock: {
            ReturnValue(JSRTState.str_typeof_boolean)
        }
        IfCondition EqualTo(vtype, JSType.NUMBER) ThenBlock: {
            ReturnValue(JSRTState.str_typeof_number)
        }
        IfCondition EqualTo(vtype, JSType.STRING) ThenBlock: {
            ReturnValue(JSRTState.str_typeof_string)
        }
        IfCondition EqualTo(vtype, JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSRTState.str_typeof_function)
        }
        // OBJECT and ARRAY -> "object"
        ReturnValue(JSRTState.str_typeof_object)
    }
}
