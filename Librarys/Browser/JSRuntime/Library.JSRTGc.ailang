// Library.JSRTGc.ailang — reuse dead global-value slots, property tables,
// and young string bytes. Runs only from JSVM_Step, when no native frame
// holds a raw payload pointer.
//
// gval headers and prop tables are mark-sweep free lists (no compaction).
// Strings above str_tenure are packed to the front of that region.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// =============================================================================
// BITMAPS — no calls, locals are safe
// =============================================================================

Function.JSRT__GcGGet {
    Input: idx: Integer
    Output: Integer
    Body: {
        save = idx
        bi = ShiftRight(save, 3)
        bit = BitwiseAnd(save, 7)
        b = GetByte(JSRTState.gval_mark, bi)
        IfCondition LessThan(b, 0) ThenBlock: { b = Add(b, 256) }
        IfCondition NotEqual(BitwiseAnd(b, ShiftLeft(1, bit)), 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.JSRT__GcGSet {
    Input: idx: Integer
    Body: {
        save = idx
        JSRTState.str_probe = save
        bi = ShiftRight(JSRTState.str_probe, 3)
        bit = BitwiseAnd(JSRTState.str_probe, 7)
        b = GetByte(JSRTState.gval_mark, bi)
        IfCondition LessThan(b, 0) ThenBlock: { b = Add(b, 256) }
        SetByte(JSRTState.gval_mark, bi, BitwiseOr(b, ShiftLeft(1, bit)))
        // Index list at str_scratch+12MB. 524288 entries, then overflow.
        IfCondition LessThan(JSRTState.gval_live_n, 524288) ThenBlock: {
            StoreValue(Add(JSRTState.str_scratch, Add(12582912, Multiply(JSRTState.gval_live_n, 8))), JSRTState.str_probe)
            JSRTState.gval_live_n = Add(JSRTState.gval_live_n, 1)
        } ElseBlock: {
            JSRTState.gc_overflow = 1
        }
        ReturnValue(1)
    }
}

Function.JSRT__GcVGet {
    Input: idx: Integer
    Output: Integer
    Body: {
        save = idx
        bi = ShiftRight(save, 3)
        bit = BitwiseAnd(save, 7)
        b = GetByte(JSRTState.val_mark, bi)
        IfCondition LessThan(b, 0) ThenBlock: { b = Add(b, 256) }
        IfCondition NotEqual(BitwiseAnd(b, ShiftLeft(1, bit)), 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.JSRT__GcVSet {
    Input: idx: Integer
    Body: {
        save = idx
        JSRTState.str_probe = save
        bi = ShiftRight(JSRTState.str_probe, 3)
        bit = BitwiseAnd(JSRTState.str_probe, 7)
        b = GetByte(JSRTState.val_mark, bi)
        IfCondition LessThan(b, 0) ThenBlock: { b = Add(b, 256) }
        SetByte(JSRTState.val_mark, bi, BitwiseOr(b, ShiftLeft(1, bit)))
        // Index list at str_scratch+8MB. Shares the upper half with gvals.
        IfCondition LessThan(JSRTState.val_live_n, 524288) ThenBlock: {
            StoreValue(Add(JSRTState.str_scratch, Add(8388608, Multiply(JSRTState.val_live_n, 8))), JSRTState.str_probe)
            JSRTState.val_live_n = Add(JSRTState.val_live_n, 1)
        } ElseBlock: {
            JSRTState.gc_overflow = 1
        }
        ReturnValue(1)
    }
}

Function.JSRT__GcPGet {
    Input: idx: Integer
    Output: Integer
    Body: {
        save = idx
        bi = ShiftRight(save, 3)
        bit = BitwiseAnd(save, 7)
        b = GetByte(JSRTState.pt_mark, bi)
        IfCondition LessThan(b, 0) ThenBlock: { b = Add(b, 256) }
        IfCondition NotEqual(BitwiseAnd(b, ShiftLeft(1, bit)), 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.JSRT__GcPSet {
    Input: idx: Integer
    Body: {
        save = idx
        bi = ShiftRight(save, 3)
        bit = BitwiseAnd(save, 7)
        b = GetByte(JSRTState.pt_mark, bi)
        IfCondition LessThan(b, 0) ThenBlock: { b = Add(b, 256) }
        SetByte(JSRTState.pt_mark, bi, BitwiseOr(b, ShiftLeft(1, bit)))
        ReturnValue(1)
    }
}

Function.JSRT__GcIsGVal {
    Input: p: Address
    Output: Integer
    Body: {
        save = p
        IfCondition LessThan(save, JSRTState.gval_pool) ThenBlock: { ReturnValue(0) }
        endp = Add(JSRTState.gval_pool, Multiply(JSRTState.gval_count, JSRTConst.VAL_SIZE))
        IfCondition GreaterEqual(save, endp) ThenBlock: { ReturnValue(0) }
        off = Subtract(save, JSRTState.gval_pool)
        IfCondition NotEqual(BitwiseAnd(off, 15), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.JSRT__GcIsVal {
    Input: p: Address
    Output: Integer
    Body: {
        save = p
        IfCondition LessThan(save, JSRTState.val_pool) ThenBlock: { ReturnValue(0) }
        endp = Add(JSRTState.val_pool, Multiply(JSRTState.val_count, JSRTConst.VAL_SIZE))
        IfCondition GreaterEqual(save, endp) ThenBlock: { ReturnValue(0) }
        off = Subtract(save, JSRTState.val_pool)
        IfCondition NotEqual(BitwiseAnd(off, 15), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// =============================================================================
// GRAPH
// =============================================================================

Function.JSRT__GcQueue {
    Input: p: Address
    Body: {
        JSRTState.gc_p = p
        IfCondition EqualTo(JSRTState.gc_p, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(JSRTState.gc_p, 4096) ThenBlock: { ReturnValue(0) }
        isg = JSRT__GcIsGVal(JSRTState.gc_p)
        IfCondition EqualTo(isg, 1) ThenBlock: {
            idx = ShiftRight(Subtract(JSRTState.gc_p, JSRTState.gval_pool), 4)
            hit = JSRT__GcGGet(idx)
            IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(0) }
            JSRT__GcGSet(ShiftRight(Subtract(JSRTState.gc_p, JSRTState.gval_pool), 4))
        } ElseBlock: {
            isv = JSRT__GcIsVal(JSRTState.gc_p)
            IfCondition EqualTo(isv, 0) ThenBlock: { ReturnValue(0) }
            idx2 = ShiftRight(Subtract(JSRTState.gc_p, JSRTState.val_pool), 4)
            hit2 = JSRT__GcVGet(idx2)
            IfCondition EqualTo(hit2, 1) ThenBlock: { ReturnValue(0) }
            JSRT__GcVSet(ShiftRight(Subtract(JSRTState.gc_p, JSRTState.val_pool), 4))
        }
        IfCondition GreaterEqual(JSRTState.gval_gray_sp, JSRTState.gval_gray_cap) ThenBlock: {
            JSRTState.gc_overflow = 1
            ReturnValue(0)
        }
        StoreValue(Add(JSRTState.gval_gray, Multiply(JSRTState.gval_gray_sp, 8)), JSRTState.gc_p)
        JSRTState.gval_gray_sp = Add(JSRTState.gval_gray_sp, 1)
        ReturnValue(1)
    }
}

Function.JSRT__GcMarkTable {
    Input: table: Address
    Body: {
        save = table
        IfCondition EqualTo(save, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(PropState.slab, 0) ThenBlock: { ReturnValue(0) }
        off = Subtract(save, PropState.slab)
        IfCondition LessThan(off, 0) ThenBlock: { ReturnValue(0) }
        idx = Divide(off, PropConst.TABLE_SIZE)
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(idx, PropState.next_slot) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Multiply(idx, PropConst.TABLE_SIZE), off) ThenBlock: { ReturnValue(0) }
        JSRT__GcPSet(idx)
        ReturnValue(1)
    }
}

// Keys and values. Uses gc_a / gc_n / gc_i / gc_q. Does not touch gc_k or gc_obj.
Function.JSRT__GcScanTable {
    Input: table: Address
    Body: {
        JSRTState.gc_a = table
        IfCondition EqualTo(JSRTState.gc_a, 0) ThenBlock: { ReturnValue(0) }
        JSRT__GcMarkTable(JSRTState.gc_a)
        JSRTState.gc_n = Dereference(JSRTState.gc_a)
        IfCondition LessThan(JSRTState.gc_n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(JSRTState.gc_n, PropConst.MAX_ENTRIES) ThenBlock: {
            JSRTState.gc_n = PropConst.MAX_ENTRIES
        }
        JSRTState.gc_i = 0
        WhileLoop LessThan(JSRTState.gc_i, JSRTState.gc_n) {
            JSRTState.gc_q = Add(JSRTState.gc_a, Add(8, Multiply(JSRTState.gc_i, PropConst.ENTRY_SIZE)))
            k = Dereference(JSRTState.gc_q)
            IfCondition EqualTo(k, 0) ThenBlock: {
                JSRTState.gc_i = Add(JSRTState.gc_i, 1)
            } ElseBlock: {
                IfCondition EqualTo(k, PropConst.TOMBSTONE) ThenBlock: {
                    JSRTState.gc_i = Add(JSRTState.gc_i, 1)
                } ElseBlock: {
                    v = Dereference(Add(JSRTState.gc_q, 8))
                    IfCondition NotEqual(v, 0) ThenBlock: {
                        JSRT__GcQueue(v)
                    }
                    JSRTState.gc_i = Add(JSRTState.gc_i, 1)
                }
            }
        }
        ReturnValue(1)
    }
}

Function.JSRT__GcScanArray {
    Body: {
        xa = Dereference(Add(JSRTState.gc_obj, 8))
        IfCondition EqualTo(xa, 0) ThenBlock: { ReturnValue(0) }
        JSRTState.gc_a = xa
        JSRTState.gc_n = Array.Size(JSRTState.gc_a)
        IfCondition LessThan(JSRTState.gc_n, 0) ThenBlock: { JSRTState.gc_n = 0 }
        IfCondition GreaterThan(JSRTState.gc_n, 1000000) ThenBlock: { JSRTState.gc_n = 0 }
        JSRTState.gc_i = 0
        WhileLoop LessThan(JSRTState.gc_i, JSRTState.gc_n) {
            el = Array.Get(JSRTState.gc_a, JSRTState.gc_i)
            IfCondition NotEqual(el, 0) ThenBlock: {
                JSRT__GcQueue(el)
            }
            JSRTState.gc_i = Add(JSRTState.gc_i, 1)
        }
        pt = ArrSide_Lookup(JSRTState.gc_obj)
        JSRT__GcScanTable(pt)
        ReturnValue(1)
    }
}

Function.JSRT__GcScanFunc {
    Body: {
        JSRTState.gc_b = Dereference(Add(JSRTState.gc_obj, 8))
        IfCondition EqualTo(JSRTState.gc_b, 0) ThenBlock: { ReturnValue(0) }
        // Offset 40 is closure env (bound record, scope object). Integer
        // envs (async 65, generator 71) are below GcQueue's pointer floor.
        JSRT__GcQueue(Dereference(Add(JSRTState.gc_b, 40)))
        JSRT__GcQueue(Dereference(Add(JSRTState.gc_b, 48)))
        JSRT__GcQueue(Dereference(Add(JSRTState.gc_b, 56)))
        JSRT__GcScanTable(Dereference(Add(JSRTState.gc_b, 64)))
        // +144 is the function source JS string (toString). 0 if native.
        JSRT__GcQueue(Dereference(Add(JSRTState.gc_b, 144)))
        ReturnValue(1)
    }
}

Function.JSRT__GcScanGen {
    Body: {
        JSRTState.gc_b = Dereference(Add(JSRTState.gc_obj, 8))
        IfCondition EqualTo(JSRTState.gc_b, 0) ThenBlock: { ReturnValue(0) }
        JSRT__GcQueue(Dereference(Add(JSRTState.gc_b, 112)))
        JSRT__GcQueue(Dereference(Add(JSRTState.gc_b, 120)))
        JSRT__GcQueue(Dereference(Add(JSRTState.gc_b, 152)))
        JSRT__GcQueue(Dereference(Add(JSRTState.gc_b, 160)))
        JSRT__GcQueue(Dereference(Add(JSRTState.gc_b, 176)))
        JSRT__GcQueue(Dereference(Add(JSRTState.gc_b, JSGenConst.OFF_ARGS_OBJ)))
        JSRTState.gc_n = Dereference(Add(JSRTState.gc_b, 40))
        IfCondition GreaterThan(JSRTState.gc_n, JSGenConst.GEN_STACK_MAX) ThenBlock: {
            JSRTState.gc_n = JSGenConst.GEN_STACK_MAX
        }
        IfCondition LessThan(JSRTState.gc_n, 0) ThenBlock: { JSRTState.gc_n = 0 }
        JSRTState.gc_a = Dereference(Add(JSRTState.gc_b, 56))
        JSRTState.gc_i = 0
        WhileLoop LessThan(JSRTState.gc_i, JSRTState.gc_n) {
            IfCondition NotEqual(JSRTState.gc_a, 0) ThenBlock: {
                JSRT__GcQueue(Dereference(Add(JSRTState.gc_a, Multiply(JSRTState.gc_i, 8))))
            }
            JSRTState.gc_i = Add(JSRTState.gc_i, 1)
        }
        JSRTState.gc_n = Dereference(Add(JSRTState.gc_b, 48))
        IfCondition GreaterThan(JSRTState.gc_n, JSGenConst.GEN_FRAMES_MAX) ThenBlock: {
            JSRTState.gc_n = JSGenConst.GEN_FRAMES_MAX
        }
        IfCondition LessThan(JSRTState.gc_n, 0) ThenBlock: { JSRTState.gc_n = 0 }
        JSRTState.gc_a = Dereference(Add(JSRTState.gc_b, 128))
        JSRTState.gc_i = 0
        WhileLoop LessThan(JSRTState.gc_i, JSRTState.gc_n) {
            IfCondition NotEqual(JSRTState.gc_a, 0) ThenBlock: {
                JSRT__GcQueue(Dereference(Add(JSRTState.gc_a, Multiply(JSRTState.gc_i, 8))))
            }
            JSRTState.gc_i = Add(JSRTState.gc_i, 1)
        }
        JSRTState.gc_a = Dereference(Add(JSRTState.gc_b, 136))
        JSRTState.gc_i = 0
        WhileLoop LessThan(JSRTState.gc_i, JSRTState.gc_n) {
            IfCondition NotEqual(JSRTState.gc_a, 0) ThenBlock: {
                JSRT__GcQueue(Dereference(Add(JSRTState.gc_a, Multiply(JSRTState.gc_i, 8))))
            }
            JSRTState.gc_i = Add(JSRTState.gc_i, 1)
        }
        JSRTState.gc_a = Dereference(Add(JSRTState.gc_b, 144))
        JSRTState.gc_i = 0
        WhileLoop LessThan(JSRTState.gc_i, JSRTState.gc_n) {
            IfCondition NotEqual(JSRTState.gc_a, 0) ThenBlock: {
                JSRT__GcQueue(Dereference(Add(JSRTState.gc_a, Multiply(JSRTState.gc_i, 8))))
            }
            JSRTState.gc_i = Add(JSRTState.gc_i, 1)
        }
        ReturnValue(1)
    }
}

Function.JSRT__GcScanOne {
    Body: {
        typ = Dereference(JSRTState.gc_obj)
        IfCondition EqualTo(typ, JSType.OBJECT) ThenBlock: {
            JSRT__GcScanTable(Dereference(Add(JSRTState.gc_obj, 8)))
            ReturnValue(1)
        }
        IfCondition EqualTo(typ, JSType.ARRAY) ThenBlock: {
            JSRT__GcScanArray()
            ReturnValue(1)
        }
        IfCondition EqualTo(typ, JSType.FUNCTION) ThenBlock: {
            JSRT__GcScanFunc()
            ReturnValue(1)
        }
        IfCondition EqualTo(typ, JSType.GENERATOR) ThenBlock: {
            JSRT__GcScanGen()
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.JSRT__GcRoots {
    Body: {
        JSRT__GcQueue(JSRTState.object_proto)
        JSRT__GcQueue(JSRTState.array_proto)
        JSRT__GcQueue(JSRTState.function_proto)
        JSRT__GcQueue(JSRTState.generator_function_proto)
        JSRT__GcQueue(JSRTState.generator_proto)
        JSRT__GcQueue(JSRTState.promise_proto)
        JSRT__GcQueue(JSRTState.array_values)
        JSRT__GcQueue(JSRTState.iterator_proto)
        JSRT__GcQueue(JSRTState.array_iter_proto)
        JSRT__GcQueue(JSRTState.string_iter_proto)
        JSRT__GcQueue(JSRTState.map_iter_proto)
        JSRT__GcQueue(JSRTState.set_iter_proto)
        JSRT__GcQueue(JSRTState.async_function_proto)
        JSRT__GcQueue(JSRTState.ots_hold)
        JSRT__GcQueue(JSRTState.hole_val)
        JSRT__GcQueue(JSVMClosure.script_env)
        JSRT__GcQueue(JSVMClosure.this_uninit)
        JSRT__GcQueue(JSVMClosure.tdz_uninit)
        JSRT__GcQueue(JSVMState.exc_val)
        JSRT__GcQueue(JSVMCall.thrown_val)
        JSRT__GcQueue(JSVMAwait.value)
        JSRT__GcQueue(JSVMGen.force_return_val)
        JSRT__GcQueue(JSVMGen.active_genval)
        JSRT__GcQueue(JSVMWithRef.base)
        JSRT__GcQueue(JSVMFreeRef.env)
        JSRT__GcQueue(JSVMSymbol.iterator)
        JSRT__GcQueue(JSVMSymbol.asyncIterator)
        JSRT__GcQueue(JSVMSymbol.species)
        JSRT__GcQueue(JSVMSymbol.match)
        JSRT__GcQueue(JSVMSymbol.replace)
        JSRT__GcQueue(JSVMSymbol.search)
        JSRT__GcQueue(JSVMSymbol.split)
        JSRT__GcQueue(JSVMSymbol.toStringTag)
        JSRT__GcQueue(JSVMSymbol.toPrimitive)
        JSRT__GcQueue(JSVMSymbol.unscopables)
        JSRT__GcQueue(JSVMSymbol.hasInstance)
        JSRT__GcQueue(JSVMSymbol.isConcatSpreadable)
        JSRT__GcQueue(JSVMSymbol.symbol_proto)
        JSRT__GcQueue(JSVMSymbol.registry)

        JSRTState.gc_i = 0
        JSRTState.gc_n = JSVMState.sp
        WhileLoop LessThan(JSRTState.gc_i, JSRTState.gc_n) {
            JSRT__GcQueue(Dereference(Add(JSVMState.stack, Multiply(JSRTState.gc_i, 8))))
            JSRTState.gc_i = Add(JSRTState.gc_i, 1)
        }

        JSRTState.gc_i = 0
        JSRTState.gc_n = JSVMState.fp
        WhileLoop LessThan(JSRTState.gc_i, JSRTState.gc_n) {
            JSRT__GcQueue(Dereference(Add(JSVMClosure.frame_funcs, Multiply(JSRTState.gc_i, 8))))
            JSRT__GcQueue(Dereference(Add(JSVMClosure.frame_envs, Multiply(JSRTState.gc_i, 8))))
            JSRT__GcQueue(Dereference(Add(JSVMClosure.frame_args, Multiply(JSRTState.gc_i, 8))))
            JSRT__GcQueue(Dereference(Add(JSVMClosure.frame_saved_this, Multiply(JSRTState.gc_i, 8))))
            JSRTState.gc_i = Add(JSRTState.gc_i, 1)
        }

        JSRTState.gc_i = 0
        WhileLoop LessThan(JSRTState.gc_i, PropConst.GLOBAL_SLOTS) {
            JSRTState.gc_q = Add(PropState.global_hash, Multiply(JSRTState.gc_i, PropConst.ENTRY_SIZE))
            k = Dereference(JSRTState.gc_q)
            IfCondition EqualTo(k, 0) ThenBlock: {
                JSRTState.gc_i = Add(JSRTState.gc_i, 1)
            } ElseBlock: {
                IfCondition EqualTo(k, PropConst.TOMBSTONE) ThenBlock: {
                    JSRTState.gc_i = Add(JSRTState.gc_i, 1)
                } ElseBlock: {
                    JSRT__GcQueue(Dereference(Add(JSRTState.gc_q, 8)))
                    JSRTState.gc_i = Add(JSRTState.gc_i, 1)
                }
            }
        }

        IfCondition NotEqual(JSVMJobs.queue, 0) ThenBlock: {
            JSRTState.gc_i = 0
            JSRTState.gc_n = JSVMJobs.len
            WhileLoop LessThan(JSRTState.gc_i, JSRTState.gc_n) {
                JSRT__GcQueue(Dereference(Add(JSVMJobs.queue, Multiply(JSRTState.gc_i, 8))))
                JSRTState.gc_i = Add(JSRTState.gc_i, 1)
            }
        }
        ReturnValue(1)
    }
}

Function.JSRT__GcMark {
    Body: {
        JSRTState.gval_gray_sp = 0
        JSRTState.gc_overflow = 0
        IfCondition NotEqual(JSRTState.gval_mark, 0) ThenBlock: {
            MemorySet(JSRTState.gval_mark, 0, 65536)
        }
        IfCondition NotEqual(JSRTState.val_mark, 0) ThenBlock: {
            MemorySet(JSRTState.val_mark, 0, 524288)
        }
        IfCondition NotEqual(JSRTState.pt_mark, 0) ThenBlock: {
            MemorySet(JSRTState.pt_mark, 0, 8192)
        }
        JSRTState.gval_live_n = 0
        JSRTState.val_live_n = 0
        JSRT__GcRoots()
        WhileLoop GreaterThan(JSRTState.gval_gray_sp, 0) {
            JSRTState.gval_gray_sp = Subtract(JSRTState.gval_gray_sp, 1)
            JSRTState.gc_obj = Dereference(Add(JSRTState.gval_gray, Multiply(JSRTState.gval_gray_sp, 8)))
            JSRT__GcScanOne()
        }
        ReturnValue(1)
    }
}

// Returns how many gval slots were pushed onto the free list.
Function.JSRT__GcSweepG {
    Output: Integer
    Body: {
        JSRTState.gc_k = 0
        JSRTState.gc_i = 0
        JSRTState.gc_n = JSRTState.gval_count
        WhileLoop LessThan(JSRTState.gc_i, JSRTState.gc_n) {
            JSRTState.gc_q = Add(JSRTState.gval_pool, Multiply(JSRTState.gc_i, JSRTConst.VAL_SIZE))
            tag = Dereference(JSRTState.gc_q)
            IfCondition EqualTo(tag, -3) ThenBlock: {
                JSRTState.gc_i = Add(JSRTState.gc_i, 1)
            } ElseBlock: {
                hit = JSRT__GcGGet(JSRTState.gc_i)
                IfCondition EqualTo(hit, 0) ThenBlock: {
                    JSRTState.gc_q = Add(JSRTState.gval_pool, Multiply(JSRTState.gc_i, JSRTConst.VAL_SIZE))
                    StoreValue(Add(JSRTState.gc_q, 8), JSRTState.gval_free)
                    StoreValue(JSRTState.gc_q, -3)
                    JSRTState.gval_free = JSRTState.gc_q
                    JSRTState.gc_k = Add(JSRTState.gc_k, 1)
                }
                JSRTState.gc_i = Add(JSRTState.gc_i, 1)
            }
        }
        ReturnValue(JSRTState.gc_k)
    }
}

Function.JSRT__GcSweepTables {
    Body: {
        JSRTState.gc_i = 0
        JSRTState.gc_n = PropState.next_slot
        WhileLoop LessThan(JSRTState.gc_i, JSRTState.gc_n) {
            JSRTState.gc_q = Add(PropState.slab, Multiply(JSRTState.gc_i, PropConst.TABLE_SIZE))
            tag = Dereference(JSRTState.gc_q)
            IfCondition EqualTo(tag, -3) ThenBlock: {
                JSRTState.gc_i = Add(JSRTState.gc_i, 1)
            } ElseBlock: {
                hit = JSRT__GcPGet(JSRTState.gc_i)
                IfCondition EqualTo(hit, 0) ThenBlock: {
                    JSRTState.gc_q = Add(PropState.slab, Multiply(JSRTState.gc_i, PropConst.TABLE_SIZE))
                    StoreValue(Add(JSRTState.gc_q, 8), PropState.free_head)
                    StoreValue(JSRTState.gc_q, -3)
                    PropState.free_head = JSRTState.gc_q
                }
                JSRTState.gc_i = Add(JSRTState.gc_i, 1)
            }
        }
        ReturnValue(1)
    }
}

// =============================================================================
// YOUNG STRINGS — pack reachable payloads into [tenure, tenure+out)
// Scratch holds the bytes until the final copy. Final addresses are published
// during the walk; the young region is not overwritten until every live
// pointer has been retargeted.
// =============================================================================

// Result is always JSRTState.str_neu. Callers must not keep it in a local.
// Copies land on an 8-byte grid so the next pack can read the length word
// aligned. A string that cannot be copied sets str_refused and leaves neu
// as the old pointer; the caller must not rewind if that count is non-zero.
Function.JSRT__StrMap {
    Input: p: Address
    Output: Address
    Body: {
        JSRTState.str_cur = p
        IfCondition EqualTo(JSRTState.str_cur, 0) ThenBlock: {
            JSRTState.str_neu = 0
            ReturnValue(0)
        }
        IfCondition LessThan(JSRTState.str_cur, JSRTState.str_young_lo) ThenBlock: {
            JSRTState.str_neu = JSRTState.str_cur
            ReturnValue(JSRTState.str_neu)
        }
        IfCondition GreaterEqual(JSRTState.str_cur, JSRTState.str_young_hi) ThenBlock: {
            JSRTState.str_neu = JSRTState.str_cur
            ReturnValue(JSRTState.str_neu)
        }
        JSRTState.str_h = BitwiseAnd(ShiftRight(JSRTState.str_cur, 4), JSRTState.str_fwd_mask)
        JSRTState.str_probe = 0
        WhileLoop LessEqual(JSRTState.str_probe, JSRTState.str_fwd_mask) {
            ent_i = BitwiseAnd(Add(JSRTState.str_h, JSRTState.str_probe), JSRTState.str_fwd_mask)
            JSRTState.str_ent = Add(JSRTState.str_fwd, Multiply(ent_i, 16))
            k = Dereference(JSRTState.str_ent)
            IfCondition EqualTo(k, JSRTState.str_cur) ThenBlock: {
                JSRTState.str_neu = Dereference(Add(JSRTState.str_ent, 8))
                ReturnValue(JSRTState.str_neu)
            }
            IfCondition EqualTo(k, 0) ThenBlock: {
                JSRTState.str_neu = Dereference(JSRTState.str_cur)
                IfCondition EqualTo(JSRTState.str_neu, JSRTStr.MAGIC) ThenBlock: {
                    JSRTState.str_h = Dereference(Add(JSRTState.str_cur, 8))
                    IfCondition Or(LessThan(JSRTState.str_h, 0), GreaterThan(JSRTState.str_h, 16777216)) ThenBlock: {
                        JSRTState.str_refused = Add(JSRTState.str_refused, 1)
                        JSRTState.str_neu = JSRTState.str_cur
                        ReturnValue(JSRTState.str_neu)
                    }
                    JSRTState.str_sz = Add(18, Multiply(JSRTState.str_h, 2))
                } ElseBlock: {
                    JSRTState.str_sz = StringLength(JSRTState.str_cur)
                    JSRTState.str_sz = Add(JSRTState.str_sz, 1)
                }
                // Pad so the next string also starts 8-aligned. Exact bytes
                // are copied; the pad is zero and is not part of the string.
                JSRTState.str_h = BitwiseAnd(Subtract(8, BitwiseAnd(JSRTState.str_sz, 7)), 7)
                // Copies stay in the lower 8MB. The upper half holds the live
                // index lists. Also refuse if the packed bytes would run past
                // the slab.
                IfCondition GreaterThan(Add(Add(JSRTState.str_out, JSRTState.str_sz), JSRTState.str_h), 8388608) ThenBlock: {
                    JSRTState.str_refused = Add(JSRTState.str_refused, 1)
                    JSRTState.str_neu = JSRTState.str_cur
                    ReturnValue(JSRTState.str_neu)
                }
                IfCondition GreaterThan(Add(Add(JSRTState.str_out, JSRTState.str_sz), JSRTState.str_h), Subtract(JSRTState.str_slab_cap, Subtract(JSRTState.str_dest_base, JSRTState.str_slab))) ThenBlock: {
                    JSRTState.str_refused = Add(JSRTState.str_refused, 1)
                    JSRTState.str_neu = JSRTState.str_cur
                    ReturnValue(JSRTState.str_neu)
                }
                JSRTState.str_neu = Add(JSRTState.str_dest_base, JSRTState.str_out)
                MemoryCopy(Add(JSRTState.str_scratch, JSRTState.str_out), JSRTState.str_cur, JSRTState.str_sz)
                IfCondition GreaterThan(JSRTState.str_h, 0) ThenBlock: {
                    MemorySet(Add(JSRTState.str_scratch, Add(JSRTState.str_out, JSRTState.str_sz)), 0, JSRTState.str_h)
                }
                StoreValue(JSRTState.str_ent, JSRTState.str_cur)
                StoreValue(Add(JSRTState.str_ent, 8), JSRTState.str_neu)
                JSRTState.str_out = Add(Add(JSRTState.str_out, JSRTState.str_sz), JSRTState.str_h)
                ReturnValue(JSRTState.str_neu)
            }
            JSRTState.str_probe = Add(JSRTState.str_probe, 1)
        }
        JSRTState.str_refused = Add(JSRTState.str_refused, 1)
        JSRTState.str_neu = JSRTState.str_cur
        ReturnValue(JSRTState.str_neu)
    }
}

// Property-table keys only. Value headers are relocated with their slots.
Function.JSRT__GcRelocKeys {
    Input: table: Address
    Body: {
        JSRTState.gc_a = table
        IfCondition EqualTo(JSRTState.gc_a, 0) ThenBlock: { ReturnValue(0) }
        JSRTState.gc_n = Dereference(JSRTState.gc_a)
        IfCondition LessThan(JSRTState.gc_n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(JSRTState.gc_n, PropConst.MAX_ENTRIES) ThenBlock: {
            JSRTState.gc_n = PropConst.MAX_ENTRIES
        }
        JSRTState.gc_i = 0
        WhileLoop LessThan(JSRTState.gc_i, JSRTState.gc_n) {
            JSRTState.gc_q = Add(JSRTState.gc_a, Add(8, Multiply(JSRTState.gc_i, PropConst.ENTRY_SIZE)))
            k = Dereference(JSRTState.gc_q)
            IfCondition EqualTo(k, 0) ThenBlock: {
                JSRTState.gc_i = Add(JSRTState.gc_i, 1)
            } ElseBlock: {
                IfCondition EqualTo(k, PropConst.TOMBSTONE) ThenBlock: {
                    JSRTState.gc_i = Add(JSRTState.gc_i, 1)
                } ElseBlock: {
                    JSRT__StrMap(k)
                    // Phase 2 only. Phase 1 just fills the forward map.
                    // Store the pool result, never a local.
                    IfCondition EqualTo(JSRTState.gc_str_mode, 2) ThenBlock: {
                        StoreValue(JSRTState.gc_q, JSRTState.str_neu)
                    }
                    JSRTState.gc_i = Add(JSRTState.gc_i, 1)
                }
            }
        }
        ReturnValue(1)
    }
}

Function.JSRT__GcRelocValue {
    Input: slot: Address
    Body: {
        JSRTState.gc_obj = slot
        typ = Dereference(JSRTState.gc_obj)
        IfCondition EqualTo(typ, JSType.STRING) ThenBlock: {
            old = Dereference(Add(JSRTState.gc_obj, 8))
            JSRT__StrMap(old)
            IfCondition EqualTo(JSRTState.gc_str_mode, 2) ThenBlock: {
                StoreValue(Add(JSRTState.gc_obj, 8), JSRTState.str_neu)
            }
            ReturnValue(1)
        }
        // Property-table keys are relocated once, from the marked-table walk.
        // Two headers can share one table (ArrSet copies the object slot and
        // keeps the same payload). A second mode-2 walk sees the already
        // rewritten key, misses the forward map, and stores a fragment.
        IfCondition EqualTo(typ, JSType.OBJECT) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(typ, JSType.ARRAY) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(typ, JSType.FUNCTION) ThenBlock: {
            JSRTState.gc_b = Dereference(Add(JSRTState.gc_obj, 8))
            IfCondition NotEqual(JSRTState.gc_b, 0) ThenBlock: {
                oldf = Dereference(Add(JSRTState.gc_b, 24))
                JSRT__StrMap(oldf)
                IfCondition EqualTo(JSRTState.gc_str_mode, 2) ThenBlock: {
                    StoreValue(Add(JSRTState.gc_b, 24), JSRTState.str_neu)
                }
            }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// One pass over marked gvals, marked vals, and global-hash keys.
// gc_str_mode 1 records the forward map. Mode 2 writes str_neu back.
Function.JSRT__GcRelocWalk {
    Body: {
        // Mark recorded the live slots. Dead vals are not roots.
        JSRTState.gc_k = 0
        WhileLoop LessThan(JSRTState.gc_k, JSRTState.gval_live_n) {
            JSRTState.gc_i = Dereference(Add(JSRTState.str_scratch, Add(12582912, Multiply(JSRTState.gc_k, 8))))
            JSRT__GcRelocValue(Add(JSRTState.gval_pool, Multiply(JSRTState.gc_i, JSRTConst.VAL_SIZE)))
            JSRTState.gc_k = Add(JSRTState.gc_k, 1)
        }

        JSRTState.gc_k = 0
        WhileLoop LessThan(JSRTState.gc_k, JSRTState.val_live_n) {
            JSRTState.gc_i = Dereference(Add(JSRTState.str_scratch, Add(8388608, Multiply(JSRTState.gc_k, 8))))
            JSRT__GcRelocValue(Add(JSRTState.val_pool, Multiply(JSRTState.gc_i, JSRTConst.VAL_SIZE)))
            JSRTState.gc_k = Add(JSRTState.gc_k, 1)
        }

        // Every live table once. Shared payloads must not be walked per header.
        JSRTState.gc_k = 0
        WhileLoop LessThan(JSRTState.gc_k, PropState.next_slot) {
            JSRTState.gc_k = Power(JSRTState.gc_k, 1)
            JSRTState.gc_i = JSRT__GcPGet(JSRTState.gc_k)
            IfCondition EqualTo(JSRTState.gc_i, 1) ThenBlock: {
                JSRTState.gc_k = Power(JSRTState.gc_k, 1)
                JSRT__GcRelocKeys(Add(PropState.slab, Multiply(JSRTState.gc_k, PropConst.TABLE_SIZE)))
            }
            JSRTState.gc_k = Power(JSRTState.gc_k, 1)
            JSRTState.gc_k = Add(JSRTState.gc_k, 1)
        }

        JSRTState.gc_k = 0
        WhileLoop LessThan(JSRTState.gc_k, PropConst.GLOBAL_SLOTS) {
            JSRTState.gc_q = Add(PropState.global_hash, Multiply(JSRTState.gc_k, PropConst.ENTRY_SIZE))
            k = Dereference(JSRTState.gc_q)
            IfCondition EqualTo(k, 0) ThenBlock: {
                JSRTState.gc_k = Add(JSRTState.gc_k, 1)
            } ElseBlock: {
                IfCondition EqualTo(k, PropConst.TOMBSTONE) ThenBlock: {
                    JSRTState.gc_k = Add(JSRTState.gc_k, 1)
                } ElseBlock: {
                    JSRT__StrMap(k)
                    IfCondition EqualTo(JSRTState.gc_str_mode, 2) ThenBlock: {
                        StoreValue(JSRTState.gc_q, JSRTState.str_neu)
                    }
                    JSRTState.gc_k = Add(JSRTState.gc_k, 1)
                }
            }
        }
        ReturnValue(1)
    }
}

Function.JSRT__GcRelocStrings {
    Body: {
        JSRTState.str_young_lo = Add(JSRTState.str_slab, JSRTState.str_tenure)
        JSRTState.str_young_hi = Add(JSRTState.str_slab, JSRTState.str_slab_pos)
        // Gap under the aligned dest stays young for this pack, so a
        // string that landed in those 0..7 bytes still moves.
        JSRTState.str_dest_base = BitwiseAnd(Add(JSRTState.str_young_lo, 7), -8)
        JSRTState.str_out = 0
        JSRTState.str_refused = 0
        MemorySet(JSRTState.str_fwd, 0, 8388608)

        JSRTState.gc_str_mode = 1
        JSRT__GcRelocWalk()
        IfCondition EqualTo(JSRTState.str_refused, 0) ThenBlock: {
            // Mode 2 retargets while the young bytes are still intact.
            // The scratch image is published once, after every live pointer
            // has been rewritten. Publishing earlier aliases neu with the
            // from-space prefix and a missed key is copied as packed debris.
            JSRTState.gc_str_mode = 2
            JSRT__GcRelocWalk()
            IfCondition GreaterThan(JSRTState.str_out, 0) ThenBlock: {
                MemoryCopy(JSRTState.str_dest_base, JSRTState.str_scratch, JSRTState.str_out)
            }
            JSRTState.str_tenure = Subtract(JSRTState.str_dest_base, JSRTState.str_slab)
            JSRTState.str_slab_pos = Add(JSRTState.str_tenure, JSRTState.str_out)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// ENTRY — cheap until a pool is actually under pressure
// =============================================================================

Function.JSRT__GcEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(JSRTState.gval_mark, 0) ThenBlock: {
            JSRTState.gval_mark = Allocate(65536)
            IfCondition EqualTo(JSRTState.gval_mark, 0) ThenBlock: { ReturnValue(0) }
            MemorySet(JSRTState.gval_mark, 0, 65536)
        }
        IfCondition EqualTo(JSRTState.val_mark, 0) ThenBlock: {
            JSRTState.val_mark = Allocate(524288)
            IfCondition EqualTo(JSRTState.val_mark, 0) ThenBlock: { ReturnValue(0) }
            MemorySet(JSRTState.val_mark, 0, 524288)
        }
        IfCondition EqualTo(JSRTState.pt_mark, 0) ThenBlock: {
            JSRTState.pt_mark = Allocate(8192)
            IfCondition EqualTo(JSRTState.pt_mark, 0) ThenBlock: { ReturnValue(0) }
            MemorySet(JSRTState.pt_mark, 0, 8192)
        }
        IfCondition EqualTo(JSRTState.gval_gray, 0) ThenBlock: {
            JSRTState.gval_gray_cap = 1048576
            JSRTState.gval_gray = Allocate(8388608)
            IfCondition EqualTo(JSRTState.gval_gray, 0) ThenBlock: { ReturnValue(0) }
            MemorySet(JSRTState.gval_gray, 0, 8388608)
        }
        IfCondition EqualTo(JSRTState.str_scratch, 0) ThenBlock: {
            JSRTState.str_scratch = Allocate(16777216)
            IfCondition EqualTo(JSRTState.str_scratch, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(JSRTState.str_fwd, 0) ThenBlock: {
            JSRTState.str_fwd_mask = 524287
            JSRTState.str_fwd = Allocate(8388608)
            IfCondition EqualTo(JSRTState.str_fwd, 0) ThenBlock: { ReturnValue(0) }
            MemorySet(JSRTState.str_fwd, 0, 8388608)
        }
        ReturnValue(1)
    }
}

Function.JSRT_GcTick {
    Output: Integer
    Body: {
        IfCondition NotEqual(JSRTState.gc_busy, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(JSRTState.str_tenure, 0) ThenBlock: {
            JSRTState.str_tenure = JSRTState.str_slab_pos
            ReturnValue(0)
        }
        // gc_str_mode 1 = young strings need a pack. Stashed in the pool
        // because the mark/sweep calls below outlive a local.
        JSRTState.gc_str_mode = 0
        IfCondition GreaterThan(Subtract(JSRTState.str_slab_pos, JSRTState.str_tenure), 4194304) ThenBlock: {
            JSRTState.gc_str_mode = 1
        }
        need_m = 0
        IfCondition And(GreaterThan(JSRTState.gval_count, 200000), EqualTo(JSRTState.gval_free, 0)) ThenBlock: {
            IfCondition GreaterThan(JSRTState.gval_count, JSRTState.gc_hold) ThenBlock: {
                need_m = 1
            }
        }
        IfCondition And(GreaterThan(PropState.next_slot, 32768), EqualTo(PropState.free_head, 0)) ThenBlock: {
            need_m = 1
        }
        IfCondition And(EqualTo(JSRTState.gc_str_mode, 0), EqualTo(need_m, 0)) ThenBlock: {
            ReturnValue(0)
        }
        ok = JSRT__GcEnsure()
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        JSRTState.gc_busy = 1
        JSRT__GcMark()
        IfCondition NotEqual(JSRTState.gc_overflow, 0) ThenBlock: {
            JSRTState.gc_busy = 0
            ReturnValue(0)
        }
        JSRT__GcSweepG()
        JSRT__GcSweepTables()
        IfCondition GreaterThan(JSRTState.gc_k, 0) ThenBlock: {
            JSRTState.gc_hold = 0
        } ElseBlock: {
            JSRTState.gc_hold = JSRTState.gval_count
        }
        IfCondition EqualTo(JSRTState.gc_str_mode, 1) ThenBlock: {
            JSRT__GcRelocStrings()
        }
        // String reloc and table reuse invalidate cached entry addresses.
        IfCondition NotEqual(PropState.cache, 0) ThenBlock: {
            MemorySet(PropState.cache, 0, 6144)
        }
        JSRTState.gc_busy = 0
        ReturnValue(1)
    }
}
