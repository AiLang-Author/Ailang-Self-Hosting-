// =============================================================================
// OBJECT OPERATIONS — property access using PropTable (FixedPool)
// =============================================================================

// Get a property from a FUNCTION JSValue.
// Supports "prototype" at descriptor+48, "__super__" at descriptor+56.
// Arbitrary properties via PropTable at descriptor+64 (lazy-allocated).
// Returns JSValue pointer, or undef_val if not found.
Function.JSRT_FuncPropGet {
    Input: obj: Address
    Input: key: Address
    Output: Address
    Body: {
        save_key = key
        fdesc = Dereference(Add(obj, 8))
        IfCondition EqualTo(fdesc, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        k0 = GetByte(save_key, 0)
        // Check if key == "prototype" (112,114,111,116,111,116,121,112,101,0)
        IfCondition EqualTo(k0, 112) ThenBlock: {
            k1 = GetByte(save_key, 1)
            IfCondition EqualTo(k1, 114) ThenBlock: {
                k8 = GetByte(save_key, 8)
                IfCondition EqualTo(k8, 101) ThenBlock: {
                    k9 = GetByte(save_key, 9)
                    IfCondition EqualTo(k9, 0) ThenBlock: {
                        result = Dereference(Add(fdesc, 48))
                        IfCondition EqualTo(result, 0) ThenBlock: {
                            ReturnValue(JSRTState.undef_val)
                        }
                        ReturnValue(result)
                    }
                }
            }
        }
        // Check if key == "__super__" (95,95,115,117,112,101,114,95,95,0)
        IfCondition EqualTo(k0, 95) ThenBlock: {
            k1 = GetByte(save_key, 1)
            IfCondition EqualTo(k1, 95) ThenBlock: {
                k2 = GetByte(save_key, 2)
                IfCondition EqualTo(k2, 115) ThenBlock: {
                    k8 = GetByte(save_key, 8)
                    IfCondition EqualTo(k8, 95) ThenBlock: {
                        k9 = GetByte(save_key, 9)
                        IfCondition EqualTo(k9, 0) ThenBlock: {
                            result = Dereference(Add(fdesc, 56))
                            IfCondition EqualTo(result, 0) ThenBlock: {
                                ReturnValue(JSRTState.undef_val)
                            }
                            ReturnValue(result)
                        }
                    }
                }
            }
        }
        // Fallback: check PropTable at descriptor+64 for arbitrary properties
        prop_table = Dereference(Add(fdesc, 64))
        IfCondition NotEqual(prop_table, 0) ThenBlock: {
            result = PropTable_Lookup(prop_table, save_key)
            IfCondition NotEqual(result, -1) ThenBlock: {
                ReturnValue(result)
            }
        }
        ReturnValue(JSRTState.undef_val)
    }
}

// Set a property on a FUNCTION JSValue.
// Supports "prototype" at descriptor+48, "__super__" at descriptor+56.
// Arbitrary properties via PropTable at descriptor+64 (lazy-allocated).
// Returns 1 on success, 0 on failure.
Function.JSRT_FuncPropSet {
    Input: obj: Address
    Input: key: Address
    Input: val: Address
    Output: Integer
    Body: {
        save_key = key
        save_val = val
        fdesc = Dereference(Add(obj, 8))
        IfCondition EqualTo(fdesc, 0) ThenBlock: { ReturnValue(0) }
        k0 = GetByte(save_key, 0)
        // Check if key == "prototype"
        IfCondition EqualTo(k0, 112) ThenBlock: {
            k1 = GetByte(save_key, 1)
            IfCondition EqualTo(k1, 114) ThenBlock: {
                k8 = GetByte(save_key, 8)
                IfCondition EqualTo(k8, 101) ThenBlock: {
                    k9 = GetByte(save_key, 9)
                    IfCondition EqualTo(k9, 0) ThenBlock: {
                        StoreValue(Add(fdesc, 48), save_val)
                        ReturnValue(1)
                    }
                }
            }
        }
        // Check if key == "__super__" (95,95,115,117,112,101,114,95,95,0)
        IfCondition EqualTo(k0, 95) ThenBlock: {
            k1 = GetByte(save_key, 1)
            IfCondition EqualTo(k1, 95) ThenBlock: {
                k2 = GetByte(save_key, 2)
                IfCondition EqualTo(k2, 115) ThenBlock: {
                    k8 = GetByte(save_key, 8)
                    IfCondition EqualTo(k8, 95) ThenBlock: {
                        k9 = GetByte(save_key, 9)
                        IfCondition EqualTo(k9, 0) ThenBlock: {
                            StoreValue(Add(fdesc, 56), save_val)
                            ReturnValue(1)
                        }
                    }
                }
            }
        }
        // Fallback: arbitrary properties via PropTable at descriptor+64
        prop_table = Dereference(Add(fdesc, 64))
        IfCondition EqualTo(prop_table, 0) ThenBlock: {
            // Lazy-allocate PropTable on first unknown-key write
            prop_table = PropTable_Alloc()
            StoreValue(Add(fdesc, 64), prop_table)
        }
        PropTable_Insert(prop_table, save_key, save_val)
        ReturnValue(1)
    }
}

// Get a property from an OBJECT JSValue by key string (null-terminated).
// Returns JSValue pointer, or undef_val if not found or not an object.
Function.JSRT_ObjGet {
    Input: obj: Address
    Input: key: Address
    Output: Address
    Body: {
        save_obj = obj
        save_key = key
        IfCondition EqualTo(save_obj, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        otype = Dereference(save_obj)
        IfCondition EqualTo(otype, JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSRT_FuncPropGet(save_obj, save_key))
        }
        // ARRAY type — own named props in side table, then __proto__ (Mole 16).
        // Without proto walk, [][Symbol.iterator] never reaches Array.prototype.
        IfCondition EqualTo(otype, JSType.ARRAY) ThenBlock: {
            arr_pt = ArrSide_Lookup(save_obj)
            IfCondition NotEqual(arr_pt, 0) ThenBlock: {
                arr_r = PropTable_Lookup(arr_pt, save_key)
                IfCondition NotEqual(arr_r, -1) ThenBlock: {
                    ReturnValue(arr_r)
                }
                JSRT__Push(save_key)
                proto = PropTable_Lookup(arr_pt, "__proto__")
                save_key = JSRT__Pop()
                IfCondition EqualTo(proto, -1) ThenBlock: {
                    ReturnValue(JSRTState.undef_val)
                }
                IfCondition EqualTo(proto, 0) ThenBlock: {
                    ReturnValue(JSRTState.undef_val)
                }
                ReturnValue(JSRT_ObjGet(proto, save_key))
            }
            IfCondition NotEqual(JSRTState.array_proto, 0) ThenBlock: {
                ReturnValue(JSRT_ObjGet(JSRTState.array_proto, save_key))
            }
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition NotEqual(otype, JSType.OBJECT) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        hash = Dereference(Add(save_obj, 8))
        IfCondition EqualTo(hash, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        result = PropTable_Lookup(hash, save_key)
        IfCondition NotEqual(result, -1) ThenBlock: {
            ReturnValue(result)
        }
        // Not found on own object — check __proto__ chain
        JSRT__Push(save_key)
        proto = PropTable_Lookup(hash, "__proto__")
        save_key = JSRT__Pop()
        IfCondition EqualTo(proto, -1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(proto, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        // Recurse into __proto__
        ReturnValue(JSRT_ObjGet(proto, save_key))
    }
}

// Set a property on an OBJECT JSValue. key is null-terminated string.
// val is a JSValue pointer. Returns 1 on success, 0 on failure.
Function.JSRT_ObjSet {
    Input: obj: Address
    Input: key: Address
    Input: val: Address
    Output: Integer
    Body: {
        save_obj = obj
        save_key = key
        save_val = val
        IfCondition EqualTo(save_obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        // ── VALUE COPY ──
        // PropTable stores the JSValue *pointer*. If we store a pointer to a
        // local-variable stack slot or any mutable location, subsequent writes
        // to that slot silently corrupt every property that shares it.
        // Fix: allocate a fresh val_pool slot and copy the 16-byte JSValue so
        // the property owns an independent copy of the value.
        // Property values must survive ReclaimScope (function return).
        // Singletons are immortal; everything else is copied into gval_pool.
        IfCondition NotEqual(save_val, 0) ThenBlock: {
            use_direct = 0
            IfCondition EqualTo(save_val, JSRTState.true_val) ThenBlock: { use_direct = 1 }
            IfCondition EqualTo(save_val, JSRTState.false_val) ThenBlock: { use_direct = 1 }
            IfCondition EqualTo(save_val, JSRTState.null_val) ThenBlock: { use_direct = 1 }
            IfCondition EqualTo(save_val, JSRTState.undef_val) ThenBlock: { use_direct = 1 }
            IfCondition EqualTo(use_direct, 0) ThenBlock: {
                copy = JSRT__AllocGlobalValue()
                IfCondition EqualTo(copy, 0) ThenBlock: {
                    copy = JSRT__AllocValue()
                }
                IfCondition NotEqual(copy, 0) ThenBlock: {
                    StoreValue(copy, Dereference(save_val))
                    StoreValue(Add(copy, 8), Dereference(Add(save_val, 8)))
                    IfCondition EqualTo(Dereference(save_val), JSType.STRING) ThenBlock: {
                        spay = Dereference(Add(save_val, 8))
                        IfCondition NotEqual(spay, 0) ThenBlock: {
                            slen = StringLength(spay)
                            nbuf = JSRT__StrSlabAlloc(Add(slen, 1))
                            IfCondition NotEqual(nbuf, 0) ThenBlock: {
                                MemoryCopy(nbuf, spay, Add(slen, 1))
                                StoreValue(Add(copy, 8), nbuf)
                            }
                        }
                    }
                    save_val = copy
                }
            }
        }
        otype = Dereference(save_obj)
        IfCondition EqualTo(otype, JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSRT_FuncPropSet(save_obj, save_key, save_val))
        }
        // ARRAY type — use side table for named properties
        IfCondition EqualTo(otype, JSType.ARRAY) ThenBlock: {
            arr_pt = ArrSide_GetOrCreate(save_obj)
            PropTable_Insert(arr_pt, save_key, save_val)
            ReturnValue(1)
        }
        IfCondition NotEqual(otype, JSType.OBJECT) ThenBlock: {
            ReturnValue(0)
        }
        hash = Dereference(Add(save_obj, 8))
        IfCondition EqualTo(hash, 0) ThenBlock: {
            ReturnValue(0)
        }
        PropTable_Insert(hash, save_key, save_val)
        ReturnValue(1)
    }
}

// Check if an OBJECT has a property. Returns 1 if exists, 0 if not.
Function.JSRT_ObjHas {
    Input: obj: Address
    Input: key: Address
    Output: Integer
    Body: {
        save_obj = obj
        save_key = key
        IfCondition EqualTo(save_obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        otype = Dereference(save_obj)
        IfCondition NotEqual(otype, JSType.OBJECT) ThenBlock: {
            ReturnValue(0)
        }
        hash = Dereference(Add(save_obj, 8))
        IfCondition EqualTo(hash, 0) ThenBlock: {
            ReturnValue(0)
        }
        result = PropTable_Exists(hash, save_key)
        IfCondition NotEqual(result, 0) ThenBlock: {
            ReturnValue(1)
        }
        // Not found — walk __proto__ chain
        proto = PropTable_Lookup(hash, "__proto__")
        IfCondition EqualTo(proto, -1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(proto, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(JSRT_ObjHas(proto, save_key))
    }
}

// Delete a property from an OBJECT or ARRAY (named side props).
// Returns 1 on success, 0 if not an object/array.
Function.JSRT_ObjDelete {
    Input: obj: Address
    Input: key: Address
    Output: Integer
    Body: {
        save_obj = obj
        save_key = key
        IfCondition EqualTo(save_obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        otype = Dereference(save_obj)
        // ARRAY named props live in ArrSide PropTable
        IfCondition EqualTo(otype, JSType.ARRAY) ThenBlock: {
            arr_pt = ArrSide_Lookup(save_obj)
            IfCondition NotEqual(arr_pt, 0) ThenBlock: {
                PropTable_Delete(arr_pt, save_key)
            }
            ReturnValue(1)
        }
        IfCondition NotEqual(otype, JSType.OBJECT) ThenBlock: {
            ReturnValue(0)
        }
        hash = Dereference(Add(save_obj, 8))
        IfCondition EqualTo(hash, 0) ThenBlock: {
            ReturnValue(0)
        }
        PropTable_Delete(hash, save_key)
        ReturnValue(1)
    }
}

// Get all enumerable property keys of an OBJECT as a JS ARRAY of STRING JSValues.
// Returns a new ARRAY JSValue, or an empty array on failure.
Function.JSRT_ObjKeys {
    Input: obj: Address
    Output: Address
    Body: {
        save_obj = obj
        result_arr = JSRT_CreateArray()
        IfCondition EqualTo(save_obj, 0) ThenBlock: {
            ReturnValue(result_arr)
        }
        otype = Dereference(save_obj)
        IfCondition NotEqual(otype, JSType.OBJECT) ThenBlock: {
            ReturnValue(result_arr)
        }
        hash = Dereference(Add(save_obj, 8))
        IfCondition EqualTo(hash, 0) ThenBlock: {
            ReturnValue(result_arr)
        }
        // Get raw XArray of key pointers from PropTable
        raw_keys = PropTable_Keys(hash)
        klen = Array.Size(raw_keys)
        ki = 0
        WhileLoop LessThan(ki, klen) {
            kstr = Array.Get(raw_keys, ki)
            // Skip engine-internal keys: __proto__, __class__, __get_*, __set_*,
            // __ctor__, __dom_*, __regex_*, __field_init__, etc. These are stored
            // as ordinary PropTable entries but must not appear in Object.keys /
            // for-in (especially after NEW_OBJECT stamps __proto__).
            skip = 0
            IfCondition NotEqual(kstr, 0) ThenBlock: {
                IfCondition EqualTo(GetByte(kstr, 0), 95) ThenBlock: {
                    IfCondition EqualTo(GetByte(kstr, 1), 95) ThenBlock: {
                        skip = 1
                    }
                }
            }
            IfCondition EqualTo(skip, 0) ThenBlock: {
                // Skip non-enumerable own properties (Wave 2: __a_<key> bitfield)
                // bit1 = enumerable; missing attr key → enumerable (default 7)
                enum_ok = 1
                nlen2 = StringLength(kstr)
                ak = JSRT__StrSlabAlloc(Add(nlen2, 6))
                IfCondition NotEqual(ak, 0) ThenBlock: {
                    SetByte(ak, 0, 95)
                    SetByte(ak, 1, 95)
                    SetByte(ak, 2, 97)
                    SetByte(ak, 3, 95)
                    MemoryCopy(Add(ak, 4), kstr, Add(nlen2, 1))
                    av = PropTable_Lookup(hash, ak)
                    IfCondition NotEqual(av, -1) ThenBlock: {
                        IfCondition NotEqual(av, 0) ThenBlock: {
                            avt = JSRT_GetType(av)
                            IfCondition EqualTo(avt, JSType.NUMBER) ThenBlock: {
                                bits = Float_ToInt(JSRT_GetPayload(av))
                                IfCondition EqualTo(BitwiseAnd(bits, 2), 0) ThenBlock: {
                                    enum_ok = 0
                                }
                            }
                        }
                    }
                }
                IfCondition EqualTo(enum_ok, 1) ThenBlock: {
                    ksv = JSRT_CreateString(kstr)
                    JSRT_ArrPush(result_arr, ksv)
                }
            }
            ki = Add(ki, 1)
        }
        ReturnValue(result_arr)
    }
}

// =============================================================================
// ARRAY OPERATIONS — element access using XArray
// =============================================================================

// Push a value onto an ARRAY JSValue. val is a JSValue pointer.
// Returns new length, or -1 on failure.
Function.JSRT_ArrPush {
    Input: arr: Address
    Input: val: Address
    Output: Integer
    Body: {
        save_arr = arr
        save_val = val
        IfCondition EqualTo(save_arr, 0) ThenBlock: {
            ReturnValue(-1)
        }
        atype = Dereference(save_arr)
        IfCondition NotEqual(atype, JSType.ARRAY) ThenBlock: {
            ReturnValue(-1)
        }
        xa = Dereference(Add(save_arr, 8))
        IfCondition EqualTo(xa, 0) ThenBlock: {
            ReturnValue(-1)
        }
        // Persist element like ObjSet: array outlives the pushing frame.
        // Singletons immortal; others → gval_pool copy (survives ReclaimScope).
        IfCondition NotEqual(save_val, 0) ThenBlock: {
            use_direct = 0
            IfCondition EqualTo(save_val, JSRTState.true_val) ThenBlock: { use_direct = 1 }
            IfCondition EqualTo(save_val, JSRTState.false_val) ThenBlock: { use_direct = 1 }
            IfCondition EqualTo(save_val, JSRTState.null_val) ThenBlock: { use_direct = 1 }
            IfCondition EqualTo(save_val, JSRTState.undef_val) ThenBlock: { use_direct = 1 }
            IfCondition EqualTo(use_direct, 0) ThenBlock: {
                copy = JSRT__AllocGlobalValue()
                IfCondition EqualTo(copy, 0) ThenBlock: {
                    copy = JSRT__AllocValue()
                }
                IfCondition NotEqual(copy, 0) ThenBlock: {
                    StoreValue(copy, Dereference(save_val))
                    StoreValue(Add(copy, 8), Dereference(Add(save_val, 8)))
                    IfCondition EqualTo(Dereference(save_val), JSType.STRING) ThenBlock: {
                        spay = Dereference(Add(save_val, 8))
                        IfCondition NotEqual(spay, 0) ThenBlock: {
                            slen = StringLength(spay)
                            nbuf = JSRT__StrSlabAlloc(Add(slen, 1))
                            IfCondition NotEqual(nbuf, 0) ThenBlock: {
                                MemoryCopy(nbuf, spay, Add(slen, 1))
                                StoreValue(Add(copy, 8), nbuf)
                            }
                        }
                    }
                    save_val = copy
                }
            }
        }
        Array.Push(xa, save_val)
        new_len = Array.Size(xa)
        ReturnValue(new_len)
    }
}

// Get an element from an ARRAY JSValue by index.
// Returns JSValue pointer, or undef_val if out of bounds.
Function.JSRT_ArrGet {
    Input: arr: Address
    Input: idx: Integer
    Output: Address
    Body: {
        save_arr = arr
        save_idx = idx
        IfCondition EqualTo(save_arr, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        atype = Dereference(save_arr)
        IfCondition NotEqual(atype, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        xa = Dereference(Add(save_arr, 8))
        IfCondition EqualTo(xa, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        result = Array.Get(xa, save_idx)
        // Array.Get returns 0 for OOB / null arr (NOT Collections.XERROR).
        // Returning a null JSValue pointer crashes on later GetType/ObjSet —
        // the root cause of `var [x]=[]`, dstr defaults, and many for/dstr hangs.
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(result, Collections.XERROR) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        ReturnValue(result)
    }
}

// Set an element in an ARRAY JSValue by index.
// Returns 1 on success, 0 on failure.
Function.JSRT_ArrSet {
    Input: arr: Address
    Input: idx: Integer
    Input: val: Address
    Output: Integer
    Body: {
        save_arr = arr
        save_idx = idx
        save_val = val
        IfCondition EqualTo(save_arr, 0) ThenBlock: {
            ReturnValue(0)
        }
        atype = Dereference(save_arr)
        IfCondition NotEqual(atype, JSType.ARRAY) ThenBlock: {
            ReturnValue(0)
        }
        xa = Dereference(Add(save_arr, 8))
        IfCondition EqualTo(xa, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Persist like ArrPush / ObjSet
        IfCondition NotEqual(save_val, 0) ThenBlock: {
            use_direct = 0
            IfCondition EqualTo(save_val, JSRTState.true_val) ThenBlock: { use_direct = 1 }
            IfCondition EqualTo(save_val, JSRTState.false_val) ThenBlock: { use_direct = 1 }
            IfCondition EqualTo(save_val, JSRTState.null_val) ThenBlock: { use_direct = 1 }
            IfCondition EqualTo(save_val, JSRTState.undef_val) ThenBlock: { use_direct = 1 }
            IfCondition EqualTo(use_direct, 0) ThenBlock: {
                copy = JSRT__AllocGlobalValue()
                IfCondition EqualTo(copy, 0) ThenBlock: {
                    copy = JSRT__AllocValue()
                }
                IfCondition NotEqual(copy, 0) ThenBlock: {
                    StoreValue(copy, Dereference(save_val))
                    StoreValue(Add(copy, 8), Dereference(Add(save_val, 8)))
                    IfCondition EqualTo(Dereference(save_val), JSType.STRING) ThenBlock: {
                        spay = Dereference(Add(save_val, 8))
                        IfCondition NotEqual(spay, 0) ThenBlock: {
                            slen = StringLength(spay)
                            nbuf = JSRT__StrSlabAlloc(Add(slen, 1))
                            IfCondition NotEqual(nbuf, 0) ThenBlock: {
                                MemoryCopy(nbuf, spay, Add(slen, 1))
                                StoreValue(Add(copy, 8), nbuf)
                            }
                        }
                    }
                    save_val = copy
                }
            }
        }
        result = Array.Set(xa, save_idx, save_val)
        ReturnValue(result)
    }
}

// Get the length of an ARRAY JSValue.
// Returns element count, or 0 if not an array.
Function.JSRT_ArrLen {
    Input: arr: Address
    Output: Integer
    Body: {
        save_arr = arr
        IfCondition EqualTo(save_arr, 0) ThenBlock: {
            ReturnValue(0)
        }
        atype = Dereference(save_arr)
        IfCondition NotEqual(atype, JSType.ARRAY) ThenBlock: {
            ReturnValue(0)
        }
        xa = Dereference(Add(save_arr, 8))
        IfCondition EqualTo(xa, 0) ThenBlock: {
            ReturnValue(0)
        }
        result = Array.Size(xa)
        ReturnValue(result)
    }
}

// Pop the last element from an ARRAY JSValue.
// Returns JSValue pointer, or undef_val if empty.
Function.JSRT_ArrPop {
    Input: arr: Address
    Output: Address
    Body: {
        save_arr = arr
        IfCondition EqualTo(save_arr, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        atype = Dereference(save_arr)
        IfCondition NotEqual(atype, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        xa = Dereference(Add(save_arr, 8))
        IfCondition EqualTo(xa, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        result = Array.Pop(xa)
        IfCondition EqualTo(result, Collections.XERROR) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        ReturnValue(result)
    }
}

// =============================================================================
// FUNCTION DESCRIPTOR ACCESS
// =============================================================================

// Get bytecode offset from a FUNCTION JSValue.
Function.JSRT_FuncGetBC {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(save_val)
        IfCondition NotEqual(vtype, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        desc = Dereference(Add(save_val, 8))
        IfCondition EqualTo(desc, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(desc))
    }
}

// Get param count from a FUNCTION JSValue.
Function.JSRT_FuncGetParams {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(save_val)
        IfCondition NotEqual(vtype, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        desc = Dereference(Add(save_val, 8))
        IfCondition EqualTo(desc, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(desc, 8)))
    }
}

// Get local count from a FUNCTION JSValue.
Function.JSRT_FuncGetLocals {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(save_val)
        IfCondition NotEqual(vtype, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        desc = Dereference(Add(save_val, 8))
        IfCondition EqualTo(desc, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(desc, 16)))
    }
}

// Get name pointer from a FUNCTION JSValue.
Function.JSRT_FuncGetName {
    Input: val: Address
    Output: Address
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(save_val)
        IfCondition NotEqual(vtype, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        desc = Dereference(Add(save_val, 8))
        IfCondition EqualTo(desc, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(desc, 24)))
    }
}

// Get closure env pointer from a FUNCTION JSValue.
Function.JSRT_FuncGetEnv {
    Input: val: Address
    Output: Address
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(save_val)
        IfCondition NotEqual(vtype, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        desc = Dereference(Add(save_val, 8))
        IfCondition EqualTo(desc, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(desc, 40)))
    }
}

// Set closure env pointer on a FUNCTION JSValue.
Function.JSRT_FuncSetEnv {
    Input: val: Address
    Input: env: Address
    Output: Integer
    Body: {
        save_val = val
        save_env = env
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(save_val)
        IfCondition NotEqual(vtype, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        desc = Dereference(Add(save_val, 8))
        IfCondition EqualTo(desc, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(desc, 40), save_env)
        ReturnValue(1)
    }
}

// =============================================================================
// NATIVE FUNCTION TABLE
// Each entry: { name_ptr(8), name_len(8), handler_id(8) } = 24 bytes
// =============================================================================

// Register a native function by name and handler ID.
// Returns the index in the native table, or -1 on overflow.
Function.JSRT_RegisterNative {
    Input: name: Address
    Input: handler_id: Integer
    Output: Integer
    Body: {
        save_name = name
        save_id = handler_id
        IfCondition GreaterEqual(JSRTState.native_count, JSRTConst.MAX_NATIVES) ThenBlock: {
            ReturnValue(-1)
        }
        idx = JSRTState.native_count
        JSRTState.native_count = Add(idx, 1)
        base = Add(JSRTState.native_table, Multiply(idx, JSRTConst.NATIVE_SIZE))
        // Store name pointer
        StoreValue(base, save_name)
        // Store name length
        nlen = StringLength(save_name)
        StoreValue(Add(base, 8), nlen)
        // Store handler ID
        StoreValue(Add(base, 16), save_id)
        ReturnValue(idx)
    }
}

// Look up a native function by name. Returns handler_id or -1 if not found.
Function.JSRT_FindNative {
    Input: name: Address
    Output: Integer
    Body: {
        save_name = name
        JSRTTmp.idx = 0
        WhileLoop LessThan(JSRTTmp.idx, JSRTState.native_count) {
            base = Add(JSRTState.native_table, Multiply(JSRTTmp.idx, JSRTConst.NATIVE_SIZE))
            entry_name = Dereference(base)
            cmp = StringCompare(entry_name, save_name)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(Dereference(Add(base, 16)))
            }
            JSRTTmp.idx = Add(JSRTTmp.idx, 1)
        }
        ReturnValue(-1)
    }
}

// Call a native function by handler ID with args array and arg count.
// For now returns undefined — the bridge (JSVM) will implement actual handlers.
// args is a pointer to an array of JSValue pointers, argc is the count.
Function.JSRT_CallNative {
    Input: id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = id
        save_args = args
        save_argc = argc

        // Validate handler ID exists
        IfCondition LessThan(save_id, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition GreaterEqual(save_id, JSRTState.native_count) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }

        // ─── Built-in handler IDs ───
        // Handler 1: console.log — print args to stdout (stub: just return undefined)
        // Handler 2: Math.abs
        // Handler 3: Math.max
        // Handler 4: Math.min
        // Handler 5: Math.floor (identity for integers)
        // Handler 6: Math.ceil (identity for integers)
        // Handler 7: Math.round (identity for integers)
        // Handler 8: Math.pow

        // Handler 1: console.log — return undefined (actual I/O handled by VM bridge)
        IfCondition EqualTo(save_id, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }

        // Handler 2: Math.abs — absolute value (IEEE 754 double)
        IfCondition EqualTo(save_id, 1) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                nval = JSRT_ToNumber(arg0)
                // Clear sign bit: AND with 0x7FFFFFFFFFFFFFFF (= 9223372036854775807)
                abs_val = BitwiseAnd(nval, 9223372036854775807)
                ReturnValue(JSRT_CreateFloat(abs_val))
            }
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }

        // Handler 3: Math.max — return maximum of all args (IEEE 754)
        IfCondition EqualTo(save_id, 2) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                // -Infinity as double bits
                ReturnValue(JSRT_CreateFloat(18442240474082181120))
            }
            arg0 = Dereference(save_args)
            JSRT__Push(save_args)
            JSRT__Push(save_argc)
            best = JSRT_ToNumber(arg0)
            save_argc = JSRT__Pop()
            save_args = JSRT__Pop()
            mi = 1
            WhileLoop LessThan(mi, save_argc) {
                argi = Dereference(Add(save_args, Multiply(mi, 8)))
                JSRT__Push(best)
                JSRT__Push(save_args)
                JSRT__Push(save_argc)
                JSRT__Push(mi)
                ni = JSRT_ToNumber(argi)
                mi = JSRT__Pop()
                save_argc = JSRT__Pop()
                save_args = JSRT__Pop()
                best = JSRT__Pop()
                IfCondition EqualTo(Float_Gt(ni, best), 1) ThenBlock: {
                    best = ni
                }
                mi = Add(mi, 1)
            }
            ReturnValue(JSRT_CreateFloat(best))
        }

        // Handler 4: Math.min — return minimum of all args (IEEE 754)
        IfCondition EqualTo(save_id, 3) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                // +Infinity as double bits
                ReturnValue(JSRT_CreateFloat(9218868437227405312))
            }
            arg0 = Dereference(save_args)
            JSRT__Push(save_args)
            JSRT__Push(save_argc)
            best = JSRT_ToNumber(arg0)
            save_argc = JSRT__Pop()
            save_args = JSRT__Pop()
            mi = 1
            WhileLoop LessThan(mi, save_argc) {
                argi = Dereference(Add(save_args, Multiply(mi, 8)))
                JSRT__Push(best)
                JSRT__Push(save_args)
                JSRT__Push(save_argc)
                JSRT__Push(mi)
                ni = JSRT_ToNumber(argi)
                mi = JSRT__Pop()
                save_argc = JSRT__Pop()
                save_args = JSRT__Pop()
                best = JSRT__Pop()
                IfCondition EqualTo(Float_Lt(ni, best), 1) ThenBlock: {
                    best = ni
                }
                mi = Add(mi, 1)
            }
            ReturnValue(JSRT_CreateFloat(best))
        }

        // Handler 5: Math.floor — floor via truncate, adjust for negatives
        IfCondition EqualTo(save_id, 4) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                nval = JSRT_ToNumber(arg0)
                trunc_val = Float_FromInt(Float_ToInt(nval))
                // If negative and truncation changed the value, subtract 1
                is_neg = Float_Lt(nval, Float_FromInt(0))
                is_diff = Float_Ne(trunc_val, nval)
                IfCondition And(EqualTo(is_neg, 1), EqualTo(is_diff, 1)) ThenBlock: {
                    trunc_val = Float_Sub(trunc_val, Float_FromInt(1))
                }
                ReturnValue(JSRT_CreateFloat(trunc_val))
            }
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }

        // Handler 6: Math.ceil — ceil via truncate, adjust for positives
        IfCondition EqualTo(save_id, 5) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                nval = JSRT_ToNumber(arg0)
                trunc_val = Float_FromInt(Float_ToInt(nval))
                // If positive and truncation changed the value, add 1
                is_pos = Float_Gt(nval, Float_FromInt(0))
                is_diff = Float_Ne(trunc_val, nval)
                IfCondition And(EqualTo(is_pos, 1), EqualTo(is_diff, 1)) ThenBlock: {
                    trunc_val = Float_Add(trunc_val, Float_FromInt(1))
                }
                ReturnValue(JSRT_CreateFloat(trunc_val))
            }
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }

        // Handler 7: Math.round — round to nearest integer
        IfCondition EqualTo(save_id, 6) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                nval = JSRT_ToNumber(arg0)
                // Add 0.5, then floor
                // 0.5 double bits = 0x3FE0000000000000 = 4602678819172646912
                half = 4602678819172646912
                rounded = Float_Add(nval, half)
                trunc_val = Float_FromInt(Float_ToInt(rounded))
                is_neg = Float_Lt(nval, Float_FromInt(0))
                is_diff = Float_Ne(trunc_val, rounded)
                IfCondition And(EqualTo(is_neg, 1), EqualTo(is_diff, 1)) ThenBlock: {
                    trunc_val = Float_Sub(trunc_val, Float_FromInt(1))
                }
                ReturnValue(JSRT_CreateFloat(trunc_val))
            }
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }

        // Handler 8: Math.pow — a^b using float exponentiation
        IfCondition EqualTo(save_id, 7) ThenBlock: {
            IfCondition LessThan(save_argc, 2) ThenBlock: {
                ReturnValue(JSRT_CreateFloat(9221120237041090560))
            }
            arg0 = Dereference(save_args)
            JSRT__Push(save_args)
            JSRT__Push(save_argc)
            base_n = JSRT_ToNumber(arg0)
            save_argc = JSRT__Pop()
            save_args = JSRT__Pop()
            arg1_addr = Add(save_args, 8)
            arg1 = Dereference(arg1_addr)
            JSRT__Push(base_n)
            exp_n = JSRT_ToNumber(arg1)
            base_n = JSRT__Pop()

            // Use JSRT_Exp logic: delegate to it
            JSRT__Push(exp_n)
            base_val = JSRT_CreateFloat(base_n)
            exp_n = JSRT__Pop()
            exp_val = JSRT_CreateFloat(exp_n)
            ReturnValue(JSRT_Exp(base_val, exp_val))
        }

        // Handler 9: Number() — type conversion (returns double)
        IfCondition EqualTo(save_id, 8) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                nval = JSRT_ToNumber(arg0)
                ReturnValue(JSRT_CreateFloat(nval))
            }
            ReturnValue(JSRT_CreateNumber(0))
        }

        // Handler 10: String() — type conversion
        IfCondition EqualTo(save_id, 9) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                ReturnValue(JSRT_ToString(arg0))
            }
            ReturnValue(JSRT_CreateString("", 0))
        }

        // Handler 11: Boolean() — type conversion
        IfCondition EqualTo(save_id, 10) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                bval = JSRT_IsTruthy(arg0)
                ReturnValue(JSRT_CreateBool(bval))
            }
            ReturnValue(JSRT_CreateBool(0))
        }

        // Handler 12: isNaN() — check if argument is NaN (IEEE 754)
        IfCondition EqualTo(save_id, 11) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                nval = JSRT_ToNumber(arg0)
                // NaN != NaN
                is_nan = Float_Ne(nval, nval)
                ReturnValue(JSRT_CreateBool(is_nan))
            }
            ReturnValue(JSRT_CreateBool(1))
        }

        // Handler 13: isFinite() — check if argument is finite (IEEE 754)
        IfCondition EqualTo(save_id, 12) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                nval = JSRT_ToNumber(arg0)
                // Check exponent field for all 1s (NaN or Infinity)
                exp_field = BitwiseAnd(nval, 9218868437227405312)
                IfCondition EqualTo(exp_field, 9218868437227405312) ThenBlock: {
                    ReturnValue(JSRT_CreateBool(0))
                }
                ReturnValue(JSRT_CreateBool(1))
            }
            ReturnValue(JSRT_CreateBool(0))
        }

        // Handler 14: parseInt() — parse to integer, return as float
        IfCondition EqualTo(save_id, 13) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                nval = JSRT_ToNumber(arg0)
                // Truncate to integer, then back to float
                int_val = Float_ToInt(nval)
                ReturnValue(JSRT_CreateNumber(int_val))
            }
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }

        // Handler 15: parseFloat() — same as parseInt for integer engine
        IfCondition EqualTo(save_id, 14) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                nval = JSRT_ToNumber(arg0)
                ReturnValue(JSRT_CreateNumber(nval))
            }
            ReturnValue(JSRT_CreateNumber(0))
        }

        // ─── Handlers 15-21: Error constructors ───
        // Each creates an object with "message", "name", and "__class__" properties.
        // Handler 15: Error
        // Handler 16: TypeError
        // Handler 17: RangeError
        // Handler 18: ReferenceError
        // Handler 19: SyntaxError
        // Handler 20: URIError
        // Handler 21: EvalError

        // Handler 15: Error()
        IfCondition EqualTo(save_id, 15) ThenBlock: {
            err_obj = JSRT_CreateObject()
            // Set "name" = "Error"
            JSRT__Push(err_obj)
            JSRT__Push(save_args)
            JSRT__Push(save_argc)
            name_val = JSRT_CreateString("Error", 5)
            save_argc = JSRT__Pop()
            save_args = JSRT__Pop()
            err_obj = JSRT__Pop()
            JSRT_ObjSet(err_obj, "name", name_val)
            JSRT_ObjSet(err_obj, "__class__", name_val)
            // Set "message" from arg0 or ""
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                JSRT__Push(err_obj)
                msg_val = JSRT_ToString(arg0)
                err_obj = JSRT__Pop()
                JSRT_ObjSet(err_obj, "message", msg_val)
            } ElseBlock: {
                JSRT__Push(err_obj)
                empty_msg = JSRT_CreateString("", 0)
                err_obj = JSRT__Pop()
                JSRT_ObjSet(err_obj, "message", empty_msg)
            }
            ReturnValue(err_obj)
        }

        // Handler 16: TypeError()
        IfCondition EqualTo(save_id, 16) ThenBlock: {
            err_obj = JSRT_CreateObject()
            JSRT__Push(err_obj)
            JSRT__Push(save_args)
            JSRT__Push(save_argc)
            name_val = JSRT_CreateString("TypeError", 9)
            save_argc = JSRT__Pop()
            save_args = JSRT__Pop()
            err_obj = JSRT__Pop()
            JSRT_ObjSet(err_obj, "name", name_val)
            JSRT_ObjSet(err_obj, "__class__", name_val)
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                JSRT__Push(err_obj)
                msg_val = JSRT_ToString(arg0)
                err_obj = JSRT__Pop()
                JSRT_ObjSet(err_obj, "message", msg_val)
            } ElseBlock: {
                JSRT__Push(err_obj)
                empty_msg = JSRT_CreateString("", 0)
                err_obj = JSRT__Pop()
                JSRT_ObjSet(err_obj, "message", empty_msg)
            }
            ReturnValue(err_obj)
        }

        // Handler 17: RangeError()
        IfCondition EqualTo(save_id, 17) ThenBlock: {
            err_obj = JSRT_CreateObject()
            JSRT__Push(err_obj)
            JSRT__Push(save_args)
            JSRT__Push(save_argc)
            name_val = JSRT_CreateString("RangeError", 10)
            save_argc = JSRT__Pop()
            save_args = JSRT__Pop()
            err_obj = JSRT__Pop()
            JSRT_ObjSet(err_obj, "name", name_val)
            JSRT_ObjSet(err_obj, "__class__", name_val)
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                JSRT__Push(err_obj)
                msg_val = JSRT_ToString(arg0)
                err_obj = JSRT__Pop()
                JSRT_ObjSet(err_obj, "message", msg_val)
            } ElseBlock: {
                JSRT__Push(err_obj)
                empty_msg = JSRT_CreateString("", 0)
                err_obj = JSRT__Pop()
                JSRT_ObjSet(err_obj, "message", empty_msg)
            }
            ReturnValue(err_obj)
        }

        // Handler 18: ReferenceError()
        IfCondition EqualTo(save_id, 18) ThenBlock: {
            err_obj = JSRT_CreateObject()
            JSRT__Push(err_obj)
            JSRT__Push(save_args)
            JSRT__Push(save_argc)
            name_val = JSRT_CreateString("ReferenceError", 14)
            save_argc = JSRT__Pop()
            save_args = JSRT__Pop()
            err_obj = JSRT__Pop()
            JSRT_ObjSet(err_obj, "name", name_val)
            JSRT_ObjSet(err_obj, "__class__", name_val)
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                JSRT__Push(err_obj)
                msg_val = JSRT_ToString(arg0)
                err_obj = JSRT__Pop()
                JSRT_ObjSet(err_obj, "message", msg_val)
            } ElseBlock: {
                JSRT__Push(err_obj)
                empty_msg = JSRT_CreateString("", 0)
                err_obj = JSRT__Pop()
                JSRT_ObjSet(err_obj, "message", empty_msg)
            }
            ReturnValue(err_obj)
        }

        // Handler 19: SyntaxError()
        IfCondition EqualTo(save_id, 19) ThenBlock: {
            err_obj = JSRT_CreateObject()
            JSRT__Push(err_obj)
            JSRT__Push(save_args)
            JSRT__Push(save_argc)
            name_val = JSRT_CreateString("SyntaxError", 11)
            save_argc = JSRT__Pop()
            save_args = JSRT__Pop()
            err_obj = JSRT__Pop()
            JSRT_ObjSet(err_obj, "name", name_val)
            JSRT_ObjSet(err_obj, "__class__", name_val)
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                JSRT__Push(err_obj)
                msg_val = JSRT_ToString(arg0)
                err_obj = JSRT__Pop()
                JSRT_ObjSet(err_obj, "message", msg_val)
            } ElseBlock: {
                JSRT__Push(err_obj)
                empty_msg = JSRT_CreateString("", 0)
                err_obj = JSRT__Pop()
                JSRT_ObjSet(err_obj, "message", empty_msg)
            }
            ReturnValue(err_obj)
        }

        // Handler 20: URIError()
        IfCondition EqualTo(save_id, 20) ThenBlock: {
            err_obj = JSRT_CreateObject()
            JSRT__Push(err_obj)
            JSRT__Push(save_args)
            JSRT__Push(save_argc)
            name_val = JSRT_CreateString("URIError", 8)
            save_argc = JSRT__Pop()
            save_args = JSRT__Pop()
            err_obj = JSRT__Pop()
            JSRT_ObjSet(err_obj, "name", name_val)
            JSRT_ObjSet(err_obj, "__class__", name_val)
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                JSRT__Push(err_obj)
                msg_val = JSRT_ToString(arg0)
                err_obj = JSRT__Pop()
                JSRT_ObjSet(err_obj, "message", msg_val)
            } ElseBlock: {
                JSRT__Push(err_obj)
                empty_msg = JSRT_CreateString("", 0)
                err_obj = JSRT__Pop()
                JSRT_ObjSet(err_obj, "message", empty_msg)
            }
            ReturnValue(err_obj)
        }

        // Handler 21: EvalError()
        IfCondition EqualTo(save_id, 21) ThenBlock: {
            err_obj = JSRT_CreateObject()
            JSRT__Push(err_obj)
            JSRT__Push(save_args)
            JSRT__Push(save_argc)
            name_val = JSRT_CreateString("EvalError", 9)
            save_argc = JSRT__Pop()
            save_args = JSRT__Pop()
            err_obj = JSRT__Pop()
            JSRT_ObjSet(err_obj, "name", name_val)
            JSRT_ObjSet(err_obj, "__class__", name_val)
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                JSRT__Push(err_obj)
                msg_val = JSRT_ToString(arg0)
                err_obj = JSRT__Pop()
                JSRT_ObjSet(err_obj, "message", msg_val)
            } ElseBlock: {
                JSRT__Push(err_obj)
                empty_msg = JSRT_CreateString("", 0)
                err_obj = JSRT__Pop()
                JSRT_ObjSet(err_obj, "message", empty_msg)
            }
            ReturnValue(err_obj)
        }

        // Unknown handler — return undefined
        ReturnValue(JSRTState.undef_val)
    }
}

// =============================================================================
// BUILT-IN REGISTRATION — register console and Math natives
// Called once during JSRT_Init or by the VM bootstrap.
// =============================================================================
Function.JSRT_RegisterBuiltins {
    Output: Integer
    Body: {
        JSRT_RegisterNative("console.log", 0)
        JSRT_RegisterNative("Math.abs", 1)
        JSRT_RegisterNative("Math.max", 2)
        JSRT_RegisterNative("Math.min", 3)
        JSRT_RegisterNative("Math.floor", 4)
        JSRT_RegisterNative("Math.ceil", 5)
        JSRT_RegisterNative("Math.round", 6)
        JSRT_RegisterNative("Math.pow", 7)
        JSRT_RegisterNative("Number", 8)
        JSRT_RegisterNative("String", 9)
        JSRT_RegisterNative("Boolean", 10)
        JSRT_RegisterNative("isNaN", 11)
        JSRT_RegisterNative("isFinite", 12)
        JSRT_RegisterNative("parseInt", 13)
        JSRT_RegisterNative("parseFloat", 14)
        JSRT_RegisterNative("Error", 15)
        JSRT_RegisterNative("TypeError", 16)
        JSRT_RegisterNative("RangeError", 17)
        JSRT_RegisterNative("ReferenceError", 18)
        JSRT_RegisterNative("SyntaxError", 19)
        JSRT_RegisterNative("URIError", 20)
        JSRT_RegisterNative("EvalError", 21)
        ReturnValue(22)
    }
}

// =============================================================================
// BUILT-IN OBJECT CREATION — console and Math objects
// Creates JSValue OBJECTs with native function stubs as properties.
// =============================================================================

// Create the global "console" object with a "log" method stub.
// Returns OBJECT JSValue.
Function.JSRT_CreateConsole {
    Output: Address
    Body: {
        console_obj = JSRT_CreateObject()
        JSRT__Push(console_obj)
        log_func = JSRT_CreateFunc(-1, 0, 0, "console.log")
        console_obj = JSRT__Pop()
        JSRT_ObjSet(console_obj, "log", log_func)
        ReturnValue(console_obj)
    }
}

// Create the global "Math" object with method stubs.
// Returns OBJECT JSValue.
Function.JSRT_CreateMath {
    Output: Address
    Body: {
        math_obj = JSRT_CreateObject()
        JSRT__Push(math_obj)
        abs_func = JSRT_CreateFunc(-2, 1, 0, "Math.abs")
        math_obj = JSRT__Pop()
        JSRT_ObjSet(math_obj, "abs", abs_func)

        JSRT__Push(math_obj)
        max_func = JSRT_CreateFunc(-3, 2, 0, "Math.max")
        math_obj = JSRT__Pop()
        JSRT_ObjSet(math_obj, "max", max_func)

        JSRT__Push(math_obj)
        min_func = JSRT_CreateFunc(-4, 2, 0, "Math.min")
        math_obj = JSRT__Pop()
        JSRT_ObjSet(math_obj, "min", min_func)

        JSRT__Push(math_obj)
        floor_func = JSRT_CreateFunc(-5, 1, 0, "Math.floor")
        math_obj = JSRT__Pop()
        JSRT_ObjSet(math_obj, "floor", floor_func)

        JSRT_CreateMathExtra(math_obj)
        ReturnValue(math_obj)
    }
}

// Install Math.ceil, Math.round, Math.pow on the Math object.
// Split from JSRT_CreateMath to avoid local variable overflow.
Function.JSRT_CreateMathExtra {
    Input: math_obj: Address
    Output: Integer
    Body: {
        save_obj = math_obj

        JSRT__Push(save_obj)
        fn = JSRT_CreateFunc(-6, 1, 0, "Math.ceil")
        save_obj = JSRT__Pop()
        JSRT_ObjSet(save_obj, "ceil", fn)

        JSRT__Push(save_obj)
        fn = JSRT_CreateFunc(-7, 1, 0, "Math.round")
        save_obj = JSRT__Pop()
        JSRT_ObjSet(save_obj, "round", fn)

        JSRT__Push(save_obj)
        fn = JSRT_CreateFunc(-8, 2, 0, "Math.pow")
        save_obj = JSRT__Pop()
        JSRT_ObjSet(save_obj, "pow", fn)

        ReturnValue(1)
    }
}

// =============================================================================
// TIMER QUEUE
// Each entry: { id(8), callback_val(8), delay_ms(8), is_interval(8) } = 32 bytes
// =============================================================================

// Add a timer to the queue. Returns timer ID.
// callback = JSValue pointer to a FUNCTION
// delay = milliseconds
// is_interval = 1 for setInterval, 0 for setTimeout
Function.JSRT_TimerAdd {
    Input: callback: Address
    Input: delay: Integer
    Input: is_interval: Integer
    Output: Integer
    Body: {
        save_cb = callback
        save_delay = delay
        save_interval = is_interval
        IfCondition GreaterEqual(JSRTState.timer_count, JSRTConst.MAX_TIMERS) ThenBlock: {
            ReturnValue(-1)
        }
        idx = JSRTState.timer_count
        JSRTState.timer_count = Add(idx, 1)
        timer_id = JSRTState.next_timer_id
        JSRTState.next_timer_id = Add(timer_id, 1)

        base = Add(JSRTState.timer_pool, Multiply(idx, JSRTConst.TIMER_SIZE))
        // id
        StoreValue(base, timer_id)
        // callback_val (JSValue pointer)
        StoreValue(Add(base, 8), save_cb)
        // delay_ms
        StoreValue(Add(base, 16), save_delay)
        // is_interval
        StoreValue(Add(base, 24), save_interval)

        ReturnValue(timer_id)
    }
}

// Remove a timer by ID. Returns 1 if found and removed, 0 if not found.
Function.JSRT_TimerRemove {
    Input: timer_id: Integer
    Output: Integer
    Body: {
        save_id = timer_id
        JSRTTmp.idx = 0
        WhileLoop LessThan(JSRTTmp.idx, JSRTState.timer_count) {
            base = Add(JSRTState.timer_pool, Multiply(JSRTTmp.idx, JSRTConst.TIMER_SIZE))
            entry_id = Dereference(base)
            IfCondition EqualTo(entry_id, save_id) ThenBlock: {
                // Found — compact by shifting remaining entries
                last_idx = Subtract(JSRTState.timer_count, 1)
                IfCondition LessThan(JSRTTmp.idx, last_idx) ThenBlock: {
                    // Copy last entry over this one
                    last_base = Add(JSRTState.timer_pool, Multiply(last_idx, JSRTConst.TIMER_SIZE))
                    MemoryCopy(base, last_base, JSRTConst.TIMER_SIZE)
                }
                JSRTState.timer_count = Subtract(JSRTState.timer_count, 1)
                ReturnValue(1)
            }
            JSRTTmp.idx = Add(JSRTTmp.idx, 1)
        }
        ReturnValue(0)
    }
}

// Tick the timer queue. current_ms is the current timestamp in milliseconds.
// Returns count of expired timers. Actual callback invocation is done by the VM.
// For now this is a stub that just returns the count of timers that would fire.
// The VM should call this once per frame and handle the callbacks.
Function.JSRT_TimerTick {
    Input: current_ms: Integer
    Output: Integer
    Body: {
        save_ms = current_ms
        expired = 0
        JSRTTmp.idx = 0
        WhileLoop LessThan(JSRTTmp.idx, JSRTState.timer_count) {
            base = Add(JSRTState.timer_pool, Multiply(JSRTTmp.idx, JSRTConst.TIMER_SIZE))
            delay = Dereference(Add(base, 16))
            // Simple stub: count any timer whose delay <= current_ms
            IfCondition LessEqual(delay, save_ms) ThenBlock: {
                expired = Add(expired, 1)
            }
            JSRTTmp.idx = Add(JSRTTmp.idx, 1)
        }
        ReturnValue(expired)
    }
}

// Get timer callback by index (for VM to invoke).
// Returns JSValue pointer to the FUNCTION, or 0.
Function.JSRT_TimerGetCB {
    Input: idx: Integer
    Output: Address
    Body: {
        save_idx = idx
        IfCondition GreaterEqual(save_idx, JSRTState.timer_count) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        base = Add(JSRTState.timer_pool, Multiply(save_idx, JSRTConst.TIMER_SIZE))
        ReturnValue(Dereference(Add(base, 8)))
    }
}

// Get timer count.
Function.JSRT_TimerCount {
    Output: Integer
    Body: {
        ReturnValue(JSRTState.timer_count)
    }
}

// Get timer is_interval flag by index.
Function.JSRT_TimerIsInterval {
    Input: idx: Integer
    Output: Integer
    Body: {
        save_idx = idx
        IfCondition GreaterEqual(save_idx, JSRTState.timer_count) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        base = Add(JSRTState.timer_pool, Multiply(save_idx, JSRTConst.TIMER_SIZE))
        ReturnValue(Dereference(Add(base, 24)))
    }
}

// Get timer ID by index.
Function.JSRT_TimerGetId {
    Input: idx: Integer
    Output: Integer
    Body: {
        save_idx = idx
        IfCondition GreaterEqual(save_idx, JSRTState.timer_count) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(-1)
        }
        base = Add(JSRTState.timer_pool, Multiply(save_idx, JSRTConst.TIMER_SIZE))
        ReturnValue(Dereference(base))
    }
}

// =============================================================================
// SINGLETON ACCESSORS
// =============================================================================
Function.JSRT_Undefined {
    Output: Address
    Body: {
        ReturnValue(JSRTState.undef_val)
    }
}

Function.JSRT_Null {
    Output: Address
    Body: {
        ReturnValue(JSRTState.null_val)
    }
}

Function.JSRT_True {
    Output: Address
    Body: {
        ReturnValue(JSRTState.true_val)
    }
}

Function.JSRT_False {
    Output: Address
    Body: {
        ReturnValue(JSRTState.false_val)
    }
}

// =============================================================================
// VALUE POOL INFO
// =============================================================================
Function.JSRT_GetValCount {
    Output: Integer
    Body: {
        ReturnValue(JSRTState.val_count)
    }
}

Function.JSRT_GetValPool {
    Output: Address
    Body: {
        ReturnValue(JSRTState.val_pool)
    }
}

// =============================================================================
// RESET — clear runtime state for re-use (keeps allocations)
// =============================================================================
Function.JSRT_Reset {
    Output: Integer
    Body: {
        pool_sz = Multiply(JSRTConst.MAX_VALUES, JSRTConst.VAL_SIZE)
        MemorySet(JSRTState.val_pool, 0, pool_sz)
        JSRTState.val_count = 0

        nat_sz = Multiply(JSRTConst.MAX_NATIVES, JSRTConst.NATIVE_SIZE)
        MemorySet(JSRTState.native_table, 0, nat_sz)
        JSRTState.native_count = 0

        tim_sz = Multiply(JSRTConst.MAX_TIMERS, JSRTConst.TIMER_SIZE)
        MemorySet(JSRTState.timer_pool, 0, tim_sz)
        JSRTState.timer_count = 0
        JSRTState.next_timer_id = 1

        JSRTState.str_pos = 0
        JSRTState.str_slab_pos = 0
        JSRTState.func_slab_pos = 0
        JSRTState.oom = 0
        JSRTStack.sp = 0

        // Reset property tables — MUST zero the slab when rewinding next_slot.
        // Otherwise CreateObject reuses slot 0..N and MemorySet wipes tables still
        // referenced by live objects (e.g. document after EvalString reset), so
        // document.getElementById becomes undefined and DOM SET_PROP never sees
        // __dom_idx.
        GlobalHash_Reset()
        IfCondition NotEqual(PropState.slab, 0) ThenBlock: {
            slab_sz = Multiply(PropConst.MAX_TABLES, PropConst.TABLE_SIZE)
            MemorySet(PropState.slab, 0, slab_sz)
        }
        PropState.next_slot = 0
        IfCondition NotEqual(PropState.arr_side, 0) ThenBlock: {
            as_sz = Multiply(PropConst.ARR_SIDE_MAX, PropConst.ARR_SIDE_ENTRY)
            MemorySet(PropState.arr_side, 0, as_sz)
            PropState.arr_side_count = 0
        }

        // Re-create singletons
        uv = JSRT__AllocValue()
        StoreValue(uv, JSType.UNDEFINED)
        StoreValue(Add(uv, 8), 0)
        JSRTState.undef_val = uv

        nv = JSRT__AllocValue()
        StoreValue(nv, JSType.NULL)
        StoreValue(Add(nv, 8), 0)
        JSRTState.null_val = nv

        tv = JSRT__AllocValue()
        StoreValue(tv, JSType.BOOLEAN)
        StoreValue(Add(tv, 8), 1)
        JSRTState.true_val = tv

        fv = JSRT__AllocValue()
        StoreValue(fv, JSType.BOOLEAN)
        StoreValue(Add(fv, 8), 0)
        JSRTState.false_val = fv

        // Re-create cached ToString constants (wiped by val_pool + str_slab reset)
        JSRTState.str_undefined = JSRT_CreateString("undefined")
        JSRTState.str_null = JSRT_CreateString("null")
        JSRTState.str_true = JSRT_CreateString("true")
        JSRTState.str_false = JSRT_CreateString("false")
        JSRTState.str_objobj = JSRT_CreateString("[object Object]")
        JSRTState.str_function = JSRT_CreateString("[function]")

        // Re-create cached typeof strings
        JSRTState.str_typeof_undefined = JSRT_CreateString("undefined")
        JSRTState.str_typeof_object = JSRT_CreateString("object")
        JSRTState.str_typeof_boolean = JSRT_CreateString("boolean")
        JSRTState.str_typeof_number = JSRT_CreateString("number")
        JSRTState.str_typeof_string = JSRT_CreateString("string")
        JSRTState.str_typeof_function = JSRT_CreateString("function")

        ReturnValue(1)
    }
}

// =============================================================================
// GENERATOR STATE BLOCK
// Layout (128 bytes):
//   Offset 0:  state (0=suspended-start, 1=suspended-yield, 2=executing, 3=completed)
//   Offset 8:  func_bc (bytecode offset)
//   Offset 16: func_params
//   Offset 24: func_locals
//   Offset 32: saved_pc (for resume)
//   Offset 40: saved_sp (stack pointer within gen's private stack)
//   Offset 48: saved_fp (frame pointer)
//   Offset 56: stack_copy (pointer to private stack buffer)
//   Offset 64: stack_size (capacity in slots)
//   Offset 72: args_buf (pointer to argument values)
//   Offset 80: argc
//   Offset 88: frames_copy (pointer to saved call frames)
//   Offset 96: frames_size (number of frames)
//   Offset 104: async_gen flag
//   Offset 112: this_cap
//   Offset 120: source func_val (Mole 17: SetupCallEnv / arguments.callee)
//   Offset 128/136/144: envs/funcs/fargs side tables
// =============================================================================

FixedPool.JSGenConst {
    "STATE_SZ":      Initialize=152
    "GEN_STACK_MAX": Initialize=512
    "GEN_FRAMES_MAX": Initialize=32
    "ST_SUSPENDED_START": Initialize=0
    "ST_SUSPENDED_YIELD": Initialize=1
    "ST_EXECUTING":       Initialize=2
    "ST_COMPLETED":       Initialize=3
    // Params bound at call (FDI); first .next() resumes without yield-arg push
    "ST_SUSPENDED_INIT":  Initialize=4
}

// Generator slab state — bump allocator for generator state/stack/frames
FixedPool.JSGenSlab {
    "buf":    Initialize=0
    "pos":    Initialize=0
    "cap":    Initialize=2097152
}

// Initialize generator slab (called from JSRT_Init)
Function.JSRT__GenSlabInit {
    Output: Integer
    Body: {
        JSGenSlab.buf = Allocate(JSGenSlab.cap)
        MemorySet(JSGenSlab.buf, 0, JSGenSlab.cap)
        JSGenSlab.pos = 0
        ReturnValue(1)
    }
}

// Bump-allocate sz bytes from generator slab. Wraps at capacity.
Function.JSRT__GenSlabAlloc {
    Input: sz: Integer
    Output: Address
    Body: {
        save_sz = sz
        pos = JSGenSlab.pos
        addr = Add(JSGenSlab.buf, pos)
        new_pos = Add(pos, save_sz)
        IfCondition GreaterEqual(new_pos, JSGenSlab.cap) ThenBlock: {
            addr = JSGenSlab.buf
            new_pos = save_sz
        }
        JSGenSlab.pos = new_pos
        ReturnValue(addr)
    }
}

// Create a GENERATOR JSValue.
// func_val = the generator function value, args_buf = pointer to arg array, argc = count
// Returns a GENERATOR-typed JSValue whose payload is the state block pointer.
// Uses gen_slab bump allocator — no per-call Allocate.
Function.JSRT_CreateGenerator {
    Input: func_val: Address
    Input: args_buf: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_fv = func_val
        save_ab = args_buf
        save_ac = argc

        // Bump-allocate state block from gen slab
        gs = JSRT__GenSlabAlloc(JSGenConst.STATE_SZ)
        MemorySet(gs, 0, JSGenConst.STATE_SZ)

        // state = suspended-start
        StoreValue(gs, JSGenConst.ST_SUSPENDED_START)

        // Copy function descriptor fields
        f_bc = JSRT_FuncGetBC(save_fv)
        f_params = JSRT_FuncGetParams(save_fv)
        f_locals = JSRT_FuncGetLocals(save_fv)
        StoreValue(Add(gs, 8), f_bc)
        StoreValue(Add(gs, 16), f_params)
        StoreValue(Add(gs, 24), f_locals)

        // saved_pc starts at func bytecode offset
        StoreValue(Add(gs, 32), f_bc)

        // Bump-allocate private stack from gen slab (512 slots * 8 bytes)
        stk_sz = Multiply(JSGenConst.GEN_STACK_MAX, 8)
        stk_buf = JSRT__GenSlabAlloc(stk_sz)
        MemorySet(stk_buf, 0, stk_sz)
        StoreValue(Add(gs, 56), stk_buf)
        StoreValue(Add(gs, 64), JSGenConst.GEN_STACK_MAX)

        // saved_sp = 0 (empty private stack)
        StoreValue(Add(gs, 40), 0)
        // saved_fp = 0
        StoreValue(Add(gs, 48), 0)

        // Copy arguments into gen slab
        IfCondition GreaterThan(save_ac, 0) ThenBlock: {
            ab_sz = Multiply(save_ac, 8)
            ab_copy = JSRT__GenSlabAlloc(ab_sz)
            MemoryCopy(ab_copy, save_ab, ab_sz)
            StoreValue(Add(gs, 72), ab_copy)
        }
        StoreValue(Add(gs, 80), save_ac)

        // Mole 15: capture this at creation (custom @@iterator needs array as this)
        this_cap = JSVM__GetGlobal("this")
        StoreValue(Add(gs, 112), this_cap)
        // Mole 17: keep source function for first-resume CALL-like setup
        StoreValue(Add(gs, 120), save_fv)

        // Bump-allocate private frames from gen slab (32 frames * FRAME_SIZE)
        frm_sz = Multiply(JSGenConst.GEN_FRAMES_MAX, JSVMConst.FRAME_SIZE)
        frm_buf = JSRT__GenSlabAlloc(frm_sz)
        MemorySet(frm_buf, 0, frm_sz)
        StoreValue(Add(gs, 88), frm_buf)
        StoreValue(Add(gs, 96), 0)

        // Mole 17: side tables parallel to frames (env/func/args)
        side_sz = Multiply(JSGenConst.GEN_FRAMES_MAX, 8)
        envs_buf = JSRT__GenSlabAlloc(side_sz)
        MemorySet(envs_buf, 0, side_sz)
        StoreValue(Add(gs, 128), envs_buf)
        funcs_buf = JSRT__GenSlabAlloc(side_sz)
        MemorySet(funcs_buf, 0, side_sz)
        StoreValue(Add(gs, 136), funcs_buf)
        fargs_buf = JSRT__GenSlabAlloc(side_sz)
        MemorySet(fargs_buf, 0, side_sz)
        StoreValue(Add(gs, 144), fargs_buf)

        // Create the GENERATOR JSValue
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.GENERATOR)
        StoreValue(Add(val, 8), gs)

        ReturnValue(val)
    }
}

// Create an iterator result object: { value: val, done: d }
Function.JSRT_CreateIterResult {
    Input: val: Address
    Input: done: Integer
    Output: Address
    Body: {
        save_val = val
        save_done = done
        obj = JSRT_CreateObject()
        JSRT_ObjSet(obj, "value", save_val)
        IfCondition EqualTo(save_done, 0) ThenBlock: {
            JSRT_ObjSet(obj, "done", JSRT_False())
        } ElseBlock: {
            JSRT_ObjSet(obj, "done", JSRT_True())
        }
        ReturnValue(obj)
    }
}
