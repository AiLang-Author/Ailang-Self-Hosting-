// Library.PropTable.ailang — FixedPool property tables replacing XSHash
// Object properties: 264-byte linear-scan tables from ring buffer slab
// Global variables: 8KB open-addressed hash with linear probing
// No Arena. No linked lists. No dynamic allocation.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.PropConst {
    "ENTRY_SIZE":      Initialize=16
    // Was 32 → 64 → 128. Global this plus __a_ attr keys fills 128
    // under the test262 polyfill, so this.p1 = 1 was dropped.
    // 256 covers builtins, attr keys, and script vars on the global object.
    "MAX_ENTRIES":     Initialize=256
    // 8-byte count header + 256 * 16-byte entries = 4104
    "TABLE_SIZE":      Initialize=4104
    "MAX_TABLES":      Initialize=65536
    "TOMBSTONE":       Initialize=-2
    "GLOBAL_SLOTS":    Initialize=2048
    "GLOBAL_SIZE":     Initialize=32768
    "ARR_SIDE_MAX":    Initialize=2048
    "ARR_SIDE_ENTRY":  Initialize=16
}

// =============================================================================
// STATE
// =============================================================================
FixedPool.PropState {
    "slab":          Initialize=0
    "next_slot":     Initialize=0
    "global_hash":   Initialize=0
    "arr_side":      Initialize=0
    "arr_side_count": Initialize=0
    // Recycled tables (JSRT_GcTick). 0 = none. Next link stored at table+8.
    "free_head":     Initialize=0
    // 256 slots × (key, table, entry). Repeated lookups skip the linear scan.
    "cache":         Initialize=0
    "cache_hold":    Initialize=0
}

// =============================================================================
// TEMPORARIES
// =============================================================================
FixedPool.PropTmp {
    "idx":       Initialize=0
    "key":       Initialize=0
    "val":       Initialize=0
    "slot":      Initialize=0
    "addr":      Initialize=0
    "count":     Initialize=0
    "ekey":      Initialize=0
    // KeyEq only. Do not reuse idx/addr/ekey — callers hold those across KeyEq.
    "eq_cs":     Initialize=0
    "eq_js":     Initialize=0
    "eq_ia":     Initialize=0
    "eq_ja":     Initialize=0
    "eq_jn":     Initialize=0
    "eq_cu":     Initialize=0
    "eq_ju":     Initialize=0
    "eq_n":      Initialize=0
    "eq_pend":   Initialize=0
    "eq_gotc":   Initialize=0
    "eq_gotj":   Initialize=0
    "eq_go":     Initialize=0
}

// =============================================================================
// INIT — allocate slab + global hash at startup
// =============================================================================
Function.PropTable_Init {
    Output: Integer
    Body: {
        // Object property slab: 32768 x 264 = 8,650,752 bytes
        slab_sz = Multiply(PropConst.MAX_TABLES, PropConst.TABLE_SIZE)
        PropState.slab = Allocate(slab_sz)
        MemorySet(PropState.slab, 0, slab_sz)
        PropState.next_slot = 0

        // Global hash: 2048 x 16 = 32768 bytes
        PropState.global_hash = Allocate(PropConst.GLOBAL_SIZE)
        MemorySet(PropState.global_hash, 0, PropConst.GLOBAL_SIZE)

        // Array named-property side table: 2048 x 16 = 32768 bytes
        // Each entry: [array_jsval_ptr(8) | proptable_ptr(8)]
        arr_side_sz = Multiply(PropConst.ARR_SIDE_MAX, PropConst.ARR_SIDE_ENTRY)
        PropState.arr_side = Allocate(arr_side_sz)
        MemorySet(PropState.arr_side, 0, arr_side_sz)
        PropState.arr_side_count = 0

        // 256 × 24 bytes. Zero means empty.
        PropState.cache = Allocate(6144)
        IfCondition NotEqual(PropState.cache, 0) ThenBlock: {
            MemorySet(PropState.cache, 0, 6144)
        }

        ReturnValue(1)
    }
}

// =============================================================================
// OBJECT PROPERTY TABLE — ring buffer allocation
// =============================================================================

// Allocate a 520-byte property table for an object.
// Returns address to the table (zeroed), or 0 on exhaustion.
Function.PropTable_Alloc {
    Output: Address
    Body: {
        IfCondition NotEqual(PropState.free_head, 0) ThenBlock: {
            PropTmp.addr = PropState.free_head
            PropState.free_head = Dereference(Add(PropTmp.addr, 8))
            MemorySet(PropTmp.addr, 0, PropConst.TABLE_SIZE)
            ReturnValue(PropTmp.addr)
        }
        idx = PropState.next_slot
        IfCondition GreaterEqual(idx, PropConst.MAX_TABLES) ThenBlock: {
            ReturnValue(0)
        }
        addr = Add(PropState.slab, Multiply(idx, PropConst.TABLE_SIZE))
        MemorySet(addr, 0, PropConst.TABLE_SIZE)
        PropState.next_slot = Add(idx, 1)
        ReturnValue(addr)
    }
}

// One UTF-8 code unit from a C property key, same rules as CreateStringUTF8Len.
// 1 = produced a unit in eq_cu and a byte width in eq_n. 0 = NUL.
Function.PropTable__CUnit {
    Input: p: Address
    Input: i: Integer
    Output: Integer
    Body: {
        save_p = p
        save_i = i
        IfCondition NotEqual(PropTmp.eq_pend, 0) ThenBlock: {
            PropTmp.eq_cu = PropTmp.eq_pend
            PropTmp.eq_pend = 0
            PropTmp.eq_n = 0
            ReturnValue(1)
        }
        b0 = GetByte(save_p, save_i)
        IfCondition LessThan(b0, 0) ThenBlock: { b0 = Add(b0, 256) }
        IfCondition EqualTo(b0, 0) ThenBlock: {
            PropTmp.eq_n = 0
            ReturnValue(0)
        }
        IfCondition LessThan(b0, 128) ThenBlock: {
            PropTmp.eq_cu = b0
            PropTmp.eq_n = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(BitwiseAnd(b0, 224), 192) ThenBlock: {
            b1 = GetByte(save_p, Add(save_i, 1))
            IfCondition LessThan(b1, 0) ThenBlock: { b1 = Add(b1, 256) }
            IfCondition EqualTo(BitwiseAnd(b1, 192), 128) ThenBlock: {
                cp = Add(ShiftLeft(BitwiseAnd(b0, 31), 6), BitwiseAnd(b1, 63))
                IfCondition GreaterEqual(cp, 128) ThenBlock: {
                    PropTmp.eq_cu = cp
                    PropTmp.eq_n = 2
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(BitwiseAnd(b0, 240), 224) ThenBlock: {
            b1 = GetByte(save_p, Add(save_i, 1))
            IfCondition LessThan(b1, 0) ThenBlock: { b1 = Add(b1, 256) }
            b2 = GetByte(save_p, Add(save_i, 2))
            IfCondition LessThan(b2, 0) ThenBlock: { b2 = Add(b2, 256) }
            IfCondition And(EqualTo(BitwiseAnd(b1, 192), 128), EqualTo(BitwiseAnd(b2, 192), 128)) ThenBlock: {
                cp = Add(Add(ShiftLeft(BitwiseAnd(b0, 15), 12), ShiftLeft(BitwiseAnd(b1, 63), 6)), BitwiseAnd(b2, 63))
                IfCondition GreaterEqual(cp, 2048) ThenBlock: {
                    PropTmp.eq_cu = cp
                    PropTmp.eq_n = 3
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(BitwiseAnd(b0, 248), 240) ThenBlock: {
            b1 = GetByte(save_p, Add(save_i, 1))
            IfCondition LessThan(b1, 0) ThenBlock: { b1 = Add(b1, 256) }
            b2 = GetByte(save_p, Add(save_i, 2))
            IfCondition LessThan(b2, 0) ThenBlock: { b2 = Add(b2, 256) }
            b3 = GetByte(save_p, Add(save_i, 3))
            IfCondition LessThan(b3, 0) ThenBlock: { b3 = Add(b3, 256) }
            IfCondition And(And(EqualTo(BitwiseAnd(b1, 192), 128), EqualTo(BitwiseAnd(b2, 192), 128)), EqualTo(BitwiseAnd(b3, 192), 128)) ThenBlock: {
                cp = Add(Add(Add(ShiftLeft(BitwiseAnd(b0, 7), 18), ShiftLeft(BitwiseAnd(b1, 63), 12)), ShiftLeft(BitwiseAnd(b2, 63), 6)), BitwiseAnd(b3, 63))
                IfCondition And(GreaterEqual(cp, 65536), LessThan(cp, 1114112)) ThenBlock: {
                    adj = Subtract(cp, 65536)
                    PropTmp.eq_cu = Add(55296, ShiftRight(adj, 10))
                    PropTmp.eq_pend = Add(56320, BitwiseAnd(adj, 1023))
                    PropTmp.eq_n = 4
                    ReturnValue(1)
                }
            }
        }
        PropTmp.eq_cu = b0
        PropTmp.eq_n = 1
        ReturnValue(1)
    }
}

// C property keys are UTF-8. Runtime lookups pass UTF-16 JS strings.
// StrEq compares bytes to code units, so U+FFFD does not match its UTF-8 bytes.
Function.PropTable__KeyEq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, save_b) ThenBlock: { ReturnValue(1) }
        IfCondition Or(EqualTo(save_a, 0), EqualTo(save_b, 0)) ThenBlock: { ReturnValue(0) }
        PropTmp.eq_cs = save_a
        PropTmp.eq_js = save_b
        IfCondition EqualTo(JSRT_StrEq(PropTmp.eq_cs, PropTmp.eq_js), 1) ThenBlock: {
            ReturnValue(1)
        }
        aj = JSRT_StrIsJS(PropTmp.eq_cs)
        bj = JSRT_StrIsJS(PropTmp.eq_js)
        IfCondition EqualTo(aj, bj) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(aj, 1) ThenBlock: {
            swap = PropTmp.eq_cs
            PropTmp.eq_cs = PropTmp.eq_js
            PropTmp.eq_js = swap
        }
        // ASCII C keys already failed StrEq. Only multi-byte UTF-8 can still match.
        bi = 0
        hi = 0
        WhileLoop EqualTo(hi, 0) {
            b0 = GetByte(PropTmp.eq_cs, bi)
            IfCondition LessThan(b0, 0) ThenBlock: { b0 = Add(b0, 256) }
            IfCondition EqualTo(b0, 0) ThenBlock: { hi = 2 }
            IfCondition GreaterEqual(b0, 128) ThenBlock: { hi = 1 }
            bi = Add(bi, 1)
        }
        IfCondition NotEqual(hi, 1) ThenBlock: { ReturnValue(0) }
        PropTmp.eq_pend = 0
        PropTmp.eq_ia = 0
        PropTmp.eq_ja = 0
        PropTmp.eq_jn = JSRT_StrLen(PropTmp.eq_js)
        PropTmp.eq_go = 1
        WhileLoop EqualTo(PropTmp.eq_go, 1) {
            PropTmp.eq_gotc = PropTable__CUnit(PropTmp.eq_cs, PropTmp.eq_ia)
            PropTmp.eq_ia = Add(PropTmp.eq_ia, PropTmp.eq_n)
            PropTmp.eq_gotj = 0
            IfCondition LessThan(PropTmp.eq_ja, PropTmp.eq_jn) ThenBlock: {
                PropTmp.eq_ju = JSRT_StrUnit(PropTmp.eq_js, PropTmp.eq_ja)
                PropTmp.eq_ja = Add(PropTmp.eq_ja, 1)
                PropTmp.eq_gotj = 1
            }
            IfCondition And(EqualTo(PropTmp.eq_gotc, 0), EqualTo(PropTmp.eq_gotj, 0)) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition Or(EqualTo(PropTmp.eq_gotc, 0), EqualTo(PropTmp.eq_gotj, 0)) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition NotEqual(PropTmp.eq_cu, PropTmp.eq_ju) ThenBlock: {
                ReturnValue(0)
            }
        }
        ReturnValue(0)
    }
}

// Slot address for the direct-mapped name cache, or 0.
Function.PropTable__CacheBase {
    Input: key: Address
    Output: Address
    Body: {
        IfCondition EqualTo(PropState.cache, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(key, 0) ThenBlock: { ReturnValue(0) }
        // Pointers are 8-aligned, so drop the low bits before the mask.
        ReturnValue(Add(PropState.cache, Multiply(BitwiseAnd(Divide(key, 16), 255), 24)))
    }
}

// Entry address if this key was cached for this table and still matches.
Function.PropTable__CacheHit {
    Input: table: Address
    Input: key: Address
    Output: Address
    Body: {
        save_table = table
        save_key = key
        base = PropTable__CacheBase(save_key)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Dereference(base), save_key) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Dereference(Add(base, 8)), save_table) ThenBlock: { ReturnValue(0) }
        PropState.cache_hold = base
        IfCondition EqualTo(Dereference(Add(PropState.cache_hold, 16)), 0) ThenBlock: { ReturnValue(0) }
        ekey = Dereference(Dereference(Add(PropState.cache_hold, 16)))
        IfCondition EqualTo(ekey, save_key) ThenBlock: {
            ReturnValue(Dereference(Add(PropState.cache_hold, 16)))
        }
        IfCondition EqualTo(ekey, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ekey, PropConst.TOMBSTONE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(PropTable__KeyEq(Dereference(Dereference(Add(PropState.cache_hold, 16))), save_key), 1) ThenBlock: {
            ReturnValue(Dereference(Add(PropState.cache_hold, 16)))
        }
        ReturnValue(0)
    }
}

Function.PropTable__CacheStore {
    Input: table: Address
    Input: key: Address
    Input: addr: Address
    Body: {
        save_table = table
        save_key = key
        save_addr = addr
        base = PropTable__CacheBase(save_key)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(base, save_key)
        StoreValue(Add(base, 8), save_table)
        StoreValue(Add(base, 16), save_addr)
        ReturnValue(1)
    }
}

// =============================================================================
// OBJECT PROPERTY TABLE — lookup
// Linear scan entries[0..count-1]. Pointer compare first, string fallback.
// Returns value or -1 (XNULL) if not found.
// =============================================================================
Function.PropTable_Lookup {
    Input: table: Address
    Input: key: Address
    Output: Integer
    Body: {
        save_table = table
        save_key = key
        IfCondition EqualTo(save_table, 0) ThenBlock: {
            ReturnValue(-1)
        }
        count = Dereference(save_table)
        IfCondition EqualTo(count, 0) ThenBlock: {
            ReturnValue(-1)
        }
        hit = PropTable__CacheHit(save_table, save_key)
        IfCondition NotEqual(hit, 0) ThenBlock: {
            ReturnValue(Dereference(Add(hit, 8)))
        }
        // Clamp count to MAX_ENTRIES
        IfCondition GreaterThan(count, PropConst.MAX_ENTRIES) ThenBlock: {
            count = PropConst.MAX_ENTRIES
        }
        PropTmp.idx = 0
        WhileLoop LessThan(PropTmp.idx, count) {
            // Entry at offset 8 + idx*16
            PropTmp.addr = Add(save_table, Add(8, Multiply(PropTmp.idx, PropConst.ENTRY_SIZE)))
            PropTmp.ekey = Dereference(PropTmp.addr)
            // Skip empty (0) and tombstone (-2)
            IfCondition EqualTo(PropTmp.ekey, 0) ThenBlock: {
                PropTmp.idx = Add(PropTmp.idx, 1)
            } ElseBlock: {
                IfCondition EqualTo(PropTmp.ekey, PropConst.TOMBSTONE) ThenBlock: {
                    PropTmp.idx = Add(PropTmp.idx, 1)
                } ElseBlock: {
                    // Pointer compare first (fast path)
                    IfCondition EqualTo(PropTmp.ekey, save_key) ThenBlock: {
                        PropTable__CacheStore(save_table, save_key, PropTmp.addr)
                        ReturnValue(Dereference(Add(PropTmp.addr, 8)))
                    }
                    // String compare fallback. C keys are UTF-8; lookups are UTF-16.
                    IfCondition EqualTo(PropTable__KeyEq(PropTmp.ekey, save_key), 1) ThenBlock: {
                        PropTable__CacheStore(save_table, save_key, PropTmp.addr)
                        ReturnValue(Dereference(Add(PropTmp.addr, 8)))
                    }
                    PropTmp.idx = Add(PropTmp.idx, 1)
                }
            }
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// OBJECT PROPERTY TABLE — insert/update
// Scan for existing key → update value. Else append at count position.
// Returns 1 (new insert), 0 (update), -1 (table full).
// =============================================================================
Function.PropTable_Insert {
    Input: table: Address
    Input: key: Address
    Input: val: Integer
    Output: Integer
    Body: {
        save_table = table
        save_key = key
        save_val = val
        IfCondition EqualTo(save_table, 0) ThenBlock: {
            ReturnValue(-1)
        }
        count = Dereference(save_table)
        // Clamp count to MAX_ENTRIES
        IfCondition GreaterThan(count, PropConst.MAX_ENTRIES) ThenBlock: {
            count = PropConst.MAX_ENTRIES
        }
        // First pass: check if key already exists
        hit = PropTable__CacheHit(save_table, save_key)
        IfCondition NotEqual(hit, 0) ThenBlock: {
            StoreValue(Add(hit, 8), save_val)
            ReturnValue(0)
        }
        first_tombstone = -1
        PropTmp.idx = 0
        WhileLoop LessThan(PropTmp.idx, count) {
            PropTmp.addr = Add(save_table, Add(8, Multiply(PropTmp.idx, PropConst.ENTRY_SIZE)))
            PropTmp.ekey = Dereference(PropTmp.addr)
            // Track first tombstone for reuse
            IfCondition EqualTo(PropTmp.ekey, PropConst.TOMBSTONE) ThenBlock: {
                IfCondition EqualTo(first_tombstone, -1) ThenBlock: {
                    first_tombstone = PropTmp.idx
                }
            } ElseBlock: {
                IfCondition NotEqual(PropTmp.ekey, 0) ThenBlock: {
                    // Pointer compare
                    IfCondition EqualTo(PropTmp.ekey, save_key) ThenBlock: {
                        StoreValue(Add(PropTmp.addr, 8), save_val)
                        PropTable__CacheStore(save_table, save_key, PropTmp.addr)
                        ReturnValue(0)
                    }
                    // String compare. C keys are UTF-8; lookups are UTF-16.
                    IfCondition EqualTo(PropTable__KeyEq(PropTmp.ekey, save_key), 1) ThenBlock: {
                        StoreValue(Add(PropTmp.addr, 8), save_val)
                        PropTable__CacheStore(save_table, save_key, PropTmp.addr)
                        ReturnValue(0)
                    }
                }
            }
            PropTmp.idx = Add(PropTmp.idx, 1)
        }
        // Not found — insert new entry
        // Reuse tombstone if available
        IfCondition NotEqual(first_tombstone, -1) ThenBlock: {
            PropTmp.addr = Add(save_table, Add(8, Multiply(first_tombstone, PropConst.ENTRY_SIZE)))
            StoreValue(PropTmp.addr, save_key)
            StoreValue(Add(PropTmp.addr, 8), save_val)
            ReturnValue(1)
        }
        // Append at end if room
        IfCondition GreaterEqual(count, PropConst.MAX_ENTRIES) ThenBlock: {
            ReturnValue(-1)
        }
        PropTmp.addr = Add(save_table, Add(8, Multiply(count, PropConst.ENTRY_SIZE)))
        StoreValue(PropTmp.addr, save_key)
        StoreValue(Add(PropTmp.addr, 8), save_val)
        // Increment count
        StoreValue(save_table, Add(count, 1))
        ReturnValue(1)
    }
}

// =============================================================================
// OBJECT PROPERTY TABLE — exists
// Returns 1 if key found, 0 if not.
// =============================================================================
Function.PropTable_Exists {
    Input: table: Address
    Input: key: Address
    Output: Integer
    Body: {
        save_table = table
        save_key = key
        result = PropTable_Lookup(save_table, save_key)
        IfCondition NotEqual(result, -1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// OBJECT PROPERTY TABLE — delete (tombstone)
// Returns old value or -1 if not found.
// =============================================================================
Function.PropTable_Delete {
    Input: table: Address
    Input: key: Address
    Output: Integer
    Body: {
        save_table = table
        save_key = key
        IfCondition EqualTo(save_table, 0) ThenBlock: {
            ReturnValue(-1)
        }
        count = Dereference(save_table)
        IfCondition GreaterThan(count, PropConst.MAX_ENTRIES) ThenBlock: {
            count = PropConst.MAX_ENTRIES
        }
        PropTmp.idx = 0
        WhileLoop LessThan(PropTmp.idx, count) {
            PropTmp.addr = Add(save_table, Add(8, Multiply(PropTmp.idx, PropConst.ENTRY_SIZE)))
            PropTmp.ekey = Dereference(PropTmp.addr)
            IfCondition NotEqual(PropTmp.ekey, 0) ThenBlock: {
                IfCondition NotEqual(PropTmp.ekey, PropConst.TOMBSTONE) ThenBlock: {
                    found = 0
                    IfCondition EqualTo(PropTmp.ekey, save_key) ThenBlock: {
                        found = 1
                    }
                    IfCondition EqualTo(found, 0) ThenBlock: {
                        IfCondition EqualTo(PropTable__KeyEq(PropTmp.ekey, save_key), 1) ThenBlock: {
                            found = 1
                        }
                    }
                    IfCondition EqualTo(found, 1) ThenBlock: {
                        old_val = Dereference(Add(PropTmp.addr, 8))
                        StoreValue(PropTmp.addr, PropConst.TOMBSTONE)
                        StoreValue(Add(PropTmp.addr, 8), 0)
                        ReturnValue(old_val)
                    }
                }
            }
            PropTmp.idx = Add(PropTmp.idx, 1)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// OBJECT PROPERTY TABLE — keys enumeration
// Returns XArray of key pointers (not copies — direct const pool pointers).
// =============================================================================
Function.PropTable_Keys {
    Input: table: Address
    Output: Address
    Body: {
        save_table = table
        keys = Array.Create(16)
        IfCondition EqualTo(save_table, 0) ThenBlock: {
            ReturnValue(keys)
        }
        count = Dereference(save_table)
        IfCondition GreaterThan(count, PropConst.MAX_ENTRIES) ThenBlock: {
            count = PropConst.MAX_ENTRIES
        }
        PropTmp.idx = 0
        WhileLoop LessThan(PropTmp.idx, count) {
            PropTmp.addr = Add(save_table, Add(8, Multiply(PropTmp.idx, PropConst.ENTRY_SIZE)))
            PropTmp.ekey = Dereference(PropTmp.addr)
            // Only collect live entries (not empty, not tombstone)
            IfCondition NotEqual(PropTmp.ekey, 0) ThenBlock: {
                IfCondition NotEqual(PropTmp.ekey, PropConst.TOMBSTONE) ThenBlock: {
                    Array.Push(keys, PropTmp.ekey)
                }
            }
            PropTmp.idx = Add(PropTmp.idx, 1)
        }
        ReturnValue(keys)
    }
}

// =============================================================================
// GLOBAL VARIABLE HASH — open-addressed, linear probing, 2048 slots
// =============================================================================

// DJB2 hash variant (h = h*31 + unit), mod 2048
// M31d: code units so C keys and UTF-16 JS keys with same content hash equal
Function.GlobalHash__Hash {
    Input: key: Address
    Output: Integer
    Body: {
        save_key = key
        h = 0
        n = JSRT_StrLen(save_key)
        PropTmp.idx = 0
        WhileLoop LessThan(PropTmp.idx, n) {
            ch = JSRT_StrUnit(save_key, PropTmp.idx)
            h = Add(Multiply(h, 31), ch)
            PropTmp.idx = Add(PropTmp.idx, 1)
        }
        // Make positive
        IfCondition LessThan(h, 0) ThenBlock: {
            h = Subtract(0, h)
        }
        // Mod 2048 using bitwise AND (2048 = power of 2)
        h = BitwiseAnd(h, 2047)
        ReturnValue(h)
    }
}

// Lookup a global by name. Returns value or -1 if not found.
Function.GlobalHash_Lookup {
    Input: key: Address
    Output: Integer
    Body: {
        save_key = key
        IfCondition EqualTo(PropState.global_hash, 0) ThenBlock: {
            ReturnValue(-1)
        }
        bucket = GlobalHash__Hash(save_key)
        // Linear probe up to 2048 slots
        PropTmp.idx = 0
        WhileLoop LessThan(PropTmp.idx, PropConst.GLOBAL_SLOTS) {
            slot_idx = BitwiseAnd(Add(bucket, PropTmp.idx), 2047)
            PropTmp.addr = Add(PropState.global_hash, Multiply(slot_idx, PropConst.ENTRY_SIZE))
            PropTmp.ekey = Dereference(PropTmp.addr)
            // Empty slot = not found
            IfCondition EqualTo(PropTmp.ekey, 0) ThenBlock: {
                ReturnValue(-1)
            }
            // Tombstone — keep probing
            IfCondition EqualTo(PropTmp.ekey, PropConst.TOMBSTONE) ThenBlock: {
                PropTmp.idx = Add(PropTmp.idx, 1)
            } ElseBlock: {
                // Pointer compare
                IfCondition EqualTo(PropTmp.ekey, save_key) ThenBlock: {
                    ReturnValue(Dereference(Add(PropTmp.addr, 8)))
                }
                // String compare
                IfCondition EqualTo(JSRT_StrEq(PropTmp.ekey, save_key), 1) ThenBlock: {
                    ReturnValue(Dereference(Add(PropTmp.addr, 8)))
                }
                PropTmp.idx = Add(PropTmp.idx, 1)
            }
        }
        ReturnValue(-1)
    }
}

// Insert or update a global. Returns 1 (new) or 0 (update).
Function.GlobalHash_Insert {
    Input: key: Address
    Input: val: Integer
    Output: Integer
    Body: {
        save_key = key
        save_val = val
        IfCondition EqualTo(PropState.global_hash, 0) ThenBlock: {
            ReturnValue(-1)
        }
        bucket = GlobalHash__Hash(save_key)
        // Linear probe
        PropTmp.idx = 0
        tomb_addr = 0
        WhileLoop LessThan(PropTmp.idx, PropConst.GLOBAL_SLOTS) {
            slot_idx = BitwiseAnd(Add(bucket, PropTmp.idx), 2047)
            PropTmp.addr = Add(PropState.global_hash, Multiply(slot_idx, PropConst.ENTRY_SIZE))
            PropTmp.ekey = Dereference(PropTmp.addr)
            // Empty slot — insert here (or first tombstone)
            IfCondition EqualTo(PropTmp.ekey, 0) ThenBlock: {
                IfCondition NotEqual(tomb_addr, 0) ThenBlock: {
                    StoreValue(tomb_addr, save_key)
                    StoreValue(Add(tomb_addr, 8), save_val)
                } ElseBlock: {
                    StoreValue(PropTmp.addr, save_key)
                    StoreValue(Add(PropTmp.addr, 8), save_val)
                }
                ReturnValue(1)
            }
            IfCondition EqualTo(PropTmp.ekey, PropConst.TOMBSTONE) ThenBlock: {
                IfCondition EqualTo(tomb_addr, 0) ThenBlock: {
                    tomb_addr = PropTmp.addr
                }
                PropTmp.idx = Add(PropTmp.idx, 1)
            } ElseBlock: {
                // Existing key — update value
                IfCondition EqualTo(PropTmp.ekey, save_key) ThenBlock: {
                    StoreValue(Add(PropTmp.addr, 8), save_val)
                    ReturnValue(0)
                }
                IfCondition EqualTo(JSRT_StrEq(PropTmp.ekey, save_key), 1) ThenBlock: {
                    StoreValue(Add(PropTmp.addr, 8), save_val)
                    ReturnValue(0)
                }
                PropTmp.idx = Add(PropTmp.idx, 1)
            }
        }
        // Table full — try tombstone
        IfCondition NotEqual(tomb_addr, 0) ThenBlock: {
            StoreValue(tomb_addr, save_key)
            StoreValue(Add(tomb_addr, 8), save_val)
            ReturnValue(1)
        }
        ReturnValue(-1)
    }
}

// M128e7aa: remove global binding (tombstone for linear probe)
Function.GlobalHash_Delete {
    Input: key: Address
    Output: Integer
    Body: {
        save_key = key
        IfCondition EqualTo(PropState.global_hash, 0) ThenBlock: {
            ReturnValue(0)
        }
        bucket = GlobalHash__Hash(save_key)
        PropTmp.idx = 0
        WhileLoop LessThan(PropTmp.idx, PropConst.GLOBAL_SLOTS) {
            slot_idx = BitwiseAnd(Add(bucket, PropTmp.idx), 2047)
            PropTmp.addr = Add(PropState.global_hash, Multiply(slot_idx, PropConst.ENTRY_SIZE))
            PropTmp.ekey = Dereference(PropTmp.addr)
            IfCondition EqualTo(PropTmp.ekey, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(PropTmp.ekey, PropConst.TOMBSTONE) ThenBlock: {
                PropTmp.idx = Add(PropTmp.idx, 1)
            } ElseBlock: {
                hit = 0
                IfCondition EqualTo(PropTmp.ekey, save_key) ThenBlock: { hit = 1 }
                IfCondition EqualTo(hit, 0) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrEq(PropTmp.ekey, save_key), 1) ThenBlock: { hit = 1 }
                }
                IfCondition EqualTo(hit, 1) ThenBlock: {
                    StoreValue(PropTmp.addr, PropConst.TOMBSTONE)
                    StoreValue(Add(PropTmp.addr, 8), 0)
                    ReturnValue(1)
                }
                PropTmp.idx = Add(PropTmp.idx, 1)
            }
        }
        ReturnValue(0)
    }
}

// Reset global hash (clear all slots)
Function.GlobalHash_Reset {
    Output: Integer
    Body: {
        IfCondition NotEqual(PropState.global_hash, 0) ThenBlock: {
            MemorySet(PropState.global_hash, 0, PropConst.GLOBAL_SIZE)
        }
        // Also reset array side table
        IfCondition NotEqual(PropState.arr_side, 0) ThenBlock: {
            as_sz = Multiply(PropConst.ARR_SIDE_MAX, PropConst.ARR_SIDE_ENTRY)
            MemorySet(PropState.arr_side, 0, as_sz)
            PropState.arr_side_count = 0
        }
        ReturnValue(1)
    }
}

// =============================================================================
// ARRAY NAMED-PROPERTY SIDE TABLE
// Maps array *payloads* (XArray handles) to PropTable handles for named props.
// Keyed by payload — NOT the JSValue wrapper pointer — because SetGlobal /
// ObjSet copy the 16-byte JSValue into a new slot; the XArray payload is shared,
// so named props (__proto__, etc.) must follow the payload or they vanish after
// `var a = []` assignment and break `a instanceof Array`.
// Linear scan — 256 entries max. Each: [payload(8) | ptable_ptr(8)]
// =============================================================================

// Look up the PropTable for an array. Returns PropTable address or 0 if none.
Function.ArrSide_Lookup {
    Input: arr_ptr: Address
    Output: Address
    Body: {
        save_arr = arr_ptr
        IfCondition EqualTo(save_arr, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Key = XArray payload at JSValue+8
        save_key = Dereference(Add(save_arr, 8))
        IfCondition EqualTo(save_key, 0) ThenBlock: {
            ReturnValue(0)
        }
        as_i = 0
        WhileLoop LessThan(as_i, PropState.arr_side_count) {
            as_addr = Add(PropState.arr_side, Multiply(as_i, PropConst.ARR_SIDE_ENTRY))
            as_ent = Dereference(as_addr)
            IfCondition EqualTo(as_ent, save_key) ThenBlock: {
                ReturnValue(Dereference(Add(as_addr, 8)))
            }
            as_i = Add(as_i, 1)
        }
        ReturnValue(0)
    }
}

// Get or create a PropTable for an array. Returns PropTable address.
Function.ArrSide_GetOrCreate {
    Input: arr_ptr: Address
    Output: Address
    Body: {
        save_arr = arr_ptr
        IfCondition EqualTo(save_arr, 0) ThenBlock: {
            ReturnValue(0)
        }
        save_key = Dereference(Add(save_arr, 8))
        IfCondition EqualTo(save_key, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Check if already exists (by payload)
        existing = ArrSide_Lookup(save_arr)
        IfCondition NotEqual(existing, 0) ThenBlock: {
            ReturnValue(existing)
        }
        // Allocate new PropTable and insert into side table
        pt = PropTable_Alloc()
        IfCondition GreaterEqual(PropState.arr_side_count, PropConst.ARR_SIDE_MAX) ThenBlock: {
            // Wrap around — overwrite oldest entry
            PropState.arr_side_count = 0
        }
        as_addr = Add(PropState.arr_side, Multiply(PropState.arr_side_count, PropConst.ARR_SIDE_ENTRY))
        StoreValue(as_addr, save_key)
        StoreValue(Add(as_addr, 8), pt)
        PropState.arr_side_count = Add(PropState.arr_side_count, 1)
        ReturnValue(pt)
    }
}
