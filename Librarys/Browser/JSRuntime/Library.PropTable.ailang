// Library.PropTable.ailang — FixedPool property tables replacing XSHash
// Object properties: 264-byte linear-scan tables from ring buffer slab
// Global variables: 8KB open-addressed hash with linear probing
// No Arena. No linked lists. No dynamic allocation.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.PropConst {
    "ENTRY_SIZE":      Initialize=16
    "MAX_ENTRIES":     Initialize=16
    "TABLE_SIZE":      Initialize=264
    "MAX_TABLES":      Initialize=4096
    "TOMBSTONE":       Initialize=-2
    "GLOBAL_SLOTS":    Initialize=512
    "GLOBAL_SIZE":     Initialize=8192
}

// =============================================================================
// STATE
// =============================================================================
FixedPool.PropState {
    "slab":          Initialize=0
    "next_slot":     Initialize=0
    "global_hash":   Initialize=0
}

// =============================================================================
// TEMPORARIES
// =============================================================================
FixedPool.PropTmp {
    "idx":       Initialize=0
    "key":       Initialize=0
    "val":       Initialize=0
    "slot":      Initialize=0
    "addr":      Initialize=0
    "count":     Initialize=0
    "ekey":      Initialize=0
}

// =============================================================================
// INIT — allocate slab + global hash at startup
// =============================================================================
Function.PropTable_Init {
    Output: Integer
    Body: {
        // Object property slab: 4096 x 264 = 1,081,344 bytes
        slab_sz = Multiply(PropConst.MAX_TABLES, PropConst.TABLE_SIZE)
        PropState.slab = Allocate(slab_sz)
        MemorySet(PropState.slab, 0, slab_sz)
        PropState.next_slot = 0

        // Global hash: 512 x 16 = 8192 bytes
        PropState.global_hash = Allocate(PropConst.GLOBAL_SIZE)
        MemorySet(PropState.global_hash, 0, PropConst.GLOBAL_SIZE)

        ReturnValue(1)
    }
}

// =============================================================================
// OBJECT PROPERTY TABLE — ring buffer allocation
// =============================================================================

// Allocate a 264-byte property table for an object.
// Returns address to the table (zeroed). Ring buffer wraps.
Function.PropTable_Alloc {
    Output: Address
    Body: {
        idx = PropState.next_slot
        addr = Add(PropState.slab, Multiply(idx, PropConst.TABLE_SIZE))
        MemorySet(addr, 0, PropConst.TABLE_SIZE)
        PropState.next_slot = Add(idx, 1)
        IfCondition GreaterEqual(PropState.next_slot, PropConst.MAX_TABLES) ThenBlock: {
            PropState.next_slot = 0
        }
        ReturnValue(addr)
    }
}

// =============================================================================
// OBJECT PROPERTY TABLE — lookup
// Linear scan entries[0..count-1]. Pointer compare first, string fallback.
// Returns value or -1 (XNULL) if not found.
// =============================================================================
Function.PropTable_Lookup {
    Input: table: Address
    Input: key: Address
    Output: Integer
    Body: {
        save_table = table
        save_key = key
        IfCondition EqualTo(save_table, 0) ThenBlock: {
            ReturnValue(-1)
        }
        count = Dereference(save_table)
        IfCondition EqualTo(count, 0) ThenBlock: {
            ReturnValue(-1)
        }
        // Clamp count to MAX_ENTRIES
        IfCondition GreaterThan(count, PropConst.MAX_ENTRIES) ThenBlock: {
            count = PropConst.MAX_ENTRIES
        }
        PropTmp.idx = 0
        WhileLoop LessThan(PropTmp.idx, count) {
            // Entry at offset 8 + idx*16
            PropTmp.addr = Add(save_table, Add(8, Multiply(PropTmp.idx, PropConst.ENTRY_SIZE)))
            PropTmp.ekey = Dereference(PropTmp.addr)
            // Skip empty (0) and tombstone (-2)
            IfCondition EqualTo(PropTmp.ekey, 0) ThenBlock: {
                PropTmp.idx = Add(PropTmp.idx, 1)
            } ElseBlock: {
                IfCondition EqualTo(PropTmp.ekey, PropConst.TOMBSTONE) ThenBlock: {
                    PropTmp.idx = Add(PropTmp.idx, 1)
                } ElseBlock: {
                    // Pointer compare first (fast path)
                    IfCondition EqualTo(PropTmp.ekey, save_key) ThenBlock: {
                        ReturnValue(Dereference(Add(PropTmp.addr, 8)))
                    }
                    // String compare fallback
                    cmp = StringCompare(PropTmp.ekey, save_key)
                    IfCondition EqualTo(cmp, 0) ThenBlock: {
                        ReturnValue(Dereference(Add(PropTmp.addr, 8)))
                    }
                    PropTmp.idx = Add(PropTmp.idx, 1)
                }
            }
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// OBJECT PROPERTY TABLE — insert/update
// Scan for existing key → update value. Else append at count position.
// Returns 1 (new insert), 0 (update), -1 (table full).
// =============================================================================
Function.PropTable_Insert {
    Input: table: Address
    Input: key: Address
    Input: val: Integer
    Output: Integer
    Body: {
        save_table = table
        save_key = key
        save_val = val
        IfCondition EqualTo(save_table, 0) ThenBlock: {
            ReturnValue(-1)
        }
        count = Dereference(save_table)
        // Clamp count to MAX_ENTRIES
        IfCondition GreaterThan(count, PropConst.MAX_ENTRIES) ThenBlock: {
            count = PropConst.MAX_ENTRIES
        }
        // First pass: check if key already exists
        first_tombstone = -1
        PropTmp.idx = 0
        WhileLoop LessThan(PropTmp.idx, count) {
            PropTmp.addr = Add(save_table, Add(8, Multiply(PropTmp.idx, PropConst.ENTRY_SIZE)))
            PropTmp.ekey = Dereference(PropTmp.addr)
            // Track first tombstone for reuse
            IfCondition EqualTo(PropTmp.ekey, PropConst.TOMBSTONE) ThenBlock: {
                IfCondition EqualTo(first_tombstone, -1) ThenBlock: {
                    first_tombstone = PropTmp.idx
                }
            } ElseBlock: {
                IfCondition NotEqual(PropTmp.ekey, 0) ThenBlock: {
                    // Pointer compare
                    IfCondition EqualTo(PropTmp.ekey, save_key) ThenBlock: {
                        StoreValue(Add(PropTmp.addr, 8), save_val)
                        ReturnValue(0)
                    }
                    // String compare
                    cmp = StringCompare(PropTmp.ekey, save_key)
                    IfCondition EqualTo(cmp, 0) ThenBlock: {
                        StoreValue(Add(PropTmp.addr, 8), save_val)
                        ReturnValue(0)
                    }
                }
            }
            PropTmp.idx = Add(PropTmp.idx, 1)
        }
        // Not found — insert new entry
        // Reuse tombstone if available
        IfCondition NotEqual(first_tombstone, -1) ThenBlock: {
            PropTmp.addr = Add(save_table, Add(8, Multiply(first_tombstone, PropConst.ENTRY_SIZE)))
            StoreValue(PropTmp.addr, save_key)
            StoreValue(Add(PropTmp.addr, 8), save_val)
            ReturnValue(1)
        }
        // Append at end if room
        IfCondition GreaterEqual(count, PropConst.MAX_ENTRIES) ThenBlock: {
            ReturnValue(-1)
        }
        PropTmp.addr = Add(save_table, Add(8, Multiply(count, PropConst.ENTRY_SIZE)))
        StoreValue(PropTmp.addr, save_key)
        StoreValue(Add(PropTmp.addr, 8), save_val)
        // Increment count
        StoreValue(save_table, Add(count, 1))
        ReturnValue(1)
    }
}

// =============================================================================
// OBJECT PROPERTY TABLE — exists
// Returns 1 if key found, 0 if not.
// =============================================================================
Function.PropTable_Exists {
    Input: table: Address
    Input: key: Address
    Output: Integer
    Body: {
        save_table = table
        save_key = key
        result = PropTable_Lookup(save_table, save_key)
        IfCondition NotEqual(result, -1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// OBJECT PROPERTY TABLE — delete (tombstone)
// Returns old value or -1 if not found.
// =============================================================================
Function.PropTable_Delete {
    Input: table: Address
    Input: key: Address
    Output: Integer
    Body: {
        save_table = table
        save_key = key
        IfCondition EqualTo(save_table, 0) ThenBlock: {
            ReturnValue(-1)
        }
        count = Dereference(save_table)
        IfCondition GreaterThan(count, PropConst.MAX_ENTRIES) ThenBlock: {
            count = PropConst.MAX_ENTRIES
        }
        PropTmp.idx = 0
        WhileLoop LessThan(PropTmp.idx, count) {
            PropTmp.addr = Add(save_table, Add(8, Multiply(PropTmp.idx, PropConst.ENTRY_SIZE)))
            PropTmp.ekey = Dereference(PropTmp.addr)
            IfCondition NotEqual(PropTmp.ekey, 0) ThenBlock: {
                IfCondition NotEqual(PropTmp.ekey, PropConst.TOMBSTONE) ThenBlock: {
                    found = 0
                    IfCondition EqualTo(PropTmp.ekey, save_key) ThenBlock: {
                        found = 1
                    }
                    IfCondition EqualTo(found, 0) ThenBlock: {
                        cmp = StringCompare(PropTmp.ekey, save_key)
                        IfCondition EqualTo(cmp, 0) ThenBlock: {
                            found = 1
                        }
                    }
                    IfCondition EqualTo(found, 1) ThenBlock: {
                        old_val = Dereference(Add(PropTmp.addr, 8))
                        StoreValue(PropTmp.addr, PropConst.TOMBSTONE)
                        StoreValue(Add(PropTmp.addr, 8), 0)
                        ReturnValue(old_val)
                    }
                }
            }
            PropTmp.idx = Add(PropTmp.idx, 1)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// OBJECT PROPERTY TABLE — keys enumeration
// Returns XArray of key pointers (not copies — direct const pool pointers).
// =============================================================================
Function.PropTable_Keys {
    Input: table: Address
    Output: Address
    Body: {
        save_table = table
        keys = XArray.XCreate(16)
        IfCondition EqualTo(save_table, 0) ThenBlock: {
            ReturnValue(keys)
        }
        count = Dereference(save_table)
        IfCondition GreaterThan(count, PropConst.MAX_ENTRIES) ThenBlock: {
            count = PropConst.MAX_ENTRIES
        }
        PropTmp.idx = 0
        WhileLoop LessThan(PropTmp.idx, count) {
            PropTmp.addr = Add(save_table, Add(8, Multiply(PropTmp.idx, PropConst.ENTRY_SIZE)))
            PropTmp.ekey = Dereference(PropTmp.addr)
            // Only collect live entries (not empty, not tombstone)
            IfCondition NotEqual(PropTmp.ekey, 0) ThenBlock: {
                IfCondition NotEqual(PropTmp.ekey, PropConst.TOMBSTONE) ThenBlock: {
                    XArray.XPush(keys, PropTmp.ekey)
                }
            }
            PropTmp.idx = Add(PropTmp.idx, 1)
        }
        ReturnValue(keys)
    }
}

// =============================================================================
// GLOBAL VARIABLE HASH — open-addressed, linear probing, 512 slots
// =============================================================================

// DJB2 hash variant (h = h*31 + byte), mod 512
Function.GlobalHash__Hash {
    Input: key: Address
    Output: Integer
    Body: {
        save_key = key
        h = 0
        PropTmp.idx = 0
        ch = GetByte(save_key, PropTmp.idx)
        WhileLoop NotEqual(ch, 0) {
            h = Add(Multiply(h, 31), ch)
            PropTmp.idx = Add(PropTmp.idx, 1)
            ch = GetByte(save_key, PropTmp.idx)
        }
        // Make positive
        IfCondition LessThan(h, 0) ThenBlock: {
            h = Subtract(0, h)
        }
        // Mod 512 using bitwise AND (512 = power of 2)
        h = BitwiseAnd(h, 511)
        ReturnValue(h)
    }
}

// Lookup a global by name. Returns value or -1 if not found.
Function.GlobalHash_Lookup {
    Input: key: Address
    Output: Integer
    Body: {
        save_key = key
        IfCondition EqualTo(PropState.global_hash, 0) ThenBlock: {
            ReturnValue(-1)
        }
        bucket = GlobalHash__Hash(save_key)
        // Linear probe up to 512 slots
        PropTmp.idx = 0
        WhileLoop LessThan(PropTmp.idx, PropConst.GLOBAL_SLOTS) {
            slot_idx = BitwiseAnd(Add(bucket, PropTmp.idx), 511)
            PropTmp.addr = Add(PropState.global_hash, Multiply(slot_idx, PropConst.ENTRY_SIZE))
            PropTmp.ekey = Dereference(PropTmp.addr)
            // Empty slot = not found
            IfCondition EqualTo(PropTmp.ekey, 0) ThenBlock: {
                ReturnValue(-1)
            }
            // Pointer compare
            IfCondition EqualTo(PropTmp.ekey, save_key) ThenBlock: {
                ReturnValue(Dereference(Add(PropTmp.addr, 8)))
            }
            // String compare
            cmp = StringCompare(PropTmp.ekey, save_key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(Dereference(Add(PropTmp.addr, 8)))
            }
            PropTmp.idx = Add(PropTmp.idx, 1)
        }
        ReturnValue(-1)
    }
}

// Insert or update a global. Returns 1 (new) or 0 (update).
Function.GlobalHash_Insert {
    Input: key: Address
    Input: val: Integer
    Output: Integer
    Body: {
        save_key = key
        save_val = val
        IfCondition EqualTo(PropState.global_hash, 0) ThenBlock: {
            ReturnValue(-1)
        }
        bucket = GlobalHash__Hash(save_key)
        // Linear probe
        PropTmp.idx = 0
        WhileLoop LessThan(PropTmp.idx, PropConst.GLOBAL_SLOTS) {
            slot_idx = BitwiseAnd(Add(bucket, PropTmp.idx), 511)
            PropTmp.addr = Add(PropState.global_hash, Multiply(slot_idx, PropConst.ENTRY_SIZE))
            PropTmp.ekey = Dereference(PropTmp.addr)
            // Empty slot — insert here
            IfCondition EqualTo(PropTmp.ekey, 0) ThenBlock: {
                StoreValue(PropTmp.addr, save_key)
                StoreValue(Add(PropTmp.addr, 8), save_val)
                ReturnValue(1)
            }
            // Existing key — update value
            IfCondition EqualTo(PropTmp.ekey, save_key) ThenBlock: {
                StoreValue(Add(PropTmp.addr, 8), save_val)
                ReturnValue(0)
            }
            cmp = StringCompare(PropTmp.ekey, save_key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                StoreValue(Add(PropTmp.addr, 8), save_val)
                ReturnValue(0)
            }
            PropTmp.idx = Add(PropTmp.idx, 1)
        }
        // Table full
        ReturnValue(-1)
    }
}

// Reset global hash (clear all slots)
Function.GlobalHash_Reset {
    Output: Integer
    Body: {
        IfCondition NotEqual(PropState.global_hash, 0) ThenBlock: {
            MemorySet(PropState.global_hash, 0, PropConst.GLOBAL_SIZE)
        }
        ReturnValue(1)
    }
}
