// Library.JSVMArgs.ailang — arguments object create + mapped sync
// Keep under ~1000 LOC. FixedPools live in Library.JSVM.ailang.
//
// Non-strict mapped arguments: param locals and arguments[i] alias.
// We keep them in sync on SET_LOCAL / SET_ELEM rather than real accessors.
//
// Mole 12: per-index map mask (__mapmask__). defineProperty may unmap an
// index (writable:false or accessor) or value-sync formals while mapped.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// Write decimal index 0..999 into str_slab key, null-terminated.
// Returns key pointer or 0 on OOM.
Function.JSVM__ArgIndexKey {
    Input: idx: Integer
    Output: Address
    Body: {
        save_i = idx
        kbuf = JSRT__StrSlabAlloc(8)
        IfCondition EqualTo(kbuf, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(save_i, 10) ThenBlock: {
            SetByte(kbuf, 0, Add(48, save_i))
            SetByte(kbuf, 1, 0)
        } ElseBlock: {
            IfCondition LessThan(save_i, 100) ThenBlock: {
                SetByte(kbuf, 0, Add(48, Divide(save_i, 10)))
                SetByte(kbuf, 1, Add(48, Subtract(save_i, Multiply(Divide(save_i, 10), 10))))
                SetByte(kbuf, 2, 0)
            } ElseBlock: {
                h = Divide(save_i, 100)
                t = Divide(Subtract(save_i, Multiply(h, 100)), 10)
                o = Subtract(save_i, Multiply(Divide(save_i, 10), 10))
                SetByte(kbuf, 0, Add(48, h))
                SetByte(kbuf, 1, Add(48, t))
                SetByte(kbuf, 2, Add(48, o))
                SetByte(kbuf, 3, 0)
            }
        }
        ReturnValue(kbuf)
    }
}

// Parse digit-only property name as index. Returns -1 if not a plain index.
Function.JSVM_ArgsParseIndex {
    Input: name_ptr: Address
    Output: Integer
    Body: {
        save_n = name_ptr
        IfCondition EqualTo(save_n, 0) ThenBlock: {
            ReturnValue(-1)
        }
        c0 = GetByte(save_n, 0)
        IfCondition EqualTo(c0, 0) ThenBlock: {
            ReturnValue(-1)
        }
        // Must be all digits
        i = 0
        WhileLoop LessThan(i, 8) {
            ch = GetByte(save_n, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                // end — need at least one digit
                IfCondition EqualTo(i, 0) ThenBlock: {
                    ReturnValue(-1)
                }
                // parse
                acc = 0
                j = 0
                WhileLoop LessThan(j, i) {
                    acc = Add(Multiply(acc, 10), Subtract(GetByte(save_n, j), 48))
                    j = Add(j, 1)
                }
                ReturnValue(acc)
            }
            IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                ReturnValue(-1)
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

// Read __mapmask__ bitfield from args object (0 if missing).
Function.JSVM_ArgsGetMask {
    Input: args_obj: Address
    Output: Integer
    Body: {
        save_o = args_obj
        IfCondition EqualTo(save_o, 0) ThenBlock: {
            ReturnValue(0)
        }
        mv = JSRT_ObjGet(save_o, "__mapmask__")
        IfCondition NotEqual(JSRT_GetType(mv), JSType.NUMBER) ThenBlock: {
            // Fallback: __mapped__ count → full mask for 0..n-1
            mn = JSRT_ObjGet(save_o, "__mapped__")
            IfCondition NotEqual(JSRT_GetType(mn), JSType.NUMBER) ThenBlock: {
                ReturnValue(0)
            }
            n = Float_ToInt(JSRT_GetPayload(mn))
            IfCondition LessEqual(n, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition GreaterThan(n, 30) ThenBlock: {
                n = 30
            }
            // (1<<n) - 1
            ReturnValue(Subtract(ShiftLeft(1, n), 1))
        }
        ReturnValue(Float_ToInt(JSRT_GetPayload(mv)))
    }
}

Function.JSVM_ArgsSetMask {
    Input: args_obj: Address
    Input: mask: Integer
    Output: Integer
    Body: {
        save_o = args_obj
        save_m = mask
        JSRT__Push(save_o)
        nv = JSRT_CreateNumber(save_m)
        save_o = JSRT__Pop()
        JSRT_ObjSet(save_o, "__mapmask__", nv)
        ReturnValue(1)
    }
}

// 1 if index is still mapped on this args object.
Function.JSVM_ArgsIsMapped {
    Input: args_obj: Address
    Input: idx: Integer
    Output: Integer
    Body: {
        save_o = args_obj
        save_i = idx
        IfCondition LessThan(save_i, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(save_i, 30) ThenBlock: {
            ReturnValue(0)
        }
        mark = JSRT_ObjGet(save_o, "__is_args__")
        IfCondition EqualTo(JSRT_IsTruthy(mark), 0) ThenBlock: {
            ReturnValue(0)
        }
        mask = JSVM_ArgsGetMask(save_o)
        bit = ShiftLeft(1, save_i)
        IfCondition EqualTo(BitwiseAnd(mask, bit), 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// Clear map bit for index (parameter map unlink).
Function.JSVM_ArgsUnmapIndex {
    Input: args_obj: Address
    Input: idx: Integer
    Output: Integer
    Body: {
        save_o = args_obj
        save_i = idx
        IfCondition LessThan(save_i, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(save_i, 30) ThenBlock: {
            ReturnValue(0)
        }
        mask = JSVM_ArgsGetMask(save_o)
        bit = ShiftLeft(1, save_i)
        new_m = Subtract(mask, BitwiseAnd(mask, bit))
        JSVM_ArgsSetMask(save_o, new_m)
        ReturnValue(1)
    }
}

// After successful delete: if args object + index key, clear map bit.
// Tiny helper — must stay small (Ailang frame limits).
Function.JSVM_ArgsMaybeUnmap {
    Input: args_obj: Address
    Input: key_ptr: Address
    Output: Integer
    Body: {
        o = args_obj
        k = key_ptr
        IfCondition EqualTo(o, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(k, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_GetType(o), JSType.OBJECT) ThenBlock: { ReturnValue(0) }
        m = JSRT_ObjGet(o, "__is_args__")
        IfCondition EqualTo(JSRT_IsTruthy(m), 0) ThenBlock: { ReturnValue(0) }
        // single-digit index only (0-9) — covers formal map range we care about
        c0 = GetByte(k, 0)
        IfCondition Or(LessThan(c0, 48), GreaterThan(c0, 57)) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(k, 1), 0) ThenBlock: { ReturnValue(0) }
        idx = Subtract(c0, 48)
        mv = JSRT_ObjGet(o, "__mapmask__")
        mask = 0
        IfCondition EqualTo(JSRT_GetType(mv), JSType.NUMBER) ThenBlock: {
            mask = Float_ToInt(JSRT_GetPayload(mv))
        }
        bit = ShiftLeft(1, idx)
        IfCondition EqualTo(BitwiseAnd(mask, bit), 0) ThenBlock: { ReturnValue(0) }
        nm = Subtract(mask, bit)
        JSRT__Push(o)
        nv = JSRT_CreateNumber(nm)
        o = JSRT__Pop()
        JSRT_ObjSet(o, "__mapmask__", nv)
        ReturnValue(1)
    }
}

// DELETE_PROP opcode body — keep locals few.
Function.JSVM_OpDeleteProp {
    Output: Integer
    Body: {
        key_val = JSVM__StackPop()
        obj_val = JSVM__StackPop()
        key_ptr = JSVM_ToPropertyKey(key_val)
        ot_del = JSRT_GetType(obj_val)
        // M128e7z: null/undefined base → TypeError (delete null.x)
        IfCondition Or(EqualTo(ot_del, JSType.NULL), EqualTo(ot_del, JSType.UNDEFINED)) ThenBlock: {
            JSVM_ThrowValue(JSVM_CreateTypedError("TypeError", "Cannot delete property of null/undefined"))
            ReturnValue(1)
        }
        // M128e7z: primitive base (String/Number/Boolean) — String exotic [[Delete]]:
        // integer index in range → false (non-configurable); else true.
        // Number/Boolean boxed have no own index data props → true.
        IfCondition EqualTo(ot_del, JSType.STRING) ThenBlock: {
            str_len_d = JSRT_StrLen(JSRT_GetPayload(obj_val))
            // Parse canonical integer index from key
            is_idx_d = 1
            idx_d = 0
            bi_d = 0
            nkey_d = 0
            IfCondition NotEqual(key_ptr, 0) ThenBlock: {
                nkey_d = JSRT_StrLen(key_ptr)
            }
            IfCondition EqualTo(nkey_d, 0) ThenBlock: { is_idx_d = 0 }
            WhileLoop EqualTo(is_idx_d, 1) {
                IfCondition GreaterEqual(bi_d, nkey_d) ThenBlock: {
                    IfCondition EqualTo(bi_d, 0) ThenBlock: { is_idx_d = 0 }
                    IfCondition GreaterThan(bi_d, 0) ThenBlock: { is_idx_d = 2 }
                } ElseBlock: {
                    ch_d = JSRT_StrUnit(key_ptr, bi_d)
                    IfCondition Or(LessThan(ch_d, 48), GreaterThan(ch_d, 57)) ThenBlock: {
                        is_idx_d = 0
                    } ElseBlock: {
                        IfCondition And(EqualTo(bi_d, 0), EqualTo(ch_d, 48)) ThenBlock: {
                            IfCondition GreaterThan(nkey_d, 1) ThenBlock: { is_idx_d = 0 }
                        }
                        IfCondition EqualTo(is_idx_d, 1) ThenBlock: {
                            idx_d = Add(Multiply(idx_d, 10), Subtract(ch_d, 48))
                            bi_d = Add(bi_d, 1)
                            IfCondition GreaterThan(bi_d, 10) ThenBlock: { is_idx_d = 0 }
                        }
                    }
                }
            }
            IfCondition EqualTo(is_idx_d, 2) ThenBlock: {
                IfCondition LessThan(idx_d, str_len_d) ThenBlock: {
                    // In-range string index: non-configurable
                    IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                        JSVM_ThrowValue(JSVM_CreateTypedError("TypeError", "Cannot delete non-configurable property"))
                        ReturnValue(1)
                    }
                    JSVM__StackPush(JSRT_False())
                    ReturnValue(1)
                }
            }
            // Missing / non-index key on string → true
            JSVM__StackPush(JSRT_True())
            ReturnValue(1)
        }
        IfCondition Or(EqualTo(ot_del, JSType.NUMBER), EqualTo(ot_del, JSType.BOOLEAN)) ThenBlock: {
            JSVM__StackPush(JSRT_True())
            ReturnValue(1)
        }
        can_del = 1
        // M128e7aa: global object + GlobalHash — honor configurable attr bits.
        // var/func: !C; assignment-created (PutValue): C and GlobalHash_Delete.
        IfCondition And(NotEqual(key_ptr, 0), Or(EqualTo(ot_del, JSType.OBJECT), EqualTo(ot_del, JSType.FUNCTION))) ThenBlock: {
            gh_hit = GlobalHash_Lookup(key_ptr)
            IfCondition NotEqual(gh_hit, -1) ThenBlock: {
                gt_del = GlobalHash_Lookup("globalThis")
                IfCondition EqualTo(gt_del, -1) ThenBlock: {
                    gt_del = GlobalHash_Lookup("this")
                }
                is_glob_obj = 0
                IfCondition EqualTo(obj_val, gt_del) ThenBlock: { is_glob_obj = 1 }
                IfCondition EqualTo(is_glob_obj, 0) ThenBlock: {
                    IfCondition And(NotEqual(gt_del, -1), EqualTo(JSRT_ObjHas(obj_val, key_ptr), 1)) ThenBlock: {
                        IfCondition EqualTo(JSRT_ObjHas(gt_del, key_ptr), 1) ThenBlock: {
                            is_glob_obj = 1
                        }
                    }
                }
                IfCondition EqualTo(is_glob_obj, 1) ThenBlock: {
                    bits_g = JSBridge__GetAttrBits(obj_val, key_ptr)
                    IfCondition EqualTo(BitwiseAnd(bits_g, 4), 0) ThenBlock: {
                        IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                            JSVM_ThrowValue(JSVM_CreateTypedError("TypeError", "Cannot delete non-configurable property"))
                            ReturnValue(1)
                        }
                        JSVM__StackPush(JSRT_False())
                        ReturnValue(1)
                    }
                    // configurable — delete prop + GlobalHash + script_env dual
                    JSRT_ObjDelete(obj_val, key_ptr)
                    GlobalHash_Delete(key_ptr)
                    IfCondition And(NotEqual(JSVMClosure.script_env, 0), NotEqual(JSVMClosure.script_env, JSRTState.undef_val)) ThenBlock: {
                        IfCondition EqualTo(JSRT_ObjHas(JSVMClosure.script_env, key_ptr), 1) ThenBlock: {
                            JSRT_ObjDelete(JSVMClosure.script_env, key_ptr)
                        }
                    }
                    JSVM__StackPush(JSRT_True())
                    ReturnValue(1)
                }
            }
        }
        // OBJECT and FUNCTION (and ARRAY length via ObjDelete refuse)
        ot_cd = JSRT_GetType(obj_val)
        IfCondition Or(EqualTo(ot_cd, JSType.OBJECT), Or(EqualTo(ot_cd, JSType.FUNCTION), EqualTo(ot_cd, JSType.ARRAY))) ThenBlock: {
            IfCondition EqualTo(ot_cd, JSType.OBJECT) ThenBlock: {
                IfCondition EqualTo(JSRT_IsTruthy(JSRT_ObjGet(obj_val, "__frozen__")), 1) ThenBlock: {
                    can_del = 0
                }
            }
            IfCondition EqualTo(can_del, 1) ThenBlock: {
                IfCondition EqualTo(BitwiseAnd(JSBridge__GetAttrBits(obj_val, key_ptr), 4), 0) ThenBlock: {
                    can_del = 0
                }
            }
        }
        IfCondition EqualTo(can_del, 1) ThenBlock: {
            JSRT__Push(obj_val)
            JSRT__Push(key_ptr)
            ok = JSRT_ObjDelete(obj_val, key_ptr)
            key_ptr = JSRT__Pop()
            obj_val = JSRT__Pop()
            // M128e: also remove accessor storage __get_/__set_ + name
            // so delete fully removes getter/setter (StrUnit for UTF-16 keys).
            IfCondition And(NotEqual(key_ptr, 0), NotEqual(obj_val, 0)) ThenBlock: {
                gk = JSVMCallBuf.getter_buf
                klen = JSRT_StrLen(key_ptr)
                // __get_ + name
                SetByte(gk, 0, 95)
                SetByte(gk, 1, 95)
                SetByte(gk, 2, 103)
                SetByte(gk, 3, 101)
                SetByte(gk, 4, 116)
                SetByte(gk, 5, 95)
                gi = 0
                WhileLoop LessThan(gi, klen) {
                    SetByte(gk, Add(6, gi), JSRT_StrUnit(key_ptr, gi))
                    gi = Add(gi, 1)
                }
                SetByte(gk, Add(6, klen), 0)
                JSRT__Push(obj_val)
                JSRT__Push(key_ptr)
                JSRT_ObjDelete(obj_val, gk)
                key_ptr = JSRT__Pop()
                obj_val = JSRT__Pop()
                // __set_ + name
                SetByte(gk, 0, 95)
                SetByte(gk, 1, 95)
                SetByte(gk, 2, 115)
                SetByte(gk, 3, 101)
                SetByte(gk, 4, 116)
                SetByte(gk, 5, 95)
                gi = 0
                WhileLoop LessThan(gi, klen) {
                    SetByte(gk, Add(6, gi), JSRT_StrUnit(key_ptr, gi))
                    gi = Add(gi, 1)
                }
                SetByte(gk, Add(6, klen), 0)
                JSRT__Push(obj_val)
                JSRT__Push(key_ptr)
                JSRT_ObjDelete(obj_val, gk)
                key_ptr = JSRT__Pop()
                obj_val = JSRT__Pop()
            }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                JSVM_ArgsMaybeUnmap(obj_val, key_ptr)
                JSVM__StackPush(JSRT_True())
            } ElseBlock: {
                // M128e7ad: strict delete must throw, never return false (S11.4.1_A5)
                IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                    JSVM_ThrowValue(JSVM_CreateTypedError("TypeError", "Cannot delete non-configurable property"))
                    ReturnValue(1)
                }
                JSVM__StackPush(JSRT_False())
            }
        } ElseBlock: {
            IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                JSVM_ThrowValue(JSVM_CreateTypedError("TypeError", "Cannot delete non-configurable property"))
                ReturnValue(1)
            }
            JSVM__StackPush(JSRT_False())
        }
        ReturnValue(1)
    }
}

// Create arguments object from call arg_buf.
// func_val: the callee (for .callee in non-strict)
// formal_count: number of formals to treat as mapped (rest bit already stripped)
Function.JSVM_CreateArguments {
    Input: arg_buf: Address
    Input: argc: Integer
    Input: func_val: Address
    Input: formal_count: Integer
    Output: Address
    Body: {
        save_buf = arg_buf
        save_argc = argc
        save_func = func_val
        save_formals = formal_count

        args_obj = JSRT_CreateObject()
        IfCondition EqualTo(args_obj, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT__Push(args_obj)
            JSRT_ObjSet(args_obj, "__proto__", JSRTState.object_proto)
            args_obj = JSRT__Pop()
        }

        // Mark as arguments object for sync helpers
        JSRT__Push(args_obj)
        JSRT_ObjSet(args_obj, "__is_args__", JSRT_CreateNumber(1))
        args_obj = JSRT__Pop()
        JSRT__Push(args_obj)
        JSRT_ObjSet(args_obj, "__mapped__", JSRT_CreateNumber(save_formals))
        args_obj = JSRT__Pop()
        // M102: remember owning frame locals_base so defineProperty/nested
        // can still SetLocal formals when CurFrame is wrong
        frame = JSVM__CurFrame()
        IfCondition NotEqual(frame, 0) ThenBlock: {
            lb = Dereference(Add(frame, 16))
            JSRT__Push(args_obj)
            JSRT_ObjSet(args_obj, "__args_lb__", JSRT_CreateNumber(lb))
            args_obj = JSRT__Pop()
        }

        // Per-index map mask (Mole 12). Strict mode → no mapping.
        map_n = save_formals
        IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
            map_n = 0
        }
        IfCondition GreaterThan(map_n, 30) ThenBlock: {
            map_n = 30
        }
        mask = 0
        IfCondition GreaterThan(map_n, 0) ThenBlock: {
            mask = Subtract(ShiftLeft(1, map_n), 1)
        }
        JSRT__Push(args_obj)
        JSVM_ArgsSetMask(args_obj, mask)
        args_obj = JSRT__Pop()

        // length
        JSRT__Push(args_obj)
        len_val = JSRT_CreateNumber(save_argc)
        args_obj = JSRT__Pop()
        JSRT_ObjSet(args_obj, "length", len_val)

        // indexed elements
        ai = 0
        WhileLoop LessThan(ai, save_argc) {
            kbuf = JSVM__ArgIndexKey(ai)
            IfCondition NotEqual(kbuf, 0) ThenBlock: {
                av = Dereference(Add(save_buf, Multiply(ai, 8)))
                JSRT__Push(args_obj)
                JSRT_ObjSet(args_obj, kbuf, av)
                args_obj = JSRT__Pop()
            }
            ai = Add(ai, 1)
        }

        // callee — non-strict only (strict mode arguments have no callee)
        IfCondition EqualTo(JSVMState.is_strict, 0) ThenBlock: {
            IfCondition NotEqual(save_func, 0) ThenBlock: {
                JSRT__Push(args_obj)
                JSRT_ObjSet(args_obj, "callee", save_func)
                args_obj = JSRT__Pop()
            }
        }

        // Mole 16: arguments[Symbol.iterator] === [][Symbol.iterator]
        // Install the shared Array.prototype.values function if available.
        // Spec attrs: writable+configurable, non-enumerable (bits=5).
        IfCondition NotEqual(JSRTState.array_values, 0) ThenBlock: {
            IfCondition NotEqual(JSVMSymbol.iterator, 0) ThenBlock: {
                ik = JSVM_SymbolToKey(JSVMSymbol.iterator)
                IfCondition NotEqual(ik, 0) ThenBlock: {
                    JSRT_ObjSet(args_obj, ik, JSRTState.array_values)
                    JSBridge__SetAttrBits(args_obj, ik, 5)
                }
            }
        }

        ReturnValue(args_obj)
    }
}


// M102: write formal local using arguments object's __args_lb__ (owning frame)
// Falls back to JSVM__SetLocal if no stored base.
Function.JSVM_ArgsSetFormalLocal {
    Input: args_obj: Address
    Input: idx: Integer
    Input: val: Address
    Output: Integer
    Body: {
        save_o = args_obj
        save_i = idx
        save_v = val
        IfCondition LessThan(save_i, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Prefer absolute write via __args_lb__
        lb_v = JSRT_ObjGet(save_o, "__args_lb__")
        IfCondition EqualTo(JSRT_GetType(lb_v), JSType.NUMBER) ThenBlock: {
            lb = Float_ToInt(JSRT_GetPayload(lb_v))
            abs_idx = Add(lb, save_i)
            IfCondition And(GreaterEqual(abs_idx, 0), LessThan(abs_idx, JSVMConst.MAX_STACK)) ThenBlock: {
                saddr = Add(JSVMState.stack, Multiply(abs_idx, 8))
                StoreValue(saddr, save_v)
                // Also poke via SetLocal with fp adjusted to owning frame
                // Find frame whose locals_base == lb
                fi = Subtract(JSVMState.fp, 1)
                WhileLoop GreaterEqual(fi, 0) {
                    frame = Add(JSVMState.frames, Multiply(fi, JSVMConst.FRAME_SIZE))
                    flb = Dereference(Add(frame, 16))
                    IfCondition EqualTo(flb, lb) ThenBlock: {
                        save_fp = JSVMState.fp
                        JSVMState.fp = Add(fi, 1)
                        JSVM__SetLocal(save_i, save_v)
                        JSVMState.fp = save_fp
                        ReturnValue(1)
                    }
                    fi = Subtract(fi, 1)
                }
                ReturnValue(1)
            }
        }
        JSVM__SetLocal(save_i, save_v)
        ReturnValue(1)
    }
}


// After SET_LOCAL(slot): if slot is a mapped formal, write arguments[slot]
Function.JSVM_SyncLocalToArguments {
    Input: slot: Integer
    Input: val: Address
    Output: Integer
    Body: {
        save_slot = slot
        save_val = val
        // Only map in non-strict
        IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
            ReturnValue(0)
        }
        // Need an active call frame
        IfCondition LessEqual(JSVMState.fp, 0) ThenBlock: {
            ReturnValue(0)
        }
        args_obj = JSVM__GetGlobal("arguments")
        IfCondition NotEqual(JSRT_GetType(args_obj), JSType.OBJECT) ThenBlock: {
            ReturnValue(0)
        }
        // Confirm this is an arguments object and index still mapped
        IfCondition EqualTo(JSVM_ArgsIsMapped(args_obj, save_slot), 0) ThenBlock: {
            ReturnValue(0)
        }
        kbuf = JSVM__ArgIndexKey(save_slot)
        IfCondition EqualTo(kbuf, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Honor non-writable (after unmap this path is already dead; still safe)
        can = JSBridge_CanAssign(args_obj, kbuf)
        IfCondition EqualTo(can, 0) ThenBlock: {
            ReturnValue(0)
        }
        JSRT_ObjSet(args_obj, kbuf, save_val)
        ReturnValue(1)
    }
}

// After arguments[idx] = val: update formal local if mapped.
// IMPORTANT: only sync when writing the *current* frame's arguments object.
// Nested calls rebind global `arguments` (e.g. verifyProperty(arguments, ...));
// writing the outer args object must not SetLocal on the inner frame.
Function.JSVM_SyncArgumentsToLocal {
    Input: idx: Integer
    Input: val: Address
    Output: Integer
    Body: {
        save_idx = idx
        save_val = val
        // M102: do not gate on is_strict here (mapped only for non-strict funcs)
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(save_idx, 256) ThenBlock: {
            ReturnValue(0)
        }
        args_obj = JSVM__GetGlobal("arguments")
        IfCondition NotEqual(JSRT_GetType(args_obj), JSType.OBJECT) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(JSVM_ArgsIsMapped(args_obj, save_idx), 0) ThenBlock: {
            ReturnValue(0)
        }
        JSVM_ArgsSetFormalLocal(args_obj, save_idx, save_val)
        ReturnValue(1)
    }
}

// Like SyncArgumentsToLocal but only if written_obj is the current arguments.
Function.JSVM_SyncArgumentsToLocalIfCurrent {
    Input: written_obj: Address
    Input: idx: Integer
    Input: val: Address
    Output: Integer
    Body: {
        save_w = written_obj
        save_idx = idx
        save_val = val
        cur = JSVM__GetGlobal("arguments")
        IfCondition NotEqual(save_w, cur) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(JSVM_SyncArgumentsToLocal(save_idx, save_val))
    }
}

// True if obj is an arguments object (any, not only current frame)
Function.JSVM_IsArgumentsObj {
    Input: obj: Address
    Output: Integer
    Body: {
        save_obj = obj
        IfCondition NotEqual(JSRT_GetType(save_obj), JSType.OBJECT) ThenBlock: {
            ReturnValue(0)
        }
        mark = JSRT_ObjGet(save_obj, "__is_args__")
        ReturnValue(JSRT_IsTruthy(mark))
    }
}

// Called after Object.defineProperty on an arguments object.
// name_ptr: property key string; has_value/value; writable_is_false;
// is_accessor: get or set was a function.
// Applies: value → formal sync if mapped; unmap on !writable or accessor.
Function.JSVM_ArgsAfterDefineProperty {
    Input: args_obj: Address
    Input: name_ptr: Address
    Input: has_value: Integer
    Input: value: Address
    Input: writable_false: Integer
    Input: is_accessor: Integer
    Output: Integer
    Body: {
        save_o = args_obj
        save_n = name_ptr
        save_hv = has_value
        save_v = value
        save_nw = writable_false
        save_acc = is_accessor

        IfCondition EqualTo(save_o, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(save_n, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Must be arguments object
        mark = JSRT_ObjGet(save_o, "__is_args__")
        IfCondition EqualTo(JSRT_IsTruthy(mark), 0) ThenBlock: {
            ReturnValue(0)
        }

        // M102: parse index via helper (handles keys correctly)
        idx = JSVM_ArgsParseIndex(save_n)
        IfCondition LessThan(idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(idx, 30) ThenBlock: {
            ReturnValue(0)
        }

        // Read mask
        mv = JSRT_ObjGet(save_o, "__mapmask__")
        mask = 0
        IfCondition EqualTo(JSRT_GetType(mv), JSType.NUMBER) ThenBlock: {
            mask = Float_ToInt(JSRT_GetPayload(mv))
        }
        bit = ShiftLeft(1, idx)
        is_mapped = 0
        IfCondition NotEqual(BitwiseAnd(mask, bit), 0) ThenBlock: {
            is_mapped = 1
        }

        // Accessor → unmap
        IfCondition EqualTo(save_acc, 1) ThenBlock: {
            new_m = BitwiseAnd(mask, BitwiseNot(bit))
            JSRT__Push(save_o)
            nv = JSRT_CreateNumber(new_m)
            save_o = JSRT__Pop()
            JSRT_ObjSet(save_o, "__mapmask__", nv)
            ReturnValue(1)
        }

        // Value while mapped → sync formal (M102: ignore VM is_strict —
        // mapped args only exist for non-strict functions; native helpers
        // may run under is_strict=1)
        IfCondition EqualTo(is_mapped, 1) ThenBlock: {
            IfCondition EqualTo(save_hv, 1) ThenBlock: {
                IfCondition NotEqual(save_v, 0) ThenBlock: {
                    JSVM_ArgsSetFormalLocal(save_o, idx, save_v)
                }
            }
        }

        // writable:false → unmap
        IfCondition EqualTo(save_nw, 1) ThenBlock: {
            // re-read mask (may have changed)
            mv2 = JSRT_ObjGet(save_o, "__mapmask__")
            mask2 = 0
            IfCondition EqualTo(JSRT_GetType(mv2), JSType.NUMBER) ThenBlock: {
                mask2 = Float_ToInt(JSRT_GetPayload(mv2))
            }
            new_m2 = BitwiseAnd(mask2, BitwiseNot(bit))
            JSRT__Push(save_o)
            nv2 = JSRT_CreateNumber(new_m2)
            save_o = JSRT__Pop()
            JSRT_ObjSet(save_o, "__mapmask__", nv2)
        }
        ReturnValue(1)
    }
}
