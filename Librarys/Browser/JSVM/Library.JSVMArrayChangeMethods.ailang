// Library.JSVMArrayChangeMethods.ailang — ES2023 change-array-by-copy
// toReversed / toSorted / toSpliced / with
// Split from ArrayMethods (LOC budget). Always ArrayCreate — NOT species.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// ─── toReversed (295) — non-mutating reverse → new Array ───
Function.JSVM__ArrToReversed {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.toReversed called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_CreateArray())
        }
        save_recv = JSVM__ArrayToObject(save_recv)
        len = JSVM__ArrayLikeLen(save_recv)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_CreateArray()) }
        IfCondition LessThan(len, 0) ThenBlock: { len = 0 }
        result = JSRT_CreateArray()
        // grow to len with holes then fill present elements
        IfCondition GreaterThan(len, 0) ThenBlock: {
            JSRT_ArrSetLen(result, len)
        }
        k = 0
        WhileLoop LessThan(k, len) {
            from = Subtract(Subtract(len, 1), k)
            JSBridge__Push(save_recv)
            JSBridge__Push(result)
            JSBridge__Push(k)
            JSBridge__Push(len)
            has = JSVM__ArrayLikeHas(save_recv, from)
            len = JSBridge__Pop()
            k = JSBridge__Pop()
            result = JSBridge__Pop()
            save_recv = JSBridge__Pop()
            IfCondition EqualTo(has, 1) ThenBlock: {
                JSBridge__Push(save_recv)
                JSBridge__Push(result)
                JSBridge__Push(k)
                JSBridge__Push(len)
                elem = JSVM__ArrayLikeGet(save_recv, from)
                len = JSBridge__Pop()
                k = JSBridge__Pop()
                result = JSBridge__Pop()
                save_recv = JSBridge__Pop()
                JSRT_ArrSet(result, k, elem)
            }
            k = Add(k, 1)
        }
        ReturnValue(result)
    }
}

// ─── toSorted (296) — non-mutating sort → new Array ───
Function.JSVM__ArrToSorted {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.toSorted called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_CreateArray())
        }
        // comparefn must be undefined or callable
        has_cmp = 0
        cmp_func = 0
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            cmp_func = Dereference(save_args)
            ct = JSRT_GetType(cmp_func)
            IfCondition NotEqual(ct, JSType.UNDEFINED) ThenBlock: {
                IfCondition NotEqual(ct, JSType.FUNCTION) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "comparefn is not a function")
                    JSVM__SetGlobal("__pend_exc__", terr)
                    JSVMCall.exc_prop = 1
                    JSVMCall.thrown_val = terr
                    JSVM_ThrowValue(terr)
                    ReturnValue(JSRT_CreateArray())
                }
                has_cmp = 1
            }
        }
        save_recv = JSVM__ArrayToObject(save_recv)
        len = JSVM__ArrayLikeLen(save_recv)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_CreateArray()) }
        IfCondition LessThan(len, 0) ThenBlock: { len = 0 }
        // Copy present elements (holes → undefined for sort? ES SortIndexedProperties
        // skips holes then densifies — for toSorted: ReadThroughHoles=false means
        // holes become undefined in the result of SortIndexedProperties with
        // skip-holes then dense write... Spec: toSorted uses SortIndexedProperties
        // with holes=skip then creates dense array of sorted present only? No:
        // ES: items = SortIndexedProperties(obj, len, comparefn, read-through-holes=false)
        // When false, only existing properties; result length = number of present.
        // Actually toSorted always returns length = len with densified? 
        // Spec 23.1.3.34: Let A be ? ArrayCreate(len). For each index of items...
        // SortIndexedProperties with holes=false returns list of only present elements
        // then for k 0..items.length-1 CreateDataProperty A[k]=items[k]
        // So A length is len (ArrayCreate) but only items.length properties set?
        // ArrayCreate(len) sets length; then only first items.length filled.
        // Holes in source become trailing holes if sparse...
        // Practical engines: densify undefined for holes when sorting for toSorted.
        // test holes-not-preserved.js expects densified undefineds.
        result = JSRT_CreateArray()
        IfCondition GreaterThan(len, 0) ThenBlock: {
            JSRT_ArrSetLen(result, len)
        }
        // fill with Get (holes → undefined) — densify for sort
        k = 0
        WhileLoop LessThan(k, len) {
            JSBridge__Push(save_recv)
            JSBridge__Push(result)
            JSBridge__Push(k)
            JSBridge__Push(len)
            JSBridge__Push(has_cmp)
            JSBridge__Push(cmp_func)
            elem = JSVM__ArrayLikeGet(save_recv, k)
            cmp_func = JSBridge__Pop()
            has_cmp = JSBridge__Pop()
            len = JSBridge__Pop()
            k = JSBridge__Pop()
            result = JSBridge__Pop()
            save_recv = JSBridge__Pop()
            JSRT_ArrSet(result, k, elem)
            k = Add(k, 1)
        }
        // Sort copy in place (reuse insertion sort like ArrSort)
        IfCondition GreaterThan(len, 1) ThenBlock: {
            i = 1
            WhileLoop LessThan(i, len) {
                key = JSRT_ArrGet(result, i)
                j = Subtract(i, 1)
                done = 0
                WhileLoop And(GreaterEqual(j, 0), EqualTo(done, 0)) {
                    cur = JSRT_ArrGet(result, j)
                    cmp_result = 0
                    IfCondition EqualTo(has_cmp, 1) ThenBlock: {
                        StoreValue(JSArrMethodBuf.arg0, cur)
                        StoreValue(Add(JSArrMethodBuf.arg0, 8), key)
                        cmp_val = JSVM__CallFunc(cmp_func, JSArrMethodBuf.arg0, 2)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            ReturnValue(JSRT_CreateArray())
                        }
                        cmp_result = Float_ToInt(JSRT_ToNumber(cmp_val))
                    } ElseBlock: {
                        a_str = JSRT_ToString(cur)
                        b_str = JSRT_ToString(key)
                        a_ptr = JSRT_GetPayload(a_str)
                        b_ptr = JSRT_GetPayload(b_str)
                        cmp_result = JSRT_StrCmp(a_ptr, b_ptr)
                    }
                    IfCondition GreaterThan(cmp_result, 0) ThenBlock: {
                        JSRT_ArrSet(result, Add(j, 1), cur)
                        j = Subtract(j, 1)
                    } ElseBlock: {
                        done = 1
                    }
                }
                JSRT_ArrSet(result, Add(j, 1), key)
                i = Add(i, 1)
            }
        }
        ReturnValue(result)
    }
}

// ─── toSpliced (297) — non-mutating splice → new Array ───
Function.JSVM__ArrToSpliced {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.toSpliced called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_CreateArray())
        }
        save_recv = JSVM__ArrayToObject(save_recv)
        len = JSVM__ArrayLikeLen(save_recv)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_CreateArray()) }
        IfCondition LessThan(len, 0) ThenBlock: { len = 0 }
        // start
        relativeStart = 0
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            relativeStart = Float_ToInt(JSRT_ToNumber(Dereference(save_args)))
        }
        IfCondition LessThan(relativeStart, 0) ThenBlock: {
            actualStart = Add(len, relativeStart)
            IfCondition LessThan(actualStart, 0) ThenBlock: { actualStart = 0 }
        } ElseBlock: {
            actualStart = relativeStart
            IfCondition GreaterThan(actualStart, len) ThenBlock: { actualStart = len }
        }
        // skipCount / deleteCount
        insertCount = 0
        IfCondition GreaterThan(save_argc, 2) ThenBlock: {
            insertCount = Subtract(save_argc, 2)
        }
        IfCondition EqualTo(save_argc, 0) ThenBlock: {
            actualSkip = 0
        } ElseBlock: {
            IfCondition EqualTo(save_argc, 1) ThenBlock: {
                actualSkip = Subtract(len, actualStart)
            } ElseBlock: {
                // argc >= 2
                sc = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
                IfCondition LessThan(sc, 0) ThenBlock: { sc = 0 }
                maxSkip = Subtract(len, actualStart)
                IfCondition GreaterThan(sc, maxSkip) ThenBlock: { sc = maxSkip }
                actualSkip = sc
            }
        }
        newLen = Add(Subtract(len, actualSkip), insertCount)
        // RangeError if newLen > 2^53-1 — use 2^32-1 as practical bound
        IfCondition GreaterThan(newLen, 4294967295) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Invalid array length")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_CreateArray())
        }
        result = JSRT_CreateArray()
        IfCondition GreaterThan(newLen, 0) ThenBlock: {
            JSRT_ArrSetLen(result, newLen)
        }
        // copy [0, actualStart)
        i = 0
        WhileLoop LessThan(i, actualStart) {
            JSBridge__Push(save_recv)
            JSBridge__Push(result)
            JSBridge__Push(i)
            JSBridge__Push(len)
            JSBridge__Push(actualStart)
            JSBridge__Push(actualSkip)
            JSBridge__Push(insertCount)
            JSBridge__Push(save_args)
            JSBridge__Push(save_argc)
            has = JSVM__ArrayLikeHas(save_recv, i)
            save_argc = JSBridge__Pop()
            save_args = JSBridge__Pop()
            insertCount = JSBridge__Pop()
            actualSkip = JSBridge__Pop()
            actualStart = JSBridge__Pop()
            len = JSBridge__Pop()
            i = JSBridge__Pop()
            result = JSBridge__Pop()
            save_recv = JSBridge__Pop()
            IfCondition EqualTo(has, 1) ThenBlock: {
                JSBridge__Push(save_recv)
                JSBridge__Push(result)
                JSBridge__Push(i)
                JSBridge__Push(len)
                JSBridge__Push(actualStart)
                JSBridge__Push(actualSkip)
                JSBridge__Push(insertCount)
                JSBridge__Push(save_args)
                JSBridge__Push(save_argc)
                elem = JSVM__ArrayLikeGet(save_recv, i)
                save_argc = JSBridge__Pop()
                save_args = JSBridge__Pop()
                insertCount = JSBridge__Pop()
                actualSkip = JSBridge__Pop()
                actualStart = JSBridge__Pop()
                len = JSBridge__Pop()
                i = JSBridge__Pop()
                result = JSBridge__Pop()
                save_recv = JSBridge__Pop()
                JSRT_ArrSet(result, i, elem)
            }
            i = Add(i, 1)
        }
        // insert items
        r = actualStart
        j = 0
        WhileLoop LessThan(j, insertCount) {
            item = Dereference(Add(save_args, Multiply(Add(j, 2), 8)))
            JSRT_ArrSet(result, r, item)
            r = Add(r, 1)
            j = Add(j, 1)
        }
        // copy remainder after skip
        from = Add(actualStart, actualSkip)
        WhileLoop LessThan(from, len) {
            JSBridge__Push(save_recv)
            JSBridge__Push(result)
            JSBridge__Push(r)
            JSBridge__Push(from)
            JSBridge__Push(len)
            has = JSVM__ArrayLikeHas(save_recv, from)
            len = JSBridge__Pop()
            from = JSBridge__Pop()
            r = JSBridge__Pop()
            result = JSBridge__Pop()
            save_recv = JSBridge__Pop()
            IfCondition EqualTo(has, 1) ThenBlock: {
                JSBridge__Push(save_recv)
                JSBridge__Push(result)
                JSBridge__Push(r)
                JSBridge__Push(from)
                JSBridge__Push(len)
                elem = JSVM__ArrayLikeGet(save_recv, from)
                len = JSBridge__Pop()
                from = JSBridge__Pop()
                r = JSBridge__Pop()
                result = JSBridge__Pop()
                save_recv = JSBridge__Pop()
                JSRT_ArrSet(result, r, elem)
            }
            r = Add(r, 1)
            from = Add(from, 1)
        }
        ReturnValue(result)
    }
}

// ─── with (298) — non-mutating index set → new Array ───
Function.JSVM__ArrWith {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.with called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_CreateArray())
        }
        save_recv = JSVM__ArrayToObject(save_recv)
        len = JSVM__ArrayLikeLen(save_recv)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_CreateArray()) }
        IfCondition LessThan(len, 0) ThenBlock: { len = 0 }
        relativeIndex = 0
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            relativeIndex = Float_ToInt(JSRT_ToNumber(Dereference(save_args)))
        }
        value = JSRT_Undefined()
        IfCondition GreaterThan(save_argc, 1) ThenBlock: {
            value = Dereference(Add(save_args, 8))
        }
        IfCondition LessThan(relativeIndex, 0) ThenBlock: {
            actualIndex = Add(len, relativeIndex)
        } ElseBlock: {
            actualIndex = relativeIndex
        }
        IfCondition Or(LessThan(actualIndex, 0), GreaterEqual(actualIndex, len)) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Invalid index for Array.prototype.with")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_CreateArray())
        }
        result = JSRT_CreateArray()
        IfCondition GreaterThan(len, 0) ThenBlock: {
            JSRT_ArrSetLen(result, len)
        }
        k = 0
        WhileLoop LessThan(k, len) {
            IfCondition EqualTo(k, actualIndex) ThenBlock: {
                JSRT_ArrSet(result, k, value)
            } ElseBlock: {
                JSBridge__Push(save_recv)
                JSBridge__Push(result)
                JSBridge__Push(k)
                JSBridge__Push(len)
                JSBridge__Push(actualIndex)
                JSBridge__Push(value)
                has = JSVM__ArrayLikeHas(save_recv, k)
                value = JSBridge__Pop()
                actualIndex = JSBridge__Pop()
                len = JSBridge__Pop()
                k = JSBridge__Pop()
                result = JSBridge__Pop()
                save_recv = JSBridge__Pop()
                IfCondition EqualTo(has, 1) ThenBlock: {
                    JSBridge__Push(save_recv)
                    JSBridge__Push(result)
                    JSBridge__Push(k)
                    JSBridge__Push(len)
                    JSBridge__Push(actualIndex)
                    JSBridge__Push(value)
                    elem = JSVM__ArrayLikeGet(save_recv, k)
                    value = JSBridge__Pop()
                    actualIndex = JSBridge__Pop()
                    len = JSBridge__Pop()
                    k = JSBridge__Pop()
                    result = JSBridge__Pop()
                    save_recv = JSBridge__Pop()
                    JSRT_ArrSet(result, k, elem)
                }
            }
            k = Add(k, 1)
        }
        ReturnValue(result)
    }
}
