        // Process item index -1 = receiver, then 0..argc-1 args
        item_i = -1
        WhileLoop LessThan(item_i, save_argc) {
            IfCondition EqualTo(item_i, -1) ThenBlock: {
                E = save_recv
            } ElseBlock: {
                E = Dereference(Add(save_args, Multiply(item_i, 8)))
            }
            JSBridge__Push(save_recv)
            JSBridge__Push(save_args)
            JSBridge__Push(save_argc)
            JSBridge__Push(result)
            JSBridge__Push(n)
            JSBridge__Push(item_i)
            spread = JSVM__IsConcatSpreadable(E)
            item_i = JSBridge__Pop()
            n = JSBridge__Pop()
            result = JSBridge__Pop()
            save_argc = JSBridge__Pop()
            save_args = JSBridge__Pop()
            save_recv = JSBridge__Pop()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(result) }
            IfCondition EqualTo(spread, 1) ThenBlock: {
                // spread elements of E (array-like)
                JSBridge__Push(save_recv)
                JSBridge__Push(save_args)
                JSBridge__Push(save_argc)
                JSBridge__Push(result)
                JSBridge__Push(n)
                JSBridge__Push(item_i)
                JSBridge__Push(E)
                elen = JSVM__ArrayLikeLen(E)
                E = JSBridge__Pop()
                item_i = JSBridge__Pop()
                n = JSBridge__Pop()
                result = JSBridge__Pop()
                save_argc = JSBridge__Pop()
                save_args = JSBridge__Pop()
                save_recv = JSBridge__Pop()
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(result) }
                IfCondition LessThan(elen, 0) ThenBlock: { elen = 0 }
                k = 0
                WhileLoop LessThan(k, elen) {
                    JSBridge__Push(save_recv)
                    JSBridge__Push(save_args)
                    JSBridge__Push(save_argc)
                    JSBridge__Push(result)
                    JSBridge__Push(n)
                    JSBridge__Push(item_i)
                    JSBridge__Push(E)
                    JSBridge__Push(k)
                    JSBridge__Push(elen)
                    has = JSVM__ArrayLikeHas(E, k)
                    elen = JSBridge__Pop()
                    k = JSBridge__Pop()
                    E = JSBridge__Pop()
                    item_i = JSBridge__Pop()
                    n = JSBridge__Pop()
                    result = JSBridge__Pop()
                    save_argc = JSBridge__Pop()
                    save_args = JSBridge__Pop()
                    save_recv = JSBridge__Pop()
                    IfCondition EqualTo(has, 1) ThenBlock: {
                        JSBridge__Push(save_recv)
                        JSBridge__Push(save_args)
                        JSBridge__Push(save_argc)
                        JSBridge__Push(result)
                        JSBridge__Push(n)
                        JSBridge__Push(item_i)
                        JSBridge__Push(E)
                        JSBridge__Push(k)
                        JSBridge__Push(elen)
                        elem = JSVM__ArrayLikeGet(E, k)
                        elen = JSBridge__Pop()
                        k = JSBridge__Pop()
                        E = JSBridge__Pop()
                        item_i = JSBridge__Pop()
                        n = JSBridge__Pop()
                        result = JSBridge__Pop()
                        save_argc = JSBridge__Pop()
                        save_args = JSBridge__Pop()
                        save_recv = JSBridge__Pop()
                        IfCondition EqualTo(is_arr_res, 1) ThenBlock: {
                            // preserve holes: grow with ArrSet at n if needed
                            JSRT_ArrSet(result, n, elem)
                        } ElseBlock: {
                            // IntToStr static — slab copy key
                            tmpk = JSRT__IntToStr(n)
                            tkl = StringLength(tmpk)
                            kptr = JSRT__StrSlabAlloc(Add(tkl, 1))
                            IfCondition NotEqual(kptr, 0) ThenBlock: {
                                MemoryCopy(kptr, tmpk, Add(tkl, 1))
                            } ElseBlock: {
                                kptr = tmpk
                            }
                            JSRT_ObjSet(result, kptr, elem)
                        }
                    } ElseBlock: {
                        // hole — for ARRAY result, ensure length via ArrSet hole or grow
                        IfCondition EqualTo(is_arr_res, 1) ThenBlock: {
                            // ArrSetLen to n+1 leaves holes as raw 0 if growing
                            cur = JSRT_ArrLen(result)
                            IfCondition LessEqual(cur, n) ThenBlock: {
                                JSRT_ArrSetLen(result, Add(n, 1))
                            }
                        }
                    }
                    n = Add(n, 1)
                    k = Add(k, 1)
                }
            } ElseBlock: {
                // append E as single element
                IfCondition EqualTo(is_arr_res, 1) ThenBlock: {
                    JSRT_ArrSet(result, n, E)
                } ElseBlock: {
                    tmpk = JSRT__IntToStr(n)
                    tkl = StringLength(tmpk)
                    kptr = JSRT__StrSlabAlloc(Add(tkl, 1))
                    IfCondition NotEqual(kptr, 0) ThenBlock: {
                        MemoryCopy(kptr, tmpk, Add(tkl, 1))
                    } ElseBlock: {
                        kptr = tmpk
                    }
                    JSRT_ObjSet(result, kptr, E)
                }
                n = Add(n, 1)
            }
            item_i = Add(item_i, 1)
        }
        // set length on non-array species result
        IfCondition EqualTo(is_arr_res, 0) ThenBlock: {
            JSRT_ObjSet(result, "length", JSRT_CreateNumber(n))
        }
        // array result length already tracked by ArrSet/ArrSetLen
        IfCondition EqualTo(is_arr_res, 1) ThenBlock: {
            cur2 = JSRT_ArrLen(result)
            IfCondition LessThan(cur2, n) ThenBlock: {
                JSRT_ArrSetLen(result, n)
            }
        }
        ReturnValue(result)
    }
}

// ─── pop (99) — arr.pop() → last element ───
// M45: array-like generic + length writeback
Function.JSVM__ArrPop {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.pop called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        save_recv = JSVM__ArrayToObject(save_recv)
        arr_len = JSVM__ArrayLikeLen(save_recv)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        IfCondition LessEqual(arr_len, 0) ThenBlock: {
            JSVM__ArrayLikeSetLen(save_recv, 0)
            ReturnValue(JSRT_Undefined())
        }
        last_i = Subtract(arr_len, 1)
        last_val = JSVM__ArrayLikeGet(save_recv, last_i)
        JSVM__ArrayLikeDelete(save_recv, last_i)
        JSVM__ArrayLikeSetLen(save_recv, last_i)
        ReturnValue(last_val)
    }
}

// ─── push (98) — arr.push(...items) → new length ───
// M45: array-like generic
Function.JSVM__ArrPush {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.push called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_CreateNumber(0))
        }
        save_recv = JSVM__ArrayToObject(save_recv)
        arr_len = JSVM__ArrayLikeLen(save_recv)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_CreateNumber(0)) }
        i = 0
        WhileLoop LessThan(i, save_argc) {
            a_val = Dereference(Add(save_args, Multiply(i, 8)))
            JSVM__ArrayLikeSet(save_recv, Add(arr_len, i), a_val)
            i = Add(i, 1)
        }
        new_len = Add(arr_len, save_argc)
        JSVM__ArrayLikeSetLen(save_recv, new_len)
        ReturnValue(JSRT_CreateNumber(new_len))
    }
}

// ─── shift (165) — arr.shift() → removed first element ───
// M45: array-like generic + length write
Function.JSVM__ArrShift {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.shift called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        save_recv = JSVM__ArrayToObject(save_recv)
        arr_len = JSVM__ArrayLikeLen(save_recv)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        IfCondition LessEqual(arr_len, 0) ThenBlock: {
            JSVM__ArrayLikeSetLen(save_recv, 0)
            ReturnValue(JSRT_Undefined())
        }
        first = JSVM__ArrayLikeGet(save_recv, 0)
        i = 1
        WhileLoop LessThan(i, arr_len) {
            // present? copy or delete destination
            IfCondition EqualTo(JSVM__ArrayLikeHas(save_recv, i), 1) ThenBlock: {
                JSVM__ArrayLikeSet(save_recv, Subtract(i, 1), JSVM__ArrayLikeGet(save_recv, i))
            } ElseBlock: {
                JSVM__ArrayLikeDelete(save_recv, Subtract(i, 1))
            }
            i = Add(i, 1)
        }
        JSVM__ArrayLikeDelete(save_recv, Subtract(arr_len, 1))
        JSVM__ArrayLikeSetLen(save_recv, Subtract(arr_len, 1))
        ReturnValue(first)
    }
}

// ─── unshift (166) — arr.unshift(elem1, ...) → new length ───
// M45: array-like generic
Function.JSVM__ArrUnshift {
    Input: recv: Address
