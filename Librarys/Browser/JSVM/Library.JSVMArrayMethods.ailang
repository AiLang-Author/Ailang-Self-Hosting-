// ─── copyWithin (176) — arr.copyWithin(target, start[, end]) ───
Function.JSVM__ArrCopyWithin {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.copyWithin called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        save_recv = JSVM__ArrayToObject(save_recv)
        len = JSVM__MethodLen(save_recv)
        IfCondition LessThan(len, 0) ThenBlock: { ReturnValue(save_recv) }
        // M128e7do: target/start/end via ToIntegerOrInfinity + clamp
        to = 0
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            to = JSVM_ToRelativeIndex(Dereference(save_args), len, 0)
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            IfCondition LessThan(to, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        }
        from = 0
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            from = JSVM_ToRelativeIndex(Dereference(Add(save_args, 8)), len, 0)
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            IfCondition LessThan(from, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        }
        final = len
        IfCondition GreaterEqual(save_argc, 3) ThenBlock: {
            final = JSVM_ToRelativeIndex(Dereference(Add(save_args, 16)), len, len)
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            IfCondition LessThan(final, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        }
        count = Subtract(final, from)
        IfCondition LessThan(count, 0) ThenBlock: { count = 0 }
        // min(count, len - to)
        lim = Subtract(len, to)
        IfCondition GreaterThan(count, lim) ThenBlock: { count = lim }
        // M128e7dv: TypedArray — after index coercion, if count>0 and detached → TypeError
        IfCondition And(GreaterThan(count, 0), EqualTo(JSVM_IsTypedArray(save_recv), 1)) ThenBlock: {
            tbuf_cw = JSRT_ObjGet(save_recv, "__ta_buf__")
            IfCondition EqualTo(JSVM_IsDetachedBuffer(tbuf_cw), 1) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "Cannot copyWithin detached TypedArray")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
        }
        // direction
        direction = 1
        IfCondition And(LessThan(from, to), LessThan(to, Add(from, count))) ThenBlock: {
            direction = -1
            from = Subtract(Add(from, count), 1)
            to = Subtract(Add(to, count), 1)
        }
        ci = 0
        WhileLoop LessThan(ci, count) {
            IfCondition EqualTo(JSVM__ArrayLikeHas(save_recv, from), 1) ThenBlock: {
                val = JSVM__ArrayLikeGet(save_recv, from)
                // M128e7d1: ArrayLikeSet covers ARRAY + TypedArray + object
                JSVM__ArrayLikeSet(save_recv, to, val)
            } ElseBlock: {
                // delete property at to (TypedArray has no holes — skip)
                IfCondition EqualTo(JSRT_GetType(save_recv), JSType.ARRAY) ThenBlock: {
                    JSRT_ArrSet(save_recv, to, JSRTState.hole_val)
                } ElseBlock: {
                    IfCondition EqualTo(JSVM_IsTypedArray(save_recv), 0) ThenBlock: {
                        kptr = JSRT__IntToStr(to)
                        JSRT_ObjDelete(save_recv, kptr)
                    }
                }
            }
            from = Add(from, direction)
            to = Add(to, direction)
            ci = Add(ci, 1)
        }
        ReturnValue(save_recv)
    }
}
