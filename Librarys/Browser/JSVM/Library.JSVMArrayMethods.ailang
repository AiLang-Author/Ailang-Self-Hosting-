            JSArrMethodBuf.sort_kix = Array.Get(JSArrMethodBuf.sort_idx, JSArrMethodBuf.sort_i)
            JSBridge__Push(JSArrMethodBuf.sort_idx)
            JSBridge__Push(JSArrMethodBuf.sort_n)
            JSBridge__Push(JSArrMethodBuf.sort_right)
