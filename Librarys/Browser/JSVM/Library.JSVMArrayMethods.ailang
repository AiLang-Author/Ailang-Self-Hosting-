// Library.JSVMArrayMethods.ailang — Array method dispatch
// Split from Library.JSVM.ailang. FixedPools declared in root file.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// =============================================================================
// ARRAY METHOD DISPATCH — execute array methods with receiver
// =============================================================================
Function.JSVM__DispatchArrayMethod {
    Input: method_id: Integer
    Input: receiver: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = method_id
        save_recv = receiver
        save_args = args
        save_argc = argc

        // Get the XArray from the receiver ARRAY JSValue
        arr_xa = 0
        arr_len = 0
        IfCondition NotEqual(save_recv, 0) ThenBlock: {
            recv_type = JSRT_GetType(save_recv)
            IfCondition EqualTo(recv_type, JSType.ARRAY) ThenBlock: {
                arr_xa = Dereference(Add(save_recv, 8))
                arr_len = XArray.XSize(arr_xa)
            }
        }

        // ── push (82) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_PUSH) ThenBlock: {
            pi = 0
            WhileLoop LessThan(pi, save_argc) {
                pval = Dereference(Add(save_args, Multiply(pi, 8)))
                JSRT_ArrPush(save_recv, pval)
                pi = Add(pi, 1)
            }
            new_len = JSRT_ArrLen(save_recv)
            ReturnValue(JSRT_CreateNumber(new_len))
        }

        // ── pop (83) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_POP) ThenBlock: {
            IfCondition EqualTo(arr_len, 0) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            result = JSRT_ArrPop(save_recv)
            ReturnValue(result)
        }

        // ── shift (84) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_SHIFT) ThenBlock: {
            IfCondition EqualTo(arr_len, 0) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            first = JSRT_ArrGet(save_recv, 0)
            XArray.XShift(arr_xa)
            ReturnValue(first)
        }

        // ── unshift (85) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_UNSHIFT) ThenBlock: {
            pi = Subtract(save_argc, 1)
            WhileLoop GreaterEqual(pi, 0) {
                pval = Dereference(Add(save_args, Multiply(pi, 8)))
                XArray.XInsert(arr_xa, 0, pval)
                pi = Subtract(pi, 1)
            }
            new_len = XArray.XSize(arr_xa)
            ReturnValue(JSRT_CreateNumber(new_len))
        }

        // ── splice (86) ── splice(start, deleteCount, ...items)
        IfCondition EqualTo(save_id, JSNativeID.ARR_SPLICE) ThenBlock: {
            sp_start = 0
            sp_del = arr_len
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                sp_start = Float_ToInt(JSRT_ToNumber(Dereference(save_args)))
                IfCondition LessThan(sp_start, 0) ThenBlock: {
                    sp_start = Add(arr_len, sp_start)
                    IfCondition LessThan(sp_start, 0) ThenBlock: {
                        sp_start = 0
                    }
                }
                IfCondition GreaterThan(sp_start, arr_len) ThenBlock: {
                    sp_start = arr_len
                }
            }
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                sp_del = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
                IfCondition LessThan(sp_del, 0) ThenBlock: {
                    sp_del = 0
                }
                sp_max = Subtract(arr_len, sp_start)
                IfCondition GreaterThan(sp_del, sp_max) ThenBlock: {
                    sp_del = sp_max
                }
            }
            // Build deleted elements array
            del_arr = JSRT_CreateArray()
            di = 0
            WhileLoop LessThan(di, sp_del) {
                dv = JSRT_ArrGet(save_recv, Add(sp_start, di))
                JSRT_ArrPush(del_arr, dv)
                di = Add(di, 1)
            }
            // Remove deleted elements
            ri = 0
            WhileLoop LessThan(ri, sp_del) {
                XArray.XDelete(arr_xa, sp_start)
                ri = Add(ri, 1)
            }
            // Insert new items
            ii = 2
            ins_pos = sp_start
            WhileLoop LessThan(ii, save_argc) {
                iv = Dereference(Add(save_args, Multiply(ii, 8)))
                XArray.XInsert(arr_xa, ins_pos, iv)
                ins_pos = Add(ins_pos, 1)
                ii = Add(ii, 1)
            }
            ReturnValue(del_arr)
        }

        // ── slice (87) ── slice(begin, end)
        IfCondition EqualTo(save_id, JSNativeID.ARR_SLICE) ThenBlock: {
            sl_begin = 0
            sl_end = arr_len
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                sl_begin = Float_ToInt(JSRT_ToNumber(Dereference(save_args)))
                IfCondition LessThan(sl_begin, 0) ThenBlock: {
                    sl_begin = Add(arr_len, sl_begin)
                    IfCondition LessThan(sl_begin, 0) ThenBlock: {
                        sl_begin = 0
                    }
                }
            }
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                sl_end = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
                IfCondition LessThan(sl_end, 0) ThenBlock: {
                    sl_end = Add(arr_len, sl_end)
                }
            }
            IfCondition GreaterThan(sl_end, arr_len) ThenBlock: {
                sl_end = arr_len
            }
            sl_arr = JSRT_CreateArray()
            si = sl_begin
            WhileLoop LessThan(si, sl_end) {
                sv = JSRT_ArrGet(save_recv, si)
                JSRT_ArrPush(sl_arr, sv)
                si = Add(si, 1)
            }
            ReturnValue(sl_arr)
        }

        // ── concat (88) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_CONCAT) ThenBlock: {
            ca_arr = JSRT_CreateArray()
            // Copy this array
            ci = 0
            WhileLoop LessThan(ci, arr_len) {
                cv = JSRT_ArrGet(save_recv, ci)
                JSRT_ArrPush(ca_arr, cv)
                ci = Add(ci, 1)
            }
            // Append each argument (spread arrays, push non-arrays)
            ai = 0
            WhileLoop LessThan(ai, save_argc) {
                aval = Dereference(Add(save_args, Multiply(ai, 8)))
                at = JSRT_GetType(aval)
                IfCondition EqualTo(at, JSType.ARRAY) ThenBlock: {
                    alen2 = JSRT_ArrLen(aval)
                    aj = 0
                    WhileLoop LessThan(aj, alen2) {
                        av2 = JSRT_ArrGet(aval, aj)
                        JSRT_ArrPush(ca_arr, av2)
                        aj = Add(aj, 1)
                    }
                } ElseBlock: {
                    JSRT_ArrPush(ca_arr, aval)
                }
                ai = Add(ai, 1)
            }
            ReturnValue(ca_arr)
        }

        // ── indexOf (89) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_INDEX_OF) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(-1))
            }
            search_val = Dereference(save_args)
            from_idx = 0
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                from_idx = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
                IfCondition LessThan(from_idx, 0) ThenBlock: {
                    from_idx = Add(arr_len, from_idx)
                    IfCondition LessThan(from_idx, 0) ThenBlock: {
                        from_idx = 0
                    }
                }
            }
            ii2 = from_idx
            WhileLoop LessThan(ii2, arr_len) {
                ev = JSRT_ArrGet(save_recv, ii2)
                IfCondition EqualTo(JSRT_StrictEqual(ev, search_val), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateNumber(ii2))
                }
                ii2 = Add(ii2, 1)
            }
            ReturnValue(JSRT_CreateNumber(-1))
        }

        // ── join (90) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_JOIN) ThenBlock: {
            sep_ptr = ","
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                sep_arg = Dereference(save_args)
                sep_t = JSRT_GetType(sep_arg)
                IfCondition NotEqual(sep_t, JSType.UNDEFINED) ThenBlock: {
                    sep_sv = JSRT_ToString(sep_arg)
                    sep_ptr = JSRT_GetPayload(sep_sv)
                }
            }
            // Build joined string
            jbuf = Allocate(8192)
            jpos = 0
            ji = 0
            WhileLoop LessThan(ji, arr_len) {
                IfCondition GreaterThan(ji, 0) ThenBlock: {
                    // Append separator
                    sk = 0
                    WhileLoop NotEqual(GetByte(sep_ptr, sk), 0) {
                        SetByte(jbuf, jpos, GetByte(sep_ptr, sk))
                        jpos = Add(jpos, 1)
                        sk = Add(sk, 1)
                    }
                }
                el = JSRT_ArrGet(save_recv, ji)
                el_t = JSRT_GetType(el)
                IfCondition And(NotEqual(el_t, JSType.UNDEFINED), NotEqual(el_t, JSType.NULL)) ThenBlock: {
                    el_sv = JSRT_ToString(el)
                    el_p = JSRT_GetPayload(el_sv)
                    ek = 0
                    WhileLoop NotEqual(GetByte(el_p, ek), 0) {
                        SetByte(jbuf, jpos, GetByte(el_p, ek))
                        jpos = Add(jpos, 1)
                        ek = Add(ek, 1)
                    }
                }
                ji = Add(ji, 1)
            }
            SetByte(jbuf, jpos, 0)
            result = JSRT_CreateString(jbuf)
            Deallocate(jbuf, 8192)
            ReturnValue(result)
        }

        // ── reverse (91) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_REVERSE) ThenBlock: {
            rl = 0
            rr = Subtract(arr_len, 1)
            WhileLoop LessThan(rl, rr) {
                lv = JSRT_ArrGet(save_recv, rl)
                rv2 = JSRT_ArrGet(save_recv, rr)
                JSRT_ArrSet(save_recv, rl, rv2)
                JSRT_ArrSet(save_recv, rr, lv)
                rl = Add(rl, 1)
                rr = Subtract(rr, 1)
            }
            ReturnValue(save_recv)
        }

        // ── includes (92) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_INCLUDES) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSRT_False())
            }
            inc_val = Dereference(save_args)
            inc_from = 0
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                inc_from = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
                IfCondition LessThan(inc_from, 0) ThenBlock: {
                    inc_from = Add(arr_len, inc_from)
                    IfCondition LessThan(inc_from, 0) ThenBlock: {
                        inc_from = 0
                    }
                }
            }
            ki = inc_from
            WhileLoop LessThan(ki, arr_len) {
                kv = JSRT_ArrGet(save_recv, ki)
                IfCondition EqualTo(JSRT_StrictEqual(kv, inc_val), 1) ThenBlock: {
                    ReturnValue(JSRT_True())
                }
                ki = Add(ki, 1)
            }
            ReturnValue(JSRT_False())
        }

        // ── find (93) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_FIND) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            find_fn = Dereference(save_args)
            fi = 0
            WhileLoop LessThan(fi, arr_len) {
                fv = JSRT_ArrGet(save_recv, fi)
                // Call callback(element, index, array)
                cb_buf = JSVMTmp.cb_buf
                StoreValue(cb_buf, fv)
                StoreValue(Add(cb_buf, 8), JSRT_CreateNumber(fi))
                StoreValue(Add(cb_buf, 16), save_recv)
                cb_res = JSVM__CallFunc(find_fn, cb_buf, 3)

                IfCondition EqualTo(JSRT_IsTruthy(cb_res), 1) ThenBlock: {
                    ReturnValue(fv)
                }
                fi = Add(fi, 1)
            }
            ReturnValue(JSRT_Undefined())
        }

        // ── findIndex (94) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_FIND_INDEX) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(-1))
            }
            fxi_fn = Dereference(save_args)
            fxi = 0
            WhileLoop LessThan(fxi, arr_len) {
                fxv = JSRT_ArrGet(save_recv, fxi)
                cb_buf = JSVMTmp.cb_buf
                StoreValue(cb_buf, fxv)
                StoreValue(Add(cb_buf, 8), JSRT_CreateNumber(fxi))
                StoreValue(Add(cb_buf, 16), save_recv)
                cb_res = JSVM__CallFunc(fxi_fn, cb_buf, 3)

                IfCondition EqualTo(JSRT_IsTruthy(cb_res), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateNumber(fxi))
                }
                fxi = Add(fxi, 1)
            }
            ReturnValue(JSRT_CreateNumber(-1))
        }

        // ── fill (95) ── fill(value, start, end)
        IfCondition EqualTo(save_id, JSNativeID.ARR_FILL) ThenBlock: {
            fill_val = JSRT_Undefined()
            fill_start = 0
            fill_end = arr_len
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                fill_val = Dereference(save_args)
            }
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                fill_start = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
                IfCondition LessThan(fill_start, 0) ThenBlock: {
                    fill_start = Add(arr_len, fill_start)
                    IfCondition LessThan(fill_start, 0) ThenBlock: { fill_start = 0 }
                }
            }
            IfCondition GreaterThan(save_argc, 2) ThenBlock: {
                fill_end = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 16))))
                IfCondition LessThan(fill_end, 0) ThenBlock: {
                    fill_end = Add(arr_len, fill_end)
                }
            }
            IfCondition GreaterThan(fill_end, arr_len) ThenBlock: { fill_end = arr_len }
            fli = fill_start
            WhileLoop LessThan(fli, fill_end) {
                JSRT_ArrSet(save_recv, fli, fill_val)
                fli = Add(fli, 1)
            }
            ReturnValue(save_recv)
        }

        // ── every (96) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_EVERY) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSRT_True())
            }
            ev_fn = Dereference(save_args)
            evi = 0
            WhileLoop LessThan(evi, arr_len) {
                evv = JSRT_ArrGet(save_recv, evi)
                cb_buf = JSVMTmp.cb_buf
                StoreValue(cb_buf, evv)
                StoreValue(Add(cb_buf, 8), JSRT_CreateNumber(evi))
                StoreValue(Add(cb_buf, 16), save_recv)
                cb_res = JSVM__CallFunc(ev_fn, cb_buf, 3)

                IfCondition EqualTo(JSRT_IsTruthy(cb_res), 0) ThenBlock: {
                    ReturnValue(JSRT_False())
                }
                evi = Add(evi, 1)
            }
            ReturnValue(JSRT_True())
        }

        // ── some (97) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_SOME) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSRT_False())
            }
            sm_fn = Dereference(save_args)
            smi = 0
            WhileLoop LessThan(smi, arr_len) {
                smv = JSRT_ArrGet(save_recv, smi)
                cb_buf = JSVMTmp.cb_buf
                StoreValue(cb_buf, smv)
                StoreValue(Add(cb_buf, 8), JSRT_CreateNumber(smi))
                StoreValue(Add(cb_buf, 16), save_recv)
                cb_res = JSVM__CallFunc(sm_fn, cb_buf, 3)

                IfCondition EqualTo(JSRT_IsTruthy(cb_res), 1) ThenBlock: {
                    ReturnValue(JSRT_True())
                }
                smi = Add(smi, 1)
            }
            ReturnValue(JSRT_False())
        }

        // ── forEach (98) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_FOR_EACH) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                fe_fn = Dereference(save_args)
                fei = 0
                WhileLoop LessThan(fei, arr_len) {
                    fev = JSRT_ArrGet(save_recv, fei)
                    cb_buf = JSVMTmp.cb_buf
                    StoreValue(cb_buf, fev)
                    StoreValue(Add(cb_buf, 8), JSRT_CreateNumber(fei))
                    StoreValue(Add(cb_buf, 16), save_recv)
                    JSVM__CallFunc(fe_fn, cb_buf, 3)
    
                    fei = Add(fei, 1)
                }
            }
            ReturnValue(JSRT_Undefined())
        }

        // ── map (99) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_MAP) ThenBlock: {
            map_arr = JSRT_CreateArray()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                map_fn = Dereference(save_args)
                mi = 0
                WhileLoop LessThan(mi, arr_len) {
                    mv = JSRT_ArrGet(save_recv, mi)
                    cb_buf = JSVMTmp.cb_buf
                    StoreValue(cb_buf, mv)
                    StoreValue(Add(cb_buf, 8), JSRT_CreateNumber(mi))
                    StoreValue(Add(cb_buf, 16), save_recv)
                    mr = JSVM__CallFunc(map_fn, cb_buf, 3)
    
                    JSRT_ArrPush(map_arr, mr)
                    mi = Add(mi, 1)
                }
            }
            ReturnValue(map_arr)
        }

        // ── filter (100) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_FILTER) ThenBlock: {
            flt_arr = JSRT_CreateArray()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                flt_fn = Dereference(save_args)
                fli = 0
                WhileLoop LessThan(fli, arr_len) {
                    flv = JSRT_ArrGet(save_recv, fli)
                    cb_buf = JSVMTmp.cb_buf
                    StoreValue(cb_buf, flv)
                    StoreValue(Add(cb_buf, 8), JSRT_CreateNumber(fli))
                    StoreValue(Add(cb_buf, 16), save_recv)
                    flr = JSVM__CallFunc(flt_fn, cb_buf, 3)
    
                    IfCondition EqualTo(JSRT_IsTruthy(flr), 1) ThenBlock: {
                        JSRT_ArrPush(flt_arr, flv)
                    }
                    fli = Add(fli, 1)
                }
            }
            ReturnValue(flt_arr)
        }

        // ── reduce (101) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_REDUCE) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            red_fn = Dereference(save_args)
            red_acc = JSRT_Undefined()
            red_start = 0
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                red_acc = Dereference(Add(save_args, 8))
            } ElseBlock: {
                IfCondition GreaterThan(arr_len, 0) ThenBlock: {
                    red_acc = JSRT_ArrGet(save_recv, 0)
                    red_start = 1
                }
            }
            rdi = red_start
            WhileLoop LessThan(rdi, arr_len) {
                rdv = JSRT_ArrGet(save_recv, rdi)
                cb_buf = JSVMTmp.cb_buf
                StoreValue(cb_buf, red_acc)
                StoreValue(Add(cb_buf, 8), rdv)
                StoreValue(Add(cb_buf, 16), JSRT_CreateNumber(rdi))
                StoreValue(Add(cb_buf, 24), save_recv)
                red_acc = JSVM__CallFunc(red_fn, cb_buf, 4)

                rdi = Add(rdi, 1)
            }
            ReturnValue(red_acc)
        }

        // ── sort (103) ── basic insertion sort with compare function
        IfCondition EqualTo(save_id, JSNativeID.ARR_SORT) ThenBlock: {
            sort_fn = 0
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                sort_fn = Dereference(save_args)
                sf_t = JSRT_GetType(sort_fn)
                IfCondition NotEqual(sf_t, JSType.FUNCTION) ThenBlock: {
                    sort_fn = 0
                }
            }
            // Insertion sort
            si = 1
            WhileLoop LessThan(si, arr_len) {
                key_v = JSRT_ArrGet(save_recv, si)
                sj = Subtract(si, 1)
                sort_loop = 1
                WhileLoop And(GreaterEqual(sj, 0), EqualTo(sort_loop, 1)) {
                    sj_v = JSRT_ArrGet(save_recv, sj)
                    cmp_result = 0
                    IfCondition NotEqual(sort_fn, 0) ThenBlock: {
                        cb_buf = JSVMTmp.cb_buf
                        StoreValue(cb_buf, sj_v)
                        StoreValue(Add(cb_buf, 8), key_v)
                        cmp_res = JSVM__CallFunc(sort_fn, cb_buf, 2)

                        cmp_result = Float_ToInt(JSRT_ToNumber(cmp_res))
                    } ElseBlock: {
                        // Default: string comparison
                        sa = JSRT_ToString(sj_v)
                        sb = JSRT_ToString(key_v)
                        sa_p = JSRT_GetPayload(sa)
                        sb_p = JSRT_GetPayload(sb)
                        cmp_result = StringCompare(sa_p, sb_p)
                    }
                    IfCondition GreaterThan(cmp_result, 0) ThenBlock: {
                        JSRT_ArrSet(save_recv, Add(sj, 1), sj_v)
                        sj = Subtract(sj, 1)
                    } ElseBlock: {
                        sort_loop = 0
                    }
                }
                JSRT_ArrSet(save_recv, Add(sj, 1), key_v)
                si = Add(si, 1)
            }
            ReturnValue(save_recv)
        }

        // ── lastIndexOf (104) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_LAST_INDEX_OF) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(-1))
            }
            li_val = Dereference(save_args)
            li_from = Subtract(arr_len, 1)
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                li_from = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
                IfCondition LessThan(li_from, 0) ThenBlock: {
                    li_from = Add(arr_len, li_from)
                }
            }
            IfCondition GreaterEqual(li_from, arr_len) ThenBlock: {
                li_from = Subtract(arr_len, 1)
            }
            lii = li_from
            WhileLoop GreaterEqual(lii, 0) {
                liv = JSRT_ArrGet(save_recv, lii)
                IfCondition EqualTo(JSRT_StrictEqual(liv, li_val), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateNumber(lii))
                }
                lii = Subtract(lii, 1)
            }
            ReturnValue(JSRT_CreateNumber(-1))
        }

        // ── toString (110) ──
        IfCondition EqualTo(save_id, JSNativeID.ARR_TO_STRING) ThenBlock: {
            // Same as join with ","
            jbuf = Allocate(8192)
            jpos = 0
            ji = 0
            WhileLoop LessThan(ji, arr_len) {
                IfCondition GreaterThan(ji, 0) ThenBlock: {
                    SetByte(jbuf, jpos, 44)
                    jpos = Add(jpos, 1)
                }
                el = JSRT_ArrGet(save_recv, ji)
                el_t = JSRT_GetType(el)
                IfCondition And(NotEqual(el_t, JSType.UNDEFINED), NotEqual(el_t, JSType.NULL)) ThenBlock: {
                    el_sv = JSRT_ToString(el)
                    el_p = JSRT_GetPayload(el_sv)
                    ek = 0
                    WhileLoop NotEqual(GetByte(el_p, ek), 0) {
                        SetByte(jbuf, jpos, GetByte(el_p, ek))
                        jpos = Add(jpos, 1)
                        ek = Add(ek, 1)
                    }
                }
                ji = Add(ji, 1)
            }
            SetByte(jbuf, jpos, 0)
            result = JSRT_CreateString(jbuf)
            Deallocate(jbuf, 8192)
            ReturnValue(result)
        }

        // Unknown method
        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// ARRAY METHOD MATCHING — returns JSNativeID or 0
// =============================================================================
Function.JSVM__MatchArrayMethod {
    Input: name: Address
    Output: Integer
    Body: {
        save_name = name

        IfCondition EqualTo(StringCompare(save_name, "push"), 0) ThenBlock: { ReturnValue(JSNativeID.ARR_PUSH) }
        IfCondition EqualTo(StringCompare(save_name, "pop"), 0) ThenBlock: { ReturnValue(JSNativeID.ARR_POP) }
        IfCondition EqualTo(StringCompare(save_name, "shift"), 0) ThenBlock: { ReturnValue(JSNativeID.ARR_SHIFT) }
        IfCondition EqualTo(StringCompare(save_name, "unshift"), 0) ThenBlock: { ReturnValue(JSNativeID.ARR_UNSHIFT) }
        IfCondition EqualTo(StringCompare(save_name, "splice"), 0) ThenBlock: { ReturnValue(JSNativeID.ARR_SPLICE) }
        IfCondition EqualTo(StringCompare(save_name, "slice"), 0) ThenBlock: { ReturnValue(JSNativeID.ARR_SLICE) }
