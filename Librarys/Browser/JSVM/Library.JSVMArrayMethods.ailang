        ri = 0
        WhileLoop LessThan(ri, del_count) {
            idx_r = Add(start, ri)
            JSBridge__Push(save_recv)
            JSBridge__Push(removed)
            JSBridge__Push(ri)
            JSBridge__Push(del_count)
            JSBridge__Push(start)
            JSBridge__Push(arr_len)
            JSBridge__Push(save_args)
            JSBridge__Push(save_argc)
            has_r = JSVM__ArrayLikeHas(save_recv, idx_r)
            save_argc = JSBridge__Pop()
            save_args = JSBridge__Pop()
            arr_len = JSBridge__Pop()
            start = JSBridge__Pop()
            del_count = JSBridge__Pop()
            ri = JSBridge__Pop()
            removed = JSBridge__Pop()
            save_recv = JSBridge__Pop()
            IfCondition EqualTo(has_r, 1) ThenBlock: {
                JSBridge__Push(save_recv)
                JSBridge__Push(removed)
                JSBridge__Push(ri)
                JSBridge__Push(del_count)
                JSBridge__Push(start)
                JSBridge__Push(arr_len)
                JSBridge__Push(save_args)
                JSBridge__Push(save_argc)
                elem_r = JSVM__ArrayLikeGet(save_recv, idx_r)
                save_argc = JSBridge__Pop()
                save_args = JSBridge__Pop()
                arr_len = JSBridge__Pop()
                start = JSBridge__Pop()
                del_count = JSBridge__Pop()
                ri = JSBridge__Pop()
                removed = JSBridge__Pop()
                save_recv = JSBridge__Pop()
                IfCondition EqualTo(is_arr_rem, 1) ThenBlock: {
                    JSRT_ArrSet(removed, ri, elem_r)
                } ElseBlock: {
                    kptr = JSRT__IntToStr(ri)
                    JSRT_ObjSet(removed, kptr, elem_r)
                }
            } ElseBlock: {
                IfCondition EqualTo(is_arr_rem, 1) ThenBlock: {
                    // ensure length covers hole
                    cur_rl = JSRT_ArrLen(removed)
                    IfCondition LessEqual(cur_rl, ri) ThenBlock: {
                        JSRT_ArrSetLen(removed, Add(ri, 1))
                    }
                }
            }
            ri = Add(ri, 1)
        }
        IfCondition EqualTo(is_arr_rem, 1) ThenBlock: {
            IfCondition LessThan(JSRT_ArrLen(removed), del_count) ThenBlock: {
                JSRT_ArrSetLen(removed, del_count)
            }
