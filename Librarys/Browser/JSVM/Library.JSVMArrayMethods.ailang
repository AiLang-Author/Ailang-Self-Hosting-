        JSRT__Push(save_o)
        JSRT__Push(save_len)
        ctor = JSVM__GetProperty(save_o, "constructor")
        save_len = JSRT__Pop()
        save_o = JSRT__Pop()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
