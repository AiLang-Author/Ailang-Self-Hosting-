}

// M29d/h: has index on array or array-like
// M43: ARRAY holes still HasProperty via [[Prototype]]
// M46: own/inherited accessors (__get_N) count as present
Function.JSVM__ArrayLikeHas {
    Input: obj: Address
    Input: idx: Integer
    Output: Integer
    Body: {
        // Incoming args die across the calls below. Reload them from the pool.
        JSArrMethodBuf.diag_o = obj
        JSArrMethodBuf.diag_i = idx
        save_o = JSArrMethodBuf.diag_o
        save_i = JSArrMethodBuf.diag_i
        ot = JSRT_GetType(JSArrMethodBuf.diag_o)
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            IfCondition EqualTo(JSRT_ArrHas(save_o, save_i), 1) ThenBlock: {
                ReturnValue(1)
            }
            kptr_a = JSRT__IntToStr(save_i)
            // accessor on array side table / proto
            gk_a = JSBridge__MakeAccKey(kptr_a, 0)
            IfCondition NotEqual(gk_a, 0) ThenBlock: {
                IfCondition NotEqual(JSRT_ObjHasOnChain(save_o, gk_a), 0) ThenBlock: {
                    ReturnValue(1)
                }
            }
            ReturnValue(JSRT_ObjHasOnChain(save_o, kptr_a))
        }
        // M128e7d1: TypedArray integer indices always present in [0, len)
        // (detached Get returns undefined; iteration still visits — web-reality)
        // Reflect.has uses JSVM__HasProperty which returns false when detached.
        IfCondition EqualTo(ot, JSType.OBJECT) ThenBlock: {
            IfCondition EqualTo(JSVM_IsTypedArray(save_o), 1) ThenBlock: {
                IfCondition And(GreaterEqual(save_i, 0), LessThan(save_i, JSVM_TA_Length(save_o))) ThenBlock: {
                    ReturnValue(1)
                }
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(ot, JSType.STRING) ThenBlock: {
            JSArrMethodBuf.diag_p = JSRT_GetPayload(JSArrMethodBuf.diag_o)
            JSArrMethodBuf.diag_n = 0
            IfCondition NotEqual(JSArrMethodBuf.diag_p, 0) ThenBlock: {
                JSArrMethodBuf.diag_n = JSRT_StrLen(JSArrMethodBuf.diag_p)
            }
            // Power writes r12/r13. StrLen's inlined string helper does too,
            // and the compare was still reading the smashed index register.
            JSArrMethodBuf.diag_i = Power(JSArrMethodBuf.diag_i, 1)
            JSArrMethodBuf.diag_n = Power(JSArrMethodBuf.diag_n, 1)
            IfCondition GreaterEqual(JSArrMethodBuf.diag_i, 0) ThenBlock: {
                IfCondition LessThan(JSArrMethodBuf.diag_i, JSArrMethodBuf.diag_n) ThenBlock: {
                    ReturnValue(1)
                }
            }
            ReturnValue(0)
        }
        kptr = JSRT__IntToStr(save_i)
        // data property own/chain
        IfCondition NotEqual(JSRT_ObjHasOnChain(save_o, kptr), 0) ThenBlock: {
            ReturnValue(1)
        }
        // accessor __get_N or setter-only __set_N (still present)
        gk = JSBridge__MakeAccKey(kptr, 0)
        IfCondition NotEqual(gk, 0) ThenBlock: {
            IfCondition NotEqual(JSRT_ObjHasOnChain(save_o, gk), 0) ThenBlock: {
                ReturnValue(1)
            }
        }
        sk = JSBridge__MakeAccKey(kptr, 1)
        IfCondition EqualTo(sk, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(JSRT_ObjHasOnChain(save_o, sk))
    }
}

