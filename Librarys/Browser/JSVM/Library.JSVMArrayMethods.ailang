            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_CreateNumber(-1))
        }
        cb_func = Dereference(save_args)
        IfCondition NotEqual(JSRT_GetType(cb_func), JSType.FUNCTION) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "callback is not a function")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_CreateNumber(-1))
        }
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            this_arg = Dereference(Add(save_args, 8))
            JSVM__SetGlobal("this", this_arg)
        }
        arr_len = JSVM__ArrayLikeLen(save_recv)
        IfCondition LessThan(arr_len, 0) ThenBlock: { ReturnValue(JSRT_CreateNumber(-1)) }
        i = Subtract(arr_len, 1)
        WhileLoop GreaterEqual(i, 0) {
