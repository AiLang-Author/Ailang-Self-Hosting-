                IfCondition LessThan(JSVM_TA_Length(ret_c), save_len) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "species TypedArray too short")
                    JSVM__SetGlobal("__pend_exc__", terr)
                    JSVMCall.exc_prop = 1
                    JSVMCall.thrown_val = terr
                    JSVMState.exc_val = terr
                    ReturnValue(JSRT_Undefined())
                }
                ReturnValue(ret_c)
