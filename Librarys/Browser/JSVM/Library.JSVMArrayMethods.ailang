// Library.JSVMArrayMethods.ailang — Array method matching and dispatch
// Split from Library.JSVM.ailang. FixedPools declared in root file.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// =============================================================================
// ARRAY METHOD NAME MATCHING — returns JSNativeID or 0
// Byte values: a=97 c=99 d=100 e=101 f=102 g=103 h=104 i=105 j=106
//   k=107 l=108 m=109 n=110 o=111 p=112 r=114 s=115 t=116 u=117 v=118
//   x=120 y=121 A=65 C=67 E=69 F=70 I=73 L=76 M=77 O=79 R=82 S=83
// =============================================================================
Function.JSVM__MatchArrayMethod {
    Input: name: Address
    Output: Integer
    Body: {
        save_name = name
        c0 = GetByte(save_name, 0)

        // ── 'c' methods: concat ──
        IfCondition EqualTo(c0, 99) ThenBlock: {
            // concat = 99 111 110 99 97 116 0
            IfCondition EqualTo(GetByte(save_name, 1), 111) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 110) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 99) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 97) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 116) ThenBlock: {
                                IfCondition EqualTo(GetByte(save_name, 6), 0) ThenBlock: {
                                    ReturnValue(JSNativeID.ARR_CONCAT)
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 'e' methods: every ──
        IfCondition EqualTo(c0, 101) ThenBlock: {
            // every = 101 118 101 114 121 0
            IfCondition EqualTo(GetByte(save_name, 1), 118) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 101) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 114) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 121) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 0) ThenBlock: {
                                ReturnValue(JSNativeID.ARR_EVERY)
                            }
                        }
                    }
                }
            }
        }

        // ── 'f' methods: forEach, filter, find, findIndex, fill, flat, flatMap ──
        IfCondition EqualTo(c0, 102) ThenBlock: {
            c1 = GetByte(save_name, 1)
            // forEach = 102 111 114 69 97 99 104 0
            IfCondition EqualTo(c1, 111) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 114) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 69) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 97) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 99) ThenBlock: {
                                IfCondition EqualTo(GetByte(save_name, 6), 104) ThenBlock: {
                                    IfCondition EqualTo(GetByte(save_name, 7), 0) ThenBlock: {
                                        ReturnValue(JSNativeID.ARR_FOR_EACH)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // filter = 102 105 108 116 101 114 0
            IfCondition EqualTo(c1, 105) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 108) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 116) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 101) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 114) ThenBlock: {
                                IfCondition EqualTo(GetByte(save_name, 6), 0) ThenBlock: {
                                    ReturnValue(JSNativeID.ARR_FILTER)
                                }
                            }
                        }
                    }
                }
                // find = 102 105 110 100 0
                IfCondition EqualTo(GetByte(save_name, 2), 110) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 100) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.ARR_FIND)
                        }
                        // findIndex = 102 105 110 100 73 110 100 101 120 0
                        IfCondition EqualTo(GetByte(save_name, 4), 73) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 110) ThenBlock: {
                                IfCondition EqualTo(GetByte(save_name, 6), 100) ThenBlock: {
                                    IfCondition EqualTo(GetByte(save_name, 7), 101) ThenBlock: {
                                        IfCondition EqualTo(GetByte(save_name, 8), 120) ThenBlock: {
                                            IfCondition EqualTo(GetByte(save_name, 9), 0) ThenBlock: {
                                                ReturnValue(JSNativeID.ARR_FIND_INDEX)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // fill = 102 105 108 108 0
                IfCondition EqualTo(GetByte(save_name, 2), 108) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 108) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.ARR_FILL)
                        }
                    }
                }
            }
            // flat = 102 108 97 116 0
            IfCondition EqualTo(c1, 108) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 97) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 116) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.ARR_FLAT)
                        }
                        // flatMap = 102 108 97 116 77 97 112 0
                        IfCondition EqualTo(GetByte(save_name, 4), 77) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 97) ThenBlock: {
                                IfCondition EqualTo(GetByte(save_name, 6), 112) ThenBlock: {
                                    IfCondition EqualTo(GetByte(save_name, 7), 0) ThenBlock: {
                                        ReturnValue(JSNativeID.ARR_FLAT_MAP)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 'i' methods: indexOf, includes ──
        IfCondition EqualTo(c0, 105) ThenBlock: {
            c1 = GetByte(save_name, 1)
            // indexOf = 105 110 100 101 120 79 102 0
            IfCondition EqualTo(c1, 110) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 100) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 101) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 120) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 79) ThenBlock: {
                                IfCondition EqualTo(GetByte(save_name, 6), 102) ThenBlock: {
                                    IfCondition EqualTo(GetByte(save_name, 7), 0) ThenBlock: {
                                        ReturnValue(JSNativeID.ARR_INDEX_OF)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // includes = 105 110 99 108 117 100 101 115 0
            IfCondition EqualTo(c1, 110) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 99) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 108) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 117) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 100) ThenBlock: {
                                IfCondition EqualTo(GetByte(save_name, 6), 101) ThenBlock: {
                                    IfCondition EqualTo(GetByte(save_name, 7), 115) ThenBlock: {
                                        IfCondition EqualTo(GetByte(save_name, 8), 0) ThenBlock: {
                                            ReturnValue(JSNativeID.ARR_INCLUDES)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 'j' methods: join ──
        IfCondition EqualTo(c0, 106) ThenBlock: {
            // join = 106 111 105 110 0
            IfCondition EqualTo(GetByte(save_name, 1), 111) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 105) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 110) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.ARR_JOIN)
                        }
                    }
                }
            }
        }

        // ── 'l' methods: lastIndexOf ──
        IfCondition EqualTo(c0, 108) ThenBlock: {
            // lastIndexOf = 108 97 115 116 73 110 100 101 120 79 102 0
            IfCondition EqualTo(GetByte(save_name, 1), 97) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 115) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 116) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 73) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 110) ThenBlock: {
                                IfCondition EqualTo(GetByte(save_name, 6), 100) ThenBlock: {
                                    IfCondition EqualTo(GetByte(save_name, 7), 101) ThenBlock: {
                                        IfCondition EqualTo(GetByte(save_name, 8), 120) ThenBlock: {
                                            IfCondition EqualTo(GetByte(save_name, 9), 79) ThenBlock: {
                                                IfCondition EqualTo(GetByte(save_name, 10), 102) ThenBlock: {
                                                    IfCondition EqualTo(GetByte(save_name, 11), 0) ThenBlock: {
                                                        ReturnValue(JSNativeID.ARR_LAST_INDEX_OF)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 'm' methods: map ──
        IfCondition EqualTo(c0, 109) ThenBlock: {
            // map = 109 97 112 0
            IfCondition EqualTo(GetByte(save_name, 1), 97) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 112) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 0) ThenBlock: {
                        ReturnValue(JSNativeID.ARR_MAP)
                    }
                }
            }
        }

        // ── 'p' methods: push, pop ──
        IfCondition EqualTo(c0, 112) ThenBlock: {
            // push = 112 117 115 104 0
            IfCondition EqualTo(GetByte(save_name, 1), 117) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 115) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 104) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.ARR_PUSH)
                        }
                    }
                }
            }
            // pop = 112 111 112 0
            IfCondition EqualTo(GetByte(save_name, 1), 111) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 112) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 0) ThenBlock: {
                        ReturnValue(JSNativeID.ARR_POP)
                    }
                }
            }
        }

        // ── 'r' methods: reduce, reduceRight, reverse ──
        IfCondition EqualTo(c0, 114) ThenBlock: {
            c1 = GetByte(save_name, 1)
            // reduce = 114 101 100 117 99 101 0
            // reduceRight = 114 101 100 117 99 101 82 105 103 104 116 0
            IfCondition EqualTo(c1, 101) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 100) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 117) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 99) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 101) ThenBlock: {
                                IfCondition EqualTo(GetByte(save_name, 6), 0) ThenBlock: {
                                    ReturnValue(JSNativeID.ARR_REDUCE)
                                }
                                // reduceRight
                                IfCondition EqualTo(GetByte(save_name, 6), 82) ThenBlock: {
                                    IfCondition EqualTo(GetByte(save_name, 7), 105) ThenBlock: {
                                        IfCondition EqualTo(GetByte(save_name, 8), 103) ThenBlock: {
                                            IfCondition EqualTo(GetByte(save_name, 9), 104) ThenBlock: {
                                                IfCondition EqualTo(GetByte(save_name, 10), 116) ThenBlock: {
                                                    IfCondition EqualTo(GetByte(save_name, 11), 0) ThenBlock: {
                                                        ReturnValue(JSNativeID.ARR_REDUCE_RIGHT)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // reverse = 114 101 118 101 114 115 101 0
                }
                IfCondition EqualTo(GetByte(save_name, 2), 118) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 101) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 114) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 115) ThenBlock: {
                                IfCondition EqualTo(GetByte(save_name, 6), 101) ThenBlock: {
                                    IfCondition EqualTo(GetByte(save_name, 7), 0) ThenBlock: {
                                        ReturnValue(JSNativeID.ARR_REVERSE)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 's' methods: slice, splice, sort, shift, some ──
        IfCondition EqualTo(c0, 115) ThenBlock: {
            c1 = GetByte(save_name, 1)
            // slice = 115 108 105 99 101 0
            IfCondition EqualTo(c1, 108) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 105) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 99) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 101) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 0) ThenBlock: {
                                ReturnValue(JSNativeID.ARR_SLICE)
                            }
                        }
                    }
                }
            }
            // splice = 115 112 108 105 99 101 0
            IfCondition EqualTo(c1, 112) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 108) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 105) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 99) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 101) ThenBlock: {
                                IfCondition EqualTo(GetByte(save_name, 6), 0) ThenBlock: {
                                    ReturnValue(JSNativeID.ARR_SPLICE)
                                }
                            }
                        }
                    }
                }
            }
            // sort = 115 111 114 116 0
            IfCondition EqualTo(c1, 111) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 114) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 116) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.ARR_SORT)
                        }
                    }
                }
                // some = 115 111 109 101 0
                IfCondition EqualTo(GetByte(save_name, 2), 109) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 101) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.ARR_SOME)
                        }
                    }
                }
            }
            // shift = 115 104 105 102 116 0
            IfCondition EqualTo(c1, 104) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 105) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 102) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 116) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 0) ThenBlock: {
                                ReturnValue(JSNativeID.ARR_SHIFT)
                            }
                        }
                    }
                }
            }
        }

        // ── 'u' methods: unshift ──
        IfCondition EqualTo(c0, 117) ThenBlock: {
            // unshift = 117 110 115 104 105 102 116 0
            IfCondition EqualTo(GetByte(save_name, 1), 110) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 115) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 104) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 105) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 102) ThenBlock: {
                                IfCondition EqualTo(GetByte(save_name, 6), 116) ThenBlock: {
                                    IfCondition EqualTo(GetByte(save_name, 7), 0) ThenBlock: {
                                        ReturnValue(JSNativeID.ARR_UNSHIFT)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        ReturnValue(0)
    }
}

// =============================================================================
// ARRAY METHOD DISPATCH — implementations for all array methods
// Handler IDs 150-171. Receiver is the ARRAY JSValue.
// Callback-based methods use JSVM__CallFunc for re-entrant JS calls.
// =============================================================================

// Shared arg buffer for callback invocations (3 args max: elem, index, array)
FixedPool.JSArrMethodBuf {
    "arg0":  Initialize=0
    "arg1":  Initialize=0
    "arg2":  Initialize=0
}

// M29g: simplified [[Construct]] for species / ArraySpeciesCreate
// Creates this-object, sets prototype, calls ctor, returns object result or this.
Function.JSVM__Construct {
    Input: ctor: Address
    Input: arg_buf: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_ctor = ctor
        save_ab = arg_buf
        save_ac = argc
        IfCondition NotEqual(JSRT_GetType(save_ctor), JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSRT_CreateArray())
        }
        this_obj = JSRT_CreateObject()
        // this.__proto__ = ctor.prototype when object-like
        JSRT__Push(save_ctor)
        JSRT__Push(save_ab)
        JSRT__Push(save_ac)
        JSRT__Push(this_obj)
        proto = JSRT_ObjGet(save_ctor, "prototype")
        this_obj = JSRT__Pop()
        save_ac = JSRT__Pop()
        save_ab = JSRT__Pop()
        save_ctor = JSRT__Pop()
        pt = JSRT_GetType(proto)
        IfCondition Or(EqualTo(pt, JSType.OBJECT), Or(EqualTo(pt, JSType.ARRAY), EqualTo(pt, JSType.FUNCTION))) ThenBlock: {
            JSRT_ObjSet(this_obj, "__proto__", proto)
        }
        // Bind this + new.target, call
        save_this = JSVM__GetGlobal("this")
        save_nt = JSVM__GetGlobal("__new_target__")
        JSVM__SetGlobal("this", this_obj)
        JSVM__SetGlobal("__new_target__", save_ctor)
        JSRT__Push(this_obj)
        JSRT__Push(save_this)
        JSRT__Push(save_nt)
        ret = JSVM__CallFunc(save_ctor, save_ab, save_ac)
        save_nt = JSRT__Pop()
        save_this = JSRT__Pop()
        this_obj = JSRT__Pop()
        JSVM__SetGlobal("this", save_this)
        JSVM__SetGlobal("__new_target__", save_nt)
        rt = JSRT_GetType(ret)
        IfCondition Or(EqualTo(rt, JSType.OBJECT), Or(EqualTo(rt, JSType.ARRAY), EqualTo(rt, JSType.FUNCTION))) ThenBlock: {
            ReturnValue(ret)
        }
        ReturnValue(this_obj)
    }
}

// M29g: ArraySpeciesCreate(originalArray, length)
// Returns Array or species-constructed instance.
Function.JSVM__ArraySpeciesCreate {
    Input: original: Address
    Input: len: Integer
    Output: Address
    Body: {
        save_o = original
        save_len = len
        // Non-array → ordinary ArrayCreate
        IfCondition NotEqual(JSRT_GetType(save_o), JSType.ARRAY) ThenBlock: {
            ReturnValue(JSRT_CreateArray())
        }
        // C = original.constructor
        JSRT__Push(save_o)
        JSRT__Push(save_len)
        ctor = JSRT_ObjGet(save_o, "constructor")
        save_len = JSRT__Pop()
        save_o = JSRT__Pop()
        ct = JSRT_GetType(ctor)
        // undefined constructor → default Array
        IfCondition EqualTo(ct, JSType.UNDEFINED) ThenBlock: {
            ReturnValue(JSRT_CreateArray())
        }
        // If object, get @@species
        IfCondition Or(EqualTo(ct, JSType.OBJECT), EqualTo(ct, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(JSVMSymbol.species, 0) ThenBlock: {
                sk = JSVM_SymbolToKey(JSVMSymbol.species)
                JSRT__Push(save_o)
                JSRT__Push(save_len)
                JSRT__Push(ctor)
                species = JSRT_ObjGet(ctor, sk)
                ctor = JSRT__Pop()
                save_len = JSRT__Pop()
                save_o = JSRT__Pop()
                st = JSRT_GetType(species)
                // null → default Array (species null treated as undefined)
                IfCondition EqualTo(st, JSType.NULL) ThenBlock: {
                    ReturnValue(JSRT_CreateArray())
                }
                // undefined species → default
                IfCondition EqualTo(st, JSType.UNDEFINED) ThenBlock: {
                    ReturnValue(JSRT_CreateArray())
                }
                // use species as constructor
                IfCondition EqualTo(st, JSType.FUNCTION) ThenBlock: {
                    ctor = species
                    ct = JSType.FUNCTION
                } ElseBlock: {
                    // non-callable species → TypeError
                    terr = JSVM_CreateTypedError("TypeError", "@@species is not a constructor")
                    JSVM__SetGlobal("__pend_exc__", terr)
                    JSVMCall.exc_prop = 1
                    JSVMCall.thrown_val = terr
                    JSVM_ThrowValue(terr)
                    ReturnValue(JSRT_CreateArray())
                }
            }
        }
        // Construct(C, « length »)
        IfCondition EqualTo(ct, JSType.FUNCTION) ThenBlock: {
            // If C is default Array function, just CreateArray (avoid ctor side effects)
            // Always Construct for custom; Array ctor with number creates length
            StoreValue(JSArrMethodBuf.arg0, JSRT_CreateNumber(save_len))
            ReturnValue(JSVM__Construct(ctor, JSArrMethodBuf.arg0, 1))
        }
        ReturnValue(JSRT_CreateArray())
    }
}

// M29d: array-like length (ToLength of .length); real arrays use ArrLen
Function.JSVM__ArrayLikeLen {
    Input: obj: Address
    Output: Integer
    Body: {
        save_o = obj
        ot = JSRT_GetType(save_o)
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSRT_ArrLen(save_o))
        }
        IfCondition Or(EqualTo(ot, JSType.NULL), EqualTo(ot, JSType.UNDEFINED)) ThenBlock: {
            ReturnValue(-1)
        }
        // length property
        lv = JSRT_ObjGet(save_o, "length")
        lt = JSRT_GetType(lv)
        IfCondition EqualTo(lt, JSType.UNDEFINED) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(lt, JSType.NULL) ThenBlock: { ReturnValue(0) }
        // ToNumber → int, clamp >= 0
        n = Float_ToInt(JSRT_ToNumber(lv))
        IfCondition LessThan(n, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(n)
    }
}

// M29d: has index on array or array-like
Function.JSVM__ArrayLikeHas {
    Input: obj: Address
    Input: idx: Integer
    Output: Integer
    Body: {
        save_o = obj
        save_i = idx
        ot = JSRT_GetType(save_o)
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSRT_ArrHas(save_o, save_i))
        }
        // ObjHas key string of index
        kptr = JSRT__IntToStr(save_i)
        ReturnValue(JSRT_ObjHas(save_o, kptr))
    }
}

// M29d: get index on array or array-like
Function.JSVM__ArrayLikeGet {
    Input: obj: Address
    Input: idx: Integer
    Output: Address
    Body: {
        save_o = obj
        save_i = idx
        ot = JSRT_GetType(save_o)
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSRT_ArrGet(save_o, save_i))
        }
        kptr = JSRT__IntToStr(save_i)
        ReturnValue(JSRT_ObjGet(save_o, kptr))
    }
}

// ─── forEach (150) — arr.forEach(callback[, thisArg]) ───
Function.JSVM__ArrForEach {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        // ToObject
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.forEach called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "callback is not a function")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        cb_func = Dereference(save_args)
        IfCondition NotEqual(JSRT_GetType(cb_func), JSType.FUNCTION) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "callback is not a function")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            this_arg = Dereference(Add(save_args, 8))
            JSVM__SetGlobal("this", this_arg)
        }
        arr_len = JSVM__ArrayLikeLen(save_recv)
        IfCondition LessThan(arr_len, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        i = 0
        WhileLoop LessThan(i, arr_len) {
            IfCondition NotEqual(JSVM__ArrayLikeHas(save_recv, i), 0) ThenBlock: {
                elem = JSVM__ArrayLikeGet(save_recv, i)
                idx_val = JSRT_CreateNumber(i)
