            SetByte(sk, 1, 95)
            SetByte(sk, 2, 115)
            SetByte(sk, 3, 101)
            SetByte(sk, 4, 116)
            SetByte(sk, 5, 95)
            SetByte(sk, 6, 108)
            SetByte(sk, 7, 101)
            SetByte(sk, 8, 110)
            SetByte(sk, 9, 103)
            SetByte(sk, 10, 116)
            SetByte(sk, 11, 104)
