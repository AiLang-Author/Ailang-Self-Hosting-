        // rewrites every key. Pool fields survive the pushes. Locals do not.
        JSArrMethodBuf.sort_kix = save_recv
        JSArrMethodBuf.sort_a = has_cmp
        JSArrMethodBuf.sort_b = cmp_func
        JSArrMethodBuf.sort_right = arr_len
        JSBridge__Push(JSArrMethodBuf.sort_kix)
        JSBridge__Push(JSArrMethodBuf.sort_kix)
        JSBridge__Push(JSArrMethodBuf.sort_a)
        JSBridge__Push(JSArrMethodBuf.sort_b)
        JSBridge__Push(JSArrMethodBuf.sort_right)
