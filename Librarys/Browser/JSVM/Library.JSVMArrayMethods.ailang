                IfCondition EqualTo(has_hi, 1) ThenBlock: {
                    b = JSVM__ArrayLikeGet(save_recv, hi)
                    JSVM__ArrayLikeDelete(save_recv, hi)
                    JSVM__ArrayLikeSet(save_recv, lo, b)
                }
            }
            lo = Add(lo, 1)
            hi = Subtract(hi, 1)
        }
        ReturnValue(save_recv)
    }
}

// ─── slice (163) — arr.slice(start?, end?) → new array ───
