                IfCondition EqualTo(JSRT_GetType(ret_c), JSType.ARRAY) ThenBlock: { bad_ta = 1 }
                IfCondition EqualTo(JSVM_IsTypedArray(ret_c), 0) ThenBlock: { bad_ta = 1 }
                IfCondition EqualTo(bad_ta, 1) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "species did not return a TypedArray")
                    JSVM__SetGlobal("__pend_exc__", terr)
                    JSVMCall.exc_prop = 1
                    JSVMCall.thrown_val = terr
                    JSVMState.exc_val = terr
                    ReturnValue(JSRT_Undefined())
