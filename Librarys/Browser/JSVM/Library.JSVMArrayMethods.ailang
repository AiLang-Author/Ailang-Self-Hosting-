        }
        start = 0
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            start = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(save_recv) }
            IfCondition LessThan(start, 0) ThenBlock: {
                start = Add(arr_len, start)
                IfCondition LessThan(start, 0) ThenBlock: { start = 0 }
            }
            IfCondition GreaterThan(start, arr_len) ThenBlock: { start = arr_len }
        }
        end = arr_len
        IfCondition GreaterEqual(save_argc, 3) ThenBlock: {
            end_v = Dereference(Add(save_args, 16))
            IfCondition NotEqual(JSRT_GetType(end_v), JSType.UNDEFINED) ThenBlock: {
                end = Float_ToInt(JSRT_ToNumber(end_v))
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(save_recv) }
                IfCondition LessThan(end, 0) ThenBlock: {
                    end = Add(arr_len, end)
                    IfCondition LessThan(end, 0) ThenBlock: { end = 0 }
                }
                IfCondition GreaterThan(end, arr_len) ThenBlock: { end = arr_len }
            }
        }
        i = start
        WhileLoop LessThan(i, end) {
            JSBridge__Push(save_recv)
            JSBridge__Push(fill_val)
            JSBridge__Push(i)
            JSBridge__Push(end)
            JSVM__ArrayLikeSet(save_recv, i, fill_val)
            end = JSBridge__Pop()
            i = JSBridge__Pop()
            fill_val = JSBridge__Pop()
            save_recv = JSBridge__Pop()
            i = Add(i, 1)
        }
        ReturnValue(save_recv)
    }
}

// ─── sort (169) — arr.sort(compareFn?) → same array (mutated) ───
// M128e7c5: ES SortIndexedProperties — collect present only, sort, write back;
// remaining indices become holes. comparefn must be undefined or callable.
// Insertion sort (stable). Array-like generic via ArrayToObject.
Function.JSVM__ArrSort {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.sort called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        save_recv = JSVM__ArrayToObject(save_recv)
        arr_len = JSVM__ArrayLikeLen(save_recv)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(save_recv) }
        IfCondition LessThan(arr_len, 0) ThenBlock: { arr_len = 0 }
        has_cmp = 0
        cmp_func = 0
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            cmp_func = Dereference(save_args)
            cmp_type = JSRT_GetType(cmp_func)
            IfCondition NotEqual(cmp_type, JSType.UNDEFINED) ThenBlock: {
                IfCondition NotEqual(cmp_type, JSType.FUNCTION) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "comparefn is not a function")
                    JSVM__SetGlobal("__pend_exc__", terr)
                    JSVMCall.exc_prop = 1
                    JSVMCall.thrown_val = terr
                    JSVM_ThrowValue(terr)
                    ReturnValue(save_recv)
                }
                has_cmp = 1
            }
        }
        IfCondition LessEqual(arr_len, 1) ThenBlock: { ReturnValue(save_recv) }
        // Collect present elements into items[] (skip holes)
        items = JSRT_CreateArray()
        i = 0
        WhileLoop LessThan(i, arr_len) {
            JSBridge__Push(save_recv)
            JSBridge__Push(items)
            JSBridge__Push(i)
            JSBridge__Push(arr_len)
            JSBridge__Push(has_cmp)
            JSBridge__Push(cmp_func)
            has = JSVM__ArrayLikeHas(save_recv, i)
            cmp_func = JSBridge__Pop()
            has_cmp = JSBridge__Pop()
            arr_len = JSBridge__Pop()
            i = JSBridge__Pop()
            items = JSBridge__Pop()
            save_recv = JSBridge__Pop()
            IfCondition EqualTo(has, 1) ThenBlock: {
                JSBridge__Push(save_recv)
                JSBridge__Push(items)
                JSBridge__Push(i)
                JSBridge__Push(arr_len)
                JSBridge__Push(has_cmp)
                JSBridge__Push(cmp_func)
                elem = JSVM__ArrayLikeGet(save_recv, i)
                cmp_func = JSBridge__Pop()
                has_cmp = JSBridge__Pop()
                arr_len = JSBridge__Pop()
                i = JSBridge__Pop()
                items = JSBridge__Pop()
                save_recv = JSBridge__Pop()
                JSRT_ArrPush(items, elem)
            }
            i = Add(i, 1)
        }
        n_items = JSRT_ArrLen(items)
        // Insertion sort items
        IfCondition GreaterThan(n_items, 1) ThenBlock: {
            i = 1
            WhileLoop LessThan(i, n_items) {
                key = JSRT_ArrGet(items, i)
                j = Subtract(i, 1)
                done = 0
                WhileLoop And(GreaterEqual(j, 0), EqualTo(done, 0)) {
                    cur = JSRT_ArrGet(items, j)
                    cmp_result = 0
                    IfCondition EqualTo(has_cmp, 1) ThenBlock: {
                        StoreValue(JSArrMethodBuf.arg0, cur)
                        StoreValue(Add(JSArrMethodBuf.arg0, 8), key)
                        // this for comparefn is undefined
                        save_this_s = JSVM__GetGlobal("this")
                        JSVM__SetGlobal("this", JSRTState.undef_val)
                        cmp_val = JSVM__CallFunc(cmp_func, JSArrMethodBuf.arg0, 2)
                        JSVM__SetGlobal("this", save_this_s)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            ReturnValue(save_recv)
                        }
                        cmp_result = Float_ToInt(JSRT_ToNumber(cmp_val))
                    } ElseBlock: {
                        // ES default: undefined sorts after; then ToString compare
                        cu = 0
                        ku = 0
                        IfCondition EqualTo(JSRT_GetType(cur), JSType.UNDEFINED) ThenBlock: { cu = 1 }
                        IfCondition EqualTo(JSRT_GetType(key), JSType.UNDEFINED) ThenBlock: { ku = 1 }
                        IfCondition And(EqualTo(cu, 1), EqualTo(ku, 1)) ThenBlock: {
                            cmp_result = 0
                        } ElseBlock: {
                            IfCondition EqualTo(cu, 1) ThenBlock: {
                                cmp_result = 1
                            } ElseBlock: {
                                IfCondition EqualTo(ku, 1) ThenBlock: {
                                    cmp_result = -1
                                } ElseBlock: {
                                    a_str = JSRT_ToString(cur)
                                    b_str = JSRT_ToString(key)
                                    a_ptr = JSRT_GetPayload(a_str)
                                    b_ptr = JSRT_GetPayload(b_str)
                                    cmp_result = JSRT_StrCmp(a_ptr, b_ptr)
                                }
                            }
                        }
                    }
                    IfCondition GreaterThan(cmp_result, 0) ThenBlock: {
                        JSRT_ArrSet(items, Add(j, 1), cur)
                        j = Subtract(j, 1)
                    } ElseBlock: {
                        done = 1
                    }
                }
                JSRT_ArrSet(items, Add(j, 1), key)
                i = Add(i, 1)
            }
        }
        // Write sorted present elements back; hole the rest
        i = 0
        WhileLoop LessThan(i, n_items) {
            v = JSRT_ArrGet(items, i)
            JSBridge__Push(save_recv)
            JSBridge__Push(items)
            JSBridge__Push(i)
            JSBridge__Push(arr_len)
            JSBridge__Push(n_items)
            JSVM__ArrayLikeSet(save_recv, i, v)
            n_items = JSBridge__Pop()
            arr_len = JSBridge__Pop()
            i = JSBridge__Pop()
            items = JSBridge__Pop()
            save_recv = JSBridge__Pop()
            i = Add(i, 1)
        }
        i = n_items
        WhileLoop LessThan(i, arr_len) {
            JSBridge__Push(save_recv)
            JSBridge__Push(i)
            JSBridge__Push(arr_len)
            JSVM__ArrayLikeDelete(save_recv, i)
            arr_len = JSBridge__Pop()
            i = JSBridge__Pop()
            save_recv = JSBridge__Pop()
            i = Add(i, 1)
        }
        ReturnValue(save_recv)
    }
}

// ─── flat (170) — arr.flat(depth?) → new flattened array ───
// M29h: ArraySpeciesCreate
Function.JSVM__ArrFlat {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.flat called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_CreateArray())
        }
        depth = 1
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            depth = Float_ToInt(JSRT_ToNumber(Dereference(save_args)))
        }
        result = JSVM__ArraySpeciesCreate(save_recv, 0)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(result) }
        // Flat helper expects ARRAY dest — fall back if species non-array
        IfCondition NotEqual(JSRT_GetType(result), JSType.ARRAY) ThenBlock: {
            result = JSRT_CreateArray()
        }
        JSVM__ArrFlatHelper(save_recv, result, depth)
        ReturnValue(result)
    }
}

Function.JSVM__ArrFlatHelper {
    Input: src: Address
    Input: dest: Address
    Input: depth: Integer
    Output: Integer
    Body: {
        save_src = src
        save_dest = dest
        save_depth = depth
        arr_len = JSRT_ArrLen(save_src)
        i = 0
        WhileLoop LessThan(i, arr_len) {
            elem = JSRT_ArrGet(save_src, i)
            elem_type = JSRT_GetType(elem)
            IfCondition And(EqualTo(elem_type, JSType.ARRAY), GreaterThan(save_depth, 0)) ThenBlock: {
                JSVM__ArrFlatHelper(elem, save_dest, Subtract(save_depth, 1))
            } ElseBlock: {
                JSRT_ArrPush(save_dest, elem)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// ─── flatMap (171) — map then flat depth 1 ───
// M29f/h: array-like + TypeError + ArraySpeciesCreate
Function.JSVM__ArrFlatMap {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.flatMap called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_CreateArray())
        }
        save_recv = JSVM__ArrayToObject(save_recv)
        // M44: ToLength before IsCallable
        arr_len = JSVM__ArrayLikeLen(save_recv)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSRT_CreateArray())
        }
        IfCondition LessThan(arr_len, 0) ThenBlock: { ReturnValue(JSRT_CreateArray()) }
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "callback is not a function")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_CreateArray())
        }
        cb_func = Dereference(save_args)
        IfCondition NotEqual(JSRT_GetType(cb_func), JSType.FUNCTION) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "callback is not a function")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_CreateArray())
        }
        this_arg = JSRT_Undefined()
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            this_arg = Dereference(Add(save_args, 8))
        }
        JSVM__SetGlobal("this", this_arg)
        result = JSVM__ArraySpeciesCreate(save_recv, 0)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(result) }
        IfCondition NotEqual(JSRT_GetType(result), JSType.ARRAY) ThenBlock: {
            result = JSRT_CreateArray()
        }
        i = 0
        WhileLoop LessThan(i, arr_len) {
            IfCondition NotEqual(JSVM__ArrayLikeHas(save_recv, i), 0) ThenBlock: {
                elem = JSVM__ArrayLikeGet(save_recv, i)
                idx_val = JSRT_CreateNumber(i)
                StoreValue(JSArrMethodBuf.arg0, elem)
                StoreValue(Add(JSArrMethodBuf.arg0, 8), idx_val)
                StoreValue(Add(JSArrMethodBuf.arg0, 16), save_recv)
                mapped = JSVM__CallFunc(cb_func, JSArrMethodBuf.arg0, 3)
                // flatten one level: if array, push elements; else push mapped
                IfCondition EqualTo(JSRT_GetType(mapped), JSType.ARRAY) ThenBlock: {
                    mlen = JSRT_ArrLen(mapped)
                    mi = 0
                    WhileLoop LessThan(mi, mlen) {
                        JSRT_ArrPush(result, JSRT_ArrGet(mapped, mi))
                        mi = Add(mi, 1)
                    }
                } ElseBlock: {
                    JSRT_ArrPush(result, mapped)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(result)
    }
}

// ─── findLast (177) — arr.findLast(callback[, thisArg]) ───
Function.JSVM__ArrFindLast {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.findLast called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        save_recv = JSVM__ArrayToObject(save_recv)
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "callback is not a function")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        cb_func = Dereference(save_args)
        IfCondition NotEqual(JSRT_GetType(cb_func), JSType.FUNCTION) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "callback is not a function")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            this_arg = Dereference(Add(save_args, 8))
            JSVM__SetGlobal("this", this_arg)
        }
        arr_len = JSVM__ArrayLikeLen(save_recv)
        IfCondition LessThan(arr_len, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        i = Subtract(arr_len, 1)
        WhileLoop GreaterEqual(i, 0) {
            // find visits holes as undefined
            elem = JSVM__ArrayLikeGet(save_recv, i)
            IfCondition EqualTo(JSVM__ArrayLikeHas(save_recv, i), 0) ThenBlock: {
                elem = JSRT_Undefined()
            }
            idx_val = JSRT_CreateNumber(i)
            StoreValue(JSArrMethodBuf.arg0, elem)
            StoreValue(Add(JSArrMethodBuf.arg0, 8), idx_val)
            StoreValue(Add(JSArrMethodBuf.arg0, 16), save_recv)
            pred = JSVM__CallFunc(cb_func, JSArrMethodBuf.arg0, 3)
            IfCondition EqualTo(JSRT_IsTruthy(pred), 1) ThenBlock: {
                ReturnValue(elem)
            }
            i = Subtract(i, 1)
        }
        ReturnValue(JSRT_Undefined())
    }
}

// ─── findLastIndex (178) ───
Function.JSVM__ArrFindLastIndex {
    Input: recv: Address
