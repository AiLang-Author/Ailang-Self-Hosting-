    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.indexOf called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_CreateNumber(-1))
        }
        IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_CreateNumber(-1)) }
        search = Dereference(save_args)
        arr_len = JSVM__ArrayLikeLen(save_recv)
        IfCondition LessThan(arr_len, 0) ThenBlock: { ReturnValue(JSRT_CreateNumber(-1)) }
        from = 0
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            from = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
            IfCondition LessThan(from, 0) ThenBlock: {
                from = Add(arr_len, from)
                IfCondition LessThan(from, 0) ThenBlock: { from = 0 }
            }
        }
        i = from
        WhileLoop LessThan(i, arr_len) {
            IfCondition NotEqual(JSVM__ArrayLikeHas(save_recv, i), 0) ThenBlock: {
                elem = JSVM__ArrayLikeGet(save_recv, i)
                eq = JSRT_StrictEqual(elem, search)
                IfCondition EqualTo(eq, 1) ThenBlock: {
                    ReturnValue(JSRT_CreateNumber(i))
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(JSRT_CreateNumber(-1))
    }
}

// ─── lastIndexOf (159) — arr.lastIndexOf(searchElement, fromIndex?) ───
// M29f: array-like + null/undefined TypeError
Function.JSVM__ArrLastIndexOf {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.lastIndexOf called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_CreateNumber(-1))
        }
        IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_CreateNumber(-1)) }
        search = Dereference(save_args)
        arr_len = JSVM__ArrayLikeLen(save_recv)
        IfCondition LessThan(arr_len, 0) ThenBlock: { ReturnValue(JSRT_CreateNumber(-1)) }
        from = Subtract(arr_len, 1)
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            from = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
            IfCondition LessThan(from, 0) ThenBlock: {
                from = Add(arr_len, from)
            }
            IfCondition GreaterEqual(from, arr_len) ThenBlock: {
                from = Subtract(arr_len, 1)
            }
        }
        i = from
        WhileLoop GreaterEqual(i, 0) {
            IfCondition NotEqual(JSVM__ArrayLikeHas(save_recv, i), 0) ThenBlock: {
                elem = JSVM__ArrayLikeGet(save_recv, i)
                eq = JSRT_StrictEqual(elem, search)
                IfCondition EqualTo(eq, 1) ThenBlock: {
                    ReturnValue(JSRT_CreateNumber(i))
                }
            }
            i = Subtract(i, 1)
        }
        ReturnValue(JSRT_CreateNumber(-1))
    }
}

// ─── includes (160) — arr.includes(searchElement, fromIndex?) → boolean ───
// M29f/g: array-like + TypeError; SameValueZero (NaN); Get every index
Function.JSVM__ArrIncludes {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.includes called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRTState.false_val)
        }
        IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRTState.false_val) }
        search = Dereference(save_args)
        arr_len = JSVM__ArrayLikeLen(save_recv)
        IfCondition LessThan(arr_len, 0) ThenBlock: { ReturnValue(JSRTState.false_val) }
        from = 0
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            from = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
            IfCondition LessThan(from, 0) ThenBlock: {
                from = Add(arr_len, from)
                IfCondition LessThan(from, 0) ThenBlock: { from = 0 }
            }
        }
        i = from
        WhileLoop LessThan(i, arr_len) {
            // ES: Get every index (holes → undefined); SameValueZero
            elem = JSVM__ArrayLikeGet(save_recv, i)
            eq = JSRT_SameValueZero(elem, search)
            IfCondition EqualTo(eq, 1) ThenBlock: {
                ReturnValue(JSRTState.true_val)
            }
            i = Add(i, 1)
        }
        ReturnValue(JSRTState.false_val)
    }
}

// ─── join (161) — arr.join(separator?) → string ───
Function.JSVM__ArrJoin {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        arr_len = JSRT_ArrLen(save_recv)
        IfCondition EqualTo(arr_len, 0) ThenBlock: { ReturnValue(JSRT_CreateString("")) }
        // Get separator (default ",")
        sep_ptr = ","
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            sep_arg = Dereference(save_args)
            sep_type = JSRT_GetType(sep_arg)
            IfCondition NotEqual(sep_type, JSType.UNDEFINED) ThenBlock: {
                sep_str = JSRT_ToString(sep_arg)
                sep_ptr = JSRT_GetPayload(sep_str)
            }
        }
        sep_len = StringLength(sep_ptr)
        // Build result in str_work_buf (4096 bytes)
        out = JSRTState.str_work_buf
        out_pos = 0
        max_out = 4000
        i = 0
        WhileLoop LessThan(i, arr_len) {
            IfCondition GreaterThan(i, 0) ThenBlock: {
                // Append separator
                si = 0
                WhileLoop LessThan(si, sep_len) {
                    IfCondition LessThan(out_pos, max_out) ThenBlock: {
                        SetByte(out, out_pos, GetByte(sep_ptr, si))
                        out_pos = Add(out_pos, 1)
                    }
                    si = Add(si, 1)
                }
            }
            elem = JSRT_ArrGet(save_recv, i)
            elem_type = JSRT_GetType(elem)
            // Skip null/undefined (JS spec: they become empty string)
            IfCondition NotEqual(elem_type, JSType.NULL) ThenBlock: {
                IfCondition NotEqual(elem_type, JSType.UNDEFINED) ThenBlock: {
                    elem_str = JSRT_ToString(elem)
                    elem_ptr = JSRT_GetPayload(elem_str)
                    elem_len = StringLength(elem_ptr)
                    ei = 0
                    WhileLoop LessThan(ei, elem_len) {
                        IfCondition LessThan(out_pos, max_out) ThenBlock: {
                            SetByte(out, out_pos, GetByte(elem_ptr, ei))
                            out_pos = Add(out_pos, 1)
                        }
                        ei = Add(ei, 1)
                    }
                }
            }
            i = Add(i, 1)
        }
        SetByte(out, out_pos, 0)
        ReturnValue(JSRT_CreateString(out))
    }
}

// ─── reverse (162) — arr.reverse() → same array (mutated) ───
Function.JSVM__ArrReverse {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        arr_len = JSRT_ArrLen(save_recv)
        lo = 0
        hi = Subtract(arr_len, 1)
        WhileLoop LessThan(lo, hi) {
            a = JSRT_ArrGet(save_recv, lo)
            b = JSRT_ArrGet(save_recv, hi)
            JSRT_ArrSet(save_recv, lo, b)
            JSRT_ArrSet(save_recv, hi, a)
            lo = Add(lo, 1)
            hi = Subtract(hi, 1)
        }
        ReturnValue(save_recv)
    }
}

// ─── slice (163) — arr.slice(start?, end?) → new array ───
Function.JSVM__ArrSlice {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        arr_len = JSRT_ArrLen(save_recv)
        result = JSRT_CreateArray()
        // Parse start
        start = 0
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            start = Float_ToInt(JSRT_ToNumber(Dereference(save_args)))
            IfCondition LessThan(start, 0) ThenBlock: {
                start = Add(arr_len, start)
                IfCondition LessThan(start, 0) ThenBlock: { start = 0 }
            }
            IfCondition GreaterThan(start, arr_len) ThenBlock: { start = arr_len }
        }
        // Parse end
        end = arr_len
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            end = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
            IfCondition LessThan(end, 0) ThenBlock: {
                end = Add(arr_len, end)
                IfCondition LessThan(end, 0) ThenBlock: { end = 0 }
            }
            IfCondition GreaterThan(end, arr_len) ThenBlock: { end = arr_len }
        }
        i = start
        WhileLoop LessThan(i, end) {
            elem = JSRT_ArrGet(save_recv, i)
            JSRT_ArrPush(result, elem)
            i = Add(i, 1)
        }
        ReturnValue(result)
    }
}

// ─── concat (164) — arr.concat(value1, value2, ...) → new array ───
Function.JSVM__ArrConcat {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        result = JSRT_CreateArray()
        // Copy receiver elements
        arr_len = JSRT_ArrLen(save_recv)
        i = 0
        WhileLoop LessThan(i, arr_len) {
            JSRT_ArrPush(result, JSRT_ArrGet(save_recv, i))
            i = Add(i, 1)
        }
        // Process each argument
        ai = 0
        WhileLoop LessThan(ai, save_argc) {
            arg = Dereference(Add(save_args, Multiply(ai, 8)))
            arg_type = JSRT_GetType(arg)
            IfCondition EqualTo(arg_type, JSType.ARRAY) ThenBlock: {
                // Spread array elements
                al = JSRT_ArrLen(arg)
                j = 0
                WhileLoop LessThan(j, al) {
                    JSRT_ArrPush(result, JSRT_ArrGet(arg, j))
                    j = Add(j, 1)
                }
            } ElseBlock: {
                // Single value
                JSRT_ArrPush(result, arg)
            }
            ai = Add(ai, 1)
        }
        ReturnValue(result)
    }
}

// ─── shift (165) — arr.shift() → removed first element ───
Function.JSVM__ArrShift {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        arr_len = JSRT_ArrLen(save_recv)
        IfCondition EqualTo(arr_len, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        first = JSRT_ArrGet(save_recv, 0)
        // Shift elements left
        i = 1
        WhileLoop LessThan(i, arr_len) {
            JSRT_ArrSet(save_recv, Subtract(i, 1), JSRT_ArrGet(save_recv, i))
            i = Add(i, 1)
        }
        JSRT_ArrPop(save_recv)
        ReturnValue(first)
    }
}

// ─── unshift (166) — arr.unshift(elem1, ...) → new length ───
Function.JSVM__ArrUnshift {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        IfCondition EqualTo(save_argc, 0) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(JSRT_ArrLen(save_recv)))
        }
        arr_len = JSRT_ArrLen(save_recv)
        // Push N undefined slots to grow the array
        pi = 0
        WhileLoop LessThan(pi, save_argc) {
            JSRT_ArrPush(save_recv, JSRT_Undefined())
            pi = Add(pi, 1)
        }
        // Shift existing elements right by argc positions
        i = Subtract(Add(arr_len, save_argc), 1)
        WhileLoop GreaterEqual(i, save_argc) {
            JSRT_ArrSet(save_recv, i, JSRT_ArrGet(save_recv, Subtract(i, save_argc)))
            i = Subtract(i, 1)
        }
        // Insert new elements at the front
        i = 0
        WhileLoop LessThan(i, save_argc) {
            new_elem = Dereference(Add(save_args, Multiply(i, 8)))
            JSRT_ArrSet(save_recv, i, new_elem)
            i = Add(i, 1)
        }
        new_len = JSRT_ArrLen(save_recv)
        ReturnValue(JSRT_CreateNumber(new_len))
    }
}

// ─── splice (167) — arr.splice(start, deleteCount, ...items) → removed array ───
Function.JSVM__ArrSplice {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        arr_len = JSRT_ArrLen(save_recv)
        removed = JSRT_CreateArray()
        IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(removed) }
        // Parse start
        start = Float_ToInt(JSRT_ToNumber(Dereference(save_args)))
        IfCondition LessThan(start, 0) ThenBlock: {
            start = Add(arr_len, start)
            IfCondition LessThan(start, 0) ThenBlock: { start = 0 }
        }
        IfCondition GreaterThan(start, arr_len) ThenBlock: { start = arr_len }
        // Parse deleteCount
        del_count = Subtract(arr_len, start)
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            del_count = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
            IfCondition LessThan(del_count, 0) ThenBlock: { del_count = 0 }
            IfCondition GreaterThan(del_count, Subtract(arr_len, start)) ThenBlock: {
                del_count = Subtract(arr_len, start)
            }
        }
        // Collect removed elements
        ri = 0
        WhileLoop LessThan(ri, del_count) {
            JSRT_ArrPush(removed, JSRT_ArrGet(save_recv, Add(start, ri)))
            ri = Add(ri, 1)
        }
        // Count items to insert (argc - 2)
        insert_count = 0
        IfCondition GreaterThan(save_argc, 2) ThenBlock: {
            insert_count = Subtract(save_argc, 2)
        }
        // Shift tail elements
        tail_start = Add(start, del_count)
        new_tail_start = Add(start, insert_count)
        diff = Subtract(insert_count, del_count)
        // Grow or shrink
        IfCondition GreaterThan(diff, 0) ThenBlock: {
            // Grow: push placeholders, shift right
            gi = 0
            WhileLoop LessThan(gi, diff) {
                JSRT_ArrPush(save_recv, JSRT_Undefined())
                gi = Add(gi, 1)
            }
            new_len = JSRT_ArrLen(save_recv)
            mi = Subtract(new_len, 1)
            WhileLoop GreaterEqual(mi, new_tail_start) {
                src_idx = Subtract(mi, diff)
                IfCondition GreaterEqual(src_idx, tail_start) ThenBlock: {
                    JSRT_ArrSet(save_recv, mi, JSRT_ArrGet(save_recv, src_idx))
                }
                mi = Subtract(mi, 1)
            }
        }
        IfCondition LessThan(diff, 0) ThenBlock: {
            // Shrink: shift left, then pop
            si = tail_start
            new_arr_len = Add(arr_len, diff)
            WhileLoop LessThan(si, arr_len) {
                dst = Add(si, diff)
                IfCondition GreaterEqual(dst, 0) ThenBlock: {
                    JSRT_ArrSet(save_recv, dst, JSRT_ArrGet(save_recv, si))
                }
                si = Add(si, 1)
            }
            // Pop the excess
            pop_count = Subtract(0, diff)
            pi = 0
            WhileLoop LessThan(pi, pop_count) {
                JSRT_ArrPop(save_recv)
                pi = Add(pi, 1)
            }
        }
        // Insert new items
        ii = 0
        WhileLoop LessThan(ii, insert_count) {
            item = Dereference(Add(save_args, Multiply(Add(ii, 2), 8)))
            JSRT_ArrSet(save_recv, Add(start, ii), item)
            ii = Add(ii, 1)
        }
        ReturnValue(removed)
    }
}

// ─── fill (168) — arr.fill(value, start?, end?) → same array ───
Function.JSVM__ArrFill {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        arr_len = JSRT_ArrLen(save_recv)
        fill_val = JSRT_Undefined()
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            fill_val = Dereference(save_args)
        }
        start = 0
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            start = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
            IfCondition LessThan(start, 0) ThenBlock: {
                start = Add(arr_len, start)
                IfCondition LessThan(start, 0) ThenBlock: { start = 0 }
            }
        }
        end = arr_len
        IfCondition GreaterEqual(save_argc, 3) ThenBlock: {
            end = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 16))))
            IfCondition LessThan(end, 0) ThenBlock: {
                end = Add(arr_len, end)
                IfCondition LessThan(end, 0) ThenBlock: { end = 0 }
            }
            IfCondition GreaterThan(end, arr_len) ThenBlock: { end = arr_len }
        }
        i = start
        WhileLoop LessThan(i, end) {
            JSRT_ArrSet(save_recv, i, fill_val)
            i = Add(i, 1)
        }
        ReturnValue(save_recv)
    }
}

// ─── sort (169) — arr.sort(compareFn?) → same array (mutated) ───
// Insertion sort — simple, stable, O(n^2) but fine for typical JS array sizes
Function.JSVM__ArrSort {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        arr_len = JSRT_ArrLen(save_recv)
        IfCondition LessEqual(arr_len, 1) ThenBlock: { ReturnValue(save_recv) }
        has_cmp = 0
        cmp_func = 0
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            cmp_func = Dereference(save_args)
            cmp_type = JSRT_GetType(cmp_func)
            IfCondition EqualTo(cmp_type, JSType.FUNCTION) ThenBlock: {
                has_cmp = 1
            }
        }
        // Insertion sort
        i = 1
        WhileLoop LessThan(i, arr_len) {
            key = JSRT_ArrGet(save_recv, i)
            j = Subtract(i, 1)
            done = 0
            WhileLoop And(GreaterEqual(j, 0), EqualTo(done, 0)) {
                cur = JSRT_ArrGet(save_recv, j)
                // Compare
                cmp_result = 0
                IfCondition EqualTo(has_cmp, 1) ThenBlock: {
                    StoreValue(JSArrMethodBuf.arg0, cur)
                    StoreValue(Add(JSArrMethodBuf.arg0, 8), key)
                    cmp_val = JSVM__CallFunc(cmp_func, JSArrMethodBuf.arg0, 2)
                    cmp_result = Float_ToInt(JSRT_ToNumber(cmp_val))
                } ElseBlock: {
                    // Default: toString comparison
                    a_str = JSRT_ToString(cur)
                    b_str = JSRT_ToString(key)
                    a_ptr = JSRT_GetPayload(a_str)
                    b_ptr = JSRT_GetPayload(b_str)
                    cmp_result = StringCompare(a_ptr, b_ptr)
                }
                IfCondition GreaterThan(cmp_result, 0) ThenBlock: {
                    JSRT_ArrSet(save_recv, Add(j, 1), cur)
                    j = Subtract(j, 1)
                } ElseBlock: {
                    done = 1
                }
            }
            JSRT_ArrSet(save_recv, Add(j, 1), key)
            i = Add(i, 1)
        }
        ReturnValue(save_recv)
    }
}

// ─── flat (170) — arr.flat(depth?) → new flattened array ───
Function.JSVM__ArrFlat {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        depth = 1
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            depth = Float_ToInt(JSRT_ToNumber(Dereference(save_args)))
        }
        result = JSRT_CreateArray()
        JSVM__ArrFlatHelper(save_recv, result, depth)
        ReturnValue(result)
    }
}

Function.JSVM__ArrFlatHelper {
    Input: src: Address
    Input: dest: Address
    Input: depth: Integer
    Output: Integer
    Body: {
        save_src = src
        save_dest = dest
        save_depth = depth
        arr_len = JSRT_ArrLen(save_src)
        i = 0
        WhileLoop LessThan(i, arr_len) {
            elem = JSRT_ArrGet(save_src, i)
            elem_type = JSRT_GetType(elem)
            IfCondition And(EqualTo(elem_type, JSType.ARRAY), GreaterThan(save_depth, 0)) ThenBlock: {
                JSVM__ArrFlatHelper(elem, save_dest, Subtract(save_depth, 1))
            } ElseBlock: {
                JSRT_ArrPush(save_dest, elem)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// ─── flatMap (171) — map then flat depth 1 ───
// M29f: array-like + TypeError
Function.JSVM__ArrFlatMap {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        result = JSRT_CreateArray()
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.flatMap called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(result)
        }
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "callback is not a function")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(result)
        }
        cb_func = Dereference(save_args)
        IfCondition NotEqual(JSRT_GetType(cb_func), JSType.FUNCTION) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "callback is not a function")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(result)
        }
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            this_arg = Dereference(Add(save_args, 8))
            JSVM__SetGlobal("this", this_arg)
        }
        arr_len = JSVM__ArrayLikeLen(save_recv)
        IfCondition LessThan(arr_len, 0) ThenBlock: { ReturnValue(result) }
        i = 0
        WhileLoop LessThan(i, arr_len) {
            IfCondition NotEqual(JSVM__ArrayLikeHas(save_recv, i), 0) ThenBlock: {
                elem = JSVM__ArrayLikeGet(save_recv, i)
                idx_val = JSRT_CreateNumber(i)
                StoreValue(JSArrMethodBuf.arg0, elem)
                StoreValue(Add(JSArrMethodBuf.arg0, 8), idx_val)
                StoreValue(Add(JSArrMethodBuf.arg0, 16), save_recv)
                mapped = JSVM__CallFunc(cb_func, JSArrMethodBuf.arg0, 3)
                // flatten one level: if array, push elements; else push mapped
                IfCondition EqualTo(JSRT_GetType(mapped), JSType.ARRAY) ThenBlock: {
                    mlen = JSRT_ArrLen(mapped)
                    mi = 0
                    WhileLoop LessThan(mi, mlen) {
                        JSRT_ArrPush(result, JSRT_ArrGet(mapped, mi))
                        mi = Add(mi, 1)
                    }
                } ElseBlock: {
                    JSRT_ArrPush(result, mapped)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(result)
    }
}
