            // (undefined is allowed → defaultConstructor)
            IfCondition And(NotEqual(ct, JSType.UNDEFINED), EqualTo(is_ctor_obj, 0)) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "constructor is not an object")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVMState.exc_val = terr
                ReturnValue(JSRT_Undefined())
            }
            IfCondition And(EqualTo(is_ctor_obj, 1), NotEqual(JSVMSymbol.species, 0)) ThenBlock: {
                sk = JSVM_SymbolToKey(JSVMSymbol.species)
                JSRT__Push(save_o)
                JSRT__Push(save_len)
                JSRT__Push(kind_sc)
                JSRT__Push(es_sc)
                JSRT__Push(ctor)
                species = JSVM__GetProperty(ctor, sk)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ctor = JSRT__Pop()
                    es_sc = JSRT__Pop()
                    kind_sc = JSRT__Pop()
                    save_len = JSRT__Pop()
                    save_o = JSRT__Pop()
                    ReturnValue(JSRT_Undefined())
                }
                ctor = JSRT__Pop()
                es_sc = JSRT__Pop()
                kind_sc = JSRT__Pop()
                save_len = JSRT__Pop()
                save_o = JSRT__Pop()
                st = JSRT_GetType(species)
                used_species = 1
                // null/undefined → default constructor path below
                IfCondition Or(EqualTo(st, JSType.NULL), EqualTo(st, JSType.UNDEFINED)) ThenBlock: {
                    used_species = 2
                } ElseBlock: {
                    ctor = species
                }
            }
            // used_species 2 or no species → default same-kind
            IfCondition Or(EqualTo(used_species, 2), EqualTo(used_species, 0)) ThenBlock: {
                IfCondition EqualTo(used_species, 0) ThenBlock: {
                    // constructor missing/undefined: still default
                    IfCondition EqualTo(ct, JSType.UNDEFINED) ThenBlock: {
                        ab = JSVM_ArrayBufferCreate(Multiply(save_len, es_sc))
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
                        ta = JSVM_TypedArrayCreate(kind_sc, ab, 0, save_len)
                        pr = JSRT_ObjGet(save_o, "__proto__")
                        IfCondition EqualTo(JSRT_GetType(pr), JSType.OBJECT) ThenBlock: {
                            JSRT_ObjSet(ta, "__proto__", pr)
                        }
                        ReturnValue(ta)
                    }
