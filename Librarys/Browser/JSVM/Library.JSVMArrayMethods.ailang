// Library.JSVMArrayMethods.ailang — Array method matching and dispatch
// Split from Library.JSVM.ailang. FixedPools declared in root file.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// =============================================================================
// ARRAY METHOD NAME MATCHING — returns JSNativeID or 0
// Byte values: a=97 c=99 d=100 e=101 f=102 g=103 h=104 i=105 j=106
//   k=107 l=108 m=109 n=110 o=111 p=112 r=114 s=115 t=116 u=117 v=118
//   x=120 y=121 A=65 C=67 E=69 F=70 I=73 L=76 M=77 O=79 R=82 S=83
// =============================================================================
Function.JSVM__MatchArrayMethod {
    Input: name: Address
    Output: Integer
    Body: {
        save_name = name
        // M31e: method names may be UTF-16 JS strings
        c0 = JSRT_StrUnit(save_name, 0)

        // ── 'a' methods: at ──
        IfCondition EqualTo(c0, 97) ThenBlock: {
            // at = 97 116 0
            IfCondition EqualTo(JSRT_StrUnit(save_name, 1), 116) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 0) ThenBlock: {
                    ReturnValue(JSNativeID.ARR_AT)
                }
            }
        }

        // ── 'c' methods: concat, copyWithin ──
        IfCondition EqualTo(c0, 99) ThenBlock: {
            // concat = 99 111 110 99 97 116 0
            IfCondition EqualTo(JSRT_StrUnit(save_name, 1), 111) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 110) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 99) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 97) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 116) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 0) ThenBlock: {
                                    ReturnValue(JSNativeID.ARR_CONCAT)
                                }
                            }
                        }
                    }
                }
                // copyWithin = 99 111 112 121 87 105 116 104 105 110 0
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 112) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 121) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 87) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 105) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 116) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 104) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 105) ThenBlock: {
                                            IfCondition EqualTo(JSRT_StrUnit(save_name, 9), 110) ThenBlock: {
                                                IfCondition EqualTo(JSRT_StrUnit(save_name, 10), 0) ThenBlock: {
                                                    ReturnValue(JSNativeID.ARR_COPY_WITHIN)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 'e' methods: every ──
        IfCondition EqualTo(c0, 101) ThenBlock: {
            // every = 101 118 101 114 121 0
            IfCondition EqualTo(JSRT_StrUnit(save_name, 1), 118) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 101) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 114) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 121) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 0) ThenBlock: {
                                ReturnValue(JSNativeID.ARR_EVERY)
                            }
                        }
                    }
                }
            }
        }

        // ── 'f' methods: forEach, filter, find, findIndex, fill, flat, flatMap ──
        IfCondition EqualTo(c0, 102) ThenBlock: {
            c1 = JSRT_StrUnit(save_name, 1)
            // forEach = 102 111 114 69 97 99 104 0
            IfCondition EqualTo(c1, 111) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 114) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 69) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 97) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 99) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 104) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 0) ThenBlock: {
                                        ReturnValue(JSNativeID.ARR_FOR_EACH)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // filter = 102 105 108 116 101 114 0
            IfCondition EqualTo(c1, 105) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 108) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 116) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 101) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 114) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 0) ThenBlock: {
                                    ReturnValue(JSNativeID.ARR_FILTER)
                                }
                            }
                        }
                    }
                }
                // find = 102 105 110 100 0
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 110) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 100) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.ARR_FIND)
                        }
                        // findIndex = 102 105 110 100 73 110 100 101 120 0
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 73) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 110) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 100) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 101) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 120) ThenBlock: {
                                            IfCondition EqualTo(JSRT_StrUnit(save_name, 9), 0) ThenBlock: {
                                                ReturnValue(JSNativeID.ARR_FIND_INDEX)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // findLast = 102 105 110 100 76 97 115 116 0
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 76) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 97) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 115) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 116) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 0) ThenBlock: {
                                            ReturnValue(JSNativeID.ARR_FIND_LAST)
                                        }
                                        // findLastIndex
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 73) ThenBlock: {
                                            IfCondition EqualTo(JSRT_StrUnit(save_name, 9), 110) ThenBlock: {
                                                IfCondition EqualTo(JSRT_StrUnit(save_name, 10), 100) ThenBlock: {
                                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 11), 101) ThenBlock: {
                                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 12), 120) ThenBlock: {
                                                            IfCondition EqualTo(JSRT_StrUnit(save_name, 13), 0) ThenBlock: {
                                                                ReturnValue(JSNativeID.ARR_FIND_LAST_INDEX)
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // fill = 102 105 108 108 0
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 108) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 108) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.ARR_FILL)
                        }
                    }
                }
            }
            // flat = 102 108 97 116 0
            IfCondition EqualTo(c1, 108) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 97) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 116) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.ARR_FLAT)
                        }
                        // flatMap = 102 108 97 116 77 97 112 0
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 77) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 97) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 112) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 0) ThenBlock: {
                                        ReturnValue(JSNativeID.ARR_FLAT_MAP)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 'i' methods: indexOf, includes ──
        IfCondition EqualTo(c0, 105) ThenBlock: {
            c1 = JSRT_StrUnit(save_name, 1)
            // indexOf = 105 110 100 101 120 79 102 0
            IfCondition EqualTo(c1, 110) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 100) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 101) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 120) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 79) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 102) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 0) ThenBlock: {
                                        ReturnValue(JSNativeID.ARR_INDEX_OF)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // includes = 105 110 99 108 117 100 101 115 0
            IfCondition EqualTo(c1, 110) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 99) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 108) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 117) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 100) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 101) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 115) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 0) ThenBlock: {
                                            ReturnValue(JSNativeID.ARR_INCLUDES)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 'j' methods: join ──
        IfCondition EqualTo(c0, 106) ThenBlock: {
            // join = 106 111 105 110 0
            IfCondition EqualTo(JSRT_StrUnit(save_name, 1), 111) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 105) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 110) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.ARR_JOIN)
                        }
                    }
                }
            }
        }

        // ── 'l' methods: lastIndexOf ──
        IfCondition EqualTo(c0, 108) ThenBlock: {
            // lastIndexOf = 108 97 115 116 73 110 100 101 120 79 102 0
            IfCondition EqualTo(JSRT_StrUnit(save_name, 1), 97) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 115) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 116) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 73) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 110) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 100) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 101) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 120) ThenBlock: {
                                            IfCondition EqualTo(JSRT_StrUnit(save_name, 9), 79) ThenBlock: {
                                                IfCondition EqualTo(JSRT_StrUnit(save_name, 10), 102) ThenBlock: {
                                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 11), 0) ThenBlock: {
                                                        ReturnValue(JSNativeID.ARR_LAST_INDEX_OF)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 'm' methods: map ──
        IfCondition EqualTo(c0, 109) ThenBlock: {
            // map = 109 97 112 0
            IfCondition EqualTo(JSRT_StrUnit(save_name, 1), 97) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 112) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 0) ThenBlock: {
                        ReturnValue(JSNativeID.ARR_MAP)
                    }
                }
            }
        }

        // ── 'p' methods: push, pop ──
        IfCondition EqualTo(c0, 112) ThenBlock: {
            // push = 112 117 115 104 0
            IfCondition EqualTo(JSRT_StrUnit(save_name, 1), 117) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 115) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 104) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.ARR_PUSH)
                        }
                    }
                }
            }
            // pop = 112 111 112 0
            IfCondition EqualTo(JSRT_StrUnit(save_name, 1), 111) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 112) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 0) ThenBlock: {
                        ReturnValue(JSNativeID.ARR_POP)
                    }
                }
            }
        }

        // ── 'r' methods: reduce, reduceRight, reverse ──
        IfCondition EqualTo(c0, 114) ThenBlock: {
            c1 = JSRT_StrUnit(save_name, 1)
            // reduce = 114 101 100 117 99 101 0
            // reduceRight = 114 101 100 117 99 101 82 105 103 104 116 0
            IfCondition EqualTo(c1, 101) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 100) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 117) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 99) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 101) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 0) ThenBlock: {
                                    ReturnValue(JSNativeID.ARR_REDUCE)
                                }
                                // reduceRight
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 82) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 105) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 103) ThenBlock: {
                                            IfCondition EqualTo(JSRT_StrUnit(save_name, 9), 104) ThenBlock: {
                                                IfCondition EqualTo(JSRT_StrUnit(save_name, 10), 116) ThenBlock: {
                                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 11), 0) ThenBlock: {
                                                        ReturnValue(JSNativeID.ARR_REDUCE_RIGHT)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // reverse = 114 101 118 101 114 115 101 0
                }
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 118) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 101) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 114) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 115) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 101) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 0) ThenBlock: {
                                        ReturnValue(JSNativeID.ARR_REVERSE)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 's' methods: slice, splice, sort, shift, some ──
        IfCondition EqualTo(c0, 115) ThenBlock: {
            c1 = JSRT_StrUnit(save_name, 1)
            // slice = 115 108 105 99 101 0
            IfCondition EqualTo(c1, 108) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 105) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 99) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 101) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 0) ThenBlock: {
                                ReturnValue(JSNativeID.ARR_SLICE)
                            }
                        }
                    }
                }
            }
            // splice = 115 112 108 105 99 101 0
            IfCondition EqualTo(c1, 112) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 108) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 105) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 99) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 101) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 0) ThenBlock: {
                                    ReturnValue(JSNativeID.ARR_SPLICE)
                                }
                            }
                        }
                    }
                }
            }
            // sort = 115 111 114 116 0
            IfCondition EqualTo(c1, 111) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 114) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 116) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.ARR_SORT)
                        }
                    }
                }
                // some = 115 111 109 101 0
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 109) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 101) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.ARR_SOME)
                        }
                    }
                }
            }
            // shift = 115 104 105 102 116 0
            IfCondition EqualTo(c1, 104) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 105) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 102) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 116) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 0) ThenBlock: {
                                ReturnValue(JSNativeID.ARR_SHIFT)
                            }
                        }
                    }
                }
            }
        }

        // ── 'u' methods: unshift ──
        IfCondition EqualTo(c0, 117) ThenBlock: {
            // unshift = 117 110 115 104 105 102 116 0
            IfCondition EqualTo(JSRT_StrUnit(save_name, 1), 110) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 115) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 104) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 105) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 102) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 116) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 0) ThenBlock: {
                                        ReturnValue(JSNativeID.ARR_UNSHIFT)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 't' methods: toReversed, toSorted, toSpliced (ES2023) ──
        IfCondition EqualTo(c0, 116) ThenBlock: {
            // to… = 116 111 …
            IfCondition EqualTo(JSRT_StrUnit(save_name, 1), 111) ThenBlock: {
                // toReversed = 116 111 82 101 118 101 114 115 101 100 0
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 82) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 101) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 118) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 101) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 114) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 115) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 101) ThenBlock: {
                                            IfCondition EqualTo(JSRT_StrUnit(save_name, 9), 100) ThenBlock: {
                                                IfCondition EqualTo(JSRT_StrUnit(save_name, 10), 0) ThenBlock: {
                                                    ReturnValue(JSNativeID.ARR_TO_REVERSED)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // toSorted = 116 111 83 111 114 116 101 100 0
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 83) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 111) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 114) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 116) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 101) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 100) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 0) ThenBlock: {
                                            ReturnValue(JSNativeID.ARR_TO_SORTED)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // toSpliced = 116 111 83 112 108 105 99 101 100 0
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 83) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 112) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 108) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 105) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 99) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 101) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 100) ThenBlock: {
                                            IfCondition EqualTo(JSRT_StrUnit(save_name, 9), 0) ThenBlock: {
                                                ReturnValue(JSNativeID.ARR_TO_SPLICED)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 'w' methods: with (ES2023) ──
        IfCondition EqualTo(c0, 119) ThenBlock: {
            // with = 119 105 116 104 0
            IfCondition EqualTo(JSRT_StrUnit(save_name, 1), 105) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 116) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 104) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.ARR_WITH)
                        }
                    }
                }
            }
        }

        ReturnValue(0)
    }
}

// =============================================================================
// ARRAY METHOD DISPATCH — implementations for all array methods
// Handler IDs 150-171. Receiver is the ARRAY JSValue.
// Callback-based methods use JSVM__CallFunc for re-entrant JS calls.
// =============================================================================

// Shared arg buffer for callback invocations (3 args max: elem, index, array)
FixedPool.JSArrMethodBuf {
    "arg0":  Initialize=0
    "arg1":  Initialize=0
    "arg2":  Initialize=0
}

// M29g: simplified [[Construct]] for species / ArraySpeciesCreate
// Creates this-object, sets prototype, calls ctor, returns object result or this.
Function.JSVM__Construct {
    Input: ctor: Address
    Input: arg_buf: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_ctor = ctor
        save_ab = arg_buf
        save_ac = argc
        IfCondition NotEqual(JSRT_GetType(save_ctor), JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSRT_CreateArray())
        }
        this_obj = JSRT_CreateObject()
        // this.__proto__ = ctor.prototype when object-like
        JSRT__Push(save_ctor)
        JSRT__Push(save_ab)
        JSRT__Push(save_ac)
        JSRT__Push(this_obj)
        proto = JSRT_ObjGet(save_ctor, "prototype")
        this_obj = JSRT__Pop()
        save_ac = JSRT__Pop()
        save_ab = JSRT__Pop()
        save_ctor = JSRT__Pop()
        pt = JSRT_GetType(proto)
        IfCondition Or(EqualTo(pt, JSType.OBJECT), Or(EqualTo(pt, JSType.ARRAY), EqualTo(pt, JSType.FUNCTION))) ThenBlock: {
            JSRT_ObjSet(this_obj, "__proto__", proto)
        }
        // Bind this + new.target, call
        save_this = JSVM__GetGlobal("this")
        save_nt = JSVM__GetGlobal("__new_target__")
        JSVM__SetGlobal("this", this_obj)
        JSVM__SetGlobal("__new_target__", save_ctor)
        JSRT__Push(this_obj)
        JSRT__Push(save_this)
        JSRT__Push(save_nt)
        ret = JSVM__CallFunc(save_ctor, save_ab, save_ac)
        save_nt = JSRT__Pop()
        save_this = JSRT__Pop()
        this_obj = JSRT__Pop()
        JSVM__SetGlobal("this", save_this)
        JSVM__SetGlobal("__new_target__", save_nt)
        rt = JSRT_GetType(ret)
        IfCondition Or(EqualTo(rt, JSType.OBJECT), Or(EqualTo(rt, JSType.ARRAY), EqualTo(rt, JSType.FUNCTION))) ThenBlock: {
            ReturnValue(ret)
        }
        ReturnValue(this_obj)
    }
}

// M29g: ArraySpeciesCreate(originalArray, length)
// Returns Array or species-constructed instance.
// M47: IsConstructor — user bytecode always; natives only CONSTRUCT allowlist
// (parseInt etc. are callable but not constructible)
Function.JSVM__IsConstructor {
    Input: val: Address
    Output: Integer
    Body: {
        save_v = val
        IfCondition NotEqual(JSRT_GetType(save_v), JSType.FUNCTION) ThenBlock: {
            ReturnValue(0)
        }
        bc = JSRT_FuncGetBC(save_v)
        // user function
        IfCondition GreaterEqual(bc, 0) ThenBlock: {
            ReturnValue(1)
        }
        hid = Subtract(-1, bc)
        // same allowlist as CONSTRUCT
        IfCondition And(GreaterEqual(hid, 8), LessEqual(hid, 10)) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(hid, 15), LessEqual(hid, 21)) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(hid, 61) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(hid, 76) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(hid, 82) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(hid, 88) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(hid, 176) ThenBlock: { ReturnValue(1) }
        // M62 Map/Set + Proxy + Function
        IfCondition EqualTo(hid, 245) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(hid, 255) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(hid, 272) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(hid, 275) ThenBlock: { ReturnValue(1) }
        // M128e7d0: ArrayBuffer / TypedArray / DataView
        IfCondition EqualTo(hid, 300) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(hid, 303), LessEqual(hid, 313)) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(hid, 316) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.JSVM__ArraySpeciesCreate {
    Input: original: Address
    Input: len: Integer
    Output: Address
    Body: {
        save_o = original
        save_len = len
        // M41: ArrayCreate length > 2^32-1 → RangeError
        IfCondition GreaterThan(save_len, 4294967295) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Invalid array length")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        IfCondition LessThan(save_len, 0) ThenBlock: {
            save_len = 0
        }
        // Non-array → ordinary ArrayCreate (no species)
        IfCondition NotEqual(JSRT_GetType(save_o), JSType.ARRAY) ThenBlock: {
            ReturnValue(JSRT_CreateArray())
        }
        // C = original.constructor
        JSRT__Push(save_o)
        JSRT__Push(save_len)
        ctor = JSRT_ObjGet(save_o, "constructor")
        save_len = JSRT__Pop()
        save_o = JSRT__Pop()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        ct = JSRT_GetType(ctor)
        // undefined constructor → default Array
        IfCondition EqualTo(ct, JSType.UNDEFINED) ThenBlock: {
            ReturnValue(JSRT_CreateArray())
        }
        // M47: null / number / string / bool constructor → TypeError
        is_obj_c = 0
        IfCondition Or(EqualTo(ct, JSType.OBJECT), EqualTo(ct, JSType.FUNCTION)) ThenBlock: {
            is_obj_c = 1
        }
        IfCondition EqualTo(is_obj_c, 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "constructor is not an object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        // Get @@species
        IfCondition NotEqual(JSVMSymbol.species, 0) ThenBlock: {
            sk = JSVM_SymbolToKey(JSVMSymbol.species)
            JSRT__Push(save_o)
            JSRT__Push(save_len)
            JSRT__Push(ctor)
            species = JSRT_ObjGet(ctor, sk)
            ctor = JSRT__Pop()
            save_len = JSRT__Pop()
            save_o = JSRT__Pop()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            st = JSRT_GetType(species)
            // null → treat as undefined
            IfCondition EqualTo(st, JSType.NULL) ThenBlock: {
                ReturnValue(JSRT_CreateArray())
            }
            // ES: If C is undefined (incl. species undefined), ArrayCreate
            IfCondition EqualTo(st, JSType.UNDEFINED) ThenBlock: {
                ReturnValue(JSRT_CreateArray())
            }
            // else C = species
            ctor = species
            ct = st
        }
        // M47: If IsConstructor(C) is false, TypeError (before any callback)
        IfCondition EqualTo(JSVM__IsConstructor(ctor), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "species is not a constructor")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        // Construct(C, « length »)
        // Built-in Array: return empty array — map/filter fill via ArrPush.
        // Construct(Array, n) pre-sizes length n; subsequent ArrPush appends wrong.
        bc_c = JSRT_FuncGetBC(ctor)
        IfCondition LessThan(bc_c, 0) ThenBlock: {
            hid_c = Subtract(-1, bc_c)
            IfCondition EqualTo(hid_c, 76) ThenBlock: {
                ReturnValue(JSRT_CreateArray())
            }
        }
        StoreValue(JSArrMethodBuf.arg0, JSRT_CreateNumber(save_len))
        ret_c = JSVM__Construct(ctor, JSArrMethodBuf.arg0, 1)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        ReturnValue(ret_c)
    }
}

// M29h: ToObject for array methods — box primitives so .length / proto props work
Function.JSVM__ArrayToObject {
    Input: val: Address
    Output: Address
    Body: {
        save_v = val
        IfCondition EqualTo(save_v, 0) ThenBlock: { ReturnValue(0) }
        ot = JSRT_GetType(save_v)
        IfCondition Or(Or(EqualTo(ot, JSType.OBJECT), EqualTo(ot, JSType.ARRAY)), EqualTo(ot, JSType.FUNCTION)) ThenBlock: {
            ReturnValue(save_v)
        }
        // String: keep primitive for ArrayLike* (length/indices via payload).
        // Callback 3rd arg uses JSVM__ArrayCallbackThis to present String instance.
        IfCondition EqualTo(ot, JSType.STRING) ThenBlock: {
            ReturnValue(save_v)
        }
        // Boolean / Number → proper wrapper with [[PrimitiveValue]] (__value__)
        IfCondition EqualTo(ot, JSType.BOOLEAN) ThenBlock: {
            bglob = JSVM__GetGlobal("Boolean")
            JSBridge__Push(save_v)
            bproto = JSRT_ObjGet(bglob, "prototype")
            save_v = JSBridge__Pop()
            o = JSRT_CreateObject()
            IfCondition EqualTo(JSRT_GetType(bproto), JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(o, "__proto__", bproto)
            }
            JSRT_ObjSet(o, "__value__", save_v)
            JSRT_ObjSet(o, "__class__", JSRT_CreateString("Boolean"))
            ReturnValue(o)
        }
        IfCondition EqualTo(ot, JSType.NUMBER) ThenBlock: {
            nglob = JSVM__GetGlobal("Number")
            JSBridge__Push(save_v)
            nproto = JSRT_ObjGet(nglob, "prototype")
            save_v = JSBridge__Pop()
            o = JSRT_CreateObject()
            IfCondition EqualTo(JSRT_GetType(nproto), JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(o, "__proto__", nproto)
            }
            JSRT_ObjSet(o, "__value__", save_v)
            JSRT_ObjSet(o, "__class__", JSRT_CreateString("Number"))
            ReturnValue(o)
        }
        ReturnValue(save_v)
    }
}

// M33: object passed as callback's 3rd arg (and this for methods).
// String primitives stay as STRING for ArrayLike*, but callbacks need a String object
// so `obj instanceof String` / Object.prototype.toString paths can succeed.
Function.JSVM__ArrayCallbackThis {
    Input: val: Address
    Output: Address
    Body: {
        save_v = val
        IfCondition EqualTo(save_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_GetType(save_v), JSType.STRING) ThenBlock: {
            ReturnValue(save_v)
        }
        JSBridge__Push(save_v)
        sglob = JSVM__GetGlobal("String")
        sproto = JSRT_ObjGet(sglob, "prototype")
        o = JSRT_CreateObject()
        save_v = JSBridge__Pop()
        IfCondition EqualTo(JSRT_GetType(sproto), JSType.OBJECT) ThenBlock: {
            JSBridge__Push(save_v)
            JSBridge__Push(o)
            JSRT_ObjSet(o, "__proto__", sproto)
            o = JSBridge__Pop()
            save_v = JSBridge__Pop()
        }
        // length for tests that read O.length
        sp = JSRT_GetPayload(save_v)
        slen = 0
        IfCondition NotEqual(sp, 0) ThenBlock: { slen = JSRT_StrLen(sp) }
        JSBridge__Push(save_v)
        JSBridge__Push(o)
        JSRT_ObjSet(o, "length", JSRT_CreateNumber(slen))
        o = JSBridge__Pop()
        save_v = JSBridge__Pop()
        JSBridge__Push(save_v)
        JSBridge__Push(o)
        JSRT_ObjSet(o, "__class__", JSRT_CreateString("String"))
        o = JSBridge__Pop()
        save_v = JSBridge__Pop()
        // stash primitive for potential valueOf
        JSBridge__Push(o)
        JSRT_ObjSet(o, "__prim__", save_v)
        o = JSBridge__Pop()
        ReturnValue(o)
    }
}

// M29d/h: array-like length (ToLength of .length); real arrays use ArrLen
Function.JSVM__ArrayLikeLen {
    Input: obj: Address
    Output: Integer
    Body: {
        save_o = obj
        ot = JSRT_GetType(save_o)
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSRT_ArrLen(save_o))
        }
        IfCondition EqualTo(ot, JSType.STRING) ThenBlock: {
            sp = JSRT_GetPayload(save_o)
            IfCondition EqualTo(sp, 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(JSRT_StrLen(sp))
        }
        IfCondition Or(EqualTo(ot, JSType.NULL), EqualTo(ot, JSType.UNDEFINED)) ThenBlock: {
            ReturnValue(-1)
        }
        // OrdinaryGet("length") with engine accessor layout:
        //   accessors: __get_length / __set_length + optional undefined data placeholder
        //   data: "length" only
        // Per level: own getter → own setter-only (stop) → own data → climb.
        // Own data must beat inherited getter; own setter-only must not climb.
        lv = JSRT_Undefined()
        found = 0
        recv = save_o
        cur = save_o
        hops = 0
        gk = JSRT__StrSlabAlloc(14)
        sk = JSRT__StrSlabAlloc(14)
        IfCondition And(NotEqual(gk, 0), NotEqual(sk, 0)) ThenBlock: {
            // "__get_length\0" / "__set_length\0"
            SetByte(gk, 0, 95)
            SetByte(gk, 1, 95)
            SetByte(gk, 2, 103)
            SetByte(gk, 3, 101)
            SetByte(gk, 4, 116)
            SetByte(gk, 5, 95)
            SetByte(gk, 6, 108)
            SetByte(gk, 7, 101)
            SetByte(gk, 8, 110)
            SetByte(gk, 9, 103)
            SetByte(gk, 10, 116)
            SetByte(gk, 11, 104)
            SetByte(gk, 12, 0)
            SetByte(sk, 0, 95)
            SetByte(sk, 1, 95)
            SetByte(sk, 2, 115)
            SetByte(sk, 3, 101)
            SetByte(sk, 4, 116)
            SetByte(sk, 5, 95)
            SetByte(sk, 6, 108)
            SetByte(sk, 7, 101)
            SetByte(sk, 8, 110)
            SetByte(sk, 9, 103)
            SetByte(sk, 10, 116)
            SetByte(sk, 11, 104)
            SetByte(sk, 12, 0)
            WhileLoop And(And(NotEqual(cur, 0), EqualTo(found, 0)), LessThan(hops, 64)) {
                hops = Add(hops, 1)
                JSBridge__Push(recv)
                JSBridge__Push(cur)
                JSBridge__Push(gk)
                JSBridge__Push(sk)
                own_g = JSRT_ObjHas(cur, gk)
                sk = JSBridge__Pop()
                gk = JSBridge__Pop()
                cur = JSBridge__Pop()
                recv = JSBridge__Pop()
                IfCondition EqualTo(own_g, 1) ThenBlock: {
                    JSBridge__Push(recv)
                    JSBridge__Push(cur)
                    JSBridge__Push(gk)
                    JSBridge__Push(sk)
                    gfn = JSRT_ObjGet(cur, gk)
                    sk = JSBridge__Pop()
                    gk = JSBridge__Pop()
                    cur = JSBridge__Pop()
                    recv = JSBridge__Pop()
                    IfCondition EqualTo(JSRT_GetType(gfn), JSType.FUNCTION) ThenBlock: {
                        save_this = JSVM__GetGlobal("this")
                        JSVM__SetGlobal("this", recv)
                        empty_b = JSVMCallBuf.buf
                        lv = JSVM__CallFunc(gfn, empty_b, 0)
                        JSVM__SetGlobal("this", save_this)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            ReturnValue(0)
                        }
                    }
                    found = 1
                } ElseBlock: {
                    JSBridge__Push(recv)
                    JSBridge__Push(cur)
                    JSBridge__Push(gk)
                    JSBridge__Push(sk)
                    own_s = JSRT_ObjHas(cur, sk)
                    sk = JSBridge__Pop()
                    gk = JSBridge__Pop()
                    cur = JSBridge__Pop()
                    recv = JSBridge__Pop()
                    IfCondition EqualTo(own_s, 1) ThenBlock: {
                        // setter-only → undefined length (ToLength 0); do not climb
                        lv = JSRT_Undefined()
                        found = 1
                    } ElseBlock: {
                        JSBridge__Push(recv)
                        JSBridge__Push(cur)
                        JSBridge__Push(gk)
                        JSBridge__Push(sk)
                        own_d = JSRT_ObjHas(cur, "length")
                        sk = JSBridge__Pop()
                        gk = JSBridge__Pop()
                        cur = JSBridge__Pop()
                        recv = JSBridge__Pop()
                        IfCondition EqualTo(own_d, 1) ThenBlock: {
                            JSBridge__Push(recv)
                            JSBridge__Push(cur)
                            JSBridge__Push(gk)
                            JSBridge__Push(sk)
                            // Own data — ObjGet may still prefer inherited getter if
                            // both exist; use ObjGet only when no own accessor (checked).
                            lv = JSRT_ObjGet(cur, "length")
                            sk = JSBridge__Pop()
                            gk = JSBridge__Pop()
                            cur = JSBridge__Pop()
                            recv = JSBridge__Pop()
                            found = 1
                        } ElseBlock: {
                            // climb [[Prototype]]
                            JSBridge__Push(recv)
                            JSBridge__Push(gk)
                            JSBridge__Push(sk)
                            proto = JSRT_ObjGet(cur, "__proto__")
                            sk = JSBridge__Pop()
                            gk = JSBridge__Pop()
                            recv = JSBridge__Pop()
                            pt = JSRT_GetType(proto)
                            IfCondition Or(Or(EqualTo(pt, JSType.OBJECT), EqualTo(pt, JSType.FUNCTION)), EqualTo(pt, JSType.ARRAY)) ThenBlock: {
                                cur = proto
                            } ElseBlock: {
                                cur = 0
                            }
                        }
                    }
                }
            }
        }
        lt = JSRT_GetType(lv)
        IfCondition EqualTo(lt, JSType.UNDEFINED) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(lt, JSType.NULL) ThenBlock: { ReturnValue(0) }
        // ES ToLength: ToNumber → +0 if NaN/≤0; min(floor, 2^53-1)
        nbits = JSRT_ToNumber(lv)
        // NaN
        IfCondition EqualTo(Float_Ne(nbits, nbits), 1) ThenBlock: { ReturnValue(0) }
        // ≤ +0
        IfCondition EqualTo(Float_Lt(nbits, Float_FromInt(0)), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Eq(nbits, Float_FromInt(0)), 1) ThenBlock: { ReturnValue(0) }
        // +Infinity → 2^53-1 (9007199254740991)
        inf_bits = 9218868437227405312
        IfCondition EqualTo(nbits, inf_bits) ThenBlock: {
            ReturnValue(9007199254740991)
        }
        n = Float_ToInt(nbits)
        IfCondition LessThan(n, 0) ThenBlock: { ReturnValue(0) }
        // 2^53-1 cap
        IfCondition GreaterThan(n, 9007199254740991) ThenBlock: {
            n = 9007199254740991
        }
        ReturnValue(n)
    }
}

// M29d/h: has index on array or array-like
// M43: ARRAY holes still HasProperty via [[Prototype]]
// M46: own/inherited accessors (__get_N) count as present
Function.JSVM__ArrayLikeHas {
    Input: obj: Address
    Input: idx: Integer
    Output: Integer
    Body: {
        save_o = obj
        save_i = idx
        ot = JSRT_GetType(save_o)
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            IfCondition EqualTo(JSRT_ArrHas(save_o, save_i), 1) ThenBlock: {
                ReturnValue(1)
            }
            kptr_a = JSRT__IntToStr(save_i)
            // accessor on array side table / proto
            gk_a = JSBridge__MakeAccKey(kptr_a, 0)
            IfCondition NotEqual(gk_a, 0) ThenBlock: {
                IfCondition NotEqual(JSRT_ObjHasOnChain(save_o, gk_a), 0) ThenBlock: {
                    ReturnValue(1)
                }
            }
            ReturnValue(JSRT_ObjHasOnChain(save_o, kptr_a))
        }
        IfCondition EqualTo(ot, JSType.STRING) ThenBlock: {
            sp = JSRT_GetPayload(save_o)
            sl = 0
            IfCondition NotEqual(sp, 0) ThenBlock: { sl = JSRT_StrLen(sp) }
            IfCondition And(GreaterEqual(save_i, 0), LessThan(save_i, sl)) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        kptr = JSRT__IntToStr(save_i)
        // data property own/chain
        IfCondition NotEqual(JSRT_ObjHasOnChain(save_o, kptr), 0) ThenBlock: {
            ReturnValue(1)
        }
        // accessor __get_N
        gk = JSBridge__MakeAccKey(kptr, 0)
        IfCondition EqualTo(gk, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(JSRT_ObjHasOnChain(save_o, gk))
    }
}

// M29d/h: get index on array or array-like
// M43: ARRAY hole → prototype data
// M46: invoke __get_N accessors (defineProperty getters) — was plain ObjGet
Function.JSVM__ArrayLikeGet {
    Input: obj: Address
    Input: idx: Integer
    Output: Address
    Body: {
        save_o = obj
        save_i = idx
        ot = JSRT_GetType(save_o)
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            kptr_a = JSRT__IntToStr(save_i)
            // M61: accessors first (defineProperty getter on index) — before ArrHas
            // so for-of / Get hit getters (array-key-get-error).
            gk_a = JSBridge__MakeAccKey(kptr_a, 0)
            IfCondition NotEqual(gk_a, 0) ThenBlock: {
                JSBridge__Push(save_o)
                JSBridge__Push(kptr_a)
                gfn = JSRT_ObjGet(save_o, gk_a)
                kptr_a = JSBridge__Pop()
                save_o = JSBridge__Pop()
                IfCondition EqualTo(JSRT_GetType(gfn), JSType.FUNCTION) ThenBlock: {
                    save_this = JSVM__GetGlobal("this")
                    JSVM__SetGlobal("this", save_o)
                    empty_b = JSVMCallBuf.buf
                    lv = JSVM__CallFunc(gfn, empty_b, 0)
                    JSVM__SetGlobal("this", save_this)
                    ReturnValue(lv)
                }
            }
            IfCondition EqualTo(JSRT_ArrHas(save_o, save_i), 1) ThenBlock: {
                ReturnValue(JSRT_ArrGet(save_o, save_i))
            }
            ReturnValue(JSRT_ObjGet(save_o, kptr_a))
        }
        IfCondition EqualTo(ot, JSType.STRING) ThenBlock: {
            sp = JSRT_GetPayload(save_o)
            sl = 0
            IfCondition NotEqual(sp, 0) ThenBlock: { sl = JSRT_StrLen(sp) }
            IfCondition And(GreaterEqual(save_i, 0), LessThan(save_i, sl)) ThenBlock: {
                ReturnValue(JSRT_CreateStringSlice(sp, save_i, 1))
            }
            ReturnValue(JSRT_Undefined())
        }
        // OBJECT / FUNCTION array-like
        kptr = JSRT__IntToStr(save_i)
        // 1) Accessor getter — own or on [[Prototype]] (ObjGet walks)
        gk = JSBridge__MakeAccKey(kptr, 0)
        IfCondition NotEqual(gk, 0) ThenBlock: {
            JSBridge__Push(save_o)
            JSBridge__Push(kptr)
            gfn = JSRT_ObjGet(save_o, gk)
            kptr = JSBridge__Pop()
            save_o = JSBridge__Pop()
            IfCondition EqualTo(JSRT_GetType(gfn), JSType.FUNCTION) ThenBlock: {
                save_this = JSVM__GetGlobal("this")
                JSVM__SetGlobal("this", save_o)
                empty_b = JSVMCallBuf.buf
                lv = JSVM__CallFunc(gfn, empty_b, 0)
                JSVM__SetGlobal("this", save_this)
                ReturnValue(lv)
            }
        }
        // 2) Data property (ObjGet walks proto)
        ReturnValue(JSRT_ObjGet(save_o, kptr))
    }
}

// M45: set index on array or array-like
Function.JSVM__ArrayLikeSet {
    Input: obj: Address
    Input: idx: Integer
    Input: val: Address
    Output: Integer
    Body: {
        save_o = obj
        save_i = idx
        save_v = val
        ot = JSRT_GetType(save_o)
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            JSRT_ArrSet(save_o, save_i, save_v)
            ReturnValue(1)
        }
        kptr = JSRT__IntToStr(save_i)
        JSRT_ObjSet(save_o, kptr, save_v)
        ReturnValue(1)
    }
}

// M45: delete index on array or array-like
Function.JSVM__ArrayLikeDelete {
    Input: obj: Address
    Input: idx: Integer
    Output: Integer
    Body: {
        save_o = obj
        save_i = idx
        ot = JSRT_GetType(save_o)
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            // hole slot
            JSRT_ArrSet(save_o, save_i, JSRTState.hole_val)
            ReturnValue(1)
        }
        kptr = JSRT__IntToStr(save_i)
        JSRT_ObjDelete(save_o, kptr)
        ReturnValue(1)
    }
}

// M45: Set length property (array-like or real array)
Function.JSVM__ArrayLikeSetLen {
    Input: obj: Address
    Input: len: Integer
    Output: Integer
    Body: {
        save_o = obj
        save_l = len
        ot = JSRT_GetType(save_o)
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            JSRT_ArrSetLen(save_o, save_l)
            ReturnValue(1)
        }
        JSRT_ObjSet(save_o, "length", JSRT_CreateNumber(save_l))
        ReturnValue(1)
    }
}

// ─── forEach (150) — arr.forEach(callback[, thisArg]) ───
// M42: length before IsCallable; default this = global
Function.JSVM__ArrForEach {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        // ToObject
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.forEach called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        save_recv = JSVM__ArrayToObject(save_recv)
        arr_len = JSVM__ArrayLikeLen(save_recv)
