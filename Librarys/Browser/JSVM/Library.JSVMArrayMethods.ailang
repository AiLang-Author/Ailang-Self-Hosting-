        WhileLoop LessThan(lo, hi) {
            has_lo = JSVM__ArrayLikeHas(save_recv, lo)
            has_hi = JSVM__ArrayLikeHas(save_recv, hi)
            IfCondition EqualTo(has_lo, 1) ThenBlock: {
                IfCondition EqualTo(has_hi, 1) ThenBlock: {
                    a = JSVM__ArrayLikeGet(save_recv, lo)
                    b = JSVM__ArrayLikeGet(save_recv, hi)
                    JSVM__ArrayLikeSet(save_recv, lo, b)
