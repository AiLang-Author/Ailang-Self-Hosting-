            IfCondition EqualTo(JSVM__ArrayLikeHas(save_recv, i), 0) ThenBlock: {
                elem = JSRT_Undefined()
            }
            idx_val = JSRT_CreateNumber(i)
            StoreValue(JSArrMethodBuf.arg0, elem)
            StoreValue(Add(JSArrMethodBuf.arg0, 8), idx_val)
            StoreValue(Add(JSArrMethodBuf.arg0, 16), save_recv)
            pred = JSVM__CallFunc(cb_func, JSArrMethodBuf.arg0, 3)
            IfCondition EqualTo(JSRT_IsTruthy(pred), 1) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(i))
            }
            i = Subtract(i, 1)
        }
        ReturnValue(JSRT_CreateNumber(-1))
    }
}

// ─── copyWithin (176) — arr.copyWithin(target, start[, end]) ───
Function.JSVM__ArrCopyWithin {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.copyWithin called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        save_recv = JSVM__ArrayToObject(save_recv)
        len = JSVM__ArrayLikeLen(save_recv)
        IfCondition LessThan(len, 0) ThenBlock: { ReturnValue(save_recv) }
        // target
        relativeTarget = 0
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            relativeTarget = Float_ToInt(JSRT_ToNumber(Dereference(save_args)))
        }
        // ToInteger then clamp to [0, len]
        IfCondition LessThan(relativeTarget, 0) ThenBlock: {
            to = Add(len, relativeTarget)
            IfCondition LessThan(to, 0) ThenBlock: { to = 0 }
        } ElseBlock: {
            to = relativeTarget
            IfCondition GreaterThan(to, len) ThenBlock: { to = len }
        }
        // start
        relativeStart = 0
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            relativeStart = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
        }
        IfCondition LessThan(relativeStart, 0) ThenBlock: {
            from = Add(len, relativeStart)
            IfCondition LessThan(from, 0) ThenBlock: { from = 0 }
        } ElseBlock: {
            from = relativeStart
            IfCondition GreaterThan(from, len) ThenBlock: { from = len }
        }
        // end
        relativeEnd = len
        IfCondition GreaterEqual(save_argc, 3) ThenBlock: {
            ev = Dereference(Add(save_args, 16))
            IfCondition NotEqual(JSRT_GetType(ev), JSType.UNDEFINED) ThenBlock: {
                relativeEnd = Float_ToInt(JSRT_ToNumber(ev))
            }
        }
        IfCondition LessThan(relativeEnd, 0) ThenBlock: {
            final = Add(len, relativeEnd)
            IfCondition LessThan(final, 0) ThenBlock: { final = 0 }
        } ElseBlock: {
            final = relativeEnd
            IfCondition GreaterThan(final, len) ThenBlock: { final = len }
        }
        count = Subtract(final, from)
        IfCondition LessThan(count, 0) ThenBlock: { count = 0 }
        // min(count, len - to)
        lim = Subtract(len, to)
        IfCondition GreaterThan(count, lim) ThenBlock: { count = lim }
        // direction
        direction = 1
        IfCondition And(LessThan(from, to), LessThan(to, Add(from, count))) ThenBlock: {
            direction = -1
            from = Subtract(Add(from, count), 1)
            to = Subtract(Add(to, count), 1)
        }
        ci = 0
        WhileLoop LessThan(ci, count) {
            IfCondition EqualTo(JSVM__ArrayLikeHas(save_recv, from), 1) ThenBlock: {
                val = JSVM__ArrayLikeGet(save_recv, from)
                IfCondition EqualTo(JSRT_GetType(save_recv), JSType.ARRAY) ThenBlock: {
                    JSRT_ArrSet(save_recv, to, val)
                } ElseBlock: {
                    kptr = JSRT__IntToStr(to)
                    JSRT_ObjSet(save_recv, kptr, val)
                }
            } ElseBlock: {
                // delete property at to
                IfCondition EqualTo(JSRT_GetType(save_recv), JSType.ARRAY) ThenBlock: {
                    // leave hole if ArrDelete exists — set hole
                    JSRT_ArrSet(save_recv, to, JSRTState.hole_val)
                } ElseBlock: {
                    kptr = JSRT__IntToStr(to)
                    JSRT_ObjDelete(save_recv, kptr)
                }
            }
            from = Add(from, direction)
            to = Add(to, direction)
            ci = Add(ci, 1)
        }
        ReturnValue(save_recv)
    }
}
