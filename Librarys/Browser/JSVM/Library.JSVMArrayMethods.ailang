// M128e7c1: IsConcatSpreadable(O) — ES 22.1.3.1.1
// Returns 1 if spread, 0 if not. Sets exc_prop on abrupt.
Function.JSVM__IsConcatSpreadable {
    Input: o: Address
    Output: Integer
    Body: {
        save_o = o
        IfCondition EqualTo(save_o, 0) ThenBlock: { ReturnValue(0) }
        ot = JSRT_GetType(save_o)
        // Type(O) not Object → false (primitives)
        IfCondition And(NotEqual(ot, JSType.OBJECT), And(NotEqual(ot, JSType.FUNCTION), NotEqual(ot, JSType.ARRAY))) ThenBlock: {
            ReturnValue(0)
        }
        // Get @@isConcatSpreadable
        IfCondition NotEqual(JSVMSymbol.isConcatSpreadable, 0) ThenBlock: {
            sk = JSVM_SymbolToKey(JSVMSymbol.isConcatSpreadable)
            IfCondition NotEqual(sk, 0) ThenBlock: {
                JSBridge__Push(save_o)
                spread_v = JSVM__GetProperty(save_o, sk)
                save_o = JSBridge__Pop()
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(0) }
                st = JSRT_GetType(spread_v)
                // if not undefined → ToBoolean
                IfCondition NotEqual(st, JSType.UNDEFINED) ThenBlock: {
                    IfCondition NotEqual(spread_v, 0) ThenBlock: {
                        IfCondition NotEqual(spread_v, JSRTState.undef_val) ThenBlock: {
                            ReturnValue(JSRT_IsTruthy(spread_v))
