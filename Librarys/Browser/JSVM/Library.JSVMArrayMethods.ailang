        insert_count = 0
        IfCondition GreaterThan(save_argc, 2) ThenBlock: {
            insert_count = Subtract(save_argc, 2)
        }
        // ARRAY path: in-place shift via ArrSet/ArrSetLen
        is_arr = 0
        IfCondition EqualTo(JSRT_GetType(save_recv), JSType.ARRAY) ThenBlock: { is_arr = 1 }
        IfCondition EqualTo(is_arr, 1) ThenBlock: {
            tail_start = Add(start, del_count)
            new_tail_start = Add(start, insert_count)
