            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_CreateNumber(0))
        }
        save_recv = JSVM__ArrayToObject(save_recv)
        arr_len = JSVM__ArrayLikeLen(save_recv)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_CreateNumber(0)) }
        IfCondition EqualTo(save_argc, 0) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(arr_len))
        }
        // Shift existing right by argc
        i = Subtract(arr_len, 1)
        WhileLoop GreaterEqual(i, 0) {
            dest = Add(i, save_argc)
            IfCondition EqualTo(JSVM__ArrayLikeHas(save_recv, i), 1) ThenBlock: {
                JSVM__ArrayLikeSet(save_recv, dest, JSVM__ArrayLikeGet(save_recv, i))
            } ElseBlock: {
                JSVM__ArrayLikeDelete(save_recv, dest)
            }
            i = Subtract(i, 1)
        }
        // Insert new at front
        i = 0
        WhileLoop LessThan(i, save_argc) {
            new_elem = Dereference(Add(save_args, Multiply(i, 8)))
            JSVM__ArrayLikeSet(save_recv, i, new_elem)
            i = Add(i, 1)
        }
        new_len = Add(arr_len, save_argc)
        JSVM__ArrayLikeSetLen(save_recv, new_len)
        ReturnValue(JSRT_CreateNumber(new_len))
    }
}

// ─── splice (167) — arr.splice(start, deleteCount, ...items) → removed array ───
// M29h: removed array via ArraySpeciesCreate
// M128e7c5: ToObject + ArrayLike; preserve holes when collecting removed
Function.JSVM__ArrSplice {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.splice called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_CreateArray())
        }
        save_recv = JSVM__ArrayToObject(save_recv)
        arr_len = JSVM__ArrayLikeLen(save_recv)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_CreateArray()) }
        IfCondition LessThan(arr_len, 0) ThenBlock: { arr_len = 0 }
        // no args → empty removed, no change
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSVM__ArraySpeciesCreate(save_recv, 0))
        }
        // Parse start
        start = Float_ToInt(JSRT_ToNumber(Dereference(save_args)))
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_CreateArray()) }
        IfCondition LessThan(start, 0) ThenBlock: {
            start = Add(arr_len, start)
            IfCondition LessThan(start, 0) ThenBlock: { start = 0 }
        }
        IfCondition GreaterThan(start, arr_len) ThenBlock: { start = arr_len }
        // Parse deleteCount (omitted → to end)
        del_count = Subtract(arr_len, start)
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            del_count = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_CreateArray()) }
            IfCondition LessThan(del_count, 0) ThenBlock: { del_count = 0 }
            IfCondition GreaterThan(del_count, Subtract(arr_len, start)) ThenBlock: {
                del_count = Subtract(arr_len, start)
            }
        }
        // Species-created removed array
        removed = JSVM__ArraySpeciesCreate(save_recv, del_count)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(removed) }
