                si = tail_start
                WhileLoop LessThan(si, arr_len) {
                    dst = Add(si, diff)
                    IfCondition GreaterEqual(dst, 0) ThenBlock: {
                        IfCondition EqualTo(JSRT_ArrHas(save_recv, si), 1) ThenBlock: {
                            JSRT_ArrSet(save_recv, dst, JSRT_ArrGet(save_recv, si))
                        } ElseBlock: {
                            JSRT_ArrSet(save_recv, dst, JSRTState.hole_val)
                        }
