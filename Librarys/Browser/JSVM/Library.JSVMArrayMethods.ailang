                    si = Add(si, 1)
                }
                pop_count = Subtract(0, diff)
                pi = 0
                WhileLoop LessThan(pi, pop_count) {
                    JSRT_ArrPop(save_recv)
                    pi = Add(pi, 1)
                }
            }
            ii = 0
            WhileLoop LessThan(ii, insert_count) {
                item = Dereference(Add(save_args, Multiply(Add(ii, 2), 8)))
                JSRT_ArrSet(save_recv, Add(start, ii), item)
                ii = Add(ii, 1)
            }
        } ElseBlock: {
            // array-like object path — length writeback
            new_len = Add(Subtract(arr_len, del_count), insert_count)
            // shift tail right or left
            IfCondition GreaterThan(insert_count, del_count) ThenBlock: {
                // grow: from end down
                si = Subtract(arr_len, 1)
                WhileLoop GreaterEqual(si, Add(start, del_count)) {
                    dst = Add(si, Subtract(insert_count, del_count))
                    JSBridge__Push(save_recv)
                    JSBridge__Push(save_args)
                    JSBridge__Push(save_argc)
                    JSBridge__Push(start)
                    JSBridge__Push(del_count)
                    JSBridge__Push(insert_count)
                    JSBridge__Push(new_len)
                    JSBridge__Push(si)
                    has_s = JSVM__ArrayLikeHas(save_recv, si)
                    si = JSBridge__Pop()
                    new_len = JSBridge__Pop()
                    insert_count = JSBridge__Pop()
                    del_count = JSBridge__Pop()
                    start = JSBridge__Pop()
                    save_argc = JSBridge__Pop()
                    save_args = JSBridge__Pop()
                    save_recv = JSBridge__Pop()
                    dst = Add(si, Subtract(insert_count, del_count))
                    IfCondition EqualTo(has_s, 1) ThenBlock: {
                        JSBridge__Push(save_recv)
                        JSBridge__Push(save_args)
                        JSBridge__Push(save_argc)
                        JSBridge__Push(start)
                        JSBridge__Push(del_count)
                        JSBridge__Push(insert_count)
                        JSBridge__Push(new_len)
                        JSBridge__Push(si)
                        JSBridge__Push(dst)
                        v = JSVM__ArrayLikeGet(save_recv, si)
                        dst = JSBridge__Pop()
                        si = JSBridge__Pop()
                        new_len = JSBridge__Pop()
                        insert_count = JSBridge__Pop()
                        del_count = JSBridge__Pop()
                        start = JSBridge__Pop()
                        save_argc = JSBridge__Pop()
                        save_args = JSBridge__Pop()
                        save_recv = JSBridge__Pop()
                        JSVM__ArrayLikeSet(save_recv, dst, v)
                    } ElseBlock: {
                        JSVM__ArrayLikeDelete(save_recv, dst)
                    }
                    si = Subtract(si, 1)
                }
            }
            IfCondition LessThan(insert_count, del_count) ThenBlock: {
                si = Add(start, del_count)
                WhileLoop LessThan(si, arr_len) {
                    dst = Add(si, Subtract(insert_count, del_count))
                    JSBridge__Push(save_recv)
                    JSBridge__Push(save_args)
                    JSBridge__Push(save_argc)
                    JSBridge__Push(start)
                    JSBridge__Push(del_count)
                    JSBridge__Push(insert_count)
                    JSBridge__Push(new_len)
                    JSBridge__Push(si)
                    JSBridge__Push(dst)
                    has_s = JSVM__ArrayLikeHas(save_recv, si)
                    dst = JSBridge__Pop()
                    si = JSBridge__Pop()
                    new_len = JSBridge__Pop()
                    insert_count = JSBridge__Pop()
                    del_count = JSBridge__Pop()
                    start = JSBridge__Pop()
                    save_argc = JSBridge__Pop()
                    save_args = JSBridge__Pop()
                    save_recv = JSBridge__Pop()
                    IfCondition EqualTo(has_s, 1) ThenBlock: {
                        JSBridge__Push(save_recv)
                        JSBridge__Push(save_args)
                        JSBridge__Push(save_argc)
                        JSBridge__Push(start)
                        JSBridge__Push(del_count)
                        JSBridge__Push(insert_count)
                        JSBridge__Push(new_len)
                        JSBridge__Push(si)
                        JSBridge__Push(dst)
                        v = JSVM__ArrayLikeGet(save_recv, si)
                        dst = JSBridge__Pop()
                        si = JSBridge__Pop()
                        new_len = JSBridge__Pop()
                        insert_count = JSBridge__Pop()
                        del_count = JSBridge__Pop()
                        start = JSBridge__Pop()
                        save_argc = JSBridge__Pop()
                        save_args = JSBridge__Pop()
                        save_recv = JSBridge__Pop()
                        JSVM__ArrayLikeSet(save_recv, dst, v)
                    } ElseBlock: {
                        JSVM__ArrayLikeDelete(save_recv, dst)
                    }
                    si = Add(si, 1)
                }
                // delete trailing
                di = new_len
                WhileLoop LessThan(di, arr_len) {
                    JSVM__ArrayLikeDelete(save_recv, di)
                    di = Add(di, 1)
                }
            }
            ii = 0
            WhileLoop LessThan(ii, insert_count) {
                item = Dereference(Add(save_args, Multiply(Add(ii, 2), 8)))
                JSVM__ArrayLikeSet(save_recv, Add(start, ii), item)
                ii = Add(ii, 1)
            }
            JSVM__ArrayLikeSetLen(save_recv, new_len)
        }
        ReturnValue(removed)
    }
}

// ─── fill (168) — arr.fill(value, start?, end?) → same array ───
// M128e7c5: array-like generic + ToObject; clamp start/end
Function.JSVM__ArrFill {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
