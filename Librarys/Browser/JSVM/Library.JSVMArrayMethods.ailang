            SetByte(gk, 3, 101)
            SetByte(gk, 4, 116)
            SetByte(gk, 5, 95)
            SetByte(gk, 6, 108)
            SetByte(gk, 7, 101)
            SetByte(gk, 8, 110)
            SetByte(gk, 9, 103)
            SetByte(gk, 10, 116)
            SetByte(gk, 11, 104)
            SetByte(gk, 12, 0)
