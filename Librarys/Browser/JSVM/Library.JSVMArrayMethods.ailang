            }
        }
        // Count items to insert (argc - 2)
        insert_count = 0
        IfCondition GreaterThan(save_argc, 2) ThenBlock: {
            insert_count = Subtract(save_argc, 2)
        }
        // ARRAY path: in-place shift via ArrSet/ArrSetLen
        is_arr = 0
        IfCondition EqualTo(JSRT_GetType(save_recv), JSType.ARRAY) ThenBlock: { is_arr = 1 }
        IfCondition EqualTo(is_arr, 1) ThenBlock: {
            tail_start = Add(start, del_count)
            new_tail_start = Add(start, insert_count)
            diff = Subtract(insert_count, del_count)
            IfCondition GreaterThan(diff, 0) ThenBlock: {
                gi = 0
                WhileLoop LessThan(gi, diff) {
                    JSRT_ArrPush(save_recv, JSRT_Undefined())
                    gi = Add(gi, 1)
                }
                new_len = JSRT_ArrLen(save_recv)
                mi = Subtract(new_len, 1)
                WhileLoop GreaterEqual(mi, new_tail_start) {
                    src_idx = Subtract(mi, diff)
                    IfCondition GreaterEqual(src_idx, tail_start) ThenBlock: {
                        JSRT_ArrSet(save_recv, mi, JSRT_ArrGet(save_recv, src_idx))
                    }
                    mi = Subtract(mi, 1)
                }
            }
            IfCondition LessThan(diff, 0) ThenBlock: {
                si = tail_start
                WhileLoop LessThan(si, arr_len) {
                    dst = Add(si, diff)
                    IfCondition GreaterEqual(dst, 0) ThenBlock: {
                        IfCondition EqualTo(JSRT_ArrHas(save_recv, si), 1) ThenBlock: {
                            JSRT_ArrSet(save_recv, dst, JSRT_ArrGet(save_recv, si))
                        } ElseBlock: {
                            JSRT_ArrSet(save_recv, dst, JSRTState.hole_val)
                        }
                    }
                    si = Add(si, 1)
                }
                pop_count = Subtract(0, diff)
                pi = 0
                WhileLoop LessThan(pi, pop_count) {
                    JSRT_ArrPop(save_recv)
                    pi = Add(pi, 1)
                }
            }
            ii = 0
            WhileLoop LessThan(ii, insert_count) {
                item = Dereference(Add(save_args, Multiply(Add(ii, 2), 8)))
                JSRT_ArrSet(save_recv, Add(start, ii), item)
                ii = Add(ii, 1)
            }
            // Set(length) is last. !W and frozen fail even when the length is unchanged.
            JSBridge__Push(removed)
            blocked = JSVM__ArrLenBlocked(save_recv)
            removed = JSBridge__Pop()
            IfCondition EqualTo(blocked, 1) ThenBlock: {
                JSVM__ArrWriteFailed()
                ReturnValue(JSRT_Undefined())
            }
        } ElseBlock: {
            // array-like object path — length writeback
            new_len = Add(Subtract(arr_len, del_count), insert_count)
            // shift tail right or left
            IfCondition GreaterThan(insert_count, del_count) ThenBlock: {
                // grow: from end down
                si = Subtract(arr_len, 1)
                WhileLoop GreaterEqual(si, Add(start, del_count)) {
                    dst = Add(si, Subtract(insert_count, del_count))
                    JSBridge__Push(save_recv)
                    JSBridge__Push(save_args)
                    JSBridge__Push(save_argc)
                    JSBridge__Push(start)
                    JSBridge__Push(del_count)
                    JSBridge__Push(insert_count)
                    JSBridge__Push(new_len)
                    JSBridge__Push(si)
                    has_s = JSVM__ArrayLikeHas(save_recv, si)
                    si = JSBridge__Pop()
                    new_len = JSBridge__Pop()
                    insert_count = JSBridge__Pop()
                    del_count = JSBridge__Pop()
                    start = JSBridge__Pop()
                    save_argc = JSBridge__Pop()
                    save_args = JSBridge__Pop()
                    save_recv = JSBridge__Pop()
                    dst = Add(si, Subtract(insert_count, del_count))
                    IfCondition EqualTo(has_s, 1) ThenBlock: {
                        JSBridge__Push(save_recv)
                        JSBridge__Push(save_args)
                        JSBridge__Push(save_argc)
                        JSBridge__Push(start)
                        JSBridge__Push(del_count)
                        JSBridge__Push(insert_count)
                        JSBridge__Push(new_len)
                        JSBridge__Push(si)
                        JSBridge__Push(dst)
                        v = JSVM__ArrayLikeGet(save_recv, si)
                        dst = JSBridge__Pop()
                        si = JSBridge__Pop()
                        new_len = JSBridge__Pop()
                        insert_count = JSBridge__Pop()
                        del_count = JSBridge__Pop()
                        start = JSBridge__Pop()
                        save_argc = JSBridge__Pop()
                        save_args = JSBridge__Pop()
                        save_recv = JSBridge__Pop()
                        JSVM__ArrayLikeSet(save_recv, dst, v)
                    } ElseBlock: {
                        JSVM__ArrayLikeDelete(save_recv, dst)
                    }
                    si = Subtract(si, 1)
                }
            }
            IfCondition LessThan(insert_count, del_count) ThenBlock: {
                si = Add(start, del_count)
                WhileLoop LessThan(si, arr_len) {
                    dst = Add(si, Subtract(insert_count, del_count))
                    JSBridge__Push(save_recv)
                    JSBridge__Push(save_args)
                    JSBridge__Push(save_argc)
                    JSBridge__Push(start)
                    JSBridge__Push(del_count)
                    JSBridge__Push(insert_count)
                    JSBridge__Push(new_len)
                    JSBridge__Push(si)
                    JSBridge__Push(dst)
                    has_s = JSVM__ArrayLikeHas(save_recv, si)
                    dst = JSBridge__Pop()
                    si = JSBridge__Pop()
                    new_len = JSBridge__Pop()
                    insert_count = JSBridge__Pop()
                    del_count = JSBridge__Pop()
                    start = JSBridge__Pop()
                    save_argc = JSBridge__Pop()
                    save_args = JSBridge__Pop()
                    save_recv = JSBridge__Pop()
                    IfCondition EqualTo(has_s, 1) ThenBlock: {
                        JSBridge__Push(save_recv)
                        JSBridge__Push(save_args)
                        JSBridge__Push(save_argc)
                        JSBridge__Push(start)
                        JSBridge__Push(del_count)
                        JSBridge__Push(insert_count)
                        JSBridge__Push(new_len)
                        JSBridge__Push(si)
                        JSBridge__Push(dst)
                        v = JSVM__ArrayLikeGet(save_recv, si)
                        dst = JSBridge__Pop()
                        si = JSBridge__Pop()
                        new_len = JSBridge__Pop()
                        insert_count = JSBridge__Pop()
                        del_count = JSBridge__Pop()
                        start = JSBridge__Pop()
                        save_argc = JSBridge__Pop()
                        save_args = JSBridge__Pop()
                        save_recv = JSBridge__Pop()
                        JSVM__ArrayLikeSet(save_recv, dst, v)
                    } ElseBlock: {
                        JSVM__ArrayLikeDelete(save_recv, dst)
                    }
                    si = Add(si, 1)
                }
                // delete trailing
                di = new_len
                WhileLoop LessThan(di, arr_len) {
                    JSVM__ArrayLikeDelete(save_recv, di)
                    di = Add(di, 1)
                }
            }
            ii = 0
            WhileLoop LessThan(ii, insert_count) {
                item = Dereference(Add(save_args, Multiply(Add(ii, 2), 8)))
                JSVM__ArrayLikeSet(save_recv, Add(start, ii), item)
                ii = Add(ii, 1)
            }
            JSBridge__Push(removed)
            JSBridge__Push(save_recv)
            JSBridge__Push(new_len)
            ok_len = JSVM__ArrayLikeSetLen(save_recv, new_len)
            new_len = JSBridge__Pop()
            save_recv = JSBridge__Pop()
            removed = JSBridge__Pop()
            IfCondition EqualTo(ok_len, 0) ThenBlock: {
                JSVM__ArrWriteFailed()
                ReturnValue(JSRT_Undefined())
            }
        }
        ReturnValue(removed)
    }
}

// ─── fill (168) — arr.fill(value, start?, end?) → same array ───
// M128e7c5: array-like generic + ToObject; clamp start/end
Function.JSVM__ArrFill {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.fill called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        save_recv = JSVM__ArrayToObject(save_recv)
        arr_len = JSVM__MethodLen(save_recv)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(save_recv) }
        IfCondition LessThan(arr_len, 0) ThenBlock: { arr_len = 0 }
        fill_val = JSRT_Undefined()
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            fill_val = Dereference(save_args)
        }
        // M128e7dp: start/end via ToRelativeIndex (±Infinity)
        start = 0
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            start = JSVM_ToRelativeIndex(Dereference(Add(save_args, 8)), arr_len, 0)
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(save_recv) }
            IfCondition LessThan(start, 0) ThenBlock: { ReturnValue(save_recv) }
        }
        end = arr_len
        IfCondition GreaterEqual(save_argc, 3) ThenBlock: {
            end = JSVM_ToRelativeIndex(Dereference(Add(save_args, 16)), arr_len, arr_len)
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(save_recv) }
            IfCondition LessThan(end, 0) ThenBlock: { ReturnValue(save_recv) }
        }
        // M128e7dq/e7dv: TypedArray fill converts value once (ToNumber/ToBigInt) before loop
        // then IsDetachedBuffer → TypeError (coercion may detach)
        IfCondition EqualTo(JSVM_IsTypedArray(save_recv), 1) ThenBlock: {
            kind_f = JSVM_TA_Kind(save_recv)
            JSBridge__Push(save_recv)
            JSBridge__Push(start)
            JSBridge__Push(end)
            IfCondition Or(EqualTo(kind_f, 9), EqualTo(kind_f, 10)) ThenBlock: {
                fill_val = JSRT_ToBigInt(fill_val)
            } ElseBlock: {
                nbits_f = JSRT_ToNumber(fill_val)
                fill_val = JSRT_CreateFloat(nbits_f)
                // prefer CreateNumber for integral results when safe
                IfCondition EqualTo(Float_Ne(nbits_f, nbits_f), 0) ThenBlock: {
                    ni_f = Float_ToInt(nbits_f)
                    IfCondition EqualTo(Float_Eq(nbits_f, Float_FromInt(ni_f)), 1) ThenBlock: {
                        fill_val = JSRT_CreateNumber(ni_f)
                    }
                }
            }
            end = JSBridge__Pop()
            start = JSBridge__Pop()
            save_recv = JSBridge__Pop()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(save_recv) }
            // after value/start/end coercion: detached → TypeError
            tbuf_f = JSRT_ObjGet(save_recv, "__ta_buf__")
            IfCondition EqualTo(JSVM_IsDetachedBuffer(tbuf_f), 1) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "Cannot fill detached TypedArray")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
        }
        i = start
        WhileLoop LessThan(i, end) {
            JSBridge__Push(save_recv)
            JSBridge__Push(fill_val)
            JSBridge__Push(i)
            JSBridge__Push(end)
            JSVM__ArrayLikeSet(save_recv, i, fill_val)
            end = JSBridge__Pop()
            i = JSBridge__Pop()
            fill_val = JSBridge__Pop()
            save_recv = JSBridge__Pop()
            i = Add(i, 1)
        }
        ReturnValue(save_recv)
    }
}

// ─── sort (169) — arr.sort(compareFn?) → same array (mutated) ───
// M128e7c5: ES SortIndexedProperties — collect present only, sort, write back;
// remaining indices become holes. comparefn must be undefined or callable.
// Stable mergesort (index). Array-like generic via ArrayToObject.
// sort's return value is ToObject(this). String stays a primitive inside
// ArrayToObject so index walks keep working; box only the value sort returns.
Function.JSVM__SortWrap {
    Input: val: Address
    Output: Address
    Body: {
        save_v = val
        JSBridge__Push(save_v)
        ot = JSRT_GetType(save_v)
        save_v = JSBridge__Pop()
        IfCondition EqualTo(ot, JSType.STRING) ThenBlock: {
            ReturnValue(JSVM__ArrayCallbackThis(save_v))
        }
        IfCondition EqualTo(ot, JSType.BIGINT) ThenBlock: {
            ReturnValue(JSBridge__BoxBigInt(save_v))
        }
        JSBridge__Push(save_v)
        is_ps = JSVM_IsPrimSymbol(save_v)
        save_v = JSBridge__Pop()
        IfCondition EqualTo(is_ps, 1) ThenBlock: {
            JSBridge__Push(save_v)
            syg = JSVM__GetGlobal("Symbol")
            syp = JSRT_ObjGet(syg, "prototype")
            save_v = JSBridge__Pop()
            JSBridge__Push(save_v)
            JSBridge__Push(syp)
            box_s = JSRT_CreateObject()
            syp = JSBridge__Pop()
            save_v = JSBridge__Pop()
            JSBridge__Push(save_v)
            JSBridge__Push(syp)
            JSBridge__Push(box_s)
            pt = JSRT_GetType(syp)
            box_s = JSBridge__Pop()
            syp = JSBridge__Pop()
            save_v = JSBridge__Pop()
            IfCondition EqualTo(pt, JSType.OBJECT) ThenBlock: {
                JSBridge__Push(save_v)
                JSBridge__Push(box_s)
                JSRT_ObjSet(box_s, "__proto__", syp)
                box_s = JSBridge__Pop()
                save_v = JSBridge__Pop()
            }
            JSBridge__Push(box_s)
            JSRT_ObjSet(box_s, "__value__", save_v)
            box_s = JSBridge__Pop()
            JSBridge__Push(box_s)
            JSRT_ObjSet(box_s, "__class__", JSRT_CreateString("Symbol"))
            box_s = JSBridge__Pop()
            ReturnValue(box_s)
        }
        ReturnValue(save_v)
    }
}

Function.JSVM__SortCompare {
    Output: Integer
    Body: {
        // cur/key/has_cmp/cmp_func sit on the VM stack above sort_sp.
        //   +0 recv  +1 has_cmp  +2 cmp_func  +3 cur  +4 key  +6 arr_len
        // sp is sort_sp+7. Push sort_sp so a reentrant sort can smash the
        // pool copy and this frame still pops the right base.
        JSBridge__Push(JSArrMethodBuf.sort_sp)
        cur = Dereference(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 3), 8)))
        key = Dereference(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 4), 8)))
        has_cmp = Dereference(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 1), 8)))
        cmp_func = Dereference(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 2), 8)))
        cmp_result = 0
        // SortCompare: undefined is greater than any defined value.
        // comparefn is not called when either side is undefined.
        JSBridge__Push(cur)
        JSBridge__Push(key)
        cu = JSRT_GetType(cur)
        key = JSBridge__Pop()
        cur = JSBridge__Pop()
        JSBridge__Push(cur)
        JSBridge__Push(key)
        JSBridge__Push(cu)
        ku = JSRT_GetType(key)
        cu = JSBridge__Pop()
        key = JSBridge__Pop()
        cur = JSBridge__Pop()
        und_pair = 0
        IfCondition EqualTo(cu, JSType.UNDEFINED) ThenBlock: { und_pair = 1 }
        IfCondition EqualTo(ku, JSType.UNDEFINED) ThenBlock: { und_pair = 1 }
        IfCondition EqualTo(und_pair, 1) ThenBlock: {
            IfCondition And(EqualTo(cu, JSType.UNDEFINED), EqualTo(ku, JSType.UNDEFINED)) ThenBlock: {
                cmp_result = 0
            } ElseBlock: {
                IfCondition EqualTo(cu, JSType.UNDEFINED) ThenBlock: {
                    cmp_result = 1
                } ElseBlock: {
                    cmp_result = -1
                }
            }
        } ElseBlock: {
        cur = Dereference(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 3), 8)))
        key = Dereference(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 4), 8)))
        has_cmp = Dereference(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 1), 8)))
        cmp_func = Dereference(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 2), 8)))
        IfCondition EqualTo(has_cmp, 1) ThenBlock: {
            StoreValue(JSArrMethodBuf.arg0, cur)
            StoreValue(Add(JSArrMethodBuf.arg0, 8), key)
            // this for comparefn is undefined. cmp_func dies across GetGlobal.
            save_this_s = JSVM__GetGlobal("this")
            JSBridge__Push(save_this_s)
            JSVM__SetGlobal("this", JSRTState.undef_val)
            cmp_func = Dereference(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 2), 8)))
            cmp_val = JSVM__CallFunc(cmp_func, JSArrMethodBuf.arg0, 2)
            JSArrMethodBuf.sort_kix = cmp_val
            save_this_s = JSBridge__Pop()
            JSVM__SetGlobal("this", save_this_s)
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                JSArrMethodBuf.sort_kix = 0
                JSArrMethodBuf.sort_sp = JSBridge__Pop()
                JSVMState.sp = Add(JSArrMethodBuf.sort_sp, 7)
                ReturnValue(0)
            }
            cmp_result = Float_ToInt(JSRT_ToNumber(JSArrMethodBuf.sort_kix))
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                JSArrMethodBuf.sort_kix = 0
                JSArrMethodBuf.sort_sp = JSBridge__Pop()
                JSVMState.sp = Add(JSArrMethodBuf.sort_sp, 7)
                ReturnValue(0)
            }
        } ElseBlock: {
            // ES Array default: undefined after + ToString
            // M128e7dz TA: CompareTypedArrayElements (numeric, NaN, ±0)
            ta_flag = Float_ToInt(JSRT_GetPayload(JSVM__GetGlobal("__ta_sort__")))
            IfCondition EqualTo(ta_flag, 1) ThenBlock: {
                // M128e7dz: numeric CompareTypedArrayElements (simplified)
                cur = Dereference(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 3), 8)))
                key = Dereference(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 4), 8)))
                cbits = JSRT_GetPayload(cur)
                kbits = JSRT_GetPayload(key)
                // Ensure NUMBER payloads (TA elems are numbers)
                IfCondition NotEqual(JSRT_GetType(cur), JSType.NUMBER) ThenBlock: {
                    cbits = JSRT_GetPayload(JSRT_ToNumber(cur))
                }
                IfCondition NotEqual(JSRT_GetType(key), JSType.NUMBER) ThenBlock: {
                    kbits = JSRT_GetPayload(JSRT_ToNumber(key))
                }
                // NaN via x != x
                IfCondition EqualTo(Float_Ne(cbits, cbits), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Ne(kbits, kbits), 1) ThenBlock: {
                        cmp_result = 0
                    } ElseBlock: {
                        cmp_result = 1
                    }
                } ElseBlock: {
                    IfCondition EqualTo(Float_Ne(kbits, kbits), 1) ThenBlock: {
                        cmp_result = -1
                    } ElseBlock: {
                        IfCondition EqualTo(Float_Lt(cbits, kbits), 1) ThenBlock: {
                            cmp_result = -1
                        } ElseBlock: {
                            IfCondition EqualTo(Float_Gt(cbits, kbits), 1) ThenBlock: {
                                cmp_result = 1
                            } ElseBlock: {
                                // ±0: sign bit of zero — compare raw bits as unsigned order for zeros
                                // −0 (high bit set) should sort before +0
                                cz = 0
                                kz = 0
                                IfCondition EqualTo(Float_Eq(cbits, Float_FromInt(0)), 1) ThenBlock: { cz = 1 }
                                IfCondition EqualTo(Float_Eq(kbits, Float_FromInt(0)), 1) ThenBlock: { kz = 1 }
                                IfCondition And(EqualTo(cz, 1), EqualTo(kz, 1)) ThenBlock: {
                                    // both ±0: order by sign bit (MSB set = −0 first)
                                    // use signed bit test: bits as integer, negative means MSB set
                                    IfCondition And(LessThan(cbits, 0), GreaterEqual(kbits, 0)) ThenBlock: {
                                        cmp_result = -1
                                    } ElseBlock: {
                                        IfCondition And(GreaterEqual(cbits, 0), LessThan(kbits, 0)) ThenBlock: {
                                            cmp_result = 1
                                        } ElseBlock: {
                                            cmp_result = 0
                                        }
                                    }
                                } ElseBlock: {
                                    cmp_result = 0
                                }
                            }
                        }
                    }
                }
            } ElseBlock: {
                cu = 0
                ku = 0
                IfCondition EqualTo(JSRT_GetType(cur), JSType.UNDEFINED) ThenBlock: { cu = 1 }
                IfCondition EqualTo(JSRT_GetType(key), JSType.UNDEFINED) ThenBlock: { ku = 1 }
                IfCondition And(EqualTo(cu, 1), EqualTo(ku, 1)) ThenBlock: {
                    cmp_result = 0
                } ElseBlock: {
                    IfCondition EqualTo(cu, 1) ThenBlock: {
                        cmp_result = 1
                    } ElseBlock: {
                        IfCondition EqualTo(ku, 1) ThenBlock: {
                            cmp_result = -1
                        } ElseBlock: {
                            cur = Dereference(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 3), 8)))
                            key = Dereference(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 4), 8)))
                            a_str = JSRT_ToString(cur)
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                JSArrMethodBuf.sort_kix = 0
                                JSArrMethodBuf.sort_sp = JSBridge__Pop()
                                JSVMState.sp = Add(JSArrMethodBuf.sort_sp, 7)
                                ReturnValue(0)
                            }
                            JSArrMethodBuf.sort_kix = a_str
                            JSBridge__Push(JSArrMethodBuf.sort_kix)
                            key = Dereference(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 4), 8)))
                            b_str = JSRT_ToString(key)
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                JSArrMethodBuf.sort_kix = JSBridge__Pop()
                                JSArrMethodBuf.sort_kix = 0
                                JSArrMethodBuf.sort_sp = JSBridge__Pop()
                                JSVMState.sp = Add(JSArrMethodBuf.sort_sp, 7)
                                ReturnValue(0)
                            }
                            JSArrMethodBuf.sort_a = b_str
                            JSArrMethodBuf.sort_kix = JSBridge__Pop()
                            JSArrMethodBuf.sort_b = JSRT_GetPayload(JSArrMethodBuf.sort_kix)
                            JSArrMethodBuf.sort_kix = JSRT_GetPayload(JSArrMethodBuf.sort_a)
                            cmp_result = JSRT_StrCmp(JSArrMethodBuf.sort_b, JSArrMethodBuf.sort_kix)
                        }
                    }
                }
            }
        }
        }
        JSArrMethodBuf.sort_kix = cmp_result
        JSArrMethodBuf.sort_sp = JSBridge__Pop()
        JSVMState.sp = Add(JSArrMethodBuf.sort_sp, 7)
        ReturnValue(JSArrMethodBuf.sort_kix)
    }
}
Function.JSVM__SortIdx {
    Output: Integer
    Body: {
        // Bridge top is arr_len, cmp_func, has_cmp, recv. One more recv
        // stays underneath for ArrSort.
        JSArrMethodBuf.sort_idx = 0
        JSArrMethodBuf.sort_tmp = 0
        JSArrMethodBuf.sort_right = JSBridge__Pop()
        JSArrMethodBuf.sort_b = JSBridge__Pop()
        JSArrMethodBuf.sort_a = JSBridge__Pop()
        JSArrMethodBuf.sort_kix = JSBridge__Pop()
        JSArrMethodBuf.sort_sp = JSVMState.sp
        StoreValue(Add(JSVMState.stack, Multiply(JSArrMethodBuf.sort_sp, 8)), JSArrMethodBuf.sort_kix)
        StoreValue(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 1), 8)), JSArrMethodBuf.sort_a)
        StoreValue(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 2), 8)), JSArrMethodBuf.sort_b)
        StoreValue(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 6), 8)), JSArrMethodBuf.sort_right)
        JSVMState.sp = Add(JSArrMethodBuf.sort_sp, 7)
        JSArrMethodBuf.sort_kix = 0
        JSArrMethodBuf.sort_a = 0
        JSArrMethodBuf.sort_b = 0
        JSArrMethodBuf.sort_i = 0
        JSArrMethodBuf.sort_w = 0
        JSArrMethodBuf.sort_p = 0
        JSArrMethodBuf.sort_q = 0
        JSArrMethodBuf.sort_t = 0
        JSArrMethodBuf.sort_left = 0
        JSArrMethodBuf.sort_mid = 0
        JSArrMethodBuf.sort_n = 0
        JSArrMethodBuf.sort_idx = Array.Create(JSArrMethodBuf.sort_right)
        // Slots the collect does not use. A getter can run GC; a stale
        // pointer in the scanned range would be treated as a root.
        StoreValue(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 3), 8)), 0)
        StoreValue(Add(JSVMState.stack, Multiply(Add(JSArrMethodBuf.sort_sp, 4), 8)), 0)
