// Library.JSVMArrayMutators.ailang — index/length writes for pop/push/shift/unshift
// Split from JSVMArrayMethods. Pool stays on that file (JSArrMethodBuf).
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// Throw TypeError for a failed [[Set]] / [[Delete]] (Throw is true).
// A delivered exception is left alone.
Function.JSVM__ArrWriteFailed {
    Output: Integer
    Body: {
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: { ReturnValue(1) }
        terr = JSVM_CreateTypedError("TypeError", "Cannot assign to read-only property")
        JSVM__SetGlobal("__pend_exc__", terr)
        JSVMCall.exc_prop = 1
        JSVMCall.thrown_val = terr
        JSVM_ThrowValue(terr)
        ReturnValue(1)
    }
}

// 1 when len + argc would pass 2^53-1. argc 0 is never over.
Function.JSVM__ArrOverLimit {
    Input: len: Integer
    Input: argc: Integer
    Output: Integer
    Body: {
        save_l = len
        save_n = argc
        IfCondition LessEqual(save_n, 0) ThenBlock: { ReturnValue(0) }
        room = Subtract(9007199254740991, save_n)
        IfCondition GreaterThan(save_l, room) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Copy call args out of JSVMCallBuf. A setter reuses that buffer.
Function.JSVM__ArrSnapArgs {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_a = args
        save_n = argc
        copy = JSRT_CreateArray()
        i = 0
        WhileLoop LessThan(i, save_n) {
            v = RDMEM_64(save_a, Multiply(i, 8))
            JSArrMethodBuf.val_hold = v
            JSArrMethodBuf.recv_pin = copy
            JSArrMethodBuf.s0 = save_a
            JSArrMethodBuf.s1 = save_n
            JSArrMethodBuf.ix_hold = i
            JSBridge__Push(JSArrMethodBuf.recv_pin)
            JSBridge__Push(JSArrMethodBuf.s0)
            JSBridge__Push(JSArrMethodBuf.s1)
            JSBridge__Push(JSArrMethodBuf.ix_hold)
            JSRT_ArrPush(JSArrMethodBuf.recv_pin, JSArrMethodBuf.val_hold)
            i = JSBridge__Pop()
            save_n = JSBridge__Pop()
            save_a = JSBridge__Pop()
            copy = JSBridge__Pop()
            i = Add(i, 1)
        }
        ReturnValue(copy)
    }
}

// Invoke an index setter. Returns 0 if it threw. Does not create a data property.
Function.JSVM__ArrCallSetter {
    Input: obj: Address
    Input: fn: Address
    Input: val: Address
    Output: Integer
    Body: {
        JSArrMethodBuf.recv_pin = obj
        JSArrMethodBuf.s0 = fn
        JSArrMethodBuf.val_hold = val
        old_this = JSVM__GetGlobal("this")
        JSArrMethodBuf.s2 = old_this
        JSBridge__Push(JSArrMethodBuf.s2)
        JSVM__SetGlobal("this", JSArrMethodBuf.recv_pin)
        WRMEM_64(JSArrMethodBuf.arg0, JSArrMethodBuf.val_hold)
        JSVM__CallFunc(JSArrMethodBuf.s0, JSArrMethodBuf.arg0, 1)
        old_this = JSBridge__Pop()
        JSVM__SetGlobal("this", old_this)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// 1 if __frozen__ is set. Array freeze does not stamp length attrs.
Function.JSVM__ArrIsFrozen {
    Input: obj: Address
    Output: Integer
    Body: {
        save_o = obj
        JSBridge__Push(save_o)
        fr = JSRT_ObjGet(save_o, "__frozen__")
        save_o = JSBridge__Pop()
        IfCondition EqualTo(JSRT_IsTruthy(fr), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// M45: set index. Returns 0 when [[Set]] would return false. Does not throw.
Function.JSVM__ArrayLikeSet {
    Input: obj: Address
    Input: idx: Integer
    Input: val: Address
    Output: Integer
    Body: {
        JSArrMethodBuf.recv_pin = obj
        JSArrMethodBuf.ix_hold = idx
        JSArrMethodBuf.val_hold = val
        ot = JSRT_GetType(JSArrMethodBuf.recv_pin)
        IfCondition EqualTo(ot, JSType.STRING) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ot, JSType.OBJECT) ThenBlock: {
            IfCondition EqualTo(JSVM_IsTypedArray(JSArrMethodBuf.recv_pin), 1) ThenBlock: {
                JSVM_TA_Set(JSArrMethodBuf.recv_pin, JSArrMethodBuf.ix_hold, JSArrMethodBuf.val_hold)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(0) }
                ReturnValue(1)
            }
        }
        // IntToStr returns a static buffer. Copy it before the next number
        // conversion, or every index shares one key pointer.
        kbuf = JSRT__StrSlabAlloc(24)
        JSArrMethodBuf.s3 = kbuf
        kptr = JSRT__IntToStr(JSArrMethodBuf.ix_hold)
        JSArrMethodBuf.s0 = kptr
        MemoryCopy(JSArrMethodBuf.s3, JSArrMethodBuf.s0, 24)
        sk = JSBridge__MakeAccKey(JSArrMethodBuf.s3, 1)
        JSArrMethodBuf.s0 = sk
        gk = JSBridge__MakeAccKey(JSArrMethodBuf.s3, 0)
        JSArrMethodBuf.s1 = gk
        own_s = JSRT_ObjHas(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s0)
        JSArrMethodBuf.s2 = own_s
        own_g = JSRT_ObjHas(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s1)
        // Own accessor wins over an element slot and over the prototype.
        IfCondition Or(EqualTo(JSArrMethodBuf.s2, 1), EqualTo(own_g, 1)) ThenBlock: {
            sfn = JSRT_ObjGet(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s0)
            JSArrMethodBuf.s2 = sfn
            IfCondition EqualTo(JSRT_GetType(JSArrMethodBuf.s2), JSType.FUNCTION) ThenBlock: {
                ReturnValue(JSVM__ArrCallSetter(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s2, JSArrMethodBuf.val_hold))
            }
            ReturnValue(0)
        }
        ot = JSRT_GetType(JSArrMethodBuf.recv_pin)
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            has_el = JSRT_ArrHas(JSArrMethodBuf.recv_pin, JSArrMethodBuf.ix_hold)
            IfCondition EqualTo(has_el, 1) ThenBlock: {
                can = JSBridge_CanAssign(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s3)
                IfCondition EqualTo(can, 0) ThenBlock: { ReturnValue(0) }
                JSRT_ArrSet(JSArrMethodBuf.recv_pin, JSArrMethodBuf.ix_hold, JSArrMethodBuf.val_hold)
                ReturnValue(1)
            }
        }
        // Inherited setter, else getter-only, else data [[Set]].
        sfn = JSRT_ObjGet(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s0)
        JSArrMethodBuf.s2 = sfn
        IfCondition EqualTo(JSRT_GetType(JSArrMethodBuf.s2), JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSVM__ArrCallSetter(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s2, JSArrMethodBuf.val_hold))
        }
        gfn = JSRT_ObjGet(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s1)
        JSArrMethodBuf.s2 = gfn
        IfCondition EqualTo(JSRT_GetType(JSArrMethodBuf.s2), JSType.FUNCTION) ThenBlock: {
            ReturnValue(0)
        }
        can = JSBridge_CanAssign(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s3)
        IfCondition EqualTo(can, 0) ThenBlock: { ReturnValue(0) }
        ot = JSRT_GetType(JSArrMethodBuf.recv_pin)
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            JSRT_ArrSet(JSArrMethodBuf.recv_pin, JSArrMethodBuf.ix_hold, JSArrMethodBuf.val_hold)
            ReturnValue(1)
        }
        JSRT_ObjSet(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s3, JSArrMethodBuf.val_hold)
        ReturnValue(1)
    }
}

// CreateDataProperty(obj, idx, val). Returns 0 when [[DefineOwnProperty]]
// would reject. Does not throw. Configurable properties are replaced with
// W|E|C data, including a writable:false data property and an accessor.
// Non-configurable, non-extensible, and a non-writable array length that
// would have to grow all return 0. Callers throw TypeError.
Function.JSVM__CreateDataPropIdx {
    Input: obj: Address
    Input: idx: Integer
    Input: val: Address
    Output: Integer
    Body: {
        JSArrMethodBuf.recv_pin = obj
        JSArrMethodBuf.ix_hold = idx
        JSArrMethodBuf.val_hold = val
        JSArrMethodBuf.s3 = JSRT__StrSlabAlloc(24)
        IfCondition EqualTo(JSArrMethodBuf.s3, 0) ThenBlock: { ReturnValue(0) }
        JSArrMethodBuf.diag_o = JSRT__IntToStr(JSArrMethodBuf.ix_hold)
        MemoryCopy(JSArrMethodBuf.s3, JSArrMethodBuf.diag_o, 24)
        JSArrMethodBuf.s0 = JSBridge__MakeAccKey(JSArrMethodBuf.s3, 1)
        JSArrMethodBuf.s1 = JSBridge__MakeAccKey(JSArrMethodBuf.s3, 0)
        JSArrMethodBuf.diag_n = 0
        IfCondition EqualTo(JSRT_GetType(JSArrMethodBuf.recv_pin), JSType.ARRAY) ThenBlock: {
            IfCondition EqualTo(JSRT_ArrHas(JSArrMethodBuf.recv_pin, JSArrMethodBuf.ix_hold), 1) ThenBlock: {
                JSArrMethodBuf.diag_n = 1
            }
        }
        IfCondition EqualTo(JSRT_ObjHas(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s3), 1) ThenBlock: {
            JSArrMethodBuf.diag_n = 1
        }
        IfCondition NotEqual(JSArrMethodBuf.s1, 0) ThenBlock: {
            IfCondition EqualTo(JSRT_ObjHas(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s1), 1) ThenBlock: {
                JSArrMethodBuf.diag_n = 1
            }
        }
        IfCondition NotEqual(JSArrMethodBuf.s0, 0) ThenBlock: {
            IfCondition EqualTo(JSRT_ObjHas(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s0), 1) ThenBlock: {
                JSArrMethodBuf.diag_n = 1
            }
        }
        IfCondition EqualTo(JSArrMethodBuf.diag_n, 1) ThenBlock: {
            JSArrMethodBuf.diag_i = JSBridge__GetAttrBits(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s3)
            IfCondition EqualTo(BitwiseAnd(JSArrMethodBuf.diag_i, JSAttr.C), 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition NotEqual(JSArrMethodBuf.s1, 0) ThenBlock: {
                IfCondition EqualTo(JSRT_ObjHas(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s1), 1) ThenBlock: {
                    JSRT_ObjDelete(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s1)
                }
            }
            IfCondition NotEqual(JSArrMethodBuf.s0, 0) ThenBlock: {
                IfCondition EqualTo(JSRT_ObjHas(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s0), 1) ThenBlock: {
                    JSRT_ObjDelete(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s0)
                }
            }
        } ElseBlock: {
            JSArrMethodBuf.diag_p = JSRT_ObjGet(JSArrMethodBuf.recv_pin, "__frozen__")
            IfCondition EqualTo(JSRT_IsTruthy(JSArrMethodBuf.diag_p), 1) ThenBlock: { ReturnValue(0) }
            JSArrMethodBuf.diag_p = JSRT_ObjGet(JSArrMethodBuf.recv_pin, "__sealed__")
            IfCondition EqualTo(JSRT_IsTruthy(JSArrMethodBuf.diag_p), 1) ThenBlock: { ReturnValue(0) }
            JSArrMethodBuf.diag_p = JSRT_ObjGet(JSArrMethodBuf.recv_pin, "__extensible__")
            IfCondition EqualTo(JSRT_GetType(JSArrMethodBuf.diag_p), JSType.BOOLEAN) ThenBlock: {
                IfCondition EqualTo(JSRT_IsTruthy(JSArrMethodBuf.diag_p), 0) ThenBlock: {
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(JSRT_GetType(JSArrMethodBuf.recv_pin), JSType.ARRAY) ThenBlock: {
                JSArrMethodBuf.diag_n = JSRT_ArrLen(JSArrMethodBuf.recv_pin)
                IfCondition GreaterEqual(JSArrMethodBuf.ix_hold, JSArrMethodBuf.diag_n) ThenBlock: {
                    JSArrMethodBuf.diag_i = JSBridge__GetAttrBits(JSArrMethodBuf.recv_pin, "length")
                    IfCondition EqualTo(BitwiseAnd(JSArrMethodBuf.diag_i, JSAttr.W), 0) ThenBlock: {
                        ReturnValue(0)
                    }
                }
            }
        }
        IfCondition EqualTo(JSRT_GetType(JSArrMethodBuf.recv_pin), JSType.ARRAY) ThenBlock: {
            JSRT_ArrSet(JSArrMethodBuf.recv_pin, JSArrMethodBuf.ix_hold, JSArrMethodBuf.val_hold)
        } ElseBlock: {
            // Three fields of one pool as ObjSet args store the object as the value.
            JSRTStack.hold = JSArrMethodBuf.val_hold
            JSBridge__Push(JSArrMethodBuf.s3)
            k = JSBridge__Pop()
            JSRT_ObjSet(JSArrMethodBuf.recv_pin, k, JSRTStack.hold)
            JSRTStack.hold = 0
        }
        JSBridge__SetAttrBits(JSArrMethodBuf.recv_pin, JSArrMethodBuf.s3, JSAttr.DEFAULT)
        ReturnValue(1)
    }
}

// M45: delete index. Missing property succeeds. Non-configurable returns 0.
Function.JSVM__ArrayLikeDelete {
    Input: obj: Address
    Input: idx: Integer
    Output: Integer
    Body: {
        save_o = obj
        save_i = idx
        ot = JSRT_GetType(save_o)
        IfCondition EqualTo(ot, JSType.STRING) ThenBlock: {
            sp = JSRT_GetPayload(save_o)
            sl = 0
            IfCondition NotEqual(sp, 0) ThenBlock: { sl = JSRT_StrLen(sp) }
            IfCondition And(GreaterEqual(save_i, 0), LessThan(save_i, sl)) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            JSBridge__Push(save_o)
            JSBridge__Push(save_i)
            has_el = JSRT_ArrHas(save_o, save_i)
            save_i = JSBridge__Pop()
            save_o = JSBridge__Pop()
            IfCondition EqualTo(has_el, 0) ThenBlock: {
                ReturnValue(1)
            }
            JSBridge__Push(save_o)
            kptr = JSRT__IntToStr(save_i)
            save_o = JSBridge__Pop()
            JSBridge__Push(save_o)
            JSBridge__Push(kptr)
            bits = JSBridge__GetAttrBits(save_o, kptr)
            kptr = JSBridge__Pop()
            save_o = JSBridge__Pop()
            IfCondition EqualTo(BitwiseAnd(bits, JSAttr.C), 0) ThenBlock: { ReturnValue(0) }
            JSBridge__Push(save_o)
            JSBridge__Push(save_i)
            fr = JSVM__ArrIsFrozen(save_o)
            save_i = JSBridge__Pop()
            save_o = JSBridge__Pop()
            IfCondition EqualTo(fr, 1) ThenBlock: { ReturnValue(0) }
            JSRT_ArrSet(save_o, save_i, JSRTState.hole_val)
            ReturnValue(1)
        }
        JSBridge__Push(save_o)
        kptr = JSRT__IntToStr(save_i)
        save_o = JSBridge__Pop()
        JSBridge__Push(save_o)
        JSBridge__Push(kptr)
        has = JSRT_ObjHas(save_o, kptr)
        kptr = JSBridge__Pop()
        save_o = JSBridge__Pop()
        IfCondition EqualTo(has, 0) ThenBlock: { ReturnValue(1) }
        JSBridge__Push(save_o)
        JSBridge__Push(kptr)
        bits = JSBridge__GetAttrBits(save_o, kptr)
        kptr = JSBridge__Pop()
        save_o = JSBridge__Pop()
        IfCondition EqualTo(BitwiseAnd(bits, JSAttr.C), 0) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(save_o)
        JSBridge__Push(kptr)
        fr = JSVM__ArrIsFrozen(save_o)
        kptr = JSBridge__Pop()
        save_o = JSBridge__Pop()
        IfCondition EqualTo(fr, 1) ThenBlock: { ReturnValue(0) }
        JSRT_ObjDelete(save_o, kptr)
        ReturnValue(1)
    }
}

// 1 when Set("length") must fail (!W or frozen). Does not write.
// Arrays only: a length setter is not an array exotic [[DefineOwnProperty]].
Function.JSVM__ArrLenBlocked {
    Input: obj: Address
    Output: Integer
    Body: {
        save_o = obj
        JSBridge__Push(save_o)
        bits = JSBridge__GetAttrBits(save_o, "length")
        save_o = JSBridge__Pop()
        IfCondition EqualTo(BitwiseAnd(bits, JSAttr.W), 0) ThenBlock: { ReturnValue(1) }
        JSBridge__Push(save_o)
        fr = JSVM__ArrIsFrozen(save_o)
        save_o = JSBridge__Pop()
        ReturnValue(fr)
    }
}

// Own length accessor. 1 = setter ran, 0 = getter-only or throw, 2 = no own accessor.
// Does not write a data property. Callers still holding arg1/snap must not use this
// reentrantly; splice/pop call it only at the length write.
Function.JSVM__ArrLenAccSet {
    Input: obj: Address
    Input: len: Integer
    Output: Integer
    Body: {
        JSArrMethodBuf.recv_hold = obj
        JSArrMethodBuf.ix_hold = len
        JSBridge__Push(JSArrMethodBuf.recv_hold)
        JSBridge__Push(JSArrMethodBuf.ix_hold)
        has_s = JSRT_ObjHas(JSArrMethodBuf.recv_hold, "__set_length")
        JSArrMethodBuf.ix_hold = JSBridge__Pop()
        JSArrMethodBuf.recv_hold = JSBridge__Pop()
        IfCondition EqualTo(has_s, 1) ThenBlock: {
            JSBridge__Push(JSArrMethodBuf.recv_hold)
            JSBridge__Push(JSArrMethodBuf.ix_hold)
            sfn = JSRT_ObjGet(JSArrMethodBuf.recv_hold, "__set_length")
            JSArrMethodBuf.s0 = sfn
            JSArrMethodBuf.ix_hold = JSBridge__Pop()
            JSArrMethodBuf.recv_hold = JSBridge__Pop()
            IfCondition NotEqual(JSRT_GetType(JSArrMethodBuf.s0), JSType.FUNCTION) ThenBlock: {
                ReturnValue(0)
            }
            JSBridge__Push(JSArrMethodBuf.recv_hold)
            JSBridge__Push(JSArrMethodBuf.s0)
            nv = JSRT_CreateNumber(JSArrMethodBuf.ix_hold)
            JSArrMethodBuf.val_hold = nv
            sfn = JSBridge__Pop()
            obj = JSBridge__Pop()
            ReturnValue(JSVM__ArrCallSetter(obj, sfn, JSArrMethodBuf.val_hold))
        }
        JSBridge__Push(JSArrMethodBuf.recv_hold)
        has_g = JSRT_ObjHas(JSArrMethodBuf.recv_hold, "__get_length")
        JSArrMethodBuf.recv_hold = JSBridge__Pop()
        IfCondition EqualTo(has_g, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(2)
    }
}

// [[Set]] of "length". !W fails even when the value is unchanged.
// Frozen arrays keep the default W bit, so __frozen__ is checked too.
// An own setter runs before a data write. Getter-only length fails.
Function.JSVM__ArrayLikeSetLen {
    Input: obj: Address
    Input: len: Integer
    Output: Integer
    Body: {
        save_o = obj
        save_l = len
        ot = JSRT_GetType(save_o)
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            JSBridge__Push(save_o)
            JSBridge__Push(save_l)
            bits = JSBridge__GetAttrBits(save_o, "length")
            save_l = JSBridge__Pop()
            save_o = JSBridge__Pop()
            IfCondition EqualTo(BitwiseAnd(bits, JSAttr.W), 0) ThenBlock: { ReturnValue(0) }
            JSBridge__Push(save_o)
            JSBridge__Push(save_l)
            fr = JSVM__ArrIsFrozen(save_o)
            save_l = JSBridge__Pop()
            save_o = JSBridge__Pop()
            IfCondition EqualTo(fr, 1) ThenBlock: { ReturnValue(0) }
            rc = JSRT_ArrSetLen(save_o, save_l)
            ReturnValue(rc)
        }
        JSBridge__Push(save_o)
        JSBridge__Push(save_l)
        acc = JSVM__ArrLenAccSet(save_o, save_l)
        save_l = JSBridge__Pop()
        save_o = JSBridge__Pop()
        IfCondition EqualTo(acc, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(acc, 0) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(save_o)
        JSBridge__Push(save_l)
        bits = JSBridge__GetAttrBits(save_o, "length")
        save_l = JSBridge__Pop()
        save_o = JSBridge__Pop()
        IfCondition EqualTo(BitwiseAnd(bits, JSAttr.W), 0) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(save_o)
        JSBridge__Push(save_l)
        fr = JSVM__ArrIsFrozen(save_o)
        save_l = JSBridge__Pop()
        save_o = JSBridge__Pop()
        IfCondition EqualTo(fr, 1) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(save_o)
        nv = JSRT_CreateNumber(save_l)
        save_o = JSBridge__Pop()
        JSRT_ObjSet(save_o, "length", nv)
        ReturnValue(1)
    }
}

// ─── pop (99) ───
Function.JSVM__ArrPop {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.pop called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        save_recv = JSVM__ArrayToObject(save_recv)
        arr_len = JSVM__ArrayLikeLen(save_recv)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        IfCondition LessEqual(arr_len, 0) ThenBlock: {
            ok = JSVM__ArrayLikeSetLen(save_recv, 0)
            IfCondition EqualTo(ok, 0) ThenBlock: {
                JSVM__ArrWriteFailed()
                ReturnValue(JSRT_Undefined())
            }
            ReturnValue(JSRT_Undefined())
        }
        last_i = Subtract(arr_len, 1)
        JSArrMethodBuf.recv_pin = save_recv
        JSArrMethodBuf.ix_hold = last_i
        JSBridge__Push(JSArrMethodBuf.recv_pin)
        JSBridge__Push(JSArrMethodBuf.ix_hold)
        last_val = JSVM__ArrayLikeGet(JSArrMethodBuf.recv_pin, JSArrMethodBuf.ix_hold)
        JSArrMethodBuf.val_hold = last_val
        last_i = JSBridge__Pop()
        save_recv = JSBridge__Pop()
        last_val = JSArrMethodBuf.val_hold
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        JSArrMethodBuf.recv_pin = save_recv
        JSArrMethodBuf.ix_hold = last_i
        JSArrMethodBuf.val_hold = last_val
        JSBridge__Push(JSArrMethodBuf.recv_pin)
        JSBridge__Push(JSArrMethodBuf.ix_hold)
        JSBridge__Push(JSArrMethodBuf.val_hold)
        ok = JSVM__ArrayLikeDelete(JSArrMethodBuf.recv_pin, JSArrMethodBuf.ix_hold)
        last_val = JSBridge__Pop()
        last_i = JSBridge__Pop()
        save_recv = JSBridge__Pop()
        IfCondition EqualTo(ok, 0) ThenBlock: {
            JSVM__ArrWriteFailed()
            ReturnValue(JSRT_Undefined())
        }
        JSArrMethodBuf.recv_pin = save_recv
        JSArrMethodBuf.ix_hold = last_i
        JSArrMethodBuf.val_hold = last_val
        JSBridge__Push(JSArrMethodBuf.val_hold)
        ok = JSVM__ArrayLikeSetLen(JSArrMethodBuf.recv_pin, JSArrMethodBuf.ix_hold)
        last_val = JSBridge__Pop()
        IfCondition EqualTo(ok, 0) ThenBlock: {
            JSVM__ArrWriteFailed()
            ReturnValue(JSRT_Undefined())
        }
        ReturnValue(last_val)
    }
}

// ─── push (98) ───
Function.JSVM__ArrPush {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_recv = recv
        save_args = args
        save_argc = argc
        rt = JSRT_GetType(save_recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Array.prototype.push called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
