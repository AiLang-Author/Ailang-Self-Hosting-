// =============================================================================
// CONVENIENCE: Install built-in globals (console, Math, etc.)
// Delegates to JSRuntime's built-in registration.
// =============================================================================
Function.JSVM_InstallBuiltins {
    Output: Integer
    Body: {
        // Register JSRuntime built-in native functions
        JSRT_RegisterBuiltins()

        // Create console object and install as global
        // console.log must use handler_id=22 (JSBridge CONSOLE_LOG)
        // which maps to bc_offset = -(22+1) = -23
        // JSRT_CreateConsole used stub handler_id=0 that silently returned undefined
        console_obj = JSRT_CreateObject()
        JSRT__Push(console_obj)
        log_func = JSRT_CreateFunc(-23, 1, 0, "console.log")
        console_obj = JSRT__Pop()
        JSRT_ObjSet(console_obj, "log", log_func)
        JSVM__SetGlobal("console", console_obj)

        // Create Math object and install as global
        math_obj = JSBridge__CreateMathObj()
        JSVM__SetGlobal("Math", math_obj)

        // Create JSON object and install as global
        json_obj = JSRT_CreateObject()
        JSRT__Push(json_obj)
        jp_func = JSBridge__CreateNativeFunc(JSNativeID.JSON_PARSE, "JSON.parse", 1)
        json_obj = JSRT__Pop()
        JSRT_ObjSet(json_obj, "parse", jp_func)
        JSRT__Push(json_obj)
        js_func = JSBridge__CreateNativeFunc(JSNativeID.JSON_STRINGIFY, "JSON.stringify", 1)
        json_obj = JSRT__Pop()
        JSRT_ObjSet(json_obj, "stringify", js_func)
        JSVM__SetGlobal("JSON", json_obj)

        // Install undefined, null, NaN, Infinity as globals
        JSVM__SetGlobal("undefined", JSRT_Undefined())
        JSVM__SetGlobal("null", JSRT_Null())
        // NaN = 0x7FF8000000000000 = 9221120237041090560
        JSVM__SetGlobal("NaN", JSRT_CreateFloat(9221120237041090560))
        // Infinity = 0x7FF0000000000000 = 9218868437227405312
        JSVM__SetGlobal("Infinity", JSRT_CreateFloat(9218868437227405312))

        // Install type conversion constructors as global functions
        // Number() = handler 8, String() = handler 9, Boolean() = handler 10
        num_func = JSBridge__CreateNativeFunc(8, "Number", 1)
        JSVM__SetGlobal("Number", num_func)
        // M19d: Number.POSITIVE_INFINITY / NEGATIVE_INFINITY / NaN (S11.13 A4)
        // IEEE bit patterns as signed 64-bit integers
        JSRT_ObjSet(num_func, "POSITIVE_INFINITY", JSRT_CreateFloat(9218868437227405312))
        JSRT_ObjSet(num_func, "NEGATIVE_INFINITY", JSRT_CreateFloat(-4503599627370496))
        JSRT_ObjSet(num_func, "NaN", JSRT_CreateFloat(9221120237041090560))
        str_func = JSBridge__CreateNativeFunc(9, "String", 1)
        JSVM__SetGlobal("String", str_func)
        bool_func = JSBridge__CreateNativeFunc(10, "Boolean", 1)
        JSVM__SetGlobal("Boolean", bool_func)

        // Install global utility functions
        // isNaN() = handler 11, isFinite() = handler 12
        nan_func = JSBridge__CreateNativeFunc(11, "isNaN", 1)
        JSVM__SetGlobal("isNaN", nan_func)
        fin_func = JSBridge__CreateNativeFunc(12, "isFinite", 1)
        JSVM__SetGlobal("isFinite", fin_func)

        // eval() = handler 193 (JSNativeID.EVAL) — re-entrant pipeline
        eval_func = JSBridge__CreateNativeFunc(193, "eval", 1)
        JSVM__SetGlobal("eval", eval_func)

        // Symbol() = handler 194 — unique keys for iterators etc.
        sym_func = JSBridge__CreateNativeFunc(194, "Symbol", 1)
        // Well-known Symbol.iterator
        iter_sym = JSVM_CreateSymbol(0)
        JSVMSymbol.iterator = iter_sym
        JSRT_FuncPropSet(sym_func, "iterator", iter_sym)
        JSVM__SetGlobal("Symbol", sym_func)

        // parseInt() = handler 13, parseFloat() = handler 14
        pi_func = JSBridge__CreateNativeFunc(13, "parseInt", 1)
        JSVM__SetGlobal("parseInt", pi_func)
        pf_func = JSBridge__CreateNativeFunc(14, "parseFloat", 1)
        JSVM__SetGlobal("parseFloat", pf_func)

        // Install Error constructors as global functions
        // Error = handler 15, TypeError = 16, RangeError = 17, ReferenceError = 18
        // SyntaxError = 19, URIError = 20, EvalError = 21
        err_func = JSBridge__CreateNativeFunc(15, "Error", 1)
        JSVM__SetGlobal("Error", err_func)
        terr_func = JSBridge__CreateNativeFunc(16, "TypeError", 1)
        JSVM__SetGlobal("TypeError", terr_func)
        rerr_func = JSBridge__CreateNativeFunc(17, "RangeError", 1)
        JSVM__SetGlobal("RangeError", rerr_func)
        rferr_func = JSBridge__CreateNativeFunc(18, "ReferenceError", 1)
        JSVM__SetGlobal("ReferenceError", rferr_func)
        serr_func = JSBridge__CreateNativeFunc(19, "SyntaxError", 1)
        JSVM__SetGlobal("SyntaxError", serr_func)
        uerr_func = JSBridge__CreateNativeFunc(20, "URIError", 1)
        JSVM__SetGlobal("URIError", uerr_func)
        eerr_func = JSBridge__CreateNativeFunc(21, "EvalError", 1)
        JSVM__SetGlobal("EvalError", eerr_func)

        // Install Object global with defineProperty, keys, create, etc.
        // NOTE: Uses JSRT__Push/Pop (not JSBridge__Push/Pop) because JSBridge
        // may not be initialized yet when this is called from JSEngine__Run.
        //
        // Object.prototype is the root of the default prototype chain.
        // Cached in JSRTState.object_proto for NEW_OBJECT / instanceof.
        obj_proto = JSRT_CreateObject()
        JSRTState.object_proto = obj_proto

        obj_global = JSRT_CreateObject()
        JSVM__SetGlobal("Object", obj_global)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        dp_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_DEFINE_PROP, "defineProperty", 3)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "defineProperty", dp_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        ok_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_KEYS, "keys", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "keys", ok_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        oc_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_CREATE, "create", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "create", oc_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        oa_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_ASSIGN, "assign", 2)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "assign", oa_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        of_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_FREEZE, "freeze", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "freeze", of_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        osl_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_SEAL, "seal", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "seal", osl_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        ois_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_IS, "is", 2)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "is", ois_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        gpo_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_GET_PROTO_OF, "getPrototypeOf", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "getPrototypeOf", gpo_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        gopd_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_GET_OWN_PROP_DESC, "getOwnPropertyDescriptor", 2)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "getOwnPropertyDescriptor", gopd_func)
        // __ctor__ for new Object() support
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        obj_ctor = JSBridge__CreateNativeFunc(JSNativeID.OBJ_CTOR, "Object", 0)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "__ctor__", obj_ctor)
        // Expose Object.prototype for instanceof and user code
        JSRT_ObjSet(obj_global, "prototype", obj_proto)
        JSRT_ObjSet(obj_ctor, "prototype", obj_proto)
        JSRT_ObjSet(obj_proto, "constructor", obj_ctor)

        // Object.prototype.isPrototypeOf / hasOwnProperty (M22)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        ipo_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_IS_PROTO_OF, "isPrototypeOf", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_proto, "isPrototypeOf", ipo_func)
        JSBridge__SetAttrBits(obj_proto, "isPrototypeOf", 5)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        hop_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_PROTO_HAS_OWN, "hasOwnProperty", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_proto, "hasOwnProperty", hop_func)
        JSBridge__SetAttrBits(obj_proto, "hasOwnProperty", 5)

        // Error constructors were installed before Object.prototype existed.
        // Link Error.prototype → Object.prototype; subclasses → Error.prototype
        // so `new TypeError() instanceof Error` works.
        err_proto = JSRTState.undef_val
        err_g = JSVM__GetGlobal("Error")
        IfCondition EqualTo(JSRT_GetType(err_g), JSType.FUNCTION) ThenBlock: {
            err_proto = JSRT_ObjGet(err_g, "prototype")
            IfCondition EqualTo(JSRT_GetType(err_proto), JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(err_proto, "__proto__", obj_proto)
                JSRT_ObjSet(err_proto, "name", JSRT_CreateString("Error"))
                JSRT_ObjSet(err_proto, "message", JSRT_CreateString(""))
            }
        }
        // Subclass prototypes inherit from Error.prototype
        err_g = JSVM__GetGlobal("TypeError")
        IfCondition EqualTo(JSRT_GetType(err_g), JSType.FUNCTION) ThenBlock: {
            ep = JSRT_ObjGet(err_g, "prototype")
            IfCondition EqualTo(JSRT_GetType(ep), JSType.OBJECT) ThenBlock: {
                IfCondition EqualTo(JSRT_GetType(err_proto), JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(ep, "__proto__", err_proto)
                } ElseBlock: {
                    JSRT_ObjSet(ep, "__proto__", obj_proto)
                }
                JSRT_ObjSet(ep, "name", JSRT_CreateString("TypeError"))
            }
        }
        err_g = JSVM__GetGlobal("RangeError")
        IfCondition EqualTo(JSRT_GetType(err_g), JSType.FUNCTION) ThenBlock: {
            ep = JSRT_ObjGet(err_g, "prototype")
            IfCondition EqualTo(JSRT_GetType(ep), JSType.OBJECT) ThenBlock: {
                IfCondition EqualTo(JSRT_GetType(err_proto), JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(ep, "__proto__", err_proto)
                } ElseBlock: {
                    JSRT_ObjSet(ep, "__proto__", obj_proto)
                }
                JSRT_ObjSet(ep, "name", JSRT_CreateString("RangeError"))
            }
        }
        err_g = JSVM__GetGlobal("ReferenceError")
        IfCondition EqualTo(JSRT_GetType(err_g), JSType.FUNCTION) ThenBlock: {
            ep = JSRT_ObjGet(err_g, "prototype")
            IfCondition EqualTo(JSRT_GetType(ep), JSType.OBJECT) ThenBlock: {
                IfCondition EqualTo(JSRT_GetType(err_proto), JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(ep, "__proto__", err_proto)
                } ElseBlock: {
                    JSRT_ObjSet(ep, "__proto__", obj_proto)
                }
                JSRT_ObjSet(ep, "name", JSRT_CreateString("ReferenceError"))
            }
        }
        err_g = JSVM__GetGlobal("SyntaxError")
        IfCondition EqualTo(JSRT_GetType(err_g), JSType.FUNCTION) ThenBlock: {
            ep = JSRT_ObjGet(err_g, "prototype")
            IfCondition EqualTo(JSRT_GetType(ep), JSType.OBJECT) ThenBlock: {
                IfCondition EqualTo(JSRT_GetType(err_proto), JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(ep, "__proto__", err_proto)
                } ElseBlock: {
                    JSRT_ObjSet(ep, "__proto__", obj_proto)
                }
                JSRT_ObjSet(ep, "name", JSRT_CreateString("SyntaxError"))
            }
        }
        err_g = JSVM__GetGlobal("URIError")
        IfCondition EqualTo(JSRT_GetType(err_g), JSType.FUNCTION) ThenBlock: {
            ep = JSRT_ObjGet(err_g, "prototype")
            IfCondition EqualTo(JSRT_GetType(ep), JSType.OBJECT) ThenBlock: {
                IfCondition EqualTo(JSRT_GetType(err_proto), JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(ep, "__proto__", err_proto)
                } ElseBlock: {
                    JSRT_ObjSet(ep, "__proto__", obj_proto)
                }
                JSRT_ObjSet(ep, "name", JSRT_CreateString("URIError"))
            }
        }
        err_g = JSVM__GetGlobal("EvalError")
        IfCondition EqualTo(JSRT_GetType(err_g), JSType.FUNCTION) ThenBlock: {
            ep = JSRT_ObjGet(err_g, "prototype")
            IfCondition EqualTo(JSRT_GetType(ep), JSType.OBJECT) ThenBlock: {
                IfCondition EqualTo(JSRT_GetType(err_proto), JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(ep, "__proto__", err_proto)
                } ElseBlock: {
                    JSRT_ObjSet(ep, "__proto__", obj_proto)
                }
                JSRT_ObjSet(ep, "name", JSRT_CreateString("EvalError"))
            }
        }

        // Install Array as constructor function with isArray, from
        // CreateNativeFunc → CreateFunc auto-makes .prototype; cache it and
        // link Array.prototype → Object.prototype.
        arr_global = JSBridge__CreateNativeFunc(JSNativeID.ARR_CTOR, "Array", 1)
        JSVM__SetGlobal("Array", arr_global)
        JSRT__Push(arr_global)
        aia_func = JSBridge__CreateNativeFunc(JSNativeID.ARR_IS_ARRAY, "isArray", 1)
        arr_global = JSRT__Pop()
        JSRT_ObjSet(arr_global, "isArray", aia_func)
        JSRT__Push(arr_global)
        af_func = JSBridge__CreateNativeFunc(JSNativeID.ARR_FROM, "from", 1)
        arr_global = JSRT__Pop()
        JSRT_ObjSet(arr_global, "from", af_func)
        // Cache Array.prototype for NEW_ARRAY default [[Prototype]]
        arr_proto = JSRT_ObjGet(arr_global, "prototype")
        JSRTState.array_proto = arr_proto
        IfCondition EqualTo(JSRT_GetType(arr_proto), JSType.OBJECT) ThenBlock: {
            IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                JSRT_ObjSet(arr_proto, "__proto__", JSRTState.object_proto)
            }
            // Mole 16: Array.prototype[Symbol.iterator] / .values
            // Shared function reference used by arguments exotic objects too.
            // Spec: method props are writable+configurable, non-enumerable (bits=5).
            IfCondition NotEqual(JSVMSymbol.iterator, 0) ThenBlock: {
                JSRT__Push(arr_proto)
                av_func = JSBridge__CreateNativeFunc(JSNativeID.ARR_VALUES, "values", 0)
                arr_proto = JSRT__Pop()
                JSRT_ObjSet(arr_proto, "values", av_func)
                JSBridge__SetAttrBits(arr_proto, "values", 5)
                ik = JSVM_SymbolToKey(JSVMSymbol.iterator)
                IfCondition NotEqual(ik, 0) ThenBlock: {
                    JSRT_ObjSet(arr_proto, ik, av_func)
                    JSBridge__SetAttrBits(arr_proto, ik, 5)
                }
                JSRTState.array_values = av_func
            }
        }

        // Install String.fromCharCode on the existing String function (handler 9)
        str_global = JSVM__GetGlobal("String")
        JSRT__Push(str_global)
        fcc_func = JSBridge__CreateNativeFunc(JSNativeID.STR_FROM_CHAR_CODE, "fromCharCode", 1)
        str_global = JSRT__Pop()
        JSRT_ObjSet(str_global, "fromCharCode", fcc_func)

        // Install Date global: Date.now() + new Date() stub
        date_global = JSRT_CreateObject()
        JSVM__SetGlobal("Date", date_global)
        JSRT__Push(date_global)
        dnow = JSBridge__CreateNativeFunc(JSNativeID.DATE_NOW, "now", 0)
        date_global = JSRT__Pop()
        JSRT_ObjSet(date_global, "now", dnow)
        JSRT__Push(date_global)
        dctor = JSBridge__CreateNativeFunc(JSNativeID.DATE_CTOR, "Date", 0)
        date_global = JSRT__Pop()
        JSRT_ObjSet(date_global, "__ctor__", dctor)
        // Date.prototype (minimal)
        dproto = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(dproto, "__proto__", JSRTState.object_proto)
        }
        JSRT_ObjSet(date_global, "prototype", dproto)
        JSRT_ObjSet(dctor, "prototype", dproto)

        // Install RegExp constructor as global function
        regexp_func = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_CTOR, "RegExp", 2)
        JSVM__SetGlobal("RegExp", regexp_func)

        // Create RegExp.prototype with test/exec/toString methods
        regexp_proto = JSRT_CreateObject()
        JSBridgeState.regexp_proto = regexp_proto

        // RegExp.prototype.test
        JSRT__Push(regexp_proto)
        rp_test = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_TEST, "test", 1)
        regexp_proto = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "test", rp_test)

        // RegExp.prototype.exec
        JSRT__Push(regexp_proto)
        rp_exec = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_EXEC, "exec", 1)
        regexp_proto = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "exec", rp_exec)

        // RegExp.prototype.toString
        JSRT__Push(regexp_proto)
        rp_tostr = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_TO_STRING, "toString", 0)
        regexp_proto = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "toString", rp_tostr)

        // Set RegExp.prototype on the constructor function
        JSRT__Push(regexp_func)
        JSRT__Push(regexp_proto)
        rp_cls = JSRT_CreateString("RegExp")
        regexp_proto = JSRT__Pop()
        regexp_func = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "__class__", rp_cls)
        JSRT_ObjSet(regexp_func, "prototype", regexp_proto)

        // Function.prototype.call / .apply / .bind (Mole 18)
        // Every function's [[Prototype]] is Function.prototype for method lookup.
        func_proto = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(func_proto, "__proto__", JSRTState.object_proto)
        }
        JSRTState.function_proto = func_proto
        JSRT__Push(func_proto)
        fc_call = JSBridge__CreateNativeFunc(JSNativeID.FUNC_CALL, "call", 1)
        func_proto = JSRT__Pop()
        JSRT_ObjSet(func_proto, "call", fc_call)
        JSBridge__SetAttrBits(func_proto, "call", 5)
        JSRT__Push(func_proto)
        fc_apply = JSBridge__CreateNativeFunc(JSNativeID.FUNC_APPLY, "apply", 2)
        func_proto = JSRT__Pop()
        JSRT_ObjSet(func_proto, "apply", fc_apply)
        JSBridge__SetAttrBits(func_proto, "apply", 5)
        JSRT__Push(func_proto)
        fc_bind = JSBridge__CreateNativeFunc(JSNativeID.FUNC_BIND, "bind", 1)
        func_proto = JSRT__Pop()
        JSRT_ObjSet(func_proto, "bind", fc_bind)
        JSBridge__SetAttrBits(func_proto, "bind", 5)

        // Global Function constructor (minimal) + .prototype link
        func_global = JSRT_CreateFunc(-1, 1, 0, "Function")
        JSVM__SetGlobal("Function", func_global)
        JSRT_ObjSet(func_global, "prototype", func_proto)
        JSRT_ObjSet(func_proto, "constructor", func_global)

        // Install Promise global as an OBJECT with resolve, reject, and __ctor__
        // (Using OBJECT so arbitrary props like resolve/reject can be set via XSHash)
        promise_global = JSRT_CreateObject()
        JSVM__SetGlobal("Promise", promise_global)
        // __ctor__ for new Promise(executor) support
        JSRT__Push(promise_global)
        pc_func = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CTOR, "Promise", 1)
        promise_global = JSRT__Pop()
        JSRT_ObjSet(promise_global, "__ctor__", pc_func)
        JSRT__Push(promise_global)
        pr_func = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_RESOLVE, "resolve", 1)
        promise_global = JSRT__Pop()
        JSRT_ObjSet(promise_global, "resolve", pr_func)
        JSRT__Push(promise_global)
        pj_func = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_REJECT, "reject", 1)
        promise_global = JSRT__Pop()
        JSRT_ObjSet(promise_global, "reject", pj_func)

        ReturnValue(1)
    }
}

// =============================================================================
// ASYNC GENERATOR HELPER — wrap a value in a fulfilled Promise
// Used by async generators: .next() returns Promise<{value, done}>
// =============================================================================
Function.JSVM__WrapInPromise {
    Input: val: Address
    Output: Address
    Body: {
        save_val = val
        p = JSRT_CreateObject()
        JSRT__Push(p)
        cls_s = JSRT_CreateString("Promise")
        p = JSRT__Pop()
        JSRT_ObjSet(p, "__class__", cls_s)
        JSRT_ObjSet(p, "__state__", JSRT_CreateNumber(1))
        JSRT_ObjSet(p, "__value__", save_val)
        // Attach then/catch methods
        JSRT__Push(p)
        then_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
        p = JSRT__Pop()
        JSRT_FuncSetEnv(then_f, p)
        JSRT_ObjSet(p, "then", then_f)
        JSRT__Push(p)
        catch_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
        p = JSRT__Pop()
        JSRT_FuncSetEnv(catch_f, p)
        JSRT_ObjSet(p, "catch", catch_f)
        ReturnValue(p)
    }
}

// =============================================================================
// GENERATOR .next() — resume generator execution
// func_val = the .next() function (env points to generator JSValue)
// args/argc = arguments passed to .next() (value passed in via arg0)
// Returns: {value, done} iterator result object
// =============================================================================
Function.JSVM__GenNext {
    Input: func_val: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_fv = func_val
        save_args = args
        save_argc = argc
        // Fresh .next() call — do not inherit prior abrupt flag
        JSVMCall.exc_prop = 0
        JSVMCall.thrown_val = 0

        // Get generator JSValue from function's env
        gen_val = JSRT_FuncGetEnv(save_fv)
        IfCondition EqualTo(gen_val, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }

        // Get generator state block
        gen_type = JSRT_GetType(gen_val)
        IfCondition NotEqual(gen_type, JSType.GENERATOR) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }
        gs = JSRT_GetPayload(gen_val)
        IfCondition EqualTo(gs, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }

        // Check state
        gen_state = Dereference(gs)
        // If completed, return {value: undefined, done: true}
        IfCondition EqualTo(gen_state, JSGenConst.ST_COMPLETED) ThenBlock: {
            done_ir = JSRT_CreateIterResult(JSRT_Undefined(), 1)
            ag_f = Dereference(Add(gs, 104))
            IfCondition EqualTo(ag_f, 1) ThenBlock: {
                ReturnValue(JSVM__WrapInPromise(done_ir))
            }
            ReturnValue(done_ir)
        }
        // If executing, throw error (re-entrant)
        IfCondition EqualTo(gen_state, JSGenConst.ST_EXECUTING) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }

        // Mark as executing
        StoreValue(gs, JSGenConst.ST_EXECUTING)

        // Mole 15: keep this bound across yield resumes
        this_cap2 = Dereference(Add(gs, 112))
        IfCondition NotEqual(this_cap2, 0) ThenBlock: {
            JSVM__SetGlobal("this", this_cap2)
        }

        // Mole 17: nest GenNext when already inside a generator (dstr elision, etc.)
        IfCondition EqualTo(JSVMGen.is_gen_exec, 1) ThenBlock: {
            nd = JSVMGen.nest_depth
            IfCondition LessThan(nd, 8) ThenBlock: {
                meta = Add(JSVMGen.nest_meta, Multiply(nd, 64))
                StoreValue(meta, JSVMGen.active_gs)
                StoreValue(Add(meta, 8), JSVMGen.active_genval)
                StoreValue(Add(meta, 16), JSVMGen.caller_pc)
                StoreValue(Add(meta, 24), JSVMGen.caller_sp)
                StoreValue(Add(meta, 32), JSVMGen.caller_fp)
                StoreValue(Add(meta, 40), 1)
                // Isolate FDI flags — inner gen must not inherit outer body_start/mode
                JSVMGen.nest_fdi_only = JSVMGen.fdi_only
                JSVMGen.nest_fdi_limit = JSVMGen.fdi_limit
                JSVMGen.nest_fdi_mode = JSVMGen.fdi_mode
                JSVMGen.fdi_only = 0
                JSVMGen.fdi_limit = 0
                JSVMGen.fdi_mode = 0
                ssz_n = Multiply(JSVMConst.MAX_STACK, 8)
                fsz_n = Multiply(JSVMConst.MAX_FRAMES, JSVMConst.FRAME_SIZE)
                side_n = Multiply(JSVMConst.MAX_FRAMES, 8)
                MemoryCopy(Add(JSVMGen.nest_stk, Multiply(nd, ssz_n)), JSVMGen.stk_buf, ssz_n)
                MemoryCopy(Add(JSVMGen.nest_frm, Multiply(nd, fsz_n)), JSVMGen.frm_buf, fsz_n)
                // Outer frame_envs/funcs/args — first-resume of inner overwrites slot 0
                MemoryCopy(Add(JSVMGen.nest_envs, Multiply(nd, side_n)), JSVMClosure.frame_envs, side_n)
                MemoryCopy(Add(JSVMGen.nest_ffuncs, Multiply(nd, side_n)), JSVMClosure.frame_funcs, side_n)
                MemoryCopy(Add(JSVMGen.nest_fargs, Multiply(nd, side_n)), JSVMClosure.frame_args, side_n)
                JSVMGen.nest_depth = Add(nd, 1)
            }
        }

        // Save caller VM state
        JSVMGen.caller_pc = JSVMState.pc
        JSVMGen.caller_sp = JSVMState.sp
        JSVMGen.caller_fp = JSVMState.fp
        JSVMGen.active_gs = gs
        JSVMGen.active_genval = gen_val
        JSVMGen.is_gen_exec = 1

        // Copy caller stack/frames into static backup buffers
        caller_stk_sz = Multiply(JSVMState.sp, 8)
        IfCondition LessThan(caller_stk_sz, 8) ThenBlock: { caller_stk_sz = 8 }
        JSVMGen.caller_stack = JSVMGen.stk_buf
        MemoryCopy(JSVMGen.caller_stack, JSVMState.stack, caller_stk_sz)

        caller_frm_sz = Multiply(JSVMState.fp, JSVMConst.FRAME_SIZE)
        IfCondition LessThan(caller_frm_sz, JSVMConst.FRAME_SIZE) ThenBlock: { caller_frm_sz = JSVMConst.FRAME_SIZE }
        JSVMGen.caller_frames = JSVMGen.frm_buf
        MemoryCopy(JSVMGen.caller_frames, JSVMState.frames, caller_frm_sz)

        // Handle suspended-start: first .next() — mirror CALL (Mole 17)
        IfCondition EqualTo(gen_state, JSGenConst.ST_SUSPENDED_START) ThenBlock: {
            g_bc = Dereference(Add(gs, 8))
            g_params = Dereference(Add(gs, 16))
            g_locals = Dereference(Add(gs, 24))
            g_args = Dereference(Add(gs, 72))
            g_argc = Dereference(Add(gs, 80))
            g_func = Dereference(Add(gs, 120))
            IfCondition EqualTo(g_func, 0) ThenBlock: {
                g_func = save_fv
            }

            this_cap = Dereference(Add(gs, 112))
            IfCondition NotEqual(this_cap, 0) ThenBlock: {
                JSVM__SetGlobal("this", this_cap)
            }

            // Wipe live VM for gen body; outer mid-body is in caller_* backups.
            JSVMState.sp = 0
            JSVMState.fp = 0
            MemorySet(JSVMState.stack, 0, Multiply(JSVMConst.MAX_STACK, 8))
            MemorySet(JSVMState.frames, 0, Multiply(JSVMConst.MAX_FRAMES, JSVMConst.FRAME_SIZE))
            // Nested: do not clear frame_envs — nest pop restores; but first-resume
            // SetupCallEnv will write slot 0. Outer envs saved in nest_envs.
            IfCondition EqualTo(JSVMGen.nest_depth, 0) ThenBlock: {
                MemorySet(JSVMClosure.frame_envs, 0, Multiply(JSVMConst.MAX_FRAMES, 8))
                MemorySet(JSVMClosure.frame_funcs, 0, Multiply(JSVMConst.MAX_FRAMES, 8))
                MemorySet(JSVMClosure.frame_args, 0, Multiply(JSVMConst.MAX_FRAMES, 8))
            }

            formal_count = BitwiseAnd(g_params, 268435455)
            rest_flag = 0
            rest_idx = -1
            IfCondition NotEqual(BitwiseAnd(g_params, 2147483648), 0) ThenBlock: {
                rest_flag = 1
                rest_idx = Subtract(formal_count, 1)
            }
            unmapped_bit = BitwiseAnd(g_params, 1073741824)

            pf_ok = JSVM__PushFrame(0, 0, 0, formal_count, g_locals)
            IfCondition LessThan(pf_ok, 0) ThenBlock: {
                JSVMState.error = 1
                ReturnValue(JSRT_Undefined())
            }
            JSVM__SetupCallEnv(g_func)
            prev_strict_g = JSVMState.is_strict
            faddr_g = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
            StoreValue(Add(faddr_g, 72), prev_strict_g)
            IfCondition NotEqual(BitwiseAnd(g_params, 536870912), 0) ThenBlock: {
                JSVMState.is_strict = 1
            }

            pi = 0
            WhileLoop LessThan(pi, g_locals) {
                pushed = 0
                IfCondition EqualTo(rest_flag, 1) ThenBlock: {
                    IfCondition EqualTo(pi, rest_idx) ThenBlock: {
                        rest_arr = JSRT_CreateArray()
                        ri = rest_idx
                        WhileLoop LessThan(ri, g_argc) {
                            IfCondition NotEqual(g_args, 0) ThenBlock: {
                                rval = Dereference(Add(g_args, Multiply(ri, 8)))
                                JSRT_ArrPush(rest_arr, rval)
                            }
                            ri = Add(ri, 1)
                        }
                        JSVM__StackPush(rest_arr)
                        pushed = 1
                    }
                    IfCondition EqualTo(pushed, 0) ThenBlock: {
                        IfCondition LessThan(pi, rest_idx) ThenBlock: {
                            IfCondition And(LessThan(pi, g_argc), NotEqual(g_args, 0)) ThenBlock: {
                                pval = Dereference(Add(g_args, Multiply(pi, 8)))
                                JSVM__StackPush(pval)
                            } ElseBlock: {
                                JSVM__StackPush(JSRT_Undefined())
                            }
                            pushed = 1
                        }
                    }
                }
                IfCondition EqualTo(pushed, 0) ThenBlock: {
                    IfCondition And(LessThan(pi, g_argc), NotEqual(g_args, 0)) ThenBlock: {
                        IfCondition EqualTo(rest_flag, 0) ThenBlock: {
                            pval = Dereference(Add(g_args, Multiply(pi, 8)))
                            JSVM__StackPush(pval)
                        } ElseBlock: {
                            JSVM__StackPush(JSRT_Undefined())
                        }
                    } ElseBlock: {
                        JSVM__StackPush(JSRT_Undefined())
                    }
                }
                pi = Add(pi, 1)
            }

            map_n = formal_count
            IfCondition NotEqual(unmapped_bit, 0) ThenBlock: {
                map_n = 0
            }
            IfCondition EqualTo(rest_flag, 1) ThenBlock: {
                IfCondition EqualTo(unmapped_bit, 0) ThenBlock: {
                    map_n = rest_idx
                }
            }
            IfCondition LessThan(map_n, 0) ThenBlock: { map_n = 0 }
            args_obj = JSVM_CreateArguments(g_args, g_argc, g_func, map_n)
            JSVM__SaveArguments()
            JSVM__SetGlobal("arguments", args_obj)
            IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                fi_a = Subtract(JSVMState.fp, 1)
                env_a = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi_a, 8)))
                IfCondition NotEqual(env_a, 0) ThenBlock: {
                    JSRT_ObjSet(env_a, "arguments", args_obj)
                }
            }

            JSVMState.pc = g_bc
        }

        // Handle suspended-yield OR post-FDI init: restore generator's saved state.
        // ST_SUSPENDED_INIT: params bound at call; resume body without yield-arg push.
        is_yield_resume = 0
        is_init_resume = 0
        IfCondition EqualTo(gen_state, JSGenConst.ST_SUSPENDED_YIELD) ThenBlock: {
            is_yield_resume = 1
        }
        IfCondition EqualTo(gen_state, JSGenConst.ST_SUSPENDED_INIT) ThenBlock: {
            is_init_resume = 1
        }
        IfCondition Or(EqualTo(is_yield_resume, 1), EqualTo(is_init_resume, 1)) ThenBlock: {
            g_pc = Dereference(Add(gs, 32))
            g_sp = Dereference(Add(gs, 40))
            g_fp = Dereference(Add(gs, 48))
            g_stk = Dereference(Add(gs, 56))
            g_frm = Dereference(Add(gs, 88))
            g_frm_count = Dereference(Add(gs, 96))

            // Restore stack
            JSVMState.sp = g_sp
            restore_sz = Multiply(g_sp, 8)
            IfCondition GreaterThan(restore_sz, 0) ThenBlock: {
                MemoryCopy(JSVMState.stack, g_stk, restore_sz)
            }

            // Restore frames
            JSVMState.fp = g_fp
            frm_restore_sz = Multiply(g_fp, JSVMConst.FRAME_SIZE)
            IfCondition GreaterThan(frm_restore_sz, 0) ThenBlock: {
                MemoryCopy(JSVMState.frames, g_frm, frm_restore_sz)
            }
            // Mole 17: restore frame_envs / frame_funcs / frame_args
            side_sz = Multiply(g_fp, 8)
            IfCondition GreaterThan(side_sz, 0) ThenBlock: {
                g_envs = Dereference(Add(gs, 128))
                g_ff = Dereference(Add(gs, 136))
                g_fa = Dereference(Add(gs, 144))
                IfCondition NotEqual(g_envs, 0) ThenBlock: {
                    MemoryCopy(JSVMClosure.frame_envs, g_envs, side_sz)
                }
                IfCondition NotEqual(g_ff, 0) ThenBlock: {
                    MemoryCopy(JSVMClosure.frame_funcs, g_ff, side_sz)
                }
                IfCondition NotEqual(g_fa, 0) ThenBlock: {
                    MemoryCopy(JSVMClosure.frame_args, g_fa, side_sz)
                }
            }

            // Set PC
            JSVMState.pc = g_pc

            // Yield resume only: push .next(value) as the yield result
            IfCondition EqualTo(is_yield_resume, 1) ThenBlock: {
                IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                    next_arg = Dereference(save_args)
                    JSVM__StackPush(next_arg)
                } ElseBlock: {
                    JSVM__StackPush(JSRT_Undefined())
                }
            }
        }

        // Run the generator until YIELD or RETURN (both will restore caller state).
        // Mole 15: isolate exception stack so body throws become uncaught here,
        // then rethrow into the .next() caller (not outer try/catch directly).
        save_exc_sp = JSVMState.exc_sp
        JSVMState.exc_sp = 0
        JSVMState.halted = 0
        JSVMState.error = 0
        JSVMState.exc_val = 0
        gen_done = 0
        WhileLoop EqualTo(gen_done, 0) {
            rc = JSVM_Step()
            // Mole 17 FDI-at-call: stop at body_start after param init
            IfCondition EqualTo(JSVMGen.fdi_only, 1) ThenBlock: {
                IfCondition EqualTo(JSVMGen.is_gen_exec, 1) ThenBlock: {
                    IfCondition GreaterThan(JSVMGen.fdi_limit, 0) ThenBlock: {
                        IfCondition GreaterEqual(JSVMState.pc, JSVMGen.fdi_limit) ThenBlock: {
                            // Save gen state as ST_SUSPENDED_INIT at body_start
                            StoreValue(Add(gs, 32), JSVMState.pc)
                            StoreValue(Add(gs, 40), JSVMState.sp)
                            StoreValue(Add(gs, 48), JSVMState.fp)
                            gen_stk = Dereference(Add(gs, 56))
                            copy_sz = Multiply(JSVMState.sp, 8)
                            IfCondition GreaterThan(copy_sz, 0) ThenBlock: {
                                MemoryCopy(gen_stk, JSVMState.stack, copy_sz)
                            }
                            gen_frm = Dereference(Add(gs, 88))
                            frm_copy_sz = Multiply(JSVMState.fp, JSVMConst.FRAME_SIZE)
                            IfCondition GreaterThan(frm_copy_sz, 0) ThenBlock: {
                                MemoryCopy(gen_frm, JSVMState.frames, frm_copy_sz)
                            }
                            StoreValue(Add(gs, 96), JSVMState.fp)
                            side_sz = Multiply(JSVMState.fp, 8)
                            IfCondition GreaterThan(side_sz, 0) ThenBlock: {
                                gen_envs = Dereference(Add(gs, 128))
                                gen_funcs = Dereference(Add(gs, 136))
                                gen_fargs = Dereference(Add(gs, 144))
                                IfCondition NotEqual(gen_envs, 0) ThenBlock: {
                                    MemoryCopy(gen_envs, JSVMClosure.frame_envs, side_sz)
                                }
                                IfCondition NotEqual(gen_funcs, 0) ThenBlock: {
                                    MemoryCopy(gen_funcs, JSVMClosure.frame_funcs, side_sz)
                                }
                                IfCondition NotEqual(gen_fargs, 0) ThenBlock: {
                                    MemoryCopy(gen_fargs, JSVMClosure.frame_args, side_sz)
                                }
                            }
                            StoreValue(gs, JSGenConst.ST_SUSPENDED_INIT)
                            // Restore caller without pushing iter result
                            JSVMState.pc = JSVMGen.caller_pc
                            JSVMState.sp = JSVMGen.caller_sp
                            JSVMState.fp = JSVMGen.caller_fp
                            caller_stk_sz = Multiply(JSVMGen.caller_sp, 8)
                            IfCondition GreaterThan(caller_stk_sz, 0) ThenBlock: {
                                MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, caller_stk_sz)
                            }
                            caller_frm_sz = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
                            IfCondition GreaterThan(caller_frm_sz, 0) ThenBlock: {
                                MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, caller_frm_sz)
                            }
                            JSVMGen.active_gs = 0
                            JSVMGen.is_gen_exec = 0
                            gen_done = 1
                        }
                    }
                }
            }
            // Check if generator execution ended (YIELD or RETURN restored caller)
            IfCondition EqualTo(JSVMGen.is_gen_exec, 0) ThenBlock: {
                gen_done = 1
            }
            IfCondition EqualTo(JSVMState.halted, 1) ThenBlock: {
                gen_done = 1
            }
            IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                gen_done = 1
            }
        }
        JSVMGen.fdi_only = 0
        JSVMGen.fdi_limit = 0
        // Restore outer exception stack depth (THROW-in-gen already restored caller)
        JSVMState.exc_sp = save_exc_sp

        // Did this GenNext exit via yield/return? (is_gen_exec cleared)
        // Nest pop may set is_gen_exec=1 again for outer — don't force-complete then.
        gen_exited = 0
        IfCondition EqualTo(JSVMGen.is_gen_exec, 0) ThenBlock: {
            gen_exited = 1
        }
        // Capture BEFORE nest pop restores outer fdi_mode (nested next must not
        // take the FDI-no-result return path).
        exit_fdi_mode = JSVMGen.fdi_mode

        // Mole 17: pop GenNext nest — re-enter outer generator context
        IfCondition GreaterThan(JSVMGen.nest_depth, 0) ThenBlock: {
            JSVMGen.nest_depth = Subtract(JSVMGen.nest_depth, 1)
            nd2 = JSVMGen.nest_depth
            meta2 = Add(JSVMGen.nest_meta, Multiply(nd2, 64))
            JSVMGen.active_gs = Dereference(meta2)
            JSVMGen.active_genval = Dereference(Add(meta2, 8))
            JSVMGen.caller_pc = Dereference(Add(meta2, 16))
            JSVMGen.caller_sp = Dereference(Add(meta2, 24))
            JSVMGen.caller_fp = Dereference(Add(meta2, 32))
            JSVMGen.is_gen_exec = Dereference(Add(meta2, 40))
            JSVMGen.fdi_only = JSVMGen.nest_fdi_only
            JSVMGen.fdi_limit = JSVMGen.nest_fdi_limit
            JSVMGen.fdi_mode = JSVMGen.nest_fdi_mode
            JSVMGen.nest_fdi_only = 0
            JSVMGen.nest_fdi_limit = 0
            JSVMGen.nest_fdi_mode = 0
            ssz_n2 = Multiply(JSVMConst.MAX_STACK, 8)
            fsz_n2 = Multiply(JSVMConst.MAX_FRAMES, JSVMConst.FRAME_SIZE)
            side_n2 = Multiply(JSVMConst.MAX_FRAMES, 8)
            MemoryCopy(JSVMGen.stk_buf, Add(JSVMGen.nest_stk, Multiply(nd2, ssz_n2)), ssz_n2)
            MemoryCopy(JSVMGen.frm_buf, Add(JSVMGen.nest_frm, Multiply(nd2, fsz_n2)), fsz_n2)
            MemoryCopy(JSVMClosure.frame_envs, Add(JSVMGen.nest_envs, Multiply(nd2, side_n2)), side_n2)
            MemoryCopy(JSVMClosure.frame_funcs, Add(JSVMGen.nest_ffuncs, Multiply(nd2, side_n2)), side_n2)
            MemoryCopy(JSVMClosure.frame_args, Add(JSVMGen.nest_fargs, Multiply(nd2, side_n2)), side_n2)
            JSVMGen.caller_stack = JSVMGen.stk_buf
            JSVMGen.caller_frames = JSVMGen.frm_buf
        }

        // Mole 15: THROW-in-gen set exc_prop + restored caller — do NOT StackPop
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            JSVMState.halted = 0
            JSVMState.error = 0
            ReturnValue(JSRT_Undefined())
        }
        // Uncaught error path (no THROW opcode? safety net)
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
            StoreValue(gs, JSGenConst.ST_COMPLETED)
            pend = JSVMState.exc_val
            JSVMState.pc = JSVMGen.caller_pc
            JSVMState.sp = JSVMGen.caller_sp
            JSVMState.fp = JSVMGen.caller_fp
            c_stk_sz = Multiply(JSVMGen.caller_sp, 8)
            IfCondition GreaterThan(c_stk_sz, 0) ThenBlock: {
                MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, c_stk_sz)
            }
            c_frm_sz = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
            IfCondition GreaterThan(c_frm_sz, 0) ThenBlock: {
                MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, c_frm_sz)
            }
            IfCondition EqualTo(JSVMGen.nest_depth, 0) ThenBlock: {
                JSVMGen.active_gs = 0
                JSVMGen.is_gen_exec = 0
            }
            JSVMState.halted = 0
            JSVMState.error = 0
            IfCondition EqualTo(pend, 0) ThenBlock: {
                pend = JSVM_CreateTypedError("TypeError", "generator threw")
            }
            JSVMState.exc_val = pend
            JSVMCall.thrown_val = pend
            JSVMCall.exc_prop = 1
            ReturnValue(JSRT_Undefined())
        }
        // Gen still marked executing without yield/return — force complete
        // Only when THIS gen did not exit cleanly (not after nest-restore of outer).
        IfCondition And(EqualTo(gen_exited, 0), EqualTo(JSVMGen.nest_depth, 0)) ThenBlock: {
            IfCondition EqualTo(JSVMGen.is_gen_exec, 1) ThenBlock: {
                StoreValue(gs, JSGenConst.ST_COMPLETED)
                JSVMState.pc = JSVMGen.caller_pc
                JSVMState.sp = JSVMGen.caller_sp
                JSVMState.fp = JSVMGen.caller_fp
                c_stk_sz2 = Multiply(JSVMGen.caller_sp, 8)
                IfCondition GreaterThan(c_stk_sz2, 0) ThenBlock: {
                    MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, c_stk_sz2)
                }
                c_frm_sz2 = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
                IfCondition GreaterThan(c_frm_sz2, 0) ThenBlock: {
                    MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, c_frm_sz2)
                }
                JSVMGen.active_gs = 0
                JSVMGen.is_gen_exec = 0
                JSVMState.halted = 0
                JSVMState.error = 0
                halt_ir = JSRT_CreateIterResult(JSRT_Undefined(), 1)
                ReturnValue(halt_ir)
            }
        }

        // FDI-at-call: no iterator result — params bound, suspended at body.
        // Use exit_fdi_mode (pre-nest-pop) so nested .next() returns a real result.
        IfCondition EqualTo(exit_fdi_mode, 1) ThenBlock: {
            JSVMGen.fdi_mode = 0
            ReturnValue(1)
        }

        // The result is already on the stack (pushed by YIELD or RETURN handler)
        result = JSVM__StackPop()

        // For async generators (offset 104 == 1), wrap {value, done} in a Promise
        ag_flag = Dereference(Add(gs, 104))
        IfCondition EqualTo(ag_flag, 1) ThenBlock: {
            ReturnValue(JSVM__WrapInPromise(result))
        }
        ReturnValue(result)
    }
}

// Mole 17: run generator param init (FDI) at call time. Returns 1 ok, 0 on throw.
// Leaves gen suspended at body_start on success.
Function.JSVM__GenInitParams {
    Input: gen_val: Address
    Input: func_val: Address
    Output: Integer
    Body: {
        save_gv = gen_val
        save_fv = func_val
        body_pc = JSRT_FuncGetBodyStart(save_fv)
        // No separate param code — nothing to do
        IfCondition LessEqual(body_pc, 0) ThenBlock: {
            ReturnValue(1)
        }
        f_bc = JSRT_FuncGetBC(save_fv)
        IfCondition LessEqual(body_pc, f_bc) ThenBlock: {
            ReturnValue(1)
        }
        // Use GenNext machinery with fdi_only limit
        JSVMGen.fdi_only = 1
        JSVMGen.fdi_limit = body_pc
        JSVMGen.fdi_mode = 1
        // Build a temporary next-fn whose env is the generator
        next_tmp = JSRT_CreateFunc(-9999, 1, 0, "next")
        JSRT_FuncSetEnv(next_tmp, save_gv)
        empty = JSVMCallBuf.buf
        JSVM__GenNext(next_tmp, empty, 0)
        JSVMGen.fdi_only = 0
        JSVMGen.fdi_limit = 0
        // Throw?
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            JSVMGen.fdi_mode = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
            JSVMGen.fdi_mode = 0
            ReturnValue(0)
        }
        JSVMGen.fdi_mode = 0
        ReturnValue(1)
    }
}

// =============================================================================
// GENERATOR .return() — force generator completion with a value
// =============================================================================

// M20d: track open iterator while generator is suspended mid-dstr / for-of.
// GenReturn/GenThrow call .return() so rtrn-close tests pass.
Function.JSVM__GenTrackOpenIter {
    Input: rec: Address
    Output: Integer
    Body: {
        save_rec = rec
        IfCondition EqualTo(JSVMGen.is_gen_exec, 0) ThenBlock: {
            ReturnValue(0)
        }
        gs = JSVMGen.active_gs
        IfCondition EqualTo(gs, 0) ThenBlock: {
            ReturnValue(0)
        }
        StoreValue(Add(gs, JSGenConst.OFF_OPEN_ITER), save_rec)
        ReturnValue(1)
    }
}

Function.JSVM__GenClearOpenIter {
    Input: rec: Address
    Output: Integer
    Body: {
        save_rec = rec
        gs = JSVMGen.active_gs
        IfCondition EqualTo(gs, 0) ThenBlock: {
            // Also clear on completed gen if matching — use optional
            ReturnValue(0)
        }
        cur = Dereference(Add(gs, JSGenConst.OFF_OPEN_ITER))
        IfCondition EqualTo(cur, save_rec) ThenBlock: {
            StoreValue(Add(gs, JSGenConst.OFF_OPEN_ITER), 0)
        }
        // Clear even if rec is 0 (force clear)
        IfCondition EqualTo(save_rec, 0) ThenBlock: {
            StoreValue(Add(gs, JSGenConst.OFF_OPEN_ITER), 0)
        }
        ReturnValue(1)
    }
}

// Close open iterator on generator with return-completion semantics (kind 0).
// Returns 0 on success, 1 if throw propagated (exc_prop/error set).
Function.JSVM__GenCloseOpenIter {
    Input: gs: Address
    Output: Integer
    Body: {
        save_gs = gs
        IfCondition EqualTo(save_gs, 0) ThenBlock: {
            ReturnValue(0)
        }
        rec = Dereference(Add(save_gs, JSGenConst.OFF_OPEN_ITER))
        StoreValue(Add(save_gs, JSGenConst.OFF_OPEN_ITER), 0)
        IfCondition EqualTo(rec, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Mirror ITER_CLOSE kind=0 (return completion: return() throw wins)
        IfCondition EqualTo(JSVMIter.done, 1) ThenBlock: {
            ReturnValue(0)
        }
        mode_v = JSRT_ObjGet(rec, "__m__")
        mode = 0
        IfCondition EqualTo(JSRT_GetType(mode_v), JSType.NUMBER) ThenBlock: {
            mode = Float_ToInt(JSRT_GetPayload(mode_v))
        }
        IfCondition EqualTo(mode, 0) ThenBlock: {
            JSVMIter.done = 1
            ReturnValue(0)
        }
        iterator = JSRT_ObjGet(rec, "__it__")
        ret_fn = JSRT_ObjGet(iterator, "return")
        rft = JSRT_GetType(ret_fn)
        IfCondition Or(EqualTo(rft, JSType.UNDEFINED), EqualTo(rft, JSType.NULL)) ThenBlock: {
            JSVMIter.done = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(rft, JSType.FUNCTION) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "iterator return is not a function")
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVMState.exc_val = terr
            ReturnValue(1)
        }
        JSVM__SetGlobal("this", iterator)
        empty_buf = JSVMCallBuf.buf
        // Isolate from outer try (assert.throws) — flag only, no ThrowValue
        save_exc_sp = JSVMState.exc_sp
        JSVMState.exc_sp = 0
        ret_res = JSVM__CallFunc(ret_fn, empty_buf, 0)
        JSVMState.exc_sp = save_exc_sp
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            pend = JSVMCall.thrown_val
            IfCondition EqualTo(pend, 0) ThenBlock: {
                pend = JSVMState.exc_val
            }
            IfCondition Or(EqualTo(pend, 0), EqualTo(pend, JSRTState.undef_val)) ThenBlock: {
                pend = JSVM_CreateTypedError("TypeError", "iterator return threw")
            }
            JSVMCall.thrown_val = pend
            JSVMCall.exc_prop = 1
            JSVMState.exc_val = pend
            JSVMState.error = 0
            JSVMState.halted = 0
            ReturnValue(1)
        }
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
            JSVMState.error = 0
            JSVMState.halted = 0
            IfCondition EqualTo(JSVMCall.thrown_val, 0) ThenBlock: {
                JSVMCall.thrown_val = JSVMState.exc_val
            }
            JSVMCall.exc_prop = 1
            ReturnValue(1)
        }
        rrt = JSRT_GetType(ret_res)
        IfCondition And(NotEqual(rrt, JSType.OBJECT), NotEqual(rrt, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(rrt, JSType.ARRAY) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "iterator return result is not an object")
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVMState.exc_val = terr
                ReturnValue(1)
            }
        }
        JSVMIter.done = 1
        ReturnValue(0)
    }
}

Function.JSVM__GenReturn {
    Input: func_val: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_fv = func_val
        save_args = args
        save_argc = argc

        gen_val = JSRT_FuncGetEnv(save_fv)
        IfCondition EqualTo(gen_val, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }
        gen_type = JSRT_GetType(gen_val)
        IfCondition NotEqual(gen_type, JSType.GENERATOR) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }
        gs = JSRT_GetPayload(gen_val)
        IfCondition EqualTo(gs, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }

        gen_state = Dereference(gs)
        // Already completed
        IfCondition EqualTo(gen_state, JSGenConst.ST_COMPLETED) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }

        // Get the return value
        ret_v = JSRT_Undefined()
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            ret_v = Dereference(save_args)
        }

        // M20d: if suspended mid-iteration, IteratorClose open iter (rtrn-close)
        IfCondition Or(EqualTo(gen_state, JSGenConst.ST_SUSPENDED_YIELD), EqualTo(gen_state, JSGenConst.ST_SUSPENDED_INIT)) ThenBlock: {
            close_abrupt = JSVM__GenCloseOpenIter(gs)
            StoreValue(gs, JSGenConst.ST_COMPLETED)
            IfCondition EqualTo(close_abrupt, 1) ThenBlock: {
                // GenCloseOpenIter already set exc_prop + thrown_val
                IfCondition EqualTo(JSVMCall.exc_prop, 0) ThenBlock: {
                    JSVMCall.exc_prop = 1
                }
                ReturnValue(JSRT_Undefined())
            }
            ret_ir = JSRT_CreateIterResult(ret_v, 1)
            ag_rf = Dereference(Add(gs, 104))
            IfCondition EqualTo(ag_rf, 1) ThenBlock: {
                ReturnValue(JSVM__WrapInPromise(ret_ir))
            }
            ReturnValue(ret_ir)
        }

        // suspended-start / other: just complete
        StoreValue(gs, JSGenConst.ST_COMPLETED)
        StoreValue(Add(gs, JSGenConst.OFF_OPEN_ITER), 0)
        ret_ir = JSRT_CreateIterResult(ret_v, 1)
        ag_rf = Dereference(Add(gs, 104))
        IfCondition EqualTo(ag_rf, 1) ThenBlock: {
            ReturnValue(JSVM__WrapInPromise(ret_ir))
        }
        ReturnValue(ret_ir)
    }
}

// =============================================================================
// GENERATOR .throw() — throw exception into generator
// =============================================================================
Function.JSVM__GenThrow {
    Input: func_val: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_fv = func_val
        save_args = args
        save_argc = argc

        gen_val = JSRT_FuncGetEnv(save_fv)
        IfCondition EqualTo(gen_val, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }
        gen_type = JSRT_GetType(gen_val)
        IfCondition NotEqual(gen_type, JSType.GENERATOR) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }
        gs = JSRT_GetPayload(gen_val)
        IfCondition EqualTo(gs, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }

        // Mark completed (simple impl — throw terminates generator)
        StoreValue(gs, JSGenConst.ST_COMPLETED)
        throw_ir = JSRT_CreateIterResult(JSRT_Undefined(), 1)
        ag_tf = Dereference(Add(gs, 104))
        IfCondition EqualTo(ag_tf, 1) ThenBlock: {
            ReturnValue(JSVM__WrapInPromise(throw_ir))
        }
        ReturnValue(throw_ir)
    }
}

// =============================================================================
// FULL PIPELINE: Lex + Parse + Compile + Run
// Takes JS source string and length, returns result JSValue.
// Requires JSLex_Init, JSParse_Init, JSComp_Init, JSVM_Init already called.
// =============================================================================
Function.JSVM_Eval {
    Input: source: Address
    Input: src_len: Integer
    Output: Address
    Body: {
        save_src = source
        save_len = src_len

        // Reset subsystems
        JSLex_Reset()
        JSComp_Reset()
        JSVM_Reset()

        // Tokenize
        tok_count = JSLex_Tokenize(save_src, save_len)
        IfCondition LessEqual(tok_count, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Parse
        root = JSParse_Parse()
        parse_err = JSParse_HasError()
        IfCondition Or(LessThan(root, 0), EqualTo(parse_err, 1)) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Compile
        JSVM__Push(root)
        comp_ok = JSComp_Compile(root)
        root = JSVM__Pop()
        IfCondition EqualTo(comp_ok, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Load bytecode
        bc = JSComp_GetCode()
        bc_len = JSComp_GetCodeLen()
        cp = JSComp_GetConst(0)
        cc = JSComp_GetConstCount()
        JSVM_Load(bc, bc_len, cp, cc)
        JSVM_SetStrict(JSComp_IsStrict())

        // Run
        result = JSVM_Run()
        ReturnValue(result)
    }
}

// =============================================================================
// JSVM__CallFunc — re-entrant VM call from native code
// Calls a JS function with argc arguments from arg_buf, returns the result.
// Saves/restores entire VM state to support calling JS from native handlers
// (e.g., Promise.then callbacks).
// =============================================================================
Function.JSVM__CallFunc {
    Input: func_val: Address
    Input: arg_buf: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_fv = func_val
        save_ab = arg_buf
        save_ac = argc
        JSVMCall.exc_prop = 0

        fv_type = JSRT_GetType(save_fv)
        IfCondition NotEqual(fv_type, JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        cf_bc = JSRT_FuncGetBC(save_fv)
        IfCondition LessThan(cf_bc, 0) ThenBlock: {
            IfCondition EqualTo(cf_bc, -9999) ThenBlock: {
                ReturnValue(JSVM__GenNext(save_fv, save_ab, save_ac))
            }
            IfCondition EqualTo(cf_bc, -9998) ThenBlock: {
                ReturnValue(JSVM__GenReturn(save_fv, save_ab, save_ac))
            }
            IfCondition EqualTo(cf_bc, -9997) ThenBlock: {
                ReturnValue(JSVM__GenThrow(save_fv, save_ab, save_ac))
            }
            ReturnValue(JSRT_Undefined())
        }
        // Mole 15: generator function call via CallFunc (e.g. custom @@iterator)
        cf_env = JSRT_FuncGetEnv(save_fv)
        IfCondition EqualTo(cf_env, 71) ThenBlock: {
            gen_val = JSRT_CreateGenerator(save_fv, save_ab, save_ac)
            next_func = JSRT_CreateFunc(-9999, 1, 0, "next")
            JSRT_FuncSetEnv(next_func, gen_val)
            ret_func = JSRT_CreateFunc(-9998, 1, 0, "return")
            JSRT_FuncSetEnv(ret_func, gen_val)
            throw_func = JSRT_CreateFunc(-9997, 1, 0, "throw")
            JSRT_FuncSetEnv(throw_func, gen_val)
            gen_obj = JSRT_CreateObject()
            JSRT_ObjSet(gen_obj, "next", next_func)
            JSRT_ObjSet(gen_obj, "return", ret_func)
            JSRT_ObjSet(gen_obj, "throw", throw_func)
            JSRT_ObjSet(gen_obj, "__gen__", gen_val)
            ReturnValue(gen_obj)
        }
        cf_params = JSRT_FuncGetParams(save_fv)
        // 0x0FFFFFFF — bits 0-27 count; 28=arrow, 29=strict, 30=unmapped, 31=rest
        formal_n = BitwiseAnd(cf_params, 268435455)
        cf_locals = JSRT_FuncGetLocals(save_fv)

        // Mole 15: nest on LIVE stack/frames so try/catch unwind works.
        // Previous wipe+restore swallowed throws from next()/@@iterator.
        entry_fp = JSVMState.fp
        entry_pc = JSVMState.pc
        entry_sp = JSVMState.sp
        entry_halted = JSVMState.halted

        save_ff0 = Dereference(JSVMClosure.frame_funcs)
        save_fe0 = Dereference(JSVMClosure.frame_envs)
        save_fa0 = Dereference(JSVMClosure.frame_args)
        save_gen_exec = JSVMGen.is_gen_exec
        save_gen_gs = JSVMGen.active_gs

        pf_ok = JSVM__PushFrame(entry_pc, entry_sp, entry_sp, formal_n, cf_locals)
        IfCondition LessThan(pf_ok, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        JSVM__SetupCallEnv(save_fv)
        // Mole 16: per-function strict for CallFunc re-entry
        prev_strict_cf = JSVMState.is_strict
        faddr_cf = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
        StoreValue(Add(faddr_cf, 72), prev_strict_cf)
        IfCondition NotEqual(BitwiseAnd(cf_params, 536870912), 0) ThenBlock: {
            JSVMState.is_strict = 1
        }

        li = 0
        WhileLoop LessThan(li, cf_locals) {
            IfCondition LessThan(li, save_ac) ThenBlock: {
                pval = Dereference(Add(save_ab, Multiply(li, 8)))
                JSVM__StackPush(pval)
            } ElseBlock: {
                JSVM__StackPush(JSRT_Undefined())
            }
            li = Add(li, 1)
        }

        // Mole 16: mirror CALL — SaveArguments + install args object.
        // Without this, RETURN's RestoreArguments sees frame_args=0 and
        // rebinds global "arguments" to a fresh undefined, breaking the
        // caller's arguments after getter/setter CallFunc re-entry.
        // Arrows (bit 28): leave outer arguments alone.
        IfCondition EqualTo(BitwiseAnd(cf_params, 268435456), 0) ThenBlock: {
            map_n_cf = formal_n
            IfCondition NotEqual(BitwiseAnd(cf_params, 1073741824), 0) ThenBlock: {
                map_n_cf = 0
            }
            args_obj_cf = JSVM_CreateArguments(save_ab, save_ac, save_fv, map_n_cf)
            JSVM__SaveArguments()
            JSVM__SetGlobal("arguments", args_obj_cf)
        } ElseBlock: {
            // Still snapshot so RETURN RestoreArguments is a no-op rebind
            JSVM__SaveArguments()
        }

        JSVMState.pc = cf_bc
        JSVMState.halted = 0

        done_n = 0
        WhileLoop EqualTo(done_n, 0) {
            IfCondition LessEqual(JSVMState.fp, entry_fp) ThenBlock: {
                done_n = 1
            }
            IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                done_n = 1
            }
            IfCondition EqualTo(JSVMState.halted, 1) ThenBlock: {
                done_n = 1
            }
            IfCondition EqualTo(done_n, 0) ThenBlock: {
                rc = JSVM_Step()
                IfCondition EqualTo(rc, 0) ThenBlock: {
                    JSVMState.halted = 1
                }
                IfCondition EqualTo(rc, -1) ThenBlock: {
                    JSVMState.halted = 1
                }
            }
        }

        prop = 0
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
            prop = 1
        }
        IfCondition LessThan(JSVMState.fp, entry_fp) ThenBlock: {
            prop = 1
        }
        IfCondition EqualTo(JSVMState.fp, entry_fp) ThenBlock: {
            IfCondition NotEqual(JSVMState.pc, entry_pc) ThenBlock: {
                IfCondition EqualTo(JSVMState.halted, 0) ThenBlock: {
                    prop = 1
                }
            }
        }
        IfCondition EqualTo(prop, 1) ThenBlock: {
            JSVMCall.exc_prop = 1
            // Preserve abrupt value for caller (ITER_CLOSE, getters, etc.)
            IfCondition EqualTo(JSVMCall.thrown_val, 0) ThenBlock: {
                IfCondition NotEqual(JSVMState.exc_val, 0) ThenBlock: {
                    JSVMCall.thrown_val = JSVMState.exc_val
                }
            }
            // If THROW already unwound to an outer catch, do not clobber it.
            // Only restore when uncaught (error) or still nested above entry.
            need_restore = 0
            IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                need_restore = 1
            }
            IfCondition GreaterThan(JSVMState.fp, entry_fp) ThenBlock: {
                need_restore = 1
            }
            IfCondition EqualTo(need_restore, 1) ThenBlock: {
                JSVMState.fp = entry_fp
                JSVMState.sp = entry_sp
                JSVMState.pc = entry_pc
                JSVMState.halted = entry_halted
                JSVMState.error = 0
                JSVMState.is_strict = prev_strict_cf
            }
            StoreValue(JSVMClosure.frame_funcs, save_ff0)
            StoreValue(JSVMClosure.frame_envs, save_fe0)
            StoreValue(JSVMClosure.frame_args, save_fa0)
            JSVMGen.is_gen_exec = save_gen_exec
            JSVMGen.active_gs = save_gen_gs
            ReturnValue(JSRT_Undefined())
        }

        cf_result = JSRT_Undefined()
        IfCondition GreaterThan(JSVMState.sp, entry_sp) ThenBlock: {
            cf_result = JSVM__StackPop()
        }
        JSVMState.halted = entry_halted
        JSVMState.pc = entry_pc

        StoreValue(JSVMClosure.frame_funcs, save_ff0)
        StoreValue(JSVMClosure.frame_envs, save_fe0)
        StoreValue(JSVMClosure.frame_args, save_fa0)
        JSVMGen.is_gen_exec = save_gen_exec
        JSVMGen.active_gs = save_gen_gs

        ReturnValue(cf_result)
    }
}
