        str_proto = JSRT__Pop()
        str_global = JSRT__Pop()
        JSRT_ObjSet(str_proto, "toString", sm)
        JSBridge__SetAttrBits(str_proto, "toString", 5)
        JSRT__Push(str_global)
        JSRT__Push(str_proto)
        sm = JSBridge__CreateNativeFunc(JSNativeID.STR_INCLUDES, "includes", 1)
        str_proto = JSRT__Pop()
        str_global = JSRT__Pop()
        JSRT_ObjSet(str_proto, "includes", sm)
        JSBridge__SetAttrBits(str_proto, "includes", 5)
        JSRT__Push(str_global)
        JSRT__Push(str_proto)
        sm = JSBridge__CreateNativeFunc(JSNativeID.STR_STARTS_WITH, "startsWith", 1)
        str_proto = JSRT__Pop()
        str_global = JSRT__Pop()
        JSRT_ObjSet(str_proto, "startsWith", sm)
        JSBridge__SetAttrBits(str_proto, "startsWith", 5)
        JSRT__Push(str_global)
        JSRT__Push(str_proto)
        sm = JSBridge__CreateNativeFunc(JSNativeID.STR_ENDS_WITH, "endsWith", 1)
        str_proto = JSRT__Pop()
        str_global = JSRT__Pop()
        JSRT_ObjSet(str_proto, "endsWith", sm)
        JSBridge__SetAttrBits(str_proto, "endsWith", 5)
        JSRT__Push(str_global)
        JSRT__Push(str_proto)
        sm = JSBridge__CreateNativeFunc(JSNativeID.STR_TRIM_START, "trimStart", 0)
        str_proto = JSRT__Pop()
        str_global = JSRT__Pop()
        JSRT_ObjSet(str_proto, "trimStart", sm)
        JSBridge__SetAttrBits(str_proto, "trimStart", 5)
        // trimLeft alias
        JSRT_ObjSet(str_proto, "trimLeft", sm)
        JSBridge__SetAttrBits(str_proto, "trimLeft", 5)
        JSRT__Push(str_global)
        JSRT__Push(str_proto)
        sm = JSBridge__CreateNativeFunc(JSNativeID.STR_TRIM_END, "trimEnd", 0)
        str_proto = JSRT__Pop()
        str_global = JSRT__Pop()
        JSRT_ObjSet(str_proto, "trimEnd", sm)
        JSBridge__SetAttrBits(str_proto, "trimEnd", 5)
        JSRT_ObjSet(str_proto, "trimRight", sm)
        JSBridge__SetAttrBits(str_proto, "trimRight", 5)
        JSRT__Push(str_global)
        JSRT__Push(str_proto)
        sm = JSBridge__CreateNativeFunc(JSNativeID.STR_PAD_START, "padStart", 1)
        str_proto = JSRT__Pop()
        str_global = JSRT__Pop()
        JSRT_ObjSet(str_proto, "padStart", sm)
        JSBridge__SetAttrBits(str_proto, "padStart", 5)
        // M32: String.prototype.at
        JSRT__Push(str_global)
        JSRT__Push(str_proto)
        sm = JSBridge__CreateNativeFunc(JSNativeID.STR_AT, "at", 1)
        str_proto = JSRT__Pop()
        str_global = JSRT__Pop()
        JSRT_ObjSet(str_proto, "at", sm)
        JSBridge__SetAttrBits(str_proto, "at", 5)
        JSRT__Push(str_global)
        JSRT__Push(str_proto)
        sm = JSBridge__CreateNativeFunc(JSNativeID.STR_PAD_END, "padEnd", 1)
        str_proto = JSRT__Pop()
        str_global = JSRT__Pop()
        JSRT_ObjSet(str_proto, "padEnd", sm)
        JSBridge__SetAttrBits(str_proto, "padEnd", 5)
        // M30c: match / search (RegExp or string)
        JSRT__Push(str_global)
        JSRT__Push(str_proto)
        sm = JSBridge__CreateNativeFunc(JSNativeID.STR_MATCH_RE, "match", 1)
        str_proto = JSRT__Pop()
        str_global = JSRT__Pop()
        JSRT_ObjSet(str_proto, "match", sm)
        JSBridge__SetAttrBits(str_proto, "match", 5)
        JSRT__Push(str_global)
        JSRT__Push(str_proto)
        sm = JSBridge__CreateNativeFunc(JSNativeID.STR_SEARCH_RE, "search", 1)
        str_proto = JSRT__Pop()
        str_global = JSRT__Pop()
        JSRT_ObjSet(str_proto, "search", sm)
        JSBridge__SetAttrBits(str_proto, "search", 5)
        // Attach prototype on constructor (toString/valueOf later)
        JSRT_ObjSet(str_global, "prototype", str_proto)
        JSRT_ObjSet(str_proto, "constructor", str_global)
        JSBridge__SetAttrBits(str_proto, "constructor", 1)

        // M44: Date as real native constructor (was object+__ctor__; brand broken)
        date_global = JSBridge__CreateNativeFunc(JSNativeID.DATE_CTOR, "Date", 0)
        JSVM__SetGlobal("Date", date_global)
        JSRT__Push(date_global)
        dnow = JSBridge__CreateNativeFunc(JSNativeID.DATE_NOW, "now", 0)
        date_global = JSRT__Pop()
        JSRT_ObjSet(date_global, "now", dnow)
        JSBridge__SetAttrBits(date_global, "now", 5)
        // Date.prototype + brand for Object.prototype.toString
        dproto = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(dproto, "__proto__", JSRTState.object_proto)
        }
        JSRT_ObjSet(dproto, "__class__", JSRT_CreateString("Date"))
        JSRT_ObjSet(date_global, "prototype", dproto)
        JSBridge__SetAttrBits(date_global, "prototype", 0)

        // Install RegExp constructor as global function
        regexp_func = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_CTOR, "RegExp", 2)
        JSVM__SetGlobal("RegExp", regexp_func)

        // Create RegExp.prototype with test/exec/toString methods
        regexp_proto = JSRT_CreateObject()
        JSBridgeState.regexp_proto = regexp_proto

        // RegExp.prototype.test
        JSRT__Push(regexp_proto)
        rp_test = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_TEST, "test", 1)
        regexp_proto = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "test", rp_test)

        // RegExp.prototype.exec
        JSRT__Push(regexp_proto)
        rp_exec = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_EXEC, "exec", 1)
        regexp_proto = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "exec", rp_exec)

        // RegExp.prototype.toString
        JSRT__Push(regexp_proto)
        rp_tostr = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_TO_STRING, "toString", 0)
        regexp_proto = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "toString", rp_tostr)

        // M30d: prototype accessors (source/flags/global/…) via __get_* + data placeholder
        // so hasOwnProperty is true and GET_PROP invokes getters.
        JSRT__Push(regexp_proto)
        rg = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_GET_SOURCE, "get source", 0)
        regexp_proto = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "__get_source", rg)
        JSRT_ObjSet(regexp_proto, "source", JSRT_Undefined())
        JSBridge__SetAttrBits(regexp_proto, "source", 4)
        JSRT__Push(regexp_proto)
        rg = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_GET_FLAGS, "get flags", 0)
        regexp_proto = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "__get_flags", rg)
        JSRT_ObjSet(regexp_proto, "flags", JSRT_Undefined())
        JSBridge__SetAttrBits(regexp_proto, "flags", 4)
        JSRT__Push(regexp_proto)
        rg = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_GET_GLOBAL, "get global", 0)
        regexp_proto = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "__get_global", rg)
        JSRT_ObjSet(regexp_proto, "global", JSRT_Undefined())
        JSBridge__SetAttrBits(regexp_proto, "global", 4)
        JSRT__Push(regexp_proto)
        rg = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_GET_IGNORE_CASE, "get ignoreCase", 0)
        regexp_proto = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "__get_ignoreCase", rg)
        JSRT_ObjSet(regexp_proto, "ignoreCase", JSRT_Undefined())
        JSBridge__SetAttrBits(regexp_proto, "ignoreCase", 4)
        JSRT__Push(regexp_proto)
        rg = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_GET_MULTILINE, "get multiline", 0)
        regexp_proto = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "__get_multiline", rg)
        JSRT_ObjSet(regexp_proto, "multiline", JSRT_Undefined())
        JSBridge__SetAttrBits(regexp_proto, "multiline", 4)
        JSRT__Push(regexp_proto)
        rg = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_GET_DOTALL, "get dotAll", 0)
        regexp_proto = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "__get_dotAll", rg)
        JSRT_ObjSet(regexp_proto, "dotAll", JSRT_Undefined())
        JSBridge__SetAttrBits(regexp_proto, "dotAll", 4)
        JSRT__Push(regexp_proto)
        rg = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_GET_STICKY, "get sticky", 0)
        regexp_proto = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "__get_sticky", rg)
        JSRT_ObjSet(regexp_proto, "sticky", JSRT_Undefined())
        JSBridge__SetAttrBits(regexp_proto, "sticky", 4)
        JSRT__Push(regexp_proto)
        rg = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_GET_UNICODE, "get unicode", 0)
        regexp_proto = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "__get_unicode", rg)
        JSRT_ObjSet(regexp_proto, "unicode", JSRT_Undefined())
        JSBridge__SetAttrBits(regexp_proto, "unicode", 4)
        JSRT__Push(regexp_proto)
        rg = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_GET_UNICODE_SETS, "get unicodeSets", 0)
        regexp_proto = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "__get_unicodeSets", rg)
        JSRT_ObjSet(regexp_proto, "unicodeSets", JSRT_Undefined())
        JSBridge__SetAttrBits(regexp_proto, "unicodeSets", 4)
        JSRT__Push(regexp_proto)
        rg = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_GET_HAS_INDICES, "get hasIndices", 0)
        regexp_proto = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "__get_hasIndices", rg)
        JSRT_ObjSet(regexp_proto, "hasIndices", JSRT_Undefined())
        JSBridge__SetAttrBits(regexp_proto, "hasIndices", 4)

        // M30f: @@match / @@replace / @@search / @@split on RegExp.prototype
        IfCondition NotEqual(JSVMSymbol.match, 0) ThenBlock: {
            JSRT__Push(regexp_proto)
            rsm = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_SYMBOL_MATCH, "[Symbol.match]", 1)
            regexp_proto = JSRT__Pop()
            mk = JSVM_SymbolToKey(JSVMSymbol.match)
            IfCondition NotEqual(mk, 0) ThenBlock: {
                JSRT_ObjSet(regexp_proto, mk, rsm)
                JSBridge__SetAttrBits(regexp_proto, mk, 5)
            }
        }
        IfCondition NotEqual(JSVMSymbol.replace, 0) ThenBlock: {
            JSRT__Push(regexp_proto)
            rsr = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_SYMBOL_REPLACE, "[Symbol.replace]", 2)
            regexp_proto = JSRT__Pop()
            rk = JSVM_SymbolToKey(JSVMSymbol.replace)
            IfCondition NotEqual(rk, 0) ThenBlock: {
                JSRT_ObjSet(regexp_proto, rk, rsr)
                JSBridge__SetAttrBits(regexp_proto, rk, 5)
            }
        }
        IfCondition NotEqual(JSVMSymbol.search, 0) ThenBlock: {
            JSRT__Push(regexp_proto)
            rss = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_SYMBOL_SEARCH, "[Symbol.search]", 1)
            regexp_proto = JSRT__Pop()
            sk = JSVM_SymbolToKey(JSVMSymbol.search)
            IfCondition NotEqual(sk, 0) ThenBlock: {
                JSRT_ObjSet(regexp_proto, sk, rss)
                JSBridge__SetAttrBits(regexp_proto, sk, 5)
            }
        }
        IfCondition NotEqual(JSVMSymbol.split, 0) ThenBlock: {
            JSRT__Push(regexp_proto)
            rsp = JSBridge__CreateNativeFunc(JSNativeID.REGEXP_SYMBOL_SPLIT, "[Symbol.split]", 2)
            regexp_proto = JSRT__Pop()
            pk = JSVM_SymbolToKey(JSVMSymbol.split)
            IfCondition NotEqual(pk, 0) ThenBlock: {
                JSRT_ObjSet(regexp_proto, pk, rsp)
                JSBridge__SetAttrBits(regexp_proto, pk, 5)
            }
        }

        // Set RegExp.prototype on the constructor function
        JSRT__Push(regexp_func)
        JSRT__Push(regexp_proto)
        rp_cls = JSRT_CreateString("RegExp")
        regexp_proto = JSRT__Pop()
        regexp_func = JSRT__Pop()
        JSRT_ObjSet(regexp_proto, "__class__", rp_cls)
        JSRT_ObjSet(regexp_func, "prototype", regexp_proto)

        // Function.prototype.call / .apply / .bind (Mole 18)
        // Every function's [[Prototype]] is Function.prototype for method lookup.
        func_proto = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(func_proto, "__proto__", JSRTState.object_proto)
        }
        JSRTState.function_proto = func_proto
        JSRT__Push(func_proto)
        fc_call = JSBridge__CreateNativeFunc(JSNativeID.FUNC_CALL, "call", 1)
        func_proto = JSRT__Pop()
        JSRT_ObjSet(func_proto, "call", fc_call)
        JSBridge__SetAttrBits(func_proto, "call", 5)
        JSRT__Push(func_proto)
        fc_apply = JSBridge__CreateNativeFunc(JSNativeID.FUNC_APPLY, "apply", 2)
        func_proto = JSRT__Pop()
        JSRT_ObjSet(func_proto, "apply", fc_apply)
        JSBridge__SetAttrBits(func_proto, "apply", 5)
        JSRT__Push(func_proto)
        fc_bind = JSBridge__CreateNativeFunc(JSNativeID.FUNC_BIND, "bind", 1)
        func_proto = JSRT__Pop()
        JSRT_ObjSet(func_proto, "bind", fc_bind)
        JSBridge__SetAttrBits(func_proto, "bind", 5)

        // M81: Global Function constructor — real native (Function body → eval)
        func_global = JSBridge__CreateNativeFunc(JSNativeID.FUNC_CTOR, "Function", 1)
        JSVM__SetGlobal("Function", func_global)
        JSRT_ObjSet(func_global, "prototype", func_proto)
        JSRT_ObjSet(func_proto, "constructor", func_global)
        // length is 1 per ES (varargs); name set by CreateNativeFunc

        // M88: GeneratorFunction.prototype + Generator.prototype
        // genFn → GeneratorFunction.prototype → Function.prototype
        // genFn.prototype → Generator.prototype (no own props)
        gen_inst_proto = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(gen_inst_proto, "__proto__", JSRTState.object_proto)
        }
        JSRTState.generator_proto = gen_inst_proto
        gen_fn_proto = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.function_proto, 0) ThenBlock: {
            JSRT_ObjSet(gen_fn_proto, "__proto__", JSRTState.function_proto)
        }
        JSRT_ObjSet(gen_fn_proto, "prototype", gen_inst_proto)
        JSRTState.generator_function_proto = gen_fn_proto

        // M92: Promise is a real constructor FUNCTION (typeof + instanceof).
        // Static methods on function PropTable via FuncPropSet.
        pc_func = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CTOR, "Promise", 1)
        JSVM__SetGlobal("Promise", pc_func)
        promise_global = pc_func
        JSRT__Push(promise_global)
        pr_func = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_RESOLVE, "resolve", 1)
        promise_global = JSRT__Pop()
        JSRT_FuncPropSet(promise_global, "resolve", pr_func)
        JSRT__Push(promise_global)
        pj_func = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_REJECT, "reject", 1)
        promise_global = JSRT__Pop()
        JSRT_FuncPropSet(promise_global, "reject", pj_func)
        // M30b: Promise.all / race / allSettled / any
        JSRT__Push(promise_global)
        pa_func = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_ALL, "all", 1)
        promise_global = JSRT__Pop()
        JSRT_FuncPropSet(promise_global, "all", pa_func)
        JSRT__Push(promise_global)
        prace = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_RACE, "race", 1)
        promise_global = JSRT__Pop()
        JSRT_FuncPropSet(promise_global, "race", prace)
        JSRT__Push(promise_global)
        pas = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_ALL_SETTLED, "allSettled", 1)
        promise_global = JSRT__Pop()
        JSRT_FuncPropSet(promise_global, "allSettled", pas)
        JSRT__Push(promise_global)
        pany = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_ANY, "any", 1)
        promise_global = JSRT__Pop()
        JSRT_FuncPropSet(promise_global, "any", pany)
        // Promise.prototype with then/catch/finally
        p_proto = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(p_proto, "__proto__", JSRTState.object_proto)
        }
        JSRT__Push(promise_global)
        JSRT__Push(p_proto)
        pt = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
        p_proto = JSRT__Pop()
        promise_global = JSRT__Pop()
        JSRT_ObjSet(p_proto, "then", pt)
        JSBridge__SetAttrBits(p_proto, "then", 5)
        JSRT__Push(promise_global)
        JSRT__Push(p_proto)
        pc2 = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
        p_proto = JSRT__Pop()
        promise_global = JSRT__Pop()
        JSRT_ObjSet(p_proto, "catch", pc2)
        JSBridge__SetAttrBits(p_proto, "catch", 5)
        JSRT__Push(promise_global)
        JSRT__Push(p_proto)
        pf = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_FINALLY, "finally", 1)
        p_proto = JSRT__Pop()
        promise_global = JSRT__Pop()
        JSRT_ObjSet(p_proto, "finally", pf)
        JSBridge__SetAttrBits(p_proto, "finally", 5)
        // Replace CreateNativeFunc auto-prototype with shared Promise.prototype
        JSRT_FuncPropSet(promise_global, "prototype", p_proto)
        JSRT_ObjSet(p_proto, "constructor", promise_global)
        JSRTState.promise_proto = p_proto

        // M33: top-level `this` / globalThis — compiler emits GET_GLOBAL("this").
        // Without a binding, script `this` is a ReferenceError (breaks many test262
        // truthy-object Attribute probes that use `this` / globalThis).
        glob_this = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(glob_this, "__proto__", JSRTState.object_proto)
        }
        JSVM__SetGlobal("this", glob_this)
        JSVM__SetGlobal("globalThis", glob_this)

        // ES global immortals: re-mirror + non-configurable/non-writable attrs
        // so CanDeclareGlobalFunction rejects eval("function NaN(){}").
        nan_v = JSVM__GetGlobal("NaN")
        inf_v = JSVM__GetGlobal("Infinity")
        und_v = JSVM__GetGlobal("undefined")
        JSRT_ObjSet(glob_this, "NaN", nan_v)
        JSRT_ObjSet(glob_this, "Infinity", inf_v)
        JSRT_ObjSet(glob_this, "undefined", und_v)
        JSBridge__SetAttrBits(glob_this, "NaN", 0)
        JSBridge__SetAttrBits(glob_this, "Infinity", 0)
        JSBridge__SetAttrBits(glob_this, "undefined", 0)

        ReturnValue(1)
    }
}

// =============================================================================
// ASYNC GENERATOR HELPER — wrap a value in a fulfilled Promise
// Used by async generators: .next() returns Promise<{value, done}>
// =============================================================================
Function.JSVM__WrapInPromise {
    Input: val: Address
    Output: Address
    Body: {
        save_val = val
        p = JSRT_CreateObject()
        // M92: [[Prototype]] = Promise.prototype for instanceof
        IfCondition NotEqual(JSRTState.promise_proto, 0) ThenBlock: {
            JSRT_ObjSet(p, "__proto__", JSRTState.promise_proto)
        }
        JSRT__Push(p)
        cls_s = JSRT_CreateString("Promise")
        p = JSRT__Pop()
        JSRT_ObjSet(p, "__class__", cls_s)
        JSRT_ObjSet(p, "__state__", JSRT_CreateNumber(1))
        JSRT_ObjSet(p, "__value__", save_val)
        // Prefer Promise.prototype methods; own only if no shared proto.
        IfCondition EqualTo(JSRTState.promise_proto, 0) ThenBlock: {
            JSRT__Push(p)
            then_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
            p = JSRT__Pop()
            JSRT_FuncSetEnv(then_f, p)
            JSRT_ObjSet(p, "then", then_f)
            JSRT__Push(p)
            catch_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            p = JSRT__Pop()
            JSRT_FuncSetEnv(catch_f, p)
            JSRT_ObjSet(p, "catch", catch_f)
        }
        ReturnValue(p)
    }
}

// M128ax: async function completion — PromiseResolve (adopt settled Promise).
// Plain WrapInPromise always fulfilled, so `return Promise.reject(x)` became a
// fulfilled Promise-of-Promise. Copy settled state into a *fresh* Promise so
// ReclaimScope cannot free a frame-local promise returned by identity.
Function.JSVM__AsyncReturnPromise {
    Input: val: Address
    Output: Address
    Body: {
        save_val = val
        IfCondition EqualTo(JSRT_GetType(save_val), JSType.OBJECT) ThenBlock: {
            p_st = JSRT_ObjGet(save_val, "__state__")
            IfCondition EqualTo(JSRT_GetType(p_st), JSType.NUMBER) ThenBlock: {
                sn = Float_ToInt(JSRT_GetPayload(p_st))
                IfCondition EqualTo(sn, 1) ThenBlock: {
                    p_val = JSRT_ObjGet(save_val, "__value__")
                    ReturnValue(JSBridge__CreatePromise(1, p_val))
                }
                IfCondition EqualTo(sn, 2) ThenBlock: {
                    p_val = JSRT_ObjGet(save_val, "__value__")
                    ReturnValue(JSBridge__CreatePromise(2, p_val))
                }
                IfCondition EqualTo(sn, 0) ThenBlock: {
                    ReturnValue(save_val)
                }
            }
        }
        ReturnValue(JSVM__WrapInPromise(save_val))
    }
}

// =============================================================================
// M110: Eager Await — unwrap native Promise or thenable.
// On reject: ThrowValue and return 0. On success: return unwrapped value.
// =============================================================================
Function.JSVM__AwaitValue {
    Input: val: Address
    Output: Address
    Body: {
        cur = val
        // Bound recursion (nested promises / thenables)
        depth = 0
        WhileLoop LessThan(depth, 16) {
            depth = Add(depth, 1)
            IfCondition NotEqual(JSRT_GetType(cur), JSType.OBJECT) ThenBlock: {
                ReturnValue(cur)
            }
            // Native Promise: __state__ is NUMBER
            p_state = JSRT_ObjGet(cur, "__state__")
            IfCondition EqualTo(JSRT_GetType(p_state), JSType.NUMBER) ThenBlock: {
                // M128e6o: PromiseResolve(C, x) step — Get(x, "constructor")
                // before adopting. AsyncFromSyncIteratorContinuation / await of
                // a Promise with poisoned constructor must reject (test262
                // async-from-sync-iterator-continuation-abrupt-get-constructor).
                gk_c = JSVMCallBuf.getter_buf
                SetByte(gk_c, 0, 95)
                SetByte(gk_c, 1, 95)
                SetByte(gk_c, 2, 103)
                SetByte(gk_c, 3, 101)
                SetByte(gk_c, 4, 116)
                SetByte(gk_c, 5, 95)
                SetByte(gk_c, 6, 99)
                SetByte(gk_c, 7, 111)
                SetByte(gk_c, 8, 110)
                SetByte(gk_c, 9, 115)
                SetByte(gk_c, 10, 116)
                SetByte(gk_c, 11, 114)
                SetByte(gk_c, 12, 117)
                SetByte(gk_c, 13, 99)
                SetByte(gk_c, 14, 116)
                SetByte(gk_c, 15, 111)
                SetByte(gk_c, 16, 114)
                SetByte(gk_c, 17, 0)
                JSRT__Push(cur)
                gfn_c = JSRT_ObjGet(cur, gk_c)
                cur = JSRT__Pop()
                IfCondition EqualTo(JSRT_GetType(gfn_c), JSType.FUNCTION) ThenBlock: {
                    JSVM__SetGlobal("this", cur)
                    empty_c = JSVMCallBuf.buf
                    JSRT__Push(cur)
                    JSVMCall.exc_prop = 0
                    JSVM__CallFunc(gfn_c, empty_c, 0)
                    cur = JSRT__Pop()
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        pend_c = JSVMCall.thrown_val
                        IfCondition EqualTo(pend_c, 0) ThenBlock: {
                            pend_c = JSVMState.exc_val
                        }
                        JSVMCall.exc_prop = 0
                        JSVMCall.thrown_val = 0
                        JSVMState.exc_val = 0
                        IfCondition NotEqual(pend_c, 0) ThenBlock: {
                            JSVM_ThrowValue(pend_c)
                        }
                        ReturnValue(0)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        ReturnValue(0)
                    }
                } ElseBlock: {
                    // Data property or missing — plain Get for side effects on
                    // accessors installed without __get_ (defineProperty path).
                    JSRT__Push(cur)
                    dummy_c = JSRT_ObjGet(cur, "constructor")
                    cur = JSRT__Pop()
                    // (value unused; Own getter via defineProperty uses __get_)
                }
                p_state = JSRT_ObjGet(cur, "__state__")
                ps = Float_ToInt(JSRT_GetPayload(p_state))
                IfCondition EqualTo(ps, 1) ThenBlock: {
                    cur = JSRT_ObjGet(cur, "__value__")
                } ElseBlock: {
                    IfCondition EqualTo(ps, 2) ThenBlock: {
                        rej = JSRT_ObjGet(cur, "__value__")
                        JSVM_ThrowValue(rej)
                        ReturnValue(0)
                    } ElseBlock: {
                        // Pending native promise
                        ReturnValue(JSRT_Undefined())
                    }
                }
            } ElseBlock: {
                // Thenable: callable .then (honor defineProperty getters)
                empty_av = JSVMCallBuf.buf
                gk_t = JSVMCallBuf.getter_buf
                SetByte(gk_t, 0, 95)
                SetByte(gk_t, 1, 95)
                SetByte(gk_t, 2, 103)
                SetByte(gk_t, 3, 101)
                SetByte(gk_t, 4, 116)
                SetByte(gk_t, 5, 95)
                SetByte(gk_t, 6, 116)
                SetByte(gk_t, 7, 104)
                SetByte(gk_t, 8, 101)
                SetByte(gk_t, 9, 110)
                SetByte(gk_t, 10, 0)
                JSRT__Push(cur)
                gfn_t = JSRT_ObjGet(cur, gk_t)
                cur = JSRT__Pop()
                then_fn = 0
                IfCondition EqualTo(JSRT_GetType(gfn_t), JSType.FUNCTION) ThenBlock: {
                    JSVM__SetGlobal("this", cur)
                    JSRT__Push(cur)
                    then_fn = JSVM__CallFunc(gfn_t, empty_av, 0)
                    cur = JSRT__Pop()
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        pend_tg = JSVMCall.thrown_val
                        IfCondition EqualTo(pend_tg, 0) ThenBlock: {
                            pend_tg = JSVMState.exc_val
                        }
                        JSVMCall.exc_prop = 0
                        JSVMCall.thrown_val = 0
                        JSVMState.exc_val = 0
                        IfCondition NotEqual(pend_tg, 0) ThenBlock: {
                            JSVM_ThrowValue(pend_tg)
                        }
                        ReturnValue(0)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        ReturnValue(0)
                    }
                } ElseBlock: {
                    then_fn = JSRT_ObjGet(cur, "then")
                }
                IfCondition NotEqual(JSRT_GetType(then_fn), JSType.FUNCTION) ThenBlock: {
                    // Not a thenable — plain object
                    ReturnValue(cur)
                }
                JSVMAwait.state = 0
                JSVMAwait.value = 0
                res_fn = JSBridge__CreateNativeFunc(JSNativeID.THENABLE_RESOLVE, "resolve", 1)
                rej_fn = JSBridge__CreateNativeFunc(JSNativeID.THENABLE_REJECT, "reject", 1)
                JSVM__SetGlobal("this", cur)
                tbuf = JSVMCallBuf.buf
                StoreValue(tbuf, res_fn)
                StoreValue(Add(tbuf, 8), rej_fn)
                JSVMCall.exc_prop = 0
                JSVM__CallFunc(then_fn, tbuf, 2)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    pend = JSVMCall.thrown_val
                    IfCondition EqualTo(pend, 0) ThenBlock: {
                        pend = JSVMState.exc_val
                    }
                    JSVMCall.exc_prop = 0
                    JSVMCall.thrown_val = 0
                    JSVMState.exc_val = 0
                    IfCondition NotEqual(pend, 0) ThenBlock: {
                        JSVM_ThrowValue(pend)
                    }
                    ReturnValue(0)
                }
                IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                    ReturnValue(0)
                }
                IfCondition EqualTo(JSVMAwait.state, 2) ThenBlock: {
                    JSVM_ThrowValue(JSVMAwait.value)
                    ReturnValue(0)
                }
                IfCondition EqualTo(JSVMAwait.state, 1) ThenBlock: {
                    cur = JSVMAwait.value
                } ElseBlock: {
                    // then never settled — pending
                    ReturnValue(JSRT_Undefined())
                }
            }
        }
        ReturnValue(cur)
    }
}

// =============================================================================
// GENERATOR .next() — resume generator execution
// func_val = the .next() function (env points to generator JSValue)
// args/argc = arguments passed to .next() (value passed in via arg0)
// Returns: {value, done} iterator result object
// =============================================================================
Function.JSVM__GenNext {
    Input: func_val: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_fv = func_val
        save_args = args
        save_argc = argc
        // Fresh .next() call — do not inherit prior abrupt flag
        JSVMCall.exc_prop = 0
        JSVMCall.thrown_val = 0

        // Get generator JSValue from function's env
        gen_val = JSRT_FuncGetEnv(save_fv)
        IfCondition EqualTo(gen_val, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }

        // Get generator state block
        gen_type = JSRT_GetType(gen_val)
        IfCondition NotEqual(gen_type, JSType.GENERATOR) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }
        gs = JSRT_GetPayload(gen_val)
        IfCondition EqualTo(gs, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }

        // Check state
        gen_state = Dereference(gs)
        // If completed, return {value: undefined, done: true}
        IfCondition EqualTo(gen_state, JSGenConst.ST_COMPLETED) ThenBlock: {
            done_ir = JSRT_CreateIterResult(JSRT_Undefined(), 1)
            ag_f = Dereference(Add(gs, 104))
            IfCondition EqualTo(ag_f, 1) ThenBlock: {
                ReturnValue(JSVM__WrapInPromise(done_ir))
            }
            ReturnValue(done_ir)
        }
        // If executing, throw error (re-entrant)
        IfCondition EqualTo(gen_state, JSGenConst.ST_EXECUTING) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }

        // Mark as executing
        StoreValue(gs, JSGenConst.ST_EXECUTING)

        // Mole 15: keep this bound across yield resumes
        this_cap2 = Dereference(Add(gs, 112))
        IfCondition NotEqual(this_cap2, 0) ThenBlock: {
            JSVM__SetGlobal("this", this_cap2)
        }
        // M70: keep arguments bound across yield / init resumes
        args_cap2 = Dereference(Add(gs, JSGenConst.OFF_ARGS_OBJ))
        IfCondition NotEqual(args_cap2, 0) ThenBlock: {
            JSVM__SetGlobal("arguments", args_cap2)
        }

        // Mole 17: nest GenNext when already inside a generator (dstr elision, etc.)
        IfCondition EqualTo(JSVMGen.is_gen_exec, 1) ThenBlock: {
            nd = JSVMGen.nest_depth
            IfCondition LessThan(nd, 8) ThenBlock: {
                meta = Add(JSVMGen.nest_meta, Multiply(nd, 64))
                StoreValue(meta, JSVMGen.active_gs)
                StoreValue(Add(meta, 8), JSVMGen.active_genval)
                StoreValue(Add(meta, 16), JSVMGen.caller_pc)
                StoreValue(Add(meta, 24), JSVMGen.caller_sp)
                StoreValue(Add(meta, 32), JSVMGen.caller_fp)
                StoreValue(Add(meta, 40), 1)
                // Isolate FDI flags — inner gen must not inherit outer body_start/mode
                JSVMGen.nest_fdi_only = JSVMGen.fdi_only
                JSVMGen.nest_fdi_limit = JSVMGen.fdi_limit
                JSVMGen.nest_fdi_mode = JSVMGen.fdi_mode
                JSVMGen.fdi_only = 0
                JSVMGen.fdi_limit = 0
                JSVMGen.fdi_mode = 0
                ssz_n = Multiply(JSVMConst.MAX_STACK, 8)
                fsz_n = Multiply(JSVMConst.MAX_FRAMES, JSVMConst.FRAME_SIZE)
                side_n = Multiply(JSVMConst.MAX_FRAMES, 8)
                MemoryCopy(Add(JSVMGen.nest_stk, Multiply(nd, ssz_n)), JSVMGen.stk_buf, ssz_n)
                MemoryCopy(Add(JSVMGen.nest_frm, Multiply(nd, fsz_n)), JSVMGen.frm_buf, fsz_n)
                // Outer frame_envs/funcs/args — first-resume of inner overwrites slot 0
                MemoryCopy(Add(JSVMGen.nest_envs, Multiply(nd, side_n)), JSVMClosure.frame_envs, side_n)
                MemoryCopy(Add(JSVMGen.nest_ffuncs, Multiply(nd, side_n)), JSVMClosure.frame_funcs, side_n)
                MemoryCopy(Add(JSVMGen.nest_fargs, Multiply(nd, side_n)), JSVMClosure.frame_args, side_n)
                JSVMGen.nest_depth = Add(nd, 1)
            }
        }

        // Save caller VM state
        JSVMGen.caller_pc = JSVMState.pc
        JSVMGen.caller_sp = JSVMState.sp
        JSVMGen.caller_fp = JSVMState.fp
        JSVMGen.active_gs = gs
        JSVMGen.active_genval = gen_val
        JSVMGen.is_gen_exec = 1

        // Copy caller stack/frames into static backup buffers
        caller_stk_sz = Multiply(JSVMState.sp, 8)
        IfCondition LessThan(caller_stk_sz, 8) ThenBlock: { caller_stk_sz = 8 }
        JSVMGen.caller_stack = JSVMGen.stk_buf
        MemoryCopy(JSVMGen.caller_stack, JSVMState.stack, caller_stk_sz)

        caller_frm_sz = Multiply(JSVMState.fp, JSVMConst.FRAME_SIZE)
        IfCondition LessThan(caller_frm_sz, JSVMConst.FRAME_SIZE) ThenBlock: { caller_frm_sz = JSVMConst.FRAME_SIZE }
        JSVMGen.caller_frames = JSVMGen.frm_buf
        MemoryCopy(JSVMGen.caller_frames, JSVMState.frames, caller_frm_sz)

        // Handle suspended-start: first .next() — mirror CALL (Mole 17)
        IfCondition EqualTo(gen_state, JSGenConst.ST_SUSPENDED_START) ThenBlock: {
            g_bc = Dereference(Add(gs, 8))
            g_params = Dereference(Add(gs, 16))
            g_locals = Dereference(Add(gs, 24))
            g_args = Dereference(Add(gs, 72))
            g_argc = Dereference(Add(gs, 80))
            g_func = Dereference(Add(gs, 120))
            IfCondition EqualTo(g_func, 0) ThenBlock: {
                g_func = save_fv
            }

            this_cap = Dereference(Add(gs, 112))
            IfCondition NotEqual(this_cap, 0) ThenBlock: {
                JSVM__SetGlobal("this", this_cap)
            }

            // Wipe live VM for gen body; outer mid-body is in caller_* backups.
            JSVMState.sp = 0
            JSVMState.fp = 0
            MemorySet(JSVMState.stack, 0, Multiply(JSVMConst.MAX_STACK, 8))
            MemorySet(JSVMState.frames, 0, Multiply(JSVMConst.MAX_FRAMES, JSVMConst.FRAME_SIZE))
            // Nested: do not clear frame_envs — nest pop restores; but first-resume
            // SetupCallEnv will write slot 0. Outer envs saved in nest_envs.
            IfCondition EqualTo(JSVMGen.nest_depth, 0) ThenBlock: {
                MemorySet(JSVMClosure.frame_envs, 0, Multiply(JSVMConst.MAX_FRAMES, 8))
                MemorySet(JSVMClosure.frame_funcs, 0, Multiply(JSVMConst.MAX_FRAMES, 8))
                MemorySet(JSVMClosure.frame_args, 0, Multiply(JSVMConst.MAX_FRAMES, 8))
            }

            formal_count = BitwiseAnd(g_params, 268435455)
            rest_flag = 0
            rest_idx = -1
            IfCondition NotEqual(BitwiseAnd(g_params, 2147483648), 0) ThenBlock: {
                rest_flag = 1
                rest_idx = Subtract(formal_count, 1)
            }
            unmapped_bit = BitwiseAnd(g_params, 1073741824)

            pf_ok = JSVM__PushFrame(0, 0, 0, formal_count, g_locals)
            IfCondition LessThan(pf_ok, 0) ThenBlock: {
                JSVMState.error = 1
                ReturnValue(JSRT_Undefined())
            }
            JSVM__SetupCallEnv(g_func)
            prev_strict_g = JSVMState.is_strict
            faddr_g = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
            StoreValue(Add(faddr_g, 72), prev_strict_g)
            IfCondition NotEqual(BitwiseAnd(g_params, 536870912), 0) ThenBlock: {
                JSVMState.is_strict = 1
            }

            pi = 0
            WhileLoop LessThan(pi, g_locals) {
                pushed = 0
                IfCondition EqualTo(rest_flag, 1) ThenBlock: {
                    IfCondition EqualTo(pi, rest_idx) ThenBlock: {
                        rest_arr = JSRT_CreateArray()
                        ri = rest_idx
                        WhileLoop LessThan(ri, g_argc) {
                            IfCondition NotEqual(g_args, 0) ThenBlock: {
                                rval = Dereference(Add(g_args, Multiply(ri, 8)))
                                JSRT_ArrPush(rest_arr, rval)
                            }
                            ri = Add(ri, 1)
                        }
                        JSVM__StackPush(rest_arr)
                        pushed = 1
                    }
                    IfCondition EqualTo(pushed, 0) ThenBlock: {
                        IfCondition LessThan(pi, rest_idx) ThenBlock: {
                            IfCondition And(LessThan(pi, g_argc), NotEqual(g_args, 0)) ThenBlock: {
                                pval = Dereference(Add(g_args, Multiply(pi, 8)))
                                JSVM__StackPush(pval)
                            } ElseBlock: {
                                JSVM__StackPush(JSRT_Undefined())
                            }
                            pushed = 1
                        }
                    }
                }
                IfCondition EqualTo(pushed, 0) ThenBlock: {
                    IfCondition And(LessThan(pi, g_argc), NotEqual(g_args, 0)) ThenBlock: {
                        IfCondition EqualTo(rest_flag, 0) ThenBlock: {
                            pval = Dereference(Add(g_args, Multiply(pi, 8)))
                            JSVM__StackPush(pval)
                        } ElseBlock: {
                            JSVM__StackPush(JSRT_Undefined())
                        }
                    } ElseBlock: {
                        JSVM__StackPush(JSRT_Undefined())
                    }
                }
                pi = Add(pi, 1)
            }

            map_n = formal_count
            IfCondition NotEqual(unmapped_bit, 0) ThenBlock: {
                map_n = 0
            }
            IfCondition EqualTo(rest_flag, 1) ThenBlock: {
                IfCondition EqualTo(unmapped_bit, 0) ThenBlock: {
                    map_n = rest_idx
                }
            }
            IfCondition LessThan(map_n, 0) ThenBlock: { map_n = 0 }
            args_obj = JSVM_CreateArguments(g_args, g_argc, g_func, map_n)
            JSVM__SaveArguments()
            JSVM__SetGlobal("arguments", args_obj)
            // M70: pin arguments object on gen state for resume rebind
            StoreValue(Add(gs, JSGenConst.OFF_ARGS_OBJ), args_obj)
            IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                fi_a = Subtract(JSVMState.fp, 1)
                env_a = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi_a, 8)))
                IfCondition NotEqual(env_a, 0) ThenBlock: {
                    JSRT_ObjSet(env_a, "arguments", args_obj)
                }
            }

            JSVMState.pc = g_bc
        }

        // Handle suspended-yield OR post-FDI init: restore generator's saved state.
        // ST_SUSPENDED_INIT: params bound at call; resume body without yield-arg push.
        is_yield_resume = 0
        is_init_resume = 0
        IfCondition EqualTo(gen_state, JSGenConst.ST_SUSPENDED_YIELD) ThenBlock: {
            is_yield_resume = 1
        }
        IfCondition EqualTo(gen_state, JSGenConst.ST_SUSPENDED_INIT) ThenBlock: {
            is_init_resume = 1
        }
        IfCondition Or(EqualTo(is_yield_resume, 1), EqualTo(is_init_resume, 1)) ThenBlock: {
            g_pc = Dereference(Add(gs, 32))
            g_sp = Dereference(Add(gs, 40))
            g_fp = Dereference(Add(gs, 48))
            g_stk = Dereference(Add(gs, 56))
            g_frm = Dereference(Add(gs, 88))
            g_frm_count = Dereference(Add(gs, 96))

            // Restore stack
            JSVMState.sp = g_sp
            restore_sz = Multiply(g_sp, 8)
            IfCondition GreaterThan(restore_sz, 0) ThenBlock: {
                MemoryCopy(JSVMState.stack, g_stk, restore_sz)
            }

            // Restore frames
            JSVMState.fp = g_fp
            frm_restore_sz = Multiply(g_fp, JSVMConst.FRAME_SIZE)
            IfCondition GreaterThan(frm_restore_sz, 0) ThenBlock: {
                MemoryCopy(JSVMState.frames, g_frm, frm_restore_sz)
            }
            // Mole 17: restore frame_envs / frame_funcs / frame_args
            side_sz = Multiply(g_fp, 8)
            IfCondition GreaterThan(side_sz, 0) ThenBlock: {
                g_envs = Dereference(Add(gs, 128))
                g_ff = Dereference(Add(gs, 136))
                g_fa = Dereference(Add(gs, 144))
                IfCondition NotEqual(g_envs, 0) ThenBlock: {
                    MemoryCopy(JSVMClosure.frame_envs, g_envs, side_sz)
                }
                IfCondition NotEqual(g_ff, 0) ThenBlock: {
                    MemoryCopy(JSVMClosure.frame_funcs, g_ff, side_sz)
                }
                IfCondition NotEqual(g_fa, 0) ThenBlock: {
                    MemoryCopy(JSVMClosure.frame_args, g_fa, side_sz)
                }
            }

            // M70: recreate/rebind arguments for gen body.
            // CreateArguments during GenInitParams (inside method() CALL) is
            // freed by ReclaimScope when method() returns. Recreate here
            // inside GenNext (native — no reclaim) so the object stays live.
            IfCondition EqualTo(is_init_resume, 1) ThenBlock: {
                g_params_r = Dereference(Add(gs, 16))
                g_args_r = Dereference(Add(gs, 72))
                g_argc_r = Dereference(Add(gs, 80))
                g_func_r = Dereference(Add(gs, 120))
                formal_r = BitwiseAnd(g_params_r, 268435455)
                map_r = formal_r
                IfCondition NotEqual(BitwiseAnd(g_params_r, 1073741824), 0) ThenBlock: {
                    map_r = 0
                }
                IfCondition NotEqual(BitwiseAnd(g_params_r, 2147483648), 0) ThenBlock: {
                    IfCondition EqualTo(BitwiseAnd(g_params_r, 1073741824), 0) ThenBlock: {
                        map_r = Subtract(formal_r, 1)
                    }
                }
                IfCondition LessThan(map_r, 0) ThenBlock: { map_r = 0 }
                args_new = JSVM_CreateArguments(g_args_r, g_argc_r, g_func_r, map_r)
                StoreValue(Add(gs, JSGenConst.OFF_ARGS_OBJ), args_new)
                JSVM__SetGlobal("arguments", args_new)
                IfCondition GreaterThan(g_fp, 0) ThenBlock: {
                    fi_ar = Subtract(g_fp, 1)
                    env_ar = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi_ar, 8)))
                    IfCondition NotEqual(env_ar, 0) ThenBlock: {
                        JSRT_ObjSet(env_ar, "arguments", args_new)
                    }
                }
            } ElseBlock: {
                args_ga = Dereference(Add(gs, JSGenConst.OFF_ARGS_OBJ))
                IfCondition NotEqual(args_ga, 0) ThenBlock: {
                    JSVM__SetGlobal("arguments", args_ga)
                }
            }

            // Set PC
            JSVMState.pc = g_pc

            // M56: restore try depth from yield (TRY_POP/finally across resume)
            // Exc entries still live on the global exc_stack from when we suspended
            // only if this is the same outer call nesting; GenNext isolates below,
            // so re-apply saved depth after isolate.
            saved_gexc = Dereference(Add(gs, JSGenConst.OFF_EXC_SP))

            // Yield resume only: push .next(value) as the yield result
            // M56 return-resume handled after exc restore (force_return)
            IfCondition EqualTo(is_yield_resume, 1) ThenBlock: {
                pend_ret = Dereference(Add(gs, JSGenConst.OFF_PEND_RET))
                IfCondition EqualTo(pend_ret, 0) ThenBlock: {
                    IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                        next_arg = Dereference(save_args)
                        JSVM__StackPush(next_arg)
                    } ElseBlock: {
                        JSVM__StackPush(JSRT_Undefined())
                    }
                }
                // else: pending return — set up after exc restore below
            }
        }

        // Run the generator until YIELD or RETURN (both will restore caller state).
        // Mole 15: isolate exception stack so body throws become uncaught here,
        // then rethrow into the .next() caller (not outer try/catch directly).
        save_exc_sp = JSVMState.exc_sp
        // M57: preserve outer try handlers — restoring gen exc must not clobber them
        // (for-of throw path: outer catch + gen finally via return())
        outer_exc_saved = 0
        IfCondition GreaterThan(save_exc_sp, 0) ThenBlock: {
            nout = save_exc_sp
            IfCondition GreaterThan(nout, JSGenConst.EXC_SAVE_MAX) ThenBlock: {
                nout = JSGenConst.EXC_SAVE_MAX
            }
            MemoryCopy(Add(gs, JSGenConst.OFF_OUTER_EXC), JSVMState.exc_stack, Multiply(nout, 32))
            outer_exc_saved = nout
        }
        JSVMState.exc_sp = 0
        // M56: restore generator try handlers (saved on YIELD)
        IfCondition Or(EqualTo(is_yield_resume, 1), EqualTo(is_init_resume, 1)) ThenBlock: {
            saved_gexc = Dereference(Add(gs, JSGenConst.OFF_EXC_SP))
            IfCondition GreaterThan(saved_gexc, 0) ThenBlock: {
                IfCondition GreaterThan(saved_gexc, JSGenConst.EXC_SAVE_MAX) ThenBlock: {
                    saved_gexc = JSGenConst.EXC_SAVE_MAX
                }
                MemoryCopy(JSVMState.exc_stack, Add(gs, JSGenConst.OFF_EXC_DATA), Multiply(saved_gexc, 32))
                JSVMState.exc_sp = saved_gexc
            }
        }
        // M56 return-resume: run finally handlers then complete with pending value
        IfCondition EqualTo(is_yield_resume, 1) ThenBlock: {
            pend_ret = Dereference(Add(gs, JSGenConst.OFF_PEND_RET))
            IfCondition NotEqual(pend_ret, 0) ThenBlock: {
                IfCondition GreaterThan(JSVMState.exc_sp, 0) ThenBlock: {
                    // Enter top handler (finally) as if throw of return-completion
                    JSVMGen.force_return = 1
                    JSVMGen.force_return_val = pend_ret
                    JSVMState.exc_sp = Subtract(JSVMState.exc_sp, 1)
                    ebase = Add(JSVMState.exc_stack, Multiply(JSVMState.exc_sp, 32))
                    catch_addr = Dereference(ebase)
                    saved_sp = Dereference(Add(ebase, 8))
                    saved_fp = Dereference(Add(ebase, 16))
                    IfCondition LessThan(saved_sp, 0) ThenBlock: { saved_sp = 0 }
                    IfCondition LessThan(saved_fp, 0) ThenBlock: { saved_fp = 0 }
                    JSVMState.fp = saved_fp
                    JSVMState.sp = saved_sp
                    JSVM__StackPush(pend_ret)
                    JSVMState.pc = catch_addr
                } ElseBlock: {
                    // No try: complete with return value immediately
                    StoreValue(gs, JSGenConst.ST_COMPLETED)
                    StoreValue(Add(gs, JSGenConst.OFF_PEND_RET), 0)
                    JSVMGen.active_gs = 0
                    JSVMGen.is_gen_exec = 0
                    JSVMState.pc = JSVMGen.caller_pc
                    JSVMState.sp = JSVMGen.caller_sp
                    JSVMState.fp = JSVMGen.caller_fp
                    csz = Multiply(JSVMGen.caller_sp, 8)
                    IfCondition GreaterThan(csz, 0) ThenBlock: {
                        MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, csz)
                    }
                    cfsz = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
                    IfCondition GreaterThan(cfsz, 0) ThenBlock: {
                        MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, cfsz)
                    }
                    JSVMState.exc_sp = save_exc_sp
                    ret_ir = JSRT_CreateIterResult(pend_ret, 1)
                    ReturnValue(ret_ir)
                }
            }
        }
        JSVMState.halted = 0
        JSVMState.error = 0
        JSVMState.exc_val = 0
        gen_done = 0
        WhileLoop EqualTo(gen_done, 0) {
            rc = JSVM_Step()
            // Mole 17 FDI-at-call: stop at body_start after param init
            IfCondition EqualTo(JSVMGen.fdi_only, 1) ThenBlock: {
                IfCondition EqualTo(JSVMGen.is_gen_exec, 1) ThenBlock: {
                    IfCondition GreaterThan(JSVMGen.fdi_limit, 0) ThenBlock: {
                        IfCondition GreaterEqual(JSVMState.pc, JSVMGen.fdi_limit) ThenBlock: {
                            // Save gen state as ST_SUSPENDED_INIT at body_start
                            StoreValue(Add(gs, 32), JSVMState.pc)
                            StoreValue(Add(gs, 40), JSVMState.sp)
                            StoreValue(Add(gs, 48), JSVMState.fp)
                            gen_stk = Dereference(Add(gs, 56))
                            copy_sz = Multiply(JSVMState.sp, 8)
                            IfCondition GreaterThan(copy_sz, 0) ThenBlock: {
                                MemoryCopy(gen_stk, JSVMState.stack, copy_sz)
                            }
                            gen_frm = Dereference(Add(gs, 88))
                            frm_copy_sz = Multiply(JSVMState.fp, JSVMConst.FRAME_SIZE)
                            IfCondition GreaterThan(frm_copy_sz, 0) ThenBlock: {
                                MemoryCopy(gen_frm, JSVMState.frames, frm_copy_sz)
                            }
                            StoreValue(Add(gs, 96), JSVMState.fp)
                            side_sz = Multiply(JSVMState.fp, 8)
                            IfCondition GreaterThan(side_sz, 0) ThenBlock: {
                                gen_envs = Dereference(Add(gs, 128))
                                gen_funcs = Dereference(Add(gs, 136))
                                gen_fargs = Dereference(Add(gs, 144))
                                IfCondition NotEqual(gen_envs, 0) ThenBlock: {
                                    MemoryCopy(gen_envs, JSVMClosure.frame_envs, side_sz)
                                }
                                IfCondition NotEqual(gen_funcs, 0) ThenBlock: {
                                    MemoryCopy(gen_funcs, JSVMClosure.frame_funcs, side_sz)
                                }
                                IfCondition NotEqual(gen_fargs, 0) ThenBlock: {
                                    MemoryCopy(gen_fargs, JSVMClosure.frame_args, side_sz)
                                }
                            }
                            StoreValue(gs, JSGenConst.ST_SUSPENDED_INIT)
                            // Restore caller without pushing iter result
                            JSVMState.pc = JSVMGen.caller_pc
                            JSVMState.sp = JSVMGen.caller_sp
                            JSVMState.fp = JSVMGen.caller_fp
                            caller_stk_sz = Multiply(JSVMGen.caller_sp, 8)
                            IfCondition GreaterThan(caller_stk_sz, 0) ThenBlock: {
                                MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, caller_stk_sz)
                            }
                            caller_frm_sz = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
                            IfCondition GreaterThan(caller_frm_sz, 0) ThenBlock: {
                                MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, caller_frm_sz)
                            }
                            JSVMGen.active_gs = 0
                            JSVMGen.is_gen_exec = 0
                            gen_done = 1
                        }
                    }
                }
            }
            // Check if generator execution ended (YIELD or RETURN restored caller)
            IfCondition EqualTo(JSVMGen.is_gen_exec, 0) ThenBlock: {
                gen_done = 1
            }
            IfCondition EqualTo(JSVMState.halted, 1) ThenBlock: {
                gen_done = 1
            }
            IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                gen_done = 1
            }
        }
        JSVMGen.fdi_only = 0
        JSVMGen.fdi_limit = 0
        // M57: restore outer try handlers clobbered by gen exc overlay
        IfCondition GreaterThan(outer_exc_saved, 0) ThenBlock: {
            MemoryCopy(JSVMState.exc_stack, Add(gs, JSGenConst.OFF_OUTER_EXC), Multiply(outer_exc_saved, 32))
        }
        // Restore outer exception stack depth (THROW-in-gen already restored caller)
        JSVMState.exc_sp = save_exc_sp

        // Did this GenNext exit via yield/return? (is_gen_exec cleared)
        // Nest pop may set is_gen_exec=1 again for outer — don't force-complete then.
        gen_exited = 0
        IfCondition EqualTo(JSVMGen.is_gen_exec, 0) ThenBlock: {
            gen_exited = 1
        }
        // Capture BEFORE nest pop restores outer fdi_mode (nested next must not
        // take the FDI-no-result return path).
        exit_fdi_mode = JSVMGen.fdi_mode

        // Mole 17: pop GenNext nest — re-enter outer generator context
        IfCondition GreaterThan(JSVMGen.nest_depth, 0) ThenBlock: {
            JSVMGen.nest_depth = Subtract(JSVMGen.nest_depth, 1)
            nd2 = JSVMGen.nest_depth
            meta2 = Add(JSVMGen.nest_meta, Multiply(nd2, 64))
            JSVMGen.active_gs = Dereference(meta2)
            JSVMGen.active_genval = Dereference(Add(meta2, 8))
            JSVMGen.caller_pc = Dereference(Add(meta2, 16))
            JSVMGen.caller_sp = Dereference(Add(meta2, 24))
            JSVMGen.caller_fp = Dereference(Add(meta2, 32))
            JSVMGen.is_gen_exec = Dereference(Add(meta2, 40))
            JSVMGen.fdi_only = JSVMGen.nest_fdi_only
            JSVMGen.fdi_limit = JSVMGen.nest_fdi_limit
            JSVMGen.fdi_mode = JSVMGen.nest_fdi_mode
            JSVMGen.nest_fdi_only = 0
            JSVMGen.nest_fdi_limit = 0
            JSVMGen.nest_fdi_mode = 0
            ssz_n2 = Multiply(JSVMConst.MAX_STACK, 8)
            fsz_n2 = Multiply(JSVMConst.MAX_FRAMES, JSVMConst.FRAME_SIZE)
            side_n2 = Multiply(JSVMConst.MAX_FRAMES, 8)
            MemoryCopy(JSVMGen.stk_buf, Add(JSVMGen.nest_stk, Multiply(nd2, ssz_n2)), ssz_n2)
            MemoryCopy(JSVMGen.frm_buf, Add(JSVMGen.nest_frm, Multiply(nd2, fsz_n2)), fsz_n2)
            MemoryCopy(JSVMClosure.frame_envs, Add(JSVMGen.nest_envs, Multiply(nd2, side_n2)), side_n2)
            MemoryCopy(JSVMClosure.frame_funcs, Add(JSVMGen.nest_ffuncs, Multiply(nd2, side_n2)), side_n2)
            MemoryCopy(JSVMClosure.frame_args, Add(JSVMGen.nest_fargs, Multiply(nd2, side_n2)), side_n2)
            JSVMGen.caller_stack = JSVMGen.stk_buf
            JSVMGen.caller_frames = JSVMGen.frm_buf
        }

        // Mole 15: THROW-in-gen set exc_prop + restored caller — do NOT StackPop
        // M99: async generators surface throws as rejected Promises
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            JSVMState.halted = 0
            JSVMState.error = 0
            StoreValue(gs, JSGenConst.ST_COMPLETED)
            pend_ag = JSVMCall.thrown_val
            IfCondition EqualTo(pend_ag, 0) ThenBlock: {
                pend_ag = JSVMState.exc_val
            }
            IfCondition EqualTo(pend_ag, 0) ThenBlock: {
                pend_ag = JSVM__GetGlobal("__pend_exc__")
            }
            IfCondition EqualTo(pend_ag, 0) ThenBlock: {
                pend_ag = JSVM_CreateTypedError("TypeError", "generator threw")
            }
            ag_flag_t = Dereference(Add(gs, 104))
            // M99: reject Promise only for body throws, not FDI param init
            IfCondition And(EqualTo(ag_flag_t, 1), EqualTo(JSVMGen.fdi_mode, 0)) ThenBlock: {
                JSVMCall.exc_prop = 0
                JSVMCall.thrown_val = 0
                JSVMState.exc_val = 0
                ReturnValue(JSBridge__CreatePromise(2, pend_ag))
            }
            ReturnValue(JSRT_Undefined())
        }
        // Uncaught error path (no THROW opcode? safety net)
        // AWAIT of rejected Promise uses this path (ThrowValue sets error, not exc_prop).
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
            StoreValue(gs, JSGenConst.ST_COMPLETED)
            pend = JSVMState.exc_val
            JSVMState.pc = JSVMGen.caller_pc
            JSVMState.sp = JSVMGen.caller_sp
            JSVMState.fp = JSVMGen.caller_fp
            c_stk_sz = Multiply(JSVMGen.caller_sp, 8)
            IfCondition GreaterThan(c_stk_sz, 0) ThenBlock: {
                MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, c_stk_sz)
            }
            c_frm_sz = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
            IfCondition GreaterThan(c_frm_sz, 0) ThenBlock: {
                MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, c_frm_sz)
            }
            IfCondition EqualTo(JSVMGen.nest_depth, 0) ThenBlock: {
                JSVMGen.active_gs = 0
                JSVMGen.is_gen_exec = 0
            }
            JSVMState.halted = 0
            JSVMState.error = 0
            IfCondition EqualTo(pend, 0) ThenBlock: {
                pend = JSVM_CreateTypedError("TypeError", "generator threw")
            }
            // M99: async gen body throw → rejected Promise.
            // Skip during FDI (param init) — those throws are sync at call time.
            ag_flag_e = Dereference(Add(gs, 104))
            IfCondition And(EqualTo(ag_flag_e, 1), EqualTo(JSVMGen.fdi_mode, 0)) ThenBlock: {
                JSVMState.exc_val = 0
                JSVMCall.thrown_val = 0
                JSVMCall.exc_prop = 0
                ReturnValue(JSBridge__CreatePromise(2, pend))
            }
            JSVMState.exc_val = pend
            JSVMCall.thrown_val = pend
            JSVMCall.exc_prop = 1
            ReturnValue(JSRT_Undefined())
        }
        // Gen still marked executing without yield/return — force complete
        // Only when THIS gen did not exit cleanly (not after nest-restore of outer).
        IfCondition And(EqualTo(gen_exited, 0), EqualTo(JSVMGen.nest_depth, 0)) ThenBlock: {
            IfCondition EqualTo(JSVMGen.is_gen_exec, 1) ThenBlock: {
                StoreValue(gs, JSGenConst.ST_COMPLETED)
                JSVMState.pc = JSVMGen.caller_pc
                JSVMState.sp = JSVMGen.caller_sp
                JSVMState.fp = JSVMGen.caller_fp
                c_stk_sz2 = Multiply(JSVMGen.caller_sp, 8)
                IfCondition GreaterThan(c_stk_sz2, 0) ThenBlock: {
                    MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, c_stk_sz2)
                }
                c_frm_sz2 = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
                IfCondition GreaterThan(c_frm_sz2, 0) ThenBlock: {
                    MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, c_frm_sz2)
                }
                JSVMGen.active_gs = 0
                JSVMGen.is_gen_exec = 0
                JSVMState.halted = 0
                JSVMState.error = 0
                halt_ir = JSRT_CreateIterResult(JSRT_Undefined(), 1)
                ReturnValue(halt_ir)
            }
        }

        // FDI-at-call: no iterator result — params bound, suspended at body.
        // Use exit_fdi_mode (pre-nest-pop) so nested .next() returns a real result.
        IfCondition EqualTo(exit_fdi_mode, 1) ThenBlock: {
            JSVMGen.fdi_mode = 0
            ReturnValue(1)
        }

        // The result is already on the stack (pushed by YIELD or RETURN handler)
        result = JSVM__StackPop()

        // For async generators (offset 104 == 1), wrap {value, done} in a Promise
        ag_flag = Dereference(Add(gs, 104))
        IfCondition EqualTo(ag_flag, 1) ThenBlock: {
            ReturnValue(JSVM__WrapInPromise(result))
        }
        ReturnValue(result)
    }
}

// Mole 17: run generator param init (FDI) at call time. Returns 1 ok, 0 on throw.
// Leaves gen suspended at body_start on success.
Function.JSVM__GenInitParams {
    Input: gen_val: Address
    Input: func_val: Address
    Output: Integer
    Body: {
        save_gv = gen_val
        save_fv = func_val
        body_pc = JSRT_FuncGetBodyStart(save_fv)
        // No separate param code — nothing to do
        IfCondition LessEqual(body_pc, 0) ThenBlock: {
            ReturnValue(1)
        }
        f_bc = JSRT_FuncGetBC(save_fv)
        IfCondition LessEqual(body_pc, f_bc) ThenBlock: {
            ReturnValue(1)
        }
        // Use GenNext machinery with fdi_only limit
        JSVMGen.fdi_only = 1
        JSVMGen.fdi_limit = body_pc
        JSVMGen.fdi_mode = 1
        // Build a temporary next-fn whose env is the generator
        next_tmp = JSRT_CreateFunc(-9999, 1, 0, "next")
        JSRT_FuncSetEnv(next_tmp, save_gv)
        empty = JSVMCallBuf.buf
        JSVM__GenNext(next_tmp, empty, 0)
        JSVMGen.fdi_only = 0
        JSVMGen.fdi_limit = 0
        // Throw?
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            JSVMGen.fdi_mode = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
            JSVMGen.fdi_mode = 0
            ReturnValue(0)
        }
        JSVMGen.fdi_mode = 0
        ReturnValue(1)
    }
}

// =============================================================================
// GENERATOR .return() — force generator completion with a value
// =============================================================================

// M20d: track open iterator while generator is suspended mid-dstr / for-of.
// GenReturn/GenThrow call .return() so rtrn-close tests pass.
// M128e6ab: track whenever active_gs is set (not only is_gen_exec). CallFunc
// briefly clears is_gen_exec around @@iterator factory; missing track left
// OFF_OPEN_ITER=0 so gen.return() never IteratorClose'd (rtrn-close fails).
Function.JSVM__GenTrackOpenIter {
    Input: rec: Address
    Output: Integer
    Body: {
        save_rec = rec
        gs = JSVMGen.active_gs
        IfCondition EqualTo(gs, 0) ThenBlock: {
            ReturnValue(0)
        }
        // M128e6ab: promote rec to gval_pool so it survives ReclaimScope when
        // GenNext returns after yield. val_pool slots are rewound; a raw rec
        // pointer then dangles and gen.return() CallFunc hits garbage (rtrn-close).
        keep = save_rec
        IfCondition And(NotEqual(save_rec, 0), NotEqual(save_rec, JSRTState.undef_val)) ThenBlock: {
            prom = JSRT__AllocGlobalValue()
            IfCondition NotEqual(prom, 0) ThenBlock: {
                StoreValue(prom, Dereference(save_rec))
                StoreValue(Add(prom, 8), Dereference(Add(save_rec, 8)))
                keep = prom
            }
        }
        StoreValue(Add(gs, JSGenConst.OFF_OPEN_ITER), keep)
        ReturnValue(1)
    }
}

Function.JSVM__GenClearOpenIter {
    Input: rec: Address
    Output: Integer
    Body: {
        save_rec = rec
        gs = JSVMGen.active_gs
        IfCondition EqualTo(gs, 0) ThenBlock: {
            // Also clear on completed gen if matching — use optional
            ReturnValue(0)
        }
        cur = Dereference(Add(gs, JSGenConst.OFF_OPEN_ITER))
        IfCondition EqualTo(cur, save_rec) ThenBlock: {
            StoreValue(Add(gs, JSGenConst.OFF_OPEN_ITER), 0)
        }
        // Clear even if rec is 0 (force clear)
        IfCondition EqualTo(save_rec, 0) ThenBlock: {
            StoreValue(Add(gs, JSGenConst.OFF_OPEN_ITER), 0)
        }
        ReturnValue(1)
    }
}

// Close open iterator on generator with return-completion semantics (kind 0).
// Returns 0 on success, 1 if throw propagated (exc_prop/error set).
Function.JSVM__GenCloseOpenIter {
    Input: gs: Address
    Output: Integer
    Body: {
        save_gs = gs
        IfCondition EqualTo(save_gs, 0) ThenBlock: {
            ReturnValue(0)
        }
        rec = Dereference(Add(save_gs, JSGenConst.OFF_OPEN_ITER))
        StoreValue(Add(save_gs, JSGenConst.OFF_OPEN_ITER), 0)
        IfCondition EqualTo(rec, 0) ThenBlock: {
                ReturnValue(0)
        }
        // M56: per-record closed/done (global JSVMIter.done is shared)
        closed_v = JSRT_ObjGet(rec, "__c__")
        IfCondition EqualTo(JSRT_IsTruthy(closed_v), 1) ThenBlock: {
                ReturnValue(0)
        }
        rec_done = JSRT_ObjGet(rec, "__done__")
        IfCondition EqualTo(JSRT_IsTruthy(rec_done), 1) ThenBlock: {
                JSRT_ObjSet(rec, "__c__", JSRT_True())
            ReturnValue(0)
        }
        mode_v = JSRT_ObjGet(rec, "__m__")
        mode = 0
        IfCondition EqualTo(JSRT_GetType(mode_v), JSType.NUMBER) ThenBlock: {
            mode = Float_ToInt(JSRT_GetPayload(mode_v))
        }
        IfCondition EqualTo(mode, 0) ThenBlock: {
                JSVMIter.done = 1
            JSRT_ObjSet(rec, "__c__", JSRT_True())
            ReturnValue(0)
        }
        iterator = JSRT_ObjGet(rec, "__it__")
        ret_fn = JSRT_ObjGet(iterator, "return")
        rft = JSRT_GetType(ret_fn)
        IfCondition Or(EqualTo(rft, JSType.UNDEFINED), EqualTo(rft, JSType.NULL)) ThenBlock: {
            JSVMIter.done = 1
            ReturnValue(0)
        }
        IfCondition NotEqual(rft, JSType.FUNCTION) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "iterator return is not a function")
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVMState.exc_val = terr
            ReturnValue(1)
        }
        JSVM__SetGlobal("this", iterator)
        empty_buf = JSVMCallBuf.buf
        // Isolate from outer try (assert.throws) — flag only, no ThrowValue
        save_exc_sp = JSVMState.exc_sp
        JSVMState.exc_sp = 0
        ret_res = JSVM__CallFunc(ret_fn, empty_buf, 0)
        JSVMState.exc_sp = save_exc_sp
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            pend = JSVMCall.thrown_val
            IfCondition EqualTo(pend, 0) ThenBlock: {
                pend = JSVMState.exc_val
            }
            IfCondition Or(EqualTo(pend, 0), EqualTo(pend, JSRTState.undef_val)) ThenBlock: {
                pend = JSVM_CreateTypedError("TypeError", "iterator return threw")
            }
            JSVMCall.thrown_val = pend
            JSVMCall.exc_prop = 1
            JSVMState.exc_val = pend
            JSVMState.error = 0
            JSVMState.halted = 0
            ReturnValue(1)
        }
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
            JSVMState.error = 0
            JSVMState.halted = 0
            IfCondition EqualTo(JSVMCall.thrown_val, 0) ThenBlock: {
                JSVMCall.thrown_val = JSVMState.exc_val
            }
            JSVMCall.exc_prop = 1
            ReturnValue(1)
        }
        rrt = JSRT_GetType(ret_res)
        IfCondition And(NotEqual(rrt, JSType.OBJECT), NotEqual(rrt, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(rrt, JSType.ARRAY) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "iterator return result is not an object")
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVMState.exc_val = terr
                ReturnValue(1)
            }
        }
        JSVMIter.done = 1
        JSRT_ObjSet(rec, "__c__", JSRT_True())
        ReturnValue(0)
    }
}

Function.JSVM__GenReturn {
    Input: func_val: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_fv = func_val
        save_args = args
        save_argc = argc

        gen_val = JSRT_FuncGetEnv(save_fv)
        IfCondition EqualTo(gen_val, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }
        gen_type = JSRT_GetType(gen_val)
        IfCondition NotEqual(gen_type, JSType.GENERATOR) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }
        gs = JSRT_GetPayload(gen_val)
        IfCondition EqualTo(gs, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }

        gen_state = Dereference(gs)
        // Already completed
        IfCondition EqualTo(gen_state, JSGenConst.ST_COMPLETED) ThenBlock: {
            // M128e6o: async gen .return()/.next() after complete → Promise
            done_ir = JSRT_CreateIterResult(JSRT_Undefined(), 1)
            ag_done = Dereference(Add(gs, 104))
            IfCondition EqualTo(ag_done, 1) ThenBlock: {
                ReturnValue(JSVM__WrapInPromise(done_ir))
            }
            ReturnValue(done_ir)
        }

        // Get the return value
        ret_v = JSRT_Undefined()
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            ret_v = Dereference(save_args)
        }

        // M20d: close open iters; M56: resume for finally when try is active
        IfCondition Or(EqualTo(gen_state, JSGenConst.ST_SUSPENDED_YIELD), EqualTo(gen_state, JSGenConst.ST_SUSPENDED_INIT)) ThenBlock: {
            // M128e6ab: skip force_return resume into dstr/for-of try when open iter closed
            had_open_iter = 0
            IfCondition NotEqual(Dereference(Add(gs, JSGenConst.OFF_OPEN_ITER)), 0) ThenBlock: {
                had_open_iter = 1
            }
            close_abrupt = JSVM__GenCloseOpenIter(gs)
            IfCondition EqualTo(close_abrupt, 1) ThenBlock: {
                StoreValue(gs, JSGenConst.ST_COMPLETED)
                StoreValue(Add(gs, JSGenConst.OFF_PEND_RET), 0)
                StoreValue(Add(gs, JSGenConst.OFF_OPEN_ITER), 0)
                // M128e6n: async gen .return() + abrupt IteratorClose must reject
                // a Promise (rtrn-close-null). Sync gen keeps CALL_METHOD throw.
                pend_cl = JSVMCall.thrown_val
                IfCondition EqualTo(pend_cl, 0) ThenBlock: {
                    pend_cl = JSVMState.exc_val
                }
                IfCondition EqualTo(pend_cl, 0) ThenBlock: {
                    pend_cl = JSVM__GetGlobal("__pend_exc__")
                }
                IfCondition Or(EqualTo(pend_cl, 0), EqualTo(pend_cl, JSRTState.undef_val)) ThenBlock: {
                    pend_cl = JSVM_CreateTypedError("TypeError", "iterator close abrupt")
                }
                JSVMCall.exc_prop = 0
                JSVMCall.thrown_val = 0
                JSVMState.exc_val = 0
                JSVMState.error = 0
                JSVMState.halted = 0
                JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                ag_cl = Dereference(Add(gs, 104))
                IfCondition EqualTo(ag_cl, 1) ThenBlock: {
                    ReturnValue(JSBridge__CreatePromise(2, pend_cl))
                }
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = pend_cl
                JSVMState.exc_val = pend_cl
                ReturnValue(JSRT_Undefined())
            }
            // Only resume for finally if try handlers were saved at yield
            // and we did not already IteratorClose via open-iter track.
            saved_exc_n = Dereference(Add(gs, JSGenConst.OFF_EXC_SP))
            IfCondition And(GreaterThan(saved_exc_n, 0), EqualTo(had_open_iter, 0)) ThenBlock: {
                StoreValue(Add(gs, JSGenConst.OFF_PEND_RET), ret_v)
                empty_ab = JSVMCallBuf.buf
                resume_res = JSVM__GenNext(save_fv, empty_ab, 0)
                StoreValue(Add(gs, JSGenConst.OFF_PEND_RET), 0)
                IfCondition EqualTo(JSVMCall.exc_prop, 0) ThenBlock: {
                    ret_ir = JSRT_CreateIterResult(ret_v, 1)
                    ag_rf = Dereference(Add(gs, 104))
                    IfCondition EqualTo(ag_rf, 1) ThenBlock: {
                        ReturnValue(JSVM__WrapInPromise(ret_ir))
                    }
                    ReturnValue(ret_ir)
                }
                ReturnValue(resume_res)
            }
            // No try, or open-iter already closed (rtrn-close): complete immediately
            StoreValue(gs, JSGenConst.ST_COMPLETED)
            StoreValue(Add(gs, JSGenConst.OFF_OPEN_ITER), 0)
            StoreValue(Add(gs, JSGenConst.OFF_PEND_RET), 0)
            ret_ir = JSRT_CreateIterResult(ret_v, 1)
            ag_rf = Dereference(Add(gs, 104))
            IfCondition EqualTo(ag_rf, 1) ThenBlock: {
                ReturnValue(JSVM__WrapInPromise(ret_ir))
            }
            ReturnValue(ret_ir)
        }

        // suspended-start / other: just complete
        StoreValue(gs, JSGenConst.ST_COMPLETED)
        StoreValue(Add(gs, JSGenConst.OFF_OPEN_ITER), 0)
        StoreValue(Add(gs, JSGenConst.OFF_PEND_RET), 0)
        ret_ir = JSRT_CreateIterResult(ret_v, 1)
        ag_rf = Dereference(Add(gs, 104))
        IfCondition EqualTo(ag_rf, 1) ThenBlock: {
            ReturnValue(JSVM__WrapInPromise(ret_ir))
        }
        ReturnValue(ret_ir)
    }
}

// =============================================================================
// GENERATOR .throw() — throw exception into generator
// =============================================================================
Function.JSVM__GenThrow {
    Input: func_val: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_fv = func_val
        save_args = args
        save_argc = argc

        gen_val = JSRT_FuncGetEnv(save_fv)
        IfCondition EqualTo(gen_val, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }
        gen_type = JSRT_GetType(gen_val)
        IfCondition NotEqual(gen_type, JSType.GENERATOR) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }
        gs = JSRT_GetPayload(gen_val)
        IfCondition EqualTo(gs, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }

        // Mark completed (simple impl — throw terminates generator)
        StoreValue(gs, JSGenConst.ST_COMPLETED)
        throw_ir = JSRT_CreateIterResult(JSRT_Undefined(), 1)
        ag_tf = Dereference(Add(gs, 104))
        IfCondition EqualTo(ag_tf, 1) ThenBlock: {
            ReturnValue(JSVM__WrapInPromise(throw_ir))
        }
        ReturnValue(throw_ir)
    }
}

// =============================================================================
// FULL PIPELINE: Lex + Parse + Compile + Run
// Takes JS source string and length, returns result JSValue.
// Requires JSLex_Init, JSParse_Init, JSComp_Init, JSVM_Init already called.
// =============================================================================
Function.JSVM_Eval {
    Input: source: Address
    Input: src_len: Integer
    Output: Address
    Body: {
        save_src = source
        save_len = src_len

        // Reset subsystems
        JSLex_Reset()
        JSComp_Reset()
        JSVM_Reset()

        // Tokenize
        tok_count = JSLex_Tokenize(save_src, save_len)
        IfCondition LessEqual(tok_count, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Parse
        root = JSParse_Parse()
        parse_err = JSParse_HasError()
        IfCondition Or(LessThan(root, 0), EqualTo(parse_err, 1)) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Compile
        JSVM__Push(root)
        comp_ok = JSComp_Compile(root)
        root = JSVM__Pop()
        IfCondition EqualTo(comp_ok, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Load bytecode
        bc = JSComp_GetCode()
        bc_len = JSComp_GetCodeLen()
        cp = JSComp_GetConst(0)
        cc = JSComp_GetConstCount()
        JSVM_Load(bc, bc_len, cp, cc)
        JSVM_SetStrict(JSComp_IsStrict())

        // Run
        result = JSVM_Run()
        ReturnValue(result)
    }
}

// =============================================================================
// JSVM__CallFunc — re-entrant VM call from native code
// Calls a JS function with argc arguments from arg_buf, returns the result.
// Saves/restores entire VM state to support calling JS from native handlers
// (e.g., Promise.then callbacks).
// =============================================================================
Function.JSVM__CallFunc {
    Input: func_val: Address
    Input: arg_buf: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_fv = func_val
        save_ab = arg_buf
        save_ac = argc
        JSVMCall.exc_prop = 0

        fv_type = JSRT_GetType(save_fv)
        IfCondition NotEqual(fv_type, JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // M26c: class constructors have no [[Call]] (apply/call/CallFunc).
        // SuperCall goes through CALL/CALL_SPREAD with this already set, not here.
        // M50c: fdesc+88 value 4 = MethodDefinition (callable, not constructible).
        // Only 1 (base class) and 2 (derived class) reject [[Call]].
        fdesc_cf = JSRT_GetPayload(save_fv)
        IfCondition NotEqual(fdesc_cf, 0) ThenBlock: {
            cf_kind = Dereference(Add(fdesc_cf, 88))
            IfCondition Or(EqualTo(cf_kind, 1), EqualTo(cf_kind, 2)) ThenBlock: {
                terr_cf = JSVM_CreateTypedError("TypeError", "Class constructor cannot be invoked without new")
                JSVM__SetGlobal("__pend_exc__", terr_cf)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr_cf
                JSVM_ThrowValue(terr_cf)
                ReturnValue(JSRT_Undefined())
            }
            // M43: OrdinaryCallBindThis — USER functions only (not natives).
            // Natives must keep null/undefined this for RequireObjectCoercible
            // (e.g. String.prototype.padStart.call(null)).
            // strict bit 29 of param_count at fdesc+8
            cf_bc_chk = JSRT_FuncGetBC(save_fv)
            IfCondition GreaterEqual(cf_bc_chk, 0) ThenBlock: {
                cf_pcount = Dereference(Add(fdesc_cf, 8))
                // Skip ToObject box for async (env 65) — always-strict ThisBinding
            cf_fenv_bind = JSRT_FuncGetEnv(save_fv)
            IfCondition And(EqualTo(BitwiseAnd(cf_pcount, 536870912), 0), NotEqual(cf_fenv_bind, 65)) ThenBlock: {
                    th_b = JSVM__GetGlobal("this")
                    tht_b = JSRT_GetType(th_b)
                    // null/undefined → globalThis
                    IfCondition Or(EqualTo(tht_b, JSType.NULL), EqualTo(tht_b, JSType.UNDEFINED)) ThenBlock: {
                        g_b = JSVM__GetGlobal("globalThis")
                        IfCondition EqualTo(JSRT_GetType(g_b), JSType.UNDEFINED) ThenBlock: {
                            g_b = JSVM__GetGlobal("this")
                        }
                        IfCondition NotEqual(JSRT_GetType(g_b), JSType.UNDEFINED) ThenBlock: {
                            JSVM__SetGlobal("this", g_b)
                        }
                    }
                    // primitives → ToObject box (this.valueOf() / property access)
                    IfCondition EqualTo(tht_b, JSType.BOOLEAN) ThenBlock: {
                        box_b = JSRT_CreateObject()
                        bg_b = JSVM__GetGlobal("Boolean")
                        IfCondition EqualTo(JSRT_GetType(bg_b), JSType.FUNCTION) ThenBlock: {
                            bp_b = JSRT_ObjGet(bg_b, "prototype")
                            IfCondition EqualTo(JSRT_GetType(bp_b), JSType.OBJECT) ThenBlock: {
                                JSRT_ObjSet(box_b, "__proto__", bp_b)
                            }
                        }
                        JSRT_ObjSet(box_b, "__value__", th_b)
                        JSRT_ObjSet(box_b, "__class__", JSRT_CreateString("Boolean"))
                        JSVM__SetGlobal("this", box_b)
                    }
                    IfCondition EqualTo(tht_b, JSType.NUMBER) ThenBlock: {
                        box_n = JSRT_CreateObject()
                        ng_n = JSVM__GetGlobal("Number")
                        IfCondition EqualTo(JSRT_GetType(ng_n), JSType.FUNCTION) ThenBlock: {
                            np_n = JSRT_ObjGet(ng_n, "prototype")
                            IfCondition EqualTo(JSRT_GetType(np_n), JSType.OBJECT) ThenBlock: {
                                JSRT_ObjSet(box_n, "__proto__", np_n)
                            }
                        }
                        JSRT_ObjSet(box_n, "__value__", th_b)
                        JSRT_ObjSet(box_n, "__class__", JSRT_CreateString("Number"))
                        JSVM__SetGlobal("this", box_n)
                    }
                    IfCondition EqualTo(tht_b, JSType.STRING) ThenBlock: {
                        box_s = JSRT_CreateObject()
                        sg_s = JSVM__GetGlobal("String")
                        IfCondition EqualTo(JSRT_GetType(sg_s), JSType.FUNCTION) ThenBlock: {
                            sp_s = JSRT_ObjGet(sg_s, "prototype")
                            IfCondition EqualTo(JSRT_GetType(sp_s), JSType.OBJECT) ThenBlock: {
                                JSRT_ObjSet(box_s, "__proto__", sp_s)
                            }
                        }
                        JSRT_ObjSet(box_s, "__value__", th_b)
                        JSRT_ObjSet(box_s, "__class__", JSRT_CreateString("String"))
                        JSVM__SetGlobal("this", box_s)
                    }
                }
            }
        }

        cf_bc = JSRT_FuncGetBC(save_fv)
        IfCondition LessThan(cf_bc, 0) ThenBlock: {
            IfCondition EqualTo(cf_bc, -9999) ThenBlock: {
                ReturnValue(JSVM__GenNext(save_fv, save_ab, save_ac))
            }
            IfCondition EqualTo(cf_bc, -9998) ThenBlock: {
                ReturnValue(JSVM__GenReturn(save_fv, save_ab, save_ac))
            }
            IfCondition EqualTo(cf_bc, -9997) ThenBlock: {
                ReturnValue(JSVM__GenThrow(save_fv, save_ab, save_ac))
            }
            // M29d: native functions via CallFunc (Function.prototype.call/apply)
            cf_hid = Subtract(-1, cf_bc)
            cf_recv = JSRT_FuncGetEnv(save_fv)
            // array/string methods prefer global this (set by NFuncCall/NFuncApply)
            IfCondition Or(EqualTo(cf_hid, 98), EqualTo(cf_hid, 99)) ThenBlock: {
                th_cf = JSVM__GetGlobal("this")
                tht_cf = JSRT_GetType(th_cf)
                IfCondition And(NotEqual(tht_cf, JSType.NULL), NotEqual(tht_cf, JSType.UNDEFINED)) ThenBlock: {
                    cf_recv = th_cf
                }
            }
            // array methods 150-171 + reduceRight 174 + M29h 208-210
            // (not 172-173 values/iterator)
            is_arr_cf = 0
            IfCondition GreaterEqual(cf_hid, 150) ThenBlock: {
                IfCondition LessEqual(cf_hid, 171) ThenBlock: { is_arr_cf = 1 }
            }
            IfCondition EqualTo(cf_hid, 174) ThenBlock: { is_arr_cf = 1 }
            // M111: copyWithin/findLast/findLastIndex via Function.prototype.call
            IfCondition GreaterEqual(cf_hid, 208) ThenBlock: {
                IfCondition LessEqual(cf_hid, 210) ThenBlock: { is_arr_cf = 1 }
            }
            IfCondition EqualTo(is_arr_cf, 1) ThenBlock: {
                th_cf = JSVM__GetGlobal("this")
                tht_cf = JSRT_GetType(th_cf)
                IfCondition And(NotEqual(tht_cf, JSType.NULL), NotEqual(tht_cf, JSType.UNDEFINED)) ThenBlock: {
                    cf_recv = th_cf
                }
            }
            // M30a: string method ids also take this from global (proto.call path)
            is_str_cf = 0
            IfCondition GreaterEqual(cf_hid, 62) ThenBlock: {
                IfCondition LessEqual(cf_hid, 75) ThenBlock: {
                    IfCondition NotEqual(cf_hid, 72) ThenBlock: { is_str_cf = 1 }
                }
            }
            IfCondition EqualTo(cf_hid, 97) ThenBlock: { is_str_cf = 1 }
            IfCondition GreaterEqual(cf_hid, 180) ThenBlock: {
                IfCondition LessEqual(cf_hid, 186) ThenBlock: { is_str_cf = 1 }
            }
            IfCondition EqualTo(is_str_cf, 1) ThenBlock: {
                // Prefer global this when set (.call/.apply); else keep FuncGetEnv
                // (MatchStringMethod binds string receiver for "s".method())
                th_cf = JSVM__GetGlobal("this")
                tht_cf = JSRT_GetType(th_cf)
                IfCondition And(NotEqual(tht_cf, JSType.NULL), NotEqual(tht_cf, JSType.UNDEFINED)) ThenBlock: {
                    cf_recv = th_cf
                }
            }
            // String/Array method range (same as CALL)
            is_sm = 0
            IfCondition GreaterEqual(cf_hid, 62) ThenBlock: {
                IfCondition LessEqual(cf_hid, 76) ThenBlock: { is_sm = 1 }
            }
            IfCondition Or(Or(Or(EqualTo(cf_hid, 229), EqualTo(cf_hid, 230)), Or(EqualTo(cf_hid, 232), EqualTo(cf_hid, 233))), Or(EqualTo(cf_hid, 232), EqualTo(cf_hid, 233))) ThenBlock: { is_sm = 1 }
            IfCondition GreaterEqual(cf_hid, 97) ThenBlock: {
                IfCondition LessEqual(cf_hid, 99) ThenBlock: { is_sm = 1 }
            }
            IfCondition EqualTo(is_arr_cf, 1) ThenBlock: { is_sm = 1 }
            IfCondition GreaterEqual(cf_hid, 180) ThenBlock: {
                IfCondition LessEqual(cf_hid, 186) ThenBlock: { is_sm = 1 }
            }
            // M111: also route 208-210 through DispatchStringMethod
            IfCondition GreaterEqual(cf_hid, 208) ThenBlock: {
                IfCondition LessEqual(cf_hid, 210) ThenBlock: { is_sm = 1 }
            }
            IfCondition EqualTo(is_sm, 1) ThenBlock: {
                nr = JSVM__DispatchStringMethod(cf_hid, cf_recv, save_ab, save_ac)
                ReturnValue(nr)
            }
            // M30b: Promise methods (57-61, 77-78, 211-215)
            is_prom = 0
            IfCondition GreaterEqual(cf_hid, 57) ThenBlock: {
                IfCondition LessEqual(cf_hid, 61) ThenBlock: { is_prom = 1 }
            }
            IfCondition GreaterEqual(cf_hid, 77) ThenBlock: {
                IfCondition LessEqual(cf_hid, 78) ThenBlock: { is_prom = 1 }
            }
            IfCondition GreaterEqual(cf_hid, 211) ThenBlock: {
                IfCondition LessEqual(cf_hid, 215) ThenBlock: { is_prom = 1 }
            }
            IfCondition EqualTo(is_prom, 1) ThenBlock: {
                th_cf = JSVM__GetGlobal("this")
                tht_cf = JSRT_GetType(th_cf)
                IfCondition And(NotEqual(tht_cf, JSType.NULL), NotEqual(tht_cf, JSType.UNDEFINED)) ThenBlock: {
                    cf_recv = th_cf
                }
                nr = JSBridge__DispatchPromise(cf_hid, cf_recv, save_ab, save_ac)
                ReturnValue(nr)
            }
            // M30c/d: RegExp methods + match/search + getters (83-87, 216-224)
            is_rx_cf = 0
            IfCondition GreaterEqual(cf_hid, 83) ThenBlock: {
                IfCondition LessEqual(cf_hid, 87) ThenBlock: { is_rx_cf = 1 }
            }
            // M111: RegExp IDs 216-228 + 231 (exclude String/Array .at 232-233)
            IfCondition GreaterEqual(cf_hid, 216) ThenBlock: {
                IfCondition LessEqual(cf_hid, 228) ThenBlock: { is_rx_cf = 1 }
            }
            IfCondition EqualTo(cf_hid, 231) ThenBlock: { is_rx_cf = 1 }
            IfCondition EqualTo(is_rx_cf, 1) ThenBlock: {
                th_cf = JSVM__GetGlobal("this")
                tht_cf = JSRT_GetType(th_cf)
                IfCondition And(NotEqual(tht_cf, JSType.NULL), NotEqual(tht_cf, JSType.UNDEFINED)) ThenBlock: {
                    cf_recv = th_cf
                }
                nr = JSVM__DispatchRegExpMethod(cf_hid, cf_recv, save_ab, save_ac)
                ReturnValue(nr)
            }
            // Bridge / other natives
            IfCondition GreaterEqual(cf_hid, 22) ThenBlock: {
                nr = JSBridge_Dispatch(cf_hid, save_ab, save_ac)
                ReturnValue(nr)
            }
            IfCondition LessThan(cf_hid, 22) ThenBlock: {
                nr = JSRT_CallNative(cf_hid, save_ab, save_ac)
                ReturnValue(nr)
            }
            ReturnValue(JSRT_Undefined())
        }
        // Mole 15: generator function call via CallFunc (e.g. custom @@iterator)
        cf_env = JSRT_FuncGetEnv(save_fv)
        IfCondition EqualTo(cf_env, 71) ThenBlock: {
            gen_val = JSRT_CreateGenerator(save_fv, save_ab, save_ac)
            next_func = JSRT_CreateFunc(-9999, 1, 0, "next")
            JSRT_FuncSetEnv(next_func, gen_val)
            ret_func = JSRT_CreateFunc(-9998, 1, 0, "return")
            JSRT_FuncSetEnv(ret_func, gen_val)
            throw_func = JSRT_CreateFunc(-9997, 1, 0, "throw")
            JSRT_FuncSetEnv(throw_func, gen_val)
            gen_obj = JSRT_CreateObject()
            JSRT_ObjSet(gen_obj, "next", next_func)
            JSRT_ObjSet(gen_obj, "return", ret_func)
            JSRT_ObjSet(gen_obj, "throw", throw_func)
            JSRT_ObjSet(gen_obj, "__gen__", gen_val)
            ReturnValue(gen_obj)
        }
        cf_params = JSRT_FuncGetParams(save_fv)
        // 0x0FFFFFFF — bits 0-27 count; 28=arrow, 29=strict, 30=unmapped, 31=rest
        formal_n = BitwiseAnd(cf_params, 268435455)
        cf_locals = JSRT_FuncGetLocals(save_fv)

        // Mole 15: nest on LIVE stack/frames so try/catch unwind works.
        // Previous wipe+restore swallowed throws from next()/@@iterator.
        entry_fp = JSVMState.fp
        entry_pc = JSVMState.pc
        entry_sp = JSVMState.sp
        entry_halted = JSVMState.halted

        save_ff0 = Dereference(JSVMClosure.frame_funcs)
        save_fe0 = Dereference(JSVMClosure.frame_envs)
        save_fa0 = Dereference(JSVMClosure.frame_args)
        save_gen_exec = JSVMGen.is_gen_exec
        save_gen_gs = JSVMGen.active_gs

        pf_ok = JSVM__PushFrame(entry_pc, entry_sp, entry_sp, formal_n, cf_locals)
        IfCondition LessThan(pf_ok, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        JSVM__SetupCallEnv(save_fv)
        // M83b: eval/Function-created callables (field_init, getters) need own code
        // image — same as CALL path. Without this, CallFunc runs field_init against
        // the outer script bytecode after EvalSource RestoreOuter.
        JSVM__EnterFuncCode(save_fv)
        // Mole 16: per-function strict for CallFunc re-entry
        prev_strict_cf = JSVMState.is_strict
        faddr_cf = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
        StoreValue(Add(faddr_cf, 72), prev_strict_cf)
        IfCondition NotEqual(BitwiseAnd(cf_params, 536870912), 0) ThenBlock: {
            JSVMState.is_strict = 1
        }
        // M128: async functions via Function.prototype.call/apply (CallFunc path).
        // CALL marks frames with -65 when FuncGetEnv==65 so RETURN wraps Promise.
        // Without this, async fn.call(...) returns a bare value and .then fails.
        // Async is always strict — keep primitive thisArg (no ToObject box).
        cf_fenv = JSRT_FuncGetEnv(save_fv)
        IfCondition EqualTo(cf_fenv, 65) ThenBlock: {
            StoreValue(Add(faddr_cf, 40), -65)
            JSVMState.is_strict = 1
        }

        li = 0
        WhileLoop LessThan(li, cf_locals) {
            IfCondition LessThan(li, save_ac) ThenBlock: {
                pval = Dereference(Add(save_ab, Multiply(li, 8)))
                JSVM__StackPush(pval)
            } ElseBlock: {
                JSVM__StackPush(JSRT_Undefined())
            }
            li = Add(li, 1)
        }
        // M108: named function-expression — fdesc+108 is name_slot+1 (0=none)
        fdesc_cf_ns = JSRT_GetPayload(save_fv)
        IfCondition NotEqual(fdesc_cf_ns, 0) ThenBlock: {
            ns_enc_cf = Dereference(Add(fdesc_cf_ns, 108))
            IfCondition And(GreaterThan(ns_enc_cf, 0), LessEqual(ns_enc_cf, 512)) ThenBlock: {
                ns_slot_cf = Subtract(ns_enc_cf, 1)
                IfCondition LessThan(ns_slot_cf, cf_locals) ThenBlock: {
                    StoreValue(Add(JSVMState.stack, Multiply(Add(entry_sp, ns_slot_cf), 8)), save_fv)
                }
            }
        }

        // Mole 16: mirror CALL — SaveArguments + install args object.
        // Without this, RETURN's RestoreArguments sees frame_args=0 and
        // rebinds global "arguments" to a fresh undefined, breaking the
        // caller's arguments after getter/setter CallFunc re-entry.
        // Arrows (bit 28): leave outer arguments alone.
        IfCondition EqualTo(BitwiseAnd(cf_params, 268435456), 0) ThenBlock: {
            map_n_cf = formal_n
            IfCondition NotEqual(BitwiseAnd(cf_params, 1073741824), 0) ThenBlock: {
                map_n_cf = 0
            }
            args_obj_cf = JSVM_CreateArguments(save_ab, save_ac, save_fv, map_n_cf)
            JSVM__SaveArguments()
            JSVM__SetGlobal("arguments", args_obj_cf)
        } ElseBlock: {
            // Still snapshot so RETURN RestoreArguments is a no-op rebind
            JSVM__SaveArguments()
        }

        JSVMState.pc = cf_bc
        JSVMState.halted = 0
        // Nested CallFunc: ThrowValue must set exc_prop, not async-reject outer frame
        JSVMCall.depth = Add(JSVMCall.depth, 1)

        done_n = 0
        WhileLoop EqualTo(done_n, 0) {
            IfCondition LessEqual(JSVMState.fp, entry_fp) ThenBlock: {
                done_n = 1
            }
            IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                done_n = 1
            }
            IfCondition EqualTo(JSVMState.halted, 1) ThenBlock: {
                done_n = 1
            }
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                done_n = 1
            }
            IfCondition EqualTo(done_n, 0) ThenBlock: {
                rc = JSVM_Step()
                IfCondition EqualTo(rc, 0) ThenBlock: {
                    JSVMState.halted = 1
                }
                IfCondition EqualTo(rc, -1) ThenBlock: {
                    JSVMState.halted = 1
                }
            }
        }

        JSVMCall.depth = Subtract(JSVMCall.depth, 1)
        IfCondition LessThan(JSVMCall.depth, 0) ThenBlock: {
            JSVMCall.depth = 0
        }

        prop = 0
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
            prop = 1
        }
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            prop = 1
        }
        IfCondition LessThan(JSVMState.fp, entry_fp) ThenBlock: {
            prop = 1
        }
        IfCondition EqualTo(JSVMState.fp, entry_fp) ThenBlock: {
            IfCondition NotEqual(JSVMState.pc, entry_pc) ThenBlock: {
                IfCondition EqualTo(JSVMState.halted, 0) ThenBlock: {
                    prop = 1
                }
            }
        }
        IfCondition EqualTo(prop, 1) ThenBlock: {
            JSVMCall.exc_prop = 1
            // Preserve abrupt value for caller (ITER_CLOSE, getters, etc.)
            IfCondition EqualTo(JSVMCall.thrown_val, 0) ThenBlock: {
                IfCondition NotEqual(JSVMState.exc_val, 0) ThenBlock: {
                    JSVMCall.thrown_val = JSVMState.exc_val
                }
            }
            // If THROW already unwound to an outer catch, do not clobber it.
            // Only restore when uncaught (error) or still nested above entry.
            need_restore = 0
            IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                need_restore = 1
            }
            IfCondition GreaterThan(JSVMState.fp, entry_fp) ThenBlock: {
                need_restore = 1
            }
            IfCondition EqualTo(need_restore, 1) ThenBlock: {
                // M83b: drop own-code image if RETURN did not LeaveFuncCode
                JSVM__LeaveFuncCode()
                JSVMState.fp = entry_fp
                JSVMState.sp = entry_sp
                JSVMState.pc = entry_pc
                JSVMState.halted = entry_halted
                JSVMState.error = 0
                JSVMState.is_strict = prev_strict_cf
            }
            StoreValue(JSVMClosure.frame_funcs, save_ff0)
            StoreValue(JSVMClosure.frame_envs, save_fe0)
            StoreValue(JSVMClosure.frame_args, save_fa0)
            JSVMGen.is_gen_exec = save_gen_exec
            JSVMGen.active_gs = save_gen_gs
            ReturnValue(JSRT_Undefined())
        }

        cf_result = JSRT_Undefined()
        IfCondition GreaterThan(JSVMState.sp, entry_sp) ThenBlock: {
            cf_result = JSVM__StackPop()
        }
        // Clear sticky exception from nested throws that CallFunc already consumed
        JSVMCall.exc_prop = 0
        JSVMCall.thrown_val = 0
        JSVMState.exc_val = 0
        // M83b: ensure outer code restored if callee did not RETURN normally
        JSVM__LeaveFuncCode()
        JSVMState.halted = entry_halted
        JSVMState.pc = entry_pc

        StoreValue(JSVMClosure.frame_funcs, save_ff0)
        StoreValue(JSVMClosure.frame_envs, save_fe0)
        StoreValue(JSVMClosure.frame_args, save_fa0)
        JSVMGen.is_gen_exec = save_gen_exec
        JSVMGen.active_gs = save_gen_gs

        ReturnValue(cf_result)
    }
}
