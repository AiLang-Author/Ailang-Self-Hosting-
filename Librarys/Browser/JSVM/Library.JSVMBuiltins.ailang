// Library.JSVMBuiltins.ailang — Built-in installation, generators, eval
// Split from Library.JSVM.ailang. FixedPools declared in root file.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// =============================================================================
// CONVENIENCE: Install built-in globals (console, Math, etc.)
// Delegates to JSRuntime's built-in registration.
// =============================================================================
Function.JSVM_InstallBuiltins {
    Output: Integer
    Body: {
        // Register JSRuntime built-in native functions
        JSRT_RegisterBuiltins()

        // Create console object and install as global
        // console.log must use handler_id=22 (JSBridge CONSOLE_LOG)
        // which maps to bc_offset = -(22+1) = -23
        // JSRT_CreateConsole used stub handler_id=0 that silently returned undefined
        console_obj = JSRT_CreateObject()
        JSRT__Push(console_obj)
        log_func = JSRT_CreateFunc(-23, 1, 0, "console.log")
        console_obj = JSRT__Pop()
        JSRT_ObjSet(console_obj, "log", log_func)
        JSVM__SetGlobal("console", console_obj)

        // Create Math object and install as global
        math_obj = JSBridge__CreateMathObj()
        JSRT_ObjSet(math_obj, "__class__", JSRT_CreateString("Math"))
        JSVM__SetGlobal("Math", math_obj)

        // Create JSON object and install as global
        json_obj = JSRT_CreateObject()
        JSRT__Push(json_obj)
        jp_func = JSBridge__CreateNativeFunc(JSNativeID.JSON_PARSE, "JSON.parse", 1)
        json_obj = JSRT__Pop()
        JSRT_ObjSet(json_obj, "parse", jp_func)
        JSRT__Push(json_obj)
        js_func = JSBridge__CreateNativeFunc(JSNativeID.JSON_STRINGIFY, "JSON.stringify", 1)
        json_obj = JSRT__Pop()
        JSRT_ObjSet(json_obj, "stringify", js_func)
        JSRT_ObjSet(json_obj, "__class__", JSRT_CreateString("JSON"))
        JSVM__SetGlobal("JSON", json_obj)

        // Install undefined, null, NaN, Infinity as globals
        JSVM__SetGlobal("undefined", JSRT_Undefined())
        JSVM__SetGlobal("null", JSRT_Null())
        // NaN = 0x7FF8000000000000 = 9221120237041090560
        JSVM__SetGlobal("NaN", JSRT_CreateFloat(9221120237041090560))
        // Infinity = 0x7FF0000000000000 = 9218868437227405312
        JSVM__SetGlobal("Infinity", JSRT_CreateFloat(9218868437227405312))

        // Install type conversion constructors as global functions
        // Number() = handler 8, String() = handler 9, Boolean() = handler 10
        num_func = JSBridge__CreateNativeFunc(8, "Number", 1)
        JSVM__SetGlobal("Number", num_func)
        // M19d: Number.POSITIVE_INFINITY / NEGATIVE_INFINITY / NaN (S11.13 A4)
        // IEEE bit patterns as signed 64-bit integers
        // M128e6w: ES Number constants are {W:false,E:false,C:false} (bits 0)
        JSRT_ObjSet(num_func, "POSITIVE_INFINITY", JSRT_CreateFloat(9218868437227405312))
        JSBridge__SetAttrBits(num_func, "POSITIVE_INFINITY", 0)
        JSRT_ObjSet(num_func, "NEGATIVE_INFINITY", JSRT_CreateFloat(-4503599627370496))
        JSBridge__SetAttrBits(num_func, "NEGATIVE_INFINITY", 0)
        JSRT_ObjSet(num_func, "NaN", JSRT_CreateFloat(9221120237041090560))
        JSBridge__SetAttrBits(num_func, "NaN", 0)
        // MAX_VALUE = 0x7FEFFFFFFFFFFFFF, MIN_VALUE = 0x1, EPSILON ≈ 2^-52
        JSRT_ObjSet(num_func, "MAX_VALUE", JSRT_CreateFloat(9218868437227405311))
        JSBridge__SetAttrBits(num_func, "MAX_VALUE", 0)
        JSRT_ObjSet(num_func, "MIN_VALUE", JSRT_CreateFloat(1))
        JSBridge__SetAttrBits(num_func, "MIN_VALUE", 0)
        JSRT_ObjSet(num_func, "MAX_SAFE_INTEGER", JSRT_CreateFloat(4845873199050653695))
        JSBridge__SetAttrBits(num_func, "MAX_SAFE_INTEGER", 0)
        JSRT_ObjSet(num_func, "MIN_SAFE_INTEGER", JSRT_CreateFloat(-4377498837804122113))
        JSBridge__SetAttrBits(num_func, "MIN_SAFE_INTEGER", 0)
        JSRT_ObjSet(num_func, "EPSILON", JSRT_CreateFloat(4372995238176751616))
        JSBridge__SetAttrBits(num_func, "EPSILON", 0)
        str_func = JSBridge__CreateNativeFunc(9, "String", 1)
        JSVM__SetGlobal("String", str_func)
        bool_func = JSBridge__CreateNativeFunc(10, "Boolean", 1)
        JSVM__SetGlobal("Boolean", bool_func)

        // M35: Boolean.prototype valueOf/toString
        bool_proto = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(bool_proto, "__proto__", JSRTState.object_proto)
        }
        JSRT__Push(bool_func)
        JSRT__Push(bool_proto)
        bvo = JSBridge__CreateNativeFunc(JSNativeID.BOOL_VALUE_OF, "valueOf", 0)
        bool_proto = JSRT__Pop()
        bool_func = JSRT__Pop()
        JSRT_ObjSet(bool_proto, "valueOf", bvo)
        JSBridge__SetAttrBits(bool_proto, "valueOf", 5)
        JSRT__Push(bool_func)
        JSRT__Push(bool_proto)
        bts = JSBridge__CreateNativeFunc(JSNativeID.BOOL_TO_STRING, "toString", 0)
        bool_proto = JSRT__Pop()
        bool_func = JSRT__Pop()
        JSRT_ObjSet(bool_proto, "toString", bts)
        JSBridge__SetAttrBits(bool_proto, "toString", 5)
        JSRT_ObjSet(bool_func, "prototype", bool_proto)
        JSRT_ObjSet(bool_proto, "constructor", bool_func)

        // M35: Number.prototype valueOf/toString
        num_proto = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(num_proto, "__proto__", JSRTState.object_proto)
        }
        JSRT__Push(num_func)
        JSRT__Push(num_proto)
        nvo = JSBridge__CreateNativeFunc(JSNativeID.NUM_VALUE_OF, "valueOf", 0)
        num_proto = JSRT__Pop()
        num_func = JSRT__Pop()
        JSRT_ObjSet(num_proto, "valueOf", nvo)
        JSBridge__SetAttrBits(num_proto, "valueOf", 5)
        JSRT__Push(num_func)
        JSRT__Push(num_proto)
        nts = JSBridge__CreateNativeFunc(JSNativeID.NUM_TO_STRING, "toString", 0)
        num_proto = JSRT__Pop()
        num_func = JSRT__Pop()
        JSRT_ObjSet(num_proto, "toString", nts)
        JSBridge__SetAttrBits(num_proto, "toString", 5)
        JSRT_ObjSet(num_func, "prototype", num_proto)
        JSRT_ObjSet(num_proto, "constructor", num_func)

        // Install global utility functions
        // isNaN() = handler 11, isFinite() = handler 12
        nan_func = JSBridge__CreateNativeFunc(11, "isNaN", 1)
        JSVM__SetGlobal("isNaN", nan_func)
        fin_func = JSBridge__CreateNativeFunc(12, "isFinite", 1)
        JSVM__SetGlobal("isFinite", fin_func)

        // eval() = handler 193 (JSNativeID.EVAL) — re-entrant pipeline
        eval_func = JSBridge__CreateNativeFunc(193, "eval", 1)
        JSVM__SetGlobal("eval", eval_func)

        // Symbol() = handler 194 — unique keys for iterators etc.
        sym_func = JSBridge__CreateNativeFunc(194, "Symbol", 1)
        // Well-known Symbol.iterator
        iter_sym = JSVM_CreateSymbol(0)
        JSVMSymbol.iterator = iter_sym
        JSRT_FuncPropSet(sym_func, "iterator", iter_sym)
        // M109: well-known Symbol.asyncIterator
        aiter_sym = JSVM_CreateSymbol(0)
        JSVMSymbol.asyncIterator = aiter_sym
        JSRT_FuncPropSet(sym_func, "asyncIterator", aiter_sym)
        // M29g: well-known Symbol.species (ArraySpeciesCreate)
        sp_sym = JSVM_CreateSymbol(0)
        JSVMSymbol.species = sp_sym
        JSRT_FuncPropSet(sym_func, "species", sp_sym)
        // M30f: RegExp well-known symbols
        sm_sym = JSVM_CreateSymbol(0)
        JSVMSymbol.match = sm_sym
        JSRT_FuncPropSet(sym_func, "match", sm_sym)
        sr_sym = JSVM_CreateSymbol(0)
        JSVMSymbol.replace = sr_sym
        JSRT_FuncPropSet(sym_func, "replace", sr_sym)
        ss_sym = JSVM_CreateSymbol(0)
        JSVMSymbol.search = ss_sym
        JSRT_FuncPropSet(sym_func, "search", ss_sym)
        sp2_sym = JSVM_CreateSymbol(0)
        JSVMSymbol.split = sp2_sym
        JSRT_FuncPropSet(sym_func, "split", sp2_sym)
        // M45: Symbol.toStringTag for Object.prototype.toString
        stt_sym = JSVM_CreateSymbol(0)
        JSVMSymbol.toStringTag = stt_sym
        JSRT_FuncPropSet(sym_func, "toStringTag", stt_sym)
        // M80: Symbol.toPrimitive for computed property names / ToPropertyKey
        tp_sym = JSVM_CreateSymbol(0)
        JSVMSymbol.toPrimitive = tp_sym
        JSRT_FuncPropSet(sym_func, "toPrimitive", tp_sym)
        // M128d: Symbol.unscopables for with
        uns_sym = JSVM_CreateSymbol(0)
        JSVMSymbol.unscopables = uns_sym
        JSRT_FuncPropSet(sym_func, "unscopables", uns_sym)
        JSVM__SetGlobal("Symbol", sym_func)

        // parseInt() = handler 13, parseFloat() = handler 14
        pi_func = JSBridge__CreateNativeFunc(13, "parseInt", 1)
        JSVM__SetGlobal("parseInt", pi_func)
        pf_func = JSBridge__CreateNativeFunc(14, "parseFloat", 1)
        JSVM__SetGlobal("parseFloat", pf_func)

        // Install Error constructors as global functions
        // Error = handler 15, TypeError = 16, RangeError = 17, ReferenceError = 18
        // SyntaxError = 19, URIError = 20, EvalError = 21
        err_func = JSBridge__CreateNativeFunc(15, "Error", 1)
        JSVM__SetGlobal("Error", err_func)
        terr_func = JSBridge__CreateNativeFunc(16, "TypeError", 1)
        JSVM__SetGlobal("TypeError", terr_func)
        rerr_func = JSBridge__CreateNativeFunc(17, "RangeError", 1)
        JSVM__SetGlobal("RangeError", rerr_func)
        rferr_func = JSBridge__CreateNativeFunc(18, "ReferenceError", 1)
        JSVM__SetGlobal("ReferenceError", rferr_func)
        serr_func = JSBridge__CreateNativeFunc(19, "SyntaxError", 1)
        JSVM__SetGlobal("SyntaxError", serr_func)
        uerr_func = JSBridge__CreateNativeFunc(20, "URIError", 1)
        JSVM__SetGlobal("URIError", uerr_func)
        eerr_func = JSBridge__CreateNativeFunc(21, "EvalError", 1)
        JSVM__SetGlobal("EvalError", eerr_func)

        // Install Object global with defineProperty, keys, create, etc.
        // NOTE: Uses JSRT__Push/Pop (not JSBridge__Push/Pop) because JSBridge
        // may not be initialized yet when this is called from JSEngine__Run.
        //
        // Object.prototype is the root of the default prototype chain.
        // Cached in JSRTState.object_proto for NEW_OBJECT / instanceof.
        obj_proto = JSRT_CreateObject()
        JSRTState.object_proto = obj_proto

        obj_global = JSRT_CreateObject()
        JSVM__SetGlobal("Object", obj_global)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        dp_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_DEFINE_PROP, "defineProperty", 3)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "defineProperty", dp_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        ok_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_KEYS, "keys", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "keys", ok_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        oc_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_CREATE, "create", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "create", oc_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        oa_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_ASSIGN, "assign", 2)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "assign", oa_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        of_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_FREEZE, "freeze", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "freeze", of_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        osl_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_SEAL, "seal", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "seal", osl_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        ope_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_PREVENT_EXT, "preventExtensions", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "preventExtensions", ope_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        oie_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_IS_EXTENSIBLE, "isExtensible", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "isExtensible", oie_func)
        // M27b: isFrozen / isSealed
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        oif_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_IS_FROZEN, "isFrozen", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "isFrozen", oif_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        oisd_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_IS_SEALED, "isSealed", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "isSealed", oisd_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        ogopn_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_GET_OWN_PROP_NAMES, "getOwnPropertyNames", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "getOwnPropertyNames", ogopn_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        ogopds_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_GET_OWN_PROP_DESCS, "getOwnPropertyDescriptors", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "getOwnPropertyDescriptors", ogopds_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        odps_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_DEF_PROPERTIES, "defineProperties", 2)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "defineProperties", odps_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        oho_g = JSBridge__CreateNativeFunc(JSNativeID.OBJ_HAS_OWN_PROP, "hasOwn", 2)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "hasOwn", oho_g)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        ois_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_IS, "is", 2)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "is", ois_func)
        // M34: Object.entries / values / fromEntries (were only on JSBridge CreateObjectGlobal)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        oe_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_ENTRIES, "entries", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "entries", oe_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        ov_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_VALUES, "values", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "values", ov_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        ofe_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_FROM_ENTRIES, "fromEntries", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "fromEntries", ofe_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        gpo_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_GET_PROTO_OF, "getPrototypeOf", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "getPrototypeOf", gpo_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        spo_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_SET_PROTO_OF, "setPrototypeOf", 2)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "setPrototypeOf", spo_func)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        gopd_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_GET_OWN_PROP_DESC, "getOwnPropertyDescriptor", 2)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "getOwnPropertyDescriptor", gopd_func)
        // __ctor__ for new Object() support
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        obj_ctor = JSBridge__CreateNativeFunc(JSNativeID.OBJ_CTOR, "Object", 0)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "__ctor__", obj_ctor)
        // Expose Object.prototype for instanceof and user code
        JSRT_ObjSet(obj_global, "prototype", obj_proto)
        JSRT_ObjSet(obj_ctor, "prototype", obj_proto)
        JSRT_ObjSet(obj_proto, "constructor", obj_ctor)

        // Object.prototype.isPrototypeOf / hasOwnProperty (M22)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        ipo_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_IS_PROTO_OF, "isPrototypeOf", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_proto, "isPrototypeOf", ipo_func)
        JSBridge__SetAttrBits(obj_proto, "isPrototypeOf", 5)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        hop_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_PROTO_HAS_OWN, "hasOwnProperty", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_proto, "hasOwnProperty", hop_func)
        JSBridge__SetAttrBits(obj_proto, "hasOwnProperty", 5)
        // M77: legacy __lookupGetter__/__lookupSetter__ (private-is-not-own tests)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        lg_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_LOOKUP_GETTER, "__lookupGetter__", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_proto, "__lookupGetter__", lg_func)
        JSBridge__SetAttrBits(obj_proto, "__lookupGetter__", 5)
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        ls_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_LOOKUP_SETTER, "__lookupSetter__", 1)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_proto, "__lookupSetter__", ls_func)
        JSBridge__SetAttrBits(obj_proto, "__lookupSetter__", 5)
        // M34: Object.prototype.toString — [object Type]
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        ots_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_PROTO_TO_STRING, "toString", 0)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_proto, "toString", ots_func)
        JSBridge__SetAttrBits(obj_proto, "toString", 5)
        // M36: Object.prototype.valueOf
        JSRT__Push(obj_global)
        JSRT__Push(obj_proto)
        ovo_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_PROTO_VALUE_OF, "valueOf", 0)
        obj_proto = JSRT__Pop()
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_proto, "valueOf", ovo_func)
        JSBridge__SetAttrBits(obj_proto, "valueOf", 5)

        // M39: Boolean/Number/String were installed before Object.prototype existed
        // (object_proto was 0). Re-link so `new Boolean() instanceof Object` works
        // and defineProperties(Properties=Boolean) getters see correct identity.
        wr_g = JSVM__GetGlobal("Boolean")
        IfCondition EqualTo(JSRT_GetType(wr_g), JSType.FUNCTION) ThenBlock: {
            wr_p = JSRT_ObjGet(wr_g, "prototype")
            IfCondition EqualTo(JSRT_GetType(wr_p), JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(wr_p, "__proto__", obj_proto)
            }
        }
        wr_g = JSVM__GetGlobal("Number")
        IfCondition EqualTo(JSRT_GetType(wr_g), JSType.FUNCTION) ThenBlock: {
            wr_p = JSRT_ObjGet(wr_g, "prototype")
            IfCondition EqualTo(JSRT_GetType(wr_p), JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(wr_p, "__proto__", obj_proto)
            }
        }
        wr_g = JSVM__GetGlobal("String")
        IfCondition EqualTo(JSRT_GetType(wr_g), JSType.FUNCTION) ThenBlock: {
            wr_p = JSRT_ObjGet(wr_g, "prototype")
            IfCondition EqualTo(JSRT_GetType(wr_p), JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(wr_p, "__proto__", obj_proto)
            }
        }

        // Error constructors were installed before Object.prototype existed.
        // Link Error.prototype → Object.prototype; subclasses → Error.prototype
        // so `new TypeError() instanceof Error` works.
        err_proto = JSRTState.undef_val
        err_g = JSVM__GetGlobal("Error")
        IfCondition EqualTo(JSRT_GetType(err_g), JSType.FUNCTION) ThenBlock: {
            err_proto = JSRT_ObjGet(err_g, "prototype")
            IfCondition EqualTo(JSRT_GetType(err_proto), JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(err_proto, "__proto__", obj_proto)
                JSRT_ObjSet(err_proto, "name", JSRT_CreateString("Error"))
                JSRT_ObjSet(err_proto, "message", JSRT_CreateString(""))
                JSRT_ObjSet(err_proto, "__class__", JSRT_CreateString("Error"))
            }
        }
        // Subclass prototypes inherit from Error.prototype
        err_g = JSVM__GetGlobal("TypeError")
        IfCondition EqualTo(JSRT_GetType(err_g), JSType.FUNCTION) ThenBlock: {
            ep = JSRT_ObjGet(err_g, "prototype")
            IfCondition EqualTo(JSRT_GetType(ep), JSType.OBJECT) ThenBlock: {
                IfCondition EqualTo(JSRT_GetType(err_proto), JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(ep, "__proto__", err_proto)
                } ElseBlock: {
                    JSRT_ObjSet(ep, "__proto__", obj_proto)
                }
                JSRT_ObjSet(ep, "name", JSRT_CreateString("TypeError"))
            }
        }
        err_g = JSVM__GetGlobal("RangeError")
        IfCondition EqualTo(JSRT_GetType(err_g), JSType.FUNCTION) ThenBlock: {
            ep = JSRT_ObjGet(err_g, "prototype")
            IfCondition EqualTo(JSRT_GetType(ep), JSType.OBJECT) ThenBlock: {
                IfCondition EqualTo(JSRT_GetType(err_proto), JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(ep, "__proto__", err_proto)
                } ElseBlock: {
                    JSRT_ObjSet(ep, "__proto__", obj_proto)
                }
                JSRT_ObjSet(ep, "name", JSRT_CreateString("RangeError"))
            }
        }
        err_g = JSVM__GetGlobal("ReferenceError")
        IfCondition EqualTo(JSRT_GetType(err_g), JSType.FUNCTION) ThenBlock: {
            ep = JSRT_ObjGet(err_g, "prototype")
            IfCondition EqualTo(JSRT_GetType(ep), JSType.OBJECT) ThenBlock: {
                IfCondition EqualTo(JSRT_GetType(err_proto), JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(ep, "__proto__", err_proto)
                } ElseBlock: {
                    JSRT_ObjSet(ep, "__proto__", obj_proto)
                }
                JSRT_ObjSet(ep, "name", JSRT_CreateString("ReferenceError"))
            }
        }
        err_g = JSVM__GetGlobal("SyntaxError")
        IfCondition EqualTo(JSRT_GetType(err_g), JSType.FUNCTION) ThenBlock: {
            ep = JSRT_ObjGet(err_g, "prototype")
            IfCondition EqualTo(JSRT_GetType(ep), JSType.OBJECT) ThenBlock: {
