        func_proto = JSBridge__CreateNativeFunc(JSNativeID.FUNC_PROTO, "", 0)
        // Clear auto .prototype exotic slot (Function.prototype has no .prototype)
        fp_desc = RDMEM_64(func_proto, 8)
        IfCondition NotEqual(fp_desc, 0) ThenBlock: {
            WRMEM_64(fp_desc, 48, 0)
        }
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
