            }
        }
        IfCondition And(NotEqual(math_v, 0), NotEqual(math_v, JSRTState.undef_val)) ThenBlock: {
            JSRT_ObjSet(glob_this, "Math", math_v)
            JSBridge__SetAttrBits(glob_this, "Math", 7)
        }
        // Global Symbol is a function binding: writable, not enumerable, configurable.
        sym_gv = JSVM__GetGlobal("Symbol")
        IfCondition And(NotEqual(sym_gv, 0), NotEqual(sym_gv, JSRTState.undef_val)) ThenBlock: {
            JSRT_ObjSet(glob_this, "Symbol", sym_gv)
            JSBridge__SetAttrBits(glob_this, "Symbol", 5)
        }
        // Built-in error constructors: writable, not enumerable, configurable.
        JSVM_MirrorBuiltin(glob_this, "Error")
        JSVM_MirrorBuiltin(glob_this, "TypeError")
        JSVM_MirrorBuiltin(glob_this, "RangeError")
        JSVM_MirrorBuiltin(glob_this, "ReferenceError")
        JSVM_MirrorBuiltin(glob_this, "SyntaxError")
        JSVM_MirrorBuiltin(glob_this, "URIError")
        JSVM_MirrorBuiltin(glob_this, "EvalError")
        JSVM_MirrorBuiltin(glob_this, "AggregateError")
        JSVM_MirrorBuiltin(glob_this, "parseInt")
        JSVM_MirrorBuiltin(glob_this, "parseFloat")
        JSVM_MirrorBuiltin(glob_this, "encodeURI")
        JSVM_MirrorBuiltin(glob_this, "decodeURI")
        JSVM_MirrorBuiltin(glob_this, "encodeURIComponent")
        JSVM_MirrorBuiltin(glob_this, "decodeURIComponent")
        JSVM_InstallBuiltinSpecies()

        ReturnValue(1)
    }
}
