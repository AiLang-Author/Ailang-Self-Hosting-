// Library.JSVMDispatch.ailang — Opcode dispatch loop (JSVM_Step)
// Split from Library.JSVM.ailang. FixedPools declared in root file.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// =============================================================================
// M26k.10: engine private keys are mangled "#name@brandId".
// Public properties may be named "#constructor" etc. — not private.
// Returns 1 if ptr is a mangled private name, else 0.
// =============================================================================
Function.JSVM__IsMangledPrivate {
    Input: ptr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(ptr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(ptr, 0), 35) ThenBlock: { ReturnValue(0) }
        pi = 1
        WhileLoop LessThan(pi, 256) {
            pb = GetByte(ptr, pi)
            IfCondition EqualTo(pb, 0) ThenBlock: { ReturnValue(0) }
            // '@' = 64 — brand separator from JSComp__AddString
            IfCondition EqualTo(pb, 64) ThenBlock: { ReturnValue(1) }
            pi = Add(pi, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// M26k.9: InitializeInstanceFields for one constructor (own __field_init__ only)
// Spec: run after this-bind (base CONSTRUCT / post-super), before ctor body.
// Returns 0 ok, 1 if field init threw (exc_prop already set).
// =============================================================================
Function.JSVM__RunFieldInitForCtor {
    Input: instance: Address
    Input: ctor_fn: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(instance, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ctor_fn, 0) ThenBlock: { ReturnValue(0) }
        fi_proto = JSRT_FuncPropGet(ctor_fn, "prototype")
        IfCondition NotEqual(JSRT_GetType(fi_proto), JSType.OBJECT) ThenBlock: {
            ReturnValue(0)
        }
        fi_hash = Dereference(Add(fi_proto, 8))
        IfCondition EqualTo(fi_hash, 0) ThenBlock: { ReturnValue(0) }
        fi_fn = PropTable_Lookup(fi_hash, "__field_init__")
        IfCondition EqualTo(fi_fn, -1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_GetType(fi_fn), JSType.FUNCTION) ThenBlock: {
            ReturnValue(0)
        }
        fi_prev_this = JSVM__GetGlobal("this")
        fi_prev_tdz = JSVMState.this_tdz
        JSVM__SetGlobal("this", instance)
        JSVMState.this_tdz = 0
        JSVMState.private_init = 0
        // CreateDataPropertyOrThrow — do not invoke inherited setters
        JSVMState.field_define = 1
        fi_buf = JSVMCallBuf.buf
        StoreValue(fi_buf, instance)
        JSVM__CallFunc(fi_fn, fi_buf, 1)
        JSVMState.field_define = 0
        JSVMState.private_init = 0
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            JSVM__SetGlobal("this", fi_prev_this)
            JSVMState.this_tdz = fi_prev_tdz
            ReturnValue(1)
        }
        JSVM__SetGlobal("this", fi_prev_this)
        JSVMState.this_tdz = fi_prev_tdz
        ReturnValue(0)
    }
}

// =============================================================================
// STEP — execute a single bytecode instruction
// Returns: 1 = still running, 0 = halted, -1 = error
// =============================================================================
Function.JSVM_Step {
    Output: Integer
    Body: {
        // Check halted/error flags
        IfCondition EqualTo(JSVMState.halted, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Check PC bounds
        IfCondition GreaterEqual(JSVMState.pc, JSVMState.code_len) ThenBlock: {
            JSVMState.halted = 1
            ReturnValue(0)
        }

        // Fetch opcode
        op = JSVM__ReadByte()
        JSVMState.steps = Add(JSVMState.steps, 1)

        // Per-step trace (DEBUG) — disabled (set to unreachable threshold)
        // To enable: lower the threshold below max_steps
        IfCondition GreaterEqual(JSVMState.steps, 999999999) ThenBlock: {
            PrintMessage("[T] s=")
            PrintNumber(JSVMState.steps)
            PrintMessage(" op=")
            PrintNumber(op)
            PrintMessage(" sp=")
            PrintNumber(JSVMState.sp)
            PrintMessage(" pc=")
            PrintNumber(JSVMState.pc)
            PrintMessage("\n")
        }

        // Progress trace (every 5M steps)
        _st = JSVMState.steps
        _mod = Modulo(_st, 5000000)
        IfCondition EqualTo(_mod, 0) ThenBlock: {
            PrintMessage("[STEP] ")
            PrintNumber(_st)
            PrintMessage("\n")
        }

        // Check step limit
        IfCondition GreaterEqual(JSVMState.steps, JSVMState.max_steps) ThenBlock: {
            JSVMState.error = 1
            ReturnValue(-1)
        }

        // Check runtime OOM (val_pool / str_slab / func_slab exhaustion)
        IfCondition EqualTo(JSRTState.oom, 1) ThenBlock: {
            PrintMessage("[JSEngine] OOM at step ")
            PrintNumber(JSVMState.steps)
            PrintMessage(" str=")
            PrintNumber(JSRTState.str_slab_pos)
            PrintMessage("/")
            PrintNumber(JSRTState.str_slab_cap)
            PrintMessage(" vals=")
            PrintNumber(JSRTState.val_count)
            PrintMessage("/")
            PrintNumber(JSRTConst.MAX_VALUES)
            PrintMessage(" func=")
            PrintNumber(JSRTState.func_slab_pos)
            PrintMessage("/")
            PrintNumber(JSRTState.func_slab_cap)
            PrintMessage("\n")
            JSVMState.error = 1
            ReturnValue(-1)
        }

        // =====================================================================
        // OPCODE DISPATCH — Branch (switch) for O(1) dispatch
        // =====================================================================
        Branch op {

            // HALT (0)
            Case 0: {
                JSVMState.halted = 1
                ReturnValue(0)
            }

            // PUSH_CONST (1) — 16-bit operand: constant pool index
            Case 1: {
                cidx = JSVM__Read16()
                cval = JSVM__LoadConst(cidx)
                JSVM__StackPush(cval)
                ReturnValue(1)
            }

            // PUSH_UNDEF (2)
            Case 2: {
                JSVM__StackPush(JSRT_Undefined())
                ReturnValue(1)
            }

            // PUSH_HOLE (9) — array elision sentinel
            Case 9: {
                JSVM__StackPush(JSRTState.hole_val)
                ReturnValue(1)
            }

            // PUSH_NULL (3)
            Case 3: {
                JSVM__StackPush(JSRT_Null())
                ReturnValue(1)
            }

            // PUSH_TRUE (4)
            Case 4: {
                JSVM__StackPush(JSRT_True())
                ReturnValue(1)
            }

            // PUSH_FALSE (5)
            Case 5: {
                JSVM__StackPush(JSRT_False())
                ReturnValue(1)
            }

            // POP (6)
            Case 6: {
                JSVM__StackPop()
                ReturnValue(1)
            }

            // DUP (7) — duplicate top of stack
            Case 7: {
                top = JSVM__StackPeek()
                JSVM__StackPush(top)
                ReturnValue(1)
            }

            // SWAP (8) — swap top two stack elements
            Case 8: {
                sw_a = JSVM__StackPop()
                sw_b = JSVM__StackPop()
                JSVM__StackPush(sw_a)
                JSVM__StackPush(sw_b)
                ReturnValue(1)
            }

            // GET_LOCAL (10) — 16-bit operand: local slot index
            // M128e6c/e: free-var SET_FREE updates GlobalHash; stack may lag
            // (generator formal dstr: free += leaves stack at old number).
            // Prefer non-undef GlobalHash when __ls_ maps. Eval-mode class names
            // are not in GlobalHash (lookup -1) so stack wins.
            Case 10: {
                slot = JSVM__Read16()
                lval = JSVM__GetLocal(slot)
                IfCondition EqualTo(JSVMState.fp, 0) ThenBlock: {
                    IfCondition And(NotEqual(JSVMClosure.script_env, 0), NotEqual(JSVMClosure.script_env, JSRTState.undef_val)) ThenBlock: {
                        // Build __ls_ + decimal(slot) in getter_buf (no embedded NUL)
                        lsb = JSVMCallBuf.getter_buf
                        SetByte(lsb, 0, 95)
                        SetByte(lsb, 1, 95)
                        SetByte(lsb, 2, 108)
                        SetByte(lsb, 3, 115)
                        SetByte(lsb, 4, 95)
                        sn_tmp = slot
                        digs = 0
                        IfCondition EqualTo(sn_tmp, 0) ThenBlock: {
                            SetByte(lsb, 5, 48)
                            digs = 1
                        } ElseBlock: {
                            WhileLoop GreaterThan(sn_tmp, 0) {
                                SetByte(lsb, Add(32, digs), Add(48, Modulo(sn_tmp, 10)))
                                sn_tmp = Divide(sn_tmp, 10)
                                digs = Add(digs, 1)
                            }
                            ri = 0
                            WhileLoop LessThan(ri, digs) {
                                SetByte(lsb, Add(5, ri), GetByte(lsb, Add(32, Subtract(Subtract(digs, 1), ri))))
                                ri = Add(ri, 1)
                            }
                        }
                        SetByte(lsb, Add(5, digs), 0)
                        nm_ls = JSRT_ObjGet(JSVMClosure.script_env, lsb)
                        IfCondition EqualTo(JSRT_GetType(nm_ls), JSType.STRING) ThenBlock: {
                            gval = GlobalHash_Lookup(JSRT_GetPayload(nm_ls))
                            IfCondition NotEqual(gval, -1) ThenBlock: {
                                IfCondition NotEqual(gval, JSRTState.undef_val) ThenBlock: {
                                    lval = gval
                                }
                            }
                        }
                    }
                }
                JSVM__StackPush(lval)
                ReturnValue(1)
            }

            // SET_LOCAL (11) — 16-bit operand: local slot index
            Case 11: {
                slot = JSVM__Read16()
                sval = JSVM__StackPop()
                JSVM__SetLocal(slot, sval)
                // Non-strict mapped arguments: keep arguments[slot] in sync
                JSVM_SyncLocalToArguments(slot, sval)
                // M128e6n: top-level let/var dual-bind — GET_LOCAL prefers
                // GlobalHash via __ls_<slot>. If SET_GLOBAL was skipped or used
                // a different const-pool key, stack and GlobalHash diverge
                // (`let x=0; x=1` left x at 0). Mirror stack into GlobalHash.
                IfCondition EqualTo(JSVMState.fp, 0) ThenBlock: {
                    IfCondition And(NotEqual(JSVMClosure.script_env, 0), NotEqual(JSVMClosure.script_env, JSRTState.undef_val)) ThenBlock: {
                        lsb_s = JSVMCallBuf.getter_buf
                        SetByte(lsb_s, 0, 95)
                        SetByte(lsb_s, 1, 95)
                        SetByte(lsb_s, 2, 108)
                        SetByte(lsb_s, 3, 115)
                        SetByte(lsb_s, 4, 95)
                        sn_s = slot
                        digs_s = 0
                        IfCondition EqualTo(sn_s, 0) ThenBlock: {
                            SetByte(lsb_s, 5, 48)
                            digs_s = 1
                        } ElseBlock: {
                            WhileLoop GreaterThan(sn_s, 0) {
                                SetByte(lsb_s, Add(32, digs_s), Add(48, Modulo(sn_s, 10)))
                                sn_s = Divide(sn_s, 10)
                                digs_s = Add(digs_s, 1)
                            }
                            ri_s = 0
                            WhileLoop LessThan(ri_s, digs_s) {
                                SetByte(lsb_s, Add(5, ri_s), GetByte(lsb_s, Add(32, Subtract(Subtract(digs_s, 1), ri_s))))
                                ri_s = Add(ri_s, 1)
                            }
                        }
                        SetByte(lsb_s, Add(5, digs_s), 0)
                        nm_s = JSRT_ObjGet(JSVMClosure.script_env, lsb_s)
                        IfCondition EqualTo(JSRT_GetType(nm_s), JSType.STRING) ThenBlock: {
                            JSVM__SetGlobalHash(JSRT_GetPayload(nm_s), sval)
                        }
                    }
                }
                ReturnValue(1)
            }

            // GET_GLOBAL (12) — unresolvable binding → ReferenceError (spec GetValue)
            // typeof uses GET_GLOBAL_SOFT (84) instead.
            // M128d: consult with ObjectEnv (GetCurEnv chain) before global.
            Case 12: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                // with / declarative env first
                env_g = JSVM__GetCurEnv()
                gval = JSRTState.undef_val
                found_env = 0
                IfCondition And(NotEqual(env_g, 0), NotEqual(env_g, JSRTState.undef_val)) ThenBlock: {
                    // EnvLookup returns undef for miss — distinguish via has walk
                    hops_g = 0
                    ewalk = env_g
                    WhileLoop And(And(NotEqual(ewalk, 0), NotEqual(ewalk, JSRTState.undef_val)), LessThan(hops_g, 64)) {
                        IfCondition EqualTo(JSRT_GetType(ewalk), JSType.OBJECT) ThenBlock: {
                            IfCondition EqualTo(JSRT_ObjHas(ewalk, cpay), 1) ThenBlock: {
                                gval = JSRT_ObjGet(ewalk, cpay)
                                found_env = 1
                                hops_g = 64
                            }
                            IfCondition EqualTo(found_env, 0) ThenBlock: {
                                wog = JSRT_ObjGet(ewalk, "__with__")
                                wtg = JSRT_GetType(wog)
                                IfCondition Or(EqualTo(wtg, JSType.OBJECT), Or(EqualTo(wtg, JSType.FUNCTION), EqualTo(wtg, JSType.ARRAY))) ThenBlock: {
                                    IfCondition EqualTo(JSRT_ObjHasOnChain(wog, cpay), 1) ThenBlock: {
                                        gval = JSRT_ObjGet(wog, cpay)
                                        found_env = 1
                                        hops_g = 64
                                    }
                                }
                            }
                            IfCondition EqualTo(found_env, 0) ThenBlock: {
                                ewalk = JSRT_ObjGet(ewalk, JSVMClosure.parent_key)
                            }
                        } ElseBlock: {
                            ewalk = 0
                        }
                        hops_g = Add(hops_g, 1)
                    }
                }
                IfCondition EqualTo(found_env, 1) ThenBlock: {
                    JSVM__StackPush(gval)
                    ReturnValue(1)
                }
                has_g = JSVM__HasGlobal(cpay)
                IfCondition EqualTo(has_g, 0) ThenBlock: {
                    JSVM_ThrowReferenceError("is not defined")
                    ReturnValue(1)
                }
                gval = JSVM__GetGlobal(cpay)
                // M26e: derived this TDZ (flag — SetGlobal copies so pointer eq fails)
                IfCondition EqualTo(JSVMState.this_tdz, 1) ThenBlock: {
                    // name == "this" (4 chars)
                    is_this_nm = 0
                    IfCondition NotEqual(cpay, 0) ThenBlock: {
                        IfCondition EqualTo(GetByte(cpay, 0), 116) ThenBlock: {
                            IfCondition EqualTo(GetByte(cpay, 1), 104) ThenBlock: {
                                IfCondition EqualTo(GetByte(cpay, 2), 105) ThenBlock: {
                                    IfCondition EqualTo(GetByte(cpay, 3), 115) ThenBlock: {
                                        IfCondition EqualTo(GetByte(cpay, 4), 0) ThenBlock: {
                                            is_this_nm = 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(is_this_nm, 1) ThenBlock: {
                        JSVM_ThrowReferenceError("Must call super constructor in derived class before accessing 'this'")
                        ReturnValue(1)
                    }
                }
                JSVM__StackPush(gval)
                ReturnValue(1)
            }

            // GET_GLOBAL_SOFT (84) — missing → undefined (typeof undeclared)
            Case 84: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                gval = JSVM__GetGlobal(cpay)
                JSVM__StackPush(gval)
                ReturnValue(1)
            }

            // SET_GLOBAL (13) — create-or-update binding (var/func/catch/assign non-strict)
            // M128d: with ObjectEnv PutValue when binding present on with object
            Case 13: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                sval = JSVM__StackPop()
                env_s = JSVM__GetCurEnv()
                hops_s = 0
                ews = env_s
                WhileLoop And(And(NotEqual(ews, 0), NotEqual(ews, JSRTState.undef_val)), LessThan(hops_s, 64)) {
                    IfCondition EqualTo(JSRT_GetType(ews), JSType.OBJECT) ThenBlock: {
                        wos = JSRT_ObjGet(ews, "__with__")
                        wts = JSRT_GetType(wos)
                        IfCondition Or(EqualTo(wts, JSType.OBJECT), Or(EqualTo(wts, JSType.FUNCTION), EqualTo(wts, JSType.ARRAY))) ThenBlock: {
                            IfCondition EqualTo(JSRT_ObjHasOnChain(wos, cpay), 1) ThenBlock: {
                                JSRT_ObjSet(wos, cpay, sval)
                                ReturnValue(1)
                            }
                        }
                        ews = JSRT_ObjGet(ews, JSVMClosure.parent_key)
                    } ElseBlock: {
                        ews = 0
                    }
                    hops_s = Add(hops_s, 1)
                }
                JSVM__SetGlobal(cpay, sval)
                ReturnValue(1)
            }

            // SET_GLOBAL_VAR (109) — M128v: CreateGlobalVarBinding
            // Only bind if missing (do not re-init existing globals to undefined).
            // Used by HoistVars for program/eval bare `var x` instantiation.
            Case 109: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                sval = JSVM__StackPop()
                // GlobalHash only — not dyn/eval envs (declaration instantiation)
                IfCondition EqualTo(GlobalHash_Lookup(cpay), -1) ThenBlock: {
                    JSVM__SetGlobalHash(cpay, sval)
                }
                ReturnValue(1)
            }

            // SET_GLOBAL_ASSIGN (85) — strict assignment to undeclared → ReferenceError
            // Declarations must use SET_GLOBAL (13), never this opcode.
            Case 85: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                sval = JSVM__StackPop()
                IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                    has_g = JSVM__HasGlobal(cpay)
                    IfCondition EqualTo(has_g, 0) ThenBlock: {
                        JSVM_ThrowReferenceError("Assignment to undeclared variable")
                        ReturnValue(1)
                    }
                }
                JSVM__SetGlobal(cpay, sval)
                ReturnValue(1)
            }

            // TO_PROP_KEY (86) — [val] → [string|symbol]
            // ToPropertyKey once (side effects). Symbols stay Symbols so
            // SET_PROP_COMPUTED / SET_ELEM keep symbol identity (M68).
            Case 86: {
                k_val = JSVM__StackPop()
                // Preserve Symbol values — do not stringify to @@sN here
                IfCondition EqualTo(JSVM_IsSymbol(k_val), 1) ThenBlock: {
                    JSVM__StackPush(k_val)
                    ReturnValue(1)
                }
                k_ptr = JSVM_ToPropertyKey(k_val)
                IfCondition EqualTo(k_ptr, 0) ThenBlock: {
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        pend = JSVMCall.thrown_val
                        IfCondition EqualTo(pend, 0) ThenBlock: {
                            pend = JSVM__GetGlobal("__pend_exc__")
                        }
                        JSVMCall.thrown_val = 0
                        JSVMCall.exc_prop = 0
                        IfCondition NotEqual(pend, 0) ThenBlock: {
                            IfCondition NotEqual(pend, JSRTState.undef_val) ThenBlock: {
                                JSVM_ThrowValue(pend)
                            }
                        }
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    JSVM__StackPush(JSRT_CreateString(""))
                    ReturnValue(1)
                }
                JSVM__StackPush(JSRT_CreateString(k_ptr))
                ReturnValue(1)
            }

            // CHECK_COERCIBLE (87) — [val] → [val]; TypeError if null/undefined
            // ES5 MemberExpression order: CheckObjectCoercible(base) before key ToString
            Case 87: {
                cv = JSVM__StackPop()
                ct = JSRT_GetType(cv)
                IfCondition Or(EqualTo(ct, JSType.NULL), EqualTo(ct, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot read property of null/undefined")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                JSVM__StackPush(cv)
                ReturnValue(1)
            }

            // GET_FREE (90) — free-var read via callee.__cenv → __parent chain
            // Copy onto a fresh val_pool slot so stack holds an ordinary temporary
            // (pushing the env's gval pointer confused later SET_PROP).
            // M60: tdz_uninit sentinel → ReferenceError (let/const TDZ via free var)
            // M128g: own frame env first (direct eval can introduce var bindings)
            Case 90: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                gval = JSRTState.undef_val
                found_own = 0
                start_env = 0
                IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                    fi = Subtract(JSVMState.fp, 1)
                    own_env = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi, 8)))
                    IfCondition And(NotEqual(own_env, 0), NotEqual(own_env, JSRTState.undef_val)) ThenBlock: {
                        IfCondition EqualTo(JSRT_ObjHas(own_env, cpay), 1) ThenBlock: {
                            gval = JSRT_ObjGet(own_env, cpay)
                            found_own = 1
                        }
                    }
                }
                IfCondition EqualTo(found_own, 0) ThenBlock: {
                    start_env = JSRTState.undef_val
                    IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                        fi = Subtract(JSVMState.fp, 1)
                        fval = Dereference(Add(JSVMClosure.frame_funcs, Multiply(fi, 8)))
                        IfCondition NotEqual(fval, 0) ThenBlock: {
                            start_env = JSRT_FuncPropGet(fval, JSVMClosure.cenv_key)
                        }
                    }
                    gval = JSVM__EnvLookup(start_env, cpay)
                    // M128e6g: async gen/fn cenv may miss eval_var_env/script_env where
                    // top-level let lives (eval_mode). var free-vars still hit GlobalHash
                    // fallback; let has no global in eval. Probe those envs.
                    miss_fe = 0
                    IfCondition EqualTo(gval, 0) ThenBlock: {
                        miss_fe = 1
                    }
                    IfCondition EqualTo(gval, JSRTState.undef_val) ThenBlock: {
                        miss_fe = 1
                    }
                    IfCondition EqualTo(miss_fe, 1) ThenBlock: {
                        IfCondition And(NotEqual(JSVMEvalState.eval_var_env, 0), NotEqual(JSVMEvalState.eval_var_env, JSRTState.undef_val)) ThenBlock: {
                            IfCondition EqualTo(JSRT_ObjHas(JSVMEvalState.eval_var_env, cpay), 1) ThenBlock: {
                                gval = JSRT_ObjGet(JSVMEvalState.eval_var_env, cpay)
                                miss_fe = 0
                            }
                        }
                    }
                    IfCondition EqualTo(miss_fe, 1) ThenBlock: {
                        IfCondition And(NotEqual(JSVMClosure.script_env, 0), NotEqual(JSVMClosure.script_env, JSRTState.undef_val)) ThenBlock: {
                            IfCondition EqualTo(JSRT_ObjHas(JSVMClosure.script_env, cpay), 1) ThenBlock: {
                                gval = JSRT_ObjGet(JSVMClosure.script_env, cpay)
                                miss_fe = 0
                            }
                        }
                    }
                    // M128e6g: last resort — absolute script stack via __sl_<name>
                    // (eval let dual-writes stack; cenv may not see the binding).
                    IfCondition EqualTo(miss_fe, 1) ThenBlock: {
                        env_sl = 0
                        IfCondition And(NotEqual(JSVMClosure.script_env, 0), NotEqual(JSVMClosure.script_env, JSRTState.undef_val)) ThenBlock: {
                            env_sl = JSVMClosure.script_env
                        }
                        IfCondition EqualTo(env_sl, 0) ThenBlock: {
                            // Prefer eval_var_env even after eval returns (depth may be 0)
                            // while async gen continuations still read free lets.
                            IfCondition And(NotEqual(JSVMEvalState.eval_var_env, 0), NotEqual(JSVMEvalState.eval_var_env, JSRTState.undef_val)) ThenBlock: {
                                env_sl = JSVMEvalState.eval_var_env
                            }
                        }
                        IfCondition NotEqual(env_sl, 0) ThenBlock: {
                            slb_fe = JSVMCallBuf.getter_buf
                            SetByte(slb_fe, 0, 95)
                            SetByte(slb_fe, 1, 95)
                            SetByte(slb_fe, 2, 115)
                            SetByte(slb_fe, 3, 108)
                            SetByte(slb_fe, 4, 95)
                            si_fe = 0
                            sd_fe = 0
                            WhileLoop EqualTo(sd_fe, 0) {
                                sb_fe = GetByte(cpay, si_fe)
                                SetByte(slb_fe, Add(5, si_fe), sb_fe)
                                IfCondition EqualTo(sb_fe, 0) ThenBlock: { sd_fe = 1 }
                                si_fe = Add(si_fe, 1)
                            }
                            slot_fev = JSRT_ObjGet(env_sl, slb_fe)
                            IfCondition EqualTo(JSRT_GetType(slot_fev), JSType.NUMBER) ThenBlock: {
                                slot_fen = Float_ToInt(JSRT_GetPayload(slot_fev))
                                cand_fe = Dereference(Add(JSVMState.stack, Multiply(slot_fen, 8)))
                                IfCondition And(NotEqual(cand_fe, 0), NotEqual(cand_fe, JSVMClosure.tdz_uninit)) ThenBlock: {
                                    gval = cand_fe
                                }
                            }
                        }
                    }
                }
                // M60/M128m: TDZ on env — recover from outer stack local via __sl_<name>
                // (SET_LOCAL may init while env still holds TDZ if value dual-write missed).
                IfCondition And(NotEqual(JSVMClosure.tdz_uninit, 0), EqualTo(gval, JSVMClosure.tdz_uninit)) ThenBlock: {
                    recovered = 0
                    // start_env may be unset when found_own=1; recompute lookup env
                    env_r = start_env
                    IfCondition Or(EqualTo(env_r, 0), EqualTo(env_r, JSRTState.undef_val)) ThenBlock: {
                        IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                            fval_r = Dereference(Add(JSVMClosure.frame_funcs, Multiply(Subtract(JSVMState.fp, 1), 8)))
                            IfCondition NotEqual(fval_r, 0) ThenBlock: {
                                env_r = JSRT_FuncPropGet(fval_r, JSVMClosure.cenv_key)
                            }
                        }
                    }
                    slb_r = JSVMCallBuf.getter_buf
                    SetByte(slb_r, 0, 95)
                    SetByte(slb_r, 1, 95)
                    SetByte(slb_r, 2, 115)
                    SetByte(slb_r, 3, 108)
                    SetByte(slb_r, 4, 95)
                    si_r = 0
                    sdone_r = 0
                    WhileLoop EqualTo(sdone_r, 0) {
                        sb_r = GetByte(cpay, si_r)
                        SetByte(slb_r, Add(5, si_r), sb_r)
                        IfCondition EqualTo(sb_r, 0) ThenBlock: {
                            sdone_r = 1
                        }
                        si_r = Add(si_r, 1)
                    }
                    hops_r = 0
                    WhileLoop And(NotEqual(env_r, 0), LessThan(hops_r, 64)) {
                        IfCondition EqualTo(env_r, JSRTState.undef_val) ThenBlock: {
                            env_r = 0
                        }
                        IfCondition And(NotEqual(env_r, 0), EqualTo(JSRT_GetType(env_r), JSType.OBJECT)) ThenBlock: {
                            IfCondition EqualTo(JSRT_ObjHas(env_r, cpay), 1) ThenBlock: {
                                slot_vr = JSRT_ObjGet(env_r, slb_r)
                                IfCondition EqualTo(JSRT_GetType(slot_vr), JSType.NUMBER) ThenBlock: {
                                    slot_nr = Float_ToInt(JSRT_GetPayload(slot_vr))
                                    fj_r = 0
                                    WhileLoop LessThan(fj_r, JSVMState.fp) {
                                        e2_r = Dereference(Add(JSVMClosure.frame_envs, Multiply(fj_r, 8)))
                                        IfCondition EqualTo(e2_r, env_r) ThenBlock: {
                                            fbase_r = Add(JSVMState.frames, Multiply(fj_r, JSVMConst.FRAME_SIZE))
                                            lb_r = Dereference(Add(fbase_r, 16))
                                            saddr_r = Add(JSVMState.stack, Multiply(Add(lb_r, slot_nr), 8))
                                            cand = Dereference(saddr_r)
                                            IfCondition And(NotEqual(JSVMClosure.tdz_uninit, 0), EqualTo(cand, JSVMClosure.tdz_uninit)) ThenBlock: {
                                            } ElseBlock: {
                                                IfCondition And(NotEqual(cand, 0), NotEqual(cand, JSRTState.undef_val)) ThenBlock: {
                                                    gval = cand
                                                    recovered = 1
                                                }
                                                // also accept undef as initialized (let x;)
                                                IfCondition EqualTo(cand, JSRTState.undef_val) ThenBlock: {
                                                    gval = cand
                                                    recovered = 1
                                                }
                                            }
                                            fj_r = JSVMState.fp
                                        }
                                        fj_r = Add(fj_r, 1)
                                    }
                                    IfCondition EqualTo(recovered, 0) ThenBlock: {
                                        IfCondition EqualTo(env_r, JSVMClosure.script_env) ThenBlock: {
                                            saddr_r = Add(JSVMState.stack, Multiply(slot_nr, 8))
                                            cand = Dereference(saddr_r)
                                            IfCondition And(NotEqual(JSVMClosure.tdz_uninit, 0), EqualTo(cand, JSVMClosure.tdz_uninit)) ThenBlock: {
                                            } ElseBlock: {
                                                gval = cand
                                                recovered = 1
                                            }
                                        }
                                    }
                                }
                                hops_r = 64
                            } ElseBlock: {
                                env_r = JSRT_ObjGet(env_r, JSVMClosure.parent_key)
                            }
                        } ElseBlock: {
                            env_r = 0
                        }
                        hops_r = Add(hops_r, 1)
                    }
                    IfCondition EqualTo(recovered, 0) ThenBlock: {
                        tdz_err = JSVM_CreateTypedError("ReferenceError", "Cannot access variable before initialization")
                        JSVM_ThrowValue(tdz_err)
                        ReturnValue(1)
                    }
                    // Heal env binding for subsequent free-var reads
                    IfCondition And(NotEqual(start_env, 0), NotEqual(start_env, JSRTState.undef_val)) ThenBlock: {
                        JSRT_ObjSet(start_env, cpay, gval)
                    }
                }
                // M128h: unresolvable free var → ReferenceError (not silent undefined)
                IfCondition Or(EqualTo(gval, 0), EqualTo(gval, JSRTState.undef_val)) ThenBlock: {
                    IfCondition EqualTo(JSVM__HasGlobal(cpay), 0) ThenBlock: {
                        // Own frame may have held binding then deleted — EnvLookup miss
                        rferr = JSVM_CreateTypedError("ReferenceError", "is not defined")
                        JSVM_ThrowValue(rferr)
                        ReturnValue(1)
                    }
                    // Fall through to global
                    gval = JSVM__GetGlobal(cpay)
                }
                IfCondition Or(EqualTo(gval, 0), EqualTo(gval, JSRTState.undef_val)) ThenBlock: {
                    JSVM__StackPush(JSRTState.undef_val)
                } ElseBlock: {
                    IfCondition EqualTo(gval, JSRTState.true_val) ThenBlock: {
                        JSVM__StackPush(gval)
                    } ElseBlock: {
                        IfCondition EqualTo(gval, JSRTState.false_val) ThenBlock: {
                            JSVM__StackPush(gval)
                        } ElseBlock: {
                            IfCondition EqualTo(gval, JSRTState.null_val) ThenBlock: {
                                JSVM__StackPush(gval)
                            } ElseBlock: {
                                // M60: OBJECT/FUNCTION/ARRAY — push env gval directly
                                // (durable gval_pool). Copying into val_pool dangled
                                // when free-var throw crossed IteratorClose+CallFunc.
                                gt = JSRT_GetType(gval)
                                IfCondition Or(EqualTo(gt, JSType.OBJECT), Or(EqualTo(gt, JSType.FUNCTION), EqualTo(gt, JSType.ARRAY))) ThenBlock: {
                                    JSVM__StackPush(gval)
                                } ElseBlock: {
                                    copy = JSRT__AllocGlobalValue()
                                    IfCondition EqualTo(copy, 0) ThenBlock: {
                                        copy = JSRT__AllocValue()
                                    }
                                    IfCondition EqualTo(copy, 0) ThenBlock: {
                                        JSVM__StackPush(gval)
                                    } ElseBlock: {
                                        StoreValue(copy, Dereference(gval))
                                        StoreValue(Add(copy, 8), Dereference(Add(gval, 8)))
                                        JSVM__StackPush(copy)
                                    }
                                }
                            }
                        }
                    }
                }
                ReturnValue(1)
            }

            // SET_FRAME_ENV (91) — dual-write own local into CURRENT activation env
            // Operand: name const; trailing u16 = local slot (Mole 16 free-var sync)
            // M73: bind on current env only. Parent-chain update rewrote script_env
            // when body `var x` shared a name with global x, so param-default
            // closures saw body vars. for-of FRESH_LET_ENV places the binding on
            // current first; SET updates that entry.
            Case 91: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                slot_fe = JSVM__Read16()
                sval = JSVM__StackPop()
                // M128n: eval dual-write targets
                // - strict: all SET_FRAME_ENV → eval_var_env (var/func + let isolation)
                // - non-strict: let/const (TDZ + later inits) → eval_var_env so outer
                //   script_env is never polluted (lex-env-distinct-let/const)
                // - non-strict var: direct → caller_env; else GetCurEnv/global path
                env = 0
                IfCondition GreaterThan(JSVMEvalState.depth, 0) ThenBlock: {
                    // M128o/s: non-arrow param_init uses ephemeral env (half-built frame).
                    // Arrow param_init keeps caller_env so var is visible in body.
                    use_eph = 0
                    IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                        use_eph = 1
                    }
                    IfCondition EqualTo(JSVMEvalState.param_init, 1) ThenBlock: {
                        IfCondition EqualTo(JSVMEvalState.param_init_arrow, 0) ThenBlock: {
                            use_eph = 1
                        }
                    }
                    IfCondition EqualTo(use_eph, 1) ThenBlock: {
                        IfCondition Or(EqualTo(JSVMEvalState.eval_var_env, 0), EqualTo(JSVMEvalState.eval_var_env, JSRTState.undef_val)) ThenBlock: {
                            JSVMEvalState.eval_var_env = JSRT_CreateObject()
                        }
                        env = JSVMEvalState.eval_var_env
                    } ElseBlock: {
                        // let/const: TDZ mark OR name already lives on eval_var_env
                        is_eval_lex = 0
                        IfCondition And(NotEqual(JSVMClosure.tdz_uninit, 0), EqualTo(sval, JSVMClosure.tdz_uninit)) ThenBlock: {
                            is_eval_lex = 1
                        }
                        IfCondition EqualTo(is_eval_lex, 0) ThenBlock: {
                            IfCondition And(NotEqual(JSVMEvalState.eval_var_env, 0), NotEqual(JSVMEvalState.eval_var_env, JSRTState.undef_val)) ThenBlock: {
                                IfCondition EqualTo(JSRT_ObjHas(JSVMEvalState.eval_var_env, cpay), 1) ThenBlock: {
                                    is_eval_lex = 1
                                }
                            }
                        }
                        IfCondition EqualTo(is_eval_lex, 1) ThenBlock: {
                            IfCondition Or(EqualTo(JSVMEvalState.eval_var_env, 0), EqualTo(JSVMEvalState.eval_var_env, JSRTState.undef_val)) ThenBlock: {
                                JSVMEvalState.eval_var_env = JSRT_CreateObject()
                            }
                            env = JSVMEvalState.eval_var_env
                        } ElseBlock: {
                            // var/func non-strict: bind VariableEnvironment when direct
                            IfCondition EqualTo(JSVMEvalState.is_direct, 1) ThenBlock: {
                                IfCondition And(NotEqual(JSVMEvalState.caller_env, 0), NotEqual(JSVMEvalState.caller_env, JSRTState.undef_val)) ThenBlock: {
                                    env = JSVMEvalState.caller_env
                                }
                            }
                        }
                    }
                }
                IfCondition EqualTo(env, 0) ThenBlock: {
                    env = JSVM__GetCurEnv()
                }
                IfCondition And(NotEqual(env, 0), NotEqual(env, JSRTState.undef_val)) ThenBlock: {
                    // M128m: clone name into str_slab — keys must outlive str_buf (eval recompile)
                    key_fe = cpay
                    IfCondition NotEqual(cpay, 0) ThenBlock: {
                        klen_fe = 0
                        kdone_fe = 0
                        WhileLoop EqualTo(kdone_fe, 0) {
                            IfCondition EqualTo(GetByte(cpay, klen_fe), 0) ThenBlock: {
                                kdone_fe = 1
                            } ElseBlock: {
                                klen_fe = Add(klen_fe, 1)
                                IfCondition GreaterThan(klen_fe, 512) ThenBlock: {
                                    kdone_fe = 1
                                }
                            }
                        }
                        klen_fe = Add(klen_fe, 1)
                        kstable_fe = JSRT__StrSlabAlloc(klen_fe)
                        IfCondition NotEqual(kstable_fe, 0) ThenBlock: {
                            MemoryCopy(kstable_fe, cpay, klen_fe)
                            key_fe = kstable_fe
                        }
                    }
                    JSRT_ObjSet(env, key_fe, sval)

                    // M128s: arrow param-init — also dual-write onto callee.__cenv so
                    // GET_FREE("arguments") / free-var chain sees eval-introduced vars.
                    // (own frame env is checked first by GET_FREE; cenv covers outer reads)
                    IfCondition EqualTo(JSVMEvalState.param_init_arrow, 1) ThenBlock: {
                        IfCondition GreaterThan(JSVMEvalState.save_fp, 0) ThenBlock: {
                            fi_cenv = Subtract(JSVMEvalState.save_fp, 1)
                            fval_cenv = Dereference(Add(JSVMClosure.frame_funcs, Multiply(fi_cenv, 8)))
                            IfCondition NotEqual(fval_cenv, 0) ThenBlock: {
                                cenv_ar = JSRT_FuncPropGet(fval_cenv, JSVMClosure.cenv_key)
                                IfCondition And(NotEqual(cenv_ar, 0), NotEqual(cenv_ar, JSRTState.undef_val)) ThenBlock: {
                                    IfCondition EqualTo(JSRT_GetType(cenv_ar), JSType.OBJECT) ThenBlock: {
                                        JSRT_ObjSet(cenv_ar, key_fe, sval)
                                    }
                                }
                            }
                        }
                    }

                    // M128g: let/const TDZ mark → permanent lexical-declaration flag
                    // so non-strict eval var cannot collide (HasLexicalDeclaration).
                    IfCondition And(NotEqual(JSVMClosure.tdz_uninit, 0), EqualTo(sval, JSVMClosure.tdz_uninit)) ThenBlock: {
                        // Build "__lex_" + name in getter_buf then StrSlabAlloc
                        lkb = JSVMCallBuf.getter_buf
                        SetByte(lkb, 0, 95)
                        SetByte(lkb, 1, 95)
                        SetByte(lkb, 2, 108)
                        SetByte(lkb, 3, 101)
                        SetByte(lkb, 4, 120)
                        SetByte(lkb, 5, 95)
                        li = 0
                        ldone = 0
                        WhileLoop EqualTo(ldone, 0) {
                            lb = GetByte(cpay, li)
                            SetByte(lkb, Add(6, li), lb)
                            IfCondition EqualTo(lb, 0) ThenBlock: {
                                ldone = 1
                            }
                            li = Add(li, 1)
                        }
                        lk_len = Add(6, li)
                        lk_stable = JSRT__StrSlabAlloc(lk_len)
                        IfCondition NotEqual(lk_stable, 0) ThenBlock: {
                            MemoryCopy(lk_stable, lkb, lk_len)
                            JSRT_ObjSet(env, lk_stable, JSRTState.true_val)
                        }
                    }                    
                    // M128h: mark eval-created data bindings configurable (delete)
                    IfCondition GreaterThan(JSVMEvalState.depth, 0) ThenBlock: {
                        IfCondition EqualTo(JSVMEvalState.is_direct, 1) ThenBlock: {
                            skip_cfg = 0
                            IfCondition And(NotEqual(JSVMClosure.tdz_uninit, 0), EqualTo(sval, JSVMClosure.tdz_uninit)) ThenBlock: {
                                skip_cfg = 1
                            }
                            IfCondition EqualTo(skip_cfg, 0) ThenBlock: {
                                ckb = JSVMCallBuf.getter_buf
                                SetByte(ckb, 0, 95)
                                SetByte(ckb, 1, 95)
                                SetByte(ckb, 2, 99)
                                SetByte(ckb, 3, 102)
                                SetByte(ckb, 4, 103)
                                SetByte(ckb, 5, 95)
                                ci2 = 0
                                cdone2 = 0
                                WhileLoop EqualTo(cdone2, 0) {
                                    cb2 = GetByte(cpay, ci2)
                                    SetByte(ckb, Add(6, ci2), cb2)
                                    IfCondition EqualTo(cb2, 0) ThenBlock: {
                                        cdone2 = 1
                                    }
                                    ci2 = Add(ci2, 1)
                                }
                                ck_len2 = Add(6, ci2)
                                ck_st = JSRT__StrSlabAlloc(ck_len2)
                                IfCondition NotEqual(ck_st, 0) ThenBlock: {
                                    MemoryCopy(ck_st, ckb, ck_len2)
                                    JSRT_ObjSet(env, ck_st, JSRTState.true_val)
                                }
                            }
                        }
                    }
// Record slot for SET_FREE to update stack local.
                    // Key must be str_slab-stable: PropTable stores the key
                    // pointer; getter_buf is shared and would corrupt the table.
                    // M128q: during eval, stack is ephemeral (zeroed then RestoreOuter).
                    // Never write __sl_ onto caller_env — slot numbers refer to the
                    // eval stack and would corrupt outer formals after restore
                    // (param-init eval("var x") SIGSEGV).
                    // M128e6: slot 0xFFFFFF = no stack sync (classScope name init).
                    IfCondition And(EqualTo(JSVMEvalState.depth, 0), NotEqual(slot_fe, 16777215)) ThenBlock: {
                        slb = JSVMCallBuf.getter_buf
                        SetByte(slb, 0, 95)
                        SetByte(slb, 1, 95)
                        SetByte(slb, 2, 115)
                        SetByte(slb, 3, 108)
                        SetByte(slb, 4, 95)
                        si = 0
                        sdone = 0
                        WhileLoop EqualTo(sdone, 0) {
                            sb = GetByte(cpay, si)
                            SetByte(slb, Add(5, si), sb)
                            IfCondition EqualTo(sb, 0) ThenBlock: {
                                sdone = 1
                            }
                            si = Add(si, 1)
                        }
                        // si includes trailing NUL; key len = 5 + si
                        sl_len = Add(5, si)
                        sl_stable = JSRT__StrSlabAlloc(sl_len)
                        IfCondition NotEqual(sl_stable, 0) ThenBlock: {
                            MemoryCopy(sl_stable, slb, sl_len)
                            JSRT__Push(env)
                            slot_num = JSRT_CreateNumber(slot_fe)
                            env = JSRT__Pop()
                            JSRT_ObjSet(env, sl_stable, slot_num)
                            // M128e6c: reverse map __ls_<decimal-slot> → name STRING
                            // so GET_LOCAL can dual-read GlobalHash in O(1).
                            lsb = JSVMCallBuf.getter_buf
                            SetByte(lsb, 0, 95)
                            SetByte(lsb, 1, 95)
                            SetByte(lsb, 2, 108)
                            SetByte(lsb, 3, 115)
                            SetByte(lsb, 4, 95)
                            sn_fe = slot_fe
                            digs_fe = 0
                            IfCondition EqualTo(sn_fe, 0) ThenBlock: {
                                SetByte(lsb, 5, 48)
                                digs_fe = 1
                            } ElseBlock: {
                                WhileLoop GreaterThan(sn_fe, 0) {
                                    SetByte(lsb, Add(32, digs_fe), Add(48, Modulo(sn_fe, 10)))
                                    sn_fe = Divide(sn_fe, 10)
                                    digs_fe = Add(digs_fe, 1)
                                }
                                ri_fe = 0
                                WhileLoop LessThan(ri_fe, digs_fe) {
                                    SetByte(lsb, Add(5, ri_fe), GetByte(lsb, Add(32, Subtract(Subtract(digs_fe, 1), ri_fe))))
                                    ri_fe = Add(ri_fe, 1)
                                }
                            }
                            SetByte(lsb, Add(5, digs_fe), 0)
                            ls_len = Add(6, digs_fe)
                            ls_stable = JSRT__StrSlabAlloc(ls_len)
                            IfCondition NotEqual(ls_stable, 0) ThenBlock: {
                                MemoryCopy(ls_stable, lsb, ls_len)
                                nlen_ls = 0
                                nd_ls = 0
                                WhileLoop EqualTo(nd_ls, 0) {
                                    IfCondition EqualTo(GetByte(cpay, nlen_ls), 0) ThenBlock: {
                                        nd_ls = 1
                                    } ElseBlock: {
                                        nlen_ls = Add(nlen_ls, 1)
                                        IfCondition GreaterThan(nlen_ls, 512) ThenBlock: {
                                            nd_ls = 1
                                        }
                                    }
                                }
                                nbuf_ls = JSRT__StrSlabAlloc(Add(nlen_ls, 1))
                                IfCondition NotEqual(nbuf_ls, 0) ThenBlock: {
                                    MemoryCopy(nbuf_ls, cpay, Add(nlen_ls, 1))
                                    JSRT__Push(env)
                                    nm_str = JSRT_CreateString(nbuf_ls)
                                    env = JSRT__Pop()
                                    JSRT_ObjSet(env, ls_stable, nm_str)
                                }
                            }
                            // M128e5: stamp stack at top-level immediately
                            IfCondition EqualTo(JSVMState.fp, 0) ThenBlock: {
                                saddr0 = Add(JSVMState.stack, Multiply(slot_fe, 8))
                                StoreValue(saddr0, sval)
                            }
                        }
                    }
                }
                ReturnValue(1)
            }

            // SET_FREE (92) — free-var write on __cenv chain
            // Mole 16: also sync stack local of owning frame via __sl_<name>
            // M128g: own frame env first (eval-introduced vars)
            Case 92: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                sval = JSVM__StackPop()
                wrote_own = 0
                IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                    fi = Subtract(JSVMState.fp, 1)
                    own_env = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi, 8)))
                    IfCondition And(NotEqual(own_env, 0), NotEqual(own_env, JSRTState.undef_val)) ThenBlock: {
                        IfCondition EqualTo(JSRT_ObjHas(own_env, cpay), 1) ThenBlock: {
                            JSRT_ObjSet(own_env, cpay, sval)
                            wrote_own = 1
                        }
                    }
                }
                start_env = 0
                IfCondition EqualTo(wrote_own, 0) ThenBlock: {
                    IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                        fi = Subtract(JSVMState.fp, 1)
                        fval = Dereference(Add(JSVMClosure.frame_funcs, Multiply(fi, 8)))
                        IfCondition NotEqual(fval, 0) ThenBlock: {
                            start_env = JSRT_FuncPropGet(fval, JSVMClosure.cenv_key)
                        }
                    }
                    // M60: assignment to TDZ binding → ReferenceError
                    // M128: env may still hold TDZ while stack local is initialized
                    // (same dual-write lag GET_FREE recovers). Recover before throw.
                    cur_lv = JSVM__EnvLookup(start_env, cpay)
                    IfCondition And(NotEqual(JSVMClosure.tdz_uninit, 0), EqualTo(cur_lv, JSVMClosure.tdz_uninit)) ThenBlock: {
                        tdz_ok = 0
                        // Walk env for __sl_ slot + stack local (mirror GET_FREE recover)
                        env_t = start_env
                        hops_t = 0
                        WhileLoop And(NotEqual(env_t, 0), LessThan(hops_t, 64)) {
                            IfCondition EqualTo(env_t, JSRTState.undef_val) ThenBlock: {
                                env_t = 0
                            }
                            IfCondition And(NotEqual(env_t, 0), EqualTo(JSRT_GetType(env_t), JSType.OBJECT)) ThenBlock: {
                                IfCondition EqualTo(JSRT_ObjHas(env_t, cpay), 1) ThenBlock: {
                                    slb_t = JSVMCallBuf.getter_buf
                                    SetByte(slb_t, 0, 95)
                                    SetByte(slb_t, 1, 95)
                                    SetByte(slb_t, 2, 115)
                                    SetByte(slb_t, 3, 108)
                                    SetByte(slb_t, 4, 95)
                                    si_t = 0
                                    sdone_t = 0
                                    WhileLoop EqualTo(sdone_t, 0) {
                                        sb_t = GetByte(cpay, si_t)
                                        SetByte(slb_t, Add(5, si_t), sb_t)
                                        IfCondition EqualTo(sb_t, 0) ThenBlock: {
                                            sdone_t = 1
                                        }
                                        si_t = Add(si_t, 1)
                                    }
                                    slot_vt = JSRT_ObjGet(env_t, slb_t)
                                    IfCondition EqualTo(JSRT_GetType(slot_vt), JSType.NUMBER) ThenBlock: {
                                        slot_nt = Float_ToInt(JSRT_GetPayload(slot_vt))
                                        cand_t = 0
                                        IfCondition EqualTo(env_t, JSVMClosure.script_env) ThenBlock: {
                                            cand_t = Dereference(Add(JSVMState.stack, Multiply(slot_nt, 8)))
                                        }
                                        IfCondition EqualTo(cand_t, 0) ThenBlock: {
                                            fj_t = 0
                                            WhileLoop LessThan(fj_t, JSVMState.fp) {
                                                e2_t = Dereference(Add(JSVMClosure.frame_envs, Multiply(fj_t, 8)))
                                                IfCondition EqualTo(e2_t, env_t) ThenBlock: {
                                                    fbase_t = Add(JSVMState.frames, Multiply(fj_t, JSVMConst.FRAME_SIZE))
                                                    lb_t = Dereference(Add(fbase_t, 16))
                                                    cand_t = Dereference(Add(JSVMState.stack, Multiply(Add(lb_t, slot_nt), 8)))
                                                    fj_t = JSVMState.fp
                                                }
                                                fj_t = Add(fj_t, 1)
                                            }
                                        }
                                        IfCondition And(NotEqual(cand_t, 0), NotEqual(cand_t, JSVMClosure.tdz_uninit)) ThenBlock: {
                                            // Stack shows initialized — clear env TDZ and allow assign
                                            tdz_ok = 1
                                        }
                                        IfCondition EqualTo(cand_t, JSRTState.undef_val) ThenBlock: {
                                            tdz_ok = 1
                                        }
                                    }
                                    hops_t = 64
                                } ElseBlock: {
                                    // parent walk
                                    env_t = JSRT_ObjGet(env_t, JSVMClosure.parent_key)
                                    hops_t = Add(hops_t, 1)
                                }
                            } ElseBlock: {
                                env_t = 0
                            }
                            IfCondition EqualTo(tdz_ok, 1) ThenBlock: {
                                hops_t = 64
                            }
                        }
                        IfCondition EqualTo(tdz_ok, 0) ThenBlock: {
                            tdz_err2 = JSVM_CreateTypedError("ReferenceError", "Cannot access variable before initialization")
                            JSVM_ThrowValue(tdz_err2)
                            ReturnValue(1)
                        }
                    }
                    JSVM__EnvAssign(start_env, cpay, sval)
                }
                                // Sync stack local: find env that holds binding + __sl_ slot.
                // Re-read value from env after ObjSet — that copy is in gval_pool
                // and survives ReclaimScope. Writing the raw val_pool `sval` from
                // the nested frame would dangle after the callee returns.
                slb = JSVMCallBuf.getter_buf
                SetByte(slb, 0, 95)
                SetByte(slb, 1, 95)
                SetByte(slb, 2, 115)
                SetByte(slb, 3, 108)
                SetByte(slb, 4, 95)
                si = 0
                sdone = 0
                WhileLoop EqualTo(sdone, 0) {
                    sb = GetByte(cpay, si)
                    SetByte(slb, Add(5, si), sb)
                    IfCondition EqualTo(sb, 0) ThenBlock: {
                        sdone = 1
                    }
                    si = Add(si, 1)
                }
                // Walk env chain for __sl_ record (on same env as binding)
                envw = start_env
                hops = 0
                WhileLoop And(NotEqual(envw, 0), LessThan(hops, 64)) {
                    IfCondition EqualTo(envw, JSRTState.undef_val) ThenBlock: {
                        envw = 0
                    }
                    IfCondition NotEqual(envw, 0) ThenBlock: {
                        IfCondition EqualTo(JSRT_GetType(envw), JSType.OBJECT) ThenBlock: {
                            IfCondition EqualTo(JSRT_ObjHas(envw, cpay), 1) ThenBlock: {
                                // Stable value from env (gval_pool)
                                stable_v = JSRT_ObjGet(envw, cpay)
                                slot_v = JSRT_ObjGet(envw, slb)
                                IfCondition EqualTo(JSRT_GetType(slot_v), JSType.NUMBER) ThenBlock: {
                                    slot_n = Float_ToInt(JSRT_GetPayload(slot_v))
                                    // Find frame whose env is envw
                                    fj = 0
                                    WhileLoop LessThan(fj, JSVMState.fp) {
                                        e2 = Dereference(Add(JSVMClosure.frame_envs, Multiply(fj, 8)))
                                        IfCondition EqualTo(e2, envw) ThenBlock: {
                                            // Set local in that frame: locals_base + slot
                                            fbase = Add(JSVMState.frames, Multiply(fj, JSVMConst.FRAME_SIZE))
                                            lb = Dereference(Add(fbase, 16))
                                            saddr = Add(JSVMState.stack, Multiply(Add(lb, slot_n), 8))
                                            StoreValue(saddr, stable_v)
                                            fj = JSVMState.fp
                                        }
                                        fj = Add(fj, 1)
                                    }
                                    // M59: script_env is not in frame_envs — top-level
                                    // locals use absolute stack indices (GetLocal fp==0).
                                    // M128e6n: during GenNext the live stack is the gen's
                                    // frame — absolute writes clobber gen locals (__dt__).
                                    // Free-var visibility uses GlobalHash dual-read.
                                    IfCondition EqualTo(envw, JSVMClosure.script_env) ThenBlock: {
                                        IfCondition EqualTo(JSVMGen.is_gen_exec, 0) ThenBlock: {
                                            saddr = Add(JSVMState.stack, Multiply(slot_n, 8))
                                            StoreValue(saddr, stable_v)
                                        }
                                    }
                                }
                                hops = 64
                            } ElseBlock: {
                                envw = JSRT_ObjGet(envw, JSVMClosure.parent_key)
                            }
                        } ElseBlock: {
                            envw = 0
                        }
                    }
                    hops = Add(hops, 1)
                }
                // M59/M128e6: re-sync script_env + stack from durable GlobalHash.
                // Critical: never store raw nested-frame `sval` on script stack —
                // it is reclaimed when the free-var writer returns. SetGlobalHash
                // allocates a durable gval; use that for stack + script_env so
                // top-level GET_LOCAL sees super.fromA / free-var writes.
                IfCondition And(NotEqual(JSVMClosure.script_env, 0), NotEqual(JSVMClosure.script_env, JSRTState.undef_val)) ThenBlock: {
                    JSVM__SetGlobalHash(cpay, sval)
                    durable_sf = GlobalHash_Lookup(cpay)
                    IfCondition EqualTo(durable_sf, -1) ThenBlock: {
                        durable_sf = sval
                    }
                    JSRT_ObjSet(JSVMClosure.script_env, cpay, durable_sf)
                    slb2 = JSVMCallBuf.getter_buf
                    SetByte(slb2, 0, 95)
                    SetByte(slb2, 1, 95)
                    SetByte(slb2, 2, 115)
                    SetByte(slb2, 3, 108)
                    SetByte(slb2, 4, 95)
                    si2 = 0
                    sd2 = 0
                    WhileLoop EqualTo(sd2, 0) {
                        sb2 = GetByte(cpay, si2)
                        SetByte(slb2, Add(5, si2), sb2)
                        IfCondition EqualTo(sb2, 0) ThenBlock: { sd2 = 1 }
                        si2 = Add(si2, 1)
                    }
                    // M128e6n: skip absolute stack write while generator executes
                    // (would clobber gen locals; GlobalHash + script_env suffice).
                    IfCondition EqualTo(JSVMGen.is_gen_exec, 0) ThenBlock: {
                        sl_len2 = Add(5, si2)
                        sl_st2 = JSRT__StrSlabAlloc(sl_len2)
                        IfCondition NotEqual(sl_st2, 0) ThenBlock: {
                            MemoryCopy(sl_st2, slb2, sl_len2)
                            slot_vs = JSRT_ObjGet(JSVMClosure.script_env, sl_st2)
                            IfCondition EqualTo(JSRT_GetType(slot_vs), JSType.NUMBER) ThenBlock: {
                                slot_ns = Float_ToInt(JSRT_GetPayload(slot_vs))
                                saddr_s = Add(JSVMState.stack, Multiply(slot_ns, 8))
                                StoreValue(saddr_s, durable_sf)
                            }
                        }
                    }
                }
                ReturnValue(1)
            }

            // OBJ_SPREAD (93) — CopyDataProperties(dest, src) for object spread
            // Stack: [..., dest, src] → [...]  (same net effect as SET_PROP)
            // Compiler pattern is: NEW_OBJECT; (DUP; val/src; SET_PROP|OBJ_SPREAD)*
            // so the base object remains under the DUP — do NOT push dest back
            // (pushing would leave two objects under CALL and break argc).
            // null/undefined src: no-op. Enumerable own keys only (via ObjKeys).
            // Invokes getters (__get_*) when present.
            Case 93: {
                src = JSVM__StackPop()
                dest = JSVM__StackPop()
                src_t = JSRT_GetType(src)
                // Spec: null/undefined → skip (no throw) for object spread;
                // object rest dstr uses RequireObjectCoercible first.
                IfCondition Or(EqualTo(src_t, JSType.NULL), EqualTo(src_t, JSType.UNDEFINED)) ThenBlock: {
                    ReturnValue(1)
                }
                // M20d: string → copy index keys "0".."n-1" (obj-rest-str-val)
                // PropTable stores key *pointers* — must use stable str_slab keys
                // (JSVM__ArgIndexKey), not a reused scratch buffer.
                IfCondition EqualTo(src_t, JSType.STRING) ThenBlock: {
                    sp = JSRT_GetPayload(src)
                    sl = JSRT_StrLen(sp)
                    si = 0
                    WhileLoop LessThan(si, sl) {
                        JSRT__Push(dest)
                        JSRT__Push(src)
                        JSRT__Push(si)
                        kbuf = JSVM__ArgIndexKey(si)
                        chv = JSRT_CreateStringSlice(sp, si, 1)
                        si = JSRT__Pop()
                        src = JSRT__Pop()
                        dest = JSRT__Pop()
                        sp = JSRT_GetPayload(src)
                        IfCondition NotEqual(kbuf, 0) ThenBlock: {
                            JSRT_ObjSet(dest, kbuf, chv)
                        }
                        si = Add(si, 1)
                    }
                    ReturnValue(1)
                }
                // Arrays: copy indexed elements as string keys (stable keys)
                IfCondition EqualTo(src_t, JSType.ARRAY) ThenBlock: {
                    alen = JSRT_ArrLen(src)
                    ai = 0
                    WhileLoop LessThan(ai, alen) {
                        JSRT__Push(dest)
                        JSRT__Push(src)
                        JSRT__Push(ai)
                        kbuf = JSVM__ArgIndexKey(ai)
                        ev = JSRT_ArrGet(src, ai)
                        ai = JSRT__Pop()
                        src = JSRT__Pop()
                        dest = JSRT__Pop()
                        IfCondition NotEqual(kbuf, 0) ThenBlock: {
                            JSRT_ObjSet(dest, kbuf, ev)
                        }
                        ai = Add(ai, 1)
                    }
                    ReturnValue(1)
                }
                // Objects + functions (own enumerable props).
                IfCondition And(NotEqual(src_t, JSType.OBJECT), NotEqual(src_t, JSType.FUNCTION)) ThenBlock: {
                    ReturnValue(1)
                }
                JSRT__Push(dest)
                JSRT__Push(src)
                keys = JSRT_ObjKeys(src)
                src = JSRT__Pop()
                dest = JSRT__Pop()
                klen = JSRT_ArrLen(keys)
                ki = 0
                WhileLoop LessThan(ki, klen) {
                    JSRT__Push(dest)
                    JSRT__Push(src)
                    JSRT__Push(keys)
                    JSRT__Push(ki)
                    ksv = JSRT_ArrGet(keys, ki)
                    ki = JSRT__Pop()
                    keys = JSRT__Pop()
                    src = JSRT__Pop()
                    dest = JSRT__Pop()
                    kp = JSRT_GetPayload(ksv)

                    // Getter support: __get_<name> (M52: UTF-16-safe StrUnit, not GetByte)
                    // ObjKeys wraps C keys as JS strings — GetByte on payload was wrong.
                    got_via_getter = 0
                    IfCondition Or(EqualTo(src_t, JSType.OBJECT), EqualTo(src_t, JSType.FUNCTION)) ThenBlock: {
                        gk_buf = JSVMCallBuf.getter_buf
                        nlen_gk = JSRT_StrLen(kp)
                        IfCondition LessThan(nlen_gk, 100) ThenBlock: {
                            SetByte(gk_buf, 0, 95)
                            SetByte(gk_buf, 1, 95)
                            SetByte(gk_buf, 2, 103)
                            SetByte(gk_buf, 3, 101)
                            SetByte(gk_buf, 4, 116)
                            SetByte(gk_buf, 5, 95)
                            gki = 0
                            WhileLoop LessThan(gki, nlen_gk) {
                                u_gk = JSRT_StrUnit(kp, gki)
                                IfCondition GreaterThan(u_gk, 255) ThenBlock: { u_gk = 63 }
                                SetByte(gk_buf, Add(6, gki), u_gk)
                                gki = Add(gki, 1)
                            }
                            SetByte(gk_buf, Add(6, nlen_gk), 0)
                            JSRT__Push(dest)
                            JSRT__Push(src)
                            JSRT__Push(keys)
                            JSRT__Push(ki)
                            JSRT__Push(ksv)
                            getter_func = JSRT_ObjGet(src, gk_buf)
                            ksv = JSRT__Pop()
                            ki = JSRT__Pop()
                            keys = JSRT__Pop()
                            src = JSRT__Pop()
                            dest = JSRT__Pop()
                            gt = JSRT_GetType(getter_func)
                            IfCondition EqualTo(gt, JSType.FUNCTION) ThenBlock: {
                                save_this_sp = JSVM__GetGlobal("this")
                                JSVM__SetGlobal("this", src)
                                arg_buf_g = JSVMCallBuf.buf
                                JSRT__Push(dest)
                                JSRT__Push(src)
                                JSRT__Push(keys)
                                JSRT__Push(ki)
                                JSRT__Push(ksv)
                                v = JSVM__CallFunc(getter_func, arg_buf_g, 0)
                                ksv = JSRT__Pop()
                                ki = JSRT__Pop()
                                keys = JSRT__Pop()
                                src = JSRT__Pop()
                                dest = JSRT__Pop()
                                JSVM__SetGlobal("this", save_this_sp)
                                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                    ReturnValue(1)
                                }
                                kp = JSRT_GetPayload(ksv)
                                JSRT_ObjSet(dest, kp, v)
                                got_via_getter = 1
                            }
                        }
                    }
                    IfCondition EqualTo(got_via_getter, 0) ThenBlock: {
                        JSRT__Push(dest)
                        JSRT__Push(keys)
                        JSRT__Push(ki)
                        JSRT__Push(src)
                        v = JSRT_ObjGet(src, kp)
                        src = JSRT__Pop()
                        ki = JSRT__Pop()
                        keys = JSRT__Pop()
                        dest = JSRT__Pop()
                        JSRT_ObjSet(dest, kp, v)
                    }
                    ki = Add(ki, 1)
                }
                ReturnValue(1)
            }

            // GET_ITER (94) — [iterable] → [iter_record]
            // Arrays: fast index cursor when @@iterator is present (default).
            // Missing @@iterator (deleted Array.prototype[Symbol.iterator]) → TypeError.
            Case 94: {
                src = JSVM__StackPop()
                st = JSRT_GetType(src)
                rec = JSRT_CreateObject()
                IfCondition EqualTo(st, JSType.ARRAY) ThenBlock: {
                    // Mole 15: missing @@iterator → TypeError; custom → protocol;
                    // default Array.prototype.values → fast index cursor.
                    use_fast = 1
                    IfCondition NotEqual(JSVMSymbol.iterator, 0) ThenBlock: {
                        iter_key_a = JSVM_SymbolToKey(JSVMSymbol.iterator)
                        IfCondition NotEqual(iter_key_a, 0) ThenBlock: {
                            JSRT__Push(rec)
                            JSRT__Push(src)
                            factory_a = JSRT_ObjGet(src, iter_key_a)
                            src = JSRT__Pop()
                            rec = JSRT__Pop()
                            ft_a = JSRT_GetType(factory_a)
                            IfCondition EqualTo(ft_a, JSType.UNDEFINED) ThenBlock: {
                                terr = JSVM_CreateTypedError("TypeError", "array is not iterable")
                                JSVM_ThrowValue(terr)
                                ReturnValue(1)
                            }
                            IfCondition EqualTo(ft_a, JSType.FUNCTION) ThenBlock: {
                                // Custom if user JS (bc>=0) or generator fn (env 71).
                                // Native Array.prototype.values keeps fast path.
                                fbc_a = JSRT_FuncGetBC(factory_a)
                                fenv_a = JSRT_FuncGetEnv(factory_a)
                                is_custom = 0
                                IfCondition GreaterEqual(fbc_a, 0) ThenBlock: {
                                    is_custom = 1
                                }
                                IfCondition EqualTo(fenv_a, 71) ThenBlock: {
                                    is_custom = 1
                                }
                                IfCondition EqualTo(is_custom, 1) ThenBlock: {
                                    use_fast = 0
                                    JSVM__SetGlobal("this", src)
                                    empty_buf = JSVMCallBuf.buf
                                    JSRT__Push(rec)
                                    iterator = JSVM__CallFunc(factory_a, empty_buf, 0)
                                    rec = JSRT__Pop()
                                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                        // M128e6m: rethrow into gen/for-await
                                        pend_cf = JSVMCall.thrown_val
                                        IfCondition EqualTo(pend_cf, 0) ThenBlock: { pend_cf = JSVMState.exc_val }
                                        IfCondition EqualTo(pend_cf, 0) ThenBlock: { pend_cf = JSVM__GetGlobal("__pend_exc__") }
                                        JSVMCall.exc_prop = 0
                                        JSVMCall.thrown_val = 0
                                        JSVMState.exc_val = 0
                                        IfCondition And(NotEqual(pend_cf, 0), NotEqual(pend_cf, JSRTState.undef_val)) ThenBlock: {
                                            JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                            JSVM_ThrowValue(pend_cf)
                                        }
                                        ReturnValue(1)
                                    }
                                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                                        ReturnValue(1)
                                    }
                                    IfCondition NotEqual(JSRT_GetType(iterator), JSType.OBJECT) ThenBlock: {
                                        terr = JSVM_CreateTypedError("TypeError", "@@iterator returned non-object")
                                        JSVM_ThrowValue(terr)
                                        ReturnValue(1)
                                    }
                                    JSRT__Push(rec)
                                    JSRT__Push(iterator)
                                    next_fn = JSRT_ObjGet(iterator, "next")
                                    iterator = JSRT__Pop()
                                    rec = JSRT__Pop()
                                    // Defer next-callability to ITER_NEXT (see object path)
                                    JSRT__Push(rec)
                                    JSRT__Push(iterator)
                                    JSRT__Push(next_fn)
                                    mode1a = JSRT_CreateNumber(1)
                                    next_fn = JSRT__Pop()
                                    iterator = JSRT__Pop()
                                    rec = JSRT__Pop()
                                    JSRT_ObjSet(rec, "__m__", mode1a)
                                    JSRT_ObjSet(rec, "__it__", iterator)
                                    JSRT_ObjSet(rec, "__n__", next_fn)
                                    JSVMIter.done = 0
                                    JSVM__GenTrackOpenIter(rec)
                                    JSVM__StackPush(rec)
                                    ReturnValue(1)
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(use_fast, 1) ThenBlock: {
                        JSRT__Push(src)
                        mode0 = JSRT_CreateNumber(0)
                        src = JSRT__Pop()
                        JSRT_ObjSet(rec, "__m__", mode0)
                        JSRT_ObjSet(rec, "__a__", src)
                        JSRT__Push(rec)
                        z0 = JSRT_CreateNumber(0)
                        rec = JSRT__Pop()
                        JSRT_ObjSet(rec, "__i__", z0)
                        JSVMIter.done = 0
                        JSVM__GenTrackOpenIter(rec)
                        JSVM__StackPush(rec)
                        ReturnValue(1)
                    }
                }
                // Strings → treat as array of chars via IterableToArray then array mode
                IfCondition EqualTo(st, JSType.STRING) ThenBlock: {
                    expanded = JSVM_IterableToArray(src)
                    IfCondition EqualTo(expanded, 0) ThenBlock: {
                        ReturnValue(1)
                    }
                    JSRT__Push(expanded)
                    mode0s = JSRT_CreateNumber(0)
                    expanded = JSRT__Pop()
                    JSRT_ObjSet(rec, "__m__", mode0s)
                    JSRT_ObjSet(rec, "__a__", expanded)
                    JSRT__Push(rec)
                    z0s = JSRT_CreateNumber(0)
                    rec = JSRT__Pop()
                    JSRT_ObjSet(rec, "__i__", z0s)
                    JSVMIter.done = 0
                    JSVM__GenTrackOpenIter(rec)
                    JSVM__StackPush(rec)
                    ReturnValue(1)
                }
                IfCondition Or(EqualTo(st, JSType.NULL), EqualTo(st, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot destructure null/undefined")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                // Object / generator / custom: Symbol.iterator
                iter_key = 0
                IfCondition NotEqual(JSVMSymbol.iterator, 0) ThenBlock: {
                    iter_key = JSVM_SymbolToKey(JSVMSymbol.iterator)
                }
                IfCondition EqualTo(iter_key, 0) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "object is not iterable")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                JSRT__Push(rec)
                JSRT__Push(src)
                factory = JSRT_ObjGet(src, iter_key)
                src = JSRT__Pop()
                rec = JSRT__Pop()
                // Prefer @@iterator; else accept objects that already are iterators
                // (have .next) — generator wrappers lack @@iterator today.
                iterator = 0
                IfCondition EqualTo(JSRT_GetType(factory), JSType.FUNCTION) ThenBlock: {
                    JSVM__SetGlobal("this", src)
                    empty_buf = JSVMCallBuf.buf
                    JSRT__Push(rec)
                    iterator = JSVM__CallFunc(factory, empty_buf, 0)
                    rec = JSRT__Pop()
                    // Mole 15 / M128e6m: throw from @@iterator must re-ThrowValue
                    // so for-await / gen try paths see it (not bare exc_prop).
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        pend_cf = JSVMCall.thrown_val
                        IfCondition EqualTo(pend_cf, 0) ThenBlock: { pend_cf = JSVMState.exc_val }
                        IfCondition EqualTo(pend_cf, 0) ThenBlock: { pend_cf = JSVM__GetGlobal("__pend_exc__") }
                        JSVMCall.exc_prop = 0
                        JSVMCall.thrown_val = 0
                        JSVMState.exc_val = 0
                        IfCondition And(NotEqual(pend_cf, 0), NotEqual(pend_cf, JSRTState.undef_val)) ThenBlock: {
                            JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                            JSVM_ThrowValue(pend_cf)
                        }
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    IfCondition NotEqual(JSRT_GetType(iterator), JSType.OBJECT) ThenBlock: {
                        terr = JSVM_CreateTypedError("TypeError", "@@iterator returned non-object")
                        JSVM_ThrowValue(terr)
                        ReturnValue(1)
                    }
                } ElseBlock: {
                    // Direct iterator protocol: use src if it has .next
                    JSRT__Push(rec)
                    JSRT__Push(src)
                    nxt_chk = JSRT_ObjGet(src, "next")
                    src = JSRT__Pop()
                    rec = JSRT__Pop()
                    IfCondition EqualTo(JSRT_GetType(nxt_chk), JSType.FUNCTION) ThenBlock: {
                        iterator = src
                    } ElseBlock: {
                        terr = JSVM_CreateTypedError("TypeError", "object is not iterable")
                        JSVM_ThrowValue(terr)
                        ReturnValue(1)
                    }
                }
                // M65: GetMethod(iterator, "next") — honor defineProperty getters
                // once; store on record so ITER_NEXT never re-gets (next-reference).
                JSRT__Push(rec)
                JSRT__Push(iterator)
                next_fn = JSRT_Undefined()
                it_tn = JSRT_GetType(iterator)
                IfCondition Or(EqualTo(it_tn, JSType.OBJECT), EqualTo(it_tn, JSType.FUNCTION)) ThenBlock: {
                    gk_n = JSVMCallBuf.getter_buf
                    SetByte(gk_n, 0, 95)
                    SetByte(gk_n, 1, 95)
                    SetByte(gk_n, 2, 103)
                    SetByte(gk_n, 3, 101)
                    SetByte(gk_n, 4, 116)
                    SetByte(gk_n, 5, 95)
                    SetByte(gk_n, 6, 110)
                    SetByte(gk_n, 7, 101)
                    SetByte(gk_n, 8, 120)
                    SetByte(gk_n, 9, 116)
                    SetByte(gk_n, 10, 0)
                    gfn_n = JSRT_ObjGet(iterator, gk_n)
                    IfCondition EqualTo(JSRT_GetType(gfn_n), JSType.FUNCTION) ThenBlock: {
                        save_this_n = JSVM__GetGlobal("this")
                        JSVM__SetGlobal("this", iterator)
                        empty_ng = JSVMCallBuf.buf
                        next_fn = JSVM__CallFunc(gfn_n, empty_ng, 0)
                        JSVM__SetGlobal("this", save_this_n)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                    } ElseBlock: {
                        next_fn = JSRT_ObjGet(iterator, "next")
                    }
                } ElseBlock: {
                    next_fn = JSRT_ObjGet(iterator, "next")
                }
                iterator = JSRT__Pop()
                rec = JSRT__Pop()
                // Spec GetIterator: store nextMethod even if non-callable;
                // IteratorStep fails later. Early reject blocked rtrn-close-err
                // where yield suspends before any next() call.
                JSRT__Push(rec)
                JSRT__Push(iterator)
                JSRT__Push(next_fn)
                mode1 = JSRT_CreateNumber(1)
                next_fn = JSRT__Pop()
                iterator = JSRT__Pop()
                rec = JSRT__Pop()
                JSRT_ObjSet(rec, "__m__", mode1)
                JSRT_ObjSet(rec, "__it__", iterator)
                JSRT_ObjSet(rec, "__n__", next_fn)
                JSVMIter.done = 0
                JSVM__GenTrackOpenIter(rec)
                JSVM__StackPush(rec)
                ReturnValue(1)
            }

            // GET_ASYNC_ITER (111) — M128e6h for-await-of
            // GetIterator(obj, async): prefer @@asyncIterator; else @@iterator
            // (sync path / CreateAsyncFromSyncIterator simplified — same mode-1
            // record; ITER_NEXT already awaits thenables from next()).
            Case 111: {
                src = JSVM__StackPop()
                st = JSRT_GetType(src)
                rec = JSRT_CreateObject()
                IfCondition Or(EqualTo(st, JSType.NULL), EqualTo(st, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot iterate null/undefined")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                iterator = 0
                next_fn = 0
                empty_gai = JSVMCallBuf.buf
                used_async = 0
                // Prefer @@asyncIterator (honor defineProperty getters via __get_)
                IfCondition NotEqual(JSVMSymbol.asyncIterator, 0) ThenBlock: {
                    aik = JSVM_SymbolToKey(JSVMSymbol.asyncIterator)
                    IfCondition NotEqual(aik, 0) ThenBlock: {
                        gk_buf = JSVMCallBuf.getter_buf
                        SetByte(gk_buf, 0, 95)
                        SetByte(gk_buf, 1, 95)
                        SetByte(gk_buf, 2, 103)
                        SetByte(gk_buf, 3, 101)
                        SetByte(gk_buf, 4, 116)
                        SetByte(gk_buf, 5, 95)
                        gki = 0
                        gdone = 0
                        WhileLoop EqualTo(gdone, 0) {
                            gc = GetByte(aik, gki)
                            SetByte(gk_buf, Add(6, gki), gc)
                            IfCondition EqualTo(gc, 0) ThenBlock: {
                                gdone = 1
                            }
                            gki = Add(gki, 1)
                        }
                        JSRT__Push(rec)
                        JSRT__Push(src)
                        getter_ai = JSRT_ObjGet(src, gk_buf)
                        src = JSRT__Pop()
                        rec = JSRT__Pop()
                        afactory = 0
                        IfCondition EqualTo(JSRT_GetType(getter_ai), JSType.FUNCTION) ThenBlock: {
                            JSVM__SetGlobal("this", src)
                            JSRT__Push(rec)
                            JSRT__Push(src)
                            afactory = JSVM__CallFunc(getter_ai, empty_gai, 0)
                            src = JSRT__Pop()
                            rec = JSRT__Pop()
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                ReturnValue(1)
                            }
                            IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                                ReturnValue(1)
                            }
                        } ElseBlock: {
                            JSRT__Push(rec)
                            JSRT__Push(src)
                            afactory = JSRT_ObjGet(src, aik)
                            src = JSRT__Pop()
                            rec = JSRT__Pop()
                        }
                        aft = JSRT_GetType(afactory)
                        IfCondition And(NotEqual(aft, JSType.UNDEFINED), NotEqual(aft, JSType.NULL)) ThenBlock: {
                            IfCondition NotEqual(aft, JSType.FUNCTION) ThenBlock: {
                                terr = JSVM_CreateTypedError("TypeError", "@@asyncIterator is not a function")
                                JSVM_ThrowValue(terr)
                                ReturnValue(1)
                            }
                            JSVM__SetGlobal("this", src)
                            JSRT__Push(rec)
                            JSRT__Push(src)
                            iterator = JSVM__CallFunc(afactory, empty_gai, 0)
                            src = JSRT__Pop()
                            rec = JSRT__Pop()
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                pend_cf = JSVMCall.thrown_val
                                IfCondition EqualTo(pend_cf, 0) ThenBlock: { pend_cf = JSVMState.exc_val }
                                IfCondition EqualTo(pend_cf, 0) ThenBlock: { pend_cf = JSVM__GetGlobal("__pend_exc__") }
                                JSVMCall.exc_prop = 0
                                JSVMCall.thrown_val = 0
                                JSVMState.exc_val = 0
                                IfCondition And(NotEqual(pend_cf, 0), NotEqual(pend_cf, JSRTState.undef_val)) ThenBlock: {
                                    JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                    JSVM_ThrowValue(pend_cf)
                                }
                                ReturnValue(1)
                            }
                            IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                                ReturnValue(1)
                            }
                            it_t = JSRT_GetType(iterator)
                            IfCondition And(NotEqual(it_t, JSType.OBJECT), And(NotEqual(it_t, JSType.FUNCTION), NotEqual(it_t, JSType.ARRAY))) ThenBlock: {
                                terr = JSVM_CreateTypedError("TypeError", "@@asyncIterator returned non-object")
                                JSVM_ThrowValue(terr)
                                ReturnValue(1)
                            }
                            used_async = 1
                        }
                    }
                }
                // Async path: store next method (honor getter)
                IfCondition EqualTo(used_async, 1) ThenBlock: {
                    JSRT__Push(rec)
                    JSRT__Push(iterator)
                    next_fn = JSRT_Undefined()
                    it_tn = JSRT_GetType(iterator)
                    IfCondition Or(EqualTo(it_tn, JSType.OBJECT), EqualTo(it_tn, JSType.FUNCTION)) ThenBlock: {
                        gk_n = JSVMCallBuf.getter_buf
                        SetByte(gk_n, 0, 95)
                        SetByte(gk_n, 1, 95)
                        SetByte(gk_n, 2, 103)
                        SetByte(gk_n, 3, 101)
                        SetByte(gk_n, 4, 116)
                        SetByte(gk_n, 5, 95)
                        SetByte(gk_n, 6, 110)
                        SetByte(gk_n, 7, 101)
                        SetByte(gk_n, 8, 120)
                        SetByte(gk_n, 9, 116)
                        SetByte(gk_n, 10, 0)
                        gfn_n = JSRT_ObjGet(iterator, gk_n)
                        IfCondition EqualTo(JSRT_GetType(gfn_n), JSType.FUNCTION) ThenBlock: {
                            save_this_n = JSVM__GetGlobal("this")
                            JSVM__SetGlobal("this", iterator)
                            empty_ng = JSVMCallBuf.buf
                            next_fn = JSVM__CallFunc(gfn_n, empty_ng, 0)
                            JSVM__SetGlobal("this", save_this_n)
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                ReturnValue(1)
                            }
                            IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                                ReturnValue(1)
                            }
                        } ElseBlock: {
                            next_fn = JSRT_ObjGet(iterator, "next")
                        }
                    } ElseBlock: {
                        next_fn = JSRT_ObjGet(iterator, "next")
                    }
                    iterator = JSRT__Pop()
                    rec = JSRT__Pop()
                    JSRT__Push(rec)
                    JSRT__Push(iterator)
                    JSRT__Push(next_fn)
                    // mode 2 = async iterator (same next path as mode 1)
                    mode2 = JSRT_CreateNumber(2)
                    next_fn = JSRT__Pop()
                    iterator = JSRT__Pop()
                    rec = JSRT__Pop()
                    JSRT_ObjSet(rec, "__m__", mode2)
                    JSRT_ObjSet(rec, "__it__", iterator)
                    JSRT_ObjSet(rec, "__n__", next_fn)
                    JSVMIter.done = 0
                    JSVM__GenTrackOpenIter(rec)
                    JSVM__StackPush(rec)
                    ReturnValue(1)
                }
                // Fallback: sync GetIterator (arrays / @@iterator) — for-await of
                // sync iterables uses AsyncFromSync simplified via mode 0/1.
                // Arrays: fast index cursor (same as GET_ITER)
                IfCondition EqualTo(st, JSType.ARRAY) ThenBlock: {
                    use_fast = 1
                    IfCondition NotEqual(JSVMSymbol.iterator, 0) ThenBlock: {
                        iter_key_a = JSVM_SymbolToKey(JSVMSymbol.iterator)
                        IfCondition NotEqual(iter_key_a, 0) ThenBlock: {
                            JSRT__Push(rec)
                            JSRT__Push(src)
                            factory_a = JSRT_ObjGet(src, iter_key_a)
                            src = JSRT__Pop()
                            rec = JSRT__Pop()
                            ft_a = JSRT_GetType(factory_a)
                            IfCondition EqualTo(ft_a, JSType.UNDEFINED) ThenBlock: {
                                terr = JSVM_CreateTypedError("TypeError", "array is not iterable")
                                JSVM_ThrowValue(terr)
                                ReturnValue(1)
                            }
                            IfCondition EqualTo(ft_a, JSType.FUNCTION) ThenBlock: {
                                fbc_a = JSRT_FuncGetBC(factory_a)
                                fenv_a = JSRT_FuncGetEnv(factory_a)
                                is_custom = 0
                                IfCondition GreaterEqual(fbc_a, 0) ThenBlock: {
                                    is_custom = 1
                                }
                                IfCondition EqualTo(fenv_a, 71) ThenBlock: {
                                    is_custom = 1
                                }
                                IfCondition EqualTo(is_custom, 1) ThenBlock: {
                                    use_fast = 0
                                    JSVM__SetGlobal("this", src)
                                    empty_buf = JSVMCallBuf.buf
                                    JSRT__Push(rec)
                                    iterator = JSVM__CallFunc(factory_a, empty_buf, 0)
                                    rec = JSRT__Pop()
                                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                        // M128e6m: rethrow into gen/for-await
                                        pend_cf = JSVMCall.thrown_val
                                        IfCondition EqualTo(pend_cf, 0) ThenBlock: { pend_cf = JSVMState.exc_val }
                                        IfCondition EqualTo(pend_cf, 0) ThenBlock: { pend_cf = JSVM__GetGlobal("__pend_exc__") }
                                        JSVMCall.exc_prop = 0
                                        JSVMCall.thrown_val = 0
                                        JSVMState.exc_val = 0
                                        IfCondition And(NotEqual(pend_cf, 0), NotEqual(pend_cf, JSRTState.undef_val)) ThenBlock: {
                                            JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                            JSVM_ThrowValue(pend_cf)
                                        }
                                        ReturnValue(1)
                                    }
                                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                                        ReturnValue(1)
                                    }
                                    IfCondition NotEqual(JSRT_GetType(iterator), JSType.OBJECT) ThenBlock: {
                                        terr = JSVM_CreateTypedError("TypeError", "@@iterator returned non-object")
                                        JSVM_ThrowValue(terr)
                                        ReturnValue(1)
                                    }
                                    JSRT__Push(rec)
                                    JSRT__Push(iterator)
                                    next_fn = JSRT_ObjGet(iterator, "next")
                                    iterator = JSRT__Pop()
                                    rec = JSRT__Pop()
                                    JSRT__Push(rec)
                                    JSRT__Push(iterator)
                                    JSRT__Push(next_fn)
                                    mode1a = JSRT_CreateNumber(1)
                                    next_fn = JSRT__Pop()
                                    iterator = JSRT__Pop()
                                    rec = JSRT__Pop()
                                    JSRT_ObjSet(rec, "__m__", mode1a)
                                    JSRT_ObjSet(rec, "__it__", iterator)
                                    JSRT_ObjSet(rec, "__n__", next_fn)
                                    JSVMIter.done = 0
                                    JSVM__GenTrackOpenIter(rec)
                                    JSVM__StackPush(rec)
                                    ReturnValue(1)
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(use_fast, 1) ThenBlock: {
                        JSRT__Push(src)
                        mode0 = JSRT_CreateNumber(0)
                        src = JSRT__Pop()
                        JSRT_ObjSet(rec, "__m__", mode0)
                        JSRT_ObjSet(rec, "__a__", src)
                        JSRT__Push(rec)
                        z0 = JSRT_CreateNumber(0)
                        rec = JSRT__Pop()
                        JSRT_ObjSet(rec, "__i__", z0)
                        JSVMIter.done = 0
                        JSVM__GenTrackOpenIter(rec)
                        JSVM__StackPush(rec)
                        ReturnValue(1)
                    }
                }
                // Strings → expand then array mode
                IfCondition EqualTo(st, JSType.STRING) ThenBlock: {
                    expanded = JSVM_IterableToArray(src)
                    IfCondition EqualTo(expanded, 0) ThenBlock: {
                        ReturnValue(1)
                    }
                    JSRT__Push(expanded)
                    mode0s = JSRT_CreateNumber(0)
                    expanded = JSRT__Pop()
                    JSRT_ObjSet(rec, "__m__", mode0s)
                    JSRT_ObjSet(rec, "__a__", expanded)
                    JSRT__Push(rec)
                    z0s = JSRT_CreateNumber(0)
                    rec = JSRT__Pop()
                    JSRT_ObjSet(rec, "__i__", z0s)
                    JSVMIter.done = 0
                    JSVM__GenTrackOpenIter(rec)
                    JSVM__StackPush(rec)
                    ReturnValue(1)
                }
                // Object / custom: @@iterator (same as GET_ITER)
                iter_key = 0
                IfCondition NotEqual(JSVMSymbol.iterator, 0) ThenBlock: {
                    iter_key = JSVM_SymbolToKey(JSVMSymbol.iterator)
                }
                IfCondition EqualTo(iter_key, 0) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "object is not async iterable")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                JSRT__Push(rec)
                JSRT__Push(src)
                factory = JSRT_ObjGet(src, iter_key)
                src = JSRT__Pop()
                rec = JSRT__Pop()
                iterator = 0
                IfCondition EqualTo(JSRT_GetType(factory), JSType.FUNCTION) ThenBlock: {
                    JSVM__SetGlobal("this", src)
                    empty_buf = JSVMCallBuf.buf
                    JSRT__Push(rec)
                    iterator = JSVM__CallFunc(factory, empty_buf, 0)
                    rec = JSRT__Pop()
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        pend_cf = JSVMCall.thrown_val
                        IfCondition EqualTo(pend_cf, 0) ThenBlock: { pend_cf = JSVMState.exc_val }
                        IfCondition EqualTo(pend_cf, 0) ThenBlock: { pend_cf = JSVM__GetGlobal("__pend_exc__") }
                        JSVMCall.exc_prop = 0
                        JSVMCall.thrown_val = 0
                        JSVMState.exc_val = 0
                        IfCondition And(NotEqual(pend_cf, 0), NotEqual(pend_cf, JSRTState.undef_val)) ThenBlock: {
                            JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                            JSVM_ThrowValue(pend_cf)
                        }
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    IfCondition NotEqual(JSRT_GetType(iterator), JSType.OBJECT) ThenBlock: {
                        terr = JSVM_CreateTypedError("TypeError", "@@iterator returned non-object")
                        JSVM_ThrowValue(terr)
                        ReturnValue(1)
                    }
                } ElseBlock: {
                    JSRT__Push(rec)
                    JSRT__Push(src)
                    nxt_chk = JSRT_ObjGet(src, "next")
                    src = JSRT__Pop()
                    rec = JSRT__Pop()
                    IfCondition EqualTo(JSRT_GetType(nxt_chk), JSType.FUNCTION) ThenBlock: {
                        iterator = src
                    } ElseBlock: {
                        terr = JSVM_CreateTypedError("TypeError", "object is not async iterable")
                        JSVM_ThrowValue(terr)
                        ReturnValue(1)
                    }
                }
                JSRT__Push(rec)
                JSRT__Push(iterator)
                next_fn = JSRT_Undefined()
                it_tn = JSRT_GetType(iterator)
                IfCondition Or(EqualTo(it_tn, JSType.OBJECT), EqualTo(it_tn, JSType.FUNCTION)) ThenBlock: {
                    gk_n = JSVMCallBuf.getter_buf
                    SetByte(gk_n, 0, 95)
                    SetByte(gk_n, 1, 95)
                    SetByte(gk_n, 2, 103)
                    SetByte(gk_n, 3, 101)
                    SetByte(gk_n, 4, 116)
                    SetByte(gk_n, 5, 95)
                    SetByte(gk_n, 6, 110)
                    SetByte(gk_n, 7, 101)
                    SetByte(gk_n, 8, 120)
                    SetByte(gk_n, 9, 116)
                    SetByte(gk_n, 10, 0)
                    gfn_n = JSRT_ObjGet(iterator, gk_n)
                    IfCondition EqualTo(JSRT_GetType(gfn_n), JSType.FUNCTION) ThenBlock: {
                        save_this_n = JSVM__GetGlobal("this")
                        JSVM__SetGlobal("this", iterator)
                        empty_ng = JSVMCallBuf.buf
                        next_fn = JSVM__CallFunc(gfn_n, empty_ng, 0)
                        JSVM__SetGlobal("this", save_this_n)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                    } ElseBlock: {
                        next_fn = JSRT_ObjGet(iterator, "next")
                    }
                } ElseBlock: {
                    next_fn = JSRT_ObjGet(iterator, "next")
                }
                iterator = JSRT__Pop()
                rec = JSRT__Pop()
                JSRT__Push(rec)
                JSRT__Push(iterator)
                JSRT__Push(next_fn)
                mode1 = JSRT_CreateNumber(1)
                next_fn = JSRT__Pop()
                iterator = JSRT__Pop()
                rec = JSRT__Pop()
                JSRT_ObjSet(rec, "__m__", mode1)
                JSRT_ObjSet(rec, "__it__", iterator)
                JSRT_ObjSet(rec, "__n__", next_fn)
                JSVMIter.done = 0
                JSVM__GenTrackOpenIter(rec)
                JSVM__StackPush(rec)
                ReturnValue(1)
            }

            // ITER_NEXT (95) — [iter_record] → [value, done_bool]
            // done_bool is true/false; JSVMIter.done mirrors it for ITER_CLOSE.
            Case 95: {
                rec = JSVM__StackPop()
                mode_v = JSRT_ObjGet(rec, "__m__")
                mode = 0
                IfCondition EqualTo(JSRT_GetType(mode_v), JSType.NUMBER) ThenBlock: {
                    mode = Float_ToInt(JSRT_GetPayload(mode_v))
                }
                // Array mode
                IfCondition EqualTo(mode, 0) ThenBlock: {
                    arr = JSRT_ObjGet(rec, "__a__")
                    idx_v = JSRT_ObjGet(rec, "__i__")
                    idx = 0
                    IfCondition EqualTo(JSRT_GetType(idx_v), JSType.NUMBER) ThenBlock: {
                        idx = Float_ToInt(JSRT_GetPayload(idx_v))
                    }
                    alen = JSRT_ArrLen(arr)
                    IfCondition GreaterEqual(idx, alen) ThenBlock: {
                        JSVMIter.done = 1
                        JSRT_ObjSet(rec, "__done__", JSRT_True())
                        JSVM__StackPush(JSRT_Undefined())
                        JSVM__StackPush(JSRT_True())
                        ReturnValue(1)
                    }
                    // M61: ArrayLikeGet honors defineProperty getters (array-key-get-error)
                    JSRT__Push(rec)
                    JSRT__Push(arr)
                    ev = JSVM__ArrayLikeGet(arr, idx)
                    arr = JSRT__Pop()
                    rec = JSRT__Pop()
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        JSVMIter.done = 1
                        JSRT_ObjSet(rec, "__done__", JSRT_True())
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    JSRT__Push(rec)
                    JSRT__Push(ev)
                    nidx = JSRT_CreateNumber(Add(idx, 1))
                    ev = JSRT__Pop()
                    rec = JSRT__Pop()
                    JSRT_ObjSet(rec, "__i__", nidx)
                    JSVMIter.done = 0
                    JSRT_ObjSet(rec, "__done__", JSRT_False())
                    JSVM__StackPush(ev)
                    JSVM__StackPush(JSRT_False())
                    ReturnValue(1)
                }
                // Object iterator mode
                iterator = JSRT_ObjGet(rec, "__it__")
                next_fn = JSRT_ObjGet(rec, "__n__")
                IfCondition NotEqual(JSRT_GetType(next_fn), JSType.FUNCTION) ThenBlock: {
                    JSVMIter.done = 1
                    terr = JSVM_CreateTypedError("TypeError", "iterator.next is not a function")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                JSVM__SetGlobal("this", iterator)
                empty_buf = JSVMCallBuf.buf
                JSRT__Push(rec)
                res = JSVM__CallFunc(next_fn, empty_buf, 0)
                rec = JSRT__Pop()
                // Mole 15: next() throw propagates via CallFunc.exc_prop
                // Spec IteratorNext: on abrupt, set iteratorRecord.[[Done]] = true
                // so IteratorClose is not called (thrw-close-skip).
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    JSVMIter.done = 1
                    JSRT_ObjSet(rec, "__done__", JSRT_True())
                    pend2 = JSVMCall.thrown_val
                    IfCondition EqualTo(pend2, 0) ThenBlock: {
                        pend2 = JSVMState.exc_val
                    }
                    JSVMCall.thrown_val = 0
                    JSVMState.exc_val = 0
                    JSVMCall.exc_prop = 0
                    IfCondition NotEqual(pend2, 0) ThenBlock: {
                        JSVM_ThrowValue(pend2)
                    }
                    ReturnValue(1)
                }
                IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                    ReturnValue(1)
                }
                // M109: async generators return Promise<{value,done}> from next().
                // Without unwrap, Promise lacks .done → infinite not-done loop (OOM).
                // Eager AWAIT: fulfilled → payload; rejected → throw; pending → undef.
                IfCondition EqualTo(JSRT_GetType(res), JSType.OBJECT) ThenBlock: {
                    p_st_in = JSRT_ObjGet(res, "__state__")
                    IfCondition EqualTo(JSRT_GetType(p_st_in), JSType.NUMBER) ThenBlock: {
                        ps_in = Float_ToInt(JSRT_GetPayload(p_st_in))
                        IfCondition EqualTo(ps_in, 1) ThenBlock: {
                            resolved_in = JSRT_ObjGet(res, "__value__")
                            unwrap_in = 0
                            WhileLoop EqualTo(unwrap_in, 0) {
                                rt_in = JSRT_GetType(resolved_in)
                                IfCondition EqualTo(rt_in, JSType.OBJECT) ThenBlock: {
                                    rs_in = JSRT_ObjGet(resolved_in, "__state__")
                                    IfCondition EqualTo(JSRT_GetType(rs_in), JSType.NUMBER) ThenBlock: {
                                        rsv_in = Float_ToInt(JSRT_GetPayload(rs_in))
                                        IfCondition EqualTo(rsv_in, 1) ThenBlock: {
                                            resolved_in = JSRT_ObjGet(resolved_in, "__value__")
                                        } ElseBlock: {
                                            IfCondition EqualTo(rsv_in, 2) ThenBlock: {
                                                JSVMIter.done = 1
                                                JSRT_ObjSet(rec, "__done__", JSRT_True())
                                                rej_in = JSRT_ObjGet(resolved_in, "__value__")
                                                JSVM_ThrowValue(rej_in)
                                                ReturnValue(1)
                                            }
                                            unwrap_in = 1
                                        }
                                    } ElseBlock: {
                                        unwrap_in = 1
                                    }
                                } ElseBlock: {
                                    unwrap_in = 1
                                }
                            }
                            res = resolved_in
                        } ElseBlock: {
                            IfCondition EqualTo(ps_in, 2) ThenBlock: {
                                JSVMIter.done = 1
                                JSRT_ObjSet(rec, "__done__", JSRT_True())
                                rej_in2 = JSRT_ObjGet(res, "__value__")
                                JSVM_ThrowValue(rej_in2)
                                ReturnValue(1)
                            } ElseBlock: {
                                // Pending: treat as undefined result (eager mode)
                                res = JSRT_Undefined()
                            }
                        }
                    }
                }
                // Spec IteratorNext: result must be Object (ARRAY/FUNCTION ok).
                // Symbols are tagged OBJECT in our engine — reject via IsSymbol.
                rt_res = JSRT_GetType(res)
                IfCondition And(NotEqual(rt_res, JSType.OBJECT), And(NotEqual(rt_res, JSType.FUNCTION), NotEqual(rt_res, JSType.ARRAY))) ThenBlock: {
                    JSVMIter.done = 1
                    JSRT_ObjSet(rec, "__done__", JSRT_True())
                    terr = JSVM_CreateTypedError("TypeError", "iterator result is not an object")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                IfCondition EqualTo(JSVM_IsSymbol(res), 1) ThenBlock: {
                    JSVMIter.done = 1
                    JSRT_ObjSet(rec, "__done__", JSRT_True())
                    terr = JSVM_CreateTypedError("TypeError", "iterator result is not an object")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                // done: honor getter __get_done if present
                JSRT__Push(rec)
                JSRT__Push(res)
                done_getter = JSRT_ObjGet(res, "__get_done")
                res = JSRT__Pop()
                rec = JSRT__Pop()
                IfCondition EqualTo(JSRT_GetType(done_getter), JSType.FUNCTION) ThenBlock: {
                    JSVM__SetGlobal("this", res)
                    JSRT__Push(rec)
                    JSRT__Push(res)
                    done_v = JSVM__CallFunc(done_getter, empty_buf, 0)
                    res = JSRT__Pop()
                    rec = JSRT__Pop()
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                } ElseBlock: {
                    done_v = JSRT_ObjGet(res, "done")
                }
                IfCondition EqualTo(JSRT_IsTruthy(done_v), 1) ThenBlock: {
                    JSVMIter.done = 1
                    JSRT_ObjSet(rec, "__done__", JSRT_True())
                    JSVM__StackPush(JSRT_Undefined())
                    JSVM__StackPush(JSRT_True())
                    ReturnValue(1)
                }
                JSVMIter.done = 0
                JSRT_ObjSet(rec, "__done__", JSRT_False())
                // value: honor getter __get_value (iter-val-err)
                JSRT__Push(rec)
                JSRT__Push(res)
                val_getter = JSRT_ObjGet(res, "__get_value")
                res = JSRT__Pop()
                rec = JSRT__Pop()
                IfCondition EqualTo(JSRT_GetType(val_getter), JSType.FUNCTION) ThenBlock: {
                    JSVM__SetGlobal("this", res)
                    JSRT__Push(rec)
                    val_v = JSVM__CallFunc(val_getter, empty_buf, 0)
                    rec = JSRT__Pop()
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                } ElseBlock: {
                    val_v = JSRT_ObjGet(res, "value")
                }
                JSVM__StackPush(val_v)
                JSVM__StackPush(JSRT_False())
                ReturnValue(1)
            }

            // ITER_CLOSE (96) — [iter_record] → []; call .return if not done
            // 16-bit operand: 0 = normal completion, 1 = throw completion
            // Spec 7.4.6: throw completion → return original (ignore return()
            // throw and non-Object result).
            // M55: per-record __c__ closed flag (global JSVMIter.done is wrong for nested)
            Case 96: {
                close_kind = JSVM__Read16()
                rec = JSVM__StackPop()
                // M60: throw completion leaves original abrupt value under irec.
                // CallFunc for GetMethod/return can clobber stack AND reclaim
                // val_pool — promote snapshot to gval_pool so restore is live.
                save_throw_v = 0
                IfCondition EqualTo(close_kind, 1) ThenBlock: {
                    IfCondition GreaterThan(JSVMState.sp, 0) ThenBlock: {
                        raw_tv = Dereference(Add(JSVMState.stack, Multiply(Subtract(JSVMState.sp, 1), 8)))
                        save_throw_v = raw_tv
                        IfCondition And(NotEqual(raw_tv, 0), NotEqual(raw_tv, JSRTState.undef_val)) ThenBlock: {
                            use_d = 0
                            IfCondition EqualTo(raw_tv, JSRTState.true_val) ThenBlock: { use_d = 1 }
                            IfCondition EqualTo(raw_tv, JSRTState.false_val) ThenBlock: { use_d = 1 }
                            IfCondition EqualTo(raw_tv, JSRTState.null_val) ThenBlock: { use_d = 1 }
                            IfCondition EqualTo(use_d, 0) ThenBlock: {
                                prom = JSRT__AllocGlobalValue()
                                IfCondition NotEqual(prom, 0) ThenBlock: {
                                    StoreValue(prom, Dereference(raw_tv))
                                    StoreValue(Add(prom, 8), Dereference(Add(raw_tv, 8)))
                                    save_throw_v = prom
                                    // Also re-seat on stack immediately
                                    StoreValue(Add(JSVMState.stack, Multiply(Subtract(JSVMState.sp, 1), 8)), prom)
                                }
                            }
                        }
                    }
                }
                JSVM__GenClearOpenIter(rec)
                // Already closed this record?
                closed_v = JSRT_ObjGet(rec, "__c__")
                IfCondition EqualTo(JSRT_IsTruthy(closed_v), 1) ThenBlock: {
                    ReturnValue(1)
                }
                // Legacy: also honor global done when set after last ITER_NEXT
                // but only if no __c__ yet — for single-level still OK via __c__ below
                mode_v = JSRT_ObjGet(rec, "__m__")
                mode = 0
                IfCondition EqualTo(JSRT_GetType(mode_v), JSType.NUMBER) ThenBlock: {
                    mode = Float_ToInt(JSRT_GetPayload(mode_v))
                }
                // Array cursor: nothing to close
                IfCondition EqualTo(mode, 0) ThenBlock: {
                    JSVMIter.done = 1
                    JSRT_ObjSet(rec, "__c__", JSRT_True())
                    ReturnValue(1)
                }
                // If last ITER_NEXT already set done on this iterator, mark closed
                IfCondition EqualTo(JSVMIter.done, 1) ThenBlock: {
                    // Only skip return() if this record was the one that finished
                    // (marked via __done__ on record when ITER_NEXT exhausts)
                    rec_done = JSRT_ObjGet(rec, "__done__")
                    IfCondition EqualTo(JSRT_IsTruthy(rec_done), 1) ThenBlock: {
                        JSRT_ObjSet(rec, "__c__", JSRT_True())
                        ReturnValue(1)
                    }
                }
                iterator = JSRT_ObjGet(rec, "__it__")
                // M59: GetMethod(iterator, "return") — honor getters; null/undefined → no call
                // M60: preserve value stack (throw completion leaves original under irec)
                // around getter CallFunc so kind=1 rethrow still sees body throw.
                ret_fn = JSRT_Undefined()
                it_t = JSRT_GetType(iterator)
                IfCondition Or(EqualTo(it_t, JSType.OBJECT), EqualTo(it_t, JSType.FUNCTION)) ThenBlock: {
                    gk_ret = JSVMCallBuf.getter_buf
                    SetByte(gk_ret, 0, 95)
                    SetByte(gk_ret, 1, 95)
                    SetByte(gk_ret, 2, 103)
                    SetByte(gk_ret, 3, 101)
                    SetByte(gk_ret, 4, 116)
                    SetByte(gk_ret, 5, 95)
                    SetByte(gk_ret, 6, 114)
                    SetByte(gk_ret, 7, 101)
                    SetByte(gk_ret, 8, 116)
                    SetByte(gk_ret, 9, 117)
                    SetByte(gk_ret, 10, 114)
                    SetByte(gk_ret, 11, 110)
                    SetByte(gk_ret, 12, 0)
                    JSRT__Push(rec)
                    JSRT__Push(iterator)
                    gfn_ret = JSRT_ObjGet(iterator, gk_ret)
                    iterator = JSRT__Pop()
                    rec = JSRT__Pop()
                    IfCondition EqualTo(JSRT_GetType(gfn_ret), JSType.FUNCTION) ThenBlock: {
                        save_this_r = JSVM__GetGlobal("this")
                        JSVM__SetGlobal("this", iterator)
                        empty_rg = JSVMCallBuf.buf
                        save_sp_gm = JSVMState.sp
                        JSRT__Push(rec)
                        JSRT__Push(iterator)
                        // M128e6l: isolate getter throw from async-reject
                        prev_nar = JSVMCall.no_async_rej
                        JSVMCall.no_async_rej = 1
                        ret_fn = JSVM__CallFunc(gfn_ret, empty_rg, 0)
                        JSVMCall.no_async_rej = prev_nar
                        iterator = JSRT__Pop()
                        rec = JSRT__Pop()
                        // Restore stack depth: CallFunc may push/pop around kind=1
                        IfCondition GreaterThan(JSVMState.sp, save_sp_gm) ThenBlock: {
                            JSVMState.sp = save_sp_gm
                        }
                        JSVM__SetGlobal("this", save_this_r)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            // GetMethod throw: kind=0 propagates; kind=1 keeps
                            // original completion (spec IteratorClose step 6).
                            gm_err = JSVMCall.thrown_val
                            IfCondition EqualTo(gm_err, 0) ThenBlock: {
                                gm_err = JSVMState.exc_val
                            }
                            IfCondition EqualTo(gm_err, 0) ThenBlock: {
                                gm_err = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVMCall.exc_prop = 0
                            JSVMCall.thrown_val = 0
                            JSVMState.error = 0
                            JSVMState.halted = 0
                            JSVMState.exc_val = 0
                            JSVMIter.done = 1
                            JSRT_ObjSet(rec, "__c__", JSRT_True())
                            IfCondition EqualTo(close_kind, 0) ThenBlock: {
                                // M128e6l: re-throw via ThrowValue so async frames
                                // reject properly (exc_prop alone does not halt Run).
                                gm_bad = 0
                                IfCondition EqualTo(gm_err, 0) ThenBlock: { gm_bad = 1 }
                                IfCondition EqualTo(gm_err, JSRTState.undef_val) ThenBlock: { gm_bad = 1 }
                                IfCondition EqualTo(gm_bad, 1) ThenBlock: {
                                    gm_err = JSVM_CreateTypedError("TypeError", "iterator return GetMethod threw")
                                }
                                JSVM_ThrowValue(gm_err)
                                ReturnValue(1)
                            }
                            // kind=1: restore original body throw for outer THROW
                            IfCondition NotEqual(save_throw_v, 0) ThenBlock: {
                                IfCondition GreaterThan(JSVMState.sp, 0) ThenBlock: {
                                    StoreValue(Add(JSVMState.stack, Multiply(Subtract(JSVMState.sp, 1), 8)), save_throw_v)
                                } ElseBlock: {
                                    JSVM__StackPush(save_throw_v)
                                }
                            }
                            ReturnValue(1)
                        }
                    } ElseBlock: {
                        ret_fn = JSRT_ObjGet(iterator, "return")
                    }
                } ElseBlock: {
                    ret_fn = JSRT_ObjGet(iterator, "return")
                }
                rft = JSRT_GetType(ret_fn)
                // Missing return (undefined/null): no call (GetMethod)
                IfCondition Or(EqualTo(rft, JSType.UNDEFINED), EqualTo(rft, JSType.NULL)) ThenBlock: {
                    JSVMIter.done = 1
                    JSRT_ObjSet(rec, "__c__", JSRT_True())
                    IfCondition And(EqualTo(close_kind, 1), NotEqual(save_throw_v, 0)) ThenBlock: {
                        IfCondition GreaterThan(JSVMState.sp, 0) ThenBlock: {
                            StoreValue(Add(JSVMState.stack, Multiply(Subtract(JSVMState.sp, 1), 8)), save_throw_v)
                        } ElseBlock: {
                            JSVM__StackPush(save_throw_v)
                        }
                    }
                    ReturnValue(1)
                }
                // Non-callable return → TypeError (normal completion only)
                // M128e6i: mark closed before throw; use ThrowTypeError helper.
                IfCondition NotEqual(rft, JSType.FUNCTION) ThenBlock: {
                    JSVMIter.done = 1
                    JSRT_ObjSet(rec, "__c__", JSRT_True())
                    IfCondition EqualTo(close_kind, 0) ThenBlock: {
                        JSVM_ThrowTypeError("iterator return is not a function")
                        ReturnValue(1)
                    }
                    IfCondition NotEqual(save_throw_v, 0) ThenBlock: {
                        IfCondition GreaterThan(JSVMState.sp, 0) ThenBlock: {
                            StoreValue(Add(JSVMState.stack, Multiply(Subtract(JSVMState.sp, 1), 8)), save_throw_v)
                        } ElseBlock: {
                            JSVM__StackPush(save_throw_v)
                        }
                    }
                    ReturnValue(1)
                }
                JSVM__SetGlobal("this", iterator)
                empty_buf = JSVMCallBuf.buf
                // Isolate return() from outer try handlers so IteratorClose
                // can decide whether to keep original throw (kind=1) or
                // propagate return() throw (kind=0). Without this, return()
                // throw lands in assert.throws and skips close_kind logic.
                // M57: snapshot handler *data* — GenNext overlays gen try onto
                // exc_stack[0..]; restoring only exc_sp left clobbered catch addrs.
                save_exc_sp = JSVMState.exc_sp
                nsave = save_exc_sp
                IfCondition GreaterThan(nsave, 4) ThenBlock: { nsave = 4 }
                IfCondition And(GreaterThan(nsave, 0), LessThan(save_exc_sp, 12)) ThenBlock: {
                    MemoryCopy(Add(JSVMState.exc_stack, 384), JSVMState.exc_stack, Multiply(nsave, 32))
                }
                JSVMState.exc_sp = 0
                ret_res = JSVM__CallFunc(ret_fn, empty_buf, 0)
                IfCondition And(GreaterThan(nsave, 0), LessThan(save_exc_sp, 12)) ThenBlock: {
                    MemoryCopy(JSVMState.exc_stack, Add(JSVMState.exc_stack, 384), Multiply(nsave, 32))
                }
                JSVMState.exc_sp = save_exc_sp
                // return() throw: propagates only for normal completion
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    pend = JSVMCall.thrown_val
                    IfCondition EqualTo(pend, 0) ThenBlock: {
                        pend = JSVM__GetGlobal("__pend_exc__")
                    }
                    JSVMCall.thrown_val = 0
                    JSVMCall.exc_prop = 0
                    JSVM__SetGlobal("__pend_exc__", JSRTState.undef_val)
                    IfCondition EqualTo(close_kind, 0) ThenBlock: {
                        // Prefer pending value; CallFunc may only leave exc_val/error
                        IfCondition Or(EqualTo(pend, 0), EqualTo(pend, JSRTState.undef_val)) ThenBlock: {
                            pend = JSVMState.exc_val
                        }
                        JSVMState.error = 0
                        JSVMState.halted = 0
                        JSVMState.exc_val = 0
                        IfCondition NotEqual(pend, 0) ThenBlock: {
                            IfCondition NotEqual(pend, JSRTState.undef_val) ThenBlock: {
                                JSVM_ThrowValue(pend)
                            }
                        }
                        ReturnValue(1)
                    }
                    // throw-completion: swallow return() throw, keep original
                    JSVMState.error = 0
                    JSVMState.halted = 0
                    JSVMState.exc_val = 0
                    JSVMCall.thrown_val = 0
                    JSVMCall.exc_prop = 0
                    JSVMIter.done = 1
                    JSRT_ObjSet(rec, "__c__", JSRT_True())
                    IfCondition NotEqual(save_throw_v, 0) ThenBlock: {
                        IfCondition GreaterThan(JSVMState.sp, 0) ThenBlock: {
                            StoreValue(Add(JSVMState.stack, Multiply(Subtract(JSVMState.sp, 1), 8)), save_throw_v)
                        } ElseBlock: {
                            JSVM__StackPush(save_throw_v)
                        }
                    }
                    ReturnValue(1)
                }
                IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                    // Uncaught during return() without exc_prop path
                    IfCondition EqualTo(close_kind, 1) ThenBlock: {
                        JSVMState.error = 0
                        JSVMState.halted = 0
                        JSVMState.exc_val = 0
                        JSVMIter.done = 1
                        JSRT_ObjSet(rec, "__c__", JSRT_True())
                        IfCondition NotEqual(save_throw_v, 0) ThenBlock: {
                            IfCondition GreaterThan(JSVMState.sp, 0) ThenBlock: {
                                StoreValue(Add(JSVMState.stack, Multiply(Subtract(JSVMState.sp, 1), 8)), save_throw_v)
                            } ElseBlock: {
                                JSVM__StackPush(save_throw_v)
                            }
                        }
                        ReturnValue(1)
                    }
                    ReturnValue(1)
                }
                // Result of return() must be Object for normal completion only
                IfCondition EqualTo(close_kind, 0) ThenBlock: {
                    rrt = JSRT_GetType(ret_res)
                    IfCondition And(NotEqual(rrt, JSType.OBJECT), NotEqual(rrt, JSType.FUNCTION)) ThenBlock: {
                        IfCondition NotEqual(rrt, JSType.ARRAY) ThenBlock: {
                            terr = JSVM_CreateTypedError("TypeError", "iterator return result is not an object")
                            JSVM_ThrowValue(terr)
                            ReturnValue(1)
                        }
                    }
                }
                JSVMIter.done = 1
                JSRT_ObjSet(rec, "__c__", JSRT_True())
                JSRT_ObjSet(rec, "__done__", JSRT_True())
                // M60: after return() CallFunc, re-seat original throw on stack
                IfCondition And(EqualTo(close_kind, 1), NotEqual(save_throw_v, 0)) ThenBlock: {
                    IfCondition GreaterThan(JSVMState.sp, 0) ThenBlock: {
                        StoreValue(Add(JSVMState.stack, Multiply(Subtract(JSVMState.sp, 1), 8)), save_throw_v)
                    } ElseBlock: {
                        JSVM__StackPush(save_throw_v)
                    }
                }
                ReturnValue(1)
            }

            // PRIVATE_INIT_PULSE (97) — allow next private SET to PrivateFieldAdd
            // M26k.5: used only around field-definition SET in __field_init__
            Case 97: {
                JSVMState.private_init = 1
                ReturnValue(1)
            }

            // GET_PROP (16) — 16-bit operand: constant pool index (property name)
            // Pop object, push object.prop
            // Getter support: if obj has __get_<name>, invoke it.
            Case 16: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                obj = JSVM__StackPop()

                // Wave 3 D1: null/undefined base → TypeError
                // M26f: null.prototype → null (extends null heritage wiring)
                obj_type = JSRT_GetType(obj)
                IfCondition Or(EqualTo(obj_type, JSType.NULL), EqualTo(obj_type, JSType.UNDEFINED)) ThenBlock: {
                    is_proto_nm = 0
                    IfCondition EqualTo(obj_type, JSType.NULL) ThenBlock: {
                        IfCondition NotEqual(cpay, 0) ThenBlock: {
                            IfCondition EqualTo(GetByte(cpay, 0), 112) ThenBlock: {
                                IfCondition EqualTo(GetByte(cpay, 1), 114) ThenBlock: {
                                    IfCondition EqualTo(GetByte(cpay, 2), 111) ThenBlock: {
                                        IfCondition EqualTo(GetByte(cpay, 3), 116) ThenBlock: {
                                            IfCondition EqualTo(GetByte(cpay, 4), 111) ThenBlock: {
                                                IfCondition EqualTo(GetByte(cpay, 5), 116) ThenBlock: {
                                                    IfCondition EqualTo(GetByte(cpay, 6), 121) ThenBlock: {
                                                        IfCondition EqualTo(GetByte(cpay, 7), 112) ThenBlock: {
                                                            IfCondition EqualTo(GetByte(cpay, 8), 101) ThenBlock: {
                                                                IfCondition EqualTo(GetByte(cpay, 9), 0) ThenBlock: {
                                                                    is_proto_nm = 1
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(is_proto_nm, 1) ThenBlock: {
                        JSVM__StackPush(JSRTState.null_val)
                        ReturnValue(1)
                    }
                    terr = JSVM_CreateTypedError("TypeError", "Cannot read property of null/undefined")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }

                // M26k/k.4/k.10/k.11: private get — mangled #name@id only
                // Class-factory brand: callee __home_proto__ declares the private name;
                // static: receiver must be home; instance methods: function identity.
                IfCondition NotEqual(cpay, 0) ThenBlock: {
                    IfCondition EqualTo(JSVM__IsMangledPrivate(cpay), 1) ThenBlock: {
                        has_pf = 0
                        IfCondition Or(Or(EqualTo(obj_type, JSType.OBJECT), EqualTo(obj_type, JSType.FUNCTION)), EqualTo(obj_type, JSType.ARRAY)) ThenBlock: {
                            home_p = 0
                            IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                                cal_f = Dereference(Add(JSVMClosure.frame_funcs, Multiply(Subtract(JSVMState.fp, 1), 8)))
                                IfCondition EqualTo(JSRT_GetType(cal_f), JSType.FUNCTION) ThenBlock: {
                                    home_p = JSRT_FuncPropGet(cal_f, "__home_proto__")
                                }
                            }
                            ht = JSRT_GetType(home_p)
                            IfCondition Or(EqualTo(ht, JSType.OBJECT), EqualTo(ht, JSType.FUNCTION)) ThenBlock: {
                                // __get_ key buffer
                                gk_h = JSVMCallBuf.getter_buf
                                SetByte(gk_h, 0, 95)
                                SetByte(gk_h, 1, 95)
                                SetByte(gk_h, 2, 103)
                                SetByte(gk_h, 3, 101)
                                SetByte(gk_h, 4, 116)
                                SetByte(gk_h, 5, 95)
                                gi = 0
                                gdone = 0
                                WhileLoop EqualTo(gdone, 0) {
                                    gb = GetByte(cpay, gi)
                                    SetByte(gk_h, Add(6, gi), gb)
                                    IfCondition EqualTo(gb, 0) ThenBlock: { gdone = 1 }
                                    gi = Add(gi, 1)
                                }
                                // Static brand: home is the constructor FUNCTION
                                // Compare fdesc payloads (JSValue boxes may differ)
                                IfCondition EqualTo(ht, JSType.FUNCTION) ThenBlock: {
                                    home_fd = Dereference(Add(home_p, 8))
                                    recv_fd = 0
                                    IfCondition EqualTo(obj_type, JSType.FUNCTION) ThenBlock: {
                                        recv_fd = Dereference(Add(obj, 8))
                                    }
                                    IfCondition EqualTo(JSRT_ObjHas(home_p, cpay), 1) ThenBlock: {
                                        IfCondition NotEqual(recv_fd, home_fd) ThenBlock: {
                                            terr = JSVM_CreateTypedError("TypeError", "Cannot read private member")
                                            JSVM_ThrowValue(terr)
                                            ReturnValue(1)
                                        }
                                        has_pf = 1
                                    }
                                    IfCondition EqualTo(JSRT_ObjHas(home_p, gk_h), 1) ThenBlock: {
                                        IfCondition NotEqual(recv_fd, home_fd) ThenBlock: {
                                            terr = JSVM_CreateTypedError("TypeError", "Cannot read private member")
                                            JSVM_ThrowValue(terr)
                                            ReturnValue(1)
                                        }
                                        has_pf = 1
                                    }
                                }
                                // Instance: method identity on home OBJECT proto
                                IfCondition EqualTo(ht, JSType.OBJECT) ThenBlock: {
                                    IfCondition EqualTo(JSRT_ObjHas(home_p, cpay), 1) ThenBlock: {
                                        home_meth = JSRT_ObjGet(home_p, cpay)
                                        IfCondition EqualTo(JSRT_GetType(home_meth), JSType.FUNCTION) ThenBlock: {
                                            chain_meth = JSRT_ObjGet(obj, cpay)
                                            IfCondition NotEqual(chain_meth, home_meth) ThenBlock: {
                                                terr = JSVM_CreateTypedError("TypeError", "Cannot read private member")
                                                JSVM_ThrowValue(terr)
                                                ReturnValue(1)
                                            }
                                            JSVM__StackPush(home_meth)
                                            ReturnValue(1)
                                        }
                                    }
                                    IfCondition EqualTo(JSRT_ObjHas(home_p, gk_h), 1) ThenBlock: {
                                        home_get = JSRT_ObjGet(home_p, gk_h)
                                        IfCondition EqualTo(JSRT_GetType(home_get), JSType.FUNCTION) ThenBlock: {
                                            chain_get = JSRT_ObjGet(obj, gk_h)
                                            IfCondition NotEqual(chain_get, home_get) ThenBlock: {
                                                terr = JSVM_CreateTypedError("TypeError", "Cannot read private member")
                                                JSVM_ThrowValue(terr)
                                                ReturnValue(1)
                                            }
                                            save_this_g = JSVM__GetGlobal("this")
                                            JSVM__SetGlobal("this", obj)
                                            empty_g = JSVMCallBuf.buf
                                            gres = JSVM__CallFunc(home_get, empty_g, 0)
                                            JSVM__SetGlobal("this", save_this_g)
                                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                                // M128e6o: re-ThrowValue so gen/for-await dstr aborts
                                                pend_g = JSVMCall.thrown_val
                                                IfCondition EqualTo(pend_g, 0) ThenBlock: { pend_g = JSVMState.exc_val }
                                                IfCondition EqualTo(pend_g, 0) ThenBlock: { pend_g = JSVM__GetGlobal("__pend_exc__") }
                                                JSVMCall.exc_prop = 0
                                                JSVMCall.thrown_val = 0
                                                JSVMState.exc_val = 0
                                                IfCondition And(NotEqual(pend_g, 0), NotEqual(pend_g, JSRTState.undef_val)) ThenBlock: {
                                                    JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                                    JSVM_ThrowValue(pend_g)
                                                }
                                                ReturnValue(1)
                                            }
                                            JSVM__StackPush(gres)
                                            ReturnValue(1)
                                        }
                                    }
                                }
                            }
                            IfCondition EqualTo(has_pf, 0) ThenBlock: {
                                has_pf = JSRT_ObjHas(obj, cpay)
                            }
                            IfCondition EqualTo(has_pf, 0) ThenBlock: {
                                has_pf = JSRT_ObjHasOnChain(obj, cpay)
                            }
                            IfCondition EqualTo(has_pf, 0) ThenBlock: {
                                gk_buf = JSVMCallBuf.getter_buf
                                SetByte(gk_buf, 0, 95)
                                SetByte(gk_buf, 1, 95)
                                SetByte(gk_buf, 2, 103)
                                SetByte(gk_buf, 3, 101)
                                SetByte(gk_buf, 4, 116)
                                SetByte(gk_buf, 5, 95)
                                gi = 0
                                gdone = 0
                                WhileLoop EqualTo(gdone, 0) {
                                    gb = GetByte(cpay, gi)
                                    SetByte(gk_buf, Add(6, gi), gb)
                                    IfCondition EqualTo(gb, 0) ThenBlock: { gdone = 1 }
                                    gi = Add(gi, 1)
                                }
                                has_pf = JSRT_ObjHasOnChain(obj, gk_buf)
                            }
                        }
                        IfCondition EqualTo(has_pf, 0) ThenBlock: {
                            terr = JSVM_CreateTypedError("TypeError", "Cannot read private member")
                            JSVM_ThrowValue(terr)
                            ReturnValue(1)
                        }
                    }
                }

                // Handle array.length
                IfCondition EqualTo(obj_type, JSType.ARRAY) ThenBlock: {
                    // Check if property is "length"
                    // "length" = 108 101 110 103 116 104
                    is_len = 0
                    c0 = GetByte(cpay, 0)
                    IfCondition EqualTo(c0, 108) ThenBlock: {
                        c1 = GetByte(cpay, 1)
                        IfCondition EqualTo(c1, 101) ThenBlock: {
                            c2 = GetByte(cpay, 2)
                            IfCondition EqualTo(c2, 110) ThenBlock: {
                                c3 = GetByte(cpay, 3)
                                IfCondition EqualTo(c3, 103) ThenBlock: {
                                    c4 = GetByte(cpay, 4)
                                    IfCondition EqualTo(c4, 116) ThenBlock: {
                                        c5 = GetByte(cpay, 5)
                                        IfCondition EqualTo(c5, 104) ThenBlock: {
                                            c6 = GetByte(cpay, 6)
                                            IfCondition EqualTo(c6, 0) ThenBlock: {
                                                is_len = 1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(is_len, 1) ThenBlock: {
                        alen = JSRT_ArrLen(obj)
                        JSVM__StackPush(JSRT_CreateNumber(alen))
                        ReturnValue(1)
                    }
                    // Match array method names
                    arr_mid = JSVM__MatchArrayMethod(cpay)
                    IfCondition GreaterThan(arr_mid, 0) ThenBlock: {
                        am_func = JSBridge__CreateNativeFunc(arr_mid, cpay, 1)
                        JSRT_FuncSetEnv(am_func, obj)
                        JSVM__StackPush(am_func)
                        ReturnValue(1)
                    }
                    // Match string methods on arrays (indexOf, etc.)
                    str_method_id = JSVM__MatchStringMethod(cpay)
                    IfCondition GreaterThan(str_method_id, 0) ThenBlock: {
                        sm_func = JSBridge__CreateNativeFunc(str_method_id, cpay, 1)
                        JSRT_FuncSetEnv(sm_func, obj)
                        JSVM__StackPush(sm_func)
                        ReturnValue(1)
                    }
                }

                // String property/method access
                IfCondition EqualTo(obj_type, JSType.STRING) ThenBlock: {
                    // Check "length" first (108 101 110 103 116 104 0)
                    c0 = GetByte(cpay, 0)
                    IfCondition EqualTo(c0, 108) ThenBlock: {
                        IfCondition EqualTo(GetByte(cpay, 1), 101) ThenBlock: {
                            IfCondition EqualTo(GetByte(cpay, 2), 110) ThenBlock: {
                                IfCondition EqualTo(GetByte(cpay, 3), 103) ThenBlock: {
                                    IfCondition EqualTo(GetByte(cpay, 4), 116) ThenBlock: {
                                        IfCondition EqualTo(GetByte(cpay, 5), 104) ThenBlock: {
                                            IfCondition EqualTo(GetByte(cpay, 6), 0) ThenBlock: {
                                                str_ptr = JSRT_GetPayload(obj)
                                                slen = JSRT_StrLen(str_ptr)
                                                JSVM__StackPush(JSRT_CreateNumber(slen))
                                                ReturnValue(1)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Match string method names and create bound native func
                    str_method_id = JSVM__MatchStringMethod(cpay)
                    IfCondition GreaterThan(str_method_id, 0) ThenBlock: {
                        sm_func = JSBridge__CreateNativeFunc(str_method_id, cpay, 1)
                        JSRT_FuncSetEnv(sm_func, obj)
                        JSVM__StackPush(sm_func)
                        ReturnValue(1)
                    }
                    // M35: fall through to String.prototype (toString/valueOf/etc.)
                    // Do NOT FuncSetEnv on shared proto methods — CALL_METHOD binds this.
                    str_g = JSVM__GetGlobal("String")
                    IfCondition EqualTo(JSRT_GetType(str_g), JSType.FUNCTION) ThenBlock: {
                        str_pr = JSRT_ObjGet(str_g, "prototype")
                        IfCondition EqualTo(JSRT_GetType(str_pr), JSType.OBJECT) ThenBlock: {
                            meth = JSRT_ObjGet(str_pr, cpay)
                            IfCondition EqualTo(JSRT_GetType(meth), JSType.FUNCTION) ThenBlock: {
                                JSVM__StackPush(meth)
                                ReturnValue(1)
                            }
                        }
                    }
                    JSVM__StackPush(JSRT_Undefined())
                    ReturnValue(1)
                }

                // M104: Number/Boolean property get — walk Number/Boolean.prototype
                // then Object.prototype. Keep primitive as getter thisArg so
                // OrdinaryCallBindThis can box (non-strict) or leave (strict).
                // Without this, (5).x with Object.prototype getter was undefined.
                IfCondition Or(EqualTo(obj_type, JSType.NUMBER), EqualTo(obj_type, JSType.BOOLEAN)) ThenBlock: {
                    prim_proto = 0
                    IfCondition EqualTo(obj_type, JSType.NUMBER) ThenBlock: {
                        ng_p = JSVM__GetGlobal("Number")
                        IfCondition EqualTo(JSRT_GetType(ng_p), JSType.FUNCTION) ThenBlock: {
                            prim_proto = JSRT_ObjGet(ng_p, "prototype")
                        }
                    }
                    IfCondition EqualTo(obj_type, JSType.BOOLEAN) ThenBlock: {
                        bg_p = JSVM__GetGlobal("Boolean")
                        IfCondition EqualTo(JSRT_GetType(bg_p), JSType.FUNCTION) ThenBlock: {
                            prim_proto = JSRT_ObjGet(bg_p, "prototype")
                        }
                    }
                    IfCondition EqualTo(JSRT_GetType(prim_proto), JSType.OBJECT) ThenBlock: {
                        gk_buf2 = JSVMCallBuf.getter_buf
                        SetByte(gk_buf2, 0, 95)
                        SetByte(gk_buf2, 1, 95)
                        SetByte(gk_buf2, 2, 103)
                        SetByte(gk_buf2, 3, 101)
                        SetByte(gk_buf2, 4, 116)
                        SetByte(gk_buf2, 5, 95)
                        JSVMTmp.idx = 0
                        JSVMTmp.done = 0
                        WhileLoop EqualTo(JSVMTmp.done, 0) {
                            JSVMTmp.val = GetByte(cpay, JSVMTmp.idx)
                            SetByte(gk_buf2, Add(6, JSVMTmp.idx), JSVMTmp.val)
                            IfCondition EqualTo(JSVMTmp.val, 0) ThenBlock: {
                                JSVMTmp.done = 1
                            }
                            JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                        }
                        // Prefer accessor on chain
                        getter_func = JSRT_ObjGet(prim_proto, gk_buf2)
                        gt = JSRT_GetType(getter_func)
                        IfCondition EqualTo(gt, JSType.FUNCTION) ThenBlock: {
                            save_this_g = JSVM__GetGlobal("this")
                            JSVM__SetGlobal("this", obj)
                            empty_g = JSVMCallBuf.buf
                            gres = JSVM__CallFunc(getter_func, empty_g, 0)
                            JSVM__SetGlobal("this", save_this_g)
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                // M128e6o: re-ThrowValue so gen/for-await dstr aborts
                                pend_g = JSVMCall.thrown_val
                                IfCondition EqualTo(pend_g, 0) ThenBlock: { pend_g = JSVMState.exc_val }
                                IfCondition EqualTo(pend_g, 0) ThenBlock: { pend_g = JSVM__GetGlobal("__pend_exc__") }
                                JSVMCall.exc_prop = 0
                                JSVMCall.thrown_val = 0
                                JSVMState.exc_val = 0
                                IfCondition And(NotEqual(pend_g, 0), NotEqual(pend_g, JSRTState.undef_val)) ThenBlock: {
                                    JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                    JSVM_ThrowValue(pend_g)
                                }
                                ReturnValue(1)
                            }
                            JSVM__StackPush(gres)
                            ReturnValue(1)
                        }
                        // Data property on chain
                        pval = JSRT_ObjGet(prim_proto, cpay)
                        IfCondition NotEqual(JSRT_GetType(pval), JSType.UNDEFINED) ThenBlock: {
                            JSVM__StackPush(pval)
                            ReturnValue(1)
                        }
                    }
                    JSVM__StackPush(JSRT_Undefined())
                    ReturnValue(1)
                }

                // M105: .caller / .arguments poison — TypeError for strict funcs + bound
                IfCondition EqualTo(obj_type, JSType.FUNCTION) ThenBlock: {
                    IfCondition NotEqual(cpay, 0) ThenBlock: {
                        is_poison = 0
                        IfCondition EqualTo(JSRT_StrEq(cpay, "caller"), 1) ThenBlock: { is_poison = 1 }
                        IfCondition EqualTo(JSRT_StrEq(cpay, "arguments"), 1) ThenBlock: { is_poison = 1 }
                        IfCondition EqualTo(is_poison, 1) ThenBlock: {
                            fdesc_p = JSRT_GetPayload(obj)
                            poison_throw = 0
                            IfCondition NotEqual(fdesc_p, 0) ThenBlock: {
                                fparams_p = Dereference(Add(fdesc_p, 8))
                                IfCondition NotEqual(BitwiseAnd(fparams_p, 536870912), 0) ThenBlock: {
                                    poison_throw = 1
                                }
                                // Bound functions (FUNC_BOUND bc=-199) inherit poison
                                fbc_p = Dereference(fdesc_p)
                                IfCondition EqualTo(fbc_p, -199) ThenBlock: {
                                    poison_throw = 1
                                }
                                // Native handler_id 198 = FUNC_BOUND: bc = -1 - 198 = -199
                            }
                            IfCondition EqualTo(poison_throw, 1) ThenBlock: {
                                terr = JSVM_CreateTypedError("TypeError", "Cannot access caller or arguments of strict function")
                                JSVM_ThrowValue(terr)
                                ReturnValue(1)
                            }
                        }
                    }
                }

                // Check for getter: __get_<name> (OBJECT + FUNCTION for static class getters)
                IfCondition Or(EqualTo(obj_type, JSType.OBJECT), EqualTo(obj_type, JSType.FUNCTION)) ThenBlock: {
                    gk_buf2 = JSVMCallBuf.getter_buf
                    SetByte(gk_buf2, 0, 95)
                    SetByte(gk_buf2, 1, 95)
                    SetByte(gk_buf2, 2, 103)
                    SetByte(gk_buf2, 3, 101)
                    SetByte(gk_buf2, 4, 116)
                    SetByte(gk_buf2, 5, 95)
                    JSVMTmp.idx = 0
                    JSVMTmp.done = 0
                    WhileLoop EqualTo(JSVMTmp.done, 0) {
                        JSVMTmp.val = GetByte(cpay, JSVMTmp.idx)
                        SetByte(gk_buf2, Add(6, JSVMTmp.idx), JSVMTmp.val)
                        IfCondition EqualTo(JSVMTmp.val, 0) ThenBlock: {
                            JSVMTmp.done = 1
                        }
                        JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                    }
                    getter_func = JSRT_ObjGet(obj, gk_buf2)
                    gt = JSRT_GetType(getter_func)
                    IfCondition EqualTo(gt, JSType.FUNCTION) ThenBlock: {
                        // Bind this = receiver; restore after (static super.x then super.m)
                        save_this_g = JSVM__GetGlobal("this")
                        JSVM__SetGlobal("this", obj)
                        empty_g = JSVMCallBuf.buf
                        gres = JSVM__CallFunc(getter_func, empty_g, 0)
                        JSVM__SetGlobal("this", save_this_g)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            // M128e6o: re-ThrowValue so gen/for-await dstr aborts
                            pend_g = JSVMCall.thrown_val
                            IfCondition EqualTo(pend_g, 0) ThenBlock: { pend_g = JSVMState.exc_val }
                            IfCondition EqualTo(pend_g, 0) ThenBlock: { pend_g = JSVM__GetGlobal("__pend_exc__") }
                            JSVMCall.exc_prop = 0
                            JSVMCall.thrown_val = 0
                            JSVMState.exc_val = 0
                            IfCondition And(NotEqual(pend_g, 0), NotEqual(pend_g, JSRTState.undef_val)) ThenBlock: {
                                JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                JSVM_ThrowValue(pend_g)
                            }
                            ReturnValue(1)
                        }
                        JSVM__StackPush(gres)
                        ReturnValue(1)
                    }
                }

                // RegExp method binding — same pattern as string methods:
                // detect method name, create bound native func with env=receiver.
                IfCondition EqualTo(obj_type, JSType.OBJECT) ThenBlock: {
                    rx_mid = JSVM__MatchRegExpMethod(cpay)
                    IfCondition GreaterThan(rx_mid, 0) ThenBlock: {
                        // Verify this is actually a RegExp (has __regex_handle__)
                        rh_chk = PropTable_Lookup(Dereference(Add(obj, 8)), "__regex_handle__")
                        IfCondition NotEqual(rh_chk, -1) ThenBlock: {
                            rx_func = JSBridge__CreateNativeFunc(rx_mid, cpay, 1)
                            JSRT_FuncSetEnv(rx_func, obj)
                            JSVM__StackPush(rx_func)
                            ReturnValue(1)
                        }
                    }
                }

                pval = JSRT_ObjGet(obj, cpay)
                // Object.create(null) stores [[Prototype]] as own "__proto__"=null.
                // Public property get of "__proto__" must be undefined (no accessor
                // on Object.prototype). Module NS tests: ns.__proto__ === undefined.
                IfCondition NotEqual(cpay, 0) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrEq(cpay, "__proto__"), 1) ThenBlock: {
                        IfCondition EqualTo(JSRT_GetType(pval), JSType.NULL) ThenBlock: {
                            pval = JSRT_Undefined()
                        }
                    }
                }
                JSVM__StackPush(pval)
                ReturnValue(1)
            }

            // SET_PROP (17) — 16-bit operand: constant pool index (property name)
            // Stack: [..., object, value]. Pop value, pop object, set prop.
            // Setter support: if obj has __set_<name>, invoke it (mirror of GET_PROP getters).
            // DOM interception: if obj has __dom_idx and prop is innerHTML/textContent,
            // JSBridge_SetProp updates the actual DOM tree.
            Case 17: {
                cidx = JSVM__Read16()
                JSVMTmp.ptr = JSVM__GetConstPayload(cidx)
                JSVMTmp.val = JSVM__StackPop()
                JSVMTmp.addr = JSVM__StackPop()

                // Wave 3 D1: null/undefined base → TypeError
                set_obj_t = JSRT_GetType(JSVMTmp.addr)
                IfCondition Or(EqualTo(set_obj_t, JSType.NULL), EqualTo(set_obj_t, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot set property of null/undefined")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }

                // M105: .caller / .arguments poison on set (strict + bound)
                IfCondition EqualTo(set_obj_t, JSType.FUNCTION) ThenBlock: {
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        is_poison_s = 0
                        IfCondition EqualTo(JSRT_StrEq(JSVMTmp.ptr, "caller"), 1) ThenBlock: { is_poison_s = 1 }
                        IfCondition EqualTo(JSRT_StrEq(JSVMTmp.ptr, "arguments"), 1) ThenBlock: { is_poison_s = 1 }
                        IfCondition EqualTo(is_poison_s, 1) ThenBlock: {
                            fdesc_ps = JSRT_GetPayload(JSVMTmp.addr)
                            poison_ts = 0
                            IfCondition NotEqual(fdesc_ps, 0) ThenBlock: {
                                fparams_ps = Dereference(Add(fdesc_ps, 8))
                                IfCondition NotEqual(BitwiseAnd(fparams_ps, 536870912), 0) ThenBlock: {
                                    poison_ts = 1
                                }
                                IfCondition EqualTo(Dereference(fdesc_ps), -199) ThenBlock: {
                                    poison_ts = 1
                                }
                            }
                            IfCondition EqualTo(poison_ts, 1) ThenBlock: {
                                terr = JSVM_CreateTypedError("TypeError", "Cannot access caller or arguments of strict function")
                                JSVM_ThrowValue(terr)
                                ReturnValue(1)
                            }
                        }
                    }
                }

                // M26k/k.5/k.10/k.11: private set — mangled #name@id only
                // Setter brand: same function identity as home __set_#name
                IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                    IfCondition EqualTo(JSVM__IsMangledPrivate(JSVMTmp.ptr), 1) ThenBlock: {
                        IfCondition EqualTo(JSVMState.private_init, 0) ThenBlock: {
                            has_pf = 0
                            IfCondition Or(EqualTo(set_obj_t, JSType.OBJECT), EqualTo(set_obj_t, JSType.FUNCTION)) ThenBlock: {
                                // Build __set_#name
                                sk_chk = JSVMCallBuf.getter_buf
                                SetByte(sk_chk, 0, 95)
                                SetByte(sk_chk, 1, 95)
                                SetByte(sk_chk, 2, 115)
                                SetByte(sk_chk, 3, 101)
                                SetByte(sk_chk, 4, 116)
                                SetByte(sk_chk, 5, 95)
                                si = 0
                                sdone = 0
                                WhileLoop EqualTo(sdone, 0) {
                                    sb = GetByte(JSVMTmp.ptr, si)
                                    SetByte(sk_chk, Add(6, si), sb)
                                    IfCondition EqualTo(sb, 0) ThenBlock: { sdone = 1 }
                                    si = Add(si, 1)
                                }
                                // Own data field
                                has_pf = JSRT_ObjHas(JSVMTmp.addr, JSVMTmp.ptr)
                                IfCondition EqualTo(has_pf, 1) ThenBlock: {
                                    // Skip if accessor placeholder only
                                    IfCondition EqualTo(JSRT_ObjHas(JSVMTmp.addr, sk_chk), 1) ThenBlock: {
                                        has_pf = 0
                                    }
                                }
                                IfCondition EqualTo(has_pf, 0) ThenBlock: {
                                    home_p = 0
                                    IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                                        cal_f = Dereference(Add(JSVMClosure.frame_funcs, Multiply(Subtract(JSVMState.fp, 1), 8)))
                                        IfCondition EqualTo(JSRT_GetType(cal_f), JSType.FUNCTION) ThenBlock: {
                                            home_p = JSRT_FuncPropGet(cal_f, "__home_proto__")
                                        }
                                    }
                                    ht = JSRT_GetType(home_p)
                                    IfCondition Or(EqualTo(ht, JSType.OBJECT), EqualTo(ht, JSType.FUNCTION)) ThenBlock: {
                                        IfCondition EqualTo(JSRT_ObjHas(home_p, sk_chk), 1) ThenBlock: {
                                            home_set = JSRT_ObjGet(home_p, sk_chk)
                                            chain_set = JSRT_ObjGet(JSVMTmp.addr, sk_chk)
                                            IfCondition NotEqual(home_set, chain_set) ThenBlock: {
                                                terr = JSVM_CreateTypedError("TypeError", "Cannot write private member")
                                                JSVM_ThrowValue(terr)
                                                ReturnValue(1)
                                            }
                                            has_pf = 1
                                        }
                                    }
                                }
                                IfCondition EqualTo(has_pf, 0) ThenBlock: {
                                    has_pf = JSRT_ObjHasOnChain(JSVMTmp.addr, JSVMTmp.ptr)
                                }
                                IfCondition EqualTo(has_pf, 0) ThenBlock: {
                                    has_pf = JSRT_ObjHasOnChain(JSVMTmp.addr, sk_chk)
                                }
                            }
                            // Private method install: function value (class body method define)
                            IfCondition EqualTo(has_pf, 0) ThenBlock: {
                                IfCondition EqualTo(JSRT_GetType(JSVMTmp.val), JSType.FUNCTION) ThenBlock: {
                                    has_pf = 1
                                }
                            }
                            IfCondition EqualTo(has_pf, 0) ThenBlock: {
                                terr = JSVM_CreateTypedError("TypeError", "Cannot write private member")
                                JSVM_ThrowValue(terr)
                                ReturnValue(1)
                            }
                        } ElseBlock: {
                            // M26k.5: pulse consumed after this field define SET
                            JSVMState.private_init = 0
                        }
                    }
                }

                // Check for setter: __set_<name> (OBJECT + FUNCTION for static class setters)
                // M26k.9: field_define → CreateDataPropertyOrThrow (skip inherited setters)
                IfCondition And(EqualTo(JSVMState.field_define, 0), Or(EqualTo(set_obj_t, JSType.OBJECT), EqualTo(set_obj_t, JSType.FUNCTION))) ThenBlock: {
                    sk_buf2 = JSVMCallBuf.getter_buf
                    SetByte(sk_buf2, 0, 95)
                    SetByte(sk_buf2, 1, 95)
                    SetByte(sk_buf2, 2, 115)
                    SetByte(sk_buf2, 3, 101)
                    SetByte(sk_buf2, 4, 116)
                    SetByte(sk_buf2, 5, 95)
                    JSVMTmp.idx = 0
                    JSVMTmp.done = 0
                    WhileLoop EqualTo(JSVMTmp.done, 0) {
                        JSVMTmp.type = GetByte(JSVMTmp.ptr, JSVMTmp.idx)
                        SetByte(sk_buf2, Add(6, JSVMTmp.idx), JSVMTmp.type)
                        IfCondition EqualTo(JSVMTmp.type, 0) ThenBlock: {
                            JSVMTmp.done = 1
                        }
                        JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                    }
                    // ObjGet may clobber temps — save obj/val across call
                    JSRT__Push(JSVMTmp.addr)
                    JSRT__Push(JSVMTmp.val)
                    setter_func = JSRT_ObjGet(JSVMTmp.addr, sk_buf2)
                    JSVMTmp.val = JSRT__Pop()
                    JSVMTmp.addr = JSRT__Pop()
                    st = JSRT_GetType(setter_func)
                    IfCondition EqualTo(st, JSType.FUNCTION) ThenBlock: {
                        // Bind this = receiver; call setter(value); restore this
                        save_this_s = JSVM__GetGlobal("this")
                        JSVM__SetGlobal("this", JSVMTmp.addr)
                        arg_buf_s = JSVMCallBuf.buf
                        StoreValue(arg_buf_s, JSVMTmp.val)
                        JSVM__CallFunc(setter_func, arg_buf_s, 1)
                        JSVM__SetGlobal("this", save_this_s)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                        ReturnValue(1)
                    }
                    // M26k/k.10: private getter-only (mangled #name@id)
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        IfCondition EqualTo(JSVM__IsMangledPrivate(JSVMTmp.ptr), 1) ThenBlock: {
                            IfCondition EqualTo(JSVMState.private_init, 0) ThenBlock: {
                                gk_only = JSVMCallBuf.getter_buf
                                SetByte(gk_only, 0, 95)
                                SetByte(gk_only, 1, 95)
                                SetByte(gk_only, 2, 103)
                                SetByte(gk_only, 3, 101)
                                SetByte(gk_only, 4, 116)
                                SetByte(gk_only, 5, 95)
                                gi2 = 0
                                gdone2 = 0
                                WhileLoop EqualTo(gdone2, 0) {
                                    gb2 = GetByte(JSVMTmp.ptr, gi2)
                                    SetByte(gk_only, Add(6, gi2), gb2)
                                    IfCondition EqualTo(gb2, 0) ThenBlock: { gdone2 = 1 }
                                    gi2 = Add(gi2, 1)
                                }
                                IfCondition NotEqual(JSRT_ObjHasOnChain(JSVMTmp.addr, gk_only), 0) ThenBlock: {
                                    terr = JSVM_CreateTypedError("TypeError", "Cannot write private getter-only member")
                                    JSVM_ThrowValue(terr)
                                    ReturnValue(1)
                                }
                            }
                        }
                    }
                }

                // M29e: array.length = N — ToUint32 check + truncate/grow
                IfCondition EqualTo(set_obj_t, JSType.ARRAY) ThenBlock: {
                    is_alen_set = 0
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        IfCondition EqualTo(GetByte(JSVMTmp.ptr, 0), 108) ThenBlock: {
                            IfCondition EqualTo(GetByte(JSVMTmp.ptr, 1), 101) ThenBlock: {
                                IfCondition EqualTo(GetByte(JSVMTmp.ptr, 2), 110) ThenBlock: {
                                    IfCondition EqualTo(GetByte(JSVMTmp.ptr, 3), 103) ThenBlock: {
                                        IfCondition EqualTo(GetByte(JSVMTmp.ptr, 4), 116) ThenBlock: {
                                            IfCondition EqualTo(GetByte(JSVMTmp.ptr, 5), 104) ThenBlock: {
                                                IfCondition EqualTo(GetByte(JSVMTmp.ptr, 6), 0) ThenBlock: {
                                                    is_alen_set = 1
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(is_alen_set, 1) ThenBlock: {
                        // Save arr — ToNumber/Create clobber JSVMTmp
                        alen_arr = JSVMTmp.addr
                        // ToNumber returns IEEE float bits (not host int)
                        n_bits = JSRT_ToNumber(JSVMTmp.val)
                        bad_len = 0
                        // n < 0
                        IfCondition EqualTo(Float_Lt(n_bits, Float_FromInt(0)), 1) ThenBlock: {
                            bad_len = 1
                        }
                        // n >= 2^32
                        IfCondition EqualTo(Float_Lt(n_bits, Float_FromInt(4294967296)), 0) ThenBlock: {
                            bad_len = 1
                        }
                        ni_len = Float_ToInt(n_bits)
                        // fractional: Float_FromInt(trunc) != n
                        IfCondition EqualTo(Float_Eq(Float_FromInt(ni_len), n_bits), 0) ThenBlock: {
                            bad_len = 1
                        }
                        IfCondition EqualTo(bad_len, 1) ThenBlock: {
                            terr = JSVM_CreateTypedError("RangeError", "Invalid array length")
                            JSVM_ThrowValue(terr)
                            ReturnValue(1)
                        }
                        JSRT_ArrSetLen(alen_arr, ni_len)
                        ReturnValue(1)
                    }
                }

                // M48: SetFunctionName — function.name is !W C; ordinary assign
                // fails CanAssign. SetFunctionName uses [[DefineOwnProperty]].
                // Allow define-style write for function "name" (PropTable override).
                IfCondition EqualTo(set_obj_t, JSType.FUNCTION) ThenBlock: {
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        is_nm = 0
                        IfCondition EqualTo(JSRT_StrEq(JSVMTmp.ptr, "name"), 1) ThenBlock: {
                            is_nm = 1
                        }
                        IfCondition EqualTo(is_nm, 1) ThenBlock: {
                            JSRT_FuncPropSet(JSVMTmp.addr, JSVMTmp.ptr, JSVMTmp.val)
                            ReturnValue(1)
                        }
                    }
                }

                JSVMTmp.result = JSBridge_SetProp(JSVMTmp.addr, JSVMTmp.ptr, JSVMTmp.val)
                IfCondition EqualTo(JSVMTmp.result, 0) ThenBlock: {
                    // Wave 2: honor writable / freeze / non-extensible
                    can = JSBridge_CanAssign(JSVMTmp.addr, JSVMTmp.ptr)
                    IfCondition EqualTo(can, 1) ThenBlock: {
                        JSRT_ObjSet(JSVMTmp.addr, JSVMTmp.ptr, JSVMTmp.val)
                        // M26k.11: stamp home object on methods (private brand checks)
                        IfCondition EqualTo(JSRT_GetType(JSVMTmp.val), JSType.FUNCTION) ThenBlock: {
                            IfCondition EqualTo(JSRT_GetType(JSVMTmp.addr), JSType.OBJECT) ThenBlock: {
                                JSRT_FuncPropSet(JSVMTmp.val, "__home_proto__", JSVMTmp.addr)
                            }
                            IfCondition EqualTo(JSRT_GetType(JSVMTmp.addr), JSType.FUNCTION) ThenBlock: {
                                JSRT_FuncPropSet(JSVMTmp.val, "__home_proto__", JSVMTmp.addr)
                            }
                        }
                        // Mapped arguments via SET_PROP (arguments[0] compiled as prop sometimes)
                        // Only sync if writing the *current* frame's arguments (nested calls rebind).
                        IfCondition EqualTo(JSVM_IsArgumentsObj(JSVMTmp.addr), 1) ThenBlock: {
                            k0 = GetByte(JSVMTmp.ptr, 0)
                            IfCondition And(GreaterEqual(k0, 48), LessThan(k0, 58)) ThenBlock: {
                                k1 = GetByte(JSVMTmp.ptr, 1)
                                IfCondition EqualTo(k1, 0) ThenBlock: {
                                    // M102: always sync formals (avoid pointer-eq IfCurrent miss)
                                    JSVM_SyncArgumentsToLocal(Subtract(k0, 48), JSVMTmp.val)
                                }
                            }
                        }
                        // M49: function props — object methods W|E|C; class methods W|!E|C.
                        // Class proto has own "constructor"; statics live on FUNCTION.
                        IfCondition EqualTo(JSRT_GetType(JSVMTmp.val), JSType.FUNCTION) ThenBlock: {
                            abits_m = JSAttr.DEFAULT
                            IfCondition EqualTo(JSRT_GetType(JSVMTmp.addr), JSType.FUNCTION) ThenBlock: {
                                abits_m = 5
                            } ElseBlock: {
                                IfCondition EqualTo(JSRT_ObjHas(JSVMTmp.addr, "constructor"), 1) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrEq(JSVMTmp.ptr, "constructor"), 0) ThenBlock: {
                                        abits_m = 5
                                    }
                                }
                            }
                            JSBridge__SetAttrBits(JSVMTmp.addr, JSVMTmp.ptr, abits_m)
                        }
                    } ElseBlock: {
                        // Wave 3: strict mode — assign to non-writable throws TypeError
                        IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                            terr = JSVM_CreateTypedError("TypeError", "Cannot assign to non-writable property")
                            JSVM_ThrowValue(terr)
                            ReturnValue(1)
                        }
                    }
                }
                // M78: private methods — Function.name is "#desc" (not mangled @brand)
                // Runs after either SetProp path so both install routes set name.
                IfCondition EqualTo(JSRT_GetType(JSVMTmp.val), JSType.FUNCTION) ThenBlock: {
                    IfCondition And(NotEqual(JSVMTmp.ptr, 0), EqualTo(JSVM__IsMangledPrivate(JSVMTmp.ptr), 1)) ThenBlock: {
                        pn_len = 0
                        pndone = 0
                        WhileLoop EqualTo(pndone, 0) {
                            pnb = GetByte(JSVMTmp.ptr, pn_len)
                            IfCondition Or(EqualTo(pnb, 0), EqualTo(pnb, 64)) ThenBlock: {
                                pndone = 1
                            } ElseBlock: {
                                pn_len = Add(pn_len, 1)
                                IfCondition GreaterThan(pn_len, 200) ThenBlock: { pndone = 1 }
                            }
                        }
                        IfCondition GreaterThan(pn_len, 0) ThenBlock: {
                            pn_copy = JSRT__StrSlabAlloc(Add(pn_len, 1))
                            IfCondition NotEqual(pn_copy, 0) ThenBlock: {
                                MemoryCopy(pn_copy, JSVMTmp.ptr, pn_len)
                                SetByte(pn_copy, pn_len, 0)
                                pn_str = JSRT_CreateString(pn_copy)
                                JSRT_FuncPropSet(JSVMTmp.val, "name", pn_str)
                            }
                        }
                    }
                }
                ReturnValue(1)
            }

            // GET_ELEM (18) — pop index, pop array/string, push elem
            Case 18: {
                idx_val = JSVM__StackPop()
                arr_val = JSVM__StackPop()
                JSVMTmp.type = JSRT_GetType(arr_val)
                // Wave 3 D1: null/undefined base → TypeError
                IfCondition Or(EqualTo(JSVMTmp.type, JSType.NULL), EqualTo(JSVMTmp.type, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot read property of null/undefined")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                IfCondition EqualTo(JSVMTmp.type, JSType.STRING) ThenBlock: {
                    // String indexing: return single code unit (M31a UTF-16)
                    idx_num = Float_ToInt(JSRT_ToNumber(idx_val))
                    JSVMTmp.ptr = JSRT_GetPayload(arr_val)
                    sl_idx = JSRT_StrLen(JSVMTmp.ptr)
                    IfCondition And(GreaterEqual(idx_num, 0), LessThan(idx_num, sl_idx)) ThenBlock: {
                        elem = JSRT_CreateStringSlice(JSVMTmp.ptr, idx_num, 1)
                        JSVM__StackPush(elem)
                        ReturnValue(1)
                    }
                    JSVM__StackPush(JSRT_Undefined())
                    ReturnValue(1)
                }
                // M37: FUNCTION is object-like for indexed props (array methods on callables)
                IfCondition Or(EqualTo(JSVMTmp.type, JSType.OBJECT), EqualTo(JSVMTmp.type, JSType.FUNCTION)) ThenBlock: {
                    // Object/Function property access — ToPropertyKey (Symbol → @@sN)
                    JSVMTmp.ptr = JSVM_ToPropertyKey(idx_val)
                    // M19d: toString/valueOf throw during ToPropertyKey
                    IfCondition EqualTo(JSVMTmp.ptr, 0) ThenBlock: {
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend = JSVMCall.thrown_val
                            IfCondition EqualTo(pend, 0) ThenBlock: {
                                pend = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVMCall.thrown_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition NotEqual(pend, 0) ThenBlock: {
                                IfCondition NotEqual(pend, JSRTState.undef_val) ThenBlock: {
                                    JSVM_ThrowValue(pend)
                                }
                            }
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                    // Mole 16 / M33: invoke getter __get_<key> if present (UTF-16-safe)
                    gk_buf = JSVMCallBuf.getter_buf
                    nlen_ak = JSRT_StrLen(JSVMTmp.ptr)
                    IfCondition LessThan(nlen_ak, 100) ThenBlock: {
                        SetByte(gk_buf, 0, 95)
                        SetByte(gk_buf, 1, 95)
                        SetByte(gk_buf, 2, 103)
                        SetByte(gk_buf, 3, 101)
                        SetByte(gk_buf, 4, 116)
                        SetByte(gk_buf, 5, 95)
                        gi = 0
                        WhileLoop LessThan(gi, nlen_ak) {
                            u = JSRT_StrUnit(JSVMTmp.ptr, gi)
                            IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                            SetByte(gk_buf, Add(6, gi), u)
                            gi = Add(gi, 1)
                        }
                        SetByte(gk_buf, Add(6, nlen_ak), 0)
                        JSRT__Push(arr_val)
                        JSRT__Push(JSVMTmp.ptr)
                        getter_fn = JSRT_ObjGet(arr_val, gk_buf)
                        JSVMTmp.ptr = JSRT__Pop()
                        arr_val = JSRT__Pop()
                        IfCondition EqualTo(JSRT_GetType(getter_fn), JSType.FUNCTION) ThenBlock: {
                            JSVM__SetGlobal("this", arr_val)
                            empty_g = JSVMCallBuf.buf
                            elem = JSVM__CallFunc(getter_fn, empty_g, 0)
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                ReturnValue(1)
                            }
                            JSVM__StackPush(elem)
                            ReturnValue(1)
                        }
                    }
                    elem = JSRT_ObjGet(arr_val, JSVMTmp.ptr)
                    JSVM__StackPush(elem)
                    ReturnValue(1)
                }
                // ARRAY (Mole 16): Symbol / non-index named props via ObjGet+proto;
                // numeric indices: accessor (__get_N) then ArrGet.
                IfCondition EqualTo(JSVMTmp.type, JSType.ARRAY) ThenBlock: {
                    IfCondition EqualTo(JSVM_IsSymbol(idx_val), 1) ThenBlock: {
                        JSVMTmp.ptr = JSVM_ToPropertyKey(idx_val)
                        elem = JSRT_ObjGet(arr_val, JSVMTmp.ptr)
                        JSVM__StackPush(elem)
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSRT_GetType(idx_val), JSType.STRING) ThenBlock: {
                        JSVMTmp.ptr = JSRT_GetPayload(idx_val)
                        c0 = GetByte(JSVMTmp.ptr, 0)
                        // empty or non-digit start → named property (e.g. "values")
                        IfCondition Or(EqualTo(c0, 0), Or(LessThan(c0, 48), GreaterThan(c0, 57))) ThenBlock: {
                            elem = JSRT_ObjGet(arr_val, JSVMTmp.ptr)
                            JSVM__StackPush(elem)
                            ReturnValue(1)
                        }
                    }
                    // M33: index accessor via __get_<key> (defineProperty data→accessor)
                    // Keys may be UTF-16 — use StrUnit like defineProperty, not GetByte.
                    JSVMTmp.ptr = JSVM_ToPropertyKey(idx_val)
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        gk_buf = JSVMCallBuf.getter_buf
                        nlen_ak = JSRT_StrLen(JSVMTmp.ptr)
                        IfCondition LessThan(nlen_ak, 100) ThenBlock: {
                            SetByte(gk_buf, 0, 95)
                            SetByte(gk_buf, 1, 95)
                            SetByte(gk_buf, 2, 103)
                            SetByte(gk_buf, 3, 101)
                            SetByte(gk_buf, 4, 116)
                            SetByte(gk_buf, 5, 95)
                            gi = 0
                            WhileLoop LessThan(gi, nlen_ak) {
                                u = JSRT_StrUnit(JSVMTmp.ptr, gi)
                                IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                                SetByte(gk_buf, Add(6, gi), u)
                                gi = Add(gi, 1)
                            }
                            SetByte(gk_buf, Add(6, nlen_ak), 0)
                            JSRT__Push(arr_val)
                            JSRT__Push(JSVMTmp.ptr)
                            getter_fn = JSRT_ObjGet(arr_val, gk_buf)
                            JSVMTmp.ptr = JSRT__Pop()
                            arr_val = JSRT__Pop()
                            IfCondition EqualTo(JSRT_GetType(getter_fn), JSType.FUNCTION) ThenBlock: {
                                JSVM__SetGlobal("this", arr_val)
                                empty_g = JSVMCallBuf.buf
                                elem = JSVM__CallFunc(getter_fn, empty_g, 0)
                                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                    ReturnValue(1)
                                }
                                JSVM__StackPush(elem)
                                ReturnValue(1)
                            }
                            // own setter-only: no getter → undefined
                            SetByte(gk_buf, 2, 115)
                            SetByte(gk_buf, 3, 101)
                            SetByte(gk_buf, 4, 116)
                            // still __set_ — mid three chars; prefix __ and trailing name ok
                            SetByte(gk_buf, 0, 95)
                            SetByte(gk_buf, 1, 95)
                            SetByte(gk_buf, 2, 115)
                            SetByte(gk_buf, 3, 101)
                            SetByte(gk_buf, 4, 116)
                            SetByte(gk_buf, 5, 95)
                            gi = 0
                            WhileLoop LessThan(gi, nlen_ak) {
                                u = JSRT_StrUnit(JSVMTmp.ptr, gi)
                                IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                                SetByte(gk_buf, Add(6, gi), u)
                                gi = Add(gi, 1)
                            }
                            SetByte(gk_buf, Add(6, nlen_ak), 0)
                            JSRT__Push(arr_val)
                            has_set_only = JSRT_ObjHas(arr_val, gk_buf)
                            arr_val = JSRT__Pop()
                            IfCondition EqualTo(has_set_only, 1) ThenBlock: {
                                JSVM__StackPush(JSRT_Undefined())
                                ReturnValue(1)
                            }
                        }
                    }
                    // M43: own element, else inherited index on [[Prototype]]
                    idx_num = Float_ToInt(JSRT_ToNumber(idx_val))
                    IfCondition EqualTo(JSRT_ArrHas(arr_val, idx_num), 1) ThenBlock: {
                        elem = JSRT_ArrGet(arr_val, idx_num)
                        JSVM__StackPush(elem)
                        ReturnValue(1)
                    }
                    kptr_ge = JSRT__IntToStr(idx_num)
                    // Walk prototype: default Array.prototype, then its chain
                    proto_ge = JSRTState.array_proto
                    hops_ge = 0
                    found_ge = 0
                    WhileLoop And(And(NotEqual(proto_ge, 0), EqualTo(found_ge, 0)), LessThan(hops_ge, 64)) {
                        hops_ge = Add(hops_ge, 1)
                        pt_ge = JSRT_GetType(proto_ge)
                        IfCondition EqualTo(pt_ge, JSType.ARRAY) ThenBlock: {
                            IfCondition EqualTo(JSRT_ArrHas(proto_ge, idx_num), 1) ThenBlock: {
                                elem = JSRT_ArrGet(proto_ge, idx_num)
                                found_ge = 1
                            }
                        }
                        IfCondition EqualTo(found_ge, 0) ThenBlock: {
                            IfCondition EqualTo(JSRT_ObjHas(proto_ge, kptr_ge), 1) ThenBlock: {
                                elem = JSRT_ObjGet(proto_ge, kptr_ge)
                                found_ge = 1
                            }
                        }
                        IfCondition EqualTo(found_ge, 0) ThenBlock: {
                            nxt = JSRT_ObjGet(proto_ge, "__proto__")
                            nt = JSRT_GetType(nxt)
                            IfCondition Or(Or(EqualTo(nt, JSType.OBJECT), EqualTo(nt, JSType.ARRAY)), EqualTo(nt, JSType.FUNCTION)) ThenBlock: {
                                proto_ge = nxt
                            } ElseBlock: {
                                proto_ge = 0
                            }
                        }
                    }
                    IfCondition EqualTo(found_ge, 1) ThenBlock: {
                        JSVM__StackPush(elem)
                        ReturnValue(1)
                    }
                    JSVM__StackPush(JSRT_Undefined())
                    ReturnValue(1)
                }
                idx_num = Float_ToInt(JSRT_ToNumber(idx_val))
                elem = JSRT_ArrGet(arr_val, idx_num)
                JSVM__StackPush(elem)
                ReturnValue(1)
            }

            // SET_ELEM (19) — pop index, pop array/object, pop value
            // Stack: [..., value, array, index]
            Case 19: {
                idx_val = JSVM__StackPop()
                arr_val = JSVM__StackPop()
                sval = JSVM__StackPop()
                se_type = JSRT_GetType(arr_val)
                // Wave 3 D1: null/undefined base → TypeError
                IfCondition Or(EqualTo(se_type, JSType.NULL), EqualTo(se_type, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot set property of null/undefined")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                // M37: FUNCTION is object-like for indexed props (fn[0]=x for array-likes)
                IfCondition Or(EqualTo(se_type, JSType.OBJECT), EqualTo(se_type, JSType.FUNCTION)) ThenBlock: {
                    // Object/Function — ToPropertyKey once (do NOT also ToNumber first:
                    // that double-invokes toString and fails S11.13.1_A7_T4)
                    idx_num = -1
                    JSVMTmp.ptr = JSVM_ToPropertyKey(idx_val)
                    IfCondition EqualTo(JSVMTmp.ptr, 0) ThenBlock: {
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend = JSVMCall.thrown_val
                            IfCondition EqualTo(pend, 0) ThenBlock: {
                                pend = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVMCall.thrown_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition NotEqual(pend, 0) ThenBlock: {
                                IfCondition NotEqual(pend, JSRTState.undef_val) ThenBlock: {
                                    JSVM_ThrowValue(pend)
                                }
                            }
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                    // Numeric index from key string for arguments sync only
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        c0s = GetByte(JSVMTmp.ptr, 0)
                        IfCondition And(GreaterEqual(c0s, 48), LessEqual(c0s, 57)) ThenBlock: {
                            idx_num = Float_ToInt(JSRT_ToNumber(JSRT_CreateString(JSVMTmp.ptr)))
                        }
                    }
                    // Mole 16 / M33: invoke setter __set_<key> if present (UTF-16-safe)
                    sk_buf = JSVMCallBuf.getter_buf
                    nlen_ak = 0
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        nlen_ak = JSRT_StrLen(JSVMTmp.ptr)
                    }
                    IfCondition LessThan(nlen_ak, 100) ThenBlock: {
                        SetByte(sk_buf, 0, 95)
                        SetByte(sk_buf, 1, 95)
                        SetByte(sk_buf, 2, 115)
                        SetByte(sk_buf, 3, 101)
                        SetByte(sk_buf, 4, 116)
                        SetByte(sk_buf, 5, 95)
                        si = 0
                        WhileLoop LessThan(si, nlen_ak) {
                            u = JSRT_StrUnit(JSVMTmp.ptr, si)
                            IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                            SetByte(sk_buf, Add(6, si), u)
                            si = Add(si, 1)
                        }
                        SetByte(sk_buf, Add(6, nlen_ak), 0)
                        JSRT__Push(arr_val)
                        JSRT__Push(sval)
                        JSRT__Push(JSVMTmp.ptr)
                        setter_fn = JSRT_ObjGet(arr_val, sk_buf)
                        JSVMTmp.ptr = JSRT__Pop()
                        sval = JSRT__Pop()
                        arr_val = JSRT__Pop()
                        IfCondition EqualTo(JSRT_GetType(setter_fn), JSType.FUNCTION) ThenBlock: {
                            JSVM__SetGlobal("this", arr_val)
                            arg_buf_s = JSVMCallBuf.buf
                            StoreValue(arg_buf_s, sval)
                            JSVM__CallFunc(setter_fn, arg_buf_s, 1)
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                ReturnValue(1)
                            }
                            ReturnValue(1)
                        }
                    }
                    // Wave 2 / Mole 12: honor writable / freeze
                    can_se = JSBridge_CanAssign(arr_val, JSVMTmp.ptr)
                    IfCondition EqualTo(can_se, 0) ThenBlock: {
                        IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                            terr = JSVM_CreateTypedError("TypeError", "Cannot assign to non-writable property")
                            JSVM_ThrowValue(terr)
                            ReturnValue(1)
                        }
                        ReturnValue(1)
                    }
                    JSRT_ObjSet(arr_val, JSVMTmp.ptr, sval)
                    // M102: mapped arguments[i] → formal local
                    IfCondition EqualTo(JSVM_IsArgumentsObj(arr_val), 1) ThenBlock: {
                        sync_idx = idx_num
                        // Fallback: numeric index value (ToPropertyKey may be UTF-16)
                        IfCondition LessThan(sync_idx, 0) ThenBlock: {
                            IfCondition EqualTo(JSRT_GetType(idx_val), JSType.NUMBER) ThenBlock: {
                                sync_idx = Float_ToInt(JSRT_GetPayload(idx_val))
                            }
                        }
                        IfCondition GreaterEqual(sync_idx, 0) ThenBlock: {
                            JSVM_SyncArgumentsToLocal(sync_idx, sval)
                        }
                    }
                    ReturnValue(1)
                }
                // ARRAY (Mole 16): Symbol / non-index named props → side table ObjSet
                IfCondition EqualTo(se_type, JSType.ARRAY) ThenBlock: {
                    IfCondition EqualTo(JSVM_IsSymbol(idx_val), 1) ThenBlock: {
                        JSVMTmp.ptr = JSVM_ToPropertyKey(idx_val)
                        JSRT_ObjSet(arr_val, JSVMTmp.ptr, sval)
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSRT_GetType(idx_val), JSType.STRING) ThenBlock: {
                        JSVMTmp.ptr = JSRT_GetPayload(idx_val)
                        c0 = GetByte(JSVMTmp.ptr, 0)
                        IfCondition Or(EqualTo(c0, 0), Or(LessThan(c0, 48), GreaterThan(c0, 57))) ThenBlock: {
                            // M29e: arr["length"] = N
                            is_alen_se = 0
                            IfCondition EqualTo(c0, 108) ThenBlock: {
                                IfCondition EqualTo(GetByte(JSVMTmp.ptr, 1), 101) ThenBlock: {
                                    IfCondition EqualTo(GetByte(JSVMTmp.ptr, 2), 110) ThenBlock: {
                                        IfCondition EqualTo(GetByte(JSVMTmp.ptr, 3), 103) ThenBlock: {
                                            IfCondition EqualTo(GetByte(JSVMTmp.ptr, 4), 116) ThenBlock: {
                                                IfCondition EqualTo(GetByte(JSVMTmp.ptr, 5), 104) ThenBlock: {
                                                    IfCondition EqualTo(GetByte(JSVMTmp.ptr, 6), 0) ThenBlock: {
                                                        is_alen_se = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            IfCondition EqualTo(is_alen_se, 1) ThenBlock: {
                                n_bits = JSRT_ToNumber(sval)
                                bad_len = 0
                                IfCondition EqualTo(Float_Lt(n_bits, Float_FromInt(0)), 1) ThenBlock: {
                                    bad_len = 1
                                }
                                IfCondition EqualTo(Float_Lt(n_bits, Float_FromInt(4294967296)), 0) ThenBlock: {
                                    bad_len = 1
                                }
                                ni_len = Float_ToInt(n_bits)
                                IfCondition EqualTo(Float_Eq(Float_FromInt(ni_len), n_bits), 0) ThenBlock: {
                                    bad_len = 1
                                }
                                IfCondition EqualTo(bad_len, 1) ThenBlock: {
                                    terr = JSVM_CreateTypedError("RangeError", "Invalid array length")
                                    JSVM_ThrowValue(terr)
                                    ReturnValue(1)
                                }
                                JSRT_ArrSetLen(arr_val, ni_len)
                                ReturnValue(1)
                            }
                            JSRT_ObjSet(arr_val, JSVMTmp.ptr, sval)
                            ReturnValue(1)
                        }
                    }
                    // M33: index accessor via __set_<key> before ArrSet (UTF-16-safe)
                    JSVMTmp.ptr = JSVM_ToPropertyKey(idx_val)
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        gk_buf = JSVMCallBuf.getter_buf
                        nlen_ak = JSRT_StrLen(JSVMTmp.ptr)
                        IfCondition LessThan(nlen_ak, 100) ThenBlock: {
                            SetByte(gk_buf, 0, 95)
                            SetByte(gk_buf, 1, 95)
                            SetByte(gk_buf, 2, 115)
                            SetByte(gk_buf, 3, 101)
                            SetByte(gk_buf, 4, 116)
                            SetByte(gk_buf, 5, 95)
                            gi = 0
                            WhileLoop LessThan(gi, nlen_ak) {
                                u = JSRT_StrUnit(JSVMTmp.ptr, gi)
                                IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                                SetByte(gk_buf, Add(6, gi), u)
                                gi = Add(gi, 1)
                            }
                            SetByte(gk_buf, Add(6, nlen_ak), 0)
                            JSRT__Push(arr_val)
                            JSRT__Push(sval)
                            JSRT__Push(JSVMTmp.ptr)
                            setter_fn = JSRT_ObjGet(arr_val, gk_buf)
                            JSVMTmp.ptr = JSRT__Pop()
                            sval = JSRT__Pop()
                            arr_val = JSRT__Pop()
                            IfCondition EqualTo(JSRT_GetType(setter_fn), JSType.FUNCTION) ThenBlock: {
                                JSVM__SetGlobal("this", arr_val)
                                ab = JSVMCallBuf.buf
                                StoreValue(ab, sval)
                                JSVM__CallFunc(setter_fn, ab, 1)
                                ReturnValue(1)
                            }
                            // getter-only: silent no-op in non-strict
                            SetByte(gk_buf, 0, 95)
                            SetByte(gk_buf, 1, 95)
                            SetByte(gk_buf, 2, 103)
                            SetByte(gk_buf, 3, 101)
                            SetByte(gk_buf, 4, 116)
                            SetByte(gk_buf, 5, 95)
                            gi = 0
                            WhileLoop LessThan(gi, nlen_ak) {
                                u = JSRT_StrUnit(JSVMTmp.ptr, gi)
                                IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                                SetByte(gk_buf, Add(6, gi), u)
                                gi = Add(gi, 1)
                            }
                            SetByte(gk_buf, Add(6, nlen_ak), 0)
                            JSRT__Push(arr_val)
                            JSRT__Push(sval)
                            has_get_only = JSRT_ObjHas(arr_val, gk_buf)
                            sval = JSRT__Pop()
                            arr_val = JSRT__Pop()
                            IfCondition EqualTo(has_get_only, 1) ThenBlock: {
                                ReturnValue(1)
                            }
                        }
                    }
                }
                idx_num = Float_ToInt(JSRT_ToNumber(idx_val))
                JSRT_ArrSet(arr_val, idx_num, sval)
                ReturnValue(1)
            }

            // ADD (20) — pop b, pop a, push JSRT_Add(a, b)
            Case 20: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Add(av, bv)
                // M81: ToString/ToPrimitive throw already at catch — do not push
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    JSVMCall.exc_prop = 0
                    ReturnValue(1)
                }
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // SUB (21)
            Case 21: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Sub(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // MUL (22)
            Case 22: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Mul(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // DIV (23)
            Case 23: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Div(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // MOD (24)
            Case 24: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Mod(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // NEG (25) — negate top of stack
            Case 25: {
                av = JSVM__StackPop()
                result = JSRT_Neg(av)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // EXP (26) — exponentiation (**)
            Case 26: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Exp(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // EQ (30) — abstract equality
            Case 30: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_AbstractEqual(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // NEQ (31) — abstract inequality
            Case 31: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_AbstractEqual(av, bv)
                IfCondition EqualTo(cmp_int, 0) ThenBlock: {
                    JSVM__StackPush(JSRT_True())
                } ElseBlock: {
                    JSVM__StackPush(JSRT_False())
                }
                ReturnValue(1)
            }

            // LT (32)
            Case 32: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_LessThan(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // GT (33)
            Case 33: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_GreaterThan(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // LTE (34)
            Case 34: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_LessEqual(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // GTE (35)
            Case 35: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_GreaterEqual(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // STRICT_EQ (36)
            Case 36: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_StrictEqual(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // STRICT_NEQ (37)
            Case 37: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_StrictEqual(av, bv)
                IfCondition EqualTo(cmp_int, 0) ThenBlock: {
                    JSVM__StackPush(JSRT_True())
                } ElseBlock: {
                    JSVM__StackPush(JSRT_False())
                }
                ReturnValue(1)
            }

            // NOT (40) — logical not
            Case 40: {
                av = JSVM__StackPop()
                result = JSRT_Not(av)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // BIT_AND (41)
            Case 41: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_BitAnd(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // BIT_OR (42)
            Case 42: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_BitOr(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // BIT_XOR (43)
            Case 43: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_BitXor(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // BIT_NOT (44)
            Case 44: {
                av = JSVM__StackPop()
                result = JSRT_BitNot(av)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // SHL (45)
            Case 45: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Shl(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // SHR (46)
            Case 46: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Shr(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // USHR (48) — unsigned right shift >>>
            Case 48: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Ushr(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // INSTANCEOF (49)
            Case 49: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Instanceof(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // IN (38) — key in obj (HasProperty: own + [[Prototype]])
            Case 38: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                // M80: ToPropertyKey (Symbol → @@sN); not ToString
                JSRT__Push(bv)
                key_ptr = JSVM_ToPropertyKey(av)
                bv = JSRT__Pop()
                IfCondition EqualTo(key_ptr, 0) ThenBlock: {
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        pend = JSVMCall.thrown_val
                        IfCondition EqualTo(pend, 0) ThenBlock: {
                            pend = JSVM__GetGlobal("__pend_exc__")
                        }
                        JSVMCall.thrown_val = 0
                        JSVMCall.exc_prop = 0
                        IfCondition NotEqual(pend, 0) ThenBlock: {
                            IfCondition NotEqual(pend, JSRTState.undef_val) ThenBlock: {
                                JSVM_ThrowValue(pend)
                            }
                        }
                        ReturnValue(1)
                    }
                    JSVM__StackPush(JSRT_False())
                    ReturnValue(1)
                }
                // M43: was own-only ObjHas — broke `1 in arr` with Array.prototype[1]
                has = JSRT_ObjHasOnChain(bv, key_ptr)
                IfCondition EqualTo(has, 1) ThenBlock: {
                    JSVM__StackPush(JSRT_True())
                } ElseBlock: {
                    JSVM__StackPush(JSRT_False())
                }
                ReturnValue(1)
            }

            // DELETE_PROP (39) — stack: [obj, key] → delete obj[key], push boolean
            // Body lives in JSVM_OpDeleteProp (Case locals blow Ailang frames).
            Case 39: {
                JSVM_OpDeleteProp()
                ReturnValue(1)
            }

            // TYPEOF (47)
            Case 47: {
                av = JSVM__StackPop()
                result = JSRT_TypeOf(av)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // JMP (50) — unconditional jump, 16-bit target address
            Case 50: {
                target = JSVM__Read16()
                JSVMState.pc = target
                ReturnValue(1)
            }

            // JMP_FALSE (51) — pop value, jump if falsy
            Case 51: {
                target = JSVM__Read16()
                av = JSVM__StackPop()
                truth = JSRT_IsTruthy(av)
                IfCondition EqualTo(truth, 0) ThenBlock: {
                    JSVMState.pc = target
                }
                ReturnValue(1)
            }

            // JMP_TRUE (52) — pop value, jump if truthy
            Case 52: {
                target = JSVM__Read16()
                av = JSVM__StackPop()
                truth = JSRT_IsTruthy(av)
                IfCondition EqualTo(truth, 1) ThenBlock: {
                    JSVMState.pc = target
                }
                ReturnValue(1)
            }

            // JMP_NULLISH (53) — for ??: stack [..., L, L] after DUP
            // Pop top. If NOT nullish: jump (leave one L on stack).
            // If nullish: fall through without re-push (next POP clears L).
            Case 53: {
                target = JSVM__Read16()
                av = JSVM__StackPop()
                is_nullish = 0
                IfCondition EqualTo(av, 0) ThenBlock: {
                    is_nullish = 1
                }
                IfCondition NotEqual(av, 0) ThenBlock: {
                    vtype = Dereference(av)
                    IfCondition Or(EqualTo(vtype, 0), EqualTo(vtype, 1)) ThenBlock: {
                        is_nullish = 1
                    }
                }
                IfCondition EqualTo(is_nullish, 0) ThenBlock: {
                    // Non-nullish: leave remaining DUP copy on stack, skip RHS
                    JSVMState.pc = target
                }
                // Nullish: do not re-push; fall through to POP + RHS
                ReturnValue(1)
            }

            // JMP_IF_NULLISH (54) — peek value, jump if IS null/undefined
            // Used by optional chaining: skip RHS if LHS is nullish
            // If nullish: pop value, push undefined, jump to target
            // If not nullish: leave value on stack, fall through
            Case 54: {
                target = JSVM__Read16()
                av = JSVM__StackPop()
                is_nullish = 0
                IfCondition EqualTo(av, 0) ThenBlock: {
                    is_nullish = 1
                }
                IfCondition NotEqual(av, 0) ThenBlock: {
                    vtype = Dereference(av)
                    IfCondition Or(EqualTo(vtype, 0), EqualTo(vtype, 1)) ThenBlock: {
                        // UNDEFINED(0) or NULL(1)
                        is_nullish = 1
                    }
                }
                IfCondition EqualTo(is_nullish, 1) ThenBlock: {
                    // Push undefined and jump
                    JSVM__StackPush(JSRT_Undefined())
                    JSVMState.pc = target
                }
                IfCondition EqualTo(is_nullish, 0) ThenBlock: {
                    // Not nullish — push value back and fall through
                    JSVM__StackPush(av)
                }
                ReturnValue(1)
            }

            // TRY_PUSH (70) — push exception handler
            // 16-bit operand: catch handler address
            // Entry layout (32 bytes): catch_addr, saved_sp, saved_fp, saved_env
            // M128e: saved_env restores with ObjectEnv chain on throw (WITH_POP skipped).
            Case 70: {
                catch_addr = JSVM__Read16()
                IfCondition LessThan(JSVMState.exc_sp, 16) ThenBlock: {
                    ebase = Add(JSVMState.exc_stack, Multiply(JSVMState.exc_sp, 32))
                    StoreValue(ebase, catch_addr)
                    StoreValue(Add(ebase, 8), JSVMState.sp)
                    // Wave 3: save frame pointer so cross-function throw restores catch frame
                    StoreValue(Add(ebase, 16), JSVMState.fp)
                    // Snapshot lexical/with env at try entry
                    StoreValue(Add(ebase, 24), JSVM__GetCurEnv())
                    JSVMState.exc_sp = Add(JSVMState.exc_sp, 1)
                }
                ReturnValue(1)
            }

            // TRY_POP (71) — remove topmost exception handler
            Case 71: {
                IfCondition GreaterThan(JSVMState.exc_sp, 0) ThenBlock: {
                    JSVMState.exc_sp = Subtract(JSVMState.exc_sp, 1)
                }
                ReturnValue(1)
            }

            // THROW (72) — throw exception
            // Pop thrown value, unwind call frames + stack to catch handler, push value
            Case 72: {
                thrown = JSVM__StackPop()
                // M56: return-completion after finally (force_return) → complete with value
                // If finally throws a different value, that exception wins.
                IfCondition EqualTo(JSVMGen.is_gen_exec, 1) ThenBlock: {
                    IfCondition EqualTo(JSVMGen.force_return, 1) ThenBlock: {
                        IfCondition EqualTo(thrown, JSVMGen.force_return_val) ThenBlock: {
                            // More outer finallys?
                            IfCondition GreaterThan(JSVMState.exc_sp, 0) ThenBlock: {
                                JSVMState.exc_sp = Subtract(JSVMState.exc_sp, 1)
                                ebase = Add(JSVMState.exc_stack, Multiply(JSVMState.exc_sp, 32))
                                catch_addr = Dereference(ebase)
                                saved_sp = Dereference(Add(ebase, 8))
                                saved_fp = Dereference(Add(ebase, 16))
                                IfCondition LessThan(saved_sp, 0) ThenBlock: { saved_sp = 0 }
                                IfCondition LessThan(saved_fp, 0) ThenBlock: { saved_fp = 0 }
                                JSVMState.fp = saved_fp
                                JSVMState.sp = saved_sp
                                JSVM__StackPush(JSVMGen.force_return_val)
                                JSVMState.pc = catch_addr
                                ReturnValue(1)
                            }
                            // Done: return completion
                            ret_done = JSVMGen.force_return_val
                            JSVMGen.force_return = 0
                            JSVMGen.force_return_val = 0
                            gs_thr = JSVMGen.active_gs
                            IfCondition NotEqual(gs_thr, 0) ThenBlock: {
                                StoreValue(gs_thr, JSGenConst.ST_COMPLETED)
                                StoreValue(Add(gs_thr, JSGenConst.OFF_PEND_RET), 0)
                            }
                            JSVMState.pc = JSVMGen.caller_pc
                            JSVMState.sp = JSVMGen.caller_sp
                            JSVMState.fp = JSVMGen.caller_fp
                            c_stk = Multiply(JSVMGen.caller_sp, 8)
                            IfCondition GreaterThan(c_stk, 0) ThenBlock: {
                                MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, c_stk)
                            }
                            c_frm = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
                            IfCondition GreaterThan(c_frm, 0) ThenBlock: {
                                MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, c_frm)
                            }
                            JSVMGen.active_gs = 0
                            JSVMGen.is_gen_exec = 0
                            iter_result = JSRT_CreateIterResult(ret_done, 1)
                            JSVM__StackPush(iter_result)
                            ReturnValue(1)
                        }
                        // finally threw something else — clear force_return and propagate
                        JSVMGen.force_return = 0
                        JSVMGen.force_return_val = 0
                    }
                    // try/catch inside generator: dispatch to handlers if any
                    IfCondition LessEqual(JSVMState.exc_sp, 0) ThenBlock: {
                        // M128e6m: THROW inside CallFunc (@@iterator factory, getters)
                        // while gen is executing must NOT unwind to GenNext caller —
                        // that corrupted CallFunc restore and looped .then on the
                        // rejected async-gen next() promise (dstr get-err hang).
                        // Surface as exc_prop so CallFunc/GET_ITER rethrow into gen.
                        IfCondition Or(GreaterThan(JSVMCall.depth, 0), GreaterThan(JSVMCall.no_async_rej, 0)) ThenBlock: {
                            JSVMCall.exc_prop = 1
                            JSVMCall.thrown_val = thrown
                            JSVMState.exc_val = thrown
                            JSVM__SetGlobal("__pend_exc__", thrown)
                            JSVMState.error = 1
                            JSVMState.halted = 1
                            ReturnValue(1)
                        }
                        gs_thr = JSVMGen.active_gs
                        IfCondition NotEqual(gs_thr, 0) ThenBlock: {
                            StoreValue(gs_thr, JSGenConst.ST_COMPLETED)
                        }
                        JSVMState.pc = JSVMGen.caller_pc
                        JSVMState.sp = JSVMGen.caller_sp
                        JSVMState.fp = JSVMGen.caller_fp
                        c_stk = Multiply(JSVMGen.caller_sp, 8)
                        IfCondition GreaterThan(c_stk, 0) ThenBlock: {
                            MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, c_stk)
                        }
                        c_frm = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
                        IfCondition GreaterThan(c_frm, 0) ThenBlock: {
                            MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, c_frm)
                        }
                        JSVMGen.active_gs = 0
                        JSVMGen.is_gen_exec = 0
                        JSVMState.exc_val = thrown
                        JSVMCall.thrown_val = thrown
                        JSVMCall.exc_prop = 1
                        JSVM__SetGlobal("__pend_exc__", thrown)
                        JSVMState.halted = 1
                        JSVMState.error = 0
                        ReturnValue(1)
                    }
                    // else fall through to normal handler dispatch below
                }
                IfCondition GreaterThan(JSVMState.exc_sp, 0) ThenBlock: {
                    JSVMState.exc_sp = Subtract(JSVMState.exc_sp, 1)
                    ebase = Add(JSVMState.exc_stack, Multiply(JSVMState.exc_sp, 32))
                    catch_addr = Dereference(ebase)
                    saved_sp = Dereference(Add(ebase, 8))
                    saved_fp = Dereference(Add(ebase, 16))
                    saved_env_t = Dereference(Add(ebase, 24))
                    IfCondition LessThan(saved_sp, 0) ThenBlock: { saved_sp = 0 }
                    IfCondition GreaterThan(saved_sp, JSVMConst.MAX_STACK) ThenBlock: { saved_sp = JSVMConst.MAX_STACK }
                    IfCondition LessThan(saved_fp, 0) ThenBlock: { saved_fp = 0 }
                    IfCondition GreaterThan(saved_fp, JSVMConst.MAX_FRAMES) ThenBlock: { saved_fp = JSVMConst.MAX_FRAMES }
                    JSVMState.fp = saved_fp
                    JSVMState.sp = saved_sp
                    // M128e: restore with/lex env (WITH_POP skipped on throw)
                    IfCondition And(NotEqual(saved_env_t, 0), NotEqual(saved_env_t, JSRTState.undef_val)) ThenBlock: {
                        JSVM__SetCurEnv(saved_env_t)
                    }
                    JSVM__StackPush(thrown)
                    JSVMState.pc = catch_addr
                } ElseBlock: {
                    // M128e6l: IteratorClose GetMethod sets no_async_rej so a
                    // return-getter throw surfaces as exc_prop (kind=1 keeps the
                    // body throw). Do not key off CallFunc.depth alone — GET_ITER
                    // @@iterator throws must still async-reject.
                    IfCondition GreaterThan(JSVMCall.no_async_rej, 0) ThenBlock: {
                        JSVMCall.exc_prop = 1
                        JSVMCall.thrown_val = thrown
                        JSVMState.exc_val = thrown
                        JSVM__SetGlobal("__pend_exc__", thrown)
                        JSVMState.error = 1
                        JSVMState.halted = 1
                        ReturnValue(1)
                    }
                    // M93: uncaught throw inside async function → rejected Promise
                    // Walk frames for -65 async mark (param defaults / body throws).
                    async_rej_done = 0
                    WhileLoop And(EqualTo(async_rej_done, 0), GreaterThan(JSVMState.fp, 0)) {
                        fi_ar = Subtract(JSVMState.fp, 1)
                        fa_ar = Add(JSVMState.frames, Multiply(fi_ar, JSVMConst.FRAME_SIZE))
                        mark_ar = Dereference(Add(fa_ar, 40))
                        IfCondition EqualTo(mark_ar, -65) ThenBlock: {
                            // Rejected promise with thrown value
                            rej_p = JSBridge__CreatePromise(2, thrown)
                            restore_fi_ar = fi_ar
                            frame_ar = JSVM__PopFrame()
                            IfCondition NotEqual(frame_ar, 0) ThenBlock: {
                                JSVMState.is_strict = Dereference(Add(frame_ar, 72))
                                JSVM__LeaveFuncCode()
                                JSVM__RestoreArguments(restore_fi_ar)
                                IfCondition NotEqual(JSVMClosure.frame_has_saved_this, 0) ThenBlock: {
                                    IfCondition EqualTo(Dereference(Add(JSVMClosure.frame_has_saved_this, Multiply(restore_fi_ar, 8))), 1) ThenBlock: {
                                        prev_th_ar = Dereference(Add(JSVMClosure.frame_saved_this, Multiply(restore_fi_ar, 8)))
                                        JSVM__SetGlobal("this", prev_th_ar)
                                        StoreValue(Add(JSVMClosure.frame_has_saved_this, Multiply(restore_fi_ar, 8)), 0)
                                        StoreValue(Add(JSVMClosure.frame_saved_this, Multiply(restore_fi_ar, 8)), 0)
                                    }
                                }
                                save_ret_pc_ar = Dereference(frame_ar)
                                save_ret_sp_ar = Dereference(Add(frame_ar, 8))
                                JSVMState.pc = save_ret_pc_ar
                                JSVMState.sp = save_ret_sp_ar
                            }
                            JSVM__StackPush(rej_p)
                            JSVMState.error = 0
                            JSVMState.halted = 0
                            JSVMState.exc_val = 0
                            async_rej_done = 1
                        } ElseBlock: {
                            // Abandon non-async frame and keep looking for async
                            restore_fi_ar2 = fi_ar
                            frame_ar2 = JSVM__PopFrame()
                            IfCondition NotEqual(frame_ar2, 0) ThenBlock: {
                                JSVMState.is_strict = Dereference(Add(frame_ar2, 72))
                                JSVM__LeaveFuncCode()
                                JSVM__RestoreArguments(restore_fi_ar2)
                            }
                        }
                    }
                    IfCondition EqualTo(async_rej_done, 0) ThenBlock: {
                        JSVMState.exc_val = thrown
                        JSVMState.error = 1
                        JSVMState.halted = 1
                    }
                }
                ReturnValue(1)
            }

            // CALL (55) — 1-byte operand: argc
            // Stack: [..., func, arg0, arg1, ..., argN-1]
            Case 55: {
                argc = JSVM__ReadByte()

                // Use static arg buffer (no per-call allocation)
                arg_buf = JSVMCallBuf.buf

                ai = Subtract(argc, 1)
                WhileLoop GreaterEqual(ai, 0) {
                    arg_v = JSVM__StackPop()
                    StoreValue(Add(arg_buf, Multiply(ai, 8)), arg_v)
                    ai = Subtract(ai, 1)
                }

                // Pop function value
                func_val = JSVM__StackPop()
                ft = JSRT_GetType(func_val)
                // M35: Object/Promise-style host objects with __ctor__ are callable
                // Keep bag identity for SuperCall match (extends Object stores bag on __super__).
                super_bag = 0
                IfCondition EqualTo(ft, JSType.OBJECT) ThenBlock: {
                    ctor_fn = JSRT_ObjGet(func_val, "__ctor__")
                    IfCondition EqualTo(JSRT_GetType(ctor_fn), JSType.FUNCTION) ThenBlock: {
                        super_bag = func_val
                        func_val = ctor_fn
                        ft = JSType.FUNCTION
                    }
                }
                IfCondition NotEqual(ft, JSType.FUNCTION) ThenBlock: {
                    // Wave 3 D1: call non-callable → TypeError
                    terr = JSVM_CreateTypedError("TypeError", "is not a function")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }

                // M26e: SuperCall if caller derived
                is_super_call = 0
                caller_st = 0
                caller_fi = 0
                IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                    caller_fi = Subtract(JSVMState.fp, 1)
                    IfCondition NotEqual(JSVMClosure.frame_this_st, 0) ThenBlock: {
                        caller_st = Dereference(Add(JSVMClosure.frame_this_st, Multiply(caller_fi, 8)))
                    }
                }
                is_sup_target = 0
                IfCondition Or(EqualTo(caller_st, 1), EqualTo(caller_st, 2)) ThenBlock: {
                    fdesc_cc0 = JSRT_GetPayload(func_val)
                    is_cc0 = 0
                    IfCondition NotEqual(fdesc_cc0, 0) ThenBlock: {
                        is_cc0 = Dereference(Add(fdesc_cc0, 88))
                    }
                    // Class parent SuperCall
                    IfCondition NotEqual(is_cc0, 0) ThenBlock: {
                        is_sup_target = 1
                    }
                    // Non-class parent: match __super__ bag or unwrapped __ctor__ (extends Object)
                    IfCondition EqualTo(is_sup_target, 0) ThenBlock: {
                        IfCondition NotEqual(JSVMClosure.frame_funcs, 0) ThenBlock: {
                            cfn = Dereference(Add(JSVMClosure.frame_funcs, Multiply(caller_fi, 8)))
                            IfCondition EqualTo(JSRT_GetType(cfn), JSType.FUNCTION) ThenBlock: {
                                csup = JSRT_FuncPropGet(cfn, "__super__")
                                IfCondition EqualTo(csup, func_val) ThenBlock: {
                                    is_sup_target = 1
                                }
                                IfCondition EqualTo(is_sup_target, 0) ThenBlock: {
                                    IfCondition And(NotEqual(super_bag, 0), EqualTo(csup, super_bag)) ThenBlock: {
                                        is_sup_target = 1
                                    }
                                }
                                IfCondition EqualTo(is_sup_target, 0) ThenBlock: {
                                    IfCondition EqualTo(JSRT_GetType(csup), JSType.OBJECT) ThenBlock: {
                                        csup_ctor = JSRT_ObjGet(csup, "__ctor__")
                                        IfCondition EqualTo(csup_ctor, func_val) ThenBlock: {
                                            is_sup_target = 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(is_sup_target, 0) ThenBlock: {
                        gsup = JSVM__GetGlobal("__super__")
                        IfCondition EqualTo(gsup, func_val) ThenBlock: {
                            is_sup_target = 1
                        }
                        IfCondition EqualTo(is_sup_target, 0) ThenBlock: {
                            IfCondition And(NotEqual(super_bag, 0), EqualTo(gsup, super_bag)) ThenBlock: {
                                is_sup_target = 1
                            }
                        }
                        IfCondition EqualTo(is_sup_target, 0) ThenBlock: {
                            IfCondition EqualTo(JSRT_GetType(gsup), JSType.OBJECT) ThenBlock: {
                                gsup_ctor = JSRT_ObjGet(gsup, "__ctor__")
                                IfCondition EqualTo(gsup_ctor, func_val) ThenBlock: {
                                    is_sup_target = 1
                                }
                            }
                        }
                    }
                }
                IfCondition EqualTo(is_sup_target, 1) ThenBlock: {
                    IfCondition EqualTo(caller_st, 1) ThenBlock: {
                        // Walk frames for construct this_obj (skip SuperCall marks -2/-3)
                        der_this = 0
                        wfi = caller_fi
                        WhileLoop And(GreaterEqual(wfi, 0), EqualTo(der_this, 0)) {
                            wfa = Add(JSVMState.frames, Multiply(wfi, JSVMConst.FRAME_SIZE))
                            wth = Dereference(Add(wfa, 40))
                            IfCondition NotEqual(wth, 0) ThenBlock: {
                                IfCondition NotEqual(wth, -2) ThenBlock: {
                                    IfCondition NotEqual(wth, -3) ThenBlock: {
                                        IfCondition NotEqual(wth, -65) ThenBlock: {
                                            der_this = wth
                                        }
                                    }
                                }
                            }
                            wfi = Subtract(wfi, 1)
                        }
                        // Derived intermediate SuperCall: leave this TDZ
                        IfCondition EqualTo(is_cc0, 2) ThenBlock: {
                            IfCondition NotEqual(JSVMClosure.this_uninit, 0) ThenBlock: {
                                JSVM__SetGlobal("this", JSVMClosure.this_uninit)
                            }
                            JSVMState.this_tdz = 1
                        } ElseBlock: {
                            IfCondition NotEqual(der_this, 0) ThenBlock: {
                                JSVM__SetGlobal("this", der_this)
                                JSVMState.this_tdz = 0
                            }
                        }
                        is_super_call = 1
                    }
                    IfCondition EqualTo(caller_st, 2) ThenBlock: {
                        is_super_call = 2
                    }
                }
                IfCondition EqualTo(is_super_call, 0) ThenBlock: {
                    fdesc_cc = JSRT_GetPayload(func_val)
                    IfCondition NotEqual(fdesc_cc, 0) ThenBlock: {
                        is_cc = Dereference(Add(fdesc_cc, 88))
                        // 1=base class, 2=derived class only — 4=method (callable, not constructible)
                        IfCondition Or(EqualTo(is_cc, 1), EqualTo(is_cc, 2)) ThenBlock: {
                            terr = JSVM_CreateTypedError("TypeError", "Class constructor cannot be invoked without new")
                            JSVM_ThrowValue(terr)
                            ReturnValue(1)
                        }
                    }
                }

                // M26h: ordinary call → new.target undefined; SuperCall keeps outer NewTarget
                IfCondition EqualTo(is_super_call, 0) ThenBlock: {
                    JSVM__SetGlobal("__new_target__", JSRTState.undef_val)
                }

                // Check if this is a native function
                func_bc = JSRT_FuncGetBC(func_val)
                IfCondition LessThan(func_bc, 0) ThenBlock: {
                    // Native function call — dispatch through JSRuntime or JSBridge
                    handler_id = Subtract(-1, func_bc)

                    // Generator .next() — handler_id = 9998 (bc = -9999)
                    IfCondition EqualTo(handler_id, 9998) ThenBlock: {
                        gen_result = JSVM__GenNext(func_val, arg_buf, argc)
                        // Mole 15: body throw → abrupt .next() completion
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pendg = JSVMCall.thrown_val
                            IfCondition EqualTo(pendg, 0) ThenBlock: {
                                pendg = JSVMState.exc_val
                            }
                            IfCondition EqualTo(pendg, 0) ThenBlock: {
                                pendg = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVMCall.thrown_val = 0
                            JSVMState.exc_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition EqualTo(pendg, 0) ThenBlock: {
                                pendg = JSVM_CreateTypedError("TypeError", "generator threw")
                            }
                            JSVM_ThrowValue(pendg)
                            ReturnValue(1)
                        }
                        JSVM__StackPush(gen_result)
                        ReturnValue(1)
                    }
                    // Generator .return() — handler_id = 9997 (bc = -9998)
                    IfCondition EqualTo(handler_id, 9997) ThenBlock: {
                        gen_result = JSVM__GenReturn(func_val, arg_buf, argc)
                        // IteratorClose abrupt from return() → rethrow
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pendr = JSVMCall.thrown_val
                            IfCondition EqualTo(pendr, 0) ThenBlock: {
                                pendr = JSVMState.exc_val
                            }
                            IfCondition EqualTo(pendr, 0) ThenBlock: {
                                pendr = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVMCall.thrown_val = 0
                            JSVMState.exc_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition EqualTo(pendr, 0) ThenBlock: {
                                pendr = JSVM_CreateTypedError("TypeError", "generator return abrupt")
                            }
                            JSVM_ThrowValue(pendr)
                            ReturnValue(1)
                        }
                        JSVM__StackPush(gen_result)
                        ReturnValue(1)
                    }
                    // Generator .throw() — handler_id = 9996 (bc = -9997)
                    IfCondition EqualTo(handler_id, 9996) ThenBlock: {
                        gen_result = JSVM__GenThrow(func_val, arg_buf, argc)
                        // (static arg_buf — no dealloc needed)
                        JSVM__StackPush(gen_result)
                        ReturnValue(1)
                    }

                    // Function.prototype bound (FUNC_BOUND=198) — JSBridge native, not JSRT
                    IfCondition EqualTo(handler_id, 198) ThenBlock: {
                        brec = JSRT_FuncGetEnv(func_val)
                        JSVM__SetGlobal("__bound_rec__", brec)
                        native_result = JSBridge_Dispatch(handler_id, arg_buf, argc)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend_b = JSVMCall.thrown_val
                            IfCondition EqualTo(pend_b, 0) ThenBlock: {
                                pend_b = JSVM__GetGlobal("__pend_exc__")
                            }
                            IfCondition NotEqual(pend_b, 0) ThenBlock: {
                                IfCondition NotEqual(pend_b, JSRTState.undef_val) ThenBlock: {
                                    JSVM__StackPush(pend_b)
                                }
                            }
                            JSVMCall.exc_prop = 0
                            JSVMCall.thrown_val = 0
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }

                    // eval() — handler_id = 193 (JSNativeID.EVAL)
                    // CALL path is always indirect eval (is_direct=0), even when
                    // invoked from inside an outer direct eval.
                    IfCondition EqualTo(handler_id, 193) ThenBlock: {
                        ev_saved_direct = JSVMEvalState.is_direct
                        JSVMEvalState.is_direct = 0
                        native_result = JSVM_EvalNative(arg_buf, argc)
                        JSVMEvalState.is_direct = ev_saved_direct
                        // M71: EvalDeclarationInstantiation SyntaxError (var/let)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend_ev = JSVMCall.thrown_val
                            IfCondition EqualTo(pend_ev, 0) ThenBlock: {
                                pend_ev = JSVMState.exc_val
                            }
                            JSVMCall.thrown_val = 0
                            JSVMState.exc_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition EqualTo(pend_ev, 0) ThenBlock: {
                                pend_ev = JSVM_CreateTypedError("SyntaxError", "eval error")
                            }
                            JSVM_ThrowValue(pend_ev)
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }

                    // Symbol() — handler_id = 194
                    IfCondition EqualTo(handler_id, 194) ThenBlock: {
                        native_result = JSVM_SymbolNative(arg_buf, argc)
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }

                    // M81: Function(...args) — handler_id = 272 (JSNativeID.FUNC_CTOR)
                    // Match CallNative: if ToString/body throw already hit catch via
                    // CallFunc, do not re-ThrowValue (would clobber catch frame).
                    IfCondition EqualTo(handler_id, 272) ThenBlock: {
                        native_result = JSVM_FunctionNative(arg_buf, argc)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend_fn = JSVMCall.thrown_val
                            IfCondition EqualTo(pend_fn, 0) ThenBlock: {
                                pend_fn = JSVMState.exc_val
                            }
                            IfCondition EqualTo(pend_fn, 0) ThenBlock: {
                                pend_fn = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVMCall.thrown_val = 0
                            JSVMState.exc_val = 0
                            JSVMCall.exc_prop = 0
                            // If catch already received the value (ThrowValue in CallFunc),
                            // stack has it. If uncaught pending, push for outer rethrow path.
                            IfCondition And(NotEqual(pend_fn, 0), NotEqual(pend_fn, JSRTState.undef_val)) ThenBlock: {
                                // Only push if not already at catch with value —
                                // CallNative-style: leave stack, just return.
                            }
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }

                    // Handler IDs 57-61, 77-78, 211-215: Promise methods
                    is_prom = 0
                    IfCondition GreaterEqual(handler_id, 57) ThenBlock: {
                        IfCondition LessEqual(handler_id, 61) ThenBlock: { is_prom = 1 }
                    }
                    IfCondition GreaterEqual(handler_id, 77) ThenBlock: {
                        IfCondition LessEqual(handler_id, 78) ThenBlock: { is_prom = 1 }
                    }
                    IfCondition GreaterEqual(handler_id, 211) ThenBlock: {
                        IfCondition LessEqual(handler_id, 215) ThenBlock: { is_prom = 1 }
                    }
                    IfCondition EqualTo(is_prom, 1) ThenBlock: {
                        promise_recv = JSRT_FuncGetEnv(func_val)
                        native_result = JSBridge__DispatchPromise(handler_id, promise_recv, arg_buf, argc)
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }

                    // Handler IDs 83-87, 216-224: RegExp methods + getters
                    is_rx = 0
                    IfCondition GreaterEqual(handler_id, 83) ThenBlock: {
                        IfCondition LessEqual(handler_id, 87) ThenBlock: { is_rx = 1 }
                    }
                    // M111: RegExp IDs are 216-228 + 231 only (not 229-230/232-233)
                    IfCondition GreaterEqual(handler_id, 216) ThenBlock: {
                        IfCondition LessEqual(handler_id, 228) ThenBlock: { is_rx = 1 }
                    }
                    IfCondition EqualTo(handler_id, 231) ThenBlock: { is_rx = 1 }
                    IfCondition EqualTo(is_rx, 1) ThenBlock: {
                        rx_recv = JSRT_FuncGetEnv(func_val)
                        IfCondition GreaterEqual(handler_id, 216) ThenBlock: {
                            th = JSVM__GetGlobal("this")
                            IfCondition And(NotEqual(JSRT_GetType(th), JSType.NULL), NotEqual(JSRT_GetType(th), JSType.UNDEFINED)) ThenBlock: {
                                rx_recv = th
                            }
                        }
                        native_result = JSVM__DispatchRegExpMethod(handler_id, rx_recv, arg_buf, argc)
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }

                    // Handler IDs 62-76, 97-99, 150-171, 180-191: String/Array/JSON methods (env = receiver)
                    is_str_method = 0
                    IfCondition GreaterEqual(handler_id, 62) ThenBlock: {
                        IfCondition LessEqual(handler_id, 76) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition Or(Or(EqualTo(handler_id, 229), EqualTo(handler_id, 230)), Or(EqualTo(handler_id, 232), EqualTo(handler_id, 233))) ThenBlock: { is_str_method = 1 }
                    IfCondition GreaterEqual(handler_id, 97) ThenBlock: {
                        IfCondition LessEqual(handler_id, 99) ThenBlock: { is_str_method = 1 }
                    }
                    // 150-171 array methods; 174 reduceRight; skip 172-173 (values/iterator → Bridge)
                    IfCondition GreaterEqual(handler_id, 150) ThenBlock: {
                        IfCondition LessEqual(handler_id, 171) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition EqualTo(handler_id, 174) ThenBlock: { is_str_method = 1 }
                    // M29h: 208-210 copyWithin/findLast/findLastIndex
                    IfCondition GreaterEqual(handler_id, 208) ThenBlock: {
                        IfCondition LessEqual(handler_id, 210) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition GreaterEqual(handler_id, 180) ThenBlock: {
                        IfCondition LessEqual(handler_id, 186) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition EqualTo(is_str_method, 1) ThenBlock: {
                        str_recv = JSRT_FuncGetEnv(func_val)
                        // M35: prefer global this for ALL string/array methods so
                        // obj.method = String.prototype.slice; obj.method() uses obj,
                        // and Array.prototype.map.call(arrayLike) still works.
                        th_am = JSVM__GetGlobal("this")
                        tht_am = JSRT_GetType(th_am)
                        IfCondition And(NotEqual(tht_am, JSType.NULL), NotEqual(tht_am, JSType.UNDEFINED)) ThenBlock: {
                            str_recv = th_am
                        }
                        native_result = JSVM__DispatchStringMethod(handler_id, str_recv, arg_buf, argc)
                        // M29d: array methods may TypeError (null this / non-callable callback)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                        // M26j Array: SuperCall into Array ctor (76) completes this-init
                        IfCondition EqualTo(is_super_call, 2) ThenBlock: {
                            JSVM_ThrowReferenceError("Super constructor may only be called once")
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(is_super_call, 1) ThenBlock: {
                            nrt = JSRT_GetType(native_result)
                            IfCondition Or(EqualTo(nrt, JSType.OBJECT), EqualTo(nrt, JSType.ARRAY)) ThenBlock: {
                                JSVM__SetGlobal("this", native_result)
                            }
                            JSVMState.this_tdz = 0
                            IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                                IfCondition NotEqual(JSVMClosure.frame_this_st, 0) ThenBlock: {
                                    cfi = Subtract(JSVMState.fp, 1)
                                    StoreValue(Add(JSVMClosure.frame_this_st, Multiply(cfi, 8)), 2)
                                }

                            // M26k.9: derived fields after SuperCall this-init
                            der_ctor = Dereference(Add(JSVMClosure.frame_funcs, Multiply(Subtract(JSVMState.fp, 1), 8)))
                            fi_inst = JSVM__GetGlobal("this")
                            IfCondition EqualTo(JSVM__RunFieldInitForCtor(fi_inst, der_ctor), 1) ThenBlock: {
                                ReturnValue(1)
                            }
                            }
                        }
                        // (static arg_buf — no dealloc needed)
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }

                    // Handler IDs 0-21: JSRuntime built-ins (0-14 math/type, 15-21 Error ctors)
                    // Handler IDs 22+: JSBridge DOM/timer natives (incl. OBJ_CTOR 88)
                    IfCondition GreaterEqual(handler_id, 22) ThenBlock: {
                        native_result = JSBridge_Dispatch(handler_id, arg_buf, argc)
                        // ThrowValue from native sets exc_prop + catch pc/sp — don't
                        // push the native return value (would cover the thrown err).
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend_n = JSVMCall.thrown_val
                            IfCondition EqualTo(pend_n, 0) ThenBlock: {
                                pend_n = JSVM__GetGlobal("__pend_exc__")
                            }
                            IfCondition NotEqual(pend_n, 0) ThenBlock: {
                                IfCondition NotEqual(pend_n, JSRTState.undef_val) ThenBlock: {
                                    JSVM__StackPush(pend_n)
                                }
                            }
                            JSVMCall.exc_prop = 0
                            JSVMCall.thrown_val = 0
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                        // M128: SuperCall into Bridge natives (Object/Promise/…) this-init
                        // (mirror CALL_SPREAD; Array 76 already handled above)
                        IfCondition EqualTo(is_super_call, 2) ThenBlock: {
                            JSVM_ThrowReferenceError("Super constructor may only be called once")
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(is_super_call, 1) ThenBlock: {
                            nrt = JSRT_GetType(native_result)
                            IfCondition Or(EqualTo(nrt, JSType.OBJECT), EqualTo(nrt, JSType.ARRAY)) ThenBlock: {
                                JSVM__SetGlobal("this", native_result)
                            }
                            // Object(value) with no args may return empty object — keep der_this
                            IfCondition And(NotEqual(nrt, JSType.OBJECT), NotEqual(nrt, JSType.ARRAY)) ThenBlock: {
                                // leave this as SuperCall-bound receiver (already set above path)
                            }
                            JSVMState.this_tdz = 0
                            IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                                IfCondition NotEqual(JSVMClosure.frame_this_st, 0) ThenBlock: {
                                    cfi = Subtract(JSVMState.fp, 1)
                                    StoreValue(Add(JSVMClosure.frame_this_st, Multiply(cfi, 8)), 2)
                                }
                                der_ctor = Dereference(Add(JSVMClosure.frame_funcs, Multiply(Subtract(JSVMState.fp, 1), 8)))
                                fi_inst = JSVM__GetGlobal("this")
                                IfCondition EqualTo(JSVM__RunFieldInitForCtor(fi_inst, der_ctor), 1) ThenBlock: {
                                    ReturnValue(1)
                                }
                            }
                        }
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }
                    native_result = JSRT_CallNative(handler_id, arg_buf, argc)
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        JSVMCall.exc_prop = 0
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    // M26j: SuperCall into native (Error/Array/...) completes this-init
                    IfCondition EqualTo(is_super_call, 2) ThenBlock: {
                        JSVM_ThrowReferenceError("Super constructor may only be called once")
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(is_super_call, 1) ThenBlock: {
                        nrt = JSRT_GetType(native_result)
                        IfCondition Or(EqualTo(nrt, JSType.OBJECT), EqualTo(nrt, JSType.ARRAY)) ThenBlock: {
                            JSVM__SetGlobal("this", native_result)
                        }
                        JSVMState.this_tdz = 0
                        IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                            IfCondition NotEqual(JSVMClosure.frame_this_st, 0) ThenBlock: {
                                cfi = Subtract(JSVMState.fp, 1)
                                StoreValue(Add(JSVMClosure.frame_this_st, Multiply(cfi, 8)), 2)
                            }
                            // M26k.9: derived fields after native SuperCall this-init
                            der_ctor = Dereference(Add(JSVMClosure.frame_funcs, Multiply(Subtract(JSVMState.fp, 1), 8)))
                            fi_inst = JSVM__GetGlobal("this")
                            IfCondition EqualTo(JSVM__RunFieldInitForCtor(fi_inst, der_ctor), 1) ThenBlock: {
                                ReturnValue(1)
                            }
                        }
                    }
                    JSVM__StackPush(native_result)
                    ReturnValue(1)
                }

                // Check if this is a generator function (env == 71 magic)
                func_env = JSRT_FuncGetEnv(func_val)
                IfCondition EqualTo(func_env, 71) ThenBlock: {
                    // M89: bare CALL ThisBinding before CreateGenerator captures this
                    // (ordinary CALL path sets this after this early return — too late)
                    g_params_th = JSRT_FuncGetParams(func_val)
                    IfCondition EqualTo(BitwiseAnd(g_params_th, 268435456), 0) ThenBlock: {
                        IfCondition NotEqual(BitwiseAnd(g_params_th, 536870912), 0) ThenBlock: {
                            JSVM__SetGlobal("this", JSRTState.undef_val)
                        } ElseBlock: {
                            gth_g = JSVM__GetGlobal("globalThis")
                            IfCondition Or(EqualTo(gth_g, 0), EqualTo(JSRT_GetType(gth_g), JSType.UNDEFINED)) ThenBlock: {
                                gth_g = JSVM__GetGlobal("this")
                            }
                            JSVM__SetGlobal("this", gth_g)
                        }
                    }
                    // Generator call — create gen, run FDI (param dstr) now
                    gen_val = JSRT_CreateGenerator(func_val, arg_buf, argc)
                    fdi_ok = JSVM__GenInitParams(gen_val, func_val)
                    IfCondition EqualTo(fdi_ok, 0) ThenBlock: {
                        // Param init threw — rethrow into CALL caller (try/catch)
                        pend_fdi = JSVMCall.thrown_val
                        IfCondition EqualTo(pend_fdi, 0) ThenBlock: {
                            pend_fdi = JSVMState.exc_val
                        }
                        IfCondition EqualTo(pend_fdi, 0) ThenBlock: {
                            pend_fdi = JSVM__GetGlobal("__pend_exc__")
                        }
                        JSVMCall.thrown_val = 0
                        JSVMCall.exc_prop = 0
                        JSVMState.exc_val = 0
                        IfCondition NotEqual(pend_fdi, 0) ThenBlock: {
                            JSVM_ThrowValue(pend_fdi)
                        } ElseBlock: {
                            JSVMState.error = 1
                            JSVMState.halted = 1
                        }
                        ReturnValue(1)
                    }

                    gen_gs = Dereference(Add(gen_val, 8))
                    next_func = JSRT_CreateFunc(-9999, 1, 0, "next")
                    JSRT_FuncSetEnv(next_func, gen_val)

                    ret_func = JSRT_CreateFunc(-9998, 1, 0, "return")
                    JSRT_FuncSetEnv(ret_func, gen_val)

                    throw_func = JSRT_CreateFunc(-9997, 1, 0, "throw")
                    JSRT_FuncSetEnv(throw_func, gen_val)

                    gen_obj = JSRT_CreateObject()
                    // [[Prototype]] = generator function's .prototype
                    gen_proto = JSRT_ObjGet(func_val, "prototype")
                    IfCondition EqualTo(JSRT_GetType(gen_proto), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(gen_obj, "__proto__", gen_proto)
                    }
                    JSRT_ObjSet(gen_obj, "next", next_func)
                    JSRT_ObjSet(gen_obj, "return", ret_func)
                    JSRT_ObjSet(gen_obj, "throw", throw_func)
                    JSRT_ObjSet(gen_obj, "__gen__", gen_val)

                    JSVM__StackPush(gen_obj)
                    ReturnValue(1)
                }

                // Async generator function (env == 66) — creates async generator object
                // Same as regular generator, but .next() wraps results in Promises
                IfCondition EqualTo(func_env, 66) ThenBlock: {
                    // M89: bare CALL ThisBinding (same as sync generator path)
                    g_params_th2 = JSRT_FuncGetParams(func_val)
                    IfCondition EqualTo(BitwiseAnd(g_params_th2, 268435456), 0) ThenBlock: {
                        IfCondition NotEqual(BitwiseAnd(g_params_th2, 536870912), 0) ThenBlock: {
                            JSVM__SetGlobal("this", JSRTState.undef_val)
                        } ElseBlock: {
                            gth_g2 = JSVM__GetGlobal("globalThis")
                            IfCondition Or(EqualTo(gth_g2, 0), EqualTo(JSRT_GetType(gth_g2), JSType.UNDEFINED)) ThenBlock: {
                                gth_g2 = JSVM__GetGlobal("this")
                            }
                            JSVM__SetGlobal("this", gth_g2)
                        }
                    }
                    gen_val = JSRT_CreateGenerator(func_val, arg_buf, argc)
                    // Mark generator state block as async (offset 104)
                    ag_gs = JSRT_GetPayload(gen_val)
                    StoreValue(Add(ag_gs, 104), 1)
                    // M94: FDI at call (same as sync gen) — param throws are sync
                    fdi_ok_ag = JSVM__GenInitParams(gen_val, func_val)
                    IfCondition EqualTo(fdi_ok_ag, 0) ThenBlock: {
                        pend_fdi_ag = JSVMCall.thrown_val
                        IfCondition EqualTo(pend_fdi_ag, 0) ThenBlock: {
                            pend_fdi_ag = JSVMState.exc_val
                        }
                        IfCondition EqualTo(pend_fdi_ag, 0) ThenBlock: {
                            pend_fdi_ag = JSVM__GetGlobal("__pend_exc__")
                        }
                        JSVMCall.thrown_val = 0
                        JSVMCall.exc_prop = 0
                        JSVMState.exc_val = 0
                        IfCondition NotEqual(pend_fdi_ag, 0) ThenBlock: {
                            JSVM_ThrowValue(pend_fdi_ag)
                        } ElseBlock: {
                            JSVMState.error = 1
                            JSVMState.halted = 1
                        }
                        ReturnValue(1)
                    }

                    gen_gs = Dereference(Add(gen_val, 8))
                    next_func = JSRT_CreateFunc(-9999, 1, 0, "next")
                    JSRT_FuncSetEnv(next_func, gen_val)

                    ret_func = JSRT_CreateFunc(-9998, 1, 0, "return")
                    JSRT_FuncSetEnv(ret_func, gen_val)

                    throw_func = JSRT_CreateFunc(-9997, 1, 0, "throw")
                    JSRT_FuncSetEnv(throw_func, gen_val)

                    gen_obj = JSRT_CreateObject()
                    gen_proto = JSRT_ObjGet(func_val, "prototype")
                    IfCondition EqualTo(JSRT_GetType(gen_proto), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(gen_obj, "__proto__", gen_proto)
                    }
                    JSRT_ObjSet(gen_obj, "next", next_func)
                    JSRT_ObjSet(gen_obj, "return", ret_func)
                    JSRT_ObjSet(gen_obj, "throw", throw_func)
                    JSRT_ObjSet(gen_obj, "__gen__", gen_val)
                    // Mark as async generator so .next() wraps in Promise
                    JSRT_ObjSet(gen_obj, "__async_gen__", JSRT_CreateNumber(1))

                    JSVM__StackPush(gen_obj)
                    ReturnValue(1)
                }

                // Async function (env == 65) — execute normally, AWAIT handles promise unwrapping
                // No special call handling needed; the function runs eagerly
                // and AWAIT opcode unwraps any promises in-flight.

                // If callee has __super__, set it as global for the callee body.
                // This enables multi-level super() chains.
                JSRT__Push(func_val)
                call_sup = JSRT_FuncPropGet(func_val, "__super__")
                func_val = JSRT__Pop()
                call_sup_t = JSRT_GetType(call_sup)
                IfCondition EqualTo(call_sup_t, JSType.FUNCTION) ThenBlock: {
                    JSVM__SetGlobal("__super__", call_sup)
                }

                // Get function descriptor fields
                func_params = JSRT_FuncGetParams(func_val)
                func_locals = JSRT_FuncGetLocals(func_val)

                // Save current state in a call frame
                save_pc = JSVMState.pc
                save_sp = JSVMState.sp
                locals_base = JSVMState.sp

                pf_ok = JSVM__PushFrame(save_pc, save_sp, locals_base, func_params, func_locals)
                IfCondition LessThan(pf_ok, 0) ThenBlock: {
                    PrintMessage("[JSEngine] call stack overflow (MAX_FRAMES)\n")
                    JSVMState.error = 1
                    ReturnValue(-1)
                }
                JSVM__SetupCallEnv(func_val)

                // Mole 16: per-function strict — save outer, enter if bit 29
                prev_strict = JSVMState.is_strict
                faddr_s = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
                StoreValue(Add(faddr_s, 72), prev_strict)
                IfCondition NotEqual(BitwiseAnd(func_params, 536870912), 0) ThenBlock: {
                    JSVMState.is_strict = 1
                }

                // M69: bare CALL ThisBinding (not SuperCall, not arrow).
                // Strict → undefined; non-strict → globalThis.
                // CALL_METHOD uses its own receiver path; arrows keep lexical this.
                IfCondition EqualTo(is_super_call, 0) ThenBlock: {
                    IfCondition EqualTo(BitwiseAnd(func_params, 268435456), 0) ThenBlock: {
                        call_prev_this = JSVM__GetGlobal("this")
                        fi_th = Subtract(JSVMState.fp, 1)
                        IfCondition NotEqual(JSVMClosure.frame_saved_this, 0) ThenBlock: {
                            StoreValue(Add(JSVMClosure.frame_saved_this, Multiply(fi_th, 8)), call_prev_this)
                            StoreValue(Add(JSVMClosure.frame_has_saved_this, Multiply(fi_th, 8)), 1)
                        }
                        IfCondition NotEqual(BitwiseAnd(func_params, 536870912), 0) ThenBlock: {
                            JSVM__SetGlobal("this", JSRTState.undef_val)
                        } ElseBlock: {
                            gth_call = JSVM__GetGlobal("globalThis")
                            IfCondition Or(EqualTo(gth_call, 0), EqualTo(JSRT_GetType(gth_call), JSType.UNDEFINED)) ThenBlock: {
                                gth_call = call_prev_this
                            }
                            JSVM__SetGlobal("this", gth_call)
                        }
                    }
                }

                // Mark async frames with -65 at offset 40 so RETURN can wrap result
                IfCondition EqualTo(func_env, 65) ThenBlock: {
                    af_addr = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
                    StoreValue(Add(af_addr, 40), -65)
                }
                // M26c/e: SuperCall frame mark — -2 first bind, -3 double (throw after parent)
                IfCondition NotEqual(is_super_call, 0) ThenBlock: {
                    sc_addr = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
                    IfCondition EqualTo(is_super_call, 2) ThenBlock: {
                        StoreValue(Add(sc_addr, 40), -3)
                    } ElseBlock: {
                        StoreValue(Add(sc_addr, 40), -2)
                    }
                    // M26i: SuperCall into derived — UNINIT status for nested super()
                    IfCondition EqualTo(JSVMState.this_tdz, 1) ThenBlock: {
                        fi_u = Subtract(JSVMState.fp, 1)
                        IfCondition NotEqual(JSVMClosure.frame_this_st, 0) ThenBlock: {
                            StoreValue(Add(JSVMClosure.frame_this_st, Multiply(fi_u, 8)), 1)
                        }
                    }
                    // M26k.9: SuperCall uses CALL not CONSTRUCT — when this is bound
                    // (base parent), run that parent's InitializeInstanceFields now.
                    IfCondition And(EqualTo(is_super_call, 1), EqualTo(JSVMState.this_tdz, 0)) ThenBlock: {
                        fi_inst = JSVM__GetGlobal("this")
                        IfCondition EqualTo(JSVM__RunFieldInitForCtor(fi_inst, func_val), 1) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                }

                // Rest params: bit 31 of param_count set by compiler when last
                // formal is "...rest". fixed formals occupy slots 0..rest_idx-1;
                // rest_idx gets an array of arg_buf[rest_idx..argc).
                rest_flag = 0
                rest_idx = -1
                // Bits 30-31 are flags: 31=rest, 30=unmapped args. Clear both for count.
                // 268435455 = 0x0FFFFFFF (bits 0-27 count; 28=arrow, 29=strict, 30=unmapped, 31=rest)
                formal_count = BitwiseAnd(func_params, 268435455)
                // 2147483648 = 1<<31
                IfCondition NotEqual(BitwiseAnd(func_params, 2147483648), 0) ThenBlock: {
                    rest_flag = 1
                    rest_idx = Subtract(formal_count, 1)
                }
                unmapped_bit = BitwiseAnd(func_params, 1073741824)

                // Push locals onto stack
                pi = 0
                WhileLoop LessThan(pi, func_locals) {
                    pushed = 0
                    IfCondition EqualTo(rest_flag, 1) ThenBlock: {
                        IfCondition EqualTo(pi, rest_idx) ThenBlock: {
                            rest_arr = JSRT_CreateArray()
                            ri = rest_idx
                            WhileLoop LessThan(ri, argc) {
                                rval = Dereference(Add(arg_buf, Multiply(ri, 8)))
                                JSRT_ArrPush(rest_arr, rval)
                                ri = Add(ri, 1)
                            }
                            JSVM__StackPush(rest_arr)
                            pushed = 1
                        }
                        IfCondition EqualTo(pushed, 0) ThenBlock: {
                            IfCondition LessThan(pi, rest_idx) ThenBlock: {
                                IfCondition LessThan(pi, argc) ThenBlock: {
                                    pval = Dereference(Add(arg_buf, Multiply(pi, 8)))
                                    JSVM__StackPush(pval)
                                } ElseBlock: {
                                    JSVM__StackPush(JSRT_Undefined())
                                }
                                pushed = 1
                            }
                        }
                    }
                    IfCondition EqualTo(pushed, 0) ThenBlock: {
                        IfCondition LessThan(pi, argc) ThenBlock: {
                            // No rest, or locals past formals that still have args
                            IfCondition EqualTo(rest_flag, 0) ThenBlock: {
                                pval = Dereference(Add(arg_buf, Multiply(pi, 8)))
                                JSVM__StackPush(pval)
                            } ElseBlock: {
                                JSVM__StackPush(JSRT_Undefined())
                            }
                        } ElseBlock: {
                            JSVM__StackPush(JSRT_Undefined())
                        }
                    }
                    pi = Add(pi, 1)
                }

                // M108: named function-expression — fdesc+108 is name_slot+1 (0=none)
                fdesc_ns = JSRT_GetPayload(func_val)
                IfCondition NotEqual(fdesc_ns, 0) ThenBlock: {
                    ns_enc = Dereference(Add(fdesc_ns, 108))
                    IfCondition And(GreaterThan(ns_enc, 0), LessEqual(ns_enc, 512)) ThenBlock: {
                        ns_slot = Subtract(ns_enc, 1)
                        IfCondition LessThan(ns_slot, func_locals) ThenBlock: {
                            StoreValue(Add(JSVMState.stack, Multiply(Add(locals_base, ns_slot), 8)), func_val)
                        }
                    }
                }

                // arguments object — mapped formals + callee (see JSVMArgs)
                // Bit 30 = unmapped (rest/default/dstr) Mole 14
                map_n = formal_count
                IfCondition NotEqual(unmapped_bit, 0) ThenBlock: {
                    map_n = 0
                }
                IfCondition EqualTo(rest_flag, 1) ThenBlock: {
                    // rest formal alone is not mapped
                    IfCondition EqualTo(unmapped_bit, 0) ThenBlock: {
                        map_n = rest_idx
                    }
                }
                IfCondition LessThan(map_n, 0) ThenBlock: { map_n = 0 }
                // Bit 28 = arrow — no own arguments (lexical outer via __cenv)
                IfCondition EqualTo(BitwiseAnd(func_params, 268435456), 0) ThenBlock: {
                    args_obj = JSVM_CreateArguments(arg_buf, argc, func_val, map_n)
                    JSVM__SaveArguments()
                    JSVM__SetGlobal("arguments", args_obj)
                    // M128q: mark globalThis.arguments configurable so RestoreArguments
                    // can delete it (`"arguments" in this` after call must be false).
                    gt_a = GlobalHash_Lookup("globalThis")
                    IfCondition EqualTo(gt_a, -1) ThenBlock: {
                        gt_a = GlobalHash_Lookup("this")
                    }
                    IfCondition NotEqual(gt_a, -1) ThenBlock: {
                        IfCondition EqualTo(JSRT_GetType(gt_a), JSType.OBJECT) ThenBlock: {
                            JSBridge__SetAttrBits(gt_a, JSVMClosure.args_key, 7)
                        }
                    }
                    // Dual-write onto frame env so nested arrows GET_FREE "arguments"
                    IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                        fi_a = Subtract(JSVMState.fp, 1)
                        env_a = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi_a, 8)))
                        IfCondition NotEqual(env_a, 0) ThenBlock: {
                            JSRT_ObjSet(env_a, "arguments", args_obj)
                        }
                    }
                } ElseBlock: {
                    // Snapshot so RETURN RestoreArguments does not wipe outer
                    JSVM__SaveArguments()
                }

                // === JIT CHECK ===
                // If JIT is enabled, try to execute native code instead of interpreting
                IfCondition EqualTo(JITState.enabled, 1) ThenBlock: {
                    jit_native = JIT_Lookup(func_bc)
                    IfCondition EqualTo(jit_native, 0) ThenBlock: {
                        // Not compiled yet — try to compile
                        // code_len: from func_bc to end of bytecode (or next RETURN)
                        jit_code_len = Subtract(JSVMState.code_len, func_bc)
                        jit_native = JIT_Compile(Add(JSVMState.code, func_bc), jit_code_len, func_bc)
                    }
                    IfCondition NotEqual(jit_native, 0) ThenBlock: {
                        // Execute JIT'd code
                        JIT_Execute(jit_native)
                        // JIT code ran the function body and returned.
                        // The JIT's RETURN opcode popped the return value and wrote sp back.
                        // Now we pop the frame and push the return value.
                        jit_ret = JSVM__StackPop()
                        jit_frame = JSVM__PopFrame()
                        IfCondition EqualTo(jit_frame, 0) ThenBlock: {
                            JSVM__StackPush(jit_ret)
                            JSVMState.halted = 1
                            ReturnValue(0)
                        }
                        JSVMState.pc = Dereference(jit_frame)
                        JSVMState.sp = Dereference(Add(jit_frame, 8))
                        JSVM__StackPush(jit_ret)
                        ReturnValue(1)
                    }
                }

                // Jump to function code (interpreter fallback)
                // M81: switch to own code image if this is an eval/Function callable
                JSVM__EnterFuncCode(func_val)
                JSVMState.pc = func_bc
                ReturnValue(1)
            }

            // RETURN (56)
            Case 56: {
                // Pop return value
                ret_val = JSVM__StackPop()

                // Check if we're inside a generator execution
                IfCondition EqualTo(JSVMGen.is_gen_exec, 1) ThenBlock: {
                    // M91: capture frame index before pop so nested CALL can
                    // RestoreArguments (was skipped → gen unmapped args break)
                    restore_fi_g = Subtract(JSVMState.fp, 1)
                    // Pop frame. Mole 17: first-resume PushFrame means base gen
                    // frame is non-null — detect base via fp==0 after pop.
                    frame = JSVM__PopFrame()
                    JSVMState.error = 0
                    IfCondition Or(EqualTo(frame, 0), EqualTo(JSVMState.fp, 0)) ThenBlock: {
                        // Generator base return — mark completed
                        gs = JSVMGen.active_gs
                        IfCondition NotEqual(gs, 0) ThenBlock: {
                            StoreValue(gs, JSGenConst.ST_COMPLETED)
                        }

                        // Restore caller state
                        JSVMState.pc = JSVMGen.caller_pc
                        JSVMState.sp = JSVMGen.caller_sp
                        JSVMState.fp = JSVMGen.caller_fp
                        caller_stk_sz = Multiply(JSVMGen.caller_sp, 8)
                        IfCondition GreaterThan(caller_stk_sz, 0) ThenBlock: {
                            MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, caller_stk_sz)
                        }
                        caller_frm_sz = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
                        IfCondition GreaterThan(caller_frm_sz, 0) ThenBlock: {
                            MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, caller_frm_sz)
                        }

                        JSVMGen.active_gs = 0
                        JSVMGen.is_gen_exec = 0

                        // Return {value: ret_val, done: true}
                        iter_result = JSRT_CreateIterResult(ret_val, 1)
                        JSVM__StackPush(iter_result)
                        ReturnValue(1)
                    }

                    // Not the base frame — normal return within generator body
                    // Mole 15: honor constructor frames (new X() inside gen).
                    // Without this, `throw new Test262Error()` throws undefined
                    // because the ctor returns undefined and we never substitute this.
                    save_gen_pc = Dereference(frame)
                    save_gen_sp = Dereference(Add(frame, 8))
                    gen_ctor_this = Dereference(Add(frame, 40))
                    // M91: mirror ordinary RETURN — strict / this / arguments
                    JSVMState.is_strict = Dereference(Add(frame, 72))
                    JSVM__LeaveFuncCode()
                    JSVM__RestoreArguments(restore_fi_g)
                    IfCondition NotEqual(JSVMClosure.frame_has_saved_this, 0) ThenBlock: {
                        IfCondition EqualTo(Dereference(Add(JSVMClosure.frame_has_saved_this, Multiply(restore_fi_g, 8))), 1) ThenBlock: {
                            prev_th_g = Dereference(Add(JSVMClosure.frame_saved_this, Multiply(restore_fi_g, 8)))
                            JSVM__SetGlobal("this", prev_th_g)
                            StoreValue(Add(JSVMClosure.frame_has_saved_this, Multiply(restore_fi_g, 8)), 0)
                            StoreValue(Add(JSVMClosure.frame_saved_this, Multiply(restore_fi_g, 8)), 0)
                        }
                    }
                    ret_val = JSVM__ReclaimScope(frame, ret_val)
                    IfCondition NotEqual(gen_ctor_this, 0) ThenBlock: {
                        IfCondition NotEqual(gen_ctor_this, -65) ThenBlock: {
                            rv_type_g = JSRT_GetType(ret_val)
                            IfCondition NotEqual(rv_type_g, JSType.OBJECT) ThenBlock: {
                                IfCondition NotEqual(rv_type_g, JSType.ARRAY) ThenBlock: {
                                    IfCondition NotEqual(rv_type_g, JSType.FUNCTION) ThenBlock: {
                                        ret_val = gen_ctor_this
                                    }
                                }
                            }
                        }
                    }
                    JSVMState.pc = save_gen_pc
                    JSVMState.sp = save_gen_sp
                    JSVM__StackPush(ret_val)
                    ReturnValue(1)
                }

                // Pop frame — restore outer `arguments` for the frame we leave
                restore_fi = Subtract(JSVMState.fp, 1)
                frame = JSVM__PopFrame()
                IfCondition EqualTo(frame, 0) ThenBlock: {
                    // No frame to pop — halt
                    JSVM__StackPush(ret_val)
                    JSVMState.halted = 1
                    ReturnValue(0)
                }
                // Mole 16: restore outer is_strict
                JSVMState.is_strict = Dereference(Add(frame, 72))
                // M81: restore code/const if callee had own image
                JSVM__LeaveFuncCode()
                JSVM__RestoreArguments(restore_fi)
                // M26g: restore this after CALL_METHOD
                IfCondition NotEqual(JSVMClosure.frame_has_saved_this, 0) ThenBlock: {
                    IfCondition EqualTo(Dereference(Add(JSVMClosure.frame_has_saved_this, Multiply(restore_fi, 8))), 1) ThenBlock: {
                        prev_th = Dereference(Add(JSVMClosure.frame_saved_this, Multiply(restore_fi, 8)))
                        JSVM__SetGlobal("this", prev_th)
                        StoreValue(Add(JSVMClosure.frame_has_saved_this, Multiply(restore_fi, 8)), 0)
                        StoreValue(Add(JSVMClosure.frame_saved_this, Multiply(restore_fi, 8)), 0)
                    }
                }

                // Read frame fields before ReclaimScope may invalidate layout.
                save_ret_pc = Dereference(frame)
                save_ret_sp = Dereference(Add(frame, 8))
                ctor_this = Dereference(Add(frame, 40))
                is_async_ret = 0
                IfCondition EqualTo(ctor_this, -65) ThenBlock: {
                    is_async_ret = 1
                    ctor_this = 0
                }

                // Scope reclamation first — promote return value (and nested strings)
                // before async Promise copy so rejection reasons survive frame teardown.
                ret_val = JSVM__ReclaimScope(frame, ret_val)

                IfCondition EqualTo(is_async_ret, 1) ThenBlock: {
                    // Async function return: PromiseResolve(ret_val) — adopt settled
                    // Promise reject/fulfill; do not wrap rejected as fulfilled.
                    async_promise = JSVM__AsyncReturnPromise(ret_val)
                    ret_val = async_promise
                }

                // M26e: double SuperCall (-3) — parent already ran; BindThis throws (catchable)
                IfCondition EqualTo(ctor_this, -3) ThenBlock: {
                    JSVM_ThrowReferenceError("Super constructor may only be called once")
                    ReturnValue(1)
                }

                // M26c/e: SuperCall frame (-2) — bind this; mark caller this INIT
                IfCondition EqualTo(ctor_this, -2) ThenBlock: {
                    rv_type = JSRT_GetType(ret_val)
                    is_obj_ret = 0
                    IfCondition EqualTo(rv_type, JSType.OBJECT) ThenBlock: { is_obj_ret = 1 }
                    IfCondition EqualTo(rv_type, JSType.ARRAY) ThenBlock: { is_obj_ret = 1 }
                    IfCondition EqualTo(rv_type, JSType.FUNCTION) ThenBlock: { is_obj_ret = 1 }
                    IfCondition EqualTo(is_obj_ret, 1) ThenBlock: {
                        JSVM__SetGlobal("this", ret_val)
                    } ElseBlock: {
                        ret_val = JSVM__GetGlobal("this")
                        // if still uninit sentinel, fall back (should not happen)
                        IfCondition EqualTo(ret_val, JSVMClosure.this_uninit) ThenBlock: {
                            ret_val = JSRTState.undef_val
                        }
                    }
                    // Caller frame is current after PopFrame (derived ctor)
                    IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                        IfCondition NotEqual(JSVMClosure.frame_this_st, 0) ThenBlock: {
                            cfi = Subtract(JSVMState.fp, 1)
                            StoreValue(Add(JSVMClosure.frame_this_st, Multiply(cfi, 8)), 2)
                        }
                        // M26k.9: InitializeInstanceFields for derived class after super()
                        der_ctor = Dereference(Add(JSVMClosure.frame_funcs, Multiply(Subtract(JSVMState.fp, 1), 8)))
                        fi_inst = JSVM__GetGlobal("this")
                        IfCondition EqualTo(JSVM__RunFieldInitForCtor(fi_inst, der_ctor), 1) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                    JSVMState.this_tdz = 0
                    ctor_this = 0
                }

                // Check if this was a constructor frame (offset 40 = this_obj)
                IfCondition NotEqual(ctor_this, 0) ThenBlock: {
                    // M26e: derived ctor returned without super() → ReferenceError
                    IfCondition NotEqual(JSVMClosure.frame_this_st, 0) ThenBlock: {
                        st_ret = Dereference(Add(JSVMClosure.frame_this_st, Multiply(restore_fi, 8)))
                        IfCondition EqualTo(st_ret, 1) ThenBlock: {
                            keep_pop = 1
                            WhileLoop EqualTo(keep_pop, 1) {
                                keep_pop = 0
                                IfCondition GreaterThan(JSVMState.exc_sp, 0) ThenBlock: {
                                    ebase_d = Add(JSVMState.exc_stack, Multiply(Subtract(JSVMState.exc_sp, 1), 32))
                                    hfp_d = Dereference(Add(ebase_d, 16))
                                    IfCondition GreaterThan(hfp_d, JSVMState.fp) ThenBlock: {
                                        JSVMState.exc_sp = Subtract(JSVMState.exc_sp, 1)
                                        keep_pop = 1
                                    }
                                }
                            }
                            JSVM_ThrowReferenceError("Must call super constructor in derived class before returning")
                            ReturnValue(1)
                        }
                        StoreValue(Add(JSVMClosure.frame_this_st, Multiply(restore_fi, 8)), 0)
                    }
                    // Constructor return: object → use it; else base uses this_obj.
                    // Derived (fdesc+88==2): non-object non-undefined → TypeError (ES 9.2.2).
                    rv_type = JSRT_GetType(ret_val)
                    is_obj_ret2 = 0
                    IfCondition EqualTo(rv_type, JSType.OBJECT) ThenBlock: { is_obj_ret2 = 1 }
                    IfCondition EqualTo(rv_type, JSType.ARRAY) ThenBlock: { is_obj_ret2 = 1 }
                    IfCondition EqualTo(rv_type, JSType.FUNCTION) ThenBlock: { is_obj_ret2 = 1 }
                    IfCondition EqualTo(is_obj_ret2, 0) ThenBlock: {
                        is_derived_ret = 0
                        cal_f = Dereference(Add(JSVMClosure.frame_funcs, Multiply(restore_fi, 8)))
                        IfCondition EqualTo(JSRT_GetType(cal_f), JSType.FUNCTION) ThenBlock: {
                            cal_d = JSRT_GetPayload(cal_f)
                            IfCondition NotEqual(cal_d, 0) ThenBlock: {
                                IfCondition EqualTo(Dereference(Add(cal_d, 88)), 2) ThenBlock: {
                                    is_derived_ret = 1
                                }
                            }
                        }
                        IfCondition EqualTo(is_derived_ret, 1) ThenBlock: {
                            // undefined → GetThisBinding (may be super object return);
                            // anything else → TypeError from [[Construct]]
                            is_undef_ret = 0
                            IfCondition EqualTo(rv_type, JSType.UNDEFINED) ThenBlock: { is_undef_ret = 1 }
                            IfCondition EqualTo(ret_val, JSRTState.undef_val) ThenBlock: { is_undef_ret = 1 }
                            IfCondition EqualTo(is_undef_ret, 0) ThenBlock: {
                                keep_pop = 1
                                WhileLoop EqualTo(keep_pop, 1) {
                                    keep_pop = 0
                                    IfCondition GreaterThan(JSVMState.exc_sp, 0) ThenBlock: {
                                        ebase_d = Add(JSVMState.exc_stack, Multiply(Subtract(JSVMState.exc_sp, 1), 32))
                                        hfp_d = Dereference(Add(ebase_d, 16))
                                        IfCondition GreaterThan(hfp_d, JSVMState.fp) ThenBlock: {
                                            JSVMState.exc_sp = Subtract(JSVMState.exc_sp, 1)
                                            keep_pop = 1
                                        }
                                    }
                                }
                                terr = JSVM_CreateTypedError("TypeError", "Derived constructors may only return object or undefined")
                                JSVM_ThrowValue(terr)
                                ReturnValue(1)
                            }
                            // Prefer current this (super may have rebound to parent object)
                            cur_this = JSVM__GetGlobal("this")
                            IfCondition EqualTo(JSVMState.this_tdz, 0) ThenBlock: {
                                ct = JSRT_GetType(cur_this)
                                IfCondition EqualTo(ct, JSType.OBJECT) ThenBlock: {
                                    ret_val = cur_this
                                } ElseBlock: {
                                    IfCondition EqualTo(ct, JSType.ARRAY) ThenBlock: {
                                        ret_val = cur_this
                                    } ElseBlock: {
                                        ret_val = ctor_this
                                    }
                                }
                            } ElseBlock: {
                                ret_val = ctor_this
                            }
                        } ElseBlock: {
                            ret_val = ctor_this
                        }
                    }
                    // M26a: clear this so bare Class() after new Class() still TypeErrors
                    JSVM__SetGlobal("this", JSRTState.undef_val)
                    JSVMState.this_tdz = 0
                    // M26k.9: field inits run at this-bind (base CONSTRUCT / post-super),
                    // not on constructor RETURN — ctor body must observe initialized fields.
                }

                // Restore state from saved values
                JSVMState.pc = save_ret_pc
                JSVMState.sp = save_ret_sp

                // Push return value
                JSVM__StackPush(ret_val)
                ReturnValue(1)
            }

                        // CLOSURE (57) — 16-bit constant index pointing to function descriptor
            Case 57: {
                cidx = JSVM__Read16()
                cval = JSVM__LoadConst(cidx)
                // Mole 7: attach parent activation env for free-var resolution
                JSVM__CaptureClosureEnv(cval)
                JSVM__StackPush(cval)
                ReturnValue(1)
            }

            // NEW_OBJECT (60)
            Case 60: {
                obj = JSRT_CreateObject()
                // Default [[Prototype]] = Object.prototype for instanceof Object
                IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                    JSRT_ObjSet(obj, "__proto__", JSRTState.object_proto)
                }
                JSVM__StackPush(obj)
                ReturnValue(1)
            }

            // NEW_ARRAY (61) — 16-bit operand: element count
            // Elements are on stack (first element pushed first = deepest)
            Case 61: {
                elem_count = JSVM__Read16()
                arr = JSRT_CreateArray()
                // Default [[Prototype]] = Array.prototype for instanceof Array
                IfCondition NotEqual(JSRTState.array_proto, 0) ThenBlock: {
                    JSRT_ObjSet(arr, "__proto__", JSRTState.array_proto)
                }

                // Pop elements in reverse (top = last element)
                // Store into a temp buffer first, then push in order
                IfCondition GreaterThan(elem_count, 0) ThenBlock: {
                    tbuf = JSVMCallBuf.buf
                    ei = Subtract(elem_count, 1)
                    WhileLoop GreaterEqual(ei, 0) {
                        ev = JSVM__StackPop()
                        StoreValue(Add(tbuf, Multiply(ei, 8)), ev)
                        ei = Subtract(ei, 1)
                    }
                    // Push them into array in order
                    ei = 0
                    WhileLoop LessThan(ei, elem_count) {
                        ev = Dereference(Add(tbuf, Multiply(ei, 8)))
                        JSRT_ArrPush(arr, ev)
                        ei = Add(ei, 1)
                    }
                }

                JSVM__StackPush(arr)
                ReturnValue(1)
            }

            // CONCAT (62) — string concatenation (pop 2, push result)
            Case 62: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                // Use JSRT_Add which handles string concatenation
                result = JSRT_Add(av, bv)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    JSVMCall.exc_prop = 0
                    ReturnValue(1)
                }
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // SET_PROP_COMPUTED (63) — pop value, pop key, pop obj; set obj[key]=value
            // Stack: [..., obj, key, value]
            // Also invokes __set_<key> when present (same as SET_PROP).
            Case 63: {
                sval = JSVM__StackPop()
                key_val = JSVM__StackPop()
                obj = JSVM__StackPop()
                // ToPropertyKey (Symbol → @@sN)
                JSRT__Push(sval)
                JSRT__Push(obj)
                key_ptr = JSVM_ToPropertyKey(key_val)
                obj = JSRT__Pop()
                sval = JSRT__Pop()

                // Wave 2: writable / freeze / non-extensible
                can = JSBridge_CanAssign(obj, key_ptr)
                IfCondition EqualTo(can, 0) ThenBlock: {
                    ReturnValue(1)
                }

                set_obj_t = JSRT_GetType(obj)
                // M26k.9: field_define skips inherited setters (CreateDataPropertyOrThrow)
                IfCondition And(EqualTo(JSVMState.field_define, 0), EqualTo(set_obj_t, JSType.OBJECT)) ThenBlock: {
                    sk_buf2 = JSVMCallBuf.getter_buf
                    SetByte(sk_buf2, 0, 95)
                    SetByte(sk_buf2, 1, 95)
                    SetByte(sk_buf2, 2, 115)
                    SetByte(sk_buf2, 3, 101)
                    SetByte(sk_buf2, 4, 116)
                    SetByte(sk_buf2, 5, 95)
                    JSVMTmp.idx = 0
                    JSVMTmp.done = 0
                    WhileLoop EqualTo(JSVMTmp.done, 0) {
                        JSVMTmp.type = GetByte(key_ptr, JSVMTmp.idx)
                        SetByte(sk_buf2, Add(6, JSVMTmp.idx), JSVMTmp.type)
                        IfCondition EqualTo(JSVMTmp.type, 0) ThenBlock: {
                            JSVMTmp.done = 1
                        }
                        JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                    }
                    JSRT__Push(obj)
                    JSRT__Push(sval)
                    JSRT__Push(key_ptr)
                    setter_func = JSRT_ObjGet(obj, sk_buf2)
                    key_ptr = JSRT__Pop()
                    sval = JSRT__Pop()
                    obj = JSRT__Pop()
                    st = JSRT_GetType(setter_func)
                    IfCondition EqualTo(st, JSType.FUNCTION) ThenBlock: {
                        JSVM__SetGlobal("this", obj)
                        arg_buf_s = JSVMCallBuf.buf
                        StoreValue(arg_buf_s, sval)
                        JSVM__CallFunc(setter_func, arg_buf_s, 1)
                        ReturnValue(1)
                    }
                }

                // M29e: array.length via computed key
                IfCondition EqualTo(set_obj_t, JSType.ARRAY) ThenBlock: {
                    is_alen_c = 0
                    IfCondition NotEqual(key_ptr, 0) ThenBlock: {
                        IfCondition EqualTo(GetByte(key_ptr, 0), 108) ThenBlock: {
                            IfCondition EqualTo(GetByte(key_ptr, 1), 101) ThenBlock: {
                                IfCondition EqualTo(GetByte(key_ptr, 2), 110) ThenBlock: {
                                    IfCondition EqualTo(GetByte(key_ptr, 3), 103) ThenBlock: {
                                        IfCondition EqualTo(GetByte(key_ptr, 4), 116) ThenBlock: {
                                            IfCondition EqualTo(GetByte(key_ptr, 5), 104) ThenBlock: {
                                                IfCondition EqualTo(GetByte(key_ptr, 6), 0) ThenBlock: {
                                                    is_alen_c = 1
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(is_alen_c, 1) ThenBlock: {
                        n_bits = JSRT_ToNumber(sval)
                        bad_len = 0
                        IfCondition EqualTo(Float_Lt(n_bits, Float_FromInt(0)), 1) ThenBlock: {
                            bad_len = 1
                        }
                        IfCondition EqualTo(Float_Lt(n_bits, Float_FromInt(4294967296)), 0) ThenBlock: {
                            bad_len = 1
                        }
                        ni_len = Float_ToInt(n_bits)
                        IfCondition EqualTo(Float_Eq(Float_FromInt(ni_len), n_bits), 0) ThenBlock: {
                            bad_len = 1
                        }
                        IfCondition EqualTo(bad_len, 1) ThenBlock: {
                            terr = JSVM_CreateTypedError("RangeError", "Invalid array length")
                            JSVM_ThrowValue(terr)
                            ReturnValue(1)
                        }
                        JSRT_ArrSetLen(obj, ni_len)
                        ReturnValue(1)
                    }
                }

                // M48b: PropertyDefinition SetFunctionName for anon function values
                // (object/class computed props). Ordinary assign uses SET_ELEM, not here.
                IfCondition EqualTo(JSRT_GetType(sval), JSType.FUNCTION) ThenBlock: {
                    cur_nm = JSRT_FuncPropGet(sval, "name")
                    nm_empty = 0
                    IfCondition EqualTo(cur_nm, 0) ThenBlock: {
                        nm_empty = 1
                    } ElseBlock: {
                        IfCondition EqualTo(cur_nm, JSRTState.undef_val) ThenBlock: {
                            nm_empty = 1
                        } ElseBlock: {
                            IfCondition EqualTo(JSRT_GetType(cur_nm), JSType.STRING) ThenBlock: {
                                // empty string name → needs SetFunctionName
                                IfCondition EqualTo(JSRT_StrEq(JSRT_GetPayload(cur_nm), ""), 1) ThenBlock: {
                                    nm_empty = 1
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(nm_empty, 1) ThenBlock: {
                        // use original key_val (Symbol → [desc]); not key_ptr @@sN
                        JSVM_SetFunctionName(sval, key_val)
                    }
                }

                JSRT_ObjSet(obj, key_ptr, sval)
                // M49: same attr policy as SET_PROP for function values
                IfCondition EqualTo(JSRT_GetType(sval), JSType.FUNCTION) ThenBlock: {
                    abits_c = JSAttr.DEFAULT
                    IfCondition EqualTo(JSRT_GetType(obj), JSType.FUNCTION) ThenBlock: {
                        abits_c = 5
                    } ElseBlock: {
                        IfCondition EqualTo(JSRT_ObjHas(obj, "constructor"), 1) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrEq(key_ptr, "constructor"), 0) ThenBlock: {
                                abits_c = 5
                            }
                        }
                    }
                    JSBridge__SetAttrBits(obj, key_ptr, abits_c)
                    // home object for methods
                    IfCondition EqualTo(JSRT_GetType(obj), JSType.OBJECT) ThenBlock: {
                        JSRT_FuncPropSet(sval, "__home_proto__", obj)
                    }
                    IfCondition EqualTo(JSRT_GetType(obj), JSType.FUNCTION) ThenBlock: {
                        JSRT_FuncPropSet(sval, "__home_proto__", obj)
                    }
                }
                ReturnValue(1)
            }

            // DEF_GETTER (64) — 16-bit operand: const pool index (prop name)
            // Stack: [..., obj, func]. Pop func, pop obj, define getter.
            // Store as __get_<name> property on the object.
            // Key must be in stable memory (str_slab), NOT getter_buf, because
            // PropTable stores the key pointer and getter_buf is shared/transient.
            Case 64: {
                cidx = JSVM__Read16()
                JSVMTmp.ptr = JSVM__GetConstPayload(cidx)
                func_val = JSVM__StackPop()
                obj = JSVM__StackPop()
                // Build getter key: "__get_" + name in getter_buf (temp)
                gk_buf = JSVMCallBuf.getter_buf
                SetByte(gk_buf, 0, 95)
                SetByte(gk_buf, 1, 95)
                SetByte(gk_buf, 2, 103)
                SetByte(gk_buf, 3, 101)
                SetByte(gk_buf, 4, 116)
                SetByte(gk_buf, 5, 95)
                JSVMTmp.idx = 0
                JSVMTmp.done = 0
                WhileLoop EqualTo(JSVMTmp.done, 0) {
                    JSVMTmp.val = GetByte(JSVMTmp.ptr, JSVMTmp.idx)
                    SetByte(gk_buf, Add(6, JSVMTmp.idx), JSVMTmp.val)
                    IfCondition EqualTo(JSVMTmp.val, 0) ThenBlock: {
                        JSVMTmp.done = 1
                    }
                    JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                }
                // Copy to stable str_slab so PropTable key pointer survives
                gk_len = Add(6, JSVMTmp.idx)
                gk_stable = JSRT__StrSlabAlloc(gk_len)
                IfCondition EqualTo(gk_stable, 0) ThenBlock: { ReturnValue(1) }
                MemoryCopy(gk_stable, gk_buf, gk_len)
                JSRT_ObjSet(obj, gk_stable, func_val)
                // M26k.11: brand home for private getters
                IfCondition EqualTo(JSRT_GetType(func_val), JSType.FUNCTION) ThenBlock: {
                    JSRT_FuncPropSet(func_val, "__home_proto__", obj)
                    // M66/M78: SetFunctionName(fn, "get " + propKey)
                    // Private: use "#desc" not mangled "#desc@brand"
                    name_src = JSVMTmp.ptr
                    IfCondition EqualTo(JSVM__IsMangledPrivate(JSVMTmp.ptr), 1) ThenBlock: {
                        pn_len = 0
                        pndone = 0
                        WhileLoop EqualTo(pndone, 0) {
                            pnb = GetByte(JSVMTmp.ptr, pn_len)
                            IfCondition Or(EqualTo(pnb, 0), EqualTo(pnb, 64)) ThenBlock: {
                                pndone = 1
                            } ElseBlock: {
                                pn_len = Add(pn_len, 1)
                                IfCondition GreaterThan(pn_len, 200) ThenBlock: { pndone = 1 }
                            }
                        }
                        IfCondition GreaterThan(pn_len, 0) ThenBlock: {
                            pn_copy = JSRT__StrSlabAlloc(Add(pn_len, 1))
                            IfCondition NotEqual(pn_copy, 0) ThenBlock: {
                                MemoryCopy(pn_copy, JSVMTmp.ptr, pn_len)
                                SetByte(pn_copy, pn_len, 0)
                                name_src = pn_copy
                            }
                        }
                    }
                    pfx = JSRT_CreateString("get ")
                    IfCondition NotEqual(pfx, 0) ThenBlock: {
                        nms = JSRT__StrConcat(JSRT_GetPayload(pfx), name_src)
                        IfCondition NotEqual(nms, 0) ThenBlock: {
                            JSVM_SetFunctionName(func_val, nms)
                        }
                    }
                }
                // Placeholder own key so Object.keys / spread list the accessor name.
                // GET_PROP prefers __get_<name>, so this undefined data value is never read.
                JSRT_ObjSet(obj, JSVMTmp.ptr, JSRT_Undefined())
                ReturnValue(1)
            }

            // DEF_SETTER (65) — 16-bit operand: const pool index (prop name)
            // Stack: [..., obj, func]. Pop func, pop obj, define setter.
            // Key stored in stable str_slab (same fix as DEF_GETTER).
            Case 65: {
                cidx = JSVM__Read16()
                JSVMTmp.ptr = JSVM__GetConstPayload(cidx)
                func_val = JSVM__StackPop()
                obj = JSVM__StackPop()
                // Build setter key: "__set_" + name in getter_buf (temp)
                sk_buf = JSVMCallBuf.getter_buf
                SetByte(sk_buf, 0, 95)
                SetByte(sk_buf, 1, 95)
                SetByte(sk_buf, 2, 115)
                SetByte(sk_buf, 3, 101)
                SetByte(sk_buf, 4, 116)
                SetByte(sk_buf, 5, 95)
                JSVMTmp.idx = 0
                JSVMTmp.done = 0
                WhileLoop EqualTo(JSVMTmp.done, 0) {
                    JSVMTmp.val = GetByte(JSVMTmp.ptr, JSVMTmp.idx)
                    SetByte(sk_buf, Add(6, JSVMTmp.idx), JSVMTmp.val)
                    IfCondition EqualTo(JSVMTmp.val, 0) ThenBlock: {
                        JSVMTmp.done = 1
                    }
                    JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                }
                // Copy to stable str_slab so PropTable key pointer survives
                sk_len = Add(6, JSVMTmp.idx)
                sk_stable = JSRT__StrSlabAlloc(sk_len)
                IfCondition EqualTo(sk_stable, 0) ThenBlock: { ReturnValue(1) }
                MemoryCopy(sk_stable, sk_buf, sk_len)
                JSRT_ObjSet(obj, sk_stable, func_val)
                IfCondition EqualTo(JSRT_GetType(func_val), JSType.FUNCTION) ThenBlock: {
                    JSRT_FuncPropSet(func_val, "__home_proto__", obj)
                    // M66/M78: SetFunctionName(fn, "set " + propKey); private uses #desc
                    name_src2 = JSVMTmp.ptr
                    IfCondition EqualTo(JSVM__IsMangledPrivate(JSVMTmp.ptr), 1) ThenBlock: {
                        pn_len2 = 0
                        pndone2 = 0
                        WhileLoop EqualTo(pndone2, 0) {
                            pnb2 = GetByte(JSVMTmp.ptr, pn_len2)
                            IfCondition Or(EqualTo(pnb2, 0), EqualTo(pnb2, 64)) ThenBlock: {
                                pndone2 = 1
                            } ElseBlock: {
                                pn_len2 = Add(pn_len2, 1)
                                IfCondition GreaterThan(pn_len2, 200) ThenBlock: { pndone2 = 1 }
                            }
                        }
                        IfCondition GreaterThan(pn_len2, 0) ThenBlock: {
                            pn_copy2 = JSRT__StrSlabAlloc(Add(pn_len2, 1))
                            IfCondition NotEqual(pn_copy2, 0) ThenBlock: {
                                MemoryCopy(pn_copy2, JSVMTmp.ptr, pn_len2)
                                SetByte(pn_copy2, pn_len2, 0)
                                name_src2 = pn_copy2
                            }
                        }
                    }
                    pfxs = JSRT_CreateString("set ")
                    IfCondition NotEqual(pfxs, 0) ThenBlock: {
                        nms2 = JSRT__StrConcat(JSRT_GetPayload(pfxs), name_src2)
                        IfCondition NotEqual(nms2, 0) ThenBlock: {
                            JSVM_SetFunctionName(func_val, nms2)
                        }
                    }
                }
                // M66: placeholder own key so hasOwnProperty/gOPN/gOPD see setter-only props
                // (mirror DEF_GETTER; GET_PROP prefers __set_ for writes).
                JSRT_ObjSet(obj, JSVMTmp.ptr, JSRT_Undefined())

                ReturnValue(1)
            }

            // DEF_GETTER_COMPUTED (76) — Stack: [obj, key, func]
            // M66: ToPropertyKey + StrUnit (UTF-16); placeholder own key like DEF_GETTER.
            Case 76: {
                func_val = JSVM__StackPop()
                key_val = JSVM__StackPop()
                obj = JSVM__StackPop()
                key_ptr = JSVM_ToPropertyKey(key_val)
                IfCondition EqualTo(key_ptr, 0) ThenBlock: {
                    ReturnValue(1)
                }
                // Build getter key: "__get_" + name via StrUnit (not GetByte)
                gk_buf = JSVMCallBuf.getter_buf
                SetByte(gk_buf, 0, 95)
                SetByte(gk_buf, 1, 95)
                SetByte(gk_buf, 2, 103)
                SetByte(gk_buf, 3, 101)
                SetByte(gk_buf, 4, 116)
                SetByte(gk_buf, 5, 95)
                JSVMTmp.idx = 0
                JSVMTmp.done = 0
                WhileLoop EqualTo(JSVMTmp.done, 0) {
                    u = JSRT_StrUnit(key_ptr, JSVMTmp.idx)
                    IfCondition EqualTo(u, 0) ThenBlock: {
                        SetByte(gk_buf, Add(6, JSVMTmp.idx), 0)
                        JSVMTmp.done = 1
                    } ElseBlock: {
                        // BMP only for prop keys in accessor table
                        SetByte(gk_buf, Add(6, JSVMTmp.idx), BitwiseAnd(u, 255))
                        JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                        IfCondition GreaterThan(JSVMTmp.idx, 200) ThenBlock: {
                            SetByte(gk_buf, Add(6, JSVMTmp.idx), 0)
                            JSVMTmp.done = 1
                        }
                    }
                }
                gk_len = Add(7, JSVMTmp.idx)
                gk_stable = JSRT__StrSlabAlloc(gk_len)
                IfCondition EqualTo(gk_stable, 0) ThenBlock: { ReturnValue(1) }
                MemoryCopy(gk_stable, gk_buf, gk_len)
                JSRT_ObjSet(obj, gk_stable, func_val)
                IfCondition EqualTo(JSRT_GetType(func_val), JSType.FUNCTION) ThenBlock: {
                    JSRT_FuncPropSet(func_val, "__home_proto__", obj)
                    // M67: SetFunctionName with "get " prefix (Symbols → [desc])
                    JSVM_SetFunctionName(func_val, key_val)
                    cur_nm = JSRT_FuncPropGet(func_val, "name")
                    pfx = JSRT_CreateString("get ")
                    IfCondition And(NotEqual(pfx, 0), NotEqual(cur_nm, 0)) ThenBlock: {
                        IfCondition EqualTo(JSRT_GetType(cur_nm), JSType.STRING) ThenBlock: {
                            nms = JSRT__StrConcat(JSRT_GetPayload(pfx), JSRT_GetPayload(cur_nm))
                            IfCondition NotEqual(nms, 0) ThenBlock: {
                                JSRT_FuncPropSet(func_val, "name", nms)
                            }
                        }
                    }
                }
                // Placeholder own key — same ToPropertyKey as __get_ suffix
                kb = JSVMCallBuf.getter_buf
                ki = 0
                kdone = 0
                WhileLoop EqualTo(kdone, 0) {
                    ku = JSRT_StrUnit(key_ptr, ki)
                    IfCondition EqualTo(ku, 0) ThenBlock: {
                        SetByte(kb, ki, 0)
                        kdone = 1
                    } ElseBlock: {
                        SetByte(kb, ki, BitwiseAnd(ku, 255))
                        ki = Add(ki, 1)
                        IfCondition GreaterThan(ki, 200) ThenBlock: {
                            SetByte(kb, ki, 0)
                            kdone = 1
                        }
                    }
                }
                klen = Add(ki, 1)
                kstable = JSRT__StrSlabAlloc(klen)
                IfCondition NotEqual(kstable, 0) ThenBlock: {
                    MemoryCopy(kstable, kb, klen)
                    JSRT_ObjSet(obj, kstable, JSRT_Undefined())
                }
                ReturnValue(1)
            }

            // DEF_SETTER_COMPUTED (77) — Stack: [obj, key, func]
            // M66: ToPropertyKey + StrUnit; placeholder own key like DEF_SETTER.
            Case 77: {
                func_val = JSVM__StackPop()
                key_val = JSVM__StackPop()
                obj = JSVM__StackPop()
                key_ptr = JSVM_ToPropertyKey(key_val)
                IfCondition EqualTo(key_ptr, 0) ThenBlock: {
                    ReturnValue(1)
                }
                sk_buf = JSVMCallBuf.getter_buf
                SetByte(sk_buf, 0, 95)
                SetByte(sk_buf, 1, 95)
                SetByte(sk_buf, 2, 115)
                SetByte(sk_buf, 3, 101)
                SetByte(sk_buf, 4, 116)
                SetByte(sk_buf, 5, 95)
                JSVMTmp.idx = 0
                JSVMTmp.done = 0
                WhileLoop EqualTo(JSVMTmp.done, 0) {
                    u = JSRT_StrUnit(key_ptr, JSVMTmp.idx)
                    IfCondition EqualTo(u, 0) ThenBlock: {
                        SetByte(sk_buf, Add(6, JSVMTmp.idx), 0)
                        JSVMTmp.done = 1
                    } ElseBlock: {
                        SetByte(sk_buf, Add(6, JSVMTmp.idx), BitwiseAnd(u, 255))
                        JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                        IfCondition GreaterThan(JSVMTmp.idx, 200) ThenBlock: {
                            SetByte(sk_buf, Add(6, JSVMTmp.idx), 0)
                            JSVMTmp.done = 1
                        }
                    }
                }
                sk_len = Add(7, JSVMTmp.idx)
                sk_stable = JSRT__StrSlabAlloc(sk_len)
                IfCondition EqualTo(sk_stable, 0) ThenBlock: { ReturnValue(1) }
                MemoryCopy(sk_stable, sk_buf, sk_len)
                JSRT_ObjSet(obj, sk_stable, func_val)
                IfCondition EqualTo(JSRT_GetType(func_val), JSType.FUNCTION) ThenBlock: {
                    JSRT_FuncPropSet(func_val, "__home_proto__", obj)
                    // M67: SetFunctionName with "set " prefix
                    JSVM_SetFunctionName(func_val, key_val)
                    cur_nm2 = JSRT_FuncPropGet(func_val, "name")
                    pfx2 = JSRT_CreateString("set ")
                    IfCondition And(NotEqual(pfx2, 0), NotEqual(cur_nm2, 0)) ThenBlock: {
                        IfCondition EqualTo(JSRT_GetType(cur_nm2), JSType.STRING) ThenBlock: {
                            nms3 = JSRT__StrConcat(JSRT_GetPayload(pfx2), JSRT_GetPayload(cur_nm2))
                            IfCondition NotEqual(nms3, 0) ThenBlock: {
                                JSRT_FuncPropSet(func_val, "name", nms3)
                            }
                        }
                    }
                }
                kb = JSVMCallBuf.getter_buf
                ki = 0
                kdone = 0
                WhileLoop EqualTo(kdone, 0) {
                    ku = JSRT_StrUnit(key_ptr, ki)
                    IfCondition EqualTo(ku, 0) ThenBlock: {
                        SetByte(kb, ki, 0)
                        kdone = 1
                    } ElseBlock: {
                        SetByte(kb, ki, BitwiseAnd(ku, 255))
                        ki = Add(ki, 1)
                        IfCondition GreaterThan(ki, 200) ThenBlock: {
                            SetByte(kb, ki, 0)
                            kdone = 1
                        }
                    }
                }
                klen = Add(ki, 1)
                kstable = JSRT__StrSlabAlloc(klen)
                IfCondition NotEqual(kstable, 0) ThenBlock: {
                    MemoryCopy(kstable, kb, klen)
                    JSRT_ObjSet(obj, kstable, JSRT_Undefined())
                }
                ReturnValue(1)
            }

            // THROW_TDZ (78) — ReferenceError: cannot access variable before initialization
            // 3-byte operand: const pool index of variable name string
            Case 78: {
                ci = JSVM__Read16()
                tdz_err = JSVM_CreateTypedError("ReferenceError", "Cannot access variable before initialization")
                JSVM_ThrowValue(tdz_err)
                ReturnValue(1)
            }

            // THROW_CONST (88) — TypeError: assignment to const variable
            Case 88: {
                // Discard stack value being assigned (if any)
                IfCondition GreaterThan(JSVMState.sp, 0) ThenBlock: {
                    JSVM__StackPop()
                }
                cerr = JSVM_CreateTypedError("TypeError", "Assignment to constant variable")
                JSVM_ThrowValue(cerr)
                ReturnValue(1)
            }

            // OBJ_KEYS (66) — pop object, push array of key strings
            Case 66: {
                obj = JSVM__StackPop()
                keys_arr = JSRT_ObjKeys(obj)
                JSVM__StackPush(keys_arr)
                ReturnValue(1)
            }

            // ARR_APPEND (67) — Stack: [..., array, value] → append value to array, push array
            Case 67: {
                sval = JSVM__StackPop()
                arr = JSVM__StackPop()
                JSRT_ArrPush(arr, sval)
                JSVM__StackPush(arr)
                ReturnValue(1)
            }

            // ARR_EXTEND (68) — Stack: [..., dest, src] → extend dest with iterable src
            // Arrays/strings direct; objects via Symbol.iterator (Mole 9).
            Case 68: {
                src_arr = JSVM__StackPop()
                dest_arr = JSVM__StackPop()
                src_t = JSRT_GetType(src_arr)
                // Fast path: array
                IfCondition EqualTo(src_t, JSType.ARRAY) ThenBlock: {
                    src_len = JSRT_ArrLen(src_arr)
                    ei = 0
                    WhileLoop LessThan(ei, src_len) {
                        ev = JSRT_ArrGet(src_arr, ei)
                        JSRT_ArrPush(dest_arr, ev)
                        ei = Add(ei, 1)
                    }
                    JSVM__StackPush(dest_arr)
                    ReturnValue(1)
                }
                // Iterable path (throws on null/undefined / non-iterable)
                expanded = JSVM_IterableToArray(src_arr)
                IfCondition EqualTo(expanded, 0) ThenBlock: {
                    // throw already set
                    ReturnValue(1)
                }
                src_len2 = JSRT_ArrLen(expanded)
                ei2 = 0
                WhileLoop LessThan(ei2, src_len2) {
                    JSRT_ArrPush(dest_arr, JSRT_ArrGet(expanded, ei2))
                    ei2 = Add(ei2, 1)
                }
                JSVM__StackPush(dest_arr)
                ReturnValue(1)
            }

            // CALL_SPREAD (69) — Stack: [..., func, args_array] → call func with array elements as args
            // Mirrors CALL: rest formals, arguments object, SetupCallEnv.
            Case 69: {
                args_arr = JSVM__StackPop()
                func_val = JSVM__StackPop()

                ft = JSRT_GetType(func_val)
                // M128: unwrap Object bag __ctor__ (default derived super(...args) on Object)
                super_bag = 0
                IfCondition EqualTo(ft, JSType.OBJECT) ThenBlock: {
                    ctor_fn = JSRT_ObjGet(func_val, "__ctor__")
                    IfCondition EqualTo(JSRT_GetType(ctor_fn), JSType.FUNCTION) ThenBlock: {
                        super_bag = func_val
                        func_val = ctor_fn
                        ft = JSType.FUNCTION
                    }
                }
                IfCondition NotEqual(ft, JSType.FUNCTION) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "is not a function")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }

                // M26e: SuperCall via CALL_SPREAD
                is_super_call = 0
                caller_st = 0
                caller_fi = 0
                IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                    caller_fi = Subtract(JSVMState.fp, 1)
                    IfCondition NotEqual(JSVMClosure.frame_this_st, 0) ThenBlock: {
                        caller_st = Dereference(Add(JSVMClosure.frame_this_st, Multiply(caller_fi, 8)))
                    }
                }
                is_sup_target = 0
                IfCondition Or(EqualTo(caller_st, 1), EqualTo(caller_st, 2)) ThenBlock: {
                    fdesc_cc0 = JSRT_GetPayload(func_val)
                    is_cc0 = 0
                    IfCondition NotEqual(fdesc_cc0, 0) ThenBlock: {
                        is_cc0 = Dereference(Add(fdesc_cc0, 88))
                    }
                    // Class parent SuperCall
                    IfCondition NotEqual(is_cc0, 0) ThenBlock: {
                        is_sup_target = 1
                    }
                    // Non-class parent: match bag or unwrapped __ctor__ (extends Object)
                    IfCondition EqualTo(is_sup_target, 0) ThenBlock: {
                        IfCondition NotEqual(JSVMClosure.frame_funcs, 0) ThenBlock: {
                            cfn = Dereference(Add(JSVMClosure.frame_funcs, Multiply(caller_fi, 8)))
                            IfCondition EqualTo(JSRT_GetType(cfn), JSType.FUNCTION) ThenBlock: {
                                csup = JSRT_FuncPropGet(cfn, "__super__")
                                IfCondition EqualTo(csup, func_val) ThenBlock: {
                                    is_sup_target = 1
                                }
                                IfCondition EqualTo(is_sup_target, 0) ThenBlock: {
                                    IfCondition And(NotEqual(super_bag, 0), EqualTo(csup, super_bag)) ThenBlock: {
                                        is_sup_target = 1
                                    }
                                }
                                IfCondition EqualTo(is_sup_target, 0) ThenBlock: {
                                    IfCondition EqualTo(JSRT_GetType(csup), JSType.OBJECT) ThenBlock: {
                                        csup_ctor = JSRT_ObjGet(csup, "__ctor__")
                                        IfCondition EqualTo(csup_ctor, func_val) ThenBlock: {
                                            is_sup_target = 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(is_sup_target, 0) ThenBlock: {
                        gsup = JSVM__GetGlobal("__super__")
                        IfCondition EqualTo(gsup, func_val) ThenBlock: {
                            is_sup_target = 1
                        }
                        IfCondition EqualTo(is_sup_target, 0) ThenBlock: {
                            IfCondition And(NotEqual(super_bag, 0), EqualTo(gsup, super_bag)) ThenBlock: {
                                is_sup_target = 1
                            }
                        }
                        IfCondition EqualTo(is_sup_target, 0) ThenBlock: {
                            IfCondition EqualTo(JSRT_GetType(gsup), JSType.OBJECT) ThenBlock: {
                                gsup_ctor = JSRT_ObjGet(gsup, "__ctor__")
                                IfCondition EqualTo(gsup_ctor, func_val) ThenBlock: {
                                    is_sup_target = 1
                                }
                            }
                        }
                    }
                }
                IfCondition EqualTo(is_sup_target, 1) ThenBlock: {
                    IfCondition EqualTo(caller_st, 1) ThenBlock: {
                        // Walk frames for construct this_obj (skip SuperCall marks -2/-3)
                        der_this = 0
                        wfi = caller_fi
                        WhileLoop And(GreaterEqual(wfi, 0), EqualTo(der_this, 0)) {
                            wfa = Add(JSVMState.frames, Multiply(wfi, JSVMConst.FRAME_SIZE))
                            wth = Dereference(Add(wfa, 40))
                            IfCondition NotEqual(wth, 0) ThenBlock: {
                                IfCondition NotEqual(wth, -2) ThenBlock: {
                                    IfCondition NotEqual(wth, -3) ThenBlock: {
                                        IfCondition NotEqual(wth, -65) ThenBlock: {
                                            der_this = wth
                                        }
                                    }
                                }
                            }
                            wfi = Subtract(wfi, 1)
                        }
                        // Derived intermediate SuperCall: leave this TDZ
                        IfCondition EqualTo(is_cc0, 2) ThenBlock: {
                            IfCondition NotEqual(JSVMClosure.this_uninit, 0) ThenBlock: {
                                JSVM__SetGlobal("this", JSVMClosure.this_uninit)
                            }
                            JSVMState.this_tdz = 1
                        } ElseBlock: {
                            IfCondition NotEqual(der_this, 0) ThenBlock: {
                                JSVM__SetGlobal("this", der_this)
                                JSVMState.this_tdz = 0
                            }
                        }
                        is_super_call = 1
                    }
                    IfCondition EqualTo(caller_st, 2) ThenBlock: {
                        is_super_call = 2
                    }
                }
                IfCondition EqualTo(is_super_call, 0) ThenBlock: {
                    fdesc_cc = JSRT_GetPayload(func_val)
                    IfCondition NotEqual(fdesc_cc, 0) ThenBlock: {
                        is_cc = Dereference(Add(fdesc_cc, 88))
                        // 1/2 = class ctor only; 4 = method (callable)
                        IfCondition Or(EqualTo(is_cc, 1), EqualTo(is_cc, 2)) ThenBlock: {
                            terr = JSVM_CreateTypedError("TypeError", "Class constructor cannot be invoked without new")
                            JSVM_ThrowValue(terr)
                            ReturnValue(1)
                        }
                    }
                }

                                // M26h: CALL_SPREAD ordinary → clear new.target
                IfCondition EqualTo(is_super_call, 0) ThenBlock: {
                    JSVM__SetGlobal("__new_target__", JSRTState.undef_val)
                }

                // Build arg_buf from array elements (static buffer)
                argc = JSRT_ArrLen(args_arr)
                IfCondition GreaterThan(argc, JSVMConst.MAX_CALL_ARGS) ThenBlock: {
                    argc = JSVMConst.MAX_CALL_ARGS
                }
                arg_buf = JSVMCallBuf.buf
                ai = 0
                WhileLoop LessThan(ai, argc) {
                    arg_v = JSRT_ArrGet(args_arr, ai)
                    StoreValue(Add(arg_buf, Multiply(ai, 8)), arg_v)
                    ai = Add(ai, 1)
                }

                // Check if native function
                func_bc = JSRT_FuncGetBC(func_val)
                IfCondition LessThan(func_bc, 0) ThenBlock: {
                    handler_id = Subtract(-1, func_bc)
                    // M26j Array: route 62-76/97-99/string-range via StringMethod (Array ctor=76)
                    is_str_spread = 0
                    IfCondition GreaterEqual(handler_id, 62) ThenBlock: {
                        IfCondition LessEqual(handler_id, 76) ThenBlock: { is_str_spread = 1 }
                    }
                    IfCondition GreaterEqual(handler_id, 97) ThenBlock: {
                        IfCondition LessEqual(handler_id, 99) ThenBlock: { is_str_spread = 1 }
                    }
                    IfCondition GreaterEqual(handler_id, 150) ThenBlock: {
                        IfCondition LessEqual(handler_id, 171) ThenBlock: { is_str_spread = 1 }
                    }
                    IfCondition EqualTo(handler_id, 174) ThenBlock: { is_str_spread = 1 }
                    IfCondition EqualTo(is_str_spread, 1) ThenBlock: {
                        str_recv = JSRT_FuncGetEnv(func_val)
                        native_result = JSVM__DispatchStringMethod(handler_id, str_recv, arg_buf, argc)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                    } ElseBlock: {
                        IfCondition GreaterEqual(handler_id, 16) ThenBlock: {
                            native_result = JSBridge_Dispatch(handler_id, arg_buf, argc)
                        } ElseBlock: {
                            native_result = JSRT_CallNative(handler_id, arg_buf, argc)
                        }
                    }
                    // M26j: SuperCall into native finishes this-init
                    IfCondition EqualTo(is_super_call, 2) ThenBlock: {
                        JSVM_ThrowReferenceError("Super constructor may only be called once")
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(is_super_call, 1) ThenBlock: {
                        nrt = JSRT_GetType(native_result)
                        IfCondition Or(EqualTo(nrt, JSType.OBJECT), EqualTo(nrt, JSType.ARRAY)) ThenBlock: {
                            JSVM__SetGlobal("this", native_result)
                        }
                        JSVMState.this_tdz = 0
                        IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                            IfCondition NotEqual(JSVMClosure.frame_this_st, 0) ThenBlock: {
                                cfi = Subtract(JSVMState.fp, 1)
                                StoreValue(Add(JSVMClosure.frame_this_st, Multiply(cfi, 8)), 2)
                            }
                            // M26k.9: derived fields after native SuperCall this-init
                            der_ctor = Dereference(Add(JSVMClosure.frame_funcs, Multiply(Subtract(JSVMState.fp, 1), 8)))
                            fi_inst = JSVM__GetGlobal("this")
                            IfCondition EqualTo(JSVM__RunFieldInitForCtor(fi_inst, der_ctor), 1) ThenBlock: {
                                ReturnValue(1)
                            }
                        }
                    }
                    JSVM__StackPush(native_result)
                    ReturnValue(1)
                }

                // M102: CALL_SPREAD must honor generator/async-gen (same as CALL)
                func_env_sp = JSRT_FuncGetEnv(func_val)
                IfCondition EqualTo(func_env_sp, 71) ThenBlock: {
                    g_params_th_sp = JSRT_FuncGetParams(func_val)
                    IfCondition EqualTo(BitwiseAnd(g_params_th_sp, 268435456), 0) ThenBlock: {
                        IfCondition NotEqual(BitwiseAnd(g_params_th_sp, 536870912), 0) ThenBlock: {
                            JSVM__SetGlobal("this", JSRTState.undef_val)
                        } ElseBlock: {
                            gth_sp = JSVM__GetGlobal("globalThis")
                            IfCondition Or(EqualTo(gth_sp, 0), EqualTo(JSRT_GetType(gth_sp), JSType.UNDEFINED)) ThenBlock: {
                                gth_sp = JSVM__GetGlobal("this")
                            }
                            JSVM__SetGlobal("this", gth_sp)
                        }
                    }
                    gen_val_sp = JSRT_CreateGenerator(func_val, arg_buf, argc)
                    fdi_ok_sp = JSVM__GenInitParams(gen_val_sp, func_val)
                    IfCondition EqualTo(fdi_ok_sp, 0) ThenBlock: {
                        pend_fdi_sp = JSVMCall.thrown_val
                        IfCondition EqualTo(pend_fdi_sp, 0) ThenBlock: {
                            pend_fdi_sp = JSVMState.exc_val
                        }
                        IfCondition EqualTo(pend_fdi_sp, 0) ThenBlock: {
                            pend_fdi_sp = JSVM__GetGlobal("__pend_exc__")
                        }
                        JSVMCall.thrown_val = 0
                        JSVMCall.exc_prop = 0
                        JSVMState.exc_val = 0
                        IfCondition NotEqual(pend_fdi_sp, 0) ThenBlock: {
                            JSVM_ThrowValue(pend_fdi_sp)
                        } ElseBlock: {
                            JSVMState.error = 1
                            JSVMState.halted = 1
                        }
                        ReturnValue(1)
                    }
                    next_func_sp = JSRT_CreateFunc(-9999, 1, 0, "next")
                    JSRT_FuncSetEnv(next_func_sp, gen_val_sp)
                    ret_func_sp = JSRT_CreateFunc(-9998, 1, 0, "return")
                    JSRT_FuncSetEnv(ret_func_sp, gen_val_sp)
                    throw_func_sp = JSRT_CreateFunc(-9997, 1, 0, "throw")
                    JSRT_FuncSetEnv(throw_func_sp, gen_val_sp)
                    gen_obj_sp = JSRT_CreateObject()
                    gen_proto_sp = JSRT_ObjGet(func_val, "prototype")
                    IfCondition EqualTo(JSRT_GetType(gen_proto_sp), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(gen_obj_sp, "__proto__", gen_proto_sp)
                    }
                    JSRT_ObjSet(gen_obj_sp, "next", next_func_sp)
                    JSRT_ObjSet(gen_obj_sp, "return", ret_func_sp)
                    JSRT_ObjSet(gen_obj_sp, "throw", throw_func_sp)
                    JSRT_ObjSet(gen_obj_sp, "__gen__", gen_val_sp)
                    JSVM__StackPush(gen_obj_sp)
                    ReturnValue(1)
                }
                IfCondition EqualTo(func_env_sp, 66) ThenBlock: {
                    g_params_th2_sp = JSRT_FuncGetParams(func_val)
                    IfCondition EqualTo(BitwiseAnd(g_params_th2_sp, 268435456), 0) ThenBlock: {
                        IfCondition NotEqual(BitwiseAnd(g_params_th2_sp, 536870912), 0) ThenBlock: {
                            JSVM__SetGlobal("this", JSRTState.undef_val)
                        } ElseBlock: {
                            gth_g2_sp = JSVM__GetGlobal("globalThis")
                            IfCondition Or(EqualTo(gth_g2_sp, 0), EqualTo(JSRT_GetType(gth_g2_sp), JSType.UNDEFINED)) ThenBlock: {
                                gth_g2_sp = JSVM__GetGlobal("this")
                            }
                            JSVM__SetGlobal("this", gth_g2_sp)
                        }
                    }
                    gen_val_ag_sp = JSRT_CreateGenerator(func_val, arg_buf, argc)
                    ag_gs_sp = JSRT_GetPayload(gen_val_ag_sp)
                    StoreValue(Add(ag_gs_sp, 104), 1)
                    fdi_ok_ag_sp = JSVM__GenInitParams(gen_val_ag_sp, func_val)
                    IfCondition EqualTo(fdi_ok_ag_sp, 0) ThenBlock: {
                        pend_fdi_ag_sp = JSVMCall.thrown_val
                        IfCondition EqualTo(pend_fdi_ag_sp, 0) ThenBlock: {
                            pend_fdi_ag_sp = JSVMState.exc_val
                        }
                        IfCondition EqualTo(pend_fdi_ag_sp, 0) ThenBlock: {
                            pend_fdi_ag_sp = JSVM__GetGlobal("__pend_exc__")
                        }
                        JSVMCall.thrown_val = 0
                        JSVMCall.exc_prop = 0
                        JSVMState.exc_val = 0
                        IfCondition NotEqual(pend_fdi_ag_sp, 0) ThenBlock: {
                            JSVM_ThrowValue(pend_fdi_ag_sp)
                        } ElseBlock: {
                            JSVMState.error = 1
                            JSVMState.halted = 1
                        }
                        ReturnValue(1)
                    }
                    next_func_ag = JSRT_CreateFunc(-9999, 1, 0, "next")
                    JSRT_FuncSetEnv(next_func_ag, gen_val_ag_sp)
                    ret_func_ag = JSRT_CreateFunc(-9998, 1, 0, "return")
                    JSRT_FuncSetEnv(ret_func_ag, gen_val_ag_sp)
                    throw_func_ag = JSRT_CreateFunc(-9997, 1, 0, "throw")
                    JSRT_FuncSetEnv(throw_func_ag, gen_val_ag_sp)
                    gen_obj_ag = JSRT_CreateObject()
                    gen_proto_ag = JSRT_ObjGet(func_val, "prototype")
                    IfCondition EqualTo(JSRT_GetType(gen_proto_ag), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(gen_obj_ag, "__proto__", gen_proto_ag)
                    }
                    JSRT_ObjSet(gen_obj_ag, "next", next_func_ag)
                    JSRT_ObjSet(gen_obj_ag, "return", ret_func_ag)
                    JSRT_ObjSet(gen_obj_ag, "throw", throw_func_ag)
                    JSRT_ObjSet(gen_obj_ag, "__gen__", gen_val_ag_sp)
                    JSRT_ObjSet(gen_obj_ag, "__async_gen__", JSRT_CreateNumber(1))
                    JSVM__StackPush(gen_obj_ag)
                    ReturnValue(1)
                }

                // User-defined function call (same setup as CALL)
                func_params = JSRT_FuncGetParams(func_val)
                func_locals = JSRT_FuncGetLocals(func_val)

                save_pc = JSVMState.pc
                save_sp = JSVMState.sp
                locals_base = JSVMState.sp

                pf_ok = JSVM__PushFrame(save_pc, save_sp, locals_base, func_params, func_locals)
                IfCondition LessThan(pf_ok, 0) ThenBlock: {
                    PrintMessage("[JSEngine] call stack overflow (MAX_FRAMES)\n")
                    JSVMState.error = 1
                    ReturnValue(-1)
                }
                JSVM__SetupCallEnv(func_val)

                // Mole 16: per-function strict — save outer, enter if bit 29
                prev_strict = JSVMState.is_strict
                faddr_s = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
                StoreValue(Add(faddr_s, 72), prev_strict)
                IfCondition NotEqual(BitwiseAnd(func_params, 536870912), 0) ThenBlock: {
                    JSVMState.is_strict = 1
                }
                // M26c/e: SuperCall via CALL_SPREAD
                IfCondition NotEqual(is_super_call, 0) ThenBlock: {
                    IfCondition EqualTo(is_super_call, 2) ThenBlock: {
                        StoreValue(Add(faddr_s, 40), -3)
                    } ElseBlock: {
                        StoreValue(Add(faddr_s, 40), -2)
                    }
                    IfCondition EqualTo(JSVMState.this_tdz, 1) ThenBlock: {
                        fi_u = Subtract(JSVMState.fp, 1)
                        IfCondition NotEqual(JSVMClosure.frame_this_st, 0) ThenBlock: {
                            StoreValue(Add(JSVMClosure.frame_this_st, Multiply(fi_u, 8)), 1)
                        }
                    }
                    // M26k.9: base parent SuperCall — field init with this bound
                    IfCondition And(EqualTo(is_super_call, 1), EqualTo(JSVMState.this_tdz, 0)) ThenBlock: {
                        fi_inst = JSVM__GetGlobal("this")
                        IfCondition EqualTo(JSVM__RunFieldInitForCtor(fi_inst, func_val), 1) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                }

                // Rest formals (bit 31); unmapped args (bit 30); count in low 30 bits
                rest_flag = 0
                rest_idx = -1
                formal_count = BitwiseAnd(func_params, 268435455)
                IfCondition NotEqual(BitwiseAnd(func_params, 2147483648), 0) ThenBlock: {
                    rest_flag = 1
                    rest_idx = Subtract(formal_count, 1)
                }
                unmapped_bit = BitwiseAnd(func_params, 1073741824)

                pi = 0
                WhileLoop LessThan(pi, func_locals) {
                    pushed = 0
                    IfCondition EqualTo(rest_flag, 1) ThenBlock: {
                        IfCondition EqualTo(pi, rest_idx) ThenBlock: {
                            rest_arr = JSRT_CreateArray()
                            ri = rest_idx
                            WhileLoop LessThan(ri, argc) {
                                rval = Dereference(Add(arg_buf, Multiply(ri, 8)))
                                JSRT_ArrPush(rest_arr, rval)
                                ri = Add(ri, 1)
                            }
                            JSVM__StackPush(rest_arr)
                            pushed = 1
                        }
                        IfCondition EqualTo(pushed, 0) ThenBlock: {
                            IfCondition LessThan(pi, rest_idx) ThenBlock: {
                                IfCondition LessThan(pi, argc) ThenBlock: {
                                    pval = Dereference(Add(arg_buf, Multiply(pi, 8)))
                                    JSVM__StackPush(pval)
                                } ElseBlock: {
                                    JSVM__StackPush(JSRT_Undefined())
                                }
                                pushed = 1
                            }
                        }
                    }
                    IfCondition EqualTo(pushed, 0) ThenBlock: {
                        IfCondition LessThan(pi, argc) ThenBlock: {
                            IfCondition EqualTo(rest_flag, 0) ThenBlock: {
                                pval = Dereference(Add(arg_buf, Multiply(pi, 8)))
                                JSVM__StackPush(pval)
                            } ElseBlock: {
                                JSVM__StackPush(JSRT_Undefined())
                            }
                        } ElseBlock: {
                            JSVM__StackPush(JSRT_Undefined())
                        }
                    }
                    pi = Add(pi, 1)
                }

                // arguments object — mapped formals + callee
                map_n = formal_count
                IfCondition NotEqual(unmapped_bit, 0) ThenBlock: {
                    map_n = 0
                }
                IfCondition EqualTo(rest_flag, 1) ThenBlock: {
                    IfCondition EqualTo(unmapped_bit, 0) ThenBlock: {
                        map_n = rest_idx
                    }
                }
                IfCondition LessThan(map_n, 0) ThenBlock: { map_n = 0 }
                IfCondition EqualTo(BitwiseAnd(func_params, 268435456), 0) ThenBlock: {
                    args_obj = JSVM_CreateArguments(arg_buf, argc, func_val, map_n)
                    JSVM__SaveArguments()
                    JSVM__SetGlobal("arguments", args_obj)
                    IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                        fi_a = Subtract(JSVMState.fp, 1)
                        env_a = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi_a, 8)))
                        IfCondition NotEqual(env_a, 0) ThenBlock: {
                            JSRT_ObjSet(env_a, "arguments", args_obj)
                        }
                    }
                } ElseBlock: {
                    JSVM__SaveArguments()
                }

                JSVM__EnterFuncCode(func_val)
                JSVMState.pc = func_bc
                ReturnValue(1)
            }

            // CONSTRUCT (81) — new Foo(args) constructor call
            // Stack: [..., func, arg0, arg1, ..., argN-1]
            // Creates new object, binds this, calls constructor, returns object
            Case 81: {
                argc = JSVM__ReadByte()
                PrintMessage("[CONSTRUCT] argc=")
                PrintNumber(argc)
                PrintMessage(" sp=")
                PrintNumber(JSVMState.sp)
                PrintMessage("\n")

                // Use static arg buffer (no per-call allocation)
                arg_buf = JSVMCallBuf.buf

                ai = Subtract(argc, 1)
                WhileLoop GreaterEqual(ai, 0) {
                    arg_v = JSVM__StackPop()
                    StoreValue(Add(arg_buf, Multiply(ai, 8)), arg_v)
                    ai = Subtract(ai, 1)
                }

                // Pop function (constructor)
                func_val = JSVM__StackPop()
                PrintMessage("[CONSTRUCT] func_val=")
                PrintNumber(func_val)
                PrintMessage(" type=")
                ft = JSRT_GetType(func_val)
                PrintNumber(ft)
                PrintMessage("\n")
                // If OBJECT, check for __ctor__ (e.g., Promise)
                IfCondition EqualTo(ft, JSType.OBJECT) ThenBlock: {
                    ctor_fn = JSRT_ObjGet(func_val, "__ctor__")
                    ctor_ft = JSRT_GetType(ctor_fn)
                    IfCondition EqualTo(ctor_ft, JSType.FUNCTION) ThenBlock: {
                        func_val = ctor_fn
                        ft = JSType.FUNCTION
                    }
                }
                IfCondition NotEqual(ft, JSType.FUNCTION) ThenBlock: {
                    // Wave 3 D1: new on non-constructor → TypeError
                    terr = JSVM_CreateTypedError("TypeError", "is not a constructor")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                // Generators are not constructible
                c_env = JSRT_FuncGetEnv(func_val)
                IfCondition Or(EqualTo(c_env, 71), EqualTo(c_env, 66)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Generator is not a constructor")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                // M50: MethodDefinition (fdesc+88 == 4) is not constructible
                fdesc_meth = JSRT_GetPayload(func_val)
                IfCondition NotEqual(fdesc_meth, 0) ThenBlock: {
                    IfCondition EqualTo(Dereference(Add(fdesc_meth, 88)), 4) ThenBlock: {
                        terr = JSVM_CreateTypedError("TypeError", "is not a constructor")
                        JSVM_ThrowValue(terr)
                        ReturnValue(1)
                    }
                }
                // M43: built-in methods are not constructors (map, indexOf, …)
                // Allowlist: Number/String/Boolean 8-10, Errors 15-21, Promise 61,
                // Array 76, RegExp 82, Object 88, Date 176. User JS (bc>=0) always ok.
                n_bc = JSRT_FuncGetBC(func_val)
                IfCondition LessThan(n_bc, 0) ThenBlock: {
                    n_hid = Subtract(-1, n_bc)
                    is_nctor = 0
                    IfCondition And(GreaterEqual(n_hid, 8), LessEqual(n_hid, 10)) ThenBlock: { is_nctor = 1 }
                    IfCondition And(GreaterEqual(n_hid, 15), LessEqual(n_hid, 21)) ThenBlock: { is_nctor = 1 }
                    IfCondition EqualTo(n_hid, 61) ThenBlock: { is_nctor = 1 }
                    IfCondition EqualTo(n_hid, 76) ThenBlock: { is_nctor = 1 }
                    IfCondition EqualTo(n_hid, 82) ThenBlock: { is_nctor = 1 }
                    IfCondition EqualTo(n_hid, 88) ThenBlock: { is_nctor = 1 }
                    IfCondition EqualTo(n_hid, 176) ThenBlock: { is_nctor = 1 }
                    // M62: Map / Set constructors
                    IfCondition EqualTo(n_hid, 245) ThenBlock: { is_nctor = 1 }
                    IfCondition EqualTo(n_hid, 255) ThenBlock: { is_nctor = 1 }
                    // M81: Function constructor
                    IfCondition EqualTo(n_hid, 272) ThenBlock: { is_nctor = 1 }
                    IfCondition EqualTo(is_nctor, 0) ThenBlock: {
                        terr = JSVM_CreateTypedError("TypeError", "is not a constructor")
                        JSVM_ThrowValue(terr)
                        ReturnValue(1)
                    }
                }

                // M26c: bound function [[Construct]] — unwrap target, prepend partial args.
                // ES: if NewTarget is the bound fn, newTarget becomes [[BoundTargetFunction]].
                // After unwrap, func_val is the target so prototype = Subclass.prototype.
                bound_unwrap = 1
                WhileLoop EqualTo(bound_unwrap, 1) {
                    bound_unwrap = 0
                    b_bc = JSRT_FuncGetBC(func_val)
                    IfCondition LessThan(b_bc, 0) ThenBlock: {
                        b_hid = Subtract(-1, b_bc)
                        IfCondition EqualTo(b_hid, 198) ThenBlock: {
                            b_rec = JSRT_FuncGetEnv(func_val)
                            IfCondition EqualTo(JSRT_GetType(b_rec), JSType.OBJECT) ThenBlock: {
                                b_target = JSRT_ObjGet(b_rec, "__bt__")
                                b_parr = JSRT_ObjGet(b_rec, "__bargs__")
                                b_plen = 0
                                IfCondition EqualTo(JSRT_GetType(b_parr), JSType.ARRAY) ThenBlock: {
                                    b_plen = JSRT_ArrLen(b_parr)
                                }
                                // Shift construct args right, prepend partials (in-place)
                                IfCondition GreaterThan(b_plen, 0) ThenBlock: {
                                    b_new_argc = Add(b_plen, argc)
                                    IfCondition GreaterThan(b_new_argc, JSVMConst.MAX_CALL_ARGS) ThenBlock: {
                                        b_new_argc = JSVMConst.MAX_CALL_ARGS
                                        b_plen = Subtract(b_new_argc, argc)
                                        IfCondition LessThan(b_plen, 0) ThenBlock: { b_plen = 0 }
                                    }
                                    bi = Subtract(argc, 1)
                                    WhileLoop GreaterEqual(bi, 0) {
                                        StoreValue(Add(arg_buf, Multiply(Add(bi, b_plen), 8)), Dereference(Add(arg_buf, Multiply(bi, 8))))
                                        bi = Subtract(bi, 1)
                                    }
                                    bi = 0
                                    WhileLoop LessThan(bi, b_plen) {
                                        StoreValue(Add(arg_buf, Multiply(bi, 8)), JSRT_ArrGet(b_parr, bi))
                                        bi = Add(bi, 1)
                                    }
                                    argc = Add(b_plen, argc)
                                    IfCondition GreaterThan(argc, JSVMConst.MAX_CALL_ARGS) ThenBlock: {
                                        argc = JSVMConst.MAX_CALL_ARGS
                                    }
                                }
                                IfCondition EqualTo(JSRT_GetType(b_target), JSType.FUNCTION) ThenBlock: {
                                    func_val = b_target
                                    bound_unwrap = 1
                                }
                            }
                        }
                    }
                }
                // Re-check constructibility after unwrap
                c_env = JSRT_FuncGetEnv(func_val)
                IfCondition Or(EqualTo(c_env, 71), EqualTo(c_env, 66)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Generator is not a constructor")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }

                // Create new object for this — store in JSVMTmp.obj to survive calls
                JSVMTmp.obj = JSRT_CreateObject()
                IfCondition EqualTo(JSVMTmp.obj, 0) ThenBlock: {
                    PrintMessage("[JSEngine] OOM in CONSTRUCT (CreateObject)\n")
                    JSVMState.error = 1
                    JSVM__StackPush(JSRT_Undefined())
                    ReturnValue(-1)
                }

                // Set prototype: new_obj.__proto__ = func.prototype
                // Spec: if Type(proto) is Object (includes function/array), use it;
                // else Object.prototype. Our JSType.FUNCTION is not OBJECT.
                proto_val = JSRT_ObjGet(func_val, "prototype")
                proto_type = JSRT_GetType(proto_val)
                proto_ok = 0
                IfCondition EqualTo(proto_type, JSType.OBJECT) ThenBlock: { proto_ok = 1 }
                IfCondition EqualTo(proto_type, JSType.FUNCTION) ThenBlock: { proto_ok = 1 }
                IfCondition EqualTo(proto_type, JSType.ARRAY) ThenBlock: { proto_ok = 1 }
                IfCondition EqualTo(proto_ok, 1) ThenBlock: {
                    JSRT_ObjSet(JSVMTmp.obj, "__proto__", proto_val)
                } ElseBlock: {
                    IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                        JSRT_ObjSet(JSVMTmp.obj, "__proto__", JSRTState.object_proto)
                    }
                }

                // Check if native constructor
                func_bc = JSRT_FuncGetBC(func_val)
                PrintMessage("[CONSTRUCT] bc=")
                PrintNumber(func_bc)
                PrintMessage("\n")
                IfCondition LessThan(func_bc, 0) ThenBlock: {
                    // Native constructor — dispatch and return result or new_obj
                    handler_id = Subtract(-1, func_bc)
                    // Promise dispatch (57-61, 77-78) in CONSTRUCT
                    IfCondition GreaterEqual(handler_id, 57) ThenBlock: {
                        IfCondition LessEqual(handler_id, 61) ThenBlock: {
                            promise_recv = JSRT_FuncGetEnv(func_val)
                            native_result = JSBridge__DispatchPromise(handler_id, promise_recv, arg_buf, argc)
                            // (static arg_buf — no dealloc needed)
                            nr_type = JSRT_GetType(native_result)
                            IfCondition Or(EqualTo(nr_type, JSType.OBJECT), EqualTo(nr_type, JSType.ARRAY)) ThenBlock: {
                                JSVM__StackPush(native_result)
                            } ElseBlock: {
                                JSVM__StackPush(JSVMTmp.obj)
                            }
                            ReturnValue(1)
                        }
                    }
                    // String/Array method dispatch (62-76, 97)
                    is_str_method = 0
                    IfCondition GreaterEqual(handler_id, 62) ThenBlock: {
                        IfCondition LessEqual(handler_id, 76) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition Or(Or(EqualTo(handler_id, 229), EqualTo(handler_id, 230)), Or(EqualTo(handler_id, 232), EqualTo(handler_id, 233))) ThenBlock: { is_str_method = 1 }
                    IfCondition GreaterEqual(handler_id, 97) ThenBlock: {
                        IfCondition LessEqual(handler_id, 99) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition EqualTo(is_str_method, 1) ThenBlock: {
                            PrintMessage("[CONSTRUCT] dispatching to StringMethod\n")
                            native_result = JSVM__DispatchStringMethod(handler_id, JSVMTmp.obj, arg_buf, argc)
                            // (static arg_buf — no dealloc needed)
                            nr_type = JSRT_GetType(native_result)
                            IfCondition Or(EqualTo(nr_type, JSType.OBJECT), EqualTo(nr_type, JSType.ARRAY)) ThenBlock: {
                                JSVM__StackPush(native_result)
                            } ElseBlock: {
                                JSVM__StackPush(JSVMTmp.obj)
                            }
                            ReturnValue(1)
                    }
                    // M81: new Function(...) — return the constructed function
                    IfCondition EqualTo(handler_id, 272) ThenBlock: {
                        native_result = JSVM_FunctionNative(arg_buf, argc)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            JSVMCall.thrown_val = 0
                            JSVMState.exc_val = 0
                            JSVMCall.exc_prop = 0
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSRT_GetType(native_result), JSType.FUNCTION) ThenBlock: {
                            JSVM__StackPush(native_result)
                        } ElseBlock: {
                            JSVM__StackPush(JSVMTmp.obj)
                        }
                        ReturnValue(1)
                    }
                    PrintMessage("[CONSTRUCT] fallthrough handler_id=")
                    PrintNumber(handler_id)
                    PrintMessage("\n")
                    IfCondition GreaterEqual(handler_id, 22) ThenBlock: {
                        native_result = JSBridge_Dispatch(handler_id, arg_buf, argc)
                    } ElseBlock: {
                        native_result = JSRT_CallNative(handler_id, arg_buf, argc)
                    }
                    // (static arg_buf — no dealloc needed)
                    // If native returned an object/array/function, use that; otherwise use new_obj.
                    // Native Error/etc. ctors allocate a fresh object and skip the
                    // this-object we already prototyped — stamp [[Prototype]] here
                    // so `new Error() instanceof Error` works.
                    // M81: Function type too (other natives may return callables)
                    nr_type = JSRT_GetType(native_result)
                    IfCondition Or(Or(EqualTo(nr_type, JSType.OBJECT), EqualTo(nr_type, JSType.ARRAY)), EqualTo(nr_type, JSType.FUNCTION)) ThenBlock: {
                        IfCondition NotEqual(nr_type, JSType.FUNCTION) ThenBlock: {
                            proto_type = JSRT_GetType(proto_val)
                            IfCondition EqualTo(proto_type, JSType.OBJECT) ThenBlock: {
                                JSRT__Push(native_result)
                                existing_p = JSRT_ObjGet(native_result, "__proto__")
                                native_result = JSRT__Pop()
                                ep_t = JSRT_GetType(existing_p)
                                IfCondition NotEqual(ep_t, JSType.OBJECT) ThenBlock: {
                                    JSRT_ObjSet(native_result, "__proto__", proto_val)
                                }
                            }
                        }
                        JSVM__StackPush(native_result)
                    } ElseBlock: {
                        // Box Number/Boolean/String primitives into this (ES [[*Data]])
                        // RegisterNative: 8=Number, 9=String, 10=Boolean
                        IfCondition EqualTo(handler_id, 8) ThenBlock: {
                            JSRT_ObjSet(JSVMTmp.obj, "__value__", native_result)
                            JSRT_ObjSet(JSVMTmp.obj, "__class__", JSRT_CreateString("Number"))
                        }
                        IfCondition EqualTo(handler_id, 9) ThenBlock: {
                            JSRT_ObjSet(JSVMTmp.obj, "__value__", native_result)
                            JSRT_ObjSet(JSVMTmp.obj, "__class__", JSRT_CreateString("String"))
                            // M35/M39: String exotic length + index data properties
                            // PropTable stores key ptrs — IntToStr uses a static buf so
                            // all indices must be slab-copied or they collapse to last digit.
                            IfCondition EqualTo(JSRT_GetType(native_result), JSType.STRING) ThenBlock: {
                                spay = JSRT_GetPayload(native_result)
                                slen = 0
                                IfCondition NotEqual(spay, 0) ThenBlock: { slen = JSRT_StrLen(spay) }
                                JSRT_ObjSet(JSVMTmp.obj, "length", JSRT_CreateNumber(slen))
                                si = 0
                                WhileLoop LessThan(si, slen) {
                                    JSRT__Push(si)
                                    JSRT__Push(slen)
                                    JSRT__Push(spay)
                                    chv = JSRT_CreateStringSlice(spay, si, 1)
                                    tmpk = JSRT__IntToStr(si)
                                    klen = StringLength(tmpk)
                                    kptr = JSRT__StrSlabAlloc(Add(klen, 1))
                                    IfCondition NotEqual(kptr, 0) ThenBlock: {
                                        MemoryCopy(kptr, tmpk, Add(klen, 1))
                                    } ElseBlock: {
                                        kptr = tmpk
                                    }
                                    spay = JSRT__Pop()
                                    slen = JSRT__Pop()
                                    si = JSRT__Pop()
                                    JSRT__Push(si)
                                    JSRT__Push(slen)
                                    JSRT__Push(spay)
                                    JSRT_ObjSet(JSVMTmp.obj, kptr, chv)
                                    spay = JSRT__Pop()
                                    slen = JSRT__Pop()
                                    si = JSRT__Pop()
                                    si = Add(si, 1)
                                }
                            }
                        }
                        IfCondition EqualTo(handler_id, 10) ThenBlock: {
                            JSRT_ObjSet(JSVMTmp.obj, "__value__", native_result)
                            JSRT_ObjSet(JSVMTmp.obj, "__class__", JSRT_CreateString("Boolean"))
                        }
                        JSVM__StackPush(JSVMTmp.obj)
                    }
                    ReturnValue(1)
                }

                PrintMessage("[CONSTRUCT] checkpoint1\n")
                // M26e: derived class starts with this UNINIT; base binds immediately
                ctor_kind = 0
                fdesc_k = JSRT_GetPayload(func_val)
                IfCondition NotEqual(fdesc_k, 0) ThenBlock: {
                    ctor_kind = Dereference(Add(fdesc_k, 88))
                }
                IfCondition EqualTo(ctor_kind, 2) ThenBlock: {
                    JSVMState.this_tdz = 1
                    IfCondition NotEqual(JSVMClosure.this_uninit, 0) ThenBlock: {
                        JSVM__SetGlobal("this", JSVMClosure.this_uninit)
                    } ElseBlock: {
                        JSVM__SetGlobal("this", JSVMTmp.obj)
                    }
                } ElseBlock: {
                    JSVMState.this_tdz = 0
                    JSVM__SetGlobal("this", JSVMTmp.obj)
                }
                PrintMessage("[CONSTRUCT] checkpoint2\n")

                // M26h: new.target = NewTarget (constructor being new'd)
                JSVM__SetGlobal("__new_target__", func_val)

                // If constructor has __super__ property, set it as global
                // so the constructor body's hidden local can capture it.
                JSRT__Push(func_val)
                sup_val = JSRT_FuncPropGet(func_val, "__super__")
                func_val = JSRT__Pop()
                sup_type = JSRT_GetType(sup_val)
                IfCondition EqualTo(sup_type, JSType.FUNCTION) ThenBlock: {
                    JSVM__SetGlobal("__super__", sup_val)
                }

                // Set up call frame (same as CALL)
                func_params = JSRT_FuncGetParams(func_val)
                func_locals = JSRT_FuncGetLocals(func_val)

                save_pc = JSVMState.pc
                save_sp = JSVMState.sp
                locals_base = JSVMState.sp

                pf_ok = JSVM__PushFrame(save_pc, save_sp, locals_base, func_params, func_locals)
                IfCondition LessThan(pf_ok, 0) ThenBlock: {
                    PrintMessage("[JSEngine] call stack overflow (MAX_FRAMES)\n")
                    JSVMState.error = 1
                    ReturnValue(-1)
                }
                JSVM__SetupCallEnv(func_val)

                // Mole 16: per-function strict — save outer, enter if bit 29
                prev_strict = JSVMState.is_strict
                faddr_s = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
                StoreValue(Add(faddr_s, 72), prev_strict)
                IfCondition NotEqual(BitwiseAnd(func_params, 536870912), 0) ThenBlock: {
                    JSVMState.is_strict = 1
                }

                // Mark frame as constructor: store new_obj at frame offset 40
                faddr = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
                StoreValue(Add(faddr, 40), JSVMTmp.obj)
                // M26e: this binding status — derived UNINIT(1), else INIT(2)
                fi_st = Subtract(JSVMState.fp, 1)
                IfCondition NotEqual(JSVMClosure.frame_this_st, 0) ThenBlock: {
                    IfCondition EqualTo(ctor_kind, 2) ThenBlock: {
                        StoreValue(Add(JSVMClosure.frame_this_st, Multiply(fi_st, 8)), 1)
                    } ElseBlock: {
                        StoreValue(Add(JSVMClosure.frame_this_st, Multiply(fi_st, 8)), 2)
                    }
                }

                // M26k.9: base class — InitializeInstanceFields before ctor body
                IfCondition NotEqual(ctor_kind, 2) ThenBlock: {
                    IfCondition EqualTo(JSVM__RunFieldInitForCtor(JSVMTmp.obj, func_val), 1) ThenBlock: {
                        ReturnValue(1)
                    }
                }

                // M26b: rest packing same as CALL (bit 31) — was missing, rest was raw arg
                rest_flag = 0
                rest_idx = -1
                formal_count = BitwiseAnd(func_params, 268435455)
                IfCondition NotEqual(BitwiseAnd(func_params, 2147483648), 0) ThenBlock: {
                    rest_flag = 1
                    rest_idx = Subtract(formal_count, 1)
                }
                unmapped_bit = BitwiseAnd(func_params, 1073741824)

                pi = 0
                WhileLoop LessThan(pi, func_locals) {
                    pushed = 0
                    IfCondition EqualTo(rest_flag, 1) ThenBlock: {
                        IfCondition EqualTo(pi, rest_idx) ThenBlock: {
                            rest_arr = JSRT_CreateArray()
                            ri = rest_idx
                            WhileLoop LessThan(ri, argc) {
                                rval = Dereference(Add(arg_buf, Multiply(ri, 8)))
                                JSRT_ArrPush(rest_arr, rval)
                                ri = Add(ri, 1)
                            }
                            JSVM__StackPush(rest_arr)
                            pushed = 1
                        }
                        IfCondition EqualTo(pushed, 0) ThenBlock: {
                            IfCondition LessThan(pi, rest_idx) ThenBlock: {
                                IfCondition LessThan(pi, argc) ThenBlock: {
                                    pval = Dereference(Add(arg_buf, Multiply(pi, 8)))
                                    JSVM__StackPush(pval)
                                } ElseBlock: {
                                    JSVM__StackPush(JSRT_Undefined())
                                }
                                pushed = 1
                            }
                        }
                    }
                    IfCondition EqualTo(pushed, 0) ThenBlock: {
                        IfCondition LessThan(pi, argc) ThenBlock: {
                            IfCondition EqualTo(rest_flag, 0) ThenBlock: {
                                pval = Dereference(Add(arg_buf, Multiply(pi, 8)))
                                JSVM__StackPush(pval)
                            } ElseBlock: {
                                JSVM__StackPush(JSRT_Undefined())
                            }
                        } ElseBlock: {
                            JSVM__StackPush(JSRT_Undefined())
                        }
                    }
                    pi = Add(pi, 1)
                }

                // arguments object for constructor body
                map_n = formal_count
                IfCondition NotEqual(unmapped_bit, 0) ThenBlock: {
                    map_n = 0
                }
                IfCondition EqualTo(rest_flag, 1) ThenBlock: {
                    IfCondition EqualTo(unmapped_bit, 0) ThenBlock: {
                        map_n = rest_idx
                    }
                }
                IfCondition LessThan(map_n, 0) ThenBlock: { map_n = 0 }
                args_obj = JSVM_CreateArguments(arg_buf, argc, func_val, map_n)
                JSVM__SaveArguments()
                JSVM__SetGlobal("arguments", args_obj)
                IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                    fi_a = Subtract(JSVMState.fp, 1)
                    env_a = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi_a, 8)))
                    IfCondition NotEqual(env_a, 0) ThenBlock: {
                        JSRT_ObjSet(env_a, "arguments", args_obj)
                    }
                }

                // Jump to constructor code
                JSVM__EnterFuncCode(func_val)
                JSVMState.pc = func_bc
                ReturnValue(1)
            }

            // CALL_METHOD (83) — method call with this binding
            // Stack: [..., receiver, func, arg0, arg1, ..., argN-1]
            // Like CALL but pops receiver below func and binds this = receiver
            Case 83: {
                argc = JSVM__ReadByte()

                // Use static arg buffer (no per-call allocation)
                arg_buf = JSVMCallBuf.buf

                ai = Subtract(argc, 1)
                WhileLoop GreaterEqual(ai, 0) {
                    arg_v = JSVM__StackPop()
                    StoreValue(Add(arg_buf, Multiply(ai, 8)), arg_v)
                    ai = Subtract(ai, 1)
                }

                // Pop function value
                func_val = JSVM__StackPop()

                // Pop receiver (the object the method was called on)
                cm_receiver = JSVM__StackPop()

                ft = JSRT_GetType(func_val)
                IfCondition NotEqual(ft, JSType.FUNCTION) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "is not a function")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }

                // Bind this = receiver; remember outer this for RETURN restore (M26g)
                cm_prev_this = JSVM__GetGlobal("this")
                JSVM__SetGlobal("this", cm_receiver)
                // M26h: method call is not [[Construct]]
                JSVM__SetGlobal("__new_target__", JSRTState.undef_val)

                // Check if this is a native function
                func_bc = JSRT_FuncGetBC(func_val)
                IfCondition LessThan(func_bc, 0) ThenBlock: {
                    // Native function call — dispatch through JSRuntime or JSBridge
                    handler_id = Subtract(-1, func_bc)

                    // Generator .next() — handler_id = 9998 (bc = -9999)
                    IfCondition EqualTo(handler_id, 9998) ThenBlock: {
                        gen_result = JSVM__GenNext(func_val, arg_buf, argc)
                        // Mole 15: body throw → abrupt .next() (CALL_METHOD path)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pendgm = JSVMCall.thrown_val
                            IfCondition EqualTo(pendgm, 0) ThenBlock: {
                                pendgm = JSVMState.exc_val
                            }
                            IfCondition EqualTo(pendgm, 0) ThenBlock: {
                                pendgm = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVMCall.thrown_val = 0
                            JSVMState.exc_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition EqualTo(pendgm, 0) ThenBlock: {
                                pendgm = JSVM_CreateTypedError("TypeError", "generator threw")
                            }
                            JSVM_ThrowValue(pendgm)
                            // M128j: restore outer this after CALL_METHOD native/early exit
                            JSVM__SetGlobal("this", cm_prev_this)
                            ReturnValue(1)
                        }
                        JSVM__StackPush(gen_result)
                        // M128j: restore outer this after CALL_METHOD native/early exit
                        JSVM__SetGlobal("this", cm_prev_this)
                        ReturnValue(1)
                    }
                    // Generator .return() — handler_id = 9997 (bc = -9998)
                    IfCondition EqualTo(handler_id, 9997) ThenBlock: {
                        gen_result = JSVM__GenReturn(func_val, arg_buf, argc)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pendr = JSVMCall.thrown_val
                            IfCondition EqualTo(pendr, 0) ThenBlock: {
                                pendr = JSVMState.exc_val
                            }
                            IfCondition EqualTo(pendr, 0) ThenBlock: {
                                pendr = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVMCall.thrown_val = 0
                            JSVMState.exc_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition EqualTo(pendr, 0) ThenBlock: {
                                pendr = JSVM_CreateTypedError("TypeError", "generator return abrupt")
                            }
                            JSVM_ThrowValue(pendr)
                            // M128j: restore outer this after CALL_METHOD native/early exit
                            JSVM__SetGlobal("this", cm_prev_this)
                            ReturnValue(1)
                        }
                        JSVM__StackPush(gen_result)
                        // M128j: restore outer this after CALL_METHOD native/early exit
                        JSVM__SetGlobal("this", cm_prev_this)
                        ReturnValue(1)
                    }
                    // Generator .throw() — handler_id = 9996 (bc = -9997)
                    IfCondition EqualTo(handler_id, 9996) ThenBlock: {
                        gen_result = JSVM__GenThrow(func_val, arg_buf, argc)
                        JSVM__StackPush(gen_result)
                        // M128j: restore outer this after CALL_METHOD native/early exit
                        JSVM__SetGlobal("this", cm_prev_this)
                        ReturnValue(1)
                    }

                    // eval() — handler_id = 193 (CALL = indirect)
                    IfCondition EqualTo(handler_id, 193) ThenBlock: {
                        ev_saved_direct2 = JSVMEvalState.is_direct
                        JSVMEvalState.is_direct = 0
                        native_result = JSVM_EvalNative(arg_buf, argc)
                        JSVMEvalState.is_direct = ev_saved_direct2
                        // M71: EvalDeclarationInstantiation SyntaxError (var/let)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend_ev2 = JSVMCall.thrown_val
                            IfCondition EqualTo(pend_ev2, 0) ThenBlock: {
                                pend_ev2 = JSVMState.exc_val
                            }
                            JSVMCall.thrown_val = 0
                            JSVMState.exc_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition EqualTo(pend_ev2, 0) ThenBlock: {
                                pend_ev2 = JSVM_CreateTypedError("SyntaxError", "eval error")
                            }
                            JSVM_ThrowValue(pend_ev2)
                            // M128j: restore outer this after CALL_METHOD native/early exit
                            JSVM__SetGlobal("this", cm_prev_this)
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            // M128j: restore outer this after CALL_METHOD native/early exit
                            JSVM__SetGlobal("this", cm_prev_this)
                            ReturnValue(1)
                        }
                        JSVM__StackPush(native_result)
                        // M128j: restore outer this after CALL_METHOD native/early exit
                        JSVM__SetGlobal("this", cm_prev_this)
                        ReturnValue(1)
                    }

                    // Symbol() — handler_id = 194
                    IfCondition EqualTo(handler_id, 194) ThenBlock: {
                        native_result = JSVM_SymbolNative(arg_buf, argc)
                        JSVM__StackPush(native_result)
                        // M128j: restore outer this after CALL_METHOD native/early exit
                        JSVM__SetGlobal("this", cm_prev_this)
                        ReturnValue(1)
                    }

                    // M81: Function(...args) — handler_id = 272 (JSNativeID.FUNC_CTOR)
                    // Match CallNative: if ToString/body throw already hit catch via
                    // CallFunc, do not re-ThrowValue (would clobber catch frame).
                    IfCondition EqualTo(handler_id, 272) ThenBlock: {
                        native_result = JSVM_FunctionNative(arg_buf, argc)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend_fn = JSVMCall.thrown_val
                            IfCondition EqualTo(pend_fn, 0) ThenBlock: {
                                pend_fn = JSVMState.exc_val
                            }
                            IfCondition EqualTo(pend_fn, 0) ThenBlock: {
                                pend_fn = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVMCall.thrown_val = 0
                            JSVMState.exc_val = 0
                            JSVMCall.exc_prop = 0
                            // If catch already received the value (ThrowValue in CallFunc),
                            // stack has it. If uncaught pending, push for outer rethrow path.
                            IfCondition And(NotEqual(pend_fn, 0), NotEqual(pend_fn, JSRTState.undef_val)) ThenBlock: {
                                // Only push if not already at catch with value —
                                // CallNative-style: leave stack, just return.
                            }
                            // M128j: restore outer this after CALL_METHOD native/early exit
                            JSVM__SetGlobal("this", cm_prev_this)
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            // M128j: restore outer this after CALL_METHOD native/early exit
                            JSVM__SetGlobal("this", cm_prev_this)
                            ReturnValue(1)
                        }
                        JSVM__StackPush(native_result)
                        // M128j: restore outer this after CALL_METHOD native/early exit
                        JSVM__SetGlobal("this", cm_prev_this)
                        ReturnValue(1)
                    }

                    // Handler IDs 57-61, 77-78, 211-215: Promise methods
                    is_prom2 = 0
                    IfCondition GreaterEqual(handler_id, 57) ThenBlock: {
                        IfCondition LessEqual(handler_id, 61) ThenBlock: { is_prom2 = 1 }
                    }
                    IfCondition GreaterEqual(handler_id, 77) ThenBlock: {
                        IfCondition LessEqual(handler_id, 78) ThenBlock: { is_prom2 = 1 }
                    }
                    IfCondition GreaterEqual(handler_id, 211) ThenBlock: {
                        IfCondition LessEqual(handler_id, 215) ThenBlock: { is_prom2 = 1 }
                    }
                    IfCondition EqualTo(is_prom2, 1) ThenBlock: {
                        // Prefer [[This]] receiver (CALL_METHOD) so shared
                        // Promise.prototype.then works; fall back to func env.
                        promise_recv = cm_receiver
                        IfCondition EqualTo(promise_recv, 0) ThenBlock: {
                            promise_recv = JSRT_FuncGetEnv(func_val)
                        }
                        native_result = JSBridge__DispatchPromise(handler_id, promise_recv, arg_buf, argc)
                        JSVM__StackPush(native_result)
                        // M128j: restore outer this after CALL_METHOD native/early exit
                        JSVM__SetGlobal("this", cm_prev_this)
                        ReturnValue(1)
                    }

                    // Handler IDs 83-87, 216-224: RegExp methods + getters
                    is_rx = 0
                    IfCondition GreaterEqual(handler_id, 83) ThenBlock: {
                        IfCondition LessEqual(handler_id, 87) ThenBlock: { is_rx = 1 }
                    }
                    // M111: RegExp IDs are 216-228 + 231 only (not 229-230/232-233)
                    IfCondition GreaterEqual(handler_id, 216) ThenBlock: {
                        IfCondition LessEqual(handler_id, 228) ThenBlock: { is_rx = 1 }
                    }
                    IfCondition EqualTo(handler_id, 231) ThenBlock: { is_rx = 1 }
                    IfCondition EqualTo(is_rx, 1) ThenBlock: {
                        rx_recv = JSRT_FuncGetEnv(func_val)
                        IfCondition GreaterEqual(handler_id, 216) ThenBlock: {
                            th = JSVM__GetGlobal("this")
                            IfCondition And(NotEqual(JSRT_GetType(th), JSType.NULL), NotEqual(JSRT_GetType(th), JSType.UNDEFINED)) ThenBlock: {
                                rx_recv = th
                            }
                        }
                        native_result = JSVM__DispatchRegExpMethod(handler_id, rx_recv, arg_buf, argc)
                        JSVM__StackPush(native_result)
                        // M128j: restore outer this after CALL_METHOD native/early exit
                        JSVM__SetGlobal("this", cm_prev_this)
                        ReturnValue(1)
                    }

                    // Handler IDs 62-76, 97-99, 150-171, 180-191: String/Array/JSON methods (env = receiver)
                    is_str_method = 0
                    IfCondition GreaterEqual(handler_id, 62) ThenBlock: {
                        IfCondition LessEqual(handler_id, 76) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition Or(Or(EqualTo(handler_id, 229), EqualTo(handler_id, 230)), Or(EqualTo(handler_id, 232), EqualTo(handler_id, 233))) ThenBlock: { is_str_method = 1 }
                    IfCondition GreaterEqual(handler_id, 97) ThenBlock: {
                        IfCondition LessEqual(handler_id, 99) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition GreaterEqual(handler_id, 150) ThenBlock: {
                        IfCondition LessEqual(handler_id, 171) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition EqualTo(handler_id, 174) ThenBlock: { is_str_method = 1 }
                    IfCondition GreaterEqual(handler_id, 208) ThenBlock: {
                        IfCondition LessEqual(handler_id, 210) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition GreaterEqual(handler_id, 180) ThenBlock: {
                        IfCondition LessEqual(handler_id, 186) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition EqualTo(is_str_method, 1) ThenBlock: {
                        // M35: CALL_METHOD already bound global this = cm_receiver
                        str_recv = cm_receiver
                        native_result = JSVM__DispatchStringMethod(handler_id, str_recv, arg_buf, argc)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            // M128j: restore outer this after CALL_METHOD native/early exit
                            JSVM__SetGlobal("this", cm_prev_this)
                            ReturnValue(1)
                        }
                        JSVM__StackPush(native_result)
                        // M128j: restore outer this after CALL_METHOD native/early exit
                        JSVM__SetGlobal("this", cm_prev_this)
                        ReturnValue(1)
                    }

                    // Handler IDs 0-21: JSRuntime built-ins (0-14 math/type, 15-21 Error ctors)
                    // Handler IDs 22+: JSBridge DOM/timer natives
                    IfCondition GreaterEqual(handler_id, 22) ThenBlock: {
                        native_result = JSBridge_Dispatch(handler_id, arg_buf, argc)
                        // Native throw (e.g. defineProperty reject) — catch already set
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend_n = JSVMCall.thrown_val
                            IfCondition EqualTo(pend_n, 0) ThenBlock: {
                                pend_n = JSVM__GetGlobal("__pend_exc__")
                            }
                            IfCondition NotEqual(pend_n, 0) ThenBlock: {
                                IfCondition NotEqual(pend_n, JSRTState.undef_val) ThenBlock: {
                                    JSVM__StackPush(pend_n)
                                }
                            }
                            JSVMCall.exc_prop = 0
                            JSVMCall.thrown_val = 0
                            // M128j: restore outer this after CALL_METHOD native/early exit
                            JSVM__SetGlobal("this", cm_prev_this)
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            // M128j: restore outer this after CALL_METHOD native/early exit
                            JSVM__SetGlobal("this", cm_prev_this)
                            ReturnValue(1)
                        }
                        JSVM__StackPush(native_result)
                        // M128j: restore outer this after CALL_METHOD native/early exit
                        JSVM__SetGlobal("this", cm_prev_this)
                        ReturnValue(1)
                    }
                    native_result = JSRT_CallNative(handler_id, arg_buf, argc)
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        pend_n = JSVMCall.thrown_val
                        IfCondition EqualTo(pend_n, 0) ThenBlock: {
                            pend_n = JSVM__GetGlobal("__pend_exc__")
                        }
                        IfCondition NotEqual(pend_n, 0) ThenBlock: {
                            IfCondition NotEqual(pend_n, JSRTState.undef_val) ThenBlock: {
                                JSVM__StackPush(pend_n)
                            }
                        }
                        JSVMCall.exc_prop = 0
                        JSVMCall.thrown_val = 0
                        // M128j: restore outer this after CALL_METHOD native/early exit
                        JSVM__SetGlobal("this", cm_prev_this)
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        // M128j: restore outer this after CALL_METHOD native/early exit
                        JSVM__SetGlobal("this", cm_prev_this)
                        ReturnValue(1)
                    }
                    JSVM__StackPush(native_result)
                    // M128j: restore outer this after CALL_METHOD native/early exit
                    JSVM__SetGlobal("this", cm_prev_this)
                    ReturnValue(1)
                }

                // Check if this is a generator function (env == 71 magic)
                func_env = JSRT_FuncGetEnv(func_val)
                IfCondition EqualTo(func_env, 71) ThenBlock: {
                    gen_val = JSRT_CreateGenerator(func_val, arg_buf, argc)
                    fdi_ok = JSVM__GenInitParams(gen_val, func_val)
                    IfCondition EqualTo(fdi_ok, 0) ThenBlock: {
                        pend_fdi = JSVMCall.thrown_val
                        IfCondition EqualTo(pend_fdi, 0) ThenBlock: {
                            pend_fdi = JSVMState.exc_val
                        }
                        IfCondition EqualTo(pend_fdi, 0) ThenBlock: {
                            pend_fdi = JSVM__GetGlobal("__pend_exc__")
                        }
                        JSVMCall.thrown_val = 0
                        JSVMCall.exc_prop = 0
                        JSVMState.exc_val = 0
                        IfCondition NotEqual(pend_fdi, 0) ThenBlock: {
                            JSVM_ThrowValue(pend_fdi)
                        } ElseBlock: {
                            JSVMState.error = 1
                            JSVMState.halted = 1
                        }
                        // M128j: restore outer this after CALL_METHOD native/early exit
                        JSVM__SetGlobal("this", cm_prev_this)
                        ReturnValue(1)
                    }
                    gen_gs = Dereference(Add(gen_val, 8))
                    next_func = JSRT_CreateFunc(-9999, 1, 0, "next")
                    JSRT_FuncSetEnv(next_func, gen_val)
                    ret_func = JSRT_CreateFunc(-9998, 1, 0, "return")
                    JSRT_FuncSetEnv(ret_func, gen_val)
                    throw_func = JSRT_CreateFunc(-9997, 1, 0, "throw")
                    JSRT_FuncSetEnv(throw_func, gen_val)
                    gen_obj = JSRT_CreateObject()
                    gen_proto = JSRT_ObjGet(func_val, "prototype")
                    IfCondition EqualTo(JSRT_GetType(gen_proto), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(gen_obj, "__proto__", gen_proto)
                    }
                    JSRT_ObjSet(gen_obj, "next", next_func)
                    JSRT_ObjSet(gen_obj, "return", ret_func)
                    JSRT_ObjSet(gen_obj, "throw", throw_func)
                    JSRT_ObjSet(gen_obj, "__gen__", gen_val)
                    JSVM__StackPush(gen_obj)
                    // M128j: restore outer this after CALL_METHOD native/early exit
                    JSVM__SetGlobal("this", cm_prev_this)
                    ReturnValue(1)
                }

                // Async generator function (env == 66)
                IfCondition EqualTo(func_env, 66) ThenBlock: {
                    gen_val = JSRT_CreateGenerator(func_val, arg_buf, argc)
                    ag_gs = JSRT_GetPayload(gen_val)
                    StoreValue(Add(ag_gs, 104), 1)
                    // M94: FDI at call (same as sync gen) — param throws are sync
                    fdi_ok_ag2 = JSVM__GenInitParams(gen_val, func_val)
                    IfCondition EqualTo(fdi_ok_ag2, 0) ThenBlock: {
                        pend_fdi_ag2 = JSVMCall.thrown_val
                        IfCondition EqualTo(pend_fdi_ag2, 0) ThenBlock: {
                            pend_fdi_ag2 = JSVMState.exc_val
                        }
                        IfCondition EqualTo(pend_fdi_ag2, 0) ThenBlock: {
                            pend_fdi_ag2 = JSVM__GetGlobal("__pend_exc__")
                        }
                        JSVMCall.thrown_val = 0
                        JSVMCall.exc_prop = 0
                        JSVMState.exc_val = 0
                        IfCondition NotEqual(pend_fdi_ag2, 0) ThenBlock: {
                            JSVM_ThrowValue(pend_fdi_ag2)
                        } ElseBlock: {
                            JSVMState.error = 1
                            JSVMState.halted = 1
                        }
                        // M128j: restore outer this after CALL_METHOD native/early exit
                        JSVM__SetGlobal("this", cm_prev_this)
                        ReturnValue(1)
                    }
                    gen_gs = Dereference(Add(gen_val, 8))
                    next_func = JSRT_CreateFunc(-9999, 1, 0, "next")
                    JSRT_FuncSetEnv(next_func, gen_val)
                    ret_func = JSRT_CreateFunc(-9998, 1, 0, "return")
                    JSRT_FuncSetEnv(ret_func, gen_val)
                    throw_func = JSRT_CreateFunc(-9997, 1, 0, "throw")
                    JSRT_FuncSetEnv(throw_func, gen_val)
                    gen_obj = JSRT_CreateObject()
                    gen_proto = JSRT_ObjGet(func_val, "prototype")
                    IfCondition EqualTo(JSRT_GetType(gen_proto), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(gen_obj, "__proto__", gen_proto)
                    }
                    JSRT_ObjSet(gen_obj, "next", next_func)
                    JSRT_ObjSet(gen_obj, "return", ret_func)
                    JSRT_ObjSet(gen_obj, "throw", throw_func)
                    JSRT_ObjSet(gen_obj, "__gen__", gen_val)
                    JSRT_ObjSet(gen_obj, "__async_gen__", JSRT_CreateNumber(1))
                    JSVM__StackPush(gen_obj)
                    // M128j: restore outer this after CALL_METHOD native/early exit
                    JSVM__SetGlobal("this", cm_prev_this)
                    ReturnValue(1)
                }

                // If callee has __super__, set it as global for the callee body.
                JSRT__Push(func_val)
                call_sup = JSRT_FuncPropGet(func_val, "__super__")
                func_val = JSRT__Pop()
                call_sup_t = JSRT_GetType(call_sup)
                IfCondition EqualTo(call_sup_t, JSType.FUNCTION) ThenBlock: {
                    JSVM__SetGlobal("__super__", call_sup)
                }

                // Get function descriptor fields
                func_params = JSRT_FuncGetParams(func_val)
                func_locals = JSRT_FuncGetLocals(func_val)

                // Save current state in a call frame
                save_pc = JSVMState.pc
                save_sp = JSVMState.sp
                locals_base = JSVMState.sp

                pf_ok = JSVM__PushFrame(save_pc, save_sp, locals_base, func_params, func_locals)
                IfCondition LessThan(pf_ok, 0) ThenBlock: {
                    PrintMessage("[JSEngine] call stack overflow (MAX_FRAMES)\n")
                    JSVMState.error = 1
                    // M128j: restore outer this after CALL_METHOD native/early exit
                    JSVM__SetGlobal("this", cm_prev_this)
                    ReturnValue(-1)
                }
                JSVM__SetupCallEnv(func_val)

                // Mole 16: per-function strict — save outer, enter if bit 29
                prev_strict = JSVMState.is_strict
                faddr_s = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
                StoreValue(Add(faddr_s, 72), prev_strict)
                IfCondition NotEqual(BitwiseAnd(func_params, 536870912), 0) ThenBlock: {
                    JSVMState.is_strict = 1
                }

                // M26g: restore outer this when this method returns
                fi_st = Subtract(JSVMState.fp, 1)
                IfCondition NotEqual(JSVMClosure.frame_saved_this, 0) ThenBlock: {
                    StoreValue(Add(JSVMClosure.frame_saved_this, Multiply(fi_st, 8)), cm_prev_this)
                    StoreValue(Add(JSVMClosure.frame_has_saved_this, Multiply(fi_st, 8)), 1)
                }

                // Mark async frames with -65 at offset 40 so RETURN can wrap result
                IfCondition EqualTo(func_env, 65) ThenBlock: {
                    af_addr = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
                    StoreValue(Add(af_addr, 40), -65)
                }

                // Push locals onto stack (initialize args, rest to undefined)
                pi = 0
                WhileLoop LessThan(pi, func_locals) {
                    IfCondition LessThan(pi, argc) ThenBlock: {
                        pval = Dereference(Add(arg_buf, Multiply(pi, 8)))
                        JSVM__StackPush(pval)
                    } ElseBlock: {
                        JSVM__StackPush(JSRT_Undefined())
                    }
                    pi = Add(pi, 1)
                }

                // arguments object for method call (skip for arrows — bit 28)
                // M50: honor unmapped bit 30 (defaults/rest/dstr) like CALL
                map_n = BitwiseAnd(func_params, 268435455)
                unmapped_cm = BitwiseAnd(func_params, 1073741824)
                rest_cm = BitwiseAnd(func_params, 2147483648)
                IfCondition NotEqual(unmapped_cm, 0) ThenBlock: {
                    map_n = 0
                } ElseBlock: {
                    IfCondition NotEqual(rest_cm, 0) ThenBlock: {
                        map_n = Subtract(BitwiseAnd(func_params, 268435455), 1)
                    }
                }
                IfCondition LessThan(map_n, 0) ThenBlock: { map_n = 0 }
                IfCondition EqualTo(BitwiseAnd(func_params, 268435456), 0) ThenBlock: {
                    args_obj = JSVM_CreateArguments(arg_buf, argc, func_val, map_n)
                    JSVM__SaveArguments()
                    JSVM__SetGlobal("arguments", args_obj)
                    IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                        fi_a = Subtract(JSVMState.fp, 1)
                        env_a = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi_a, 8)))
                        IfCondition NotEqual(env_a, 0) ThenBlock: {
                            JSRT_ObjSet(env_a, "arguments", args_obj)
                        }
                    }
                } ElseBlock: {
                    JSVM__SaveArguments()
                }

                // Jump to function code (interpreter fallback)
                JSVM__EnterFuncCode(func_val)
                JSVMState.pc = func_bc
                ReturnValue(1)
            }

            // YIELD (73) — generator yield
            // Pop value from stack, save VM state to active generator, return {value, done:false}
            Case 73: {
                yield_val = JSVM__StackPop()

                // Get the active generator state block
                gs = JSVMGen.active_gs
                IfCondition EqualTo(gs, 0) ThenBlock: {
                    // Not in a generator — treat as return
                    JSVM__StackPush(yield_val)
                    JSVMState.halted = 1
                    ReturnValue(0)
                }

                // Save current VM state into generator state block
                StoreValue(Add(gs, 32), JSVMState.pc)
                StoreValue(Add(gs, 40), JSVMState.sp)
                StoreValue(Add(gs, 48), JSVMState.fp)

                // Copy stack to generator's private stack
                gen_stk = Dereference(Add(gs, 56))
                copy_sz = Multiply(JSVMState.sp, 8)
                IfCondition GreaterThan(copy_sz, 0) ThenBlock: {
                    MemoryCopy(gen_stk, JSVMState.stack, copy_sz)
                }

                // Copy frames to generator's private frames
                gen_frm = Dereference(Add(gs, 88))
                frm_copy_sz = Multiply(JSVMState.fp, JSVMConst.FRAME_SIZE)
                IfCondition GreaterThan(frm_copy_sz, 0) ThenBlock: {
                    MemoryCopy(gen_frm, JSVMState.frames, frm_copy_sz)
                }
                StoreValue(Add(gs, 96), JSVMState.fp)
                // Mole 17: save frame_envs / frame_funcs / frame_args
                side_sz = Multiply(JSVMState.fp, 8)
                IfCondition GreaterThan(side_sz, 0) ThenBlock: {
                    gen_envs = Dereference(Add(gs, 128))
                    gen_funcs = Dereference(Add(gs, 136))
                    gen_fargs = Dereference(Add(gs, 144))
                    IfCondition NotEqual(gen_envs, 0) ThenBlock: {
                        MemoryCopy(gen_envs, JSVMClosure.frame_envs, side_sz)
                    }
                    IfCondition NotEqual(gen_funcs, 0) ThenBlock: {
                        MemoryCopy(gen_funcs, JSVMClosure.frame_funcs, side_sz)
                    }
                    IfCondition NotEqual(gen_fargs, 0) ThenBlock: {
                        MemoryCopy(gen_fargs, JSVMClosure.frame_args, side_sz)
                    }
                }

                // Mark as suspended-yield
                StoreValue(gs, JSGenConst.ST_SUSPENDED_YIELD)
                // M56: save try handlers so finally works after resume (and across CallFunc)
                nexc = JSVMState.exc_sp
                IfCondition GreaterThan(nexc, JSGenConst.EXC_SAVE_MAX) ThenBlock: {
                    nexc = JSGenConst.EXC_SAVE_MAX
                }
                StoreValue(Add(gs, JSGenConst.OFF_EXC_SP), nexc)
                IfCondition GreaterThan(nexc, 0) ThenBlock: {
                    MemoryCopy(Add(gs, JSGenConst.OFF_EXC_DATA), JSVMState.exc_stack, Multiply(nexc, 32))
                }

                // Restore caller state
                JSVMState.pc = JSVMGen.caller_pc
                JSVMState.sp = JSVMGen.caller_sp
                JSVMState.fp = JSVMGen.caller_fp
                // Restore caller stack
                caller_stk_sz = Multiply(JSVMGen.caller_sp, 8)
                IfCondition GreaterThan(caller_stk_sz, 0) ThenBlock: {
                    MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, caller_stk_sz)
                }
                // Restore caller frames
                caller_frm_sz = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
                IfCondition GreaterThan(caller_frm_sz, 0) ThenBlock: {
                    MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, caller_frm_sz)
                }

                // Clear active generator
                JSVMGen.active_gs = 0
                JSVMGen.is_gen_exec = 0

                // Create result: {value: yield_val, done: false}
                iter_result = JSRT_CreateIterResult(yield_val, 0)
                JSVM__StackPush(iter_result)
                ReturnValue(1)
            }

            // YIELD_STAR (98) — M26k.11 + M110 async GetIterator protocol
            // Sync gens: IterableToArray materialization.
            // Async gens (gs+104): prefer @@asyncIterator, else @@iterator;
            // loop next()+Await, GeneratorYield each value until done.
            Case 98: {
                gs = JSVMGen.active_gs
                IfCondition EqualTo(gs, 0) ThenBlock: {
                    JSVM__StackPop()
                    JSVM__StackPush(JSRTState.undef_val)
                    ReturnValue(1)
                }
                ys_ag = Dereference(Add(gs, 104))
                // ─── M110: async generator yield* via iterator protocol ───
                IfCondition EqualTo(ys_ag, 1) ThenBlock: {
                    ys_rec = Dereference(Add(gs, JSGenConst.OFF_YSTAR_ARR))
                    // First entry: GetIterator(obj, async)
                    IfCondition EqualTo(ys_rec, 0) ThenBlock: {
                        src_val = JSVM__StackPop()
                        st_ys = JSRT_GetType(src_val)
                        IfCondition Or(EqualTo(st_ys, JSType.NULL), EqualTo(st_ys, JSType.UNDEFINED)) ThenBlock: {
                            terr = JSVM_CreateTypedError("TypeError", "yield* of null/undefined")
                            JSVM_ThrowValue(terr)
                            ReturnValue(1)
                        }
                        iterator = 0
                        next_fn = 0
                        empty_ys = JSVMCallBuf.buf
                        // Prefer @@asyncIterator (honor defineProperty getters via __get_)
                        used_async = 0
                        IfCondition NotEqual(JSVMSymbol.asyncIterator, 0) ThenBlock: {
                            aik = JSVM_SymbolToKey(JSVMSymbol.asyncIterator)
                            IfCondition NotEqual(aik, 0) ThenBlock: {
                                gk_buf = JSVMCallBuf.getter_buf
                                SetByte(gk_buf, 0, 95)
                                SetByte(gk_buf, 1, 95)
                                SetByte(gk_buf, 2, 103)
                                SetByte(gk_buf, 3, 101)
                                SetByte(gk_buf, 4, 116)
                                SetByte(gk_buf, 5, 95)
                                gki = 0
                                gdone = 0
                                WhileLoop EqualTo(gdone, 0) {
                                    gc = GetByte(aik, gki)
                                    SetByte(gk_buf, Add(6, gki), gc)
                                    IfCondition EqualTo(gc, 0) ThenBlock: {
                                        gdone = 1
                                    }
                                    gki = Add(gki, 1)
                                }
                                JSRT__Push(src_val)
                                getter_ai = JSRT_ObjGet(src_val, gk_buf)
                                src_val = JSRT__Pop()
                                afactory = 0
                                IfCondition EqualTo(JSRT_GetType(getter_ai), JSType.FUNCTION) ThenBlock: {
                                    JSVM__SetGlobal("this", src_val)
                                    JSRT__Push(src_val)
                                    afactory = JSVM__CallFunc(getter_ai, empty_ys, 0)
                                    src_val = JSRT__Pop()
                                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                        ReturnValue(1)
                                    }
                                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                                        ReturnValue(1)
                                    }
                                } ElseBlock: {
                                    JSRT__Push(src_val)
                                    afactory = JSRT_ObjGet(src_val, aik)
                                    src_val = JSRT__Pop()
                                }
                                aft = JSRT_GetType(afactory)
                                IfCondition And(NotEqual(aft, JSType.UNDEFINED), NotEqual(aft, JSType.NULL)) ThenBlock: {
                                    IfCondition NotEqual(aft, JSType.FUNCTION) ThenBlock: {
                                        terr = JSVM_CreateTypedError("TypeError", "@@asyncIterator is not a function")
                                        JSVM_ThrowValue(terr)
                                        ReturnValue(1)
                                    }
                                    JSVM__SetGlobal("this", src_val)
                                    JSRT__Push(src_val)
                                    iterator = JSVM__CallFunc(afactory, empty_ys, 0)
                                    src_val = JSRT__Pop()
                                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                        ReturnValue(1)
                                    }
                                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                                        ReturnValue(1)
                                    }
                                    it_t = JSRT_GetType(iterator)
                                    IfCondition And(NotEqual(it_t, JSType.OBJECT), And(NotEqual(it_t, JSType.FUNCTION), NotEqual(it_t, JSType.ARRAY))) ThenBlock: {
                                        terr = JSVM_CreateTypedError("TypeError", "@@asyncIterator returned non-object")
                                        JSVM_ThrowValue(terr)
                                        ReturnValue(1)
                                    }
                                    used_async = 1
                                }
                            }
                        }
                        // Fallback: no @@asyncIterator → sync IterableToArray materialize
                        // (preserves getter/abrupt GetIterator behavior of M100 path)
                        IfCondition EqualTo(used_async, 0) ThenBlock: {
                            ys_arr = JSVM_IterableToArray(src_val)
                            IfCondition EqualTo(ys_arr, 0) ThenBlock: {
                                ReturnValue(1)
                            }
                            StoreValue(Add(gs, JSGenConst.OFF_YSTAR_ARR), ys_arr)
                            StoreValue(Add(gs, JSGenConst.OFF_YSTAR_IDX), 0)
                            // Fall through to shared array materialization tail (below async branch)
                            // Mark by reusing sync path: clear ag special via jumping to array loop
                            // Implement inline array yield step:
                            ys_idx = 0
                            ys_len = JSRT_ArrLen(ys_arr)
                            IfCondition GreaterEqual(ys_idx, ys_len) ThenBlock: {
                                StoreValue(Add(gs, JSGenConst.OFF_YSTAR_ARR), 0)
                                StoreValue(Add(gs, JSGenConst.OFF_YSTAR_IDX), 0)
                                JSVM__StackPush(JSRTState.undef_val)
                                ReturnValue(1)
                            }
                            yield_val = JSRT_ArrGet(ys_arr, ys_idx)
                            StoreValue(Add(gs, JSGenConst.OFF_YSTAR_IDX), 1)
                            JSVMState.pc = Subtract(JSVMState.pc, 1)
                            StoreValue(Add(gs, 32), JSVMState.pc)
                            StoreValue(Add(gs, 40), JSVMState.sp)
                            StoreValue(Add(gs, 48), JSVMState.fp)
                            gen_stk = Dereference(Add(gs, 56))
                            copy_sz = Multiply(JSVMState.sp, 8)
                            IfCondition GreaterThan(copy_sz, 0) ThenBlock: {
                                MemoryCopy(gen_stk, JSVMState.stack, copy_sz)
                            }
                            gen_frm = Dereference(Add(gs, 88))
                            frm_copy_sz = Multiply(JSVMState.fp, JSVMConst.FRAME_SIZE)
                            IfCondition GreaterThan(frm_copy_sz, 0) ThenBlock: {
                                MemoryCopy(gen_frm, JSVMState.frames, frm_copy_sz)
                            }
                            StoreValue(Add(gs, 96), JSVMState.fp)
                            side_sz = Multiply(JSVMState.fp, 8)
                            IfCondition GreaterThan(side_sz, 0) ThenBlock: {
                                gen_envs = Dereference(Add(gs, 128))
                                gen_funcs = Dereference(Add(gs, 136))
                                gen_fargs = Dereference(Add(gs, 144))
                                IfCondition NotEqual(gen_envs, 0) ThenBlock: {
                                    MemoryCopy(gen_envs, JSVMClosure.frame_envs, side_sz)
                                }
                                IfCondition NotEqual(gen_funcs, 0) ThenBlock: {
                                    MemoryCopy(gen_funcs, JSVMClosure.frame_funcs, side_sz)
                                }
                                IfCondition NotEqual(gen_fargs, 0) ThenBlock: {
                                    MemoryCopy(gen_fargs, JSVMClosure.frame_args, side_sz)
                                }
                            }
                            StoreValue(gs, JSGenConst.ST_SUSPENDED_YIELD)
                            JSVMState.pc = JSVMGen.caller_pc
                            JSVMState.sp = JSVMGen.caller_sp
                            JSVMState.fp = JSVMGen.caller_fp
                            caller_stk_sz = Multiply(JSVMGen.caller_sp, 8)
                            IfCondition GreaterThan(caller_stk_sz, 0) ThenBlock: {
                                MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, caller_stk_sz)
                            }
                            caller_frm_sz = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
                            IfCondition GreaterThan(caller_frm_sz, 0) ThenBlock: {
                                MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, caller_frm_sz)
                            }
                            JSVMGen.active_gs = 0
                            JSVMGen.is_gen_exec = 0
                            iter_result = JSRT_CreateIterResult(yield_val, 0)
                            JSVM__StackPush(iter_result)
                            ReturnValue(1)
                        }
                        // Get next method (honor getter) — asyncIterator path only
                        gk_n = JSVMCallBuf.getter_buf
                        SetByte(gk_n, 0, 95)
                        SetByte(gk_n, 1, 95)
                        SetByte(gk_n, 2, 103)
                        SetByte(gk_n, 3, 101)
                        SetByte(gk_n, 4, 116)
                        SetByte(gk_n, 5, 95)
                        SetByte(gk_n, 6, 110)
                        SetByte(gk_n, 7, 101)
                        SetByte(gk_n, 8, 120)
                        SetByte(gk_n, 9, 116)
                        SetByte(gk_n, 10, 0)
                        JSRT__Push(iterator)
                        gfn_n = JSRT_ObjGet(iterator, gk_n)
                        iterator = JSRT__Pop()
                        IfCondition EqualTo(JSRT_GetType(gfn_n), JSType.FUNCTION) ThenBlock: {
                            JSVM__SetGlobal("this", iterator)
                            JSRT__Push(iterator)
                            next_fn = JSVM__CallFunc(gfn_n, empty_ys, 0)
                            iterator = JSRT__Pop()
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                ReturnValue(1)
                            }
                            IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                                ReturnValue(1)
                            }
                        } ElseBlock: {
                            JSRT__Push(iterator)
                            next_fn = JSRT_ObjGet(iterator, "next")
                            iterator = JSRT__Pop()
                        }
                        ys_rec = JSRT_CreateObject()
                        JSRT_ObjSet(ys_rec, "__it__", iterator)
                        JSRT_ObjSet(ys_rec, "__n__", next_fn)
                        JSRT_ObjSet(ys_rec, "__m__", JSRT_CreateNumber(2))
                        StoreValue(Add(gs, JSGenConst.OFF_YSTAR_ARR), ys_rec)
                        StoreValue(Add(gs, JSGenConst.OFF_YSTAR_IDX), 0)
                    } ElseBlock: {
                        // Resume: if array materialization (ARRAY type), use array path
                        ys_rec = Dereference(Add(gs, JSGenConst.OFF_YSTAR_ARR))
                        IfCondition EqualTo(JSRT_GetType(ys_rec), JSType.ARRAY) ThenBlock: {
                            IfCondition GreaterThan(JSVMState.sp, 0) ThenBlock: {
                                JSVM__StackPop()
                            }
                            ys_arr = ys_rec
                            ys_idx = Dereference(Add(gs, JSGenConst.OFF_YSTAR_IDX))
                            ys_len = JSRT_ArrLen(ys_arr)
                            IfCondition GreaterEqual(ys_idx, ys_len) ThenBlock: {
                                StoreValue(Add(gs, JSGenConst.OFF_YSTAR_ARR), 0)
                                StoreValue(Add(gs, JSGenConst.OFF_YSTAR_IDX), 0)
                                JSVM__StackPush(JSRTState.undef_val)
                                ReturnValue(1)
                            }
                            yield_val = JSRT_ArrGet(ys_arr, ys_idx)
                            StoreValue(Add(gs, JSGenConst.OFF_YSTAR_IDX), Add(ys_idx, 1))
                            JSVMState.pc = Subtract(JSVMState.pc, 1)
                            StoreValue(Add(gs, 32), JSVMState.pc)
                            StoreValue(Add(gs, 40), JSVMState.sp)
                            StoreValue(Add(gs, 48), JSVMState.fp)
                            gen_stk = Dereference(Add(gs, 56))
                            copy_sz = Multiply(JSVMState.sp, 8)
                            IfCondition GreaterThan(copy_sz, 0) ThenBlock: {
                                MemoryCopy(gen_stk, JSVMState.stack, copy_sz)
                            }
                            gen_frm = Dereference(Add(gs, 88))
                            frm_copy_sz = Multiply(JSVMState.fp, JSVMConst.FRAME_SIZE)
                            IfCondition GreaterThan(frm_copy_sz, 0) ThenBlock: {
                                MemoryCopy(gen_frm, JSVMState.frames, frm_copy_sz)
                            }
                            StoreValue(Add(gs, 96), JSVMState.fp)
                            side_sz = Multiply(JSVMState.fp, 8)
                            IfCondition GreaterThan(side_sz, 0) ThenBlock: {
                                gen_envs = Dereference(Add(gs, 128))
                                gen_funcs = Dereference(Add(gs, 136))
                                gen_fargs = Dereference(Add(gs, 144))
                                IfCondition NotEqual(gen_envs, 0) ThenBlock: {
                                    MemoryCopy(gen_envs, JSVMClosure.frame_envs, side_sz)
                                }
                                IfCondition NotEqual(gen_funcs, 0) ThenBlock: {
                                    MemoryCopy(gen_funcs, JSVMClosure.frame_funcs, side_sz)
                                }
                                IfCondition NotEqual(gen_fargs, 0) ThenBlock: {
                                    MemoryCopy(gen_fargs, JSVMClosure.frame_args, side_sz)
                                }
                            }
                            StoreValue(gs, JSGenConst.ST_SUSPENDED_YIELD)
                            JSVMState.pc = JSVMGen.caller_pc
                            JSVMState.sp = JSVMGen.caller_sp
                            JSVMState.fp = JSVMGen.caller_fp
                            caller_stk_sz = Multiply(JSVMGen.caller_sp, 8)
                            IfCondition GreaterThan(caller_stk_sz, 0) ThenBlock: {
                                MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, caller_stk_sz)
                            }
                            caller_frm_sz = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
                            IfCondition GreaterThan(caller_frm_sz, 0) ThenBlock: {
                                MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, caller_frm_sz)
                            }
                            JSVMGen.active_gs = 0
                            JSVMGen.is_gen_exec = 0
                            iter_result = JSRT_CreateIterResult(yield_val, 0)
                            JSVM__StackPush(iter_result)
                            ReturnValue(1)
                        }
                        // Protocol resume: discard outer .next() argument
                        IfCondition GreaterThan(JSVMState.sp, 0) ThenBlock: {
                            JSVM__StackPop()
                        }
                    }
                    // Call next() — protocol mode only
                    iterator = JSRT_ObjGet(ys_rec, "__it__")
                    next_fn = JSRT_ObjGet(ys_rec, "__n__")
                    IfCondition NotEqual(JSRT_GetType(next_fn), JSType.FUNCTION) ThenBlock: {
                        StoreValue(Add(gs, JSGenConst.OFF_YSTAR_ARR), 0)
                        terr = JSVM_CreateTypedError("TypeError", "iterator.next is not a function")
                        JSVM_ThrowValue(terr)
                        ReturnValue(1)
                    }
                    JSVM__SetGlobal("this", iterator)
                    empty_yn = JSVMCallBuf.buf
                    JSRT__Push(ys_rec)
                    JSRT__Push(gs)
                    res = JSVM__CallFunc(next_fn, empty_yn, 0)
                    gs = JSRT__Pop()
                    ys_rec = JSRT__Pop()
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        StoreValue(Add(gs, JSGenConst.OFF_YSTAR_ARR), 0)
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        StoreValue(Add(gs, JSGenConst.OFF_YSTAR_ARR), 0)
                        ReturnValue(1)
                    }
                    // Await next result (Promise or thenable)
                    JSRT__Push(ys_rec)
                    JSRT__Push(gs)
                    res = JSVM__AwaitValue(res)
                    gs = JSRT__Pop()
                    ys_rec = JSRT__Pop()
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        StoreValue(Add(gs, JSGenConst.OFF_YSTAR_ARR), 0)
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        StoreValue(Add(gs, JSGenConst.OFF_YSTAR_ARR), 0)
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(res, 0) ThenBlock: {
                        StoreValue(Add(gs, JSGenConst.OFF_YSTAR_ARR), 0)
                        IfCondition EqualTo(JSVMState.error, 0) ThenBlock: {
                            terr = JSVM_CreateTypedError("TypeError", "iterator result is not an object")
                            JSVM_ThrowValue(terr)
                        }
                        ReturnValue(1)
                    }
                    rt_res = JSRT_GetType(res)
                    IfCondition And(NotEqual(rt_res, JSType.OBJECT), And(NotEqual(rt_res, JSType.FUNCTION), NotEqual(rt_res, JSType.ARRAY))) ThenBlock: {
                        StoreValue(Add(gs, JSGenConst.OFF_YSTAR_ARR), 0)
                        terr = JSVM_CreateTypedError("TypeError", "iterator result is not an object")
                        JSVM_ThrowValue(terr)
                        ReturnValue(1)
                    }
                    // done / value
                    JSRT__Push(ys_rec)
                    JSRT__Push(gs)
                    JSRT__Push(res)
                    done_v = JSRT_ObjGet(res, "done")
                    res = JSRT__Pop()
                    gs = JSRT__Pop()
                    ys_rec = JSRT__Pop()
                    IfCondition EqualTo(JSRT_IsTruthy(done_v), 1) ThenBlock: {
                        // Exhausted: yield* completion value
                        JSRT__Push(gs)
                        val_v = JSRT_ObjGet(res, "value")
                        gs = JSRT__Pop()
                        StoreValue(Add(gs, JSGenConst.OFF_YSTAR_ARR), 0)
                        StoreValue(Add(gs, JSGenConst.OFF_YSTAR_IDX), 0)
                        JSVM__StackPush(val_v)
                        ReturnValue(1)
                    }
                    JSRT__Push(ys_rec)
                    JSRT__Push(gs)
                    yield_val = JSRT_ObjGet(res, "value")
                    // Spec: await yielded value for async-from-sync; also await if thenable
                    yield_val = JSVM__AwaitValue(yield_val)
                    gs = JSRT__Pop()
                    ys_rec = JSRT__Pop()
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        StoreValue(Add(gs, JSGenConst.OFF_YSTAR_ARR), 0)
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        StoreValue(Add(gs, JSGenConst.OFF_YSTAR_ARR), 0)
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(yield_val, 0) ThenBlock: {
                        yield_val = JSRT_Undefined()
                    }
                    // Rewind PC to re-execute YIELD_STAR on next resume
                    JSVMState.pc = Subtract(JSVMState.pc, 1)
                    StoreValue(Add(gs, 32), JSVMState.pc)
                    StoreValue(Add(gs, 40), JSVMState.sp)
                    StoreValue(Add(gs, 48), JSVMState.fp)
                    gen_stk = Dereference(Add(gs, 56))
                    copy_sz = Multiply(JSVMState.sp, 8)
                    IfCondition GreaterThan(copy_sz, 0) ThenBlock: {
                        MemoryCopy(gen_stk, JSVMState.stack, copy_sz)
                    }
                    gen_frm = Dereference(Add(gs, 88))
                    frm_copy_sz = Multiply(JSVMState.fp, JSVMConst.FRAME_SIZE)
                    IfCondition GreaterThan(frm_copy_sz, 0) ThenBlock: {
                        MemoryCopy(gen_frm, JSVMState.frames, frm_copy_sz)
                    }
                    StoreValue(Add(gs, 96), JSVMState.fp)
                    side_sz = Multiply(JSVMState.fp, 8)
                    IfCondition GreaterThan(side_sz, 0) ThenBlock: {
                        gen_envs = Dereference(Add(gs, 128))
                        gen_funcs = Dereference(Add(gs, 136))
                        gen_fargs = Dereference(Add(gs, 144))
                        IfCondition NotEqual(gen_envs, 0) ThenBlock: {
                            MemoryCopy(gen_envs, JSVMClosure.frame_envs, side_sz)
                        }
                        IfCondition NotEqual(gen_funcs, 0) ThenBlock: {
                            MemoryCopy(gen_funcs, JSVMClosure.frame_funcs, side_sz)
                        }
                        IfCondition NotEqual(gen_fargs, 0) ThenBlock: {
                            MemoryCopy(gen_fargs, JSVMClosure.frame_args, side_sz)
                        }
                    }
                    StoreValue(gs, JSGenConst.ST_SUSPENDED_YIELD)
                    JSVMState.pc = JSVMGen.caller_pc
                    JSVMState.sp = JSVMGen.caller_sp
                    JSVMState.fp = JSVMGen.caller_fp
                    caller_stk_sz = Multiply(JSVMGen.caller_sp, 8)
                    IfCondition GreaterThan(caller_stk_sz, 0) ThenBlock: {
                        MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, caller_stk_sz)
                    }
                    caller_frm_sz = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
                    IfCondition GreaterThan(caller_frm_sz, 0) ThenBlock: {
                        MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, caller_frm_sz)
                    }
                    JSVMGen.active_gs = 0
                    JSVMGen.is_gen_exec = 0
                    iter_result = JSRT_CreateIterResult(yield_val, 0)
                    JSVM__StackPush(iter_result)
                    ReturnValue(1)
                }
                // ─── Sync generator: IterableToArray materialization ───
                ys_arr = Dereference(Add(gs, JSGenConst.OFF_YSTAR_ARR))
                ys_idx = Dereference(Add(gs, JSGenConst.OFF_YSTAR_IDX))
                IfCondition EqualTo(ys_arr, 0) ThenBlock: {
                    src_val = JSVM__StackPop()
                    ys_arr = JSVM_IterableToArray(src_val)
                    IfCondition EqualTo(ys_arr, 0) ThenBlock: {
                        ReturnValue(1)
                    }
                    StoreValue(Add(gs, JSGenConst.OFF_YSTAR_ARR), ys_arr)
                    ys_idx = 0
                    StoreValue(Add(gs, JSGenConst.OFF_YSTAR_IDX), 0)
                } ElseBlock: {
                    IfCondition GreaterThan(JSVMState.sp, 0) ThenBlock: {
                        JSVM__StackPop()
                    }
                }
                ys_len = JSRT_ArrLen(ys_arr)
                IfCondition GreaterEqual(ys_idx, ys_len) ThenBlock: {
                    StoreValue(Add(gs, JSGenConst.OFF_YSTAR_ARR), 0)
                    StoreValue(Add(gs, JSGenConst.OFF_YSTAR_IDX), 0)
                    JSVM__StackPush(JSRTState.undef_val)
                    ReturnValue(1)
                }
                yield_val = JSRT_ArrGet(ys_arr, ys_idx)
                StoreValue(Add(gs, JSGenConst.OFF_YSTAR_IDX), Add(ys_idx, 1))
                JSVMState.pc = Subtract(JSVMState.pc, 1)
                StoreValue(Add(gs, 32), JSVMState.pc)
                StoreValue(Add(gs, 40), JSVMState.sp)
                StoreValue(Add(gs, 48), JSVMState.fp)
                gen_stk = Dereference(Add(gs, 56))
                copy_sz = Multiply(JSVMState.sp, 8)
                IfCondition GreaterThan(copy_sz, 0) ThenBlock: {
                    MemoryCopy(gen_stk, JSVMState.stack, copy_sz)
                }
                gen_frm = Dereference(Add(gs, 88))
                frm_copy_sz = Multiply(JSVMState.fp, JSVMConst.FRAME_SIZE)
                IfCondition GreaterThan(frm_copy_sz, 0) ThenBlock: {
                    MemoryCopy(gen_frm, JSVMState.frames, frm_copy_sz)
                }
                StoreValue(Add(gs, 96), JSVMState.fp)
                side_sz = Multiply(JSVMState.fp, 8)
                IfCondition GreaterThan(side_sz, 0) ThenBlock: {
                    gen_envs = Dereference(Add(gs, 128))
                    gen_funcs = Dereference(Add(gs, 136))
                    gen_fargs = Dereference(Add(gs, 144))
                    IfCondition NotEqual(gen_envs, 0) ThenBlock: {
                        MemoryCopy(gen_envs, JSVMClosure.frame_envs, side_sz)
                    }
                    IfCondition NotEqual(gen_funcs, 0) ThenBlock: {
                        MemoryCopy(gen_funcs, JSVMClosure.frame_funcs, side_sz)
                    }
                    IfCondition NotEqual(gen_fargs, 0) ThenBlock: {
                        MemoryCopy(gen_fargs, JSVMClosure.frame_args, side_sz)
                    }
                }
                StoreValue(gs, JSGenConst.ST_SUSPENDED_YIELD)
                JSVMState.pc = JSVMGen.caller_pc
                JSVMState.sp = JSVMGen.caller_sp
                JSVMState.fp = JSVMGen.caller_fp
                caller_stk_sz = Multiply(JSVMGen.caller_sp, 8)
                IfCondition GreaterThan(caller_stk_sz, 0) ThenBlock: {
                    MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, caller_stk_sz)
                }
                caller_frm_sz = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
                IfCondition GreaterThan(caller_frm_sz, 0) ThenBlock: {
                    MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, caller_frm_sz)
                }
                JSVMGen.active_gs = 0
                JSVMGen.is_gen_exec = 0
                iter_result = JSRT_CreateIterResult(yield_val, 0)
                JSVM__StackPush(iter_result)
                ReturnValue(1)
            }

            // GEN_CLOSURE (74) — like CLOSURE but marks function as generator
            Case 74: {
                cidx = JSVM__Read16()
                cval = JSVM__LoadConst(cidx)
                JSVM__CaptureClosureEnv(cval)
                // Mark the function as a generator by setting env to magic value 71 (0x47 = 'G')
                JSRT_FuncSetEnv(cval, 71)
                // Mole 17: body_start at compiler func_pool +40 (after name_len)
                cpay = JSVM__GetConstPayload(cidx)
                IfCondition NotEqual(cpay, 0) ThenBlock: {
                    bstart = Dereference(Add(cpay, 40))
                    IfCondition GreaterThan(bstart, 0) ThenBlock: {
                        JSRT_FuncSetBodyStart(cval, bstart)
                    }
                    // es_length at compiler pool +48 → runtime desc +80
                    elen = Dereference(Add(cpay, 48))
                    fdesc = Dereference(Add(cval, 8))
                    IfCondition NotEqual(fdesc, 0) ThenBlock: {
                        StoreValue(Add(fdesc, 80), elen)
                    }
                }
                // M88: GeneratorFunction.prototype + empty .prototype → Generator.prototype
                // CreateFunc stamps constructor on .prototype; generators must not.
                IfCondition NotEqual(JSRTState.generator_function_proto, 0) ThenBlock: {
                    JSRT_FuncPropSet(cval, "__proto__", JSRTState.generator_function_proto)
                }
                IfCondition NotEqual(JSRTState.generator_proto, 0) ThenBlock: {
                    gen_p = JSRT_CreateObject()
                    JSRT_ObjSet(gen_p, "__proto__", JSRTState.generator_proto)
                    fdesc = Dereference(Add(cval, 8))
                    IfCondition NotEqual(fdesc, 0) ThenBlock: {
                        StoreValue(Add(fdesc, 48), gen_p)
                    }
                }
                JSVM__StackPush(cval)
                ReturnValue(1)
            }

            // TO_ARRAY (75) — pop iterable, push array of its values
            // Array/string/object(@@iterator) via IterableToArray (Mole 15)
            Case 75: {
                src_val = JSVM__StackPop()
                expanded = JSVM_IterableToArray(src_val)
                IfCondition EqualTo(expanded, 0) ThenBlock: {
                    // throw already set
                    ReturnValue(1)
                }
                JSVM__StackPush(expanded)
                ReturnValue(1)
            }

            // ASYNC_CLOSURE (79) — like CLOSURE but marks function as async
            // Async functions run eagerly to completion (single-threaded cooperative)
            // The return value is wrapped in a resolved Promise
            Case 79: {
                cidx = JSVM__Read16()
                cval = JSVM__LoadConst(cidx)
                JSVM__CaptureClosureEnv(cval)
                // Mark the function as async by setting env to magic value 65 (0x41 = 'A')
                JSRT_FuncSetEnv(cval, 65)
                JSVM__StackPush(cval)
                ReturnValue(1)
            }

            // ASYNC_GEN_CLOSURE (82) — marks function as both async and generator
            // Calling creates an async generator object whose .next() returns Promises
            Case 82: {
                cidx = JSVM__Read16()
                cval = JSVM__LoadConst(cidx)
                JSVM__CaptureClosureEnv(cval)
                // Mark with magic value 66 (0x42 = 'B' = Both async+generator)
                JSRT_FuncSetEnv(cval, 66)
                cpay = JSVM__GetConstPayload(cidx)
                IfCondition NotEqual(cpay, 0) ThenBlock: {
                    bstart = Dereference(Add(cpay, 40))
                    IfCondition GreaterThan(bstart, 0) ThenBlock: {
                        JSRT_FuncSetBodyStart(cval, bstart)
                    }
                    elen = Dereference(Add(cpay, 48))
                    fdesc = Dereference(Add(cval, 8))
                    IfCondition NotEqual(fdesc, 0) ThenBlock: {
                        StoreValue(Add(fdesc, 80), elen)
                    }
                }
                // M88: same GeneratorFunction.prototype wiring as GEN_CLOSURE
                IfCondition NotEqual(JSRTState.generator_function_proto, 0) ThenBlock: {
                    JSRT_FuncPropSet(cval, "__proto__", JSRTState.generator_function_proto)
                }
                IfCondition NotEqual(JSRTState.generator_proto, 0) ThenBlock: {
                    gen_p = JSRT_CreateObject()
                    JSRT_ObjSet(gen_p, "__proto__", JSRTState.generator_proto)
                    fdesc = Dereference(Add(cval, 8))
                    IfCondition NotEqual(fdesc, 0) ThenBlock: {
                        StoreValue(Add(fdesc, 48), gen_p)
                    }
                }
                JSVM__StackPush(cval)
                ReturnValue(1)
            }

            // AWAIT (80) — M110: eager Promise + thenable unwrap via JSVM__AwaitValue
            Case 80: {
                await_val = JSVM__StackPop()
                unwrapped = JSVM__AwaitValue(await_val)
                // 0 means ThrowValue already ran (catch jump or async reject Promise).
                // Do NOT push — that would clobber thrown value on catch stack.
                IfCondition EqualTo(unwrapped, 0) ThenBlock: {
                    ReturnValue(1)
                }
                IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                    ReturnValue(1)
                }
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(1)
                }
                JSVM__StackPush(unwrapped)
                ReturnValue(1)
            }

            // NOP (99)
            Case 99: {
                ReturnValue(1)
            }

            // SUPER_BASE (100) — M50: push [[GetPrototypeOf]]([[HomeObject]])
            // HomeObject = current function's __home_proto__ (set on method define).
            // Falls back to __super__ / __super__.prototype for constructors.
            Case 100: {
                home_sb = 0
                // M128k: direct eval runs with fp=0; use outer method frame (save_fp)
                fi_sb = 0
                IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                    fi_sb = Subtract(JSVMState.fp, 1)
                } ElseBlock: {
                    IfCondition GreaterThan(JSVMEvalState.depth, 0) ThenBlock: {
                        IfCondition GreaterThan(JSVMEvalState.save_fp, 0) ThenBlock: {
                            fi_sb = Subtract(JSVMEvalState.save_fp, 1)
                        }
                    }
                }
                IfCondition And(GreaterEqual(fi_sb, 0), NotEqual(JSVMClosure.frame_funcs, 0)) ThenBlock: {
                    // Only read frame_funcs when we have a real outer/current frame
                    use_fi = 0
                    IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: { use_fi = 1 }
                    IfCondition GreaterThan(JSVMEvalState.depth, 0) ThenBlock: {
                        IfCondition GreaterThan(JSVMEvalState.save_fp, 0) ThenBlock: { use_fi = 1 }
                    }
                    IfCondition EqualTo(use_fi, 1) ThenBlock: {
                        cal_sb = Dereference(Add(JSVMClosure.frame_funcs, Multiply(fi_sb, 8)))
                        IfCondition EqualTo(JSRT_GetType(cal_sb), JSType.FUNCTION) ThenBlock: {
                            home_sb = JSRT_FuncPropGet(cal_sb, "__home_proto__")
                        }
                    }
                }
                ht_sb = JSRT_GetType(home_sb)
                IfCondition Or(EqualTo(ht_sb, JSType.OBJECT), EqualTo(ht_sb, JSType.FUNCTION)) ThenBlock: {
                    proto_sb = JSRT_ObjGet(home_sb, "__proto__")
                    pt_sb = JSRT_GetType(proto_sb)
                    IfCondition Or(EqualTo(pt_sb, JSType.OBJECT), Or(EqualTo(pt_sb, JSType.FUNCTION), EqualTo(pt_sb, JSType.ARRAY))) ThenBlock: {
                        JSVM__StackPush(proto_sb)
                        ReturnValue(1)
                    }
                    // null proto
                    IfCondition EqualTo(pt_sb, JSType.NULL) ThenBlock: {
                        JSVM__StackPush(JSRTState.null_val)
                        ReturnValue(1)
                    }
                    // missing → Object.prototype
                    IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                        JSVM__StackPush(JSRTState.object_proto)
                        ReturnValue(1)
                    }
                    JSVM__StackPush(JSRTState.undef_val)
                    ReturnValue(1)
                }
                // Fallback: class constructor path via global __super__
                gsup_sb = JSVM__GetGlobal("__super__")
                gst_sb = JSRT_GetType(gsup_sb)
                IfCondition EqualTo(gst_sb, JSType.FUNCTION) ThenBlock: {
                    // instance-style: parent.prototype
                    pp_sb = JSRT_FuncPropGet(gsup_sb, "prototype")
                    IfCondition EqualTo(JSRT_GetType(pp_sb), JSType.OBJECT) ThenBlock: {
                        JSVM__StackPush(pp_sb)
                        ReturnValue(1)
                    }
                    JSVM__StackPush(gsup_sb)
                    ReturnValue(1)
                }
                // Last resort: Object.prototype (object methods with missing home)
                IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                    JSVM__StackPush(JSRTState.object_proto)
                    ReturnValue(1)
                }
                JSVM__StackPush(JSRTState.undef_val)
                ReturnValue(1)
            }

            // FRESH_LET_ENV (101) — M59: per-iteration let env for for-of/for-in
            // Stack: [value] → []
            // Operand: const pool index of binding name
            // parent = current env; new env gets name=value; install as cur env
            // Durable gval so escaped closures survive ReclaimScope.
            Case 101: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                fval = JSVM__StackPop()
                parent_e = JSVM__GetCurEnv()
                env_f = JSRT__AllocGlobalValue()
                IfCondition EqualTo(env_f, 0) ThenBlock: {
                    ReturnValue(1)
                }
                ptable_f = PropTable_Alloc()
                StoreValue(env_f, JSType.OBJECT)
                StoreValue(Add(env_f, 8), ptable_f)
                // Link parent for free-var lookup chain
                IfCondition And(NotEqual(parent_e, 0), NotEqual(parent_e, JSRTState.undef_val)) ThenBlock: {
                    pt_f = JSRT_GetType(parent_e)
                    IfCondition Or(EqualTo(pt_f, JSType.OBJECT), EqualTo(pt_f, JSType.FUNCTION)) ThenBlock: {
                        JSRT_ObjSet(env_f, JSVMClosure.parent_key, parent_e)
                    }
                }
                JSRT_ObjSet(env_f, cpay, fval)
                // M128v: let/const TDZ via FRESH_LET_ENV → __lex_ mark (block scope)
                IfCondition And(NotEqual(JSVMClosure.tdz_uninit, 0), EqualTo(fval, JSVMClosure.tdz_uninit)) ThenBlock: {
                    lkb_f = JSVMCallBuf.getter_buf
                    SetByte(lkb_f, 0, 95)
                    SetByte(lkb_f, 1, 95)
                    SetByte(lkb_f, 2, 108)
                    SetByte(lkb_f, 3, 101)
                    SetByte(lkb_f, 4, 120)
                    SetByte(lkb_f, 5, 95)
                    li_f = 0
                    ldone_f = 0
                    WhileLoop EqualTo(ldone_f, 0) {
                        lb_f = GetByte(cpay, li_f)
                        SetByte(lkb_f, Add(6, li_f), lb_f)
                        IfCondition EqualTo(lb_f, 0) ThenBlock: {
                            ldone_f = 1
                        }
                        li_f = Add(li_f, 1)
                    }
                    lk_len_f = Add(6, li_f)
                    lk_st_f = JSRT__StrSlabAlloc(lk_len_f)
                    IfCondition NotEqual(lk_st_f, 0) ThenBlock: {
                        MemoryCopy(lk_st_f, lkb_f, lk_len_f)
                        JSRT_ObjSet(env_f, lk_st_f, JSRTState.true_val)
                    }
                }
                JSVM__SetCurEnv(env_f)
                ReturnValue(1)
            }

            // PUSH_TDZ_UNINIT (102) — M60: push TDZ sentinel for env mark
            Case 102: {
                IfCondition EqualTo(JSVMClosure.tdz_uninit, 0) ThenBlock: {
                    JSVM__StackPush(JSRTState.undef_val)
                } ElseBlock: {
                    JSVM__StackPush(JSVMClosure.tdz_uninit)
                }
                ReturnValue(1)
            }

            // RESTORE_ENV (103) — M62: cur env = parent (after for-of head TDZ)
            Case 103: {
                cur_e = JSVM__GetCurEnv()
                IfCondition And(NotEqual(cur_e, 0), NotEqual(cur_e, JSRTState.undef_val)) ThenBlock: {
                    IfCondition EqualTo(JSRT_GetType(cur_e), JSType.OBJECT) ThenBlock: {
                        par_e = JSRT_ObjGet(cur_e, JSVMClosure.parent_key)
                        pt_e = JSRT_GetType(par_e)
                        IfCondition Or(EqualTo(pt_e, JSType.OBJECT), EqualTo(pt_e, JSType.FUNCTION)) ThenBlock: {
                            JSVM__SetCurEnv(par_e)
                        }
                    }
                }
                ReturnValue(1)
            }

            // WITH_PUSH (121) — M128d: [obj] → ObjectEnv with __with__=obj, parent=cur
            Case 121: {
                wobj = JSVM__StackPop()
                // ToObject — null/undefined TypeError; box primitives
                wt = JSRT_GetType(wobj)
                IfCondition Or(EqualTo(wt, JSType.NULL), EqualTo(wt, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                IfCondition Or(EqualTo(wt, JSType.NUMBER), Or(EqualTo(wt, JSType.STRING), EqualTo(wt, JSType.BOOLEAN))) ThenBlock: {
                    box = JSRT_CreateObject()
                    IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                        JSRT_ObjSet(box, "__proto__", JSRTState.object_proto)
                    }
                    wobj = box
                }
                parent_w = JSVM__GetCurEnv()

                env_w = JSRT__AllocGlobalValue()
                IfCondition EqualTo(env_w, 0) ThenBlock: {
                    ReturnValue(1)
                }
                ptable_w = PropTable_Alloc()
                StoreValue(env_w, JSType.OBJECT)
                StoreValue(Add(env_w, 8), ptable_w)
                IfCondition And(NotEqual(parent_w, 0), NotEqual(parent_w, JSRTState.undef_val)) ThenBlock: {
                    IfCondition EqualTo(JSRT_GetType(parent_w), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(env_w, JSVMClosure.parent_key, parent_w)
                    }
                }
                JSRT_ObjSet(env_w, "__with__", wobj)
                JSVM__SetCurEnv(env_w)
                ReturnValue(1)
            }

            // WITH_POP (122) — M128d: restore parent env after with body
            Case 122: {
                cur_w = JSVM__GetCurEnv()
                IfCondition And(NotEqual(cur_w, 0), NotEqual(cur_w, JSRTState.undef_val)) ThenBlock: {
                    IfCondition EqualTo(JSRT_GetType(cur_w), JSType.OBJECT) ThenBlock: {
                        par_w = JSRT_ObjGet(cur_w, JSVMClosure.parent_key)
                        pt_w = JSRT_GetType(par_w)
                        IfCondition Or(EqualTo(pt_w, JSType.OBJECT), EqualTo(pt_w, JSType.FUNCTION)) ThenBlock: {
                            JSVM__SetCurEnv(par_w)
                        }
                    }
                }
                ReturnValue(1)
            }

            // GET_WITH (123) — M128e: resolve IDENT under with
            // Operand: name const; trailing 3-byte slot (0xFFFFFF = none)
            // ObjectEnv first (invoke getters); set JSVMWithRef for PutValue.
            Case 123: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                slot_w = JSVM__Read16()
                JSVMWithRef.valid = 0
                JSVMWithRef.base = 0
                JSVMWithRef.name = 0
                found_w = 0
                gval_w = JSRTState.undef_val
                env_w = JSVM__GetCurEnv()
                hops_w = 0
                WhileLoop And(And(NotEqual(env_w, 0), NotEqual(env_w, JSRTState.undef_val)), LessThan(hops_w, 64)) {
                    IfCondition EqualTo(JSRT_GetType(env_w), JSType.OBJECT) ThenBlock: {
                        wobj = JSRT_ObjGet(env_w, "__with__")
                        wt = JSRT_GetType(wobj)
                        IfCondition Or(EqualTo(wt, JSType.OBJECT), Or(EqualTo(wt, JSType.FUNCTION), EqualTo(wt, JSType.ARRAY))) ThenBlock: {
                            // Has own data or accessor (__get_name)
                            has_bind = 0
                            IfCondition EqualTo(JSRT_ObjHasOnChain(wobj, cpay), 1) ThenBlock: {
                                has_bind = 1
                            }
                            // Build __get_ + name
                            gk = JSVMCallBuf.getter_buf
                            SetByte(gk, 0, 95)
                            SetByte(gk, 1, 95)
                            SetByte(gk, 2, 103)
                            SetByte(gk, 3, 101)
                            SetByte(gk, 4, 116)
                            SetByte(gk, 5, 95)
                            gi = 0
                            gdone = 0
                            WhileLoop EqualTo(gdone, 0) {
                                gb = GetByte(cpay, gi)
                                SetByte(gk, Add(6, gi), gb)
                                IfCondition EqualTo(gb, 0) ThenBlock: { gdone = 1 }
                                gi = Add(gi, 1)
                            }
                            IfCondition EqualTo(has_bind, 0) ThenBlock: {
                                IfCondition EqualTo(JSRT_ObjHasOnChain(wobj, gk), 1) ThenBlock: {
                                    has_bind = 1
                                }
                            }
                            // unscopables skip — M128e6q: Get must invoke accessors + rethrow
                            IfCondition EqualTo(has_bind, 1) ThenBlock: {
                                IfCondition NotEqual(JSVMSymbol.unscopables, 0) ThenBlock: {
                                    uk = JSVM_SymbolToKey(JSVMSymbol.unscopables)
                                    IfCondition NotEqual(uk, 0) ThenBlock: {
                                        JSRT__Push(env_w)
                                        JSRT__Push(wobj)
                                        uobj = JSVM__ObjGetAcc(wobj, uk)
                                        wobj = JSRT__Pop()
                                        env_w = JSRT__Pop()
                                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                            pend_u = JSVMCall.thrown_val
                                            IfCondition EqualTo(pend_u, 0) ThenBlock: { pend_u = JSVMState.exc_val }
                                            IfCondition EqualTo(pend_u, 0) ThenBlock: { pend_u = JSVM__GetGlobal("__pend_exc__") }
                                            JSVMCall.exc_prop = 0
                                            JSVMCall.thrown_val = 0
                                            JSVMState.exc_val = 0
                                            IfCondition And(NotEqual(pend_u, 0), NotEqual(pend_u, JSRTState.undef_val)) ThenBlock: {
                                                JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                                JSVM_ThrowValue(pend_u)
                                            }
                                            ReturnValue(1)
                                        }
                                        ut = JSRT_GetType(uobj)
                                        IfCondition Or(EqualTo(ut, JSType.OBJECT), EqualTo(ut, JSType.FUNCTION)) ThenBlock: {
                                            JSRT__Push(env_w)
                                            JSRT__Push(wobj)
                                            uflag = JSVM__ObjGetAcc(uobj, cpay)
                                            wobj = JSRT__Pop()
                                            env_w = JSRT__Pop()
                                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                                pend_uf = JSVMCall.thrown_val
                                                IfCondition EqualTo(pend_uf, 0) ThenBlock: { pend_uf = JSVMState.exc_val }
                                                IfCondition EqualTo(pend_uf, 0) ThenBlock: { pend_uf = JSVM__GetGlobal("__pend_exc__") }
                                                JSVMCall.exc_prop = 0
                                                JSVMCall.thrown_val = 0
                                                JSVMState.exc_val = 0
                                                IfCondition And(NotEqual(pend_uf, 0), NotEqual(pend_uf, JSRTState.undef_val)) ThenBlock: {
                                                    JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                                    JSVM_ThrowValue(pend_uf)
                                                }
                                                ReturnValue(1)
                                            }
                                            IfCondition EqualTo(JSRT_IsTruthy(uflag), 1) ThenBlock: {
                                                has_bind = 0
                                            }
                                        }
                                    }
                                }
                            }
                            IfCondition EqualTo(has_bind, 1) ThenBlock: {
                                // Capture Reference base before Get (getter may delete)
                                JSVMWithRef.base = wobj
                                JSVMWithRef.name = cpay
                                JSVMWithRef.valid = 1
                                // GetBindingValue: re-HasProperty after unscopables may have deleted
                                still_hb = 0
                                IfCondition EqualTo(JSRT_ObjHasOnChain(wobj, cpay), 1) ThenBlock: {
                                    still_hb = 1
                                }
                                IfCondition EqualTo(still_hb, 0) ThenBlock: {
                                    IfCondition EqualTo(JSRT_ObjHasOnChain(wobj, gk), 1) ThenBlock: {
                                        still_hb = 1
                                    }
                                }
                                IfCondition EqualTo(still_hb, 0) ThenBlock: {
                                    // Missing after unscopables Get: strict → ReferenceError; sloppy → undefined
                                    IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                                        JSVM_ThrowReferenceError("is not defined")
                                        ReturnValue(1)
                                    }
                                    gval_w = JSRTState.undef_val
                                    found_w = 1
                                    hops_w = 64
                                } ElseBlock: {
                                // Invoke getter if present
                                JSRT__Push(env_w)
                                JSRT__Push(wobj)
                                gfn = JSRT_ObjGet(wobj, gk)
                                wobj = JSRT__Pop()
                                env_w = JSRT__Pop()
                                IfCondition EqualTo(JSRT_GetType(gfn), JSType.FUNCTION) ThenBlock: {
                                    save_this_w = JSVM__GetGlobal("this")
                                    JSVM__SetGlobal("this", wobj)
                                    empty_w = JSVMCallBuf.buf
                                    gval_w = JSVM__CallFunc(gfn, empty_w, 0)
                                    JSVM__SetGlobal("this", save_this_w)
                                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                        ReturnValue(1)
                                    }
                                } ElseBlock: {
                                    gval_w = JSRT_ObjGet(wobj, cpay)
                                }
                                found_w = 1
                                hops_w = 64
                                }
                            }
                        }
                        IfCondition EqualTo(found_w, 0) ThenBlock: {
                            env_w = JSRT_ObjGet(env_w, JSVMClosure.parent_key)
                        }
                    } ElseBlock: {
                        env_w = 0
                    }
                    hops_w = Add(hops_w, 1)
                }
                IfCondition EqualTo(found_w, 1) ThenBlock: {
                    JSVM__StackPush(gval_w)
                    ReturnValue(1)
                }
                // Fall back: local slot if valid
                IfCondition NotEqual(slot_w, 16777215) ThenBlock: {
                    // TDZ check
                    lval = JSVM__GetLocal(slot_w)
                    IfCondition And(NotEqual(JSVMClosure.tdz_uninit, 0), EqualTo(lval, JSVMClosure.tdz_uninit)) ThenBlock: {
                        JSVM_ThrowReferenceError("Cannot access variable before initialization")
                        ReturnValue(1)
                    }
                    JSVM__StackPush(lval)
                    ReturnValue(1)
                }
                // Global
                has_g = JSVM__HasGlobal(cpay)
                IfCondition EqualTo(has_g, 0) ThenBlock: {
                    JSVM_ThrowReferenceError("is not defined")
                    ReturnValue(1)
                }
                JSVM__StackPush(JSVM__GetGlobal(cpay))
                ReturnValue(1)
            }

            // SET_WITH (124) — M128e: PutValue under with
            // If WithRef.valid from matching GET_WITH, put on that base even if deleted.
            // Else with-object HasBinding → put; else local/global/const.
            // put_done: never dual-write outer after object put.
            Case 124: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                slot_s = JSVM__Read16()
                sval = JSVM__StackPop()
                put_done = 0

                // 1) Captured Reference from GET_WITH (name by content, not ptr)
                IfCondition EqualTo(JSVMWithRef.valid, 1) ThenBlock: {
                    name_ok = 0
                    IfCondition EqualTo(JSVMWithRef.name, cpay) ThenBlock: { name_ok = 1 }
                    IfCondition EqualTo(name_ok, 0) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrEq(JSVMWithRef.name, cpay), 1) ThenBlock: { name_ok = 1 }
                    }
                    IfCondition EqualTo(name_ok, 1) ThenBlock: {
                        base_p = JSVMWithRef.base
                        JSVMWithRef.valid = 0
                        sk = JSVMCallBuf.getter_buf
                        SetByte(sk, 0, 95)
                        SetByte(sk, 1, 95)
                        SetByte(sk, 2, 115)
                        SetByte(sk, 3, 101)
                        SetByte(sk, 4, 116)
                        SetByte(sk, 5, 95)
                        si = 0
                        sdone = 0
                        WhileLoop EqualTo(sdone, 0) {
                            sb = GetByte(cpay, si)
                            SetByte(sk, Add(6, si), sb)
                            IfCondition EqualTo(sb, 0) ThenBlock: { sdone = 1 }
                            si = Add(si, 1)
                        }
                        sfn = JSRT_ObjGet(base_p, sk)
                        IfCondition EqualTo(JSRT_GetType(sfn), JSType.FUNCTION) ThenBlock: {
                            save_this_s = JSVM__GetGlobal("this")
                            JSVM__SetGlobal("this", base_p)
                            abuf = JSVMCallBuf.buf
                            StoreValue(abuf, sval)
                            JSVM__CallFunc(sfn, abuf, 1)
                            JSVM__SetGlobal("this", save_this_s)
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                ReturnValue(1)
                            }
                            put_done = 1
                        }
                        IfCondition EqualTo(put_done, 0) ThenBlock: {
                            JSRT_ObjSet(base_p, cpay, sval)
                            put_done = 1
                        }
                    }
                }
                JSVMWithRef.valid = 0
                // 2) Live with binding
                IfCondition EqualTo(put_done, 0) ThenBlock: {
                    env_s = JSVM__GetCurEnv()
                    hops_s = 0
                    WhileLoop And(And(And(NotEqual(env_s, 0), NotEqual(env_s, JSRTState.undef_val)), LessThan(hops_s, 64)), EqualTo(put_done, 0)) {
                        IfCondition EqualTo(JSRT_GetType(env_s), JSType.OBJECT) ThenBlock: {
                            wos = JSRT_ObjGet(env_s, "__with__")
                            wts = JSRT_GetType(wos)
                            IfCondition Or(EqualTo(wts, JSType.OBJECT), Or(EqualTo(wts, JSType.FUNCTION), EqualTo(wts, JSType.ARRAY))) ThenBlock: {
                                has_b = 0
                                IfCondition EqualTo(JSRT_ObjHasOnChain(wos, cpay), 1) ThenBlock: { has_b = 1 }
                                sk2 = JSVMCallBuf.getter_buf
                                SetByte(sk2, 0, 95)
                                SetByte(sk2, 1, 95)
                                SetByte(sk2, 2, 103)
                                SetByte(sk2, 3, 101)
                                SetByte(sk2, 4, 116)
                                SetByte(sk2, 5, 95)
                                si2 = 0
                                sd2 = 0
                                WhileLoop EqualTo(sd2, 0) {
                                    sb2 = GetByte(cpay, si2)
                                    SetByte(sk2, Add(6, si2), sb2)
                                    IfCondition EqualTo(sb2, 0) ThenBlock: { sd2 = 1 }
                                    si2 = Add(si2, 1)
                                }
                                IfCondition EqualTo(has_b, 0) ThenBlock: {
                                    IfCondition EqualTo(JSRT_ObjHasOnChain(wos, sk2), 1) ThenBlock: { has_b = 1 }
                                }
                                // M128e6q: HasBinding unscopables Get (accessors + rethrow)
                                IfCondition EqualTo(has_b, 1) ThenBlock: {
                                    IfCondition NotEqual(JSVMSymbol.unscopables, 0) ThenBlock: {
                                        uk_s = JSVM_SymbolToKey(JSVMSymbol.unscopables)
                                        IfCondition NotEqual(uk_s, 0) ThenBlock: {
                                            JSRT__Push(env_s)
                                            JSRT__Push(wos)
                                            JSRT__Push(sval)
                                            uobj_s = JSVM__ObjGetAcc(wos, uk_s)
                                            sval = JSRT__Pop()
                                            wos = JSRT__Pop()
                                            env_s = JSRT__Pop()
                                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                                pend_us = JSVMCall.thrown_val
                                                IfCondition EqualTo(pend_us, 0) ThenBlock: { pend_us = JSVMState.exc_val }
                                                IfCondition EqualTo(pend_us, 0) ThenBlock: { pend_us = JSVM__GetGlobal("__pend_exc__") }
                                                JSVMCall.exc_prop = 0
                                                JSVMCall.thrown_val = 0
                                                JSVMState.exc_val = 0
                                                IfCondition And(NotEqual(pend_us, 0), NotEqual(pend_us, JSRTState.undef_val)) ThenBlock: {
                                                    JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                                    JSVM_ThrowValue(pend_us)
                                                }
                                                ReturnValue(1)
                                            }
                                            ut_s = JSRT_GetType(uobj_s)
                                            IfCondition Or(EqualTo(ut_s, JSType.OBJECT), EqualTo(ut_s, JSType.FUNCTION)) ThenBlock: {
                                                JSRT__Push(env_s)
                                                JSRT__Push(wos)
                                                JSRT__Push(sval)
                                                uflag_s = JSVM__ObjGetAcc(uobj_s, cpay)
                                                sval = JSRT__Pop()
                                                wos = JSRT__Pop()
                                                env_s = JSRT__Pop()
                                                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                                    pend_ufs = JSVMCall.thrown_val
                                                    IfCondition EqualTo(pend_ufs, 0) ThenBlock: { pend_ufs = JSVMState.exc_val }
                                                    IfCondition EqualTo(pend_ufs, 0) ThenBlock: { pend_ufs = JSVM__GetGlobal("__pend_exc__") }
                                                    JSVMCall.exc_prop = 0
                                                    JSVMCall.thrown_val = 0
                                                    JSVMState.exc_val = 0
                                                    IfCondition And(NotEqual(pend_ufs, 0), NotEqual(pend_ufs, JSRTState.undef_val)) ThenBlock: {
                                                        JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                                        JSVM_ThrowValue(pend_ufs)
                                                    }
                                                    ReturnValue(1)
                                                }
                                                IfCondition EqualTo(JSRT_IsTruthy(uflag_s), 1) ThenBlock: {
                                                    has_b = 0
                                                }
                                            }
                                        }
                                    }
                                }
                                IfCondition EqualTo(has_b, 1) ThenBlock: {
                                    // SetMutableBinding: re-HasProperty after unscopables may have deleted
                                    still_sb = 0
                                    IfCondition EqualTo(JSRT_ObjHasOnChain(wos, cpay), 1) ThenBlock: {
                                        still_sb = 1
                                    }
                                    IfCondition EqualTo(still_sb, 0) ThenBlock: {
                                        IfCondition EqualTo(JSRT_ObjHasOnChain(wos, sk2), 1) ThenBlock: {
                                            still_sb = 1
                                        }
                                    }
                                    IfCondition And(EqualTo(still_sb, 0), EqualTo(JSVMState.is_strict, 1)) ThenBlock: {
                                        JSVM_ThrowReferenceError("is not defined")
                                        ReturnValue(1)
                                    }
                                    sks = JSVMCallBuf.getter_buf
                                    SetByte(sks, 0, 95)
                                    SetByte(sks, 1, 95)
                                    SetByte(sks, 2, 115)
                                    SetByte(sks, 3, 101)
                                    SetByte(sks, 4, 116)
                                    SetByte(sks, 5, 95)
                                    gi_s = 0
                                    gd_s = 0
                                    WhileLoop EqualTo(gd_s, 0) {
                                        gb_s = GetByte(cpay, gi_s)
                                        SetByte(sks, Add(6, gi_s), gb_s)
                                        IfCondition EqualTo(gb_s, 0) ThenBlock: { gd_s = 1 }
                                        gi_s = Add(gi_s, 1)
                                    }
                                    sfn2 = JSRT_ObjGet(wos, sks)
                                    IfCondition EqualTo(JSRT_GetType(sfn2), JSType.FUNCTION) ThenBlock: {
                                        st2 = JSVM__GetGlobal("this")
                                        JSVM__SetGlobal("this", wos)
                                        ab2 = JSVMCallBuf.buf
                                        StoreValue(ab2, sval)
                                        JSVM__CallFunc(sfn2, ab2, 1)
                                        JSVM__SetGlobal("this", st2)
                                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                            ReturnValue(1)
                                        }
                                        put_done = 1
                                    }
                                    IfCondition EqualTo(put_done, 0) ThenBlock: {
                                        JSRT_ObjSet(wos, cpay, sval)
                                        put_done = 1
                                    }
                                }
                            }
                            IfCondition EqualTo(put_done, 0) ThenBlock: {
                                env_s = JSRT_ObjGet(env_s, JSVMClosure.parent_key)
                            }
                        } ElseBlock: {
                            env_s = 0
                        }
                        hops_s = Add(hops_s, 1)
                    }
                }
                // 3) Outer binding only if with object did not take PutValue
                IfCondition EqualTo(put_done, 0) ThenBlock: {
                    box_n = sval
                    IfCondition EqualTo(JSRT_GetType(sval), JSType.NUMBER) ThenBlock: {
                        box_n = JSRT_CreateFloat(JSRT_GetPayload(sval))
                    }
                    // Function-local slot: SetLocal only (A1.2 var p4 must not globalize)
                    IfCondition NotEqual(slot_s, 16777215) ThenBlock: {
                        JSVM__SetLocal(slot_s, box_n)
                        IfCondition EqualTo(JSVMState.fp, 0) ThenBlock: {
                            // M128e6: SetGlobal (not just Hash) so GET_GLOBAL sees update
                            JSVM__SetGlobal(cpay, box_n)
                        }
                    } ElseBlock: {
                        // Free-var or bare global — update cenv chain + script __sl_ + GlobalHash
                        wrote_sw = 0
                        IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                            fi_sw = Subtract(JSVMState.fp, 1)
                            own_sw = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi_sw, 8)))
                            IfCondition And(NotEqual(own_sw, 0), NotEqual(own_sw, JSRTState.undef_val)) ThenBlock: {
                                IfCondition EqualTo(JSRT_ObjHas(own_sw, cpay), 1) ThenBlock: {
                                    JSRT_ObjSet(own_sw, cpay, box_n)
                                    wrote_sw = 1
                                }
                            }
                            IfCondition EqualTo(wrote_sw, 0) ThenBlock: {
                                fval_sw = Dereference(Add(JSVMClosure.frame_funcs, Multiply(fi_sw, 8)))
                                IfCondition NotEqual(fval_sw, 0) ThenBlock: {
                                    env_sw = JSRT_FuncPropGet(fval_sw, JSVMClosure.cenv_key)
                                    hops_sw = 0
                                    WhileLoop And(And(NotEqual(env_sw, 0), NotEqual(env_sw, JSRTState.undef_val)), LessThan(hops_sw, 64)) {
                                        IfCondition EqualTo(JSRT_GetType(env_sw), JSType.OBJECT) ThenBlock: {
                                            IfCondition EqualTo(JSRT_ObjHas(env_sw, cpay), 1) ThenBlock: {
                                                JSRT_ObjSet(env_sw, cpay, box_n)
                                                wrote_sw = 1
                                                slb = JSVMCallBuf.getter_buf
                                                SetByte(slb, 0, 95)
                                                SetByte(slb, 1, 95)
                                                SetByte(slb, 2, 115)
                                                SetByte(slb, 3, 108)
                                                SetByte(slb, 4, 95)
                                                si = 0
                                                sd = 0
                                                WhileLoop EqualTo(sd, 0) {
                                                    sb = GetByte(cpay, si)
                                                    SetByte(slb, Add(5, si), sb)
                                                    IfCondition EqualTo(sb, 0) ThenBlock: { sd = 1 }
                                                    si = Add(si, 1)
                                                }
                                                slot_v = JSRT_ObjGet(env_sw, slb)
                                                IfCondition EqualTo(JSRT_GetType(slot_v), JSType.NUMBER) ThenBlock: {
                                                    slot_n = Float_ToInt(JSRT_GetPayload(slot_v))
                                                    IfCondition EqualTo(env_sw, JSVMClosure.script_env) ThenBlock: {
                                                        StoreValue(Add(JSVMState.stack, Multiply(slot_n, 8)), box_n)
                                                    }
                                                }
                                                hops_sw = 64
                                            }
                                            IfCondition EqualTo(wrote_sw, 0) ThenBlock: {
                                                env_sw = JSRT_ObjGet(env_sw, JSVMClosure.parent_key)
                                            }
                                        } ElseBlock: {
                                            env_sw = 0
                                        }
                                        hops_sw = Add(hops_sw, 1)
                                    }
                                }
                            }
                        }
                        JSVM__SetGlobalHash(cpay, box_n)
                    }
                }
                ReturnValue(1)
            }


            // SET_PROP_SUPER (104) — M69: super.prop = val
            // Stack: [val]. Lookup property/setter on SuperBase; Receiver = this.
            // ES PutValue(SuperReference): base.[[Set]](P, W, thisValue)
            Case 104: {
                cidx = JSVM__Read16()
                JSVMTmp.ptr = JSVM__GetConstPayload(cidx)
                JSVMTmp.val = JSVM__StackPop()
                // SuperBase from current function HomeObject (or outer method during eval)
                home_ss = 0
                fi_ss = 0
                use_ss = 0
                IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                    fi_ss = Subtract(JSVMState.fp, 1)
                    use_ss = 1
                } ElseBlock: {
                    IfCondition GreaterThan(JSVMEvalState.depth, 0) ThenBlock: {
                        IfCondition GreaterThan(JSVMEvalState.save_fp, 0) ThenBlock: {
                            fi_ss = Subtract(JSVMEvalState.save_fp, 1)
                            use_ss = 1
                        }
                    }
                }
                IfCondition And(EqualTo(use_ss, 1), NotEqual(JSVMClosure.frame_funcs, 0)) ThenBlock: {
                    cal_ss = Dereference(Add(JSVMClosure.frame_funcs, Multiply(fi_ss, 8)))
                    IfCondition EqualTo(JSRT_GetType(cal_ss), JSType.FUNCTION) ThenBlock: {
                        home_ss = JSRT_FuncPropGet(cal_ss, "__home_proto__")
                    }
                }
                base_ss = 0
                ht_ss = JSRT_GetType(home_ss)
                IfCondition Or(EqualTo(ht_ss, JSType.OBJECT), EqualTo(ht_ss, JSType.FUNCTION)) ThenBlock: {
                    base_ss = JSRT_ObjGet(home_ss, "__proto__")
                }
                bt_ss = JSRT_GetType(base_ss)
                IfCondition Or(EqualTo(bt_ss, JSType.NULL), EqualTo(bt_ss, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot set super property of null/undefined SuperBase")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                // Receiver = this binding
                recv_ss = JSVM__GetGlobal("this")
                // Look up setter on SuperBase chain: __set_<name>
                sk_ss = JSVMCallBuf.getter_buf
                SetByte(sk_ss, 0, 95)
                SetByte(sk_ss, 1, 95)
                SetByte(sk_ss, 2, 115)
                SetByte(sk_ss, 3, 101)
                SetByte(sk_ss, 4, 116)
                SetByte(sk_ss, 5, 95)
                JSVMTmp.idx = 0
                JSVMTmp.done = 0
                WhileLoop EqualTo(JSVMTmp.done, 0) {
                    JSVMTmp.type = GetByte(JSVMTmp.ptr, JSVMTmp.idx)
                    SetByte(sk_ss, Add(6, JSVMTmp.idx), JSVMTmp.type)
                    IfCondition EqualTo(JSVMTmp.type, 0) ThenBlock: {
                        JSVMTmp.done = 1
                    }
                    JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                }
                JSRT__Push(JSVMTmp.val)
                JSRT__Push(recv_ss)
                JSRT__Push(base_ss)
                setter_ss = JSRT_ObjGet(base_ss, sk_ss)
                base_ss = JSRT__Pop()
                recv_ss = JSRT__Pop()
                JSVMTmp.val = JSRT__Pop()
                IfCondition EqualTo(JSRT_GetType(setter_ss), JSType.FUNCTION) ThenBlock: {
                    // Call setter with this = Receiver (not SuperBase)
                    save_this_ss = JSVM__GetGlobal("this")
                    JSVM__SetGlobal("this", recv_ss)
                    arg_buf_ss = JSVMCallBuf.buf
                    StoreValue(arg_buf_ss, JSVMTmp.val)
                    JSVM__CallFunc(setter_ss, arg_buf_ss, 1)
                    JSVM__SetGlobal("this", save_this_ss)
                    ReturnValue(1)
                }
                // Data property (or no setter): define/set on Receiver (this)
                can_ss = JSBridge_CanAssign(recv_ss, JSVMTmp.ptr)
                IfCondition EqualTo(can_ss, 1) ThenBlock: {
                    JSRT_ObjSet(recv_ss, JSVMTmp.ptr, JSVMTmp.val)
                } ElseBlock: {
                    IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                        terr = JSVM_CreateTypedError("TypeError", "Cannot assign to non-writable property")
                        JSVM_ThrowValue(terr)
                        ReturnValue(1)
                    }
                }
                ReturnValue(1)
            }

            // GET_PROP_SUPER (110) — M128e6d: super.prop get
            // Stack: [..., Receiver, SuperBase] → [..., value]
            // Lookup data/getter on SuperBase chain; invoke getter with this=Receiver.
            Case 110: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                base_gs = JSVM__StackPop()
                recv_gs = JSVM__StackPop()
                bt_gs = JSRT_GetType(base_gs)
                IfCondition Or(EqualTo(bt_gs, JSType.NULL), EqualTo(bt_gs, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot read super property of null/undefined SuperBase")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                // Getter: __get_<name> on SuperBase chain
                gk_gs = JSVMCallBuf.getter_buf
                SetByte(gk_gs, 0, 95)
                SetByte(gk_gs, 1, 95)
                SetByte(gk_gs, 2, 103)
                SetByte(gk_gs, 3, 101)
                SetByte(gk_gs, 4, 116)
                SetByte(gk_gs, 5, 95)
                gi_gs = 0
                gd_gs = 0
                WhileLoop EqualTo(gd_gs, 0) {
                    gb_gs = GetByte(cpay, gi_gs)
                    SetByte(gk_gs, Add(6, gi_gs), gb_gs)
                    IfCondition EqualTo(gb_gs, 0) ThenBlock: { gd_gs = 1 }
                    gi_gs = Add(gi_gs, 1)
                }
                JSRT__Push(recv_gs)
                JSRT__Push(base_gs)
                getter_gs = JSRT_ObjGet(base_gs, gk_gs)
                base_gs = JSRT__Pop()
                recv_gs = JSRT__Pop()
                IfCondition EqualTo(JSRT_GetType(getter_gs), JSType.FUNCTION) ThenBlock: {
                    save_this_gs = JSVM__GetGlobal("this")
                    JSVM__SetGlobal("this", recv_gs)
                    empty_gs = JSVMCallBuf.buf
                    gres_gs = JSVM__CallFunc(getter_gs, empty_gs, 0)
                    JSVM__SetGlobal("this", save_this_gs)
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    JSVM__StackPush(gres_gs)
                    ReturnValue(1)
                }
                // Data property on SuperBase chain
                pval_gs = JSRT_ObjGet(base_gs, cpay)
                JSVM__StackPush(pval_gs)
                ReturnValue(1)
            }

            // CHECK_CTOR (105) — M100: heritage IsConstructor check
            // Stack: [superclass] -> [superclass]; null OK; else must be constructible.
            // M128: Object/Promise-style host bags expose [[Construct]] via __ctor__.
            Case 105: {
                ct_val = JSVM__StackPeek()
                ct_t = JSRT_GetType(ct_val)
                IfCondition EqualTo(ct_t, JSType.NULL) ThenBlock: {
                    ReturnValue(1)
                }
                // Unwrap OBJECT bag → __ctor__ (global Object, etc.)
                IfCondition EqualTo(ct_t, JSType.OBJECT) ThenBlock: {
                    bag_ctor = JSRT_ObjGet(ct_val, "__ctor__")
                    IfCondition EqualTo(JSRT_GetType(bag_ctor), JSType.FUNCTION) ThenBlock: {
                        ct_val = bag_ctor
                        ct_t = JSType.FUNCTION
                    }
                }
                IfCondition EqualTo(ct_t, JSType.FUNCTION) ThenBlock: {
                    ct_env = JSRT_FuncGetEnv(ct_val)
                    bad_ctor = 0
                    IfCondition EqualTo(ct_env, 71) ThenBlock: { bad_ctor = 1 }
                    IfCondition EqualTo(ct_env, 66) ThenBlock: { bad_ctor = 1 }
                    ct_desc = JSRT_GetPayload(ct_val)
                    IfCondition NotEqual(ct_desc, 0) ThenBlock: {
                        IfCondition EqualTo(Dereference(Add(ct_desc, 88)), 4) ThenBlock: {
                            bad_ctor = 1
                        }
                    }
                    IfCondition EqualTo(bad_ctor, 1) ThenBlock: {
                        terr = JSVM_CreateTypedError("TypeError", "Class extends value is not a constructor or null")
                        JSVM_ThrowValue(terr)
                        ReturnValue(1)
                    }
                    ReturnValue(1)
                }
                terr = JSVM_CreateTypedError("TypeError", "Class extends value is not a constructor or null")
                JSVM_ThrowValue(terr)
                ReturnValue(1)
            }

            // DELETE_GLOBAL (106) — M105/M128h: delete IdentReference
            // Dyn env (eval D=true) may delete; global non-configurable → false;
            // missing → true (non-strict unresolvable delete).
            // M128e: with ObjectEnv first — delete binding on with-object.
            Case 106: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                // 0) with ObjectEnvironment — delete own prop on with object
                env_wdel = JSVM__GetCurEnv()
                hops_wd = 0
                WhileLoop And(And(NotEqual(env_wdel, 0), NotEqual(env_wdel, JSRTState.undef_val)), LessThan(hops_wd, 64)) {
                    IfCondition EqualTo(JSRT_GetType(env_wdel), JSType.OBJECT) ThenBlock: {
                        wdel = JSRT_ObjGet(env_wdel, "__with__")
                        wdt = JSRT_GetType(wdel)
                        IfCondition Or(EqualTo(wdt, JSType.OBJECT), Or(EqualTo(wdt, JSType.FUNCTION), EqualTo(wdt, JSType.ARRAY))) ThenBlock: {
                            has_wd = 0
                            IfCondition EqualTo(JSRT_ObjHasOnChain(wdel, cpay), 1) ThenBlock: {
                                has_wd = 1
                            }
                            // accessor-only binding via __get_
                            gk_wd = JSVMCallBuf.getter_buf
                            SetByte(gk_wd, 0, 95)
                            SetByte(gk_wd, 1, 95)
                            SetByte(gk_wd, 2, 103)
                            SetByte(gk_wd, 3, 101)
                            SetByte(gk_wd, 4, 116)
                            SetByte(gk_wd, 5, 95)
                            gi_wd = 0
                            gd_wd = 0
                            WhileLoop EqualTo(gd_wd, 0) {
                                gb_wd = GetByte(cpay, gi_wd)
                                SetByte(gk_wd, Add(6, gi_wd), gb_wd)
                                IfCondition EqualTo(gb_wd, 0) ThenBlock: { gd_wd = 1 }
                                gi_wd = Add(gi_wd, 1)
                            }
                            IfCondition EqualTo(has_wd, 0) ThenBlock: {
                                IfCondition EqualTo(JSRT_ObjHasOnChain(wdel, gk_wd), 1) ThenBlock: {
                                    has_wd = 1
                                }
                            }
                            // unscopables
                            IfCondition EqualTo(has_wd, 1) ThenBlock: {
                                IfCondition NotEqual(JSVMSymbol.unscopables, 0) ThenBlock: {
                                    uk_wd = JSVM_SymbolToKey(JSVMSymbol.unscopables)
                                    IfCondition NotEqual(uk_wd, 0) ThenBlock: {
                                        uo_wd = JSRT_ObjGet(wdel, uk_wd)
                                        IfCondition EqualTo(JSRT_GetType(uo_wd), JSType.OBJECT) ThenBlock: {
                                            IfCondition EqualTo(JSRT_IsTruthy(JSRT_ObjGet(uo_wd, cpay)), 1) ThenBlock: {
                                                has_wd = 0
                                            }
                                        }
                                    }
                                }
                            }
                            IfCondition EqualTo(has_wd, 1) ThenBlock: {
                                // Own configurable? Use attr bits; default true if no bits
                                can_wd = 1
                                IfCondition EqualTo(JSRT_ObjHas(wdel, cpay), 1) ThenBlock: {
                                    bits_wd = JSBridge__GetAttrBits(wdel, cpay)
                                    IfCondition EqualTo(BitwiseAnd(bits_wd, 4), 0) ThenBlock: {
                                        // bit4=configurable; 0 means non-config only if attr recorded
                                        // GetAttrBits 0 often means default configurable for plain props
                                        IfCondition NotEqual(bits_wd, 0) ThenBlock: {
                                            can_wd = 0
                                        }
                                    }
                                }
                                IfCondition EqualTo(can_wd, 1) ThenBlock: {
                                    JSRT_ObjDelete(wdel, cpay)
                                    // drop accessors too
                                    SetByte(gk_wd, 2, 103)
                                    SetByte(gk_wd, 3, 101)
                                    SetByte(gk_wd, 4, 116)
                                    JSRT_ObjDelete(wdel, gk_wd)
                                    SetByte(gk_wd, 2, 115)
                                    SetByte(gk_wd, 3, 101)
                                    SetByte(gk_wd, 4, 116)
                                    JSRT_ObjDelete(wdel, gk_wd)
                                    JSVM__StackPush(JSRT_True())
                                } ElseBlock: {
                                    IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                                        JSVM_ThrowValue(JSVM_CreateTypedError("TypeError", "Cannot delete non-configurable property"))
                                        ReturnValue(1)
                                    }
                                    JSVM__StackPush(JSRT_False())
                                }
                                ReturnValue(1)
                            }
                        }
                        env_wdel = JSRT_ObjGet(env_wdel, JSVMClosure.parent_key)
                    } ElseBlock: {
                        env_wdel = 0
                    }
                    hops_wd = Add(hops_wd, 1)
                }
                // 1) Eval/frame configurable binding
                env_d = JSVM__DynVarEnv()
                IfCondition And(NotEqual(env_d, 0), NotEqual(env_d, JSRTState.undef_val)) ThenBlock: {
                    IfCondition EqualTo(JSRT_ObjHas(env_d, cpay), 1) ThenBlock: {
                        // configurable if __cfg_<name> mark present
                        ckb = JSVMCallBuf.getter_buf
                        SetByte(ckb, 0, 95)
                        SetByte(ckb, 1, 95)
                        SetByte(ckb, 2, 99)
                        SetByte(ckb, 3, 102)
                        SetByte(ckb, 4, 103)
                        SetByte(ckb, 5, 95)
                        ci = 0
                        cdone = 0
                        WhileLoop EqualTo(cdone, 0) {
                            cb = GetByte(cpay, ci)
                            SetByte(ckb, Add(6, ci), cb)
                            IfCondition EqualTo(cb, 0) ThenBlock: {
                                cdone = 1
                            }
                            ci = Add(ci, 1)
                        }
                        IfCondition EqualTo(JSRT_ObjHas(env_d, ckb), 1) ThenBlock: {
                            JSRT_ObjDelete(env_d, cpay)
                            JSRT_ObjDelete(env_d, ckb)
                            JSVM__StackPush(JSRT_True())
                            ReturnValue(1)
                        }
                        JSVM__StackPush(JSRT_False())
                        ReturnValue(1)
                    }
                }
                // 2) Global object property attrs
                gt = GlobalHash_Lookup("globalThis")
                IfCondition EqualTo(gt, -1) ThenBlock: {
                    gt = GlobalHash_Lookup("this")
                }
                IfCondition NotEqual(gt, -1) ThenBlock: {
                    IfCondition EqualTo(JSRT_ObjHas(gt, cpay), 1) ThenBlock: {
                        bits = JSBridge__GetAttrBits(gt, cpay)
                        IfCondition NotEqual(BitwiseAnd(bits, 4), 0) ThenBlock: {
                            JSRT_ObjDelete(gt, cpay)
                            // also drop GlobalHash if present
                            // (no GlobalHash_Delete — leave hash; rare path)
                            JSVM__StackPush(JSRT_True())
                            ReturnValue(1)
                        }
                        JSVM__StackPush(JSRT_False())
                        ReturnValue(1)
                    }
                }
                // 3) GlobalHash-only binding (script vars) → non-configurable
                // Prefer GlobalHash_Lookup so object-fallback HasGlobal does not
                // treat inherited Object.prototype names as non-deletable globals.
                existing_dg = GlobalHash_Lookup(cpay)
                IfCondition NotEqual(existing_dg, -1) ThenBlock: {
                    JSVM__StackPush(JSRT_False())
                } ElseBlock: {
                    JSVM__StackPush(JSRT_True())
                }
                ReturnValue(1)
            }

            // DIRECT_EVAL (108) — M128b: bare eval(code) as direct eval
            // Stack: [arg0, ...] same as CALL; only uses first arg.
            Case 108: {
                de_argc = JSVM__ReadByte()
                // Pop args into buffer (like CALL)
                arg_buf = JSVMCallBuf.buf
                ai = Subtract(de_argc, 1)
                WhileLoop GreaterEqual(ai, 0) {
                    arg_v = JSVM__StackPop()
                    StoreValue(Add(arg_buf, Multiply(ai, 8)), arg_v)
                    ai = Subtract(ai, 1)
                }
                // M128v: save parent is_direct so nested direct eval inside an
                // outer direct eval does not clear the outer's direct flag.
                de_saved_direct = JSVMEvalState.is_direct
                JSVMEvalState.is_direct = 1
                native_result = JSVM_EvalNative(arg_buf, de_argc)
                JSVMEvalState.is_direct = de_saved_direct
                // Propagate exception like CALL native path
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    pend = JSVMCall.thrown_val
                    IfCondition EqualTo(pend, 0) ThenBlock: {
                        pend = JSVMState.exc_val
                    }
                    JSVMCall.thrown_val = 0
                    JSVMState.exc_val = 0
                    JSVMCall.exc_prop = 0
                    IfCondition NotEqual(pend, 0) ThenBlock: {
                        JSVM_ThrowValue(pend)
                    }
                    ReturnValue(1)
                }
                JSVM__StackPush(native_result)
                ReturnValue(1)
            }

            // IMPORT_DYN (107) — M128: dynamic import(specifier[, options])
            // Stack: [spec, options] → [Promise]; imm phase: 0=eval, 1=source, 2=defer
            // HostImportModuleDynamically (test harness): look up global
            // __dynModules[ToString(spec)]; fulfill with NS or reject.
            // ToString abrupt → reject promise (do not throw from ImportCall).
            // options not undefined and not Object → reject TypeError.
            // import.source: Source Text Module GetModuleSource → SyntaxError.
            Case 107: {
                imp_phase = JSVM__ReadByte()
                opts_val = JSVM__StackPop()
                spec_val = JSVM__StackPop()
                // Clear sticky error before ToString
                JSVMState.error = 0
                JSVMCall.exc_prop = 0
                JSVMCall.thrown_val = 0
                spec_str = JSRT_ToString(spec_val)
                // If ToString threw / returned 0 → rejected Promise with reason
                tostr_fail = 0
                rej_reason = 0
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    tostr_fail = 1
                    rej_reason = JSVMCall.thrown_val
                    IfCondition EqualTo(rej_reason, 0) ThenBlock: {
                        rej_reason = JSVMState.exc_val
                    }
                    IfCondition EqualTo(rej_reason, 0) ThenBlock: {
                        rej_reason = JSVM__GetGlobal("__pend_exc__")
                    }
                    JSVMCall.exc_prop = 0
                    JSVMCall.thrown_val = 0
                    JSVMState.exc_val = 0
                    JSVMState.error = 0
                }
                IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                    tostr_fail = 1
                    IfCondition EqualTo(rej_reason, 0) ThenBlock: {
                        rej_reason = JSVMState.exc_val
                    }
                    JSVMState.error = 0
                    JSVMState.exc_val = 0
                }
                IfCondition EqualTo(spec_str, 0) ThenBlock: {
                    tostr_fail = 1
                    IfCondition EqualTo(rej_reason, 0) ThenBlock: {
                        rej_reason = JSVMCall.thrown_val
                    }
                    IfCondition EqualTo(rej_reason, 0) ThenBlock: {
                        rej_reason = JSVM__GetGlobal("__pend_exc__")
                    }
                }
                IfCondition EqualTo(tostr_fail, 1) ThenBlock: {
                    IfCondition EqualTo(rej_reason, 0) ThenBlock: {
                        rej_reason = JSVM_CreateTypedError("TypeError", "ToString failed")
                    }
                    promise = JSBridge__CreatePromise(2, rej_reason)
                    // Clear sticky so immediate AWAIT of this rejected promise works
                    JSVMCall.exc_prop = 0
                    JSVMCall.thrown_val = 0
                    JSVMState.error = 0
                    JSVMState.exc_val = 0
                    JSVM__StackPush(promise)
                    ReturnValue(1)
                }
                // Import attributes 2nd arg: if not undefined, must be Object
                // (null/boolean/number/string/symbol/bigint → reject TypeError).
                opts_t = JSRT_GetType(opts_val)
                IfCondition NotEqual(opts_t, JSType.UNDEFINED) ThenBlock: {
                    opts_ok = 0
                    IfCondition EqualTo(opts_t, JSType.OBJECT) ThenBlock: { opts_ok = 1 }
                    IfCondition EqualTo(opts_t, JSType.ARRAY) ThenBlock: { opts_ok = 1 }
                    IfCondition EqualTo(opts_t, JSType.FUNCTION) ThenBlock: { opts_ok = 1 }
                    IfCondition EqualTo(opts_ok, 0) ThenBlock: {
                        rej = JSVM_CreateTypedError("TypeError", "Import options must be an object")
                        promise = JSBridge__CreatePromise(2, rej)
                        JSVMCall.exc_prop = 0
                        JSVMCall.thrown_val = 0
                        JSVMState.error = 0
                        JSVMState.exc_val = 0
                        JSVM__StackPush(promise)
                        ReturnValue(1)
                    }
                }
                // Build key C-string for property lookup
                key_c = 0
                IfCondition EqualTo(JSRT_GetType(spec_str), JSType.STRING) ThenBlock: {
                    key_c = JSRT_StrToC(JSRT_GetPayload(spec_str))
                }
                mod_val = 0
                found = 0
                IfCondition NotEqual(key_c, 0) ThenBlock: {
                    // globalThis.__dynModules
                    dyn_map = JSVM__GetGlobal("__dynModules")
                    IfCondition NotEqual(dyn_map, 0) ThenBlock: {
                        mt = JSRT_GetType(dyn_map)
                        IfCondition Or(EqualTo(mt, JSType.OBJECT), EqualTo(mt, JSType.ARRAY)) ThenBlock: {
                            mod_val = JSRT_ObjGet(dyn_map, key_c)
                            IfCondition NotEqual(mod_val, 0) ThenBlock: {
                                // Treat undefined as missing
                                IfCondition NotEqual(JSRT_GetType(mod_val), JSType.UNDEFINED) ThenBlock: {
                                    found = 1
                                }
                            }
                        }
                    }
                }
                // Source phase: Source Text Module GetModuleSource always throws
                // SyntaxError (no ModuleSource host objects yet).
                IfCondition EqualTo(imp_phase, 1) ThenBlock: {
                    rej = JSVM_CreateTypedError("SyntaxError", "Source phase import not available")
                    promise = JSBridge__CreatePromise(2, rej)
                    // Clear sticky ToString/exception state so immediate AWAIT works
                    JSVMCall.exc_prop = 0
                    JSVMCall.thrown_val = 0
                    JSVMState.error = 0
                    JSVMState.exc_val = 0
                    JSVM__StackPush(promise)
                    ReturnValue(1)
                }
                // Fulfilled/rejected Promise (phase 0 eval / phase 2 defer ≈ eval)
                IfCondition EqualTo(found, 1) ThenBlock: {
                    promise = JSBridge__CreatePromise(1, mod_val)
                } ElseBlock: {
                    rej = JSVM_CreateTypedError("TypeError", "Cannot find module")
                    promise = JSBridge__CreatePromise(2, rej)
                }
                // ToString abrupt path also lands here after reject create — clear sticky
                // so `await import(obj)` (AWAIT right after IMPORT_DYN) sees clean state.
                JSVMCall.exc_prop = 0
                JSVMCall.thrown_val = 0
                JSVMState.error = 0
                JSVMState.exc_val = 0
                JSVM__StackPush(promise)
                ReturnValue(1)
            }

            // UNKNOWN OPCODE — error
            Default: {
                bad_pc = Subtract(JSVMState.pc, 1)
                PrintMessage("[JSVM] Unknown opcode: ")
                PrintNumber(op)
                PrintMessage(" at pc=")
                PrintNumber(bad_pc)
                PrintMessage("\n")
                // Dump 32 bytes of bytecode context around the error
                dump_start = bad_pc
                IfCondition GreaterThan(dump_start, 16) ThenBlock: {
                    dump_start = Subtract(dump_start, 16)
                }
                IfCondition LessEqual(dump_start, 16) ThenBlock: {
                    dump_start = 0
                }
                dump_end = Add(bad_pc, 16)
                IfCondition GreaterThan(dump_end, JSVMState.code_len) ThenBlock: {
                    dump_end = JSVMState.code_len
                }
                PrintMessage("[JSVM] bytecode [")
                PrintNumber(dump_start)
                PrintMessage("..")
                PrintNumber(dump_end)
                PrintMessage("]: ")
                _di = dump_start
                WhileLoop LessThan(_di, dump_end) {
                    _db = GetByte(JSVMState.code, _di)
                    IfCondition EqualTo(_di, bad_pc) ThenBlock: {
                        PrintMessage(">")
                    }
                    PrintNumber(_db)
                    PrintMessage(" ")
                    _di = Add(_di, 1)
                }
                PrintMessage("\n")
                PrintMessage("[JSVM] sp=")
                PrintNumber(JSVMState.sp)
                PrintMessage(" fp=")
                PrintNumber(JSVMState.fp)
                PrintMessage(" steps=")
                PrintNumber(JSVMState.steps)
                PrintMessage("\n")
                JSVMState.error = 1
                ReturnValue(-1)
            }
        }
    }
}
