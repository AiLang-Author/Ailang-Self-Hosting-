// Library.JSVMDispatch.ailang — Opcode dispatch loop (JSVM_Step)
// Split from Library.JSVM.ailang. FixedPools declared in root file.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// =============================================================================
// STEP — execute a single bytecode instruction
// Returns: 1 = still running, 0 = halted, -1 = error
// =============================================================================
Function.JSVM_Step {
    Output: Integer
    Body: {
        // Check halted/error flags
        IfCondition EqualTo(JSVMState.halted, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Check PC bounds
        IfCondition GreaterEqual(JSVMState.pc, JSVMState.code_len) ThenBlock: {
            JSVMState.halted = 1
            ReturnValue(0)
        }

        // Fetch opcode
        op = JSVM__ReadByte()
        JSVMState.steps = Add(JSVMState.steps, 1)

        // Per-step trace (DEBUG) — disabled (set to unreachable threshold)
        // To enable: lower the threshold below max_steps
        IfCondition GreaterEqual(JSVMState.steps, 999999999) ThenBlock: {
            PrintMessage("[T] s=")
            PrintNumber(JSVMState.steps)
            PrintMessage(" op=")
            PrintNumber(op)
            PrintMessage(" sp=")
            PrintNumber(JSVMState.sp)
            PrintMessage(" pc=")
            PrintNumber(JSVMState.pc)
            PrintMessage("\n")
        }

        // Progress trace (every 5M steps)
        _st = JSVMState.steps
        _mod = Modulo(_st, 5000000)
        IfCondition EqualTo(_mod, 0) ThenBlock: {
            PrintMessage("[STEP] ")
            PrintNumber(_st)
            PrintMessage("\n")
        }

        // Check step limit
        IfCondition GreaterEqual(JSVMState.steps, JSVMState.max_steps) ThenBlock: {
            JSVMState.error = 1
            ReturnValue(-1)
        }

        // Check runtime OOM (val_pool / str_slab / func_slab exhaustion)
        IfCondition EqualTo(JSRTState.oom, 1) ThenBlock: {
            PrintMessage("[JSEngine] OOM at step ")
            PrintNumber(JSVMState.steps)
            PrintMessage(" str=")
            PrintNumber(JSRTState.str_slab_pos)
            PrintMessage("/")
            PrintNumber(JSRTState.str_slab_cap)
            PrintMessage(" vals=")
            PrintNumber(JSRTState.val_count)
            PrintMessage("/")
            PrintNumber(JSRTConst.MAX_VALUES)
            PrintMessage(" func=")
            PrintNumber(JSRTState.func_slab_pos)
            PrintMessage("/")
            PrintNumber(JSRTState.func_slab_cap)
            PrintMessage("\n")
            JSVMState.error = 1
            ReturnValue(-1)
        }

        // =====================================================================
        // OPCODE DISPATCH — Branch (switch) for O(1) dispatch
        // =====================================================================
        Branch op {

            // HALT (0)
            Case 0: {
                JSVMState.halted = 1
                ReturnValue(0)
            }

            // PUSH_CONST (1) — 16-bit operand: constant pool index
            Case 1: {
                cidx = JSVM__Read16()
                cval = JSVM__LoadConst(cidx)
                JSVM__StackPush(cval)
                ReturnValue(1)
            }

            // PUSH_UNDEF (2)
            Case 2: {
                JSVM__StackPush(JSRT_Undefined())
                ReturnValue(1)
            }

            // PUSH_NULL (3)
            Case 3: {
                JSVM__StackPush(JSRT_Null())
                ReturnValue(1)
            }

            // PUSH_TRUE (4)
            Case 4: {
                JSVM__StackPush(JSRT_True())
                ReturnValue(1)
            }

            // PUSH_FALSE (5)
            Case 5: {
                JSVM__StackPush(JSRT_False())
                ReturnValue(1)
            }

            // POP (6)
            Case 6: {
                JSVM__StackPop()
                ReturnValue(1)
            }

            // DUP (7) — duplicate top of stack
            Case 7: {
                top = JSVM__StackPeek()
                JSVM__StackPush(top)
                ReturnValue(1)
            }

            // SWAP (8) — swap top two stack elements
            Case 8: {
                sw_a = JSVM__StackPop()
                sw_b = JSVM__StackPop()
                JSVM__StackPush(sw_a)
                JSVM__StackPush(sw_b)
                ReturnValue(1)
            }

            // GET_LOCAL (10) — 16-bit operand: local slot index
            Case 10: {
                slot = JSVM__Read16()
                lval = JSVM__GetLocal(slot)
                JSVM__StackPush(lval)
                ReturnValue(1)
            }

            // SET_LOCAL (11) — 16-bit operand: local slot index
            Case 11: {
                slot = JSVM__Read16()
                sval = JSVM__StackPop()
                JSVM__SetLocal(slot, sval)
                // Non-strict mapped arguments: keep arguments[slot] in sync
                JSVM_SyncLocalToArguments(slot, sval)
                ReturnValue(1)
            }

            // GET_GLOBAL (12) — unresolvable binding → ReferenceError (spec GetValue)
            // typeof uses GET_GLOBAL_SOFT (84) instead.
            Case 12: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                has_g = JSVM__HasGlobal(cpay)
                IfCondition EqualTo(has_g, 0) ThenBlock: {
                    JSVM_ThrowReferenceError("is not defined")
                    ReturnValue(1)
                }
                gval = JSVM__GetGlobal(cpay)
                JSVM__StackPush(gval)
                ReturnValue(1)
            }

            // GET_GLOBAL_SOFT (84) — missing → undefined (typeof undeclared)
            Case 84: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                gval = JSVM__GetGlobal(cpay)
                JSVM__StackPush(gval)
                ReturnValue(1)
            }

            // SET_GLOBAL (13) — create-or-update binding (var/func/catch/assign non-strict)
            Case 13: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                sval = JSVM__StackPop()
                JSVM__SetGlobal(cpay, sval)
                ReturnValue(1)
            }

            // SET_GLOBAL_ASSIGN (85) — strict assignment to undeclared → ReferenceError
            // Declarations must use SET_GLOBAL (13), never this opcode.
            Case 85: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                sval = JSVM__StackPop()
                IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                    has_g = JSVM__HasGlobal(cpay)
                    IfCondition EqualTo(has_g, 0) ThenBlock: {
                        JSVM_ThrowReferenceError("Assignment to undeclared variable")
                        ReturnValue(1)
                    }
                }
                JSVM__SetGlobal(cpay, sval)
                ReturnValue(1)
            }

            // TO_PROP_KEY (86) — [val] → [string]; ToPropertyKey once for compound assign
            Case 86: {
                k_val = JSVM__StackPop()
                k_ptr = JSVM_ToPropertyKey(k_val)
                IfCondition EqualTo(k_ptr, 0) ThenBlock: {
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        pend = JSVMCall.thrown_val
                        IfCondition EqualTo(pend, 0) ThenBlock: {
                            pend = JSVM__GetGlobal("__pend_exc__")
                        }
                        JSVMCall.thrown_val = 0
                        JSVMCall.exc_prop = 0
                        IfCondition NotEqual(pend, 0) ThenBlock: {
                            IfCondition NotEqual(pend, JSRTState.undef_val) ThenBlock: {
                                JSVM_ThrowValue(pend)
                            }
                        }
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    JSVM__StackPush(JSRT_CreateString(""))
                    ReturnValue(1)
                }
                JSVM__StackPush(JSRT_CreateString(k_ptr))
                ReturnValue(1)
            }

            // CHECK_COERCIBLE (87) — [val] → [val]; TypeError if null/undefined
            // ES5 MemberExpression order: CheckObjectCoercible(base) before key ToString
            Case 87: {
                cv = JSVM__StackPop()
                ct = JSRT_GetType(cv)
                IfCondition Or(EqualTo(ct, JSType.NULL), EqualTo(ct, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot read property of null/undefined")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                JSVM__StackPush(cv)
                ReturnValue(1)
            }

            // GET_FREE (90) — free-var read via callee.__cenv → __parent chain
            // Copy onto a fresh val_pool slot so stack holds an ordinary temporary
            // (pushing the env's gval pointer confused later SET_PROP).
            Case 90: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                start_env = JSRTState.undef_val
                IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                    fi = Subtract(JSVMState.fp, 1)
                    fval = Dereference(Add(JSVMClosure.frame_funcs, Multiply(fi, 8)))
                    IfCondition NotEqual(fval, 0) ThenBlock: {
                        start_env = JSRT_FuncPropGet(fval, JSVMClosure.cenv_key)
                    }
                }
                gval = JSVM__EnvLookup(start_env, cpay)
                IfCondition Or(EqualTo(gval, 0), EqualTo(gval, JSRTState.undef_val)) ThenBlock: {
                    JSVM__StackPush(JSRTState.undef_val)
                } ElseBlock: {
                    IfCondition EqualTo(gval, JSRTState.true_val) ThenBlock: {
                        JSVM__StackPush(gval)
                    } ElseBlock: {
                        IfCondition EqualTo(gval, JSRTState.false_val) ThenBlock: {
                            JSVM__StackPush(gval)
                        } ElseBlock: {
                            IfCondition EqualTo(gval, JSRTState.null_val) ThenBlock: {
                                JSVM__StackPush(gval)
                            } ElseBlock: {
                                copy = JSRT__AllocValue()
                                IfCondition EqualTo(copy, 0) ThenBlock: {
                                    JSVM__StackPush(gval)
                                } ElseBlock: {
                                    StoreValue(copy, Dereference(gval))
                                    StoreValue(Add(copy, 8), Dereference(Add(gval, 8)))
                                    JSVM__StackPush(copy)
                                }
                            }
                        }
                    }
                }
                ReturnValue(1)
            }

            // SET_FRAME_ENV (91) — dual-write own local into current activation env
            // Operand: name const; trailing u16 = local slot (Mole 16 free-var sync)
            Case 91: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                slot_fe = JSVM__Read16()
                sval = JSVM__StackPop()
                IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                    fi = Subtract(JSVMState.fp, 1)
                    env = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi, 8)))
                    IfCondition NotEqual(env, 0) ThenBlock: {
                        JSRT_ObjSet(env, cpay, sval)
                        // Record slot for SET_FREE to update stack local.
                        // Key must be str_slab-stable: PropTable stores the key
                        // pointer; getter_buf is shared and would corrupt the table.
                        slb = JSVMCallBuf.getter_buf
                        SetByte(slb, 0, 95)
                        SetByte(slb, 1, 95)
                        SetByte(slb, 2, 115)
                        SetByte(slb, 3, 108)
                        SetByte(slb, 4, 95)
                        si = 0
                        sdone = 0
                        WhileLoop EqualTo(sdone, 0) {
                            sb = GetByte(cpay, si)
                            SetByte(slb, Add(5, si), sb)
                            IfCondition EqualTo(sb, 0) ThenBlock: {
                                sdone = 1
                            }
                            si = Add(si, 1)
                        }
                        // si includes trailing NUL; key len = 5 + si
                        sl_len = Add(5, si)
                        sl_stable = JSRT__StrSlabAlloc(sl_len)
                        IfCondition NotEqual(sl_stable, 0) ThenBlock: {
                            MemoryCopy(sl_stable, slb, sl_len)
                            JSRT__Push(env)
                            slot_num = JSRT_CreateNumber(slot_fe)
                            env = JSRT__Pop()
                            JSRT_ObjSet(env, sl_stable, slot_num)
                        }
                    }
                }
                ReturnValue(1)
            }

            // SET_FREE (92) — free-var write on __cenv chain
            // Mole 16: also sync stack local of owning frame via __sl_<name>
            Case 92: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                sval = JSVM__StackPop()
                start_env = 0
                IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                    fi = Subtract(JSVMState.fp, 1)
                    fval = Dereference(Add(JSVMClosure.frame_funcs, Multiply(fi, 8)))
                    IfCondition NotEqual(fval, 0) ThenBlock: {
                        start_env = JSRT_FuncPropGet(fval, JSVMClosure.cenv_key)
                    }
                }
                JSVM__EnvAssign(start_env, cpay, sval)
                // Sync stack local: find env that holds binding + __sl_ slot.
                // Re-read value from env after ObjSet — that copy is in gval_pool
                // and survives ReclaimScope. Writing the raw val_pool `sval` from
                // the nested frame would dangle after the callee returns.
                slb = JSVMCallBuf.getter_buf
                SetByte(slb, 0, 95)
                SetByte(slb, 1, 95)
                SetByte(slb, 2, 115)
                SetByte(slb, 3, 108)
                SetByte(slb, 4, 95)
                si = 0
                sdone = 0
                WhileLoop EqualTo(sdone, 0) {
                    sb = GetByte(cpay, si)
                    SetByte(slb, Add(5, si), sb)
                    IfCondition EqualTo(sb, 0) ThenBlock: {
                        sdone = 1
                    }
                    si = Add(si, 1)
                }
                // Walk env chain for __sl_ record (on same env as binding)
                envw = start_env
                hops = 0
                WhileLoop And(NotEqual(envw, 0), LessThan(hops, 64)) {
                    IfCondition EqualTo(envw, JSRTState.undef_val) ThenBlock: {
                        envw = 0
                    }
                    IfCondition NotEqual(envw, 0) ThenBlock: {
                        IfCondition EqualTo(JSRT_GetType(envw), JSType.OBJECT) ThenBlock: {
                            IfCondition EqualTo(JSRT_ObjHas(envw, cpay), 1) ThenBlock: {
                                // Stable value from env (gval_pool)
                                stable_v = JSRT_ObjGet(envw, cpay)
                                slot_v = JSRT_ObjGet(envw, slb)
                                IfCondition EqualTo(JSRT_GetType(slot_v), JSType.NUMBER) ThenBlock: {
                                    slot_n = Float_ToInt(JSRT_GetPayload(slot_v))
                                    // Find frame whose env is envw
                                    fj = 0
                                    WhileLoop LessThan(fj, JSVMState.fp) {
                                        e2 = Dereference(Add(JSVMClosure.frame_envs, Multiply(fj, 8)))
                                        IfCondition EqualTo(e2, envw) ThenBlock: {
                                            // Set local in that frame: locals_base + slot
                                            fbase = Add(JSVMState.frames, Multiply(fj, JSVMConst.FRAME_SIZE))
                                            lb = Dereference(Add(fbase, 16))
                                            saddr = Add(JSVMState.stack, Multiply(Add(lb, slot_n), 8))
                                            StoreValue(saddr, stable_v)
                                            fj = JSVMState.fp
                                        }
                                        fj = Add(fj, 1)
                                    }
                                }
                                hops = 64
                            } ElseBlock: {
                                envw = JSRT_ObjGet(envw, JSVMClosure.parent_key)
                            }
                        } ElseBlock: {
                            envw = 0
                        }
                    }
                    hops = Add(hops, 1)
                }
                ReturnValue(1)
            }

            // OBJ_SPREAD (93) — CopyDataProperties(dest, src) for object spread
            // Stack: [..., dest, src] → [...]  (same net effect as SET_PROP)
            // Compiler pattern is: NEW_OBJECT; (DUP; val/src; SET_PROP|OBJ_SPREAD)*
            // so the base object remains under the DUP — do NOT push dest back
            // (pushing would leave two objects under CALL and break argc).
            // null/undefined src: no-op. Enumerable own keys only (via ObjKeys).
            // Invokes getters (__get_*) when present.
            Case 93: {
                src = JSVM__StackPop()
                dest = JSVM__StackPop()
                src_t = JSRT_GetType(src)
                // Spec: null/undefined → skip (no throw) for object spread;
                // object rest dstr uses RequireObjectCoercible first.
                IfCondition Or(EqualTo(src_t, JSType.NULL), EqualTo(src_t, JSType.UNDEFINED)) ThenBlock: {
                    ReturnValue(1)
                }
                // M20d: string → copy index keys "0".."n-1" (obj-rest-str-val)
                // PropTable stores key *pointers* — must use stable str_slab keys
                // (JSVM__ArgIndexKey), not a reused scratch buffer.
                IfCondition EqualTo(src_t, JSType.STRING) ThenBlock: {
                    sp = JSRT_GetPayload(src)
                    sl = StringLength(sp)
                    si = 0
                    WhileLoop LessThan(si, sl) {
                        JSRT__Push(dest)
                        JSRT__Push(src)
                        JSRT__Push(si)
                        kbuf = JSVM__ArgIndexKey(si)
                        chv = JSRT_CreateStringLen(Add(sp, si), 1)
                        si = JSRT__Pop()
                        src = JSRT__Pop()
                        dest = JSRT__Pop()
                        sp = JSRT_GetPayload(src)
                        IfCondition NotEqual(kbuf, 0) ThenBlock: {
                            JSRT_ObjSet(dest, kbuf, chv)
                        }
                        si = Add(si, 1)
                    }
                    ReturnValue(1)
                }
                // Arrays: copy indexed elements as string keys (stable keys)
                IfCondition EqualTo(src_t, JSType.ARRAY) ThenBlock: {
                    alen = JSRT_ArrLen(src)
                    ai = 0
                    WhileLoop LessThan(ai, alen) {
                        JSRT__Push(dest)
                        JSRT__Push(src)
                        JSRT__Push(ai)
                        kbuf = JSVM__ArgIndexKey(ai)
                        ev = JSRT_ArrGet(src, ai)
                        ai = JSRT__Pop()
                        src = JSRT__Pop()
                        dest = JSRT__Pop()
                        IfCondition NotEqual(kbuf, 0) ThenBlock: {
                            JSRT_ObjSet(dest, kbuf, ev)
                        }
                        ai = Add(ai, 1)
                    }
                    ReturnValue(1)
                }
                // Objects + functions (own enumerable props).
                IfCondition And(NotEqual(src_t, JSType.OBJECT), NotEqual(src_t, JSType.FUNCTION)) ThenBlock: {
                    ReturnValue(1)
                }
                JSRT__Push(dest)
                JSRT__Push(src)
                keys = JSRT_ObjKeys(src)
                src = JSRT__Pop()
                dest = JSRT__Pop()
                klen = JSRT_ArrLen(keys)
                ki = 0
                WhileLoop LessThan(ki, klen) {
                    JSRT__Push(dest)
                    JSRT__Push(src)
                    JSRT__Push(keys)
                    JSRT__Push(ki)
                    ksv = JSRT_ArrGet(keys, ki)
                    ki = JSRT__Pop()
                    keys = JSRT__Pop()
                    src = JSRT__Pop()
                    dest = JSRT__Pop()
                    kp = JSRT_GetPayload(ksv)

                    // Getter support: __get_<name>
                    got_via_getter = 0
                    IfCondition EqualTo(src_t, JSType.OBJECT) ThenBlock: {
                        gk_buf = JSVMCallBuf.getter_buf
                        SetByte(gk_buf, 0, 95)
                        SetByte(gk_buf, 1, 95)
                        SetByte(gk_buf, 2, 103)
                        SetByte(gk_buf, 3, 101)
                        SetByte(gk_buf, 4, 116)
                        SetByte(gk_buf, 5, 95)
                        gki = 0
                        gdone = 0
                        WhileLoop EqualTo(gdone, 0) {
                            gc = GetByte(kp, gki)
                            SetByte(gk_buf, Add(6, gki), gc)
                            IfCondition EqualTo(gc, 0) ThenBlock: {
                                gdone = 1
                            }
                            gki = Add(gki, 1)
                        }
                        JSRT__Push(dest)
                        JSRT__Push(src)
                        JSRT__Push(keys)
                        JSRT__Push(ki)
                        JSRT__Push(ksv)
                        getter_func = JSRT_ObjGet(src, gk_buf)
                        ksv = JSRT__Pop()
                        ki = JSRT__Pop()
                        keys = JSRT__Pop()
                        src = JSRT__Pop()
                        dest = JSRT__Pop()
                        gt = JSRT_GetType(getter_func)
                        IfCondition EqualTo(gt, JSType.FUNCTION) ThenBlock: {
                            JSVM__SetGlobal("this", src)
                            arg_buf_g = JSVMCallBuf.buf
                            JSRT__Push(dest)
                            JSRT__Push(src)
                            JSRT__Push(keys)
                            JSRT__Push(ki)
                            JSRT__Push(ksv)
                            v = JSVM__CallFunc(getter_func, arg_buf_g, 0)
                            ksv = JSRT__Pop()
                            ki = JSRT__Pop()
                            keys = JSRT__Pop()
                            src = JSRT__Pop()
                            dest = JSRT__Pop()
                            kp = JSRT_GetPayload(ksv)
                            JSRT_ObjSet(dest, kp, v)
                            got_via_getter = 1
                        }
                    }
                    IfCondition EqualTo(got_via_getter, 0) ThenBlock: {
                        JSRT__Push(dest)
                        JSRT__Push(keys)
                        JSRT__Push(ki)
                        JSRT__Push(src)
                        v = JSRT_ObjGet(src, kp)
                        src = JSRT__Pop()
                        ki = JSRT__Pop()
                        keys = JSRT__Pop()
                        dest = JSRT__Pop()
                        JSRT_ObjSet(dest, kp, v)
                    }
                    ki = Add(ki, 1)
                }
                ReturnValue(1)
            }

            // GET_ITER (94) — [iterable] → [iter_record]
            // Arrays: fast index cursor when @@iterator is present (default).
            // Missing @@iterator (deleted Array.prototype[Symbol.iterator]) → TypeError.
            Case 94: {
                src = JSVM__StackPop()
                st = JSRT_GetType(src)
                rec = JSRT_CreateObject()
                IfCondition EqualTo(st, JSType.ARRAY) ThenBlock: {
                    // Mole 15: missing @@iterator → TypeError; custom → protocol;
                    // default Array.prototype.values → fast index cursor.
                    use_fast = 1
                    IfCondition NotEqual(JSVMSymbol.iterator, 0) ThenBlock: {
                        iter_key_a = JSVM_SymbolToKey(JSVMSymbol.iterator)
                        IfCondition NotEqual(iter_key_a, 0) ThenBlock: {
                            JSRT__Push(rec)
                            JSRT__Push(src)
                            factory_a = JSRT_ObjGet(src, iter_key_a)
                            src = JSRT__Pop()
                            rec = JSRT__Pop()
                            ft_a = JSRT_GetType(factory_a)
                            IfCondition EqualTo(ft_a, JSType.UNDEFINED) ThenBlock: {
                                terr = JSVM_CreateTypedError("TypeError", "array is not iterable")
                                JSVM_ThrowValue(terr)
                                ReturnValue(1)
                            }
                            IfCondition EqualTo(ft_a, JSType.FUNCTION) ThenBlock: {
                                // Custom if user JS (bc>=0) or generator fn (env 71).
                                // Native Array.prototype.values keeps fast path.
                                fbc_a = JSRT_FuncGetBC(factory_a)
                                fenv_a = JSRT_FuncGetEnv(factory_a)
                                is_custom = 0
                                IfCondition GreaterEqual(fbc_a, 0) ThenBlock: {
                                    is_custom = 1
                                }
                                IfCondition EqualTo(fenv_a, 71) ThenBlock: {
                                    is_custom = 1
                                }
                                IfCondition EqualTo(is_custom, 1) ThenBlock: {
                                    use_fast = 0
                                    JSVM__SetGlobal("this", src)
                                    empty_buf = JSVMCallBuf.buf
                                    JSRT__Push(rec)
                                    iterator = JSVM__CallFunc(factory_a, empty_buf, 0)
                                    rec = JSRT__Pop()
                                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                        ReturnValue(1)
                                    }
                                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                                        ReturnValue(1)
                                    }
                                    IfCondition NotEqual(JSRT_GetType(iterator), JSType.OBJECT) ThenBlock: {
                                        terr = JSVM_CreateTypedError("TypeError", "@@iterator returned non-object")
                                        JSVM_ThrowValue(terr)
                                        ReturnValue(1)
                                    }
                                    JSRT__Push(rec)
                                    JSRT__Push(iterator)
                                    next_fn = JSRT_ObjGet(iterator, "next")
                                    iterator = JSRT__Pop()
                                    rec = JSRT__Pop()
                                    // Defer next-callability to ITER_NEXT (see object path)
                                    JSRT__Push(rec)
                                    JSRT__Push(iterator)
                                    JSRT__Push(next_fn)
                                    mode1a = JSRT_CreateNumber(1)
                                    next_fn = JSRT__Pop()
                                    iterator = JSRT__Pop()
                                    rec = JSRT__Pop()
                                    JSRT_ObjSet(rec, "__m__", mode1a)
                                    JSRT_ObjSet(rec, "__it__", iterator)
                                    JSRT_ObjSet(rec, "__n__", next_fn)
                                    JSVMIter.done = 0
                                    JSVM__GenTrackOpenIter(rec)
                                    JSVM__StackPush(rec)
                                    ReturnValue(1)
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(use_fast, 1) ThenBlock: {
                        JSRT__Push(src)
                        mode0 = JSRT_CreateNumber(0)
                        src = JSRT__Pop()
                        JSRT_ObjSet(rec, "__m__", mode0)
                        JSRT_ObjSet(rec, "__a__", src)
                        JSRT__Push(rec)
                        z0 = JSRT_CreateNumber(0)
                        rec = JSRT__Pop()
                        JSRT_ObjSet(rec, "__i__", z0)
                        JSVMIter.done = 0
                        JSVM__GenTrackOpenIter(rec)
                        JSVM__StackPush(rec)
                        ReturnValue(1)
                    }
                }
                // Strings → treat as array of chars via IterableToArray then array mode
                IfCondition EqualTo(st, JSType.STRING) ThenBlock: {
                    expanded = JSVM_IterableToArray(src)
                    IfCondition EqualTo(expanded, 0) ThenBlock: {
                        ReturnValue(1)
                    }
                    JSRT__Push(expanded)
                    mode0s = JSRT_CreateNumber(0)
                    expanded = JSRT__Pop()
                    JSRT_ObjSet(rec, "__m__", mode0s)
                    JSRT_ObjSet(rec, "__a__", expanded)
                    JSRT__Push(rec)
                    z0s = JSRT_CreateNumber(0)
                    rec = JSRT__Pop()
                    JSRT_ObjSet(rec, "__i__", z0s)
                    JSVMIter.done = 0
                    JSVM__GenTrackOpenIter(rec)
                    JSVM__StackPush(rec)
                    ReturnValue(1)
                }
                IfCondition Or(EqualTo(st, JSType.NULL), EqualTo(st, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot destructure null/undefined")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                // Object / generator / custom: Symbol.iterator
                iter_key = 0
                IfCondition NotEqual(JSVMSymbol.iterator, 0) ThenBlock: {
                    iter_key = JSVM_SymbolToKey(JSVMSymbol.iterator)
                }
                IfCondition EqualTo(iter_key, 0) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "object is not iterable")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                JSRT__Push(rec)
                JSRT__Push(src)
                factory = JSRT_ObjGet(src, iter_key)
                src = JSRT__Pop()
                rec = JSRT__Pop()
                // Prefer @@iterator; else accept objects that already are iterators
                // (have .next) — generator wrappers lack @@iterator today.
                iterator = 0
                IfCondition EqualTo(JSRT_GetType(factory), JSType.FUNCTION) ThenBlock: {
                    JSVM__SetGlobal("this", src)
                    empty_buf = JSVMCallBuf.buf
                    JSRT__Push(rec)
                    iterator = JSVM__CallFunc(factory, empty_buf, 0)
                    rec = JSRT__Pop()
                    // Mole 15: throw from @@iterator must propagate
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    IfCondition NotEqual(JSRT_GetType(iterator), JSType.OBJECT) ThenBlock: {
                        terr = JSVM_CreateTypedError("TypeError", "@@iterator returned non-object")
                        JSVM_ThrowValue(terr)
                        ReturnValue(1)
                    }
                } ElseBlock: {
                    // Direct iterator protocol: use src if it has .next
                    JSRT__Push(rec)
                    JSRT__Push(src)
                    nxt_chk = JSRT_ObjGet(src, "next")
                    src = JSRT__Pop()
                    rec = JSRT__Pop()
                    IfCondition EqualTo(JSRT_GetType(nxt_chk), JSType.FUNCTION) ThenBlock: {
                        iterator = src
                    } ElseBlock: {
                        terr = JSVM_CreateTypedError("TypeError", "object is not iterable")
                        JSVM_ThrowValue(terr)
                        ReturnValue(1)
                    }
                }
                JSRT__Push(rec)
                JSRT__Push(iterator)
                next_fn = JSRT_ObjGet(iterator, "next")
                iterator = JSRT__Pop()
                rec = JSRT__Pop()
                // Spec GetIterator: store nextMethod even if non-callable;
                // IteratorStep fails later. Early reject blocked rtrn-close-err
                // where yield suspends before any next() call.
                JSRT__Push(rec)
                JSRT__Push(iterator)
                JSRT__Push(next_fn)
                mode1 = JSRT_CreateNumber(1)
                next_fn = JSRT__Pop()
                iterator = JSRT__Pop()
                rec = JSRT__Pop()
                JSRT_ObjSet(rec, "__m__", mode1)
                JSRT_ObjSet(rec, "__it__", iterator)
                JSRT_ObjSet(rec, "__n__", next_fn)
                JSVMIter.done = 0
                JSVM__GenTrackOpenIter(rec)
                JSVM__StackPush(rec)
                ReturnValue(1)
            }

            // ITER_NEXT (95) — [iter_record] → [value, done_bool]
            // done_bool is true/false; JSVMIter.done mirrors it for ITER_CLOSE.
            Case 95: {
                rec = JSVM__StackPop()
                mode_v = JSRT_ObjGet(rec, "__m__")
                mode = 0
                IfCondition EqualTo(JSRT_GetType(mode_v), JSType.NUMBER) ThenBlock: {
                    mode = Float_ToInt(JSRT_GetPayload(mode_v))
                }
                // Array mode
                IfCondition EqualTo(mode, 0) ThenBlock: {
                    arr = JSRT_ObjGet(rec, "__a__")
                    idx_v = JSRT_ObjGet(rec, "__i__")
                    idx = 0
                    IfCondition EqualTo(JSRT_GetType(idx_v), JSType.NUMBER) ThenBlock: {
                        idx = Float_ToInt(JSRT_GetPayload(idx_v))
                    }
                    alen = JSRT_ArrLen(arr)
                    IfCondition GreaterEqual(idx, alen) ThenBlock: {
                        JSVMIter.done = 1
                        JSVM__StackPush(JSRT_Undefined())
                        JSVM__StackPush(JSRT_True())
                        ReturnValue(1)
                    }
                    ev = JSRT_ArrGet(arr, idx)
                    JSRT__Push(rec)
                    JSRT__Push(ev)
                    nidx = JSRT_CreateNumber(Add(idx, 1))
                    ev = JSRT__Pop()
                    rec = JSRT__Pop()
                    JSRT_ObjSet(rec, "__i__", nidx)
                    JSVMIter.done = 0
                    JSVM__StackPush(ev)
                    JSVM__StackPush(JSRT_False())
                    ReturnValue(1)
                }
                // Object iterator mode
                iterator = JSRT_ObjGet(rec, "__it__")
                next_fn = JSRT_ObjGet(rec, "__n__")
                IfCondition NotEqual(JSRT_GetType(next_fn), JSType.FUNCTION) ThenBlock: {
                    JSVMIter.done = 1
                    terr = JSVM_CreateTypedError("TypeError", "iterator.next is not a function")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                JSVM__SetGlobal("this", iterator)
                empty_buf = JSVMCallBuf.buf
                JSRT__Push(rec)
                res = JSVM__CallFunc(next_fn, empty_buf, 0)
                rec = JSRT__Pop()
                // Mole 15: next() throw propagates via CallFunc.exc_prop
                // Spec IteratorNext: on abrupt, set iteratorRecord.[[Done]] = true
                // so IteratorClose is not called (thrw-close-skip).
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    JSVMIter.done = 1
                    pend2 = JSVMCall.thrown_val
                    IfCondition EqualTo(pend2, 0) ThenBlock: {
                        pend2 = JSVMState.exc_val
                    }
                    JSVMCall.thrown_val = 0
                    JSVMState.exc_val = 0
                    JSVMCall.exc_prop = 0
                    IfCondition NotEqual(pend2, 0) ThenBlock: {
                        JSVM_ThrowValue(pend2)
                    }
                    ReturnValue(1)
                }
                IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                    ReturnValue(1)
                }
                IfCondition NotEqual(JSRT_GetType(res), JSType.OBJECT) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "iterator result is not an object")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                // done: honor getter __get_done if present
                JSRT__Push(rec)
                JSRT__Push(res)
                done_getter = JSRT_ObjGet(res, "__get_done")
                res = JSRT__Pop()
                rec = JSRT__Pop()
                IfCondition EqualTo(JSRT_GetType(done_getter), JSType.FUNCTION) ThenBlock: {
                    JSVM__SetGlobal("this", res)
                    JSRT__Push(rec)
                    JSRT__Push(res)
                    done_v = JSVM__CallFunc(done_getter, empty_buf, 0)
                    res = JSRT__Pop()
                    rec = JSRT__Pop()
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                } ElseBlock: {
                    done_v = JSRT_ObjGet(res, "done")
                }
                IfCondition EqualTo(JSRT_IsTruthy(done_v), 1) ThenBlock: {
                    JSVMIter.done = 1
                    JSVM__StackPush(JSRT_Undefined())
                    JSVM__StackPush(JSRT_True())
                    ReturnValue(1)
                }
                JSVMIter.done = 0
                // value: honor getter __get_value (iter-val-err)
                JSRT__Push(rec)
                JSRT__Push(res)
                val_getter = JSRT_ObjGet(res, "__get_value")
                res = JSRT__Pop()
                rec = JSRT__Pop()
                IfCondition EqualTo(JSRT_GetType(val_getter), JSType.FUNCTION) ThenBlock: {
                    JSVM__SetGlobal("this", res)
                    JSRT__Push(rec)
                    val_v = JSVM__CallFunc(val_getter, empty_buf, 0)
                    rec = JSRT__Pop()
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                } ElseBlock: {
                    val_v = JSRT_ObjGet(res, "value")
                }
                JSVM__StackPush(val_v)
                JSVM__StackPush(JSRT_False())
                ReturnValue(1)
            }

            // ITER_CLOSE (96) — [iter_record] → []; call .return if not done
            // 16-bit operand: 0 = normal completion, 1 = throw completion
            // Spec 7.4.6: throw completion → return original (ignore return()
            // throw and non-Object result).
            Case 96: {
                close_kind = JSVM__Read16()
                rec = JSVM__StackPop()
                JSVM__GenClearOpenIter(rec)
                IfCondition EqualTo(JSVMIter.done, 1) ThenBlock: {
                    ReturnValue(1)
                }
                mode_v = JSRT_ObjGet(rec, "__m__")
                mode = 0
                IfCondition EqualTo(JSRT_GetType(mode_v), JSType.NUMBER) ThenBlock: {
                    mode = Float_ToInt(JSRT_GetPayload(mode_v))
                }
                // Array cursor: nothing to close
                IfCondition EqualTo(mode, 0) ThenBlock: {
                    JSVMIter.done = 1
                    ReturnValue(1)
                }
                iterator = JSRT_ObjGet(rec, "__it__")
                ret_fn = JSRT_ObjGet(iterator, "return")
                rft = JSRT_GetType(ret_fn)
                // Missing return (undefined/null): no call
                IfCondition Or(EqualTo(rft, JSType.UNDEFINED), EqualTo(rft, JSType.NULL)) ThenBlock: {
                    JSVMIter.done = 1
                    ReturnValue(1)
                }
                // Non-callable return → TypeError (normal completion only)
                IfCondition NotEqual(rft, JSType.FUNCTION) ThenBlock: {
                    IfCondition EqualTo(close_kind, 0) ThenBlock: {
                        terr = JSVM_CreateTypedError("TypeError", "iterator return is not a function")
                        JSVM_ThrowValue(terr)
                        ReturnValue(1)
                    }
                    JSVMIter.done = 1
                    ReturnValue(1)
                }
                JSVM__SetGlobal("this", iterator)
                empty_buf = JSVMCallBuf.buf
                // Isolate return() from outer try handlers so IteratorClose
                // can decide whether to keep original throw (kind=1) or
                // propagate return() throw (kind=0). Without this, return()
                // throw lands in assert.throws and skips close_kind logic.
                save_exc_sp = JSVMState.exc_sp
                JSVMState.exc_sp = 0
                ret_res = JSVM__CallFunc(ret_fn, empty_buf, 0)
                JSVMState.exc_sp = save_exc_sp
                // return() throw: propagates only for normal completion
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    pend = JSVMCall.thrown_val
                    IfCondition EqualTo(pend, 0) ThenBlock: {
                        pend = JSVM__GetGlobal("__pend_exc__")
                    }
                    JSVMCall.thrown_val = 0
                    JSVMCall.exc_prop = 0
                    JSVM__SetGlobal("__pend_exc__", JSRTState.undef_val)
                    IfCondition EqualTo(close_kind, 0) ThenBlock: {
                        // Prefer pending value; CallFunc may only leave exc_val/error
                        IfCondition Or(EqualTo(pend, 0), EqualTo(pend, JSRTState.undef_val)) ThenBlock: {
                            pend = JSVMState.exc_val
                        }
                        JSVMState.error = 0
                        JSVMState.halted = 0
                        JSVMState.exc_val = 0
                        IfCondition NotEqual(pend, 0) ThenBlock: {
                            IfCondition NotEqual(pend, JSRTState.undef_val) ThenBlock: {
                                JSVM_ThrowValue(pend)
                            }
                        }
                        ReturnValue(1)
                    }
                    // throw-completion: swallow return() throw, keep original
                    JSVMState.error = 0
                    JSVMState.halted = 0
                    JSVMState.exc_val = 0
                    JSVMCall.thrown_val = 0
                    JSVMCall.exc_prop = 0
                    JSVMIter.done = 1
                    ReturnValue(1)
                }
                IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                    // Uncaught during return() without exc_prop path
                    IfCondition EqualTo(close_kind, 1) ThenBlock: {
                        JSVMState.error = 0
                        JSVMState.halted = 0
                        JSVMState.exc_val = 0
                        JSVMIter.done = 1
                        ReturnValue(1)
                    }
                    ReturnValue(1)
                }
                // Result of return() must be Object for normal completion only
                IfCondition EqualTo(close_kind, 0) ThenBlock: {
                    rrt = JSRT_GetType(ret_res)
                    IfCondition And(NotEqual(rrt, JSType.OBJECT), NotEqual(rrt, JSType.FUNCTION)) ThenBlock: {
                        IfCondition NotEqual(rrt, JSType.ARRAY) ThenBlock: {
                            terr = JSVM_CreateTypedError("TypeError", "iterator return result is not an object")
                            JSVM_ThrowValue(terr)
                            ReturnValue(1)
                        }
                    }
                }
                JSVMIter.done = 1
                ReturnValue(1)
            }

            // GET_PROP (16) — 16-bit operand: constant pool index (property name)
            // Pop object, push object.prop
            // Getter support: if obj has __get_<name>, invoke it.
            Case 16: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                obj = JSVM__StackPop()

                // Wave 3 D1: null/undefined base → TypeError
                obj_type = JSRT_GetType(obj)
                IfCondition Or(EqualTo(obj_type, JSType.NULL), EqualTo(obj_type, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot read property of null/undefined")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }

                // Handle array.length
                IfCondition EqualTo(obj_type, JSType.ARRAY) ThenBlock: {
                    // Check if property is "length"
                    // "length" = 108 101 110 103 116 104
                    is_len = 0
                    c0 = GetByte(cpay, 0)
                    IfCondition EqualTo(c0, 108) ThenBlock: {
                        c1 = GetByte(cpay, 1)
                        IfCondition EqualTo(c1, 101) ThenBlock: {
                            c2 = GetByte(cpay, 2)
                            IfCondition EqualTo(c2, 110) ThenBlock: {
                                c3 = GetByte(cpay, 3)
                                IfCondition EqualTo(c3, 103) ThenBlock: {
                                    c4 = GetByte(cpay, 4)
                                    IfCondition EqualTo(c4, 116) ThenBlock: {
                                        c5 = GetByte(cpay, 5)
                                        IfCondition EqualTo(c5, 104) ThenBlock: {
                                            c6 = GetByte(cpay, 6)
                                            IfCondition EqualTo(c6, 0) ThenBlock: {
                                                is_len = 1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(is_len, 1) ThenBlock: {
                        alen = JSRT_ArrLen(obj)
                        JSVM__StackPush(JSRT_CreateNumber(alen))
                        ReturnValue(1)
                    }
                    // Match array method names
                    arr_mid = JSVM__MatchArrayMethod(cpay)
                    IfCondition GreaterThan(arr_mid, 0) ThenBlock: {
                        am_func = JSBridge__CreateNativeFunc(arr_mid, cpay, 1)
                        JSRT_FuncSetEnv(am_func, obj)
                        JSVM__StackPush(am_func)
                        ReturnValue(1)
                    }
                    // Match string methods on arrays (indexOf, etc.)
                    str_method_id = JSVM__MatchStringMethod(cpay)
                    IfCondition GreaterThan(str_method_id, 0) ThenBlock: {
                        sm_func = JSBridge__CreateNativeFunc(str_method_id, cpay, 1)
                        JSRT_FuncSetEnv(sm_func, obj)
                        JSVM__StackPush(sm_func)
                        ReturnValue(1)
                    }
                }

                // String property/method access
                IfCondition EqualTo(obj_type, JSType.STRING) ThenBlock: {
                    // Check "length" first (108 101 110 103 116 104 0)
                    c0 = GetByte(cpay, 0)
                    IfCondition EqualTo(c0, 108) ThenBlock: {
                        IfCondition EqualTo(GetByte(cpay, 1), 101) ThenBlock: {
                            IfCondition EqualTo(GetByte(cpay, 2), 110) ThenBlock: {
                                IfCondition EqualTo(GetByte(cpay, 3), 103) ThenBlock: {
                                    IfCondition EqualTo(GetByte(cpay, 4), 116) ThenBlock: {
                                        IfCondition EqualTo(GetByte(cpay, 5), 104) ThenBlock: {
                                            IfCondition EqualTo(GetByte(cpay, 6), 0) ThenBlock: {
                                                str_ptr = JSRT_GetPayload(obj)
                                                slen = StringLength(str_ptr)
                                                JSVM__StackPush(JSRT_CreateNumber(slen))
                                                ReturnValue(1)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Match string method names and create bound native func
                    str_method_id = JSVM__MatchStringMethod(cpay)
                    IfCondition GreaterThan(str_method_id, 0) ThenBlock: {
                        sm_func = JSBridge__CreateNativeFunc(str_method_id, cpay, 1)
                        JSRT_FuncSetEnv(sm_func, obj)
                        JSVM__StackPush(sm_func)
                        ReturnValue(1)
                    }
                    // Fall through to undefined
                    JSVM__StackPush(JSRT_Undefined())
                    ReturnValue(1)
                }

                // Check for getter: __get_<name>
                IfCondition EqualTo(obj_type, JSType.OBJECT) ThenBlock: {
                    gk_buf2 = JSVMCallBuf.getter_buf
                    SetByte(gk_buf2, 0, 95)
                    SetByte(gk_buf2, 1, 95)
                    SetByte(gk_buf2, 2, 103)
                    SetByte(gk_buf2, 3, 101)
                    SetByte(gk_buf2, 4, 116)
                    SetByte(gk_buf2, 5, 95)
                    JSVMTmp.idx = 0
                    JSVMTmp.done = 0
                    WhileLoop EqualTo(JSVMTmp.done, 0) {
                        JSVMTmp.val = GetByte(cpay, JSVMTmp.idx)
                        SetByte(gk_buf2, Add(6, JSVMTmp.idx), JSVMTmp.val)
                        IfCondition EqualTo(JSVMTmp.val, 0) ThenBlock: {
                            JSVMTmp.done = 1
                        }
                        JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                    }
                    getter_func = JSRT_ObjGet(obj, gk_buf2)
                    gt = JSRT_GetType(getter_func)
                    IfCondition EqualTo(gt, JSType.FUNCTION) ThenBlock: {
                        // Invoke getter: push func, CALL 0
                        // Bind this = receiver object so getter body can access this.*
                        JSVM__SetGlobal("this", obj)
                        JSVM__StackPush(getter_func)
                        // Simulate CALL with 0 args inline
                        func_bc2 = JSRT_FuncGetBC(getter_func)
                        IfCondition LessThan(func_bc2, 0) ThenBlock: {
                            // Native getter — route via threshold
                            handler_id2 = Subtract(-1, func_bc2)
                            arg_buf2 = JSVMCallBuf.buf
                            StoreValue(arg_buf2, obj)
                            IfCondition GreaterEqual(handler_id2, 22) ThenBlock: {
                                native_r = JSBridge_Dispatch(handler_id2, arg_buf2, 1)
                            } ElseBlock: {
                                native_r = JSRT_CallNative(handler_id2, arg_buf2, 0)
                            }
                            JSVM__StackPop()
                            JSVM__StackPush(native_r)
                        } ElseBlock: {
                            func_params2 = JSRT_FuncGetParams(getter_func)
                            func_locals2 = JSRT_FuncGetLocals(getter_func)
                            JSVM__StackPop()
                            save_pc2 = JSVMState.pc
                            save_sp2 = JSVMState.sp
                            locals_base2 = JSVMState.sp
                            JSVM__PushFrame(save_pc2, save_sp2, locals_base2, func_params2, func_locals2)
                            pi2 = 0
                            WhileLoop LessThan(pi2, func_locals2) {
                                JSVM__StackPush(JSRT_Undefined())
                                pi2 = Add(pi2, 1)
                            }
                            JSVMState.pc = func_bc2
                        }
                        ReturnValue(1)
                    }
                }

                // RegExp method binding — same pattern as string methods:
                // detect method name, create bound native func with env=receiver.
                IfCondition EqualTo(obj_type, JSType.OBJECT) ThenBlock: {
                    rx_mid = JSVM__MatchRegExpMethod(cpay)
                    IfCondition GreaterThan(rx_mid, 0) ThenBlock: {
                        // Verify this is actually a RegExp (has __regex_handle__)
                        rh_chk = PropTable_Lookup(Dereference(Add(obj, 8)), "__regex_handle__")
                        IfCondition NotEqual(rh_chk, -1) ThenBlock: {
                            rx_func = JSBridge__CreateNativeFunc(rx_mid, cpay, 1)
                            JSRT_FuncSetEnv(rx_func, obj)
                            JSVM__StackPush(rx_func)
                            ReturnValue(1)
                        }
                    }
                }

                pval = JSRT_ObjGet(obj, cpay)
                JSVM__StackPush(pval)
                ReturnValue(1)
            }

            // SET_PROP (17) — 16-bit operand: constant pool index (property name)
            // Stack: [..., object, value]. Pop value, pop object, set prop.
            // Setter support: if obj has __set_<name>, invoke it (mirror of GET_PROP getters).
            // DOM interception: if obj has __dom_idx and prop is innerHTML/textContent,
            // JSBridge_SetProp updates the actual DOM tree.
            Case 17: {
                cidx = JSVM__Read16()
                JSVMTmp.ptr = JSVM__GetConstPayload(cidx)
                JSVMTmp.val = JSVM__StackPop()
                JSVMTmp.addr = JSVM__StackPop()

                // Wave 3 D1: null/undefined base → TypeError
                set_obj_t = JSRT_GetType(JSVMTmp.addr)
                IfCondition Or(EqualTo(set_obj_t, JSType.NULL), EqualTo(set_obj_t, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot set property of null/undefined")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }

                // Check for setter: __set_<name> (object literals / defineProperty)
                IfCondition EqualTo(set_obj_t, JSType.OBJECT) ThenBlock: {
                    sk_buf2 = JSVMCallBuf.getter_buf
                    SetByte(sk_buf2, 0, 95)
                    SetByte(sk_buf2, 1, 95)
                    SetByte(sk_buf2, 2, 115)
                    SetByte(sk_buf2, 3, 101)
                    SetByte(sk_buf2, 4, 116)
                    SetByte(sk_buf2, 5, 95)
                    JSVMTmp.idx = 0
                    JSVMTmp.done = 0
                    WhileLoop EqualTo(JSVMTmp.done, 0) {
                        JSVMTmp.type = GetByte(JSVMTmp.ptr, JSVMTmp.idx)
                        SetByte(sk_buf2, Add(6, JSVMTmp.idx), JSVMTmp.type)
                        IfCondition EqualTo(JSVMTmp.type, 0) ThenBlock: {
                            JSVMTmp.done = 1
                        }
                        JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                    }
                    // ObjGet may clobber temps — save obj/val across call
                    JSRT__Push(JSVMTmp.addr)
                    JSRT__Push(JSVMTmp.val)
                    setter_func = JSRT_ObjGet(JSVMTmp.addr, sk_buf2)
                    JSVMTmp.val = JSRT__Pop()
                    JSVMTmp.addr = JSRT__Pop()
                    st = JSRT_GetType(setter_func)
                    IfCondition EqualTo(st, JSType.FUNCTION) ThenBlock: {
                        // Bind this = receiver; call setter(value) re-entrantly
                        JSVM__SetGlobal("this", JSVMTmp.addr)
                        arg_buf_s = JSVMCallBuf.buf
                        StoreValue(arg_buf_s, JSVMTmp.val)
                        JSVM__CallFunc(setter_func, arg_buf_s, 1)
                        ReturnValue(1)
                    }
                }

                JSVMTmp.result = JSBridge_SetProp(JSVMTmp.addr, JSVMTmp.ptr, JSVMTmp.val)
                IfCondition EqualTo(JSVMTmp.result, 0) ThenBlock: {
                    // Wave 2: honor writable / freeze / non-extensible
                    can = JSBridge_CanAssign(JSVMTmp.addr, JSVMTmp.ptr)
                    IfCondition EqualTo(can, 1) ThenBlock: {
                        JSRT_ObjSet(JSVMTmp.addr, JSVMTmp.ptr, JSVMTmp.val)
                        // Mapped arguments via SET_PROP (arguments[0] compiled as prop sometimes)
                        // Only sync if writing the *current* frame's arguments (nested calls rebind).
                        IfCondition EqualTo(JSVM_IsArgumentsObj(JSVMTmp.addr), 1) ThenBlock: {
                            k0 = GetByte(JSVMTmp.ptr, 0)
                            IfCondition And(GreaterEqual(k0, 48), LessThan(k0, 58)) ThenBlock: {
                                k1 = GetByte(JSVMTmp.ptr, 1)
                                IfCondition EqualTo(k1, 0) ThenBlock: {
                                    JSVM_SyncArgumentsToLocalIfCurrent(JSVMTmp.addr, Subtract(k0, 48), JSVMTmp.val)
                                }
                            }
                        }
                    } ElseBlock: {
                        // Wave 3: strict mode — assign to non-writable throws TypeError
                        IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                            terr = JSVM_CreateTypedError("TypeError", "Cannot assign to non-writable property")
                            JSVM_ThrowValue(terr)
                            ReturnValue(1)
                        }
                    }
                }
                ReturnValue(1)
            }

            // GET_ELEM (18) — pop index, pop array/string, push elem
            Case 18: {
                idx_val = JSVM__StackPop()
                arr_val = JSVM__StackPop()
                JSVMTmp.type = JSRT_GetType(arr_val)
                // Wave 3 D1: null/undefined base → TypeError
                IfCondition Or(EqualTo(JSVMTmp.type, JSType.NULL), EqualTo(JSVMTmp.type, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot read property of null/undefined")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                IfCondition EqualTo(JSVMTmp.type, JSType.STRING) ThenBlock: {
                    // String indexing: return single character
                    idx_num = Float_ToInt(JSRT_ToNumber(idx_val))
                    JSVMTmp.ptr = JSRT_GetPayload(arr_val)
                    JSVMTmp.val = GetByte(JSVMTmp.ptr, idx_num)
                    IfCondition GreaterEqual(JSVMTmp.val, 0) ThenBlock: {
                        elem = JSRT_CreateStringLen(Add(JSVMTmp.ptr, idx_num), 1)
                        JSVM__StackPush(elem)
                        ReturnValue(1)
                    }
                    JSVM__StackPush(JSRT_Undefined())
                    ReturnValue(1)
                }
                IfCondition EqualTo(JSVMTmp.type, JSType.OBJECT) ThenBlock: {
                    // Object property access — ToPropertyKey (Symbol → @@sN)
                    JSVMTmp.ptr = JSVM_ToPropertyKey(idx_val)
                    // M19d: toString/valueOf throw during ToPropertyKey
                    IfCondition EqualTo(JSVMTmp.ptr, 0) ThenBlock: {
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend = JSVMCall.thrown_val
                            IfCondition EqualTo(pend, 0) ThenBlock: {
                                pend = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVMCall.thrown_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition NotEqual(pend, 0) ThenBlock: {
                                IfCondition NotEqual(pend, JSRTState.undef_val) ThenBlock: {
                                    JSVM_ThrowValue(pend)
                                }
                            }
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                    // Mole 16: invoke getter __get_<key> if present
                    gk_buf = JSVMCallBuf.getter_buf
                    SetByte(gk_buf, 0, 95)
                    SetByte(gk_buf, 1, 95)
                    SetByte(gk_buf, 2, 103)
                    SetByte(gk_buf, 3, 101)
                    SetByte(gk_buf, 4, 116)
                    SetByte(gk_buf, 5, 95)
                    gi = 0
                    gdone = 0
                    WhileLoop EqualTo(gdone, 0) {
                        gb = GetByte(JSVMTmp.ptr, gi)
                        SetByte(gk_buf, Add(6, gi), gb)
                        IfCondition EqualTo(gb, 0) ThenBlock: {
                            gdone = 1
                        }
                        gi = Add(gi, 1)
                    }
                    JSRT__Push(arr_val)
                    getter_fn = JSRT_ObjGet(arr_val, gk_buf)
                    arr_val = JSRT__Pop()
                    IfCondition EqualTo(JSRT_GetType(getter_fn), JSType.FUNCTION) ThenBlock: {
                        JSVM__SetGlobal("this", arr_val)
                        empty_g = JSVMCallBuf.buf
                        elem = JSVM__CallFunc(getter_fn, empty_g, 0)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                        JSVM__StackPush(elem)
                        ReturnValue(1)
                    }
                    elem = JSRT_ObjGet(arr_val, JSVMTmp.ptr)
                    JSVM__StackPush(elem)
                    ReturnValue(1)
                }
                // ARRAY (Mole 16): Symbol / non-index named props via ObjGet+proto;
                // numeric indices stay on ArrGet.
                IfCondition EqualTo(JSVMTmp.type, JSType.ARRAY) ThenBlock: {
                    IfCondition EqualTo(JSVM_IsSymbol(idx_val), 1) ThenBlock: {
                        JSVMTmp.ptr = JSVM_ToPropertyKey(idx_val)
                        elem = JSRT_ObjGet(arr_val, JSVMTmp.ptr)
                        JSVM__StackPush(elem)
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSRT_GetType(idx_val), JSType.STRING) ThenBlock: {
                        JSVMTmp.ptr = JSRT_GetPayload(idx_val)
                        c0 = GetByte(JSVMTmp.ptr, 0)
                        // empty or non-digit start → named property (e.g. "values")
                        IfCondition Or(EqualTo(c0, 0), Or(LessThan(c0, 48), GreaterThan(c0, 57))) ThenBlock: {
                            elem = JSRT_ObjGet(arr_val, JSVMTmp.ptr)
                            JSVM__StackPush(elem)
                            ReturnValue(1)
                        }
                    }
                    idx_num = Float_ToInt(JSRT_ToNumber(idx_val))
                    elem = JSRT_ArrGet(arr_val, idx_num)
                    JSVM__StackPush(elem)
                    ReturnValue(1)
                }
                idx_num = Float_ToInt(JSRT_ToNumber(idx_val))
                elem = JSRT_ArrGet(arr_val, idx_num)
                JSVM__StackPush(elem)
                ReturnValue(1)
            }

            // SET_ELEM (19) — pop index, pop array/object, pop value
            // Stack: [..., value, array, index]
            Case 19: {
                idx_val = JSVM__StackPop()
                arr_val = JSVM__StackPop()
                sval = JSVM__StackPop()
                se_type = JSRT_GetType(arr_val)
                // Wave 3 D1: null/undefined base → TypeError
                IfCondition Or(EqualTo(se_type, JSType.NULL), EqualTo(se_type, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot set property of null/undefined")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                IfCondition EqualTo(se_type, JSType.OBJECT) ThenBlock: {
                    // Object — ToPropertyKey once (do NOT also ToNumber first:
                    // that double-invokes toString and fails S11.13.1_A7_T4)
                    idx_num = -1
                    JSVMTmp.ptr = JSVM_ToPropertyKey(idx_val)
                    IfCondition EqualTo(JSVMTmp.ptr, 0) ThenBlock: {
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend = JSVMCall.thrown_val
                            IfCondition EqualTo(pend, 0) ThenBlock: {
                                pend = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVMCall.thrown_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition NotEqual(pend, 0) ThenBlock: {
                                IfCondition NotEqual(pend, JSRTState.undef_val) ThenBlock: {
                                    JSVM_ThrowValue(pend)
                                }
                            }
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                    // Numeric index from key string for arguments sync only
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        c0s = GetByte(JSVMTmp.ptr, 0)
                        IfCondition And(GreaterEqual(c0s, 48), LessEqual(c0s, 57)) ThenBlock: {
                            idx_num = Float_ToInt(JSRT_ToNumber(JSRT_CreateString(JSVMTmp.ptr)))
                        }
                    }
                    // Mole 16: invoke setter __set_<key> if present
                    sk_buf = JSVMCallBuf.getter_buf
                    SetByte(sk_buf, 0, 95)
                    SetByte(sk_buf, 1, 95)
                    SetByte(sk_buf, 2, 115)
                    SetByte(sk_buf, 3, 101)
                    SetByte(sk_buf, 4, 116)
                    SetByte(sk_buf, 5, 95)
                    si = 0
                    sdone = 0
                    WhileLoop EqualTo(sdone, 0) {
                        sb = GetByte(JSVMTmp.ptr, si)
                        SetByte(sk_buf, Add(6, si), sb)
                        IfCondition EqualTo(sb, 0) ThenBlock: {
                            sdone = 1
                        }
                        si = Add(si, 1)
                    }
                    JSRT__Push(arr_val)
                    JSRT__Push(sval)
                    setter_fn = JSRT_ObjGet(arr_val, sk_buf)
                    sval = JSRT__Pop()
                    arr_val = JSRT__Pop()
                    IfCondition EqualTo(JSRT_GetType(setter_fn), JSType.FUNCTION) ThenBlock: {
                        JSVM__SetGlobal("this", arr_val)
                        arg_buf_s = JSVMCallBuf.buf
                        StoreValue(arg_buf_s, sval)
                        JSVM__CallFunc(setter_fn, arg_buf_s, 1)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                        ReturnValue(1)
                    }
                    // Wave 2 / Mole 12: honor writable / freeze
                    can_se = JSBridge_CanAssign(arr_val, JSVMTmp.ptr)
                    IfCondition EqualTo(can_se, 0) ThenBlock: {
                        IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                            terr = JSVM_CreateTypedError("TypeError", "Cannot assign to non-writable property")
                            JSVM_ThrowValue(terr)
                            ReturnValue(1)
                        }
                        ReturnValue(1)
                    }
                    JSRT_ObjSet(arr_val, JSVMTmp.ptr, sval)
                    IfCondition EqualTo(JSVM_IsArgumentsObj(arr_val), 1) ThenBlock: {
                        IfCondition GreaterEqual(idx_num, 0) ThenBlock: {
                            JSVM_SyncArgumentsToLocalIfCurrent(arr_val, idx_num, sval)
                        }
                    }
                    ReturnValue(1)
                }
                // ARRAY (Mole 16): Symbol / non-index named props → side table ObjSet
                IfCondition EqualTo(se_type, JSType.ARRAY) ThenBlock: {
                    IfCondition EqualTo(JSVM_IsSymbol(idx_val), 1) ThenBlock: {
                        JSVMTmp.ptr = JSVM_ToPropertyKey(idx_val)
                        JSRT_ObjSet(arr_val, JSVMTmp.ptr, sval)
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSRT_GetType(idx_val), JSType.STRING) ThenBlock: {
                        JSVMTmp.ptr = JSRT_GetPayload(idx_val)
                        c0 = GetByte(JSVMTmp.ptr, 0)
                        IfCondition Or(EqualTo(c0, 0), Or(LessThan(c0, 48), GreaterThan(c0, 57))) ThenBlock: {
                            JSRT_ObjSet(arr_val, JSVMTmp.ptr, sval)
                            ReturnValue(1)
                        }
                    }
                }
                idx_num = Float_ToInt(JSRT_ToNumber(idx_val))
                JSRT_ArrSet(arr_val, idx_num, sval)
                ReturnValue(1)
            }

            // ADD (20) — pop b, pop a, push JSRT_Add(a, b)
            Case 20: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Add(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // SUB (21)
            Case 21: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Sub(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // MUL (22)
            Case 22: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Mul(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // DIV (23)
            Case 23: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Div(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // MOD (24)
            Case 24: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Mod(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // NEG (25) — negate top of stack
            Case 25: {
                av = JSVM__StackPop()
                result = JSRT_Neg(av)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // EXP (26) — exponentiation (**)
            Case 26: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Exp(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // EQ (30) — abstract equality
            Case 30: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_AbstractEqual(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // NEQ (31) — abstract inequality
            Case 31: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_AbstractEqual(av, bv)
                IfCondition EqualTo(cmp_int, 0) ThenBlock: {
                    JSVM__StackPush(JSRT_True())
                } ElseBlock: {
                    JSVM__StackPush(JSRT_False())
                }
                ReturnValue(1)
            }

            // LT (32)
            Case 32: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_LessThan(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // GT (33)
            Case 33: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_GreaterThan(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // LTE (34)
            Case 34: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_LessEqual(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // GTE (35)
            Case 35: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_GreaterEqual(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // STRICT_EQ (36)
            Case 36: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_StrictEqual(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // STRICT_NEQ (37)
            Case 37: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_StrictEqual(av, bv)
                IfCondition EqualTo(cmp_int, 0) ThenBlock: {
                    JSVM__StackPush(JSRT_True())
                } ElseBlock: {
                    JSVM__StackPush(JSRT_False())
                }
                ReturnValue(1)
            }

            // NOT (40) — logical not
            Case 40: {
                av = JSVM__StackPop()
                result = JSRT_Not(av)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // BIT_AND (41)
            Case 41: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_BitAnd(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // BIT_OR (42)
            Case 42: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_BitOr(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // BIT_XOR (43)
            Case 43: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_BitXor(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // BIT_NOT (44)
            Case 44: {
                av = JSVM__StackPop()
                result = JSRT_BitNot(av)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // SHL (45)
            Case 45: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Shl(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // SHR (46)
            Case 46: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Shr(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // USHR (48) — unsigned right shift >>>
            Case 48: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Ushr(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // INSTANCEOF (49)
            Case 49: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Instanceof(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // IN (38) — key in obj
            Case 38: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                // av = key (convert to string), bv = object
                key_str = JSRT_ToString(av)
                key_ptr = JSRT_GetPayload(key_str)
                has = JSRT_ObjHas(bv, key_ptr)
                IfCondition EqualTo(has, 1) ThenBlock: {
                    JSVM__StackPush(JSRT_True())
                } ElseBlock: {
                    JSVM__StackPush(JSRT_False())
                }
                ReturnValue(1)
            }

            // DELETE_PROP (39) — stack: [obj, key] → delete obj[key], push boolean
            // Body lives in JSVM_OpDeleteProp (Case locals blow Ailang frames).
            Case 39: {
                JSVM_OpDeleteProp()
                ReturnValue(1)
            }

            // TYPEOF (47)
            Case 47: {
                av = JSVM__StackPop()
                result = JSRT_TypeOf(av)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // JMP (50) — unconditional jump, 16-bit target address
            Case 50: {
                target = JSVM__Read16()
                JSVMState.pc = target
                ReturnValue(1)
            }

            // JMP_FALSE (51) — pop value, jump if falsy
            Case 51: {
                target = JSVM__Read16()
                av = JSVM__StackPop()
                truth = JSRT_IsTruthy(av)
                IfCondition EqualTo(truth, 0) ThenBlock: {
                    JSVMState.pc = target
                }
                ReturnValue(1)
            }

            // JMP_TRUE (52) — pop value, jump if truthy
            Case 52: {
                target = JSVM__Read16()
                av = JSVM__StackPop()
                truth = JSRT_IsTruthy(av)
                IfCondition EqualTo(truth, 1) ThenBlock: {
                    JSVMState.pc = target
                }
                ReturnValue(1)
            }

            // JMP_NULLISH (53) — peek value, jump if NOT null/undefined
            // Used by ?? operator: skip RHS if LHS is not nullish
            Case 53: {
                target = JSVM__Read16()
                av = JSVM__StackPop()
                JSVM__StackPush(av)
                IfCondition NotEqual(av, 0) ThenBlock: {
                    vtype = Dereference(av)
                    IfCondition And(NotEqual(vtype, 0), NotEqual(vtype, 1)) ThenBlock: {
                        // Not null (1) and not undefined (0) → jump (keep value)
                        JSVMState.pc = target
                    }
                }
                ReturnValue(1)
            }

            // JMP_IF_NULLISH (54) — peek value, jump if IS null/undefined
            // Used by optional chaining: skip RHS if LHS is nullish
            // If nullish: pop value, push undefined, jump to target
            // If not nullish: leave value on stack, fall through
            Case 54: {
                target = JSVM__Read16()
                av = JSVM__StackPop()
                is_nullish = 0
                IfCondition EqualTo(av, 0) ThenBlock: {
                    is_nullish = 1
                }
                IfCondition NotEqual(av, 0) ThenBlock: {
                    vtype = Dereference(av)
                    IfCondition Or(EqualTo(vtype, 0), EqualTo(vtype, 1)) ThenBlock: {
                        // UNDEFINED(0) or NULL(1)
                        is_nullish = 1
                    }
                }
                IfCondition EqualTo(is_nullish, 1) ThenBlock: {
                    // Push undefined and jump
                    JSVM__StackPush(JSRT_Undefined())
                    JSVMState.pc = target
                }
                IfCondition EqualTo(is_nullish, 0) ThenBlock: {
                    // Not nullish — push value back and fall through
                    JSVM__StackPush(av)
                }
                ReturnValue(1)
            }

            // TRY_PUSH (70) — push exception handler
            // 16-bit operand: catch handler address
            // Entry layout (32 bytes): catch_addr, saved_sp, saved_fp, pad
            Case 70: {
                catch_addr = JSVM__Read16()
                IfCondition LessThan(JSVMState.exc_sp, 16) ThenBlock: {
                    ebase = Add(JSVMState.exc_stack, Multiply(JSVMState.exc_sp, 32))
                    StoreValue(ebase, catch_addr)
                    StoreValue(Add(ebase, 8), JSVMState.sp)
                    // Wave 3: save frame pointer so cross-function throw restores catch frame
                    StoreValue(Add(ebase, 16), JSVMState.fp)
                    StoreValue(Add(ebase, 24), 0)
                    JSVMState.exc_sp = Add(JSVMState.exc_sp, 1)
                }
                ReturnValue(1)
            }

            // TRY_POP (71) — remove topmost exception handler
            Case 71: {
                IfCondition GreaterThan(JSVMState.exc_sp, 0) ThenBlock: {
                    JSVMState.exc_sp = Subtract(JSVMState.exc_sp, 1)
                }
                ReturnValue(1)
            }

            // THROW (72) — throw exception
            // Pop thrown value, unwind call frames + stack to catch handler, push value
            Case 72: {
                thrown = JSVM__StackPop()
                // Mole 15: throw inside generator body → complete gen, restore
                // .next() caller, signal abrupt. CALL/CALL_METHOD rethrows so
                // catch bindings receive the value (GenNext must not StackPop it).
                IfCondition EqualTo(JSVMGen.is_gen_exec, 1) ThenBlock: {
                    gs_thr = JSVMGen.active_gs
                    IfCondition NotEqual(gs_thr, 0) ThenBlock: {
                        StoreValue(gs_thr, JSGenConst.ST_COMPLETED)
                    }
                    JSVMState.pc = JSVMGen.caller_pc
                    JSVMState.sp = JSVMGen.caller_sp
                    JSVMState.fp = JSVMGen.caller_fp
                    c_stk = Multiply(JSVMGen.caller_sp, 8)
                    IfCondition GreaterThan(c_stk, 0) ThenBlock: {
                        MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, c_stk)
                    }
                    c_frm = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
                    IfCondition GreaterThan(c_frm, 0) ThenBlock: {
                        MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, c_frm)
                    }
                    JSVMGen.active_gs = 0
                    JSVMGen.is_gen_exec = 0
                    JSVMState.exc_val = thrown
                    JSVMCall.thrown_val = thrown
                    JSVMCall.exc_prop = 1
                    // Persist across any restore/clobber
                    JSVM__SetGlobal("__pend_exc__", thrown)
                    JSVMState.halted = 1
                    JSVMState.error = 0
                    ReturnValue(1)
                }
                IfCondition GreaterThan(JSVMState.exc_sp, 0) ThenBlock: {
                    JSVMState.exc_sp = Subtract(JSVMState.exc_sp, 1)
                    ebase = Add(JSVMState.exc_stack, Multiply(JSVMState.exc_sp, 32))
                    catch_addr = Dereference(ebase)
                    saved_sp = Dereference(Add(ebase, 8))
                    saved_fp = Dereference(Add(ebase, 16))
                    IfCondition LessThan(saved_sp, 0) ThenBlock: { saved_sp = 0 }
                    IfCondition GreaterThan(saved_sp, JSVMConst.MAX_STACK) ThenBlock: { saved_sp = JSVMConst.MAX_STACK }
                    IfCondition LessThan(saved_fp, 0) ThenBlock: { saved_fp = 0 }
                    IfCondition GreaterThan(saved_fp, JSVMConst.MAX_FRAMES) ThenBlock: { saved_fp = JSVMConst.MAX_FRAMES }
                    JSVMState.fp = saved_fp
                    JSVMState.sp = saved_sp
                    JSVM__StackPush(thrown)
                    JSVMState.pc = catch_addr
                } ElseBlock: {
                    JSVMState.exc_val = thrown
                    JSVMState.error = 1
                    JSVMState.halted = 1
                }
                ReturnValue(1)
            }

            // CALL (55) — 1-byte operand: argc
            // Stack: [..., func, arg0, arg1, ..., argN-1]
            Case 55: {
                argc = JSVM__ReadByte()

                // Use static arg buffer (no per-call allocation)
                arg_buf = JSVMCallBuf.buf

                ai = Subtract(argc, 1)
                WhileLoop GreaterEqual(ai, 0) {
                    arg_v = JSVM__StackPop()
                    StoreValue(Add(arg_buf, Multiply(ai, 8)), arg_v)
                    ai = Subtract(ai, 1)
                }

                // Pop function value
                func_val = JSVM__StackPop()
                ft = JSRT_GetType(func_val)
                IfCondition NotEqual(ft, JSType.FUNCTION) ThenBlock: {
                    // Wave 3 D1: call non-callable → TypeError
                    terr = JSVM_CreateTypedError("TypeError", "is not a function")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }

                                // M26a: class constructors require [[Construct]] (params bit 26).
                // SuperCall reuses CALL with this already the derived instance.
                cparams2 = JSRT_FuncGetParams(func_val)
                IfCondition NotEqual(BitwiseAnd(cparams2, 67108864), 0) ThenBlock: {
                    th = JSVM__GetGlobal("this")
                    tht = JSRT_GetType(th)
                    allow = 0
                    IfCondition EqualTo(tht, JSType.OBJECT) ThenBlock: { allow = 1 }
                    IfCondition EqualTo(tht, JSType.ARRAY) ThenBlock: { allow = 1 }
                    IfCondition EqualTo(allow, 0) ThenBlock: {
                        terr = JSVM_CreateTypedError("TypeError", "Class constructor cannot be invoked without new")
                        JSVM_ThrowValue(terr)
                        ReturnValue(1)
                    }
                }

// Check if this is a native function
                func_bc = JSRT_FuncGetBC(func_val)
                IfCondition LessThan(func_bc, 0) ThenBlock: {
                    // Native function call — dispatch through JSRuntime or JSBridge
                    handler_id = Subtract(-1, func_bc)

                    // Generator .next() — handler_id = 9998 (bc = -9999)
                    IfCondition EqualTo(handler_id, 9998) ThenBlock: {
                        gen_result = JSVM__GenNext(func_val, arg_buf, argc)
                        // Mole 15: body throw → abrupt .next() completion
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pendg = JSVMCall.thrown_val
                            IfCondition EqualTo(pendg, 0) ThenBlock: {
                                pendg = JSVMState.exc_val
                            }
                            IfCondition EqualTo(pendg, 0) ThenBlock: {
                                pendg = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVMCall.thrown_val = 0
                            JSVMState.exc_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition EqualTo(pendg, 0) ThenBlock: {
                                pendg = JSVM_CreateTypedError("TypeError", "generator threw")
                            }
                            JSVM_ThrowValue(pendg)
                            ReturnValue(1)
                        }
                        JSVM__StackPush(gen_result)
                        ReturnValue(1)
                    }
                    // Generator .return() — handler_id = 9997 (bc = -9998)
                    IfCondition EqualTo(handler_id, 9997) ThenBlock: {
                        gen_result = JSVM__GenReturn(func_val, arg_buf, argc)
                        // IteratorClose abrupt from return() → rethrow
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pendr = JSVMCall.thrown_val
                            IfCondition EqualTo(pendr, 0) ThenBlock: {
                                pendr = JSVMState.exc_val
                            }
                            IfCondition EqualTo(pendr, 0) ThenBlock: {
                                pendr = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVMCall.thrown_val = 0
                            JSVMState.exc_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition EqualTo(pendr, 0) ThenBlock: {
                                pendr = JSVM_CreateTypedError("TypeError", "generator return abrupt")
                            }
                            JSVM_ThrowValue(pendr)
                            ReturnValue(1)
                        }
                        JSVM__StackPush(gen_result)
                        ReturnValue(1)
                    }
                    // Generator .throw() — handler_id = 9996 (bc = -9997)
                    IfCondition EqualTo(handler_id, 9996) ThenBlock: {
                        gen_result = JSVM__GenThrow(func_val, arg_buf, argc)
                        // (static arg_buf — no dealloc needed)
                        JSVM__StackPush(gen_result)
                        ReturnValue(1)
                    }

                    // Function.prototype bound (FUNC_BOUND=198)
                    IfCondition EqualTo(handler_id, 198) ThenBlock: {
                        brec = JSRT_FuncGetEnv(func_val)
                        JSVM__SetGlobal("__bound_rec__", brec)
                        native_result = JSRT_CallNative(handler_id, arg_buf, argc)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }

                    // eval() — handler_id = 193 (JSNativeID.EVAL)
                    IfCondition EqualTo(handler_id, 193) ThenBlock: {
                        native_result = JSVM_EvalNative(arg_buf, argc)
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }

                    // Symbol() — handler_id = 194
                    IfCondition EqualTo(handler_id, 194) ThenBlock: {
                        native_result = JSVM_SymbolNative(arg_buf, argc)
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }

                    // Handler IDs 57-61, 77-78: Promise methods (env = promise receiver)
                    IfCondition GreaterEqual(handler_id, 57) ThenBlock: {
                        IfCondition LessEqual(handler_id, 61) ThenBlock: {
                            promise_recv = JSRT_FuncGetEnv(func_val)
                            native_result = JSBridge__DispatchPromise(handler_id, promise_recv, arg_buf, argc)
                            // (static arg_buf — no dealloc needed)
                            JSVM__StackPush(native_result)
                            ReturnValue(1)
                        }
                    }
                    IfCondition GreaterEqual(handler_id, 77) ThenBlock: {
                        IfCondition LessEqual(handler_id, 78) ThenBlock: {
                            promise_recv = JSRT_FuncGetEnv(func_val)
                            native_result = JSBridge__DispatchPromise(handler_id, promise_recv, arg_buf, argc)
                            // (static arg_buf — no dealloc needed)
                            JSVM__StackPush(native_result)
                            ReturnValue(1)
                        }
                    }

                    // Handler IDs 83-87: RegExp methods (env = receiver)
                    IfCondition GreaterEqual(handler_id, 83) ThenBlock: {
                        IfCondition LessEqual(handler_id, 87) ThenBlock: {
                            rx_recv = JSRT_FuncGetEnv(func_val)
                            native_result = JSVM__DispatchRegExpMethod(handler_id, rx_recv, arg_buf, argc)
                            JSVM__StackPush(native_result)
                            ReturnValue(1)
                        }
                    }

                    // Handler IDs 62-76, 97-99, 150-171, 180-191: String/Array/JSON methods (env = receiver)
                    is_str_method = 0
                    IfCondition GreaterEqual(handler_id, 62) ThenBlock: {
                        IfCondition LessEqual(handler_id, 76) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition GreaterEqual(handler_id, 97) ThenBlock: {
                        IfCondition LessEqual(handler_id, 99) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition GreaterEqual(handler_id, 150) ThenBlock: {
                        IfCondition LessEqual(handler_id, 171) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition GreaterEqual(handler_id, 180) ThenBlock: {
                        IfCondition LessEqual(handler_id, 186) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition EqualTo(is_str_method, 1) ThenBlock: {
                        str_recv = JSRT_FuncGetEnv(func_val)
                        native_result = JSVM__DispatchStringMethod(handler_id, str_recv, arg_buf, argc)
                        // (static arg_buf — no dealloc needed)
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }

                    // Handler IDs 0-21: JSRuntime built-ins (0-14 math/type, 15-21 Error ctors)
                    // Handler IDs 22+: JSBridge DOM/timer natives
                    IfCondition GreaterEqual(handler_id, 22) ThenBlock: {
                        native_result = JSBridge_Dispatch(handler_id, arg_buf, argc)
                        // ThrowValue from native sets exc_prop + catch pc/sp — don't
                        // push the native return value (would cover the thrown err).
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend_n = JSVMCall.thrown_val
                            IfCondition EqualTo(pend_n, 0) ThenBlock: {
                                pend_n = JSVM__GetGlobal("__pend_exc__")
                            }
                            IfCondition NotEqual(pend_n, 0) ThenBlock: {
                                IfCondition NotEqual(pend_n, JSRTState.undef_val) ThenBlock: {
                                    JSVM__StackPush(pend_n)
                                }
                            }
                            JSVMCall.exc_prop = 0
                            JSVMCall.thrown_val = 0
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }
                    native_result = JSRT_CallNative(handler_id, arg_buf, argc)
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        JSVMCall.exc_prop = 0
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    JSVM__StackPush(native_result)
                    ReturnValue(1)
                }

                // Check if this is a generator function (env == 71 magic)
                func_env = JSRT_FuncGetEnv(func_val)
                IfCondition EqualTo(func_env, 71) ThenBlock: {
                    // Generator call — create gen, run FDI (param dstr) now
                    gen_val = JSRT_CreateGenerator(func_val, arg_buf, argc)
                    fdi_ok = JSVM__GenInitParams(gen_val, func_val)
                    IfCondition EqualTo(fdi_ok, 0) ThenBlock: {
                        // Param init threw — rethrow into CALL caller (try/catch)
                        pend_fdi = JSVMCall.thrown_val
                        IfCondition EqualTo(pend_fdi, 0) ThenBlock: {
                            pend_fdi = JSVMState.exc_val
                        }
                        IfCondition EqualTo(pend_fdi, 0) ThenBlock: {
                            pend_fdi = JSVM__GetGlobal("__pend_exc__")
                        }
                        JSVMCall.thrown_val = 0
                        JSVMCall.exc_prop = 0
                        JSVMState.exc_val = 0
                        IfCondition NotEqual(pend_fdi, 0) ThenBlock: {
                            JSVM_ThrowValue(pend_fdi)
                        } ElseBlock: {
                            JSVMState.error = 1
                            JSVMState.halted = 1
                        }
                        ReturnValue(1)
                    }

                    gen_gs = Dereference(Add(gen_val, 8))
                    next_func = JSRT_CreateFunc(-9999, 1, 0, "next")
                    JSRT_FuncSetEnv(next_func, gen_val)

                    ret_func = JSRT_CreateFunc(-9998, 1, 0, "return")
                    JSRT_FuncSetEnv(ret_func, gen_val)

                    throw_func = JSRT_CreateFunc(-9997, 1, 0, "throw")
                    JSRT_FuncSetEnv(throw_func, gen_val)

                    gen_obj = JSRT_CreateObject()
                    // [[Prototype]] = generator function's .prototype
                    gen_proto = JSRT_ObjGet(func_val, "prototype")
                    IfCondition EqualTo(JSRT_GetType(gen_proto), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(gen_obj, "__proto__", gen_proto)
                    }
                    JSRT_ObjSet(gen_obj, "next", next_func)
                    JSRT_ObjSet(gen_obj, "return", ret_func)
                    JSRT_ObjSet(gen_obj, "throw", throw_func)
                    JSRT_ObjSet(gen_obj, "__gen__", gen_val)

                    JSVM__StackPush(gen_obj)
                    ReturnValue(1)
                }

                // Async generator function (env == 66) — creates async generator object
                // Same as regular generator, but .next() wraps results in Promises
                IfCondition EqualTo(func_env, 66) ThenBlock: {
                    gen_val = JSRT_CreateGenerator(func_val, arg_buf, argc)
                    // Mark generator state block as async (offset 104)
                    ag_gs = JSRT_GetPayload(gen_val)
                    StoreValue(Add(ag_gs, 104), 1)

                    gen_gs = Dereference(Add(gen_val, 8))
                    next_func = JSRT_CreateFunc(-9999, 1, 0, "next")
                    JSRT_FuncSetEnv(next_func, gen_val)

                    ret_func = JSRT_CreateFunc(-9998, 1, 0, "return")
                    JSRT_FuncSetEnv(ret_func, gen_val)

                    throw_func = JSRT_CreateFunc(-9997, 1, 0, "throw")
                    JSRT_FuncSetEnv(throw_func, gen_val)

                    gen_obj = JSRT_CreateObject()
                    gen_proto = JSRT_ObjGet(func_val, "prototype")
                    IfCondition EqualTo(JSRT_GetType(gen_proto), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(gen_obj, "__proto__", gen_proto)
                    }
                    JSRT_ObjSet(gen_obj, "next", next_func)
                    JSRT_ObjSet(gen_obj, "return", ret_func)
                    JSRT_ObjSet(gen_obj, "throw", throw_func)
                    JSRT_ObjSet(gen_obj, "__gen__", gen_val)
                    // Mark as async generator so .next() wraps in Promise
                    JSRT_ObjSet(gen_obj, "__async_gen__", JSRT_CreateNumber(1))

                    JSVM__StackPush(gen_obj)
                    ReturnValue(1)
                }

                // Async function (env == 65) — execute normally, AWAIT handles promise unwrapping
                // No special call handling needed; the function runs eagerly
                // and AWAIT opcode unwraps any promises in-flight.

                // If callee has __super__, set it as global for the callee body.
                // This enables multi-level super() chains.
                JSRT__Push(func_val)
                call_sup = JSRT_FuncPropGet(func_val, "__super__")
                func_val = JSRT__Pop()
                call_sup_t = JSRT_GetType(call_sup)
                IfCondition EqualTo(call_sup_t, JSType.FUNCTION) ThenBlock: {
                    JSVM__SetGlobal("__super__", call_sup)
                }

                // Get function descriptor fields
                func_params = JSRT_FuncGetParams(func_val)
                func_locals = JSRT_FuncGetLocals(func_val)

                // Save current state in a call frame
                save_pc = JSVMState.pc
                save_sp = JSVMState.sp
                locals_base = JSVMState.sp

                pf_ok = JSVM__PushFrame(save_pc, save_sp, locals_base, func_params, func_locals)
                IfCondition LessThan(pf_ok, 0) ThenBlock: {
                    PrintMessage("[JSEngine] call stack overflow (MAX_FRAMES)\n")
                    JSVMState.error = 1
                    ReturnValue(-1)
                }
                JSVM__SetupCallEnv(func_val)

                // Mole 16: per-function strict — save outer, enter if bit 29
                prev_strict = JSVMState.is_strict
                faddr_s = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
                StoreValue(Add(faddr_s, 72), prev_strict)
                IfCondition NotEqual(BitwiseAnd(func_params, 536870912), 0) ThenBlock: {
                    JSVMState.is_strict = 1
                }

                // Mark async frames with -65 at offset 40 so RETURN can wrap result
                IfCondition EqualTo(func_env, 65) ThenBlock: {
                    af_addr = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
                    StoreValue(Add(af_addr, 40), -65)
                }

                // Rest params: bit 31 of param_count set by compiler when last
                // formal is "...rest". fixed formals occupy slots 0..rest_idx-1;
                // rest_idx gets an array of arg_buf[rest_idx..argc).
                rest_flag = 0
                rest_idx = -1
                // Bits 30-31 are flags: 31=rest, 30=unmapped args. Clear both for count.
                // 268435455 = 0x0FFFFFFF (bits 0-27 count; 28=arrow, 29=strict, 30=unmapped, 31=rest)
                formal_count = BitwiseAnd(func_params, 268435455)
                // 2147483648 = 1<<31
                IfCondition NotEqual(BitwiseAnd(func_params, 2147483648), 0) ThenBlock: {
                    rest_flag = 1
                    rest_idx = Subtract(formal_count, 1)
                }
                unmapped_bit = BitwiseAnd(func_params, 1073741824)

                // Push locals onto stack
                pi = 0
                WhileLoop LessThan(pi, func_locals) {
                    pushed = 0
                    IfCondition EqualTo(rest_flag, 1) ThenBlock: {
                        IfCondition EqualTo(pi, rest_idx) ThenBlock: {
                            rest_arr = JSRT_CreateArray()
                            ri = rest_idx
                            WhileLoop LessThan(ri, argc) {
                                rval = Dereference(Add(arg_buf, Multiply(ri, 8)))
                                JSRT_ArrPush(rest_arr, rval)
                                ri = Add(ri, 1)
                            }
                            JSVM__StackPush(rest_arr)
                            pushed = 1
                        }
                        IfCondition EqualTo(pushed, 0) ThenBlock: {
                            IfCondition LessThan(pi, rest_idx) ThenBlock: {
                                IfCondition LessThan(pi, argc) ThenBlock: {
                                    pval = Dereference(Add(arg_buf, Multiply(pi, 8)))
                                    JSVM__StackPush(pval)
                                } ElseBlock: {
                                    JSVM__StackPush(JSRT_Undefined())
                                }
                                pushed = 1
                            }
                        }
                    }
                    IfCondition EqualTo(pushed, 0) ThenBlock: {
                        IfCondition LessThan(pi, argc) ThenBlock: {
                            // No rest, or locals past formals that still have args
                            IfCondition EqualTo(rest_flag, 0) ThenBlock: {
                                pval = Dereference(Add(arg_buf, Multiply(pi, 8)))
                                JSVM__StackPush(pval)
                            } ElseBlock: {
                                JSVM__StackPush(JSRT_Undefined())
                            }
                        } ElseBlock: {
                            JSVM__StackPush(JSRT_Undefined())
                        }
                    }
                    pi = Add(pi, 1)
                }

                // arguments object — mapped formals + callee (see JSVMArgs)
                // Bit 30 = unmapped (rest/default/dstr) Mole 14
                map_n = formal_count
                IfCondition NotEqual(unmapped_bit, 0) ThenBlock: {
                    map_n = 0
                }
                IfCondition EqualTo(rest_flag, 1) ThenBlock: {
                    // rest formal alone is not mapped
                    IfCondition EqualTo(unmapped_bit, 0) ThenBlock: {
                        map_n = rest_idx
                    }
                }
                IfCondition LessThan(map_n, 0) ThenBlock: { map_n = 0 }
                // Bit 28 = arrow — no own arguments (lexical outer via __cenv)
                IfCondition EqualTo(BitwiseAnd(func_params, 268435456), 0) ThenBlock: {
                    args_obj = JSVM_CreateArguments(arg_buf, argc, func_val, map_n)
                    JSVM__SaveArguments()
                    JSVM__SetGlobal("arguments", args_obj)
                    // Dual-write onto frame env so nested arrows GET_FREE "arguments"
                    IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                        fi_a = Subtract(JSVMState.fp, 1)
                        env_a = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi_a, 8)))
                        IfCondition NotEqual(env_a, 0) ThenBlock: {
                            JSRT_ObjSet(env_a, "arguments", args_obj)
                        }
                    }
                } ElseBlock: {
                    // Snapshot so RETURN RestoreArguments does not wipe outer
                    JSVM__SaveArguments()
                }

                // === JIT CHECK ===
                // If JIT is enabled, try to execute native code instead of interpreting
                IfCondition EqualTo(JITState.enabled, 1) ThenBlock: {
                    jit_native = JIT_Lookup(func_bc)
                    IfCondition EqualTo(jit_native, 0) ThenBlock: {
                        // Not compiled yet — try to compile
                        // code_len: from func_bc to end of bytecode (or next RETURN)
                        jit_code_len = Subtract(JSVMState.code_len, func_bc)
                        jit_native = JIT_Compile(Add(JSVMState.code, func_bc), jit_code_len, func_bc)
                    }
                    IfCondition NotEqual(jit_native, 0) ThenBlock: {
                        // Execute JIT'd code
                        JIT_Execute(jit_native)
                        // JIT code ran the function body and returned.
                        // The JIT's RETURN opcode popped the return value and wrote sp back.
                        // Now we pop the frame and push the return value.
                        jit_ret = JSVM__StackPop()
                        jit_frame = JSVM__PopFrame()
                        IfCondition EqualTo(jit_frame, 0) ThenBlock: {
                            JSVM__StackPush(jit_ret)
                            JSVMState.halted = 1
                            ReturnValue(0)
                        }
                        JSVMState.pc = Dereference(jit_frame)
                        JSVMState.sp = Dereference(Add(jit_frame, 8))
                        JSVM__StackPush(jit_ret)
                        ReturnValue(1)
                    }
                }

                // Jump to function code (interpreter fallback)
                JSVMState.pc = func_bc
                ReturnValue(1)
            }

            // RETURN (56)
            Case 56: {
                // Pop return value
                ret_val = JSVM__StackPop()

                // Check if we're inside a generator execution
                IfCondition EqualTo(JSVMGen.is_gen_exec, 1) ThenBlock: {
                    // Pop frame. Mole 17: first-resume PushFrame means base gen
                    // frame is non-null — detect base via fp==0 after pop.
                    frame = JSVM__PopFrame()
                    JSVMState.error = 0
                    IfCondition Or(EqualTo(frame, 0), EqualTo(JSVMState.fp, 0)) ThenBlock: {
                        // Generator base return — mark completed
                        gs = JSVMGen.active_gs
                        IfCondition NotEqual(gs, 0) ThenBlock: {
                            StoreValue(gs, JSGenConst.ST_COMPLETED)
                        }

                        // Restore caller state
                        JSVMState.pc = JSVMGen.caller_pc
                        JSVMState.sp = JSVMGen.caller_sp
                        JSVMState.fp = JSVMGen.caller_fp
                        caller_stk_sz = Multiply(JSVMGen.caller_sp, 8)
                        IfCondition GreaterThan(caller_stk_sz, 0) ThenBlock: {
                            MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, caller_stk_sz)
                        }
                        caller_frm_sz = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
                        IfCondition GreaterThan(caller_frm_sz, 0) ThenBlock: {
                            MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, caller_frm_sz)
                        }

                        JSVMGen.active_gs = 0
                        JSVMGen.is_gen_exec = 0

                        // Return {value: ret_val, done: true}
                        iter_result = JSRT_CreateIterResult(ret_val, 1)
                        JSVM__StackPush(iter_result)
                        ReturnValue(1)
                    }

                    // Not the base frame — normal return within generator body
                    // Mole 15: honor constructor frames (new X() inside gen).
                    // Without this, `throw new Test262Error()` throws undefined
                    // because the ctor returns undefined and we never substitute this.
                    save_gen_pc = Dereference(frame)
                    save_gen_sp = Dereference(Add(frame, 8))
                    gen_ctor_this = Dereference(Add(frame, 40))
                    ret_val = JSVM__ReclaimScope(frame, ret_val)
                    IfCondition NotEqual(gen_ctor_this, 0) ThenBlock: {
                        IfCondition NotEqual(gen_ctor_this, -65) ThenBlock: {
                            rv_type_g = JSRT_GetType(ret_val)
                            IfCondition NotEqual(rv_type_g, JSType.OBJECT) ThenBlock: {
                                IfCondition NotEqual(rv_type_g, JSType.ARRAY) ThenBlock: {
                                    IfCondition NotEqual(rv_type_g, JSType.FUNCTION) ThenBlock: {
                                        ret_val = gen_ctor_this
                                    }
                                }
                            }
                        }
                    }
                    JSVMState.pc = save_gen_pc
                    JSVMState.sp = save_gen_sp
                    JSVM__StackPush(ret_val)
                    ReturnValue(1)
                }

                // Pop frame — restore outer `arguments` for the frame we leave
                restore_fi = Subtract(JSVMState.fp, 1)
                frame = JSVM__PopFrame()
                IfCondition EqualTo(frame, 0) ThenBlock: {
                    // No frame to pop — halt
                    JSVM__StackPush(ret_val)
                    JSVMState.halted = 1
                    ReturnValue(0)
                }
                // Mole 16: restore outer is_strict
                JSVMState.is_strict = Dereference(Add(frame, 72))
                JSVM__RestoreArguments(restore_fi)

                // Check if this was an async frame (offset 40 = -65)
                ctor_this = Dereference(Add(frame, 40))
                IfCondition EqualTo(ctor_this, -65) ThenBlock: {
                    // Async function return: wrap ret_val in a fulfilled promise
                    async_promise = JSRT_CreateObject()
                    JSRT_ObjSet(async_promise, "__class__", JSRT_CreateString("Promise"))
                    JSRT_ObjSet(async_promise, "__state__", JSRT_CreateNumber(1))
                    JSRT_ObjSet(async_promise, "__value__", ret_val)
                    athen_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
                    JSRT_FuncSetEnv(athen_f, async_promise)
                    JSRT_ObjSet(async_promise, "then", athen_f)
                    acatch_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
                    JSRT_FuncSetEnv(acatch_f, async_promise)
                    JSRT_ObjSet(async_promise, "catch", acatch_f)
                    ret_val = async_promise
                    ctor_this = 0
                }
                // Save return pc/sp from frame BEFORE any JSVM__CallFunc
                // (JSVM__CallFunc zeroes JSVMState.frames, invalidating frame ptr)
                save_ret_pc = Dereference(frame)
                save_ret_sp = Dereference(Add(frame, 8))

                // Scope reclamation: promote return value, rollback watermarks
                ret_val = JSVM__ReclaimScope(frame, ret_val)

                // Check if this was a constructor frame (offset 40 = this_obj)
                IfCondition NotEqual(ctor_this, 0) ThenBlock: {
                    // Constructor return: if ret_val is not an object, use this_obj
                    rv_type = JSRT_GetType(ret_val)
                    IfCondition NotEqual(rv_type, JSType.OBJECT) ThenBlock: {
                        ret_val = ctor_this
                    }
                    // M26a: clear this so bare Class() after new Class() still TypeErrors
                    JSVM__SetGlobal("this", JSRTState.undef_val)
                    // Walk __proto__ chain, collect __field_init__ closures (OWN only),
                    // then call in reverse order (parent first, child last) for correct JS semantics.
                    fi_count = 0
                    fi_stk = JSVMCallBuf.getter_buf
                    fi_proto = JSRT_ObjGet(ret_val, "__proto__")
                    fi_pt = JSRT_GetType(fi_proto)
                    WhileLoop EqualTo(fi_pt, JSType.OBJECT) {
                        IfCondition GreaterEqual(fi_count, 8) ThenBlock: {
                            fi_pt = 0
                        }
                        IfCondition EqualTo(fi_pt, JSType.OBJECT) ThenBlock: {
                            // Check OWN __field_init__ via PropTable (not inherited)
                            fi_hash = Dereference(Add(fi_proto, 8))
                            IfCondition NotEqual(fi_hash, 0) ThenBlock: {
                                fi_fn_raw = PropTable_Lookup(fi_hash, "__field_init__")
                                IfCondition NotEqual(fi_fn_raw, -1) ThenBlock: {
                                    fi_ft2 = JSRT_GetType(fi_fn_raw)
                                    IfCondition EqualTo(fi_ft2, JSType.FUNCTION) ThenBlock: {
                                        StoreValue(Add(fi_stk, Multiply(fi_count, 8)), fi_fn_raw)
                                        fi_count = Add(fi_count, 1)
                                    }
                                }
                            }
                            // Walk to parent prototype
                            fi_proto = JSRT_ObjGet(fi_proto, "__proto__")
                            fi_pt = JSRT_GetType(fi_proto)
                        }
                    }
                    // Call in reverse: parent first, child last
                    fi_idx = Subtract(fi_count, 1)
                    WhileLoop GreaterEqual(fi_idx, 0) {
                        fi_fn = Dereference(Add(fi_stk, Multiply(fi_idx, 8)))
                        fi_buf = JSVMCallBuf.buf
                        StoreValue(fi_buf, ret_val)
                        JSVM__CallFunc(fi_fn, fi_buf, 1)
                        fi_idx = Subtract(fi_idx, 1)
                    }
                }

                // Restore state from saved values
                JSVMState.pc = save_ret_pc
                JSVMState.sp = save_ret_sp

                // Push return value
                JSVM__StackPush(ret_val)
                ReturnValue(1)
            }

            // CLOSURE (57) — 16-bit constant index pointing to function descriptor
            Case 57: {
                cidx = JSVM__Read16()
                cval = JSVM__LoadConst(cidx)
                // Mole 7: attach parent activation env for free-var resolution
                JSVM__CaptureClosureEnv(cval)
                JSVM__StackPush(cval)
                ReturnValue(1)
            }

            // NEW_OBJECT (60)
            Case 60: {
                obj = JSRT_CreateObject()
                // Default [[Prototype]] = Object.prototype for instanceof Object
                IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                    JSRT_ObjSet(obj, "__proto__", JSRTState.object_proto)
                }
                JSVM__StackPush(obj)
                ReturnValue(1)
            }

            // NEW_ARRAY (61) — 16-bit operand: element count
            // Elements are on stack (first element pushed first = deepest)
            Case 61: {
                elem_count = JSVM__Read16()
                arr = JSRT_CreateArray()
                // Default [[Prototype]] = Array.prototype for instanceof Array
                IfCondition NotEqual(JSRTState.array_proto, 0) ThenBlock: {
                    JSRT_ObjSet(arr, "__proto__", JSRTState.array_proto)
                }

                // Pop elements in reverse (top = last element)
                // Store into a temp buffer first, then push in order
                IfCondition GreaterThan(elem_count, 0) ThenBlock: {
                    tbuf = JSVMCallBuf.buf
                    ei = Subtract(elem_count, 1)
                    WhileLoop GreaterEqual(ei, 0) {
                        ev = JSVM__StackPop()
                        StoreValue(Add(tbuf, Multiply(ei, 8)), ev)
                        ei = Subtract(ei, 1)
                    }
                    // Push them into array in order
                    ei = 0
                    WhileLoop LessThan(ei, elem_count) {
                        ev = Dereference(Add(tbuf, Multiply(ei, 8)))
                        JSRT_ArrPush(arr, ev)
                        ei = Add(ei, 1)
                    }
                }

                JSVM__StackPush(arr)
                ReturnValue(1)
            }

            // CONCAT (62) — string concatenation (pop 2, push result)
            Case 62: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                // Use JSRT_Add which handles string concatenation
                result = JSRT_Add(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // SET_PROP_COMPUTED (63) — pop value, pop key, pop obj; set obj[key]=value
            // Stack: [..., obj, key, value]
            // Also invokes __set_<key> when present (same as SET_PROP).
            Case 63: {
                sval = JSVM__StackPop()
                key_val = JSVM__StackPop()
                obj = JSVM__StackPop()
                // ToPropertyKey (Symbol → @@sN)
                JSRT__Push(sval)
                JSRT__Push(obj)
                key_ptr = JSVM_ToPropertyKey(key_val)
                obj = JSRT__Pop()
                sval = JSRT__Pop()

                // Wave 2: writable / freeze / non-extensible
                can = JSBridge_CanAssign(obj, key_ptr)
                IfCondition EqualTo(can, 0) ThenBlock: {
                    ReturnValue(1)
                }

                set_obj_t = JSRT_GetType(obj)
                IfCondition EqualTo(set_obj_t, JSType.OBJECT) ThenBlock: {
                    sk_buf2 = JSVMCallBuf.getter_buf
                    SetByte(sk_buf2, 0, 95)
                    SetByte(sk_buf2, 1, 95)
                    SetByte(sk_buf2, 2, 115)
                    SetByte(sk_buf2, 3, 101)
                    SetByte(sk_buf2, 4, 116)
                    SetByte(sk_buf2, 5, 95)
                    JSVMTmp.idx = 0
                    JSVMTmp.done = 0
                    WhileLoop EqualTo(JSVMTmp.done, 0) {
                        JSVMTmp.type = GetByte(key_ptr, JSVMTmp.idx)
                        SetByte(sk_buf2, Add(6, JSVMTmp.idx), JSVMTmp.type)
                        IfCondition EqualTo(JSVMTmp.type, 0) ThenBlock: {
                            JSVMTmp.done = 1
                        }
                        JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                    }
                    JSRT__Push(obj)
                    JSRT__Push(sval)
                    JSRT__Push(key_ptr)
                    setter_func = JSRT_ObjGet(obj, sk_buf2)
                    key_ptr = JSRT__Pop()
                    sval = JSRT__Pop()
                    obj = JSRT__Pop()
                    st = JSRT_GetType(setter_func)
                    IfCondition EqualTo(st, JSType.FUNCTION) ThenBlock: {
                        JSVM__SetGlobal("this", obj)
                        arg_buf_s = JSVMCallBuf.buf
                        StoreValue(arg_buf_s, sval)
                        JSVM__CallFunc(setter_func, arg_buf_s, 1)
                        ReturnValue(1)
                    }
                }

                JSRT_ObjSet(obj, key_ptr, sval)
                ReturnValue(1)
            }

            // DEF_GETTER (64) — 16-bit operand: const pool index (prop name)
            // Stack: [..., obj, func]. Pop func, pop obj, define getter.
            // Store as __get_<name> property on the object.
            // Key must be in stable memory (str_slab), NOT getter_buf, because
            // PropTable stores the key pointer and getter_buf is shared/transient.
            Case 64: {
                cidx = JSVM__Read16()
                JSVMTmp.ptr = JSVM__GetConstPayload(cidx)
                func_val = JSVM__StackPop()
                obj = JSVM__StackPop()
                // Build getter key: "__get_" + name in getter_buf (temp)
                gk_buf = JSVMCallBuf.getter_buf
                SetByte(gk_buf, 0, 95)
                SetByte(gk_buf, 1, 95)
                SetByte(gk_buf, 2, 103)
                SetByte(gk_buf, 3, 101)
                SetByte(gk_buf, 4, 116)
                SetByte(gk_buf, 5, 95)
                JSVMTmp.idx = 0
                JSVMTmp.done = 0
                WhileLoop EqualTo(JSVMTmp.done, 0) {
                    JSVMTmp.val = GetByte(JSVMTmp.ptr, JSVMTmp.idx)
                    SetByte(gk_buf, Add(6, JSVMTmp.idx), JSVMTmp.val)
                    IfCondition EqualTo(JSVMTmp.val, 0) ThenBlock: {
                        JSVMTmp.done = 1
                    }
                    JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                }
                // Copy to stable str_slab so PropTable key pointer survives
                gk_len = Add(6, JSVMTmp.idx)
                gk_stable = JSRT__StrSlabAlloc(gk_len)
                IfCondition EqualTo(gk_stable, 0) ThenBlock: { ReturnValue(1) }
                MemoryCopy(gk_stable, gk_buf, gk_len)
                JSRT_ObjSet(obj, gk_stable, func_val)
                // Placeholder own key so Object.keys / spread list the accessor name.
                // GET_PROP prefers __get_<name>, so this undefined data value is never read.
                JSRT_ObjSet(obj, JSVMTmp.ptr, JSRT_Undefined())
                ReturnValue(1)
            }

            // DEF_SETTER (65) — 16-bit operand: const pool index (prop name)
            // Stack: [..., obj, func]. Pop func, pop obj, define setter.
            // Key stored in stable str_slab (same fix as DEF_GETTER).
            Case 65: {
                cidx = JSVM__Read16()
                JSVMTmp.ptr = JSVM__GetConstPayload(cidx)
                func_val = JSVM__StackPop()
                obj = JSVM__StackPop()
                // Build setter key: "__set_" + name in getter_buf (temp)
                sk_buf = JSVMCallBuf.getter_buf
                SetByte(sk_buf, 0, 95)
                SetByte(sk_buf, 1, 95)
                SetByte(sk_buf, 2, 115)
                SetByte(sk_buf, 3, 101)
                SetByte(sk_buf, 4, 116)
                SetByte(sk_buf, 5, 95)
                JSVMTmp.idx = 0
                JSVMTmp.done = 0
                WhileLoop EqualTo(JSVMTmp.done, 0) {
                    JSVMTmp.val = GetByte(JSVMTmp.ptr, JSVMTmp.idx)
                    SetByte(sk_buf, Add(6, JSVMTmp.idx), JSVMTmp.val)
                    IfCondition EqualTo(JSVMTmp.val, 0) ThenBlock: {
                        JSVMTmp.done = 1
                    }
                    JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                }
                // Copy to stable str_slab so PropTable key pointer survives
                sk_len = Add(6, JSVMTmp.idx)
                sk_stable = JSRT__StrSlabAlloc(sk_len)
                IfCondition EqualTo(sk_stable, 0) ThenBlock: { ReturnValue(1) }
                MemoryCopy(sk_stable, sk_buf, sk_len)
                JSRT_ObjSet(obj, sk_stable, func_val)
                ReturnValue(1)
            }

            // DEF_GETTER_COMPUTED (76) — Stack: [obj, key, func]
            // Pop func, pop key, pop obj; define getter obj[key] = func
            // Key stored in stable str_slab (same fix as DEF_GETTER).
            Case 76: {
                func_val = JSVM__StackPop()
                key_val = JSVM__StackPop()
                obj = JSVM__StackPop()
                key_str = JSRT_ToString(key_val)
                JSVMTmp.ptr = JSRT_GetPayload(key_str)
                // Build getter key: "__get_" + name in getter_buf (temp)
                gk_buf = JSVMCallBuf.getter_buf
                SetByte(gk_buf, 0, 95)
                SetByte(gk_buf, 1, 95)
                SetByte(gk_buf, 2, 103)
                SetByte(gk_buf, 3, 101)
                SetByte(gk_buf, 4, 116)
                SetByte(gk_buf, 5, 95)
                JSVMTmp.idx = 0
                JSVMTmp.done = 0
                WhileLoop EqualTo(JSVMTmp.done, 0) {
                    JSVMTmp.val = GetByte(JSVMTmp.ptr, JSVMTmp.idx)
                    SetByte(gk_buf, Add(6, JSVMTmp.idx), JSVMTmp.val)
                    IfCondition EqualTo(JSVMTmp.val, 0) ThenBlock: {
                        JSVMTmp.done = 1
                    }
                    JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                }
                // Copy to stable str_slab
                gk_len = Add(6, JSVMTmp.idx)
                gk_stable = JSRT__StrSlabAlloc(gk_len)
                IfCondition EqualTo(gk_stable, 0) ThenBlock: { ReturnValue(1) }
                MemoryCopy(gk_stable, gk_buf, gk_len)
                JSRT_ObjSet(obj, gk_stable, func_val)
                ReturnValue(1)
            }

            // DEF_SETTER_COMPUTED (77) — Stack: [obj, key, func]
            // Pop func, pop key, pop obj; define setter obj[key] = func
            // Key stored in stable str_slab (same fix as DEF_SETTER).
            Case 77: {
                func_val = JSVM__StackPop()
                key_val = JSVM__StackPop()
                obj = JSVM__StackPop()
                key_str = JSRT_ToString(key_val)
                JSVMTmp.ptr = JSRT_GetPayload(key_str)
                // Build setter key: "__set_" + name in getter_buf (temp)
                sk_buf = JSVMCallBuf.getter_buf
                SetByte(sk_buf, 0, 95)
                SetByte(sk_buf, 1, 95)
                SetByte(sk_buf, 2, 115)
                SetByte(sk_buf, 3, 101)
                SetByte(sk_buf, 4, 116)
                SetByte(sk_buf, 5, 95)
                JSVMTmp.idx = 0
                JSVMTmp.done = 0
                WhileLoop EqualTo(JSVMTmp.done, 0) {
                    JSVMTmp.val = GetByte(JSVMTmp.ptr, JSVMTmp.idx)
                    SetByte(sk_buf, Add(6, JSVMTmp.idx), JSVMTmp.val)
                    IfCondition EqualTo(JSVMTmp.val, 0) ThenBlock: {
                        JSVMTmp.done = 1
                    }
                    JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                }
                // Copy to stable str_slab
                sk_len = Add(6, JSVMTmp.idx)
                sk_stable = JSRT__StrSlabAlloc(sk_len)
                IfCondition EqualTo(sk_stable, 0) ThenBlock: { ReturnValue(1) }
                MemoryCopy(sk_stable, sk_buf, sk_len)
                JSRT_ObjSet(obj, sk_stable, func_val)
                ReturnValue(1)
            }

            // THROW_TDZ (78) — ReferenceError: cannot access variable before initialization
            // 3-byte operand: const pool index of variable name string
            Case 78: {
                ci = JSVM__Read16()
                tdz_err = JSVM_CreateTypedError("ReferenceError", "Cannot access variable before initialization")
                JSVM_ThrowValue(tdz_err)
                ReturnValue(1)
            }

            // THROW_CONST (88) — TypeError: assignment to const variable
            Case 88: {
                // Discard stack value being assigned (if any)
                IfCondition GreaterThan(JSVMState.sp, 0) ThenBlock: {
                    JSVM__StackPop()
                }
                cerr = JSVM_CreateTypedError("TypeError", "Assignment to constant variable")
                JSVM_ThrowValue(cerr)
                ReturnValue(1)
            }

            // OBJ_KEYS (66) — pop object, push array of key strings
            Case 66: {
                obj = JSVM__StackPop()
                keys_arr = JSRT_ObjKeys(obj)
                JSVM__StackPush(keys_arr)
                ReturnValue(1)
            }

            // ARR_APPEND (67) — Stack: [..., array, value] → append value to array, push array
            Case 67: {
                sval = JSVM__StackPop()
                arr = JSVM__StackPop()
                JSRT_ArrPush(arr, sval)
                JSVM__StackPush(arr)
                ReturnValue(1)
            }

            // ARR_EXTEND (68) — Stack: [..., dest, src] → extend dest with iterable src
            // Arrays/strings direct; objects via Symbol.iterator (Mole 9).
            Case 68: {
                src_arr = JSVM__StackPop()
                dest_arr = JSVM__StackPop()
                src_t = JSRT_GetType(src_arr)
                // Fast path: array
                IfCondition EqualTo(src_t, JSType.ARRAY) ThenBlock: {
                    src_len = JSRT_ArrLen(src_arr)
                    ei = 0
                    WhileLoop LessThan(ei, src_len) {
                        ev = JSRT_ArrGet(src_arr, ei)
                        JSRT_ArrPush(dest_arr, ev)
                        ei = Add(ei, 1)
                    }
                    JSVM__StackPush(dest_arr)
                    ReturnValue(1)
                }
                // Iterable path (throws on null/undefined / non-iterable)
                expanded = JSVM_IterableToArray(src_arr)
                IfCondition EqualTo(expanded, 0) ThenBlock: {
                    // throw already set
                    ReturnValue(1)
                }
                src_len2 = JSRT_ArrLen(expanded)
                ei2 = 0
                WhileLoop LessThan(ei2, src_len2) {
                    JSRT_ArrPush(dest_arr, JSRT_ArrGet(expanded, ei2))
                    ei2 = Add(ei2, 1)
                }
                JSVM__StackPush(dest_arr)
                ReturnValue(1)
            }

            // CALL_SPREAD (69) — Stack: [..., func, args_array] → call func with array elements as args
            // Mirrors CALL: rest formals, arguments object, SetupCallEnv.
            Case 69: {
                args_arr = JSVM__StackPop()
                func_val = JSVM__StackPop()

                ft = JSRT_GetType(func_val)
                IfCondition NotEqual(ft, JSType.FUNCTION) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "is not a function")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }

                // Build arg_buf from array elements (static buffer)
                argc = JSRT_ArrLen(args_arr)
                IfCondition GreaterThan(argc, JSVMConst.MAX_CALL_ARGS) ThenBlock: {
                    argc = JSVMConst.MAX_CALL_ARGS
                }
                arg_buf = JSVMCallBuf.buf
                ai = 0
                WhileLoop LessThan(ai, argc) {
                    arg_v = JSRT_ArrGet(args_arr, ai)
                    StoreValue(Add(arg_buf, Multiply(ai, 8)), arg_v)
                    ai = Add(ai, 1)
                }

                // Check if native function
                func_bc = JSRT_FuncGetBC(func_val)
                IfCondition LessThan(func_bc, 0) ThenBlock: {
                    handler_id = Subtract(-1, func_bc)
                    IfCondition GreaterEqual(handler_id, 16) ThenBlock: {
                        native_result = JSBridge_Dispatch(handler_id, arg_buf, argc)
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }
                    native_result = JSRT_CallNative(handler_id, arg_buf, argc)
                    JSVM__StackPush(native_result)
                    ReturnValue(1)
                }

                // User-defined function call (same setup as CALL)
                func_params = JSRT_FuncGetParams(func_val)
                func_locals = JSRT_FuncGetLocals(func_val)

                save_pc = JSVMState.pc
                save_sp = JSVMState.sp
                locals_base = JSVMState.sp

                pf_ok = JSVM__PushFrame(save_pc, save_sp, locals_base, func_params, func_locals)
                IfCondition LessThan(pf_ok, 0) ThenBlock: {
                    PrintMessage("[JSEngine] call stack overflow (MAX_FRAMES)\n")
                    JSVMState.error = 1
                    ReturnValue(-1)
                }
                JSVM__SetupCallEnv(func_val)

                // Mole 16: per-function strict — save outer, enter if bit 29
                prev_strict = JSVMState.is_strict
                faddr_s = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
                StoreValue(Add(faddr_s, 72), prev_strict)
                IfCondition NotEqual(BitwiseAnd(func_params, 536870912), 0) ThenBlock: {
                    JSVMState.is_strict = 1
                }

                // Rest formals (bit 31); unmapped args (bit 30); count in low 30 bits
                rest_flag = 0
                rest_idx = -1
                formal_count = BitwiseAnd(func_params, 268435455)
                IfCondition NotEqual(BitwiseAnd(func_params, 2147483648), 0) ThenBlock: {
                    rest_flag = 1
                    rest_idx = Subtract(formal_count, 1)
                }
                unmapped_bit = BitwiseAnd(func_params, 1073741824)

                pi = 0
                WhileLoop LessThan(pi, func_locals) {
                    pushed = 0
                    IfCondition EqualTo(rest_flag, 1) ThenBlock: {
                        IfCondition EqualTo(pi, rest_idx) ThenBlock: {
                            rest_arr = JSRT_CreateArray()
                            ri = rest_idx
                            WhileLoop LessThan(ri, argc) {
                                rval = Dereference(Add(arg_buf, Multiply(ri, 8)))
                                JSRT_ArrPush(rest_arr, rval)
                                ri = Add(ri, 1)
                            }
                            JSVM__StackPush(rest_arr)
                            pushed = 1
                        }
                        IfCondition EqualTo(pushed, 0) ThenBlock: {
                            IfCondition LessThan(pi, rest_idx) ThenBlock: {
                                IfCondition LessThan(pi, argc) ThenBlock: {
                                    pval = Dereference(Add(arg_buf, Multiply(pi, 8)))
                                    JSVM__StackPush(pval)
                                } ElseBlock: {
                                    JSVM__StackPush(JSRT_Undefined())
                                }
                                pushed = 1
                            }
                        }
                    }
                    IfCondition EqualTo(pushed, 0) ThenBlock: {
                        IfCondition LessThan(pi, argc) ThenBlock: {
                            IfCondition EqualTo(rest_flag, 0) ThenBlock: {
                                pval = Dereference(Add(arg_buf, Multiply(pi, 8)))
                                JSVM__StackPush(pval)
                            } ElseBlock: {
                                JSVM__StackPush(JSRT_Undefined())
                            }
                        } ElseBlock: {
                            JSVM__StackPush(JSRT_Undefined())
                        }
                    }
                    pi = Add(pi, 1)
                }

                // arguments object — mapped formals + callee
                map_n = formal_count
                IfCondition NotEqual(unmapped_bit, 0) ThenBlock: {
                    map_n = 0
                }
                IfCondition EqualTo(rest_flag, 1) ThenBlock: {
                    IfCondition EqualTo(unmapped_bit, 0) ThenBlock: {
                        map_n = rest_idx
                    }
                }
                IfCondition LessThan(map_n, 0) ThenBlock: { map_n = 0 }
                IfCondition EqualTo(BitwiseAnd(func_params, 268435456), 0) ThenBlock: {
                    args_obj = JSVM_CreateArguments(arg_buf, argc, func_val, map_n)
                    JSVM__SaveArguments()
                    JSVM__SetGlobal("arguments", args_obj)
                    IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                        fi_a = Subtract(JSVMState.fp, 1)
                        env_a = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi_a, 8)))
                        IfCondition NotEqual(env_a, 0) ThenBlock: {
                            JSRT_ObjSet(env_a, "arguments", args_obj)
                        }
                    }
                } ElseBlock: {
                    JSVM__SaveArguments()
                }

                JSVMState.pc = func_bc
                ReturnValue(1)
            }

            // CONSTRUCT (81) — new Foo(args) constructor call
            // Stack: [..., func, arg0, arg1, ..., argN-1]
            // Creates new object, binds this, calls constructor, returns object
            Case 81: {
                argc = JSVM__ReadByte()
                PrintMessage("[CONSTRUCT] argc=")
                PrintNumber(argc)
                PrintMessage(" sp=")
                PrintNumber(JSVMState.sp)
                PrintMessage("\n")

                // Use static arg buffer (no per-call allocation)
                arg_buf = JSVMCallBuf.buf

                ai = Subtract(argc, 1)
                WhileLoop GreaterEqual(ai, 0) {
                    arg_v = JSVM__StackPop()
                    StoreValue(Add(arg_buf, Multiply(ai, 8)), arg_v)
                    ai = Subtract(ai, 1)
                }

                // Pop function (constructor)
                func_val = JSVM__StackPop()
                PrintMessage("[CONSTRUCT] func_val=")
                PrintNumber(func_val)
                PrintMessage(" type=")
                ft = JSRT_GetType(func_val)
                PrintNumber(ft)
                PrintMessage("\n")
                // If OBJECT, check for __ctor__ (e.g., Promise)
                IfCondition EqualTo(ft, JSType.OBJECT) ThenBlock: {
                    ctor_fn = JSRT_ObjGet(func_val, "__ctor__")
                    ctor_ft = JSRT_GetType(ctor_fn)
                    IfCondition EqualTo(ctor_ft, JSType.FUNCTION) ThenBlock: {
                        func_val = ctor_fn
                        ft = JSType.FUNCTION
                    }
                }
                IfCondition NotEqual(ft, JSType.FUNCTION) ThenBlock: {
                    // Wave 3 D1: new on non-constructor → TypeError
                    terr = JSVM_CreateTypedError("TypeError", "is not a constructor")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                // Generators are not constructible
                c_env = JSRT_FuncGetEnv(func_val)
                IfCondition Or(EqualTo(c_env, 71), EqualTo(c_env, 66)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Generator is not a constructor")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }

                // Create new object for this — store in JSVMTmp.obj to survive calls
                JSVMTmp.obj = JSRT_CreateObject()
                IfCondition EqualTo(JSVMTmp.obj, 0) ThenBlock: {
                    PrintMessage("[JSEngine] OOM in CONSTRUCT (CreateObject)\n")
                    JSVMState.error = 1
                    JSVM__StackPush(JSRT_Undefined())
                    ReturnValue(-1)
                }

                // Set prototype: new_obj.__proto__ = func.prototype
                // Spec: if Type(proto) is Object (includes function/array), use it;
                // else Object.prototype. Our JSType.FUNCTION is not OBJECT.
                proto_val = JSRT_ObjGet(func_val, "prototype")
                proto_type = JSRT_GetType(proto_val)
                proto_ok = 0
                IfCondition EqualTo(proto_type, JSType.OBJECT) ThenBlock: { proto_ok = 1 }
                IfCondition EqualTo(proto_type, JSType.FUNCTION) ThenBlock: { proto_ok = 1 }
                IfCondition EqualTo(proto_type, JSType.ARRAY) ThenBlock: { proto_ok = 1 }
                IfCondition EqualTo(proto_ok, 1) ThenBlock: {
                    JSRT_ObjSet(JSVMTmp.obj, "__proto__", proto_val)
                } ElseBlock: {
                    IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                        JSRT_ObjSet(JSVMTmp.obj, "__proto__", JSRTState.object_proto)
                    }
                }

                // Check if native constructor
                func_bc = JSRT_FuncGetBC(func_val)
                PrintMessage("[CONSTRUCT] bc=")
                PrintNumber(func_bc)
                PrintMessage("\n")
                IfCondition LessThan(func_bc, 0) ThenBlock: {
                    // Native constructor — dispatch and return result or new_obj
                    handler_id = Subtract(-1, func_bc)
                    // Promise dispatch (57-61, 77-78) in CONSTRUCT
                    IfCondition GreaterEqual(handler_id, 57) ThenBlock: {
                        IfCondition LessEqual(handler_id, 61) ThenBlock: {
                            promise_recv = JSRT_FuncGetEnv(func_val)
                            native_result = JSBridge__DispatchPromise(handler_id, promise_recv, arg_buf, argc)
                            // (static arg_buf — no dealloc needed)
                            nr_type = JSRT_GetType(native_result)
                            IfCondition Or(EqualTo(nr_type, JSType.OBJECT), EqualTo(nr_type, JSType.ARRAY)) ThenBlock: {
                                JSVM__StackPush(native_result)
                            } ElseBlock: {
                                JSVM__StackPush(JSVMTmp.obj)
                            }
                            ReturnValue(1)
                        }
                    }
                    // String/Array method dispatch (62-76, 97)
                    is_str_method = 0
                    IfCondition GreaterEqual(handler_id, 62) ThenBlock: {
                        IfCondition LessEqual(handler_id, 76) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition GreaterEqual(handler_id, 97) ThenBlock: {
                        IfCondition LessEqual(handler_id, 99) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition EqualTo(is_str_method, 1) ThenBlock: {
                            PrintMessage("[CONSTRUCT] dispatching to StringMethod\n")
                            native_result = JSVM__DispatchStringMethod(handler_id, JSVMTmp.obj, arg_buf, argc)
                            // (static arg_buf — no dealloc needed)
                            nr_type = JSRT_GetType(native_result)
                            IfCondition Or(EqualTo(nr_type, JSType.OBJECT), EqualTo(nr_type, JSType.ARRAY)) ThenBlock: {
                                JSVM__StackPush(native_result)
                            } ElseBlock: {
                                JSVM__StackPush(JSVMTmp.obj)
                            }
                            ReturnValue(1)
                    }
                    PrintMessage("[CONSTRUCT] fallthrough handler_id=")
                    PrintNumber(handler_id)
                    PrintMessage("\n")
                    IfCondition GreaterEqual(handler_id, 22) ThenBlock: {
                        native_result = JSBridge_Dispatch(handler_id, arg_buf, argc)
                    } ElseBlock: {
                        native_result = JSRT_CallNative(handler_id, arg_buf, argc)
                    }
                    // (static arg_buf — no dealloc needed)
                    // If native returned an object/array, use that; otherwise use new_obj.
                    // Native Error/etc. ctors allocate a fresh object and skip the
                    // this-object we already prototyped — stamp [[Prototype]] here
                    // so `new Error() instanceof Error` works.
                    nr_type = JSRT_GetType(native_result)
                    IfCondition Or(EqualTo(nr_type, JSType.OBJECT), EqualTo(nr_type, JSType.ARRAY)) ThenBlock: {
                        proto_type = JSRT_GetType(proto_val)
                        IfCondition EqualTo(proto_type, JSType.OBJECT) ThenBlock: {
                            JSRT__Push(native_result)
                            existing_p = JSRT_ObjGet(native_result, "__proto__")
                            native_result = JSRT__Pop()
                            ep_t = JSRT_GetType(existing_p)
                            IfCondition NotEqual(ep_t, JSType.OBJECT) ThenBlock: {
                                JSRT_ObjSet(native_result, "__proto__", proto_val)
                            }
                        }
                        JSVM__StackPush(native_result)
                    } ElseBlock: {
                        // Box Number/Boolean/String primitives into this (ES [[*Data]])
                        // RegisterNative: 8=Number, 9=String, 10=Boolean
                        IfCondition EqualTo(handler_id, 8) ThenBlock: {
                            JSRT_ObjSet(JSVMTmp.obj, "__value__", native_result)
                            JSRT_ObjSet(JSVMTmp.obj, "__class__", JSRT_CreateString("Number"))
                        }
                        IfCondition EqualTo(handler_id, 9) ThenBlock: {
                            JSRT_ObjSet(JSVMTmp.obj, "__value__", native_result)
                            JSRT_ObjSet(JSVMTmp.obj, "__class__", JSRT_CreateString("String"))
                        }
                        IfCondition EqualTo(handler_id, 10) ThenBlock: {
                            JSRT_ObjSet(JSVMTmp.obj, "__value__", native_result)
                            JSRT_ObjSet(JSVMTmp.obj, "__class__", JSRT_CreateString("Boolean"))
                        }
                        JSVM__StackPush(JSVMTmp.obj)
                    }
                    ReturnValue(1)
                }

                PrintMessage("[CONSTRUCT] checkpoint1\n")
                // Bind this: set global "this" to new_obj
                JSVM__SetGlobal("this", JSVMTmp.obj)
                PrintMessage("[CONSTRUCT] checkpoint2\n")

                // If constructor has __super__ property, set it as global
                // so the constructor body's hidden local can capture it.
                JSRT__Push(func_val)
                sup_val = JSRT_FuncPropGet(func_val, "__super__")
                func_val = JSRT__Pop()
                sup_type = JSRT_GetType(sup_val)
                IfCondition EqualTo(sup_type, JSType.FUNCTION) ThenBlock: {
                    JSVM__SetGlobal("__super__", sup_val)
                }

                // Set up call frame (same as CALL)
                func_params = JSRT_FuncGetParams(func_val)
                func_locals = JSRT_FuncGetLocals(func_val)

                save_pc = JSVMState.pc
                save_sp = JSVMState.sp
                locals_base = JSVMState.sp

                pf_ok = JSVM__PushFrame(save_pc, save_sp, locals_base, func_params, func_locals)
                IfCondition LessThan(pf_ok, 0) ThenBlock: {
                    PrintMessage("[JSEngine] call stack overflow (MAX_FRAMES)\n")
                    JSVMState.error = 1
                    ReturnValue(-1)
                }
                JSVM__SetupCallEnv(func_val)

                // Mole 16: per-function strict — save outer, enter if bit 29
                prev_strict = JSVMState.is_strict
                faddr_s = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
                StoreValue(Add(faddr_s, 72), prev_strict)
                IfCondition NotEqual(BitwiseAnd(func_params, 536870912), 0) ThenBlock: {
                    JSVMState.is_strict = 1
                }

                // Mark frame as constructor: store new_obj at frame offset 40
                faddr = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
                StoreValue(Add(faddr, 40), JSVMTmp.obj)

                // Push locals onto stack (initialize args, rest to undefined)
                pi = 0
                WhileLoop LessThan(pi, func_locals) {
                    IfCondition LessThan(pi, argc) ThenBlock: {
                        pval = Dereference(Add(arg_buf, Multiply(pi, 8)))
                        JSVM__StackPush(pval)
                    } ElseBlock: {
                        JSVM__StackPush(JSRT_Undefined())
                    }
                    pi = Add(pi, 1)
                }

                // arguments object for constructor body
                map_n = func_params
                IfCondition NotEqual(BitwiseAnd(func_params, 2147483648), 0) ThenBlock: {
                    map_n = Subtract(BitwiseAnd(func_params, 2147483647), 1)
                }
                IfCondition LessThan(map_n, 0) ThenBlock: { map_n = 0 }
                args_obj = JSVM_CreateArguments(arg_buf, argc, func_val, map_n)
                JSVM__SaveArguments()
                JSVM__SetGlobal("arguments", args_obj)

                // Jump to constructor code
                JSVMState.pc = func_bc
                ReturnValue(1)
            }

            // CALL_METHOD (83) — method call with this binding
            // Stack: [..., receiver, func, arg0, arg1, ..., argN-1]
            // Like CALL but pops receiver below func and binds this = receiver
            Case 83: {
                argc = JSVM__ReadByte()

                // Use static arg buffer (no per-call allocation)
                arg_buf = JSVMCallBuf.buf

                ai = Subtract(argc, 1)
                WhileLoop GreaterEqual(ai, 0) {
                    arg_v = JSVM__StackPop()
                    StoreValue(Add(arg_buf, Multiply(ai, 8)), arg_v)
                    ai = Subtract(ai, 1)
                }

                // Pop function value
                func_val = JSVM__StackPop()

                // Pop receiver (the object the method was called on)
                cm_receiver = JSVM__StackPop()

                ft = JSRT_GetType(func_val)
                IfCondition NotEqual(ft, JSType.FUNCTION) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "is not a function")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }

                // Bind this = receiver
                JSVM__SetGlobal("this", cm_receiver)

                // Check if this is a native function
                func_bc = JSRT_FuncGetBC(func_val)
                IfCondition LessThan(func_bc, 0) ThenBlock: {
                    // Native function call — dispatch through JSRuntime or JSBridge
                    handler_id = Subtract(-1, func_bc)

                    // Generator .next() — handler_id = 9998 (bc = -9999)
                    IfCondition EqualTo(handler_id, 9998) ThenBlock: {
                        gen_result = JSVM__GenNext(func_val, arg_buf, argc)
                        // Mole 15: body throw → abrupt .next() (CALL_METHOD path)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pendgm = JSVMCall.thrown_val
                            IfCondition EqualTo(pendgm, 0) ThenBlock: {
                                pendgm = JSVMState.exc_val
                            }
                            IfCondition EqualTo(pendgm, 0) ThenBlock: {
                                pendgm = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVMCall.thrown_val = 0
                            JSVMState.exc_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition EqualTo(pendgm, 0) ThenBlock: {
                                pendgm = JSVM_CreateTypedError("TypeError", "generator threw")
                            }
                            JSVM_ThrowValue(pendgm)
                            ReturnValue(1)
                        }
                        JSVM__StackPush(gen_result)
                        ReturnValue(1)
                    }
                    // Generator .return() — handler_id = 9997 (bc = -9998)
                    IfCondition EqualTo(handler_id, 9997) ThenBlock: {
                        gen_result = JSVM__GenReturn(func_val, arg_buf, argc)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pendr = JSVMCall.thrown_val
                            IfCondition EqualTo(pendr, 0) ThenBlock: {
                                pendr = JSVMState.exc_val
                            }
                            IfCondition EqualTo(pendr, 0) ThenBlock: {
                                pendr = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVMCall.thrown_val = 0
                            JSVMState.exc_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition EqualTo(pendr, 0) ThenBlock: {
                                pendr = JSVM_CreateTypedError("TypeError", "generator return abrupt")
                            }
                            JSVM_ThrowValue(pendr)
                            ReturnValue(1)
                        }
                        JSVM__StackPush(gen_result)
                        ReturnValue(1)
                    }
                    // Generator .throw() — handler_id = 9996 (bc = -9997)
                    IfCondition EqualTo(handler_id, 9996) ThenBlock: {
                        gen_result = JSVM__GenThrow(func_val, arg_buf, argc)
                        JSVM__StackPush(gen_result)
                        ReturnValue(1)
                    }

                    // eval() — handler_id = 193
                    IfCondition EqualTo(handler_id, 193) ThenBlock: {
                        native_result = JSVM_EvalNative(arg_buf, argc)
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }

                    // Symbol() — handler_id = 194
                    IfCondition EqualTo(handler_id, 194) ThenBlock: {
                        native_result = JSVM_SymbolNative(arg_buf, argc)
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }

                    // Handler IDs 57-61, 77-78: Promise methods (env = promise receiver)
                    IfCondition GreaterEqual(handler_id, 57) ThenBlock: {
                        IfCondition LessEqual(handler_id, 61) ThenBlock: {
                            promise_recv = JSRT_FuncGetEnv(func_val)
                            native_result = JSBridge__DispatchPromise(handler_id, promise_recv, arg_buf, argc)
                            JSVM__StackPush(native_result)
                            ReturnValue(1)
                        }
                    }
                    IfCondition GreaterEqual(handler_id, 77) ThenBlock: {
                        IfCondition LessEqual(handler_id, 78) ThenBlock: {
                            promise_recv = JSRT_FuncGetEnv(func_val)
                            native_result = JSBridge__DispatchPromise(handler_id, promise_recv, arg_buf, argc)
                            JSVM__StackPush(native_result)
                            ReturnValue(1)
                        }
                    }

                    // Handler IDs 83-87: RegExp methods (env = receiver)
                    IfCondition GreaterEqual(handler_id, 83) ThenBlock: {
                        IfCondition LessEqual(handler_id, 87) ThenBlock: {
                            rx_recv = JSRT_FuncGetEnv(func_val)
                            native_result = JSVM__DispatchRegExpMethod(handler_id, rx_recv, arg_buf, argc)
                            JSVM__StackPush(native_result)
                            ReturnValue(1)
                        }
                    }

                    // Handler IDs 62-76, 97-99, 150-171, 180-191: String/Array/JSON methods (env = receiver)
                    is_str_method = 0
                    IfCondition GreaterEqual(handler_id, 62) ThenBlock: {
                        IfCondition LessEqual(handler_id, 76) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition GreaterEqual(handler_id, 97) ThenBlock: {
                        IfCondition LessEqual(handler_id, 99) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition GreaterEqual(handler_id, 150) ThenBlock: {
                        IfCondition LessEqual(handler_id, 171) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition GreaterEqual(handler_id, 180) ThenBlock: {
                        IfCondition LessEqual(handler_id, 186) ThenBlock: { is_str_method = 1 }
                    }
                    IfCondition EqualTo(is_str_method, 1) ThenBlock: {
                        str_recv = JSRT_FuncGetEnv(func_val)
                        native_result = JSVM__DispatchStringMethod(handler_id, str_recv, arg_buf, argc)
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }

                    // Handler IDs 0-21: JSRuntime built-ins (0-14 math/type, 15-21 Error ctors)
                    // Handler IDs 22+: JSBridge DOM/timer natives
                    IfCondition GreaterEqual(handler_id, 22) ThenBlock: {
                        native_result = JSBridge_Dispatch(handler_id, arg_buf, argc)
                        // Native throw (e.g. defineProperty reject) — catch already set
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend_n = JSVMCall.thrown_val
                            IfCondition EqualTo(pend_n, 0) ThenBlock: {
                                pend_n = JSVM__GetGlobal("__pend_exc__")
                            }
                            IfCondition NotEqual(pend_n, 0) ThenBlock: {
                                IfCondition NotEqual(pend_n, JSRTState.undef_val) ThenBlock: {
                                    JSVM__StackPush(pend_n)
                                }
                            }
                            JSVMCall.exc_prop = 0
                            JSVMCall.thrown_val = 0
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }
                    native_result = JSRT_CallNative(handler_id, arg_buf, argc)
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        pend_n = JSVMCall.thrown_val
                        IfCondition EqualTo(pend_n, 0) ThenBlock: {
                            pend_n = JSVM__GetGlobal("__pend_exc__")
                        }
                        IfCondition NotEqual(pend_n, 0) ThenBlock: {
                            IfCondition NotEqual(pend_n, JSRTState.undef_val) ThenBlock: {
                                JSVM__StackPush(pend_n)
                            }
                        }
                        JSVMCall.exc_prop = 0
                        JSVMCall.thrown_val = 0
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    JSVM__StackPush(native_result)
                    ReturnValue(1)
                }

                // Check if this is a generator function (env == 71 magic)
                func_env = JSRT_FuncGetEnv(func_val)
                IfCondition EqualTo(func_env, 71) ThenBlock: {
                    gen_val = JSRT_CreateGenerator(func_val, arg_buf, argc)
                    fdi_ok = JSVM__GenInitParams(gen_val, func_val)
                    IfCondition EqualTo(fdi_ok, 0) ThenBlock: {
                        pend_fdi = JSVMCall.thrown_val
                        IfCondition EqualTo(pend_fdi, 0) ThenBlock: {
                            pend_fdi = JSVMState.exc_val
                        }
                        IfCondition EqualTo(pend_fdi, 0) ThenBlock: {
                            pend_fdi = JSVM__GetGlobal("__pend_exc__")
                        }
                        JSVMCall.thrown_val = 0
                        JSVMCall.exc_prop = 0
                        JSVMState.exc_val = 0
                        IfCondition NotEqual(pend_fdi, 0) ThenBlock: {
                            JSVM_ThrowValue(pend_fdi)
                        } ElseBlock: {
                            JSVMState.error = 1
                            JSVMState.halted = 1
                        }
                        ReturnValue(1)
                    }
                    gen_gs = Dereference(Add(gen_val, 8))
                    next_func = JSRT_CreateFunc(-9999, 1, 0, "next")
                    JSRT_FuncSetEnv(next_func, gen_val)
                    ret_func = JSRT_CreateFunc(-9998, 1, 0, "return")
                    JSRT_FuncSetEnv(ret_func, gen_val)
                    throw_func = JSRT_CreateFunc(-9997, 1, 0, "throw")
                    JSRT_FuncSetEnv(throw_func, gen_val)
                    gen_obj = JSRT_CreateObject()
                    gen_proto = JSRT_ObjGet(func_val, "prototype")
                    IfCondition EqualTo(JSRT_GetType(gen_proto), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(gen_obj, "__proto__", gen_proto)
                    }
                    JSRT_ObjSet(gen_obj, "next", next_func)
                    JSRT_ObjSet(gen_obj, "return", ret_func)
                    JSRT_ObjSet(gen_obj, "throw", throw_func)
                    JSRT_ObjSet(gen_obj, "__gen__", gen_val)
                    JSVM__StackPush(gen_obj)
                    ReturnValue(1)
                }

                // Async generator function (env == 66)
                IfCondition EqualTo(func_env, 66) ThenBlock: {
                    gen_val = JSRT_CreateGenerator(func_val, arg_buf, argc)
                    ag_gs = JSRT_GetPayload(gen_val)
                    StoreValue(Add(ag_gs, 104), 1)
                    gen_gs = Dereference(Add(gen_val, 8))
                    next_func = JSRT_CreateFunc(-9999, 1, 0, "next")
                    JSRT_FuncSetEnv(next_func, gen_val)
                    ret_func = JSRT_CreateFunc(-9998, 1, 0, "return")
                    JSRT_FuncSetEnv(ret_func, gen_val)
                    throw_func = JSRT_CreateFunc(-9997, 1, 0, "throw")
                    JSRT_FuncSetEnv(throw_func, gen_val)
                    gen_obj = JSRT_CreateObject()
                    gen_proto = JSRT_ObjGet(func_val, "prototype")
                    IfCondition EqualTo(JSRT_GetType(gen_proto), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(gen_obj, "__proto__", gen_proto)
                    }
                    JSRT_ObjSet(gen_obj, "next", next_func)
                    JSRT_ObjSet(gen_obj, "return", ret_func)
                    JSRT_ObjSet(gen_obj, "throw", throw_func)
                    JSRT_ObjSet(gen_obj, "__gen__", gen_val)
                    JSRT_ObjSet(gen_obj, "__async_gen__", JSRT_CreateNumber(1))
                    JSVM__StackPush(gen_obj)
                    ReturnValue(1)
                }

                // If callee has __super__, set it as global for the callee body.
                JSRT__Push(func_val)
                call_sup = JSRT_FuncPropGet(func_val, "__super__")
                func_val = JSRT__Pop()
                call_sup_t = JSRT_GetType(call_sup)
                IfCondition EqualTo(call_sup_t, JSType.FUNCTION) ThenBlock: {
                    JSVM__SetGlobal("__super__", call_sup)
                }

                // Get function descriptor fields
                func_params = JSRT_FuncGetParams(func_val)
                func_locals = JSRT_FuncGetLocals(func_val)

                // Save current state in a call frame
                save_pc = JSVMState.pc
                save_sp = JSVMState.sp
                locals_base = JSVMState.sp

                pf_ok = JSVM__PushFrame(save_pc, save_sp, locals_base, func_params, func_locals)
                IfCondition LessThan(pf_ok, 0) ThenBlock: {
                    PrintMessage("[JSEngine] call stack overflow (MAX_FRAMES)\n")
                    JSVMState.error = 1
                    ReturnValue(-1)
                }
                JSVM__SetupCallEnv(func_val)

                // Mole 16: per-function strict — save outer, enter if bit 29
                prev_strict = JSVMState.is_strict
                faddr_s = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
                StoreValue(Add(faddr_s, 72), prev_strict)
                IfCondition NotEqual(BitwiseAnd(func_params, 536870912), 0) ThenBlock: {
                    JSVMState.is_strict = 1
                }

                // Mark async frames with -65 at offset 40 so RETURN can wrap result
                IfCondition EqualTo(func_env, 65) ThenBlock: {
                    af_addr = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
                    StoreValue(Add(af_addr, 40), -65)
                }

                // Push locals onto stack (initialize args, rest to undefined)
                pi = 0
                WhileLoop LessThan(pi, func_locals) {
                    IfCondition LessThan(pi, argc) ThenBlock: {
                        pval = Dereference(Add(arg_buf, Multiply(pi, 8)))
                        JSVM__StackPush(pval)
                    } ElseBlock: {
                        JSVM__StackPush(JSRT_Undefined())
                    }
                    pi = Add(pi, 1)
                }

                // arguments object for method call (skip for arrows — bit 28)
                map_n = BitwiseAnd(func_params, 268435455)
                IfCondition NotEqual(BitwiseAnd(func_params, 2147483648), 0) ThenBlock: {
                    map_n = Subtract(BitwiseAnd(func_params, 268435455), 1)
                }
                IfCondition LessThan(map_n, 0) ThenBlock: { map_n = 0 }
                IfCondition EqualTo(BitwiseAnd(func_params, 268435456), 0) ThenBlock: {
                    args_obj = JSVM_CreateArguments(arg_buf, argc, func_val, map_n)
                    JSVM__SaveArguments()
                    JSVM__SetGlobal("arguments", args_obj)
                    IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                        fi_a = Subtract(JSVMState.fp, 1)
                        env_a = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi_a, 8)))
                        IfCondition NotEqual(env_a, 0) ThenBlock: {
                            JSRT_ObjSet(env_a, "arguments", args_obj)
                        }
                    }
                } ElseBlock: {
                    JSVM__SaveArguments()
                }

                // Jump to function code (interpreter fallback)
                JSVMState.pc = func_bc
                ReturnValue(1)
            }

            // YIELD (73) — generator yield
            // Pop value from stack, save VM state to active generator, return {value, done:false}
            Case 73: {
                yield_val = JSVM__StackPop()

                // Get the active generator state block
                gs = JSVMGen.active_gs
                IfCondition EqualTo(gs, 0) ThenBlock: {
                    // Not in a generator — treat as return
                    JSVM__StackPush(yield_val)
                    JSVMState.halted = 1
                    ReturnValue(0)
                }

                // Save current VM state into generator state block
                StoreValue(Add(gs, 32), JSVMState.pc)
                StoreValue(Add(gs, 40), JSVMState.sp)
                StoreValue(Add(gs, 48), JSVMState.fp)

                // Copy stack to generator's private stack
                gen_stk = Dereference(Add(gs, 56))
                copy_sz = Multiply(JSVMState.sp, 8)
                IfCondition GreaterThan(copy_sz, 0) ThenBlock: {
                    MemoryCopy(gen_stk, JSVMState.stack, copy_sz)
                }

                // Copy frames to generator's private frames
                gen_frm = Dereference(Add(gs, 88))
                frm_copy_sz = Multiply(JSVMState.fp, JSVMConst.FRAME_SIZE)
                IfCondition GreaterThan(frm_copy_sz, 0) ThenBlock: {
                    MemoryCopy(gen_frm, JSVMState.frames, frm_copy_sz)
                }
                StoreValue(Add(gs, 96), JSVMState.fp)
                // Mole 17: save frame_envs / frame_funcs / frame_args
                side_sz = Multiply(JSVMState.fp, 8)
                IfCondition GreaterThan(side_sz, 0) ThenBlock: {
                    gen_envs = Dereference(Add(gs, 128))
                    gen_funcs = Dereference(Add(gs, 136))
                    gen_fargs = Dereference(Add(gs, 144))
                    IfCondition NotEqual(gen_envs, 0) ThenBlock: {
                        MemoryCopy(gen_envs, JSVMClosure.frame_envs, side_sz)
                    }
                    IfCondition NotEqual(gen_funcs, 0) ThenBlock: {
                        MemoryCopy(gen_funcs, JSVMClosure.frame_funcs, side_sz)
                    }
                    IfCondition NotEqual(gen_fargs, 0) ThenBlock: {
                        MemoryCopy(gen_fargs, JSVMClosure.frame_args, side_sz)
                    }
                }

                // Mark as suspended-yield
                StoreValue(gs, JSGenConst.ST_SUSPENDED_YIELD)

                // Restore caller state
                JSVMState.pc = JSVMGen.caller_pc
                JSVMState.sp = JSVMGen.caller_sp
                JSVMState.fp = JSVMGen.caller_fp
                // Restore caller stack
                caller_stk_sz = Multiply(JSVMGen.caller_sp, 8)
                IfCondition GreaterThan(caller_stk_sz, 0) ThenBlock: {
                    MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, caller_stk_sz)
                }
                // Restore caller frames
                caller_frm_sz = Multiply(JSVMGen.caller_fp, JSVMConst.FRAME_SIZE)
                IfCondition GreaterThan(caller_frm_sz, 0) ThenBlock: {
                    MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, caller_frm_sz)
                }

                // Clear active generator
                JSVMGen.active_gs = 0
                JSVMGen.is_gen_exec = 0

                // Create result: {value: yield_val, done: false}
                iter_result = JSRT_CreateIterResult(yield_val, 0)
                JSVM__StackPush(iter_result)
                ReturnValue(1)
            }

            // GEN_CLOSURE (74) — like CLOSURE but marks function as generator
            Case 74: {
                cidx = JSVM__Read16()
                cval = JSVM__LoadConst(cidx)
                JSVM__CaptureClosureEnv(cval)
                // Mark the function as a generator by setting env to magic value 71 (0x47 = 'G')
                JSRT_FuncSetEnv(cval, 71)
                // Mole 17: body_start at compiler func_pool +40 (after name_len)
                cpay = JSVM__GetConstPayload(cidx)
                IfCondition NotEqual(cpay, 0) ThenBlock: {
                    bstart = Dereference(Add(cpay, 40))
                    IfCondition GreaterThan(bstart, 0) ThenBlock: {
                        JSRT_FuncSetBodyStart(cval, bstart)
                    }
                    // es_length at compiler pool +48 → runtime desc +80
                    elen = Dereference(Add(cpay, 48))
                    fdesc = Dereference(Add(cval, 8))
                    IfCondition NotEqual(fdesc, 0) ThenBlock: {
                        StoreValue(Add(fdesc, 80), elen)
                    }
                }
                JSVM__StackPush(cval)
                ReturnValue(1)
            }

            // TO_ARRAY (75) — pop iterable, push array of its values
            // Array/string/object(@@iterator) via IterableToArray (Mole 15)
            Case 75: {
                src_val = JSVM__StackPop()
                expanded = JSVM_IterableToArray(src_val)
                IfCondition EqualTo(expanded, 0) ThenBlock: {
                    // throw already set
                    ReturnValue(1)
                }
                JSVM__StackPush(expanded)
                ReturnValue(1)
            }

            // ASYNC_CLOSURE (79) — like CLOSURE but marks function as async
            // Async functions run eagerly to completion (single-threaded cooperative)
            // The return value is wrapped in a resolved Promise
            Case 79: {
                cidx = JSVM__Read16()
                cval = JSVM__LoadConst(cidx)
                JSVM__CaptureClosureEnv(cval)
                // Mark the function as async by setting env to magic value 65 (0x41 = 'A')
                JSRT_FuncSetEnv(cval, 65)
                JSVM__StackPush(cval)
                ReturnValue(1)
            }

            // ASYNC_GEN_CLOSURE (82) — marks function as both async and generator
            // Calling creates an async generator object whose .next() returns Promises
            Case 82: {
                cidx = JSVM__Read16()
                cval = JSVM__LoadConst(cidx)
                JSVM__CaptureClosureEnv(cval)
                // Mark with magic value 66 (0x42 = 'B' = Both async+generator)
                JSRT_FuncSetEnv(cval, 66)
                cpay = JSVM__GetConstPayload(cidx)
                IfCondition NotEqual(cpay, 0) ThenBlock: {
                    bstart = Dereference(Add(cpay, 40))
                    IfCondition GreaterThan(bstart, 0) ThenBlock: {
                        JSRT_FuncSetBodyStart(cval, bstart)
                    }
                    elen = Dereference(Add(cpay, 48))
                    fdesc = Dereference(Add(cval, 8))
                    IfCondition NotEqual(fdesc, 0) ThenBlock: {
                        StoreValue(Add(fdesc, 80), elen)
                    }
                }
                JSVM__StackPush(cval)
                ReturnValue(1)
            }

            // AWAIT (80) — in eager mode, just unwrap Promises synchronously
            // If TOS is a Promise (object with __state__), extract __value__
            // Otherwise, pass through (non-thenable values resolve immediately)
            Case 80: {
                await_val = JSVM__StackPop()
                await_type = JSRT_GetType(await_val)
                // Check if it's a Promise object
                IfCondition EqualTo(await_type, JSType.OBJECT) ThenBlock: {
                    // Check for __state__ property (our Promise marker)
                    p_state = JSRT_ObjGet(await_val, "__state__")
                    ps_type = JSRT_GetType(p_state)
                    IfCondition EqualTo(ps_type, JSType.NUMBER) ThenBlock: {
                        // It's a Promise — check state
                        ps_val = Float_ToInt(JSRT_GetPayload(p_state))
                        IfCondition EqualTo(ps_val, 1) ThenBlock: {
                            // Fulfilled: extract value, recursively unwrap nested promises
                            resolved = JSRT_ObjGet(await_val, "__value__")
                            // Recursive unwrap: if resolved is itself a promise, keep unwrapping
                            unwrap_done = 0
                            WhileLoop EqualTo(unwrap_done, 0) {
                                r_type = JSRT_GetType(resolved)
                                IfCondition EqualTo(r_type, JSType.OBJECT) ThenBlock: {
                                    r_state = JSRT_ObjGet(resolved, "__state__")
                                    rs_type = JSRT_GetType(r_state)
                                    IfCondition EqualTo(rs_type, JSType.NUMBER) ThenBlock: {
                                        rs_val = Float_ToInt(JSRT_GetPayload(r_state))
                                        IfCondition EqualTo(rs_val, 1) ThenBlock: {
                                            resolved = JSRT_ObjGet(resolved, "__value__")
                                        } ElseBlock: {
                                            unwrap_done = 1
                                        }
                                    } ElseBlock: {
                                        unwrap_done = 1
                                    }
                                } ElseBlock: {
                                    unwrap_done = 1
                                }
                            }
                            JSVM__StackPush(resolved)
                        } ElseBlock: {
                            IfCondition EqualTo(ps_val, 2) ThenBlock: {
                                // Rejected: throw the rejection reason
                                rej_val = JSRT_ObjGet(await_val, "__value__")
                                JSVM_ThrowValue(rej_val)
                            } ElseBlock: {
                                // Pending: in eager mode, resolve to undefined
                                JSVM__StackPush(JSRT_Undefined())
                            }
                        }
                    } ElseBlock: {
                        // Not a Promise, pass through (thenable check could go here)
                        JSVM__StackPush(await_val)
                    }
                } ElseBlock: {
                    // Non-object: pass through (await 42 === 42)
                    JSVM__StackPush(await_val)
                }
                ReturnValue(1)
            }

            // NOP (99)
            Case 99: {
                ReturnValue(1)
            }

            // UNKNOWN OPCODE — error
            Default: {
                bad_pc = Subtract(JSVMState.pc, 1)
                PrintMessage("[JSVM] Unknown opcode: ")
                PrintNumber(op)
                PrintMessage(" at pc=")
                PrintNumber(bad_pc)
                PrintMessage("\n")
                // Dump 32 bytes of bytecode context around the error
                dump_start = bad_pc
                IfCondition GreaterThan(dump_start, 16) ThenBlock: {
                    dump_start = Subtract(dump_start, 16)
                }
                IfCondition LessEqual(dump_start, 16) ThenBlock: {
                    dump_start = 0
                }
                dump_end = Add(bad_pc, 16)
                IfCondition GreaterThan(dump_end, JSVMState.code_len) ThenBlock: {
                    dump_end = JSVMState.code_len
                }
                PrintMessage("[JSVM] bytecode [")
                PrintNumber(dump_start)
                PrintMessage("..")
                PrintNumber(dump_end)
                PrintMessage("]: ")
                _di = dump_start
                WhileLoop LessThan(_di, dump_end) {
                    _db = GetByte(JSVMState.code, _di)
                    IfCondition EqualTo(_di, bad_pc) ThenBlock: {
                        PrintMessage(">")
                    }
                    PrintNumber(_db)
                    PrintMessage(" ")
                    _di = Add(_di, 1)
                }
                PrintMessage("\n")
                PrintMessage("[JSVM] sp=")
                PrintNumber(JSVMState.sp)
                PrintMessage(" fp=")
                PrintNumber(JSVMState.fp)
                PrintMessage(" steps=")
                PrintNumber(JSVMState.steps)
                PrintMessage("\n")
                JSVMState.error = 1
                ReturnValue(-1)
            }
        }
    }
}
