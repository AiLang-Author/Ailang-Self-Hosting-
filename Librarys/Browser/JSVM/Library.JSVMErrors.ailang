// Library.JSVMErrors.ailang — Typed Error creation, throw unwind, strict flag
// Split from Library.JSVM.ailang (keep root + modules under ~1000 LOC each).
// FixedPools (JSVMState, JSVMConst) live in Library.JSVM.ailang.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// =============================================================================
// GLOBAL BINDING QUERY
// =============================================================================

// Active dynamic VariableEnvironment for direct-eval-in-function bindings.
// During direct eval: caller's frame env. Outside: current frame env if any.
Function.JSVM__DynVarEnv {
    Output: Address
    Body: {
        // Direct eval runs with fp==0 but must use caller's env
        IfCondition GreaterThan(JSVMEvalState.depth, 0) ThenBlock: {
            IfCondition EqualTo(JSVMEvalState.is_direct, 1) ThenBlock: {
                IfCondition And(NotEqual(JSVMEvalState.caller_env, 0), NotEqual(JSVMEvalState.caller_env, JSRTState.undef_val)) ThenBlock: {
                    ReturnValue(JSVMEvalState.caller_env)
                }
            }
        }
        IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
            fi = Subtract(JSVMState.fp, 1)
            env = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi, 8)))
            IfCondition And(NotEqual(env, 0), NotEqual(env, JSRTState.undef_val)) ThenBlock: {
                ReturnValue(env)
            }
        }
        ReturnValue(0)
    }
}

// M128e: Global Environment ObjectRecord — properties on globalThis/this
// (e.g. this.p1 = 1) are identifier bindings even without GlobalHash.
Function.JSVM__GlobalObjPtr {
    Output: Address
    Body: {
        gt = GlobalHash_Lookup("globalThis")
        IfCondition EqualTo(gt, -1) ThenBlock: {
            gt = GlobalHash_Lookup("this")
        }
        IfCondition EqualTo(gt, -1) ThenBlock: {
            ReturnValue(0)
        }
        gtt = JSRT_GetType(gt)
        IfCondition And(NotEqual(gtt, JSType.OBJECT), And(NotEqual(gtt, JSType.FUNCTION), NotEqual(gtt, JSType.ARRAY))) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(gt)
    }
}

// 1 if name is a binding: dyn var env, GlobalHash, or global object prop
Function.JSVM__HasGlobal {
    Input: name: Address
    Output: Integer
    Body: {
        save_name = name
        IfCondition GreaterThan(JSVMEvalState.depth, 0) ThenBlock: {
            IfCondition And(NotEqual(JSVMEvalState.eval_var_env, 0), NotEqual(JSVMEvalState.eval_var_env, JSRTState.undef_val)) ThenBlock: {
                IfCondition EqualTo(JSRT_ObjHas(JSVMEvalState.eval_var_env, save_name), 1) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        env = JSVM__DynVarEnv()
        IfCondition NotEqual(env, 0) ThenBlock: {
            IfCondition EqualTo(JSRT_ObjHas(env, save_name), 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        // M128m: script_env only if lexical (__lex_ mark).
        // Plain top-level var is already in GlobalHash.
        skip_lex_h = JSVM__PlainGlobals()
        IfCondition EqualTo(skip_lex_h, 0) ThenBlock: {
        lex = 0
        IfCondition GreaterThan(JSVMEvalState.depth, 0) ThenBlock: {
            IfCondition And(NotEqual(JSVMEvalState.save_script_env, 0), NotEqual(JSVMEvalState.save_script_env, JSRTState.undef_val)) ThenBlock: {
                lex = JSVMEvalState.save_script_env
            }
        }
        IfCondition EqualTo(lex, 0) ThenBlock: {
            IfCondition And(NotEqual(JSVMClosure.script_env, 0), NotEqual(JSVMClosure.script_env, JSRTState.undef_val)) ThenBlock: {
                lex = JSVMClosure.script_env
            }
        }
        IfCondition And(NotEqual(lex, 0), NotEqual(lex, JSRTState.undef_val)) ThenBlock: {
            // M128v: indirect eval → global declarative root only (not block lets)
            IfCondition And(GreaterThan(JSVMEvalState.depth, 0), EqualTo(JSVMEvalState.is_direct, 0)) ThenBlock: {
                lex = JSVM_Eval__GlobalLexEnv(lex)
            }
            hops = 0
            penv = lex
            max_hops = 64
            IfCondition And(GreaterThan(JSVMEvalState.depth, 0), EqualTo(JSVMEvalState.is_direct, 0)) ThenBlock: {
                max_hops = 1
            }
            WhileLoop And(NotEqual(penv, 0), LessThan(hops, max_hops)) {
                IfCondition EqualTo(penv, JSRTState.undef_val) ThenBlock: {
                    penv = 0
                }
                IfCondition And(NotEqual(penv, 0), EqualTo(JSRT_GetType(penv), JSType.OBJECT)) ThenBlock: {
                    IfCondition EqualTo(JSVM_Eval__EnvHasLex(penv, save_name), 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    penv = JSRT_ObjGet(penv, JSVMClosure.parent_key)
                } ElseBlock: {
                    penv = 0
                }
                hops = Add(hops, 1)
            }
        }
        }
        existing = GlobalHash_Lookup(save_name)
        IfCondition NotEqual(existing, -1) ThenBlock: {
            ReturnValue(1)
        }
        // M128e: Global ObjectRecord — this.p1=1 binds bare p1 ([[HasProperty]])
        gt = JSVM__GlobalObjPtr()
        IfCondition NotEqual(gt, 0) ThenBlock: {
            IfCondition EqualTo(JSRT_ObjHasOnChain(gt, save_name), 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// TYPED ERROR OBJECTS
// =============================================================================

// Create Error / TypeError / ReferenceError / … with prototype chain so
// `err instanceof TypeError` works via Constructor.prototype + __class__.
// name_str: null-terminated class name ("TypeError", "ReferenceError", …)
// msg_str:  null-terminated message (0 → empty string)
Function.JSVM_CreateTypedError {
    Input: name_str: Address
    Input: msg_str: Address
    Output: Address
    Body: {
        save_name = name_str
        save_msg = msg_str
        err_obj = JSRT_CreateObject()
        IfCondition EqualTo(err_obj, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        JSRT__Push(err_obj)
        name_val = JSRT_CreateString(save_name)
        err_obj = JSRT__Pop()
        JSRT_ObjSet(err_obj, "name", name_val)
        // [[ErrorData]]: brand is "Error" for every native error, not the subclass name.
        JSRT__Push(err_obj)
        cls_err = JSRT_CreateString("Error")
        err_obj = JSRT__Pop()
        JSRT_ObjSet(err_obj, "__class__", cls_err)
        JSRT__Push(err_obj)
        ie_one = JSRT_CreateNumber(1)
        err_obj = JSRT__Pop()
        JSRT_ObjSet(err_obj, "__is_error__", ie_one)
        JSRT__Push(err_obj)
        IfCondition EqualTo(save_msg, 0) ThenBlock: {
            msg_val = JSRT_CreateString("")
        } ElseBlock: {
            msg_val = JSRT_CreateString(save_msg)
        }
        err_obj = JSRT__Pop()
        JSRT_ObjSet(err_obj, "message", msg_val)

        // Link __proto__ to Constructor.prototype when available
        JSRT__Push(err_obj)
        ctor = JSVM__GetGlobal(save_name)
        err_obj = JSRT__Pop()
        ct = JSRT_GetType(ctor)
        IfCondition EqualTo(ct, JSType.FUNCTION) ThenBlock: {
            // Own .constructor so error.constructor === TypeError (not only via proto)
            JSRT_ObjSet(err_obj, "constructor", ctor)
            JSRT__Push(err_obj)
            proto = JSRT_ObjGet(ctor, "prototype")
            err_obj = JSRT__Pop()
            pt = JSRT_GetType(proto)
            IfCondition EqualTo(pt, JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(err_obj, "__proto__", proto)
            }
        }
        ReturnValue(err_obj)
    }
}

// Convenience: TypeError with fixed message
Function.JSVM_TypeError {
    Input: msg_str: Address
    Output: Address
    Body: {
        ReturnValue(JSVM_CreateTypedError("TypeError", msg_str))
    }
}

// Convenience: ReferenceError with fixed message
Function.JSVM_ReferenceError {
    Input: msg_str: Address
    Output: Address
    Body: {
        ReturnValue(JSVM_CreateTypedError("ReferenceError", msg_str))
    }
}

// =============================================================================
// THROW / UNWIND
// =============================================================================

// Exception entry layout (32 bytes, allocated in JSVM_Init):
//   +0  catch_addr
//   +8  saved_sp
//   +16 saved_fp   — required so catch runs in the correct call frame
//   +24 pad
//
// THROW restores fp then sp then jumps. Without saved_fp, cross-function
// throw (assert.throws, nested call) corrupts catch bindings.

Function.JSVM_ThrowValue {
    Input: err: Address
    Output: Integer
    Body: {
        // Stash before any call. PopFrame, LeaveFuncCode, and SetGlobal run
        // before the catch push, and a local copy of err is dead by then.
        JSVMCall.thrown_val = err
        JSVMState.exc_val = err
        // M128e7bc: Nested CallFunc FIRST — surface as exc_prop for the CallFunc
        // caller (Function.prototype.call/apply, getters). Delivering to an outer
        // try/catch here would pop the catch frame; then CALL rethrows uncaught → VM error.
        // Outer CALL/NFuncCall re-ThrowValue after CallFunc returns so try/catch works.
        IfCondition GreaterThan(JSVMCall.depth, 0) ThenBlock: {
            JSVMCall.exc_prop = 1
            JSVMState.error = 1
            JSVMState.halted = 1
            ReturnValue(0)
        }
        IfCondition GreaterThan(JSVMState.exc_sp, 0) ThenBlock: {
            JSVMState.exc_sp = Subtract(JSVMState.exc_sp, 1)
            ebase = Add(JSVMState.exc_stack, Multiply(JSVMState.exc_sp, 32))
            catch_addr = Dereference(ebase)
            saved_sp = Dereference(Add(ebase, 8))
            saved_fp = Dereference(Add(ebase, 16))
            saved_env = Dereference(Add(ebase, 24))
            IfCondition LessThan(saved_sp, 0) ThenBlock: { saved_sp = 0 }
            IfCondition GreaterThan(saved_sp, JSVMConst.MAX_STACK) ThenBlock: {
                saved_sp = JSVMConst.MAX_STACK
            }
            IfCondition LessThan(saved_fp, 0) ThenBlock: { saved_fp = 0 }
            IfCondition GreaterThan(saved_fp, JSVMConst.MAX_FRAMES) ThenBlock: {
                saved_fp = JSVMConst.MAX_FRAMES
            }
            // M128q: pop intermediate frames (e.g. throw from default-param eval
            // inside f() while catch is in outer script). Must RestoreArguments
            // / LeaveFuncCode — bare fp=saved_fp left globalThis.arguments set
            // so `"arguments" in this` stayed true after catch.
            WhileLoop GreaterThan(JSVMState.fp, saved_fp) {
                restore_fi_c = Subtract(JSVMState.fp, 1)
                frame_c = JSVM__PopFrame()
                IfCondition NotEqual(frame_c, 0) ThenBlock: {
                    JSVMState.is_strict = Dereference(Add(frame_c, 72))
                    JSVM__LeaveFuncCode()
                    JSVM__RestoreArguments(restore_fi_c)
                    IfCondition NotEqual(JSVMClosure.frame_has_saved_this, 0) ThenBlock: {
                        IfCondition EqualTo(Dereference(Add(JSVMClosure.frame_has_saved_this, Multiply(restore_fi_c, 8))), 1) ThenBlock: {
                            prev_th_c = Dereference(Add(JSVMClosure.frame_saved_this, Multiply(restore_fi_c, 8)))
                            JSVM__SetGlobal("this", prev_th_c)
                            StoreValue(Add(JSVMClosure.frame_has_saved_this, Multiply(restore_fi_c, 8)), 0)
                            StoreValue(Add(JSVMClosure.frame_saved_this, Multiply(restore_fi_c, 8)), 0)
                        }
                    }
                }
            }
            JSVMState.fp = saved_fp
            JSVMState.sp = saved_sp
            // M128e: restore env so with ObjectEnv is unwound (WITH_POP skipped)
            IfCondition And(NotEqual(saved_env, 0), NotEqual(saved_env, JSRTState.undef_val)) ThenBlock: {
                JSVM__SetCurEnv(saved_env)
            }
            JSVM__StackPush(JSVMCall.thrown_val)
            JSVMState.pc = catch_addr
            // M128e6ai: callers mid-opcode (GET_FREE after EnvLookup has-trap throw)
            // must not replace the delivered catch value with ReferenceError.
            JSVMState.throw_delivered = 1
            // M128e7bc: do NOT leave sticky exc_prop after catch delivery —
            // that poisons subsequent ops (1+1, instanceof). CALL mid-native
            // uses throw_delivered only to skip success push.
            JSVMCall.exc_prop = 0
            JSVMCall.thrown_val = 0
            JSVMState.exc_val = 0
            // M128e7ai: clear sticky pend
            JSVM__SetGlobal("__pend_exc__", JSRTState.undef_val)
            ReturnValue(1)
        }
        // M106: uncaught throw inside async function → rejected Promise
        // (AWAIT of rejected Promise uses ThrowValue, not THROW opcode —
        // without this, try/finally await-reject crashed the VM.)
        async_rej_done = 0
        WhileLoop And(EqualTo(async_rej_done, 0), GreaterThan(JSVMState.fp, 0)) {
            fi_ar = Subtract(JSVMState.fp, 1)
            fa_ar = Add(JSVMState.frames, Multiply(fi_ar, JSVMConst.FRAME_SIZE))
            mark_ar = Dereference(Add(fa_ar, 40))
            IfCondition EqualTo(mark_ar, -65) ThenBlock: {
                JSBridgeTmp.result = JSVMCall.thrown_val
                rej_p = JSBridge__CreatePromise(2, JSBridgeTmp.result)
                JSVMCall.ret_hold = rej_p
                restore_fi_ar = fi_ar
                frame_ar = JSVM__PopFrame()
                IfCondition NotEqual(frame_ar, 0) ThenBlock: {
                    JSVMState.is_strict = Dereference(Add(frame_ar, 72))
                    JSVM__LeaveFuncCode()
                    JSVM__RestoreArguments(restore_fi_ar)
                    IfCondition NotEqual(JSVMClosure.frame_has_saved_this, 0) ThenBlock: {
                        IfCondition EqualTo(Dereference(Add(JSVMClosure.frame_has_saved_this, Multiply(restore_fi_ar, 8))), 1) ThenBlock: {
                            prev_th_ar = Dereference(Add(JSVMClosure.frame_saved_this, Multiply(restore_fi_ar, 8)))
                            JSVM__SetGlobal("this", prev_th_ar)
                            StoreValue(Add(JSVMClosure.frame_has_saved_this, Multiply(restore_fi_ar, 8)), 0)
                            StoreValue(Add(JSVMClosure.frame_saved_this, Multiply(restore_fi_ar, 8)), 0)
                        }
                    }
                    save_ret_pc_ar = Dereference(frame_ar)
                    save_ret_sp_ar = Dereference(Add(frame_ar, 8))
                    JSVMState.pc = save_ret_pc_ar
                    JSVMState.sp = save_ret_sp_ar
                }
                JSVM__StackPush(JSVMCall.ret_hold)
                JSVMState.error = 0
                JSVMState.halted = 0
                JSVMState.exc_val = 0
                // MapThrow sets exc_prop before ThrowValue. CONSTRUCT sees
                // that flag and throws again after this frame is already
                // popped, so new Promise() inside async escapes.
                JSVMCall.exc_prop = 0
                JSVMCall.thrown_val = 0
                JSVMState.throw_delivered = 1
                JSVM__SetGlobal("__pend_exc__", JSRTState.undef_val)
                async_rej_done = 1
            } ElseBlock: {
                restore_fi_ar2 = fi_ar
                frame_ar2 = JSVM__PopFrame()
                IfCondition NotEqual(frame_ar2, 0) ThenBlock: {
                    JSVMState.is_strict = Dereference(Add(frame_ar2, 72))
                    JSVM__LeaveFuncCode()
                    JSVM__RestoreArguments(restore_fi_ar2)
                }
            }
        }
        IfCondition EqualTo(async_rej_done, 1) ThenBlock: {
            ReturnValue(1)
        }
        // Uncaught: exc_val already holds err. Do not copy a dead local over it.
        JSVMState.exc_val = JSVMCall.thrown_val
        JSVMState.error = 1
        JSVMState.halted = 1
        ReturnValue(0)
    }
}

// Create TypeError and throw it (one-shot helper for dispatch sites)
Function.JSVM_ThrowTypeError {
    Input: msg_str: Address
    Output: Integer
    Body: {
        terr = JSVM_CreateTypedError("TypeError", msg_str)
        ReturnValue(JSVM_ThrowValue(terr))
    }
}

Function.JSVM_ThrowReferenceError {
    Input: msg_str: Address
    Output: Integer
    Body: {
        rerr = JSVM_CreateTypedError("ReferenceError", msg_str)
        ReturnValue(JSVM_ThrowValue(rerr))
    }
}

// 1 if a nested Get/ToString/Call already threw (exc_prop or delivered catch).
Function.JSVM_ErrorSawAbrupt {
    Output: Integer
    Body: {
        IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 if a JS string value is the empty string.
Function.JSVM_StrIsEmpty {
    Input: sv: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(JSRT_GetType(sv), JSType.STRING) ThenBlock: { ReturnValue(0) }
        sp = JSRT_GetPayload(sv)
        IfCondition EqualTo(sp, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(JSRT_StrLen(sp), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Error / NativeError ( message [ , options ] ).
// No own name (that lives on the prototype). Own message only when the
// argument is present and not undefined. Own cause when options has "cause".
// Returns the instance, or undefined if an abrupt completion is pending.
Function.JSVM_InitNativeError {
    Input: ctor_name: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_name = ctor_name
        save_args = args
        save_argc = argc
        arg0 = JSRTState.undef_val
        arg1 = JSRTState.undef_val
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            arg0 = Dereference(save_args)
        }
        IfCondition GreaterThan(save_argc, 1) ThenBlock: {
            arg1 = Dereference(Add(save_args, 8))
        }
        err_obj = 0
        nt_e = JSVM__GetGlobal("__new_target__")
        nt_ctor_e = 0
        IfCondition EqualTo(JSRT_GetType(nt_e), JSType.FUNCTION) ThenBlock: {
            nt_ctor_e = 1
        }
        IfCondition EqualTo(JSVM__IsProxy(nt_e), 1) ThenBlock: {
            JSBridge__Push(nt_e)
            pc_e = JSRT_ObjGet(nt_e, "__proxy_callable__")
            nt_e = JSBridge__Pop()
            IfCondition EqualTo(JSRT_IsTruthy(pc_e), 1) ThenBlock: {
                nt_ctor_e = 1
            }
        }
        IfCondition EqualTo(nt_ctor_e, 1) ThenBlock: {
            th_e = JSVM__GetGlobal("this")
            IfCondition EqualTo(JSVMState.this_tdz, 0) ThenBlock: {
                tht_e = JSRT_GetType(th_e)
                IfCondition Or(EqualTo(tht_e, JSType.OBJECT), EqualTo(tht_e, JSType.ARRAY)) ThenBlock: {
                    IfCondition NotEqual(th_e, JSVMClosure.this_uninit) ThenBlock: {
                        err_obj = th_e
                    }
                }
            }
        }
        IfCondition EqualTo(err_obj, 0) ThenBlock: {
            err_obj = JSRT_CreateObject()
            np = 0
            IfCondition EqualTo(JSRT_GetType(nt_e), JSType.FUNCTION) ThenBlock: {
                JSRT__Push(err_obj)
                JSRT__Push(arg0)
                JSRT__Push(arg1)
                np = JSRT_ObjGet(nt_e, "prototype")
                arg1 = JSRT__Pop()
                arg0 = JSRT__Pop()
                err_obj = JSRT__Pop()
            }
            IfCondition NotEqual(JSRT_GetType(np), JSType.OBJECT) ThenBlock: {
                JSRT__Push(err_obj)
                JSRT__Push(arg0)
                JSRT__Push(arg1)
                eg = JSVM__GetGlobal(save_name)
                arg1 = JSRT__Pop()
                arg0 = JSRT__Pop()
                err_obj = JSRT__Pop()
                IfCondition EqualTo(JSRT_GetType(eg), JSType.FUNCTION) ThenBlock: {
                    JSRT__Push(err_obj)
                    JSRT__Push(arg0)
                    JSRT__Push(arg1)
                    np = JSRT_ObjGet(eg, "prototype")
                    arg1 = JSRT__Pop()
                    arg0 = JSRT__Pop()
                    err_obj = JSRT__Pop()
                }
            }
            IfCondition EqualTo(JSRT_GetType(np), JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(err_obj, "__proto__", np)
            }
        }
        JSRT__Push(err_obj)
        JSRT__Push(arg0)
        JSRT__Push(arg1)
        cls = JSRT_CreateString("Error")
        ie_n = JSRT_CreateNumber(1)
        arg1 = JSRT__Pop()
        arg0 = JSRT__Pop()
        err_obj = JSRT__Pop()
        JSRT_ObjSet(err_obj, "__class__", cls)
        JSRT_ObjSet(err_obj, "__is_error__", ie_n)

        msg_present = 0
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            IfCondition NotEqual(JSRT_GetType(arg0), JSType.UNDEFINED) ThenBlock: {
                msg_present = 1
            }
        }
        IfCondition EqualTo(msg_present, 1) ThenBlock: {
            JSRT__Push(err_obj)
            JSRT__Push(arg1)
            msg_val = JSRT_ToString(arg0)
            arg1 = JSRT__Pop()
            err_obj = JSRT__Pop()
            IfCondition EqualTo(JSVM_ErrorSawAbrupt(), 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            IfCondition NotEqual(msg_val, 0) ThenBlock: {
                JSRT_ObjSet(err_obj, "message", msg_val)
                JSBridge__SetAttrBits(err_obj, "message", 5)
            }
        }

        opt_obj = 0
        IfCondition GreaterThan(save_argc, 1) ThenBlock: {
            ot = JSRT_GetType(arg1)
            IfCondition Or(EqualTo(ot, JSType.OBJECT), Or(EqualTo(ot, JSType.ARRAY), EqualTo(ot, JSType.FUNCTION))) ThenBlock: {
                opt_obj = 1
            }
        }
        IfCondition EqualTo(opt_obj, 1) ThenBlock: {
            JSRT__Push(err_obj)
            has_c = JSVM__HasProperty(arg1, "cause")
            err_obj = JSRT__Pop()
            IfCondition EqualTo(has_c, -1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            IfCondition EqualTo(has_c, 1) ThenBlock: {
                JSRT__Push(err_obj)
                cause_v = JSVM__GetProperty(arg1, "cause")
                err_obj = JSRT__Pop()
                IfCondition EqualTo(JSVM_ErrorSawAbrupt(), 1) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
                JSRT_ObjSet(err_obj, "cause", cause_v)
                JSBridge__SetAttrBits(err_obj, "cause", 5)
            }
        }
        ReturnValue(err_obj)
    }
}

// IterableToList. Returns a JS array, or 0 with exc_prop / throw_delivered set.
Function.JSVM_IterableToList {
    Input: items: Address
    Output: Address
    Body: {
        save_items = items
        it = JSRT_GetType(save_items)
        bad = 0
        IfCondition EqualTo(save_items, 0) ThenBlock: { bad = 1 }
        IfCondition EqualTo(it, JSType.UNDEFINED) ThenBlock: { bad = 1 }
        IfCondition EqualTo(it, JSType.NULL) ThenBlock: { bad = 1 }
        IfCondition EqualTo(bad, 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "object is not iterable")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        ik = 0
        IfCondition NotEqual(JSVMSymbol.iterator, 0) ThenBlock: {
            ik = JSVM_SymbolToKey(JSVMSymbol.iterator)
        }
        IfCondition EqualTo(ik, 0) ThenBlock: {
            terr2 = JSVM_CreateTypedError("TypeError", "object is not iterable")
            JSVM__SetGlobal("__pend_exc__", terr2)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr2
            ReturnValue(0)
        }
        JSRT__Push(save_items)
        factory = JSVM__ObjGetAcc(save_items, ik)
        save_items = JSRT__Pop()
        IfCondition EqualTo(JSVM_ErrorSawAbrupt(), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_GetType(factory), JSType.FUNCTION) ThenBlock: {
            terr3 = JSVM_CreateTypedError("TypeError", "object is not iterable")
            JSVM__SetGlobal("__pend_exc__", terr3)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr3
            ReturnValue(0)
        }
        save_this = JSVM__GetGlobal("this")
        JSVM__SetGlobal("this", save_items)
        iterator = JSVM__CallFunc(factory, JSVMCallBuf.buf, 0)
        JSVM__SetGlobal("this", save_this)
        IfCondition EqualTo(JSVM_ErrorSawAbrupt(), 1) ThenBlock: { ReturnValue(0) }
        it_t = JSRT_GetType(iterator)
        it_ok = 0
        IfCondition EqualTo(it_t, JSType.OBJECT) ThenBlock: { it_ok = 1 }
        IfCondition EqualTo(it_t, JSType.ARRAY) ThenBlock: { it_ok = 1 }
        IfCondition EqualTo(it_t, JSType.FUNCTION) ThenBlock: { it_ok = 1 }
        IfCondition EqualTo(it_ok, 0) ThenBlock: {
            terr4 = JSVM_CreateTypedError("TypeError", "iterator is not an object")
            JSVM__SetGlobal("__pend_exc__", terr4)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr4
            ReturnValue(0)
        }
        JSRT__Push(iterator)
        next_fn = JSVM__ObjGetAcc(iterator, "next")
        iterator = JSRT__Pop()
        IfCondition EqualTo(JSVM_ErrorSawAbrupt(), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_GetType(next_fn), JSType.FUNCTION) ThenBlock: {
            terr5 = JSVM_CreateTypedError("TypeError", "iterator next is not a function")
            JSVM__SetGlobal("__pend_exc__", terr5)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr5
            ReturnValue(0)
        }
        out = JSRT_CreateArray()
        nstep = 0
        done = 0
        WhileLoop And(EqualTo(done, 0), LessThan(nstep, 4096)) {
            JSVM__SetGlobal("this", iterator)
            step = JSVM__CallFunc(next_fn, JSVMCallBuf.buf, 0)
            JSVM__SetGlobal("this", save_this)
            IfCondition EqualTo(JSVM_ErrorSawAbrupt(), 1) ThenBlock: { ReturnValue(0) }
            st = JSRT_GetType(step)
            st_ok = 0
            IfCondition EqualTo(st, JSType.OBJECT) ThenBlock: { st_ok = 1 }
            IfCondition EqualTo(st, JSType.ARRAY) ThenBlock: { st_ok = 1 }
            IfCondition EqualTo(st_ok, 0) ThenBlock: {
                terr6 = JSVM_CreateTypedError("TypeError", "iterator result is not an object")
                JSVM__SetGlobal("__pend_exc__", terr6)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr6
                ReturnValue(0)
            }
            JSRT__Push(out)
            JSRT__Push(iterator)
            JSRT__Push(next_fn)
            dval = JSVM__ObjGetAcc(step, "done")
            next_fn = JSRT__Pop()
            iterator = JSRT__Pop()
            out = JSRT__Pop()
            IfCondition EqualTo(JSVM_ErrorSawAbrupt(), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(JSRT_IsTruthy(dval), 1) ThenBlock: {
                done = 1
            } ElseBlock: {
                JSRT__Push(out)
                JSRT__Push(iterator)
                JSRT__Push(next_fn)
                vval = JSVM__ObjGetAcc(step, "value")
                next_fn = JSRT__Pop()
                iterator = JSRT__Pop()
                out = JSRT__Pop()
                IfCondition EqualTo(JSVM_ErrorSawAbrupt(), 1) ThenBlock: { ReturnValue(0) }
                JSRT__Push(iterator)
                JSRT__Push(next_fn)
                JSRT_ArrPush(out, vval)
                next_fn = JSRT__Pop()
                iterator = JSRT__Pop()
            }
            nstep = Add(nstep, 1)
        }
        ReturnValue(out)
    }
}

// AggregateError ( errors, message [ , options ] ).
// Message and cause run before IterableToList (test262 order 1, 2, 3).
Function.JSVM_AggregateErrorNative {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        items = JSRTState.undef_val
        msg = JSRTState.undef_val
        opt = JSRTState.undef_val
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            items = Dereference(save_args)
        }
        IfCondition GreaterThan(save_argc, 1) ThenBlock: {
            msg = Dereference(Add(save_args, 8))
        }
        IfCondition GreaterThan(save_argc, 2) ThenBlock: {
            opt = Dereference(Add(save_args, 16))
        }
        init_argc = 0
        IfCondition GreaterThan(save_argc, 1) ThenBlock: {
            StoreValue(JSVMCallBuf.buf, msg)
            init_argc = 1
            IfCondition GreaterThan(save_argc, 2) ThenBlock: {
                StoreValue(Add(JSVMCallBuf.buf, 8), opt)
                init_argc = 2
            }
        }
        JSRT__Push(items)
        err_obj = JSVM_InitNativeError("AggregateError", JSVMCallBuf.buf, init_argc)
        items = JSRT__Pop()
        IfCondition EqualTo(JSVM_ErrorSawAbrupt(), 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        JSRT__Push(err_obj)
        lst = JSVM_IterableToList(items)
        err_obj = JSRT__Pop()
        IfCondition EqualTo(JSVM_ErrorSawAbrupt(), 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        IfCondition EqualTo(lst, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        JSRT_ObjSet(err_obj, "__agg_errors__", lst)
        ReturnValue(err_obj)
    }
}

// Error.prototype.toString. Built-in, so a bare call sees undefined this.
Function.JSVM_ErrorToStringNative {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        th = JSVM__GetGlobal("this")
        tt = JSRT_GetType(th)
        ok = 0
        IfCondition EqualTo(tt, JSType.OBJECT) ThenBlock: { ok = 1 }
        IfCondition EqualTo(tt, JSType.ARRAY) ThenBlock: { ok = 1 }
        IfCondition EqualTo(tt, JSType.FUNCTION) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Error.prototype.toString called on non-object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(JSRT_Undefined())
        }
        name_v = JSVM__GetProperty(th, "name")
        IfCondition EqualTo(JSVM_ErrorSawAbrupt(), 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        IfCondition Or(EqualTo(name_v, 0), EqualTo(JSRT_GetType(name_v), JSType.UNDEFINED)) ThenBlock: {
            name_v = JSRT_CreateString("Error")
        } ElseBlock: {
            name_v = JSRT_ToString(name_v)
            IfCondition EqualTo(JSVM_ErrorSawAbrupt(), 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
        }
        JSRT__Push(name_v)
        msg_v = JSVM__GetProperty(th, "message")
        name_v = JSRT__Pop()
        IfCondition EqualTo(JSVM_ErrorSawAbrupt(), 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        IfCondition Or(EqualTo(msg_v, 0), EqualTo(JSRT_GetType(msg_v), JSType.UNDEFINED)) ThenBlock: {
            msg_v = JSRT_CreateString("")
        } ElseBlock: {
            JSRT__Push(name_v)
            msg_v = JSRT_ToString(msg_v)
            name_v = JSRT__Pop()
            IfCondition EqualTo(JSVM_ErrorSawAbrupt(), 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
        }
        IfCondition EqualTo(JSVM_StrIsEmpty(name_v), 1) ThenBlock: {
            ReturnValue(msg_v)
        }
        IfCondition EqualTo(JSVM_StrIsEmpty(msg_v), 1) ThenBlock: {
            ReturnValue(name_v)
        }
        np = JSRT_GetPayload(name_v)
        JSRT__Push(msg_v)
        mid = JSRT__StrConcat(np, ": ")
        msg_v = JSRT__Pop()
        midp = JSRT_GetPayload(mid)
        mp = JSRT_GetPayload(msg_v)
        ReturnValue(JSRT__StrConcat(midp, mp))
    }
}

// Error.isError: true only for objects branded by the native constructors.
Function.JSVM_ErrorIsErrorNative {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        v = Dereference(args)
        t = JSRT_GetType(v)
        is_obj = 0
        IfCondition EqualTo(t, JSType.OBJECT) ThenBlock: { is_obj = 1 }
        IfCondition EqualTo(t, JSType.ARRAY) ThenBlock: { is_obj = 1 }
        IfCondition EqualTo(t, JSType.FUNCTION) ThenBlock: { is_obj = 1 }
        IfCondition EqualTo(is_obj, 0) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        IfCondition EqualTo(JSRT_ObjHas(v, "__is_error__"), 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(1))
        }
        ReturnValue(JSRT_CreateBool(0))
    }
}

// Re-mirror one built-in global as writable, not enumerable, configurable.
Function.JSVM_MirrorBuiltin {
    Input: glob: Address
    Input: name: Address
    Output: Integer
    Body: {
        save_g = glob
        save_n = name
        IfCondition EqualTo(save_g, 0) ThenBlock: { ReturnValue(0) }
        v = JSVM__GetGlobal(save_n)
        IfCondition Or(EqualTo(v, 0), EqualTo(v, JSRTState.undef_val)) ThenBlock: {
            ReturnValue(0)
        }
        JSRT_ObjSet(save_g, save_n, v)
        JSBridge__SetAttrBits(save_g, save_n, 5)
        ReturnValue(1)
    }
}

// Link a native error prototype: parent proto, name, optional message,
// !W!E!C .prototype, and (for subclasses) [[Prototype]] = Error.
Function.JSVM_StampNativeErrorProto {
    Input: ctor_name: Address
    Input: parent_proto: Address
    Input: set_message: Integer
    Input: link_to_error: Integer
    Output: Address
    Body: {
        save_name = ctor_name
        save_parent = parent_proto
        save_msg = set_message
        save_link = link_to_error
        ctor = JSVM__GetGlobal(save_name)
        IfCondition NotEqual(JSRT_GetType(ctor), JSType.FUNCTION) ThenBlock: {
            ReturnValue(0)
        }
        ep = JSRT_ObjGet(ctor, "prototype")
        IfCondition NotEqual(JSRT_GetType(ep), JSType.OBJECT) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(JSRT_GetType(save_parent), JSType.OBJECT) ThenBlock: {
            JSRT_ObjSet(ep, "__proto__", save_parent)
        }
        JSRT__Push(ep)
        JSRT__Push(ctor)
        nm = JSRT_CreateString(save_name)
        ctor = JSRT__Pop()
        ep = JSRT__Pop()
        JSRT_ObjSet(ep, "name", nm)
        JSBridge__SetAttrBits(ep, "name", 5)
        IfCondition EqualTo(save_msg, 1) ThenBlock: {
            JSRT__Push(ep)
            JSRT__Push(ctor)
            empty_m = JSRT_CreateString("")
            ctor = JSRT__Pop()
            ep = JSRT__Pop()
            JSRT_ObjSet(ep, "message", empty_m)
            JSBridge__SetAttrBits(ep, "message", 5)
        }
        JSBridge__SetAttrBits(ctor, "prototype", 0)
        IfCondition EqualTo(save_link, 1) ThenBlock: {
            JSRT__Push(ep)
            err_ctor = JSVM__GetGlobal("Error")
            ep = JSRT__Pop()
            IfCondition EqualTo(JSRT_GetType(err_ctor), JSType.FUNCTION) ThenBlock: {
                JSRT_FuncPropSet(ctor, "__proto__", err_ctor)
            }
        }
        ReturnValue(ep)
    }
}

// =============================================================================
// STRICT MODE FLAG
// =============================================================================

Function.JSVM_SetStrict {
    Input: flag: Integer
    Output: Integer
    Body: {
        JSVMState.is_strict = flag
        ReturnValue(flag)
    }
}

Function.JSVM_IsStrict {
    Output: Integer
    Body: {
        ReturnValue(JSVMState.is_strict)
    }
}
