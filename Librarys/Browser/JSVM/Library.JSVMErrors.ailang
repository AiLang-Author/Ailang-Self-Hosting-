// Library.JSVMErrors.ailang — Typed Error creation, throw unwind, strict flag
// Split from Library.JSVM.ailang (keep root + modules under ~1000 LOC each).
// FixedPools (JSVMState, JSVMConst) live in Library.JSVM.ailang.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// =============================================================================
// GLOBAL BINDING QUERY
// =============================================================================

// 1 if name is already a binding in the global object, 0 otherwise
Function.JSVM__HasGlobal {
    Input: name: Address
    Output: Integer
    Body: {
        save_name = name
        existing = GlobalHash_Lookup(save_name)
        IfCondition EqualTo(existing, -1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// TYPED ERROR OBJECTS
// =============================================================================

// Create Error / TypeError / ReferenceError / … with prototype chain so
// `err instanceof TypeError` works via Constructor.prototype + __class__.
// name_str: null-terminated class name ("TypeError", "ReferenceError", …)
// msg_str:  null-terminated message (0 → empty string)
Function.JSVM_CreateTypedError {
    Input: name_str: Address
    Input: msg_str: Address
    Output: Address
    Body: {
        save_name = name_str
        save_msg = msg_str
        err_obj = JSRT_CreateObject()
        IfCondition EqualTo(err_obj, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        JSRT__Push(err_obj)
        name_val = JSRT_CreateString(save_name)
        err_obj = JSRT__Pop()
        JSRT_ObjSet(err_obj, "name", name_val)
        JSRT_ObjSet(err_obj, "__class__", name_val)
        JSRT__Push(err_obj)
        IfCondition EqualTo(save_msg, 0) ThenBlock: {
            msg_val = JSRT_CreateString("")
        } ElseBlock: {
            msg_val = JSRT_CreateString(save_msg)
        }
        err_obj = JSRT__Pop()
        JSRT_ObjSet(err_obj, "message", msg_val)

        // Link __proto__ to Constructor.prototype when available
        JSRT__Push(err_obj)
        ctor = JSVM__GetGlobal(save_name)
        err_obj = JSRT__Pop()
        ct = JSRT_GetType(ctor)
        IfCondition EqualTo(ct, JSType.FUNCTION) ThenBlock: {
            JSRT__Push(err_obj)
            proto = JSRT_ObjGet(ctor, "prototype")
            err_obj = JSRT__Pop()
            pt = JSRT_GetType(proto)
            IfCondition EqualTo(pt, JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(err_obj, "__proto__", proto)
            }
        }
        ReturnValue(err_obj)
    }
}

// Convenience: TypeError with fixed message
Function.JSVM_TypeError {
    Input: msg_str: Address
    Output: Address
    Body: {
        ReturnValue(JSVM_CreateTypedError("TypeError", msg_str))
    }
}

// Convenience: ReferenceError with fixed message
Function.JSVM_ReferenceError {
    Input: msg_str: Address
    Output: Address
    Body: {
        ReturnValue(JSVM_CreateTypedError("ReferenceError", msg_str))
    }
}

// =============================================================================
// THROW / UNWIND
// =============================================================================

// Exception entry layout (32 bytes, allocated in JSVM_Init):
//   +0  catch_addr
//   +8  saved_sp
//   +16 saved_fp   — required so catch runs in the correct call frame
//   +24 pad
//
// THROW restores fp then sp then jumps. Without saved_fp, cross-function
// throw (assert.throws, nested call) corrupts catch bindings.

Function.JSVM_ThrowValue {
    Input: err: Address
    Output: Integer
    Body: {
        thrown = err
        IfCondition GreaterThan(JSVMState.exc_sp, 0) ThenBlock: {
            JSVMState.exc_sp = Subtract(JSVMState.exc_sp, 1)
            ebase = Add(JSVMState.exc_stack, Multiply(JSVMState.exc_sp, 32))
            catch_addr = Dereference(ebase)
            saved_sp = Dereference(Add(ebase, 8))
            saved_fp = Dereference(Add(ebase, 16))
            IfCondition LessThan(saved_sp, 0) ThenBlock: { saved_sp = 0 }
            IfCondition GreaterThan(saved_sp, JSVMConst.MAX_STACK) ThenBlock: {
                saved_sp = JSVMConst.MAX_STACK
            }
            IfCondition LessThan(saved_fp, 0) ThenBlock: { saved_fp = 0 }
            IfCondition GreaterThan(saved_fp, JSVMConst.MAX_FRAMES) ThenBlock: {
                saved_fp = JSVMConst.MAX_FRAMES
            }
            JSVMState.fp = saved_fp
            JSVMState.sp = saved_sp
            JSVM__StackPush(thrown)
            JSVMState.pc = catch_addr
            ReturnValue(1)
        }
        // M106: uncaught throw inside async function → rejected Promise
        // (AWAIT of rejected Promise uses ThrowValue, not THROW opcode —
        // without this, try/finally await-reject crashed the VM.)
        async_rej_done = 0
        WhileLoop And(EqualTo(async_rej_done, 0), GreaterThan(JSVMState.fp, 0)) {
            fi_ar = Subtract(JSVMState.fp, 1)
            fa_ar = Add(JSVMState.frames, Multiply(fi_ar, JSVMConst.FRAME_SIZE))
            mark_ar = Dereference(Add(fa_ar, 40))
            IfCondition EqualTo(mark_ar, -65) ThenBlock: {
                rej_p = JSBridge__CreatePromise(2, thrown)
                restore_fi_ar = fi_ar
                frame_ar = JSVM__PopFrame()
                IfCondition NotEqual(frame_ar, 0) ThenBlock: {
                    JSVMState.is_strict = Dereference(Add(frame_ar, 72))
                    JSVM__LeaveFuncCode()
                    JSVM__RestoreArguments(restore_fi_ar)
                    IfCondition NotEqual(JSVMClosure.frame_has_saved_this, 0) ThenBlock: {
                        IfCondition EqualTo(Dereference(Add(JSVMClosure.frame_has_saved_this, Multiply(restore_fi_ar, 8))), 1) ThenBlock: {
                            prev_th_ar = Dereference(Add(JSVMClosure.frame_saved_this, Multiply(restore_fi_ar, 8)))
                            JSVM__SetGlobal("this", prev_th_ar)
                            StoreValue(Add(JSVMClosure.frame_has_saved_this, Multiply(restore_fi_ar, 8)), 0)
                            StoreValue(Add(JSVMClosure.frame_saved_this, Multiply(restore_fi_ar, 8)), 0)
                        }
                    }
                    save_ret_pc_ar = Dereference(frame_ar)
                    save_ret_sp_ar = Dereference(Add(frame_ar, 8))
                    JSVMState.pc = save_ret_pc_ar
                    JSVMState.sp = save_ret_sp_ar
                }
                JSVM__StackPush(rej_p)
                JSVMState.error = 0
                JSVMState.halted = 0
                JSVMState.exc_val = 0
                async_rej_done = 1
            } ElseBlock: {
                restore_fi_ar2 = fi_ar
                frame_ar2 = JSVM__PopFrame()
                IfCondition NotEqual(frame_ar2, 0) ThenBlock: {
                    JSVMState.is_strict = Dereference(Add(frame_ar2, 72))
                    JSVM__LeaveFuncCode()
                    JSVM__RestoreArguments(restore_fi_ar2)
                }
            }
        }
        IfCondition EqualTo(async_rej_done, 1) ThenBlock: {
            ReturnValue(1)
        }
        // Uncaught: stash value so GenNext/CallFunc can rethrow after restore
        JSVMState.exc_val = thrown
        JSVMState.error = 1
        JSVMState.halted = 1
        ReturnValue(0)
    }
}

// Create TypeError and throw it (one-shot helper for dispatch sites)
Function.JSVM_ThrowTypeError {
    Input: msg_str: Address
    Output: Integer
    Body: {
        terr = JSVM_CreateTypedError("TypeError", msg_str)
        ReturnValue(JSVM_ThrowValue(terr))
    }
}

Function.JSVM_ThrowReferenceError {
    Input: msg_str: Address
    Output: Integer
    Body: {
        rerr = JSVM_CreateTypedError("ReferenceError", msg_str)
        ReturnValue(JSVM_ThrowValue(rerr))
    }
}

// =============================================================================
// STRICT MODE FLAG
// =============================================================================

Function.JSVM_SetStrict {
    Input: flag: Integer
    Output: Integer
    Body: {
        JSVMState.is_strict = flag
        ReturnValue(flag)
    }
}

Function.JSVM_IsStrict {
    Output: Integer
    Body: {
        ReturnValue(JSVMState.is_strict)
    }
}
