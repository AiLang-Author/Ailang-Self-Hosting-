// Library.JSVMErrors.ailang — Typed Error creation, throw unwind, strict flag
// Split from Library.JSVM.ailang (keep root + modules under ~1000 LOC each).
// FixedPools (JSVMState, JSVMConst) live in Library.JSVM.ailang.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// =============================================================================
// GLOBAL BINDING QUERY
// =============================================================================

// Active dynamic VariableEnvironment for direct-eval-in-function bindings.
// During direct eval: caller's frame env. Outside: current frame env if any.
Function.JSVM__DynVarEnv {
    Output: Address
    Body: {
        // Direct eval runs with fp==0 but must use caller's env
        IfCondition GreaterThan(JSVMEvalState.depth, 0) ThenBlock: {
            IfCondition EqualTo(JSVMEvalState.is_direct, 1) ThenBlock: {
                IfCondition And(NotEqual(JSVMEvalState.caller_env, 0), NotEqual(JSVMEvalState.caller_env, JSRTState.undef_val)) ThenBlock: {
                    ReturnValue(JSVMEvalState.caller_env)
                }
            }
        }
        IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
            fi = Subtract(JSVMState.fp, 1)
            env = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi, 8)))
            IfCondition And(NotEqual(env, 0), NotEqual(env, JSRTState.undef_val)) ThenBlock: {
                ReturnValue(env)
            }
        }
        ReturnValue(0)
    }
}

// M128e: Global Environment ObjectRecord — properties on globalThis/this
// (e.g. this.p1 = 1) are identifier bindings even without GlobalHash.
Function.JSVM__GlobalObjPtr {
    Output: Address
    Body: {
        gt = GlobalHash_Lookup("globalThis")
        IfCondition EqualTo(gt, -1) ThenBlock: {
            gt = GlobalHash_Lookup("this")
        }
        IfCondition EqualTo(gt, -1) ThenBlock: {
            ReturnValue(0)
        }
        gtt = JSRT_GetType(gt)
        IfCondition And(NotEqual(gtt, JSType.OBJECT), And(NotEqual(gtt, JSType.FUNCTION), NotEqual(gtt, JSType.ARRAY))) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(gt)
    }
}

// 1 if name is a binding: dyn var env, GlobalHash, or global object prop
Function.JSVM__HasGlobal {
    Input: name: Address
    Output: Integer
    Body: {
        save_name = name
        IfCondition GreaterThan(JSVMEvalState.depth, 0) ThenBlock: {
            IfCondition And(NotEqual(JSVMEvalState.eval_var_env, 0), NotEqual(JSVMEvalState.eval_var_env, JSRTState.undef_val)) ThenBlock: {
                IfCondition EqualTo(JSRT_ObjHas(JSVMEvalState.eval_var_env, save_name), 1) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        env = JSVM__DynVarEnv()
        IfCondition NotEqual(env, 0) ThenBlock: {
            IfCondition EqualTo(JSRT_ObjHas(env, save_name), 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        // M128m: script_env only if lexical (__lex_ mark)
        lex = 0
        IfCondition GreaterThan(JSVMEvalState.depth, 0) ThenBlock: {
            IfCondition And(NotEqual(JSVMEvalState.save_script_env, 0), NotEqual(JSVMEvalState.save_script_env, JSRTState.undef_val)) ThenBlock: {
                lex = JSVMEvalState.save_script_env
            }
        }
        IfCondition EqualTo(lex, 0) ThenBlock: {
            IfCondition And(NotEqual(JSVMClosure.script_env, 0), NotEqual(JSVMClosure.script_env, JSRTState.undef_val)) ThenBlock: {
                lex = JSVMClosure.script_env
            }
        }
        IfCondition And(NotEqual(lex, 0), NotEqual(lex, JSRTState.undef_val)) ThenBlock: {
            // M128v: indirect eval → global declarative root only (not block lets)
            IfCondition And(GreaterThan(JSVMEvalState.depth, 0), EqualTo(JSVMEvalState.is_direct, 0)) ThenBlock: {
                lex = JSVM_Eval__GlobalLexEnv(lex)
            }
            hops = 0
            penv = lex
            max_hops = 64
            IfCondition And(GreaterThan(JSVMEvalState.depth, 0), EqualTo(JSVMEvalState.is_direct, 0)) ThenBlock: {
                max_hops = 1
            }
            WhileLoop And(NotEqual(penv, 0), LessThan(hops, max_hops)) {
                IfCondition EqualTo(penv, JSRTState.undef_val) ThenBlock: {
                    penv = 0
                }
                IfCondition And(NotEqual(penv, 0), EqualTo(JSRT_GetType(penv), JSType.OBJECT)) ThenBlock: {
                    IfCondition EqualTo(JSVM_Eval__EnvHasLex(penv, save_name), 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    penv = JSRT_ObjGet(penv, JSVMClosure.parent_key)
                } ElseBlock: {
                    penv = 0
                }
                hops = Add(hops, 1)
            }
        }
        existing = GlobalHash_Lookup(save_name)
        IfCondition NotEqual(existing, -1) ThenBlock: {
            ReturnValue(1)
        }
        // M128e: Global ObjectRecord — this.p1=1 binds bare p1 ([[HasProperty]])
        gt = JSVM__GlobalObjPtr()
        IfCondition NotEqual(gt, 0) ThenBlock: {
            IfCondition EqualTo(JSRT_ObjHasOnChain(gt, save_name), 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// TYPED ERROR OBJECTS
// =============================================================================

// Create Error / TypeError / ReferenceError / … with prototype chain so
// `err instanceof TypeError` works via Constructor.prototype + __class__.
// name_str: null-terminated class name ("TypeError", "ReferenceError", …)
// msg_str:  null-terminated message (0 → empty string)
Function.JSVM_CreateTypedError {
    Input: name_str: Address
    Input: msg_str: Address
    Output: Address
    Body: {
        save_name = name_str
        save_msg = msg_str
        err_obj = JSRT_CreateObject()
        IfCondition EqualTo(err_obj, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        JSRT__Push(err_obj)
        name_val = JSRT_CreateString(save_name)
        err_obj = JSRT__Pop()
        JSRT_ObjSet(err_obj, "name", name_val)
        JSRT_ObjSet(err_obj, "__class__", name_val)
        JSRT__Push(err_obj)
        IfCondition EqualTo(save_msg, 0) ThenBlock: {
            msg_val = JSRT_CreateString("")
        } ElseBlock: {
            msg_val = JSRT_CreateString(save_msg)
        }
        err_obj = JSRT__Pop()
        JSRT_ObjSet(err_obj, "message", msg_val)

        // Link __proto__ to Constructor.prototype when available
        JSRT__Push(err_obj)
        ctor = JSVM__GetGlobal(save_name)
        err_obj = JSRT__Pop()
        ct = JSRT_GetType(ctor)
        IfCondition EqualTo(ct, JSType.FUNCTION) ThenBlock: {
            // Own .constructor so error.constructor === TypeError (not only via proto)
            JSRT_ObjSet(err_obj, "constructor", ctor)
            JSRT__Push(err_obj)
            proto = JSRT_ObjGet(ctor, "prototype")
            err_obj = JSRT__Pop()
            pt = JSRT_GetType(proto)
            IfCondition EqualTo(pt, JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(err_obj, "__proto__", proto)
            }
        }
        ReturnValue(err_obj)
    }
}

// Convenience: TypeError with fixed message
Function.JSVM_TypeError {
    Input: msg_str: Address
    Output: Address
    Body: {
        ReturnValue(JSVM_CreateTypedError("TypeError", msg_str))
    }
}

// Convenience: ReferenceError with fixed message
Function.JSVM_ReferenceError {
    Input: msg_str: Address
    Output: Address
    Body: {
        ReturnValue(JSVM_CreateTypedError("ReferenceError", msg_str))
    }
}

// =============================================================================
// THROW / UNWIND
// =============================================================================

// Exception entry layout (32 bytes, allocated in JSVM_Init):
//   +0  catch_addr
//   +8  saved_sp
//   +16 saved_fp   — required so catch runs in the correct call frame
//   +24 pad
//
// THROW restores fp then sp then jumps. Without saved_fp, cross-function
// throw (assert.throws, nested call) corrupts catch bindings.

Function.JSVM_ThrowValue {
    Input: err: Address
    Output: Integer
    Body: {
        thrown = err
        // M128e7bc: Nested CallFunc FIRST — surface as exc_prop for the CallFunc
        // caller (Function.prototype.call/apply, getters). Delivering to an outer
        // try/catch here would pop the catch frame; then CALL rethrows uncaught → VM error.
        // Outer CALL/NFuncCall re-ThrowValue after CallFunc returns so try/catch works.
        IfCondition GreaterThan(JSVMCall.depth, 0) ThenBlock: {
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = thrown
            JSVMState.exc_val = thrown
            JSVMState.error = 1
            JSVMState.halted = 1
            ReturnValue(0)
        }
        IfCondition GreaterThan(JSVMState.exc_sp, 0) ThenBlock: {
            JSVMState.exc_sp = Subtract(JSVMState.exc_sp, 1)
            ebase = Add(JSVMState.exc_stack, Multiply(JSVMState.exc_sp, 32))
            catch_addr = Dereference(ebase)
            saved_sp = Dereference(Add(ebase, 8))
            saved_fp = Dereference(Add(ebase, 16))
            saved_env = Dereference(Add(ebase, 24))
            IfCondition LessThan(saved_sp, 0) ThenBlock: { saved_sp = 0 }
            IfCondition GreaterThan(saved_sp, JSVMConst.MAX_STACK) ThenBlock: {
                saved_sp = JSVMConst.MAX_STACK
            }
            IfCondition LessThan(saved_fp, 0) ThenBlock: { saved_fp = 0 }
            IfCondition GreaterThan(saved_fp, JSVMConst.MAX_FRAMES) ThenBlock: {
                saved_fp = JSVMConst.MAX_FRAMES
            }
            // M128q: pop intermediate frames (e.g. throw from default-param eval
            // inside f() while catch is in outer script). Must RestoreArguments
            // / LeaveFuncCode — bare fp=saved_fp left globalThis.arguments set
            // so `"arguments" in this` stayed true after catch.
            WhileLoop GreaterThan(JSVMState.fp, saved_fp) {
                restore_fi_c = Subtract(JSVMState.fp, 1)
                frame_c = JSVM__PopFrame()
                IfCondition NotEqual(frame_c, 0) ThenBlock: {
                    JSVMState.is_strict = Dereference(Add(frame_c, 72))
                    JSVM__LeaveFuncCode()
                    JSVM__RestoreArguments(restore_fi_c)
                    IfCondition NotEqual(JSVMClosure.frame_has_saved_this, 0) ThenBlock: {
                        IfCondition EqualTo(Dereference(Add(JSVMClosure.frame_has_saved_this, Multiply(restore_fi_c, 8))), 1) ThenBlock: {
                            prev_th_c = Dereference(Add(JSVMClosure.frame_saved_this, Multiply(restore_fi_c, 8)))
                            JSVM__SetGlobal("this", prev_th_c)
                            StoreValue(Add(JSVMClosure.frame_has_saved_this, Multiply(restore_fi_c, 8)), 0)
                            StoreValue(Add(JSVMClosure.frame_saved_this, Multiply(restore_fi_c, 8)), 0)
                        }
                    }
                }
            }
            JSVMState.fp = saved_fp
            JSVMState.sp = saved_sp
            // M128e: restore env so with ObjectEnv is unwound (WITH_POP skipped)
            IfCondition And(NotEqual(saved_env, 0), NotEqual(saved_env, JSRTState.undef_val)) ThenBlock: {
                JSVM__SetCurEnv(saved_env)
            }
            JSVM__StackPush(thrown)
            JSVMState.pc = catch_addr
            // M128e6ai: callers mid-opcode (GET_FREE after EnvLookup has-trap throw)
            // must not replace the delivered catch value with ReferenceError.
            JSVMState.throw_delivered = 1
            // M128e7bc: do NOT leave sticky exc_prop after catch delivery —
            // that poisons subsequent ops (1+1, instanceof). CALL mid-native
            // uses throw_delivered only to skip success push.
            JSVMCall.exc_prop = 0
            JSVMCall.thrown_val = 0
            JSVMState.exc_val = 0
            // M128e7ai: clear sticky pend
            JSVM__SetGlobal("__pend_exc__", JSRTState.undef_val)
            ReturnValue(1)
        }
        // M106: uncaught throw inside async function → rejected Promise
        // (AWAIT of rejected Promise uses ThrowValue, not THROW opcode —
        // without this, try/finally await-reject crashed the VM.)
        async_rej_done = 0
        WhileLoop And(EqualTo(async_rej_done, 0), GreaterThan(JSVMState.fp, 0)) {
            fi_ar = Subtract(JSVMState.fp, 1)
            fa_ar = Add(JSVMState.frames, Multiply(fi_ar, JSVMConst.FRAME_SIZE))
            mark_ar = Dereference(Add(fa_ar, 40))
            IfCondition EqualTo(mark_ar, -65) ThenBlock: {
                rej_p = JSBridge__CreatePromise(2, thrown)
                restore_fi_ar = fi_ar
                frame_ar = JSVM__PopFrame()
                IfCondition NotEqual(frame_ar, 0) ThenBlock: {
                    JSVMState.is_strict = Dereference(Add(frame_ar, 72))
                    JSVM__LeaveFuncCode()
                    JSVM__RestoreArguments(restore_fi_ar)
                    IfCondition NotEqual(JSVMClosure.frame_has_saved_this, 0) ThenBlock: {
                        IfCondition EqualTo(Dereference(Add(JSVMClosure.frame_has_saved_this, Multiply(restore_fi_ar, 8))), 1) ThenBlock: {
                            prev_th_ar = Dereference(Add(JSVMClosure.frame_saved_this, Multiply(restore_fi_ar, 8)))
                            JSVM__SetGlobal("this", prev_th_ar)
                            StoreValue(Add(JSVMClosure.frame_has_saved_this, Multiply(restore_fi_ar, 8)), 0)
                            StoreValue(Add(JSVMClosure.frame_saved_this, Multiply(restore_fi_ar, 8)), 0)
                        }
                    }
                    save_ret_pc_ar = Dereference(frame_ar)
                    save_ret_sp_ar = Dereference(Add(frame_ar, 8))
                    JSVMState.pc = save_ret_pc_ar
                    JSVMState.sp = save_ret_sp_ar
                }
                JSVM__StackPush(rej_p)
                JSVMState.error = 0
                JSVMState.halted = 0
                JSVMState.exc_val = 0
                async_rej_done = 1
            } ElseBlock: {
                restore_fi_ar2 = fi_ar
                frame_ar2 = JSVM__PopFrame()
                IfCondition NotEqual(frame_ar2, 0) ThenBlock: {
                    JSVMState.is_strict = Dereference(Add(frame_ar2, 72))
                    JSVM__LeaveFuncCode()
                    JSVM__RestoreArguments(restore_fi_ar2)
                }
            }
        }
        IfCondition EqualTo(async_rej_done, 1) ThenBlock: {
            ReturnValue(1)
        }
        // Uncaught: stash value so GenNext/CallFunc can rethrow after restore
        JSVMState.exc_val = thrown
        JSVMState.error = 1
        JSVMState.halted = 1
        ReturnValue(0)
    }
}

// Create TypeError and throw it (one-shot helper for dispatch sites)
Function.JSVM_ThrowTypeError {
    Input: msg_str: Address
    Output: Integer
    Body: {
        terr = JSVM_CreateTypedError("TypeError", msg_str)
        ReturnValue(JSVM_ThrowValue(terr))
    }
}

Function.JSVM_ThrowReferenceError {
    Input: msg_str: Address
    Output: Integer
    Body: {
        rerr = JSVM_CreateTypedError("ReferenceError", msg_str)
        ReturnValue(JSVM_ThrowValue(rerr))
    }
}

// =============================================================================
// STRICT MODE FLAG
// =============================================================================

Function.JSVM_SetStrict {
    Input: flag: Integer
    Output: Integer
    Body: {
        JSVMState.is_strict = flag
        ReturnValue(flag)
    }
}

Function.JSVM_IsStrict {
    Output: Integer
    Body: {
        ReturnValue(JSVMState.is_strict)
    }
}
