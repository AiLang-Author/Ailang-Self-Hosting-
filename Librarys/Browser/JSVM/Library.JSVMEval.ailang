// Library.JSVMEval.ailang — re-entrant eval() for the JS VM
// FixedPools in Library.JSVM.ailang (JSVMEvalState).
//
// Direct eval (global eval(...)):
//   - shares globals with outer script (no GlobalHash reset)
//   - saves/restores outer bytecode so compile does not clobber caller
//   - eval_mode: last expression leaves value on stack as result
//
// Not yet: direct-eval local scope, indirect eval differences, new Function.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// Native handler id for global eval (see JSNativeID.EVAL)
// Must match Library.JSBridge JSNativeID.EVAL = 193


// M71: does blob of body let-names contain name?
Function.JSVM_Eval__LexHas {
    Input: blob: Address
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(blob, 0) ThenBlock: { ReturnValue(0) }
        save_p = name_ptr
        save_l = name_len
        cnt = Dereference(blob)
        IfCondition LessEqual(cnt, 0) ThenBlock: { ReturnValue(0) }
        bpos = 8
        i = 0
        WhileLoop LessThan(i, cnt) {
            bl = Dereference(Add(blob, bpos))
            bpos = Add(bpos, 8)
            bp = Add(blob, bpos)
            match = 0
            IfCondition EqualTo(bl, save_l) ThenBlock: {
                IfCondition EqualTo(bl, 0) ThenBlock: {
                    match = 1
                } ElseBlock: {
                    IfCondition EqualTo(MemCompare(bp, save_p, bl), 0) ThenBlock: {
                        match = 1
                    }
                }
            }
            IfCondition EqualTo(match, 1) ThenBlock: { ReturnValue(1) }
            bpos = Add(bpos, Add(bl, 1))
            bpos = Multiply(Divide(Add(bpos, 7), 8), 8)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// M71: recursive walk — limited depth via fixed array of pending nodes
Function.JSVM_Eval__CheckVarLexConflict {
    Input: root: Integer
    Input: lex_blob: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(lex_blob, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(root, 0) ThenBlock: { ReturnValue(0) }
        // 256-slot walk stack on heap
        wstk = Allocate(2048)
        MemorySet(wstk, 0, 2048)
        wsp = 0
        StoreValue(wstk, root)
        wsp = 1
        WhileLoop GreaterThan(wsp, 0) {
            wsp = Subtract(wsp, 1)
            nd = Dereference(Add(wstk, Multiply(wsp, 8)))
            IfCondition GreaterEqual(nd, 0) ThenBlock: {
                nt = JSParse_GetType(nd)
                IfCondition EqualTo(nt, ASTType.VAR_DECL) ThenBlock: {
                    vop = JSParse_GetOp(nd)
                    IfCondition EqualTo(vop, 70) ThenBlock: {
                        np = JSParse_GetNamePtr(nd)
                        nl = JSParse_GetNameLen(nd)
                        IfCondition GreaterThan(nl, 0) ThenBlock: {
                            IfCondition EqualTo(JSVM_Eval__LexHas(lex_blob, np, nl), 1) ThenBlock: {
                                // Detect only — throw after RestoreOuter so outer
                                // try/catch is live (ThrowValue needs exc_sp/fp).
                                Deallocate(wstk, 2048)
                                ReturnValue(1)
                            }
                        }
                    }
                }
                // enqueue children if room
                ch = JSParse_GetLeft(nd)
                IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                    StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                    wsp = Add(wsp, 1)
                }
                ch = JSParse_GetRight(nd)
                IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                    StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                    wsp = Add(wsp, 1)
                }
                ch = JSParse_GetBody(nd)
                IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                    StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                    wsp = Add(wsp, 1)
                }
                ch = JSParse_GetCond(nd)
                IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                    StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                    wsp = Add(wsp, 1)
                }
                ch = JSParse_GetNext(nd)
                IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                    StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                    wsp = Add(wsp, 1)
                }
            }
        }
        Deallocate(wstk, 2048)
        ReturnValue(0)
    }
}

// =============================================================================
// JSVM_EvalSource — run a source string as eval, return completion value
// Does NOT wipe globals. Saves outer VM bytecode + stack.
// =============================================================================
Function.JSVM_EvalSource {
    Input: source: Address
    Input: src_len: Integer
    Output: Address
    Body: {
        save_src = source
        save_len = src_len

        IfCondition EqualTo(save_src, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        IfCondition LessEqual(save_len, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Nesting limit (single-level backup buffers)
        IfCondition GreaterThan(JSVMEvalState.depth, 0) ThenBlock: {
            // Nested eval of nested eval — soft fail
            ReturnValue(JSRT_Undefined())
        }

        // Outer bytecode must fit backup
        IfCondition GreaterThan(JSVMState.code_len, JSVMEvalState.code_cap) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        csz_need = Multiply(JSVMState.const_count, 16)
        IfCondition GreaterThan(csz_need, JSVMEvalState.const_cap) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        JSVMEvalState.depth = 1

        // M71: capture caller function for non-strict direct-eval lex/var check
        // before we zero fp for the eval program.
        // Body lets at fdesc+96; formals at fdesc+104 (only during param init).
        // Param-init when caller pc < body_start (fdesc+72).
        eval_lex_blob = 0
        IfCondition And(GreaterThan(JSVMState.fp, 0), EqualTo(JSVMState.is_strict, 0)) ThenBlock: {
            IfCondition NotEqual(JSVMClosure.frame_funcs, 0) ThenBlock: {
                cal_ev = Dereference(Add(JSVMClosure.frame_funcs, Multiply(Subtract(JSVMState.fp, 1), 8)))
                IfCondition EqualTo(JSRT_GetType(cal_ev), JSType.FUNCTION) ThenBlock: {
                    fdesc_ev = JSRT_GetPayload(cal_ev)
                    IfCondition NotEqual(fdesc_ev, 0) ThenBlock: {
                        body_start_ev = Dereference(Add(fdesc_ev, 72))
                        // During default-param init, check formals; else body lets
                        IfCondition And(GreaterThan(body_start_ev, 0), LessThan(JSVMState.pc, body_start_ev)) ThenBlock: {
                            eval_lex_blob = Dereference(Add(fdesc_ev, 104))
                        } ElseBlock: {
                            eval_lex_blob = Dereference(Add(fdesc_ev, 96))
                        }
                    }
                }
            }
        }

        // ── Save outer VM execution state ──
        JSVMEvalState.save_code_len = JSVMState.code_len
        JSVMEvalState.save_const_n = JSVMState.const_count
        JSVMEvalState.save_pc = JSVMState.pc
        JSVMEvalState.save_sp = JSVMState.sp
        JSVMEvalState.save_fp = JSVMState.fp
        JSVMEvalState.save_halted = JSVMState.halted
        JSVMEvalState.save_error = JSVMState.error
        JSVMEvalState.save_steps = JSVMState.steps
        JSVMEvalState.save_exc_sp = JSVMState.exc_sp
        JSVMEvalState.save_strict = JSVMState.is_strict
        // Outer func_pool: CLOSURE const payloads point into JSCompState.func_pool.
        // JSComp_Reset zeros it — must restore or post-eval function exprs hang.
        JSVMEvalState.save_func_n = JSCompState.func_count

        // Copy outer bytecode + const pool (compiler will overwrite JSComp buffers)
        IfCondition And(NotEqual(JSVMState.code, 0), GreaterThan(JSVMState.code_len, 0)) ThenBlock: {
            MemoryCopy(JSVMEvalState.code_bak, JSVMState.code, JSVMState.code_len)
        }
        IfCondition And(NotEqual(JSVMState.const_pool, 0), GreaterThan(csz_need, 0)) ThenBlock: {
            MemoryCopy(JSVMEvalState.const_bak, JSVMState.const_pool, csz_need)
        }
        fsz_need = Multiply(JSCompState.func_count, 56)
        IfCondition GreaterThan(fsz_need, JSVMEvalState.func_cap) ThenBlock: {
            fsz_need = JSVMEvalState.func_cap
        }
        IfCondition And(NotEqual(JSCompState.func_pool, 0), GreaterThan(fsz_need, 0)) ThenBlock: {
            MemoryCopy(JSVMEvalState.func_bak, JSCompState.func_pool, fsz_need)
        }

        // Copy stack + frames
        stk_sz = Multiply(JSVMState.sp, 8)
        IfCondition GreaterThan(stk_sz, 0) ThenBlock: {
            MemoryCopy(JSVMEvalState.stk_bak, JSVMState.stack, stk_sz)
        }
        frm_sz = Multiply(JSVMState.fp, JSVMConst.FRAME_SIZE)
        IfCondition GreaterThan(frm_sz, 0) ThenBlock: {
            MemoryCopy(JSVMEvalState.frm_bak, JSVMState.frames, frm_sz)
        }

        // ── Compile + run eval source (globals preserved) ──
        // Clear only execution regs — do NOT GlobalHash_Reset / JSRT_Reset
        JSLex_Reset()
        JSComp_Reset()
        JSComp_SetEvalMode(1)
        JSVMState.sp = 0
        JSVMState.fp = 0
        JSVMState.pc = 0
        JSVMState.halted = 0
        JSVMState.error = 0
        JSVMState.steps = 0
        JSVMState.exc_sp = 0

        tok_count = JSLex_Tokenize(save_src, save_len)
        IfCondition LessEqual(tok_count, 0) ThenBlock: {
            JSVM_Eval__RestoreOuter()
            ReturnValue(JSRT_Undefined())
        }

        root = JSParse_Parse()
        parse_err = JSParse_HasError()
        IfCondition Or(LessThan(root, 0), EqualTo(parse_err, 1)) ThenBlock: {
            JSVM_Eval__RestoreOuter()
            ReturnValue(JSRT_Undefined())
        }

        // M71: non-strict direct eval — var must not clash with body lets.
        // Set exc_prop for native dispatch to ThrowValue after we return
        // (do not ThrowValue here: CALL handler still StackPushes return value).
        eval_lex_conflict = 0
        IfCondition NotEqual(eval_lex_blob, 0) ThenBlock: {
            IfCondition EqualTo(JSVM_Eval__CheckVarLexConflict(root, eval_lex_blob), 1) ThenBlock: {
                eval_lex_conflict = 1
            }
        }
        IfCondition EqualTo(eval_lex_conflict, 1) ThenBlock: {
            JSVM_Eval__RestoreOuter()
            JSVMEvalState.depth = 0
            terr = JSVM_CreateTypedError("SyntaxError", "Identifier has already been declared")
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }

        JSVM__Push(root)
        comp_ok = JSComp_Compile(root)
        root = JSVM__Pop()
        IfCondition EqualTo(comp_ok, 0) ThenBlock: {
            JSVM_Eval__RestoreOuter()
            ReturnValue(JSRT_Undefined())
        }

        // Eval program must fit backup for any further nesting (already depth=1)
        ev_len = JSComp_GetCodeLen()
        IfCondition GreaterThan(ev_len, JSVMEvalState.code_cap) ThenBlock: {
            JSVM_Eval__RestoreOuter()
            ReturnValue(JSRT_Undefined())
        }

        bc = JSComp_GetCode()
        bc_len = JSComp_GetCodeLen()
        cp = JSComp_GetConst(0)
        cc = JSComp_GetConstCount()
        JSVM_Load(bc, bc_len, cp, cc)
        JSVM_SetStrict(JSComp_IsStrict())

        // Run eval program — JSVM_Run returns top-of-stack (eval_mode last expr)
        eval_result = JSVM_Run()

        // Soft-fail on VM error (do not poison outer frame)
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
            eval_result = JSRT_Undefined()
        }

        // Save result across restore
        JSVM__Push(eval_result)
        JSVM_Eval__RestoreOuter()
        eval_result = JSVM__Pop()

        JSVMEvalState.depth = 0
        ReturnValue(eval_result)
    }
}

// Restore outer bytecode, const pool, stack, frames, regs after eval
Function.JSVM_Eval__RestoreOuter {
    Output: Integer
    Body: {
        // Put compiler buffers back so outer code lives again
        IfCondition GreaterThan(JSVMEvalState.save_code_len, 0) ThenBlock: {
            // JSCompState.code is the buffer Load used; rewrite it
            // Outer code was at JSVMState.code before eval (same as JSComp buffer)
            // After eval, JSCompState.code has eval bytes — restore backup
            // We need access to current code buffer pointer
            IfCondition NotEqual(JSVMState.code, 0) ThenBlock: {
                MemoryCopy(JSVMState.code, JSVMEvalState.code_bak, JSVMEvalState.save_code_len)
            }
        }
        IfCondition GreaterThan(JSVMEvalState.save_const_n, 0) ThenBlock: {
            csz = Multiply(JSVMEvalState.save_const_n, 16)
            IfCondition NotEqual(JSVMState.const_pool, 0) ThenBlock: {
                MemoryCopy(JSVMState.const_pool, JSVMEvalState.const_bak, csz)
            }
        }

        JSVMState.code_len = JSVMEvalState.save_code_len
        JSVMState.const_count = JSVMEvalState.save_const_n
        JSVMState.pc = JSVMEvalState.save_pc
        JSVMState.sp = JSVMEvalState.save_sp
        JSVMState.fp = JSVMEvalState.save_fp
        JSVMState.halted = JSVMEvalState.save_halted
        JSVMState.error = JSVMEvalState.save_error
        JSVMState.steps = JSVMEvalState.save_steps
        JSVMState.exc_sp = JSVMEvalState.save_exc_sp
        JSVMState.is_strict = JSVMEvalState.save_strict

        stk_sz = Multiply(JSVMEvalState.save_sp, 8)
        IfCondition GreaterThan(stk_sz, 0) ThenBlock: {
            MemoryCopy(JSVMState.stack, JSVMEvalState.stk_bak, stk_sz)
        }
        frm_sz = Multiply(JSVMEvalState.save_fp, JSVMConst.FRAME_SIZE)
        IfCondition GreaterThan(frm_sz, 0) ThenBlock: {
            MemoryCopy(JSVMState.frames, JSVMEvalState.frm_bak, frm_sz)
        }

        // Restore func_pool so outer CLOSURE descriptors are intact
        fsz_need = Multiply(JSVMEvalState.save_func_n, 56)
        IfCondition GreaterThan(fsz_need, JSVMEvalState.func_cap) ThenBlock: {
            fsz_need = JSVMEvalState.func_cap
        }
        IfCondition And(NotEqual(JSCompState.func_pool, 0), GreaterThan(fsz_need, 0)) ThenBlock: {
            MemoryCopy(JSCompState.func_pool, JSVMEvalState.func_bak, fsz_need)
        }
        JSCompState.func_count = JSVMEvalState.save_func_n

        // Rebuild const value cache for restored pool
        IfCondition GreaterThan(JSVMState.const_count, 0) ThenBlock: {
            IfCondition LessEqual(JSVMState.const_count, JSVMConst.MAX_CONSTS) ThenBlock: {
                JSVMState.const_vals = JSVMState.cv_buf
                MemorySet(JSVMState.const_vals, 0, Multiply(JSVMState.const_count, 8))
            }
        }

        JSComp_SetEvalMode(0)
        ReturnValue(0)
    }
}

// Native entry: eval(code) from arg_buf
Function.JSVM_EvalNative {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessEqual(save_argc, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        arg0 = Dereference(save_args)
        // Non-string: ToString then eval (spec: if not string return as-is for direct... 
        // actually ES: if not String type, return arg unchanged)
        a0t = JSRT_GetType(arg0)
        IfCondition NotEqual(a0t, JSType.STRING) ThenBlock: {
            ReturnValue(arg0)
        }
        sptr = JSRT_GetPayload(arg0)
        IfCondition EqualTo(sptr, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        // M31a: JS strings are UTF-16 headered; lexer wants C/byte source.
        // Flatten code units to a temporary Latin-1 buffer (BMP-only for now).
        slen = JSRT_StrLen(sptr)
        cbuf = JSRT__StrSlabAlloc(Add(slen, 1))
        IfCondition EqualTo(cbuf, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        ci = 0
        WhileLoop LessThan(ci, slen) {
            u = JSRT_StrUnit(sptr, ci)
            IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
            SetByte(cbuf, ci, u)
            ci = Add(ci, 1)
        }
        SetByte(cbuf, slen, 0)
        ReturnValue(JSVM_EvalSource(cbuf, slen))
    }
}
