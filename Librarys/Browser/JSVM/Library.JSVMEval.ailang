// Library.JSVMEval.ailang — re-entrant eval() for the JS VM
// FixedPools in Library.JSVM.ailang (JSVMEvalState).
//
// Direct eval (global eval(...)):
//   - shares globals with outer script (no GlobalHash reset)
//   - saves/restores outer bytecode so compile does not clobber caller
//   - eval_mode: last expression leaves value on stack as result
//
// M81: new Function(...args) via JSVM_FunctionNative.
// Not yet: direct-eval local scope, full indirect-eval differences.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// Native handler id for global eval (see JSNativeID.EVAL)
// Must match Library.JSBridge JSNativeID.EVAL = 193


// M128e: bind one identifier name as undefined (permanent NUL key).
// name_ptr/name_len from AST — not necessarily NUL-terminated.
// env != 0 → declarative/frame env (caller VariableEnvironment).
// env == 0 → GlobalHash (+ globalThis mirror) if not already bound.

// M128g: 1 if env has lexical-declaration mark for name (from let/const TDZ)
Function.JSVM_Eval__EnvHasLex {
    Input: env: Address
    Input: name: Address
    Output: Integer
    Body: {
        save_e = env
        save_n = name
        IfCondition Or(EqualTo(save_e, 0), EqualTo(save_e, JSRTState.undef_val)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(save_n, 0) ThenBlock: { ReturnValue(0) }
        lkb = JSVMCallBuf.getter_buf
        SetByte(lkb, 0, 95)
        SetByte(lkb, 1, 95)
        SetByte(lkb, 2, 108)
        SetByte(lkb, 3, 101)
        SetByte(lkb, 4, 120)
        SetByte(lkb, 5, 95)
        li = 0
        ldone = 0
        WhileLoop EqualTo(ldone, 0) {
            lb = GetByte(save_n, li)
            SetByte(lkb, Add(6, li), lb)
            IfCondition EqualTo(lb, 0) ThenBlock: {
                ldone = 1
            }
            li = Add(li, 1)
        }
        ReturnValue(JSRT_ObjHas(save_e, lkb))
    }
}

// M128g: non-strict eval — SyntaxError if var/func name collides with outer lexical

// M128g: CanDeclareGlobalFunction — 0 if cannot redefine (e.g. NaN)
// attr bits: 1=writable 2=enumerable 4=configurable
// M128j: also false when name missing and globalObject is non-extensible.
Function.JSVM_Eval__CanDeclareGlobalFunction {
    Input: name: Address
    Output: Integer
    Body: {
        save_n = name
        IfCondition EqualTo(save_n, 0) ThenBlock: { ReturnValue(1) }
        gt = GlobalHash_Lookup("globalThis")
        IfCondition EqualTo(gt, -1) ThenBlock: {
            gt = GlobalHash_Lookup("this")
        }
        IfCondition EqualTo(gt, -1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(JSRT_ObjHas(gt, save_n), 0) ThenBlock: {
            IfCondition NotEqual(GlobalHash_Lookup(save_n), -1) ThenBlock: {
                ReturnValue(1)
            }
            // New name on non-extensible global → cannot declare
            ab = JSVMCallBuf.buf
            StoreValue(ab, gt)
            extv = JSBridge__NObjIsExtensible(ab, 1)
            IfCondition EqualTo(JSRT_IsTruthy(extv), 0) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        bits = JSBridge__GetAttrBits(gt, save_n)
        IfCondition NotEqual(BitwiseAnd(bits, 4), 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(BitwiseAnd(bits, 3), 3) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// M128j: CanDeclareGlobalVar — existing own/global binding ok; else IsExtensible.
Function.JSVM_Eval__CanDeclareGlobalVar {
    Input: name: Address
    Output: Integer
    Body: {
        save_n = name
        IfCondition EqualTo(save_n, 0) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(GlobalHash_Lookup(save_n), -1) ThenBlock: {
            ReturnValue(1)
        }
        gt = GlobalHash_Lookup("globalThis")
        IfCondition EqualTo(gt, -1) ThenBlock: {
            gt = GlobalHash_Lookup("this")
        }
        IfCondition EqualTo(gt, -1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(JSRT_ObjHas(gt, save_n), 1) ThenBlock: {
            ReturnValue(1)
        }
        ab = JSVMCallBuf.buf
        StoreValue(ab, gt)
        extv = JSBridge__NObjIsExtensible(ab, 1)
        IfCondition EqualTo(JSRT_IsTruthy(extv), 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}


// M128v: outermost script_env (global declarative) — walk __parent to root.
// Indirect eval free-var / var-lex collision must not see block-level lets.
Function.JSVM_Eval__GlobalLexEnv {
    Input: start: Address
    Output: Address
    Body: {
        env = start
        IfCondition Or(EqualTo(env, 0), EqualTo(env, JSRTState.undef_val)) ThenBlock: {
            ReturnValue(0)
        }
        hops = 0
        WhileLoop And(NotEqual(env, 0), LessThan(hops, 64)) {
            IfCondition EqualTo(env, JSRTState.undef_val) ThenBlock: {
                ReturnValue(0)
            }
            par = JSRT_ObjGet(env, JSVMClosure.parent_key)
            IfCondition Or(EqualTo(par, 0), EqualTo(par, JSRTState.undef_val)) ThenBlock: {
                ReturnValue(env)
            }
            env = par
            hops = Add(hops, 1)
        }
        ReturnValue(env)
    }
}

Function.JSVM_Eval__CheckVarLexCollision {
    Input: root: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(root, 0) ThenBlock: { ReturnValue(0) }
        wstk = Allocate(2048)
        MemorySet(wstk, 0, 2048)
        wsp = 0
        StoreValue(wstk, root)
        wsp = 1
        WhileLoop GreaterThan(wsp, 0) {
            wsp = Subtract(wsp, 1)
            nd = Dereference(Add(wstk, Multiply(wsp, 8)))
            IfCondition GreaterEqual(nd, 0) ThenBlock: {
                nt = JSParse_GetType(nd)
                is_fn = 0
                IfCondition EqualTo(nt, ASTType.FUNC_EXPR) ThenBlock: { is_fn = 1 }
                IfCondition EqualTo(nt, ASTType.ARROW_EXPR) ThenBlock: { is_fn = 1 }
                IfCondition EqualTo(nt, ASTType.GEN_FUNC_EXPR) ThenBlock: { is_fn = 1 }
                IfCondition EqualTo(nt, ASTType.ASYNC_FUNC_EXPR) ThenBlock: { is_fn = 1 }
                check_name = 0
                np = 0
                nl = 0
                IfCondition EqualTo(nt, ASTType.FUNC_DECL) ThenBlock: {
                    np = JSParse_GetNamePtr(nd)
                    nl = JSParse_GetNameLen(nd)
                    check_name = 1
                    is_fn = 2
                }
                IfCondition EqualTo(nt, ASTType.GEN_FUNC_DECL) ThenBlock: {
                    np = JSParse_GetNamePtr(nd)
                    nl = JSParse_GetNameLen(nd)
                    check_name = 1
                    is_fn = 2
                }
                IfCondition EqualTo(nt, ASTType.ASYNC_FUNC_DECL) ThenBlock: {
                    np = JSParse_GetNamePtr(nd)
                    nl = JSParse_GetNameLen(nd)
                    check_name = 1
                    is_fn = 2
                }
                IfCondition EqualTo(nt, ASTType.CLASS_DECL) ThenBlock: {
                    is_fn = 2
                }
                IfCondition EqualTo(nt, ASTType.VAR_DECL) ThenBlock: {
                    vop = JSParse_GetOp(nd)
                    IfCondition EqualTo(vop, 70) ThenBlock: {
                        pat = JSParse_GetRight(nd)
                        IfCondition LessThan(pat, 0) ThenBlock: {
                            np = JSParse_GetNamePtr(nd)
                            nl = JSParse_GetNameLen(nd)
                            check_name = 1
                        }
                    }
                }
                IfCondition EqualTo(check_name, 1) ThenBlock: {
                    IfCondition GreaterThan(nl, 0) ThenBlock: {
                        klen = Add(nl, 1)
                        k = JSRT__StrSlabAlloc(klen)
                        IfCondition NotEqual(k, 0) ThenBlock: {
                            MemoryCopy(k, np, nl)
                            SetByte(k, nl, 0)
                            // M128v: lex collision scope
                            // - direct: caller script_env chain + caller_env (function VE)
                            // - indirect: only global declarative (root), not block lets
                            lex_start = JSVMClosure.script_env
                            IfCondition GreaterThan(JSVMEvalState.depth, 0) ThenBlock: {
                                IfCondition And(NotEqual(JSVMEvalState.save_script_env, 0), NotEqual(JSVMEvalState.save_script_env, JSRTState.undef_val)) ThenBlock: {
                                    lex_start = JSVMEvalState.save_script_env
                                }
                            }
                            IfCondition EqualTo(JSVMEvalState.is_direct, 0) ThenBlock: {
                                lex_start = JSVM_Eval__GlobalLexEnv(lex_start)
                                env = lex_start
                                IfCondition And(NotEqual(env, 0), NotEqual(env, JSRTState.undef_val)) ThenBlock: {
                                    IfCondition EqualTo(JSVM_Eval__EnvHasLex(env, k), 1) ThenBlock: {
                                        Deallocate(wstk, 2048)
                                        ReturnValue(1)
                                    }
                                }
                            } ElseBlock: {
                                env = lex_start
                                hops = 0
                                WhileLoop And(NotEqual(env, 0), LessThan(hops, 64)) {
                                    IfCondition EqualTo(env, JSRTState.undef_val) ThenBlock: {
                                        env = 0
                                    }
                                    IfCondition NotEqual(env, 0) ThenBlock: {
                                        IfCondition EqualTo(JSVM_Eval__EnvHasLex(env, k), 1) ThenBlock: {
                                            Deallocate(wstk, 2048)
                                            ReturnValue(1)
                                        }
                                        env = JSRT_ObjGet(env, JSVMClosure.parent_key)
                                    }
                                    hops = Add(hops, 1)
                                }
                                env = JSVMEvalState.caller_env
                                hops = 0
                                WhileLoop And(NotEqual(env, 0), LessThan(hops, 64)) {
                                    IfCondition EqualTo(env, JSRTState.undef_val) ThenBlock: {
                                        env = 0
                                    }
                                    IfCondition NotEqual(env, 0) ThenBlock: {
                                        IfCondition EqualTo(JSVM_Eval__EnvHasLex(env, k), 1) ThenBlock: {
                                            Deallocate(wstk, 2048)
                                            ReturnValue(1)
                                        }
                                        env = JSRT_ObjGet(env, JSVMClosure.parent_key)
                                    }
                                    hops = Add(hops, 1)
                                }
                            }
                        }
                    }
                }
                IfCondition EqualTo(is_fn, 2) ThenBlock: {
                    ch = JSParse_GetNext(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                }
                IfCondition EqualTo(is_fn, 0) ThenBlock: {
                    ch = JSParse_GetLeft(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    ch = JSParse_GetRight(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    ch = JSParse_GetBody(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    ch = JSParse_GetCond(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    ch = JSParse_GetNext(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                }
            }
        }
        Deallocate(wstk, 2048)
        ReturnValue(0)
    }
}

Function.JSVM_Eval__BindNameUndef {
    Input: env: Address
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        save_e = env
        save_p = name_ptr
        save_l = name_len
        IfCondition LessEqual(save_l, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(save_p, 0) ThenBlock: { ReturnValue(0) }
        klen = Add(save_l, 1)
        k = JSRT__StrSlabAlloc(klen)
        IfCondition EqualTo(k, 0) ThenBlock: { ReturnValue(0) }
        MemoryCopy(k, save_p, save_l)
        SetByte(k, save_l, 0)
        // env path: frame / caller VariableEnvironment
        IfCondition And(NotEqual(save_e, 0), NotEqual(save_e, JSRTState.undef_val)) ThenBlock: {
            // Already bound (outer local or prior decl) — leave existing value
            // Mark on preexist side-table so hoist SET undef is skipped once
            IfCondition EqualTo(JSRT_ObjHas(save_e, k), 1) ThenBlock: {
                IfCondition And(NotEqual(JSVMEvalState.preexist, 0), NotEqual(JSVMEvalState.preexist, JSRTState.undef_val)) ThenBlock: {
                    JSRT_ObjSet(JSVMEvalState.preexist, k, JSRTState.true_val)
                }
                ReturnValue(1)
            }
            JSRT_ObjSet(save_e, k, JSRTState.undef_val)
            // Mark configurable (eval CreateMutableBinding D=true) for delete
            ckb = JSVMCallBuf.getter_buf
            SetByte(ckb, 0, 95)
            SetByte(ckb, 1, 95)
            SetByte(ckb, 2, 99)
            SetByte(ckb, 3, 102)
            SetByte(ckb, 4, 103)
            SetByte(ckb, 5, 95)
            ci = 0
            cdone = 0
            WhileLoop EqualTo(cdone, 0) {
                cb = GetByte(k, ci)
                SetByte(ckb, Add(6, ci), cb)
                IfCondition EqualTo(cb, 0) ThenBlock: {
                    cdone = 1
                }
                ci = Add(ci, 1)
            }
            ck_len = Add(6, ci)
            ck_stable = JSRT__StrSlabAlloc(ck_len)
            IfCondition NotEqual(ck_stable, 0) ThenBlock: {
                MemoryCopy(ck_stable, ckb, ck_len)
                JSRT_ObjSet(save_e, ck_stable, JSRTState.true_val)
            }
            ReturnValue(1)
        }
        // Global eval: CreateGlobalVarBinding only if missing
        IfCondition NotEqual(GlobalHash_Lookup(k), -1) ThenBlock: {
            ReturnValue(1)
        }
        JSVM__SetGlobalHash(k, JSRTState.undef_val)
        ReturnValue(1)
    }
}

// M128e: non-strict direct eval — CreateMutableBinding for var/function names
// on the caller's VariableEnvironment before bytecode runs (EvalDeclarationInstantiation).
// Skips nested function bodies (their vars are local to those functions).
Function.JSVM_Eval__HoistDeclToEnv {
    Input: root: Integer
    Input: env: Address
    Output: Integer
    Body: {
        // env==0 → global CreateGlobalVarBinding path inside BindNameUndef
        // (must still walk AST; previously early-return made top-level eval
        // depend entirely on HoistVars SET_GLOBAL which wiped existing props).
        IfCondition LessThan(root, 0) ThenBlock: { ReturnValue(0) }
        wstk = Allocate(2048)
        MemorySet(wstk, 0, 2048)
        wsp = 0
        StoreValue(wstk, root)
        wsp = 1
        WhileLoop GreaterThan(wsp, 0) {
            wsp = Subtract(wsp, 1)
            nd = Dereference(Add(wstk, Multiply(wsp, 8)))
            IfCondition GreaterEqual(nd, 0) ThenBlock: {
                nt = JSParse_GetType(nd)
                // Nested function boundary — hoist name only, do not enter body
                is_fn_boundary = 0
                IfCondition EqualTo(nt, ASTType.FUNC_EXPR) ThenBlock: { is_fn_boundary = 1 }
                IfCondition EqualTo(nt, ASTType.ARROW_EXPR) ThenBlock: { is_fn_boundary = 1 }
                IfCondition EqualTo(nt, ASTType.GEN_FUNC_EXPR) ThenBlock: { is_fn_boundary = 1 }
                IfCondition EqualTo(nt, ASTType.ASYNC_FUNC_EXPR) ThenBlock: { is_fn_boundary = 1 }
                IfCondition EqualTo(nt, ASTType.FUNC_DECL) ThenBlock: {
                    np = JSParse_GetNamePtr(nd)
                    nl = JSParse_GetNameLen(nd)
                    JSVM_Eval__BindNameUndef(env, np, nl)
                    // Continue to N_NEXT only (sibling chain)
                    ch = JSParse_GetNext(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    is_fn_boundary = 2
                }
                IfCondition EqualTo(nt, ASTType.GEN_FUNC_DECL) ThenBlock: {
                    np = JSParse_GetNamePtr(nd)
                    nl = JSParse_GetNameLen(nd)
                    JSVM_Eval__BindNameUndef(env, np, nl)
                    ch = JSParse_GetNext(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    is_fn_boundary = 2
                }
                IfCondition EqualTo(nt, ASTType.ASYNC_FUNC_DECL) ThenBlock: {
                    np = JSParse_GetNamePtr(nd)
                    nl = JSParse_GetNameLen(nd)
                    JSVM_Eval__BindNameUndef(env, np, nl)
                    ch = JSParse_GetNext(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    is_fn_boundary = 2
                }
                IfCondition EqualTo(nt, ASTType.CLASS_DECL) ThenBlock: {
                    ch = JSParse_GetNext(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    is_fn_boundary = 2
                }
                IfCondition EqualTo(is_fn_boundary, 1) ThenBlock: {
                    // expr forms: no name hoist here
                }
                IfCondition EqualTo(is_fn_boundary, 0) ThenBlock: {
                    // var (op 70), not let/const
                    IfCondition EqualTo(nt, ASTType.VAR_DECL) ThenBlock: {
                        vop = JSParse_GetOp(nd)
                        IfCondition EqualTo(vop, 70) ThenBlock: {
                            pat = JSParse_GetRight(nd)
                            IfCondition LessThan(pat, 0) ThenBlock: {
                                np = JSParse_GetNamePtr(nd)
                                nl = JSParse_GetNameLen(nd)
                                JSVM_Eval__BindNameUndef(env, np, nl)
                            }
                        }
                    }
                    // enqueue children
                    ch = JSParse_GetLeft(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    ch = JSParse_GetRight(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    ch = JSParse_GetBody(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    ch = JSParse_GetCond(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    ch = JSParse_GetNext(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                }
            }
        }
        Deallocate(wstk, 2048)
        ReturnValue(1)
    }
}

// M128e7m: seed JSComp private-name table from caller's class __priv_env__/
// __priv_brand__ so direct eval mangles #name with the same brand as the method.
Function.JSVM_Eval__SeedPrivateFromCaller {
    Output: Integer
    Body: {
        JSCompState.priv_depth = 0
        JSCompState.priv_name_count = 0
        JSCompState.priv_class_id = 0
        IfCondition LessEqual(JSVMEvalState.save_fp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSVMClosure.frame_funcs, 0) ThenBlock: { ReturnValue(0) }
        cal = Dereference(Add(JSVMClosure.frame_funcs, Multiply(Subtract(JSVMEvalState.save_fp, 1), 8)))
        IfCondition NotEqual(JSRT_GetType(cal), JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        home = JSRT_FuncPropGet(cal, "__home_proto__")
        ht = JSRT_GetType(home)
        ctor = 0
        IfCondition EqualTo(ht, JSType.FUNCTION) ThenBlock: {
            ctor = home
        }
        IfCondition EqualTo(ht, JSType.OBJECT) ThenBlock: {
            ctor = JSRT_ObjGet(home, "constructor")
            IfCondition NotEqual(JSRT_GetType(ctor), JSType.FUNCTION) ThenBlock: {
                ctor = 0
            }
        }
        IfCondition EqualTo(ctor, 0) ThenBlock: { ReturnValue(0) }
        brand_v = JSRT_ObjGet(ctor, "__priv_brand__")
        env_v = JSRT_ObjGet(ctor, "__priv_env__")
        IfCondition NotEqual(JSRT_GetType(brand_v), JSType.NUMBER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_GetType(env_v), JSType.STRING) ThenBlock: { ReturnValue(0) }
        brand_id = Float_ToInt(JSRT_GetPayload(brand_v))
        // env string may be UTF-16 headered — use StrToC for C walk
        env_ptr = JSRT_StrToC(JSRT_GetPayload(env_v))
        IfCondition EqualTo(env_ptr, 0) ThenBlock: {
            env_ptr = JSRT_GetPayload(env_v)
        }
        IfCondition EqualTo(env_ptr, 0) ThenBlock: { ReturnValue(0) }
        // Parse comma-separated #names into priv_name table at depth 1
        start = 0
        i = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            b = GetByte(env_ptr, i)
            IfCondition Or(EqualTo(b, 0), EqualTo(b, 44)) ThenBlock: {
                nlen = Subtract(i, start)
                IfCondition And(GreaterThan(nlen, 0), LessThan(JSCompState.priv_name_count, 64)) ThenBlock: {
                    nbuf = Allocate(Add(nlen, 1))
                    IfCondition NotEqual(nbuf, 0) ThenBlock: {
                        MemoryCopy(nbuf, Add(env_ptr, start), nlen)
                        SetByte(nbuf, nlen, 0)
                        ni = JSCompState.priv_name_count
                        StoreValue(Add(JSCompState.priv_name_ptrs, Multiply(ni, 8)), nbuf)
                        StoreValue(Add(JSCompState.priv_name_lens, Multiply(ni, 8)), nlen)
                        StoreValue(Add(JSCompState.priv_name_depths, Multiply(ni, 8)), 1)
                        JSCompState.priv_name_count = Add(ni, 1)
                    }
                }
                IfCondition EqualTo(b, 0) ThenBlock: {
                    done = 1
                } ElseBlock: {
                    start = Add(i, 1)
                    i = Add(i, 1)
                }
            } ElseBlock: {
                i = Add(i, 1)
                IfCondition GreaterThan(i, 512) ThenBlock: { done = 1 }
            }
        }
        IfCondition GreaterThan(JSCompState.priv_name_count, 0) ThenBlock: {
            JSCompState.priv_depth = 1
            JSCompState.priv_class_id = brand_id
            StoreValue(Add(JSCompState.priv_stack_ids, Multiply(1, 8)), brand_id)
        }
        ReturnValue(1)
    }
}

// M71: does blob of body let-names contain name?
Function.JSVM_Eval__LexHas {
    Input: blob: Address
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(blob, 0) ThenBlock: { ReturnValue(0) }
        save_p = name_ptr
        save_l = name_len
        cnt = Dereference(blob)
        IfCondition LessEqual(cnt, 0) ThenBlock: { ReturnValue(0) }
        bpos = 8
        i = 0
        WhileLoop LessThan(i, cnt) {
            bl = Dereference(Add(blob, bpos))
            bpos = Add(bpos, 8)
            bp = Add(blob, bpos)
            match = 0
            IfCondition EqualTo(bl, save_l) ThenBlock: {
                IfCondition EqualTo(bl, 0) ThenBlock: {
                    match = 1
                } ElseBlock: {
                    IfCondition EqualTo(MemCompare(bp, save_p, bl), 0) ThenBlock: {
                        match = 1
                    }
                }
            }
            IfCondition EqualTo(match, 1) ThenBlock: { ReturnValue(1) }
            bpos = Add(bpos, Add(bl, 1))
            bpos = Multiply(Divide(Add(bpos, 7), 8), 8)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// M71: recursive walk — limited depth via fixed array of pending nodes
Function.JSVM_Eval__CheckVarLexConflict {
    Input: root: Integer
    Input: lex_blob: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(lex_blob, 0) ThenBlock: { ReturnValue(0) }
        // M128q: refuse garbage formal/lex blobs (uninitialized fdesc+104)
        // Real blobs start with small count; heap garbage often has huge cnt.
        cnt_chk = Dereference(lex_blob)
        IfCondition Or(LessThan(cnt_chk, 0), GreaterThan(cnt_chk, 64)) ThenBlock: {
            ReturnValue(0)
        }
        // Validate first entry length before walking
        bl0 = Dereference(Add(lex_blob, 8))
        IfCondition Or(LessThan(bl0, 0), GreaterThan(bl0, 256)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(root, 0) ThenBlock: { ReturnValue(0) }
        // 256-slot walk stack on heap
        wstk = Allocate(2048)
        MemorySet(wstk, 0, 2048)
        wsp = 0
        StoreValue(wstk, root)
        wsp = 1
        WhileLoop GreaterThan(wsp, 0) {
            wsp = Subtract(wsp, 1)
            nd = Dereference(Add(wstk, Multiply(wsp, 8)))
            IfCondition GreaterEqual(nd, 0) ThenBlock: {
                nt = JSParse_GetType(nd)
                IfCondition EqualTo(nt, ASTType.VAR_DECL) ThenBlock: {
                    vop = JSParse_GetOp(nd)
                    IfCondition EqualTo(vop, 70) ThenBlock: {
                        np = JSParse_GetNamePtr(nd)
                        nl = JSParse_GetNameLen(nd)
                        IfCondition GreaterThan(nl, 0) ThenBlock: {
                            IfCondition EqualTo(JSVM_Eval__LexHas(lex_blob, np, nl), 1) ThenBlock: {
                                // Detect only — throw after RestoreOuter so outer
                                // try/catch is live (ThrowValue needs exc_sp/fp).
                                Deallocate(wstk, 2048)
                                ReturnValue(1)
                            }
                        }
                    }
                }
                // enqueue children if room
                ch = JSParse_GetLeft(nd)
                IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                    StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                    wsp = Add(wsp, 1)
                }
                ch = JSParse_GetRight(nd)
                IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                    StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                    wsp = Add(wsp, 1)
                }
                ch = JSParse_GetBody(nd)
                IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                    StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                    wsp = Add(wsp, 1)
                }
                ch = JSParse_GetCond(nd)
                IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                    StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                    wsp = Add(wsp, 1)
                }
                ch = JSParse_GetNext(nd)
                IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                    StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                    wsp = Add(wsp, 1)
                }
            }
        }
        Deallocate(wstk, 2048)
        ReturnValue(0)
    }
}

// =============================================================================
// JSVM_EvalSource — run a source string as eval, return completion value
// Does NOT wipe globals. Saves outer VM bytecode + stack.
// =============================================================================
Function.JSVM_EvalSource {
    Input: source: Address
    Input: src_len: Integer
    Output: Address
    Body: {
        save_src = source
        save_len = src_len

        IfCondition EqualTo(save_src, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        IfCondition LessEqual(save_len, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // M128t: nested eval (depth 1→2) — outer is already on permanent own_c.
        // Soft-fail only past depth 2. Nested path: heap-save parent execution,
        // compile/run child, restore parent (do not clobber code_bak).
        IfCondition GreaterThan(JSVMEvalState.depth, 2) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        is_nested = 0
        IfCondition GreaterThan(JSVMEvalState.depth, 0) ThenBlock: {
            is_nested = 1
            // Heap-save parent eval execution image + value stack/frames
            JSVMEvalState.nest_code = JSVMState.code
            JSVMEvalState.nest_code_len = JSVMState.code_len
            JSVMEvalState.nest_const = JSVMState.const_pool
            JSVMEvalState.nest_const_n = JSVMState.const_count
            JSVMEvalState.nest_pc = JSVMState.pc
            JSVMEvalState.nest_sp = JSVMState.sp
            JSVMEvalState.nest_fp = JSVMState.fp
            JSVMEvalState.nest_strict = JSVMState.is_strict
            JSVMEvalState.nest_halted = JSVMState.halted
            JSVMEvalState.nest_error = JSVMState.error
            JSVMEvalState.nest_exc_sp = JSVMState.exc_sp
            JSVMEvalState.nest_caller_env = JSVMEvalState.caller_env
            JSVMEvalState.nest_eval_var_env = JSVMEvalState.eval_var_env
            JSVMEvalState.nest_preexist = JSVMEvalState.preexist
            JSVMEvalState.nest_is_direct = JSVMEvalState.is_direct
            JSVMEvalState.nest_param_init = JSVMEvalState.param_init
            JSVMEvalState.nest_param_init_arrow = JSVMEvalState.param_init_arrow
            JSVMEvalState.nest_pending_code = JSVMEvalState.pending_code
            JSVMEvalState.nest_pending_code_len = JSVMEvalState.pending_code_len
            JSVMEvalState.nest_pending_const = JSVMEvalState.pending_const
            JSVMEvalState.nest_pending_const_n = JSVMEvalState.pending_const_n
            nest_stk_sz = Multiply(JSVMState.sp, 8)
            JSVMEvalState.nest_stk = 0
            JSVMEvalState.nest_stk_sz = nest_stk_sz
            IfCondition GreaterThan(nest_stk_sz, 0) ThenBlock: {
                JSVMEvalState.nest_stk = Allocate(nest_stk_sz)
                IfCondition NotEqual(JSVMEvalState.nest_stk, 0) ThenBlock: {
                    MemoryCopy(JSVMEvalState.nest_stk, JSVMState.stack, nest_stk_sz)
                }
            }
            nest_frm_sz = Multiply(JSVMState.fp, JSVMConst.FRAME_SIZE)
            JSVMEvalState.nest_frm = 0
            JSVMEvalState.nest_frm_sz = nest_frm_sz
            IfCondition GreaterThan(nest_frm_sz, 0) ThenBlock: {
                JSVMEvalState.nest_frm = Allocate(nest_frm_sz)
                IfCondition NotEqual(JSVMEvalState.nest_frm, 0) ThenBlock: {
                    MemoryCopy(JSVMEvalState.nest_frm, JSVMState.frames, nest_frm_sz)
                }
            }
            // Save compiler tables nested will clobber (func_pool / str_buf)
            JSVMEvalState.nest_func_n = JSCompState.func_count
            JSVMEvalState.nest_str_pos = JSCompState.str_pos
            fsz_n = Multiply(JSCompState.func_count, 56)
            IfCondition GreaterThan(fsz_n, JSVMEvalState.func_cap) ThenBlock: {
                fsz_n = JSVMEvalState.func_cap
            }
            JSVMEvalState.nest_func_bak = 0
            IfCondition And(NotEqual(JSCompState.func_pool, 0), GreaterThan(fsz_n, 0)) ThenBlock: {
                JSVMEvalState.nest_func_bak = Allocate(fsz_n)
                IfCondition NotEqual(JSVMEvalState.nest_func_bak, 0) ThenBlock: {
                    MemoryCopy(JSVMEvalState.nest_func_bak, JSCompState.func_pool, fsz_n)
                }
            }
            JSVMEvalState.nest_str_bak = 0
            IfCondition And(NotEqual(JSCompState.str_buf, 0), GreaterThan(JSCompState.str_pos, 0)) ThenBlock: {
                ssz_n = JSCompState.str_pos
                IfCondition GreaterThan(ssz_n, JSVMEvalState.str_cap) ThenBlock: {
                    ssz_n = JSVMEvalState.str_cap
                }
                JSVMEvalState.nest_str_bak = Allocate(ssz_n)
                IfCondition NotEqual(JSVMEvalState.nest_str_bak, 0) ThenBlock: {
                    MemoryCopy(JSVMEvalState.nest_str_bak, JSCompState.str_buf, ssz_n)
                }
                JSVMEvalState.nest_str_pos = ssz_n
            }
            // Nested inherits outer eval's VariableEnvironment for direct eval
            // (outer already captured testcase/function env).
        }

        // Outer bytecode must fit backup (only depth 0→1 uses static bak)
        IfCondition EqualTo(is_nested, 0) ThenBlock: {
            IfCondition GreaterThan(JSVMState.code_len, JSVMEvalState.code_cap) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            csz_need = Multiply(JSVMState.const_count, 16)
            IfCondition GreaterThan(csz_need, JSVMEvalState.const_cap) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
        } ElseBlock: {
            csz_need = Multiply(JSVMState.const_count, 16)
        }

        JSVMEvalState.depth = Add(JSVMEvalState.depth, 1)
        JSVMEvalState.param_init = 0
        JSVMEvalState.param_init_arrow = 0
        JSVMEvalState.param_formals = 0
        // is_direct set by DIRECT_EVAL opcode; plain CALL to eval leaves it 0
        // M128d: capture caller's VariableEnvironment for direct-eval var binding
        // M128t: nested inherits parent's caller_env (outer eval has fp==0).
        JSVMEvalState.caller_env = 0
        IfCondition EqualTo(is_nested, 1) ThenBlock: {
            IfCondition EqualTo(JSVMEvalState.is_direct, 1) ThenBlock: {
                JSVMEvalState.caller_env = JSVMEvalState.nest_caller_env
            }
        } ElseBlock: {
            IfCondition EqualTo(JSVMEvalState.is_direct, 1) ThenBlock: {
                IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                    fi_ce = Subtract(JSVMState.fp, 1)
                    ce = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi_ce, 8)))
                    IfCondition And(NotEqual(ce, 0), NotEqual(ce, JSRTState.undef_val)) ThenBlock: {
                        JSVMEvalState.caller_env = ce
                    }
                }
            }
        }

        // M71: capture caller function for non-strict direct-eval lex/var check
        // before we zero fp for the eval program.
        // Body lets at fdesc+96; formals at fdesc+104 (only during param init).
        // Param-init when caller pc < body_start (fdesc+72).
        eval_lex_blob = 0
        IfCondition And(GreaterThan(JSVMState.fp, 0), EqualTo(JSVMState.is_strict, 0)) ThenBlock: {
            IfCondition NotEqual(JSVMClosure.frame_funcs, 0) ThenBlock: {
                cal_ev = Dereference(Add(JSVMClosure.frame_funcs, Multiply(Subtract(JSVMState.fp, 1), 8)))
                IfCondition EqualTo(JSRT_GetType(cal_ev), JSType.FUNCTION) ThenBlock: {
                    fdesc_ev = JSRT_GetPayload(cal_ev)
                    IfCondition NotEqual(fdesc_ev, 0) ThenBlock: {
                        body_start_ev = Dereference(Add(fdesc_ev, 72))
                        // During default-param init, check formals; else body lets
                        IfCondition And(GreaterThan(body_start_ev, 0), LessThan(JSVMState.pc, body_start_ev)) ThenBlock: {
                            eval_lex_blob = 0
                            JSVMEvalState.param_init = 1
                            // Params word: bit 28 arrow, bit 27 formal named "arguments"
                            pcount_pi = Dereference(Add(fdesc_ev, 8))
                            JSVMEvalState.param_formals = pcount_pi
                            IfCondition NotEqual(BitwiseAnd(pcount_pi, 268435456), 0) ThenBlock: {
                                JSVMEvalState.param_init_arrow = 1
                            } ElseBlock: {
                                // Non-arrow: avoid half-built frame — ephemeral only
                                JSVMEvalState.caller_env = 0
                            }
                        } ElseBlock: {
                            eval_lex_blob = Dereference(Add(fdesc_ev, 96))
                        }
                    }
                }
            }
        }

        // ── Save outer VM execution state ──
        // M128v: nested (depth 1→2) must NOT overwrite save_* — those hold the
        // true outer script snapshot for RestoreOuter. Nested uses nest_* only.
        // Overwriting save_code_ptr/save_pc/save_func_n caused RestoreOuter to
        // point at the parent eval own_c and corrupt post-eval execution
        // (var+nested-eval flaky under harness polyfill / high func_count).
        IfCondition EqualTo(is_nested, 0) ThenBlock: {
            JSVMEvalState.save_code_len = JSVMState.code_len
            JSVMEvalState.save_const_n = JSVMState.const_count
            JSVMEvalState.save_code_ptr = JSVMState.code
            JSVMEvalState.save_const_ptr = JSVMState.const_pool
            JSVMEvalState.save_pc = JSVMState.pc
            JSVMEvalState.save_sp = JSVMState.sp
            JSVMEvalState.save_fp = JSVMState.fp
            JSVMEvalState.save_halted = JSVMState.halted
            JSVMEvalState.save_error = JSVMState.error
            JSVMEvalState.save_steps = JSVMState.steps
            JSVMEvalState.save_exc_sp = JSVMState.exc_sp
            JSVMEvalState.save_strict = JSVMState.is_strict
            // M82: class FRESH_LET_ENV at eval top-level replaces script_env
            JSVMEvalState.save_script_env = JSVMClosure.script_env
            // M128m: heal TDZ-stale env bindings from live stack BEFORE we zero sp
            // (let dual-write may leave env at tdz_uninit while stack has the value).
            IfCondition And(NotEqual(JSVMClosure.script_env, 0), NotEqual(JSVMClosure.script_env, JSRTState.undef_val)) ThenBlock: {
                IfCondition And(NotEqual(JSVMClosure.tdz_uninit, 0), GreaterThan(JSVMState.sp, 0)) ThenBlock: {
                    // Walk PropTable entries of script_env — heal data props still at TDZ
                    // when __sl_ slot points at an initialized stack local.
                    se = JSVMClosure.script_env
                    ptab = Dereference(Add(se, 8))
                    IfCondition NotEqual(ptab, 0) ThenBlock: {
                        pcnt = Dereference(ptab)
                        IfCondition GreaterThan(pcnt, 256) ThenBlock: {
                            pcnt = 256
                        }
                        pi = 0
                        WhileLoop LessThan(pi, pcnt) {
                            eaddr = Add(ptab, Add(8, Multiply(pi, 16)))
                            ekey = Dereference(eaddr)
                            IfCondition And(NotEqual(ekey, 0), NotEqual(ekey, -2)) ThenBlock: {
                                // Skip internal keys starting with __
                                IfCondition NotEqual(GetByte(ekey, 0), 95) ThenBlock: {
                                    e_val = Dereference(Add(eaddr, 8))
                                    IfCondition EqualTo(e_val, JSVMClosure.tdz_uninit) ThenBlock: {
                                        // Lookup __sl_ + name
                                        slb = JSVMCallBuf.getter_buf
                                        SetByte(slb, 0, 95)
                                        SetByte(slb, 1, 95)
                                        SetByte(slb, 2, 115)
                                        SetByte(slb, 3, 108)
                                        SetByte(slb, 4, 95)
                                        si = 0
                                        sdone = 0
                                        WhileLoop EqualTo(sdone, 0) {
                                            sb = GetByte(ekey, si)
                                            SetByte(slb, Add(5, si), sb)
                                            IfCondition EqualTo(sb, 0) ThenBlock: {
                                                sdone = 1
                                            }
                                            si = Add(si, 1)
                                        }
                                        slot_v = JSRT_ObjGet(se, slb)
                                        IfCondition EqualTo(JSRT_GetType(slot_v), JSType.NUMBER) ThenBlock: {
                                            slot_n = Float_ToInt(JSRT_GetPayload(slot_v))
                                            IfCondition And(GreaterEqual(slot_n, 0), LessThan(slot_n, JSVMState.sp)) ThenBlock: {
                                                saddr = Add(JSVMState.stack, Multiply(slot_n, 8))
                                                sval = Dereference(saddr)
                                                IfCondition NotEqual(sval, JSVMClosure.tdz_uninit) ThenBlock: {
                                                    JSRT_ObjSet(se, ekey, sval)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            pi = Add(pi, 1)
                        }
                    }
                }
            }
            // Outer func_pool: CLOSURE const payloads point into JSCompState.func_pool.
            // JSComp_Reset zeros it — must restore or post-eval function exprs hang.
            JSVMEvalState.save_func_n = JSCompState.func_count
            // M83: STRING const payloads are pointers into JSCompState.str_buf.
            // Eval recompile overwrites str_buf → flaky outer names / method props.
            JSVMEvalState.save_str_pos = JSCompState.str_pos

            // Copy outer bytecode + const pool (compiler will overwrite JSComp buffers)
            IfCondition And(NotEqual(JSVMState.code, 0), GreaterThan(JSVMState.code_len, 0)) ThenBlock: {
                // Guard: never copy more than backup capacity
                clen_copy = JSVMState.code_len
                IfCondition GreaterThan(clen_copy, JSVMEvalState.code_cap) ThenBlock: {
                    clen_copy = JSVMEvalState.code_cap
                }
                MemoryCopy(JSVMEvalState.code_bak, JSVMState.code, clen_copy)
            }
            IfCondition And(NotEqual(JSVMState.const_pool, 0), GreaterThan(csz_need, 0)) ThenBlock: {
                MemoryCopy(JSVMEvalState.const_bak, JSVMState.const_pool, csz_need)
            }
            fsz_need = Multiply(JSCompState.func_count, 56)
            IfCondition GreaterThan(fsz_need, JSVMEvalState.func_cap) ThenBlock: {
                fsz_need = JSVMEvalState.func_cap
            }
            IfCondition And(NotEqual(JSCompState.func_pool, 0), GreaterThan(fsz_need, 0)) ThenBlock: {
                MemoryCopy(JSVMEvalState.func_bak, JSCompState.func_pool, fsz_need)
            }
            // M83: backup compiler string table (const STRING payloads live here)
            IfCondition And(NotEqual(JSCompState.str_buf, 0), GreaterThan(JSVMEvalState.save_str_pos, 0)) ThenBlock: {
                ssz_need = JSVMEvalState.save_str_pos
                IfCondition GreaterThan(ssz_need, JSVMEvalState.str_cap) ThenBlock: {
                    ssz_need = JSVMEvalState.str_cap
                }
                IfCondition And(NotEqual(JSVMEvalState.str_bak, 0), GreaterThan(ssz_need, 0)) ThenBlock: {
                    MemoryCopy(JSVMEvalState.str_bak, JSCompState.str_buf, ssz_need)
                }
            }

            // Copy stack + frames (depth 0→1 only; nested uses nest_stk/nest_frm)
            stk_sz = Multiply(JSVMState.sp, 8)
            IfCondition GreaterThan(stk_sz, 0) ThenBlock: {
                MemoryCopy(JSVMEvalState.stk_bak, JSVMState.stack, stk_sz)
            }
            frm_sz = Multiply(JSVMState.fp, JSVMConst.FRAME_SIZE)
            IfCondition GreaterThan(frm_sz, 0) ThenBlock: {
                MemoryCopy(JSVMEvalState.frm_bak, JSVMState.frames, frm_sz)
            }
        } // end is_nested==0 save/bak block

        // Caller strict for THIS eval: true outer for depth0, parent eval for nested
        parent_strict = JSVMEvalState.save_strict
        IfCondition EqualTo(is_nested, 1) ThenBlock: {
            parent_strict = JSVMEvalState.nest_strict
        }

        // ── Compile + run eval source (globals preserved) ──
        // Clear only execution regs — do NOT GlobalHash_Reset / JSRT_Reset
        JSLex_Reset()
        JSComp_Reset()
        JSComp_SetEvalMode(1)
        JSVMState.sp = 0
        JSVMState.fp = 0
        JSVMState.pc = 0
        JSVMState.halted = 0
        JSVMState.error = 0
        JSVMState.steps = 0
        JSVMState.exc_sp = 0
        // M128e7m: eval body is ordinary assignment, not CreateDataProperty
        // (field_init leaves field_define=1 which would skip private setters)
        JSVMEvalState.save_field_define = JSVMState.field_define
        JSVMEvalState.save_private_init = JSVMState.private_init
        JSVMState.field_define = 0
        JSVMState.private_init = 0
        tok_count = JSLex_Tokenize(save_src, save_len)
        IfCondition LessEqual(tok_count, 0) ThenBlock: {
            JSVM_Eval__FinishRestore(is_nested)
            // M105: invalid source → SyntaxError (was silent undefined)
            terr_ev = JSVM_CreateTypedError("SyntaxError", "Invalid or unexpected token")
            JSVM__SetGlobal("__pend_exc__", terr_ev)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr_ev
            ReturnValue(JSRT_Undefined())
        }

        // M105/M128j: only *direct* eval inherits caller strict for parse/compile.
        // Indirect eval is always non-strict unless the source has "use strict"
        // (always-non-strict.js: (0,eval)('var static') from strict caller).
        inh_strict = 0
        IfCondition EqualTo(JSVMEvalState.is_direct, 1) ThenBlock: {
            inh_strict = parent_strict
        }
        JSParse_SetStrict(inh_strict)
        // M128e7m: direct eval inherits PrivateEnvironment — allow #name parse
        IfCondition EqualTo(JSVMEvalState.is_direct, 1) ThenBlock: {
            JSParse_SetAllowPrivateEval(1)
        }
        root = JSParse_Parse()
        JSParse_SetAllowPrivateEval(0)
        parse_err = JSParse_HasError()
        IfCondition Or(LessThan(root, 0), EqualTo(parse_err, 1)) ThenBlock: {
            JSVM_Eval__FinishRestore(is_nested)
            // M105: parse early errors (strict params, dups, etc.) must throw
            terr_ev = JSVM_CreateTypedError("SyntaxError", "Unexpected token")
            JSVM__SetGlobal("__pend_exc__", terr_ev)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr_ev
            ReturnValue(JSRT_Undefined())
        }

        // M71: non-strict direct eval — var must not clash with body lets.
        // Set exc_prop for native dispatch to ThrowValue after we return
        // (do not ThrowValue here: CALL handler still StackPushes return value).
        eval_lex_conflict = 0
        IfCondition NotEqual(eval_lex_blob, 0) ThenBlock: {
            IfCondition EqualTo(JSVM_Eval__CheckVarLexConflict(root, eval_lex_blob), 1) ThenBlock: {
                eval_lex_conflict = 1
            }
        }
        IfCondition EqualTo(eval_lex_conflict, 1) ThenBlock: {
            JSVM_Eval__FinishRestore(is_nested)
            JSVMEvalState.depth = 0
            JSVMEvalState.caller_env = 0
            JSVMEvalState.eval_var_env = 0
            JSVMEvalState.param_init = 0
            terr = JSVM_CreateTypedError("SyntaxError", "Identifier has already been declared")
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }

        // M128q/s/u: param-init `var arguments` → SyntaxError when:
        // - non-arrow (has arguments object), OR
        // - function has formal named "arguments" (bit 27 on params).
        // Bare arrow without such formal: var arguments is legal.
        IfCondition EqualTo(JSVMEvalState.param_init, 1) ThenBlock: {
            arg_conflict = 0
            JSVM__Push(root)
            nd_a = JSParse_GetBody(root)
            IfCondition LessThan(nd_a, 0) ThenBlock: {
                nd_a = root
            }
            walk_n = 0
            has_var_args = 0
            WhileLoop And(And(GreaterEqual(nd_a, 0), EqualTo(has_var_args, 0)), LessThan(walk_n, 256)) {
                IfCondition EqualTo(JSParse_GetType(nd_a), ASTType.VAR_DECL) ThenBlock: {
                    IfCondition EqualTo(JSParse_GetOp(nd_a), 70) ThenBlock: {
                        anp = JSParse_GetNamePtr(nd_a)
                        anl = JSParse_GetNameLen(nd_a)
                        // "arguments" = 9 chars
                        IfCondition And(EqualTo(anl, 9), NotEqual(anp, 0)) ThenBlock: {
                            IfCondition And(EqualTo(GetByte(anp, 0), 97), And(EqualTo(GetByte(anp, 1), 114), And(EqualTo(GetByte(anp, 2), 103), And(EqualTo(GetByte(anp, 3), 117), And(EqualTo(GetByte(anp, 4), 109), And(EqualTo(GetByte(anp, 5), 101), And(EqualTo(GetByte(anp, 6), 110), And(EqualTo(GetByte(anp, 7), 116), EqualTo(GetByte(anp, 8), 115))))))))) ThenBlock: {
                                has_var_args = 1
                            }
                        }
                    }
                }
                nd_a = JSParse_GetNext(nd_a)
                walk_n = Add(walk_n, 1)
            }
            root = JSVM__Pop()
            IfCondition EqualTo(has_var_args, 1) ThenBlock: {
                // Non-arrow: always conflict
                IfCondition EqualTo(JSVMEvalState.param_init_arrow, 0) ThenBlock: {
                    arg_conflict = 1
                } ElseBlock: {
                    // Arrow: conflict if bit 27 set (formal named arguments)
                    // param_formals holds params word from fdesc+8 when available
                    IfCondition NotEqual(BitwiseAnd(JSVMEvalState.param_formals, 134217728), 0) ThenBlock: {
                        arg_conflict = 1
                    }
                }
            }
            IfCondition EqualTo(arg_conflict, 1) ThenBlock: {
                JSVM_Eval__FinishRestore(is_nested)
                JSVMEvalState.depth = 0
                JSVMEvalState.caller_env = 0
                JSVMEvalState.eval_var_env = 0
                JSVMEvalState.param_init = 0
                JSVMEvalState.param_init_arrow = 0
                JSVMEvalState.param_formals = 0
                terr_arg = JSVM_CreateTypedError("SyntaxError", "Unexpected eval or arguments in strict mode")
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr_arg
                JSVM__SetGlobal("__pend_exc__", terr_arg)
                ReturnValue(0)
            }
        }

        // M128g/M128k: non-strict eval var vs outer lexical (global let / block let).
        // Strictness = parse result (source directive) OR direct+caller strict.
        // `eval('"use strict"; var x')` with outer `let x` must NOT SyntaxError
        // (EvalDeclarationInstantiation step 5 only when strict is false).
        ev_src_strict = JSParse_IsStrict()
        IfCondition EqualTo(ev_src_strict, 0) ThenBlock: {
            IfCondition EqualTo(JSVMEvalState.is_direct, 1) ThenBlock: {
                IfCondition EqualTo(parent_strict, 1) ThenBlock: {
                    ev_src_strict = 1
                }
            }
        }
        IfCondition EqualTo(ev_src_strict, 0) ThenBlock: {
            JSVM__Push(root)
            hoist_start = JSParse_GetBody(root)
            IfCondition LessThan(hoist_start, 0) ThenBlock: {
                hoist_start = root
            }
            coll = JSVM_Eval__CheckVarLexCollision(hoist_start)
            root = JSVM__Pop()
            IfCondition EqualTo(coll, 1) ThenBlock: {
                JSVM_Eval__FinishRestore(is_nested)
                JSVMEvalState.depth = 0
                JSVMEvalState.caller_env = 0
                JSVMEvalState.eval_var_env = 0
                terr_lex = JSVM_CreateTypedError("SyntaxError", "Identifier has already been declared")
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr_lex
                JSVM__SetGlobal("__pend_exc__", terr_lex)
                ReturnValue(0)
            }
            // Global function redefinition of non-configurable (NaN etc.)
            // M128j: also CanDeclareGlobalVar when global is non-extensible.
            IfCondition Or(EqualTo(JSVMEvalState.caller_env, 0), EqualTo(JSVMEvalState.caller_env, JSRTState.undef_val)) ThenBlock: {
                JSVM__Push(root)
                nd = JSParse_GetBody(root)
                IfCondition LessThan(nd, 0) ThenBlock: {
                    nd = root
                }
                bad_fn = 0
                bad_var = 0
                WhileLoop And(GreaterEqual(nd, 0), And(EqualTo(bad_fn, 0), EqualTo(bad_var, 0))) {
                    nt = JSParse_GetType(nd)
                    IfCondition Or(EqualTo(nt, ASTType.FUNC_DECL), Or(EqualTo(nt, ASTType.GEN_FUNC_DECL), EqualTo(nt, ASTType.ASYNC_FUNC_DECL))) ThenBlock: {
                        np = JSParse_GetNamePtr(nd)
                        nl = JSParse_GetNameLen(nd)
                        IfCondition GreaterThan(nl, 0) ThenBlock: {
                            k = JSRT__StrSlabAlloc(Add(nl, 1))
                            IfCondition NotEqual(k, 0) ThenBlock: {
                                MemoryCopy(k, np, nl)
                                SetByte(k, nl, 0)
                                IfCondition EqualTo(JSVM_Eval__CanDeclareGlobalFunction(k), 0) ThenBlock: {
                                    bad_fn = 1
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(nt, ASTType.VAR_DECL) ThenBlock: {
                        vop_cd = JSParse_GetOp(nd)
                        IfCondition EqualTo(vop_cd, 70) ThenBlock: {
                            pat_cd = JSParse_GetRight(nd)
                            IfCondition LessThan(pat_cd, 0) ThenBlock: {
                                np = JSParse_GetNamePtr(nd)
                                nl = JSParse_GetNameLen(nd)
                                IfCondition GreaterThan(nl, 0) ThenBlock: {
                                    k = JSRT__StrSlabAlloc(Add(nl, 1))
                                    IfCondition NotEqual(k, 0) ThenBlock: {
                                        MemoryCopy(k, np, nl)
                                        SetByte(k, nl, 0)
                                        IfCondition EqualTo(JSVM_Eval__CanDeclareGlobalVar(k), 0) ThenBlock: {
                                            bad_var = 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                    nd = JSParse_GetNext(nd)
                }
                root = JSVM__Pop()
                IfCondition EqualTo(bad_var, 1) ThenBlock: {
                    JSVM_Eval__FinishRestore(is_nested)
                    JSVMEvalState.depth = 0
                    JSVMEvalState.caller_env = 0
                    JSVMEvalState.eval_var_env = 0
                    terr_nv = JSVM_CreateTypedError("TypeError", "Cannot declare global variable")
                    JSVMCall.exc_prop = 1
                    JSVMCall.thrown_val = terr_nv
                    JSVM__SetGlobal("__pend_exc__", terr_nv)
                    ReturnValue(0)
                }
                IfCondition EqualTo(bad_fn, 1) ThenBlock: {
                    JSVM_Eval__FinishRestore(is_nested)
                    JSVMEvalState.depth = 0
                    JSVMEvalState.caller_env = 0
                    JSVMEvalState.eval_var_env = 0
                    terr_nd = JSVM_CreateTypedError("TypeError", "Cannot declare global function")
                    JSVMCall.exc_prop = 1
                    JSVMCall.thrown_val = terr_nd
                    JSVM__SetGlobal("__pend_exc__", terr_nd)
                    ReturnValue(0)
                }
            }
        }

        // M128b/M128k: eval early errors
        // - super: direct eval in non-arrow function code (ES Script early error)
        // - new.target: only in function code (save_fp>0); forbid global
        // Indirect eval always forbids both.
        allow_super_eval = 0
        allow_supercall_eval = 0
        allow_nt_eval = 0
        IfCondition EqualTo(JSVMEvalState.is_direct, 1) ThenBlock: {
            IfCondition GreaterThan(JSVMEvalState.save_fp, 0) ThenBlock: {
                IfCondition NotEqual(JSVMClosure.frame_funcs, 0) ThenBlock: {
                    cal_su = Dereference(Add(JSVMClosure.frame_funcs, Multiply(Subtract(JSVMEvalState.save_fp, 1), 8)))
                    IfCondition EqualTo(JSRT_GetType(cal_su), JSType.FUNCTION) ThenBlock: {
                        // Arrow bit 28 of param_count — no new.target / super
                        fdesc_su = JSRT_GetPayload(cal_su)
                        is_arrow_su = 0
                        IfCondition NotEqual(fdesc_su, 0) ThenBlock: {
                            pcount_su = Dereference(Add(fdesc_su, 8))
                            IfCondition NotEqual(BitwiseAnd(pcount_su, 268435456), 0) ThenBlock: {
                                is_arrow_su = 1
                            }
                        }
                        IfCondition EqualTo(is_arrow_su, 0) ThenBlock: {
                            allow_nt_eval = 1
                            // SuperProperty only with [[HomeObject]] (method); plain fn → SyntaxError
                            home_su = JSRT_FuncPropGet(cal_su, "__home_proto__")
                            ht_su = JSRT_GetType(home_su)
                            IfCondition Or(EqualTo(ht_su, JSType.OBJECT), EqualTo(ht_su, JSType.FUNCTION)) ThenBlock: {
                                allow_super_eval = 1
                            }
                            // SuperCall only in constructors (function name "constructor")
                            fn_nm = JSRT_FuncPropGet(cal_su, "name")
                            IfCondition EqualTo(JSRT_GetType(fn_nm), JSType.STRING) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrEq(JSRT_GetPayload(fn_nm), "constructor"), 1) ThenBlock: {
                                    allow_supercall_eval = 1
                                    // constructors may use SuperCall; also treat as method-like
                                    allow_super_eval = 1
                                }
                            }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(allow_super_eval, 0) ThenBlock: {
            IfCondition EqualTo(JSVM_Eval__ContainsForbiddenMeta(root, 1), 1) ThenBlock: {
                JSVM_Eval__FinishRestore(is_nested)
                JSVMEvalState.depth = 0
                JSVMEvalState.caller_env = 0
                JSVMEvalState.eval_var_env = 0
                terr_su = JSVM_CreateTypedError("SyntaxError", "'super' unexpected in this eval context")
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr_su
                JSVM__SetGlobal("__pend_exc__", terr_su)
                ReturnValue(0)
            }
        }
        // M128k: SuperCall forbidden outside constructors even when SuperProperty ok
        IfCondition EqualTo(allow_supercall_eval, 0) ThenBlock: {
            IfCondition EqualTo(JSVM_Eval__ContainsSuperCall(root), 1) ThenBlock: {
                JSVM_Eval__FinishRestore(is_nested)
                JSVMEvalState.depth = 0
                JSVMEvalState.caller_env = 0
                JSVMEvalState.eval_var_env = 0
                terr_sc = JSVM_CreateTypedError("SyntaxError", "'super' call unexpected outside constructor")
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr_sc
                JSVM__SetGlobal("__pend_exc__", terr_sc)
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(allow_nt_eval, 0) ThenBlock: {
            IfCondition EqualTo(JSVM_Eval__ContainsForbiddenMeta(root, 2), 1) ThenBlock: {
                JSVM_Eval__FinishRestore(is_nested)
                JSVMEvalState.depth = 0
                JSVMEvalState.caller_env = 0
                JSVMEvalState.eval_var_env = 0
                terr_nt = JSVM_CreateTypedError("SyntaxError", "'new.target' unexpected outside functions")
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr_nt
                JSVM__SetGlobal("__pend_exc__", terr_nt)
                ReturnValue(0)
            }
        }

        // M128e7o: direct eval in class field initializer — ContainsArguments → SyntaxError
        // Detect: field_define active, or caller fdesc bit 26 (nested in field init).
        IfCondition EqualTo(JSVMEvalState.is_direct, 1) ThenBlock: {
            in_cfi_eval = JSVMEvalState.save_field_define
            IfCondition EqualTo(in_cfi_eval, 0) ThenBlock: {
                IfCondition And(GreaterThan(JSVMEvalState.save_fp, 0), NotEqual(JSVMClosure.frame_funcs, 0)) ThenBlock: {
                    cal_cfi = Dereference(Add(JSVMClosure.frame_funcs, Multiply(Subtract(JSVMEvalState.save_fp, 1), 8)))
                    IfCondition EqualTo(JSRT_GetType(cal_cfi), JSType.FUNCTION) ThenBlock: {
                        fdesc_cfi = JSRT_GetPayload(cal_cfi)
                        IfCondition NotEqual(fdesc_cfi, 0) ThenBlock: {
                            pcount_cfi = Dereference(Add(fdesc_cfi, 8))
                            // bit 26 = 67108864
                            IfCondition NotEqual(BitwiseAnd(pcount_cfi, 67108864), 0) ThenBlock: {
                                in_cfi_eval = 1
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(in_cfi_eval, 1) ThenBlock: {
                IfCondition EqualTo(JSVM_Eval__ContainsArguments(root), 1) ThenBlock: {
                    JSVM_Eval__FinishRestore(is_nested)
                    JSVMEvalState.depth = 0
                    JSVMEvalState.caller_env = 0
                    JSVMEvalState.eval_var_env = 0
                    terr_arg = JSVM_CreateTypedError("SyntaxError", "'arguments' unexpected in field initializer eval")
                    JSVMCall.exc_prop = 1
                    JSVMCall.thrown_val = terr_arg
                    JSVM__SetGlobal("__pend_exc__", terr_arg)
                    ReturnValue(0)
                }
            }
        }

        // Inherit caller strict into compiler only for direct eval (M128j).
        IfCondition EqualTo(JSVMEvalState.is_direct, 1) ThenBlock: {
            IfCondition EqualTo(parent_strict, 1) ThenBlock: {
                JSCompState.is_strict = 1
            }
            // M128e7m: seed private brand table so #name mangles like the method
            JSVM_Eval__SeedPrivateFromCaller()
        }
        JSVM__Push(root)
        comp_ok = JSComp_Compile(root)
        root = JSVM__Pop()
        IfCondition EqualTo(comp_ok, 0) ThenBlock: {
            // M128h: illegal return/break/continue etc. → SyntaxError (was soft undefined)
            JSVM_Eval__FinishRestore(is_nested)
            JSVMEvalState.depth = 0
            JSVMEvalState.caller_env = 0
            JSVMEvalState.eval_var_env = 0
            terr_comp = JSVM_CreateTypedError("SyntaxError", "Illegal statement in eval")
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr_comp
            JSVM__SetGlobal("__pend_exc__", terr_comp)
            ReturnValue(0)
        }

        // Eval program must fit backup for any further nesting (already depth=1)
        ev_len = JSComp_GetCodeLen()
        IfCondition GreaterThan(ev_len, JSVMEvalState.code_cap) ThenBlock: {
            JSVM_Eval__FinishRestore(is_nested)
            ReturnValue(JSRT_Undefined())
        }

        bc = JSComp_GetCode()
        bc_len = JSComp_GetCodeLen()
        cp = JSComp_GetConst(0)
        cc = JSComp_GetConstCount()

        // M81: permanent code+const image for functions created during this eval.
        // RestoreOuter rewrites the shared buffers; live closures keep these.
        JSVMEvalState.pending_code = 0
        JSVMEvalState.pending_code_len = 0
        JSVMEvalState.pending_const = 0
        JSVMEvalState.pending_const_n = 0
        // M128f: run eval from permanent own_c/own_p images so functions created
        // during eval stamp pointers that remain valid after RestoreOuter
        // (shared compiler buffers are rewritten on restore).
        run_bc = bc
        run_cp = cp
        IfCondition GreaterThan(bc_len, 0) ThenBlock: {
            own_c = Allocate(bc_len)
            IfCondition NotEqual(own_c, 0) ThenBlock: {
                MemoryCopy(own_c, bc, bc_len)
                JSVMEvalState.pending_code = own_c
                JSVMEvalState.pending_code_len = bc_len
                run_bc = own_c
            }
        }
        // M83: permanent-ize STRING payloads in the *live* const pool before Run.
        // Class/object prop keys (PropTable) store C pointers from GetConstPayload;
        // if they still point into str_buf, RestoreOuter clobbers private/public keys.
        IfCondition And(GreaterThan(cc, 0), NotEqual(cp, 0)) ThenBlock: {
            JSVM_Eval__DeepOwnConst(cp, cc, 1, 0)
        }
        csz_ev = Multiply(cc, 16)
        IfCondition And(GreaterThan(cc, 0), NotEqual(cp, 0)) ThenBlock: {
            own_p = Allocate(csz_ev)
            IfCondition NotEqual(own_p, 0) ThenBlock: {
                MemoryCopy(own_p, cp, csz_ev)
                // FUNCTION descs still point at func_pool — clone for own image only
                JSVM_Eval__DeepOwnConst(own_p, cc, 0, 1)
                JSVMEvalState.pending_const = own_p
                JSVMEvalState.pending_const_n = cc
                run_cp = own_p
            }
        }

        JSVM_Load(run_bc, bc_len, run_cp, cc)
        // M128e6ak: reserve absolute local slots so expr temps do not clobber
        // loop completion V (do-while with{} cptn). Durable __cptn global is
        // primary; SP reserve is belt-and-suspenders for eval only.
        nloc_ev = JSComp_GetLocalSlotCount()
        IfCondition GreaterThan(nloc_ev, 0) ThenBlock: {
            JSVMState.sp = nloc_ev
        }
        // Strict if eval source has directive OR (direct && caller was strict)
        ev_strict = JSComp_IsStrict()
        IfCondition EqualTo(JSVMEvalState.is_direct, 1) ThenBlock: {
            IfCondition EqualTo(parent_strict, 1) ThenBlock: {
                ev_strict = 1
            }
        }
        JSVM_SetStrict(ev_strict)

        // M128e: non-strict eval — EvalDeclarationInstantiation for var/function.
        // caller_env set → function VariableEnvironment; else GlobalHash.
        // Create only when missing (must not re-init outer `var x = 1`).
        // Free assigns (initial=x) resolve via SetDynOrGlobal (existing env or global).
        // Use runtime is_strict (save_strict + directive), not JSComp_IsStrict —
        // CompileProgram clears is_strict when eval source has no "use strict".
        // M128o/s: non-arrow param_init → ephemeral eval_var_env.
        // Arrow param_init → caller_env (var must be visible in arrow body).
        IfCondition EqualTo(JSVMState.is_strict, 0) ThenBlock: {
            JSVM__Push(root)
            hoist_start = JSParse_GetBody(root)
            IfCondition LessThan(hoist_start, 0) ThenBlock: {
                hoist_start = root
            }
            // Side table: names that already existed on caller_env before this eval
            JSVMEvalState.preexist = 0
            use_eph_hoist = 0
            IfCondition EqualTo(JSVMEvalState.param_init, 1) ThenBlock: {
                IfCondition EqualTo(JSVMEvalState.param_init_arrow, 0) ThenBlock: {
                    use_eph_hoist = 1
                }
            }
            IfCondition EqualTo(use_eph_hoist, 1) ThenBlock: {
                IfCondition Or(EqualTo(JSVMEvalState.eval_var_env, 0), EqualTo(JSVMEvalState.eval_var_env, JSRTState.undef_val)) ThenBlock: {
                    JSVMEvalState.eval_var_env = JSRT_CreateObject()
                }
                JSVM_Eval__HoistDeclToEnv(hoist_start, JSVMEvalState.eval_var_env)
            } ElseBlock: {
                IfCondition And(NotEqual(JSVMEvalState.caller_env, 0), NotEqual(JSVMEvalState.caller_env, JSRTState.undef_val)) ThenBlock: {
                    pe = JSRT_CreateObject()
                    IfCondition NotEqual(pe, 0) ThenBlock: {
                        JSVMEvalState.preexist = pe
                    }
                    JSVM_Eval__HoistDeclToEnv(hoist_start, JSVMEvalState.caller_env)
                } ElseBlock: {
                    JSVM_Eval__HoistDeclToEnv(hoist_start, 0)
                }
            }
            root = JSVM__Pop()
        }

        // Run eval program — JSVM_Run returns top-of-stack (eval_mode last expr)
        eval_result = JSVM_Run()

        // M128g: uncaught throw inside eval → propagate to outer (exc_prop for
        // DIRECT_EVAL / CALL native path). Was soft-failed to undefined.
        pend_throw = 0
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
            IfCondition And(NotEqual(JSVMState.exc_val, 0), NotEqual(JSVMState.exc_val, JSRTState.undef_val)) ThenBlock: {
                pend_throw = JSVMState.exc_val
            } ElseBlock: {
                pend_throw = JSVM_CreateTypedError("Error", "uncaught exception in eval")
            }
            eval_result = JSRT_Undefined()
            JSVMState.error = 0
            JSVMState.halted = 0
            JSVMState.exc_val = 0
        }

        // Clear pending so outer LoadConst does not stamp residual images
        JSVMEvalState.pending_code = 0
        JSVMEvalState.pending_code_len = 0
        JSVMEvalState.pending_const = 0
        JSVMEvalState.pending_const_n = 0

        // Save result across restore
        JSVM__Push(eval_result)
        JSVM__Push(pend_throw)
        JSVM_Eval__FinishRestore(is_nested)
        pend_throw = JSVM__Pop()
        eval_result = JSVM__Pop()

        // Only clear dyn state after top-level eval (nested restore already fixed depth)
        IfCondition EqualTo(is_nested, 0) ThenBlock: {
            JSVMEvalState.depth = 0
            JSVMEvalState.caller_env = 0
            JSVMEvalState.preexist = 0
            JSVMEvalState.eval_var_env = 0
        }

        IfCondition And(NotEqual(pend_throw, 0), NotEqual(pend_throw, JSRTState.undef_val)) ThenBlock: {
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = pend_throw
            JSVM__SetGlobal("__pend_exc__", pend_throw)
            ReturnValue(0)
        }
        ReturnValue(eval_result)
    }
}

// Restore outer bytecode, const pool, stack, frames, regs after eval

// M128t: restore either nested parent (is_nested=1) or full outer (is_nested=0)
Function.JSVM_Eval__FinishRestore {
    Input: is_nested: Integer
    Output: Integer
    Body: {
        // M128e7m: restore field_define/private_init cleared for eval body
        JSVMState.field_define = JSVMEvalState.save_field_define
        JSVMState.private_init = JSVMEvalState.save_private_init
        IfCondition EqualTo(is_nested, 1) ThenBlock: {
            // Restore parent eval execution image
            JSVMState.code = JSVMEvalState.nest_code
            JSVMState.code_len = JSVMEvalState.nest_code_len
            JSVMState.const_pool = JSVMEvalState.nest_const
            JSVMState.const_count = JSVMEvalState.nest_const_n
            JSVMState.pc = JSVMEvalState.nest_pc
            JSVMState.sp = JSVMEvalState.nest_sp
            JSVMState.fp = JSVMEvalState.nest_fp
            JSVMState.is_strict = JSVMEvalState.nest_strict
            JSVMState.halted = JSVMEvalState.nest_halted
            JSVMState.error = JSVMEvalState.nest_error
            JSVMState.exc_sp = JSVMEvalState.nest_exc_sp
            JSVMEvalState.caller_env = JSVMEvalState.nest_caller_env
            JSVMEvalState.eval_var_env = JSVMEvalState.nest_eval_var_env
            JSVMEvalState.preexist = JSVMEvalState.nest_preexist
            JSVMEvalState.is_direct = JSVMEvalState.nest_is_direct
            JSVMEvalState.param_init = JSVMEvalState.nest_param_init
            JSVMEvalState.param_init_arrow = JSVMEvalState.nest_param_init_arrow
            JSVMEvalState.pending_code = JSVMEvalState.nest_pending_code
            JSVMEvalState.pending_code_len = JSVMEvalState.nest_pending_code_len
            JSVMEvalState.pending_const = JSVMEvalState.nest_pending_const
            JSVMEvalState.pending_const_n = JSVMEvalState.nest_pending_const_n
            IfCondition And(NotEqual(JSVMEvalState.nest_stk, 0), GreaterThan(JSVMEvalState.nest_stk_sz, 0)) ThenBlock: {
                MemoryCopy(JSVMState.stack, JSVMEvalState.nest_stk, JSVMEvalState.nest_stk_sz)
                Deallocate(JSVMEvalState.nest_stk, JSVMEvalState.nest_stk_sz)
            }
            IfCondition And(NotEqual(JSVMEvalState.nest_frm, 0), GreaterThan(JSVMEvalState.nest_frm_sz, 0)) ThenBlock: {
                MemoryCopy(JSVMState.frames, JSVMEvalState.nest_frm, JSVMEvalState.nest_frm_sz)
                Deallocate(JSVMEvalState.nest_frm, JSVMEvalState.nest_frm_sz)
            }
            JSVMEvalState.nest_stk = 0
            JSVMEvalState.nest_frm = 0
            // Restore compiler tables for parent eval
            IfCondition And(NotEqual(JSVMEvalState.nest_func_bak, 0), GreaterThan(JSVMEvalState.nest_func_n, 0)) ThenBlock: {
                fsz_r = Multiply(JSVMEvalState.nest_func_n, 56)
                IfCondition GreaterThan(fsz_r, JSVMEvalState.func_cap) ThenBlock: {
                    fsz_r = JSVMEvalState.func_cap
                }
                IfCondition NotEqual(JSCompState.func_pool, 0) ThenBlock: {
                    MemoryCopy(JSCompState.func_pool, JSVMEvalState.nest_func_bak, fsz_r)
                }
                Deallocate(JSVMEvalState.nest_func_bak, fsz_r)
                JSCompState.func_count = JSVMEvalState.nest_func_n
            }
            JSVMEvalState.nest_func_bak = 0
            IfCondition And(NotEqual(JSVMEvalState.nest_str_bak, 0), GreaterThan(JSVMEvalState.nest_str_pos, 0)) ThenBlock: {
                IfCondition NotEqual(JSCompState.str_buf, 0) ThenBlock: {
                    MemoryCopy(JSCompState.str_buf, JSVMEvalState.nest_str_bak, JSVMEvalState.nest_str_pos)
                }
                Deallocate(JSVMEvalState.nest_str_bak, JSVMEvalState.nest_str_pos)
                JSCompState.str_pos = JSVMEvalState.nest_str_pos
            }
            JSVMEvalState.nest_str_bak = 0
            // depth was 2 during nested; restore to 1
            JSVMEvalState.depth = 1
            JSComp_SetEvalMode(1)
            // Rebuild const cache for restored pool
            IfCondition GreaterThan(JSVMState.const_count, 0) ThenBlock: {
                IfCondition LessEqual(JSVMState.const_count, JSVMConst.MAX_CONSTS) ThenBlock: {
                    JSVMState.const_vals = JSVMState.cv_buf
                    MemorySet(JSVMState.const_vals, 0, Multiply(JSVMState.const_count, 8))
                }
            }
            ReturnValue(0)
        }
        ReturnValue(JSVM_Eval__RestoreOuter())
    }
}

Function.JSVM_Eval__RestoreOuter {
    Output: Integer
    Body: {
        // Always clear eval dyn-binding state (callers may early-return)
        JSVMEvalState.depth = 0
        JSVMEvalState.caller_env = 0
        JSVMEvalState.preexist = 0
        JSVMEvalState.eval_var_env = 0
        JSVMEvalState.param_init = 0
        JSVMEvalState.param_init_arrow = 0
        JSVMEvalState.param_formals = 0
        // Put outer buffers back — MUST use saved outer pointers, not
        // JSVMState.code/const_pool (those may be permanent own_c/own_p).
        IfCondition GreaterThan(JSVMEvalState.save_code_len, 0) ThenBlock: {
            IfCondition NotEqual(JSVMEvalState.save_code_ptr, 0) ThenBlock: {
                MemoryCopy(JSVMEvalState.save_code_ptr, JSVMEvalState.code_bak, JSVMEvalState.save_code_len)
            }
        }
        IfCondition GreaterThan(JSVMEvalState.save_const_n, 0) ThenBlock: {
            csz = Multiply(JSVMEvalState.save_const_n, 16)
            IfCondition NotEqual(JSVMEvalState.save_const_ptr, 0) ThenBlock: {
                MemoryCopy(JSVMEvalState.save_const_ptr, JSVMEvalState.const_bak, csz)
            }
        }

        // Point VM back at outer image
        IfCondition NotEqual(JSVMEvalState.save_code_ptr, 0) ThenBlock: {
            JSVMState.code = JSVMEvalState.save_code_ptr
        }
        IfCondition NotEqual(JSVMEvalState.save_const_ptr, 0) ThenBlock: {
            JSVMState.const_pool = JSVMEvalState.save_const_ptr
        }
        JSVMState.code_len = JSVMEvalState.save_code_len
        JSVMState.const_count = JSVMEvalState.save_const_n
        JSVMState.pc = JSVMEvalState.save_pc
        JSVMState.sp = JSVMEvalState.save_sp
        JSVMState.fp = JSVMEvalState.save_fp
        JSVMState.halted = JSVMEvalState.save_halted
        JSVMState.error = JSVMEvalState.save_error
        JSVMState.steps = JSVMEvalState.save_steps
        JSVMState.exc_sp = JSVMEvalState.save_exc_sp
        JSVMState.is_strict = JSVMEvalState.save_strict

        stk_sz = Multiply(JSVMEvalState.save_sp, 8)
        IfCondition GreaterThan(stk_sz, 0) ThenBlock: {
            MemoryCopy(JSVMState.stack, JSVMEvalState.stk_bak, stk_sz)
        }
        frm_sz = Multiply(JSVMEvalState.save_fp, JSVMConst.FRAME_SIZE)
        IfCondition GreaterThan(frm_sz, 0) ThenBlock: {
            MemoryCopy(JSVMState.frames, JSVMEvalState.frm_bak, frm_sz)
        }

        // Restore func_pool so outer CLOSURE descriptors are intact
        fsz_need = Multiply(JSVMEvalState.save_func_n, 56)
        IfCondition GreaterThan(fsz_need, JSVMEvalState.func_cap) ThenBlock: {
            fsz_need = JSVMEvalState.func_cap
        }
        IfCondition And(NotEqual(JSCompState.func_pool, 0), GreaterThan(fsz_need, 0)) ThenBlock: {
            MemoryCopy(JSCompState.func_pool, JSVMEvalState.func_bak, fsz_need)
        }
        JSCompState.func_count = JSVMEvalState.save_func_n

        // Rebuild const value cache for restored pool
        IfCondition GreaterThan(JSVMState.const_count, 0) ThenBlock: {
            IfCondition LessEqual(JSVMState.const_count, JSVMConst.MAX_CONSTS) ThenBlock: {
                JSVMState.const_vals = JSVMState.cv_buf
                MemorySet(JSVMState.const_vals, 0, Multiply(JSVMState.const_count, 8))
            }
        }

        JSComp_SetEvalMode(0)
        // M82: restore outer script_env after class/for-of FRESH_LET_ENV at fp==0
        JSVMClosure.script_env = JSVMEvalState.save_script_env
        // M83: restore compiler string table so outer STRING const payloads are valid
        IfCondition And(NotEqual(JSCompState.str_buf, 0), GreaterThan(JSVMEvalState.save_str_pos, 0)) ThenBlock: {
            ssz_r = JSVMEvalState.save_str_pos
            IfCondition GreaterThan(ssz_r, JSVMEvalState.str_cap) ThenBlock: {
                ssz_r = JSVMEvalState.str_cap
            }
            IfCondition And(NotEqual(JSVMEvalState.str_bak, 0), GreaterThan(ssz_r, 0)) ThenBlock: {
                MemoryCopy(JSCompState.str_buf, JSVMEvalState.str_bak, ssz_r)
            }
        }
        JSCompState.str_pos = JSVMEvalState.save_str_pos
        ReturnValue(0)
    }
}

// M83: clone STRING (and optionally FUNCTION) payloads that live in str_buf/func_pool.
// strings=1: permanent C strings for prop keys + LoadConst
// funcs=1: permanent 56-byte func descriptors (own_const only; live pool keeps func_pool)
Function.JSVM_Eval__DeepOwnConst {
    Input: pool: Address
    Input: count: Integer
    Input: do_strings: Integer
    Input: do_funcs: Integer
    Output: Integer
    Body: {
        save_p = pool
        save_n = count
        save_ds = do_strings
        save_df = do_funcs
        IfCondition Or(EqualTo(save_p, 0), LessEqual(save_n, 0)) ThenBlock: {
            ReturnValue(0)
        }
        i = 0
        WhileLoop LessThan(i, save_n) {
            base = Add(save_p, Multiply(i, 16))
            ctype = Dereference(base)
            // type 2 = STRING — payload is C string pointer into str_buf
            IfCondition And(EqualTo(save_ds, 1), EqualTo(ctype, 2)) ThenBlock: {
                sptr = Dereference(Add(base, 8))
                IfCondition NotEqual(sptr, 0) ThenBlock: {
                    sl = JSVM__CStrLen(sptr)
                    perm = Allocate(Add(sl, 1))
                    IfCondition NotEqual(perm, 0) ThenBlock: {
                        IfCondition GreaterThan(sl, 0) ThenBlock: {
                            MemoryCopy(perm, sptr, sl)
                        }
                        SetByte(perm, sl, 0)
                        StoreValue(Add(base, 8), perm)
                    }
                }
            }
            // type 3 = FUNCTION — payload is 56-byte compiler func descriptor
            IfCondition And(EqualTo(save_df, 1), EqualTo(ctype, 3)) ThenBlock: {
                fsrc = Dereference(Add(base, 8))
                IfCondition NotEqual(fsrc, 0) ThenBlock: {
                    fperm = Allocate(56)
                    IfCondition NotEqual(fperm, 0) ThenBlock: {
                        MemoryCopy(fperm, fsrc, 56)
                        nptr = Dereference(Add(fperm, 24))
                        nlen = Dereference(Add(fperm, 32))
                        IfCondition And(NotEqual(nptr, 0), GreaterThan(nlen, 0)) ThenBlock: {
                            nperm = Allocate(Add(nlen, 1))
                            IfCondition NotEqual(nperm, 0) ThenBlock: {
                                MemoryCopy(nperm, nptr, nlen)
                                SetByte(nperm, nlen, 0)
                                StoreValue(Add(fperm, 24), nperm)
                            }
                        }
                        StoreValue(Add(base, 8), fperm)
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// M128k: SuperCall = CALL whose callee is SUPER_EXPR (super(...args))
Function.JSVM_Eval__ContainsSuperCall {
    Input: root: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(root, 0) ThenBlock: { ReturnValue(0) }
        wstk = Allocate(2048)
        MemorySet(wstk, 0, 2048)
        wsp = 0
        StoreValue(wstk, root)
        wsp = 1
        WhileLoop GreaterThan(wsp, 0) {
            wsp = Subtract(wsp, 1)
            nd = Dereference(Add(wstk, Multiply(wsp, 8)))
            IfCondition GreaterEqual(nd, 0) ThenBlock: {
                nt = JSParse_GetType(nd)
                // CALL = 15, SUPER_EXPR = 53
                IfCondition EqualTo(nt, 15) ThenBlock: {
                    ch = JSParse_GetLeft(nd)
                    IfCondition GreaterEqual(ch, 0) ThenBlock: {
                        IfCondition EqualTo(JSParse_GetType(ch), 53) ThenBlock: {
                            Deallocate(wstk, 2048)
                            ReturnValue(1)
                        }
                    }
                }
                skip_kids = 0
                IfCondition EqualTo(nt, ASTType.FUNC_EXPR) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(nt, ASTType.FUNC_DECL) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(nt, ASTType.ARROW_EXPR) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(nt, ASTType.GEN_FUNC_DECL) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(nt, ASTType.GEN_FUNC_EXPR) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(nt, ASTType.ASYNC_FUNC_DECL) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(nt, ASTType.ASYNC_FUNC_EXPR) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(nt, ASTType.CLASS_DECL) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(nt, ASTType.CLASS_EXPR) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(skip_kids, 0) ThenBlock: {
                    ch = JSParse_GetLeft(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    ch = JSParse_GetRight(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    ch = JSParse_GetBody(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    ch = JSParse_GetCond(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    ch = JSParse_GetNext(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                } ElseBlock: {
                    ch = JSParse_GetNext(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                }
            }
        }
        Deallocate(wstk, 2048)
        ReturnValue(0)
    }
}

// M128e7o: ContainsArguments of eval ScriptBody (field-initializer early error).
// Recurses into nested functions/arrows (unlike super/new.target meta walk).
Function.JSVM_Eval__ContainsArguments {
    Input: root: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(root, 0) ThenBlock: { ReturnValue(0) }
        wstk = Allocate(2048)
        MemorySet(wstk, 0, 2048)
        wsp = 0
        StoreValue(wstk, root)
        wsp = 1
        WhileLoop GreaterThan(wsp, 0) {
            wsp = Subtract(wsp, 1)
            nd = Dereference(Add(wstk, Multiply(wsp, 8)))
            IfCondition GreaterEqual(nd, 0) ThenBlock: {
                nt = JSParse_GetType(nd)
                // IDENT = 18; name "arguments" (9 chars)
                IfCondition EqualTo(nt, 18) ThenBlock: {
                    nl = JSParse_GetNameLen(nd)
                    IfCondition EqualTo(nl, 9) ThenBlock: {
                        np = JSParse_GetNamePtr(nd)
                        IfCondition GreaterThan(np, 0) ThenBlock: {
                            IfCondition And(EqualTo(GetByte(np, 0), 97), EqualTo(GetByte(np, 1), 114)) ThenBlock: {
                                IfCondition And(EqualTo(GetByte(np, 2), 103), EqualTo(GetByte(np, 3), 117)) ThenBlock: {
                                    IfCondition And(EqualTo(GetByte(np, 4), 109), EqualTo(GetByte(np, 5), 101)) ThenBlock: {
                                        IfCondition And(EqualTo(GetByte(np, 6), 110), EqualTo(GetByte(np, 7), 116)) ThenBlock: {
                                            IfCondition EqualTo(GetByte(np, 8), 115) ThenBlock: {
                                                Deallocate(wstk, 2048)
                                                ReturnValue(1)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // Descend all children including nested function bodies
                ch = JSParse_GetLeft(nd)
                IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                    StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                    wsp = Add(wsp, 1)
                }
                ch = JSParse_GetRight(nd)
                IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                    StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                    wsp = Add(wsp, 1)
                }
                ch = JSParse_GetBody(nd)
                IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                    StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                    wsp = Add(wsp, 1)
                }
                ch = JSParse_GetCond(nd)
                IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                    StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                    wsp = Add(wsp, 1)
                }
                ch = JSParse_GetNext(nd)
                IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                    StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                    wsp = Add(wsp, 1)
                }
            }
        }
        Deallocate(wstk, 2048)
        ReturnValue(0)
    }
}

// M128b: walk AST for SUPER_EXPR and/or NEW_TARGET (eval early errors).
// want: 1=super, 2=new.target, 3=either
Function.JSVM_Eval__ContainsForbiddenMeta {
    Input: root: Integer
    Input: want: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(root, 0) ThenBlock: { ReturnValue(0) }
        save_want = want
        wstk = Allocate(2048)
        MemorySet(wstk, 0, 2048)
        wsp = 0
        StoreValue(wstk, root)
        wsp = 1
        WhileLoop GreaterThan(wsp, 0) {
            wsp = Subtract(wsp, 1)
            nd = Dereference(Add(wstk, Multiply(wsp, 8)))
            IfCondition GreaterEqual(nd, 0) ThenBlock: {
                nt = JSParse_GetType(nd)
                hit = 0
                // want: 1=super only, 2=new.target only, 3=either
                IfCondition EqualTo(nt, ASTType.SUPER_EXPR) ThenBlock: {
                    IfCondition Or(EqualTo(save_want, 1), EqualTo(save_want, 3)) ThenBlock: { hit = 1 }
                }
                IfCondition EqualTo(nt, ASTType.NEW_TARGET) ThenBlock: {
                    IfCondition Or(EqualTo(save_want, 2), EqualTo(save_want, 3)) ThenBlock: { hit = 1 }
                }
                IfCondition EqualTo(hit, 1) ThenBlock: {
                    Deallocate(wstk, 2048)
                    ReturnValue(1)
                }
                // Do not descend into nested function/class bodies
                skip_kids = 0
                IfCondition EqualTo(nt, ASTType.FUNC_EXPR) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(nt, ASTType.FUNC_DECL) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(nt, ASTType.ARROW_EXPR) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(nt, ASTType.GEN_FUNC_DECL) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(nt, ASTType.GEN_FUNC_EXPR) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(nt, ASTType.ASYNC_FUNC_DECL) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(nt, ASTType.ASYNC_FUNC_EXPR) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(nt, ASTType.CLASS_DECL) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(nt, ASTType.CLASS_EXPR) ThenBlock: { skip_kids = 1 }
                IfCondition EqualTo(skip_kids, 0) ThenBlock: {
                    ch = JSParse_GetLeft(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    ch = JSParse_GetRight(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    ch = JSParse_GetBody(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    ch = JSParse_GetCond(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                    ch = JSParse_GetNext(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                } ElseBlock: {
                    ch = JSParse_GetNext(nd)
                    IfCondition And(GreaterEqual(ch, 0), LessThan(wsp, 256)) ThenBlock: {
                        StoreValue(Add(wstk, Multiply(wsp, 8)), ch)
                        wsp = Add(wsp, 1)
                    }
                }
            }
        }
        Deallocate(wstk, 2048)
        ReturnValue(0)
    }
}

// Native entry: eval(code) from arg_buf
Function.JSVM_EvalNative {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessEqual(save_argc, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        arg0 = Dereference(save_args)
        // Non-string: ToString then eval (spec: if not string return as-is for direct... 
        // actually ES: if not String type, return arg unchanged)
        a0t = JSRT_GetType(arg0)
        IfCondition NotEqual(a0t, JSType.STRING) ThenBlock: {
            ReturnValue(arg0)
        }
        sptr = JSRT_GetPayload(arg0)
        IfCondition EqualTo(sptr, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        // M31a: JS strings are UTF-16 headered; lexer wants C/byte source.
        // Flatten code units to a temporary Latin-1 buffer (BMP-only for now).
        slen = JSRT_StrLen(sptr)
        cbuf = JSRT__StrSlabAlloc(Add(slen, 1))
        IfCondition EqualTo(cbuf, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        ci = 0
        WhileLoop LessThan(ci, slen) {
            u = JSRT_StrUnit(sptr, ci)
            IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
            SetByte(cbuf, ci, u)
            ci = Add(ci, 1)
        }
        SetByte(cbuf, slen, 0)
        ReturnValue(JSVM_EvalSource(cbuf, slen))
    }
}

// =============================================================================
// M81: Flatten JS value → null-terminated C/Latin-1 buffer (for source build)
// =============================================================================
Function.JSVM__FlattenToCStr {
    Input: val: Address
    Output: Address
    Body: {
        save_v = val
        IfCondition EqualTo(save_v, 0) ThenBlock: {
            empty = JSRT__StrSlabAlloc(1)
            IfCondition NotEqual(empty, 0) ThenBlock: { SetByte(empty, 0, 0) }
            ReturnValue(empty)
        }
        // Already string → flatten units
        sv = save_v
        IfCondition NotEqual(JSRT_GetType(sv), JSType.STRING) ThenBlock: {
            sv = JSRT_ToString(save_v)
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(sv, 0) ThenBlock: {
                empty = JSRT__StrSlabAlloc(1)
                IfCondition NotEqual(empty, 0) ThenBlock: { SetByte(empty, 0, 0) }
                ReturnValue(empty)
            }
        }
        sptr = JSRT_GetPayload(sv)
        IfCondition EqualTo(sptr, 0) ThenBlock: {
            empty = JSRT__StrSlabAlloc(1)
            IfCondition NotEqual(empty, 0) ThenBlock: { SetByte(empty, 0, 0) }
            ReturnValue(empty)
        }
        slen = JSRT_StrLen(sptr)
        cbuf = JSRT__StrSlabAlloc(Add(slen, 1))
        IfCondition EqualTo(cbuf, 0) ThenBlock: { ReturnValue(0) }
        ci = 0
        WhileLoop LessThan(ci, slen) {
            u = JSRT_StrUnit(sptr, ci)
            IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
            SetByte(cbuf, ci, u)
            ci = Add(ci, 1)
        }
        SetByte(cbuf, slen, 0)
        ReturnValue(cbuf)
    }
}

// C strlen for slab buffers
Function.JSVM__CStrLen {
    Input: p: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        WhileLoop And(LessThan(n, 65536), NotEqual(GetByte(p, n), 0)) {
            n = Add(n, 1)
        }
        ReturnValue(n)
    }
}

// =============================================================================
// M81: Function(...args) / new Function(...args)
// Builds "(function(P0,P1,...){\n body \n})" and evals as expression.
// =============================================================================
Function.JSVM_FunctionNative {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        // Collect formal params string and body
        // argc==0: params="", body=""
        // argc==1: params="", body=args[0]
        // argc>=2: params=join(args[0..argc-2], ","), body=args[argc-1]
        params_c = JSRT__StrSlabAlloc(1)
        IfCondition NotEqual(params_c, 0) ThenBlock: { SetByte(params_c, 0, 0) }
        body_c = JSRT__StrSlabAlloc(1)
        IfCondition NotEqual(body_c, 0) ThenBlock: { SetByte(body_c, 0, 0) }

        IfCondition EqualTo(save_argc, 1) ThenBlock: {
            body_c = JSVM__FlattenToCStr(Dereference(save_args))
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(0) }
        }
        IfCondition GreaterThan(save_argc, 1) ThenBlock: {
            // First formal
            params_c = JSVM__FlattenToCStr(Dereference(save_args))
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(params_c, 0) ThenBlock: {
                params_c = JSRT__StrSlabAlloc(1)
                IfCondition NotEqual(params_c, 0) ThenBlock: { SetByte(params_c, 0, 0) }
            }
            // Middle formals with commas
            pi = 1
            WhileLoop LessThan(pi, Subtract(save_argc, 1)) {
                next_c = JSVM__FlattenToCStr(Dereference(Add(save_args, Multiply(pi, 8))))
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(next_c, 0) ThenBlock: {
                    next_c = JSRT__StrSlabAlloc(1)
                    IfCondition NotEqual(next_c, 0) ThenBlock: { SetByte(next_c, 0, 0) }
                }
                // params_c = params_c + "," + next_c
                pn = JSVM__CStrLen(params_c)
                nn = JSVM__CStrLen(next_c)
                nbuf = JSRT__StrSlabAlloc(Add(Add(pn, nn), 2))
                IfCondition NotEqual(nbuf, 0) ThenBlock: {
                    MemoryCopy(nbuf, params_c, pn)
                    SetByte(nbuf, pn, 44)
                    MemoryCopy(Add(nbuf, Add(pn, 1)), next_c, nn)
                    SetByte(nbuf, Add(Add(pn, nn), 1), 0)
                    params_c = nbuf
                }
                pi = Add(pi, 1)
            }
            body_c = JSVM__FlattenToCStr(Dereference(Add(save_args, Multiply(Subtract(save_argc, 1), 8))))
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(body_c, 0) ThenBlock: {
                body_c = JSRT__StrSlabAlloc(1)
                IfCondition NotEqual(body_c, 0) ThenBlock: { SetByte(body_c, 0, 0) }
            }
        }

        // source = "(function(" + params + "){\n" + body + "\n})"
        // prefix "(function(" = 10, "){\n" = 3, "\n})" = 3 → +16
        pn2 = JSVM__CStrLen(params_c)
        bn2 = JSVM__CStrLen(body_c)
        total = Add(Add(pn2, bn2), 20)
        src = JSRT__StrSlabAlloc(total)
        IfCondition EqualTo(src, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        // "(function("
        SetByte(src, 0, 40)
        SetByte(src, 1, 102)
        SetByte(src, 2, 117)
        SetByte(src, 3, 110)
        SetByte(src, 4, 99)
        SetByte(src, 5, 116)
        SetByte(src, 6, 105)
        SetByte(src, 7, 111)
        SetByte(src, 8, 110)
        SetByte(src, 9, 40)
        pos = 10
        IfCondition GreaterThan(pn2, 0) ThenBlock: {
            MemoryCopy(Add(src, pos), params_c, pn2)
            pos = Add(pos, pn2)
        }
        // "){\n"
        SetByte(src, pos, 41)
        SetByte(src, Add(pos, 1), 123)
        SetByte(src, Add(pos, 2), 10)
        pos = Add(pos, 3)
        IfCondition GreaterThan(bn2, 0) ThenBlock: {
            MemoryCopy(Add(src, pos), body_c, bn2)
            pos = Add(pos, bn2)
        }
        // "\n})"
        SetByte(src, pos, 10)
        SetByte(src, Add(pos, 1), 125)
        SetByte(src, Add(pos, 2), 41)
        SetByte(src, Add(pos, 3), 0)
        src_len = Add(pos, 3)

        fn = JSVM_EvalSource(src, src_len)
        // M128e6ae: Function() must surface eval/compile SyntaxError (strict+with)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(JSRT_GetType(fn), JSType.FUNCTION) ThenBlock: {
            // Compile failed without exc_prop — still throw SyntaxError
            terr_fn = JSVM_CreateTypedError("SyntaxError", "Invalid Function body")
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr_fn
            JSVM__SetGlobal("__pend_exc__", terr_fn)
            ReturnValue(0)
        }
        // Ensure [[Prototype]] is Function.prototype
        IfCondition NotEqual(JSRTState.function_proto, 0) ThenBlock: {
            JSRT_FuncPropSet(fn, "__proto__", JSRTState.function_proto)
        }
        // name default "anonymous" if empty
        nm = JSRT_FuncPropGet(fn, "name")
        set_anon = 0
        IfCondition EqualTo(nm, 0) ThenBlock: { set_anon = 1 }
        IfCondition EqualTo(nm, JSRTState.undef_val) ThenBlock: { set_anon = 1 }
        IfCondition EqualTo(set_anon, 0) ThenBlock: {
            IfCondition EqualTo(JSRT_GetType(nm), JSType.STRING) ThenBlock: {
                IfCondition EqualTo(JSRT_StrLen(JSRT_GetPayload(nm)), 0) ThenBlock: {
                    set_anon = 1
                }
            }
        }
        IfCondition EqualTo(set_anon, 1) ThenBlock: {
            JSRT_FuncPropSet(fn, "name", JSRT_CreateString("anonymous"))
        }
        ReturnValue(fn)
    }
}
