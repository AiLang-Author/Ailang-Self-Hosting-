// Function.prototype toString, @@hasInstance, and %ThrowTypeError%.
// Dynamic Function/GeneratorFunction/AsyncFunction source lives here too.
// No FixedPool — scratch is JSVMEvalState and JSBridgeTmp.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// Throw TypeError from a native and return undefined. The CALL path rethrows.
Function.JSVM__FnProtoThrow {
    Input: msg: Address
    Output: Address
    Body: {
        JSBridgeTmp.name_ptr = msg
        JSBridgeTmp.val = JSVM_CreateTypedError("TypeError", JSBridgeTmp.name_ptr)
        JSVMCall.exc_prop = 1
        JSVMCall.thrown_val = JSBridgeTmp.val
        JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.val)
        ReturnValue(JSRT_Undefined())
    }
}

// "function () { [native code] }" — bound functions, callable proxies, builtins.
Function.JSVM__NativeFnString {
    Output: Address
    Body: {
        ReturnValue(JSRT_CreateString("function () { [native code] }"))
    }
}

Function.JSVM__FnToString {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.obj = JSVM__GetGlobal("this")
        IfCondition EqualTo(JSVM__IsProxy(JSBridgeTmp.obj), 1) ThenBlock: {
            JSBridgeTmp.val = JSRT_ObjGet(JSBridgeTmp.obj, "__proxy_callable__")
            JSBridgeTmp.found = JSRT_GetType(JSBridgeTmp.val)
            IfCondition And(EqualTo(JSBridgeTmp.found, JSType.BOOLEAN), NotEqual(JSBridgeTmp.val, JSRTState.false_val)) ThenBlock: {
                ReturnValue(JSVM__NativeFnString())
            }
            ReturnValue(JSVM__FnProtoThrow("Function.prototype.toString requires a callable"))
        }
        JSBridgeTmp.found = JSRT_GetType(JSBridgeTmp.obj)
        IfCondition NotEqual(JSBridgeTmp.found, JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSVM__FnProtoThrow("Function.prototype.toString requires a function"))
        }
        JSBridgeTmp.idx = JSRT_FuncGetBC(JSBridgeTmp.obj)
        // FUNC_BOUND bytecode is -(198+1).
        IfCondition EqualTo(JSBridgeTmp.idx, -199) ThenBlock: {
            ReturnValue(JSVM__NativeFnString())
        }
        JSBridgeTmp.addr = JSRT_GetPayload(JSBridgeTmp.obj)
        IfCondition EqualTo(JSBridgeTmp.addr, 0) ThenBlock: {
            ReturnValue(JSVM__NativeFnString())
        }
        JSBridgeTmp.val = RDMEM_64(JSBridgeTmp.addr, 144)
        JSBridgeTmp.found = JSRT_GetType(JSBridgeTmp.val)
        IfCondition EqualTo(JSBridgeTmp.found, JSType.STRING) ThenBlock: {
            ReturnValue(JSBridgeTmp.val)
        }
        ReturnValue(JSVM__NativeFnString())
    }
}

// OrdinaryHasInstance. Bound functions delegate to InstanceofOperator once.
Function.JSVM__FnHasInstance {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.ptr = args
        JSBridgeTmp.count = argc
        JSBridgeTmp.obj = JSVM__GetGlobal("this")
        JSBridgeTmp.val = JSRT_Undefined()
        IfCondition GreaterThan(JSBridgeTmp.count, 0) ThenBlock: {
            JSBridgeTmp.val = RDMEM_64(JSBridgeTmp.ptr)
        }
        // 1. Not callable → false.
        JSBridgeTmp.found = 0
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.obj)
        IfCondition EqualTo(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: {
            JSBridgeTmp.found = 1
        }
        IfCondition EqualTo(JSVM__IsProxy(JSBridgeTmp.obj), 1) ThenBlock: {
            JSBridgeTmp.addr = JSRT_ObjGet(JSBridgeTmp.obj, "__proxy_callable__")
            JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.addr)
            IfCondition And(EqualTo(JSBridgeTmp.type, JSType.BOOLEAN), NotEqual(JSBridgeTmp.addr, JSRTState.false_val)) ThenBlock: {
                JSBridgeTmp.found = 1
            }
        }
        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        // 2. Bound → instanceof the target (runs @@hasInstance once).
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.obj), JSType.FUNCTION) ThenBlock: {
            JSBridgeTmp.idx = JSRT_FuncGetBC(JSBridgeTmp.obj)
            IfCondition EqualTo(JSBridgeTmp.idx, -199) ThenBlock: {
                JSBridgeTmp.addr = JSRT_FuncGetEnv(JSBridgeTmp.obj)
                JSBridgeTmp.node = JSRT_ObjGet(JSBridgeTmp.addr, "__bt__")
                JSBridgeTmp.cb_val = JSRT_Instanceof(JSBridgeTmp.val, JSBridgeTmp.node)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
                IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
                ReturnValue(JSBridgeTmp.cb_val)
            }
        }
        // 3. V is not an object → false, before reading prototype.
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.val)
        JSBridgeTmp.found = 0
        IfCondition EqualTo(JSBridgeTmp.type, JSType.OBJECT) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSBridgeTmp.type, JSType.ARRAY) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSVM_IsPrimSymbol(JSBridgeTmp.val), 1) ThenBlock: {
            JSBridgeTmp.found = 0
        }
        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        // 4. P = Get(C, "prototype"). Already thrown → stop.
        // The prototype getter is user code. CallFunc reuses JSBridgeTmp.val,
        // which is V, so a getter made [] instanceof C walk the wrong object.
        JSBridge__Push(JSBridgeTmp.val)
        JSBridgeTmp.addr = JSVM__GetProperty(JSBridgeTmp.obj, "prototype")
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.addr)
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
            JSBridge__Pop()
            ReturnValue(JSRT_Undefined())
        }
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            JSBridge__Pop()
            ReturnValue(JSRT_Undefined())
        }
        JSBridgeTmp.addr = JSBridge__Pop()
        // 5. P not an object → TypeError.
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.addr)
        JSBridgeTmp.found = 0
        IfCondition EqualTo(JSBridgeTmp.type, JSType.OBJECT) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSBridgeTmp.type, JSType.ARRAY) ThenBlock: { JSBridgeTmp.found = 1 }
        JSBridge__Push(JSBridgeTmp.addr)
        JSBridgeTmp.len = JSVM_IsPrimSymbol(JSBridgeTmp.addr)
        JSBridgeTmp.addr = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.len, 1) ThenBlock: {
            JSBridgeTmp.found = 0
        }
        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(JSVM__FnProtoThrow("Function has non-object prototype"))
        }
        // 6. Walk [[GetPrototypeOf]]. Start at V's prototype, not V itself.
        // GetProtoSlot clobbers addr, which holds P.
        JSBridgeTmp.idx = 0
        JSBridgeTmp.count = 0
        JSBridgeTmp.type = 0
        WhileLoop And(EqualTo(JSBridgeTmp.type, 0), And(EqualTo(JSBridgeTmp.count, 0), LessThan(JSBridgeTmp.idx, 64))) {
            JSBridge__Push(JSBridgeTmp.addr)
            JSBridgeTmp.ptr = JSBridge__GetProtoSlot(JSBridgeTmp.val, 0)
            JSBridgeTmp.addr = JSBridge__Pop()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                JSBridgeTmp.type = 1
            }
            IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                JSBridgeTmp.type = 1
            }
            IfCondition EqualTo(JSBridgeTmp.type, 0) ThenBlock: {
                JSBridgeTmp.found = JSRT_GetType(JSBridgeTmp.ptr)
                IfCondition Or(EqualTo(JSBridgeTmp.ptr, 0), Or(EqualTo(JSBridgeTmp.found, JSType.NULL), EqualTo(JSBridgeTmp.found, JSType.UNDEFINED))) ThenBlock: {
                    JSBridgeTmp.idx = 64
                } ElseBlock: {
                    JSBridge__Push(JSBridgeTmp.ptr)
                    JSBridge__Push(JSBridgeTmp.addr)
                    JSBridgeTmp.node = JSRT_StrictEqual(JSBridgeTmp.ptr, JSBridgeTmp.addr)
                    JSBridgeTmp.addr = JSBridge__Pop()
                    JSBridgeTmp.ptr = JSBridge__Pop()
                    IfCondition EqualTo(JSBridgeTmp.node, 1) ThenBlock: {
                        JSBridgeTmp.count = 1
                    } ElseBlock: {
                        JSBridgeTmp.val = JSBridgeTmp.ptr
                        JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
                    }
                }
            }
        }
        IfCondition EqualTo(JSBridgeTmp.type, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        ReturnValue(JSRT_CreateBool(JSBridgeTmp.count))
    }
}

Function.JSVM__FnThrowType {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        ReturnValue(JSVM__FnProtoThrow("'caller' and 'arguments' are restricted function properties"))
    }
}

Function.JSVM__DispatchFnProto {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.idx = native_id
        JSBridgeTmp.ptr = args
        JSBridgeTmp.count = argc
        IfCondition EqualTo(JSBridgeTmp.idx, JSNativeID.FUNC_TO_STRING) ThenBlock: {
            ReturnValue(JSVM__FnToString(JSBridgeTmp.ptr, JSBridgeTmp.count))
        }
        IfCondition EqualTo(JSBridgeTmp.idx, JSNativeID.FUNC_HAS_INSTANCE) ThenBlock: {
            ReturnValue(JSVM__FnHasInstance(JSBridgeTmp.ptr, JSBridgeTmp.count))
        }
        IfCondition EqualTo(JSBridgeTmp.idx, JSNativeID.FUNC_THROW_TYPE) ThenBlock: {
            ReturnValue(JSVM__FnThrowType(JSBridgeTmp.ptr, JSBridgeTmp.count))
        }
        ReturnValue(JSRT_Undefined())
    }
}

// One ObjSet. Copies arguments before the call.
Function.JSVM__FnProtoSet {
    Input: obj: Address
    Input: key: Address
    Input: val: Address
    Output: Integer
    Body: {
        JSBridgeTmp.obj = obj
        JSBridgeTmp.name_ptr = key
        JSBridgeTmp.val = val
        JSRT_ObjSet(JSBridgeTmp.obj, JSBridgeTmp.name_ptr, JSBridgeTmp.val)
        ReturnValue(1)
    }
}

// Replace the Object.prototype.toString alias. Also @@hasInstance and the
// shared caller/arguments thrower.
Function.JSVM__InstallFnProto {
    Output: Integer
    Body: {
        JSVMEvalState.scratch_a = JSRTState.function_proto
        IfCondition EqualTo(JSVMEvalState.scratch_a, 0) ThenBlock: {
            ReturnValue(0)
        }
        JSVMEvalState.scratch_b = JSBridge__CreateNativeFunc(JSNativeID.FUNC_TO_STRING, "toString", 0)
        JSVM__FnProtoSet(JSVMEvalState.scratch_a, "toString", JSVMEvalState.scratch_b)
        JSBridge__SetAttrBits(JSVMEvalState.scratch_a, "toString", 5)

        JSVMEvalState.scratch_b = JSBridge__CreateNativeFunc(JSNativeID.FUNC_HAS_INSTANCE, "[Symbol.hasInstance]", 1)
        JSVMEvalState.scratch_c = JSVM_SymbolToKey(JSVMSymbol.hasInstance)
        IfCondition NotEqual(JSVMEvalState.scratch_c, 0) ThenBlock: {
            JSVM__FnProtoSet(JSVMEvalState.scratch_a, JSVMEvalState.scratch_c, JSVMEvalState.scratch_b)
            JSBridge__SetAttrBits(JSVMEvalState.scratch_a, JSVMEvalState.scratch_c, 0)
        }

        // One function object for get and set of both caller and arguments.
        JSVMEvalState.scratch_b = JSBridge__CreateNativeFunc(JSNativeID.FUNC_THROW_TYPE, "ThrowTypeError", 0)
        JSVM__FnProtoSet(JSVMEvalState.scratch_a, "__get_caller", JSVMEvalState.scratch_b)
        JSVM__FnProtoSet(JSVMEvalState.scratch_a, "__set_caller", JSVMEvalState.scratch_b)
        JSVM__FnProtoSet(JSVMEvalState.scratch_a, "__get_arguments", JSVMEvalState.scratch_b)
        JSVM__FnProtoSet(JSVMEvalState.scratch_a, "__set_arguments", JSVMEvalState.scratch_b)
        JSBridge__SetAttrBits(JSVMEvalState.scratch_a, "caller", 4)
        JSBridge__SetAttrBits(JSVMEvalState.scratch_a, "arguments", 4)
        JSVM__FnProtoSet(JSVMEvalState.scratch_a, "caller", JSRTState.undef_val)
        JSVM__FnProtoSet(JSVMEvalState.scratch_a, "arguments", JSRTState.undef_val)
        ReturnValue(1)
    }
}

// " anonymous(" at byte offset off. 10 bytes.
Function.JSVM__WriteAnonymousParen {
    Input: dst: Address
    Input: off: Integer
    Output: Integer
    Body: {
        JSBridgeTmp.ptr = dst
        JSBridgeTmp.len = off
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.len), 0, 32)
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.len), 1, 97)
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.len), 2, 110)
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.len), 3, 111)
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.len), 4, 110)
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.len), 5, 121)
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.len), 6, 109)
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.len), 7, 111)
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.len), 8, 117)
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.len), 9, 115)
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.len), 10, 40)
        ReturnValue(11)
    }
}

// Write the CreateDynamicFunction prefix. Returns its length.
// 0: "function anonymous(" (19)
// 1: "function* anonymous(" (20)
// 2: "async function anonymous(" (25)
// 3: "async function* anonymous(" (26)
Function.JSVM__WriteAnonPrefix {
    Input: dst: Address
    Output: Integer
    Body: {
        JSBridgeTmp.ptr = dst
        JSBridgeTmp.idx = JSVMEvalState.dyn_kind
        JSBridgeTmp.count = 0
        IfCondition Or(EqualTo(JSBridgeTmp.idx, 2), EqualTo(JSBridgeTmp.idx, 3)) ThenBlock: {
            // "async "
            WRMEM_8(JSBridgeTmp.ptr, 0, 97)
            WRMEM_8(JSBridgeTmp.ptr, 1, 115)
            WRMEM_8(JSBridgeTmp.ptr, 2, 121)
            WRMEM_8(JSBridgeTmp.ptr, 3, 110)
            WRMEM_8(JSBridgeTmp.ptr, 4, 99)
            WRMEM_8(JSBridgeTmp.ptr, 5, 32)
            JSBridgeTmp.count = 6
        }
        // "function"
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.count), 0, 102)
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.count), 1, 117)
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.count), 2, 110)
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.count), 3, 99)
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.count), 4, 116)
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.count), 5, 105)
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.count), 6, 111)
        WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.count), 7, 110)
        JSBridgeTmp.count = Add(JSBridgeTmp.count, 8)
        IfCondition Or(EqualTo(JSBridgeTmp.idx, 1), EqualTo(JSBridgeTmp.idx, 3)) ThenBlock: {
            WRMEM_8(Add(JSBridgeTmp.ptr, JSBridgeTmp.count), 0, 42)
            JSBridgeTmp.count = Add(JSBridgeTmp.count, 1)
        }
        JSVM__WriteAnonymousParen(JSBridgeTmp.ptr, JSBridgeTmp.count)
        ReturnValue(Add(JSBridgeTmp.count, 11))
    }
}

// Eval source is "(" + spec toString + ")". Length (no NUL) is left in scratch_n.
// Newline before ")" so a trailing // in the parameters does not eat the close.
Function.JSVM__BuildDynEvalSource {
    Input: params: Address
    Input: body: Address
    Output: Address
    Body: {
        JSVMEvalState.scratch_b = params
        JSVMEvalState.scratch_c = body
        JSVMEvalState.scratch_n = JSVM__CStrLen(JSVMEvalState.scratch_b)
        JSBridgeTmp.count = JSVM__CStrLen(JSVMEvalState.scratch_c)
        JSBridgeTmp.ptr = JSRT__StrSlabAlloc(Add(Add(JSVMEvalState.scratch_n, JSBridgeTmp.count), 48))
        IfCondition EqualTo(JSBridgeTmp.ptr, 0) ThenBlock: {
            JSVMEvalState.scratch_n = 0
            ReturnValue(0)
        }
        JSVMEvalState.scratch_n = JSVM__CStrLen(JSVMEvalState.scratch_b)
        JSBridgeTmp.count = JSVM__CStrLen(JSVMEvalState.scratch_c)
        WRMEM_8(JSBridgeTmp.ptr, 0, 40)
        // WriteAnonPrefix stores its destination in JSBridgeTmp.ptr and its
        // length in JSBridgeTmp.count. Keep the base and the body length.
        JSVMEvalState.scratch_a = JSBridgeTmp.ptr
        JSBridgeTmp.val2 = JSBridgeTmp.count
        JSBridgeTmp.idx = JSVM__WriteAnonPrefix(Add(JSVMEvalState.scratch_a, 1))
        JSBridgeTmp.ptr = JSVMEvalState.scratch_a
        JSBridgeTmp.count = JSBridgeTmp.val2
        JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
        IfCondition GreaterThan(JSVMEvalState.scratch_n, 0) ThenBlock: {
            MemoryCopy(Add(JSBridgeTmp.ptr, JSBridgeTmp.idx), JSVMEvalState.scratch_b, JSVMEvalState.scratch_n)
            JSBridgeTmp.idx = Add(JSBridgeTmp.idx, JSVMEvalState.scratch_n)
        }
        // "\n) {\n"
        JSBridgeTmp.ptr = JSVMEvalState.scratch_a
        JSBridgeTmp.addr = Add(JSBridgeTmp.ptr, JSBridgeTmp.idx)
        WRMEM_8(JSBridgeTmp.addr, 0, 10)
        WRMEM_8(JSBridgeTmp.addr, 1, 41)
        WRMEM_8(JSBridgeTmp.addr, 2, 32)
        WRMEM_8(JSBridgeTmp.addr, 3, 123)
        WRMEM_8(JSBridgeTmp.addr, 4, 10)
        JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 5)
        JSBridgeTmp.count = JSBridgeTmp.val2
        JSBridgeTmp.ptr = JSVMEvalState.scratch_a
        IfCondition GreaterThan(JSBridgeTmp.count, 0) ThenBlock: {
            MemoryCopy(Add(JSBridgeTmp.ptr, JSBridgeTmp.idx), JSVMEvalState.scratch_c, JSBridgeTmp.count)
            JSBridgeTmp.idx = Add(JSBridgeTmp.idx, JSBridgeTmp.count)
        }
        // "\n})"
        JSBridgeTmp.ptr = JSVMEvalState.scratch_a
        JSBridgeTmp.addr = Add(JSBridgeTmp.ptr, JSBridgeTmp.idx)
        WRMEM_8(JSBridgeTmp.addr, 0, 10)
        WRMEM_8(JSBridgeTmp.addr, 1, 125)
        WRMEM_8(JSBridgeTmp.addr, 2, 41)
        WRMEM_8(JSBridgeTmp.addr, 3, 0)
        JSVMEvalState.scratch_n = Add(JSBridgeTmp.idx, 3)
        ReturnValue(JSVMEvalState.scratch_a)
    }
}

// Store the spec toString (eval source without the outer parentheses) at desc+144.
Function.JSVM__StampDynToString {
    Input: fn: Address
    Input: src: Address
    Input: len: Integer
    Output: Integer
    Body: {
        JSBridgeTmp.val = fn
        JSBridgeTmp.ptr = src
        JSBridgeTmp.len = len
        IfCondition LessThan(JSBridgeTmp.len, 2) ThenBlock: {
            ReturnValue(0)
        }
        JSBridge__Push(JSBridgeTmp.val)
        JSBridgeTmp.ptr = Add(JSBridgeTmp.ptr, 1)
        JSBridgeTmp.len = Subtract(JSBridgeTmp.len, 2)
        JSBridgeTmp.obj = JSRT_CreateStringUTF8Len(JSBridgeTmp.ptr, JSBridgeTmp.len)
        JSBridgeTmp.val = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridgeTmp.addr = JSRT_GetPayload(JSBridgeTmp.val)
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        IfCondition And(NotEqual(JSBridgeTmp.addr, 0), NotEqual(JSBridgeTmp.obj, 0)) ThenBlock: {
            WRMEM_64(JSBridgeTmp.addr, 144, JSBridgeTmp.obj)
        }
        ReturnValue(1)
    }
}

// Save dyn_kind across FunctionNative. Nested Function() during param eval restores it.
Function.JSVM__CallDynFn {
    Input: args: Address
    Input: argc: Integer
    Input: kind: Integer
    Output: Address
    Body: {
        JSBridge__Push(JSVMEvalState.dyn_kind)
        JSBridge__Push(args)
        JSBridge__Push(argc)
        JSVMEvalState.dyn_kind = kind
        JSBridgeTmp.count = JSBridge__Pop()
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridgeTmp.val = JSVM_FunctionNative(JSBridgeTmp.ptr, JSBridgeTmp.count)
        JSVMEvalState.dyn_kind = JSBridge__Pop()
        ReturnValue(JSBridgeTmp.val)
    }
}
