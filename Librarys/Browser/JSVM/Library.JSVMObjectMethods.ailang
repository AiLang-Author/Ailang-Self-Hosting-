// =============================================================================
// Object.getOwnPropertySymbols(O)
// Own property keys that are symbols (stored as "@@s<id>" in PropTable).
// Identity via JSVMSymbol.registry populated in JSVM_CreateSymbol.
// =============================================================================
Function.JSVM__NObjGetOwnPropertySymbols {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        result = JSRT_CreateArray()
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(result)
        }
        o = Dereference(save_args)
        ot = JSRT_GetType(o)
        IfCondition Or(EqualTo(ot, JSType.NULL), EqualTo(ot, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(result)
        }
        // ToObject for primitives (mirror assign)
        IfCondition And(NotEqual(ot, JSType.OBJECT), And(NotEqual(ot, JSType.ARRAY), NotEqual(ot, JSType.FUNCTION))) ThenBlock: {
            ab = JSVMCallBuf.buf
            StoreValue(ab, o)
            JSBridge__Push(save_args)
            JSBridge__Push(save_argc)
            JSBridge__Push(result)
            o = JSBridge_Dispatch(JSNativeID.OBJ_CTOR, ab, 1)
            result = JSBridge__Pop()
            save_argc = JSBridge__Pop()
            save_args = JSBridge__Pop()
            ot = JSRT_GetType(o)
        }
        // PropTable of object / function / array side props
        hash = 0
        IfCondition EqualTo(ot, JSType.OBJECT) ThenBlock: {
            hash = Dereference(Add(o, 8))
        }
        IfCondition EqualTo(ot, JSType.FUNCTION) ThenBlock: {
            fdesc = Dereference(Add(o, 8))
            IfCondition NotEqual(fdesc, 0) ThenBlock: {
                hash = Dereference(Add(fdesc, 64))
            }
        }
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            hash = ArrSide_Lookup(o)
        }
        IfCondition EqualTo(hash, 0) ThenBlock: {
            ReturnValue(result)
        }
        raw_keys = PropTable_Keys(hash)
        klen = Array.Size(raw_keys)
        ki = 0
        WhileLoop LessThan(ki, klen) {
            kstr = Array.Get(raw_keys, ki)
            // Symbol keys: "@@s" + digits (64,64,115,...)
            is_sym_key = 0
            IfCondition NotEqual(kstr, 0) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(kstr, 0), 64) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(kstr, 1), 64) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(kstr, 2), 115) ThenBlock: {
                            is_sym_key = 1
                        }
                    }
                }
            }
            IfCondition EqualTo(is_sym_key, 1) ThenBlock: {
                JSBridge__Push(result)
                JSBridge__Push(raw_keys)
                JSBridge__Push(ki)
                JSBridge__Push(klen)
                JSBridge__Push(hash)
                sym = JSRTState.undef_val
                IfCondition NotEqual(JSVMSymbol.registry, 0) ThenBlock: {
                    sym = JSRT_ObjGet(JSVMSymbol.registry, kstr)
                }
                // Fallback: no registry hit — skip (cannot invent identity)
                ok = 0
                IfCondition NotEqual(sym, 0) ThenBlock: {
                    IfCondition NotEqual(sym, JSRTState.undef_val) ThenBlock: {
                        IfCondition EqualTo(JSVM_IsSymbol(sym), 1) ThenBlock: {
                            ok = 1
                        }
                    }
                }
                hash = JSBridge__Pop()
                klen = JSBridge__Pop()
                ki = JSBridge__Pop()
                raw_keys = JSBridge__Pop()
                result = JSBridge__Pop()
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    JSBridge__Push(raw_keys)
                    JSBridge__Push(ki)
                    JSBridge__Push(klen)
                    JSBridge__Push(hash)
                    JSRT_ArrPush(result, sym)
                    hash = JSBridge__Pop()
                    klen = JSBridge__Pop()
                    ki = JSBridge__Pop()
                    raw_keys = JSBridge__Pop()
                }
            }
            ki = Add(ki, 1)
        }
        ReturnValue(result)
    }
}

// =============================================================================
// Object.groupBy(items, callbackfn) — ES2024 array grouping
// Returns null-prototype object mapping key → array of items
// =============================================================================
Function.JSVM__NObjGroupBy {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        // null-proto result
        out = JSRT_CreateObject()
        // Clear default proto if any — Object.create(null) style
        // Engine: set __proto__ to null
        JSRT_ObjSet(out, "__proto__", JSRTState.null_val)
        IfCondition LessThan(save_argc, 2) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object.groupBy requires 2 arguments")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(out)
        }
        items = Dereference(save_args)
        cb = Dereference(Add(save_args, 8))
        IfCondition NotEqual(JSRT_GetType(cb), JSType.FUNCTION) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object.groupBy callback must be a function")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(out)
        }
        // Only Array items for first ship (iterable later)
        IfCondition NotEqual(JSRT_GetType(items), JSType.ARRAY) ThenBlock: {
            // string → treat as array of code units via assign-style later
            IfCondition EqualTo(JSRT_GetType(items), JSType.STRING) ThenBlock: {
                // fall through with length loop below using string
            } ElseBlock: {
                terr = JSVM_CreateTypedError("TypeError", "Object.groupBy items must be iterable")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(out)
            }
        }
        n = 0
        is_str = 0
        IfCondition EqualTo(JSRT_GetType(items), JSType.STRING) ThenBlock: {
            is_str = 1
            sp = JSRT_GetPayload(items)
            n = 0
            IfCondition NotEqual(sp, 0) ThenBlock: { n = JSRT_StrLen(sp) }
        }
        IfCondition EqualTo(is_str, 0) ThenBlock: {
            n = JSRT_ArrLen(items)
        }
        i = 0
        WhileLoop LessThan(i, n) {
            JSBridge__Push(out)
            JSBridge__Push(items)
            JSBridge__Push(cb)
            JSBridge__Push(i)
            JSBridge__Push(n)
            JSBridge__Push(is_str)
            // element
            el = JSRTState.undef_val
            IfCondition EqualTo(is_str, 1) ThenBlock: {
                sp2 = JSRT_GetPayload(items)
                el = JSRT_CreateStringSlice(sp2, i, 1)
            }
            IfCondition EqualTo(is_str, 0) ThenBlock: {
                el = JSRT_ArrGet(items, i)
            }
            // callback(el, i)
            ab = JSVMCallBuf.buf
            StoreValue(ab, el)
            StoreValue(Add(ab, 8), JSRT_CreateNumber(i))
            save_this = JSVM__GetGlobal("this")
            JSVM__SetGlobal("this", JSRTState.undef_val)
            key_v = JSVM__CallFunc(cb, ab, 2)
            JSVM__SetGlobal("this", save_this)
            is_str = JSBridge__Pop()
            n = JSBridge__Pop()
            i = JSBridge__Pop()
            cb = JSBridge__Pop()
            items = JSBridge__Pop()
            out = JSBridge__Pop()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                ReturnValue(out)
            }
            // ToPropertyKey(key_v)
            JSBridge__Push(out)
            JSBridge__Push(items)
            JSBridge__Push(cb)
            JSBridge__Push(i)
            JSBridge__Push(n)
            JSBridge__Push(is_str)
            JSBridge__Push(el)
            kptr = JSVM_ToPropertyKey(key_v)
            el = JSBridge__Pop()
            is_str = JSBridge__Pop()
            n = JSBridge__Pop()
            i = JSBridge__Pop()
            cb = JSBridge__Pop()
            items = JSBridge__Pop()
            out = JSBridge__Pop()
            IfCondition EqualTo(kptr, 0) ThenBlock: {
                kptr = ""
            }
            // bucket array
            JSBridge__Push(out)
            JSBridge__Push(items)
            JSBridge__Push(cb)
            JSBridge__Push(i)
            JSBridge__Push(n)
            JSBridge__Push(is_str)
            JSBridge__Push(el)
            JSBridge__Push(kptr)
            bucket = JSRT_ObjGet(out, kptr)
            kptr = JSBridge__Pop()
            el = JSBridge__Pop()
            is_str = JSBridge__Pop()
            n = JSBridge__Pop()
            i = JSBridge__Pop()
            cb = JSBridge__Pop()
            items = JSBridge__Pop()
            out = JSBridge__Pop()
            IfCondition NotEqual(JSRT_GetType(bucket), JSType.ARRAY) ThenBlock: {
                JSBridge__Push(out)
                JSBridge__Push(items)
                JSBridge__Push(cb)
                JSBridge__Push(i)
                JSBridge__Push(n)
                JSBridge__Push(is_str)
                JSBridge__Push(el)
                JSBridge__Push(kptr)
                bucket = JSRT_CreateArray()
                kptr = JSBridge__Pop()
                el = JSBridge__Pop()
                is_str = JSBridge__Pop()
                n = JSBridge__Pop()
                i = JSBridge__Pop()
                cb = JSBridge__Pop()
                items = JSBridge__Pop()
                out = JSBridge__Pop()
                JSBridge__Push(out)
                JSBridge__Push(items)
                JSBridge__Push(cb)
                JSBridge__Push(i)
                JSBridge__Push(n)
                JSBridge__Push(is_str)
                JSBridge__Push(el)
                JSBridge__Push(bucket)
                JSRT_ObjSet(out, kptr, bucket)
                bucket = JSBridge__Pop()
                el = JSBridge__Pop()
                is_str = JSBridge__Pop()
                n = JSBridge__Pop()
                i = JSBridge__Pop()
                cb = JSBridge__Pop()
                items = JSBridge__Pop()
                out = JSBridge__Pop()
            }
            JSBridge__Push(out)
            JSBridge__Push(items)
            JSBridge__Push(cb)
            JSBridge__Push(i)
            JSBridge__Push(n)
            JSBridge__Push(is_str)
            JSRT_ArrPush(bucket, el)
            is_str = JSBridge__Pop()
            n = JSBridge__Pop()
            i = JSBridge__Pop()
            cb = JSBridge__Pop()
            items = JSBridge__Pop()
            out = JSBridge__Pop()
            i = Add(i, 1)
        }
        ReturnValue(out)
    }
}
