// Library.JSVMOpPart1.ailang — JSVM opcode bodies
// Helpers called from JSVM_Step. Opcodes: JSVM_OpGetLocal, JSVM_OpSetLocal, JSVM_OpGetGlobal, JSVM_OpSetGlobal, JSVM_OpToNumeric, JSVM_OpGetProp.
// Split from the JS engine so one function fits in context.
// FixedPools stay in the parent library. Function names are unchanged
// except for the new helpers this split adds.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// GET_LOCAL (10) — 16-bit operand: local slot index
            // M128e6c/e: free-var SET_FREE updates GlobalHash; stack may lag
            // (generator formal dstr: free += leaves stack at old number).
            // Prefer non-undef GlobalHash when __ls_ maps. Eval-mode class names
            // are not in GlobalHash (lookup -1) so stack wins.
Function.JSVM_OpGetLocal {
    Output: Integer
    Body: {

                slot = JSVM__Read16()
                lval = JSVM__GetLocal(slot)
                IfCondition EqualTo(JSVMState.fp, 0) ThenBlock: {
                    IfCondition And(NotEqual(JSVMClosure.script_env, 0), NotEqual(JSVMClosure.script_env, JSRTState.undef_val)) ThenBlock: {
                        used_nm = 0
                        IfCondition NotEqual(JSVMClosure.slot_names, 0) ThenBlock: {
                            IfCondition LessThan(slot, JSVMClosure.slot_cap) ThenBlock: {
                                nm_g = RDMEM_64(JSVMClosure.slot_names, Multiply(slot, 8))
                                IfCondition NotEqual(nm_g, 0) ThenBlock: {
                                    used_nm = 1
                                    gval = GlobalHash_Lookup(nm_g)
                                    IfCondition NotEqual(gval, -1) ThenBlock: {
                                        IfCondition NotEqual(gval, JSRTState.undef_val) ThenBlock: {
                                            lval = gval
                                        }
                                    }
                                }
                            }
                        }
                        IfCondition EqualTo(used_nm, 1) ThenBlock: {
                        } ElseBlock: {
                        // Build __ls_ + decimal(slot) in getter_buf (no embedded NUL)
                        lsb = JSVMCallBuf.getter_buf
                        WRMEM_8(lsb, 0, 95)
                        WRMEM_8(lsb, 1, 95)
                        WRMEM_8(lsb, 2, 108)
                        WRMEM_8(lsb, 3, 115)
                        WRMEM_8(lsb, 4, 95)
                        sn_tmp = slot
                        digs = 0
                        IfCondition EqualTo(sn_tmp, 0) ThenBlock: {
                            WRMEM_8(lsb, 5, 48)
                            digs = 1
                        } ElseBlock: {
                            WhileLoop GreaterThan(sn_tmp, 0) {
                                WRMEM_8(lsb, Add(32, digs), Add(48, Modulo(sn_tmp, 10)))
                                sn_tmp = Divide(sn_tmp, 10)
                                digs = Add(digs, 1)
                            }
                            ri = 0
                            WhileLoop LessThan(ri, digs) {
                                WRMEM_8(lsb, Add(5, ri), RDMEM_8(lsb, Add(32, Subtract(Subtract(digs, 1), ri))))
                                ri = Add(ri, 1)
                            }
                        }
                        WRMEM_8(lsb, Add(5, digs), 0)
                        nm_ls = JSRT_ObjGet(JSVMClosure.script_env, lsb)
                        IfCondition EqualTo(JSRT_GetType(nm_ls), JSType.STRING) ThenBlock: {
                            gval = GlobalHash_Lookup(JSRT_GetPayload(nm_ls))
                            IfCondition NotEqual(gval, -1) ThenBlock: {
                                IfCondition NotEqual(gval, JSRTState.undef_val) ThenBlock: {
                                    lval = gval
                                }
                            }
                        }
                        }
                    }
                }
                JSVM__StackPush(lval)
                ReturnValue(1)
            
    }
}

// SET_LOCAL (11) — 16-bit operand: local slot index
Function.JSVM_OpSetLocal {
    Output: Integer
    Body: {

                slot = JSVM__Read16()
                sval = JSVM__StackPop()
                JSVM__SetLocal(slot, sval)
                // Non-strict mapped arguments: keep arguments[slot] in sync
                JSVM_SyncLocalToArguments(slot, sval)
                // M128e6n: top-level let/var dual-bind — GET_LOCAL prefers
                // GlobalHash via __ls_<slot>. If SET_GLOBAL was skipped or used
                // a different const-pool key, stack and GlobalHash diverge
                // (`let x=0; x=1` left x at 0). Mirror stack into GlobalHash.
                IfCondition EqualTo(JSVMState.fp, 0) ThenBlock: {
                    IfCondition And(NotEqual(JSVMClosure.script_env, 0), NotEqual(JSVMClosure.script_env, JSRTState.undef_val)) ThenBlock: {
                        used_nm_s = 0
                        IfCondition NotEqual(JSVMClosure.slot_names, 0) ThenBlock: {
                            IfCondition LessThan(slot, JSVMClosure.slot_cap) ThenBlock: {
                                nm_gs = RDMEM_64(JSVMClosure.slot_names, Multiply(slot, 8))
                                IfCondition NotEqual(nm_gs, 0) ThenBlock: {
                                    used_nm_s = 1
                                    JSVM__SetGlobalHash(nm_gs, sval)
                                }
                            }
                        }
                        IfCondition EqualTo(used_nm_s, 1) ThenBlock: {
                        } ElseBlock: {
                        lsb_s = JSVMCallBuf.getter_buf
                        WRMEM_8(lsb_s, 0, 95)
                        WRMEM_8(lsb_s, 1, 95)
                        WRMEM_8(lsb_s, 2, 108)
                        WRMEM_8(lsb_s, 3, 115)
                        WRMEM_8(lsb_s, 4, 95)
                        sn_s = slot
                        digs_s = 0
                        IfCondition EqualTo(sn_s, 0) ThenBlock: {
                            WRMEM_8(lsb_s, 5, 48)
                            digs_s = 1
                        } ElseBlock: {
                            WhileLoop GreaterThan(sn_s, 0) {
                                WRMEM_8(lsb_s, Add(32, digs_s), Add(48, Modulo(sn_s, 10)))
                                sn_s = Divide(sn_s, 10)
                                digs_s = Add(digs_s, 1)
                            }
                            ri_s = 0
                            WhileLoop LessThan(ri_s, digs_s) {
                                WRMEM_8(lsb_s, Add(5, ri_s), RDMEM_8(lsb_s, Add(32, Subtract(Subtract(digs_s, 1), ri_s))))
                                ri_s = Add(ri_s, 1)
                            }
                        }
                        WRMEM_8(lsb_s, Add(5, digs_s), 0)
                        nm_s = JSRT_ObjGet(JSVMClosure.script_env, lsb_s)
                        IfCondition EqualTo(JSRT_GetType(nm_s), JSType.STRING) ThenBlock: {
                            JSVM__SetGlobalHash(JSRT_GetPayload(nm_s), sval)
                        }
                        }
                    }
                }
                ReturnValue(1)
            
    }
}

// GET_GLOBAL (12) — unresolvable binding → ReferenceError (spec GetValue)
            // typeof uses GET_GLOBAL_SOFT (84) instead.
            // M128d: consult with ObjectEnv (GetCurEnv chain) before global.
Function.JSVM_OpGetGlobal {
    Output: Integer
    Body: {

                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                // Arrow this lives on the enclosing env, not the global slot.
                JSBridgeTmp.found = JSVM__ArrowThisReady(cpay)
                IfCondition EqualTo(JSBridgeTmp.found, 2) ThenBlock: {
                    ReturnValue(1)
                }
                IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
                    JSVM__StackPush(JSBridge__Pop())
                    ReturnValue(1)
                }
                // Top-level var is in GlobalHash. Skip the script_env scan when
                // the chain has no let/const mark and no with object.
                skip_env = JSVM__PlainGlobals()
                gval = JSRTState.undef_val
                found_env = 0
                IfCondition EqualTo(skip_env, 0) ThenBlock: {
                env_g = JSVM__GetCurEnv()
                IfCondition And(NotEqual(env_g, 0), NotEqual(env_g, JSRTState.undef_val)) ThenBlock: {
                    // EnvLookup returns undef for miss — distinguish via has walk
                    hops_g = 0
                    ewalk = env_g
                    WhileLoop And(And(NotEqual(ewalk, 0), NotEqual(ewalk, JSRTState.undef_val)), LessThan(hops_g, 64)) {
                        IfCondition EqualTo(JSRT_GetType(ewalk), JSType.OBJECT) ThenBlock: {
                            IfCondition EqualTo(JSRT_ObjHas(ewalk, cpay), 1) ThenBlock: {
                                gval = JSRT_ObjGet(ewalk, cpay)
                                found_env = 1
                                hops_g = 64
                            }
                            IfCondition EqualTo(found_env, 0) ThenBlock: {
                                wog = JSRT_ObjGet(ewalk, "__with__")
                                wtg = JSRT_GetType(wog)
                                IfCondition Or(EqualTo(wtg, JSType.OBJECT), Or(EqualTo(wtg, JSType.FUNCTION), EqualTo(wtg, JSType.ARRAY))) ThenBlock: {
                                    IfCondition EqualTo(JSRT_ObjHasOnChain(wog, cpay), 1) ThenBlock: {
                                        gval = JSRT_ObjGet(wog, cpay)
                                        found_env = 1
                                        hops_g = 64
                                    }
                                }
                            }
                            IfCondition EqualTo(found_env, 0) ThenBlock: {
                                ewalk = JSRT_ObjGet(ewalk, JSVMClosure.parent_key)
                            }
                        } ElseBlock: {
                            ewalk = 0
                        }
                        hops_g = Add(hops_g, 1)
                    }
                }
                }
                IfCondition EqualTo(found_env, 1) ThenBlock: {
                    JSVM__StackPush(gval)
                    ReturnValue(1)
                }
                has_g = JSVM__HasGlobal(cpay)
                IfCondition EqualTo(has_g, 0) ThenBlock: {
                    JSVM_ThrowReferenceError("is not defined")
                    ReturnValue(1)
                }
                gval = JSVM__GetGlobal(cpay)
                // M26e: derived this TDZ (flag — SetGlobal copies so pointer eq fails)
                IfCondition EqualTo(JSVMState.this_tdz, 1) ThenBlock: {
                    // name == "this" (4 chars)
                    is_this_nm = 0
                    IfCondition NotEqual(cpay, 0) ThenBlock: {
                        IfCondition EqualTo(RDMEM_8(cpay, 0), 116) ThenBlock: {
                            IfCondition EqualTo(RDMEM_8(cpay, 1), 104) ThenBlock: {
                                IfCondition EqualTo(RDMEM_8(cpay, 2), 105) ThenBlock: {
                                    IfCondition EqualTo(RDMEM_8(cpay, 3), 115) ThenBlock: {
                                        IfCondition EqualTo(RDMEM_8(cpay, 4), 0) ThenBlock: {
                                            is_this_nm = 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(is_this_nm, 1) ThenBlock: {
                        JSVM_ThrowReferenceError("Must call super constructor in derived class before accessing 'this'")
                        ReturnValue(1)
                    }
                }
                JSVM__StackPush(gval)
                ReturnValue(1)
            
    }
}

// SET_GLOBAL (13) — create-or-update binding (var/func/catch/assign non-strict)
            // M128d: with ObjectEnv PutValue when binding present on with object
Function.JSVM_OpSetGlobal {
    Output: Integer
    Body: {

                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                sval = JSVM__StackPop()
                env_s = JSVM__GetCurEnv()
                hops_s = 0
                ews = env_s
                WhileLoop And(And(NotEqual(ews, 0), NotEqual(ews, JSRTState.undef_val)), LessThan(hops_s, 64)) {
                    IfCondition EqualTo(JSRT_GetType(ews), JSType.OBJECT) ThenBlock: {
                        wos = JSRT_ObjGet(ews, "__with__")
                        wts = JSRT_GetType(wos)
                        IfCondition Or(EqualTo(wts, JSType.OBJECT), Or(EqualTo(wts, JSType.FUNCTION), EqualTo(wts, JSType.ARRAY))) ThenBlock: {
                            IfCondition EqualTo(JSRT_ObjHasOnChain(wos, cpay), 1) ThenBlock: {
                                JSRT_ObjSet(wos, cpay, sval)
                                ReturnValue(1)
                            }
                        }
                        ews = JSRT_ObjGet(ews, JSVMClosure.parent_key)
                    } ElseBlock: {
                        ews = 0
                    }
                    hops_s = Add(hops_s, 1)
                }
                JSVM__SetGlobal(cpay, sval)
                ReturnValue(1)
            
    }
}

// TO_NUMERIC (14) — postfix ++/-- return value; BigInt stays
Function.JSVM_OpToNumeric {
    Output: Integer
    Body: {

                av = JSVM__StackPop()
                result = JSRT__ToNumeric(av)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
                        JSVMCall.exc_prop = 0
                        JSVMCall.thrown_val = 0
                        JSVMState.error = 0
                        JSVMState.halted = 0
                        ReturnValue(1)
                    }
                    pend = JSVMCall.thrown_val
                    IfCondition EqualTo(pend, 0) ThenBlock: {
                        pend = JSVM__GetGlobal("__pend_exc__")
                    }
                    JSVMCall.thrown_val = 0
                    JSVMCall.exc_prop = 0
                    JSVM__SetGlobal("__pend_exc__", JSRTState.undef_val)
                    JSVMState.error = 0
                    JSVMState.halted = 0
                    IfCondition And(NotEqual(pend, 0), NotEqual(pend, JSRTState.undef_val)) ThenBlock: {
                        JSVM_ThrowValue(pend)
                    }
                    ReturnValue(1)
                }
                IfCondition EqualTo(result, 0) ThenBlock: {
                    JSVM__StackPush(JSRT_CreateFloat(9221120237041090560))
                } ElseBlock: {
                    JSVM__StackPush(result)
                }
                ReturnValue(1)
            
    }
}

// GET_PROP (16) — 16-bit operand: constant pool index (property name)
            // Pop object, push object.prop
            // Getter support: if obj has __get_<name>, invoke it.
Function.JSVM_OpGetProp {
    Output: Integer
    Body: {

                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                obj = JSVM__StackPop()

                // Wave 3 D1: null/undefined base → TypeError
                // M26f: null.prototype → null (extends null heritage wiring)
                obj_type = JSRT_GetType(obj)
                IfCondition Or(EqualTo(obj_type, JSType.NULL), EqualTo(obj_type, JSType.UNDEFINED)) ThenBlock: {
                    is_proto_nm = 0
                    IfCondition EqualTo(obj_type, JSType.NULL) ThenBlock: {
                        IfCondition NotEqual(cpay, 0) ThenBlock: {
                            IfCondition EqualTo(RDMEM_8(cpay, 0), 112) ThenBlock: {
                                IfCondition EqualTo(RDMEM_8(cpay, 1), 114) ThenBlock: {
                                    IfCondition EqualTo(RDMEM_8(cpay, 2), 111) ThenBlock: {
                                        IfCondition EqualTo(RDMEM_8(cpay, 3), 116) ThenBlock: {
                                            IfCondition EqualTo(RDMEM_8(cpay, 4), 111) ThenBlock: {
                                                IfCondition EqualTo(RDMEM_8(cpay, 5), 116) ThenBlock: {
                                                    IfCondition EqualTo(RDMEM_8(cpay, 6), 121) ThenBlock: {
                                                        IfCondition EqualTo(RDMEM_8(cpay, 7), 112) ThenBlock: {
                                                            IfCondition EqualTo(RDMEM_8(cpay, 8), 101) ThenBlock: {
                                                                IfCondition EqualTo(RDMEM_8(cpay, 9), 0) ThenBlock: {
                                                                    is_proto_nm = 1
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(is_proto_nm, 1) ThenBlock: {
                        JSVM__StackPush(JSRTState.null_val)
                        ReturnValue(1)
                    }
                    terr = JSVM_CreateTypedError("TypeError", "Cannot read property of null/undefined")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }

                // M26k/k.4/k.10/k.11: private get — mangled #name@id only
                // Class-factory brand: callee __home_proto__ declares the private name;
                // static: receiver must be home; instance methods: function identity.
                IfCondition NotEqual(cpay, 0) ThenBlock: {
                    IfCondition EqualTo(JSVM__IsMangledPrivate(cpay), 1) ThenBlock: {
                        has_pf = 0
                        IfCondition Or(Or(EqualTo(obj_type, JSType.OBJECT), EqualTo(obj_type, JSType.FUNCTION)), EqualTo(obj_type, JSType.ARRAY)) ThenBlock: {
                            home_p = 0
                            IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                                cal_f = RDMEM_64(JSVMClosure.frame_funcs, Multiply(Subtract(JSVMState.fp, 1), 8))
                                IfCondition EqualTo(JSRT_GetType(cal_f), JSType.FUNCTION) ThenBlock: {
                                    home_p = JSRT_FuncPropGet(cal_f, "__home_proto__")
                                }
                            }
                            // M128e7m: direct eval runs at fp=0 — use outer method home
                            IfCondition EqualTo(home_p, 0) ThenBlock: {
                                IfCondition And(EqualTo(JSVMEvalState.is_direct, 1), GreaterThan(JSVMEvalState.save_fp, 0)) ThenBlock: {
                                    IfCondition NotEqual(JSVMClosure.frame_funcs, 0) ThenBlock: {
                                        cal_ev = RDMEM_64(JSVMClosure.frame_funcs, Multiply(Subtract(JSVMEvalState.save_fp, 1), 8))
                                        IfCondition EqualTo(JSRT_GetType(cal_ev), JSType.FUNCTION) ThenBlock: {
                                            home_p = JSRT_FuncPropGet(cal_ev, "__home_proto__")
                                        }
                                    }
                                }
                            }
                            ht = JSRT_GetType(home_p)
                            IfCondition Or(EqualTo(ht, JSType.OBJECT), EqualTo(ht, JSType.FUNCTION)) ThenBlock: {
                                // __get_ key buffer
                                gk_h = JSVMCallBuf.getter_buf
                                WRMEM_8(gk_h, 0, 95)
                                WRMEM_8(gk_h, 1, 95)
                                WRMEM_8(gk_h, 2, 103)
                                WRMEM_8(gk_h, 3, 101)
                                WRMEM_8(gk_h, 4, 116)
                                WRMEM_8(gk_h, 5, 95)
                                gi = 0
                                gdone = 0
                                WhileLoop EqualTo(gdone, 0) {
                                    gb = RDMEM_8(cpay, gi)
                                    WRMEM_8(gk_h, Add(6, gi), gb)
                                    IfCondition EqualTo(gb, 0) ThenBlock: { gdone = 1 }
                                    gi = Add(gi, 1)
                                }
                                // Static brand: home is the constructor FUNCTION
                                // Compare fdesc payloads (JSValue boxes may differ)
                                IfCondition EqualTo(ht, JSType.FUNCTION) ThenBlock: {
                                    home_fd = RDMEM_64(home_p, 8)
                                    recv_fd = 0
                                    IfCondition EqualTo(obj_type, JSType.FUNCTION) ThenBlock: {
                                        recv_fd = RDMEM_64(obj, 8)
                                    }
                                    IfCondition EqualTo(JSRT_ObjHas(home_p, cpay), 1) ThenBlock: {
                                        IfCondition NotEqual(recv_fd, home_fd) ThenBlock: {
                                            terr = JSVM_CreateTypedError("TypeError", "Cannot read private member")
                                            JSVM_ThrowValue(terr)
                                            ReturnValue(1)
                                        }
                                        has_pf = 1
                                    }
                                    IfCondition EqualTo(JSRT_ObjHas(home_p, gk_h), 1) ThenBlock: {
                                        IfCondition NotEqual(recv_fd, home_fd) ThenBlock: {
                                            terr = JSVM_CreateTypedError("TypeError", "Cannot read private member")
                                            JSVM_ThrowValue(terr)
                                            ReturnValue(1)
                                        }
                                        has_pf = 1
                                    }
                                    // M128e7g: static setter-only private accessor
                                    IfCondition EqualTo(JSRT_ObjHas(home_p, gk_h), 0) ThenBlock: {
                                        WRMEM_8(gk_h, 0, 95)
                                        WRMEM_8(gk_h, 1, 95)
                                        WRMEM_8(gk_h, 2, 115)
                                        WRMEM_8(gk_h, 3, 101)
                                        WRMEM_8(gk_h, 4, 116)
                                        WRMEM_8(gk_h, 5, 95)
                                        si_s = 0
                                        sdone_s = 0
                                        WhileLoop EqualTo(sdone_s, 0) {
                                            sb_s = RDMEM_8(cpay, si_s)
                                            WRMEM_8(gk_h, Add(6, si_s), sb_s)
                                            IfCondition EqualTo(sb_s, 0) ThenBlock: { sdone_s = 1 }
                                            si_s = Add(si_s, 1)
                                        }
                                        IfCondition EqualTo(JSRT_ObjHas(home_p, gk_h), 1) ThenBlock: {
                                            IfCondition EqualTo(JSRT_ObjHas(obj, cpay), 0) ThenBlock: {
                                                IfCondition EqualTo(recv_fd, home_fd) ThenBlock: {
                                                    terr = JSVM_CreateTypedError("TypeError", "Cannot read private accessor without getter")
                                                    JSVM_ThrowValue(terr)
                                                    ReturnValue(1)
                                                }
                                            }
                                        }
                                    }
                                }
                                // Instance: brand = same private method function as home
                                // (fdesc identity). Own install at construct enables exotic
                                // returns + double-init TypeError; multi-eval brands differ.
                                IfCondition EqualTo(ht, JSType.OBJECT) ThenBlock: {
                                    IfCondition EqualTo(JSRT_ObjHas(home_p, cpay), 1) ThenBlock: {
                                        home_meth = JSRT_ObjGet(home_p, cpay)
                                        IfCondition EqualTo(JSRT_GetType(home_meth), JSType.FUNCTION) ThenBlock: {
                                            // M128e7q: brand requires OWN install on instance.
                                            // ObjGet walks [[Prototype]] so proto method would
                                            // false-brand before super returns (before-super tests).
                                            brand_ok = 0
                                            IfCondition EqualTo(JSRT_ObjHas(obj, cpay), 1) ThenBlock: {
                                                chain_meth = JSRT_ObjGet(obj, cpay)
                                                IfCondition EqualTo(chain_meth, home_meth) ThenBlock: {
                                                    brand_ok = 1
                                                } ElseBlock: {
                                                    IfCondition EqualTo(JSRT_GetType(chain_meth), JSType.FUNCTION) ThenBlock: {
                                                        hm_fd = RDMEM_64(home_meth, 8)
                                                        cm_fd = RDMEM_64(chain_meth, 8)
                                                        IfCondition And(NotEqual(hm_fd, 0), EqualTo(hm_fd, cm_fd)) ThenBlock: {
                                                            brand_ok = 1
                                                        }
                                                    }
                                                }
                                            }
                                            IfCondition EqualTo(brand_ok, 0) ThenBlock: {
                                                terr = JSVM_CreateTypedError("TypeError", "Cannot read private member")
                                                JSVM_ThrowValue(terr)
                                                ReturnValue(1)
                                            }
                                            JSVM__StackPush(home_meth)
                                            ReturnValue(1)
                                        }
                                    }
                                    IfCondition EqualTo(JSRT_ObjHas(home_p, gk_h), 1) ThenBlock: {
                                        home_get = JSRT_ObjGet(home_p, gk_h)
                                        IfCondition EqualTo(JSRT_GetType(home_get), JSType.FUNCTION) ThenBlock: {
                                            // M128e7q: own install required (see private method brand)
                                            brand_ok_g = 0
                                            IfCondition EqualTo(JSRT_ObjHas(obj, gk_h), 1) ThenBlock: {
                                                chain_get = JSRT_ObjGet(obj, gk_h)
                                                IfCondition EqualTo(chain_get, home_get) ThenBlock: {
                                                    brand_ok_g = 1
                                                } ElseBlock: {
                                                    IfCondition EqualTo(JSRT_GetType(chain_get), JSType.FUNCTION) ThenBlock: {
                                                        hg_fd = RDMEM_64(home_get, 8)
                                                        cg_fd = RDMEM_64(chain_get, 8)
                                                        IfCondition And(NotEqual(hg_fd, 0), EqualTo(hg_fd, cg_fd)) ThenBlock: {
                                                            brand_ok_g = 1
                                                        }
                                                    }
                                                }
                                            }
                                            IfCondition EqualTo(brand_ok_g, 0) ThenBlock: {
                                                terr = JSVM_CreateTypedError("TypeError", "Cannot read private member")
                                                JSVM_ThrowValue(terr)
                                                ReturnValue(1)
                                            }
                                            save_this_g = JSVM__GetGlobal("this")
                                            JSVM__SetGlobal("this", obj)
                                            empty_g = JSVMCallBuf.buf
                                            gres = JSVM__CallFunc(home_get, empty_g, 0)
                                            JSVM__SetGlobal("this", save_this_g)
                                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                                // M128e6o: re-ThrowValue so gen/for-await dstr aborts
                                                pend_g = JSVMCall.thrown_val
                                                IfCondition EqualTo(pend_g, 0) ThenBlock: { pend_g = JSVMState.exc_val }
                                                IfCondition EqualTo(pend_g, 0) ThenBlock: { pend_g = JSVM__GetGlobal("__pend_exc__") }
                                                JSVMCall.exc_prop = 0
                                                JSVMCall.thrown_val = 0
                                                JSVMState.exc_val = 0
                                                IfCondition And(NotEqual(pend_g, 0), NotEqual(pend_g, JSRTState.undef_val)) ThenBlock: {
                                                    JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                                    JSVM_ThrowValue(pend_g)
                                                }
                                                ReturnValue(1)
                                            }
                                            JSVM__StackPush(gres)
                                            ReturnValue(1)
                                        }
                                    }
                                    // M128e7g: setter-only private accessor — no [[Get]] → TypeError
                                    // Build __set_#name@id in a side buffer (gk_h already used getter_buf).
                                    sk_ok = 0
                                    IfCondition EqualTo(JSRT_ObjHas(home_p, gk_h), 0) ThenBlock: {
                                        // rebuild __set_ key into getter_buf after saving check on no get
                                        WRMEM_8(gk_h, 0, 95)
                                        WRMEM_8(gk_h, 1, 95)
                                        WRMEM_8(gk_h, 2, 115)
                                        WRMEM_8(gk_h, 3, 101)
                                        WRMEM_8(gk_h, 4, 116)
                                        WRMEM_8(gk_h, 5, 95)
                                        si_h = 0
                                        sdone_h = 0
                                        WhileLoop EqualTo(sdone_h, 0) {
                                            sb_h = RDMEM_8(cpay, si_h)
                                            WRMEM_8(gk_h, Add(6, si_h), sb_h)
                                            IfCondition EqualTo(sb_h, 0) ThenBlock: { sdone_h = 1 }
                                            si_h = Add(si_h, 1)
                                        }
                                        IfCondition EqualTo(JSRT_ObjHas(home_p, gk_h), 1) ThenBlock: {
                                            IfCondition EqualTo(JSRT_ObjHas(obj, cpay), 0) ThenBlock: {
                                                terr = JSVM_CreateTypedError("TypeError", "Cannot read private accessor without getter")
                                                JSVM_ThrowValue(terr)
                                                ReturnValue(1)
                                            }
                                        }
                                    }
                                }
                            }
                            IfCondition EqualTo(has_pf, 0) ThenBlock: {
                                has_pf = JSRT_ObjHas(obj, cpay)
                            }
                            IfCondition EqualTo(has_pf, 0) ThenBlock: {
                                has_pf = JSRT_ObjHasOnChain(obj, cpay)
                            }
                            IfCondition EqualTo(has_pf, 0) ThenBlock: {
                                gk_buf = JSVMCallBuf.getter_buf
                                WRMEM_8(gk_buf, 0, 95)
                                WRMEM_8(gk_buf, 1, 95)
                                WRMEM_8(gk_buf, 2, 103)
                                WRMEM_8(gk_buf, 3, 101)
                                WRMEM_8(gk_buf, 4, 116)
                                WRMEM_8(gk_buf, 5, 95)
                                gi = 0
                                gdone = 0
                                WhileLoop EqualTo(gdone, 0) {
                                    gb = RDMEM_8(cpay, gi)
                                    WRMEM_8(gk_buf, Add(6, gi), gb)
                                    IfCondition EqualTo(gb, 0) ThenBlock: { gdone = 1 }
                                    gi = Add(gi, 1)
                                }
                                has_pf = JSRT_ObjHasOnChain(obj, gk_buf)
                            }
                        }
                        IfCondition EqualTo(has_pf, 0) ThenBlock: {
                            terr = JSVM_CreateTypedError("TypeError", "Cannot read private member")
                            JSVM_ThrowValue(terr)
                            ReturnValue(1)
                        }
                        // M128e7g: if private "present" only as setter, get is TypeError
                        // (covers static path where home checks may miss).
                        gk2 = JSVMCallBuf.getter_buf
                        WRMEM_8(gk2, 0, 95)
                        WRMEM_8(gk2, 1, 95)
                        WRMEM_8(gk2, 2, 103)
                        WRMEM_8(gk2, 3, 101)
                        WRMEM_8(gk2, 4, 116)
                        WRMEM_8(gk2, 5, 95)
                        gi2 = 0
                        gd2 = 0
                        WhileLoop EqualTo(gd2, 0) {
                            gb2 = RDMEM_8(cpay, gi2)
                            WRMEM_8(gk2, Add(6, gi2), gb2)
                            IfCondition EqualTo(gb2, 0) ThenBlock: { gd2 = 1 }
                            gi2 = Add(gi2, 1)
                        }
                        IfCondition EqualTo(JSRT_ObjHasOnChain(obj, gk2), 0) ThenBlock: {
                            IfCondition EqualTo(JSRT_ObjHas(obj, cpay), 0) ThenBlock: {
                                WRMEM_8(gk2, 2, 115)
                                WRMEM_8(gk2, 3, 101)
                                WRMEM_8(gk2, 4, 116)
                                // __set_ already has prefix __ + s e t _
                                // rebuild fully
                                WRMEM_8(gk2, 0, 95)
                                WRMEM_8(gk2, 1, 95)
                                WRMEM_8(gk2, 2, 115)
                                WRMEM_8(gk2, 3, 101)
                                WRMEM_8(gk2, 4, 116)
                                WRMEM_8(gk2, 5, 95)
                                gi2 = 0
                                gd2 = 0
                                WhileLoop EqualTo(gd2, 0) {
                                    gb2 = RDMEM_8(cpay, gi2)
                                    WRMEM_8(gk2, Add(6, gi2), gb2)
                                    IfCondition EqualTo(gb2, 0) ThenBlock: { gd2 = 1 }
                                    gi2 = Add(gi2, 1)
                                }
                                IfCondition EqualTo(JSRT_ObjHasOnChain(obj, gk2), 1) ThenBlock: {
                                    terr = JSVM_CreateTypedError("TypeError", "Cannot read private accessor without getter")
                                    JSVM_ThrowValue(terr)
                                    ReturnValue(1)
                                }
                            }
                        }
                    }
                }

                // Handle array.length
                IfCondition EqualTo(obj_type, JSType.ARRAY) ThenBlock: {
                    // Check if property is "length"
                    // "length" = 108 101 110 103 116 104
                    is_len = 0
                    c0 = RDMEM_8(cpay, 0)
                    IfCondition EqualTo(c0, 108) ThenBlock: {
                        c1 = RDMEM_8(cpay, 1)
                        IfCondition EqualTo(c1, 101) ThenBlock: {
                            c2 = RDMEM_8(cpay, 2)
                            IfCondition EqualTo(c2, 110) ThenBlock: {
                                c3 = RDMEM_8(cpay, 3)
                                IfCondition EqualTo(c3, 103) ThenBlock: {
                                    c4 = RDMEM_8(cpay, 4)
                                    IfCondition EqualTo(c4, 116) ThenBlock: {
                                        c5 = RDMEM_8(cpay, 5)
                                        IfCondition EqualTo(c5, 104) ThenBlock: {
                                            c6 = RDMEM_8(cpay, 6)
                                            IfCondition EqualTo(c6, 0) ThenBlock: {
                                                is_len = 1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(is_len, 1) ThenBlock: {
                        alen = JSRT_ArrLen(obj)
                        JSVM__StackPush(JSRT_CreateNumber(alen))
                        ReturnValue(1)
                    }
                    // Match array method names
                    arr_mid = JSVM__MatchArrayMethod(cpay)
                    IfCondition GreaterThan(arr_mid, 0) ThenBlock: {
                        am_func = JSBridge__CreateNativeFunc(arr_mid, cpay, 1)
                        JSRT_FuncSetEnv(am_func, obj)
                        JSVM__StackPush(am_func)
                        ReturnValue(1)
                    }
                    // Match string methods on arrays (indexOf, etc.)
                    str_method_id = JSVM__MatchStringMethod(cpay)
                    IfCondition GreaterThan(str_method_id, 0) ThenBlock: {
                        sm_func = JSBridge__CreateNativeFunc(str_method_id, cpay, 1)
                        JSRT_FuncSetEnv(sm_func, obj)
                        JSVM__StackPush(sm_func)
                        ReturnValue(1)
                    }
                }

                // String property/method access
                IfCondition EqualTo(obj_type, JSType.STRING) ThenBlock: {
                    // Check "length" first (108 101 110 103 116 104 0)
                    c0 = RDMEM_8(cpay, 0)
                    IfCondition EqualTo(c0, 108) ThenBlock: {
                        IfCondition EqualTo(RDMEM_8(cpay, 1), 101) ThenBlock: {
                            IfCondition EqualTo(RDMEM_8(cpay, 2), 110) ThenBlock: {
                                IfCondition EqualTo(RDMEM_8(cpay, 3), 103) ThenBlock: {
                                    IfCondition EqualTo(RDMEM_8(cpay, 4), 116) ThenBlock: {
                                        IfCondition EqualTo(RDMEM_8(cpay, 5), 104) ThenBlock: {
                                            IfCondition EqualTo(RDMEM_8(cpay, 6), 0) ThenBlock: {
                                                str_ptr = JSRT_GetPayload(obj)
                                                slen = JSRT_StrLen(str_ptr)
                                                JSVM__StackPush(JSRT_CreateNumber(slen))
                                                ReturnValue(1)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Shared prototype method. CALL_METHOD binds this, so a fresh
                    // native per access is not required. That alloc exhausted
                    // the func slab and dominated the hot encodeURI scans.
                    str_g = JSVM__GetGlobal("String")
                    IfCondition EqualTo(JSRT_GetType(str_g), JSType.FUNCTION) ThenBlock: {
                        str_pr = JSRT_ObjGet(str_g, "prototype")
                        IfCondition EqualTo(JSRT_GetType(str_pr), JSType.OBJECT) ThenBlock: {
                            meth = JSRT_ObjGet(str_pr, cpay)
                            IfCondition EqualTo(JSRT_GetType(meth), JSType.FUNCTION) ThenBlock: {
                                JSVM__StackPush(meth)
                                ReturnValue(1)
                            }
                        }
                    }
                    str_method_id = JSVM__MatchStringMethod(cpay)
                    IfCondition GreaterThan(str_method_id, 0) ThenBlock: {
                        sm_func = JSBridge__CreateNativeFunc(str_method_id, cpay, 1)
                        JSRT_FuncSetEnv(sm_func, obj)
                        JSVM__StackPush(sm_func)
                        ReturnValue(1)
                    }
                    JSVM__StackPush(JSRT_Undefined())
                    ReturnValue(1)
                }

                // M104: Number/Boolean/BigInt property get — walk *.prototype
                // then Object.prototype. Keep primitive as getter thisArg so
                // OrdinaryCallBindThis can box (non-strict) or leave (strict).
                // Without this, (5).x with Object.prototype getter was undefined.
                IfCondition Or(Or(EqualTo(obj_type, JSType.NUMBER), EqualTo(obj_type, JSType.BOOLEAN)), EqualTo(obj_type, JSType.BIGINT)) ThenBlock: {
                    prim_proto = 0
                    IfCondition EqualTo(obj_type, JSType.NUMBER) ThenBlock: {
                        ng_p = JSVM__GetGlobal("Number")
                        IfCondition EqualTo(JSRT_GetType(ng_p), JSType.FUNCTION) ThenBlock: {
                            prim_proto = JSRT_ObjGet(ng_p, "prototype")
                        }
                    }
                    IfCondition EqualTo(obj_type, JSType.BOOLEAN) ThenBlock: {
                        bg_p = JSVM__GetGlobal("Boolean")
                        IfCondition EqualTo(JSRT_GetType(bg_p), JSType.FUNCTION) ThenBlock: {
                            prim_proto = JSRT_ObjGet(bg_p, "prototype")
                        }
                    }
                    IfCondition EqualTo(obj_type, JSType.BIGINT) ThenBlock: {
                        big_p = JSVM__GetGlobal("BigInt")
                        IfCondition EqualTo(JSRT_GetType(big_p), JSType.FUNCTION) ThenBlock: {
                            prim_proto = JSRT_ObjGet(big_p, "prototype")
                        }
                    }
                    IfCondition EqualTo(JSRT_GetType(prim_proto), JSType.OBJECT) ThenBlock: {
                        gk_buf2 = JSVMCallBuf.getter_buf
                        WRMEM_8(gk_buf2, 0, 95)
                        WRMEM_8(gk_buf2, 1, 95)
                        WRMEM_8(gk_buf2, 2, 103)
                        WRMEM_8(gk_buf2, 3, 101)
                        WRMEM_8(gk_buf2, 4, 116)
                        WRMEM_8(gk_buf2, 5, 95)
                        JSVMTmp.idx = 0
                        JSVMTmp.done = 0
                        WhileLoop EqualTo(JSVMTmp.done, 0) {
                            JSVMTmp.val = RDMEM_8(cpay, JSVMTmp.idx)
                            WRMEM_8(gk_buf2, Add(6, JSVMTmp.idx), JSVMTmp.val)
                            IfCondition EqualTo(JSVMTmp.val, 0) ThenBlock: {
                                JSVMTmp.done = 1
                            }
                            JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                        }
                        // Prefer accessor on chain
                        getter_func = JSRT_ObjGet(prim_proto, gk_buf2)
                        gt = JSRT_GetType(getter_func)
                        IfCondition EqualTo(gt, JSType.FUNCTION) ThenBlock: {
                            save_this_g = JSVM__GetGlobal("this")
                            JSVM__SetGlobal("this", obj)
                            empty_g = JSVMCallBuf.buf
                            gres = JSVM__CallFunc(getter_func, empty_g, 0)
                            JSVM__SetGlobal("this", save_this_g)
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                // M128e6o: re-ThrowValue so gen/for-await dstr aborts
                                pend_g = JSVMCall.thrown_val
                                IfCondition EqualTo(pend_g, 0) ThenBlock: { pend_g = JSVMState.exc_val }
                                IfCondition EqualTo(pend_g, 0) ThenBlock: { pend_g = JSVM__GetGlobal("__pend_exc__") }
                                JSVMCall.exc_prop = 0
                                JSVMCall.thrown_val = 0
                                JSVMState.exc_val = 0
                                IfCondition And(NotEqual(pend_g, 0), NotEqual(pend_g, JSRTState.undef_val)) ThenBlock: {
                                    JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                    JSVM_ThrowValue(pend_g)
                                }
                                ReturnValue(1)
                            }
                            JSVM__StackPush(gres)
                            ReturnValue(1)
                        }
                        // Data property on chain
                        pval = JSRT_ObjGet(prim_proto, cpay)
                        IfCondition NotEqual(JSRT_GetType(pval), JSType.UNDEFINED) ThenBlock: {
                            JSVM__StackPush(pval)
                            ReturnValue(1)
                        }
                    }
                    JSVM__StackPush(JSRT_Undefined())
                    ReturnValue(1)
                }

                // M105: .caller / .arguments poison — TypeError for strict funcs + bound
                IfCondition EqualTo(obj_type, JSType.FUNCTION) ThenBlock: {
                    IfCondition NotEqual(cpay, 0) ThenBlock: {
                        is_poison = 0
                        IfCondition EqualTo(JSRT_StrEq(cpay, "caller"), 1) ThenBlock: { is_poison = 1 }
                        IfCondition EqualTo(JSRT_StrEq(cpay, "arguments"), 1) ThenBlock: { is_poison = 1 }
                        IfCondition EqualTo(is_poison, 1) ThenBlock: {
                            fdesc_p = JSRT_GetPayload(obj)
                            poison_throw = 0
                            IfCondition NotEqual(fdesc_p, 0) ThenBlock: {
                                fparams_p = RDMEM_64(fdesc_p, 8)
                                IfCondition NotEqual(BitwiseAnd(fparams_p, 536870912), 0) ThenBlock: {
                                    poison_throw = 1
                                }
                                // Bound functions (FUNC_BOUND bc=-199) inherit poison
                                fbc_p = RDMEM_64(fdesc_p)
                                IfCondition EqualTo(fbc_p, -199) ThenBlock: {
                                    poison_throw = 1
                                }
                                // Native handler_id 198 = FUNC_BOUND: bc = -1 - 198 = -199
                            }
                            IfCondition EqualTo(poison_throw, 1) ThenBlock: {
                                terr = JSVM_CreateTypedError("TypeError", "Cannot access caller or arguments of strict function")
                                JSVM_ThrowValue(terr)
                                ReturnValue(1)
                            }
                        }
                    }
                }

                // M128e7b: Proxy [[Get]] — forward through get trap / target
                // (plain JSRT_ObjGet only sees own props on the proxy bag).
                IfCondition EqualTo(obj_type, JSType.OBJECT) ThenBlock: {
                    IfCondition EqualTo(JSVM__IsProxy(obj), 1) ThenBlock: {
                        // Skip internal proxy slots
                        skip_p = 0
                        IfCondition NotEqual(cpay, 0) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrEq(cpay, "__p__"), 1) ThenBlock: { skip_p = 1 }
                            IfCondition EqualTo(JSRT_StrEq(cpay, "__p_h__"), 1) ThenBlock: { skip_p = 1 }
                            IfCondition EqualTo(JSRT_StrEq(cpay, "__p_t__"), 1) ThenBlock: { skip_p = 1 }
                        }
                        IfCondition EqualTo(skip_p, 0) ThenBlock: {
                            pval = JSVM__GetProperty(obj, cpay)
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                ReturnValue(1)
                            }
                            IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
                                ReturnValue(1)
                            }
                            JSVM__StackPush(pval)
                            ReturnValue(1)
                        }
                    }
                }

                // M128e7bp: OrdinaryGet accessors — walk [[Prototype]] for __get_<name>
                // (class instance getters live on C.prototype). Receiver stays `obj` for this.
                // Prefer accessor over same-object data placeholder (DEF_GETTER stores both).
                // Was OWN-only which left new C().foo undefined while C.prototype.foo worked.
                // M128e7bz: ARRAY too — defineProperty accessors on arrays (named + index via prop).
                IfCondition Or(EqualTo(obj_type, JSType.OBJECT), Or(EqualTo(obj_type, JSType.FUNCTION), EqualTo(obj_type, JSType.ARRAY))) ThenBlock: {
                    gk_buf2 = JSVMCallBuf.getter_buf
                    WRMEM_8(gk_buf2, 0, 95)
                    WRMEM_8(gk_buf2, 1, 95)
                    WRMEM_8(gk_buf2, 2, 103)
                    WRMEM_8(gk_buf2, 3, 101)
                    WRMEM_8(gk_buf2, 4, 116)
                    WRMEM_8(gk_buf2, 5, 95)
                    JSVMTmp.idx = 0
                    JSVMTmp.done = 0
                    WhileLoop EqualTo(JSVMTmp.done, 0) {
                        JSVMTmp.val = RDMEM_8(cpay, JSVMTmp.idx)
                        WRMEM_8(gk_buf2, Add(6, JSVMTmp.idx), JSVMTmp.val)
                        IfCondition EqualTo(JSVMTmp.val, 0) ThenBlock: {
                            JSVMTmp.done = 1
                        }
                        JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                    }
                    // Walk chain: first object with own __get_ or own data wins (ES OrdinaryGet)
                    getter_func = JSRTState.undef_val
                    found_acc = 0
                    walk_g = obj
                    walk_n = 0
                    WhileLoop And(EqualTo(found_acc, 0), LessThan(walk_n, 64)) {
                        wt_g = JSRT_GetType(walk_g)
                        IfCondition And(NotEqual(wt_g, JSType.OBJECT), And(NotEqual(wt_g, JSType.FUNCTION), NotEqual(wt_g, JSType.ARRAY))) ThenBlock: {
                            walk_n = 64
                        } ElseBlock: {
                            JSRT__Push(obj)
                            JSRT__Push(walk_g)
                            IfCondition EqualTo(JSRT_ObjHas(walk_g, gk_buf2), 1) ThenBlock: {
                                getter_func = JSRT_ObjGet(walk_g, gk_buf2)
                                found_acc = 1
                            } ElseBlock: {
                                // Own data property (incl. accessor placeholder) stops the walk
                                IfCondition EqualTo(JSRT_ObjHas(walk_g, cpay), 1) ThenBlock: {
                                    found_acc = 2
                                }
                            }
                            walk_g = JSRT__Pop()
                            obj = JSRT__Pop()
                            IfCondition EqualTo(found_acc, 0) ThenBlock: {
                                JSRT__Push(obj)
                                proto_g = JSRT_ObjGet(walk_g, "__proto__")
                                obj = JSRT__Pop()
                                pt_g = JSRT_GetType(proto_g)
                                IfCondition Or(EqualTo(pt_g, JSType.NULL), EqualTo(pt_g, JSType.UNDEFINED)) ThenBlock: {
                                    walk_n = 64
                                } ElseBlock: {
                                    IfCondition EqualTo(proto_g, walk_g) ThenBlock: {
                                        walk_n = 64
                                    } ElseBlock: {
                                        walk_g = proto_g
                                    }
                                }
                            }
                        }
                        walk_n = Add(walk_n, 1)
                    }
                    gt = JSRT_GetType(getter_func)
                    IfCondition And(EqualTo(found_acc, 1), EqualTo(gt, JSType.FUNCTION)) ThenBlock: {
                        // Bind this = receiver (not the prototype that holds the getter)
                        save_this_g = JSVM__GetGlobal("this")
                        JSVM__SetGlobal("this", obj)
                        empty_g = JSVMCallBuf.buf
                        gres = JSVM__CallFunc(getter_func, empty_g, 0)
                        JSVM__SetGlobal("this", save_this_g)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            // M128e6o: re-ThrowValue so gen/for-await dstr aborts
                            pend_g = JSVMCall.thrown_val
                            IfCondition EqualTo(pend_g, 0) ThenBlock: { pend_g = JSVMState.exc_val }
                            IfCondition EqualTo(pend_g, 0) ThenBlock: { pend_g = JSVM__GetGlobal("__pend_exc__") }
                            JSVMCall.exc_prop = 0
                            JSVMCall.thrown_val = 0
                            JSVMState.exc_val = 0
                            IfCondition And(NotEqual(pend_g, 0), NotEqual(pend_g, JSRTState.undef_val)) ThenBlock: {
                                JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                JSVM_ThrowValue(pend_g)
                            }
                            ReturnValue(1)
                        }
                        JSVM__StackPush(gres)
                        ReturnValue(1)
                    }
                }

                // RegExp method binding — same pattern as string methods:
                // detect method name, create bound native func with env=receiver.
                IfCondition EqualTo(obj_type, JSType.OBJECT) ThenBlock: {
                    rx_mid = JSVM__MatchRegExpMethod(cpay)
                    IfCondition GreaterThan(rx_mid, 0) ThenBlock: {
                        // Verify this is actually a RegExp (has __regex_handle__)
                        rh_chk = PropTable_Lookup(RDMEM_64(obj, 8), "__regex_handle__")
                        IfCondition NotEqual(rh_chk, -1) ThenBlock: {
                            rx_func = JSBridge__CreateNativeFunc(rx_mid, cpay, 1)
                            JSRT_FuncSetEnv(rx_func, obj)
                            JSVM__StackPush(rx_func)
                            ReturnValue(1)
                        }
                    }
                }

                pval = JSRT_ObjGet(obj, cpay)
                // Object.create(null) stores [[Prototype]] as own "__proto__"=null.
                // Public property get of "__proto__" must be undefined (no accessor
                // on Object.prototype). Module NS tests: ns.__proto__ === undefined.
                IfCondition NotEqual(cpay, 0) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrEq(cpay, "__proto__"), 1) ThenBlock: {
                        IfCondition EqualTo(JSRT_GetType(pval), JSType.NULL) ThenBlock: {
                            pval = JSRT_Undefined()
                        }
                    }
                }
                JSVM__StackPush(pval)
                ReturnValue(1)
            
    }
}
