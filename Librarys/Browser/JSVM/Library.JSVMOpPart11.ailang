                ys_idx = RDMEM_64(gs, JSGenConst.OFF_YSTAR_IDX)
                IfCondition EqualTo(ys_arr, 0) ThenBlock: {
                    src_val = JSVM__StackPop()
                    ys_arr = JSVM_IterableToArray(src_val)
                    IfCondition EqualTo(ys_arr, 0) ThenBlock: {
                        ReturnValue(1)
                    }
                    WRMEM_64(gs, JSGenConst.OFF_YSTAR_ARR, ys_arr)
                    ys_idx = 0
                    WRMEM_64(gs, JSGenConst.OFF_YSTAR_IDX, 0)
