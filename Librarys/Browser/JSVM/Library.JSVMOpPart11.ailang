                WRMEM_64(gs, 32, JSVMState.pc)
                WRMEM_64(gs, 40, JSVMState.sp)
                WRMEM_64(gs, 48, JSVMState.fp)
                gen_stk = RDMEM_64(gs, 56)
                copy_sz = Multiply(JSVMState.sp, 8)
                IfCondition GreaterThan(copy_sz, 0) ThenBlock: {
