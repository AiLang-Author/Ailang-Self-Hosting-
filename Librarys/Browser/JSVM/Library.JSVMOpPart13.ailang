// Library.JSVMOpPart13.ailang — JSVM opcode bodies
// Helpers called from JSVM_Step. Opcodes: JSVM_OpSetElemSuper, JSVM_OpWithPush, JSVM_OpGetWith, JSVM_OpSetWith, JSVM_OpResolveFree.
// Split from the JS engine so one function fits in context.
// FixedPools stay in the parent library. Function names are unchanged
// except for the new helpers this split adds.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// SET_ELEM_SUPER (112) — M128e7bo: super[key] = val
            // Stack: [..., val, SuperBase, key] (same order as SET_ELEM).
            // PutValue(SuperReference): evaluate RHS first (compiler); ToObject(base)
            // throws TypeError if SuperBase is null (after RHS). Receiver = this.
Function.JSVM_OpSetElemSuper {
    Output: Integer
    Body: {

                key_ses = JSVM__StackPop()
                base_ses = JSVM__StackPop()
                val_ses = JSVM__StackPop()
                bt_ses = JSRT_GetType(base_ses)
                IfCondition Or(EqualTo(bt_ses, JSType.NULL), EqualTo(bt_ses, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot set super property of null/undefined SuperBase")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                recv_ses = JSVM__GetGlobal("this")
                JSRT__Push(val_ses)
                JSRT__Push(base_ses)
                JSRT__Push(recv_ses)
                key_ptr_ses = JSVM_ToPropertyKey(key_ses)
                recv_ses = JSRT__Pop()
                base_ses = JSRT__Pop()
                val_ses = JSRT__Pop()
                IfCondition EqualTo(key_ptr_ses, 0) ThenBlock: {
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    ReturnValue(1)
                }
                // Setter on SuperBase chain: __set_<key>
                sk_ses = JSVMCallBuf.getter_buf
                nlen_ses = JSRT_StrLen(key_ptr_ses)
                IfCondition LessThan(nlen_ses, 100) ThenBlock: {
                    SetByte(sk_ses, 0, 95)
                    SetByte(sk_ses, 1, 95)
                    SetByte(sk_ses, 2, 115)
                    SetByte(sk_ses, 3, 101)
                    SetByte(sk_ses, 4, 116)
                    SetByte(sk_ses, 5, 95)
                    gi_ses = 0
                    WhileLoop LessThan(gi_ses, nlen_ses) {
                        u_ses = JSRT_StrUnit(key_ptr_ses, gi_ses)
                        IfCondition GreaterThan(u_ses, 255) ThenBlock: { u_ses = 63 }
                        SetByte(sk_ses, Add(6, gi_ses), u_ses)
                        gi_ses = Add(gi_ses, 1)
                    }
                    SetByte(sk_ses, Add(6, nlen_ses), 0)
                    JSRT__Push(val_ses)
                    JSRT__Push(recv_ses)
                    JSRT__Push(base_ses)
                    setter_ses = JSRT_ObjGet(base_ses, sk_ses)
                    base_ses = JSRT__Pop()
                    recv_ses = JSRT__Pop()
                    val_ses = JSRT__Pop()
                    IfCondition EqualTo(JSRT_GetType(setter_ses), JSType.FUNCTION) ThenBlock: {
                        save_this_ses = JSVM__GetGlobal("this")
                        JSVM__SetGlobal("this", recv_ses)
                        arg_buf_ses = JSVMCallBuf.buf
                        StoreValue(arg_buf_ses, val_ses)
                        JSVM__CallFunc(setter_ses, arg_buf_ses, 1)
                        JSVM__SetGlobal("this", save_this_ses)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend_ses = JSVMCall.thrown_val
                            IfCondition EqualTo(pend_ses, 0) ThenBlock: { pend_ses = JSVMState.exc_val }
                            JSVMCall.thrown_val = 0
                            JSVMState.exc_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition And(NotEqual(pend_ses, 0), NotEqual(pend_ses, JSRTState.undef_val)) ThenBlock: {
                                JSVM_ThrowValue(pend_ses)
                            }
                        }
                        ReturnValue(1)
                    }
                }
                // Data property: define/set on Receiver (this)
                can_ses = JSBridge_CanAssign(recv_ses, key_ptr_ses)
                IfCondition EqualTo(can_ses, 1) ThenBlock: {
                    JSRT_ObjSet(recv_ses, key_ptr_ses, val_ses)
                } ElseBlock: {
                    IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                        terr = JSVM_CreateTypedError("TypeError", "Cannot assign to non-writable property")
                        JSVM_ThrowValue(terr)
                        ReturnValue(1)
                    }
                }
                ReturnValue(1)
            
    }
}

// WITH_PUSH (121) — M128d: [obj] → ObjectEnv with __with__=obj, parent=cur
Function.JSVM_OpWithPush {
    Output: Integer
    Body: {

                wobj = JSVM__StackPop()
                // ToObject — null/undefined TypeError; box primitives
                wt = JSRT_GetType(wobj)
                IfCondition Or(EqualTo(wt, JSType.NULL), EqualTo(wt, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                IfCondition Or(EqualTo(wt, JSType.NUMBER), Or(EqualTo(wt, JSType.STRING), EqualTo(wt, JSType.BOOLEAN))) ThenBlock: {
                    box = JSRT_CreateObject()
                    IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                        JSRT_ObjSet(box, "__proto__", JSRTState.object_proto)
                    }
                    wobj = box
                }
                parent_w = JSVM__GetCurEnv()

                env_w = JSRT__AllocGlobalValue()
                IfCondition EqualTo(env_w, 0) ThenBlock: {
                    ReturnValue(1)
                }
                ptable_w = PropTable_Alloc()
                StoreValue(env_w, JSType.OBJECT)
                StoreValue(Add(env_w, 8), ptable_w)
                IfCondition And(NotEqual(parent_w, 0), NotEqual(parent_w, JSRTState.undef_val)) ThenBlock: {
                    IfCondition EqualTo(JSRT_GetType(parent_w), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(env_w, JSVMClosure.parent_key, parent_w)
                    }
                }
                JSRT_ObjSet(env_w, "__with__", wobj)
                JSVM__SetCurEnv(env_w)
                ReturnValue(1)
            
    }
}

// GET_WITH (123) — M128e: resolve IDENT under with
            // Operand: name const; trailing 3-byte slot (0xFFFFFF = none)
            // ObjectEnv first (invoke getters); set JSVMWithRef for PutValue.
            // M128e6r: on miss restore prior WithRef so RHS `delete scope.x`
            // does not drop the LHS Reference (S11.13.1_A5). On hit, overwrite.
Function.JSVM_OpGetWith {
    Output: Integer
    Body: {

                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                slot_w = JSVM__Read16()
                save_wr_v = JSVMWithRef.valid
                save_wr_b = JSVMWithRef.base
                save_wr_n = JSVMWithRef.name
                JSVMWithRef.valid = 0
                JSVMWithRef.base = 0
                JSVMWithRef.name = 0
                found_w = 0
                gval_w = JSRTState.undef_val
                env_w = JSVM__GetCurEnv()
                hops_w = 0
                WhileLoop And(And(NotEqual(env_w, 0), NotEqual(env_w, JSRTState.undef_val)), LessThan(hops_w, 64)) {
                    IfCondition EqualTo(JSRT_GetType(env_w), JSType.OBJECT) ThenBlock: {
                        wobj = JSRT_ObjGet(env_w, "__with__")
                        wt = JSRT_GetType(wobj)
                        IfCondition Or(EqualTo(wt, JSType.OBJECT), Or(EqualTo(wt, JSType.FUNCTION), EqualTo(wt, JSType.ARRAY))) ThenBlock: {
                            // Has own data or accessor (__get_name)
                            // M128e6ac/ae: Proxy [[HasProperty]]; -1 = trap threw
                            has_bind = 0
                            hb_px = JSVM__HasProperty(wobj, cpay)
                            IfCondition EqualTo(hb_px, -1) ThenBlock: {
                                // M128e6aj: trap throw already delivered — do not leave sticky flag
                                IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
                                    JSVMState.throw_delivered = 0
                                }
                                ReturnValue(1)
                            }
                            IfCondition EqualTo(hb_px, 1) ThenBlock: {
                                has_bind = 1
                            }
                            // Build __get_ + name
                            gk = JSVMCallBuf.getter_buf
                            SetByte(gk, 0, 95)
                            SetByte(gk, 1, 95)
                            SetByte(gk, 2, 103)
                            SetByte(gk, 3, 101)
                            SetByte(gk, 4, 116)
                            SetByte(gk, 5, 95)
                            gi = 0
                            gdone = 0
                            WhileLoop EqualTo(gdone, 0) {
                                gb = GetByte(cpay, gi)
                                SetByte(gk, Add(6, gi), gb)
                                IfCondition EqualTo(gb, 0) ThenBlock: { gdone = 1 }
                                gi = Add(gi, 1)
                            }
                            IfCondition EqualTo(has_bind, 0) ThenBlock: {
                                IfCondition EqualTo(JSRT_ObjHasOnChain(wobj, gk), 1) ThenBlock: {
                                    has_bind = 1
                                }
                            }
                            // unscopables skip — M128e6q: Get must invoke accessors + rethrow
                            IfCondition EqualTo(has_bind, 1) ThenBlock: {
                                IfCondition NotEqual(JSVMSymbol.unscopables, 0) ThenBlock: {
                                    uk = JSVM_SymbolToKey(JSVMSymbol.unscopables)
                                    IfCondition NotEqual(uk, 0) ThenBlock: {
                                        JSRT__Push(env_w)
                                        JSRT__Push(wobj)
                                        uobj = JSVM__GetProperty(wobj, uk)
                                        wobj = JSRT__Pop()
                                        env_w = JSRT__Pop()
                                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                            pend_u = JSVMCall.thrown_val
                                            IfCondition EqualTo(pend_u, 0) ThenBlock: { pend_u = JSVMState.exc_val }
                                            IfCondition EqualTo(pend_u, 0) ThenBlock: { pend_u = JSVM__GetGlobal("__pend_exc__") }
                                            JSVMCall.exc_prop = 0
                                            JSVMCall.thrown_val = 0
                                            JSVMState.exc_val = 0
                                            IfCondition And(NotEqual(pend_u, 0), NotEqual(pend_u, JSRTState.undef_val)) ThenBlock: {
                                                JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                                JSVM_ThrowValue(pend_u)
                                            }
                                            ReturnValue(1)
                                        }
                                        ut = JSRT_GetType(uobj)
                                        IfCondition Or(EqualTo(ut, JSType.OBJECT), EqualTo(ut, JSType.FUNCTION)) ThenBlock: {
                                            JSRT__Push(env_w)
                                            JSRT__Push(wobj)
                                            uflag = JSVM__GetProperty(uobj, cpay)
                                            wobj = JSRT__Pop()
                                            env_w = JSRT__Pop()
                                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                                pend_uf = JSVMCall.thrown_val
                                                IfCondition EqualTo(pend_uf, 0) ThenBlock: { pend_uf = JSVMState.exc_val }
                                                IfCondition EqualTo(pend_uf, 0) ThenBlock: { pend_uf = JSVM__GetGlobal("__pend_exc__") }
                                                JSVMCall.exc_prop = 0
                                                JSVMCall.thrown_val = 0
                                                JSVMState.exc_val = 0
                                                IfCondition And(NotEqual(pend_uf, 0), NotEqual(pend_uf, JSRTState.undef_val)) ThenBlock: {
                                                    JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                                    JSVM_ThrowValue(pend_uf)
                                                }
                                                ReturnValue(1)
                                            }
                                            IfCondition EqualTo(JSRT_IsTruthy(uflag), 1) ThenBlock: {
                                                has_bind = 0
                                            }
                                        }
                                    }
                                }
                            }
                            IfCondition EqualTo(has_bind, 1) ThenBlock: {
                                // Capture Reference base before Get (getter may delete)
                                JSVMWithRef.base = wobj
                                JSVMWithRef.name = cpay
                                JSVMWithRef.valid = 1
                                // M128e6ai: resolve-only (0xFFFFFE) — PutValue capture, no Get
                                // (assignment must not fire get trap before set)
                                IfCondition EqualTo(slot_w, 16777214) ThenBlock: {
                                    gval_w = JSRTState.undef_val
                                    found_w = 1
                                    hops_w = 64
                                } ElseBlock: {
                                // GetBindingValue: re-HasProperty after unscopables may have deleted
                                still_hb = 0
                                hb2 = JSVM__HasProperty(wobj, cpay)
                                IfCondition EqualTo(hb2, -1) ThenBlock: {
                                    ReturnValue(1)
                                }
                                IfCondition EqualTo(hb2, 1) ThenBlock: {
                                    still_hb = 1
                                }
                                IfCondition EqualTo(still_hb, 0) ThenBlock: {
                                    IfCondition EqualTo(JSRT_ObjHasOnChain(wobj, gk), 1) ThenBlock: {
                                        still_hb = 1
                                    }
                                }
                                IfCondition EqualTo(still_hb, 0) ThenBlock: {
                                    // Missing after unscopables Get: strict → ReferenceError; sloppy → undefined
                                    IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                                        JSVM_ThrowReferenceError("is not defined")
                                        ReturnValue(1)
                                    }
                                    gval_w = JSRTState.undef_val
                                    found_w = 1
                                    hops_w = 64
                                } ElseBlock: {
                                // M128e6ae: Proxy [[Get]] / ordinary Get with accessors
                                JSRT__Push(env_w)
                                JSRT__Push(wobj)
                                gval_w = JSVM__GetProperty(wobj, cpay)
                                wobj = JSRT__Pop()
                                env_w = JSRT__Pop()
                                // GetProperty rethrows via ThrowValue; halt if error
                                IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                                    ReturnValue(1)
                                }
                                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                    ReturnValue(1)
                                }
                                found_w = 1
                                hops_w = 64
                                }
                                }
                            }
                        }
                        IfCondition EqualTo(found_w, 0) ThenBlock: {
                            env_w = JSRT_ObjGet(env_w, JSVMClosure.parent_key)
                        }
                    } ElseBlock: {
                        env_w = 0
                    }
                    hops_w = Add(hops_w, 1)
                }
                IfCondition EqualTo(found_w, 1) ThenBlock: {
                    JSVM__StackPush(gval_w)
                    ReturnValue(1)
                }
                // Miss on with object — restore prior WithRef (LHS PutValue base)
                JSVMWithRef.valid = save_wr_v
                JSVMWithRef.base = save_wr_b
                JSVMWithRef.name = save_wr_n
                // M128e6r: resolve-only (slot 0xFFFFFE) — IdentReference without GetValue
                // M128e6v A6: mark outer/declarative ref so SET_WITH skips live with
                // (RHS may create the property: `x = (scope.x = 2, 1)`).
                IfCondition EqualTo(slot_w, 16777214) ThenBlock: {
                    JSVMWithRef.valid = 2
                    JSVMWithRef.base = 0
                    JSVMWithRef.name = cpay
                    JSVM__StackPush(JSRTState.undef_val)
                    ReturnValue(1)
                }
                // Fall back: local slot if valid
                IfCondition NotEqual(slot_w, 16777215) ThenBlock: {
                    // TDZ check
                    lval = JSVM__GetLocal(slot_w)
                    IfCondition And(NotEqual(JSVMClosure.tdz_uninit, 0), EqualTo(lval, JSVMClosure.tdz_uninit)) ThenBlock: {
                        JSVM_ThrowReferenceError("Cannot access variable before initialization")
                        ReturnValue(1)
                    }
                    JSVM__StackPush(lval)
                    ReturnValue(1)
                }
                // M128e6ag: free-var / outer env before global (12.10-0-9)
                gval_fe = 0
                found_fe = 0
                start_fe = JSRTState.undef_val
                IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                    fi_fe = Subtract(JSVMState.fp, 1)
                    own_fe = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi_fe, 8)))
                    IfCondition And(NotEqual(own_fe, 0), NotEqual(own_fe, JSRTState.undef_val)) ThenBlock: {
                        IfCondition EqualTo(JSRT_ObjHas(own_fe, cpay), 1) ThenBlock: {
                            gval_fe = JSRT_ObjGet(own_fe, cpay)
                            found_fe = 1
                        }
                    }
                    IfCondition EqualTo(found_fe, 0) ThenBlock: {
                        fval_fe = Dereference(Add(JSVMClosure.frame_funcs, Multiply(fi_fe, 8)))
                        IfCondition NotEqual(fval_fe, 0) ThenBlock: {
                            start_fe = JSRT_FuncPropGet(fval_fe, JSVMClosure.cenv_key)
                        }
                    }
                }
                IfCondition EqualTo(found_fe, 0) ThenBlock: {
                    gval_fe = JSVM__EnvLookup(start_fe, cpay)
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    IfCondition NotEqual(gval_fe, 0) ThenBlock: {
                        found_fe = 1
                    }
                }
                IfCondition EqualTo(found_fe, 1) ThenBlock: {
                    JSVM__StackPush(gval_fe)
                    ReturnValue(1)
                }
                // Global
                has_g = JSVM__HasGlobal(cpay)
                IfCondition EqualTo(has_g, 0) ThenBlock: {
                    JSVM_ThrowReferenceError("is not defined")
                    ReturnValue(1)
                }
                JSVM__StackPush(JSVM__GetGlobal(cpay))
                ReturnValue(1)
            
    }
}

// SET_WITH (124) — M128e: PutValue under with
            // If WithRef.valid from matching GET_WITH, put on that base even if deleted.
            // Else with-object HasBinding → put; else local/global/const.
            // put_done: never dual-write outer after object put.
Function.JSVM_OpSetWith {
    Output: Integer
    Body: {

                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                slot_s = JSVM__Read16()
                sval = JSVM__StackPop()
                put_done = 0

                // 1a) Outer/declarative Reference (valid=2) — skip live with (A6 T3)
                skip_with_live = 0
                IfCondition EqualTo(JSVMWithRef.valid, 2) ThenBlock: {
                    name_ok2 = 0
                    IfCondition EqualTo(JSVMWithRef.name, cpay) ThenBlock: { name_ok2 = 1 }
                    IfCondition EqualTo(name_ok2, 0) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrEq(JSVMWithRef.name, cpay), 1) ThenBlock: { name_ok2 = 1 }
                    }
                    IfCondition EqualTo(name_ok2, 1) ThenBlock: {
                        skip_with_live = 1
                        JSVMWithRef.valid = 0
                        JSVMWithRef.base = 0
                        JSVMWithRef.name = 0
                    }
                }
                // 1) Captured ObjectEnv Reference from GET_WITH (name by content, not ptr)
                IfCondition EqualTo(JSVMWithRef.valid, 1) ThenBlock: {
                    name_ok = 0
                    IfCondition EqualTo(JSVMWithRef.name, cpay) ThenBlock: { name_ok = 1 }
                    IfCondition EqualTo(name_ok, 0) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrEq(JSVMWithRef.name, cpay), 1) ThenBlock: { name_ok = 1 }
                    }
                    IfCondition EqualTo(name_ok, 1) ThenBlock: {
                        base_p = JSVMWithRef.base
                        JSVMWithRef.valid = 0
                        // M128e6v: ObjectEnv SetMutableBinding — if !stillExists && strict → RE
                        still_cap = 0
                        hb_cap = JSVM__HasProperty(base_p, cpay)
                        IfCondition EqualTo(hb_cap, -1) ThenBlock: {
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(hb_cap, 1) ThenBlock: {
                            still_cap = 1
                        }
                        // M128e6al: do NOT ObjHasOnChain(__get_*) for stillExists —
                        // array/TypedArray protos crash the chain walk for synthetic
                        // accessor keys. Own HasProperty is enough for deleted check.
                        // M128e6aj/al: SetMutableBinding — strict + deleted → RE.
                        // Sloppy + deleted: still Perform Set (may recreate). Use only
                        // own-object ObjSet — no __set_* chain walk (array/typed-array
                        // protos have corrupted CallFunc during setter lookup).
                        IfCondition And(EqualTo(still_cap, 0), EqualTo(JSVMState.is_strict, 1)) ThenBlock: {
                            JSVM_ThrowReferenceError("is not defined")
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(put_done, 0) ThenBlock: {
                        IfCondition EqualTo(still_cap, 0) ThenBlock: {
                            // M128e6al: deleted after resolve-only.
                            // Plain objects: Set recreates (unscopables tests).
                            // Array/TypedArray on [[Prototype]]: ObjSet corrupts
                            // the object — fall through to outer PutValue instead.
                            proto_d = JSRT_ObjGet(base_p, "__proto__")
                            pt_d = JSRT_GetType(proto_d)
                            IfCondition EqualTo(pt_d, JSType.ARRAY) ThenBlock: {
                                put_done = 0
                            } ElseBlock: {
                                IfCondition And(NotEqual(base_p, 0), NotEqual(sval, 0)) ThenBlock: {
                                    setr_cap = JSVM__SetProperty(base_p, cpay, sval)
                                    IfCondition EqualTo(setr_cap, -1) ThenBlock: {
                                        ReturnValue(1)
                                    }
                                }
                                put_done = 1
                            }
                        }
                        IfCondition And(EqualTo(put_done, 0), EqualTo(still_cap, 1)) ThenBlock: {
                        sk = JSVMCallBuf.getter_buf
                        SetByte(sk, 0, 95)
                        SetByte(sk, 1, 95)
                        SetByte(sk, 2, 115)
                        SetByte(sk, 3, 101)
                        SetByte(sk, 4, 116)
                        SetByte(sk, 5, 95)
                        si = 0
                        sdone = 0
                        WhileLoop EqualTo(sdone, 0) {
                            sb = GetByte(cpay, si)
                            SetByte(sk, Add(6, si), sb)
                            IfCondition EqualTo(sb, 0) ThenBlock: { sdone = 1 }
                            si = Add(si, 1)
                        }
                        sfn = JSRT_ObjGet(base_p, sk)
                        IfCondition EqualTo(JSRT_GetType(sfn), JSType.FUNCTION) ThenBlock: {
                            save_this_s = JSVM__GetGlobal("this")
                            JSVM__SetGlobal("this", base_p)
                            abuf = JSVMCallBuf.buf
                            StoreValue(abuf, sval)
                            JSVM__CallFunc(sfn, abuf, 1)
                            JSVM__SetGlobal("this", save_this_s)
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                ReturnValue(1)
                            }
                            put_done = 1
                        }
                        IfCondition EqualTo(put_done, 0) ThenBlock: {
                            setr_cap = JSVM__SetProperty(base_p, cpay, sval)
                            IfCondition EqualTo(setr_cap, -1) ThenBlock: {
                                ReturnValue(1)
                            }
                            put_done = 1
                        }
                        }
                        }
                    }
                }
                JSVMWithRef.valid = 0
                // 2) Live with binding (skipped when resolve captured outer ref)
                IfCondition And(EqualTo(put_done, 0), EqualTo(skip_with_live, 0)) ThenBlock: {
                    env_s = JSVM__GetCurEnv()
                    hops_s = 0
                    WhileLoop And(And(And(NotEqual(env_s, 0), NotEqual(env_s, JSRTState.undef_val)), LessThan(hops_s, 64)), EqualTo(put_done, 0)) {
                        IfCondition EqualTo(JSRT_GetType(env_s), JSType.OBJECT) ThenBlock: {
                            wos = JSRT_ObjGet(env_s, "__with__")
                            wts = JSRT_GetType(wos)
                            IfCondition Or(EqualTo(wts, JSType.OBJECT), Or(EqualTo(wts, JSType.FUNCTION), EqualTo(wts, JSType.ARRAY))) ThenBlock: {
                                has_b = 0
                                hb_lv = JSVM__HasProperty(wos, cpay)
                                IfCondition EqualTo(hb_lv, -1) ThenBlock: {
                                    ReturnValue(1)
                                }
                                IfCondition EqualTo(hb_lv, 1) ThenBlock: { has_b = 1 }
                                sk2 = JSVMCallBuf.getter_buf
                                SetByte(sk2, 0, 95)
                                SetByte(sk2, 1, 95)
                                SetByte(sk2, 2, 103)
                                SetByte(sk2, 3, 101)
                                SetByte(sk2, 4, 116)
                                SetByte(sk2, 5, 95)
                                si2 = 0
                                sd2 = 0
                                WhileLoop EqualTo(sd2, 0) {
                                    sb2 = GetByte(cpay, si2)
                                    SetByte(sk2, Add(6, si2), sb2)
                                    IfCondition EqualTo(sb2, 0) ThenBlock: { sd2 = 1 }
                                    si2 = Add(si2, 1)
                                }
                                IfCondition EqualTo(has_b, 0) ThenBlock: {
                                    IfCondition EqualTo(JSRT_ObjHasOnChain(wos, sk2), 1) ThenBlock: { has_b = 1 }
                                }
                                // M128e6q: HasBinding unscopables Get (accessors + rethrow)
                                IfCondition EqualTo(has_b, 1) ThenBlock: {
                                    IfCondition NotEqual(JSVMSymbol.unscopables, 0) ThenBlock: {
                                        uk_s = JSVM_SymbolToKey(JSVMSymbol.unscopables)
                                        IfCondition NotEqual(uk_s, 0) ThenBlock: {
                                            JSRT__Push(env_s)
                                            JSRT__Push(wos)
                                            JSRT__Push(sval)
                                            uobj_s = JSVM__GetProperty(wos, uk_s)
                                            sval = JSRT__Pop()
                                            wos = JSRT__Pop()
                                            env_s = JSRT__Pop()
                                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                                pend_us = JSVMCall.thrown_val
                                                IfCondition EqualTo(pend_us, 0) ThenBlock: { pend_us = JSVMState.exc_val }
                                                IfCondition EqualTo(pend_us, 0) ThenBlock: { pend_us = JSVM__GetGlobal("__pend_exc__") }
                                                JSVMCall.exc_prop = 0
                                                JSVMCall.thrown_val = 0
                                                JSVMState.exc_val = 0
                                                IfCondition And(NotEqual(pend_us, 0), NotEqual(pend_us, JSRTState.undef_val)) ThenBlock: {
                                                    JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                                    JSVM_ThrowValue(pend_us)
                                                }
                                                ReturnValue(1)
                                            }
                                            ut_s = JSRT_GetType(uobj_s)
                                            IfCondition Or(EqualTo(ut_s, JSType.OBJECT), EqualTo(ut_s, JSType.FUNCTION)) ThenBlock: {
                                                JSRT__Push(env_s)
                                                JSRT__Push(wos)
                                                JSRT__Push(sval)
                                                uflag_s = JSVM__GetProperty(uobj_s, cpay)
                                                sval = JSRT__Pop()
                                                wos = JSRT__Pop()
                                                env_s = JSRT__Pop()
                                                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                                    pend_ufs = JSVMCall.thrown_val
                                                    IfCondition EqualTo(pend_ufs, 0) ThenBlock: { pend_ufs = JSVMState.exc_val }
                                                    IfCondition EqualTo(pend_ufs, 0) ThenBlock: { pend_ufs = JSVM__GetGlobal("__pend_exc__") }
                                                    JSVMCall.exc_prop = 0
                                                    JSVMCall.thrown_val = 0
                                                    JSVMState.exc_val = 0
                                                    IfCondition And(NotEqual(pend_ufs, 0), NotEqual(pend_ufs, JSRTState.undef_val)) ThenBlock: {
                                                        JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                                        JSVM_ThrowValue(pend_ufs)
                                                    }
                                                    ReturnValue(1)
                                                }
                                                IfCondition EqualTo(JSRT_IsTruthy(uflag_s), 1) ThenBlock: {
                                                    has_b = 0
                                                }
                                            }
                                        }
                                    }
                                }
                                IfCondition EqualTo(has_b, 1) ThenBlock: {
                                    // SetMutableBinding: re-HasProperty after unscopables may have deleted
                                    still_sb = 0
                                    hb_sb = JSVM__HasProperty(wos, cpay)
                                    IfCondition EqualTo(hb_sb, -1) ThenBlock: {
                                        ReturnValue(1)
                                    }
                                    IfCondition EqualTo(hb_sb, 1) ThenBlock: {
                                        still_sb = 1
                                    }
                                    IfCondition EqualTo(still_sb, 0) ThenBlock: {
                                        IfCondition EqualTo(JSRT_ObjHasOnChain(wos, sk2), 1) ThenBlock: {
                                            still_sb = 1
                                        }
                                    }
                                    // M128e6aj: strict + deleted → RE; sloppy still Set
                                    IfCondition And(EqualTo(still_sb, 0), EqualTo(JSVMState.is_strict, 1)) ThenBlock: {
                                        JSVM_ThrowReferenceError("is not defined")
                                        ReturnValue(1)
                                    }
                                    IfCondition EqualTo(put_done, 0) ThenBlock: {
                                    sks = JSVMCallBuf.getter_buf
                                    SetByte(sks, 0, 95)
                                    SetByte(sks, 1, 95)
                                    SetByte(sks, 2, 115)
                                    SetByte(sks, 3, 101)
                                    SetByte(sks, 4, 116)
                                    SetByte(sks, 5, 95)
                                    gi_s = 0
                                    gd_s = 0
                                    WhileLoop EqualTo(gd_s, 0) {
                                        gb_s = GetByte(cpay, gi_s)
                                        SetByte(sks, Add(6, gi_s), gb_s)
                                        IfCondition EqualTo(gb_s, 0) ThenBlock: { gd_s = 1 }
                                        gi_s = Add(gi_s, 1)
                                    }
                                    sfn2 = JSRT_ObjGet(wos, sks)
                                    IfCondition EqualTo(JSRT_GetType(sfn2), JSType.FUNCTION) ThenBlock: {
                                        st2 = JSVM__GetGlobal("this")
                                        JSVM__SetGlobal("this", wos)
                                        ab2 = JSVMCallBuf.buf
                                        StoreValue(ab2, sval)
                                        JSVM__CallFunc(sfn2, ab2, 1)
                                        JSVM__SetGlobal("this", st2)
                                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                            ReturnValue(1)
                                        }
                                        put_done = 1
                                    }
                                    IfCondition EqualTo(put_done, 0) ThenBlock: {
                                        setr_lv = JSVM__SetProperty(wos, cpay, sval)
                                        IfCondition EqualTo(setr_lv, -1) ThenBlock: {
                                            ReturnValue(1)
                                        }
                                        put_done = 1
                                    }
                                    }
                                }
                            }
                            IfCondition EqualTo(put_done, 0) ThenBlock: {
                                env_s = JSRT_ObjGet(env_s, JSVMClosure.parent_key)
                            }
                        } ElseBlock: {
                            env_s = 0
                        }
                        hops_s = Add(hops_s, 1)
                    }
                }
                // 3) Outer binding only if with object did not take PutValue
                IfCondition EqualTo(put_done, 0) ThenBlock: {
                    box_n = sval
                    IfCondition EqualTo(JSRT_GetType(sval), JSType.NUMBER) ThenBlock: {
                        box_n = JSRT_CreateFloat(JSRT_GetPayload(sval))
                    }
                    // Function-local slot: SetLocal only (A1.2 var p4 must not globalize)
                    IfCondition NotEqual(slot_s, 16777215) ThenBlock: {
                        JSVM__SetLocal(slot_s, box_n)
                        IfCondition EqualTo(JSVMState.fp, 0) ThenBlock: {
                            // M128e6: SetGlobal (not just Hash) so GET_GLOBAL sees update
                            JSVM__SetGlobal(cpay, box_n)
                        }
                    } ElseBlock: {
                        // Free-var or bare global — update cenv chain + script __sl_ + GlobalHash
                        wrote_sw = 0
                        IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                            fi_sw = Subtract(JSVMState.fp, 1)
                            own_sw = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi_sw, 8)))
                            IfCondition And(NotEqual(own_sw, 0), NotEqual(own_sw, JSRTState.undef_val)) ThenBlock: {
                                IfCondition EqualTo(JSRT_ObjHas(own_sw, cpay), 1) ThenBlock: {
                                    JSRT_ObjSet(own_sw, cpay, box_n)
                                    wrote_sw = 1
                                }
                            }
                            IfCondition EqualTo(wrote_sw, 0) ThenBlock: {
                                fval_sw = Dereference(Add(JSVMClosure.frame_funcs, Multiply(fi_sw, 8)))
                                IfCondition NotEqual(fval_sw, 0) ThenBlock: {
                                    env_sw = JSRT_FuncPropGet(fval_sw, JSVMClosure.cenv_key)
                                    hops_sw = 0
                                    WhileLoop And(And(NotEqual(env_sw, 0), NotEqual(env_sw, JSRTState.undef_val)), LessThan(hops_sw, 64)) {
                                        IfCondition EqualTo(JSRT_GetType(env_sw), JSType.OBJECT) ThenBlock: {
                                            IfCondition EqualTo(JSRT_ObjHas(env_sw, cpay), 1) ThenBlock: {
                                                JSRT_ObjSet(env_sw, cpay, box_n)
                                                wrote_sw = 1
                                                slb = JSVMCallBuf.getter_buf
                                                SetByte(slb, 0, 95)
                                                SetByte(slb, 1, 95)
                                                SetByte(slb, 2, 115)
                                                SetByte(slb, 3, 108)
                                                SetByte(slb, 4, 95)
                                                si = 0
                                                sd = 0
                                                WhileLoop EqualTo(sd, 0) {
                                                    sb = GetByte(cpay, si)
                                                    SetByte(slb, Add(5, si), sb)
                                                    IfCondition EqualTo(sb, 0) ThenBlock: { sd = 1 }
                                                    si = Add(si, 1)
                                                }
                                                slot_v = JSRT_ObjGet(env_sw, slb)
                                                IfCondition EqualTo(JSRT_GetType(slot_v), JSType.NUMBER) ThenBlock: {
                                                    slot_n = Float_ToInt(JSRT_GetPayload(slot_v))
                                                    IfCondition EqualTo(env_sw, JSVMClosure.script_env) ThenBlock: {
                                                        StoreValue(Add(JSVMState.stack, Multiply(slot_n, 8)), box_n)
                                                    }
                                                }
                                                hops_sw = 64
                                            }
                                            IfCondition EqualTo(wrote_sw, 0) ThenBlock: {
                                                env_sw = JSRT_ObjGet(env_sw, JSVMClosure.parent_key)
                                            }
                                        } ElseBlock: {
                                            env_sw = 0
                                        }
                                        hops_sw = Add(hops_sw, 1)
                                    }
                                }
                            }
                        }
                        JSVM__SetGlobalHash(cpay, box_n)
                    }
                }
                ReturnValue(1)
            
    }
}

// RESOLVE_FREE (125) — M128e6v: capture free-var env for PutValue (A6)
            // Skip own frame env: free-var means outer binding (own may hold dual-bind
            // ghosts or not yet have eval-introduced locals). Walk __cenv only.
Function.JSVM_OpResolveFree {
    Output: Integer
    Body: {

                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                JSVMFreeRef.valid = 0
                JSVMFreeRef.env = 0
                JSVMFreeRef.name = 0
                found_rf = 0
                start_rf = JSRTState.undef_val
                IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                    fi_rf = Subtract(JSVMState.fp, 1)
                    fval_rf = Dereference(Add(JSVMClosure.frame_funcs, Multiply(fi_rf, 8)))
                    IfCondition NotEqual(fval_rf, 0) ThenBlock: {
                        start_rf = JSRT_FuncPropGet(fval_rf, JSVMClosure.cenv_key)
                    }
                }
                env_rf = start_rf
                hops_rf = 0
                WhileLoop And(And(NotEqual(env_rf, 0), NotEqual(env_rf, JSRTState.undef_val)), LessThan(hops_rf, 64)) {
                    IfCondition EqualTo(JSRT_GetType(env_rf), JSType.OBJECT) ThenBlock: {
                        IfCondition EqualTo(JSRT_ObjHas(env_rf, cpay), 1) ThenBlock: {
                            JSVMFreeRef.env = env_rf
                            JSVMFreeRef.name = cpay
                            JSVMFreeRef.valid = 1
                            found_rf = 1
                            hops_rf = 64
                        }
                        // M128e6aj: ObjectEnv HasBinding — HasProperty then unscopables
                        IfCondition EqualTo(found_rf, 0) ThenBlock: {
                            wobj_rf = JSRT_ObjGet(env_rf, "__with__")
                            wt_rf = JSRT_GetType(wobj_rf)
                            IfCondition Or(EqualTo(wt_rf, JSType.OBJECT), Or(EqualTo(wt_rf, JSType.FUNCTION), EqualTo(wt_rf, JSType.ARRAY))) ThenBlock: {
                                hb_rf = JSVM__HasProperty(wobj_rf, cpay)
                                IfCondition EqualTo(hb_rf, -1) ThenBlock: {
                                    ReturnValue(1)
                                }
                                has_rf = 0
                                IfCondition EqualTo(hb_rf, 1) ThenBlock: { has_rf = 1 }
                                IfCondition EqualTo(has_rf, 1) ThenBlock: {
                                    IfCondition NotEqual(JSVMSymbol.unscopables, 0) ThenBlock: {
                                        uk_rf = JSVM_SymbolToKey(JSVMSymbol.unscopables)
                                        IfCondition NotEqual(uk_rf, 0) ThenBlock: {
                                            JSRT__Push(env_rf)
                                            JSRT__Push(wobj_rf)
                                            uobj_rf = JSVM__GetProperty(wobj_rf, uk_rf)
                                            wobj_rf = JSRT__Pop()
                                            env_rf = JSRT__Pop()
                                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                                ReturnValue(1)
                                            }
                                            IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
                                                ReturnValue(1)
                                            }
                                            ut_rf = JSRT_GetType(uobj_rf)
                                            IfCondition Or(EqualTo(ut_rf, JSType.OBJECT), EqualTo(ut_rf, JSType.FUNCTION)) ThenBlock: {
                                                JSRT__Push(env_rf)
                                                JSRT__Push(wobj_rf)
                                                uflag_rf = JSVM__GetProperty(uobj_rf, cpay)
                                                wobj_rf = JSRT__Pop()
                                                env_rf = JSRT__Pop()
                                                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                                    ReturnValue(1)
                                                }
                                                IfCondition EqualTo(JSRT_IsTruthy(uflag_rf), 1) ThenBlock: {
                                                    has_rf = 0
                                                }
                                            }
                                        }
                                    }
                                }
                                IfCondition EqualTo(has_rf, 1) ThenBlock: {
                                    JSVMFreeRef.env = env_rf
                                    JSVMFreeRef.name = cpay
                                    JSVMFreeRef.valid = 1
                                    found_rf = 1
                                    hops_rf = 64
                                }
                            }
                        }
                        IfCondition EqualTo(found_rf, 0) ThenBlock: {
                            env_rf = JSRT_ObjGet(env_rf, JSVMClosure.parent_key)
                        }
                    } ElseBlock: {
                        env_rf = 0
                    }
                    hops_rf = Add(hops_rf, 1)
                }
                // script_env / eval_var_env fallbacks (let free-vars)
                IfCondition EqualTo(found_rf, 0) ThenBlock: {
                    IfCondition And(NotEqual(JSVMEvalState.eval_var_env, 0), NotEqual(JSVMEvalState.eval_var_env, JSRTState.undef_val)) ThenBlock: {
                        IfCondition EqualTo(JSRT_ObjHas(JSVMEvalState.eval_var_env, cpay), 1) ThenBlock: {
                            JSVMFreeRef.env = JSVMEvalState.eval_var_env
                            JSVMFreeRef.name = cpay
                            JSVMFreeRef.valid = 1
                            found_rf = 1
                        }
                    }
                }
                IfCondition EqualTo(found_rf, 0) ThenBlock: {
                    IfCondition And(NotEqual(JSVMClosure.script_env, 0), NotEqual(JSVMClosure.script_env, JSRTState.undef_val)) ThenBlock: {
                        IfCondition EqualTo(JSRT_ObjHas(JSVMClosure.script_env, cpay), 1) ThenBlock: {
                            JSVMFreeRef.env = JSVMClosure.script_env
                            JSVMFreeRef.name = cpay
                            JSVMFreeRef.valid = 1
                            found_rf = 1
                        }
                    }
                }
                ReturnValue(1)
            
    }
}
