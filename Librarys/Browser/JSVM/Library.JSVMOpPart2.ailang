// Library.JSVMOpPart2.ailang — JSVM opcode bodies
// Helpers called from JSVM_Step. Opcodes: JSVM_OpSetProp, JSVM_OpGetElem.
// Split from the JS engine so one function fits in context.
// FixedPools stay in the parent library. Function names are unchanged
// except for the new helpers this split adds.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// Drop own __get_/__set_ so a later data property is the one [[Get]] sees.
// Inherited accessors stay. Object-literal CreateDataProperty only.
Function.JSVM__LitDropAcc {
    Input: obj: Address
    Input: key: Address
    Output: Integer
    Body: {
        JSBridge__Push(obj)
        JSBridge__Push(key)
        gk = JSBridge__MakeAccKey(key, 0)
        key = JSBridge__Pop()
        obj = JSBridge__Pop()
        JSBridge__Push(obj)
        JSBridge__Push(key)
        JSBridge__Push(gk)
        sk = JSBridge__MakeAccKey(key, 1)
        gk = JSBridge__Pop()
        key = JSBridge__Pop()
        obj = JSBridge__Pop()
        JSBridge__Push(obj)
        JSBridge__Push(gk)
        JSBridge__Push(sk)
        hasg = JSRT_ObjHas(obj, gk)
        sk = JSBridge__Pop()
        gk = JSBridge__Pop()
        obj = JSBridge__Pop()
        IfCondition EqualTo(hasg, 1) ThenBlock: {
            JSBridge__Push(obj)
            JSBridge__Push(gk)
            JSBridge__Push(sk)
            JSRT_ObjDelete(obj, gk)
            sk = JSBridge__Pop()
            gk = JSBridge__Pop()
            obj = JSBridge__Pop()
        }
        JSBridge__Push(obj)
        JSBridge__Push(sk)
        hass = JSRT_ObjHas(obj, sk)
        sk = JSBridge__Pop()
        obj = JSBridge__Pop()
        IfCondition EqualTo(hass, 1) ThenBlock: {
            JSRT_ObjDelete(obj, sk)
        }
        ReturnValue(1)
    }
}

// SET_PROP (17) — 16-bit operand: constant pool index (property name)
            // Stack: [..., object, value]. Pop value, pop object, set prop.
            // Setter support: if obj has __set_<name>, invoke it (mirror of GET_PROP getters).
            // DOM interception: if obj has __dom_idx and prop is innerHTML/textContent,
            // JSBridge_SetProp updates the actual DOM tree.
Function.JSVM_OpSetProp {
    Output: Integer
    Body: {

                cidx = JSVM__Read16()
                JSVMTmp.ptr = JSVM__GetConstPayload(cidx)
                // PropTable stores this C pointer. A name that still sits in
                // compiler str_buf is overwritten when eval recompiles, so
                // copy it into the string slab first (same as SET_FRAME_ENV).
                IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                    JSVMEvalState.scratch_c = 0
                    IfCondition NotEqual(JSCompState.str_buf, 0) ThenBlock: {
                        IfCondition GreaterEqual(JSVMTmp.ptr, JSCompState.str_buf) ThenBlock: {
                            IfCondition LessThan(JSVMTmp.ptr, Add(JSCompState.str_buf, JSCompConst.STR_CAP)) ThenBlock: {
                                JSVMEvalState.scratch_c = 1
                            }
                        }
                    }
                    IfCondition EqualTo(JSVMEvalState.scratch_c, 1) ThenBlock: {
                        JSVMEvalState.scratch_n = 0
                        JSVMEvalState.scratch_c = 0
                        WhileLoop EqualTo(JSVMEvalState.scratch_c, 0) {
                            IfCondition EqualTo(GetByte(JSVMTmp.ptr, JSVMEvalState.scratch_n), 0) ThenBlock: {
                                JSVMEvalState.scratch_c = 1
                            } ElseBlock: {
                                JSVMEvalState.scratch_n = Add(JSVMEvalState.scratch_n, 1)
                                IfCondition GreaterThan(JSVMEvalState.scratch_n, 512) ThenBlock: {
                                    JSVMEvalState.scratch_c = 1
                                }
                            }
                        }
                        JSVMEvalState.scratch_n = Add(JSVMEvalState.scratch_n, 1)
                        JSVMEvalState.scratch_b = JSRT__StrSlabAlloc(JSVMEvalState.scratch_n)
                        IfCondition NotEqual(JSVMEvalState.scratch_b, 0) ThenBlock: {
                            MemoryCopy(JSVMEvalState.scratch_b, JSVMTmp.ptr, JSVMEvalState.scratch_n)
                            JSVMTmp.ptr = JSVMEvalState.scratch_b
                        }
                    }
                }
                JSVMTmp.val = JSVM__StackPop()
                JSVMTmp.addr = JSVM__StackPop()

                // Wave 3 D1: null/undefined base → TypeError
                set_obj_t = JSRT_GetType(JSVMTmp.addr)
                IfCondition Or(EqualTo(set_obj_t, JSType.NULL), EqualTo(set_obj_t, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot set property of null/undefined")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                // Primitive symbol: strict throws, sloppy drops the write.
                IfCondition EqualTo(JSVM_SymbolWriteBarrier(JSVMTmp.addr), 1) ThenBlock: {
                    ReturnValue(1)
                }

                // M105: .caller / .arguments poison on set (strict + bound)
                IfCondition EqualTo(set_obj_t, JSType.FUNCTION) ThenBlock: {
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        is_poison_s = 0
                        IfCondition EqualTo(JSRT_StrEq(JSVMTmp.ptr, "caller"), 1) ThenBlock: { is_poison_s = 1 }
                        IfCondition EqualTo(JSRT_StrEq(JSVMTmp.ptr, "arguments"), 1) ThenBlock: { is_poison_s = 1 }
                        IfCondition EqualTo(is_poison_s, 1) ThenBlock: {
                            fdesc_ps = JSRT_GetPayload(JSVMTmp.addr)
                            poison_ts = 0
                            IfCondition NotEqual(fdesc_ps, 0) ThenBlock: {
                                fparams_ps = Dereference(Add(fdesc_ps, 8))
                                IfCondition NotEqual(BitwiseAnd(fparams_ps, 536870912), 0) ThenBlock: {
                                    poison_ts = 1
                                }
                                IfCondition EqualTo(Dereference(fdesc_ps), -199) ThenBlock: {
                                    poison_ts = 1
                                }
                            }
                            IfCondition EqualTo(poison_ts, 1) ThenBlock: {
                                terr = JSVM_CreateTypedError("TypeError", "Cannot access caller or arguments of strict function")
                                JSVM_ThrowValue(terr)
                                ReturnValue(1)
                            }
                        }
                    }
                }

                // M26k/k.5/k.10/k.11: private set — mangled #name@id only
                // Setter brand: same function identity as home __set_#name
                // M128e7c: priv_set_init=1 when this SET is PrivateFieldAdd (field define)
                priv_set_init = 0
                IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                    IfCondition EqualTo(JSVM__IsMangledPrivate(JSVMTmp.ptr), 1) ThenBlock: {
                        IfCondition EqualTo(JSVMState.private_init, 0) ThenBlock: {
                            has_pf = 0
                            IfCondition Or(EqualTo(set_obj_t, JSType.OBJECT), EqualTo(set_obj_t, JSType.FUNCTION)) ThenBlock: {
                                // Build __set_#name
                                sk_chk = JSVMCallBuf.getter_buf
                                SetByte(sk_chk, 0, 95)
                                SetByte(sk_chk, 1, 95)
                                SetByte(sk_chk, 2, 115)
                                SetByte(sk_chk, 3, 101)
                                SetByte(sk_chk, 4, 116)
                                SetByte(sk_chk, 5, 95)
                                si = 0
                                sdone = 0
                                WhileLoop EqualTo(sdone, 0) {
                                    sb = GetByte(JSVMTmp.ptr, si)
                                    SetByte(sk_chk, Add(6, si), sb)
                                    IfCondition EqualTo(sb, 0) ThenBlock: { sdone = 1 }
                                    si = Add(si, 1)
                                }
                                // Own data field
                                has_pf = JSRT_ObjHas(JSVMTmp.addr, JSVMTmp.ptr)
                                IfCondition EqualTo(has_pf, 1) ThenBlock: {
                                    // Skip if accessor placeholder only
                                    IfCondition EqualTo(JSRT_ObjHas(JSVMTmp.addr, sk_chk), 1) ThenBlock: {
                                        has_pf = 0
                                    }
                                }
                                IfCondition EqualTo(has_pf, 0) ThenBlock: {
                                    home_p = 0
                                    IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
                                        cal_f = Dereference(Add(JSVMClosure.frame_funcs, Multiply(Subtract(JSVMState.fp, 1), 8)))
                                        IfCondition EqualTo(JSRT_GetType(cal_f), JSType.FUNCTION) ThenBlock: {
                                            home_p = JSRT_FuncPropGet(cal_f, "__home_proto__")
                                        }
                                    }
                                    // M128e7m: direct eval at fp=0 — outer method/field_init home
                                    IfCondition EqualTo(home_p, 0) ThenBlock: {
                                        IfCondition And(EqualTo(JSVMEvalState.is_direct, 1), GreaterThan(JSVMEvalState.save_fp, 0)) ThenBlock: {
                                            IfCondition NotEqual(JSVMClosure.frame_funcs, 0) ThenBlock: {
                                                cal_ev = Dereference(Add(JSVMClosure.frame_funcs, Multiply(Subtract(JSVMEvalState.save_fp, 1), 8)))
                                                IfCondition EqualTo(JSRT_GetType(cal_ev), JSType.FUNCTION) ThenBlock: {
                                                    home_p = JSRT_FuncPropGet(cal_ev, "__home_proto__")
                                                }
                                            }
                                        }
                                    }
                                    ht = JSRT_GetType(home_p)
                                    IfCondition Or(EqualTo(ht, JSType.OBJECT), EqualTo(ht, JSType.FUNCTION)) ThenBlock: {
                                        IfCondition EqualTo(JSRT_ObjHas(home_p, sk_chk), 1) ThenBlock: {
                                            // M128e7k/e7q: same setter on OWN instance only
                                            home_set = JSRT_ObjGet(home_p, sk_chk)
                                            brand_ok_s = 0
                                            IfCondition EqualTo(JSRT_ObjHas(JSVMTmp.addr, sk_chk), 1) ThenBlock: {
                                                chain_set = JSRT_ObjGet(JSVMTmp.addr, sk_chk)
                                                IfCondition EqualTo(home_set, chain_set) ThenBlock: {
                                                    brand_ok_s = 1
                                                } ElseBlock: {
                                                    IfCondition And(EqualTo(JSRT_GetType(home_set), JSType.FUNCTION), EqualTo(JSRT_GetType(chain_set), JSType.FUNCTION)) ThenBlock: {
                                                        hs_fd = Dereference(Add(home_set, 8))
                                                        cs_fd = Dereference(Add(chain_set, 8))
                                                        IfCondition And(NotEqual(hs_fd, 0), EqualTo(hs_fd, cs_fd)) ThenBlock: {
                                                            brand_ok_s = 1
                                                        }
                                                    }
                                                }
                                            }
                                            IfCondition EqualTo(brand_ok_s, 0) ThenBlock: {
                                                terr = JSVM_CreateTypedError("TypeError", "Cannot write private member")
                                                JSVM_ThrowValue(terr)
                                                ReturnValue(1)
                                            }
                                            has_pf = 1
                                        }
                                    }
                                }
                                // M128e7q: own setter install brands even when home_p
                                // missing (nested function/arrow private access).
                                // Do NOT walk [[Prototype]] — that false-brands before super.
                                IfCondition EqualTo(has_pf, 0) ThenBlock: {
                                    IfCondition EqualTo(JSRT_ObjHas(JSVMTmp.addr, sk_chk), 1) ThenBlock: {
                                        has_pf = 1
                                    }
                                }
                            }
                            // Private method install: function value (class body method define)
                            IfCondition EqualTo(has_pf, 0) ThenBlock: {
                                IfCondition EqualTo(JSRT_GetType(JSVMTmp.val), JSType.FUNCTION) ThenBlock: {
                                    has_pf = 1
                                }
                            }
                            IfCondition EqualTo(has_pf, 0) ThenBlock: {
                                terr = JSVM_CreateTypedError("TypeError", "Cannot write private member")
                                JSVM_ThrowValue(terr)
                                ReturnValue(1)
                            }
                            // M128e7c: PrivateSet method kind — non-writable private method
                            // (attrs !W set at install; also throw if entry is function and
                            // not an accessor — field that holds a function is still data).
                            IfCondition EqualTo(JSRT_ObjHas(JSVMTmp.addr, sk_chk), 0) ThenBlock: {
                                // no setter: data private
                                // If not own (method lives on home/proto) → method, throw
                                IfCondition EqualTo(JSRT_ObjHas(JSVMTmp.addr, JSVMTmp.ptr), 0) ThenBlock: {
                                    // On chain as method — PrivateSet method kind
                                    IfCondition EqualTo(JSRT_GetType(JSRT_ObjGet(JSVMTmp.addr, JSVMTmp.ptr)), JSType.FUNCTION) ThenBlock: {
                                        terr = JSVM_CreateTypedError("TypeError", "Cannot write private method")
                                        JSVM_ThrowValue(terr)
                                        ReturnValue(1)
                                    }
                                } ElseBlock: {
                                    // Own: method install stamps !W; field is writable
                                    can_pm = JSBridge_CanAssign(JSVMTmp.addr, JSVMTmp.ptr)
                                    IfCondition EqualTo(can_pm, 0) ThenBlock: {
                                        terr = JSVM_CreateTypedError("TypeError", "Cannot write private method")
                                        JSVM_ThrowValue(terr)
                                        ReturnValue(1)
                                    }
                                }
                            }
                        } ElseBlock: {
                            // M26k.5: pulse consumed after this field define SET
                            // M128e7d: PrivateFieldAdd — non-extensible / already present
                            priv_set_init = 1
                            JSVMState.private_init = 0
                            // [[Extensible]] false → TypeError
                            IfCondition Or(EqualTo(set_obj_t, JSType.OBJECT), EqualTo(set_obj_t, JSType.FUNCTION)) ThenBlock: {
                                not_ext = 0
                                IfCondition EqualTo(JSRT_ObjHas(JSVMTmp.addr, "__extensible__"), 1) ThenBlock: {
                                    ex_pf = JSRT_ObjGet(JSVMTmp.addr, "__extensible__")
                                    // preventExtensions stores boolean false
                                    IfCondition EqualTo(JSRT_IsTruthy(ex_pf), 0) ThenBlock: {
                                        not_ext = 1
                                    }
                                }
                                IfCondition EqualTo(JSRT_ObjHas(JSVMTmp.addr, "__frozen__"), 1) ThenBlock: {
                                    not_ext = 1
                                }
                                IfCondition EqualTo(JSRT_ObjHas(JSVMTmp.addr, "__sealed__"), 1) ThenBlock: {
                                    not_ext = 1
                                }
                                IfCondition EqualTo(not_ext, 1) ThenBlock: {
                                    terr = JSVM_CreateTypedError("TypeError", "Cannot add private field to non-extensible object")
                                    JSVM_ThrowValue(terr)
                                    ReturnValue(1)
                                }
                                // Already has private field → TypeError (double PrivateFieldAdd)
                                IfCondition EqualTo(JSRT_ObjHas(JSVMTmp.addr, JSVMTmp.ptr), 1) ThenBlock: {
                                    terr = JSVM_CreateTypedError("TypeError", "Cannot add private field that already exists")
                                    JSVM_ThrowValue(terr)
                                    ReturnValue(1)
                                }
                            }
                        }
                    }
                }

                // Check for setter: __set_<name> (OBJECT + FUNCTION + ARRAY)
                // M26k.9: field_define → CreateDataPropertyOrThrow (skip inherited setters)
                // lit_define: object-literal CreateDataProperty, same skip.
                // M128e7bz: ARRAY — defineProperty(a,"0",{set}) then a[0]= / a["0"]= via SET_PROP
                IfCondition And(EqualTo(JSVMState.lit_define, 0), And(EqualTo(JSVMState.field_define, 0), Or(EqualTo(set_obj_t, JSType.OBJECT), Or(EqualTo(set_obj_t, JSType.FUNCTION), EqualTo(set_obj_t, JSType.ARRAY))))) ThenBlock: {
                    sk_buf2 = JSVMCallBuf.getter_buf
                    SetByte(sk_buf2, 0, 95)
                    SetByte(sk_buf2, 1, 95)
                    SetByte(sk_buf2, 2, 115)
                    SetByte(sk_buf2, 3, 101)
                    SetByte(sk_buf2, 4, 116)
                    SetByte(sk_buf2, 5, 95)
                    JSVMTmp.idx = 0
                    JSVMTmp.done = 0
                    WhileLoop EqualTo(JSVMTmp.done, 0) {
                        JSVMTmp.type = GetByte(JSVMTmp.ptr, JSVMTmp.idx)
                        SetByte(sk_buf2, Add(6, JSVMTmp.idx), JSVMTmp.type)
                        IfCondition EqualTo(JSVMTmp.type, 0) ThenBlock: {
                            JSVMTmp.done = 1
                        }
                        JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                    }
                    // ObjGet may clobber temps — save obj/val across call
                    JSRT__Push(JSVMTmp.addr)
                    JSRT__Push(JSVMTmp.val)
                    setter_func = JSRT_ObjGet(JSVMTmp.addr, sk_buf2)
                    JSVMTmp.val = JSRT__Pop()
                    JSVMTmp.addr = JSRT__Pop()
                    st = JSRT_GetType(setter_func)
                    IfCondition EqualTo(st, JSType.FUNCTION) ThenBlock: {
                        // Bind this = receiver; call setter(value); restore this
                        save_this_s = JSVM__GetGlobal("this")
                        JSVM__SetGlobal("this", JSVMTmp.addr)
                        arg_buf_s = JSVMCallBuf.buf
                        StoreValue(arg_buf_s, JSVMTmp.val)
                        JSVM__CallFunc(setter_func, arg_buf_s, 1)
                        JSVM__SetGlobal("this", save_this_s)
                        // M128e7bl: setter throw must rethrow (put-prop-ref-user-err)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend_set = JSVMCall.thrown_val
                            IfCondition EqualTo(pend_set, 0) ThenBlock: {
                                pend_set = JSVMState.exc_val
                            }
                            JSVMCall.thrown_val = 0
                            JSVMState.exc_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition And(NotEqual(pend_set, 0), NotEqual(pend_set, JSRTState.undef_val)) ThenBlock: {
                                JSVM_ThrowValue(pend_set)
                            }
                            ReturnValue(1)
                        }
                        ReturnValue(1)
                    }
                    // M26k/k.10: private getter-only (mangled #name@id)
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        IfCondition EqualTo(JSVM__IsMangledPrivate(JSVMTmp.ptr), 1) ThenBlock: {
                            IfCondition EqualTo(JSVMState.private_init, 0) ThenBlock: {
                                gk_only = JSVMCallBuf.getter_buf
                                SetByte(gk_only, 0, 95)
                                SetByte(gk_only, 1, 95)
                                SetByte(gk_only, 2, 103)
                                SetByte(gk_only, 3, 101)
                                SetByte(gk_only, 4, 116)
                                SetByte(gk_only, 5, 95)
                                gi2 = 0
                                gdone2 = 0
                                WhileLoop EqualTo(gdone2, 0) {
                                    gb2 = GetByte(JSVMTmp.ptr, gi2)
                                    SetByte(gk_only, Add(6, gi2), gb2)
                                    IfCondition EqualTo(gb2, 0) ThenBlock: { gdone2 = 1 }
                                    gi2 = Add(gi2, 1)
                                }
                                IfCondition NotEqual(JSRT_ObjHasOnChain(JSVMTmp.addr, gk_only), 0) ThenBlock: {
                                    terr = JSVM_CreateTypedError("TypeError", "Cannot write private getter-only member")
                                    JSVM_ThrowValue(terr)
                                    ReturnValue(1)
                                }
                            }
                        }
                    }
                }

                // M29e: array.length = N — ToUint32 check + truncate/grow
                IfCondition EqualTo(set_obj_t, JSType.ARRAY) ThenBlock: {
                    is_alen_set = 0
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        IfCondition EqualTo(GetByte(JSVMTmp.ptr, 0), 108) ThenBlock: {
                            IfCondition EqualTo(GetByte(JSVMTmp.ptr, 1), 101) ThenBlock: {
                                IfCondition EqualTo(GetByte(JSVMTmp.ptr, 2), 110) ThenBlock: {
                                    IfCondition EqualTo(GetByte(JSVMTmp.ptr, 3), 103) ThenBlock: {
                                        IfCondition EqualTo(GetByte(JSVMTmp.ptr, 4), 116) ThenBlock: {
                                            IfCondition EqualTo(GetByte(JSVMTmp.ptr, 5), 104) ThenBlock: {
                                                IfCondition EqualTo(GetByte(JSVMTmp.ptr, 6), 0) ThenBlock: {
                                                    is_alen_set = 1
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(is_alen_set, 1) ThenBlock: {
                        // Save arr — ToNumber/Create clobber JSVMTmp
                        alen_arr = JSVMTmp.addr
                        // M128e7bz: honor length [[Writable]] (defineProperty !W)
                        can_len = JSBridge_CanAssign(alen_arr, JSVMTmp.ptr)
                        IfCondition EqualTo(can_len, 0) ThenBlock: {
                            IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                                terr = JSVM_CreateTypedError("TypeError", "Cannot assign to non-writable property")
                                JSVM_ThrowValue(terr)
                                ReturnValue(1)
                            }
                            ReturnValue(1)
                        }
                        // ToNumber returns IEEE float bits (not host int)
                        n_bits = JSRT_ToNumber(JSVMTmp.val)
                        bad_len = 0
                        // n < 0
                        IfCondition EqualTo(Float_Lt(n_bits, Float_FromInt(0)), 1) ThenBlock: {
                            bad_len = 1
                        }
                        // n >= 2^32
                        IfCondition EqualTo(Float_Lt(n_bits, Float_FromInt(4294967296)), 0) ThenBlock: {
                            bad_len = 1
                        }
                        ni_len = Float_ToInt(n_bits)
                        // fractional: Float_FromInt(trunc) != n
                        IfCondition EqualTo(Float_Eq(Float_FromInt(ni_len), n_bits), 0) ThenBlock: {
                            bad_len = 1
                        }
                        IfCondition EqualTo(bad_len, 1) ThenBlock: {
                            terr = JSVM_CreateTypedError("RangeError", "Invalid array length")
                            JSVM_ThrowValue(terr)
                            ReturnValue(1)
                        }
                        // M128e7bz: ArrSetLen returns 0 if non-configurable element blocks truncate
                        rc_len = JSRT_ArrSetLen(alen_arr, ni_len)
                        IfCondition EqualTo(rc_len, 0) ThenBlock: {
                            IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                                terr = JSVM_CreateTypedError("TypeError", "Cannot delete non-configurable array element")
                                JSVM_ThrowValue(terr)
                                ReturnValue(1)
                            }
                            ReturnValue(1)
                        }
                        ReturnValue(1)
                    }
                }

                // M48: SetFunctionName — function.name is !W C; ordinary assign
                // fails CanAssign. SetFunctionName uses [[DefineOwnProperty]].
                // M128e7bo: only "name" (not "length") — Function.length = 42 must
                // throw in strict (11.13.1-4-6-s). Length goes through CanAssign.
                IfCondition EqualTo(set_obj_t, JSType.FUNCTION) ThenBlock: {
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrEq(JSVMTmp.ptr, "name"), 1) ThenBlock: {
                            // name is !W. Ordinary assign must not stick.
                            // field_define and an explicit writable bit still write.
                            name_w = 0
                            IfCondition EqualTo(JSVMState.field_define, 1) ThenBlock: { name_w = 1 }
                            JSRT__Push(JSVMTmp.addr)
                            JSRT__Push(JSVMTmp.val)
                            JSRT__Push(JSVMTmp.ptr)
                            ab_nm = JSBridge__GetAttrBits(JSVMTmp.addr, JSVMTmp.ptr)
                            JSVMTmp.ptr = JSRT__Pop()
                            JSVMTmp.val = JSRT__Pop()
                            JSVMTmp.addr = JSRT__Pop()
                            IfCondition NotEqual(BitwiseAnd(ab_nm, 1), 0) ThenBlock: { name_w = 1 }
                            IfCondition EqualTo(name_w, 1) ThenBlock: {
                                JSRT_FuncPropSet(JSVMTmp.addr, JSVMTmp.ptr, JSVMTmp.val)
                                IfCondition EqualTo(JSRT_GetType(JSVMTmp.val), JSType.FUNCTION) ThenBlock: {
                                    JSBridge__SetAttrBits(JSVMTmp.addr, JSVMTmp.ptr, 5)
                                    JSRT_FuncPropSet(JSVMTmp.val, "__home_proto__", JSVMTmp.addr)
                                }
                            } ElseBlock: {
                                IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                                    terr = JSVM_CreateTypedError("TypeError", "Cannot assign to non-writable property")
                                    JSVM_ThrowValue(terr)
                                    ReturnValue(1)
                                }
                            }
                            ReturnValue(1)
                        }
                    }
                }

                // M128e7b: CreateDataPropertyOrThrow observes Proxy [[DefineOwnProperty]]
                // (class fields use field_define=1 around SET_PROP in __field_init__).
                IfCondition EqualTo(JSVMState.field_define, 1) ThenBlock: {
                    IfCondition EqualTo(JSVM__IsProxy(JSVMTmp.addr), 1) ThenBlock: {
                        hnd_fd = JSRT_ObjGet(JSVMTmp.addr, "__p_h__")
                        tgt_fd = JSRT_ObjGet(JSVMTmp.addr, "__p_t__")
                        trap_fd = JSRT_ObjGet(hnd_fd, "defineProperty")
                        IfCondition EqualTo(JSRT_GetType(trap_fd), JSType.FUNCTION) ThenBlock: {
                            // Build data descriptor {value, writable:true, enumerable:true, configurable:true}
                            desc_fd = JSRT_CreateObject()
                            JSRT_ObjSet(desc_fd, "value", JSVMTmp.val)
                            JSRT_ObjSet(desc_fd, "writable", JSRT_True())
                            JSRT_ObjSet(desc_fd, "enumerable", JSRT_True())
                            JSRT_ObjSet(desc_fd, "configurable", JSRT_True())
                            kv_fd = JSRT__AllocValue()
                            StoreValue(kv_fd, JSType.STRING)
                            StoreValue(Add(kv_fd, 8), JSVMTmp.ptr)
                            ab_fd = JSVMCallBuf.buf
                            StoreValue(ab_fd, tgt_fd)
                            StoreValue(Add(ab_fd, 8), kv_fd)
                            StoreValue(Add(ab_fd, 16), desc_fd)
                            save_this_fd = JSVM__GetGlobal("this")
                            JSVM__SetGlobal("this", hnd_fd)
                            JSVM__CallFunc(trap_fd, ab_fd, 3)
                            JSVM__SetGlobal("this", save_this_fd)
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                ReturnValue(1)
                            }
                            ReturnValue(1)
                        }
                        // No trap — define on target
                        JSVMTmp.addr = tgt_fd
                        set_obj_t = JSRT_GetType(JSVMTmp.addr)
                    }
                }

                // M128e7b: SetFunctionName for anon function values on class fields
                // (field_define=1). M128e7bo: NOT ordinary assign o.attr = function(){}
                // (fn-name-lhs-member — MemberExpression is not IdentifierRef).
                // Object-literal PropertyDefinition uses SET_PROP_COMPUTED path.
                IfCondition EqualTo(JSVMState.field_define, 1) ThenBlock: {
                    IfCondition EqualTo(JSRT_GetType(JSVMTmp.val), JSType.FUNCTION) ThenBlock: {
                        IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                            cur_nm_sp = JSRT_FuncPropGet(JSVMTmp.val, "name")
                            nm_empty_sp = 0
                            IfCondition EqualTo(cur_nm_sp, 0) ThenBlock: {
                                nm_empty_sp = 1
                            } ElseBlock: {
                                IfCondition EqualTo(cur_nm_sp, JSRTState.undef_val) ThenBlock: {
                                    nm_empty_sp = 1
                                } ElseBlock: {
                                    IfCondition EqualTo(JSRT_GetType(cur_nm_sp), JSType.STRING) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrEq(JSRT_GetPayload(cur_nm_sp), ""), 1) ThenBlock: {
                                            nm_empty_sp = 1
                                        }
                                    }
                                }
                            }
                            IfCondition EqualTo(nm_empty_sp, 1) ThenBlock: {
                                nk_sp = JSRT__AllocValue()
                                StoreValue(nk_sp, JSType.STRING)
                                StoreValue(Add(nk_sp, 8), JSVMTmp.ptr)
                                JSVM_SetFunctionName(JSVMTmp.val, nk_sp)
                            }
                        }
                    }
                }

                JSVMTmp.result = JSBridge_SetProp(JSVMTmp.addr, JSVMTmp.ptr, JSVMTmp.val)
                IfCondition EqualTo(JSVMTmp.result, 0) ThenBlock: {
                    // Wave 2: honor writable / freeze / non-extensible.
                    // lit_define is CreateDataProperty: an inherited !W accessor
                    // must not block the own data property.
                    can = 1
                    IfCondition EqualTo(JSVMState.lit_define, 0) ThenBlock: {
                        can = JSBridge_CanAssign(JSVMTmp.addr, JSVMTmp.ptr)
                    }
                    IfCondition EqualTo(can, 1) ThenBlock: {
                        IfCondition EqualTo(JSVMState.lit_define, 1) ThenBlock: {
                            JSBridge__Push(JSVMTmp.addr)
                            JSBridge__Push(JSVMTmp.ptr)
                            JSBridge__Push(JSVMTmp.val)
                            JSVM__LitDropAcc(JSVMTmp.addr, JSVMTmp.ptr)
                            JSVMTmp.val = JSBridge__Pop()
                            JSVMTmp.ptr = JSBridge__Pop()
                            JSVMTmp.addr = JSBridge__Pop()
                        }
                        JSRT_ObjSet(JSVMTmp.addr, JSVMTmp.ptr, JSVMTmp.val)
                        // Global object data properties are identifier bindings
                        // (this.p1 = 1). The 128-slot table is often full of
                        // builtins plus __a_ keys, so ObjSet drops the name
                        // and a bare read throws ReferenceError.
                        IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrEq(JSVMTmp.ptr, "__proto__"), 0) ThenBlock: {
                                gt_bind = JSVM__GlobalObjPtr()
                                // this and globalThis are two gvals with one prop table.
                                same_g = 0
                                IfCondition EqualTo(gt_bind, JSVMTmp.addr) ThenBlock: { same_g = 1 }
                                IfCondition EqualTo(same_g, 0) ThenBlock: {
                                    IfCondition And(NotEqual(gt_bind, 0), NotEqual(JSVMTmp.addr, 0)) ThenBlock: {
                                        IfCondition EqualTo(Dereference(gt_bind), JSType.OBJECT) ThenBlock: {
                                            IfCondition EqualTo(Dereference(JSVMTmp.addr), JSType.OBJECT) ThenBlock: {
                                                IfCondition EqualTo(Dereference(Add(gt_bind, 8)), Dereference(Add(JSVMTmp.addr, 8))) ThenBlock: {
                                                    same_g = 1
                                                }
                                            }
                                        }
                                    }
                                }
                                IfCondition EqualTo(same_g, 1) ThenBlock: {
                                    JSVM__SetGlobalHash(JSVMTmp.ptr, JSVMTmp.val)
                                }
                            }
                        }
                        // M26k.11: stamp home object on methods (private brand checks)
                        IfCondition EqualTo(JSRT_GetType(JSVMTmp.val), JSType.FUNCTION) ThenBlock: {
                            IfCondition EqualTo(JSRT_GetType(JSVMTmp.addr), JSType.OBJECT) ThenBlock: {
                                JSRT_FuncPropSet(JSVMTmp.val, "__home_proto__", JSVMTmp.addr)
                            }
                            IfCondition EqualTo(JSRT_GetType(JSVMTmp.addr), JSType.FUNCTION) ThenBlock: {
                                JSRT_FuncPropSet(JSVMTmp.val, "__home_proto__", JSVMTmp.addr)
                            }
                        }
                        // Mapped arguments via SET_PROP (arguments[0] compiled as prop sometimes)
                        // Only sync if writing the *current* frame's arguments (nested calls rebind).
                        IfCondition EqualTo(JSVM_IsArgumentsObj(JSVMTmp.addr), 1) ThenBlock: {
                            k0 = GetByte(JSVMTmp.ptr, 0)
                            IfCondition And(GreaterEqual(k0, 48), LessThan(k0, 58)) ThenBlock: {
                                k1 = GetByte(JSVMTmp.ptr, 1)
                                IfCondition EqualTo(k1, 0) ThenBlock: {
                                    // M102: always sync formals (avoid pointer-eq IfCurrent miss)
                                    JSVM_SyncArgumentsToLocal(Subtract(k0, 48), JSVMTmp.val)
                                }
                            }
                        }
                        // M49: function props — object methods W|E|C; class methods W|!E|C.
                        // Class proto has own "constructor"; statics live on FUNCTION.
                        // M128e7c: private methods (!priv_set_init) are !W !E C (PrivateSet throws).
                        // Private fields (priv_set_init) keep DEFAULT even when value is a function.
                        IfCondition EqualTo(JSRT_GetType(JSVMTmp.val), JSType.FUNCTION) ThenBlock: {
                            abits_m = JSAttr.DEFAULT
                            IfCondition And(NotEqual(JSVMTmp.ptr, 0), EqualTo(JSVM__IsMangledPrivate(JSVMTmp.ptr), 1)) ThenBlock: {
                                IfCondition EqualTo(priv_set_init, 0) ThenBlock: {
                                    abits_m = 4
                                }
                            } ElseBlock: {
                                IfCondition EqualTo(JSRT_GetType(JSVMTmp.addr), JSType.FUNCTION) ThenBlock: {
                                    abits_m = 5
                                } ElseBlock: {
                                    // M128e7j: proto.constructor is W|!E|C (bits=5), not DEFAULT
                                    IfCondition EqualTo(JSRT_StrEq(JSVMTmp.ptr, "constructor"), 1) ThenBlock: {
                                        abits_m = 5
                                    } ElseBlock: {
                                        IfCondition EqualTo(JSRT_ObjHas(JSVMTmp.addr, "constructor"), 1) ThenBlock: {
                                            abits_m = 5
                                        }
                                    }
                                }
                            }
                            JSBridge__SetAttrBits(JSVMTmp.addr, JSVMTmp.ptr, abits_m)
                        }
                        // M128e7j: after MakeConstructor sets class .prototype, stamp !W!E!C
                        // so later static ['prototype'] / assign throws. Initial set first.
                        IfCondition EqualTo(JSRT_GetType(JSVMTmp.addr), JSType.FUNCTION) ThenBlock: {
                            IfCondition And(NotEqual(JSVMTmp.ptr, 0), EqualTo(JSRT_StrEq(JSVMTmp.ptr, "prototype"), 1)) ThenBlock: {
                                fdesc_sp = Dereference(Add(JSVMTmp.addr, 8))
                                IfCondition NotEqual(fdesc_sp, 0) ThenBlock: {
                                    ck_sp = Dereference(Add(fdesc_sp, 88))
                                    IfCondition Or(EqualTo(ck_sp, 1), EqualTo(ck_sp, 2)) ThenBlock: {
                                        JSBridge__SetAttrBits(JSVMTmp.addr, JSVMTmp.ptr, 0)
                                    }
                                }
                            }
                        }
                    } ElseBlock: {
                        // Wave 3: strict mode — assign to non-writable throws TypeError
                        // M128e7j: class .prototype is !W — always throw (class eval may be non-strict frame)
                        force_te = JSVMState.is_strict
                        IfCondition EqualTo(set_obj_t, JSType.FUNCTION) ThenBlock: {
                            IfCondition And(NotEqual(JSVMTmp.ptr, 0), EqualTo(JSRT_StrEq(JSVMTmp.ptr, "prototype"), 1)) ThenBlock: {
                                force_te = 1
                            }
                        }
                        IfCondition EqualTo(force_te, 1) ThenBlock: {
                            terr = JSVM_CreateTypedError("TypeError", "Cannot assign to non-writable property")
                            JSVM_ThrowValue(terr)
                            ReturnValue(1)
                        }
                    }
                }
                // M78: private methods — Function.name is "#desc" (not mangled @brand)
                // Runs after either SetProp path so both install routes set name.
                IfCondition EqualTo(JSRT_GetType(JSVMTmp.val), JSType.FUNCTION) ThenBlock: {
                    IfCondition And(NotEqual(JSVMTmp.ptr, 0), EqualTo(JSVM__IsMangledPrivate(JSVMTmp.ptr), 1)) ThenBlock: {
                        pn_len = 0
                        pndone = 0
                        WhileLoop EqualTo(pndone, 0) {
                            pnb = GetByte(JSVMTmp.ptr, pn_len)
                            IfCondition Or(EqualTo(pnb, 0), EqualTo(pnb, 64)) ThenBlock: {
                                pndone = 1
                            } ElseBlock: {
                                pn_len = Add(pn_len, 1)
                                IfCondition GreaterThan(pn_len, 200) ThenBlock: { pndone = 1 }
                            }
                        }
                        IfCondition GreaterThan(pn_len, 0) ThenBlock: {
                            pn_copy = JSRT__StrSlabAlloc(Add(pn_len, 1))
                            IfCondition NotEqual(pn_copy, 0) ThenBlock: {
                                MemoryCopy(pn_copy, JSVMTmp.ptr, pn_len)
                                SetByte(pn_copy, pn_len, 0)
                                pn_str = JSRT_CreateString(pn_copy)
                                JSRT_FuncPropSet(JSVMTmp.val, "name", pn_str)
                            }
                        }
                    }
                }
                ReturnValue(1)
            
    }
}

// GET_ELEM (18) — pop index, pop array/string, push elem
Function.JSVM_OpGetElem {
    Output: Integer
    Body: {

                idx_val = JSVM__StackPop()
                arr_val = JSVM__StackPop()
                JSVMTmp.type = JSRT_GetType(arr_val)
                // Wave 3 D1: null/undefined base → TypeError
                IfCondition Or(EqualTo(JSVMTmp.type, JSType.NULL), EqualTo(JSVMTmp.type, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot read property of null/undefined")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                // M128e7d0/e7du: TypedArray [[Get]] — number + canonical digit strings
                IfCondition EqualTo(JSVMTmp.type, JSType.OBJECT) ThenBlock: {
                    IfCondition EqualTo(JSVM_IsTypedArray(arr_val), 1) ThenBlock: {
                        ta_use_idx = 0
                        ta_idx = 0
                        IfCondition EqualTo(JSRT_GetType(idx_val), JSType.NUMBER) ThenBlock: {
                            ta_idx = Float_ToInt(JSRT_GetPayload(idx_val))
                            ta_use_idx = 1
                        }
                        IfCondition EqualTo(JSRT_GetType(idx_val), JSType.STRING) ThenBlock: {
                            kptr_ta = JSRT_GetPayload(idx_val)
                            IfCondition NotEqual(kptr_ta, 0) ThenBlock: {
                                can_ta = JSVM_TA_ParseCanonicalIndex(kptr_ta)
                                IfCondition NotEqual(can_ta, -2) ThenBlock: {
                                    ta_idx = can_ta
                                    ta_use_idx = 1
                                } ElseBlock: {
                                    IfCondition EqualTo(JSRT_StrEq(kptr_ta, "-0"), 1) ThenBlock: {
                                        ta_idx = -1
                                        ta_use_idx = 1
                                    }
                                }
                            }
                        }
                        IfCondition EqualTo(ta_use_idx, 1) ThenBlock: {
                            elem = JSVM_TA_Get(arr_val, ta_idx)
                            JSVM__StackPush(elem)
                            ReturnValue(1)
                        }
                        // named props (buffer, length, methods) fall through to ObjGet
                    }
                }
                IfCondition EqualTo(JSVMTmp.type, JSType.STRING) ThenBlock: {
                    // Symbol keys (@@iterator) are not code-unit indexes.
                    JSRTStack.hold2 = idx_val
                    IfCondition EqualTo(JSVM_IsSymbol(JSRTStack.hold2), 1) ThenBlock: {
                        JSRTStack.hold = JSVM_ToPropertyKey(JSRTStack.hold2)
                        str_g = JSVM__GetGlobal("String")
                        JSRTStack.hold2 = str_g
                        str_pr = JSRT_ObjGet(JSRTStack.hold2, "prototype")
                        JSRTStack.hold2 = str_pr
                        elem = JSRT_ObjGet(JSRTStack.hold2, JSRTStack.hold)
                        JSVM__StackPush(elem)
                        ReturnValue(1)
                    }
                    // String indexing: return single code unit (M31a UTF-16)
                    idx_num = Float_ToInt(JSRT_ToNumber(idx_val))
                    JSVMTmp.ptr = JSRT_GetPayload(arr_val)
                    sl_idx = JSRT_StrLen(JSVMTmp.ptr)
                    IfCondition And(GreaterEqual(idx_num, 0), LessThan(idx_num, sl_idx)) ThenBlock: {
                        elem = JSRT_CreateStringSlice(JSVMTmp.ptr, idx_num, 1)
                        JSVM__StackPush(elem)
                        ReturnValue(1)
                    }
                    JSVM__StackPush(JSRT_Undefined())
                    ReturnValue(1)
                }
                // M37: FUNCTION is object-like for indexed props (array methods on callables)
                IfCondition Or(EqualTo(JSVMTmp.type, JSType.OBJECT), EqualTo(JSVMTmp.type, JSType.FUNCTION)) ThenBlock: {
                    // Proxy [[Get]] including array-index reads of the target.
                    JSVMTmp.addr = arr_val
                    JSVMTmp.val = idx_val
                    ipx = JSVM__IsProxy(JSVMTmp.addr)
                    arr_val = JSVMTmp.addr
                    idx_val = JSVMTmp.val
                    IfCondition EqualTo(ipx, 1) ThenBlock: {
                        JSVMTmp.ptr = JSVM_ToPropertyKey(JSVMTmp.val)
                        IfCondition EqualTo(JSVMTmp.ptr, 0) ThenBlock: {
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(1) }
                            IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: { ReturnValue(1) }
                        }
                        elem = JSVM__GetProperty(JSVMTmp.addr, JSVMTmp.ptr)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(1) }
                        IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: { ReturnValue(1) }
                        JSVM__StackPush(elem)
                        ReturnValue(1)
                    }
                    // Object/Function property access — ToPropertyKey (Symbol → @@sN)
                    JSVMTmp.ptr = JSVM_ToPropertyKey(idx_val)
                    // M19d: toString/valueOf throw during ToPropertyKey
                    IfCondition EqualTo(JSVMTmp.ptr, 0) ThenBlock: {
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend = JSVMCall.thrown_val
                            IfCondition EqualTo(pend, 0) ThenBlock: {
                                pend = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVMCall.thrown_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition NotEqual(pend, 0) ThenBlock: {
                                IfCondition NotEqual(pend, JSRTState.undef_val) ThenBlock: {
                                    JSVM_ThrowValue(pend)
                                }
                            }
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                    // Mole 16 / M33: invoke getter __get_<key> if present (UTF-16-safe)
                    gk_buf = JSVMCallBuf.getter_buf
                    nlen_ak = JSRT_StrLen(JSVMTmp.ptr)
                    IfCondition LessThan(nlen_ak, 100) ThenBlock: {
                        SetByte(gk_buf, 0, 95)
                        SetByte(gk_buf, 1, 95)
                        SetByte(gk_buf, 2, 103)
                        SetByte(gk_buf, 3, 101)
                        SetByte(gk_buf, 4, 116)
                        SetByte(gk_buf, 5, 95)
                        gi = 0
                        WhileLoop LessThan(gi, nlen_ak) {
                            u = JSRT_StrUnit(JSVMTmp.ptr, gi)
                            IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                            SetByte(gk_buf, Add(6, gi), u)
                            gi = Add(gi, 1)
                        }
                        SetByte(gk_buf, Add(6, nlen_ak), 0)
                        // Own getter or own data first. ObjGet walks [[Prototype]],
                        // so an inherited __get_N hid {0:true}[0].
                        JSRT__Push(arr_val)
                        JSRT__Push(JSVMTmp.ptr)
                        has_own_g = JSRT_ObjHas(arr_val, gk_buf)
                        JSVMTmp.idx = has_own_g
                        JSVMTmp.ptr = JSRT__Pop()
                        arr_val = JSRT__Pop()
                        getter_fn = JSRT_Undefined()
                        IfCondition EqualTo(JSVMTmp.idx, 1) ThenBlock: {
                            JSRT__Push(arr_val)
                            JSRT__Push(JSVMTmp.ptr)
                            getter_fn = JSRT_ObjGet(arr_val, gk_buf)
                            JSVMTmp.ptr = JSRT__Pop()
                            arr_val = JSRT__Pop()
                        }
                        IfCondition EqualTo(JSRT_GetType(getter_fn), JSType.FUNCTION) ThenBlock: {
                            JSVM__SetGlobal("this", arr_val)
                            empty_g = JSVMCallBuf.buf
                            elem = JSVM__CallFunc(getter_fn, empty_g, 0)
                            // M128e7bm: GET_ELEM object getter abrupt rethrow
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                pend_ge = JSVMCall.thrown_val
                                IfCondition EqualTo(pend_ge, 0) ThenBlock: {
                                    pend_ge = JSVMState.exc_val
                                }
                                IfCondition EqualTo(pend_ge, 0) ThenBlock: {
                                    pend_ge = JSVM__GetGlobal("__pend_exc__")
                                }
                                JSVMCall.thrown_val = 0
                                JSVMState.exc_val = 0
                                JSVMCall.exc_prop = 0
                                IfCondition And(NotEqual(pend_ge, 0), NotEqual(pend_ge, JSRTState.undef_val)) ThenBlock: {
                                    JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                    JSVM_ThrowValue(pend_ge)
                                }
                                ReturnValue(1)
                            }
                            JSVM__StackPush(elem)
                            ReturnValue(1)
                        }
                        // Own data beats an inherited getter.
                        JSRT__Push(arr_val)
                        JSRT__Push(JSVMTmp.ptr)
                        has_own_d = JSRT_ObjHas(arr_val, JSVMTmp.ptr)
                        JSVMTmp.idx = has_own_d
                        JSVMTmp.ptr = JSRT__Pop()
                        arr_val = JSRT__Pop()
                        IfCondition EqualTo(JSVMTmp.idx, 1) ThenBlock: {
                            elem = JSRT_ObjGet(arr_val, JSVMTmp.ptr)
                            JSVM__StackPush(elem)
                            ReturnValue(1)
                        }
                        // No own getter and no own data: inherited __get_.
                        JSRT__Push(arr_val)
                        JSRT__Push(JSVMTmp.ptr)
                        getter_fn = JSRT_ObjGet(arr_val, gk_buf)
                        JSVMTmp.ptr = JSRT__Pop()
                        arr_val = JSRT__Pop()
                        IfCondition EqualTo(JSRT_GetType(getter_fn), JSType.FUNCTION) ThenBlock: {
                            JSVM__SetGlobal("this", arr_val)
                            empty_g2 = JSVMCallBuf.buf
                            elem = JSVM__CallFunc(getter_fn, empty_g2, 0)
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                pend_ge2 = JSVMCall.thrown_val
                                IfCondition EqualTo(pend_ge2, 0) ThenBlock: {
                                    pend_ge2 = JSVMState.exc_val
                                }
                                IfCondition EqualTo(pend_ge2, 0) ThenBlock: {
                                    pend_ge2 = JSVM__GetGlobal("__pend_exc__")
                                }
                                JSVMCall.thrown_val = 0
                                JSVMState.exc_val = 0
                                JSVMCall.exc_prop = 0
                                IfCondition And(NotEqual(pend_ge2, 0), NotEqual(pend_ge2, JSRTState.undef_val)) ThenBlock: {
                                    JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                    JSVM_ThrowValue(pend_ge2)
                                }
                                ReturnValue(1)
                            }
                            JSVM__StackPush(elem)
                            ReturnValue(1)
                        }
                    }
                    elem = JSRT_ObjGet(arr_val, JSVMTmp.ptr)
                    JSVM__StackPush(elem)
                    ReturnValue(1)
                }
                // ARRAY (Mole 16): Symbol / non-index named props via ObjGet+proto;
                // numeric indices: accessor (__get_N) then ArrGet.
                IfCondition EqualTo(JSVMTmp.type, JSType.ARRAY) ThenBlock: {
                    IfCondition EqualTo(JSVM_IsSymbol(idx_val), 1) ThenBlock: {
                        JSVMTmp.ptr = JSVM_ToPropertyKey(idx_val)
                        elem = JSRT_ObjGet(arr_val, JSVMTmp.ptr)
                        JSVM__StackPush(elem)
                        ReturnValue(1)
                    }
                    // arr["length"] is a JS string, so the GET_PROP GetByte check
                    // does not see it. Report the exotic length.
                    IfCondition EqualTo(JSRT_GetType(idx_val), JSType.STRING) ThenBlock: {
                        JSVMTmp.ptr = JSRT_GetPayload(idx_val)
                        JSRT__Push(arr_val)
                        JSRT__Push(idx_val)
                        is_len_ge = JSRT_StrEq(JSVMTmp.ptr, "length")
                        JSVMTmp.idx = is_len_ge
                        idx_val = JSRT__Pop()
                        arr_val = JSRT__Pop()
                        IfCondition EqualTo(JSVMTmp.idx, 1) ThenBlock: {
                            alen_ge = JSRT_ArrLen(arr_val)
                            JSVM__StackPush(JSRT_CreateNumber(alen_ge))
                            ReturnValue(1)
                        }
                    }
                    // Named and index keys both go through the accessor check below.
                    // An early ObjGet on the first byte treated JS-string "0" and
                    // "prop" as data and hid defineProperty getters.
                    // M33: index accessor via __get_<key> (defineProperty data→accessor)
                    // Keys may be UTF-16 — use StrUnit like defineProperty, not GetByte.
                    JSVMTmp.ptr = JSVM_ToPropertyKey(idx_val)
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        gk_buf = JSVMCallBuf.getter_buf
                        nlen_ak = JSRT_StrLen(JSVMTmp.ptr)
                        IfCondition LessThan(nlen_ak, 100) ThenBlock: {
                            SetByte(gk_buf, 0, 95)
                            SetByte(gk_buf, 1, 95)
                            SetByte(gk_buf, 2, 103)
                            SetByte(gk_buf, 3, 101)
                            SetByte(gk_buf, 4, 116)
                            SetByte(gk_buf, 5, 95)
                            gi = 0
                            WhileLoop LessThan(gi, nlen_ak) {
                                u = JSRT_StrUnit(JSVMTmp.ptr, gi)
                                IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                                SetByte(gk_buf, Add(6, gi), u)
                                gi = Add(gi, 1)
                            }
                            SetByte(gk_buf, Add(6, nlen_ak), 0)
                            // Own getter only. ObjGet walks [[Prototype]], so an
                            // inherited __get_N hid an own element (arr[1] === 1).
                            JSRT__Push(arr_val)
                            JSRT__Push(JSVMTmp.ptr)
                            has_own_g = JSRT_ObjHas(arr_val, gk_buf)
                            JSVMTmp.idx = has_own_g
                            JSVMTmp.ptr = JSRT__Pop()
                            arr_val = JSRT__Pop()
                            getter_fn = JSRT_Undefined()
                            IfCondition EqualTo(JSVMTmp.idx, 1) ThenBlock: {
                                JSRT__Push(arr_val)
                                JSRT__Push(JSVMTmp.ptr)
                                getter_fn = JSRT_ObjGet(arr_val, gk_buf)
                                JSVMTmp.ptr = JSRT__Pop()
                                arr_val = JSRT__Pop()
                            }
                            IfCondition EqualTo(JSRT_GetType(getter_fn), JSType.FUNCTION) ThenBlock: {
                                JSVM__SetGlobal("this", arr_val)
                                empty_g = JSVMCallBuf.buf
                                elem = JSVM__CallFunc(getter_fn, empty_g, 0)
                                // M128e7bm: GET_ELEM array-index getter abrupt rethrow
                                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                    pend_gai = JSVMCall.thrown_val
                                    IfCondition EqualTo(pend_gai, 0) ThenBlock: {
                                        pend_gai = JSVMState.exc_val
                                    }
                                    IfCondition EqualTo(pend_gai, 0) ThenBlock: {
                                        pend_gai = JSVM__GetGlobal("__pend_exc__")
                                    }
                                    JSVMCall.thrown_val = 0
                                    JSVMState.exc_val = 0
                                    JSVMCall.exc_prop = 0
                                    IfCondition And(NotEqual(pend_gai, 0), NotEqual(pend_gai, JSRTState.undef_val)) ThenBlock: {
                                        JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                                        JSVM_ThrowValue(pend_gai)
                                    }
                                    ReturnValue(1)
                                }
                                JSVM__StackPush(elem)
                                ReturnValue(1)
                            }
                            // own setter-only: no getter → undefined
                            SetByte(gk_buf, 2, 115)
                            SetByte(gk_buf, 3, 101)
                            SetByte(gk_buf, 4, 116)
                            // still __set_ — mid three chars; prefix __ and trailing name ok
                            SetByte(gk_buf, 0, 95)
                            SetByte(gk_buf, 1, 95)
                            SetByte(gk_buf, 2, 115)
                            SetByte(gk_buf, 3, 101)
                            SetByte(gk_buf, 4, 116)
                            SetByte(gk_buf, 5, 95)
                            gi = 0
                            WhileLoop LessThan(gi, nlen_ak) {
                                u = JSRT_StrUnit(JSVMTmp.ptr, gi)
                                IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                                SetByte(gk_buf, Add(6, gi), u)
                                gi = Add(gi, 1)
                            }
                            SetByte(gk_buf, Add(6, nlen_ak), 0)
                            JSRT__Push(arr_val)
                            has_set_only = JSRT_ObjHas(arr_val, gk_buf)
                            arr_val = JSRT__Pop()
                            IfCondition EqualTo(has_set_only, 1) ThenBlock: {
                                JSVM__StackPush(JSRT_Undefined())
                                ReturnValue(1)
                            }
                        }
                    }
                    // M128e7bd: non-index keys (e.g. true→"true") use ordinary [[Get]]
                    // ES: ToPropertyKey then CanonicalNumericIndexString — not ToNumber first.
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        is_arr_idx_key = 1
                        nlen_idx = JSRT_StrLen(JSVMTmp.ptr)
                        IfCondition EqualTo(nlen_idx, 0) ThenBlock: { is_arr_idx_key = 0 }
                        IfCondition GreaterThan(nlen_idx, 0) ThenBlock: {
                            c0i = JSRT_StrUnit(JSVMTmp.ptr, 0)
                            // non-digit start → named prop ("true", "length" handled elsewhere, etc.)
                            IfCondition Or(LessThan(c0i, 48), GreaterThan(c0i, 57)) ThenBlock: {
                                is_arr_idx_key = 0
                            }
                            // leading zero only valid for "0" alone
                            IfCondition And(EqualTo(c0i, 48), GreaterThan(nlen_idx, 1)) ThenBlock: {
                                is_arr_idx_key = 0
                            }
                            // any non-digit in rest → not array index ("1.1", "1e2")
                            gi = 1
                            WhileLoop And(EqualTo(is_arr_idx_key, 1), LessThan(gi, nlen_idx)) {
                                cu = JSRT_StrUnit(JSVMTmp.ptr, gi)
                                IfCondition Or(LessThan(cu, 48), GreaterThan(cu, 57)) ThenBlock: {
                                    is_arr_idx_key = 0
                                }
                                gi = Add(gi, 1)
                            }
                        }
                        IfCondition EqualTo(is_arr_idx_key, 0) ThenBlock: {
                            elem = JSRT_ObjGet(arr_val, JSVMTmp.ptr)
                            JSVM__StackPush(elem)
                            ReturnValue(1)
                        }
                    }
                    // M43: own element, else inherited index on [[Prototype]]
                    idx_num = Float_ToInt(JSRT_ToNumber(idx_val))
                    IfCondition EqualTo(JSRT_ArrHas(arr_val, idx_num), 1) ThenBlock: {
                        elem = JSRT_ArrGet(arr_val, idx_num)
                        JSVM__StackPush(elem)
                        ReturnValue(1)
                    }
                    // Hole: inherited index getter. Own elements returned above.
                    JSRT__Push(arr_val)
                    JSRTStack.hold = idx_num
                    kptr_ge = JSRT__IntToStr(idx_num)
                    idx_num = JSRTStack.hold
                    JSRTStack.hold = 0
                    arr_val = JSRT__Pop()
                    gk_buf = JSVMCallBuf.getter_buf
                    nlen_ak = StringLength(kptr_ge)
                    IfCondition And(GreaterThan(nlen_ak, 0), LessThan(nlen_ak, 40)) ThenBlock: {
                        SetByte(gk_buf, 0, 95)
                        SetByte(gk_buf, 1, 95)
                        SetByte(gk_buf, 2, 103)
                        SetByte(gk_buf, 3, 101)
                        SetByte(gk_buf, 4, 116)
                        SetByte(gk_buf, 5, 95)
                        gi = 0
                        WhileLoop LessThan(gi, nlen_ak) {
                            SetByte(gk_buf, Add(6, gi), GetByte(kptr_ge, gi))
                            gi = Add(gi, 1)
                        }
                        SetByte(gk_buf, Add(6, nlen_ak), 0)
                        JSRT__Push(arr_val)
                        getter_fn = JSRT_ObjGet(arr_val, gk_buf)
                        arr_val = JSRT__Pop()
                        IfCondition EqualTo(JSRT_GetType(getter_fn), JSType.FUNCTION) ThenBlock: {
                            JSVM__SetGlobal("this", arr_val)
                            empty_g = JSVMCallBuf.buf
                            elem = JSVM__CallFunc(getter_fn, empty_g, 0)
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                pend_gai = JSVMCall.thrown_val
                                IfCondition EqualTo(pend_gai, 0) ThenBlock: {
                                    pend_gai = JSVMState.exc_val
                                }
                                JSVMCall.thrown_val = 0
                                JSVMState.exc_val = 0
                                JSVMCall.exc_prop = 0
                                IfCondition And(NotEqual(pend_gai, 0), NotEqual(pend_gai, JSRTState.undef_val)) ThenBlock: {
                                    JSVM_ThrowValue(pend_gai)
                                }
                                ReturnValue(1)
                            }
                            JSVM__StackPush(elem)
                            ReturnValue(1)
                        }
                    }
                    kptr_ge = JSRT__IntToStr(idx_num)
                    // Walk prototype: default Array.prototype, then its chain
                    proto_ge = JSRTState.array_proto
                    hops_ge = 0
                    found_ge = 0
                    WhileLoop And(And(NotEqual(proto_ge, 0), EqualTo(found_ge, 0)), LessThan(hops_ge, 64)) {
                        hops_ge = Add(hops_ge, 1)
                        pt_ge = JSRT_GetType(proto_ge)
                        IfCondition EqualTo(pt_ge, JSType.ARRAY) ThenBlock: {
                            IfCondition EqualTo(JSRT_ArrHas(proto_ge, idx_num), 1) ThenBlock: {
                                elem = JSRT_ArrGet(proto_ge, idx_num)
                                found_ge = 1
                            }
                        }
                        IfCondition EqualTo(found_ge, 0) ThenBlock: {
                            IfCondition EqualTo(JSRT_ObjHas(proto_ge, kptr_ge), 1) ThenBlock: {
                                elem = JSRT_ObjGet(proto_ge, kptr_ge)
                                found_ge = 1
                            }
                        }
                        IfCondition EqualTo(found_ge, 0) ThenBlock: {
                            nxt = JSRT_ObjGet(proto_ge, "__proto__")
                            nt = JSRT_GetType(nxt)
                            IfCondition Or(Or(EqualTo(nt, JSType.OBJECT), EqualTo(nt, JSType.ARRAY)), EqualTo(nt, JSType.FUNCTION)) ThenBlock: {
                                proto_ge = nxt
                            } ElseBlock: {
                                proto_ge = 0
                            }
                        }
                    }
                    IfCondition EqualTo(found_ge, 1) ThenBlock: {
                        JSVM__StackPush(elem)
                        ReturnValue(1)
                    }
                    JSVM__StackPush(JSRT_Undefined())
                    ReturnValue(1)
                }
                idx_num = Float_ToInt(JSRT_ToNumber(idx_val))
                elem = JSRT_ArrGet(arr_val, idx_num)
                JSVM__StackPush(elem)
                ReturnValue(1)
            
    }
}
