// IN (38) — key in obj (HasProperty: own + [[Prototype]])
Function.JSVM_OpIn {
    Output: Integer
    Body: {

                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                // ES: If Type(val) is not Object, throw TypeError
                bv_t = JSRT_GetType(bv)
                is_in_obj = 0
                IfCondition EqualTo(bv_t, JSType.OBJECT) ThenBlock: { is_in_obj = 1 }
                IfCondition EqualTo(bv_t, JSType.FUNCTION) ThenBlock: { is_in_obj = 1 }
                IfCondition EqualTo(bv_t, JSType.ARRAY) ThenBlock: { is_in_obj = 1 }
                IfCondition EqualTo(bv_t, JSType.GENERATOR) ThenBlock: { is_in_obj = 1 }
                IfCondition EqualTo(is_in_obj, 0) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot use 'in' operator on non-object")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                // M80: ToPropertyKey (Symbol → @@sN); not ToString
                JSRT__Push(bv)
                key_ptr = JSVM_ToPropertyKey(av)
                bv = JSRT__Pop()
                IfCondition EqualTo(key_ptr, 0) ThenBlock: {
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        pend = JSVMCall.thrown_val
                        IfCondition EqualTo(pend, 0) ThenBlock: {
                            pend = JSVM__GetGlobal("__pend_exc__")
                        }
                        JSVMCall.thrown_val = 0
                        JSVMCall.exc_prop = 0
                        IfCondition NotEqual(pend, 0) ThenBlock: {
                            IfCondition NotEqual(pend, JSRTState.undef_val) ThenBlock: {
                                JSVM_ThrowValue(pend)
                            }
                        }
                        ReturnValue(1)
                    }
                    JSVM__StackPush(JSRT_False())
                    ReturnValue(1)
                }
                // M43: was own-only ObjHas — broke `1 in arr` with Array.prototype[1]
                // M128e6ac: Proxy has trap
                has = JSVM__HasProperty(bv, key_ptr)
                IfCondition EqualTo(has, 1) ThenBlock: {
                    JSVM__StackPush(JSRT_True())
                } ElseBlock: {
                    JSVM__StackPush(JSRT_False())
                }
                ReturnValue(1)
            
    }
}

