// Library.JSVMOpPart3.ailang — JSVM opcode bodies
// Helpers called from JSVM_Step. Opcodes: JSVM_OpSetElem, JSVM_OpAdd, JSVM_OpSub, JSVM_OpMul, JSVM_OpDiv, JSVM_OpMod, JSVM_OpNeg, JSVM_OpExp, JSVM_OpInc, JSVM_OpDec, JSVM_OpToNumber, JSVM_OpEq, JSVM_OpNeq, JSVM_OpLt, JSVM_OpGt, JSVM_OpLte, JSVM_OpGte, JSVM_OpIn, JSVM_OpBitAnd.
// Split from the JS engine so one function fits in context.
// FixedPools stay in the parent library. Function names are unchanged
// except for the new helpers this split adds.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// SET_ELEM (19) — pop index, pop array/object, pop value
            // Stack: [..., value, array, index]
Function.JSVM_OpSetElem {
    Output: Integer
    Body: {

                idx_val = JSVM__StackPop()
                arr_val = JSVM__StackPop()
                sval = JSVM__StackPop()
                se_type = JSRT_GetType(arr_val)
                // Wave 3 D1: null/undefined base → TypeError
                IfCondition Or(EqualTo(se_type, JSType.NULL), EqualTo(se_type, JSType.UNDEFINED)) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Cannot set property of null/undefined")
                    JSVM_ThrowValue(terr)
                    ReturnValue(1)
                }
                IfCondition EqualTo(JSVM_SymbolWriteBarrier(arr_val), 1) ThenBlock: {
                    ReturnValue(1)
                }
                // M128e7d0/e7du: TypedArray [[Set]] — number + canonical numeric strings
                IfCondition EqualTo(se_type, JSType.OBJECT) ThenBlock: {
                    IfCondition EqualTo(JSVM_IsTypedArray(arr_val), 1) ThenBlock: {
                        ta_use_idx = 0
                        ta_idx = 0
                        IfCondition EqualTo(JSRT_GetType(idx_val), JSType.NUMBER) ThenBlock: {
                            ta_idx = Float_ToInt(JSRT_GetPayload(idx_val))
                            IfCondition LessThan(ta_idx, 0) ThenBlock: { ta_idx = -1 }
                            ta_use_idx = 1
                        }
                        IfCondition EqualTo(JSRT_GetType(idx_val), JSType.STRING) ThenBlock: {
                            kptr_ta = JSRT_GetPayload(idx_val)
                            IfCondition NotEqual(kptr_ta, 0) ThenBlock: {
                                can_ta = JSVM_TA_ParseCanonicalIndex(kptr_ta)
                                IfCondition NotEqual(can_ta, -2) ThenBlock: {
                                    ta_idx = can_ta
                                    ta_use_idx = 1
                                } ElseBlock: {
                                    // "-0" / "1.1" / "-1" / "Infinity": ToString(ToNumber(k))===k
                                    // or exact "-0" (ToString(-0) is "0")
                                    is_m0 = JSRT_StrEq(kptr_ta, "-0")
                                    IfCondition EqualTo(is_m0, 1) ThenBlock: {
                                        ta_idx = -1
                                        ta_use_idx = 1
                                    } ElseBlock: {
                                        JSBridge__Push(arr_val)
                                        JSBridge__Push(sval)
                                        n_can = JSRT_ToNumber(idx_val)
                                        sval = JSBridge__Pop()
                                        arr_val = JSBridge__Pop()
                                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                            ReturnValue(1)
                                        }
                                        JSBridge__Push(arr_val)
                                        JSBridge__Push(sval)
                                        num_v = JSRT_CreateFloat(n_can)
                                        s_back_v = JSRT_ToString(num_v)
                                        sval = JSBridge__Pop()
                                        arr_val = JSBridge__Pop()
                                        s_back = 0
                                        IfCondition NotEqual(s_back_v, 0) ThenBlock: {
                                            s_back = JSRT_GetPayload(s_back_v)
                                        }
                                        IfCondition And(NotEqual(s_back, 0), EqualTo(JSRT_StrEq(kptr_ta, s_back), 1)) ThenBlock: {
                                            ta_idx = -1
                                            ta_use_idx = 1
                                        }
                                    }
                                }
                            }
                        }
                        IfCondition EqualTo(ta_use_idx, 1) ThenBlock: {
                            JSVM_TA_Set(arr_val, ta_idx, sval)
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                pend_ta = JSVMCall.thrown_val
                                IfCondition EqualTo(pend_ta, 0) ThenBlock: {
                                    pend_ta = JSVM__GetGlobal("__pend_exc__")
                                }
                                JSVMCall.thrown_val = 0
                                JSVMCall.exc_prop = 0
                                IfCondition NotEqual(pend_ta, 0) ThenBlock: {
                                    IfCondition NotEqual(pend_ta, JSRTState.undef_val) ThenBlock: {
                                        JSVM_ThrowValue(pend_ta)
                                    }
                                }
                                ReturnValue(1)
                            }
                            ReturnValue(1)
                        }
                    }
                }
                // M37: FUNCTION is object-like for indexed props (fn[0]=x for array-likes)
                IfCondition Or(EqualTo(se_type, JSType.OBJECT), EqualTo(se_type, JSType.FUNCTION)) ThenBlock: {
                    // Object/Function — ToPropertyKey once (do NOT also ToNumber first:
                    // that double-invokes toString and fails S11.13.1_A7_T4)
                    idx_num = -1
                    JSVMTmp.ptr = JSVM_ToPropertyKey(idx_val)
                    IfCondition EqualTo(JSVMTmp.ptr, 0) ThenBlock: {
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend = JSVMCall.thrown_val
                            IfCondition EqualTo(pend, 0) ThenBlock: {
                                pend = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVMCall.thrown_val = 0
                            JSVMCall.exc_prop = 0
                            IfCondition NotEqual(pend, 0) ThenBlock: {
                                IfCondition NotEqual(pend, JSRTState.undef_val) ThenBlock: {
                                    JSVM_ThrowValue(pend)
                                }
                            }
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                    // Numeric index from key string for arguments sync only
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        c0s = GetByte(JSVMTmp.ptr, 0)
                        IfCondition And(GreaterEqual(c0s, 48), LessEqual(c0s, 57)) ThenBlock: {
                            idx_num = Float_ToInt(JSRT_ToNumber(JSRT_CreateString(JSVMTmp.ptr)))
                        }
                    }
                    // Mole 16 / M33: invoke setter __set_<key> if present (UTF-16-safe)
                    sk_buf = JSVMCallBuf.getter_buf
                    nlen_ak = 0
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        nlen_ak = JSRT_StrLen(JSVMTmp.ptr)
                    }
                    IfCondition LessThan(nlen_ak, 100) ThenBlock: {
                        SetByte(sk_buf, 0, 95)
                        SetByte(sk_buf, 1, 95)
                        SetByte(sk_buf, 2, 115)
                        SetByte(sk_buf, 3, 101)
                        SetByte(sk_buf, 4, 116)
                        SetByte(sk_buf, 5, 95)
                        si = 0
                        WhileLoop LessThan(si, nlen_ak) {
                            u = JSRT_StrUnit(JSVMTmp.ptr, si)
                            IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                            SetByte(sk_buf, Add(6, si), u)
                            si = Add(si, 1)
                        }
                        SetByte(sk_buf, Add(6, nlen_ak), 0)
                        JSRT__Push(arr_val)
                        JSRT__Push(sval)
                        JSRT__Push(JSVMTmp.ptr)
                        setter_fn = JSRT_ObjGet(arr_val, sk_buf)
                        JSVMTmp.ptr = JSRT__Pop()
                        sval = JSRT__Pop()
                        arr_val = JSRT__Pop()
                        IfCondition EqualTo(JSRT_GetType(setter_fn), JSType.FUNCTION) ThenBlock: {
                            JSVM__SetGlobal("this", arr_val)
                            arg_buf_s = JSVMCallBuf.buf
                            StoreValue(arg_buf_s, sval)
                            JSVM__CallFunc(setter_fn, arg_buf_s, 1)
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                pend_se = JSVMCall.thrown_val
                                IfCondition EqualTo(pend_se, 0) ThenBlock: { pend_se = JSVMState.exc_val }
                                JSVMCall.thrown_val = 0
                                JSVMState.exc_val = 0
                                JSVMCall.exc_prop = 0
                                IfCondition And(NotEqual(pend_se, 0), NotEqual(pend_se, JSRTState.undef_val)) ThenBlock: {
                                    JSVM_ThrowValue(pend_se)
                                }
                                ReturnValue(1)
                            }
                            ReturnValue(1)
                        }
                    }
                    // Wave 2 / Mole 12: honor writable / freeze
                    can_se = JSBridge_CanAssign(arr_val, JSVMTmp.ptr)
                    IfCondition EqualTo(can_se, 0) ThenBlock: {
                        IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                            terr = JSVM_CreateTypedError("TypeError", "Cannot assign to non-writable property")
                            JSVM_ThrowValue(terr)
                            ReturnValue(1)
                        }
                        ReturnValue(1)
                    }
                    JSRT_ObjSet(arr_val, JSVMTmp.ptr, sval)
                    // M102: mapped arguments[i] → formal local
                    IfCondition EqualTo(JSVM_IsArgumentsObj(arr_val), 1) ThenBlock: {
                        sync_idx = idx_num
                        // Fallback: numeric index value (ToPropertyKey may be UTF-16)
                        IfCondition LessThan(sync_idx, 0) ThenBlock: {
                            IfCondition EqualTo(JSRT_GetType(idx_val), JSType.NUMBER) ThenBlock: {
                                sync_idx = Float_ToInt(JSRT_GetPayload(idx_val))
                            }
                        }
                        IfCondition GreaterEqual(sync_idx, 0) ThenBlock: {
                            JSVM_SyncArgumentsToLocal(sync_idx, sval)
                        }
                    }
                    ReturnValue(1)
                }
                // ARRAY (Mole 16): Symbol / non-index named props → side table ObjSet
                IfCondition EqualTo(se_type, JSType.ARRAY) ThenBlock: {
                    IfCondition EqualTo(JSVM_IsSymbol(idx_val), 1) ThenBlock: {
                        JSVMTmp.ptr = JSVM_ToPropertyKey(idx_val)
                        JSRT_ObjSet(arr_val, JSVMTmp.ptr, sval)
                        ReturnValue(1)
                    }
                    IfCondition EqualTo(JSRT_GetType(idx_val), JSType.STRING) ThenBlock: {
                        JSVMTmp.ptr = JSRT_GetPayload(idx_val)
                        // Digit-leading keys are indexes and fall through to the
                        // accessor / ArrSet path. StrUnit, not GetByte: a JS string
                        // header's first byte is not the first character, so "0"
                        // skipped the setter and wrote a data element.
                        JSVMTmp.type = 0
                        IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                            JSRT__Push(arr_val)
                            JSRT__Push(sval)
                            JSRT__Push(idx_val)
                            nlen_se0 = JSRT_StrLen(JSVMTmp.ptr)
                            JSVMTmp.type = 0
                            IfCondition GreaterThan(nlen_se0, 0) ThenBlock: {
                                JSVMTmp.type = JSRT_StrUnit(JSVMTmp.ptr, 0)
                            }
                            idx_val = JSRT__Pop()
                            sval = JSRT__Pop()
                            arr_val = JSRT__Pop()
                        }
                        c0 = JSVMTmp.type
                        IfCondition Or(EqualTo(c0, 0), Or(LessThan(c0, 48), GreaterThan(c0, 57))) ThenBlock: {
                            // M29e: arr["length"] = N. StrEq, not GetByte (JS string header).
                            // Other named keys fall through so __set_prop runs.
                            JSRT__Push(arr_val)
                            JSRT__Push(sval)
                            JSRT__Push(idx_val)
                            len_hit = JSRT_StrEq(JSVMTmp.ptr, "length")
                            JSVMTmp.done = len_hit
                            idx_val = JSRT__Pop()
                            sval = JSRT__Pop()
                            arr_val = JSRT__Pop()
                            is_alen_se = JSVMTmp.done
                            IfCondition EqualTo(is_alen_se, 1) ThenBlock: {
                                // M128e7bz: honor length [[Writable]]
                                can_len_se = JSBridge_CanAssign(arr_val, JSVMTmp.ptr)
                                IfCondition EqualTo(can_len_se, 0) ThenBlock: {
                                    IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                                        terr = JSVM_CreateTypedError("TypeError", "Cannot assign to non-writable property")
                                        JSVM_ThrowValue(terr)
                                        ReturnValue(1)
                                    }
                                    ReturnValue(1)
                                }
                                n_bits = JSRT_ToNumber(sval)
                                bad_len = 0
                                IfCondition EqualTo(Float_Lt(n_bits, Float_FromInt(0)), 1) ThenBlock: {
                                    bad_len = 1
                                }
                                IfCondition EqualTo(Float_Lt(n_bits, Float_FromInt(4294967296)), 0) ThenBlock: {
                                    bad_len = 1
                                }
                                ni_len = Float_ToInt(n_bits)
                                IfCondition EqualTo(Float_Eq(Float_FromInt(ni_len), n_bits), 0) ThenBlock: {
                                    bad_len = 1
                                }
                                IfCondition EqualTo(bad_len, 1) ThenBlock: {
                                    terr = JSVM_CreateTypedError("RangeError", "Invalid array length")
                                    JSVM_ThrowValue(terr)
                                    ReturnValue(1)
                                }
                                rc_len_se = JSRT_ArrSetLen(arr_val, ni_len)
                                IfCondition EqualTo(rc_len_se, 0) ThenBlock: {
                                    IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                                        terr = JSVM_CreateTypedError("TypeError", "Cannot delete non-configurable array element")
                                        JSVM_ThrowValue(terr)
                                        ReturnValue(1)
                                    }
                                    ReturnValue(1)
                                }
                                ReturnValue(1)
                            }
                        }
                    }
                    // M33: index accessor via __set_<key> before ArrSet (UTF-16-safe)
                    JSVMTmp.ptr = JSVM_ToPropertyKey(idx_val)
                    IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                        gk_buf = JSVMCallBuf.getter_buf
                        nlen_ak = JSRT_StrLen(JSVMTmp.ptr)
                        IfCondition LessThan(nlen_ak, 100) ThenBlock: {
                            SetByte(gk_buf, 0, 95)
                            SetByte(gk_buf, 1, 95)
                            SetByte(gk_buf, 2, 115)
                            SetByte(gk_buf, 3, 101)
                            SetByte(gk_buf, 4, 116)
                            SetByte(gk_buf, 5, 95)
                            gi = 0
                            WhileLoop LessThan(gi, nlen_ak) {
                                u = JSRT_StrUnit(JSVMTmp.ptr, gi)
                                IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                                SetByte(gk_buf, Add(6, gi), u)
                                gi = Add(gi, 1)
                            }
                            SetByte(gk_buf, Add(6, nlen_ak), 0)
                            JSRT__Push(arr_val)
                            JSRT__Push(sval)
                            JSRT__Push(JSVMTmp.ptr)
                            setter_fn = JSRT_ObjGet(arr_val, gk_buf)
                            JSVMTmp.ptr = JSRT__Pop()
                            sval = JSRT__Pop()
                            arr_val = JSRT__Pop()
                            IfCondition EqualTo(JSRT_GetType(setter_fn), JSType.FUNCTION) ThenBlock: {
                                JSVM__SetGlobal("this", arr_val)
                                ab = JSVMCallBuf.buf
                                StoreValue(ab, sval)
                                JSVM__CallFunc(setter_fn, ab, 1)
                                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                    pend_se2 = JSVMCall.thrown_val
                                    IfCondition EqualTo(pend_se2, 0) ThenBlock: { pend_se2 = JSVMState.exc_val }
                                    JSVMCall.thrown_val = 0
                                    JSVMState.exc_val = 0
                                    JSVMCall.exc_prop = 0
                                    IfCondition And(NotEqual(pend_se2, 0), NotEqual(pend_se2, JSRTState.undef_val)) ThenBlock: {
                                        JSVM_ThrowValue(pend_se2)
                                    }
                                }
                                ReturnValue(1)
                            }
                            // getter-only: silent no-op in non-strict
                            SetByte(gk_buf, 0, 95)
                            SetByte(gk_buf, 1, 95)
                            SetByte(gk_buf, 2, 103)
                            SetByte(gk_buf, 3, 101)
                            SetByte(gk_buf, 4, 116)
                            SetByte(gk_buf, 5, 95)
                            gi = 0
                            WhileLoop LessThan(gi, nlen_ak) {
                                u = JSRT_StrUnit(JSVMTmp.ptr, gi)
                                IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                                SetByte(gk_buf, Add(6, gi), u)
                                gi = Add(gi, 1)
                            }
                            SetByte(gk_buf, Add(6, nlen_ak), 0)
                            JSRT__Push(arr_val)
                            JSRT__Push(sval)
                            has_get_only = JSRT_ObjHas(arr_val, gk_buf)
                            sval = JSRT__Pop()
                            arr_val = JSRT__Pop()
                            IfCondition EqualTo(has_get_only, 1) ThenBlock: {
                                // Getter-only [[Set]] rejects. Strict throws; the
                                // accessor must stay an accessor (no ArrSet).
                                IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                                    terr = JSVM_CreateTypedError("TypeError", "Cannot assign to getter-only property")
                                    JSVM_ThrowValue(terr)
                                    ReturnValue(1)
                                }
                                ReturnValue(1)
                            }
                        }
                    }
                }
                // M128e7bd: non-index keys (true→"true", 1.1→"1.1") use ObjSet
                IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                    is_arr_idx_se = 1
                    nlen_se = JSRT_StrLen(JSVMTmp.ptr)
                    IfCondition EqualTo(nlen_se, 0) ThenBlock: { is_arr_idx_se = 0 }
                    IfCondition GreaterThan(nlen_se, 0) ThenBlock: {
                        c0se = JSRT_StrUnit(JSVMTmp.ptr, 0)
                        IfCondition Or(LessThan(c0se, 48), GreaterThan(c0se, 57)) ThenBlock: {
                            is_arr_idx_se = 0
                        }
                        IfCondition And(EqualTo(c0se, 48), GreaterThan(nlen_se, 1)) ThenBlock: {
                            is_arr_idx_se = 0
                        }
                        gi = 1
                        WhileLoop And(EqualTo(is_arr_idx_se, 1), LessThan(gi, nlen_se)) {
                            cu = JSRT_StrUnit(JSVMTmp.ptr, gi)
                            IfCondition Or(LessThan(cu, 48), GreaterThan(cu, 57)) ThenBlock: {
                                is_arr_idx_se = 0
                            }
                            gi = Add(gi, 1)
                        }
                    }
                    IfCondition EqualTo(is_arr_idx_se, 0) ThenBlock: {
                        // named (non-index) props on arrays — honor attrs/freeze
                        can_an = JSBridge_CanAssign(arr_val, JSVMTmp.ptr)
                        IfCondition EqualTo(can_an, 0) ThenBlock: {
                            IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                                terr = JSVM_CreateTypedError("TypeError", "Cannot assign to non-writable property")
                                JSVM_ThrowValue(terr)
                                ReturnValue(1)
                            }
                            ReturnValue(1)
                        }
                        JSRT_ObjSet(arr_val, JSVMTmp.ptr, sval)
                        ReturnValue(1)
                    }
                }
                // M128e7bz: array index set must honor [[Writable]] / freeze
                // (defineProperty(a,"0",{writable:false}); a[0]=x was ignoring attrs)
                IfCondition NotEqual(JSVMTmp.ptr, 0) ThenBlock: {
                    can_ai = JSBridge_CanAssign(arr_val, JSVMTmp.ptr)
                    IfCondition EqualTo(can_ai, 0) ThenBlock: {
                        IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
                            terr = JSVM_CreateTypedError("TypeError", "Cannot assign to non-writable property")
                            JSVM_ThrowValue(terr)
                            ReturnValue(1)
                        }
                        ReturnValue(1)
                    }
                }
                idx_num = Float_ToInt(JSRT_ToNumber(idx_val))
                JSRT_ArrSet(arr_val, idx_num, sval)
                ReturnValue(1)
            
    }
}

// ADD (20) — pop b, pop a, push JSRT_Add(a, b)
Function.JSVM_OpAdd {
    Output: Integer
    Body: {

                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Add(av, bv)
                // M128e7ad: rethrow ToPrimitive/ToString throws (was clearing exc_prop)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    // THROW inside nested CallFunc may already have delivered catch
                    IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
                        JSVMCall.exc_prop = 0
                        JSVMCall.thrown_val = 0
                        JSVMState.error = 0
                        JSVMState.halted = 0
                        ReturnValue(1)
                    }
                    pend = JSVMCall.thrown_val
                    IfCondition EqualTo(pend, 0) ThenBlock: {
                        pend = JSVM__GetGlobal("__pend_exc__")
                    }
                    JSVMCall.thrown_val = 0
                    JSVMCall.exc_prop = 0
                    JSVM__SetGlobal("__pend_exc__", JSRTState.undef_val)
                    // Nested CallFunc sets error/halted; clear so catch can resume
                    JSVMState.error = 0
                    JSVMState.halted = 0
                    IfCondition And(NotEqual(pend, 0), NotEqual(pend, JSRTState.undef_val)) ThenBlock: {
                        JSVM_ThrowValue(pend)
                    }
                    ReturnValue(1)
                }
                JSVM__StackPush(result)
                ReturnValue(1)
            
    }
}

// SUB (21)
Function.JSVM_OpSub {
    Output: Integer
    Body: {

                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Sub(av, bv)
                // BigInt mix TypeError / RangeError must rethrow (same as ADD)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
                        JSVMCall.exc_prop = 0
                        JSVMCall.thrown_val = 0
                        JSVMState.error = 0
                        JSVMState.halted = 0
                        ReturnValue(1)
                    }
                    pend = JSVMCall.thrown_val
                    IfCondition EqualTo(pend, 0) ThenBlock: {
                        pend = JSVM__GetGlobal("__pend_exc__")
                    }
                    JSVMCall.thrown_val = 0
                    JSVMCall.exc_prop = 0
                    JSVM__SetGlobal("__pend_exc__", JSRTState.undef_val)
                    JSVMState.error = 0
                    JSVMState.halted = 0
                    IfCondition And(NotEqual(pend, 0), NotEqual(pend, JSRTState.undef_val)) ThenBlock: {
                        JSVM_ThrowValue(pend)
                    }
                    ReturnValue(1)
                }
                JSVM__StackPush(result)
                ReturnValue(1)
            
    }
}

// MUL (22)
Function.JSVM_OpMul {
    Output: Integer
    Body: {

                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Mul(av, bv)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
                        JSVMCall.exc_prop = 0
                        JSVMCall.thrown_val = 0
                        JSVMState.error = 0
                        JSVMState.halted = 0
                        ReturnValue(1)
                    }
                    pend = JSVMCall.thrown_val
                    IfCondition EqualTo(pend, 0) ThenBlock: {
                        pend = JSVM__GetGlobal("__pend_exc__")
                    }
                    JSVMCall.thrown_val = 0
                    JSVMCall.exc_prop = 0
                    JSVM__SetGlobal("__pend_exc__", JSRTState.undef_val)
                    JSVMState.error = 0
                    JSVMState.halted = 0
                    IfCondition And(NotEqual(pend, 0), NotEqual(pend, JSRTState.undef_val)) ThenBlock: {
                        JSVM_ThrowValue(pend)
                    }
                    ReturnValue(1)
                }
                JSVM__StackPush(result)
                ReturnValue(1)
            
    }
}

// DIV (23)
Function.JSVM_OpDiv {
    Output: Integer
    Body: {

                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Div(av, bv)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
                        JSVMCall.exc_prop = 0
                        JSVMCall.thrown_val = 0
                        JSVMState.error = 0
                        JSVMState.halted = 0
                        ReturnValue(1)
                    }
                    pend = JSVMCall.thrown_val
                    IfCondition EqualTo(pend, 0) ThenBlock: {
                        pend = JSVM__GetGlobal("__pend_exc__")
                    }
                    JSVMCall.thrown_val = 0
                    JSVMCall.exc_prop = 0
                    JSVM__SetGlobal("__pend_exc__", JSRTState.undef_val)
                    JSVMState.error = 0
                    JSVMState.halted = 0
                    IfCondition And(NotEqual(pend, 0), NotEqual(pend, JSRTState.undef_val)) ThenBlock: {
                        JSVM_ThrowValue(pend)
                    }
                    ReturnValue(1)
                }
                JSVM__StackPush(result)
                ReturnValue(1)
            
    }
}

// MOD (24)
Function.JSVM_OpMod {
    Output: Integer
    Body: {

                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Mod(av, bv)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
                        JSVMCall.exc_prop = 0
                        JSVMCall.thrown_val = 0
                        JSVMState.error = 0
                        JSVMState.halted = 0
                        ReturnValue(1)
                    }
                    pend = JSVMCall.thrown_val
                    IfCondition EqualTo(pend, 0) ThenBlock: {
                        pend = JSVM__GetGlobal("__pend_exc__")
                    }
                    JSVMCall.thrown_val = 0
                    JSVMCall.exc_prop = 0
                    JSVM__SetGlobal("__pend_exc__", JSRTState.undef_val)
                    JSVMState.error = 0
                    JSVMState.halted = 0
                    IfCondition And(NotEqual(pend, 0), NotEqual(pend, JSRTState.undef_val)) ThenBlock: {
                        JSVM_ThrowValue(pend)
                    }
                    ReturnValue(1)
                }
                JSVM__StackPush(result)
                ReturnValue(1)
            
    }
}

