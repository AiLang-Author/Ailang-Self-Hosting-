// Library.JSVMOpPart4.ailang — JSVM opcode bodies
// Helpers called from JSVM_Step. Opcodes: JSVM_OpBitOr, JSVM_OpBitXor, JSVM_OpBitNot, JSVM_OpShl, JSVM_OpShr, JSVM_OpUshr, JSVM_OpInstanceof, JSVM_OpJmpNullish, JSVM_OpJmpIfNullish.
// Split from the JS engine so one function fits in context.
// FixedPools stay in the parent library. Function names are unchanged
// except for the new helpers this split adds.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// BIT_OR (42)
Function.JSVM_OpBitOr {
    Output: Integer
    Body: {

                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_BitOr(av, bv)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
                        JSVMCall.exc_prop = 0
                        JSVMCall.thrown_val = 0
                        JSVMState.error = 0
                        JSVMState.halted = 0
                        ReturnValue(1)
                    }
                    pend = JSVMCall.thrown_val
                    IfCondition EqualTo(pend, 0) ThenBlock: {
                        pend = JSVM__GetGlobal("__pend_exc__")
                    }
                    JSVMCall.thrown_val = 0
                    JSVMCall.exc_prop = 0
                    JSVM__SetGlobal("__pend_exc__", JSRTState.undef_val)
                    JSVMState.error = 0
                    JSVMState.halted = 0
                    IfCondition And(NotEqual(pend, 0), NotEqual(pend, JSRTState.undef_val)) ThenBlock: {
                        JSVM_ThrowValue(pend)
                    }
                    ReturnValue(1)
                }
                JSVM__StackPush(result)
                ReturnValue(1)
            
    }
}

