// Library.JSVMPromiseJobs.ailang — Promise reaction / microtask queue (M128e6p)
// Settled .then enqueues instead of running eagerly; Drain after script Run.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// Reaction job: callback + argument + capability (result promise)
// Stored as a plain object: { __cb__, __arg__, __cap__, __kind__ }
// kind 1 = fulfill, 2 = reject

FixedPool.JSVMJobs {
    "queue":     Initialize=0
    "len":       Initialize=0
    "cap":       Initialize=0
    "draining":  Initialize=0
}

Function.JSVMJobs_Init {
    Output: Integer
    Body: {
        // Fixed array of job object addresses (max 256 pending reactions)
        JSVMJobs.cap = 256
        JSVMJobs.queue = Allocate(Multiply(JSVMJobs.cap, 8))
        JSVMJobs.len = 0
        JSVMJobs.draining = 0
        ReturnValue(0)
    }
}

Function.JSVMJobs_Enqueue {
    Input: kind: Integer
    Input: callback: Address
    Input: arg: Address
    Input: cap: Address
    Output: Integer
    Body: {
        save_k = kind
        save_cb = callback
        save_arg = arg
        save_cap = cap
        IfCondition EqualTo(JSVMJobs.queue, 0) ThenBlock: {
            JSVMJobs_Init()
        }
        IfCondition GreaterEqual(JSVMJobs.len, JSVMJobs.cap) ThenBlock: {
            // Overflow — run eagerly as last resort
            ReturnValue(-1)
        }
        job = JSRT_CreateObject()
        JSRT_ObjSet(job, "__kind__", JSRT_CreateNumber(save_k))
        JSRT_ObjSet(job, "__cb__", save_cb)
        JSRT_ObjSet(job, "__arg__", save_arg)
        JSRT_ObjSet(job, "__cap__", save_cap)
        StoreValue(Add(JSVMJobs.queue, Multiply(JSVMJobs.len, 8)), job)
        JSVMJobs.len = Add(JSVMJobs.len, 1)
        ReturnValue(0)
    }
}

// Run one reaction: call cb(arg), settle cap promise
Function.JSVMJobs_RunOne {
    Input: job: Address
    Output: Integer
    Body: {
        save_job = job
        IfCondition EqualTo(save_job, 0) ThenBlock: {
            ReturnValue(0)
        }
        kind_v = JSRT_ObjGet(save_job, "__kind__")
        kind = 1
        IfCondition EqualTo(JSRT_GetType(kind_v), JSType.NUMBER) ThenBlock: {
            kind = Float_ToInt(JSRT_GetPayload(kind_v))
        }
        cb = JSRT_ObjGet(save_job, "__cb__")
        arg = JSRT_ObjGet(save_job, "__arg__")
        cap = JSRT_ObjGet(save_job, "__cap__")

        // No callback: pass through fulfill/reject of cap
        IfCondition NotEqual(JSRT_GetType(cb), JSType.FUNCTION) ThenBlock: {
            IfCondition And(NotEqual(cap, 0), NotEqual(cap, JSRTState.undef_val)) ThenBlock: {
                IfCondition EqualTo(kind, 2) ThenBlock: {
                    JSRT_ObjSet(cap, "__state__", JSRT_CreateNumber(2))
                    JSRT_ObjSet(cap, "__value__", arg)
                } ElseBlock: {
                    JSRT_ObjSet(cap, "__state__", JSRT_CreateNumber(1))
                    JSRT_ObjSet(cap, "__value__", arg)
                }
                // Fire reactions stored on cap if any (chained then)
                JSVMJobs_FireReactions(cap)
            }
            ReturnValue(0)
        }

        JSVMCall.exc_prop = 0
        cb_buf = JSVMCallBuf.buf
        StoreValue(cb_buf, arg)
        cb_result = JSVM__CallFunc(cb, cb_buf, 1)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            pend = JSVMCall.thrown_val
            IfCondition EqualTo(pend, 0) ThenBlock: {
                pend = JSVMState.exc_val
            }
            JSVMCall.exc_prop = 0
            JSVMCall.thrown_val = 0
            JSVMState.exc_val = 0
            IfCondition EqualTo(pend, 0) ThenBlock: {
                pend = JSRTState.undef_val
            }
            IfCondition And(NotEqual(cap, 0), NotEqual(cap, JSRTState.undef_val)) ThenBlock: {
                JSRT_ObjSet(cap, "__state__", JSRT_CreateNumber(2))
                JSRT_ObjSet(cap, "__value__", pend)
                JSVMJobs_FireReactions(cap)
            }
            ReturnValue(0)
        }
        // Adopt settled promise return
        IfCondition EqualTo(JSRT_GetType(cb_result), JSType.OBJECT) ThenBlock: {
            st2 = JSRT_ObjGet(cb_result, "__state__")
            IfCondition EqualTo(JSRT_GetType(st2), JSType.NUMBER) ThenBlock: {
                sn2 = Float_ToInt(JSRT_GetPayload(st2))
                IfCondition Or(EqualTo(sn2, 1), EqualTo(sn2, 2)) ThenBlock: {
                    IfCondition And(NotEqual(cap, 0), NotEqual(cap, JSRTState.undef_val)) ThenBlock: {
                        JSRT_ObjSet(cap, "__state__", JSRT_CreateNumber(sn2))
                        JSRT_ObjSet(cap, "__value__", JSRT_ObjGet(cb_result, "__value__"))
                        JSVMJobs_FireReactions(cap)
                    }
                    ReturnValue(0)
                }
            }
        }
        IfCondition And(NotEqual(cap, 0), NotEqual(cap, JSRTState.undef_val)) ThenBlock: {
            JSRT_ObjSet(cap, "__state__", JSRT_CreateNumber(1))
            JSRT_ObjSet(cap, "__value__", cb_result)
            JSVMJobs_FireReactions(cap)
        }
        ReturnValue(0)
    }
}

// When a promise settles, enqueue any single-slot reaction stored on it
// (set by then while pending). Supports one reaction chain (enough for test262).
Function.JSVMJobs_FireReactions {
    Input: promise: Address
    Output: Integer
    Body: {
        save_p = promise
        IfCondition Or(EqualTo(save_p, 0), EqualTo(save_p, JSRTState.undef_val)) ThenBlock: {
            ReturnValue(0)
        }
        rx = JSRT_ObjGet(save_p, "__rx__")
        IfCondition EqualTo(JSRT_GetType(rx), JSType.OBJECT) ThenBlock: {
            // Clear so we only fire once
            JSRT_ObjSet(save_p, "__rx__", JSRTState.undef_val)
            st = JSRT_ObjGet(save_p, "__state__")
            stn = 0
            IfCondition EqualTo(JSRT_GetType(st), JSType.NUMBER) ThenBlock: {
                stn = Float_ToInt(JSRT_GetPayload(st))
            }
            val = JSRT_ObjGet(save_p, "__value__")
            on_ful = JSRT_ObjGet(rx, "__on_ful__")
            on_rej = JSRT_ObjGet(rx, "__on_rej__")
            cap = JSRT_ObjGet(rx, "__cap__")
            IfCondition EqualTo(stn, 1) ThenBlock: {
                JSVMJobs_Enqueue(1, on_ful, val, cap)
            }
            IfCondition EqualTo(stn, 2) ThenBlock: {
                JSVMJobs_Enqueue(2, on_rej, val, cap)
            }
        }
        ReturnValue(0)
    }
}

Function.JSVMJobs_Drain {
    Output: Integer
    Body: {
        IfCondition EqualTo(JSVMJobs.draining, 1) ThenBlock: {
            ReturnValue(0)
        }
        JSVMJobs.draining = 1
        // Process until empty (reactions may enqueue more)
        guard = 0
        WhileLoop And(GreaterThan(JSVMJobs.len, 0), LessThan(guard, 4096)) {
            guard = Add(guard, 1)
            job = Dereference(JSVMJobs.queue)
            // Shift left
            i = 1
            WhileLoop LessThan(i, JSVMJobs.len) {
                StoreValue(Add(JSVMJobs.queue, Multiply(Subtract(i, 1), 8)),
                           Dereference(Add(JSVMJobs.queue, Multiply(i, 8))))
                i = Add(i, 1)
            }
            JSVMJobs.len = Subtract(JSVMJobs.len, 1)
            JSVMJobs_RunOne(job)
        }
        JSVMJobs.draining = 0
        ReturnValue(0)
    }
}
